#Область ОписаниеПеременных

&НаКлиенте
Перем ЗакрытиеРазрешено;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИТК_Настройки.ИнициализироватьФорму(ЭтотОбъект);
	ИТК_Форма.УстановитьНазначениеДействияКоманды(Команды.СохранитьАлгоритм, "Завершение");
	
	СписокВыбора = Элементы.ТипОбъектов.СписокВыбора;
	
	ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка();
	СписокВыбора.Добавить(ТипОбъектов, НСтр("ru = 'Ссылка'; en = 'Ref'"));
	
	ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных();
	СписокВыбора.Добавить(ТипОбъектов, НСтр("ru = 'Объект метаданных'; en = 'Metadata object'"));
	
	ЭтоНовый = Параметры.ЭтоНовый;
	
	ТекстКодНаСервере = "";
	ТекстКодНаКлиенте = "";
	Если Параметры.ЭтоНовый Тогда
		
		Если Параметры.ЭтоКопирование Тогда
			
			ОписаниеАлгоритма = ИТК_ПользовательскиеАлгоритмы.ОписаниеАлгоритма(Параметры.Идентификатор);
			ЗаполнитьДанныеФормыПоОписаниюАлгоритма(ОписаниеАлгоритма);
			
			Представление = СтрШаблон(НСтр("ru = 'Копия (%1)'; en = 'Copy (%1)'"), Представление);
			
		Иначе
			
			ОписаниеАлгоритма = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ОписаниеАлгоритма();
			Если ЗначениеЗаполнено(Параметры.ТипОбъектов) Тогда
				
				ТипОбъектов = Параметры.ТипОбъектов;
				ОбработкаСписка = Параметры.ОбработкаСписка;
				ТипЗначенияОбъектов = Параметры.ТипЗначенияОбъектов;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Используется = Истина;
		Идентификатор = Новый УникальныйИдентификатор;
		
	Иначе
		
		Идентификатор = Параметры.Идентификатор;
		ОписаниеАлгоритма = ИТК_ПользовательскиеАлгоритмы.ОписаниеАлгоритма(Идентификатор);
		ЗаполнитьДанныеФормыПоОписаниюАлгоритма(ОписаниеАлгоритма);
		
	КонецЕсли;
	
	НачальныйКодНаКлиенте = ОписаниеАлгоритма.КодНаКлиенте;
	НачальныйКодНаСервере = ОписаниеАлгоритма.КодНаСервере;
	
	ДополнительныеСвойства = Новый Структура;
	ИТК_РедакторКода.Инициализация(ЭтотОбъект, "КодНаСервере", ДополнительныеСвойства);
	
	ДополнительныеСвойства = Новый Структура;
	ИТК_РедакторКода.Инициализация(ЭтотОбъект, "КодНаКлиенте", ДополнительныеСвойства);
	
	ОбновитьПредставлениеТипаЗначенияОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_РедакторКодаКлиент.Инициализация(ЭтотОбъект, "КодНаСервере");
	ИТК_РедакторКодаКлиент.Инициализация(ЭтотОбъект, "КодНаКлиенте");
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	ОбновитьЭлементыФормы();
	
	ТекущийЭлемент = Элементы.Представление;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ИТК_РедакторКодаКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы
		И ЗакрытиеРазрешено = Неопределено Тогда
		
		Если Модифицированность Тогда
			
			Отказ = Истина;
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВопросСохраненияЗавершение", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Имеются несохраненные данные при закрытии они будут потеряны. Сохранить?';
								|en = 'If you have unsaved data when you close it, it will be lost. Save?'");
			ЗаголовокВопроса = НСтр("ru = 'Редактирование пользователького алгоритма'; en = 'Editing a custom algorithm'");
			
			КнопкаПоУмолчанию = Истина;
			
			КнопкиВопроса = Новый СписокЗначений;
			КнопкиВопроса.Добавить(Истина, НСтр("ru = 'Сохранить и закрыть'; en = 'Save and close'"));
			КнопкиВопроса.Добавить(Ложь, НСтр("ru = 'Не сохранять'; en = 'Do not save'"));
			КнопкиВопроса.Добавить(Неопределено, НСтр("ru = 'Отмена'; en = 'Cancel'"));
			
			ИТК_ФормаКлиент.ЗадатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, КнопкиВопроса, КнопкаПоУмолчанию, ЗаголовокВопроса, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбрабатываемыхОбъектовПриИзменении(Элемент)
	
	Если ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка() Тогда
		
		Если ЗначениеЗаполнено(ТипЗначенияОбъектов) Тогда
			
			ДоступныеТипы = Новый Массив;
			Для Каждого ИмяЗначенияОбъекта Из СтрРазделить(ТипЗначенияОбъектов, ",", Ложь) Цикл
				
				Попытка
					
					ПустаяСсылка = ПредопределенноеЗначение(СокрЛП(ИмяЗначенияОбъекта) + ".ПустаяСсылка");
					ДоступныеТипы.Добавить(ТипЗнч(ПустаяСсылка));
					
				Исключение
				КонецПопытки;
				
			КонецЦикла;
			ТипЗначенияОбъектов = Новый ОписаниеТипов(ДоступныеТипы);
			
		Иначе
			ТипЗначенияОбъектов = Новый ОписаниеТипов;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных() Тогда
		
		ОбработкаСписка = Ложь;
		ТипЗначенияОбъектов = ИменаОбъектовМетаданныхОписанияТипов(ТипЗначенияОбъектов);
		
	КонецЕсли;
	ОбновитьПредставлениеТипаЗначенияОбъектов();
	
	ИзменениеКонтекстаКода();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаОбъектовМетаданныхОписанияТипов(ОписаниеТипов)
	
	Результат = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Результат.Добавить(ОбъектМетаданных.ПолноеИмя());
		
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, ", ");
	
КонецФункции

&НаКлиенте
Процедура ОбработкаСпискаПриИзменении(Элемент)
	ИзменениеКонтекстаКода();
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеТипаЗначенияОбъектовНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка() Тогда
		
		ЗаголовокВыбораТипа = НСтр("ru = 'Типы обрабатываемых объектов'; en = 'Types of objects to be processed'");
		
		ДополнительныеПараметрыОповещения = Новый Структура;
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВыборТиповОбрабатываемыхОбъектов", ЭтотОбъект, ДополнительныеПараметрыОповещения);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Исключаемые", "ПростыеТипы");
		ИТК_ФормаКлиент.ОткрытьРедактированиеТипаЗначения(ЭтотОбъект, ЗаголовокВыбораТипа,
			ИТК_Перечисления.РежимРедактированияТипаЗначенияРедактированиеОписанияТипов(), ТипЗначенияОбъектов,
			ОписаниеОповещения, СтандартнаяОбработка, ДополнительныеПараметры);
		
	ИначеЕсли ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных() Тогда
		
		ДополнительныеПараметрыОповещения = Новый Структура;
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВыборТиповОбрабатываемыхОбъектов", ЭтотОбъект, ДополнительныеПараметрыОповещения);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Исключаемые", "Подсистемы,Последовательности,ХранилищаНастроек,КритерииОтбора,ПараметрыСеанса,ОбщиеКоманды,ВнешниеИсточникиДанных");
		
		ИТК_ФормаКлиент.ОткрытьРедактированиеТипаЗначения(ЭтотОбъект, Неопределено,
			ИТК_Перечисления.РежимРедактированияТипаЗначенияОтборМетаданных(), ТипЗначенияОбъектов,
			ОписаниеОповещения, СтандартнаяОбработка, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИТК_ПодключаемыйДокументСформирован(Элемент)
	
	ДополнительныеСвойства = Новый Структура;
	ДополнительныеСвойства.Вставить("УстановитьФокус", Ложь);
	
	Если Элемент = Элементы.КодНаКлиенте Тогда
		НачальныйКод = НачальныйКодНаКлиенте;
	ИначеЕсли Элемент = Элементы.КодНаСервере Тогда
		НачальныйКод = НачальныйКодНаСервере;
	Иначе
		НачальныйКод = "";
	КонецЕсли;
	ДополнительныеСвойства.Вставить("Текст", НачальныйКод);
	
	ДополнительныеСвойства.Вставить("Подсказка", ПодсказкаКонтекстаКода(Элемент));
	ДополнительныеСвойства.Вставить("ПользовательскиеОбъекты", ПользовательскиеОбъектыКонтекстаКода(Элемент));
	
	ИТК_РедакторКодаКлиент.ДополнительнаяИнициализация(ЭтотОбъект, Элемент, ДополнительныеСвойства);
	
КонецПроцедуры

&НаКлиенте
Процедура ИТК_ПодключаемыйПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	ИТК_РедакторКодаКлиент.ОбработкаСобытий(ЭтотОбъект, Элемент, ДанныеСобытия, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьАлгоритм(Команда)
	ЗакрытьФормуССохранениемДанных();
КонецПроцедуры

&НаКлиенте
Процедура ИТК_ПодключаемаяКомандаРедакторКодаОбработчик(Команда)
	ИТК_РедакторКодаКлиент.ПодключаемыйОбработчикКоманд(ЭтотОбъект, Команда.Имя);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Заголовок = НСтр("ru = 'Редактирование пользовательского алгоритма'; en = 'Editing a custom algorithm'");
	Если ЭтоНовый Тогда
		Заголовок = Заголовок + Символы.НПП + НСтр("ru = '(новый)'; en = '(new)'");
	КонецЕсли;
	
	ЭтоТипОбъектаСсылка = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка());
	ЭтоТипОбъектаОбъектМетаданных = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных());
	
	Элементы.ОбработкаСписка.Доступность = ЭтоТипОбъектаСсылка;
	
КонецПроцедуры

&НаКлиенте
Процедура ИТК_ПодключаемыйВосстановлениеФокусаРедактора() Экспорт 
	ИТК_РедакторКодаКлиент.ВосстановлениеФокусаРедактора(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура СохранитьАлгоритмНаСервере(ОписаниеАлгоритма)
	ИТК_ПользовательскиеАлгоритмы.СохранитьАлгоритм(Идентификатор, ОписаниеАлгоритма);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормыПоОписаниюАлгоритма(ОписаниеАлгоритма)
	
	Используется = ОписаниеАлгоритма.Используется;
	Представление = ОписаниеАлгоритма.Представление;
	ТипОбъектов = ОписаниеАлгоритма.ТипОбъектов;
	ОбработкаСписка = ОписаниеАлгоритма.ОбработкаСписка;
	Комментарий = ОписаниеАлгоритма.Комментарий;
	ТипЗначенияОбъектов = ОписаниеАлгоритма.ТипЗначенияОбъектов;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохраненияЗавершение(Сохранение, ДополнительныеПараметры) Экспорт
	
	Если Сохранение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьФормуССохранениемДанных(Сохранение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуССохранениемДанных(Сохранить = Истина)
	
	Если Сохранить Тогда
		
		ОписаниеАлгоритма = Новый Структура;
		ОписаниеАлгоритма.Вставить("Используется", Используется);
		ОписаниеАлгоритма.Вставить("Представление", Представление);
		ОписаниеАлгоритма.Вставить("ТипОбъектов", ТипОбъектов);
		ОписаниеАлгоритма.Вставить("ТипЗначенияОбъектов", ТипЗначенияОбъектов);
		ОписаниеАлгоритма.Вставить("ОбработкаСписка", ОбработкаСписка);
		
		Код = ИТК_РедакторКодаКлиент.Текст(ЭтотОбъект, "КодНаКлиенте");
		ОписаниеАлгоритма.Вставить("КодНаКлиенте", Код);
		
		Код = ИТК_РедакторКодаКлиент.Текст(ЭтотОбъект, "КодНаСервере");
		ОписаниеАлгоритма.Вставить("КодНаСервере", Код);
		
		ОписаниеАлгоритма.Вставить("Комментарий", Комментарий);
		СохранитьАлгоритмНаСервере(ОписаниеАлгоритма);
		
		Оповестить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяОповещенияИзменениеПользовательскихАлгоритмов(), Строка(Идентификатор));
		
	КонецЕсли;
	
	ЗакрытиеРазрешено = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенВыборТиповОбрабатываемыхОбъектов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	ТипЗначенияОбъектов = Результат;
	ОбновитьПредставлениеТипаЗначенияОбъектов();
	ИзменениеКонтекстаКода();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеТипаЗначенияОбъектов()
	
	Если ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка() Тогда
		ПредставлениеТипаЗначенияОбъектов = ИТК_Типы.ПредставлениеОписания(ТипЗначенияОбъектов);
	ИначеЕсли ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных() Тогда
		
		Если ЗначениеЗаполнено(ТипЗначенияОбъектов) Тогда
			ПредставлениеТипаЗначенияОбъектов = ИТК_Строки.Сокращенно(ТипЗначенияОбъектов, 100);
		Иначе
			ПредставлениеТипаЗначенияОбъектов = НСтр("ru = 'Неопределено'; en = 'Undefined'");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПользовательскиеОбъектыКонтекстаКода(Элемент)
	
	Если Элемент = Элементы.КодНаКлиенте Тогда
		Результат = ПользовательскиеОбъектыКонтекстаКодаСервер("НаКлиенте");
	ИначеЕсли Элемент = Элементы.КодНаСервере Тогда
		Результат = ПользовательскиеОбъектыКонтекстаКодаСервер("НаСервере");
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПользовательскиеОбъектыКонтекстаКодаСервер(КонтекстВыполнения)
	
	Результат = ИТК_РедакторКода.НовыеПользовательскиеОбъекты();
	Кэш = ИТК_РедакторКода.КэшТиповПользовательскихОбъектов();
	
	ЭтоКонтекстСервер = (КонтекстВыполнения = "НаСервере");
	ЭтоКонтекстКлиент = (КонтекстВыполнения = "НаКлиенте");
	ЭтоТипОбъектовОбъектСсылка = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка());
	ЭтоТипОбъектовОбъектМетаданных = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных());
	
	Если ОбработкаСписка Тогда
		
		// Объекты
		Если ЭтоТипОбъектовОбъектСсылка Тогда
		
			ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш, Новый ОписаниеТипов("Массив"));
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъекты();
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъекты("en");
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКонтекстКлиент И ЭтоТипОбъектовОбъектМетаданных Тогда
			
			// ПолноеИмяОбъекта
			ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш, Новый ОписаниеТипов("Строка"));
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаПолноеИмяОбъекта();
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаПолноеИмяОбъекта("en");
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
		Иначе
			
			// Объект
			Если ЭтоТипОбъектовОбъектСсылка Тогда
				ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш, ТипЗначенияОбъектов);
			Иначе
				ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш);
			КонецЕсли;
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъект();
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъект("en");
			ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// РезультатОбработки
	Если ОбработкаСписка Тогда
		ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш, Новый ОписаниеТипов("Соответствие"));
	Иначе
		ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш);
	КонецЕсли;
	
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаРезультатОбработки();
	ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
	
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаРезультатОбработки("en");
	ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
	
	// ДополнительныеПараметры
	ОписаниеПараметра = ИТК_РедакторКода.ОписаниеПользовательскогоОбъекта(Кэш, Новый ОписаниеТипов("Структура"));
	
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаДополнительныеПараметры();
	ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
	
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаДополнительныеПараметры("en");
	ИТК_РедакторКода.ДобавитьПользовательскийОбъект(Результат, ИмяПеременной, ОписаниеПараметра);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодсказкаКонтекстаКода(Элемент)
	
	Если Элемент = Элементы.КодНаКлиенте Тогда
		Результат = ПодсказкаКонтекстаКодаСервер("НаКлиенте");
	ИначеЕсли Элемент = Элементы.КодНаСервере Тогда
		Результат = ПодсказкаКонтекстаКодаСервер("НаСервере");
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодсказкаКонтекстаКодаСервер(КонтекстВыполнения)
	
	ЯзыкПрограммирования = ИТК_Настройки.ЗначениеОбщейНастройки(ЭтотОбъект, "ЯзыкПрограммирования");
	
	ЧастиРезультата = Новый Массив;
	
	ЭтоКонтекстСервер = (КонтекстВыполнения = "НаСервере");
	ЭтоКонтекстКлиент = (КонтекстВыполнения = "НаКлиенте");
	ЭтоТипОбъектовОбъектСсылка = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка());
	ЭтоТипОбъектовОбъектМетаданных = (ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных());
	
	Если ОбработкаСписка Тогда
		
		// Объекты
		Если ЭтоТипОбъектовОбъектСсылка Тогда
		
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъекты(ЯзыкПрограммирования);
			ПодсказкаПоля = СтрШаблон(НСтр("ru = '%1 - Объекты (ссылки) (Массив)'; en = '%1 - Objects (ref) (Array)'"), ИмяПеременной);
			ЧастиРезультата.Добавить(ПодсказкаПоля);
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКонтекстКлиент И ЭтоТипОбъектовОбъектМетаданных Тогда
			
			// ПолноеИмяОбъекта
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаПолноеИмяОбъекта(ЯзыкПрограммирования);
			ПодсказкаПоля = СтрШаблон(НСтр("ru = '%1 - Полное имя объекта метаданных (Строка)'; en = '%1 - Full name of the metadata object (String)'"), ИмяПеременной);
			ЧастиРезультата.Добавить(ПодсказкаПоля);
			
		Иначе
			
			// Объект
			ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъект(ЯзыкПрограммирования);
			Если ЭтоТипОбъектовОбъектСсылка Тогда
				ШаблонПодсказкиПоля = НСтр("ru = '%1 - Объект (ссылка) (%2)'; en = '%1 - Object (ref) (%2)'");
			Иначе
				ШаблонПодсказкиПоля = НСтр("ru = '%1 - Объект (объект метаданных) (%2)'; en = '%1 - Object (ref) (%2)'");
			КонецЕсли;
			ПредставлениеТипаОбъека = ПредставлениеТипаЗначенияОбъектов;
			ПодсказкаПоля = СтрШаблон(ШаблонПодсказкиПоля, ИмяПеременной, ПредставлениеТипаОбъека);
			ЧастиРезультата.Добавить(ПодсказкаПоля);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// РезультатОбработки
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаРезультатОбработки(ЯзыкПрограммирования);
	Если ОбработкаСписка Тогда
		ШаблонПодсказкиПоля = НСтр("ru = '%1 - Передача результата обработки с сервера на клиент (Соответствие)';
									|en = '%1 - Transferring processing results from server to client (Map)'");
	Иначе
		ШаблонПодсказкиПоля = НСтр("ru = '%1 - Передача результата обработки с сервера на клиент';
									|en = '%1 - Transferring processing results from server to client'");
	КонецЕсли;
	ПодсказкаПоля = СтрШаблон(ШаблонПодсказкиПоля, ИмяПеременной);
	ЧастиРезультата.Добавить(ПодсказкаПоля);
	
	// ДополнительныеПараметры
	ИмяПеременной = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаДополнительныеПараметры(ЯзыкПрограммирования);
	ПодсказкаПоля = СтрШаблон(НСтр("ru = '%1 - Дополнительные параметры (Структура)'; en = '%1 - Additional parameters (Structure)'"), ИмяПеременной);
	ЧастиРезультата.Добавить(ПодсказкаПоля);
	
	Возврат СтрСоединить(ЧастиРезультата, Символы.ПС);
	
КонецФункции

&НаКлиенте
Функция ИзменениеКонтекстаКода()
	
	Элемент = Элементы.КодНаСервере;
	
	ДополнительныеСвойства = Новый Структура;
	ДополнительныеСвойства.Вставить("УстановитьФокус", Ложь);
	ДополнительныеСвойства.Вставить("Подсказка", ПодсказкаКонтекстаКода(Элемент));
	ДополнительныеСвойства.Вставить("ПользовательскиеОбъекты", ПользовательскиеОбъектыКонтекстаКода(Элемент));
	ИТК_РедакторКодаКлиент.ДополнительнаяИнициализация(ЭтотОбъект, Элемент, ДополнительныеСвойства);
	
	Элемент = Элементы.КодНаКлиенте;
	
	ДополнительныеСвойства = Новый Структура;
	ДополнительныеСвойства.Вставить("УстановитьФокус", Ложь);
	ДополнительныеСвойства.Вставить("Подсказка", ПодсказкаКонтекстаКода(Элемент));
	ДополнительныеСвойства.Вставить("ПользовательскиеОбъекты", ПользовательскиеОбъектыКонтекстаКода(Элемент));
	ИТК_РедакторКодаКлиент.ДополнительнаяИнициализация(ЭтотОбъект, Элемент, ДополнительныеСвойства);
	
КонецФункции

#КонецОбласти