#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	ОбновитьСписокАлгоритмовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяОповещенияИзменениеПользовательскихАлгоритмов() Тогда
		ОбновитьСписокАлгоритмов(Параметр);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокАлгоритмов

&НаКлиенте
Процедура СписокАлгоритмовПриАктивизацииСтроки(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура СписокАлгоритмовПриИзмененииСоставаВыделенныхСтрок(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура СписокАлгоритмовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	НачатьРедактированиеАлгоритма();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьАлгоритм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЭтоНовый", Истина);
	
	ИТК_ФормаКлиент.ОткрытьРедактированиеПользовательскогоАлгоритма(ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьАлгоритм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЭтоНовый", Истина);
	ПараметрыФормы.Вставить("ЭтоКопирование", Истина);
	
	ТекущаяСтрока = Элементы.СписокАлгоритмов.ТекущаяСтрока;
	ПараметрыФормы.Вставить("Идентификатор", Новый УникальныйИдентификатор(ТекущаяСтрока));
	
	ИТК_ФормаКлиент.ОткрытьРедактированиеПользовательскогоАлгоритма(ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьАлгоритм(Команда)
	НачатьРедактированиеАлгоритма();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьАлгоритмы(Команда)
	
	УдаляемыеАлгоритмы = ИТК_ФормаКлиент.ВыделенныеСтрокиКоллекции(Элементы.СписокАлгоритмов);
	Если НЕ ЗначениеЗаполнено(УдаляемыеАлгоритмы) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВопросУдаленияАлгоритмов", ЭтотОбъект);
	
	Если УдаляемыеАлгоритмы.Количество() = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Удалить выбранный алгоритм?'; en = 'Delete the selected algorithm?'");
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить все выбранные(%1) алгоритмы?'; en = 'Delete all selected(%1) algorithms?'"), УдаляемыеАлгоритмы.Количество());
	КонецЕсли;
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Удалить'; en = 'Delete'"));
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'; en = 'Cancel'"));
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса, 60, КодВозвратаДиалога.Да, , КодВозвратаДиалога.Отмена);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Оформление = Новый Структура;
	Оформление.Вставить("ЦветТекста", ИТК_ОбщийКлиентСервер.ЦветПалитрыСерый());
	ИТК_Форма.ДобавитьУсловноеОформление(СписокАлгоритмов.УсловноеОформление, "Представление, ТипОбъектов, ТипЗначенияОбъектов", Оформление, "Используется", Ложь);
	
	Если ИТК_ОбщийКлиентСервер.ЭтоИнтерфейс8_5() Тогда
		Возврат;
	КонецЕсли;
	
	Оформление = Новый Структура;
	Оформление.Вставить("ЦветТекста", ИТК_ОбщийКлиентСервер.ЦветПалитрыСерый());
	Оформление.Вставить("Шрифт", ИТК_ОбщийКлиентСервер.ШрифтНаклонный());
	ИТК_Форма.ДобавитьУсловноеОформление(СписокАлгоритмов.УсловноеОформление, "Комментарий", Оформление);
	
	Оформление = Новый Структура("Шрифт", ИТК_ОбщийКлиентСервер.ШрифтЖирный());
	ИТК_Форма.ДобавитьУсловноеОформление(СписокАлгоритмов.УсловноеОформление, "Представление", Оформление);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ВыделенныеАлгоритмы = ИТК_ФормаКлиент.ВыделенныеСтрокиКоллекции(Элементы.СписокАлгоритмов);
	
	ДоступноКопированиеАлгоритма = ЗначениеЗаполнено(ВыделенныеАлгоритмы);
	Элементы.СписокАлгоритмовСкопироватьАлгоритм.Доступность = ДоступноКопированиеАлгоритма;
	Элементы.СписокАлгоритмовКонтекстноеМенюСкопироватьАлгоритм.Доступность = ДоступноКопированиеАлгоритма;
	
	ДоступноРедактированиеАлгоритма = ЗначениеЗаполнено(ВыделенныеАлгоритмы);
	Элементы.СписокАлгоритмовРедактироватьАлгоритм.Доступность = ДоступноРедактированиеАлгоритма;
	Элементы.СписокАлгоритмовКонтекстноеМенюРедактироватьАлгоритм.Доступность = ДоступноРедактированиеАлгоритма;
	
	ДоступноУдалениеАлгоритмов = ЗначениеЗаполнено(ВыделенныеАлгоритмы);
	Элементы.СписокАлгоритмовУдалитьАлгоритмы.Доступность = ДоступноУдалениеАлгоритмов;
	Элементы.СписокАлгоритмовКонтекстноеМенюУдалитьАлгоритмы.Доступность = ДоступноУдалениеАлгоритмов;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокАлгоритмов(Идентификатор = Неопределено)
	
	ОбновитьСписокАлгоритмовНаСервере(Идентификатор);
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокАлгоритмовНаСервере(Идентификатор = Неопределено)
	
	ЧастиТекстаЗапроса = Новый Массив;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ЛОЖЬ КАК Используется,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК Идентификатор,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(100)) КАК Представление,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(1000)) КАК Комментарий,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(100)) КАК ТипОбъектов,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(1000)) КАК ТипЗначенияОбъектов
	|ГДЕ ЛОЖЬ";
	ЧастиТекстаЗапроса.Добавить(ТекстЗапроса);
	
	ПользовательскиеАлгоритмы = ИТК_ПользовательскиеАлгоритмы.Алгоритмы();
	Для Каждого КлючИЗначениеАлгоритм Из ПользовательскиеАлгоритмы Цикл
		
		ОписаниеАлгоритма = КлючИЗначениеАлгоритм.Значение;
		
		ПоляЗапроса = Новый Массив;
		
		ТекстВставки = ИТК_Код.Значение(ОписаниеАлгоритма.Используется);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		ТекстВставки = ИТК_КодКлиентСервер.ЗначениеСтрока(КлючИЗначениеАлгоритм.Ключ);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		ТекстВставки = ИТК_КодКлиентСервер.ЗначениеСтрока(ОписаниеАлгоритма.Представление);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		ТекстВставки = ИТК_КодКлиентСервер.ЗначениеСтрока(ОписаниеАлгоритма.Комментарий);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		ТекстВставки = ИТК_КодКлиентСервер.ЗначениеСтрока(ОписаниеАлгоритма.ТипОбъектов);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		Если ТипЗнч(ОписаниеАлгоритма.ТипЗначенияОбъектов) = Тип("ОписаниеТипов") Тогда
			ЗначениеВставки = ИТК_Типы.ПредставлениеОписания(ОписаниеАлгоритма.ТипЗначенияОбъектов);
		Иначе
			ЗначениеВставки = ОписаниеАлгоритма.ТипЗначенияОбъектов;
		КонецЕсли;
		
		ТекстВставки = ИТК_КодКлиентСервер.ЗначениеСтрока(ЗначениеВставки);
		ПоляЗапроса.Добавить(ТекстВставки);
		
		ТекстЗапроса = "ВЫБРАТЬ " + СтрСоединить(ПоляЗапроса, ", ");
		ЧастиТекстаЗапроса.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	СписокАлгоритмов.ТекстЗапроса = СтрСоединить(ЧастиТекстаЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	// Установка текущей строки
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Элементы.СписокАлгоритмов.ТекущаяСтрока = Идентификатор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьРедактированиеАлгоритма()
	
	ТекущаяСтрока = Элементы.СписокАлгоритмов.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Идентификатор", Новый УникальныйИдентификатор(ТекущаяСтрока));
	
	ИТК_ФормаКлиент.ОткрытьРедактированиеПользовательскогоАлгоритма(ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенВопросУдаленияАлгоритмов(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыеАлгоритмы = ИТК_ФормаКлиент.ВыделенныеСтрокиКоллекции(Элементы.СписокАлгоритмов);
	УдалитьАлгоритмыНаСервере(УдаляемыеАлгоритмы);
	
	ОбновитьСписокАлгоритмов();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьАлгоритмыНаСервере(Алгоритмы)
	
	УдаляемыеАлгоритмы = Новый Массив;
	Для Каждого СтрокаИдентификаторАлгоритма Из Алгоритмы Цикл
		УдаляемыеАлгоритмы.Добавить(Новый УникальныйИдентификатор(СтрокаИдентификаторАлгоритма));
	КонецЦикла;
	
	ИТК_ПользовательскиеАлгоритмы.УдалитьАлгоритмы(УдаляемыеАлгоритмы);
	
КонецПроцедуры

#КонецОбласти