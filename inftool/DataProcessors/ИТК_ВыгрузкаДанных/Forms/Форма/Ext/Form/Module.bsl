
#Область ОписаниеПеременных

&НаКлиенте
Перем ОтборДереваМетаданных Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимРаботы = "Клиент";
	ИспользоватьФорматFastInfoSet = Ложь;
	
	Если ЗначениеЗаполнено(Параметры.Ссылки) Тогда
		ВходныеСсылки.ЗагрузитьЗначения(Параметры.Ссылки);
	КонецЕсли;
	ЗаполнениеДереваМетаданных();
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.ДеревоМетаданных);
	УстановитьУсловноеОформление();
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
	// Интерфейс 8.5
	ЭтоИнтерфейс8_5 = ИТК_ОбщийКлиентСервер.ЭтоИнтерфейс8_5();
	Если ЭтоИнтерфейс8_5 Тогда
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Авто;
	Иначе
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
	КонецЕсли;
	Элементы.ГруппаЕщеКоманднаяПанель.Видимость = НЕ ЭтоИнтерфейс8_5;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	ЗаполнитьПоВходнымСсылкам();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодВыгрузкиПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФайлаВыгрузкиЗавершение", ЭтотОбъект);
	ИТК_ВыгрузкаЗагрузкаДанныхКлиент.ОбработатьНачалоВыбораФайлаВыгрузки(ОписаниеОповещения, ИмяФайлаВыгрузки, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИТК_ФайлыКлиент.ОткрытьВПроводнике(ИмяФайлаВыгрузки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМетаданных

&НаКлиенте
Процедура ДеревоМетаданныхПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоМетаданных.ТекущиеДанные;
	
	Пометка = ИТК_ФормаКлиент.ОпределитьПометкуТриСостояния(ТекущиеДанные);
	
	ИТК_ФормаКлиент.ДеревоУстановитьПодчиненнымПометку(ТекущиеДанные, Пометка);
	ИТК_ФормаКлиент.ДеревоОпределитьПометкуРодителя(ТекущиеДанные, Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПриНеобходимостиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоМетаданных.ТекущиеДанные;
	
	ПриНеобходимости = ИТК_ФормаКлиент.ОпределитьПометкуТриСостояния(ТекущиеДанные, "ПриНеобходимости");
	
	ИТК_ФормаКлиент.ДеревоУстановитьПодчиненнымПометку(ТекущиеДанные, ПриНеобходимости, "ПриНеобходимости");
	ИТК_ФормаКлиент.ДеревоОпределитьПометкуРодителя(ТекущиеДанные, ПриНеобходимости, "ПриНеобходимости");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхВыбор(Элемент, ИдентификаторВыбраннойСтроки, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.ДеревоМетаданныхОтборПредставление Тогда
		
		ВыбраннаяСтрока = ДеревоМетаданных.НайтиПоИдентификатору(ИдентификаторВыбраннойСтроки);
		Если ЗначениеЗаполнено(ВыбраннаяСтрока.ОтборПредставление) Тогда
			
			СтандартнаяОбработка = Истина;
			
			ТекущиеДанные = Элементы.ДеревоМетаданных.ТекущиеДанные;
			ПолноеИмяОбъекта = ПолноеИмяОбъекта(ТекущиеДанные);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Настройки", ОтборДереваМетаданных.Получить(ПолноеИмяОбъекта));
			
			ИспользуемыеТипы = Новый Массив;
			ИспользуемыеТипы.Добавить(ПолноеИмяОбъекта);
			ПараметрыФормы.Вставить("ИспользуемыеТипы", ИспользуемыеТипы);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("НастройкаОтбораЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ИТК_НастройкаОтбора", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьНовоеОкно(Команда)
	ИТК_ФормаКлиент.ОткрытьНовую(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДанные(Команда)
	
	ОчиститьСообщения();
	
	Если РежимРаботы = "Сервер" 
			И ПустаяСтрока(ИмяФайлаВыгрузки) Тогда
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = НСтр("ru = 'Поле ""Имя файла"" не заполнено'; en = 'The ""File name"" field is empty.'");
		СообщениеПользователю.Поле = "ИмяФайлаВыгрузки";
		СообщениеПользователю.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Выполняется выгрузка данных. Пожалуйста, подождите...'"));
	
	АдресФайлаВоВременномХранилище = "";
	ВыгрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище, ОтборДереваМетаданных);
	
	Если РежимРаботы = "Клиент" И ЗначениеЗаполнено(АдресФайлаВоВременномХранилище) Тогда
		
		Если ИспользоватьФорматFastInfoSet Тогда
			ИмяФайла = НСтр("ru = 'Файл выгрузки.fi'; en = 'Download file.fi'");
		Иначе
			ИмяФайла = НСтр("ru = 'Файл выгрузки.xml'; en = 'Download file.xml'");
		КонецЕсли;
		ПолучитьФайл(АдресФайлаВоВременномХранилище, ИмяФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Файлы настроек выгрузки *.tlk_unload|*.tlk_unload'; en = 'Unload settings files *.tlk_unload|*.tlk_unload'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВыборФайлаНастроекВыгрузки", ЭтотОбъект);
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	АдресФайла = ФайлаНастроекВыгрузкиСервер(ОтборДереваМетаданных);
	ПолучитьФайл(АдресФайла, "НастройкиВыгрузкиДанных.tlk_unload");
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеИнструменты(Команда)
	ИТК_ГлобальноеМенюКлиент.Открыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ЭтоРежимРаботыСервер = (РежимРаботы = "Сервер");
	
	Элементы.ИмяФайлаВыгрузки.Доступность = ЭтоРежимРаботыСервер;
	Элементы.ИмяФайлаВыгрузки.АвтоОтметкаНезаполненного = ЭтоРежимРаботыСервер;
	
	Элементы.ТипВыгрузкиПериодическихРегистров.Доступность = ЗначениеЗаполнено(ПериодВыгрузки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеДереваМетаданных()
	
	// Заполнение дерева
	КорневаяСтрока = ДеревоМетаданных.ПолучитьЭлементы().Добавить();
	КорневаяСтрока.Имя = Метаданные.Имя;
	КорневаяСтрока.Синоним = Метаданные.Синоним;
	КорневаяСтрока.Картинка = БиблиотекаКартинок.ИТК_Метаданные;
	КорневаяСтрока.ПриНеобходимости = 1;
	
	КоллекцииМетаданных = Новый Массив;
	КоллекцииМетаданных.Добавить("Константы");
	КоллекцииМетаданных.Добавить("Справочники");
	КоллекцииМетаданных.Добавить("Документы");
	КоллекцииМетаданных.Добавить("ПланыВидовХарактеристик");
	КоллекцииМетаданных.Добавить("ПланыСчетов");
	КоллекцииМетаданных.Добавить("ПланыВидовРасчета");
	КоллекцииМетаданных.Добавить("РегистрыСведений");
	КоллекцииМетаданных.Добавить("РегистрыНакопления");
	КоллекцииМетаданных.Добавить("РегистрыБухгалтерии");
	КоллекцииМетаданных.Добавить("РегистрыРасчета");
	КоллекцииМетаданных.Добавить("БизнесПроцессы");
	КоллекцииМетаданных.Добавить("Задачи");
	КоллекцииМетаданных.Добавить("ПланыОбмена");
	
	Для Каждого ИмяКоллекции Из КоллекцииМетаданных Цикл
		
		КоллекцияМетаданных = Метаданные[ИмяКоллекции];
		Если НЕ ЗначениеЗаполнено(КоллекцияМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаКоллекция = КорневаяСтрока.ПолучитьЭлементы().Добавить();
		СтрокаКоллекция.Имя = ИмяКоллекции;
		
		ИмяОбъектаКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ИмяОбъектаКоллекции(ИмяКоллекции);
		СтрокаКоллекция.Картинка = БиблиотекаКартинок[ИмяОбъектаКоллекции];
		
		СтрокаКоллекция.ПриНеобходимости = 1;
		
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
			
			СтрокаОбъект = СтрокаКоллекция.ПолучитьЭлементы().Добавить();
			СтрокаОбъект.Имя = ОбъектМетаданных.Имя;
			СтрокаОбъект.Синоним = ОбъектМетаданных.Синоним;
			СтрокаОбъект.Картинка = СтрокаКоллекция.Картинка;
			СтрокаОбъект.ПриНеобходимости = 1;
			
			ПолноеИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();
			Если ИТК_Метаданные.ЭтоКонстанта(ПолноеИмяОбъектаМетаданных)
					ИЛИ ИТК_Метаданные.ЭтоРегистрРасчета(ПолноеИмяОбъектаМетаданных)
					ИЛИ ИТК_Метаданные.ЭтоРегистрНакопления(ПолноеИмяОбъектаМетаданных)
					ИЛИ ИТК_Метаданные.ЭтоРегистрБухгалтерии(ПолноеИмяОбъектаМетаданных)
					ИЛИ ИТК_Метаданные.ЭтоРегистрСведенийСПодчинениемРегистратору(ОбъектМетаданных) Тогда
				ОтборПредставление = Неопределено;
			Иначе
				ОтборПредставление = НСтр("ru = 'Отбор...'; en = 'Filter...'");
			КонецЕсли;
			СтрокаОбъект.ОтборПредставление = ОтборПредставление;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Оформление = Новый Структура("Шрифт", ИТК_ОбщийКлиентСервер.ШрифтЖирный());
	ИТК_Форма.ДобавитьУсловноеОформление(УсловноеОформление, "ДеревоМетаданных", Оформление, "ДеревоМетаданных.Пометка", 0, ВидСравненияКомпоновкиДанных.НеРавно);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаВыгрузкиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементДерево = Элементы.ДеревоМетаданных;
	
	ТекущиеДанные = ЭлементДерево.ТекущиеДанные;
	ТекущиеДанные.Пометка = 1;
	ДеревоМетаданныхПометкаПриИзменении(ЭлементДерево);
	
	ПолноеИмяОбъекта = ПолноеИмяОбъекта(ТекущиеДанные);
	ОтборДереваМетаданных.Вставить(ПолноеИмяОбъекта, Результат);
	
	ЗаполнитьДанныеСтрокиДереваМетаданных(ТекущиеДанные);
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Функция ПолноеИмяОбъекта(Строка)
	
	СтрокаРодитель = Строка.ПолучитьРодителя();
	Если СтрокаРодитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрокаРодитель.ПолучитьРодителя() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмяОбъекта = ИТК_МетаданныеКлиентСерверПовтИсп.ИмяОбъектаКоллекции(СтрокаРодитель.Имя) + "." + Строка.Имя;
	Возврат ПолноеИмяОбъекта;
	
КонецФункции

&НаКлиенте
Функция НайтиСтрокуДереваМетаданныхПоПолномуИмя(ПолноеИмя)
	
	ЧастиПолногоИмени = СтрРазделить(ПолноеИмя, ".");
	
	Если ЧастиПолногоИмени.Количество() > 1 Тогда
		
		ИмяОбъекта = ЧастиПолногоИмени[1];
		ИмяКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ИмяКоллекции(ЧастиПолногоИмени[0]);
		
	Иначе
		
		ИмяОбъекта = Неопределено;
		ИмяКоллекции = ЧастиПолногоИмени[0];
		
	КонецЕсли;
	
	Для Каждого СтрокаМетаданные Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		Для Каждого СтрокаКоллекция Из СтрокаМетаданные.ПолучитьЭлементы() Цикл
			
			Если СтрокаКоллекция.Имя <> ИмяКоллекции Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИмяОбъекта = Неопределено Тогда
				Возврат СтрокаКоллекция;
			КонецЕсли;
			
			Для Каждого СтрокаОбъект Из СтрокаКоллекция.ПолучитьЭлементы() Цикл
				
				Если СтрокаОбъект.Имя = ИмяОбъекта Тогда 
					Возврат СтрокаОбъект;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДанныеСтрокиДереваМетаданных(Строка)
	
	ПолноеИмяОбъекта = ПолноеИмяОбъекта(Строка);
	Настройки = ОтборДереваМетаданных.Получить(ПолноеИмяОбъекта);
	Если ЗначениеЗаполнено(Настройки) 
			И ЗначениеЗаполнено(Настройки.Отбор.Элементы) Тогда
		ОтборПредставление = ИТК_Строки.Сократить(Настройки.Отбор, 200);
	Иначе
		ОтборПредставление = НСтр("ru = 'Отбор...'; en = 'Filter...'");
	КонецЕсли;
	
	Строка.ОтборПредставление = ОтборПредставление;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоВходнымСсылкам()
	
	ОтборДереваМетаданных = ОтборПоВходныиСсылкам();
	
	Для Каждого ЭлементОтбораДереваМетаданных Из ОтборДереваМетаданных Цикл
		
		НайденнаяСтрока = НайтиСтрокуДереваМетаданныхПоПолномуИмя(ЭлементОтбораДереваМетаданных.Ключ);
		НайденнаяСтрока.Пометка = 1;
		ЗаполнитьДанныеСтрокиДереваМетаданных(НайденнаяСтрока);
		
		ИТК_ФормаКлиент.ДеревоУстановитьПодчиненнымПометку(НайденнаяСтрока, НайденнаяСтрока.Пометка);
		ИТК_ФормаКлиент.ДеревоОпределитьПометкуРодителя(НайденнаяСтрока, НайденнаяСтрока.Пометка);
		
	КонецЦикла;
	
	Если ОтборДереваМетаданных.Количество() = 1 Тогда
		
		ТекущийЭлемент = Элементы.ДеревоМетаданных;
		Элементы.ДеревоМетаданных.ТекущаяСтрока = НайденнаяСтрока.ПолучитьИдентификатор();
		
		СтрокаРодитель = НайденнаяСтрока.ПолучитьРодителя();
		Элементы.ДеревоМетаданных.Развернуть(СтрокаРодитель.ПолучитьИдентификатор());
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтборПоВходныиСсылкам()
	
	СписокСсылокПоТипам = Новый Соответствие;
	Для Каждого ЭлементСсылка Из ВходныеСсылки Цикл
		
		Ссылка = ЭлементСсылка.Значение;
		Ключ = Ссылка.Метаданные().ПолноеИмя();
		
		СписокСсылок = СписокСсылокПоТипам.Получить(Ключ);
		Если СписокСсылок = Неопределено Тогда
			
			СписокСсылок = Новый Массив;
			СписокСсылок.Добавить(Ссылка);
			
			СписокСсылокПоТипам.Вставить(Ключ, СписокСсылок);
			
		Иначе
			СписокСсылок.Добавить(Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Соответствие;
	Для Каждого ЭлементСсылкаПоТипу Из СписокСсылокПоТипам Цикл
		
		НастройкиКомпоновкиДанных = Новый НастройкиКомпоновкиДанных;
		НовыйОтбор = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		
		ПравоеЗначение = Новый СписокЗначений;
		ПравоеЗначение.ЗагрузитьЗначения(ЭлементСсылкаПоТипу.Значение);
		НовыйОтбор.ПравоеЗначение = ПравоеЗначение;
		
		Результат.Вставить(ЭлементСсылкаПоТипу.Ключ, НастройкиКомпоновкиДанных);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФайлаНастроекВыгрузкиСервер(ОтборДереваМетаданных)
	
	НастройкиВыгрузки = Новый Массив;
	Для Каждого СтрокаКорень Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		Для Каждого СтрокаКоллекция Из СтрокаКорень.ПолучитьЭлементы() Цикл
			
			КоллекцияВыгружаетсяЦеликом = СтрокаКоллекция.Пометка = 1
											ИЛИ СтрокаКоллекция.ПриНеобходимости = 0;
			Если КоллекцияВыгружаетсяЦеликом Тогда
				
				ОписаниеЭлемента = ОписаниеЭлементаНастроекВыгрузки(СтрокаКоллекция, СтрокаКоллекция.Имя, ОтборДереваМетаданных);
				НастройкиВыгрузки.Добавить(ОписаниеЭлемента);
				
			КонецЕсли;
			
			ИмяОбъектаКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ИмяОбъектаКоллекции(СтрокаКоллекция.Имя);
			Для Каждого СтрокаОбъект Из СтрокаКоллекция.ПолучитьЭлементы() Цикл
				
				КлючОбъекта = ИмяОбъектаКоллекции + "." + СтрокаОбъект.Имя;
				ТребуетсяВыгрузка = (СтрокаОбъект.Пометка = 1 И НЕ КоллекцияВыгружаетсяЦеликом)
										ИЛИ СтрокаОбъект.ПриНеобходимости = 0
										ИЛИ ОтборДереваМетаданных.Получить(КлючОбъекта) <> Неопределено;
				Если ТребуетсяВыгрузка Тогда
					
					ОписаниеЭлемента = ОписаниеЭлементаНастроекВыгрузки(СтрокаОбъект, КлючОбъекта, ОтборДереваМетаданных);
					НастройкиВыгрузки.Добавить(ОписаниеЭлемента);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Текст = ИТК_ОбщийКлиентСервер.КоллекциюВJSONСтроку(НастройкиВыгрузки);
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(Текст), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ОписаниеЭлементаНастроекВыгрузки(Строка, Ключ, ОтборДереваМетаданных)
	
	ОписаниеЭлементаНастроекВыгрузки = Новый Структура;
	ОписаниеЭлементаНастроекВыгрузки.Вставить("КлючОбъекта", Ключ);
	Если Строка.ПриНеобходимости = 0 Тогда
		ОписаниеЭлементаНастроекВыгрузки.Вставить("ПриНеобходимости", 0);
	КонецЕсли;
	Если Строка.Пометка = 1 Тогда
		ОписаниеЭлементаНастроекВыгрузки.Вставить("Пометка", 1);
	КонецЕсли;
	
	НастройкиКомпоновкиДанных = ОтборДереваМетаданных.Получить(Ключ);
	Если НастройкиКомпоновкиДанных <> Неопределено Тогда
		ОписаниеЭлементаНастроекВыгрузки.Вставить("Отбор", ИТК_СКД.XMLТекст(НастройкиКомпоновкиДанных));
	КонецЕсли;
	
	Возврат ОписаниеЭлементаНастроекВыгрузки;
	
КонецФункции

&НаКлиенте
Процедура ЗавершенВыборФайлаНастроекВыгрузки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Сброим состояние в начальное
	ОтборДереваМетаданных = Новый Соответствие;
	
	Для Каждого СтрокаКорень Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		СтрокаКорень.Пометка = 0;
		СтрокаКорень.ПриНеобходимости = 1;
		
		Для Каждого СтрокаКоллекция Из СтрокаКорень.ПолучитьЭлементы() Цикл
			
			СтрокаКоллекция.Пометка = 0;
			СтрокаКоллекция.ПриНеобходимости = 1;
			
			Для Каждого СтрокаОбъект Из СтрокаКоллекция.ПолучитьЭлементы() Цикл
				
				СтрокаОбъект.Пометка = 0;
				СтрокаОбъект.ПриНеобходимости = 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Загрузка состояния по настройкам из файла
	ПолноеИмяФайла = ВыбранныеФайлы[0];
	
	ЧтениеТекста = Новый ЧтениеТекста(ПолноеИмяФайла, "utf-8");
	ТекстJSON = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	НастройкиВыгрузки = ИТК_ОбщийКлиентСервер.JSONСтрокуВКоллекцию(ТекстJSON);
	
	Для Каждого ОписаниеЭлементаНастроекВыгрузки Из НастройкиВыгрузки Цикл
		
		НайденнаяСтрока = НайтиСтрокуДереваМетаданныхПоПолномуИмя(ОписаниеЭлементаНастроекВыгрузки.КлючОбъекта);
		
		Пометка = ИТК_ОбщийКлиентСервер.Свойство(ОписаниеЭлементаНастроекВыгрузки, "Пометка");
		Если Пометка <> Неопределено Тогда 
			
			НайденнаяСтрока.Пометка = Пометка;
			
			ИТК_ФормаКлиент.ДеревоУстановитьПодчиненнымПометку(НайденнаяСтрока, Пометка);
			ИТК_ФормаКлиент.ДеревоОпределитьПометкуРодителя(НайденнаяСтрока, Пометка);
			
		КонецЕсли;
		
		ПриНеобходимости = ИТК_ОбщийКлиентСервер.Свойство(ОписаниеЭлементаНастроекВыгрузки, "ПриНеобходимости");
		Если ПриНеобходимости <> Неопределено Тогда 
			
			НайденнаяСтрока.ПриНеобходимости = ПриНеобходимости;
			
			ИТК_ФормаКлиент.ДеревоУстановитьПодчиненнымПометку(НайденнаяСтрока, ПриНеобходимости, "ПриНеобходимости");
			ИТК_ФормаКлиент.ДеревоОпределитьПометкуРодителя(НайденнаяСтрока, ПриНеобходимости, "ПриНеобходимости");
			
		КонецЕсли;
		
		Отбор = ИТК_ОбщийКлиентСервер.Свойство(ОписаниеЭлементаНастроекВыгрузки, "Отбор");
		Если ЗначениеЗаполнено(Отбор) Тогда
			
			НастройкиКомпоновкиДанных = ИТК_СКД.ВариантНастроек(Отбор);
			ОтборДереваМетаданных.Вставить(ОписаниеЭлементаНастроекВыгрузки.КлючОбъекта, НастройкиКомпоновкиДанных);
			ЗаполнитьДанныеСтрокиДереваМетаданных(НайденнаяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище, ОтборДереваМетаданных)
	
	ЭтоРежимРаботыКлиент = (РежимРаботы = "Клиент");
	Если ЭтоРежимРаботыКлиент Тогда
		
		Расширение = ?(ИспользоватьФорматFastInfoSet, ".fi", ".xml");
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		
	Иначе
		ИмяВременногоФайла = ИмяФайлаВыгрузки;
	КонецЕсли;
	
	ОбъектОбработка = Обработки.ИТК_ВыгрузкаЗагрузкаДанныхXMLТиповая.Создать();
	ОбъектОбработка.ДатаНачала = ПериодВыгрузки.ДатаНачала;
	ОбъектОбработка.ДатаОкончания = ПериодВыгрузки.ДатаОкончания;
	ОбъектОбработка.ИспользоватьФорматFastInfoSet = ИспользоватьФорматFastInfoSet;
	ОбъектОбработка.ВыгружатьСДокументомЕгоДвижения = ВыгружатьСДокументомЕгоДвижения;
	ОбъектОбработка.ТипВыгрузкиПериодическихРегистров = ТипВыгрузкиПериодическихРегистров;
	
	ЗаполнитьДеревоМетаданныхНаСервере(ОбъектОбработка, ОтборДереваМетаданных);
	ОбъектОбработка.ВыполнитьВыгрузку(ИмяВременногоФайла);
	
	Если ЭтоРежимРаботыКлиент Тогда
		
		Файл = Новый Файл(ИмяВременногоФайла);
		Если Файл.Существует() Тогда
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
			УдалитьФайлы(ИмяВременногоФайла);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоМетаданныхНаСервере(ОбъектОбработка, ОтборДереваМетаданных)
	
	ДеревоМетаданныхФормы = РеквизитФормыВЗначение("ДеревоМетаданных");
	ОбъектОбработка.Инициализация();
	
	ПроставитьПометкиВыгружаемыхДанных(ОбъектОбработка.ДеревоМетаданных.Строки, ДеревоМетаданныхФормы.Строки, ОтборДереваМетаданных);
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьПометкиВыгружаемыхДанных(СтрокиПриемника, СтрокиИсточника, ОтборДереваМетаданных, Уровень = 1)
	
	Для Каждого СтрокаПриемника Из СтрокиПриемника Цикл
		
		НайденнаяСтрокаИсточника = СтрокиИсточника.Найти(СтрокаПриемника.ПолноеИмяМетаданных, "Имя");
		Если НайденнаяСтрокаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПриемника.Выгружать = НайденнаяСтрокаИсточника.Пометка;
		СтрокаПриемника.ВыгружатьПриНеобходимости = НайденнаяСтрокаИсточника.ПриНеобходимости;
		
		Если Уровень = 3 И СтрокаПриемника.Выгружать Тогда
			СтрокаПриемника.ИТК_Отбор = ОтборДереваМетаданных.Получить(СтрокаПриемника.ОбъектМД.ПолноеИмя());
		КонецЕсли;
		
		ПроставитьПометкиВыгружаемыхДанных(СтрокаПриемника.Строки, НайденнаяСтрокаИсточника.Строки, ОтборДереваМетаданных, Уровень + 1);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ИТК_ВзаимодействиеАнализАктивныхДанных(Элемент) Экспорт
	
	Объекты = Новый Массив;
	Если Элемент = Элементы.ДеревоМетаданных Тогда
		
		ПолноеИмяОбъекта = ПолноеИмяОбъекта(Элемент.ТекущиеДанные);
		Если ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
			Объекты.Добавить(ПолноеИмяОбъекта);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Объекты", Объекты);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти