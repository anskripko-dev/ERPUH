
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	ВерсияОССервер = СистемнаяИнформация.ВерсияОС;
	ВерсияПриложенияСервер = СистемнаяИнформация.ВерсияПриложения;
	ОперативнаяПамятьСервер = СистемнаяИнформация.ОперативнаяПамять;
	ПроцессорСервер = СистемнаяИнформация.Процессор;
	ТипПлатформыСервер = СистемнаяИнформация.ТипПлатформы;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	Если ИТК_ОбщийКлиентСервер.ПоддерживаетсяПлатформой("8.3.22") Тогда
		ВариантПриложенияКлиент = СистемнаяИнформация.ВариантПриложения;
	Иначе
		Элементы.ВариантПриложенияКлиент.Видимость = Ложь;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		ИнформацияПрограммыПросмотраКлиент = СистемнаяИнформация.ИнформацияПрограммыПросмотра;
	#Иначе
		Элементы.ИнформацияПрограммыПросмотраКлиент.Видимость = Ложь;
	#КонецЕсли
	
	ВерсияОСКлиент = СистемнаяИнформация.ВерсияОС;
	ВерсияПриложенияКлиент = СистемнаяИнформация.ВерсияПриложения;
	ИдентификаторКлиента = СистемнаяИнформация.ИдентификаторКлиента;
	ОперативнаяПамятьКлиент = СистемнаяИнформация.ОперативнаяПамять;
	ПроцессорКлиент = СистемнаяИнформация.Процессор;
	ТипПлатформыКлиент = СистемнаяИнформация.ТипПлатформы;
	
КонецПроцедуры

#КонецОбласти
