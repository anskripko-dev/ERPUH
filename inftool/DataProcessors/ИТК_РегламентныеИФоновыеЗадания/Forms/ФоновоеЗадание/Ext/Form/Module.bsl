
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Идентификатор = Параметры.Идентификатор;
	
	ФоновоеЗадание = ИТК_ФоновыеЗадания.Получить(Идентификатор);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ФоновоеЗадание);
	ПолноеИмяМетода = ФоновоеЗадание.ИмяМетода;
	
	РегламентноеЗадание = ФоновоеЗадание.РегламентноеЗадание;
	Если РегламентноеЗадание <> Неопределено Тогда
		
		ИдентификаторРегламентногоЗадания = РегламентноеЗадание.УникальныйИдентификатор;
		НаименованиеРегламентногоЗадания = ИТК_РегламентныеЗадания.Представление(РегламентноеЗадание);
		
	КонецЕсли;
	
	Результат = ИТК_ФоновыеЗадания.СообщенияИОписаниеОшибки(ФоновоеЗадание);
	Ошибка = Результат.Ошибка;
	
	Для Каждого ТекстСообщения Из Результат.Сообщения Цикл
		Сообщения.Добавить(ТекстСообщения);
	КонецЦикла;
	
	ОбновитьЭлементыФормыПриСозданииНаСервере();
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПодключаемыйПолноеИмяМетодаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЧастиИмениМетода = СтрРазделить(ПолноеИмяМетода, ".");
	
	ИмяМодуля = ЧастиИмениМетода[0];
	ИмяМетода = ЧастиИмениМетода[1];
	
	ИТК_РедакторКодаКлиент.ОткрытьКодМодуля(ИмяМодуля, ИмяМетода);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерейтиКОшибке(Команда)
	
	ОписаниеОшибкиВМодуле = ИТК_КодКлиентСервер.ОписаниеОшибкиВМодуле(Ошибка);
	ИТК_РедакторКодаКлиент.ОткрытьКодМодуля(ОписаниеОшибкиВМодуле.ИмяМодуля, ОписаниеОшибкиВМодуле.НомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьПолноеИмяМетода(Команда)
	ИТК_БуферОбменаКлиент.Копировать(ПолноеИмяМетода);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Элементы.РегламентноеЗадание.Видимость = ЗначениеЗаполнено(ИдентификаторРегламентногоЗадания);
	Элементы.Ошибка.Видимость = ЗначениеЗаполнено(Ошибка);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыФормыПриСозданииНаСервере()
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.Сообщения);
	
	ВыгруженныеФайлы = ИТК_ФайлыКонфигурации.ПутьКФайлам();
	Элементы.ПерейтиКОшибке.Видимость = ЗначениеЗаполнено(ВыгруженныеФайлы) И ЗначениеЗаполнено(Ошибка);
	Элементы.Сообщения.Видимость = ЗначениеЗаполнено(Сообщения);
	
	Если ЗначениеЗаполнено(ВыгруженныеФайлы) Тогда
		
		ЭлементПолноеИмяМетода = Элементы.ПолноеИмяМетода;
		
		ЭлементПолноеИмяМетода.Вид = ВидПоляФормы.ПолеНадписи;
		ЭлементПолноеИмяМетода.Гиперссылка = Истина;
		
		ЭлементПолноеИмяМетода.УстановитьДействие("Нажатие", "ПодключаемыйПолноеИмяМетодаНажатие");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти