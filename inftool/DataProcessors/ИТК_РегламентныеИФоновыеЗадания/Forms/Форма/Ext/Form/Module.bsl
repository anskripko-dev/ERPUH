#Область ОписаниеПеременных

&НаКлиенте
Перем ФоновыеЗаданияПоследнееВыделение;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейс8_5 = ИТК_ОбщийКлиентСервер.ЭтоИнтерфейс8_5();
	Если ЭтоИнтерфейс8_5 Тогда
		Элементы.ВыполнитьРегламентноеЗадание.Картинка = БиблиотекаКартинок.ИТК_ВыполнитьРегламентноеЗадание;
	КонецЕсли;
	Элементы.ИзменитьФорму.Видимость = НЕ ЭтоИнтерфейс8_5;
	Элементы.ФормаКоманднаяПанель.Видимость = ЭтоИнтерфейс8_5;
	Элементы.ДанныеРегламентныхЗаданийВидеоинструкция.Видимость = НЕ ЭтоИнтерфейс8_5;
	
	УстановитьУсловноеОформление();
	ВидИнструмента = ИТК_Перечисления.ИнструментРегламентныеИФоновыеЗадания();
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.ДанныеРегламентныхЗаданий);
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.ДанныеФоновыхЗаданий);
	
	Элементы.ГруппаБлокировкаРаботыСВнешнимиРесурсами.Видимость = ИТК_БСП.РаботаСВнешнимиРесурсамиЗаблокирована();
	
	ИТК_ЗащитаЛицензирование.РегламентныеЗадания_ЗаполнитьСписокВыбора(Элементы.ОтборРегламентноеЗадание.СписокВыбора);
	ИТК_Перечисления.ЗаполнитьСписок(Элементы.ВидОтбораПоПериоду, ИТК_Перечисления.ВидыПериодовПолученияФоновыхЗаданий());
	
	РегламентныеЗаданияПоказывать = РегламентныеЗаданияПоказывать_Все();
	
	ОтборПоказывать = 50;
	
	ОтборПоСостояниюЗавершено = Истина;
	ОтборПоСостояниюЗавершеноАварийно = Истина;
	ОтборПоСостояниюОтменено = Истина;
	ОтборПоСостояниюАктивно = Истина;
	
	Если Параметры.Свойство("Имя") Тогда
		РегламентныеЗаданияПоследнееВыделение = Новый Структура("Имя", Параметры.Имя);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭлементРодительКнопки", Элементы.РегламентныеЗаданияГруппаПрочиеДействия);
	ДополнительныеПараметры.Вставить("ГруппаКонтекстногоМеню", Элементы.ДанныеРегламентныхЗаданийКонтекстноеМенюГруппаИзбранное);
	ДополнительныеПараметры.Вставить("ЭлементВставкиКолонкиПеред", Элементы.ДанныеРегламентныхЗаданийСостояние);
	ИТК_Избранное.Инициализировать(ЭтотОбъект, "ДанныеРегламентныхЗаданий", ДополнительныеПараметры);
	
	ВидОтбораПоПериоду = ИТК_Перечисления.ВидПериодаПолученияФоновыхЗаданийВсеВремя();
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	
	ОтключитьТолькоИзбранные = ЗначениеЗаполнено(РегламентныеЗаданияПоследнееВыделение);
	ИТК_ИзбранноеКлиент.ПриОткрытии(ЭтотОбъект, Элементы.ДанныеРегламентныхЗаданий, ОтключитьТолькоИзбранные);
	
	ОбновитьРегламентныеЗадания();
	
	ПодключитьОбработчикОжидания("ПодключаемыйОбновлениеРегламентныхЗаданий", 3 * 60);
	ПодключитьОбработчикОжидания("ПодключаемыйОбновлениеФоновыхЗаданий", 5 * 60);
	ПодключитьОбработчикОжидания("ПодключаемыйОбновлениеДлительностиВыполняемыхРегламентныхЗаданий", 1);
	
	ТекущийЭлемент = Элементы.ДанныеРегламентныхЗаданийПредставление;
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "РазрешенаРаботаСВнешнимиРесурсами" Тогда
		
		Элементы.ГруппаБлокировкаРаботыСВнешнимиРесурсами.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ИТК_Избранное.ПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	ИТК_Избранное.ПриСохраненииДанныхВНастройкахНаСервере(ЭтотОбъект, Настройки);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РасписаниеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИзменитьРасписаниеРегламентногоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПояснениеБлокировкаРаботыСВнешнимиРесурсамиОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИТК_БСП.РазблокироватьРаботуСВнешнимиРесурсами();
	Оповестить("РазрешенаРаботаСВнешнимиРесурсами");
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если НЕ ЗначениеЗаполнено(КоличествоФоновыхЗаданий) Тогда
		ОбновитьФоновыеЗадания();
	КонецЕсли;
	
	Если ТекущаяСтраница = Элементы.СтраницаФоновыеЗадания Тогда 
		ТекущийЭлемент = Элементы.ДанныеФоновыхЗаданий;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборПоказыватьПриИзменении(Элемент)
	ОбновитьФоновыеЗадания();
КонецПроцедуры

&НаКлиенте
Процедура ОтборРегламентноеЗаданиеПриИзменении(Элемент)
	ОбновитьФоновыеЗадания();
КонецПроцедуры

&НаКлиенте
Процедура ОтборРегламентноеЗаданиеАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ИТК_ФормаКлиент.ПоискПоСпискуВыбора(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ВидОтбораПоПериодуПриИзменении(Элемент)
	
	ТекущаяДатаСеанса = ИТК_ОбщийВызовСервера.ТекущаяДатаСервера();
	
	Если ВидОтбораПоПериоду = ИТК_Перечисления.ВидПериодаПолученияФоновыхЗаданийВсеВремя() Тогда
		
		ОтборПериодС  = Неопределено;
		ОтборПериодПо = Неопределено;
		
	ИначеЕсли ВидОтбораПоПериоду = ИТК_Перечисления.ВидПериодаПолученияФоновыхЗаданийПроизвольный() Тогда
		
		ОтборПериодС  = НачалоДня(ТекущаяДатаСеанса);
		ОтборПериодПо = КонецДня(ТекущаяДатаСеанса);
		
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	ОбновитьФоновыеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтбораПоПериодуОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанныеРегламентныхЗаданий

&НаКлиенте
Процедура ДанныеРегламентныхЗаданийПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДанныеРегламентныхЗаданий.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		РегламентныеЗаданияПоследнееВыделение = Неопределено;
		Возврат;
		
	КонецЕсли;
	
	РегламентныеЗаданияПоследнееВыделение = Новый Структура("Идентификатор", ТекущиеДанные.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеРегламентныхЗаданийВыбор(Элемент, ИдентификаторВыбраннойСтроки, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВыбраннаяСтрока = ДанныеРегламентныхЗаданий.НайтиПоИдентификатору(ИдентификаторВыбраннойСтроки);
	
	Обработано = ИТК_ИзбранноеКлиент.ОбработкаВыборВКоллекции(ВидИнструмента, ЭтотОбъект,
		"ДанныеРегламентныхЗаданий", Поле, ВыбраннаяСтрока, "Идентификатор");
	Если Обработано Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ДанныеРегламентныхЗаданийРасписание Тогда
		ИзменитьРасписаниеРегламентногоЗадания(ВыбраннаяСтрока.Идентификатор);
	Иначе
		ДобавитьИзменитьРегламентноеЗадание(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеРегламентныхЗаданийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ДобавитьИзменитьРегламентноеЗадание(Истина, Копирование);
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеРегламентныхЗаданийПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ДобавитьИзменитьРегламентноеЗадание(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДанныеРегламентныхЗаданийПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если Элемент.ТекущиеДанные.Предопределенное Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Невозможно удалить предопределенное регламентное задание';
									|en = 'Unable to delete predefined scheduled job'");
		ПоказатьПредупреждение(, ТекстПредупреждения, , ИТК_РегламентныеИФоновыеЗаданияКлиентСервер.Представление());
		Возврат;
		
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Удалить регламентное задание?';
						|en = 'Delete scheduled job?'");
	Оповещение = Новый ОписаниеОповещения("УдалитьРегламентноеЗаданиеЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ИТК_РегламентныеИФоновыеЗаданияКлиентСервер.Представление());
	
КонецПроцедуры

#КонецОбласти

