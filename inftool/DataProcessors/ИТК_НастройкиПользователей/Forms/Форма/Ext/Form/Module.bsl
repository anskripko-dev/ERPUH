#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборВидНастроекОбщие = Истина;
	ОтборВидНастроекСистемные = Истина;
	ОтборВидНастроекДанныхФорм = Истина;
	ОтборВидНастроекВариантыОтчетов = Истина;
	
	ОтборКлючОбъекта = Параметры.КлючОбъекта;
	
	Для Каждого ЭлементПараметрПользователь Из Параметры.Пользователи Цикл 
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ЭлементПараметрПользователь.Значение);
		ОтборПользователей.Добавить(ЭлементПараметрПользователь.Значение, ПользовательИБ.ПолноеИмя);
		
	КонецЦикла;
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.НастройкиПользователей);
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
	// Интерфейс 8.5
	ЭтоИнтерфейс8_5 = ИТК_ОбщийКлиентСервер.ЭтоИнтерфейс8_5();
	Если ЭтоИнтерфейс8_5 Тогда
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Авто;
	Иначе
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
	КонецЕсли;
	Элементы.КоманднаяПанельФормы.Видимость = НЕ ЭтоИнтерфейс8_5;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	ОбновитьНастройкиПользователей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВидНастроекОбщиеПриИзменении(Элемент)
	ОтборВидНастроекПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидНастроекСистемныеПриИзменении(Элемент)
	ОтборВидНастроекПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидНастроекВариантыОтчетовПриИзменении(Элемент)
	ОтборВидНастроекПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидНастроекДанныхФормПриИзменении(Элемент)
	ОтборВидНастроекПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПользовательПриИзменении(Элемент)
	ОбновитьНастройкиПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПользовательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ВыборПользователейЗавершен", ЭтотОбъект);
	ИТК_ФормаКлиент.ОткрытьВыборПользователей(ЭтотОбъект, ОтборПользователей, ОписаниеОповещенияЗавершение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКлючОбъектаПриИзменении(Элемент)
	ОбновитьНастройкиПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтборКлючНастроекПриИзменении(Элемент)
	ОбновитьНастройкиПользователей();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиПользователей

&НаКлиенте
Процедура НастройкиПользователейПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		
		НастройкиПользователейПоследнееВыделение = Неопределено;
		Возврат;
		
	КонецЕсли;
	
	НастройкиПользователейПоследнееВыделение = Новый Структура("Вид, Пользователь, КлючОбъекта, КлючНастроек");
	ЗаполнитьЗначенияСвойств(НастройкиПользователейПоследнееВыделение, ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьНовоеОкно(Команда)
	ИТК_ФормаКлиент.ОткрытьНовую(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройкиПользователей(Команда = Неопределено)
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ОтборВидНастроекОбщие", ОтборВидНастроекОбщие);
	ПараметрыПроцедуры.Вставить("ОтборВидНастроекСистемные", ОтборВидНастроекСистемные);
	ПараметрыПроцедуры.Вставить("ОтборВидНастроекВариантыОтчетов", ОтборВидНастроекВариантыОтчетов);
	ПараметрыПроцедуры.Вставить("ОтборВидНастроекДанныхФорм", ОтборВидНастроекДанныхФорм);
	
	ПараметрыПроцедуры.Вставить("ОтборКлючОбъекта", ОтборКлючОбъекта);
	ПараметрыПроцедуры.Вставить("ОтборКлючНастроек", ОтборКлючНастроек);
	ПараметрыПроцедуры.Вставить("ОтборПользователей", ОтборПользователей);
	
	ДлительнаяОперация = ОбновитьНастройкиПользователейНаСервере(ПараметрыПроцедуры, УникальныйИдентификатор);
	
	ПараметрыОжидания = ИТК_ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершеноОбновлениеНастроекПользователей", ЭтотОбъект);
	ИТК_ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНастройкиПользователей(Команда)
	
	ВыделенныеСтроки = ИТК_ФормаКлиент.ВыделенныеСтрокиКоллекции(Элементы.НастройкиПользователей);
	Если НЕ ЗначениеЗаполнено(ВыделенныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВопросУдаленияНастроек", ЭтотОбъект);
	
	ШаблонТекстаВопроса = НСтр("ru = 'Настроки (%1) будут безвозвратно удалены?'; en = 'Will the settings (%1) be permanently deleted?'");
	ТекстВопроса = СтрШаблон(ШаблонТекстаВопроса, ВыделенныеСтроки.Количество());
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Удалить'; en = 'Delete'"));
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'; en = 'Cancel'"));
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса, , КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьНастройкиПользователей(Команда)
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ВыборПользователейКопированияНастроекЗавершен", ЭтотОбъект);
	ИТК_ФормаКлиент.ОткрытьВыборПользователей(ЭтотОбъект, , ОписаниеОповещенияЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортНастроек(Команда)
	
	Если НЕ ЗначениеЗаполнено(Элементы.НастройкиПользователей.ВыделенныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	ПолучитьФайл(ФайлаНастройкиПользователейСервер(), "НастройкиПользователей.us_toolkit");
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортНастроек(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Фильтр = НСтр("ru = 'Настройки пользователей *.us_toolkit|*.us_toolkit'; en = 'User settings *.us_toolkit|*.us_toolkit'");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВыборФайлаИмпорта", ЭтотОбъект);
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ИТК_ДлительныеОперацииКлиент.ОбновитьЭлементыОтображенияСостояния(ДлительнаяОперация,
		Элементы.НастройкиПользователей, Элементы.ИдетПолучениеНастроекПользователейТабличныйДокумент,
		НСтр("ru = 'Получение настроек пользователей...';
				|en = 'Getting user settings...'"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьНастройкиПользователейНаСервере(ПараметрыПроцедуры, УникальныйИдентификатор)
	
	ПараметрыВыполнения = ИТК_ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ИТК_ДлительныеОперации.ВыполнитьВФоне("ИТК_ЗащитаЛицензирование.НастройкиПользователей_Данные", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗавершеноОбновлениеНастроекПользователей(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Результат;
	ИТК_ДлительныеОперацииКлиент.ПодготовитьРезультатВыполнения(Результат);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ОбновитьОбновлениеНастроекПользователейНаФорме(Результат.АдресРезультата);
		ИТК_ФормаКлиент.ВосстановитьВыделениеТаблицы(ЭтотОбъект, "НастройкиПользователей", НастройкиПользователейПоследнееВыделение);
		
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОбновлениеНастроекПользователейНаФорме(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	ЗначениеВРеквизитФормы(Результат, "НастройкиПользователей");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидНастроекПриИзменении(Элемент)
	
	Если НЕ (ОтборВидНастроекОбщие
			ИЛИ ОтборВидНастроекСистемные
			ИЛИ ОтборВидНастроекВариантыОтчетов
			ИЛИ ОтборВидНастроекДанныхФорм) Тогда
		ЭтотОбъект[Элемент.Имя] = Истина;
	Иначе
		ОбновитьНастройкиПользователей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПользователейЗавершен(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПользователей = Результат;
	ОбновитьНастройкиПользователей();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенВопросУдаленияНастроек(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьНастройкиПользователейНаСервере();
	ОбновитьНастройкиПользователей(Команды.ОбновитьНастройкиПользователей);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкиПользователейНаСервере()
	
	Для Каждого ИдентификаторСтроки Из Элементы.НастройкиПользователей.ВыделенныеСтроки Цикл
		
		Строка = НастройкиПользователей.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		ХранилищеНастроекМенеджер = ИТК_НастройкиПользователей.ХранилищеНастроекМенеджерПоИдентификатору(Строка.Вид);
		ХранилищеНастроекМенеджер.Удалить(Строка.КлючОбъекта, Строка.КлючНастроек, Строка.Пользователь);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПользователейКопированияНастроекЗавершен(ВыбранныеПользователи, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеПользователи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьНастройкиПользователейНаСервере(ВыбранныеПользователи);
	
	// Активизация скопированных строк
	Для Каждого ИдентификаторСтроки Из Элементы.НастройкиПользователей.ВыделенныеСтроки Цикл
		
		Строка = НастройкиПользователей.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		НастройкиПользователейПоследнееВыделение = Новый Структура("Вид, КлючОбъекта, КлючНастроек");
		ЗаполнитьЗначенияСвойств(НастройкиПользователейПоследнееВыделение, Строка);
		
		ИмяПользователяПриемника = ИмяПользователИнформационнойБазыПоУникальномуИдентификатору(ВыбранныеПользователи[0].Значение);
		НастройкиПользователейПоследнееВыделение.Вставить("Пользователь", ИмяПользователяПриемника);
		
	КонецЦикла;
	
	ОбновитьНастройкиПользователей();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяПользователИнформационнойБазыПоУникальномуИдентификатору(УникальныйИдентификатор)
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(УникальныйИдентификатор);
	Возврат ПользовательИБ.Имя;
	
КонецФункции

&НаСервере
Процедура СкопироватьНастройкиПользователейНаСервере(ВыбранныеПользователи)
	
	Для Каждого ИдентификаторСтроки Из Элементы.НастройкиПользователей.ВыделенныеСтроки Цикл
		
		Строка = НастройкиПользователей.НайтиПоИдентификатору(ИдентификаторСтроки);
		ХранилищеНастроекМенеджер = ИТК_НастройкиПользователей.ХранилищеНастроекМенеджерПоИдентификатору(Строка.Вид);
		
		Для Каждого ЭлементВыбранныеПользователь Из ВыбранныеПользователи Цикл 
			
			ОписаниеНастроек = Новый ОписаниеНастроек();
			ЗначениеНастройки = ХранилищеНастроекМенеджер.Загрузить(Строка.КлючОбъекта, Строка.КлючНастроек, ОписаниеНастроек, Строка.Пользователь);
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ЭлементВыбранныеПользователь.Значение);
			ХранилищеНастроекМенеджер.Сохранить(Строка.КлючОбъекта, Строка.КлючНастроек, ЗначениеНастройки, ОписаниеНастроек, ПользовательИБ.Имя);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ФайлаНастройкиПользователейСервер()
	
	Результат = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.НастройкиПользователей.ВыделенныеСтроки Цикл 
		
		Строка = НастройкиПользователей.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		ОписаниеНастройки = Новый Структура;
		ОписаниеНастройки.Вставить("Хранилище", Строка.Вид);
		ОписаниеНастройки.Вставить("КлючОбъекта", Строка.КлючОбъекта);
		ОписаниеНастройки.Вставить("КлючНастроек", Строка.КлючНастроек);
		ОписаниеНастройки.Вставить("Пользователь", Строка.Пользователь);
		
		ХранилищеНастроекМенеджер = ИТК_НастройкиПользователей.ХранилищеНастроекМенеджерПоИдентификатору(Строка.Вид);
		ЗначениеНастройки = ХранилищеНастроекМенеджер.Загрузить(Строка.КлючОбъекта, Строка.КлючНастроек, , Строка.Пользователь);
		
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ЗначениеВСтрокуВнутр(ЗначениеНастройки));
		СтрокаBase64 = Base64Строка(ДвоичныеДанные);
		ОписаниеНастройки.Вставить("Значение", СтрокаBase64);
		
		Результат.Добавить(ОписаниеНастройки);
		
	КонецЦикла;
	
	СтрокаРезультат = ИТК_ОбщийКлиентСервер.КоллекциюВJSONСтроку(Результат);
	Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(СтрокаРезультат), УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ЗавершенВыборФайлаИмпорта(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФайла = ВыбранныеФайлы[0];
	
	ЧтениеТекста = Новый ЧтениеТекста(ПолноеИмяФайла, "utf-8");
	ТекстJSON = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ИмпортироватьНастройкиНаСервере(ТекстJSON);
	ОбновитьНастройкиПользователей();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИмпортироватьНастройкиНаСервере(ТекстJSON)
	
	ИмпортируемыеНастройки = ИТК_ОбщийКлиентСервер.JSONСтрокуВКоллекцию(ТекстJSON);
	Для Каждого ОписаниеНастройки Из ИмпортируемыеНастройки Цикл
		
		ХранилищеНастроекМенеджер = ИТК_НастройкиПользователей.ХранилищеНастроекМенеджерПоИдентификатору(ОписаниеНастройки.Хранилище);
		
		СтрокаВнутр = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(ОписаниеНастройки.Значение));
		ЗначениеНастройки = ЗначениеИзСтрокиВнутр(СтрокаВнутр);
		
		ХранилищеНастроекМенеджер.Сохранить(ОписаниеНастройки.КлючОбъекта, ОписаниеНастройки.КлючНастроек, ЗначениеНастройки, ОписаниеНастройки.Пользователь);
		
	КонецЦикла;
	
