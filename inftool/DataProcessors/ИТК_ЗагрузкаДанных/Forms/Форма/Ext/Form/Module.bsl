
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимРаботы = "Клиент";
	ПриЗагрузкеИспользоватьРежимОбменаДанными = Истина;
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФайлаЗагрузкиЗавершение", ЭтотОбъект);
	ИТК_ВыгрузкаЗагрузкаДанныхКлиент.ОбработатьНачалоВыбораФайлаЗагрузки(ОписаниеОповещения, ИмяФайлаЗагрузки, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗагрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИТК_ФайлыКлиент.ОткрытьВПроводнике(ИмяФайлаЗагрузки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	АдресФайлаВоВременномХранилище = "";
	Если РежимРаботы = "Клиент" Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьДанныеЗавершение", ЭтотОбъект);
		ИТК_ВыгрузкаЗагрузкаДанныхКлиент.ОбработатьНачалоВыбораФайлаЗагрузки(ОписаниеОповещения, ИмяФайлаЗагрузки);
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ИмяФайлаЗагрузки) Тогда
			
			ПоказатьПредупреждение( , НСтр("ru = '""Имя файла"" не заполнено'; en = '""File name"" is empty'"));
			ТекущийЭлемент = Элементы.ИмяФайлаЗагрузки;
			Возврат;
			
		КонецЕсли;
		
		Файл = Новый Файл(ИмяФайлаЗагрузки);
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаконченаПроверкаСуществания", ЭтотОбъект);
		Файл.НачатьПроверкуСуществования(ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ЭтоРежимРаботыСервер = (РежимРаботы = "Сервер");
	
	Элементы.ИмяФайлаЗагрузки.Доступность = ЭтоРежимРаботыСервер;
	Элементы.ИмяФайлаЗагрузки.АвтоОтметкаНезаполненного = ЭтоРежимРаботыСервер;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Выполняется загрузка данных. Пожалуйста, подождите...'; en = 'Loading data. Please wait...'"));
	
	ИмяВыбранногоФайла = ВыбранныеФайлы[0];
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВыбранногоФайла);
	
	Файл = Новый Файл(ИмяВыбранногоФайла);
	ЗагрузитьДанныеНаСервере(ПоместитьВоВременноеХранилище(ДвоичныеДанные), Файл.Расширение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗагрузкиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаЗагрузки = ВыбранныеФайлы[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаконченаПроверкаСуществания(Существует, ДополнительныеПараметры) Экспорт
	
	Если Существует Тогда
		ЗагрузитьДанныеНаСервере();
	Иначе
		
		ПоказатьПредупреждение( , НСтр("ru = 'Файл не существует'; en = 'The file does not exist'"));
		ТекущийЭлемент = Элементы.ИмяФайлаЗагрузки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(АдресФайлаВоВременномХранилище = Неопределено, Расширение = Неопределено)
	
	ЭтоРежимРаботыКлиент = (РежимРаботы = "Клиент");
	Если ЭтоРежимРаботыКлиент Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		
	Иначе
		ИмяВременногоФайла = ИмяФайлаЗагрузки;
	КонецЕсли;
	
	ОбъектОбработка = Обработки.ИТК_ВыгрузкаЗагрузкаДанныхXMLТиповая.Создать();
	ОбъектОбработка.ПриЗагрузкеИспользоватьРежимОбменаДанными = ПриЗагрузкеИспользоватьРежимОбменаДанными;
	ОбъектОбработка.ПродолжитьЗагрузкуВСлучаеВозникновенияОшибки = ПродолжитьЗагрузкуВСлучаеВозникновенияОшибки;
	ОбъектОбработка.ВыполнитьЗагрузку(ИмяВременногоФайла);
	
	Если ЭтоРежимРаботыКлиент Тогда
		
		Файл = Новый Файл(ИмяВременногоФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти