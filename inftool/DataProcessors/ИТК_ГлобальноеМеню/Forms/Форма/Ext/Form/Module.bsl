#Область ОписаниеПеременных

&НаКлиенте
Перем ДоступныеОперацииИдентификаторПоследней Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Подготовка доступных операций
	ОтборПоИнструменту = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "Инструмент");
	НавигационнаяСсылка = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "НавигационнаяСсылка");
	Формы = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "Формы", Новый Массив);
	Объекты = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "Объекты", Новый Массив);
	ДинамическиеСписки = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "ДинамическиеСписки", Новый Массив);
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.ДоступныеОперации);
	ДобавитьВДоступныеОперацииПоКонтексту(ДоступныеОперации, НавигационнаяСсылка, Объекты, Формы, ДинамическиеСписки);
	ПрисутствуютДоступныеОперацииКонтекста = ЗначениеЗаполнено(ДоступныеОперации.ПолучитьЭлементы());
	
	ОбновитьЭлементыФормыПриСозданииНаСервере();
	ДобавитьВДоступныеОперацииИнструменты();
	
	ТекущийЭлемент = Элементы.ДоступныеОперацииСтрокаПоиска;
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	
	Если ДоступныеОперации.ПолучитьЭлементы().Количество() = 1 Тогда
		
		Отказ = Истина;
		
		Строка = ДоступныеОперации.ПолучитьЭлементы()[0];
		ВыбраноЗначение(Строка);
		
	КонецЕсли;
	
	ИТК_ФормаКлиент.СортироватьСтрокиДерева(ДоступныеОперации.ПолучитьЭлементы(), "Порядок");
	Для Каждого Строка Из ДоступныеОперации.ПолучитьЭлементы() Цикл
		ИТК_ФормаКлиент.СортироватьСтрокиДерева(Строка.ПолучитьЭлементы(), "Порядок");
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДоступныеОперации

&НаКлиенте
Процедура ДоступныеОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ВыбраноЗначение(Элемент.ТекущиеДанные, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьИЗакрыть(Команда)
	ВыбраноЗначение(Элементы.ДоступныеОперации.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЭлементыФормыПриСозданииНаСервере()
	
	Заголовок = Метаданные.Обработки.ИТК_ГлобальноеМеню.Представление();
	Элементы.ДоступныеОперацииГруппаОбъект.Видимость = ПрисутствуютДоступныеОперацииКонтекста;
	Элементы.ДоступныеОперацииСочетаниеКлавиш.Видимость = НЕ ЗначениеЗаполнено(ОтборПоИнструменту);
	
	Если НЕ ЗначениеЗаполнено(ОтборПоИнструменту) Тогда
		ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.ДоступныеОперации, ПоложениеСтрокиПоиска.Верх);
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Оформление = Новый Структура("ЦветТекста", ИТК_ОбщийКлиентСервер.ЦветТекстаНедоступно());
	ИТК_Форма.ДобавитьУсловноеОформление(УсловноеОформление, "ДоступныеОперацииОбъектПредставление", Оформление, "ДоступныеОперации.ЭтоГруппа", Истина);
	
	Оформление = Новый Структура("ЦветТекста", ИТК_ОбщийКлиентСервер.ЦветПалитрыСерый());
	ИТК_Форма.ДобавитьУсловноеОформление(УсловноеОформление, "ДоступныеОперацииСочетаниеКлавиш", Оформление, Неопределено, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВДоступныеОперацииИнструменты()
	
	ДобавлятьГруппуВсеИнструменты = ПрисутствуютДоступныеОперацииКонтекста
										И НЕ ЗначениеЗаполнено(ОтборПоИнструменту);
	Если ДобавлятьГруппуВсеИнструменты Тогда
		
		Инструмент = ИТК_Перечисления.Инструменты();
		ПорядокВСамомКонце = 1000000;
		СтрокаРодитель = ДобавитьСтрокуВДоступныеОперации(ДоступныеОперации, Инструмент, , , ПорядокВСамомКонце);
		
	Иначе
		СтрокаРодитель = ДоступныеОперации;
	КонецЕсли;
	
	ИнструментыИЗначения = Новый СписокЗначений;
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментКонсольЗапросов());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРедакторОбъекта());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментКонсольСхемКомпоновкиДанных());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментКонсольКода());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментАнализПравДоступа());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментМетаданные());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментМенеджерФормы());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментВыгрузкаДанных());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментЗагрузкаДанных());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПоискПоСтруктуреХранения());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРедакторКонстант());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРедакторПараметровСеанса());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРедакторЗаписиНезависимогоРегистраСведений());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПоискСсылокНаОбъект());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПоискИЗаменаСсылок());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРазмерИКоличествоДанных());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПодпискиНаСобытия());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментСравнениеОбъектов());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПользователи());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментНастройкиПользователей());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментРегламентныеИФоновыеЗадания());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментМониторЛицензий());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментЖурналРегистрации());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПользовательскиеАлгоритмы());
	
	Если ИТК_БСПКлиентСервер.ИспользуетсяБСП() Тогда
		
		ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментГрупповоеИзменениеРеквизитов());
		ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментПоискИУдалениеДублей());
		ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментУдалениеПомеченныхОбъектов());
		
	КонецЕсли;
	
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментФормаСпискаУниверсальная());
	ИнструментыИЗначения.Добавить( , ИТК_Перечисления.ИнструментОбслуживаниеСлужебные());
	
	ДобавитьДоступныеИнструментыПоЗначениям(СтрокаРодитель, ИнструментыИЗначения, "Представление");
	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуВДоступныеОперации(Родитель, Инструмент, ИдентификаторПредставления = "Представление", Объект = Неопределено, Порядок = Неопределено)
	
	Если НЕ ИТК_ТуллкитКлиентСервер.ДоступенИнструмент(Инструмент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПоИнструменту)
			И Инструмент <> ОтборПоИнструменту Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектОбработки = ИТК_Туллкит.ОбъектОбработкиИнструмента(Инструмент, Объект);
	Если ЗначениеЗаполнено(Объект) 
			И НЕ ЗначениеЗаполнено(ОбъектОбработки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаДублируется = Ложь;
	Для Каждого Строка Из Родитель.ПолучитьЭлементы() Цикл 
		
		Если Строка.Идентификатор = Инструмент
				И Строка.Объект = ОбъектОбработки Тогда
				
			СтрокаДублируется = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокаДублируется Тогда
		Возврат Строка;
	КонецЕсли;
	
	// Объект
	Если ТипЗнч(ОбъектОбработки) = Тип("Структура") Тогда
		
		Если ОбъектОбработки.Свойство("Список") Тогда
			
			СтрокаГруппа = НайтиСтрокеВДоступныхОперациях(Родитель, ОбъектОбработки["Инструмент"]);
			Если СтрокаГруппа = Неопределено Тогда
				
				СтрокаГруппа = ДобавитьСтрокуВДоступныеОперации(Родитель, ОбъектОбработки["Инструмент"], , ОбъектОбработки["Объект"]);
				СтрокаГруппа.ЭтоГруппа = Истина;
				
			КонецЕсли;
			
			Для Каждого ЭлементСписка Из ОбъектОбработки.Список Цикл
				
				ПодчиненнаяСтрока = ДобавитьСтрокуВДоступныеОперации(СтрокаГруппа, ЭлементСписка.Представление, , ЭлементСписка.Значение);
				Если ТипЗнч(ЭлементСписка.Значение) = Тип("Структура") Тогда
					
					ОписаниеАлгоритма = ЭлементСписка.Значение;
					ПодчиненнаяСтрока.Представление = ОписаниеАлгоритма.Представление;
					ПодчиненнаяСтрока.ОбъектПредставление = ОбъектОбработки["Объект"];
					
					ОписаниеОбъекта = Новый Структура;
					ОписаниеОбъекта.Вставить("Объект", ОбъектОбработки.Объект);
					ОписаниеОбъекта.Вставить("Алгоритм", ОписаниеАлгоритма);
					ПодчиненнаяСтрока.Объект = ОписаниеОбъекта;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Возврат Неопределено;
			
		Иначе
			
			НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Объект = ОбъектОбработки;
			НоваяСтрока.ОбъектПредставление = ОбъектОбработки.Представление;
			
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Объект = ОбъектОбработки;
		НоваяСтрока.ОбъектПредставление = ОбъектОбработки;
		
		ДобавлятьПояснение = ЗначениеЗаполнено(ОбъектОбработки)
								И ТипЗнч(ОбъектОбработки) <> Тип("СписокЗначений")
								И ТипЗнч(ОбъектОбработки) <> Тип("Строка");
		Если ДобавлятьПояснение Тогда
			
			ТипЗначенияОбъекта = ТипЗнч(ОбъектОбработки);
			НоваяСтрока.ОбъектКартинка = ИТК_Типы.Картинка(ТипЗначенияОбъекта);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Инструмент
	ОписаниеИнструмента = ИТК_ТуллкитКлиентСервер.ОписаниеИнструмента(Инструмент);
	
	Если Порядок = Неопределено Тогда
		Порядок = ОписаниеИнструмента.Порядок;
	КонецЕсли;
	НоваяСтрока.Порядок = Порядок;
	
	НоваяСтрока.Идентификатор = Инструмент;
	НоваяСтрока.Картинка = ОписаниеИнструмента["Картинка"];
	
	ПредставлениеИнструмента = ОписаниеИнструмента[ИдентификаторПредставления];
	ПолноеПредставлениеИнструмента  = ПредставлениеИнструмента;
	Если ТипЗнч(ОбъектОбработки) = Тип("СписокЗначений") Тогда
		ПолноеПредставлениеИнструмента = ИТК_ФормаКлиентСервер.ЗаголовокСКоличеством(ПредставлениеИнструмента, ОбъектОбработки.Количество());
	КонецЕсли;
	НоваяСтрока.Представление = ПолноеПредставлениеИнструмента;
	НоваяСтрока.СочетаниеКлавиш = ИТК_ОбщийКлиентСервер.ПредставлениеСочетанияКлавиш(ОписаниеИнструмента.СочетаниеКлавиш);
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСтрокеВДоступныхОперациях(Родитель, Идентификатор)
	
	Для Каждого ПодчиненнаяСтрока Из Родитель.ПолучитьЭлементы() Цикл
		
		Если ПодчиненнаяСтрока.Идентификатор = Идентификатор Тогда
			Возврат ПодчиненнаяСтрока;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ВыбраноЗначение(Строка, СтандартнаяОбработка = Неопределено)
	
	Если Строка = Неопределено
			ИЛИ ЗначениеЗаполнено(Строка.ПолучитьЭлементы()) Тогда 
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Закрыть();
	
	ОткрытьФормуПоСтроке(Строка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПоСтроке(Строка)
	ИТК_ТуллкитКлиент.ОткрытьИнструмент(Строка.Идентификатор, Строка.Объект);
КонецПроцедуры

&НаСервере
Процедура ДобавитьВДоступныеОперацииПоКонтексту(Родитель, НавигационнаяСсылка, Объекты, Формы, ДинамическиеСписки)
	
	// Объект по навигационной ссылке
	Ссылка = ИТК_Общий.СсылкаПоНавигационнойСсылке(НавигационнаяСсылка);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОбъектПоНавигационнойСсылке = Ссылка;
	Иначе
		ОбъектПоНавигационнойСсылке = ИТК_Метаданные.ОбъектПоНавигационнойСсылке(НавигационнаяСсылка);
	КонецЕсли;
	
	Если НайтиВОбъектахРасширенно(Объекты, ОбъектПоНавигационнойСсылке) = Неопределено
			И НЕ ИТК_Туллкит.ЭтоОбъектИзСоставаИнструментовТуллкит(ОбъектПоНавигационнойСсылке)
			И ОбъектПоНавигационнойСсылке <> Неопределено Тогда
		Объекты.Добавить(ОбъектПоНавигационнойСсылке);
	КонецЕсли;
	
	// Динамические списки (отладка
	ПорядокПочтиВСамомКонце = 10000;
	ИнструментОтладкаДинамическогоСписка = ИТК_Перечисления.ИнструментОтладкаДинамическогоСписка();
	НесколькоДинамическихСписков = (ДинамическиеСписки.Количество() > 1);
	
	Если НесколькоДинамическихСписков Тогда
		СтрокаРодитель = ДобавитьСтрокуВДоступныеОперации(ДоступныеОперации, ИнструментОтладкаДинамическогоСписка, , , ПорядокПочтиВСамомКонце);
	Иначе
		СтрокаРодитель = ДоступныеОперации;
	КонецЕсли;
	
	Порядок = 10;
	Для Каждого ОписаниеДинамическогоСписка Из ДинамическиеСписки Цикл
		
		Если НесколькоДинамическихСписков Тогда
			
			Если ОписаниеДинамическогоСписка.ЭтоТекущийЭлемент Тогда
				ПорядокСтроки = 1;
			Иначе
				ПорядокСтроки = Порядок;
			КонецЕсли;
			
		Иначе
			ПорядокСтроки = ПорядокПочтиВСамомКонце;
		КонецЕсли;
		
		ДобавитьСтрокуВДоступныеОперации(СтрокаРодитель, ИнструментОтладкаДинамическогоСписка, , ОписаниеДинамическогоСписка, ПорядокСтроки);
		Порядок = Порядок + 10;
		
	КонецЦикла;
	
	// Формы
	ПорядокВСамомКонце = 100000;
	ИнструментМенеджерФорм = ИТК_Перечисления.ИнструментМенеджерФормы();
	
	Если Формы.Количество() > 1 Тогда
		
		СтрокаРодитель = ДобавитьСтрокуВДоступныеОперации(ДоступныеОперации, ИнструментМенеджерФорм, , Формы[0].Заголовок, ПорядокВСамомКонце);
		Для Каждого ОписаниеФормы Из Формы Цикл
			ОписаниеФормы.Представление = ОписаниеФормы.ИмяПодчиненногоОкна;
		КонецЦикла;
		
	Иначе
		СтрокаРодитель = ДоступныеОперации;
	КонецЕсли;
	
	Для Каждого ОписаниеФормы Из Формы Цикл
		ДобавитьСтрокуВДоступныеОперации(СтрокаРодитель, ИнструментМенеджерФорм, , ОписаниеФормы, ПорядокВСамомКонце);
	КонецЦикла;
	
	ДанныеКонтекста = Новый Структура;
	ДанныеКонтекста.Вставить("Родитель", Родитель);
	
	ПользовательскиеАлгоритмы = ИТК_ПользовательскиеАлгоритмы.Алгоритмы();
	ДанныеКонтекста.Вставить("ПользовательскиеАлгоритмы", ПользовательскиеАлгоритмы);
	
	// Другие объекты
	Для ИндексОбъекта = 0 По Объекты.ВГраница() Цикл
		
		ПолеОбъекта = Объекты[ИндексОбъекта];
		Порядок = (ИндексОбъекта + 2) * 100;
		ОтдельнаяГруппаПоОбъекту = (Объекты.Количество() > 1) И НЕ ЗначениеЗаполнено(ОтборПоИнструменту);
		ДобавитьВДоступныеОперацииПоЗначению(ДанныеКонтекста, ПолеОбъекта, Истина, Порядок, ОтдельнаяГруппаПоОбъекту);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиВОбъектахРасширенно(Объекты, Объект)
	
	Для Каждого ПроверяемыйОбъект Из Объекты Цикл 
		
		Если ИТК_Метаданные.ЭтоКлючЗаписиНезависимогоРегистраСведений(ПроверяемыйОбъект) Тогда
			РезультатСравненияОбъектов = (ПроверяемыйОбъект = Объект);
		ИначеЕсли ТипЗнч(ПроверяемыйОбъект) = Тип("Массив") Тогда
			РезультатСравненияОбъектов = Ложь;
		ИначеЕсли ТипЗнч(Объект) = Тип("ОбъектМетаданных") Тогда
			
			МетаданныеПроверяемогоОбъекта = ИТК_Метаданные.МетаданныеСложногоОбъекта(ПроверяемыйОбъект);
			РезультатСравненияОбъектов = (МетаданныеПроверяемогоОбъекта = Объект);
			
		Иначе
			РезультатСравненияОбъектов = (ПроверяемыйОбъект = Объект);
		КонецЕсли;
		
		Если РезультатСравненияОбъектов Тогда
			Возврат ПроверяемыйОбъект;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ДобавитьВДоступныеОперацииПоЗначению(ДанныеКонтекста, Значение, ДобавлятьОткрытьЗначение = Ложь, Порядок = 0, ОтдельнаяГруппаПоОбъекту = Ложь)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Значение);
		Если ОбъектМетаданных <> Неопределено Тогда
			
			Значение = ОбъектМетаданных;
			ТипЗначения = Тип("ОбъектМетаданных");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Создание группы по объекту
	ОсновнойРодитель = ДанныеКонтекста.Родитель;
	Если ОтдельнаяГруппаПоОбъекту Тогда
		
		Родитель = ОсновнойРодитель.ПолучитьЭлементы().Добавить();
		
		Если ТипЗначения = Тип("Массив") Тогда
			
			ПредставлениеГруппы = ИТК_ОбщийКлиентСервер.МассивВСписокЗначений(Значение);
			КартинкаГруппы = Новый Картинка;
			ОбъектГруппы = Неопределено;
			
		Иначе
			
			ПредставлениеГруппы = Значение;
			КартинкаГруппы = ИТК_Типы.Картинка(ТипЗначения);
			
			ТипЗначенияОбъекта = ТипЗнч(Значение);
			Если ТипЗначенияОбъекта = Тип("ОбъектМетаданных") Тогда
				ОбъектГруппы = Значение.ПолноеИмя();
			Иначе
				ОбъектГруппы = ИТК_Типы.ПредставлениеТипа(ТипЗначенияОбъекта);
			КонецЕсли;
			
		КонецЕсли;
		
		Родитель.ЭтоГруппа = Истина;
		Родитель.Представление = ПредставлениеГруппы;
		Родитель.Картинка = КартинкаГруппы;
		Родитель.Порядок = Порядок;
		Родитель.ОбъектПредставление = ОбъектГруппы;
		
	Иначе
		Родитель = ОсновнойРодитель;
	КонецЕсли;
	
	// Добавление доступных операций
	Если ТипЗначения = Тип("Массив") Тогда
		
		ЗначениеСписок = ИТК_ОбщийКлиентСервер.МассивВСписокЗначений(Значение);
		
		ИнструментыИЗначения = Новый СписокЗначений;
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментВыгрузкаДанных());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментПоискИЗаменаСсылок());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментСравнениеОбъектов());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментДобавитьВСравнениеОбъектов());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментЗафиксироватьИзмененияНаУзлах());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментОбработкаВКонсолиКода());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментГрупповоеИзменениеРеквизитов());
		ИнструментыИЗначения.Добавить(ЗначениеСписок, ИТК_Перечисления.ИнструментЖурналРегистрации());
		ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьГруппуПользовательскиеАлгоритмы(ДанныеКонтекста, ИнструментыИЗначения, , ЗначениеСписок);
		
		ДобавитьДоступныеИнструментыПоЗначениям(Родитель, ИнструментыИЗначения, "ПредставленияДействияСписок", Порядок);
		
	Иначе
		
		ИнструментыИЗначения = Новый СписокЗначений;
		
		Если ТипЗначения = Тип("ОбъектМетаданных") Тогда
			
			ПолноеИмяОбъектаМетаданных = Значение.ПолноеИмя();
			ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныеИнструментПоОбъектуМетаданных(ДанныеКонтекста, ИнструментыИЗначения, ПолноеИмяОбъектаМетаданных);
			
			ИмяКоллекции = ИТК_Метаданные.ИмяКоллекции(ПолноеИмяОбъектаМетаданных);
			Если НЕ (ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоОтчет(ИмяКоллекции)
						ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоОбработка(ИмяКоллекции)) Тогда
				ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментСтруктураХранения(), ПолноеИмяОбъектаМетаданных);
			КонецЕсли;
			
		Иначе
			
			Если ИТК_Метаданные.ЭтоКлючЗаписиНезависимогоРегистраСведений(Значение) Тогда
				
				ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментРедакторЗаписиНезависимогоРегистраСведений(),
					Неопределено, Значение);
				ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментКопироватьНавигационнуюСсылку(),
					ПолноеИмяОбъектаМетаданных, Значение);
				
			Иначе
				
				ОбъектаМетаданных = ИТК_Метаданные.МетаданныеСложногоОбъекта(Значение);
				ПолноеИмяОбъектаМетаданных = ОбъектаМетаданных.ПолноеИмя();
				
				ИмяКоллекцииМетаданных = ИТК_Метаданные.ИмяКоллекции(ПолноеИмяОбъектаМетаданных, ИТК_ОбщийКлиентСервер.КодЯзыкаРусский());
				ПолноеИмяЗначенияОбъектаМетаданных = ПолноеИмяОбъектаМетаданных;
				Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПеречисление(ИмяКоллекцииМетаданных) Тогда
					ПолноеИмяЗначенияОбъектаМетаданных = ПолноеИмяОбъектаМетаданных + "." + XMLСтрока(Значение);
				КонецЕсли;
				
				ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныеИнструментПоОбъектуМетаданных(ДанныеКонтекста, ИнструментыИЗначения, ПолноеИмяОбъектаМетаданных, Значение);
				
				Если ДобавлятьОткрытьЗначение
						И НЕ ИТК_Метаданные.ЭтоТипТочкаМаршрутаБизнесПроцесса(ТипЗнч(Значение)) Тогда
					
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментОткрытьОбъект(),
						ПолноеИмяОбъектаМетаданных, Значение);
					
				КонецЕсли;
				
				Если ИТК_БСПКлиентСервер.ЭтоСсылкаНаСправочникПользователи(Значение) Тогда
					
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментЗапуститьПодПользователем(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментРедактированиеПользователяИБ(), ПолноеИмяОбъектаМетаданных, Значение);
					
				КонецЕсли;
				
				Если НЕ ИТК_Метаданные.ЭтоТипТочкаМаршрутаБизнесПроцесса(ТипЗнч(Значение)) Тогда
					
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментЖурналРегистрации(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментОбработкаВКонсолиКода(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментПоискИЗаменаСсылок(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментПодпискиНаСобытия(), ПолноеИмяОбъектаМетаданных);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментНастройкиПользователей(), ПолноеИмяЗначенияОбъектаМетаданных);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментВыгрузкаДанных(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментСравнениеОбъектов(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментДобавитьВСравнениеОбъектов(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментФормаСписка(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментФормаСпискаУниверсальная(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьДоступныйИнструментПоЗначению(ИнструментыИЗначения, ИТК_Перечисления.ИнструментКопироватьНавигационнуюСсылку(), ПолноеИмяОбъектаМетаданных, Значение);
					ИТК_ЗащитаЛицензирование.ГлобальноеМеню_ДобавитьГруппуПользовательскиеАлгоритмы(ДанныеКонтекста, ИнструментыИЗначения, ПолноеИмяОбъектаМетаданных, Значение);
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
		ДобавитьДоступныеИнструментыПоЗначениям(Родитель, ИнструментыИЗначения, "ПредставленияДействия", Порядок);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДоступныеИнструментыПоЗначениям(Родитель, ИнструментыИЗначения, ИдентификаторПредставления, Порядок = Неопределено)
	
	Если Порядок = Неопределено Тогда
		Порядок = 1;
	КонецЕсли;
	
	Для Каждого ИнструментИЗначение Из ИнструментыИЗначения Цикл 
		
		Инструмент = ИнструментИЗначение.Представление;
		Значение = ИнструментИЗначение.Значение;
		
		ДобавитьСтрокуВДоступныеОперации(Родитель, Инструмент, ИдентификаторПредставления, Значение, Порядок);
		
		Порядок = Порядок + 1;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
