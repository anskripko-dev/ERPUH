#Если ТонкийКлиент ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ВебКлиент Тогда

#Область ОписаниеПеременных

Перем ИТК_глФормаВсеФункции Экспорт;

Перем ИТК_глИнформацияОНовойВерсии Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

&После("ПриНачалеРаботыСистемы")
Процедура ИТК_ПриНачалеРаботыСистемы()
	
	ИТК_СравнениеОбъектовВызовСервера.ОчиститьСравниваемыеОбъекты();
	
	Если ИТК_Туллкит.ИнициализацияПослеУстановкиТребуетсяПерезапуск() Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
		Возврат;
	КонецЕсли;
	
	ИТК_ОбновлениеОбработчикаПолученияИнформацииОНовойВерсии();
	
КонецПроцедуры

&Перед("ПриГлобальномПоиске")
Процедура ИТК_ПриГлобальномПоиске(СтрокаПоиска, ПланПоиска)
	
	Если НЕ ИТК_ГлобальныйПоискВызовСервера.ДоступноРасширениеПоиска() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяМодуляГлобальногоПоиска = "ИТК_ГлобальныйПоиск";
	
	// Поиск по гиперссылке
	Если ИТК_ГлобальныйПоискКлиентСервер.ПереопределяемыйПоискПоНавигационнойСсылке(СтрокаПоиска) Тогда
		
		ЭлементПланаДанные = ПланПоиска.Найти(ИТК_ГлобальныйПоискКлиентСервер.СтандартныйВидПоискаНавигационнаяСсылка());
		Если ЭлементПланаДанные <> Неопределено Тогда
			
			ПланПоиска.Удалить(ЭлементПланаДанные);
			ПланПоиска.Добавить("ПереопределениеСтандартногоПоискаНавигационнаяСсылка", ИмяМодуляГлобальногоПоиска, Истина, , 10);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Поиск по ГУИД
	Если ИТК_Строки.ЭтоUID(СтрокаПоиска) Тогда
		ПланПоиска.Добавить("ПоискОбъектаПоГУИД", ИмяМодуляГлобальногоПоиска, Истина);
	КонецЕсли;
	
	// Полнотекстовый поиск
	ЭлементПланаДанные = ПланПоиска.Найти(ИТК_ГлобальныйПоискКлиентСервер.СтандартныйВидПоискаДанные());
	Если ЭлементПланаДанные <> Неопределено Тогда
		
		ПланПоиска.Удалить(ЭлементПланаДанные);
		
		ВыполнятьВФоне = Истина;
		ПланПоиска.Добавить("ПереопределениеСтандартногоПоискаДанные", ИмяМодуляГлобальногоПоиска, Истина, ВыполнятьВФоне, 90);
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПриВыбореДействияРезультатаГлобальногоПоиска")
Процедура ИТК_ПриВыбореДействияРезультатаГлобальногоПоиска(ЭлементРезультата, Действие)
	
	ИТК_ГлобальныйПоискКлиент.ОбработчикПриВыбореДействия(ЭлементРезультата, Действие);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИТК_ОбновлениеОбработчикаПолученияИнформацииОНовойВерсии() Экспорт
	
	ОбщиеНастройки = ИТК_Настройки.Загрузить();
	
	ИмяОбработчика = "Подключаемый_ИТК_ОбновлениеИнформацииОНовойВерсии";
	Если ОбщиеНастройки.ПроверятьИСообщатьНаличиеНовойВерсии Тогда
		
		ИТК_ОбновлениеИнформацииОНовойВерсии();
		ПодключитьОбработчикОжидания(ИмяОбработчика, 60 * 60);
		
	Иначе
		ОтключитьОбработчикОжидания(ИмяОбработчика);
	КонецЕсли;
	
КонецПроцедуры

Процедура Подключаемый_ИТК_ОбновлениеИнформацииОНовойВерсии() Экспорт
	ИТК_ОбновлениеИнформацииОНовойВерсии();
КонецПроцедуры

Процедура ИТК_ОбновлениеИнформацииОНовойВерсии() Экспорт
	
	НомерПоследнейВерсии = ИТК_ИнформацияОНовойВерсииВызовСервера.НомерПоследнейВерсии();
	Если ЗначениеЗаполнено(НомерПоследнейВерсии) Тогда
		
		ИТК_глИнформацияОНовойВерсии = Новый Структура;
		ИТК_глИнформацияОНовойВерсии.Вставить("ПоследняяВерсия", НомерПоследнейВерсии);
		
	Иначе
		ИТК_глИнформацияОНовойВерсии = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

#КонецЕсли