
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = СтрШаблон(НСтр("ru = 'Лицензирование - %1'; en = 'Licensing - %1'"),
					ИТК_ТуллкитКлиентСервер.Представление());
	
	ЛицензионныйКлюч = ИТК_ЗащитаЛицензирование.АктивированныйЛицензионныйКлюч();
	ПроверитьЛицензиюНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЛицензионныйКлючПриИзменении(Элемент)
	
	ТребуетсяАктивация = Ложь;
	ПроверитьЛицензиюНаСервере(Истина);
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицензионныйКлючИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ПодключитьОбработчикОжидания("ПодключаемыйЛицензионныйКлючИзменениеСОжиданием", 1, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АктивироватьЛицензию(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершенВопросАвтивацииЛицензии", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Внимание! При активации лицензия будет привазана к оборудованию. Продолжить?';
					|en = 'Please note: Upon activation, your license will be bound to your device. Continue?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ЗаполненКлюч = ЗначениеЗаполнено(ЛицензионныйКлюч);
	ПроизошлаОшибка = ЗначениеЗаполнено(ОшибкаЛицензии);
	
	Элементы.ГруппаОшибка.Видимость = ЗаполненКлюч И ПроизошлаОшибка;
	Элементы.ГруппаПроверкаЗавершена.Видимость = ЗаполненКлюч И НЕ ПроизошлаОшибка;
	
	Элементы.АктивироватьЛицензию.Доступность = ТребуетсяАктивация;
	
КонецПроцедуры

&НаСервере
Процедура АктивироватьЛицензиюНаСервере()
	
	РезультатАктивации = ИТК_ЛицензированиеИнфостарт.АктивироватьЛицензиюИнфостарт(ЛицензионныйКлюч);
	Если РезультатАктивации.Успех Тогда
		
		ТребуетсяАктивация = Ложь;
		ИТК_ЗащитаЛицензирование.СохранитьЛицензионныйКлюч(ЛицензионныйКлюч);
		ИТК_ЗащитаЛицензирование.СохранитьЛицензионныйКлючВФайл(ЛицензионныйКлюч);
		
	КонецЕсли;
	
	ОтобразитьРезультатВыполнения(НСтр("ru = 'Активирована успешно'; en = 'Activated successfully'"), РезультатАктивации);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЛицензиюНаСервере(СохранитьКлюч = Ложь)
	
	Если НЕ ЗначениеЗаполнено(ЛицензионныйКлюч) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ИТК_ЗащитаЛицензирование.ПроверитьЛицензию(ЛицензионныйКлюч);
	Если РезультатПроверки.Успех Тогда
		
		Если СохранитьКлюч Тогда
			ИТК_ЗащитаЛицензирование.СохранитьЛицензионныйКлюч(ЛицензионныйКлюч);
		КонецЕсли;
		
	КонецЕсли;
	
	ОтобразитьРезультатВыполнения(НСтр("ru = 'Проверено успешно'; en = 'Verified successfully'"), РезультатПроверки);
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьРезультатВыполнения(ОперацияУспешна, Результат)
	
	КартинкаПроверкаЗавершена = БиблиотекаКартинок.ИТК_УспешноПроверено;
	Если Результат.Успех Тогда
		
		ОшибкаЛицензии = Неопределено;
		НадписьПроверкаЗавершена = ОперацияУспешна;
		
	Иначе
		
		ОшибкаЛицензии = Результат.Ошибка;
		Если ИТК_ЗащитаЛицензированиеКлиентСервер.ЭтоКорректнаяНеАктивированнаяЛицензия(Результат) Тогда
			
			ОшибкаЛицензии = Неопределено;
			ТребуетсяАктивация = Истина;
			
			КартинкаПроверкаЗавершена = БиблиотекаКартинок.ИТК_Предупреждение;
			НадписьПроверкаЗавершена = НСтр("ru = 'Ключ корректный, требуется активация'; en = 'The key is correct, activation is required.'");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ПроверкаЗавершенаКартинка.Картинка = КартинкаПроверкаЗавершена;
	Элементы.ПроверкаЗавершенаНадпись.Заголовок = НадписьПроверкаЗавершена;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершенВопросАвтивацииЛицензии(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	АктивироватьЛицензиюНаСервере();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйЛицензионныйКлючИзменениеСОжиданием()
	
	Элемент = Элементы.ЛицензионныйКлюч;
	ЛицензионныйКлюч = Элемент.ТекстРедактирования;
	ЛицензионныйКлючПриИзменении(Элемент);
	
КонецПроцедуры

#КонецОбласти