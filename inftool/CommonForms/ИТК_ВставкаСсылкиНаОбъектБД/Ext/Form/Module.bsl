#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИТК_ФормаКлиентСервер.Заголовок(ЭтотОбъект, НСтр("ru = 'Вставка ссылки на объект';
													|en = 'Insert object reference'"));
	
	КодЯзыкаПрограммирования = ИТК_Общий.КодЯзыкаПрограммирования();
	ИТК_Форма.ОбновитьСписокВыбораТипОбъекта(Элементы.Тип, КодЯзыкаПрограммирования);
	
	СтандартнаяИнициализация = Истина;
	Если ЗначениеЗаполнено(Параметры.Текст) Тогда
		
		СсылкаИнициализации = ИТК_Общий.ВычислитьВыражение(Параметры.Текст);
		
		Если ТипЗнч(СсылкаИнициализации) <> Тип("Структура") Тогда
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаИнициализации));
			
			Если ОбъектМетаданных <> Неопределено Тогда
				
				СтандартнаяИнициализация = Ложь;
				
				Тип = ИТК_Метаданные.ИмяОбъектаКоллекции(ОбъектМетаданных);
				ОбновитьСписокВыбораИмя();
				Имя = ОбъектМетаданных.Имя;
				
				Ссылка = СсылкаИнициализации;
				Элементы.Ссылка.ВыбиратьТип = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтандартнаяИнициализация Тогда 
		Тип = Элементы.Тип.СписокВыбора[0];
		ОбновитьСписокВыбораИмя();
	КонецЕсли;
	
	ИТК_Форма.УстановитьНазначениеДействияКоманды(Команды.КомандаОК, "Завершение");
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипПриИзменении(Элемент)
	
	Ссылка = Неопределено;
	Имя = Неопределено;
	ОбновитьСписокВыбораИмя();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ИТК_ФормаКлиент.ПоискПоСпискуВыбора(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ИмяПриИзменении(Элемент)
	
	Ссылка = Неопределено;
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ИТК_ФормаКлиент.ПоискПоСпискуВыбора(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СсылкаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ИТК_ФормаКлиент.АвтоПодборЗначенияВФорме(Текст, Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
	Если ИТК_Строки.ЭтоНавигационнаяСсылкаДанные(Текст) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СсылкаПоНавигационнойСсылке = СсылкаПоНавигационнойСсылке(Текст);
		ДанныеВыбора = Новый СписокЗначений;
		
		ДанныеСсылки = Новый Структура;
		ДанныеСсылки.Вставить("Тип", "ОсобаяСсылка");
		ДанныеСсылки.Вставить("Ссылка", СсылкаПоНавигационнойСсылке);
		ДанныеВыбора.Добавить(ДанныеСсылки, СсылкаПоНавигационнойСсылке);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если НЕ ИТК_Строки.ЭтоНавигационнаяСсылкаДанные(Текст) Тогда
		Ссылка = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СсылкаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
			И ИТК_ОбщийКлиентСервер.Свойство(ВыбранноеЗначение, "Тип") = "ОсобаяСсылка" Тогда
		
		ЗаполнениеТипаИИмениОтСсылки(ВыбранноеЗначение.Ссылка);
		ОбновитьЭлементыФормы();
		Ссылка = ВыбранноеЗначение.Ссылка;
		
	КонецЕсли;
	
	ИТК_ФормаКлиент.ОбработкаВыбораЗначенияВФорме(Элемент, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Закрыть(Результат());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСписокВыбораИмя()
	
	СписокВыбора = Элементы.Имя.СписокВыбора;
	СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Тип) Тогда
		
		ИмяКоллекции = ИТК_Метаданные.ИмяКоллекции(Тип, КодЯзыкаПрограммирования);
		КоллекцияМетаданных = ИТК_МетаданныеПовтИсп.КоллекцияМетаданныхПоИмени(ИмяКоллекции);
		
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл 
			СписокВыбора.Добавить(ОбъектМетаданных.Имя);
		КонецЦикла;
		
		СписокВыбора.СортироватьПоЗначению();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Элементы.Имя.Доступность = ЗначениеЗаполнено(Тип);
	
	ЭлементСсылка = Элементы.Ссылка;
	Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПеречисление(Тип)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоТочкаМаршрутаБизнесПроцесса(Тип) Тогда
		ЭлементСсылка.Доступность = ЗначениеЗаполнено(Имя);
	Иначе
		ЭлементСсылка.Доступность = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Имя) Тогда
		
		ТипСсылка = ИТК_МетаданныеКлиентСервер.ПолноеИмяТипаСсылка(Тип, Имя);
		ОписаниеТипов = ИТК_ТипыКлиентСервер.ОписаниеТиповПоТипу(ТипСсылка);
		
	Иначе
		ОписаниеТипов = ИТК_ТипыКлиентСервер.ОписаниеСтрока();
	КонецЕсли;
	
	ЭлементСсылка.ОграничениеТипа = ОписаниеТипов;
	ЭлементСсылка.ДоступныеТипы = ОписаниеТипов;
	
	Элементы.ФормаКомандаОК.Доступность = ЗначениеЗаполнено(Тип) И ЗначениеЗаполнено(Имя);
	
КонецПроцедуры

&НаСервере
Функция Результат()
	
	Если Ссылка = Неопределено Тогда
		
		ТипСсылка = ИТК_МетаданныеКлиентСервер.ПолноеИмяТипаСсылка(Тип, Имя);
		ОписаниеТипов = ИТК_ТипыКлиентСервер.ОписаниеТиповПоТипу(ТипСсылка);
		Ссылка = ОписаниеТипов.ПривестиЗначение(Неопределено);
		
	КонецЕсли;
	
	Возврат ИТК_Код.Значение(Ссылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПоНавигационнойСсылке(Текст)
	Возврат ИТК_Общий.СсылкаПоНавигационнойСсылке(Текст);
КонецФункции

&НаСервере
Процедура ЗаполнениеТипаИИмениОтСсылки(НоваяСсылка)
	
	ОбъектМетаданных = НоваяСсылка.Метаданные();
	Тип = ИТК_Метаданные.ИмяОбъектаКоллекции(ОбъектМетаданных);
	ОбновитьСписокВыбораИмя();
	
	Имя = ОбъектМетаданных.Имя;
	
КонецПроцедуры

#КонецОбласти