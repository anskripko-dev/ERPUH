#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СодержимоеHTML = ТекстовоеСодержимоеHTML("https://raw.githubusercontent.com/infostart-hub/toolkit/refs/heads/master/СправочныеМатериалы.md");
	Если СодержимоеHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументHTML = ИТК_ИнформацияОНовойВерсииКлиентСервер.MarkDownВHTML(СодержимоеHTML);
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПерейтиПоНавигационнойСсылке(ДанныеСобытия.Href);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТекстовоеСодержимоеHTML(Адрес)
	
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.ОткрытьФайл(Адрес, "utf-8");
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);
	Если ДокументDOM.Тело = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДокументDOM.Тело.ТекстовоеСодержимое;
	
КонецФункции

#КонецОбласти
