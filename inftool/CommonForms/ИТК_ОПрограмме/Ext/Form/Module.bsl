#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Версия = ИТК_ТуллкитКлиентСервер.Версия();
	ДомашняяСтраница = ИТК_ТуллкитКлиентСервер.WebСайт();
	ИсторияИзмененияВерсий = "https://github.com/infostart-hub/toolkit/releases";
	
	// Заполнение интеграции с БСП
	Если ИТК_БСП.Поддерживается("2.3") Тогда
		ИнтеграцияСБСП = НСтр("ru = 'Используется';
								|en = 'Use'");
	Иначе
		ИнтеграцияСБСП = НСтр("ru = 'Не используется';
								|en = 'Not use'");
	КонецЕсли;
	
	ВерсияБСП = ИТК_БСППовтИсп.Версия();
	Если ЗначениеЗаполнено(ВерсияБСП) Тогда
		ИнтеграцияСБСП = ИнтеграцияСБСП + СтрШаблон(" (%1)", ВерсияБСП);
	КонецЕсли;
	
	Заголовок = ИТК_ТуллкитКлиентСервер.Представление();
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Заполняем информацию для технической поддержки
	ИнформацияДляТехническойПоддержки = ИТК_ТуллкитКлиент.ИнформацияДляТехническойПоддержки();
	
	// Обновление информации о версии
	ИТК_ОбновлениеИнформацииОНовойВерсии();
	Если ИТК_ИнформацияОНовойВерсииКлиент.ДоступнаНоваяВерсия() Тогда
		
		ПоследняяВерсия = ИТК_глИнформацияОНовойВерсии.ПоследняяВерсия;
		РезультатСравнения = ИТК_ОбщийКлиентСервер.СравнитьВерсии(Версия, ПоследняяВерсия);
		Если РезультатСравнения = -1 Тогда
			
			ДополнениеВерсии = СтрШаблон(НСтр("ru = 'доступна новая версия: %1'; en = 'new version available: %1'"), ПоследняяВерсия);
			Элементы.Версия.Гиперссылка = Истина;
			
		Иначе
			ДополнениеВерсии = НСтр("ru = 'актуальная версия'; en = 'current version'");
		КонецЕсли;
		Версия = Версия + Символы.НПП + "(" + ДополнениеВерсии + ")";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВерсияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИТК_ОбщийКлиент.ОткрытьИнформациюОНовойВерсии();
	
КонецПроцедуры

&НаКлиенте
Процедура ДомашняяСтраницаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПерейтиПоНавигационнойСсылке(ДомашняяСтраница);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзмененияВерсийНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПерейтиПоНавигационнойСсылке(ИсторияИзмененияВерсий);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КопироватьИнформациюДляТехническойПоддержки(Команда)
	
	ИТК_БуферОбменаКлиент.Копировать(ИнформацияДляТехническойПоддержки);
	
КонецПроцедуры

#КонецОбласти
