#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.Колонки, ПоложениеСтрокиПоиска.ЗаголовокФормы);
	
	// Заполнение списка колонок
	Для Каждого ЭлементКолонка Из Параметры.Колонки Цикл
		
		ОписаниеКолонки = ЭлементКолонка.Значение;
		
		НоваяСтрока = Колонки.Добавить();
		НоваяСтрока.Имя = ЭлементКолонка.Представление;
		НоваяСтрока.Представление = ОписаниеКолонки.Заголовок;
		
		НоваяСтрока.ТипКартинка = ИТК_Типы.КартинкаОписания(ОписаниеКолонки.ТипЗначения);
		НоваяСтрока.ТипПредставление = ИТК_Типы.ПредставлениеОписания(ОписаниеКолонки.ТипЗначения);
		
	КонецЦикла;
	
	// Утсановка текущей строки
	Отбор = Новый Структура("Имя", Параметры.Имя);
	НайденныеСтроки = Колонки.НайтиСтроки(Отбор);
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Элементы.Колонки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	ИТК_Форма.УстановитьНазначениеДействияКоманды(Команды.Выбрать, "Завершение");
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКолонки

&НаКлиенте
Процедура КолонкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Выбрать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда = Неопределено)
	
	ТекущиеДанные = Элементы.Колонки.ТекущиеДанные;
	Закрыть(ТекущиеДанные.Имя);
	
КонецПроцедуры

#КонецОбласти
