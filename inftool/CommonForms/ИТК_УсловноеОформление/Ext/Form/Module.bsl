#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИТК_ФормаКлиентСервер.ОтображатьСтрокуПоискаТаблицыФормы(Элементы.УсловноеОформлениеДерево);
	
	НомерСтроки = 1;
	Для Каждого ЭлементСписка Из Параметры.УсловноеОформление Цикл
		
		НоваяСтрока = УсловноеОформлениеДерево.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Использование = ЭлементСписка.Пометка;
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		ОписаниеЭлементаОформления = ЭлементСписка.Значение;
		НоваяСтрока.Условия = ОписаниеЭлементаОформления.Отбор;
		НоваяСтрока.Поля = ОписаниеЭлементаОформления.Поля;
		
		НоваяСтрока.Оформление = ОписаниеЭлементаОформления.Оформление;
		НоваяСтрока.ОформлениеПредставление = ПредставлениеОформления(ОписаниеЭлементаОформления.Оформление);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	УстановитьУсловноеОформление();
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПредставлениеОформления(Оформление)
	
	Результат = Новый СписокЗначений;
	
	ЧастиРезультата = Новый Массив;
	Для Каждого ЭлементОформления Из Оформление Цикл
		ЧастиРезультата.Добавить(СтрШаблон("%1 = %2", ЭлементОформления.Представление, ЭлементОформления.Значение));
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиРезультата, "; ");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Заголовок = ИТК_ФормаКлиентСервер.ЗаголовокСКоличеством(
		НСтр("ru = 'Условное оформление'; en = 'Conditional design'"),
		УсловноеОформлениеДерево.ПолучитьЭлементы().Количество());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Для Каждого СтрокаОформления Из УсловноеОформлениеДерево.ПолучитьЭлементы() Цикл
		
		Оформление = Новый Структура;
		Для Каждого ЭлементОформления Из СтрокаОформления.Оформление Цикл
			
			ИмяПараметра = ЭлементОформления.Представление;
			Если ИмяПараметра = "ЦветТекста"
					ИЛИ ИмяПараметра = "ЦветФона"
					ИЛИ ИмяПараметра = "Шрифт" Тогда
				Оформление.Вставить(ИмяПараметра, ЭлементОформления.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		ИТК_Форма.ДобавитьУсловноеОформление(УсловноеОформление, "УсловноеОформлениеДеревоОформлениеПредставление",
			Оформление, "УсловноеОформлениеДерево.НомерСтроки", СтрокаОформления.НомерСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
