Функция Исполнить(Код, Режим) Экспорт
	
	ВыполнениеСРезультатом = (Режим = ИТК_Перечисления.РежимВыполненияКодаВыполнение());
	
	Результат = Неопределено;
	Result = Неопределено;
	
	ИсполняемыйКод = ПодготовкаКодаИсполнения(Код);
	
	// Начало замера времени выполнения --------------------------------------------------------------------------------- {
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка	
		
		// BSLLS:ExecuteExternalCodeInCommonModule-off
		Выполнить(ИсполняемыйКод);
		// BSLLS:ExecuteExternalCodeInCommonModule-on
		РезультатВыполнения = Результат;
		
	Исключение
		
		ВремяВыполнения = Неопределено;
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробнаяИнформацияОбОшибке = ПодробнаяИнформацияООшибке(ИнформацияОбОшибке);
		
	КонецПопытки;
		
	// Конец замера { ---------------------------------------------------------------------------------------------------
	ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
	
	ОписаниеРезультата = Новый Структура;
	ОписаниеРезультата.Вставить("РежимВыполнения", Режим);
	ОписаниеРезультата.Вставить("ВремяВыполнения", ВремяВыполнения);
	ОписаниеРезультата.Вставить("ОшибкаПриВыполнении", ПодробнаяИнформацияОбОшибке);
	ОписаниеРезультата.Вставить("Результат", РезультатВыполнения);
	
	Возврат ОписаниеРезультата;
	
КонецФункции

Функция ЗначениеСтрока(Значение, ЗаключитьВКавычки = Истина) Экспорт
	
	Результат = СтрЗаменить(Значение, ИТК_Строки.СимволКавычки(), ИТК_Строки.СимволДвойныеКавычки()); // Заменяем кавычки в тексте двойными кавычками
	
	Если ИТК_Строки.МногострочнаяСтрока(Значение) Тогда
		Результат = СтрЗаменить(Результат, Символы.ПС, Символы.ПС + "|");
	КонецЕсли;
	
	Если ЗаключитьВКавычки Тогда
		Результат = СтрШаблон("""%1""", Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокуВЗначение(Строка) Экспорт
	
	// Убираем табуляции-незначащие символы
	СтрокиРезультата = Новый Массив;
	Для НомерСтроки = 1 По СтрЧислоСтрок(Строка) Цикл
		
		ТекстСтроки = СтрПолучитьСтроку(Строка, НомерСтроки);
		СтрокиРезультата.Добавить(СокрЛП(ТекстСтроки));
		
	КонецЦикла;
	Результат = СтрСоединить(СтрокиРезультата, Символы.ПС);
	
	// Убираем двойные кавычки
	СимволКавычки = ИТК_Строки.СимволКавычки();
	Результат = СтрЗаменить(Результат, ИТК_Строки.СимволДвойныеКавычки(), СимволКавычки);
	
	// Убираем блок-перенос строки
	Если ИТК_Строки.МногострочнаяСтрока(Результат) Тогда
		Результат = СтрЗаменить(Результат, Символы.ПС + "|", Символы.ПС);
	КонецЕсли;
		
	Если СтрНачинаетсяС(Результат, СимволКавычки) Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;
	
	Если СтрЗаканчиваетсяНа(Результат, СимволКавычки) Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодробнаяИнформацияООшибке(ИнформацияОбОшибке, КорректировкаНомераСтрокиОшибки = 0) Экспорт
	
	Результат = Новый Структура;
	
	ОписаниеОшибки = ПодробноеОписаниеОшибки(ИнформацияОбОшибке);
	
	// Корректировка номера строки ошибки
	Если ЗначениеЗаполнено(КорректировкаНомераСтрокиОшибки) Тогда
		
		Если НЕ ЗначениеЗаполнено(ОписаниеОшибки.ИмяМодуля) Тогда
			ОписаниеОшибки.НомерСтроки = ОписаниеОшибки.НомерСтроки + КорректировкаНомераСтрокиОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	// Подготовка стека вызовов
	СтекВызовов = Новый Массив;
	
	Если ИТК_ОбщийКлиентСервер.ПоддерживаетсяПлатформой("8.3.15") Тогда // С 15 платформы ПодробноеПредставлениеОшибки() возвращает стек вызовов
		ЗаполнитьСтекВызовов(СтекВызовов, ИнформацияОбОшибке);
	КонецЕсли;
	
	Результат.Вставить("СтекВызовов", СтекВызовов);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеОшибки(Ошибка) Экспорт
	
	ОписаниеОшибки = Ошибка.ОписаниеОшибки;
	
	ЗаполненоИмяМодуля = ЗначениеЗаполнено(ОписаниеОшибки.ИмяМодуля);
	НомерСтроки = ИТК_Строки.ЧислоВСтроку(ОписаниеОшибки.НомерСтроки);
	
	ЧастиОшибки = Новый Массив;
	
	// Представление ошибки
	Если ЗаполненоИмяМодуля Тогда
		
		ЧастьОшибка = ОписаниеОшибки.Описание;
		
	Иначе
		
		ЧастьОшибка = СтрШаблон("{%1} %2", НомерСтроки, ОписаниеОшибки.Описание);
		
	КонецЕсли;
	
	ЧастиОшибки.Добавить(ЧастьОшибка);
	
	// Представление модуля
	Если ЗаполненоИмяМодуля Тогда
		
		ЧастьМодуль = СтрШаблон("%1(%2): %3", ОписаниеОшибки.ИмяМодуля, НомерСтроки, ОписаниеОшибки.ИсходнаяСтрока);
		ЧастиОшибки.Добавить(ЧастьМодуль);
			
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиОшибки, Символы.ПС);
	
КонецФункции

Функция ОписаниеОшибкиВМодуле(ТекстОшибки) Экспорт
	
	Результат = Неопределено;
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтрНайти(ТекстОшибки, "{") Тогда
		
		НомерСимвола = 1;
		Текст = СокрЛП(ИТК_Строки.РазборПрочитатьДоСимвола(ТекстОшибки, "{", НомерСимвола));
		
		ИТК_Строки.РазборПропуститьНаборСимволов(ТекстОшибки, "{", НомерСимвола);
		ИмяМодуля = ИТК_Строки.РазборПрочитатьДоСимвола(ТекстОшибки, "(", НомерСимвола);
		
		ИТК_Строки.РазборПропуститьНаборСимволов(ТекстОшибки, "(", НомерСимвола);
		НомерСтроки = ИТК_Строки.РазборПрочитатьЦелоеЧисло(ТекстОшибки, НомерСимвола);
		ИТК_Строки.РазборПропуститьНаборСимволов(ТекстОшибки, ")}:", НомерСимвола);
		
		ИсходнаяСтрока = ИТК_Строки.РазборПрочитатьДоСимвола(ТекстОшибки, "", НомерСимвола);
		ИсходнаяСтрока = СокрЛП(ИсходнаяСтрока);
		
		Результат = Новый Структура;
		Результат.Вставить("Текст", Текст);
		Результат.Вставить("ИмяМодуля", ИмяМодуля);
		Результат.Вставить("НомерСтроки", НомерСтроки);
		Результат.Вставить("ИсходнаяСтрока", ИсходнаяСтрока);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеОшибкиВКоде(Текст) Экспорт
	
	// Варианты текста
	// {(1,63)}: Ожидается символ ')'
	// {<Неизвестный модуль>(1,1)}: Объявления переменных должны быть расположены в начале модуля, процедуры или функции
	
	НомерСтроки = Неопределено;
	НомерКолонки = Неопределено;
	
	ПервыйСимвол = ИТК_Строки.РазборПрочитатьСимвол(Текст);
	Если ПервыйСимвол <> "{" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерСимвола = 1;
	ИТК_Строки.РазборПропуститьНаборСимволов(Текст, "{", НомерСимвола);
	ИТК_Строки.РазборПрочитатьДоСимвола(Текст, "(", НомерСимвола);
	ИТК_Строки.РазборПропуститьНаборСимволов(Текст, "(", НомерСимвола);
	
	НомерСтроки = ИТК_Строки.РазборПрочитатьЦелоеЧисло(Текст, НомерСимвола);
	
	Символ = ИТК_Строки.РазборПрочитатьСимвол(Текст, НомерСимвола, Ложь);
	Если Символ = "," Тогда
		
		ИТК_Строки.РазборПропуститьНаборСимволов(Текст, ",", НомерСимвола);
		ИТК_Строки.РазборПрочитатьНезначимые(Текст, НомерСимвола);
		НомерКолонки = ИТК_Строки.РазборПрочитатьЦелоеЧисло(Текст, НомерСимвола);
		
	КонецЕсли;
	ИТК_Строки.РазборПропуститьНаборСимволов(Текст, ")}: ", НомерСимвола);
	
	Ошибка = ИТК_Строки.РазборПрочитатьДоСимвола(Текст, "", НомерСимвола);

	Результат = Новый Структура;
	Результат.Вставить("НомерСтроки", НомерСтроки);
	Результат.Вставить("НомерКолонки", НомерКолонки);
	Результат.Вставить("Ошибка", Ошибка);
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьСКонтекстом(Код, Контекст, ПараметрыВыполнения = Неопределено) Экспорт
	
	Если ПараметрыВыполнения.Свойство("КодВыполненияВКонтексте") Тогда
		АлгоритмРаботыСКонтекстом = ПараметрыВыполнения.КодВыполненияВКонтексте;
	Иначе
		АлгоритмРаботыСКонтекстом = КодВыполненияВКонтексте(Контекст, ПараметрыВыполнения);
	КонецЕсли;
	
	ТекстОшибки = Неопределено;
	// BSLLS:ExecuteExternalCodeInCommonModule-off
	Выполнить АлгоритмРаботыСКонтекстом;
	// BSLLS:ExecuteExternalCodeInCommonModule-on
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция КодВыполненияВКонтексте(Контекст, ПараметрыВыполнения = Неопределено) Экспорт
	
	БезопасныйРежим = ИТК_ОбщийКлиентСервер.Свойство(ПараметрыВыполнения, "БезопасныйРежим", Ложь);
	ВыполнятьВПопытке = ИТК_ОбщийКлиентСервер.Свойство(ПараметрыВыполнения, "ВыполнятьВПопытке", Истина);
	
	СтрокиКода = Новый Массив;
	Для Каждого ЭлементКонтекста Из Контекст Цикл 
		СтрокиКода.Добавить(СтрШаблон("%1 = Контекст.%1;", ЭлементКонтекста.Ключ));
	КонецЦикла;
	
	#Если Сервер Тогда
	Если БезопасныйРежим Тогда
		СтрокиКода.Добавить("УстановитьБезопасныйРежим(Истина);");
	КонецЕсли;
	#КонецЕсли
	
	Если ВыполнятьВПопытке Тогда
		
		СтрокиКода.Добавить("Попытка
		|	Выполнить Код;
		|Исключение
		|	ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		|КонецПопытки;");
		
	Иначе
		СтрокиКода.Добавить("Выполнить Код;");
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиКода, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовкаКодаИсполнения(Код)
	
	Результат = Код;
	
	Разделитель = Символы.ПС;
	
	ДобавлятьМетку = Ложь;
	ИмяМеткиВыхода = "~МеткаВКонце";
	
	// Заменим Возврат на Перейти
	СтрокиКода = СтрРазделить(Код, Разделитель);
	Для ИндексСтроки = 0 По СтрокиКода.ВГраница() Цикл 
		
		СтрокаКода = СтрокиКода[ИндексСтроки];
		
		НомерСимвола = 1;
		ИТК_Строки.РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
		Идентификатор = ИТК_Строки.РазборПрочитатьИдентификатор(СтрокаКода, НомерСимвола);
		
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВРег(Идентификатор) = "ВОЗВРАТ"
				ИЛИ ВРег(Идентификатор) = "RETURN" Тогда
				
			ДобавлятьМетку = Истина;
			
			ИТК_Строки.РазборПрочитатьНезначимые(СтрокаКода, НомерСимвола);
			СледующийСимвол = ИТК_Строки.РазборПрочитатьСимвол(СтрокаКода, НомерСимвола, Ложь);
			
			ВыражениеВозврата = ИТК_Строки.РазборПрочитатьДоСимвола(СтрокаКода, ";", НомерСимвола);
			
			НоваяСтрокаКода = "Перейти " + ИмяМеткиВыхода + ";";
			Если СледующийСимвол <> ";" Тогда
				НоваяСтрокаКода = "Результат = " + ВыражениеВозврата + ";" + НоваяСтрокаКода;
			КонецЕсли;
			
			СтрокиКода[ИндексСтроки] = НоваяСтрокаКода;
				
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = СтрСоединить(СтрокиКода, Разделитель);
	
	// Добавление метки выхода
	Если ДобавлятьМетку Тогда 
		
		Результат = Результат + "
		|" + ИмяМеткиВыхода + ":";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтекВызовов(СтекВызовов, ИнформацияОбОшибке)
	
	// Дополнение начала стека
	// https://github.com/infostart-hub/toolkit/issues/948
	ПричинаОшибки = ИнформацияОбОшибке.Причина;
	Пока ПричинаОшибки <> Неопределено Цикл 
		
		ПричинаОшибки = ПричинаОшибки.Причина;
		Если ПричинаОшибки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеСтрокиСтекаВызовов = Новый Структура;
		ОписаниеСтрокиСтекаВызовов.Вставить("ИмяМодуля", ПричинаОшибки.ИмяМодуля);
		ОписаниеСтрокиСтекаВызовов.Вставить("НомерСтроки", ПричинаОшибки.НомерСтроки);
		ОписаниеСтрокиСтекаВызовов.Вставить("ИсходнаяСтрока", ПричинаОшибки.ИсходнаяСтрока);
		ОписаниеСтрокиСтекаВызовов.Вставить("ТекстОшибки", ПричинаОшибки.Описание);
		
		СтекВызовов.Добавить(ОписаниеСтрокиСтекаВызовов);
		
		Если НЕ ЗначениеЗаполнено(ПричинаОшибки.ИмяМодуля) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИнформацияОбОшибке.ИмяМодуля) Тогда
		Возврат;
	КонецЕсли;
	
	ОшибкаПодробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	
	// Удалим ошибку в начале текста
	Если ИнформацияОбОшибке.Причина = Неопределено Тогда
		ТекстОшибки = ИнформацияОбОшибке.Описание;
	Иначе
		ТекстОшибки = ИнформацияОбОшибке.Причина.Описание;
	КонецЕсли;
	
	ОшибкаПодробно = ИТК_Строки.УдалитьПрефикс(ОшибкаПодробно, ТекстОшибки);
	ОшибкаПодробно = СокрЛП(ОшибкаПодробно);
	
	// Удалим строки вызова выполенения кода (вызовы из разширения)
	СтрокаПоиска = "{" + ИТК_ТуллкитКлиентСервер.Идентификатор();
	НомерСимвола = СтрНайти(ОшибкаПодробно, СтрокаПоиска);
	Если ЗначениеЗаполнено(НомерСимвола) Тогда
		ОшибкаПодробно = Лев(ОшибкаПодробно, НомерСимвола - 1);
	КонецЕсли;
	ОшибкаПодробно = СокрЛП(ОшибкаПодробно);
	
	// Обходим строки исключая последнию строку
	КоличествоСтрок = СтрЧислоСтрок(ОшибкаПодробно);
	Для НомерСтрокиСтекаВызовов = 1 По КоличествоСтрок - 1 Цикл 
		
		// СтрокаСтекаВызовов = "{ОбщийМодуль.ОбщегоНазначения.Модуль(2776)}:	Возврат Ссылка.Метаданные().ПолноеИмя();"
		СтрокаСтекаВызовов = СтрПолучитьСтроку(ОшибкаПодробно, НомерСтрокиСтекаВызовов);
		ОписаниеСтрокиСтекаВызовов = ОписаниеОшибкиВМодуле(СтрокаСтекаВызовов);
		Если ОписаниеСтрокиСтекаВызовов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтекВызовов.Добавить(ОписаниеСтрокиСтекаВызовов);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодробноеОписаниеОшибки(ИнформацияОбОшибке)
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяМодуля");
	Результат.Вставить("НомерСтроки");
	Результат.Вставить("ИсходнаяСтрока");
	Результат.Вставить("Описание");
	
	Если ИнформацияОбОшибке.Причина = Неопределено Тогда
		Источник = ИнформацияОбОшибке;
	Иначе
		Источник = ИнформацияОбОшибке.Причина;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, Источник);
	Если НЕ ЗначениеЗаполнено(ИнформацияОбОшибке.ИмяМодуля) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ИнформацияОбОшибке, "НомерСтроки, ИсходнаяСтрока");
	КонецЕсли;
	
	Если Результат.НомерСтроки = 0 Тогда
		
		ОписаниеОшибки = ОписаниеОшибкиВКоде(Результат.Описание);
		Если ОписаниеОшибки = Неопределено Тогда
			Результат.НомерСтроки = 1;
		Иначе
			
			Результат.НомерСтроки = ОписаниеОшибки.НомерСтроки;
			Результат.Описание = ОписаниеОшибки.Ошибка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
