Функция ПредставлениеСочетанияКлавиш(СочетаниеКлавиш) Экспорт
	
	Если СочетаниеКлавиш = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧастиПредставления = Новый Массив;
	
	Если СочетаниеКлавиш.Ctrl Тогда
		ЧастиПредставления.Добавить("Ctrl");
	КонецЕсли;
	
	Если СочетаниеКлавиш.Alt Тогда
		ЧастиПредставления.Добавить("Alt");
	КонецЕсли;
	
	Если СочетаниеКлавиш.Shift Тогда
		ЧастиПредставления.Добавить("Shift");
	КонецЕсли;
	
	ОсобыеПредставленияКлавишы = ИТК_ОбщийКлиентСерверПовтИсп.ОсобыеПредставленияКлавишы();
	ОсобоеПредставление = ОсобыеПредставленияКлавишы.Получить(СочетаниеКлавиш.Клавиша);
	Если ЗначениеЗаполнено(ОсобоеПредставление) Тогда
		ЧастиПредставления.Добавить(ОсобоеПредставление);
	Иначе
		ЧастиПредставления.Добавить(СочетаниеКлавиш.Клавиша);
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиПредставления, "+");
	
КонецФункции

