#Область СлужебныйПрограммныйИнтерфейс

Функция ДоступнаНоваяВерсия() Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИТК_глИнформацияОНовойВерсии) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РезультатСравнения = ИТК_ОбщийКлиентСервер.СравнитьВерсии(
		ИТК_ТуллкитКлиентСервер.Версия(), ИТК_глИнформацияОНовойВерсии.ПоследняяВерсия);
	Возврат (РезультатСравнения = -1);
	
КонецФункции

#КонецОбласти

