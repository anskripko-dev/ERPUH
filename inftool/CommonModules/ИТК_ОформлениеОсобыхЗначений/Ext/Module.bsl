#Область СлужебныйПрограммныйИнтерфейс

Процедура ОчиститьОформлениеПоИдентификаторуНастройки(УсловноеОформление, ИдентификаторПользовательскойНастройки) Экспорт
	
	УдаляемыеЭлементыОформления = Новый Массив;
	Для Каждого ЭлементОформления Из УсловноеОформление.Элементы Цикл 
		
		Если ЭлементОформления.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройки Тогда
			УдаляемыеЭлементыОформления.Добавить(ЭлементОформления);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементОформления Из УдаляемыеЭлементыОформления Цикл 
		УсловноеОформление.Элементы.Удалить(ЭлементОформления);
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставленияОсобыхЗначенийПоСпискуОписанийТипов(СписокОписанийТипов) Экспорт
	
	Результат = Новый Соответствие;
	Результат.Вставить(0, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеЧислаНоль());
	Результат.Вставить(Null, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеNull());
	Результат.Вставить("", ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустойСтроки());
	Результат.Вставить(ИТК_ОбщийКлиентСервер.ПустаяДата(), ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустойДаты());
	
	ПустойУникальныйИдентификатор = Новый УникальныйИдентификатор(ИТК_Строки.ПустойУникальныйИдентификатор());
	Результат.Вставить(ПустойУникальныйИдентификатор, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустогоУникальногоИдентификатора());
	
	// Имеет смысл с платформы старше 8.3.21 влияет режим совместимости
	// https://dl03.1c.ru/content/Platform/8_3_21_1140/1cv8upd_8_3_21_1140.htm#96802afd-0028-11ec-8371-0050569f678a
	Результат.Вставить(Неопределено, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеНеопределено());
	
	Для Каждого ОписаниеТипов Из СписокОписанийТипов Цикл 
		
		Для Каждого Тип Из ОписаниеТипов.Типы() Цикл 
			
			Если НЕ ИТК_ТипыКлиентСервер.ЭтоСсылочный(Тип) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Тип = Тип("ДвоичныеДанные") Тогда // Такое возможно во внешних источниках https://github.com/infostart-hub/toolkit/issues/793
				Продолжить;
			КонецЕсли;
				
			ПустаяСсылка = Новый (Тип);
			Если Результат.Получить(ПустаяСсылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
			ШаблонПредставления = НСтр("ru = '<%1 (пустая ссылка)>';
										|en = '<%1 (empty link)>'");
			Представление = СтрШаблон(ШаблонПредставления, ИТК_Метаданные.ПолноеИмя(ОбъектМетаданных));
			
			Результат.Вставить(ПустаяСсылка, Представление);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставленияОсобыхЗначенийПоОписаниюТипов(ОписаниеТипов) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Если ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Результат.Добавить(0, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеЧислаНоль());
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Null")) Тогда
		Результат.Добавить(Null, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеNull());
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Результат.Добавить("", ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустойСтроки());
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Результат.Добавить(ИТК_ОбщийКлиентСервер.ПустаяДата(), ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустойДаты());
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
		
		ПустойУникальныйИдентификатор = Новый УникальныйИдентификатор(ИТК_Строки.ПустойУникальныйИдентификатор());
		Результат.Добавить(ПустойУникальныйИдентификатор, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеПустогоУникальногоИдентификатора());
		
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Неопределено")) Тогда 
		
		// Почему не соответсвие. Имеет смысл с платформы старше 8.3.21 влияет режим совместимости
		// https://dl03.1c.ru/content/Platform/8_3_21_1140/1cv8upd_8_3_21_1140.htm#96802afd-0028-11ec-8371-0050569f678a
		Результат.Добавить(Неопределено, ИТК_ОформлениеОсобыхЗначенийПовтИсп.ПредставлениеНеопределено());
		
	КонецЕсли;
	
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл 
		
		Если НЕ ИТК_ТипыКлиентСервер.ЭтоСсылочный(Тип) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Тип = Тип("ДвоичныеДанные") Тогда // Такое возможно во внешних источниках https://github.com/infostart-hub/toolkit/issues/793
			Продолжить;
		КонецЕсли;
		
		ПустаяСсылка = Новый (Тип);
		Если Результат.НайтиПоЗначению(ПустаяСсылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		ШаблонПредставления = НСтр("ru = '<%1 (пустая ссылка)>'; en = '<%1 (empty link)>'");
		Представление = СтрШаблон(ШаблонПредставления, ИТК_Метаданные.ПолноеИмя(ОбъектМетаданных));
		
		Результат.Добавить(ПустаяСсылка, Представление);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

