#Область ПрограммныйИнтерфейс

Процедура Открыть(Инструмент = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Инструмент", Инструмент);
	
	Если Инструмент = Неопределено Тогда
		АнализироватьОткрытыеФормы = Истина;
	Иначе
		ОбщиеНастройки = ИТК_Настройки.Загрузить();
		АнализироватьОткрытыеФормы = ОбщиеНастройки.АнализироватьОткрытыеФормыПриБыстромЗапускеИнструментов;
	КонецЕсли;
	
	Если АнализироватьОткрытыеФормы Тогда
		ЗаполнитьПараметрыПоКонтекстуОткрытыхФорм(ПараметрыФормы);
	КонецЕсли;
	
	ЭтоВызовИзГлобальногоМеню = (Инструмент = Неопределено);
	Формы = ИТК_ОбщийКлиентСервер.Свойство(ПараметрыФормы, "Формы", Неопределено);
	Объекты = ИТК_ОбщийКлиентСервер.Свойство(ПараметрыФормы, "Объекты", Неопределено);
	ЗаполненКонтекстГлобальногоМеню = ЗначениеЗаполнено(Объекты)
										ИЛИ (Инструмент = ИТК_Перечисления.ИнструментМенеджерФормы() И ЗначениеЗаполнено(Формы));
	Если ЭтоВызовИзГлобальногоМеню 
			ИЛИ ЗаполненКонтекстГлобальногоМеню Тогда
		РежимОткрытияФормы = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	Иначе
		РежимОткрытияФормы = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
	ОткрытьФорму("Обработка.ИТК_ГлобальноеМеню.Форма", ПараметрыФормы, , , , , , РежимОткрытияФормы);
	
КонецПроцедуры

Процедура АнализАктивныхДанныхФормы_ДобавлениеДанныхТаблицыФормы(КонтекстАнализа, Объекты, ЭлементТаблица) Экспорт
	
	ТекущаяСтрока = ЭлементТаблица.ТекущаяСтрока;
	
	ТекущаяКолонка = ЭлементТаблица.ТекущийЭлемент;
	ИмяКоллекцииТекущиеДанные = ИТК_ОбщийКлиентСервер.ИмяКоллекцииТекущиеДанные();
	
	Если ТипЗнч(ТекущаяСтрока) = Тип("Число") Тогда
		
		Родитель = ИТК_ФормаКлиент.КоллекцияРодитель(ТекущаяКолонка);
		ИмяРодителя = Родитель.Имя;
		
		ИмяПоля = ТекущаяКолонка.Имя;
		Если СтрНачинаетсяС(ИмяПоля, ИмяРодителя) Тогда
			ИмяПоля = Сред(ИмяПоля, СтрДлина(ИмяРодителя) + 1);
		КонецЕсли;
		
		ДобавитьПолеКоллекцииОбъектаСПопыткой(КонтекстАнализа, Объекты, ЭлементТаблица, ИмяПоля, ИмяКоллекцииТекущиеДанные);
		
	Иначе
		
		// Динамический список
		ВыделенныеСтроки = ЭлементТаблица.ВыделенныеСтроки;
		ВыделеноНесколькоСтрок = (ВыделенныеСтроки.Количество() > 1);
		Если ВыделеноНесколькоСтрок Тогда
			ПолеОбъекта = ВыделенныеСтроки;
		Иначе
			
			ПолеОбъекта = ТекущаяСтрока;
			Если ТипЗнч(ПолеОбъекта) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
				ПолеОбъекта = ПолеОбъекта.Ключ;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПолеОбъекта = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ИТК_ТипыКлиентСервер.ЭтоСсылочный(ТипЗнч(ПолеОбъекта))
				ИЛИ ТипЗнч(ПолеОбъекта) = Тип("Массив")
				ИЛИ ИТК_МетаданныеКлиентСервер.ОбъектКлючЗаписиНезависимогоРегистраСведений(ПолеОбъекта)
				ИЛИ ИТК_МетаданныеКлиентСервер.ОбъектКлючЗаписиРегистра(ПолеОбъекта) Тогда
			Объекты.Добавить(ПолеОбъекта);
		КонецЕсли;
		
		Если НЕ ВыделеноНесколькоСтрок Тогда
			ДобавитьПолеКоллекцииОбъектаСПопыткой(КонтекстАнализа, Объекты, ЭлементТаблица, ТекущаяКолонка, ИмяКоллекцииТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПараметрыПоКонтекстуОткрытыхФорм(ПараметрыФормы)
	
	АктивноеОкно = АктивноеОкно();
	Для Каждого ОткрытоеОкно Из ПолучитьОкна() Цикл 
		
		Если АктивноеОкно = Неопределено И ОткрытоеОкно.НачальнаяСтраница Тогда
			АктивноеОкно = ОткрытоеОкно;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеАнализаФормы = АнализАктивныхДанныхФормы(АктивноеОкно);
	Если ЗначениеЗаполнено(ДанныеАнализаФормы) Тогда
		
		Для Каждого КлючИЗначение Из ДанныеАнализаФормы Цикл 
			ПараметрыФормы.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция АнализАктивныхДанныхФормы(АктивноеОкно)
	
	Если АктивноеОкно = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Формы = Новый Массив;
	Объекты = Новый Массив;
	ДинамическиеСписки = Новый Массив;
	НавигационнаяСсылка = АктивноеОкно.ПолучитьНавигационнуюСсылку();
	
	Для Каждого ОкноКлиентскогоПриложения Из АктивноеОкно.Содержимое Цикл
		
		ТекущийЭлемент = ОкноКлиентскогоПриложения.ТекущийЭлемент;
		
		АнализАктивныхДанныхФормы_ДобавитьФорму(Формы, АктивноеОкно, ОкноКлиентскогоПриложения);
		АнализАктивныхДанныхФормы_ДобавитьОтладкуДинамическихСписков(ДинамическиеСписки, ОкноКлиентскогоПриложения);
		
		// Шаблон отчета на СКД в БСП
		Если ОкноКлиентскогоПриложения.ИмяФормы = ИТК_БСПКлиентСерверПовтИсп.ПолноеИмяФормыШаблонаОтчетаНаСКД()
				И ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
			
			ДанныеФормыОтчетаНаСКД = ИТК_БСП.ДанныеФормыШаблонаОтчетаНаСКД(НавигационнаяСсылка);
			
			Если ЗначениеЗаполнено(ДанныеФормыОтчетаНаСКД) Тогда
				
				НавигационнаяСсылка = ДанныеФормыОтчетаНаСКД.НавигационнаяСсылка;
				ДобавитьОбъект(Объекты, ДанныеФормыОтчетаНаСКД.ВариантОтчета);
				
			КонецЕсли;
			
		КонецЕсли;
		
		КонтекстАнализа = Новый Структура;
		КонтекстАнализа.Вставить("ПутиКДанным",
			ИТК_ФормаКлиент.СерверныйВызовВКонтекстеФормы(ОкноКлиентскогоПриложения, "ИТК_МенеджерФорм.ПутиКДаннымЭлементов"));
		
		// Анализ содержимого
		Если ТипЗнч(ТекущийЭлемент) = Тип("ПолеФормы") Тогда
			АнализАктивныхДанныхФормы_ДобавлениеДанныхПоля(КонтекстАнализа, Объекты, ОкноКлиентскогоПриложения, ТекущийЭлемент);
		ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
			АнализАктивныхДанныхФормы_ДобавлениеДанныхТаблицыФормы(КонтекстАнализа, Объекты, ТекущийЭлемент);
		КонецЕсли;
		
		АнализАктивныхДанныхФормы_ДополнениеНашимиДанными(Объекты, ОкноКлиентскогоПриложения, ТекущийЭлемент);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Формы", Формы);
	Результат.Вставить("Объекты", Объекты);
	Результат.Вставить("ДинамическиеСписки", ДинамическиеСписки);
	Результат.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
	Возврат Результат;
	
КонецФункции

Процедура АнализАктивныхДанныхФормы_ДобавитьФорму(Формы, АктивноеОкно, ПодчиненноеОкно)
	
	ОписаниеФормы = Новый Структура;
	ОписаниеФормы.Вставить("Значение", ПодчиненноеОкно.УникальныйИдентификатор);
	
	ПредставлениеФормы = ИТК_ИнструментМенеджерФормыКлиент.ПредставлениеФормы(АктивноеОкно, ПодчиненноеОкно);
	ОписаниеФормы.Вставить("Представление", ПредставлениеФормы);
	ОписаниеФормы.Вставить("Заголовок", АктивноеОкно.Заголовок);
	ОписаниеФормы.Вставить("ИмяПодчиненногоОкна", ПодчиненноеОкно.ИмяФормы);
	
	Формы.Добавить(ОписаниеФормы);
	
КонецПроцедуры

Процедура АнализАктивныхДанныхФормы_ДобавлениеДанныхПоля(КонтекстАнализа, Объекты, ОкноКлиентскогоПриложения, Элемент)
	
	ВидПоля = Элемент.Вид;
	Если ВидПоля = ВидПоляФормы.ПолеВвода
			ИЛИ ВидПоля = ВидПоляФормы.ПолеНадписи Тогда
			
		ИмяРеквизитаОбъект = ИТК_ОбщийКлиентСервер.ИмяРеквизитаФормыОбъект();
		
		ДобавленоПолеОбъекта = ДобавитьПолеКоллекцииОбъектаСПопыткой(КонтекстАнализа, Объекты, ОкноКлиентскогоПриложения, Элемент, ИмяРеквизитаОбъект);
		Если НЕ ДобавленоПолеОбъекта Тогда
			ДобавитьПолеКоллекцииОбъектаСПопыткой(КонтекстАнализа, Объекты, ОкноКлиентскогоПриложения, Элемент);
		КонецЕсли;
		
	ИначеЕсли ВидПоля = ВидПоляФормы.ПолеТабличногоДокумента Тогда // Ячейки табличного документа
		
		ПутьКДанным = ПутьКДаннымЭлемента(КонтекстАнализа, Элемент);
		Попытка
			ТабличныйДокумент = ОкноКлиентскогоПриложения[ПутьКДанным];
		Исключение
			Возврат;
		КонецПопытки;
		
		Попытка
			
			ИмяРеквизитаРасшифровкиОтчета = ИТК_ОбщийКлиентСервер.ИмяРеквизитаРасшифровкиОтчета();
			АдресДанныхРасшифровки = ОкноКлиентскогоПриложения[ИмяРеквизитаРасшифровкиОтчета]; 
			
		Исключение
			АдресДанныхРасшифровки = Неопределено;
		КонецПопытки;
		
		ДоступныДанныеРасшифровки = (АдресДанныхРасшифровки <> Неопределено);
		ЗначенияРасшифровки = ИТК_ТабличныйДокументКлиент.ЗначенияРасшифровокВыделенныхОбластей(ТабличныйДокумент, Элемент, ДоступныДанныеРасшифровки);
		
		Если ДоступныДанныеРасшифровки Тогда
			ЗначенияРасшифровки = ИТК_ТабличныйДокумент.ЗначенияРасшифровокСЗаполнениеРасшифровокСКД(ЗначенияРасшифровки, АдресДанныхРасшифровки);
		КонецЕсли;
		
		// Выделенные области
		Если ЗначенияРасшифровки.Количество() = 1 Тогда
			
			ПервоеЗначение = ЗначенияРасшифровки[0];
			ДобавитьОбъект(Объекты, ПервоеЗначение);
			
		Иначе
			ДобавитьОбъект(Объекты, ЗначенияРасшифровки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура АнализАктивныхДанныхФормы_ДополнениеНашимиДанными(Объекты, ОкноКлиентскогоПриложения, Элемент)
	
	Попытка
		ДополнениеАнализа = Вычислить("ОкноКлиентскогоПриложения.ИТК_ВзаимодействиеАнализАктивныхДанных(Элемент)");
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого ДополнительныйОбъект Из ДополнениеАнализа.Объекты Цикл 
		ДобавитьОбъект(Объекты, ДополнительныйОбъект, Ложь);
	КонецЦикла;
	
КонецПроцедуры

Процедура АнализАктивныхДанныхФормы_ДобавитьОтладкуДинамическихСписков(ДинамическиеСписки, ПодчиненноеОкно)
	
	ДанныеОтладкиДинамическихСписков = ИТК_ФормаКлиент.СерверныйВызовВКонтекстеФормы(ПодчиненноеОкно, "ИТК_МенеджерФорм.ДанныеОтладкиДинамическихСписков");
	Если ДанныеОтладкиДинамическихСписков = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОписаниеДинамическогоСписка Из ДанныеОтладкиДинамическихСписков Цикл
		ДинамическиеСписки.Добавить(ОписаниеДинамическогоСписка);
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьПолеКоллекцииОбъектаСПопыткой(КонтекстАнализа, Объекты, Владелец, ЭлементПутьКДанным, ИмяКоллекцииОбъекта = Неопределено)
	
	Если ЭлементПутьКДанным = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ЭлементПутьКДанным) = Тип("Строка") Тогда
		ПутьКДанным = ЭлементПутьКДанным;
	Иначе
		ПутьКДанным = ПутьКДаннымЭлемента(КонтекстАнализа, ЭлементПутьКДанным);
	КонецЕсли;
	
	Попытка
		
		Если ИмяКоллекцииОбъекта = Неопределено Тогда
			Поле = Владелец[ПутьКДанным];
		Иначе
			
			Попытка
				Поле = Владелец[ИмяКоллекцииОбъекта][ПутьКДанным];
			Исключение
				
				ПутьКДаннымВладельца = ПутьКДаннымЭлемента(КонтекстАнализа, Владелец);
				Если СтрНайти(ПутьКДанным, ".") Тогда
					ДругоеИмя = ИТК_Строки.УдалитьПрефикс(ПутьКДанным, ПутьКДаннымВладельца + ".");
				Иначе
					ДругоеИмя = ИТК_Строки.УдалитьПрефикс(ПутьКДанным, ПутьКДаннымВладельца);
				КонецЕсли;
				
				Поле = Владелец[ИмяКоллекцииОбъекта][ДругоеИмя];
				
			КонецПопытки;
			
		КонецЕсли;
		
		Результат = Истина;
		
	Исключение
		
		Поле = Неопределено;
		Результат = Ложь;
		
	КонецПопытки;
	
	ДобавитьОбъект(Объекты, Поле);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьОбъект(Объекты, Поле, НеобходимоПроверитьТипПоля = Истина)
	
	Если НеобходимоПроверитьТипПоля
			И НЕ (ИТК_ТипыКлиентСервер.ЭтоСсылочный(ТипЗнч(Поле))
				ИЛИ ТипЗнч(Поле) = Тип("Массив")) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка 
		ЗначениеЗаполнено = ЗначениеЗаполнено(Поле);
	Исключение
		ЗначениеЗаполнено = Ложь;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объекты.Найти(Поле) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объекты.Добавить(Поле);
	
КонецПроцедуры

Функция ПутьКДаннымЭлемента(КонтекстАнализа, Элемент)
	
	Если КонтекстАнализа.ПутиКДанным = Неопределено Тогда
		Результат = Элемент.Имя;
	Иначе
		
		Результат = КонтекстАнализа.ПутиКДанным.Получить(Элемент.Имя);
		Результат = ИТК_Строки.УдалитьПрефикс(Результат, "Объект.");
		Результат = ИТК_Строки.УдалитьПрефикс(Результат, "Object.");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
