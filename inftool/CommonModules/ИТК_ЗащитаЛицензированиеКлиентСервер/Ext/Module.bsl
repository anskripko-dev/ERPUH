#Область СлужебныйПрограммныйИнтерфейс

Функция ПредставлениеОшибки(Результат) Экспорт
	
	ПредставленияКодов = Новый Соответствие;
	ПредставленияКодов.Вставить("NO_MACHINE", НСтр("ru = 'Лицензионный ключ не активирован'; en = 'License key is not activated'"));
	ПредставленияКодов.Вставить("NOT_FOUND", НСтр("ru = 'Лицензионный ключ не найден'; en = 'License key not found'"));
	ПредставленияКодов.Вставить("SUSPENDED", НСтр("ru = 'Лицензия приостановлена'; en = 'License has been suspended'"));
	ПредставленияКодов.Вставить("PRODUCT_SCOPE_MISMATCH", НСтр("ru = 'Идентификатор продукта не соответствует лицензии'; en = 'The product identifier does not match the license'"));
	ПредставленияКодов.Вставить(КодОшибкиПревышенЛимитСеансов(), НСтр("ru = 'Превышен лимит сеансов для конкретной машины'; en = 'The session limit for a specific machine has been exceeded'"));
	ПредставленияКодов.Вставить(КодОшибкиНекорректныйФайлЛицензии(), НСтр("ru = 'Некорректный файл лицензии'; en = 'License file not correct'"));
	ПредставленияКодов.Вставить(КодОшибкиСрокДействияЛицензииИстек(), НСтр("ru = 'Срок действия лицензии истёк'; en = 'License has expired'"));
	ПредставленияКодов.Вставить(КодОшибкиОтличаетсяОтпечатокМашины(), НСтр("ru = 'Отпечаток машины не совпадает с привязками лицензии'; en = 'Vehicle's fingerprint does not match the license bindings.'"));
	
	ТекстОшибки = ПредставленияКодов.Получить(Результат.Код);
	Если ТекстОшибки = Неопределено Тогда
		
		ШаблонОшибки = НСтр("ru = 'Неизвестная ошибка лицензирования, код: %1'; en = 'Unknown licensing error, code: %1'");
		ТекстОшибки = СтрШаблон(ШаблонОшибки, Результат.Код);
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ЭтоКорректнаяНеАктивированнаяЛицензия(Результат) Экспорт
	Возврат (Результат.Код = "NO_MACHINE");
КонецФункции

Функция ЭтоПустаяЛицензия(Результат) Экспорт
	Возврат (Результат.Код = "EMPTY_LICENSE");
КонецФункции

Функция ЭтоОграничениеИспользованияПоПользователям(Результат) Экспорт
	Возврат (Результат.Код = "MACHINE_PROCESS_LIMIT_EXCEEDED");
КонецФункции

Функция КодОшибкиНекорректныйФайлЛицензии() Экспорт
	Возврат "LICENSE_FILE_NOT_CORRECT";
КонецФункции

Функция КодОшибкиСрокДействияЛицензииИстек() Экспорт
	Возврат "EXPIRED";
КонецФункции

Функция КодОшибкиПревышенЛимитСеансов() Экспорт
	Возврат "MACHINE_PROCESS_LIMIT_EXCEEDED";
КонецФункции

Функция КодОшибкиОтличаетсяОтпечатокМашины() Экспорт
	Возврат "FINGERPRINT_SCOPE_MISMATCH";
КонецФункции

#КонецОбласти