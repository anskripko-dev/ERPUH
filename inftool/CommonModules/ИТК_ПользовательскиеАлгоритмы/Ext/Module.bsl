#Область ПрограммныйИнтерфейс

Функция Алгоритмы() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ПользовательскиеАлгоритмы = ХранилищеОбщихНастроек.Загрузить(ИТК_ТуллкитКлиентСервер.ОсновнойКлючОбъектаНастроек(),
		КлючНастроекПользовательскиеАлгоритмы(), , ИТК_ТуллкитКлиентСервер.ПользовательОбщихНастроек());
	
	Если ПользовательскиеАлгоритмы = Неопределено Тогда
		ПользовательскиеАлгоритмы = Новый Соответствие;
	КонецЕсли;
	
	Возврат ПользовательскиеАлгоритмы;
	
КонецФункции

Процедура СохранитьАлгоритм(Идентификатор, ОписаниеАлгоритма) Экспорт
	
	ПользовательскиеАлгоритмы = Алгоритмы();
	
	СохраняемоеОписание = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ОписаниеАлгоритма();
	ЗаполнитьЗначенияСвойств(СохраняемоеОписание, ОписаниеАлгоритма);
	ПользовательскиеАлгоритмы.Вставить(Идентификатор, СохраняемоеОписание);
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(ИТК_ТуллкитКлиентСервер.ОсновнойКлючОбъектаНастроек(),
		КлючНастроекПользовательскиеАлгоритмы(), ПользовательскиеАлгоритмы, , ИТК_ТуллкитКлиентСервер.ПользовательОбщихНастроек());
	
КонецПроцедуры

Процедура УдалитьАлгоритмы(Идентификаторы) Экспорт
	
	ПользовательскиеАлгоритмы = Алгоритмы();
	
	Если ТипЗнч(Идентификаторы) = Тип("УникальныйИдентификатор") Тогда
		ПользовательскиеАлгоритмы.Удалить(Идентификаторы);
	Иначе
		
		Для Каждого Идентификатор Из Идентификаторы Цикл
			ПользовательскиеАлгоритмы.Удалить(Идентификатор);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(ИТК_ТуллкитКлиентСервер.ОсновнойКлючОбъектаНастроек(),
		КлючНастроекПользовательскиеАлгоритмы(), ПользовательскиеАлгоритмы, , ИТК_ТуллкитКлиентСервер.ПользовательОбщихНастроек());
	
КонецПроцедуры

Функция ОписаниеАлгоритма(Идентификатор) Экспорт
	
	ПользовательскиеАлгоритмы = Алгоритмы();
	
	ОписаниеАлгоритма = ПользовательскиеАлгоритмы.Получить(Идентификатор);
	
	Результат = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ОписаниеАлгоритма();
	ЗаполнитьЗначенияСвойств(Результат, ОписаниеАлгоритма);
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьКодНаСервере(ОписаниеАлгоритма, Объект) Экспорт
	
	Результат = Новый Структура;
	
	Если ОписаниеАлгоритма.ОбработкаСписка Тогда
		РезультатОбработки = Новый Соответствие;
	Иначе
		РезультатОбработки = Неопределено;
	КонецЕсли;
	Результат.Вставить("РезультатОбработки", РезультатОбработки);
	
	ДополнительныеПараметры = Новый Структура;
	Результат.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если НЕ ЗначениеЗаполнено(ОписаниеАлгоритма.КодНаСервере) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЭтоТипОбъектовОбъектСсылка = (ОписаниеАлгоритма.ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовСсылка());
	ЭтоТипОбъектовОбъектМетаданных = (ОписаниеАлгоритма.ТипОбъектов = ИТК_ПользовательскиеАлгоритмыКлиентСервер.ТипОбрабатываемыхОбъектовОбъектМетаданных());
	
	Контекст = Новый Структура;
	
	Если ОписаниеАлгоритма.ОбработкаСписка Тогда
		
		// Объекты
		Если ЭтоТипОбъектовОбъектСсылка Тогда
			
			Объекты = Объект;
			Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъекты(), Объекты);
			Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъекты("en"), Объекты);
			
		КонецЕсли;
		
	Иначе
		
		// Объект
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Объект);
		Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъект(), ОбъектМетаданных);
		Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаОбъект("en"), ОбъектМетаданных);
		
	КонецЕсли;
	
	// РезультатОбработки
	Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаРезультатОбработки(), РезультатОбработки);
	Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаРезультатОбработки("en"), РезультатОбработки);
	
	// ДополнительныеПараметры
	Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаДополнительныеПараметры(), ДополнительныеПараметры);
	Контекст.Вставить(ИТК_ПользовательскиеАлгоритмыКлиентСервер.ИмяПеременнойКонтекстаДополнительныеПараметры("en"), ДополнительныеПараметры);
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("БезопасныйРежим", Истина);
	ПараметрыВыполнения.Вставить("ВыполнятьВПопытке", Ложь);
	
	ИТК_КодКлиентСервер.ВыполнитьСКонтекстом(ОписаниеАлгоритма.КодНаСервере, Контекст, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючНастроекПользовательскиеАлгоритмы()
	Возврат "ПользовательскиеАлгоритмы";
КонецФункции

#КонецОбласти
