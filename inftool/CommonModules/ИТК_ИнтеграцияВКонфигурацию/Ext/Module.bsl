#Область ПрограммныйИнтерфейс

Функция Используется() Экспорт
	Возврат ПравоДоступа("Просмотр", Метаданные.Подсистемы.ИТК_InfostartToolkit);
КонецФункции

Процедура ОтладкаДинамическогоСписка(Ссылка, ПараметрыВыполнения) Экспорт
	
	ИмяНастроек = "Отладка дин.списка";
	
	ПолеИсточник = "Источник";
	ПолеФорма = "Форма";
	ПолеРезультат = "Результат";
	ПолеТекст = "Текст";
	
	Если ИТК_БСППовтИсп.АнглийскаяБСП() Тогда
		
		ИмяНастроек = "Debug Din.List";
		
		ПолеИсточник = "Source";
		ПолеФорма = "Form";
		ПолеРезультат = "Result";
		ПолеТекст = "Text";
		
	КонецЕсли;
	
	СохраненоУспешно = Истина;
	Источник = ПараметрыВыполнения[ПолеИсточник];
	
	Попытка
		
		Если ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
			
			РеквизитСписок = ПараметрыВыполнения[ПолеФорма][Источник.Имя];
			Если ТипЗнч(РеквизитСписок) = Тип("ДинамическийСписок") Тогда
				
				СхемаКомпоновкиДанных = Источник.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
				НастройкиКомпоновкиДанных = Источник.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
				ИТК.Отл(СхемаКомпоновкиДанных, ИмяНастроек, НастройкиКомпоновкиДанных);
				СохраненоУспешно = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		СохраненоУспешно = Ложь;
	КонецПопытки;
	
	Если СохраненоУспешно Тогда
		ТекстРезультат = НСтр("ru = 'Отладочная информация сохранена, откройте консоль СКД для анализа запросов';
		|en = 'Debug information saved, open the DCS console to analyze requests'");
	Иначе
		ТекстРезультат = НСтр("ru = 'Не удалось определить настройки динамического списка';
		|en = 'Failed to determine dynamic list settings'");
	КонецЕсли;
	
	ПараметрыВыполнения[ПолеРезультат][ПолеТекст] = ТекстРезультат;
	
КонецПроцедуры

#КонецОбласти
