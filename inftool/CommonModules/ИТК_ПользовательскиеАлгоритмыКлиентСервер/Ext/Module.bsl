#Область ПрограммныйИнтерфейс

Функция ОписаниеАлгоритма() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Используется", Истина);
	Результат.Вставить("Представление", "");
	Результат.Вставить("ТипОбъектов", Неопределено);
	Результат.Вставить("ТипЗначенияОбъектов", Неопределено);
	Результат.Вставить("ОбработкаСписка", Ложь);
	Результат.Вставить("КодНаКлиенте", "");
	Результат.Вставить("КодНаСервере", "");
	Результат.Вставить("Комментарий", "");
	
	Возврат Результат;
	
КонецФункции

