#Область ПрограммныйИнтерфейс

Процедура ДанныеОтчета(Параметры, АдресРезультата) Экспорт
	
	ИТК_ДлительныеОперации.СообщитьПрогресс(
		НСтр("ru = 'Подготовка вспомогательных данных';
			|en = 'Preparation of supporting data'"));
	
	// Подготовка настроек отчета
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("ОтборМетаданных", Параметры.ОтборМетаданных);
	НастройкиОтчета.Вставить("ГруппироватьМетаданныеПоКоллекциям", Параметры.ГруппироватьМетаданныеПоКоллекциям);
	НастройкиОтчета.Вставить("СортироватьПо", Параметры.СортироватьПо);
	
	НастройкиОтчета.Вставить("РассчитыватьКоличествоЗаписей", Параметры.РассчитыватьКоличествоЗаписей);
	ОтборКоличествоЗаписейНеМенее = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "ОтборКоличествоЗаписейНеМенее", 0);
	НастройкиОтчета.Вставить("ОтборКоличествоЗаписейНеМенее", ОтборКоличествоЗаписейНеМенее);

	НастройкиОтчета.Вставить("РассчитыватьРазмерДанных", Параметры.РассчитыватьРазмерДанных);
	ОтборРазмерБайтНеМенее = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "ОтборРазмерБайтНеМенее", 0);
	НастройкиОтчета.Вставить("ОтборРазмерБайтНеМенее", ОтборРазмерБайтНеМенее);
	
	ПоляРесурсов = Новый Массив;
	Если НастройкиОтчета.РассчитыватьКоличествоЗаписей Тогда
		ПоляРесурсов.Добавить("Количество");
	КонецЕсли;
	Если НастройкиОтчета.РассчитыватьРазмерДанных Тогда
		ПоляРесурсов.Добавить("РазмерБайт");
	КонецЕсли;
	НастройкиОтчета.Вставить("ПоляРесурсов", ПоляРесурсов);
	
	// Подготовка табличного документ
	ТабличныйДокументРезультат = Новый ТабличныйДокумент;
	
	ТабличныйДокументОтборы = ПодготовитьТабличныйДокументОтборов(НастройкиОтчета);
	ТабличныйДокументРезультат.Вывести(ТабличныйДокументОтборы);
	
	ТаблицаДанных = СозданиеТаблицыДанных(НастройкиОтчета);
	ЗаполнитьТаблицуДанных(ТаблицаДанных, НастройкиОтчета);
	
	ИТК_ДлительныеОперации.СообщитьПрогресс(
		НСтр("ru = 'Вывод данных';
			|en = 'Data output'"));
	
	РезультатВыполнения = ИТК_ЗащитаЛицензирование.РазмерИКоличествоДанных_ВыполнитьОтчетНаСКД(ТаблицаДанных, НастройкиОтчета);
	
	ТабличныйДокументОтчет = РезультатВыполнения.ДокументРезультат;
	ИТК_ТабличныйДокумент.ОформитьЧередованиеСтрок(ТабличныйДокументОтчет);
	ТабличныйДокументРезультат.Вывести(ТабличныйДокументОтчет);
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументРезультат", ТабличныйДокументРезультат);
	Результат.Вставить("ДанныеРасшифровки", РезультатВыполнения.ДанныеРасшифровки);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьТабличныйДокументОтборов(НастройкиОтчета)
	
	// Подготовка используемых отборов
	Отборы = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(НастройкиОтчета.ОтборМетаданных) Тогда
		Отборы.Добавить(НастройкиОтчета.ОтборМетаданных, НСтр("ru = 'Метаданные'; en = 'Metadata'"));
	КонецЕсли;
	
	// Подготовка табличного документа
	Результат = Новый ТабличныйДокумент;
	Если НЕ ЗначениеЗаполнено(Отборы) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Макет = Отчеты.ИТК_РазмерИКоличествоДанных.ПолучитьМакет("Макет");
	
	Результат.НачатьАвтогруппировкуСтрок();
	
	ОбластьЗаголовокОтборов = Макет.ПолучитьОбласть("ЗаголовокОтборов");
	ОбластьЗаголовокОтборов.Параметры.Количество = Отборы.Количество();
	Результат.Вывести(ОбластьЗаголовокОтборов, 1, , Ложь);
	
	Для Каждого ЭлементОтбора Из Отборы Цикл 
		
		ОбластьСтрокаОтбор = Макет.ПолучитьОбласть("СтрокаОтбор");
		ОбластьСтрокаОтбор.Параметры.Поле = ЭлементОтбора.Представление;
		
		ЗначениеОтбора = ЭлементОтбора.Значение;
		ЗначениеОтбораМаксимумСимволов = 200;
		Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
			ПредставлениеЗначенияОтбора = ИТК_ФормаКлиентСервер.ПредставлениеСписка(ЗначениеОтбора, ЗначениеОтбораМаксимумСимволов);
		Иначе
			ПредставлениеЗначенияОтбора = ИТК_Строки.Сократить(ЗначениеОтбора, ЗначениеОтбораМаксимумСимволов)
		КонецЕсли;
		ОбластьСтрокаОтбор.Параметры.ПредставлениеЗначения = ПредставлениеЗначенияОтбора;
		
		Результат.Вывести(ОбластьСтрокаОтбор, 2);
		
	КонецЦикла;
	
	Результат.ЗакончитьАвтогруппировкуСтрок();
	
	Возврат Результат;
	
КонецФункции

Функция СозданиеТаблицыДанных(НастройкиОтчета)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Метаданные", ИТК_ТипыКлиентСервер.ОписаниеКоллекцияИИмяМетаданных());
	
	Если НастройкиОтчета.ГруппироватьМетаданныеПоКоллекциям Тогда
		
		Результат.Колонки.Добавить("Коллекция", ИТК_ТипыКлиентСервер.ОписаниеИмяМетаданных());
		Результат.Колонки.Добавить("КоллекцияПорядок", ИТК_ТипыКлиентСервер.ОписаниеЧисло(10));
		
	КонецЕсли;
	
	Если НастройкиОтчета.РассчитыватьКоличествоЗаписей Тогда
		Результат.Колонки.Добавить("Количество", ИТК_ТипыКлиентСервер.ОписаниеЧисло());
	КонецЕсли;
	
	Если НастройкиОтчета.РассчитыватьРазмерДанных Тогда
		Результат.Колонки.Добавить("РазмерБайт", ИТК_ТипыКлиентСервер.ОписаниеЧисло(), НСтр("ru = 'Размер, байт'; en = 'Size, bytes'"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицуДанных(ТаблицаДанных, НастройкиОтчета)
	
	// Расчет общего количества объектов
	ОбрабатываемыхОбъектов = 0;
	Если ЗначениеЗаполнено(НастройкиОтчета.ОтборМетаданных) Тогда
		
		ЭлементыОтбора = СтрРазделить(НастройкиОтчета.ОтборМетаданных, ",");
		Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл 
			
			ЭлементыОтбора = СтрРазделить(СокрЛП(ЭлементОтбора), ".");
			Если ЭлементыОтбора.Количество() = 1 Тогда
				
				ИмяКоллекции = ЭлементыОтбора[0];
				ОбрабатываемыхОбъектов = ОбрабатываемыхОбъектов + Метаданные[ИмяКоллекции].Количество();
				
			Иначе
				ОбрабатываемыхОбъектов = ОбрабатываемыхОбъектов + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ДоступныеКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеКоллекцииКоличествоИРазмерДанных();
		Для Каждого ИмяКоллекции Из ДоступныеКоллекции Цикл 
			ОбрабатываемыхОбъектов = ОбрабатываемыхОбъектов + Метаданные[ИмяКоллекции].Количество();
		КонецЦикла;
		
	КонецЕсли;
	НастройкиОтчета.Вставить("НомерОбъекта", 0);
	НастройкиОтчета.Вставить("ОбрабатываемыхОбъектов", ОбрабатываемыхОбъектов);
	
	Если ЗначениеЗаполнено(НастройкиОтчета.ОтборМетаданных) Тогда
		
		ЭлементыОтбора = СтрРазделить(НастройкиОтчета.ОтборМетаданных, ",");
		Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл 
			
			ЭлементыОтбора = СтрРазделить(СокрЛП(ЭлементОтбора), ".");
			Если ЭлементыОтбора.Количество() = 1 Тогда
				
				ИмяКоллекции = ЭлементыОтбора[0];
				ОбъектыМетаданныхДобавитьКоллекцию(ТаблицаДанных, НастройкиОтчета, ИмяКоллекции);
				
			Иначе
				
				ИмяОбъектаКоллекции = ЭлементыОтбора[0];
				ИмяОбъекта = ЭлементыОтбора[1];
				
				ИмяКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ИмяКоллекции(ИмяОбъектаКоллекции);
				ОбъектМетаданных = Метаданные[ИмяКоллекции][ИмяОбъекта];
				ОбъектыМетаданныхДобавитьОбъект(ТаблицаДанных, НастройкиОтчета, ИмяКоллекции, ОбъектМетаданных);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ДоступныеКоллекции = ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеКоллекцииКоличествоИРазмерДанных();
		Для Каждого ИмяКоллекции Из ДоступныеКоллекции Цикл 
			ОбъектыМетаданныхДобавитьКоллекцию(ТаблицаДанных, НастройкиОтчета, ИмяКоллекции);
		КонецЦикла;
		
	КонецЕсли;
	
	Если НастройкиОтчета.ГруппироватьМетаданныеПоКоллекциям Тогда
		
		Для Каждого Строка Из ТаблицаДанных Цикл
			Строка.КоллекцияПорядок = ИТК_МетаданныеКлиентСерверПовтИсп.ПорядокКоллекции(Строка.Коллекция);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбъектыМетаданныхДобавитьКоллекцию(Результат, НастройкиОтчета, ИмяКоллекции)
	
	Для Каждого ОбъектМетаданных Из Метаданные[ИмяКоллекции] Цикл 
		ОбъектыМетаданныхДобавитьОбъект(Результат, НастройкиОтчета, ИмяКоллекции, ОбъектМетаданных)
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбъектыМетаданныхДобавитьОбъект(Результат, НастройкиОтчета, ИмяКоллекции, ОбъектМетаданных)
	
	НастройкиОтчета.НомерОбъекта = НастройкиОтчета.НомерОбъекта + 1;
	
	// Сообщения прогресса
	Если НастройкиОтчета.НомерОбъекта % 50 = 0 Тогда
		
		ШаблонТекстаЭтапа = НСтр("ru = 'Расчет данных объектов (%1 / %2)'; en = 'Calculating these objects (%1 / %2)'");
		ТекстЭтапа = СтрШаблон(ШаблонТекстаЭтапа, НастройкиОтчета.НомерОбъекта, НастройкиОтчета.ОбрабатываемыхОбъектов);
		ПрогрессВыполнения = Цел((НастройкиОтчета.НомерОбъекта * 100) / НастройкиОтчета.ОбрабатываемыхОбъектов);
		ИТК_ДлительныеОперации.СообщитьПрогресс(ТекстЭтапа, ПрогрессВыполнения);
		
	КонецЕсли;
	
	ДоступноЧтение = ПравоДоступа("Чтение", ОбъектМетаданных);
	Если НЕ ДоступноЧтение Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоЗаписей = Неопределено;
	Если НастройкиОтчета.РассчитыватьКоличествоЗаписей
			ИЛИ ЗначениеЗаполнено(НастройкиОтчета.ОтборКоличествоЗаписейНеМенее) Тогда
			
		КоличествоЗаписей = КоличествоЗаписей(ОбъектМетаданных);
		Если КоличествоЗаписей < НастройкиОтчета.ОтборКоличествоЗаписейНеМенее Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	РазмерБайт = Неопределено;
	Если НастройкиОтчета.РассчитыватьРазмерДанных Тогда
		
		РазмерБайт = РазмерДанныхВБайтах(ОбъектМетаданных);
		Если РазмерБайт < НастройкиОтчета.ОтборРазмерБайтНеМенее Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяСтрока = Результат.Добавить();
	Если НастройкиОтчета.ГруппироватьМетаданныеПоКоллекциям Тогда
		НоваяСтрока.Коллекция = ИмяКоллекции;
	КонецЕсли;
	НоваяСтрока.Метаданные = ОбъектМетаданных.ПолноеИмя();
	
	Если ЗначениеЗаполнено(КоличествоЗаписей) Тогда
		НоваяСтрока.Количество = КоличествоЗаписей;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РазмерБайт) Тогда
		НоваяСтрока.РазмерБайт = РазмерБайт;
	КонецЕсли;
	
КонецПроцедуры

Функция КоличествоЗаписей(ОбъектМетаданных)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + ОбъектМетаданных.ПолноеИмя();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка["Количество"];
	
КонецФункции

Функция РазмерДанныхВБайтах(ОбъектМетаданных)
	
	Объекты = Новый Массив;
	Объекты.Добавить(ОбъектМетаданных);
	Возврат ПолучитьРазмерДанныхБазыДанных( , Объекты);
	
КонецФункции

#КонецОбласти
