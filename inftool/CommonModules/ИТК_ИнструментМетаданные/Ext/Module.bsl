#Область ПрограммныйИнтерфейс

Функция ЗначенияСвойств(Параметры, АдресРезультата = Неопределено) Экспорт
	
	БазовыеСвойства = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "БазовыеСвойства", Истина);
	Результат = ИТК_ЗащитаЛицензирование.ИнструментМетаданные_ЗначенияСвойств(Параметры.ПолноеИмя,
		Параметры.ТолькоВажные, Параметры.СортироватьПоАлфавиту, БазовыеСвойства);
		
	Возврат ИТК_ДлительныеОперации.Результат(Результат, АдресРезультата);
	
КонецФункции

Функция ПоискПоПодобию(Параметры, АдресРезультата = Неопределено) Экспорт
	
	СтрокаПоиска = Параметры.СтрокаПоиска;
	ПараметрыПоиска = ИТК_Строки.ПараметрыПоискаПоПодобию(СтрокаПоиска);
	
	Результат = Новый Массив;
	
	ОписаниеКоллекций = ПоискПоПодобию_ВыбранныеКоллекцииМетаданных(ПараметрыПоиска, Параметры.Расширение, Параметры.ВключатьОбъектыРасширений);
	
	// Расчет количества обрабатываемых
	КоличествоОбрабатываемых = 0;
	Для Каждого ОписаниеКоллекции Из ОписаниеКоллекций Цикл 
		КоличествоОбрабатываемых = КоличествоОбрабатываемых + ОписаниеКоллекции["Объекты"].Количество();
	КонецЦикла;
	
	// Поиск
	КоличествоНайденных = 0; Обрабатывается = 0;
	Для Каждого ОписаниеКоллекции Из ОписаниеКоллекций Цикл 
		
		Для Каждого ОбъектМетаданных Из ОписаниеКоллекции["Объекты"] Цикл 
			
			Обрабатывается = Обрабатывается + 1;
			
			// Сообщение прогресса
			Если Обрабатывается % 1000 = 0 Тогда
				
				Прогресс = Цел((Обрабатывается * 100) / КоличествоОбрабатываемых);
				ИТК_ДлительныеОперации.СообщитьПрогресс(Неопределено, Прогресс, Результат);
				
			КонецЕсли;
			
			АнализируемаяСтрока = НРег(ОбъектМетаданных.Имя + " " + ОбъектМетаданных.Синоним);
			Если НЕ ИТК_Строки.ПоискПоПодобиюНайденыСовпадения(АнализируемаяСтрока, ПараметрыПоиска) Тогда
				Продолжить;
			КонецЕсли;
			
			// Обработка найденных
			КоличествоНайденных = КоличествоНайденных + 1;
			Если КоличествоНайденных > 50 Тогда
				Возврат ИТК_ДлительныеОперации.Результат(Результат, АдресРезультата);
			КонецЕсли;
			
			ОписаниеНайденногоОбъекта = Новый Структура;
			ОписаниеНайденногоОбъекта.Вставить("Имя", ОбъектМетаданных.Имя);
			ОписаниеНайденногоОбъекта.Вставить("Синоним", ОбъектМетаданных.Синоним);
			ОписаниеНайденногоОбъекта.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
			ОписаниеНайденногоОбъекта.Вставить("Картинка", ОписаниеКоллекции.Картинка);
			
			Результат.Добавить(ОписаниеНайденногоОбъекта);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ИТК_ДлительныеОперации.Результат(Результат, АдресРезультата);
	
КонецФункции

Процедура ОбновитьГруппуПерейти(Форма, ЭлементРодитель, ПолноеИмя) Экспорт
	
	Префикс = ИТК_ИнструментМетаданныеКлиентСервер.ПрефиксКомандИЭлементовГруппыПерейти();
	Действие = "Подключаемый_МетаданныеПерейти";
	
	ДоступныеИнструменты = ИТК_ИнструментМетаданные.ДоступныеИнструментПоПолномуИмени(ПолноеИмя);

	// Удалить ранее созданные команды и элементы
	ИТК_Форма.УдалитьКоманды(Форма, Префикс);
	
	ИТК_Форма.УдалитьПодчиненныеЭлементы(Форма, ЭлементРодитель);

	// Добавить команд
	Для Каждого ВидИнструмента Из ДоступныеИнструменты Цикл 
		
		ОписаниеИнструмента = ИТК_ТуллкитКлиентСервер.ОписаниеИнструмента(ВидИнструмента);
		ИдентификаторИнструмента = СтрЗаменить(ВидИнструмента, ".", "_");
		
		ИТК_Форма.ДобавитьКоманду(Форма, Префикс + ИдентификаторИнструмента, Действие, ОписаниеИнструмента.Представление);
		
	КонецЦикла;
	
	// Добавить элементы
	Для Каждого ВидИнструмента Из ДоступныеИнструменты Цикл 
		
		ОписаниеИнструмента = ИТК_ТуллкитКлиентСервер.ОписаниеИнструмента(ВидИнструмента);
		ИдентификаторИнструмента = СтрЗаменить(ВидИнструмента, ".", "_");
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Картинка", ОписаниеИнструмента.Картинка);
		
		Поля = Новый Структура;
		Поля.Вставить("ИмяКоманды", Префикс + ИдентификаторИнструмента);
		Поля.Вставить("Картинка", ОписаниеИнструмента.Картинка);
		
		ИТК_Форма.ДобавитьЭлемент(Форма, Префикс + ИдентификаторИнструмента, "Кнопка", Поля, ЭлементРодитель);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДоступныеИнструментПоПолномуИмени(ПолноеИмя) Экспорт
	
	ЧастиПолногоИмени = СтрРазделить(ПолноеИмя, ".");
	ИмяОбъектаКоллекции = ЧастиПолногоИмени[0];
	ИмяКоллекции = ИТК_Метаданные.ИмяКоллекции(ИмяОбъектаКоллекции, ИТК_ОбщийКлиентСервер.КодЯзыкаРусский());
	
	Результат = Новый Массив;
	Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоКонстанта(ИмяОбъектаКоллекции) Тогда
		Результат.Добавить(ИТК_Перечисления.ИнструментРедакторКонстант());
	КонецЕсли;
	
	Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПараметрСеанса(ИмяОбъектаКоллекции) Тогда
		Результат.Добавить(ИТК_Перечисления.ИнструментРедакторПараметровСеанса());
	КонецЕсли;
	
	Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоРегламентноеЗадание(ИмяОбъектаКоллекции) Тогда
		Результат.Добавить(ИТК_Перечисления.ИнструментРегламентныеИФоновыеЗадания());
	КонецЕсли;
	
	ДоступныеКоллекцииАнализПравДоступа = ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеКоллекцииАнализПравДоступа();
	Если ДоступныеКоллекцииАнализПравДоступа.Найти(ИмяКоллекции) <> Неопределено Тогда 
		Результат.Добавить(ИТК_Перечисления.ИнструментАнализПравДоступа());
	КонецЕсли;
	
	Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоСправочник(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоДокумент(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоЖурналДокументов(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПланСчетов(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПланВидовРасчета(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПланВидовХарактеристик(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоРегистр(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоБизнесПроцесс(ИмяКоллекции)
			ИЛИ ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоЗадача(ИмяКоллекции) Тогда
		Результат.Добавить(ИТК_Перечисления.ИнструментРазмерИКоличествоДанных());
	КонецЕсли;

	ДоступныеОбъектыСписка = ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеОбъектыОсновнойТаблицыДинамическогоСписка();
	Если ДоступныеОбъектыСписка.Найти(ИмяОбъектаКоллекции) <> Неопределено Тогда 
		
		Результат.Добавить(ИТК_Перечисления.ИнструментФормаСписка());
		Результат.Добавить(ИТК_Перечисления.ИнструментФормаСпискаУниверсальная());
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоискПоПодобию_ВыбранныеКоллекцииМетаданных(ПараметрыПоиска, Расширение, ВключатьОбъектыРасширений)
	
	// Доступные коллекции
	ДоступныеКоллекции = Новый Массив;
	Для Каждого ИмяКоллекции Из ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеКоллекцииМетаданных() Цикл 
		
		Если ИТК_МетаданныеКлиентСерверПовтИсп.ЭтоПланОбмена(ИмяКоллекции) Тогда
			Продолжить;
		КонецЕсли;
		
		ДоступныеКоллекции.Добавить(ИмяКоллекции);
		
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из ИТК_МетаданныеКлиентСерверПовтИсп.ДоступныеКоллекцииМетаданныхГруппыОбщие() Цикл 
		
		ИмяКоллекции = ЭлементСписка.Представление;
		ДоступныеКоллекции.Добавить(ИмяКоллекции);
		
	КонецЦикла;
	
	// Поиск по коллекциям
	ВыбранныеКоллекции = Новый Массив;
	Если ЗначениеЗаполнено(ПараметрыПоиска.Коллекция) Тогда
		
		Для Каждого ИмяКоллекции Из ДоступныеКоллекции Цикл  
			
			Если СтрНайти(НРег(ИмяКоллекции), ПараметрыПоиска.Коллекция) Тогда
				ВыбранныеКоллекции.Добавить(ИмяКоллекции);
			КонецЕсли;
		
		КонецЦикла;
		
	Иначе
		ВыбранныеКоллекции = ДоступныеКоллекции;
	КонецЕсли;
	
	// Подготовка результата объектов коллекций
	Результат = Новый Массив;
	Для Каждого ИмяКоллекции Из ВыбранныеКоллекции Цикл 
		
		ОписаниеКоллекции = Новый Структура;
		ОписаниеКоллекции.Вставить("Имя", ИмяКоллекции);
		ОписаниеКоллекции.Вставить("Картинка", ИТК_МетаданныеКлиентСерверПовтИсп.КартинкаКоллекции(ИмяКоллекции));
		ОписаниеКоллекции.Вставить("Объекты", ИТК_Метаданные.ОбъектыКоллекцииБезИерархии(ИмяКоллекции, Расширение, ВключатьОбъектыРасширений));
		
		Результат.Добавить(ОписаниеКоллекции);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
