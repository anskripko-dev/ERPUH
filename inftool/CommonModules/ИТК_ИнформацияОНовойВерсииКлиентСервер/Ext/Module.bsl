#Область ПрограммныйИнтерфейс

Функция НомерПоследнейВерсии() Экспорт
	
	ПараметрыПодключения = ПараметрыПодключенияGithub();
	
	Запрос = СоздатьHTTPЗапрос(ПараметрыПодключения, "releases", , ЗаголовкиПодключенияGithub());
	Соединение = СоздатьHTTPСоединение(ПараметрыПодключения, 2);
	
	Попытка
		ОтветHTTP = Соединение.ВызватьHTTPМетод("GET", Запрос);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	ДанныеВерсий = ИТК_ОбщийКлиентСервер.JSONСтрокуВКоллекцию(СтрокаОтвета, Истина);
	Для Каждого ДанныеВерсии Из ДанныеВерсий Цикл 
		
		Если НЕ ДанныеВерсии["prerelease"] Тогда
			Возврат ДанныеВерсии["tag_name"];
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИзмененияВНовойВерсии() Экспорт
	
	ПараметрыПодключения = ПараметрыПодключенияGithub();
	
	Запрос = СоздатьHTTPЗапрос(ПараметрыПодключения, "releases", , ЗаголовкиПодключенияGithub());
	Соединение = СоздатьHTTPСоединение(ПараметрыПодключения, 1);
	
	Попытка
		ОтветHTTP = Соединение.ВызватьHTTPМетод("GET", Запрос);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущаяВерсия = ИТК_ТуллкитКлиентСервер.Версия();
	
	MarkDownТекстВсеИзменения = "";
	MarkDownТекстНовыеИзменения = "";
	
	СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	ДанныеВерсий = ИТК_ОбщийКлиентСервер.JSONСтрокуВКоллекцию(СтрокаОтвета, Истина);
	Для Каждого ДанныеВерсии Из ДанныеВерсий Цикл 
		
		ИмяВерсии = ДанныеВерсии["name"];
		Если ДанныеВерсии["prerelease"] Тогда
			ИмяВерсии = ИмяВерсии + НСтр("ru = ' (тестовая)'; en = ' (beta)'");
		КонецЕсли;
		
		ВерсияИзменений = ДанныеВерсии["tag_name"];
		
		ТекстТело = СтрЗаменить(ДанныеВерсии["body"], Символы.ПС + "# ", Символы.ПС +"## ");
		ТекстТело = "# " + ИмяВерсии + Символы.ПС + ТекстТело + Символы.ПС;
		
		MarkDownТекстВсеИзменения = MarkDownТекстВсеИзменения + ТекстТело;
		
		РезультатСравнения = ИТК_ОбщийКлиентСервер.СравнитьВерсии(ТекущаяВерсия, ВерсияИзменений);
		Если РезультатСравнения = -1 Тогда
			MarkDownТекстНовыеИзменения = MarkDownТекстНовыеИзменения + ТекстТело;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ВсеИзменения", MarkDownВHTML(MarkDownТекстВсеИзменения));
	Результат.Вставить("НовыеИзменения", MarkDownВHTML(MarkDownТекстНовыеИзменения));
	Возврат Результат;
	
КонецФункции

Функция MarkDownВHTML(Текст) Экспорт
	
	СтрокиРезультата = Новый Массив;
	
	КоличествоСтрок = СтрЧислоСтрок(Текст);
	НомерСтроки = 1;
	Пока НомерСтроки <= КоличествоСтрок Цикл
		
		Строка = СтрПолучитьСтроку(Текст, НомерСтроки);
		Если СтрНачинаетсяС(Строка, "###") Тогда
			СтрокиРезультата.Добавить("<h3>" + Сред(Строка, 5) + "</h3>");
		ИначеЕсли СтрНачинаетсяС(Строка, "##") Тогда
			СтрокиРезультата.Добавить("<h2>" + Сред(Строка, 4) + "</h2>");
		ИначеЕсли СтрНачинаетсяС(Строка, "#") Тогда
			СтрокиРезультата.Добавить("<h1>" + Сред(Строка, 3) + "</h1>");
		ИначеЕсли СтрНачинаетсяС(Строка, "* ") Тогда
			СтрокиРезультата.Добавить("<li>" + Сред(Строка, 3) + "</li>");
		ИначеЕсли СтрНачинаетсяС(Строка, "[") Тогда
			
			КонецПредставленияСсылки = СтрНайти(Строка, "]");
			ПредставлениеСсылки = Сред(Строка, 2, КонецПредставленияСсылки - 2);
			
			АдресСсылки = Сред(Строка, КонецПредставленияСсылки + 2);
			АдресСсылки = Лев(АдресСсылки, СтрДлина(АдресСсылки) - 1);
			
			СтрокаСсылка = СтрШаблон("<a href=""%1"">%2</a><br>", АдресСсылки, ПредставлениеСсылки);
			СтрокиРезультата.Добавить("<p>" + СтрокаСсылка + "</p>");
			
		Иначе
			
			Если ЗначениеЗаполнено(Строка) Тогда
				СтрокиРезультата.Добавить(Строка);
			КонецЕсли;
			
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Возврат "<html><head>"
		+ СтрСоединить(СтрокиРезультата)
		+ "</head></html>";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыПодключенияGithub()
	
	Результат = Новый Структура;
	Результат.Вставить("АдресСервера", "https://api.github.com/repos/infostart-hub/toolkit");
	Результат.Вставить("Пользователь", "");
	Результат.Вставить("Пароль", "");
	
	ОписаниеАдреса = Новый Структура;
	ОписаниеАдреса.Вставить("Схема", "https");
	ОписаниеАдреса.Вставить("Логин", "");
	ОписаниеАдреса.Вставить("Пароль", "");
	ОписаниеАдреса.Вставить("ИмяСервера", "api.github.com");
	ОписаниеАдреса.Вставить("Хост" , "api.github.com");
	ОписаниеАдреса.Вставить("Порт" , Неопределено);
	ОписаниеАдреса.Вставить("ПутьНаСервере", "repos/infostart-hub/toolkit");
	Результат.Вставить("Адрес", ОписаниеАдреса);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаголовкиПодключенияGithub()
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/vnd.github+json");
	Возврат Заголовки;
	
КонецФункции

Функция СоздатьHTTPЗапрос(знач Подключение, знач АдресРесурса, знач Параметры = Неопределено, знач Заголовки = Неопределено)
	
	ПутьНаСервере = Подключение.Адрес.ПутьНаСервере;
	
	ЕстьРазделительПути 	= СтрЗаканчиваетсяНа(ПутьНаСервере, "/");
	ЕстьРазделительАдреса	= СтрНачинаетсяС(АдресРесурса, "/");
	
	Если ЕстьРазделительПути И ЕстьРазделительАдреса Тогда
		АдресРесурса = ПутьНаСервере + Сред(АдресРесурса, 2);
	ИначеЕсли НЕ ЕстьРазделительПути И НЕ ЕстьРазделительАдреса Тогда
		АдресРесурса = ПутьНаСервере + "/" + АдресРесурса;
	Иначе
		АдресРесурса = ПутьНаСервере + АдресРесурса;
	КонецЕсли;
	
	ПараметрыКоллекция = (ТипЗнч(Параметры) = Тип("Соответствие")
		ИЛИ ТипЗнч(Параметры) = Тип("Структура"));
	
	Если НЕ ПараметрыКоллекция = Истина Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;
	Если НЕ ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
		Заголовки = Новый Соответствие;
	КонецЕсли;
	
	СтрПараметры = "";
	Для Каждого КлючИЗначение Из Параметры Цикл 
		Если НЕ ЗначениеЗаполнено(КлючИЗначение.Ключ) ИЛИ НЕ ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрПараметры = СтрПараметры
			+ ?(ПустаяСтрока(СтрПараметры), "", "&")
			+ СтрШаблон("%1=%2", КлючИЗначение.Ключ, КлючИЗначение.Значение);		
	КонецЦикла;
	
	Если НЕ СтрНачинаетсяС(АдресРесурса, "/") Тогда
		АдресРесурса = "/" + АдресРесурса;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрПараметры) Тогда
		ШаблонАдреса = "%1?%2";
	Иначе 
		ШаблонАдреса = "%1%2";
	КонецЕсли;
	
	ПолныйАдрес = СтрШаблон(ШаблонАдреса, АдресРесурса, СтрПараметры);
	
	Возврат Новый HTTPЗапрос(ПолныйАдрес, Заголовки);
	
КонецФункции

Функция СоздатьHTTPСоединение(знач Подключение, знач Таймаут = Неопределено)
	
	ИмяСервера	= Подключение.Адрес.ИмяСервера;
	
	Если Подключение.Адрес.Схема = "https" Тогда
		БезопасноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Иначе 
		БезопасноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		
		СоединениеHTTP = Новый HTTPСоединение(ИмяСервера, ,
			Подключение.Пользователь,
			Подключение.Пароль, ,
			Таймаут,
			БезопасноеСоединение);
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат СоединениеHTTP;
	
КонецФункции

#КонецОбласти