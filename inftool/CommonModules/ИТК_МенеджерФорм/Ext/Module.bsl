#Область ПрограммныйИнтерфейс

Функция ЗначенияСвойств(ЗначенияСвойствФормы, СортироватьПоАлфавиту) Экспорт
	
	Результат = Новый ДеревоЗначений;
	Результат.Колонки.Добавить("Имя", ИТК_ТипыКлиентСервер.ОписаниеСтрока());
	Результат.Колонки.Добавить("Представление", ИТК_ТипыКлиентСервер.ОписаниеСтрока());
	Результат.Колонки.Добавить("Значение");
	Результат.Колонки.Добавить("ЗначениеГиперссылка");
	Результат.Колонки.Добавить("Порядок", ИТК_ТипыКлиентСервер.ОписаниеЧисло(10));
	Результат.Колонки.Добавить("ТолькоПросмотр", ИТК_ТипыКлиентСервер.ОписаниеБулево());
	Результат.Колонки.Добавить("ЭтоГруппа", ИТК_ТипыКлиентСервер.ОписаниеБулево());
	
	СтрокиГруппСвойст = Новый Соответствие;
	СвойстваФормы = ИТК_СвойстваФормыКлиентСервер.СоответствиеОписаниеСвойств();
	Для Каждого Свойство Из СвойстваФормы Цикл
		
		ОписаниеСвойства = Свойство.Значение;
		
		Если СортироватьПоАлфавиту Тогда
			СтрокаРодитель = Результат;
		Иначе
			
			СтрокаРодитель = СтрокиГруппСвойст.Получить(ОписаниеСвойства.Группа);
			Если СтрокаРодитель = Неопределено Тогда
				
				СтрокаРодитель = Результат.Строки.Добавить();
				СтрокаРодитель.Имя = Свойство.Ключ;
				СтрокаРодитель.Представление = ОписаниеСвойства.Группа;
				СтрокаРодитель.Порядок = ОписаниеСвойства.ГруппаПорядок;
				СтрокаРодитель.ЭтоГруппа = Истина;
				СтрокаРодитель.ТолькоПросмотр = Истина;
				
				СтрокиГруппСвойст.Вставить(ОписаниеСвойства.Группа, СтрокаРодитель);
				
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = СтрокаРодитель.Строки.Добавить();
		НоваяСтрока.Имя = Свойство.Ключ;
		НоваяСтрока.Представление = ОписаниеСвойства.Представление;
		НоваяСтрока.Порядок = ОписаниеСвойства.Порядок;
		НоваяСтрока.ТолькоПросмотр = ОписаниеСвойства.ТолькоПросмотр;
		
		ПредставлениеЗначение = ЗначенияСвойствФормы.Получить(Свойство.Ключ);
		Если ОписаниеСвойства.Гиперссылка Тогда
			
			Если ПредставлениеЗначение = Неопределено Тогда
				НоваяСтрока.Значение = ИТК_Строки.ТекстНедоступно();
			Иначе 
				НоваяСтрока.ЗначениеГиперссылка = ПредставлениеЗначение;
			КонецЕсли;
			
		Иначе
			НоваяСтрока.Значение = ПредставлениеЗначение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СортироватьПоАлфавиту Тогда
		Результат.Строки.Сортировать("Имя");
	Иначе
		Результат.Строки.Сортировать("Порядок", Истина);
	КонецЕсли;
	Результат.Колонки.Удалить("Порядок");
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеУсловногоОформления(Форма, ДополнительныеПараметры) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	
	Результат = Новый Структура;
	
	ШаблонПредставления = НСтр("ru = 'Условное оформление (%1)'; en = 'Conditional formatting (%1)'");
	Результат.Вставить("Представление", СтрШаблон(ШаблонПредставления, УсловноеОформление.Количество()));
	
	Результат.Вставить("Заполнено", ЗначениеЗаполнено(УсловноеОформление));
	
	Возврат Результат;
	
КонецФункции

Функция УсловноеОформлениеПодробно(Форма, ДополнительныеПараметры) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Для Каждого ЭлементУсловногоОформления Из Форма.УсловноеОформление.Элементы Цикл 
		
		ОписаниеЗначения = Новый Структура;
		ОписаниеЗначения.Вставить("Отбор", Строка(ЭлементУсловногоОформления.Отбор));
		
		Поля = Новый Массив;
		Для Каждого Поле Из ЭлементУсловногоОформления.Поля.Элементы Цикл
			Если Поле.Использование Тогда
				Поля.Добавить(Строка(Поле.Поле));
			КонецЕсли;
		КонецЦикла;
		ОписаниеЗначения.Вставить("Поля", СтрСоединить(Поля, ", "));
		
		Оформление = Новый СписокЗначений;
		Для Каждого ЭлементОформления Из ЭлементУсловногоОформления.Оформление.Элементы Цикл
			
			Если ЭлементОформления.Использование Тогда
				Оформление.Добавить(ЭлементОформления.Значение, ЭлементОформления.Параметр);
			КонецЕсли;
			
		КонецЦикла;
		ОписаниеЗначения.Вставить("Оформление", Оформление);
		
		ОписаниеЗначения.Вставить("РежимОтображения", ЭлементУсловногоОформления.РежимОтображения);
		Результат.Добавить(ОписаниеЗначения, ЭлементУсловногоОформления.Представление, ЭлементУсловногоОформления.Использование);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПутиКДаннымЭлементов(Форма, ДополнительныеПараметры) Экспорт
	
	Результат = Новый Соответствие;
	ПутиКДаннымЭлементовРекурсивно(Форма, Результат);
	Возврат Результат;
	
КонецФункции

Функция ДанныеОтладкиДинамическихСписков(Форма, ДополнительныеПараметры) Экспорт
	
	Результат = Новый Массив;
	ДанныеОтладкиДинамическихСписковРекурсивно(Форма, Форма, Результат);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПутиКДаннымЭлементовРекурсивно(Элемент, Результат)
	
	Если ТипЗнч(Элемент) = Тип("ПолеФормы")
			ИЛИ ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		Результат.Вставить(Элемент.Имя, Элемент.ПутьКДанным);
	КонецЕсли;
	
	Если НЕ ИТК_МенеджерФормКлиентСервер.ДоступныПодчиненныеЭлементы(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл 
		ПутиКДаннымЭлементовРекурсивно(ПодчиненныйЭлемент, Результат);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДанныеОтладкиДинамическихСписковРекурсивно(Форма, Элемент, Результат)
	
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		
		РеквизитСписок = Форма[Элемент.ПутьКДанным];
		Если ТипЗнч(РеквизитСписок) = Тип("ДинамическийСписок") Тогда
			
			ОписаниеДинамическогоСписка = Новый Структура;
			
			ЭтоТекущийЭлемент = Форма.ТекущийЭлемент = Элемент;
			ОписаниеДинамическогоСписка.Вставить("ЭтоТекущийЭлемент", ЭтоТекущийЭлемент);
			
			ОписаниеДинамическогоСписка.Вставить("Имя", Элемент.Имя);
			ОписаниеДинамическогоСписка.Вставить("ОсновнаяТаблица", РеквизитСписок.ОсновнаяТаблица);
			
			Представление = Элемент.Имя;
			Если ЗначениеЗаполнено(РеквизитСписок.ОсновнаяТаблица) Тогда
				Представление = СтрШаблон("%1 (%2)", Представление, РеквизитСписок.ОсновнаяТаблица);
			КонецЕсли;
			ОписаниеДинамическогоСписка.Вставить("Представление", Представление);
			
			СхемаКомпоновкиДанных = Элемент.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
			ОписаниеДинамическогоСписка.Вставить("СхемаКомпоновкиДанных", ИТК_СКД.XMLТекст(СхемаКомпоновкиДанных));
			
			НастройкиКомпоновкиДанных = Элемент.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
			ОписаниеДинамическогоСписка.Вставить("НастройкиКомпоновкиДанных", ИТК_СКД.XMLТекст(НастройкиКомпоновкиДанных));
			
			Результат.Добавить(ОписаниеДинамическогоСписка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ИТК_МенеджерФормКлиентСервер.ДоступныПодчиненныеЭлементы(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл 
		ДанныеОтладкиДинамическихСписковРекурсивно(Форма, ПодчиненныйЭлемент, Результат);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
