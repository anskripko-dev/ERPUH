#Область СлужебныйПрограммныйИнтерфейс

Процедура ДобавитьВСравниваемыеОбъекты(Параметр) Экспорт
	
	РезультатДобавления = ИТК_СравнениеОбъектовВызовСервера.ДобавитьВСравниваемыеОбъекты(Параметр);
	ДобавленныеОбъекты = РезультатДобавления.ДобавленныеОбъекты;
	
	Если ЗначениеЗаполнено(ДобавленныеОбъекты) Тогда
		
		Оповестить("ИТК_ДобавленыОбъектыВСравнение");
		
		Если ДобавленныеОбъекты.Количество() = 1 Тогда
			
			ШаблонПоясненияОповещения = НСтр("ru = 'Объект: %1 добавлен'; en = 'Object: %1 added'");
			ПояснениеОповещения = СтрШаблон(ШаблонПоясненияОповещения, ДобавленныеОбъекты[0]);
			
		Иначе
			
			ШаблонПоясненияОповещения = НСтр("ru = 'Объект(ы): %1 (%2) добавлен(ы)'; en = 'Object(s): %1 (%2) added'");
			
			ПредставлениеСпискаОбъектов = СтрСоединить(ДобавленныеОбъекты, "; ");
			КраткоеПредставлениеСпискаОбъектов = ИТК_Строки.Сократить(ПредставлениеСпискаОбъектов, 50);
			ПояснениеОповещения = СтрШаблон(ШаблонПоясненияОповещения, КраткоеПредставлениеСпискаОбъектов, ДобавленныеОбъекты.Количество());
			
		КонецЕсли;
		
	Иначе
		ПояснениеОповещения = НСтр("ru = 'Данные объект(ы) уже добавлен(ы)'; en = 'These objects(s) have already been added'");
	КонецЕсли;
	
	ДоступныеКСравнению = ИТК_ОбщийКлиентСервер.Свойство(РезультатДобавления, "ДоступныеКСравнению");
	Если ЗначениеЗаполнено(ДоступныеКСравнению) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СравниваемыеОбъекты", ДоступныеКСравнению);
		ДействиеПриНажатииОповещения = Новый ОписаниеОповещения("ДействиеПриНажатииОповещения", ЭтотОбъект, ДополнительныеПараметры);
		
		ШаблонДополненияОповещения = НСтр("ru = 'В сравнении (%1). Сравнить.'; en = 'In comparison (%1). Compare.'");
		ДополнениеОповещения = СтрШаблон(ШаблонДополненияОповещения, ДоступныеКСравнению.Количество());
		ПояснениеОповещения = ПояснениеОповещения + Символы.ПС + ДополнениеОповещения;
		
	Иначе
		ДействиеПриНажатииОповещения = Неопределено;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Добавление объектов в сравнение'; en = 'Adding objects to comparison'"), ДействиеПриНажатииОповещения,
		ПояснениеОповещения, БиблиотекаКартинок.ИТК_СравнениеОбъектовДобавить, СтатусОповещенияПользователя.Информация);
	
КонецПроцедуры

Процедура ДействиеПриНажатииОповещения(ДополнительныеПараметры) Экспорт
	
	Инструмент = ИТК_Перечисления.ИнструментСравнениеОбъектов();
	ИТК_ТуллкитКлиент.ОткрытьИнструмент(Инструмент, ДополнительныеПараметры.СравниваемыеОбъекты);
	
КонецПроцедуры

#КонецОбласти
