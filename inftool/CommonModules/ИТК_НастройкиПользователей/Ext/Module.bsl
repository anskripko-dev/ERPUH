#Область ПрограммныйИнтерфейс

Функция ОписаниеХранилищаНастроек(Идентификатор) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Менеджер", ХранилищеНастроекМенеджерПоИдентификатору(Идентификатор));
	Результат.Вставить("Представление", ПредставлениеХранилищеНастроекПоИдентификатору(Идентификатор));
	
	Возврат Результат;
	
КонецФункции

Функция ХранилищеНастроекМенеджерПоИдентификатору(Идентификатор) Экспорт
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Общие", ХранилищеОбщихНастроек);
	Соответствие.Вставить("Системные", ХранилищеСистемныхНастроек);
	Соответствие.Вставить("ВариантыОтчетов", ХранилищеВариантовОтчетов);
	Соответствие.Вставить("ДанныеФорм", ХранилищеНастроекДанныхФорм);
	
	Возврат Соответствие.Получить(Идентификатор);
	
КонецФункции

Функция ПредставлениеХранилищеНастроекПоИдентификатору(Идентификатор) Экспорт
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Общие", НСтр("ru = 'Общие'; en = 'General'"));
	Соответствие.Вставить("Системные", НСтр("ru = 'Системные'; en = 'System'"));
	Соответствие.Вставить("ВариантыОтчетов", НСтр("ru = 'Варианты отчетов'; en = 'Report options'"));
	Соответствие.Вставить("ДанныеФорм", НСтр("ru = 'Данные форм'; en = 'Form data'"));
	
	Возврат Соответствие.Получить(Идентификатор);
	
КонецФункции

#КонецОбласти

