#Область ПрограммныйИнтерфейс

Процедура Заменить(Параметры, АдресРезультата = Неопределено) Экспорт
	
	Найденные = Параметры.Найденные;
	ОбрабатываемыеОбъекты = Параметры.Обрабатываемые;
	ПакетОбъектов = Параметры.ПакетОбъектов;
	ПараметрыЗаписи = Параметры.ПараметрыЗаписи;
	
	Заменяемые = Параметры.Заменяемые;
	Для Каждого КлючИЗначение Из Заменяемые Цикл 
		
		ОписаниеЗаменыСсылки = КлючИЗначение.Значение;
		ОписаниеЗаменыСсылки.Вставить("ЭтоПеречисление", ИТК_Метаданные.ЭтоПеречисление(КлючИЗначение.Ключ.Метаданные()));
		Заменяемые.Вставить(КлючИЗначение.Ключ, ОписаниеЗаменыСсылки);
		
	КонецЦикла;
	
	Если ПакетОбъектов = Неопределено Тогда
		
		Индекс = 0;
		Для Каждого Ссылка Из ОбрабатываемыеОбъекты Цикл 
			
			ТранзакцияЗаменаСсылкиВОбъекте(Найденные, Заменяемые, ПараметрыЗаписи, Ссылка, Индекс);
			Индекс = Индекс + 1;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Индекс Из ПакетОбъектов Цикл 
			
			Ссылка = ОбрабатываемыеОбъекты[Индекс];
			ТранзакцияЗаменаСсылкиВОбъекте(Найденные, Заменяемые, ПараметрыЗаписи, Ссылка, Индекс);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ТранзакцияЗаменаСсылкиВОбъекте(Найденные, Заменяемые, ПараметрыЗаписи, Ссылка, Индекс)
	
	Ошибка = "";
	ИТК_ДлительныеОперацииКлиентСервер.СообщениеНачалоОбработкиОбъекта(Индекс);
	
	НачатьТранзакцию();
	
	Попытка
		
		ЗаменитьСсылкиВОбъекте(Найденные, Заменяемые, ПараметрыЗаписи, Ссылка, Индекс);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	ИТК_ДлительныеОперацииКлиентСервер.СообщениеКонецОбработкиОбъекта(Ошибка);
	
КонецПроцедуры

Процедура ЗаменитьСсылкиВОбъекте(Найденные, Заменяемые, ПараметрыЗаписи, Ссылка, Индекс)
	
	ЭтоКлючЗаписиРегистраСведений = ИТК_МетаданныеКлиентСервер.ЭтоТипКлючЗаписиРегистраСведений(ТипЗнч(Ссылка));
	Если ЭтоКлючЗаписиРегистраСведений Тогда
		
		ЭтоДокумент = Ложь;
		
		Объект = ИТК_Метаданные.НаборЗаписейПоКлючу(Ссылка);
		Объект.Прочитать();
		
		// Очищаем старые записи
		НаборЗаписей = ИТК_Метаданные.НаборЗаписейПоКлючу(Ссылка);
		ИТК_ОбработкаОбъектов.УстановкаПараметровЗаписи(НаборЗаписей, Истина, ПараметрыЗаписи.ДополнительныеСвойства);
		НаборЗаписей.Записать();
		
	Иначе
		
		ЭтоДокумент = ИТК_Метаданные.ЭтоДокумент(Ссылка.Метаданные());
		Объект = Ссылка.ПолучитьОбъект();
		
	КонецЕсли;
	
	ОбъектВXML = ИТК_XML.ВыгрузкаОбъектаВСтроку(Объект);
	СсылкиПоОбъекту = Найденные.НайтиСтроки(Новый Структура("Данные", Ссылка));
	ЗаменитьСсылкиВТексте(ОбъектВXML, Заменяемые, СсылкиПоОбъекту);
	
	Если ЭтоДокумент Тогда
		ЗаменитьДвиженияДокумента(Объект.Движения, ПараметрыЗаписи, Заменяемые, СсылкиПоОбъекту);
	КонецЕсли;
	
	Объект = ИТК_XML.ЗагрузитьОбъектИзСтроки(ОбъектВXML);
	ЗаменитьПеречисленияВОбъекте(Объект, Заменяемые, СсылкиПоОбъекту);
	ИТК_ОбработкаОбъектов.УстановкаПараметровЗаписи(Объект, Истина, ПараметрыЗаписи.ДополнительныеСвойства);
	Объект.Записать();
	
КонецПроцедуры

Процедура ЗаменитьДвиженияДокумента(Движения, ПараметрыЗаписи, Заменяемые, СсылкиПоОбъекту)
	
	Для Каждого НаборЗаписей Из Движения Цикл 
		
		НаборЗаписей.Прочитать();
		Записывать = ЗначениеЗаполнено(НаборЗаписей);
		
		Если Записывать Тогда
			
			ОбъектВXML = ИТК_XML.ВыгрузкаОбъектаВСтроку(НаборЗаписей);
			ЗаменитьСсылкиВТексте(ОбъектВXML, Заменяемые, СсылкиПоОбъекту);
			
			НаборЗаписей = ИТК_XML.ЗагрузитьОбъектИзСтроки(ОбъектВXML);
			ИТК_ОбработкаОбъектов.УстановкаПараметровЗаписи(НаборЗаписей, Истина, ПараметрыЗаписи.ДополнительныеСвойства);
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьСсылкиВТексте(Текст, Заменяемые, СсылкиПоОбъекту)
	
	Для Каждого Строка Из СсылкиПоОбъекту Цикл 
		
		ОписаниеЗаменыСсылки = Заменяемые.Получить(Строка.Ссылка);
		Если ОписаниеЗаменыСсылки.ЭтоПеречисление Тогда
			Продолжить;
		КонецЕсли;
		
		ИскомыйGUID = Строка(ОписаниеЗаменыСсылки.ИскомаяСсылка.УникальныйИдентификатор());
		Если ЗначениеЗаполнено(ОписаниеЗаменыСсылки.СсылкаЗамена) Тогда
			НовыйGUID = Строка(ОписаниеЗаменыСсылки.СсылкаЗамена.УникальныйИдентификатор());
		Иначе
			НовыйGUID = ИТК_Строки.ПустойУникальныйИдентификатор();
		КонецЕсли;
		
		Текст = СтрЗаменить(Текст, ИскомыйGUID, НовыйGUID);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьПеречисленияВОбъекте(Объект, Заменяемые, СсылкиПоОбъекту)
	
	ЕстьЗаменяемыеПеречисления = Ложь;
	Для Каждого Строка Из СсылкиПоОбъекту Цикл 
		
		ОписаниеЗаменыСсылки = Заменяемые.Получить(Строка.Ссылка);
		Если ОписаниеЗаменыСсылки.ЭтоПеречисление Тогда
			ЕстьЗаменяемыеПеречисления = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьЗаменяемыеПеречисления Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектМетаданных = Объект.Метаданные();
	ИмяКоллекции = ИТК_Метаданные.ИмяКоллекции(ОбъектМетаданных.ПолноеИмя());
	
	Для Каждого Строка Из СсылкиПоОбъекту Цикл 
		
		ОписаниеЗаменыСсылки = Заменяемые.Получить(Строка.Ссылка);
		Если НЕ ОписаниеЗаменыСсылки.ЭтоПеречисление Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоНаборЗаписей = ИТК_МетаданныеКлиентСерверПовтИсп.ТипНаборЗаписей(ИмяКоллекции);
		Если ЭтоНаборЗаписей Тогда
			
			Для Каждого Запись Из Объект Цикл 
				
				ЗаменитьЗначениеПоКоллекцииПолей(Запись, ОбъектМетаданных.Измерения,
					ОписаниеЗаменыСсылки.ИскомаяСсылка, ОписаниеЗаменыСсылки.СсылкаЗамена);
				ЗаменитьЗначениеПоКоллекцииПолей(Запись, ОбъектМетаданных.Ресурсы,
					ОписаниеЗаменыСсылки.ИскомаяСсылка, ОписаниеЗаменыСсылки.СсылкаЗамена);
				ЗаменитьЗначениеПоКоллекцииПолей(Запись, ОбъектМетаданных.Реквизиты,
					ОписаниеЗаменыСсылки.ИскомаяСсылка, ОписаниеЗаменыСсылки.СсылкаЗамена);
				
			КонецЦикла;
			
		Иначе
			
			// Реквизиты
			Если ИТК_МетаданныеКлиентСерверПовтИсп.ИмеетРеквизиты(ИмяКоллекции) Тогда
				
				ЗаменитьЗначениеПоКоллекцииПолей(Объект, ОбъектМетаданных.Реквизиты,
					ОписаниеЗаменыСсылки.ИскомаяСсылка, ОписаниеЗаменыСсылки.СсылкаЗамена);
				
			КонецЕсли;
			
			// Табличные части
			Если ИТК_МетаданныеКлиентСерверПовтИсп.ИмеетТабличныеЧасти(ИмяКоллекции) Тогда
				
				Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
					
					Для Каждого Строка Из Объект[ТабличнаяЧасть.Имя] Цикл 
						ЗаменитьЗначениеПоКоллекцииПолей(Строка, ТабличнаяЧасть.Реквизиты,
							ОписаниеЗаменыСсылки.ИскомаяСсылка, ОписаниеЗаменыСсылки.СсылкаЗамена);
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьЗначениеПоКоллекцииПолей(Объект, Коллекция, ИскомаяСсылка, СсылкаЗамена)
	
	Для Каждого Поле Из Коллекция Цикл
		
		Если Объект[Поле.Имя] = ИскомаяСсылка Тогда
			Объект[Поле.Имя] = СсылкаЗамена;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

