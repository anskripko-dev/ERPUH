#Область ПрограммныйИнтерфейс

Процедура ОткрытиеТиповойФормы(Идентификатор, ПараметрКоманды = Неопределено, ПараметрыВыполненияКоманды = Неопределено) Экспорт
	
	ПолноеИмяФормы = ИТК_БСП.ПолноеИмяТиповойФормы(Идентификатор);
	
	Если НЕ ЗначениеЗаполнено(ПолноеИмяФормы) Тогда
		
		ИдентификаторАнглийский = ИТК_БСПКлиентСерверПовтИсп.АнглийскийИдентификаторСтандартнойОбработки(Идентификатор);
		ШаблонТекста = НСтр("ru = 'Отсутствует типовая форма %1 (%2) (БСП)';
							|en = 'There is no standard form %2 (%1) (SSL)'");
		Текст = СтрШаблон(ШаблонТекста, Идентификатор, ИдентификаторАнглийский);
		Заголовок = ИТК_ТуллкитКлиентСервер.Представление();
		ПоказатьПредупреждение( , Текст, , Заголовок);
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если ТипЗнч(ПараметрКоманды) = Тип("СписокЗначений") Тогда
		ПараметрыФормы.Вставить("МассивОбъектов", ПараметрКоманды.ВыгрузитьЗначения());
	КонецЕсли;
	
	Если ПараметрыВыполненияКоманды = Неопределено Тогда
		ОткрытьФорму(ПолноеИмяФормы, ПараметрыФормы);
	Иначе
		
		ОткрытьФорму(ПолноеИмяФормы, ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность,
			ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьПользователяБСП(УникальныйИдентификатор) Экспорт
	
	ПользовательСсылка = ИТК_БСП.НайтиПользователяПоУникальномуИдентификатору(УникальныйИдентификатор);
	Если НЕ ЗначениеЗаполнено(ПользовательСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение( , ПользовательСсылка);
	
КонецПроцедуры

