#Область СлужебныйПрограммныйИнтерфейс

Функция ФильтрыФайлов() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(НСтр("ru = 'Все поддерживаемые форматы (*.xml; *.fi)|*.xml;*.fi'; en = 'All supported formats (*.xml; *.fi)|*.xml;*.fi'"));
	Результат.Добавить(НСтр("ru = 'Формат выгрузки FastInfoSet (*.fi)|*.fi'; en = 'FastInfoSet download format (*.fi)|*.fi'"));
	Результат.Добавить(НСтр("ru = 'Человекочитаемый формат выгрузки (*.xml)|*.xml'; en = 'Human-readable download format (*.xml)|*.xml'"));
	Результат.Добавить(НСтр("ru = 'Все файлы (*.*)|*.*'; en = 'All files (*.*)|*.*'"));
	
	Возврат СтрСоединить(Результат, "|");
	
КонецФункции

