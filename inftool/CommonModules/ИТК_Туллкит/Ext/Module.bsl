#Область ПрограммныйИнтерфейс

Функция ОбъектОбработкиИнструмента(Инструмент, Объект) Экспорт
	
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Инструмент = ИТК_Перечисления.ИнструментПоискИЗаменаСсылок()
			ИЛИ Инструмент = ИТК_Перечисления.ИнструментСравнениеОбъектов() Тогда
			
		// Необходимо обработать и оставить только ссылочные объекты
		ИсключаяПеречисления = (Инструмент = ИТК_Перечисления.ИнструментСравнениеОбъектов());
		Результат = ИзОбъектаТолькоСсылки(Объект, ИсключаяПеречисления);
		
	Иначе
		Результат = Объект;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеОписаниеИнструментов() Экспорт
	
	Возврат ИТК_ТуллкитПовтИсп.СоответствиеОписаниеИнструментов();
	
КонецФункции

Функция ЭтоОбъектИзСоставаИнструментовТуллкит(Объект) Экспорт
	
	Если ТипЗнч(Объект) <> Тип("ОбъектМетаданных") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Булево(СтрНачинаетсяС(Объект.Имя, ИТК_ТуллкитКлиентСервер.Префикс()));
	
КонецФункции

Функция ИнициализацияПослеУстановкиТребуетсяПерезапуск() Экспорт
	
	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КлючОбъекта = ИТК_ТуллкитКлиентСервер.ОсновнойКлючОбъектаНастроек();
	КлючНастроек = "НастройкиУстановки";
	ПользовательОбщихНастроек = ИТК_ТуллкитКлиентСервер.ПользовательОбщихНастроек();
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУстановки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек, , ПользовательОбщихНастроек);
	Если НастройкиУстановки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДобавленыПрава = ДобавитьПраваПользователямПослеУстановки(НастройкиУстановки);
	
	Если НастройкиУстановки.ВариантУстановки = "НаСеанс" Тогда
		
		Если НастройкиУстановки.Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор Тогда
			
			Если НастройкиУстановки.Свойство("ТребуетсяУдалениеРасширения") Тогда
				
				УдалитьНашеРасширение();
				ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючНастроек, ПользовательОбщихНастроек);
				
			Иначе
				
				НастройкиУстановки.Вставить("ТребуетсяУдалениеРасширения", Истина);
				ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, НастройкиУстановки, , ПользовательОбщихНастроек);
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючНастроек, ПользовательОбщихНастроек);
		
		Если ДобавленыПрава Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзОбъектаТолькоСсылки(Объект, ИсключаяПеречисления = Ложь)
	
	ТипЗначенияОбъекта = ТипЗнч(Объект);
	
	Если ТипЗначенияОбъекта = Тип("СписокЗначений") Тогда
		
		Результат = Новый СписокЗначений;
		Для Каждого ЭлементСписка Из Объект Цикл 
			
			Значение = ЭлементСписка.Значение;
			Если НЕ ИТК_ТипыКлиентСервер.ЭтоСсылочный(ТипЗнч(Значение)) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.Добавить(Значение);
			
		КонецЦикла;
		
	Иначе
		
		Если ИТК_ТипыКлиентСервер.ЭтоСсылочный(ТипЗначенияОбъекта) Тогда
			Результат = Объект;
		Иначе
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьПраваПользователямПослеУстановки(НастройкиУстановки)
	
	СписокПользователейИБ = Новый Массив;
	Если НастройкиУстановки.ВариантУстановки = "НаСеанс"
			ИЛИ НастройкиУстановки.ВариантУстановки = "ТолькоТекущемуПользователю" Тогда
			
		УникальныйИдентификаторПользователяИБ = НастройкиУстановки["Пользователь"];
		НайденныйПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(УникальныйИдентификаторПользователяИБ);
		СписокПользователейИБ.Добавить(НайденныйПользовательИБ);
		
	КонецЕсли;
	
	Если НастройкиУстановки.ВариантУстановки = "ВсемАдминистраторам" Тогда
		
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			
			Если ПравоДоступа("АдминистрированиеДанных", Метаданные, ПользовательИБ) Тогда
				СписокПользователейИБ.Добавить(ПользовательИБ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		
		ДобавлятьВМеханизмыБСП = (НастройкиУстановки.ВариантУстановки <> "НаСеанс");
		ДобавленыПрава = ДобавитьПраваПользователямПоСписку(СписокПользователейИБ, ДобавлятьВМеханизмыБСП);
		
	Исключение
		ДобавленыПрава = Ложь;
	КонецПопытки;
	
	Возврат ДобавленыПрава;
	
КонецФункции

Функция ДобавитьПраваПользователямПоСписку(СписокПользователейИБ, ДобавлятьВМеханизмыБСП)
	
	ДобавленыПрава = Ложь;
	
	ИспользуетсяУправлениеДоступномБСП = ДобавлятьВМеханизмыБСП
		И ИТК_БСПКлиентСервер.ИспользуетсяБСП()
		И ИТК_Метаданные.СуществуетОбщийМодуль("УправлениеДоступомСлужебный") <> Неопределено;
	
	Если ИспользуетсяУправлениеДоступномБСП Тогда
		
		МенеджерИдентификаторыОбъектовРасширений = ИТК_БСП.МенеджерИдентификаторыОбъектовРасширений();
		Если ИТК_БСПКлиентСерверПовтИсп.АнглийскаяБСП() Тогда
			
			МенеджерИдентификаторыОбъектовРасширений.UpdateCatalogData();
			ИдентификаторыОбъектовРасширенийПолеПолноеИмя = "FullName";
			
			ПрофильГруппДоступаИмяТЧРоли = "Roles";
			ПрофильГруппДоступаИмяПоляРольТЧРоли = "Role";
			ПрофильГруппДоступаИмяТЧНазначение = "Purpose";
			ПрофильГруппДоступаИмяПоляТипПользователейТЧНазначение = "UsersType";
			
			ГруппаДоступаИмяПоляПрофиль = "Profile";
			ГруппаДоступаИмяТЧПользователи = "Users";
			ГруппаДоступаИмяПоляПользовательТЧПользователи = "User";
			
			ПользователиИмяПоляИдентификаторПользователяИБ = "IBUserID";
			
		Иначе
			
			МенеджерИдентификаторыОбъектовРасширений.ОбновитьДанныеСправочника();
			ИдентификаторыОбъектовРасширенийПолеПолноеИмя = "ПолноеИмя";
			
			ПрофильГруппДоступаИмяТЧРоли = "Роли";
			ПрофильГруппДоступаИмяПоляРольТЧРоли = "Роль";
			ПрофильГруппДоступаИмяТЧНазначение = "Назначение";
			ПрофильГруппДоступаИмяПоляТипПользователейТЧНазначение = "ТипПользователей";
			
			ГруппаДоступаИмяПоляПрофиль = "Профиль";
			ГруппаДоступаИмяТЧПользователи = "Пользователи";
			ГруппаДоступаИмяПоляПользовательТЧПользователи = "Пользователь";
			
			ПользователиИмяПоляИдентификаторПользователяИБ = "ИдентификаторПользователяИБ";
			
		КонецЕсли;
		
		// Профиль групп доступа
		МенеджерПрофилиГруппДоступа = ИТК_БСП.МенеджерПрофилиГруппДоступа();
		СсылкаПрофильГруппДоступа = МенеджерПрофилиГруппДоступа.ПолучитьСсылку(УникальныйИдентификаторПрофиляГруппаДоступаТуллкитПолныеПрава());
		Если ИТК_Общий.БитаяСсылка(СсылкаПрофильГруппДоступа) Тогда
			
			ОбъектПрофильГруппДоступа = МенеджерПрофилиГруппДоступа.СоздатьЭлемент();
			ОбъектПрофильГруппДоступа.УстановитьСсылкуНового(СсылкаПрофильГруппДоступа);
			ОбъектПрофильГруппДоступа.Наименование = "Infostart Toolkit Air (полные права)";
			
			СсылкаИдентификаторОбъектаМетаданных = МенеджерИдентификаторыОбъектовРасширений.НайтиПоРеквизиту(
				ИдентификаторыОбъектовРасширенийПолеПолноеИмя, "Роль.ИТК_ПолныйДоступ");
			Если ОбъектПрофильГруппДоступа[ПрофильГруппДоступаИмяТЧРоли].Найти(СсылкаИдентификаторОбъектаМетаданных, ПрофильГруппДоступаИмяПоляРольТЧРоли) = Неопределено Тогда
				
				НоваяСтрока = ОбъектПрофильГруппДоступа[ПрофильГруппДоступаИмяТЧРоли].Добавить();
				НоваяСтрока[ПрофильГруппДоступаИмяПоляРольТЧРоли] = СсылкаИдентификаторОбъектаМетаданных;
				
			КонецЕсли;
			
			// Необходимо добавить пустую строку https://github.com/infostart-hub/toolkit/issues/1211
			НоваяСтрока = ОбъектПрофильГруппДоступа[ПрофильГруппДоступаИмяТЧНазначение].Добавить();
			НоваяСтрока[ПрофильГруппДоступаИмяПоляТипПользователейТЧНазначение] = ИТК_БСП.МенеджерПользователи().ПустаяСсылка();
			
			ОбъектПрофильГруппДоступа.Записать();
			
			ДобавленыПрава = Истина;
			
		КонецЕсли;
		
		// Группа доступа
		ЭтоДокументоОборот30 = (Метаданные.Имя = "ДокументооборотКОРП")
									И ИТК_ОбщийКлиентСервер.СравнитьВерсии(Метаданные.Версия, "3.0") <> -1;
		Если ЭтоДокументоОборот30 Тогда
			
			МенеджерПользователи = ИТК_БСП.МенеджерПользователи();
			Для Каждого ПользовательИБ Из СписокПользователейИБ Цикл 
				
				СсылкаПользователь = МенеджерПользователи.НайтиПоРеквизиту(ПользователиИмяПоляИдентификаторПользователяИБ, ПользовательИБ.УникальныйИдентификатор);
				
				МенеджерЗаписи = РегистрыСведений["ПолномочияСотрудников"].СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Владелец = СсылкаПользователь;
				МенеджерЗаписи.Полномочия = СсылкаПрофильГруппДоступа;
				МенеджерЗаписи.Записать();
				
				ДобавленыПрава = Истина;
				
			КонецЦикла;
			
		Иначе
			
			МенеджерГруппыДоступа = ИТК_БСП.МенеджерГруппыДоступа();
			СсылкаГруппыДоступа = МенеджерГруппыДоступа.ПолучитьСсылку(УникальныйИдентификаторГруппыДоступаТуллкитПолныеПрава());
			Если ИТК_Общий.БитаяСсылка(СсылкаГруппыДоступа) Тогда
				
				ОбъектГруппаДоступа = МенеджерГруппыДоступа.СоздатьЭлемент();
				ОбъектГруппаДоступа.УстановитьСсылкуНового(СсылкаГруппыДоступа);
				ОбъектГруппаДоступа.Наименование = "Infostart Toolkit Air (полные права)";
				ОбъектГруппаДоступа[ГруппаДоступаИмяПоляПрофиль] = СсылкаПрофильГруппДоступа;
				
			Иначе
				ОбъектГруппаДоступа = СсылкаГруппыДоступа.ПолучитьОбъект();
			КонецЕсли;
			
			МенеджерПользователи = ИТК_БСП.МенеджерПользователи();
			Для Каждого ПользовательИБ Из СписокПользователейИБ Цикл 
				
				СсылкаПользователь = МенеджерПользователи.НайтиПоРеквизиту(ПользователиИмяПоляИдентификаторПользователяИБ, ПользовательИБ.УникальныйИдентификатор);
				Если ОбъектГруппаДоступа[ГруппаДоступаИмяТЧПользователи].Найти(СсылкаПользователь, ГруппаДоступаИмяПоляПользовательТЧПользователи) = Неопределено Тогда
					
					НоваяСтрока = ОбъектГруппаДоступа[ГруппаДоступаИмяТЧПользователи].Добавить();
					НоваяСтрока[ГруппаДоступаИмяПоляПользовательТЧПользователи] = СсылкаПользователь;
					
					ДобавленыПрава = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ДобавленыПрава Тогда
				ОбъектГруппаДоступа.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавление ролей пользователям ИБ
	ДобавляемаяРоль = Метаданные.Роли.ИТК_ПолныйДоступ;
	Для Каждого ПользовательИБ Из СписокПользователейИБ Цикл
		
		Если НЕ ПользовательИБ.Роли.Содержит(ДобавляемаяРоль) Тогда
			
			ДобавленыПрава = Истина;
			
			ПользовательИБ.Роли.Добавить(ДобавляемаяРоль);
			ПользовательИБ.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДобавленыПрава;
	
КонецФункции

Функция УникальныйИдентификаторПрофиляГруппаДоступаТуллкитПолныеПрава()
	Возврат Новый УникальныйИдентификатор("0668f986-879b-4566-8224-7415180a3b87");
КонецФункции

Функция УникальныйИдентификаторГруппыДоступаТуллкитПолныеПрава()
	Возврат Новый УникальныйИдентификатор("0a5396d2-1795-4ef1-a52e-ae65429d9ad4");
КонецФункции

Процедура УдалитьНашеРасширение()
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого РасширениеКонфигурации Из РасширенияКонфигурации.Получить() Цикл 
		
		Если СтрНайти(РасширениеКонфигурации.Имя, "InfostartToolkit") Тогда
			РасширениеКонфигурации.Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
