	Параметры.СформироватьПриОткрытии = Истина;
	
	Если ИТК_ОбщийКлиентСервер.ЭтоИнтерфейс8_5() Тогда
		Элементы.ФормаОткрытьНовоеОкно.ПоложениеВКоманднойПанели = Вычислить("ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели");
	КонецЕсли;
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

