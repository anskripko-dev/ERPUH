#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступноПолучениеРазмераДанных = ДоступноПолучениеРазмераДанных();
	
	Элементы.ФормаНастройки.Пометка = Истина;
	
	СписокВыбора = Элементы.СортироватьПо.СписокВыбора;
	СписокВыбора.Добавить(ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоКоличеству(), НСтр("ru = 'Количеству'"));
	СписокВыбора.Добавить(ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоИмени(), НСтр("ru = 'Имени'"));
	Если ДоступноПолучениеРазмераДанных Тогда
		СписокВыбора.Добавить(ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоРазмеру(), НСтр("ru = 'Размеру'"));
	КонецЕсли;
	
	ОтборМетаданных = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "ОтборМетаданных");
	СформироватьПриОткрытии = ИТК_ОбщийКлиентСервер.Свойство(Параметры, "СформироватьПриОткрытии");
	СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоКоличеству();
	
	ОтборКоличествоЗаписейНеМенее = 1;
	ГруппироватьМетаданныеПоКоллекциям = Истина;
	РассчитыватьКоличествоЗаписей = Истина;
	
	РассчитыватьРазмерДанных = ДоступноПолучениеРазмераДанных;
	Элементы.РассчитыватьРазмерДанных.Доступность = ДоступноПолучениеРазмераДанных;
	
	ИТК_Настройки.ИнициализироватьФорму(ЭтотОбъект);
	
	ИТК_Форма.ОбработчикПриСозданииНаСервереПосле(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИТК_ОбщийКлиент.ОбработчикПриОткрытии(Отказ);
	
	Если СформироватьПриОткрытии Тогда
		ОбновитьОтчет();
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборМетаданныхПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	ДополнительныеПараметрыОповещения = Новый Структура;
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("НастройкаОтбораМетаданныхЗавершена", ЭтотОбъект, ДополнительныеПараметрыОповещения);
	
	ДополнительныеПараметры = Новый Структура;
	
	ИсключаемыеМетаданные = Новый Массив;
	ИсключаемыеМетаданные.Добавить("Подсистемы");
	ИсключаемыеМетаданные.Добавить("Константы");
	ИсключаемыеМетаданные.Добавить("Перечисления");
	ИсключаемыеМетаданные.Добавить("Последовательности");
	ИсключаемыеМетаданные.Добавить("ХранилищаНастроек");
	ИсключаемыеМетаданные.Добавить("Отчеты");
	ИсключаемыеМетаданные.Добавить("Обработки");
	ИсключаемыеМетаданные.Добавить("ПланыОбмена");
	ИсключаемыеМетаданные.Добавить("КритерииОтбора");
	ИсключаемыеМетаданные.Добавить("ПараметрыСеанса");
	ИсключаемыеМетаданные.Добавить("ВнешниеИсточникиДанных");
	ИсключаемыеМетаданные.Добавить("ОбщиеКоманды");
	ДополнительныеПараметры.Вставить("Исключаемые", СтрСоединить(ИсключаемыеМетаданные, ","));
	
	ИТК_ФормаКлиент.ОткрытьРедактированиеТипаЗначения(ЭтотОбъект, Неопределено, ИТК_Перечисления.РежимРедактированияТипаЗначенияОтборМетаданных(),
														ОтборМетаданных, ОписаниеОповещенияЗавершение, СтандартнаяОбработка, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СортироватьПоПриИзменении(Элемент)
	
	Если СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоРазмеру() Тогда
		РассчитыватьРазмерДанных = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитыватьРазмерДанныхПриИзменении(Элемент)
	
	Если РассчитыватьРазмерДанных = Ложь Тогда
		
		Если РассчитыватьКоличествоЗаписей Тогда
			
			Если СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоРазмеру() Тогда
				СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоКоличеству();
			КонецЕсли;
			
		Иначе
			РассчитыватьРазмерДанных = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитыватьКоличествоЗаписейПриИзменении(Элемент)
	
	Если РассчитыватьКоличествоЗаписей = Ложь Тогда
		
		Если РассчитыватьРазмерДанных Тогда
			
			Если СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоКоличеству() Тогда
				СортироватьПо = ИТК_РазмерИКоличествоДанныхКлиентСервер.СортироватьПоРазмеру();
			КонецЕсли;
			
		Иначе
			РассчитыватьКоличествоЗаписей = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	МенюРасшифровки = МенюРасшифровки(АдресДанныхРасшифровки, Расшифровка);
	Если ЗначениеЗаполнено(МенюРасшифровки) Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗавершениеВыбораМенюРасшифровки", ЭтотОбъект);
		ПоказатьВыборИзМеню(Оповещение, МенюРасшифровки, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	ОбновитьОтчет();
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	
	Элемент = Элементы.ФормаНастройки;
	Элемент.Пометка = НЕ Элемент.Пометка;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНовоеОкно(Команда)
	ИТК_ФормаКлиент.ОткрытьНовую(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтборМетаданных(Команда)
	
	ОтборМетаданных = Неопределено;
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	ИТК_ДлительныеОперацииКлиент.ОбновитьЭлементыОтображенияСостояния(ДлительнаяОперация, Элементы.ТабличныйДокументРезультат,
		Элементы.ИдетФормированиеОтчетаТабличныйДокумент, ТекстСтатусаФормирования);
	
	Элементы.ГруппаНастройки.Видимость = Элементы.ФормаНастройки.Пометка;
	ОбновитьОтображениеОтбора("ОтборМетаданных", "Метаданные");
	
	Элементы.ОтборРазмерБайтНеМенее.Доступность = РассчитыватьРазмерДанных;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтчет()
	
	ТекстСтатусаФормирования = НСтр("ru = 'Получение данных отчета...'; |en = 'Getting report data...'");
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ОтборМетаданных", ОтборМетаданных);
	ПараметрыОперации.Вставить("ГруппироватьМетаданныеПоКоллекциям", ГруппироватьМетаданныеПоКоллекциям);
	ПараметрыОперации.Вставить("СортироватьПо", СортироватьПо);
	
	ПараметрыОперации.Вставить("РассчитыватьРазмерДанных", РассчитыватьРазмерДанных);
	Если РассчитыватьРазмерДанных Тогда
		ПараметрыОперации.Вставить("ОтборРазмерБайтНеМенее", ОтборРазмерБайтНеМенее);
	КонецЕсли;
	
	ПараметрыОперации.Вставить("РассчитыватьКоличествоЗаписей", РассчитыватьКоличествоЗаписей);
	Если РассчитыватьКоличествоЗаписей Тогда
		ПараметрыОперации.Вставить("ОтборКоличествоЗаписейНеМенее", ОтборКоличествоЗаписейНеМенее);
	КонецЕсли;
	
	ДлительнаяОперация = ОбновитьОтчетНаСервере(ПараметрыОперации, УникальныйИдентификатор);
	
	ОписаниеОперации = Новый Структура;
	ОписаниеОперации.Вставить("Источник", ИТК_Перечисления.ИнструментРазмерИКоличествоДанных());
	ОписаниеОперации.Вставить("Наименование", НСтр("ru = 'Размер и количество данных';
													|en = 'Size and amount of data'"));
	
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбработкаПрогрессаВыполнения", ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершеноОбновлениеОтчета", ЭтотОбъект);
	ИТК_ОбработкаОбъектовКлиент.ИнициализацияДлительнойОперации(ЭтотОбъект, ДлительнаяОперация, ОписаниеОперации, ОповещениеОПрогрессеВыполнения, ОповещениеОЗавершении);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьОтчетНаСервере(ПараметрыОперации, УникальныйИдентификатор)
	
	ПараметрыВыполнения = ИТК_ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ИТК_ДлительныеОперации.ВыполнитьВФоне("ИТК_РазмерИКоличествоДанных.ДанныеОтчета", ПараметрыОперации, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаПрогрессаВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Результат;
	ИТК_ДлительныеОперацииКлиент.ПодготовитьПрогрессВыполнения(Результат);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Прогресс = Результат.Прогресс;
	Если НЕ ЗначениеЗаполнено(Прогресс) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСтатусаФормирования = Прогресс.Текст;
	Процент = ИТК_ОбщийКлиентСервер.Свойство(Прогресс, "Процент");
	Если ЗначениеЗаполнено(Процент) Тогда
		ТекстСтатусаФормирования = Строка(Процент) + "% - " + ТекстСтатусаФормирования;
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершеноОбновлениеОтчета(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = Результат;
	ИТК_ДлительныеОперацииКлиент.ПодготовитьРезультатВыполнения(Результат);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		Элементы.ФормаНастройки.Пометка = Ложь;
		ОбновитьДанныеОтчетаСервер(Результат.АдресРезультата);
		
	КонецЕсли;
	
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеОтчетаСервер(АдресРезультата)
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	ТабличныйДокументРезультат = РезультатВыполнения.ДокументРезультат;
	АдресДанныхРасшифровки = ИТК_ВременноеХранилище.Поместить(РезультатВыполнения.ДанныеРасшифровки, АдресДанныхРасшифровки, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеОтбора(ИмяЗначенияОтбора, ПолеОтбора)
	
	Отбор = ЭтотОбъект[ИмяЗначенияОтбора];
	ИмяОтборПредставление = ИмяЗначенияОтбора + "Представление";
	
	ЭлементОтборПредставление = Элементы[ИмяОтборПредставление];
	ВыделитьШрифтомЗаголовкаВключенныйОтбор(ЭлементОтборПредставление, Отбор);
	
	ПредставлениеОтбора = ИТК_ФормаКлиентСервер.ПредставлениеСписка(Отбор, 80);
	ЭтотОбъект[ИмяОтборПредставление] = ПредставлениеОтбора;
	
	Элементы["Отключить" + ИмяЗначенияОтбора].Видимость = ЗначениеЗаполнено(Отбор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьШрифтомЗаголовкаВключенныйОтбор(Элемент, Отбор)
	
	ШрифтЗаголовка = Новый Шрифт;
	Если ЗначениеЗаполнено(Отбор) Тогда
		ШрифтЗаголовка = ИТК_ОбщийКлиентСервер.ШрифтЖирный();
	КонецЕсли;
	Элемент.ШрифтЗаголовка = ШрифтЗаголовка;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтбораМетаданныхЗавершена(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборМетаданных = Результат;
	ОбновитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступноПолучениеРазмераДанных()
	Возврат ИТК_ОбщийКлиентСервер.ПоддерживаетсяПлатформой("8.3.15");
КонецФункции

&НаСервереБезКонтекста
Функция МенюРасшифровки(АдресДанныхРасшифровки, Расшифровка) 
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
	ПоляРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля();
	
	Если НЕ ЗначениеЗаполнено(ПоляРасшифровки) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ПолеРасшифровки = ПоляРасшифровки[0].Поле;
	ЗначениеРасшифровки = ПоляРасшифровки[0].Значение;
	
	// Заполнение меню расшифроки
	Результат = Новый СписокЗначений;
	Если ПолеРасшифровки = "Метаданные" Тогда
		
		ДобавитьИнструментВМенюРасшифровки(Результат, ИТК_Перечисления.ИнструментФормаСписка(), ЗначениеРасшифровки);
		ДобавитьИнструментВМенюРасшифровки(Результат, ИТК_Перечисления.ИнструментФормаСпискаУниверсальная(), ЗначениеРасшифровки);
		ДобавитьИнструментВМенюРасшифровки(Результат, ИТК_Перечисления.ИнструментМетаданные(), ЗначениеРасшифровки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеВыбораМенюРасшифровки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ИТК_ТуллкитКлиент.ОткрытьИнструмент(ВыбранноеЗначение["Инструмент"], ВыбранноеЗначение["Параметр"]);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьИнструментВМенюРасшифровки(Меню, Инструмент, Параметр, Представление = Неопределено)
	
	ОписаниеИнструмента = ИТК_ТуллкитКлиентСервер.ОписаниеИнструмента(Инструмент);

	ОписаниеЗначенияСтроки = Новый Структура;
	ОписаниеЗначенияСтроки.Вставить("Инструмент", Инструмент);
	ОписаниеЗначенияСтроки.Вставить("Параметр", Параметр);
	
	Если Представление = Неопределено Тогда 
		Представление = ОписаниеИнструмента.Представление;
	КонецЕсли;
	
	Меню.Добавить(ОписаниеЗначенияСтроки, Представление, , ОписаниеИнструмента.Картинка);
	
КонецПроцедуры

#КонецОбласти
