// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.11.466");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
	ПараметрыРегистрации.Версия = "1.6";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Места использования номенклатуры'");
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Список номенклатуры с произвольным отбором (включая дополнительные реквизиты)
		|и количеством ссылок по типам метаданных. Параметр «Не учитывать типы ссылок»: элемент попадает в отчёт,
		|только если есть ссылки помимо указанного списка.'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.ОпределитьНастройкиФормы = Истина;
	
	ПараметрыРегистрации.Назначение.Добавить("Подсистема.Склад");
	ПараметрыРегистрации.Назначение.Добавить("Подсистема.Продажи");
	ПараметрыРегистрации.Назначение.Добавить("Подсистема.Закупки");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Места использования номенклатуры'");
	Команда.Идентификатор = "нп_МестаИспользованияНоменклатуры";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// СтандартныеПодсистемы.ВариантыОтчетов

// Задать настройки формы отчета.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено
//  КлючВарианта - Строка, Неопределено
//  Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.ФормироватьСразу = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Истина;
	Настройки.РазрешеноИзменятьСтруктуру = Истина;
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	Настройки.События.ПриОпределенииПараметровВыбора = Истина;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Заполняет список выбора типов ссылок.
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	УстановитьДоступныеЗначенияПараметраТипов();
	
	Если КлючСхемы <> "ТипыСсылокВыбора" Тогда
		КлючСхемы = "ТипыСсылокВыбора";
		Если Метаданные.ОбщиеМодули.Найти("ОтчетыСервер") <> Неопределено Тогда
			ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Вызывается в форме отчета перед выводом настройки.
// Оставляет в выборе параметра только справочники, документы, регистры и задачи
// (включая объекты расширений), отсортированные по представлению.
//
Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	
	ПолеПараметра = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ДопустимыеТипыСсылок");
	Если СвойстваНастройки.ПолеКД <> ПолеПараметра Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваНастройки.ОграничиватьВыборУказаннымиЗначениями = Истина;
	СвойстваНастройки.ЗначенияДляВыбора = ПолучитьСписокТиповДляВыбора();
	СвойстваНастройки.ЗапросЗначенийВыбора.Текст = "";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	
	Схема = ПолучитьСхемуОтчета();
	
	ЭлементыСправочника = ЭлементыСправочникаПоНастройкам(Настройки, ПользовательскиеНастройки);
	ЭлементыСправочника = ОграничитьЭлементыСправочника(ЭлементыСправочника, Настройки, ПользовательскиеНастройки);
	ВыводитьСсылающиесяОбъекты = ВыводитьСсылающиесяОбъектыИзНастроек(
		Настройки,
		ПользовательскиеНастройки,
		ЭлементыСправочника.Количество());
	ИсключатьПомеченныеНаУдаление = ИсключатьПомеченныеНаУдалениеИзНастроек(
		Настройки,
		ПользовательскиеНастройки);
	МестаИспользования = ТаблицаМестИспользования(
		ЭлементыСправочника,
		ВыводитьСсылающиесяОбъекты,
		ИсключатьПомеченныеНаУдаление);
	ОставитьЭлементыПоДопустимымТипамСсылок(
		ЭлементыСправочника,
		МестаИспользования,
		Настройки,
		ПользовательскиеНастройки);
	
	ПодготовитьСхемуДляВывода(Схема);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ЭлементыСправочника", ЭлементыСправочника);
	ВнешниеНаборыДанных.Вставить("МестаИспользования", МестаИспользования);
	
	НастройкиВывода = НастройкиВыводаОтчета(Настройки, ВыводитьСсылающиесяОбъекты);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, НастройкиВывода, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьДоступныеЗначенияПараметраТипов()
	
	Если ТипЗнч(СхемаКомпоновкиДанных) <> Тип("СхемаКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Параметр = СхемаКомпоновкиДанных.Параметры.Найти("ДопустимыеТипыСсылок");
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметр.ТипЗначения = ТипЗначенияПараметраТиповСсылок();
	Параметр.УстановитьДоступныеЗначения(ПолучитьСписокТиповДляВыбора());
	
КонецПроцедуры

Функция ТипЗначенияПараметраТиповСсылок()
	
	ИменаТипов = Новый Массив;
	ИменаТипов.Добавить("Строка");
	
	Если Метаданные.Справочники.Найти("ИдентификаторыОбъектовМетаданных") <> Неопределено Тогда
		ИменаТипов.Добавить("СправочникСсылка.ИдентификаторыОбъектовМетаданных");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("ИдентификаторыОбъектовРасширений") <> Неопределено Тогда
		ИменаТипов.Добавить("СправочникСсылка.ИдентификаторыОбъектовРасширений");
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(СтрСоединить(ИменаТипов, ", "), , Новый КвалификаторыСтроки(250));
	
КонецФункции

Функция ПолучитьСписокТиповДляВыбора()
	
	Список = Новый СписокЗначений;
	ОбъектыМетаданных = Новый Массив;
	
	Для Каждого Коллекция Из КоллекцииТиповДляВыбора() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			ОбъектыМетаданных.Добавить(ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;
	
	Идентификаторы = ИдентификаторыОбъектовМетаданныхДляВыбора(ОбъектыМетаданных);
	
	Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
		
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Значение = Идентификаторы.Получить(ПолноеИмя);
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Значение = ПолноеИмя;
		КонецЕсли;
		
		Представление = ПредставлениеТипаДляВыбора(ОбъектМетаданных);
		
		Список.Добавить(Значение, Представление);
		
	КонецЦикла;
	
	Список.СортироватьПоПредставлению();
	Возврат Список;
	
КонецФункции

Функция КоллекцииТиповДляВыбора()
	
	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.РегистрыРасчета);
	Коллекции.Добавить(Метаданные.Задачи);
	Возврат Коллекции;
	
КонецФункции

Функция ПредставлениеТипаДляВыбора(ОбъектМетаданных)
	
	Представление = ОбъектМетаданных.Представление();
	Если ПустаяСтрока(Представление) Тогда
		Представление = ОбъектМетаданных.Имя;
	КонецЕсли;
	
	ВидМетаданных = ВидМетаданныхДляВыбора(ОбъектМетаданных);
	Если ПустаяСтрока(ВидМетаданных) Тогда
		Возврат Представление;
	КонецЕсли;
	
	Возврат ВидМетаданных + " " + Представление;
	
КонецФункции

Функция ВидМетаданныхДляВыбора(ОбъектМетаданных)
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Справочник'");
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Документ'");
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Регистр сведений'");
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Регистр накопления'");
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Регистр бухгалтерии'");
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Регистр расчета'");
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		Возврат НСтр("ru = 'Задача'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИдентификаторыОбъектовМетаданныхДляВыбора(ОбъектыМетаданных)
	
	Если ОбъектыМетаданных.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ОбъектыМетаданных, Ложь);
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;
	
КонецФункции

Функция КопияНастроекКомпоновкиДанных(Настройки)
	
	Если Метаданные.ОбщиеМодули.Найти("КомпоновкаДанныхКлиентСервер") <> Неопределено Тогда
		НастройкиКопия = Новый НастройкиКомпоновкиДанных;
		КомпоновкаДанныхКлиентСервер.СкопироватьНастройкиКомпоновкиДанных(НастройкиКопия, Настройки);
		Возврат НастройкиКопия;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Настройки, НазначениеТипаXML.Явное);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЗаписьXML.Закрыть());
	
	Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("НастройкиКомпоновкиДанных"));
	
КонецФункции

Функция КопияСхемыКомпоновкиДанных(ИсходнаяСхема)
	
	Если Метаданные.ОбщиеМодули.Найти("КомпоновкаДанныхСервер") <> Неопределено Тогда
		Возврат КомпоновкаДанныхСервер.СкопироватьСхемуКомпоновкиДанных(ИсходнаяСхема);
	КонецЕсли;
	
	Возврат СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(ИсходнаяСхема));
	
КонецФункции

Функция ПолучитьСхемуОтчета()
	
	Если ТипЗнч(СхемаКомпоновкиДанных) = Тип("СхемаКомпоновкиДанных") Тогда
		ИсходнаяСхема = СхемаКомпоновкиДанных;
	Иначе
		ИсходнаяСхема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КонецЕсли;
	
	Возврат КопияСхемыКомпоновкиДанных(ИсходнаяСхема);
	
КонецФункции

Функция НастройкиОтбораЭлементов(СхемаОтбора, Настройки, ПользовательскиеНастройки = Неопределено)
	
	КомпоновщикОтбора = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикОтбора.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаОтбора));
	КомпоновщикОтбора.ЗагрузитьНастройки(Настройки);
	
	Если ПользовательскиеНастройки <> Неопределено Тогда
		КомпоновщикОтбора.ЗагрузитьПользовательскиеНастройки(ПользовательскиеНастройки);
	КонецЕсли;
	
	НастройкиОтбора = КомпоновщикОтбора.ПолучитьНастройки();
	НастройкиОтбора.Структура.Очистить();
	НастройкиОтбора.Выбор.Элементы.Очистить();
	НастройкиОтбора.Порядок.Элементы.Очистить();
	ОтключитьОтборПолейМестИспользования(НастройкиОтбора.Отбор);
	
	Группировка = НастройкиОтбора.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Очистить();
	Группировка.Порядок.Элементы.Очистить();
	
	НаборЭлементов = СхемаОтбора.НаборыДанных.Найти("ЭлементыСправочника");
	Если НаборЭлементов <> Неопределено Тогда
		
		Для Каждого ПолеНабора Из НаборЭлементов.Поля Цикл
			
			Если ТипЗнч(ПолеНабора) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			
			ПолеВыбор = Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ПолеНабора.Поле);
			ПолеВыбор.Использование = Истина;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПолеПорядокСсылка = Группировка.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядокСсылка.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
	ПолеПорядокСсылка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ПолеПорядокСсылка.Использование = Истина;
	
	Возврат НастройкиОтбора;
	
КонецФункции

Процедура УдалитьСвязиНаборовДанных(Схема)
	
	Пока Схема.СвязиНаборовДанных.Количество() > 0 Цикл
		Схема.СвязиНаборовДанных.Удалить(Схема.СвязиНаборовДанных[0]);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНаборДанных(Схема, ИмяНабора)
	
	Набор = Схема.НаборыДанных.Найти(ИмяНабора);
	Если Набор <> Неопределено Тогда
		Схема.НаборыДанных.Удалить(Набор);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПреобразоватьНаборВОбъект(Схема, ИмяНабора)
	
	Набор = Схема.НаборыДанных.Найти(ИмяНабора);
	Если Набор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Набор) = Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
		Набор.ИмяОбъекта = ИмяНабора;
		Возврат;
	КонецЕсли;
	
	ИсточникДанных = Набор.ИсточникДанных;
	ОписанияПолей = Новый Массив;
	
	Для Каждого ПолеНабора Из Набор.Поля Цикл
		
		Если ТипЗнч(ПолеНабора) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеПоля = Новый Структура("Поле, ПутьКДанным, Заголовок");
		ОписаниеПоля.Поле = ПолеНабора.Поле;
		ОписаниеПоля.ПутьКДанным = ПолеНабора.ПутьКДанным;
		ОписаниеПоля.Заголовок = ПолеНабора.Заголовок;
		ОписанияПолей.Добавить(ОписаниеПоля);
		
	КонецЦикла;
	
	Схема.НаборыДанных.Удалить(Набор);
	
	НаборОбъект = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборОбъект.Имя = ИмяНабора;
	НаборОбъект.ИсточникДанных = ИсточникДанных;
	НаборОбъект.ИмяОбъекта = ИмяНабора;
	
	Для Каждого ОписаниеПоля Из ОписанияПолей Цикл
		НовоеПоле = НаборОбъект.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле = ОписаниеПоля.Поле;
		НовоеПоле.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
		НовоеПоле.Заголовок = ОписаниеПоля.Заголовок;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьСхемуДляВывода(Схема)
	
	УдалитьСвязиНаборовДанных(Схема);
	ПреобразоватьНаборВОбъект(Схема, "ЭлементыСправочника");
	ПреобразоватьНаборВОбъект(Схема, "МестаИспользования");
	
	Связь = Схема.СвязиНаборовДанных.Добавить();
	Связь.НаборДанныхИсточник = "ЭлементыСправочника";
	Связь.НаборДанныхПриемник = "МестаИспользования";
	Связь.ВыражениеИсточник = "Ссылка";
	Связь.ВыражениеПриемник = "ЭлементСправочника";
	
КонецПроцедуры

Функция НастройкиВыводаОтчета(Настройки, ВыводитьСсылающиесяОбъекты = Ложь)
	
	НастройкиВывода = КопияНастроекКомпоновкиДанных(Настройки);
	ОставитьТолькоОтборПолейМестИспользования(НастройкиВывода.Отбор);
	
	Если Не ВыводитьСсылающиесяОбъекты Тогда
		ОтключитьГруппировкуСсылающихсяОбъектов(НастройкиВывода.Структура);
		ОтключитьВыбранноеПоле(НастройкиВывода.Выбор, "СсылающийсяОбъект");
		ОтключитьВыбранноеПоле(НастройкиВывода.Выбор, "ПредставлениеСсылки");
	КонецЕсли;
	
	Возврат НастройкиВывода;
	
КонецФункции

Функция ГруппировкаПоПолю(Группировка, ИмяПоля)
	
	Для Каждого ПолеГруппировки Из Группировка.ПоляГруппировки.Элементы Цикл
		
		Если ТипЗнч(ПолеГруппировки) = Тип("ПолеГруппировкиКомпоновкиДанных")
			И Строка(ПолеГруппировки.Поле) = ИмяПоля Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ОтключитьГруппировкуСсылающихсяОбъектов(КоллекцияСтруктуры)
	
	Для Каждого ЭлементСтруктуры Из КоллекцияСтруктуры Цикл
		
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных")
			Или ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
			
			Если ГруппировкаПоПолю(ЭлементСтруктуры, "СсылающийсяОбъект") Тогда
				ЭлементСтруктуры.Использование = Ложь;
				Продолжить;
			КонецЕсли;
			
			ОтключитьГруппировкуСсылающихсяОбъектов(ЭлементСтруктуры.Структура);
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			ОтключитьГруппировкуСсылающихсяОбъектов(ЭлементСтруктуры.Строки);
			ОтключитьГруппировкуСсылающихсяОбъектов(ЭлементСтруктуры.Колонки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтключитьВыбранноеПоле(Выбор, ИмяПоля)
	
	Для Каждого ЭлементВыбора Из Выбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных")
			И Строка(ЭлементВыбора.Поле) = ИмяПоля Тогда
			ЭлементВыбора.Использование = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПоляМестИспользования()
	
	Результат = Новый Соответствие;
	Результат.Вставить("ЭлементСправочника", Истина);
	Результат.Вставить("ТипЗначения", Истина);
	Результат.Вставить("ИмяТипаЗначения", Истина);
	Результат.Вставить("СсылающийсяОбъект", Истина);
	Результат.Вставить("ПредставлениеСсылки", Истина);
	Результат.Вставить("КоличествоСсылок", Истина);
	Результат.Вставить("КоличествоСсылокИтог", Истина);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПолеМестИспользования(ЭлементОтбора)
	
	Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПоляМестИспользования().Получить(Строка(ЭлементОтбора.ЛевоеЗначение)) = Истина;
	
КонецФункции

Процедура УстановитьИспользованиеОтбораПоПолямМест(Отбор, ОставитьПоляМест)
	
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УстановитьИспользованиеОтбораПоПолямМест(ЭлементОтбора, ОставитьПоляМест);
			Продолжить;
		КонецЕсли;
		
		ЭтоПолеМест = ЭтоПолеМестИспользования(ЭлементОтбора);
		Если ОставитьПоляМест Тогда
			Если Не ЭтоПолеМест Тогда
				ЭлементОтбора.Использование = Ложь;
			КонецЕсли;
		ИначеЕсли ЭтоПолеМест Тогда
			ЭлементОтбора.Использование = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтключитьОтборПолейМестИспользования(Отбор)
	
	УстановитьИспользованиеОтбораПоПолямМест(Отбор, Ложь);
	
КонецПроцедуры

Процедура ОставитьТолькоОтборПолейМестИспользования(Отбор)
	
	УстановитьИспользованиеОтбораПоПолямМест(Отбор, Истина);
	
КонецПроцедуры

Процедура УстановитьКоличествоПервыхВЗапросе(Схема, КоличествоПервых)
	
	Набор = Схема.НаборыДанных.Найти("ЭлементыСправочника");
	Если Набор = Неопределено
		Или ТипЗнч(Набор) <> Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрокой = Формат(КоличествоПервых, "ЧГ=0");
	ТекстЗапроса = Набор.Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 1000", "ПЕРВЫЕ " + КоличествоСтрокой);
	Набор.Запрос = ТекстЗапроса;
	
КонецПроцедуры

Процедура УстановитьПараметрЛимита(НастройкиКД, ЛимитЭлементов)
	
	ПараметрЛимит = НастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ЛимитЭлементов"));
	Если ПараметрЛимит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрЛимит.Значение = ЛимитЭлементов;
	ПараметрЛимит.Использование = Истина;
	
КонецПроцедуры

Функция ЭлементыСправочникаПоНастройкам(Настройки, ПользовательскиеНастройки = Неопределено)
	
	СхемаОтбора = ПолучитьСхемуОтчета();
	УдалитьСвязиНаборовДанных(СхемаОтбора);
	УдалитьНаборДанных(СхемаОтбора, "МестаИспользования");
	
	ЛимитЭлементов = ЛимитЭлементовИзНастроек(Настройки, ПользовательскиеНастройки);
	УстановитьКоличествоПервыхВЗапросе(СхемаОтбора, ЛимитЭлементов);
	
	НастройкиОтбора = НастройкиОтбораЭлементов(СхемаОтбора, Настройки, ПользовательскиеНастройки);
	УстановитьПараметрЛимита(НастройкиОтбора, ЛимитЭлементов);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаОтбора,
		НастройкиОтбора,
		,
		,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ВнешниеНаборыОтбора = Новый Структура;
	ВнешниеНаборыОтбора.Вставить("МестаИспользования", НовыйТаблицаМестИспользования());
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыОтбора);
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ОграничитьЭлементыСправочника(ЭлементыСправочника, Настройки, ПользовательскиеНастройки = Неопределено)
	
	ЛимитЭлементов = ЛимитЭлементовИзНастроек(Настройки, ПользовательскиеНастройки);
	ИсходноеКоличество = ЭлементыСправочника.Количество();
	
	Если ЛимитЭлементов <= 0 Или ИсходноеКоличество <= ЛимитЭлементов Тогда
		Возврат ЭлементыСправочника;
	КонецЕсли;
	
	Пока ЭлементыСправочника.Количество() > ЛимитЭлементов Цикл
		ЭлементыСправочника.Удалить(ЭлементыСправочника.Количество() - 1);
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Отобраны первые %1 элементов из %2. Уточните отбор или увеличьте лимит элементов.'"),
		ЛимитЭлементов,
		ИсходноеКоличество);
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = ТекстСообщения;
	СообщениеПользователю.Сообщить();
	
	Возврат ЭлементыСправочника;
	
КонецФункции

Функция ИмяАнализируемогоСправочника()
	
	Возврат "Номенклатура";
	
КонецФункции

Функция ВыводитьСсылающиесяОбъектыИзНастроек(Настройки, ПользовательскиеНастройки, КоличествоЭлементов)
	
	ЗначениеПараметра = ЗначениеПараметраКомпоновки(
		Настройки,
		ПользовательскиеНастройки,
		"ВыводитьСсылающиесяОбъекты");
	ВыводитьОбъекты = (ЗначениеПараметра = Истина);
	
	ЛимитДетализации = 5000;
	Если ВыводитьОбъекты И КоличествоЭлементов > ЛимитДетализации Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Для %1 элементов выводятся только количества по типам метаданных. Список ссылающихся объектов доступен при лимите до %2.'"),
			Формат(КоличествоЭлементов, "ЧГ=0"),
			Формат(ЛимитДетализации, "ЧГ=0"));
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат ВыводитьОбъекты;
	
КонецФункции

Функция ИсключатьПомеченныеНаУдалениеИзНастроек(Настройки, ПользовательскиеНастройки)
	
	Возврат ЗначениеПараметраКомпоновки(
		Настройки,
		ПользовательскиеНастройки,
		"ИсключатьПомеченныеНаУдаление") = Истина;
	
КонецФункции

Функция ТаблицаМестИспользования(ЭлементыСправочника, ВыводитьСсылающиесяОбъекты = Ложь, ИсключатьПомеченныеНаУдаление = Ложь)
	
	Результат = НовыйТаблицаМестИспользования();
	
	Если ЭлементыСправочника.Колонки.Найти("Ссылка") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	Для Каждого СтрокаЭлемента Из ЭлементыСправочника Цикл
		Если ЗначениеЗаполнено(СтрокаЭлемента.Ссылка) Тогда
			МассивСсылок.Добавить(СтрокаЭлемента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Если ВыводитьСсылающиесяОбъекты Тогда
			ЗаполнитьМестаИспользованияПоОбъектам(Результат, МассивСсылок, ИсключатьПомеченныеНаУдаление);
		Иначе
			ЗаполнитьМестаИспользованияПодсчетомЗапросами(Результат, МассивСсылок, ИсключатьПомеченныеНаУдаление);
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьМестаИспользованияПоОбъектам(Результат, МассивСсылок, ИсключатьПомеченныеНаУдаление = Ложь)
	
	НайденныеСсылки = МестаИспользованияСсылок(МассивСсылок);
	ПомеченныеНаУдаление = ПомеченныеНаУдалениеСсылающиеся(НайденныеСсылки, ИсключатьПомеченныеНаУдаление);
	
	Для Каждого СтрокаНайденных Из НайденныеСсылки Цикл
		
		Если ПомеченныеНаУдаление.Получить(СтрокаНайденных.Данные) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ЭлементСправочника = СтрокаНайденных.Ссылка;
		НоваяСтрока.ТипЗначения = ПредставлениеТипаЗначения(СтрокаНайденных);
		НоваяСтрока.ИмяТипаЗначения = ИмяТипаЗначения(СтрокаНайденных);
		НоваяСтрока.СсылающийсяОбъект = СтрокаНайденных.Данные;
		НоваяСтрока.КоличествоСсылок = 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПомеченныеНаУдалениеСсылающиеся(НайденныеСсылки, ИсключатьПомеченныеНаУдаление)
	
	Результат = Новый Соответствие;
	Если Не ИсключатьПомеченныеНаУдаление Тогда
		Возврат Результат;
	КонецЕсли;
	
	СсылкиДляПроверки = Новый Массив;
	УникальныеСсылки = Новый Соответствие;
	
	Для Каждого СтрокаНайденных Из НайденныеСсылки Цикл
		
		Данные = СтрокаНайденных.Данные;
		Если Не ЭтоСсылкаСправочникаИлиДокумента(Данные) Тогда
			Продолжить;
		КонецЕсли;
		Если УникальныеСсылки.Получить(Данные) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		УникальныеСсылки.Вставить(Данные, Истина);
		СсылкиДляПроверки.Добавить(Данные);
		
	КонецЦикла;
	
	Если СсылкиДляПроверки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") <> Неопределено Тогда
		
		Попытка
			ЗначенияПометки = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СсылкиДляПроверки, "ПометкаУдаления", Истина);
			Для Каждого КлючИЗначение Из ЗначенияПометки Цикл
				Если КлючИЗначение.Значение = Истина Тогда
					Результат.Вставить(КлючИЗначение.Ключ, Истина);
				КонецЕсли;
			КонецЦикла;
			Возврат Результат;
		Исключение
			// Пакетное чтение недоступно — проверяем ссылки по одной.
		КонецПопытки;
		
	КонецЕсли;
	
	Для Каждого Ссылка Из СсылкиДляПроверки Цикл
		Попытка
			Если Ссылка.ПометкаУдаления Тогда
				Результат.Вставить(Ссылка, Истина);
			КонецЕсли;
		Исключение
			// У части ссылок реквизит пометки удаления недоступен.
		КонецПопытки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСсылкаСправочникаИлиДокумента(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.Документы.Содержит(ОбъектМетаданных);
	
КонецФункции

Функция МестаИспользованияСсылок(МассивСсылок)
	
	РазмерПорции = 1000;
	КоличествоСсылок = МассивСсылок.Количество();
	
	Если КоличествоСсылок = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОбластьПоиска = ОбластьПоискаСсылок();
	
	Если КоличествоСсылок <= РазмерПорции Тогда
		Возврат МестаИспользованияПорцииСсылок(МассивСсылок, ОбластьПоиска);
	КонецЕсли;
	
	Результат = Неопределено;
	Индекс = 0;
	
	Пока Индекс < КоличествоСсылок Цикл
		
		Порция = Новый Массив;
		Граница = Мин(Индекс + РазмерПорции, КоличествоСсылок);
		
		Пока Индекс < Граница Цикл
			Порция.Добавить(МассивСсылок[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		
		ТаблицаПорции = МестаИспользованияПорцииСсылок(Порция, ОбластьПоиска);
		
		Если Результат = Неопределено Тогда
			Результат = ТаблицаПорции;
		Иначе
			Для Каждого СтрокаПорции Из ТаблицаПорции Цикл
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаПорции);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МестаИспользованияПорцииСсылок(ПорцияСсылок, ОбластьПоиска)
	
	Если ОбластьПоиска.Количество() = 0 Тогда
		Возврат НайтиПоСсылкам(ПорцияСсылок);
	КонецЕсли;
	
	Возврат НайтиПоСсылкам(ПорцияСсылок, Новый Массив, ОбластьПоиска, Новый Массив);
	
КонецФункции

Процедура ЗаполнитьМестаИспользованияПодсчетомЗапросами(Результат, МассивСсылок, ИсключатьПомеченныеНаУдаление = Ложь)
	
	МенеджерВТ = СоздатьМенеджерВременныхТаблицЭлементов(МассивСсылок);
	ТекстыЗапроса = ТекстыЗапросовПодсчетаСсылок(ИсключатьПомеченныеНаУдаление);
	ИтогиПодсчета = Новый Соответствие;
	
	ВыполнитьТекстыПодсчетаСсылок(ТекстыЗапроса, МенеджерВТ, ИтогиПодсчета);
	ВыгрузитьИтогиПодсчетаВТаблицу(ИтогиПодсчета, Результат);
	
КонецПроцедуры

Функция СоздатьМенеджерВременныхТаблицЭлементов(МассивСсылок)
	
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка." + ИмяАнализируемогоСправочника()));
	Для Каждого Ссылка Из МассивСсылок Цикл
		ТаблицаСсылок.Добавить().Ссылка = Ссылка;
	КонецЦикла;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаСсылок", ТаблицаСсылок);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаСсылок.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ нп_ВТЭлементыСправочника
		|ИЗ
		|	&ТаблицаСсылок КАК ТаблицаСсылок
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка";
	Запрос.Выполнить();
	
	Возврат МенеджерВТ;
	
КонецФункции

Функция ТекстыЗапросовПодсчетаСсылок(ИсключатьПомеченныеНаУдаление = Ложь)
	
	ТекстыЗапроса = Новый Массив;
	ТипСсылки = ТипЗнч(Справочники[ИмяАнализируемогоСправочника()].ПустаяСсылка());
	ИсключенияПоиска = ИсключенияПоискаСсылокОтчета();
	
	Для Каждого КоллекцияМетаданных Из КоллекцииМетаданныхДляПоискаСсылок() Цикл
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
			ДобавитьТекстыПоОбъектуМетаданных(
				ОбъектМетаданных,
				ТипСсылки,
				ИсключенияПоиска,
				ТекстыЗапроса,
				ИсключатьПомеченныеНаУдаление);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ОбъектМетаданных Из Метаданные.Константы Цикл
		ДобавитьТекстыПоКонстанте(ОбъектМетаданных, ТипСсылки, ИсключенияПоиска, ТекстыЗапроса);
	КонецЦикла;
	
	Возврат ТекстыЗапроса;
	
КонецФункции

Функция КоллекцииМетаданныхДляПоискаСсылок()
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники);
	Результат.Добавить(Метаданные.Документы);
	Результат.Добавить(Метаданные.ПланыВидовХарактеристик);
	Результат.Добавить(Метаданные.ПланыСчетов);
	Результат.Добавить(Метаданные.ПланыВидовРасчета);
	Результат.Добавить(Метаданные.БизнесПроцессы);
	Результат.Добавить(Метаданные.Задачи);
	Результат.Добавить(Метаданные.РегистрыСведений);
	Результат.Добавить(Метаданные.РегистрыНакопления);
	Результат.Добавить(Метаданные.РегистрыБухгалтерии);
	Результат.Добавить(Метаданные.РегистрыРасчета);
	
	Возврат Результат;
	
КонецФункции

Функция ОбластьПоискаСсылок()
	
	Результат = Новый Массив;
	ИсключенияПоиска = ИсключенияПоискаСсылокОтчета();
	
	Для Каждого КоллекцияМетаданных Из КоллекцииМетаданныхДляПоискаСсылок() Цикл
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
			Если ИсключенияПоиска.Получить(ОбъектМетаданных) = "*" Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ОбъектМетаданных Из Метаданные.Константы Цикл
		Если ИсключенияПоиска.Получить(ОбъектМетаданных) = "*" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(ОбъектМетаданных);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИсключенияПоискаСсылокОтчета()
	
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.ИсключенияПоискаСсылок();
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;
	
КонецФункции

Процедура ДобавитьТекстыПоОбъектуМетаданных(ОбъектМетаданных, ТипСсылки, ИсключенияПоиска, ТекстыЗапроса, ИсключатьПомеченныеНаУдаление = Ложь)
	
	ИсключениеПоиска = ИсключенияПоиска.Получить(ОбъектМетаданных);
	Если ИсключениеПоиска = "*" Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Представление = ПредставлениеОбъектаМетаданных(ОбъектМетаданных);
	
	ДобавитьТекстыПоИмениКоллекции(
		ОбъектМетаданных,
		"СтандартныеРеквизиты",
		ПолноеИмя,
		"",
		ТипСсылки,
		ИсключениеПоиска,
		ПолноеИмя,
		Представление,
		ТекстыЗапроса,
		ИсключатьПомеченныеНаУдаление);
	ДобавитьТекстыПоИмениКоллекции(
		ОбъектМетаданных,
		"Реквизиты",
		ПолноеИмя,
		"",
		ТипСсылки,
		ИсключениеПоиска,
		ПолноеИмя,
		Представление,
		ТекстыЗапроса,
		ИсключатьПомеченныеНаУдаление);
	ДобавитьТекстыПоИмениКоллекции(
		ОбъектМетаданных,
		"Измерения",
		ПолноеИмя,
		"",
		ТипСсылки,
		ИсключениеПоиска,
		ПолноеИмя,
		Представление,
		ТекстыЗапроса,
		ИсключатьПомеченныеНаУдаление);
	ДобавитьТекстыПоИмениКоллекции(
		ОбъектМетаданных,
		"Ресурсы",
		ПолноеИмя,
		"",
		ТипСсылки,
		ИсключениеПоиска,
		ПолноеИмя,
		Представление,
		ТекстыЗапроса,
		ИсключатьПомеченныеНаУдаление);
	
	Попытка
		ТабличныеЧасти = ОбъектМетаданных.ТабличныеЧасти;
	Исключение
		ТабличныеЧасти = Неопределено;
	КонецПопытки;
	
	Если ТабличныеЧасти <> Неопределено Тогда
		
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			
			ИмяТаблицы = ПолноеИмя + "." + ТабличнаяЧасть.Имя;
			ДобавитьТекстыПоИмениКоллекции(
				ТабличнаяЧасть,
				"СтандартныеРеквизиты",
				ИмяТаблицы,
				ТабличнаяЧасть.Имя,
				ТипСсылки,
				ИсключениеПоиска,
				ПолноеИмя,
				Представление,
				ТекстыЗапроса,
				ИсключатьПомеченныеНаУдаление);
			ДобавитьТекстыПоИмениКоллекции(
				ТабличнаяЧасть,
				"Реквизиты",
				ИмяТаблицы,
				ТабличнаяЧасть.Имя,
				ТипСсылки,
				ИсключениеПоиска,
				ПолноеИмя,
				Представление,
				ТекстыЗапроса,
				ИсключатьПомеченныеНаУдаление);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДобавитьТекстыСубконтоРегистраБухгалтерии(
		ОбъектМетаданных,
		ПолноеИмя,
		ИсключениеПоиска,
		Представление,
		ТекстыЗапроса);
	
КонецПроцедуры

Процедура ДобавитьТекстыПоКонстанте(ОбъектМетаданных, ТипСсылки, ИсключенияПоиска, ТекстыЗапроса)
	
	Если ИсключенияПоиска.Получить(ОбъектМетаданных) = "*" Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбъектМетаданных.Тип.СодержитТип(ТипСсылки) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьТекстЗапросаПодсчета(
		ТекстыЗапроса,
		ОбъектМетаданных.ПолноеИмя(),
		"Значение",
		ОбъектМетаданных.ПолноеИмя(),
		ПредставлениеОбъектаМетаданных(ОбъектМетаданных));
	
КонецПроцедуры

Процедура ДобавитьТекстыСубконтоРегистраБухгалтерии(ОбъектМетаданных, ПолноеИмя, ИсключениеПоиска, Представление, ТекстыЗапроса)
	
	Если Не СтрНачинаетсяС(ПолноеИмя, "РегистрБухгалтерии.") Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		МаксКоличествоСубконто = ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто;
	Исключение
		Возврат;
	КонецПопытки;
	
	Для НомерСубконто = 1 По МаксКоличествоСубконто Цикл
		
		ИмяПоля = "Субконто" + Формат(НомерСубконто, "ЧГ=0");
		Если ПолеИсключеноИзПоиска(ИсключениеПоиска, ИмяПоля, "") Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьТекстЗапросаПодсчета(ТекстыЗапроса, ПолноеИмя, ИмяПоля, ПолноеИмя, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТекстыПоИмениКоллекции(ВладелецКоллекции, ИмяКоллекции, ИмяТаблицы, ИмяТабличнойЧасти, ТипСсылки, ИсключениеПоиска, ПолноеИмяМетаданных, ПредставлениеМетаданных, ТекстыЗапроса, ИсключатьПомеченныеНаУдаление = Ложь)
	
	Попытка
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			КоллекцияРеквизитов = ВладелецКоллекции.СтандартныеРеквизиты;
		ИначеЕсли ИмяКоллекции = "Реквизиты" Тогда
			КоллекцияРеквизитов = ВладелецКоллекции.Реквизиты;
		ИначеЕсли ИмяКоллекции = "Измерения" Тогда
			КоллекцияРеквизитов = ВладелецКоллекции.Измерения;
		ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
			КоллекцияРеквизитов = ВладелецКоллекции.Ресурсы;
		Иначе
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
	ДобавитьТекстыПоКоллекцииРеквизитов(
		КоллекцияРеквизитов,
		ИмяТаблицы,
		ИмяТабличнойЧасти,
		ТипСсылки,
		ИсключениеПоиска,
		ПолноеИмяМетаданных,
		ПредставлениеМетаданных,
		ТекстыЗапроса,
		ИсключатьПомеченныеНаУдаление);
	
КонецПроцедуры

Процедура ДобавитьТекстыПоКоллекцииРеквизитов(КоллекцияРеквизитов, ИмяТаблицы, ИмяТабличнойЧасти, ТипСсылки, ИсключениеПоиска, ПолноеИмяМетаданных, ПредставлениеМетаданных, ТекстыЗапроса, ИсключатьПомеченныеНаУдаление = Ложь)
	
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		
		Если Реквизит.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолеИсключеноИзПоиска(ИсключениеПоиска, Реквизит.Имя, ИмяТабличнойЧасти) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПолеСодержитТипСсылки(Реквизит, ТипСсылки) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьТекстЗапросаПодсчета(
			ТекстыЗапроса,
			ИмяТаблицы,
			Реквизит.Имя,
			ПолноеИмяМетаданных,
			ПредставлениеМетаданных,
			ИсключатьПомеченныеНаУдаление);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолеСодержитТипСсылки(Реквизит, ТипСсылки)
	
	Попытка
		Возврат Реквизит.Тип.СодержитТип(ТипСсылки);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПолеИсключеноИзПоиска(ИсключениеПоиска, ИмяПоля, ИмяТабличнойЧасти)
	
	Если ИсключениеПоиска = Неопределено Или ИсключениеПоиска = "*" Тогда
		Возврат ИсключениеПоиска = "*";
	КонецЕсли;
	
	Если ИсключениеПоиска.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяТабличнойЧасти)
		И ИсключениеПоиска.Найти(ИмяТабличнойЧасти + "." + ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьТекстЗапросаПодсчета(ТекстыЗапроса, ИмяТаблицы, ИмяПоля, ПолноеИмяМетаданных, ПредставлениеМетаданных, ИсключатьПомеченныеНаУдаление = Ложь)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т." + ИмяПоля + " КАК ЭлементСправочника,
		|	КОЛИЧЕСТВО(*) КАК КоличествоСсылок,
		|	" + СтрокаДляТекстаЗапроса(ПолноеИмяМетаданных) + " КАК ИмяМетаданных,
		|	" + СтрокаДляТекстаЗапроса(ПредставлениеМетаданных) + " КАК ТипМетаданных
		|ИЗ
		|	" + ИмяТаблицы + " КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ нп_ВТЭлементыСправочника КАК нп_ВТЭлементыСправочника
		|		ПО Т." + ИмяПоля + " = нп_ВТЭлементыСправочника.Ссылка
		|";
	
	Если НуженОтборПометкиУдаленияСсылающихся(ПолноеИмяМетаданных, ИсключатьПомеченныеНаУдаление) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	Т.Ссылка.ПометкаУдаления = ЛОЖЬ
		|";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|СГРУППИРОВАТЬ ПО
		|	Т." + ИмяПоля;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Функция НуженОтборПометкиУдаленияСсылающихся(ПолноеИмяМетаданных, ИсключатьПомеченныеНаУдаление)
	
	Если Не ИсключатьПомеченныеНаУдаление Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.Документы.Содержит(ОбъектМетаданных);
	
КонецФункции

Функция СтрокаДляТекстаЗапроса(Значение)
	
	Возврат """" + СтрЗаменить(Строка(Значение), """", """""") + """";
	
КонецФункции

Функция ПредставлениеОбъектаМетаданных(ОбъектМетаданных)
	
	Представление = ОбъектМетаданных.Представление();
	Если ПустаяСтрока(Представление) Тогда
		Возврат ОбъектМетаданных.Имя;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Процедура ВыполнитьТекстыПодсчетаСсылок(ТекстыЗапроса, МенеджерВТ, ИтогиПодсчета)
	
	РазмерПакета = 8;
	КоличествоТекстов = ТекстыЗапроса.Количество();
	Индекс = 0;
	
	Пока Индекс < КоличествоТекстов Цикл
		
		ПакетТекстов = Новый Массив;
		Граница = Мин(Индекс + РазмерПакета, КоличествоТекстов);
		
		Пока Индекс < Граница Цикл
			ПакетТекстов.Добавить(ТекстыЗапроса[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		
		ВыполнитьПакетПодсчетаСсылок(ПакетТекстов, МенеджерВТ, ИтогиПодсчета);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПакетПодсчетаСсылок(ПакетТекстов, МенеджерВТ, ИтогиПодсчета)
	
	Если ПакетТекстов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = СтрСоединить(ПакетТекстов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Если ПакетТекстов.Количество() = 1 Тогда
			Возврат;
		КонецЕсли;
		Середина = Цел(ПакетТекстов.Количество() / 2);
		ПерваяПоловина = Новый Массив;
		ВтораяПоловина = Новый Массив;
		Для Индекс = 0 По ПакетТекстов.Количество() - 1 Цикл
			Если Индекс < Середина Тогда
				ПерваяПоловина.Добавить(ПакетТекстов[Индекс]);
			Иначе
				ВтораяПоловина.Добавить(ПакетТекстов[Индекс]);
			КонецЕсли;
		КонецЦикла;
		ВыполнитьПакетПодсчетаСсылок(ПерваяПоловина, МенеджерВТ, ИтогиПодсчета);
		ВыполнитьПакетПодсчетаСсылок(ВтораяПоловина, МенеджерВТ, ИтогиПодсчета);
		Возврат;
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		ДобавитьИтогПодсчетаСсылок(ИтогиПодсчета, Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИтогПодсчетаСсылок(ИтогиПодсчета, Выборка)
	
	ИтогиПоЭлементу = ИтогиПодсчета.Получить(Выборка.ЭлементСправочника);
	Если ИтогиПоЭлементу = Неопределено Тогда
		ИтогиПоЭлементу = Новый Соответствие;
		ИтогиПодсчета.Вставить(Выборка.ЭлементСправочника, ИтогиПоЭлементу);
	КонецЕсли;
	
	ДанныеТипа = ИтогиПоЭлементу.Получить(Выборка.ИмяМетаданных);
	Если ДанныеТипа = Неопределено Тогда
		ДанныеТипа = Новый Структура("Количество, Представление", 0, Выборка.ТипМетаданных);
		ИтогиПоЭлементу.Вставить(Выборка.ИмяМетаданных, ДанныеТипа);
	КонецЕсли;
	
	ДанныеТипа.Количество = ДанныеТипа.Количество + Выборка.КоличествоСсылок;
	
КонецПроцедуры

Процедура ВыгрузитьИтогиПодсчетаВТаблицу(ИтогиПодсчета, Результат)
	
	Для Каждого ИтогПоЭлементу Из ИтогиПодсчета Цикл
		
		Для Каждого ИтогПоТипу Из ИтогПоЭлементу.Значение Цикл
			
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.ЭлементСправочника = ИтогПоЭлементу.Ключ;
			НоваяСтрока.ТипЗначения = ИтогПоТипу.Значение.Представление;
			НоваяСтрока.ИмяТипаЗначения = ИтогПоТипу.Ключ;
			НоваяСтрока.КоличествоСсылок = ИтогПоТипу.Значение.Количество;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеТипаЗначения(СтрокаНайденных)
	
	Если ТипЗнч(СтрокаНайденных.Метаданные) = Тип("ОбъектМетаданных") Тогда
		Возврат СтрокаНайденных.Метаданные.Представление();
	КонецЕсли;
	
	Возврат Строка(ТипЗнч(СтрокаНайденных.Данные));
	
КонецФункции

Функция ИмяТипаЗначения(СтрокаНайденных)
	
	Если ТипЗнч(СтрокаНайденных.Метаданные) = Тип("ОбъектМетаданных") Тогда
		Возврат СтрокаНайденных.Метаданные.ПолноеИмя();
	КонецЕсли;
	
	Возврат Строка(ТипЗнч(СтрокаНайденных.Данные));
	
КонецФункции

Функция НовыйТаблицаМестИспользования()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЭлементСправочника");
	Результат.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("ИмяТипаЗначения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("СсылающийсяОбъект");
	Результат.Колонки.Добавить("ПредставлениеСсылки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("КоличествоСсылок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	
	Возврат Результат;
	
КонецФункции

Процедура ОставитьЭлементыПоДопустимымТипамСсылок(ЭлементыСправочника, МестаИспользования, Настройки, ПользовательскиеНастройки)
	
	ДопустимыеИмена = ДопустимыеИменаТиповСсылокИзНастроек(Настройки, ПользовательскиеНастройки);
	Если ДопустимыеИмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипыПоЭлементам = ТипыСсылокПоЭлементам(МестаИспользования);
	ОставляемыеСсылки = Новый Соответствие;
	ИсходноеКоличество = ЭлементыСправочника.Количество();
	
	Для Каждого СтрокаЭлемента Из ЭлементыСправочника Цикл
		
		Если ЭлементСоответствуетДопустимымТипамСсылок(
			ТипыПоЭлементам.Получить(СтрокаЭлемента.Ссылка),
			ДопустимыеИмена) Тогда
			ОставляемыеСсылки.Вставить(СтрокаЭлемента.Ссылка, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьСтрокиНеизОставляемыхСсылок(ЭлементыСправочника, "Ссылка", ОставляемыеСсылки);
	УдалитьСтрокиНеизОставляемыхСсылок(МестаИспользования, "ЭлементСправочника", ОставляемыеСсылки);
	
	Если ИсходноеКоличество <> ЭлементыСправочника.Количество() Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Отобраны элементы, у которых есть ссылки помимо указанных типов: %1 из %2.'"),
			Формат(ЭлементыСправочника.Количество(), "ЧГ=0"),
			Формат(ИсходноеКоличество, "ЧГ=0"));
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТипыСсылокПоЭлементам(МестаИспользования)
	
	ТипыПоЭлементам = Новый Соответствие;
	
	Для Каждого СтрокаМест Из МестаИспользования Цикл
		
		ТипыЭлемента = ТипыПоЭлементам.Получить(СтрокаМест.ЭлементСправочника);
		Если ТипыЭлемента = Неопределено Тогда
			ТипыЭлемента = Новый Массив;
			ТипыПоЭлементам.Вставить(СтрокаМест.ЭлементСправочника, ТипыЭлемента);
		КонецЕсли;
		
		ОписаниеТипа = Новый Структура("Имя, Представление");
		ОписаниеТипа.Имя = СтрокаМест.ИмяТипаЗначения;
		ОписаниеТипа.Представление = СтрокаМест.ТипЗначения;
		ТипыЭлемента.Добавить(ОписаниеТипа);
		
	КонецЦикла;
	
	Возврат ТипыПоЭлементам;
	
КонецФункции

Функция ЭлементСоответствуетДопустимымТипамСсылок(ТипыЭлемента, ДопустимыеИмена)
	
	Если ТипыЭлемента = Неопределено Или ТипыЭлемента.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ОписаниеТипа Из ТипыЭлемента Цикл
		
		Если Не ТипСсылкиДопустим(ОписаниеТипа, ДопустимыеИмена) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТипСсылкиДопустим(ОписаниеТипа, ДопустимыеИмена)
	
	Если ИмяТипаВСписке(ОписаниеТипа.Имя, ДопустимыеИмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ИмяТипаВСписке(ОписаниеТипа.Представление, ДопустимыеИмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	КороткоеИмя = КороткоеИмяТипаМетаданных(ОписаниеТипа.Имя);
	Если ИмяТипаВСписке(КороткоеИмя, ДопустимыеИмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ИмяТипаВСписке(ИмяТипа, ДопустимыеИмена)
	
	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДопустимыеИмена.Получить(НормализованноеИмяТипа(ИмяТипа)) = Истина;
	
КонецФункции

Функция НормализованноеИмяТипа(ИмяТипа)
	
	Возврат ВРег(СокрЛП(Строка(ИмяТипа)));
	
КонецФункции

Функция КороткоеИмяТипаМетаданных(ПолноеИмя)
	
	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиИмени = СтрРазделить(Строка(ПолноеИмя), ".");
	Если ЧастиИмени.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастиИмени[ЧастиИмени.Количество() - 1];
	
КонецФункции

Процедура ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, Ключ)
	
	НормализованноеИмя = НормализованноеИмяТипа(Ключ);
	Если Не ПустаяСтрока(НормализованноеИмя) Тогда
		ДопустимыеИмена.Вставить(НормализованноеИмя, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКлючиОбъектаМетаданных(ДопустимыеИмена, ОбъектМетаданных)
	
	ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, ОбъектМетаданных.ПолноеИмя());
	ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, ОбъектМетаданных.Имя);
	ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, ОбъектМетаданных.Представление());
	
	Попытка
		ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, ОбъектМетаданных.Синоним);
	Исключение
		// У части объектов метаданных синоним недоступен.
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьСтрокиНеизОставляемыхСсылок(Таблица, ИмяКолонки, ОставляемыеСсылки)
	
	Индекс = Таблица.Количество();
	Пока Индекс > 0 Цикл
		
		Индекс = Индекс - 1;
		Если ОставляемыеСсылки.Получить(Таблица[Индекс][ИмяКолонки]) <> Истина Тогда
			Таблица.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДопустимыеИменаТиповСсылокИзНастроек(Настройки, ПользовательскиеНастройки)
	
	ОписаниеПараметра = ОписаниеПараметраКомпоновки(Настройки, ПользовательскиеНастройки, "ДопустимыеТипыСсылок");
	Если Не ОписаниеПараметра.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДопустимыеИмена = Новый Соответствие;
	ДобавитьЗначенияДопустимыхТипов(ДопустимыеИмена, ОписаниеПараметра.Значение);
	
	Возврат ДопустимыеИмена;
	
КонецФункции

Процедура ДобавитьЗначенияДопустимыхТипов(ДопустимыеИмена, Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементСписка Из Значение Цикл
			ДобавитьЗначенияДопустимыхТипов(ДопустимыеИмена, ЭлементСписка.Значение);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из Значение Цикл
			ДобавитьЗначенияДопустимыхТипов(ДопустимыеИмена, ЭлементМассива);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, Значение);
		Возврат;
	КонецЕсли;
	
	Если ТипЗначения = Тип("ОбъектМетаданных") Тогда
		ДобавитьКлючиОбъектаМетаданных(ДопустимыеИмена, Значение);
		Возврат;
	КонецЕсли;
	
	ДобавитьИмяПоИдентификаторуМетаданных(ДопустимыеИмена, Значение);
	
КонецПроцедуры

Процедура ДобавитьИмяПоИдентификаторуМетаданных(ДопустимыеИмена, Идентификатор)
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") <> Неопределено Тогда
		
		Попытка
			ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Идентификатор, Ложь);
		Исключение
			ОбъектМетаданных = Неопределено;
		КонецПопытки;
		
		Если ТипЗнч(ОбъектМетаданных) = Тип("ОбъектМетаданных") Тогда
			ДобавитьКлючиОбъектаМетаданных(ДопустимыеИмена, ОбъектМетаданных);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПолноеИмя = ПолноеИмяИдентификатораМетаданных(Идентификатор);
	Если Не ПустаяСтрока(ПолноеИмя) Тогда
		ДобавитьКлючИгнорируемогоТипа(ДопустимыеИмена, ПолноеИмя);
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМетаданных <> Неопределено Тогда
			ДобавитьКлючиОбъектаМетаданных(ДопустимыеИмена, ОбъектМетаданных);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолноеИмяИдентификатораМетаданных(Идентификатор)
	
	ИмяСправочника = ИмяСправочникаИдентификаторов(Идентификатор);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Идентификаторы.ПолноеИмя КАК ПолноеИмя
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Идентификаторы
		|ГДЕ
		|	Идентификаторы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Идентификатор);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.ПолноеИмя);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИмяСправочникаИдентификаторов(Идентификатор)
	
	Если Метаданные.Справочники.Найти("ИдентификаторыОбъектовМетаданных") <> Неопределено
		И ТипЗнч(Идентификатор) = ТипЗнч(Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка()) Тогда
		Возврат "ИдентификаторыОбъектовМетаданных";
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("ИдентификаторыОбъектовРасширений") <> Неопределено
		И ТипЗнч(Идентификатор) = ТипЗнч(Справочники.ИдентификаторыОбъектовРасширений.ПустаяСсылка()) Тогда
		Возврат "ИдентификаторыОбъектовРасширений";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОписаниеПараметраКомпоновки(НастройкиКД, ПользовательскиеНастройкиКД, ИмяПараметра)
	
	Результат = Новый Структура("Использование, Значение", Ложь, Неопределено);
	Параметр = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	
	Если ПользовательскиеНастройкиКД <> Неопределено Тогда
		Для Каждого ЭлементНастройки Из ПользовательскиеНастройкиКД.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных")
				И ЭлементНастройки.Параметр = Параметр Тогда
				Результат.Использование = ЭлементНастройки.Использование;
				Результат.Значение = ЭлементНастройки.Значение;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НастройкиКД <> Неопределено Тогда
		ЗначениеПараметра = НастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Параметр);
		Если ЗначениеПараметра <> Неопределено Тогда
			Результат.Использование = ЗначениеПараметра.Использование;
			Результат.Значение = ЗначениеПараметра.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЛимитЭлементовИзНастроек(НастройкиКД, ПользовательскиеНастройкиКД = Неопределено)
	
	ЗначениеПараметра = ЗначениеПараметраКомпоновки(НастройкиКД, ПользовательскиеНастройкиКД, "ЛимитЭлементов");
	Если ТипЗнч(ЗначениеПараметра) = Тип("Число") И ЗначениеПараметра > 0 Тогда
		Возврат ЗначениеПараметра;
	КонецЕсли;
	
	Возврат 1000;
	
КонецФункции

Функция ЗначениеПараметраКомпоновки(НастройкиКД, ПользовательскиеНастройкиКД, ИмяПараметра)
	
	Параметр = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	
	Если ПользовательскиеНастройкиКД <> Неопределено Тогда
		Для Каждого ЭлементНастройки Из ПользовательскиеНастройкиКД.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных")
				И ЭлементНастройки.Параметр = Параметр Тогда
				Возврат ЭлементНастройки.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НастройкиКД <> Неопределено Тогда
		ЗначениеПараметра = НастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Параметр);
		Если ЗначениеПараметра <> Неопределено Тогда
			Возврат ЗначениеПараметра.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

