		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1000
	Справочник.Ссылка КАК Ссылка,
	Справочник.Код КАК Код,
	Справочник.Наименование КАК Наименование,
	Справочник.тн_ЯвляетсяОбъектомЦБ КАК тн_ЯвляетсяОбъектомЦБ,
	Справочник.ПометкаУдаления КАК ПометкаУдаления,
	Справочник.ЭтоГруппа КАК ЭтоГруппа,
	Справочник.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
ИЗ
	Справочник.Номенклатура КАК Справочник
{ГДЕ
	Справочник.Ссылка.* КАК Ссылка,
	Справочник.Код КАК Код,
	Справочник.Наименование КАК Наименование,
	Справочник.тн_ЯвляетсяОбъектомЦБ КАК тн_ЯвляетсяОбъектомЦБ,
	Справочник.ПометкаУдаления КАК ПометкаУдаления,
	Справочник.ЭтоГруппа КАК ЭтоГруппа,
	Справочник.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
}
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.Номенклатура)
	ВИДЫХАРАКТЕРИСТИК (ВЫБРАТЬ
		Свойства.Свойство КАК Свойство,
		Свойства.Свойство.Заголовок КАК Наименование,
		Свойства.Свойство.ТипЗначения КАК ТипЗначения
	ИЗ
		(ВЫБРАТЬ РАЗЛИЧНЫЕ
			Наборы.Свойство КАК Свойство
		ИЗ
			Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
		ГДЕ
			НЕ Наборы.ПометкаУдаления
			И (Наборы.ИмяПредопределенногоНабора = "Справочник_Номенклатура"
				ИЛИ Наборы.Ссылка В
					(ВЫБРАТЬ
						ВидыНоменклатуры.НаборСвойств
					ИЗ
						Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры))) КАК Свойства)
	ПОЛЕКЛЮЧА Свойство
	ПОЛЕИМЕНИ Наименование
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК (ВЫБРАТЬ
		ДополнительныеРеквизиты.Ссылка КАК Ссылка,
		ДополнительныеРеквизиты.Свойство КАК Свойство,
		ДополнительныеРеквизиты.Значение КАК Значение
	ИЗ
		Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты)
	ПОЛЕОБЪЕКТА Ссылка
	ПОЛЕВИДА Свойство
	ПОЛЕЗНАЧЕНИЯ Значение }</query>
