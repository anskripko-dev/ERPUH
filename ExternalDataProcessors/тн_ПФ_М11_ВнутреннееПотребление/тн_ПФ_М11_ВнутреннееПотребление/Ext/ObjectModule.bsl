#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.359");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.0.5";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Требование-накладная М-11 (внешняя)'");
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Внешняя печатная форма М-11 для документа «Внутреннее потребление» с операцией «Списание на расходы» (ERP.2026.9).'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Назначение.Добавить("Документ.ВнутреннееПотребление");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Требование-накладная М-11 (внешняя)'");
	Команда.Идентификатор = "М11Внешняя";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;
	Команда.Модификатор = "ПечатьMXL";
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// СтандартныеПодсистемы.Печать

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ВнутреннееПотребление
//  КоллекцияПечатныхФорм - ТаблицаЗначений
//  ОбъектыПечати - СписокЗначений
//  ПараметрыВывода - Структура
//
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "М11Внешняя");
	Если ПечатнаяФорма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// ERP.2026.9: фильтр по операции (в типовой Обработка.ПечатьМ11 — без отбора).
	ОбъектыКПечати = ОбъектыСписанияНаРасходы(МассивОбъектов);
	Если ОбъектыКПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПечатнаяФорма.ТабличныйДокумент = СформироватьПечатнуюФормуМ11(ОбъектыКПечати, ОбъектыПечати);
	ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Требование-накладная М-11 (внешняя)'");
	// ERP.2026.9: макет во внешней обработке (в типовой — "Обработка.ПечатьМ11.ПФ_MXL_М11").
	ПечатнаяФорма.ПолныйПутьКМакету = "";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// Не из типовой. Точка входа для отладки печати по одному документу (ERP.2026.9).
//
Функция ПечатнаяФормаДокумента(ДокументСсылка) Экспорт
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокументСсылка);
	
	ОбъектыКПечати = ОбъектыСписанияНаРасходы(МассивОбъектов);
	Если ОбъектыКПечати.Количество() = 0 Тогда
		Возврат Новый ТабличныйДокумент;
	КонецЕсли;
	
	ОбъектыПечати = Новый СписокЗначений;
	Возврат СформироватьПечатнуюФормуМ11(ОбъектыКПечати, ОбъектыПечати);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Не из типовой. Фильтр документов по операции «Списание на расходы» (ERP.2026.9).
//
Функция ОбъектыСписанияНаРасходы(МассивОбъектов)
	
	Результат = Новый Массив;
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивОбъектов, "ХозяйственнаяОперация");
	ОперацияСписаниеНаРасходы = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	ШаблонСообщения = НСтр(
		"ru = 'Печатная форма «Требование-накладная М-11 (внешняя)» доступна только для операции «Списание на расходы». Документ %1 пропущен.'");
	
	Для Каждого СсылкаДокумента Из МассивОбъектов Цикл
		
		ХозяйственнаяОперация = ЗначенияОпераций.Получить(СсылкаДокумента);
		Если ХозяйственнаяОперация = ОперацияСписаниеНаРасходы Тогда
			Результат.Добавить(СсылкаДокумента);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаДокумента),
				СсылкаДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// На базе Обработка.ПечатьМ11.СформироватьПечатнуюФормуМ11.
//
// Отличия от типовой:
//  - только Документ.ВнутреннееПотребление (без обхода СтруктураТипов / локализации менеджера);
//  - дополнительно собираются ДополнительныеДанныеДокументов (подписи, примечание, комиссия);
//  - имя параметров печати: ПАРАМЕТРЫ_ПЕЧАТИ_М11_Внешняя.
//
Функция СформироватьПечатнуюФормуМ11(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	// ERP.2026.9: своё имя параметров печати (в типовой — ПАРАМЕТРЫ_ПЕЧАТИ_М11).
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_М11_Внешняя";
	
	ПараметрыПечати = Новый Структура;
	// ERP.2026.9: сразу данные ВП (в типовой — цикл по СтруктураТипов и менеджер локализации).
	ДанныеДляПечати = ВнутреннееПотреблениеЛокализация.ПолучитьДанныеДляПечатнойФормыМ11(
		ПараметрыПечати,
		МассивОбъектов);
	
	// ERP.2026.9: доп. данные для подписей / примечания / комиссии (в типовой нет).
	ДопДанныеПоДокументам = ДополнительныеДанныеДокументов(МассивОбъектов);
	
	ЗаполнитьТабличныйДокументМ11(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДопДанныеПоДокументам);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Не из типовой. Данные для подписей, примечания и комиссии (ERP.2026.9).
//
Функция ДополнительныеДанныеДокументов(МассивОбъектов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата,
	|	Документы.Организация КАК Организация,
	|	Документы.Подразделение КАК Подразделение,
	|	Документы.Склад КАК Склад,
	|	Документы.тн_ОтветственныйСотрудник КАК ОтветственныйСотрудник,
	|	Документы.тн_Затребовал КАК Затребовал
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ВнутреннееПотребление КАК Документы
	|ГДЕ
	|	Документы.Ссылка В (&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура) КАК НоменклатураПредставление,
	|	Товары.СтатьяРасходов КАК СтатьяСписания,
	|	ПРЕДСТАВЛЕНИЕ(Товары.СтатьяРасходов) КАК СтатьяСписанияПредставление,
	|	Товары.АналитикаРасходов КАК АналитикаРасходов,
	|	Товары.АналитикаАктивовПассивов КАК АналитикаАктивовПассивов,
	|	ПРЕДСТАВЛЕНИЕ(Товары.АналитикаРасходов) КАК АналитикаРасходовПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Товары.АналитикаАктивовПассивов) КАК АналитикаАктивовПассивовПредставление
	|ИЗ
	|	Документ.ВнутреннееПотребление.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДокументы.Ссылка КАК Ссылка,
	|	ВТДокументы.Дата КАК Дата,
	|	ВТДокументы.Организация КАК Организация,
	|	ВТДокументы.Подразделение КАК Подразделение,
	|	ВТДокументы.Склад КАК Склад,
	|	ВТДокументы.ОтветственныйСотрудник КАК ОтветственныйСотрудник,
	|	ВТДокументы.Затребовал КАК Затребовал
	|ИЗ
	|	ВТДокументы КАК ВТДокументы";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаТоваров = Результаты[Результаты.ВГраница() - 1].Выгрузить();
	ТаблицаТоваров.Индексы.Добавить("Ссылка");
	
	ВыборкаШапка = Результаты[Результаты.ВГраница()].Выбрать();
	Пока ВыборкаШапка.Следующий() Цикл
		
		НайденныеСтрокиТоваров = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
		СтрокиТоваров = Новый Массив;
		Для Каждого СтрокаТовара Из НайденныеСтрокиТоваров Цикл
			АналитикаПредставление = "";
			Если ЗначениеЗаполнено(СтрокаТовара.АналитикаРасходов) Тогда
				АналитикаПредставление = Строка(СтрокаТовара.АналитикаРасходовПредставление);
			ИначеЕсли ЗначениеЗаполнено(СтрокаТовара.АналитикаАктивовПассивов) Тогда
				АналитикаПредставление = Строка(СтрокаТовара.АналитикаАктивовПассивовПредставление);
			КонецЕсли;
			СтрокаДляПечати = Новый Структура;
			СтрокаДляПечати.Вставить("НоменклатураПредставление", Строка(СтрокаТовара.НоменклатураПредставление));
			СтрокаДляПечати.Вставить("СтатьяСписанияПредставление", Строка(СтрокаТовара.СтатьяСписанияПредставление));
			СтрокаДляПечати.Вставить("АналитикаПредставление", АналитикаПредставление);
			СтрокиТоваров.Добавить(СтрокаДляПечати);
		КонецЦикла;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Дата", ВыборкаШапка.Дата);
		ДанныеДокумента.Вставить("Организация", ВыборкаШапка.Организация);
		ДанныеДокумента.Вставить("Подразделение", ВыборкаШапка.Подразделение);
		ДанныеДокумента.Вставить("Склад", ВыборкаШапка.Склад);
		ДанныеДокумента.Вставить("ОтветственныйСотрудник", ВыборкаШапка.ОтветственныйСотрудник);
		ДанныеДокумента.Вставить("Затребовал", ВыборкаШапка.Затребовал);
		ДанныеДокумента.Вставить("Товары", СтрокиТоваров);
		ДанныеДокумента.Вставить("ДолжностьОтветственного",
			ДолжностьФизЛица(ВыборкаШапка.ОтветственныйСотрудник, ВыборкаШапка.Организация));
		ДанныеДокумента.Вставить("ДолжностьЗатребовал",
			ДолжностьФизЛица(ВыборкаШапка.Затребовал, ВыборкаШапка.Организация));
		ДанныеДокумента.Вставить("Разрешил",
			РуководительОрганизации(ВыборкаШапка.Организация, ВыборкаШапка.Дата));
		ДанныеДокумента.Вставить("Комиссия",
			ДанныеКомиссии(
				ВыборкаШапка.Организация,
				ВыборкаШапка.Подразделение,
				ВыборкаШапка.Склад,
				ВыборкаШапка.Дата));
		
		Результат.Вставить(ВыборкаШапка.Ссылка, ДанныеДокумента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Не из типовой. Должность для подписей по ТЗ (ERP.2026.9).
//
Функция ДолжностьФизЛица(ФизическоеЛицо, Организация)
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПРЕДСТАВЛЕНИЕ(ТекущиеКадровыеДанные.ТекущаяДолжность) КАК Должность
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанные
	|ГДЕ
	|	ТекущиеКадровыеДанные.ФизическоеЛицо = &ФизическоеЛицо
	|	И ТекущиеКадровыеДанные.ТекущаяДолжность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|	И (&Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		ИЛИ ТекущиеКадровыеДанные.ТекущаяОрганизация = &Организация
	|		ИЛИ ТекущиеКадровыеДанные.ГоловнаяОрганизация = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТекущиеКадровыеДанные.ОсновноеРабочееМестоВОрганизации УБЫВ,
	|	ТекущиеКадровыеДанные.ДатаПриема УБЫВ";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Должность));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Не из типовой. Руководитель организации для «Разрешил» (ERP.2026.9).
//
Функция РуководительОрганизации(Организация, ДатаДокумента)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ОтветственныеЛица = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Организация, ДатаДокумента);
		Если ЗначениеЗаполнено(ОтветственныеЛица.Руководитель) Тогда
			Возврат ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ОтветственныеЛица.Руководитель, ДатаДокумента);
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Не из типовой. Данные комиссии для подвала (ERP.2026.9).
//
Функция ДанныеКомиссии(Организация, Подразделение, Склад, ДатаСписания)
	
	Результат = Новый Структура("ЕстьКомиссия, Председатель, ЧленыКомиссии", Ложь, Неопределено, Новый Массив);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Наличие приказа — по ключам ТЗ (организация, подразделение, склад).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Приказ.Ссылка КАК Ссылка,
	|	Приказ.ПодразделениеОрганизации КАК ПодразделениеОрганизации
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации КАК Приказ
	|ГДЕ
	|	Приказ.Проведен
	|	И НЕ Приказ.ПометкаУдаления
	|	И Приказ.Организация = &Организация
	|	И Приказ.Подразделение = &Подразделение
	|	И Приказ.Склад = &Склад
	|	И Приказ.Дата <= &ДатаСписания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приказ.Дата УБЫВ,
	|	Приказ.Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ДатаСписания", ДатаСписания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Состав комиссии — срез регистра движений на дату списания.
	ЗапросЧлены = Новый Запрос;
	ЗапросЧлены.Текст =
	"ВЫБРАТЬ
	|	Комиссии.НомерСтроки КАК НомерСтроки,
	|	Комиссии.ФИО КАК ФИО,
	|	Комиссии.СтепеньЧленства КАК СтепеньЧленства,
	|	Комиссии.Должность КАК Должность,
	|	ПРЕДСТАВЛЕНИЕ(Комиссии.Должность) КАК ДолжностьПредставление
	|ИЗ
	|	РегистрСведений.тн_Комиссии.СрезПоследних(
	|			&ДатаСписания,
	|			Организация = &Организация
	|				И ПодразделениеОрганизации = &ПодразделениеОрганизации) КАК Комиссии
	|ГДЕ
	|	Комиссии.ФИО <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ЗапросЧлены.УстановитьПараметр("ДатаСписания", ДатаСписания);
	ЗапросЧлены.УстановитьПараметр("Организация", Организация);
	ЗапросЧлены.УстановитьПараметр("ПодразделениеОрганизации", Выборка.ПодразделениеОрганизации);
	
	ВыборкаЧлены = ЗапросЧлены.Выполнить().Выбрать();
	Пока ВыборкаЧлены.Следующий() Цикл
		
		СтрокаКомиссии = Новый Структура;
		СтрокаКомиссии.Вставить("ФИО", ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ВыборкаЧлены.ФИО, ДатаСписания));
		СтрокаКомиссии.Вставить("Должность", Строка(ВыборкаЧлены.ДолжностьПредставление));
		СтрокаКомиссии.Вставить("СтепеньЧленства", ВыборкаЧлены.СтепеньЧленства);
		
		Если ВыборкаЧлены.СтепеньЧленства = Перечисления.тн_СтепеньЧленстваВКомиссии.Председатель Тогда
			Если Результат.Председатель = Неопределено Тогда
				Результат.Председатель = СтрокаКомиссии;
			КонецЕсли;
		Иначе
			Результат.ЧленыКомиссии.Добавить(СтрокаКомиссии);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.Председатель <> Неопределено Или Результат.ЧленыКомиссии.Количество() > 0 Тогда
		Результат.ЕстьКомиссия = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// На базе Обработка.ПечатьМ11.ЗаполнитьТабличныйДокументМ11.
//
// Отличия от типовой:
//  - параметр ДопДанныеПоДокументам (подписи, примечание, комиссия);
//  - макет из внешней обработки ПолучитьМакет("ПФ_MXL_М11"), а не УправлениеПечатью.МакетПечатнойФормы(...);
//  - без ветки ВыводитьНДИГК (только обычный вывод ШапкаТаблицы);
//  - область «Подпись»: заполнение Через кого / Затребовал / Разрешил;
//  - подвал: Отпустил/Получил из тн_ОтветственныйСотрудник / тн_Затребовал (не кладовщик склада);
//  - после подвала: Примечание и Комиссия.
//
Процедура ЗаполнитьТабличныйДокументМ11(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДопДанныеПоДокументам)
	
	ШаблонОшибкиТовары = НСтр("ru = 'В документе %1 отсутствуют товары. Печать М-11 не требуется'");
	
	ТоварКод = ФормированиеПечатныхФорм.ДополнительнаяКолонкаПечатныхФормДокументов().ИмяКолонки;
	Если Не ЗначениеЗаполнено(ТоварКод) Тогда
		ТоварКод = "Код";
	КонецЕсли;
	
	// ERP.2026.9: макет внешней обработки (в типовой — Обработка.ПечатьМ11.ПФ_MXL_М11).
	Макет = ПолучитьМакет("ПФ_MXL_М11");
	
	ПервыйДокумент = Истина;
	ВыборкаДокументы = ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ВыборкаПоТабличнымЧастям = ДанныеДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СтруктураОтбора = Новый Структура("Ссылка");
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		СтруктураОтбора.Ссылка = ВыборкаДокументы.Ссылка;
		ВыборкаПоТабличнымЧастям.Сбросить();
		Если Не ВыборкаПоТабличнымЧастям.НайтиСледующий(СтруктураОтбора) Тогда
			// Типовой код; в конфигурации — ОбщегоНазначенияКлиентСервер.СообщитьПользователю.
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиТовары, ВыборкаДокументы.Ссылка),
				ВыборкаДокументы.Ссылка);
			Продолжить;
		КонецЕсли;
		
		// ERP.2026.9: доп. данные документа (в типовой нет).
		ДопДанные = ДопДанныеПоДокументам.Получить(ВыборкаДокументы.Ссылка);
		Если ДопДанные = Неопределено Тогда
			ДопДанные = ПустыеДополнительныеДанные();
		КонецЕсли;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		ВыборкаПоСкладам = ВыборкаПоТабличнымЧастям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоСкладам.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			
			// Шапка — как в типовой.
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
				ТабличныйДокумент, Макет, ОбластьШапка, ВыборкаДокументы.Ссылка);
			ОбластьШапка.Параметры.Заголовок = НСтр("ru = 'ТРЕБОВАНИЕ-НАКЛАДНАЯ №'")
				+ ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокументы.Номер, Ложь, Истина);
			ОбластьШапка.Параметры.Заполнить(ВыборкаДокументы);
			ОбластьШапка.Параметры.Заполнить(ВыборкаПоСкладам);
			
			СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(
				ВыборкаДокументы.Организация, ВыборкаДокументы.ДатаДокумента);
			ОбластьШапка.Параметры.ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(
				СведенияОбОрганизации);
			ОбластьШапка.Параметры.КодОКПО = СведенияОбОрганизации.КодПоОКПО;
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			// ERP.2026.9: ветка НДИГК из типовой не перенесена — только обычный вывод.
			
			НомерСтраницы = 1;
			НомерСтроки = 0;
			МассивВыводимыхОбластей = Новый Массив;
			
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
			
			ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ШапкаТаблицы.Параметры.Заполнить(ВыборкаДокументы);
			ШапкаТаблицы.Параметры.Заполнить(ВыборкаПоСкладам);
			ШапкаТаблицы.Параметры.ПредставлениеПодразделения = ВыборкаДокументы.Подразделение;
			ТабличныйДокумент.Вывести(ШапкаТаблицы);
			
			ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");
			// ERP.2026.9: в типовой область «Подпись» выводится без заполнения.
			ЗаполнитьОбластьПодписи(ОбластьПодпись, ДопДанные, ВыборкаДокументы.ДатаДокумента);
			ТабличныйДокумент.Вывести(ОбластьПодпись);
			
			ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
			
			// Строки ТЧ — как в типовой (колонки не менялись).
			ВыборкаПоСтрокам = ВыборкаПоСкладам.Выбрать();
			КоличествоСтрок = ВыборкаПоСтрокам.Количество();
			Пока ВыборкаПоСтрокам.Следующий() Цикл
				
				Область = Макет.ПолучитьОбласть("Строка");
				Область.Параметры.Заполнить(ВыборкаПоСтрокам);
				НомерСтроки = НомерСтроки + 1;
				
				МассивВыводимыхОбластей.Очистить();
				МассивВыводимыхОбластей.Добавить(Область);
				Если НомерСтроки = КоличествоСтрок Тогда
					МассивВыводимыхОбластей.Добавить(ОбластьПодвал);
				КонецЕсли;
				
				Если ТоварКод = "Артикул" Тогда
					Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерАртикул;
				Иначе
					Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерКод;
				КонецЕсли;
				
				ДопПараметрыПредставлениеНоменклатуры =
					НоменклатураКлиентСервер.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
				ДопПараметрыПредставлениеНоменклатуры.КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
				
				Область.Параметры.МатериалНаименование = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
					СокрЛП(ВыборкаПоСтрокам.НоменклатураНаименование),
					СокрЛП(ВыборкаПоСтрокам.Характеристика),
					,
					,
					ДопПараметрыПредставлениеНоменклатуры);
				
				Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
					НомерСтраницы = НомерСтраницы + 1;
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("НомерСтраницы", "Страница " + НомерСтраницы);
					ЗаголовокТаблицы.Параметры.Заполнить(СтруктураПараметров);
					ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(Область);
				
			КонецЦикла;
			
			// ERP.2026.9: в типовой — Должность/ФИО кладовщика склада;
			// здесь — Отпустил/Получил из тн_ОтветственныйСотрудник / тн_Затребовал.
			ЗаполнитьОбластьПодвала(ОбластьПодвал, ДопДанные, ВыборкаДокументы.ДатаДокумента);
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
			// ERP.2026.9: в типовой нет.
			ВывестиПримечание(ТабличныйДокумент, Макет, ДопДанные.Товары);
			ВывестиКомиссию(ТабличныйДокумент, Макет, ДопДанные.Комиссия);
			
		КонецЦикла;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Заглушка доп. данных документа (ERP.2026.9).
//
Функция ПустыеДополнительныеДанные()
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Дата", '00010101');
	ДанныеДокумента.Вставить("Организация", Неопределено);
	ДанныеДокумента.Вставить("Подразделение", Неопределено);
	ДанныеДокумента.Вставить("Склад", Неопределено);
	ДанныеДокумента.Вставить("ОтветственныйСотрудник", Неопределено);
	ДанныеДокумента.Вставить("Затребовал", Неопределено);
	ДанныеДокумента.Вставить("Товары", Новый Массив);
	ДанныеДокумента.Вставить("ДолжностьОтветственного", "");
	ДанныеДокумента.Вставить("ДолжностьЗатребовал", "");
	ДанныеДокумента.Вставить("Разрешил", "");
	ДанныеДокумента.Вставить("Комиссия",
		Новый Структура("ЕстьКомиссия, Председатель, ЧленыКомиссии", Ложь, Неопределено, Новый Массив));
	Возврат ДанныеДокумента;
	
КонецФункции

// Не из типовой. В Обработка.ПечатьМ11 область «Подпись» выводится без заполнения (ERP.2026.9).
//
Процедура ЗаполнитьОбластьПодписи(ОбластьПодпись, ДопДанные, ДатаДокумента)
	
	ЧерезКого = "";
	Если ЗначениеЗаполнено(ДопДанные.ОтветственныйСотрудник) Тогда
		ЧерезКого = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.ОтветственныйСотрудник, ДатаДокумента);
	КонецЕсли;
	
	Затребовал = "";
	Если ЗначениеЗаполнено(ДопДанные.Затребовал) Тогда
		Затребовал = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.Затребовал, ДатаДокумента);
	КонецЕсли;
	
	ЗаменитьТекстЯчейкиПоПрефиксу(ОбластьПодпись, "Через кого", "Через кого " + ЧерезКого);
	ЗаменитьТекстЯчейкиПоПрефиксу(ОбластьПодпись, "Затребовал", "Затребовал " + Затребовал);
	ЗаменитьТекстЯчейкиПоПрефиксу(ОбластьПодпись, "Разрешил", "Разрешил " + Строка(ДопДанные.Разрешил));
	
КонецПроцедуры

// Изменено относительно типовой Обработка.ПечатьМ11.ЗаполнитьТабличныйДокументМ11:
// вместо ДолжностьКладовщикаОтправителя / КладовщикОтправитель — тн_ОтветственныйСотрудник / тн_Затребовал (ERP.2026.9).
//
Процедура ЗаполнитьОбластьПодвала(ОбластьПодвал, ДопДанные, ДатаДокумента)
	
	ФИООтпустил = "";
	Если ЗначениеЗаполнено(ДопДанные.ОтветственныйСотрудник) Тогда
		ФИООтпустил = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.ОтветственныйСотрудник, ДатаДокумента);
	КонецЕсли;
	
	ФИОПолучил = "";
	Если ЗначениеЗаполнено(ДопДанные.Затребовал) Тогда
		ФИОПолучил = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.Затребовал, ДатаДокумента);
	КонецЕсли;
	
	ОбластьПодвал.Параметры.ДолжностьОтправителя = ДопДанные.ДолжностьОтветственного;
	ОбластьПодвал.Параметры.ФИООтправителя = ФИООтпустил;
	
	ЗаполнитьЯчейкиПолучил(ОбластьПодвал, ДопДанные.ДолжностьЗатребовал, ФИОПолучил);
	
КонецПроцедуры

// Не из типовой. Вспомогательная процедура для области «Подпись» (ERP.2026.9).
//
Процедура ЗаменитьТекстЯчейкиПоПрефиксу(Область, Префикс, НовыйТекст)
	
	Для НомерСтроки = 1 По Область.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По Область.ШиринаТаблицы Цикл
			Ячейка = Область.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			ТекстЯчейки = Ячейка.Текст;
			Если СтрНачинаетсяС(ТекстЯчейки, Префикс) Тогда
				Ячейка.Текст = НовыйТекст;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Заполнение «Получил» в подвале (в типовой не заполняется) (ERP.2026.9).
//
Процедура ЗаполнитьЯчейкиПолучил(ОбластьПодвал, Должность, ФИО)
	
	Для НомерСтроки = 1 По ОбластьПодвал.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ОбластьПодвал.ШиринаТаблицы Цикл
			Ячейка = ОбластьПодвал.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			Если Ячейка.Текст <> "Получил" Тогда
				Продолжить;
			КонецЕсли;
			
			// Должность и ФИО — в свободные ячейки справа от подписи «Получил».
			КолонкаДолжность = НомерКолонки + 2;
			КолонкаФИО = НомерКолонки + 6;
			Если КолонкаДолжность <= ОбластьПодвал.ШиринаТаблицы Тогда
				ОбластьПодвал.Область(НомерСтроки, КолонкаДолжность, НомерСтроки, КолонкаДолжность).Текст = Должность;
			КонецЕсли;
			Если КолонкаФИО <= ОбластьПодвал.ШиринаТаблицы Тогда
				ОбластьПодвал.Область(НомерСтроки, КолонкаФИО, НомерСтроки, КолонкаФИО).Текст = ФИО;
			КонецЕсли;
			Возврат;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Раздел «Примечание» (области макета внешней обработки) (ERP.2026.9).
//
Процедура ВывестиПримечание(ТабличныйДокумент, Макет, СтрокиТоваров)
	
	Если СтрокиТоваров = Неопределено Или СтрокиТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПримечаниеЗаголовок"));
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПримечаниеШапка"));
	
	Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("ПримечаниеСтрока");
		ОбластьСтрока.Параметры.МатериальнаяЦенность = Строка(СтрокаТовара.НоменклатураПредставление);
		ОбластьСтрока.Параметры.СтатьяСписания = Строка(СтрокаТовара.СтатьяСписанияПредставление);
		ОбластьСтрока.Параметры.Аналитика = Строка(СтрокаТовара.АналитикаПредставление);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Блок комиссии по приказу / регистру (ERP.2026.9).
//
Процедура ВывестиКомиссию(ТабличныйДокумент, Макет, Комиссия)
	
	Если Комиссия = Неопределено Или Не Комиссия.ЕстьКомиссия Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДанные = (Комиссия.Председатель <> Неопределено) Или (Комиссия.ЧленыКомиссии.Количество() > 0);
	Если Не ЕстьДанные Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("КомиссияЗаголовок"));
	
	Если Комиссия.Председатель <> Неопределено Тогда
		ВывестиСтрокуКомиссии(
			ТабличныйДокумент,
			Макет,
			НСтр("ru = 'Председатель комиссии'"),
			Комиссия.Председатель.Должность,
			Комиссия.Председатель.ФИО);
	КонецЕсли;
	
	Для Каждого ЧленКомиссии Из Комиссия.ЧленыКомиссии Цикл
		ВывестиСтрокуКомиссии(
			ТабличныйДокумент,
			Макет,
			НСтр("ru = 'Член комиссии'"),
			ЧленКомиссии.Должность,
			ЧленКомиссии.ФИО);
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Строка блока комиссии (ERP.2026.9).
//
Процедура ВывестиСтрокуКомиссии(ТабличныйДокумент, Макет, Роль, Должность, ФИО)
	
	Область = Макет.ПолучитьОбласть("КомиссияСтрока");
	Область.Параметры.РольЧленаКомиссии = Роль;
	Область.Параметры.ДолжностьЧленаКомиссии = Должность;
	Область.Параметры.ФИОЧленаКомиссии = ФИО;
	ТабличныйДокумент.Вывести(Область);
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
