#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//   см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт      
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.11.466");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Обработка формирования печатной формы Требование-накладная (М-11) с членами комиссии для документа ""Внутреннее потребление "".'");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.0.4";
	ПараметрыРегистрации.Назначение.Добавить("Документ.ВнутреннееПотребление");    
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Требование-накладная (М-11) Списание на расходы НП'");
    ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Требование-накладная (М-11) Списание на расходы НП'");
	Команда.Идентификатор = "нп_М11_списание";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;
	Команда.Модификатор = "ПечатьMXL";
	                                      	
	Возврат ПараметрыРегистрации;     
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// СтандартныеПодсистемы.Печать

// Формирует печатные формы./
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "нп_М11_списание");
	Если ПечатнаяФорма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Внутренний ЭДО вызывает УправлениеПечатью.НапечататьВФайл → эту же Печать.
	// Пустой табличный документ = файл «<отсутствует>» в карточке ЭД.
	ОбъектыКПечати = МассивОбъектовСписанияНаРасходы(МассивОбъектов);
	Если ОбъектыКПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПечатнаяФорма.ТабличныйДокумент = СформироватьПечатнуюФормуМ11(ОбъектыКПечати, ОбъектыПечати);
	ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Требование-накладная (М-11) Списание на расходы НП'");
	ПечатнаяФорма.ПолныйПутьКМакету = "";
	// Короткое имя для zip внутреннего ЭДО: длинное имя ПФ ломает распаковку
	// (обходной путь без точки в расширении) → ПредставлениеДокумента = Неопределено.
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = "M11";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

Функция ПечатнаяФормаДокумента(ДокументСсылка) Экспорт

	 МассивОбъектов = Новый Массив;
	 МассивОбъектов.Добавить(ДокументСсылка);
	 
	 ОбъектыКПечати = МассивОбъектовСписанияНаРасходы(МассивОбъектов);   
	 Если ОбъектыКПечати.Количество() = 0 Тогда
	 	Возврат Новый ТабличныйДокумент;	 
	КонецЕсли;
	
	ОбъектыПечати = Новый СписокЗначений;
	Возврат СформироватьПечатнуюФормуМ11(ОбъектыКПечати, ОбъектыПечати);	 

КонецФункции // ПечатгаяФормаДОкумента()

#КонецОбласти

#КонецОбласти


#Область СлужебныеПроцедурыИФункции
	
//Оставляем только документы с видом операции "Списание на расходы"
Функция МассивОбъектовСписанияНаРасходы(МассивОбъектов)

	Результат = Новый Массив;
	
	Если МассивОбъектов.Количество() = 0 Тогда             	
		Возврат Результат;                     	
	КонецЕсли;	                            
	
	ЗначенияОпераций = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов,"ХозяйственнаяОперация");
	ОперацияСписанияНаРасходы = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	ШаблонСообщения = НСтр("ru = 'Требование-накладная (М-11) Списание на расходы доступна только для операции ""Списание на расходы"". Документ %1 пропущен.'"); 
	
	Для каждого СсылкаДокумента Из МассивОбъектов Цикл
	
		ХозяйственнаяОперация = ЗначенияОпераций.Получить(СсылкаДокумента).ХозяйственнаяОперация;
		Если ХозяйственнаяОперация = ОперацияСписанияНаРасходы Тогда
			Результат.Добавить(СсылкаДокумента);		
		Иначе
		    ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаДокумента),
				СсылкаДокумента);         		
		КонецЕсли;
		             
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	    

// На базе Обработка.ПечатьМ11.СформироватьПечатнуюФормуМ11
Функция СформироватьПечатнуюФормуМ11(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;   
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_нп_М11_Списание";
	
	ПараметрыПечати = Новый Структура;
	
	ДанныеДляПечати = ВнутреннееПотреблениеЛокализация.ПолучитьДанныеДляПечатнойФормыМ11(ПараметрыПечати, МассивОбъектов);     
	
	//ERP.2026.9 Скрипко
	ДопДанныеДляПечати = ПолучитьДопДанныеДляПечати(МассивОбъектов);
	
	ЗаполнитьТабличныйДокументМ11(ТабличныйДокумент, ДанныеДляПечати, ДопДанныеДляПечати, ОбъектыПечати);
	
	// Для НапечататьВФайл (внутренний ЭДО): если именные области Документ_N
	// не находятся, файл не формируется («<отсутствует>»), хотя на экране печать есть.
	ОбеспечитьОбластиПечатиДляВыгрузкиВФайл(ТабличныйДокумент, ОбъектыПечати);
	
	Возврат ТабличныйДокумент;

КонецФункции // СформироватьПечатнуюФормуМ11(МассивОбъектов, ОбъектыПечати)()

// На базе Обработка.ПечатьМ11.ЗаполнитьТабличныйДокументМ11
Процедура ЗаполнитьТабличныйДокументМ11(ТабличныйДокумент, ДанныеДляПечати, ДопДанныеДляПечати, ОбъектыПечати)

	ШаблонОшибкиТовары = НСтр("ru = 'В документе %1 отсутствуют товары. Печать М-11 не требуется';
								|en = 'Goods are missing in document %1. Printing of M-11 is not required'");

	ТоварКод = ФормированиеПечатныхФорм.ДополнительнаяКолонкаПечатныхФормДокументов().ИмяКолонки;
	Если Не ЗначениеЗаполнено(ТоварКод) Тогда
		ТоварКод = "Код";
	КонецЕсли;
	
	// ERP.2026.9 Скрипко
	Макет = ПолучитьМакет("ПФ_MXL_М11");

	ВыводитьНДИГК = Ложь;
	//++ НЕ УТ
	ВыводитьНДИГК = Константы.ВыводитьДопКолонкиНаправлениеДеятельностиИГК.Получить()
		И ДанныеДляПечати.РезультатПоТабличнойЧасти.Колонки.Найти("НДИГКПолучателя") <> Неопределено;
	//-- НЕ УТ

	ПервыйДокумент = Истина;
	ВыборкаДокументы = ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ВыборкаПоТабличнымЧастям = ДанныеДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СтруктураОтбора = Новый Структура("Ссылка");

	Пока ВыборкаДокументы.Следующий() Цикл

		СтруктураОтбора.Ссылка = ВыборкаДокументы.Ссылка;
		ВыборкаПоТабличнымЧастям.Сбросить();
		Если Не ВыборкаПоТабличнымЧастям.НайтиСледующий(СтруктураОтбора) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибкиТовары, ВыборкаДокументы.Ссылка),
				ВыборкаДокументы.Ссылка);
			Продолжить;
		КонецЕсли;
		
		// ERP.2026.9 Скрипко
		ДопДанные = ДопДанныеДляПечати.Получить(ВыборкаДокументы.Ссылка);
		Если ДопДанные = Неопределено Тогда  			
		    ДопДанные = ПустыеДопДанные();
		КонецЕсли;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		ВыборкаПоСкладам = ВыборкаПоТабличнымЧастям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаПоСкладам.Следующий() Цикл

			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;

			ПервыйДокумент = Ложь;
			
			// Вывод шапки.
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьШапка,
				ВыборкаДокументы.Ссылка);
			ОбластьШапка.Параметры.Заголовок = НСтр("ru = 'ТРЕБОВАНИЕ-НАКЛАДНАЯ №';
													|en = 'REQUISITION NOTE No.'")
				+ ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокументы.Номер, Ложь, Истина);
			ОбластьШапка.Параметры.Заполнить(ВыборкаДокументы);
			ОбластьШапка.Параметры.Заполнить(ВыборкаПоСкладам);

			СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ВыборкаДокументы.Организация,
				ВыборкаДокументы.ДатаДокумента);
			ОбластьШапка.Параметры.ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(
				СведенияОбОрганизации);
			ОбластьШапка.Параметры.КодОКПО = СведенияОбОрганизации.КодПоОКПО;
			ТабличныйДокумент.Вывести(ОбластьШапка);

			Если ВыводитьНДИГК Тогда

				ВыборкаПоНДИГКОтправителя = ВыборкаПоСкладам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

				НомерСтраницы   = 1;
				
				ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");
				ТабличныйДокумент.Вывести(ОбластьПодпись);

				Пока ВыборкаПоНДИГКОтправителя.Следующий() Цикл

					ВыборкаПоНДИГКПолучателя = ВыборкаПоНДИГКОтправителя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

					Пока ВыборкаПоНДИГКПолучателя.Следующий() Цикл	
						
						// Создаем массив для проверки вывода
						МассивВыводимыхОбластей = Новый Массив;

						ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицыНДИГК");
						ШапкаТаблицы.Параметры.Заполнить(ВыборкаДокументы);
						ШапкаТаблицы.Параметры.Заполнить(ВыборкаПоНДИГКПолучателя);
						ШапкаТаблицы.Параметры.ПредставлениеПодразделения = ВыборкаДокументы.Подразделение;

						ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
						
						// Области многострочной части документа
						ОбластьМакета	= Макет.ПолучитьОбласть("Строка");
						ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");

						МассивВыводимыхОбластей.Добавить(ОбластьПодпись);
						МассивВыводимыхОбластей.Добавить(ШапкаТаблицы);
						МассивВыводимыхОбластей.Добавить(ЗаголовокТаблицы);
						МассивВыводимыхОбластей.Добавить(ОбластьМакета);
						МассивВыводимыхОбластей.Добавить(ОбластьПодвал);

						Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
							НомерСтраницы = НомерСтраницы + 1;
							ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
							ШапкаТаблицы.Параметры.Заполнить(Новый Структура("НомерСтраницыШапка", "Страница "
								+ НомерСтраницы));
							ТабличныйДокумент.Вывести(ШапкаТаблицы);
							ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
						Иначе
							ТабличныйДокумент.Вывести(ШапкаТаблицы);
							ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
						КонецЕсли;

						НомерСтроки = 0;

						ВыборкаПоСтрокам = ВыборкаПоНДИГКПолучателя.Выбрать();
						КоличествоСтрок = ВыборкаПоСтрокам.Количество();
						Пока ВыборкаПоСтрокам.Следующий() Цикл

							Область = Макет.ПолучитьОбласть("Строка");
							Область.Параметры.Заполнить(ВыборкаПоСтрокам);

							НомерСтроки = НомерСтроки + 1;

							МассивВыводимыхОбластей.Очистить();
							МассивВыводимыхОбластей.Добавить(Область);

							Если НомерСтроки = КоличествоСтрок Тогда
								МассивВыводимыхОбластей.Добавить(ОбластьПодвал);
							КонецЕсли;

							Если ТоварКод = "Артикул" Тогда
								Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерАртикул;
							Иначе
								Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерКод;
							КонецЕсли;

							ДопПараметрыПредставлениеНоменклатуры = НоменклатураКлиентСервер.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
							ДопПараметрыПредставлениеНоменклатуры.КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();

							Область.Параметры.МатериалНаименование = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
							СокрЛП(ВыборкаПоСтрокам.НоменклатураНаименование), СокрЛП(ВыборкаПоСтрокам.Характеристика), , ,
								ДопПараметрыПредставлениеНоменклатуры);

							Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
								НомерСтраницы = НомерСтраницы + 1;
								ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
								СтруктураПараметров = Новый Структура;
								СтруктураПараметров.Вставить("НомерСтраницы", "Страница " + НомерСтраницы);
								ЗаголовокТаблицы.Параметры.Заполнить(СтруктураПараметров);
								ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
							КонецЕсли;

							ТабличныйДокумент.Вывести(Область);

						КонецЦикла;

					КонецЦикла;

				КонецЦикла;
				
				// Вывод подвала.
				ОбластьПодвал.Параметры.ДолжностьОтправителя = ВыборкаПоСкладам.ДолжностьКладовщикаОтправителя;
				ОбластьПодвал.Параметры.ФИООтправителя = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(
					ВыборкаПоСкладам.КладовщикОтправитель, ВыборкаДокументы.ДатаДокумента);
				ТабличныйДокумент.Вывести(ОбластьПодвал);

			Иначе

				НомерСтраницы   = 1;
				НомерСтроки = 0;
				
				// Создаем массив для проверки вывода
				МассивВыводимыхОбластей = Новый Массив;

				ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

				ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
				ШапкаТаблицы.Параметры.Заполнить(ВыборкаДокументы);
				ШапкаТаблицы.Параметры.Заполнить(ВыборкаПоСкладам);
				ШапкаТаблицы.Параметры.ПредставлениеПодразделения = ВыборкаДокументы.Подразделение;
				ТабличныйДокумент.Вывести(ШапкаТаблицы);

				ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");  
				// ERP.2026.9 Скрипко
				ЗаполнитьОбластьПодписи(ОбластьПодпись, ДопДанные, ВыборкаДокументы.ДатаДокумента);
				ТабличныйДокумент.Вывести(ОбластьПодпись);

				// Выводим заголовок таблицы
				ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
				ТабличныйДокумент.Вывести(ЗаголовокТаблицы);

				ВыборкаПоСтрокам = ВыборкаПоСкладам.Выбрать();
				КоличествоСтрок = ВыборкаПоСтрокам.Количество();
				Пока ВыборкаПоСтрокам.Следующий() Цикл

					Область = Макет.ПолучитьОбласть("Строка");
					Область.Параметры.Заполнить(ВыборкаПоСтрокам);

					НомерСтроки = НомерСтроки + 1;

					МассивВыводимыхОбластей.Очистить();
					МассивВыводимыхОбластей.Добавить(Область);

					Если НомерСтроки = КоличествоСтрок Тогда
						МассивВыводимыхОбластей.Добавить(ОбластьПодвал);
					КонецЕсли;

					Если ТоварКод = "Артикул" Тогда
						Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерАртикул;
					Иначе
						Область.Параметры.НоменклатурныйНомер = ВыборкаПоСтрокам.НоменклатурныйНомерКод;
					КонецЕсли;

					ДопПараметрыПредставлениеНоменклатуры = НоменклатураКлиентСервер.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
					ДопПараметрыПредставлениеНоменклатуры.КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();

					Область.Параметры.МатериалНаименование = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(
					СокрЛП(ВыборкаПоСтрокам.НоменклатураНаименование), СокрЛП(ВыборкаПоСтрокам.Характеристика), , ,
						ДопПараметрыПредставлениеНоменклатуры);

					Если Не ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
						НомерСтраницы = НомерСтраницы + 1;
						ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						СтруктураПараметров = Новый Структура;
						СтруктураПараметров.Вставить("НомерСтраницы", "Страница " + НомерСтраницы);
						ЗаголовокТаблицы.Параметры.Заполнить(СтруктураПараметров);
						ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
					КонецЕсли;

					ТабличныйДокумент.Вывести(Область);

				КонецЦикла;
				
				// Вывод подвала.
				ОбластьПодвал.Параметры.ДолжностьОтправителя = ВыборкаПоСкладам.ДолжностьКладовщикаОтправителя;
				ОбластьПодвал.Параметры.ФИООтправителя = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(
					ВыборкаПоСкладам.КладовщикОтправитель, ВыборкаДокументы.ДатаДокумента); 
				// ERP.2026.9 Скрипко 	
				ЗаполнитьОбластьПодвала(ОбластьПодвал, ДопДанные, ВыборкаДокументы.ДатаДокумента);
				ТабличныйДокумент.Вывести(ОбластьПодвал);     
				
				// ERP.2026.9 Скрипко
				ВывестиПримечание(ТабличныйДокумент, Макет, ДопДанные.Товары);
                ВывестиКомиссию(ТабличныйДокумент, Макет, ДопДанные.Комиссия); 
				
			КонецЕсли;

		КонецЦикла;

		// Именованные области макета (Примечание/Комиссия) мешают задать Документ_N —
		// без неё НапечататьВФайл для ЭДО не отдаёт файл.
		ОчиститьИменаОбластейСтрок(ТабличныйДокумент, НомерСтрокиНачало, ТабличныйДокумент.ВысотаТаблицы);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати,
			ВыборкаДокументы.Ссылка);

	КонецЦикла;

КонецПроцедуры

// Сбрасывает имена областей строк в диапазоне, чтобы ЗадатьОбластьПечатиДокумента
// могла назначить имя Документ_N (нужно для выгрузки в файл / ЭДО).
//
Процедура ОчиститьИменаОбластейСтрок(ТабличныйДокумент, НомерСтрокиНачало, НомерСтрокиОкончание)
	
	Если НомерСтрокиОкончание < НомерСтрокиНачало Тогда
		Возврат;
	КонецЕсли;
	
	ИменаКОчистке = Новый Массив;
	Для Каждого Область Из ТабличныйДокумент.Области Цикл
		Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Область.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Область.Имя, "Документ_") Тогда
			Продолжить;
		КонецЕсли;
		Если Область.Верх >= НомерСтрокиНачало И Область.Низ <= НомерСтрокиОкончание Тогда
			ИменаКОчистке.Добавить(Область.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяОбласти Из ИменаКОчистке Цикл
		Область = ТабличныйДокумент.Области.Найти(ИмяОбласти);
		Если Область <> Неопределено Тогда
			Область.Имя = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Если разметка по объектам печати битая, очищаем ОбъектыПечати —
// тогда НапечататьВФайл сохранит весь табличный документ целиком.
//
Процедура ОбеспечитьОбластиПечатиДляВыгрузкиВФайл(ТабличныйДокумент, ОбъектыПечати)
	
	Если ОбъектыПечати.Количество() = 0 Или ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементОбласти Из ОбъектыПечати Цикл
		Если ТабличныйДокумент.Области.Найти(ЭлементОбласти.Представление) = Неопределено Тогда
			ОбъектыПечати.Очистить();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДопДанныеДляПечати(МассивОбъектов)  
	
	Результат = Новый Соответствие;	   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнутреннееПотреблениеТовары.Ссылка КАК Ссылка,
		|	ВнутреннееПотреблениеТовары.НомерСтроки КАК НомерСтроки,
		|	ВнутреннееПотреблениеТовары.Номенклатура КАК Номенклатура,
		|	ВнутреннееПотреблениеТовары.Номенклатура.Представление КАК НоменклатураПредставление,
		|	ВнутреннееПотреблениеТовары.СтатьяРасходов КАК СтатьяСписания,
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотреблениеТовары.СтатьяРасходов) КАК СтатьяСписанияПредставление,
		|	ВнутреннееПотреблениеТовары.АналитикаРасходов КАК АналитикаРасходов,
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотреблениеТовары.АналитикаРасходов) КАК АналитикаРасходовПредставление,
		|	ВнутреннееПотреблениеТовары.АналитикаАктивовПассивов КАК АналитикаАктивовПассивов,
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотреблениеТовары.АналитикаАктивовПассивов) КАК АналитикаАктивовПассивовПредставление
		|ИЗ
		|	Документ.ВнутреннееПотребление.Товары КАК ВнутреннееПотреблениеТовары
		|ГДЕ
		|	ВнутреннееПотреблениеТовары.Ссылка В(&МассивОбъектов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка,
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнутреннееПотребление.Ссылка КАК Ссылка,
		|	ВнутреннееПотребление.Дата КАК Дата,
		|	ВнутреннееПотребление.Организация КАК Организация,
		|	ВнутреннееПотребление.Подразделение КАК Подразделение,
		|	ВнутреннееПотребление.Склад КАК Склад,
		|	ВнутреннееПотребление.тн_ОтветственныйСотрудник КАК ОтветственныйСотрудник,
		|	ВнутреннееПотребление.тн_Затребовал КАК Затребовал
		|ИЗ
		|	Документ.ВнутреннееПотребление КАК ВнутреннееПотребление
		|ГДЕ
		|	ВнутреннееПотребление.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаТоваров = Результаты[Результаты.ВГраница() - 1].Выгрузить();
	ТаблицаТоваров.Индексы.Добавить("Ссылка");
	
	ТаблицаШапки = Результаты[Результаты.ВГраница()].Выгрузить();
	ДолжностиПоФизлицам = ДолжностиФизЛиц(ТаблицаШапки);
	КомиссииПоДокументам = ДанныеКомиссий(ТаблицаШапки);
	
	Для Каждого СтрокаШапки Из ТаблицаШапки Цикл
		
		НайденныеСтрокиТоваров = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ссылка", СтрокаШапки.Ссылка));
		СтрокиТоваров = Новый Массив;
		Для Каждого СтрокаТовара Из НайденныеСтрокиТоваров Цикл
			АналитикаПредставление = "";
			Если ЗначениеЗаполнено(СтрокаТовара.АналитикаРасходов) Тогда
				АналитикаПредставление = СтрокаТовара.АналитикаРасходовПредставление;
			ИначеЕсли ЗначениеЗаполнено(СтрокаТовара.АналитикаАктивовПассивов) Тогда
				АналитикаПредставление = СтрокаТовара.АналитикаАктивовПассивовПредставление;
			КонецЕсли;
			СтрокаДляПечати = Новый Структура;
			СтрокаДляПечати.Вставить("НоменклатураПредставление", СтрокаТовара.НоменклатураПредставление);
			СтрокаДляПечати.Вставить("СтатьяСписанияПредставление", СтрокаТовара.СтатьяСписанияПредставление);
			СтрокаДляПечати.Вставить("АналитикаПредставление", АналитикаПредставление);
			СтрокиТоваров.Добавить(СтрокаДляПечати);
		КонецЦикла;
		
		Комиссия = КомиссииПоДокументам.Получить(СтрокаШапки.Ссылка);
		Если Комиссия = Неопределено Тогда
			Комиссия = ПустыеДанныеКомиссии();
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Дата", СтрокаШапки.Дата);
		ДанныеДокумента.Вставить("Организация", СтрокаШапки.Организация);
		ДанныеДокумента.Вставить("Подразделение", СтрокаШапки.Подразделение);
		ДанныеДокумента.Вставить("Склад", СтрокаШапки.Склад);
		ДанныеДокумента.Вставить("ОтветственныйСотрудник", СтрокаШапки.ОтветственныйСотрудник);
		ДанныеДокумента.Вставить("Затребовал", СтрокаШапки.Затребовал);
		ДанныеДокумента.Вставить("Товары", СтрокиТоваров);
		ДанныеДокумента.Вставить("ДолжностьОтветственного",
			ДолжностьИзСоответствия(ДолжностиПоФизлицам, СтрокаШапки.ОтветственныйСотрудник, СтрокаШапки.Организация));
		ДанныеДокумента.Вставить("ДолжностьЗатребовал",
			ДолжностьИзСоответствия(ДолжностиПоФизлицам, СтрокаШапки.Затребовал, СтрокаШапки.Организация));
		ДанныеДокумента.Вставить("Разрешил",
			РуководительОрганизации(СтрокаШапки.Организация, СтрокаШапки.Дата));
		ДанныеДокумента.Вставить("Комиссия", Комиссия);
		
		Результат.Вставить(СтрокаШапки.Ссылка, ДанныеДокумента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьОбластьПодписи(ОбластьПодпись, ДопДанные, Дата)   
  	
	ЧерезКого = "";
	Если ЗначениеЗаполнено(ДопДанные.ОтветственныйСотрудник) Тогда
		ЧерезКого = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.ОтветственныйСотрудник, Дата); 	
	КонецЕсли;   
	
	Затребовал = "";
	Если ЗначениеЗаполнено(ДопДанные.Затребовал) Тогда
		Затребовал = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.Затребовал, Дата); 	
	КонецЕсли;  
	
	ОбластьПодпись.Параметры.ЧерезКого = ЧерезКого; 
	ОбластьПодпись.Параметры.Затребовал = Затребовал;
	ОбластьПодпись.Параметры.Разрешил = ДопДанные.Разрешил;   
		
КонецПроцедуры    

Процедура ЗаполнитьОбластьПодвала(ОбластьПодвал, ДопДанные, Дата)   

	ФИООтпустил = "";
	Если ЗначениеЗаполнено(ДопДанные.ОтветственныйСотрудник) Тогда
		ФИООтпустил = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.ОтветственныйСотрудник, Дата); 	
	КонецЕсли;   
	
	ФИОПолучил = "";
	Если ЗначениеЗаполнено(ДопДанные.Затребовал) Тогда
		ФИОПолучил = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДопДанные.Затребовал, Дата); 	
	КонецЕсли;    
	
	ОбластьПодвал.Параметры.ДолжностьОтправителя = ДопДанные.ДолжностьОтветственного;
	ОбластьПодвал.Параметры.ФИООтправителя = ФИООтпустил;     
	ОбластьПодвал.Параметры.ДолжностьПолучил = ДопДанные.ДолжностьЗатребовал;
	ОбластьПодвал.Параметры.ФИОПолучил = ФИОПолучил; 
	
КонецПроцедуры  

Процедура ВывестиПримечание(ТабличныйДокумент, Макет, СтрокиТоваров)   
	
	Если СтрокиТоваров = Неопределено ИЛИ СтрокиТоваров.Количество() = 0 Тогда
	    Возврат;	
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаПримечание"));  
	
	Для каждого СтрокаТовара Из СтрокиТоваров Цикл
	
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПримечание");
		ОбластьСтрока.Параметры.МатериальнаяЦенность = СтрокаТовара.НоменклатураПредставление;  
		ОбластьСтрока.Параметры.СтатьяСписания = СтрокаТовара.СтатьяСписанияПредставление;
		ОбластьСтрока.Параметры.Аналитика = СтрокаТовара.АналитикаПредставление;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;   
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПодвалПримечание")); 
	
КонецПроцедуры 

Процедура ВывестиКомиссию(ТабличныйДокумент, Макет, Комиссия)   
	
	Если Комиссия = Неопределено ИЛИ НЕ Комиссия.ЕстьКомиссия Тогда
		Возврат;	
	КонецЕсли;      	 
	
	Если Комиссия.Председатель <> Неопределено Тогда
		Область = Макет.ПолучитьОбласть("СтрокаПредседательКомиссии");
		Область.Параметры.ДолжностьЧленаКомиссии = Комиссия.Председатель.Должность;
		Область.Параметры.ФИОЧленаКомиссии = Комиссия.Председатель.ФИО;
		ТабличныйДокумент.Вывести(Область);  	
	КонецЕсли; 
	
	Если Комиссия.ЧленыКомиссии.Количество() > 0 Тогда    
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаЧленыКомиссии"));    	
		Для каждого ЧленКомиссии Из Комиссия.ЧленыКомиссии Цикл
			Область = Макет.ПолучитьОбласть("СтрокаЧленаКомиссии");
			Область.Параметры.ДолжностьЧленаКомиссии = ЧленКомиссии.Должность;
			Область.Параметры.ФИОЧленаКомиссии = ЧленКомиссии.ФИО;
			ТабличныйДокумент.Вывести(Область);  
		КонецЦикла;
	КонецЕсли;     
	
КонецПроцедуры   

Функция ПустыеДопДанные()

	ДанныеДокумента = Новый Структура;	
	ДанныеДокумента.Вставить("Дата", '00010101');  
	ДанныеДокумента.Вставить("Организация", Неопределено);
	ДанныеДокумента.Вставить("Подразделение", Неопределено);
	ДанныеДокумента.Вставить("Склад", Неопределено);
	ДанныеДокумента.Вставить("ОтветственныйСотрудник", Неопределено);
	ДанныеДокумента.Вставить("Затребовал", Неопределено);
	ДанныеДокумента.Вставить("Товары", Новый Массив);
	ДанныеДокумента.Вставить("ДолжностьОтветственного", "");
	ДанныеДокумента.Вставить("ДолжностьЗатребовал", "");
	ДанныеДокумента.Вставить("Разрешил", "");
	ДанныеДокумента.Вставить("Комиссия", ПустыеДанныеКомиссии());
	
	Возврат ДанныеДокумента;

КонецФункции

Функция ПустыеДанныеКомиссии()
	
	Возврат Новый Структура("ЕстьКомиссия, Председатель, ЧленыКомиссии", Ложь, Неопределено, Новый Массив);
	
КонецФункции

Функция ДолжностьИзСоответствия(ДолжностиПоФизлицам, ФизическоеЛицо, Организация)
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	ДолжностиПоОрганизации = ДолжностиПоФизлицам.Получить(Организация);
	Если ДолжностиПоОрганизации = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Должность = ДолжностиПоОрганизации.Получить(ФизическоеЛицо);
	Если Должность = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Должность;
	
КонецФункции

// Пакетная загрузка должностей по физлицам документов.
//
Функция ДолжностиФизЛиц(ТаблицаШапки)
	
	Результат = Новый Соответствие;
	
	ТаблицаФизЛиц = Новый ТаблицаЗначений;
	ТаблицаФизЛиц.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТаблицаФизЛиц.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Для Каждого СтрокаШапки Из ТаблицаШапки Цикл
		ДобавитьФизлицоВТаблицуДолжностей(ТаблицаФизЛиц,
			СтрокаШапки.ОтветственныйСотрудник, СтрокаШапки.Организация);
		ДобавитьФизлицоВТаблицуДолжностей(ТаблицаФизЛиц,
			СтрокаШапки.Затребовал, СтрокаШапки.Организация);
	КонецЦикла;
	
	Если ТаблицаФизЛиц.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаФизЛиц.Свернуть("ФизическоеЛицо, Организация");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаФизЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ТаблицаФизЛиц.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_ФизЛица
	|ИЗ
	|	&ТаблицаФизЛиц КАК ТаблицаФизЛиц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФизЛица.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТ_ФизЛица.Организация КАК Организация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность.Представление КАК ДолжностьПредставление
	|ИЗ
	|	ВТ_ФизЛица КАК ВТ_ФизЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|		ПО ВТ_ФизЛица.ФизическоеЛицо = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
	|			И ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|			И (ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация = ВТ_ФизЛица.Организация
	|				ИЛИ ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = ВТ_ФизЛица.Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо,
	|	Организация,
	|	ТекущиеКадровыеДанныеСотрудников.ОсновноеРабочееМестоВОрганизации УБЫВ,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаПриема УБЫВ";
	
	Запрос.УстановитьПараметр("ТаблицаФизЛиц", ТаблицаФизЛиц);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДолжностиПоОрганизации = Результат.Получить(Выборка.Организация);
		Если ДолжностиПоОрганизации = Неопределено Тогда
			ДолжностиПоОрганизации = Новый Соответствие;
			Результат.Вставить(Выборка.Организация, ДолжностиПоОрганизации);
		КонецЕсли;
		
		Если ДолжностиПоОрганизации.Получить(Выборка.ФизическоеЛицо) = Неопределено Тогда
			ДолжностиПоОрганизации.Вставить(Выборка.ФизическоеЛицо, СокрЛП(Выборка.ДолжностьПредставление));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьФизлицоВТаблицуДолжностей(ТаблицаФизЛиц, ФизическоеЛицо, Организация)
	
	Если Не ЗначениеЗаполнено(ФизическоеЛицо) Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = ТаблицаФизЛиц.Добавить();
	СтрокаТаблицы.ФизическоеЛицо = ФизическоеЛицо;
	СтрокаТаблицы.Организация = Организация;
	
КонецПроцедуры

Функция РуководительОрганизации(Организация, Дата)

	ОтветственныеЛица = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Организация, Дата);
	Если ЗначениеЗаполнено(ОтветственныеЛица.Руководитель) Тогда
		Возврат ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ОтветственныеЛица.Руководитель, Дата);
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Пакетная загрузка комиссий по документам списания.
//
Функция ДанныеКомиссий(ТаблицаШапки)
	
	Результат = Новый Соответствие;
	
	Если ТаблицаШапки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Организации = Новый Массив;
	Подразделения = Новый Массив;
	Склады = Новый Массив;
	УникальныеОрганизации = Новый Соответствие;
	УникальныеПодразделения = Новый Соответствие;
	УникальныеСклады = Новый Соответствие;
	
	Для Каждого СтрокаШапки Из ТаблицаШапки Цикл
		Если УникальныеОрганизации.Получить(СтрокаШапки.Организация) = Неопределено Тогда
			УникальныеОрганизации.Вставить(СтрокаШапки.Организация, Истина);
			Организации.Добавить(СтрокаШапки.Организация);
		КонецЕсли;
		Если УникальныеПодразделения.Получить(СтрокаШапки.Подразделение) = Неопределено Тогда
			УникальныеПодразделения.Вставить(СтрокаШапки.Подразделение, Истина);
			Подразделения.Добавить(СтрокаШапки.Подразделение);
		КонецЕсли;
		Если УникальныеСклады.Получить(СтрокаШапки.Склад) = Неопределено Тогда
			УникальныеСклады.Вставить(СтрокаШапки.Склад, Истина);
			Склады.Добавить(СтрокаШапки.Склад);
		КонецЕсли;
	КонецЦикла;
	
	Если Организации.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Ссылка КАК Ссылка,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Дата КАК Дата,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Организация КАК Организация,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Подразделение КАК Подразделение,
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Склад КАК Склад
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации КАК тн_ПриказНаКомиссиюПоИнвентаризации
	|ГДЕ
	|	тн_ПриказНаКомиссиюПоИнвентаризации.Проведен
	|	И тн_ПриказНаКомиссиюПоИнвентаризации.Организация В(&Организации)
	|	И тн_ПриказНаКомиссиюПоИнвентаризации.Подразделение В(&Подразделения)
	|	И тн_ПриказНаКомиссиюПоИнвентаризации.Склад В(&Склады)
	|	И тн_ПриказНаКомиссиюПоИнвентаризации.ВидКомиссии = &ВидКомиссии
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("ВидКомиссии", Справочники.тн_ВидыКомиссии.ТМЦ);
	
	ТаблицаПриказов = Запрос.Выполнить().Выгрузить();
	ТаблицаПриказов.Индексы.Добавить("Организация,Подразделение,Склад");
	
	ПриказыПоДокументам = Новый Соответствие;
	ПриказыДляЧленов = Новый Массив;
	УникальныеПриказы = Новый Соответствие;
	
	Для Каждого СтрокаШапки Из ТаблицаШапки Цикл
		
		ПриказСсылка = Неопределено;
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", СтрокаШапки.Организация);
		Отбор.Вставить("Подразделение", СтрокаШапки.Подразделение);
		Отбор.Вставить("Склад", СтрокаШапки.Склад);
		
		Для Каждого СтрокаПриказа Из ТаблицаПриказов.НайтиСтроки(Отбор) Цикл
			Если СтрокаПриказа.Дата <= СтрокаШапки.Дата Тогда
				ПриказСсылка = СтрокаПриказа.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ПриказСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ПриказыПоДокументам.Вставить(СтрокаШапки.Ссылка,
			Новый Структура("Приказ, Дата", ПриказСсылка, СтрокаШапки.Дата));
		Если УникальныеПриказы.Получить(ПриказСсылка) = Неопределено Тогда
			УникальныеПриказы.Вставить(ПриказСсылка, Истина);
			ПриказыДляЧленов.Добавить(ПриказСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПриказыДляЧленов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка КАК Ссылка,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.ФИО КАК ФИО,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.СтепеньЧленства КАК СтепеньЧленства,
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Должность.Представление КАК ДолжностьПредставление
	|ИЗ
	|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации.ЧленыКомиссии КАК тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии
	|ГДЕ
	|	тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.Ссылка В(&Приказы)
	|	И тн_ПриказНаКомиссиюПоИнвентаризацииЧленыКомиссии.ФИО <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Приказы", ПриказыДляЧленов);
	
	ТаблицаЧленов = Запрос.Выполнить().Выгрузить();
	ТаблицаЧленов.Индексы.Добавить("Ссылка");
	
	Для Каждого КлючИЗначение Из ПриказыПоДокументам Цикл
		
		ДокументСсылка = КлючИЗначение.Ключ;
		ПриказСсылка = КлючИЗначение.Значение.Приказ;
		ДатаДокумента = КлючИЗначение.Значение.Дата;
		
		ДанныеКомиссии = ПустыеДанныеКомиссии();
		Для Каждого СтрокаЧлена Из ТаблицаЧленов.НайтиСтроки(Новый Структура("Ссылка", ПриказСсылка)) Цикл
			
			СтрокаКомиссии = Новый Структура;
			СтрокаКомиссии.Вставить("ФИО", ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(СтрокаЧлена.ФИО, ДатаДокумента));
			СтрокаКомиссии.Вставить("Должность", СтрокаЧлена.ДолжностьПредставление);
			СтрокаКомиссии.Вставить("СтепеньЧленства", СтрокаЧлена.СтепеньЧленства);
			
			Если СтрокаЧлена.СтепеньЧленства = Перечисления.тн_СтепеньЧленстваВКомиссии.Председатель Тогда
				Если ДанныеКомиссии.Председатель = Неопределено Тогда
					ДанныеКомиссии.Председатель = СтрокаКомиссии;
				КонецЕсли;
			Иначе
				ДанныеКомиссии.ЧленыКомиссии.Добавить(СтрокаКомиссии);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не (ДанныеКомиссии.Председатель = Неопределено И ДанныеКомиссии.ЧленыКомиссии.Количество() = 0) Тогда
			ДанныеКомиссии.ЕстьКомиссия = Истина;
		КонецЕсли;
		
		Результат.Вставить(ДокументСсылка, ДанныеКомиссии);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли