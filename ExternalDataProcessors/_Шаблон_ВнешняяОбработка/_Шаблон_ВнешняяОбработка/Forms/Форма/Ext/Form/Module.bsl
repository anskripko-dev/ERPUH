#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;
	
	Если Параметры.Свойство("ОбъектыНазначения")
		И ТипЗнч(Параметры.ОбъектыНазначения) = Тип("Массив") Тогда
		ОбъектыНазначения.ЗагрузитьЗначения(Параметры.ОбъектыНазначения);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	
	ВосстановитьНастройки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выполнить(Команда)
	
	ВыполнитьНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Готово'"), , НСтр("ru = 'Настройки сохранены.'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВосстановитьНастройки()
	
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ХранилищеНастроек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДополнительнаяОбработкаСсылка, "ХранилищеНастроек");
	Если ХранилищеНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Настройки.Свойство("Комментарий") Тогда
		Комментарий = Настройки.Комментарий;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	
	СохранитьНастройки();
	
	// Здесь — прикладная логика формы (или вызов методов модуля объекта).
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("Комментарий", Комментарий);
	
	ОбработкаОбъект = ДополнительнаяОбработкаСсылка.ПолучитьОбъект();
	ОбработкаОбъект.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
	ОбработкаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти
