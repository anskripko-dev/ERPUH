	// Пример: обход объектов назначения
	ОбъектыНазначения = Неопределено;
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
		ПараметрыВыполнения.Свойство("ОбъектыНазначения", ОбъектыНазначения);
	КонецЕсли;
	
	Если ТипЗнч(ОбъектыНазначения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СсылкаОбъекта Из ОбъектыНазначения Цикл
		// Логика обработки объекта
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
