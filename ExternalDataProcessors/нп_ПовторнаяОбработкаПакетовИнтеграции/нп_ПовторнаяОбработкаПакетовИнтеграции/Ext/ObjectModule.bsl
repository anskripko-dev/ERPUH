#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.359");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Повторная обработка пакетов интеграции (НП)'");
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Ищет входящие пакеты RMQ в регистре логов интеграции и повторно загружает выбранные.'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Повторная обработка пакетов интеграции'");
	Команда.Идентификатор = "нп_ПовторнаяОбработкаПакетовИнтеграции";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

#КонецОбласти

// Возвращает таблицу записей лога с непустым входящим пакетом.
//
// Параметры:
//  ПараметрыПоиска - Структура:
//   * ДатаНачала - Дата
//   * ДатаОкончания - Дата
//   * ВидСообщения - ПеречислениеСсылка.тн_ВидыСообщений_ERP_УХ, Неопределено
//   * ИДСообщения - Строка
//   * БазаРеспондентИД - Строка
//   * СтрокаПоиска - Строка
//   * Лимит - Число
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция НайтиПакетыВЛоге(ПараметрыПоиска) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Лимит = ПараметрыПоиска.Лимит;
	Если Не ЗначениеЗаполнено(Лимит) Или Лимит < 1 Тогда
		Лимит = 100;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ #Лимит#
	|	Лог.Период КАК Период,
	|	Лог.ВидИнтеграции КАК ВидИнтеграции,
	|	Лог.Ключ КАК Ключ,
	|	Лог.ВидСообщения КАК ВидСообщения,
	|	Лог.ВидСобытия КАК ВидСобытия,
	|	Лог.ИДСообщения КАК ИДСообщения,
	|	Лог.БазаРеспондентИД КАК БазаРеспондентИД,
	|	Лог.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	РегистрСведений.тн_Интеграция_ЛогСообщений КАК Лог
	|ГДЕ
	|	Лог.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Лог.ВидИнтеграции = ЗНАЧЕНИЕ(Перечисление.тн_ВидыИнтеграций.ERP_УХ_Получение)
	|	И (ВЫРАЗИТЬ(Лог.XML_ПакетВходящий КАК СТРОКА(10))) <> """"
	|	И &УсловиеВидСообщения
	|	И &УсловиеИДСообщения
	|	И &УсловиеБазаРеспондент
	|	И &УсловиеСтрокаПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лог.Период УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Лимит#", Формат(Лимит, "ЧГ=0"));
	
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыПоиска.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыПоиска.ДатаОкончания);
	
	Если ЗначениеЗаполнено(ПараметрыПоиска.ВидСообщения) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСообщения", "Лог.ВидСообщения = &ВидСообщения");
		Запрос.УстановитьПараметр("ВидСообщения", ПараметрыПоиска.ВидСообщения);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСообщения", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПоиска.ИДСообщения) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИДСообщения", "Лог.ИДСообщения = &ИДСообщения");
		Запрос.УстановитьПараметр("ИДСообщения", СокрЛП(ПараметрыПоиска.ИДСообщения));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИДСообщения", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПоиска.БазаРеспондентИД) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеБазаРеспондент", "Лог.БазаРеспондентИД = &БазаРеспондентИД");
		Запрос.УстановитьПараметр("БазаРеспондентИД", СокрЛП(ПараметрыПоиска.БазаРеспондентИД));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеБазаРеспондент", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПоиска.СтрокаПоиска) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСтрокаПоиска", "Лог.XML_ПакетВходящий ПОДОБНО &СтрокаПоиска");
		Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(ПараметрыПоиска.СтрокаПоиска) + "%");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСтрокаПоиска", "ИСТИНА");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает тело входящего пакета записи лога.
//
// Параметры:
//  ВидИнтеграции - ПеречислениеСсылка.тн_ВидыИнтеграций
//  Ключ - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстВходящегоПакета(ВидИнтеграции, Ключ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.тн_Интеграция_ЛогСообщений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидИнтеграции.Установить(ВидИнтеграции);
	НаборЗаписей.Отбор.Ключ.Установить(Ключ);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НаборЗаписей[0].XML_ПакетВходящий;
	
КонецФункции

// Повторно обрабатывает пакет из текста лога.
//
// Параметры:
//  ТекстЛога - Строка
//  ПоставитьВОчередь - Булево
//  ИДСообщения - Строка
//  БазаРеспондентИД - Строка
//  ВидСообщения - Произвольный
//
// Возвращаемое значение:
//  Строка - краткий результат
//
Функция ОбработатьТекстПакета(ТекстЛога, ПоставитьВОчередь, ИДСообщения = "", БазаРеспондентИД = "", ВидСообщения = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстJSON = ТекстПакетаJSON(ТекстЛога);
	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат НСтр("ru = 'В записи лога нет JSON-пакета'");
	КонецЕсли;
	
	Если ПоставитьВОчередь Тогда
		Возврат ПоставитьПакетВОчередь(ТекстJSON, ИДСообщения, БазаРеспондентИД, ВидСообщения);
	КонецЕсли;
	
	Отказ = Ложь;
	Попытка
		тн_Интеграция_ERP_УХ.ПолучениеСообщенийRMQ(ТекстJSON, Неопределено, , Отказ, , Истина);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат НСтр("ru = 'Обработка завершилась с отказом (см. лог интеграции)'");
	КонецЕсли;
	
	Возврат НСтр("ru = 'Обработано'");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПакетаJSON(ТекстЛога)
	
	Если Не ЗначениеЗаполнено(ТекстЛога) Тогда
		Возврат "";
	КонецЕсли;
	
	ПозицияJSON = СтрНайти(ТекстЛога, "{");
	Если ПозицияJSON = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТекстЛога, ПозицияJSON);
	
КонецФункции

Функция ПоставитьПакетВОчередь(ТекстJSON, ИДСообщения, БазаРеспондентИД, ВидСообщения)
	
	ТипЗапроса = ТипЗапросаПоВидуСообщения(ВидСообщения, ТекстJSON);
	
	РегистрыСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ДобавитьСообщение(
		ТекстJSON,
		ТипЗапроса,
		СериализоватьПустуюСтруктуру(),
		ИДСообщения,
		БазаРеспондентИД);
	
	Возврат НСтр("ru = 'Поставлено в очередь обработки RMQ'");
	
КонецФункции

Функция ТипЗапросаПоВидуСообщения(ВидСообщения, ТекстJSON)
	
	Если ТипЗнч(ВидСообщения) = Тип("ПеречислениеСсылка.тн_ВидыСообщений_ERP_УХ")
		И ЗначениеЗаполнено(ВидСообщения) Тогда
		Возврат XMLСтрока(ВидСообщения);
	КонецЕсли;
	
	Если ТипЗнч(ВидСообщения) = Тип("Строка") И ЗначениеЗаполнено(ВидСообщения) Тогда
		Возврат ВидСообщения;
	КонецЕсли;
	
	Для Каждого Префикс Из СтрРазделить("catalog,document,registr", ",") Цикл
		Позиция = СтрНайти(ТекстJSON, """" + Префикс);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Фрагмент = Сред(ТекстJSON, Позиция + 1);
		ПозицияКонца = СтрНайти(Фрагмент, """");
		Если ПозицияКонца > 1 Тогда
			Возврат Лев(Фрагмент, ПозицияКонца - 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "СообщениеОбмена";
	
КонецФункции

Функция СериализоватьПустуюСтруктуру()
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Новый Структура, НазначениеТипаXML.Явное);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

#КонецОбласти

