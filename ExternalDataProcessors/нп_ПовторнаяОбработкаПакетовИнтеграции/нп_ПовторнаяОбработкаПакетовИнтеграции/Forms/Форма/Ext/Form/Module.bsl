#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	
	Период.Вариант = ВариантСтандартногоПериода.Последние7Дней;
	ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogEmployees;
	Лимит = 100;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиПакеты(Команда)
	
	НайтиПакетыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыбранные(Команда)
	
	ЕстьОтмеченные = Ложь;
	Для Каждого СтрокаТаблицы Из НайденныеПакеты Цикл
		Если СтрокаТаблицы.Пометка Тогда
			ЕстьОтмеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьОтмеченные И Не ЗначениеЗаполнено(ТекстПакета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте пакеты в таблице или вставьте JSON в поле «Текст пакета».'"));
		Возврат;
	КонецЕсли;
	
	ОбработатьВыбранныеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Для Каждого СтрокаТаблицы Из НайденныеПакеты Цикл
		СтрокаТаблицы.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для Каждого СтрокаТаблицы Из НайденныеПакеты Цикл
		СтрокаТаблицы.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПакет(Команда)
	
	ТекущиеДанные = Элементы.НайденныеПакеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку пакета.'"));
		Возврат;
	КонецЕсли;
	
	ПоказатьПакетНаСервере(ТекущиеДанные.ВидИнтеграции, ТекущиеДанные.Ключ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиПакетыНаСервере()
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Укажите период поиска.'"));
		Возврат;
	КонецЕсли;
	
	ДатаОкончания = Период.ДатаОкончания;
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	Иначе
		ДатаОкончания = КонецДня(ДатаОкончания);
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ДатаНачала", Период.ДатаНачала);
	ПараметрыПоиска.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыПоиска.Вставить("ВидСообщения", ВидСообщения);
	ПараметрыПоиска.Вставить("ИДСообщения", ИДСообщения);
	ПараметрыПоиска.Вставить("БазаРеспондентИД", БазаРеспондентИД);
	ПараметрыПоиска.Вставить("СтрокаПоиска", СтрокаПоиска);
	ПараметрыПоиска.Вставить("Лимит", Лимит);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаПакетов = ОбработкаОбъект.НайтиПакетыВЛоге(ПараметрыПоиска);
	
	НайденныеПакеты.Очистить();
	Для Каждого СтрокаПакета Из ТаблицаПакетов Цикл
		НоваяСтрока = НайденныеПакеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПакета, , "ВидСообщения");
		НоваяСтрока.ВидСообщения = Строка(СтрокаПакета.ВидСообщения);
		НоваяСтрока.Пометка = Ложь;
		НоваяСтрока.РезультатОбработки = "";
	КонецЦикла;
	
	Если НайденныеПакеты.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Пакеты не найдены. Проверьте период, отбор и что у профиля интеграции включено логирование.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыбранныеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработаноСтрок = 0;
	
	Для Каждого СтрокаТаблицы Из НайденныеПакеты Цикл
		Если Не СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЛога = ОбработкаОбъект.ТекстВходящегоПакета(СтрокаТаблицы.ВидИнтеграции, СтрокаТаблицы.Ключ);
		СтрокаТаблицы.РезультатОбработки = ОбработкаОбъект.ОбработатьТекстПакета(
			ТекстЛога,
			ПоставитьВОчередь,
			СтрокаТаблицы.ИДСообщения,
			СтрокаТаблицы.БазаРеспондентИД,
			СтрокаТаблицы.ВидСообщения);
		ОбработаноСтрок = ОбработаноСтрок + 1;
	КонецЦикла;
	
	Если ОбработаноСтрок = 0 И ЗначениеЗаполнено(ТекстПакета) Тогда
		Результат = ОбработкаОбъект.ОбработатьТекстПакета(
			ТекстПакета,
			ПоставитьВОчередь,
			ИДСообщения,
			БазаРеспондентИД,
			ВидСообщения);
		ОбщегоНазначения.СообщитьПользователю(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПакетНаСервере(ВидИнтеграции, Ключ)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекстПакета = ОбработкаОбъект.ТекстВходящегоПакета(ВидИнтеграции, Ключ);
	
КонецПроцедуры

#КонецОбласти
