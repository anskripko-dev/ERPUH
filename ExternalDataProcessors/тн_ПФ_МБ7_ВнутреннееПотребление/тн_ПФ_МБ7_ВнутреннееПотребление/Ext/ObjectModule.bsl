#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.359");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.2.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Ведомость учета выдачи спецодежды МБ-7 (внешняя)'");
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Внешняя печатная форма МБ-7 для документа «Внутреннее потребление» с операцией «Передача в эксплуатацию» (ERP.2026.10).'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Назначение.Добавить("Документ.ВнутреннееПотребление");
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Ведомость учета выдачи спецодежды МБ-7 (внешняя)'");
	Команда.Идентификатор = "МБ7Внешняя";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;
	Команда.Модификатор = "ПечатьMXL";
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// СтандартныеПодсистемы.Печать

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ВнутреннееПотребление
//  КоллекцияПечатныхФорм - ТаблицаЗначений
//  ОбъектыПечати - СписокЗначений
//  ПараметрыВывода - Структура
//
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "МБ7Внешняя");
	Если ПечатнаяФорма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// ERP.2026.10: фильтр по операции (в типовой Обработка.ПечатьОбщихФормТМЦВЭксплуатации — без отбора).
	ОбъектыКПечати = ОбъектыПередачиВЭксплуатацию(МассивОбъектов);
	Если ОбъектыКПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПечатнаяФорма.ТабличныйДокумент = СформироватьПечатнуюФормуМБ7(ОбъектыКПечати, ОбъектыПечати);
	ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Ведомость учета выдачи спецодежды МБ-7 (внешняя)'");
	ПечатнаяФорма.ПолныйПутьКМакету = "";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Не из типовой. Фильтр документов по операции «Передача в эксплуатацию» (ERP.2026.10).
//
Функция ОбъектыПередачиВЭксплуатацию(МассивОбъектов)
	
	Результат = Новый Массив;
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивОбъектов, "ХозяйственнаяОперация");
	ОперацияПередачаВЭксплуатацию = Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию;
	ШаблонСообщения = НСтр(
		"ru = 'Печатная форма «Ведомость учета выдачи спецодежды МБ-7 (внешняя)» доступна только для операции «Передача в эксплуатацию». Документ %1 пропущен.'");
	
	Для Каждого СсылкаДокумента Из МассивОбъектов Цикл
		
		ХозяйственнаяОперация = ЗначенияОпераций.Получить(СсылкаДокумента);
		Если ХозяйственнаяОперация = ОперацияПередачаВЭксплуатацию Тогда
			Результат.Добавить(СсылкаДокумента);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаДокумента),
				СсылкаДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// На базе Обработка.ПечатьОбщихФормТМЦВЭксплуатации.СформироватьПечатнуюФормуМБ7.
//
// Отличия от типовой:
//  - только Документ.ВнутреннееПотребление (без цикла по СтруктураТипов / менеджеру локализации);
//  - дополнительно собираются ДополнительныеДанныеДокументов (подписи, примечание);
//  - имя параметров печати: ПАРАМЕТРЫ_ПЕЧАТИ_МБ7_Внешняя.
//
Функция СформироватьПечатнуюФормуМБ7(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	// ERP.2026.10: своё имя параметров печати (в типовой — ПАРАМЕТРЫ_ПЕЧАТИ_МБ7).
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_МБ7_Внешняя";
	
	// ERP.2026.10: сразу данные ВП (в типовой — цикл по СтруктураТипов и менеджер локализации).
	ДанныеДляПечати = ВнутреннееПотреблениеЛокализация.ДанныеДляПечатнойФормыМБ7(МассивОбъектов);
	// ERP.2026.10: доп. данные для подписей / примечания (в типовой нет).
	ДопДанныеПоДокументам = ДополнительныеДанныеДокументов(МассивОбъектов);
	
	ЗаполнитьТабличныйДокументМБ7(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДопДанныеПоДокументам);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Не из типовой. Данные для подписей МОЛ, руководителя и примечания (ERP.2026.10).
//
Функция ДополнительныеДанныеДокументов(МассивОбъектов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата,
	|	Документы.Организация КАК Организация,
	|	Документы.Подразделение КАК Подразделение,
	|	Документы.Подразделение.ТекущийРуководитель КАК РуководительПодразделения
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.ВнутреннееПотребление КАК Документы
	|ГДЕ
	|	Документы.Ссылка В (&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТДокументы.Организация КАК Организация,
	|	ВТДокументы.Дата КАК Дата
	|ПОМЕСТИТЬ ВТМОЛ
	|ИЗ
	|	Документ.ВнутреннееПотребление.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДокументы КАК ВТДокументы
	|		ПО Товары.Ссылка = ВТДокументы.Ссылка
	|ГДЕ
	|	Товары.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТМОЛ.ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ВТФизЛица
	|ИЗ
	|	ВТМОЛ КАК ВТМОЛ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТДокументы.РуководительПодразделения
	|ИЗ
	|	ВТДокументы КАК ВТДокументы
	|ГДЕ
	|	ВТДокументы.РуководительПодразделения <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТекущиеКадровыеДанные.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(ТекущиеКадровыеДанные.ТекущаяДолжность) КАК Должность,
	|	ТекущиеКадровыеДанные.ТекущаяОрганизация КАК ТекущаяОрганизация,
	|	ТекущиеКадровыеДанные.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанные.ОсновноеРабочееМестоВОрганизации КАК ОсновноеРабочееМестоВОрганизации,
	|	ТекущиеКадровыеДанные.ДатаПриема КАК ДатаПриема
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТФизЛица КАК ВТФизЛица
	|		ПО ТекущиеКадровыеДанные.ФизическоеЛицо = ВТФизЛица.ФизическоеЛицо
	|ГДЕ
	|	ТекущиеКадровыеДанные.ТекущаяДолжность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо,
	|	ОсновноеРабочееМестоВОрганизации УБЫВ,
	|	ДатаПриема УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура) КАК НоменклатураПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Товары.СтатьяРасходов) КАК СтатьяСписанияПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Товары.АналитикаРасходов) КАК АналитикаРасходовПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Товары.АналитикаАктивовПассивов) КАК АналитикаАктивовПассивовПредставление
	|ИЗ
	|	Документ.ВнутреннееПотребление.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТМОЛ.Ссылка КАК Ссылка,
	|	ВТМОЛ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТМОЛ.Организация КАК Организация,
	|	ВТМОЛ.Дата КАК Дата,
	|	МИНИМУМ(ВТМОЛ.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	ВТМОЛ КАК ВТМОЛ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТМОЛ.Ссылка,
	|	ВТМОЛ.ФизическоеЛицо,
	|	ВТМОЛ.Организация,
	|	ВТМОЛ.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДокументы.Ссылка КАК Ссылка,
	|	ВТДокументы.Дата КАК Дата,
	|	ВТДокументы.Организация КАК Организация,
	|	ВТДокументы.Подразделение КАК Подразделение,
	|	ВТДокументы.РуководительПодразделения КАК РуководительПодразделения
	|ИЗ
	|	ВТДокументы КАК ВТДокументы";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Результаты = Запрос.ВыполнитьПакет();
	
	// Пакет: [0..2] — ВТ, [3] — должности, [4] — товары примечания, [5] — МОЛ, [6] — шапки.
	ТаблицаДолжностей = Результаты[3].Выгрузить();
	ТаблицаДолжностей.Индексы.Добавить("ФизическоеЛицо");
	
	ТаблицаТоваров = Результаты[4].Выгрузить();
	ТаблицаТоваров.Индексы.Добавить("Ссылка");
	
	ТаблицаМОЛ = Результаты[5].Выгрузить();
	ТаблицаМОЛ.Индексы.Добавить("Ссылка");
	
	ВыборкаШапка = Результаты[6].Выбрать();
	Пока ВыборкаШапка.Следующий() Цикл
		
		СтрокиТоваров = СтрокиПримечания(ТаблицаТоваров, ВыборкаШапка.Ссылка);
		СписокМОЛ = СписокМОЛДокумента(ТаблицаМОЛ, ВыборкаШапка, ТаблицаДолжностей);
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Дата", ВыборкаШапка.Дата);
		ДанныеДокумента.Вставить("Организация", ВыборкаШапка.Организация);
		ДанныеДокумента.Вставить("Подразделение", ВыборкаШапка.Подразделение);
		ДанныеДокумента.Вставить("Товары", СтрокиТоваров);
		ДанныеДокумента.Вставить("МОЛ", СписокМОЛ);
		ДанныеДокумента.Вставить("ДолжностьРуководителя", ДолжностьИзТаблицы(
			ТаблицаДолжностей,
			ВыборкаШапка.РуководительПодразделения,
			ВыборкаШапка.Организация));
		
		Результат.Вставить(ВыборкаШапка.Ссылка, ДанныеДокумента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Не из типовой. Строки раздела «Примечание» (ERP.2026.10).
//
Функция СтрокиПримечания(ТаблицаТоваров, СсылкаДокумента)
	
	СтрокиТоваров = Новый Массив;
	НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ссылка", СсылкаДокумента));
	
	Для Каждого СтрокаТовара Из НайденныеСтроки Цикл
		
		АналитикаПредставление = "";
		Если ЗначениеЗаполнено(СтрокаТовара.АналитикаРасходовПредставление)
			И Строка(СтрокаТовара.АналитикаРасходовПредставление) <> "" Тогда
			АналитикаПредставление = Строка(СтрокаТовара.АналитикаРасходовПредставление);
		ИначеЕсли ЗначениеЗаполнено(СтрокаТовара.АналитикаАктивовПассивовПредставление)
			И Строка(СтрокаТовара.АналитикаАктивовПассивовПредставление) <> "" Тогда
			АналитикаПредставление = Строка(СтрокаТовара.АналитикаАктивовПассивовПредставление);
		КонецЕсли;
		
		СтрокаДляПечати = Новый Структура;
		СтрокаДляПечати.Вставить("НоменклатураПредставление", Строка(СтрокаТовара.НоменклатураПредставление));
		СтрокаДляПечати.Вставить("СтатьяСписанияПредставление", Строка(СтрокаТовара.СтатьяСписанияПредставление));
		СтрокаДляПечати.Вставить("АналитикаПредставление", АналитикаПредставление);
		СтрокиТоваров.Добавить(СтрокаДляПечати);
		
	КонецЦикла;
	
	Возврат СтрокиТоваров;
	
КонецФункции

// Не из типовой. МОЛ по каждому физлицу из ТЧ Товары (ERP.2026.10).
//
Функция СписокМОЛДокумента(ТаблицаМОЛ, ВыборкаШапка, ТаблицаДолжностей)
	
	СписокМОЛ = Новый Массив;
	НайденныеСтроки = ТаблицаМОЛ.НайтиСтроки(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
	
	Для Каждого СтрокаМОЛ Из НайденныеСтроки Цикл
		
		ДанныеМОЛ = Новый Структура;
		ДанныеМОЛ.Вставить("ФИО", ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(
			СтрокаМОЛ.ФизическоеЛицо,
			ВыборкаШапка.Дата));
		ДанныеМОЛ.Вставить("Должность", ДолжностьИзТаблицы(
			ТаблицаДолжностей,
			СтрокаМОЛ.ФизическоеЛицо,
			ВыборкаШапка.Организация));
		СписокМОЛ.Добавить(ДанныеМОЛ);
		
	КонецЦикла;
	
	Возврат СписокМОЛ;
	
КонецФункции

// Не из типовой. Должность из заранее загруженной таблицы кадровых данных (как в тн_ПФ_М11).
//
Функция ДолжностьИзТаблицы(ТаблицаДолжностей, ФизическоеЛицо, Организация)
	
	СтрокиКадровых = ТаблицаДолжностей.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
	Если СтрокиКадровых.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого СтрокаКадровых Из СтрокиКадровых Цикл
		
		Если ЗначениеЗаполнено(Организация)
			И СтрокаКадровых.ТекущаяОрганизация <> Организация
			И СтрокаКадровых.ГоловнаяОрганизация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат СокрЛП(Строка(СтрокаКадровых.Должность));
		
	КонецЦикла;
	
	Возврат СокрЛП(Строка(СтрокиКадровых[0].Должность));
	
КонецФункции

// На базе Обработка.ПечатьОбщихФормТМЦВЭксплуатации.ЗаполнитьТабличныйДокументМБ7.
//
// Отличия от типовой:
//  - макет из внешней обработки ПолучитьМакет("ПФ_MXL_МБ7_ru");
//  - подписи МОЛ: отдельная строка на каждое физлицо из Товары;
//  - после подписей: раздел «Примечание».
//
Процедура ЗаполнитьТабличныйДокументМБ7(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДопДанныеПоДокументам)
	
	ШаблонОшибкиПустойТЧ = НСтр("ru = 'В документе %1 отсутствуют товары. Печать МБ-7 не требуется'");
	
	Макет = ПолучитьМакет("ПФ_MXL_МБ7_ru");
	Макет.КодЯзыка = Метаданные.Языки.Русский.КодЯзыка;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
	ОбластьПодписьМОЛ = Макет.ПолучитьОбласть("ПодписьМОЛ");
	ОбластьПодписьРуководитель = Макет.ПолучитьОбласть("ПодписьРуководитель");
	
	ВыборкаДокументы = ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ВыборкаСтрокиПоДокументам = ДанныеДляПечати.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ВыборкаСтрокиПоДокументам.Сбросить();
		Если Не ВыборкаСтрокиПоДокументам.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументы.Ссылка)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонОшибкиПустойТЧ,
					ВыборкаДокументы.Ссылка),
				ВыборкаДокументы.Ссылка);
			Продолжить;
		КонецЕсли;
		
		ДопДанные = ДопДанныеПоДокументам.Получить(ВыборкаДокументы.Ссылка);
		Если ДопДанные = Неопределено Тогда
			ДопДанные = ПустыеДополнительныеДанные();
		КонецЕсли;
		
		ВыборкаСтроки = ВыборкаСтрокиПоДокументам.Выбрать();
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаДокументы);
		ОбластьШапка.Параметры.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокументы.Номер);
		ОбластьШапка.Параметры.ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(
			ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ВыборкаДокументы.Организация, ВыборкаДокументы.ДатаДокумента));
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		// Типовая ТЧ — без изменений.
		Пока ВыборкаСтроки.Следующий() Цикл
			
			ОбластьСтрокаТаблицы.Параметры.Заполнить(ВыборкаСтроки);
			Если ЗначениеЗаполнено(ВыборкаСтроки.ХарактеристикаНаименование) Тогда
				НоменклатураНаименование = СтрШаблон("%1 (%2)",
					ВыборкаСтроки.НоменклатураНаименование,
					ВыборкаСтроки.ХарактеристикаНаименование);
				ОбластьСтрокаТаблицы.Параметры.НоменклатураНаименование = НоменклатураНаименование;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
			
		КонецЦикла;
		
		// ERP.2026.10: отдельная строка подписи МОЛ на каждое физлицо.
		Для Каждого ДанныеМОЛ Из ДопДанные.МОЛ Цикл
			
			ОбластьПодписьМОЛ.Параметры.МОЛДолжность = ДанныеМОЛ.Должность;
			ОбластьПодписьМОЛ.Параметры.МОЛФИО = ДанныеМОЛ.ФИО;
			ТабличныйДокумент.Вывести(ОбластьПодписьМОЛ);
			
		КонецЦикла;
		
		ОбластьПодписьРуководитель.Параметры.ДолжностьРуководителяПодразделения = ДопДанные.ДолжностьРуководителя;
		ОбластьПодписьРуководитель.Параметры.РуководительПодразделения = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(
			ВыборкаДокументы.РуководительПодразделения,
			ВыборкаДокументы.ДатаДокумента);
		ТабличныйДокумент.Вывести(ОбластьПодписьРуководитель);
		
		ВывестиПримечание(ТабличныйДокумент, Макет, ДопДанные.Товары);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

// Не из типовой. Заглушка доп. данных документа (ERP.2026.10).
//
Функция ПустыеДополнительныеДанные()
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Дата", '00010101');
	ДанныеДокумента.Вставить("Организация", Неопределено);
	ДанныеДокумента.Вставить("Подразделение", Неопределено);
	ДанныеДокумента.Вставить("Товары", Новый Массив);
	ДанныеДокумента.Вставить("МОЛ", Новый Массив);
	ДанныеДокумента.Вставить("ДолжностьРуководителя", "");
	Возврат ДанныеДокумента;
	
КонецФункции

// Не из типовой. Раздел «Примечание» (области макета внешней обработки) (ERP.2026.10).
//
Процедура ВывестиПримечание(ТабличныйДокумент, Макет, СтрокиТоваров)
	
	Если СтрокиТоваров = Неопределено Или СтрокиТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПримечаниеЗаголовок"));
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ПримечаниеШапка"));
	
	Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("ПримечаниеСтрока");
		ОбластьСтрока.Параметры.МатериальнаяЦенность = Строка(СтрокаТовара.НоменклатураПредставление);
		ОбластьСтрока.Параметры.СтатьяСписания = Строка(СтрокаТовара.СтатьяСписанияПредставление);
		ОбластьСтрока.Параметры.Аналитика = Строка(СтрокаТовара.АналитикаПредставление);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

