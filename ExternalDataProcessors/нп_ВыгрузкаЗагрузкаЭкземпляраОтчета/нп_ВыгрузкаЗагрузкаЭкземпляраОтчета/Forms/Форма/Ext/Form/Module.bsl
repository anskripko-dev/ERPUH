#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки
	
	ТолькоАктивныеВерсии = Истина;
	ВыгружатьЧерновыеВерсии = Ложь;
	ЗамещатьСуществующие = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ВыгрузитьВФайл(Команда)
	
	МассивСсылок = СсылкиЭкземпляров();
	Если МассивСсылок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите хотя бы один экземпляр отчета.'"));
		Возврат;
	КонецЕсли;
	
	Адрес = ВыгрузитьНаСервере(МассивСсылок);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Сохранить файл экземпляра отчета'");
	Диалог.ПолноеИмяФайла = ИмяФайлаВыгрузкиПоУмолчанию(МассивСсылок);
	Диалог.Фильтр = НСтр("ru = 'Файл экземпляра отчета (*.xml)|*.xml'");
	Диалог.Расширение = "xml";
	Диалог.МножественныйВыбор = Ложь;
	
	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	Если ТипЗнч(ВыбранныеФайлы) <> Тип("Массив") Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = ИмяФайлаСРасширениемXML(ВыбранныеФайлы[0]);
	Ждать ПолучитьФайлССервераАсинх(Адрес, ИмяФайла);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Выгрузка завершена'"), , ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьИзФайла(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файл экземпляра отчета'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Файл экземпляра отчета (*.xml)|*.xml'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;
	
	Результат = Ждать ПоместитьФайлНаСерверАсинх(,,, ПараметрыДиалога, УникальныйИдентификатор);
	Если Результат = Неопределено Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Адрес) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось поместить файл во временное хранилище.'"));
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНаСервере(Результат.Адрес);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Загрузка завершена'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СсылкиЭкземпляров()
	
	МассивСсылок = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из Экземпляры Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ЭкземплярОтчета) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивСсылок.Найти(СтрокаТаблицы.ЭкземплярОтчета) = Неопределено Тогда
			МассивСсылок.Добавить(СтрокаТаблицы.ЭкземплярОтчета);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСсылок;
	
КонецФункции

&НаКлиенте
Функция ИмяФайлаВыгрузкиПоУмолчанию(МассивСсылок)
	
	Если МассивСсылок.Количество() = 1 Тогда
		Возврат "ЭкземплярОтчета.xml";
	КонецЕсли;
	
	Возврат "ЭкземплярыОтчетов.xml";
	
КонецФункции

&НаКлиенте
Функция ИмяФайлаСРасширениемXML(ИмяФайла)
	
	Если СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".xml") Тогда
		Возврат ИмяФайла;
	КонецЕсли;
	
	Возврат ИмяФайла + ".xml";
	
КонецФункции

&НаСервере
Функция ВыгрузитьНаСервере(МассивСсылок)
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("ТолькоАктивныеВерсии", ТолькоАктивныеВерсии);
	ПараметрыВыгрузки.Вставить("ВыгружатьЧерновыеВерсии", ВыгружатьЧерновыеВерсии);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Результат = ОбработкаОбъект.ВыгрузитьВДвоичныеДанные(МассивСсылок, ПараметрыВыгрузки);
	Исключение
		Протокол = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Протокол = Результат.Протокол;
	
	Возврат ПоместитьВоВременноеХранилище(Результат.ДвоичныеДанные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНаСервере(АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось получить файл с клиента.'");
	КонецЕсли;
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ЗамещатьСуществующие", ЗамещатьСуществующие);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Результат = ОбработкаОбъект.ЗагрузитьИзДвоичныхДанных(ДвоичныеДанные, ПараметрыЗагрузки);
		Протокол = Результат.Протокол;
	Исключение
		Протокол = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
