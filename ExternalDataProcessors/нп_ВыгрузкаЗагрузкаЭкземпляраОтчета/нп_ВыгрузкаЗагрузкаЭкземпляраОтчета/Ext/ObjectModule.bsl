#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

// Возвращает сведения о внешней обработке.
//
// Возвращаемое значение:
//  см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.359");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.6";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Выгрузка / загрузка экземпляра отчета'");
	ПараметрыРегистрации.Информация = НСтр(
		"ru = 'Перенос документа «Экземпляр отчета» вместе со значениями показателей через XML-файл.
		|Выгружает документ, версии и регистры ЗначенияПоказателейОтчетов*.'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Выгрузка / загрузка экземпляра отчета'");
	Команда.Идентификатор = "ВыгрузкаЗагрузкаЭкземпляраОтчета";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Конец СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки

#КонецОбласти

// Выгружает экземпляры отчетов вместе с версиями и значениями показателей в двоичные данные XML.
//
// Параметры:
//  ЭкземплярыОтчетов - Массив из ДокументСсылка.НастраиваемыйОтчет
//  ПараметрыВыгрузки - Структура:
//   * ТолькоАктивныеВерсии - Булево
//   * ВыгружатьЧерновыеВерсии - Булево
//
// Возвращаемое значение:
//  Структура:
//   * ДвоичныеДанные - ДвоичныеДанные
//   * Протокол - Строка
//
Функция ВыгрузитьВДвоичныеДанные(ЭкземплярыОтчетов, ПараметрыВыгрузки) Экспорт
	
	Протокол = Новый Массив;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяКорняПакета());
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
		ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
		ЗаписьXML.ЗаписатьАтрибут("ВерсияФормата", ВерсияФорматаПакета());
		ЗаписьXML.ЗаписатьАтрибут("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
		
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		
		ЗаписатьОписаниеЭкземпляров(ЗаписьXML, ЭкземплярыОтчетов);
		
		КоличествоДокументов = 0;
		Для Каждого ЭкземплярОтчета Из ЭкземплярыОтчетов Цикл
			ЗаписатьСсылкуВXML(ЗаписьXML, Сериализатор, ЭкземплярОтчета, Протокол, КоличествоДокументов);
		КонецЦикла;
		
		ТаблицаВерсий = ВерсииЭкземпляров(ЭкземплярыОтчетов, ПараметрыВыгрузки);
		ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Отобрано версий: %1'"), ТаблицаВерсий.Количество()));
		
		ОписанияВерсий = Новый Соответствие;
		Для Каждого СтрокаВерсии Из ТаблицаВерсий Цикл
			Если ЗначениеЗаполнено(СтрокаВерсии.ОписаниеВерсий) Тогда
				ОписанияВерсий.Вставить(СтрокаВерсии.ОписаниеВерсий, Истина);
			КонецЕсли;
		КонецЦикла;
		
		КоличествоОписаний = 0;
		Для Каждого КлючИЗначение Из ОписанияВерсий Цикл
			ЗаписатьСсылкуВXML(ЗаписьXML, Сериализатор, КлючИЗначение.Ключ, Протокол, КоличествоОписаний);
		КонецЦикла;
		
		КоличествоВерсий = 0;
		Для Каждого СтрокаВерсии Из ТаблицаВерсий Цикл
			ЗаписатьСсылкуВXML(ЗаписьXML, Сериализатор, СтрокаВерсии.Версия, Протокол, КоличествоВерсий);
		КонецЦикла;
		
		КоличествоНаборов = 0;
		КоличествоЗаписей = 0;
		ИменаРегистров = ИменаРегистровЗначенийПоказателей();
		Для Каждого СтрокаВерсии Из ТаблицаВерсий Цикл
			ВыгрузитьНаборыВерсии(ЗаписьXML, Сериализатор, СтрокаВерсии.Версия, ИменаРегистров,
				КоличествоНаборов, КоличествоЗаписей);
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.Закрыть();
		
		ДобавитьВПротокол(Протокол, СтрШаблон(
			НСтр("ru = 'Выгружено: документов %1, описаний версий %2, версий %3, наборов регистра %4, записей %5'"),
			КоличествоДокументов, КоличествоОписаний, КоличествоВерсий, КоличествоНаборов, КоличествоЗаписей));
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
	Исключение
		
		Попытка
			ЗаписьXML.Закрыть();
		Исключение
			// Файл мог быть ещё не открыт.
		КонецПопытки;
		УдалитьФайлЕслиСуществует(ИмяВременногоФайла);
		ВызватьИсключение;
		
	КонецПопытки;
	
	УдалитьФайлЕслиСуществует(ИмяВременногоФайла);
	
	Результат = Новый Структура;
	Результат.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	Результат.Вставить("Протокол", СтрСоединить(Протокол, Символы.ПС));
	Возврат Результат;
	
КонецФункции

// Загружает XML-пакет экземпляров отчетов в текущую информационную базу.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные
//  ПараметрыЗагрузки - Структура:
//   * ЗамещатьСуществующие - Булево
//
// Возвращаемое значение:
//  Структура:
//   * Протокол - Строка
//
Функция ЗагрузитьИзДвоичныхДанных(ДвоичныеДанные, ПараметрыЗагрузки) Экспорт
	
	Протокол = Новый Массив;
	ДобавитьВПротокол(Протокол, НСтр("ru = 'Обработка версии 1.6: перед записью цифр удаляются прежние версии экземпляра.'"));
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Статистика = Новый Структура;
	Статистика.Вставить("Документов", 0);
	Статистика.Вставить("Справочников", 0);
	Статистика.Вставить("Наборов", 0);
	Статистика.Вставить("Записей", 0);
	Статистика.Вставить("Пропущено", 0);
	Статистика.Вставить("Предупреждений", 0);
	Статистика.Вставить("УдаленоВерсий", 0);
	Статистика.Вставить("УдаленоОписаний", 0);
	
	ОчищенныеЭкземпляры = Новый Соответствие;
	
	НачатьТранзакцию();
	Попытка
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		ЧтениеXML.ПерейтиКСодержимому();
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
			Или ЧтениеXML.ЛокальноеИмя <> ИмяКорняПакета() Тогда
			ВызватьИсключение НСтр("ru = 'Неверный формат файла: ожидается пакет экземпляров отчетов.'");
		КонецЕсли;
		
		ВерсияФормата = ЧтениеXML.ПолучитьАтрибут("ВерсияФормата");
		Если ВерсияФормата <> ВерсияФорматаПакета() Тогда
			ДобавитьВПротокол(Протокол, СтрШаблон(
				НСтр("ru = 'Предупреждение: версия формата файла %1, ожидалась %2'"),
				ВерсияФормата, ВерсияФорматаПакета()));
			Статистика.Предупреждений = Статистика.Предупреждений + 1;
		КонецЕсли;
		
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		ЧтениеXML.Прочитать();
		
		Пока Истина Цикл
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если ЧтениеXML.ЛокальноеИмя = ИмяКорняПакета() Тогда
					Прервать;
				КонецЕсли;
				Если Не ЧтениеXML.Прочитать() Тогда
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Если Не ЧтениеXML.Прочитать() Тогда
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Если ЧтениеXML.ЛокальноеИмя = "Описание" Тогда
				ОчиститьПоказателиПоОписаниюПакета(ЧтениеXML, ОчищенныеЭкземпляры, Статистика, Протокол);
				Продолжить;
			КонецЕсли;
			
			Объект = ПрочитатьОбъектПакета(ЧтениеXML, Сериализатор, Статистика, Протокол);
			Если Объект <> Неопределено Тогда
				ЗаписатьЗагруженныйОбъект(Объект, ПараметрыЗагрузки, Статистика, Протокол, ОчищенныеЭкземпляры);
			КонецЕсли;
			
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Попытка
			ЧтениеXML.Закрыть();
		Исключение
			// Чтение могло быть ещё не начато.
		КонецПопытки;
		УдалитьФайлЕслиСуществует(ИмяВременногоФайла);
		ВызватьИсключение;
		
	КонецПопытки;
	
	УдалитьФайлЕслиСуществует(ИмяВременногоФайла);
	
	Если Статистика.Документов + Статистика.Справочников + Статистика.Наборов = 0 Тогда
		ДобавитьВПротокол(Протокол, НСтр(
			"ru = 'В файле не записано ни одного объекта. Нужна обработка версии 1.6+. Пересоберите .epf из исходников.'"));
	КонецЕсли;
	
	ДобавитьВПротокол(Протокол, СтрШаблон(
		НСтр("ru = 'Загружено: документов %1, справочников %2, наборов регистра %3, записей %4. Пропущено %5, предупреждений %6. Удалено прежних версий %7, описаний %8'"),
		Статистика.Документов,
		Статистика.Справочников,
		Статистика.Наборов,
		Статистика.Записей,
		Статистика.Пропущено,
		Статистика.Предупреждений,
		Статистика.УдаленоВерсий,
		Статистика.УдаленоОписаний));
	
	Результат = Новый Структура;
	Результат.Вставить("Протокол", СтрСоединить(Протокол, Символы.ПС));
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяКорняПакета()
	
	Возврат "нп_ПакетЭкземпляровОтчетов";
	
КонецФункции

Функция ВерсияФорматаПакета()
	
	Возврат "1.0";
	
КонецФункции

Функция ВерсииЭкземпляров(ЭкземплярыОтчетов, ПараметрыВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсииЗначенийПоказателей.Ссылка КАК Версия,
	|	ВерсииЗначенийПоказателей.Владелец КАК ОписаниеВерсий
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
	|ГДЕ
	|	(ВерсииЗначенийПоказателей.ЭкземплярОтчета В (&ЭкземплярыОтчетов)
	|		ИЛИ ВерсииЗначенийПоказателей.Регистратор В (&ЭкземплярыОтчетов))
	|	И НЕ ВерсииЗначенийПоказателей.ПометкаУдаления";
	
	Если ПараметрыВыгрузки.ТолькоАктивныеВерсии Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ВерсииЗначенийПоказателей.Активность";
	КонецЕсли;
	
	Если Не ПараметрыВыгрузки.ВыгружатьЧерновыеВерсии Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ ВерсииЗначенийПоказателей.ЧерноваяВерсия";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЭкземплярыОтчетов", ЭкземплярыОтчетов);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ИменаРегистровЗначенийПоказателей()
	
	ИменаРегистров = Новый Массив;
	
	Для Каждого РегистрСведений Из Метаданные.РегистрыСведений Цикл
		
		Если РегистрСведений.Измерения.Найти("Версия") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНачинаетсяС(РегистрСведений.Имя, "ЗначенияПоказателейОтчетов")
			Или СтрНачинаетсяС(РегистрСведений.Имя, "ЗначенияПоказателейМоделирование")
			Или РегистрСведений.Имя = "КомментарииЗначенийПоказателей" Тогда
			ИменаРегистров.Добавить(РегистрСведений.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИменаРегистров;
	
КонецФункции

Процедура ЗаписатьОписаниеЭкземпляров(ЗаписьXML, ЭкземплярыОтчетов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастраиваемыйОтчет.Ссылка КАК Ссылка,
	|	НастраиваемыйОтчет.Номер КАК Номер,
	|	НастраиваемыйОтчет.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(НастраиваемыйОтчет.Ссылка) КАК Представление,
	|	ПРЕДСТАВЛЕНИЕ(НастраиваемыйОтчет.ВидОтчета) КАК ВидОтчета,
	|	ПРЕДСТАВЛЕНИЕ(НастраиваемыйОтчет.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(НастраиваемыйОтчет.ПериодОтчета) КАК ПериодОтчета,
	|	ПРЕДСТАВЛЕНИЕ(НастраиваемыйОтчет.Сценарий) КАК Сценарий
	|ИЗ
	|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
	|ГДЕ
	|	НастраиваемыйОтчет.Ссылка В (&ЭкземплярыОтчетов)";
	Запрос.УстановитьПараметр("ЭкземплярыОтчетов", ЭкземплярыОтчетов);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Описание");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Экземпляр");
		ЗаписьXML.ЗаписатьАтрибут("УИД", XMLСтрока(Выборка.Ссылка.УникальныйИдентификатор()));
		ЗаписьXML.ЗаписатьАтрибут("Номер", Строка(Выборка.Номер));
		ЗаписьXML.ЗаписатьАтрибут("Дата", XMLСтрока(Выборка.Дата));
		ЗаписьXML.ЗаписатьАтрибут("Представление", Строка(Выборка.Представление));
		ЗаписьXML.ЗаписатьАтрибут("ВидОтчета", Строка(Выборка.ВидОтчета));
		ЗаписьXML.ЗаписатьАтрибут("Организация", Строка(Выборка.Организация));
		ЗаписьXML.ЗаписатьАтрибут("ПериодОтчета", Строка(Выборка.ПериодОтчета));
		ЗаписьXML.ЗаписатьАтрибут("Сценарий", Строка(Выборка.Сценарий));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьСсылкуВXML(ЗаписьXML, Сериализатор, Ссылка, Протокол, Счетчик)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Не удалось получить объект %1'"), Ссылка));
		Возврат;
	КонецЕсли;
	
	Сериализатор.ЗаписатьXML(ЗаписьXML, Объект, НазначениеТипаXML.Явное);
	Счетчик = Счетчик + 1;
	
КонецПроцедуры

Процедура ВыгрузитьНаборыВерсии(ЗаписьXML, Сериализатор, Версия, ИменаРегистров, КоличествоНаборов, КоличествоЗаписей)
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Версия.Установить(Версия);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоЗаписей = КоличествоЗаписей + НаборЗаписей.Количество();
		Сериализатор.ЗаписатьXML(ЗаписьXML, НаборЗаписей, НазначениеТипаXML.Явное);
		КоличествоНаборов = КоличествоНаборов + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЗагруженныйОбъект(Объект, ПараметрыЗагрузки, Статистика, Протокол, ОчищенныеЭкземпляры)
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		ЗаписатьДокументЗагрузки(Объект, ПараметрыЗагрузки, Статистика, Протокол, ОчищенныеЭкземпляры);
	ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
		ЗаписатьСправочникЗагрузки(Объект, Статистика, Протокол);
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) Тогда
		ЗаписатьНаборРегистраЗагрузки(Объект, Статистика, Протокол);
	Иначе
		ДобавитьВПротокол(Протокол, СтрШаблон(
			НСтр("ru = 'Пропущен неизвестный тип объекта: %1'"), МетаданныеОбъекта.ПолноеИмя()));
		Статистика.Пропущено = Статистика.Пропущено + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьДокументЗагрузки(Объект, ПараметрыЗагрузки, Статистика, Протокол, ОчищенныеЭкземпляры)
	
	ОчиститьПоказателиЭкземпляраЕслиНужно(Объект.Ссылка, ОчищенныеЭкземпляры, Статистика, Протокол);
	
	Если Не ПараметрыЗагрузки.ЗамещатьСуществующие И ЗначениеЗаполнено(Объект.Ссылка)
		И ОбщегоНазначения.СсылкаСуществует(Объект.Ссылка) Тогда
		ДобавитьВПротокол(Протокол, СтрШаблон(
			НСтр("ru = 'Документ уже есть, шапка не заменена: %1'"), Объект.Ссылка));
		Статистика.Пропущено = Статистика.Пропущено + 1;
		Возврат;
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Статистика.Документов = Статистика.Документов + 1;
	ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Записан документ %1'"), Объект.Ссылка));
	
КонецПроцедуры

Процедура ЗаписатьСправочникЗагрузки(Объект, Статистика, Протокол)
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Статистика.Справочников = Статистика.Справочников + 1;
	ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Записан %1 %2'"),
		Объект.Метаданные().ПолноеИмя(), Объект.Ссылка));
	
КонецПроцедуры

Процедура ЗаписатьНаборРегистраЗагрузки(НаборЗаписей, Статистика, Протокол)
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.Метаданные().Измерения.Найти("Версия") <> Неопределено Тогда
		
		ВерсияНабора = НаборЗаписей[0].Версия;
		НаборЗаписей.Отбор.Версия.Установить(ВерсияНабора);
		
		Если ЗначениеЗаполнено(ВерсияНабора) И Не ОбщегоНазначения.СсылкаСуществует(ВерсияНабора) Тогда
			ДобавитьВПротокол(Протокол, СтрШаблон(
				НСтр("ru = 'Предупреждение: версия %1 не найдена в базе, набор %2 записан с битой ссылкой'"),
				ВерсияНабора, НаборЗаписей.Метаданные().Имя));
			Статистика.Предупреждений = Статистика.Предупреждений + 1;
		КонецЕсли;
		
		ПроверитьСсылкиПоказателей(НаборЗаписей, Статистика, Протокол);
		
	КонецЕсли;
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать(Истина);
	Статистика.Наборов = Статистика.Наборов + 1;
	Статистика.Записей = Статистика.Записей + НаборЗаписей.Количество();
	ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Записан набор %1, записей %2'"),
		НаборЗаписей.Метаданные().Имя, НаборЗаписей.Количество()));
	
КонецПроцедуры

Процедура ПроверитьСсылкиПоказателей(НаборЗаписей, Статистика, Протокол)
	
	Если НаборЗаписей.Метаданные().Измерения.Найти("Показатель") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверенныеПоказатели = Новый Соответствие;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		Показатель = Запись.Показатель;
		Если Не ЗначениеЗаполнено(Показатель) Или ПроверенныеПоказатели[Показатель] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПроверенныеПоказатели.Вставить(Показатель, Истина);
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Показатель) Тогда
			ДобавитьВПротокол(Протокол, СтрШаблон(
				НСтр("ru = 'Предупреждение: показатель %1 не найден в базе (регистр %2)'"),
				Показатель, НаборЗаписей.Метаданные().Имя));
			Статистика.Предупреждений = Статистика.Предупреждений + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьПоказателиПоОписаниюПакета(ЧтениеXML, ОчищенныеЭкземпляры, Статистика, Протокол)
	
	Пока Истина Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = "Описание" Тогда
			ЧтениеXML.Прочитать();
			Возврат;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеXML.ЛокальноеИмя = "Экземпляр" Тогда
			
			УИДСтрокой = ЧтениеXML.ПолучитьАтрибут("УИД");
			Если ЗначениеЗаполнено(УИДСтрокой) Тогда
				ЭкземплярОтчета = Документы.НастраиваемыйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДСтрокой));
				ОчиститьПоказателиЭкземпляраЕслиНужно(ЭкземплярОтчета, ОчищенныеЭкземпляры, Статистика, Протокол);
			КонецЕсли;
			
			ПропуститьЭлементЧтенияXML(ЧтениеXML);
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЧтениеXML.Прочитать() Тогда
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьПоказателиЭкземпляраЕслиНужно(ЭкземплярОтчета, ОчищенныеЭкземпляры, Статистика, Протокол)
	
	Если Не ЗначениеЗаполнено(ЭкземплярОтчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОчищенныеЭкземпляры[ЭкземплярОтчета] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчищенныеЭкземпляры.Вставить(ЭкземплярОтчета, Истина);
	УдалитьПоказателиЭкземпляра(ЭкземплярОтчета, Статистика, Протокол);
	
КонецПроцедуры

Процедура УдалитьПоказателиЭкземпляра(ЭкземплярОтчета, Статистика, Протокол)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсииЗначенийПоказателей.Ссылка КАК Версия,
	|	ВерсииЗначенийПоказателей.Владелец КАК ОписаниеВерсий
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
	|ГДЕ
	|	(ВерсииЗначенийПоказателей.ЭкземплярОтчета = &ЭкземплярОтчета
	|		ИЛИ ВерсииЗначенийПоказателей.Регистратор = &ЭкземплярОтчета)
	|;
	|
	|ВЫБРАТЬ
	|	ОписаниеВерсий.Ссылка КАК ОписаниеВерсий
	|ИЗ
	|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
	|ГДЕ
	|	ОписаниеВерсий.ЭкземплярОтчета = &ЭкземплярОтчета";
	Запрос.УстановитьПараметр("ЭкземплярОтчета", ЭкземплярОтчета);
	
	Результаты = Запрос.ВыполнитьПакет();
	ТаблицаВерсий = Результаты[0].Выгрузить();
	ТаблицаОписаний = Результаты[1].Выгрузить();
	
	ОписанияКУдалению = Новый Соответствие;
	ИменаРегистров = ИменаРегистровЗначенийПоказателей();
	
	Для Каждого СтрокаВерсии Из ТаблицаВерсий Цикл
		
		Если ЗначениеЗаполнено(СтрокаВерсии.ОписаниеВерсий) Тогда
			ОписанияКУдалению.Вставить(СтрокаВерсии.ОписаниеВерсий, Истина);
		КонецЕсли;
		
		ОчиститьНаборыВерсииВПриемнике(СтрокаВерсии.Версия, ИменаРегистров);
		УдалитьОбъектСЗагрузкой(СтрокаВерсии.Версия);
		Статистика.УдаленоВерсий = Статистика.УдаленоВерсий + 1;
		
	КонецЦикла;
	
	Для Каждого СтрокаОписания Из ТаблицаОписаний Цикл
		ОписанияКУдалению.Вставить(СтрокаОписания.ОписаниеВерсий, Истина);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ОписанияКУдалению Цикл
		УдалитьОбъектСЗагрузкой(КлючИЗначение.Ключ);
		Статистика.УдаленоОписаний = Статистика.УдаленоОписаний + 1;
	КонецЦикла;
	
	Если ТаблицаВерсий.Количество() = 0 И ОписанияКУдалению.Количество() = 0 Тогда
		ДобавитьВПротокол(Протокол, СтрШаблон(
			НСтр("ru = 'Прежних версий экземпляра не найдено: %1'"), ЭкземплярОтчета));
		Возврат;
	КонецЕсли;
	
	ДобавитьВПротокол(Протокол, СтрШаблон(
		НСтр("ru = 'Удалены прежние данные экземпляра %1: версий %2, описаний %3'"),
		ЭкземплярОтчета, ТаблицаВерсий.Количество(), ОписанияКУдалению.Количество()));
	
КонецПроцедуры

Процедура ОчиститьНаборыВерсииВПриемнике(Версия, ИменаРегистров)
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Версия.Установить(Версия);
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьОбъектСЗагрузкой(Ссылка)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Удалить();
	
КонецПроцедуры

// Читает очередной объект пакета. ВозможностьЧтенияXML для узлов внутри
// нп_ПакетЭкземпляровОтчетов с xsi:type часто возвращает Ложь — тип берём из имени узла.
//
Функция ПрочитатьОбъектПакета(ЧтениеXML, Сериализатор, Статистика, Протокол)
	
	ИмяУзла = ЧтениеXML.ЛокальноеИмя;
	ТипОбъекта = ТипОбъектаПоИмениУзлаXML(ИмяУзла);
	
	Если ТипОбъекта <> Неопределено Тогда
		Возврат Сериализатор.ПрочитатьXML(ЧтениеXML, ТипОбъекта);
	КонецЕсли;
	
	Если Сериализатор.ВозможностьЧтенияXML(ЧтениеXML) Тогда
		Возврат Сериализатор.ПрочитатьXML(ЧтениеXML);
	КонецЕсли;
	
	ДобавитьВПротокол(Протокол, СтрШаблон(НСтр("ru = 'Пропущен неизвестный узел XML: %1'"), ИмяУзла));
	Статистика.Пропущено = Статистика.Пропущено + 1;
	ПропуститьЭлементЧтенияXML(ЧтениеXML);
	Возврат Неопределено;
	
КонецФункции

Функция ТипОбъектаПоИмениУзлаXML(ИмяУзла)
	
	Если СтрНачинаетсяС(ИмяУзла, "DocumentObject.") Тогда
		Возврат ТипОбъектаМетаданных(Метаданные.Документы, Сред(ИмяУзла, СтрДлина("DocumentObject.") + 1), "ДокументОбъект.");
	ИначеЕсли СтрНачинаетсяС(ИмяУзла, "CatalogObject.") Тогда
		Возврат ТипОбъектаМетаданных(Метаданные.Справочники, Сред(ИмяУзла, СтрДлина("CatalogObject.") + 1), "СправочникОбъект.");
	ИначеЕсли СтрНачинаетсяС(ИмяУзла, "InformationRegisterRecordSet.") Тогда
		Возврат ТипОбъектаМетаданных(Метаданные.РегистрыСведений,
			Сред(ИмяУзла, СтрДлина("InformationRegisterRecordSet.") + 1), "РегистрСведенийНаборЗаписей.");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ТипОбъектаМетаданных(КоллекцияМетаданных, ИмяОбъекта, ПрефиксТипа)
	
	Если КоллекцияМетаданных.Найти(ИмяОбъекта) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Тип(ПрефиксТипа + ИмяОбъекта);
	
КонецФункции

Процедура ПропуститьЭлементЧтенияXML(ЧтениеXML)
	
	Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
		ЧтениеXML.Прочитать();
		Возврат;
	КонецЕсли;
	
	ЧтениеXML.Пропустить();
	
	// Пропустить() на части платформ оставляет указатель на закрывающем теге.
	// Закрывающие теги пакета и описания обрабатывает вызывающий цикл.
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
		И ЧтениеXML.ЛокальноеИмя <> ИмяКорняПакета()
		И ЧтениеXML.ЛокальноеИмя <> "Описание" Тогда
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВПротокол(Протокол, Текст)
	
	Протокол.Добавить(Текст);
	
КонецПроцедуры

Процедура УдалитьФайлЕслиСуществует(ИмяФайла)
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// Временный файл мог быть уже удалён.
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
