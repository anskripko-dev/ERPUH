// Не из типовой. Пакетный сбор данных для Отпустил/Получил с учётом замещения (ERP.2026.12).
//
Функция ДополнительныеДанныеПодписей(МассивОбъектов)
	
	Результат = Новый Соответствие;
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка КАК Ссылка,
	|	ПеремещениеТоваров.Дата КАК Дата,
	|	ПеремещениеТоваров.Организация КАК Организация,
	|	ПеремещениеТоваров.ОрганизацияПолучатель КАК ОрганизацияПолучатель,
	|	ПеремещениеТоваров.СкладОтправитель КАК СкладОтправитель,
	|	ПеремещениеТоваров.СкладПолучатель КАК СкладПолучатель,
	|	ПеремещениеТоваров.СкладОтправитель.ТекущийОтветственный КАК МОЛОтправитель,
	|	ПеремещениеТоваров.СкладПолучатель.ТекущийОтветственный КАК МОЛПолучатель,
	|	ПеремещениеТоваров.СкладОтправитель.ТекущаяДолжностьОтветственного КАК ДолжностьСкладаОтправитель,
	|	ПеремещениеТоваров.СкладПолучатель.ТекущаяДолжностьОтветственного КАК ДолжностьСкладаПолучатель
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Ссылка В(&МассивОбъектов)";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	ФизлицаМОЛ = Новый Массив;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если ЗначениеЗаполнено(СтрокаДокумента.МОЛОтправитель)
			И ФизлицаМОЛ.Найти(СтрокаДокумента.МОЛОтправитель) = Неопределено Тогда
			ФизлицаМОЛ.Добавить(СтрокаДокумента.МОЛОтправитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДокумента.МОЛПолучатель)
			И ФизлицаМОЛ.Найти(СтрокаДокумента.МОЛПолучатель) = Неопределено Тогда
			ФизлицаМОЛ.Добавить(СтрокаДокумента.МОЛПолучатель);
		КонецЕсли;
	КонецЦикла;
	
	ЗаместителиПоФизлицам = ЗаместителиПоФизическимЛицам(ФизлицаМОЛ, ТаблицаДокументов);
	
	ФизлицаДляКадров = Новый Массив;
	Для Каждого КлючИЗначение Из ЗаместителиПоФизлицам Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение)
			И ФизлицаДляКадров.Найти(КлючИЗначение.Значение) = Неопределено Тогда
			ФизлицаДляКадров.Добавить(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	ТаблицаДолжностей = КадровыеДолжностиФизлиц(ФизлицаДляКадров);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		
		ДанныеПодписей = ПустыеДанныеПодписей();
		
		ДанныеОтпустил = ДанныеПодписиСтороны(
			СтрокаДокумента.МОЛОтправитель,
			СтрокаДокумента.СкладОтправитель,
			СтрокаДокумента.ДолжностьСкладаОтправитель,
			СтрокаДокумента.Дата,
			СтрокаДокумента.Организация,
			ЗаместителиПоФизлицам,
			ТаблицаДолжностей);
		ДанныеПодписей.ДолжностьОтпустил = ДанныеОтпустил.Должность;
		ДанныеПодписей.ФИООтпустил = ДанныеОтпустил.ФИО;
		
		ОрганизацияПолучателя = ?(ЗначениеЗаполнено(СтрокаДокумента.ОрганизацияПолучатель),
			СтрокаДокумента.ОрганизацияПолучатель,
			СтрокаДокумента.Организация);
		ДанныеПолучил = ДанныеПодписиСтороны(
			СтрокаДокумента.МОЛПолучатель,
			СтрокаДокумента.СкладПолучатель,
			СтрокаДокумента.ДолжностьСкладаПолучатель,
			СтрокаДокумента.Дата,
			ОрганизацияПолучателя,
			ЗаместителиПоФизлицам,
			ТаблицаДолжностей);
		ДанныеПодписей.ДолжностьПолучил = ДанныеПолучил.Должность;
		ДанныеПодписей.ФИОПолучил = ДанныеПолучил.ФИО;
		
		Результат.Вставить(СтрокаДокумента.Ссылка, ДанныеПодписей);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПустыеДанныеПодписей()
	
	ДанныеПодписей = Новый Структура;
	ДанныеПодписей.Вставить("ДолжностьОтпустил", "");
	ДанныеПодписей.Вставить("ФИООтпустил", "");
	ДанныеПодписей.Вставить("ДолжностьПолучил", "");
	ДанныеПодписей.Вставить("ФИОПолучил", "");
	Возврат ДанныеПодписей;
	
КонецФункции

// Не из типовой. ФИО/должность стороны подписи с учётом замещения (ERP.2026.12).
//
Функция ДанныеПодписиСтороны(МОЛ, Склад, ДолжностьСклада, ДатаДокумента, Организация,
	ЗаместителиПоФизлицам, ТаблицаДолжностей)
	
	Результат = Новый Структура("Должность, ФИО", "", "");
	Если Не ЗначениеЗаполнено(МОЛ) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФизлицоДляПечати = МОЛ;
	ЭтоЗаместитель = Ложь;
	
	КлючЗамещения = КлючЗамещения(МОЛ, ДатаДокумента);
	ЗаместительФЛ = ЗаместителиПоФизлицам.Получить(КлючЗамещения);
	Если ЗначениеЗаполнено(ЗаместительФЛ) Тогда
		ФизлицоДляПечати = ЗаместительФЛ;
		ЭтоЗаместитель = Истина;
	КонецЕсли;
	
	Результат.ФИО = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ФизлицоДляПечати, ДатаДокумента);
	
	Если ЭтоЗаместитель Тогда
		ДолжностьКадры = ДолжностьИзТаблицы(ТаблицаДолжностей, ФизлицоДляПечати, Организация);
		Если ЗначениеЗаполнено(ДолжностьКадры) Тогда
			Результат.Должность = ДолжностьКадры;
		Иначе
			Результат.Должность = ДолжностьСкладаИлиПоУмолчанию(Склад, ДолжностьСклада);
		КонецЕсли;
	Иначе
		Результат.Должность = ДолжностьСкладаИлиПоУмолчанию(Склад, ДолжностьСклада);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДолжностьСкладаИлиПоУмолчанию(Склад, ДолжностьСклада)
	
	Если ЗначениеЗаполнено(ДолжностьСклада) Тогда
		Возврат СокрЛП(ДолжностьСклада);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Склад) Тогда
		Возврат СкладыСервер.ДолжностьОтветственногоЛицаСклада(Склад);
	КонецЕсли;
	
	Возврат НСтр("ru = 'Кладовщик'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

Функция КлючЗамещения(ФизическоеЛицо, ДатаДокумента)
	
	Возврат Строка(ФизическоеЛицо.УникальныйИдентификатор()) + "|" + Формат(НачалоДня(ДатаДокумента), "ДФ=yyyyMMdd");
	
КонецФункции

// Не из типовой. Соответствие «ключ МОЛ+дата → ФЛ заместителя» (ERP.2026.12).
// При нескольких заместителях берётся последний по ДатаНачала.
//
Функция ЗаместителиПоФизическимЛицам(ФизлицаМОЛ, ТаблицаДокументов)
	
	Результат = Новый Соответствие;
	Если ФизлицаМОЛ.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	МинимальнаяДата = Неопределено;
	МаксимальнаяДата = Неопределено;
	УникальныеДаты = Новый Массив;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		ДатаДня = НачалоДня(СтрокаДокумента.Дата);
		Если УникальныеДаты.Найти(ДатаДня) = Неопределено Тогда
			УникальныеДаты.Добавить(ДатаДня);
		КонецЕсли;
		Если МинимальнаяДата = Неопределено Или ДатаДня < МинимальнаяДата Тогда
			МинимальнаяДата = ДатаДня;
		КонецЕсли;
		Если МаксимальнаяДата = Неопределено Или ДатаДня > МаксимальнаяДата Тогда
			МаксимальнаяДата = ДатаДня;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь,
	|	Пользователи.ФизическоеЛицо КАК ФизическоеЛицоМОЛ,
	|	Заместители.ДатаНачала КАК ДатаНачала,
	|	Заместители.ДатаОкончания КАК ДатаОкончания,
	|	Заместители.Заместитель.ФизическоеЛицо КАК ФизическоеЛицоЗаместителя
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Заместители КАК Заместители
	|		ПО Пользователи.Ссылка = Заместители.ЗамещаемыйПользователь
	|ГДЕ
	|	Пользователи.ФизическоеЛицо В(&ФизлицаМОЛ)
	|	И НЕ Пользователи.ПометкаУдаления
	|	И Заместители.Заместитель.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	И (Заместители.ДатаНачала <= &МаксимальнаяДата
	|		ИЛИ Заместители.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	|	И (Заместители.ДатаОкончания >= &МинимальнаяДата
	|		ИЛИ Заместители.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицоМОЛ,
	|	ДатаНачала УБЫВ,
	|	ФизическоеЛицоЗаместителя";
	
	Запрос.УстановитьПараметр("ФизлицаМОЛ", ФизлицаМОЛ);
	Запрос.УстановитьПараметр("МинимальнаяДата", МинимальнаяДата);
	Запрос.УстановитьПараметр("МаксимальнаяДата", МаксимальнаяДата);
	
	ТаблицаЗамещений = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ДатаДня Из УникальныеДаты Цикл
		Для Каждого ФизическоеЛицоМОЛ Из ФизлицаМОЛ Цикл
			
			Ключ = КлючЗамещения(ФизическоеЛицоМОЛ, ДатаДня);
			Если Результат.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаЗамещения Из ТаблицаЗамещений Цикл
				
				Если СтрокаЗамещения.ФизическоеЛицоМОЛ <> ФизическоеЛицоМОЛ Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаНачалаОк = Не ЗначениеЗаполнено(СтрокаЗамещения.ДатаНачала)
					Или СтрокаЗамещения.ДатаНачала <= ДатаДня;
				ДатаОкончанияОк = Не ЗначениеЗаполнено(СтрокаЗамещения.ДатаОкончания)
					Или СтрокаЗамещения.ДатаОкончания >= ДатаДня;
				
				Если ДатаНачалаОк И ДатаОкончанияОк Тогда
					// Таблица упорядочена по ДатаНачала УБЫВ — первый подходящий = последний по дате начала.
					Результат.Вставить(Ключ, СтрокаЗамещения.ФизическоеЛицоЗаместителя);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Не из типовой. Кадровые должности физлиц (как в тн_ПФ_М11 / тн_ПФ_МБ7) (ERP.2026.12).
//
Функция КадровыеДолжностиФизлиц(Физлица)
	
	Если Физлица.Количество() = 0 Тогда
		ТаблицаДолжностей = Новый ТаблицаЗначений;
		ТаблицаДолжностей.Колонки.Добавить("ФизическоеЛицо");
		ТаблицаДолжностей.Колонки.Добавить("Должность");
		ТаблицаДолжностей.Колонки.Добавить("ТекущаяОрганизация");
		ТаблицаДолжностей.Колонки.Добавить("ГоловнаяОрганизация");
		ТаблицаДолжностей.Колонки.Добавить("ОсновноеРабочееМестоВОрганизации");
		ТаблицаДолжностей.Колонки.Добавить("ДатаПриема");
		Возврат ТаблицаДолжностей;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТекущиеКадровыеДанные.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(ТекущиеКадровыеДанные.ТекущаяДолжность) КАК Должность,
	|	ТекущиеКадровыеДанные.ТекущаяОрганизация КАК ТекущаяОрганизация,
	|	ТекущиеКадровыеДанные.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанные.ОсновноеРабочееМестоВОрганизации КАК ОсновноеРабочееМестоВОрганизации,
	|	ТекущиеКадровыеДанные.ДатаПриема КАК ДатаПриема
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанные
	|ГДЕ
	|	ТекущиеКадровыеДанные.ФизическоеЛицо В(&Физлица)
	|	И ТекущиеКадровыеДанные.ТекущаяДолжность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо,
	|	ОсновноеРабочееМестоВОрганизации УБЫВ,
	|	ДатаПриема УБЫВ";
	Запрос.УстановитьПараметр("Физлица", Физлица);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДолжностьИзТаблицы(ТаблицаДолжностей, ФизическоеЛицо, Организация)
	
	СтрокиКадровых = ТаблицаДолжностей.НайтиСтроки(Новый Структура("ФизическоеЛицо", ФизическоеЛицо));
	Если СтрокиКадровых.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого СтрокаКадровых Из СтрокиКадровых Цикл
		
		Если ЗначениеЗаполнено(Организация)
			И СтрокаКадровых.ТекущаяОрганизация <> Организация
			И СтрокаКадровых.ГоловнаяОрганизация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат СокрЛП(Строка(СтрокаКадровых.Должность));
		
	КонецЦикла;
	
	Возврат СокрЛП(Строка(СтрокиКадровых[0].Должность));
	
КонецФункции

// Не из типовой. Заполнение ячеек «Отпустил» / «Получил» в области «Подписи» (ERP.2026.12).
// В типовом макете параметров подписей нет — пишем в свободные ячейки справа от подписей.
//
Процедура ЗаполнитьОбластьПодписей(ОбластьПодписей, ДанныеПодписей)
	
	ЗаполнитьЯчейкиПодписи(ОбластьПодписей, "Отпустил",
		ДанныеПодписей.ДолжностьОтпустил, ДанныеПодписей.ФИООтпустил);
	ЗаполнитьЯчейкиПодписи(ОбластьПодписей, "Получил",
		ДанныеПодписей.ДолжностьПолучил, ДанныеПодписей.ФИОПолучил);
	
КонецПроцедуры

Процедура ЗаполнитьЯчейкиПодписи(ОбластьПодписей, ИмяПодписи, Должность, ФИО)
	
	ТекстПодписи = СокрЛП(Должность);
	Если ЗначениеЗаполнено(ФИО) Тогда
		Если ЗначениеЗаполнено(ТекстПодписи) Тогда
			ТекстПодписи = ТекстПодписи + " " + ФИО;
		Иначе
			ТекстПодписи = ФИО;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстПодписи) Тогда
		Возврат;
	КонецЕсли;
	
	Для НомерСтроки = 1 По ОбластьПодписей.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ОбластьПодписей.ШиринаТаблицы Цикл
			
			Ячейка = ОбластьПодписей.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
			Если Ячейка.Текст <> ИмяПодписи Тогда
				Продолжить;
			КонецЕсли;
			
			// Свободная объединённая область справа от подписи (см. merges макета: c9 / c23).
			КолонкаЗначения = НомерКолонки + 8;
			Если КолонкаЗначения > ОбластьПодписей.ШиринаТаблицы Тогда
				КолонкаЗначения = НомерКолонки + 4;
			КонецЕсли;
			Если КолонкаЗначения <= ОбластьПодписей.ШиринаТаблицы Тогда
				ОбластьПодписей.Область(НомерСтроки, КолонкаЗначения, НомерСтроки, КолонкаЗначения).Текст = ТекстПодписи;
			КонецЕсли;
			Возврат;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
