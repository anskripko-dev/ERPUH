	Проводки.Очистить();
КонецПроцедуры

#Область ЧтениеExcel

&НаКлиенте
Процедура КомандаПрочитатьExcel(Команда)
	
	ВыбратьФайлы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлы()

	Оповещение = Новый ОписаниеОповещения("Ответ_НачатьПомещениеФайлаНаСервер", ЭтотОбъект);
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "(*.xlsx)|*.xlsx";
	НачатьПомещениеФайлаНаСервер(Оповещение,,,,ПараметрыДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура Ответ_НачатьПомещениеФайлаНаСервер(ОписаниеПомещеногоФайла, Параметры) Экспорт
	
	Если ОписаниеПомещеногоФайла = Неопределено Или ОписаниеПомещеногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	АдресВременногоХранилищаФайла = ОписаниеПомещеногоФайла.Адрес;
	Расширение = ОписаниеПомещеногоФайла.СсылкаНаФайл.Файл.Расширение;
	ПрочитатьExcel(АдресВременногоХранилищаФайла, Расширение);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьExcel(АдресВременногоХранилищаФайла, Расширение)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаФайла);
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяФайла);
	
	табДок = Новый ТабличныйДокумент;
	
	Попытка
		табДок.Прочитать(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
		
	Исключение
		
		ТекстСообщения = СтрШаблон("Не удалось прочитать файл %1: %2", ИмяФайла, ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецПопытки;
	
	КоличествоСтрок = табДок.ВысотаТаблицы;
	НомерПервойСтрокиСДанными = 2;
	
	Для сч = НомерПервойСтрокиСДанными по КоличествоСтрок Цикл
		//Если Сч > 20 Тогда
		//	Прервать;
		//КонецЕсли;
		Если СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  1).ТекущаяОбласть.Текст) = "" Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаТЗ = Проводки.Добавить();
		СтрокаТЗ.ДебетКредит 	= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  1).ТекущаяОбласть.Текст);
		
		//Счет
		СчетКод					= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  2).ТекущаяОбласть.Текст);
		СтрокаТЗ.Счет = СопоставитьСчет(СчетКод);
		
		//Субконто
		ТипСубконто1			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  3).ТекущаяОбласть.Текст);
		Субконто1УИД			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  4).ТекущаяОбласть.Текст);
		
		ТипСубконто2 			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  5).ТекущаяОбласть.Текст);
		Субконто2УИД			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  6).ТекущаяОбласть.Текст);
		
		ТипСубконто3 			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  7).ТекущаяОбласть.Текст);
		Субконто3УИД			= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  8).ТекущаяОбласть.Текст);
		
		СтруктураСубконтоУИД = Новый Структура("Субконто1УИД, Субконто2УИД, Субконто3УИД", Субконто1УИД, Субконто2УИД, Субконто3УИД);
		СопоставитьСубконто(СтрокаТЗ, СтруктураСубконтоУИД);

		//Валюта
		ВалютаУИД				= СокрЛП(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" +  9).ТекущаяОбласть.Текст);
		СтрокаТЗ.Валюта = СопоставитьВалюту(ВалютаУИД);
		
		//Суммы
		СтрокаТЗ.Сумма 			= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 10).ТекущаяОбласть.Текст);
		СтрокаТЗ.ВалютнаяСумма	= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 11).ТекущаяОбласть.Текст);
		СтрокаТЗ.Количество 	= _Число(табДок.ПолучитьОбласть("R" + Формат(сч, "ЧГ=0;") + "C" + 12).ТекущаяОбласть.Текст);
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция СопоставитьСчет(СчетКод)
	
	Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетКод);
	
	Возврат Счет;
	
КонецФункции

&НаСервере
Процедура СопоставитьСубконто(СтрокаТЗ, СтруктураСубконтоУИД);
	
	Счет = СтрокаТЗ.Счет;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		
		КоличествоСубконто = Счет.ВидыСубконто.Количество();
		Для НомерСубконто = 1 по КоличествоСубконто Цикл
			
			Менеджер = Неопределено;
			ТипСубконто = Счет.ВидыСубконто[НомерСубконто - 1].ВидСубконто.ТипЗначения;
			
			Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.Номенклатура")) Тогда
				Менеджер = Справочники.Номенклатура;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.Склады")) Тогда
				Менеджер = Справочники.Склады;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.Контрагенты")) Тогда
				Менеджер = Справочники.Контрагенты;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.ОбъектыЭксплуатации")) Тогда
				Менеджер = Справочники.ОбъектыЭксплуатации;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.ДоговорыКонтрагентов")) Тогда
				Менеджер = Справочники.ДоговорыКонтрагентов;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.НематериальныеАктивы")) Тогда
				Менеджер = Справочники.НематериальныеАктивы;
			ИначеЕсли ТипСубконто.СодержитТип(Тип("СправочникСсылка.ФизическиеЛица")) Тогда
				Менеджер = Справочники.ФизическиеЛица;
			КонецЕсли;
			
			Если Менеджер <> Неопределено Тогда
				СтрокаТЗ[СтрШаблон("Субконто%1", Строка(НомерСубконто))] = НайтиЗначениеСубконто(Менеджер, СтруктураСубконтоУИД);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиЗначениеСубконто(Менеджер, СтруктураСубконтоУИД)
	
	Для Сч = 1 по 3 Цикл
		
		ИмяЭлемента = СтрШаблон("Субконто%1УИД", Сч);
		СубконтоУИД = СтруктураСубконтоУИД[ИмяЭлемента];
		
		Если ЗначениеЗаполнено(СубконтоУИД) Тогда
			
			УИД = Новый УникальныйИдентификатор(СубконтоУИД);
			ЗначениеСубконто = Менеджер.ПолучитьСсылку(УИД);
			
			Если ОбщегоНазначения.СсылкаСуществует(ЗначениеСубконто) Тогда
				Возврат ЗначениеСубконто;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено; //не сопоставили
	
КонецФункции

&НаСервере
Функция СопоставитьВалюту(ВалютаУИД)
	
	Если ЗначениеЗаполнено(ВалютаУИД) Тогда
		Валюта = Справочники.Валюты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВалютаУИД));
	Иначе
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Возврат Валюта;
	
КонецФункции

&НаСервере
Функция _Число(ЗначениеСтрокой)
	//  17 672,25
	Если ЗначениеСтрокой = "" Тогда
		Возврат 0;
	Иначе
		//НАЧАЛО Сафиуллина З.Р. 04.05.2026 Выполнение задач №000057321
		//Возврат Число(СтрЗаменить(ЗначениеСтрокой,Символы.НПП,""));
		Попытка
		    ЧислоИзСтроки = Число(СтрЗаменить(ЗначениеСтрокой, Символы.НПП, "")); 
		Исключение
		    ЧислоИзСтроки = Число(СтрЗаменить(ЗначениеСтрокой, ",", ""));
		КонецПопытки;
		Возврат ЧислоИзСтроки;
		//КОНЕЦ Сафиуллина З.Р. 04.05.2026 Выполнение задач №000057321
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПеренестиВДокумент

&НаКлиенте
Процедура ПеренестиВОперацияБух(Команда)
	
	Если Не ЗначениеЗаполнено(ОперацияБух) Тогда
		ПоказатьПредупреждение(,"Не заполнена Операция (регламентированный учет)");
		Возврат;
	КонецЕсли;
	
	ПеренестиВОперацияБухСервер();
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиВОперацияБухСервер()
	
	обОперацияБух = ОперацияБух.ПолучитьОбъект();

	Для каждого СтрокаТЗ из Проводки Цикл
	
		Счет = СтрокаТЗ.Счет;
		Если ЗначениеЗаполнено(Счет) Тогда
			
			Проводка = обОперацияБух.Движения.Хозрасчетный.Добавить();
			Проводка.Период = обОперацияБух.Дата;
			Проводка.Регистратор = ОперацияБух;
			Проводка.Организация = ОперацияБух.Организация;
			Проводка.Активность = Истина;
			
			//Счет
			Если СтрокаТЗ.ДебетКредит = "Дебет" Тогда
				Проводка.СчетДт = Счет;
			Иначе //Кредит
				Проводка.СчетКт = Счет;
			КонецЕсли;
			
			//Субконто
			КоличествоСубконто = Счет.ВидыСубконто.Количество();
			Для НомерСубконто = 1 по КоличествоСубконто Цикл
				
				ЗначениеСубконто = СтрокаТЗ[СтрШаблон("Субконто%1", НомерСубконто)];
				
				Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда
					ВидСубконто = Счет.ВидыСубконто[НомерСубконто - 1].ВидСубконто;
					
					Если СтрокаТЗ.ДебетКредит = "Дебет" Тогда
						Проводка.СубконтоДт.Вставить(ВидСубконто, ЗначениеСубконто);
					Иначе //Кредит
						Проводка.СубконтоКт.Вставить(ВидСубконто, ЗначениеСубконто);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Сумма
			Проводка.Сумма = СтрокаТЗ.Сумма;
			
			//Валюта
			Если Счет.Валютный Тогда
				Если СтрокаТЗ.ДебетКредит = "Дебет" Тогда
					Проводка.ВалютаДт = СтрокаТЗ.Валюта;
					Проводка.ВалютнаяСуммаДт = СтрокаТЗ.ВалютнаяСумма;
				Иначе //Кредит
					Проводка.ВалютаКт = СтрокаТЗ.Валюта;
					Проводка.ВалютнаяСуммаКт = СтрокаТЗ.ВалютнаяСумма;
				КонецЕсли;
			КонецЕсли;
			
			//Количество
			Если Счет.Количественный Тогда
				Если СтрокаТЗ.ДебетКредит = "Дебет" Тогда
					Проводка.КоличествоДт = СтрокаТЗ.Количество;
				Иначе //Кредит
					Проводка.КоличествоКт = СтрокаТЗ.Количество;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли; //Заполнен Счет
		
	КонецЦикла; //Проводки
	
	ОбновитьИтогиПоДокументу(обОперацияБух);
	
	обОперацияБух.Движения.Хозрасчетный.Записывать = Истина;
	обОперацияБух.Записать(РежимЗаписиДокумента.Проведение);
	
	ОбщегоНазначения.СообщитьПользователю("Запись завершена");

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиПоДокументу(Объект)
	
	Объект.СуммаОперации = 0;
	Объект.СуммаУУ = 0;
	
	Для каждого Проводка Из Объект.Движения.Хозрасчетный Цикл
		Объект.СуммаОперации = Объект.СуммаОперации + Проводка.Сумма;
		Объект.СуммаУУ = Объект.СуммаУУ + Проводка.СуммаУУ;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

