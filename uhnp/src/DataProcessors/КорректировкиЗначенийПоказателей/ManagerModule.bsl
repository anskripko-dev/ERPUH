		ТекстГруппировка=ТекстГруппировка+",
		|Содержание";
		
	КонецЕсли;
			
	// Формирование текста запроса для измерений регистра бухгалтерии. 
	
	МассивПсевдонимов=Новый Массив;
	
	Для Каждого СтрПоле Из ПравилаИспользованияПолейЗапроса Цикл
		
		Если НЕ СтрПоле.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ МассивПсевдонимов.Найти(СтрПоле.Синоним)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		ТекстЗапроса=ТекстЗапроса+",
		|"+СтрПоле.Поле+" КАК "+СтрПоле.Синоним;
		
		ТекстГруппировка=ТекстГруппировка+",
		|"+СтрПоле.Поле;
		
		МассивПсевдонимов.Добавить(СтрПоле.Синоним);
				
	КонецЦикла;
	
	ТекстСоединения=ПолучитьТекстСоединения(ПравилаИспользованияПолейЗапроса);
	ДанныеОтбора.ТекстОтбора=СтрЗаменить(ДанныеОтбора.ТекстОтбора,"СчетДт.Код","СчетДтКод");
	ДанныеОтбора.ТекстОтбора=СтрЗаменить(ДанныеОтбора.ТекстОтбора,"СчетКт.Код","СчетКтКод");
	
		ТекстЗапроса=ТекстЗапроса+"
		|ИЗ  
		|ПроводкиПоОтбору "+ТекстСоединения+" ГДЕ "+ДанныеОтбора.ТекстОтбора+"
		|СГРУППИРОВАТЬ ПО "+ТекстГруппировка;
			
	Возврат ТекстЗапроса;
		
КонецФункции // СформироватьТекстЗапросаКДвижениямССубконто()

Функция ПолучитьТекстСоединения(ПравилаИспользованияПолейЗапроса) Экспорт

	ТекстСоединения="";
	
	Для Каждого Строка ИЗ ПравилаИспользованияПолейЗапроса Цикл
		
		Если ПустаяСтрока(Строка.ТекстСоединения) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТекстСоединения=ТекстСоединения+"
		|"+Строка.ТекстСоединения;
		
	КонецЦикла;
	
	Возврат ТекстСоединения;	
	
КонецФункции // ПолучитьТекстСоединения() 

Процедура ДобавитьТаблицуОтборомПоРегистратору(ДанныеОбъекта,ПравилаВычисленияПараметров) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НоваяСтрока=ПравилаВычисленияПараметров.Добавить();
	НоваяСтрока.ИмяПараметра=		"Регистратор";
	НоваяСтрока.НаименованиеБД=		"Регистратор";
	НоваяСтрока.ПолеБД=				"Регистратор";
	НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НоваяСтрока.УточнениеСпособаОпределения=ДанныеОбъекта.ИсходныйДокумент;	
	
КонецПроцедуры // ДобавитьТаблицуОтборомПоРегистратору()

Функция ТекущаяИБ(ИспользуемаяИБ) Экспорт
	
	Возврат (НЕ ЗначениеЗаполнено(ИспользуемаяИБ)) 
	ИЛИ ИспользуемаяИБ=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ
	ИЛИ ИспользуемаяИБ.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ; 
		
КонецФункции // ТекущаяИБ()

Функция ПолучитьПравилоОбработки(ДанныеОбъекта)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаОбработки КАК ПравилаОбработки
	|ГДЕ
	|	ПравилаОбработки.НаправлениеТрансляции = &НаправлениеТрансляции
	|	И ПравилаОбработки.Владелец = &Владелец
	|	И НЕ ПравилаОбработки.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НаправлениеТрансляции",Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии);
	Запрос.УстановитьПараметр("Владелец",ДанныеОбъекта.ШаблонКорректировки);
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Возврат Результат.Ссылка;
					
КонецФункции // ПриИзмененииШаблонаКорректировки()

Функция ПолучитьТаблицуКорреспонденций(ДанныеОбъекта) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("НазначениеРасчетов",ПолучитьПравилоОбработки(ДанныеОбъекта));
			
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Получаем все корреспонденции счетов за период
	
	Запрос.Текст=Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	
	мОперанды=Запрос.Выполнить().Выгрузить();
	
	Если мОперанды.Количество()=0 Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;	
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	мОперанды[0].СпособПолучения=?(ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ),Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос,Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос);	
				
	СтрЗапрос=ПодготовитьДанныеДляЗапроса(мОперанды[0],мОперанды);
	
	ТекстАктивность=?(ДанныеОбъекта.Свойство("НеПроверятьАктивность"),"ИСТИНА","Активность");
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ Различные СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет
		|ИЗ РегистрБухгалтерии."+ ДанныеОбъекта.РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(, ,"+ТекстАктивность+" И Регистратор=&Регистратор"+?(ЗначениеЗаполнено(СтрЗапрос.ТекстОтбора)," И "+СтрЗапрос.ТекстОтбора,"")+")";
		
		
	Иначе
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ Различные СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет
		|ИЗ РегистрБухгалтерии."+ ДанныеОбъекта.РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(&ДатаНач, &ДатаКон,"+ТекстАктивность+?(ЗначениеЗаполнено(СтрЗапрос.ТекстОтбора)," И "+СтрЗапрос.ТекстОтбора,"")+")";
		
	КонецЕсли;
	
	Если ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
		
		ДобавитьТаблицуОтборомПоРегистратору(ДанныеОбъекта,СтрЗапрос.ПравилаВычисленияПараметров);	
		ТаблицаДанных=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(ДанныеОбъекта,СтрЗапрос);
		
	Иначе
		
		СтруктураЗапроса 	= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(ДанныеОбъекта,СтрЗапрос,Истина);
		СтруктураДанных	 	= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(СтруктураЗапроса);
		ТаблицаДанных      	= РасширениеИнтеграцииУХ.ПолучитьРабочуюТаблицуПоДаннымПереноса(ДанныеОбъекта.ИспользуемаяИБ,СтруктураДанных);
		
	КонецЕсли; 
	
	ОписаниеТиповСтрока			= ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(Метаданные.Справочники.СчетаБД.ДлинаКода);
	
	ТаблицаСчетов=Новый ТаблицаЗначений;	
	ТаблицаСчетов.Колонки.Добавить("СчетДтИсточникКод",	ОписаниеТиповСтрока);
	ТаблицаСчетов.Колонки.Добавить("СчетКтИсточникКод",	ОписаниеТиповСтрока);
	
	Для Каждого Строка ИЗ ТаблицаДанных Цикл
		
		НоваяСтрока=ТаблицаСчетов.Добавить();
		НоваяСтрока.СчетДтИсточникКод		= Строка.Счет;
		НоваяСтрока.СчетКтИсточникКод		= Строка.КоррСчет;
		
	КонецЦикла;	
				
	Возврат ТаблицаСчетов;
	
КонецФункции // ПолучитьТаблицуКорреспонденций()

Функция ПолучитьТаблицуКорреспонденцийСумма(ДанныеОбъекта,ИмяРесурса="Сумма") Экспорт
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("НазначениеРасчетов",ПолучитьПравилоОбработки(ДанныеОбъекта));
			
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Получаем все корреспонденции счетов за период
	
	Запрос.Текст=Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	
	мОперанды=Запрос.Выполнить().Выгрузить();
	
	Если мОперанды.Количество()=0 Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;	
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	мОперанды[0].СпособПолучения=?(ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ),Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос,Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос);	
				
	СтрЗапрос=ПодготовитьДанныеДляЗапроса(мОперанды[0],мОперанды);
	
	ТекстАктивность=?(ДанныеОбъекта.Свойство("НеПроверятьАктивность"),"ИСТИНА","Активность");
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ Различные СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет,СУММА("+ИмяРесурса+") КАК Сумма_Источник
		|ИЗ РегистрБухгалтерии."+ ДанныеОбъекта.РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(, ,"+ТекстАктивность+" И Регистратор=&Регистратор"+?(ЗначениеЗаполнено(СтрЗапрос.ТекстОтбора)," И "+СтрЗапрос.ТекстОтбора,"")+")
		|СГРУППИРОВАТЬ ПО СчетДт.Код, СчетКт.Код"; 
		
	Иначе
		
		СтрЗапрос.ТекстЗапроса="ВЫБРАТЬ Различные СчетДт.Код КАК Счет,СчетКт.Код КАК КоррСчет,СУММА("+ИмяРесурса+") КАК Сумма_Источник
		|ИЗ РегистрБухгалтерии."+ ДанныеОбъекта.РегистрБухгалтерииИсточник.Наименование + ".ДвиженияССубконто(&ДатаНач, &ДатаКон,"+ТекстАктивность+?(ЗначениеЗаполнено(СтрЗапрос.ТекстОтбора)," И "+СтрЗапрос.ТекстОтбора,"")+")
		|СГРУППИРОВАТЬ ПО СчетДт.Код, СчетКт.Код";
		
	КонецЕсли;
	
	Если ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
		
		ДобавитьТаблицуОтборомПоРегистратору(ДанныеОбъекта,СтрЗапрос.ПравилаВычисленияПараметров);	
		ТаблицаДанных=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(ДанныеОбъекта,СтрЗапрос);
		
	Иначе
		
		СтруктураЗапроса 	= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(ДанныеОбъекта,СтрЗапрос,Истина);
		СтруктураДанных	 	= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(СтруктураЗапроса);
		ТаблицаДанных      	= РасширениеИнтеграцииУХ.ПолучитьРабочуюТаблицуПоДаннымПереноса(ДанныеОбъекта.ИспользуемаяИБ,СтруктураДанных);
		
	КонецЕсли; 
	
	ОписаниеТиповСтрока			= ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(Метаданные.Справочники.СчетаБД.ДлинаКода);
	
	ТаблицаСчетов=Новый ТаблицаЗначений;	
	ТаблицаСчетов.Колонки.Добавить("СчетДтИсточникКод",	ОписаниеТиповСтрока);
	ТаблицаСчетов.Колонки.Добавить("СчетКтИсточникКод",	ОписаниеТиповСтрока);
	ТаблицаСчетов.Колонки.Добавить("Сумма_Источник",	ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	Для Каждого Строка ИЗ ТаблицаДанных Цикл
		
		НоваяСтрока=ТаблицаСчетов.Добавить();
		НоваяСтрока.СчетДтИсточникКод		= Строка.Счет;
		НоваяСтрока.СчетКтИсточникКод		= Строка.КоррСчет;
		НоваяСтрока.Сумма_Источник			= Строка.Сумма_Источник;
		
	КонецЦикла;	
				
	Возврат ТаблицаСчетов;
	
КонецФункции // ПолучитьТаблицуКорреспонденцийСумма()

Процедура ДобавитьОтборПоПроводкам(Запрос,ОтборПроводок)
	
	Перем СчетДтИсточник;
	Перем СчетКтИсточник;
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"ПОМЕСТИТЬ ТаблицаСчетовСоответствия","ПОМЕСТИТЬ ТаблицаСчетовСоответствияОбщ");
	
	Если ТипЗнч(ОтборПроводок)=Тип("Массив") Тогда
		
		ТекстЗамены="ВЫБРАТЬ ТаблицаСчетовСоответствияОбщ.*
		|ПОМЕСТИТЬ ТаблицаСчетовСоответствия
		|ИЗ ТаблицаСчетовСоответствияОбщ
		|ГДЕ ТаблицаСчетовСоответствияОбщ.СчетДтИсточник В(&ОтборПроводок) ИЛИ ТаблицаСчетовСоответствияОбщ.СчетКтИсточник В(&ОтборПроводок)";
		
	ИначеЕсли ТипЗнч(ОтборПроводок)=Тип("Структура") Тогда
		
		ОтборПроводок.Свойство("СчетДтИсточник",СчетДтИсточник);
		ОтборПроводок.Свойство("СчетКтИсточник",СчетКтИсточник);
		
		Если ЗначениеЗаполнено(СчетДтИсточник) И ЗначениеЗаполнено(СчетКтИсточник) Тогда
			
			ТекстЗамены="ВЫБРАТЬ ТаблицаСчетовСоответствияОбщ.*
			|ПОМЕСТИТЬ ТаблицаСчетовСоответствия
			|ИЗ ТаблицаСчетовСоответствияОбщ
			|ГДЕ ТаблицаСчетовСоответствияОбщ.СчетДтИсточник В ИЕРАРХИИ(&СчетДтИсточник) И ТаблицаСчетовСоответствияОбщ.СчетКтИсточник В ИЕРАРХИИ(&СчетКтИсточник)";
			
			Запрос.УстановитьПараметр("СчетДтИсточник",СчетДтИсточник);
			Запрос.УстановитьПараметр("СчетКтИсточник",СчетКтИсточник);
			
		ИначеЕсли ЗначениеЗаполнено(СчетДтИсточник) Тогда
			
			ТекстЗамены="ВЫБРАТЬ ТаблицаСчетовСоответствияОбщ.*
			|ПОМЕСТИТЬ ТаблицаСчетовСоответствия
			|ИЗ ТаблицаСчетовСоответствияОбщ
			|ГДЕ ТаблицаСчетовСоответствияОбщ.СчетДтИсточник В ИЕРАРХИИ(&СчетДтИсточник)";
			
			Запрос.УстановитьПараметр("СчетДтИсточник",СчетДтИсточник);
			
		ИначеЕсли ЗначениеЗаполнено(СчетКтИсточник) Тогда
			
			ТекстЗамены="ВЫБРАТЬ ТаблицаСчетовСоответствияОбщ.*
			|ПОМЕСТИТЬ ТаблицаСчетовСоответствия
			|ИЗ ТаблицаСчетовСоответствияОбщ
			|ГДЕ ТаблицаСчетовСоответствияОбщ.СчетКтИсточник В ИЕРАРХИИ(&СчетКтИсточник)";
			
			Запрос.УстановитьПараметр("СчетКтИсточник",СчетКтИсточник);
			
		КонецЕсли;
				
	Иначе
		
		ТекстЗамены="ВЫБРАТЬ * Поместить ОтборПроводок
		|ИЗ &ОтборПроводок КАК ОтборПроводок
		|;
		|ВЫБРАТЬ ТаблицаСчетовСоответствияОбщ.*
		|Поместить ТаблицаСчетовСоответствия 
		|ИЗ ТаблицаСчетовСоответствияОбщ КАК ТаблицаСчетовСоответствияОбщ 
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроводок ПО ТаблицаСчетовСоответствияОбщ.СчетДтИсточник=ОтборПроводок.СчетДтИсточник
		|И ТаблицаСчетовСоответствияОбщ.СчетКтИсточник=ОтборПроводок.СчетКтИсточник";
		
	КонецЕсли;
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"ВЫБРАТЬ
	             |	ИСТИНА КАК Поле",ТекстЗамены);
	
	Запрос.УстановитьПараметр("ОтборПроводок",ОтборПроводок);
	
КонецПроцедуры // ДобавитьОтборПоПроводкам()

Функция ПолучитьЗапросСДвижениямиРегистратора(ДанныеОбъекта,ОтборСчетов=Неопределено,ПомещатьВТаблицу=Истина) 
	
	МаксКоличествоСубконто=КэшируемыеПроцедурыУХ.МаксКоличествоСубконто(ДанныеОбъекта.ПланСчетовИсточник);
	
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
	ТекстЗапроса="ВЫБРАТЬ
	|	ДвиженияССубконто.Период КАК Период,
	|	ДвиженияССубконто.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.Регистратор) КАК РегистраторПредставление,
	|	ДвиженияССубконто.СчетДт.Код КАК СчетДтКод,
	|	ДвиженияССубконто.СчетКт.Код КАК СчетКтКод,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		ТекстЗапроса=ТекстЗапроса+"
		|	ДвиженияССубконто.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|	ДвиженияССубконто.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоДт"+Индекс+" КАК ВидСубконтоДт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоКт"+Индекс+" КАК ВидСубконтоКт"+Индекс+",";
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
			
			ТекстЗапроса=ТекстЗапроса+"
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоДт"+Индекс+") КАК СубконтоДт"+Индекс+"Представление,
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоКт"+Индекс+") КАК СубконтоКт"+Индекс+"Представление,";
						
		КонецЕсли;
			
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	&ТекстРесурсы, 
	|	&ТекстИзмерения,
	|	ДвиженияССубконто.Содержание КАК Содержание,	
	|	ДвиженияССубконто.Активность КАК Активность";
	
	Если ПомещатьВТаблицу Тогда
		
		ТекстЗапроса=ТекстЗапроса+"
		|ПОМЕСТИТЬ ПроводкиПоОтбору";
		
	КонецЕсли;
	
	ТекстЗапроса=ТекстЗапроса+"
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(,,&ТекстАктивность И Регистратор = &Регистратор И &ОтборСчетов И &ДопОтбор,,) КАК ДвиженияССубконто";
	
	ТекстРесурсы="";
	ТекстИзмерения="";
		
	Для Каждого Ресурс ИЗ ДанныеОбъекта.ДанныеРегистра.Ресурсы Цикл
		
		Если Ресурс.Балансовый Тогда
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+" КАК "+Ресурс.Имя;
		Иначе
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+"Дт КАК "+Ресурс.Имя+"Дт,
			|ДвиженияССубконто."+Ресурс.Имя+"Кт КАК "+Ресурс.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+" КАК "+Измерение.Имя;
		Иначе
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+"Дт КАК "+Измерение.Имя+"Дт,
			|ДвиженияССубконто."+Измерение.Имя+"Кт КАК "+Измерение.Имя+"Кт";
		КонецЕсли; 
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
			
			Если Измерение.Балансовый Тогда
				ТекстИзмерения=ТекстИзмерения+",
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+") КАК "+Измерение.Имя+"Представление";
			Иначе
				ТекстИзмерения=ТекстИзмерения+",
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Дт) КАК "+Измерение.Имя+"ДтПредставление,
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Кт) КАК "+Измерение.Имя+"КтПредставление";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстРесурсы",Сред(ТекстРесурсы,3));
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстИзмерения",Сред(ТекстИзмерения,3));
	
	Если ДанныеОбъекта.Свойство("НеПроверятьАктивность") Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстАктивность","ИСТИНА");
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстАктивность","Активность");
		
	КонецЕсли;
	
	Если Не ОтборСчетов=Неопределено Тогда 
		
		ТекстОтбораСчетов="СчетДт.Код=&CчетДтИсточникКод И СчетКт.Код=&CчетКтИсточникКод";
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ОтборСчетов",ТекстОтбораСчетов);
		Запрос.УстановитьПараметр("CчетДтИсточникКод",ОтборСчетов.СчетДтИсточникКод);
		Запрос.УстановитьПараметр("CчетКтИсточникКод",ОтборСчетов.СчетКтИсточникКод);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ОтборСчетов","ИСТИНА");
		
	КонецЕсли;
	
	Если ДанныеОбъекта.Свойство("ДопОтборИсточник") Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ДопОтбор",ДанныеОбъекта.ДопОтборИсточник.ТекстОтбораИтог);
		
		Для Каждого СтрокаПараметр ИЗ ДанныеОбъекта.ДопОтборИсточник.ИспользуемыеПараметры Цикл
			
			Запрос.УстановитьПараметр(СтрокаПараметр.ИмяПараметра,СтрокаПараметр.ЗначениеПараметра);
			
		КонецЦикла;
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ДопОтбор","ИСТИНА");
		
	КонецЕсли;
				
	Запрос.Текст=СтрЗаменить(ТекстЗапроса,"Хозрасчетный",ДанныеОбъекта.ДанныеРегистра.Наименование);
	Запрос.УстановитьПараметр("Регистратор",ДанныеОбъекта.ИсходныйДокумент);	
	
	Если ПомещатьВТаблицу Тогда
		
		Запрос.Выполнить(); 
		
	КонецЕсли;
	
	Возврат Запрос;
		
КонецФункции // ПолучитьЗапросСДвижениямиРегистратора() 

Функция ПолучитьШаблонТаблицыРегистра(ДанныеОбъекта) 
	
	МаксКоличествоСубконто=КэшируемыеПроцедурыУХ.МаксКоличествоСубконто(ДанныеОбъекта.ПланСчетовИсточник);
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ Первые 1
	|	ДвиженияССубконто.Период КАК Период,
	|	ДвиженияССубконто.Регистратор КАК Регистратор,
	|	ДвиженияССубконто.СчетДт.Код КАК СчетДтКод,
	|	ДвиженияССубконто.СчетКт.Код КАК СчетКтКод,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		ТекстЗапроса=ТекстЗапроса+"
		|	ДвиженияССубконто.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|	ДвиженияССубконто.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоДт"+Индекс+" КАК ВидСубконтоДт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоКт"+Индекс+" КАК ВидСубконтоКт"+Индекс+",";
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	&ТекстРесурсы, 
	|	&ТекстИзмерения,
	|	ДвиженияССубконто.Содержание КАК Содержание,	
	|	ДвиженияССубконто.Активность КАК Активность
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНач,&ДатаКон,,,) КАК ДвиженияССубконто";
	
	ТекстРесурсы="";
	ТекстИзмерения="";
		
	Для Каждого Ресурс ИЗ ДанныеОбъекта.ДанныеРегистра.Ресурсы Цикл
		
		Если Ресурс.Балансовый Тогда
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+" КАК "+Ресурс.Имя;
		Иначе
			ТекстРесурсы=ТекстРесурсы+",
			|ДвиженияССубконто."+Ресурс.Имя+"Дт КАК "+Ресурс.Имя+"Дт,
			|ДвиженияССубконто."+Ресурс.Имя+"Кт КАК "+Ресурс.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+" КАК "+Измерение.Имя;
		Иначе
			ТекстИзмерения=ТекстИзмерения+",
			|ДвиженияССубконто."+Измерение.Имя+"Дт КАК "+Измерение.Имя+"Дт,
			|ДвиженияССубконто."+Измерение.Имя+"Кт КАК "+Измерение.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстРесурсы",Сред(ТекстРесурсы,3));
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстИзмерения",Сред(ТекстИзмерения,3));
				
	Запрос.Текст=СтрЗаменить(ТекстЗапроса,"Хозрасчетный",ДанныеОбъекта.ДанныеРегистра.Наименование);
	
	Запрос.УстановитьПараметр("ДатаНач",ТекущаяДата()); 
	Запрос.УстановитьПараметр("ДатаКон",ТекущаяДата());
	
	Возврат Запрос.Выполнить().Выгрузить().СкопироватьКолонки();
		
КонецФункции // ПолучитьШаблонТаблицыРегистра()

Функция ПолучитьЗапросСДвижениямиПоКорреспонденции(ДанныеОбъекта,ОтборСчетов,ЕстьПолеРегистратор=Ложь,ТранслироватьСодержание=Ложь) 
	
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
					
	Запрос.Текст=ПолучитьТекстЗапросаКДвижениямПоКорреспонденции(ДанныеОбъекта,ОтборСчетов,ЕстьПолеРегистратор,ТранслироватьСодержание);
	Запрос.УстановитьПараметр("CчетДтИсточникКод",ОтборСчетов.СчетДтИсточникКод);
	Запрос.УстановитьПараметр("CчетКтИсточникКод",ОтборСчетов.СчетКтИсточникКод);
	Запрос.УстановитьПараметр("ДатаНач",?(ДанныеОбъекта.Свойство("ДатаНач"),ДанныеОбъекта.ДатаНач,ДанныеОбъекта.ПериодОтчета.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон",?(ДанныеОбъекта.Свойство("ДатаКон"),ДанныеОбъекта.ДатаКон,КонецДня(ДанныеОбъекта.ПериодОтчета.ДатаОкончания)));
	Запрос.УстановитьПараметр("Организация",ДанныеОбъекта.Организация);
	
	Если ДанныеОбъекта.Свойство("ДопОтборИсточник") Тогда
		
		Для Каждого СтрокаПараметр ИЗ ДанныеОбъекта.ДопОтборИсточник.ИспользуемыеПараметры Цикл
			
			Запрос.УстановитьПараметр(СтрокаПараметр.ИмяПараметра,СтрокаПараметр.ЗначениеПараметра);
			
		КонецЦикла;
		
	КонецЕсли;
				
	Возврат Запрос;
		
КонецФункции // ПолучитьЗапросСДвижениямиПоКорреспонденции()

Функция ПолучитьДанныеЗапросаСДвижениямиПоКорреспонденции(ДанныеОбъекта,ОтборСчетов,ЕстьПолеРегистратор=Ложь,ТранслироватьСодержание=Ложь)

	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("НазначениеРасчетов",ПолучитьПравилоОбработки(ДанныеОбъекта));
			
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Получаем все корреспонденции счетов за период
	
	Запрос.Текст=Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
	
	мОперанды=Запрос.Выполнить().Выгрузить();
	
	Если мОперанды.Количество()=0 Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;	
	
	// обрезаем коды
	мОперанды.Колонки.Код.Имя = "Имя";
	мОперанды.Колонки.Добавить("Код");
	
	Для Каждого Стр Из мОперанды Цикл
		Стр.Код = СокрЛП(Стр.Имя);
	КонецЦикла;
	
	мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
	мОперанды.Индексы.Добавить("Код");
	
	мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
	мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
	
	мОперанды[0].СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос;	
				
	СтрЗапрос				= ПодготовитьДанныеДляЗапроса(мОперанды[0],мОперанды);
	СтрЗапрос.ТекстЗапроса	= ПолучитьТекстЗапросаКДвижениямПоКорреспонденции(ДанныеОбъекта,ОтборСчетов,ЕстьПолеРегистратор,ТранслироватьСодержание);
   	СтруктураЗапроса 		= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(ДанныеОбъекта,СтрЗапрос,Истина);
	
	МодульИнтеграции=ОбщегоНазначения.ОбщийМодуль("ИнтеграцияСВнешнимиСистемамиУХ");
	Возврат МодульИнтеграции.ПодготовитьДанныеДляНастройкиЗапроса(СтруктураЗапроса);	
	
КонецФункции // ПолучитьДанныеЗапросаСДвижениямиПоКорреспонденции() 

Функция ПолучитьТекстЗапросаКДвижениямПоКорреспонденции(ДанныеОбъекта,ОтборСчетов,ЕстьПолеРегистратор=Ложь,ТранслироватьСодержание=Ложь)

	МаксКоличествоСубконто=КэшируемыеПроцедурыУХ.МаксКоличествоСубконто(ДанныеОбъекта.ПланСчетовИсточник);
	
	ТекстПоля="";
	ТекстГруппировка="";
	
	ТекстПоля=ТекстПоля+"
	|	ДвиженияССубконто.Период КАК Период,
	|	ДвиженияССубконто.СчетДт.Код КАК СчетДтКод,
	|	ДвиженияССубконто.СчетКт.Код КАК СчетКтКод,
	|	ДвиженияССубконто.Активность КАК Активность,";
	
	ТекстГруппировка=ТекстГруппировка+"
	|	ДвиженияССубконто.Период,
	|	ДвиженияССубконто.СчетДт.Код,
	|	ДвиженияССубконто.СчетКт.Код,";
	
	Если ЕстьПолеРегистратор Тогда
		
		ТекстПоля=ТекстПоля+"
		|	ДвиженияССубконто.Регистратор КАК Регистратор,";
		
		ТекстГруппировка=ТекстГруппировка+"
		|	ДвиженияССубконто.Регистратор,"; 
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
			
			ТекстПоля=ТекстПоля+"
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.Регистратор) КАК РегистраторПредставление,";
			
			ТекстГруппировка=ТекстГруппировка+"
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.Регистратор),";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТранслироватьСодержание Тогда
		
		ТекстПоля=ТекстПоля+"
		|	ДвиженияССубконто.Содержание КАК Содержание,";
		
		ТекстГруппировка=ТекстГруппировка+"
		|	ДвиженияССубконто.Содержание,";
		
	КонецЕсли;
			
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		ТекстПоля=ТекстПоля+"
		|	ДвиженияССубконто.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|	ДвиженияССубконто.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоДт"+Индекс+" КАК ВидСубконтоДт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоКт"+Индекс+" КАК ВидСубконтоКт"+Индекс+",";
		
		ТекстГруппировка=ТекстГруппировка+"
		|	ДвиженияССубконто.СубконтоДт"+Индекс+",
		|	ДвиженияССубконто.СубконтоКт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоДт"+Индекс+",
		|	ДвиженияССубконто.ВидСубконтоКт"+Индекс+",";
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
			
			ТекстПоля=ТекстПоля+"
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоДт"+Индекс+") КАК СубконтоДт"+Индекс+"Представление,
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоКт"+Индекс+") КАК СубконтоКт"+Индекс+"Представление,";
					
			ТекстГруппировка=ТекстГруппировка+"
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоДт"+Индекс+"),
			|	ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто.СубконтоКт"+Индекс+"),";
				
		КонецЕсли;
		
	КонецЦикла; 
	
	ТекстРесурсы="";
		
	Для Каждого Ресурс ИЗ ДанныеОбъекта.ДанныеРегистра.Ресурсы Цикл
		
		Если Ресурс.Балансовый Тогда
			ТекстРесурсы=ТекстРесурсы+",
			|СУММА(ДвиженияССубконто."+Ресурс.Имя+") КАК "+Ресурс.Имя;
		Иначе
			ТекстРесурсы=ТекстРесурсы+",
			|СУММА(ДвиженияССубконто."+Ресурс.Имя+"Дт) КАК "+Ресурс.Имя+"Дт,
			|СУММА(ДвиженияССубконто."+Ресурс.Имя+"Кт) КАК "+Ресурс.Имя+"Кт";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			
			ТекстПоля=ТекстПоля+"
			|ДвиженияССубконто."+Измерение.Имя+" КАК "+Измерение.Имя+","; 
			
			ТекстГруппировка=ТекстГруппировка+"
			|ДвиженияССубконто."+Измерение.Имя+",";
			
		Иначе
			
			ТекстПоля=ТекстПоля+"
			|ДвиженияССубконто."+Измерение.Имя+"Дт КАК "+Измерение.Имя+"Дт,
			|ДвиженияССубконто."+Измерение.Имя+"Кт КАК "+Измерение.Имя+"Кт,";
			
			ТекстГруппировка=ТекстГруппировка+"
			|ДвиженияССубконто."+Измерение.Имя+"Дт,
			|ДвиженияССубконто."+Измерение.Имя+"Кт,";
			
		КонецЕсли; 
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
			
			Если Измерение.Балансовый Тогда
				
				ТекстПоля=ТекстПоля+"
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+") КАК "+Измерение.Имя+"Представление,"; 
				
				ТекстГруппировка=ТекстГруппировка+"
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"),";
				
			Иначе
				
				ТекстПоля=ТекстПоля+"
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Дт) КАК "+Измерение.Имя+"ДтПредставление,
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Кт) КАК "+Измерение.Имя+"КтПредставление,";
				
				ТекстГруппировка=ТекстГруппировка+"
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Дт),
				|ПРЕДСТАВЛЕНИЕ(ДвиженияССубконто."+Измерение.Имя+"Кт),";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	 
	
	ТекстГруппировка=ТекстГруппировка+"
	|	ДвиженияССубконто.Активность";
			
	ТекстЗапроса="ВЫБРАТЬ "+ТекстПоля+"
	|	&ТекстРесурсы 
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНач,&ДатаКон,&ТекстАктивность И Организация=&Организация И СчетДт.Код=&CчетДтИсточникКод И СчетКт.Код=&CчетКтИсточникКод И &ДопОтбор,,) КАК ДвиженияССубконто
	|СГРУППИРОВАТЬ ПО "+ТекстГруппировка;
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстРесурсы",Сред(ТекстРесурсы,3));
	
	Если ДанныеОбъекта.Свойство("НеПроверятьАктивность") Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстАктивность","ИСТИНА");
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ТекстАктивность","Активность");
		
	КонецЕсли; 
	
	Если ДанныеОбъекта.Свойство("ДопОтборИсточник") Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ДопОтбор",ДанныеОбъекта.ДопОтборИсточник.ТекстОтбораИтог);
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ДопОтбор","ИСТИНА");
		
	КонецЕсли;
		
	Возврат СтрЗаменить(ТекстЗапроса,"Хозрасчетный",ДанныеОбъекта.ДанныеРегистра.Наименование);
	
КонецФункции // ПолучитьТекстЗапросаКДвижениямПоКорреспонденции() 

Функция ПолучитьТаблицуДетальнойТрансляции(ДанныеОбъекта,СтрокаКолонокИсточник) Экспорт
	
	ДокументТрансляции	= Документы.Трансляция.СоздатьДокумент();
	ПроводкиДокумента	= ДокументТрансляции.Проводки.ВыгрузитьКолонки();
	
	СтрокаКолонокИсточник=СтрокаКолонокИсточник+",СчетДтИсточникКод,СчетКтИсточникКод,НеТранслируетсяПричина";
	ПроводкиДокумента.Колонки.Добавить("СчетДтИсточникКод");
	ПроводкиДокумента.Колонки.Добавить("СчетКтИсточникКод");
	ПроводкиДокумента.Колонки.Добавить("ПриоритетДт",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
	ПроводкиДокумента.Колонки.Добавить("ПриоритетКт",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
	
	ПроводкиДокумента.Колонки.Добавить("НеТранслируется",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ПроводкиДокумента.Колонки.Добавить("НеТранслируетсяПричина",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	
	ДанныеРегистра=КэшируемыеПроцедурыУХ.ПолучитьДанныеРегистра(ДанныеОбъекта.РегистрБухгалтерииИсточник);
	
	Для Индекс=1 ПО ДанныеРегистра.МаксимальноеКоличествоСубконто Цикл
		
		ПроводкиДокумента.Колонки.Добавить("СубконтоДтИсточник"+Индекс);
		ПроводкиДокумента.Колонки.Добавить("СубконтоКтИсточник"+Индекс);
		ПроводкиДокумента.Колонки.Добавить("СубконтоДтИсточник"+Индекс+"Представление");
		ПроводкиДокумента.Колонки.Добавить("СубконтоКтИсточник"+Индекс+"Представление");
		
		СтрокаКолонокИсточник=СтрокаКолонокИсточник+
					",СубконтоДтИсточник"+Индекс+
					",СубконтоКтИсточник"+Индекс+
					",СубконтоДтИсточник"+Индекс+"Представление"+
					",СубконтоКтИсточник"+Индекс+"Представление";
		
	КонецЦикла;
	
	Для Каждого СтрокаРесурс ИЗ ДанныеОбъекта.РесурсыДляОтображения Цикл
		
		Если ЗначениеЗаполнено(СтрокаРесурс.РесурсИсточник)
			И ЗначениеЗаполнено(СтрокаРесурс.РесурсПриемник)
			И СтрокаРесурс.РесурсИсточникБалансовый Тогда
		
			ПроводкиДокумента.Колонки.Добавить(СтрокаРесурс.РесурсИсточник+"_Источник",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПроводкиДокумента.Колонки.Добавить("Регистратор");
	ПроводкиДокумента.Колонки.Добавить("РегистраторПредставление");
	
	Для Каждого Измерение ИЗ ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"Источник"); 
			СтрокаКолонокИсточник=СтрокаКолонокИсточник+","+Измерение.Имя+"Источник"; 
			
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"ИсточникПредставление"); 
			СтрокаКолонокИсточник=СтрокаКолонокИсточник+","+Измерение.Имя+"ИсточникПредставление";

					
		Иначе
			
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"ДтИсточник");
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"КтИсточник");
			
			СтрокаКолонокИсточник=СтрокаКолонокИсточник+","+Измерение.Имя+"ДтИсточник"+","+Измерение.Имя+"КтИсточник"; 
			
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"ДтИсточникПредставление");
			ПроводкиДокумента.Колонки.Добавить(Измерение.Имя+"КтИсточникПредставление");
			
			СтрокаКолонокИсточник=СтрокаКолонокИсточник+","+Измерение.Имя+"ДтИсточникПредставление"+","+Измерение.Имя+"КтИсточникПредставление";
			
		КонецЕсли;
		
	КонецЦикла;
		
	ОтборПроводок=Новый Структура;
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.СчетДтИсточник) Тогда
		
		ОтборПроводок.Вставить("СчетДтИсточник",ДанныеОбъекта.СчетДтИсточник);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.СчетКтИсточник) Тогда
		
		ОтборПроводок.Вставить("СчетКтИсточник",ДанныеОбъекта.СчетКтИсточник);
		
	КонецЕсли; 
	
	ДанныеОбъекта.Вставить("ОтборПроводок",?(ОтборПроводок.Количество()=0,Неопределено,ОтборПроводок));
	
	ОтборПриемник=Новый Структура;
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.СчетДтПриемник) Тогда
		
		ОтборПриемник.Вставить("СчетДтПриемник",ДанныеОбъекта.СчетДтПриемник);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.СчетКтПриемник) Тогда
		
		ОтборПриемник.Вставить("СчетКтПриемник",ДанныеОбъекта.СчетКтПриемник);
		
	КонецЕсли; 
	
	Если ОтборПриемник.Количество()>0 Тогда
		
		ДанныеОбъекта.Вставить("ОтборПриемник",ОтборПриемник);
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ДанныеОбъекта.ШаблонКорректировки) Тогда
		
		ТаблицаШаблонов=ПолучитьТаблицуШаблоновКорректировок(ДанныеОбъекта)
		
	КонецЕсли;
	
	ВыполнитьТрансляциюПроводок(ДанныеОбъекта,ПроводкиДокумента);		
	Возврат ПроводкиДокумента;
	
КонецФункции // ПолучитьТаблицуДетальнойТрансляции() 

Процедура ДобавитьСтрокиБезМэппинга(ДанныеОбъекта,ПроводкиДокумента,ТаблицаСчетов)
	
	Перем СчетДтИсточник;
	Перем СчетКтИсточник;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ТаблицаСчетов.СчетДтИсточникКод КАК СчетДтИсточникКод,
	|	ТаблицаСчетов.СчетКтИсточникКод КАК СчетКтИсточникКод,
	|	ТаблицаСчетов.ЕстьСоответствиеДт КАК ЕстьСоответствиеДт,
	|	ТаблицаСчетов.ЕстьСоответствиеКт КАК ЕстьСоответствиеКт,
	|	ТаблицаСчетов.Сумма_Источник КАК Сумма_Источник
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	&ТаблицаСчетов КАК ТаблицаСчетов
	|ГДЕ
	|	НЕ ТаблицаСчетов.ВозможнаТрансляция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаБД.Код КАК Код,
	|	СчетаБД.Ссылка КАК СчетБД
	|ПОМЕСТИТЬ СчетаДт
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.Владелец = &Владелец
	|	И &ОтборСчетДт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаБД.Код КАК Код,
	|	СчетаБД.Ссылка КАК СчетБД
	|ПОМЕСТИТЬ СчетаКт
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.Владелец = &Владелец
	|	И &ОтборСчетКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСчетов.СчетДтИсточникКод КАК СчетДтИсточникКод,
	|	ТаблицаСчетов.СчетКтИсточникКод КАК СчетКтИсточникКод,
	|	ТаблицаСчетов.ЕстьСоответствиеДт КАК ЕстьСоответствиеДт,
	|	ТаблицаСчетов.ЕстьСоответствиеКт КАК ЕстьСоответствиеКт,
	|	ТаблицаСчетов.Сумма_Источник КАК Сумма_Источник,
	|	СчетаДт.СчетБД КАК СчетДтИсточник,
	|	СчетаКт.СчетБД КАК СчетКтИсточник
	|ИЗ
	|	ТаблицаСчетов КАК ТаблицаСчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаДт КАК СчетаДт
	|		ПО ТаблицаСчетов.СчетДтИсточникКод = СчетаДт.Код
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаКт КАК СчетаКт
	|		ПО ТаблицаСчетов.СчетКтИсточникКод = СчетаКт.Код";
	
	ОтборСчетДт="ИСТИНА";
	ОтборСчетКт="ИСТИНА";
	
	Если ТипЗнч(ДанныеОбъекта.ОтборПроводок)=Тип("Структура") Тогда
		
		ДанныеОбъекта.ОтборПроводок.Свойство("СчетДтИсточник",СчетДтИсточник);
		ДанныеОбъекта.ОтборПроводок.Свойство("СчетКтИсточник",СчетКтИсточник);
		
		Если ЗначениеЗаполнено(СчетДтИсточник) Тогда 
			
			ОтборСчетДт="СчетаБД.Ссылка В ИЕРАРХИИ(&СчетДтИсточник)";
			Запрос.УстановитьПараметр("СчетДтИсточник",СчетДтИсточник);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетКтИсточник) Тогда 
			
			ОтборСчетКт="СчетаБД.Ссылка В ИЕРАРХИИ(&СчетКтИсточник)";
			Запрос.УстановитьПараметр("СчетКтИсточник",СчетКтИсточник);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборСчетДт",ОтборСчетДт);
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборСчетКт",ОтборСчетКт);
	
	Запрос.УстановитьПараметр("ТаблицаСчетов",	ТаблицаСчетов);
	Запрос.УстановитьПараметр("Владелец",		ДанныеОбъекта.ПланСчетовИсточник);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=ПроводкиДокумента.Добавить();
		НоваяСтрока.СчетДтИсточникКод	= Результат.СчетДтИсточникКод;
		НоваяСтрока.СчетКтИсточникКод	= Результат.СчетКтИсточникКод;
		НоваяСтрока.Сумма_Источник		= Результат.Сумма_Источник;
		НоваяСтрока.НеТранслируется		= Истина;
		
		НеТранслируетсяПричина="";
		
		Если НЕ Результат.ЕстьСоответствиеДт Тогда
			
			НеТранслируетсяПричина=НеТранслируетсяПричина+",НетМэппингаДт";
			
		КонецЕсли;
		
		Если НЕ Результат.ЕстьСоответствиеКт Тогда
			
			НеТранслируетсяПричина=НеТранслируетсяПричина+",НетМэппингаКт";
			
		КонецЕсли;
		
		НоваяСтрока.НеТранслируетсяПричина=Сред(НеТранслируетсяПричина,2);
		
	КонецЦикла;
		
КонецПроцедуры // ДобавитьСтрокиБезМэппинга() 

Функция ПолучитьТаблицуШаблоновКорректировок(ДанныеОбъекта)
	
	
КонецФункции // ПолучитьТаблицуШаблоновКорректировок() 

Процедура ВыполнитьТрансляциюПроводок(ДанныеОбъекта,ПроводкиДокумента,ТаблицаСчетов=Неопределено,Дата=Неопределено,ПоРегистратору=Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) И КорректировкиЗначенийПоказателей32.ОтражениеПоНСБУЗаблокировано(ДанныеОбъекта.ИсходныйДокумент) Тогда
		
		ДанныеОбъекта.Вставить("НеПроверятьАктивность",Истина);
			
	КонецЕсли;
			
	Если ТаблицаСчетов=Неопределено Тогда
		
		Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда 
			
			ТаблицаСчетов=ПолучитьТаблицуКорреспонденцийСумма(ДанныеОбъекта);
			
		Иначе
			
			ТаблицаСчетов=ПолучитьТаблицуКорреспонденций(ДанныеОбъекта); 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаСчетов.Количество()=0 Тогда
		
		ПроводкиДокумента.Очистить();
		Возврат;
		
	КонецЕсли;
			
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Определяем для полученных корреспонденций настройки соответствия и правила трансляции
	// дебетовой и кредитовой стороны проводки
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ТаблицаСчетов.СчетДтИсточникКод КАК СчетДтИсточникКод,
	             |	ТаблицаСчетов.СчетКтИсточникКод КАК СчетКтИсточникКод
	             |ПОМЕСТИТЬ ТаблицаСчетов
	             |ИЗ
	             |	&ТаблицаСчетов КАК ТаблицаСчетов
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СоответствияСчетовДляТрансляции.Ссылка КАК Ссылка,
	             |	СоответствияСчетовДляТрансляции.СчетИсточник КАК СчетИсточник,
	             |	СоответствияСчетовДляТрансляции.СчетИсточник.Код КАК СчетИсточникКод,
	             |	СоответствияСчетовДляТрансляции.СчетПриемник КАК СчетПриемник,
	             |	СоответствияСчетовДляТрансляции.СчетПриемник.Код КАК СчетПриемникКод,
	             |	СоответствияСчетовДляТрансляции.КоррСчетИсточник КАК КоррСчетИсточник,
	             |	СоответствияСчетовДляТрансляции.КоррСчетИсточник.Код КАК КоррСчетИсточникКод,
	             |	НастройкиПравилТрансляции.ИспользованиеДт КАК ИспользованиеДт,
	             |	НастройкиПравилТрансляции.ИспользованиеКт КАК ИспользованиеКт,
	             |	НастройкиПравилТрансляции.ПриоритетТрансляции КАК Приоритет
	             |ПОМЕСТИТЬ ТрансляцияПоКорреспонденции
	             |ИЗ
	             |	Справочник.СоответствияСчетовДляТрансляции КАК СоответствияСчетовДляТрансляции
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилТрансляции КАК НастройкиПравилТрансляции
	             |		ПО СоответствияСчетовДляТрансляции.Ссылка = НастройкиПравилТрансляции.СоответствиеСчетов
	             |ГДЕ
	             |	СоответствияСчетовДляТрансляции.Владелец = &ШаблонТрансляции
	             |	И НЕ СоответствияСчетовДляТрансляции.КоррСчетИсточник = ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СоответствияСчетовДляТрансляции.Ссылка КАК Ссылка,
	             |	СоответствияСчетовДляТрансляции.СчетИсточник КАК СчетИсточник,
	             |	СоответствияСчетовДляТрансляции.СчетИсточник.Код КАК СчетИсточникКод,
	             |	СоответствияСчетовДляТрансляции.СчетПриемник КАК СчетПриемник,
	             |	СоответствияСчетовДляТрансляции.СчетПриемник.Код КАК СчетПриемникКод,
	             |	СоответствияСчетовДляТрансляции.КоррСчетИсточник КАК КоррСчетИсточник,
	             |	СоответствияСчетовДляТрансляции.КоррСчетИсточник.Код КАК КоррСчетИсточникКод,
	             |	НастройкиПравилТрансляции.ИспользованиеДт КАК ИспользованиеДт,
	             |	НастройкиПравилТрансляции.ИспользованиеКт КАК ИспользованиеКт,
	             |	НастройкиПравилТрансляции.ПриоритетТрансляции КАК Приоритет
	             |ПОМЕСТИТЬ СоотвествияТрансляция
	             |ИЗ
	             |	Справочник.СоответствияСчетовДляТрансляции КАК СоответствияСчетовДляТрансляции
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилТрансляции КАК НастройкиПравилТрансляции
	             |		ПО СоответствияСчетовДляТрансляции.Ссылка = НастройкиПравилТрансляции.СоответствиеСчетов
	             |ГДЕ
	             |	СоответствияСчетовДляТрансляции.Владелец = &ШаблонТрансляции
	             |	И СоответствияСчетовДляТрансляции.КоррСчетИсточник = ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ТаблицаСчетов.СчетДтИсточникКод КАК СчетДтИсточникКод,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииДт.СчетИсточник ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииДт.СчетИсточник
	             |		ИНАЧЕ СоответствияСчетовДт.СчетИсточник
	             |	КОНЕЦ КАК СчетДтИсточник,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииДт.СчетПриемник ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииДт.СчетПриемник
	             |		ИНАЧЕ СоответствияСчетовДт.СчетПриемник
	             |	КОНЕЦ КАК СчетДтПриемник,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииДт.СчетПриемникКод ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииДт.СчетПриемникКод
	             |		ИНАЧЕ СоответствияСчетовДт.СчетПриемникКод
	             |	КОНЕЦ КАК СчетДтПриемникКод,
	             |	ТаблицаСчетов.СчетКтИсточникКод КАК СчетКтИсточникКод,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииКт.СчетИсточник ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииКт.СчетИсточник
	             |		ИНАЧЕ СоответствияСчетовКт.СчетИсточник
	             |	КОНЕЦ КАК СчетКтИсточник,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииКт.СчетПриемник ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииКт.СчетПриемник
	             |		ИНАЧЕ СоответствияСчетовКт.СчетПриемник
	             |	КОНЕЦ КАК СчетКтПриемник,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииКт.СчетПриемникКод ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииКт.СчетПриемникКод
	             |		ИНАЧЕ СоответствияСчетовКт.СчетПриемникКод
	             |	КОНЕЦ КАК СчетКтПриемникКод,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииДт.Ссылка ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииДт.Ссылка
	             |		ИНАЧЕ СоответствияСчетовДт.Ссылка
	             |	КОНЕЦ КАК СоответствиеДт,
	             |	ВЫБОР
	             |		КОГДА НЕ ТрансляцияПоКорреспонденцииКт.Ссылка ЕСТЬ NULL
	             |			ТОГДА ТрансляцияПоКорреспонденцииКт.Ссылка
	             |		ИНАЧЕ СоответствияСчетовКт.Ссылка
	             |	КОНЕЦ КАК СоответствиеКт
	             |ПОМЕСТИТЬ ТаблицаСчетовСоответствия
	             |ИЗ
	             |	ТаблицаСчетов КАК ТаблицаСчетов
	             |		ЛЕВОЕ СОЕДИНЕНИЕ СоотвествияТрансляция КАК СоответствияСчетовДт
	             |		ПО ТаблицаСчетов.СчетДтИсточникКод = СоответствияСчетовДт.СчетИсточникКод
	             |			И (СоответствияСчетовДт.ИспользованиеДт)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ СоотвествияТрансляция КАК СоответствияСчетовКт
	             |		ПО ТаблицаСчетов.СчетКтИсточникКод = СоответствияСчетовКт.СчетИсточникКод
	             |			И (СоответствияСчетовКт.ИспользованиеКт)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ТрансляцияПоКорреспонденции КАК ТрансляцияПоКорреспонденцииДт
	             |		ПО ТаблицаСчетов.СчетДтИсточникКод = ТрансляцияПоКорреспонденцииДт.СчетИсточникКод
	             |			И ТаблицаСчетов.СчетКтИсточникКод = ТрансляцияПоКорреспонденцииДт.КоррСчетИсточникКод
	             |			И (ТрансляцияПоКорреспонденцииДт.ИспользованиеДт)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ТрансляцияПоКорреспонденции КАК ТрансляцияПоКорреспонденцииКт
	             |		ПО ТаблицаСчетов.СчетКтИсточникКод = ТрансляцияПоКорреспонденцииКт.СчетИсточникКод
	             |			И ТаблицаСчетов.СчетДтИсточникКод = ТрансляцияПоКорреспонденцииКт.КоррСчетИсточникКод
	             |			И (ТрансляцияПоКорреспонденцииКт.ИспользованиеКт)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ИСТИНА КАК Поле
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТаблицаСчетовСоответствия.СчетДтИсточникКод КАК СчетДтИсточникКод,
	             |	ТаблицаСчетовСоответствия.СчетДтИсточник КАК СчетДтИсточник,
	             |	ТаблицаСчетовСоответствия.СчетДтПриемник КАК СчетДтПриемник,
	             |	ТаблицаСчетовСоответствия.СчетДтПриемникКод КАК СчетДтПриемникКод,
	             |	ТаблицаСчетовСоответствия.СчетКтИсточникКод КАК СчетКтИсточникКод,
	             |	ТаблицаСчетовСоответствия.СчетКтИсточник КАК СчетКтИсточник,
	             |	ТаблицаСчетовСоответствия.СчетКтПриемник КАК СчетКтПриемник,
	             |	ТаблицаСчетовСоответствия.СчетКтПриемникКод КАК СчетКтПриемникКод,
	             |	ТаблицаСчетовСоответствия.СоответствиеДт КАК СоответствиеДт,
	             |	ТаблицаСчетовСоответствия.СоответствиеКт КАК СоответствиеКт,
	             |	ПравилаДт.Ссылка КАК ПравилоДт,
	             |	ПравилаКт.Ссылка КАК ПравилоКт,
	             |	ЕСТЬNULL(ПравилаДт.ЕстьНестандартныеОтборы, ЛОЖЬ) КАК ЕстьНестандартныеОтборыДт,
	             |	ЕСТЬNULL(ПравилаКт.ЕстьНестандартныеОтборы, ЛОЖЬ) КАК ЕстьНестандартныеОтборыКт,
	             |	ЕСТЬNULL(НастройкиПравилТрансляцииДт.ИспользованиеДт, ЛОЖЬ) КАК ИспользованиеДт,
	             |	ЕСТЬNULL(НастройкиПравилТрансляцииКт.ИспользованиеКт, ЛОЖЬ) КАК ИспользованиеКт,
	             |	ЕСТЬNULL(НастройкиПравилТрансляцииДт.ПриоритетТрансляции, 0) КАК ПриоритетДт,
	             |	ЕСТЬNULL(НастройкиПравилТрансляцииКт.ПриоритетТрансляции, 0) КАК ПриоритетКт
	             |ИЗ
	             |	ТаблицаСчетовСоответствия КАК ТаблицаСчетовСоответствия
	             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ПравилаДт
	             |		ПО ТаблицаСчетовСоответствия.СоответствиеДт = ПравилаДт.ПотребительРасчета
	             |			И (ПравилаДт.НазначениеРасчетов = &ПравилоОбработки)
	             |			И (ПравилаДт.ТрансляцияДебет)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ПравилаКт
	             |		ПО ТаблицаСчетовСоответствия.СоответствиеКт = ПравилаКт.ПотребительРасчета
	             |			И (ПравилаКт.НазначениеРасчетов = &ПравилоОбработки)
	             |			И (ПравилаКт.ТрансляцияКредит)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилТрансляции КАК НастройкиПравилТрансляцииДт
	             |		ПО ТаблицаСчетовСоответствия.СоответствиеДт = НастройкиПравилТрансляцииДт.СоответствиеСчетов
	             |			И (НастройкиПравилТрансляцииДт.ШаблонТрансляции = &ШаблонТрансляции)
	             |			И (НастройкиПравилТрансляцииДт.ИспользованиеДт)
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилТрансляции КАК НастройкиПравилТрансляцииКт
	             |		ПО ТаблицаСчетовСоответствия.СоответствиеКт = НастройкиПравилТрансляцииКт.СоответствиеСчетов
	             |			И (НастройкиПравилТрансляцииКт.ШаблонТрансляции = &ШаблонТрансляции)
	             |			И (НастройкиПравилТрансляцииКт.ИспользованиеКт)";
	
	Запрос.УстановитьПараметр("ТаблицаСчетов",ТаблицаСчетов);
	Запрос.УстановитьПараметр("ШаблонТрансляции",ДанныеОбъекта.ШаблонКорректировки);
	Запрос.УстановитьПараметр("ПравилоОбработки",ДанныеОбъекта.ПравилоОбработки);
	
	Если НЕ ДанныеОбъекта.ОтборПроводок=Неопределено Тогда
		
		ДобавитьОтборПоПроводкам(Запрос,ДанныеОбъекта.ОтборПроводок);
		
	КонецЕсли;
		
	РабочаяТаблица=Запрос.Выполнить().Выгрузить(); 	
	мОписаниеТиповБулево=ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево();
	
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Проверяем:
	//	 - актуальность справочников "СчетаБД" для источника и приемника
	//	 - достаточность настроек для трансляции всех корреспонденций, 
	//	при недостаточности - формируем протокол
		
	РабочаяТаблица.Колонки.Добавить("Транслировать",мОписаниеТиповБулево);
	
	ТаблицаСчетов.Колонки.Добавить("ЕстьСоответствиеДт",	мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьСоответствиеКт",	мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьПравилоДт",			мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьПравилоКт",			мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьСчетБДИсточникДт",	мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьСчетБДИсточникКт",	мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ВозможнаТрансляция",	мОписаниеТиповБулево);
	ТаблицаСчетов.Колонки.Добавить("ЕстьНестандартныеОтборы",мОписаниеТиповБулево);
	
	Для Каждого СтрокаСчет ИЗ ТаблицаСчетов Цикл
		
		МассивСоответствий=РабочаяТаблица.НайтиСтроки(Новый Структура("СчетДтИсточникКод,СчетКтИсточникКод",СтрокаСчет.СчетДтИсточникКод,СтрокаСчет.СчетКтИсточникКод));
		
		Для Каждого РабочаяСтрока ИЗ МассивСоответствий Цикл 
			
			Если РабочаяСтрока.ЕстьНестандартныеОтборыДт ИЛИ РабочаяСтрока.ЕстьНестандартныеОтборыКт Тогда
				
				СтрокаСчет.ЕстьНестандартныеОтборы=Истина;
				
			КонецЕсли;
				
			Если ЗначениеЗаполнено(РабочаяСтрока.СоответствиеДт) Тогда
				
				СтрокаСчет.ЕстьСоответствиеДт=Истина;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РабочаяСтрока.СоответствиеКт) Тогда
				
				СтрокаСчет.ЕстьСоответствиеКт=Истина;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РабочаяСтрока.ПравилоДт) Тогда
				
				СтрокаСчет.ЕстьПравилоДт=Истина;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РабочаяСтрока.ПравилоКт) Тогда
				
				СтрокаСчет.ЕстьПравилоКт=Истина;
				
			КонецЕсли;
						
			РабочаяСтрока.Транслировать=(ЗначениеЗаполнено(РабочаяСтрока.СоответствиеДт) 
										И ЗначениеЗаполнено(РабочаяСтрока.СоответствиеКт)
										И ЗначениеЗаполнено(РабочаяСтрока.ПравилоДт)
										И ЗначениеЗаполнено(РабочаяСтрока.ПравилоКт));
										
		КонецЦикла;

		СтрокаСчет.ВозможнаТрансляция=(СтрокаСчет.ЕстьСоответствиеДт 
										И СтрокаСчет.ЕстьСоответствиеКт 
										И СтрокаСчет.ЕстьПравилоДт 
										И СтрокаСчет.ЕстьПравилоКт);
		
	КонецЦикла;	
	
	Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		ДобавитьСтрокиБезМэппинга(ДанныеОбъекта,ПроводкиДокумента,ТаблицаСчетов);
						
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////
	// Получаем правила отбора и сопоставления полей для каждой корреспонденции
		
	ТаблицаТрансляции=РабочаяТаблица.Скопировать(Новый Структура("Транслировать",Истина));
	ТаблицаСчетовИсточник=ТаблицаСчетов.Скопировать(Новый Структура("ВозможнаТрансляция",Истина));
	
	Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		ТаблицаСчетовИсточник.ЗаполнитьЗначения(Истина,"ЕстьНестандартныеОтборы");
		
	КонецЕсли;
			
	Запрос.Текст="ВЫБРАТЬ
