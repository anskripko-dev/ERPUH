	ДанныеДляЗаполнения.Вставить("ЗапросКурсов",ЗапросКурсов);
	ДанныеДляЗаполнения.Вставить("ТаблицаСчетовИсточник",ТаблицаСчетовИсточник);
	
	ПолучитьДанныеСтандартныеНастройки(ДанныеОбъекта,РабочаяТаблицаСтандартная,ПроводкиДокумента,ДанныеДляЗаполнения);
	
	Если ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
		
		ПолучитьДанныеДопОтборыТекущаяИБ(ДанныеОбъекта,РабочаяТаблицаДопОтборы,ПроводкиДокумента,ДанныеДляЗаполнения);
		
	Иначе
		
		ПолучитьДанныеДопОтборыВнешняяИБ(ДанныеОбъекта,РабочаяТаблицаДопОтборы,ПроводкиДокумента,ДанныеДляЗаполнения);
		
	КонецЕсли;
		
	ЗапросДвижения=Неопределено;
	ДанныеОбъекта.Вставить("ЗапросДвижения",ЗапросДвижения);
	МаксКоличествоСубконто=КэшируемыеПроцедурыУХ.МаксКоличествоСубконто(ДанныеОбъекта.ПланСчетов);
	
	Если БезКорреспонденции Тогда
		
		ПроводкиДокумента=ПреобразоватьТаблицуПроводок(ПроводкиДокумента,КоррСчет,МаксКоличествоСубконто);
		
	КонецЕсли;
	
	Если (НЕ ПроводкиДокумента.Колонки.Найти("Регистратор")=Неопределено)
		ИЛИ ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент)
		ИЛИ ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	|	ТрансляцияПроводки.СчетДт КАК СчетДт,
	|	ТрансляцияПроводки.Значение КАК Значение,
	|	ТрансляцияПроводки.ПредставлениеЗначения КАК ПредставлениеЗначения,
	|	ТрансляцияПроводки.СчетКт КАК СчетКт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|ТрансляцияПроводки.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|ТрансляцияПроводки.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	ТрансляцияПроводки.ШаблонПроводки КАК ШаблонПроводки,
	|	ТрансляцияПроводки.РесурсРегистра КАК РесурсРегистра,
	|	ТрансляцияПроводки.ВалютаДт КАК ВалютаДт,
	|	ТрансляцияПроводки.ВалютаКт КАК ВалютаКт,
	|	ТрансляцияПроводки.ЗначениеВалютаДт КАК ЗначениеВалютаДт,
	|	ТрансляцияПроводки.ЗначениеВалютаКт КАК ЗначениеВалютаКт,
	|	ТрансляцияПроводки.ДатаПроводки КАК ДатаПроводки,
	|	ТрансляцияПроводки.СчетДтИсточник КАК СчетДтИсточник,
	|	ТрансляцияПроводки.СчетКтИсточник КАК СчетКтИсточник,
	|	ТрансляцияПроводки.ПравилоДт КАК ПравилоДт,
	|	ТрансляцияПроводки.ПравилоКт КАК ПравилоКт,
	|	ТрансляцияПроводки.КоличествоДт КАК КоличествоДт,
	|	ТрансляцияПроводки.КоличествоКт КАК КоличествоКт,
	|	ТрансляцияПроводки.Период КАК Период,
	|	ТрансляцияПроводки.Содержание КАК Содержание,
	|	ТрансляцияПроводки.ВидОперации КАК ВидОперации,
	|	ТрансляцияПроводки.ПодразделениеДт КАК ПодразделениеДт,
	|	ТрансляцияПроводки.ПодразделениеКт КАК ПодразделениеКт,
	|	ТрансляцияПроводки.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	ТрансляцияПроводки.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт
	|ПОМЕСТИТЬ ИсходныеПроводки
	|ИЗ
	|	&ПроводкиДокумента КАК ТрансляцияПроводки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсходныеПроводки.СчетДт КАК СчетДт,
	|	ИсходныеПроводки.СчетКт КАК СчетКт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|ИсходныеПроводки.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|ИсходныеПроводки.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	СУММА(ИсходныеПроводки.Значение) КАК Значение, 
	|	СУММА(ИсходныеПроводки.ПредставлениеЗначения) КАК ПредставлениеЗначения,
	|	ИсходныеПроводки.ШаблонПроводки КАК ШаблонПроводки,
	|	ИсходныеПроводки.РесурсРегистра КАК РесурсРегистра,
	|	ИсходныеПроводки.ВалютаДт КАК ВалютаДт,
	|	ИсходныеПроводки.ВалютаКт КАК ВалютаКт,
	|	СУММА(ИсходныеПроводки.ЗначениеВалютаДт) КАК ЗначениеВалютаДт,
	|	СУММА(ИсходныеПроводки.ЗначениеВалютаКт) КАК ЗначениеВалютаКт,
	|	ИсходныеПроводки.ДатаПроводки КАК ДатаПроводки,
	|	ИсходныеПроводки.СчетДтИсточник КАК СчетДтИсточник,
	|	ИсходныеПроводки.СчетКтИсточник КАК СчетКтИсточник,
	|	ИсходныеПроводки.ПравилоДт КАК ПравилоДт,
	|	ИсходныеПроводки.ПравилоКт КАК ПравилоКт,
	|	СУММА(ИсходныеПроводки.КоличествоДт) КАК КоличествоДт,
	|	СУММА(ИсходныеПроводки.КоличествоКт) КАК КоличествоКт,
	|	ИсходныеПроводки.Период КАК Период, 
	|	ИсходныеПроводки.Содержание КАК Содержание,
	|	ИсходныеПроводки.ВидОперации КАК ВидОперации,
	|	ИсходныеПроводки.ПодразделениеДт КАК ПодразделениеДт,
	|	ИсходныеПроводки.ПодразделениеКт КАК ПодразделениеКт,
	|	ИсходныеПроводки.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	ИсходныеПроводки.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт
	|ИЗ
	|	ИсходныеПроводки КАК ИсходныеПроводки
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсходныеПроводки.ПравилоДт,
	|	ИсходныеПроводки.ПравилоКт,
	|	ИсходныеПроводки.ПодразделениеКт,
	|	ИсходныеПроводки.НаправлениеДеятельностиДт,
	|	ИсходныеПроводки.СчетКт,
	|	ИсходныеПроводки.СчетДт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|ИсходныеПроводки.СубконтоДт"+Индекс+",
		|ИсходныеПроводки.СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	ИсходныеПроводки.ВалютаКт,
	|	ИсходныеПроводки.ДатаПроводки,
	|	ИсходныеПроводки.ВалютаДт,
	|	ИсходныеПроводки.СчетКтИсточник,
	|	ИсходныеПроводки.СчетДтИсточник,
	|	ИсходныеПроводки.ШаблонПроводки,
	|	ИсходныеПроводки.Период, 
	|	ИсходныеПроводки.Содержание,
	|	ИсходныеПроводки.ВидОперации,
	|	ИсходныеПроводки.ПодразделениеДт,
	|	ИсходныеПроводки.РесурсРегистра,
	|	ИсходныеПроводки.НаправлениеДеятельностиКт";
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ПроводкиДокумента",ПроводкиДокумента);
	
	ПроводкиДокумента=Запрос.Выполнить().Выгрузить();
	ПроводкиДокумента.Колонки.Добавить("НомерПроводки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(9));
	
	ДанныеОбъекта.Вставить("ПроводкиДокумента",ПроводкиДокумента);
	
КонецПроцедуры // ВыполнитьТрансляциюПроводок()

Процедура ДобавитьОтборПриемник(Запрос,ОтборПриемник)
	
	Перем СчетДтПриемник;
	Перем СчетКтПриемник;
	
	ОтборПриемник.Свойство("СчетДтПриемник",СчетДтПриемник);
	ОтборПриемник.Свойство("СчетКтПриемник",СчетКтПриемник);
	
	Если ЗначениеЗаполнено(СчетДтПриемник) И ЗначениеЗаполнено(СчетКтПриемник) Тогда
		
		ТекстЗамены="ТаблицаТрансляции.СчетДтПриемник В ИЕРАРХИИ(&СчетДтПриемник) И ТаблицаТрансляции.СчетКтПриемник В ИЕРАРХИИ(&СчетКтПриемник)";
		
		Запрос.УстановитьПараметр("СчетДтПриемник",СчетДтПриемник);
		Запрос.УстановитьПараметр("СчетКтПриемник",СчетКтПриемник);
		
	ИначеЕсли ЗначениеЗаполнено(СчетДтПриемник) Тогда
		
		ТекстЗамены="ТаблицаТрансляции.СчетДтПриемник В ИЕРАРХИИ(&СчетДтПриемник)";
		
		Запрос.УстановитьПараметр("СчетДтПриемник",СчетДтПриемник);
		
	ИначеЕсли ЗначениеЗаполнено(СчетКтПриемник) Тогда
		
		ТекстЗамены="ТаблицаТрансляции.СчетКтПриемник В ИЕРАРХИИ(&СчетКтПриемник)";
		
		Запрос.УстановитьПараметр("СчетКтПриемник",СчетКтПриемник);
		
	КонецЕсли;
	
	Запрос.Текст=СтрЗаменить(Запрос.Текст,"&ОтборПриемник",ТекстЗамены);
	
КонецПроцедуры // ДобавитьОтборПриемник() 
	
Процедура ПолучитьДанныеСтандартныеНастройки(ДанныеОбъекта,РабочаяТаблицаСтандартная,ПроводкиДокумента,ДанныеДляЗаполнения)
	
	Для Каждого РабочаяСтрока ИЗ РабочаяТаблицаСтандартная Цикл
		
		Если ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
										
			ТаблицаДанных=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрПроизвольный(ДанныеОбъекта,РабочаяСтрока.СтрЗапрос);
			
		Иначе
			
			РабочаяТаблица	 	= РасширениеИнтеграцииУХ.ПолучитьТаблицуДанныхПоЗапросу(РабочаяСтрока.СтрЗапрос);
			ТекПравило			= ОбщегоНазначенияУХ.ПолучитьЭлементСтруктурыПоИндексу(РабочаяСтрока.СтрЗапрос.СтруктураПолей,0).Значение;
			ТаблицаДанных		= РасширениеИнтеграцииУХ.ТрансформироватьВнешниеДанные(ДанныеОбъекта,РабочаяТаблица,ТекПравило);
			
			Если ТаблицаДанных=Ложь Тогда
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли; 
		
		ЗаписатьТаблицуДанныхВПроводкиДокумента(ДанныеОбъекта,РабочаяСтрока,ТаблицаДанных,ПроводкиДокумента,ДанныеДляЗаполнения);
				
	КонецЦикла;
		
КонецПроцедуры // ПолучитьДанныеСтандартныеНастройки()

Функция ПолучитьДанныеПоТаблицеДвижений(КонтекстОтчета,Запрос,СтрЗапрос)
				
	ТекПравилаВычисленияПараметров=СтрЗапрос.ПравилаВычисленияПараметров.Скопировать();
	ТекПравилаВычисленияПараметров.Колонки.Добавить("ИзКонтекста",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста"); 
	
	Для Каждого Параметр Из ТекПравилаВычисленияПараметров Цикл
		
		Если Параметр.ПолеБД="ДатаНач"
			ИЛИ Параметр.ПолеБД="ДатаКон" Тогда

			Продолжить;
			
		КонецЕсли;
				
		СвойстваОтбора=УправлениеОтчетамиУХ.ПолучитьСвойстваПараметра(КонтекстОтчета,Параметр);			
		Запрос.УстановитьПараметр(Параметр.ИмяПараметра,Параметр.ЗначениеИзКонтекста);
					
	КонецЦикла;
		
	ПравилаИспользованияПолей=СтрЗапрос.ТаблицаОперандов[0].ПравилаИспользованияПолейЗапроса;
	
	ТабРезультат=Запрос.Выполнить().Выгрузить(); 
		
	Для Каждого СтрПоле Из ПравилаИспользованияПолей Цикл
		
		Если СтрПоле.КодАналитики="Значение" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если (НЕ (ТабРезультат.Колонки.Найти(СтрПоле.Синоним)=Неопределено ИЛИ ПустаяСтрока(СтрПоле.КодАналитики)))
			И ТабРезультат.Колонки.Найти(СтрПоле.КодАналитики)=Неопределено Тогда 
			
			ТабРезультат.Колонки[СтрПоле.Синоним].Имя=СтрПоле.КодАналитики;
			
		КонецЕсли;
		
	КонецЦикла;

	УправлениеОтчетамиУХ.ЗаполнитьАналитикиПринудительно(ТабРезультат,ПравилаИспользованияПолей,КонтекстОтчета);
	
	Возврат ТабРезультат;
		
КонецФункции // ПолучитьДанныеПоТаблицеДвижений()

Функция ПолучитьДанныеИсточника(ДанныеОбъекта,СтрокаДанные,СтрокаКорреспонденция,МассивИсключаемыхВНА)
	
	Если НЕ ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ДанныеИсточника=Новый Структура;
	НеТранслируетсяПричина="";
	
	Для Индекс=1 ПО ДанныеОбъекта.ДанныеРегистра.МаксимальноеКоличествоСубконто Цикл
		
		ДанныеИсточника.Вставить("СубконтоДтИсточник"+Индекс,СтрокаДанные["СубконтоДт"+Индекс]);
		ДанныеИсточника.Вставить("СубконтоКтИсточник"+Индекс,СтрокаДанные["СубконтоКт"+Индекс]);
		
		ДанныеИсточника.Вставить("СубконтоДтИсточник"+Индекс+"Представление",СтрокаДанные["СубконтоДт"+Индекс+"Представление"]);
		ДанныеИсточника.Вставить("СубконтоКтИсточник"+Индекс+"Представление",СтрокаДанные["СубконтоКт"+Индекс+"Представление"]);
		
		Если НЕ МассивИсключаемыхВНА=Неопределено Тогда
			
			Если НЕ МассивИсключаемыхВНА.НайтиПоЗначению(СтрокаДанные["СубконтоДт"+Индекс])=Неопределено Тогда
				
				НеТранслируетсяПричина=НеТранслируетсяПричина+",СубконтоДтИсточник"+Индекс;
					
			КонецЕсли;
			
			Если НЕ МассивИсключаемыхВНА.НайтиПоЗначению(СтрокаДанные["СубконтоКт"+Индекс])=Неопределено Тогда
				
				НеТранслируетсяПричина=НеТранслируетсяПричина+",СубконтоКтИсточник"+Индекс;
					
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла; 
	
	ДанныеИсточника.Вставить("НеТранслируетсяПричина",НеТранслируетсяПричина);
	
	Для Каждого СтрокаРесурс ИЗ ДанныеОбъекта.РесурсыДляОтображения Цикл
		
		Если ЗначениеЗаполнено(СтрокаРесурс.РесурсИсточник)
			И ЗначениеЗаполнено(СтрокаРесурс.РесурсПриемник)
			И СтрокаРесурс.РесурсИсточникБалансовый Тогда
		
			ДанныеИсточника.Вставить(СтрокаРесурс.РесурсИсточник+"_Источник",СтрокаДанные[СтрокаРесурс.РесурсИсточник]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СтрокаДанные.Владелец().Колонки.Найти("Регистратор")=Неопределено Тогда
		
		ДанныеИсточника.Вставить("Регистратор",СтрокаДанные.Регистратор);
		ДанныеИсточника.Вставить("РегистраторПредставление",СтрокаДанные.РегистраторПредставление);

		
	КонецЕсли; 
	
	ДанныеИсточника.Вставить("ПериодИсточник",СтрокаДанные.Период);
	
	Для Каждого Измерение ИЗ ДанныеОбъекта.ДанныеРегистра.Измерения Цикл
		
		Если Измерение.Балансовый Тогда
			
			ДанныеИсточника.Вставить(Измерение.Имя+"Источник",СтрокаДанные[Измерение.Имя]);
			ДанныеИсточника.Вставить(Измерение.Имя+"ИсточникПредставление",СтрокаДанные[Измерение.Имя+"Представление"]);
					
		Иначе
			
			ДанныеИсточника.Вставить(Измерение.Имя+"ДтИсточник",СтрокаДанные[Измерение.Имя+"Дт"]);
			ДанныеИсточника.Вставить(Измерение.Имя+"КтИсточник",СтрокаДанные[Измерение.Имя+"Кт"]);

			
			ДанныеИсточника.Вставить(Измерение.Имя+"ДтИсточникПредставление",СтрокаДанные[Измерение.Имя+"ДтПредставление"]);
			ДанныеИсточника.Вставить(Измерение.Имя+"КтИсточникПредставление",СтрокаДанные[Измерение.Имя+"КтПредставление"]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеИсточника.Вставить("СчетДтИсточникКод",СтрокаКорреспонденция.СчетДтИсточникКод);
	ДанныеИсточника.Вставить("СчетКтИсточникКод",СтрокаКорреспонденция.СчетКтИсточникКод);
	
	Возврат ДанныеИсточника;
		
КонецФункции // ПолучитьДанныеИсточника() 

Процедура ПолучитьДанныеДопОтборыТекущаяИБ(ДанныеОбъекта,РабочаяТаблицаДопОтборы,ПроводкиДокумента,ДанныеДляЗаполнения)
	
	ТранслироватьСодержание=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.ШаблонКорректировки,"ТранслироватьСодержаниеПроводок");
	ШаблонТаблицыРегистра=ПолучитьШаблонТаблицыРегистра(ДанныеОбъекта);
	
	Для Каждого СтрокаИсточник ИЗ ДанныеДляЗаполнения.ТаблицаСчетовИсточник Цикл
		
		Если НЕ СтрокаИсточник.ЕстьНестандартныеОтборы Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		РабочаяТаблицаКорреспонденция=РабочаяТаблицаДопОтборы.Скопировать(Новый Структура("СчетДтИсточникКод,СчетКтИсточникКод",
										СтрокаИсточник.СчетДтИсточникКод,
										СтрокаИсточник.СчетКтИсточникКод));
										
		РабочаяТаблицаКорреспонденция.Сортировать("Приоритет ВОЗР");
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ИсходныйДокумент) Тогда
			
			ЗапросТаблица=ПолучитьЗапросСДвижениямиРегистратора(ДанныеОбъекта,СтрокаИсточник,Ложь);
			
		Иначе
			
			ЕстьПолеРегистратор=(Не РабочаяТаблицаКорреспонденция.Найти(ИСТИНА,"ЕстьОбращениеКРегистратору")=Неопределено);					
			ЗапросТаблица=ПолучитьЗапросСДвижениямиПоКорреспонденции(ДанныеОбъекта,СтрокаИсточник,ЕстьПолеРегистратор,ТранслироватьСодержание);
			
		КонецЕсли;
		 
		ТаблицаПроводок=ЗапросТаблица.Выполнить().Выгрузить();
        ТаблицаПроводок.Колонки.Добавить("НомерПроводки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(9));
		
		НомерПроводки=1;
		
		Для Каждого СтрокаПроводка ИЗ ТаблицаПроводок Цикл
			
			СтрокаПроводка.НомерПроводки=НомерПроводки;
			НомерПроводки=НомерПроводки+1;
			
		КонецЦикла;
		
		ЗапросДвижения=Новый Запрос;
		ЗапросДвижения.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
		ЗапросДвижения.Текст="ВЫБРАТЬ ТаблицаПроводок.* Поместить ПроводкиПоОтбору
		|ИЗ &ТаблицаПроводок КАК ТаблицаПроводок
		|Индексировать ПО НомерПроводки";
		ЗапросДвижения.Параметры.Вставить("ТаблицаПроводок",ТаблицаПроводок);
		ЗапросДвижения.Выполнить();
		
		МассивОбработанных=Новый Массив;
		
		Для Индекс=0 По РабочаяТаблицаКорреспонденция.Количество()-1 Цикл
			
			РабочаяСтрока=РабочаяТаблицаКорреспонденция[Индекс];
			ТекстЗапроса=СтрЗаменить(РабочаяСтрока.СтрЗапрос.ТекстЗапроса,"ВЫБРАТЬ ","ВЫБРАТЬ НомерПроводки КАК НомерПроводки,");
			ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"ГДЕ ","ГДЕ (ПроводкиПоОтбору.НомерПроводки НЕ В(&МассивОбработанных)) И ");
			ТекстЗапроса=ТекстЗапроса+",НомерПроводки";
			
			ЗапросДвижения.УстановитьПараметр("МассивОбработанных",МассивОбработанных);
			ЗапросДвижения.Текст=ТекстЗапроса;
			
			ТаблицаДанных=ПолучитьДанныеПоТаблицеДвижений(ДанныеОбъекта,ЗапросДвижения,РабочаяСтрока.СтрЗапрос);
					
			Для Каждого СтрокаРезультат ИЗ ТаблицаДанных Цикл 
				
				МассивОбработанных.Добавить(СтрокаРезультат.НомерПроводки);
				
				Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
					
					ИсходнаяПроводка=ТаблицаПроводок.НайтиСтроки(Новый Структура("НомерПроводки",СтрокаРезультат.НомерПроводки))[0];
					
					ДанныеИсточника=ПолучитьДанныеИсточника(ДанныеОбъекта,ИсходнаяПроводка,СтрокаИсточник,Неопределено);
					
					ДанныеИсточника.Вставить("ПриоритетДт",РабочаяСтрока.ПриоритетДт);
					ДанныеИсточника.Вставить("ПриоритетКт",РабочаяСтрока.ПриоритетКт);
										
					Если ТаблицаДанных.Колонки.Найти("СчетДтИсточникКод")=Неопределено Тогда
						
						Для Каждого Элемент ИЗ ДанныеИсточника Цикл
							
							ТаблицаДанных.Колонки.Добавить(Элемент.Ключ);
							
						КонецЦикла;
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(СтрокаРезультат,ДанныеИсточника);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЗаписатьТаблицуДанныхВПроводкиДокумента(ДанныеОбъекта,РабочаяСтрока,ТаблицаДанных,ПроводкиДокумента,ДанныеДляЗаполнения);
			
			Если МассивОбработанных.Количество()=ТаблицаПроводок.Количество() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивОбработанных.Количество()<ТаблицаПроводок.Количество() 
			И ДанныеОбъекта.Свойство("ДетальнаяТрансляция")
			И (НЕ ДанныеОбъекта.Свойство("ОтборПриемник")) Тогда
			
			ЕстьНестандартныеОтборыДт=(НЕ РабочаяТаблицаКорреспонденция.Найти(ИСТИНА,"ЕстьНестандартныеОтборыДт")=Неопределено);
			ЕстьНестандартныеОтборыКт=(НЕ РабочаяТаблицаКорреспонденция.Найти(ИСТИНА,"ЕстьНестандартныеОтборыКт")=Неопределено);
			
			ЗапросДвижения.Текст="ВЫБРАТЬ * ИЗ ПроводкиПоОтбору КАК ПроводкиПоОтбору ГДЕ НЕ ПроводкиПоОтбору.НомерПроводки В (&МассивОбработанных)";				
			ЗапросДвижения.УстановитьПараметр("МассивОбработанных",МассивОбработанных);
			
			Результат=ЗапросДвижения.Выполнить().Выбрать();
			
			Если ЗапросДвижения.Параметры.Свойство("МассивИсключаемыхВНА") Тогда
				
				МассивИсключаемыхВНА=ЗапросДвижения.Параметры.МассивИсключаемыхВНА;
				
			Иначе
				
				 МассивИсключаемыхВНА=Неопределено;
				 
			КонецЕсли;
			
			Пока Результат.Следующий() Цикл
				
				ДанныеИсточника=ПолучитьДанныеИсточника(ДанныеОбъекта,Результат,СтрокаИсточник,МассивИсключаемыхВНА); 
				
				НеТранслируетсяПричина=ДанныеИсточника.НеТранслируетсяПричина;
				
				Если ЕстьНестандартныеОтборыДт Тогда
					
					НеТранслируетсяПричина=НеТранслируетсяПричина+",ДополнительныеОтборыДт";
					
				КонецЕсли; 
				
				Если ЕстьНестандартныеОтборыКт Тогда
					
					НеТранслируетсяПричина=НеТранслируетсяПричина+",ДополнительныеОтборыКт";
					
				КонецЕсли; 
				
				ДанныеИсточника.Вставить("НеТранслируетсяПричина",Сред(НеТранслируетсяПричина,2));
						
				СтрокаПроводки=ПроводкиДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПроводки,ДанныеИсточника); 
				СтрокаПроводки.НеТранслируется=Истина;
				
			КонецЦикла;
					
		КонецЕсли;
       		
	КонецЦикла;
		
КонецПроцедуры // ПолучитьДанныеДопОтборы()

Процедура ПолучитьДанныеДопОтборыВнешняяИБ(ДанныеОбъекта,РабочаяТаблицаДопОтборы,ПроводкиДокумента,ДанныеДляЗаполнения)

	Если РабочаяТаблицаДопОтборы.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	БазаВИБ=РабочаяТаблицаДопОтборы[0].СтрЗапрос.База;
	
	ДанныеВИБ=Новый Структура;
	ДанныеВИБ.Вставить("МаксКоличествоСубконто",КэшируемыеПроцедурыУХ.МаксКоличествоСубконто(ДанныеОбъекта.ПланСчетовИсточник));
	ДанныеВИБ.Вставить("ДанныеРегистра",ДанныеОбъекта.ДанныеРегистра);
	ДанныеВИБ.Вставить("ТранслироватьСодержание",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.ШаблонКорректировки,"ТранслироватьСодержаниеПроводок"));
	
	Если ДанныеОбъекта.Свойство("ДетальнаяТрансляция") Тогда
		
		ДанныеВИБ.Вставить("ДетальнаяТрансляция",Истина);
		ДанныеВИБ.Вставить("РесурсыДляОтображения",ДанныеОбъекта.РесурсыДляОтображения);
		
	КонецЕсли;	
	
	МодульИнтеграции=ОбщегоНазначения.ОбщийМодуль("ИнтеграцияСВнешнимиСистемамиУХ");
	
	Для Каждого СтрокаИсточник ИЗ ДанныеДляЗаполнения.ТаблицаСчетовИсточник Цикл
		
		Если НЕ СтрокаИсточник.ЕстьНестандартныеОтборы Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		РабочаяТаблицаКорреспонденция=РабочаяТаблицаДопОтборы.Скопировать(Новый Структура("СчетДтИсточникКод,СчетКтИсточникКод",
										СтрокаИсточник.СчетДтИсточникКод,
										СтрокаИсточник.СчетКтИсточникКод));
										
		РабочаяТаблицаКорреспонденция.Сортировать("Приоритет ВОЗР");
		РабочаяТаблицаКорреспонденция.Колонки.Добавить("ИндексТрансляции");
		
		РабочаяТаблицаВИБ=Новый ТаблицаЗначений;
		РабочаяТаблицаВИБ.Колонки.Добавить("СчетДтПриемникКод");
		РабочаяТаблицаВИБ.Колонки.Добавить("СчетКтПриемникКод");
		РабочаяТаблицаВИБ.Колонки.Добавить("Приоритет",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
		РабочаяТаблицаВИБ.Колонки.Добавить("ДанныеДляЗапроса");
		РабочаяТаблицаВИБ.Колонки.Добавить("ИндексТрансляции");
			
		Для Индекс=0 ПО РабочаяТаблицаКорреспонденция.Количество()-1 Цикл
			
			СтрокаТрансляции=РабочаяТаблицаКорреспонденция[Индекс];
			НоваяСтрока=РабочаяТаблицаВИБ.Добавить();
			НоваяСтрока.СчетДтПриемникКод	= СтрокаТрансляции.СчетДтПриемникКод;
			НоваяСтрока.СчетКтПриемникКод	= СтрокаТрансляции.СчетКтПриемникКод;
			НоваяСтрока.Приоритет			= СтрокаТрансляции.Приоритет;
			НоваяСтрока.ДанныеДляЗапроса	= МодульИнтеграции.ПодготовитьДанныеДляНастройкиЗапроса(СтрокаТрансляции.СтрЗапрос);
			
			СтрокаТрансляции.ИндексТрансляции=Индекс;
			НоваяСтрока.ИндексТрансляции=Индекс;
				
		КонецЦикла;	
					
		ЕстьПолеРегистратор=(Не РабочаяТаблицаКорреспонденция.Найти(ИСТИНА,"ЕстьОбращениеКРегистратору")=Неопределено);					
		ДанныеЗапросаКорреспонденция=ПолучитьДанныеЗапросаСДвижениямиПоКорреспонденции(ДанныеОбъекта,СтрокаИсточник,ЕстьПолеРегистратор,ДанныеВИБ.ТранслироватьСодержание);
		
		ДанныеВИБ.Вставить("РабочаяТаблицаВИБ",				РабочаяТаблицаВИБ);
		ДанныеВИБ.Вставить("ДанныеЗапросаКорреспонденция",	ДанныеЗапросаКорреспонденция);
		ДанныеВИБ.Вставить("СчетДтИсточникКод",				СтрокаИсточник.СчетДтИсточникКод);
		ДанныеВИБ.Вставить("СчетКтИсточникКод",				СтрокаИсточник.СчетКтИсточникКод);
		
		РезультатВИБ=РаботаСОбъектамиМетаданныхВнутреннийУХ.ПолучитьДанныеТрансляцииВИБ(БазаВИБ,ДанныеВИБ);
		
		Для Каждого СтрокаВИБ ИЗ РезультатВИБ Цикл
			
			СтруктураПоиска=Новый Структура;
			СтруктураПоиска.Вставить("СчетДтПриемникКод",	СтрокаВИБ.СчетДтПриемникКод);
			СтруктураПоиска.Вставить("СчетКтПриемникКод",	СтрокаВИБ.СчетКтПриемникКод);
			СтруктураПоиска.Вставить("ИндексТрансляции",	СтрокаВИБ.ИндексТрансляции);
			
			СтрокаТрансляции=РабочаяТаблицаКорреспонденция.НайтиСтроки(СтруктураПоиска)[0];
			
			ТекПравило			= ОбщегоНазначенияУХ.ПолучитьЭлементСтруктурыПоИндексу(СтрокаТрансляции.СтрЗапрос.СтруктураПолей,0).Значение;
			ТаблицаДанных		= РасширениеИнтеграцииУХ.ТрансформироватьВнешниеДанные(ДанныеОбъекта,СтрокаВИБ.ДанныеДляПереноса,ТекПравило);
			
			Если ТаблицаДанных=Ложь Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ЗаписатьТаблицуДанныхВПроводкиДокумента(ДанныеОбъекта,СтрокаТрансляции,ТаблицаДанных,ПроводкиДокумента,ДанныеДляЗаполнения);
			
		КонецЦикла; 		
		
	КонецЦикла;
		
КонецПроцедуры // ПолучитьДанныеДопОтборы()

Процедура ЗаписатьТаблицуДанныхВПроводкиДокумента(ДанныеОбъекта,
			РабочаяСтрока,
			ТаблицаДанных,
			ПроводкиДокумента,
			ДанныеДляЗаполнения)
						
		ЕстьДанныеИсточника=НЕ ТаблицаДанных.Колонки.Найти("ДанныеИсточника")=Неопределено;
		
		Для Каждого СтрокаДанные ИЗ ТаблицаДанных Цикл
			
			НоваяСтрока=ПроводкиДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаДанные); 
			
			Если ЕстьДанныеИсточника Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаДанные.ДанныеИсточника);
				
			КонецЕсли;
									
			НоваяСтрока.СчетДт			=РабочаяСтрока.СчетДтПриемник;
			НоваяСтрока.СчетДтИсточник	=РабочаяСтрока.СчетДтИсточник;
			
			НоваяСтрока.СчетКт			=РабочаяСтрока.СчетКтПриемник;
			НоваяСтрока.СчетКтИсточник	=РабочаяСтрока.СчетКтИсточник;
			
			НоваяСтрока.ПравилоДт		=РабочаяСтрока.ПравилоДт;
			НоваяСтрока.ПравилоКт		=РабочаяСтрока.ПравилоКт;

			Для Каждого СтрРесурс ИЗ ДанныеДляЗаполнения.МассивБалансовые Цикл
								
				Если СтрРесурс.Приемник="СуммаВВалютеУчета" ИЛИ СтрРесурс.Приемник="Сумма" Тогда 
				
					НоваяСтрока.Значение=ПолучитьЗначениеПриемник(СтрокаДанные.Период,
														СтрокаДанные[СтрРесурс.Источник],
														ДанныеОбъекта.ВалютаУчетаИсточник,
														ДанныеОбъекта.ВалютаУчетаПриемник,
														ДанныеДляЗаполнения.КэшТаблицыКурсов,ДанныеДляЗаполнения.ЗапросКурсов);
					
				ИначеЕсли СтрРесурс.Приемник="СуммаВВалютеОтчетности" Тогда
					
					Если ДанныеОбъекта.ВалютаПредставленияИсточник=
						ДанныеОбъекта.ВалютаПредставленияПриемник Тогда
						
						НоваяСтрока.ПредставлениеЗначения=СтрокаДанные[СтрРесурс.Источник];
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если НЕ ДанныеДляЗаполнения.РесурсКоличество=Неопределено Тогда
					
					НоваяСтрока.КоличествоДт=СтрокаДанные[ДанныеДляЗаполнения.РесурсКоличество.Источник+"Дт"];
					НоваяСтрока.КоличествоКт=СтрокаДанные[ДанныеДляЗаполнения.РесурсКоличество.Источник+"Кт"];
					
				КонецЕсли;
				
				Если НЕ ДанныеДляЗаполнения.РесурсВалютнаяСумма=Неопределено Тогда
					
					// Расчет значения в валюте Дт
					
					НоваяСтрока.ЗначениеВалютаДт=СтрокаДанные[ДанныеДляЗаполнения.РесурсВалютнаяСумма.Источник+"Дт"];
					
					Если НоваяСтрока.ЗначениеВалютаДт=0 
						И ЗначениеЗаполнено(НоваяСтрока.ВалютаДт)
						И (СтрРесурс.Источник="Сумма" ИЛИ СтрРесурс.Источник="СуммаВВалютеУчета")
						И НоваяСтрока.СчетДт.Валютный 
						И (НЕ НоваяСтрока.СчетДтИсточник.Валютный) Тогда
						
						НоваяСтрока.ЗначениеВалютаДт=ПолучитьЗначениеПриемник(СтрокаДанные.Период,
														СтрокаДанные[СтрРесурс.Источник],
														ДанныеОбъекта.ВалютаУчетаИсточник,
														НоваяСтрока.ВалютаДт,
														ДанныеДляЗаполнения.КэшТаблицыКурсов,ДанныеДляЗаполнения.ЗапросКурсов);
														
					КонецЕсли;	
					
					// Расчет значения в валюте Кт
		
					НоваяСтрока.ЗначениеВалютаКт=СтрокаДанные[ДанныеДляЗаполнения.РесурсВалютнаяСумма.Источник+"Кт"]; 
					
					Если НоваяСтрока.ЗначениеВалютаКт=0 
						И ЗначениеЗаполнено(НоваяСтрока.ВалютаКт)
						И (СтрРесурс.Источник="Сумма" ИЛИ СтрРесурс.Источник="СуммаВВалютеУчета")
						И НоваяСтрока.СчетКт.Валютный 
						И (НЕ НоваяСтрока.СчетКтИсточник.Валютный) Тогда
						
						НоваяСтрока.ЗначениеВалютаКт=ПолучитьЗначениеПриемник(СтрокаДанные.Период,
														СтрокаДанные[СтрРесурс.Источник],
														ДанныеОбъекта.ВалютаУчетаИсточник,
														НоваяСтрока.ВалютаКт,
														ДанныеДляЗаполнения.КэшТаблицыКурсов,ДанныеДляЗаполнения.ЗапросКурсов);
														
					КонецЕсли;			
													
				КонецЕсли;
					
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ВалютаПредставленияПриемник) И (НЕ ЗначениеЗаполнено(НоваяСтрока.ПредставлениеЗначения)) Тогда
				
				НоваяСтрока.ПредставлениеЗначения=ПолучитьЗначениеПриемник(НоваяСтрока.Период,
														НоваяСтрока.Значение,
														ДанныеОбъекта.ВалютаУчетаПриемник,
														ДанныеОбъекта.ВалютаПредставленияПриемник,
														ДанныеДляЗаполнения.КэшТаблицыКурсов,ДанныеДляЗаполнения.ЗапросКурсов);
														
			КонецЕсли;
				
			
		КонецЦикла;
		
КонецПроцедуры // ЗаписатьТаблицуДанныхВПроводкиДокумента() 

Процедура ПодготовитьТаблицуДляПолученияДанных(ДанныеОбъекта,РабочаяТаблицаТрансляции,ПоРегистратору,ЗапросДвижения)

	МассивИсключаемыхВНА=Неопределено;
	МассивТиповВНА=Справочники.ГруппыВНАМСФО.ПолучитьТипыОбъектовВНА();
	
	Для Каждого Строка ИЗ РабочаяТаблицаТрансляции Цикл
					
		Если ТекущаяИБ(ДанныеОбъекта.ИспользуемаяИБ) Тогда
				
			ЕстьСубконтоВНА=Ложь;		
			МассивВидовСубконтоВНА=Новый Массив;
			
			ДополнитьТекстОтбораИсключаемыхВНА(Строка,ЕстьСубконтоВНА,МассивТиповВНА,МассивВидовСубконтоВНА);
			
			Если ЕстьСубконтоВНА И МассивИсключаемыхВНА=Неопределено Тогда
				
				МассивИсключаемыхВНА=ВстраиваниеУХ.ПолучитьВнаУчитываемыеПараллельно();
				
			КонецЕсли;
			
			Если Строка.ЕстьНестандартныеОтборы ИЛИ (Не ЗапросДвижения=Неопределено) Тогда
				
				ДанныеОбъекта.Вставить("ПоТаблицеДвижений",Истина);
				
			Иначе
				
				ДанныеОбъекта.Вставить("ПоТаблицеДвижений",Ложь);
				
			КонецЕсли;
	
			СтрЗапрос=ПодготовитьЗапросДляТрансляции(ДанныеОбъекта,Строка,ПоРегистратору,ЕстьСубконтоВНА);
			
			Если НЕ ДанныеОбъекта.ПоТаблицеДвижений Тогда
				
				ДобавитьТаблицуОтборомПоРегистратору(ДанныеОбъекта,СтрЗапрос.ПравилаВычисленияПараметров);
								
			КонецЕсли;
			
			Если ЕстьСубконтоВНА Тогда
				
				ДобавитьПараметрыОтбораИсключаемыхВНА(СтрЗапрос.ПравилаВычисленияПараметров,МассивИсключаемыхВНА,МассивВидовСубконтоВНА);
				
			КонецЕсли;		
						
			Строка.СтрЗапрос=СтрЗапрос;
			
		Иначе  
			
			Если Строка.ЕстьНестандартныеОтборы Тогда
				
				ДанныеОбъекта.Вставить("ПоТаблицеДвижений",Истина);
				
			Иначе
				
				ДанныеОбъекта.Вставить("ПоТаблицеДвижений",Ложь);
				
			КонецЕсли;
			
			СтрЗапрос=ПодготовитьЗапросДляТрансляции(ДанныеОбъекта,Строка,ПоРегистратору);

			СтруктураЗапроса 	= РасширениеИнтеграцииУХ.ПодготовитьСтруктуруЗапроса(ДанныеОбъекта,СтрЗапрос,Истина);
			
			Строка.СтрЗапрос=СтруктураЗапроса;
						
		КонецЕсли; 

	КонецЦикла;	
		
КонецПроцедуры // ПодготовитьТаблицуДляПолученияДанных()

Функция ПреобразоватьТаблицуПроводок(ПроводкиДокумента,КоррСчет,МаксКоличествоСубконто)
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	|	ТрансляцияПроводки.СчетДт КАК СчетДт,
	|	ТрансляцияПроводки.Значение КАК Значение,
	|	ТрансляцияПроводки.ПредставлениеЗначения КАК ПредставлениеЗначения,
	|	ТрансляцияПроводки.СчетКт КАК СчетКт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|ТрансляцияПроводки.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|ТрансляцияПроводки.СубконтоКт"+Индекс+" КАК СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	ТрансляцияПроводки.ШаблонПроводки КАК ШаблонПроводки,
	|	ТрансляцияПроводки.РесурсРегистра КАК РесурсРегистра,
	|	ТрансляцияПроводки.ВалютаДт КАК ВалютаДт,
	|	ТрансляцияПроводки.ВалютаКт КАК ВалютаКт,
	|	ТрансляцияПроводки.ЗначениеВалютаДт КАК ЗначениеВалютаДт,
	|	ТрансляцияПроводки.ЗначениеВалютаКт КАК ЗначениеВалютаКт,
	|	ТрансляцияПроводки.ДатаПроводки КАК ДатаПроводки,
	|	ТрансляцияПроводки.СчетДтИсточник КАК СчетДтИсточник,
	|	ТрансляцияПроводки.СчетКтИсточник КАК СчетКтИсточник,
	|	ТрансляцияПроводки.ПравилоДт КАК ПравилоДт,
	|	ТрансляцияПроводки.ПравилоКт КАК ПравилоКт,
	|	ТрансляцияПроводки.КоличествоДт КАК КоличествоДт,
	|	ТрансляцияПроводки.КоличествоКт КАК КоличествоКт,
	|	ТрансляцияПроводки.Период КАК Период,
	|	ТрансляцияПроводки.Содержание КАК Содержание,
	|	ТрансляцияПроводки.ВидОперации КАК ВидОперации,
	|	ТрансляцияПроводки.ПодразделениеДт КАК ПодразделениеДт,
	|	ТрансляцияПроводки.ПодразделениеКт КАК ПодразделениеКт,
	|	ТрансляцияПроводки.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	ТрансляцияПроводки.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт
	|ПОМЕСТИТЬ ИсходныеПроводки
	|ИЗ
	|	&ПроводкиДокумента КАК ТрансляцияПроводки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсходныеПроводкиДт.СчетДт КАК СчетДт,
	|	ИсходныеПроводкиДт.Значение КАК Значение,
	|	ИсходныеПроводкиДт.ПредставлениеЗначения КАК ПредставлениеЗначения,
	|	&КоррСчет КАК СчетКт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|ИсходныеПроводкиДт.СубконтоДт"+Индекс+" КАК СубконтоДт"+Индекс+",
		|НЕОПРЕДЕЛЕНО КАК СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	ИсходныеПроводкиДт.ШаблонПроводки КАК ШаблонПроводки,
	|	ИсходныеПроводкиДт.РесурсРегистра КАК РесурсРегистра,
	|	ИсходныеПроводкиДт.ВалютаДт КАК ВалютаДт,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКт,
	|	ИсходныеПроводкиДт.ЗначениеВалютаДт КАК ЗначениеВалютаДт,
	|	0 КАК ЗначениеВалютаКт,
	|	ИсходныеПроводкиДт.ДатаПроводки КАК ДатаПроводки,
	|	ИсходныеПроводкиДт.СчетДтИсточник КАК СчетДтИсточник,
	|	ИсходныеПроводкиДт.СчетКтИсточник КАК СчетКтИсточник,
	|	ИсходныеПроводкиДт.ПравилоДт КАК ПравилоДт,
	|	ИсходныеПроводкиДт.ПравилоКт КАК ПравилоКт,
	|	ИсходныеПроводкиДт.КоличествоДт КАК КоличествоДт,
	|	0 КАК КоличествоКт,
	|	ИсходныеПроводкиДт.Период КАК Период,
	|	ИсходныеПроводкиДт.Содержание КАК Содержание,
	|	ИсходныеПроводкиДт.ВидОперации КАК ВидОперации,
	|	ИсходныеПроводкиДт.ПодразделениеДт КАК ПодразделениеДт,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеКт,
	|	ИсходныеПроводкиДт.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельностиКт
	|ИЗ
	|	ИсходныеПроводки КАК ИсходныеПроводкиДт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&КоррСчет,
	|	ИсходныеПроводкиКт.Значение,
	|	ИсходныеПроводкиКт.ПредставлениеЗначения,
	|	ИсходныеПроводкиКт.СчетКт,";
	
	Для Индекс=1 По МаксКоличествоСубконто Цикл
		
		ТекстЗапроса=ТекстЗапроса+"
		|НЕОПРЕДЕЛЕНО,
		|ИсходныеПроводкиКт.СубконтоКт"+Индекс+",";
		
	КонецЦикла;
	
	ТекстЗапроса=ТекстЗапроса+"
	|	ИсходныеПроводкиКт.ШаблонПроводки,
	|	ИсходныеПроводкиКт.РесурсРегистра,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	ИсходныеПроводкиКт.ВалютаКт,
	|	0,
	|	ИсходныеПроводкиКт.ЗначениеВалютаКт,
	|	ИсходныеПроводкиКт.ДатаПроводки,
	|	ИсходныеПроводкиКт.СчетДтИсточник,
	|	ИсходныеПроводкиКт.СчетКтИсточник,
	|	ИсходныеПроводкиКт.ПравилоДт,
	|	ИсходныеПроводкиКт.ПравилоКт,
	|	0,
	|	ИсходныеПроводкиКт.КоличествоКт,
	|	ИсходныеПроводкиКт.Период,
	|	ИсходныеПроводкиКт.Содержание,
	|	ИсходныеПроводкиКт.ВидОперации,
	|	НЕОПРЕДЕЛЕНО,
	|	ИсходныеПроводкиКт.ПодразделениеКт,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка),
	|	ИсходныеПроводкиКт.НаправлениеДеятельностиКт
	|ИЗ
	|	ИсходныеПроводки КАК ИсходныеПроводкиКт";
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ПроводкиДокумента",ПроводкиДокумента);
	Запрос.УстановитьПараметр("КоррСчет",КоррСчет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПреобразоватьТаблицуПроводок() 

Функция ПолучитьЗначениеПриемник(Период,
								ЗначениеИсточник,
								ВалютаИсточник,
								ВалютаПриемник,
								КэшТаблицыКурсов,ЗапросКурсов) Экспорт
								
	Если ЗначениеИсточник=0 ИЛИ ВалютаИсточник=ВалютаПриемник Тогда
									
		Возврат ЗначениеИсточник;
		
	КонецЕсли;
	
	ДанныеИсточник=ПолучитьДанныеКурса(ВалютаИсточник,Период,КэшТаблицыКурсов,ЗапросКурсов);
	ДанныеПриемник=ПолучитьДанныеКурса(ВалютаПриемник,Период,КэшТаблицыКурсов,ЗапросКурсов);
	
	Если ДанныеИсточник.Курс=0 ИЛИ ДанныеПриемник.Курс=0 Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Возврат Окр(ЗначениеИсточник*(ДанныеИсточник.Курс*ДанныеПриемник.Кратность)/(ДанныеПриемник.Курс*ДанныеИсточник.Кратность),2); 
																						
КонецФункции // ПолучитьЗначениеПриемник() 

Функция ПолучитьДанныеКурса(Валюта,Период,КэшТаблицыКурсов,ЗапросКурсов)

	ДанныеКурса=КэшТаблицыКурсов.НайтиСтроки(Новый Структура("Валюта,Период",Валюта,Период));
	
	Если ДанныеКурса.Количество()>0 Тогда
		
		Возврат Новый Структура("Курс,Кратность",ДанныеКурса[0].Курс,ДанныеКурса[0].Кратность);
		
	Иначе
		
		ЗапросКурсов.УстановитьПараметр("Период", Период);
		ЗапросКурсов.УстановитьПараметр("Валюта", Валюта);
		
		ТаблицаКурсов=ЗапросКурсов.Выполнить().Выгрузить();
		
		Если ТаблицаКурсов.Количество()>0 Тогда
			
			НоваяСтрока=КэшТаблицыКурсов.Добавить();
			НоваяСтрока.Валюта=Валюта;
			НоваяСтрока.Период=Период;
			НоваяСтрока.Курс=ТаблицаКурсов[0].Курс;
			НоваяСтрока.Кратность=ТаблицаКурсов[0].Кратность;
			
		Иначе
			
			ТекстОшибки=СтрШаблон(Нстр("ru = 'Не установлен курс для валюты %1 на период %2'"),Валюта,Период);
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки,,,СтатусСообщения.Важное);
			
			НоваяСтрока=КэшТаблицыКурсов.Добавить();
			НоваяСтрока.Валюта=Валюта;
			НоваяСтрока.Период=Период;
			НоваяСтрока.Курс=0;
			НоваяСтрока.Кратность=0;
			
		КонецЕсли;
		
		Возврат Новый Структура("Курс,Кратность",НоваяСтрока.Курс,НоваяСтрока.Кратность);
		
	КонецЕсли;	
		
КонецФункции // ПолучитьДанныеКурса() 

Функция ЕстьТипВНА(ВидСубконтоСсылка,МассивТиповВНА)
	
	Для Каждого Тип ИЗ ВидСубконтоСсылка.ТипЗначения.Типы() Цикл
		
		Если НЕ МассивТиповВНА.Найти(Тип)=Неопределено Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
		
КонецФункции // ЕстьТипВНА() 

Процедура ДополнитьТекстОтбораИсключаемыхВНА(СтрокаТрансляции,ЕстьСубконто,МассивТиповВНА,МассивВидовСубконтоВНА) Экспорт
	
	ДополнениеОтбораДт="";
	ДополнениеОтбораКт="";
	
	Для Каждого Строка ИЗ СтрокаТрансляции.СчетДтИсточник.ВидыСубконто Цикл
		
		Если ЕстьТипВНА(Строка.ВидСубконтоСсылка,МассивТиповВНА) Тогда
			
			Если МассивВидовСубконтоВНА.Найти(Строка.ВидСубконтоСсылка)=Неопределено Тогда
				
				МассивВидовСубконтоВНА.Добавить(Строка.ВидСубконтоСсылка);
				
			КонецЕсли;
				
			ДополнениеОтбораДт=ДополнениеОтбораДт+" И НЕ (ВидСубконтоДт"+Строка.Номер+" В(&МассивВидовСубконтоВНА) И СубконтоДт"+Строка.Номер+" В(&МассивИсключаемыхВНА))";
			ЕстьСубконто=Истина;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого Строка ИЗ СтрокаТрансляции.СчетКтИсточник.ВидыСубконто Цикл
		
		Если ЕстьТипВНА(Строка.ВидСубконтоСсылка,МассивТиповВНА) Тогда
			
			Если МассивВидовСубконтоВНА.Найти(Строка.ВидСубконтоСсылка)=Неопределено Тогда
				
				МассивВидовСубконтоВНА.Добавить(Строка.ВидСубконтоСсылка);
				
			КонецЕсли;
			
			ДополнениеОтбораКт=ДополнениеОтбораКт+" И НЕ (ВидСубконтоКт"+Строка.Номер+" В(&МассивВидовСубконтоВНА) И СубконтоКт"+Строка.Номер+" В(&МассивИсключаемыхВНА))";
			ЕстьСубконто=Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ДополнениеОтбораДт) Тогда
			
		Если НЕ ПустаяСтрока(СтрокаТрансляции.ТекстОтбораДт) Тогда
			
			СтрокаТрансляции.ТекстОтбораДт=СтрокаТрансляции.ТекстОтбораДт+" И "+Сред(ДополнениеОтбораДт,СтрДлина("И")+2);
			
		Иначе
			
			СтрокаТрансляции.ТекстОтбораДт=Сред(ДополнениеОтбораДт,СтрДлина("И")+2);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ДополнениеОтбораКт) Тогда
		
		Если НЕ ПустаяСтрока(СтрокаТрансляции.ТекстОтбораКт) Тогда
			
			СтрокаТрансляции.ТекстОтбораКт=СтрокаТрансляции.ТекстОтбораКт+" И "+Сред(ДополнениеОтбораКт,СтрДлина("И")+2);
			
		Иначе
			
			СтрокаТрансляции.ТекстОтбораКт=Сред(ДополнениеОтбораКт,СтрДлина("И")+2);
			
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры // ДополнитьТекстОтбораИсключаемыхВНА() 

Процедура ДобавитьПараметрыОтбораИсключаемыхВНА(ПравилаВычисленияПараметров,МассивИсключаемыхВНА,МассивВидовСубконтоВНА) Экспорт
	
	НоваяСтрока=ПравилаВычисленияПараметров.Добавить();
	НоваяСтрока.ИмяПараметра=		"МассивИсключаемыхВНА";
	НоваяСтрока.НаименованиеБД=		"МассивИсключаемыхВНА";
	НоваяСтрока.ПолеБД=				"МассивИсключаемыхВНА";
	НоваяСтрока.ТипРасчета=			"Простой";
	НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
	
	СписокВНА=Новый СписокЗначений;
	СписокВНА.ЗагрузитьЗначения(МассивИсключаемыхВНА);
	
	НоваяСтрока.УточнениеСпособаОпределения=СписокВНА;
	
	НоваяСтрока=ПравилаВычисленияПараметров.Добавить();
	НоваяСтрока.ИмяПараметра=		"МассивВидовСубконтоВНА";
	НоваяСтрока.НаименованиеБД=		"МассивВидовСубконтоВНА";
	НоваяСтрока.ПолеБД=				"МассивВидовСубконтоВНА";
	НоваяСтрока.ТипРасчета=			"Простой";
	НоваяСтрока.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
	
	СписокТиповВНА=Новый СписокЗначений;
	СписокТиповВНА.ЗагрузитьЗначения(МассивВидовСубконтоВНА);
	
	НоваяСтрока.УточнениеСпособаОпределения=СписокТиповВНА;
	
КонецПроцедуры // ДобавитьПараметрыОтбораИсключаемыхВНА()

Процедура ПротоколироватьИсключенияТрансляции(ПричинаИсключения,ТаблицаИсключений)
	
	Если ТаблицаИсключений.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого Строка ИЗ ТаблицаИсключений Цикл
		
		ТекстСообщения=Строка.Счет+" - "+Строка.КоррСчет;
		
		Для Индекс=1 По 3 Цикл
			
			Если (НЕ ТаблицаИсключений.Колонки.Найти("СубконтоДт"+Индекс)=Неопределено) И ЗначениеЗаполнено(Строка["СубконтоДт"+Индекс]) Тогда
				
				ТекстСообщения=ТекстСообщения+", СубконтоДт"+Индекс+": "+Строка["СубконтоДт"+Индекс];
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Индекс=1 По 3 Цикл
			
			Если (НЕ ТаблицаИсключений.Колонки.Найти("СубконтоКт"+Индекс)=Неопределено) И ЗначениеЗаполнено(Строка["СубконтоКт"+Индекс]) Тогда
				
				ТекстСообщения=ТекстСообщения+", СубконтоКт"+Индекс+": "+Строка["СубконтоКт"+Индекс];
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТекстПредупреждения=ПричинаИсключения+Символы.ПС+ТекстСообщения;
		
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьПредупреждение("КорректировкиЗначенийПоказателей.ВыполнитьТрансляциюПроводок.2",,,ТекстПредупреждения);
		
	КонецЦикла;	
	
КонецПроцедуры // ПротоколироватьИсключенияТрансляции()

Функция ПолучитьТаблицуБезИсключаемыхВНА(ТаблицаДанных,МассивИсключаемыхВНА)
	
	ТекстОтбор="";
	СтруктураДанных=Новый Структура;
	
	Для Каждого Колонка ИЗ ТаблицаДанных.Колонки Цикл
		
		Если СтрНачинаетсяС(Колонка.Имя,"СубконтоДт") ИЛИ СтрНачинаетсяС(Колонка.Имя,"СубконтоКт") Тогда
			
			ТекстОтбор=ТекстОтбор+" ИЛИ ТаблицаДанных."+Колонка.Имя+" В(&МассивИсключаемыхВНА)";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстОтбор) Тогда
		
		СтруктураДанных.Вставить("ТаблицаДанных",ТаблицаДанных);
		Возврат СтруктураДанных;
		
	КонецЕсли;
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ * Поместить ТаблицаДанных ИЗ &ТаблицаДанных КАК ТаблицаДанных
	|;
	|ВЫБРАТЬ * ИЗ ТаблицаДанных
	|ГДЕ НЕ ("+Сред(ТекстОтбор,СтрДлина("ИЛИ")+2)+")
	|;
	|ВЫБРАТЬ * ИЗ ТаблицаДанных
	|ГДЕ ("+Сред(ТекстОтбор,СтрДлина("ИЛИ")+2)+")";
	
	Запрос.УстановитьПараметр("ТаблицаДанных",			ТаблицаДанных);
	Запрос.УстановитьПараметр("МассивИсключаемыхВНА",	МассивИсключаемыхВНА);
	
	Результат=Запрос.ВыполнитьПакет();
	
	СтруктураДанных=Новый Структура;
	СтруктураДанных.Вставить("ТаблицаДанных",Результат[1].Выгрузить());
	СтруктураДанных.Вставить("ТаблицаИсключений",Результат[2].Выгрузить());
		
	Возврат СтруктураДанных;
	
КонецФункции // ПолучитьТаблицуБезИсключаемыхВНА()

Функция ОбъединитьТаблицыЗначений(Таблица1,Таблица2)
	
	ШаблонПоиска=Новый Структура;
	
	Для Каждого Колонка ИЗ Таблица1.Колонки Цикл
		
		ШаблонПоиска.Вставить(Колонка.Имя);
		
	КонецЦикла;	
	
	Для Каждого Строка ИЗ Таблица2 Цикл
		
		СтруктураПоиска=ОбщегоНазначенияУХ.СкопироватьУниверсальнуюКоллекцию(ШаблонПоиска);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,Строка);
		
		Если Таблица1.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
			
			НоваяСтрока=Таблица1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураПоиска);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Таблица1;
			
КонецФункции // ОбъединитьТаблицыЗначений()

Функция ПолучитьНовыйПуть(ИсходноеПолеНов,МассивПутей,Разделитель=".")
	
	МассивПутей.Установить(0,ИсходноеПолеНов);	
	Возврат СтрСоединить(МассивПутей,Разделитель);	
	
КонецФункции // ПолучитьНовыйПуть() 

Процедура ОбработатьОтбор(ДанныеОбъекта,ТаблицаПараметровОтбораБД,УточненияСпособовОпределения,ТекстОтбора,Постфикс)
	
	Для Каждого СтрПоле ИЗ ТаблицаПараметровОтбораБД Цикл
		
		ПолныйПутьСтар=СтрПоле.ПолеБД;
		
		МассивПутей=ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(СтрПоле.ПолеБД,".");
		
		ИсходноеПолеСтар=МассивПутей[0];
		ИсходноеПолеНов=ИсходноеПолеСтар;
		
		Если Лев(ИсходноеПолеСтар,СтрДлина("Субконто"))="Субконто" И (НЕ (Лев(ИсходноеПолеСтар,СтрДлина("СубконтоКт"))="СубконтоКт" ИЛИ Лев(ИсходноеПолеСтар,СтрДлина("СубконтоДт"))="СубконтоДт")) Тогда 
			
			ИсходноеПолеНов=СтрЗаменить(ИсходноеПолеСтар,"Субконто","Субконто"+Постфикс);
			
		ИначеЕсли СтрНайти(ИсходноеПолеСтар,"Дт")=0 И СтрНайти(ИсходноеПолеСтар,"Кт")=0 Тогда 
			
			СтрИзмерение=ДанныеОбъекта.РегистрБухгалтерииИсточник.Измерения.Найти(ИсходноеПолеСтар,"Имя");
			
			Если НЕ (СтрИзмерение=Неопределено 
				ИЛИ СтрИзмерение.Балансовый) Тогда
				
				ИсходноеПолеНов=ИсходноеПолеСтар+Постфикс;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если НЕ ИсходноеПолеНов=ИсходноеПолеСтар Тогда
			
			СтрПоле.ПолеБД=ПолучитьНовыйПуть(ИсходноеПолеНов,МассивПутей);
			
			ТекстОтбора=СтрЗаменить(ТекстОтбора,ПолныйПутьСтар,СтрПоле.ПолеБД);
			
			МассивУточнений=УточненияСпособовОпределения.НайтиСтроки(Новый Структура("ИмяПараметра",СтрПоле.ИмяПараметра));
			
			Для Каждого Строка ИЗ МассивУточнений Цикл
				
				Строка.ПолеБД=СтрПоле.ПолеБД;
				
			КонецЦикла;
			
		КонецЕсли;
					
	КонецЦикла;
	
КонецПроцедуры // ОбработатьОтбор()

Процедура ОбработатьПоля(ДанныеОбъекта,ПравилаИспользованияПолейЗапроса,ТаблицаИзмерений,Постфикс,ТаблицаСубконто)
	
	Для Каждого СтрПоле ИЗ ПравилаИспользованияПолейЗапроса Цикл
		
		ПолныйПутьСтар=СтрПоле.Поле;
		
		Разделитель=?(СтрНайти(СтрПоле.Поле,"@")>0,"@",".");
		
		МассивПутей=ОбщегоНазначенияУХ.РазложитьСтрокуВМассивПодстрок(СтрПоле.Поле,Разделитель);
		
		ИсходноеПолеСтар=МассивПутей[0];
		ИсходноеПолеНов=ИсходноеПолеСтар;
		
		Если Лев(ИсходноеПолеСтар,СтрДлина("Субконто"))="Субконто" И (НЕ (Лев(ИсходноеПолеСтар,СтрДлина("СубконтоКт"))="СубконтоКт" ИЛИ Лев(ИсходноеПолеСтар,СтрДлина("СубконтоДт"))="СубконтоДт")) Тогда 
			
			ИсходноеПолеНов=СтрЗаменить(ИсходноеПолеСтар,"Субконто","Субконто"+Постфикс);
			
		ИначеЕсли СтрНайти(ИсходноеПолеСтар,"Дт")=0 И СтрНайти(ИсходноеПолеСтар,"Кт")=0 Тогда 
			
			СтрИзмерение=ДанныеОбъекта.РегистрБухгалтерииИсточник.Измерения.Найти(ИсходноеПолеСтар,"Имя");
			
			Если НЕ (СтрИзмерение=Неопределено 
				ИЛИ СтрИзмерение.Балансовый) Тогда
				
				ИсходноеПолеНов=ИсходноеПолеСтар+Постфикс;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрНайти(ИсходноеПолеНов,"Субконто")>0 Тогда
			
			ИсходноеПолеНов=ПолучитьТекстПриведенияТипа(ИсходноеПолеНов,ТаблицаСубконто);
			
		КонецЕсли;		
				
		Если СтрПоле.КодАналитики="АналитикаВалюта" Тогда
			
			СтрПоле.КодАналитики="Валюта"+Постфикс;
			СтрПоле.Синоним		="Валюта"+Постфикс;
			
		ИначеЕсли СтрНайти(СтрПоле.КодАналитики,"Аналитика")>0 Тогда
			
			СтрПоле.КодАналитики=СтрЗаменить(СтрПоле.КодАналитики,"Аналитика","Субконто"+Постфикс);
			СтрПоле.Синоним=СтрПоле.КодАналитики;
			
		ИначеЕсли НЕ ТаблицаИзмерений.Найти(СтрПоле.КодАналитики+Постфикс,"Имя")=Неопределено Тогда
			
			СтрПоле.КодАналитики=СтрПоле.КодАналитики+Постфикс;
			СтрПоле.Синоним=СтрПоле.КодАналитики;			
	
		КонецЕсли;	
		
		Если НЕ ИсходноеПолеНов=ИсходноеПолеСтар Тогда
			
			СтрПоле.Поле=ПолучитьНовыйПуть(ИсходноеПолеНов,МассивПутей,Разделитель);
						
		КонецЕсли;
					
	КонецЦикла;
	
КонецПроцедуры // ОбработатьПоля() 

Функция ПолучитьТекстПриведенияТипа(ПолеСубконто,ТаблицаСубконто)

	СтрокаТип=ТаблицаСубконто.Найти(ПолеСубконто,"Имя");
	
	Если СтрокаТип=Неопределено ИЛИ ПустаяСтрока(СтрокаТип.ТипДанных) Тогда
		
		Возврат ПолеСубконто;
		
	КонецЕсли;		
			
	МассивТипов=СтрРазделить(СтрокаТип.ТипДанных,";");
	
	Если МассивТипов.Количество()=1 Тогда
		
		Возврат "(ВЫРАЗИТЬ("+ПолеСубконто+" КАК "+МассивТипов[0]+"))";
		
	Иначе
		
		Возврат ПолеСубконто;
		
	КонецЕсли;
						
КонецФункции // ПолучитьТекстПриведенияТипа() 

Функция ПодготовитьЗапросДляТрансляции(ДанныеОбъекта,СтрокаТрансляции,ПоРегистратору=Ложь,ЕстьСубконтоВНА=Ложь) Экспорт	
	
