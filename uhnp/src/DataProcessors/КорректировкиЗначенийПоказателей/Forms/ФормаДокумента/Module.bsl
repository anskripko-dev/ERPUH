&НаКлиенте
Процедура ПроводкиОперацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Элементы.ПроводкиОперации.ТекущиеДанные.НомерСтроки=0
		ИЛИ Копирование Тогда
		
		Элементы.ПроводкиОперации.ТекущиеДанные.НомерСтроки=ПроводкиОперации.Количество();
		
	КонецЕсли; 
	
	Элементы.ПроводкиОперации.ТекущиеДанные.Период=Объект.ДатаОтраженияВУчете; 
	
КонецПроцедуры   

&НаКлиенте
Процедура ЗагрузитьТаблицей(Команда)
	
	ДопПараметры = Новый Структура("ИмяОбъекта, ИмяТЧ, ИсточникКолонок", 
		"Обработка.КорректировкиЗначенийПоказателей", "Проводки", "ТЧ");
	
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДопПараметры);
	ПараметрыВыполненияКоманды = Новый Структура("ОписаниеКоманды, Форма", ОписаниеКоманды, ЭтотОбъект);
	
	МСФОКлиентУХ.ЗагрузкаДанных_Подключаемый(Объект.Ссылка, ПараметрыВыполненияКоманды);
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_ЗаполнитьДокумент(РезультатВопроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если (РезультатВопроса <> Неопределено) И (РезультатВопроса <> КодВозвратаДиалога.Да) Тогда
		Возврат;	
	КонецЕсли;
    
    ЗаполнитьДокументПоТаблице(ДанныеЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоТаблице(ДанныеЗаполнения)

	МСФОВызовСервераУХ.ЗаполнитьПоТаблицеЗагрузки(Объект, ДанныеЗаполнения);
	
	ПроводкиОперации.Очистить();
	
	Для Каждого Строка ИЗ Объект.Проводки Цикл
		
		НоваяСтрока=ПроводкиОперации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.Значение=Строка.СуммаВВалютеУчета;
		НоваяСтрока.ПредставлениеЗначения=Строка.СуммаВВалютеОтчетности;
		НоваяСтрока.ЗначениеВалютаДт=Строка.СуммаВВалютеДт;
		НоваяСтрока.ЗначениеВалютаКт=Строка.СуммаВВалютеКт;
		
	КонецЦикла;
	
	Элементы.ПроводкиОперации.ТекущаяСтрока=Неопределено;
	МСФОУХ.ДобавитьРеквизитыТаблицыПроводок(ЭтотОбъект, "ПроводкиОперации", "ПроводкиОперации",Истина,,,Ложь);

	ОтредактированыЗаписи=Истина;			
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура СложныеПроводкиПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.СложныеПроводки.ТекущиеДанные;
	ИдСтроки      = Элементы.СложныеПроводки.ТекущаяСтрока;
	
	Если ИдСтроки <> ИдентификаторСтрокиПроводки Тогда
	
		ОбработатьИзменениеСчетаБезКорр(ЭтотОбъект);
		
		ИдентификаторСтрокиПроводки = ИдСтроки;
	
	КонецЕсли;
	
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммуОперации(Форма)
	
	Объект = Форма.Объект;
	
	Если Форма.КэшируемыеЗначения.БезКорреспонденции Тогда
		
		Форма.ИтогДт = Форма.СложныеПроводки.Итог("ЗначениеДт");
		Форма.ИтогКт = Форма.СложныеПроводки.Итог("ЗначениеКт");
		
		Объект.СуммаОперации = Форма.ИтогДт - Форма.ИтогКт;
		Форма.КоличествоСтрокБезКор = Форма.СложныеПроводки.Количество();
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура СложныеПроводкиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ПересчитатьСуммуОперации(ЭтотОбъект);
	
КонецПроцедуры


&НаКлиенте
Процедура СложныеПроводкиПослеУдаления(Элемент)
	
	ПересчитатьСуммуОперации(ЭтотОбъект);
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзменениеСчетаБезКорр(Форма)

	ИдСтроки = Форма.Элементы.СложныеПроводки.ТекущаяСтрока;
	Если ИдСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Форма.СложныеПроводки.НайтиПоИдентификатору(ИдСтроки);
	
	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3");
	ПоляФормы.Субконто1 = "СложныеПроводкиСубконто1";
	ПоляФормы.Субконто2 = "СложныеПроводкиСубконто2";
	ПоляФормы.Субконто3 = "СложныеПроводкиСубконто3";
	МСФОКлиентСерверУХ.ПриВыбореСчета(СтрокаТаблицы["Счет"], Форма, ПоляФормы, Неопределено, Истина, Ложь);
	
	ПоляОбъекта = Новый Структура("Субконто1,Субконто2,Субконто3,Валютный,Количественный,Организация,Подразделение,НаправлениеДеятельности");
	ПоляОбъекта.Субконто1      			= "Субконто1";
	ПоляОбъекта.Субконто2      			= "Субконто2";
	ПоляОбъекта.Субконто3      			= "Субконто3";
	ПоляОбъекта.Валютный       			= "Валютный";
	ПоляОбъекта.Количественный 			= "Количественный";
	ПоляОбъекта.Подразделение  			= "УчетПоПодразделениям";
	ПоляОбъекта.НаправлениеДеятельности = "УчетПоНаправлениямДеятельности";
	ПоляОбъекта.Организация    			= Форма.Объект.Организация;
	МСФОКлиентСерверУХ.ПриИзмененииСчета(СтрокаТаблицы["Счет"], СтрокаТаблицы, ПоляОбъекта, Истина, , Ложь);
	
	//**ПересчитатьСуммыПроводки(Форма, СтрокаТаблицы, ДтКт);
	
	ИзменитьПараметрыВыбораПолейСубконтоБезКорр(Форма);
	
	МСФОКлиентСерверУХ.ЗаполнитьНадписиВПроводке(СтрокаТаблицы, Ложь, "");
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьПараметрыВыбораПолейСубконтоБезКорр(Форма)
	
	ИдСтроки = Форма.Элементы.СложныеПроводки.ТекущаяСтрока;
	Если ИдСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Форма.СложныеПроводки.НайтиПоИдентификатору(ИдСтроки);
	
	ПараметрыДокумента = МСФОКлиентСерверУХ.ПолучитьСписокПараметров(Форма, СтрокаТаблицы, "Субконто%Индекс%", "Счет");
	МСФОКлиентСерверУХ.ИзменитьПараметрыВыбораПолейСубконто(
		Форма, СтрокаТаблицы, "Субконто%Индекс%", "СложныеПроводкиСубконто%Индекс%", ПараметрыДокумента);
		
	Валюта = МСФОКлиентСерверУХ.ЗаполнитьВалютуОперацииМСФОПоСубконтоДоговор(СтрокаТаблицы.Валюта, ПараметрыДокумента);
	Если ЗначениеЗаполнено(Валюта) Тогда
		СтрокаТаблицы.Валюта = Валюта;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СложныеПроводкиСчетПриИзменении(Элемент)
	
	ОбработатьИзменениеСчетаБезКорр(ЭтотОбъект);
	
КонецПроцедуры  

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетСуммыБезКорр(Форма, ЭлементИсточник,ТекущаяСтрока)

	Если ТекущаяСтрока=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДтКт = ?(СтрЗаканчиваетсяНа(ЭлементИсточник.Имя, "Дт"), "Дт", "Кт");
	
	Код = "ФВ";
	Если СтрНачинаетсяС(ЭлементИсточник.Имя, "СложныеПроводкиСуммаВВалютеОтчетности") Тогда
		Код = "ВО";
	ИначеЕсли Не СтрНачинаетсяС(ЭлементИсточник.Имя, "СложныеПроводкиСуммаВВалютеУчета") Тогда 
		Код = "ВД";
	КонецЕсли;
	
	ПараметрыПересчета = МСФОКлиентСерверУХ.ПараметрыПересчета(
			"Значение" + ДтКт, 
			"ПредставлениеЗначения" + ДтКт,
			"ЗначениеВалюта" + ДтКт,
			"Период",
			"Валюта",
			Неопределено);
	
	МСФОКлиентСерверУХ.ПересчитатьПроводкуПоСумме(
		Форма, ТекущаяСтрока, Код, ПараметрыПересчета);
		
	ПересчитатьСуммуОперации(Форма);

КонецПроцедуры


