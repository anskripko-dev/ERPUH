		Иначе
			
			СтрокиПриемник=ТаблицаСчетовПриемник.НайтиСтроки(Новый Структура(?(ИнвертироватьТаблицы,"СчетПриемник","СчетИсточник"),Элементы.ТаблицаСчетовИсточник.ТекущиеДанные.СчетИсточник));
			
