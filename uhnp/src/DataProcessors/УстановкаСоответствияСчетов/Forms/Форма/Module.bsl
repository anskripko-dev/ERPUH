Процедура ТаблицаСчетовИсточникВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя="СчетИсточникНаименование" И ЗначениеЗаполнено(Элементы.ТаблицаСчетовИсточник.ТекущиеДанные.ИсточникШаблон) Тогда
		
		ПоказатьЗначение(,Элементы.ТаблицаСчетовИсточник.ТекущиеДанные.ИсточникШаблон);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьОтборыСоответствия(СоответствиеСчетов) 
							
	ИсточникДанных=ПолучитьИсточникПоСторонеПроводки(НаправлениеТрансляции,СоответствиеСчетов,"Дебет");
	
	Если ИсточникДанных=Неопределено Тогда 
		
		ЗаписатьТекущиеНастройкиТрансляции();
		ИсточникДанных=ПолучитьИсточникПоСторонеПроводки(НаправлениеТрансляции,СоответствиеСчетов,"Дебет");
		
		Если ИсточникДанных=Неопределено Тогда			
			
			Возврат НСтр("ru = 'Не удалось записать настройки трансляции'");				
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	ИсточникиДанныхДляРасчетов.Ссылка = &Ссылка
	|	И ИсточникиДанныхДляРасчетов.ЕстьНестандартныеОтборы";
	
	Запрос.УстановитьПараметр("Ссылка",ИсточникДанных);
	Результат=Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Возврат НСтр("ru = 'Настройка по умолчанию не должна иметь дополнительных отборов'"); 
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;	
	
КонецФункции // ПроверитьОтборыСоответствия() 

&НаКлиенте
Процедура ТаблицаСчетовПриемникПередНачаломИзменения(Элемент, Отказ)
	
	Если НЕ ПроверитьЗаблокироватьСчетПриемник(Элементы.ТаблицаСчетовПриемник.ТекущиеДанные) Тогда
		
		Отказ=Истина;
		Возврат;
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ВыбранныйСчетИсточник) Тогда
		
		СтрокиИсточник=ТаблицаСчетовИсточник.НайтиСтроки(Новый Структура("СчетИсточник",ВыбранныйСчетИсточник));
		Элементы.ТаблицаСчетовИсточник.ТекущаяСтрока=СтрокиИсточник[0].ПолучитьИдентификатор();
		Элементы.ОтборПоИсточнику.Пометка=Истина;
		УстановитьОтборПриемник(ПолучитьОтборыПриемник(ВыбранныйСчетИсточник));
	Иначе	
		
		Элементы.ОтборПоИсточнику.Пометка	=Ложь;
		
	КонецЕсли;
	
КонецПроцедуры


	
	




