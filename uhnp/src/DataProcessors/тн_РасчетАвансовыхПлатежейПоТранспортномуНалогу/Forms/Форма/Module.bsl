		|<b>1,5</b> - in relation to passenger cars with an average cost from 3 million to 5 million rubles inclusive, that were manufactured 1 year ago maximum;
		|<b>1,3</b> - in relation to passenger cars with an average cost from 3 million to 5 million rubles inclusive, that were manufactured from 1 to 2 years ago maximum;
		|<b>1,1</b> - in relation to passenger cars with an average cost from 3 million to 5 million rubles inclusive, that were manufactured from 2 to 3 years ago maximum; 
		|<b>2</b> - in relation to passenger cars with an average cost from 5 million to 10 million rubles inclusive, that were manufactured 5 years ago maximum;
		|<b>3</b> - in relation to passenger cars with an average cost from 10 million to 15 million rubles inclusive, that were manufactured 10 years ago maximum;
		|<b>3</b> - in relation to passenger cars with an average cost from 15 million rubles inclusive, that were manufactured 20 years ago maximum.
		|The age calculation starts from the car manufacture year.
		|The procedure of calculating the average cost of passenger cars is determined by the Ministry of Industry and Trade of the Russian Federation.
		|The list of passenger cars with an average cost from 3 million rubles (from 2022 - from 10 million rubles)
		|is posted annually no later than March 31 on <a href = ""https://minpromtorg.gov.ru/docs/list/"">the official website of the Ministry of Industry and Trade of the Russian Federation</a>'");
		
	КонецЕсли;	
	
	Элементы.ТранспортныеСредстваПовышающийКоэффициент.Подсказка = СтроковыеФункции.ФорматированнаяСтрока(ШаблонСтроки); 
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПериод(Период)
	
	ГодовойРасчет = КонецКвартала(Период) = КонецГода(Период);
	Объект.НачалоПериода = ?(ГодовойРасчет, НачалоГода(Период), НачалоКвартала(Период));
	Объект.КонецПериода = КонецКвартала(Период);

    ПериодСоставленияОтчета = БухгалтерскиеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(
		Объект.НачалоПериода, Объект.КонецПериода, Истина);  
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()   
	
	Объект.ТранспортныеСредства.Очистить();
	
	ДопПараметры = Неопределено;
	Если Не ГодовойРасчет Тогда
		ДопПараметры = Новый Структура("РассчитатьСправочно", Истина);
	КонецЕсли;
	
	РасчетыПоНалогу = РасчетИмущественныхНалогов.ПолучитьРасчетПоТранспортномуНалогу(
							Объект.Организация, КонецДня(Объект.КонецПериода), ДопПараметры); 
	РасчетПоНалогу = РасчетыПоНалогу.Налог;    
	КоличествоМесяцевВПериоде = ?(ГодовойРасчет, 12, 3);

	Для Каждого СтрокаРасчета Из РасчетПоНалогу Цикл
		НоваяСтрока = Объект.ТранспортныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчета);	  
		НоваяСтрока.Коэффициент = Окр(СтрокаРасчета.КоличествоМесяцевВладения / КоличествоМесяцевВПериоде, 2);

		//убираем авансовые платежи, т.к. в обработке не нужно их учитывать
		Если ГодовойРасчет И СтрокаРасчета.УплачиваютсяАвансы Тогда
			НоваяСтрока.СуммаНалогаКУплате = СтрокаРасчета.СуммаНалогаКУплате + СтрокаРасчета.СуммаАвансовыхПлатежей1Кв
				+ СтрокаРасчета.СуммаАвансовыхПлатежей2Кв + СтрокаРасчета.СуммаАвансовыхПлатежей3Кв; 
		КонецЕсли;   
		
	КонецЦикла;
	
	Если Объект.ТранспортныеСредства.Количество() = 0 Тогда
		Объект.АвансовыеПлатежи.Очистить();
		ТекстСообщения = СтрШаблон("Отсутствуют данные о регистрации транспортных средств на %1 для %2",
			ПериодСоставленияОтчета, Объект.Организация);  
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения); 
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьАвансовыеПлатежи();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Шаг)
	
	Объект.КонецПериода  = КонецМесяца(ДобавитьМесяц(Объект.КонецПериода, 3*Шаг)); 
	ПоказатьПериод(Объект.КонецПериода);  
		
КонецПроцедуры     

&НаСервере
Процедура ПерезаполнитьАвансовыеПлатежи()  
	
	Объект.АвансовыеПлатежи.Очистить();
	
	ПоискПоОКТМО = Новый Структура("КодПоОКТМО");   
	
	Для Каждого СтрокаТС Из Объект.ТранспортныеСредства Цикл 
		
		ПоискПоОКТМО.КодПоОКТМО = СтрокаТС.КодПоОКТМО;
		СтрокиПоОКТМО = Объект.АвансовыеПлатежи.НайтиСтроки(ПоискПоОКТМО);
		Если СтрокиПоОКТМО.Количество() = 0 Тогда
			СтрокаПлатеж = Объект.АвансовыеПлатежи.Добавить();
			СтрокаПлатеж.КодПоОКТМО = СтрокаТС.КодПоОКТМО;
		Иначе
			СтрокаПлатеж =  СтрокиПоОКТМО[0];
		КонецЕсли;
		СтрокаПлатеж.Сумма = СтрокаПлатеж.Сумма + СтрокаТС.СуммаНалогаКуплате;	
		
	КонецЦикла;  
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКода(ИмяКода, ТекущиеДанные)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыборКодаЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	ИмущественныеНалогиКлиент.ВыбратьКодИзКлассификатора(
		ИмяКода, 
		"ЛьготыПоТранспортномуНалогу", 
		"ПараметрыНачисленияТранспортногоНалога", 
		Объект.КонецПериода, 
		ТекущиеДанные.КодНалоговойЛьготы, 
		ОповещениеОЗакрытии);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборКодаЗавершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		ДопПараметры.ТекущиеДанные.КодНалоговойЛьготы = РезультатЗакрытия;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКодаВидаТранспортногоСредства()

	ТекущиеДанные = Элементы.ТранспортныеСредства.ТекущиеДанные;

	СтруктураКодов = КодыВидовТС.Получить(ТекущиеДанные.КодВидаТранспортногоСредства);
	
	Если СтруктураКодов <> Неопределено Тогда
		
		КодЕдиницыИзмерения = Элементы.ТранспортныеСредстваЕдиницаИзмерения.СписокВыбора.НайтиПоЗначению(СтруктураКодов.КодЕдиницыИзмерения);
		Если КодЕдиницыИзмерения <> Неопределено Тогда
			ТекущиеДанные.ЕдиницаИзмерения = КодЕдиницыИзмерения.Значение;
		Иначе
			ТекущиеДанные.ЕдиницаИзмерения = "";
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьКодВидаТранспортногоСредстваЗавершение(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТранспортныеСредства.ТекущиеДанные;
	ТекущиеДанные.КодВидаТранспортногоСредства = Результат.КодВидаТС;
	
	ПриИзмененииКодаВидаТранспортногоСредства();
	
КонецПроцедуры

&НаКлиенте
Процедура Расчет(СтрокаТС)
	
	Если НЕ ГодовойРасчет И СтрокаТС.Коэффициент = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТС.ДоляВПравеОбщейСобственностиЗнаменатель = 0 ИЛИ СтрокаТС.ДоляВПравеОбщейСобственностиЧислитель = 0 Тогда
		ДоляВПравеОбщейСобственности = 1;
	Иначе
		ДоляВПравеОбщейСобственности = СтрокаТС.ДоляВПравеОбщейСобственностиЧислитель / СтрокаТС.ДоляВПравеОбщейСобственностиЗнаменатель;
	КонецЕсли; 
	
	ПовышающийКоэффициент = ?(СтрокаТС.ПовышающийКоэффициент = 0, 1, СтрокаТС.ПовышающийКоэффициент);
	
	Если ГодовойРасчет Тогда 
		//измененный пользователем коэффициент владения не учитываем (как в ОКС)
		СтрокаТС.СуммаНалога = Окр(ДоляВПравеОбщейСобственности * СтрокаТС.НалоговаяБаза * СтрокаТС.НалоговаяСтавка * ПовышающийКоэффициент * СтрокаТС.КоличествоМесяцевВладения / 12);
	Иначе  
		ПоискПоКоэффициенту = Новый Структура("Коэффициент", СтрокаТС.Коэффициент);
		СтрокиКоэффициента = КоэффициентыВладения.НайтиСтроки(ПоискПоКоэффициенту);
		ЭтоСтандартныйКоэффициент = СтрокиКоэффициента.Количество() > 0;
		Если ЭтоСтандартныйКоэффициент Тогда 
			КоличествоМесяцев = СтрокиКоэффициента[0].КоличествоМесяцев;
			СтрокаТС.СуммаНалога = Окр(ДоляВПравеОбщейСобственности * СтрокаТС.НалоговаяБаза * СтрокаТС.НалоговаяСтавка * ПовышающийКоэффициент * КоличествоМесяцев/ 12);
		КонецЕсли; 
	КонецЕсли;
	
	СтрокаТС.СуммаНалогаКУплате = СтрокаТС.СуммаНалога - СтрокаТС.СуммаНалоговойЛьготы;

	ПерезаполнитьАвансовыеПлатежи();
	
КонецПроцедуры 

&НаСервере
Функция СформироватьТабличныйДокумент()
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет      = УправлениеПечатью.МакетПечатнойФормы("Обработка.тн_РасчетАвансовыхПлатежейПоТранспортномуНалогу.СправкаРасчетТН");
	МакетОбщий = ПолучитьОбщийМакет("СправкаРасчет");
	
	ЗаголовокОтчета         = МакетОбщий.ПолучитьОбласть("Заголовок");
	ОбластьШапка            = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока           = Макет.ПолучитьОбласть("Строка");
	ОбластьИтого            = Макет.ПолучитьОбласть("Итого");
	ОбластьОкончаниеТаблицы = Макет.ПолучитьОбласть("ОкончаниеТаблицы");
	ОбластьПодвал           = МакетОбщий.ПолучитьОбласть("Подвал");
	
	ЗаголовокОтчета.Параметры.Период = ПериодСоставленияОтчета;
	
	СведенияОбОрганизации =  ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Объект.Организация, Объект.КонецПериода);
	НазваниеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ПолноеНаименование");
	ЗаголовокОтчета.Параметры.НазваниеОрганизации = НазваниеОрганизации;
	ЗаголовокОтчета.Параметры.ДатаСоставления     = КонецКвартала(Объект.КонецПериода);
	ЗаголовокОтчета.Параметры.НазваниеОтчета      = "Авансовый платеж по транспортному налогу";
	ТабличныйДокумент.Вывести(ЗаголовокОтчета, 1);
	
	ТабличныйДокумент.Вывести(ОбластьШапка, 1);
	
	ТаблицаДляПечати = Объект.ТранспортныеСредства.Выгрузить();
	ТаблицаДляПечати.Сортировать("КодПоОКТМО, НомерСтроки");
	ТаблицаДляПечати.Индексы.Добавить("ИФНС, КодПоОКТМО");
	ТаблицаДляПечатиСгруппированная = ТаблицаДляПечати.Скопировать();
	ТаблицаДляПечатиСгруппированная.Свернуть("ИФНС, КодПоОКТМО", "СуммаНалогаКуплате");
	
	ТекущийОКТМО = ?(ТаблицаДляПечати.Количество() > 0, ТаблицаДляПечати[0].КодПоОКТМО, "");
	ПоискПоИФНСиОКТМО = Новый Структура("ИФНС, КодПоОКТМО");

	НомерСтроки = 1;
	
	Для Каждого СтрокаИтог Из ТаблицаДляПечатиСгруппированная Цикл 
		
		ТекущаяИФНС = СтрокаИтог.ИФНС;
		ТекущийОКТМО = СтрокаИтог.КодПоОКТМО;
		ОбластьИтого.Параметры.КодПоОКТМО = ТекущийОКТМО;
		ОбластьИтого.Параметры.ИФНС = ТекущаяИФНС;
		ОбластьИтого.Параметры.СуммаНалогаПоОКТМО = СтрокаИтог.СуммаНалогаКуплате;
		ТабличныйДокумент.Вывести(ОбластьИтого, 1);
		
		ПоискПоИФНСиОКТМО.ИФНС = ТекущаяИФНС; 
		ПоискПоИФНСиОКТМО.КодПоОКТМО = ТекущийОКТМО;
		СтрокиПоИФНСиОКТМО = ТаблицаДляПечати.НайтиСтроки(ПоискПоИФНСиОКТМО);
		
		Для Каждого Строка Из СтрокиПоИФНСиОКТМО Цикл 
			
			ОбластьСтрока.Параметры.Заполнить(Строка);
			Если Объект.КонецПериода >= '20141001' Тогда
				ОбластьСтрока.Параметры.Доля = Строка(Строка.ДоляВПравеОбщейСобственностиЧислитель) + "/" + Строка(Строка.ДоляВПравеОбщейСобственностиЗнаменатель);
			КонецЕсли; 
			
			ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
			ТабличныйДокумент.Вывести(ОбластьСтрока, 1);
			НомерСтроки = НомерСтроки + 1;  
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьОкончаниеТаблицы, 1);
	ТабличныйДокумент.Вывести(ОбластьПодвал, 1);
	
	ТабличныйДокумент.ФиксацияСверху = 9;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;   
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Обработка_РасчетАвансовыхПлатежейПоТранспортномуНалогу";

	УправлениеОтчетамиУХ.УстановитьКолонтитулыПоУмолчанию(ТабличныйДокумент, ЗаголовокОтчета, Пользователи.ТекущийПользователь()); 
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Функция РегистрацияОрганизацииВИФНС() 
	
	Возврат ЗарплатаКадры.РегистрацияВНалоговомОрганеОрганизации(Объект.Организация, Объект.КонецПериода); 
	
КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)   
	
	Объект.ТранспортныеСредства.Очистить();
	НастройкиТранспортныеСредства = Настройки.Получить("Объект.ТранспортныеСредства"); 
	ТранспортныеСредстваДляЗагрузки = ОбщегоНазначенияУТ.МассивВТаблицуЗначений(НастройкиТранспортныеСредства);
	Объект.ТранспортныеСредства.Загрузить(ТранспортныеСредстваДляЗагрузки);  
	
	Объект.АвансовыеПлатежи.Очистить();
	НастройкиАвансовыеПлатежи = Настройки.Получить("Объект.АвансовыеПлатежи"); 
	АвансовыеПлатежиДляЗагрузки = ОбщегоНазначенияУТ.МассивВТаблицуЗначений(НастройкиАвансовыеПлатежи);
	Объект.АвансовыеПлатежи.Загрузить(АвансовыеПлатежиДляЗагрузки);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	НастройкиТранспортныеСредства = ОбщегоНазначения.ТаблицаЗначенийВМассив(Объект.ТранспортныеСредства.Выгрузить());
	Настройки.Вставить("Объект.ТранспортныеСредства", НастройкиТранспортныеСредства);
	
	НастройкиАвансовыеПлатежи = ОбщегоНазначения.ТаблицаЗначенийВМассив(Объект.АвансовыеПлатежи.Выгрузить());
	Настройки.Вставить("Объект.АвансовыеПлатежи", НастройкиАвансовыеПлатежи);
	
КонецПроцедуры

#КонецОбласти