
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПериодЗакупок 		= ПериодТекущийГод(); 
	ОрганизацияЗаказчик	= Параметры.Организация;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда) 
	
	Если Не ЗначениеЗаполнено(ПериодЗакупок) Тогда
		ТекстСообщения = НСтр("ru = 'Перед созданием необходимо выбрать период'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ПериодЗакупок");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОрганизацияЗаказчик) Тогда
		ТекстСообщения = НСтр("ru = 'Перед созданием необходимо выбрать организацию-заказчика'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ОрганизацияЗаказчик");
		Возврат;
	КонецЕсли;    

	Если Не ЗначениеЗаполнено(СпособВыбораПоставщика) Тогда
		ТекстСообщения = НСтр("ru = 'Перед созданием необходимо выбрать способ закупки'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"СпособВыбораПоставщика");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОфициальногоОбъявленияЗакупки) Тогда
		ТекстСообщения = НСтр("ru = 'Перед созданием необходимо выбрать дату официального объявления закупки'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ДатаОфициальногоОбъявленияЗакупки");
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ПериодЗакупок",			ПериодЗакупок);
	СтруктураОтвета.Вставить("ОрганизацияЗаказчик",		ОрганизацияЗаказчик);  
	СтруктураОтвета.Вставить("СпособВыбораПоставщика",	СпособВыбораПоставщика); 
	СтруктураОтвета.Вставить("ДатаОфициальногоОбъявленияЗакупки",	ДатаОфициальногоОбъявленияЗакупки); 
	Закрыть(СтруктураОтвета);  
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПериодТекущийГод()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Периодичность КАК Периодичность,
		|	Периоды.Ссылка КАК Ссылка,
		|	Периоды.ДатаНачала КАК ДатаНачала
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Периодичность = &Периодичность
		|	И Периоды.ДатаНачала = &ДатаНачала";
	
	Запрос.УстановитьПараметр("ДатаНачала", 		НачалоГода(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Периодичность", 		Перечисления.Периодичность.Год);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка; 			
	Иначе
		Возврат Неопределено;	
	КонецЕсли;

КонецФункции // ()


#КонецОбласти
