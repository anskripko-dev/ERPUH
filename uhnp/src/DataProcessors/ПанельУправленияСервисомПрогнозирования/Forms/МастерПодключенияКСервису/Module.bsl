&НаКлиенте
Процедура Подключаемый_ПовторитьРегистрациюНаКлиенте()
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПовторитьРегистрациюОповещение", ЭтотОбъект);

	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		РезультатЗаданияНачатьАнализБазы, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПовторитьРегистрациюОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ПовторитьРегистрациюНаСервере(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправитьЗаявкуВСервисНаКлиенте()

	Если Не ПустаяСтрока(ИдентификаторЗаданияОтправитьЗаявкуВСервис) Тогда
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОтправитьЗаявкуВСервисНаКлиентеОповещение", ЭтотОбъект);
	
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			РезультатЗаданияОтправитьЗаявкуВСервис, ОповещениеОЗавершении, ПараметрыОжидания);
		
	Иначе
		ИдентификаторСервиса = СервисПрогнозированияПереопределяемыйКлиентСервер.ИдентификаторСервиса();
		Обработчик = Новый ОписаниеОповещения("ПослеПодключенияТестовогоПериода", ЭтотОбъект);
		ПодключениеСервисовСопровожденияКлиент.ПодключитьТестовыйПериод(ИдентификаторСервиса, ЭтотОбъект, Обработчик);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаявкуВСервисНаКлиентеОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ОтправитьЗаявкуВСервисЗавершение(Истина);
		ИдентификаторСервиса = СервисПрогнозированияПереопределяемыйКлиентСервер.ИдентификаторСервиса();
		Обработчик = Новый ОписаниеОповещения("ПослеПодключенияТестовогоПериода", ЭтотОбъект);
		ПодключениеСервисовСопровожденияКлиент.ПодключитьТестовыйПериод(ИдентификаторСервиса, ЭтотОбъект, Обработчик);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправитьЗаявкуВСервисНаКлиентеИВыгрузитьДанные()
	
	Если Не ПустаяСтрока(ИдентификаторЗаданияОтправитьЗаявкуВСервис) Тогда
		// 1.
		ОтправитьЗаявкуВСервисЗавершение();
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИдентификаторЗаданияОтправитьЗаявкуВСервис) Тогда
		// 1.
		// Значение идентификатора может поменяться, поэтому проверка выполняется второй раз.
		// Ожидаем подключение к сервису прогнозирования.
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ОтправитьЗаявкуВСервисНаКлиентеИВыгрузитьДанныеОповещение", ЭтотОбъект);
	
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			РезультатЗаданияОтправитьЗаявкуВСервис, ОповещениеОЗавершении, ПараметрыОжидания);
		
	ИначеЕсли БазаПодключена
		И ВыгрузкаРанееПроизводилась Тогда
		// 3.
		// Ранее уже подключались, это - повторная выгрузка данных.
		ВыгрузкаНачатаУспешно = ВыполнитьДействияПоПодключениюКСервисуПрогнозированияИзПростогоРежимаСервер();
		Если ВыгрузкаНачатаУспешно Тогда
			Оповестить("ЗапускВыгрузкиДанныхВСервисПрогнозирования");
		КонецЕсли;
	Иначе
		// 2.
		// Подключились к сервису, теперь нужно подключить тестовый период.
		ИдентификаторСервиса = СервисПрогнозированияПереопределяемыйКлиентСервер.ИдентификаторСервиса();
		Обработчик = Новый ОписаниеОповещения("ПослеПодключенияТестовогоПериодаВыгрузитьДанные", ЭтотОбъект);
		ПодключениеСервисовСопровожденияКлиент.ПодключитьТестовыйПериод(ИдентификаторСервиса, ЭтотОбъект, Обработчик);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаявкуВСервисНаКлиентеИВыгрузитьДанныеОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Подключаемый_ОтправитьЗаявкуВСервисНаКлиентеИВыгрузитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияТестовогоПериода(Результат, Контекст) Экспорт
	
	Если Результат <> ПредопределенноеЗначение("Перечисление.СостоянияПодключенияСервисов.Подключен") Тогда
		ОчиститьСообщения();
		ШаблонТекстаОшибки = ТекстОшибкиПодключениеТестовогоПериода();
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, Результат);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияТестовогоПериодаВыгрузитьДанные(Результат, Контекст) Экспорт
	
	ОчиститьСообщения();
	// Выгрузка начинается независимо от успеха подключения тестового периода, т.к. выгрузка не тарифицируется и
	// пользователь сможет подключить тестовый период из меню биллинга в рабочем месте сервиса прогнозирования.
	ВыгрузкаНачатаУспешно = ВыполнитьДействияПоПодключениюКСервисуПрогнозированияИзПростогоРежимаСервер();
	Если ВыгрузкаНачатаУспешно Тогда
		ПараметрыОповещения = Новый Структура("НовыйСценарий", СценарийПрогнозирования);
		Оповестить("СозданиеСценарияПрогнозированияИзМастера", ПараметрыОповещения, ВладелецФормы);
		
		ПараметрыОповещения = Новый Структура("НовыйВидПланов", ВидПлана);
		Оповестить("СозданиеВидаПланаИзМастера", ПараметрыОповещения, ВладелецФормы);
		
		Оповестить("ЗапускВыгрузкиДанныхВСервисПрогнозирования");
	КонецЕсли;
	
	Если Результат <> ПредопределенноеЗначение("Перечисление.СостоянияПодключенияСервисов.Подключен") Тогда
		ШаблонТекстаОшибки = ТекстОшибкиПодключениеТестовогоПериода();
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, Результат);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьСтатусПодключенияНаКлиенте()
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновитьСтатусПодключенияОповещение", ЭтотОбъект);

	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		РезультатЗаданияНачатьАнализБазы, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусПодключенияОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ОбновитьСтатусПодключенияРезультатНаСервере(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПровестиАнализБазы()
	
	Если Не ПустаяСтрока(ИдентификаторЗаданияНачатьАнализБазы) Тогда
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПровестиАнализБазыОповещение", ЭтотОбъект);
	
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			РезультатЗаданияНачатьАнализБазы, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиАнализБазыОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено"
		И Не ПустаяСтрока(ИдентификаторЗаданияНачатьАнализБазы)Тогда
			ОбработатьИВывестиРезультатАнализаБазы(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПодключаемыеОбработка

&НаСервере
Процедура ОтправитьЗаявкуВСервисЗавершение(ВыполнениеПроверено = Ложь)
	Если ВыполнениеПроверено
		Или Не ПустаяСтрока(ИдентификаторЗаданияОтправитьЗаявкуВСервис)
			И ДлительныеОперации.ЗаданиеВыполнено(Новый УникальныйИдентификатор(ИдентификаторЗаданияОтправитьЗаявкуВСервис)) Тогда
		ИдентификаторЗаданияОтправитьЗаявкуВСервис = "";
		ПолучитьНастройкиСервиса();
		РассчитатьСтатусПодключения();
		
		Ответ = ПолучитьИзВременногоХранилища(АдресХранилищаОтправитьЗаявкуВСервис);
		ЕстьОшибка = Не ПустаяСтрока(Ответ.ТекстОшибки);
		Если ЕстьОшибка Тогда
			ИдетПопыткаПодключенияКСервисуПрогнозирования = Ложь;
		КонецЕсли;
		УстановитьВидимостьДоступность();
		УстановитьТексты();
		Если ЕстьОшибка Тогда
			ВызватьИсключение Ответ.ТекстОшибки;
		КонецЕсли;
		ОбновитьСтатусПодключенияНаСервере();
		РассчитатьРеквизитыСтатусовАвторизации();
		УстановитьВидимостьДоступность();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусПодключенияРезультатНаСервере(ВыполнениеПроверено = Ложь)
	Если ВыполнениеПроверено
		Или Не ПустаяСтрока(ИдентификаторЗаданияОбновитьСтатусПодключения)
			И ДлительныеОперации.ЗаданиеВыполнено(Новый УникальныйИдентификатор(ИдентификаторЗаданияОбновитьСтатусПодключения)) Тогда
		ИдентификаторЗаданияОбновитьСтатусПодключения = "";
		ПолучитьНастройкиСервиса();
		РассчитатьСтатусПодключения();
		УстановитьВидимостьДоступность();
		УстановитьТексты();
		Ответ = ПолучитьИзВременногоХранилища(АдресХранилищаОбновитьСтатусПодключения);
		Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
			ВызватьИсключение Ответ.ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПовторитьРегистрациюНаСервере(ВыполнениеПроверено = Ложь)
	Если ВыполнениеПроверено
		Или Не ПустаяСтрока(ИдентификаторЗаданияПовторитьРегистрацию)
			И ДлительныеОперации.ЗаданиеВыполнено(Новый УникальныйИдентификатор(ИдентификаторЗаданияПовторитьРегистрацию)) Тогда
		ИдентификаторЗаданияПовторитьРегистрацию = "";
		ПолучитьНастройкиСервиса();
		РассчитатьСтатусПодключения();
		УстановитьВидимостьДоступность();
		УстановитьТексты();
		Ответ = ПолучитьИзВременногоХранилища(АдресХранилищаПовторитьРегистрацию);
		Если Не ПустаяСтрока(Ответ.ТекстОшибки) Тогда
			ВызватьИсключение Ответ.ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

