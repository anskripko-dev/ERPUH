&НаСервере
Процедура УстановитьАвтоматическийОтборВнутренний(ПродажиЗаПоследниеМесяцы, ПродажиЗаКоличествоМесяцев, КоличествоМесяцев)
	
	СхемаКомпоновкиДанных = ПолучитьОбщийМакет("СервисПрогнозированияФильтрОтправляемыхДанных");
	КомпоновщикНастроекОтборовНаВыгрузку.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	ОтборыНастроек = КомпоновщикНастроекОтборовНаВыгрузку.Настройки.Отбор; // ОтборКомпоновкиДанных.
	
	Если ПродажиЗаПоследниеМесяцы Тогда
		ЭлементОтбора = ОтборыНастроек.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыСПродажамиЗаПоследнееКоличествоМесяцев");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = 6;
	КонецЕсли;
	Если ПродажиЗаКоличествоМесяцев Тогда
		ЭлементОтбора = ОтборыНастроек.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыСПродажамиЗаКоличествоМесяцев");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = КоличествоМесяцев;
	КонецЕсли;
	
	ЗаписатьНастройки();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КоллекцииЭлементовОтборовРавны(Коллекция1, Коллекция2)
	
	Если ТипЗнч(Коллекция1) <> ТипЗнч(Коллекция2) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Коллекция1.Элементы.Количество() = Коллекция2.Элементы.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 0 По Коллекция1.Элементы.Количество() - 1 Цикл
		
		ЭлементКоллекции1 = Коллекция1.Элементы[Индекс];
		ЭлементКоллекции2 = Коллекция2.Элементы[Индекс];
		Если ТипЗнч(ЭлементКоллекции1) <> ТипЗнч(ЭлементКоллекции2) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если СервисПрогнозированияПереопределяемыйКлиентСервер.ЭтоГруппировкаКомпоновкиДанных(ЭлементКоллекции1) Тогда
			ГруппировкиРавны = КоллекцииЭлементовОтборовРавны(ЭлементКоллекции1, ЭлементКоллекции2)
				И ЭлементКоллекции1.Использование = ЭлементКоллекции2.Использование
				И ЭлементКоллекции1.ТипГруппы = ЭлементКоллекции2.ТипГруппы
				И ЭлементКоллекции1.Представление = ЭлементКоллекции2.Представление;
			Если Не ГруппировкиРавны Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ЭлементыРавны = ЭлементКоллекции1.ВидСравнения = ЭлементКоллекции2.ВидСравнения
				Или ЭлементКоллекции1.Использование = ЭлементКоллекции2.Использование
				Или ЭлементКоллекции1.ЛевоеЗначение = ЭлементКоллекции2.ЛевоеЗначение
				Или ЭлементКоллекции1.ПравоеЗначение = ЭлементКоллекции2.ПравоеЗначение
				Или ЭлементКоллекции1.Представление = ЭлементКоллекции2.Представление;
			Если Не ЭлементыРавны Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОтборыНаВыгрузкуДанныхКорректны()
	
	// Внутри сгруппированных условий должны быть только однородные условия, по одним и тем же полям отбора.
	// Т.е. разрешено:
	//  Номенклатура.Реквизит1 = А
	//  ИЛИ
	//  Номенклатура.Реквизит2 = Б
	// 
	// Запрещено:
	//  Номенклатура = А
	//  ИЛИ
	//  Партнер = Б
	
	ЕстьОшибка = Ложь;
	ОтборНаВыгрузку = КомпоновщикНастроекОтборовНаВыгрузку.Настройки.Отбор;
	Для Каждого ЭлементОтбора Из ОтборНаВыгрузку.Элементы Цикл
		Если СервисПрогнозированияПереопределяемыйКлиентСервер.ЭтоГруппировкаКомпоновкиДанных(ЭлементОтбора) Тогда
			ЭлементыОтбора = СобратьРазличныеПодчиненныеЭлементыОтбораКомпоновкиДанных(ЭлементОтбора);
			Если ЭлементыОтбора.Количество() > 1 Тогда
				ЭлементыСОшибкой = Новый Массив();
				Для Каждого КлючЗначение Из ЭлементыОтбора Цикл
					ЭлементыСОшибкой.Добавить(КлючЗначение.Ключ);
				КонецЦикла;
				ТекстОшибки = ТекстОшибкиНекорректныеГруппировкиОтбораНаВыгрузку();
				ТекстОшибки = СтрШаблон(ТекстОшибки, СтрСоединить(ЭлементыСОшибкой, Символы.ПС));
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "КомпоновщикНастроекОтборовНаЗагрузкуНастройкиОтбор");
				ЕстьОшибка = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибка Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Собрать различные подчиненные элементы отбора компоновки данных.
// 
// Параметры:
//  ПолеОтбора - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных -
// 
// Возвращаемое значение:
//  Структура
&НаСервере
Функция СобратьРазличныеПодчиненныеЭлементыОтбораКомпоновкиДанных(ПолеОтбора)
	
	Ответ = Новый Структура;
	
	Для Каждого ЭлементОтбора Из ПолеОтбора.Элементы Цикл
		Если СервисПрогнозированияПереопределяемыйКлиентСервер.ЭтоГруппировкаКомпоновкиДанных(ЭлементОтбора) Тогда
			ВложенныйОтвет = СобратьРазличныеПодчиненныеЭлементыОтбораКомпоновкиДанных(ЭлементОтбора);
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Ответ, ВложенныйОтвет);
		Иначе
			// Проверка производится по основному типу отбираемого значения. Реквизиты типа проверять не требуется,
			// т.к. на них ограничения не распространяются.
			ПредставлениеОтбора = Строка(ЭлементОтбора.ЛевоеЗначение);
			ПерваяТочка = СтрНайти(ПредставлениеОтбора, ".");
			Если ПерваяТочка > 0 Тогда
				ПредставлениеОтбора = Лев(ПредставлениеОтбора, ПерваяТочка - 1);
			КонецЕсли;
			Ответ.Вставить(ПредставлениеОтбора, ЭлементОтбора.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область РаботаСоСхемойКомпоновкиПодключаемые

&НаКлиенте
Процедура Подключаемый_КомпоновщикНастроекОтборовНаВыгрузкуВидСравненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.КомпоновщикНастроекОтборовНаВыгрузкуНастройкиОтбор.ТекущиеДанные;
	Если ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыСПродажамиЗаПоследнееКоличествоМесяцев") Тогда
		Элемент.СписокВыбора.Очистить();
		Элемент.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	ИначеЕсли ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыСПродажамиЗаКоличествоМесяцев") Тогда
		Элемент.СписокВыбора.Очистить();
		Элемент.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
		Элемент.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
		Элемент.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Больше);
	Иначе
		Если Элемент.СписокВыбора.Количество() > 0 Тогда
			Элемент.СписокВыбора.Очистить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

