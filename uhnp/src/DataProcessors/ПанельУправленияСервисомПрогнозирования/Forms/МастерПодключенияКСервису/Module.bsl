КонецПроцедуры

&НаКлиенте
Процедура НачатьПрогнозирование(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ТокенПриложения)
		Или Не СтатусПодключенияАктивен Тогда
		ТекстСообщенияОбОшибке = ТекстОшибкиАвторизацияНеНайдена();
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СценарийПрогнозирования) Тогда
		ТекстСообщенияОбОшибке = ТекстОшибкиНеЗаполненСценарийПрогнозирования();
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидПлана) Тогда
		
		НачатьПрогнозированиеНаСервере(Истина, Истина, Истина);
		
		Оповестить("ЗапускВыгрузкиДанныхВСервисПрогнозирования");
		
	Иначе
		ТекстСообщенияОбОшибке = ТекстОшибкиНеЗаполненВидПлана();
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке, , "ВидПлана");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДогрузитьДанные(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ТокенПриложения)
		Или Не СтатусПодключенияАктивен Тогда
		ТекстСообщенияОбОшибке = ТекстОшибкиАвторизацияНеНайдена();
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке);
		Возврат;
	КонецЕсли;
	
	НачатьПрогнозированиеНаСервере(Ложь, Ложь, Ложь);
	
	Оповестить("ЗапускВыгрузкиДанныхВСервисПрогнозирования");
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияИПолнаяВыгрузкаДанных(Команда)
	
	ОчиститьСообщения();
	
	Если КоличествоПериодовПрогнозирования < 1 Тогда
		ИмяРеквизита = НСтр("ru = 'Горизонт (количество периодов) прогнозирования';
							|en = 'Forecast horizon (number of forecasting periods)'");
		ТекстСообщенияОбОшибке = ТекстОшибкиНеЗаполненаНастройкаПервогоПрогноза(ИмяРеквизита);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке,, "КоличествоПериодовПрогнозирования");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Периодичность) Тогда
		ИмяРеквизита = НСтр("ru = 'Периодичность прогнозирования';
							|en = 'Forecasting frequency'");
		ТекстСообщенияОбОшибке = ТекстОшибкиНеЗаполненаНастройкаПервогоПрогноза(ИмяРеквизита);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке,, "Периодичность");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачалаПрогнозирования) Тогда
		ИмяРеквизита = НСтр("ru = 'Дата начала прогнозирования';
							|en = 'Forecasting start date'");
		ТекстСообщенияОбОшибке = ТекстОшибкиНеЗаполненаНастройкаПервогоПрогноза(ИмяРеквизита);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке,, "ДатаНачалаПрогнозирования");
		Возврат;
	КонецЕсли;
	
	// Последовательность действий:
	// 1. Отправляется заявка на подключение к сервису прогнозирования.
	// 2. Отправляется заявка на подключение тестового периода. Пользователю выводится соответствующая форма.
	// 3. Начинается выгрузка данных из информационной базы.
	// 4. Производится запрос тестового прогноза.
	
	ИдетПопыткаПодключенияКСервисуПрогнозирования = Истина;
	РегистрацияИзПростогоРежимаПодключенияСервер();
	ПодключитьОбработчикОжидания("Подключаемый_ОтправитьЗаявкуВСервисНаКлиентеИВыгрузитьДанные", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяВыгрузкаДанных(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ТокенПриложения)
		Или Не СтатусПодключенияАктивен Тогда
		ТекстСообщенияОбОшибке = ТекстОшибкиАвторизацияНеНайдена();
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОбОшибке);
		Возврат;
	КонецЕсли;
	
	НачатьПрогнозированиеНаСервере(Истина, Ложь, Ложь);
	
	Оповестить("ЗапускВыгрузкиДанныхВСервисПрогнозирования");
	
КонецПроцедуры

