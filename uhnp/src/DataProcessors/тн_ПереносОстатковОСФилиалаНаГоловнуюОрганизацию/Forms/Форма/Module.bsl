#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	УстановитьОтображениеЗаголовкаИЭлементовУправления();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

 #Область ОбработчикиКомандФормы
 
&НаКлиенте
Процедура КнопкаНазад(Команда)
			
	Если Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаОформлениеДокументов Тогда  
		ПереходНаШаг(Элементы.СтраницаСписаниеОстатков);    
	Иначе 		                
		ПереходНаШаг(Элементы.СтраницаНастройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаДалее(Команда)
	
	ТекущаяСтраница = Элементы.ОсновнаяПанель.ТекущаяСтраница;
	Если ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		ПереходНаШаг(Элементы.СтраницаСписаниеОстатков);
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаСписаниеОстатков Тогда
		ПереходНаШаг(Элементы.СтраницаОформлениеДокументов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаЗакрыть(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументыСписанияОстатков(Команда)    
	
	ОчиститьСообщения(); 
	
	Если Не ЗначениеЗаполнено(ОрганизацияФилиал) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию-филиал!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтатьяРасходов) Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить статью расходов!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСписанияОстатков) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату списания остатков!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтатьяВыбытия) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить статью выбытия!");
		Возврат;
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(СчетСписания) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить счет списания!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда  
		Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл загрузки!");
			Возврат;
		КонецЕсли;  
		Загрузить();  
	КонецЕсли;
	
	СформироватьДокументыСписанияОстатковНаСервере();   
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументыВводаНачальныхОстатков(Команда)  
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСписанияОстатков) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату списания остатков!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОперацияМСФО) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить операцию МСФО!");
		Возврат;
	КонецЕсли;	
	
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда 
		Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл загрузки!");
			Возврат;
		КонецЕсли;  
		Загрузить();  
	КонецЕсли;
	
	СформироватьДокументыВводаНачальныхОстатковНаСервере();  
	
КонецПроцедуры 

&НаКлиенте
Процедура Загрузить()
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьДанные(АдресХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузкуОстатков(Команда) 
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл для выгрузки!");
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент; 
	ЗаполнитьТабличныйДокумент(ТабДок);  
	ТабДок.Записать(ПутькФайлу, ТипФайлаТабличногоДокумента.XLSX);   
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Выгрузка данных успешно завершена!");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстатки(Команда)
	
	ОчиститьСообщения();          
	
	Если Не ЗначениеЗаполнено(ОрганизацияФилиал) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПолученияОстатков) Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату получения остатков!");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();   
	Элементы.ГруппаДанные.Показать(); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьТабличныйДокумент(ТабДок) 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("МакетВыгрузки");	 
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого Строка Из Объект.ТаблицаДанных Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Строка);  
		
		ОбластьСтрока.Параметры.ОсновноеСредствоGUID             = ?(ЗначениеЗаполнено(Строка.ОсновноеСредство), Строка(Строка.ОсновноеСредство.УникальныйИдентификатор()), "");	
		ОбластьСтрока.Параметры.ПодразделениеБУGUID              = ?(ЗначениеЗаполнено(Строка.ПодразделениеБУ), Строка(Строка.ПодразделениеБУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.МОЛБУGUID                        = ?(ЗначениеЗаполнено(Строка.МОЛБУ),  Строка(Строка.МОЛБУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.ПодразделениеУУGUID              = ?(ЗначениеЗаполнено(Строка.ПодразделениеУУ),  Строка(Строка.ПодразделениеУУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.МОЛУУGUID                        = ?(ЗначениеЗаполнено(Строка.МОЛУУ),  Строка(Строка.МОЛУУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.СпособПоступления                = ?(ЗначениеЗаполнено(Строка.СпособПоступления),  Строка(ПолучитьИмяПеречисления(Строка.СпособПоступления)), "");
		ОбластьСтрока.Параметры.МетодНачисленияАмортизацииБУ     = ?(ЗначениеЗаполнено(Строка.МетодНачисленияАмортизацииБУ),  Строка(ПолучитьИмяПеречисления(Строка.МетодНачисленияАмортизацииБУ)), "");
		ОбластьСтрока.Параметры.МетодНачисленияАмортизацииУУ     = ?(ЗначениеЗаполнено(Строка.МетодНачисленияАмортизацииУУ),  Строка(ПолучитьИмяПеречисления(Строка.МетодНачисленияАмортизацииУУ)), "");
		ОбластьСтрока.Параметры.ОбъектУчетаАмортизационнаяГруппа = ?(ЗначениеЗаполнено(Строка.ОбъектУчетаАмортизационнаяГруппа),  Строка(ПолучитьИмяПеречисления(Строка.ОбъектУчетаАмортизационнаяГруппа)), "");
		ОбластьСтрока.Параметры.СтатьяРасходовУУGUID             = ?(ЗначениеЗаполнено(Строка.СтатьяРасходовУУ), Строка(Строка.СтатьяРасходовУУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.СтатьяРасходовБУGUID             = ?(ЗначениеЗаполнено(Строка.СтатьяРасходовБУ),  Строка(Строка.СтатьяРасходовБУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.СтатьяРасходовНУGUID             = ?(ЗначениеЗаполнено(Строка.СтатьяРасходовНУ),  Строка(Строка.СтатьяРасходовНУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.АналитикаУУGUID                  = ?(ЗначениеЗаполнено(Строка.АналитикаУУ),  Строка(Строка.АналитикаУУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.АналитикаБУGUID                  = ?(ЗначениеЗаполнено(Строка.АналитикаБУ),  Строка(Строка.АналитикаБУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.АналитикаНУGUID                  = ?(ЗначениеЗаполнено(Строка.АналитикаНУ),  Строка(Строка.АналитикаНУ.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.ГруппаФинансовогоУчетаGUID       = ?(ЗначениеЗаполнено(Строка.ГруппаФинансовогоУчета),  Строка(Строка.ГруппаФинансовогоУчета.УникальныйИдентификатор()), "");
		
		ТабДок.Вывести(ОбластьСтрока); 
		
	КонецЦикла;
		
	Возврат(ТабДок);
	
КонецФункции  

&НаСервере
Функция ПолучитьИмяПеречисления(ПеречислениеСсылка)
	
	ИмяПеречисления = ПеречислениеСсылка.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ПеречислениеСсылка);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя; 
	
	Возврат ИмяЗначенияПеречисления;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанные(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла   = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(1,1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаДанных = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);     
	
	Если ОтсутствуютОбязательныеКолонкиВФайле(ТаблицаДанных) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаДанных Цикл
		
		НС = Объект.ТаблицаДанных.Добавить();	
		
		ЗаполнитьЗначенияСвойств(НС, Строка);
		
		НС.ОсновноеСредство = ПреобразоватьЗначениеИзСтроки(Строка.ОсновноеСредствоGUID, "Справочник", "ОбъектыЭксплуатации");	
		
		НС.СтатьяРасходовБУ = ПреобразоватьЗначениеИзСтроки(Строка.СтатьяРасходовБУGUID, "ПланВидовХарактеристик", "СтатьиРасходов");
		НС.СтатьяРасходовУУ = ПреобразоватьЗначениеИзСтроки(Строка.СтатьяРасходовУУGUID, "ПланВидовХарактеристик", "СтатьиРасходов");    
		НС.АналитикаБУ =  ПолучитьАналитику(НС.ОсновноеСредство, НС.СтатьяРасходовБУ, Строка.АналитикаБУGUID);
		НС.АналитикаУУ =  ПолучитьАналитику(НС.ОсновноеСредство, НС.СтатьяРасходовУУ, Строка.АналитикаУУGUID);
		НС.АналитикаНУ =  ПолучитьАналитику(НС.ОсновноеСредство, НС.СтатьяРасходовНУ, Строка.АналитикаНУGUID);		
		НС.ГруппаФинансовогоУчета =	ПреобразоватьЗначениеИзСтроки(Строка.ГруппаФинансовогоУчетаGUID, "Справочник", "ГруппыФинансовогоУчетаВнеоборотныхАктивов");
		НС.ДатаПринятияКУчетуБУ = ПреобразоватьЗначениеИзСтроки(Строка.ДатаПринятияКУчетуБУ, "Дата");
		НС.ДатаПринятияКУчетуУУ = ПреобразоватьЗначениеИзСтроки(Строка.ДатаПринятияКУчетуУУ, "Дата");
		НС.МОЛБУ = ПреобразоватьЗначениеИзСтроки(Строка.МОЛБУGUID, "Справочник", "ФизическиеЛица");	
		НС.МОЛУУ = ПреобразоватьЗначениеИзСтроки(Строка.МОЛУУGUID, "Справочник", "ФизическиеЛица");	
		НС.МетодНачисленияАмортизацииБУ = ПреобразоватьЗначениеИзСтроки(Строка.МетодНачисленияАмортизацииБУ, "Перечисление", "СпособыНачисленияАмортизацииОС");
		НС.МетодНачисленияАмортизацииУУ = ПреобразоватьЗначениеИзСтроки(Строка.МетодНачисленияАмортизацииУУ, "Перечисление", "СпособыНачисленияАмортизацииОС");
		НС.ОбъектУчетаАмортизационнаяГруппа = ПреобразоватьЗначениеИзСтроки(Строка.ОбъектУчетаАмортизационнаяГруппа, "Перечисление", "АмортизационныеГруппы");		
		НС.ОтражатьВУпрУчете  = НС.ТекущаяСтоимостьУУ <> 0; 
		НС.ОтражатьВРеглУчете =	НС.ТекущаяСтоимостьБУ <> 0;
		НС.ОтражатьВНалУчете  = НС.ТекущаяСтоимостьНУ <> 0;
		НС.ПодразделениеБУ    = ПреобразоватьЗначениеИзСтроки(Строка.ПодразделениеБУGUID, "Справочник", "СтруктураПредприятия");
		НС.ПодразделениеУУ	  = ПреобразоватьЗначениеИзСтроки(Строка.ПодразделениеУУGUID, "Справочник", "СтруктураПредприятия");
		НС.СпособПоступления  = ПреобразоватьЗначениеИзСтроки(Строка.СпособПоступления, "Перечисление", "СпособыПоступленияАктивов");		
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАналитику(ОсновноеСредство, СтатьяРасходов, ГУИД)
	
	Аналитика = Неопределено;
	
	Если ЗначениеЗаполнено(СтатьяРасходов) Тогда
		Если Строка(СтатьяРасходов.ТипЗначения) = "Подразделение" Тогда
			Аналитика =  ПреобразоватьЗначениеИзСтроки(ГУИД, "Справочник", "СтруктураПредприятия");
		ИначеЕсли Строка(СтатьяРасходов.ТипЗначения) = "Объект эксплуатации" Тогда
			Аналитика = ОсновноеСредство;	
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Объект учета: " + ОсновноеСредство + Символы.ПС
			+ "По статье '" + СтатьяРасходов + "' не установлена аналитика!");
		КонецЕсли;
	КонецЕсли;    
	
	Возврат Аналитика;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьЗначениеИзСтроки(СтрЗначение, Тип = "Число", Вид = "")

	Если ПустаяСтрока(СтрЗначение) 
		И Не Тип = "Булево" Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Тип = "Дата" Тогда
		Результат = Дата(СтрЗначение);	
	ИначеЕсли Тип = "Число" Тогда
		Результат = Число(СтрЗаменить(СтрЗначение, " ", ""));
	ИначеЕсли Тип = "Булево" Тогда
		Результат = СтрЗначение = "Да" ИЛИ СтрЗначение = "Истина" ИЛИ СтрЗначение = "+" ИЛИ СтрЗначение = "1";
	ИначеЕсли Тип = "Перечисление" Тогда
		Результат = Перечисления[Вид][СтрЗначение];
	ИначеЕсли Тип = "Справочник" Тогда
		Результат = Справочники[Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗначение));      
	ИначеЕсли Тип = "ПланВидовХарактеристик" Тогда
		Результат = ПланыВидовХарактеристик[Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗначение));
	Иначе
		Результат = СтрЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтсутствуютОбязательныеКолонкиВФайле(Таблица)
		
	Колонки = Таблица.Колонки;
	
	МассивОбязательныхКолонок = Новый Массив; 
	МассивОбязательныхКолонок.Добавить("ОсновноеСредствоGUID"); 
	МассивОбязательныхКолонок.Добавить("ГруппаФинансовогоУчетаGUID");
	МассивОбязательныхКолонок.Добавить("ПодразделениеБУGUID");
	МассивОбязательныхКолонок.Добавить("ПодразделениеУУGUID");	
	МассивОбязательныхКолонок.Добавить("ДатаПринятияКУчетуБУ");	
	МассивОбязательныхКолонок.Добавить("ДатаПринятияКУчетуУУ");	 
	МассивОбязательныхКолонок.Добавить("ДатаПринятияКУчетуНУ");	
	МассивОбязательныхКолонок.Добавить("МОЛБУGUID");	
	МассивОбязательныхКолонок.Добавить("МОЛУУGUID");	
	МассивОбязательныхКолонок.Добавить("СпособПоступления");	
	МассивОбязательныхКолонок.Добавить("МетодНачисленияАмортизацииУУ");	
	МассивОбязательныхКолонок.Добавить("МетодНачисленияАмортизацииБУ");	
	МассивОбязательныхКолонок.Добавить("ОбъектУчетаАмортизационнаяГруппа");	
	МассивОбязательныхКолонок.Добавить("СтатьяРасходовУУGUID");
    МассивОбязательныхКолонок.Добавить("СтатьяРасходовБУGUID");     
    МассивОбязательныхКолонок.Добавить("СтатьяРасходовНУGUID");
	МассивОбязательныхКолонок.Добавить("АналитикаУУGUID");   
	МассивОбязательныхКолонок.Добавить("АналитикаБУGUID");   
	МассивОбязательныхКолонок.Добавить("АналитикаНУGUID");   
	
	Для Каждого ОбязательнаяКолонка Из МассивОбязательныхКолонок Цикл
		
		Если КолонкаОтсутствует(Колонки, ОбязательнаяКолонка) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции 

&НаСервере
Функция КолонкаОтсутствует(Колонки, ИмяКолонки)
	
	Если Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В файле отсутствует колонка ""%1"". Исправьте или выгрузите файл заново.", ИмяКолонки));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции 

&НаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыПоСпособуРасходов(СтрокаТаблицы)   
	
	// БУ
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПоСпособуОтраженияРасходов(
		СтрокаТаблицы.СпособОтраженияРасходовБУ, 
		СтрокаТаблицы.СтатьяРасходовБУ, 
