		СтрокаТаблицы.СтатьяРасходовУУ, 
		СтрокаТаблицы.АналитикаРасходовУУ, 
		СтрокаТаблицы.ПодразделениеУУ, 
		СтрокаТаблицы.НаправлениеДеятельностиУУ, 
		СтрокаТаблицы.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчетаУУ);
		
	// НУ
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПоСпособуОтраженияРасходов(
		СтрокаТаблицы.СпособОтраженияРасходовНУ, 
		СтрокаТаблицы.СтатьяРасходовНУ, 
		СтрокаТаблицы.АналитикаРасходовНУ, 
		СтрокаТаблицы.ПодразделениеНУ, 
		СтрокаТаблицы.НаправлениеДеятельностиНУ, 
		СтрокаТаблицы.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчетаНУ);		
		
КонецПроцедуры  
	
&НаСервере
Процедура УстановитьОтображениеЗаголовкаИЭлементовУправления()
	
	ТекущаяСтраница = Элементы.ОсновнаяПанель.ТекущаяСтраница;
	
	ЗаголовкиСтраниц = Новый Соответствие;
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаНастройки, "Шаг 1 из 3 «Получение остатков основных средств с филиала на головную организацию»");       
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаСписаниеОстатков, "Шаг 2 из 3 «Списание остатков с организации филиала»");
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаОформлениеДокументов, "Шаг 3 из 3 «Ввод остатков на головную организацию»");
	
	Элементы.ДекорацияЗаголовокСтраницы.Заголовок = ЗаголовкиСтраниц[ТекущаяСтраница];
	
	Элементы.КнопкиСлева.ТекущаяСтраница = ?(ТекущаяСтраница = Элементы.СтраницаНастройки,
																Элементы.ГруппаКнопокСлеваНет,
																Элементы.ГруппаКнопкиСлеваЕсть);

	Если ТекущаяСтраница = Элементы.СтраницаОформлениеДокументов Тогда
		Элементы.КнопкиСправа.ТекущаяСтраница   = Элементы.ГруппаКнопкиСправаНаПоследнейСтранице;
		Элементы.КнопкаГотово.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.КнопкиСправа.ТекущаяСтраница  = Элементы.ГруппаКнопкиСправаНаПервойСтранице;
		Элементы.КнопкаДалее.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ПереходНаШаг(Страница)
	
	Элементы.ОсновнаяПанель.ТекущаяСтраница = Страница;
	УстановитьОтображениеЗаголовкаИЭлементовУправления();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыСписанияОстатковНаСервере()	
	
	ТаблицаПроверкиОС = ПолучитьТаблицуПроверкиОС(ДатаСписанияОстатков, ОрганизацияФилиал, Объект.ТаблицаДанных.Выгрузить(,"ОсновноеСредство,ОтражатьВУпрУчете,ОтражатьВРеглУчете,ОтражатьВНалУчете"), Истина);

	СписокПодразделений = Объект.ТаблицаДанных.Выгрузить(,"ПодразделениеУУ, ПодразделениеБУ"); 
    СписокПодразделений.Свернуть("ПодразделениеУУ, ПодразделениеБУ");

	Для Каждого Строка Из СписокПодразделений Цикл  
		Если Не ЗначениеЗаполнено(Строка.ПодразделениеБУ)
			И ЗначениеЗаполнено(Строка.ПодразделениеУУ) Тогда
           Строка.ПодразделениеБУ = Строка.ПодразделениеУУ;
	   КонецЕсли; 
		Если Не ЗначениеЗаполнено(Строка.ПодразделениеУУ)
			И ЗначениеЗаполнено(Строка.ПодразделениеБУ) Тогда
           Строка.ПодразделениеУУ = Строка.ПодразделениеБУ;
	   КонецЕсли; 
	КонецЦикла;
	
	СписокУУ = СписокПодразделений.Скопировать(,"ПодразделениеУУ");
	СписокУУ.Свернуть("ПодразделениеУУ"); 
	СписокБУ = СписокПодразделений.Скопировать(,"ПодразделениеБУ");
	СписокБУ.Свернуть("ПодразделениеБУ"); 
	
	Для Каждого Строка Из СписокБУ Цикл
		СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Строка.ПодразделениеБУ, Истина, Истина);
		СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Строка.ПодразделениеБУ, Истина, Ложь); 
		СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Строка.ПодразделениеБУ, Ложь, Истина, Истина);
		СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Строка.ПодразделениеБУ, Ложь,  Ложь, Истина);
	КонецЦикла;
	
	Для Каждого Строка Из СписокУУ Цикл
		СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Строка.ПодразделениеУУ, Ложь,  Истина);
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ДокументыСписания.Количество());
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыСписанияОстатковПоВидамУчета(ТаблицаПроверкиОС, Подразделение, ОтражатьВРеглУчете, ОтражатьВУпрУчете, ОтражатьВНалУчете = Ложь)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ОтражатьВРеглУчете", ОтражатьВРеглУчете);
	СтруктураПоиска.Вставить("ОтражатьВУпрУчете",  ОтражатьВУпрУчете); 
    Если ОтражатьВНалУчете
		Или (ОтражатьВУпрУчете И Не ОтражатьВРеглУчете) Тогда
		СтруктураПоиска.Вставить("ОтражатьВНалУчете",  ОтражатьВНалУчете); 
	КонецЕсли;	
	Если ОтражатьВРеглУчете 
		Или ОтражатьВНалУчете Тогда
		СтруктураПоиска.Вставить("ПодразделениеБУ",      Подразделение); 
	Иначе     
		СтруктураПоиска.Вставить("ПодразделениеУУ",      Подразделение); 
	КонецЕсли; 
	
	НайденныеСтроки = Объект.ТаблицаДанных.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда   
		Возврат;	
	КонецЕсли;
	
	ДокументОбъект = Документы.СписаниеОС2_4.СоздатьДокумент();

	Для Каждого Строка Из НайденныеСтроки Цикл   
		
		НайденныеСтрокиСписания = ТаблицаПроверкиОС.НайтиСтроки(Новый Структура("ОсновноеСредство", Строка.ОсновноеСредство));
		
		Если НайденныеСтрокиСписания.Количество() > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("По ОС " + Строка.ОсновноеСредство + " уже списаны остатки " +  НайденныеСтрокиСписания[0].СтрокаУчета + "." + ?(ЗначениеЗаполнено(НайденныеСтрокиСписания[0].Регистратор), " Документ списания: " + НайденныеСтрокиСписания[0].Регистратор, ""), НайденныеСтрокиСписания[0].Регистратор); 
			Продолжить;
		КонецЕсли;

		НС = ДокументОбъект.ОС.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Строка);
		НС.ЛиквидационнаяСтоимостьРегл = НС.ЛиквидационнаяСтоимость;
		НС.СуммаСписанияБУ = Строка.ТекущаяСтоимостьБУ; 
		НС.СуммаСписанияНУ = Строка.ТекущаяСтоимостьНУ; 
		НС.СуммаСписанияУУ = Строка.ТекущаяСтоимостьУУ;    
		НС.СуммаСписанияПР = Строка.ТекущаяСтоимостьПР;
		
	КонецЦикла; 
	
	Если ДокументОбъект.ОС.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ДокументОбъект.Организация           = ОрганизацияФилиал;      
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеОС;
	ДокументОбъект.ОтражатьВРеглУчете    = ОтражатьВРеглУчете Или ОтражатьВНалУчете;
	ДокументОбъект.ОтражатьВУпрУчете     = ОтражатьВУпрУчете;  
	ДокументОбъект.Ответственный         = Пользователи.ТекущийПользователь();  

	// НАЧАЛО Юдина Екатерина 19.02.2026 Выполнение задач №000056817    
	//ДокументОбъект.Дата                  = ДатаСписанияОстатков;
	//ДокументОбъект.ДатаСписания          = ДатаСписанияОстатков; 
	ДатаСписанияНаКонецДня = КонецДня(ДатаСписанияОстатков); 
	ДокументОбъект.Дата                  = ДатаСписанияНаКонецДня;
	ДокументОбъект.ДатаСписания          = ДатаСписанияНаКонецДня; 
	// КОНЕЦ Юдина Екатерина 19.02.2026 Выполнение задач №000056817
	ДокументОбъект.Подразделение         = Подразделение;   
	ДокументОбъект.СтатьяРасходовВыбытие = СтатьяВыбытия;     
	ДокументОбъект.СтатьяРасходов        = СтатьяРасходов;  
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДокументОбъект.Комментарий           = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДата();
	ДокументОбъект.Комментарий           = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ДокументОбъект.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчета = Истина; 

	Ссылка = Документы.СписаниеОС2_4.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ДокументОбъект.УстановитьСсылкуНового(Ссылка);  
	ДокументОбъект.НастройкаСчетовУчета = Справочники.НастройкиСчетовУчетаПрочихОпераций.ВернутьНастройкаСчетовУчета(Ссылка, СчетСписания, Организация);
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение					
		ДокументОбъект.УстановитьНовыйНомер();
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
	КонецПопытки;
	
	Если (ОтражатьВРеглУчете Или ОтражатьВНалУчете)  
		И ОтражатьВУпрУчете Тогда
		ВариантОтраженияВУчете = Перечисления.ВариантыОтраженияВУчетеВнеоборотныхАктивов.УправленческомИРегламентированномУчетах;  
	ИначеЕсли ОтражатьВУпрУчете Тогда
		ВариантОтраженияВУчете = Перечисления.ВариантыОтраженияВУчетеВнеоборотныхАктивов.УправленческомУчете;
	Иначе
		ВариантОтраженияВУчете = Перечисления.ВариантыОтраженияВУчетеВнеоборотныхАктивов.РегламентированномУчете;
	КонецЕсли; 

	НС = ДокументыСписания.Добавить();  
	НС.Документ = ДокументОбъект.Ссылка;	
    НС.Подразделение = Подразделение;      
	НС.ВариантОтраженияВУчете = ВариантОтраженияВУчете;   
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуПроверкиОС(Период, Организация, ТаблицаОС, ЭтоСписание)
  
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	               |	ТаблицаОС.ОтражатьВУпрУчете КАК ОтражатьВУпрУчете,
	               |	ТаблицаОС.ОтражатьВРеглУчете КАК ОтражатьВБУ,
	               |	ТаблицаОС.ОтражатьВНалУчете КАК ОтражатьВНУ
	               |ПОМЕСТИТЬ ВТ_ТаблицаОС
	               |ИЗ
	               |	&ТаблицаОС КАК ТаблицаОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ПорядокУчетаОСБУ.ОсновноеСредство КАК ОсновноеСредство,
	               |	ПорядокУчетаОСБУ.СостояниеБУ КАК СостояниеБУ,
	               |	ПорядокУчетаОСБУ.СостояниеНУ КАК СостояниеНУ,
	               |	ПорядокУчетаОСБУ.Регистратор КАК Регистратор,
	               |	ПорядокУчетаОСБУ.Период КАК Период
	               |ПОМЕСТИТЬ ВТ_ПорядокУчетаОСБУ
	               |ИЗ
	               |	РегистрСведений.ПорядокУчетаОСБУ.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ОсновноеСредство В
	               |					(ВЫБРАТЬ
	               |						ВТ_ТаблицаОС.ОсновноеСредство
	               |					ИЗ
	               |						ВТ_ТаблицаОС)) КАК ПорядокУчетаОСБУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ПорядокУчетаОСУУ.ОсновноеСредство КАК ОсновноеСредство,
	               |	ПорядокУчетаОСУУ.Состояние КАК Состояние,
	               |	ПорядокУчетаОСУУ.Регистратор КАК Регистратор,
	               |	ПорядокУчетаОСУУ.Период КАК Период
	               |ПОМЕСТИТЬ ВТ_ПорядокУчетаОСУУ
	               |ИЗ
	               |	РегистрСведений.ПорядокУчетаОСУУ.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ОсновноеСредство В
	               |					(ВЫБРАТЬ
	               |						ВТ_ТаблицаОС.ОсновноеСредство
	               |					ИЗ
	               |						ВТ_ТаблицаОС)) КАК ПорядокУчетаОСУУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Итог.ОсновноеСредство КАК ОсновноеСредство,
	               |	ВТ_Итог.НедопустимоеСостояниеУУ КАК НедопустимоеСостояниеУУ,
	               |	ВТ_Итог.НедопустимоеСостояниеБУ КАК НедопустимоеСостояниеБУ,
	               |	ВТ_Итог.НедопустимоеСостояниеНУ КАК НедопустимоеСостояниеНУ,
	               |	ВЫБОР
	               |		КОГДА ВТ_Итог.НедопустимоеСостояниеУУ
	               |				И ВТ_Итог.НедопустимоеСостояниеБУ
	               |				И ВТ_Итог.НедопустимоеСостояниеНУ
	               |			ТОГДА ""во всех видах учета""
	               |		КОГДА ВТ_Итог.НедопустимоеСостояниеБУ
	               |				И ВТ_Итог.НедопустимоеСостояниеНУ
	               |			ТОГДА ""в регл. учете""
	               |		КОГДА ВТ_Итог.НедопустимоеСостояниеБУ
	               |			ТОГДА ""в бух. учете""
	               |		КОГДА ВТ_Итог.НедопустимоеСостояниеНУ
	               |			ТОГДА ""в нал. учете""
	               |		ИНАЧЕ ""в упр. учете""
	               |	КОНЕЦ КАК СтрокаУчета,
	               |	ВТ_Итог.Регистратор КАК Регистратор
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		ТаблицаОС.ОтражатьВУпрУчете
	               |			И НЕ ПорядокУчетаОСУУ.Состояние ЕСТЬ NULL
	               |			И ПорядокУчетаОСУУ.Состояние = &СостояниеОС КАК НедопустимоеСостояниеУУ,
	               |		ТаблицаОС.ОтражатьВБУ
	               |			И НЕ ПорядокУчетаОСБУ.СостояниеБУ ЕСТЬ NULL
	               |			И ПорядокУчетаОСБУ.СостояниеБУ = &СостояниеОС КАК НедопустимоеСостояниеБУ,
	               |		ТаблицаОС.ОтражатьВНУ
	               |			И НЕ ПорядокУчетаОСБУ.СостояниеНУ ЕСТЬ NULL
	               |			И ПорядокУчетаОСБУ.СостояниеНУ = &СостояниеОС КАК НедопустимоеСостояниеНУ,
	               |		ЕСТЬNULL(ПорядокУчетаОСБУ.Регистратор, ПорядокУчетаОСУУ.Регистратор) КАК Регистратор
	               |	ИЗ
	               |		ВТ_ТаблицаОС КАК ТаблицаОС
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПорядокУчетаОСБУ КАК ПорядокУчетаОСБУ
	               |			ПО ТаблицаОС.ОсновноеСредство = ПорядокУчетаОСБУ.ОсновноеСредство
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПорядокУчетаОСУУ КАК ПорядокУчетаОСУУ
	               |			ПО ТаблицаОС.ОсновноеСредство = ПорядокУчетаОСУУ.ОсновноеСредство) КАК ВТ_Итог
	               |ГДЕ
	               |	(ВТ_Итог.НедопустимоеСостояниеУУ
	               |			ИЛИ ВТ_Итог.НедопустимоеСостояниеБУ
	               |			ИЛИ ВТ_Итог.НедопустимоеСостояниеНУ)";
	
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	Если ЭтоСписание Тогда												  
		Запрос.УстановитьПараметр("СостояниеОС", Перечисления.СостоянияОС.СнятоСУчета);  
	Иначе
		Запрос.УстановитьПараметр("СостояниеОС", Перечисления.СостоянияОС.ПринятоКУчету); 
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура СформироватьДокументыВводаНачальныхОстатковНаСервере()
	
	ДокументОбъект = Неопределено;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Комментарий = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДата();
	Комментарий = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	
	СтруктураЗаполнения = Новый Структура(
	"Организация, Местонахождение, ОтражатьВБУиНУ, ОтражатьВРеглУчете, ОтражатьВУУ,
	|ОтражатьВУпрУчете, ОтражатьВБУ, ОтражатьВНУ, ХозяйственнаяОперация, Комментарий",
	,,,,,,,,,);	
	
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	ТаблицаПроверкиОС = ПолучитьТаблицуПроверкиОС(ДатаСписанияОстатков, Организация, Объект.ТаблицаДанных.Выгрузить( ,"ОсновноеСредство,ОтражатьВУпрУчете,ОтражатьВРеглУчете,ОтражатьВНалУчете"), Ложь);
	
	Для Каждого Стр Из Объект.ТаблицаДанных Цикл
		
		Если Не ЗначениеЗаполнено(Стр.ОсновноеСредство) Тогда    
			Продолжить;
		КонецЕсли;
		
		Если Стр.ТекущаяСтоимостьБУ <= 0 
			И Стр.ТекущаяСтоимостьНУ <= 0 
			И Стр.ТекущаяСтоимостьПР <= 0
			И Стр.ТекущаяСтоимостьУУ <= 0 Тогда
			Продолжить;
		КонецЕсли; 			
		
		НайденныеСтрокиВводаОстатков = ТаблицаПроверкиОС.НайтиСтроки(Новый Структура("ОсновноеСредство", Стр.ОсновноеСредство));
		
		Если НайденныеСтрокиВводаОстатков.Количество() > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("По ОС " + Стр.ОсновноеСредство + " уже есть остатки " +  НайденныеСтрокиВводаОстатков[0].СтрокаУчета + "." + ?(ЗначениеЗаполнено(НайденныеСтрокиВводаОстатков[0].Регистратор), " Документ ввода: " + НайденныеСтрокиВводаОстатков[0].Регистратор, ""), НайденныеСтрокиВводаОстатков[0].Регистратор); 
			Продолжить;
		КонецЕсли;
		
		ОтраженВБУ = Стр.ОтражатьВРеглУчете;
		ОтраженВНУ = Стр.ОтражатьВНалУчете;
		ОтраженВУУ = Стр.ОтражатьВУпрУчете;
		
		Если Не ОтраженВБУ И Не ОтраженВНУ Тогда
			ОтражатьВБУиНУ = Ложь;
			ОтражатьВРеглУчете = Ложь;
		Иначе
			ОтражатьВБУиНУ = Истина;
			ОтражатьВРеглУчете = Истина;			
		КонецЕсли;  
		
		ОтражатьВУпрУчете 	= ОтраженВУУ;
		ОтражатьВУУ 		= ОтраженВУУ;
		
		СтруктураЗаполнения.ОтражатьВБУ			  = ОтраженВБУ;
		СтруктураЗаполнения.ОтражатьВНУ			  = ОтраженВНУ;
		СтруктураЗаполнения.ОтражатьВРеглУчете 	  = ОтражатьВРеглУчете;
		СтруктураЗаполнения.ОтражатьВУпрУчете 	  = ОтражатьВУпрУчете;
		СтруктураЗаполнения.ОтражатьВБУиНУ        = ОтражатьВБУиНУ;
		СтруктураЗаполнения.ОтражатьВУУ           = ОтражатьВУУ;
		СтруктураЗаполнения.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковОсновныхСредств;  		
		СтруктураЗаполнения.Организация           = Организация; 
		
		СтруктураЗаполнения.Местонахождение = ?(ЗначениеЗаполнено(Стр.ПодразделениеБУ), Стр.ПодразделениеБУ, Стр.ПодразделениеУУ);
		
		НайденыДокументы = ТаблицаДокументов.НайтиСтроки(СтруктураЗаполнения);
		
		Если НайденыДокументы.Количество() = 0 Тогда
			ДокументОбъект = Документы.ВводОстатковВнеоборотныхАктивов2_4.СоздатьДокумент();
			ДокументОбъект.Заполнить(Новый Структура("Дата, Местонахождение, ХозяйственнаяОперация",
			КонецДня(ДатаСписанияОстатков), СтруктураЗаполнения.Местонахождение, СтруктураЗаполнения.ХозяйственнаяОперация));
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураЗаполнения);
			ДокументОбъект.ОтражатьВОперативномУчете = Истина;
			ДокументОбъект.ОтражатьВРеглУчете        = ОтражатьВБУиНУ;
			ДокументОбъект.ОтражатьВУпрУчете         = ОтражатьВУУ;  
			ДокументОбъект.тн_ОперацияМСФО           = ОперацияМСФО;
			ДокументОбъект.Комментарий               = Комментарий;			
			
			ТекДокСтр = ТаблицаДокументов.Добавить();
			ТекДокСтр.ДокументОбъект = ДокументОбъект;  			
			ЗаполнитьЗначенияСвойств(ТекДокСтр, СтруктураЗаполнения);		
		Иначе
			ТекДокСтр = НайденыДокументы[0];
			ДокументОбъект = ТекДокСтр.ДокументОбъект;
		КонецЕсли;
		
		НовСтр = ДокументОбъект.ОС.Добавить(); 
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		
		НовСтр.ВариантРаздельногоУчетаНДС 	= Перечисления.ВариантыРаздельногоУчетаНДС.ИзДокумента; 
		НовСтр.НалогообложениеНДС			= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		НовСтр.Подразделение                = СтруктураЗаполнения.Местонахождение;			
		НовСтр.МОЛ                          = ?(ЗначениеЗаполнено(Стр.МОЛБУ), Стр.МОЛБУ, Стр.МОЛУУ);
		
		Если Стр.НачислятьАмортизациюБУ Тогда
			НовСтр.ПорядокУчетаБУ = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации;
		Иначе
			НовСтр.ПорядокУчетаБУ = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается;	
		КонецЕсли; 
		
		НовСтр.ПорядокУчетаНУ = Стр.МетодНачисленияАмортизацииНУ;			
		
		Если Не ЗначениеЗаполнено(НовСтр.ПорядокУчетаНУ) Тогда
			Если Стр.НачислятьАмортизациюНУ Тогда
				НовСтр.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации;
			Иначе
				НовСтр.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы;	
			КонецЕсли;
		КонецЕсли;  
		
		Если Стр.НачислятьАмортизациюУУ Тогда
			НовСтр.ПорядокУчетаУУ = Перечисления.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию;
		Иначе
			НовСтр.ПорядокУчетаУУ = Перечисления.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеНачислятьАмортизацию;	
		КонецЕсли;
		
		НовСтр.АмортизационнаяГруппа = Стр.ОбъектУчетаАмортизационнаяГруппа;
		
		ГруппаОС = Стр.ОсновноеСредство.ГруппаОС;
		Если ГруппаОС = Перечисления.ГруппыОС.Здания 
			Или ГруппаОС = Перечисления.ГруппыОС.Сооружения Тогда
			НовСтр.НедвижимоеИмущество = Истина;
		Иначе
			НовСтр.НедвижимоеИмущество = Ложь;
		КонецЕсли;	
		
		НовСтр.ЛиквидационнаяСтоимостьРегл = Стр.ЛиквидационнаяСтоимость;
		
		Если НовСтр.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету Тогда
			НовСтр.ТекущаяСтоимостьНУ 			= 0;
			НовСтр.ПервоначальнаяСтоимостьНУ 	= 0;
			НовСтр.НакопленнаяАмортизацияНУ 	= 0;
			НовСтр.СрокИспользованияНУ 			= 0;
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(НовСтр.ПервоначальнаяСтоимостьУУ) Тогда
			НовСтр.ПервоначальнаяСтоимостьУУ = НовСтр.ПервоначальнаяСтоимостьБУ;	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовСтр.СрокИспользованияУУ) 
			И ЗначениеЗаполнено(НовСтр.СрокИспользованияБУ) Тогда
			НовСтр.СрокИспользованияУУ = НовСтр.СрокИспользованияБУ;	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовСтр.СрокИспользованияБУ) 
			И ЗначениеЗаполнено(НовСтр.СрокИспользованияУУ) Тогда
			НовСтр.СрокИспользованияБУ = НовСтр.СрокИспользованияУУ;	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовСтр.СрокИспользованияНУ) 
			И ЗначениеЗаполнено(НовСтр.СрокИспользованияБУ) Тогда
			НовСтр.СрокИспользованияНУ = НовСтр.СрокИспользованияБУ;	
		КонецЕсли;
		
		НовСтр.СпециальныйКоэффициентНУ = Стр.СпециальныйКоэффициентНУ;
		Если Не ЗначениеЗаполнено(НовСтр.СпециальныйКоэффициентНУ) Тогда
			НовСтр.СпециальныйКоэффициентНУ = 1;
		КонецЕсли;
		
		ЗаполнитьРеквизитыПоСпособуРасходов(НовСтр);
		
		НовСтр.АналитикаРасходовБУ = Стр.АналитикаУУ; 
		НовСтр.АналитикаРасходовУУ = Стр.АналитикаБУ;
		НовСтр.АналитикаРасходовНУ = Стр.АналитикаНУ;
		//НАЧАЛО Блинова М.А. 25.02.2026 Выполнение задач №000056854 
		Если НовСтр.СтатьяРасходовБУ = НовСтр.СтатьяРасходовНУ И НовСтр.ПодразделениеНУ = Справочники.СтруктураПредприятия.ПустаяСсылка() Тогда  
			 НовСтр.ПодразделениеНУ = НовСтр.ПодразделениеБУ;
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 25.02.2026 Выполнение задач №000056854
	КонецЦикла;
	
	Для Каждого ТекДокСтр Из ТаблицаДокументов Цикл 
		
		ДокументОбъект = ТекДокСтр.ДокументОбъект;   
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
		КонецПопытки;   
		
		НС = ДокументыВводаНачальныхОстатков.Добавить();
		НС.Документ = ДокументОбъект.Ссылка;   
		НС.Подразделение = ДокументОбъект.Местонахождение;
		НС.ВариантОтраженияВУчете = ВнеоборотныеАктивыКлиентСервер.ВариантОтраженияВУчете(ДокументОбъект, Истина);   
		
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ДокументыВводаНачальныхОстатков.Количество());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОСОстатки.СтоимостьОстаток КАК СтоимостьУУ,
		|	СтоимостьОСОстатки.СтоимостьРеглОстаток КАК СтоимостьБУ,
		|	СтоимостьОСОстатки.СтоимостьНУОстаток КАК СтоимостьНУ,
		|	СтоимостьОСОстатки.СтоимостьПРОстаток КАК СтоимостьПР,
		|	СтоимостьОСОстатки.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета
