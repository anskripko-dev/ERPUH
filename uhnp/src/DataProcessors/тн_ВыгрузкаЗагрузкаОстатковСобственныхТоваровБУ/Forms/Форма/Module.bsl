
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ЭтаФорма.ДатаДокументов = ТекущаяДата(); 
	ЭтаФорма.ДатаДокументов = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ЭтаФорма.Менеджер		= Пользователи.ТекущийПользователь();
	ЭтаФорма.ПропускатьНулевыеКолва = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл";
	ДиалогВыбора.Фильтр = "MXL (*.mxl)";
	
	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
	
	ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла);
	
	Элементы.СоздатьДоки.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла)
	
	Расширение = Прав(ИмяФайла,3);
	
	ФайлПриемник = ПолучитьИмяВременногоФайла(Расширение);
	ДанныеХранилища = ПолучитьИзВременногоХранилища(Адрес);
	ДанныеХранилища.Записать(ФайлПриемник);
	
	ТабДокумент.Очистить();
	ТабДокумент.Прочитать(ФайлПриемник,СпособЧтенияЗначенийТабличногоДокумента.Текст);
	
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокиНаСервере()
	
	Результат.Очистить();
	
	КолОргID = 8;
	КолСклID = 9;
	КолТовID = 7;
	КолТов	 = 4;
	КолОрг	 = 1;
	КолСкл	 = 2;
	КолКолво = 5;
	КолСумма = 6;
	// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	КолРезервБУ = 11;
	КолРезервУУ = 12;
	// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	
	// Ищем первую строку с данными
	Для ПерваяСтрокаДанныхВФайле = 1 По ТабДокумент.ВысотаТаблицы Цикл
		Если  ТабДокумент.Область(ПерваяСтрокаДанныхВФайле,КолОрг,ПерваяСтрокаДанныхВФайле,КолОрг).Текст = "Организация" Тогда
			ПерваяСтрокаДанныхВФайле = ПерваяСтрокаДанныхВФайле +1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если  ПерваяСтрокаДанныхВФайле > ТабДокумент.ВысотаТаблицы Тогда
		Результат.ДобавитьСтроку("Файл не соответствует");
		Возврат;
	Иначе
		Результат.ДобавитьСтроку("Обрабатываем со строки "+Строка(ПерваяСтрокаДанныхВФайле)+" по "+Строка(ТабДокумент.ВысотаТаблицы) );
		Результат.ДобавитьСтроку("Номер строки и результат: ");
	КонецЕсли;
	
	
	ПредОрганизация = "";
	//НАЧАЛО Белоконенко Д. 18.11.2021. Коммент
	//ПредСклад ="";
	//КОНЕЦ Белоконенко Д. 18.11.2021
	Документ  = Неопределено;
	ДокументСоздан = Ложь;
	
	Для Счетчик=ПерваяСтрокаДанныхВФайле По ТабДокумент.ВысотаТаблицы Цикл
		
		ТекОрганизация	= ТабДокумент.Область(Счетчик,КолОргID,Счетчик,КолОргID).Текст;
		//НАЧАЛО Белоконенко Д. 18.11.2021. Коммент
		//ТекСклад		= ТабДокумент.Область(Счетчик,КолСклID,Счетчик,КолСклID).Текст;
		//КОНЕЦ Белоконенко Д. 18.11.2021
		ТекТовар		= ТабДокумент.Область(Счетчик,КолТовID,Счетчик,КолТовID).Текст;
		
		
		//НАЧАЛО Белоконенко Д. 18.11.2021.
		//Было
		//Если НЕ(ТекОрганизация = ПредОрганизация И ТекСклад = ПредСклад) Тогда  // новый документ
		Если НЕ(ТекОрганизация = ПредОрганизация) Тогда  // новый документ
		//КОНЕЦ Белоконенко Д. 18.11.2021
	
			Если ДокументСоздан Тогда								// не первый документ
				ЗаполнитьПоля(Документ);
				Документ.Записать();
				Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ.Номер+ " от "+Документ.Дата);
			КонецЕсли;
			
			СсылкаОрганизация = Справочники.Организации.УправленческаяОрганизация;
			
			//Попытка
			//	//GUID	= Новый УникальныйИдентификатор(ТекОрганизация);
			//	СсылкаОрганизация  = Справочники.Организации.ПолучитьСсылку(GUID);
			//Исключение
			//	СсылкаОрганизация = Справочники.Организации.ПустаяСсылка();
			//КонецПопытки;
			
			//НАЧАЛО Белоконенко Д. 18.11.2021.
			//Попытка
			//	GUID	= Новый УникальныйИдентификатор(ТекСклад);
			//	СсылкаСклад  = Справочники.Склады.ПолучитьСсылку(GUID);
			//Исключение
			//	СсылкаСклад = Справочники.Склады.ПустаяСсылка();
			//КонецПопытки;
			СсылкаСклад = СкладОстатка;
			//КОНЕЦ Белоконенко Д. 18.11.2021
			
			Если СсылкаОрганизация = Справочники.Организации.ПустаяСсылка() ИЛИ Лев(Строка(СсылкаОрганизация),7)="<Объект" Тогда
				ДокументСоздан = Ложь;
				Результат.ДобавитьСтроку(Строка(Счетчик)+" Не найден Организация:"+ТабДокумент.Область(Счетчик,КолОрг,Счетчик,КолОрг).Текст);
			ИначеЕсли СсылкаСклад=Справочники.Склады.ПустаяСсылка() ИЛИ Лев(Строка(СсылкаСклад),7)="<Объект"  Тогда
				ДокументСоздан = Ложь;
				Результат.ДобавитьСтроку(Строка(Счетчик)+" Не найден Склад:"+ТабДокумент.Область(Счетчик,КолСкл,Счетчик,КолСкл).Текст);
			Иначе 
				// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
				//Документ = Документы.ВводОстатков.СоздатьДокумент();
				Документ = Документы.ВводОстатковТоваров.СоздатьДокумент();
				// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
				ЗаполнитьШапку(Документ, СсылкаОрганизация, СсылкаСклад);
				ДокументСоздан = Истина;
			КонецЕсли;
			
		КонецЕсли;	
		
		// новая строка в ТЧ
		Если ДокументСоздан Тогда
			Попытка
				GUID	= Новый УникальныйИдентификатор(ТекТовар);
				СсылкаТовар  = Справочники.Номенклатура.ПолучитьСсылку(GUID);
			Исключение
				СсылкаТовар = Справочники.Номенклатура.ПустаяСсылка();
			КонецПопытки;
			
			Если СсылкаТовар = Справочники.Номенклатура.ПустаяСсылка() ИЛИ Лев(Строка(СсылкаТовар),7)="<Объект" Тогда
				
				Результат.ДобавитьСтроку(Строка(Счетчик)+" Не найден товар:"+ТабДокумент.Область(Счетчик,КолТов,Счетчик,КолТов).Текст);
				
			ИначеЕсли ДокументСоздан Тогда
				
				ОстатокКоличество = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолКолво,Счетчик,КолКолво).Текст);
				ОстатокСумма = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолСумма,Счетчик,КолСумма).Текст);
				// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
				РезервБУ = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолРезервБУ,Счетчик,КолРезервБУ).Текст);
				РезервУУ = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолРезервУУ,Счетчик,КолРезервУУ).Текст);
				// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
				
				Если НЕ(ПропускатьНулевыеКолва И ОстатокКоличество<=0) Тогда
					// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
					//ЗаполнитьТЧ(Документ, СсылкаТовар, ОстатокКоличество, ОстатокСумма);
					ЗаполнитьТЧ(Документ, СсылкаТовар, ОстатокКоличество, ОстатокСумма, РезервБУ, РезервУУ);
					// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
				Иначе
					Результат.ДобавитьСтроку(Строка(Счетчик)+" Ошибка кол-ва "+ОстатокКоличество+" товара:"+ТабДокумент.Область(Счетчик,КолТов,Счетчик,КолТов).Текст);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПредОрганизация = ТекОрганизация;
		//НАЧАЛО Белоконенко Д. 18.11.2021. Коммент
		//ПредСклад 		= ТекСклад;
	    //КОНЕЦ Белоконенко Д. 18.11.2021
	КонецЦикла;
		
		
	Если Документ <> Неопределено Тогда	
		ЗаполнитьПоля(Документ);
		Документ.Записать();
		Результат.ДобавитьСтроку("Создан документ "+Документ.Номер+ " от "+Документ.Дата);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоки(Команда)
	Если НЕ ПроверитьЗаполнение() тогда
		Возврат;
	КонецЕсли;
	СоздатьДокиНаСервере();
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.Результат;
КонецПроцедуры

&НаСервере  
// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
//Процедура ЗаполнитьТЧ(Документ, Номенклатура, Количество, Сумма)
Процедура ЗаполнитьТЧ(Документ, Номенклатура, Количество, Сумма, РезервБУ, РезервУУ)
// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	
	Товар = Документ.Товары.Добавить();
	Товар.Номенклатура		= Номенклатура;
	Товар.СуммаСНДС			= Сумма;
	Товар.Сумма				= Сумма;
	Товар.КоличествоУпаковок= Количество;
	Товар.Количество		= Количество;
	
	Товар.СтавкаНДС = СтавкаНДСНоменклатуры(Товар.Номенклатура, Документ.Организация, Документ.Дата);
	
	// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	Товар.РезервПодОбесценениеРегл 	= РезервБУ;
	Товар.РезервПодОбесценениеУпр 	= РезервУУ;
	// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
КонецПроцедуры

&НаСервере
Функция ЗаполнитьШапку(Документ, Организация, Склад)
	
	Документ.Дата			= ДатаДокументов;
	Документ.Менеджер		= Менеджер;
	Документ.Ответственный	= Менеджер;
	// НАЧАЛО Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	//Документ.УдалитьТипОперации	= Перечисления.УдалитьТипыОперацийВводаОстатков.ОстаткиСобственныхТоваров;
	// КОНЕЦ Белоконенко Денис 22.12.2023 Выполнение задач №000047920
	Документ.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковСобственныхТоваров;
	Документ.Организация	= Организация;
	Документ.Склад	 		= Склад;
	//Документ.Подразделение	= Справочники.СтруктураПредприятия.НайтиПоНаименованию("Администрация");    
	Документ.ОтражатьВБУиНУ	= Ложь;
	Документ.ОтражатьВУУ	= Ложь;
	Документ.ЦенаВключаетНДС= Истина;
	Документ.ОтражатьСебестоимость		= Истина;
	Документ.ОтражатьВОперативномУчете	= Истина;
	Документ.ВидДеятельностиНДС			= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ЧислоЯчейки(Текст)
	
	Текст = СтрЗаменить(СокрЛП(Текст),Символы.НПП,"");
	Если Текст="" Тогда
		Возврат 0;
	Иначе
		Возврат Число(Текст);
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоля(Документ)
	
	КэшированныеЗначения = Неопределено;
	// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
	//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Документ);
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Документ);
	// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьЦенуПоСумме", "Количество");
	
	// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
	//ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Документ.Товары, СтруктураДействий, КэшированныеЗначения);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Документ.Товары, СтруктураДействий, КэшированныеЗначения);
	// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
	СтруктураДействий = Новый Структура;
	Если Не Документ.ЦенаВключаетНДС Тогда
		Для Каждого Стр Из Документ.Товары Цикл
			Стр.СуммаБезНДС = Стр.Сумма;
		КонецЦикла;
	Иначе
		СтруктураДействий.Вставить("ПересчитатьСуммуБезНДС", СтруктураПересчетаСуммы);
	КонецЕсли;
	
	ВалютаРегламентированногоУчета            = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУправленческогоУчета                = Константы.ВалютаУправленческогоУчета.Получить();
	КоэффициентПересчетаИзВалютыУпрВРегл      = КоэффициентПересчета(ВалютаУправленческогоУчета, ВалютаРегламентированногоУчета, Документ.Дата);
	ВалютаСтр                                 = Строка(ВалютаУправленческогоУчета);
	
	СтруктураДействий.Вставить("ПересчитатьСуммуРегл", КоэффициентПересчетаИзВалютыУпрВРегл);
	СтруктураДействий.Вставить("ПересчитатьНДСРегл", СтруктураПересчетаСуммы);
	
	// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
	//ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Документ.Товары, СтруктураДействий, КэшированныеЗначения);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Документ.Товары, СтруктураДействий, КэшированныеЗначения);
	// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоэффициентПересчета(ВалютаУправленческогоУчета, ВалютаРегламентированногоУчета, ДатаДокумента)
	
	Возврат РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(
											ВалютаУправленческогоУчета,
											ВалютаРегламентированногоУчета,
											?(ДатаДокумента = Дата(1,1,1), ТекущаяДатаСеанса(), ДатаДокумента));
	
КонецФункции

&НаСервереБезКонтекста
Функция СтавкаНДСНоменклатуры(Номенклатура, Организация, Дата)

	СтавкаНДС = УчетНДСУП.СтавкаНДСНоменклатуры(Номенклатура, Организация, Дата);
	Возврат СтавкаНДС;
	
КонецФункции
