Функция ПолучитьТаблицуИзФайла(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата();  
	ТекущаяДата = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	СтруктураСоответствияСчетовСчетамМЦ = ПолучитьСтруктуруСоответствияСчетовСчетамМЦ();
	
	ТЗ = Новый ТаблицаЗначений;	
	ТЗ.Колонки.Добавить("Подразделение");
	ТЗ.Колонки.Добавить("Номенклатура"); 
	ТЗ.Колонки.Добавить("Количество");
	ТЗ.Колонки.Добавить("Сумма"); 
	ТЗ.Колонки.Добавить("ФизическоеЛицо"); 
	ТЗ.Колонки.Добавить("СчетЗабалансовогоУчета");
	ТЗ.Колонки.Добавить("Организация");
    ТЗ.Колонки.Добавить("ПогашеннаяСтоимостьОстаток");
	ТЗ.Колонки.Добавить("ДокументПередачи");
	ТЗ.Колонки.Добавить("СрокПолезногоИспользования");
	ТЗ.Колонки.Добавить("СтатьяРасходов");
	ТЗ.Колонки.Добавить("КатегорияЭксплуатации");
	ТЗ.Колонки.Добавить("ИнвентарныйНомер");  
	ТЗ.Колонки.Добавить("ПервоначальнаяСумма");
	ТЗ.Колонки.Добавить("ДатаПередачиВЭксплуатацию");
	ТЗ.Колонки.Добавить("Обработан");

	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр[0]) Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = Число(?(ПустаяСтрока(Стр[6]),0,СтрЗаменить(Стр[6], " ", "")));
		Если Количество <= 0 Тогда
			Продолжить;	
		КонецЕсли; 
		
		СчетЗабалансовогоУчетаКод = СокрЛП(Стр[17]); 
		Если ПустаяСтрока(СчетЗабалансовогоУчетаКод) Тогда
			Продолжить;	
		КонецЕсли; 
		Нов = ТЗ.Добавить();
		
		//Если найдено несколько, в строке будет значение Неопределено, переносим неопределенные с пустым счетом
		СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетЗабалансовогоУчетаКод);
		
		Если Не ЗначениеЗаполнено(СчетЗабалансовогоУчета) Тогда
			Сообщить("Забалансовый счет учета ТМЦ точно не определен: ");
			Сообщить(" - " + Стр[20]);	
		КонецЕсли;
		
		Нов.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[0]));
		Нов.Подразделение = Справочники.СтруктураПредприятия.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[1]));
		
		Нов.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[2]));
		
		Нов.ПогашеннаяСтоимостьОстаток = Число(?(ПустаяСтрока(Стр[8]), 0, СтрЗаменить(Стр[8], " ", "")));
		Нов.ДокументПередачи = Документы.ВнутреннееПотребление.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[9]));
		Нов.СрокПолезногоИспользования = Число(?(ПустаяСтрока(Стр[12]), 0, Стр[12]));
		СпособПогашенияСтоимостиСтр = Стр[13]; 		
		СчетУчетаКод = Стр[15];
		СчетПередачиБУКод = Стр[16];
	
		Нов.ФизическоеЛицо = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[5]));
		Нов.СтатьяРасходов = ТН_Интеграция_ERP_УХ.СтатьяРасходовПоКоду(Стр[14]);
		//Нов.АналитикаРасходов = Подразделение;
		Нов.ИнвентарныйНомер = Стр[10];
		Нов.ДатаПередачиВЭксплуатацию = ?(ПустаяСтрока(Стр[11]), Дата, Дата(Стр[11]));
		Нов.Количество = Количество;
		Нов.Сумма = Число(?(ПустаяСтрока(Стр[7]),0,СтрЗаменить(Стр[7], " ", "")));
		Если Нов.Сумма = 0 Тогда 
			Нов.Сумма = 0.01;
		КонецЕсли;	
		Нов.ПервоначальнаяСумма = Число(?(ПустаяСтрока(Стр[7]), 0, СтрЗаменить(Стр[7], " ", "")));
				
		//КатегорияЭксплуатации
		КатегорияЭксплуатации = Справочники.КатегорииЭксплуатации.ПустаяСсылка();
		Если ЗначениеЗаполнено(Нов.СтатьяРасходов) Тогда
			Если СпособПогашенияСтоимостиСтр = "Погашать стоимость при передаче в эксплуатацию" Тогда
				СпособПогашенияСтоимости = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПриПередаче; 
			Иначе
				СпособПогашенияСтоимости = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПоСроку; 
			КонецЕсли;
			СчетУчета = ПолучитьСоответствиеСчетаСчетуМЦ(СтруктураСоответствияСчетовСчетамМЦ, СчетУчетаКод, СчетЗабалансовогоУчетаКод);
			Нов.КатегорияЭксплуатации = ПолучитьКатегориюЭксплуатации(Нов.СтатьяРасходов,СпособПогашенияСтоимости,нов.СрокПолезногоИспользования,СчетУчета,СчетЗабалансовогоУчета);
   		КонецЕсли;
	Нов.Обработан = Ложь;	
	КонецЦикла;
	
	Возврат ТЗ;	
КонецФункции

