		об.СрокЭксплуатации = СрокЭксплуатации;
		об.СтатьяРасходов = СтатьяРасходов;
		об.СпособПогашенияСтоимостиБУ = СпособПогашенияСтоимости;
		об.СпособПогашенияСтоимостиНУ = СпособПогашенияСтоимости;
		// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
		//об.УдалитьСчетУчета = СчетУчета;
		//об.УдалитьСчетЗабалансовогоУчета = СчетЗабалансовогоУчета;
		Если ЭтоБазаПП Тогда
			об.ИмущественныйУчет = Истина;
			об.УчетПоФизЛицам = Истина;
		КонецЕсли;
		// КОНЕЦ  Белоконенко Денис 09.04.2024 Выполнение задач №000049171		
		
		об.Записать();
		КатегорииЭксплуатации = об.Ссылка; 
		//НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	    ЗаписатьНастройкуСчетаУчета (КатегорииЭксплуатации,СчетУчета,СчетЗабалансовогоУчета);	
		//КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		КонецЕсли;
		
	// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
	Если ЗначениеЗаполнено(КатегорииЭксплуатации) И 
		КатегорииЭксплуатации.СпособПогашенияСтоимостиБУ = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПриПередаче Тогда
		
		НаименованиеГруппы = "Для ввода начальных остатков";
		
		РодительДляВводаОстатков = Справочники.КатегорииЭксплуатации.НайтиПоНаименованию(НаименованиеГруппы, Истина); 
		
		Если РодительДляВводаОстатков.Пустая() Тогда
			РодительДляВводаОстатковОб = Справочники.КатегорииЭксплуатации.СоздатьГруппу();
			РодительДляВводаОстатковОб.Наименование = НаименованиеГруппы;
			РодительДляВводаОстатковОб.Записать();
			
			РодительДляВводаОстатков = РодительДляВводаОстатковОб.Ссылка;
		КонецЕсли;
		
		КатегорииЭксплуатацииДляВводаОстатка = Справочники.КатегорииЭксплуатации.НайтиПоНаименованию(
			КатегорииЭксплуатации.Наименование
			,,РодительДляВводаОстатков);
		
		Если КатегорииЭксплуатацииДляВводаОстатка.Пустая() Тогда
			КатегорииЭксплуатацииДляВводаОстаткаОб = КатегорииЭксплуатации.Скопировать();
			КатегорииЭксплуатацииДляВводаОстаткаОб.Наименование = КатегорииЭксплуатации.Наименование;
			КатегорииЭксплуатацииДляВводаОстаткаОб.СпособПогашенияСтоимостиБУ = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПоСроку;
			КатегорииЭксплуатацииДляВводаОстаткаОб.СпособПогашенияСтоимостиНУ = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПоСроку;
			КатегорииЭксплуатацииДляВводаОстаткаОб.Родитель = РодительДляВводаОстатков;  
			// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
			//КатегорииЭксплуатацииДляВводаОстаткаОб.УдалитьСчетУчета = СчетУчета;
			//КатегорииЭксплуатацииДляВводаОстаткаОб.УдалитьСчетЗабалансовогоУчета = СчетЗабалансовогоУчета; 
			// КОНЕЦ Белоконенко Денис 09.04.2024 Выполнение задач №000049171
			КатегорииЭксплуатацииДляВводаОстаткаОб.Записать(); 
			
			КатегорииЭксплуатацииДляВводаОстатка = КатегорииЭксплуатацииДляВводаОстаткаОб.Ссылка;
		// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
		//ИначеЕсли Не ЗначениеЗаполнено(КатегорииЭксплуатацииДляВводаОстатка.УдалитьСчетУчета) И
		//	Не ЗначениеЗаполнено(КатегорииЭксплуатацииДляВводаОстатка.УдалитьСчетЗабалансовогоУчета) Тогда
		//	КатегорииЭксплуатацииДляВводаОстаткаОб 									= КатегорииЭксплуатацииДляВводаОстатка.ПолучитьОбъект();
		//	КатегорииЭксплуатацииДляВводаОстаткаОб.УдалитьСчетУчета 				= СчетУчета;
		//	КатегорииЭксплуатацииДляВводаОстаткаОб.УдалитьСчетЗабалансовогоУчета 	= СчетЗабалансовогоУчета;
		//	
		//	КатегорииЭксплуатацииДляВводаОстаткаОб.Записать(); 
		// КОНЕЦ Белоконенко Денис 09.04.2024 Выполнение задач №000049171
		КонецЕсли; 
		
		КатегорииЭксплуатации = КатегорииЭксплуатацииДляВводаОстатка;
		
		Запрос1 = Новый Запрос;
		Запрос1.Текст = 	
		"ВЫБРАТЬ
		|	П.АналитикаУчета КАК АналитикаУчета,
		|	ВЫРАЗИТЬ(П.АналитикаУчета КАК Справочник.КатегорииЭксплуатации).СрокЭксплуатации КАК СрокЭксплуатации,
		|	ВЫРАЗИТЬ(П.АналитикаУчета КАК Справочник.КатегорииЭксплуатации).СтатьяРасходов КАК СтатьяРасходов
		|ИЗ
		|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК П
		|ГДЕ
		|	П.СчетУчета = &Счет
		|	И П.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ТМЦВЭксплуатации)"; 
		
	 	Запрос1.УстановитьПараметр("Счет", СчетУчета);
		МассивКатегорииЭксплуатации = Новый Массив; 
        Выборка1 = Запрос1.Выполнить().Выбрать();
		Пока Выборка1.Следующий() Цикл 
			Если Выборка1.СрокЭксплуатации = СрокЭксплуатации	
				И Выборка1.СтатьяРасходов = СтатьяРасходов Тогда
		    МассивКатегорииЭксплуатации.Добавить(Выборка1.АналитикаУчета);
			КонецЕсли; 
		КонецЦикла; 
		Если МассивКатегорииЭксплуатации.Найти(КатегорииЭксплуатации) = Неопределено Тогда
	        ЗаписатьНастройкуСчетаУчета(КатегорииЭксплуатации, СчетУчета, СчетЗабалансовогоУчета);	
		КонецЕсли;
		
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		
	Возврат КатегорииЭксплуатации;
	
КонецФункции 

// Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
&НаСервереБезКонтекста
Процедура ЗаписатьНастройкуСчетаУчета (КатегорииЭксплуатации,СчетУчета,СчетЗабалансовогоУчета)
