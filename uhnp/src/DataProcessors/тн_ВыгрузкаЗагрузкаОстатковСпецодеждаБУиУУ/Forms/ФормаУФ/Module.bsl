Функция ПолучитьКатегориюЭксплуатации(СтатьяРасходов, СпособПогашенияСтоимости, СрокЭксплуатации, СчетУчета, СчетЗабалансовогоУчета)
	
	КатегорииЭксплуатации = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СрокЭксплуатации", СрокЭксплуатации);
	Запрос.УстановитьПараметр("СтатьяРасходов", СтатьяРасходов);
	Запрос.УстановитьПараметр("СпособПогашенияСтоимости", СпособПогашенияСтоимости); //<--должно быть с 2021 г Списание на расходы в момент передачи в эксплуатацию
	Запрос.УстановитьПараметр("СчетЗабалансовогоУчета", СчетЗабалансовогоУчета);
	Запрос.Текст =  
	
	
	"ВЫБРАТЬ
	|	КатегорииЭксплуатации.Ссылка КАК Ссылка,  
	// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
	////НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	////|	КатегорииЭксплуатации.СчетУчета КАК СчетУчета,
	//|	КатегорииЭксплуатации.УдалитьСчетУчета КАК СчетУчета,
	////|	КатегорииЭксплуатации.СчетЗабалансовогоУчета КАК СчетЗабалансовогоУчета,
	//|	КатегорииЭксплуатации.УдалитьСчетЗабалансовогоУчета КАК СчетЗабалансовогоУчета,
	////КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650 
	// КОНЕЦ Белоконенко Денис 09.04.2024 Выполнение задач №000049171
	|	КатегорииЭксплуатации.СпособПогашенияСтоимостиНУ КАК СпособПогашенияСтоимостиНУ
	|ИЗ
	|	Справочник.КатегорииЭксплуатации КАК КатегорииЭксплуатации
	|ГДЕ
	|	КатегорииЭксплуатации.СрокЭксплуатации = &СрокЭксплуатации
	|	И КатегорииЭксплуатации.СтатьяРасходов = &СтатьяРасходов
	|	И КатегорииЭксплуатации.СпособПогашенияСтоимостиБУ = &СпособПогашенияСтоимости
	|	И НЕ КатегорииЭксплуатации.ПометкаУдаления
	// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
	////НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	////|	И КатегорииЭксплуатации.СчетЗабалансовогоУчета = &СчетЗабалансовогоУчета
	//|	И КатегорииЭксплуатации.УдалитьСчетЗабалансовогоУчета = &СчетЗабалансовогоУчета
	////КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650 
	// КОНЕЦ Белоконенко Денис 09.04.2024 Выполнение задач №000049171
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КатегорииЭксплуатации = Выборка.Ссылка;
		//Если ЗначениеЗаполнено(СчетУчета)
		//	И Не Выборка.СчетУчета = СчетУчета Тогда
		//	об = КатегорииЭксплуатации.ПолучитьОбъект();
		//	об.СчетУчета = СчетУчета;
		//	об.Записать();
		//КонецЕсли; 
		//НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		Запрос1 = Новый Запрос;
		Запрос1.Текст = 	
		"ВЫБРАТЬ
		| П.АналитикаУчета
		| ИЗ
		|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК П
		|ГДЕ
		|П.СчетУчета = &Счет И П.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ТМЦВЭксплуатации)
		|";
	 	Запрос1.УстановитьПараметр("Счет", СчетУчета);
		МассивКатегорииЭксплуатации = Новый Массив; 
        Выборка1 = Запрос1.Выполнить().Выбрать();
		Пока Выборка1.Следующий() Цикл 
			Если Выборка1.АналитикаУчета.СрокЭксплуатации = СрокЭксплуатации	
				И Выборка1.АналитикаУчета.СтатьяРасходов = СтатьяРасходов Тогда
		    МассивКатегорииЭксплуатации.Добавить(Выборка1.АналитикаУчета);
			КонецЕсли; 
		КонецЦикла; 
		Если МассивКатегорииЭксплуатации.Количество() = 0 Тогда
	        ЗаписатьНастройкуСчетаУчета (КатегорииЭксплуатации,СчетУчета,СчетЗабалансовогоУчета);	
		КонецЕсли;
		//КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	Иначе
		об = Справочники.КатегорииЭксплуатации.СоздатьЭлемент();
