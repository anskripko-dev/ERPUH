Функция ПолучитьСоответствиеСчетаСчетуМЦ(СтруктураСоответствияСчетовСчетамМЦ, СчетУчетаКод, СчетЗабалансовогоУчетаКод)
	
	СчетУчета = Неопределено;
	// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
	Если Лев(СчетЗабалансовогоУчетаКод, 2) = "МЦ" Тогда
	// КОНЕЦ  Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		//Счет забалансового учета приводится к формату без точки (т.к. в структуре нельзя хранить ключ с точкой)
		СчетЗУФорматированный = СокрЛП(СтрЗаменить(СчетЗабалансовогоУчетаКод, ".", ""));
	// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 11.09.2023 Выполнение задач №000046813
   //НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	Если  СчетЗабалансовогоУчетаКод = "015" тогда
		СчетЗУФорматированный = "М015" ;
	// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813	
	ИначеЕсли СчетЗабалансовогоУчетаКод = "10.11" тогда
		СчетЗУФорматированный = "МЦ02";
	// КОНЕЦ Белоконенко Денис 11.09.2023 Выполнение задач №000046813	
	КонецЕсли;
    //КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	СтруктураСоответствияСчетовСчетамМЦ.Свойство(СчетЗУФорматированный, СчетУчета); 
	
	Если СчетУчета = Неопределено Тогда
		СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетУчетаКод);
	КонецЕсли;
	
	Возврат СчетУчета;
	
КонецФункции

