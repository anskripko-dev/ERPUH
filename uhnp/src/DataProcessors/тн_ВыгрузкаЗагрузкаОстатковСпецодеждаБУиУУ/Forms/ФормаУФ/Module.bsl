 
 // НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
//&НаСервереБезКонтекста 
&НаСервере
// КОНЕЦ Белоконенко Денис 11.09.2023 Выполнение задач №000046813
Процедура ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	
	МассивДокументов = Новый Массив;
	ДокОбъект = Неопределено;
	ОрганизацияПред = Неопределено;
	ПодразделениеПред = Неопределено; 	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата(); 
	ТекущаяДата = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	Комментарий = "#Перенос остатков по спецодежде "+ТекущаяДата; 
	//НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	//СтруктураЗаполнения = Новый Структура("ТипОперации, Комментарий", Перечисления.ТипыОперацийВводаОстатков.ОстаткиТМЦВЭксплуатации, Комментарий); 
	СтруктураЗаполнения = Новый Структура("ХозяйственнаяОперация, Комментарий", Перечисления.ХозяйственныеОперации.ВводОстатковТМЦВЭксплуатации, Комментарий); 
	//КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
	СтруктураСоответствияСчетовСчетамМЦ = ПолучитьСтруктуруСоответствияСчетовСчетамМЦ();
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр[0]) Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = Число(?(ПустаяСтрока(Стр[6]),0,СтрЗаменить(Стр[6], " ", "")));
		Если Количество <= 0 Тогда
			Продолжить;	
		КонецЕсли; 
		
		СчетЗабалансовогоУчетаКод = СокрЛП(Стр[17]); 
		Если ПустаяСтрока(СчетЗабалансовогоУчетаКод) Тогда
			Продолжить;	
		КонецЕсли;
		
		// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		Если СчетЗабалансовогоУчетаКод = "10.11" Тогда
			СчетЗабалансовогоУчетаКод = "МЦ.02";
		КонецЕсли;
		// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		
		//Если найдено несколько, в строке будет значение Неопределено, переносим неопределенные с пустым счетом
		СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетЗабалансовогоУчетаКод);
		
		Если Не ЗначениеЗаполнено(СчетЗабалансовогоУчета) Тогда
			Сообщить("Забалансовый счет учета ТМЦ точно не определен: ");
			Сообщить(" - " + Стр[20]);	
		КонецЕсли;
		
		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[0]));
		Подразделение = Справочники.СтруктураПредприятия.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[1]));
		
		Если Организация <> ОрганизацияПред 
			ИЛИ Подразделение <> ПодразделениеПред
			ИЛИ (ДокОбъект <> Неопределено 
			И ДокОбъект.ТМЦВЭксплуатации.Количество() > 9999) Тогда
			Если ДокОбъект <> Неопределено Тогда
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				Исключение					
					ДокОбъект.ОбменДанными.Загрузка = Истина;
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
					ОбщегоНазначения.СообщитьПользователю("Ошибка записи документа " + ДокОбъект.Ссылка, ДокОбъект.Ссылка);
				КонецПопытки;
				МассивДокументов.Добавить(ДокОбъект.Ссылка);
			КонецЕсли; 
			
	        // Поиск уже имеющихся
			Запрос = Новый Запрос;
			Запрос.Текст = 
			// НАЧАЛО Белоконенко Денис 28.11.2023 Выполнение задач №000047632
				//"ВЫБРАТЬ
				//|	ВводОстатковТМЦВЭксплуатации.Ссылка.Ссылка КАК Ссылка
				//|ИЗ
				//|	Документ.ВводОстатков.ТМЦВЭксплуатации КАК ВводОстатковТМЦВЭксплуатации
				//|ГДЕ
				//|	ВводОстатковТМЦВЭксплуатации.Ссылка.Организация = &Организация
				//|	И НАЧАЛОПЕРИОДА(ВводОстатковТМЦВЭксплуатации.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
				//|	И ВводОстатковТМЦВЭксплуатации.Ссылка.Подразделение = &Подразделение";
				"ВЫБРАТЬ
				|	ВводОстатковТМЦВЭксплуатации.Ссылка.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.ВводОстатковТМЦВЭксплуатации КАК ВводОстатковТМЦВЭксплуатации
				|ГДЕ
				|	ВводОстатковТМЦВЭксплуатации.Ссылка.Организация = &Организация
				|	И НАЧАЛОПЕРИОДА(ВводОстатковТМЦВЭксплуатации.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
				|	И ВводОстатковТМЦВЭксплуатации.Ссылка.Подразделение = &Подразделение";
			// КОНЕЦ Белоконенко Денис 28.11.2023 Выполнение задач №000047632
			
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("Подразделение", Подразделение);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
            	ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ДокОбъект.ТМЦВЭксплуатации.Очистить(); 
			Иначе 
				// НАЧАЛО Белоконенко Денис 28.11.2023 Выполнение задач №000047632
				//ДокОбъект = Документы.ВводОстатков.СоздатьДокумент();
				ДокОбъект = Документы.ВводОстатковТМЦВЭксплуатации.СоздатьДокумент();
				// НАЧАЛО Белоконенко Денис 28.11.2023 Выполнение задач №000047632
			КонецЕсли;
			
			//ДокОбъект = Документы.ВводОстатков.СоздатьДокумент();
			ДокОбъект.Заполнить(СтруктураЗаполнения);
			ДокОбъект.Дата = Дата;
			ДокОбъект.Организация = Организация;
			ДокОбъект.Подразделение = Подразделение;
			ДокОбъект.ОтражатьВОперативномУчете = Истина;
			ДокОбъект.ОтражатьВБУиНУ = Истина;
		КонецЕсли;
		
		НовСтр = ДокОбъект.ТМЦВЭксплуатации.Добавить();
		
		НовСтр.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[2]));
		
		ПогашеннаяСтоимостьОстаток = Число(?(ПустаяСтрока(Стр[8]), 0, СтрЗаменить(Стр[8], " ", "")));
		ДокументПередачи = Документы.ВнутреннееПотребление.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[9]));
		СрокПолезногоИспользования = Число(?(ПустаяСтрока(Стр[12]), 0, Стр[12]));
		СпособПогашенияСтоимостиСтр = Стр[13]; 		
		СчетУчетаКод = Стр[15];
		СчетПередачиБУКод = Стр[16];
	
	    //НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		Если НЕ ЗначениеЗаполнено(НовСтр.Номенклатура) ИЛИ СтрНайти(Строка(НовСтр.Номенклатура),"Объект не найден",НаправлениеПоиска.СНачала,1,1) > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Не найдена номенклатура "+стр.НоменклатураНаименование)
		Иначе
			Если НЕ ЗначениеЗаполнено(НовСтр.Номенклатура.ГруппаФинансовогоУчета) Тогда 
				ОбъектНоменклатура = НовСтр.Номенклатура.ПолучитьОбъект();
				ОбъектНоменклатура.ГруппаФинансовогоУчета = ПолучитьГруппуФинансовогоУчетаНоменклатуры(СчетУчетаКод);
				Если НЕ ЗначениеЗаполнено(ОбъектНоменклатура.Наименование) И ЗначениеЗаполнено(ОбъектНоменклатура.НаименованиеПолное) Тогда
					ОбъектНоменклатура.Наименование = ОбъектНоменклатура.НаименованиеПолное; 
				ИначеЕсли  НЕ ЗначениеЗаполнено(ОбъектНоменклатура.Наименование) И НЕ ЗначениеЗаполнено(ОбъектНоменклатура.НаименованиеПолное) Тогда
					ОбъектНоменклатура.Наименование = ОбъектНоменклатура.Код; 
				КонецЕсли;
				Попытка
				ОбъектНоменклатура.Записать();
				Исключение
				КонецПопытки;
				
			КонецЕсли;	
		КонецЕсли;	
	    //КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		НовСтр.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[3]));
		// НАЧАЛО Белоконенко Денис 10.04.2025 Выполнение задач №000053370
		//НовСтр.ФизическоеЛицо = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр[5]));
		НовСтр.ФизическоеЛицо = Справочники.ФизическиеЛица.ПолучитьФизЛицоСсылка(Стр.ФизЛицоЕКС);
		// КОНЕЦ Белоконенко Денис 10.04.2025 Выполнение задач №000053370  
		// НАЧАЛО Белоконенко Денис 24.06.2025 Выполнение задач №000054201
		Если Не ЗначениеЗаполнено(НовСтр.ФизическоеЛицо) Тогда  
			Попытка
				НовСтр.ФизическоеЛицо = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ФизЛицо)); 
			Исключение
				НовСтр.ФизическоеЛицо = Справочники.ФизическиеЛица.ПустаяСсылка();
			КонецПопытки;
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 24.06.2025 Выполнение задач №000054201
	    //НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		Если НЕ ЗначениеЗаполнено(НовСтр.ФизическоеЛицо) ИЛИ СтрНайти(Строка(НовСтр.ФизическоеЛицо),"Объект не найден",НаправлениеПоиска.СНачала,1,1) > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Не найдено физическое лицо "+стр.ФизЛицоНаименование)
		КонецЕсли;	
	    //КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
		НовСтр.СтатьяРасходов = ТН_Интеграция_ERP_УХ.СтатьяРасходовПоКоду(Стр[14]);
		НовСтр.АналитикаРасходов = Подразделение;
		НовСтр.ИнвентарныйНомер = Стр[10];
		НовСтр.ДатаНачалаЭксплуатации = ?(ПустаяСтрока(Стр[11]), Дата, Дата(Стр[11]));
		НовСтр.Количество = Количество;
		НовСтр.Сумма = Число(?(ПустаяСтрока(Стр[7]),0,СтрЗаменить(Стр[7], " ", "")));
		// НАЧАЛО Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		//НовСтр.ПервоначальнаяСумма = Число(?(ПустаяСтрока(Стр[7]), 0, СтрЗаменить(Стр[7], " ", "")));
		НовСтр.ПервоначальнаяСумма = Число(?(ПустаяСтрока(Стр[22]), 0, СтрЗаменить(Стр[22], " ", "")));
		Если НовСтр.ПервоначальнаяСумма = 0 Тогда
			НовСтр.ПервоначальнаяСумма = 0.01;	
		КонецЕсли;
		// НАЧАЛО Белоконенко Денис 28.11.2023 Выполнение задач №000047632
		НовСтр.ПервоначальнаяСуммаУпр = НовСтр.ПервоначальнаяСумма;
		// КОНЕЦ Белоконенко Денис 28.11.2023 Выполнение задач №000047632
		
		НовСтр.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		
		Если Не ЗначениеЗаполнено(ДокОбъект.Подразделение) И Не ЗначениеЗаполнено(НовСтр.СтатьяРасходов) Тогда
			НовСтр.СтатьяРасходов = СтатьяРасходов;		
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 11.09.2023 Выполнение задач №000046813
		
		//КатегорияЭксплуатации
		КатегорияЭксплуатации = Справочники.КатегорииЭксплуатации.ПустаяСсылка();
		Если ЗначениеЗаполнено(НовСтр.СтатьяРасходов) Тогда
			Если СпособПогашенияСтоимостиСтр = "Погашать стоимость при передаче в эксплуатацию" Тогда
				СпособПогашенияСтоимости = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПриПередаче; 
			Иначе
				СпособПогашенияСтоимости = Перечисления.СпособыПогашенияСтоимостиТМЦ.ПоСроку; 
			КонецЕсли;
			СчетУчета = ПолучитьСоответствиеСчетаСчетуМЦ(СтруктураСоответствияСчетовСчетамМЦ, СчетУчетаКод, СчетЗабалансовогоУчетаКод);
			НовСтр.КатегорияЭксплуатации = ПолучитьКатегориюЭксплуатации(НовСтр.СтатьяРасходов,СпособПогашенияСтоимости,СрокПолезногоИспользования,СчетУчета,СчетЗабалансовогоУчета);
			// НАЧАЛО Белоконенко Денис 09.04.2024 Выполнение задач №000049171
			////НАЧАЛО Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
			////Если Не ЗначениеЗаполнено(НовСтр.КатегорияЭксплуатации.СчетЗабалансовогоУчета) Тогда
			//Если Не ЗначениеЗаполнено(НовСтр.КатегорияЭксплуатации.УдалитьСчетЗабалансовогоУчета) Тогда
			////КОНЕЦ Шабалкина Е.В. 08.03.2022 Выполнение задач №000041650
			//	Сообщить("Не заполнено счет забалансового учета для ТМЦ: " + НовСтр.Номенклатура);
			//КонецЕсли; 
			// КОНЕЦ Белоконенко Денис 09.04.2024 Выполнение задач №000049171
		КонецЕсли;
		
		ОрганизацияПред = Организация;
		ПодразделениеПред = Подразделение;
	КонецЦикла;
	
	Если ДокОбъект <> Неопределено 
		И ДокОбъект.ТМЦВЭксплуатации.Количество() > 0 Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		МассивДокументов.Добавить(ДокОбъект.Ссылка);
	КонецЕсли;
	
	Для Каждого ДокСсылка Из МассивДокументов Цикл
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Попытка
			//ДокОбъект.ОбменДанными.Загрузка = Ложь;
			ОбщегоНазначения.СообщитьПользователю(ДокСсылка, ДокСсылка);
			Если ДокОбъект.ПроверитьЗаполнение() Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокСсылка, ДокСсылка);
		КонецПопытки;
	КонецЦикла;
		
	УдалитьФайлы(ВремИмяФайла);	
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + МассивДокументов.Количество());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьГруппуФинансовогоУчетаНоменклатуры(СчетУчетаКод)
  гфун = Справочники.ГруппыФинансовогоУчетаНоменклатуры.ПустаяСсылка();
  Если СчетУчетаКод = "10.05" Тогда
	 гфун = Справочники.ГруппыФинансовогоУчетаНоменклатуры.НайтиПоНаименованию("запчасти (10.05)");
  ИначеЕсли СчетУчетаКод = "10.06" Тогда
	 гфун = Справочники.ГруппыФинансовогоУчетаНоменклатуры.НайтиПоНаименованию("прочие материалы (10.06 сч.)");
  ИначеЕсли СчетУчетаКод = "10.04" Тогда
