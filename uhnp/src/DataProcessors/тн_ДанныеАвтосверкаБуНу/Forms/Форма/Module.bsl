#Область РасшифровкаСКД

&НаКлиенте
Процедура РезультатТДОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначениеРасшифровки(Расшифровка, Элемент.ТекущаяОбласть.Текст, "ДанныеРасшифровки_ERP_УПП");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗначениеРасшифровки(Расшифровка, ТекстовоеЗначениеПоля, ИмяРеквизитаДанныхРасшифровки = Неопределено)
	ЗначениеРасшифровки = ПолучитьЗначениеРасшифровки(Расшифровка, ТекстовоеЗначениеПоля, ИмяРеквизитаДанныхРасшифровки);
	Если ЗначениеРасшифровки <> Неопределено Тогда
		ПоказатьЗначение(,ЗначениеРасшифровки);		
	КонецЕсли	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки)
	СсылкаРасшифровки = Неопределено;
	
	Если РеквизитРасшифровки = Неопределено Тогда

		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_УПП) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_УПП");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;

	Иначе
		СсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки);	
	КонецЕсли;
	
	Возврат СсылкаРасшифровки;
КонецФункции

&НаСервере
Функция ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки)
	СсылкаРасшифровки = Неопределено;
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(Объект[РеквизитРасшифровки]);
	Если Число(Расшифровка) <= ДанныеРасшифровки.Элементы.Количество() - 1 
		И ТипЗнч(ДанныеРасшифровки.Элементы[Расшифровка]) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля")
		И ДанныеРасшифровки.Элементы[Расшифровка].ОсновноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		
		МассивЗначений = ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля();
		Если МассивЗначений.Количество() > 0 И Строка(МассивЗначений[0].Значение) = ТекстПоляРасшифровки Тогда
			СсылкаРасшифровки = МассивЗначений[0].Значение;		
		КонецЕсли;
	КонецЕсли; 
	
	Возврат СсылкаРасшифровки;
КонецФункции

#КонецОбласти

#Область ВспомогательныеПроцедурыФункции       

&НаКлиенте
Функция ПроверитьЗаполненностьРеквизитов()
	
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("РезультатПроверки", Истина);
	СтруктураПроверки.Вставить("СообщениеПользователю", "");
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда 		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Заполните поле Организация" + Символы.ПС;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ЕстьКлючМаршрутизации = ЗначениеЗаполнено(ВернутьКлючМаршрутизацииОтправкиПоОрганизации(Объект.Организация));
		
		Если Не ЕстьКлючМаршрутизации Тогда
			СтруктураПроверки.РезультатПроверки	= Ложь;
			СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Не найден ИД-базы по организации в справочнике ""ИД Баз-респондентов""" + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодСверки.ДатаНачала) Тогда 		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Заполните дату начала" + Символы.ПС;
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(ПериодСверки.ДатаОкончания) Тогда 		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Заполните дату окончания" + Символы.ПС;
	КонецЕсли;
	
	ОграничениеМесяцев = 1;
	КолСекунд = 1;
	
	МаксДатаСверки = ДобавитьМесяц(ПериодСверки.ДатаНачала, ОграничениеМесяцев) - КолСекунд;
	Если МаксДатаСверки < ПериодСверки.ДатаОкончания Тогда

		СтруктураПроверки.РезультатПроверки	= Ложь;				
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Максимально возможное количество месяцев сверки: " + ОграничениеМесяцев + Символы.ПС;
	КонецЕсли;
	
	МассивОтбораПоСчетам 	= ПолучитьМассивОтбораПоСчетамНаСервере(); 
	
	Если МассивОтбораПоСчетам.Количество() = 0 Тогда
		СтруктураПроверки.РезультатПроверки	= Ложь;				
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Отбор по счетам не может быть пустым" + Символы.ПС;		
	КонецЕсли;
	
	Возврат СтруктураПроверки;
КонецФункции 

&НаКлиенте
Процедура ПриЗавершенииОбработкиОтветногоСообщения(Результат, ДополнительныеПараметры) Экспорт
	
	//1. Отменено пользователем
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//2. Возникла ошибка
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;	
	КонецЕсли;
	
	ЗаданиеВыполнено = (Результат.Статус = "Выполнено");
		
	//3. Обрабатываем результат
	Если ЗаданиеВыполнено Тогда
		
		СтруктураРезультат = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		Объект.СообщениеОтветERP_От_УПП = СтруктураРезультат.Результат;
		
		ОбработатьОтветОтУППНаСервере();
		
		ЭтотОбъект.ТекущийЭлемент = Элементы.ГруппаРезультатСтраница;
	
     КонецЕсли;
   	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРеквизитыОбъектаИзРезультата(АдресРезультата)
	 
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.РезультатТД = Результат.РезультатТД;
	 
КонецФункции

&НаСервере
Функция ПолучитьДлительнуюОперациюОжиданияПодготовкиРезультатаОтчета(ПараметрыСтруктура)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", Объект.НормативноеВремяОжиданияОтветаСекунд);
	ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
	ПараметрыВыполнения.Вставить("СтруктураДанныхОбработки", ПараметрыСтруктура.СтруктураДанныхОбработки);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработка.тн_ДанныеАвтосверкаБуНу.МодульОбъекта.СформироватьСтруктуруОбработкаОтветаНаЗапрос", ПараметрыВыполнения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ВернутьКлючМаршрутизацииОтправкиПоОрганизации(Организация)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ИДБазРеспондентовСтруктураКомпании.Ссылка КАК Ссылка,
		|	тн_ИДБазРеспондентовСтруктураКомпании.Ссылка.systemSender КАК systemSender
		|ИЗ
		|	Справочник.тн_ИДБазРеспондентов.СтруктураКомпании КАК тн_ИДБазРеспондентовСтруктураКомпании
		|ГДЕ
		|	тн_ИДБазРеспондентовСтруктураКомпании.Организация = &Организация
		|	И НЕ тн_ИДБазРеспондентовСтруктураКомпании.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.systemSender;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИдентификаторЗапросаДанныхСервер()
	
	Возврат Обработки.тн_ДанныеАвтосверкаБуНу.ПолучитьИдентификаторЗапросаДанных();
	
КонецФункции

&НаСервере
Процедура СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.СообщениеЗапросERP_В_УПП = ОбработкаОбъект.СформироватьТекстСообщенияЗапросДанных(ПараметрыСтруктура);	
	ОбработкаОбъект.ЭтоОтладка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСтруктура, "ЭтоОтладка", Ложь);
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Функция ОтправитьСообщениеЗапросСервер(ПараметрыСтруктура)
	
	Объект.РезультатТД.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ОтправитьСообщениеЗапрос(ПараметрыСтруктура);
	
КонецФункции

&НаСервере
Процедура ПроставитьАктивностьПоВидуУчета()
	
	Если ВидУчета = 1 Тогда
		Объект.Активно_БУ = Истина;
		Объект.Активно_НУ = Ложь;
	ИначеЕсли ВидУчета = 2 Тогда
		Объект.Активно_БУ = Ложь;
		Объект.Активно_НУ = Истина;
	Иначе
		Объект.Активно_БУ = Ложь;
		Объект.Активно_НУ = Ложь;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновкуДанных()
	СКД 				= РеквизитФормыВЗначение("Объект").ПолучитьМакет("ERP_СчетОтбор");
	АдресСхемы 			= ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор());
	ИсточникНастроек 	= Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	Объект.КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	Объект.КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
КонецПроцедуры

&НаСервере
Процедура ДозаполнитьЭлементыФормы()
	
	Если Не Объект.Активно_БУ И Не Объект.Активно_НУ Тогда
		ВидУчета = 1;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ДобавитьЗаписьДанныеАвтосверка(ПараметрыСтруктура);
	
КонецФункции

&НаСервере
Функция ПолучитьДлительнуюОперациюОжиданияОбработкиОтветногоСообщения(ПараметрыСтруктура)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", Объект.НормативноеВремяОжиданияОтветаСекунд);
	ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
	ПараметрыВыполнения.Вставить("ПоДокументам", Ложь);
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработки.тн_ДанныеАвтосверкаБуНу.ПолучитьСтруктуруРезультат", ПараметрыВыполнения);
	
КонецФункции

