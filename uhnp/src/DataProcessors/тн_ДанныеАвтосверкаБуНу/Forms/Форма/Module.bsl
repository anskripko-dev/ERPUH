&НаСервереБезКонтекста
Функция ПолучитьГоловнуюОрганизацию(ДатаСверкиНач, Организация)
	
	ГоловнаяОрганизация = Справочники.Организации.ПустаяСсылка(); 
	
	Если ЗначениеЗаполнено(Организация)
		И ЗначениеЗаполнено(ДатаСверкиНач) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения КАК ДатаНачалаВыгрузкиКакОбособленногоПодразделения,
		|	1 КАК Приоритет
		|ПОМЕСТИТЬ вт_ДанныеГоловнойОрганизации
		|ИЗ
		|	РегистрСведений.тн_НастройкиЗагрузкиДанныхВЕРП КАК тн_НастройкиЗагрузкиДанныхВЕРП
		|ГДЕ
		|	тн_НастройкиЗагрузкиДанныхВЕРП.Организация = &Организация
		|	И тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> &ПустаяДата
		|	И тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= &ДатаСверкиНач
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация,
		|	МИНИМУМ(тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения),
		|	2
		|ИЗ
		|	РегистрСведений.тн_НастройкиЗагрузкиДанныхВЕРП КАК тн_НастройкиЗагрузкиДанныхВЕРП
		|ГДЕ
		|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация = &Организация
		|	И тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> &ПустаяДата
		|
		|СГРУППИРОВАТЬ ПО
		|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация
		|
		|ИМЕЮЩИЕ
		|	МИНИМУМ(тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения) <= &ДатаСверкиНач
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ДанныеГоловнойОрганизации.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	МИНИМУМ(вт_ДанныеГоловнойОрганизации.Приоритет) КАК Приоритет
		|ИЗ
		|	вт_ДанныеГоловнойОрганизации КАК вт_ДанныеГоловнойОрганизации
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ДанныеГоловнойОрганизации.ГоловнаяОрганизация";
		
		Запрос.УстановитьПараметр("ДатаСверкиНач", ДатаСверкиНач);  
		Запрос.УстановитьПараметр("Организация",  Организация);
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1)); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			ГоловнаяОрганизация = Выборка.ГоловнаяОрганизация; 
		КонецЕсли;
	КонецЕсли;
	
	Возврат ГоловнаяОрганизация;
	
КонецФункции

#КонецОбласти   
