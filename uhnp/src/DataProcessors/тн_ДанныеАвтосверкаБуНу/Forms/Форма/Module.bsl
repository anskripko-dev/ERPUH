#Область Команды_Формы
 
&НаКлиенте
Процедура ПровестиСверку(Команда)
	
	// Проверка реквизитов
    СтруктураПроверки = ПроверитьЗаполненностьРеквизитов();
	Если Не СтруктураПроверки.РезультатПроверки Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураПроверки.СообщениеПользователю);
		Возврат;
	КонецЕсли;
	
	//1. Формируем и отправляем сообщение-запрос	
	ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанныхСервер();
	
	ПараметрыСтруктура = Новый Структура();
	ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
	ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);	
	ПараметрыСтруктура.Вставить("КлючМаршрутизации", ВернутьКлючМаршрутизацииОтправкиПоОрганизации(Объект.Организация));
	ПараметрыСтруктура.Вставить("ДатаСверкиНач", ПериодСверки.ДатаНачала);
	ПараметрыСтруктура.Вставить("ДатаСверкиКон", ПериодСверки.ДатаОкончания);
		
	СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура);
			
	Если ОтправитьСообщениеЗапросСервер(ПараметрыСтруктура) Тогда
		
		ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура);
		//2. Ожидаем ответа
		
		ДлительнаяОперация = ПолучитьДлительнуюОперациюОжиданияОбработкиОтветногоСообщения(ПараметрыСтруктура);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиОтветногоСообщения", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	КонецЕсли; 
	
КонецПроцедуры

