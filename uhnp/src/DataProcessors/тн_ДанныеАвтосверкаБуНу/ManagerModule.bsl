
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьСтруктуруРезультат(ПараметрыФормирования) Экспорт
	
	ДатаНачалаОжидания = ТекущаяДатаСеанса();
	ИнтервалПроверкиСекунд = 3;
	НормативноеВремяОжиданияОтветаСекунд_ПоУмолчанию = 900;
	
	ИдентификаторЗапроса 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "ИдентификаторЗапроса");
	ПоДокументам 			= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "ПоДокументам");
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанных();
	КонецЕсли;	
	
	НормативноеВремяОжиданияОтветаСекунд = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормирования, "НормативноеВремяОжиданияОтветаСекунд", НормативноеВремяОжиданияОтветаСекунд_ПоУмолчанию);
	ДатаЗавершенияОжидания = ДатаНачалаОжидания + НормативноеВремяОжиданияОтветаСекунд;
	
	СтруктураПолученияРезультата = Новый Структура("ИдентификаторЗапроса, ПоДокументам", ИдентификаторЗапроса, ПоДокументам);
		
	ОтветНаЗапрос = Неопределено;
	Пока Истина Цикл
		
		Если ТекущаяДатаСеанса() > ДатаЗавершенияОжидания Тогда
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Статус", "Ошибка");
			РезультатВыполнения.Вставить("КраткоеПредставлениеОшибки", "Превышено время ожидания ответного сообщения");
			ВызватьИсключение "Превышено время ожидания ответного сообщения";
		КонецЕсли;
		ОбщегоНазначенияБТС.Пауза(ИнтервалПроверкиСекунд);
		РезультатВыполненияМенеджерЗаписи = РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.ПолучитьЗапись(СтруктураПолученияРезультата);
		Если РезультатВыполненияМенеджерЗаписи = Неопределено Тогда
			Продолжить;
		Иначе
			Если ЗначениеЗаполнено(РезультатВыполненияМенеджерЗаписи.ОтветНаЗапрос) Тогда
				СтруктураРезультат = Новый Структура();
				СтруктураРезультат.Вставить("ПоДокументам", ПоДокументам);
				СтруктураРезультат.Вставить("Результат", РезультатВыполненияМенеджерЗаписи.ОтветНаЗапрос);
				СтруктураРезультат.Вставить("ЕстьОшибки", РезультатВыполненияМенеджерЗаписи.ЕстьОшибки);
				СтруктураРезультат.Вставить("ТекстОшибки", РезультатВыполненияМенеджерЗаписи.ТекстОшибки);
				
				Возврат СтруктураРезультат;
			Иначе
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура;

КонецФункции

Функция ПолучитьИдентификаторЗапросаДанных() Экспорт
	
	Возврат Строка(Новый УникальныйИдентификатор());
	
КонецФункции

