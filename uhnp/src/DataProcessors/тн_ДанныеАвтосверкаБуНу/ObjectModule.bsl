Функция ДобавитьЗаписьДанныеАвтосверка(ПараметрыСтруктура) Экспорт
			
	ОтправкаЗапроса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСтруктура, "ОтправкаЗапроса", Ложь);
	
	СтруктураЗаписи = Новый Структура();
	Если ОтправкаЗапроса Тогда	
		СтруктураЗаписи.Вставить("ЗапросДанных", СообщениеЗапросERP_В_УПП);
	Иначе
		СтруктураЗаписи.Вставить("ОтветНаЗапрос", СообщениеОтветERP_От_УПП);
	КонецЕсли;	
	СтруктураЗаписи.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура["ИдентификаторЗапроса"]);
	СтруктураЗаписи.Вставить("ПоДокументам", Ложь);
	
	РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.ДобавитьОбновитьЗапись(СтруктураЗаписи);
	
КонецФункции

Функция ПолучитьТаблицуЗначенийПоМассивуСтруктур(МассивСтруктур, СтруктураТиповКолонок = Неопределено, ПоДокументам = Ложь)
	
	ТаблицаВозврат = Новый ТаблицаЗначений();
	
	Если СтруктураТиповКолонок = Неопределено Тогда
		Структура0 = МассивСтруктур[0];
		Для Каждого КлючЗначение Из Структура0 Цикл
			ТаблицаВозврат.Колонки.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
	Иначе
		Для Каждого КлючЗначение Из СтруктураТиповКолонок Цикл
			ТаблицаВозврат.Колонки.Добавить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(МассивСтруктур) Тогда
		Для Каждого Структура Из МассивСтруктур Цикл
			
			ЕстьКлючДокумента = Структура.Свойство("id_Document");
			
			Если ПоДокументам Тогда
				Если ЕстьКлючДокумента Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаВозврат.Добавить(), Структура);
				КонецЕсли;
			Иначе
				Если Не ЕстьКлючДокумента Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаВозврат.Добавить(), Структура);	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
			
	Возврат ТаблицаВозврат;
	
КонецФункции

Функция ПолучитьТаблицуРезультатПоТаблицамЗначений(ТаблицаИсточник, ТаблицаПриемник, РазделДанных) Экспорт
	
	ТаблицаИтог = Новый ТаблицаЗначений;
	
	Если РазделДанных = "БУ" Или РазделДанных = "НУ" Тогда
		
		ЗапросДанных = Новый Запрос();
		ЗапросДанных.Текст = ТекстЗапросаИтоговаяТаблицаБУ_НУ();
		
		ЗапросДанных.УстановитьПараметр("ТаблицаERP", ТаблицаИсточник);
		ЗапросДанных.УстановитьПараметр("ТаблицаУПП", ТаблицаПриемник);
		
	    // НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056622
		Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда 
			ЗапросДанных.УстановитьПараметр("Организация", Организация); 
		КонецЕсли;
		// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056622

		Результат = ЗапросДанных.Выполнить();
		ТаблицаИтог = Результат.Выгрузить();
		
		// Дозаполним данные
		СоответствияСчетовВерхнегоУровня = Новый Соответствие;
		Для Каждого Стр Из ТаблицаИтог Цикл
			
			ТекВерхнийУровень = СоответствияСчетовВерхнегоУровня.Получить(Стр.Счет);
			Если ТекВерхнийУровень = Неопределено Тогда
				Если ЗначениеЗаполнено(Стр.Счет) Тогда
					Стр.СчетВерхнийУровень = ПолучитьСчетВерхнегоУровняРекурсивно(Стр.Счет);
					СоответствияСчетовВерхнегоУровня.Вставить(Стр.Счет, Стр.СчетВерхнийУровень);
				Иначе
					Стр.СчетВерхнийУровень = ПланыСчетов.Хозрасчетный.ПустаяСсылка();
				КонецЕсли;
			Иначе
				Стр.СчетВерхнийУровень = ТекВерхнийУровень;
			КонецЕсли;
			
			Если Не РазвернутьДоСубсчета Тогда
				Стр.Счет = Стр.СчетВерхнийУровень;	
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.Организация) И ЗначениеЗаполнено(Стр.id_Organization) Тогда 
				Стр.Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.id_Organization));
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.Субконто1) И 
				ЗначениеЗаполнено(Стр.id_subconto1) И
				ЗначениеЗаполнено(Стр.type_subconto1) Тогда 
				
				Если Стр.УПП_AC_Dr_closing > 0 Тогда
					ЭтоОстатокДт = Истина;
				Иначе
					ЭтоОстатокДт = Ложь;
				КонецЕсли;
				
				Стр.Субконто1 = ПолучитьСубконтоСчетаПоИдентификатору(Стр.code_account, Стр.type_subconto1, Стр.id_subconto1, ЭтоОстатокДт); 

			КонецЕсли;			
			
		КонецЦикла;
		
		СтрокаПоказателей = ПолучитьСтрокуВсехПоказателей(",");
		
		ТаблицаИтог.Свернуть("Организация, РазделУчета, Счет, Субконто1", СтрокаПоказателей);
	КонецЕсли;
	
	Возврат ТаблицаИтог;
КонецФункции

