Функция ТекстЗапросаИтоговаяТаблицаБУ_НУ()
	
	// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056622 
	//Возврат  
	Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда   
		
	#Область Текст_запроса_для_филиалов	
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_СопоставлениеСчетовУчетаСУПП.СчетERP КАК СчетERP,
		|	тн_СопоставлениеСчетовУчетаСУПП.СчетУПП КАК СчетУПП,
		|	тн_СопоставлениеСчетовУчетаСУПП.ОтборДанныхЕРП КАК ОтборДанныхЕРП,
		|	тн_СопоставлениеСчетовУчетаСУПП.ПорядокСопоставленияПодразделения КАК ПорядокСопоставленияПодразделения,
		|	ЕСТЬNULL(ХозрасчетныйВидыСубконто1.ВидСубконто, НЕОПРЕДЕЛЕНО) КАК ВидСубконто1,
		|	ЕСТЬNULL(ХозрасчетныйВидыСубконто2.ВидСубконто, НЕОПРЕДЕЛЕНО) КАК ВидСубконто2,
		|	ЕСТЬNULL(ХозрасчетныйВидыСубконто3.ВидСубконто, НЕОПРЕДЕЛЕНО) КАК ВидСубконто3,
		|	тн_СопоставлениеСчетовУчетаСУПП.РазделУчета КАК РазделУчета
		|ПОМЕСТИТЬ ВТ_ТаблицаСчетов
		|ИЗ
		|	РегистрСведений.тн_СопоставлениеСчетовУчетаСУПП КАК тн_СопоставлениеСчетовУчетаСУПП
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто1
		|		ПО (ХозрасчетныйВидыСубконто1.НомерСтроки = 1)
		|			И тн_СопоставлениеСчетовУчетаСУПП.СчетERP = ХозрасчетныйВидыСубконто1.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто2
		|		ПО (ХозрасчетныйВидыСубконто2.НомерСтроки = 2)
		|			И тн_СопоставлениеСчетовУчетаСУПП.СчетERP = ХозрасчетныйВидыСубконто2.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто3
		|		ПО (ХозрасчетныйВидыСубконто3.НомерСтроки = 3)
		|			И тн_СопоставлениеСчетовУчетаСУПП.СчетERP = ХозрасчетныйВидыСубконто3.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтруктураПредприятия.Ссылка КАК Подразделение
		|ПОМЕСТИТЬ вт_ТаблицаПодразделений
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	СтруктураПредприятия.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				тн_СоответствиеОрганизацииОПиПодразделенияДляСверки.Подразделение КАК Подразделение
		|			ИЗ
		|				РегистрСведений.тн_СоответствиеОрганизацииОПиПодразделенияДляСверки КАК тн_СоответствиеОрганизацииОПиПодразделенияДляСверки
		|			ГДЕ
		|				тн_СоответствиеОрганизацииОПиПодразделенияДляСверки.Организация = &Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
