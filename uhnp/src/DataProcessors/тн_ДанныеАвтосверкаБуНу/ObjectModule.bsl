#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем ИмяОбъектаСохраненияНастроек Экспорт;	
	
#Область Формирование_И_ОбработкаСообщений

Функция ПолучитьОбъектXDTO_ЗапросДанных(СтруктураПараметров = Неопределено) Экспорт
	
	ЭтоИнтерактивныйЗапуск = Ложь;
	ИдентификаторФормы = Неопределено;
	
	Если Не СтруктураПараметров = Неопределено Тогда
		ИдентификаторФормы 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ИдентификаторФормы");
		ЭтоИнтерактивныйЗапуск 	= ЗначениеЗаполнено(ИдентификаторФормы);
		ИдентификаторЗапроса 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ИдентификаторЗапроса");
		
		ДатаСверкиНач 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ДатаСверкиНач", );
		ДатаСверкиКон 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ДатаСверкиКон");  
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		ИдентификаторЗапроса = Обработки.тн_ДанныеАвтосверкаБуНу.ПолучитьИдентификаторЗапросаДанных();
	КонецЕсли;	
	
	РеквизитОрганизация = "Организация";
	МассивСчетов = ПолучитьМассивОтбораПоСчетам();
	 	 		
	КонтейнерXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationRequest");
		
	МассивАктивныхРазделов = ПолучитьМассивАктивныхРазделов();
	Для Каждого АктивныйРаздел Из МассивАктивныхРазделов Цикл
		
		dataVerificationRequestSection = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationRequestSection");
		dataVerificationRequestSection["name"] = АктивныйРаздел;
		
		dataVerificationRequestSectionSetting = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationRequestSectionSetting");
		dataVerificationRequestSectionSetting["id"] = "" + Новый УникальныйИдентификатор();
		
		// Организация
		dataVerificationRequestSectionSettingData = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationRequestSectionSettingData");
		
		СписокДанных = dataVerificationRequestSectionSettingData.ПолучитьСписок("columnData");
		dataVerificationRequestSectionSettingData["columnName"] = РеквизитОрганизация;
		dataVerificationRequestSectionSettingData["selectionString"] = "" + Организация;
		
		СписокДанных.Добавить("" + ЭтотОбъект[РеквизитОрганизация].УникальныйИдентификатор());
		dataVerificationRequestSectionSetting["data"].Добавить(dataVerificationRequestSectionSettingData);
		
		// Счета 
		Если МассивСчетов.Количество() > 0 Тогда
			dataVerificationRequestSectionSettingData = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationRequestSectionSettingData");
			
			СписокДанных = dataVerificationRequestSectionSettingData.ПолучитьСписок("columnData");
			dataVerificationRequestSectionSettingData["columnName"] = "Счета";
			dataVerificationRequestSectionSettingData["selectionString"] = "Есть отбор по счетам";
			
			Для Каждого Счет Из МассивСчетов Цикл
				СписокДанных.Добавить(Счет);	
			КонецЦикла;     
			dataVerificationRequestSectionSetting["data"].Добавить(dataVerificationRequestSectionSettingData);
		КонецЕсли;
		
		dataVerificationRequestSection["settings"].Добавить(dataVerificationRequestSectionSetting);
				
		dataVerificationRequestSection["dateOfVerificationBegin"] 	= ДатаСверкиНач;
		dataVerificationRequestSection["dateOfVerificationEnd"] 	= ДатаСверкиКон;
				
		КонтейнерXDTO["dataVerificationRequestSections"].Добавить(dataVerificationRequestSection);
		
	КонецЦикла;
			
	КонтейнерXDTO["dateRequest"] = ТекущаяДатаСеанса();
	КонтейнерXDTO["idForm"] = ИдентификаторФормы;
	КонтейнерXDTO["idRequest"] = ИдентификаторЗапроса;
			
	Возврат КонтейнерXDTO;
	
КонецФункции

Функция СформироватьТекстСообщенияЗапросДанных(СтруктураПараметров = Неопределено) Экспорт
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(СтруктураПараметров);
	ИмяТипаЭлементаXDTO	 	= "headers";
	ЭлементКонтейнераXDTO 	= тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", ИмяТипаЭлементаXDTO);
	ОбъектXDTO_ЗапросДанных[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO;
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("КонтейнерXDTO", ОбъектXDTO_ЗапросДанных);
	ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_УПП").ДобавитьСистемныеПараметры(ПараметрыОтправки);
	
	ТекстСообщения = ОбщегоНазначения.ОбщийМодуль("тн_Интеграция").СериализоватьКонтейнерXDTO(ОбъектXDTO_ЗапросДанных, , "JSON");
	тн_Интеграция_УПП.ЗаменитьПредставлениеФорматов(ТекстСообщения);
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция СформироватьСтруктуруОбработкаОтветаНаЗапрос(СтруктураПараметров = Неопределено) Экспорт
	
	Если СтруктураПараметров <> Неопределено И ТипЗнч(СтруктураПараметров) = Тип("Структура") И СтруктураПараметров.Свойство("СтруктураДанныхОбработки") Тогда
		Для Каждого ПараметрСтруктуры Из СтруктураПараметров Цикл
			ЭтотОбъект[ПараметрСтруктуры.Ключ] = ПараметрСтруктуры.Значение;	
		КонецЦикла;
	КонецЕсли;
	
	ТекстСообщенияJSON = СтрЗаменить(СообщениеОтветERP_От_УПП, "#", "");
	
	СтруктураОтветногоСообщения = ПолучитьСтруктуруДанныхJSON(ТекстСообщенияJSON);
	
	ИдентификаторФормы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтветногоСообщения.value, "idForm");
	ЭтоИнтерактивныйЗапуск = ЗначениеЗаполнено(ИдентификаторФормы);
	
	Если ЭтоИнтерактивныйЗапуск Тогда
		РезультатТД.Очистить();
	КонецЕсли;
	
	ДанныеРасшифровки_ERP_УПП = "";
	МассивСчетов = ПолучитьМассивОтбораПоСчетамВИерархии();
	
	Если СтруктураОтветногоСообщения.value.success Тогда	
		Для Каждого СтруктураРаздел Из СтруктураОтветногоСообщения.value.dataVerificationResponseSections Цикл
			ИмяТекущегоРаздела = СтруктураРаздел.name;
			
			Для Каждого НастройкаЗапроса Из СтруктураРаздел.settings Цикл		
				ИдентификаторНастройки = НастройкаЗапроса.id;
				
				ДанныеОтвета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаЗапроса, "dataResponse");
				СтруктураТаблицПараметровОтвета = ПолучитьСтруктуруТаблицПараметровОтвета(ИмяТекущегоРаздела, ДанныеОтвета);
				
				Если ИмяТекущегоРаздела = "БУ" Тогда
					МакетКомпоновкиЗапросДанных = ПолучитьМакет("ERP_БУ");
				ИначеЕсли ИмяТекущегоРаздела = "НУ" Тогда
					МакетКомпоновкиЗапросДанных = ПолучитьМакет("ERP_НУ");
				КонецЕсли;
				
				Настройки = МакетКомпоновкиЗапросДанных.НастройкиПоУмолчанию;
				
				Если ЗначениеЗаполнено(Организация) Тогда
					// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056622
					Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда    
						КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, "ОрганизацияОтбор", ГоловнаяОрганизация, ВидСравненияКомпоновкиДанных.Равно);
					Иначе
					// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056622
						КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, "ОрганизацияОтбор", Организация, ВидСравненияКомпоновкиДанных.Равно);
					// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056622
					КонецЕсли;
					// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056622
					
				КонецЕсли;
				
				Если МассивСчетов.Количество() > 0 Тогда
					КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, "СчетОтбор", МассивСчетов, ВидСравненияКомпоновкиДанных.ВСписке);
				КонецЕсли;				
				
				СоответствиеПараметров = Новый Соответствие();					
				СоответствиеПараметров.Вставить("ДатаОстатковГраница", Новый Граница(ДатаСверкиКон, ВидГраницы.Включая));
				СоответствиеПараметров.Вставить("ДатаНачала", ДатаСверкиНач);
				
				КомпоновкаДанныхКлиентСервер.УстановитьКоллекциюПараметров(Настройки, СоответствиеПараметров);
				
				//*запрашиваем Остатки по аналитике в ERP
				ТаблицаERP = Новый ТаблицаЗначений();
					
				ПараметрыВыгрузитьРезультатСКД = КомпоновкаДанныхСервер.ПараметрыВыгрузитьРезультатСКД();
				ПараметрыВыгрузитьРезультатСКД.СхемаКомпоновки = МакетКомпоновкиЗапросДанных;
				ПараметрыВыгрузитьРезультатСКД.НастройкиКомпоновки = Настройки;
				
				ТаблицаERP = КомпоновкаДанныхСервер.ВыгрузитьРезультатСКД(ПараметрыВыгрузитьРезультатСКД);
				
				НастройкаЗапроса.Вставить("ТаблицаERP", ТаблицаERP);
				
				//*получаем отчет-сравнение
				ТаблицаУПП = СтруктураТаблицПараметровОтвета.ТаблицаОтвет;
				
				ТаблицаРезультат = ПолучитьТаблицуРезультатПоТаблицамЗначений(ТаблицаERP, ТаблицаУПП, ИмяТекущегоРаздела); 
				
				НастройкаЗапроса.Вставить("ТаблицаРезультат", ТаблицаРезультат);
	
			КонецЦикла; 
			
			//*собираем отчет-результат по разделу
			ТаблицаРезультатИтог = Неопределено; 
			
			Для Каждого НастройкаЗапроса Из СтруктураРаздел.settings Цикл
				Если НастройкаЗапроса.ТаблицаРезультат = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТаблицаРезультатИтог = Неопределено Тогда
					ТаблицаРезультатИтог = НастройкаЗапроса.ТаблицаРезультат;
					Продолжить;
				КонецЕсли;
				
				ТаблицаРезультатИтог = ОбъединитьТаблицыЗначений(ТаблицаРезультатИтог, НастройкаЗапроса.ТаблицаРезультат);
			КонецЦикла;
			
			СтруктураРаздел.Вставить("ТаблицаРезультатИтог", ТаблицаРезультатИтог);
						
			Если ИмяТекущегоРаздела = "БУ" Или
				ИмяТекущегоРаздела = "НУ" Тогда
				МакетСКД = ПолучитьМакет("ERP_БУ_НУ_Результат");
			КонецЕсли;
			
			РеквизитРасшифровки = "ДанныеРасшифровки_ERP_УПП";			
			
			ВнешниеНаборыДанных = Новый Структура();
			ВнешниеНаборыДанных.Вставить("ТаблицаРезультатИтог", СтруктураРаздел.ТаблицаРезультатИтог);
			
			РезультатПромежуточный = Новый ТабличныйДокумент;
			
			Настройки = МакетСКД.НастройкиПоУмолчанию; 
			
			ИзменитьНастройкиИтоговойТаблицыСКД(ИмяТекущегоРаздела, Настройки);

			ПолучитьРезультатПоМакетуСКД(МакетСКД, Настройки, ВнешниеНаборыДанных, Ложь, РезультатПромежуточный, РеквизитРасшифровки);
			
			РезультатТД.Вывести(РезультатПромежуточный);	
			
			// НАЧАЛО Юдина Екатерина 03.02.2026 Выполнение задач №000056622 
			РезультатТД.ФиксацияСверху = 6;
			РезультатТД.ФиксацияСлева = 1;   
			// КОНЕЦ Юдина Екатерина 03.02.2026 Выполнение задач №000056622
			
		КонецЦикла;
		
		
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Возникли ошибки на стороне УПП. Описание ошибки: " + 
		СтруктураОтветногоСообщения.value.errorMessage);
	КонецЕсли;	
	
	СтруктураОтветногоСообщения.Вставить("РезультатТД", РезультатТД);
	
	Возврат СтруктураОтветногоСообщения;
		
КонецФункции

Функция ОтправитьСообщениеЗапрос(СтруктураПараметров = Неопределено) Экспорт
	
	КлючМаршрутизации = "";
	
	Если Не СтруктураПараметров = Неопределено Тогда
		КлючМаршрутизации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "КлючМаршрутизации", "");
	КонецЕсли;
	
	ТекстЗапроса = СообщениеЗапросERP_В_УПП;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстЗапроса);
	
	ПараметрыОтправки = Новый Структура();
			
	// - транспорт (RabbitMQ)
	ПараметрыОтправки.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.ERP_УХ);
	ПараметрыОтправки.Вставить("ФорматСообщения"	, "JSON");
	ПараметрыОтправки.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	ПараметрыОтправки.Вставить("КлючМаршрутизации"	, КлючМаршрутизации);
	ПараметрыОтправки.Вставить("ИмяПакетаXDTO"		,"tn_integrationERP");
	ПараметрыОтправки.Вставить("УзелПланаОбмена"	, тн_Интеграция_ERP_УХ_ПовтИсп.ВернутьУзелОбмена_Каркас());
		
	// - логирование
	ПараметрыОтправки.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена);
	ПараметрыОтправки.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	ПараметрыОтправки.Вставить("КонтейнерXDTO"		, ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON));
	
	ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_УПП").ОтправитьПакет(ТекстЗапроса, ПараметрыОтправки, "dataVerificationRequest");

	Возврат Истина;
	
КонецФункции

Функция ПолучитьСтруктуруТаблицПараметровОтвета(ИмяРазделаСтрока, МассивСтруктурОтвет)
	
	СтруктураВозврат = Новый Структура();
	Если ИмяРазделаСтрока = "БУ" Или ИмяРазделаСтрока = "НУ" Тогда
		СтруктураТиповКолонок = Новый Структура();
		СтруктураТиповКолонок.Вставить("id_Organization", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
		СтруктураТиповКолонок.Вставить("code_account", Новый ОписаниеТипов("Строка"));
		СтруктураТиповКолонок.Вставить("id_subconto1", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
		СтруктураТиповКолонок.Вставить("type_subconto1", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
		СтруктураТиповКолонок.Вставить("name_subconto1", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));		
		СтруктураТиповКолонок.Вставить("AC_Dr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("AC_Cr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("AC_Dr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("AC_Cr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("AC_Dr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("AC_Cr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("quantity_Dr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("quantity_Cr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("quantity_Dr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("quantity_Cr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("quantity_Dr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("quantity_Cr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
		СтруктураТиповКолонок.Вставить("curr_Dr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("curr_Cr_start", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("curr_Dr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("curr_Cr_turnover", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("curr_Dr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
		СтруктураТиповКолонок.Вставить("curr_Cr_closing", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
					
	КонецЕсли;	
	
	СтруктураВозврат.Вставить("ТаблицаОтвет", ПолучитьТаблицуЗначенийПоМассивуСтруктур(МассивСтруктурОтвет, СтруктураТиповКолонок));
	
	Возврат СтруктураВозврат;
	
КонецФункции

