	Возврат ЗначениеСубконто;
	
КонецФункции

Функция ПолучитьСсылкуПоГУИД(Менеджер, сУИД)
	
	Если ЗначениеЗаполнено(сУИД) И сУИД <> "00000000-0000-0000-0000-000000000000" Тогда
		УИД = Новый УникальныйИдентификатор(сУИД); 
		Возврат Менеджер.ПолучитьСсылку(УИД);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ИзменитьНастройкиИтоговойТаблицыСКД(ИмяТекущегоРаздела, Настройки)
		
	Если Не ПоказательБУ Тогда
    	УдалитьПоляПоказателейИзНастроекСКД(Настройки, "AC");
	КонецЕсли;	
	
	Если Не ПоказательВал Или ИмяТекущегоРаздела = "НУ" Тогда
		УдалитьПоляПоказателейИзНастроекСКД(Настройки, "curr");
	КонецЕсли;
	
	Если Не ПоказательКол Тогда
    	УдалитьПоляПоказателейИзНастроекСКД(Настройки, "quantity");
	КонецЕсли;
	
	Если Не РазвернутьДоСубконто Тогда
	
		ЗначениеПоиска = Новый ПолеКомпоновкиДанных("Субконто1");
			
    	СписокГруппировок = КомпоновкаДанныхКлиентСервер.ПолучитьГруппировки(Настройки);
		Для Каждого Группировка Из СписокГруппировок Цикл
			Если Группировка.Значение.Использование Тогда
				ПоляГруппировки = Группировка.Значение.ПоляГруппировки;
				Для Каждого Элемент Из ПоляГруппировки.Элементы Цикл
					Если Элемент.Использование И Элемент.Поле = ЗначениеПоиска Тогда						 
						Элемент.Использование = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не РазвернутьДоСубсчета Тогда 
		ЗначениеПоиска = Новый ПолеКомпоновкиДанных("Счет");
		
    	СписокГруппировок = КомпоновкаДанныхКлиентСервер.ПолучитьГруппировки(Настройки);
		Для Каждого Группировка Из СписокГруппировок Цикл
			Если Группировка.Значение.Использование Тогда
				ПоляГруппировки = Группировка.Значение.ПоляГруппировки;
				Для Каждого Элемент Из ПоляГруппировки.Элементы Цикл
					Если Элемент.Использование И Элемент.Поле = ЗначениеПоиска Тогда
						Элемент.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли; 
	
	// Установим Отборы
	СписокГруппировок = КомпоновкаДанныхКлиентСервер.ПолучитьГруппировки(Настройки);
	Для Каждого Группировка Из СписокГруппировок Цикл
		Если Группировка.Значение.Использование Тогда
			
			ГруппаИли = КомпоновкаДанныхКлиентСервер.ДобавитьГруппуОтбора(
				Группировка.Значение.Отбор.Элементы,
				ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
				
			Если ТолькоРасхождения Тогда	
				Если ПоказательБУ Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "desc", "AC"); 
				КонецЕсли;	
				
				Если ПоказательВал И Не ИмяТекущегоРаздела = "НУ" Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "desc", "curr");
				КонецЕсли;
				
				Если ПоказательКол Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "desc", "quantity");
				КонецЕсли;
			Иначе
				Если ПоказательБУ Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "ERP", "AC");
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "УПП", "AC");
				КонецЕсли;	
				
				Если ПоказательВал И Не ИмяТекущегоРаздела = "НУ" Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "ERP", "curr");
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "УПП", "curr");
				КонецЕсли;
				
				Если ПоказательКол Тогда
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "ERP", "quantity");
					ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаИли, "УПП", "quantity");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры 

Процедура УдалитьПоляПоказателейИзНастроекСКД(Настройки, ИмяПоказателя)
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Dr_start");
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Cr_start");
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Dr_turnover");
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Cr_turnover");
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Dr_closing");
	МассивПолей.Добавить("ERP_" + ИмяПоказателя + "_Cr_closing");
	
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Dr_start");
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Cr_start");
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Dr_turnover");
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Cr_turnover");
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Dr_closing");
	МассивПолей.Добавить("УПП_" + ИмяПоказателя + "_Cr_closing"); 
	
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Dr_start");
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Cr_start");
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Dr_turnover");
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Cr_turnover");
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Dr_closing");
	МассивПолей.Добавить("desc_" + ИмяПоказателя + "_Cr_closing");		
	
	КомпоновкаДанныхСервер.УдалитьВыбранноеПолеИзВсехНастроекОтчета(Настройки, МассивПолей, Истина);
	
КонецПроцедуры

Процедура ДобавитьОтборНеРавноНулюПоПоказателям(ГруппаРасположения, УчетнаяГруппировка, ИмяПоказателя)
	
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Dr_start",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Cr_start",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Dr_turnover",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Cr_turnover",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Dr_closing",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ГруппаРасположения, УчетнаяГруппировка + "_" + ИмяПоказателя + "_Cr_closing",
		0, ВидСравненияКомпоновкиДанных.НеРавно);
	
КонецПроцедуры

