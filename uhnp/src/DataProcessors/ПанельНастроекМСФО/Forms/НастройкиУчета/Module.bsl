
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоУХ = ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом();
	ЭтоЕРПУХ = ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ();
	
	Если ЭтоУХ Тогда
		
		Элементы.ГруппаТрансляция.Заголовок = НСтр("ru = 'Трансляция и трансформация'");
		Элементы.СпособТрансляции.Видимость=Ложь;
		
	Иначе
		
		Элементы.ГруппаТрансляция.Заголовок = НСтр("ru = 'Трансляция'");
		Элементы.СпособТрансляции.Видимость=Истина;
		
	КонецЕсли;
	
	СсылкаРБП 		= ВстраиваниеУХКлиентСервер.ПолучитьПустуюСсылкуРБП();
	МетаданныеРБП 	= Метаданные.НайтиПоТипу(ТипЗнч(СсылкаРБП));
	
	Элементы.Открыть_РасходыБудущихПериодов.Заголовок = МетаданныеРБП.Представление();
	ФормаСпискаРБП = МетаданныеРБП.ПолноеИмя() + ".ФормаСписка";
	
	Если Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") = Неопределено Тогда
		Элементы.ОткрытьТК_ПланСчетовРСБУ.Видимость = Ложь;
		Элементы.АлгоритмНачисленияАмортизацииАналогичноРСБУ.Заголовок
			= НСтр("ru = 'Алгоритм начисления амортизации по месяцам 
			|(начисление начинается со следующего месяца после ввода в эксплуатацию)'");
	КонецЕсли;
	
	Если Метаданные.Обработки.Найти("НастройкиФормированияПроводокПоДокументам")=Неопределено Тогда
		Элементы.ОткрытьТК_НастройкиФормированияПроводокПоДокументам.Видимость = Ложь;
	КонецЕсли;

	Элементы.ПереходМФУ.Видимость = ЭтоЕРПУХ;
	Элементы.ВалютаУправленческогоУчета.Видимость = Не ЭтоЕРПУХ;

КонецПроцедуры

