
&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", Объект.ДатаНач, Объект.ДатаКон);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
		
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора,, , , , ОписаниеОповещения);
	Возврат;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНач=РезультатВыбора.НачалоПериода;
	Объект.ДатаКон=РезультатВыбора.КонецПериода;
	
	ОбновитьДанныеНаСервере();
		
КонецПроцедуры 

&НаСервере
Процедура ПроверитьОтобразитьДатуЗакрытияПериода()
	
	ДанныеЗакрытияПериода=УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(Объект.Организация);
	ТекстЗакрытияПериода=НСтр("ru = 'Дата запрета формирования проводок '");
	
	Если НЕ ЗначениеЗаполнено(ДанныеЗакрытияПериода.ДатаЗакрытияПериода) Тогда
		
		ТекстЗакрытияПериода=ТекстЗакрытияПериода+НСтр("ru = 'не установлена.'");
		
	Иначе
		
		ТекстЗакрытияПериода=ТекстЗакрытияПериода+Формат(ДанныеЗакрытияПериода.ДатаЗакрытияПериода,"ДЛФ=DD");
		
	КонецЕсли;
	
	Элементы.ДекорацияДатаЗакрытияПериода.Заголовок=ТекстЗакрытияПериода;
		
	
КонецПроцедуры // ПроверитьОтобразитьДатуЗакрытияПериода()  

&НаСервере
Функция ПолучитьМассивДокументовКОбработке()
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент
	             |ИЗ
	             |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |ГДЕ
	             |	&ПараметрДата
	             |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)
	             |	И &Параметр2
				 |	И &Параметр3"; 

	ТекстОтбораПоДате=ПолучитьТекстОтбораПоДате();
	
	Если ЗначениеЗаполнено(Объект.ДатаНач) И ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" МЕЖДУ &ДатаНач И &ДатаКон");
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНач) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" >=&ДатаНач");
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" <=&ДатаКон");
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата","ИСТИНА");
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр2","ОтражениеДокументовПоШаблонам.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация",Объект.Организация); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр2","ИСТИНА");
		
	КонецЕсли; 
		
	Если ЗначениеЗаполнено(Объект.ПланСчетов) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр3","ОтражениеДокументовПоШаблонам.УчетнаяПолитика.ПланСчетовУчета = &ПланСчетов");
		Запрос.УстановитьПараметр("ПланСчетов",Объект.ПланСчетов); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр3","ИСТИНА");
		
	КонецЕсли;
	
	Запрос.Текст=ТекстЗапроса;
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИсходныйДокумент");
	
КонецФункции // ПолучитьМассивДокументовКОбработке()

&НаСервере
Функция ПолучитьДанныеОбработкиДокументов()
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	             |	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент,
	             |	ОтражениеДокументовПоШаблонам.Организация КАК Организация,
	             |	ОтражениеДокументовПоШаблонам.Сценарий КАК Сценарий,
	             |	ОтражениеДокументовПоШаблонам.УчетнаяПолитика.ПланСчетовУчета КАК ПланСчетовУчета,
	             |	ОтражениеДокументовПоШаблонам.ОбработкаВыполнена КАК ОбработкаВыполнена,
	             |	ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием КАК ОтражениеФоновымЗаданием
	             |ПОМЕСТИТЬ ОтражениеДокументовПоШаблонам
	             |ИЗ
	             |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |ГДЕ
	             |	&ПараметрДата
	             |	И &ПараметрОрганизация
	             |	И &ПараметрПланСчетов
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ДокументыНеОтражаемыеПоШаблонам.Документ КАК Документ
	             |ПОМЕСТИТЬ ДокументыНеОтражаемыеПоШаблонам
	             |ИЗ
	             |	РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |ГДЕ
	             |	ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтражениеДокументовПоШаблонам.ИсходныйДокумент) КАК КоличествоДокументов
	             |ИЗ
	             |	ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |ГДЕ
	             |	ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.Документ, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	             |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтражениеДокументовПоШаблонам.ИсходныйДокумент) КАК КоличествоДокументов
	             |ИЗ
	             |	ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |ГДЕ
	             |	ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.Документ, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	             |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)
	             |	И ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтражениеДокументовПоШаблонам.ИсходныйДокумент) КАК КоличествоДокументов
	             |ИЗ
	             |	ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |ГДЕ
	             |	ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.Документ, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	             |	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)
	             |	И НЕ ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОтражениеДокументовПоШаблонам.ИсходныйДокумент) КАК КоличествоДокументов
	             |ИЗ
	             |	ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	             |		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыДляПовторнойТрансляции.ДокументТрансляции) КАК КоличествоДокументов
	             |ИЗ
	             |	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	             |ГДЕ
	             |	&Параметр_ДатаДокумента
	             |	И &Параметр_ОрганизацияДокумента
	             |	И &Параметр_ПланСчетов";
	
	ТекстОтбораПоДате=ПолучитьТекстОтбораПоДате();
	
	Если ЗначениеЗаполнено(Объект.ДатаНач) И ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" МЕЖДУ &ДатаНач И &ДатаКон"); 
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента МЕЖДУ &ДатаНач И &ДатаКон");
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНач) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" >=&ДатаНач");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента >=&ДатаНач");
		
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата",ТекстОтбораПоДате+" <=&ДатаКон");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента <=&ДатаКон");
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрДата","ИСТИНА");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ИСТИНА");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрОрганизация","ОтражениеДокументовПоШаблонам.Организация = &Организация");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ОрганизацияДокумента","ДокументыДляПовторнойТрансляции.Организация = &Организация");
		
		Запрос.УстановитьПараметр("Организация",Объект.Организация); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрОрганизация","ИСТИНА");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ОрганизацияДокумента","ИСТИНА");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПланСчетов) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрПланСчетов","ОтражениеДокументовПоШаблонам.УчетнаяПолитика.ПланСчетовУчета = &ПланСчетов");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ПланСчетов","ДокументыДляПовторнойТрансляции.ДокументТрансляции.ПланСчетов = &ПланСчетов");

		Запрос.УстановитьПараметр("ПланСчетов",Объект.ПланСчетов); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&ПараметрПланСчетов","ИСТИНА");
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ПланСчетов","ИСТИНА");
	
	КонецЕсли; 
		
	Запрос.Текст=ТекстЗапроса;
	Результат=Запрос.ВыполнитьПакет();
	Возврат Результат;
	
		
КонецФункции // ПолучитьДанныеОбработкиДокументов() 

&НаСервере
Функция ПолучитьТекстОтбораПоДате()
	
	ТекстОтбора="(ВЫБОР";
	
	Для Каждого СтрокаТип ИЗ МассивТиповДокументов Цикл
		
		ТекстОтбора=ТекстОтбора+"
		|КОГДА ОтражениеДокументовПоШаблонам.ИсходныйДокумент ССЫЛКА СтрокаТип
		|ТОГДА ВЫРАЗИТЬ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК СтрокаТип).Дата"; // @query-part
		
		ТекстОтбора = СтрЗаменить(ТекстОтбора, "СтрокаТип", СтрокаТип);
		
	КонецЦикла;
	
	Возврат ТекстОтбора+"
	|КОНЕЦ)";	
	
КонецФункции // ПолучитьТекстОтбораПоДате() 

&НаСервере
Процедура ОтобразитьОжидающиеОбработкиВручную(ТаблицаДокументов)
		
	Если ТаблицаДокументов.Количество()>0 И ТаблицаДокументов[0].КоличествоДокументов>0 Тогда
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Документы, ожидающие отражения вручную: %1'"),ТаблицаДокументов[0].КоличествоДокументов);
		Элементы.ДекорацияОжидаютОбработкиВручную.Доступность=Истина;
		ЕстьДокументыКОтражениюВручную=Истина;
		
	Иначе
		
		ТекстСообщения=НСтр("ru = 'Нет документов, ожидающих отражения вручную'");
		Элементы.ДекорацияОжидаютОбработкиВручную.Доступность=Ложь;
		ЕстьДокументыКОтражениюВручную=Ложь;
		
	КонецЕсли;
	
	Элементы.ДекорацияОжидаютОбработкиВручную.Заголовок=ТекстСообщения;
			
КонецПроцедуры // ОтобразитьОжидающиеОбработки()

Процедура ОтобразитьОжидающиеПовторнойТрансляции(ТаблицаДокументов)
		
	Если ТаблицаДокументов.Количество()>0 И ТаблицаДокументов[0].КоличествоДокументов>0 Тогда
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Документы, требующие повторной трансляции: %1'"),ТаблицаДокументов[0].КоличествоДокументов);
		Элементы.ДекорацияОжидаютПовторнойТрансляции.Доступность=Истина;
		ЕстьДокументыДляПовторнойТрансляции=Истина;
		
	Иначе
		
		ТекстСообщения=НСтр("ru = 'Нет документов, требующих повторной трансляции'");
		Элементы.ДекорацияОжидаютПовторнойТрансляции.Доступность=Ложь;
		ЕстьДокументыДляПовторнойТрансляции=Ложь;
		
	КонецЕсли;
	
	Элементы.ДекорацияОжидаютПовторнойТрансляции.Заголовок=ТекстСообщения;
			
КонецПроцедуры // ОтобразитьОжидающиеПовторнойТрансляции()

&НаСервере
Процедура ОтобразитьОжидающиеОбработкиЗаданием(ТаблицаДокументов)
	
	Если ТаблицаДокументов.Количество()>0 И ТаблицаДокументов[0].КоличествоДокументов>0 Тогда
		
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Документы, ожидающие автоматического отражения: %1'"),ТаблицаДокументов[0].КоличествоДокументов);
		Элементы.ДекорацияОжидаютОбработкиЗаданием.Доступность=Истина;
		ЕстьДокументыКОтражениюЗаданием=Истина;
		
	Иначе
		
		ТекстСообщения=НСтр("ru = 'Нет документов, ожидающих автоматического отражения'");
		Элементы.ДекорацияОжидаютОбработкиЗаданием.Доступность=Ложь;
		ЕстьДокументыКОтражениюЗаданием=Ложь;
		
	КонецЕсли;
	
	Элементы.ДекорацияОжидаютОбработкиЗаданием.Заголовок=ТекстСообщения;
			
КонецПроцедуры // ОтобразитьОжидающиеОбработки() 

&НаСервере
Процедура ОтобразитьОбработанные(ТаблицаДокументов)
	
	Если ТаблицаДокументов.Количество()>0 И ТаблицаДокументов[0].КоличествоДокументов>0 Тогда
		
