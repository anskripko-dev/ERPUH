&НаСервере
Функция ОтразитьПоШаблонамНаСервере()
	
	МассивДокументов=ПолучитьМассивДокументовКОбработке();	
	Возврат КорректировкиЗначенийПоказателей32.ОбработатьМассивДокументов(МассивДокументов,Новый Структура("ВключаяОбработанные",Ложь));
		
КонецФункции

&НаСервере
Функция ОбновитьДокументыТрансляции()
	
	МассивДокументов=ПолучитьМассивДокументовТрансляции();	
	Возврат КорректировкиЗначенийПоказателей32.ОбработатьМассивДокументов(МассивДокументов,Новый Структура("ОтборПроводок",Неопределено));
		
КонецФункции

&НаСервере
Функция ПолучитьМассивДокументовТрансляции() 
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ДокументыДляПовторнойТрансляции.ДокументТрансляции КАК ДокументТрансляции
	             |ИЗ
	             |	РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	             |ГДЕ
	             |	&Параметр_ДатаДокумента
	             |	И &Параметр_ОрганизацияДокумента
	             |	И &Параметр_ПланСчетов";
		
	Если ЗначениеЗаполнено(Объект.ДатаНач) И ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента МЕЖДУ &ДатаНач И &ДатаКон");
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНач) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента >=&ДатаНач");	
		Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ДокументыДляПовторнойТрансляции.ДатаДокумента <=&ДатаКон");
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.ДатаКон));
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ДатаДокумента","ИСТИНА");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ОрганизацияДокумента","ДокументыДляПовторнойТрансляции.Организация = &Организация");	
		Запрос.УстановитьПараметр("Организация",Объект.Организация); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ОрганизацияДокумента","ИСТИНА");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПланСчетов) Тогда
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ПланСчетов","ДокументыДляПовторнойТрансляции.ДокументТрансляции.ПланСчетов = &ПланСчетов");
		Запрос.УстановитьПараметр("ПланСчетов",Объект.ПланСчетов); 
		
	Иначе
		
		ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"&Параметр_ПланСчетов","ИСТИНА");
	
	КонецЕсли; 
		
	Запрос.Текст=ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументТрансляции");
		
КонецФункции // ПолучитьМассивДокументовТрансляции()

&НаКлиенте
Процедура ОтразитьПоШаблонам(Команда) 
	
	ОбновленыДокументыТрансляции=Ложь;
	ВыполненоОтражениеПоШаблонам=Ложь;
	
	Если ЕстьДокументыДляПовторнойТрансляции Тогда
		
		ВыполнитьПовторнуюТрансляциюДокументов();
		
	КонецЕсли;
	
	Если ЕстьДокументыКОтражениюЗаданием ИЛИ ЕстьДокументыКОтражениюВручную Тогда
		
		ВыполнитьОтражениеДокументовПоШаблонам();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПовторнуюТрансляциюДокументов()
	
	ДлительнаяОперация=ОбновитьДокументыТрансляции();	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОтметитьПовторнуюТрансляцию", ЭтотОбъект);
	
	Если ДлительнаяОперация.Статус = "Выполнено"
		Или ДлительнаяОперация.Статус = "Отменено" Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ДлительнаяОперация);
		
	Иначе
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания             = Истина;
		ПараметрыОжидания.ТекстСообщения                   = НСтр("ru = 'Выполняется перезаполнение документов трансляции'");
		ПараметрыОжидания.ОповещениеПользователя.Показать  = Истина;
		ПараметрыОжидания.ОповещениеПользователя.Текст     = НСтр("ru = 'Выполняется перезаполнение документов трансляции'");
		ПараметрыОжидания.ОповещениеПользователя.Пояснение = НСтр("ru = 'Выполняется перезаполнение документов трансляции'");
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
	
КонецПроцедуры // ВыполнитьПовторноеОтражениеДокументов()

&НаКлиенте
Процедура ВыполнитьОтражениеДокументовПоШаблонам()
	
	ДлительнаяОперация=ОтразитьПоШаблонамНаСервере();	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОтметитьОтражениеПоШаблонам", ЭтотОбъект);
	
	Если ДлительнаяОперация.Статус = "Выполнено"
		Или ДлительнаяОперация.Статус = "Отменено" Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ДлительнаяОперация);
		
	Иначе
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания             = Истина;
		ПараметрыОжидания.ТекстСообщения                   = НСтр("ru = 'Выполняется отражение документов по шаблонам'");
		ПараметрыОжидания.ОповещениеПользователя.Показать  = Истина;
		ПараметрыОжидания.ОповещениеПользователя.Текст     = НСтр("ru = 'Выполняется отражение документов по шаблонам'");
		ПараметрыОжидания.ОповещениеПользователя.Пояснение = НСтр("ru = 'Выполняется отражение документов по шаблонам'");
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
	
КонецПроцедуры // ВыполнитьПовторноеОтражениеДокументов()

&НаКлиенте
Процедура ОтметитьОтражениеПоШаблонам(Результат, ДополнительныеПараметры) Экспорт
			
	Если ЕстьДокументыКОтражениюЗаданием ИЛИ ЕстьДокументыКОтражениюВручную Тогда
		
		ОбновитьДанныеФормы();
		
	КонецЕсли;
					
КонецПроцедуры // ОтметитьОтражениеПоШаблонам()

&НаКлиенте
Процедура ОтметитьПовторнуюТрансляцию(Результат, ДополнительныеПараметры) Экспорт
		
	Если НЕ (ЕстьДокументыКОтражениюЗаданием ИЛИ ЕстьДокументыКОтражениюВручную) Тогда
		
		ОбновитьДанныеФормы();
		
	КонецЕсли;
					
КонецПроцедуры // ОтметитьОтражениеПоШаблонам()

&НаКлиенте
Процедура ДекорацияРасписаниеНажатие(Элемент)
	
	Если РасписаниеРегламентногоЗадания=Неопределено Тогда
		
		РасписаниеРегламентногоЗадания=Новый РасписаниеРегламентногоЗадания;

	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗадания);
	Диалог.Показать(Новый ОписаниеОповещения("ОбработкаВыбораРасписания", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРасписания(Расписание, ДополнительныеПараметры) Экспорт
	
	Если Расписание <> Неопределено Тогда
		РасписаниеРегламентногоЗадания = Расписание;
		СохранитьРеквизитыРегламентногоЗадания();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРеквизитыРегламентногоЗадания()

	УстановитьПривилегированныйРежим(Истина);
	
	ИмяЗадания="ОтражениеДокументовПоШаблонам";
	
	Задание = РегламентныеЗаданияСервер.Задание(Метаданные.РегламентныеЗадания[ИмяЗадания]);
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Использование", Истина);
	ПараметрыЗадания.Вставить("Расписание", РасписаниеРегламентногоЗадания);
	РегламентныеЗаданияСервер.ИзменитьЗадание(Задание, ПараметрыЗадания);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОбновитьПредставлениеРасписания();
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеРасписания()
	
	Если РасписаниеРегламентногоЗадания = Неопределено
	 ИЛИ РасписаниеРегламентногоЗадания = Новый РасписаниеРегламентногоЗадания Тогда
		ПредставлениеРасписания = НСтр("ru = 'Расписание не задано'");
	Иначе
		ПредставлениеРасписания = Строка(РасписаниеРегламентногоЗадания);
	КонецЕсли;
	
	Элементы.ДекорацияРасписание.Заголовок=ПредставлениеРасписания;
	
КонецПроцедуры 

&НаСервере
Процедура ПолучитьСостояниеРегламентногоЗадания()
	
	Если НЕ ЭтоУправлениеХолдингом Тогда
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ИмяЗадания="ОтражениеДокументовПоШаблонам";
	
	Задание = РегламентныеЗаданияСервер.Задание(Метаданные.РегламентныеЗадания[ИмяЗадания]);
	РасписаниеРегламентногоЗадания	= Задание.Расписание; 
	ОбновитьПредставлениеРасписания();
		
	СвойстваПоследнегоФоновогоЗадания = КорректировкиЗначенийПоказателей32.ПолучитьСостояниеПоследнегоЗадания(Задание);
	Если СвойстваПоследнегоФоновогоЗадания = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(СвойстваПоследнегоФоновогоЗадания.Конец) Тогда
		СостояниеРегламентногоЗадания = НСтр("ru = 'Не выполнялось'");
	Иначе
		СостояниеРегламентногоЗадания = Строка(СвойстваПоследнегоФоновогоЗадания.Состояние) + ": "
			+ Строка(СвойстваПоследнегоФоновогоЗадания.Конец);
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура СостояниеВыверкиТрансляции(Команда)

	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("Организация",Объект.Организация);
	СтруктураПараметров.Вставить("ДатаНач",Объект.ДатаНач);
	СтруктураПараметров.Вставить("ДатаКон",КонецДня(Объект.ДатаКон));
	СтруктураПараметров.Вставить("ФормироватьОтчет",Истина);
	
	ОткрытьФорму("Отчет.ВыверкаТрансляцииПроводок.Форма.ФормаОтчета",СтруктураПараметров,,Новый УникальныйИдентификатор);
	
КонецПроцедуры

