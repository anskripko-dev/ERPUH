&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ОбновитьДанныеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивТиповДокументов=Новый ФиксированныйМассив(РегистрыСведений.ОтражениеДокументовПоШаблонам.ПолучитьТипыИсходныхДокументов());
	
	Если МассивТиповДокументов.Количество()=0 Тогда
		
		ТекстСообщения=НСтр("ru = 'В базе данных не найдены шаблоны трансляций или шаблоны операций для отражения документов на плане счетов МСФО.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,Отказ,,СтатусСообщения.Информация);
		Возврат;
		
	КонецЕсли;
	
	ИспользоватьНесколькоПлановСчетов=Константы.ИспользоватьУчетныеПолитикиМСФО.Получить();
	Элементы.ПланСчетов.Видимость=ИспользоватьНесколькоПлановСчетов;
	ЭтоУправлениеХолдингом=ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом();
	
	ПроверитьОтобразитьДатуЗакрытияПериода();
	
	ПериодичностьТрансляции=Константы.ПериодичностьТрансляцииПроводок.Получить();
	
	Объект.ДатаНач=ОбщегоНазначенияУХ.ДатаНачалаПериода(ТекущаяДата(),ПериодичностьТрансляции);
	Объект.ДатаКон=ОбщегоНазначенияУХ.ДатаКонцаПериода(ТекущаяДата(),ПериодичностьТрансляции); 
	
	Заголовок=НСтр("ru = 'Отражение документов по шаблонам на плане счетов МСФО'");
	
	УстановитьВидимость();
	ОбновитьДанныеНаСервере();
		
КонецПроцедуры

