		Элементы.ДекорацияОбработанные.Доступность=Истина;
		
	Иначе
		
		ТекстСообщения=НСтр("ru = 'Отраженные документы отсутствуют'");
		Элементы.ДекорацияОбработанные.Доступность=Ложь;
		
	КонецЕсли;
	
	Элементы.ДекорацияОбработанные.Заголовок=ТекстСообщения;
			
КонецПроцедуры // ОтобразитьОжидающиеОбработки()

&НаСервере
Процедура ОтобразитьОтключенные(ТаблицаДокументов)
	
	Если ТаблицаДокументов.Количество()>0 И ТаблицаДокументов[0].КоличествоДокументов>0 Тогда
		
