&НаСервере
Процедура ОтобразитьСостояниеТрансляции()
	
	Если НЕ (ЗначениеЗаполнено(Объект.ДатаНач) 
		И ЗначениеЗаполнено(Объект.ДатаКон)
		И ЗначениеЗаполнено(Объект.Организация)) Тогда
		
		ТекстВыверка=НСтр("ru = 'Выверка трансляции'");
		Элементы.СостояниеВыверкиТрансляции.ЦветТекста=Новый Цвет(28,85,174);
		Элементы.СостояниеВыверкиТрансляции.Шрифт=Новый Шрифт(Элементы.СостояниеВыверкиТрансляции.Шрифт, , , Ложь);
		
	Иначе
		
		РасхождениеТрансляции=КорректировкиЗначенийПоказателей32.ПолучитьРасхожденияТрансляции(Объект.ДатаНач,Объект.ДатаКон,Объект.Организация,Объект.ПланСчетов);
		
		Если РасхождениеТрансляции=0 ИЛИ РасхождениеТрансляции=NUll Тогда
			
			ТекстВыверка=НСтр("ru = 'Расхождений при трансляции не обнаружено.'");
			
			Элементы.СостояниеВыверкиТрансляции.ЦветТекста=Новый Цвет(28,85,174);
			Элементы.СостояниеВыверкиТрансляции.Шрифт=Новый Шрифт(Элементы.СостояниеВыверкиТрансляции.Шрифт, , , Ложь);
			
		Иначе
			
			ТекстВыверка=НСтр("ru = 'Расхождения трансляции: '") + Формат(РасхождениеТрансляции,"ЧДЦ=2");
			
			Элементы.СостояниеВыверкиТрансляции.ЦветТекста=Новый Цвет(255,0,0);
			Элементы.СостояниеВыверкиТрансляции.Шрифт=Новый Шрифт(Элементы.СостояниеВыверкиТрансляции.Шрифт, , , Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СостояниеВыверкиТрансляции.Заголовок=ТекстВыверка;
				
КонецПроцедуры // ОтобразитьСостояниеТрансляции()

&НаСервере
Процедура ОтобразитьДанныеУчетныхПолитик()
	
	УчетныеПолитики.Очистить();

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ВывестиДанныеУчетныхПолитик();
		Возврат;
		
	КонецЕсли; 
	
	Запрос=Новый Запрос;
	
	Если ЗначениеЗаполнено(Объект.ДатаНач) И ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		             |	УчетныеПолитикиМСФО.Период КАК Период,
		             |	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
		             |	УчетныеПолитикиМСФО.УчетнаяПолитика.Ссылка КАК УчетнаяПолитика,
		             |	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		             |ПОМЕСТИТЬ УчетнаяПолитикаДо
		             |ИЗ
		             |	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		             |ГДЕ
		             |	УчетныеПолитикиМСФО.Организация = &Организация
		             |	И УчетныеПолитикиМСФО.Период < &ДатаНач
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	Период УБЫВ
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	УчетнаяПолитикаДо.Период КАК Период,
		             |	УчетнаяПолитикаДо.СпособТрансляции КАК СпособТрансляции,
		             |	УчетнаяПолитикаДо.УчетнаяПолитика КАК УчетнаяПолитика,
					 |	УчетнаяПолитикаДо.ШаблонТрансляции КАК ШаблонТрансляции
		             |ИЗ
		             |	УчетнаяПолитикаДо КАК УчетнаяПолитикаДо
		             |
		             |ОБЪЕДИНИТЬ ВСЕ
		             |
		             |ВЫБРАТЬ
		             |	УчетныеПолитикиМСФО.Период,
		             |	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции,
		             |	УчетныеПолитикиМСФО.УчетнаяПолитика,
					 |	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		             |ИЗ
		             |	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		             |ГДЕ
		             |	УчетныеПолитикиМСФО.Организация = &Организация
		             |	И УчетныеПолитикиМСФО.Период МЕЖДУ &ДатаНач И &ДатаКон
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	Период УБЫВ";
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНач) Тогда
		
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетныеПолитикиМСФО.Период КАК Период,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.Ссылка КАК УчетнаяПолитика,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		|ПОМЕСТИТЬ УчетнаяПолитикаДо
		|ИЗ
		|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		|ГДЕ
		|	УчетныеПолитикиМСФО.Организация = &Организация
		|	И УчетныеПолитикиМСФО.Период < &ДатаНач
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УчетнаяПолитикаДо.Период КАК Период,
		|	УчетнаяПолитикаДо.СпособТрансляции КАК СпособТрансляции,
		|	УчетнаяПолитикаДо.УчетнаяПолитика КАК УчетнаяПолитика,
		|	УчетнаяПолитикаДо.ШаблонТрансляции КАК ШаблонТрансляции
		|ИЗ
		|	УчетнаяПолитикаДо КАК УчетнаяПолитикаДо
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УчетныеПолитикиМСФО.Период,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		|ИЗ
		|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		|ГДЕ
		|	УчетныеПолитикиМСФО.Организация = &Организация
		|	И УчетныеПолитикиМСФО.Период >= &ДатаНач
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаКон) Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		|	УчетныеПолитикиМСФО.Период КАК Период,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.Ссылка КАК УчетнаяПолитика,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		|ИЗ
		|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		|ГДЕ
		|	УчетныеПолитикиМСФО.Организация = &Организация
		|	И УчетныеПолитикиМСФО.Период <= &ДатаКон
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	Иначе
		
		Запрос.Текст="ВЫБРАТЬ
		|	УчетныеПолитикиМСФО.Период КАК Период,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.СпособТрансляции КАК СпособТрансляции,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.Ссылка КАК УчетнаяПолитика,
		|	УчетныеПолитикиМСФО.УчетнаяПолитика.ШаблонТрансляции КАК ШаблонТрансляции
		|ИЗ
		|	РегистрСведений.УчетныеПолитикиМСФО КАК УчетныеПолитикиМСФО
		|ГДЕ
		|	УчетныеПолитикиМСФО.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ДатаНач",Объект.ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон",Объект.ДатаКон);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	СпособТрансляцииБП=Константы.СпособТрансляции.Получить();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=УчетныеПолитики.Добавить();
		
		Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
			
		Иначе
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат,,"СпособТрансляции");
			НоваяСтрока.СпособТрансляции=СпособТрансляцииБП;
			
		КонецЕсли;
			
		Если Результат.Период=Объект.ДатаНач Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВывестиДанныеУчетныхПолитик();

КонецПроцедуры // ОтобразитьДанныеУчетныхПолитик()

&НаСервере
Процедура ВывестиДанныеУчетныхПолитик()
	
	Если УчетныеПолитики.Количество()=0 Тогда
		
		Элементы.ГруппаУчетныеПолитики.Видимость=Ложь;
		
		Элементы.ГруппаДокументы.Видимость=Истина; 
		Элементы.ДекорацияОжидаютОбработкиЗаданием.Видимость=Истина;
		
		Возврат;
		
	Иначе
		
		Элементы.ГруппаУчетныеПолитики.Видимость=Истина;
		
	КонецЕсли;
	
	ЕстьПодокументнаяТрансляция=Ложь;
	ЕстьОтражениеЗаданием=Ложь;
	
	ТекстПолитики="";
	
	Для Каждого Строка ИЗ УчетныеПолитики Цикл
		
		ТекстПолитики=ТекстПолитики+Символы.ПС
			+СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Период с: %1, способ отражения %2, шаблон трансляции %3'"),Строка.Период,Строка.СпособТрансляции,Строка.ШаблонТрансляции);
			Если ЗначениеЗаполнено(Строка.СпособТрансляции) 
				И НЕ Строка.СпособТрансляции=Перечисления.СпособыТрансляции.СводныеПоДатам Тогда
				
			ЕстьПодокументнаяТрансляция=Истина;
			
			Если Строка.СпособТрансляции=Перечисления.СпособыТрансляции.ПоДокументамФоновоеЗадание Тогда
				
				ЕстьОтражениеЗаданием=Истина;
				
			КонецЕсли;
						
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ДекорацияУчетныеПолитики.Заголовок=Сред(ТекстПолитики,2);
	
	Если НЕ ЕстьПодокументнаяТрансляция Тогда
		
		Элементы.ГруппаДокументы.Видимость=Ложь;
		Элементы.ДекорацияСводныеПроводки.Видимость=Истина;
		Элементы.ДекорацияСводныеПроводки.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для организации %1 отражение документов по шаблонам не производится.'"),Объект.Организация);
		
	Иначе
		
		Элементы.ГруппаДокументы.Видимость=Истина;
		Элементы.ДекорацияСводныеПроводки.Видимость=Ложь;
		
	КонецЕсли;	
	
	Элементы.ДекорацияОжидаютОбработкиЗаданием.Видимость=ЕстьОтражениеЗаданием;
	
КонецПроцедуры // ВывестиДанныеУчетныхПолитик()

&НаСервере
Процедура ОтобразитьДанныеОбработкиДокументов() 
	
	ДанныеОбработки=ПолучитьДанныеОбработкиДокументов();
	
	ОтобразитьОбработанные(ДанныеОбработки[2].Выгрузить());
	ОтобразитьОжидающиеОбработкиЗаданием(ДанныеОбработки[3].Выгрузить());
	ОтобразитьОжидающиеОбработкиВручную(ДанныеОбработки[4].Выгрузить());
	ОтобразитьОтключенные(ДанныеОбработки[5].Выгрузить());
	ОтобразитьОжидающиеПовторнойТрансляции(ДанныеОбработки[6].Выгрузить());
		
КонецПроцедуры // ОтобразитьДанныеОбработкиДокументов() 

&НаСервере
Процедура ОбновитьДанныеНаСервере()
	
	ПроверитьОтобразитьДатуЗакрытияПериода();
	ОтобразитьДанныеОбработкиДокументов();
	//ОтобразитьСостояниеТрансляции();
	ОтобразитьДанныеУчетныхПолитик();
	
	ПолучитьСостояниеРегламентногоЗадания();
	
	Элементы.ОтразитьПоШаблонам.Видимость=(ЕстьДокументыКОтражениюВручную 
		ИЛИ ЕстьДокументыКОтражениюЗаданием
		ИЛИ ЕстьДокументыДляПовторнойТрансляции);
	
	УстановитьОтборыСписка();
	
КонецПроцедуры 

