&НаСервере 
Перем СоответствиеДокументаТипамСообщения;
Перем СписокДокументов;

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиСообщения(Команда)
	
	НайтиСообщенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСообщения(Команда)
	      
	ДополнительныеПараметры = ПолучитьСтруктуруДопПараметров();
	Если ДополнительныеПараметры.МассивИД.Количество() < 1 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет сообщений для загрузки.");
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ПолучитьДлительнуюОперациюОбработкиСообщений(ДополнительныеПараметры.МассивИД);
		
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Вставить("ТекстСообщения", "Идет обработка сообщений...");
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиСообщений", ЭтотОбъект, ДополнительныеПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиСообщенияНаСервере()
	
	Если Не ЗначениеЗаполнено(ТипДокумента) И ЕстьПустойТипДокументаВСтроках() Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо заполнить тип документа во всех строках таблицы или в шапке.");
		Возврат;
	КонецЕсли;
	
	БазаРеспондентИД = "";
	Если ЗначениеЗаполнено(БазаРеспондент) Тогда
		БазаРеспондентИД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БазаРеспондент, "Наименование");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ИДСообщения КАК ИДСообщения,
	|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ТекстСообщения КАК ТекстСообщения,
	|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.УниверсальнаяДатаСообщения КАК УниверсальнаяДатаСообщения
	|ИЗ
	|	РегистрСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ КАК тн_Интеграция_ОчередьОбработкиСообщенийRMQ
	|ГДЕ
	|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ТипЗапроса В(&ТипЗапроса)
	|	И тн_Интеграция_ОчередьОбработкиСообщенийRMQ.БазаРеспондентИД = &БазаРеспондентИД
	|	И тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ТекстСообщения ПОДОБНО &Шаблон
	|
	|УПОРЯДОЧИТЬ ПО
	|	УниверсальнаяДатаСообщения УБЫВ";
	
	Если ЗначениеЗаполнено(БазаРеспондентИД) Тогда
		Запрос.УстановитьПараметр("БазаРеспондентИД", БазаРеспондентИД);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И тн_Интеграция_ОчередьОбработкиСообщенийRMQ.БазаРеспондентИД = &БазаРеспондентИД", ""); 
	КонецЕсли;
	
	НомерСтроки = 0;
	
	Для Каждого Стр Из ТаблицаДокументов Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если ЗначениеЗаполнено(Стр.ШаблонДляСФ) Тогда
			Шаблон = Стр.ШаблонДляСФ;
			ТипДокументаДляЗапроса = "Счет-фактура выданный";
		ИначеЕсли Не ЗначениеЗаполнено(Стр.Номер) Или Не ЗначениеЗаполнено(Стр.Дата) Тогда
			Стр.ЕстьСообщение = Ложь;
			Стр.ВыделитьНенайденное = Истина;
			Продолжить;
		Иначе
			ТипДокументаДляЗапроса = ?(ЗначениеЗаполнено(Стр.ТипДокумента), Стр.ТипДокумента, ТипДокумента);
			Дата = Стр.Дата;
			Если ТипДокументаДляЗапроса = "Счет-фактура выданный" Тогда
				Номер = Стр.Номер; // при выгрузке СФ выданного номер не обрезается
			Иначе
				Номер = тн_Интеграция_ERP_УХ.НомерДокумента11Символов(Стр.Номер);
			КонецЕсли;
			ТекстНомер = СтрШаблон("%%""number"": ""%1""", Номер);
			ТекстДата = СтрШаблон("%%""date"": ""%1-%2-%3%%", Формат(Дата, "ДФ=yyyy"), Формат(Дата, "ДФ=MM"), Формат(Дата, "ДФ=dd"));
			Шаблон = ТекстНомер + ТекстДата;
		КонецЕсли;
		ТипЗапроса = СоответствиеДокументаТипамСообщения.Получить(ТипДокументаДляЗапроса);
		
		Запрос.УстановитьПараметр("ТипЗапроса", ТипЗапроса);
        Запрос.УстановитьПараметр("Шаблон", Шаблон);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Стр.ЕстьСообщение = Истина;
			Стр.ВыделитьНенайденное = Ложь;
			ЗаполнитьЗначенияСвойств(Стр, Выборка);
			
			Если Стр.НужнаСФ И ТипДокументаДляЗапроса <> "Счет-фактура выданный" И ТипДокументаДляЗапроса <> "Приходный кассовый ордер" Тогда
			
				НоваяСтрока = ТаблицаДокументов.Добавить();
				НоваяСтрока.ТипДокумента = "Счет-фактура выданный";
				НоваяСтрока.ШаблонДляСФ = ПолучитьШаблонДляСФ(Стр.ТекстСообщения);
				СтрокВТаблице = ТаблицаДокументов.Количество();
				ТаблицаДокументов.Сдвинуть(СтрокВТаблице - 1, НомерСтроки + 1 - СтрокВТаблице);
				
			КонецЕсли;
			
		Иначе
			
			Стр.ЕстьСообщение = Ложь;
			Стр.ВыделитьНенайденное = Истина;
		
		КонецЕсли;
								
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьПустойТипДокументаВСтроках()
	
	Отбор = Новый Структура("ТипДокумента", "");
	МассивСтрок = ТаблицаДокументов.НайтиСтроки(Отбор);
	
	Возврат МассивСтрок.Количество() > 0;
	
КонецФункции

&НаСервере
Функция ПолучитьШаблонДляСФ(ТекстСообщения)
	
	ШаблонДляСФ = "";
	СтрокаПоиска = """guid"": ";
	ПозицияСтрокиПоиска = СтрНайти(ТекстСообщения, СтрокаПоиска);
	Если ПозицияСтрокиПоиска <> 0 Тогда
		ШаблонДляСФ = Сред(ТекстСообщения, ПозицияСтрокиПоиска, СтрДлина(СтрокаПоиска) + 38);
		ШаблонДляСФ = "%" + СтрЗаменить(ШаблонДляСФ, "guid", "baseDocumentGuid") + "%";
	КонецЕсли;
	
	Возврат ШаблонДляСФ;
	
КонецФункции

&НаСервере
Функция ПолучитьДлительнуюОперациюОбработкиСообщений(МассивИД)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"тн_Интеграция_ERP_УХ.ОбработатьСообщениеRMQ_ВПотоке",
		МассивИД);	
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруДопПараметров()
	
	ДополнительныеПараметры = Новый Структура;
	
	Отбор = Новый Структура("ЕстьСообщение", Истина);
	МассивИД = ТаблицаДокументов.Выгрузить(Отбор).ВыгрузитьКолонку("ИДСообщения");
	
	ДополнительныеПараметры.Вставить("МассивИД", МассивИД);
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДополнительныеПараметры.Вставить("ДатаЗагрузки", ТекущаяДата()); 
	ДополнительныеПараметры.Вставить("ДатаЗагрузки", ТекущаяДатаСервера());
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииОбработкиСообщений(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда // Пользователь отменил задание
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("МассивИД") И ДополнительныеПараметры.Свойство("ДатаЗагрузки") Тогда
		ЗаполнитьРезультатЗагрузкиВТаблицуДокументов(ДополнительныеПараметры.МассивИД, ДополнительныеПараметры.ДатаЗагрузки); 
	КонецЕсли;
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Обработка сообщений завершена!");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатЗагрузкиВТаблицуДокументов(МассивИД, ДатаЗагрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ДокументыЗагруженныеПоОбмену.Документ КАК Документ,
		|	тн_ДокументыЗагруженныеПоОбмену.ИДСообщения КАК ИДСообщения
		|ИЗ
		|	РегистрСведений.тн_ДокументыЗагруженныеПоОбмену КАК тн_ДокументыЗагруженныеПоОбмену
		|ГДЕ
		|	тн_ДокументыЗагруженныеПоОбмену.ИДСообщения В(&МассивИД)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА тн_Интеграция_ЛогСообщений.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.тн_ВидыСобытийИнтеграции.Ошибка)
		|			ТОГДА тн_Интеграция_ЛогСообщений.ОписаниеОшибки
		|		КОГДА тн_Интеграция_ЛогСообщений.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.тн_ВидыСобытийИнтеграции.Предупреждение)
		|			ТОГДА тн_Интеграция_ЛогСообщений.XML_ПакетВходящий
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ОписаниеОшибки,
		|	тн_Интеграция_ЛогСообщений.ИДСообщения КАК ИДСообщения
		|ИЗ
		|	РегистрСведений.тн_Интеграция_ЛогСообщений КАК тн_Интеграция_ЛогСообщений
		|ГДЕ
		|	тн_Интеграция_ЛогСообщений.ИДСообщения В(&МассивИД)
		|	И тн_Интеграция_ЛогСообщений.Период >= &ДатаЗагрузки";
	
	Запрос.УстановитьПараметр("МассивИД", МассивИД);
	Запрос.УстановитьПараметр("ДатаЗагрузки", ДатаЗагрузки);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументы = РезультатЗапроса[0].Выбрать();
	ВыборкаОшибки = РезультатЗапроса[1].Выбрать();
	
	Отбор = Новый Структура("ИДСообщения");
	
	Пока ВыборкаДокументы.Следующий() Цикл
		Отбор.ИДСообщения = ВыборкаДокументы.ИДСообщения;
		НайденныеСтроки = ТаблицаДокументов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Документ = ВыборкаДокументы.Документ;
		КонецЕсли;
	КонецЦикла;
	
	Пока ВыборкаОшибки.Следующий() Цикл
		Отбор.ИДСообщения = ВыборкаОшибки.ИДСообщения;
		НайденныеСтроки = ТаблицаДокументов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].ОписаниеОшибки = ВыборкаОшибки.ОписаниеОшибки;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры 

#КонецОбласти
	
