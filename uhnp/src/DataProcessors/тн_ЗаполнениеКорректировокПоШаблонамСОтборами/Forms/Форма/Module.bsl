#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаРасшифровкаПоДокументамОткрыта; 

#КонецОбласти  

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПериодОбработки") Тогда
		ПериодОбработки = Параметры.ПериодОбработки;	
	КонецЕсли;     
	
	Если Параметры.Свойство("Организация") Тогда
		Организации.Очистить();
		Организации.Добавить(Параметры.Организация);
	КонецЕсли;    
	
	ОбновитьСписокДокументовБД();
	УстановитьВидимостьДоступность(); 
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	ФормаРасшифровкаПоДокументамОткрыта = Ложь;  
	
КонецПроцедуры

#КонецОбласти    

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацииПриИзменении(Элемент) 
	
	УчетныеПолитики.Очистить(); 
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныеПолитикиПриИзменении(Элемент) 
	
	Организации.Очистить();
    УстановитьВидимостьДоступность();
 
КонецПроцедуры

&НаКлиенте
Процедура ВидыДокументаПриИзменении(Элемент) 
	
	СформироватьСписокШаблоновДокумента();
	УстановитьВидимостьДоступность();      
	
	Если Не ЗначениеЗаполнено(ВидыДокумента) Тогда    
		Элементы.ШаблоныКорректировки.КнопкаВыпадающегоСписка = Ложь;
		Элементы.ШаблоныКорректировки.РежимВыбораИзСписка     = Ложь;
		Элементы.ШаблоныКорректировки.КнопкаВыбора            = Истина; 
		Элементы.ШаблоныКорректировки.ОграничениеТипа         = Новый ОписаниеТипов("СправочникСсылка.ШаблоныТрансформационныхКорректировок");		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы   

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	Если Не ЗначениеЗаполнено(ПериодОбработки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо заполнить период обработки.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организации) 
		И Не ЗначениеЗаполнено(УчетныеПолитики) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо задать отбор по организациям или учетным политикам.'"));
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОперация = ВыполнитьОбработкуНаСервере();
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиОтветногоСообщения", ЭтотОбъект); 
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, НастройкиОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбработанныеДокументы(Команда)
	
	ПараметрыФормы = Новый Структура;       	
	ПараметрыФормы.Вставить("АдресВХ", ПолучитьАдресВременногоХранилища());  
	
	Если ФормаРасшифровкаПоДокументамОткрыта Тогда
		Оповестить("РасшифровкаПоДокументам_ИзмененийУсловийОтбора", ПараметрыФормы, ЭтотОбъект);
	Иначе
		ОповещениеОЗакрытииФормы = Новый ОписаниеОповещения("ПриЗакрытииФормыРасшифровкаПоДокументам", ЭтотОбъект);
		ОткрытьФорму("Обработка.тн_НастройкаОтраженияДокументовВУпрУчете.Форма.РасшифровкаПоДокументам", ПараметрыФормы, ЭтотОбъект,,,, ОповещениеОЗакрытииФормы);
		ФормаРасшифровкаПоДокументамОткрыта = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриЗавершенииОбработкиОтветногоСообщения(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ПолучитьИзВременногоХранилищаНаСервере(Результат.АдресРезультата);     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Обработка завершена");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРасшифровкаПоДокументам(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ФормаРасшифровкаПоДокументамОткрыта = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()
	
	Элементы.СоздаватьНовые.Доступность	= ЗначениеЗаполнено(ШаблоныКорректировки) 
	    Или ЗначениеЗаполнено(ВидыДокумента);
	
	Если Не Элементы.СоздаватьНовые.Доступность Тогда
		СоздаватьНовые = Ложь;
	КонецЕсли;     
	
	Если ЗначениеЗаполнено(УчетныеПолитики) Тогда 
		Элементы.Организации.АвтоОтметкаНезаполненного = Ложь; 
		Элементы.Организации.ОтметкаНезаполненного = Ложь;   	
	КонецЕсли;     
	
	Если ЗначениеЗаполнено(Организации) Тогда 
		Элементы.УчетныеПолитики.АвтоОтметкаНезаполненного = Ложь; 
		Элементы.УчетныеПолитики.ОтметкаНезаполненного = Ложь;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Организации)
		И Не  ЗначениеЗаполнено(УчетныеПолитики) Тогда  
		Элементы.Организации.АвтоОтметкаНезаполненного = Истина; 
		Элементы.УчетныеПолитики.АвтоОтметкаНезаполненного = Истина; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокДокументовБД()
	
	Элементы.ВидыДокумента.СписокВыбора.Очистить();
	Элементы.ВидыДокумента.ПодсказкаВвода = "";
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(ШаблоныКорректировки) Тогда	
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ШаблоныТрансформационныхКорректировок.ДокументБД КАК ДокументБД,
		               |	ШаблоныТрансформационныхКорректировок.ДокументБД.Наименование КАК НаименованиеДокументаБД
		               |ИЗ
		               |	Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
		               |ГДЕ
		               |	ШаблоныТрансформационныхКорректировок.Ссылка В(&ШаблоныКорректировки)";
		
		Запрос.УстановитьПараметр("ШаблоныКорректировки", ШаблоныКорректировки);
		
	Иначе
		
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ШаблоныТрансформационныхКорректировок.ДокументБД КАК ДокументБД,
		               |	ШаблоныТрансформационныхКорректировок.ДокументБД.Наименование КАК НаименованиеДокументаБД
		               |ИЗ
		               |	Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
		               |ГДЕ
		               |	НЕ ШаблоныТрансформационныхКорректировок.Отключен
		               |	И НЕ ШаблоныТрансформационныхКорректировок.ПометкаУдаления
		               |	И НЕ ШаблоныТрансформационныхКорректировок.ДокументБД = ЗНАЧЕНИЕ(Справочник.ДокументыБД.ПустаяСсылка)"
	
	КонецЕсли;
	
	ТабДокументы = Запрос.Выполнить().Выгрузить();
	
	Элементы.ВидыДокумента.СписокВыбора.ЗагрузитьЗначения(ТабДокументы.ВыгрузитьКолонку("ДокументБД"));	
	ТекстДокументы = СтрСоединить(ТабДокументы.ВыгрузитьКолонку("НаименованиеДокументаБД"),",");
	
	Если Элементы.ВидыДокумента.СписокВыбора.Количество() = 0 Тогда
		Элементы.ВидыДокумента.ПодсказкаВвода = НСтр("ru = 'Связанные документы не указаны'");
	Иначе
		Элементы.ВидыДокумента.ПодсказкаВвода = ТекстДокументы;
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура СформироватьСписокШаблоновДокумента()
	
	Элементы.ШаблоныКорректировки.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(ВидыДокумента) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ШаблоныТрансформационныхКорректировок.Ссылка КАК Ссылка,
		               |	ШаблоныТрансформационныхКорректировок.Наименование КАК Наименование
		               |ИЗ
		               |	Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
		               |ГДЕ
		               |	ШаблоныТрансформационныхКорректировок.ДокументБД В(&ДокументБД)
		               |	И НЕ ШаблоныТрансформационныхКорректировок.Отключен
		               |	И НЕ ШаблоныТрансформационныхКорректировок.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ДокументБД", ВидыДокумента);
		
		
		ТабШаблоны = Запрос.Выполнить().Выгрузить();
		
		Элементы.ШаблоныКорректировки.СписокВыбора.ЗагрузитьЗначения(ТабШаблоны.ВыгрузитьКолонку("Ссылка"));	
		ТекстШаблоны = СтрСоединить(ТабШаблоны.ВыгрузитьКолонку("Наименование"),",");
		
		Если Элементы.ШаблоныКорректировки.СписокВыбора.Количество() = 0 Тогда
			
			Элементы.ШаблоныКорректировки.ПодсказкаВвода = НСтр("ru = 'Шаблоны операций не найдены'");
			
		Иначе
			
			Элементы.ШаблоныКорректировки.ПодсказкаВвода = ТекстШаблоны;
			Элементы.ШаблоныКорректировки.КнопкаВыпадающегоСписка = Истина;   
			Элементы.ШаблоныКорректировки.РежимВыбораИзСписка = Истина;
			Элементы.ШаблоныКорректировки.КнопкаВыбора = Ложь;  
			
		КонецЕсли;  
		
		Если Элементы.ШаблоныКорректировки.СписокВыбора.Количество() = 1 Тогда
			
			ШаблоныКорректировки = Элементы.ШаблоныКорректировки.СписокВыбора[0].Значение;
			
		КонецЕсли; 
		
	Иначе
		Элементы.ШаблоныКорректировки.ПодсказкаВвода = "";
		
	КонецЕсли;
	
КонецПроцедуры  
 
&НаСервере
Функция ПолучитьАдресВременногоХранилища()
	
	ТЗ = РеквизитФормыВЗначение("ТабОбработанныхДокументов", Тип("ТаблицаЗначений"));
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ТЗ", ТЗ); 
	// НАЧАЛО Юдина Екатерина 25.05.2026 Выполнение задач №000057752 
	СтруктураДанных.Вставить("БезПроводок", Ложь);
	// КОНЕЦ Юдина Екатерина 25.05.2026 Выполнение задач №000057752
	АдресВХ = ПоместитьВоВременноеХранилище(СтруктураДанных, Новый УникальныйИдентификатор);      

	Возврат АдресВХ;
	
 КонецФункции

&НаСервере
Функция ВыполнитьОбработкуНаСервере() 
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);  	
	ПараметрыВыполнения.Вставить("Организации",          Организации);
	ПараметрыВыполнения.Вставить("УчетныеПолитики",      УчетныеПолитики);
	ПараметрыВыполнения.Вставить("ПериодОбработки",      ПериодОбработки);
	ПараметрыВыполнения.Вставить("ВидыДокумента",        ВидыДокумента);    
	ПараметрыВыполнения.Вставить("ШаблоныКорректировки", ШаблоныКорректировки);
	ПараметрыВыполнения.Вставить("СоздаватьНовые",       СоздаватьНовые);
	ПараметрыВыполнения.Вставить("ТолькоНеобработанные", ТолькоНеобработанные);
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработка.тн_ЗаполнениеКорректировокПоШаблонамСОтборами.МодульОбъекта.ОбработатьКорректировки", ПараметрыВыполнения); 
	
КонецФункции

&НаСервере
Процедура ПолучитьИзВременногоХранилищаНаСервере(АдресРезультата)  
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);   		
	ЗначениеВРеквизитФормы(Данные.Результат, "ТабОбработанныхДокументов"); 
	КоличествоДокументов = ТабОбработанныхДокументов.Количество();
	Если КоличествоДокументов > 0 Тогда	  
		Элементы.ОбработанныеДокументы.Видимость = Истина;
		Элементы.ОбработанныеДокументы.Заголовок = "Открыть обработанные документы (" + КоличествоДокументов + ")"; 	 
	Иначе  
		Элементы.ОбработанныеДокументы.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры  

#КонецОбласти 