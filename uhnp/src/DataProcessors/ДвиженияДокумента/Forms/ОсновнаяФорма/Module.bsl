Процедура ОСВПоСчетуДт(Команда)
	
    КлючВарианта = "ОСВпоСчету";
	Отбор = МСФОКлиентУХ.ПолучитьОтборОтчета(ЭтотОбъект, КлючВарианта, "СчетДт");		
