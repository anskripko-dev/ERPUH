&НаКлиенте
Процедура КнопкаПредыдущийПериод(Команда)
	ИзменитьПериод(-1);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаСледующийПериод(Команда)
	ИзменитьПериод(+1);
КонецПроцедуры    

// Процедура устанавливает границы периода построения отчета.
//
// Параметры:
//  Шаг          - число, количество стандартных периодов, на которое необходимо
//                 сдвигать период построения отчета;
//
&НаСервере
Процедура ИзменитьПериод(Шаг)
	
	Если Объект.Периодичность = Перечисления.Периодичность.ПустаяСсылка() Тогда 
		Объект.Периодичность = Перечисления.Периодичность.Квартал;
	КонецЕсли;
	
	Если НЕ Объект.Периодичность = Перечисления.Периодичность.Квартал Тогда
       Объект.Дата  = КонецМесяца(ДобавитьМесяц(Объект.Дата, 11*Шаг)); 
	Иначе
		Объект.Дата  = КонецМесяца(ДобавитьМесяц(Объект.Дата, 3*Шаг)); 
	КонецЕсли;
	Если Формат(Объект.Дата, "ДФ=к") = "4" Тогда
		ИзменитьПериод(Шаг);
	КонецЕсли;

	ПоказатьПериод();

КонецПроцедуры // ИзменитьПериод()      

// Процедура управляет показом в форме периода построения отчета.
//
&НаСервере 
Процедура ПоказатьПериод()
	
	Если Объект.Периодичность = Перечисления.Периодичность.ПустаяСсылка() Тогда 
		Объект.Периодичность = Перечисления.Периодичность.Квартал;
	КонецЕсли;
	Если НЕ Объект.Периодичность = Перечисления.Периодичность.Квартал Тогда
		СтрПериодОтчета = ПредставлениеПериода(НачалоГода(Объект.Дата), КонецГода(Объект.Дата), "ФП = Истина" );
	Иначе
		СтрПериодОтчета = ПредставлениеПериода(НачалоКвартала(Объект.Дата), КонецКвартала(Объект.Дата), "ФП = Истина" );
    КонецЕсли;
	// Покажем период в диалоге
	Элементы.НадписьПериодСоставления.Заголовок = СтрПериодОтчета;
	
КонецПроцедуры // ПоказатьПериод()

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	ПоказатьПериод();
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ДокументРезультат = СформироватьОтчет();
	ДокументРезультат.Показать();		
КонецПроцедуры

&НаСервере
Функция СформироватьОтчет() Экспорт
		
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет      = ОбработкаОбъект.ПолучитьМакет("СправкаРасчетТН");
	МакетОбщий = ПолучитьОбщийМакет("СправкаРасчет");
	
	ЗаголовокОтчета         = МакетОбщий.ПолучитьОбласть("Заголовок");
	ОбластьШапка            = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока           = Макет.ПолучитьОбласть("Строка");
	ОбластьИтого            = Макет.ПолучитьОбласть("Итого");
	ОбластьОкончаниеТаблицы = Макет.ПолучитьОбласть("ОкончаниеТаблицы");
	ОбластьПодвал           = МакетОбщий.ПолучитьОбласть("Подвал");
	
	Если НЕ Объект.Периодичность = Перечисления.Периодичность.Квартал Тогда 
		ЗаголовокОтчета.Параметры.Период = "" + ПредставлениеПериода(НачалоГода(Объект.Дата), КонецГода(Объект.Дата), "ФП = Истина");
		НачалоПериодаОтчета =  НачалоГода(Объект.Дата);
		КонецПериодаОтчета  =  КонецГода(Объект.Дата);
	Иначе
		ЗаголовокОтчета.Параметры.Период = "" + ПредставлениеПериода(НачалоКвартала(Объект.Дата), КонецКвартала(Объект.Дата), "ФП = Истина");
		НачалоПериодаОтчета =  НачалоКвартала(Объект.Дата);  
		КонецПериодаОтчета  =  КонецКвартала(Объект.Дата);
	КонецЕсли;
	
	СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Объект.Организация, НачалоПериодаОтчета); 
	НазваниеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ПолноеНаименование");

	ЗаголовокОтчета.Параметры.НазваниеОрганизации = НазваниеОрганизации;
	ЗаголовокОтчета.Параметры.ДатаСоставления     = КонецПериодаОтчета;
	ЗаголовокОтчета.Параметры.НазваниеОтчета      = "Авансовый платеж по земельному налогу";
	ДокументРезультат.Вывести(ЗаголовокОтчета,1);
	
	ВысотаЗаголовка = ДокументРезультат.ВысотаТаблицы;
	ДокументРезультат.Вывести(ОбластьШапка,1);
	
	ТаблицаДляПечати = Объект.ЗемельныеУчастки.Выгрузить();
	ТаблицаДляПечати.Сортировать("КодПоОКАТО, НомерСтроки");  
	
	НС = 1; 	
		
	ТекущийОКАТО = "";
	Для Каждого Строка Из ТаблицаДляПечати Цикл  
		Если СокрЛП(ТекущийОКАТО) <> СокрЛП(Строка.КодПоОКАТО) Тогда 
			ТекущийОКАТО = Строка.КодПоОКАТО;
			СтруктураОтбора = Новый Структура("КодПоОКАТО", СокрЛП(ТекущийОКАТО)); 
			МассивСтрокаПоОКАТО = Объект.АвансовыеПлатежи.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрокаПоОКАТО.Количество()<> 0 Тогда
				СтрокаПоОКАТО = МассивСтрокаПоОКАТО[0];				
				ОбластьИтого.Параметры.КодПоОКАТО = ТекущийОКАТО;   
				ОбластьИтого.Параметры.СуммаНалогаПоОКАТО = СтрокаПоОКАТО.Сумма;  
				ОбластьИтого.Параметры.НалоговыйОрган = Строка.НалоговыйОрган;  
			Иначе   
				ОбластьИтого.Параметры.СуммаНалогаПоОКАТО = 0;
			КонецЕсли;	
			
			ДокументРезультат.Вывести(ОбластьИтого,1);
		КонецЕсли; 
		ОбластьСтрока.Параметры.Заполнить(Строка);
		Если Строка.ОбщаяСобственность Тогда
			ОбластьСтрока.Параметры.Доля = Строка(Строка.ДоляВПравеОбщейСобственностиЧислитель) + "/" + Строка(Строка.ДоляВПравеОбщейСобственностиЗнаменатель);
		Иначе
			ОбластьСтрока.Параметры.Доля = "1";
		КонецЕсли;
		ОбластьСтрока.Параметры.НомерСтроки = НС;
		ДокументРезультат.Вывести(ОбластьСтрока,1);
		НС = НС + 1;
		
	КонецЦикла;
	
	ДокументРезультат.Вывести(ОбластьОкончаниеТаблицы,1);
			
	ДокументРезультат.Вывести(ОбластьПодвал,1);
	
	// Зафиксируем заголовок отчета
	ДокументРезультат.ФиксацияСверху=9;
	
	// Присвоим имя для сохранения параметров печати табличного документа
	ДокументРезультат.ИмяПараметровПечати = "Пересчет стоимости отложенных налоговых активов и обязательств";
	
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ДокументРезультат.АвтоМасштаб = Истина;

    УправлениеКолонтитулами.УстановитьКолонтитулы(ДокументРезультат, ЗаголовокОтчета, Строка(Пользователи.ТекущийПользователь()));
	
	Возврат ДокументРезультат;
	
КонецФункции

&НаКлиенте
Процедура ЗемельныеУчасткиПослеУдаления(Элемент)
	ПерезаполнитьАвансовыеПлатежи();
КонецПроцедуры

&НаКлиенте
Процедура ЗемельныеУчасткиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)  	
	Если Копирование Тогда	
		ПерезаполнитьАвансовыеПлатежи();
	ИначеЕсли НоваяСтрока Тогда
		НоваяСтрокаЗаполнитьНаСервере(Элемент.ТекущаяСтрока);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура НоваяСтрокаЗаполнитьНаСервере(СтрокаТабличнойЧасти)
	ТекущаяСтрока = Объект.ЗемельныеУчастки.НайтиПоИдентификатору(СтрокаТабличнойЧасти); 	
	ТекущаяСтрока.ДоляВПравеОбщейСобственностиЧислитель = 1;
	ТекущаяСтрока.ДоляВПравеОбщейСобственностиЗнаменатель = 1;
	ТекущаяСтрока.НалоговаяЛьготаПоНалоговойБазе = Перечисления.ВидНалоговойЛьготыПоНалоговойБазеПоЗемельномуНалогуДо2020.НеПрименяется;
	ТекущаяСтрока.ТекстНалоговойЛьготы = УправлениеВнеоборотнымиАктивамиКлиентСервер.ПредставлениеНалоговойЛьготыПоЗемельномуНалогу(ТекущаяСтрока);
КонецПроцедуры


&НаКлиенте
Процедура ЗемельныеУчасткиКодКатегорииЗемельНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ВыборКода("КодКатегорииЗемель", "КатегорииЗемельныхУчастков", Элементы.ЗемельныеУчастки.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКода(ИмяКода, НазваниеМакета, ТекущиеДанные)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяКода", ИмяКода);
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыборКодаЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	ИмущественныеНалогиКлиент.ВыбратьКодИзКлассификатора(
		ИмяКода, 
		НазваниеМакета, 
		"ПараметрыНачисленияЗемельногоНалога", 
		Объект.Дата, 
		ТекущиеДанные[ИмяКода], 
		ОповещениеОЗакрытии);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборКодаЗавершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		ДопПараметры.ТекущиеДанные[ДопПараметры.ИмяКода] = РезультатЗакрытия;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗемельныеУчасткиКодПоОКАТОПриИзменении(Элемент)
	ПерезаполнитьАвансовыеПлатежи();
КонецПроцедуры

&НаКлиенте
Процедура ЗемельныеУчасткиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.ЗемельныеУчасткиТекстНалоговойЛьготы Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если НЕ ТолькоПросмотр Тогда
			ЗаблокироватьДанныеФормыДляРедактирования();
		КонецЕсли;
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("НастройкаЛьготыПоЗемельномуНалогуЗавершение", ЭтотОбъект);
		ИмущественныеНалогиКлиент.НастройкаЛьготыПоЗемельномуНалогу(
			ЭтотОбъект, Элементы.ЗемельныеУчастки.ТекущиеДанные, ОповещениеОЗакрытии);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЛьготыПоЗемельномуНалогуЗавершение(Результат, ДопПараметры) Экспорт
		
	ТекущиеДанные = Элементы.ЗемельныеУчастки.ТекущиеДанные;
	ТекущиеДанные.ТекстНалоговойЛьготы = ИмущественныеНалогиКлиентСервер.ПредставлениеЛьготыПоЗемельномуНалогу(ТекущиеДанные);
	
КонецПроцедуры
