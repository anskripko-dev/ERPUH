&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	ПараметрПериода = Новый СтандартныйПериод;
	ПараметрПериода.ДатаНачала = Объект.Дата.ДатаНачала;
	ПараметрПериода.ДатаОкончания = Объект.Дата.ДатаОкончания;
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Дата = ПараметрПериода;
	Диалог.Показать(Новый ОписаниеОповещения("РедактироватьПериодЗавершение", ЭтотОбъект));
	
КонецПроцедуры

// Устанавливает значение реквизитов начало и окончание периода по выбранному периоду.
// 
// Параметры:
// 	Результат - СтандартныйПериод, Неопределено - Выбранное значение периода.
// 	ДополнительныеПараметры - Структура - Дополнительные параметры.
&НаКлиенте
Процедура РедактироватьПериодЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Дата.ДатаНачала = Результат.ДатаНачала;
	Объект.Дата.ДатаОкончания = Результат.ДатаОкончания;
	//Объект.НачалоПериода = ?(Объект.НачалоПериода > Объект.ОкончаниеПериода, Объект.ОкончаниеПериода, Объект.НачалоПериода);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда) 
	
	// Проверка реквизитов
    СтруктураПроверки = ПроверитьЗаполненностьРеквизитов();
	Если Не СтруктураПроверки.РезультатПроверки Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураПроверки.СообщениеПользователю);
		Возврат;
	КонецЕсли;

	СтруктураВозврата = ПолучитьЗначенияПеременныхПериода();
	мДатаНачалаПериодаОтчета = СтруктураВозврата.мДатаНачалаПериодаОтчета;
	мДатаКонцаПериодаОтчета = СтруктураВозврата.мДатаКонцаПериодаОтчета;
	СтруктураВозврата.Вставить("Организация", Объект.Организация);
	СтруктураВозврата.Вставить("Периодичность", Объект.Периодичность);

	Если Объект.ЗемельныеУчастки.Количество() > 0 Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВопроса_ОчищениеСпискаДокументов", ЭтотОбъект, СтруктураВозврата);
		ПоказатьВопрос(ОписаниеОповещения, "Перед автозаполнением произойдет очистка табличных частей. Продолжить?", РежимДиалогаВопрос.ДаНет); 
	Иначе
		ЗаполнитьСписокДокументовНаСервере(Объект.Организация, мДатаНачалаПериодаОтчета, мДатаКонцаПериодаОтчета, Объект.Периодичность);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса_ОчищениеСпискаДокументов(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда   
        Возврат;
	КонецЕсли; 
	
	
	Объект.ЗемельныеУчастки.Очистить();
	ЗаполнитьСписокДокументовНаСервере(ДопПараметры.Организация, ДопПараметры.мДатаНачалаПериодаОтчета, ДопПараметры.мДатаКонцаПериодаОтчета, ДопПараметры.Периодичность);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполненностьРеквизитов()
	
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("РезультатПроверки", Истина);
	СтруктураПроверки.Вставить("СообщениеПользователю", "");
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда 		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Заполните поле Организация" + Символы.ПС;
	КонецЕсли; 
		
	Возврат СтруктураПроверки;  
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьСписокДокументовНаСервере(Организация, мДатаНачалаПериодаОтчета, мДатаКонцаПериодаОтчета, Периодичность)   
	
	Объект.АвансовыеПлатежи.Очистить();
	Объект.ЗемельныеУчастки.Очистить();
	
	// Выборка земельных участков и числа полных месяцев владения ими.
	// При этом если возникновение (прекращение) у налогоплательщика в течение налогового периода 
	// права собственности (постоянного (бессрочного) пользования, пожизненного наследуемого владения) 
	// на земельный участок (его долю) произошло до 15-го числа соответствующего месяца включительно, 
	// за полный месяц принимается месяц возникновения указанных прав. Если возникновение (прекращение)
	// указанных прав произошло после 15-го числа соответствующего месяца, за полный месяц принимается 
	// месяц прекращения указанных прав.
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация",    Организация);
	
	Если Периодичность = Перечисления.Периодичность.Квартал Тогда
		ПериодОтчета = НачалоКвартала(мДатаКонцаПериодаОтчета);
	Иначе  
		ПериодОтчета = НачалоГода(мДатаКонцаПериодаОтчета);
	КонецЕсли;
	
	ТекстОбъединяющегоЗапроса = "";
	
	Пока ПериодОтчета <= мДатаКонцаПериодаОтчета Цикл
		
		Запрос.УстановитьПараметр("Период", ПериодОтчета);
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетЗемельногоНалога.ОсновноеСредство КАК ОсновноеСредство, 
		|	РасчетЗемельногоНалога.Организация КАК Организация,
		|	МАКСИМУМ(РасчетЗемельногоНалога.ДатаСведений) КАК ДатаСведений
		|ПОМЕСТИТЬ ВТ_ПоДатамМаксимум" + Формат(ПериодОтчета, "ДФ=MM") + "
		|ИЗ
		|	РегистрСведений.РасчетЗемельногоНалога КАК РасчетЗемельногоНалога
		|ГДЕ
		|	РасчетЗемельногоНалога.Организация = &Организация
		|	И РасчетЗемельногоНалога.ДатаСведений < &Период
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетЗемельногоНалога.ОсновноеСредство,
		|	РасчетЗемельногоНалога.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РасчетЗемельногоНалога.Организация КАК Организация,
		|	РасчетЗемельногоНалога.ОсновноеСредство КАК ОсновноеСредство,
		|	РасчетЗемельногоНалога.ДатаСведений КАК ДатаСведений,
		|	РасчетЗемельногоНалога.ДатаРегистрации КАК ДатаРегистрации,
		|	РасчетЗемельногоНалога.ДатаСнятияСУчета КАК ДатаСнятияСУчета
		|ПОМЕСТИТЬ ВТ_ПоДатам" + Формат(ПериодОтчета, "ДФ=MM") + "
		|ИЗ
		|	РегистрСведений.РасчетЗемельногоНалога КАК РасчетЗемельногоНалога
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоДатамМаксимум" + Формат(ПериодОтчета, "ДФ=MM") + " КАК ВТ_СрезПоследнихПоДатам
		|		ПО РасчетЗемельногоНалога.ОсновноеСредство = ВТ_СрезПоследнихПоДатам.ОсновноеСредство 
		|	 	И РасчетЗемельногоНалога.Организация = ВТ_СрезПоследнихПоДатам.Организация
		|			И (ВТ_СрезПоследнихПоДатам.ДатаСведений = РасчетЗемельногоНалога.ДатаСведений)
		|;
		|//////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(" + Формат(ПериодОтчета, "ДФ=MM") + " КАК ЧИСЛО) КАК НомерМесяца,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследних.Период КАК ДатаРегистрацииЗемли,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследних.КадастроваяСтоимость КАК КадастроваяСтоимость,
		|	NULL КАК НалоговаяЛьготаПоНалоговойБазеДо2020,
		|	1 КАК КоличествоМесяцев, 
		|	ВТ_ПоДатам.ДатаСведений КАК ДатаСведений,
		|	ВТ_ПоДатам.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТ_ПоДатам.ДатаСнятияСУчета КАК ДатаСнятияСУчета,
		|	0 КАК КоличествоМесяцевПримененияЛьготы
		|ПОМЕСТИТЬ
		|	ВладениеЗемельнымиУчастками" + Формат(ПериодОтчета, "ДФ=MM") + "
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|		ПараметрыНачисленияЗемельногоНалогаСрезПоследних.Период КАК Период,
		|		ПараметрыНачисленияЗемельногоНалогаСрезПоследних.КадастроваяСтоимость
		|	ИЗ
		|		РегистрСведений.ПараметрыНачисленияЗемельногоНалога.СрезПоследних(
		|				ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ), ДЕНЬ, 14),
		|				Организация = &Организация) КАК ПараметрыНачисленияЗемельногоНалогаСрезПоследних
		|	ГДЕ
		|		ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ВключатьВНалоговуюБазу = ИСТИНА
		|
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ПараметрыНачисленияЗемельногоНалога.ОсновноеСредство,
		|		ПараметрыНачисленияЗемельногоНалога.Период,  
		|       ПараметрыНачисленияЗемельногоНалога.КадастроваяСтоимость	
		|	ИЗ
		|		РегистрСведений.ПараметрыНачисленияЗемельногоНалога КАК ПараметрыНачисленияЗемельногоНалога
		|	ГДЕ
		|		ПараметрыНачисленияЗемельногоНалога.Организация = &Организация
		|		И ПараметрыНачисленияЗемельногоНалога.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ), ДЕНЬ, 14)
		|		И ПараметрыНачисленияЗемельногоНалога.ВключатьВНалоговуюБазу = ИСТИНА
		|	) КАК ПараметрыНачисленияЗемельногоНалогаСрезПоследних 
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоДатам" + Формат(ПериодОтчета, "ДФ=MM") + " КАК ВТ_ПоДатам
		|		ПО (ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ОсновноеСредство = ВТ_ПоДатам.ОсновноеСредство)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(" + Формат(ПериодОтчета, "ДФ=MM") + " КАК ЧИСЛО) КАК НомерМесяца,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам.ОсновноеСредство КАК ОсновноеСредство,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам.Период КАК ДатаРегистрацииЗемли,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам.КадастроваяСтоимость КАК КадастроваяСтоимость,
		|	ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам.НалоговаяЛьготаПоНалоговойБазеДо2020,
		|	0 КАК КоличествоМесяцев,   
		|	ВТ_ПоДатам.ДатаСведений КАК ДатаСведений,
		|	ВТ_ПоДатам.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТ_ПоДатам.ДатаСнятияСУчета КАК ДатаСнятияСУчета,
		|	1 КАК КоличествоМесяцевПримененияЛьготы
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|			ПараметрыНачисленияЗемельногоНалогаСрезПоследних.Период КАК Период, 
		|			ПараметрыНачисленияЗемельногоНалогаСрезПоследних.КадастроваяСтоимость КАК КадастроваяСтоимость, 
		|			ПараметрыНачисленияЗемельногоНалогаСрезПоследних.НалоговаяЛьготаПоНалоговойБазеДо2020
		|		ИЗ
		|			РегистрСведений.ПараметрыНачисленияЗемельногоНалога.СрезПоследних(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -1), МЕСЯЦ),
		|					Организация = &Организация) КАК ПараметрыНачисленияЗемельногоНалогаСрезПоследних
		|		ГДЕ
		|			ПараметрыНачисленияЗемельногоНалогаСрезПоследних.ВключатьВНалоговуюБазу = ИСТИНА
		|			И ПараметрыНачисленияЗемельногоНалогаСрезПоследних.НалоговаяЛьготаПоНалоговойБазеДо2020 <> ЗНАЧЕНИЕ(Перечисление.ВидНалоговойЛьготыПоНалоговойБазеПоЗемельномуНалогуДо2020.НеПрименяется)
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ПараметрыНачисленияЗемельногоНалога.ОсновноеСредство,
		|			ПараметрыНачисленияЗемельногоНалога.Период КАК Период, 
		|			ПараметрыНачисленияЗемельногоНалога.КадастроваяСтоимость, 
		|			ПараметрыНачисленияЗемельногоНалога.НалоговаяЛьготаПоНалоговойБазеДо2020
		|		ИЗ
		|			РегистрСведений.ПараметрыНачисленияЗемельногоНалога КАК ПараметрыНачисленияЗемельногоНалога
		|		ГДЕ
		|			ПараметрыНачисленияЗемельногоНалога.Организация = &Организация
		|			И ПараметрыНачисленияЗемельногоНалога.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
		|			И ПараметрыНачисленияЗемельногоНалога.ВключатьВНалоговуюБазу = ИСТИНА
		|			И ПараметрыНачисленияЗемельногоНалога.НалоговаяЛьготаПоНалоговойБазеДо2020 <> ЗНАЧЕНИЕ(Перечисление.ВидНалоговойЛьготыПоНалоговойБазеПоЗемельномуНалогуДо2020.НеПрименяется)
		|		) КАК ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам 
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоДатам" + Формат(ПериодОтчета, "ДФ=MM") + " КАК ВТ_ПоДатам
		|		ПО (ПараметрыНачисленияЗемельногоНалогаСрезПоследнихПоЛьготам.ОсновноеСредство = ВТ_ПоДатам.ОсновноеСредство)
		|";
		Запрос.Выполнить();
		
		ТекстОбъединяющегоЗапроса = ТекстОбъединяющегоЗапроса
								  + ?(ПустаяСтрока(ТекстОбъединяющегоЗапроса), 
									  "ВЫБРАТЬ РАЗРЕШЕННЫЕ *
		                              |",
									  "ОБЪЕДИНИТЬ ВСЕ
									  |ВЫБРАТЬ *
		                              |")
								  + ?(ПустаяСтрока(ТекстОбъединяющегоЗапроса), 
									  "ПОМЕСТИТЬ ВладениеЗемельнымиУчастками
									  |",
									  "")
								  + "ИЗ ВладениеЗемельнымиУчастками" + Формат(ПериодОтчета, "ДФ=MM") + "
									|";
		
		ПериодОтчета = ДобавитьМесяц(ПериодОтчета, 1);	
		
	КонецЦикла;
	
	Запрос.Текст = ТекстОбъединяющегоЗапроса;
	Запрос.Выполнить();

	Если Периодичность = Перечисления.Периодичность.Квартал Тогда 
		Запрос.УстановитьПараметр("Период", КонецКвартала(мДатаНачалаПериодаОтчета));
		//ПериодОтчета = НачалоКвартала(мДатаКонцаПериодаОтчета);
	Иначе 
		Запрос.УстановитьПараметр("Период", КонецГода(мДатаНачалаПериодаОтчета));

		//ПериодОтчета = НачалоГода(мДатаКонцаПериодаОтчета);
	КонецЕсли; 
	
		Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(РасчетЗемельногоНалога.ДатаСнятияСУчета) КАК ДатаСнятияСУчета,
	|	МАКСИМУМ(РасчетЗемельногоНалога.ДатаСведений) КАК ДатаСведений,
	|	РасчетЗемельногоНалога.ОсновноеСредство КАК ОсновноеСредство,
