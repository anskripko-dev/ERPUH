&НаСервере
Процедура НайтиНеПроведенныеИсходныеДокументыНаСервере()
	УстановитьПривилегированныйРежим(Истина);
	
	ТабДокументы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СправочникДокументыБД.Ссылка КАК Ссылка,
	|	СправочникДокументыБД.Наименование КАК Наименование,
	|	СправочникДокументыБД.Синоним КАК Синоним,
	|	ВЫБОР
	|		КОГДА ШаблоныКорректировок.ДокументБД ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНастройки
	|ИЗ
	|	Справочник.ДокументыБД КАК СправочникДокументыБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ШаблоныТрансформационныхКорректировок.ДокументБД КАК ДокументБД
	|		ИЗ
	|			Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок) КАК ШаблоныКорректировок
	|		ПО СправочникДокументыБД.Ссылка = ШаблоныКорректировок.ДокументБД
	|ГДЕ
	|	НЕ СправочникДокументыБД.ОтсутствуетВКонфигурации
	|	И СправочникДокументыБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И ВЫБОР
	|			КОГДА ШаблоныКорректировок.ДокументБД ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	ВыборкаВидыДок = Запрос.Выполнить().Выбрать();
	
	ЗапросИсходные = Новый Запрос;
	ЗапросИсходные.УстановитьПараметр("НачДата", Дата(2024,1,1));
	
	НомерСтроки = 0;
	Пока ВыборкаВидыДок.Следующий() Цикл
		
		ЗапросИсходные.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МСФО.Регистратор КАК ТрансформационнаяКорректировка,
		|	ВЫРАЗИТЬ(МСФО.Регистратор КАК Документ.ТрансформационнаяКорректировка).Представление КАК ТрансформационнаяКорректировкаПредставление,
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент,
		|	ВЫРАЗИТЬ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК Документ.АвансовыйОтчет).Представление КАК ИсходныйДокументПредставление
		|ИЗ
		|	РегистрБухгалтерии.МСФО КАК МСФО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
		|		ПО (МСФО.Регистратор >= &НачДата)
		|			И МСФО.Регистратор = ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения
		|			И (ВЫРАЗИТЬ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК Документ.АвансовыйОтчет).ПометкаУдаления)
		|			И НЕ ВЫРАЗИТЬ(МСФО.Регистратор КАК Документ.ТрансформационнаяКорректировка).Представление Есть NULL";
		ЗапросИсходные.Текст = СтрЗаменить(ЗапросИсходные.Текст,"АвансовыйОтчет",ВыборкаВидыДок.Наименование);
		
		ВыборкаИсходные = ЗапросИсходные.Выполнить().Выбрать();
		Пока ВыборкаИсходные.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;

			//ТекстСообщения = СтрШаблон("%1 - %2", ВыборкаИсходные.ИсходныйДокументПредставление, ВыборкаИсходные.ТрансформационнаяКорректировкаПредставление);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			СтрокаТЗ = ТабДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ,ВыборкаИсходные);
			СтрокаТЗ.НомерСтроки = НомерСтроки;
		КонецЦикла;
		
	КонецЦикла;
	
	
КонецПроцедуры
