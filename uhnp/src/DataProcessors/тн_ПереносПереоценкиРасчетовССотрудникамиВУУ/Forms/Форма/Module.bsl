
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Период.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	Объект.Период.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	ПериодНаФорме = Объект.Период.ДатаНачала;
	МесяцСтрокой = ОбщегоНазначенияУТКлиентСервер.ПолучитьПредставлениеПериодаРегистрации(ПериодНаФорме);
	Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаСервере
Процедура ВыполнитьПереносПереоценкиНаСервере()

	УстановитьПривилегированныйРежим(Истина);
	МВТ = Новый МенеджерВременныхТаблиц;
	ПолучитьТаблицуПроводок(Объект.Период, Объект.Организация, МВТ);
	ДанныеЗаполнения = ФормированиеТаблицДвижений(МВТ);
	СуществующиеДвижения = ПолучениеДвиженийРегистровНакопления();
	ДозаполнитьТаблицыНалогами(ДанныеЗаполнения);
	ДозаполнитьТаблицыПодразделениями(ДанныеЗаполнения);
	СформироватьДанныеДляПроведения(ДанныеЗаполнения, СуществующиеДвижения);
	СформироватьДвижения(ДанныеЗаполнения);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПереносПереоценки(Команда)
	
	ВыполнитьПереносПереоценкиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Данные

&НаСервере
Функция СчетаПереоценки()
	
	СчПереоценки = Новый Массив;
	
	// 69 счета
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ФСС);
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ПФР_страх);
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ПФР_доп);
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ПФР_ОПС);
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ФФОМС);
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.ФСС_НСиПЗ);
	
	// 70
	СчПереоценки.Добавить(ПланыСчетов.Хозрасчетный.РасчетыСПерсоналомПоОплатеТруда);
	
	Возврат СчПереоценки;
	
КонецФункции

&НаСервере
Функция КорСчета()
	
	КС = Новый Массив;
	КС.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеДоходы);
	КС.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеРасходы);
	Возврат КС;
	
КонецФункции

