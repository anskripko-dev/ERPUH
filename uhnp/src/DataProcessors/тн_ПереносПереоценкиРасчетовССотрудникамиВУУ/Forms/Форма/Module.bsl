&НаСервере
Процедура СформироватьДанныеДляПроведения(ИсходныеДанные, ДанныеДляУдаления)
	
	Для Каждого ЭлементКоллекции из ДанныеДляУдаления Цикл
		
		ИмяТаблицы = ЭлементКоллекции.Ключ;
		ТаблицаИсходныхДанных = ИсходныеДанные[ИмяТаблицы];
		ТаблицаУдаления = ЭлементКоллекции.Значение;
		Для Каждого СтрокаПоиска Из ТаблицаУдаления Цикл
			
			ПараметрыПоиска = Новый Структура;
			Для КолонкаТЗ=0 По ТаблицаУдаления.Колонки.Количество()-1 Цикл
				ИмяПоля = ТаблицаУдаления.Колонки[КолонкаТЗ].Имя;
				ЗначениеПоля = СтрокаПоиска[КолонкаТЗ];
				Если ИмяПоля<>"НомерСтроки" Или ИмяПоля<>"ХозяйственнаяОперация" Или ИмяПоля<>"ИмяРегистра" 
				Или Прав(ИмяПоля,1)<>"_" Тогда
					Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
						ПараметрыПоиска.Вставить(ИмяПоля, ЗначениеПоля);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла; 
			
			Если ТаблицаИсходныхДанных.Количество()>0 Тогда
				мИскомыеСтроки = ТаблицаИсходныхДанных.НайтиСтроки(ПараметрыПоиска);
				Если мИскомыеСтроки.Количество()>0  Тогда       
					Для Каждого НайденнаяСтрока из мИскомыеСтроки Цикл
						ТаблицаИсходныхДанных.Удалить(НайденнаяСтрока);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Движения

&НаСервере
Процедура СформироватьДвижения(ТаблицыДвижений)
	
	ФормироватьДвижения = Ложь;
	РегистрыДокументаОснования = Новый ТаблицаЗначений;
	РегистрыДокументаОснования.Колонки.Добавить("Имя");
	Для Каждого ТД Из ТаблицыДвижений Цикл
		ЕстьПроводки = ТД.Значение.Количество()>0;
		Если ЕстьПроводки Тогда
			НовСтрРегистры = РегистрыДокументаОснования.Добавить();
			НовСтрРегистры.Имя = ТД.Ключ;
		КонецЕсли;
		ФормироватьДвижения = ФормироватьДвижения Или ЕстьПроводки;
	КонецЦикла;
	
	Если ФормироватьДвижения Тогда
		Попытка
			НачатьТранзакцию();
			НовДок = Документы.КорректировкаРегистров.СоздатьДокумент();
			НовДок.Организация = Объект.Организация;
			НовДок.Ответственный = Объект.Ответственный;
			НовДок.Дата = Объект.Период.ДатаОкончания;
			НовДок.ТаблицаРегистров.Загрузить(РегистрыДокументаОснования);
			НовДок.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;    
			НовДок.Комментарий = "#Отражение курсовых разниц по расчетам с персоналом за "+МесяцСтрокой;
			Для Каждого Табл из ТаблицыДвижений Цикл
				ИмяРегистра = Табл.Ключ; 
				ТаблицаДвижений = Табл.Значение;  
				ДвиженияРегистра = НовДок.Движения[ИмяРегистра];
				ДвиженияРегистра.Записывать = Истина;
				Для Каждого ДанныеДвижения Из ТаблицаДвижений Цикл 
					НовДвижение = ДвиженияРегистра.Добавить();
					ЗаполнитьЗначенияСвойств(НовДвижение, ДанныеДвижения);
				КонецЦикла;
			КонецЦикла; 
			НовДок.Записать();
			ЗафиксироватьТранзакцию();               
			СообщШаблон = НСтр("ru='Выполнен перенос проводок c %1 по %2. Создан документ %3'");
			Сообщение = СтрШаблон(СообщШаблон, Объект.Период.ДатаНачала, Объект.Период.ДатаОкончания, НовДок.Ссылка); 
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			СообщШаблон = НСтр("ru='Ошибка переноса. Документ и движения по регистрам не сформированы по причине: %1'");
			Сообщение = СтрШаблон(СообщШаблон, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
		КонецПопытки;                 
	Иначе
		СообщШаблон = НСтр("ru='В периоде %1  нет проводок для переноса'");
		Сообщение = СтрШаблон(СообщШаблон, МесяцСтрокой); 
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	КонецЕсли;
	
КонецПроцедуры    

#КонецОбласти

#Область Период

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение", ЭтотОбъект);
	ПараметрыФормы 	   = Новый Структура("Значение, РежимВыбораПериода", ПериодНаФорме, "МЕСЯЦ");
	
	ОткрытьФорму("ОбщаяФорма.ВыборПериода",
		ПараметрыФормы, 
		ЭтотОбъект, 
		УникальныйИдентификатор,
		,
		, 
		ОбработчикЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	ОбщегоНазначенияУТКлиент.РегулированиеПредставленияПериодаРегистрации(
		Направление,
		СтандартнаяОбработка,
		ПериодНаФорме,
		МесяцСтрокой);
	
	Объект.Период.ДатаОкончания = КонецМесяца(ПериодНаФорме);
	Объект.Период.ДатаНачала = НачалоМесяца(ПериодНаФорме);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйПериод <> Неопределено Тогда
		
		ПериодНаФорме = ВыбранныйПериод;
		МесяцСтрокой = ОбщегоНазначенияУТКлиентСервер.ПолучитьПредставлениеПериодаРегистрации(ПериодНаФорме);
		Объект.Период.ДатаОкончания = КонецМесяца(ПериодНаФорме);
		Объект.Период.ДатаНачала = НачалоМесяца(ПериодНаФорме);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
