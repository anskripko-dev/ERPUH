&НаСервере
Функция СоответствиеСчетовИВидовОперацииПоЗП()
	
	СчетаИНалоги = Новый Соответствие;
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ФСС, Перечисления.ВидыОперацийПоЗарплате.ФСС);
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ПФР_страх, Перечисления.ВидыОперацийПоЗарплате.ПФРСтраховаяЧасть);
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ПФР_доп,Перечисления.ВидыОперацийПоЗарплате.ПФРДополнительныйТарифЛЭ);
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ПФР_ОПС,Перечисления.ВидыОперацийПоЗарплате.ПФР);
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ФФОМС, Перечисления.ВидыОперацийПоЗарплате.ФФОМС);
	СчетаИНалоги.Вставить(ПланыСчетов.Хозрасчетный.ФСС_НСиПЗ,Перечисления.ВидыОперацийПоЗарплате.ФССНС);
	Возврат СчетаИНалоги;    
	
КонецФункции

&НаСервере
Процедура ДозаполнитьТаблицыНалогами(ТаблицыДвижений) 
	
	Для Каждого ТаблицаДвижений Из ТаблицыДвижений Цикл
		Если ТаблицаДвижений.Ключ = "ПрочиеАктивыПассивы" Тогда
			Отбор = Новый Структура("Аналитика_", "Налог");
			МассивНайденныхСтрок = ТаблицаДвижений.Значение.НайтиСтроки(Отбор);
			ДозаполнитьНайденныеСтроки(МассивНайденныхСтрок,"Аналитика");
		ИначеЕсли ТаблицаДвижений.Ключ = "ДвиженияДоходыРасходыПрочиеАктивыПассивы" Тогда
			Отбор = Новый Структура("АналитикаАктивовПассивов_", "Налог");
			МассивНайденныхСтрок = ТаблицаДвижений.Значение.НайтиСтроки(Отбор);
			ДозаполнитьНайденныеСтроки(МассивНайденныхСтрок,"АналитикаАктивовПассивов");
			
			Отбор = Новый Структура("ВидОперацииПоЗарплате_", "ВидОперацииПоЗПНалог");
			МассивНайденныхСтрок = ТаблицаДвижений.Значение.НайтиСтроки(Отбор);
			ДозаполнитьНайденныеСтроки(МассивНайденныхСтрок,"ВидОперацииПоЗарплате");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры                                                                   

&НаСервере
Процедура ДозаполнитьНайденныеСтроки(МассивСтрок, ИмяКолонки)
	
	СоответствияНалогов = Новый Структура;
	СоответствияНалогов.Вставить("Аналитика",СоответствиеСчетовИНалогов());
	СоответствияНалогов.Вставить("АналитикаАктивовПассивов",СоответствиеСчетовИНалогов());
	СоответствияНалогов.Вставить("ВидОперацииПоЗарплате",СоответствиеСчетовИВидовОперацииПоЗП());
	Для Каждого СтрокаТЗ из МассивСтрок Цикл
		СтрокаТЗ[ИмяКолонки] = СоответствияНалогов[ИмяКолонки][СтрокаТЗ.СчетНалога];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере 
Процедура ДозаполнитьТаблицыПодразделениями(ТаблицыДвижений)

	Для Каждого ТаблицаДвижений Из ТаблицыДвижений Цикл
		Если ТаблицаДвижений.Ключ = "ПрочиеАктивыПассивы" Тогда
			Для Каждого СтрокаТЗ Из ТаблицаДвижений.Значение Цикл
				Если ТипЗнч(СтрокаТЗ.Аналитика)=Тип(Справочники.ФизическиеЛица) Тогда
					СтрокаТЗ.Подразделение = ПолучитьПодразделениеСотрудника(СтрокаТЗ.Аналитика, СтрокаТЗ.Период);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТаблицаДвижений.Ключ = "ДвиженияДоходыРасходыПрочиеАктивыПассивы" Тогда
			Для Каждого СтрокаТЗ Из ТаблицаДвижений.Значение Цикл
				Если ТипЗнч(СтрокаТЗ.АналитикаАктивовПассивов)=Тип(Справочники.ФизическиеЛица) Тогда
					СтрокаТЗ.Подразделение = ПолучитьПодразделениеСотрудника(СтрокаТЗ.АналитикаАктивовПассивов, СтрокаТЗ.Период);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьПодразделениеСотрудника(Физлицо, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение КАК ТекущееПодразделение
	               |ИЗ
	               |	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	               |ГДЕ
	               |	ТекущиеКадровыеДанныеСотрудников.ДатаПриема >= &Дата
	               |	И ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения <= &Дата
	               |	И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо";
	Запрос.УстановитьПараметр("ФизическоеЛицо", Физлицо); 
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выполнить();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Подразделение;
	КонецЦикла;                           
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПолучитьТаблицуПроводок(Период, Организация, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетаПереоценки", СчетаПереоценки());
	Запрос.УстановитьПараметр("КорСчета", КорСчета());
	Запрос.УстановитьПараметр("Д_КурсовыеРазницы", ПланыВидовХарактеристик.СтатьиДоходов.КурсовыеРазницы);
	Запрос.УстановитьПараметр("Р_КурсовыеРазницы", ПланыВидовХарактеристик.СтатьиРасходов.КурсовыеРазницы);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ХозрасчетныйДвиженияССубконто.Период КАК Период,
	               |	ХозрасчетныйДвиженияССубконто.Регистратор КАК Регистратор,
	               |	ХозрасчетныйДвиженияССубконто.Организация КАК Организация,
	               |	ХозрасчетныйДвиженияССубконто.СчетДт КАК СчетДт,
	               |	ХозрасчетныйДвиженияССубконто.СчетКт КАК СчетКт,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	               |	ХозрасчетныйДвиженияССубконто.ВалютаДт КАК ВалютаДт,
	               |	ХозрасчетныйДвиженияССубконто.ВалютаКт КАК ВалютаКт,
	               |	ХозрасчетныйДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	               |	ХозрасчетныйДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	               |	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	               |	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	               |	ХозрасчетныйДвиженияССубконто.Сумма КАК Сумма,
	               |	ХозрасчетныйДвиженияССубконто.Активность КАК Активность,
	               |	ХозрасчетныйДвиженияССубконто.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ВТ_ПроводкиБУ
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНачала, &ДатаКонца, Организация = &Организация, , ) КАК ХозрасчетныйДвиженияССубконто
	               |ГДЕ
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт1 = &Д_КурсовыеРазницы
	               |	И ХозрасчетныйДвиженияССубконто.СчетДт В(&СчетаПереоценки)
	               |	И ХозрасчетныйДвиженияССубконто.СчетКт В(&КорСчета)
	               |	И ХозрасчетныйДвиженияССубконто.Активность
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ХозрасчетныйДвиженияССубконто.Период,
	               |	ХозрасчетныйДвиженияССубконто.Регистратор,
	               |	ХозрасчетныйДвиженияССубконто.Организация,
	               |	ХозрасчетныйДвиженияССубконто.СчетДт,
	               |	ХозрасчетныйДвиженияССубконто.СчетКт,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт1,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт2,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт3,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт1,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт2,
	               |	ХозрасчетныйДвиженияССубконто.СубконтоКт3,
	               |	ХозрасчетныйДвиженияССубконто.ВалютаДт,
	               |	ХозрасчетныйДвиженияССубконто.ВалютаКт,
	               |	ХозрасчетныйДвиженияССубконто.ПодразделениеДт,
	               |	ХозрасчетныйДвиженияССубконто.ПодразделениеКт,
	               |	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиДт,
	               |	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиКт,
	               |	ХозрасчетныйДвиженияССубконто.Сумма,
	               |	ХозрасчетныйДвиженияССубконто.Активность,
	               |	ХозрасчетныйДвиженияССубконто.НомерСтроки
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНачала, &ДатаКонца, Организация = &Организация, , ) КАК ХозрасчетныйДвиженияССубконто
	               |ГДЕ
	               |	ХозрасчетныйДвиженияССубконто.СубконтоДт1 = &Р_КурсовыеРазницы
	               |	И ХозрасчетныйДвиженияССубконто.СчетДт В(&КорСчета)
	               |	И ХозрасчетныйДвиженияССубконто.СчетКт В(&СчетаПереоценки)
	               |	И ХозрасчетныйДвиженияССубконто.Активность";
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере
Функция ФормированиеТаблицДвижений(МенВремТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенВремТаблиц;
	Запрос.УстановитьПараметр("КорСчета", КорСчета());
	Запрос.УстановитьПараметр("СчетаПереоценки", СчетаПереоценки());
	Запрос.УстановитьПараметр("СтатьяДоходыТекущегоПериода", ПланыВидовХарактеристик.СтатьиАктивовПассивов.ДоходыТекущегоПериода);
	Запрос.УстановитьПараметр("СтатьяРасходыТекущегоПериода", ПланыВидовХарактеристик.СтатьиАктивовПассивов.РасходыТекущегоПериода);
