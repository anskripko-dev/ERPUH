&НаКлиенте
Процедура СоздатьДокументы(Команда)
	
	
	Если ЭтоДолжник Тогда 
		Если НЕ ЗначениеЗаполнено(КорректировкаДолжникФИДебет) Тогда
			СоздатьКорректировкаДолжникФИДебет();	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(КорректировкаДолжникФИКредит) Тогда
			СоздатьКорректировкаДолжникФИКредит();	
		КонецЕсли;
		
	КонецЕсли;	
			
		
	Если ЭтоЦедент И НЕ ЭтоЗаем Тогда
		Если НЕ ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедент) Тогда
			СоздатьПрочиеДоходыРасходыЦедент();	
		КонецЕсли;
				
		Если НЕ ЗначениеЗаполнено(КорректировкаЗадолженности) Тогда
			СоздатьКорректировкаЗадолженностиЦедент();
		КонецЕсли;                   
	ИначеЕсли ЭтоЦедент Тогда	
		
		Если НЕ ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедентЗаем) Тогда
			СоздатьПрочиеДоходыРасходыЦедентЗаем();	
		КонецЕсли;   
		Если НЕ ЗначениеЗаполнено(КорректировкаЦедентФИ) Тогда
			СоздатьКорректировкаФИЦедент();	
		КонецЕсли;   
		Если НЕ ЗначениеЗаполнено(РеализацияЦедент) Тогда
			СоздатьРеализацияЦедент();	
		КонецЕсли;   
	
	КонецЕсли;     

	Если ЭтоЦессионарий И НЕ ЭтоЗаем Тогда
		
		Если НЕ ЗначениеЗаполнено(ПоступлениеЦессионарий) Тогда
			СоздатьПоступлениеЦессионарий();
		КонецЕсли; 
		Если НЕ ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарий) Тогда
			СоздатьПрочиеДоходыРасходыЦессионарий();
		КонецЕсли;  
		Если НЕ ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийПоставка) Тогда
			СоздатьЗаписьКнигиПродажЦессионарийПоставка();
		КонецЕсли;  
	ИначеЕсли ЭтоЦессионарий Тогда
		
		Если НЕ ЗначениеЗаполнено(ПоступлениеЦессионарийЗаем) Тогда
			СоздатьПоступлениеЦессионарийЗаем();
		КонецЕсли; 
		Если НЕ ЗначениеЗаполнено(КорректировкаЦессионарийФИ) Тогда
			СоздатьКорректировкаЗадолженностиФИЦессионарий();
		КонецЕсли;  
		Если НЕ ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарийЗаем) Тогда
			СоздатьПрочиеДоходыРасходыЦессионарийЗаем();
		КонецЕсли;   
		Если НЕ ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийЗаем) Тогда
			СоздатьЗаписьКнигиПродажЦессионарийЗаем();
		КонецЕсли; 

	КонецЕсли;

	УправлениеФормой();
	
КонецПроцедуры

