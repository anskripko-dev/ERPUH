		ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеДоходы; 	
	Иначе
		ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеРасходы; 
	КонецЕсли;	      
	ДокументОбъект.ПрочиеДоходы.Очистить();
	ДокументОбъект.ПрочиеРасходы.Очистить();
	
	Если ЭтоДоход Тогда 
		СтрокаОперации = ДокументОбъект.ПрочиеДоходы.Добавить();
		СтрокаОперации.СтатьяДоходов = Константы.СтатьяДоходовЦессии.Получить();
	Иначе	
		СтрокаОперации = ДокументОбъект.ПрочиеРасходы.Добавить();	           
		СтрокаОперации.СтатьяРасходов = Константы.СтатьяРасходовЦессии.Получить();
	КонецЕсли;	
	
	СтрокаОперации.СтатьяАктивовПассивов 	= Константы.СтатьяОтраженияЦессии.Получить();
	СтрокаОперации.Сумма 			= СуммаПремии;
	СтрокаОперации.Подразделение 	= РеквизитыЦессии.Подразделение;
	СтрокаОперации.СуммаРегл 		= СуммаПремии;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение); 
	ПрочиеДоходыРасходыЦессионарий = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);
   
КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкаЗадолженностиФИЦессионарий()
		
	СтруктураРеквизитов = ЦессииУХ.РеквизитыЦессионарий(); 
	
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	Если ЗначениеЗаполнено(КорректировкаЦессионарийФИ) Тогда
    	ДокументОбъект 				= КорректировкаЦессионарийФИ.ПолучитьОбъект();
	Иначе
		ДокументОбъект 				= Документы.КорректировкаЗадолженностиПоФинансовымИнструментам.СоздатьДокумент();	
	КонецЕсли;
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	Если Не ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата 		= ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДокументОбъект.Комментарий 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	ДокументОбъект.Автор		= Пользователи.ТекущийПользователь();
	ДокументОбъект.Договор		= РеквизитыЦессии.ДоговорДолжника;
	ДокументОбъект.Контрагент	= РеквизитыЦессии.Должник;
	ДокументОбъект.Партнер		= РеквизитыЦессии.ПартнерДолжника;
	ДокументОбъект.ХарактерДоговора 		= Перечисления.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм;
	ДокументОбъект.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности;
	ДокументОбъект.СтатьяРасходов 			= Константы.СтатьяРасходовЦессии.Получить();
	
	ДокументОбъект.Задолженность.Очистить();
	СтрокаЗадолженности = ДокументОбъект.Задолженность.Добавить();
	СтрокаЗадолженности.ТипСуммы 	= Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг;
	СтрокаЗадолженности.Сумма 		= РеквизитыЦессии.СуммаОбязательства;
		
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);   
	КорректировкаЦессионарийФИ = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);
   
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаписьКнигиПродажЦессионарийПоставка()
	
	СтруктураРеквизитов = ЦессииУХ.РеквизитыЦессионарий();
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	СуммаПремии = РеквизитыЦессии.СуммаДокумента - РеквизитыЦессии.СуммаОбязательства;
	Если СуммаПремии <= 0 Тогда
		Возврат;	
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийПоставка) Тогда
    	ДокументОбъект 				= ЗаписьКнигиПродажЦессионарийПоставка.ПолучитьОбъект();
	Иначе
		ДокументОбъект 				= Документы.ЗаписьКнигиПродаж.СоздатьДокумент();	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата 		= ТекущаяДатаСеанса();
	КонецЕсли;
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	ДокументОбъект.Комментарий 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	ДокументОбъект.ХозяйственнаяОперация		= Перечисления.ХозяйственныеОперации.ПрочееНачислениеНДС;
	ДокументОбъект.Валюта		= РеквизитыЦессии.ВалютаДокумента;
	ДокументОбъект.СуммаДокумента = СуммаПремии; 
	ДокументОбъект.Контрагент	= РеквизитыЦессии.Контрагент;
	
	ДокументОбъект.Ценности.Очистить();
	СтрокаЦенности = ДокументОбъект.Ценности.Добавить();
	СтрокаЦенности.ВидЦенности 	= Перечисления.ВидыЦенностей.ПрочиеРаботыИУслуги;
	СтрокаЦенности.Событие		= Перечисления.СобытияПоНДСПродажи.Оплата;
	СтрокаЦенности.Количество 	= 1;          
	СтрокаЦенности.Цена 		= СуммаПремии;
	СтрокаЦенности.Сумма 		= СуммаПремии;
	СтрокаЦенности.СуммаНДС		= РеквизитыЦессии.СуммаНДС;
	СтрокаЦенности.СтавкаНДС	= РеквизитыЦессии.СтавкаНДС;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);  
	ЗаписьКнигиПродажЦессионарийПоставка = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);
		
КонецПроцедуры

