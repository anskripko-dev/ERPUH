КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкаФИЦедент()

	СтруктураРеквизитов = ЦессииУХ.РеквизитыЦедент();

	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	Если ЗначениеЗаполнено(КорректировкаЦедентФИ) Тогда
		ДокументОбъект 			= КорректировкаЦедентФИ.ПолучитьОбъект();	
	Иначе
		ДокументОбъект 			= Документы.КорректировкаЗадолженностиПоФинансовымИнструментам.СоздатьДокумент();		
	КонецЕсли;
	
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата 		= ТекущаяДатаСеанса();         
	КонецЕсли;	
	ДокументОбъект.Автор 	= Пользователи.ТекущийПользователь();
	ДокументОбъект.Комментарий 	= СтрШаблон(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	ДокументОбъект.Комментарий 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	ДокументОбъект.Автор		= Пользователи.ТекущийПользователь();
	ДокументОбъект.Договор		= РеквизитыЦессии.ДоговорДолжника;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности;
	ДокументОбъект.ХарактерДоговора		 = Перечисления.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм;
	ДокументОбъект.Контрагент 	= РеквизитыЦессии.Должник;
	ДокументОбъект.Партнер	 	= РеквизитыЦессии.ПартнерДолжник;
	ДокументОбъект.СтатьяДоходов = Константы.СтатьяОтраженияЦессии.Получить();

	
	ДокументОбъект.Задолженность.Очистить();
	СтрокаЗадолженности  = ДокументОбъект.Задолженность.Добавить();
	СтрокаЗадолженности.ТипСуммы 	= Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг;
	СтрокаЗадолженности.Сумма 		= РеквизитыЦессии.СуммаОбязательства;

	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КорректировкаЦедентФИ = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);

КонецПроцедуры

&НаСервере
Функция СуммаОсновногоДолгаЦессии()
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	СУММА(ЦессияИсходящаяТекущаяЗадолженность.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ЦессияИсходящая.ТекущаяЗадолженность КАК ЦессияИсходящаяТекущаяЗадолженность
		|ГДЕ
		|	ЦессияИсходящаяТекущаяЗадолженность.ЭлементСтруктурыЗадолженности <> &ЭлементСтруктурыЗадолженности
		|	И ЦессияИсходящаяТекущаяЗадолженность.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", 						Цессия);
	Запрос.УстановитьПараметр("ЭлементСтруктурыЗадолженности", 	Перечисления.ЭлементыСтруктурыЗадолженности.Проценты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Итог = 0 ;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Итог = ВыборкаДетальныеЗаписи.Сумма;
	КонецЦикла;                             
	
	Возврат Итог;

КонецФункции // ()

&НаСервере
Функция СуммаОсновногоДолгаЦессииДолжника()
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	СУММА(ЦессияДолжника.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ЦессияДолжника.ТекущаяЗадолженность КАК ЦессияДолжника
		|ГДЕ
		|	ЦессияДолжника.ЭлементСтруктурыЗадолженности <> &ЭлементСтруктурыЗадолженности
		|	И ЦессияДолжника.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", 						Цессия);
	Запрос.УстановитьПараметр("ЭлементСтруктурыЗадолженности", 	Перечисления.ЭлементыСтруктурыЗадолженности.Проценты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Итог = 0 ;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Итог = ВыборкаДетальныеЗаписи.Сумма;
	КонецЦикла;                             
	
	Возврат Итог;

КонецФункции // ()

&НаСервере
Процедура ПерезаполнитьНаСервере()
	
	Если ЭтоДолжник	И ЗначениеЗаполнено(КорректировкаДолжник) Тогда
		СоздатьКорректировкуДолгаДолжник();
	КонецЕсли;    
	Если ЭтоДолжник	И ЗначениеЗаполнено(КорректировкаДолжникФИКредит) Тогда
		СоздатьКорректировкаДолжникФИКредит();
	КонецЕсли; 
	Если ЭтоДолжник	И ЗначениеЗаполнено(КорректировкаДолжникФИДебет) Тогда
		СоздатьКорректировкаДолжникФИДебет();
	КонецЕсли; 

	Если ЭтоЦессионарий	И ЗначениеЗаполнено(ПоступлениеЦессионарий) Тогда
		СоздатьПоступлениеЦессионарий();
	КонецЕсли;    
	
	Если ЭтоЦессионарий	И ЗначениеЗаполнено(КорректировкаЦессионарийФИ) Тогда
		СоздатьКорректировкаЗадолженностиФИЦессионарий();
	КонецЕсли;  
		
	Если ЭтоЦессионарий	И ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийПоставка) Тогда
		СоздатьЗаписьКнигиПродажЦессионарийПоставка();
	КонецЕсли; 

	Если ЭтоЦессионарий	И ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийЗаем) Тогда
		СоздатьЗаписьКнигиПродажЦессионарийЗаем();
	КонецЕсли; 
	
	Если ЭтоЦессионарий	И ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарий) Тогда
		СоздатьПрочиеДоходыРасходыЦессионарий();
	КонецЕсли;      
	
	Если ЭтоЦессионарий	И ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарий) Тогда
		СоздатьПрочиеДоходыРасходыЦессионарийЗаем();
	КонецЕсли;      
	
	// Цедент 
	Если ЭтоЦедент И ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедент) Тогда
		СоздатьПрочиеДоходыРасходыЦедент();
	КонецЕсли;

	Если ЭтоЦедент И ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедентЗаем) Тогда
		СоздатьПрочиеДоходыРасходыЦедентЗаем();
	КонецЕсли;
	
	Если ЭтоЦедент	И ЗначениеЗаполнено(КорректировкаЗадолженности) Тогда
		СоздатьКорректировкаЗадолженностиЦедент();
	КонецЕсли;        
		
	Если ЭтоЦедент	И ЗначениеЗаполнено(КорректировкаЦедентФИ) Тогда
		СоздатьКорректировкаФИЦедент();
	КонецЕсли; 
	
	Если ЭтоЦедент	И ЗначениеЗаполнено(РеализацияЦедент) Тогда
		СоздатьРеализацияЦедент();
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкаДолжникФИДебет()
	
	СтруктураРеквизитов = ЦессииУХ.РеквизитыДолжник();
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	СуммаОсновногоДолга = СуммаОсновногоДолгаЦессииДолжника();
    СуммаПроцентов 		= РеквизитыЦессии.СуммаДокумента - СуммаОсновногоДолга;

	Если ЗначениеЗаполнено(КорректировкаДолжникФИДебет) Тогда
    	ДокументОбъект 			= КорректировкаДолжникФИДебет.ПолучитьОбъект();
	Иначе
		ДокументОбъект 			= Документы .КорректировкаЗадолженностиПоФинансовымИнструментам.СоздатьДокумент();	
	КонецЕсли;
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда 
		ДокументОбъект.Дата 		= ТекущаяДатаСеанса();
	КонецЕсли;	
	ДокументОбъект.Комментарий 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	ДокументОбъект.Автор		= Пользователи.ТекущийПользователь();
	ДокументОбъект.Договор		= РеквизитыЦессии.ДоговорСЦедентом;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности; 
	ДокументОбъект.ХарактерДоговора			= Перечисления.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм; 
	ДокументОбъект.Контрагент 	= РеквизитыЦессии.Цессионарий;
	ДокументОбъект.Партнер	 	= РеквизитыЦессии.ПартнерЦессионарий;   
	ДокументОбъект.СтатьяРасходов = Константы.СтатьяОтраженияЦессии.Получить();
	
	ДокументОбъект.Задолженность.Очистить();
	СтрокаЗадолженности = ДокументОбъект.Задолженность.Добавить();
	СтрокаЗадолженности.ТипСуммы 	= Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг;
	СтрокаЗадолженности.Сумма 		= РеквизитыЦессии.СуммаДокумента;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);   
	КорректировкаДолжникФИДебет = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);

КонецПроцедуры	

