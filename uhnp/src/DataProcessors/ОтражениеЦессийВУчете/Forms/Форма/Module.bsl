#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()  
	
	ЭтоЦессияВходящая 	= ТипЗнч(Цессия) = Тип("ДокументСсылка.ЦессияВходящая");
	ЭтоЦессияДолжника 	= ТипЗнч(Цессия) = Тип("ДокументСсылка.ЦессияДолжника");
	ЭтоЦессияИсходящая 	= ТипЗнч(Цессия) = Тип("ДокументСсылка.ЦессияИсходящая");
	
	Элементы.ГруппаДолжник.Видимость 		= ЭтоЦессияДолжника;
	Элементы.ГруппаЦедент.Видимость 		= ЭтоЦессияИсходящая;
	Элементы.ГруппаЦессионарий.Видимость 	= ЭтоЦессияВходящая;
	
    Элементы.СобытиеДолжникаЗаем.Видимость    	= ЭтоЗаем;
	Элементы.СобытиеДолжникПоставки.Видимость 	= НЕ ЭтоЗаем; 
	
	Элементы.СобытиеЦедентЗаем.Видимость    	= ЭтоЗаем;
	Элементы.СобытиеЦедентПоставки.Видимость 	= НЕ ЭтоЗаем;     
	
	Элементы.СобытиеЦессионарийЗаем.Видимость	  	= ЭтоЗаем;
	Элементы.СобытиеЦессионарийПоставки.Видимость 	= НЕ ЭтоЗаем; 

	
	Если ЗначениеЗаполнено(ПоступлениеЦессионарий) Тогда
		Элементы.ПоступлениеЦессионарий.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПоступлениеЦессионарий);
	Иначе
		Элементы.ПоступлениеЦессионарий.Заголовок = НСтр("ru = '<Создать документ поступления>'");
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(КорректировкаДолжникФИКредит) Тогда
		Элементы.КорректировкаДолжникФИКредит.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаДолжникФИКредит);
	Иначе
		Элементы.КорректировкаДолжникФИКредит.Заголовок = НСтр("ru = '<Создать корректировку задолженности по ФИ по Кт>'");
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(КорректировкаДолжникФИДебет) Тогда
		Элементы.КорректировкаДолжникФИДебет.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаДолжникФИДебет);
	Иначе
		Элементы.КорректировкаДолжникФИДебет.Заголовок = НСтр("ru = '<Создать корректировку задолженности по ФИ по Дт>'");
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(КорректировкаДолжник) Тогда
		Элементы.КорректировкаДолгаДолжник.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаДолжник);
	Иначе
		Элементы.КорректировкаДолгаДолжник.Заголовок = НСтр("ru = '<Создать корректировку долга>'");
	КонецЕсли; 
	
	// Цедент
	Если ЗначениеЗаполнено(КорректировкаЗадолженности) Тогда
		Элементы.КорректировкаЗадолженностиЦедент.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаЗадолженности);
	Иначе
		Элементы.КорректировкаЗадолженностиЦедент.Заголовок = НСтр("ru = '<Создать списание задолженности>'");
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедент) Тогда
		Элементы.ПрочиеДоходыРасходыЦедент.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПрочиеДоходыРасходыЦедент);
	Иначе
		Элементы.ПрочиеДоходыРасходыЦедент.Заголовок = НСтр("ru = '<Создать регистрацию доходов/расходов>'");
	КонецЕсли; 

	Если ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедентЗаем) Тогда
		Элементы.ПрочиеДоходыРасходыЦедентЗаем.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПрочиеДоходыРасходыЦедентЗаем);
	Иначе
		Элементы.ПрочиеДоходыРасходыЦедентЗаем.Заголовок = НСтр("ru = '<Создать регистрацию доходов/расходов>'");
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(РеализацияЦедент) Тогда
		Элементы.РеализацияЦедент.Заголовок = СтрШаблон(НСтр("ru = '%1'"), РеализацияЦедент);
	Иначе
		Элементы.РеализацияЦедент.Заголовок = НСтр("ru = '<Создать реализацию>'");
	КонецЕсли; 
			
	Если ЗначениеЗаполнено(КорректировкаЦедентФИ) Тогда
		Элементы.КорректировкаФИЦедент.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаЦедентФИ);
	Иначе
		Элементы.КорректировкаФИЦедент.Заголовок = НСтр("ru = '<Создать корректировку задолженности>'");
	КонецЕсли; 
	
	// Цессионарий
	Если ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарий) Тогда
		Элементы.ПрочиеДоходыРасходыЦессионарий.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПрочиеДоходыРасходыЦессионарий);
	Иначе
		Элементы.ПрочиеДоходыРасходыЦессионарий.Заголовок = НСтр("ru = '<Создать регистрацию доходов/расходов>'");
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(ПрочиеДоходыРасходыЦессионарийЗаем) Тогда
		Элементы.ПрочиеДоходыРасходыЦессионарийЗаем.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПрочиеДоходыРасходыЦессионарийЗаем);
	Иначе
		Элементы.ПрочиеДоходыРасходыЦессионарийЗаем.Заголовок = НСтр("ru = '<Создать регистрацию доходов/расходов>'");
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(КорректировкаЦессионарийФИ) Тогда
		Элементы.КорректировкаЗадолженностиФИЦессионарий.Заголовок = СтрШаблон(НСтр("ru = '%1'"), КорректировкаЦессионарийФИ);
	Иначе
		Элементы.КорректировкаЗадолженностиФИЦессионарий.Заголовок = НСтр("ru = '<Создать корректировку задолженности>'");
	КонецЕсли;    
		
	Если ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийПоставка) Тогда
		Элементы.ЗаписьКнигиПродажЦессионарийПоставка.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ЗаписьКнигиПродажЦессионарийПоставка);
	Иначе
		Элементы.ЗаписьКнигиПродажЦессионарийПоставка.Заголовок = НСтр("ru = '<Создать запись книги продаж>'");
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(ЗаписьКнигиПродажЦессионарийЗаем) Тогда
		Элементы.ЗаписьКнигиПродажЦессионарийЗаем.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ЗаписьКнигиПродажЦессионарийЗаем);
	Иначе
		Элементы.ЗаписьКнигиПродажЦессионарийЗаем.Заголовок = НСтр("ru = '<Создать запись книги продаж>'");
	КонецЕсли;  
	Если ЗначениеЗаполнено(ПоступлениеЦессионарий) Тогда
		Элементы.ПоступлениеЦессионарий.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПоступлениеЦессионарий);
	Иначе
		Элементы.ПоступлениеЦессионарий.Заголовок = НСтр("ru = '<Создать поступление>'");
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(ПоступлениеЦессионарийЗаем) Тогда
		Элементы.ПоступлениеЦессионарийЗаем.Заголовок = СтрШаблон(НСтр("ru = '%1'"), ПоступлениеЦессионарийЗаем);
	Иначе
		Элементы.ПоступлениеЦессионарийЗаем.Заголовок = НСтр("ru = '<Создать поступление>'");
	КонецЕсли;   
	
	Элементы.ФормаСоздатьДокументы.Видимость =  НЕ (ЭтоДолжник И НЕ ЭтоЗаем);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкуДолгаДолжник()
	
	СтруктураРеквизитов = ЦессииУХ.РеквизитыДолжник();   
	
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);

	/// ++
	Если ЗначениеЗаполнено(КорректировкаДолжник) Тогда
    	ДокументОбъект = КорректировкаДолжник.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	КонецЕсли;    
	ДокументОбъект = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	//ДокументОбъект.ДокументОснование = Документ;
	
	ДокументОбъект.Комментарий = НСтр("ru = 'Сформирован автоматически при отражении в учете цессии '");
	
	ДокументОбъект.КонтрагентКредитор = РеквизитыЦессии.Цедент;
	ДокументОбъект.КонтрагентДебитор  = РеквизитыЦессии.Цессионарий;
	
	ДокументОбъект.ВидОперации 		= Перечисления.ВидыОперацийВзаимозачетаЗадолженности.ПереносДолгаПоставщикуМеждуКонтрагентами;
	ДокументОбъект.Организация    	= РеквизитыЦессии.Организация;
	ДокументОбъект.Валюта			= РеквизитыЦессии.ВалютаДокумента;
	
	ДокументОбъект.ТипДебитора        = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	ДокументОбъект.ТипКредитора       = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	ДокументОбъект.СуммаРегл          = РеквизитыЦессии.СуммаДокумента;
	ДокументОбъект.СуммаУпр           = РеквизитыЦессии.СуммаДокумента;
	
	ДокументОбъект.ДебиторскаяЗадолженность.Очистить();
	ДокументОбъект.КредиторскаяЗадолженность.Очистить();
	
	СтрокаАванса = ДокументОбъект.ДебиторскаяЗадолженность.Добавить();
	
	СтрокаАванса.Организация          = РеквизитыЦессии.Организация;
	СтрокаАванса.Партнер              = РеквизитыЦессии.ПартнерЦессионарий;
	СтрокаАванса.ОбъектРасчетов       = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(РеквизитыЦессии.ДоговорСЦессионарием);
	СтрокаАванса.ВалютаВзаиморасчетов = РеквизитыЦессии.ВалютаДокумента;
	СтрокаАванса.СуммаВзаиморасчетов  = РеквизитыЦессии.СуммаДокумента;
	СтрокаАванса.СуммаРегл            = РеквизитыЦессии.СуммаДокумента;
	СтрокаАванса.СуммаУпр             = РеквизитыЦессии.СуммаДокумента;
	
	СтрокаЗачета = ДокументОбъект.КредиторскаяЗадолженность.Добавить();  
	СтрокаЗачета.Партнер              = РеквизитыЦессии.ПартнерЦедент;
	СтрокаЗачета.ОбъектРасчетов       = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(РеквизитыЦессии.ДоговорСЦедентом);
	СтрокаЗачета.ВалютаВзаиморасчетов = РеквизитыЦессии.ВалютаДокумента;
	СтрокаЗачета.СуммаВзаиморасчетов = РеквизитыЦессии.СуммаДокумента;
	СтрокаЗачета.СуммаРегл           = РеквизитыЦессии.СуммаДокумента;
	СтрокаЗачета.СуммаУпр            = РеквизитыЦессии.СуммаДокумента;

	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

	КорректировкаДолжник = ДокументОбъект.Ссылка;  
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка)

КонецПроцедуры  

&НаСервере
Процедура ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументРегУчета)
	
	МенеджерЗаписи = РегистрыСведений.ОтражениеЦессийВРегламентированномУчете.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетныйДокумент 	= ДокументРегУчета;
	МенеджерЗаписи.Цессия			= Цессия;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизиты()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтражениеЦессийВРегламентированномУчете.УчетныйДокумент КАК УчетныйДокумент,
		|	ОтражениеЦессийВРегламентированномУчете.Цессия КАК Цессия,
		|	ЕСТЬNULL(ОтражениеЦессийВРегламентированномУчете.УчетныйДокумент.ХозяйственнаяОперация, НЕОПРЕДЕЛЕНО) КАК ХозяйственнаяОперация
		|ИЗ
		|	РегистрСведений.ОтражениеЦессийВРегламентированномУчете КАК ОтражениеЦессийВРегламентированномУчете
		|ГДЕ
		|	ОтражениеЦессийВРегламентированномУчете.Цессия = &Цессия";
	
	Запрос.УстановитьПараметр("Цессия", Цессия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЭтоДолжник
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ВзаимозачетЗадолженности") Тогда
		
			КорректировкаДолжник = ВыборкаДетальныеЗаписи.УчетныйДокумент;
				
		КонецЕсли;  
		
		// КорректировкаДолжникФИКредит
		
		Если ЭтоДолжник И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.КорректировкаЗадолженностиПоФинансовымИнструментам") 
			 Тогда                                                                                                                    
		    Если ВыборкаДетальныеЗаписи.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности  Тогда
				КорректировкаДолжникФИКредит = ВыборкаДетальныеЗаписи.УчетныйДокумент;
			Иначе
				КорректировкаДолжникФИДебет  = ВыборкаДетальныеЗаписи.УчетныйДокумент;
			КонецЕсли;				
		КонецЕсли;  
	
		Если ЭтоЦессионарий И НЕ ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПриобретениеУслугПрочихАктивов") Тогда
			ПоступлениеЦессионарий = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		
		Если ЭтоЦессионарий И ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПриобретениеУслугПрочихАктивов") Тогда
			ПоступлениеЦессионарийЗаем = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		
		Если ЭтоЦессионарий
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.КорректировкаЗадолженностиПоФинансовымИнструментам") Тогда
			КорректировкаЦессионарийФИ = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;   
		
		Если ЭтоЦессионарий  И НЕ ЭтоЗаем
			И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ЗаписьКнигиПродаж") Тогда
			ЗаписьКнигиПродажЦессионарийПоставка = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли; 
		
		Если ЭтоЦессионарий И НЕ ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
			ПрочиеДоходыРасходыЦессионарий = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		
		Если ЭтоЦессионарий И ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
			ПрочиеДоходыРасходыЦессионарийЗаем = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		
		Если ЭтоЦессионарий И ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ЗаписьКнигиПродаж") Тогда
			ЗаписьКнигиПродажЦессионарийЗаем = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		
		// Цедент
		Если ЭтоЦедент
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
			ПрочиеДоходыРасходыЦедент = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;  
		Если ЭтоЦедент И ЭтоЗаем
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
			ПрочиеДоходыРасходыЦедентЗаем = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли; 
		Если ЭтоЦедент
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
			РеализацияЦедент = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;
		
		Если ЭтоЦедент
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.КорректировкаЗадолженности") Тогда
			КорректировкаЗадолженности = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли;
		
		Если ЭтоЦедент
				И ТипЗнч(ВыборкаДетальныеЗаписи.УчетныйДокумент) = ТИП("ДокументСсылка.КорректировкаЗадолженностиПоФинансовымИнструментам") Тогда
			КорректировкаЦедентФИ = ВыборкаДетальныеЗаписи.УчетныйДокумент;
		КонецЕсли; 
		
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкаДолжникФИКредит()
	
	СтруктураРеквизитов = ЦессииУх.РеквизитыДолжник();
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	СуммаОсновногоДолга = СуммаОсновногоДолгаЦессииДолжника();
    СуммаПроцентов 		= РеквизитыЦессии.СуммаДокумента - СуммаОсновногоДолга;

	Если ЗначениеЗаполнено(КорректировкаДолжникФИКредит) Тогда
    	ДокументОбъект 			= КорректировкаДолжникФИКредит.ПолучитьОбъект();
	Иначе
		ДокументОбъект 			= Документы.КорректировкаЗадолженностиПоФинансовымИнструментам.СоздатьДокумент();	
	КонецЕсли;
	ДокументОбъект.Организация 	= РеквизитыЦессии.Организация; 
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда 
		ДокументОбъект.Дата 		= ТекущаяДатаСеанса();
	КонецЕсли;	
	ДокументОбъект.Комментарий 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регл учет по документу: %1'"), Цессия);
	ДокументОбъект.Автор		= Пользователи.ТекущийПользователь();
	ДокументОбъект.Договор		= РеквизитыЦессии.ДоговорСЦедентом;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности;
	ДокументОбъект.ХарактерДоговора		 = Перечисления.ХарактерыДоговоровФинансовыхИнструментов.КредитИлиЗайм;
	ДокументОбъект.Контрагент 	= РеквизитыЦессии.Цедент;
	ДокументОбъект.Партнер	 	= РеквизитыЦессии.ПартнерЦедент;
	ДокументОбъект.СтатьяДоходов = Константы.СтатьяОтраженияЦессии.Получить();
	
	ДокументОбъект.Задолженность.Очистить();
	СтрокаЗадолженности = ДокументОбъект.Задолженность.Добавить();
	СтрокаЗадолженности.ТипСуммы 	= Перечисления.ТипыСуммГрафикаКредитовИДепозитов.ОсновнойДолг;
	СтрокаЗадолженности.Сумма 		= РеквизитыЦессии.СуммаДокумента;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);   
	КорректировкаДолжникФИКредит = ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура СоздатьКорректировкаЗадолженностиЦедент()
	
	СтруктураРеквизитов = ЦессииУХ.РеквизитыЦедент();
	РеквизитыЦессии 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
	Если ЗначениеЗаполнено(КорректировкаЗадолженности) Тогда
        ДокументОбъект = КорректировкаЗадолженности.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.КорректировкаЗадолженности.СоздатьДокумент();		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		ДокументОбъект.Дата			= ТекущаяДатаСеанса();
	КонецЕсли;
	ДокументОбъект.Автор 			= Пользователи.ТекущийПользователь(); 
	ДокументОбъект.Контрагент		= РеквизитыЦессии.Должник;
	ДокументОбъект.Организация		= РеквизитыЦессии.Организация;
	ДокументОбъект.ХозяйственнаяОперация			= Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности;
	
	ДокументОбъект.Задолженность.Очистить();
	СтрокаЗадолженности = ДокументОбъект.Задолженность.Добавить();
	СтрокаЗадолженности.Партнер			= РеквизитыЦессии.ПартнерДолжник;
	СтрокаЗадолженности.ОбъектРасчетов	= ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(РеквизитыЦессии.ДоговорДолжника);
	СтрокаЗадолженности.ТипРасчетов		= Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	СтрокаЗадолженности.Сумма			= РеквизитыЦессии.СуммаДокумента; 
	СтрокаЗадолженности.ВалютаВзаиморасчетов = РеквизитыЦессии.ВалютаДокумента;
	
	ДокументОбъект.ДоходыРасходыАктивыПассивы.Очистить();
	
	СтрокаАктивы = ДокументОбъект.ДоходыРасходыАктивыПассивы.Добавить();
	СтрокаАктивы.Статья = Константы.СтатьяОтраженияЦессии.Получить();
	НоваяНастройка = НастройкаСчетовУчетаКлиентСервер.СоставНастройкиСчетовУчета();
	НоваяНастройка.СчетУчета = ПланыСчетов.Хозрасчетный.ПрочиеРасходы;
	НоваяНастройка.Субконто1 = Константы.СтатьяРасходовЦессии.Получить();
		
	СтрокаАктивы.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.НоваяНастройкаСчетовУчета(НоваяНастройка);


	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);  

	КорректировкаЗадолженности	= ДокументОбъект.Ссылка;
	ЗаписатьОтражениеЦессийВРегламентированномУчете(ДокументОбъект.Ссылка)
    
КонецПроцедуры

&НаСервере
Процедура СоздатьПрочиеДоходыРасходыЦедент()

	СтруктураРеквизитов = ЦессииУХ.РеквизитыЦедент(); 
		
	РеквизитыЦессии = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цессия, СтруктураРеквизитов);
	
    СуммаПремии 	= РеквизитыЦессии.СуммаДокумента - РеквизитыЦессии.СуммаОбязательства;
	ЭтоДоход 		= СуммаПремии>0;   
	Если НЕ  ЭтоДоход Тогда
	    СуммаПремии	= - СуммаПремии;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПрочиеДоходыРасходыЦедент) Тогда
    	ДокументОбъект 				= ПрочиеДоходыРасходыЦедент.ПолучитьОбъект();
	Иначе
		ДокументОбъект 				= Документы.ПрочиеДоходыРасходы.СоздатьДокумент();	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Дата ) Тогда
