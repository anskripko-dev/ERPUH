&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТЗ_Данные = ПолучитьИзВременногоХранилища(Параметры.АдресТЗ);
	ТаблицаНеоднозначности.Загрузить(ТЗ_Данные);
КонецПроцедуры

// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаКлиенте
Процедура ТаблицаНеоднозначностиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбраннаяСтрока", ВыбраннаяСтрока);	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма, ДополнительныеПараметры);
	
	СписоЗначений = ТаблицаНеоднозначности[ВыбраннаяСтрока].СписокЗначений;
	СписоЗначений.ПоказатьВыборЭлемента(Оповещение, "Выберите элемент");
КонецПроцедуры

// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    Если ВыбранныйЭлемент <> Неопределено Тогда
        ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
		ТаблицаНеоднозначности[ДополнительныеПараметры.ВыбраннаяСтрока].ВыбранноеЗначение = ВыбранноеЗначение;
		ТаблицаНеоднозначности[ДополнительныеПараметры.ВыбраннаяСтрока].Выбрано = Истина;
    КонецЕсли;
КонецПроцедуры

// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаКлиенте
Процедура ПеренестиВыбранныеЗначения(Команда)
	НевыбранныеСтроки = ТаблицаНеоднозначности.НайтиСтроки(Новый Структура("Выбрано", Ложь));
	Если НевыбранныеСтроки.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Не все элементы подобраны. Продолжить?'"), Режим, 0); 
	Иначе
		ПередатьТаблицуСопоставления();	
	КонецЕсли;
КонецПроцедуры

// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ПередатьТаблицуСопоставления();
    КонецЕсли;
КонецПроцедуры   

// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаКлиенте
Процедура ПередатьТаблицуСопоставления() Экспорт
	АдресХран = ЗагрузитьТаблицуВХранилище();
	Закрыть(АдресХран);
КонецПроцедуры 

// Белоконенко Денис 16.06.2023 Выполнение задач №000045851
&НаСервере
Функция ЗагрузитьТаблицуВХранилище()
	АдресХран = ПоместитьВоВременноеХранилище(ТаблицаНеоднозначности.Выгрузить(), Новый УникальныйИдентификатор);
	Возврат АдресХран;
КонецФункции