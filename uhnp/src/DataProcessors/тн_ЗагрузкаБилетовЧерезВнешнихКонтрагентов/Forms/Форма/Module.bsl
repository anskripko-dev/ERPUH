&НаСервере
Функция ПолучитьКонтрагентаПоИНН(ИНН, НомерСтроки, ИмяРеквизита, ОбрабатыватьЗначения = Истина)
//// Белоконенко Денис 16.06.2023 Выполнение задач №000045851
//&НаСервере
//Функция ПолучитьКонтрагентаПоИНН(ИНН, НомерСтроки, ИмяРеквизита)
	
	ИмяНеоднозначности = "ИНН " + ИНН;
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И НЕ Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() > 1 Тогда 
		// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		Если ОбрабатыватьЗначения Тогда
		// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
			
			НайденнаяСтрока = ТаблицаНеоднозначности.НайтиСтроки(Новый Структура("СтрокаНеоднозначности", ИмяНеоднозначности));
			
			Если НайденнаяСтрока.Количество() = 0 Тогда
				
				НоваяСтрока = ТаблицаНеоднозначности.Добавить();
				НоваяСтрока.СтрокаНеоднозначности = ИмяНеоднозначности;
				НоваяСтрока.ИмяРеквизита = ИмяРеквизита;
				
				СписокКонтрагентов = Новый СписокЗначений;
				Пока Выборка.Следующий() Цикл
					СписокКонтрагентов.Добавить(Выборка.Ссылка);
				КонецЦикла;
				
				НоваяСтрока.СписокЗначений = СписокКонтрагентов;
				
				СписокСтрок = Новый СписокЗначений;
				СписокСтрок.Добавить(НомерСтроки);
				
				НоваяСтрока.СписокИдентификаторовСтрок = СписокСтрок;
			Иначе 			
				НайденнаяСтрока[0].СписокИдентификаторовСтрок.Добавить(НомерСтроки);
			КонецЕсли; 
		// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		Иначе
			Выборка.Следующий();
			Контрагент = Выборка.Ссылка;
		КонецЕсли;  
		// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		
	ИначеЕсли Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Контрагент = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Контрагент;  
	
КонецФункции

