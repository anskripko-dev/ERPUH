// Данилова Мария 26.02.2022 Выполнение задач №000040506
&НаСервере
Процедура ЗаполнитьТаблицаСопоставленияКолонок(пИмяМакета, пТаблицаСопоставленияКолонок, пТаблицаВидДок)
	
	МакетСопоставления = Обработки.тн_ЗагрузкаБилетовЧерезВнешнихКонтрагентов.ПолучитьМакет(пИмяМакета);
	 	
	ТаблицаКолонок = ПолучитьДанныеТабличногоДокументаТаблицаЗначений(МакетСопоставления);
	
	пТаблицаСопоставленияКолонок.Загрузить(ТаблицаКолонок);
	
	МассивДобавляемыхРеквизитов = Новый Массив();
	пТаблицаДанныхОбъектИмя = ?(пИмяМакета = "МакетСопоставленияКолонокПТиУ", "ТаблицаДанныхПТиУ", "ТаблицаДанных");
	Для Каждого СтрокаКолонка Из ТаблицаКолонок Цикл
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(СтрокаКолонка.ИмяКолонки, ПолучитьТипКолонки(СтрокаКолонка.ТипКолонки), "Объект."+пТаблицаДанныхОбъектИмя, СтрокаКолонка.ПредставлениеКолонкиТаблицаДанных));	
		Если НЕ СокрЛП(СтрокаКолонка.ПользовательскаяКолонкаПредставление) = "" Тогда
			НоваяНастройка = пТаблицаВидДок.Добавить();
			НоваяНастройка.ПользовательскаяКолонкаИмя = СтрокаКолонка.ИмяКолонки;
			НоваяНастройка.ПользовательскаяКолонкаПредставление = СтрокаКолонка.ПользовательскаяКолонкаПредставление;
			НоваяНастройка.ПользовательскаяКолонкаРеестра = 0;
		КонецЕсли;
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	ТаблицаФормы = Элементы.Добавить(пТаблицаДанныхОбъектИмя, Тип("ТаблицаФормы"), Элементы.ГруппаТаблицаДанных);
	ТаблицаФормы.ПутьКДанным = "Объект."+пТаблицаДанныхОбъектИмя;
	ТаблицаФормы.Заголовок = ?(пИмяМакета = "МакетСопоставленияКолонокПТиУ", "Приобретенние товаров и услуг", "Электронные билеты");
	ТаблицаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	
	НоваяКолонка = Элементы.Добавить(пТаблицаДанныхОбъектИмя+"НомерСтроки", Тип("ПолеФормы"), Элементы[пТаблицаДанныхОбъектИмя]);
	НоваяКолонка.Заголовок = "N";
	НоваяКолонка.ПутьКДанным = "Объект."+пТаблицаДанныхОбъектИмя+".НомерСтроки";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	Для Каждого СтрокаКолонка Из ТаблицаКолонок Цикл
		НоваяКолонка = Элементы.Добавить(пТаблицаДанныхОбъектИмя+СтрокаКолонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[пТаблицаДанныхОбъектИмя]);
		НоваяКолонка.Заголовок = СтрокаКолонка.ПредставлениеКолонкиТаблицаДанных;
		НоваяКолонка.ПутьКДанным = "Объект."+пТаблицаДанныхОбъектИмя+"." + СтрокаКолонка.ИмяКолонки;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	КонецЦикла; 
	
КонецПроцедуры

// Данилова Мария 26.02.2022 Выполнение задач №000040506
&НаСервереБезКонтекста
Функция ПолучитьТипКолонки(ТипКолонкиСтрока)
	
	МассивТиповСтрока = СтрРазделить(ТипКолонкиСтрока, "#", Истина);
	
	МассивТипов = Новый Массив();
	КвалификаторЧисла = Неопределено;
	Для Каждого ТипСтрока Из МассивТиповСтрока Цикл
			
		Если СтрНайти(ВРег(ТипКолонкиСтрока), ВРег("Число")) > 0 Тогда
			СтрокиТипа = СтрРазделить(ТипКолонкиСтрока, "_");
			МассивТипов.Добавить(Тип("Число"));
			КвалификаторЧисла = Новый КвалификаторыЧисла(СтрокиТипа[1], СтрокиТипа[2]);
		ИначеЕсли СтрНайти(ВРег(ТипКолонкиСтрока), ВРег("Строка")) > 0 Тогда	
			МассивТипов.Добавить(Тип("Строка"));
		ИначеЕсли СтрНайти(ВРег(ТипКолонкиСтрока), ВРег("ОпределяемыйТип")) > 0 Тогда
			СтрокаИмя = СтрЗаменить(ВРег(ТипКолонкиСтрока), ВРег("ОпределяемыйТип."), "");
			Возврат Метаданные.ОпределяемыеТипы.ДенежнаяСуммаЛюбогоЗнака.Тип;
		Иначе
			МассивТипов.Добавить(Тип(ТипСтрока));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(МассивТипов,,,КвалификаторЧисла);
	
КонецФункции

// Юдина Екатерина 30.01.2025 Выполнение задач №000052453  
//
&НаСервере
Процедура ДополнитьНастройкиПоДаннымМакета(ТаблицаЗагруженныхНастроек, ИмяМакета)
	
	// При загрузке настроек новые поля в макете не учитываются.
	// Нужно создавать поля, если в настройках они не сохранены, так как вручную они не создаются.	
	Если ЗначениеЗаполнено(ТаблицаЗагруженныхНастроек) Тогда
		
		МакетСопоставления = Обработки.тн_ЗагрузкаБилетовЧерезВнешнихКонтрагентов.ПолучитьМакет("МакетСопоставленияКолонокБилет");
		
		ТаблицаКолонок = ПолучитьДанныеТабличногоДокументаТаблицаЗначений(МакетСопоставления);
		Для Каждого СтрокаКолонка Из ТаблицаКолонок Цикл  
			
			НайденныеСтроки = ТаблицаЗагруженныхНастроек.НайтиСтроки(Новый Структура("ПользовательскаяКолонкаИмя", СтрокаКолонка.ИмяКолонки));
			Если НайденныеСтроки.Количество() = 0
				И НЕ СокрЛП(СтрокаКолонка.ПользовательскаяКолонкаПредставление) = "" Тогда

				НС = ТаблицаЗагруженныхНастроек.Добавить();
				НС.ПользовательскаяКолонкаИмя = СтрокаКолонка.ИмяКолонки;
				НС.ПользовательскаяКолонкаПредставление = СтрокаКолонка.ПредставлениеКолонкиТаблицаДанных; 
				
			КонецЕсли;	
		КонецЦикла; 
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти 

#Область ЧтениеФайла

// Данилова Мария 26.02.2022 Выполнение задач №000040506
&НаКлиенте
Процедура ПрочитатьДанныеИзФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Объект.ВыбранныйФайл = Результат.Имя;
		АдресВременногоХранилища = Результат.Хранение;
		Расширение = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(Результат.Имя));
		
		ПрочитатьДанныеИзФайлаНаСервере(АдресВременногоХранилища, Расширение);
		
		// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
		Если ТаблицаНеоднозначности.Количество() > 0 Тогда 
			
			// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453  
			Для Каждого Строка Из ТаблицаНеоднозначности Цикл
				СтрокиКонтрагентов = ТаблицаСопоставленияИННКонтрагентов.НайтиСтроки(Новый Структура("ИНН", Строка.СтрокаНеоднозначности));	
				Для Каждого Стр Из СтрокиКонтрагентов Цикл   
					Если ЗначениеЗаполнено(Стр.Контрагент) Тогда
						Строка.ВыбранноеЗначение = Стр.Контрагент;  
						Строка.Выбрано = Истина;      
					КонецЕсли;  
				КонецЦикла;    
			КонецЦикла;
			// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453  
			
			ПараметрыВвода = Новый Структура;
			ПараметрыВвода.Вставить("АдресТЗ", ЗагрузитьТаблицуВХранилище());
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ФормаНеоднозначностиЗавершение", ЭтаФорма);
					
			ОткрытьФорму("Обработка.тн_ЗагрузкаБилетовЧерезВнешнихКонтрагентов.Форма.ФормаНеоднозначности", ПараметрыВвода,
				ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 16.06.2023 Выполнение задач №000045851
	КонецЕсли;
	
	//НАЧАЛО Сафиуллина З.Р. 03.07.2025 Выполнение задач №000054300
	ЗагрузкаВыполнена = Ложь;
	//КОНЕЦ Сафиуллина З.Р. 03.07.2025 Выполнение задач №000054300
КонецПроцедуры

// Данилова Мария 26.02.2022 Выполнение задач №000040506
&НаСервере
Процедура ПрочитатьДанныеИзФайлаНаСервере(АдресВременногоХранилища, Расширение)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ПолучитьИзВременногоХранилища(АдресВременногоХранилища).Записать(ИмяВременногоФайла);
	
	// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
	ТаблицаНеоднозначности.Очистить();
	// КОНЕЦ Белоконенко Денис 16.06.2023 Выполнение задач №000045851
	
	ТабличныйДокумент = Новый ТабличныйДокумент();
	// НАЧАЛО Климов Антон 30.11.2022 Выполнение задач №000043510
	//ТабличныйДокумент.Прочитать(ИмяВременногоФайла);
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	// КОНЕЦ  Климов Антон 30.11.2022 Выполнение задач №000043510
	тзОшибки = Новый ТаблицаЗначений;
	тзОшибки.Колонки.Добавить("УПД_УКД");
	тзОшибки.Колонки.Добавить("ПричинаПропуска");
	тзОшибки.Колонки.Добавить("СтрокаНомер");
	тзОшибки.Колонки.Добавить("ОписаниеУслуги");
	тзОшибки.Колонки.Добавить("ЭтоБилет");
	
	ТаблицаДанныхФайл = ПолучитьДанныеТабличногоДокументаТаблицаЗначений(ТабличныйДокумент);
	
	// НАЧАЛО Юдина Екатерина 21.04.2026 Выполнение задач №000057412 
	//// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453      
	//ОбработатьТаблицуДанныхФайла(ТаблицаДанныхФайл); 
	//// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
	ОбработатьТаблицуДанныхФайла(ТаблицаДанныхФайл, ТаблицаЭлектронныйБилет); 
    // КОНЕЦ Юдина Екатерина 21.04.2026 Выполнение задач №000057412  
	
	Объект.ТаблицаДанных.Очистить();
	ТаблицаДанных = Объект.ТаблицаДанных.Выгрузить();
	Объект.ТаблицаДанныхПТиУ.Очистить();
	ТаблицаДанныхПТиУ = Объект.ТаблицаДанныхПТиУ.Выгрузить();
	
	ТаблицаСопоставления = ПолучитьТаблицуДанныхПоМэппингу(ТаблицаДанных, ТаблицаДанныхФайл, "ТаблицаЭлектронныйБилет", тзОшибки);
	Объект.ТаблицаДанных.Загрузить(ТаблицаСопоставления);
	
	ТаблицаСопоставления = ПолучитьТаблицуДанныхПоМэппингу(ТаблицаДанныхПТиУ, ТаблицаДанныхФайл, "ТаблицаПТиУ", тзОшибки);
	Объект.ТаблицаДанныхПТиУ.Загрузить(ТаблицаСопоставления);
	
	массСтрока = ТаблицаНесопоставленных.НайтиСтроки(Новый Структура("ЕстьСоответствие, ЕстьОшибка", Истина, Ложь));
	Для каждого строкаБезОшибок Из массСтрока Цикл
		
		массСтрокаСвязанногоУПД = ТаблицаНесопоставленных.НайтиСтроки(Новый Структура("ЕстьОшибка, УПД_УКД", Истина, строкаБезОшибок.УПД_УКД));
		// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
		//Если НЕ массСтрокаСвязанногоУПД.Количество() Тогда
		массСтрокаСвязанногоУПД2 = ТаблицаНесопоставленных.НайтиСтроки(Новый Структура("ЕстьСоответствие, УПД_УКД", Ложь, строкаБезОшибок.УПД_УКД));
		Если НЕ (массСтрокаСвязанногоУПД.Количество() ИЛИ массСтрокаСвязанногоУПД2.Количество()) Тогда
		// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034

			ТаблицаНесопоставленных.Удалить(строкаБезОшибок);
		Иначе
			строкаБезОшибок.ПричинаПропуска	= "Есть ошибки по УПД";
			Для каждого СтрокаБилета Из Объект.ТаблицаДанных Цикл
			
				Если СтрокаБилета.НомерУПД = строкаБезОшибок.УПД_УКД Тогда
					
					Объект.ТаблицаДанных.Удалить(СтрокаБилета);						
				
				КонецЕсли;		
			
			КонецЦикла;
			Для каждого СтрокаПТиУ Из Объект.ТаблицаДанныхПТиУ Цикл
				
