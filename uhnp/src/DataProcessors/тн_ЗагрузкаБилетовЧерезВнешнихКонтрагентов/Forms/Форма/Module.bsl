					СтрокаДанных.Номенклатура = пШаблоныпоВидуДок[сч].Номенклатура; 					
					СтрокаДанных.СтатьяРасходов = пШаблоныпоВидуДок[сч].СтатьиРасходов; 
					//НАЧАЛО Блинова М.А. 26.05.2025 Выполнение задач №000053814  
					стрПропускаем.ЕстьОшибка = Ложь;      
					стрПропускаемРС.ГотовКЗагрузке = Истина;
					//КОНЕЦ Блинова М.А. 26.05.2025 Выполнение задач №000053814
				КонецЕсли;
				
				Для каждого пНастройка Из пТаблицаВидДок Цикл
					
					Если пНастройка.ПользовательскаяКолонкаРеестра = 0 Тогда
						Продолжить;
					КонецЕсли;	
						
					пЗначение = СтрокаФайл[ТаблицаДанныхФайл.Колонки[пНастройка.ПользовательскаяКолонкаРеестра-1].Имя];

					Если пНастройка.ПользовательскаяКолонкаИмя = "Сотрудник" Тогда
						
						// НАЧАЛО Гимадиев Марат 14.03.2023 Выполнение задач №000044764
						
						//СтрокаДанных.Сотрудник = Справочники.ФизическиеЛица.НайтиПоНаименованию(пЗначение);
						//// НАЧАЛО Редько Екатерина 06.10.2022 Выполнение задач №000042878   
						//СтруктураПоиска = Новый Структура("ФизическоеЛицо");
						//СтруктураПоиска.ФизическоеЛицо = СтрокаДанных.Сотрудник; 
						
						СтруктураПоиска = Новый Структура("ФИО", СокрЛП(пЗначение));
						// КОНЕЦ  Гимадиев Марат 14.03.2023 Выполнение задач №000044764
						
						//НАЧАЛО: Гимадиев Марат 10.02.2023 Выполнение задач №000044343 
						ВыборкаПоФизЛицу.Сбросить();
						//КОНЕЦ: Гимадиев Марат 10.02.2023 Выполнение задач №000044343
						
						ЗаписьФизЛицо = ВыборкаПоФизЛицу.НайтиСледующий(СтруктураПоиска);   
						// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034  
						Если Не ЗаписьФизЛицо Тогда
							стрПропускаем.ЕстьОшибка		= Истина;
							стрПропускаем.ПричинаПропуска	= "Нет сопоставления по ФИО";
							стрПропускаемРС.ПричинаПропуска	= СформироватьПричинуПропускаРС(стрПропускаемРС.ПричинаПропуска,стрПропускаем.ПричинаПропуска);
							стрПропускаемРС.ГотовКЗагрузке	= Ложь;   
							ТаблицаДанных.Удалить(СтрокаДанных);
							Прервать;
							
						// НАЧАЛО Гимадиев Марат 14.03.2023 Выполнение задач №000044764
						Иначе
							СтрокаДанных.Сотрудник = ВыборкаПоФизЛицу.ФизическоеЛицо;
						// КОНЕЦ  Гимадиев Марат 14.03.2023 Выполнение задач №000044764
						КонецЕсли;    
						// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
						// КОНЕЦ  Редько Екатерина 06.10.2022 Выполнение задач №000042878
						Если НЕ ТаблицаДанных.Колонки.Найти("Подразделение") = Неопределено Тогда
							// НАЧАЛО Редько Екатерина 06.10.2022 Выполнение задач №000042878   
							//СтрокаДанных.Подразделение = СтрокаДанных.Сотрудник.тн_Подразделение;
							СтрокаДанных.Подразделение = ?(ЗаписьФизЛицо, ВыборкаПоФизлицу.тнПодразделение, СтрокаДанных.Сотрудник.тн_Подразделение);
							// КОНЕЦ  Редько Екатерина 06.10.2022 Выполнение задач №000042878
						КонецЕсли;
						Если НЕ ТаблицаДанных.Колонки.Найти("АналитикаРасходов") = Неопределено Тогда
							// НАЧАЛО Редько Екатерина 06.10.2022 Выполнение задач №000042878   
							//СтрокаДанных.АналитикаРасходов = СтрокаДанных.Сотрудник.тн_Подразделение;
							СтрокаДанных.АналитикаРасходов = ?(ЗаписьФизЛицо, ВыборкаПоФизлицу.тнПодразделение, СтрокаДанных.Сотрудник.тн_Подразделение);
							// КОНЕЦ  Редько Екатерина 06.10.2022 Выполнение задач №000042878
						КонецЕсли;
						
					ИначеЕсли пНастройка.ПользовательскаяКолонкаИмя = "КонтрагентПеревозчик" Тогда
						
					    Если НЕ пЗначение = "" Тогда
							// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034  
							//СтрокаДанных.КонтрагентПеревозчик = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", пЗначение);
							// НАЧАЛО Белоконенко Денис 16.06.2023 Выполнение задач №000045851
							//СтрокаДанных.КонтрагентПеревозчик = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Формат(пЗначение, "ЧГ="));
							СтрокаДанных.КонтрагентПеревозчик = ПолучитьКонтрагентаПоИНН(Формат(пЗначение, "ЧГ="), ТаблицаДанных.Индекс(СтрокаДанных), пНастройка.ПользовательскаяКолонкаИмя);
							// КОНЕЦ Белоконенко Денис 16.06.2023 Выполнение задач №000045851
							// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034   
							
						КонецЕсли;                                                 
						
					ИначеЕсли пНастройка.ПользовательскаяКолонкаИмя = "СтавкаНДС" Тогда
						
						//НАЧАЛО Сафиуллина З.Р. 05.02.2026 Выполнение задач №000056636
						//Если НЕ СтрНайти(пЗначение, "10") = 0 Тогда
						//	пСтавка = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", Перечисления.СтавкиНДС.НДС10);
						//ИначеЕсли НЕ СтрНайти(пЗначение, "18") = 0 Тогда
						//	пСтавка = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", Перечисления.СтавкиНДС.НДС18);
						//ИначеЕсли НЕ СтрНайти(пЗначение, "20") = 0 Тогда
						//	пСтавка = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", Перечисления.СтавкиНДС.НДС20);
						//Иначе
						//	пСтавка = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", Перечисления.СтавкиНДС.БезНДС);
						//КонецЕсли;
						пСтавка = Справочники.СтавкиНДС.СтавкаНДСИзСтроки(пЗначение);
						//КОНЕЦ Сафиуллина З.Р. 05.02.2026 Выполнение задач №000056636
						СтрокаДанных.СтавкаНДС = пСтавка;
						
					ИначеЕсли пНастройка.ПользовательскаяКолонкаИмя = "ДатаОтправления" 
							ИЛИ пНастройка.ПользовательскаяКолонкаИмя = "ДатаПрибытия" 
							ИЛИ пНастройка.ПользовательскаяКолонкаИмя = "Дата" 
							// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453 
							ИЛИ пНастройка.ПользовательскаяКолонкаИмя = "ДатаПокупкиБилета" 
							// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
							ИЛИ пНастройка.ПользовательскаяКолонкаИмя = "ДатаВходящегоДокумента" Тогда	
							
						// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
						Если ТипЗнч(пЗначение) = Тип("Дата") Тогда
							СтрокаДанных[пНастройка.ПользовательскаяКолонкаИмя] = пЗначение;
						Иначе
						// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
							пДатаТекстФормат = ""+Прав(пЗначение,4)+Сред(пЗначение,4,2)+Лев(пЗначение,2);
						Попытка
							СтрокаДанных[пНастройка.ПользовательскаяКолонкаИмя] = Дата(пДатаТекстФормат);
						Исключение
							СтрокаДанных[пНастройка.ПользовательскаяКолонкаИмя] = "";
						КонецПопытки;
						// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
                        КонецЕсли;
						// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
					   
					ИначеЕсли пНастройка.ПользовательскаяКолонкаИмя = "тн_ОбменБронирования" Тогда
						
						Запрос = Новый Запрос; 
						Запрос.УстановитьПараметр("НомерБилета", пЗначение);
						Запрос.Текст =
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	Бронирование.Ссылка КАК Ссылка
						|ИЗ
						|	Документ.Бронирование КАК Бронирование
						|ГДЕ
						|	Бронирование.НомерБилета = &НомерБилета
						|	И НЕ Бронирование.ПометкаУдаления";
						пРезультатЗапроса = Запрос.Выполнить();
						Если НЕ пРезультатЗапроса.Пустой() Тогда
							СтрокаДанных[пНастройка.ПользовательскаяКолонкаИмя] = пРезультатЗапроса.Выгрузить()[0].Ссылка;
						КонецЕсли;
					   
					Иначе
						
						СтрокаДанных[пНастройка.ПользовательскаяКолонкаИмя] = пЗначение;
						
					КонецЕсли;
				
				КонецЦикла;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
		Если стрПропускаем.ЕстьОшибка Или Не стрПропускаем.ЕстьСоответствие Тогда
			стрПропускаемРС.ПричинаПропуска	= СформироватьПричинуПропускаРС(стрПропускаемРС.ПричинаПропуска,стрПропускаем.ПричинаПропуска);
			стрПропускаемРС.ГотовКЗагрузке	= Ложь;
		КонецЕсли;	
		// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Юдина Екатерина 21.04.2026 Выполнение задач №000057412 +ТаблицаЭлектронныйБилет  
// Юдина Екатерина 30.01.2025 Выполнение задач №000052453 
// 
&НаСервереБезКонтекста
//Процедура ОбработатьТаблицуДанныхФайла(ТаблицаДанныхФайл)   
Процедура ОбработатьТаблицуДанныхФайла(ТаблицаДанныхФайл, ТаблицаЭлектронныйБилет)  
	
	ТаблицаДанныхФайл.Колонки.Добавить("Удалить", Новый ОписаниеТипов("Булево"));
	
	// НАЧАЛО Юдина Екатерина 21.04.2026 Выполнение задач №000057412 
	//НулевыеСтроки = ТаблицаДанныхФайл.НайтиСтроки(Новый Структура("Сумма, СуммаНДС, СуммаБезНДС", 0, 0, 0));
	ИндексКолонкиСуммаНДС = ТаблицаЭлектронныйБилет[9].ПользовательскаяКолонкаРеестра - 1;
	ИмяКолонкиСуммаНДС = ТаблицаДанныхФайл.Колонки[ИндексКолонкиСуммаНДС].Имя;
	ИндексКолонкиСумма = ТаблицаЭлектронныйБилет[10].ПользовательскаяКолонкаРеестра - 1;
	ИмяКолонкиСумма = ТаблицаДанныхФайл.Колонки[ИндексКолонкиСумма].Имя;   
	ИндексКолонкиДата = ТаблицаЭлектронныйБилет[1].ПользовательскаяКолонкаРеестра - 1;
	ИмяКолонкиДата = ТаблицаДанныхФайл.Колонки[ИндексКолонкиДата].Имя;   
	ИндексКолонкиСНомеромУПД = ТаблицаЭлектронныйБилет[0].ПользовательскаяКолонкаРеестра - 1;
	ИмяКолонкиСНомеромУПД = ТаблицаДанныхФайл.Колонки[ИндексКолонкиСНомеромУПД].Имя;
	ИндексКолонкиСНомеромБилета = ТаблицаЭлектронныйБилет[3].ПользовательскаяКолонкаРеестра - 1;
	ИмяКолонкиСНомеромБилета = ТаблицаДанныхФайл.Колонки[ИндексКолонкиСНомеромБилета].Имя;  
	
	ОтборНулевыхСтрок = Новый Структура;  
	ОтборНулевыхСтрок.Вставить(ИмяКолонкиСумма, 0);
	ОтборНулевыхСтрок.Вставить(ИмяКолонкиСуммаНДС, 0);
	
	НулевыеСтроки = ТаблицаДанныхФайл.НайтиСтроки(ОтборНулевыхСтрок);
	// КОНЕЦ Юдина Екатерина 21.04.2026 Выполнение задач №000057412	
	
	Для Каждого Строка Из НулевыеСтроки Цикл    
		// НАЧАЛО Юдина Екатерина 21.04.2026 Выполнение задач №000057412
		//ПараметрыОтбора = Новый Структура("ДатаДокумента,НомерБланка, НомерУПД_УКД", Строка.ДатаДокумента, Строка.НомерБланка, Строка.НомерУПД_УКД);	
		ПараметрыОтбора = Новый Структура;    
		ПараметрыОтбора.Вставить("ДатаДокумента", Строка.ДатаДокумента);
		ПараметрыОтбора.Вставить(ИмяКолонкиСНомеромБилета, Строка[ИмяКолонкиСНомеромБилета]);     
		ПараметрыОтбора.Вставить(ИмяКолонкиСНомеромУПД, Строка[ИмяКолонкиСНомеромУПД]);		
		// КОНЕЦ Юдина Екатерина 21.04.2026 Выполнение задач №000057412	
		СтрокиБланка = ТаблицаДанныхФайл.НайтиСтроки(ПараметрыОтбора);  
		Для Каждого СтрокаБланка Из СтрокиБланка Цикл  
			// НАЧАЛО Юдина Екатерина 21.04.2026 Выполнение задач №000057412
			//Если СтрокаБланка._П_п <> Строка._П_п Тогда
			Если ТаблицаДанныхФайл.Индекс(СтрокаБланка) <> ТаблицаДанныхФайл.Индекс(Строка) Тогда   
			// КОНЕЦ Юдина Екатерина 21.04.2026 Выполнение задач №000057412	
				Строка.Удалить = Истина;	
				Продолжить;
			КонецЕсли; 
		КонецЦикла;   
	КонецЦикла;  
	
	КоличествоСтрок = ТаблицаДанныхФайл.Количество()-1;
	ИндексСтроки = КоличествоСтрок;
	Для Счетчик = 0 по КоличествоСтрок Цикл
		Строка = ТаблицаДанныхФайл.Получить(ИндексСтроки);
		Если Строка.Удалить Тогда
			ТаблицаДанныхФайл.Удалить(Строка);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;   	
	
КонецПроцедуры

#КонецОбласти 

#Область ЗагрузкаДанных

// Данилова Мария 26.02.2022 Выполнение задач №000040506
&НаСервере
Процедура ЗагрузитьДанныеБронированийНаСервере()
	
	ТаблицаДанных = Объект.ТаблицаДанных.Выгрузить();
	
	ТекущийНомерБилета = 0;
	пБронированиеОтказЗаписи = Истина;
	пБронирование = ""; 
	
	// НАЧАЛО Редько Екатерина 06.10.2022 Выполнение задач №000042878   
	МассивПользователей = ТаблицаДанных.ВыгрузитьКолонку("Сотрудник");
	пЗапросПодразделения = Новый Запрос;
	пЗапросПодразделения.УстановитьПараметр("ФизическоеЛицо", МассивПользователей);
	пЗапросПодразделения.Текст =
	// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
	//"ВЫБРАТЬ ПЕРВЫЕ 1    
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ    
	// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
	|	ТекущиеКадровыеДанныеСотрудников.тнПодразделение КАК тнПодразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо В(&ФизическоеЛицо)";
	ВыборкаПоФизлицу = пЗапросПодразделения.Выполнить().Выбрать();  
	// КОНЕЦ  Редько Екатерина 06.10.2022 Выполнение задач №000042878
	Для каждого пОперация Из ТаблицаДанных Цикл
		
		Если НЕ пОперация.НомерБилета = ТекущийНомерБилета 
			И НЕ пОперация.НомерБилета = "" Тогда
			
			Если НЕ пБронированиеОтказЗаписи Тогда
				Попытка
					пБронирование.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					пБронирование.Записать(РежимЗаписиДокумента.Запись);
				КонецПопытки;
				
				// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
				стрРезультатЗагрузки = ТаблицаРезультатЗагрузки.Добавить();    
				стрРезультатЗагрузки.УПД_УКД = пОперация.НомерУПД;
				стрРезультатЗагрузки.Документ = пБронирование.Ссылка;
				стрРезультатЗагрузки.ОписаниеУслуги = пОперация.ДеталиПоездки;   
				стрРезультатЗагрузки.Результат = ?(пБронирование.Проведен, "Проведен", "Не проведен");
				стрРезультатЗагрузки.ОписаниеОшибки = ?(пБронирование.Проведен, "", "Ошибка записи/проведения"); 
				// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
