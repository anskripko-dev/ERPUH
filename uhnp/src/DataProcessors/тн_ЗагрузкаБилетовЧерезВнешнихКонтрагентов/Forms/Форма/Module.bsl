			СтрокиКонтрагентов = ТаблицаСопоставленияИННКонтрагентов.НайтиСтроки(Новый Структура("ИНН", Стр.СтрокаНеоднозначности));	
			
			Если СтрокиКонтрагентов.Количество() = 0 Тогда 
