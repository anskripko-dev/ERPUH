// Юдина Екатерина 30.01.2025 Выполнение задач №000052453  
//
&НаКлиенте
Процедура ОчиститьТекущуюСтраницу(Команда)
	
	ИмяСтраницы = Элементы.ГруппаНастройки.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "ГруппаНесопоставленные" Тогда	
		
		ОчиститьТабличнуюЧасть(ТаблицаНесопоставленных);    
				
	ИначеЕсли ИмяСтраницы = "ГруппаТаблицаДанных" Тогда	
		
		ОчиститьТабличнуюЧасть(Объект.ТаблицаДанных);    
		ОчиститьТабличнуюЧасть(Объект.ТаблицаДанныхПТиУ);
		
	Иначе  
		
		ОчиститьТабличнуюЧасть(ЭтотОбъект[СтрЗаменить(ИмяСтраницы,"Группа","Таблица")]);         
		
	КонецЕсли; 
	
КонецПроцедуры

