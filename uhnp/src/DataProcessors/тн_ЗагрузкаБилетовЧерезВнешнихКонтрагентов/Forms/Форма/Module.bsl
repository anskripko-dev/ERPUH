// Блинова М.А. 11.02.2025 Выполнение задач №000052599   
//Функция ДокЗагруженРанее(этоДокБилет, УникальныйНомер, струкДанныеВозврата = Неопределено)
Функция ДокЗагруженРанее(этоДокБилет, УникальныйНомер, струкДанныеВозврата = Неопределено, Организация = Неопределено)

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("УникальныйНомер", УникальныйНомер);
	Если НЕ струкДанныеВозврата = Неопределено Тогда
	
		Запрос.УстановитьПараметр("УПД", струкДанныеВозврата.УПД);
		пСумма = Число(струкДанныеВозврата.Сумма);
		Запрос.УстановитьПараметр("Сумма", пСумма * ?(пСумма>0, 1, -1));
	
	КонецЕсли;
	
	Если этоДокБилет И НЕ струкДанныеВозврата = Неопределено Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БронированиеОперации.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Бронирование.Операции КАК БронированиеОперации
		|ГДЕ
		|	БронированиеОперации.Ссылка.НомерБилета = &УникальныйНомер
		|	И НЕ БронированиеОперации.Ссылка.ПометкаУдаления
		|	И БронированиеОперации.Комментарий ПОДОБНО &УПД
		|	И БронированиеОперации.Сумма = &Сумма";  
		//НАЧАЛО Блинова М.А. 11.02.2025 Выполнение задач №000052599
		Если НЕ Организация = Неопределено Тогда 
			Запрос.Текст =Запрос.Текст + " и БронированиеОперации.Ссылка.Организация = &Организация"; 
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 11.02.2025 Выполнение задач №000052599

	ИначеЕсли этоДокБилет Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Бронирование.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Бронирование КАК Бронирование
		|ГДЕ
		|	Бронирование.НомерБилета = &УникальныйНомер
		|	И НЕ Бронирование.ПометкаУдаления"; 
		//НАЧАЛО Блинова М.А. 11.02.2025 Выполнение задач №000052599
		Если НЕ Организация = Неопределено Тогда 
			Запрос.Текст = Запрос.Текст + " и Бронирование.Организация = &Организация"; 
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 11.02.2025 Выполнение задач №000052599
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
		|ГДЕ
		|	ПриобретениеТоваровУслуг.НомерВходящегоДокумента = &УникальныйНомер
		|	И НЕ ПриобретениеТоваровУслуг.ПометкаУдаления";
		//НАЧАЛО Блинова М.А. 11.02.2025 Выполнение задач №000052599
		Если НЕ Организация = Неопределено Тогда 
			Запрос.Текст = Запрос.Текст + " и ПриобретениеТоваровУслуг.Организация = &Организация";
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 11.02.2025 Выполнение задач №000052599
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина); 
	//НАЧАЛО Блинова М.А. 25.02.2025 Выполнение задач №000052599  
	Если НЕ Организация = Неопределено Тогда 
			Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли; 
	//КОНЕЦ Блинова М.А. 25.02.2025 Выполнение задач №000052599
	пРезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ пРезультатЗапроса.Пустой();

КонецФункции

