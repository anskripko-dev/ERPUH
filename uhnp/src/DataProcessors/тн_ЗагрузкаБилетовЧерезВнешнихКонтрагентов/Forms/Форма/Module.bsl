					Объект.ТаблицаДанныхПТиУ.Удалить(СтрокаПТиУ);						
				
				КонецЕсли;		
			
			КонецЦикла;
			// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
			стрСопоставленные = ТаблицаСопоставленные.Добавить();    
			ЗаполнитьЗначенияСвойств(стрСопоставленные, строкаБезОшибок);
			ТаблицаНесопоставленных.Удалить(строкаБезОшибок);
			// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
			
		КонецЕсли;
	
	КонецЦикла;
	
	Попытка
		РаботаСФайламиУХ.УдалитьФайлыАсинхронно(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
