			пДок.ЗакупкаПодДеятельность	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			
			пДок.Менеджер				= Объект.Ответственный;
			
		КонецЕсли;
			
		Если (ТекущийНомерУПД = 0 ИЛИ пОперация.НомерВходящегоДокумента = ТекущийНомерУПД)
			И НЕ пОперация.НомерВходящегоДокумента = "" Тогда
			
			СтрокаТовары = пДок.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовары, пОперация);
			СтрокаТовары.КоличествоУпаковок	= 1;
			СтрокаТовары.Цена				= пОперация.СуммаСНДС;
			СтрокаТовары.Сумма				= СтрокаТовары.СуммаСНДС - СтрокаТовары.СуммаНДС;
			СтрокаТовары.СписатьНаРасходы	= Истина;
			// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
			СтрокаТовары.тн_Сотрудник		= пОперация.Сотрудник;
			СтрокаТовары.Количество	= 1;
			// НАЧАЛО Гутарова Екатерина 05.03.2024 Выполнение задач №000048743
			//СтрокаТовары.Подразделение = пДок.Подразделение; 
			СтрокаТовары.Подразделение = СтрокаТовары.АналитикаРасходов; 
			// КОНЕЦ Гутарова Екатерина 05.03.2024 Выполнение задач №000048743
			// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
			пДок.Комментарий = ?(пДок.Комментарий = "", пОперация.Комментарий, пДок.Комментарий + Символы.ПС + пОперация.Комментарий);
			Если пОперация.СуммаСНДС < 0 Тогда 
				ОбщегоНазначения.СообщитьПользователю("Отрицательная сумма должна сопровождаться словом Возврат в Описании услуги и признаком Билет.
					|В противном случае отрицательная сумма считается ошибкой. (Номер УПД № "+ТекущийНомерУПД+")");
				пБронированиеОтказЗаписи = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла; 
		
	Если НЕ пДок = "" 
		И НЕ пДокОтказЗаписи Тогда     
		
		// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453   
		КоличествоСтрокБезНДС = пДок.Товары.НайтиСтроки(Новый Структура ("СтавкаНДС", Справочники.СтавкиНДС.БезНДС)).Количество();
		ДокументБезНДС = пДок.Товары.Количество() = КоличествоСтрокБезНДС;
		
		Если ДокументБезНДС Тогда
			пДок.тн_НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
			пДок.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
		КонецЕсли;	
		// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		
		Попытка
			пДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			пДок.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		// НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
		стрРезультатЗагрузки = ТаблицаРезультатЗагрузки.Добавить();    
		стрРезультатЗагрузки.УПД_УКД = ТекущийНомерУПД;
		стрРезультатЗагрузки.Документ = пДок.Ссылка;
		стрРезультатЗагрузки.ОписаниеУслуги = пОперация.Комментарий;   
		стрРезультатЗагрузки.Результат = ?(пДок.Проведен, "Проведен", "Не проведен");
		стрРезультатЗагрузки.ОписаниеОшибки = ?(пДок.Проведен, "", "Ошибка записи/проведения"); 
		// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034
		ОбщегоНазначения.СообщитьПользователю("Записан ПТиУ № "+ТекущийНомерУПД+")", пДок.Ссылка);
		
		пДокОтказЗаписи = Ложь;
		ТекущийНомерУПД = 0;
		
		// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453   
		Если Не ДокументБезНДС Тогда
		// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		
		    // НАЧАЛО Редько Екатерина 19.10.2022 Выполнение задач №000043034
			//Создание СФ  
			НовыйДокументСчетФактураПолученный = СоздатьСФ(пДок);
			
			стрРезультатЗагрузки = ТаблицаРезультатЗагрузки.Добавить();    
			стрРезультатЗагрузки.УПД_УКД = ТекущийНомерУПД;
			стрРезультатЗагрузки.Документ = НовыйДокументСчетФактураПолученный.Ссылка;
			стрРезультатЗагрузки.ОписаниеУслуги = пОперация.Комментарий;   
			стрРезультатЗагрузки.Результат = ?(НовыйДокументСчетФактураПолученный.Проведен, "Проведен", "Не проведен");
			стрРезультатЗагрузки.ОписаниеОшибки = ?(НовыйДокументСчетФактураПолученный.Проведен, "", "Ошибка записи/проведения"); 
			ОбщегоНазначения.СообщитьПользователю("Записан СФ полученный № "+НовыйДокументСчетФактураПолученный.Номер, НовыйДокументСчетФактураПолученный.Ссылка);
			// КОНЕЦ  Редько Екатерина 19.10.2022 Выполнение задач №000043034  
			
		// НАЧАЛО Юдина Екатерина 30.01.2025 Выполнение задач №000052453   
		КонецЕсли;	
		// КОНЕЦ Юдина Екатерина 30.01.2025 Выполнение задач №000052453
		
	КонецЕсли;
	
КонецПроцедуры 

// Редько Екатерина 19.10.2022 Выполнение задач №000043034
&НаСервере
Функция СоздатьСФ(пДок)
	СтруктураЗаполненияСФ = Новый Структура;
	СтруктураЗаполненияСФ.Вставить("ДокументОснование", пДок.Ссылка);
	СтруктураЗаполненияСФ.Вставить("Корректировочный", Ложь);
	
	НовыйДокументСчетФактураПолученный = Документы.СчетФактураПолученный.СоздатьДокумент();
	НовыйДокументСчетФактураПолученный.Заполнить(СтруктураЗаполненияСФ);
	НовыйДокументСчетФактураПолученный.ПолученВЭлектронномВиде = Ложь;
	НовыйДокументСчетФактураПолученный.Дата = пДок.Дата;
	НовыйДокументСчетФактураПолученный.ДатаЗаписиКнигиПродаж = НовыйДокументСчетФактураПолученный.Дата;
	НовыйДокументСчетФактураПолученный.ДатаСоставления = НовыйДокументСчетФактураПолученный.Дата;
	НовыйДокументСчетФактураПолученный.Корректировочный = Ложь;	
	НовыйДокументСчетФактураПолученный.Номер = пДок.Номер;
	НовыйДокументСчетФактураПолученный.Записать(РежимЗаписиДокумента.Запись);     
	Возврат НовыйДокументСчетФактураПолученный;
КонецФункции

