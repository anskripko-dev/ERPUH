&НаКлиенте
Перем ADOX_Catalog;

&НаКлиенте
Процедура ИсточникИмяФайлаПриИзменении(Элемент)
	
	ПриИзмененииИмениФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыборФайла.Фильтр = Нстр("ru = 'Файлы Microsoft Excel (*.xls, *.xlsx)|*.xls; *.xlsx|Все файлы (*.*)|*.*'");
	ДиалогВыборФайла.Показать(Новый ОписаниеОповещения("ИсточникИмяФайлаНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ДиалогВыборФайла", ДиалогВыборФайла)));
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникИмяФайлаНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    
    ДиалогВыборФайла = ДополнительныеПараметры.ДиалогВыборФайла;
    
    
    Если (ВыбранныеФайлы <> Неопределено) Тогда
        ИсточникИмяФайла = ДиалогВыборФайла.ПолноеИмяФайла;
        ПриИзмененииИмениФайла();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИсточникИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Попытка
		ОбщегоНазначенияКлиент.ОткрытьФайлВПрограммеПросмотра(ИсточникИмяФайла);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииИмениФайла(ВыбратьТаблицуАвтоматически = Истина)
	
	ПолучитьДанныеФайла();
	
	ЗаполнитьСписокТаблицИсточника();
	
	Если ВыбратьТаблицуАвтоматически Тогда
			
		Если Элементы.ИсточникТаблицаФайлаПредставление.СписокВыбора.Количество() Тогда
			ИмяТаблицы = Элементы.ИсточникТаблицаФайлаПредставление.СписокВыбора[0].Значение;
		Иначе
			ИмяТаблицы = "";
		КонецЕсли;
		
		ИсточникТаблицаФайла = ИмяТаблицы;
		ПриИзмененииТаблицыФайла();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура НайтиТипБД()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицыADO.Владелец КАК ТипБД
	|ИЗ
	|	Справочник.ТаблицыADO КАК ТаблицыADO
	|ГДЕ
	|	ТаблицыADO.ИмяФайла = &ИмяФайла";
	
	Запрос.УстановитьПараметр("ИмяФайла",ИмяФайла);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ТипБД=Результат.ТипБД;
		
	КонецЕсли;
	
	ОпределитьПравилоЗаполнения();
	
КонецПроцедуры // НайтиТипБД()

&НаСервере
Процедура ОпределитьПравилоЗаполнения()
	
	Если НЕ (ЗначениеЗаполнено(ТипБД) И ЗначениеЗаполнено(ОбъектПриемник)) Тогда
		
		ПравилоЗаполненияОбъекта="";
		
	Иначе
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ПравилаЗаполненияОбъектовБД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПравилаЗаполненияОбъектовБД КАК ПравилаЗаполненияОбъектовБД
		|ГДЕ
		|	ПравилаЗаполненияОбъектовБД.ТипБД = &ТипБД
		|	И ПравилаЗаполненияОбъектовБД.Владелец = &Владелец
		|	И НЕ ПравилаЗаполненияОбъектовБД.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ТипБД",ТипБД);
		Запрос.УстановитьПараметр("Владелец",ОбъектПриемник);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			ПравилоЗаполненияОбъекта=Результат.Ссылка;
			
		Иначе
			
			ПравилоЗаполненияОбъекта="";
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ПриИзмененииПравилаЗаполнения();
	
КонецПроцедуры // ОпределитьПравилоЗаполнения()

&НаСервере
Процедура ПриИзмененииПравилаЗаполнения()
	
	ИсточникШапка="";
	ИсточникТЧ="";
	
	Если ЗначениеЗаполнено(ОбъектПриемникТЧ) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ПравилаЗаполненияОбъектовБДИсточникиДляЗаполненияТЧ.ИсточникДанных КАК ИсточникТЧ
		|ИЗ
		|	Справочник.ПравилаЗаполненияОбъектовБД.ИсточникиДляЗаполненияТЧ КАК ПравилаЗаполненияОбъектовБДИсточникиДляЗаполненияТЧ
		|ГДЕ
		|	ПравилаЗаполненияОбъектовБДИсточникиДляЗаполненияТЧ.Ссылка = &Ссылка
		|	И ПравилаЗаполненияОбъектовБДИсточникиДляЗаполненияТЧ.ТабличнаяЧасть = &ТабличнаяЧасть";
		
		Запрос.УстановитьПараметр("Ссылка",ПравилоЗаполненияОбъекта);
		Запрос.УстановитьПараметр("ТабличнаяЧасть",ОбъектПриемникТЧ);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			ИсточникТЧ=Результат.ИсточникТЧ;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ИсточникШапка=ПравилоЗаполненияОбъекта.ИсточникДляЗаполненияШапки;
	
	ЗаполнитьДеревоПолейПриемник();
			
КонецПроцедуры // ПриИзмененииПравилаЗаполнения() 

&НаКлиенте
Процедура ОпределитьТипБД()
	
	ТипБД="";
	
	МассивФайлов=НайтиФайлы(ИсточникИмяФайла);
	
	Если МассивФайлов.Количество()>0 Тогда
		
		ИмяФайла=МассивФайлов[0].Имя;
		ИмяБезРасширения=МассивФайлов[0].ИмяБезРасширения;
		ПутьКФайлу=МассивФайлов[0].Путь;
		НайтиТипБД();
		
	КонецЕсли;
		
КонецПроцедуры // ОпределитьТипБД() 

&НаКлиенте
Процедура ПолучитьДанныеФайла()
	
	ИсточникТаблицы.Очистить();
		
	Если ПустаяСтрока(ИсточникИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ОпределитьТипБД();
		
	Попытка
		
		ADOX_Catalog.ActiveConnection = "Driver={Microsoft Excel Driver (*.xls, *.xlsx, *.xlsm, *.xlsb)};DBQ=" + ИсточникИмяФайла;
		
		Представления = Новый Соответствие;
		Имена = Новый Соответствие;
		
		Для Каждого Table Из ADOX_Catalog.Tables Цикл
			
			Если НЕ (Найти(ВРЕГ(Table.Type), "TABLE") > 0 ИЛИ ВРЕГ(Table.Type) = "VIEW") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Прав(Table.Name, 1) = "$" Тогда
				Представление = Сред(Table.Name, 1, СтрДлина(Table.Name) - 1);
			ИначеЕсли Прав(Table.Name, 2) = "$'" Тогда
				Представление = Сред(Table.Name, 2, СтрДлина(Table.Name) - 3);
			Иначе
				Представление = Table.Name;
			КонецЕсли;
			
			Значение = Представления[Представление];
			
			Если Значение = Неопределено Тогда
				Представления.Вставить(Представление, Table.Name);
			Иначе
				СтрокаТаблица = Имена[Значение];
				Если Прав(Значение, 1) = "$" ИЛИ Прав(Table.Name, 2) = "$'" Тогда
					СтрокаТаблица.Представление = СтрШаблон(Нстр("ru = '%1 (лист)'"), СтрокаТаблица.Представление);
					Представление = СтрШаблон(Нстр("ru = '%1 (диапазон)'"), Представление);
				Иначе
					СтрокаТаблица.Представление = СтрШаблон(Нстр("ru = '%1 (диапазон)'"), СтрокаТаблица.Представление);
					Представление = СтрШаблон(Нстр("ru = '%1 (лист)'"), Представление);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТаблица = ИсточникТаблицы.Добавить();
			СтрокаТаблица.Имя = Table.Name;
			СтрокаТаблица.Представление = Представление;
			
			Имена.Вставить(СтрокаТаблица.Имя, СтрокаТаблица);
			
			Для Каждого Column Из Table.Columns Цикл
				
				ТипКолонки = УправлениеСоединениямиВИБУХ.ВернутьТипЗначенияВВидеСтроки(Column.Type);
				Если ТипКолонки = "НеПоддерживается" Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = СтрокаТаблица.Колонки.Добавить();
				НоваяСтрока.Имя = Column.Name;
				НоваяСтрока.Тип = Новый ОписаниеТипов(ТипКолонки);
				НоваяСтрока.ТипЗначения.ЗагрузитьЗначения(НоваяСтрока.Тип.Типы());
				
			КонецЦикла;
			
		КонецЦикла;
		
		ADOX_Catalog.ActiveConnection.Close();
		
	Исключение
		ПоказатьПредупреждение(, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокТаблицИсточника()
	
	СписокТаблицИсточника = Элементы.ИсточникТаблицаФайлаПредставление.СписокВыбора;
	СписокТаблицИсточника.Очистить();
	
	Для Каждого Таблица Из ИсточникТаблицы Цикл
		СписокТаблицИсточника.Добавить(Таблица.Имя, Таблица.Представление);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииТаблицыФайла()
	
	Если ПустаяСтрока(ИсточникТаблицаФайла) Тогда
		ИсточникТаблицаФайлаПредставление = "";
	Иначе
		ИсточникТаблицаФайлаПредставление = Элементы.ИсточникТаблицаФайлаПредставление.СписокВыбора.НайтиПоЗначению(ИсточникТаблицаФайла).Представление;
	КонецЕсли;
		
	ЗаполнитьСписокПолейИсточника();
	
	Если ЗначениеЗаполнено(ОбъектПриемник) Тогда
		
		СохранитьТекущиеНастройки();
		ЗаполнитьДеревоПолейПриемник();
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокПолейИсточника()
	
	ЭлементыКолонки = ПоляИсточника.ПолучитьЭлементы();
	ЭлементыКолонки.Очистить();
	
	МассивТаблиц = Новый Массив;
	МассивТаблиц.Добавить(ИсточникТаблицаФайла);
	
	Для Каждого Элемент Из ИсточникСоединения Цикл
		МассивТаблиц.Добавить(Элемент.Таблица);
	КонецЦикла; 
	
	Для Каждого Таблица Из МассивТаблиц Цикл
		
		СтрокаТаблица = ИсточникТаблицы.НайтиСтроки(Новый Структура("Имя", Таблица))[0];
			
		Для Каждого СтрокаКолонка Из СтрокаТаблица.Колонки Цикл
			
			ЭлементКолонка = ЭлементыКолонки.Добавить();
			ЭлементКолонка.Тип = СтрокаКолонка.Тип;
			ЭлементКолонка.ТипЗначения.ЗагрузитьЗначения(СтрокаКолонка.ТипЗначения.ВыгрузитьЗначения());

			ЭлементКолонка.Картинка = 1;
			
			Если МассивТаблиц.Количество() = 1 Тогда
				ЭлементКолонка.Имя = "[" + СтрокаКолонка.Имя + "]";
				ЭлементКолонка.Представление = СтрокаКолонка.Имя;
			Иначе
				ЭлементКолонка.Имя = "[" + СтрокаТаблица.Имя + "].[" + СтрокаКолонка.Имя + "]";
				ЭлементКолонка.Представление = "[" + СтрокаТаблица.Представление + "] " + СтрокаКолонка.Имя;
			КонецЕсли;
			
			ЭлементКолонка.Идентификатор = ЭлементКолонка.ПолучитьИдентификатор();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриемникПолноеИмяПриИзменении(Элемент)
	
	ПриИзменениеПолногоИмениПриемника();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриемникПолноеИмяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КоллекцииВыбираемыхОбъектовМетаданных = Новый СписокЗначений;
	КоллекцииВыбираемыхОбъектовМетаданных.Добавить("Документы");
		
	ВыбранныеОбъектыМетаданных = Новый СписокЗначений;
	
	Если НЕ ПустаяСтрока(ПриемникПолноеИмя) Тогда
		ВыбранныеОбъектыМетаданных.Добавить(ПриемникПолноеИмя);
	КонецЕсли;
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("КоллекцииВыбираемыхОбъектовМетаданных", КоллекцииВыбираемыхОбъектовМетаданных);
	ПараметрыФормыВыбора.Вставить("ВыбранныеОбъектыМетаданных", ВыбранныеОбъектыМетаданных);
	ПараметрыФормыВыбора.Вставить("НачальноеЗначениеВыбора", ПриемникПолноеИмя);
	ПараметрыФормыВыбора.Вставить("ВыборЕдинственного", Истина);
	ПараметрыФормыВыбора.Вставить("УникальныйИдентификаторИсточник", УникальныйИдентификатор);
	ПараметрыФормыВыбора.Вставить("ВыводитьТабличныеЧасти", Истина);
	
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданныхУХ", ПараметрыФормыВыбора, ЭтаФорма,,,, Новый ОписаниеОповещения("ПриемникПолноеИмяНачалоВыбораЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриемникПолноеИмяНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    

КонецПроцедуры

&НаКлиенте
Процедура ПриемникПолноеИмяОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Попытка
		ОткрытьФорму(ПриемникПолноеИмя + ".ФормаСписка");
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьТекущиеНастройки()
	
	Если Не ЗначениеЗаполнено(ОбъектПриемник) Тогда
		
		Возврат;
		
	КонецЕсли;
		
	СтрНастройки=НастройкиЗаполнения.НайтиСтроки(Новый Структура("ИмяТаблицы,ОбъектПриемник,ОбъектПриемникТЧ,ПравилоЗаполненияОбъекта",ИсточникТаблицаФайла,ОбъектПриемник,ОбъектПриемникТЧ,ПравилоЗаполненияОбъекта));
	
	Если СтрНастройки.Количество()>0 Тогда
		
		РабочаяСтрока=СтрНастройки[0];
		
	Иначе
		
		РабочаяСтрока=НастройкиЗаполнения.Добавить();
		РабочаяСтрока.ИмяТаблицы			= ИсточникТаблицаФайла;
		РабочаяСтрока.ОбъектПриемник		= ОбъектПриемник;
		РабочаяСтрока.ОбъектПриемникТЧ		= ОбъектПриемникТЧ;
		
		
	КонецЕсли;
	
	РабочаяСтрока.ПравилоЗаполненияОбъекта	= ПравилоЗаполненияОбъекта;
	РабочаяСтрока.ИсточникШапка			= ИсточникШапка;
	РабочаяСтрока.ИсточникТЧ			= ИсточникТЧ;
	РабочаяСтрока.РабочийОбъектАдрес=РабочийОбъектАдрес;
	РабочаяСтрока.НастройкаЗаполнения=Новый ХранилищеЗначения(РеквизитФормыВЗначение("ДеревоПолейПриемник"));
	
КонецПроцедуры // СохранитьТекущиеНастройки()	

&НаСервере
Процедура ПриИзменениеПолногоИмениПриемника()
	
	СохранитьТекущиеНастройки();
	ОпределитьОбъектПриемник();
	
	Если НЕ ЗначениеЗаполнено(ПравилоЗаполненияОбъекта) Тогда
		
		ЗаполнитьДеревоПолейПриемник();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОпределитьОбъектПриемник()
	
	МассивПутей=СтрРазделить(ПриемникПолноеИмя,".");
	
	ТипОбъектаМетаданных=МассивПутей[0];
	ИмяОбъектаМетаданных=МассивПутей[1];
	
	ОбъектПриемник=Неопределено;
	ОбъектПриемникТЧ=Неопределено;
	
	Запрос=Новый Запрос;
		
	Запрос.Текст="ВЫБРАТЬ
	|	ДокументыБД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДокументыБД КАК ДокументыБД
	|ГДЕ
	|	ДокументыБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И ДокументыБД.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование",ИмяОбъектаМетаданных);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Результат.Следующий();
	ОбъектПриемник=Результат.Ссылка;
	
	Если МассивПутей.Количество()=4 Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		|	ТабличныеЧастиБД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТабличныеЧастиБД КАК ТабличныеЧастиБД
		|ГДЕ
		|	ТабличныеЧастиБД.Владелец = &Владелец
		|	И ТабличныеЧастиБД.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Владелец",ОбъектПриемник);
		Запрос.УстановитьПараметр("Наименование",МассивПутей[3]);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Результат.Следующий();
		ОбъектПриемникТЧ=Результат.Ссылка;
		
	КонецЕсли;
	
	ОпределитьПравилоЗаполнения();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьДеревоПолейПриемник()
	
	СтрНастройки=НастройкиЗаполнения.НайтиСтроки(Новый Структура("ИмяТаблицы,ОбъектПриемник,ОбъектПриемникТЧ,ПравилоЗаполненияОбъекта",ИсточникТаблицаФайла,ОбъектПриемник,ОбъектПриемникТЧ,ПравилоЗаполненияОбъекта));
	
	Если СтрНастройки.Количество()>0 Тогда
		
		ЗначениеВРеквизитФормы(СтрНастройки[0].НастройкаЗаполнения.Получить(),"ДеревоПолейПриемник");
		РабочийОбъектАдрес=СтрНастройки[0].РабочийОбъектАдрес;
		ИсточникШапка=СтрНастройки[0].ИсточникШапка;
		ИсточникТЧ=СтрНастройки[0].ИсточникТЧ;
		
		Возврат;
		
	КонецЕсли;
		
	ИсточникОбъект=Справочники.ИсточникиДанныхДляРасчетов.СоздатьЭлемент();
	ИсточникОбъект.ОбъектБД=ОбъектПриемник;
	ИсточникОбъект.ТабличнаяЧастьБД=ОбъектПриемникТЧ;
	ИсточникОбъект.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеСправочники;
	ИсточникОбъект.СпособИспользования=Перечисления.СпособыИспользованияОперандов.ДляЗаполненияОбъектовБД;
	ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
	ИсточникОбъект.ПриИзмененииОбъектаБД();
	
	РабочийОбъектАдрес=ПоместитьВоВременноеХранилище(ИсточникОбъект.ПодготовитьСтруктуруПеременныхДляРасчета(),ЭтаФорма.УникальныйИдентификатор);
	
	ИсточникОбъект.ДеревоПолейБД.Колонки.Добавить("ВозможенПоиск",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ИсточникОбъект.ДеревоПолейБД.Колонки.Добавить("Поиск",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ИсточникОбъект.ДеревоПолейБД.Колонки.Добавить("ИмяРеквизита",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(150));
	
	Для Каждого Строка ИЗ ИсточникОбъект.ДеревоПолейБД.Строки Цикл
		
		Строка.ИмяРеквизита=Строка.ПолеБД;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСерверУХ.ПоместитьДеревоЗначенийВКоллекциюФормы(ИсточникОбъект.ДеревоПолейБД,ДеревоПолейПриемник);

	ИсточникОбъект.ДеревоПолейБД=РеквизитФормыВЗначение("ДеревоПолейПриемник");
	
	УстановитьСуществующиеНастройки(ИсточникОбъект);
	
	Если ЗначениеЗаполнено(ОбъектПриемникТЧ) Тогда
		
		СтрокаСсылка=ИсточникОбъект.ДеревоПолейБД.Строки.Найти("Ссылка","ПолеБД");
		Для Каждого Строка ИЗ СтрокаСсылка.Строки Цикл
			
			Строка.ВозможенПоиск=Истина;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Строка ИЗ ИсточникОбъект.ДеревоПолейБД.Строки Цикл
			
			Строка.ВозможенПоиск=Истина;
			
		КонецЦикла;
		
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСерверУХ.ПоместитьДеревоЗначенийВКоллекциюФормы(ИсточникОбъект.ДеревоПолейБД,ДеревоПолейПриемник);
	
КонецПроцедуры // ЗаполнитьДеревоПолейПриемник()

&НаСервере
Процедура УстановитьСуществующиеНастройки(ИсточникОбъект)
	
	ДеревоИсточник=РеквизитФормыВЗначение("ПоляИсточника");
	
	Если ЗначениеЗаполнено(ИсточникШапка) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.Поле КАК Поле,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.ФиксированноеЗначение КАК ФиксированноеЗначение,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.СпособЗаполнения КАК СпособЗаполнения,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.КодАналитики КАК КодАналитики
		|ИЗ
		|	Справочник.ИсточникиДанныхДляРасчетов.ПравилаИспользованияПолейЗапроса КАК ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса
		|ГДЕ
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",ИсточникШапка);
		Результат=Запрос.Выполнить().Выбрать();
		
		УстановитьНастройкиШапки(ИсточникОбъект,Результат,ДеревоИсточник);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсточникТЧ) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.Поле КАК Поле,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.ФиксированноеЗначение КАК ФиксированноеЗначение,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.СпособЗаполнения КАК СпособЗаполнения,
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.КодАналитики КАК КодАналитики
		|ИЗ
		|	Справочник.ИсточникиДанныхДляРасчетов.ПравилаИспользованияПолейЗапроса КАК ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса
		|ГДЕ
		|	ИсточникиДанныхДляРасчетовПравилаИспользованияПолейЗапроса.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",ИсточникТЧ);
		Результат=Запрос.Выполнить().Выбрать();
		
		УстановитьНастройкиТЧ(ИсточникОбъект,Результат,ДеревоИсточник);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПравилоЗаполненияОбъекта) Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ПравилаЗаполненияОбъектовБДРеквизитыШапкиДляСинхронизацииТЧ.Имя КАК Имя
		|ИЗ
		|	Справочник.ПравилаЗаполненияОбъектовБД.РеквизитыШапкиДляСинхронизацииТЧ КАК ПравилаЗаполненияОбъектовБДРеквизитыШапкиДляСинхронизацииТЧ
		|ГДЕ
		|	ПравилаЗаполненияОбъектовБДРеквизитыШапкиДляСинхронизацииТЧ.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",ПравилоЗаполненияОбъекта);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если ЗначениеЗаполнено(ОбъектПриемникТЧ) Тогда
			
			СтрокиСсылка=ИсточникОбъект.ДеревоПолейБД.Строки.Найти("Ссылка","ПолеБД");
			
		Иначе
			
			СтрокиСсылка=ИсточникОбъект.ДеревоПолейБД;
			
		КонецЕсли;
		
		Пока Результат.Следующий() Цикл
			
			СтрокаПоиска=СтрокиСсылка.Строки.Найти(Результат.Имя,"ИмяРеквизита");
			
			Если НЕ СтрокаПоиска=Неопределено Тогда
				
				СтрокаПоиска.Поиск=Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоИсточник,"ПоляИсточника");
	
КонецПроцедуры // УстановитьСуществующиеНастройки()

&НаСервере
Процедура УстановитьНастройкиТЧ(ИсточникОбъект,Результат,ДеревоИсточник)
			
	КоллекцияРеквизитов=ИсточникОбъект.ДеревоПолейБД;
				
	Пока Результат.Следующий() Цикл
		
		СтрокаРеквизит=КоллекцияРеквизитов.Строки.Найти(Результат.КодАналитики,"ИмяРеквизита");
		
		Если СтрокаРеквизит=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтрокаРеквизит.НастройкаСоответствия=Результат.НастройкаСоответствия;
		
		Если Результат.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
			
			СтрокаРеквизит.ПолеИсточника=Результат.Поле;
			СтрокаРеквизит.СпособЗаполнения=Результат.СпособЗаполнения;
			СтрокаРеквизит.Сопоставлено=Истина;
			
			Если ЗначениеЗаполнено(Результат.НастройкаСоответствия) И СтрокаРеквизит.Строки.Количество()=0 Тогда // Соответствие перечислений
				
				ПолучитьПолеПеречисления(СтрокаРеквизит,ДеревоИсточник);
				
			Иначе
				
				ОтметитьУстановленноеСоответствие(Результат.Поле,СтрокаРеквизит.ПолеБД,ДеревоИсточник);
				
			КонецЕсли;
				
		Иначе
			
			СтрокаРеквизит.ПолеИсточника=Результат.Поле;
			СтрокаРеквизит.СпособЗаполнения=Результат.СпособЗаполнения;
			СтрокаРеквизит.ФиксированноеЗначение=Результат.ФиксированноеЗначение;
			
			Если СтрокаРеквизит.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				
				СтрокаРеквизит.ПолеИсточника=Строка(Результат.ФиксированноеЗначение);
				
			КонецЕсли;
			
			СтрокаРеквизит.Сопоставлено=Истина;
			
		КонецЕсли;
		
		Если (НЕ ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(СтрокаРеквизит))	
			И ЗначениеЗаполнено(СтрокаРеквизит.НастройкаСоответствия)
			и СтрокаРеквизит.Строки.Количество()>0 Тогда
			
			ДобавитьСтрокиСоответствияРекурсивно(ИсточникОбъект,СтрокаРеквизит,ДеревоИсточник);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УстановитьНастройкиШапки()

&НаСервере
Процедура РазвернутьСтрокуДерева(ИсточникОбъект,СтрокаРеквизит)
	
	СтруктураСтрока=ИсточникОбъект.СформироватьСтруктуруСтрокиБД(СтрокаРеквизит);
	ДанныеОбъекта=ИсточникОбъект.СформироватьДанныеОбъекта();
	
	РаботаСПолямиАналитикиУХ.ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока);
	
	АдресХранилищаПеременныхДляРасчета=ДанныеОбъекта.РабочийОбъектАдрес;
	
	СтрокаРеквизит.Строки.Очистить();
	
	Для Каждого СтрокаКДобавлению ИЗ СтруктураСтрока.СтрокиКДобавлению Цикл
		
		НоваяСтрока=СтрокаРеквизит.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		НоваяСтрока.ИмяРеквизита=ПолучитьИмяРеквизита(НоваяСтрока.ПолеБД);
		НоваяСтрока.УровеньВложенности=СтрокаРеквизит.УровеньВложенности+1;
		НоваяСтрока.ВозможенПоиск=(НоваяСтрока.ТипЗначения.Количество()=1);
			
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтрокиСервер(СтрокаКДобавлению,НоваяСтрока);
			НоваяСтрока.Картинка=0;
			
		Иначе
			
			НоваяСтрока.Картинка=1;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ДобавитьПодчиненныеСтроки() 

&НаСервере
Процедура ОтметитьУстановленноеСоответствие(ПолеИсточника,ПолеПриемника,ДеревоИсточник)
	
	Если ПустаяСтрока(ПолеИсточника) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрИсточник=ДеревоИсточник.Строки.НайтиСтроки(Новый Структура("Имя",ПолеИсточника),Истина);
	
	Если СтрИсточник.Количество()>0 Тогда
		
		СтрИсточник[0].ПредставлениеСопоставления=?(СтрИсточник[0].ПредставлениеСопоставления="", ПолеПриемника, СтрИсточник[0].ПредставлениеСопоставления+", "+ПолеПриемника);
		
	КонецЕсли;
			
КонецПроцедуры // ОтметитьУстановленноеСоответствие() 

&НаСервере
Процедура ПолучитьПолеПеречисления(СтрокаРеквизит,ДеревоИсточник)
	
	НастройкаСоответствияОбъект=СтрокаРеквизит.НастройкаСоответствия.ПолучитьОбъект();
	НастройкаСоответствияОбъект.мТаблицаСоответствия=НастройкаСоответствияОбъект.ТаблицаСоответствияВИБ.Получить();
	МассивСопоставлено=НастройкаСоответствияОбъект.мТаблицаСоответствия.Строки.НайтиСтроки(Новый Структура("Сопоставлено", Истина), Истина);
	
	Если МассивСопоставлено.Количество()>0 Тогда
		
		СтрокаРеквизит.ПолеИсточника=МассивСопоставлено[0].АналитикаБД;
		ОтметитьУстановленноеСоответствие(СтрокаРеквизит.ПолеИсточника,СтрокаРеквизит.ПолеБД,ДеревоИсточник);
		
	КонецЕсли;
		
КонецПроцедуры // ПолучитьПолеПеречисления() 

&НаСервере
Процедура УстановитьНастройкиШапки(ИсточникОбъект,Результат,ДеревоИсточник)
	
	Если ЗначениеЗаполнено(ОбъектПриемникТЧ) Тогда
		
		СтрокаШапка=ИсточникОбъект.ДеревоПолейБД.Строки.Найти("Ссылка","ПолеБД");
		РазвернутьСтрокуДерева(ИсточникОбъект,СтрокаШапка);
		КоллекцияРеквизитов=СтрокаШапка;
			
	Иначе
		
		КоллекцияРеквизитов=ИсточникОбъект.ДеревоПолейБД;
		
	КонецЕсли;
		
	Пока Результат.Следующий() Цикл
		
		СтрокаРеквизит=КоллекцияРеквизитов.Строки.Найти(Результат.КодАналитики,"ИмяРеквизита");
		СтрокаРеквизит.НастройкаСоответствия=Результат.НастройкаСоответствия;
		
		Если Результат.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
			
			СтрокаРеквизит.ПолеИсточника=Результат.Поле;
			СтрокаРеквизит.СпособЗаполнения=Результат.СпособЗаполнения;

			Если ЗначениеЗаполнено(Результат.НастройкаСоответствия) И СтрокаРеквизит.Строки.Количество()=0 Тогда // Соответствие перечислений
				
				ПолучитьПолеПеречисления(СтрокаРеквизит,ДеревоИсточник);
				
			Иначе
				
				ОтметитьУстановленноеСоответствие(Результат.Поле,СтрокаРеквизит.ПолеБД,ДеревоИсточник);
				
			КонецЕсли;
					
			СтрокаРеквизит.Сопоставлено=Истина;
				
		Иначе
			
			СтрокаРеквизит.ПолеИсточника=Результат.Поле;
			СтрокаРеквизит.СпособЗаполнения=Результат.СпособЗаполнения;
			СтрокаРеквизит.ФиксированноеЗначение=Результат.ФиксированноеЗначение;
			
			Если СтрокаРеквизит.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				
				СтрокаРеквизит.ПолеИсточника=Строка(Результат.ФиксированноеЗначение);
				
			КонецЕсли;	
			
			СтрокаРеквизит.Сопоставлено=Истина;
			
		КонецЕсли;
		
		Если (НЕ ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(СтрокаРеквизит))	
			И ЗначениеЗаполнено(СтрокаРеквизит.НастройкаСоответствия)
			и СтрокаРеквизит.Строки.Количество()>0 Тогда
			
			ДобавитьСтрокиСоответствияРекурсивно(ИсточникОбъект,СтрокаРеквизит,ДеревоИсточник);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УстановитьНастройкиШапки() 

&НаСервере
Процедура ДобавитьСтрокиСоответствияРекурсивно(ИсточникОбъект,СтрокаРеквизит,ДеревоИсточник)
	
	РазвернутьСтрокуДерева(ИсточникОбъект,СтрокаРеквизит);
		
	НастройкаСоответствияОбъект=СтрокаРеквизит.НастройкаСоответствия.ПолучитьОбъект();
	НастройкаСоответствияОбъект.мТаблицаСоответствия=НастройкаСоответствияОбъект.ТаблицаСоответствияВИБ.Получить();
	МассивСопоставлено=НастройкаСоответствияОбъект.мТаблицаСоответствия.Строки.НайтиСтроки(Новый Структура("Сопоставлено", Истина), Истина);
	
	Если СтрокаРеквизит.ТипЗначения.Количество()=1 Тогда
		
		Для Каждого СтрокаСоответствия ИЗ МассивСопоставлено Цикл
			
			НайденнаяСтрока=СтрокаРеквизит.Строки.Найти(СтрокаСоответствия.АналитикаКонсолидации,"ИмяРеквизита");
			
			Если НайденнаяСтрока=Неопределено Тогда  // Владелец
				
				Продолжить;
				
			КонецЕсли;
			
			НайденнаяСтрока.СпособЗаполнения=СтрокаСоответствия.СпособЗаполнения;
			НайденнаяСтрока.ПолеИсточника=СтрокаСоответствия.АналитикаБД;
			НайденнаяСтрока.Поиск=НЕ СтрокаСоответствия.НеИспользоватьДляСинхронизации;
			НайденнаяСтрока.ФиксированноеЗначение=СтрокаСоответствия.ФиксированноеЗначение;
			НайденнаяСтрока.Сопоставлено=Истина;
			НайденнаяСтрока.ВозможенПоиск=Истина;
			НайденнаяСтрока.НастройкаСоответствия=СтрокаСоответствия.НастройкаСоответствия;

			НайденнаяСтрока.Поиск=НЕ СтрокаСоответствия.НеИспользоватьДляСинхронизации; 
			
			Если НайденнаяСтрока.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
				
				Если ЗначениеЗаполнено(НайденнаяСтрока.НастройкаСоответствия) И НайденнаяСтрока.Строки.Количество()=0 Тогда // Соответствие перечислений
					
					ПолучитьПолеПеречисления(НайденнаяСтрока,ДеревоИсточник);
					
				Иначе
					
					ОтметитьУстановленноеСоответствие(НайденнаяСтрока.ПолеИсточника,НайденнаяСтрока.ПолеБД,ДеревоИсточник);
					
				КонецЕсли;
									
			ИначеЕсли НайденнаяСтрока.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				
				НайденнаяСтрока.ПолеИсточника=Строка(НайденнаяСтрока.ФиксированноеЗначение);
				
			КонецЕсли;
			
			Если (НЕ ОбщегоНазначенияУХ.ПринудительноеЗаполнениеПоля(НайденнаяСтрока))	
				И ЗначениеЗаполнено(НайденнаяСтрока.НастройкаСоответствия) 
				И НайденнаяСтрока.Строки.Количество()>0 Тогда
				
				ДобавитьСтрокиСоответствияРекурсивно(ИсточникОбъект,НайденнаяСтрока,ДеревоИсточник);
				
			КонецЕсли;
			
		КонецЦикла;
							
	Иначе
		
		Для Каждого ПодчиненнаяСтрока ИЗ СтрокаРеквизит.Строки Цикл
			
			МассивПутей=СтрРазделить(ПодчиненнаяСтрока.ТипЗначения[0].Значение,".");
			Если МассивПутей[0]=НастройкаСоответствияОбъект.ТипОбъектаКонсолидации
				И МассивПутей[1]=НастройкаСоответствияОбъект.ИмяОбъектаМетаданных Тогда
				
				ПодчиненнаяСтрока.НастройкаСоответствия=СтрокаРеквизит.НастройкаСоответствия;
				ДобавитьСтрокиСоответствияРекурсивно(ИсточникОбъект,ПодчиненнаяСтрока,ДеревоИсточник);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры // ДобавитьСтрокиСоответствияРекурсивно()

&НаСервере
Процедура ДобавитьПодчиненныеСтрокиСервер(Строка,ЭлементКоллекции)
	
	Для Каждого СтрокаКДобавлению ИЗ Строка.СтрокиКДобавлению Цикл
		
		НоваяСтрока=ЭлементКоллекции.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтрокиСервер(СтрокаКДобавлению,НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ДобавитьПодчиненныеСтроки

&НаКлиенте
Функция СоздатьСоединение()
	
	Попытка
		
		ADOX_Catalog = Новый COMОбъект("ADOX.Catalog");
		
		Возврат Истина;
		
	Исключение
		
		ПоказатьПредупреждение(, 
		НСтр("ru = 'На компьютере не поддерживается работа по технологии ADO.
		|После нажатия на кнопку ОК откроется страница для скачивания необходимых драйверов.
		|Пожалуйста, установите их, а потом попробуйте воспользоваться этой обработкой снова.'"));
		
		ФайловаяСистемаКлиент.ЗапуститьПрограмму(
			"http://www.microsoft.com/en-us/download/details.aspx?id=23734");
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ СоздатьСоединение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = УникальныйИдентификатор Тогда 
		
		Если ИмяСобытия = "ВыборОбъектовМетаданныхУХ" Тогда
			
			Если Параметр.Количество() Тогда
				ПриемникПолноеИмя = Параметр[0].Значение;
				ПриИзменениеПолногоИмениПриемника();
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия="ВыборПоляИзКонтекста" И ТипЗнч(Параметр)=Тип("Структура") Тогда

		СоответствиеСоздать(Параметр,Элементы.ДеревоПолейПриемник.ТекущиеДанные);
		
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура ДеревоПолейПриемникПередРазворачиванием(Элемент, Строка, Отказ)
	
	ПередРазворачиваниемСтрокиДереваПолейПриемника(Элемент, Строка, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередРазворачиваниемСтрокиДереваПолейПриемника(Элемент, Строка, Отказ)
	
	СтрокаРазворота=Элемент.ДанныеСтроки(Строка);
	
	Если (НЕ (СтрокаРазворота.ТипМетаДанных="Справочник" 
		ИЛИ СтрокаРазворота.ТипМетаДанных="Документ"
		ИЛИ СтрокаРазворота.ТипМетаДанных="ПланВидовХарактеристик"
		ИЛИ СтрокаРазворота.ТипМетаДанных="ТаблицаADO" 
		ИЛИ СтрокаРазворота.НаименованиеБД="Владелец"
		ИЛИ СтрокаРазворота.ТипЗначения.Количество()>1)) ИЛИ ЗначениеЗаполнено(СтрокаРазворота.СпособЗаполнения) Тогда
		
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	Если СтрокаРазворота.ПолучитьЭлементы().Количество()>0 И (НЕ ПустаяСтрока(СтрокаРазворота.ПолучитьЭлементы()[0].ПолеБД)) Тогда // Уже разворачивали эту строку
		Возврат;
	КонецЕсли;
		
	СтруктураСтрока=СформироватьСтруктуруСтрокиБД(СтрокаРазворота);
	ДанныеОбъекта=СформироватьДанныеОбъекта();
	
	ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока);
	
	Отказ=ДанныеОбъекта.Отказ;
	
	Если Отказ Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаРазворота.ПолучитьЭлементы().Очистить();
	РабочийОбъектАдрес=ДанныеОбъекта.РабочийОбъектАдрес;
	
	Для Каждого СтрокаКДобавлению ИЗ СтруктураСтрока.СтрокиКДобавлению Цикл
		
		НоваяСтрока=СтрокаРазворота.ПолучитьЭлементы().Добавить();
		НоваяСтрока.УровеньВложенности=СтрокаРазворота.УровеньВложенности+1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		НоваяСтрока.ИмяРеквизита=ПолучитьИмяРеквизита(НоваяСтрока.ПолеБД);
		НоваяСтрока.ВозможенПоиск=(НоваяСтрока.ТипЗначения.Количество()=1);
		
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтроки(СтрокаКДобавлению,НоваяСтрока);
			НоваяСтрока.Картинка=0;
			
		Иначе
			
			НоваяСтрока.Картинка=1;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры // ПередРазворачиваниемСтрокиДереваПолейИсточника()

&НаКлиенте
Процедура ДобавитьПодчиненныеСтроки(Строка,ЭлементКоллекции)
	
	Для Каждого СтрокаКДобавлению ИЗ Строка.СтрокиКДобавлению Цикл
		
		НоваяСтрока=ЭлементКоллекции.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаКДобавлению);
		НоваяСтрока.УровеньВложенности=ЭлементКоллекции.УровеньВложенности+1;
		
		Если СтрокаКДобавлению.СтрокиКДобавлению.Количество()>0 Тогда
			
			ДобавитьПодчиненныеСтроки(СтрокаКДобавлению,НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // ДобавитьПодчиненныеСтроки

&НаСервере
Процедура ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока) 
	
	РаботаСПолямиАналитикиУХ.ПередРазворачиваниемСтрокиРеквизитовАналитики(ДанныеОбъекта,СтруктураСтрока);
		
КонецПроцедуры // ПередРазворачиваниемСтрокиРеквизитовАналитики()

&НаКлиенте
Функция СформироватьСтруктуруСтрокиБД(ДанныеСтрокиАналитики)
	
	СтрокаБД=Новый Структура;
	СтрокаБД.Вставить("ИспользуетсяВСопоставлении",	ДанныеСтрокиАналитики.ИспользуетсяВСопоставлении);
			
	СтрокаБД.Вставить("НаименованиеБД",				ДанныеСтрокиАналитики.НаименованиеБД);
	СтрокаБД.Вставить("СправочникБД",				ДанныеСтрокиАналитики.СправочникБД);
		
	СтрокаБД.Вставить("ПолеБД",						ДанныеСтрокиАналитики.ПолеБД);
	СтрокаБД.Вставить("ТипЗначения",				ДанныеСтрокиАналитики.ТипЗначения);	
	СтрокаБД.Вставить("ТипДанныхПоля",				ДанныеСтрокиАналитики.ТипДанныхПоля);
	СтрокаБД.Вставить("ТипМетаДанных",				ДанныеСтрокиАналитики.ТипМетаДанных);
	СтрокаБД.Вставить("ВидАналитики",				ДанныеСтрокиАналитики.ВидАналитики);
	СтрокаБД.Вставить("ТаблицаADO",					ДанныеСтрокиАналитики.ТаблицаADO);
	СтрокаБД.Вставить("Измерение",					ДанныеСтрокиАналитики.Измерение);
	
	Возврат СтрокаБД;
	
КонецФункции // СформироватьСтруктуруСтрокиВИБ()

&НаСервере
Функция СформироватьДанныеОбъекта()
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("РабочийОбъектАдрес",		РабочийОбъектАдрес);
	ДанныеОбъекта.Вставить("УникальныйИдентификатор",	ЭтаФорма.УникальныйИдентификатор);
	ДанныеОбъекта.Вставить("ТипБД",						Справочники.ТипыБазДанных.ТекущаяИБ);
	ДанныеОбъекта.Вставить("ТипБДПриемник",				Справочники.ТипыБазДанных.ТекущаяИБ);
	ДанныеОбъекта.Вставить("ТекСоединениеВИБ",			);
	ДанныеОбъекта.Вставить("Отказ",						ЛОЖЬ);
	ДанныеОбъекта.Вставить("Использование77",			Ложь);
	ДанныеОбъекта.Вставить("ВнутренниеДанные",			Истина);
	ДанныеОбъекта.Вставить("СпособПолучения",			Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеДокументы);
	ДанныеОбъекта.Вставить("СпособИспользования",		Перечисления.СпособыИспользованияОперандов.ДляЗаполненияОбъектовБД);
	
	Возврат ДанныеОбъекта;
	
КонецФункции // СформироватьСтруктуруСтрокиВИБ()

&НаКлиенте
Процедура ДеревоПолейПриемникСпособЗаполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	ДанныеСтроки=Элементы.ДеревоПолейПриемник.ТекущиеДанные;
			
	Элементы.ДеревоПолейПриемникСпособЗаполнения.СписокВыбора.Очистить();
	
	Если ДанныеСтроки.ПолеБД="Ссылка" Тогда
		
		СтандартнаяОбработка=Ложь;
		Возврат;
		
	КонецЕсли;
	
	Если ДанныеСтроки.ТипМетаДанных="Простой" ИЛИ ДанныеСтроки.ТипМетаДанных="Перечисление" Тогда
		
		Элементы.ДеревоПолейПриемникСпособЗаполнения.СписокВыбора.ЗагрузитьЗначения(СпособыЗаполненияПростой.ВыгрузитьЗначения());
		
	Иначе
		
		Элементы.ДеревоПолейПриемникСпособЗаполнения.СписокВыбора.ЗагрузитьЗначения(СпособыЗаполненияСсылка.ВыгрузитьЗначения());
		
	КонецЕсли;		
					
КонецПроцедуры


&НаКлиенте
Процедура ДеревоПолейПриемникВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя="ДеревоПолейПриемникПолеИсточника" Тогда
		
		СтандартнаяОбработка=Ложь;
		ДанныеСтроки=Элементы.ДеревоПолейПриемник.ТекущиеДанные;

		Если ДанныеСтроки.СпособЗаполнения=ПредопределенноеЗначение("Перечисление.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки") Тогда
			
			ОткрытьФорму("ОбщаяФорма.ФормаВыбораПоляОбъекта",Новый Структура("ВидОтчета,ПотребительРасчета",,?(ЗначениеЗаполнено(ОбъектПриемникТЧ),ОбъектПриемникТЧ,ОбъектПриемник)));
			
		ИначеЕсли ДанныеСтроки.СпособЗаполнения=ПредопределенноеЗначение("Перечисление.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение") Тогда
			
			ОписаниеОповещенияПослеВводаФиксированногоЗначения = Новый ОписаниеОповещения("ПослеВводаФиксированногоЗначения",ЭтаФорма);
			ВыбранноеЗначение=ДанныеСтроки.ФиксированноеЗначение;
			
			ОписаниеТипов=Новый ОписаниеТипов(ДанныеСтроки.ТипДанныхПоля.ВыгрузитьЗначения());
			ПоказатьВводЗначения(ОписаниеОповещенияПослеВводаФиксированногоЗначения,ВыбранноеЗначение,,ОписаниеТипов);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаФиксированногоЗначения(ВыбранноеЗначение,Параметры) Экспорт
	
	Элементы.ДеревоПолейПриемник.ТекущиеДанные.ФиксированноеЗначение=ВыбранноеЗначение;
	ПредставлениеАналитики=Строка(ВыбранноеЗначение);
	Элементы.ДеревоПолейПриемник.ТекущиеДанные.ПолеИсточника=ПредставлениеАналитики;
	Элементы.ДеревоПолейПриемник.ТекущиеДанные.Сопоставлено=Истина;
	Элементы.ДеревоПолейПриемник.ТекущиеДанные.Поиск=Истина;	
	
	Элементы.ДеревоПолейПриемник.Свернуть(Элементы.ДеревоПолейПриемник.ТекущаяСтрока);
	
	Модифицированность=Истина;
		
КонецПроцедуры // ПослеВводаФиксированногоЗначения()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	СпособыЗаполненияПростой.Добавить(Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы);		
	СпособыЗаполненияПростой.Добавить(Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение);
	СпособыЗаполненияПростой.Добавить(Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки);
	
	СпособыЗаполненияСсылка.Добавить(Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение);
	СпособыЗаполненияСсылка.Добавить(Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПолейПриемникСпособЗаполненияПриИзменении(Элемент)
	
	СоответствиеУдалить();
	Элементы.ДеревоПолейПриемник.ЗакончитьРедактированиеСтроки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СоответствиеУдалить()
	
	ТекущиеДанные = Элементы.ДеревоПолейПриемник.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьУстановкуСоответствияБД(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУстановкуСоответствияБД(ТекущиеДанные)
	
	Модифицированность=Истина;
	
	ТекущиеДанные.ПолеИсточника="";
	ТекущиеДанные.ФиксированноеЗначение="";
	ТекущиеДанные.Сопоставлено=Ложь;
	
	СброситьФлагОбработкиРодителя(ТекущиеДанные);
		
КонецПроцедуры // ОтменитьУстановкуСоответствияБД()

&НаКлиенте
Процедура СоответствиеСоздать(СтрокаИсточника, СтрокаПриемника)
	
	Модифицированность = Истина;
	
	Если ТипЗнч(СтрокаИсточника)=Тип("Структура") И СтрокаИсточника.Свойство("КонтекстОтчета") Тогда
		
		Если НЕ ВозможнаУстановкаСоответствия(СтрокаПриемника,СтрокаИсточника) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Несовпадение типов.'"),30);
			Возврат;
		КонецЕсли;
		
		СтрокаПриемника.ПолеИсточника=СтрокаИсточника.ПолеБД;
		СтрокаПриемника.Сопоставлено=Истина;
		СтрокаПриемника.Поиск=Истина;
	
		Элементы.ДеревоПолейПриемник.Свернуть(СтрокаПриемника.ПолучитьИдентификатор());

	Иначе
		
		Если НЕ ВозможнаУстановкаСоответствия(СтрокаПриемника,СтрокаИсточника) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Несовпадение типов.'"),30);
			Возврат;
		КонецЕсли;	
		
		СтрокаПриемника.ПолеИсточника=СтрокаИсточника.Имя;
		СтрокаПриемника.СпособЗаполнения=ПредопределенноеЗначение("Перечисление.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы");
		СтрокаПриемника.Сопоставлено=Истина;
		СтрокаПриемника.Поиск=Истина;

		СтрокаИсточника.ПредставлениеСопоставления=?(СтрокаИсточника.ПредставлениеСопоставления="", СтрокаПриемника.ПолеБД, СтрокаИсточника.ПредставлениеСопоставления+", "+СтрокаПриемника.ПолеБД) ;
		
		СброситьФлагОбработкиРодителя(СтрокаПриемника);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьФлагОбработкиРодителя(СтрокаПриемника)
	
	СтрокаРодитель=СтрокаПриемника.ПолучитьРодителя();
	
	Если НЕ СтрокаРодитель=Неопределено Тогда
		
		СтрокаРодитель.ОбработкаЗавершена=Ложь;
		
		СброситьФлагОбработкиРодителя(СтрокаРодитель);
		
	КонецЕсли;	
	
КонецПроцедуры // СброситьФлагОбработкиРодителя() 

&НаКлиенте
Функция ВозможнаУстановкаСоответствия(СтрокаПриемника,СтрокаИсточника)
	
	Если СтрНайти(СтрокаПриемника.ТипЗначения[0].Значение,"Перечисление.")>0 
		И СтрокаИсточника.ТипЗначения[0].Значение=Тип("Строка") Тогда
		
		Возврат Истина;
		
	КонецЕсли;	
	
	Для Каждого СтрТип ИЗ СтрокаПриемника.ТипЗначения Цикл
		
		Если НЕ СтрокаИсточника.ТипЗначения.НайтиПоЗначению(СтрТип.Значение)=Неопределено Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
							
КонецФункции // ВозможнаУстановкаСоответствия()

&НаКлиенте
Процедура ДеревоПолейПриемникПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	
	ДанныеСтроки=ДеревоПолейПриемник.НайтиПоИдентификатору(Строка);
	
	Если ДанныеСтроки=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеСтроки.ТипМетаДанных="Простой" ИЛИ ДанныеСтроки.ТипМетаДанных="Перечисление" Тогда
		
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
				
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПолейПриемникОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПолейПриемникПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если Строка=Неопределено  Тогда
						
		Возврат;
					
	Иначе
		
		ДанныеПриемника=Элемент.ДанныеСтроки(Строка);
		
	КонецЕсли;
	
	СоответствиеСоздать(ПараметрыПеретаскивания.Значение, ДанныеПриемника);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникТаблицаФайлаПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИсточникТаблицаФайла = ВыбранноеЗначение;
	
	ИсточникСоединения.Очистить();
	ИсточникУсловие = "";
	ИсточникПервые1 = Ложь;
	
	ПриИзмененииТаблицыФайла();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьТаблицыИзСоединения()
	
	СтрокаСоединения=УправлениеСоединениямиВИБУХ.ПолучитьСтрокуСоединенияADO(ТипБД.ВИБПоУмолчанию,ИсточникИмяФайла);
	Справочники.ТаблицыADO.ПолучитьТаблицыИзСоединения(ТипБД,СтрокаСоединения,ИмяФайла,Ложь);
	
КонецПроцедуры // ПолучитьТаблицыИзСоединения()


&НаСервере
Процедура СоздатьИзменитьТипБД()
	
	Если НЕ ЗначениеЗаполнено(ТипБД) Тогда
		
		НовыйТипБДОбъект = Справочники.ТипыБазДанных.СоздатьЭлемент();
		НовыйТипБДОбъект.Наименование = СтрШаблон(Нстр("ru = 'Файл %1 от %2'"),ИмяФайла,Формат(ТекущаяДата(), "ДФ='yyyy.MM.dd HH:mm:ss'"));
		НовыйТипБДОбъект.ВерсияПлатформы = Перечисления.ПлатформыВнешнихИнформационныхБаз.ADO;
		НовыйТипБДОбъект.Записать();
		
		ТипБД = НовыйТипБДОбъект.Ссылка;
		
		НовыйВИБОбъект = Справочники.ВнешниеИнформационныеБазы.СоздатьЭлемент();
		НовыйВИБОбъект.Наименование = НовыйТипБДОбъект.Наименование;
		НовыйВИБОбъект.ТипБД = ТипБД;
		НовыйВИБОбъект.ТипХранилищаДанныхADO = Перечисления.ТипыХранилищДанныхADO.XLS;
		НовыйВИБОбъект.ИспользоватьДляИмпортаЭталонныйКаталог = Истина;
		НовыйВИБОбъект.ЭталонныйКаталог=ПутьКФайлу;
		НовыйВИБОбъект.Записать();
		
		НовыйТипБДОбъект.ВИБПоУмолчанию = НовыйВИБОбъект.Ссылка;
		НовыйТипБДОбъект.Записать();
		
	КонецЕсли;
	
	ПолучитьТаблицыИзСоединения();
	
КонецПроцедуры // СоздатьИзменитьТипБД()

&НаСервере
Процедура НайтиСоздатьПравилоЗаполнения(СтрокаНастройки)
	
	Если ЗначениеЗаполнено(СтрокаНастройки.ПравилоЗаполненияОбъекта) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОбъектБД=СтрокаНастройки.ОбъектПриемник;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаЗаполненияОбъектовБД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаЗаполненияОбъектовБД КАК ПравилаЗаполненияОбъектовБД
	|ГДЕ
	|	ПравилаЗаполненияОбъектовБД.Владелец = &Владелец
	|	И ПравилаЗаполненияОбъектовБД.ТипБД = &ТипБД";
	
	Запрос.УстановитьПараметр("Владелец",	ОбъектБД);
	Запрос.УстановитьПараметр("ТипБД",		ТипБД);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		СтрокаНастройки.ПравилоЗаполненияОбъекта=Результат.Ссылка;
		Возврат;
		
	КонецЕсли;
	
	СправочникПравило=Справочники.ПравилаЗаполненияОбъектовБД.СоздатьЭлемент();
	СправочникПравило.Владелец=ОбъектБД;
	СправочникПравило.ТипБД=ТипБД;
	СправочникПравило.Наименование=ТипБД.Наименование;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ТабличныеЧастиБД.Ссылка
	|ИЗ
	|	Справочник.ТабличныеЧастиБД КАК ТабличныеЧастиБД
	|ГДЕ
	|	ТабличныеЧастиБД.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец",ОбъектБД);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл	
		
		НоваяСтрока=СправочникПравило.ИсточникиДляЗаполненияТЧ.Добавить();
		НоваяСтрока.ТабличнаяЧасть=Результат.Ссылка;
		
	КонецЦикла;
		
	СправочникПравило.Записать();
	
	СтрокаНастройки.ПравилоЗаполненияОбъекта=СправочникПравило.Ссылка;
	
КонецПроцедуры // НайтиСоздатьПравилоЗаполнения() 

&НаСервере
Процедура ОбработатьИсточникДанных(СтрокаНастройки,ИсточникОбъект,СтрокиРеквизитов,ТабРеквизитыСинхронизации)
	
	МассивСопоставлено=СтрокиРеквизитов.Строки.НайтиСтроки(Новый Структура("Сопоставлено",Истина),Истина);
	
	ТаблицаСопоставлений=Новый ТаблицаЗначений;
	ТаблицаСопоставлений.Колонки.Добавить("СтрокаСопоставлено");
	ТаблицаСопоставлений.Колонки.Добавить("УровеньВложенности",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(5));
	
	Для Каждого Строка ИЗ МассивСопоставлено Цикл
		
		НоваяСтрока=ТаблицаСопоставлений.Добавить();
		НоваяСтрока.СтрокаСопоставлено=Строка;
		
		Если СтрНайти(Строка.ПолеБД,"Ссылка.")>0 Тогда
			
			НоваяСтрока.УровеньВложенности=Строка.УровеньВложенности-1;
			
		Иначе
			
			НоваяСтрока.УровеньВложенности=Строка.УровеньВложенности;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаСопоставлений.Сортировать("УровеньВложенности Убыв");
	
	Для Каждого Строка ИЗ ТаблицаСопоставлений Цикл
		
		Если Строка.УровеньВложенности=0 Тогда
			
			Если Строка.СтрокаСопоставлено.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы
				И СтрНайти(Строка.СтрокаСопоставлено.ТипЗначения[0].Значение,"Перечисление.")>0 Тогда
				
				ЗаполнитьНастройкуСоответствия(СтрокаНастройки.ИмяТаблицы,Строка.СтрокаСопоставлено);
				
			КонецЕсли;
			
		Иначе
			
			ПолучитьНастройкиСоответствияРекурсивно(СтрокаНастройки.ИмяТаблицы,Строка.СтрокаСопоставлено.Родитель);
			
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСопоставленоСтар=ИсточникОбъект.ТаблицаСоответствияБД.НайтиСтроки(Новый Структура("Сопоставлено,АналитикаОтчета",Истина,Ложь));
	
	Для Каждого СтрокаСопоставлено ИЗ МассивСопоставленоСтар Цикл
		
		СтрокаСопоставлено.ПолеБД              	 	= Неопределено;
		СтрокаСопоставлено.ПсевдонимБД               = Неопределено;
		СтрокаСопоставлено.Сопоставлено              = Ложь;
		СтрокаСопоставлено.СправочникБД              = "";
		СтрокаСопоставлено.ПолеЗапроса               = "";
		СтрокаСопоставлено.ТипМетаДанных             = "";
		СтрокаСопоставлено.НастройкаСоответствия		= "";
		СтрокаСопоставлено.ФиксированноеЗначение		= "";
		
	КонецЦикла;
	
	ОбновитьПоляСинхронизацииПравила=(ТабРеквизитыСинхронизации=Неопределено);
	
	Если ОбновитьПоляСинхронизацииПравила Тогда
		
		ТабРеквизитыСинхронизации=ИсточникОбъект.ТаблицаСоответствияБД.СкопироватьКолонки();
		ПравилоОбъект=СтрокаНастройки.ПравилоЗаполненияОбъекта.ПолучитьОбъект();
		ПравилоОбъект.РеквизитыШапкиДляСинхронизацииТЧ.Очистить();
		
	КонецЕсли;
	
	Если НЕ ОбновитьПоляСинхронизацииПравила Тогда
		
		Для Каждого СтрокаСинхронизации ИЗ ТабРеквизитыСинхронизации Цикл
			
			СтрокаСоответствия=ИсточникОбъект.ТаблицаСоответствияБД.Найти(СтрокаСинхронизации.АналитикаКонсолидации,"АналитикаКонсолидации");
			
			Если СтрокаСоответствия=Неопределено Тогда
				
				СтрокаСоответствия=ИсточникОбъект.ТаблицаСоответствияБД.Добавить();
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаСоответствия,СтрокаСинхронизации);
			
		КонецЦикла;
		
	КонецЕсли;
		
	МассивСопоставлено=СтрокиРеквизитов.Строки.НайтиСтроки(Новый Структура("Сопоставлено",Истина));
	
	Для Каждого Строка ИЗ МассивСопоставлено Цикл
		
		СтрокаСоответствия=ИсточникОбъект.ТаблицаСоответствияБД.Найти(СтрЗаменить(Строка.ПолеБД,"Ссылка.",""),"АналитикаКонсолидации");
		ЗаполнитьЗначенияСвойств(СтрокаСоответствия,Строка,,"ПолеБД");
		
		Если Строка.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
			
			Если ЗначениеЗаполнено(Строка.НастройкаСоответствия) Тогда
				
				СтрокаСоответствия.ПолеБД="";
				
			Иначе
				
				СтрокаСоответствия.ПолеБД=Строка.ПолеИсточника;
				
			КонецЕсли;
			
		Иначе
			
			СтрокаСоответствия.ПолеБД=Строка.ПолеИсточника;
			
		КонецЕсли;
			
		СтрокаСоответствия.СправочникБД="({["+ИсточникОбъект.ТаблицаADO.Имя+"]})";
		
		Если ОбновитьПоляСинхронизацииПравила И Строка.Поиск Тогда
			
			НоваяСтрока=ТабРеквизитыСинхронизации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаСоответствия);
			
			НоваяСтрокаСинхронизации=ПравилоОбъект.РеквизитыШапкиДляСинхронизацииТЧ.Добавить();
			НоваяСтрокаСинхронизации.Имя=СтрЗаменить(Строка.ПолеБД,"Ссылка.","");
			НоваяСтрокаСинхронизации.Синоним=Строка.НаименованиеБД;
			НоваяСтрокаСинхронизации.ТипДанных=ОбщегоНазначенияУХ.ПолучитьСтрокуИзСпискаЗначений(Строка.ТипЗначения);
				
		КонецЕсли;
		
	КонецЦикла;
	
	ИсточникОбъект.мМодифицированность=Истина;
	ИсточникОбъект.СохранитьНастройкиОперанда();
	ИсточникОбъект.Записать();
	
	Если ОбновитьПоляСинхронизацииПравила Тогда
		
		ПравилоОбъект.Записать();
		
	КонецЕсли;
					
КонецПроцедуры // ОбработатьИсточникДанных() 

&НаСервере
Процедура ОбработатьИсточникиДанныхПоНастройке(СтрокаНастройки)
	
	НайтиСоздатьПравилоЗаполнения(СтрокаНастройки);
	ДеревоНастроек=СтрокаНастройки.НастройкаЗаполнения.Получить();
	
	ТабРеквизитыСинхронизации=Неопределено;

	Если ЗначениеЗаполнено(СтрокаНастройки.ОбъектПриемникТЧ) Тогда
		
		СтрокаШапка=ДеревоНастроек.Строки.Найти("Ссылка","ПолеБД");
	    ИсточникОбъект=ПолучитьИсточникДляЗаполненияШапки(СтрокаНастройки);
		ОбработатьИсточникДанных(СтрокаНастройки,ИсточникОбъект,СтрокаШапка,ТабРеквизитыСинхронизации);
		
		ИсточникОбъектТЧ=ПолучитьИсточникДляЗаполненияТЧ(СтрокаНастройки);
		ОбработатьИсточникДанных(СтрокаНастройки,ИсточникОбъектТЧ,ДеревоНастроек,ТабРеквизитыСинхронизации);
		
	Иначе
		
		ИсточникОбъект=ПолучитьИсточникДляЗаполненияШапки(СтрокаНастройки);
		ОбработатьИсточникДанных(СтрокаНастройки,ИсточникОбъект,ДеревоНастроек,ТабРеквизитыСинхронизации);
	
	КонецЕсли;
	
	СтрокаНастройки.НастройкаЗаполнения=Новый ХранилищеЗначения(ДеревоНастроек);
			
КонецПроцедуры // СоздатьИсточникДанныхДляОбъекта()

&НаСервере
Процедура ПолучитьНастройкиСоответствияРекурсивно(ИмяТаблицы,СтрокаСопоставлено)
	
	Если СтрокаСопоставлено.ПолеБД="Ссылка" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если СтрокаСопоставлено.ТипЗначения.Количество()=1 Тогда 
		
		ЗаполнитьНастройкуСоответствия(ИмяТаблицы,СтрокаСопоставлено);
		
	Иначе
		
		Для Каждого Строка ИЗ СтрокаСопоставлено.Строки Цикл
			
			Если ЗначениеЗаполнено(Строка.НастройкаСоответствия) Тогда
				
				СтрокаСопоставлено.НастройкаСоответствия=Строка.НастройкаСоответствия;
				СтрокаСопоставлено.Сопоставлено=Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ СтрокаСопоставлено.Родитель=Неопределено Тогда
		
		ПолучитьНастройкиСоответствияРекурсивно(ИмяТаблицы,СтрокаСопоставлено.Родитель);
		
	КонецЕсли;
		
КонецПроцедуры // ПолучитьНастройкиСоответствияРекурсивно() 
 

&НаСервере
Процедура ЗаполнитьНастройкуСоответствия(ИмяТаблицы,СтрокаСопоставлено)
	
	Если ЗначениеЗаполнено(СтрокаСопоставлено.НастройкаСоответствия) Тогда
		
		Если СтрокаСопоставлено.ОбработкаЗавершена Тогда
			
			Возврат;
			
		Иначе
			
			НастройкаСоответствияОбъект=СтрокаСопоставлено.НастройкаСоответствия.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НастройкаСоответствияОбъект=Неопределено Тогда
		
		МассивПутей=СтрРазделить(СтрокаСопоставлено.ТипЗначения[0].Значение,".");
		ТипОбъектаКонсолидации=МассивПутей[0];
		ИмяОбъектаМетаданных=МассивПутей[1];
		
		СтрНастройки=ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИмяТаблицы,ТипОбъектаКонсолидации,ИмяОбъектаМетаданных",ИмяТаблицы,ТипОбъектаКонсолидации,ИмяОбъектаМетаданных));
		
		Если СтрНастройки.Количество()>0 Тогда
			
			НастройкаСоответствияОбъект=СтрНастройки[0].НастройкаСоответствия.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НастройкаСоответствияОбъект=Неопределено Тогда
		
		ОписаниеОбъектаВИБ=ПолучитьТаблицуADO(ИмяТаблицы);
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	СоответствиеВнешнимИБ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
		|ГДЕ
		|	СоответствиеВнешнимИБ.Владелец = &Владелец
		|	И СоответствиеВнешнимИБ.ИмяОбъектаМетаданных = &ИмяОбъектаМетаданных
		|	И СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ = &ОписаниеОбъектаВИБ
		|	И СоответствиеВнешнимИБ.ТипОбъектаКонсолидации = &ТипОбъектаКонсолидации";
		
		Запрос.УстановитьПараметр("Владелец",ТипБД);
		Запрос.УстановитьПараметр("ОписаниеОбъектаВИБ",ОписаниеОбъектаВИБ);
		Запрос.УстановитьПараметр("ТипОбъектаКонсолидации",ТипОбъектаКонсолидации);
		Запрос.УстановитьПараметр("ИмяОбъектаМетаданных",ИмяОбъектаМетаданных);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			НастройкаСоответствияОбъект=Результат.Ссылка.ПолучитьОбъект();
			
		Иначе
			
			НастройкаСоответствияОбъект = Справочники.СоответствиеВнешнимИБ.СоздатьЭлемент();
			НастройкаСоответствияОбъект.Владелец				= ТипБД;
			НастройкаСоответствияОбъект.ТипОбъектаВИБ			= "ТаблицаADO";
			НастройкаСоответствияОбъект.ОписаниеОбъектаВИБ		= ОписаниеОбъектаВИБ;
			НастройкаСоответствияОбъект.ТипОбъектаКонсолидации	= ТипОбъектаКонсолидации;
			НастройкаСоответствияОбъект.ИмяОбъектаМетаданных	= ИмяОбъектаМетаданных;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкаСоответствияОбъект.ЗаполнитьРеквизитыОбъектаВИБ();
	НастройкаСоответствияОбъект.ЗаполнитьСписокПолей();
	НастройкаСоответствияОбъект.СформироватьТаблицуСоответствияБД();
	НастройкаСоответствияОбъект.мТабличноеПолеИзмеренийБД = НастройкаСоответствияОбъект.ЗаполнитьДеревоПоОбъектуВИБ();
	
	Для Каждого Строка Из НастройкаСоответствияОбъект.мТаблицаСоответствия.Строки.НайтиСтроки(Новый Структура("Сопоставлено", Истина), Истина) Цикл
		Строка.Сопоставлено = Ложь;
		Строка.АналитикаБД = Неопределено;
		Строка.ПсевдонимБД = Неопределено;
		Строка.СправочникБД = "";
		Строка.ПолеЗапроса = "";
		Строка.ТипМетаДанных = "";
		Строка.НастройкаСоответствия = "";
	КонецЦикла;
	
	Если НастройкаСоответствияОбъект.ТипОбъектаКонсолидации="Перечисление" Тогда 
		
		СтрокаСоответствия=НастройкаСоответствияОбъект.мТаблицаСоответствия.Строки.НайтиСтроки(Новый Структура("АналитикаКонсолидации","Наименование"),Истина)[0];
		СтрокаСоответствия.АналитикаБД=СтрокаСопоставлено.ПолеИсточника;
		СтрокаСоответствия.Ключевой=Истина;
		СтрокаСоответствия.НеИспользоватьДляСинхронизации=Ложь;
		СтрокаСоответствия.ПримитивныйТип=Истина;
		СтрокаСоответствия.ПсевдонимБД=ОчиститьПолеИсточникаСкобки(СтрокаСопоставлено.ПолеИсточника);
	    СтрокаСоответствия.Сопоставлено=Истина;
		СтрокаСоответствия.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы;
		СтрокаСоответствия.ТипМетаДанных="Простой";
		
	Иначе
		
		Для Каждого СтрокаРеквизит ИЗ СтрокаСопоставлено.Строки Цикл
			
			Если НЕ СтрокаРеквизит.Сопоставлено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			СтрокаСоответствия=НастройкаСоответствияОбъект.мТаблицаСоответствия.Строки.НайтиСтроки(Новый Структура("АналитикаКонсолидации",ПолучитьИмяРеквизита(СтрокаРеквизит.ПолеБД)),Истина)[0];
			СтрокаСоответствия.АналитикаБД=СтрокаРеквизит.ПолеИсточника;
			СтрокаСоответствия.ПсевдонимБД=ОчиститьПолеИсточникаСкобки(СтрокаСопоставлено.ПолеИсточника);
		    СтрокаСоответствия.Ключевой=СтрокаРеквизит.Поиск;
			СтрокаСоответствия.НеИспользоватьДляСинхронизации=НЕ СтрокаРеквизит.Поиск;
			СтрокаСоответствия.СпособЗаполнения=СтрокаРеквизит.СпособЗаполнения;
			СтрокаСоответствия.ФиксированноеЗначение=СтрокаРеквизит.ФиксированноеЗначение;
			СтрокаСоответствия.НастройкаСоответствия=СтрокаРеквизит.НастройкаСоответствия;
			СтрокаСоответствия.Сопоставлено=Истина;
			СтрокаСоответствия.ТипМетаДанных="Простой";
			
		КонецЦикла;
		
	КонецЕсли;
	
	НастройкаСоответствияОбъект.СохранитьНастройкиОперанда();
	НастройкаСоответствияОбъект.Записать();
	
	НоваяСтрока=ТаблицаСоответствий.Добавить();
	НоваяСтрока.ТипОбъектаКонсолидации=ТипОбъектаКонсолидации;
	НоваяСтрока.ИмяОбъектаМетаданных=ИмяОбъектаМетаданных;
	НоваяСтрока.ИмяТаблицы=ИмяТаблицы;
	НоваяСтрока.ОписаниеОбъектаВИБ=ОписаниеОбъектаВИБ;
	НоваяСтрока.НастройкаСоответствия=НастройкаСоответствияОбъект.Ссылка;
	
	СтрокаСопоставлено.НастройкаСоответствия=НастройкаСоответствияОбъект.Ссылка;
	СтрокаСопоставлено.Сопоставлено=Истина;
	
КонецПроцедуры // ЗаполнитьНастройкуСоответствия()

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяРеквизита(ПолеБД)
	
	МассивПуть=СтрРазделить(ПолеБД,".");
	Возврат МассивПуть[МассивПуть.Количество()-1]; 
	
КонецФункции // ПолучитьИмяРеквизита() 

&НаСервере
Функция ОчиститьПолеИсточникаСкобки(ПолеИсточника)
	
	Возврат СтрЗаменить(СтрЗаменить(ПолеИсточника,"[",""),"]","");
		
КонецФункции // ОчиститьПолеИсточникаСкобки() 	

&НаСервере
Функция ПолучитьТаблицуADO(ИмяТаблицы)
	
	МассивПоиска=ТаблицыADO.НайтиСтроки(Новый Структура("ИмяТаблицы",ИмяТаблицы));
	
	Если МассивПоиска.Количество()>0 Тогда
		
		Возврат МассивПоиска[0].ТаблицаADO;
		
	КонецЕсли;
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ТаблицыADO.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТаблицыADO КАК ТаблицыADO
	|ГДЕ
	|	ТаблицыADO.Владелец = &Владелец
	|	И ТаблицыADO.Имя = &Имя";
	
	Запрос.УстановитьПараметр("Владелец",ТипБД);
	Запрос.УстановитьПараметр("Имя",ИмяТаблицы);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Результат.Следующий();
	
	НоваяСтрока=ТаблицыADO.Добавить();
	НоваяСтрока.ИмяТаблицы=ИмяТаблицы;
	НоваяСтрока.ТаблицаADO=Результат.Ссылка;
	
	Возврат Результат.Ссылка;	
	
КонецФункции // ПолучитьТаблицуADO()

&НаСервере
Процедура ОбработатьИсточникДляШапки(Строки,СтрокаНастройки)
	
	
	
КонецПроцедуры // ОбработатьИсточникДляШапки(Строки) 

&НаСервере
Функция ПолучитьИсточникОбъект(СтрокаНастройки)
	
	Если ЗначениеЗаполнено(СтрокаНастройки.ОбъектПриемникТЧ) Тогда
		
		Возврат ПолучитьИсточникДляЗаполненияТЧ(СтрокаНастройки);
		
	Иначе
		
		Возврат ПолучитьИсточникДляЗаполненияШапки(СтрокаНастройки);
		
	КонецЕсли;
	
КонецФункции // ПолучитьИсточникОбъект()

&НаСервере
Функция ПолучитьИсточникДляЗаполненияШапки(СтрокаНастройки)
	
	Если ЗначениеЗаполнено(СтрокаНастройки.ИсточникШапка) Тогда
		
		ИсточникОбъект=СтрокаНастройки.ИсточникШапка.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		Возврат ИсточникОбъект;
		
	КонецЕсли;	
	
	// Поиск по реквизитам источника
	
	ИсточникДанных=ПолучитьИсточникПоРеквизитам(СтрокаНастройки,СтрокаНастройки.ОбъектПриемник);
	
	Если НЕ ИсточникДанных=Неопределено Тогда
					
		УстановитьИсточникДляЗаполненияШапки(ИсточникДанных,СтрокаНастройки);
				
		ИсточникОбъект=ИсточникДанных.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		Возврат ИсточникОбъект;
		
	КонецЕсли;
	
	ИсточникОбъект=СоздатьИсточникДляНастройки(СтрокаНастройки,СтрокаНастройки.ОбъектПриемник);
	УстановитьИсточникДляЗаполненияШапки(ИсточникОбъект.Ссылка,СтрокаНастройки);
	Возврат ИсточникОбъект;
	
КонецФункции // ПолучитьИсточникДляЗаполненияШапки()

&НаСервере
Процедура УстановитьИсточникДляЗаполненияШапки(ИсточникДанных,СтрокаНастройки)
	
	ПравилоОбъект=СтрокаНастройки.ПравилоЗаполненияОбъекта.ПолучитьОбъект();
	ПравилоОбъект.ИсточникДляЗаполненияШапки=ИсточникДанных;
	ПравилоОбъект.Записать();
	
	СтрокаНастройки.ИсточникШапка=ИсточникДанных;
	
КонецПроцедуры // УстановитьИсточникДляЗаполненияШапки() 

&НаСервере
Функция ПолучитьИсточникДляЗаполненияТЧ(СтрокаНастройки)
	
	Если ЗначениеЗаполнено(СтрокаНастройки.ИсточникТЧ) Тогда
		
		ИсточникОбъект=СтрокаНастройки.ИсточникТЧ.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		Возврат ИсточникОбъект;
		
	КонецЕсли;
	
	// Поиск по реквизитам источника
	
	ИсточникДанных=ПолучитьИсточникПоРеквизитам(СтрокаНастройки,СтрокаНастройки.ОбъектПриемникТЧ);
	
	Если НЕ ИсточникДанных=Неопределено Тогда
					
		УстановитьИсточникДляЗаполненияТЧ(ИсточникДанных,СтрокаНастройки);
				
		ИсточникОбъект=ИсточникДанных.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		Возврат ИсточникОбъект;
		
	КонецЕсли; 
	
	ИсточникОбъект=СоздатьИсточникДляНастройки(СтрокаНастройки,СтрокаНастройки.ОбъектПриемникТЧ);
	УстановитьИсточникДляЗаполненияТЧ(ИсточникОбъект.Ссылка,СтрокаНастройки);
	Возврат ИсточникОбъект;
	
КонецФункции // ПолучитьИсточникДляЗаполненияТЧ()

&НаСервере
Функция ПолучитьИсточникПоРеквизитам(СтрокаНастройки,ПотребительРасчета)
	
	Запрос=Новый Запрос;
	
	Запрос.Текст="ВЫБРАТЬ
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК ИсточникДанных
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	ИсточникиДанныхДляРасчетов.НазначениеРасчетов = &НазначениеРасчетов
	|	И ИсточникиДанныхДляРасчетов.ПотребительРасчета = &ПотребительРасчета
	|	И ИсточникиДанныхДляРасчетов.ТаблицаADO = &ТаблицаADO
	|	И НЕ ИсточникиДанныхДляРасчетов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НазначениеРасчетов",СтрокаНастройки.ПравилоЗаполненияОбъекта);
	Запрос.УстановитьПараметр("ПотребительРасчета",ПотребительРасчета);
	Запрос.УстановитьПараметр("ТаблицаADO",ПолучитьТаблицуADO(СтрокаНастройки.ИмяТаблицы));
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат Результат.ИсточникДанных
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
					
КонецФункции // ПолучитьИсточникПоРеквизитам()

&НаСервере
Функция СоздатьИсточникДляНастройки(СтрокаНастройки,ПотребительРасчета)
	
	СправочникОбъект=Справочники.ИсточникиДанныхДляРасчетов.СоздатьЭлемент();
	СправочникОбъект.НазначениеРасчетов=СтрокаНастройки.ПравилоЗаполненияОбъекта;
	СправочникОбъект.ПотребительРасчета=ПотребительРасчета;

	СправочникОбъект.ТипБДПриемник=Справочники.ТипыБазДанных.ТекущаяИБ;
	СправочникОбъект.ТипБД=ТипБД;
	СправочникОбъект.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеADO;
	СправочникОбъект.ТаблицаADO=ПолучитьТаблицуADO(СтрокаНастройки.ИмяТаблицы);
	
	СправочникОбъект.СпособИспользования=Перечисления.СпособыИспользованияОперандов.ДляЗаполненияОбъектовБД;
	СправочникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
	СправочникОбъект.мМодифицированность=Истина;
	СправочникОбъект.СохранитьНастройкиОперанда();
			
	СправочникОбъект.Записать();
	Возврат СправочникОбъект;
	
КонецФункции // СоздатьИсточникДляНастройки()

&НаСервере
Процедура УстановитьИсточникДляЗаполненияТЧ(ИсточникДанных,СтрокаНастройки)
	
	ПравилоОбъект=СтрокаНастройки.ПравилоЗаполненияОбъекта.ПолучитьОбъект();
	СтрокаТЧ=ПравилоОбъект.ИсточникиДляЗаполненияТЧ.Найти(СтрокаНастройки.ОбъектПриемникТЧ,"ТабличнаяЧасть");
	
	Если СтрокаТЧ=Неопределено Тогда
		
		СтрокаТЧ=ПравилоОбъект.ИсточникиДляЗаполненияТЧ.Добавить();
		СтрокаТЧ.ТабличнаяЧасть=СтрокаНастройки.ОбъектПриемникТЧ;
		
	КонецЕсли;	
	
	СтрокаТЧ.ИсточникДанных=ИсточникДанных;
	СтрокаТЧ.Используется=Истина;
	ПравилоОбъект.ОбменДанными.Загрузка=Истина;
	ПравилоОбъект.Записать();
	
	СтрокаНастройки.ИсточникТЧ=ИсточникДанных;
		
КонецПроцедуры // УстановитьИсточникДляЗаполненияТЧ() 
	
&НаСервере
Процедура СоздатьИсточникиДанныхДляЗаполнения()
	
	МассивОбъектов=Новый Массив;
	
	Для Каждого Строка ИЗ НастройкиЗаполнения Цикл
		
		ОбработатьИсточникиДанныхПоНастройке(Строка);
		
		Если ЗначениеЗаполнено(Строка.ПравилоЗаполненияОбъекта)
			И ЗначениеЗаполнено(Строка.ОбъектПриемник)
			И МассивОбъектов.Найти(Строка.ПравилоЗаполненияОбъекта)=Неопределено Тогда
				
			МассивОбъектов.Добавить(Строка.ПравилоЗаполненияОбъекта);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ОбъектОбработки ИЗ МассивОбъектов Цикл
		
		НаборЗаписей=РегистрыСведений.ИменаФайловИКаталогов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(ОбъектОбработки);
		
		НоваяСтрока=НаборЗаписей.Добавить();
		НоваяСтрока.Объект=ОбъектОбработки;
		НоваяСтрока.ТипОбъекта = Перечисления.ТипыОбъектов.ДокументПараллельногоУчета;
		НоваяСтрока.Имя=ИмяБезРасширения;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;	
		
КонецПроцедуры // СоздатьИсточникиДанныхДляЗаполнения()

&НаСервере
Процедура СохранитьПравилаНаСервере()
	
	СохранитьТекущиеНастройки();
	СоздатьИзменитьТипБД();
	СоздатьИсточникиДанныхДляЗаполнения();
	
	СтрНастройки=НастройкиЗаполнения.НайтиСтроки(Новый Структура("ИмяТаблицы,ОбъектПриемник,ОбъектПриемникТЧ",ИсточникТаблицаФайла,ОбъектПриемник,ОбъектПриемникТЧ));	
	ЗначениеВРеквизитФормы(СтрНастройки[0].НастройкаЗаполнения.Получить(),"ДеревоПолейПриемник");
	
	РабочийОбъектАдрес=СтрНастройки[0].РабочийОбъектАдрес;
	ПравилоЗаполненияОбъекта=СтрНастройки[0].ПравилоЗаполненияОбъекта;
	ИсточникШапка=СтрНастройки[0].ИсточникШапка;
	ИсточникТЧ=СтрНастройки[0].ИсточникТЧ;
	
	Модифицированность=Ложь;
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПравила(Команда)
	
	СохранитьПравилаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	
	СтрокаИсточника=Элементы.ПоляИсточника.ТекущиеДанные;
	СтрокаПриемника=Элементы.ДеревоПолейПриемник.ТекущиеДанные;
	
	Если СтрокаИсточника=Неопределено
		ИЛИ СтрокаПриемника=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ (СтрокаПриемника.ТипМетаДанных="Простой" 
		ИЛИ СтрокаПриемника.ТипМетаДанных="Перечисление") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СоответствиеСоздать(СтрокаИсточника,СтрокаПриемника)
		
КонецПроцедуры

&НаКлиенте
Процедура Разъединить(Команда)
	
	СтрокаИсточника=Элементы.ПоляИсточника.ТекущиеДанные;
	СтрокаПриемника=Элементы.ДеревоПолейПриемник.ТекущиеДанные;
	
	Если СтрокаПриемника=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если СтрокаПриемника.СпособЗаполнения=ПредопределенноеЗначение("Перечисление.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы") 
		И (НЕ СтрокаИсточника=Неопределено)   Тогда
		
		СтрокаИсточника.ПредставлениеСопоставления=СтрЗаменить(СтрокаИсточника.ПредставлениеСопоставления,СтрокаПриемника.ПолеБД,"");
		
	КонецЕсли;
	
	СоответствиеУдалить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилоЗаполненияОбъектаПриИзменении(Элемент)
	
	ПриИзмененииПравилаЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипБДПриИзменении(Элемент)
	
	ОпределитьПравилоЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		
		Отказ=Истина;
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить настройки?'");
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("СохранениеНастроекПередЗакрытием", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗакрытии, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастроекПередЗакрытием(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		
		СохранитьПравилаНаСервере();
		Закрыть();
		
	Иначе
		
		Модифицированность=Ложь;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры


		

