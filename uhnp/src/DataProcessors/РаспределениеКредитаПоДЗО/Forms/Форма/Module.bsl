
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КредитПриИзменении(Элемент)
	ПриИзмененииДоговораНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриИзмененииДоговораНаСервере()
	
	Объект.ВерсияКредит = РаботаСДоговорамиКонтрагентовУХ.ДействующаяВерсияСоглашения(Объект.Кредит);
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВерсияКредит, 
							Новый Структура("СуммаКредита,ВалютаКредита", "Сумма", "ВалютаВзаиморасчетов"));
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыДоговора);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаймыНаСервере()
	
	Если Объект.ПолучателиЗаймов.Итог("СуммаЗайма") > Объект.СуммаКредита Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Сумма к выдаче превышает сумму кредита'"));
		Возврат;
	КонецЕсли;
	
	КонтрагентОрганизации = РаботаСКонтрагентамиУХ.КонтрагентОрганизации(Объект.Организация);
	Если НЕ ЗначениеЗаполнено(КонтрагентОрганизации) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'У выбранной организации нет сопоставленного контрагента'"));
		Возврат;
	КонецЕсли;

	Для Каждого ТекСтрока Из Объект.ПолучателиЗаймов Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрока.Получатель) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("Дата", 					ТекущаяДатаСеанса());
		СтруктураЗаполнения.Вставить("ДатаНачалаДействия", 		ТекСтрока.ДатаВыдачи);
		СтруктураЗаполнения.Вставить("ДатаОкончанияДействия", 	ТекСтрока.ДатаВозврата);
		СтруктураЗаполнения.Вставить("Сумма", 					ТекСтрока.СуммаЗайма);
		СтруктураЗаполнения.Вставить("Организация", 			ТекСтрока.Получатель);
		СтруктураЗаполнения.Вставить("Контрагент", 				КонтрагентОрганизации);
		
		ДокЗаем = Объект.Кредит.ВерсияСоглашения.Скопировать();
		ДокЗаем.ДополнительныеСвойства.Вставить("НеОбновлятьФакт", Истина); 
		ДокЗаем.АвтоматическиеВычисления = Истина;  
		ДокЗаем.БазовыйДоговор           = Неопределено;  
		ДокЗаем.ЭтоКредитнаяЛиния		 = Ложь;
		ДокЗаем.ВидСоглашения			 = Перечисления.ВидыСоглашений.ДоговорСУсловием;
		ЗаполнитьЗначенияСвойств(ДокЗаем, СтруктураЗаполнения);  
		ДокЗаем.ДокументОснование = Неопределено;  
		Если ЗначениеЗаполнено(Объект.ПроцентнаяСтавка) Тогда
			ДокЗаем.ПроцентнаяСтавка = 	Объект.ПроцентнаяСтавка;				
		КонецЕсли;
		ОписаниеГрафика = Документы.ВерсияСоглашенияКредит.ОписаниеГрафика(ДокЗаем.ВидДоговораУХ);
		ОперацииГрафика = РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, ДокЗаем);
    	ФинансовыеИнструментыУХ.ОбновитьОсновнойДолгПоДаннымОбъекта(ДокЗаем, ОписаниеГрафика, , , ОперацииГрафика);  
		
		СтруктураДействий = Новый Структура;
		Секции = Новый Массив;
		Секции.Добавить("Проценты");
		
		СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));
		
		СтруктураДействий.Вставить("Замкнуть", Новый Структура("СекцииГрафика", 
								ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ОсновнойДолг")));
		
		ФинансовыеИнструментыУХ.ПересчетГрафика(ДокЗаем,
		0,
		ОписаниеГрафика,
		ОперацииГрафика,
		СтруктураДействий);
   	
		ДокЗаем.Записать(РежимЗаписиДокумента.Проведение); 
		ТекСтрока.ДоговорЗайма  =  ДокЗаем.ДоговорКонтрагента;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаймы(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		СформироватьЗаймыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка,
	|	Заявки.Заявка КАК Заявка,
	|	Заявки.Заявка.Организация КАК Получатель,
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Заявки.Заявка.СуммаЗаимствования КАК СуммаЗайма,
	|	Заявки.Заявка.ДатаПривлечения КАК ДатаВыдачи,
	|	Заявки.Заявка.ДатаВозврата КАК ДатаВозврата,
	|	ВерсияСоглашенияКредит.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	Документ.ПокрытиеПотребностиВФинансировании.ЗаявкиНаПривлечениеФинансирования КАК Заявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Заявки.Заявка.Организация = Контрагенты.ОрганизационнаяЕдиница
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВерсияСоглашенияКредит КАК ВерсияСоглашенияКредит
	|		ПО (ВерсияСоглашенияКредит.ДокументОснование = Заявки.Ссылка)
	|			И (ВерсияСоглашенияКредит.ДоговорКонтрагента = &Договор)";
	
	Запрос.УстановитьПараметр("Договор", Объект.Кредит);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Объект.ПолучателиЗаймов.Загрузить(РезультатЗапроса.Выгрузить());

КонецПроцедуры

#КонецОбласти
