#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьОбъектыРасчетов(Параметры.Организация, Параметры.Контрагент, Параметры.ДоговорКонтрагента, Параметры.ВалютаДокумента, Параметры.ЭтоДоход);
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметкиОбъектыРасчетов(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОтметкиОбъектыРасчетов(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	АдресОбъектовРасчетовВХранилище = ПоместитьОбъектыРасчетовВХранилище();
	Результат = Новый Структура("АдресОбъектовРасчетовВХранилище", АдресОбъектовРасчетовВХранилище);
	Закрыть(Результат);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ЗаполнитьОбъектыРасчетов(Организация, Контрагент, ДоговорКонтрагента, Валюта, ЭтоДоход)

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	ИСТИНА КАК Пометка,
		|	РасчетыСКонтрагентамиФактОстатки.Организация КАК Организация,
		|	РасчетыСКонтрагентамиФактОстатки.СуммаОстаток КАК Сумма,
		|	РасчетыСКонтрагентамиФактОстатки.Контрагент КАК Контрагент,
		|	РасчетыСКонтрагентамиФактОстатки.ДоговорКонтрагента КАК Договор,
		|	РасчетыСКонтрагентамиФактОстатки.ЭлементСтруктурыЗадолженности КАК ЭлементСтруктурыЗадолженности,
		|	РасчетыСКонтрагентамиФактОстатки.Валюта КАК ВалютаВзаиморасчетов,
		// УХ_Встраивание ++
		//|	РасчетыСКонтрагентамиФактОстатки.ОбъектРасчетов КАК ОбъектРасчетов,
		|	ОбъектыРасчетов.Ссылка КАК ОбъектРасчетов,
		|	ОбъектыРасчетов.Партнер КАК Партнер
		// УХ_Встраивание --
		|ИЗ
		|	РегистрНакопления.РасчетыСКонтрагентамиФакт.Остатки(
		|			,
		|			Контрагент = &Контрагент
		|				И Организация = &Организация
		|				И ДоговорКонтрагента = &ДоговорКонтрагента
		|				И Валюта = &Валюта) КАК РасчетыСКонтрагентамиФактОстатки
		// УХ_Встраивание ++
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
		|		ПО РасчетыСКонтрагентамиФактОстатки.ОбъектРасчетов = ОбъектыРасчетов.Объект
		// УХ_Встраивание --
		|ГДЕ
		|	РасчетыСКонтрагентамиФактОстатки.ОбъектРасчетов <> &ДоговорКонтрагента
		|	И &ОтборСуммаОстаток";
	
	Запрос.УстановитьПараметр("Контрагент", 			Контрагент);
	Запрос.УстановитьПараметр("Организация", 			Организация);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", 	ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Валюта", 				Валюта);
	Если ЭтоДоход Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ОтборСуммаОстаток", "	РасчетыСКонтрагентамиФактОстатки.СуммаОстаток > 0 ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ОтборСуммаОстаток", "	РасчетыСКонтрагентамиФактОстатки.СуммаОстаток < 0 ");
	КонецЕсли;

	РезультатЗапроса 		= Запрос.Выполнить();
	ВыборкаДетальныеЗаписи 	= РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаОбъекты = Объект.ОбъектыРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОбъекты, ВыборкаДетальныеЗаписи);
		Если НЕ ЭтоДоход Тогда
			 СтрокаОбъекты.Сумма = СтрокаОбъекты.Сумма*-1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиОбъектыРасчетов(Отметка)
	Для каждого СтрокаОбъекты Из Объект.ОбъектыРасчетов Цикл
		СтрокаОбъекты.Пометка = Отметка;
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОбъектыРасчетовВХранилище()
	
	ТабВыбранныхПозиций 	= Объект.ОбъектыРасчетов.Выгрузить(Новый Структура("Пометка", Истина));
	АдресПозицийВХранилище 	= ПоместитьВоВременноеХранилище(ТабВыбранныхПозиций);
	
	Возврат АдресПозицийВХранилище;
	
КонецФункции

#КонецОбласти