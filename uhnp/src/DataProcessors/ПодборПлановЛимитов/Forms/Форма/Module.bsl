
#Область ОписаниеПеременных

&НаКлиенте
Перем ВыполняетсяЗакрытие Экспорт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Документ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Предусмотрено открытие обработки только из документов.';
								|en = 'Data processor can be opened only from documents.'");
	КонецЕсли;
	
	Объект.ВидБюджета = Параметры.ВидБюджета;
	Объект.Валюта = Параметры.Валюта;
	Объект.СуммаТребуется = Параметры.СуммаТребуется;
	Объект.ПриходРасход = Параметры.ПриходРасход;
	Объект.ИспользуетсяИдентификаторСтроки = Параметры.ИспользуетсяИдентификаторСтроки;
	Объект.ИдентификаторСтроки = Параметры.ИдентификаторСтроки; 
	
	Период.ДатаНачала = НачалоГода(Параметры.Дата);
	Период.ДатаОкончания = КонецГода(Параметры.Дата);
	
	Если НЕ КонтрольЛимитовУХПовтИсп.ПолучитьЗначениеИспользованияРезервирования() Тогда
		Элементы.ВидИсточника.СписокВыбора.Удалить(Элементы.ВидИсточника.СписокВыбора.НайтиПоЗначению("Резервы"));
	КонецЕсли;
	
	ВидИсточника = Параметры.ВидИсточника;
	
	// Корзина
	ЗаполнитьКорзину(Параметры.Корзина);
	
	ПараметрыОП = ОперативноеПланированиеПовтИспУХ.ПолучитьПараметрыОперПланирования(Объект.ВидБюджета, Период.ДатаНачала);
	ПериодичностьПланирования = ПараметрыОП.ПериодичностьОперативногоПланирования;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидБюджета", 	Объект.ВидБюджета);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаНачала", 	Период.ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаОкончания", Период.ДатаОкончания);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Документ", 		Параметры.Документ);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидИсточника", 	ВидИсточника);

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТипыЗаявокКОбеспечению", 	КонтрольЛимитовУХ.ТипыЗаявокКОбеспечению());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТипыЗаявокНаОперации", 		КонтрольЛимитовУХ.ТипыЗаявокНаОперации());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТипыКорректировкиЛимитов", 	КонтрольЛимитовУХ.ТипыКорректировкиЛимитов());
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПриходРасход", Объект.ПриходРасход, , , ЗначениеЗаполнено(Объект.ПриходРасход));  
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Валюта", Объект.Валюта, , , ЗначениеЗаполнено(Объект.Валюта));

	УстановитьУсловноеОформление();  
	УправлениеФормой();
	
КонецПроцедуры   

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьТекстИнформационнойНадписи(ЭтаФорма);   
	
	НастроитьПоляБыстрогоОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы
		И Объект.Корзина.Количество() > 0 Тогда
		
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru = 'Данные были изменены. Все изменения будут потеряны.';
									|en = 'All changes made to the data will be lost.'");  	
		Возврат;
		
	КонецЕсли;
	
	ПередЗакрытиемФормыПодбора(ЭтаФорма, Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = АдресВХранилище(ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресВХранилище = Неопределено;
	КонецЕсли;
	
	Если АдресВХранилище <> Неопределено Тогда
		Результат = Новый Структура;
		Результат.Вставить("АдресВХранилище", АдресВХранилище);
		Результат.Вставить("ИспользуетсяИдентификаторСтроки", Объект.ИспользуетсяИдентификаторСтроки);
		Результат.Вставить("ИдентификаторСтроки", 			  Объект.ИдентификаторСтроки);
		ОповеститьОВыборе(Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИнформационнаяНадписьНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПриНажатииНаИнформационнуюНадпись(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаНачала", Период.ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаОкончания", Период.ДатаОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидИсточникаПриИзменении(Элемент)

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидИсточника", 	ВидИсточника);
	
	УправлениеФормой();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура ПодборТаблицаЛимитовПриАктивизацииСтроки(Элемент)
	
	ПриАктивизацииСтрокиТаблицыЛимитов(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаЛимитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДополнительныеПараметры = ДополнительныеПараметрыОбработкиЗавершения();
	ДополнительныеПараметры.Элемент = Элемент;
	
	// Проверить выбранную строку номенклатуры.
	Оповещение = Новый ОписаниеОповещения("ПодборТаблицаПлановВыборЗавершение", ЭтотОбъект, 
		ДополнительныеПараметры);
	ПриВыбореСтрокиТаблицыЛимита(ЭтаФорма, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаПлановВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПриАктивизацииСтрокиТаблицыЛимитов(ЭтаФорма, Элементы.Список);
	
	СтрокаТаблицыЛимитов = ДополнительныеПараметры.Элемент.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыПлана = ПолучитьПараметрыЛимитаПередДобавлениеВКорзину(ПараметрыФормы);
	
	ДобавитьВКорзину(ПараметрыПлана, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаЛимитовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Копирование;
	
	ПолучитьДанныеПеретаскивания(ЭтаФорма, Элемент, ПараметрыПеретаскивания);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКорзина

&НаКлиенте
Процедура КорзинаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ПеретащитьВКорзинуНаСервере(ПараметрыПеретаскивания.Значение);
	
КонецПроцедуры    

&НаКлиенте
Процедура КорзинаПриИзменении(Элемент)
	
	УстановитьТекстИнформационнойНадписи(ЭтаФорма);
	Элементы.Список.Обновить();
	
	// Обновление корзины
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Корзина", Объект.Корзина);
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПередНачаломИзменения(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.Доступно = 0 Тогда
		Элементы.КорзинаСумма.МаксимальноеЗначение = Неопределено;
	Иначе
		Элементы.КорзинаСумма.МаксимальноеЗначение = Элемент.ТекущиеДанные.Доступно;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Подборы

&НаКлиенте
Процедура ДобавитьВКорзину(ПараметрыПлана, ПараметрыФормы = Неопределено)
	
	Если Не ЗначениеЗаполнено(ПараметрыПлана) Тогда
		Возврат;
	КонецЕсли;
	
	НовыеСтроки = Новый Массив;
	
	НоваяСтрока = СтруктураСтрокиПланов();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПлана);
	
	НовыеСтроки.Добавить(НоваяСтрока);
	
	ДобавитьВКорзинуЗавершение(ПараметрыПлана, НовыеСтроки);
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьВКорзинуНаКлиенте(ПараметрыТовара, НовыеСтроки)
	
	Отбор = Новый Структура(ИменаРеквизитовКорзины("ОбъектКонтроля"));
	
	Для Каждого НоваяСтрока Из НовыеСтроки Цикл
		
		Если НоваяСтрока.Доступно <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
		
		РезультатПоиска = Объект.Корзина.НайтиСтроки(Отбор);
		
		Если РезультатПоиска.Количество() > 0 Тогда
			ТекущаяСтрока = РезультатПоиска[0];
			Объект.Корзина.Удалить(ТекущаяСтрока.НомерСтроки - 1); 
			Продолжить;
		КонецЕсли;
		
		ОстатокСуммы = Объект.СуммаТребуется - Объект.Корзина.Итог("Сумма");
		Если ОстатокСуммы <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаКЗаполнению = Мин(НоваяСтрока.Доступно, ОстатокСуммы);
		Если СуммаКЗаполнению = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока = Объект.Корзина.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Отбор);
		ТекущаяСтрока.Сумма = СуммаКЗаполнению;
		ТекущаяСтрока.Доступно = НоваяСтрока.Доступно;
		
		ТекущаяСтрока.ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
			ТекущаяСтрока.НачалоПериода, ТекущаяСтрока.Периодичность);
		
		Если Не ПоказыватьПодобранныеПланы Тогда
			
			ТекстОповещения = Символы.ПС + НСтр("ru = 'Лимит по статье ""[СтатьяБюджета]"" на сумму [Сумма] [Валюта] добавлен в корзину'");
			
			ВставляемыеЗначения = Новый Структура("СтатьяБюджета, Сумма, Валюта");
			
			Аналитики = Новый Массив;
			Для Поз = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				Аналитики.Добавить(Строка(НоваяСтрока["Аналитика" + Поз]));
			КонецЦикла;
			
			ВставляемыеЗначения.СтатьяБюджета      = Строка(ТекущаяСтрока.СтатьяБюджета) + " (" + СтрСоединить(Аналитики, ",") + ")";
			ВставляемыеЗначения.Сумма              = Формат(ТекущаяСтрока.Сумма, "ЧДЦ=2; ЧН=");
			ВставляемыеЗначения.Валюта             = Строка(ТекущаяСтрока.Валюта);
			
			ТекстОповещения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстОповещения, ВставляемыеЗначения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НовыеСтроки.Количество() > 0 И ТекущаяСтрока <> Неопределено Тогда
		Элементы.Корзина.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	ТекстОповещения = "";
	
	Возврат ТекстОповещения;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВКорзинуЗавершение(ПараметрыТовара, НовыеСтроки)
	
	ТекстОповещения = ДобавитьВКорзинуНаКлиенте(ПараметрыТовара, НовыеСтроки);
	
	Если Не ПоказыватьПодобранныеПланы Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Лимит добавлен в корзину'"), , ТекстОповещения);
	КонецЕсли;
	
	УстановитьТекстИнформационнойНадписи(ЭтаФорма);
	
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Корзина", Объект.Корзина);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЛимитаПередДобавлениеВКорзину(ПараметрыФормы)

	ПараметрыПлана = СтруктураСтрокиПланов();
	ЗаполнитьЗначенияСвойств(ПараметрыПлана, ЭтотОбъект.ТекущаяСтрокаСписка);
	
	Возврат ПараметрыПлана;     
	
КонецФункции

&НаСервере
Функция АдресВХранилище(УникальныйИдентификаторВладельца)
	
	АдресВХранилище = Неопределено;
	
	Если ПеренестиВДокумент Тогда
		
		Данные = Объект.Корзина.Выгрузить();
		АдресВХранилище = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификаторВладельца);
		
	КонецЕсли;
	
	Возврат АдресВХранилище;
	
КонецФункции

#КонецОбласти

#Область ПодборЛимитов

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстИнформационнойНадписи(Форма)
	
	Корзина = Форма.Объект.Корзина;
	Валюта = Форма.Объект.Валюта;
	
	ФорматнаяСтрока = НСтр("ru = 'Л = ru_RU; НП = Истина; НД = Ложь; ДП = Ложь';
							|en = 'Л = en_EN; НП = Истина; НД = Ложь; ДП = Ложь'");
	
	Сумма = Формат(Корзина.Итог("Сумма"), "ЧДЦ=2; ЧН=");
	Количество = НРег(ЧислоПрописью(Корзина.Количество(), ФорматнаяСтрока, НСтр("ru = 'позиция,позиции,позиций,ж,,,,,0';
																				|en = 'position,positions,,,0'")));
	
	ИнформационнаяНадпись = НСтр("ru = 'Всего подобрано [Количество], на сумму [Сумма] [Валюта] [СкрытьПоказать]';
								|en = '[Количество] positions are picked, to the amount of [Сумма] [Валюта] [СкрытьПоказать]'");
	
	СкрытьПоказать = "";
	
	СкрытьПоказать = ?(Форма.ПоказыватьКорзину, НСтр("ru = '(скрыть)';
													|en = '(hide)'"), НСтр("ru = '(показать)';
																			|en = '(show)'"));
	
	ВставляемыеЗначения = Новый Структура;
	ВставляемыеЗначения.Вставить("Количество", Количество);
	ВставляемыеЗначения.Вставить("Сумма", Сумма);
	ВставляемыеЗначения.Вставить("Валюта", Валюта);
	ВставляемыеЗначения.Вставить("СкрытьПоказать", СкрытьПоказать);
	
	ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ИнформационнаяНадпись, ВставляемыеЗначения);
	
	Форма.ИнформационнаяНадпись = ИнформационнаяНадпись;
	
	Форма.Элементы.ОбластьПодобранныеЛимиты.Видимость = Форма.ПоказыватьКорзину;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаИнформационнуюНадпись(Форма, Объект)
	
	Форма.ПоказыватьКорзину = Не Форма.ПоказыватьКорзину;
	УстановитьТекстИнформационнойНадписи(Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеПеретаскивания(Форма, Элемент, ПараметрыПеретаскивания)
	
	МассивПараметров = Новый Массив; 
	
	Для каждого КлючСтроки Из ПараметрыПеретаскивания.Значение Цикл
		
		ДанныеСтроки = Элемент.ДанныеСтроки(КлючСтроки);
		
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЛимита = СтруктураСтрокиПланов();
		
		ЗаполнитьЗначенияСвойств(ПараметрыЛимита, ДанныеСтроки);
		
		МассивПараметров.Добавить(ПараметрыЛимита);
		
	КонецЦикла;
	
	ПараметрыПеретаскивания.Значение = МассивПараметров;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореСтрокиТаблицыЛимита(Форма, ОповещениеУспешногоВыбора)
	
	СтрокаТаблицыЛимитов = Форма.Элементы.Список.ТекущиеДанные;
	Если СтрокаТаблицыЛимитов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеУспешногоВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиТаблицыЛимитов(Форма, Элемент)
	
	ТД = Элемент.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ТекущаяСтрокаСписка <> Неопределено Тогда
		Если ТД.Свойство("ГруппировкаСтроки") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Форма.ТекущаяСтрокаСписка = СтруктураСтрокиПланов();
	ЗаполнитьЗначенияСвойств(Форма.ТекущаяСтрокаСписка, ТД);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураСтрокиПланов()
	
	СтруктураПлана = Новый Структура;
	
	СтруктураПлана.Вставить("ВидБюджета", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка"));
	СтруктураПлана.Вставить("НачалоПериода", Новый ОписаниеТипов("Дата"));
	СтруктураПлана.Вставить("Периодичность", ПредопределенноеЗначение("Перечисление.Периодичность.ПустаяСсылка"));
	СтруктураПлана.Вставить("Валюта", КэшируемыеПроцедурыОПК.ПустаяВалюта());
	СтруктураПлана.Вставить("Организация", КэшируемыеПроцедурыОПК.ПустаяОрганизация());
	СтруктураПлана.Вставить("ЦФО", КэшируемыеПроцедурыОПК.ПустойЦФО());
	СтруктураПлана.Вставить("Проект", КэшируемыеПроцедурыОПК.ПустойПроект());
	СтруктураПлана.Вставить("ПриходРасход", ПредопределенноеЗначение("Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка"));  
	СтруктураПлана.Вставить("ДокументРезерва", Неопределено);
	СтруктураПлана.Вставить("ОбъектКонтроля", Неопределено);
	СтруктураПлана.Вставить("СтатьяБюджета", Неопределено);
	СтруктураПлана.Вставить("Аналитика1", Неопределено);
	СтруктураПлана.Вставить("Аналитика2", Неопределено);
	СтруктураПлана.Вставить("Аналитика3", Неопределено);
	СтруктураПлана.Вставить("Аналитика4", Неопределено);
	СтруктураПлана.Вставить("Аналитика5", Неопределено);
	СтруктураПлана.Вставить("Аналитика6", Неопределено);  
	СтруктураПлана.Вставить("Доступно", 0);
	
	Возврат СтруктураПлана;
	
КонецФункции

&НаСервере
Процедура ПеретащитьВКорзинуНаСервере(Данные)
	
	Для Каждого НоваяСтрока Из Данные Цикл
		
		Отбор = Новый Структура(ИменаРеквизитовКорзины("ОбъектКонтроля"));
		ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
		
		РезультатПоиска = Объект.Корзина.НайтиСтроки(Отбор);
		Если РезультатПоиска.Количество() = 0 Тогда
			ТекущаяСтрока = Объект.Корзина.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Отбор);
			ТекущаяСтрока.ПредставлениеПериода = ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
				ТекущаяСтрока.НачалоПериода, ТекущаяСтрока.Периодичность);
		Иначе
			ТекущаяСтрока = РезультатПоиска[0];
		КонецЕсли;
		
		Если ТекущаяСтрока.Сумма < НоваяСтрока.Доступно Тогда
			ТекущаяСтрока.Сумма = НоваяСтрока.Доступно;
		Иначе
			ТекущаяСтрока.Сумма = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.Список.Обновить(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбора(Форма, Объект, Отказ)
	
	Если Форма.ПеренестиВДокумент ИЛИ Форма.ВыполняетсяЗакрытие Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Корзина.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина; 
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемФормыПодбораЛимитовЗавершение", 
								ЭтотОбъект, Новый Структура("Форма", Форма));
							
	ТекстВопроса = НСтр("ru = 'Подобранные планы не перенесены в документ. Перенести?'");						
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемФормыПодбораЛимитовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма.ПеренестиВДокумент = Истина;
		Форма.ВыполняетсяЗакрытие = Истина;
		Форма.Закрыть(КодВозвратаДиалога.OK);
		Форма.ВыполняетсяЗакрытие = Ложь;
		Возврат;
	КонецЕсли;
	
	Форма.ВыполняетсяЗакрытие = Истина;
	Форма.Закрыть();
	Форма.ВыполняетсяЗакрытие = Ложь;

КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Функция ДополнительныеПараметрыОбработкиЗавершения()
	
	Результат = Новый Структура;
	Результат.Вставить("Элемент");
	
	Возврат Результат;   
	
КонецФункции

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Корзина = Настройки.ДополнительныеСвойства.Корзина.Выгрузить();
	ИспользованоВДокументе = Настройки.ДополнительныеСвойства.ИспользованоВДокументе.Выгрузить();
	
	ИменаРеквизитов = ИменаРеквизитовКорзины();
	СтруктураПоиска = Новый Структура(ИменаРеквизитов);
	Для Каждого Строка Из Строки Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка.Значение.Данные);
		
		//
		Данные = Корзина.НайтиСтроки(СтруктураПоиска);
		Если Данные.Количество() = 0 Тогда
			Строка.Значение.Данные.ВКорзине = 0;
		Иначе
			Строка.Значение.Данные.ВКорзине = Данные[0].Сумма;
		КонецЕсли;
		
		//
		Данные = ИспользованоВДокументе.НайтиСтроки(СтруктураПоиска);
		Если Данные.Количество() = 0 Тогда
			Строка.Значение.Данные.ИспользованоВДокументе = 0;
		Иначе
			Строка.Значение.Данные.ИспользованоВДокументе = Данные[0].Сумма;
		КонецЕсли;
		
		Строка.Значение.Данные.Доступно = Строка.Значение.Данные.Свободно  
						- Строка.Значение.Данные.ВКорзине - Строка.Значение.Данные.ИспользованоВДокументе;
		
		Поле = Строка.Значение.Оформление["НачалоПериода"];
		Поле.УстановитьЗначениеПараметра("Текст", 
			ОбщегоНазначенияОПККлиентСервер.ПредставлениеПериодаПоПериодичности(
								Строка.Значение.Данные.НачалоПериода, Строка.Значение.Данные.Периодичность));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПоляБыстрогоОтбора()
	
	// ПараметрыВыбора для статьи бюджета    
	Элемент = Элементы.Найти("КомпоновщикНастроекПользовательскиеНастройкиЭлемент2Значение"); 
	
	Если Элемент = Неопределено 
		Или Не Элемент.Заголовок = "Статья бюджета" Тогда
		Возврат;
	КонецЕсли;    
	
	Массив = Новый Массив(); 
	Если Объект.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств Тогда
		Массив.Добавить(Тип("СправочникСсылка.СтатьиДвиженияДенежныхСредств")); 
	Иначе
		Массив.Добавить(Тип("СправочникСсылка.СтатьиДоходовИРасходов")); 
 	КонецЕсли;	
	Описание = Новый ОписаниеТипов(Массив);
	
	Элемент.ОграничениеТипа = Описание;
	Элемент.КнопкаВыбора = Истина;
	Элемент.КнопкаСпискаВыбора = Истина;
	Элемент.ВыбиратьТип = Ложь;
	Элемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВВыпадающемСпискеИВПолеВвода;       
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Выделить включенные в корзину лимиты
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокДатаОперации.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокЦФО.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокПроект.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокСтатьяБюджета.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика1.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика2.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика3.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика4.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика5.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокАналитика6.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокВалюта.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокСвободно.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокВКорзине.Имя);
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокДоступно.Имя);

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"Список.ВКорзине", ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКорзину(Данные)
	
	ДанныеКорзины = Объект.Корзина.Выгрузить();
	ДанныеКорзины.Очистить();
	
	ИспользованоВДокументе = ДанныеКорзины.Скопировать();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВидОперации", Перечисления.ВидыОперацийКорректировкаЛимитов.Перенос);
	
	Для Каждого Строка Из Данные.НайтиСтроки(СтруктураПоиска) Цикл
		Если Объект.ИспользуетсяИдентификаторСтроки = Ложь 
			ИЛИ Строка.ИдентификаторСтроки = Объект.ИдентификаторСтроки Тогда
			ЗаполнитьЗначенияСвойств(ДанныеКорзины.Добавить(), Строка);
		Иначе
			ЗаполнитьЗначенияСвойств(ИспользованоВДокументе.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеКорзины.ЗаполнитьЗначения(Объект.ВидБюджета, "ВидБюджета");
	ДанныеКорзины.ЗаполнитьЗначения(Объект.Валюта, "Валюта");
	Объект.Корзина.Загрузить(ДанныеКорзины);
	
	ИменаРеквизитов = ИменаРеквизитовКорзины();
	ИспользованоВДокументе.ЗаполнитьЗначения(Объект.ВидБюджета, "ВидБюджета");
	ИспользованоВДокументе.ЗаполнитьЗначения(Объект.Валюта, "Валюта");
	ИспользованоВДокументе.Свернуть(ИменаРеквизитов, "Сумма");
	ИспользованоВДокументе.Сортировать(ИменаРеквизитов);
	Объект.ИспользованоВДокументе.Загрузить(ИспользованоВДокументе);
	
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Корзина", Объект.Корзина);
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ИспользованоВДокументе", 
																	Объект.ИспользованоВДокументе);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаРеквизитовКорзины(ДопРеквизиты = "")
	Возврат "ВидБюджета, Валюта, НачалоПериода, Периодичность, ЦФО, Проект, ПриходРасход, СтатьяБюджета, ДокументРезерва, "
		+ АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("Аналитика%1")
		+ ?(ДопРеквизиты = "", "", ", " + ДопРеквизиты);
