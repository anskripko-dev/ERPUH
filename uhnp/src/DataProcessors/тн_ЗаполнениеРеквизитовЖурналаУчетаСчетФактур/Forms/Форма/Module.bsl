		КонецЕсли;
	КонецЦикла;
	//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	Если ЕстьСтрокиСОтметкой Тогда
	//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085	
		ОбщегоНазначения.СообщитьПользователю("Обработка выбранных СФ выполнена");
	//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
КонецПроцедуры  

&НаСервере
//~ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085: + параметр ИзменяемыйКодВидаОперации
//Процедура   ИзменитьЗаписьВРС(СФ,ИсправлениеКорректировка,ИзменяемаяДата,ИзменяемыйНомер)
Процедура   ИзменитьЗаписьВРС(СФ, ИсправлениеКорректировка, ИзменяемаяДата, ИзменяемыйНомер, ИзменяемыйКодВидаОперации)
	
	НаборЗаписей = РегистрыСведений.ЖурналУчетаСчетовФактур.СоздатьНаборЗаписей();
	НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
	НаборЗаписей.Отбор.Регистратор.Установить(СФ);
	НаборЗаписей.Прочитать();
	ОбъектСФ = СФ.ПолучитьОбъект();
	ОбъектСФ.Номер = ИзменяемыйНомер;
	ОбъектСФ.ДатаСоставления = ИзменяемаяДата;
	//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	ОбъектСФ.КодВидаОперации = ИзменяемыйКодВидаОперации;
	//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	ОбъектСФ.ОбменДанными.Загрузка = Истина;
	ОбъектСФ.Записать(); 
	Если   НаборЗаписей.Количество() <> 0 Тогда
		Запись = НаборЗаписей[0];
		Если ИсправлениеКорректировка  Тогда
			Запись.ДатаКорректировочногоСчетаФактуры = ?(ЗначениеЗаполнено(ИзменяемаяДата),ИзменяемаяДата,Запись.ДатаКорректировочногоСчетаФактуры);
			Запись.НомерКорректировочногоСчетаФактуры =?(ЗначениеЗаполнено(ИзменяемыйНомер),ИзменяемыйНомер,Запись.НомерКорректировочногоСчетаФактуры); 
			НаборЗаписей.Записать();
		Иначе
			Запись.ДатаСчетаФактуры = ?(ЗначениеЗаполнено(ИзменяемаяДата),ИзменяемаяДата,Запись.ДатаСчетаФактуры); 
			
			//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
			//Запись.НомерСчетаФактуры =?(ЗначениеЗаполнено(ИзменяемыйНомер),ИзменяемыйНомер,Запись.ИзменяемыйНомер);
			Запись.НомерСчетаФактуры =?(ЗначениеЗаполнено(ИзменяемыйНомер), ИзменяемыйНомер, Запись.НомерСчетаФактуры);
			Запись.КодВидаОперации = ?(ЗначениеЗаполнено(ИзменяемыйКодВидаОперации), ИзменяемыйКодВидаОперации, Запись.КодВидаОперации); 
			Если ЗначениеЗаполнено(ИзменяемыйКодВидаОперации) Тогда
				КодВидаОперацииКомиссия = УчетНДСПереопределяемый.КодВидаОперацииКомиссия(ИзменяемыйКодВидаОперации, ОбъектСФ.Дата);
			Иначе
				КодВидаОперацииКомиссия = Запись.КодВидаОперацииКомиссия;
			КонецЕсли;
			Запись.КодВидаОперацииКомиссия = КодВидаОперацииКомиссия;
			//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
			
			НаборЗаписей.Записать();
			          
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ИзменитьЗаписиВРегистре(Команда)
	
	//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	Если Объект.СФ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085  
	ИзменитьЗаписиВРегистреНаСервере(); 
	ОповеститьОбИзменении(Тип("ДокументСсылка.СчетФактураПолученный"));
КонецПроцедуры

&НаСервере
Функция СФСФПриИзмененииНаСервере(ОтборСФ)
  	Запрос = Новый Запрос;     
	
	Запрос.Текст  ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СчетФактураПолученный.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ СписокСФ
	               |ИЗ
	               |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	               |ГДЕ
	               |	СчетФактураПолученный.Проведен
	               |	И СчетФактураПолученный.Ссылка = &ТекСФ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЖурналУчетаСчетовФактурСрезПоследних.НомерСчетаФактуры КАК НомерСчетаФактуры,
	               |	ЖурналУчетаСчетовФактурСрезПоследних.ДатаСчетаФактуры КАК ДатаСчетаФактуры,
	               |	ЖурналУчетаСчетовФактурСрезПоследних.СчетФактура.Корректировочный КАК Корректировочный,
	               |	ЖурналУчетаСчетовФактурСрезПоследних.СчетФактура КАК Ссылка,
				   //НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085 
				   |	ЖурналУчетаСчетовФактурСрезПоследних.КодВидаОперации КАК КодВидаОперации,
				   //КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	               |	ЖурналУчетаСчетовФактурСрезПоследних.Контрагент КАК Контрагент
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрСведений.ЖурналУчетаСчетовФактур.СрезПоследних(
	               |			,
	               |			СчетФактура В
	               |				(ВЫБРАТЬ
	               |					СписокСФ.Ссылка
	               |				ИЗ
	               |					СписокСФ КАК СписокСФ)) КАК ЖурналУчетаСчетовФактурСрезПоследних,
	               |	СписокСФ КАК СписокСФ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.НомерСчетаФактуры КАК НомерСФЖурнал,
	               |	ВТ.ДатаСчетаФактуры КАК ДатаСФЖурнал,
	               |	ВТ.Корректировочный КАК Корректировочный,
	               |	ВТ.Ссылка.Номер КАК НомерСФ,
	               |	НАЧАЛОПЕРИОДА(ВТ.Ссылка.ДатаСоставления, ДЕНЬ) КАК ДатаСФ,
	               |	ВТ.Ссылка КАК СчетФактура,
				   //НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
				   |	ВТ.Ссылка.КодВидаОперации КАК КодВидаОперации,
				   |	ВТ.КодВидаОперации КАК КодВидаОперацииЖурнал,
				   //КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	               |	ВТ.Контрагент КАК Контрагент
	               |ИЗ
	               |	ВТ КАК ВТ"; 
	Запрос.УстановитьПараметр("ТекСФ",ОтборСФ);
	Результат = Запрос.Выполнить().Выбрать();
	СтруктураСФ = Новый Структура();
	
	Если Результат.Следующий() Тогда
		СтруктураСФ.Вставить("НомерСФЖурнал",Результат.НомерСФЖурнал);
		СтруктураСФ.Вставить("ДатаСФЖурнал",Результат.ДатаСФЖурнал);
		СтруктураСФ.Вставить("Корректировочный",Результат.Корректировочный);
		СтруктураСФ.Вставить("НомерСФ",Результат.НомерСФ);
		СтруктураСФ.Вставить("ДатаСФ",Результат.ДатаСФ);
		СтруктураСФ.Вставить("СчетФактура",Результат.СчетФактура);
		//НАЧАЛО Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
		СтруктураСФ.Вставить("КодВидаОперации", Результат.КодВидаОперации);
		СтруктураСФ.Вставить("КодВидаОперацииЖурнал", Результат.КодВидаОперацииЖурнал);
		//КОНЕЦ Сафиуллина З.Р. 12.09.2025 Выполнение задач №000055085
	КонецЕсли;
       Возврат  СтруктураСФ;
КонецФункции

&НаКлиенте
Процедура СФСФПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СФ.ТекущиеДанные;
	ДанныеИзСФ = СФСФПриИзмененииНаСервере(ТекущиеДанные.СчетФактура);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные,ДанныеИзСФ);
	ТекущиеДанные.Отметка = Истина;    
КонецПроцедуры

