
#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ОтобратьДокументыДляКопирования(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите ответственного для подбора документов.");
		Возврат;
	КонецЕсли;
	
	Если Объект.Документы.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх("Перед заполнением список документов будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Нет Тогда   
        	Возврат;
		Иначе 
			Объект.Документы.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	ОтобратьДокументыДляКопированияНаСервере();
	
КонецПроцедуры

 &НаСервере
Процедура ОтобратьДокументыДляКопированияНаСервере()
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	// НАЧАЛО Чекордина Ирина 03.10.2024 Выполнение задач №000050999
	//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//	|	РеализацияТоваровУслугТовары.Ссылка КАК РеализацияТоваровУслугИсходная,
	//	|	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК КонтрагентИсходный,
	//	|	РеализацияТоваровУслугТовары.Ссылка.Договор КАК ДоговорИсходный,
	//	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	//	|	РеализацияТоваровУслугТовары.СуммаСНДС КАК СуммаСНДСИсходная,
	//	|	РеализацияТоваровУслугТовары.Количество КАК КоличествоИсходное,
	//	|	ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактураИсходный
	//	|ИЗ
	//	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	//	//НАЧАЛО Сафиуллина З.Р. 20.09.2024 Выполнение задач №000050878
	//	//|		ПО РеализацияТоваровУслугТовары.Ссылка = СчетФактураВыданный.ДокументОснование
	//	|		ПО (РеализацияТоваровУслугТовары.Ссылка = СчетФактураВыданный.ДокументОснование
	//	|				И НЕ СчетФактураВыданный.ПометкаУдаления)
	//	//КОНЕЦ Сафиуллина З.Р. 20.09.2024 Выполнение задач №000050878
	//	|ГДЕ
	//	|	РеализацияТоваровУслугТовары.Ссылка.Автор = &Ответственный
	//	|	И РеализацияТоваровУслугТовары.Ссылка.Проведен
	//	|	И РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)";
	//
	//Если ЗначениеЗаполнено(Объект.Период.ДатаНачала) И ЗначениеЗаполнено(Объект.Период.ДатаОкончания) Тогда 
	//	Запрос.Текст = Запрос.Текст + " И РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	//КонецЕсли;
	//
	//Если ЗначениеЗаполнено(Объект.Организация) Тогда 
	//	Запрос.Текст = Запрос.Текст + " И РеализацияТоваровУслугТовары.Ссылка.Организация = &Организация";
	//КонецЕсли;
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.Ссылка КАК РеализацияТоваровУслугИсходная,
		|	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК КонтрагентИсходный,
		|	РеализацияТоваровУслугТовары.Ссылка.Договор КАК ДоговорИсходный,
		|	СУММА(РеализацияТоваровУслугТовары.СуммаСНДС) КАК СуммаСНДСИсходная,
		|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК КоличествоИсходное,
		|	ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактураИсходный
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО РеализацияТоваровУслугТовары.Ссылка = СчетФактураВыданный.ДокументОснование
		|			И (НЕ СчетФактураВыданный.ПометкаУдаления)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка.Автор = &Ответственный
		|	И РеализацияТоваровУслугТовары.Ссылка.Проведен
		|	И РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|	И &УсловиеПоПериоду
		|	И &УсловиеПоОрганизации
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровУслугТовары.Ссылка,
		|	РеализацияТоваровУслугТовары.Ссылка.Контрагент,
		|	РеализацияТоваровУслугТовары.Ссылка.Договор,
		|	ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка))"; 
		
	Если ЗначениеЗаполнено(Объект.Период.ДатаНачала) И ЗначениеЗаполнено(Объект.Период.ДатаОкончания) Тогда 
		УсловиеПоПериоду = "РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Иначе
		УсловиеПоПериоду = "ИСТИНА";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда 
		УсловиеПоОрганизации = "РеализацияТоваровУслугТовары.Ссылка.Организация = &Организация";
	Иначе
		УсловиеПоОрганизации = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоПериоду", УсловиеПоПериоду);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОрганизации", УсловиеПоОрганизации);
	// КОНЕЦ Чекордина Ирина 03.10.2024 Выполнение задач №000050999
	
	Запрос.УстановитьПараметр("ДатаНачала", Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Ответственный", Объект.Ответственный);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТабЧасти = Объект.Документы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабЧасти, Выборка); 
	КонецЦикла;
	
	Если Объект.Документы.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдено документов по ответственному. Поменяйте условия отбора.");
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КопироватьДокументы(Команда)  
	
	НомераСтрокСКопиями = ПроверитьРанееСозданныеКопии(); 
	
	Если ЗначениеЗаполнено(НомераСтрокСКопиями) Тогда
		ТекстВопроса = "Найдены уже созданные копии в строках " + СтрСоединить(НомераСтрокСКопиями, ",") + ". Продолжить?";		
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
		Если Ответ = КодВозвратаДиалога.Нет Тогда   
        	Возврат;
		КонецЕсли;
	КонецЕсли;     
	
	КопироватьДокументыНаСервере();    
	
КонецПроцедуры  

&НаСервере
Процедура КопироватьДокументыНаСервере() 
	
	Если Объект.Документы.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("В табличной части не введено ни одного исходного документа!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаСоздаваемогоДокумента) Тогда
		ОбщегоНазначения.СообщитьПользователю("Заполните дату для создаваемых документов.");
		Возврат;
	КонецЕсли;
	
	ДатаДокумента = Объект.ДатаСоздаваемогоДокумента;
	
	Счетчик = 0;
	
	Для Каждого СтрокаТабЧасти Из Объект.Документы Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти.РеализацияТоваровУслугИсходная) Тогда 
			Продолжить;
		КонецЕсли; 
		
		НачатьТранзакцию();
		
		Попытка 
			//пользователь повторно запускает обработку, чтоб изменить суммы в созданных документах
			Если ЗначениеЗаполнено(СтрокаТабЧасти.РеализацияТоваровУслугКопия) Тогда 
				
				РеализацияКопия = СтрокаТабЧасти.РеализацияТоваровУслугКопия.ПолучитьОбъект();
				
				ОбработатьИзменениеСуммыИКоличестваВТабЧасти(РеализацияКопия, СтрокаТабЧасти);
				
				Если РеализацияКопия.Модифицированность() Тогда
					РеализацияКопия.Записать(РежимЗаписиДокумента.Проведение); 
					//сумма в счет-фактуре меняется автоматически при проведении документа-основания
				КонецЕсли;
				
			Иначе
				
				РеализацияКопия = СтрокаТабЧасти.РеализацияТоваровУслугИсходная.Скопировать(); 
				//НАЧАЛО Качикина 06.08.2025 Выполнение задач №000054699
				//в ПриКопировании() вызывается ИнициализироватьДокумент() и часть реквизитов пересчитывается
				СписокСвойств = "СтавкаНДС, СуммаНДС, СуммаСНДС, Сумма,
							|СуммаРучнойСкидки, СуммаАвтоматическойСкидки, СуммаБонусныхБалловКСписаниюВВалюте"; 
				Инд = 0; 
				КоличествоСтрок = РеализацияКопия.Товары.Количество(); 
				Пока Инд< КоличествоСтрок Цикл
					ЗаполнитьЗначенияСвойств(РеализацияКопия.Товары[Инд],СтрокаТабЧасти.РеализацияТоваровУслугИсходная.Товары[Инд],СписокСвойств); 
					Инд = Инд+1;
				КонецЦикла;
				//КОНЕЦ Качикина 06.08.2025 Выполнение задач №000054699
				РеализацияКопия.Дата = ДатаДокумента;
				РеализацияКопия.Комментарий = СтрШаблон("Аренда по договору %1 за %2", СтрокаТабЧасти.ДоговорИсходный, Формат(ДатаДокумента, "ДФ='MMMM yyyy ""г.""'"));
				РеализацияКопия.Автор = Пользователи.ТекущийПользователь(); 
				РеализацияКопия.тн_НомерДокументаУПП = "";
				РеализацияКопия.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено; 
				
				ОбработатьИзменениеСуммыИКоличестваВТабЧасти(РеализацияКопия, СтрокаТабЧасти);
				
				РеализацияКопия.Записать(РежимЗаписиДокумента.Проведение);
				
				СоздаватьСчетФактуру = ЗначениеЗаполнено(СтрокаТабЧасти.СчетФактураИсходный)
					И ЗначениеЗаполнено(РеализацияКопия.Ссылка);

				Если СоздаватьСчетФактуру  Тогда 
					СчетФактураКопия = Документы.СчетФактураВыданный.СоздатьДокумент();
					СчетФактураКопия.Заполнить(РеализацияКопия.Ссылка);  
					СчетФактураКопия.Дата = ДатаДокумента;
					СчетФактураКопия.ДатаВыставления = ДатаДокумента + 1;
					СчетФактураКопия.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;   
				
				СтрокаТабЧасти.РеализацияТоваровУслугКопия = РеализацияКопия.Ссылка; 
				Если СчетФактураКопия <> Неопределено Тогда
					СтрокаТабЧасти.СчетФактураКопия = СчетФактураКопия.Ссылка;
				КонецЕсли;
				СтрокаТабЧасти.КонтрагентКопия = РеализацияКопия.Контрагент;
				СтрокаТабЧасти.ДоговорКопия = РеализацияКопия.Договор;
				СтрокаТабЧасти.СуммаСНДСКопия = РеализацияКопия.СуммаДокумента; 
				СтрокаТабЧасти.КоличествоКопия = РеализацияКопия.Товары.Итог("Количество");  
				
			КонецЕсли;	
			
			Счетчик = Счетчик + 1;
			ЗафиксироватьТранзакцию();
				
		Исключение 
			
			ОтменитьТранзакцию(); 
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Создание документов из внешней обработки ""Скопировать документы ""Реализация товаров и услуг"" (услуги) (тн)", 
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки); 
		    ОбщегоНазначения.СообщитьПользователю("Не удалось создать копию документа по строке " + СтрокаТабЧасти.НомерСтроки);
			
		КонецПопытки;
		
	КонецЦикла; 
	
	Если Счетчик > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Создание/изменение копий документов завершено!");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти   

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Документы.ТекущиеДанные;
	
	Если Поле = Элементы.ДокументыРеализацияТоваровУслугКопия Тогда
		СтандартнаяОбработка = Ложь;
    	ПоказатьЗначение(,ТекущиеДанные.РеализацияТоваровУслугКопия);
	ИначеЕсли Поле = Элементы.ДокументыСчетФактураКопия Тогда
        СтандартнаяОбработка = Ложь;
    	ПоказатьЗначение(,ТекущиеДанные.СчетФактураКопия);
	ИначеЕсли Поле = Элементы.ДокументыКонтрагентКопия Тогда
        СтандартнаяОбработка = Ложь;
    	ПоказатьЗначение(,ТекущиеДанные.КонтрагентКопия);
	ИначеЕсли Поле = Элементы.ДокументыДоговорКопия Тогда
        СтандартнаяОбработка = Ложь;
    	ПоказатьЗначение(,ТекущиеДанные.ДоговорКопия);	
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Процедура ДокументыСуммаСНДСКопияПриИзменении(Элемент)
	
	ПроверитьВозможностьИзмененияНаСервере(Элементы.Документы.ТекущиеДанные.РеализацияТоваровУслугКопия); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ДокументыКоличествоКопияПриИзменении(Элемент)
	
	ПроверитьВозможностьИзмененияНаСервере(Элементы.Документы.ТекущиеДанные.РеализацияТоваровУслугКопия); 
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыРеализацияТоваровУслугИсходнаяПриИзменении(Элемент)  
	
	ТекущиеДанные = Элементы.Документы.ТекущиеДанные;
	ДанныеПоРеализации = ДанныеПоРеализации(ТекущиеДанные.РеализацияТоваровУслугИсходная); 
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеПоРеализации);
	
КонецПроцедуры  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработатьИзменениеСуммыИКоличестваВТабЧасти(РеализацияКопия, СтрокаТабЧасти)
	
	Если НужноПоменятьКоличествоВДокументе(РеализацияКопия, СтрокаТабЧасти) Тогда 
		
		РеализацияКопия.Товары[0].КоличествоУпаковок = СтрокаТабЧасти.КоличествоКопия;
		ОбработатьСтрокуТабЧасти(РеализацияКопия, РеализацияКопия.Товары[0], "Количество");    
		
	КонецЕсли;
	
	Если НужноПоменятьСуммуВДокументе(РеализацияКопия, СтрокаТабЧасти) Тогда
		
		РеализацияКопия.Товары[0].Сумма = СтрокаТабЧасти.СуммаСНДСКопия;
		ОбработатьСтрокуТабЧасти(РеализацияКопия, РеализацияКопия.Товары[0], "Сумма");	
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НужноПоменятьСуммуВДокументе(РеализацияКопия, СтрокаТабЧасти)
	
	НужноПоменятьСумму = РеализацияКопия.Товары.Количество() > 0 
		И СтрокаТабЧасти.СуммаСНДСКопия > 0
		И РеализацияКопия.Товары[0].СуммаСНДС <> СтрокаТабЧасти.СуммаСНДСКопия;	
		
	Возврат НужноПоменятьСумму;
	
КонецФункции

&НаСервере
Функция НужноПоменятьКоличествоВДокументе(РеализацияКопия, СтрокаТабЧасти)
	
	НужноПоменятьКоличество = РеализацияКопия.Товары.Количество() > 0 
		И СтрокаТабЧасти.КоличествоКопия > 0
		И РеализацияКопия.Товары[0].Количество <> СтрокаТабЧасти.КоличествоКопия;	
		
	Возврат НужноПоменятьКоличество;
	
КонецФункции

