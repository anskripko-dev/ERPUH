&НаСервере
Функция СтруктураДействий(Объект, ИзменяемоеПоле)
	
	СтруктураДействий = Новый Структура; 
	// КалининаЕВ 31.07.2025
	//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);   
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
     //КалининаЕВ 31.07.2025

	Если ИзменяемоеПоле = "Сумма" Тогда 
		
		//КалининаЕВ 31.07.2025
		//СтруктураПересчетаЦены  = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект,  
		СтруктураПересчетаЦены  = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект, 
		//КалининаЕВ 31.07.2025
			Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию"));

		СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах", СтруктураПересчетаЦены);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
		
	ИначеЕсли ИзменяемоеПоле = "Количество" Тогда
		
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомСкидкиБонуснымиБаллами");
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
		
	КонецЕсли;
	
	Возврат СтруктураДействий;
	
КонецФункции

&НаСервере
Процедура ПроверитьВозможностьИзмененияНаСервере(РеализацияТоваровУслугКопия)
	 
	Если НЕ ЗначениеЗаполнено(РеализацияТоваровУслугКопия) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛОЖЬ КАК МожноРедактировать
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
		|
		|ИМЕЮЩИЕ
		|	(КОЛИЧЕСТВО(РеализацияТоваровУслугТовары.НомерСтроки) = 0
		|		ИЛИ КОЛИЧЕСТВО(РеализацияТоваровУслугТовары.НомерСтроки) > 1)";
	
	Запрос.УстановитьПараметр("Ссылка", РеализацияТоваровУслугКопия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("В табличной части изменяемого документа несколько строк, внесите изменения вручную.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРанееСозданныеКопии()
	
	КомментарииДокументов = Новый ТаблицаЗначений;
	КомментарииДокументов.Колонки.Добавить("НомерСтрокиТЧ", ОбщегоНазначения.ОписаниеТипаЧисло(1000));
	КомментарииДокументов.Колонки.Добавить("Комментарий", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	
	ШаблонКомментария = "Аренда по договору %1 за %2";
	
	Для Каждого СтрокаТабЧасти Из Объект.Документы Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти.РеализацияТоваровУслугИсходная) Тогда 
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = КомментарииДокументов.Добавить();
		НоваяСтрока.НомерСтрокиТЧ = СтрокаТабЧасти.НомерСтроки;
		НоваяСтрока.Комментарий = СтрШаблон(ШаблонКомментария, СтрокаТабЧасти.ДоговорИсходный, 
			Формат(Объект.ДатаСоздаваемогоДокумента, "ДФ='MMMM yyyy ""г.""'"));
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомментарииДокументов.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
		|	КомментарииДокументов.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ ВТКомментарии
		|ИЗ
		|	&КомментарииДокументов КАК КомментарииДокументов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Комментарий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТКомментарии.НомерСтрокиТЧ КАК НомерСтрокиТЧ
		|ИЗ
		|	ВТКомментарии КАК ВТКомментарии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО (ВТКомментарии.Комментарий = (ВЫРАЗИТЬ(РеализацияТоваровУслуг.Комментарий КАК СТРОКА(255))))
		|			И (НЕ РеализацияТоваровУслуг.ПометкаУдаления)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТКомментарии.НомерСтрокиТЧ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтрокиТЧ";
	
	Запрос.УстановитьПараметр("КомментарииДокументов", КомментарииДокументов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("НомерСтрокиТЧ");
	
КонецФункции

&НаСервере
Функция ДанныеПоРеализации(РеализацияТоваровУслугИсходная)     
	
	ДанныеЗаполнения = Новый Структура("КонтрагентИсходный, ДоговорИсходный, СуммаСНДСИсходная, КоличествоИсходное, СчетФактураИсходный");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслугТовары.Ссылка КАК РеализацияТоваровУслугИсходная,
		|	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК КонтрагентИсходный,
		|	РеализацияТоваровУслугТовары.Ссылка.Договор КАК ДоговорИсходный,
		|	РеализацияТоваровУслугТовары.СуммаСНДС КАК СуммаСНДСИсходная,
		|	РеализацияТоваровУслугТовары.Количество КАК КоличествоИсходное,
		|	ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактураИсходный
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО РеализацияТоваровУслугТовары.Ссылка = СчетФактураВыданный.ДокументОснование
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &РеализацияТоваровУслугИсходная";
	
	Запрос.УстановитьПараметр("РеализацияТоваровУслугИсходная", РеализацияТоваровУслугИсходная);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, Выборка); 
	КонецЕсли;
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

