		|ГДЕ
		|	СебестоимостьТоваров.Активность
		|	И СебестоимостьТоваров.Регистратор В(&ОбрабатываемыеДокументы)";
	
	Запрос.Текст = ТекстЗапроса + ДополнениеТекстаЗапроса(ВсеТипыДокументов, Объект.Период.ДатаНачала, Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериода", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ОбрабатываемыеДокументы", Объект.ОбрабатываемыеДокументы.Выгрузить().ВыгрузитьКолонку("Документ"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("Нет подходящих документов для корректировки.");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		ДокументКорректировкаРегистров = Документы.КорректировкаРегистров.СоздатьДокумент(); 
		ДокументКорректировкаРегистров.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
		ДокументКорректировкаРегистров.Дата = ТекущаяДатаСеанса();
		ДокументКорректировкаРегистров.Ответственный = Пользователи.ТекущийПользователь();
		ДокументКорректировкаРегистров.Комментарий = "Создано автоматически из обработки ""Корректировка упр. себестоимости (тн)"""; 
		СтрокаСРегистром = ДокументКорректировкаРегистров.ТаблицаРегистров.Добавить(); 
		СтрокаСРегистром.Имя = "СебестоимостьТоваров";
		
		ДокументКорректировкаРегистров.Записать();
		
		СторнируемыйНаборЗаписей = РегистрыНакопления.СебестоимостьТоваров.СоздатьНаборЗаписей();
		СторнируемыйНаборЗаписей.Отбор.Регистратор.Установить(ДокументКорректировкаРегистров.Ссылка);
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДвижениеСторно = СторнируемыйНаборЗаписей.Добавить();
			//НАЧАЛО Сафиуллина З.Р. 21.10.2024 Выполнение задач №000051251
			//ЗаполнитьЗначенияСвойств(ДвижениеСторно, Выборка,, "Период,Регистратор");
			//ДвижениеСторно.Период = ТекущаяДатаСеанса();
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, Выборка,, "Регистратор");
			//КОНЕЦ Сафиуллина З.Р. 21.10.2024 Выполнение задач №000051251
			ДвижениеСторно.НДСРегл = 0;
			//НАЧАЛО Качикина 23.12.2024 Выполнение задач №000052136 
			Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
				
				ДвижениеСторно.РасчетСебестоимости = Ложь;
				ДвижениеСторно.ТипЗаписи	= Перечисления.ТипыЗаписейПартий.Партия; 
				ДвижениеСторно.ВидДвижения	= ?(ДвижениеСторно.ВидДвижения = ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход,ВидДвиженияНакопления.Приход);
				
				Для Каждого Ресурс из Метаданные.РегистрыНакопления.СебестоимостьТоваров.Ресурсы Цикл   
					Если НЕ СтрЗаканчиваетсяНа(Ресурс.Имя, "Упр") Тогда	
						ДвижениеСторно[Ресурс.Имя] = 0;
					КонецЕсли;
				КонецЦикла;
				
			Иначе
			//КОНЕЦ Качикина 23.12.2024 Выполнение задач №000052136
			ДвижениеСторно.НДСУпр = - Выборка.НДСУпр;
			
			Для Каждого Ресурс из Метаданные.РегистрыНакопления.СебестоимостьТоваров.Ресурсы Цикл   
				Если СтрЗаканчиваетсяНа(Ресурс.Имя, "Упр") Тогда
					ДвижениеСторно[Ресурс.Имя] = -Выборка[Ресурс.Имя];
				Иначе 	
					ДвижениеСторно[Ресурс.Имя] = 0;
				КонецЕсли;
			КонецЦикла; 
			//НАЧАЛО Качикина 23.12.2024 Выполнение задач №000052136 	
			КонецЕсли;
			//КОНЕЦ Качикина 23.12.2024 Выполнение задач №000052136
			
		КонецЦикла;
		
		СторнируемыйНаборЗаписей.Записать();
		
		ОбщегоНазначения.СообщитьПользователю("Сформирован документ: " + ДокументКорректировкаРегистров, ДокументКорректировкаРегистров); 

		ЗафиксироватьТранзакцию();
		
	Исключение 
		
		ОтменитьТранзакцию();
		ТекстОшибки = "Документ " + ДокументКорректировкаРегистров +":" + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обработка ""Корректировка упр. себестоимости (тн)""", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю("Возникли ошибки при корректировке упр. себестоимости.");
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Процедура ЗаполнитьТипыДокументов()
	
	ТипыДокументов.Добавить(Метаданные.Документы.ПриобретениеТоваровУслуг.Имя, 
		Метаданные.Документы.ПриобретениеТоваровУслуг.Представление(), Истина);
	ТипыДокументов.Добавить(Метаданные.Документы.ПоступлениеТоваровНаСклад.Имя, 
		Метаданные.Документы.ПоступлениеТоваровНаСклад.Представление(), Истина);
	ТипыДокументов.Добавить(Метаданные.Документы.ПеремещениеТоваров.Имя, 
		Метаданные.Документы.ПеремещениеТоваров.Представление(), Истина);
	ТипыДокументов.Добавить(Метаданные.Документы.ОприходованиеИзлишковТоваров.Имя, 
		Метаданные.Документы.ОприходованиеИзлишковТоваров.Представление(), Истина); 
	ТипыДокументов.Добавить(Метаданные.Документы.ПересортицаТоваров.Имя, 
		Метаданные.Документы.ПересортицаТоваров.Представление(), Истина);
	ТипыДокументов.Добавить(Метаданные.Документы.ПрочееОприходованиеТоваров.Имя, 
		Метаданные.Документы.ПрочееОприходованиеТоваров.Представление(), Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДополнениеТекстаЗапроса(ОтмеченныеТипыДокументов, НачалоПериода, КонецПериода)
	
	ДополнениеТекстаЗапроса = Символы.ПС + "И ВЫБОР " + Символы.ПС; 
	
	Для Каждого ТипДокумента Из ОтмеченныеТипыДокументов Цикл
		Если НЕ ТипДокумента = "ПриобретениеТоваровУслуг" Тогда
			ТекстПоТипу = " КОГДА СебестоимостьТоваров.РасчетСебестоимости  
						   |	И СебестоимостьТоваров.Регистратор ССЫЛКА Документ." + ТипДокумента + "
						   |	ТОГДА ВЫРАЗИТЬ(СебестоимостьТоваров.Регистратор КАК Документ." + ТипДокумента + ").тн_КорректировкаУпрСебестоимости";
			ДополнениеТекстаЗапроса = ДополнениеТекстаЗапроса + ТекстПоТипу + Символы.ПС; 	
		КонецЕсли;
	КонецЦикла;
	
	ЕстьТипПриобретениеТоваровУслуг = ОтмеченныеТипыДокументов.Найти("ПриобретениеТоваровУслуг")<> Неопределено;
	Если ЕстьТипПриобретениеТоваровУслуг Тогда 
		ТекстПоПриобретениюТоваровУслуг = " КОГДА СебестоимостьТоваров.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
										   | 	ТОГДА ВЫРАЗИТЬ(СебестоимостьТоваров.Регистратор КАК Документ.ПриобретениеТоваровУслуг).тн_КорректировкаУпрСебестоимости
										   |			ИНАЧЕ ЛОЖЬ
										   |	КОНЕЦ" + Символы.ПС;
	Иначе
		ТекстПоПриобретениюТоваровУслуг = "	ИНАЧЕ ЛОЖЬ
										   |	КОНЕЦ" + Символы.ПС;	
	КонецЕсли;
	
	ДополнениеТекстаЗапроса = ДополнениеТекстаЗапроса + ТекстПоПриобретениюТоваровУслуг; 
	
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) Тогда 
		ТекстПоПериоду = "	И СебестоимостьТоваров.Период МЕЖДУ &НачалоПериода И &КонецПериода";
		ДополнениеТекстаЗапроса = ДополнениеТекстаЗапроса + ТекстПоПериоду;
	КонецЕсли; 
	
	Возврат ДополнениеТекстаЗапроса;

КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопроса_ОчищениеСпискаДокументов(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда   
        Возврат;
	КонецЕсли; 
	
	Объект.ОбрабатываемыеДокументы.Очистить();
	ЗаполнитьСписокДокументовНаСервере();
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВыбораДокумента(Ссылка, Элемент)
	
	ИмяФормыВыбора = ПолучитьИмяФормыВыбораПоСсылке(Ссылка);
	
	НастройкиКомпоновкиДанных = Новый НастройкиКомпоновкиДанных;
	
	ДатаНачала = Объект.Период.ДатаНачала;
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = ДатаНачала;   
	КонецЕсли;
	
	ДатаОкончания = Объект.Период.ДатаОкончания;  
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = Объект.Период.ДатаОкончания; 
	КонецЕсли;
	
	ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проведен");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;

	
	ПараметрыФормы = Новый Структура("ФиксированныеНастройки", НастройкиКомпоновкиДанных);
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, Элемент); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИмяФормыВыбораПоСсылке(Ссылка)
	Возврат Ссылка.Метаданные().ПолноеИмя() + ".ФормаВыбора";
КонецФункции

#КонецОбласти