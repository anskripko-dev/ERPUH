#Область ОбработчикиСобытийФормы    

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьТипыДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыИСпискаЗначенийФормы

&НаКлиенте
Процедура ОбрабатываемыеДокументыДокументНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОбрабатываемыеДокументы.ТекущиеДанные; 
	
	Если ТекущиеДанные.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуВыбораДокумента(ТекущиеДанные.Документ, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбрабатываемыеДокументыДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда 
		
        МассивТипов = Новый Массив;
        МассивТипов.Добавить(ВыбранноеЗначение);
        ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
        ТекущиеДанные = Элементы.ОбрабатываемыеДокументы.ТекущиеДанные;
        ТекущиеДанные.Документ = ОписаниеТипов.ПривестиЗначение();
        СтандартнаяОбработка = Ложь;
        
        ОткрытьФормуВыбораДокумента(ТекущиеДанные.Документ, Элемент);
		
	КонецЕсли; 
	
КонецПроцедуры


#КонецОбласти     

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура ЗаполнитьСписокДокументов(Команда)  
	
	Если Объект.ОбрабатываемыеДокументы.Количество() > 0 Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВопроса_ОчищениеСпискаДокументов", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Список документов будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет); 
	Иначе
		ЗаполнитьСписокДокументовНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовНаСервере()   
	
	ОтмеченныеТипыДокументов = ОбщегоНазначенияКлиентСервер.ОтмеченныеЭлементы(ТипыДокументов);
	Если ОтмеченныеТипыДокументов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Выберите типы документов!");
		Возврат;
	КонецЕсли;
	
	ДополнениеТекстаЗапроса = ДополнениеТекстаЗапроса(ОтмеченныеТипыДокументов, Объект.Период.ДатаНачала, Объект.Период.ДатаОкончания);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СебестоимостьТоваров.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
		|ГДЕ
		|	СебестоимостьТоваров.Активность";
	
	Запрос.Текст = ТекстЗапроса + ДополнениеТекстаЗапроса;
	Запрос.УстановитьПараметр("КонецПериода", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.Период.ДатаНачала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ОбрабатываемыеДокументы.Добавить();
		НоваяСтрока.Документ = Выборка.Регистратор;
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Список документов заполнен."); 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКорректировку(Команда)
	ВыполнитьКорректировкуНаСервере();
КонецПроцедуры

