Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Объект.КонвертироватьФормулыПравилаОбработки = Истина;
	

КонецПроцедуры

&НаКлиенте
Процедура Конвертировать(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПодтверждениеКонвертации", ЭтаФорма);
	ПоказатьВопрос(Оповещение, Нстр("ru = 'Бланк будет сконвертирован в многопериодный формат, обратная конвертация невозможна. Продолжить?'"), РежимДиалогаВопрос.ДаНет);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеКонвертации(Результат, ДополнительныеПараметры) Экспорт
	
	Если  Результат = КодВозвратаДиалога.Да Тогда
		КонвертироватьМакет();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ИсходныйБланкПриИзменении(Элемент)
	
	ОтобразитьТекущийБланк();
	
	
КонецПроцедуры

&НаСервере
Процедура КонвертироватьМакет()

      Обработки.КонвертацияБланковВМногопериодные.КонвертироватьМакетБланка(Объект.ИсходныйБланк,ПолеТабличногоДокументаМакет);

КонецПроцедуры	


&НаСервере
Процедура КонвертироватьМакетБланка()
	
	//Конвертируем ячейки показателей
	Владелец 	= Объект.ИсходныйБланк.Владелец;
	ВладелецКод = СокрЛП(Объект.ИсходныйБланк.Владелец.Код);
	
	Для ИндС = 1 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
		Для ИндК = 1 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			тЯчейка = ПолеТабличногоДокументаМакет.Область(ИндС,ИндК,ИндС,ИндК);
			
			МассивКодов = Новый Массив;
			МассивКодов.Добавить(тЯчейка.Имя);
			СоответствиеСвязей = НастройкиБланкаОтчетаУХ.ПолучитьСтруктуруСсылокНаОбъекты(МассивКодов,Владелец,"Показатель");
			
			Если ТипЗнч(СоответствиеСвязей) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда	
				
				тЯчейка.СодержитЗначение  = Ложь;
				
				тПоказательКод = СокрЛП(СоответствиеСвязей.Код);
				
				тЯчейка.Текст 			 = ВладелецКод +"."+тПоказательКод;
				тЯчейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;	
				тЯчейка.Имя 			 = ПолучитьИмяСледующейОбласти(ПолеТабличногоДокументаМакет,ВладелецКод,тПоказательКод); 
				
				СтруктураРасшифровки = Новый Структура();
				СтруктураРасшифровки.Вставить("Ссылка"			,СоответствиеСвязей);			
				тЯчейка.Расшифровка 	 = СтруктураРасшифровки;
				
			ИначеЕсли  тЯчейка.Имя = "Сценарий" Тогда
				тЯчейка.СодержитЗначение  = Ложь;
				тЯчейка.Текст 	= "[Параметры.Сценарий]";
				тЯчейка.Имя 	= "";
			ИначеЕсли  тЯчейка.Имя = "ПериодОтчета" Тогда
				тЯчейка.СодержитЗначение  = Ложь;
				тЯчейка.Текст 	= "[Параметры.ПериодОтчетаНачало]";
				тЯчейка.Имя 	= "";
			ИначеЕсли  тЯчейка.Имя = "ОсновнаяВалюта" Тогда
				тЯчейка.СодержитЗначение  = Ложь;
				тЯчейка.Текст 	= "[Параметры.Валюта]";
				тЯчейка.Имя 	= "";
			ИначеЕсли  тЯчейка.Имя = "Организация" Тогда	
				тЯчейка.СодержитЗначение  = Ложь;
				тЯчейка.Текст 	= "[Параметры.Организация]";
				тЯчейка.Имя 	= "";
			ИначеЕсли  тЯчейка.Имя = "Проект" Тогда
				тЯчейка.СодержитЗначение  = Ложь;
				тЯчейка.Текст 	= "[Параметры.Проект]";
				тЯчейка.Имя 	= "";	
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;	

	//удаляем все лишние именованные области 
	МассивУдаляемыхОбластей = Новый Массив;
	Для Каждого СтрОбл Из ПолеТабличногоДокументаМакет.Области Цикл
		Если СтрОбл.Верх = 0 Или СтрОбл.Лево = 0 Тогда
			 МассивУдаляемыхОбластей.Добавить(СтрОбл);
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого УдОбл Из МассивУдаляемыхОбластей Цикл
		ПолеТабличногоДокументаМакет.Область(УдОбл.Имя).Имя = "";
	КонецЦикла;	
	
	//Для показателей, у которых есть формулы по текущему правилу обработки сделаем конвертацию операндов первого уровня,если выбрана опция 
	Если Объект.КонвертироватьФормулыПравилаОбработки Тогда
		КонвертироватьФормулыВПоказателиБланка();
	КонецЕсли;
	
	ПроверитьНаличиеСлужебныхОбластей(Истина);
	
	//Сохраняем макет как МП Бланк
	БланкОбъект = Объект.ИсходныйБланк.ПолучитьОбъект();
	БланкОбъект.РежимБланка = 2;
	БланкОбъект.БланкДляОтображения = Истина;
	БланкОбъект.Записать();
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	Обработки.АналитическийБланк.ПрочитатьНастройкиАналитическогоБланка(ПолеТабличногоДокументаМакет,Объект.ИсходныйБланк,ОбъектАБ);	
	ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	Отказ = Ложь;				
	Уид   = Новый УникальныйИдентификатор;
	Справочники.БланкиОтчетов.СохранитьМакетМногопериодногоБланка(Объект.ИсходныйБланк,ПолеТабличногоДокументаМакет,ОбъектАБ,Уид,Отказ);

	ТекстСообщения = НСтр("ru = 'Бланк успешно сконвертирован'");
	Сообщить(ТекстСообщения);

	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяСледующейОбласти(ПолеТабличногоДокументаМакет_,ВидОтчета,ПоказательКод)
		
	ТекущееИмя = "ВидОтчета_"+ВидОтчета +"_Показатель_"+ПоказательКод+"_ИндексЯчейки";
	
	ИндексОбласти = 1;
	
	Пока НЕ ПолеТабличногоДокументаМакет_.Области.Найти(ТекущееИмя) = Неопределено Цикл
		ТекущееИмя = "ВидОтчета_"+ВидОтчета +"_Показатель_"+ПоказательКод+"_ИндексЯчейки"+ИндексОбласти;
		ИндексОбласти = ИндексОбласти+1;
	КонецЦикла;	
	
	Возврат ТекущееИмя;
		
КонецФункции

&НаСервере
Процедура ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ)
		
	ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Очистить();
	ОбъектАБ.КэшТаблицРаскрываемыхОбластей.Очистить();
	ОбъектАБ.НастройкиТаблицРаскрываемыхОбластей.Очистить();
	
	Для Каждого облРаскрытия Из ОбъектАБ.КэшРаскрываемыхОбластей Цикл			
		ОбластьРаскрытия =  ПолеТабличногоДокументаМакет.Области.Найти(облРаскрытия.ИмяОбласти);		
		ФлВключенияОбласти = Истина;	
		Если Не ОбластьРаскрытия = Неопределено Тогда	
			
			облРаскрытия.Лево = ОбластьРаскрытия.Лево;
			облРаскрытия.Верх = ОбластьРаскрытия.Верх;
			
			//Строки
			Если ОбластьРаскрытия.Лево=0 Тогда		
				Для Каждого ОбластьДляПроверки Из ОбъектАБ.КэшРаскрываемыхОбластей Цикл	
					тОбласть = ПолеТабличногоДокументаМакет.Области.Найти(ОбластьДляПроверки.ИмяОбласти);
					Если тОбласть.Верх<ОбластьРаскрытия.Верх И тОбласть.Низ>=ОбластьРаскрытия.Низ Тогда
						ФлВключенияОбласти = Ложь; Прервать; 	
					КонецЕсли;				
				КонецЦикла;				
				Если ФлВключенияОбласти Тогда
					НобластьКэша = ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Добавить();
					ЗаполнитьЗначенияСвойств(НобластьКэша,облРаскрытия);
					НобластьКэша.Низ =  ОбластьРаскрытия.Низ;
					НобластьКэша.Лево = 9999;		
				КонецЕсли;
			КонецЕсли;		
			//Колонки
			Если ОбластьРаскрытия.Верх=0 Тогда		
				Для Каждого ОбластьДляПроверки Из ОбъектАБ.КэшРаскрываемыхОбластей Цикл
					тОбласть = ПолеТабличногоДокументаМакет.Области.Найти(ОбластьДляПроверки.ИмяОбласти);
					//Если область имеет область - родителя, то игнорируем ее 
					Если тОбласть.Лево<ОбластьРаскрытия.Лево И тОбласть.Право>=ОбластьРаскрытия.Право Тогда
						ФлВключенияОбласти = Ложь; Прервать;						
					КонецЕсли;				
				КонецЦикла;			
				Если ФлВключенияОбласти Тогда
					НобластьКэша = ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Добавить();
					ЗаполнитьЗначенияСвойств(НобластьКэша,облРаскрытия);
					НобластьКэша.Право =  ОбластьРаскрытия.Право;
					НобластьКэша.Верх = 9999;
				КонецЕсли;
			КонецЕсли;		
		КонецЕсли;						
	КонецЦикла;	
	
	
	
	
	//Готовим области таблиц
	тСтроки 	= ОбъектАБ.КэшРаскрываемыхОбластей.НайтиСтроки(Новый Структура("Лево",0));
	тКолонки 	= ОбъектАБ.КэшРаскрываемыхОбластей.НайтиСтроки(Новый Структура("Верх",0));
		
	Для Каждого тСтрока Из тСтроки Цикл	
		сНастройкиАналитикРаскрытия = ЗначениеИзСтрокиВнутр(тСтрока.НастройкиАналитикРаскрытия);
		тНастройкиАналитикРаскрытия = сНастройкиАналитикРаскрытия.СкопироватьКолонки();
		тОбластьСтрока              = ПолеТабличногоДокументаМакет.Область(тСтрока.ИмяОбласти);
		
		Для Каждого строкаАналитики Из сНастройкиАналитикРаскрытия Цикл
			тстрокаАналитики = тНастройкиАналитикРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(тСтрокаАналитики,строкаАналитики);
		КонецЦикла;	
		Для Каждого тКолонка Из тКолонки Цикл	
			
		    тОбластьКолонка              = ПолеТабличногоДокументаМакет.Область(тКолонка.ИмяОбласти);
			
			кНастройкиАналитикРаскрытия = ЗначениеИзСтрокиВнутр(тКолонка.НастройкиАналитикРаскрытия);
			Для Каждого строкаАналитики Из кНастройкиАналитикРаскрытия Цикл
				тстрокаАналитики = тНастройкиАналитикРаскрытия.Добавить();
				ЗаполнитьЗначенияСвойств(тСтрокаАналитики,строкаАналитики);
			КонецЦикла;			
			нТаблица = ОбъектАБ.КэшТаблицРаскрываемыхОбластей.Добавить();
			нТаблица.УидГруппыОтборов =СтрЗаменить(Новый УникальныйИдентификатор,"-","");
			нТаблица.Лево 	= тОбластьКолонка.Лево;
			нТаблица.Право 	= тОбластьКолонка.Право;
			нТаблица.Верх 	= тОбластьСтрока.Верх;
			нТаблица.Низ 	= тОбластьСтрока.Низ;
			нТаблица.ИмяОбластиСтрок 	= тСтрока.ИмяОбласти;
			нТаблица.ИмяОбластиКолонок = тКолонка.ИмяОбласти;
			нТаблица.НастройкиАналитикРаскрытия = ЗначениеВСтрокуВнутр(тНастройкиАналитикРаскрытия);	
			нТаблица.ИмяОбласти           =  ПолеТабличногоДокументаМакет.Область(нТаблица.Верх,нТаблица.Лево,нТаблица.Низ,нТаблица.Право).Имя;
			
			ОтборРаскрываемойОбластиСтроки  = ОбъектАБ.НастройкиРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов",тСтрока.УидГруппыОтборов));
			ОтборРаскрываемойОбластиКолонки = ОбъектАБ.НастройкиРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов",тКолонка.УидГруппыОтборов));
			
			Для Каждого СтрокаОтбор Из ОтборРаскрываемойОбластиСтроки Цикл
				нОтбор = ОбъектАБ.НастройкиТаблицРаскрываемыхОбластей.Добавить();
				ЗаполнитьЗначенияСвойств(нОтбор,СтрокаОтбор);
				нОтбор.УидГруппыОтборов = нТаблица.УидГруппыОтборов;
			Конеццикла;
			
			Для Каждого СтрокаОтбор Из ОтборРаскрываемойОбластиКолонки Цикл
				нОтбор = ОбъектАБ.НастройкиТаблицРаскрываемыхОбластей.Добавить();
				ЗаполнитьЗначенияСвойств(нОтбор,СтрокаОтбор);
				нОтбор.УидГруппыОтборов = нТаблица.УидГруппыОтборов;
			Конеццикла;

			
		КонецЦикла;		
	КонецЦикла;	
			
   ОбъектАБ.КэшВыводаОбластейМакета.Очистить();	
   Лево =1;
   Верх =1;
   
   ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Сортировать("Верх,Лево");
   КолонкиРаскрытия 	= ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Выгрузить(Новый Структура("Верх",9999));
   СтрокиРаскрытия		= ОбъектАБ.КэшРаскрываемыхОбластейСгруппированный.Выгрузить(Новый Структура("Лево",9999));
   
   нКол  		= КолонкиРаскрытия.Добавить();
   Нкол.Лево    = ПолетабличногоДокументаМакет.ШиринаТаблицы+1;
   Нкол.ИмяОбласти = "МаркерОкончания";
   
   Низ 		= ПолетабличногоДокументаМакет.ВысотаТаблицы;   
   нСтрока  = СтрокиРаскрытия.Добавить();
   нСтрока.Верх    = ПолетабличногоДокументаМакет.ВысотаТаблицы+1;
   нСтрока.ИмяОбласти = "МаркерОкончания";
   
   
   //Для Каждого СтрокаМакета Из  СтрокиРаскрытия Цикл	      
   //    //Между областями есть 'свободные' колонки
   //    Если Верх<>СтрокаМакета.Верх  Тогда   
   // 	   ЗаполнитьКэшВыводаОбластейМакета(ПолеТабличногоДокументаМакет,ОбъектАБ,КолонкиРаскрытия,Верх,СтрокаМакета.Верх,Лево,"Синтетика");
   //    КонецЕсли;
   //    Если СтрокаМакета.ИмяОбласти = "МаркерОкончания" Тогда
   // 	   Продолжить;
   //    КонецЕсли;		   
   //    ЗаполнитьКэшВыводаОбластейМакета(ПолеТабличногоДокументаМакет,ОбъектАБ,КолонкиРаскрытия,СтрокаМакета.Верх,СтрокаМакета.Низ,Лево,"Строки",СтрокаМакета.УидГруппыОтборов);	   
   //    Верх 	        = ?(ПолетабличногоДокументаМакет.ВысотаТаблицы =СтрокаМакета.Низ,ПолетабличногоДокументаМакет.ВысотаТаблицы+1,СтрокаМакета.Низ+1);	   
   //КонецЦикла;	   
    
   
КонецПроцедуры	

&НаСервере
Процедура ОтобразитьТекущийБланк()
	
	ПолеТабличногоДокументаМакет.Очистить();
	тМакет = Объект.ИсходныйБланк.Макет.Получить();
	Если НЕ тМакет = Неопределено Тогда
		ПолеТабличногоДокументаМакет.Вывести(тМакет);
	КонецЕсли;	
	
		
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьФормулы(Команда)
	
	КонвертироватьФормулыВПоказателиБланка();
	
КонецПроцедуры

&НаСервере
Процедура КонвертироватьФормулыВПоказателиБланка()
	
	Для ИндС = 1 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
		Для ИндК = 1 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			тЯчейка = ПолеТабличногоДокументаМакет.Область(ИндС,ИндК,ИндС,ИндК);
			Если ТипЗнч(тЯчейка.Расшифровка) = Тип("Структура") И тЯчейка.Расшифровка.Свойство("Ссылка") Тогда
				
				СоответствиеСвязей = тЯчейка.Расшифровка.Ссылка;
				
				Если ТипЗнч(СоответствиеСвязей) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
					ТекстПроцедурыРасчета = "";
					Операнды =   ПолучитьОперандыПоказателей(СоответствиеСвязей,Объект.ИсходныйБланк.Владелец,ПравилоОбработки,ТекстПроцедурыРасчета);
					Если ЗначениеЗаполнено(ТекстПроцедурыРасчета) И Операнды.Количество()>0 Тогда
						//Создадим формулу						
						тЯчейка.СодержитЗначение  = Ложь;
						тЯчейка.Имя 			  = "Формула_"+СтрЗаменить(Новый УникальныйИдентификатор,"-","");;	
						СтруктураРасшифровки = Новый Структура;
						
						тРасшифровкаФормулОбластейПоказателей = ОбъектАналитическогоБланка.РасшифровкаФормулОбластейПоказателей.Выгрузить();
						тРасшифровкаФормулОбластейПоказателей.Очистить();
						тРасшифровка = тРасшифровкаФормулОбластейПоказателей.СкопироватьКолонки("Показатель,ИмяВФормуле,ИндексПоказателя");	
						тТекстФормулы = "";
						
						
						КонвертироватьФормулу(тТекстФормулы,ТекстПроцедурыРасчета,Операнды,тРасшифровка);
						
						тЯчейка.Текст 			 = тТекстФормулы;
						
						СтруктураРасшифровки.Вставить("ТекстФормулы",		тТекстФормулы);
						СтруктураРасшифровки.Вставить("РасшифровкаФормулы",	ЗначениеВСтрокуВнутр(тРасшифровка));
						
						тЯчейка.Расшифровка 	 = СтруктураРасшифровки;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьОперандыПоказателей(Показатель,ВидОтчета,ПравилоОбработки,ТекстПроцедурыРасчета) Экспорт

	ЧислоАналитик = 5;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		           |	ПоказателиОтчетов.Владелец КАК ВидОтчета,
		           |	ПоказателиОтчетов.Ссылка КАК Показатель,
		           |	ОперандыПоказателей.НазначениеРасчетов КАК ПравилоОбработки,
				   |	ОперандыПоказателей.Ссылка.Код КАК КодОперанда,
				   |	ОперандыПоказателей.ПоказательОтбор.Код КАК ПоказательКод,
				   |	ОперандыПоказателей.ПоказательОтбор КАК ПоказательСсылка,
				   |	ОперандыПоказателей.ПоказательОтбор.Владелец.Код КАК ВладелецКод,
				   |	ОперандыПоказателей.Ссылка КАК Операнд";
	Для Инд = 1 По ЧислоАналитик Цикл
		ТекстЗапроса = ТекстЗАпроса + "
		|, ПоказателиОтчетов.Ссылка.ГруппаРаскрытия.ВидАналитики" + Инд + " КАК ВидАналитики" + Инд;
	КонецЦикла;
		ТекстЗапроса = ТекстЗапроса + "
		               |ИЗ
		               |	Справочник.ИсточникиДанныхДляРасчетов КАК ОперандыПоказателей
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		               |		ПО ОперандыПоказателей.ПоказательОтбор = ПоказателиОтчетов.Ссылка
		               |ГДЕ
		               |	ОперандыПоказателей.НазначениеРасчетов = &ПравилоОбработки
					   |	И (НЕ ОперандыПоказателей.ПометкаУдаления)
		               |	И ОперандыПоказателей.ПотребительРасчета = &Показатель
		               |	И ОперандыПоказателей.НеИспользуется = ЛОЖЬ
					   |	И (НЕ ПоказателиОтчетов.ПометкаУдаления)";
	
	мТаблицаПоказателей = Новый ТаблицаЗначений;
	мТаблицаПоказателей.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("Операнд", Новый ОписаниеТипов("СправочникСсылка.ИсточникиДанныхДляРасчетов"));
	мТаблицаПоказателей.Колонки.Добавить("ВидОтчета", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
	мТаблицаПоказателей.Колонки.Добавить("ПравилоОбработки", Новый ОписаниеТипов("СправочникСсылка.ПравилаОбработки"));
	мТаблицаПоказателей.Колонки.Добавить("ПоказателиПредшественники", Новый ОписаниеТипов("ТаблицаЗначений"));
	мТаблицаПоказателей.Колонки.Добавить("УровеньХ");
	мТаблицаПоказателей.Колонки.Добавить("КоличествоПредшественников");
	мТаблицаПоказателей.Колонки.Добавить("УникальныйИдентификатор");
	мТаблицаПоказателей.Колонки.Добавить("ПоказательДругогоСреза", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	мТаблицаПоказателей.Колонки.Добавить("Ошибка", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
		
	Для Инд = 1 По ЧислоАналитик Цикл
		мТаблицаПоказателей.Колонки.Добавить("ВидАналитики" + Инд);
	КонецЦикла;
	
	НоваяСтрока = мТаблицаПоказателей.Добавить();
	НоваяСтрока.Родитель         		  = Неопределено;
	НоваяСтрока.Показатель       		  = Показатель;
	НоваяСтрока.ВидОтчета        		  = ВидОтчета;
	
	Для Инд = 1 По ЧислоАналитик Цикл
		НоваяСтрока["ВидАналитики" + Инд] = Показатель.ГруппаРаскрытия["ВидАналитики" + Инд];
	КонецЦикла;

	НоваяСтрока.ПравилоОбработки 		  = ПравилоОбработки;
	НоваяСтрока.УникальныйИдентификатор   = Новый УникальныйИдентификатор();
	НоваяСтрока.ПоказателиПредшественники = Новый ТаблицаЗначений;
	НоваяСтрока.Операнд					  = Справочники.ИсточникиДанныхДляРасчетов.ПустаяСсылка();
	НоваяСтрока.Ошибка                    = Ложь;
	НоваяСтрока.ПоказателиПредшественники.Колонки.Добавить("УникальныйИдентификатор");
	
	МассивПоказателей  = Новый Массив;
	МассивПоказателей.Добавить(НоваяСтрока.УникальныйИдентификатор);
	
	Запрос = Новый Запрос;
	Запрос.Текст =  ТекстЗапроса;
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	Запрос.УстановитьПараметр("Показатель",Показатель);
	
	ЗапросПроцедура			 = Новый Запрос;
	ЗапросПроцедура.Текст 	 = 
	"ВЫБРАТЬ
	|	ПроцедурыРасчетов.ПотребительРасчета КАК ПотребительРасчета,
	|	ПроцедурыРасчетов.Процедура КАК Процедура,
	|	ПроцедурыРасчетов.ПроизвольныйКод КАК ПроизвольныйКод,
	|	ПроцедурыРасчетов.ПересчитыватьПриОткрытии КАК ПересчитыватьПриОткрытии,
	|	ПроцедурыРасчетов.РедактированиеВозможно КАК РедактированиеВозможно
	|ИЗ
	|	РегистрСведений.ПроцедурыРасчетов КАК ПроцедурыРасчетов
	|ГДЕ
	|	ПроцедурыРасчетов.НазначениеРасчетов = &ПравилоОбработки
	|	И ПроцедурыРасчетов.ПотребительРасчета = &ПотребительРасчета";

	ЗапросПроцедура.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	ЗапросПроцедура.УстановитьПараметр("ПотребительРасчета",Показатель);
	
	Результат = ЗапросПроцедура.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		ТекстПроцедурыРасчета =   Выборка.Процедура;
		Возврат Запрос.Выполнить().Выгрузить(); 
	КонецЦикла;
	
	Возврат Неопределено;
		
	
КонецФункции

&НаСервере
Процедура КонвертироватьФормулу(тТекстФормулы,ТекстПроцедурыРасчета,Операнды,тРасшифровка)
	
	тТекстФормулы = ТекстПроцедурыРасчета;
	
	Для Каждого СтрОперанд Из Операнды Цикл	
		тПоказательКод = СокрЛП(СтрОперанд.ПоказательКод);
		тВладелецКод   = СокрЛП(СтрОперанд.ВладелецКод);	
		ТекстОперанда  = тВладелецКод +"."+тПоказательКод;	
		тТекстФормулы = СтрЗаменить(тТекстФормулы,СокрЛП(СтрОперанд.КодОперанда),ТекстОперанда);	
		Нстр 					= тРасшифровка.Добавить();
		Нстр.Показатель   		= СтрОперанд.ПоказательСсылка;
		Нстр.ИмяВФормуле  		= ТекстОперанда;		
	Конеццикла;	
	
	
КонецПроцедуры	
	

&НаСервере
Процедура ПроверитьНаличиеСлужебныхОбластей(ТихийРежим = Ложь)
	
	МакетСлужебныхОбластей = Справочники.БланкиОтчетов.ПолучитьМакет("ШаблонСлужебныхОбластей");
	
	Если НЕ ПолеТабличногоДокументаМакет.Область(1,0,1,0).Имя =  "ОбластьНастроекРаскрытийКолонок" Тогда
		
		ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийКолонок");
		ОбластьПриемник = ПолеТабличногоДокументаМакет.Область(1,0,1,0);
		ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоВертикали);
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Добавлена служебная область, содержащая настройки раскрытий колонок'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;	
		
	Если НЕ ПолеТабличногоДокументаМакет.Область(0,1,0,1).Имя =  "ОбластьНастроекРаскрытийСтрок" Тогда
		
		ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийСтрок");
		ОбластьПриемник = ПолеТабличногоДокументаМакет.Область(0,1,0,1);
		ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Добавлена служебная область, содержащая настройки раскрытий строк'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры



&НаКлиенте
Процедура КонвертироватьФормулыПравилаОбработкиПриИзменении(Элемент)
	

КонецПроцедуры

