&НаКлиенте
Процедура ДеревоОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	МассивСтрок = ВыбранныеСтроки();
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДеревоОперацииСостояние" И НЕ ПериодЗакрыт Тогда
		
		ОписаниеОЗакрытии = Новый ОписаниеОповещения("ВыборСостоянияОтчетаЗавершение", ЭтотОбъект, МассивСтрок);
		ОткрытьФорму("Перечисление.СостоянияОтчетов.ФормаВыбора", , , , , , ОписаниеОЗакрытии);
		
	ИначеЕсли МассивСтрок.Количество() = 1 Тогда
		
		// Открываем документ, если он создан
		Если ЗначениеЗаполнено(МассивСтрок.Получить(0).Документ) Тогда
			ПоказатьЗначение(, МассивСтрок.Получить(0).Документ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСостоянияОтчетаЗавершение(ВыбранноеЗначение, МассивСтрок) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
			Если ТекущаяСтрока.Согласуется Тогда
				УправлениеПроцессамиСогласованияУХ.ПеревестиЗаявкуВПроизвольноеСостояние(ТекущаяСтрока.Документ, ВыбранноеЗначение);
			Иначе
				ТекстСообщения = НСтр("ru = 'Документ ""%1"" не согласуется. Используйте Проведение / Отмену проведения документа.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекущаяСтрока.Документ);
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
		КонецЦикла;
		
		СформироватьОтчет();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СогласоватьДокумент(Команда)

	СписокДокументов = Новый СписокЗначений;
	
	МассивСтрок = ВыбранныеСтроки();
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		Если ТекущаяСтрока.Согласуется Тогда
			СписокДокументов.Добавить(ТекущаяСтрока.Документ);
		Иначе
			ТекстСообщения = НСтр("ru = 'Документ ""%1"" не согласуется. Используйте Проведение / Отмену проведения документа.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекущаяСтрока.Документ);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("СогласоватьДокументЗавершение", ЭтаФорма);
	
	Если СписокДокументов.Количество() = 1 Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("СогласовываемыйДокумент", СписокДокументов.Получить(0).Значение);
	Иначе
		СтруктураПараметров = УправлениеПроцессамиСогласованияУХ.СформироватьСтруктуруОткрытияФормыВизированияПакетаДокументов(СписокДокументов);
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.КомментарийИСогласование", СтруктураПараметров, ЭтаФорма, , , , ОписаниеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура СогласоватьДокументЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		СформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьКСогласованию(Команда)
	
	МассивСтрок = ВыбранныеСтроки();
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПринятьКСогласованиюНаСервере(МассивСтрок);
	СформироватьОтчет();
	
КонецПроцедуры

&НаСервере
Процедура ПринятьКСогласованиюНаСервере(МассивСтрок)
	
	СписокУтвержден = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		Если ТекущаяСтрока.Согласуется Тогда
			// Проверим, можно ли отправить документ на согласование
			Согласующий = МодульУправленияПроцессамиУХ.ПолучитьОтветственногоЗаТипОбъекта(ТекущаяСтрока.Документ, , , , "Согласующий");;
			Если ЗначениеЗаполнено(Согласующий) Тогда
				// Отправляем на согласование
				МодульУправленияПроцессамиУХ.ПринятьКОбработке(, ТекущаяСтрока.Документ);
			Иначе
				// Нет согласующего, добавим в список для утверждения вручную
				СписокУтвержден.Добавить(ТекущаяСтрока.Документ);
			КонецЕсли;
		Иначе
			// Проведем документ
			ДокументОбъект = ТекущаяСтрока.Документ.ПолучитьОбъект();
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Не удалось провести документ ""%1"", по причине: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекущаяСтрока.Документ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Установим состояние Утвержден для всех документов из списка Утвержден
	Если СписокУтвержден.Количество() > 0 Тогда
		СтруктураОбработки = Новый Структура;
		СтруктураОбработки.Вставить("Состояние", Перечисления.СостоянияОтчетов.Утвержден);
		МодульУправленияПроцессамиУХ.ИзменитьСостояниеОбъектовПроцесса(СписокУтвержден, СтруктураОбработки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСогласование(Команда)
	
	МассивСтрок = ВыбранныеСтроки();
	Если МассивСтрок.Количество() = 0 Тогда
