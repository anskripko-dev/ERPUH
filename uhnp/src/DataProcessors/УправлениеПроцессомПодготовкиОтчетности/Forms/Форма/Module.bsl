&НаКлиенте
Процедура ОбработатьТекущийЭтапНаКлиенте(Действие, ПоДеревуОпераций = Ложь)
	
	ОчиститьСообщения();
	
	// Проверим состояние процесса
	Если НЕ ПроцессЗапущен Тогда
		// Процесс не запущен, предложим запустить
		ТекстВопроса = НСтр("ru = 'Продолжение операции невозможно, так как процесс не запущен. Запустить процесс?'");
		Оповещение = Новый ОписаниеОповещения("ЗапуститьПроцессПослеВопроса", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;
	
	// Формирование параметров создания
	МассивРасшифровок = РасшифровкиОтчета(ПоДеревуОпераций);
	// Непосредственная обработка
	Если ИспользоватьМногопоточностьДляЗаполненияОтчетности И МассивРасшифровок.Количество() > 0 Тогда
		ПараметрыФормы = Новый Структура;
		МассивПараметровОбработкиЭтапов = Новый Массив;
		Для Каждого Расшифровка Из МассивРасшифровок Цикл
			ПараметрыРасшифровки = Новый Соответствие;
			ЗаполнитьЗначенияСвойств(ПараметрыОбработкиЭтапов, Расшифровка);
			ПараметрыРасшифровки.Вставить("ПараметрыОбработкиЭтапов", ПараметрыОбработкиЭтапов);
			ПараметрыРасшифровки.Вставить("Действие", Действие);
			МассивПараметровОбработкиЭтапов.Добавить(ПараметрыРасшифровки);
		КонецЦикла;
		ПараметрыФормы.Вставить("МассивПараметровОбработкиЭтапов", МассивПараметровОбработкиЭтапов);
		ПараметрыФормы.Вставить("Действие", Действие);
		ПараметрыФормы.Вставить("ВыводитьПрогрессВыполнения", Истина);
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыполненияОбработкиЭтапов", ЭтаФорма, Новый Структура("Результат", Неопределено));
		ОткрытьФорму(
			"Обработка.УправлениеПроцессомПодготовкиОтчетности.Форма.ДлительнаяОперация",
			ПараметрыФормы,
			ЭтотОбъект,
			УникальныйИдентификатор,
			,
			,
			ОписаниеОповещенияОЗакрытии);
		Возврат;
	КонецЕсли;
	Для Каждого Расшифровка Из МассивРасшифровок Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОбработкиЭтапов, Расшифровка);
		ОбработатьТекущийЭтапНаСервере(ПараметрыОбработкиЭтапов, Действие);
		СформироватьОтчет();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияОбработкиЭтапов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Для Каждого Стр Из Результат Цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(Стр);
		КонецЦикла;
		СформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОрганизацииЭтапаРекурсивно(СтрокиДерева, МассивОрганизаций)
	
	Для Каждого СтрокаДерева Из СтрокиДерева.ПолучитьЭлементы() Цикл
		Если СтрокаДерева.Этап = ТекущийЭтап
			И ЗначениеЗаполнено(СтрокаДерева.Организация)
			И МассивОрганизаций.Найти(СтрокаДерева.Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(СтрокаДерева.Организация);
		КонецЕсли;
		ДобавитьОрганизацииЭтапаРекурсивно(СтрокаДерева, МассивОрганизаций);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
