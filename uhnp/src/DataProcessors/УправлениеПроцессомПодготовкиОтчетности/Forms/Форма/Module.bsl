
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УправлениеПериодом", УправлениеПериодом);
	
	ЧислоДопАналитик = ПараметрыСеанса.ЧислоДопАналитик;
	
	ЗаполнитьПараметрыДиаграммы();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если ЗначениеЗаполнено(УправлениеПериодом) Тогда
		Если УправлениеПериодом <> Настройки.Получить("УправлениеПериодом") Тогда
			Настройки.Удалить("УправлениеПериодом");
			ДанныеМодифицированы = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ДанныеМодифицированы Тогда
		СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	КонецЕсли;
	
	Если ТекущаяСтраницаДеревоЭтапов Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДеревоЭтапов;
	КонецЕсли;

	УстановитьНастройкиПоУОП();
	УправлениеВидимостью();
	СформироватьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если СтрНачинаетсяС(ИмяСобытия, "ИзмененОбъектОтчетности") Тогда
		
		СформироватьОтчет();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущаяСтраницаДеревоЭтапов = Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДеревоЭтапов;
	ТекущаяОрганизация = Неопределено;
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаПриАктивизации(Элемент)
	
	Если ТекущаяСтраницаДеревоЭтапов Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Диаграмма.ТекущаяОбласть.Расшифровка;
	Если ТекДанные <> Неопределено Тогда
		ТекущийЭтап = ТекДанные.Этап;
	КонецЕсли;
	ВывестиОтчетПоОперациям();
	
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Расшифровка.Этап);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтапыПриАктивизацииСтроки(Элемент)
	
	Если НЕ ТекущаяСтраницаДеревоЭтапов Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ДеревоЭтапы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийЭтап = Неопределено;
		ТекущаяОрганизация = Неопределено;
	Иначе
		ТекущийЭтап = ТекДанные.Этап;
		ТекущаяОрганизация = ТекДанные.Организация;
		ВывестиОтчетПоОперациям();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтапыПередРазворачиванием(Элемент, Строка, Отказ)
	
	Если ДеревоЭтапыВводНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	// Запомним развернутую строку
	ТекущаяСтрокаДерева = ДеревоЭтапы.НайтиПоИдентификатору(Строка);
	Если ТекущаяСтрокаДерева <> Неопределено Тогда
		Если ДеревоЭтапыРазвернутыеСтроки.НайтиПоЗначению(ТекущаяСтрокаДерева.ЭтапОрганизация) = Неопределено Тогда
			ДеревоЭтапыРазвернутыеСтроки.Добавить(ТекущаяСтрокаДерева.ЭтапОрганизация);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтапыПередСворачиванием(Элемент, Строка, Отказ)
	
	Если ДеревоЭтапыВводНаСервере Тогда
		Возврат;
	КонецЕсли;
	
	// Удалим развернутую строку
	ТекущаяСтрокаДерева = ДеревоЭтапы.НайтиПоИдентификатору(Строка);
	Если ТекущаяСтрокаДерева <> Неопределено Тогда
		ТекущаяСтрокаСписка = ДеревоЭтапыРазвернутыеСтроки.НайтиПоЗначению(ТекущаяСтрокаДерева.ЭтапОрганизация);
		Если ТекущаяСтрокаСписка <> Неопределено Тогда
			ДеревоЭтапыРазвернутыеСтроки.Удалить(ТекущаяСтрокаСписка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОперацииПриАктивизацииСтроки(Элемент)
	
	ИнициализироватьПустуюСтрокуОпераций();
	
	ТекДанные = Элементы.ДеревоОперации.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекущаяСтрокаОперации, ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда = Неопределено)
	
	Если ТекущаяСтраницаДеревоЭтапов Тогда
		
		ДеревоЭтапыВводНаСервере = Истина;
		
		// Развернем необходимые строки этапов
		мИдентификаторыРазвернутыхСтрок = ВывестиОтчетНаСервере();
		Для Каждого ИдентификаторСтроки Из мИдентификаторыРазвернутыхСтрок Цикл
			Элементы.ДеревоЭтапы.Развернуть(ИдентификаторСтроки);
		КонецЦикла;
		
		ДеревоЭтапыВводНаСервере = Ложь;
		
	Иначе
		ВывестиОтчетНаСервере();
		ВывестиОтчетПоОперациям();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеПериодомПриИзменении(Элемент)
	
	УстановитьНастройкиПоУОП();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	СформироватьОтчет(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроцесс(Команда = Неопределено)
	
	Оповещение = Новый ОписаниеОповещения("ЗапуститьПроцессПослеВопроса", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Запустить процесс подготовки отчетности?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьПроцесс(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОстановитьПроцессПослеВопроса", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Остановить процесс подготовки отчетности?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьСообщения(Команда)
	
	ВыводитьСообщения = Не ВыводитьСообщения;
	ПараметрыОбработкиЭтапов.ВыводитьСообщения = ВыводитьСообщения;
	УправлениеВидимостью();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьДеревоОпераций(Команда)
	
	ПоказыватьДеревоОпераций = НЕ ПоказыватьДеревоОпераций;
	УправлениеВидимостью();
	
	ВывестиОтчетПоОперациям();
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	ЭлементыДереваОрганизаций = ДеревоЭтапы.ПолучитьЭлементы();
	Для Каждого ТекЭлементыДереваОрганизаций Из ЭлементыДереваОрганизаций Цикл 
		ТекИдентификатор = ТекЭлементыДереваОрганизаций.ПолучитьИдентификатор();
		Элементы.ДеревоЭтапы.Свернуть(ТекИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	ЭлементыДереваОрганизаций = ДеревоЭтапы.ПолучитьЭлементы();
	Для Каждого ТекЭлементыДереваОрганизаций Из ЭлементыДереваОрганизаций Цикл 
		ТекИдентификатор = ТекЭлементыДереваОрганизаций.ПолучитьИдентификатор();
		Элементы.ДеревоЭтапы.Развернуть(ТекИдентификатор, Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСпособПоАлфавиту(Команда)
	
	СортировкаПоАлфавиту = Истина;
	УправлениеВидимостью();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСпособПоУмолчанию(Команда)
	
	СортировкаПоАлфавиту = Ложь;
	УправлениеВидимостью();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПоЭтапам(Команда)
	
	ОтображатьПоОрганизациям = Ложь;
	УправлениеВидимостью();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПоОрганизациям(Команда)
	
	ОтображатьПоОрганизациям = Истина;
	УправлениеВидимостью();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьТолькоАктуальные(Команда)
	
	ОтображатьТолькоАктуальные = НЕ ОтображатьТолькоАктуальные;
	УправлениеВидимостью();
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсеОперации(Команда)
	
	ЭлементыДеревоОперации = ДеревоОперации.ПолучитьЭлементы();
	Для Каждого ТекЭлементыДеревоОперации Из ЭлементыДеревоОперации Цикл 
		ТекИдентификатор = ТекЭлементыДеревоОперации.ПолучитьИдентификатор();
		Элементы.ДеревоОперации.Свернуть(ТекИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеОперации(Команда = Неопределено)
	
	ЭлементыОперации = ДеревоОперации.ПолучитьЭлементы();
	Для каждого ТекЭлементыОперации Из ЭлементыОперации Цикл
		ТекИдентификаторСтроки = ТекЭлементыОперации.ПолучитьИдентификатор();
		Элементы.ДеревоОперации.Развернуть(ТекИдентификаторСтроки, Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

#Область ФормированиеОтчета

&НаСервере
Функция ВывестиОтчетНаСервере()
	
	Если ТекущаяСтраницаДеревоЭтапов Тогда
		ДеревоЭтапы.ПолучитьЭлементы().Очистить();
	Иначе
		Диаграмма.Очистить();
	КонецЕсли;
	ДеревоОперации.ПолучитьЭлементы().Очистить();
	
	мИдентификаторыРазвернутыхСтрок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(УправлениеПериодом) Тогда
		Возврат мИдентификаторыРазвернутыхСтрок;
	КонецЕсли;
	
	ПараметрыОбработкиЭтапов.Этап = Неопределено;
	ПараметрыОбработкиЭтапов.Организация = Организация;
	ПараметрыОбработкиЭтапов.ДополнительныеОтборы = Новый Структура;
	Запрос = УправлениеПроцессамиПодготовкиОтчетности.ЗапросПоДаннымЭтапов(ПараметрыОбработкиЭтапов);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.Уровень КАК Уровень,
		|	ДанныеЭтапов.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ДанныеЭтапов.ДлительностьПлановая КАК ДлительностьПлановая
		|ПОМЕСТИТЬ втВсеЭтапы
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеЭтапы.Уровень КАК Уровень,
		|	МАКСИМУМ(ВсеЭтапы.ДлительностьПлановая) КАК ДлительностьПлановая
		|ПОМЕСТИТЬ втДлительностьУровнейЭтапов
		|ИЗ
		|	втВсеЭтапы КАК ВсеЭтапы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеЭтапы.Уровень
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеЭтапы.Этап КАК Этап,
		|	СУММА(ЕСТЬNULL(ДлительностьУровнейЭтапов.ДлительностьПлановая, 0)) + МАКСИМУМ(ВсеЭтапы.ДлительностьПлановая) КАК ДлительностьПлановая
		|ПОМЕСТИТЬ втДлительностьЭтапов
		|ИЗ
		|	втВсеЭтапы КАК ВсеЭтапы
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДлительностьУровнейЭтапов КАК ДлительностьУровнейЭтапов
		|		ПО ВсеЭтапы.Уровень > ДлительностьУровнейЭтапов.Уровень
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеЭтапы.Этап
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ДанныеЭтапов.Уровень) КАК Уровень
		|ПОМЕСТИТЬ втУровниАктуальныхЭтапов
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|ГДЕ
		|	ДанныеЭтапов.СостояниеЭтапа <> ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.ПорядковыйНомер КАК ПорядковыйНомер
		|ПОМЕСТИТЬ втАктуальныеЭтапы
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втУровниАктуальныхЭтапов КАК УровниАктуальныхЭтапов
		|		ПО ДанныеЭтапов.Уровень = УровниАктуальныхЭтапов.Уровень
		|			И (ДанныеЭтапов.СостояниеЭтапа <> ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(АктуальныеЭтапы.ПорядковыйНомер) КАК ПорядковыйНомер
		|ПОМЕСТИТЬ втПорядокАктуальногоЭтапа
		|ИЗ
		|	втАктуальныеЭтапы КАК АктуальныеЭтапы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеЭтапы.Этап КАК Этап
		|ПОМЕСТИТЬ втАктуальныйЭтап
		|ИЗ
		|	втВсеЭтапы КАК ВсеЭтапы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПорядокАктуальногоЭтапа КАК ПорядокАктуальногоЭтапа
		|		ПО ВсеЭтапы.ПорядковыйНомер = ПорядокАктуальногоЭтапа.ПорядковыйНомер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Ссылка КАК Этап,
		|	ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Этап КАК ЭтапПредшественник,
		|	ВсеЭтапы.Уровень КАК Уровень
		|ПОМЕСТИТЬ втЭтапыПредшественники
		|ИЗ
		|	втВсеЭтапы КАК ВсеЭтапы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыУниверсальныхПроцессов.ЭтапыПредшественники КАК ЭтапыУниверсальныхПроцессовЭтапыПредшественники
		|		ПО (ЭтапыУниверсальныхПроцессовЭтапыПредшественники.Ссылка = ВсеЭтапы.Этап)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭтапыПредшественники.ЭтапПредшественник КАК Этап,
		|	МИНИМУМ(ЭтапыПредшественники.Уровень) КАК УровеньПоследователя
		|ПОМЕСТИТЬ втУровниПоследователей
		|ИЗ
		|	втЭтапыПредшественники КАК ЭтапыПредшественники
		|СГРУППИРОВАТЬ ПО
		|	ЭтапыПредшественники.ЭтапПредшественник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеЭтапов.Этап КАК Этап,
		|	ДанныеЭтапов.Наименование КАК Наименование,
		|	ДанныеЭтапов.ЕстьДействиеПоРасписанию КАК ЕстьДействиеПоРасписанию,
		|	ДанныеЭтапов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ЕСТЬNULL(АктуальныеЭтапы.Этап, АктуальныйЭтап.Этап) КАК АктуальныйЭтап,
		|	ДанныеЭтапов.Организация КАК Организация,
		|	ЕСТЬNULL(Организации.ЭлиминирующаяОрганизация, ЛОЖЬ) КАК ЭлиминирующаяОрганизация,
		|	ДанныеЭтапов.СостояниеЭтапа КАК СостояниеЭтапа,
		|	ДанныеЭтапов.ДатаОкончания КАК ДатаОкончания,
		|	ДлительностьЭтапов.ДлительностьПлановая КАК ДлительностьПлановая,
		|	ВЫБОР
		|		КОГДА ДлительностьЭтапов.ДлительностьПлановая = 0 ИЛИ ДанныеЭтапов.ДатаНачалаПроцесса = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(ДанныеЭтапов.ДатаНачалаПроцесса, ДЕНЬ, ДлительностьЭтапов.ДлительностьПлановая)
		|	КОНЕЦ КАК ДатаОкончанияПлан,
		|	ВЫБОР
		|		КОГДА ДлительностьЭтапов.ДлительностьПлановая = 0 ИЛИ ДанныеЭтапов.ДатаНачалаПроцесса = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 0
		|		КОГДА ДанныеЭтапов.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА РАЗНОСТЬДАТ(&ТекущаяДата, ДОБАВИТЬКДАТЕ(ДанныеЭтапов.ДатаНачалаПроцесса, ДЕНЬ, ДлительностьЭтапов.ДлительностьПлановая), ДЕНЬ)
		|		ИНАЧЕ
		|			РАЗНОСТЬДАТ(ДанныеЭтапов.ДатаОкончания, ДОБАВИТЬКДАТЕ(ДанныеЭтапов.ДатаНачалаПроцесса, ДЕНЬ, ДлительностьЭтапов.ДлительностьПлановая), ДЕНЬ)
		|	КОНЕЦ КАК ОсталосьДней,
		|	ВЫБОР
		|		КОГДА ДанныеЭтапов.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.ЗавершенСОшибкой)
		|			ТОГДА 1
		|		КОГДА ДанныеЭтапов.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке)
		|			ТОГДА 2
		|		КОГДА ДанныеЭтапов.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен)
		|			ТОГДА 3
		|		КОГДА ДанныеЭтапов.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен)
		|			ТОГДА 4
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК СортировкаСостояния,
		|	&ЭтапОрганизация
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ДанныеЭтапов.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДлительностьЭтапов КАК ДлительностьЭтапов
		|		ПО ДанныеЭтапов.Этап = ДлительностьЭтапов.Этап
		|		ЛЕВОЕ СОЕДИНЕНИЕ втУровниПоследователей КАК УровниПоследователей
		|		ПО ДанныеЭтапов.Этап = УровниПоследователей.Этап
		|		ЛЕВОЕ СОЕДИНЕНИЕ втАктуальныеЭтапы КАК АктуальныеЭтапы
		|		ПО ДанныеЭтапов.Этап = АктуальныеЭтапы.Этап
		|		ЛЕВОЕ СОЕДИНЕНИЕ втАктуальныйЭтап КАК АктуальныйЭтап
		|		ПО (ИСТИНА)";
	
	Если ОтображатьТолькоАктуальные И ТекущаяСтраницаДеревоЭтапов Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	ДанныеЭтапов.Этап = ЕСТЬNULL(АктуальныеЭтапы.Этап, АктуальныйЭтап.Этап)";
	КонецЕсли;
	
	Если СортировкаПоАлфавиту И ТекущаяСтраницаДеревоЭтапов Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО
			|	ДанныеЭтапов.Наименование";
	Иначе
		ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО
			|	ДанныеЭтапов.Уровень,
			|	УровниПоследователей.УровеньПоследователя,
			|	ДанныеЭтапов.ПорядковыйНомер";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ
		|	ВЫБОР
		|		КОГДА МИНИМУМ(СортировкаСостояния) = 1
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.ЗавершенСОшибкой)
		|		КОГДА МИНИМУМ(СортировкаСостояния) = 2
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке)
		|		КОГДА МИНИМУМ(СортировкаСостояния) = 3
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен)
		|		КОГДА МИНИМУМ(СортировкаСостояния) = 4
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен)
		|	КОНЕЦ КАК СостояниеЭтапа,
		|	МАКСИМУМ(Наименование),
		|	МАКСИМУМ(ЕстьДействиеПоРасписанию),
		|	МАКСИМУМ(ДатаОкончания),
		|	МАКСИМУМ(ДатаОкончанияПлан),
		|	МАКСИМУМ(ОсталосьДней),";
	
	Если НЕ ТекущаяСтраницаДеревоЭтапов Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтапОрганизация",
			"	ВЫБОР
			|		КОГДА ДанныеЭтапов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 5
			|		КОГДА ДанныеЭтапов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая)
			|			ТОГДА 6
			|		ИНАЧЕ 4
			|	КОНЕЦ КАК ИндексКартинки");
		
		ТекстЗапроса = ТекстЗапроса + "
			|	ВЫБОР
			|		КОГДА МАКСИМУМ(ЭлиминирующаяОрганизация)
			|			ТОГДА 2
			|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ИндексКартинки,
			|	МАКСИМУМ(АктуальныйЭтап)
			|ПО
			|	Уровень,
			|	Этап
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЭтапыПредшественники.Этап КАК Этап,
			|	ЭтапыПредшественники.ЭтапПредшественник КАК ЭтапПредшественник
			|ИЗ
			|	втЭтапыПредшественники КАК ЭтапыПредшественники"; // @query-part
			
	ИначеЕсли ОтображатьПоОрганизациям Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтапОрганизация",
			"ДанныеЭтапов.Этап КАК ЭтапОрганизация,
			|	ВЫБОР
			|		КОГДА ДанныеЭтапов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 5
			|		КОГДА ДанныеЭтапов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая)
			|			ТОГДА 6
			|		ИНАЧЕ 4
			|	КОНЕЦ КАК ИндексКартинки");
		
		ТекстЗапроса = ТекстЗапроса + "
			|	Организация КАК ЭтапОрганизация,
			|	ВЫБОР
			|		КОГДА МАКСИМУМ(ЭлиминирующаяОрганизация)
			|			ТОГДА 2
			|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ИндексКартинки
			|ПО
			|	Организация"; // @query-part
		
		Элементы.ДеревоЭтапыЭтапОрганизация.Заголовок = НСтр("ru = 'Организация / Этап'");
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтапОрганизация",
			"ДанныеЭтапов.Организация КАК ЭтапОрганизация,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(Организации.ЭлиминирующаяОрганизация, ЛОЖЬ)
			|			ТОГДА 2
			|		КОГДА ДанныеЭтапов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ИндексКартинки");
		
		ТекстЗапроса = ТекстЗапроса + "
			|	ВЫБОР
			|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
			|			ТОГДА 5
			|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая)
			|			ТОГДА 6
			|		ИНАЧЕ 4
			|	КОНЕЦ КАК ИндексКартинки
			|ПО
			|	Этап"; // @query-part
		
		Элементы.ДеревоЭтапыЭтапОрганизация.Заголовок = НСтр("ru = 'Этап / Организация'");
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеЭтапов.ПериодЗакрыт КАК ПериодЗакрыт,
		|	ДанныеЭтапов.СостояниеПроцесса КАК СостояниеПроцесса,
		|	ДанныеЭтапов.ДатаНачалаПроцесса КАК ДатаНачалаПроцесса,
		|	ДанныеЭтапов.ДатаОкончанияПроцесса КАК ДатаОкончанияПроцесса
		|ИЗ
		|	втДанныеЭтапов КАК ДанныеЭтапов";
	
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.Текст = Запрос.Текст + ТекстЗапроса;
	
	// Состояние выполнение процесса
	ПроцессЗапущен = Ложь;
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаСостояниеПроцесса = МассивРезультатов.Получить(МассивРезультатов.ВГраница()).Выбрать();
	Если ВыборкаСостояниеПроцесса.Следующий() Тогда
		
		Если ВыборкаСостояниеПроцесса.ПериодЗакрыт <> ПериодЗакрыт Тогда
			ПериодЗакрыт = ВыборкаСостояниеПроцесса.ПериодЗакрыт;
			Элементы.Диаграмма.КонтекстноеМеню.Доступность = НЕ ПериодЗакрыт;
			Элементы.ДеревоЭтапы.КонтекстноеМеню.Доступность = НЕ ПериодЗакрыт;
			Элементы.ДеревоОперации.КонтекстноеМеню.Доступность = НЕ ПериодЗакрыт;
			Элементы.ГруппаДействия.Доступность = НЕ ПериодЗакрыт;
		КонецЕсли;
		
		Если ПериодЗакрыт Тогда
			ТекстЗаголовка = НСтр("ru = 'Период закрыт для редактирования'");
			Элементы.НадписьСостояниеПроцесса.Заголовок = ТекстЗаголовка;
			Элементы.НадписьСостояниеПроцесса.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаПроцессНеЗапущен;
		ИначеЕсли ВыборкаСостояниеПроцесса.СостояниеПроцесса = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен Тогда
			ПроцессЗапущен = Истина;
			ТекстЗаголовка = НСтр("ru = 'Процесс подготовки отчетности запущен %1'");
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,
				Формат(ВыборкаСостояниеПроцесса.ДатаНачалаПроцесса, "ДЛФ=Д"));
			Элементы.НадписьСостояниеПроцесса.Заголовок = ТекстЗаголовка;
			Элементы.НадписьСостояниеПроцесса.ЦветТекста = Новый Цвет();
		ИначеЕсли ВыборкаСостояниеПроцесса.СостояниеПроцесса = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Завершен Тогда
			ТекстЗаголовка = НСтр("ru = 'Процесс подготовки отчетности завершен %1'");
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,
				Формат(ВыборкаСостояниеПроцесса.ДатаОкончанияПроцесса, "ДЛФ=Д"));
			Элементы.НадписьСостояниеПроцесса.Заголовок = ТекстЗаголовка;
			Элементы.НадписьСостояниеПроцесса.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаПроцессЗавершен;
		Иначе
			ТекстЗаголовка = НСтр("ru = 'Процесс подготовки отчетности не запущен'");
			Элементы.НадписьСостояниеПроцесса.Заголовок = ТекстЗаголовка;
			Элементы.НадписьСостояниеПроцесса.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаПроцессНеЗапущен;
		КонецЕсли;
		
	Иначе
		ТекстЗаголовка = НСтр("ru = 'Процесс подготовки отчетности не запущен'");
		Элементы.НадписьСостояниеПроцесса.Заголовок = ТекстЗаголовка;
		Элементы.НадписьСостояниеПроцесса.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаПроцессНеЗапущен;
	КонецЕсли;
	Элементы.ЗапуститьПроцесс.Доступность = НЕ ПроцессЗапущен;
	Элементы.ОстановитьПроцесс.Доступность = ПроцессЗапущен;

	Если ТекущаяСтраницаДеревоЭтапов Тогда
		ВывестиДерево(МассивРезультатов, мИдентификаторыРазвернутыхСтрок);
	Иначе
		ВывестиДиаграмму(МассивРезультатов);
	КонецЕсли;
	
	ИспользоватьМногопоточностьДляЗаполненияОтчетности = Ложь;
	Если ЗначениеЗаполнено(ПараметрыОбработкиЭтапов.ШаблонПроцесса) Тогда
		ИспользоватьМногопоточностьДляШаблона = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОбработкиЭтапов.ШаблонПроцесса, "ИспользоватьМногопоточностьДляЗаполненияОтчетности");
		
		Если Не (ОбщегоНазначения.ИнформационнаяБазаФайловая() Или ОбщегоНазначения.РазделениеВключено()) Тогда
			ИспользоватьМногопоточностьДляЗаполненияОтчетности = ИспользоватьМногопоточностьДляШаблона;
		Иначе 
			ИспользоватьМногопоточностьДляЗаполненияОтчетности = Ложь;
		КонецЕсли;
	Иначе
		ИспользоватьМногопоточностьДляЗаполненияОтчетности = Ложь;
	КонецЕсли;
	
	Возврат мИдентификаторыРазвернутыхСтрок;

КонецФункции

&НаКлиенте
Процедура ВывестиОтчетПоОперациям()
	
	Если ПоказыватьДеревоОпераций Тогда
		ВывестиОтчетПоОперациямНаСервере();
		РазвернутьВсеОперации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиОтчетПоОперациямНаСервере()
	
	ДеревоОперации.ПолучитьЭлементы().Очистить();
	
	Если НЕ ЗначениеЗаполнено(ТекущийЭтап) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработкиЭтапов.Этап = ТекущийЭтап;
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыОбработкиЭтапов.Организация = Организация;
	Иначе
		ПараметрыОбработкиЭтапов.Организация = ТекущаяОрганизация;
	КонецЕсли;
	ПараметрыОбработкиЭтапов.ДополнительныеОтборы = Новый Структура;
	
	Запрос = УправлениеПроцессамиПодготовкиОтчетности.ЗапросПоДаннымЭтаповДокументов(ПараметрыОбработкиЭтапов);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ЕСТЬNULL(ВидыОтчетов.РазделениеПоПроектам, ЛОЖЬ)), ЛОЖЬ) КАК РазделениеПоПроектам,
		|	ЕСТЬNULL(МАКСИМУМ(ЕСТЬNULL(ВидыОтчетов.КоличествоАналитик, 0)), 0) КАК МаксКлючевыхАналитик
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
		|		ПО ВидыОтчетов.Ссылка = ДанныеЭтаповДокументов.ШаблонДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеЭтаповДокументов.Этап КАК Этап,
		|	ДанныеЭтаповДокументов.Организация КАК Организация,
		|	ДанныеЭтаповДокументов.Проект КАК Проект,
		|	ДанныеЭтаповДокументов.Аналитика1 КАК Аналитика1,
		|	ДанныеЭтаповДокументов.Аналитика2 КАК Аналитика2,
		|	ДанныеЭтаповДокументов.Аналитика3 КАК Аналитика3,
		|	ДанныеЭтаповДокументов.Аналитика4 КАК Аналитика4,
		|	ДанныеЭтаповДокументов.Аналитика5 КАК Аналитика5,
		|	ДанныеЭтаповДокументов.Аналитика6 КАК Аналитика6,
		|	ДанныеЭтаповДокументов.ТипОрганизацийЭтапа КАК ТипОрганизацийЭтапа,
		|	ДанныеЭтаповДокументов.ЭлиминирующаяОрганизация КАК ЭлиминирующаяОрганизация,
		|	ДанныеЭтаповДокументов.ДокументБД КАК ДокументБД,
		|	ДанныеЭтаповДокументов.ШаблонДокумента КАК ШаблонДокумента,
		|	ДанныеЭтаповДокументов.Согласуется КАК Согласуется,
		|	ДанныеЭтаповДокументов.Документ КАК Документ,
		|	ДанныеЭтаповДокументов.Состояние КАК Состояние,
		|	ДанныеЭтаповДокументов.Исполняющий КАК Исполняющий,
		|	ДанныеЭтаповДокументов.Согласование КАК Согласование,
		|	ЕСТЬNULL(СведенияОбИзмененииДокументов.ПоследнийРедактировавший, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Изменивший,
		|	ЕСТЬNULL(СведенияОбИзмененииДокументов.ДатаИзменения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнегоИзменения,
		|	ВЫБОР
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Запланирован)
		|			ТОГДА 1
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Выполняется)
		|			ТОГДА 2
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Подготовлен)
		|			ТОГДА 3
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Возвращен)
		|			ТОГДА 4
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.ЗаписанСОшибкой)
		|			ТОГДА 5
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Утвержден)
		|			ТОГДА 6
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ИндексКартинкиСостояние,
		|	ВЫБОР
		|		КОГДА ДанныеЭтаповДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Утвержден)
		|			ТОГДА 1
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДанныеЭтаповДокументов.КритерийУтвержденияЭтапа = ЗНАЧЕНИЕ(Перечисление.КритерииЗавершенияЭтапаПроцессаПодготовкиОтчетности.УтвержденыВсеДокументы)
		|					ТОГДА 2
		|				ИНАЧЕ ВЫБОР
		|						КОГДА ДанныеЭтаповДокументов.Контрольный
		|							ТОГДА 2
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			КОНЕЦ
		|	КОНЕЦ КАК ИндексКартинкиОбязательный,
		|	ВЫБОР
		|		КОГДА ДанныеЭтаповДокументов.ЭлиминирующаяОрганизация
		|			ТОГДА 2
		|		КОГДА ДанныеЭтаповДокументов.ТипОрганизацийЭтапа = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИндексКартинкиОрганизации,
		|	ДанныеЭтаповДокументов.Организация КАК ОрганизацияШаблонДокумента
		|ИЗ
		|	втДанныеЭтаповДокументов КАК ДанныеЭтаповДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОбИзмененииДокументов КАК СведенияОбИзмененииДокументов
		|		ПО ДанныеЭтаповДокументов.Документ = СведенияОбИзмененииДокументов.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеЭтаповДокументов.Уровень,
		|	ДанныеЭтаповДокументов.ПорядковыйНомер
		|ИТОГИ
		|	МИНИМУМ(Согласуется),
		|	ВЫБОР
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 1
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Запланирован)
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 2
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Выполняется)
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 3
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Подготовлен)
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 4
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Возвращен)
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 5
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.ЗаписанСОшибкой)
		|		КОГДА МИНИМУМ(ИндексКартинкиСостояние) = 6
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Утвержден)
		|		ИНАЧЕ МИНИМУМ(Состояние)
		|	КОНЕЦ КАК Состояние,
		|	МАКСИМУМ(ДатаПоследнегоИзменения),
		|	МИНИМУМ(ИндексКартинкиСостояние),
		|	МАКСИМУМ(ИндексКартинкиОбязательный),
		|	ВЫБОР
		|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Консолидирующая)
		|			ТОГДА 5
		|		КОГДА МАКСИМУМ(ТипОрганизацийЭтапа) = ЗНАЧЕНИЕ(Перечисление.ТипыОрганизационныхЕдиниц.Элиминирующая)
		|			ТОГДА 6
		|		ИНАЧЕ 4
		|	КОНЕЦ КАК ИндексКартинкиОрганизации
		|ПО
		|	ДокументБД,
		|	ШаблонДокумента";
		
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// Выведем колонки Проект и Аналитики
	ВыборкаАналитики = МассивРезультатов.Получить(МассивРезультатов.ВГраница() - 1).Выбрать();
	Если ВыборкаАналитики.Следующий() Тогда
		МаксКлючевыхАналитик = ВыборкаАналитики.МаксКлючевыхАналитик;
		РазделениеПоПроектам = ВыборкаАналитики.РазделениеПоПроектам;
	Иначе
		МаксКлючевыхАналитик = 0;
		РазделениеПоПроектам = Ложь;
	КонецЕсли;
	Элементы.ДеревоОперацииПроект.Видимость = РазделениеПоПроектам;
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Элементы["ДеревоОперацииАналитика" + Сч].Видимость = МаксКлючевыхАналитик >= Сч;
	КонецЦикла;
	
	// Выведем данные в дерево
	ВыборкаДокументыБД = МассивРезультатов.Получить(МассивРезультатов.ВГраница()).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЭлементыУровень1 = ДеревоОперации.ПолучитьЭлементы();
	Пока ВыборкаДокументыБД.Следующий() Цикл
		
		ВыборкаШаблоныДокументов = ВыборкаДокументыБД.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		Пока ВыборкаШаблоныДокументов.Следующий() Цикл
			
			СтрокаДереваУровень1 = ЭлементыУровень1.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДереваУровень1, ВыборкаШаблоныДокументов);
			СтрокаДереваУровень1.ИндексКартинкиОрганизации = 3;
			Если ЗначениеЗаполнено(ВыборкаШаблоныДокументов.ШаблонДокумента) Тогда
				СтрокаДереваУровень1.ОрганизацияШаблонДокумента = ВыборкаШаблоныДокументов.ШаблонДокумента;
			Иначе
				СтрокаДереваУровень1.ОрганизацияШаблонДокумента = ВыборкаШаблоныДокументов.ДокументБД;
			КонецЕсли;
			
			Если ЭтоТекущаяСтрокаОперации(СтрокаДереваУровень1) Тогда
				Элементы.ДеревоОперации.ТекущаяСтрока = СтрокаДереваУровень1.ПолучитьИдентификатор();
			КонецЕсли;
				
			ЭлементыУровень2 = СтрокаДереваУровень1.ПолучитьЭлементы();
			ВыборкаОрганизации = ВыборкаШаблоныДокументов.Выбрать();
			Пока ВыборкаОрганизации.Следующий() Цикл
				
				СтрокаДереваУровень2 = ЭлементыУровень2.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДереваУровень2, ВыборкаОрганизации);
				
				Если ЭтоТекущаяСтрокаОперации(СтрокаДереваУровень2) Тогда
					Элементы.ДеревоОперации.ТекущаяСтрока = СтрокаДереваУровень2.ПолучитьИдентификатор();
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЭтоТекущаяСтрокаОперации(СтрокаДерева)
	
	Если ТекущаяСтрокаОперации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрокаОперации.Документ) Тогда
		// Поиск строго по документу
		Возврат СтрокаДерева.Документ = ТекущаяСтрокаОперации.Документ;
	Иначе
		// Поиск по ключевым срезам
		Возврат СтрокаДерева.ДокументБД = ТекущаяСтрокаОперации.ДокументБД
			И СтрокаДерева.ШаблонДокумента = ТекущаяСтрокаОперации.ШаблонДокумента
			И СтрокаДерева.Организация = ТекущаяСтрокаОперации.Организация
			И СтрокаДерева.Проект = ТекущаяСтрокаОперации.Проект
			И СтрокаДерева.Аналитика1 = ТекущаяСтрокаОперации.Аналитика1
			И СтрокаДерева.Аналитика2 = ТекущаяСтрокаОперации.Аналитика2
			И СтрокаДерева.Аналитика3 = ТекущаяСтрокаОперации.Аналитика3
			И СтрокаДерева.Аналитика4 = ТекущаяСтрокаОперации.Аналитика4
			И СтрокаДерева.Аналитика5 = ТекущаяСтрокаОперации.Аналитика5
			И СтрокаДерева.Аналитика6 = ТекущаяСтрокаОперации.Аналитика6
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыДиаграммы()
	
	ПараметрыДиаграммы = Новый Структура;
	
	ПараметрыДиаграммы.Вставить("ШиринаОтступа", 2);
	ПараметрыДиаграммы.Вставить("ВысотаОтступа", 3);
	
	ПараметрыДиаграммы.Вставить("ШиринаЭтапа", 55);
	ПараметрыДиаграммы.Вставить("ВысотаЭтапа", 30);
	ПараметрыДиаграммы.Вставить("ШиринаТени", 1.5);
	
	ПараметрыДиаграммы.Вставить("РасстояниеМеждуЭтапамиВысота", 5);
	ПараметрыДиаграммы.Вставить("РасстояниеМеждуЭтапамиШирина", 12);
	
	ПараметрыДиаграммы.Вставить("ЦветТекстаЭтапНеАктивен", WebЦвета.Серый);
	ПараметрыДиаграммы.Вставить("ЦветТекстаЭтапВОбработке", WebЦвета.КоролевскиГолубой);
	ПараметрыДиаграммы.Вставить("ЦветТекстаЭтапЗавершен", WebЦвета.Зеленый);
	ПараметрыДиаграммы.Вставить("ЦветТекстаЗавершенСОшибкой", WebЦвета.Красный);
	
	ПараметрыДиаграммы.Вставить("ШрифтТекстПрогресса", Новый Шрифт(,13));
	
	ПараметрыДиаграммы.Вставить("ВысотаЗаголовка", 8);
	ПараметрыДиаграммы.Вставить("ВысотаПрогресса", 6);
	ПараметрыДиаграммы.Вставить("ВысотаОстаткаДней", 4);
	ПараметрыДиаграммы.Вставить("ВысотаШиринаПиктограмм", 4);
	
	ПараметрыДиаграммы.Вставить("ТипЛинии", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1));
	ПараметрыДиаграммы.Вставить("ЦветЛинии", WebЦвета.НейтральноСерый);
	
	ПараметрыДиаграммы.Вставить("ШиринаСтрелки", 2);
	ПараметрыДиаграммы.Вставить("ВысотаСтрелки", 1);
	
	ПараметрыДиаграммы.Вставить("ЦветТекстаПроцессНеЗапущен", WebЦвета.Красный);
	ПараметрыДиаграммы.Вставить("ЦветТекстаПроцессЗавершен", WebЦвета.ЦветМорскойВолны);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДиаграмму(МассивРезультатов)
	
	РезультатЭтапы = МассивРезультатов.Получить(МассивРезультатов.ВГраница()-2);
	Если РезультатЭтапы.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ПоложенияЭтапов = Новый Соответствие;
	ЛевоЭтапа = ПараметрыДиаграммы.ШиринаОтступа;
	
	ВыборкаПоУровням = РезультатЭтапы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоУровням.Следующий() Цикл
		
		ВерхЭтапа = ПараметрыДиаграммы.ВысотаОтступа;

		ВыборкаЭтапы = ВыборкаПоУровням.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЭтапы.Следующий() Цикл
			
			Расшифровка = НоваяРасшифровка(ВыборкаЭтапы.Этап);
			
			ОрганизацийВсего = 0;
			ОрганизацийЗавершено = 0;
			Выборка = ВыборкаЭтапы.Выбрать();
			Пока Выборка.Следующий() Цикл
				Расшифровка.Организация.Добавить(Выборка.Организация);
				ОрганизацийВсего = ОрганизацийВсего + 1;
				Если Выборка.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
					ОрганизацийЗавершено = ОрганизацийЗавершено + 1;
				КонецЕсли;
			КонецЦикла;
			Прогресс = Окр(ОрганизацийЗавершено / ОрганизацийВсего * 100);
			
			ПоложениеЭтапа = Новый Структура("Верх, Лево", ВерхЭтапа + (ПараметрыДиаграммы.ВысотаЭтапа / 2), ЛевоЭтапа);
			ПоложенияЭтапов.Вставить(ВыборкаЭтапы.Этап, ПоложениеЭтапа);
			
			НарисоватьЭтап(ВыборкаЭтапы, ВерхЭтапа, ЛевоЭтапа, Прогресс, Расшифровка);
			
			ВерхЭтапа = ВерхЭтапа + ПараметрыДиаграммы.ВысотаЭтапа + ПараметрыДиаграммы.РасстояниеМеждуЭтапамиВысота;
			
		КонецЦикла;
		
		ЛевоЭтапа = ЛевоЭтапа + ПараметрыДиаграммы.ШиринаЭтапа + ПараметрыДиаграммы.РасстояниеМеждуЭтапамиШирина;
		
	КонецЦикла;
	
	// Выводим связи
	РезультатСвязи = МассивРезультатов.Получить(МассивРезультатов.ВГраница()-1);
	ВыборкаПоСвязям = РезультатСвязи.Выбрать();
	Пока ВыборкаПоСвязям.Следующий() Цикл
		
		ПоложениеЭтапаНачало = ПоложенияЭтапов.Получить(ВыборкаПоСвязям.ЭтапПредшественник);
		ПоложениеЭтапаКонец = ПоложенияЭтапов.Получить(ВыборкаПоСвязям.Этап);
		Если ПоложениеЭтапаНачало = Неопределено
			ИЛИ ПоложениеЭтапаКонец = Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		НарисоватьСвязь(
			ПоложениеЭтапаНачало.Верх, ПоложениеЭтапаНачало.Лево,
			ПоложениеЭтапаКонец.Верх, ПоложениеЭтапаКонец.Лево);
			
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НарисоватьЭтап(СтрокаЭтапа, ВерхЭтапа, ЛевоЭтапа, Прогресс, Расшифровка)
	
	ЭтоАктуальныйЭтап = СтрокаЭтапа.Этап = СтрокаЭтапа.АктуальныйЭтап;
	
	Если СтрокаЭтапа.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ЗавершенСОшибкой Тогда
		КартинкаЭтап = БиблиотекаКартинок.ШаблонЭтапаПроцессаВыполненСОшибкой;
		КартинкаСостояниеЭтапа = БиблиотекаКартинок.ЭтапОтменен;
		ЦветТекстаПрогресса = ПараметрыДиаграммы.ЦветТекстаЗавершенСОшибкой;
	ИначеЕсли СтрокаЭтапа.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
		КартинкаЭтап = БиблиотекаКартинок.ШаблонЭтапаПроцессаВыполнен;
		КартинкаСостояниеЭтапа = БиблиотекаКартинок.ЭтапУтвержден;
		ЦветТекстаПрогресса = ПараметрыДиаграммы.ЦветТекстаЭтапЗавершен;
	ИначеЕсли СтрокаЭтапа.СостояниеЭтапа = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке ИЛИ Прогресс > 0 Тогда
		КартинкаЭтап = БиблиотекаКартинок.ШаблонЭтапаПроцессаВыполняется;
		КартинкаСостояниеЭтапа = БиблиотекаКартинок.ЭтапВыполняется;
		ЦветТекстаПрогресса = ПараметрыДиаграммы.ЦветТекстаЭтапВОбработке;
	Иначе
		КартинкаЭтап = БиблиотекаКартинок.ШаблонЭтапаПроцессаНеВыполняется;
		КартинкаСостояниеЭтапа = БиблиотекаКартинок.ЭтапЗапланирован;
		ЦветТекстаПрогресса = ПараметрыДиаграммы.ЦветТекстаЭтапНеАктивен;
	КонецЕсли;
	
	// Шаблон этапа
	Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = КартинкаЭтап;
	Рисунок.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
	Рисунок.Верх = ВерхЭтапа;
	Рисунок.Лево = ЛевоЭтапа;
	Рисунок.Ширина = ПараметрыДиаграммы.ШиринаЭтапа;
	Рисунок.Высота = ПараметрыДиаграммы.ВысотаЭтапа;
	Рисунок.Линия = ПараметрыДиаграммы.ТипЛинии;
	Рисунок.ЦветЛинии = ПараметрыДиаграммы.ЦветЛинии;
	Рисунок.ГраницаСверху = ЭтоАктуальныйЭтап;
	Рисунок.ГраницаСнизу = ЭтоАктуальныйЭтап;
	Рисунок.ГраницаСправа = ЭтоАктуальныйЭтап;
	Рисунок.ГраницаСлева = ЭтоАктуальныйЭтап;
	ТекущееВверх = ВерхЭтапа;
		
	// Текст заголовка этапа
	Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
	Рисунок.Лево = ЛевоЭтапа + (ПараметрыДиаграммы.ШиринаОтступа * 2);
	Рисунок.Верх = ТекущееВверх + ПараметрыДиаграммы.ВысотаОтступа;
	Рисунок.Ширина = ПараметрыДиаграммы.ШиринаЭтапа - (ПараметрыДиаграммы.ШиринаОтступа * 4);
	Рисунок.Высота = ПараметрыДиаграммы.ВысотаЭтапа - (ПараметрыДиаграммы.ВысотаОтступа * 2);
	Рисунок.Расшифровка = Расшифровка;
	Рисунок.Текст = СтрокаЭтапа.Наименование;
	Рисунок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСлева = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	ТекущееВверх = Рисунок.Верх + ПараметрыДиаграммы.ВысотаЗаголовка + ПараметрыДиаграммы.ВысотаОтступа;
	
	// Картинка состояния этапа
	Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = КартинкаСостояниеЭтапа;
	Рисунок.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
	Рисунок.Лево = ЛевоЭтапа + (ПараметрыДиаграммы.ШиринаОтступа * 2);
	Рисунок.Верх = ТекущееВверх;
	Рисунок.Ширина = ПараметрыДиаграммы.ВысотаШиринаПиктограмм;
	Рисунок.Высота = ПараметрыДиаграммы.ВысотаШиринаПиктограмм;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСлева = Ложь;
	
	// Текст прогресса этапа
	Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
	Рисунок.Лево = ЛевоЭтапа + (ПараметрыДиаграммы.ШиринаОтступа * 5);
	Рисунок.Верх = ТекущееВверх - 1;
	Рисунок.Ширина = ПараметрыДиаграммы.ШиринаЭтапа - (ПараметрыДиаграммы.ШиринаОтступа * 7);
	Рисунок.Высота = ПараметрыДиаграммы.ВысотаПрогресса;
	Рисунок.Расшифровка = Расшифровка;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСлева = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	Рисунок.Шрифт = ПараметрыДиаграммы.ШрифтТекстПрогресса;
	ТекстНадписи = НСтр("ru = 'Прогресс: %1 %'");
	Рисунок.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНадписи, Прогресс);
	Рисунок.ЦветТекста = ЦветТекстаПрогресса;
	ТекущееВверх = ТекущееВверх + Рисунок.Высота + ПараметрыДиаграммы.ШиринаОтступа;
	
	// Отклонение этапа
	Если ЗначениеЗаполнено(СтрокаЭтапа.ДатаОкончанияПлан) Тогда
		
		Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
		Рисунок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
		Рисунок.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Рисунок.Лево = ЛевоЭтапа + (ПараметрыДиаграммы.ШиринаОтступа * 2);
		Рисунок.Верх = ТекущееВверх;
		Рисунок.Ширина = ПараметрыДиаграммы.ШиринаЭтапа - (ПараметрыДиаграммы.ШиринаОтступа * 6) - ПараметрыДиаграммы.ВысотаШиринаПиктограмм;
		Рисунок.Высота = ПараметрыДиаграммы.ВысотаОстаткаДней;
		Рисунок.Расшифровка = Расшифровка;
		Рисунок.ГраницаСверху = Ложь;
		Рисунок.ГраницаСлева = Ложь;
		Рисунок.ГраницаСнизу = Ложь;
		Рисунок.ГраницаСправа = Ложь;
		Если СтрокаЭтапа.ОсталосьДней > 0 Тогда
			Рисунок.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаЭтапЗавершен;
			ТекстНадписи = НСтр("ru = 'Осталось: %1 дн.'");
			Рисунок.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНадписи, СтрокаЭтапа.ОсталосьДней);
		Иначе
			Рисунок.ЦветТекста = ПараметрыДиаграммы.ЦветТекстаЗавершенСОшибкой;
			ТекстНадписи = НСтр("ru = 'Отклонение: %1 дн.'");
			Рисунок.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНадписи, -СтрокаЭтапа.ОсталосьДней);
		КонецЕсли;
		
	КонецЕсли;
	
	// Рисунок регламентного задания
	Если СтрокаЭтапа.ЕстьДействиеПоРасписанию Тогда
		
		Рисунок = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		Рисунок.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
		Рисунок.Лево = ЛевоЭтапа + ПараметрыДиаграммы.ШиринаЭтапа - (ПараметрыДиаграммы.ШиринаОтступа * 5);
		Рисунок.Верх = ТекущееВверх;
		Рисунок.Ширина = ПараметрыДиаграммы.ВысотаШиринаПиктограмм;
		Рисунок.Высота = ПараметрыДиаграммы.ВысотаШиринаПиктограмм;
		Рисунок.ГраницаСверху = Ложь;
		Рисунок.ГраницаСнизу  = Ложь;
		Рисунок.ГраницаСправа = Ложь;
		Рисунок.ГраницаСлева  = Ложь;
		Рисунок.Картинка = БиблиотекаКартинок.РегламентноеЗадание;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НарисоватьСвязь(ВерхНачало, ЛевоНачало, ВерхКонец, ЛевоКонец)
	
	Если ВерхНачало = ВерхКонец Тогда
		
		// Линия со стрелкой
		НарисоватьЛинию(
			ВерхНачало,
			ЛевоНачало - ПараметрыДиаграммы.ШиринаТени + ПараметрыДиаграммы.ШиринаЭтапа,
			ВерхКонец,
			ЛевоКонец,
			Истина);
	Иначе
		
		// Линия в сторону
		НарисоватьЛинию(
			ВерхНачало,
			ЛевоНачало - ПараметрыДиаграммы.ШиринаТени + ПараметрыДиаграммы.ШиринаЭтапа,
			ВерхНачало,
			ЛевоКонец - (ПараметрыДиаграммы.РасстояниеМеждуЭтапамиШирина / 2));
			
		// Линия вверх
		НарисоватьЛинию(
			ВерхНачало,
			ЛевоКонец - (ПараметрыДиаграммы.РасстояниеМеждуЭтапамиШирина / 2),
			ВерхКонец,
			ЛевоКонец - (ПараметрыДиаграммы.РасстояниеМеждуЭтапамиШирина / 2));
			
		// Линия со стрелкой
		НарисоватьЛинию(
			ВерхКонец,
			ЛевоКонец - (ПараметрыДиаграммы.РасстояниеМеждуЭтапамиШирина / 2),
			ВерхКонец,
			ЛевоКонец,
			Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НарисоватьЛинию(ВерхНачало, ЛевоНачало, ВерхКонец, ЛевоКонец, Стрелка = Ложь)
	
	Линия = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ПараметрыДиаграммы.ЦветЛинии;
	Линия.Линия = ПараметрыДиаграммы.ТипЛинии;
	
	Если ЛевоКонец > ЛевоНачало Тогда
		Линия.Лево = ЛевоНачало;
		Линия.Ширина = ЛевоКонец - ЛевоНачало;
	Иначе
		Линия.Лево = ЛевоКонец;
		Линия.Ширина = ЛевоНачало - ЛевоКонец;
	КонецЕсли;
	Если ВерхНачало > ВерхКонец Тогда
		Линия.Верх = ВерхКонец;
		Линия.Высота = ВерхНачало - ВерхКонец;
	Иначе
		Линия.Верх = ВерхНачало;
		Линия.Высота = ВерхКонец - ВерхНачало;
	КонецЕсли;

	Если Стрелка Тогда
		
		Линия = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		Линия.ЦветЛинии = ПараметрыДиаграммы.ЦветЛинии;
		Линия.Линия = ПараметрыДиаграммы.ТипЛинии;
		Линия.Лево = ЛевоКонец - ПараметрыДиаграммы.ШиринаСтрелки;
		Линия.Верх = ВерхКонец - ПараметрыДиаграммы.ВысотаСтрелки;
		Линия.Ширина = ПараметрыДиаграммы.ШиринаСтрелки;
		Линия.Высота = ПараметрыДиаграммы.ВысотаСтрелки;
			
		Линия = Диаграмма.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
		Линия.ЦветЛинии = ПараметрыДиаграммы.ЦветЛинии;
		Линия.Линия = ПараметрыДиаграммы.ТипЛинии;
		Линия.Лево = ЛевоКонец - ПараметрыДиаграммы.ШиринаСтрелки;
		Линия.Верх = ВерхКонец + ПараметрыДиаграммы.ВысотаСтрелки;
		Линия.Ширина = ПараметрыДиаграммы.ШиринаСтрелки;
		Линия.Высота = -ПараметрыДиаграммы.ВысотаСтрелки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДерево(МассивРезультатов, мИдентификаторыРазвернутыхСтрок)
	
	// Дерево этапов и организаций
	ВыборкаЭтапы = МассивРезультатов.Получить(МассивРезультатов.Количество()-2).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЭлементыУровень1 = ДеревоЭтапы.ПолучитьЭлементы();
	Пока ВыборкаЭтапы.Следующий() Цикл
		
		СтрокаДереваУровень1 = ЭлементыУровень1.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДереваУровень1, ВыборкаЭтапы);
		СтрокаДереваУровень1.ЭтапОрганизация = ?(ОтображатьПоОрганизациям, ВыборкаЭтапы.Организация, ВыборкаЭтапы.Этап);
		
		Если ДеревоЭтапыРазвернутыеСтроки.НайтиПоЗначению(СтрокаДереваУровень1.ЭтапОрганизация) <> Неопределено Тогда
			// Строка была развернута
			мИдентификаторыРазвернутыхСтрок.Добавить(СтрокаДереваУровень1.ПолучитьИдентификатор());
		КонецЕсли;
		
		Если СтрокаДереваУровень1.Организация = ТекущаяОрганизация И СтрокаДереваУровень1.Этап = ТекущийЭтап Тогда
			Элементы.ДеревоЭтапы.ТекущаяСтрока = СтрокаДереваУровень1.ПолучитьИдентификатор();
		КонецЕсли;
		
		ЭлементыУровень2 = СтрокаДереваУровень1.ПолучитьЭлементы();
		ВыборкаОрганизации = ВыборкаЭтапы.Выбрать();
		Пока ВыборкаОрганизации.Следующий() Цикл
			
			СтрокаДереваУровень2 = ЭлементыУровень2.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДереваУровень2, ВыборкаОрганизации);
			
			Если СтрокаДереваУровень2.Организация = ТекущаяОрганизация И СтрокаДереваУровень2.Этап = ТекущийЭтап Тогда
				Элементы.ДеревоЭтапы.ТекущаяСтрока = СтрокаДереваУровень2.ПолучитьИдентификатор();
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКомандКонтекстногоМеню

#Область КомандыТаблицыЭтапов

&НаКлиентеНаСервереБезКонтекста
Функция НоваяРасшифровка(Этап = Неопределено, Организация = Неопределено, ПоДеревуОпераций = Ложь)
	
	Расшифровка = Новый Структура;
	Расшифровка.Вставить("Этап", Этап);
	Расшифровка.Вставить("Организация", Новый Массив);
	Если ЗначениеЗаполнено(Организация) Тогда
		Расшифровка.Организация.Добавить(Организация);
	КонецЕсли;
	
	ДополнительныеОтборы = Новый Структура;

	Если ПоДеревуОпераций Тогда

		ДополнительныеОтборы.Вставить("ШаблонДокумента", Новый Массив);
		
		ДополнительныеОтборы.Вставить("Проект", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика1", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика2", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика3", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика4", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика5", Новый Массив);
		ДополнительныеОтборы.Вставить("Аналитика6", Новый Массив);

	КонецЕсли;
	
	Расшифровка.Вставить("ДополнительныеОтборы", ДополнительныеОтборы);
	
	Возврат Расшифровка;
	
КонецФункции

&НаКлиенте
Функция РасшифровкиОтчета(ПоДеревуОпераций = Ложь)
	
	МассивРасшифровок = Новый Массив;
	
	Если ПоДеревуОпераций Тогда
		
		Расшифровка = НоваяРасшифровка(ТекущийЭтап, , Истина);
		Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоОперации.ВыделенныеСтроки Цикл
			СтрокаДерева = ДеревоОперации.НайтиПоИдентификатору(ВыделеннаяСтрока);
			Расшифровка.Организация.Добавить(СтрокаДерева.Организация);
			Расшифровка.ДополнительныеОтборы.ШаблонДокумента.Добавить(СтрокаДерева.ШаблонДокумента);
			Расшифровка.ДополнительныеОтборы.Проект.Добавить(СтрокаДерева.Проект);
			Для Сч = 1 По ЧислоДопАналитик Цикл
				Расшифровка.ДополнительныеОтборы["Аналитика" + Сч].Добавить(СтрокаДерева["Аналитика" + Сч]);
			КонецЦикла;
		КонецЦикла;
		МассивРасшифровок.Добавить(Расшифровка);
	
	ИначеЕсли ТекущаяСтраницаДеревоЭтапов Тогда
		
		Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоЭтапы.ВыделенныеСтроки Цикл
			СтрокаДерева = ДеревоЭтапы.НайтиПоИдентификатору(ВыделеннаяСтрока);
			Если ЗначениеЗаполнено(СтрокаДерева.Этап) Тогда
				
				ЭтапДобавлен = Ложь;
				Для Каждого Расшифровка Из МассивРасшифровок Цикл
					Если Расшифровка.Этап = СтрокаДерева.Этап Тогда
						Если ЗначениеЗаполнено(СтрокаДерева.Организация) Тогда
							Расшифровка.Организация.Добавить(СтрокаДерева.Организация);
						КонецЕсли;
						ЭтапДобавлен = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если НЕ ЭтапДобавлен Тогда
					МассивРасшифровок.Добавить(НоваяРасшифровка(СтрокаДерева.Этап, СтрокаДерева.Организация));
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого ВыделеннаяОбласть Из Диаграмма.ВыделенныеОбласти Цикл
			Расшифровка = ВыделеннаяОбласть.Расшифровка;
			Если Расшифровка <> Неопределено Тогда
				МассивРасшифровок.Добавить(Расшифровка);
			КонецЕсли;
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат МассивРасшифровок;
	
КонецФункции

