&НаКлиенте
Функция ВыбранныеСтроки()

	МассивСтрок = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоОперации.ВыделенныеСтроки Цикл
		СтрокаДерева = ДеревоОперации.НайтиПоИдентификатору(ВыделеннаяСтрока);
		ДобавитьПодчиненныеСтрокиРекурсивно(СтрокаДерева, МассивСтрок);
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПодчиненныеСтрокиРекурсивно(СтрокаДерева, МассивСтрок)
	
	Если ЗначениеЗаполнено(СтрокаДерева.Организация) Тогда
		Если ЗначениеЗаполнено(СтрокаДерева.Документ) Тогда
			МассивСтрок.Добавить(
				Новый Структура("Документ, Организация, Согласуется", СтрокаДерева.Документ, СтрокаДерева.Организация, СтрокаДерева.Согласуется));
		Иначе
			ТекстСообщения = НСтр("ru = 'Документ по шаблону ""%1"" для организации ""%2"" еще не создан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				СтрокаДерева.ШаблонДокумента, СтрокаДерева.Организация);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения); 
		КонецЕсли;
	КонецЕсли;

	Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.ПолучитьЭлементы() Цикл
		ДобавитьПодчиненныеСтрокиРекурсивно(ПодчиненнаяСтрока, МассивСтрок);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроцессПослеВопроса(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УправлениеПериодом) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ Управление отчетным периодом. Запуск процесса отменен.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	// Обработка результата запуска процесса
	Если ЗапуститьПроцессНаСервере(УправлениеПериодом) Тогда
		ТекстОповещения = НСтр("ru = 'Процесс запущен'");
		ТекстСообщения = НСтр("ru = 'Процесс подготовки отчетности успешно запущен'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстСообщения, БиблиотекаКартинок.ЭтапыПроцессов_32);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось запустить процесс подготовки отчетности'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
	СформироватьОтчет();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапуститьПроцессНаСервере(УправлениеПериодом)
	
	Возврат УправлениеПроцессамиПодготовкиОтчетности.ЗапуститьПроцессПодготовкиОтчетности(УправлениеПериодом);
	
КонецФункции

&НаКлиенте
Процедура ОстановитьПроцессПослеВопроса(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УправлениеПериодом) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ Управление отчетным периодом. Остановка процесса отменена.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	// Обработка результата запуска процесса
	Если ОстановитьПроцессНаСервере(УправлениеПериодом) Тогда
		ТекстОповещения = НСтр("ru = 'Процесс остановлен'");
		ТекстСообщения = НСтр("ru = 'Процесс подготовки отчетности успешно остановлен'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстСообщения, БиблиотекаКартинок.ЭтапыПроцессов_32);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось остановить процесс подготовки отчетности'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
	// Обновим отображение на форме
	СформироватьОтчет();
	
КонецПроцедуры

