&НаКлиенте
Процедура УстановитьСостояниеЭтапа(Действие)
	
	ОчиститьСообщения();
	
	// Проверим состояние процесса
	Если НЕ ПроцессЗапущен Тогда
		// Процесс не запущен, предложим запустить
		ТекстВопроса = НСтр("ru = 'Продолжение операции невозможно, так как процесс не запущен. Запустить процесс?'");
		Оповещение = Новый ОписаниеОповещения("ЗапуститьПроцессПослеВопроса", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
		Возврат;
	КонецЕсли;
	
	МассивРасшифровок = РасшифровкиОтчета();
	Если МассивРасшифровок.Количество() > 0 Тогда
		// Для данного действия берем первый выделенный этап
		ДанныеВыбора = МассивРасшифровок.Получить(0);
	Иначе
		// Этап будет выбирать пользователь
		ДанныеВыбора = НоваяРасшифровка();
	КонецЕсли;
	ДанныеВыбора.Вставить("Действие", Действие);
	
	Если ЗначениеЗаполнено(ДанныеВыбора.Этап) Тогда
		УстановитьСостояниеЭтапаПослеВыбораЭтапа(ДанныеВыбора.Этап, ДанныеВыбора);
	Иначе
		Оповещение = Новый ОписаниеОповещения("УстановитьСостояниеЭтапаПослеВыбораЭтапа", ЭтаФорма, ДанныеВыбора);
		
		ПараметрыВыбора = Новый Структура;
		ПараметрыВыбора.Вставить("ЗапретитьИзменениеШаблона", Истина);
		ПараметрыВыбора.Вставить("ШаблонПроцесса", ПараметрыОбработкиЭтапов.ШаблонПроцесса);
		ПараметрыВыбора.Вставить("Заголовок", НСтр("ru = 'Выберите этап для обработки'"));
		
		ОткрытьФорму("Справочник.ЭтапыУниверсальныхПроцессов.Форма.ФормаВыбора",
			ПараметрыВыбора, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭтапаПослеВыбораЭтапа(Этап, ДанныеВыбора) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Этап) Тогда
		Возврат;
	КонецЕсли;
	
	// Параметры продолжения работы
	ТекущийЭтап = Этап;
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Этап", Этап);
	ПараметрыФормы.Вставить("Действие", ДанныеВыбора.Действие);
	
	Если ТекущаяСтраницаДеревоЭтапов Тогда
		
		ПараметрыФормы.Вставить("ВыбранныеОрганизации", ДанныеВыбора.Организация);
		
		// Получим все организации этапа
		МассивОрганизаций = Новый Массив;
		ДобавитьОрганизацииЭтапаРекурсивно(ДеревоЭтапы, МассивОрганизаций);
		ПараметрыФормы.Вставить("Организации", МассивОрганизаций);
		
	Иначе
		
		// Все организации
		ПараметрыФормы.Вставить("Организации", ДанныеВыбора.Организация);
		ПараметрыФормы.Вставить("ВыбранныеОрганизации", ДанныеВыбора.Организация);
		
	КонецЕсли;
	
	// Откроем форму выбора организаций
	Оповещение = Новый ОписаниеОповещения("УстановитьСостояниеЭтапаПослеВыбораОрганизации", ЭтаФорма);
	ОткрытьФорму("Обработка.УправлениеПроцессомПодготовкиОтчетности.Форма.ФормаВыбораОрганизацийПроцесса", ПараметрыФормы, , , , , Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЭтапаПослеВыбораОрганизации(Результат, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если Результат = Неопределено 
		ИЛИ Результат = КодВозвратаДиалога.Отмена
		ИЛИ (Результат.Свойство("Организация") И НЕ ЗначениеЗаполнено(Результат.Организация)) Тогда
		Возврат;
	КонецЕсли;
	
	// Формирование параметров создания
	ЗаполнитьЗначенияСвойств(ПараметрыОбработкиЭтапов, Результат);
	
	Если ИспользоватьМногопоточностьДляЗаполненияОтчетности Тогда
		ПараметрыФормы = Новый Структура;
		МассивПараметровОбработкиЭтапов = Новый Массив;
		ПараметрыРасшифровки = Новый Соответствие;
		ПараметрыРасшифровки.Вставить("ПараметрыОбработкиЭтапов", ПараметрыОбработкиЭтапов);
		ПараметрыРасшифровки.Вставить("Действие", Результат.Действие);
		МассивПараметровОбработкиЭтапов.Добавить(ПараметрыРасшифровки);
		ПараметрыФормы.Вставить("МассивПараметровОбработкиЭтапов", МассивПараметровОбработкиЭтапов);
		ПараметрыФормы.Вставить("Действие", Результат.Действие);
		ПараметрыФормы.Вставить("ВыводитьПрогрессВыполнения", Истина);
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыполненияОбработкиЭтапов", ЭтаФорма, Новый Структура("Результат", Неопределено));
		ОткрытьФорму(
			"Обработка.УправлениеПроцессомПодготовкиОтчетности.Форма.ДлительнаяОперация",
			ПараметрыФормы,
			ЭтотОбъект,
			УникальныйИдентификатор,
			,
			,
			ОписаниеОповещенияОЗакрытии);
		Возврат;
	Иначе
		ОбработатьТекущийЭтапНаСервере(ПараметрыОбработкиЭтапов, Результат.Действие);
		
		СформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

