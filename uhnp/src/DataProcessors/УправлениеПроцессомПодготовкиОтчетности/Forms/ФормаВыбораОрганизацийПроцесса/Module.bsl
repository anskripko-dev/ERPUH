
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Считаем таблицу организаций
	Если Параметры.Свойство("Организации") Тогда
		Для Каждого Организация Из Параметры.Организации Цикл
			НоваяСтрока = ТаблицаОрганизаций.Добавить();
			НоваяСтрока.Организация = Организация;
		КонецЦикла;
	Иначе
		// Не передан адрес с организациями
		Возврат;
	КонецЕсли;
	
	// Установим параметр Выбран для строк организаций
	Если Параметры.Свойство("ВыбранныеОрганизации") Тогда
		ВыбранныеОрганизации = Параметры.ВыбранныеОрганизации;
		Если ТипЗнч(ВыбранныеОрганизации) = Тип("Массив") Тогда
			Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
				СтрокаТаблицы.Выбран = ВыбранныеОрганизации.Количество() = 0 ИЛИ ВыбранныеОрганизации.Найти(СтрокаТаблицы.Организация) <> Неопределено;
			КонецЦикла;
		Иначе
			Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
				СтрокаТаблицы.Выбран = НЕ ЗначениеЗаполнено(ВыбранныеОрганизации)
					ИЛИ СтрокаТаблицы.Организация = ВыбранныеОрганизации;
			КонецЦикла;
		КонецЕсли;
	Иначе
		// Выберем все
		Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
			СтрокаТаблицы.Выбран = Истина;
		КонецЦикла; 
	КонецЕсли;
	
	Параметры.Свойство("Этап", Этап);
	
	// Установим видимость элементов
	Параметры.Свойство("Действие", Действие);
	УстанавливатьСтатусДокументов = Истина;
	ЗаполнятьДокументы = Истина;
	Если Действие = "НачатьОбработкуЭтапа" Тогда
		
		Заголовок = НСтр("ru = 'Начать обработку этапа для организаций:'");
		Элементы.УстанавливатьСтатусДокументов.Заголовок = НСтр("ru = 'Установить документам статус ""Черновик""'");
		
	ИначеЕсли Действие = "ЗавершитьОбработкуЭтапа" Тогда
		
		Заголовок = НСтр("ru = 'Завершить обработку этапа для организаций:'");
		Элементы.УстанавливатьСтатусДокументов.Заголовок = НСтр("ru = 'Установить документам статус ""Утвержден""'");
		Элементы.УстанавливатьСтатусДокументов.Доступность = Ложь;
		
	ИначеЕсли Действие = "ОтменитьОбработкуЭтапа" Тогда
		
		Заголовок = НСтр("ru = 'Отменить обработку этапа для организаций:'");
		Элементы.УстанавливатьСтатусДокументов.Заголовок = НСтр("ru = 'Установить документам статус ""Черновик""'");
		ЗаполнятьДокументы = Ложь;
		Элементы.ЗаполнятьДокументы.Доступность = Ложь;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
		СтрокаТаблицы.Выбран = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
		СтрокаТаблицы.Выбран = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	МассивОрганизаций = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаОрганизаций Цикл
		Если СтрокаТаблицы.Выбран Тогда
			МассивОрганизаций.Добавить(СтрокаТаблицы.Организация); 	
		КонецЕсли;
	КонецЦикла;
	
	СтруктураЗакрытия = Новый Структура;
	Если МассивОрганизаций.Количество() = 0 Тогда
		СтруктураЗакрытия.Вставить("Организация", Неопределено);
	ИначеЕсли МассивОрганизаций.Количество() = 1 Тогда
		СтруктураЗакрытия.Вставить("Организация", МассивОрганизаций.Получить(0));
	Иначе
		СтруктураЗакрытия.Вставить("Организация", МассивОрганизаций);
	КонецЕсли;
	
	СтруктураЗакрытия.Вставить("Этап", Этап);
	СтруктураЗакрытия.Вставить("Действие", Действие);
	СтруктураЗакрытия.Вставить("ЗаполнятьДокументы", ЗаполнятьДокументы);
	СтруктураЗакрытия.Вставить("УстанавливатьСтатусДокументов", УстанавливатьСтатусДокументов);
	
	Закрыть(СтруктураЗакрытия);
	
КонецПроцедуры

#КонецОбласти

