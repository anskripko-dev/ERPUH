#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаЗакрывается, ЗавершитьПослеЗакрытия, НакопленныеСообщения;

&НаКлиенте
Перем СтандартноеОповещениеОЗакрытии;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекстСообщения = НСтр("ru = 'Пожалуйста, подождите...'");
	Если Не ПустаяСтрока(Параметры.ТекстСообщения) Тогда
		ТекстСообщения = Параметры.ТекстСообщения + Символы.ПС + ТекстСообщения;
		Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = ТекстСообщения;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Элементы.СообщениеОперации.ОтображатьЗаголовок = Ложь;
		
	ИначеЕсли Параметры.РежимОткрытияОкнаОжидания = РежимОткрытияОкнаФормы.Независимый Тогда
		Заголовок = Параметры.Заголовок;
		Элементы.СообщениеОперации.ОтображатьЗаголовок = Ложь;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Верх;
		КоманднаяПанель.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	Иначе
		Элементы.СообщениеОперации.Заголовок = Параметры.Заголовок;
		Элементы.СообщениеОперации.ОтображатьЗаголовок = Истина;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ОтменятьПриЗакрытииФормыВладельца) = Тип("Булево") Тогда
		ОтменятьПриЗакрытии = Параметры.ОтменятьПриЗакрытииФормыВладельца;
	Иначе
		ОтменятьПриЗакрытии = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ИдентификаторЗадания) Тогда
		ИдентификаторЗадания = Параметры.ИдентификаторЗадания;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ЗаголовокКнопкиОтмена) Тогда
		Элементы.ФормаЗакрыть.Заголовок = Параметры.ЗаголовокКнопкиОтмена;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Верх;
	КонецЕсли;
	
	Для Каждого Расшифровка Из Параметры.МассивПараметровОбработкиЭтапов Цикл
		ПараметрыДлительныхОпераций = ТаблицаЭтаповОрганизаций(Расшифровка["ПараметрыОбработкиЭтапов"], Расшифровка["Действие"]);
		Для Каждого Стр Из ПараметрыДлительныхОпераций.тЭтапыОрганизации Цикл
			НоваяСтрока = ЭтапыОрганизаций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЦикла;
		СтруктураПараметров = ПараметрыДлительныхОпераций.СтруктураПараметров;
	КонецЦикла;
	Если ЭтапыОрганизаций.Количество() > 0 Тогда
		ТекущийУровеньОбработки = ЭтапыОрганизаций[0].Уровень;
		ТекущийЭтапОбработки    = ЭтапыОрганизаций[0].Этап;
	КонецЕсли;
	
	КоличествоДокументов = КоличествоДокументовПоЭтапу();
	
	Если КоличествоДокументов = 0 Тогда
		КоличествоДокументов = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	СтандартноеОповещениеОЗакрытии = ОписаниеОповещенияОЗакрытии <> Неопределено
		И ОписаниеОповещенияОЗакрытии.Модуль = МодульДлительныеОперацииКлиент;
	
	ОбработатьТекущийУровень();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Статус <> "Выполняется"
	 Или СтандартноеОповещениеОЗакрытии Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтменитьЗадание", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ФормаЗакрывается = Истина;
	ОтключитьОбработчикОжидания("Подключаемый_ОтменитьЗадание");
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Статус <> "Выполняется" Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартноеОповещениеОЗакрытии Тогда
		ДлительнаяОперация = ПроверитьИОтменитьЕслиВыполняется(ИдентификаторЗадания, ОтменятьПриЗакрытии);
		ЗавершитьДлительнуюОперациюИЗакрытьФорму(ДлительнаяОперация);
	Иначе
		ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтменитьИЗакрыть(Команда)
	
	ОтменятьПриЗакрытии = Истина;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ОбработатьЭтапыНаСервереВФоне(СтруктураПараметров, Действие, УникальныйИдентификатор)

КонецФункции

// Параметры:
//  Результат - см. ДлительныеОперацииКлиент.НовоеСостояниеДлительнойОперации
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПриПолученииПрогрессаДлительнойОперации(Результат, ДополнительныеПараметры) Экспорт
	
	Если ФормаЗакрывается Или Не Открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.ВыводитьПрогрессВыполнения
	   И Результат.Прогресс <> Неопределено Тогда
		
		Процент = 0;
		Если Результат.Прогресс.Свойство("Процент", Процент) Тогда
			Элементы.ДекорацияПроцент.Видимость = Истина;
			Элементы.ДекорацияПроцент.Заголовок = Строка(Процент) + "%";
		КонецЕсли;
		
		Текст = "";
		Если Результат.Прогресс.Свойство("Текст", Текст) Тогда
			Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = СокрЛП(Текст);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Сообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДлительныеОперацииКлиент.ОбработатьСообщенияПользователю(Результат.Сообщения,
		НакопленныеСообщения, Параметры.ВыводитьСообщения, ВладелецФормы);
	
КонецПроцедуры

// Параметры:
//  Результат - см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПриЗавершенииДлительнойОперации(Результат, ДополнительныеПараметры) Экспорт
	
	Если (ФормаЗакрывается Или Не Открыта())
	   И Не ЗавершитьПослеЗакрытия Тогда
		
		Возврат;
	КонецЕсли;
	
	ЗавершитьДлительнуюОперациюИЗакрытьФорму(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьДлительнуюОперациюИЗакрытьФорму(ДлительнаяОперация)
	
	Если ДлительнаяОперация = Неопределено Тогда
		Статус = "Отменено";
	Иначе
		Статус = ДлительнаяОперация.Статус;
	КонецЕсли;
	
	Если Статус = "Отменено" Тогда
		Если СтандартноеОповещениеОЗакрытии Тогда
			ВыполнитьСтандартноеОповещениеОЗакрытии(Неопределено);
		Иначе
			Закрыть(Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Параметры.ПолучатьРезультат Тогда
		Если Статус = "Выполнено" Тогда
			ДлительнаяОперация.Вставить("Результат", ПолучитьИзВременногоХранилища(Параметры.АдресРезультата));
		Иначе
			ДлительнаяОперация.Вставить("Результат", Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Если Статус = "Выполнено" Тогда
		
		Если ВозвращатьРезультатВОбработкуВыбора() Тогда
			ОповеститьОВыборе(ДлительнаяОперация.Результат);
			Возврат;
		КонецЕсли;
		Результат = РезультатВыполнения(ДлительнаяОперация);
		Если СтандартноеОповещениеОЗакрытии Тогда
			ВыполнитьСтандартноеОповещениеОЗакрытии(Результат);
		Иначе
			Закрыть(Результат);
		КонецЕсли;
		
	ИначеЕсли Статус = "Ошибка" Тогда
		
		Результат = РезультатВыполнения(ДлительнаяОперация);
		Если СтандартноеОповещениеОЗакрытии Тогда
			ВыполнитьСтандартноеОповещениеОЗакрытии(Результат);
		Иначе
			Закрыть(Результат);
		КонецЕсли;
		Если ВозвращатьРезультатВОбработкуВыбора() Тогда
			ВызватьИсключение ДлительнаяОперация.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
	ИначеЕсли Статус = "Выполняется"
	        И ФормаЗакрывается
	        И Не ОтменятьПриЗакрытии
	        И СтандартноеОповещениеОЗакрытии Тогда
		
		Результат = РезультатВыполнения(ДлительнаяОперация);
		ОписаниеОповещенияОЗакрытии.ДополнительныеПараметры.Результат = Результат;
		Если ЗавершитьПослеЗакрытия <> Неопределено Тогда
			ЗавершитьПослеЗакрытия = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСтандартноеОповещениеОЗакрытии(Результат)
	
	ОписаниеОповещенияОЗакрытии.ДополнительныеПараметры.Результат = Результат;
	
	Если Не ФормаЗакрывается Тогда
		Закрыть();
		
	ИначеЕсли ЗавершитьПослеЗакрытия Тогда
		ЗавершитьПослеЗакрытия = Неопределено;
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтменитьЗадание()
	
	ФормаЗакрывается = Истина;
	
	ДлительнаяОперация = ПроверитьИОтменитьЕслиВыполняется(ИдентификаторЗадания, ОтменятьПриЗакрытии);
	ЗавершитьДлительнуюОперациюИЗакрытьФорму(ДлительнаяОперация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьИОтменитьЕслиВыполняется(ИдентификаторЗадания, ОтменятьПриЗакрытии)
	
	ДлительнаяОперация = ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);
	
	Если ДлительнаяОперация.Статус = "Выполняется" И ОтменятьПриЗакрытии Тогда
		ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
		ДлительнаяОперация.Статус = "Отменено";
	КонецЕсли;
	
	Возврат ДлительнаяОперация;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗадания(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

&НаКлиенте
Функция РезультатВыполнения(ДлительнаяОперация)
	
	Результат = ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации();
	Результат.АдресРезультата                = Параметры.АдресРезультата;
	Результат.АдресДополнительногоРезультата = Параметры.АдресДополнительногоРезультата;
	Результат.Статус                         = ДлительнаяОперация.Статус;
	Результат.ИнформацияОбОшибке             = ДлительнаяОперация.ИнформацияОбОшибке;
	Результат.КраткоеПредставлениеОшибки     = ДлительнаяОперация.КраткоеПредставлениеОшибки;
	Результат.ПодробноеПредставлениеОшибки   = ДлительнаяОперация.ПодробноеПредставлениеОшибки;
	Результат.Сообщения = Новый ФиксированныйМассив(
		?(НакопленныеСообщения = Неопределено, Новый Массив, НакопленныеСообщения));
	
	Если Параметры.ПолучатьРезультат Тогда
		Результат.Вставить("Результат", ДлительнаяОперация.Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВозвращатьРезультатВОбработкуВыбора()
	
	ОповещениеОЗавершении = ?(СтандартноеОповещениеОЗакрытии,
		ОписаниеОповещенияОЗакрытии.ДополнительныеПараметры.ОповещениеОЗавершении,
		ОписаниеОповещенияОЗакрытии);
	
	Возврат ОповещениеОЗавершении = Неопределено
		И Параметры.ПолучатьРезультат
		И ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения");
	
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаЭтаповОрганизаций(СтруктураПараметров, Действие)
	
	// Дополним структуру параметров недостающими параметрами
	УправлениеПроцессамиПодготовкиОтчетности.ДополнитьСтруктуруПараметров(СтруктураПараметров);
	СтруктураПараметров.Отказ = Ложь;
	СтруктураПараметров.ДополнительныеОтборы.Вставить("СостояниеПроцесса", Перечисления.СостоянияПроцессаПодготовкиОтчетности.Запущен);
	
	// Установим настройки обработки этапов, в зависимости от выполняемого действия
	Если Действие = "ОтменитьОбработкуЭтапов" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОтменитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапаСоСвязями(СтруктураПараметров, "Последователи");
		
	ИначеЕсли Действие = "НачатьОбработкуЭтапа" Тогда
		
		// Получим предшественников текущего этапа с организациями
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно начать обработку этапа ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					СтруктураПараметров.Этап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
		// Отменим все этапы-последователи
		СтруктураПараметровКопия = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПараметров);
		УправлениеПроцессамиПодготовкиОтчетности.ОбработатьЭтап(СтруктураПараметровКопия, "ОтменитьОбработкуЭтапа");
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Неопределено);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ЗавершитьОбработкуЭтапа" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		// Получим предшественников текущего этапа с организациями
		ТекущийЭтап = СтруктураПараметров.Этап;
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
		// Проверим, что все предыдущие этапы завершены
		Для Каждого СтрокаТаблицы Из тЭтапыОрганизации Цикл
			Если НЕ СтрокаТаблицы.ТекущийЭтап Тогда
				// Есть незавершенные этапы нижнего уровня
				ТекстСообщения = НСтр("ru = 'Невозможно завершить этап ""%1"", т. к. есть незавершенный подчиненный этап: ""%2""'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ТекущийЭтап, СтрокаТаблицы.Этап);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, СтруктураПараметров.Отказ);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Действие = "СоздатьДокументыЭтапа" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Ложь);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтап" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапа(СтруктураПараметров);
		
	ИначеЕсли Действие = "ОбработатьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	ИначеЕсли Действие = "ОбработатьИЗавершитьЭтапыДоТекущего" Тогда
		
		СтруктураПараметров.Вставить("УстанавливатьСостояние", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		СтруктураПараметров.Вставить("УстанавливатьСтатусДокументов", Истина);
		СтруктураПараметров.Вставить("ЗаполнятьДокументы", Истина);
		СтруктураПараметров.Вставить("СоздаватьДокументы", Истина);
		СтруктураПараметров.ДополнительныеОтборы.Вставить("НеСостояниеЭтапа", Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен);
		
		тЭтапыОрганизации = УправлениеПроцессамиПодготовкиОтчетности.ДанныеЭтапаСоСвязями(СтруктураПараметров, "Предшественники");
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("тЭтапыОрганизации", тЭтапыОрганизации);
	Результат.Вставить("СтруктураПараметров", СтруктураПараметров);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьТекущийУровень()
	ЭтапыТекущегоУровня.Очистить();
	Для Каждого Стр Из ЭтапыОрганизаций Цикл
		Если Стр.Уровень = ТекущийУровеньОбработки И Стр.Этап = ТекущийЭтапОбработки Тогда
			НоваяСтрока = ЭтапыТекущегоУровня.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЕсли;
	КонецЦикла;
	ТекстЭтапа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Выполняется обработка этапа ""%1"".
		|Обработано %2 из %3 документов.'"),
		ТекущийЭтапОбработки,
		КоличествоОбработанныхДокументов,
		КоличествоДокументов);
	Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = СокрЛП(ТекстЭтапа);
	НомерТекущегоЭтапа = НомерТекущегоЭтапа + 1;
	
	ДлительнаяОперация = ОбработатьТекущийУровеньНаСервереВФоне(ЭтапыТекущегоУровня, СтруктураПараметров, УникальныйИдентификатор);
	
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОповещениеОПрогрессеВыполнения", ЭтотОбъект);
	ОповещениеОЗавершенииВыполнения = Новый ОписаниеОповещения("ОповещениеОЗавершенииВыполнения", ЭтотОбъект); 
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ОповещениеОПрогрессеВыполнения; 
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Выполняется заполнение отчетности.'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершенииВыполнения, ПараметрыОжидания);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьТекущийУровеньНаСервереВФоне(ЗНАЧ ЭтапыТекущегоУровня, СтруктураПараметров, ИдентификаторРезультата)
	
	ТЗЭтапыТекущегоУровня =  ЭтапыТекущегоУровня.Выгрузить();
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторРезультата);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка документов этапов подготовки отчетности'");
	
	ПараметрыПроцедуры = Новый Соответствие;
	
	ИмяПроцедуры = "УправлениеПроцессамиПодготовкиОтчетности.ОбработатьДокументыЭтаповВНесколькоПотоков";
	
	// Обрабатываем все этапы таблицы
	Для Каждого СтрокаТаблицы Из ТЗЭтапыТекущегоУровня Цикл
		НоваяСтруктураПараметров = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураПараметров);
		ЗаполнитьЗначенияСвойств(НоваяСтруктураПараметров, СтрокаТаблицы);
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(НоваяСтруктураПараметров);
		ПараметрыПроцедуры.Вставить(НоваяСтруктураПараметров.Организация.Наименование + Новый УникальныйИдентификатор, МассивПараметров);
	КонецЦикла;
	
	Возврат ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(ИмяПроцедуры,
		ПараметрыВыполнения, ПараметрыПроцедуры);
	
КонецФункции

&НаКлиенте
Процедура ОповещениеОПрогрессеВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Если ЭтаФорма.Открыта() Тогда
			Закрыть(Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполняется" Тогда
		Если Результат.Сообщения <> Неопределено Тогда
			Для Каждого Стр Из Результат.Сообщения Цикл
				Если СтрНайти(Стр.Текст, НСтр("ru = 'Обработано документов:'")) > 0 Тогда
					КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов +
						Число(СтрЗаменить(Стр.Текст, НСтр("ru = 'Обработано документов:'"), ""));
					ТекстЭтапа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Выполняется обработка этапа ""%1"".
						|Обработано %2 из %3 документов.'"),
						ТекущийЭтапОбработки,
						КоличествоОбработанныхДокументов,
						КоличествоДокументов);
					Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = СокрЛП(ТекстЭтапа);
					Процент = Цел(КоличествоОбработанныхДокументов * 100 / КоличествоДокументов);
					Элементы.ДекорацияПроцент.Заголовок = Строка(Процент) + "%";
				Иначе
					СообщенияДлительнойОбработки.Добавить(Стр.Текст);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОЗавершенииВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Если ЭтаФорма.Открыта() Тогда
			Закрыть(Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(
			Результат.ИнформацияОбОшибке);
	
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		ЕстьЭтапыДляОбработки = Ложь;
		Если Результат.Сообщения <> Неопределено Тогда
			Для Каждого Стр Из Результат.Сообщения Цикл
				СообщенияДлительнойОбработки.Добавить(Стр.Текст);
			КонецЦикла;
		КонецЕсли;
		Для Каждого Стр Из ЭтапыОрганизаций Цикл
			Если Стр.ЭтапОбработан Тогда
				Продолжить;
			КонецЕсли;
			Если Стр.Уровень = ТекущийУровеньОбработки И Стр.Этап = ТекущийЭтапОбработки Тогда
				Стр.ЭтапОбработан = Истина;
			ИначеЕсли Стр.Уровень > ТекущийУровеньОбработки ИЛИ Стр.Этап <> ТекущийЭтапОбработки Тогда
				ЕстьЭтапыДляОбработки = Истина;
				ТекущийУровеньОбработки = Стр.Уровень;
				ТекущийЭтапОбработки    = Стр.Этап;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// Если остались этапы - выполняем обработку следующего уровня.
		Если ЕстьЭтапыДляОбработки Тогда
			РезультатМногопоточнойДлительнойОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
			Для Каждого Стр Из РезультатМногопоточнойДлительнойОперации Цикл
				РезультатДлительнойОперации = ПолучитьИзВременногоХранилища(Стр.Значение.АдресРезультата);
				СтруктураПараметров.Отказ = РезультатДлительнойОперации.Отказ;
				СтруктураПоиска = Новый Структура("Организация, Этап", СтруктураПараметров.Организация, СтруктураПараметров.Этап);
				НайденныеСтроки = ЭтапыОрганизаций.НайтиСтроки(СтруктураПоиска);
				Для Каждого СтрокаЭтапа Из НайденныеСтроки Цикл
					КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + СтрокаЭтапа.КоличествоДокументов;
				КонецЦикла;
			КонецЦикла;
			ОбработатьТекущийУровень();
		Иначе
			Если ЭтаФорма.Открыта() Тогда
				Закрыть(СообщенияДлительнойОбработки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КоличествоДокументовПоЭтапу()
	
	Если ЭтапыОрганизаций.Количество() = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	ТЗЭтапы = ЭтапыОрганизаций.Выгрузить().Скопировать(, "Этап");
	ТЗЭтапы.Колонки.Добавить("ШаблонДокумента", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
	
	ТЗКоличествоДокументов = ТЗЭтапы.СкопироватьКолонки();
	Для Каждого Стр Из ТЗЭтапы Цикл
		
		Для Каждого СтрДокумент Из Стр.Этап.ФормируемыеДокументы Цикл
			НоваяСтрока = ТЗКоличествоДокументов.Добавить();
			НоваяСтрока.Этап = Стр.Этап; 
			НоваяСтрока.ШаблонДокумента = СтрДокумент.ШаблонДокумента;
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТКоличествоДокументов.ШаблонДокумента КАК ШаблонДокумента,
		|	ВТКоличествоДокументов.Этап КАК Этап
		|ПОМЕСТИТЬ ВТКоличествоДокументов
		|ИЗ
		|	&ВТКоличествоДокументов КАК ВТКоличествоДокументов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоличествоДокументов.ШаблонДокумента КАК ШаблонДокумента,
		|	ЗначенияАналитикОбъектов.ОбъектУчета КАК ОбъектУчета
		|ИЗ
		|	ВТКоличествоДокументов КАК ВТКоличествоДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияАналитикОбъектов КАК ЗначенияАналитикОбъектов
		|		ПО ВТКоличествоДокументов.Этап = ЗначенияАналитикОбъектов.ОбъектУчета
		|			И ВТКоличествоДокументов.ШаблонДокумента = ЗначенияАналитикОбъектов.ШаблонДокумента";
	
	Запрос.УстановитьПараметр("ВТКоличествоДокументов", ТЗКоличествоДокументов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().Количество();
	
КонецФункции

#КонецОбласти