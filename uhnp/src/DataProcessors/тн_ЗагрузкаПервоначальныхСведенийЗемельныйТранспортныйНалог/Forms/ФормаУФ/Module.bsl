			
&НаСервереБезКонтекста
Функция ПреобразоватьЗначениеИзСтроки(СтрЗначение, Тип = "Число", Вид="")

	Если ПустаяСтрока(СтрЗначение) И Не Тип = "Булево"Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Тип = "Дата" Тогда
		Результат = Дата(СтрЗначение);	
	ИначеЕсли Тип = "Число" Тогда 
		Попытка
			Результат = Число(СтрЗаменить(СтрЗначение, " ", ""));
		Исключение
			Результат = 0;
		КонецПопытки;
	ИначеЕсли Тип = "Булево" Тогда
		Результат = СтрЗначение = "Да" ИЛИ СтрЗначение = "Истина" ИЛИ СтрЗначение = "+" ИЛИ СтрЗначение = "1";
	ИначеЕсли Тип = "Перечисление" Тогда
		Результат = Перечисления[Вид][СтрЗначение];
	ИначеЕсли Тип = "Справочник" Тогда
		Результат = Справочники[Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗначение));
	Иначе
		Результат = СтрЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗемельныйНалог(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьЗемельныйНалогНаСервере(АдресХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТранспортныйНалог(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьТранспортныйНалогНаСервере(АдресХранилища);
	
КонецПроцедуры  

&НаСервере
Процедура ЗагрузитьЗемельныйНалогНаСервере(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);
	
	ДокументОбъект = Неопределено;
	ТекущаяДата = ТекущаяДатаСервера();
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов), ДатаДокументов, ТекущаяДата);
	
	Комментарий = "#Перенос первоначальных сведений по земельному налогу " + ТекущаяДата;		

	СтруктураЗаполнения = Новый Структура(
		"Организация, ОсновноеСредство, Комментарий",
			,,Комментарий);		
			
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ЗначениеЗаполнено(Стр.ОсновноеСредство) Тогда 
			ОсновноеСредство = ПреобразоватьЗначениеИзСтроки(Стр.ОсновноеСредство, "Справочник", "ОбъектыЭксплуатации");
		Иначе
			Продолжить;
		КонецЕсли;
				
		Если ЗначениеЗаполнено(Стр.Организация) Тогда
			Организация = ПреобразоватьЗначениеИзСтроки(Стр.Организация, "Справочник", "Организации");
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаполнения.Организация 		= Организация;
		СтруктураЗаполнения.ОсновноеСредство 	= ОсновноеСредство;
		
		//Поиск документа
		НайденыДокументы = ТаблицаДокументов.НайтиСтроки(СтруктураЗаполнения);
		Если НайденыДокументы.Количество() = 0 Тогда
			ДокументОбъект = Документы.ВводПервоначальныхСведенийДляРасчетаЗемельногоНалога.СоздатьДокумент();
			ДокументОбъект.Заполнить(Новый Структура("Дата, УказаныСпособыОтражениеРасходов", Дата, Ложь));
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураЗаполнения);
			
			ТекДокСтр = ТаблицаДокументов.Добавить();
			ТекДокСтр.ДокументОбъект = ДокументОбъект;
			
			ЗаполнитьЗначенияСвойств(ТекДокСтр, СтруктураЗаполнения);
		Иначе
			ТекДокСтр = НайденыДокументы[0];
			ДокументОбъект = ТекДокСтр.ДокументОбъект;
		КонецЕсли;
		
		// Заполнение табличный частей
		// ТЧ ПараметрыРегистрации
		
		НовСтр 											= ДокументОбъект.ПараметрыРегистрации.Добавить();
		НовСтр.ДатаРегистрации 							= ДатаДокументов;
		НовСтр.КадастровыйНомер     					= Стр.КадастровыйНомер;
		НовСтр.КадастроваяСтоимость 					= ПреобразоватьЗначениеИзСтроки(Стр.КадастроваяСтоимость);
		НовСтр.ОбщаяСобственность   					= ПреобразоватьЗначениеИзСтроки(Стр.ОбщаяСобственность, "Булево"); 
		НовСтр.ДоляВПравеОбщейСобственностиЧислитель 	= ПреобразоватьЗначениеИзСтроки(Стр.ДоляВПравеОбщейСобственностиЧислитель);
		НовСтр.ДоляВПравеОбщейСобственностиЗнаменатель 	= ПреобразоватьЗначениеИзСтроки(Стр.ДоляВПравеОбщейСобственностиЗнаменатель);
		НовСтр.ЖилищноеСтроительство                    = ПреобразоватьЗначениеИзСтроки(Стр.ЖилищноеСтроительство, "Булево");
		НовСтр.ДатаРегистрацииПравНаОбъектНедвижимости  = ПреобразоватьЗначениеИзСтроки(Стр.ДатаРегистрацииПравНаОбъектНедвижимости, "Дата");
		
		// ТЧ ПараметрыНалога 
		НовСтр 											= ДокументОбъект.ПараметрыНалога.Добавить();
		НовСтр.ДатаПараметров                           = КонецДня(ДатаДокументов) + 1; // Следующий день
		НовСтр.КодКатегорииЗемель                       = Стр.КодКатегорииЗемель;
		НовСтр.КБК                       				= Стр.КБК;
		НовСтр.НалоговаяСтавка                          = ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяСтавка);
		НовСтр.НалоговаяЛьготаПоНалоговойБазе           = ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяЛьготаПоНалоговойБазе, "Перечисление", "ВидНалоговойЛьготыПоНалоговойБазеПоЗемельномуНалогуДо2020");
		НовСтр.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395 = Стр.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395;
		НовСтр.КодНалоговойЛьготыУменьшениеНалоговойБазыПоСтатье391 = НовСтр.КодНалоговойЛьготыУменьшениеНалоговойБазыПоСтатье391;
		НовСтр.УменьшениеНалоговойБазыПоСтатье391       = ПреобразоватьЗначениеИзСтроки(НовСтр.УменьшениеНалоговойБазыПоСтатье391, "Булево");
		НовСтр.УменьшениеНалоговойБазыНаСумму           = ПреобразоватьЗначениеИзСтроки(НовСтр.УменьшениеНалоговойБазыНаСумму, "Булево");
		НовСтр.ДоляНеОблагаемойНалогомПлощадиЧислитель  = ПреобразоватьЗначениеИзСтроки(Стр.ДоляНеОблагаемойНалогомПлощадиЧислитель);
		НовСтр.ДоляНеОблагаемойНалогомПлощадиЗнаменатель = ПреобразоватьЗначениеИзСтроки(Стр.ДоляНеОблагаемойНалогомПлощадиЗнаменатель);
		НовСтр.НеОблагаемаяНалогомСумма                 = ПреобразоватьЗначениеИзСтроки(Стр.НеОблагаемаяНалогомСумма);
		НовСтр.СниженнаяНалоговаяСтавка                 = ПреобразоватьЗначениеИзСтроки(Стр.СниженнаяНалоговаяСтавка);
		НовСтр.ПроцентУменьшенияСуммыНалога             = ПреобразоватьЗначениеИзСтроки(Стр.ПроцентУменьшенияСуммыНалога);
		НовСтр.СуммаУменьшенияСуммыНалога               = ПреобразоватьЗначениеИзСтроки(Стр.СуммаУменьшенияСуммыНалога); 
		
		// ТЧ НалоговыйОрган 
		НовСтр 											= ДокументОбъект.НалоговыйОрган.Добавить();
		НовСтр.ДатаПараметров                           = КонецДня(ДатаДокументов) + 1; // Следующий день
        НовСтр.ПостановкаНаУчетВНалоговомОргане         = Перечисления.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане;
		НовСтр.НалоговыйОрган        					= ПреобразоватьЗначениеИзСтроки(Стр.НалоговыйОрган, "Справочник", "РегистрацииВНалоговомОргане");
		НовСтр.КодПоОКТМО                               = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтр.НалоговыйОрган, "КодПоОКТМО");
			
	КонецЦикла;
		
	Для Каждого ТекДокСтр Из ТаблицаДокументов Цикл
		ДокументОбъект = ТекДокСтр.ДокументОбъект;
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
		КонецПопытки;
	КонецЦикла;
		
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ТаблицаДокументов.Количество());
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТранспортныйНалогНаСервере(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);
	
	ДокументОбъект = Неопределено;
	
	ТекущаяДата = ТекущаяДатаСервера();
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов), ДатаДокументов, ТекущаяДата);
	
	Комментарий = "#Перенос первоначальных сведений по земельному налогу " + ТекущаяДата;		

	СтруктураЗаполнения = Новый Структура(
		"Организация, ОсновноеСредство, Комментарий",
			,,Комментарий);		
			
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ЗначениеЗаполнено(Стр.ОсновноеСредство) Тогда 
			ОсновноеСредство = ПреобразоватьЗначениеИзСтроки(Стр.ОсновноеСредство, "Справочник", "ОбъектыЭксплуатации");
		Иначе
			Продолжить;
		КонецЕсли;
				
		Если ЗначениеЗаполнено(Стр.Организация) Тогда
			Организация = ПреобразоватьЗначениеИзСтроки(Стр.Организация, "Справочник", "Организации");
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаполнения.Организация 		= Организация;
		СтруктураЗаполнения.ОсновноеСредство 	= ОсновноеСредство;
		
		//Поиск документа
		НайденыДокументы = ТаблицаДокументов.НайтиСтроки(СтруктураЗаполнения);
		Если НайденыДокументы.Количество() = 0 Тогда
			ДокументОбъект = Документы.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога.СоздатьДокумент();
			ДокументОбъект.Заполнить(Новый Структура("Дата, УказаныСпособыОтражениеРасходов", Дата, Ложь));
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураЗаполнения);
			
			ТекДокСтр = ТаблицаДокументов.Добавить();
			ТекДокСтр.ДокументОбъект = ДокументОбъект;
			
			ЗаполнитьЗначенияСвойств(ТекДокСтр, СтруктураЗаполнения);
		Иначе
			ТекДокСтр = НайденыДокументы[0];
			ДокументОбъект = ТекДокСтр.ДокументОбъект;
		КонецЕсли;
		
		// Заполнение табличный частей
		// ТЧ ПараметрыРегистрации
		
		НовСтр 											= ДокументОбъект.ПараметрыРегистрации.Добавить();
		НовСтр.ДатаРегистрации 							= ДатаДокументов;
		НовСтр.РегистрационныйЗнак     					= Стр.РегистрационныйЗнак;
		НовСтр.ИдентификационныйНомер     				= Стр.ИдентификационныйНомер;
		НовСтр.Марка     								= Стр.Марка;
		НовСтр.ОбщаяСобственность   					= ПреобразоватьЗначениеИзСтроки(Стр.ОбщаяСобственность, "Булево"); 		
		НовСтр.ДоляВПравеОбщейСобственностиЧислитель 	= ПреобразоватьЗначениеИзСтроки(Стр.ДоляВПравеОбщейСобственностиЧислитель);
		НовСтр.ДоляВПравеОбщейСобственностиЗнаменатель 	= ПреобразоватьЗначениеИзСтроки(Стр.ДоляВПравеОбщейСобственностиЗнаменатель);
		
		// ТЧ ПараметрыНалога 
		НовСтр 											= ДокументОбъект.ПараметрыНалога.Добавить();
		НовСтр.ДатаПараметров                           = КонецДня(ДатаДокументов) + 1; // Следующий день 
		НовСтр.КодВидаТранспортногоСредства             = Стр.КодВидаТранспортногоСредства;
		НовСтр.НалоговаяБаза                          	= ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяБаза); 
		НовСтр.ЕдиницаИзмеренияНалоговойБазы            = Стр.ЕдиницаИзмеренияНалоговойБазы;
		НовСтр.ЭкологическийКласс                       = Стр.ЭкологическийКласс;
		НовСтр.ПовышающийКоэффициент                    = ПреобразоватьЗначениеИзСтроки(Стр.ПовышающийКоэффициент);
		НовСтр.НалоговаяСтавка                          = ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяСтавка);
		НовСтр.СтавкаОпределяетсяАвтоматически          = Ложь;
		НовСтр.НалоговаяСтавкаЗависитОтГодаВыпускаТС    = ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяСтавкаЗависитОтГодаВыпускаТС, "Булево");
		НовСтр.НалоговаяЛьгота                          = ПреобразоватьЗначениеИзСтроки(Стр.НалоговаяЛьгота, "Перечисление", "ВидыНалоговыхЛьготПоТранспортномуНалогу");
		НовСтр.ЛьготнаяСтавка                          	= ПреобразоватьЗначениеИзСтроки(Стр.ЛьготнаяСтавка);
		НовСтр.ПроцентУменьшения                        = ПреобразоватьЗначениеИзСтроки(Стр.ПроцентУменьшения);
		НовСтр.СуммаУменьшения                         	= ПреобразоватьЗначениеИзСтроки(Стр.СуммаУменьшения);
		НовСтр.КодНалоговойЛьготы             			= Стр.КодНалоговойЛьготы;
		НовСтр.РегиональныйКодЛьготы             		= Стр.РегиональныйКодЛьготы;
			
		// ТЧ НалоговыйОрган 
		НовСтр 											= ДокументОбъект.НалоговыйОрган.Добавить();
		НовСтр.ДатаПараметров                           = КонецДня(ДатаДокументов) + 1; // Следующий день
        НовСтр.ПостановкаНаУчетВНалоговомОргане         = Перечисления.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане;
		НовСтр.НалоговыйОрган        					= ПреобразоватьЗначениеИзСтроки(Стр.НалоговыйОрган, "Справочник", "РегистрацииВНалоговомОргане");
		НовСтр.КодПоОКТМО                               = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтр.НалоговыйОрган, "КодПоОКТМО");
			
	КонецЦикла;
		
	Для Каждого ТекДокСтр Из ТаблицаДокументов Цикл
		ДокументОбъект = ТекДокСтр.ДокументОбъект;
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
		КонецПопытки;
	КонецЦикла;
		
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ТаблицаДокументов.Количество());
	
КонецПроцедуры 
	