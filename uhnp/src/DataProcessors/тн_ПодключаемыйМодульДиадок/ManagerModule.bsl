&НаСервере
Процедура ОбщиеНастройки_ЗаписатьНастройки(ОбщиеНастройкиТН) Экспорт
		
	ОбщиеНастройкиСсылка = ДопСправочники_НайтиПоНаименованию_Диадок("ОбщиеНастройкиТН", "ОбщиеНастройкиТН");
	
	Если ОбщиеНастройкиСсылка = Неопределено Тогда
		
		ОбщиеНастройкиОбъект = Справочники.Диадок_ДополнительныеСправочники.СоздатьЭлемент();
		ОбщиеНастройкиОбъект.Наименование	= "ОбщиеНастройкиТН";
		ОбщиеНастройкиОбъект.ИмяСправочника	= "ОбщиеНастройкиТН";
		ОбщиеНастройкиОбъект.УстановитьНовыйКод();
		
	Иначе
		ОбщиеНастройкиОбъект = ОбщиеНастройкиСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Для Каждого ТекНастройка Из ОбщиеНастройкиТН Цикл
		
		Если ТекНастройка.Ключ = "СлужебнаяУчетнаяЗаписьПароль" Тогда
			СохраняемоеЗначение = Новый ХранилищеЗначения(ТекНастройка.Значение);
		Иначе
			СохраняемоеЗначение = ТекНастройка.Значение;
		КонецЕсли;
		
		ДопРеквизиты_УстановитьЗначение_Диадок(ОбщиеНастройкиОбъект, ТекНастройка.Ключ, СохраняемоеЗначение,"");
		
	КонецЦикла;
	
	ОбщиеНастройкиОбъект.Записать();
		
КонецПроцедуры	

&НаСервере
Процедура ДопРеквизиты_УстановитьЗначение_Диадок(Элемент, ИмяРеквизита, Значение, ЗначениеСтрока)

	ОбъектСправочник= Элемент;
	
	СтрокаРеквизита = ОбъектСправочник.ДополнительныеРеквизиты.Найти(ИмяРеквизита, "ИмяРеквизита");
	
	Если СтрокаРеквизита = Неопределено Тогда
		
		ЗначениеДляУстановкиНеЗаполнено = (НЕ ЗначениеЗаполнено(Значение) 
											ИЛИ Значение = Ложь 
											ИЛИ Значение = ПустойИдентификатор())
										И (НЕ ЗначениеЗаполнено(ЗначениеСтрока) 
											ИЛИ ЗначениеСтрока = ПустойИдентификатор());
		
		Если ЗначениеДляУстановкиНеЗаполнено Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаРеквизита					= ОбъектСправочник.ДополнительныеРеквизиты.Добавить();
		СтрокаРеквизита.ИмяРеквизита	= ИмяРеквизита;
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		СтрокаРеквизита.ЗначениеХранилищеЗначения = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		СтрокаРеквизита.ЗначениеХранилищеЗначения = Новый ХранилищеЗначения(Значение);
	Иначе	
		СтрокаРеквизита.Значение = Значение;
	КонецЕсли;
	
	СтрокаРеквизита.ЗначениеСтрока = ЗначениеСтрока;
	
	ОбъектСправочник.Записать();

КонецПроцедуры

&НаСервере
Функция Контракт_ОбщиеНастройки() Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("ИспользоватьНастройкиЗаполненияДокументов1С",	Ложь);
	Результат.Вставить("УстанавливатьДатуДокументовЭДО",				Ложь);
	
	// НАЧАЛО Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
	Результат.Вставить("НастройкаПриоритетаКонтрагентовДляОтправки",	Ложь);
	// КОНЕЦ Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
	Возврат Результат;	
КонецФункции

&НаСервере
Функция ДопРеквизиты_Значение_Диадок(Ссылка, ИмяРеквизита)
	
	Результат = Неопределено;
	
	ВыборкаЗначений = Ссылка.ДополнительныеРеквизиты.Найти(ИмяРеквизита);
	
	Если ВыборкаЗначений <> Неопределено Тогда
		Результат = Справочники_ЗначениеДопРеквизита_Диадок(ВыборкаЗначений);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Справочники_ЗначениеДопРеквизита_Диадок(Выборка)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Выборка.Значение) Тогда
		Результат = Выборка.Значение;
	ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеСтрока) Тогда
		Результат = Выборка.ЗначениеСтрока;
	Иначе
		Результат = Выборка.ЗначениеХранилищеЗначения.Получить();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПустойИдентификатор() Экспорт
	
	Результат = "00000000-0000-0000-0000-000000000000";
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДопСправочники_НайтиПоНаименованию_Диадок(ИмяСправочника, Наименование)
	
	Результат = Неопределено;
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Диадок_ДополнительныеСправочники.Ссылка
	|ИЗ
	|	Справочник.Диадок_ДополнительныеСправочники КАК Диадок_ДополнительныеСправочники
	|ГДЕ
	|	Диадок_ДополнительныеСправочники.ИмяСправочника = &ИмяСправочника
	|	И Диадок_ДополнительныеСправочники.Наименование = &Наименование"
	);
	
	Запрос.УстановитьПараметр("ИмяСправочника",	ИмяСправочника);
	Запрос.УстановитьПараметр("Наименование",	Наименование);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Следующий() Тогда
		Результат = ВыборкаЗапроса.Ссылка;
	КонецЕсли;
			
	Возврат Результат;

КонецФункции

&НаСервере
Функция ОбщиеНастройки_ПолучитьНастройки() Экспорт
	
	Результат = Контракт_ОбщиеНастройки();
	
	ОбщиеНастройкиСсылка = ДопСправочники_НайтиПоНаименованию_Диадок("ОбщиеНастройкиТН", "ОбщиеНастройкиТН");
	
	Если ОбщиеНастройкиСсылка <> Неопределено Тогда
		
		Для Каждого ТекНастройка Из Результат Цикл
			
			ЗначениеНастройки = ДопРеквизиты_Значение_Диадок(ОбщиеНастройкиСсылка, ТекНастройка.Ключ);
			
			Если ЗначениеНастройки <> Неопределено Тогда
				Результат[ТекНастройка.Ключ] = ЗначениеНастройки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции
