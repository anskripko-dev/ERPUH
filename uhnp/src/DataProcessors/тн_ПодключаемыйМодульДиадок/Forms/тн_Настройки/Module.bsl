Перем ПодключаемыйМодульТН;

&НаСервере
Процедура Сохранить_НастройкиТН_НаСервере()
	ОбщиеНастройкиТН = Обработки.тн_ПодключаемыйМодульДиадок.Контракт_ОбщиеНастройки();
	ЗаполнитьЗначенияСвойств(ОбщиеНастройкиТН,ЭтотОбъект);
	Обработки.тн_ПодключаемыйМодульДиадок.ОбщиеНастройки_ЗаписатьНастройки(ОбщиеНастройкиТН);  

	// НАЧАЛО Мещеряков Алексей 31.07.2025 Выполнение задач №000054634 
	Для Каждого СтрокаПриоритет Из КонтрагентыСписок Цикл
		КонтрагентДиадокОбъект = СтрокаПриоритет.КонтрагентДиадок.ПолучитьОбъект();
		КонтрагентДиадокОбъект.Приоритет = СтрокаПриоритет.Приоритет;	
		КонтрагентДиадокОбъект.Записать();
	КонецЦикла;	
	// КОНЕЦ Мещеряков Алексей 31.07.2025 Выполнение задач №000054634 	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	Сохранить_НастройкиТН_НаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)  
	
	Если Модифицированность Тогда
		Сохранить_НастройкиТН_НаСервере();
	Иначе
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	Результат = Обработки.тн_ПодключаемыйМодульДиадок.ОбщиеНастройки_ПолучитьНастройки();
	ЗаполнитьЗначенияСвойств(ЭтаФорма,Результат);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресВХ = ПоместитьВоВременноеХранилище("КонтрагентыПриоритетОтправки",ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634 
&НаСервере
Процедура ГруппаСтраницыНастроекПриСменеСтраницыНаСервере()
	
	ТЗКонтрагентыДиадок = ПолучитьИзВременногоХранилища(АдресВХ);  
	
	Для каждого СтрокаКонтаргенты Из ТЗКонтрагентыДиадок Цикл
		НовСтрока = КонтрагентыСписок.Добавить();	  
		
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаКонтаргенты);
		
	КонецЦикла;
	
КонецПроцедуры

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634 
&НаКлиенте
Процедура ГруппаСтраницыНастроекПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если КонтрагентыСписок.Количество() = 0 Тогда
		Если ТекущаяСтраница.Имя = "КонтрагентыПриоритетОтправки" Тогда  
			ГруппаСтраницыНастроекПриСменеСтраницыНаСервере();      
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
