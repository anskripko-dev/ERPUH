
#Область Обработчики_Команд_Формы 

&НаКлиенте
Процедура ЗаполнитьПоТекущейСтрокеНаСервере()
	Если Элементы.ТаблицаПервоначальная.ТекущиеДанные <> Неопределено Тогда 
		ТекДанные   = Элементы.ТаблицаПервоначальная.ТекущиеДанные;		
		ИдентификаторСтрокиИсходный = ТекДанные.ИдентификаторСтроки;
		
		Отбор = Новый Структура("ИдентификаторНоменклатуры",ТекДанные.ИдентификаторСтроки);
		СтрокиИсходные = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого НоменклатураСтр Из ТаблицаПервоначальная Цикл
		Если НоменклатураСтр.ИдентификаторСтроки <> ИдентификаторСтрокиИсходный Тогда
			
			ЗаполнитьЗначенияСвойств(НоменклатураСтр,ТекДанные,,"Номенклатура,ИдентификаторСтроки,Описание,СтавкаНДС,ЕдиницаИзмеренияКод,ЕдиницаИзмерения,Наименование,Идентификатор,Артикул");	
						
			ОчиститьСтрокиПоИдентификатору(НоменклатураСтр.ИдентификаторСтроки);
			
			Для Каждого  Стр Из СтрокиИсходные Цикл
				НовДоп = ДополнительныеРеквизиты.Добавить();
				ЗаполнитьЗначенияСвойств(НовДоп,Стр);
				НовДоп.ИдентификаторНоменклатуры = НоменклатураСтр.ИдентификаторСтроки;  
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоТекущейСтроке(Команда)
	ЗаполнитьПоТекущейСтрокеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область Обработчики_Событий_Формы 

 &НаКлиенте
Процедура ТаблицаПервоначальнаяПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТаблицаПервоначальная.ТекущиеДанные <> Неопределено Тогда 
		
		ТекДанные = Элементы.ТаблицаПервоначальная.ТекущиеДанные;
		Отбор = Новый ФиксированнаяСтруктура("ИдентификаторНоменклатуры",ТекДанные.ИдентификаторСтроки);
		Элементы.ДополнительныеРеквизиты.ОтборСтрок = Отбор;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресВХ") Тогда
		АдресВХ = Параметры.АдресВХ;
		ТаблицаСопоставления = ПолучитьИзВременногоХранилища(Параметры.АдресВХ);
		
		Для Каждого Стр Из ТаблицаСопоставления	Цикл
			Если Не ЗначениеЗаполнено(Стр.Номенклатура) И Не ЕстьСопоставление(Стр) Тогда
				НовСтрока = ТаблицаПервоначальная.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока,Стр);
				ЗаполнитьЗначенияСвойств(НовСтрока,Стр.НоменклатураКонтрагента);
				НовСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
			КонецЕсли;
		КонецЦикла;	
				
	КонецЕсли;	
		
КонецПроцедуры 

&НаСервере
Функция ЕстьСопоставление(ДанныеЭД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКонтрагентовБЭД.Наименование КАК Наименование
	               |ИЗ
	               |	РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
	               |ГДЕ
	               |	НоменклатураКонтрагентовБЭД.Владелец = &Владелец
	               |	И НоменклатураКонтрагентовБЭД.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Владелец",ДанныеЭД.Контрагент);
	Запрос.УстановитьПараметр("Идентификатор",ДанныеЭД.НоменклатураКонтрагента.Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина; 
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции
	
&НаКлиенте
Процедура ТаблицаПервоначальнаяВидНоменклатурыПриИзменении(Элемент) 
	
	Если Элементы.ТаблицаПервоначальная.ТекущиеДанные <> Неопределено Тогда   
		
		ТекДанные = Элементы.ТаблицаПервоначальная.ТекущиеДанные;
		
		ОчиститьСтрокиПоИдентификатору(ТекДанные.ИдентификаторСтроки);
		
		ТаблицаПервоначальнаяВидНоменклатурыПриИзмененииНаСервере(ТекДанные.ИдентификаторСтроки,ТекДанные.ВидНоменклатуры);
				
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ТаблицаПервоначальнаяВидНоменклатурыПриИзмененииНаСервере(ИдентификаторСтроки,ВидНоменклатуры)
	
	ТаблицаКонтроля = ПолучитьТаблицуконтроля(ВидНоменклатуры); 
	ТЗПервоначальная = ДанныеФормыВЗначение(ТаблицаПервоначальная,Тип("ТаблицаЗначений"));
	
	Для каждого Стр Из ТаблицаКонтроля Цикл 
		
		РеквизитЕсть = ТЗПервоначальная.Колонки.Найти(Стр.НаименованиеПоля);
		
		Если Не РеквизитЕсть = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовДоп = ДополнительныеРеквизиты.Добавить();
		НовДоп.ИдентификаторНоменклатуры = ИдентификаторСтроки; 
		НовДоп.НаименованиеПоля          = Стр.НаименованиеПоля; 

		Реквизит = Метаданные.Справочники.Номенклатура.Реквизиты.Найти(Стр.НаименованиеПоля);
		ЗначениеПоУмолчанию = Реквизит.Тип.ПривестиЗначение("");

		НовДоп.ЗначениеПоля				 = ЗначениеПоУмолчанию;
	КонецЦикла;	
		
КонецПроцедуры	

&НаСервере
Процедура ОчиститьСтрокиПоИдентификатору(ИдентификаторСтроки)
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторНоменклатуры",ИдентификаторСтроки);
	
	СтрокиДляУдаления = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	
	Для Каждого Стр Из СтрокиДляУдаления Цикл
		ДополнительныеРеквизиты.Удалить(Стр);		
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуконтроля(ВидНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНоменклатурыРеквизитыДляКонтроляНоменклатуры.ИмяРеквизита КАК НаименованиеПоля,
	               |	ВидыНоменклатурыРеквизитыДляКонтроляНоменклатуры.ПредставлениеРеквизита КАК ПредставлениеРеквизита
	               |ИЗ
	               |	Справочник.ВидыНоменклатуры.РеквизитыДляКонтроляНоменклатуры КАК ВидыНоменклатурыРеквизитыДляКонтроляНоменклатуры
	               |ГДЕ
	               |	ВидыНоменклатурыРеквизитыДляКонтроляНоменклатуры.Ссылка = &Ссылка
	               |	И ВидыНоменклатурыРеквизитыДляКонтроляНоменклатуры.ЗаполнятьОбязательно = ИСТИНА";
	Запрос.УстановитьПараметр("Ссылка",ВидНоменклатуры);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
#КонецОбласти

#Область Создание_Сопоставление_Номенклатуры

&НаСервере
Процедура СоздатьНоменклатурыНаСервере()
	
	Для Каждого СтрокаНоменклатуры Из ТаблицаПервоначальная Цикл
		
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура) Тогда
			Продолжить;
		КонецЕсли; 
					
		Индекс = ТаблицаПервоначальная.Индекс(СтрокаНоменклатуры);
		
		Если Не ОбязательныеПоляЗаполнены(СтрокаНоменклатуры,Индекс+1) Тогда 
			Продолжить;
		КонецЕсли;	
		
		НоваяНоменклатура = СоздатьНоменклатуруНаСервере(СтрокаНоменклатуры,Индекс+1);		
		
		Если ЗначениеЗаполнено(НоваяНоменклатура) Тогда
			СтрокаНоменклатуры.Номенклатура = НоваяНоменклатура; 
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры   

&НаСервере
Функция ОбязательныеПоляЗаполнены(СтрокаНоменклатуры,НомерСтроки)
	
	СтрокаПеречисленияПолей = "";
	
	Если Не ЗначениеЗаполнено(СтрокаНоменклатуры.Наименование) Тогда
		СтрокаПеречисленияПолей = "Наименование " + Символы.ПС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаНоменклатуры.ВидНоменклатуры) Тогда
		СтрокаПеречисленияПолей = СтрокаПеречисленияПолей + "Вид номенклатуры" + Символы.ПС;;
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(СтрокаНоменклатуры.РодительНоменклатуры) Тогда
		СтрокаПеречисленияПолей = СтрокаПеречисленияПолей + "Группа номенклатуры" + Символы.ПС;;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторНоменклатуры",СтрокаНоменклатуры.ИдентификаторСтроки);
	
	СтрокиДляЗаполнения = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	
	Для Каждого Стр Из СтрокиДляЗаполнения Цикл
		Если Не ЗначениеЗаполнено(Стр.ЗначениеПоля) Тогда
			СтрокаПеречисленияПолей = СтрокаПеречисленияПолей + "," +Стр.НаименованиеПоля + " "+ Символы.ПС;;
		КонецЕсли;	
	КонецЦикла;	   
	
	Если ЗначениеЗаполнено(СтрокаПеречисленияПолей) Тогда
		ТекстСообщения = СтрШаблон("Не удалось создать номенклатуру по строке %1. Не все обязательные поля заполнены: %2",НомерСтроки,СтрокаПеречисленияПолей);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);						
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат Истина;	
Конецфункции	

&НаСервере
Процедура ЗаполнитьСоответствиеНоменклатуры1с(НоменклатураКонтрагента,НоменклатураИБ,НомерСтроки)   
	
	Набор = РегистрыСведений.НоменклатураКонтрагентовБЭД.СоздатьНаборЗаписей();
	Набор.Отбор.Владелец.Установить(НоменклатураКонтрагента.Контрагент);
	Набор.Отбор.Идентификатор.Установить(НоменклатураКонтрагента.Идентификатор);
	
	Запись = Набор.Добавить();
	
	ЗаполнитьЗначенияСвойств(Запись, НоменклатураКонтрагента); 
	
	Запись.Владелец 		= НоменклатураКонтрагента.Контрагент;
	Запись.Номенклатура 	= НоменклатураИБ;
	
	Попытка
		Набор.Записать();
	Исключение
	   	ТекстСообщения = СтрШаблон("Не удалось сопоставить номенклатуру по строке %1 по причине: %2%3",НомерСтроки,Символы.ПС,ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);	
	КонецПопытки  
	
КонецПроцедуры	

&НаСервере
Функция СоздатьНоменклатуруНаСервере(ДанныеНоменклатуры,НомерСтроки)
	
	ЕдиницаПоКлассификатору = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмеренияКод) Тогда
		
		ЕдиницаПоКлассификатору = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(ДанныеНоменклатуры.ЕдиницаИзмеренияКод);
		
	КонецЕсли;
	
	Если ЕдиницаПоКлассификатору = Неопределено 
		И ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмерения) Тогда
		
		ЕдиницаПоКлассификатору = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ДанныеНоменклатуры.ЕдиницаИзмерения, Истина);
		
	КонецЕсли;
		
	НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	НоменклатураОбъект.ВидНоменклатуры    = ДанныеНоменклатуры.ВидНоменклатуры;

	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НоменклатураОбъект);
	
	НоменклатураОбъект.УстановитьНовыйКод();	
	
	НоменклатураОбъект.ГруппаФинансовогоУчета = ДанныеНоменклатуры.ГФУ;
	
	НоменклатураОбъект.ЕдиницаИзмерения   = ?(ЗначениеЗаполнено(ЕдиницаПоКлассификатору), ЕдиницаПоКлассификатору, НоменклатураОбъект.ЕдиницаИзмерения);
	НоменклатураОбъект.Родитель           = ДанныеНоменклатуры.РодительНоменклатуры;
	НоменклатураОбъект.Наименование       = ДанныеНоменклатуры.Наименование;
	НоменклатураОбъект.НаименованиеПолное = ДанныеНоменклатуры.Наименование;
	НоменклатураОбъект.Артикул            = ДанныеНоменклатуры.Артикул;
	
	ЗаполнитьРеквизитыКонтроля(НоменклатураОбъект,ДанныеНоменклатуры.ИдентификаторСтроки);
	// НАЧАЛО Мещеряков Алексей 20.05.2025 Выполнение задач №000053747	
	//СтавкаНДС = ОбменССайтамиУТ.СтавкаНДСПоЗначениюПриЗагрузке(СтрЗаменить(ДанныеНоменклатуры.СтавкаНДС,"%",""));
	
	СоответствиеСтавокНДС = УчетНДСРФ.СоответствиеСтавокНДССтроковымЗначениям();
	СтавкаНДС = ОбменССайтамиУТ.СтавкаНДСПоЗначениюПриЗагрузке(СоответствиеСтавокНДС,СтрЗаменить(ДанныеНоменклатуры.СтавкаНДС,"%",""));
	// КОНЕЦ Мещеряков Алексей 20.05.2025 Выполнение задач №000053747
	
	НоменклатураОбъект.СтавкаНДС = СтавкаНДС;
		
	Попытка
		НоменклатураОбъект.Записать();
	Исключение
		ТекстСообщения = СтрШаблон("Не удалось создать номенклатуру по строке %1 по причине: %2%3",НомерСтроки,Символы.ПС,ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);	
	Конецпопытки;	
	
	Возврат НоменклатураОбъект.Ссылка;		
КонецФункции	

&НаСервере
Процедура ЗаполнитьРеквизитыКонтроля(НоменклатураОбъект,ИдентификаторСтроки)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторНоменклатуры",ИдентификаторСтроки);
	
	СтрокиДляЗаполнения = ДополнительныеРеквизиты.НайтиСтроки(Отбор);
	
	Для Каждого Стр Из СтрокиДляЗаполнения Цикл
		НоменклатураОбъект[Стр.НаименованиеПоля] = Стр.ЗначениеПоля;			
	КонецЦикла;		
	
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
	СоздатьНоменклатурыНаСервере();
КонецПроцедуры 

&НаСервере
Процедура СопоставитьНаСервере()
		
	Для Каждого СтрокаНоменклатуры Из ТаблицаПервоначальная Цикл
					
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура) Тогда
			Индекс = ТаблицаПервоначальная.Индекс(СтрокаНоменклатуры);			
			ЗаполнитьСоответствиеНоменклатуры1с(СтрокаНоменклатуры,СтрокаНоменклатуры.Номенклатура,Индекс+1); 			
		КонецЕсли;	
				
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	СопоставитьНаСервере();
КонецПроцедуры

#КонецОбласти
      			
