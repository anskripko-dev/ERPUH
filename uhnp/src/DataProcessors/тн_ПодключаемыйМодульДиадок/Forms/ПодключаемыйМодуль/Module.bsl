&НаКлиенте
Процедура ОткрытьЗагрузитьНоменклатуруИзЭД(Параметры)
	Документ 			= Параметры.Документ;
	АдресВХ = Параметры.Документ.ДопРеквизиты.АдресВХ;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	ПараметрыФормы.Вставить("АдресВХ",АдресВХ);
  	ОткрытьФорму("Обработка.тн_ПодключаемыйМодульДиадок.Форма.СозданиеНоменклатурыИзЭД",ПараметрыФормы);		
	
КонецПроцедуры	

