&НаКлиенте
Функция НажатиеДополнительнойКнопки(Параметры)
	
	Результат = Неопределено;
	
	ИмяФормыВызова = Параметры.ИмяФормы;
	ИмяКнопки = Параметры.ИмяКнопки;
	
	Если ИмяФормыВызова = "Форма" Тогда
		
		// нажатие дополнительной кнопки в основной форме
		
		РежимОтображенияДокументов 	= Параметры.РежимОтображенияДокументов; // ОтправкаПакетов / ОтправленныеДокументы / ПолученныеДокументы / ПолученныеПакеты
		ВыделенныеСтроки 			= Параметры.ВыделенныеСтроки;
		Если РежимОтображенияДокументов = "ПолученныеДокументы" Тогда
			Если ИмяКнопки = "ОткрытьНастройкиТН" Тогда 
				// НАЧАЛО Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
				//ОткрытьНастройкиТН();
				ОткрытьНастройкиТН(Результат);
				// КОНЕЦ Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
			ИначеЕсли ИмяКнопки = "ОткрытьНастройкиЗаполнения" Тогда
				ОткрытьНастройкиЗаполнения();
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли ИмяФормыВызова = "ФормаПакета" Тогда
// НАЧАЛО Мещеряков Алексей 28.10.2024 Выполнение задач №000051334
		Если ИмяКнопки = "ЗагрузитьНоменклатуруЭД" Тогда
			ОткрытьЗагрузитьНоменклатуруИзЭД(Параметры);	
		КонецЕсли; 
// КОНЕЦ Мещеряков Алексей 28.10.2024 Выполнение задач №000051334		
		// нажатие дополнительной кнопки в форме пакета				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

