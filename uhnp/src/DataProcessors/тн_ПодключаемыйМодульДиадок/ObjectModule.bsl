Функция ПолучитьДанныеЗаполненияДокумента(Документ1с)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеЗаполнения.Номенклатура КАК Номенклатура,
	               |	ДанныеЗаполнения.ДоговорКонтрагента КАК Договор,
	               |	ДанныеЗаполнения.Комментарий КАК Комментарий,
	               |	ДанныеЗаполнения.ПодразделениеПолучатель КАК Подразделение,
	               |	ДанныеЗаполнения.Статья КАК СтатьяРасходов,
	               |	ДанныеЗаполнения.ТребуетсяРекласификация КАК ТребуетсяРекласификация,
	               |	ДанныеЗаполнения.ПодразделениеУУ КАК тн_ПодразделениеУУ,
	               |	ДанныеЗаполнения.СтатьяУУ КАК тн_СтатьяУУ,
	               |	ДанныеЗаполнения.АналитикаРасходов КАК АналитикаРасходов
	               |ИЗ
	               |	РегистрСведений.тн_НастройкиЗаполненияДокументовПоЭДО КАК ДанныеЗаполнения
	               |ГДЕ
	               |	ДанныеЗаполнения.Контрагент = &Контрагент
	               |	И ДанныеЗаполнения.Организация = &Организация
	               |	И ДанныеЗаполнения.Действующая = ИСТИНА";
	
	Запрос.УстановитьПараметр("Контрагент",Документ1с.Контрагент);
	Запрос.УстановитьПараметр("Организация",Документ1с.Организация);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();		
		Возврат Выборка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Заполнить_ПриобретениеУслугПрочихАктивов(Параметры,Документ1сОбъект,НастройкиТН)
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеОшибки",Неопределено);
	Результат.Вставить("ОсновнойОбъект","");

	Если Не НастройкиТН.ИспользоватьНастройкиЗаполненияДокументов1С 
		Или Документ1сОбъект.Расходы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеДляЗаполнения = ПолучитьДанныеЗаполненияДокумента(Документ1сОбъект); 
	
	Если ДанныеДляЗаполнения = Неопределено Тогда 
		// НАЧАЛО Мещеряков Алексей 23.07.2024 Выполнение задач №000050283
		//ТекстСообщения = СтрШаблон("В РС ""Настройки заполнения документов 1С по ЭД"" для документа %1 отсутсвует настройка для заполнения",Параметры.Документ.ИмяФайла);
		ТекстСообщения = СтрШаблон("В РС ""Настройки заполнения документов 1С по ЭД"" для документа %1 отсутствует настройка для заполнения",Параметры.Документ.ИмяФайла);
		// КОНЕЦ Мещеряков Алексей 23.07.2024 Выполнение задач №000050283
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ТекстСообщения;		
		Возврат Результат;		
	КонецЕсли;
	
	Документ1сОбъект.Дата = Параметры.ДокументДД.ДатаДокумента;
	
	Отказ = ДатыЗапретаИзменения.ИзменениеЗапрещено(Документ1сОбъект);
	
	Если Отказ Тогда			
		Документ1сОбъект.Дата = ТекущаяДатаСеанса(); 
	КонецЕсли;
	
    Документ1сОбъект.НалогообложениеНДС 		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	Документ1сОбъект.ЗакупкаПодДеятельность 	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	Документ1сОбъект.ДатаВходящегоДокумента 	= Параметры.ДокументДД.ДатаДокумента;
	Документ1сОбъект.НомерВходящегоДокумента	= Параметры.ДокументДД.НомерДокумента;
	Документ1сОбъект.ЦенаВключаетНДС	    	= Истина;
    Документ1сОбъект.Комментарий            	= ДанныеДляЗаполнения.Комментарий;
	Документ1сОбъект.Договор                	= ДанныеДляЗаполнения.Договор;    
	// НАЧАЛО Мещеряков Алексей 28.03.2024 Выполнение задач №000049034
	Если ЗначениеЗаполнено(Документ1сОбъект.Договор) Тогда
		Документ1сОбъект.ПорядокРасчетов 		= ДанныеДляЗаполнения.Договор.ПорядокРасчетов;
	Иначе
		ТекстСообщения = СтрШаблон("Не заполнен договор для документа %1",Параметры.Документ.ИмяФайла);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ОписаниеОшибки();		
		Возврат Результат;		
	КонецЕсли;	
	// КОНЕЦ Мещеряков Алексей 28.03.2024 Выполнение задач №000049034
	Документ1сОбъект.тн_ТребуетсяРеклассификацияРасходов = ДанныеДляЗаполнения.ТребуетсяРекласификация;

	// НАЧАЛО Мещеряков Алексей 10.06.2024 Выполнение задач №000049840
    Документ1сОбъект.тн_ДатаРеклассификации = Документ1сОбъект.Дата;
	// НАЧАЛО Мещеряков Алексей 10.06.2024 Выполнение задач №000049840		
	
	НаименованиеДокумента = ПолучитьНаименованиеДокумента(Параметры.ДокументДД.ТипДокумента);
	Документ1сОбъект.НаименованиеВходящегоДокумента = НаименованиеДокумента;
		
	Для Каждого СтрокаДокумента Из Документ1сОбъект.Расходы Цикл 
				
		ЗаполнитьЗначенияСвойств(СтрокаДокумента,ДанныеДляЗаполнения);
		
		Если СтрокаДокумента.Количество = 0 Тогда
			СтрокаДокумента.Количество = 1;
		КонецЕсли;	
		
	КонецЦикла;
		
	//Ищем созданную типовы модулем Счет фактуру чтобы изменить в ней дату на текущую. 	
	
	// НАЧАЛО Мещеряков Алексей 23.07.2024 Выполнение задач №000050283
	Попытка
		Документ1сОбъект.ОбменДанными.Загрузка = Истина;
		Документ1сОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ТекстСообщения = СтрШаблон("Не удалось заполнить документ 1с  для документа %1",Параметры.Документ.ИмяФайла);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ОписаниеОшибки();		
		Возврат Результат;
	КонецПопытки;		
	// КОНЕЦ Мещеряков Алексей 23.07.2024 Выполнение задач №000050283
	
	СчетФактураСсылка = НайтиСЧетФактуру(Документ1сОбъект.Ссылка); 
	
	Если СчетФактураСсылка <> Неопределено Тогда
    	СчетФактураОбъект = СчетФактураСсылка.ПолучитьОбъект();
		СчетФактураОбъект.ОбменДанными.Загрузка = Истина;
		СчетФактураОбъект.Дата 					= ТекущаяДатаСеанса();
		СчетФактураОбъект.Записать();
	КонецЕсли;	
	
	Попытка
		Документ1сОбъект.ОбменДанными.Загрузка = Ложь;
		Документ1сОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстСообщения = СтрШаблон("Не удалось заполнить документ 1с  для документа %1",Параметры.Документ.ИмяФайла);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ОписаниеОшибки();		
		Возврат Результат;
	КонецПопытки;		
		
	Попытка
		СчетФактураОбъект = СоздатьСчетФактуру(Документ1сОбъект, Параметры.Документ);
		Результат.ОсновнойОбъект = СчетФактураОбъект;
	Исключение
		ТекстСообщения = СтрШаблон("Не удалось заполнить счетфактуру для документа %1",Параметры.Документ.ИмяФайла);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;	
	
    Возврат Результат;
КонецФункции	

Функция СоздатьСчетФактуру(ДокументОбъект, Документ)
	
	Если ДокументОбъект = Неопределено
		Или Не ТребуетсяСоздатьСчетФактуру(ДокументОбъект) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОсновнойМодуль.ЭтоСоглашениеОбИзмененииСтоимости(Документ.Тип) Тогда
		
		ЭлектронныйСФ = ЭлектронныйКорректировочныйСчетФактураПакета(Документ);
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
		
	Иначе
		
		ЭлектронныйСФ = ЭлектронныйСчетФактураПакета(Документ);
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭлектронныйСФ)
		Или ЗначениеЗаполнено(ЭлектронныйСФ.ДокументУчета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
		ДокументОбъект.УстановитьНовыйНомер();
	КонецЕсли;

	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	
	ОснованиеСФ = ДокументОбъект.Ссылка;
	
	СчетФактураСсылка = НайтиСЧетФактуру(ДокументОбъект.Ссылка);
	
	Если СчетФактураСсылка = Неопределено Тогда
		ДокументСФ = Документы.СчетФактураПолученный.СоздатьДокумент();
	Иначе
		ДокументСФ = СчетФактураСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	СтруктураДляСФ = Новый Структура;
	СтруктураДляСФ.Вставить("ДокументОснование", ОснованиеСФ);
	СтруктураДляСФ.Вставить("Основание", ОснованиеСФ);
	СтруктураДляСФ.Вставить("ВидСчетаФактуры", ВидСчетаФактуры);
	// НАЧАЛО Мещеряков Алексей 10.06.2024 Выполнение задач №000049840
	//ДокументСФ.Заполнить(СтруктураДляСФ);
	// КОНЕЦ Мещеряков Алексей 10.06.2024 Выполнение задач №000049840
	ДокументСФ.Номер	= ЭлектронныйСФ.Реквизиты.Номер; 
	
	ДокументСФ.Дата = ЭлектронныйСФ.Реквизиты.Дата;
	
	Отказ = ДатыЗапретаИзменения.ИзменениеЗапрещено(ДокументСФ);
	
	Если Отказ Тогда				
		ДокументСФ.Дата = ТекущаяДатаСеанса(); 
	КонецЕсли;		
    // НАЧАЛО Мещеряков Алексей 09.04.2025 Выполнение задач №000053348
	//ДокументСФ.ДатаСоставления	= ЭлектронныйСФ.Реквизиты.Дата;
	// КОНЕЦ Мещеряков Алексей 09.04.2025 Выполнение задач №000053348
	
	ДокументСФ.ПолученВЭлектронномВиде	= Истина;
	ДокументСФ.ОбменДанными.Загрузка	= Ложь;   
	// НАЧАЛО Мещеряков Алексей 10.06.2024 Выполнение задач №000049840 
	ДокументСФ.ДатаЗаписиКнигиПокупок = ДокументСФ.Дата;
	ДокументСФ.Заполнить(СтруктураДляСФ);
	// НАЧАЛО Мещеряков Алексей 09.04.2025 Выполнение задач №000053348
	//ДокументСФ.ДатаСоставления	= ДокументСФ.Дата;   
	ДокументСФ.ДатаСоставления	= ЭлектронныйСФ.Реквизиты.Дата;
	// КОНЕЦ Мещеряков Алексей 09.04.2025 Выполнение задач №000053348
	
	// КОНЕЦ Мещеряков Алексей 10.06.2024 Выполнение задач №000049840 
	
 
	
	ДокументСФ.Записать(РежимЗаписиДокумента.Проведение);
	
	Если Не ЭлектронныеДокументыРавны(Документ, ЭлектронныйСФ) Тогда
		ОсновнойМодуль.ОбновлениеРеквизитовДокумента(ЭлектронныйСФ.Идентификаторы, ДокументСФ.Ссылка);
		ОсновнойМодуль.ЭДО_ОбновитьКомментарийДокументаУчета(Документ, ДокументСФ);
	КонецЕсли;         
	
	Возврат ДокументСФ;
	
КонецФункции 

