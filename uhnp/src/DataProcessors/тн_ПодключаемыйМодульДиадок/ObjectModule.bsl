Функция НайтиСопоставлениеДокумента(Параметры)

	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		Если Параметры.Результат_ИМ <> Неопределено Тогда
			ДокументДляСопоставления = Параметры.Результат_ИМ;
			ДатаЭДО 				 = Параметры.Документ.ДатаЭДО;
			
			Если ТипЗнч(ДокументДляСопоставления) = Тип("Массив") И ДокументДляСопоставления.Количество() = 1 Тогда
				ОписаниеОшибки = "";
				СтрокаДокумент = Строка(ДокументДляСопоставления[0]);
				тн_РаботаСДиадокВызовСервера.тн_ПроставитьРеквизитыПослеСвязи(ДокументДляСопоставления[0], ДатаЭДО, ОписаниеОшибки);
                
				Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
					ОпределитьМодули();
					ВидОперации		= "Сопоставление документов";
					ДопИнформация	= "Документ: " + Параметры.Документ;
					ТекстОшибки		= "Не сопоставлен."+ОписаниеОшибки;
					Модуль_Ядро.Ошибка_Обработать(ВидОперации, , ДопИнформация, ТекстОшибки); 
					Параметры.Результат_ИМ = Неопределено;
				КонецЕсли;
				
			КонецЕсли; 	
		КонецЕсли;
		Возврат Параметры.Результат_ИМ;

	КонецЕсли;

КонецФункции

