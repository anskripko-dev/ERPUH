Функция ПослеОбновленияСпискаДокументов(Параметры)

	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда 
		СписокДокументов	= Параметры.СписокДокументов;
		Режим				= Параметры.Режим;

        Если Режим = "ПолученныеДокументы" И СписокДокументов.Количество() = 1 Тогда
            ПереопределитьКонтрагента1с(СписокДокументов[0]);                            
        КонецЕсли;
	КонецЕсли;
   Возврат Неопределено;
