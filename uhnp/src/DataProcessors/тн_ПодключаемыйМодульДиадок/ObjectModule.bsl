Функция ПослеАнализаПакета_ТН(Параметры) 
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("ДокументыПакета") Тогда

       	ДокументыПакета =  Параметры.ДокументыПакета;
       
		Для каждого ДокументДД Из ДокументыПакета Цикл
			Попытка
				ДокументДДОбъект = ДокументДД.Ссылка.ПолучитьОбъект();
				ДокументДДОбъект.АнализПроведен = Ложь;
				ДокументДДОбъект.Записать();                     
			Исключение

			КонецПопытки;
		КонецЦикла;

	
		Возврат Неопределено;

	КонецЕсли;	
КонецФункции	
 
