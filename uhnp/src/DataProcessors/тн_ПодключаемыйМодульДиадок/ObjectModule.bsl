 #Область События_ПМ_ТН 
 
Функция ОбработатьСобытие(ИмяСобытия, Параметры) Экспорт
    //Здесь добавляем новые событие, если нет нужного. 
	//Перечень существующих событий https://developer.kontur.ru/Docs/Diadoc_UM/Functions_PM.html
	
	Если ИмяСобытия = "ПолучитьЗаполненныйОбъектДокумента1С" Тогда
		Возврат ПолучитьЗаполненныйОбъектДокумента1С(Параметры);
	ИначеЕсли ИмяСобытия = "ЗаполнитьСписокДополнительныхКнопок" Тогда
		Возврат ЗаполнитьСписокДополнительныхКнопок(Параметры);
	ИначеЕсли ИмяСобытия = "СписокТиповДокументовДляСоздания" Тогда
		Возврат СписокТиповДокументовДляСоздания(Параметры); 
		// НАЧАЛО Мещеряков Алексей 28.10.2024 Выполнение задач №000051334	
	ИначеЕсли ИмяСобытия = "ПечатнаяФормаДокумента" Тогда
		ПолучитьТаблицуНоменклатурыПоДокументу(Параметры);
		// КОНЕЦ Мещеряков Алексей 28.10.2024 Выполнение задач №000051334	
		// НАЧАЛО Мещеряков Алексей 09.01.2025 Выполнение задач №000052237	
	ИначеЕсли ИмяСобытия = "НайтиСопоставлениеДокумента" Тогда
		Возврат НайтиСопоставлениеДокумента(Параметры);
	ИначеЕсли ИмяСобытия = "ПослеОбработкиЛентыСобытий" Тогда
		Возврат ПослеОбработкиЛентыСобытий(Параметры); 
	ИначеЕсли ИмяСобытия = "ПолучитьТекстЗапросаДляСпискаПакетовНаОтправкуПоМассивуВидовПакетов" Тогда
		Возврат ПолучитьТекстЗапросаДляСпискаПакетовНаОтправкуПоМассивуВидовПакетов(Параметры);	
	ИначеЕсли ИмяСобытия = "ПослеАнализаПакета" Тогда
		Возврат ПослеАнализаПакета_ТН(Параметры);
		// КОНЕЦ Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
		// НАЧАЛО Мещеряков Алексей 05.05.2025 Выполнение задач №000053572		
	ИначеЕсли ИмяСобытия = "ПослеОбновленияСпискаДокументов" Тогда
		Возврат ПослеОбновленияСпискаДокументов(Параметры);	
		// КОНЕЦ Мещеряков Алексей 05.05.2025 Выполнение задач №000053572  
		// НАЧАЛО Мещеряков Алексей 31.07.2025 Выполнение задач №000054634	
	ИначеЕсли ИмяСобытия = "НажатиеДополнительнойКнопки" Тогда
		НажатиеДополнительнойКнопки(Параметры);	
	ИначеЕсли ИмяСобытия = "ПослеПодготовкиПакета" Тогда
		Возврат ПослеПодготовкиПакета(Параметры);
		// КОНЕЦ Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
	КонецЕсли;

КонецФункции

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
Функция ПослеПодготовкиПакета(Параметры) 
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда 
		
		ОбщиеНастройкиТН = ПолучитьНастройки_ТН();
		
		НастройкаПриоритетаВключена = ОбщиеНастройкиТН.НастройкаПриоритетаКонтрагентовДляОтправки;
		
		Если Не НастройкаПриоритетаВключена Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Модуль_Ядро = Неопределено Тогда
			ОпределитьМодули();
		КонецЕсли;	 
		
		ИдентификаторыКонтрагента = Новый Структура;
		ИдентификаторыКонтрагента.Вставить("Контрагент1с",Параметры.Пакет.Данные1С.Контрагент); 
		ИдентификаторыКонтрагента.Вставить("ОрганизацияДиадок",Параметры.Пакет.Данные1С.ОрганизацияДиадок);
		
		СтруктураКонтрагентЭДО = Контрагенты_УчастникДО_Диадок(ИдентификаторыКонтрагента); 
		
		Параметры.Пакет.Данные1С.КонтрагентДиадок  = СтруктураКонтрагентЭДО.ОрганизацияЭДО;
		Параметры.Пакет.ДанныеДД.CounterAgentId    = СтруктураКонтрагентЭДО.BoxId;
		
		Возврат Параметры.Результат_ИМ;
		
	КонецЕсли;
КонецФункции	

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
Функция НажатиеДополнительнойКнопки(Параметры) 
	ИмяФормыВызова 	= Параметры.ИмяФормы;
	ИмяКнопки 		= Параметры.ИмяКнопки;
	
	Если ИмяФормыВызова = "Форма" Тогда
		РежимОтображенияДокументов 	= Параметры.РежимОтображенияДокументов; // ОтправкаПакетов / ОтправленныеДокументы / ПолученныеДокументы / ПолученныеПакеты
		ВыделенныеСтроки 			= Параметры.ВыделенныеСтроки;
		Если РежимОтображенияДокументов = "ПолученныеДокументы" Тогда
			Если ИмяКнопки = "ОткрытьНастройкиТН" И Параметры.Свойство("Результат_ИМ") Тогда
				ПолучитьСписокКонтрагентов(Параметры);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецФункции	
	
