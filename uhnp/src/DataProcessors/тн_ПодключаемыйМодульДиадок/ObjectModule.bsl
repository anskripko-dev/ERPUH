Функция ПолучитьЗаполненныйОбъектДокумента1С(Параметры)
	//После получения результата от типового ПМ изменяем/дополняем нужным нам образом результат и возвращаем типовому модулю
	// в случае если вернуть неопределено в структуру "Результат" будет взят ответ от типового модуля, а наш будет проигнорирован
 
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		Документ1с  = Параметры.Результат_ИМ.ОсновнойОбъект;		
		
		Если ТипЗнч(Документ1с) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") И
			Параметры.ДополнительныеПараметры.Свойство("ПриобретениеУслугПрочихАктивовСЧФП") Тогда
			ОбщиеНастройкиТН = ПолучитьНастройки_ТН();
			Результат = Заполнить_ПриобретениеУслугПрочихАктивов(Параметры,Документ1с,ОбщиеНастройкиТН);
			// НАЧАЛО Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
			//Возврат Результат;
			Если Результат <> Неопределено Тогда
				Параметры.Результат_ИМ.ОсновнойОбъект = Результат.ОсновнойОбъект;			 
			КонецЕсли;
			// КОНЕЦ Мещеряков Алексей 09.01.2025 Выполнение задач №000052237
		КонецЕсли;

	ИначеЕсли ТипЗнч(Параметры) = Тип("Структура") И Не Параметры.Свойство("Результат_ИМ") 
		И Параметры.Свойство("ИдентификаторОперации") И Параметры.ИдентификаторОперации = "ПриобретениеУслугПрочихАктивовСЧФП" Тогда
		Параметры.ИдентификаторОперации = "ПриобретениеУслугПрочихАктивов";
		Параметры.ДополнительныеПараметры.ВыбранныйВид = "ПриобретениеУслугПрочихАктивов";		
		Параметры.ДополнительныеПараметры.Вставить("ПриобретениеУслугПрочихАктивовСЧФП");
	КонецЕсли; 
	
	Возврат Неопределено; 
	
КонецФункции

Функция ЗаполнитьСписокДополнительныхКнопок(Параметры)
    //Дополнительные кнопки которые можно вывести на форму пакета или основную форму 
	// https://developer.kontur.ru/Docs/Diadoc_UM/func/pm/Zapolnit%27_Spisok_Dopolnitel%27nykh_Knopok.html
	
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда

    	Если Параметры.РежимОтображенияДокументов = "ПолученныеДокументы" Тогда
		
			НовСтрока = Параметры.ТаблицаКнопок.Добавить();
			НовСтрока.Имя		= "ОткрытьНастройкиТН";
			НовСтрока.Заголовок	= "Настройки ТН";
			НовСтрока.ИмяФормы	= "Форма";
			
			НовСтрока = Параметры.ТаблицаКнопок.Добавить();
			НовСтрока.Имя		= "ОткрытьНастройкиЗаполнения";
			НовСтрока.Заголовок	= "Настройки заполнения документов учета";
			НовСтрока.ИмяФормы	= "Форма";
		
		КонецЕсли;
		// НАЧАЛО Мещеряков Алексей 28.10.2024 Выполнение задач №000051334
		НовСтрока = Параметры.ТаблицаКнопок.Добавить();
		НовСтрока.Имя		= "ЗагрузитьНоменклатуруЭД";
		НовСтрока.Заголовок	= "Загрузить номенклатуру из ЭД";
		НовСтрока.ИмяФормы	= "ФормаПакета";		
		// КОНЕЦ Мещеряков Алексей 28.10.2024 Выполнение задач №000051334
		Возврат Истина;

	КонецЕсли;
		
КонецФункции

Функция СписокТиповДокументовДляСоздания(Параметры)

	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		Если Не Параметры.Результат_ИМ.НайтиПоЗначению("ПриобретениеУслугПрочихАктивов") = Неопределено Или 
			Не Параметры.Результат_ИМ.НайтиПоЗначению("СчетФактураПолученный") = Неопределено Тогда
			Параметры.Результат_ИМ.Добавить("ПриобретениеУслугПрочихАктивовСЧФП","Приобретение услуг и прочих активов + счет-фактура полученный",,);
			Результат = Параметры.Результат_ИМ.Скопировать();
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

