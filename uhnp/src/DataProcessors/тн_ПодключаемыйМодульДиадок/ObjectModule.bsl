Функция ПолучитьСписокКонтрагентов(Параметры)
	ОпределитьМодули(); 
	
	МассивОрганизаций   = Модуль_Ядро.Организации_СписокОрганизацийПоКонтексту();

	ТЗКонтрагентыДиадок = ТаблицаКонтрагентыПриоритет();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Диадок_НастройкиКонтрагентов.Контрагент.ИНН КАК КонтрагентИНН,
	               |	КОЛИЧЕСТВО(Диадок_НастройкиКонтрагентов.Контрагент) КАК Количество
	               |ИЗ
	               |	РегистрСведений.Диадок_НастройкиКонтрагентов КАК Диадок_НастройкиКонтрагентов
	               |ГДЕ
	               |	Диадок_НастройкиКонтрагентов.Контрагент.ИНН = &ИНН
	               |	И Диадок_НастройкиКонтрагентов.ИмяСвойства = ""Статус""
	               |	И Диадок_НастройкиКонтрагентов.Значение = ""IsMyCounteragent""
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Диадок_НастройкиКонтрагентов.Контрагент.ИНН
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(Диадок_НастройкиКонтрагентов.Контрагент) > 1";	
	
	Для Каждого ОрганизацияДиадок Из МассивОрганизаций Цикл
		ТЗВременная = Модуль_Ядро.Контрагенты_СписокДляРазделаВашиКонтрагенты(ОрганизацияДиадок);
		
		ТЗВременная.Свернуть("ДанныеКонтрагента, ИНН, РеквизитыСвязанныхСправочников, ИдентификаторУчастникаЭДО"); 
				
		Для каждого СтрокаКонтаргенты Из ТЗВременная Цикл	
			   		
			Запрос.УстановитьПараметр("ИНН",СтрокаКонтаргенты.ИНН); 
			
			РезультатЗапрос = Запрос.Выполнить();
			
			Если РезультатЗапрос.Пустой() Тогда 
				Продолжить;
			КонецЕсли;	
			
			НоваяСтрокаКонтрагент = ТЗКонтрагентыДиадок.Добавить();
			
			Если СтрокаКонтаргенты.РеквизитыСвязанныхСправочников.Количество() > 0 Тогда
				НоваяСтрокаКонтрагент.Контрагент1С 	= СтрокаКонтаргенты.РеквизитыСвязанныхСправочников[0].Ссылка;	
			КонецЕсли;
			
			СтруктураДанныхКонтрагента = ЗначениеИзСтрокиВнутр(СтрокаКонтаргенты.ДанныеКонтрагента);
			
			НоваяСтрокаКонтрагент.КонтрагентДиадок  		= СтруктураДанныхКонтрагента.Ссылка;                                            
			НоваяСтрокаКонтрагент.ОрганизацияДиадок 		= ОрганизацияДиадок.Ссылка;
			НоваяСтрокаКонтрагент.Приоритет         		= ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(СтруктураДанныхКонтрагента.Ссылка,"Приоритет");
			ИдентификаторФНС 								= Модуль_Ядро.ИдентификаторФНСИзИдентификаторУчастникаЭДО(СтрокаКонтаргенты.ИдентификаторУчастникаЭДО);			            
			НоваяСтрокаКонтрагент.Оператор          		= Модуль_Ядро.ПредставлениеОператораЭДО(ИдентификаторФНС, ОрганизацияДиадок.ID);
		КонецЦикла;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	
	
	Если Параметры.Свойство("ДополнительныеПараметры") Тогда 		
		АдресВХ = Параметры.ДополнительныеПараметры;
		ПоместитьВоВременноеХранилище(ТЗКонтрагентыДиадок,АдресВХ);
	КонецЕсли;
	
КонецФункции

// Мещеряков Алексей 31.07.2025 Выполнение задач №000054634
Функция ТаблицаКонтрагентыПриоритет() 
	
	ТипБулево 				 = Новый ОписаниеТипов("Булево");
	ТипСтрока 				 = Новый ОписаниеТипов("Строка");                
	ТипСправочникДиадок 	 = Новый ОписаниеТипов("СправочникСсылка.Диадок_ЮрФизЛица");
	ТипСправочникКонтрагенты = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	
	ТЗКонтрагентыДиадок = Новый ТаблицаЗначений;
	
	ТЗКонтрагентыДиадок.Колонки.Добавить("Приоритет",ТипБулево);
	ТЗКонтрагентыДиадок.Колонки.Добавить("Оператор",ТипСтрока);
	ТЗКонтрагентыДиадок.Колонки.Добавить("ОрганизацияДиадок",ТипСправочникДиадок);
	ТЗКонтрагентыДиадок.Колонки.Добавить("КонтрагентДиадок",ТипСправочникДиадок);
	ТЗКонтрагентыДиадок.Колонки.Добавить("Контрагент1с",ТипСправочникКонтрагенты);
		
	Возврат ТЗКонтрагентыДиадок;
	
КонецФункции	

