	               |	Контрагенты.Ссылка КАК Контрагент
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
	               |		ПО Контрагенты.Ссылка = Диадок_ЮрФизЛица.СвязанныйСправочник1
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ИНН = &ИНН
	               |	И Контрагенты.КПП = &КПП
	               |	И Диадок_ЮрФизЛица.Ссылка = &Ссылка
	               |	И Диадок_ЮрФизЛица.ИмяСправочника = ""Контрагенты""
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
	               |		ПО Контрагенты.Ссылка = Диадок_ЮрФизЛица.СвязанныйСправочник2
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ИНН = &ИНН
	               |	И Контрагенты.КПП = &КПП
	               |	И Диадок_ЮрФизЛица.Ссылка = &Ссылка
	               |	И Диадок_ЮрФизЛица.ИмяСправочника = ""Контрагенты""
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
	               |		ПО Контрагенты.Ссылка = Диадок_ЮрФизЛица.СвязанныйСправочник3
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ИНН = &ИНН
	               |	И Контрагенты.КПП = &КПП
	               |	И Диадок_ЮрФизЛица.Ссылка = &Ссылка
	               |	И Диадок_ЮрФизЛица.ИмяСправочника = ""Контрагенты""
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица.ДополнительныеРеквизиты КАК Диадок_ЮрФизЛицаДополнительныеРеквизиты
	               |		ПО Контрагенты.Ссылка = Диадок_ЮрФизЛицаДополнительныеРеквизиты.Значение
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ИНН = &ИНН
	               |	И Контрагенты.КПП = &КПП
	               |	И Диадок_ЮрФизЛицаДополнительныеРеквизиты.Ссылка = &Ссылка
	               |	И Диадок_ЮрФизЛицаДополнительныеРеквизиты.Ссылка.ИмяСправочника = ""Контрагенты""";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("Ссылка", Контрагент_ОрганизацияЭДО);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		
		НайденнаяОрганизация = Выборка.Контрагент;
		
	КонецЕсли;
	
	Возврат НайденнаяОрганизация;
	
