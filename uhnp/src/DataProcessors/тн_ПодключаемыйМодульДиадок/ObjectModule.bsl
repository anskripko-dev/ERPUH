Процедура ПереопределитьКонтрагента1с(СтрокаСписка)
	
	Если ЗначениеЗаполнено(СтрокаСписка.Документ) Тогда
		Возврат;
	Конецесли;	
	
	ОпределитьМодули();
		
	Идентификаторы = Новый Структура;
	
	Идентификаторы.Вставить("BoxId",		"");
	Идентификаторы.Вставить("LetterId",		"");
	Идентификаторы.Вставить("DocumentId",	"");
	
	ТекДокумент = СтрокаСписка.ДокументЭДО;  
	
	Попытка 	 
		ЗаполнитьЗначенияСвойств(Идентификаторы,ТекДокумент);
		
		ХранилищеКонтента = Модуль_Ядро.Документы_Расшифровать(Идентификаторы);
		ДеревоКонтента = ОсновнойМодуль.XML_В_XDTO(ХранилищеКонтента.Данные);
		
		Если Не ДеревоКонтента.Документ.Свойства().Получить("СвКСчФ") = Неопределено Тогда
			ИНН = ДеревоКонтента.Документ.СвКСчФ.СвПрод.ИдСв.СвЮЛУч.ИННЮЛ;
			КПП = ДеревоКонтента.Документ.СвКСчФ.СвПрод.ИдСв.СвЮЛУч.КПП;
		ИначеЕсли Не ДеревоКонтента.Документ.СвСчФакт.Свойства().Получить("ГрузОт") = Неопределено 
			И Не ДеревоКонтента.Документ.СвСчФакт.ГрузОт.Свойства().Получить("ГрузОтпр")  = Неопределено Тогда
			ИНН = ДеревоКонтента.Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвЮЛУч.ИННЮЛ;
			КПП = ДеревоКонтента.Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвЮЛУч.КПП;
		Иначе						
			ИНН = ДеревоКонтента.Документ.СвСчФакт.СвПрод.ИдСв.СвЮЛУч.ИННЮЛ;
			КПП = ДеревоКонтента.Документ.СвСчФакт.СвПрод.ИдСв.СвЮЛУч.КПП;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) Тогда	
			Контрагент = ПереопределениеКонтрагентаПоИННКПП(ИНН, КПП, ТекДокумент.КонтрагентДиадок);
			Если ЗначениеЗаполнено(Контрагент) Тогда
				ДокументЭДООбъект = ТекДокумент.ПолучитьОбъект();
				ДокументЭДООбъект.Контрагент = Контрагент;
				ДокументЭДООбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

