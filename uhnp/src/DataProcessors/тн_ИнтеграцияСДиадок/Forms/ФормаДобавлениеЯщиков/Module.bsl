	ЗначениеВРеквизитФормы(ВременнаяТаблица, "ТаблицаНеподключенныхОрганизаций");
	
КонецПроцедуры

&НаКлиенте
функция ПредставлениеОрганизацииВТаблице(ИНН, КПП)
		
	ТаблицаОрганизаций = СвернутьМассивСтруктур(ТаблицаДанныхОрганизаций, Новый Структура("ИНН, КПП, Организация"));
	ОрганизацииПоИННКПП = НайтиСтрокиВМассивеСтруктур(ТаблицаОрганизаций, Новый структура("ИНН, КПП", ИНН, КПП));
	
	Возврат ОрганизацииПоИННКПП;
		
КонецФункции

&НаКлиенте
процедура УстановитьПраметрыЯщикаВТаблице(стр, ИНН, КПП)
	//ТаблицаЯщиков  =  ТаблицаДанныхОрганизаций.Скопировать();
	ТаблицаЯщиков = СвернутьМассивСтруктур(ТаблицаДанныхОрганизаций, Новый Структура("ИНН, КПП, Наименование, OrganizationId, DepartmentKpp"));
	
	ЯщикиОрганизации = НайтиСтрокиВМассивеСтруктур(ТаблицаЯщиков, Новый структура("ИНН, КПП", ИНН, КПП));
	Если ЯщикиОрганизации.количество()=1 тогда 
		стр.ящикДиадок 	= ЯщикиОрганизации[0].Наименование;
		стр.OrganizationId		= ЯщикиОрганизации[0].OrganizationId;
		стр.DepartmentKpp		= ЯщикиОрганизации[0].DepartmentKpp;
	Иначе 
		стр.ящикДиадок = "Выберите ящик"
	КонецЕсли;  
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьСОрганизациейСервиса(Организация, ИдентификаторЭДО, ИдентификаторЯщика, КПППодразделения = "")
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	МетодСервера(, "УстановитьСвязьСОрганизациейСервиса"
		, Организация
		, ИдентификаторЭДО
		, ИдентификаторЯщика
		, КПППодразделения);
	
КонецПроцедуры

&НаСервере
Процедура РазорватьСвязьСОрганизациейСервиса(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	МетодСервера(, "РазорватьСвязьСОрганизациейСервиса", Организация);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкуОтправкиПоУмолчанию(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоУмолчанию = "СЧФДОП_820_736";
	ТекущееЗначение = МетодСервера(, "НастройкаОтправкиДокументов", Организация);
	
	Если Не ЗначениеЗаполнено(ТекущееЗначение) Тогда
		
		МетодСервера(, "УстановитьНастройкуОтправкиДокументов"
			, Организация
			, ЗначениеПоУмолчанию);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	
	УстановитьСвязиНаСервере();
	
	Закрыть(Истина);

КонецПроцедуры

&НаСервере
Процедура УстановитьСвязиНаСервере()
	
	НачатьТранзакцию();
	
	Попытка
		
		РазорватьСтарыеСвязи(СписокОрганизаций);
		УстановитьНовыеСвязи(СписокОрганизаций);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура РазорватьСтарыеСвязи(ТекущийРодитель)
	
	ПодчиненныеСтроки = ТекущийРодитель.ПолучитьЭлементы();
	
	Для Каждого Строка Из ПодчиненныеСтроки Цикл
		
		Если Строка.ОрганизацияСтарая <> Строка.Организация Тогда
			РазорватьСвязьСОрганизациейСервиса(Строка.ОрганизацияСтарая);
		КонецЕсли;
		
		РазорватьСтарыеСвязи(Строка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНовыеСвязи(ТекущийРодитель)
	
	ПодчиненныеСтроки = ТекущийРодитель.ПолучитьЭлементы();
	
	Для Каждого Строка Из ПодчиненныеСтроки Цикл
		
		ТекущаяОрганизация = Строка.Организация;
		
		Если ТекущаяОрганизация <> Строка.ОрганизацияСтарая Тогда
			
			УстановитьСвязьСОрганизациейСервиса(ТекущаяОрганизация
				, Строка.FnsParticipantId
				, Строка.OrganizationId
				, Строка.DepartmentKpp);
			
			УстановитьНастройкуОтправкиПоУмолчанию(ТекущаяОрганизация);
			
		КонецЕсли;
		
		УстановитьНовыеСвязи(Строка);
		
	КонецЦикла;
	
КонецПроцедуры

