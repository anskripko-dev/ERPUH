	&НаКлиенте
	Процедура НачатьИнициализациюМодуля()
		
		Если Платформа.ПараметрыКлиент.КонтекстРаботаССерверомДиадок <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ИнициализироватьМодуль", 0.1, Истина);
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ИнициализироватьМодуль() Экспорт
		
		Отказ = Ложь;
		
		ПроверитьОбъектыБазыДанных(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ПроверитьЧтоМодульИнтеграцииОпределен(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ПроверитьИнтернетПодключение(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ПодключитьКомпонентуДиадока(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		СоздатьОбъектКомпонентыДиадока(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ДополнитьДанныеДляОбновленияМодуля();
		ОбновитьМодульАвтоматически(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если Объект.ПараметрыКлиентСервер.ВызовИзРасширения Тогда
			ПродолжитьИнициализациюМодуля();
		Иначе
			ПроверитьНаличиеУведомлений();
		КонецЕсли;
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ПродолжитьИнициализациюМодуляОтложенно()
		
		ИнтервалОжидания = 0.1;
		Однократно = Истина;
		
		ПодключитьОбработчикОжидания(
			"ПродолжитьИнициализациюМодуля",
			ИнтервалОжидания,
			Однократно
		);
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ПродолжитьИнициализациюМодуля()
		
		Отказ = Ложь;
		
		ПроверитьНаличиеМодуляИнтеграции(Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ИнициализироватьСтруктуруИнтервалов();
		
		// НАЧАЛО Федоров С 03.09.2021 Выполнение задач №000038925
		//Если авторизация не прошла, то прекращаем инициализацию
		//АвторизоватьсяИЗаполнитьКонтекст(Истина);
		АвторизоватьсяИЗаполнитьКонтекст(Истина, Отказ);
		
		Если Отказ 
			// НАЧАЛО Ситалов Д. 03.09.2021 Выполнение задач №000038925
			И ЭтаФорма.Открыта()
			// КОНЕЦ Ситалов Д. 03.09.2021 Выполнение задач №000038925
			Тогда
			ЭтаФорма.Закрыть();
			Возврат;
		КонецЕсли;
		// КОНЕЦ Федоров С 03.09.2021 Выполнение задач №000038925
		
		НачатьСборСтатистики();
		
		НачатьПроверкуАктуальностиНастройкиФорматовОтправки();
		
	КонецПроцедуры

	&НаКлиенте
	Процедура НачатьПроверкуАктуальностиНастройкиФорматовОтправки()
		
		ЕстьНастройкаОтправкиВУстаревшемФормате = Ложь;
		ПодключитьОбработчикОжидания("ПроверитьАктуальностиНастройкиФорматовОтправки", 0.1, Истина);
		
	КонецПроцедуры
	
	// Проверяет настройки отправки документов по всем организациям и контрагентам контекста
	// и, если хотя бы у одной организации или контрагента есть настройка, позволяющая отправлять
	// документы в устаревших форматах, показывает форму с текстом предупреждения
	// о необходимости изменить настройки отправки.
	//
	// Процедура вызывается при каждом открытии модуля.
	//
	&НаКлиенте
	Процедура ПроверитьАктуальностиНастройкиФорматовОтправки() Экспорт
		
		УстревшиеНастройки = МетодСервераБезКонтекста(,"ОрганизацииИКонтрагентыСУтаревшимиНастройкамиОтправки");
		
		ЕстьНастройкаОтправкиВУстаревшемФормате = УстревшиеНастройки.ЕстьУстаревшее;
		
		СохраненнаяВерсияМодуля = Объект.ПараметрыКлиентСервер.СохраненнаяВерсияМодуля;
		ТекущаяВерсияМодуля = Объект.ПараметрыКлиентСервер.ВерсияОбработки;
		
		Если ЕстьНастройкаОтправкиВУстаревшемФормате Тогда
			
			Если МетодКлиента("Модуль_Клиент", "СравнитьВерсии", ТекущаяВерсияМодуля, СохраненнаяВерсияМодуля) > 0 Тогда
				
				МетодСервераБезКонтекста(
					, "ВыполнитьУстановкуРекомендуемыхНастроекОтправки"
					, УстревшиеНастройки.ОрганизацииИБ
					, УстревшиеНастройки.КонтрагентыИБ);
					
				ПоказатьСообщениеОбАвтоматическомОбновленииНастроекОтправки(УстревшиеНастройки);
				
				Оповестить("ИзмененыНастройкиОтправки");
				
			Иначе
				
				ПоказатьПредупреждениеОбУстаревшихНастройкахОтправки();
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СохраненнаяВерсияМодуля <> ТекущаяВерсияМодуля Тогда
			МетодСервераБезКонтекста(, "СохранитьНастройкуСохраненнаяВерсияМодуля", ТекущаяВерсияМодуля);
			Объект.ПараметрыКлиентСервер.СохраненнаяВерсияМодуля = ТекущаяВерсияМодуля;
		КонецЕсли; 
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ЗапуститьМодуль()
		
		УправлениеФормой();
		ПредложитьУстановкуРасширенияКонфигурации();
		
		ПанельРежимовПриСменеСтраницы("", Элементы.ПанельРежимов.ТекущаяСтраница);
		
		МетодКлиента("Модуль_Клиент", "ЗаполнитьИдентификаторыЭДО");
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура КомандаИзменитьпараметрыПодключенияПрокси(Команда)
		
		МетодКлиента( , "ОткрытьФормуОбработкиМодально",
						"НастройкаПроксиСервера",
						,
						,
						"ОбработчикОткрытияФормыНастройкаПроксиСервера",
						,
						ЭтаФорма);
		
	КонецПроцедуры
					
	&НаСервере
	Функция ПолучитьОписаниеКонфигурацииДляДиадок(ОписаниеКонтекстаРасширения="") 
		
		ОписаниеКонфигурации = Метаданные.Синоним + " ("+Метаданные.Версия+")";
		ОписаниеКонфигурации = ОписаниеКонфигурации + " extention: "+ОписаниеКонтекстаРасширения;
		
		Возврат ОписаниеКонфигурации;
				
	КонецФункции
	
	&НаКлиенте
//НАЧАЛО Федоров С 03.09.2021 Выполнение задач №000038925
	//Процедура СоздатьОбъектКомпонентыДиадока(Отказ)
	Процедура СоздатьОбъектКомпонентыДиадока(Отказ, ПоказыватьПредупреждения = Истина)
//КОНЕЦ Федоров С 03.09.2021 Выполнение задач №000038925
		
		Попытка
			
			ОбъектКомпоненты = МетодКлиента("Модуль_Клиент", "НовыйОбъектКомпонентыДиадока");
			
		Исключение
			
			Отказ = Истина;
			
//НАЧАЛО Федоров С 03.09.2021 Выполнение задач №000038925
			Если ПоказыватьПредупреждения Тогда
//КОНЕЦ Федоров С 03.09.2021 Выполнение задач №000038925
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				
				ПараметрыФормы = НовыеПараметрыФормыВыводаОшибки();
				ПараметрыФормы.ОписаниеОшибки	 = НСтр("ru = 'Ошибка создания объекта внешней компоненты'");
				ПараметрыФормы.Подробности		 = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ОткрытьФормуВыводаОшибки(ПараметрыФормы, Истина);
//НАЧАЛО Федоров С 03.09.2021 Выполнение задач №000038925
			КонецЕсли;
//КОНЕЦ Федоров С 03.09.2021 Выполнение задач №000038925
			Возврат;
			
		КонецПопытки;
		
		КонтекстРасширения	 = Платформа.ПараметрыКлиент.УстановкаРасширения.КонтекстРасширения;
