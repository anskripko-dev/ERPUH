	&НаКлиенте
	Процедура ДобавитьСтатистику_Авторизация()
		
		Переменные = Новый Структура;
		
		Переменные.Вставить("ОтправкаФайловСтарыйИнтерфейс"	, ОтправкаФайловСтарыйИнтерфейс);
		Переменные.Вставить("ЖурналыДокументовПоказать"		, ЖурналыДокументовПоказать);
		Переменные.Вставить("ТочностьЦеныСФ"				, ТочностьЦеныСФ);
		Переменные.Вставить("ФормаВводаНакладной"			, ИспользоватьФормуВводаНакладной);
		Переменные.Вставить("ИспользоватьСервисКонтурМаркировка", ИспользоватьСервисКонтурМаркировка);
		Переменные.Вставить("ИспользоватьПМ"				, ИспользоватьПодключаемыйМодуль);
		Переменные.Вставить("РежимСовместимостиФорматов"	, РежимСовместимостиФорматов155и820);
				
		ТехническаяИнформация = МетодКлиента("Модуль_Клиент", "ТехническаяИнформация");
		
		Переменные.Вставить("МестоХраненияПМ"				, ТехническаяИнформация.ИнформацияПМ.Размещение);
		Переменные.Вставить("DiadocUserID"					, ТехническаяИнформация.UserId);
		
		ТекущийРежимПроксиКомпоненты = МетодКлиента("Модуль_РаботаССерверомДиадок", "ПолучитьТекущийРежимПрокси");
		РежимПроксиМодуля = МетодКлиента("Модуль_Клиент", "РежиПроксиКомпонентыВРежимПроксиМодуля", ТекущийРежимПроксиКомпоненты);
		
		Переменные.Вставить("РежимПрокси", РежимПроксиМодуля.Представление);
						
		Если Платформа.Объект.ПараметрыКлиентСервер.ФайловыйРежимРаботы Тогда
			ВариантИБ = "Файловая";
		Иначе
			ВариантИБ = "Серверная";
		КонецЕсли;
		Переменные.Вставить("ВариантИБ", ВариантИБ);
		
		ОтключеноАвтоматическоеОбновлениеМодуля = МетодКлиента("Модуль_Клиент", "ОтключеноАвтоматическоеОбновлениеМодуля");
		
		Переменные.Вставить("ОтключеноАвтоматическоеОбновлениеМодуля", ОтключеноАвтоматическоеОбновлениеМодуля);
		Переменные.Вставить("BaseId", Объект.ПараметрыКлиентСервер.ИдентификаторБазы);
		
		ДополнитьПеременныеАвторизацииНаСервере(Переменные);
		
		МетодКлиента("Модуль_Клиент", "Метрика_ДобавитьСтатистику_Авторизации", Переменные);
		
	КонецПроцедуры
	
	&НаСервере
	Процедура ДополнитьПеременныеАвторизацииНаСервере(Переменные)
				
		РежимСовместимостиПлатформы = Строка(Метаданные.РежимСовместимости);
		РежимСовместимостиПлатформы = СтрЗаменить(РежимСовместимостиПлатформы, "Версия", "");
						
		Переменные.Вставить("РежимСовместимостиПлатформ", РежимСовместимостиПлатформы);
		
		// реализован альтернативный вариант определения местонахождения модуля, т.к. при добавлении в версию
		// данных о номере сборки, не корректно работает механизм поиска в доп. обработках. 
		// Длина полной версии модуля превышает допустимую в типовой конфигурации.
		
		ОбработкаОбъект = ОбработкаОбъект();
		
		ЗначениеСвойства = "";
		ЕстьСвойство_ИспользуемоеИмяФайла = МетодСервера("", "ЕстьРеквизитИлиСвойствоОбъекта", ОбработкаОбъект, "ИспользуемоеИмяФайла", ЗначениеСвойства);
		
		ПолноеИмяОбработки 	= ОбработкаОбъект().Метаданные().ПолноеИмя();
		ЭтоВнешняяОбработка = (Найти(ПолноеИмяОбработки, "ВнешняяОбработка.") = 1);
		
		Если ЭтоВнешняяОбработка
			И ЕстьСвойство_ИспользуемоеИмяФайла
			И Найти(ЗначениеСвойства, "e1cib\") > 0 Тогда 
			
			РасположениеМодуля = "в справочнике";
			
		ИначеЕсли ЭтоВнешняяОбработка Тогда
			РасположениеМодуля = "на диске";
		ИначеЕсли Найти(ПолноеИмяОбработки, "Обработка.") = 1 Тогда
			РасположениеМодуля = "в конфигурации";
		Иначе
			РасположениеМодуля = "не удалось определить";
		КонецЕсли;
						
		Переменные.Вставить("РасположениеМодуля", РасположениеМодуля);
		
	КонецПроцедуры
	
