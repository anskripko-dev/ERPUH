&НаКлиенте
Функция ЕстьОнлайнСчетаНаОплату()
	
	Результат = Ложь;
	КонтекстДиадока = Платформа.ПараметрыКлиент.КонтекстДиадока;
	
	Для Каждого ЭлементКонтекста Из КонтекстДиадока Цикл
		
		Если ЭлементКонтекста.ЗаблокированаПоAPI Тогда 
			Продолжить;
		КонецЕсли;
		
		Token 								= ЭлементКонтекста.Connection.Token;
		СтруктураОрганизации 				= Новый Структура("Наименование, BoxId");
		СтруктураОрганизации.Наименование 	= ЭлементКонтекста.ДанныеОрганизации.Name;
		СтруктураОрганизации.BoxId 			= ЭлементКонтекста.BoxId;
		
		AccountID 							= МетодКлиента("Модуль_Клиент", "ИдентификаторЛицевогоСчетаДиадок", СтруктураОрганизации.BoxId, Token);
		Результат 							= МетодКлиента("Модуль_Клиент", "ЕстьОнлайнСчетаНаОплату", AccountID, Token);
		
		Если Результат Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции 
