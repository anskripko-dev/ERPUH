		ИначеЕсли Режим = "Сопоставление" Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ФорматДокумента", ФорматЭД);
			ПараметрыФормы.Вставить("BoxID", 				ЭДОбъект.OrganizationID);
