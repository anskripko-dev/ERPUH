		Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
			
			СтруктураSigner = МетодСервера(, "ПолучитьДанныеПодписиСогласующим", Организация);
			ПодписатьИОтправить_ПодписаниеЗапрошенного(СтруктураSigner, ДополнительныеПараметры.Document);
			
		КонецЕсли;
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ПодписатьИОтправить_ПодписаниеЗапрошенного(СтруктураSigner, Document) 
		
		ТребуетсяМЧД = МодульКлиент_ТребуетсяМЧД();
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СтруктураSigner"	, СтруктураSigner);
		ДополнительныеПараметры.Вставить("Document"			, Document);
		ДополнительныеПараметры.Вставить("ТребуетсяМЧД"		, ТребуетсяМЧД);		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодписатьИОтправить_ПодписаниеЗапрошенногоЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ТребуетсяМЧД Тогда
			МодульКлиент_ОткрытьФормуВыбораДоверенностиПриОтправке(ОписаниеОповещения);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);		
		КонецЕсли;
		
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ПодписатьИОтправить_ПодписаниеЗапрошенногоЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
		ТребуетсяМЧД		= МетодКлиента("Модуль_Клиент", "СвойствоСтруктуры", ДополнительныеПараметры, "ТребуетсяМЧД", Ложь);
		РазрешитьДействие	= МетодКлиента("Модуль_Клиент", "СвойствоСтруктуры", Результат, "РазрешитьДействие", Ложь);
				
		Если ТребуетсяМЧД И Не РазрешитьДействие Тогда
			Возврат;
		КонецЕсли;
			
		СтруктураSigner = ДополнительныеПараметры.СтруктураSigner;
		Document 		= ДополнительныеПараметры.Document;
		КонтрактМЧД		= МетодКлиента("Модуль_Клиент", "СвойствоСтруктуры", Результат, "КонтрактМЧД");
		
		СтруктураРезультатОперации = МетодКлиента("Модуль_РаботаССерверомДиадок", "ПодписатьИОтправить_ПодписаниеЗапрошенного"
			, СтруктураSigner, Document, КонтрактМЧД);
						
		Если СтруктураРезультатОперации.ВыполненоУспешно Тогда 
			ОбновитьЭДОбъект();
		Иначе
			ТекстОшибкиПодписания= СтруктураРезультатОперации.ТекстОшибки;
			
			ПараметрыФормы= Новый Структура();
			ПараметрыФормы.Вставить("Заголовок", 		"Ошибка при подписании документа");
			ПараметрыФормы.Вставить("ОписаниеОшибки", 	"Не удалось подписать документ");
			ПараметрыФормы.Вставить("Подробности", 		ТекстОшибкиПодписания+Символы.ПС+"BoxId: "+Document.OrganizationId+Символы.ПС+"DocumentId: "+Document.DocumentId);
			МетодКлиента(,"ОткрытьФормуОбработкиМодально", "Форма_ВыводОшибки", ПараметрыФормы, ЭтаФорма);
		КонецЕсли;
		
	КонецПроцедуры
		
//} ИНТЕГРАЦИЯ
