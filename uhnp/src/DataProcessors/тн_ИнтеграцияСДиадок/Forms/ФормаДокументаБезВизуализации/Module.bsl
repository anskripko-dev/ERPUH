			ПараметрыФормы.Вставить("DocumentDate", 		ЭДОбъект.DocumentDate);
			ПараметрыФормы.Вставить("DocumentNumber", 		ЭДОбъект.DocumentNumber);
			ПараметрыФормы.Вставить("Total",				ЭДОбъект.Total);
