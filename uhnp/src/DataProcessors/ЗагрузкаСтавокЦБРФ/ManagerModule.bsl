	Для Каждого ТекОбъект Из ПолученныеДанные Цикл
		ДатаСтавки 	= Сериализатор.XMLЗначение(Тип("Дата"), ТекОбъект.DT);
		Попытка
			ЗначениеСтавки = Сериализатор.XMLЗначение(Тип("Число"), ТекОбъект[КодСтавки]);
		Исключение
			ШаблонТекстаОшибки = НСтр("ru = 'Не удалось получить значение ставки %1'");
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонТекстаОшибки, ВидСтавки));
			Продолжить;
		КонецПопытки;
		
		НоваяСтавка					= ТаблицаЗначенийСтавок.Добавить();
		НоваяСтавка.ДатаСтавки 		= ДатаСтавки;
		НоваяСтавка.ЗначениеСтавки 	= ЗначениеСтавки;	
	КонецЦикла;
	
	
	ТаблицаЗначенийСтавок.Сортировать("ДатаСтавки");

	Для каждого СтрокаСтавки Из ТаблицаЗначенийСтавок Цикл
		Если ТекущаяСтавка = СтрокаСтавки.ЗначениеСтавки Тогда 
			Продолжить;
		КонецЕсли;			
		НоваяЗапись = ТаблицаСтавок.Добавить();
		НоваяЗапись.Период 			= СтрокаСтавки.ДатаСтавки;
		НоваяЗапись.ВидКотировки 	= ВидСтавки;
		НоваяЗапись.Значение 		= СтрокаСтавки.ЗначениеСтавки;
		
		ТекущаяСтавка = СтрокаСтавки.ЗначениеСтавки;
		
		
	КонецЦикла; 
		
	
КонецПроцедуры

Функция ПереченьСтавок() Экспорт 
	
	РезультатФункции = Новый Массив;
	
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'KeyRate'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'RUONIA_Index'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'Standard_RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'RUONIA_AVG_1M'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'RUONIA_AVG_3M'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	ДобавитьКотировку(РезультатФункции,НСтр("ru = 'RUONIA_AVG_6M'", ОбщегоНазначения.КодОсновногоЯзыка()));
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТекущаяСтавкаЦБРФ(НачалоПериодаЗагрузки, ВидКотировки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияКотировокФИСрезПоследних.ВидКотировки КАК ВидКотировки,
		|	ЗначенияКотировокФИСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(&Дата, ) КАК ЗначенияКотировокФИСрезПоследних
		|ГДЕ
		|	ЗначенияКотировокФИСрезПоследних.ВидКотировки = &ВидКотировки";
	
	Запрос.УстановитьПараметр("Дата", 			НачалоДня(НачалоПериодаЗагрузки) - 1);   
	Запрос.УстановитьПараметр("ВидКотировки", 	ВидКотировки);
	
	РезультатЗапроса 		= Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи 	= РезультатЗапроса.Выбрать();
	
	ТекущаяСтавка  			= 0;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущаяСтавка		= ВыборкаДетальныеЗаписи.Значение;
	КонецЦикла;

	Возврат ТекущаяСтавка;
КонецФункции // ()

Процедура ЗагрузитьСтавкиCbr(НачалоПериодаЗагрузки = Неопределено, ОкончаниеПериодаЗагрузки = Неопределено, ИспользуемыеСтавки = Неопределено) Экспорт
	
	ТаблицаСтавок 	= РегистрыСведений.ЗначенияКотировокФИ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ИнтернетПрокси 	= ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
   	Прокси 		   	= WSСсылки.WSЕжедневныеДанныеЦБ.СоздатьWSПрокси("http://web.cbr.ru/", "DailyInfo", 	"DailyInfoSoap" , ИнтернетПрокси);
    КлючеваяСтавкаЦБРФ 		= Справочники.ВидыКотировокФинансовыхИнструментов.НайтиПоРеквизиту("ИдентификаторДляЗагрузки", НСтр("ru = 'KeyRate'", ОбщегоНазначения.КодОсновногоЯзыка()));
	КлючеваяСтавкаRUONIA 	= Справочники.ВидыКотировокФинансовыхИнструментов.НайтиПоРеквизиту("ИдентификаторДляЗагрузки", НСтр("ru = 'Standard_RUONIA'", ОбщегоНазначения.КодОсновногоЯзыка()));
	
	//  загрузка ключевых ставок
	Если ИспользуемыеСтавки.Найти(КлючеваяСтавкаЦБРФ, "ВидСтавки") <> Неопределено Тогда
		// Инициализация.
		Сериализатор 	= Новый СериализаторXDTO(Прокси.ФабрикаXDTO);
		ТипWSПараметра 		= Прокси.ФабрикаXDTO.Пакеты.Получить("http://web.cbr.ru/").Получить("KeyRateXML"); 
		WSПараметр			= Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
		WSПараметр.fromDate	= НачалоПериодаЗагрузки;	
		WSПараметр.ToDate	= ОкончаниеПериодаЗагрузки;
		СписокСтавокЦБРФ	= Прокси.KeyRateXML(WSПараметр);
		
		Если СписокСтавокЦБРФ.KeyRateXMLResult.Свойства().Получить("KeyRate") 		= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ключевой ставки ЦБ РФ'"));
			Возврат;
		КонецЕсли;	
		
		Если  СписокСтавокЦБРФ.KeyRateXMLResult.KeyRate.Свойства().Получить("KR") 	= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ключевой ставки ЦБ РФ'"));
			Возврат;
		КонецЕсли;
		
		ПолученныеДанные 	= СписокСтавокЦБРФ.KeyRateXMLResult.KeyRate.KR;
		ТекущаяСтавка		= ТекущаяСтавкаЦБРФ(НачалоПериодаЗагрузки, КлючеваяСтавкаЦБРФ);
		Если ТипЗнч(ПолученныеДанные) = Тип("ОбъектXDTO") Тогда
			ДобавитьСтавкиЦБЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор, КлючеваяСтавкаЦБРФ, ТекущаяСтавка);
		ИначеЕсли ТипЗнч(ПолученныеДанные) = Тип("СписокXDTO") Тогда
			ДобавитьСписокСтавокЦБЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор, КлючеваяСтавкаЦБРФ, ТекущаяСтавка);
		КонецЕсли;
		
	КонецЕсли;     
	
	// Загрузка ставок RUONIA
	Если ИспользуемыеСтавки.Найти(КлючеваяСтавкаRUONIA, "ВидСтавки") <> Неопределено Тогда
		
		Сериализатор 	= Новый СериализаторXDTO(Прокси.ФабрикаXDTO);
		ТипWSПараметра 		= Прокси.ФабрикаXDTO.Пакеты.Получить("http://web.cbr.ru/").Получить("Ruonia"); 
		WSПараметр			= Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
		WSПараметр.fromDate	= НачалоПериодаЗагрузки;	
		WSПараметр.ToDate	= ОкончаниеПериодаЗагрузки;
		СписокRuonia 		= Прокси.RuoniaXML(WSПараметр);
		
		Если СписокRuonia.RuoniaXMLResult.Свойства().Получить("Ruonia") 		= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ставки Ruonia'"));
		ИначеЕсли	СписокRuonia.RuoniaXMLResult.Ruonia.Свойства().Получить("ro") 	= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ставки Ruonia'"));
		Иначе
			ПолученныеДанные 	= СписокRuonia.RuoniaXMLResult.Ruonia.ro;
			ТекущаяСтавка		= ТекущаяСтавкаЦБРФ(НачалоПериодаЗагрузки, КлючеваяСтавкаRUONIA);
			Если ТипЗнч(ПолученныеДанные) = Тип("ОбъектXDTO") Тогда
				ДобавитьRuoniaЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор, КлючеваяСтавкаRUONIA, ТекущаяСтавка);
			ИначеЕсли ТипЗнч(ПолученныеДанные) = Тип("СписокXDTO") Тогда
				ДобавитьСписокСтавокRuoniaЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор, КлючеваяСтавкаRUONIA, ТекущаяСтавка);
			КонецЕсли;
		КонецЕсли;	       
	КонецЕсли;	
		
	// Загрузка ставок RUONIASV	
	Если ИспользуемыеСтавки.НайтиСтроки(Новый Структура("КодСтавки", "RUONIA_AVG_1M")).Количество()
		ИЛИ ИспользуемыеСтавки.НайтиСтроки(Новый Структура("КодСтавки", "RUONIA_AVG_3M")).Количество()
		ИЛИ ИспользуемыеСтавки.НайтиСтроки(Новый Структура("КодСтавки", "RUONIA_AVG_6M")).Количество()
		ИЛИ ИспользуемыеСтавки.НайтиСтроки(Новый Структура("КодСтавки", "RUONIA_Index")).Количество()
		Тогда
		
		Сериализатор 	= Новый СериализаторXDTO(Прокси.ФабрикаXDTO);
		
		ТипWSПараметра 		= Прокси.ФабрикаXDTO.Пакеты.Получить("http://web.cbr.ru/").Получить("RuoniaSV"); 
		WSПараметр			= Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
		WSПараметр.fromDate	= НачалоПериодаЗагрузки;	
		WSПараметр.ToDate	= ОкончаниеПериодаЗагрузки;
		СписокRuoniaSV 		= Прокси.RuoniaSVXML(WSПараметр);
		
		Если СписокRuoniaSV.RuoniaSVXMLResult.Свойства().Получить("RuoniaSV") 	= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ставки RuoniaSV'"));
		ИначеЕсли  СписокRuoniaSV.RuoniaSVXMLResult.RuoniaSV.Свойства().Получить("ra") 	= Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для выбранного периода нет данных для загрузки ставки RuoniaSV'"));
		Иначе
			ПолученныеДанные 	= СписокRuoniaSV.RuoniaSVXMLResult.RuoniaSV.ra;
			Если ТипЗнч(ПолученныеДанные) = Тип("ОбъектXDTO") Тогда
				ДобавитьRuoniaSVЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор, ИспользуемыеСтавки);
			ИначеЕсли ТипЗнч(ПолученныеДанные) = Тип("СписокXDTO") Тогда
				ДобавитьСписокСтавокRuoniaSVЗаДень(ПолученныеДанные, ТаблицаСтавок, Сериализатор,  ИспользуемыеСтавки);
			КонецЕсли;
		КонецЕсли;  
		
	КонецЕсли;
  	
	Для Каждого ТекСтрокаТаблицы Из ТаблицаСтавок Цикл
		
		МенеджерЗаписи = РегистрыСведений.ЗначенияКотировокФИ.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ТекСтрокаТаблицы);
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКотировку(МассивКотировок, НаименованиеСтавки)
	
	НайденнаяКотировка = Справочники.ВидыКотировокФинансовыхИнструментов.НайтиПоРеквизиту("ИдентификаторДляЗагрузки", НаименованиеСтавки); 
	Если ЗначениеЗаполнено(НайденнаяКотировка) Тогда
		МассивКотировок.Добавить(НайденнаяКотировка);	    	
	КонецЕсли;

КонецПроцедуры// ()

