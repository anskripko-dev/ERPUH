#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьСтавки(НачалоПериодаЗагрузки = Неопределено, ОкончаниеПериодаЗагрузки = Неопределено, ИспользуемыеСтавки = Неопределено) Экспорт
	
	Если ИспользуемыеСтавки = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыКотировокФинансовыхИнструментов.Ссылка КАК ВидСтавки,
		|	ВидыКотировокФинансовыхИнструментов.ИдентификаторДляЗагрузки КАК КодСтавки
		|ИЗ
		|	Справочник.ВидыКотировокФинансовыхИнструментов КАК ВидыКотировокФинансовыхИнструментов
		|ГДЕ
		|	ВидыКотировокФинансовыхИнструментов.Ссылка В(&Индикаторы)";
		
		Запрос.УстановитьПараметр("Индикаторы", ПереченьСтавок());
		ИспользуемыеСтавки = Запрос.Выполнить().Выгрузить();
	КонецЕсли;

	Если НачалоПериодаЗагрузки = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(НачалоПериодаЗагрузки) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ЗначенияКотировокФИСрезПоследних.Период) КАК Период
		|ИЗ
		|	РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(
		|			,
		|			ВидКотировки В
		|				(&Индикаторы)) КАК ЗначенияКотировокФИСрезПоследних";
		
		Запрос.УстановитьПараметр("Индикаторы", ИспользуемыеСтавки.ВыгрузитьКолонку("ВидСтавки"));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НачалоПериодаЗагрузки = Выборка.Период;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(НачалоПериодаЗагрузки) Тогда
			НачалоПериодаЗагрузки = ДобавитьМесяц(ТекущаяДатаСеанса(), -12);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОкончаниеПериодаЗагрузки = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеПериодаЗагрузки) Тогда
		ОкончаниеПериодаЗагрузки = ТекущаяДатаСеанса() + 86400;
	КонецЕсли;
	
	ЗагрузитьСтавкиCbr(НачалоПериодаЗагрузки, ОкончаниеПериодаЗагрузки , ИспользуемыеСтавки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСтавкиЦБЗаДень(СтрокаОтвета, ТаблицаСтавок, Сериализатор, ВидСтавки, ТекущаяСтавка) 
	
	ДатаСтавки 	= Сериализатор.XMLЗначение(Тип("Дата"), СтрокаОтвета.DT);
	
	КодСтавки 	= "Rate"; 

	Попытка
		ЗначениеСтавки = Сериализатор.XMLЗначение(Тип("Число"), СтрокаОтвета[КодСтавки]);
		Если ЗначениеСтавки = ТекущаяСтавка Тогда 
			Возврат;
		КонецЕсли;	
			
	Исключение
		ШаблонТекстаОшибки = НСтр("ru = 'Не удалось получить значение ставки %1'");
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонТекстаОшибки, ВидСтавки));
		Возврат;
	КонецПопытки;
	
	ТекущаяСтавка = ЗначениеСтавки;
	НоваяЗапись = ТаблицаСтавок.Добавить();
	НоваяЗапись.Период 			= ДатаСтавки;
	НоваяЗапись.ВидКотировки 	= ВидСтавки;
	НоваяЗапись.Значение 		= ЗначениеСтавки
	
КонецПроцедуры       

