&НаКлиенте
Процедура ПересчитатьИтогиПоЗаказу(СтрокаЗаказа)
	
	СтрокаЗаказа.Потребность = 0;
	СтрокаЗаказа.КЗаказу = 0;
	СтрокаЗаказа.СуммаВалютаСоглашения = 0;
	СтрокаЗаказа.СтрокВЗаказе = 0;
	СтрокаЗаказа.Вес = 0;
	
	Для Каждого СтрокаТовар Из СтрокаЗаказа.ПолучитьЭлементы() Цикл
		
		СтрокаТовар.СуммаВалютаСоглашения = СтрокаТовар.КЗаказу * СтрокаТовар.ЦенаВВалютеСоглашения;
		
		СтрокаЗаказа.Потребность = СтрокаЗаказа.Потребность + СтрокаТовар.Потребность;
		СтрокаЗаказа.КЗаказу = СтрокаЗаказа.КЗаказу + СтрокаТовар.КЗаказу;
		СтрокаЗаказа.СуммаВалютаСоглашения = СтрокаЗаказа.СуммаВалютаСоглашения + СтрокаТовар.СуммаВалютаСоглашения;
		СтрокаЗаказа.СтрокВЗаказе   = СтрокаЗаказа.СтрокВЗаказе + СтрокаТовар.СтрокВЗаказе;
		СтрокаЗаказа.Вес = СтрокаЗаказа.Вес + СтрокаТовар.Вес;
		
	КонецЦикла;
	
	Если СтрокаЗаказа.МинимальнаяСуммаЗаказа > 0 И СтрокаЗаказа.МинимальнаяСуммаЗаказа > СтрокаЗаказа.СуммаВалютаСоглашения Тогда
		СтрокаЗаказа.Предупреждение = Истина;
	Иначе
		СтрокаЗаказа.Предупреждение = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНадписьПредупреждения(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные.УровеньВДереве = 0 Тогда
		СтрокаЗаказа = Элемент.ТекущиеДанные;
	Иначе
		СтрокаЗаказа = Элемент.ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	СуммаЗаказа      = Формат(СтрокаЗаказа.СуммаВалютаСоглашения,  "ЧДЦ=2; ЧН=0,00");
	СуммаСоглашения  = Формат(СтрокаЗаказа.МинимальнаяСуммаЗаказа, "ЧДЦ=2; ЧН=0,00");
	СуммаКДозаказу   = Формат(СтрокаЗаказа.МинимальнаяСуммаЗаказа - СтрокаЗаказа.СуммаВалютаСоглашения, "ЧДЦ=2; ЧН=0,00");
	ВалютаСоглашения = Строка(СтрокаЗаказа.ВалютаСоглашения);
	
	Если СтрокаЗаказа.Предупреждение Тогда
		ТекстПредупреждения = НСтр("ru = 'Минимальная сумма заказа по соглашению %1, текущая сумма %2';
									|en = 'Minimum order amount as per agreement %1, current amount %2'");
		ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + НСтр("ru = 'Рекомендуется увеличить сумму заказа на %3';
																		|en = 'It is recommended to increase order amount by %3'");
		
		ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%1", СуммаСоглашения + " " + ВалютаСоглашения);
		ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%2", СуммаЗаказа     + " " + ВалютаСоглашения);
		ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%3", СуммаКДозаказу  + " " + ВалютаСоглашения);
	Иначе
		ТекстПредупреждения = "";
	КонецЕсли;

	Элементы.СтрокаПредупреждение.Заголовок = ТекстПредупреждения;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтрокиВТабличныхЧастяхНаСервере(СтрокиДерева, НовыеЗначения)
	
	ЗаполняемыеПоля =
		"ВалютаСоглашения,
		|ВидЦены,
		|ИсточникОбеспечения,
		|ИсточникОбеспеченияТолькоПросмотр,
		|МинимальнаяСуммаЗаказа,
		|МинимальнаяПартияПоставки,
		|ПеремещениеРазрешено,
		|Склад,
		|Соглашение,
		|СпособОбеспечения,
		|ТипОбеспечения,
		|ЦенаВВалютеСоглашения,
		|ЦенаВВалютеУправленческогоУчета";
	
	Ключ = "СпособОбеспечения,ИсточникОбеспечения,Соглашение,Склад,Номенклатура,Характеристика";
	ТаблицаЗапасы = Объект.Запасы.Выгрузить(, Ключ);
	ТаблицаЗаказыКОбеспечению = Объект.ЗаказыКОбеспечению.Выгрузить(, Ключ);
	
	ТаблицаЗапасы.Индексы.Добавить(Ключ);
	ТаблицаЗаказыКОбеспечению.Индексы.Добавить(Ключ);
	
	ПараметрыОтбора = Новый Структура(Ключ);
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаДерева);
		Если ПараметрыОтбора.ИсточникОбеспечения = Неопределено Тогда
			ПараметрыОтбора.ИсточникОбеспечения = ТекстНеЗаполнено;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаДерева, НовыеЗначения);
		
		КЗаказу = 0;
		
		НайденныеСтроки = ТаблицаЗапасы.НайтиСтроки(ПараметрыОтбора);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			Строка = Объект.Запасы[ТаблицаЗапасы.Индекс(НайденнаяСтрока)];
			ЗаполнитьЗначенияСвойств(Строка, СтрокаДерева, ЗаполняемыеПоля);
			ПересчитатьОкруглениеСервер(Строка, Истина);
			КЗаказу = КЗаказу + Строка.Округлено;
			
		КонецЦикла;
		
		НайденныеСтроки = ТаблицаЗаказыКОбеспечению.НайтиСтроки(ПараметрыОтбора);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			Строка = Объект.ЗаказыКОбеспечению[ТаблицаЗаказыКОбеспечению.Индекс(НайденнаяСтрока)];
			
			ЗаполнитьЗначенияСвойств(Строка, СтрокаДерева, ЗаполняемыеПоля);
			ПересчитатьОкруглениеСервер(Строка, Ложь);
			КЗаказу = КЗаказу + Строка.Округлено;
			
		КонецЦикла;
		
		СтрокаДерева.КЗаказу = КЗаказу;
		СтрокаДерева.СуммаВалютаСоглашения = СтрокаДерева.КЗаказу * СтрокаДерева.ЦенаВВалютеСоглашения;
		СтрокаДерева.СуммаУпрУчет = СтрокаДерева.КЗаказу * СтрокаДерева.ЦенаВВалютеУправленческогоУчета;
		
	КонецЦикла;
	
КонецПроцедуры

