		Если НЕ ЗначениеЗаполнено(Поставка.КодСтроки) Тогда
			Поставка.КодСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("Номенклатура, Характеристика, ЭтоРабота, ТипОбеспечения, ЕдиницаИзмерения");
