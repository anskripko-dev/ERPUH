&НаСервере
Процедура ОбработатьВыборПоПлануПоставки(АдресВХранилище, ТаблицаЗапасы)
	
	Результат = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Если ТипЗнч(Результат) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	//
	Если ТаблицаЗапасы Тогда
		Поставка = Объект.Запасы.НайтиПоИдентификатору(Элементы.Запасы.ТекущаяСтрока);
	Иначе
		Поставка = Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Элементы.ЗаказыКОбеспечению.ТекущаяСтрока);
	КонецЕсли;
	//ТаблицаЗапасы = Ложь;
	
	// Типовой код №1
	Если Поставка.Отметка Тогда
		ОтразитьПоставкуСогласноПланамПоставкиВКорзине(ЭтаФорма, Поставка, 0, НЕ ТаблицаЗапасы);
	КонецЕсли;
	
	КодСтроки = Поставка.КодСтроки;
	
	РезквизитыОтбора = "ТаблицаЗапасы, КодСтроки";
	Отбор = Новый Структура(РезквизитыОтбора, ТаблицаЗапасы, КодСтроки);
	Строки = Объект.ОбеспечениеЧерезПланПоставки.НайтиСтроки(Отбор);
	Для Каждого Строка Из Строки Цикл
		Объект.ОбеспечениеЧерезПланПоставки.Удалить(Строка);
	КонецЦикла;
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		Строка = Объект.ОбеспечениеЧерезПланПоставки.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаРезультата);
		ЗаполнитьЗначенияСвойств(Строка, Отбор, РезквизитыОтбора);
		ЗаполнитьЗначенияСвойств(Строка, Поставка, "Вес");
		
		Строка.ЦенаВВалютеСоглашения = ?(Строка.Количество = 0, 0, СтрокаРезультата.СуммаВВалютеПоставки / Строка.Количество);
		Строка.ЦенаВВалютеУправленческогоУчета = ?(Строка.Количество = 0, 0, СтрокаРезультата.СуммаВВалютеПоставки / Строка.Количество);
		
	КонецЦикла;
	
	Поставка.КЗаказу = Результат.Итог("Количество");
	Если НЕ Поставка.Отметка И Поставка.КЗаказу > 0 Тогда
		Поставка.Отметка = Истина;
	КонецЕсли;
	
	//ПересчитатьОкруглениеСервер(Поставка, ИмяТаблицы = "Запасы");
	ПересчитатьОкруглениеСервер(Поставка, ТаблицаЗапасы);
	
	// Типовой код №1
	//ОчиститьУсловияЗакупок(Поставка);
	Поставка.Соглашение = ПредопределенноеЗначение("Справочник.СоглашенияСПоставщиками.ПустаяСсылка");
	Поставка.ЦенаВВалютеУправленческогоУчета = 0;
	Поставка.ЦенаВВалютеСоглашения = 0;
	Поставка.ВалютаСоглашения = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
	
	//Поставка.ИсточникОбеспечения = ОбработатьПустойИсточникОбеспечения(ВыбранноеЗначение, ТекстНеЗаполнено);
	Поставка.ИсточникОбеспечения = НСтр("ru = 'По планам поставок'");
	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	
	ОтразитьПоставкуСогласноПланамПоставкиВКорзине(ЭтаФорма, Поставка, КоличествоКЗаказу, НЕ ТаблицаЗапасы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьУсловноеОформлениеУХ(Форма)
	
	Элементы = Форма.Элементы;
	УсловноеОформление = Форма.УсловноеОформление;
	
	
	// Согласно плану поставок по договорам
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КЗаказуЗаказы.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.ТипОбеспечения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыОбеспечения.Покупка;

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.СогласноПланамПоставокПоДоговорам");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Согласно плану поставок по договорам
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ИсточникОбеспеченияЗаказы.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.ТипОбеспечения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыОбеспечения.Покупка;

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.СогласноПланамПоставокПоДоговорам");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'По планам поставок'"));
	                    
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ИсточникОбеспеченияЗапасы.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.ИсточникОбеспечения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;		
	ОтборЭлемента.ПравоеЗначение = ТекстНеЗаполнено();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОтразитьПоставкуСогласноПланамПоставкиВКорзине(Форма, Поставка, КоличествоКЗаказу, ВозможныРаботы)
	
	КоличествоКЗаказуПервоначальное = КоличествоКЗаказу;
	ЭтоОбнулениеПоставки = КоличествоКЗаказу = 0;
	
	СтрокиПоставки = Форма.Объект.ОбеспечениеЧерезПланПоставки.НайтиСтроки(Новый Структура("КодСтроки", Поставка.КодСтроки));
	Для Каждого СтрокаПоставки Из СтрокиПоставки Цикл

		//КоличествоКЗаказу = СтрокаПоставки.Округлено * ?(Поставка.Отметка, 1, 0);
		КоличествоКЗаказу = СтрокаПоставки.Количество * ?(Поставка.Отметка, 1, 0) * ?(ЭтоОбнулениеПоставки, 0, 1);
		
		СтрокаПоставки.СпособОбеспечения = Поставка.СпособОбеспечения;
		СтрокаПоставки.ТипОбеспечения = Поставка.ТипОбеспечения;
		СтрокаПоставки.ИсточникОбеспечения = СтрокаПоставки.Договор;
		Если ВозможныРаботы Тогда
			СтрокаПоставки.ЭтоРабота = Поставка.ЭтоРабота;
		Иначе
			СтрокаПоставки.ЭтоРабота = Ложь;
		КонецЕсли;
		СтрокаПоставки.ДатаПоставки = Поставка.ДатаПоставки;
		
		ОтразитьПоставкуВКорзине(Форма, СтрокаПоставки, КоличествоКЗаказу, ВозможныРаботы);
		
	КонецЦикла;
	
	Если СтрокиПоставки.Количество() = 0 Тогда
		
		ИсточникОбеспечения = Поставка.ИсточникОбеспечения;
		ОтразитьПоставкуВКорзине(Форма, Поставка, КоличествоКЗаказу, ВозможныРаботы);
		Поставка.ИсточникОбеспечения = ИсточникОбеспечения;
		
	КонецЕсли;
	
	КоличествоКЗаказу = КоличествоКЗаказуПервоначальное;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИспользованиеНоменклатурыУХ(Номенклатура, Характеристика)
	
	Таблица = Объект.ОбеспечениеЧерезПланПоставки.Выгрузить();
	Отбор = Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика);
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица.Скопировать(Отбор));
	
КонецФункции

