&НаКлиенте
Процедура ИсточникОбеспеченияЗаказыНачалоВыбораУХ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Поставка = Элементы.ЗаказыКОбеспечению.ТекущиеДанные;
	Если Поставка.СогласноПланамПоставокПоДоговорам Тогда
		СтандартнаяОбработка = Ложь;
		
		Если НЕ ЗначениеЗаполнено(Поставка.КодСтроки) Тогда
			Поставка.КодСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("Номенклатура, Характеристика, ЭтоРабота, ТипОбеспечения, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(ПараметрыФормы, Поставка);
		ПараметрыФормы.Вставить("ТребуемоеКоличество",	Поставка.Требуется);
		
		ПараметрыФормы.Вставить("ТаблицаЗапасы", Ложь);
		ПараметрыФормы.Вставить("КодСтроки", Поставка.КодСтроки);
		ПараметрыФормы.Вставить("МестоПоставки", Поставка.Склад);
		
		ПараметрыФормы.Вставить("Использование", ПолучитьИспользованиеНоменклатурыУХ(ПараметрыФормы.Номенклатура, ПараметрыФормы.Характеристика));
		
		ОткрытьФорму("Обработка.ПодборНоменклатурыПоПлануПоставкиПоДоговору.Форма.ФормаПодбораПоПлануПоставкиПоДоговору", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	Иначе
		ИсточникОбеспеченияЗаказыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

