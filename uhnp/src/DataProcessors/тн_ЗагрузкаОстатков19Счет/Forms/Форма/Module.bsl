			СФСсылка = Неопределено;	
			СФНом = ТабДокумент.Область(Счетчик,КолСФНом,Счетчик,КолСФНом).Текст;
			Если не СФНом  = "" Тогда  	
				//ищем связанную СчФ
				ТаблицаСФ = Документы.СчетФактураПолученный.СчетаФактурыПоОснованию(ДокПоступленияСсылка);
				Если ТаблицаСФ.Количество()>0 Тогда
					СФСсылка = ТаблицаСФ[0].Ссылка;	
				КонецЕсли;
				Если СФСсылка = Неопределено Тогда 
					СФ = Документы.СчетФактураПолученный.СоздатьДокумент(); 
				Иначе
					СФ = СФСсылка.ПолучитьОбъект();	
				КонецЕсли; 
				
				ДанныеЗаполнения = Новый Структура;
				ДанныеЗаполнения.Вставить("ДокументОснование", ДокПоступленияСсылка);
				СФ.Заполнить(ДанныеЗаполнения);
				СФ.Номер = СФНом;
				СФ.Дата = ДатаСчФ;
				СФ.ДатаСоставления = Дата(ТабДокумент.Область(Счетчик,КолСФДата,Счетчик,КолСФДата).Текст);
				СФ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;	
			//КОНЕЦ Качикина 17.02.2026 Выполнение задач №000056743 
			
			СтрокаТЧ = Документ.НДСПредъявленный.Добавить();
			СтрокаТЧ.Партнер = СсылкаПартнер;
			СтрокаТЧ.Контрагент = СсылкаКонтрагент;
			СтрокаТЧ.НДС		= СуммаНДС;
			СтрокаТЧ.СуммаБезНДС = СуммаДокумента - ?(ТабДокумент.Область(Счетчик,КолВклНДС,Счетчик,КолВклНДС).Текст = "Да",СуммаНДС,0);  					
			СтрокаТЧ.НДСУпр = СуммаНДС; 
			//НАЧАЛО Качикина 13.02.2026 Выполнение задач №000056743
			//СтрокаТЧ.ДокументПоступления = ДокПоступления.Ссылка; 
			//СтрокаТЧ.СтавкаНДС = ?(ДокПоступления.Дата<Дата(2019,1,1), Перечисления.СтавкиНДС.НДС18, Перечисления.СтавкиНДС.НДС20);  
			СтрокаТЧ.ДокументПоступления = ДокПоступленияСсылка; 
			ПеречислениеСтавкаНДС = УчетНДСКлиентСервер.ОбщаяСтавкаНДС(ДокПоступления.Дата);
			СтрокаТЧ.СтавкаНДС	  = Справочники.СтавкиНДС.НайтиПоРеквизиту("ПеречислениеСтавкаНДС", ПеречислениеСтавкаНДС);
			//КОНЕЦ Качикина 13.02.2026 Выполнение задач №000056743
			
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьДокумент(Документ, ДокументСоздан, Счетчик);
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция  ОбработатьНомерДокумента(исхНомерДокумента)
	НомерДокумента = исхНомерДокумента;
	Префикс = "";
	Пока Найти(НомерДокумента, "0")<>1 Цикл
		Префикс = Префикс + Лев(НомерДокумента, 1);
		НомерДокумента = Сред(НомерДокумента,2);
	КонецЦикла;
	НомерДокумента = Сред(НомерДокумента, 2);
	Возврат Префикс+НомерДокумента
КонецФункции

&НаКлиенте
Процедура СоздатьДоки(Команда)
	СоздатьДокиНаСервере();
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.Результат;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьШапку(Документ, Организация, Счет, Валюта)
	
    // НАЧАЛО Редько Екатерина 11.07.2022 Выполнение задач №000041873
	//Документ.ТипОперации = Перечисления.ТипыОперацийВводаОстатков.ОстаткиНДСПоПриобретеннымЦенностям;
	Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковНДСПоПриобретеннымЦенностям;     
	// КОНЕЦ  Редько Екатерина 11.07.2022 Выполнение задач №000041873
	Документ.Дата			= ДатаДокументов;
	Документ.Ответственный	= Менеджер;
	Документ.Организация	= Организация;
	Документ.Валюта= Валюта;
	
	ВидыДеятельностиЦенности = ПолучитьВидыДеятельностиЦенностиПоСчету(Счет);
	Документ.ВидЦенностиНДС = ВидыДеятельностиЦенности.ВидЦенности;
	Документ.ВидДеятельностиНДС = ВидыДеятельностиЦенности.ВидДеятельности;
	
	Документ.ОтражатьВБУиНУ				= Истина;
	Документ.ОтражатьВОперативномУчете	= Истина;

	Документ.Комментарий = "Создано обработкой Х00011707";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидыДеятельностиЦенностиПоСчету(Счет)
	Результат = Новый Структура;
	
	Если Счет  = "19.02" Тогда
		ВидЦенности = Перечисления.ВидыЦенностей.НМА;
		ВидДеятельности =Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ИначеЕсли Счет = "19.03" Тогда
		ВидЦенности = Перечисления.ВидыЦенностей.Товары;		
		ВидДеятельности =Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ИначеЕсли Счет = "19.04" Тогда
		ВидЦенности = Перечисления.ВидыЦенностей.ПрочиеРаботыИУслуги;
		ВидДеятельности =Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	Иначе 
		ВидЦенности = Перечисления.ВидыЦенностей.Товары;		
		ВидДеятельности =Перечисления.ТипыНалогообложенияНДС.ЭкспортНесырьевыхТоваров;
	КонецЕсли;
	
	Результат.Вставить("ВидЦенности", ВидЦенности);
	Результат.Вставить("ВидДеятельности", ВидДеятельности);
	
	Возврат Результат;
	
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоЯчейки(Текст)
	
	Текст = СтрЗаменить(СокрЛП(Текст),Символы.НПП,"");
	Если Текст="" Тогда
		Возврат 0;
	Иначе
		Возврат Число(Текст);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПоГУИД(УИД, ОбластьПоиска)
	
	Попытка
		GUID	= Новый УникальныйИдентификатор(УИД);
		Ссылка  = ОбластьПоиска.ПолучитьСсылку(GUID);
		Если Лев(Строка(Ссылка),7)="<Объект" Тогда 
			Ссылка = Неопределено;
		КонецЕсли;
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
КонецФункции

&НаСервере
Процедура СообщитьОбОшибке(Счетчик, Текст, Колонка=0)
	
	Результат.ДобавитьСтроку(Строка(Счетчик)+Текст);
	
	ТабДокумент.Область(Счетчик,1,Счетчик,ТабДокумент.ШиринаТаблицы).ЦветФона = WebЦвета.ОранжевоКрасный;
	ТабДокумент.Область(Счетчик,Колонка,Счетчик,Колонка).ЦветФона = WebЦвета.Красный;
	
КонецПроцедуры

&НаСервере
Процедура ОкраситьСтроку(Счетчик)
	
	ТабДокумент.Область(Счетчик,1,Счетчик,ТабДокумент.ШиринаТаблицы).ЦветФона = WebЦвета.БледноЗеленый;
	
КонецПроцедуры
