	КолОрг	= 2;
	КолОргID	= 3;
	КолКонтр= 4;
	КолКонтрID = 5;
	КолДог= 6;
	КолДогID	= 7;
	КолСуммаНДС	= 8;
	КолНом = 9;
	КолДата= 10;
	КолВхНом	= 11;
