
&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ОбъектыПечати") тогда 
		Для Каждого ОбъектПечати Из Параметры.ОбъектыПечати Цикл
			НоваяСтрока = Объект.ДокументыПечати.Добавить();
			НоваяСтрока.Документ = ОбъектПечати;
		КонецЦикла;	
	КонецЕсли;	
	УстановитьВидимостьДоступностьРеквизитов();
	
КонецПроцедуры

&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура УстановитьВидимостьДоступностьРеквизитов()

	Элементы.Кому.Доступность = ТипПриказа = 0;
	Элементы.Мероприятие.Доступность = НЕ ТипПриказа = 0;
	Элементы.МестоПроведения.Доступность = НЕ ТипПриказа = 0;
	Элементы.Начало.Доступность = НЕ ТипПриказа = 0;
	Элементы.Окончание.Доступность = НЕ ТипПриказа = 0;
	
КонецПроцедуры

&НаКлиенте
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура ПереключательТипПриказаПриИзменении(Элемент)
	УстановитьВидимостьДоступностьРеквизитов();
КонецПроцедуры

&НаКлиенте
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура Печать(Команда)
	
	МенеджерПечати = "Обработка.тн_Печать_ПриказОСписанииРекламнойПродукции";
	Идентификатор = "тн_ПриказОСписанииРекламнойПродукции";
	ОбъектыПечати = ПолучитьМассивДокументовПечати();  

	ДанныеПриказа = Новый Структура;
	ДанныеПриказа.Вставить("ТипПриказа", ТипПриказа);  
	ДанныеПриказа.Вставить("ВидПечати", ВидПечати);  
	ДанныеПриказа.Вставить("Мероприятие", Объект.Мероприятие);  
	ДанныеПриказа.Вставить("Кому", 			Объект.Кому);  
	ДанныеПриказа.Вставить("МестоПроведения", Объект.МестоПроведения);  
	ДанныеПриказа.Вставить("Начало", Объект.Начало);  
	ДанныеПриказа.Вставить("Окончание", Объект.Окончание);  

	ДополнительныеПараметрыПечати = Новый Структура;
	ДополнительныеПараметрыПечати.Вставить("ДанныеПриказа", ДанныеПриказа);  
	Если ВидПечати = 0 тогда 
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(МенеджерПечати, Идентификатор, ОбъектыПечати, , ДополнительныеПараметрыПечати);	
	иначе
	   УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер(МенеджерПечати, Идентификатор, ОбъектыПечати, ДополнительныеПараметрыПечати);	
	КонецЕсли;

КонецПроцедуры

&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ПолучитьМассивДокументовПечати()
	ОбъектыПечати = Новый Массив;  
	Для Каждого СтрокаДокументыПечати Из Объект.ДокументыПечати Цикл
		ОбъектыПечати.Добавить(СтрокаДокументыПечати.Документ);
	КонецЦикла;
	Возврат ОбъектыПечати;
КонецФункции