
// Определяет возможность создания договора по протоколу ПротоколВыбораВход.
// Дополнительно выводит диагностическое сообщение, если создание недоступно.
&НаСервере
Функция ОпределитьВозможностьСозданияДоговора(ПротоколВыбораВход)
	РезультатФункции 			= Ложь;                                   
	ПриобретениеФинансовыхУслуг = Ложь;
	ВариантФинансирования		= Неопределено;
	Если ТипЗнч(ПротоколВыбораВход) = Тип("ДокументСсылка.ПротоколВыбораПобедителей") Тогда
		
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("ПриобретениеФинансовыхУслуг", "ЗакупочнаяПроцедура.ПриобретениеФинансовыхУслуг"); 
		СтруктураРеквизитов.Вставить("Проведен", 					"Проведен");   
		СтруктураРеквизитов.Вставить("ВариантФинансирования", 		"ВариантФинансирования");  
		СтруктураРеквизитов.Вставить("ТоргиСостоялись", 			"ТоргиСостоялись");  
		СтруктураРеквизитов.Вставить("ПринятоРешениеОПереторжке", 	"ПринятоРешениеОПереторжке");       
		СтруктураРеквизитов.Вставить("ЗаключатьДоговорСПоставщиком", 	"ЗаключатьДоговорСПоставщиком");       
		
		РеквизитыПротокола  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПротоколВыбораВход, СтруктураРеквизитов);
		Если РеквизитыПротокола.Проведен Тогда 
			Если РеквизитыПротокола.ПриобретениеФинансовыхУслуг И ЗначениеЗаполнено(РеквизитыПротокола.ВариантФинансирования) Тогда
				РезультатФункции 			= Истина;
				ПриобретениеФинансовыхУслуг = Истина;
				ВариантФинансирования		= РеквизитыПротокола.ВариантФинансирования; 
			ИначеЕсли РеквизитыПротокола.ПриобретениеФинансовыхУслуг  Тогда
				РезультатФункции = Ложь;
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Нет победителей по протоколу %1. Операция отменена.'"),ПротоколВыбораВход);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	
			ИначеЕсли (РеквизитыПротокола.ТоргиСостоялись И (Не РеквизитыПротокола.ПринятоРешениеОПереторжке))
				ИЛИ ( НЕ РеквизитыПротокола.ТоргиСостоялись И РеквизитыПротокола.ЗаключатьДоговорСПоставщиком)
				Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПротоколВыбораПобедителей.ЗакупочнаяПроцедура КАК ЗакупочнаяПроцедура,
				|	ПротоколВыбораПобедителей.Ссылка КАК ПротоколПобедителей,
				|	Лоты.Ссылка КАК Лот,
				|	ОбъектыВыбора.Выбран КАК Выбран,
				|	ОбъектыВыбора.Объект КАК Предложение
				|ПОМЕСТИТЬ ВТ_ВыбранныеОбъекты
				|ИЗ
				|	Документ.ПротоколВыбораПобедителей КАК ПротоколВыбораПобедителей
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лот КАК Лоты
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыВыбора КАК ОбъектыВыбора
				|			ПО Лоты.Ссылка = ОбъектыВыбора.Владелец
				|		ПО ПротоколВыбораПобедителей.ЗакупочнаяПроцедура = Лоты.ЗакупочнаяПроцедура
				|ГДЕ
				|	НЕ Лоты.ПометкаУдаления
				|	И ПротоколВыбораПобедителей.Ссылка = &ПротоколВыбораПобедителей
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ДокументПредложениеПоставщика.Ссылка КАК ПредложениеПоставщика,
				|	ДокументПредложениеПоставщика.Контрагент КАК Поставщик,
				|	ВТ_ВыбранныеОбъекты.Лот КАК Лот,
				|	ВТ_ВыбранныеОбъекты.ПротоколПобедителей КАК ПротоколПобедителей
				|ИЗ
				|	Документ.ПредложениеПоставщика КАК ДокументПредложениеПоставщика
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыбранныеОбъекты КАК ВТ_ВыбранныеОбъекты
				|		ПО ДокументПредложениеПоставщика.Ссылка = ВТ_ВыбранныеОбъекты.Предложение
				|			И (ВТ_ВыбранныеОбъекты.Выбран)";
				Запрос.УстановитьПараметр("ПротоколВыбораПобедителей", ПротоколВыбораВход);
				РезультатЗапроса = Запрос.Выполнить();
				Если НЕ РезультатЗапроса.Пустой() Тогда
					РезультатФункции = Истина;
				Иначе
					РезультатФункции = Ложь;
					ТекстСообщения = СтрШаблон(НСтр("ru = 'Нет победителей по протоколу %1. Операция отменена.'"), ПротоколВыбораВход);
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				КонецЕсли;
			Иначе
				РезультатФункции = Ложь;
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Торги по протоколу %1 не завершены. Операция отменена.'"), ПротоколВыбораВход);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			КонецЕсли;
		Иначе
			РезультатФункции = Ложь;
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Протокол %1 не проведён. Операция отменена.'"), ПротоколВыбораВход);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	Иначе
		РезультатФункции = Ложь;
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Неизвестный вариант выбора победителе %1. Операция отменена.'"), ПротоколВыбораВход);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли; 
	
	Возврат Новый Структура("РезультатФункции, ПриобретениеФинансовыхУслуг, ВариантФинансирования",
								РезультатФункции, ПриобретениеФинансовыхУслуг, ВариантФинансирования);  
	
КонецФункции		 // ОпределитьВозможностьСозданияДоговора()

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	РезультатПроверкиВозможности = ОпределитьВозможностьСозданияДоговора(ПараметрКоманды);
	Если РезультатПроверкиВозможности.ПриобретениеФинансовыхУслуг Тогда
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ВариантФинансирования", 	РезультатПроверкиВозможности.ВариантФинансирования);   
		ЗначенияЗаполнения.Вставить("Протокол", 				ПараметрКоманды);
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		ОткрытьФорму("Документ.ВерсияСоглашенияКредит.ФормаОбъекта", 
					ПараметрыФормы,
					ПараметрыВыполненияКоманды.Источник,
					ПараметрыВыполненияКоманды.Уникальность,
					ПараметрыВыполненияКоманды.Окно,
					ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
	ИначеЕсли РезультатПроверкиВозможности.РезультатФункции Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПротоколВыбораПобедителей", ПараметрКоманды);
		ОткрытьФорму("Обработка.ФормированиеДоговоровСПобедителямиТоргов.Форма",
			ПараметрыФормы, 
			ПараметрыВыполненияКоманды.Источник, 
			ПараметрыВыполненияКоманды.Уникальность, 
			ПараметрыВыполненияКоманды.Окно, 
			ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	Иначе
		ТекстСообщения = НСтр("ru = 'Создание договора недоступно'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры
