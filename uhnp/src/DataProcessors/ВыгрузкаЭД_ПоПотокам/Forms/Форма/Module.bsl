
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Объект.КоличествоПотоков = 6;
	Объект.ОператорЭДО = Перечисления.тн_ОператорыЭДО.Диадок;
	
	ОбновитьКоличествоЗарегистрированных();	
	
КонецПроцедуры

#Область Служебные

&НаСервере
Процедура ОбновитьКоличествоЗарегистрированных()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ЭлектронныеДокументы.ЭтотУзел());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(Диадок_ДокументыИзменения.Ссылка) КАК КоличествоДокументов
	|ИЗ
	|	Справочник.Диадок_Документы.Изменения КАК Диадок_ДокументыИзменения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗарегистрированоКОбмену = Выборка.КоличествоДокументов;
	Иначе
		ЗарегистрированоКОбмену = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьЗапускФЗ(НаименованиеФЗ, СписокПараметров)
	
	КлючФЗ = Новый УникальныйИдентификатор;
	
	Задание = ФоновыеЗадания.Выполнить("тн_ВыгрузкаЭлектронныхДокументов.ВыгрузитьЭлектронныеДокументы", СписокПараметров, КлючФЗ, НаименованиеФЗ);
	
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	
	Возврат ИдентификаторЗадания;
	
КонецФункции // ВыполнитьЗапускФЗ

&НаСервереБезКонтекста
Функция ПолучитьСписокУзлов()
	
	СписокУзловОбмена = Новый Массив;	
	
	ВыборкаУзлов = ПланыОбмена.ЭлектронныеДокументы.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		
		УзелОбмена = ВыборкаУзлов.Ссылка;
		
		Если УзелОбмена <> ПланыОбмена.ЭлектронныеДокументы.ЭтотУзел() Тогда
			
			СписокУзловОбмена.Добавить(УзелОбмена);
			ПланыОбмена.ВыбратьИзменения(УзелОбмена, 1);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат СписокУзловОбмена;
	
КонецФункции // ПолучитьСписокУзлов()

