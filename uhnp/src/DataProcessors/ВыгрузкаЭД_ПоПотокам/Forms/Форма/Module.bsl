//Функция ПроверитьВыполнениеФЗ(СписокВыполняющихсяФЗ, Знач ОтборСостояниеФЗ, КоличествоПотоков)
&НаСервереБезКонтекста
Функция ПроверитьВыполнениеФЗ(СписокВыполняющихсяФЗ, Знач ОтборСостояниеФЗ, КоличествоПотоков, Индикатор = 0)

	СписокСостоянийФЗ_Завершено = Новый Массив;
	СписокСостоянийФЗ_Завершено.Добавить(СостояниеФоновогоЗадания.Завершено);
	СписокСостоянийФЗ_Завершено.Добавить(СостояниеФоновогоЗадания.ЗавершеноАварийно);
	
	Сч = 0;
	Пока Сч <= СписокВыполняющихсяФЗ.ВГраница() Цикл
		
		ОтборСостояниеФЗ.УникальныйИдентификатор = СписокВыполняющихсяФЗ[Сч];
		
		СписокВыполняющихсяЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборСостояниеФЗ);
		
		Если СписокВыполняющихсяЗаданий.Количество() = 0 Тогда
			
			СписокВыполняющихсяФЗ.Удалить(Сч);
			// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
			Индикатор = Индикатор + 1;
			// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
			Сч = Сч - 1;
			
		ИначеЕсли СписокСостоянийФЗ_Завершено.Найти(СписокВыполняющихсяЗаданий[0].Состояние) <> Неопределено Тогда	

			СписокВыполняющихсяФЗ.Удалить(Сч);
			// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
			Индикатор = Индикатор + 1;
			// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
			Сч = Сч - 1;

		КонецЕсли;
		
		Сч = Сч + 1;		
		
	КонецЦикла;
	
	Возврат СписокВыполняющихсяФЗ.Количество() < КоличествоПотоков;
	
КонецФункции // ПроверитьВыполнениеФЗ()

#КонецОбласти // Служебные

#Область ВыгрузкаПоСпискуЭД

&НаСервереБезКонтекста
Функция ПолучитьСписокЭД(КоличествоЗаписейДляВыборки, СписокУзлов)
	
	ТекстПервыеЗаписи = ?(КоличествоЗаписейДляВыборки = 0, "", "ПЕРВЫЕ " + Формат(КоличествоЗаписейДляВыборки, "ЧГ="));
	
	СписокЭД = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ " + ТекстПервыеЗаписи + "
	|	Диадок_ДокументыИзменения.Ссылка КАК ЭлектронныйДокумент
	|ИЗ
	|	Справочник.Диадок_Документы.Изменения КАК Диадок_ДокументыИзменения
	|ГДЕ
	|	Диадок_ДокументыИзменения.Узел В(&СписокУзлов)
	|	И Диадок_ДокументыИзменения.НомерСообщения = 1";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СписокУзлов", СписокУзлов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокЭД.Добавить(Выборка.ЭлектронныйДокумент);
		
	КонецЦикла;
	
	Возврат СписокЭД;
	
КонецФункции // ПолучитьСписокЭД()

&НаКлиенте
Процедура ВыполнитьВыгрузкуПоСпискуЭД(Команда)

	Если Не ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СписокУзловОбмена = ПолучитьСписокУзлов();
	ДанныеПрофиля = тн_ВыгрузкаЭлектронныхДокументов.ПолучитьДанныеПрофиляХраненияФайловЭД(Объект.ОператорЭДО);
	
	Если Не ДанныеПрофиля.Используется Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Профиль хранения файлов ЭД для оператора ЭДО '" + Строка(Объект.ОператорЭДО) +"' не используется!");
		Возврат;	
	КонецЕсли;
	
	КоличествоДокументовВПакете = ДанныеПрофиля.КоличествоДокументовВПакете;
	СписокЭД = ПолучитьСписокЭД(Объект.КоличествоЗаписейДляВыборки, СписокУзловОбмена);
		
	ИндикаторВыборки = 0;
	Элементы.ИндикаторВыборки.МаксимальноеЗначение = СписокЭД.Количество();
	
	Элементы.ИндикаторВыборки.Заголовок = "Прогресс выборки документов";
	
	ОтборСостояниеФЗ = Новый Структура;
	ОтборСостояниеФЗ.Вставить("УникальныйИдентификатор", "");
		
	СписокВыполняющихсяФЗ = Новый Массив;
	
	МассивВсехФЗ = Новый Массив;
	// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
	Индикатор = 0;
	// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
	Если СписокЭД.Количество() <= КоличествоДокументовВПакете Тогда
		
		ИдентификаторЗадания = ЗапуститьВыполнениеФЗ_СписокЭД(СписокЭД);
		МассивВсехФЗ.Добавить(ИдентификаторЗадания);
		
		// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
		//Индикатор = 0;
		// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
		Элементы.Индикатор.МаксимальноеЗначение = МассивВсехФЗ.Количество();
		
		ДополнитьСписокВыполняющихсяФЗ(ИдентификаторЗадания, СписокВыполняющихсяФЗ);
		ИндикаторВыборки = СписокЭД.Количество();
		
	Иначе
		
		СписокЭД_ДляОбработки = Новый Массив;
		Для Каждого ЭлементМассива Из СписокЭД Цикл
			
			ОбработкаПрерыванияПользователя();
			
			Если ЭтоАдресВременногоХранилища(АдресВХВыполняемыеФЗ) Тогда
				СписокАктивныхВЗ = ПолучитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
				Если ТипЗнч(СписокАктивныхВЗ) = Тип("Массив") Тогда
					СписокВыполняющихсяФЗ = СписокАктивныхВЗ;	
				КонецЕсли;
			КонецЕсли;
			
			СписокЭД_ДляОбработки.Добавить(ЭлементМассива);
			
			Если СписокЭД_ДляОбработки.Количество() >= КоличествоДокументовВПакете Тогда
				
				Если СписокВыполняющихсяФЗ.Количество() >= Объект.КоличествоПотоков Тогда
					
					ВыполнитьФЗ = Ложь;
					Пока Не ВыполнитьФЗ Цикл
						
						ОбработкаПрерыванияПользователя();
						ВыполнитьФЗ = ПроверитьВыполнениеФЗ(СписокВыполняющихсяФЗ, ОтборСостояниеФЗ, Объект.КоличествоПотоков);	
						
					КонецЦикла;
					
				КонецЕсли;
					
				ИдентификаторЗадания = ЗапуститьВыполнениеФЗ_СписокЭД(СписокЭД_ДляОбработки);
				МассивВсехФЗ.Добавить(ИдентификаторЗадания);
				Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
					
					ДополнитьСписокВыполняющихсяФЗ(ИдентификаторЗадания, СписокВыполняющихсяФЗ);
					СписокЭД_ДляОбработки.Очистить();
					
				КонецЕсли;					
				
			КонецЕсли;
			
			ИндикаторВыборки = ИндикаторВыборки + 1;
			Элементы.ИндикаторВыборки.Заголовок = "Прогресс выборки документов" + "("+ Строка(ИндикаторВыборки) + " из " + Строка(СписокЭД.Количество()) + ")";
			
			ВывестиКоличествоЗапущенныхФЗ();
			
			// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
			ПроверитьВыполнениеФЗ(СписокВыполняющихсяФЗ, ОтборСостояниеФЗ, Объект.КоличествоПотоков, Индикатор);
			// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
		КонецЦикла;
		
		СписокВыполняющихсяФЗ.Очистить();
				
		Если СписокЭД_ДляОбработки.Количество() > 0 Тогда
			
			ИдентификаторЗадания = ЗапуститьВыполнениеФЗ_СписокЭД(СписокЭД_ДляОбработки);
			МассивВсехФЗ.Добавить(ИдентификаторЗадания);
			
			ДополнитьСписокВыполняющихсяФЗ(ИдентификаторЗадания, СписокВыполняющихсяФЗ);
			ИндикаторВыборки = СписокЭД.Количество();
			
		КонецЕсли;
		
		// НАЧАЛО Смирнов Д.А. 11.12.2025 Выполнение задач №000055967
		//Индикатор = 0;
		// КОНЕЦ Смирнов Д.А. 11.12.2025 Выполнение задач №000055967	
		Элементы.Индикатор.МаксимальноеЗначение = МассивВсехФЗ.Количество();
		ПодключитьОбработчикОжидания("ПодсчетВыполненныхФЗ", 10, Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиКоличествоЗапущенныхФЗ()
	
	Если ЭтоАдресВременногоХранилища(АдресВХВыполняемыеФЗ) Тогда
		СписокФЗ = ПолучитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
		Если ЗначениеЗаполнено(СписокФЗ) Тогда
			КоличествоЗапущенныхФЗ = СписокФЗ.Количество();
		Иначе 
			КоличествоЗапущенныхФЗ = 0;
		КонецЕсли;                     
	Иначе
		КоличествоЗапущенныхФЗ = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьСписокВыполняющихсяФЗ(ИдентификаторЗадания, СписокВыполняющихсяФЗ)
	
	Если ЭтоАдресВременногоХранилища(АдресВХВыполняемыеФЗ) Тогда
		СписокФЗ = ПолучитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
		УдалитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
		Если ТипЗнч(СписокФЗ) = Тип("Массив") Тогда
			СписокФЗ.Добавить(ИдентификаторЗадания);
			АдресВХВыполняемыеФЗ = ПоместитьВоВременноеХранилище(СписокФЗ, Новый УникальныйИдентификатор);
		Иначе
			СписокВыполняющихсяФЗ.Добавить(ИдентификаторЗадания);
			АдресВХВыполняемыеФЗ = ПоместитьВоВременноеХранилище(СписокВыполняющихсяФЗ, Новый УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		СписокВыполняющихсяФЗ.Добавить(ИдентификаторЗадания);
		АдресВХВыполняемыеФЗ = ПоместитьВоВременноеХранилище(СписокВыполняющихсяФЗ, Новый УникальныйИдентификатор);
	КонецЕсли;
	
