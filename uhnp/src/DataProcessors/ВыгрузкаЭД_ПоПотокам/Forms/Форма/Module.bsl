	Если КоличествоЗапущенныхФЗ = 0 Тогда
		ОтключитьОбработчикОжидания("ПодсчетВыполненныхФЗ");	
	КонецЕсли;
	
	ОбновитьКоличествоЗарегистрированных();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСостоянияЗавершенияФЗ()
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(СостояниеФоновогоЗадания.Завершено);
	МассивСтатусов.Добавить(СостояниеФоновогоЗадания.ЗавершеноАварийно);
	МассивСтатусов.Добавить(СостояниеФоновогоЗадания.Отменено);
	
	Возврат МассивСтатусов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьВыполнениеФЗ_СписокЭД(СписокЭД)
	
	СписокПараметров = Новый Массив;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СписокЭД", СписокЭД);
	СписокПараметров.Добавить(ДополнительныеПараметры);
	
	НаименованиеФЗ = "Выгрузка электронных документов (в разрезе электронных документов).";
	
	ИдентификаторЗадания = ВыполнитьЗапускФЗ(НаименованиеФЗ, СписокПараметров);
	
	Возврат ИдентификаторЗадания;
	
КонецФункции // ЗапуститьВыполнениеФЗ_СписокЭД()

#КонецОбласти // ВыгрузкаПоСпискуЭД

#Область ВыгрузкаПоПериоду

&НаСервереБезКонтекста
Функция ПолучитьСписокПериодовДляОбработки()
	
	СписокПериодов = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Диадок_Документы.ДатаЗагрузки > Диадок_Документы.ДатаДокумента
	|				ТОГДА Диадок_Документы.ДатаЗагрузки
	|			ИНАЧЕ Диадок_Документы.ДатаДокумента
	|		КОНЕЦ) КАК МинимальнаяДатаСоздания,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Диадок_Документы.ДатаЗагрузки > Диадок_Документы.ДатаДокумента
	|				ТОГДА Диадок_Документы.ДатаЗагрузки
	|			ИНАЧЕ Диадок_Документы.ДатаДокумента
	|		КОНЕЦ) КАК МаксимальнаяДатаСоздания
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	(Диадок_Документы.ДатаДокумента <> &ПустаяДата
	|			ИЛИ Диадок_Документы.ДатаЗагрузки <> &ПустаяДата)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		
		НачалоПериода = НачалоМесяца(Выборка.МинимальнаяДатаСоздания);
		КонецПериода = КонецМесяца(Выборка.МаксимальнаяДатаСоздания);
		
		ПериодОбработки = Новый Структура;
		ПериодОбработки.Вставить("ДатаНачала", '00010101');
		ПериодОбработки.Вставить("ДатаОкончания", '00010101');
		
		Пока НачалоПериода <= КонецПериода Цикл
			
			КонецМесяцаНачалаПериода = ДобавитьМесяц(НачалоПериода, 1)-1;
			
			ПериодОбработки.ДатаНачала = НачалоПериода;
			ПериодОбработки.ДатаОкончания = КонецМесяцаНачалаПериода;
			
			СписокПериодов.Добавить(ПериодОбработки);
			
			НачалоПериода = КонецМесяцаНачалаПериода+1;
			
		КонецЦикла;
		
	КонецЕсли;
		

	Возврат СписокПериодов;
	
КонецФункции // ПолучитьСписокПериодовДляОбработки()

&НаКлиенте
Процедура ВыполнитьВыгрузкуПоПериоду(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СписокПериодов = ПолучитьСписокПериодовДляОбработки();
	
	ОтборСостояниеФЗ = Новый Структура;
	ОтборСостояниеФЗ.Вставить("УникальныйИдентификатор", "");
	
	СписокВыполняющихсяФЗ = Новый Массив;
	Сч = 0;
	Пока Сч < СписокПериодов.ВГраница() Цикл
		
		ПериодОбработки = СписокПериодов[Сч];
		
		ОбработкаПрерыванияПользователя();
		
		ВыполнитьФЗ = Истина;
		Если СписокВыполняющихсяФЗ.Количество() >= Объект.КоличествоПотоков Тогда
			
			ВыполнитьФЗ = ПроверитьВыполнениеФЗ(СписокВыполняющихсяФЗ, ОтборСостояниеФЗ, Объект.КоличествоПотоков);	
			
		КонецЕсли;
		
		Если ВыполнитьФЗ Тогда
			
			ИдентификаторЗадания = ЗапуститьВыполнениеФЗ_ПоПериоду(ПериодОбработки.ДатаНачала, ПериодОбработки.ДатаОкончания);
			Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
				
				СписокВыполняющихсяФЗ.Добавить(ИдентификаторЗадания);
				
			КонецЕсли;
			
			Сч = Сч + 1;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры // ВыполнитьВыгрузку()

&НаСервереБезКонтекста
Функция ЗапуститьВыполнениеФЗ_ПоПериоду(ДатаНачала, ДатаОкончания)
	
	СписокПараметров = Новый Массив;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДатаНачала", ДатаНачала);
	ДополнительныеПараметры.Вставить("ДатаОкончания", ДатаОкончания);
	СписокПараметров.Добавить(ДополнительныеПараметры);
	
	НаименованиеФЗ = "Выгрузка электронных документов (в разрезе периодов).";	
	
	ИдентификаторЗадания = ВыполнитьЗапускФЗ(НаименованиеФЗ, СписокПараметров);
	
	Возврат ИдентификаторЗадания;
	
КонецФункции // ЗапуститьВыполнениеФЗ_ПоПериоду()

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОтключитьОбработчикОжидания("ПодсчетВыполненныхФЗ");
	Если ЭтоАдресВременногоХранилища(АдресВХВыполняемыеФЗ) Тогда
		ОтменитьФоновыеЗадания();
		УдалитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьФоновыеЗадания()
	
	Если ЭтоАдресВременногоХранилища(АдресВХВыполняемыеФЗ) Тогда
		СписокФЗ = ПолучитьИзВременногоХранилища(АдресВХВыполняемыеФЗ);
		Если ЗначениеЗаполнено(СписокФЗ) Тогда
			Для Каждого ИДФонового Из СписокФЗ Цикл
				
				ТекущееФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИДФонового);
				
				Если Не ТекущееФЗ = Неопределено Тогда
					ТекущееФЗ.Отменить();	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ВыгрузкаПоПериоду