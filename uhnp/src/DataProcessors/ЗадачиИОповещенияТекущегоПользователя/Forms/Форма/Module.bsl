			ПараметрыФормы = Новый Структура("ВладелецОбъектовВыбора", Мероприятие);    
			ИмяОбработки = "Обработка.ОценкаОбъектов.Форма";
			ОткрытьФорму(ИмяОбработки, ПараметрыФормы, );
		Иначе
			// Нет данных для открытия
		КонецЕсли;
	Иначе	
		// Нет связанного объекта
	КонецЕсли;

КонецПроцедуры

