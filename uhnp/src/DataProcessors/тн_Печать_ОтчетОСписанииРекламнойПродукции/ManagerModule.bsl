#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Печать

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "тн_ОтчетОСписанииРекламнойПродукции") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"тн_ОтчетОСписанииРекламнойПродукции",
			НСтр("ru = 'Отчет о списании рекламной продукции'"),
			СформироватьПечатнуюФормуОтчетОСписанииРекламнойПродукции(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПечатнуюФормуОтчетОСписанииРекламнойПродукции(МассивОбъектов, ОбъектыПечати, ПараметрыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетОСписанииРекламнойПродукции";  
	
	Если МассивОбъектов.Количество() = 1 Тогда  
		
		ДокументОснование = МассивОбъектов[0];
		ДанныеДляПечати = ДанныеДляПечатнойФормыОтчетОСписанииРекламнойПродукцииОдинДокумент(ПараметрыПечати, ДокументОснование);
		ПечатьОдногоДокумента = Истина;
		
	Иначе
		
		ДанныеДляПечати = ДанныеДляПечатнойФормыОтчетОСписанииРекламнойПродукцииНесколькоДокументов(ПараметрыПечати, МассивОбъектов);
		ПечатьОдногоДокумента = Ложь;
		
	КонецЕсли;
	
	Если Не ДанныеДляПечати = Неопределено Тогда  
		
		ЗаполнитьТабличныйДокументОтчетОСписанииРекламнойПродукции(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДокументОснование, ПараметрыПечати, ПечатьОдногоДокумента);
		
	КонецЕсли;
		
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ЗаполнитьТабличныйДокументОтчетОСписанииРекламнойПродукции(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ДокументОснование, ПараметрыПечати, ПечатьОдногоДокумента)
	
	ДанныеОтчета = Новый Структура("ТипПриказа, ВидПечати, Мероприятие, Кому, МестоПроведения, НачалоПериода, ОкончаниеПериода, Утвердил, Затребовал");

	Если ПараметрыПечати.Свойство("ДанныеОтчета") Тогда 
		ЗаполнитьЗначенияСвойств(ДанныеОтчета, ПараметрыПечати.ДанныеОтчета);
	КонецЕсли;	
	
	РаспечататьКаждыйДокументОтдельно = ПараметрыПечати.ДанныеОтчета.РаспечататьКаждыйДокументОтдельно ИЛИ ПечатьОдногоДокумента;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.тн_Печать_ОтчетОСписанииРекламнойПродукции.ПФ_MXL_ОтчетОСписанииРекламнойПродукции");
	Макет.КодЯзыка = Метаданные.Языки.Русский.КодЯзыка;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	НомерСтроки = 0;
	
	ДанныеПоЗатребовавшему = ДанныеДляПечати.ДанныеПоЗатребовавшему.Выбрать();  
	ДанныеПоУтвердившему = ДанныеДляПечати.ДанныеПоУтвердившему.Выбрать(); 
	ДанныеПоТоварам = ДанныеДляПечати.ДанныеПоТоварам.Выбрать();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

	Если ДанныеОтчета.ТипПриказа = 0 Тогда 
		ОбластьТекстПриказа = Макет.ПолучитьОбласть("ТекстКому");
	Иначе
		ОбластьТекстПриказа = Макет.ПолучитьОбласть("ТекстМероприятие"); 
	КонецЕсли;

	ОбластьТаблицаШапка           	= Макет.ПолучитьОбласть("ТаблицаШапка");
	ОбластьТаблицаСтрока           	= Макет.ПолучитьОбласть("ТаблицаСтрока");
	ОбластьОтветственный            = Макет.ПолучитьОбласть("Ответственный");
	
	ДанныеПоЗатребовавшему.Следующий(); 
	ДанныеПоУтвердившему.Следующий();
	
	//Шапка
	ОбластьШапка.Параметры.Утвердил = Строка(ДанныеПоУтвердившему.ДолжностьУтвердившего) +  " " + ДанныеПоУтвердившему.ФИОУтвердившего;
	
	Если РаспечататьКаждыйДокументОтдельно Тогда
		ОбластьШапка.Параметры.Дата = ДанныеПоЗатребовавшему.Дата; 
	Иначе
		ОбластьШапка.Параметры.Дата = ДанныеОтчета.ОкончаниеПериода;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);  
	
	//Тело
	ЗаполнитьЗначенияСвойств(ОбластьТекстПриказа.Параметры, ДанныеОтчета);
	
	Если РаспечататьКаждыйДокументОтдельно Тогда
		ДолжностьЗатребовавшего = ?(ЗначениеЗаполнено(ДанныеПоЗатребовавшему.ДолжностьЗатребовавшего), ", " + ДанныеПоЗатребовавшему.ДолжностьЗатребовавшего, ""); 
		ОбластьТекстПриказа.Параметры.Затребовал = ДанныеПоЗатребовавшему.ФИОЗатребовавшего + ДолжностьЗатребовавшего;
	КонецЕсли;
	
	Если ДанныеОтчета.ТипПриказа = 1 Тогда
		ОбластьТекстПриказа.Параметры.НачалоПериода =  Формат(ДанныеОтчета.НачалоПериода, "ДЛФ=DD");
		ОбластьТекстПриказа.Параметры.ОкончаниеПериода = Формат(ДанныеОтчета.ОкончаниеПериода, "ДЛФ=DD");
	КонецЕсли;

	ТабличныйДокумент.Вывести(ОбластьТекстПриказа);  
	
	//ТабЧасть
	ТабличныйДокумент.Вывести(ОбластьТаблицаШапка);
	
	Пока ДанныеПоТоварам.Следующий() Цикл
		
		НомерСтроки = НомерСтроки + 1;

		НоменклатураНаименование = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(ДанныеПоТоварам.Номенклатура, Неопределено);
		
		ОбластьТаблицаСтрока.Параметры.НомерСтроки = НомерСтроки;
		ОбластьТаблицаСтрока.Параметры.Заполнить(ДанныеПоТоварам);
		ОбластьТаблицаСтрока.Параметры.Номенклатура = НоменклатураНаименование;
		
		ТабличныйДокумент.Вывести(ОбластьТаблицаСтрока);
		
	КонецЦикла;
	
	//Ответственный 
	Если РаспечататьКаждыйДокументОтдельно Тогда
		ОбластьОтветственный.Параметры.Затребовал = ДанныеПоЗатребовавшему.ФИОЗатребовавшего;
	Иначе
		ОбластьОтветственный.Параметры.Затребовал = ДанныеОтчета.Затребовал;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьОтветственный);
	
КонецПроцедуры

Функция ДанныеДляПечатнойФормыОтчетОСписанииРекламнойПродукцииОдинДокумент(ПараметрыПечати, ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВнутреннееПотребление.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотребление.тн_Затребовал) КАК ФИОЗатребовавшего,
		|	ЕСТЬNULL(ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность, НЕОПРЕДЕЛЕНО) КАК ДолжностьЗатребовавшего,
		|	ВнутреннееПотребление.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВнутреннееПотребление КАК ВнутреннееПотребление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|		ПО ВнутреннееПотребление.тн_Затребовал = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
		|			И ВнутреннееПотребление.Организация = ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация
		|ГДЕ
		|	ВнутреннееПотребление.Ссылка = &ДокументОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(ФизическиеЛица.Ссылка) КАК ФИОУтвердившего,
		|	ЕСТЬNULL(ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность, """") КАК ДолжностьУтвердившего
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|		ПО ФизическиеЛица.Ссылка = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &Утвердил
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ХозрасчетныйДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)) КАК Номенклатура,
		|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ХозрасчетныйДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура).ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	ХозрасчетныйДвиженияССубконто.КоличествоКт КАК Количество,
		|	ХозрасчетныйДвиженияССубконто.Сумма КАК Стоимость
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК ХозрасчетныйДвиженияССубконто
		|ГДЕ
		|	ХозрасчетныйДвиженияССубконто.Регистратор = &ДокументОснование
		|	И ХозрасчетныйДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотреблениеТовары.Номенклатура) КАК Номенклатура,
		|	ПРЕДСТАВЛЕНИЕ(ВнутреннееПотреблениеТовары.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	ВнутреннееПотреблениеТовары.Количество КАК Количество,
		|	0 КАК Стоимость
		|ИЗ
		|	Документ.ВнутреннееПотребление.Товары КАК ВнутреннееПотреблениеТовары
		|ГДЕ
		|	ВнутреннееПотреблениеТовары.Ссылка = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("Утвердил", ПараметрыПечати.ДанныеОтчета.Утвердил);
	
	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеПоЗатребовавшему = МассивРезультатовЗапроса[0];
	ДанныеПоУтвердившему = МассивРезультатовЗапроса[1];
	
	Если МассивРезультатовЗапроса[2].Пустой() Тогда
		ДанныеПоТоварам = МассивРезультатовЗапроса[3];
	Иначе
		ДанныеПоТоварам = МассивРезультатовЗапроса[2];
	КонецЕсли;

	СтруктураДанных = Новый Структура; 
	СтруктураДанных.Вставить("ДанныеПоЗатребовавшему", ДанныеПоЗатребовавшему); 
	СтруктураДанных.Вставить("ДанныеПоУтвердившему", ДанныеПоУтвердившему);
	СтруктураДанных.Вставить("ДанныеПоТоварам", ДанныеПоТоварам);

	Возврат СтруктураДанных;
	
КонецФункции

Функция ДанныеДляПечатнойФормыОтчетОСписанииРекламнойПродукцииНесколькоДокументов(ПараметрыПечати, СписокДокументов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&Дата КАК Дата,
		|	&ФИОЗатребовавшего КАК ФИОЗатребовавшего,
		|	"""" КАК ДолжностьЗатребовавшего
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(ФизическиеЛица.Ссылка) КАК ФИОУтвердившего,
		|	ЕСТЬNULL(ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность, """") КАК ДолжностьУтвердившего
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|		ПО ФизическиеЛица.Ссылка = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &Утвердил
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ХозрасчетныйДвиженияССубконто.СубконтоКт1 КАК Номенклатура,
		|	СУММА(ХозрасчетныйДвиженияССубконто.Сумма) КАК Стоимость
		|ПОМЕСТИТЬ ВТ_СтоимостьСписания
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК ХозрасчетныйДвиженияССубконто
		|ГДЕ
		|	ХозрасчетныйДвиженияССубконто.Регистратор В(&СписокДокументов)
		|	И ХозрасчетныйДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйДвиженияССубконто.СубконтоКт1
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнутреннееПотреблениеТовары.Номенклатура КАК Номенклатура,
		|	СУММА(ВнутреннееПотреблениеТовары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_ДанныеТЧ
		|ИЗ
		|	Документ.ВнутреннееПотребление.Товары КАК ВнутреннееПотреблениеТовары
		|ГДЕ
		|	ВнутреннееПотреблениеТовары.Ссылка В(&СписокДокументов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВнутреннееПотреблениеТовары.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(ВТ_ДанныеТЧ.Номенклатура) КАК Номенклатура,
		|	ПРЕДСТАВЛЕНИЕ(ВТ_ДанныеТЧ.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	ВТ_ДанныеТЧ.Количество КАК Количество,
		|	ЕСТЬNULL(ВТ_СтоимостьСписания.Стоимость, 0) КАК Стоимость
		|ИЗ
		|	ВТ_ДанныеТЧ КАК ВТ_ДанныеТЧ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостьСписания КАК ВТ_СтоимостьСписания
		|		ПО ВТ_ДанныеТЧ.Номенклатура = ВТ_СтоимостьСписания.Номенклатура";
	
	Запрос.УстановитьПараметр("Дата", ПараметрыПечати.ДанныеОтчета.ОкончаниеПериода);
	Запрос.УстановитьПараметр("ФИОЗатребовавшего", ПараметрыПечати.ДанныеОтчета.Затребовал);
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Запрос.УстановитьПараметр("Утвердил", ПараметрыПечати.ДанныеОтчета.Утвердил);
	
	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеПоЗатребовавшему = МассивРезультатовЗапроса[0];
	ДанныеПоУтвердившему = МассивРезультатовЗапроса[1];
	ДанныеПоТоварам = МассивРезультатовЗапроса[4];

	СтруктураДанных = Новый Структура; 
	СтруктураДанных.Вставить("ДанныеПоЗатребовавшему", ДанныеПоЗатребовавшему); 
	СтруктураДанных.Вставить("ДанныеПоУтвердившему", ДанныеПоУтвердившему);
	СтруктураДанных.Вставить("ДанныеПоТоварам", ДанныеПоТоварам);

	Возврат СтруктураДанных;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
