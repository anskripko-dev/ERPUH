#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ОбъектыПечати") Тогда 
		Для Каждого ОбъектПечати Из Параметры.ОбъектыПечати Цикл
			НоваяСтрока = Объект.ДокументыПечати.Добавить();
			НоваяСтрока.Документ = ОбъектПечати;
		КонецЦикла;	
	КонецЕсли;
	
	УстановитьВидимостьДоступностьРеквизитов();
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПереключательТипПриказаПриИзменении(Элемент)  
	
	УстановитьВидимостьДоступностьРеквизитов(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПечатиПриИзменении(Элемент) 
	
	Если ВидПечати = 1 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("В документах, указанных в табличной части обработки, будет установлен флаг ""Включено в отчет о списании рекламной продукции""");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	МенеджерПечати = "Обработка.тн_Печать_ОтчетОСписанииРекламнойПродукции";
	Идентификатор = "тн_ОтчетОСписанииРекламнойПродукции";
	ОбъектыПечати = СписокДокументовПечати();  

	ДанныеОтчета = Новый Структура();
	ДанныеОтчета.Вставить("ТипПриказа", ТипПриказа);  
	ДанныеОтчета.Вставить("ВидПечати", ВидПечати);
	ДанныеОтчета.Вставить("Кому", Объект.Кому);
	ДанныеОтчета.Вставить("Мероприятие", Объект.Мероприятие);  
	ДанныеОтчета.Вставить("МестоПроведения", Объект.МестоПроведения);  
	ДанныеОтчета.Вставить("НачалоПериода", Объект.НачалоПериода);  
	ДанныеОтчета.Вставить("ОкончаниеПериода", Объект.ОкончаниеПериода); 
	ДанныеОтчета.Вставить("Утвердил", Объект.Утвердил); 
	ДанныеОтчета.Вставить("Затребовал", Объект.Затребовал);
	ДанныеОтчета.Вставить("РаспечататьКаждыйДокументОтдельно", Объект.РаспечататьКаждыйДокументОтдельно);

	ДополнительныеПараметрыПечати = Новый Структура();
	ДополнительныеПараметрыПечати.Вставить("ДанныеОтчета", ДанныеОтчета);
	
	Если ВидПечати = 0 Тогда 
		
		Если Объект.РаспечататьКаждыйДокументОтдельно ИЛИ ОбъектыПечати.Количество() = 1 Тогда
			Для Каждого Документ Из ОбъектыПечати Цикл 
				ДокументыКПечати  = Новый Массив;
				ДокументыКПечати.Добавить(Документ);
				УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(МенеджерПечати, Идентификатор, ДокументыКПечати,, ДополнительныеПараметрыПечати); 
			КонецЦикла;
		Иначе 
			УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(МенеджерПечати, Идентификатор, ОбъектыПечати,, ДополнительныеПараметрыПечати); 
		КонецЕсли;
		
	Иначе
				
		Если Объект.РаспечататьКаждыйДокументОтдельно ИЛИ ОбъектыПечати.Количество() = 1 Тогда
			Для Каждого Документ Из ОбъектыПечати Цикл 
				ДокументыКПечати  = Новый Массив;
				ДокументыКПечати.Добавить(Документ); 
				УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер(МенеджерПечати, Идентификатор, ДокументыКПечати, ДополнительныеПараметрыПечати);
			КонецЦикла;
		Иначе
			УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер(МенеджерПечати, Идентификатор, ОбъектыПечати, ДополнительныеПараметрыПечати); 
		КонецЕсли;  
		
		УстановитьПризнакВключенияВОтчетОСписанииРекламнойПродукции(ОбъектыПечати);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПодобратьДокументы(Команда) 
	
	Если Объект.ДокументыПечати.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх("Список документов будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет); 
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодобратьДокументыНаСервере(); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьДоступностьРеквизитов()

	Элементы.Кому.Доступность = ТипПриказа = 0;
	Элементы.Мероприятие.Доступность = ТипПриказа = 1;
	Элементы.МестоПроведения.Доступность = ТипПриказа = 1;
	
КонецПроцедуры

&НаСервере
Функция СписокДокументовПечати()  
	
	ОбъектыПечати = Новый Массив;  
	Для Каждого СтрокаДокументыПечати Из Объект.ДокументыПечати Цикл
		ОбъектыПечати.Добавить(СтрокаДокументыПечати.Документ);
	КонецЦикла; 
	Возврат ОбъектыПечати;   
	
КонецФункции

&НаСервере
Процедура ПодобратьДокументыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнутреннееПотребление.Ссылка КАК Документ
		|ИЗ
		|	Документ.ВнутреннееПотребление КАК ВнутреннееПотребление
		|ГДЕ
		|	ВнутреннееПотребление.Проведен
		|	И ВнутреннееПотребление.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ВнутреннееПотребление.тн_ВидСписания = ЗНАЧЕНИЕ(Перечисление.тн_ВидыСписанияРекламаПодарки.Реклама)
		|	И ВнутреннееПотребление.Организация = &Организация
		|	И ВнутреннееПотребление.Склад = &Склад
		|	И НЕ ВнутреннееПотребление.тн_ВключеноВОтчетОСписанииРП";
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВнутреннееПотребление.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода", "");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВнутреннееПотребление.Организация = &Организация", "");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВнутреннееПотребление.Склад = &Склад", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	
	СписокДокументов = Запрос.Выполнить().Выгрузить();
	Объект.ДокументыПечати.Загрузить(СписокДокументов);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакВключенияВОтчетОСписанииРекламнойПродукции(ОбъектыПечати) 
	
	Для Каждого Документ Из ОбъектыПечати Цикл
		ДокументОбъект = Документ.ПолучитьОбъект();
		ДокументОбъект.тн_ВключеноВОтчетОСписанииРП = Истина;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла; 
	
КонецПроцедуры
	
#КонецОбласти