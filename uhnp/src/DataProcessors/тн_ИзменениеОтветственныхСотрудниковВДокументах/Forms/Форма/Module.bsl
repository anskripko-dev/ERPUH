
&НаСервере
Процедура НайтиДокументыНаСервре()
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	               |ГДЕ
	               |	ПриобретениеТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ПриобретениеТоваровУслуг.Организация = &Организация
	               |	И ПриобретениеТоваровУслуг.тн_ОтветственныйСотрудник = &ОтветственныйСотрудник
	               |	И ПриобретениеТоваровУслуг.Проведен
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ПриобретениеУслугПрочихАктивов.Ссылка
	               |ИЗ
	               |	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
	               |ГДЕ
	               |	ПриобретениеУслугПрочихАктивов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ПриобретениеУслугПрочихАктивов.Организация = &Организация
	               |	И ПриобретениеУслугПрочихАктивов.тн_ОтветственныйСотрудник = &ОтветственныйСотрудник
	               |	И ПриобретениеУслугПрочихАктивов.Проведен";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтветственныйСотрудник", Ответственный);
	
	Документы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументы(Команда)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Организация) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите организацию.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите ответственного сотрудника.'"),,,,Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите начало периода.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите конец периода.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда 
		НайтиДокументыНаСервре(); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ИзменитьОтветственногоНаСервере()
	
	Для Каждого СтрокаТЧ Из Документы Цикл
		
		Если СтрокаТЧ.Выбор Тогда
			
			ДокументОбъект = СтрокаТЧ.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.тн_ОтветственныйСотрудник = НовыйОтветственный;
			ДокументОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтветственного(Команда)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(НовыйОтветственный) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите нового ответственного сотрудника.'"),,,,Отказ);
		
	КонецЕсли;
	
	Если Не Отказ Тогда 
		
		ИзменитьОтветственногоНаСервере();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Изменение документов завершено.'"));
		
	КонецЕсли;
	
КонецПроцедуры
