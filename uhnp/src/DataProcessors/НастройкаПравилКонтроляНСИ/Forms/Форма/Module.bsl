&НаКлиенте
Перем ВыполняетсяЗакрытие;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ЦветЧетныйВидОтчета        = Новый Цвет(255, 255, 255);
	ЦветНеЧетныйВидОтчета      = Новый Цвет(255, 255, 255);
	ЦветУзораЧетныйВидОтчета   = Новый Цвет(255, 255, 255);
	ЦветУзораНеЧетныйВидОтчета = Новый Цвет(255, 255, 255);
	ЦветФонаЧетнойСтроки       = Новый Цвет(255, 255, 255);
	
	ПолучитьДанныеРегистраКонтроляНСИ();
	
	ЗаполнитьТаблицыНастроек();
	
	ОбновитьПолеНастройки();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПолеНастройки()
		
	ПолеНастройки.Очистить();
	
	Макет = Обработки.НастройкаПравилКонтроляНСИ.ПолучитьМакет("Макет");
	
	ОбластьОписаниеОбъекта   = Макет.ПолучитьОбласть("ОписаниеОбъектаТек");
	ОбластьТипБД = Макет.ПолучитьОбласть("ТипБД");
	ОбластьДетализация = Макет.ПолучитьОбласть("Детализация");
	
	ПолеНастройки.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	Инд = 1;
	
	Для Каждого СтрокаОписаниеОбъектаТек Из ТаблицаОбъектовБД Цикл
		
		Если СтрокаОписаниеОбъектаТек.ИзмененияПоЗаявкам Тогда
			
			ТекстОписание=Строка(СтрокаОписаниеОбъектаТек.ОписаниеОбъектаТек)+Символы.ПС+Нстр("ru = '(изменения по заявкам)'");
			
		Иначе
			
			ТекстОписание=Строка(СтрокаОписаниеОбъектаТек.ОписаниеОбъектаТек);
			
		КонецЕсли;
				
		ОбластьОписаниеОбъекта.Параметры.ОписаниеОбъектаТек   	= ТекстОписание;
		ОбластьОписаниеОбъекта.Параметры.Расшифровка 	= Новый Структура("ОписаниеОбъектаТек",СтрокаОписаниеОбъектаТек.ОписаниеОбъектаТек);
		ТекОбласть = ПолеНастройки.Присоединить(ОбластьОписаниеОбъекта);
		ТекОбласть.ЦветФона  = ?(ОбщегоНазначенияУХ.ЧетноеЧисло(Инд), ЦветЧетныйВидОтчета, ЦветНеЧетныйВидОтчета);
		ТекОбласть.ЦветУзора = ?(ОбщегоНазначенияУХ.ЧетноеЧисло(Инд), ЦветУзораЧетныйВидОтчета, ЦветУзораНеЧетныйВидОтчета);
		СтрокаОписаниеОбъектаТек.Колонка = ТекОбласть.Лево;
		Инд = Инд + 1;
		
	КонецЦикла;
	
	Инд = 1;
	
	Для Каждого СтрокаТипБД Из ТаблицаТиповБД Цикл
				
		ТаблДокСтрока = Новый ТабличныйДокумент;
		ОбластьТипБД.Параметры.ТипБД = СтрокаТипБД.ТипБД;
		ОбластьТипБД.Параметры.Расшифровка = Новый Структура("ТипБД",СтрокаТипБД.ТипБД);
		ТаблДокСтрока.Вывести(ОбластьТипБД);//.ЦветФона = ?(ОбщегоНазначенияУХ.ЧетноеЧисло(Инд), ЦветФонаЧетнойСтроки, Новый Цвет());
		
		Для Каждого СтрокаОписаниеОбъектаТек ИЗ ТаблицаОбъектовБД Цикл
			
			Структура = Новый Структура("ОписаниеОбъектаТек, ТипБД", СтрокаОписаниеОбъектаТек.ОписаниеОбъектаТек, СтрокаТипБД.ТипБД);
			НайденныеСтроки = ТаблицаНастроекСоответствий.НайтиСтроки(Структура);
			
			Если НайденныеСтроки.Количество()=0 Тогда
				
				Структура.Вставить("ПоставщикПотребительНСИ",Перечисления.ПоставщикПотребительНСИ.ПустаяСсылка());
				Структура.Вставить("ЕстьСоответствие",Ложь);
				
				ОбластьДетализация.Параметры.Расшифровка  				= Структура;
				ОбластьДетализация.Параметры.ТекстПравила  				= Нстр("ru = 'Соответствие не установлено'");
																					
				ТекОбласть = ТаблДокСтрока.Присоединить(ОбластьДетализация);
				
			Иначе
				
				НайденныеСтрокиКонтроля = ТаблицаПравилКонтроля.НайтиСтроки(Структура);
				
				Если НайденныеСтрокиКонтроля.Количество()=0 Тогда
					
					Структура.Вставить("ПоставщикПотребительНСИ",Перечисления.ПоставщикПотребительНСИ.ПустаяСсылка());
					Структура.Вставить("ЕстьСоответствие",Истина);
					
					ОбластьДетализация.Параметры.Расшифровка  				= Структура;
					ОбластьДетализация.Параметры.ТекстПравила  				= Нстр("ru = 'Поставщик и потребитель'");
					
					ТекОбласть = ТаблДокСтрока.Присоединить(ОбластьДетализация);
					
				Иначе
					
					СтрокаКонтроля=НайденныеСтрокиКонтроля[0];
					
					Структура.Вставить("ПоставщикПотребительНСИ",СтрокаКонтроля.ПоставщикПотребительНСИ);
					Структура.Вставить("ЕстьСоответствие",Истина);
					ОбластьДетализация.Параметры.Расшифровка  				= Структура;
					ОбластьДетализация.Параметры.ТекстПравила  				= СтрокаКонтроля.ТекстПравилаКонтроля;
					
					ТекОбласть = ТаблДокСтрока.Присоединить(ОбластьДетализация);
					ТекОбласть.Шрифт = Новый Шрифт(ТекОбласть.Шрифт, , , СтрокаКонтроля.НастройкаИзменена);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТекОбласть = ПолеНастройки.Вывести(ТаблДокСтрока);
		СтрокаТипБД.Ряд = ТекОбласть.Верх;
		Инд = Инд + 1;
		
	КонецЦикла;
	
	ПолеНастройки.ФиксацияСверху = 1;
	ПолеНастройки.ФиксацияСЛЕВА  = 2;
	
	ЗапросКоординаты=Новый Запрос;
	ЗапросКоординаты.Текст="ВЫБРАТЬ
	|	ТаблицаТиповБД.ТипБД,
	|	ТаблицаТиповБД.Ряд
	|ПОМЕСТИТЬ СтрокиТиповБД
	|ИЗ
	|	&ТаблицаТиповБД КАК ТаблицаТиповБД
	|ГДЕ
	|	ТаблицаТиповБД.Ряд <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОбъектовБД.ОписаниеОбъектаТек,
	|	ТаблицаОбъектовБД.Колонка
	|ПОМЕСТИТЬ КолонкиОбъектов
	|ИЗ
	|	&ТаблицаОбъектовБД КАК ТаблицаОбъектовБД
	|ГДЕ
	|	ТаблицаОбъектовБД.Колонка <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиТиповБД.ТипБД,
	|	СтрокиТиповБД.Ряд КАК Ряд,
	|	КолонкиОбъектов.ОписаниеОбъектаТек,
	|	КолонкиОбъектов.Колонка КАК Лево
	|ИЗ
	|	СтрокиТиповБД КАК СтрокиТиповБД,
	|	КолонкиОбъектов КАК КолонкиОбъектов";
	
	ЗапросКоординаты.УстановитьПараметр("ТаблицаТиповБД",РеквизитФормыВЗначение("ТаблицаТиповБД"));
	ЗапросКоординаты.УстановитьПараметр("ТаблицаОбъектовБД",РеквизитФормыВЗначение("ТаблицаОбъектовБД"));
	
	ЗначениеВРеквизитФормы(ЗапросКоординаты.Выполнить().Выгрузить(),"ТаблицаКоординат");
		
КонецПроцедуры  

&НаСервере
Процедура ПолучитьДанныеРегистраКонтроляНСИ()

	ТаблицаПравилКонтроля.Очистить();
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	УстановкаПараметровКонтроляНСИ.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	УстановкаПараметровКонтроляНСИ.ОписаниеОбъектаТек.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	УстановкаПараметровКонтроляНСИ.ТипБД КАК ТипБД,
	             |	УстановкаПараметровКонтроляНСИ.ПоставщикПотребительНСИ КАК ПоставщикПотребительНСИ
	             |ИЗ
	             |	РегистрСведений.УстановкаПараметровКонтроляНСИ КАК УстановкаПараметровКонтроляНСИ
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	СправочникиБД.Ссылка,
	             |	СправочникиБД.ВидКонтроляНСИ,
	             |	СправочникиБД.Владелец,
	             |	СправочникиБД.ПоставщикПотребительНСИ
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |	И НЕ СправочникиБД.ПометкаУдаления
	             |	И НЕ СправочникиБД.ВидКонтроляНСИ = ЗНАЧЕНИЕ(Перечисление.ВидыКонтроляНСИ.НеКонтролировать)";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=ТаблицаПравилКонтроля.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		НоваяСтрока.ТекстПравилаКонтроля=ПолучитьСтрокуПоставщикПотребительНСИ(Результат.ПоставщикПотребительНСИ);
		
	КонецЦикла;
		
КонецПроцедуры // ПолучитьДанныеРегистраКонтроляНСИ() 

&НаСервере
Процедура ЗаполнитьТаблицыНастроек()
	
	ТаблицаТиповБД.Очистить();
	ТаблицаОбъектовБД.Очистить();
	ТаблицаНастроекСоответствий.Очистить();
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК Ссылка,
	             |	СправочникиБД.Владелец КАК ТипБД,
	             |	ВЫБОР
	             |		КОГДА СправочникиБД.ВидКонтроляНСИ = ЗНАЧЕНИЕ(Перечисление.ВидыКонтроляНСИ.ИзмененияПоЗаявкам)
	             |			ТОГДА ИСТИНА
	             |		ИНАЧЕ ЛОЖЬ
	             |	КОНЕЦ КАК ИзмененияПоЗаявкам,
	             |	СправочникиБД.ВидКонтроляНСИ КАК ВидКонтроляНСИ
	             |ПОМЕСТИТЬ ОписаниеОбъектаТек
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |	И НЕ(СправочникиБД.ВидКонтроляНСИ = ЗНАЧЕНИЕ(Перечисление.ВидыКонтроляНСИ.НеКонтролировать)
	             |				ИЛИ СправочникиБД.ВидКонтроляНСИ = ЗНАЧЕНИЕ(Перечисление.ВидыКонтроляНСИ.ПустаяСсылка))
	             |	И НЕ СправочникиБД.ПометкаУдаления
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СоответствиеВнешнимИБ.Владелец КАК ТипБД,
	             |	1 КАК ВнешняяИБ,
	             |	СоответствиеВнешнимИБ.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	ЛОЖЬ КАК ИзмененияПоЗаявкам,
	             |	ЗНАЧЕНИЕ(Перечисление.ВидыКонтроляНСИ.ПустаяСсылка) КАК ВидКонтроляНСИ
	             |ПОМЕСТИТЬ ТаблицаНастроекСоответствий
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |ГДЕ
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаТек В
	             |			(ВЫБРАТЬ
	             |				ОписаниеОбъектаТек.Ссылка
	             |			ИЗ
	             |				ОписаниеОбъектаТек)
	             |	И СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы = ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.Предприятие83)
	             |	И СоответствиеВнешнимИБ.Владелец.КонтролироватьНСИ
	             |	И НЕ СоответствиеВнешнимИБ.ПометкаУдаления
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ОписаниеОбъектаТек.ТипБД,
	             |	0,
	             |	ЛОЖЬ,
	             |	ОписаниеОбъектаТек.Ссылка,
	             |	ОписаниеОбъектаТек.ИзмененияПоЗаявкам,
	             |	ОписаниеОбъектаТек.ВидКонтроляНСИ
	             |ИЗ
	             |	ОписаниеОбъектаТек КАК ОписаниеОбъектаТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ОписаниеОбъектаТек.Ссылка КАК ОписаниеОбъектаТек,
	             |	ОписаниеОбъектаТек.ИзмененияПоЗаявкам КАК ИзмененияПоЗаявкам,
	             |	ОписаниеОбъектаТек.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	0 КАК Колонка
	             |ИЗ
	             |	ОписаниеОбъектаТек КАК ОписаниеОбъектаТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ТаблицаНастроекСоответствий.ТипБД КАК ТипБД,
	             |	ТаблицаНастроекСоответствий.ВнешняяИБ КАК ВнешняяИБ,
	             |	0 КАК Ряд
	             |ИЗ
	             |	ТаблицаНастроекСоответствий КАК ТаблицаНастроекСоответствий
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ТаблицаНастроекСоответствий.ВнешняяИБ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТаблицаНастроекСоответствий.ТипБД КАК ТипБД,
	             |	ТаблицаНастроекСоответствий.ВнешняяИБ КАК ВнешняяИБ,
	             |	ТаблицаНастроекСоответствий.СинхронизацияПоGUID КАК СинхронизацияПоGUID,
	             |	ТаблицаНастроекСоответствий.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	ТаблицаНастроекСоответствий.ИзмененияПоЗаявкам КАК ИзмененияПоЗаявкам
	             |ИЗ
	             |	ТаблицаНастроекСоответствий КАК ТаблицаНастроекСоответствий
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ТаблицаНастроекСоответствий.ВнешняяИБ";
		
	Результат=Запрос.ВыполнитьПакет(); 
	
	ЗначениеВРеквизитФормы(Результат[2].Выгрузить(),"ТаблицаОбъектовБД");
	
	ДанныеБД=Результат[3].Выбрать();
	
	Пока ДанныеБД.Следующий() Цикл
		
		НоваяСтрока=ТаблицаТиповБД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеБД);
		
	КонецЦикла;
		
	ДанныеНастроек=Результат[4].Выбрать();
	
	Пока ДанныеНастроек.Следующий() Цикл
		
		НоваяСтрока=ТаблицаНастроекСоответствий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ДанныеНастроек);
		
	КонецЦикла;
			
КонецПроцедуры // ЗаполнитьТаблицыНастроек()

&НаСервере
Функция ПолучитьСтрокуПоставщикПотребительНСИ(ПоставщикПотребительНСИ)

	Если ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.Поставщик Тогда
		
		Возврат Нстр("ru = 'Поставщик'");
		
	ИначеЕсли ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.Потребитель Тогда
		
		Возврат Нстр("ru = 'Потребитель'");
		
	Иначе
		
		Возврат Нстр("ru = 'Поставщик и потребитель'");
		
	КонецЕсли;
	
	
КонецФункции // ПолучитьСтрокуПоставщикПотребительНСИ() 

&НаКлиенте
Процедура ПослеВводаТипаКонтроля(Значение,ДополнительныеПараметры) Экспорт
	
	Если Значение=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ОписаниеОбъектаТек")
		И ДополнительныеПараметры.Свойство("ТипБД") Тогда
		
		ОбработатьСтрокуКонтроля(Значение,Новый Структура("ОписаниеОбъектаТек,ТипБД",
					ДополнительныеПараметры.ОписаниеОбъектаТек,
					ДополнительныеПараметры.ТипБД));
					
	ИначеЕсли ДополнительныеПараметры.Свойство("ОписаниеОбъектаТек") Тогда
		
		Для Каждого Строка ИЗ ТаблицаТиповБД Цикл
			
			ОбработатьСтрокуКонтроля(Значение,Новый Структура("ОписаниеОбъектаТек,ТипБД",
					ДополнительныеПараметры.ОписаниеОбъектаТек,
					Строка.ТипБД));
					
		КонецЦикла;
				
	ИначеЕсли ДополнительныеПараметры.Свойство("ТипБД") Тогда		
		
		Для Каждого Строка ИЗ ТаблицаОбъектовБД Цикл
						
			ОбработатьСтрокуКонтроля(Значение,Новый Структура("ОписаниеОбъектаТек,ТипБД",
					Строка.ОписаниеОбъектаТек,
					ДополнительныеПараметры.ТипБД));
					
		КонецЦикла;
			
	КонецЕсли;			
		
КонецПроцедуры // ПослеВводаВидаДоступа() 

&НаКлиенте
Процедура ОбработатьСтрокуКонтроля(Значение,СтруктураПоиска)
	
	ДанныеСоответствий=ТаблицаНастроекСоответствий.НайтиСтроки(СтруктураПоиска);
	
	Если ДанныеСоответствий.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьПоставщикПотребительНСИ(Значение,СтруктураПоиска);
	
КонецПроцедуры // ОбработатьСтрокуКонтроля() 

&НаСервере
Процедура УстановитьПоставщикПотребительНСИ(Значение,СтруктураПоиска) 
	
	ДобавитьОбновитьСтрокуКонтроля(Значение,СтруктураПоиска);
	
	Если Значение=Перечисления.ПоставщикПотребительНСИ.Поставщик
		И СтруктураПоиска.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ Тогда 
		
		Для Каждого Строка ИЗ ТаблицаТиповБД Цикл 
			
			Если Строка.ТипБД=Справочники.ТипыБазДанных.ТекущаяИБ Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ТекСтруктураПоиска=Новый Структура("ОписаниеОбъектаТек,ТипБД",СтруктураПоиска.ОписаниеОбъектаТек,Строка.ТипБД);
			
			ДобавитьОбновитьСтрокуКонтроля(Перечисления.ПоставщикПотребительНСИ.Потребитель,ТекСтруктураПоиска);
			
		КонецЦикла;
		
	КонецЕсли;
			
	ОбновитьПолеНастройки();
	
КонецПроцедуры // УстановитьПоставщикПотребительНСИ()

&НаСервере
Процедура ДобавитьОбновитьСтрокуКонтроля(Значение,СтруктураПоиска)
	
	ДанныеКонтроля=ТаблицаПравилКонтроля.НайтиСтроки(СтруктураПоиска);
										
	Если ДанныеКонтроля.Количество()=0 Тогда
						
		СтрокаКонтроля=ТаблицаПравилКонтроля.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКонтроля,СтруктураПоиска);
		
	Иначе
		
		СтрокаКонтроля=ДанныеКонтроля[0];	
		
	КонецЕсли;
	
	СтрокаКонтроля.ТекстПравилаКонтроля=ПолучитьСтрокуПоставщикПотребительНСИ(Значение);
	СтрокаКонтроля.ПоставщикПотребительНСИ=Значение;
	СтрокаКонтроля.НастройкаИзменена=Истина;
	
	
КонецПроцедуры // ДобавитьОбновитьСтрокуКонтроля() 
	
	
	

&НаКлиенте
Процедура ПолеНастройкиОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	Если Расшифровка.Свойство("ЕстьСоответствие") И НЕ Расшифровка.ЕстьСоответствие Тогда
		
		ПоказатьПредупреждение(,СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Для объекта %1 не установлено соответствие объекту информационной базы типа %2'"),Расшифровка.ОписаниеОбъектаТек,Расшифровка.ТипБД));
	    Возврат;
		
	КонецЕсли;
	
	ТекПоставщикПотребитель=?(Расшифровка.Свойство("ПоставщикПотребительНСИ"),Расшифровка.ПоставщикПотребительНСИ,ПредопределенноеЗначение("Перечисление.ПоставщикПотребительНСИ.ПустаяСсылка"));
	
	ОписаниеОповещения=Новый ОписаниеОповещения("ПослеВводаТипаКонтроля",ЭтотОбъект,Расшифровка);
	ПоказатьВводЗначения(ОписаниеОповещения,ТекПоставщикПотребитель,НСтр("ru = 'Укажите признак поставщик / потребитель'"));
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
		
КонецПроцедуры

&НаСервере
Процедура Применить()
	
	ТекТаблицаКонтроля=РеквизитФормыВЗначение("ТаблицаПравилКонтроля");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ТекТаблицаКонтроля.ТипБД КАК ТипБД,
	             |	ТекТаблицаКонтроля.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	ТекТаблицаКонтроля.ПоставщикПотребительНСИ КАК ПоставщикПотребительНСИ,
				 |	ТекТаблицаКонтроля.ВидКонтроляНСИ КАК ВидКонтроляНСИ
	             |ПОМЕСТИТЬ ТаблицаКонтроля
	             |ИЗ
	             |	&ТекТаблицаКонтроля КАК ТекТаблицаКонтроля
	             |ГДЕ
	             |	ТекТаблицаКонтроля.НастройкаИзменена
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТаблицаКонтроля.ТипБД КАК ТипБД,
	             |	ТаблицаКонтроля.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	ТаблицаКонтроля.ПоставщикПотребительНСИ КАК ПоставщикПотребительНСИ,
				 |	ТаблицаКонтроля.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	СоответствиеВнешнимИБ.Ссылка КАК НастройкаСоответствия
	             |ПОМЕСТИТЬ ТабНастройкиСоответствия
	             |ИЗ
	             |	ТаблицаКонтроля КАК ТаблицаКонтроля
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |		ПО ТаблицаКонтроля.ТипБД = СоответствиеВнешнимИБ.Владелец
	             |			И ТаблицаКонтроля.ОписаниеОбъектаТек = СоответствиеВнешнимИБ.ОписаниеОбъектаТек
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТабНастройкиСоответствия.ТипБД КАК ТипБД,
	             |	ТабНастройкиСоответствия.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	ТабНастройкиСоответствия.ПоставщикПотребительНСИ КАК ПоставщикПотребительНСИ,
				 |	ТабНастройкиСоответствия.ВидКонтроляНСИ КАК ВидКонтроляНСИ,
	             |	ТабНастройкиСоответствия.НастройкаСоответствия КАК НастройкаСоответствия,
	             |	ВнешниеИнформационныеБазы.Ссылка КАК ИспользуемаяИБ,
	             |	ВнешниеИнформационныеБазы.ТипБД.ОбменДаннымиРегламентнымЗаданием КАК ОбменДаннымиРегламентнымЗаданием
	             |ИЗ
	             |	ТабНастройкиСоответствия КАК ТабНастройкиСоответствия
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	             |		ПО ТабНастройкиСоответствия.ТипБД = ВнешниеИнформационныеБазы.ТипБД";
	
	Запрос.УстановитьПараметр("ТекТаблицаКонтроля",ТекТаблицаКонтроля);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НаборЗаписей=РегистрыСведений.УстановкаПараметровКонтроляНСИ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОписаниеОбъектаТек.Установить(Результат.ОписаниеОбъектаТек);
		НаборЗаписей.Отбор.ТипБД.Установить(Результат.ТипБД);
		НаборЗаписей.Отбор.НастройкаСоответствия.Установить(Результат.НастройкаСоответствия);
		НаборЗаписей.Отбор.ИспользуемаяИБ.Установить(Результат.ИспользуемаяИБ);
		
		НоваяСтрока=НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		НоваяСтрока.ТипКонтроляНСИ=Справочники.СправочникиБД.ПолучитьТипКонтроляНСИ(Результат.ВидКонтроляНСИ,Результат.ПоставщикПотребительНСИ);
		
		НаборЗаписей.Записать(Истина);
		
		Если НЕ Результат.ОбменДаннымиРегламентнымЗаданием Тогда
			
			ОбменДаннымиНСИУХ.ВыгрузитьДанныеКонтроляНСИ(,Истина,Истина,Результат.ИспользуемаяИБ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	МассивТекущие=ТаблицаПравилКонтроля.НайтиСтроки(Новый Структура("ТипБД,НастройкаИзменена",Справочники.ТипыБазДанных.ТекущаяИБ,Истина));
	
	Для Каждого Строка ИЗ МассивТекущие Цикл
		
		СправочникОбъект=Строка.ОписаниеОбъектаТек.ПолучитьОбъект();
		СправочникОбъект.ПоставщикПотребительНСИ=Строка.ПоставщикПотребительНСИ;
		
		Если Строка.ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.Поставщик Тогда
			
			СправочникОбъект.СоздаватьПриНеудачномПоискеПриИмпорте=Ложь; 
			
		Иначе
			
			СправочникОбъект.СоздаватьПриНеудачномПоискеПриИмпорте=Истина;
			СправочникОбъект.ОбновлятьРеквизитыПриИмпорте=Истина;
				
		КонецЕсли;
				
		СправочникОбъект.Записать();
		
	КонецЦикла;
		
	ПолучитьДанныеРегистраКонтроляНСИ();	
	ЗаполнитьТаблицыНастроек();
	ОбновитьПолеНастройки();
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	Применить();
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	
	ОбновитьПолеНастройки();
	
КонецПроцедуры	

