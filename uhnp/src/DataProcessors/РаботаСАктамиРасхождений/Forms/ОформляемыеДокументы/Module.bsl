&НаСервере
Процедура ВывестиДокументИсправлениеОтгрузкаТоваровСХранения(СтрокаДействия, Макет, Описание)
	
	Если НеВыводитьВОтчет("ВывестиДокументИсправлениеОтгрузкаТоваровСХранения", СтрокаДействия.Основание) Тогда
		Возврат;
	КонецЕсли;
	
	МассивОформленныхДокументов = Новый Массив;
	
	ОформленныеДокументы = ИсправленияПоОтгрузкамТоваровСХранения.НайтиСтроки(
		Новый Структура("ОтгрузкаТоваровСХранения", СтрокаДействия.Основание));
	Если ОформленныеДокументы.Количество() = 0 Тогда
		
		ОписаниеОформляемогоДокумента = Новый Структура("ОформляемыйДокумент, Склад, Исправление",
			СтрокаДействия.Основание,
			Справочники.Склады.ПустаяСсылка(),
			Истина);
		МассивОформленныхДокументов.Добавить(ОписаниеОформляемогоДокумента);
		
	Иначе
		
		Для Каждого ОформленныйДокумент Из ОформленныеДокументы Цикл
			ДокументИсправление = ОформленныйДокумент.ОтгрузкаТоваровСХраненияИсправление;
			МассивОформленныхДокументов.Добавить(ОформленныйДокумент.ОтгрузкаТоваровСХраненияИсправление);
		КонецЦикла;
		
	КонецЕсли;
	
	ВывестиДокументКОформлению(
		"ДокументИсправлениеОтгрузкаТоваровСХранения",
		1,
		Макет,
		МассивОформленныхДокументов,
		ХозяйственнаяОперацияАкта,
		Ложь,
		Описание);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДокументПриемкаТоваровНаХранение(СтрокаДействия, Макет, Описание)
	
	Если НеВыводитьВОтчет("ВывестиДокументПриемкаТоваровНаХранение", СтрокаДействия.Основание) Тогда
		Возврат;
	КонецЕсли;
	
	МассивОформленныхДокументов = Новый Массив;
	
	Отбор                = Новый Структура("Основание", СтрокаДействия.Основание);
	ОформленныеДокументы = ДопоступленияПоОтгрузкамТоваровСХранения.НайтиСтроки(Отбор);
	
	Если ОформленныеДокументы.Количество() = 0 Тогда
		Если Описание.СпособОтражения = Перечисления.СпособыОтраженияРасхожденийАктПриемкиКлиента.ОформлениеКорректировкиКакИсправлениеПервичныхДокументов Тогда
			ОписаниеОформляемогоДокумента = Новый Структура;
			ОписаниеОформляемогоДокумента.Вставить("ОформляемыйДокумент", Документы.ПриемкаТоваровНаХранение.ПустаяСсылка());
			ОписаниеОформляемогоДокумента.Вставить("Исправление",         Ложь);
			ОписаниеОформляемогоДокумента.Вставить("ЕстьИсправление",     ЗначениеЗаполнено(ДокументИсправление));
			ОписаниеОформляемогоДокумента.Вставить("ДокументИсправление", ДокументИсправление);
			МассивОформленныхДокументов.Добавить(ОписаниеОформляемогоДокумента);
		Иначе
			МассивОформленныхДокументов.Добавить(Документы.ПриемкаТоваровНаХранение.ПустаяСсылка());
		КонецЕсли;
	Иначе
		Для Каждого ОформленныйДокумент Из ОформленныеДокументы Цикл
			МассивОформленныхДокументов.Добавить(ОформленныйДокумент.ПриемкаТоваровНаХранение);
		КонецЦикла;
	КонецЕсли;
	
	ХозяйственнаяОперация = Неопределено;
	//++ НЕ УТКА
	Если ХозяйственнаяОперацияАкта = Перечисления.ХозяйственныеОперации.ПередачаДавальцу2_5
	 Или ХозяйственнаяОперацияАкта = Перечисления.ХозяйственныеОперации.ВозвратДавальцу2_5 Тогда
		ХозяйственнаяОперация = ХозяйственнаяОперацияАкта;
	КонецЕсли;
	//-- НЕ УТКА
	
	ВывестиДокументКОформлению(
		"ПриемкаТоваровНаХранение",
		2,
		Макет,
		МассивОформленныхДокументов,
		ХозяйственнаяОперация,
		Истина,
		Описание);
	
КонецПроцедуры

