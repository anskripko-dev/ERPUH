								|en = 'Document ""Sales return request"" for overdelivered goods for return'");
		//++ НЕ УТ
		ИначеЕсли ХозяйственнаяОперацияАкта = Перечисления.ХозяйственныеОперации.ПередачаПереработчику2_5 Тогда
			ТекстШапки = НСтр("ru = 'Документ ""Поступление от переработчика"" по перепоставленным товарам к возврату';
								|en = 'The ""Goods receipt — External subcontracting"" document for overdelivered goods for return'");
		//-- НЕ УТ
		Иначе
			ТекстШапки = НСтр("ru = 'Документ ""Поступление товаров от хранителя"" по перепоставленным товарам к возврату';
								|en = 'The ""VMI return"" document by overdelivered goods for return'");
		КонецЕсли;
	ИначеЕсли ТипДокумента = "ДокументВозвратаКомиссионера" Тогда
