			ОписаниеОформляемогоДокумента = Новый Структура;
			ОписаниеОформляемогоДокумента.Вставить("ОформляемыйДокумент",   Документы.ПередачаТоваровХранителю.ПустаяСсылка());
			ОписаниеОформляемогоДокумента.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ПустаяСсылка());
			ОписаниеОформляемогоДокумента.Вставить("Исправление",           Ложь);
