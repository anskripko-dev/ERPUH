				МассивОформленныхДокументов.Добавить(ОформленныйЭлемент.Претензия);
			КонецЕсли;
			
		КонецЦикла;
		
		ВывестиДокументКОформлению(
			"Претензия",
			1,
			Макет,
			МассивОформленныхДокументов,,Ложь,
			Описание);
	КонецЦикла;
	
