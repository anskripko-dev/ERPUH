			МассивОформленныхДокументов.Добавить(ОформленныйДокумент.ДокументВозврата);
		КонецЦикла;
	КонецЕсли;
	
	ВывестиДокументКОформлению("ДокументВозвратаПередачи", 2, Макет, МассивОформленныхДокументов, Неопределено, Истина,Описание);
	
