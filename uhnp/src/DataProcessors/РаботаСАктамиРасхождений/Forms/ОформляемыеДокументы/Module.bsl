			МассивОформленныхДокументов.Добавить(?(ДобавитьЗаявкиНаВозврат,
													Документы.ЗаявкаНаВозвратТоваровОтКлиента.ПустаяСсылка(),
													Документы.ПоступлениеТоваровОтХранителя.ПустаяСсылка()));
		КонецЕсли;
		
	Иначе
