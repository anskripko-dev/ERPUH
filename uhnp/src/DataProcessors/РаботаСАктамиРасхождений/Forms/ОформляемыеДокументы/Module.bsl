			МассивОформленныхДокументов.Добавить(ОформленныйДокумент.ДокументВозврата);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВывестиДокументКОформлению(
		"ДокументВозврата",
		2,
		Макет,
		МассивОформленныхДокументов,
