		ВывестиДокументКОформлению(
			"СписаниеНедостачТоваров",
			1,
			Макет,
			МассивОформленныхДокументов,
			ХозяйственнаяОперация,,
			Описание);
		
	КонецЦикла;
	
КонецПроцедуры

