							|en = 'Document ""Sales return"" for unreturned goods'");
	ИначеЕсли ТипДокумента = "ЗаказКлиента" Тогда
		ТекстШапки = НСтр("ru = 'Отменить строки документов ""Заказ клиента"" по недопоставленным товарам';
