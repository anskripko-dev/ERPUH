
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Период.Вариант = ВариантСтандартногоПериода.СНачалаЭтогоКвартала;
	ЭтотОбъект.ОтборОрганизация = Ложь;
	ЭтотОбъект.ОтборКонтрагент = Ложь;
	ЭтотОбъект.ОтборПодразделение = Ложь;
	ЭтотОбъект.Элементы.ГруппаСчетаФактурыАванс.ТекущаяСтраница = Элементы.ГруппаНепопадающие;
	ЭтотОбъект.ПечататьСразу = Ложь;
	ЭтотОбъект.ПечатьСФ = 5;
	ЭтотОбъект.ПечатьСФСтрокой = "5";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьВидимостьДоступностьЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ОтборыПриИзменении(Элемент)
	
	ИмяРеквизита = "Отбор"+Элемент.Имя;
	ЭтотОбъект[ИмяРеквизита]=ЗначениеЗаполнено(Элемент.ТекстРедактирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ПериодПриИзмененииНаСервере();		

КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()
	Если Объект.Период.ДатаОкончания = Дата(01,01,0001) Тогда
		Объект.Период.ДатаОкончания = КонецДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	КонецЕсли;
	Если Объект.Период.ДатаНачала = Дата(01,01,0001) Тогда
		Объект.Период.ДатаНачала = НачалоМесяца(ОбщегоНазначения.ТекущаяДатаПользователя());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечататьСразуПриИзменении(Элемент)

	УстановитьВидимостьДоступностьЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ПечатьСФПриИзменении(Элемент)
	ПечатьСФ = Число(ПечатьСФСтрокой);
КонецПроцедуры
#КонецОбласти

#Область КомандыФормы

&НаСервере
Процедура ЗаполнитьТабличныеЧасти(ТекстЗапроса)
	
	ДанныеПакета = ПолучитьДанныеПакета(ТекстЗапроса);
	Объект.НепопадающиеСчетаФактуры.Загрузить(ДанныеПакета[4].Выгрузить());
	Объект.НепопадающиеСчетаФактуры.Сортировать("СчетФактура ВОЗР");
	Объект.ПопадающиеСчетаФактуры.Загрузить(ДанныеПакета[5].Выгрузить());
	Объект.ПопадающиеСчетаФактуры.Сортировать("СчетФактура ВОЗР");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляПечатиСразу(ТекстЗапроса)
	
	ДанныеПакета = ПолучитьДанныеПакета(ТекстЗапроса);
	ТабДанныеДляПечати = ДанныеПакета[ЭтотОбъект.ПечатьСФ].Выгрузить();
	ТабДанныеДляПечати.Сортировать("СчетФактура ВОЗР");               
	ДанныеДляПечати = ТабДанныеДляПечати.ВыгрузитьКолонку("СчетФактура");
	
	Возврат ДанныеДляПечати;

КонецФункции

&НаСервере
Функция ПолучитьДанныеПакета (ТекстЗапроса)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(Объект.Период.ДатаОкончания)+1);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ЗапросТекст = ДобавитьОтборыВТекстЗапроса(ТекстЗапроса());
	ЗаполнитьТабличныеЧасти(ЗапросТекст);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИнвертироватьНаСервере(ТабличнаяЧасть)
	
	Для Каждого СтрТЗ Из Объект[ТабличнаяЧасть] Цикл
		СтрТЗ.Пометка = Не СтрТЗ.Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Инвертировать(Команда)
	
	ТабличнаяЧасть = ОпределитьТабличнуюЧасть();
	ИнвертироватьНаСервере(ТабличнаяЧасть);
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьВсеНаСервере(ТабличнаяЧасть)
	
	Для Каждого СтрТЗ Из Объект[ТабличнаяЧасть] Цикл
		СтрТЗ.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	ТабличнаяЧасть = ОпределитьТабличнуюЧасть();
	ОтметитьВсеНаСервере(ТабличнаяЧасть);
	
КонецПроцедуры

&НаСервере
Процедура СнятьОтметкиНаСервере(ТабличнаяЧасть)
	
	Для Каждого СтрТЗ Из Объект[ТабличнаяЧасть] Цикл
		СтрТЗ.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры
                                            
&НаКлиенте
Процедура СнятьОтметки(Команда)
	
	ТабличнаяЧасть = ОпределитьТабличнуюЧасть();
	СнятьОтметкиНаСервере(ТабличнаяЧасть);
	
КонецПроцедуры   

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ОпределитьТабличнуюЧасть()
	
	ТекущаяСтраница = Элементы.ГруппаСчетаФактурыАванс.ТекущаяСтраница.Имя;
	Если ТекущаяСтраница = "ГруппаПопадающие" Тогда
		ТабличнаяЧасть = "ПопадающиеСчетаФактуры";
	Иначе
		ТабличнаяЧасть = "НепопадающиеСчетаФактуры";
	КонецЕсли;
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивСчетовФактурНаПечать(ТабличнаяЧастьИмя)
	
	МассивСчетовФактур = Новый Массив;
	ТабличнаяЧасть = Объект[ТабличнаяЧастьИмя];
	Для Каждого СтрТЧ из ТабличнаяЧасть Цикл
		Если СтрТЧ.Пометка Тогда
			МассивСчетовФактур.Добавить(СтрТЧ.СчетФактура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивСчетовФактур;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовФормы()

	Элементы.ГруппаНастройкиПечати.Видимость = ЭтотОбъект.ПечататьСразу;
	Элементы.ГруппаСчетаФактурыАванс.Видимость = Не ЭтотОбъект.ПечататьСразу;
	Элементы.ФормаЗаполнить.Доступность = Не ЭтотОбъект.ПечататьСразу;

КонецПроцедуры

#КонецОбласти

#Область ТекстЗапроса

// Получает текст запроса заполнения табличных частей.
// Используются тэги!
&НаСервере
Функция ТекстЗапроса()
	
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	        |	Регистр.ДокументОплаты КАК ДокументОплаты,
	        |	Регистр.Организация КАК Организация,
	        |	Регистр.Контрагент КАК Контрагент,
	        |	Регистр.НДСПриход КАК НДСПриход,
	        |	Регистр.НДСРасход КАК НДСРасход,
	        |	Регистр.НДСКонечныйОстаток КАК НДСКонечныйОстаток
	        |ПОМЕСТИТЬ вт_СчетФактурыОборот
	        |ИЗ
	        |	РегистрНакопления.НДСАвансыПолученные.ОстаткиИОбороты(&ДатаНачала, &ДатаКонца, Период, , ИСТИНА) КАК Регистр
	        |ГДЕ
	        |	(Регистр.НДСРасход <> 0
	        |			ИЛИ Регистр.НДСПриход <> 0)
	        |	#ОтборОрганизация#
	        |	#ОтборПодразделение#
	        |	#ОтборКонтрагент#
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	        |	Регистр.ДокументОплаты КАК ДокументОплаты,
	        |	Регистр.Контрагент КАК Контрагент,
	        |	Регистр.Организация КАК Организация,
	        |	Регистр.НДСОстаток КАК НДСНачальноеСальдо
	        |ПОМЕСТИТЬ вт_СчетаФактурыСНачальнымСальдо
	        |ИЗ
	        |	РегистрНакопления.НДСАвансыПолученные.Остатки(&ДатаНачала, ИСТИНА) КАК Регистр
	        |ГДЕ
	        |	Регистр.НДСОстаток <> 0
	        |	#ОтборОрганизация#
	        |	#ОтборПодразделение#
	        |	#ОтборКонтрагент#
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	ДокументОплаты
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	вт_СчетФактурыОборот.ДокументОплаты КАК ДокументОплаты,
	        |	вт_СчетФактурыОборот.Организация КАК Организация,
	        |	вт_СчетФактурыОборот.Контрагент КАК Контрагент,
	        |	0 КАК НДСНачальноеСальдо,
	        |	вт_СчетФактурыОборот.НДСПриход КАК НДСПриход,
	        |	вт_СчетФактурыОборот.НДСРасход КАК НДСРасход,
	        |	вт_СчетФактурыОборот.НДСКонечныйОстаток КАК НДСКонечныйОстаток
	        |ПОМЕСТИТЬ вт_СчетаФактуры
	        |ИЗ
	        |	вт_СчетФактурыОборот КАК вт_СчетФактурыОборот
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	вт_СчетаФактурыСНачальнымСальдо.ДокументОплаты,
	        |	вт_СчетаФактурыСНачальнымСальдо.Организация,
	        |	вт_СчетаФактурыСНачальнымСальдо.Контрагент,
	        |	вт_СчетаФактурыСНачальнымСальдо.НДСНачальноеСальдо,
	        |	0,
	        |	0,
	        |	0
	        |ИЗ
	        |	вт_СчетаФактурыСНачальнымСальдо КАК вт_СчетаФактурыСНачальнымСальдо
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	ДокументОплаты
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	СчетФактураВыданныйАванс.Ссылка КАК СчетФактура,
	        |	вт_СчетаФактуры.ДокументОплаты КАК ДокументОплаты,
	        |	вт_СчетаФактуры.Организация КАК Организация,
	        |	вт_СчетаФактуры.Контрагент КАК Контрагент,
	        |	СУММА(вт_СчетаФактуры.НДСНачальноеСальдо) КАК НДСНачальноеСальдо,
	        |	СУММА(вт_СчетаФактуры.НДСПриход) КАК НДСПриход,
	        |	СУММА(вт_СчетаФактуры.НДСРасход) КАК НДСРасход,
	        |	СУММА(вт_СчетаФактуры.НДСКонечныйОстаток) КАК НДСКонечныйОстаток
	        |ПОМЕСТИТЬ вт_СчетаФактурыУникальные
	        |ИЗ
	        |	вт_СчетаФактуры КАК вт_СчетаФактуры
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданныйАванс КАК СчетФактураВыданныйАванс
	        |		ПО вт_СчетаФактуры.ДокументОплаты = СчетФактураВыданныйАванс.ДокументОснование
	        |ГДЕ
	        |	СчетФактураВыданныйАванс.Проведен
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	вт_СчетаФактуры.ДокументОплаты,
	        |	вт_СчетаФактуры.Организация,
	        |	вт_СчетаФактуры.Контрагент,
	        |	СчетФактураВыданныйАванс.Ссылка
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	вт_СчетаФактурыУникальные.СчетФактура КАК СчетФактура,
	        |	вт_СчетаФактурыУникальные.Контрагент КАК Контрагент
	        |ИЗ
	        |	вт_СчетаФактурыУникальные КАК вт_СчетаФактурыУникальные
	        |ГДЕ
	        |	вт_СчетаФактурыУникальные.НДСРасход = 0
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	вт_СчетаФактурыУникальные.СчетФактура,
	        |	вт_СчетаФактурыУникальные.Контрагент
	        |ИЗ
	        |	вт_СчетаФактурыУникальные КАК вт_СчетаФактурыУникальные
	        |ГДЕ
	        |	вт_СчетаФактурыУникальные.НДСРасход <> 0
	        |	И вт_СчетаФактурыУникальные.НДСКонечныйОстаток <> 0
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	вт_СчетаФактурыУникальные.СчетФактура КАК СчетФактура,
	        |	вт_СчетаФактурыУникальные.Контрагент КАК Контрагент
	        |ИЗ
	        |	вт_СчетаФактурыУникальные КАК вт_СчетаФактурыУникальные
	        |ГДЕ
	        |	вт_СчетаФактурыУникальные.НДСРасход <> 0";
	
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ДобавитьОтборыВТекстЗапроса(ТекстЗапроса)
	
	Если ОтборОрганизация Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборОрганизация#", "	И Регистр.Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборОрганизация#","");
	КонецЕсли;
	
	Если ОтборПодразделение Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборПодразделение#", "	И Регистр.Подразделение = &Подразделение");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборПодразделение#", "");
	КонецЕсли;
	
	Если ОтборКонтрагент Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборКонтрагент#", "	И Регистр.Контрагент = &Контрагент");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ОтборКонтрагент#", "");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти                      

#Область Печать

&НаКлиенте
Процедура Печать(Команда)
	
	Если ЭтотОбъект.ПечататьСразу Тогда
		МассивСчетовФактур = ПолучитьДанныеДляПечатиСразу(ДобавитьОтборыВТекстЗапроса(ТекстЗапроса()));
	Иначе
		ТабличнаяЧасть = ОпределитьТабличнуюЧасть();
		МассивСчетовФактур = ПолучитьМассивСчетовФактурНаПечать(ТабличнаяЧасть);
	КонецЕсли;
	НапечататьМассивДокументов(МассивСчетовФактур);	

КонецПроцедуры 

&НаКлиенте
Процедура НапечататьМассивДокументов(МассивСчетовФактур)
	
	ПараметрыПечати = УправлениеПечатьюКлиент.ОписаниеПараметровПечати();
	ПараметрыПечати.Вставить("ПечатьВВалюте", Ложь);
	ПараметрыПечати.СразуНаПринтер =  Истина;
	ПараметрыПечати.ДополнитьКомплектВнешнимиПечатнымиФормами = Истина;
	ПервыйДокумент = Истина;
	ИмяПринтера = "";
	Для Каждого СчетФактура Из МассивСчетовФактур Цикл 
		МассивСчетовФактурНаПечать = Новый Массив;
		МассивСчетовФактурНаПечать.Добавить(СчетФактура);
		ВыполнитьКомандуПечатиНаПринтер("Обработка.ПечатьОбщихФорм", "СчетФактура", МассивСчетовФактурНаПечать, ПараметрыПечати, ПервыйДокумент, ИмяПринтера);
		ПервыйДокумент = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуПечатиНаПринтер(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати = Неопределено, ПервыйДокумент, ИмяПринтера)

	// Проверим количество объектов.
	Если МассивОбъектов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	// Сформируем табличные документы.
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПечатныеФормы = УправлениеПечатьюВызовСервера.СформироватьПечатныеФормыДляБыстройПечатиОбычноеПриложение(
			ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати);
	Если НЕ ПечатныеФормы.Отказ Тогда
		ОбъектыПечати = Новый СписокЗначений;
		Для Каждого ОбъектПечати Из ПечатныеФормы.ОбъектыПечати Цикл
			ОбъектыПечати.Добавить(ОбъектПечати.Значение, ОбъектПечати.Ключ);
		КонецЦикла;
		ПечатныеФормы.ОбъектыПечати = ОбъектыПечати;
	КонецЕсли;
#Иначе
	ПечатныеФормы = УправлениеПечатьюВызовСервера.СформироватьПечатныеФормыДляБыстройПечати(
			ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати);
#КонецЕсли
	
	Если ПечатныеФормы.Отказ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Нет прав для вывода печатной формы на принтер, обратитесь к администратору.';
														|en = 'Insufficient rights to print out the form. Please contact the administrator.'"));
		Возврат;
	КонецЕсли;
	
	// Распечатаем
	РаспечататьТабличныеДокументы(ПечатныеФормы.ТабличныеДокументы, ПечатныеФормы.ОбъектыПечати, Ложь,, ПервыйДокумент, ИмяПринтера);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспечататьТабличныеДокументы(ТабличныеДокументы, ОбъектыПечати, Знач ПечататьКомплектами = Неопределено, 
	Знач КоличествоКопийКомплектов = 1, ПервыйДокумент, ИмяПринтера)
	
	ПечататьКомплектами = ТабличныеДокументы.Количество() > 1;
	ПакетОтображаемыхДокументов = УправлениеПечатьюВызовСервера.ПакетДокументов(ТабличныеДокументы,
		ОбъектыПечати, ПечататьКомплектами, КоличествоКопийКомплектов);
	Если ПервыйДокумент Тогда
		ПакетОтображаемыхДокументов.Напечатать(РежимИспользованияДиалогаПечати.Использовать);
	Иначе 
		ПакетОтображаемыхДокументов.ИмяПринтера = ИмяПринтера;
		ПакетОтображаемыхДокументов.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
	КонецЕсли;	
	ИмяПринтера = ПакетОтображаемыхДокументов.ИмяПринтера;
	
КонецПроцедуры

#КонецОбласти
