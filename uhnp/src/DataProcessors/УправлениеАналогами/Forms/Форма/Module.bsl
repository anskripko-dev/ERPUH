
#Область СобытияФормы
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.КлассA = Истина;
	Объект.КлассB = Истина;
	Объект.КлассC = Истина;
	
	Если Параметры.Свойство("Отбор") И ТипЗнч(Параметры.Отбор) = Тип("Структура") Тогда   
		
		Если Параметры.Отбор.Свойство("ПериодЗакупки") Тогда
			ЭтотОбъект.ПериодЗакупки.ДатаНачала 	= Параметры.Отбор.ПериодЗакупки.ДатаНачала;
			ЭтотОбъект.ПериодЗакупки.ДатаОкончания 	= Параметры.Отбор.ПериодЗакупки.ДатаОкончания; 
			ЭтотОбъект.ПериодЗакупки.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
		КонецЕсли;  
		
		Параметры.Отбор.Свойство("ПериодСсылка", 	Объект.ПериодЗакупки);
		
		Параметры.Отбор.Свойство("Автор", 			Объект.Пользователь);
		
		Параметры.Отбор.Свойство("Субъекты223", 	ЭтотОбъект.Субъекты223ФЗ);
		Элементы.ПериодПотребностей.ТолькоПросмотр = Истина;    
		Элементы.ПериодЗакупки.ТолькоПросмотр = Истина; 
		Элементы.Пользователь.ТолькоПросмотр = Истина;    
		
		Если Параметры.Отбор.Свойство("РеквизитыОтбора") Тогда     
			Для Каждого РеквизитОтбора Из Параметры.Отбор.РеквизитыОтбора Цикл  
				СтрокаТаблицаОтбора = ЭтотОбъект.ТаблицаПараметровОтбора.Добавить();
				СтрокаТаблицаОтбора.ИмяРеквизита = РеквизитОтбора.Ключ;
				СтрокаТаблицаОтбора.ЗначениеОтбора = РеквизитОтбора.Значение.Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если Параметры.Свойство("Отбор") И ТипЗнч(Параметры.Отбор) = Тип("Структура") Тогда
		
		Если Параметры.Отбор.Свойство("Автор") Тогда
			Настройки["Объект.Пользователь"] = Параметры.Отбор.Автор;   
			Объект["Пользователь"] = Параметры.Отбор.Автор; 
		КонецЕсли;
		
		Если Параметры.Отбор.Свойство("ПериодЗакупки") Тогда
			Настройки["Объект.ПериодЗакупки"] = Параметры.Отбор.ПериодСсылка;
			Объект["ПериодЗакупки"] = Параметры.Отбор.ПериодСсылка;
		КонецЕсли;     
		
		Если Параметры.Отбор.Свойство("Субъекты223ФЗ") Тогда
			Настройки["Субъекты223ФЗ"] = Параметры.Отбор.Субъекты223ФЗ;
			ЭтотОбъект["Субъекты223ФЗ"] = Параметры.Отбор.Субъекты223ФЗ;
		КонецЕсли;  
		
	КонецЕсли;
	
	ЗаполнитьДеревоНаСервере(Объект.Пользователь, Объект.ПериодЗакупки); 
	
	ТолькоСАналогами = Истина;   
	
	ОтборТолькоСАналогами();
	
КонецПроцедуры

&НаСервере
Процедура ОтборТолькоСАналогами()
	
	Если ТолькоСАналогами Тогда
		Элементы.ТаблицаАналогов.ОтборСтрок = Новый ФиксированнаяСтруктура("ЕстьАналоги", Истина);   
	Иначе
		Элементы.ТаблицаАналогов.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("СформироватьПриОткрытии", 0.1, Истина);
	
КонецПроцедуры 

&НаКлиенте
Процедура СформироватьПриОткрытии() Экспорт

	Сформировать(Неопределено);
	
КонецПроцедуры


#КонецОбласти 

&НаКлиенте
Процедура ТаблицаАналоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ТаблицаАналоговАналогНоменклатура" Тогда
		ПроизвестиВыборАналога(ВыбраннаяСтрока);
		Сформировать(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДеревоНаСервере(Пользователь, ПериодЗакупки)
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Объект.ТаблицаАналогов.Очистить();
		Возврат неопределено;
	КонецЕсли;
	
	//Получаем схему из макета
	СхемаКомпоновкиДанных = Отчеты.ОтчетОПримененииАналогов.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//
	ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("ОценкаАналогов");  
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПеренестиПоляВыбораНаВерхнийУровень(Настройки, Настройки.Выбор.Элементы, неопределено);   
	УстановитьОбязательныеПоляПотребностей(Настройки.Выбор);
	
	// Параметры вывода
	Параметр = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("РасположениеИтогов"));
	Параметр.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
	Параметр.Использование = Истина;
	
	// Параметры данных
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Автор"));
	Параметр.Значение = Пользователь;
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодЗакупки")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Объект.ПериодЗакупки;
		Параметр.Использование = Истина;
	КонецЕсли; 
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИспользуетсяЦенообразование25")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Константа.ИспользуетсяЦенообразование25").Получить();
		Параметр.Использование = Истина;
	КонецЕсли;                           
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СтандартныйПериод")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение.ДатаНачала 	= ЭтотОбъект.ПериодЗакупки.ДатаНачала;
		Параметр.Значение.ДатаОкончания = ЭтотОбъект.ПериодЗакупки.ДатаОкончания;
		Параметр.Значение.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
		Параметр.Использование = Истина;
	КонецЕсли;     
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаНачала"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЭтотОбъект.ПериодЗакупки.ДатаНачала; 
		Параметр.Использование = Истина;	
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончания")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЭтотОбъект.ПериодЗакупки.ДатаОкончания;
		Параметр.Использование = Истина;
	КонецЕсли;  
	
	РеквизитыОтбора = СтруктураПараметровОтбора();    
	Для Каждого КлючИЗнчение Из РеквизитыОтбора Цикл
		Если СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти(КлючИЗнчение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;       
		Если ЗначениеЗаполнено(КлючИЗнчение.Значение.Значение) Тогда  
			ПолеОтбораСубъекты = Новый ПолеКомпоновкиДанных(КлючИЗнчение.Ключ);
			ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
			ЭлементОтбора.ЛевоеЗначение = ПолеОтбораСубъекты;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных[КлючИЗнчение.Значение.ВидСравнения];
			ЭлементОтбора.Использование = Истина; 
			ЭлементОтбора.ПравоеЗначение = КлючИЗнчение.Значение.Значение;
		КонецЕсли;
	КонецЦикла;  
	
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	Таблица = Новый ДеревоЗначений;     
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТЗ.УстановитьОбъект(Таблица);
	
	ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных); 
	
	ЭтотОбъект.ДеревоАналогов.ПолучитьЭлементы().Очистить();
	
	Для Каждого СтрокаДереваТаблицы Из Таблица.Строки Цикл  
		
		СтрокаКорень = ЭтотОбъект.ДеревоАналогов.ПолучитьЭлементы().Добавить();  
		ЗаполнитьЗначенияСвойств(СтрокаКорень, 	СтрокаДереваТаблицы);   
		СтрокаКорень.ABC = "";
		
		ЗаполнитьСтрокуДерева(СтрокаДереваТаблицы, СтрокаКорень);  
		СтрокаКорень.КоличествоПотребность = 0; 
		СтрокаКорень.АналогКоличество = 0;

		//
		Для Каждого ДетальнаяЗапись Из СтрокаДереваТаблицы.Строки Цикл 
			СтрокаДетальнаяЗапись = СтрокаКорень.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДетальнаяЗапись, ДетальнаяЗапись);
			ЗаполнитьСтрокуДерева(ДетальнаяЗапись, СтрокаДетальнаяЗапись);   
			
			Если Не ЭтотОбъект.Объект.КлассA Тогда
				Если СтрокаДетальнаяЗапись.ABC = "A" Тогда 
					СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись);
					Продолжить;
				КонецЕсли;	
			КонецЕсли;     
			Если Не ЭтотОбъект.Объект.КлассB Тогда
				Если СтрокаДетальнаяЗапись.ABC = "B" Тогда 
					СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись);
					Продолжить;
				КонецЕсли;	
			КонецЕсли;  
			Если Не ЭтотОбъект.Объект.КлассC Тогда
				Если СтрокаДетальнаяЗапись.ABC = "C" Тогда 
					СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись);
					Продолжить;
				КонецЕсли;	
			КонецЕсли; 
			
			Если Объект.СуммаНеМенее > 0 И СтрокаДетальнаяЗапись.СуммаПотребность < Объект.СуммаНеМенее Тогда
				СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись); 
				Продолжить;
			КонецЕсли;  
			
			Если ЭтотОбъект.ТолькоСАналогами Тогда
				Если Не СтрокаДетальнаяЗапись.ЕстьАналоги Тогда 
					СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись);
					Продолжить;
				КонецЕсли;
			КонецЕсли;  
			
			Если ЭтотОбъект.ТолькоСЭкономией Тогда
				Если СтрокаДетальнаяЗапись.Экономия <= 0  Тогда 
					СтрокаКорень.ПолучитьЭлементы().Удалить(СтрокаДетальнаяЗапись);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаДетальнаяЗапись.ЭтоКорень = Ложь;
			
			СтрокаКорень.СуммаПотребность 	= СтрокаКорень.СуммаПотребность + СтрокаДетальнаяЗапись.СуммаПотребность; 
			СтрокаКорень.КоличествоПотребность 	= СтрокаКорень.КоличествоПотребность + СтрокаДетальнаяЗапись.КоличествоПотребность; 
			СтрокаКорень.АналогКоличество 	= СтрокаКорень.АналогКоличество + СтрокаДетальнаяЗапись.АналогКоличество;  
			СтрокаКорень.АналогСумма 		= СтрокаКорень.АналогСумма + СтрокаДетальнаяЗапись.АналогСумма; 
			СтрокаКорень.Экономия 			= СтрокаКорень.Экономия + СтрокаДетальнаяЗапись.Экономия;
			СтрокаКорень.ЭтоКорень 			= Истина;

		КонецЦикла;  
		
		Если СтрокаКорень.ПолучитьЭлементы().Количество() = 0 Тогда
			ЭтотОбъект.ДеревоАналогов.ПолучитьЭлементы().Удалить(СтрокаКорень);
		КонецЕсли;
		 
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуДерева(Знач СтрокаДереваТаблицы, Знач Строка)
	
	Строка.КоличествоПотребность 	= СтрокаДереваТаблицы.КоличествоИсходное;  
	//Строка.Цена 					= СтрокаДереваТаблицы.ЦенаИсходная;
	Строка.ЦенаАналог 				= СтрокаДереваТаблицы.Цена;     
	
	//Строка.СуммаПотребность = Строка.КоличествоПотребность * Строка.Цена; 
	Строка.СуммаПотребность 		= Строка.СуммаПотребность;  
	Строка.Цена 					= ?(Строка.КоличествоПотребность = 0 , 0, Строка.СуммаПотребность/Строка.КоличествоПотребность);
	
	Если Строка.Коэффициент = 0 Тогда     
		Строка.АналогКоличество = 0;
	Иначе
		Строка.АналогКоличество = Окр(Строка.КоличествоПотребность * Строка.Коэффициент, 3);      
	КонецЕсли;   
	
	Строка.АналогСумма = Строка.АналогКоличество * Строка.ЦенаАналог;
	
	Если Строка.Цена <> 0 И Строка.ЦенаАналог <> 0 Тогда
		Строка.Экономия = Строка.СуммаПотребность - Строка.АналогСумма;
	Иначе
		Строка.Экономия = 0;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьКолонкиТаблицы(Знач Таблица, Знач СтрокаКолонок)
	
	Перем ИмяКолонки, ЧастиСтроки, ЧастиСтрокиИтог;
	
	ЧастиСтроки = СтрРазделить(СтрокаКолонок, ", ");        
	ЧастиСтрокиИтог = Новый Массив;      
	Для Каждого ИмяКолонки Из ЧастиСтроки Цикл 
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			ЧастиСтрокиИтог.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;  
	
	Возврат СтрСоединить(ЧастиСтрокиИтог, ", ");

КонецФункции

&НаСервере
Процедура ПеренестиПоляВыбораНаВерхнийУровень(Настройки, ВыборЭлементы, Родитель)
	
	//
	Для Каждого ЭлементВыбора Из ВыборЭлементы Цикл
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			ПеренестиПоляВыбораНаВерхнийУровень(Настройки, ЭлементВыбора.Элементы, ЭлементВыбора);
		ИначеЕсли ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных") И Родитель <> неопределено Тогда
			Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(Поле, ЭлементВыбора,,"Родитель")
		КонецЕсли;
	КонецЦикла;
	
	
	Если Родитель = неопределено Тогда
		
		Поз = 0;
		Пока Поз < ВыборЭлементы.Количество() Цикл
			ЭлементВыбора = ВыборЭлементы[Поз];
			Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда 
				
				ВыборЭлементы.Удалить(ЭлементВыбора);
				
			Иначе
				Поз = Поз + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
