&НаСервере
Функция СтруктураПараметровОтбора(Знач РеквизитыОтбора = "")  
	
	Если РеквизитыОтбора = "" Тогда    
		РеквизитыОтбора = ЭтотОбъект.ТаблицаПараметровОтбора.Выгрузить(, "ИмяРеквизита");  
		РеквизитыОтбора.Свернуть("ИмяРеквизита");
		Реквизиты = РеквизитыОтбора.ВыгрузитьКолонку("ИмяРеквизита");
		РеквизитыОтбора = СтрСоединить(Реквизиты, ",");
	КонецЕсли;      
	
	
	
	РеквизитыКоллекия = СтрРазделить(СтрЗаменить(РеквизитыОтбора, " ", ""), ",", Ложь);    
	Отборы = Новый Структура();
	Для Каждого ИмяРеквизита Из РеквизитыКоллекия Цикл
		СтрокиОтбора = ТаблицаПараметровОтбора.НайтиСтроки(Новый Структура("ИмяРеквизита", ИмяРеквизита));
		Если СтрокиОтбора.Количество() Тогда    
			Отборы.Вставить(ИмяРеквизита, Новый Структура("ВидСравнения, Значение", "ВСписке", Новый СписокЗначений));
			Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл   
				Отборы[ИмяРеквизита].Значение.Добавить(СтрокаОтбора.ЗначениеОтбора);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отборы;

КонецФункции

&НаКлиенте
Процедура ДеревоАналоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ДеревоАналоговАналогНоменклатура" Тогда
		ПроизвестиВыборАналогаДерево(ВыбраннаяСтрока);
		Сформировать(Неопределено);
	КонецЕсли;

КонецПроцедуры

