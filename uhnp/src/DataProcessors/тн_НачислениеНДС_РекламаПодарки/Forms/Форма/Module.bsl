
&НаСервере
Процедура ВыполнитьНаСервере(ДокументыНДС)

	Если ДокументыВнутреннегоПотребления.Количество() > 0 Тогда 
		
		ЗаписьКнигиПродаж = Документы.ЗаписьКнигиПродаж.СоздатьДокумент();
		ДокументыОснования = ДокументыВнутреннегоПотребления.Выгрузить().ВыгрузитьКолонку("Документ");
		
		// НАЧАЛО Белокопытова Анна 26.05.2022 Выполнение задач №000041397
		//ЗаписьКнигиПродаж.Заполнить(ДокументыОснования); 
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ДокументОснование", ДокументыОснования);
		ДанныеЗаполнения.Вставить("РасчетЦенПоСебестоимости", РасчетЦенПоСебестоимости); 
		ДанныеЗаполнения.Вставить("Период", Период.ДатаОкончания); 
		ДанныеЗаполнения.Вставить("Организация", Организация); 
		ЗаписьКнигиПродаж.Заполнить(ДанныеЗаполнения); 
		// КОНЕЦ  Белокопытова Анна 26.05.2022 Выполнение задач №000041397 
		
		// НАЧАЛО Редько Екатерина 03.12.2022 Выполнение задач №000043577
		//ЗаписьКнигиПродаж.Дата = ТекущаяДатаСеанса();
		ЗаписьКнигиПродаж.Дата = Период.ДатаОкончания;
        // КОНЕЦ  Редько Екатерина 03.12.2022 Выполнение задач №000043577
		
		ТекстКомментария = "Создан обработкой 'Начисление НДС (реклама, подарки)' %1";
		ТекстКомментария = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстКомментария, ТекущаяДатаСеанса());
		ЗаписьКнигиПродаж.Комментарий = ТекстКомментария;
		
		Попытка 
			ЗаписьКнигиПродаж.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьКнигиПродаж.Записать(РежимЗаписиДокумента.Запись);
			ТекстСообщения = НСтр("ru = 'Не удалось провести документ запись книги продаж, документ записан.
										|%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки()); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
		ДокументыНДС.ЗаписьКниги = ЗаписьКнигиПродаж.Ссылка;
		
		Если ЗаписьКнигиПродаж.Проведен Тогда  
			СчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
			// НАЧАЛО Редько Екатерина 03.12.2022 Выполнение задач №000043577
			//СчетФактура.Дата = ТекущаяДатаСеанса();
			СчетФактура.Дата = Период.ДатаОкончания;
	        // КОНЕЦ  Редько Екатерина 03.12.2022 Выполнение задач №000043577
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("ДокументОснование", ЗаписьКнигиПродаж.Ссылка);
			ДанныеЗаполнения.Вставить("Организация",       ЗаписьКнигиПродаж.Организация);
			ДанныеЗаполнения.Вставить("Контрагент",        ЗаписьКнигиПродаж.Контрагент);
			ДанныеЗаполнения.Вставить("Исправление",       Ложь);
			ДанныеЗаполнения.Вставить("Корректировочный",  Ложь); 
			
			СчетФактура.Заполнить(ДанныеЗаполнения);
			Попытка 
				СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьКнигиПродаж.Записать(РежимЗаписиДокумента.Запись);
				ТекстСообщения = НСтр("ru = 'Не удалось провести счет-фактуру, документ записан.
											|%1'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки()); 
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
			
			ДокументыНДС.СчетФактура = СчетФактура.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	// НАЧАЛО Редько Екатерина 03.12.2022 Выполнение задач №000043577 
	Элементы.ФормаВыполнить.Доступность = Ложь;
	Элементы.ФормаВыполнить.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
	// КОНЕЦ  Редько Екатерина 03.12.2022 Выполнение задач №000043577
	ДокументыНДС = Новый Структура;
	ДокументыНДС.Вставить("ЗаписьКниги");
	ДокументыНДС.Вставить("СчетФактура");
	
	ВыполнитьНаСервере(ДокументыНДС);
	
	Если ЗначениеЗаполнено(ДокументыНДС.ЗаписьКниги) Тогда 
		ПоказатьЗначение(,ДокументыНДС.ЗаписьКниги);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументыНДС.СчетФактура) Тогда 
		ПоказатьЗначение(,ДокументыНДС.СчетФактура);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаписьКнигиПродаж.тн_ДокументОснование КАК тн_ДокументОснование
	|ПОМЕСТИТЬ ОснованияКнигиПродаж
	|ИЗ
	|	Документ.ЗаписьКнигиПродаж КАК ЗаписьКнигиПродаж
	|ГДЕ
	|	ЗаписьКнигиПродаж.Проведен
	|	И ЗаписьКнигиПродаж.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ЗаписьКнигиПродаж.Организация = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаписьКнигиПродажЦенности.тн_ДокументОснование
	|ИЗ
	|	Документ.ЗаписьКнигиПродаж.Ценности КАК ЗаписьКнигиПродажЦенности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаписьКнигиПродаж КАК ЗаписьКнигиПродаж
	|		ПО ЗаписьКнигиПродажЦенности.Ссылка = ЗаписьКнигиПродаж.Ссылка
	|ГДЕ
	|	ЗаписьКнигиПродаж.Проведен
	|	И ЗаписьКнигиПродаж.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ЗаписьКнигиПродаж.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	// НАЧАЛО Борисенко Игорь 27.10.2022 Выполнение задач №000043127
	|	ВнутреннееПотребление.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВнутреннееПотребление КАК ВнутреннееПотребление
	|ГДЕ
	|	ВнутреннееПотребление.Проведен
	|	И ВнутреннееПотребление.Организация = &Организация
	|	И ВнутреннееПотребление.Склад В(&Склад)
	|	И ВнутреннееПотребление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВнутреннееПотребление.ХозяйственнаяОперация В(&ХозяйственнаяОперация)
	|	И НЕ ВнутреннееПотребление.Ссылка В
	|				(ВЫБРАТЬ
	|					ОснованияКнигиПродаж.тн_ДокументОснование КАК тн_ДокументОснование
	|				ИЗ
	|					ОснованияКнигиПродаж КАК ОснованияКнигиПродаж)
	|	И ВнутреннееПотребление.тн_ВидСписания В(&тн_ВидСписания)";
	// КОНЕЦ Борисенко Игорь 27.10.2022 Выполнение задач №000043127
	
	Если Склад.Количество() = 0 Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВнутреннееПотребление.Склад В(&Склад)", ""); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	
	МассивОпераций = Новый Массив;
	МассивОпераций.Добавить(Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", МассивОпераций);
	
	МассивВидовСписания = Новый Массив;
	Если ЗначениеЗаполнено(ВидСписания) Тогда 
		МассивВидовСписания.Добавить(ВидСписания);
	Иначе 
		МассивВидовСписания.Добавить(Перечисления.тн_ВидыСписанияРекламаПодарки.Подарки);
		МассивВидовСписания.Добавить(Перечисления.тн_ВидыСписанияРекламаПодарки.Реклама);
	КонецЕсли;
	Запрос.УстановитьПараметр("тн_ВидСписания", МассивВидовСписания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДокументыВнутреннегоПотребления.Очистить();
	Пока Выборка.Следующий() Цикл 
		НоваяСтрока = ДокументыВнутреннегоПотребления.Добавить();
		НоваяСтрока.Документ = Выборка.Ссылка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Организация) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите организацию.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите начало периода.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите конец периода.'"),,,,Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда 
		ЗаполнитьНаСервере();
	КонецЕсли;
	// НАЧАЛО Редько Екатерина 03.12.2022 Выполнение задач №000043577 
	Элементы.ФормаВыполнить.Доступность = Истина;
	Элементы.ФормаВыполнить.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	// КОНЕЦ  Редько Екатерина 03.12.2022 Выполнение задач №000043577
КонецПроцедуры
