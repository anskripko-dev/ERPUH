&НаСервере
Функция ПолучитьРегионПродаж(Страна)
	
	Если НЕ ЗначениеЗаполнено(Страна) Тогда
		ВызватьИсключение "Функция РегионПродаж(): не задан параметр Страна!";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегионыПродаж.Ссылка КАК Страна
	|ИЗ
	|	Справочник.тРегионыПродаж КАК РегионыПродаж
	|ГДЕ
	|	РегионыПродаж.Страна = &Страна";
	
	Если ВРег(Страна.Наименование) = "РАЗНЫЕ" Тогда
		// В этом случае найдем в ТЧ Товары первую заполненную Страну 
		СтранаИзТЧТовары = Неопределено;
		Для каждого Товар Из Товары Цикл
			Если ЗначениеЗаполнено(Товар.Страна) Тогда
				СтранаИзТЧТовары = Товар.Страна;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(СтранаИзТЧТовары) Тогда
			Возврат Справочники.РегионыПродаж.ПустаяСсылка();
		КонецЕсли;
		Запрос.УстановитьПараметр("Страна", СтранаИзТЧТовары);
	Иначе
		Запрос.УстановитьПараметр("Страна", Страна);	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.РегионыПродаж.ПустаяСсылка();
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Страна;

