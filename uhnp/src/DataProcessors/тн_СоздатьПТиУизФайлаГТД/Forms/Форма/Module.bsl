	Запрос.УстановитьПараметр("Наименование", Наименование);
//	Запрос.УстановитьПараметр("НомерГТД", НомерГТД);
	Запрос.УстановитьПараметр("Родитель", Группа);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли; 

	НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	НоменклатураОбъект.Наименование = Наименование;
	
	НоменклатураОбъект.НаименованиеПолное 	= НаименованиеПолное;
	//НоменклатураОбъект.ВестиУчетПоСериям 	= Истина;
	НоменклатураОбъект.СтавкаНДС 			= СтавкаНДС;
	НоменклатураОбъект.Родитель = Группа;
	НоменклатураОбъект.ВидНоменклатуры = Вид;
	НоменклатураОбъект.тн_БазоваяЕдиницаИзмерения = БазоваяЕдИзм;
	НоменклатураОбъект.ЕдиницаИзмерения = БазоваяЕдИзм;
	НоменклатураОбъект.ВестиУчетПоГТД = Истина;
	НоменклатураОбъект.СтранаПроисхождения = Страна;
//	НоменклатураОбъект.НомерГТД = НомерГТД;
	НоменклатураОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;	
	НовыйНоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор);
	НоменклатураОбъект.УстановитьСсылкуНового(НовыйНоменклатураСсылка);
	//НоменклатураОбъект.ЕдиницаХраненияОстатков = ПолучитьЕдиницуИзмерения(НовыйНоменклатураСсылка, БазоваяЕдИзм, Отказ);
	// НАЧАЛО Юдина Екатерина 29.01.2025 Выполнение задач №000052416
	НоменклатураОбъект.ГруппаФинансовогоУчета = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Вид, "ГруппаФинансовогоУчета");
	// КОНЕЦ Юдина Екатерина 29.01.2025 Выполнение задач №000052416 
	//НАЧАЛО Качикина 03.04.2025 Выполнение задач №000053285
	////НАЧАЛО Качикина 01.04.2025 Выполнение задач №000053247
	//НоменклатураОбъект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	////КОНЕЦ Качикина 01.04.2025 Выполнение задач №000053247  
	НоменклатураОбъект.ИспользованиеХарактеристик = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Вид, "ИспользованиеХарактеристик");
	//КОНЕЦ Качикина 03.04.2025 Выполнение задач №000053285
	Если Отказ Тогда
		Отказ = Истина;
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли; 
	
	Попытка
		НоменклатураОбъект.Записать(); 
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Не удалось создать новую номенклатуру ""%1"", по причине: ""%2""", 
		НоменклатураОбъект.Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	
	Если НЕ Отказ Тогда
		
		//Создадим записи в РС "Аналитика учета номенклатуры"
		
		Попытка
				
				НаборЗаписей 	= РегистрыСведений.АналитикаУчетаНоменклатуры.СоздатьНаборЗаписей();
				НоваяЗапись		= НаборЗаписей.Добавить();
				
				НоваяЗапись.Номенклатура	= НоменклатураОбъект.Ссылка;
				//НоваяЗапись.МестоХранения   = Договор;
				НаборЗаписей.Записать(Ложь);
				
		Исключение
				Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
			
	КонецЕсли; 
		
	Возврат НоменклатураОбъект.Ссылка;
		
	
