// Обновляет значение Реквизита в зависимости от результата поиска
//
// Параметры:
//  РезультатПоиска  - СправочникСсылка - ссылка на найденный элемент, если найден только один
//                   - Массив из СправочникСсылка - содержить ссылки на найденные элементы,
//                     если найдено более одного элемента                           
//  Реквизит         - СправочникСсылка - реквизит, поиск которого производился
//  ПолеРеквизита    - ПолеФормы - поле в которо отображается значение реквизита на форме
//
&НаКлиенте
Процедура ОбработатьРезультатПоискаРеквизита(РезультатПоиска, Реквизит, ПолеРеквизита)
	
	ПолеРеквизита.СписокВыбора.Очистить();
	НайденоЗначений = ?(ЗначениеЗаполнено(РезультатПоиска), РезультатПоиска.Количество(), 0);

	Если НайденоЗначений = 0  Тогда
		Реквизит = Неопределено;
	ИначеЕсли НайденоЗначений = 1  Тогда
		Реквизит = РезультатПоиска[0];
	Иначе
		Реквизит = Неопределено;
		Для каждого Значение Из РезультатПоиска Цикл
		 	ПолеРеквизита.СписокВыбора.Добавить(Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьСтатус(Реквизит, ПолеРеквизита, РеквизитСтатуса)

	// Определим Статус данных
	Если ЗначениеЗаполнено(Реквизит) Тогда
		РеквизитСтатуса = СтатусНайден;
	ИначеЕсли ПолеРеквизита.СписокВыбора.Количество() > 1 Тогда
	    РеквизитСтатуса = СтатусНайденоБолееОдного;
	Иначе
		РеквизитСтатуса = СтатусНеНайден;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКнопкиВыбора(ПолеРеквизита, Статус)

	НеНайденоИлиТолькоОдно = Статус < СтатусНайденоБолееОдного; 	
	ПолеРеквизита.РежимВыбораИзСписка = НЕ НеНайденоИлиТолькоОдно;
	ПолеРеквизита.КнопкаВыпадающегоСписка = НЕ НеНайденоИлиТолькоОдно;
	ПолеРеквизита.КнопкаВыбора = НеНайденоИлиТолькоОдно;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодсказкуВводаПоДаннымИзФайла(РеквизитИзФайла, ПолеРеквизита)

	Если НЕ ЗначениеЗаполнено(РеквизитИзФайла) Тогда
		ПолеРеквизита.ПодсказкаВвода = СтатусНеНайденоВФайле;
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов(Отказ)

	Отказ = Ложь;
	СозданиеДокументаОтменено = "Создание документа отменено: ";
	
	// Ревизиты необходимые для создания нового Контрагента
	Если Объект.СоздатьНовыйКонтрагент  Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НаименованиеКонтрагента) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Наименование контрагента (необходимо для создания нового Контрагента)!");
		КонецЕсли;

	КонецЕсли;
	
	// Реквизиты необходимые для создания нового Договора
	Если Объект.СоздатьНовыйДоговор Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Организация (необходимо для создания нового Договора контрагента)!");
		КонецЕсли;
		
		Если НЕ Объект.СоздатьНовыйКонтрагент И НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Контрагент (необходимо для создания нового Договора контрагента)!");
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Дата договора (необходимо для создания нового Договора контрагента)!");
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Объект.НомерДоговора) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Номер договора (необходимо для создания нового Договора контрагента)!");
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
			Отказ = Истина;
			Сообщить(СозданиеДокументаОтменено 
			+ "заполните поле Валюта (необходимо для создания нового Договора контрагента)!");
		КонецЕсли;
		
	КонецЕсли; 
	
	// Страну требуем заполнить всегда
	Если НЕ ЗначениеЗаполнено(Объект.Страна) Тогда
		Отказ = Истина;
		Сообщить(СозданиеДокументаОтменено + "заполните поле Страна!");
	КонецЕсли;
	
	// ТЧ Товары
	Для каждого Товар Из Товары Цикл
	
		Если Товар.СоздатьНовуюНоменклатуру Тогда
			
			Если НЕ ЗначениеЗаполнено(Товар.НаименованиеНоменклатуры) Тогда
				Отказ = Истина;
				Сообщить(СтрШаблон("%1 в строке %2 табличной части заполните поле Наименование номенклатуры!", 
				СозданиеДокументаОтменено, Товар.НомерСтроки));
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Товар.ГруппаНоменклатуры) Тогда
				Отказ = Истина;
				Сообщить(СтрШаблон("%1 в строке %2 табличной части заполните поле Группа номенклатуры!", 
				СозданиеДокументаОтменено, Товар.НомерСтроки));
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Товар.БазоваяЕдиницаИзмерения) Тогда
				Отказ = Истина;
				Сообщить(СтрШаблон("%1 в строке %2 табличной части заполните поле Базовая единица измерения (Ссылка)!", 
				СозданиеДокументаОтменено, Товар.НомерСтроки));
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Товар.Страна) Тогда
				Отказ = Истина;
				Сообщить(СтрШаблон("%1 в строке %2 табличной части заполните поле Страна (Ссылка)!", 
				СозданиеДокументаОтменено, Товар.НомерСтроки));
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры
 

// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ДАННЫМИ

&НаКлиенте
Процедура ЗагрузитьДанныеИзФайла()
	
	ОчиститьДанные();
		
	// Читаем данные из файла
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(Объект.ПутьКФайлу);
	ДанныеИзФайла = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	// Определяем тип данных BLOCK
	
	пБлокОбходимВЦикле = Истина;
	
	Если ТипЗнч(ДанныеИзФайла.BLOCK) = Тип("ОбъектXDTO") Тогда
		пБлокОбходимВЦикле = Ложь;
	КонецЕсли;
	
	// ИНИЦИАЛИЗИРУЕМ РЕКВИЗИТЫ ШАПКИ
	
	// ИНН и КПП
	ИННиКПП = СтрРазделить(ДанныеИзФайла.G_8_6, "/");
	ИННиКППКоличество = ИННиКПП.Количество();
	Объект.ИНН = ?(ИННиКППКоличество > 0, ИННиКПП[0], Неопределено);
	Объект.КПП = ?(ИННиКППКоличество > 1, ИННиКПП[1], Неопределено);
	
	// НаименованиеКонтрагента
	Объект.НаименованиеКонтрагента = ПервоеСлово(ДанныеИзФайла.G_2.NAME);
	
	// НомерДоговора и ДатаДоговора
	
	ПоискЗавершен = Ложь;
	
	Если пБлокОбходимВЦикле Тогда
		
		Для каждого BLOCK Из ДанныеИзФайла.BLOCK Цикл
			ЗаполонитьНомерИДатуДоговора(ПоискЗавершен, BLOCK); 
			Если ПоискЗавершен Тогда
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
		
	Иначе
				
		BLOCK = ДанныеИзФайла.BLOCK;
		ЗаполонитьНомерИДатуДоговора(ПоискЗавершен, BLOCK); 
		
	КонецЕсли; 	
	
	МассивКодыДт 	= ПолучитьМассивКодовДт();  	
	ПоискЗавершен 	= Ложь;
	
	Если пБлокОбходимВЦикле Тогда
		
		Для каждого BLOCK Из ДанныеИзФайла.BLOCK Цикл
			ЗаполнитьДатуВходящегоДокумента(ПоискЗавершен, МассивКодыДт, BLOCK);
			Если ПоискЗавершен Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		BLOCK = ДанныеИзФайла.BLOCK;
		ЗаполнитьДатуВходящегоДокумента(ПоискЗавершен, МассивКодыДт, BLOCK);
		
	КонецЕсли;
		
	// КодАльфа2
	Объект.КодАльфа2 = ?(Строка(ДанныеИзФайла.G_16_2) = "ОбъектXDTO", СтатусНеНайденоВФайле, ДанныеИзФайла.G_16_2);
	
	// КодГТД
	Объект.КодГТД = ДанныеИзФайла.REGNUM;
	
	// КодВалюты 
	Объект.КодВалюты = ?(Строка(ДанныеИзФайла.G_22_1) = "ОбъектXDTO", СтатусНеНайденоВФайле, ДанныеИзФайла.G_22_1);
	
	// Товары
	Товары.Очистить();
		
	Если пБлокОбходимВЦикле Тогда
		
		НомерСтроки = 0;
		
		Для каждого BLOCK Из ДанныеИзФайла.BLOCK Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Если Строка(BLOCK.TOVG) = "ОбъектXDTO" Тогда
				
				СоздатьСтрокуТовары(НомерСтроки, BLOCK.TOVG, BLOCK.G_34_1);
				
			ИначеЕсли Строка(BLOCK.TOVG) = "СписокXDTO" Тогда
				
				пОбщееКоличество 	= BLOCK.TOVG.Количество();
				пТекКоличество 		= 0;
				
				Для каждого ТекБлок Из BLOCK.TOVG Цикл
					
					пТекКоличество = пТекКоличество + 1;
					
					СоздатьСтрокуТовары(НомерСтроки, ТекБлок, BLOCK.G_34_1);
					
					Если НЕ пОбщееКоличество = пТекКоличество Тогда
						НомерСтроки = НомерСтроки + 1;	
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЕсли;
					
		КонецЦикла;
		
	Иначе
		
		НомерСтроки = 1;
		BLOCK 		= ДанныеИзФайла.BLOCK;
		СоздатьСтрокуТовары(НомерСтроки, BLOCK.TOVG, BLOCK.G_34_1);
		
	КонецЕсли;
			
	СтатусДанныеЗагружены = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполонитьНомерИДатуДоговора(ПоискЗавершен, BLOCK)
	
	Для каждого G44 Из BLOCK.G44 Цикл
		Если G44.G444 = "ДОГОВОР (КОНТРАКТ)" Тогда
			Объект.НомерДоговора = ?(Строка(G44.G442) = "ОбъектXDTO", Неопределено, G44.G442);
			Объект.ДатаДоговора = ДатаИзДанныхСтроки(G44.G443);
			ПоискЗавершен = Истина;
			Возврат;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры


// Производит поиск данных в информационной базе, которыми инициализирует реквизиты обработки:
// Шапки: 
// - Организация				на основании: ИНН и КПП;
// - Контрагент					на основании: НаименованиеКонтрагента;
// - Договор                    на основании: Контрагент, НомерДоговора, ДатаДоговора;
// - НомерГТД                   на основании: КодГТД, СтранаПроисхождения;
// Табличной части Товары:
// - Номенклатура               на основании: НаименованиеНоменклатуры, НомерГТД, СтранаПроисхождения, 
//                                            БазоваяЕдиницаИзмерения (только для создания);   
// - ВидНоменклатуры            на основании: Номенклатура, если Номенклатура не найдена, 
//                                            то "Запчасти к технологическом оборудованию";
// - ГруппаНоменклатуры         на основании: Номенклатура, если Номенклатура не найдена, то пустая ссылка;
// - БазоваяЕдиницаИзмерения    на основании: КодБазовойЕдиницыИзмерения;
// - НомерГТД                   на основании: КодГТД из шапки;
// - СерияНоменклатуры          на основании: Номенклатура, НомерГТД, СтранаПроисхождения, 
//                                            ДатаСоздания (только для создания);
// - СтранаПроисхождения        на основании: СтранаПроисхождения из шапки
// - Количество                 на основании: частного от Суммы и Цены
//
&НаКлиенте
Процедура ПоискДанныхШапкиВБазе(ИмяРеквизита = "Все")
	
	РезультатыПоискаШапка = Неопределено;
	ПоискДанныхШапкиВБазеНаСервере(ИмяРеквизита, РезультатыПоискаШапка);
	
	Для каждого РезультатПоиска Из РезультатыПоискаШапка Цикл
		ОбработатьРезультатПоискаРеквизита(
			РезультатПоиска.Данные, 
			Объект[РезультатПоиска.ИмяРеквизита],
			Элементы[РезультатПоиска.ИмяРеквизита]);
	КонецЦикла;
	
	Если ИмяРеквизита = "Все" Тогда
		ОбновитьИнтерфейсФормы();
	ИначеЕсли ИмяРеквизита = "ГруппКонтрагент" Тогда
	    ОбновитьИнтерфейсГруппы(ИмяРеквизита); 
	КонецЕсли; 
	
	Если ИмяРеквизита = "Все" ИЛИ ИмяРеквизита = "Контрагент" Тогда
		СинхронизироватьДоговорСВладельцемКонтрагентомНаСервере();
		ОбновитьИнтерфейсГруппыКонтрагент();
	КонецЕсли; 
				
КонецПроцедуры 

&НаСервере
Процедура СинхронизироватьДоговорСВладельцемКонтрагентомНаСервере()
	
	Если (ЗначениеЗаполнено(Объект.Договор) И НЕ ЗначениеЗаполнено(Объект.Контрагент)) 
		ИЛИ (ЗначениеЗаполнено(Объект.Договор) И ЗначениеЗаполнено(Объект.Контрагент) 
		И Объект.Контрагент <> Объект.Договор.Владелец) Тогда
	    Объект.Контрагент = Объект.Договор.Контрагент;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПоискДанныхШапкиВБазеНаСервере(ИмяРеквизита = "Все", РезультатыПоискаОтвет)
	
	РезультатыПоискаОтвет = Новый Массив;
	
	Если ИмяРеквизита = "Все" ИЛИ ИмяРеквизита = "Организация" Тогда
		РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("Организация",  
		ВыборкаДанныхИзБазы(ЗапросПоискОрганизация(Объект.ИНН, Объект.КПП))));
	КонецЕсли;
		
	Если ИмяРеквизита = "Все" ИЛИ ИмяРеквизита = "Контрагент" Тогда
		СтруктураКонтрагенты = СоздатьРезультатПоискаДанныхШапки("Контрагент",  
		ВыборкаДанныхИзБазы(ЗапросПоискКонтрагент(Объект.НаименованиеКонтрагента)));
		РезультатыПоискаОтвет.Добавить(СтруктураКонтрагенты);
		Если ЗначениеЗаполнено(СтруктураКонтрагенты) 
			И ЗначениеЗаполнено(СтруктураКонтрагенты.Данные) 
			И СтруктураКонтрагенты.Данные.Количество() = 1 Тогда
			РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("ГруппаКонтрагента",  
			ВыборкаДанныхИзБазы(ЗапросПоискГруппаКонтрагент(СтруктураКонтрагенты.Данные[0]))));
			РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("Договор",  
			ВыборкаДанныхИзБазы(ЗапросПоискДоговор(Объект.ДатаДоговора, Объект.НомерДоговора, 
			СтруктураКонтрагенты.Данные[0]))));
		КонецЕсли; 
	КонецЕсли;
	
	Если ИмяРеквизита = "ГруппаКонтрагента" Тогда
		РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("ГруппаКонтрагента",  
		ВыборкаДанныхИзБазы(ЗапросПоискГруппаКонтрагент(Объект.Контрагент))));
	КонецЕсли;
	
	Если ИмяРеквизита = "Договор" Тогда
		РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("Договор",  
		ВыборкаДанныхИзБазы(ЗапросПоискДоговор(Объект.ДатаДоговора, Объект.НомерДоговора, Объект.Контрагент))));
	КонецЕсли;
	
	Если ИмяРеквизита = "Все" ИЛИ ИмяРеквизита = "Валюта" Тогда
		РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("Валюта",  
		ВыборкаДанныхИзБазы(ЗапросПоискВалюта(Объект.КодВалюты))));
	КонецЕсли;

	Если ИмяРеквизита = "Все" ИЛИ ИмяРеквизита = "Страна" Тогда
		РазультатЗапросаПоискСтраны = ЗапросПоискСтрана(Объект.КодАльфа2);
		Если Объект.КодАльфа2 = "00" И РазультатЗапросаПоискСтраны.Пустой() Тогда
			СтранаОбъект = Справочники.СтраныМира.СоздатьЭлемент();
			СтранаОбъект.Наименование = "РАЗНЫЕ";
			СтранаОбъект.НаименованиеПолное = "Разные";
			СтранаОбъект.Код = "000";
			СтранаОбъект.КодАльфа2 = "00";
			СтранаОбъект.Записать();
			РазультатЗапросаПоискСтраны = ЗапросПоискСтрана(Объект.КодАльфа2);
		КонецЕсли; 
		РезультатыПоискаОтвет.Добавить(СоздатьРезультатПоискаДанныхШапки("Страна",  
		ВыборкаДанныхИзБазы(РазультатЗапросаПоискСтраны)));		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЗапросПоискОрганизация(ИНН, КПП)

	Если НЕ ЗначениеЗаполнено(ИНН) И НЕ ЗначениеЗаполнено(КПП) Тогда
		Возврат Неопределено; // Поиск не возможен, не заданы параметры
	КонецЕсли;
	
	Запрос = Новый Запрос(
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка	
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН И Организации.КПП = &КПП");
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организации.ИНН = &ИНН И", "");
	Иначе	
	    Запрос.УстановитьПараметр("ИНН", ИНН);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(КПП) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Организации.КПП = &КПП", "");
	Иначе	
	    Запрос.УстановитьПараметр("КПП", КПП);
	КонецЕсли; 
	
	Возврат Запрос.Выполнить();

КонецФункции

&НаСервереБезКонтекста
Функция ЗапросПоискКонтрагент(НаименованиеКонтрагента)
	
	Если НЕ ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		Возврат Неопределено; // Поиск не возможен, не заданы параметры
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование ПОДОБНО &Наименование");
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеКонтрагента + "%");
	
	Возврат Запрос.Выполнить();

КонецФункции 

&НаСервереБезКонтекста
Функция ЗапросПоискГруппаКонтрагент(Контрагент)
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено; // Поиск не возможен, не заданы параметры
	КонецЕсли;

	Запрос = Новый Запрос(
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.ГруппаКонтрагента КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент");
	
