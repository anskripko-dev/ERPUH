		Выборка.Следующий();
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	// Номер в базе не сущестует, создадим новый	
	НомерОбъект = Справочники.НомераГТД.СоздатьЭлемент();
	НомерОбъект.Код = СокрЛП(КодГТД);
	НомерОбъект.СтранаПроисхождения = Страна;
	
	Попытка
		НомерОбъект.Записать();
	    Возврат НомерОбъект.Ссылка;
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Не удалось создать новый номер ГТД по коду ""%1"", по причине: ""%2""", 
		СокрЛП(КодГТД), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

