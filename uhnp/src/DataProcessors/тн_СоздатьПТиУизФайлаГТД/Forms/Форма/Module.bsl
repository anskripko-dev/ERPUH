КонецФункции 

&НаСервереБезКонтекста
Функция ЗапросПоискДоговор(Дата, Номер, Контрагент)
	
	Если НЕ ЗначениеЗаполнено(Дата) И НЕ ЗначениеЗаполнено(Номер) И НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено; // Поиск не возможен, не заданы параметры
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	");

	ПервывыйПараметрУжеВставлен = Ложь;
	
	Если ЗначениеЗаполнено(Дата) Тогда
	    Запрос.Текст = Запрос.Текст + "ДоговорыКонтрагентов.Дата = &Дата";
		ПервывыйПараметрУжеВставлен = Истина;
	    Запрос.УстановитьПараметр("Дата", Дата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номер) Тогда
		Если ПервывыйПараметрУжеВставлен Тогда
			Запрос.Текст = Запрос.Текст + " И ";
		КонецЕсли;
	    Запрос.Текст = Запрос.Текст + "ДоговорыКонтрагентов.Номер ПОДОБНО &Номер";
		ПервывыйПараметрУжеВставлен = Истина;
	    Запрос.УстановитьПараметр("Номер", Номер + "%");
	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если ПервывыйПараметрУжеВставлен Тогда
			Запрос.Текст = Запрос.Текст + " И ";
		КонецЕсли;
	    Запрос.Текст = Запрос.Текст + "ДоговорыКонтрагентов.Контрагент = &КонтрагентВладелец";
		ПервывыйПараметрУжеВставлен = Истина;
	    Запрос.УстановитьПараметр("КонтрагентВладелец", Контрагент);
	КонецЕсли;
	
	Возврат Запрос.Выполнить();

КонецФункции

