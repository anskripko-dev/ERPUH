	|	И СерииНоменклатуры.СтранаПроисхождения = &СтранаПроисхождения";

	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("НомерГТД", НомерГТД);
	Запрос.УстановитьПараметр("СтранаПроисхождения", Страна);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли; 

	СерияОбъект = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	СерияОбъект.Наименование = СтрШаблон("%1, %2", СокрЛП(НомерГТД.Код), Страна);
	СерияОбъект.Владелец = Номенклатура;
	СерияОбъект.НомерГТД = НомерГТД;
	СерияОбъект.СтранаПроисхождения = Страна;
	
	Попытка
		СерияОбъект.Записать();
		Возврат СерияОбъект.Ссылка;
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Не удалось создать новую Серию ""%1"" для номенклатуры ""%2"", по причине: ""%3""", 
		СерияОбъект.НомерГТД, Номенклатура.Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецФункции 

// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция СловоДоПервойТочки(СтрокаДанных)	
	Возврат СловоДоСимвола(СтрокаДанных, ".");
КонецФункции 

&НаКлиенте
Функция ПервоеСлово(СтрокаДанных)
	
	СимволыРазделители = Новый Массив;
	СимволыРазделители.Добавить(" ");
	СимволыРазделители.Добавить(".");
	СимволыРазделители.Добавить("-");
	СимволыРазделители.Добавить("/");
	СимволыРазделители.Добавить("\");
	СимволыРазделители.Добавить("_");
	СимволыРазделители.Добавить("*");
	СимволыРазделители.Добавить("|");
	СимволыРазделители.Добавить(Символы.ПС);
	СимволыРазделители.Добавить(Символы.ПФ);
	СимволыРазделители.Добавить(Символы.Таб);
	СимволыРазделители.Добавить(Символы.ВК);
	СимволыРазделители.Добавить(Символы.НПП);
	СимволыРазделители.Добавить(Символы.ПФ);
	
	ПервоеСлово = Неопределено;
	
	Для каждого СимволРазделитель Из СимволыРазделители Цикл
		Слово = СловоДоСимвола(СтрокаДанных, СимволРазделитель);
		Если ПервоеСлово = Неопределено ИЛИ СтрДлина(ПервоеСлово) > СтрДлина(Слово) Тогда
			ПервоеСлово = Слово;
		КонецЕсли;		
	КонецЦикла; 
	
	Возврат ПервоеСлово;
	
КонецФункции 

// В строке данных находит слово до заданного символа
//
// Параметры:
//  СтрокаДанных  - Строка - Строка данных для поиска
//  Символ        - Строка - Символ до которого необходимо производить поиск
//
// Возвращаемое значение:
//   Строка   - возвращает слово до первого заднного символа,
//			    если символ отсутствует, то всю строку данных
//
&НаКлиенте
Функция СловоДоСимвола(СтрокаДанных, Символ)
	
	ПозицияСмвола = СтрНайти(СтрокаДанных, Символ);
	
	Если ПозицияСмвола = 0  Тогда
	   	Возврат СтрокаДанных;
	Иначе	
		Возврат Лев(СтрокаДанных, ПозицияСмвола - 1);	
	КонецЕсли; 
	
КонецФункции 

// Возвращает Дату на основании строки формата ГГГГ-ММ-ДД
//
// Параметры:
//  ДатаСтрокой  - Строка - строковое представление даты в формате ГГГГ-ММ-ДД
//
// Возвращаемое значение:
//   Дата 			- в случае успехк
//	 Неопределено 	- если есть ошибки
//
&НаКлиенте
Функция ДатаИзДанныхСтроки(ДатаСтрокой)
	
	Попытка
		ДатаРезультат = Дата(СтрЗаменить(ДатаСтрокой, "-", ""));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ДатаРезультат;
	
КонецФункции

&НаСервере
//
Функция ПолучитьМассивКодовДт()
	
	МассивКодыДт	= Новый Массив();
	МакетКодыДт 	= Обработки.тн_СоздатьПТиУизФайлаГТД.ПолучитьМакет("КодыДТ");  
	Стр 			= 2;
	
	Пока Истина Цикл
		
		Адрес		= "R" + Формат(Стр,"ЧГ=") + "C1";
		Значение	= МакетКодыДт.Область(Адрес).Текст;
		
		Если ПустаяСтрока(Значение) Тогда
			Прервать;
		КонецЕсли; 
		
		МассивКодыДт.Добавить(Значение);
		Стр = Стр + 1;
		
	КонецЦикла;
	
	Возврат МассивКодыДт;
	
КонецФункции //ПолучитьМассивКодовДт()

&НаКлиенте
//
Процедура СоздатьСтрокуТовары(НомерСтроки, TOVG, G_34_1)
				
	Товар = Товары.Добавить();
	Товар.НомерСтроки = НомерСтроки;
	
	НаименованиеИзФайла = ?(Строка(TOVG.G31_1) = "ОбъектXDTO", СтатусНеНайденоВФайле, TOVG.G31_1);
	
	Товар.НаименованиеНоменклатуры			= ПолучитьНаименованиеНоменклатуры(НаименованиеИзФайла);
	Товар.НаименованиеНоменклатурыПолное 	= НаименованиеИзФайла;
	
	Товар.БазоваяЕдИзмИзФайла = Новый Структура("Ссылка, Код", Неопределено, 
	?(Строка(TOVG.CODE_EDI) = "ОбъектXDTO", СтатусНеНайденоВФайле, TOVG.CODE_EDI));
	
	Товар.КодАльфа2 = ?(Строка(G_34_1) = "ОбъектXDTO", СтатусНеНайденоВФайле, G_34_1);
	Товар.Страна = Объект.Страна;
	Элементы.ТоварыКодАльфа2.Видимость = (Объект.КодАльфа2 = "00");	
	
	Товар.Количество = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(
	?(Строка(TOVG.KOLVO) = "ОбъектXDTO", Неопределено, TOVG.KOLVO));
	Товар.Сумма = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(
	?(Строка(TOVG.G31_42) = "ОбъектXDTO", Неопределено, TOVG.G31_42));		
	
КонецПроцедуры //СоздатьСтрокуТовары()

&НаКлиенте
//
Функция ПолучитьНаименованиеНоменклатуры(НаименованиеИзФайла)
	
	//Определим какой символ встречается раньше, такое наименование и будем использовать для номенклатуры
		
	ПозицияЗнакаБольше 	= СтрНайти(НаименованиеИзФайла, ">");
	ПозицияТочки		= СтрНайти(НаименованиеИзФайла, ".");
	
	Если ПозицияЗнакаБольше > 0 И ПозицияТочки > 0 Тогда
		
		Если ПозицияЗнакаБольше > ПозицияТочки Тогда
			пНаименованиеНоменклатуры 	= СловоДоПервойТочки(НаименованиеИзФайла);
		Иначе
			пНаименованиеНоменклатуры 	= СловоДоСимвола(НаименованиеИзФайла, ">");		
		КонецЕсли;
		
	ИначеЕсли ПозицияЗнакаБольше = 0 И ПозицияТочки > 0 Тогда 
		пНаименованиеНоменклатуры 	= СловоДоПервойТочки(НаименованиеИзФайла);
	Иначе
		пНаименованиеНоменклатуры 	= СловоДоСимвола(НаименованиеИзФайла, ">");
	КонецЕсли; 
	
	Возврат пНаименованиеНоменклатуры;
	
КонецФункции //ПолучитьНаименованиеНоменклатуры()

&НаКлиенте
//
Процедура ЗаполнитьДатуВходящегоДокумента(ПоискЗавершен, МассивКодыДт, BLOCK)
	
	Для каждого G44 Из BLOCK.G44 Цикл	
		Если МассивКодыДт.Найти(G44.G441) <> Неопределено Тогда
			Объект.ДатаВходящего 	= ДатаИзДанныхСтроки(G44.G443);
			ПоискЗавершен 			= Истина;
			Возврат;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьДатуВходящегоДокумента()

