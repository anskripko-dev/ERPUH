&НаКлиенте
Процедура УстановитьДанныеБазовойЕдИзм(ТекущиеДанные, ДанныеНоменклатуры)
	
	Если ТекущиеДанные.СтатусНоменклатуры = СтатусНайден Тогда
		ТекущиеДанные.БазоваяЕдиницаИзмерения = ДанныеНоменклатуры.БазоваяЕдиницаИзмерения;
		ТекущиеДанные.КодБазовойЕдиницыИзмерения = ДанныеНоменклатуры.БазоваяЕдиницаИзмеренияКод;
	Иначе
		ТекущиеДанные.БазоваяЕдиницаИзмерения = ТекущиеДанные.БазоваяЕдИзмИзФайла.Ссылка;
		ТекущиеДанные.КодБазовойЕдиницыИзмерения = ТекущиеДанные.БазоваяЕдИзмИзФайла.Код;	
	КонецЕсли; 

КонецПроцедуры  

&НаСервере
Процедура УстановитьСтраныВТЧТовары(НовоеЗначение = Неопределено, ЗаполнитьВыбранным = Ложь)
	
	Если НовоеЗначение = Неопределено Тогда
		НовоеЗначение = Справочники.СтраныМира.ПустаяСсылка()
	КонецЕсли;
	Для каждого Товар Из Товары Цикл
		Если Не ЗаполнитьВыбранным Тогда			
			Если Объект.Страна.Наименование = "РАЗНЫЕ" Тогда
				НайденныеСтраны = ВыборкаДанныхИзБазы(ЗапросПоискСтрана(Товар.КодАльфа2));
				Если ЗначениеЗаполнено(НайденныеСтраны) Тогда
					Товар.Страна = НайденныеСтраны[0];
				Иначе
					Товар.Страна = Справочники.СтраныМира.ПустаяСсылка();
				КонецЕсли; 
			Иначе
				Товар.Страна = Объект.Страна;
				
			КонецЕсли;
		Иначе Товар.Страна = НовоеЗначение;
		КонецЕсли;	
	КонецЦикла;		
КонецПроцедуры 

&НаСервере
Функция ЗаполнитьДокументНаСервере(ДокументОтвет, ДанныеФормы, Отказ)

	Отказ = Ложь;
	ДокументОбъект = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	ДокументОбъект.Организация = Объект.Организация;
	
	НачатьТранзакцию(); // Начало создания новых элементов 
	
	Если Объект.СоздатьНовыйКонтрагент Тогда
		ДокументОбъект.Контрагент = ПолучитьКонтрагента(Объект.НаименованиеКонтрагента, Объект.ГруппаКонтрагента, Объект.Страна, Отказ);
	Иначе	
		ДокументОбъект.Контрагент = Объект.Контрагент;
	КонецЕсли;
	
	Если Объект.СоздатьНовыйДоговор Тогда
		ДокументОбъект.Договор = ПолучитьДоговорКонтрагента(
		ДокументОбъект.Контрагент, Объект.ДатаДоговора, Объект.НомерДоговора, Объект.Валюта, 
		Объект.Организация, Отказ);
	Иначе
		ДокументОбъект.Договор = Объект.Договор;
	КонецЕсли; 
	ДокументОбъект.ВалютаВзаиморасчетов = ДокументОбъект.ВалютаВзаиморасчетов;
	
	ДокументОбъект.Партнер = Справочники.Партнеры.НайтиПоНаименованию(ДокументОбъект.Контрагент.Наименование); 
	
	НомерГТД = НовыйНомерГТД(Объект.КодГТД, Объект.Страна, Отказ);

	Для каждого Товар Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(Товар.Номенклатура) И НЕ Товар.СоздатьНовуюНоменклатуру Тогда
		 	Продолжить;
		КонецЕсли;
		
		ДокТовар = ДокументОбъект.Товары.Добавить();
		
		Если ЗначениеЗаполнено(Объект.Страна) И ВРег(Объект.Страна.Наименование) = "РАЗНЫЕ" Тогда
			Страна = Товар.Страна;
		Иначе
			Страна = Объект.Страна;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Страна) Тогда  
			//ДокТовар.ВедетсяУчетПоГТД = Истина; 
			ДокТовар.НомерГТД = НомерГТД; 
			ДокТовар.СтранаПроисхождения223ФЗ = Страна;
		КонецЕсли; 
		
		Если Товар.СоздатьНовуюНоменклатуру Тогда
			
			ДокТовар.Номенклатура = ПолучитьНоменклатуру(Товар.НаименованиеНоменклатуры, Товар.НаименованиеНоменклатурыПолное, Товар.ГруппаНоменклатуры, 
			Товар.ВидНоменклатуры, Товар.БазоваяЕдиницаИзмерения, ДокументОбъект.Договор, Товар.СтавкаНДС, Страна, ДокТовар.НомерГТД, Отказ);
		
		Иначе
			ДокТовар.Номенклатура = Товар.Номенклатура;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ДокТовар.Номенклатура) Тогда
			Продолжить;
		КонецЕсли; 
		
		ВариантПриемкиТоваровДоговор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Договор, "ВариантПриемкиТоваров");
		ВариантПриемкиТоваровСоглашение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Соглашение, "ВариантПриемкиТоваров");
		
		ДокументОбъект.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(Неопределено, ДокументОбъект.Договор);
		ДокТовар.Количество = Товар.Количество;
		ДокТовар.КоличествоУпаковок = Товар.Количество;
		ДокТовар.Цена = ?(ДокТовар.Количество <> 0, Товар.Сумма / ДокТовар.Количество, 0);
		ДокТовар.Сумма = Товар.Сумма;
		
		ДокТовар.СтавкаНДС = ?(ЗначениеЗаполнено(ДокТовар.Номенклатура.СтавкаНДС), ДокТовар.Номенклатура.СтавкаНДС, Справочники.СтавкиНДС.БезНДС);
					
	КонецЦикла;
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	Иначе
		ЗафиксироватьТранзакцию(); 	
	КонецЕсли; // Окончание создания новых элементов
		
	ДокументОбъект.ДатаВходящегоДокумента = Объект.ДатаВходящего;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту; 
	ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС; 
	ДокументОбъект.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокументОбъект.Комментарий = "ГТД " + Строка(НомерГТД);
	ДокументОбъект.тн_ОтветственныйСотрудник = Пользователи.ТекущийПользователь().ФизическоеЛицо;
	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
		ДокументОбъект.Валюта =ДокументОбъект.Договор.ВалютаВзаиморасчетов;
        ДокументОбъект.ВалютаВзаиморасчетов = ДокументОбъект.Договор.ВалютаВзаиморасчетов;
	Иначе		
		ДокументОбъект.Валюта = Объект.Валюта;
		ДокументОбъект.ВалютаВзаиморасчетов = ДокументОбъект.Договор.ВалютаВзаиморасчетов;
	КонецЕсли;

	Если ДокументОтвет <> Неопределено Тогда
		ДокументОтвет = ДокументОбъект;
	КонецЕсли;
	
	Если Объект.СоздатьНовыйКонтрагент Тогда
		Объект.СоздатьНовыйКонтрагент = Ложь;
		Объект.Контрагент = ДокументОбъект.Контрагент;
	КонецЕсли;
	
	Если Объект.СоздатьНовыйДоговор Тогда
		Объект.СоздатьНовыйДоговор = Ложь;
		Объект.Договор = ДокументОбъект.Договор;
	КонецЕсли; 
	
	//НАЧАЛО Качикина 16.12.2024 Выполнение задач №000052038
	ДокументОбъект.ГруппаФинансовогоУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Договор, "ГруппаФинансовогоУчета"); 
	//КОНЕЦ Качикина 16.12.2024 Выполнение задач №000052038
	
	Возврат ДокументОбъект.Ссылка;	
КонецФункции

Функция ЗаполнитьПараметрыЗагрузки()

	Отказ = Ложь;  
	
	ПараметрыЗагрузки = Новый Структура();
	ПараметрыЗагрузки.Вставить("ЗагрузкаПоГТД",    "Истина");
	ПараметрыЗагрузки.Вставить("Организация",     Объект.Организация);
	
	НачатьТранзакцию(); // Начало создания новых элементов 
	
	Если Объект.СоздатьНовыйКонтрагент Тогда
		Контрагент = ПолучитьКонтрагента(Объект.НаименованиеКонтрагента, Объект.ГруппаКонтрагента, Объект.Страна, Отказ);
	Иначе	
		Контрагент = Объект.Контрагент;
	КонецЕсли;

	ПараметрыЗагрузки.Вставить("Контрагент",   Контрагент);

	Если Объект.СоздатьНовыйДоговор Тогда
		Договор = ПолучитьДоговорКонтрагента(
		Контрагент, Объект.ДатаДоговора, Объект.НомерДоговора, Объект.Валюта, 
		Объект.Организация, Отказ);
	Иначе
		Договор = Объект.Договор;
	КонецЕсли;
	
	ПараметрыЗагрузки.Вставить("Договор",    Договор);
    ПараметрыЗагрузки.Вставить("Партнер",    Справочники.Партнеры.НайтиПоНаименованию(Контрагент.Наименование));
   	НомерГТД = НовыйНомерГТД(Объект.КодГТД, Объект.Страна, Отказ);
	
	ЗаполняемаяТЧ = Товары.Выгрузить();
	ЗаполняемаяТЧ.Очистить();
	
	Для каждого Товар Из Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(Товар.Номенклатура) И НЕ Товар.СоздатьНовуюНоменклатуру Тогда
		 	Продолжить;
		КонецЕсли;
		
		ДокТовар = ЗаполняемаяТЧ.Добавить();
		
		Если ЗначениеЗаполнено(Объект.Страна) И ВРег(Объект.Страна.Наименование) = "РАЗНЫЕ" Тогда
			Страна = Товар.Страна;
		Иначе
			Страна = Объект.Страна;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Страна) Тогда  
			ДокТовар.НомерГТД = НомерГТД; 
		КонецЕсли; 
		
		Если Товар.СоздатьНовуюНоменклатуру Тогда
			
			ДокТовар.Номенклатура = ПолучитьНоменклатуру(Товар.НаименованиеНоменклатуры, Товар.НаименованиеНоменклатурыПолное, Товар.ГруппаНоменклатуры, 
			Товар.ВидНоменклатуры, Товар.БазоваяЕдиницаИзмерения, Договор, Товар.СтавкаНДС, Страна, НомерГТД, Отказ);		
		Иначе
			ДокТовар.Номенклатура = Товар.Номенклатура;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ДокТовар.Номенклатура) Тогда
			Продолжить;
		КонецЕсли; 
		
		ДокТовар.БазоваяЕдиницаИзмерения = Товар.БазоваяЕдиницаИзмерения;
		ДокТовар.Количество = Товар.Количество;
		ДокТовар.Сумма = Товар.Сумма;
		
		ДокТовар.СтавкаНДС = ?(ЗначениеЗаполнено(ДокТовар.Номенклатура.СтавкаНДС), ДокТовар.Номенклатура.СтавкаНДС, Справочники.СтавкиНДС.БезНДС);
					
	КонецЦикла;
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	Иначе
		ЗафиксироватьТранзакцию(); 	
	КонецЕсли; // Окончание создания новых элементов
	
	АдресВХ = ПоместитьВоВременноеХранилище(ЗаполняемаяТЧ, ЭтаФорма.УникальныйИдентификатор);
	ПараметрыЗагрузки.Вставить("АдресВХ",    АдресВХ);	
	ПараметрыЗагрузки.Вставить("ДатаВходящегоДокумента",    Объект.ДатаВходящего);	
	ПараметрыЗагрузки.Вставить("ХозяйственнаяОперация",    Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту);
	ПараметрыЗагрузки.Вставить("НалогообложениеНДС",    Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС);
	ПараметрыЗагрузки.Вставить("ЗакупкаПодДеятельность",    Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	ПараметрыЗагрузки.Вставить("Комментарий",    "ГТД " + Строка(НомерГТД));
	ПараметрыЗагрузки.Вставить("тн_ОтветственныйСотрудник",    Пользователи.ТекущийПользователь().ФизическоеЛицо); 
	ПараметрыЗагрузки.Вставить("ВариантПриемкиТоваров",    ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(Неопределено, Договор));
    //НАЧАЛО Качикина 16.12.2024 Выполнение задач №000052038 
	ПараметрыЗагрузки.Вставить("ГруппаФинансовогоУчета",    ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ГруппаФинансовогоУчета")); 
	//КОНЕЦ Качикина 16.12.2024 Выполнение задач №000052038
 
	Если ЗначениеЗаполнено(Договор) Тогда
		Валюта =Договор.ВалютаВзаиморасчетов;
        ВалютаВзаиморасчетов = Договор.ВалютаВзаиморасчетов;
	Иначе		
		Валюта = Объект.Валюта;
		ВалютаВзаиморасчетов = Договор.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ПараметрыЗагрузки.Вставить("Валюта",    Валюта); 
    ПараметрыЗагрузки.Вставить("ВалютаВзаиморасчетов",    ВалютаВзаиморасчетов);   
	
	Если Объект.СоздатьНовыйКонтрагент Тогда
		Объект.СоздатьНовыйКонтрагент = Ложь;
		Объект.Контрагент = Контрагент;
	КонецЕсли;
	
	Если Объект.СоздатьНовыйДоговор Тогда
		Объект.СоздатьНовыйДоговор = Ложь;
		Объект.Договор = Договор;
	КонецЕсли; 
	
	Возврат ПараметрыЗагрузки;
	
КонецФункции


&НаСервере
Функция ПолучитьКонтрагента(Наименование, ГруппаКонтрагента, Страна, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование 
	|   И Контрагенты.ГруппаКонтрагента = &ГруппаКонтрагента
	|	И Контрагенты.СтранаРегистрации = &Страна";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Страна", Страна);
	Запрос.УстановитьПараметр("ГруппаКонтрагента", ГруппаКонтрагента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование = Наименование;
	КонтрагентОбъект.НаименованиеПолное = Наименование;
	КонтрагентОбъект.СтранаРегистрации = Страна;
	КонтрагентОбъект.тн_Принадлежность = Справочники.тн_СтруктураКомпании.НайтиПоНаименованию("Сторонние контрагенты");
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//КонтрагентОбъект.тн_ДатаАктуализации = ТекущаяДата();       
	КонтрагентОбъект.тн_ДатаАктуализации = ТекущаяДатаСервера();      
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ГруппаКонтрагентовПоУмолчанию = Справочники.ГруппыКонтрагентов.НайтиПоНаименованию("Третьи стороны"); 
	Если Объект.ГруппаКонтрагента = Справочники.ГруппыКонтрагентов.ПустаяСсылка() Тогда
		КонтрагентОбъект.ГруппаКонтрагента = ?(ГруппаКонтрагентовПоУмолчанию = Неопределено, Справочники.ГруппыКонтрагентов.ПустаяСсылка(), ГруппаКонтрагентовПоУмолчанию);
	Иначе КонтрагентОбъект.ГруппаКонтрагента = Объект.ГруппаКонтрагента;	
	КонецЕсли;		
	Попытка
		КонтрагентОбъект.Записать();
	    Возврат КонтрагентОбъект.Ссылка;
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Не удалось создать нового контрагента ""%1"", по причине: ""%2""", 
		Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

