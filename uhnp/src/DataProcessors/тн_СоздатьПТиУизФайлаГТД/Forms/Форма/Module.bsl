&НаСервереБезКонтекста
Функция ЗапросПоискНомераГТД(КодГТД, СтранаПроисхождения)
	
	Если НЕ ЗначениеЗаполнено(КодГТД) И НЕ ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		Возврат Неопределено; // Поиск не возможен, не заданы параметры
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомераГТД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НомераГТД КАК НомераГТД
	|ГДЕ
	|	НомераГТД.Код = &Код
	|	И НомераГТД.СтранаПроисхождения = &СтранаПроисхождения");
	
	Если Не ЗначениеЗаполнено(КодГТД) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НомераГТД.Код = &Код И", "");
	Иначе	
	    Запрос.УстановитьПараметр("Код", КодГТД);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НомераГТД.СтранаПроисхождения = &СтранаПроисхождения", "");
	Иначе	
	    Запрос.УстановитьПараметр("СтранаПроисхождения", СтранаПроисхождения);
	КонецЕсли; 
	
	Возврат Запрос.Выполнить();

КонецФункции

&НаСервереБезКонтекста
Функция ВыборкаДанныхИзБазы(РезультатЗапроса)

	Если РезультатЗапроса = Неопределено ИЛИ РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РезультатПоиска = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		РезультатПоиска.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат РезультатПоиска;
	
КонецФункции 

&НаСервереБезКонтекста
Функция СоздатьРезультатПоискаДанныхШапки(ИмяРеквизита, Данные)
	Возврат Новый Структура("ИмяРеквизита, Данные", ИмяРеквизита, Данные);	
КонецФункции  

&НаСервере
Процедура ПоискДанныхТЧТоварыВБазе()
	
	Для каждого Товар Из Товары Цикл
		
		Товар.РезультатПоискаНоменклатуры.ЗагрузитьЗначения(НоменклатураВБазе(Товар.НаименованиеНоменклатуры));
		Товар.БазоваяЕдИзмИзФайла.Ссылка = БазоваяЕдиницаИзмерения(Товар.БазоваяЕдИзмИзФайла.Код);
		КоличествоНайденныхЗначений = Товар.РезультатПоискаНоменклатуры.Количество();
		
		Если КоличествоНайденныхЗначений = 0 Тогда
			Товар.СтатусНоменклатуры = СтатусНеНайден;
			Товар.ВидНоменклатуры = ВидНомеклатурыПоУмолчанию;
			
			Товар.ГруппаНоменклатуры 	= ГруппаПоУмолчанию;
			Товар.СчетБУ				= СчетБУПоУмолчанию;
			Товар.СчетНУ				= СчетНУПоУмолчанию;
			Товар.СтавкаНДС				= СтавкаНДСПоУмолчанию;
		ИначеЕсли КоличествоНайденныхЗначений = 1 Тогда
			Товар.СтатусНоменклатуры = СтатусНайден;
			Товар.Номенклатура = Товар.РезультатПоискаНоменклатуры[0].Значение;
			ДанныеНоменклатуры = ДанныеНоменклатуры(Товар.Номенклатура);
			Товар.ГруппаНоменклатуры = ДанныеНоменклатуры.Группа;
			Товар.ВидНоменклатуры = ДанныеНоменклатуры.ВидНоменклатуры;		
			Товар.СтавкаНДС 	= ДанныеНоменклатуры.СтавкаНДС;
						
		Иначе
			Товар.СтатусНоменклатуры = СтатусНайденоБолееОдного;
		КонецЕсли; 
		
		Если КоличествоНайденныхЗначений = 1 Тогда
			Товар.БазоваяЕдиницаИзмерения = ДанныеНоменклатуры.БазоваяЕдиницаИзмерения;
			Товар.КодБазовойЕдиницыИзмерения = ДанныеНоменклатуры.БазоваяЕдиницаИзмеренияКод;	
		Иначе
			Товар.БазоваяЕдиницаИзмерения = Товар.БазоваяЕдИзмИзФайла.Ссылка;
			Товар.КодБазовойЕдиницыИзмерения = Товар.БазоваяЕдИзмИзФайла.Код;	
		КонецЕсли;
		
		Товар.СоздатьНовуюНоменклатуру = (Товар.СтатусНоменклатуры = СтатусНеНайден 
		И Товар.НаименованиеНоменклатуры <> СтатусНеНайденоВФайле);
		УстановитьСтраныВТЧТовары();
		
	КонецЦикла; 
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция НоменклатураВБазе(НаименованиеНоменклатуры)

	НайденнаяНоменклатура = Новый Массив;
	
	Запрос = Новый Запрос( 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ     
	|   НЕ Номенклатура.ЭтоГруппа И
	|	 Номенклатура.Наименование ПОДОБНО &Наименование");
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеНоменклатуры + "%");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат НайденнаяНоменклатура;	
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НайденнаяНоменклатура.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Возврат НайденнаяНоменклатура;	
	
КонецФункции 

&НаСервереБезКонтекста
Функция ДанныеНоменклатуры(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Номенклатура.тн_БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
	|	Номенклатура.тн_БазоваяЕдиницаИзмерения.Код КАК БазоваяЕдиницаИзмеренияКод
	|	,Номенклатура.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Новый Структура(
	"Группа, ВидНоменклатуры, БазоваяЕдиницаИзмерения, БазоваяЕдиницаИзмеренияКод, СтавкаНДС", 
	Выборка.Родитель, Выборка.ВидНоменклатуры, Выборка.БазоваяЕдиницаИзмерения, 
	Выборка.БазоваяЕдиницаИзмеренияКод, Выборка.СтавкаНДС);
			
КонецФункции 

