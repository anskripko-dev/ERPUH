Функция ПолучитьДоговорКонтрагента(Контрагент, ДатаДоговора, НомерДоговора, Валюта, Организация, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 

	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.Дата = &Дата
	|	И ДоговорыКонтрагентов.Номер = &Номер
	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	|	И ДоговорыКонтрагентов.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", Валюта);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаДоговора);
	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		//НАЧАЛО Качикина 16.12.2024 Выполнение задач №000052038
		ОбщегоНазначения.СообщитьПользователю("Найден существующий договор, новый договор не был создан!");
		//КОНЕЦ Качикина 16.12.2024 Выполнение задач №000052038
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	ДоговорОбъект.Контрагент = Контрагент; 
	//НАЧАЛО Качикина 02.04.2025 Выполнение задач №000053247
	ДоговорОбъект.Партнер = ?(ЗначениеЗаполнено(Контрагент),Контрагент.Партнер,Справочники.Партнеры.ПустаяСсылка());
	//КОНЕЦ Качикина 02.04.2025 Выполнение задач №000053247
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДоговорОбъект.Дата  = ?(ЗначениеЗаполнено(ДатаДоговора), ДатаДоговора, ТекущаяДата());
	ДоговорОбъект.Дата  = ?(ЗначениеЗаполнено(ДатаДоговора), ДатаДоговора, ТекущаяДатаСервера());
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ДоговорОбъект.Номер = ?(ЗначениеЗаполнено(НомерДоговора), НомерДоговора, "1");
	ДоговорОбъект.Наименование = СтрШаблон("%1 от %2", ДоговорОбъект.Номер, Формат(ДоговорОбъект.Дата, "ДФ=dd.MM.yyyy"));
	ДоговорОбъект.ВалютаВзаиморасчетов = Валюта;
	ДоговорОбъект.Организация = Организация;
	ДоговорОбъект.ВидДоговораУХ = Справочники.ВидыДоговоровКонтрагентовУХ.Импорт;
	
	Попытка
		ДоговорОбъект.Записать();
		Возврат ДоговорОбъект.Ссылка;
	Исключение
		Отказ = Истина;
		Сообщить(СтрШаблон("Не удалось создать новый договор для контрагента ""%1"", по причине: ""%2""", 
		Контрагент.Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	
