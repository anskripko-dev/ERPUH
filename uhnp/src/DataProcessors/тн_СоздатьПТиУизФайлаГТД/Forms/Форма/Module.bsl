///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Обработка СоздатьПТиУизФайлаГТД предназначена:
// - для выбора xml-файла с данными о ГТД;
// - для загрузки из выбранного файла данных необходимых для создания документа ПоступлениеТоваровУслуг;
// - для формирования недостающих данных необходимых для создания документа ПоступлениеТоваровУслуг;
// - для создания нового документа ПоступлениеТоваровУслуг на основании данных о ГТД.
//
// Структура xml-файла с данными о ГТД должна соответствовать требованиям унифицированного формата электронных
// документов для обмена с информационными системами предприятий, который поддерживается Федеральной таможенной
// службой России. Например, это может быть xml-файл генерируемый программой Альта-ГТД.
//
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОписанияПеременных
	
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтатусНеНайден = 0;
	СтатусНайден = 1;
	СтатусНайденоБолееОдного = 2;
	СтатусНеНайденоВФайле = "Не найдено в файле или удалено пользователем";
	СтатусДанныеЗагружены = Ложь; 
	// НАЧАЛО Юдина Екатерина 29.01.2025 Выполнение задач №000052416
	//ВидНомеклатурыПоУмолчанию = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Запчасти к технологическому оборудованию"); // Запчасти к технологическому оборудованию
	ВидНомеклатурыПоУмолчанию = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары для перепродажи");
	// КОНЕЦ Юдина Екатерина 29.01.2025 Выполнение задач №000052416
	
	ГруппаПоУмолчанию		= Справочники.Номенклатура.НайтиПоНаименованию("Запасные части"); //Запасные части(ЦБ)
	СтавкаНДСПоУмолчанию	= Справочники.СтавкиНДС.БезНДС;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьИнтерфейсФормы();
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКФайлуПриИзменении(Элемент)
	СтатусДанныеЗагружены = Ложь;
	ОчиститьДанные();
	ОбновитьИнтерфейсФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтарыйПутьКФайлу = Объект.ПутьКФайлу;
	ВыбратьПутьКФайлу();
	ПутьКФайлуИзменен = Объект.ПутьКФайлу <> СтарыйПутьКФайлу;
	Если ПутьКФайлуИзменен Тогда
		ОчиститьДанные();
	КонецЕсли;
	СтатусДанныеЗагружены = Не ПутьКФайлуИзменен; 
	ОбновитьИнтерфейсФормы();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОбновитьИнтерфейсГруппыОрганизация();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	ПоискДанныхШапкиВБазе("ГруппаКонтрагента");
	ПоискДанныхШапкиВБазе("Договор");
	ОбновитьИнтерфейсГруппыКонтрагент();
	ОбновитьИнтерфейсГруппыДоговор();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовогоКонтрагентаПриИзменении(Элемент)
	Объект.Контрагент = Неопределено;
	Объект.ГруппаКонтрагента = Неопределено;
	ОбновитьИнтерфейсГруппыКонтрагент(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	СинхронизироватьДоговорСВладельцемКонтрагентомНаСервере();
	ОбновитьИнтерфейсГруппыКонтрагент();
	ОбновитьИнтерфейсГруппыДоговор();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйДоговорПриИзменении(Элемент)
	Объект.Договор = Неопределено;
	ОбновитьИнтерфейсГруппыДоговор(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДатаВходящегоПриИзменении(Элемент)
	ОбновитьИнтерфейсГруппыДатаВходщего();
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	ОбновитьИнтерфейсГруппыВалюта();
КонецПроцедуры

&НаКлиенте
Процедура СтранаПриИзменении(Элемент)
	ОбновитьИнтерфейсГруппыСтрана();
	Элементы.ТоварыКодАльфа2.Видимость = (Строка(Объект.Страна) = "РАЗНЫЕ");
	УстановитьСтраныВТЧТовары();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиТовары

&НаКлиенте
Процедура ТоварыПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Элементы.ТоварыНоменклатура.СписокВыбора.Очистить();
	
	Для каждого НайденнаяНоменклатура Из Элемент.ТекущиеДанные.РезультатПоискаНоменклатуры Цикл
		Элементы.ТоварыНоменклатура.СписокВыбора.Добавить(НайденнаяНоменклатура.Значение);	
	КонецЦикла;
	
	Статус = Элемент.ТекущиеДанные.СтатусНоменклатуры;
	ОбновитьСтатус(Элемент.ТекущиеДанные.Номенклатура, Элементы.ТоварыНоменклатура,	Статус);
	УстановитьКнопкиВыбора(Элементы.ТоварыНоменклатура, Статус);
	Элемент.ТекущиеДанные.СтатусНоменклатуры = Статус;
	
	Если Статус = СтатусНеНайден Тогда
		Элементы.ТоварыНоменклатура.ПодсказкаВвода = "Не найдено в базе или удалено, выберите Номенклатуру из списка";
	ИначеЕсли Статус = СтатусНайденоБолееОдного Тогда
		Элементы.ТоварыНоменклатура.ПодсказкаВвода = "Надено более одного значения, выберите из списка одно из них";
	Иначе
		Элементы.ТоварыНоменклатура.ПодсказкаВвода = "";
	КонецЕсли;
	
	Элементы.ТоварыВидНоменклатуры.ТолькоПросмотр = НЕ Элемент.ТекущиеДанные.СоздатьНовуюНоменклатуру;
	Элементы.ТоварыСтрана.БыстрыйВыбор = Истина;
	Элементы.ТоварыБазоваяЕдиницаИзмерения.ТолькоПросмотр = НЕ (Элемент.ТекущиеДанные.СоздатьНовуюНоменклатуру 
	И Элемент.ТекущиеДанные.КодБазовойЕдиницыИзмерения = СтатусНеНайденоВФайле);
	
	Элементы.ТоварыНаименование.ТолькоПросмотр = НЕ Элемент.ТекущиеДанные.СоздатьНовуюНоменклатуру;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные; 
	ДанныеНоменклатуры = ДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
	УстановитьДанныеНоменклатуры(ТекущиеДанные, ДанныеНоменклатуры);
	ОбновитьСтатус(ТекущиеДанные.Номенклатура, Элемент, ТекущиеДанные.СтатусНоменклатуры);
	УстановитьКнопкиВыбора(Элемент, ТекущиеДанные.СтатусНоменклатуры);
	УстановитьДанныеБазовойЕдИзм(ТекущиеДанные, ДанныеНоменклатуры);
	ТекущиеДанные.СоздатьНовуюНоменклатуру = (ТекущиеДанные.СтатусНоменклатуры = СтатусНеНайден 
	И ТекущиеДанные.НаименованиеНоменклатуры <> СтатусНеНайденоВФайле);
	
	пНоменклатура = ТекущиеДанные.Номенклатура;
	        
	Если ТипЗнч(пНоменклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
	
		ТекущиеДанные.СтавкаНДС		= ДанныеНоменклатуры.СтавкаНДС;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВидНоменклатурыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ВидНоменклатуры) Тогда
			ТекущиеДанные.ВидНоменклатуры = ВидНомеклатурыПоУмолчанию;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ГруппаНоменклатуры) Тогда
			ТекущиеДанные.ГруппаНоменклатуры = ГруппаПоУмолчанию;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетБУ) Тогда
			ТекущиеДанные.СчетБУ = СчетБУПоУмолчанию;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетНУ) Тогда
			ТекущиеДанные.СчетНУ = СчетНУПоУмолчанию;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СтавкаНДС) Тогда
			ТекущиеДанные.СтавкаНДС = СтавкаНДСПоУмолчанию;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаЗагрузитьДанные(Команда)
	
	ЗагрузитьДанныеИзФайла();
	ПоискДанныхШапкиВБазе();
	ПоискДанныхТЧТоварыВБазе();
	ОбновитьИнтерфейсФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьДокумент(Команда)
	
	Перем Отказ;
	ОчиститьСообщения();
	ПроверитьЗаполнениеРеквизитов(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		ДокументОбъект = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
		ЗаполнитьДокументНаСервере(ДокументОбъект, Неопределено, Отказ);
		Форма = ДокументОбъект.ПолучитьФорму();
		Если Отказ Тогда
			Возврат;
		КонецЕсли; 
		Форма.Открыть();
	#Иначе
		ПараметрыЗагрузки = ЗаполнитьПараметрыЗагрузки();  
		Если НЕ ПараметрыЗагрузки = Неопределено Тогда 
			ОткрытьФорму("Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента", ПараметрыЗагрузки, ЭтотОбъект, , , , );
		КонецЕсли;
	#КонецЕсли		
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ИНТЕРФЕЙСОМ

&НаКлиенте
Процедура ВыбратьПутьКФайлу()

	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Фильтр = "Документы Excel (*.xml)|*.xml";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите xml-файл для загрузки данных о ГТД";
	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		Предупреждение("Файл не выбран!");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанные()
	
	Объект.Организация = Неопределено;
	Объект.ИНН = Неопределено;
	Объект.КПП = Неопределено;
	Объект.Контрагент = Неопределено;
	Объект.НаименованиеКонтрагента = Неопределено;
	Объект.СоздатьНовыйКонтрагент = Ложь;
	Объект.Договор = Неопределено;
	Объект.ДатаДоговора = Неопределено;
	Объект.НомерДоговора = Неопределено;
	Объект.СоздатьНовыйДоговор = Ложь;
	Объект.ДатаВходящего = Неопределено;
	Объект.Страна = Неопределено;
	Объект.КодАльфа2 = Неопределено;
	Объект.КодГТД = Неопределено;
	Объект.СоздатьНовыйНомерГТД = Ложь;
	Объект.Валюта = Неопределено;
	Объект.КодВалюты = Неопределено; 
	Объект.ГруппаКонтрагента = Неопределено;
	Товары.Очистить();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьИнтерфейсФормы()
	
	Элементы.КнопкаЗагрузитьДанные.Доступность = ЗначениеЗаполнено(Объект.ПутьКФайлу);
	Элементы.ФормаСоздатьДокумент.Доступность = СтатусДанныеЗагружены;
	ОбновитьИнтерфейсГруппыОрганизация();
	ОбновитьИнтерфейсГруппыКонтрагент();
	ОбновитьИнтерфейсГруппыДоговор();
	ОбновитьИнтерфейсГруппыДатаВходщего();
	ОбновитьИнтерфейсГруппыВалюта();
	ОбновитьИнтерфейсГруппыСтрана();
	
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.ИНН, Элементы.ИНН);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.КПП, Элементы.КПП);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.НаименованиеКонтрагента, Элементы.НаименованиеКонтрагента);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.ДатаДоговора, Элементы.ДатаДоговора);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.НомерДоговора, Элементы.НомерДоговора);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.КодВалюты, Элементы.КодВалюты);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.КодАльфа2, Элементы.КодАльфа2);
	УстановитьПодсказкуВводаПоДаннымИзФайла(Объект.КодГТД, Элементы.КодГТД);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнтерфейсГруппыОрганизация()
	
	Элементы.ГруппаОрганизация.Доступность = СтатусДанныеЗагружены;
	Если НЕ СтатусДанныеЗагружены Тогда
		Возврат;
	КонецЕсли; 
	
	ОбновитьСтатус(Объект.Организация, Элементы.Организация, Объект.СтатусОрганизации);
	УстановитьКнопкиВыбора(Элементы.Организация, Объект.СтатусОрганизации);
	
	Если Объект.СтатусОрганизации = СтатусНеНайден Тогда
		ТекстПодсказки = "Не найдено в базе или удалено, выберите Организацию из списка";
	ИначеЕсли Объект.СтатусОрганизации = СтатусНайден Тогда
		ТекстПодсказки = "";
	ИначеЕсли Объект.СтатусОрганизации = СтатусНайденоБолееОдного Тогда
	    ТекстПодсказки = "Надено более одного значения, выберите из списка одно из них";
	КонецЕсли;
	
	Элементы.Организация.ПодсказкаВвода = ТекстПодсказки;
	Элементы.Организация.Подсказка = ТекстПодсказки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнтерфейсГруппыКонтрагент(СоздатьНовогоКонтрагентаПриИзменении = Ложь)
	
	Элементы.Контрагент.Доступность = СтатусДанныеЗагружены;
	Элементы.СоздатьНовогоКонтрагента.Доступность = СтатусДанныеЗагружены;
	Элементы.ГруппаКонтрагента.Доступность = СтатусДанныеЗагружены;
	Элементы.НаименованиеКонтрагента.Доступность = СтатусДанныеЗагружены;
	Если НЕ СтатусДанныеЗагружены Тогда
		Возврат;
	КонецЕсли; 
	
	ОбновитьСтатус(Объект.Контрагент, Элементы.Контрагент, Объект.СтатусКонтрагента);
	УстановитьКнопкиВыбора(Элементы.Контрагент, Объект.СтатусКонтрагента);
	
	Если НЕ СоздатьНовогоКонтрагентаПриИзменении Тогда
		Объект.СоздатьНовыйКонтрагент = Объект.СтатусКонтрагента = СтатусНеНайден;
	КонецЕсли;
	
	Элементы.ГруппаКонтрагента.Доступность = Объект.СоздатьНовыйКонтрагент;
	Элементы.НаименованиеКонтрагента.Доступность =  Объект.СоздатьНовыйКонтрагент;
	Элементы.НаименованиеКонтрагента.ТолькоПросмотр = Ложь;
	
	Если Объект.СтатусКонтрагента = СтатусНеНайден И Объект.СоздатьНовыйКонтрагент Тогда
		ТекстПодсказки = "Не найдено в базе или удалено, будет создан новый Контрагент";
	ИначеЕсли Объект.СтатусКонтрагента = СтатусНеНайден И НЕ Объект.СоздатьНовыйКонтрагент Тогда
		ТекстПодсказки = "Не найдено в базе или удалено, выберите Контрагента из списка";
	ИначеЕсли Объект.СтатусКонтрагента = СтатусНайден Тогда
		ТекстПодсказки = "";
	ИначеЕсли Объект.СтатусКонтрагента = СтатусНайденоБолееОдного Тогда
	    ТекстПодсказки = "Надено более одного значения, выберите из списка одно из них";
	КонецЕсли;
	
	Элементы.Контрагент.ПодсказкаВвода = ТекстПодсказки;
	Элементы.Контрагент.Подсказка = ТекстПодсказки;
	
КонецПроцедуры

