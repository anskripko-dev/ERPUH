Функция НовыйНомерГТД(КодГТД, Страна, Отказ)
	
	// Проверим, возможно НомерГТД уже существует в базе
	Запрос = Новый Запрос( 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомераГТД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НомераГТД КАК НомераГТД
	|ГДЕ
	|	НомераГТД.Код = &Код
	|	И НомераГТД.СтранаПроисхождения = &СтранаПроисхождения");
	
	Запрос.УстановитьПараметр("Код", СокрЛП(КодГТД));
	Запрос.УстановитьПараметр("СтранаПроисхождения", Страна);
	
