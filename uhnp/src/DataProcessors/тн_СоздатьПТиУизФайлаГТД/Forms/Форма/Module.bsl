//Функция ПолучитьНоменклатуру(Наименование, Группа, Вид, БазоваяЕдИзм, Страна, НомерГТД, Отказ)
Функция ПолучитьНоменклатуру(Наименование, НаименованиеПолное, Группа, Вид, БазоваяЕдИзм, Договор, СтавкаНДС, Страна, НомерГТД, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И Номенклатура.Родитель = &Родитель
	|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	|	И Номенклатура.тн_БазоваяЕдиницаИзмерения = &БазоваяЕдиницаИзмерения";
//	|	И Номенклатура.НомерГТД = &НомерГТД";

	Запрос.УстановитьПараметр("БазоваяЕдиницаИзмерения", БазоваяЕдИзм);
