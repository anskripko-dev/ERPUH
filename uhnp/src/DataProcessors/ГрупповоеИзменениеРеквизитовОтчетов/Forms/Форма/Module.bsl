
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = Нстр("ru = 'Групповое изменение доступно только пользователю с полными правами'");
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
	Если ТипЗнч(Параметры.МассивОтчетов) <> Тип("Массив") Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьИЗакрыть(Команда)
	
	Если Объект.Заблокировать = 0 И Объект.СостояниеОтчета.Пустая() Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Не установлено состояние отчета или признак блокировки.'"));
		Возврат;
	КонецЕсли;
	
	ИзменитьСостояниеОтчетов(Новый ФиксированныйМассив(Параметры.МассивОтчетов),
		Объект.СостояниеОтчета, Объект.Заблокировать, Параметры.ИдентификаторФормыВладельца);
	
	ОповеститьОбИзменении(Тип("ДокументСсылка.НастраиваемыйОтчет"));
	
	Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьСостояниеОтчетов(Знач МассивОтчетов, Знач СостояниеОтчета, Знач Заблокировать,
	Знач ИдентификаторФормыВладельца)
	
	Для Каждого НастраиваемыйОтчет Из МассивОтчетов Цикл
		
		Если РасширениеПроцессыИСогласованиеУХ.СогласованиеЧерезРакурс(НастраиваемыйОтчет.ВидОтчета) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектОтчета = НастраиваемыйОтчет.ПолучитьОбъект();
		
		ИзмененоСостояние = (ЗначениеЗаполнено(СостояниеОтчета)
			И (НЕ ОбъектОтчета.Состояние = СостояниеОтчета));
		
		ИзмененаБлокировка = (Заблокировать = 1 И НЕ ОбъектОтчета.НеВноситьИзменения)
			ИЛИ (Заблокировать = 2 И ОбъектОтчета.НеВноситьИзменения);
		
		Если ИзмененаБлокировка Тогда
			
			ОбъектОтчета.НеВноситьИзменения = НЕ ОбъектОтчета.НеВноситьИзменения;
			Если ИзмененоСостояние Тогда
				ОбъектОтчета.ДополнительныеСвойства.Вставить("ИзмененоСостояние", Истина);
			КонецЕсли;
			ОбъектОтчета.ОбменДанными.Загрузка = Истина;
			
			Попытка
				ОбъектОтчета.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				ШаблонСообщения = Нстр("ru ='Ошибка сохранения документа <%1><%2><%3><%4>.'");
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбъектОтчета.ВидОтчета, ОбъектОтчета.Организация,
					ОбъектОтчета.ПериодОтчета, ОбъектОтчета.Сценарий);
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,, ИдентификаторФормыВладельца);
			КонецПопытки;
			
		КонецЕсли;
		
		Если ИзмененоСостояние Тогда
			РасширениеПроцессыИСогласованиеУХ.ИзменитьСостояниеСогласованияОбъекта(ОбъектОтчета, СостояниеОтчета);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СостояниеОтчетаПриИзменении(Элемент)
	
	Если Объект.СостояниеОтчета = ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Утвержден") Тогда
		Объект.Заблокировать = 1;
	КонецЕсли;
	
	ВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДоступность()
	
	Элементы.Заблокировать.Доступность = НЕ Объект.СостояниеОтчета = ПредопределенноеЗначение("Перечисление.СостоянияОтчетов.Утвержден");
	
КонецПроцедуры
