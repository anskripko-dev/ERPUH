#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ВыгрузитьДанныеПоНастройке(СтрокаНастройки)
	
	СписокОтбораНастройка=Неопределено;
	
	Если ЗначениеЗаполнено(СтрокаНастройки.НастройкаОтбора) Тогда
		
		СписокОтбораНастройка=Новый СписокЗначений;
		МассивЭлементов=Справочники.СохраненныеНастройкиОтборов.ПолучитьТаблицуЭлементовПоОтбору(СтрокаНастройки.НастройкаОтбора,
																	Ложь,
																	СтрокаНастройки.НастройкаСоответствия).ВыгрузитьКолонку("Ссылка");
		СписокОтбораНастройка.ЗагрузитьЗначения(МассивЭлементов);
		
	КонецЕсли;	
			
	Если СтрокаНастройки.ТолькоИзмененные Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИзмененныеОбъектыДляВыгрузки.Элемент
		|ИЗ
		|	РегистрСведений.ИзмененныеОбъектыДляВыгрузки КАК ИзмененныеОбъектыДляВыгрузки
		|ГДЕ
		|	ИзмененныеОбъектыДляВыгрузки.НастройкаСоответствия = &НастройкаСоответствия
		|	И ИзмененныеОбъектыДляВыгрузки.ИспользуемаяИБ = &ИспользуемаяИБ"; 
		
		Если НЕ СписокОтбораНастройка=Неопределено Тогда
			
			Запрос.Текст=Запрос.Текст+"
			|И ИзмененныеОбъектыДляВыгрузки.Элемент В(&СписокОтбораНастройка)";
			Запрос.УстановитьПараметр("СписокОтбораНастройка",СписокОтбораНастройка);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ИспользуемаяИБ",СтрокаНастройки.ИспользуемаяИБ);
		Запрос.УстановитьПараметр("НастройкаСоответствия",СтрокаНастройки.НастройкаСоответствия);
		
		СписокОбъектов=Новый СписокЗначений;
		СписокОбъектов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Элемент"));
		
		ИнтеграцияСВнешнимиСистемамиУХ.ВыгрузитьОбъектыВВИБ(СтрокаНастройки.ИспользуемаяИБ,СтрокаНастройки.НастройкаСоответствия,СписокОбъектов);
		
	Иначе
		
		ИнтеграцияСВнешнимиСистемамиУХ.ВыгрузитьОбъектыВВИБ(СтрокаНастройки.ИспользуемаяИБ,СтрокаНастройки.НастройкаСоответствия,СписокОтбораНастройка);
		
	КонецЕсли;
					
КонецПроцедуры // ВыгрузитьДанныеПоНастройке() 

Процедура ЗагрузитьДанныеПоНастройке(СтрокаНастройки)
	
	ТипОбъектаВИБ=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНастройки.НастройкаСоответствия,"ТипОбъектаВИБ");
	
	Если ТипОбъектаВИБ="ТаблицаADO" Тогда
		
		ИнтеграцияСВнешнимиСистемамиУХ.ЗагрузитьОбъектыИзADO(СтрокаНастройки.ИспользуемаяИБ,СтрокаНастройки.НастройкаСоответствия);
		
	Иначе
		
		ИнтеграцияСВнешнимиСистемамиУХ.ЗагрузитьОбъектыИзВИБ(СтрокаНастройки.ИспользуемаяИБ,СтрокаНастройки.НастройкаСоответствия,,,,Истина,?(ТестовыйРежим,ЧислоПервых,0),СтрокаНастройки.НастройкаОтбора);
		
	КонецЕсли;	
	
КонецПроцедуры // ЗагрузитьДанныеПоНастройке() 

Процедура ВыполнитьВыгрузкуДанных() Экспорт 
	
	Для Каждого СтрокаНастройки ИЗ ПараметрыЭкспортаНСИ Цикл
		
		ВыгрузитьДанныеПоНастройке(СтрокаНастройки);
		
	КонецЦикла;	
	
КонецПроцедуры // ВыполнитьВыгрузкуДанных() 

Процедура ВыполнитьЗагрузкуДанных() Экспорт 
	
	Для Каждого СтрокаНастройки ИЗ ПараметрыИмпортаНСИ Цикл
		
		ЗагрузитьДанныеПоНастройке(СтрокаНастройки);
		
	КонецЦикла;	
	
КонецПроцедуры // ВыполнитьВыгрузкуДанных()
	
#КонецЕсли	