// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция НайтиДоговор(Контрагент) 
	
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ВидВзиморасчетовЗачеты = Константы.тн_ВидВзаиморасчетовЗачеты.Получить();
	НаименованиеДоговора = Константы.тн_НаименованиеДоговораДляЗагрузкиДанныхСПортала.Получить();
	
	Если НЕ ЗначениеЗаполнено(Контрагент) 
		ИЛИ НЕ ЗначениеЗаполнено(ВидВзиморасчетовЗачеты) 
		ИЛИ НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		Возврат Договор;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.тн_ВидВзаиморасчетовЗачеты КАК тн_ВидВзаиморасчетовЗачеты
		|		ПО ДоговорыКонтрагентов.тн_ВидВзаиморасчетов = тн_ВидВзаиморасчетовЗачеты.Значение
		|ГДЕ
		|	ДоговорыКонтрагентов.Контрагент = &Контрагент
		|	И ДоговорыКонтрагентов.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Наименование", НаименованиеДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоДоговоров	= Выборка.Количество();
	
	Если КоличествоДоговоров = 1 Тогда
		Выборка.Следующий();
		Договор = Выборка.Ссылка;
	ИначеЕсли КоличествоДоговоров = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Для контрагента """ + Контрагент + """ не найден договор с видом взаиморасчетов " 
			+ ВидВзиморасчетовЗачеты + " и наименованием " + НаименованиеДоговора + ".");
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Для контрагента """ + Контрагент + """ найдено более одного договора с видом взаиморасчетов """ + ВидВзиморасчетовЗачеты + ".");
	КонецЕсли; 
	
	Возврат Договор; 
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция НайтиСтатьюРасходов(КодКонсолидации)
	
	СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(КодКонсолидации) Тогда
		Возврат СтатьяРасходов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтатьиРасходов.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
		|ГДЕ
		|	СтатьиРасходов.тн_КодКонсолидации = &тн_КодКонсолидации";
	
