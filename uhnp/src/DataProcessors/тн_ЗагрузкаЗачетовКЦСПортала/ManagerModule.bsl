Функция ЗагрузитьДанныеСПорталаНаСервере(УникальныйИдентификатор, ПериодЗагрузки = Неопределено, РегламентноеЗадание = Ложь) Экспорт
	
	//Формируем и отправляем сообщение-запрос 
	ПараметрыСообщения = ПараметрыСообщения();
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(ПараметрыСообщения);
	ТекстСообщения = СформироватьТекстСообщенияЗапросДанных(ПараметрыСообщения, ОбъектXDTO_ЗапросДанных); 

	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОтправитьСообщениеЗапрос(ПараметрыСообщения);
	
	ДобавитьЗаписьЗапросыRabbitMQ(ПараметрыСообщения);
		
	ДлительнаяОперация = ДлительнаяОперацияОжиданияОбработкиОтветногоСообщения(ПараметрыСообщения, УникальныйИдентификатор, РегламентноеЗадание);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДлительнаяОперация;
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Процедура СоздатьДокументы(Зачеты, РегламентноеЗадание = Ложь) Экспорт 
	
	НастройкиОтражения = КонстантыПоВзаиморасчетамСКЦ();
	Если Не ЗначениеЗаполнено(НастройкиОтражения) Тогда
		Возврат;
	КонецЕсли;
	
	Для Сч = 0 По Зачеты.Количество() - 1 Цикл 
		
		Стр = Зачеты[Сч];
		
		НеНужноСоздаватьДокумент = ЗначениеЗаполнено(Стр.ДокументПрочиеДоходыРасходы)
			Или ЗначениеЗаполнено(НайтиДокументПрочиеДоходыРасходы(Стр.ID))
			Или Не Стр.РезультатПроверки
			Или Не Стр.Пометка;
			
		Если НеНужноСоздаватьДокумент Тогда	
			Продолжить;
		КонецЕсли; 
		
		Попытка
			Стр.ДокументПрочиеДоходыРасходы = СоздатьДокументПрочиеДоходыРасходы(Стр, НастройкиОтражения);
			//передача ГУИД созданного документа на Портал  
			ПередатьДанныеЗачетаНаПортал(Стр.ID, Строка(Стр.ДокументПрочиеДоходыРасходы.УникальныйИдентификатор()));   
			
			Если РегламентноеЗадание Тогда
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, Стр.ДокументПрочиеДоходыРасходы,
					"Успешно создан и передан на Портал документ ""Отражение прочих доходов и расходов"" (ID " 
					+ Формат(Стр.ID, "ЧГ=0") + ")"); 
			Иначе
				
				ОбщегоНазначения.СообщитьПользователю("Успешно создан и передан на Портал документ ""Отражение прочих доходов и расходов"" (ID " 
					+ Формат(Стр.ID, "ЧГ=0") + ")", Стр.ДокументПрочиеДоходыРасходы);   
								
			КонецЕсли;	
				
		Исключение
			Если ЗначениеЗаполнено(Стр.ДокументПрочиеДоходыРасходы) Тогда
				ДокументОбъект = Стр.ДокументПрочиеДоходыРасходы.ПолучитьОбъект();
				ДокументОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
			Стр.ДокументПрочиеДоходыРасходы = Неопределено;
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());  
			
			Если РегламентноеЗадание Тогда  
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
					"Ошибка создания документа ""Отражение прочих доходов и расходов""(ID " 
				    + Формат(Стр.ID, "ЧГ=0")+ "): " + ТекстОшибки); 
				
			Иначе  
				
				ОбщегоНазначения.СообщитьПользователю("Ошибка создания документа ""Отражение прочих доходов и расходов""(ID " 
				  + Формат(Стр.ID, "ЧГ=0")+ "): " + ТекстОшибки);  

			КонецЕсли;	

			Продолжить;
		КонецПопытки;  
		
	КонецЦикла;
		
КонецПроцедуры

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Процедура ЗаполнитьЗачеты(РезультатВыполненияДлительнойОперации, Зачеты, ПериодЗагрузки) Экспорт
	
	СообщениеXDTO = тн_ИнтеграцияFinAppPortal.ПрочитатьСообщениеJSON(РезультатВыполненияДлительнойОперации.Результат);
	Если СообщениеXDTO = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеПоЗачетам = СообщениеXDTO.responseSetOff[0].tableData.string;      

	Для Сч = 1 По ДанныеПоЗачетам.Количество() Цикл
		
		Зачет = ДанныеПоЗачетам[Сч - 1];
		ДатаЗачета = Зачет.date;
		
		Если НЕ тн_ОбщегоНазначения.ДатаВходитВПериод(ДатаЗачета, ПериодЗагрузки.ДатаНачала, ПериодЗагрузки.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли; 
		
		Стр = Зачеты.Добавить();
		
		Стр.НомерСтроки					  = Сч;
		Стр.ДатаЗачета					  = ДатаЗачета;
		Стр.ID							  = Зачет.id;
		Стр.ЕКК                     	  = Зачет.ekk;
		Стр.ИНН                     	  = СокрЛП(Зачет.inn);
		Стр.КПП                     	  = СокрЛП(Зачет.kpp);
		Стр.Контрагент					  = Справочники.Контрагенты.НайтиКонтрагента(Стр.ЕКК, Стр.ИНН, Стр.КПП);
		Стр.Договор						  = НайтиДоговор(Стр.Контрагент);
		Стр.СтатьяРасходовКодКонсолидации = СокрЛП(Зачет.costItemCode);
		Стр.СтатьяРасходов 				  = НайтиСтатьюРасходов(Стр.СтатьяРасходовКодКонсолидации); 
		Стр.КодПодразделения        	  = СокрЛП(Зачет.departmentCode);
		Стр.Подразделение				  = НайтиПодразделение(Стр.КодПодразделения);
		Стр.Сумма       				  = Зачет.sum;
		Стр.Комментарий					  = СокрЛП(Зачет.comment);  
		Стр.ДокументПрочиеДоходыРасходы   = НайтиДокументПрочиеДоходыРасходы(Зачет.id);
		
	КонецЦикла; 
	
КонецПроцедуры

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Процедура ПроверитьЗаполнениеРеквизитов(Зачеты) Экспорт   
	
	РезультатПроверки = Ложь;

	Для Сч = 0 По Зачеты.Количество() - 1 Цикл
		Стр = Зачеты[Сч];
		
		Если Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли; 
		
		Результат = Истина;
		Результат = ЗначениеЗаполнено(Стр.ДатаЗачета) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Контрагент) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Договор) И Результат;
		Результат = ЗначениеЗаполнено(Стр.СтатьяРасходов) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Подразделение) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Сумма) И Результат;
		
		Стр.РезультатПроверки 	= Результат;   
		
		 Если Не Результат Тогда
		
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
					"Для создания документа по ID" + Стр.ID + " недостаточно данных");  
					
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

