// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция НайтиПодразделение(КодПодразделения) 
	
	Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(КодПодразделения) Тогда
		Возврат Подразделение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтруктураПредприятия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	СтруктураПредприятия.тн_КодПодразделенияВКомпании = &КодПодразделения";
	
	Запрос.УстановитьПараметр("КодПодразделения", КодПодразделения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоПодразделений = Выборка.Количество();
	
	Если КоличествоПодразделений = 1 Тогда
		Выборка.Следующий();
		Подразделение = Выборка.Ссылка;
	ИначеЕсли КоличествоПодразделений = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдено подразделение с кодом " + КодПодразделения);
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Найдено более одного подразделения с кодом " + КодПодразделения);
	КонецЕсли; 
	
	Возврат Подразделение;
	
КонецФункции

