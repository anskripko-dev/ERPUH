// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция КонстантыПоВзаиморасчетамСКЦ()   
	
	КонстантыПоВзаиморасчетамСКЦ = Новый Структура();

	ОрганизацияКЦДляВеденияУУ = Константы.тн_ОрганизацияКЦДляВеденияУУ.Получить(); 
	СтатьяАктивовПассивовКЦ   = Константы.тн_СтатьяАктивовПассивовКЦДляВеденияУУ.Получить();
	
	КонтрольЗаполненияКонстант = ЗначениеЗаполнено(ОрганизацияКЦДляВеденияУУ) + ЗначениеЗаполнено(СтатьяАктивовПассивовКЦ); 
		
	Если КонтрольЗаполненияКонстант < 2 Тогда
		ОбщегоНазначения.СообщитьПользователю("Заполните константы по взаиморасчетам с КЦ."); 
		Возврат КонстантыПоВзаиморасчетамСКЦ;
	КонецЕсли;
	
	КонстантыПоВзаиморасчетамСКЦ.Вставить("ОрганизацияКЦДляВеденияУУ", ОрганизацияКЦДляВеденияУУ);
	КонстантыПоВзаиморасчетамСКЦ.Вставить("СтатьяАктивовПассивовКЦ", СтатьяАктивовПассивовКЦ);
	
	Возврат КонстантыПоВзаиморасчетамСКЦ; 
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Функция СоздатьДокументПрочиеДоходыРасходы(Параметры, НастройкиОтражения) 
	
	//Шапка
	ДокументПДР = Документы.ПрочиеДоходыРасходы.СоздатьДокумент();
	ДокументПДР.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочиеРасходы; 
	ДокументПДР.Организация = НастройкиОтражения.ОрганизацияКЦДляВеденияУУ;
	ДокументПДР.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументПДР.Основание = "Создано обработкой ""Загрузка зачетов КЦ с Портала"""; 
	ДокументПДР.Ответственный = Пользователи.ТекущийПользователь();
	ДокументПДР.Дата = Параметры.ДатаЗачета;
	ДокументПДР.Комментарий	= Строка(Параметры.Комментарий) + " ID: " + Формат(Параметры.ID, "ЧГ=0");
	ДокументПДР.тн_ИдентификаторЗачетаКЦНаПортале = Параметры.ID;
	
	//ТЧ
	СтрокаТЧ = ДокументПДР.ПрочиеРасходы.Добавить();
	СтрокаТЧ.Подразделение = Параметры.Подразделение;
	СтрокаТЧ.АналитикаРасходов = Параметры.Подразделение;
	СтрокаТЧ.СтатьяРасходов = Параметры.СтатьяРасходов;
	СтрокаТЧ.ДатаОтражения = Параметры.ДатаЗачета; 
	СтрокаТЧ.СтатьяАктивовПассивов = НастройкиОтражения.СтатьяАктивовПассивовКЦ;
	СтрокаТЧ.АналитикаАктивовПассивов = Параметры.Контрагент; 
	СтрокаТЧ.Сумма = Параметры.Сумма; 
	СтрокаТЧ.СуммаБезНДС = Параметры.Сумма;
	СтрокаТЧ.СуммаУпр = Параметры.Сумма;
	СтрокаТЧ.СуммаРегл = 0;
	
	//Настройки счетов учета
	НастройкиСчетовУчета = Новый Соответствие;
	НовыйЭлементНастройкиСчетовУчета = НастройкаСчетовУчетаСлужебныйВызовСервера.СсылкаНовогоЭлементаНастройкиСчетовУчета();
	ДанныеНастройкиСчетовУчета = НастройкаСчетовУчетаКлиентСервер.СоставНастройкиСчетовУчета();
	ДанныеНастройкиСчетовУчета.СчетУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиОтражения.СтатьяАктивовПассивовКЦ, "СчетУчета");
	ДанныеНастройкиСчетовУчета.Субконто1 = Параметры.Контрагент;
	ДанныеНастройкиСчетовУчета.Субконто2 = Параметры.Договор;  
	НастройкиСчетовУчета.Вставить(НовыйЭлементНастройкиСчетовУчета, ДанныеНастройкиСчетовУчета); 
	ДокументПДР.ДополнительныеСвойства.Вставить("НастройкиСчетовУчета", НастройкиСчетовУчета);
	СтрокаТЧ.НастройкаСчетовУчета = НовыйЭлементНастройкиСчетовУчета;
	
	ДокументПДР.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ДокументПДР.Ссылка;  
	
 КонецФункции
 
// Юдина Екатерина 06.10.2025 Выполнение задач №000055378 
//
Процедура ПередатьДанныеЗачетаНаПортал(ИдентификаторЗачета, УИДДокумента) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	//1. Формируем и отправляем сообщение-запрос
	ПараметрыСообщения = ПараметрыСообщения(); 
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(ПараметрыСообщения, Истина, ИдентификаторЗачета, УИДДокумента); 
	ТекстСообщения = СформироватьТекстСообщенияЗапросДанных(ПараметрыСообщения, ОбъектXDTO_ЗапросДанных);
	
	ОтправитьСообщениеЗапрос(ПараметрыСообщения);
	
	ДобавитьЗаписьЗапросыRabbitMQ(ПараметрыСообщения);
	
	//2. Ожидаем ответа   в той же транзакции
	РезультатЗапросаДанных = тн_ИнтеграцияFinAppPortal.РезультатЗапросаДанныхСПортала(ПараметрыСообщения);  
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапросаДанных.ЕстьОшибки Тогда
		ВызватьИсключение (РезультатЗапросаДанных.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

