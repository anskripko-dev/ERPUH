#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьДанныеСПортала(Команда) 
	
	ЗагрузитьДанныеСПортала();
	ИзменитьПометки(Истина);  
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыПрочиеДоходыРасходы(Команда)  
	
	ОчиститьСообщения();
	
	Если НЕ ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли; 
	
	СоздатьДокументыПрочиеДоходыРасходыНаСервере();  
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	ИзменитьПометки(Истина);   
	
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСнять(Команда) 
	
	ИзменитьПометки(Ложь);  
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПолучениеДанныхСПортала

&НаКлиенте
Процедура ЗагрузитьДанныеСПортала() 
	
	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	//Зачеты.Очистить(); 
	Объект.Зачеты.Очистить(); 
	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	
	ДлительнаяОперация = ЗагрузитьДанныеСПорталаНаСервере();
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Ожидаем ответа
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиОтветногоСообщения", ЭтотОбъект); 
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, НастройкиОжидания);
		
КонецПроцедуры

