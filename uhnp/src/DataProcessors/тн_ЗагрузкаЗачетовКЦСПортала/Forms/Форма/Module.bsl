&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()    
	
	РезультатПроверки = Ложь;

	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	//Для Сч = 0 По Зачеты.Количество() - 1 Цикл
	//	Стр = Зачеты[Сч];
	Для Сч = 0 По Объект.Зачеты.Количество() - 1 Цикл
		Стр = Объект.Зачеты[Сч];
	// КОНЕЦ Юдина Екатерина 06.10.2025 Выполнение задач №000055378
		
		Если НЕ Стр.Пометка Тогда
			Продолжить;
		КонецЕсли; 
		
		Результат = Истина;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.ДатаЗачета, 	 "Дата зачета",    "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].ДатаЗачета",  	  Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Контрагент, 	 "Контрагент",     "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Контрагент",	  Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Договор,		 "Договор", 	   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Договор",		  Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.СтатьяРасходов, "СтатьяРасходов", "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].СтатьяРасходов", Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Подразделение,  "Подразделение",  "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Подразделение",  Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Сумма, 		 "Сумма", 		   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Сумма",		  Сч) И Результат;
		
		Стр.РезультатПроверки 	= Результат;
		РезультатПроверки 		= РезультатПроверки ИЛИ Результат;
	КонецЦикла;
	
	Возврат РезультатПроверки;  
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизита(Значение, Имя, Поле, НомерСтроки = Неопределено)  
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина; 
	КонецЕсли; 
	
	ТекстСообщения	= ?(НомерСтроки <> Неопределено, "В строке №" + (НомерСтроки + 1) + " не ", "Не ") + "заполнено значение реквизита: " + Имя;
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле);
	
	Возврат Ложь; 
	
КонецФункции

