 
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)

	ОтборОрганизацияИспользование     = ЗначениеЗаполнено(ОтборОрганизация);
	УстановитьВосстановленныеОтборы();

КонецПроцедуры  

&НаКлиенте
Процедура ОтборОрганизацияИспользованиеПриИзменении(Элемент)
	
	УстановитьВосстановленныеОтборы();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтборКонтрагентПриИзменении(Элемент)
	
	ОтборКонтрагентИспользование     = ЗначениеЗаполнено(ОтборКонтрагент);
	УстановитьВосстановленныеОтборы();
  
КонецПроцедуры

&НаКлиенте
Процедура ОтборКонтрагентИспользованиеПриИзменении(Элемент)
	
	УстановитьВосстановленныеОтборы();

КонецПроцедуры

#КонецОбласти	

#Область ОбработчикиКомандФормы
   
&НаКлиенте
Процедура СоздатьНаОсновании(Команда)
	СтрокаКОформлению = Элементы.КОформлению.ТекущиеДанные;
	Если СтрокаКОформлению = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	СтруктураЗаполненияДокумента = СтруктураЗаполненияДокумента(); 
	ЗаполнитьЗначенияСвойств(СтруктураЗаполненияДокумента, СтрокаКОформлению); 
	СтруктураЗаполненияДокумента.Цедент 			= СтрокаКОформлению.Контрагент;
	СтруктураЗаполненияДокумента.Цессионарий 		= СтрокаКОформлению.Должник;   
	СтруктураЗаполненияДокумента.ДокументОснование	= СтрокаКОформлению.ИсходныйДокумент;
	СоздатьЦессию(СтруктураЗаполненияДокумента);
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции 
&НаКлиенте
Функция СтруктураЗаполненияДокумента()
	СтруктураЗаполнения = Новый Структура;
	
	СтруктураЗаполнения.Вставить("ИсходныйДокумент");
	СтруктураЗаполнения.Вставить("ДокументОснование");
	СтруктураЗаполнения.Вставить("ТипДокумента");
	СтруктураЗаполнения.Вставить("СуммаДокумента");  
	СтруктураЗаполнения.Вставить("Контрагент");
	СтруктураЗаполнения.Вставить("Цедент");
	СтруктураЗаполнения.Вставить("Цессионарий");
	СтруктураЗаполнения.Вставить("Организация");
	СтруктураЗаполнения.Вставить("ВалютаДокумента");  
	СтруктураЗаполнения.Вставить("ИсходныйДоговор"); 
	СтруктураЗаполнения.Вставить("Должник"); 
	СтруктураЗаполнения.Вставить("СуммаОбязательства"); 	
	
    Возврат СтруктураЗаполнения;
КонецФункции // ()

&НаКлиенте
Процедура СоздатьЦессию(СтруктураЗаполнения)
	
	ПараметрыФормы = Новый Структура("Основание", СтруктураЗаполнения); 
	ОписаниОповещения = Новый ОписаниеОповещения("ПослеСозданияЦессии", ЭтотОбъект);
	Если СтруктураЗаполнения.ТипДокумента = "Цессия входящая" Тогда
		ОткрытьФорму("Документ.ЦессияВходящая.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Документ.ЦессияДолжника.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ПослеСозданияЦессии(Результат, ДополнительныеПараметры) Экспорт

	Элементы.КОформлению.Обновить();

КонецПроцедуры

&НаСервере
Процедура УстановитьВосстановленныеОтборы()
	
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "Организация");
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "Контрагент");
	
КонецПроцедуры

#КонецОбласти