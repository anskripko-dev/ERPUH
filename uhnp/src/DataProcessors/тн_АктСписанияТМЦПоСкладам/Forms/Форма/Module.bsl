
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Отказ = Ложь;
	
	//1. проверяем заполненность параметров 
	Если Не ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Период""");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Организация""");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Склад""");
		Отказ = Истина;
	КонецЕсли;     
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//2. Заполнение макета
	СформироватьПечатнуюФормуНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПечатнуюФормуНаСервере()
	
	ТабличныйДокументРезультат.Очистить();
	ТабличныйДокументРезультат.Автомасштаб = Истина;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОсновнойМакет	= ОбработкаОбъект.ПолучитьМакет("Макет"); 
	
	КонецПериода  = Период.ДатаОкончания;
	Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Подразделение");
	
	//данные документа тн_ПодписиВПриказах
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация", Организация); 
	
	СписокВидовПодписей = Новый СписокЗначений;
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.Руководитель);
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюПрочихТМЦ);
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюПрочихТМЦ);
	ПараметрыОтбора.Вставить("ВидПодписи", СписокВидовПодписей);
	
	//получаем с учетом подразделения; если не нашли по подразделению, то не учитываем его 
	СписокПодразделений = Новый СписокЗначений;
	СписокПодразделений.Добавить(Справочники.СтруктураПредприятия.ПустаяСсылка());
	СписокПодразделений.Добавить(Подразделение);
	ПараметрыОтбора.Вставить("Подразделение", СписокПодразделений);
	
	Данные_ПодписиВПриказах = РегистрыСведений.тн_СведенияОПодписяхВПриказах.НастройкиСведенийОПодписяхВПриказах(КонецПериода, ПараметрыОтбора);
	
	//данные для таблицы
	ТЗАктаСписания	= ДанныеАктаСписанияТМЦПоСкладам();
	
	//ШАПКА
	ОбластьШапка = ОсновнойМакет.ПолучитьОбласть("Шапка");
	
	СведенияОбОрганизации	= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, КонецПериода);
	ОбластьШапка.Параметры.ПолноеПредставлениеОрганизации = СведенияОбОрганизации.ПолноеНаименование + Символы.ПС
									+ " ИНН: " + СведенияОбОрганизации.ИНН + ", КПП: " + СведенияОбОрганизации.КПП + " " + Символы.ПС
									+ СведенияОбОрганизации.ЮридическийАдрес;
	
	ОбластьШапка.Параметры.Дата = Формат(КонецПериода, "ДЛФ=DD");
	ОбластьШапка.Параметры.ПериодФормирования = НРег(Формат(КонецПериода,"ДФ=ММММ")) +" " +Формат(КонецПериода,"ДФ=гггг") + " г. ";	
		
    // ДиректорДолжность, Директор - Руководитель
	Данные_Руководитель = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
									Перечисления.тн_ВидыПодписейПоПриказам.Руководитель, Подразделение));
	Если Данные_Руководитель.Количество() = 0 Тогда
		Данные_Руководитель = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
							Перечисления.тн_ВидыПодписейПоПриказам.Руководитель, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли; 
	Если Данные_Руководитель.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Руководитель""!");	
	Иначе
		ОбластьШапка.Параметры.ДиректорДолжность = Данные_Руководитель[0].Должность;
		ОбластьШапка.Параметры.Директор = Данные_Руководитель[0].ФИОвПодписи;	
	КонецЕсли;    
	
	// ФИОПредседателя, ФИОЧленаКомиссии, ПриказТвП - ПредседательКомиссииПоСписаниюПрочихТМЦ 
	Данные_ПредседательКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюПрочихТМЦ, Подразделение));
	Если Данные_ПредседательКомиссии.Количество() = 0 Тогда
		Данные_ПредседательКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюПрочихТМЦ, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли;
	Если Данные_ПредседательКомиссии.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Председатель комиссии по списанию прочих ТМЦ""!");	
	Иначе
		ОбластьШапка.Параметры.ФИОПредседателя = Данные_ПредседательКомиссии[0].ФИОвПодписи; 
		ОбластьШапка.Параметры.ПриказТвП = Данные_ПредседательКомиссии[0].Приказ;
	КонецЕсли;  
	
	// ФИОЧленаКомиссии - ЧленКомиссииПоСписаниюПрочихТМЦ - выводим всех через запятую
	Данные_ЧленыКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюПрочихТМЦ, Подразделение));
	Если Данные_ЧленыКомиссии.Количество() = 0 Тогда
		Данные_ЧленыКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюПрочихТМЦ, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли;
	Если Данные_ЧленыКомиссии.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Член комиссии по списанию прочих ТМЦ""!");	
	Иначе  
		ФИОЧленаКомиссии = "";
		Для Каждого ЧленКомиссии Из Данные_ЧленыКомиссии Цикл 
			ФИОЧленаКомиссии = ФИОЧленаКомиссии  + ЧленКомиссии.ФИОвПодписи + ", "; 
		КонецЦикла;
		ОбластьШапка.Параметры.ФИОЧленаКомиссии = Лев(ФИОЧленаКомиссии,СтрДлина(ФИОЧленаКомиссии)-2); 
	КонецЕсли; 
	
	ОбластьШапка.Параметры.Склад		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Наименование"); 
    ОбластьШапка.Параметры.Организация	=  СведенияОбОрганизации.ПолноеНаименование;
 
	
	ТабличныйДокументРезультат.Вывести(ОбластьШапка);
	
	//СТРОКА
	ОбластьСтрока = ОсновнойМакет.ПолучитьОбласть("Строка");
	НомерПоПорядку	= 1;
	Для Каждого СтрокаТЗ Из ТЗАктаСписания Цикл		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТЗ); 
		ОбластьСтрока.Параметры.Номер	= НомерПоПорядку;
		
		ТабличныйДокументРезультат.Вывести(ОбластьСтрока); 
		 
		НомерПоПорядку	= НомерПоПорядку + 1;		
	КонецЦикла;	
	
	//ПРЕДСЕДАТЕЛЬ КОМИССИИ 
	Область = ОсновнойМакет.ПолучитьОбласть("ПредседательКомиссии");	
	Если Данные_ПредседательКомиссии.Количество() > 0 Тогда
		Область.Параметры.ФИОПредседателя = Данные_ПредседательКомиссии[0].ФИОвПодписи;
		Область.Параметры.ДолжностьПредседателя = Данные_ПредседательКомиссии[0].Должность;		
	КонецЕсли;
	ТабличныйДокументРезультат.Вывести(Область);	
	
	//ЧЛЕНЫ КОМИССИИ
	Область = ОсновнойМакет.ПолучитьОбласть("ЧленыКомиссии");	
	ЭтоПервыйЧК = Истина;  
	Если Данные_ЧленыКомиссии.Количество()=0 Тогда
		ТабличныйДокументРезультат.Вывести(Область);
	Иначе
		Для Каждого ЧК Из Данные_ЧленыКомиссии Цикл 	
			Область.Параметры.ЗаголовокЧленыКомиссии = ?(ЭтоПервыйЧК,"Члены комиссии:","");
			Область.Параметры.ФИОЧленаКомиссии = ЧК.ФИОвПодписи;
			Область.Параметры.ДолжностьЧленаКомиссии = ЧК.Должность;		
			ТабличныйДокументРезультат.Вывести(Область); 	
			ЭтоПервыйЧК = Ложь;
		КонецЦикла;   
	КонецЕсли;
	
КонецПроцедуры

&НаСервере                   
Функция ДанныеАктаСписанияТМЦПоСкладам()
	
	Запрос =  Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры, 
				   //НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087
	               //|	СебестоимостьТоваров.СтатьяРасходовСписания КАК СтатьяЗатрат,
				   |	ВЫБОР 
				   |		КОГДА СебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаМатериаловВКладовую)
				   |			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.тн_МатериальныеЗатраты) 
			   	   |		ИНАЧЕ СебестоимостьТоваров.СтатьяРасходовСписания 
				   |	КОНЕЦ КАК СтатьяЗатрат,
				   |	СебестоимостьТоваров.ХозяйственнаяОперация КАК ХозяйственнаяОперацияВРегистре, 
				   //КОНЕЦ Качикина 19.03.2026 Выполнение задач №000057087
	               |	СебестоимостьТоваров.Количество КАК Количество,
	               |	СебестоимостьТоваров.СтоимостьРегл КАК Сумма,
	               |	ВЫРАЗИТЬ(СебестоимостьТоваров.Регистратор КАК Документ.ВнутреннееПотребление) КАК Регистратор
	               |ПОМЕСТИТЬ втСебестоимостьТоваров
	               |ИЗ
	               |	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
	               |ГДЕ
	               |	СебестоимостьТоваров.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	И СебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	               |	И СебестоимостьТоваров.Организация = &Организация 
				   //НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087
				   //|	И СебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СписаниеТоваровПоТребованию)
				   //|	//ОТБОР_СтатьяЗатрат_  
				   |	И СебестоимостьТоваров.ХозяйственнаяОперация В (&СписокОпераций)
				   //КОНЕЦ Качикина 19.03.2026 Выполнение задач №000057087
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	СУММА(втСебестоимостьТоваров.Количество) КАК Количество,
	               |	СУММА(втСебестоимостьТоваров.Сумма) КАК Сумма,
	               |	втСебестоимостьТоваров.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	ВЫБОР  
				   //НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087 
				   |		КОГДА втСебестоимостьТоваров.ХозяйственнаяОперацияВРегистре = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаМатериаловВКладовую)
				   |			ТОГДА ""Ремонт оборудования линии""
				   //КОНЕЦ Качикина 19.03.2026 Выполнение задач №000057087
	               |		КОГДА ВнутреннееПотребление.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СписаниеТоваровПоТребованию)
	               |			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ВнутреннееПотребление.Комментарий КАК СТРОКА(250)), """")
	               |		КОГДА ВнутреннееПотребление.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаВЭксплуатацию)
	               |			ТОГДА ""Передано в эксплуатацию""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК Причина
	               |ИЗ
	               |	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
	               |		ПО втСебестоимостьТоваров.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
	               |			И (КлючиАналитикиУчетаНоменклатуры.МестоХранения = &Склад)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотребление КАК ВнутреннееПотребление
	               |		ПО втСебестоимостьТоваров.Регистратор = ВнутреннееПотребление.Ссылка 
				   //НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087                           
				   |ГДЕ 
				   |    ИСТИНА
				   |	//ОТБОР_СтатьяЗатрат_
				   //КОНЕЦ Качикина 19.03.2026 Выполнение задач №000057087
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КлючиАналитикиУчетаНоменклатуры.Номенклатура,
	               |	втСебестоимостьТоваров.СтатьяЗатрат,
	               |	ВЫБОР
				   //НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087 
				   |		КОГДА втСебестоимостьТоваров.ХозяйственнаяОперацияВРегистре = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаМатериаловВКладовую)
				   |			ТОГДА ""Ремонт оборудования линии""
				   //КОНЕЦ Качикина 19.03.2026 Выполнение задач №000057087
	               |		КОГДА ВнутреннееПотребление.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СписаниеТоваровПоТребованию)
	               |			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ВнутреннееПотребление.Комментарий КАК СТРОКА(250)), """")
	               |		КОГДА ВнутреннееПотребление.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаВЭксплуатацию)
	               |			ТОГДА ""Передано в эксплуатацию""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ втСебестоимостьТоваров";
		
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);  
	Запрос.УстановитьПараметр("Склад", Склад); 
	//НАЧАЛО Качикина 19.03.2026 Выполнение задач №000057087
	СписокОпераций = Новый СписокЗначений;
	СписокОпераций.Добавить(Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию);
	СписокОпераций.Добавить(Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую);
	Запрос.УстановитьПараметр("СписокОпераций", СписокОпераций);
