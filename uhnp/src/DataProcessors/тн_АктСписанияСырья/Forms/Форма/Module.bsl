#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Значения по-умолчанию 
	Если СтатьиКалькуляции.Количество()=0 Тогда 
		СтатьиКалькуляции.Добавить(Справочники.СтатьиКалькуляции.тн_ВспомогательноеСырье);
		СтатьиКалькуляции.Добавить(Справочники.СтатьиКалькуляции.тн_ОсновноеСырье); 
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПричинаСписания) Тогда 
		ПричинаСписания = "Выпуск ГП";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	Отказ = Ложь;
	
	//1. проверяем заполненность параметров 
	Если Не ЗначениеЗаполнено(Период) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Период""");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Организация""");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен параметр ""Подразделение""");
		Отказ = Истина;
	КонецЕсли;     
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//2. Заполнение макета
	СформироватьПечатнуюФормуНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьПечатнуюФормуНаСервере()
	
	ТабличныйДокументРезультат.Очистить();
	ТабличныйДокументРезультат.Автомасштаб = Истина;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОсновнойМакет = ОбработкаОбъект.ПолучитьМакет("Макет"); 
	
	КонецПериода = Период.ДатаОкончания;
	
	//данные документа тн_ПодписиВПриказах
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация", Организация); 
	
	СписокВидовПодписей = Новый СписокЗначений;
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.Руководитель);
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюМатериалов);
	СписокВидовПодписей.Добавить(Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюМатериалов);
	ПараметрыОтбора.Вставить("ВидПодписи", СписокВидовПодписей);
	
	//получаем с учетом подразделения; если не нашли по подразделению, то не учитываем его
	СписокПодразделений = Новый СписокЗначений;
	СписокПодразделений.Добавить(Справочники.СтруктураПредприятия.ПустаяСсылка());
	СписокПодразделений.Добавить(Подразделение);
	ПараметрыОтбора.Вставить("Подразделение", СписокПодразделений);
	
	Данные_ПодписиВПриказах = РегистрыСведений.тн_СведенияОПодписяхВПриказах.НастройкиСведенийОПодписяхВПриказах(КонецПериода, ПараметрыОтбора);
	
	//данные для таблицы
	ТЗАктаСписания	= ДанныеАктаСписания();
	
	//ШАПКА
	ОбластьШапка = ОсновнойМакет.ПолучитьОбласть("Шапка");
	
	СведенияОбОрганизации	= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, КонецПериода);
	ОбластьШапка.Параметры.ПолноеПредставлениеОрганизации = СведенияОбОрганизации.ПолноеНаименование + Символы.ПС
									+ " ИНН: " + СведенияОбОрганизации.ИНН + ", КПП: " + СведенияОбОрганизации.КПП + " " + Символы.ПС
									+ СведенияОбОрганизации.ЮридическийАдрес;
	
	ОбластьШапка.Параметры.Дата = Формат(КонецПериода, "ДЛФ=DD");
	ОбластьШапка.Параметры.ПодразделениеОрганизации = Подразделение;
	ОбластьШапка.Параметры.ПериодФормирования = НРег(Формат(КонецПериода,"ДФ=ММММ")) +" " +Формат(КонецПериода,"ДФ=гггг") + " г. ";
	
		
    // ДиректорДолжность, Директор - Руководитель
	Данные_Руководитель = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
									Перечисления.тн_ВидыПодписейПоПриказам.Руководитель, Подразделение));
	Если Данные_Руководитель.Количество() = 0 Тогда
		Данные_Руководитель = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
							Перечисления.тн_ВидыПодписейПоПриказам.Руководитель, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли; 
	Если Данные_Руководитель.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Руководитель""!");	
	Иначе
		ОбластьШапка.Параметры.ДиректорДолжность = Данные_Руководитель[0].Должность;
		ОбластьШапка.Параметры.Директор = Данные_Руководитель[0].ФИОвПодписи;	
	КонецЕсли;    
	
	// ФИОПредседателя, ФИОЧленаКомиссии, ПриказТвП - ПредседательКомиссииПоСписаниюМатериалов 
	Данные_ПредседательКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюМатериалов, Подразделение));
	Если Данные_ПредседательКомиссии.Количество() = 0 Тогда
		Данные_ПредседательКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ПредседательКомиссииПоСписаниюМатериалов, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли;
	Если Данные_ПредседательКомиссии.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Председатель комиссии по списанию материалов""!");	
	Иначе
		ОбластьШапка.Параметры.ФИОПредседателя = Данные_ПредседательКомиссии[0].ФИОвПодписи; 
		ОбластьШапка.Параметры.ПриказТвП = Данные_ПредседательКомиссии[0].Приказ;
	КонецЕсли;  
	
	// ФИОЧленаКомиссии - ЧленКомиссииПоСписаниюМатериалов - выводим всех через запятую
	Данные_ЧленыКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюМатериалов, Подразделение));
	Если Данные_ЧленыКомиссии.Количество() = 0 Тогда
		Данные_ЧленыКомиссии = Данные_ПодписиВПриказах.НайтиСтроки(Новый Структура("ВидПодписи, Подразделение",
								Перечисления.тн_ВидыПодписейПоПриказам.ЧленКомиссииПоСписаниюМатериалов, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	КонецЕсли;
	Если Данные_ЧленыКомиссии.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не найдены данные по виду подписи ""Член комиссии по списанию материалов""!");	
	Иначе  
		ФИОЧленаКомиссии = "";
		Для Каждого ЧленКомиссии Из Данные_ЧленыКомиссии Цикл 
			ФИОЧленаКомиссии = ФИОЧленаКомиссии  + ЧленКомиссии.ФИОвПодписи + ", "; 
		КонецЦикла;
		ОбластьШапка.Параметры.ФИОЧленаКомиссии = Лев(ФИОЧленаКомиссии,СтрДлина(ФИОЧленаКомиссии)-2); 
	КонецЕсли;
	
	ТабличныйДокументРезультат.Вывести(ОбластьШапка);
	
	//СТРОКА
	ОбластьСтрока = ОсновнойМакет.ПолучитьОбласть("Строка");
	 
	СуммаИтого		= 0;
	НомерПоПорядку	= 1;
	Для Каждого СтрокаТЗ Из ТЗАктаСписания Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТЗ); 
		ОбластьСтрока.Параметры.Номер	= НомерПоПорядку;
		ОбластьСтрока.Параметры.Причина = ПричинаСписания;
		
		ТабличныйДокументРезультат.Вывести(ОбластьСтрока); 
		
		СуммаИтого		= СуммаИтого + СтрокаТЗ.Сумма; 
		НомерПоПорядку	= НомерПоПорядку + 1;
		
	КонецЦикла;
	
	//СТРОКА ИТОГО
	Область = ОсновнойМакет.ПолучитьОбласть("СтрокаИтого");	
	Область.Параметры.СуммаИтого = Формат(СуммаИтого, "ЧДЦ=2");
	ТабличныйДокументРезультат.Вывести(Область);	
	
	//ПРЕДСЕДАТЕЛЬ КОМИССИИ 
	Область = ОсновнойМакет.ПолучитьОбласть("ПредседательКомиссии");	
	Если Данные_ПредседательКомиссии.Количество() > 0 Тогда
		Область.Параметры.ФИОПредседателя = Данные_ПредседательКомиссии[0].ФИОвПодписи;
		Область.Параметры.ДолжностьПредседателя = Данные_ПредседательКомиссии[0].Должность;		
	КонецЕсли;
	ТабличныйДокументРезультат.Вывести(Область);	
	
	//ЧЛЕНЫ КОМИССИИ
	Область = ОсновнойМакет.ПолучитьОбласть("ЧленыКомиссии");	
	ЭтоПервыйЧК = Истина; 
	Если Данные_ЧленыКомиссии.Количество()=0 Тогда
		ТабличныйДокументРезультат.Вывести(Область);
	Иначе	
		Для Каждого ЧК Из Данные_ЧленыКомиссии Цикл 	
			Область.Параметры.ЗаголовокЧленыКомиссии = ?(ЭтоПервыйЧК,"Члены комиссии:","");
			Область.Параметры.ФИОЧленаКомиссии = ЧК.ФИОвПодписи;
			Область.Параметры.ДолжностьЧленаКомиссии = ЧК.Должность;
			ТабличныйДокументРезультат.Вывести(Область); 
			ЭтоПервыйЧК = Ложь;
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеАктаСписания()
	
	Запрос =  Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	СебестоимостьТоваров.СтатьяКалькуляции КАК CтатьяЗатрат,
	               |	СУММА(СебестоимостьТоваров.Количество) КАК Количество,
				   //НАЧАЛО Качикина 09.04.2026 Выполнение задач №000057328
	               //|	СУММА(СебестоимостьТоваров.СтоимостьРегл) КАК Сумма
				   |	СУММА(СебестоимостьТоваров.СтоимостьРегл + СебестоимостьТоваров.ДопРасходыРегл + СебестоимостьТоваров.ТрудозатратыРегл + СебестоимостьТоваров.ПостатейныеПостоянныеРегл + СебестоимостьТоваров.ПостатейныеПеременныеРегл) КАК Сумма
				   //КОНЕЦ Качикина 09.04.2026 Выполнение задач №000057328
	               |ПОМЕСТИТЬ втСебестоимостьТоваров
	               |ИЗ
	               |	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
	               |ГДЕ
	               |	СебестоимостьТоваров.Период МЕЖДУ &НачалоПериода И &КонецПериода  
				   |	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) 
	               |	И СебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
				   |	И СебестоимостьТоваров.Организация = &Организация
	               |	И СебестоимостьТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукции)
	               |	И СебестоимостьТоваров.ТипЗаписи = ЗНАЧЕНИЕ(Перечисление.ТипыЗаписейПартий.СписанияНаВыпуск) 
				   |	//ОТБОР_СтатьяКалькуляции
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СебестоимостьТоваров.АналитикаУчетаНоменклатуры,
	               |	СебестоимостьТоваров.СтатьяКалькуляции
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕСТЬNULL(КлючиАналитикиУчетаНоменклатуры.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
				   //НАЧАЛО Качикина 20.05.2026 Выполнение задач №000057717
				   //|	втСебестоимостьТоваров.Количество КАК Количество,
				   |ВЫБОР
				   |	КОГДА ЕСТЬNULL(СправочникНоменклатура.тн_КоэффициентБазовойЕдиницыИзмерения,0) = 0
				   |		ТОГДА 0
				   |	ИНАЧЕ ВЫРАЗИТЬ(втСебестоимостьТоваров.Количество/ЕСТЬNULL(СправочникНоменклатура.тн_КоэффициентБазовойЕдиницыИзмерения,0) КАК ЧИСЛО(15,2)) 
				   |КОНЕЦ КАК Количество,	
				   //КОНЕЦ Качикина 20.05.2026 Выполнение задач №000057717
	               |	втСебестоимостьТоваров.Сумма КАК Сумма,
	               |	втСебестоимостьТоваров.CтатьяЗатрат КАК CтатьяЗатрат
	               |ИЗ
	               |	втСебестоимостьТоваров КАК втСебестоимостьТоваров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
				    //НАЧАЛО Качикина 20.05.2026 Выполнение задач №000057717
				   |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
				   |				ПО КлючиАналитикиУчетаНоменклатуры.Номенклатура = СправочникНоменклатура.Ссылка
				   //КОНЕЦ Качикина 20.05.2026 Выполнение задач №000057717
				   |		ПО втСебестоимостьТоваров.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка 
				   |			И (КлючиАналитикиУчетаНоменклатуры.Подразделение = &Подразделение)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ втСебестоимостьТоваров";
		
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Подразделение", Подразделение); 
	Если ЗначениеЗаполнено(СтатьиКалькуляции) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"//ОТБОР_СтатьяКалькуляции","И СебестоимостьТоваров.СтатьяКалькуляции В (&СтатьиКалькуляции)");	
		Запрос.УстановитьПараметр("СтатьиКалькуляции", СтатьиКалькуляции);
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ; 
	
КонецФункции

#КонецОбласти 
