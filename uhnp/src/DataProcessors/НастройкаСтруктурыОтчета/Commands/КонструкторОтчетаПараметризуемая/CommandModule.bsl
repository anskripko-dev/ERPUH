
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПараметрКоманды, "ЭтоГруппа") Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо выбрать элемент, а не группу'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ВидОтчета", ПараметрКоманды);
	ОткрытьФорму("Обработка.НастройкаСтруктурыОтчета.Форма.ФормаКонструктора", 
		ПараметрыФормы, 
		ПараметрыВыполненияКоманды.Источник, 
		ПараметрыВыполненияКоманды.Уникальность, 
		ПараметрыВыполненияКоманды.Окно, 
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);

КонецПроцедуры
