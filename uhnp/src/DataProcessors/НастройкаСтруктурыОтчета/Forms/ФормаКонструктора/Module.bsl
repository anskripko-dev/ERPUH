&НаСервере
Процедура ПриОтображенииИсходныхДанных()
	
	Элементы.ТипИсходныхДанных.СписокВыбора.Очистить();
	Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("ОстаткиИОбороты",Нстр("ru = 'Остатки и обороты по счетам'"));
	Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("Корреспонденция",Нстр("ru = 'Корреспонденции счетов'"));
	Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("ПоказателиОтчетов",Нстр("ru = 'Значения показателей отчетов'"));
	Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("Шаблоны",Нстр("ru = 'Шаблоны источников данных'"));
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		
		Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("ХозяйственныеОперации",Нстр("ru = 'Хозяйственные операции'"));
		Элементы.ТипИсходныхДанных.СписокВыбора.Добавить("ФинансовыеРегистры",Нстр("ru = 'Финансовые регистры'")); 
				
	КонецЕсли;
		
	ТипИсходныхДанныхПриИзмененииНаСервере();
	УстановитьШиринуКолонки(ПолеТабличногоДокументаМакет);
	
КонецПроцедуры // ПриОтображенииИсходныхДанных() 

&НаКлиенте
Процедура ТипИсходныхДанныхПриИзменении(Элемент)
	
	Если (ТипИсходныхДанных="ОстаткиИОбороты"
		ИЛИ ТипИсходныхДанных="Корреспонденция")
		И (НЕ ЗначениеЗаполнено(ПланСчетов)) Тогда
		
		ОпределитьПараметрыИсходныхДанных();
		
		Если НЕ ЗначениеЗаполнено(ПланСчетов) Тогда
			
			ПоказатьПредупреждение(,СтрШаблон(Нстр("ru = 'Для правила обработки %1 не указан план счетов, используемый по умолчанию.'"),ПравилоОбработки));
			ТипИсходныхДанных="ПоказателиОтчетов";
			
		КонецЕсли;
			
	КонецЕсли;
			
	ТипИсходныхДанныхПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсходныеДанные(Команда)
	
	Элементы.ФормаПоказатьИсходныеДанные.Пометка=Не Элементы.ФормаПоказатьИсходныеДанные.Пометка;
	Элементы.ГруппаИсходныеДанные.Видимость=Элементы.ФормаПоказатьИсходныеДанные.Пометка;
	
	Если Элементы.ГруппаИсходныеДанные.Видимость Тогда
		
		ПриОтображенииИсходныхДанных();	
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПоСубсчетам(Команда)
	
	Элементы.ПоСубсчетам.Пометка=Не Элементы.ПоСубсчетам.Пометка;
	ЗаполнитьТаблицуКорреспонденций();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТабДокВыборПоказателя()
			
	Колонки = СформироватьТаблицуКолонокБланка(ВидОтчетаОтбор);
	ЗначениеВРеквизитФормы(Колонки, "тКолонкиОтбор");	
	ВывестиДеревоСтруктурыСтрокОтбор(ВидОтчетаОтбор, Колонки);
	
КонецПроцедуры

&НаСервере
Процедура ВидОтчетаОтборПриИзмененииНаСервере()
	
	ВидОтчетаОтборКод=СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтчетаОтбор,"Код"));	
 	ЗаполнитьТабДокВыборПоказателя();

КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаОтборПриИзменении(Элемент)
	ВидОтчетаОтборПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВывестиДеревоСтруктурыСтрокОтбор(ВидОтчетаВход, ТаблицаКолонокВход = Неопределено) Экспорт
	
	РезультатФункции 		= Новый ДеревоЗначений;
			
	РезультатФункции.Колонки.Добавить("Строка");
	РезультатФункции.Колонки.Добавить("ПорядковыйНомер",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0));
	РезультатФункции.Колонки.Добавить("СтрокаНаименование",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(150));
	РезультатФункции.Колонки.Добавить("СтрокаКод");
	РезультатФункции.Колонки.Добавить("СтрокаГруппаРаскрытия");
	РезультатФункции.Колонки.Добавить("АналитикаВалюта");
	РезультатФункции.Колонки.Добавить("СтрокаПометкаНаУдаление");
	
	РезультатФункции.Колонки.Добавить("СчетБД");
	РезультатФункции.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
	РезультатФункции.Колонки.Добавить("СтатьяДоходовИРасходов");
	РезультатФункции.Колонки.Добавить("СтатьяДвиженияРесурсов");
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтрокиОтчетов.Ссылка КАК Ссылка,
	|	СтрокиОтчетов.Код КАК СтркаКод,
	|	СтрокиОтчетов.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	СтрокиОтчетов.ПорядковыйНомер КАК ПорядковыйНомер
	|ПОМЕСТИТЬ втМакетСтрок
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.Владелец = &ВидОтчета
	|	И СтрокиОтчетов.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КолонкиОтчетов.Ссылка КАК Ссылка,
	|	КолонкиОтчетов.ПорядковыйНомер КАК ПорядковыйНомер
	|ПОМЕСТИТЬ втМакетКолонок
	|ИЗ
	|	Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	|ГДЕ
	|	КолонкиОтчетов.Владелец = &ВидОтчета
	|	И КолонкиОтчетов.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоказателиОтчетов.Ссылка КАК Ссылка,
	|	ПоказателиОтчетов.Колонка КАК Колонка,
	|	ПоказателиОтчетов.Строка КАК Строка
	|ПОМЕСТИТЬ втПоказатели
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Владелец = &ВидОтчета
	|	И ПоказателиОтчетов.ПометкаУдаления = Ложь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втМакетКолонок.Ссылка КАК КолонкаСсылка,
	|	втМакетКолонок.ПорядковыйНомер КАК КолонкаПорядковыйНомер,
	|	втМакетСтрок.Ссылка КАК СтрокаСсылка,
	|	втМакетСтрок.СтркаКод КАК СтрокаКод,
	|	втМакетСтрок.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	втМакетСтрок.ПорядковыйНомер КАК СтрокаКолонкаПорядковыйНомер
	|ПОМЕСТИТЬ втМакет
	|ИЗ
	|	втМакетСтрок КАК втМакетСтрок
	|		ЛЕВОЕ СОЕДИНЕНИЕ втМакетКолонок КАК втМакетКолонок
	|		ПО (ИСТИНА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втМакет.КолонкаСсылка КАК КолонкаСсылка,
	|	втМакет.КолонкаПорядковыйНомер КАК КолонкаПорядковыйНомер,
	|	втМакет.СтрокаСсылка КАК СтрокаСсылка,
	|	втМакет.СтрокаКод КАК СтрокаКод,
	|	втМакет.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	втМакет.СтрокаКолонкаПорядковыйНомер КАК СтрокаКолонкаПорядковыйНомер,
	|	втПоказатели.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втМакетСКолонками
	|ИЗ
	|	втМакет КАК втМакет
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПоказатели КАК втПоказатели
	|		ПО втМакет.СтрокаСсылка = втПоказатели.Строка
	|			И втМакет.КолонкаСсылка = втПоказатели.Колонка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	0 КАК НПП,
	|	СтрокиОтчетов.Ссылка КАК Ссылка,
	|	СтрокиОтчетов.Код КАК СтрокаКод, 
	|	МАКСИМУМ(СтрокиОтчетов.Ссылка) КАК Строка,
	|	СтрокиОтчетов.Наименование КАК СтрокаНаименование,
	|	СтрокиОтчетов.ГруппаРаскрытия КАК СтрокаГруппаРаскрытия,
	|	СтрокиОтчетов.ГруппаРаскрытия.ВидАналитикиВалютаДт КАК АналитикаВалюта,
	|	СтрокиОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
	|	МАКСИМУМ(СтрокиОтчетов.СчетБД) КАК СчетБД,
	|	МАКСИМУМ(СтрокиОтчетов.СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
	|	МАКСИМУМ(СтрокиОтчетов.СтатьяДоходовИРасходов) КАК СтатьяДоходовИРасходов,
	|	МАКСИМУМ(СтрокиОтчетов.СтатьяДвиженияРесурсов) КАК СтатьяДвиженияРесурсов,
	|	МАКСИМУМ(СтрокиОтчетов.ПометкаУдаления) КАК СтрокаПометкаНаУдаление,
	|	СтрокиОтчетов.Родитель КАК Родитель
	|ИЗ
	|	втМакетСКолонками КАК втМакетСКолонками
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|		ПО втМакетСКолонками.СтрокаСсылка = СтрокиОтчетов.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиОтчетов.Ссылка,
	|	СтрокиОтчетов.Код,
	|	СтрокиОтчетов.ГруппаРаскрытия,
	|	СтрокиОтчетов.ПорядковыйНомер,
	|	СтрокиОтчетов.Родитель,
	|	втМакетСКолонками.КолонкаПорядковыйНомер,
	|	СтрокиОтчетов.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокиОтчетов.ПорядковыйНомер ИЕРАРХИЯ,
	|	втМакетСКолонками.КолонкаПорядковыйНомер";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	
	ИндексКолонки = 1;
	
	Для Каждого СтрКолонка Из ТаблицаКолонокВход Цикл
		
		Нполе = СхемаЗапроса.ПакетЗапросов[4].Операторы[0].ВыбираемыеПоля.Добавить("ВЫБОР КОГДА ВтМакет.КолонкаСсылка = &Парам_"+СокрЛП(СтрКолонка.Код)+
		" ТОГДА """" КОНЕЦ ");
		
		Запрос.УстановитьПараметр("Парам_"+СокрЛП(СтрКолонка.Код),СтрКолонка.Ссылка);
		СхемаЗапроса.ПакетЗапросов[4].Колонки[СхемаЗапроса.ПакетЗапросов[4].Колонки.Количество()-1].Псевдоним = СокрЛП(СтрКолонка.Код);
		
		Нполе = СхемаЗапроса.ПакетЗапросов[5].Операторы[0].ВыбираемыеПоля.Добавить("МАКСИМУМ("+СокрЛП(СтрКолонка.Код)+") ");
		СхемаЗапроса.ПакетЗапросов[5].Колонки[СхемаЗапроса.ПакетЗапросов[5].Колонки.Количество()-1].Псевдоним = "Колонка"+ИндексКолонки;//СокрЛП(СтрКолонка.Код);
		
		РезультатФункции.Колонки.Добавить("Колонка"+ИндексКолонки,ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(50));	
		
		СтрКолонка.тИмя = СокрЛП("Колонка"+ИндексКолонки);
		
		ИндексКолонки = ИндексКолонки+1;
		
	КонецЦикла;	
	
	Запрос.Текст =  СхемаЗапроса.ПолучитьТекстЗапроса();	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчетаВход);
		
	РезультатПакет 			= Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	РезультатПоказатели     = РезультатПакет[2].Выгрузить();
	РезультатПоказатели.Индексы.Добавить("Строка,Колонка");
		
	Результат=РезультатПакет[5].Выбрать();
	
	ТабДокВыборПоказателя.Очистить();
	СтруктураШаблонов = РасширениеБизнесЛогикиУХ.ПодготовитьМакетШаблоновВывода(тКолонкиОтбор);
	
	ТабДокВыборПоказателя.Вывести(СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонЗаголовка.ПолучитьОбласть("ШаблонВыводаЗаголовка"));
	
	ВыводимаяСтрокаОтчета=Справочники.СтрокиОтчетов.ПустаяСсылка();
	
	СоответствиеСтрок=Новый Соответствие;
	СоответствиеРодителей=Новый Соответствие;
	
	ДеревоНастройкиСервер_Строки = РезультатФункции.Строки.Добавить();
	ДеревоНастройкиСервер_Строки.Строка 			= Нстр("ru = 'Выбранные строки'");
	ДеревоНастройкиСервер_Строки.СтрокаНаименование = Нстр("ru = 'Строки/Колонки'");	
	
	//Предварительный вывод в дерево значений
	Пока Результат.Следующий() Цикл
		
		Если Результат.Строка<>ВыводимаяСтрокаОтчета Тогда     //Поменялась строка
			
			ТекущаяСтрокаДерева=СоответствиеСтрок[Результат.Строка];
			
			Если ТекущаяСтрокаДерева=Неопределено Тогда   //Не было такой строки
				
				Если Результат.Родитель=Справочники.СтрокиОтчетов.ПустаяСсылка() Тогда   //Строка первого уровня
					
					ТекущаяСтрокаДерева=ДеревоНастройкиСервер_Строки.Строки.Добавить();
					
				Иначе
					
					СтрокаРодитель=СоответствиеРодителей[Результат.Родитель];   //ищем был ли уже такой родитель выведен
					
					Если СтрокаРодитель=Неопределено Тогда
						
						СтрокаРодитель=РезультатФункции.Строки.Найти(Результат.Родитель, "Строка", Истина);
						СоответствиеРодителей.Вставить(Результат.Родитель,СтрокаРодитель);
						
						ТабДокВыборПоказателя.НачатьГруппуСтрок();
						
					КонецЕсли;
					
					ТекущаяСтрокаДерева=СтрокаРодитель.Строки.Добавить();
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ТекущаяСтрокаДерева,Результат); //Выводим строку и значения колонок показателей по ней
				
				СоответствиеСтрок.Вставить(Результат.Строка,ТекущаяСтрокаДерева);	
			КонецЕсли;
			
			ВыводимаяСтрокаОтчета=Результат.Строка;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если ДеревоНастройкиСервер_Строки.Строки.Количество()>0 Тогда
		
		ПодготовитьТаблицыПоДеревуРекурсивноПоказателиОтбор(ДеревоНастройкиСервер_Строки, СтруктураШаблонов, ТаблицаКолонокВход, РезультатПоказатели);
		
	КонецЕсли;
	
	УстановитьШиринуКолонки(ТабДокВыборПоказателя);
	
	ТабДокВыборПоказателя.ФиксацияСлева = 1;
	ТабДокВыборПоказателя.ФиксацияСверху = 1;
		
КонецПроцедуры 

&НаСервере
Процедура ПодготовитьТаблицыПоДеревуРекурсивноПоказателиОтбор(тДеревоВыбранныхСтрок,СтруктураШаблонов,ТаблицаКолонокВход,РезультатПоказатели)
	
	Для Каждого Стр Из тДеревоВыбранныхСтрок.Строки Цикл	
		
		Если Не Стр.Строка =  Нстр("ru = 'Выбранные строки'") Тогда			
			
			ВывестиСтрокуВТабличныйДокументОтбор(Стр,СтруктураШаблонов,ТаблицаКолонокВход,РезультатПоказатели);
			
			Если Стр.Уровень()>0 Тогда 
				
				ТабДокВыборПоказателя.НачатьГруппуСтрок(Стр.СтрокаКод);
				
			КонецЕсли;
			
		КонецЕсли;					
		
		ПодготовитьТаблицыПоДеревуРекурсивноПоказателиОтбор(Стр,СтруктураШаблонов,ТаблицаКолонокВход,РезультатПоказатели);		
		Если Стр.Уровень()>0 Тогда 
			Попытка
				ТабДокВыборПоказателя.ЗакончитьГруппуСтрок() 
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры  

&НаСервере
Процедура ВывестиСтрокуВТабличныйДокументОтбор(СтрокаВыборки = Неопределено,СтруктураШаблонов,ТаблицаКолонокВход,РезультатПоказатели = Неопределено);
	
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог 	= СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонСтрокиИтог;
	ОбластьШаблонСторокиИтог                     	= ПолеТабличногоДокументаМакетШаблонСтрокиИтог.ПолучитьОбласть("ШаблонВыводаСтроки");
	
	ПолеТабличногоДокументаМакетШаблонСтроки	 	= СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонСтроки;
	ОбластьШаблонСтороки	                     	= ПолеТабличногоДокументаМакетШаблонСтроки.ПолучитьОбласть("ШаблонВыводаСтроки");
	
	Если СтрокаВыборки = Неопределено Тогда //Выводим служебную группирующую строку
				
		ТабДокВыборПоказателя.Вывести(ОбластьШаблонСторокиИтог);
		
	Иначе	
		
		Если СтрокаВыборки.Строки.Количество() = 0 Тогда
			ТабДокВыборПоказателя.Вывести(ОбластьШаблонСтороки);
		Иначе
			ТабДокВыборПоказателя.Вывести(ОбластьШаблонСторокиИтог);
		КонецЕсли;	
		
		//Выводим колонки реквизитов строки
		ВывестиРеквизитыСтрокОтбор(СтрокаВыборки);
		
		НачальныйИндексКолонокПоказателей = 2;
		
		Для Каждого СтрКолонка Из ТаблицаКолонокВход Цикл
			
			тПоказатель = РезультатПоказатели.НайтиСтроки(Новый Структура("Строка,Колонка",СтрокаВыборки.Строка,СтрКолонка.Ссылка));
			
			Если тПоказатель.Количество() > 0 Тогда
				
				ОбластьВыводаПоказателя=ТабДокВыборПоказателя.Область(ТабДокВыборПоказателя.ВысотаТаблицы,НачальныйИндексКолонокПоказателей,ТабДокВыборПоказателя.ВысотаТаблицы,НачальныйИндексКолонокПоказателей);
				
				ОбластьВыводаПоказателя.Текст 		= "■";
				ОбластьВыводаПоказателя.Имя = СокрЛП(тПоказатель[0].Ссылка.Код);
				ОбластьВыводаПоказателя.Расшифровка=Новый Структура("ВидОтчета,Показатель",ВидОтчетаОтборКод,СокрЛП(тПоказатель[0].Ссылка.Код));
						
			КонецЕсли;	
			
			НачальныйИндексКолонокПоказателей = НачальныйИндексКолонокПоказателей+1;
			
		КонецЦикла;	
		
		//Выводим свойста показателей если выбрали
		
		НачальныйИндексКолонокПоказателей = 1;
				
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Процедура ВывестиРеквизитыСтрокОтбор(СтрокаВыборки)
	
	//Выводим колонки реквизитов строки		
	тЯчейка = ТабДокВыборПоказателя.Область(ТабДокВыборПоказателя.ВысотаТаблицы, 1, ТабДокВыборПоказателя.ВысотаТаблицы, 1);
	
	тЯчейка.Текст = СтрокаВыборки.СтрокаНаименование;	
	тЯчейка.Отступ = (СтрокаВыборки.Уровень()-1)*2;
	
	Если СтрокаВыборки.СтрокаПометкаНаУдаление Тогда
		тЯчейка.Шрифт 			= Новый Шрифт(тЯчейка.Шрифт,,,,,,Истина);
		тЯчейка.ЦветТекста      = Новый Цвет(255,0,0);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДанныеОСВ(ВыделенныеСтроки)
	
	МассивСчетов=Новый Массив;
	
	Для Каждого Строка ИЗ ВыделенныеСтроки Цикл
		
		ДанныеСчета=ТаблицаОСВ.НайтиПоИдентификатору(Строка);
		МассивСчетов.Добавить(Новый Структура("Счет",ДанныеСчета.КодСчета));
		
	КонецЦикла;
	
	ДанныеПеретаскивания=Новый Структура;
	ДанныеПеретаскивания.Вставить("ТипИсходныхДанных",ТипИсходныхДанных);
	ДанныеПеретаскивания.Вставить("ВидИтога",ВидИтога);
	ДанныеПеретаскивания.Вставить("МассивСчетов",МассивСчетов);
	
	Возврат ДанныеПеретаскивания; 
	
КонецФункции // ПодготовитьДанныеОСВ() 
	
&НаКлиенте
Процедура ТаблицаОСВНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)	
	
	ПараметрыПеретаскивания.Значение=ПодготовитьДанныеОСВ(ПараметрыПеретаскивания.Значение);
		
КонецПроцедуры 

&НаКлиенте
Функция ВозможнаВставкаВФормулу(Область)
	
	Возврат (ТипЗнч(Область.Расшифровка)=Тип("Структура") И Область.Расшифровка.Свойство("Показатель"));	
	
КонецФункции // ВозможнаВставкаВФормулу(Область) 

&НаКлиенте
Процедура ПолеТабличногоДокументаМакетПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Область)
	
	ВозможноПеретаскивание=ВозможнаВставкаВФормулу(Область); 
	
	Если ВозможноПеретаскивание Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
		
	Иначе
		
		ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена;
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
		
	КонецЕсли;                                           
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеТабличногоДокументаМакетПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Область)
	
	СтандартнаяОбработка=Ложь;
	
	Если ВозможнаВставкаВФормулу(Область) Тогда 
		
		Если РежимРедактированияФормулы Тогда
			
			ПоказатьПредупреждение(,НСтр("ru = 'При активном режиме редактирования формулы показателя вставка данных в ячейку невозможна.'"));
			Возврат; 
			
		КонецЕсли;
	
		Если Область.Расшифровка.ПроизвольныйКод Тогда
			
			ПоказатьПредупреждение(,НСтр("ru = 'Показатель заполняется произвольным кодом. Вставка данных в формулу невозможна.'"));
			Возврат;
			
		Иначе
			
			ДанныеПоказателя=Область.Расшифровка;
			
			Если ДобавитьДанныеВФормулу(ДанныеПоказателя,ПараметрыПеретаскивания.Значение) Тогда
				
				Область.Текст=ДанныеПоказателя.Процедура;
				ЗаполнитьЗначенияСвойств(Область.Расшифровка,ДанныеПоказателя);
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Функция ДобавитьДанныеВФормулу(ДанныеПоказателя,ДанныеДляДобавления) 
	
	Если ДанныеДляДобавления.ТипИсходныхДанных="ОстаткиИОбороты"
		ИЛИ ДанныеДляДобавления.ТипИсходныхДанных="Корреспонденция" Тогда
		
		ТекстДобавления=ДобавитьДанныеРегистраБухгалтерии(ДанныеДляДобавления);
		
	ИначеЕсли ДанныеДляДобавления.ТипИсходныхДанных="Шаблоны" Тогда
		
		ТекстДобавления=ДобавитьДанныеШаблонов(ДанныеПоказателя,ДанныеДляДобавления);
		
	ИначеЕсли ДанныеДляДобавления.ТипИсходныхДанных="ПоказателиОтчетов" Тогда
		
		ТекстДобавления=ДобавитьПоказателиОтчетов(ДанныеДляДобавления);
			
	КонецЕсли;
	
	Если ПустаяСтрока(ДанныеПоказателя.Процедура) Тогда
		
		Если Сред(ТекстДобавления,2,1)="-" Тогда
			
			ТекстПроцедуры=ТекстДобавления;
			
		Иначе
			
			ТекстПроцедуры=Сред(ТекстДобавления,4);
			
		КонецЕсли;
		
	Иначе
		
		ТекстПроцедуры=ДанныеПоказателя.Процедура+ТекстДобавления;
		
	КонецЕсли;
			
	СтруктураДанных=СформироватьСтруктуруДляОбновленияФормулы(ТекстПроцедуры,ДанныеПоказателя);
	
	Если НЕ УправлениеОтчетамиУХ.ОбработатьТекстУпрощеннойФормулы(СтруктураДанных) Тогда		
		Возврат Ложь;	
	КонецЕсли;
	
	РабочийТекстФормулы=СтруктураДанных.ТекстПроцедуры;
	РабочийТекстРедактирования=СтруктураДанных.РабочийТекстРедактирования;
		
	УправлениеОтчетамиУХ.ЗаписатьПроцедуруРасчета(СтруктураДанных);
	
	ДанныеПоказателя.Процедура					= РабочийТекстФормулы;
	ДанныеПоказателя.ПроцедураРедактирования	= РабочийТекстРедактирования;	
	
	Возврат Истина;
	
КонецФункции // ДобавитьТекстВФормулу()

&НаСервере
Функция ДобавитьДанныеРегистраБухгалтерии(ДанныеДляДобавления)
	
	ТекстДобавления="";
	
	Если ДанныеДляДобавления.Свойство("ВидИтога") Тогда
		
		Для Каждого Элемент ИЗ ДанныеДляДобавления.МассивСчетов Цикл
			
			ТекстДобавления=ТекстДобавления+" + "+ДанныеДляДобавления.ВидИтога+Элемент.Счет;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Элемент ИЗ ДанныеДляДобавления.МассивКорреспонденций Цикл
			
			ТекстДобавления=ТекстДобавления+" + ОБ"+Элемент.Счет+","+Элемент.КоррСчет;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТекстДобавления;
			
КонецФункции // ДобавитьДанныеРегистраБухгалтерии() 

&НаСервере
Функция ДобавитьДанныеШаблонов(ДанныеПоказателя,ДанныеДляДобавления)
	
	ТекстДобавления="";
	
	Для Каждого ДанныеШаблона ИЗ ДанныеДляДобавления.МассивИсточников Цикл
		
		СправочникОбъект=Справочники.ИсточникиДанныхДляРасчетов.СоздатьЭлемент();
		СправочникОбъект.НазначениеРасчетов=ПравилоОбработки;
		СправочникОбъект.ПотребительРасчета=ДанныеПоказателя.Показатель; 
		СправочникОбъект.СпособИспользования=Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета;
		СправочникОбъект.ЗаполнитьНачальныеНастройки();
			
		СправочникОбъект.ИсточникШаблон	= ДанныеШаблона.ИсточникШаблон;
		СправочникОбъект.ЗаполнитьПоШаблонуИсточнику();
		СправочникОбъект.РесурсРегистра=ДанныеШаблона.РесурсРегистра;
		СправочникОбъект.ВидИтога=ДанныеШаблона.ВидИтога;
		СправочникОбъект.ДтКт=ДанныеШаблона.ДтКт;
		
		СправочникОбъект.СохранитьНастройкиОперанда();
		СправочникОбъект.Записать();
		
		Если ДанныеШаблона.Коэффициент=1 Тогда 
			
			ТекстДобавления=ТекстДобавления+" + ["+СокрЛП(СправочникОбъект.Код)+"]";
			
		ИначеЕсли ДанныеШаблона.Коэффициент=-1 Тогда 
			
			ТекстДобавления=ТекстДобавления+" - ["+СокрЛП(СправочникОбъект.Код)+"]";
			
		Иначе
			
			ТекстДобавления=ТекстДобавления+" + "+Формат(ДанныеШаблона.Коэффициент,"ЧГ=0")+"*["+СокрЛП(СправочникОбъект.Код)+"]";
			
		КонецЕсли;	
		
	КонецЦикла;
			
	Возврат ТекстДобавления;
	
КонецФункции // ДобавитьДанныеШаблонов()

&НаСервере
Функция ДобавитьПоказателиОтчетов(ДанныеДляДобавления)

	ТекстДобавления="";
	
	Для Каждого Элемент ИЗ ДанныеДляДобавления.МассивПоказателей Цикл
		
		ТекстДобавления=ТекстДобавления+" + {"+Элемент.ВидОтчета+"."+Элемент.Показатель+"}";
		
	КонецЦикла;
	
	Возврат ТекстДобавления;
	
КонецФункции // ДобавитьПоказателиОтчетов()

&НаСервере
Процедура УстановитьШиринуКолонки(ТабличныйДокумент)

	ДлинаСтроки=0;
	
	Для Индекс=1 По ТабличныйДокумент.ВысотаТаблицы Цикл
		
		ОбластьСтроки=ТабличныйДокумент.Область(Индекс,1,Индекс,1);
		
		ТекстОбласти=ОбластьСтроки.Текст;
		ТекДлинаСтроки=СтрДлина(ТекстОбласти)+ОбластьСтроки.Отступ;
		
		Если ТекДлинаСтроки>ДлинаСтроки Тогда
			
			ДлинаСтроки=ТекДлинаСтроки;
			
		КонецЕсли;
		
	КонецЦикла;
		
	ТабличныйДокумент.Область(,1,,1).ШиринаКолонки=?(ДлинаСтроки<50,ДлинаСтроки,50);
		
КонецПроцедуры // УстановитьШиринуКолонки() 

&НаКлиенте
Функция ПолучитьДанныеКорреспонденция(ВыделенныеСтроки)

	МассивКорреспонденций=Новый Массив;
	
	Для Каждого Строка ИЗ ВыделенныеСтроки Цикл
		
		ДанныеКорреспонденции=ТаблицаКорреспонденции.НайтиПоИдентификатору(Строка);
		
		Если ДанныеКорреспонденции.ПолучитьЭлементы().Количество()>0 Тогда
			
			Для Каждого Строка ИЗ ДанныеКорреспонденции.ПолучитьЭлементы() Цикл
				
				МассивКорреспонденций.Добавить(Новый Структура("Счет,КоррСчет",Строка.СчетДтИтог,Строка.СчетКтИтог));
				
			КонецЦикла;
			
		Иначе
			
			МассивКорреспонденций.Добавить(Новый Структура("Счет,КоррСчет",ДанныеКорреспонденции.СчетДтИтог,ДанныеКорреспонденции.СчетКтИтог));
			
		КонецЕсли;
		
	КонецЦикла;
				
	ДанныеПеретаскивания=Новый Структура;
	ДанныеПеретаскивания.Вставить("ТипИсходныхДанных",ТипИсходныхДанных);
	ДанныеПеретаскивания.Вставить("МассивКорреспонденций",МассивКорреспонденций);
	
	Возврат ДанныеПеретаскивания; 
	
КонецФункции // ПолучитьДанныеКорреспонденция() 

&НаКлиенте
Процедура ТаблицаКорреспонденцииНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
		
	ПараметрыПеретаскивания.Значение=ПолучитьДанныеКорреспонденция(ПараметрыПеретаскивания.Значение);

КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеПоказатели()
	
	МассивПоказателей=Новый Массив;
	
	Для Каждого Область ИЗ ТабДокВыборПоказателя.ВыделенныеОбласти Цикл
				
		Если ТипЗнч(Область.Расшифровка)=Тип("Структура") Тогда
			
			МассивПоказателей.Добавить(Область.Расшифровка);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ДанныеПеретаскивания=Новый Структура;
	ДанныеПеретаскивания.Вставить("ТипИсходныхДанных",ТипИсходныхДанных);
	ДанныеПеретаскивания.Вставить("МассивПоказателей",МассивПоказателей);
	
	Возврат ДанныеПеретаскивания;
	
КонецФункции // ПолучитьДанныеПоказатели() 

&НаКлиенте
Процедура ТабДокВыборПоказателяНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.Значение=ПолучитьДанныеПоказатели();
	
КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеШаблоны(ВыделенныеСтроки)
	
	МассивИсточников=Новый Массив;
	
	Для Каждого Идентификатор ИЗ ВыделенныеСтроки Цикл
		
		СтрокаШаблон=ТаблицаШаблонов.НайтиПоИдентификатору(Идентификатор);
		
		Если ЗначениеЗаполнено(СтрокаШаблон.РесурсРегистра) Тогда
			
			СтруктураИсточника=Новый Структура;
			СтруктураИсточника.Вставить("ИсточникШаблон",СтрокаШаблон.ИсточникШаблон);
			СтруктураИсточника.Вставить("РесурсРегистра",СтрокаШаблон.РесурсРегистра);
			СтруктураИсточника.Вставить("ВидИтога",СтрокаШаблон.ВидИтога);
			СтруктураИсточника.Вставить("ДтКт",СтрокаШаблон.ДтКт);
			СтруктураИсточника.Вставить("Коэффициент",СтрокаШаблон.Коэффициент);
			
			МассивИсточников.Добавить(СтруктураИсточника);
			
		Иначе
			
			ДобавитьПодчиненныеШаблоны(СтрокаШаблон,МассивИсточников);
			
		КонецЕсли;
		
	КонецЦикла;
				
	ДанныеПеретаскивания=Новый Структура;
	ДанныеПеретаскивания.Вставить("ТипИсходныхДанных","Шаблоны");
	ДанныеПеретаскивания.Вставить("МассивИсточников",МассивИсточников);
	
	Возврат ДанныеПеретаскивания;
	
КонецФункции // ПолучитьДанныеШаблоны() 

&НаКлиенте
Процедура ДобавитьПодчиненныеШаблоны(СтрокаРодитель,МассивИсточников)

	Для Каждого СтрокаШаблон ИЗ СтрокаРодитель.ПолучитьЭлементы() Цикл
		
		Если ЗначениеЗаполнено(СтрокаШаблон.РесурсРегистра) Тогда
			
			СтруктураИсточника=Новый Структура;
			СтруктураИсточника.Вставить("ИсточникШаблон",СтрокаШаблон.ИсточникШаблон);
			СтруктураИсточника.Вставить("РесурсРегистра",СтрокаШаблон.РесурсРегистра);
			СтруктураИсточника.Вставить("ВидИтога",СтрокаШаблон.ВидИтога);
			СтруктураИсточника.Вставить("ДтКт",СтрокаШаблон.ДтКт);
			СтруктураИсточника.Вставить("Коэффициент",СтрокаШаблон.Коэффициент); 
			
			МассивИсточников.Добавить(СтруктураИсточника);
			
		Иначе
			
			ДобавитьПодчиненныеШаблоны(СтрокаШаблон,МассивИсточников);
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры // ДобавитьПодчиненныеШаблоны() 
	
&НаКлиенте
Процедура ШаблоныИсточниковНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.Значение=ПолучитьДанныеШаблоны(ПараметрыПеретаскивания.Значение);

КонецПроцедуры 

Функция СформироватьСтруктуруДляОбновленияФормулы(ТекстПроцедуры,ДанныеПоказателя)
	
	СтруктураДанных=Новый Структура;
	СтруктураДанных.Вставить("ТекстПроцедуры",ТекстПроцедуры);
	СтруктураДанных.Вставить("ТипЯчейки","Показатель");
	СтруктураДанных.Вставить("ВидФормулы",0);
	СтруктураДанных.Вставить("ИтоговаяЯчейка","");
	СтруктураДанных.Вставить("Владелец",ВидОтчета);	
	СтруктураДанных.Вставить("НазначениеРасчетов",ПравилоОбработки);
	СтруктураДанных.Вставить("ПотребительРасчета",ДанныеПоказателя.Показатель);
	СтруктураДанных.Вставить("ПроизвольныйКод",ДанныеПоказателя.ПроизвольныйКод);
	СтруктураДанных.Вставить("ПересчитыватьПриОткрытии",ДанныеПоказателя.ПересчитыватьПриОткрытии);
	СтруктураДанных.Вставить("РедактированиеВозможно",	ДанныеПоказателя.РедактированиеВозможно);
	СтруктураДанных.Вставить("СпособИспользования",ПредопределенноеЗначение("Перечисление.СпособыИспользованияОперандов.ДляФормулРасчета"));
	
	Возврат СтруктураДанных;
	
КонецФункции // СформироватьСтруктуруДляЗаписиФормулы()

&НаКлиенте
Процедура ПоВидамОпераций(Команда)
	
 	Элементы.ПоВидамОпераций.Пометка=Не Элементы.ПоВидамОпераций.Пометка;
	ЗаполнитьТаблицуКорреспонденций();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДанныеВЯчейку(Команда) 
	
	Если РежимРедактированияФормулы Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'При активном режиме редактирования формулы показателя вставка данных в ячейку невозможна.'"));
		Возврат; 
		
	КонецЕсли;
	
	Если НЕ ПолеТабличногоДокументаМакет.ВыделенныеОбласти.Количество()=1 Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Для добавления данных в формулу расчета выделите одну ячейку.'"));
        Возврат;
		
	КонецЕсли; 
	
	ОбластьВставки=ПолеТабличногоДокументаМакет.ВыделенныеОбласти[0];
	
	Если НЕ (ТипЗнч(ОбластьВставки.Расшифровка)=Тип("Структура") И ОбластьВставки.Расшифровка.Свойство("Показатель")) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Для добавления данных в формулу расчета выделите ячейку, содержащую показатель.'"));
		Возврат;
		
	КонецЕсли; 
			
	Если ОбластьВставки.Расшифровка.ПроизвольныйКод Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Показатель заполняется произвольным кодом. Вставка данных в формулу невозможна.'"));
		Возврат;
		
	КонецЕсли;
	
	Если ТипИсходныхДанных="ОстаткиИОбороты" Тогда
		
		ДанныеДляВставки=ПодготовитьДанныеОСВ(Элементы.ТаблицаОСВ.ВыделенныеСтроки);
		
	ИначеЕсли ТипИсходныхДанных="Корреспонденция" Тогда
		
		ДанныеДляВставки=ПолучитьДанныеКорреспонденция(Элементы.ТаблицаКорреспонденции.ВыделенныеСтроки); 
		
	ИначеЕсли (ТипИсходныхДанных="Шаблоны" 
		ИЛИ ТипИсходныхДанных="ХозяйственныеОперации"
		ИЛИ ТипИсходныхДанных="ФинансовыеРегистры")  Тогда
		
		МассивИсточников=Новый Массив;
		
		Для Каждого Строка ИЗ Элементы.ТаблицаШаблонов.ВыделенныеСтроки Цикл
			
			МассивИсточников.Добавить(Строка);
			
		КонецЦикла;
		
		ДанныеДляВставки=ПолучитьДанныеШаблоны(МассивИсточников);
		
	ИначеЕсли ТипИсходныхДанных="ПоказателиОтчетов" Тогда
		
		ДанныеДляВставки=ПолучитьДанныеПоказатели();
		
	КонецЕсли;
	
	ДанныеПоказателя=ОбластьВставки.Расшифровка;
	
	Если ДобавитьДанныеВФормулу(ДанныеПоказателя,ДанныеДляВставки) Тогда
		
		ОбластьВставки.Текст=ДанныеПоказателя.Процедура;
		ЗаполнитьЗначенияСвойств(ОбластьВставки.Расшифровка,ДанныеПоказателя);
		
	КонецЕсли;
					
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаШаблоновНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ПараметрыПеретаскивания.Значение=ПолучитьДанныеШаблоны(ПараметрыПеретаскивания.Значение);
	
КонецПроцедуры  

&НаСервере
Процедура ПроверитьНаличиеИсточниковДанных()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	НЕ ИсточникиДанныхДляРасчетов.ОбъектУчета = НЕОПРЕДЕЛЕНО";
	
	Результат=Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		
		ИмяОбработки="УстановкаСоответствияРегистров";
		
		Обработки[ИмяОбработки].ЗаполнитьИсточникиДляФинансовыхРегистров();
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьСоздатьИсточникиДанных() 

&НаСервере
Процедура ЗаполнитьДеревоИсточников()
	
	ПроверитьНаличиеИсточниковДанных();
	
	ДеревоОбъектовУчета=Неопределено;
	
	Выполнить("ДеревоОбъектовУчета=Обработки.УстановкаСоответствияРегистров.ПолучитьДеревоОбъектовУчета()");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК Ссылка,
	|	ИсточникиДанныхДляРасчетов.Наименование КАК Наименование,
	|	ИсточникиДанныхДляРасчетов.ЭтоГруппа КАК ЭтоГруппа,
	|	ИсточникиДанныхДляРасчетов.СоответствиеРесурсовДляТрансляции.(
	|		РесурсИсточник КАК РесурсИсточник,
	|		ВидИтога КАК ВидИтога,
	|		Коэффициент КАК Коэффициент,
	|		ПредставлениеИсточник КАК ПредставлениеИсточник,
	|		ДтКт КАК ДтКт
	|	) КАК СоответствиеРесурсовДляТрансляции,
	|	ИсточникиДанныхДляРасчетов.РесурсРегистра КАК РесурсРегистра,
	|	ИсточникиДанныхДляРасчетов.ВидИтога КАК ВидИтога,
	|	ИсточникиДанныхДляРасчетов.ДтКт КАК ДтКт,
	|	ИсточникиДанныхДляРасчетов.ОбъектУчета КАК ОбъектУчета
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	НЕ ИсточникиДанныхДляРасчетов.ПометкаУдаления
	|	И ИсточникиДанныхДляРасчетов.СпособИспользования = ЗНАЧЕНИЕ(Перечисление.СпособыИспользованияОперандов.ПроизвольныеДанные)";
	
	Запрос.Текст=Запрос.Текст+"
	|	И ИсточникиДанныхДляРасчетов.ОбъектУчета ССЫЛКА ПланВидовХарактеристик.СтатьиАктивовПассивов";
	
	ТабШаблоныИсточников=Запрос.Выполнить().Выгрузить();
	ТаблицаШаблонов.ПолучитьЭлементы().Очистить();
	
	Для Каждого СтрокаГруппа ИЗ ДеревоОбъектовУчета.Строки Цикл 
		
		НоваяГруппа=ТаблицаШаблонов.ПолучитьЭлементы().Добавить();
		НоваяГруппа.ПредставлениеИсточника=СтрокаГруппа.Представление;
		НоваяГруппа.ЭтоГруппа=Истина;
				
		Для Каждого СтрокаИсточник ИЗ СтрокаГруппа.Строки Цикл
			
			ДанныеИсточника=ТабШаблоныИсточников.Найти(СтрокаИсточник.ОбъектУчета,"ОбъектУчета");
			
			Если ДанныеИсточника=Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			НовыйИсточник=НоваяГруппа.ПолучитьЭлементы().Добавить();
			
			///////////////////////////////////////////////////////////////
			
			НовыйИсточник.ИсточникШаблон=ДанныеИсточника.Ссылка;
			НовыйИсточник.ПредставлениеИсточника=ДанныеИсточника.Наименование;
					
			Если ДанныеИсточника.СоответствиеРесурсовДляТрансляции.Количество()=0 Тогда
				
				НовыйИсточник.РесурсРегистра=ДанныеИсточника.РесурсРегистра;
				НовыйИсточник.ВидИтога=ДанныеИсточника.ВидИтога;
				НовыйИсточник.ДтКт=ДанныеИсточника.ДтКт;
				НовыйИсточник.Коэффициент=1;
				
			ИначеЕсли ДанныеИсточника.СоответствиеРесурсовДляТрансляции.Количество()=1 Тогда	
				
				СтрокаРесурс=ДанныеИсточника.СоответствиеРесурсовДляТрансляции[0];		
				НовыйИсточник.РесурсРегистра=СтрокаРесурс.РесурсИсточник;
				НовыйИсточник.ВидИтога=СтрокаРесурс.ВидИтога;
				НовыйИсточник.ДтКт=СтрокаРесурс.ДтКт;
				НовыйИсточник.Коэффициент=СтрокаРесурс.Коэффициент;
				
			Иначе
				
				Для Каждого СтрокаРесурс ИЗ ДанныеИсточника.СоответствиеРесурсовДляТрансляции Цикл
					
					СтрокаШаблона=НовыйИсточник.ПолучитьЭлементы().Добавить();
					СтрокаШаблона.ИсточникШаблон=ДанныеИсточника.Ссылка;
					СтрокаШаблона.ПредставлениеИсточника=?(ЗначениеЗаполнено(СтрокаРесурс.ПредставлениеИсточник),СтрокаРесурс.ПредставлениеИсточник,СтрокаРесурс.РесурсИсточник);
					СтрокаШаблона.РесурсРегистра=СтрокаРесурс.РесурсИсточник;
					СтрокаШаблона.ВидИтога=СтрокаРесурс.ВидИтога;
					СтрокаШаблона.ДтКт=СтрокаРесурс.ДтКт;
					СтрокаШаблона.Коэффициент=СтрокаРесурс.Коэффициент;
					
				КонецЦикла;
				
			КонецЕсли;	
				
		КонецЦикла;
		
	КонецЦикла;
				
КонецПроцедуры // ЗаполнитьДеревоИсточников() 

&НаКлиенте
Процедура ТаблицаОСВВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПоказателейНажатие(Команда)
	
	КраткоеПредставлениеПоказателей = НЕ КраткоеПредставлениеПоказателей;
	
	Если КраткоеПредставлениеПоказателей Тогда
		Элементы.ПредставлениеПоказателей.Заголовок = НСтр("ru = 'Краткое представление'");
		Элементы.ПредставлениеПоказателей.Пометка = Истина;
	Иначе
		Элементы.ПредставлениеПоказателей.Заголовок = НСтр("ru = 'Подробное представление'");
		Элементы.ПредставлениеПоказателей.Пометка = Ложь;
	КонецЕсли;
		
	Для Каждого ПоказательСтрока Из ТаблицаПоказателей Цикл		
		ТекстПроцедуры = ПоказательСтрока.Процедура;
		ТекстКраткойПроцедуры = ПоказательСтрока.КраткаяПроцедура;
		
		Если НЕ ЗначениеЗаполнено(ТекстПроцедуры) ИЛИ НЕ ЗначениеЗаполнено(ТекстКраткойПроцедуры) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПоказательСтрока.ОбластьПоказателя) Тогда
			Продолжить;
		КонецЕсли;
		ЯчейкаПоказателя = ПолеТабличногоДокументаМакет.Область(ПоказательСтрока.ОбластьПоказателя);
		
		Если КраткоеПредставлениеПоказателей Тогда
			ЯчейкаПоказателя.Текст = ТекстКраткойПроцедуры;
		Иначе
			ЯчейкаПоказателя.Текст = ТекстПроцедуры;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПредставлениеФормулы();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеПоказателя(Представление, ТипПредставления)
	
	СтруктураПоиска = Новый Структура(ТипПредставления, Представление);
	СтрокиПоказателя = ТаблицаПоказателей.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиПоказателя.Количество() = 0 Тогда
		Возврат Представление;
	КонецЕсли;
		
	Если КраткоеПредставлениеПоказателей Тогда				
		Возврат СтрокиПоказателя[0].КраткоеПредставление;
	Иначе
		Возврат СтрокиПоказателя[0][ТипПредставления];
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьПредставлениеПроцедурыСервер(ТЗ_ТаблицаПоказателей, Показатель)
	
	СтруктураПоиска = Новый Структура("Показатель", Показатель);
	СтрокиПоказателя = ТЗ_ТаблицаПоказателей.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиПоказателя.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Если КраткоеПредставлениеПоказателей Тогда				
		Возврат СтрокиПоказателя[0].КраткаяПроцедура;
	Иначе
		Возврат СтрокиПоказателя[0].Процедура;
	КонецЕсли; 
	
КонецФункции

&НаКлиенте
Функция ПолучитьПредставлениеПроцедурыКлиент(Показатель)
	
	СтруктураПоиска = Новый Структура("Показатель", Показатель);
	СтрокиПоказателя = ТаблицаПоказателей.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиПоказателя.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Если КраткоеПредставлениеПоказателей Тогда				
		Возврат СтрокиПоказателя[0].КраткаяПроцедура;
	Иначе
		Возврат СтрокиПоказателя[0].Процедура;
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ИзменитьПредставлениеПроцедурыСервер(ТекстПроцедуры, Кратко, ИскатьВПроцедурах = Истина, ИскатьВПоказателях = Истина,
	ТЗ_ТаблицаПоказателейПроцедур = Неопределено, ТЗ_ТаблицаПоказателей = Неопределено)
	
	МассивПоказателейПроцедуры = ВернутьМассивПоказателейПроцедуры(ТекстПроцедуры);
	
	ПроцедураТекст = ТекстПроцедуры;
	СтруктураПоиска = Новый Структура();
	
	Если ТЗ_ТаблицаПоказателейПроцедур = Неопределено Тогда
		ТаблицаПоказателейПроцедурПоиск = ТаблицаПоказателейПроцедур;
	Иначе
		ТаблицаПоказателейПроцедурПоиск = ТЗ_ТаблицаПоказателейПроцедур;
	КонецЕсли;
	
	Если ТЗ_ТаблицаПоказателей = Неопределено Тогда
		ТаблицаПоказателейПоиск = ТаблицаПоказателей;
	Иначе
		ТаблицаПоказателейПоиск = ТЗ_ТаблицаПоказателей;
	КонецЕсли;
	
	Если Кратко Тогда
		
		Для Каждого ПоказательПроцедуры Из МассивПоказателейПроцедуры Цикл
						
			ПоказательНайден = Ложь;
			
			Если ИскатьВПроцедурах Тогда
				СтруктураПоиска.Очистить();
				СтруктураПоиска.Вставить("Представление", ПоказательПроцедуры);
				СтрокиПоказателей = ТаблицаПоказателейПроцедурПоиск.НайтиСтроки(СтруктураПоиска);
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("УниверсальноеПредставление", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателейПроцедурПоиск.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("ПредставлениеРедактирования", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателейПроцедурПоиск.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
				
				ПоказательНайден = (СтрокиПоказателей.Количество() > 0);
			КонецЕсли;
			
			Если ИскатьВПоказателях И НЕ ПоказательНайден Тогда
				СтруктураПоиска.Очистить();
				СтруктураПоиска.Вставить("Представление", ПоказательПроцедуры);
				СтрокиПоказателей = ТаблицаПоказателейПоиск.НайтиСтроки(СтруктураПоиска);
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("ПредставлениеРедактирования", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателейПоиск.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокиПоказателей.Количество() > 0 Тогда
				КраткоеПредставление = СтрокиПоказателей[0].КраткоеПредставление;
				  
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "[" + ПоказательПроцедуры + "]", "[" + КраткоеПредставление + "]");
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "{" + ПоказательПроцедуры + "}", "{" + КраткоеПредставление + "}");
			КонецЕсли;
		КонецЦикла;	
		
	Иначе
		
		Для Каждого ПоказательПроцедуры Из МассивПоказателейПроцедуры Цикл
			СтруктураПоиска.Очистить();
			СтруктураПоиска.Вставить("КраткоеПредставление", ПоказательПроцедуры);
			СтрокиПоказателей = ТаблицаПоказателейПроцедурПоиск.НайтиСтроки(СтруктураПоиска);
			
			Если СтрокиПоказателей.Количество() > 0 Тогда
				Представление = СтрокиПоказателей[0].Представление;
				ПредставлениеРедактирования = СтрокиПоказателей[0].ПредставлениеРедактирования;
				
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "[" + ПоказательПроцедуры + "]", "[" + Представление + "]");
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "{" + ПоказательПроцедуры + "}", "{" + ПредставлениеРедактирования + "}")
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПроцедураТекст;

КонецФункции	// ИзменитьПредставлениеПроцедурыСервер

&НаКлиенте
Функция ИзменитьПредставлениеПроцедурыКлиент(ТекстПроцедуры, Кратко, ИскатьВПроцедурах = Истина, ИскатьВПоказателях = Истина)
	
	МассивПоказателейПроцедуры = ВернутьМассивПоказателейПроцедуры(ТекстПроцедуры);
	
	ПроцедураТекст = ТекстПроцедуры;
	СтруктураПоиска = Новый Структура();
	
	Если Кратко Тогда
		
		Для Каждого ПоказательПроцедуры Из МассивПоказателейПроцедуры Цикл
			
			ПоказательНайден = Ложь;
			
			Если ИскатьВПроцедурах Тогда
				СтруктураПоиска.Очистить();
				СтруктураПоиска.Вставить("Представление", ПоказательПроцедуры);
				СтрокиПоказателей = ТаблицаПоказателейПроцедур.НайтиСтроки(СтруктураПоиска);
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("УниверсальноеПредставление", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателейПроцедур.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("ПредставлениеРедактирования", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателейПроцедур.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
				
				ПоказательНайден = (СтрокиПоказателей.Количество() > 0);
			КонецЕсли;
			
			Если ИскатьВПоказателях И НЕ ПоказательНайден Тогда
				СтруктураПоиска.Очистить();
				СтруктураПоиска.Вставить("Представление", ПоказательПроцедуры);
				СтрокиПоказателей = ТаблицаПоказателей.НайтиСтроки(СтруктураПоиска);
				
				Если СтрокиПоказателей.Количество() = 0 Тогда
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("ПредставлениеРедактирования", ПоказательПроцедуры);
					СтрокиПоказателей = ТаблицаПоказателей.НайтиСтроки(СтруктураПоиска);
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокиПоказателей.Количество() > 0 Тогда
				КраткоеПредставление = СтрокиПоказателей[0].КраткоеПредставление;
				  
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "[" + ПоказательПроцедуры + "]", "[" + КраткоеПредставление + "]");
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "{" + ПоказательПроцедуры + "}", "{" + КраткоеПредставление + "}");
			КонецЕсли;
		КонецЦикла;	
		
	Иначе
		
		Для Каждого ПоказательПроцедуры Из МассивПоказателейПроцедуры Цикл
			СтруктураПоиска.Очистить();
			СтруктураПоиска.Вставить("КраткоеПредставление", ПоказательПроцедуры);
			СтрокиПоказателей = ТаблицаПоказателейПроцедур.НайтиСтроки(СтруктураПоиска);
			
			Если СтрокиПоказателей.Количество() > 0 Тогда
				Представление = СтрокиПоказателей[0].Представление;
				ПредставлениеРедактирования = СтрокиПоказателей[0].ПредставлениеРедактирования;
				
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "[" + ПоказательПроцедуры + "]", "[" + Представление + "]");
				ПроцедураТекст = СтрЗаменить(ПроцедураТекст, "{" + ПоказательПроцедуры + "}", "{" + ПредставлениеРедактирования + "}")
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПроцедураТекст;

КонецФункции	// ИзменитьПредставлениеПроцедурыКлиент  

&НаКлиентеНаСервереБезКонтекста
Функция ВернутьМассивПоказателейПроцедуры(ТекстПроцедуры)
	
	Результат = Новый Массив;
	ТекстПроцедурыКопия = ТекстПроцедуры;
	
	ПозицияСкобкиНачало = 0;
	ПозицияСкобкиНачало1 = СтрНайти(ТекстПроцедуры, "[");
	ПозицияСкобкиНачало2 = СтрНайти(ТекстПроцедуры, "{");
	Если ПозицияСкобкиНачало1 > 0 И ПозицияСкобкиНачало2 > 0 Тогда
		ПозицияСкобкиНачало = Мин(ПозицияСкобкиНачало1, ПозицияСкобкиНачало2);
	ИначеЕсли ПозицияСкобкиНачало1 > 0 ИЛИ ПозицияСкобкиНачало2 > 0 Тогда
		ПозицияСкобкиНачало = Макс(ПозицияСкобкиНачало1, ПозицияСкобкиНачало2);
	КонецЕсли;
	
	ПозицияСкобкиКонец = 0;
	ПозицияСкобкиКонец1 = СтрНайти(ТекстПроцедуры, "]");
	ПозицияСкобкиКонец2 = СтрНайти(ТекстПроцедуры, "}");
	Если ПозицияСкобкиКонец1 > 0 И ПозицияСкобкиКонец2 > 0 Тогда
		ПозицияСкобкиКонец = Мин(ПозицияСкобкиКонец1, ПозицияСкобкиКонец2);
	ИначеЕсли ПозицияСкобкиНачало1 > 0 ИЛИ ПозицияСкобкиНачало2 > 0 Тогда
		ПозицияСкобкиКонец = Макс(ПозицияСкобкиКонец1, ПозицияСкобкиКонец2);
	КонецЕсли;
	
	Пока ПозицияСкобкиНачало > 0 И ПозицияСкобкиНачало < ПозицияСкобкиКонец Цикл	
		ТекстОперанда = Сред(ТекстПроцедурыКопия, ПозицияСкобкиНачало + 1, ПозицияСкобкиКонец - ПозицияСкобкиНачало - 1);
		Результат.Добавить(ТекстОперанда);
		
		ТекстПроцедурыКопия = Сред(ТекстПроцедурыКопия, ПозицияСкобкиКонец + 1);
		
		ПозицияСкобкиНачало = 0;
		ПозицияСкобкиНачало1 = СтрНайти(ТекстПроцедурыКопия, "[");
		ПозицияСкобкиНачало2 = СтрНайти(ТекстПроцедурыКопия, "{");
		Если ПозицияСкобкиНачало1 > 0 И ПозицияСкобкиНачало2 > 0 Тогда
			ПозицияСкобкиНачало = Мин(ПозицияСкобкиНачало1, ПозицияСкобкиНачало2);
		ИначеЕсли ПозицияСкобкиНачало1 > 0 ИЛИ ПозицияСкобкиНачало2 > 0 Тогда
			ПозицияСкобкиНачало = Макс(ПозицияСкобкиНачало1, ПозицияСкобкиНачало2);
		КонецЕсли;
		
		ПозицияСкобкиКонец = 0;
		ПозицияСкобкиКонец1 = СтрНайти(ТекстПроцедурыКопия, "]");
		ПозицияСкобкиКонец2 = СтрНайти(ТекстПроцедурыКопия, "}");
		Если ПозицияСкобкиКонец1 > 0 И ПозицияСкобкиКонец2 > 0 Тогда
			ПозицияСкобкиКонец = Мин(ПозицияСкобкиКонец1, ПозицияСкобкиКонец2);
		ИначеЕсли ПозицияСкобкиНачало1 > 0 ИЛИ ПозицияСкобкиНачало2 > 0 Тогда
			ПозицияСкобкиКонец = Макс(ПозицияСкобкиКонец1, ПозицияСкобкиКонец2);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьИсточникиДанныхПоказателей(НазначениеРасчетов, ВидОтчетаПараметр, ПотребителиРасчета = Неопределено, КодыИсточников = Неопределено, ИсточникиДанных = Неопределено, КодыПоказателей = Неопределено, ВыводитьПоказатели = Истина)
	                                     
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	КвалификаторСтроки = Новый КвалификаторыСтроки(100);
	ОписаниеТиповСтрока = Новый ОписаниеТипов(МассивТипов,, КвалификаторСтроки);
	МассивТипов.Очистить();
	МассивТипов.Добавить(Тип("Число"));
	КвалификаторЧисла = Новый КвалификаторыЧисла(10, 0);
	ОписаниеТиповЧисло = Новый ОписаниеТипов(МассивТипов,,, КвалификаторЧисла);
	ОписаниеТиповВидыОтчетов = Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов");
	ОписаниеТиповСтрокиОтчетов = Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов");
	ОписаниеТиповПоказателиОтчетов = Новый ОписаниеТипов("СправочникСсылка.ПоказателиОтчетов");
		
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КодИсточника", ОписаниеТиповСтрока);
	Результат.Колонки.Добавить("Показатель", ОписаниеТиповПоказателиОтчетов);
	Результат.Колонки.Добавить("КодПоказателя", ОписаниеТиповСтрока);
	Результат.Колонки.Добавить("ВидОтчетаКод", ОписаниеТиповСтрока);
	Результат.Колонки.Добавить("ВидОтчета", ОписаниеТиповВидыОтчетов);
	Результат.Колонки.Добавить("Строка", ОписаниеТиповСтрокиОтчетов);
	Результат.Колонки.Добавить("НомерКолонки", ОписаниеТиповЧисло);
	
	Запрос = Новый Запрос;
	
	УсловиеОтбор = "";
	УсловиеОтбор2 = "";
	Если ПотребителиРасчета <> Неопределено Тогда
		УсловиеОтбор = УсловиеОтбор + "
	|	И РеквизитыИсточниковДанныхДляФормул.ПотребительРасчета В(&ПотребителиРасчета)";
		
		Запрос.УстановитьПараметр("ПотребителиРасчета", ПотребителиРасчета);
	КонецЕсли;
		
	Если КодыИсточников <> Неопределено Тогда
		УсловиеОтбор = УсловиеОтбор + "
	|	И РеквизитыИсточниковДанныхДляФормул.КодИсточника В(&КодыИсточников)";
		
		Запрос.УстановитьПараметр("КодыИсточников", КодыИсточников);
	КонецЕсли;
	
	Если ИсточникиДанных <> Неопределено Тогда
		УсловиеОтбор = УсловиеОтбор + "
	|	И РеквизитыИсточниковДанныхДляФормул.ИсточникДанных В(&ИсточникиДанных)";
		
		Запрос.УстановитьПараметр("ИсточникиДанных", ИсточникиДанных);
	КонецЕсли;
	
	Если КодыПоказателей <> Неопределено Тогда
		УсловиеОтбор = УсловиеОтбор + "
	|	И РеквизитыИсточниковДанныхДляФормул.КодПоказательОтбор В(&КодыПоказателей)";
		
		УсловиеОтбор2 = УсловиеОтбор2 + "
	|	И ПоказателиОтчетов.Код В(&КодыПоказателей)";
		
		Запрос.УстановитьПараметр("КодыПоказателей", КодыПоказателей);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	РеквизитыИсточниковДанныхДляФормул.КодИсточника КАК КодИсточника,
	|	РеквизитыИсточниковДанныхДляФормул.ПоказательОтбор КАК Показатель,
	|	РеквизитыИсточниковДанныхДляФормул.КодПоказательОтбор КАК КодПоказателя,
	|	ВидыОтчетов.Код КАК ВидОтчетаКод,
	|	ВидыОтчетов.Ссылка КАК ВидОтчета,
	|	СтрокиОтчетов.Ссылка КАК Строка,
	|	КолонкиОтчетов.ПорядковыйНомер КАК НомерКолонки
	|ИЗ
	|	РегистрСведений.РеквизитыИсточниковДанныхДляФормул КАК РеквизитыИсточниковДанныхДляФормул
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
	|		ПО РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор = ВидыОтчетов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ПО РеквизитыИсточниковДанныхДляФормул.ПоказательОтбор = ПоказателиОтчетов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|		ПО РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор = СтрокиОтчетов.Владелец
	|			И (ПоказателиОтчетов.Строка = СтрокиОтчетов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	|		ПО РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор = КолонкиОтчетов.Владелец
	|			И (ПоказателиОтчетов.Колонка = КолонкиОтчетов.Ссылка)
	|ГДЕ
	|	РеквизитыИсточниковДанныхДляФормул.НазначениеРасчетов = &НазначениеРасчетов
	|	И РеквизитыИсточниковДанныхДляФормул.ВидОтчета = &ВидОтчета
	|	И РеквизитыИсточниковДанныхДляФормул.СпособИспользования = &СпособИспользования
	|	И РеквизитыИсточниковДанныхДляФормул.НеИспользуется = ЛОЖЬ
	|	И НЕ ВидыОтчетов.Ссылка ЕСТЬ NULL
	|	И НЕ ПоказателиОтчетов.Ссылка ЕСТЬ NULL
	|	И НЕ СтрокиОтчетов.Ссылка ЕСТЬ NULL
	|	И НЕ КолонкиОтчетов.Ссылка ЕСТЬ NULL" + УсловиеОтбор;
	
	Если ВыводитьПоказатели Тогда
		
		Запрос.Текст = Запрос.Текст + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВидыОтчетов.Код + ""_"" + ПоказателиОтчетов.Код,
	|	ПоказателиОтчетов.Ссылка,
	|	ПоказателиОтчетов.Код,
	|	ВидыОтчетов.Код,
	|	ВидыОтчетов.Ссылка,
	|	СтрокиОтчетов.Ссылка,
	|	КолонкиОтчетов.ПорядковыйНомер
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ПО ВидыОтчетов.Ссылка = ПоказателиОтчетов.Владелец
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|		ПО ВидыОтчетов.Ссылка = СтрокиОтчетов.Владелец
	|			И (ПоказателиОтчетов.Строка = СтрокиОтчетов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	|		ПО ВидыОтчетов.Ссылка = КолонкиОтчетов.Владелец
	|			И (ПоказателиОтчетов.Колонка = КолонкиОтчетов.Ссылка)
	|ГДЕ
	|	ВидыОтчетов.Ссылка = &ВидОтчета
	|	И НЕ ПоказателиОтчетов.Ссылка ЕСТЬ NULL
	|	И НЕ СтрокиОтчетов.Ссылка ЕСТЬ NULL
	|	И НЕ КолонкиОтчетов.Ссылка ЕСТЬ NULL" + УсловиеОтбор2;
		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("НазначениеРасчетов", НазначениеРасчетов);
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчетаПараметр);
	Запрос.УстановитьПараметр("СпособИспользования", Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета);
		
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл 
		НоваяСтрокаРезультат = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультат, ВыборкаЗапроса);
		
		НоваяСтрокаРезультат.НомерКолонки = ВыборкаЗапроса.НомерКолонки + 1;
		НоваяСтрокаРезультат.ВидОтчетаКод = СокрЛП(НоваяСтрокаРезультат.ВидОтчетаКод);
		НоваяСтрокаРезультат.КодПоказателя = СокрЛП(НоваяСтрокаРезультат.КодПоказателя);
		НоваяСтрокаРезультат.КодИсточника = СтрЗаменить(НоваяСтрокаРезультат.КодИсточника, " ", "");
	КонецЦикла;
	
	Результат.Свернуть("КодИсточника, Показатель, КодПоказателя, ВидОтчетаКод, ВидОтчета, Строка, НомерКолонки");
	
	Возврат Результат;
				 	
КонецФункции

&НаСервере
Функция ПолучитьКэшСтруктурыВидовОтчета(ВидыОтчетов)
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	КвалификаторЧисла = Новый КвалификаторыЧисла(10, 0);
	ОписаниеТиповЧисло = Новый ОписаниеТипов(МассивТипов,,, КвалификаторЧисла);
	ОписаниеТиповВидыОтчетов = Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов");
	ОписаниеТиповСтрокиОтчетов = Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов");
			
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидОтчета", ОписаниеТиповВидыОтчетов);
	Результат.Колонки.Добавить("Строка", ОписаниеТиповСтрокиОтчетов);
	Результат.Колонки.Добавить("НомерСтроки", ОписаниеТиповЧисло);
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	|	СтрокиОтчетов.Владелец КАК ВидОтчета,
	|	СтрокиОтчетов.Ссылка КАК Строка
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.Владелец В(&ВидыОтчетов)
	|	И СтрокиОтчетов.ПометкаУдаления В(&ВыводитьУдаленные)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокиОтчетов.Владелец,
	|	СтрокиОтчетов.Ссылка ИЕРАРХИЯ,
	|	СтрокиОтчетов.ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ВидыОтчетов", ВидыОтчетов);
	
	ВыводитьУдаленныеСписок = Новый СписокЗначений;
	ВыводитьУдаленныеСписок.Добавить(Ложь);
	Если ВыводитьУдаленные Тогда
		ВыводитьУдаленныеСписок.Добавить(Истина);
	КонецЕсли;	

	Запрос.УстановитьПараметр("ВыводитьУдаленные", ВыводитьУдаленныеСписок);	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	ТекущийВидОтчета = Справочники.ВидыОтчетов.ПустаяСсылка();
	ИндексСтрокиВидаОтчета = 1;
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если ВыборкаЗапроса.ВидОтчета <> ТекущийВидОтчета Тогда
			ИндексСтрокиВидаОтчета = 1;
			ТекущийВидОтчета = ВыборкаЗапроса.ВидОтчета;
		КонецЕсли;
		
		ИндексСтрокиВидаОтчета = ИндексСтрокиВидаОтчета + 1;
		НоваяСтрокаРезультат = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультат, ВыборкаЗапроса);
		НоваяСтрокаРезультат.НомерСтроки = ИндексСтрокиВидаОтчета;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуПоказателейПроцедур(ВидОтчетаПараметр, ПотребителиРасчета = Неопределено, КодыИсточников = Неопределено, ИсточникиДанных = Неопределено, КодыПоказателей = Неопределено, ВыводитьПоказатели = Истина)
	
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов();
	ПараметрыНастроек.ШаблонДокумента = ВидОтчетаПараметр;
	НазначениеРасчетов = УправлениеОтчетамиУХ.ЗначениеНастройкиОбработкиШаблонов(ПараметрыНастроек, "ПравилоОбработки");
		
	ТаблицаИсточниковДанныхПоказателейПроцедур = ПолучитьИсточникиДанныхПоказателей(НазначениеРасчетов, ВидОтчетаПараметр, ПотребителиРасчета, КодыИсточников, ИсточникиДанных, КодыПоказателей, ВыводитьПоказатели);
	МассивВидовОтчетов = ТаблицаИсточниковДанныхПоказателейПроцедур.ВыгрузитьКолонку("ВидОтчета");
	ТаблицаСтрокВидовОтчетов = ПолучитьКэшСтруктурыВидовОтчета(МассивВидовОтчетов);
	
	ЗапросСтрокиСНомерами = Новый Запрос();
	ЗапросСтрокиСНомерами.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросСтрокиСНомерами.Текст = "ВЫБРАТЬ
	|	ТаблицаИсточниковДанных.КодИсточника КАК КодИсточника,
	|	ТаблицаИсточниковДанных.КодПоказателя КАК КодПоказателя,
	|	ТаблицаИсточниковДанных.ВидОтчетаКод КАК ВидОтчетаКод,
	|	ТаблицаИсточниковДанных.ВидОтчета КАК ВидОтчета,
	|	ТаблицаИсточниковДанных.Строка КАК Строка,
	|	ТаблицаИсточниковДанных.НомерКолонки КАК НомерКолонки
	|ПОМЕСТИТЬ ВТ_ИсточникиДанных
	|ИЗ
	|	&ТаблицаИсточниковДанныхПоказателейПроцедур КАК ТаблицаИсточниковДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидОтчета,
	|	Строка";
	ЗапросСтрокиСНомерами.УстановитьПараметр("ТаблицаИсточниковДанныхПоказателейПроцедур", ТаблицаИсточниковДанныхПоказателейПроцедур);
	ЗапросСтрокиСНомерами.Выполнить();
	
	ЗапросСтрокиСНомерами.Текст = "ВЫБРАТЬ
	|	ТаблицаСтрок.ВидОтчета КАК ВидОтчета,
	|	ТаблицаСтрок.Строка КАК Строка,
	|	ТаблицаСтрок.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_СтрокиВидовОтчетов
	|ИЗ
	|	&ТаблицаСтрокВидовОтчетов КАК ТаблицаСтрок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидОтчета,
	|	Строка";
	ЗапросСтрокиСНомерами.УстановитьПараметр("ТаблицаСтрокВидовОтчетов", ТаблицаСтрокВидовОтчетов);
	ЗапросСтрокиСНомерами.Выполнить();
	
	ЗапросСтрокиСНомерами.Текст = "ВЫБРАТЬ
	|	ВТИсточникиДанных.КодИсточника КАК КодИсточника,
	|	ВТИсточникиДанных.КодПоказателя КАК КодПоказателя,
	|	ВТИсточникиДанных.ВидОтчетаКод КАК ВидОтчетаКод,
	|	ВТСтрокиВидовОтчетов.НомерСтроки КАК НомерСтроки,
	|	ВТИсточникиДанных.НомерКолонки КАК НомерКолонки
	|ИЗ
	|	ВТ_ИсточникиДанных КАК ВТИсточникиДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтрокиВидовОтчетов КАК ВТСтрокиВидовОтчетов
	|		ПО ВТИсточникиДанных.ВидОтчета = ВТСтрокиВидовОтчетов.ВидОтчета
	|			И ВТИсточникиДанных.Строка = ВТСтрокиВидовОтчетов.Строка";
	
	КраткиеПоказателиПроцедур = ЗапросСтрокиСНомерами.Выполнить().Выгрузить();
	
	СтруктураПоиска = Новый Структура;
	СоответствиеКраткихПоказателей = Новый Соответствие;
		
	Для Каждого ПоказательСтрока Из ТаблицаПоказателейПроцедур Цикл	
		ПорядковыйНомерНовый = 0;
		КраткоеПредставление = СтрЗаменить(ПоказательСтрока.КраткоеПредставление, ПоказательСтрока.ПорядковыйНомер, "");
		
		ПорядковыйНомерСуществующий = СоответствиеКраткихПоказателей.Получить(КраткоеПредставление);
		Если ПорядковыйНомерСуществующий <> Неопределено Тогда
			ПорядковыйНомерНовый = ПорядковыйНомерСуществующий + 1;
		КонецЕсли;
		
		СоответствиеКраткихПоказателей.Вставить(КраткоеПредставление, ПорядковыйНомерНовый);
	КонецЦикла;
	
	ТЗ_ТаблицаПоказателейПроцедур = РеквизитФормыВЗначение("ТаблицаПоказателейПроцедур");
	ТЗ_ТаблицаПоказателейПроцедур.Индексы.Добавить("ВидОтчетаКод, КодПоказателя, Представление, УниверсальноеПредставление, ПредставлениеРедактирования");
	
	Для Каждого ПоказательСтрока Из КраткиеПоказателиПроцедур Цикл
		
		КодВидаОтчета = СокрЛП(ПоказательСтрока.ВидОтчетаКод);
		Представление = ПоказательСтрока.КодИсточника;
		КодПоказателя = ПоказательСтрока.КодПоказателя;
		УниверсальноеПредставление = КодВидаОтчета + "_" + КодПоказателя;
		ПредставлениеРедактирования = КодВидаОтчета + "." + КодПоказателя;
		
		ИндексПоказателя = "";
		Если СтрНайти(Представление, УниверсальноеПредставление) = 1 И Представление <> УниверсальноеПредставление Тогда
			ИндексПоказателя = "_" + СтрЗаменить(Представление, УниверсальноеПредставление, "");
		КонецЕсли;
		КраткоеПредставление = ?(КодВидаОтчета = ВидОтчетаКод, "", КодВидаОтчета + "_") 
		+ "С" + Формат(ПоказательСтрока.НомерСтроки, "ЧГ=") 
		+ "К" + Формат(ПоказательСтрока.НомерКолонки, "ЧГ=") + ИндексПоказателя;
								
		СтруктураПоиска.Очистить();		
		СтруктураПоиска.Вставить("ВидОтчетаКод", КодВидаОтчета);
		СтруктураПоиска.Вставить("КодПоказателя", КодПоказателя);
		СтруктураПоиска.Вставить("Представление", Представление);
		СтруктураПоиска.Вставить("УниверсальноеПредставление", УниверсальноеПредставление);
		СтруктураПоиска.Вставить("ПредставлениеРедактирования", ПредставлениеРедактирования);
		
		СуществующиеСтроки = ТЗ_ТаблицаПоказателейПроцедур.НайтиСтроки(СтруктураПоиска);
		Если СуществующиеСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПорядковыйНомерНовый = 0;
		ПорядковыйНомерСуществующий = СоответствиеКраткихПоказателей.Получить(КраткоеПредставление);
		Если ПорядковыйНомерСуществующий <> Неопределено Тогда
			ПорядковыйНомерНовый = ПорядковыйНомерСуществующий + 1;
		КонецЕсли;
		СоответствиеКраткихПоказателей.Вставить(КраткоеПредставление, ПорядковыйНомерНовый);
		
		ПорядковыйНомер = ?(ПорядковыйНомерНовый = 0, "", "_" + Формат(ПорядковыйНомерНовый, "ЧГ="));
		КраткоеПредставление = КраткоеПредставление + ПорядковыйНомер;
				
		НоваяСтрокаТаблицыПоказателейПроцедур = ТЗ_ТаблицаПоказателейПроцедур.Добавить();
		
		НоваяСтрокаТаблицыПоказателейПроцедур.ВидОтчетаКод = КодВидаОтчета;
		НоваяСтрокаТаблицыПоказателейПроцедур.Представление = Представление;
		НоваяСтрокаТаблицыПоказателейПроцедур.КраткоеПредставление = КраткоеПредставление;
		НоваяСтрокаТаблицыПоказателейПроцедур.УниверсальноеПредставление = УниверсальноеПредставление;
		НоваяСтрокаТаблицыПоказателейПроцедур.ПредставлениеРедактирования = ПредставлениеРедактирования;
		НоваяСтрокаТаблицыПоказателейПроцедур.КодПоказателя = КодПоказателя;
		НоваяСтрокаТаблицыПоказателейПроцедур.ИндексПоказателя = ИндексПоказателя;
		НоваяСтрокаТаблицыПоказателейПроцедур.ПорядковыйНомер = ПорядковыйНомер;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТЗ_ТаблицаПоказателейПроцедур, "ТаблицаПоказателейПроцедур");
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВидОтчетаПриИзмененииНаСервере()
	
	ЗаполнитьДеревоСтрок();
	УстановитьЗаголовокФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ВидОтчетаПредставление = ?(ЗначениеЗаполнено(ВидОтчета), ": " + Строка(ВидОтчета), "");
	Заголовок = НСтр("ru = 'Конструктор отчета'") + ВидОтчетаПредставление;
	
КонецПроцедуры

#КонецОбласти
