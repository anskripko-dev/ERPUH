				Если ТипЗнч(ТекОбл.Расшифровка) = Тип("Структура") И ТекОбл.Расшифровка.Свойство("Показатель") Тогда
					ВыделенныеПоказатели.Добавить(ТекОбл.Расшифровка.Показатель);
