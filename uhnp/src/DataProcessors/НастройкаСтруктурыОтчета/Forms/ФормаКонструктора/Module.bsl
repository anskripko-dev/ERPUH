				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		ДобавитьСтрокиШаблоновРекурсивно(НоваяСтрока,Строка);
		
	КонецЦикла;
		
КонецПроцедуры // ЗаполнитьТаблицуШаблонов()

Процедура ДобавитьСтрокиШаблоновРекурсивно(СтрокаПриемник,СтрокаИсточник)

 	Для Каждого Строка ИЗ СтрокаИсточник.Строки Цикл
		
		Если Строка.ЭтоГруппа И Строка.Строки.Количество()=0 Тогда
			
			Продолжить;
			
		КонецЕсли;
			
		НоваяСтрока=СтрокаПриемник.ПолучитьЭлементы().Добавить();
		НоваяСтрока.ИсточникШаблон=Строка.Ссылка;
		НоваяСтрока.ПредставлениеИсточника=Строка.Наименование;
		НоваяСтрока.ЭтоГруппа=Строка.ЭтоГруппа;
		
		Если Строка.Строки.Количество()=0 И (НЕ Строка.ЭтоГруппа) Тогда
			
			Если Строка.СоответствиеРесурсовДляТрансляции.Количество()=0 Тогда
				
				НоваяСтрока.РесурсРегистра=Строка.РесурсРегистра;
				НоваяСтрока.ВидИтога=Строка.ВидИтога;
				НоваяСтрока.ДтКт=Строка.ДтКт;
				НоваяСтрока.Коэффициент=1;
				
			ИначеЕсли Строка.СоответствиеРесурсовДляТрансляции.Количество()=1 Тогда	
				
				СтрокаРесурс=Строка.СоответствиеРесурсовДляТрансляции[0];		
				НоваяСтрока.РесурсРегистра=СтрокаРесурс.РесурсИсточник;
				НоваяСтрока.ВидИтога=СтрокаРесурс.ВидИтога;
				НоваяСтрока.ДтКт=СтрокаРесурс.ДтКт;
				НоваяСтрока.Коэффициент=СтрокаРесурс.Коэффициент;
				
			Иначе
				
				Для Каждого СтрокаРесурс ИЗ Строка.СоответствиеРесурсовДляТрансляции Цикл
					
					СтрокаШаблона=НоваяСтрока.ПолучитьЭлементы().Добавить();
					СтрокаШаблона.ИсточникШаблон=Строка.Ссылка;
					СтрокаШаблона.ПредставлениеИсточника=СтрокаРесурс.ПредставлениеИсточник;
					СтрокаШаблона.РесурсРегистра=СтрокаРесурс.РесурсИсточник;
					СтрокаШаблона.ВидИтога=СтрокаРесурс.ВидИтога;
					СтрокаШаблона.ДтКт=СтрокаРесурс.ДтКт;
					СтрокаШаблона.Коэффициент=СтрокаРесурс.Коэффициент;
					
				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		ДобавитьСтрокиШаблоновРекурсивно(НоваяСтрока,Строка);
		
	КонецЦикла;
		
КонецПроцедуры // ДобавитьСтрокиШаблоновРекурсивно()

&НаСервере
Процедура ЗаполнитьПоРегиструКорреспонденции()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Представление(КорреспонденцииСчетов.ВидОперацииДокумента) КАК ВидОперацииДокумента,
	|	КорреспонденцииСчетов.СчетДт КАК СчетДт,
	|	КорреспонденцииСчетов.СчетКт КАК СчетКт
	|ИЗ
	|	РегистрСведений.КорреспонденцииСчетов КАК КорреспонденцииСчетов";
	

	ТабКорреспонденции=Запрос.Выполнить().Выгрузить();
	ТабКорреспонденции.Колонки.Добавить("ВидДвижения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	ТабКорреспонденции.Колонки.Добавить("СчетДтИтог",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	ТабКорреспонденции.Колонки.Добавить("СчетКтИтог",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	
	ПоСубсчетам=Элементы.ПоСубсчетам.Пометка;
	ПоВидамОпераций=Элементы.ПоВидамОпераций.Пометка;
	
	Для Каждого Строка ИЗ ТабКорреспонденции Цикл
		
		ТекстВидДвижения=СокрЛП(Строка.ВидОперацииДокумента);
		
		Строка.ВидДвижения=?(ПустаяСтрока(ТекстВидДвижения),НСтр("ru = 'Прочие'"),ТекстВидДвижения);
		
		Если ПоСубсчетам Тогда
			
			Строка.СчетДтИтог=Строка.СчетДт;
			Строка.СчетКтИтог=Строка.СчетКт;
			
		Иначе
			
			Строка.СчетДтИтог=?(СтрНайти(Строка.СчетДт,".")=0,Строка.СчетДт,Лев(Строка.СчетДт,СтрНайти(Строка.СчетДт,".")-1));
			Строка.СчетКтИтог=?(СтрНайти(Строка.СчетКт,".")=0,Строка.СчетКт,Лев(Строка.СчетКт,СтрНайти(Строка.СчетКт,".")-1));
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ТабКорреспонденции.Свернуть("ВидДвижения,СчетДтИтог,СчетКтИтог");
	
	Запрос.Текст="ВЫБРАТЬ
	|	СчетаБД.Ссылка КАК Ссылка,
	|	СчетаБД.Код КАК Код
	|ПОМЕСТИТЬ СчетаБД
	|ИЗ
	|	Справочник.СчетаБД КАК СчетаБД
	|ГДЕ
	|	СчетаБД.Владелец = &ПланСчетов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|ВЫБРАТЬ * Поместить ТабКорреспонденции
	|ИЗ &ТабКорреспонденции КАК ТабКорреспонденции
	|;";
	
	Запрос.УстановитьПараметр("ПланСчетов",ПланСчетов);
	Запрос.УстановитьПараметр("ТабКорреспонденции",ТабКорреспонденции);
	
	Если ПоВидамОпераций Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ВЫБРАТЬ
		|ТабКорреспонденции.ВидДвижения,
		|ТабКорреспонденции.СчетДтИтог,
		|ТабКорреспонденции.СчетКтИтог,
		|СчетаДт.Ссылка КАК Счет,
		|СчетаКт.Ссылка КАК КоррСчет
		|ИЗ ТабКорреспонденции КАК ТабКорреспонденции
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаДт ПО ТабКорреспонденции.СчетДтИтог=СчетаДт.Код
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаКт ПО ТабКорреспонденции.СчетКтИтог=СчетаКт.Код 
		|Упорядочить ПО ТабКорреспонденции.ВидДвижения, ТабКорреспонденции.СчетДтИтог,ТабКорреспонденции.СчетКтИтог
		|Итоги ПО ТабКорреспонденции.ВидДвижения";
		
		ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам),"ТаблицаКорреспонденции");
		
	Иначе
		
		Запрос.Текст=Запрос.Текст+"
		|ВЫБРАТЬ Различные
		|"""" КАК ВидДвижения,
		|ТабКорреспонденции.СчетДтИтог,
		|ТабКорреспонденции.СчетКтИтог,
		|СчетаДт.Ссылка КАК Счет,
		|СчетаКт.Ссылка КАК КоррСчет
		|ИЗ ТабКорреспонденции КАК ТабКорреспонденции
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаДт ПО ТабКорреспонденции.СчетДтИтог=СчетаДт.Код
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБД КАК СчетаКт ПО ТабКорреспонденции.СчетКтИтог=СчетаКт.Код 
		|Упорядочить ПО ТабКорреспонденции.СчетДтИтог,ТабКорреспонденции.СчетКтИтог";
		
		ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам),"ТаблицаКорреспонденции");
		
	КонецЕсли;	
		
КонецПроцедуры // ЗаполнитьПоРегиструКорреспонденции()

