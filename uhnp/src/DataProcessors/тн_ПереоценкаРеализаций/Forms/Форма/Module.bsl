
&НаКлиенте
Процедура Заполнить(Команда) 
	
	//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
	//Если СписокДокументов.Количество() > 0 Тогда	
	Если СписокДокументов.Количество() > 0 
		Или СписокПередачТоваровМеждуОрганизациями.Количество() > 0 Тогда	
	//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Таблица документов будет перезаполнена. Продолжить выполнение операции?", Режим, 0, КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
		    Возврат;
		КонецЕсли;
		СписокДокументов.Очистить();
		//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
		СписокПередачТоваровМеждуОрганизациями.Очистить();
		//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
	КонецЕсли;
	ЗаполнитьСписокДокументовНаСервере();  
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПроцентНаценки(Команда)
	ОткрытьФорму("Обработка.тн_ПереоценкаРеализаций.Форма.ВводПроцента",  
		,
		,,,,
		Новый ОписаниеОповещения("ВводПроцентаЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры    
	
&НаКлиенте
Процедура ВводПроцентаЗавершение(Результат, ДополнительныеПараметры) Экспорт  
	
	Если Результат <> Неопределено И Результат.Ответ = КодВозвратаДиалога.ОК Тогда
		МассивСсылок = Новый Массив;
		Для Каждого Строка Из СписокДокументов Цикл
			Если Строка.ПометкаВыделения Тогда 
				Строка.ПроцентНаценки = Результат.ПроцентнаяСтавка; 
				Строка.ЦенаПереоценкиБезНДС= Строка.СебестоимостьБезНДС + Строка.СебестоимостьБезНДС * Строка.ПроцентНаценки/100; 
				Строка.ЦенаПереоценкиСНДС= Строка.СебестоимостьСНДС + Строка.СебестоимостьСНДС * Строка.ПроцентНаценки/100;
			КонецЕсли;
		КонецЦикла;
		Элементы.СписокДокументов.Обновить();
		
		//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
		Для Каждого Строка Из СписокПередачТоваровМеждуОрганизациями Цикл
			Если Строка.ПометкаВыделения Тогда 
				Строка.ПроцентНаценки = Результат.ПроцентнаяСтавка; 
				Строка.ЦенаПереоценкиБезНДС= Строка.СебестоимостьБезНДС + Строка.СебестоимостьБезНДС * Строка.ПроцентНаценки/100; 
				Строка.ЦенаПереоценкиСНДС= Строка.СебестоимостьСНДС + Строка.СебестоимостьСНДС * Строка.ПроцентНаценки/100;
			КонецЕсли;
		КонецЦикла;
		Элементы.СписокПередачТоваровМеждуОрганизациями.Обновить();
		//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
//Качикина 05.07.2024 Выполнение задач №000049962
//Функция ПровестиВыбранныеРеализацииНаСервере()
Функция ПровестиВыбранныеРеализацииНаСервере(ИмяТаблицыДокументов = "СписокДокументов")
	ТекстСообщенияОшибки = ""; 
	//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
	//Для Каждого Строка Из СписокДокументов Цикл
	Для Каждого Строка Из ЭтаФорма[ИмяТаблицыДокументов] Цикл
	//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
		Если Строка.ПометкаВыделения И Строка.ПроцентНаценки > 0 Тогда 
			Попытка
				//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
				//ДокументРТУ = Строка.РеализацияТоваровИУслуг; 
				ДокументРТУ = Строка.ДокументСсылка; 
				//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
				ДокументРТУОбъект = ДокументРТУ.ПолучитьОбъект();
				Для Каждого СтрокаТовары Из ДокументРТУОбъект.Товары Цикл 
					Если СтрокаТовары.Номенклатура = Строка.Номенклатура И СтрокаТовары.КоличествоУпаковок = Строка.Количество  Тогда
						СтрокаТовары.Цена = ?(ДокументРТУ.ЦенаВключаетНДС, Строка.ЦенаПереоценкиСНДС, Строка.ЦенаПереоценкиБезНДС);							
						КэшированныеЗначения = Неопределено;		
						// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
						//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументРТУОбъект);
						СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументРТУОбъект);
						// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
						СтруктураДействий = Новый Структура;
						СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
						СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
						СтруктураДействий.Вставить("ПересчитатьСумму");						
						//НАЧАЛО Качикина 05.07.2024 Выполнение задач №00004992
						СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
						Если ИмяТаблицыДокументов = "СписокДокументов" Тогда
						//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
						СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
						СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
						//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
						//СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
						//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
						СтруктураДействий.Вставить("ПересчитатьСуммуСверхЗаказа", Новый Структура("РеализацияПоступлениеПоЗаказу, ТребуетсяЗалогЗаТару",
						ДокументРТУОбъект.РеализацияПоЗаказам, ДокументРТУОбъект.ТребуетсяЗалогЗаТару));
						//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
						КонецЕсли;
						//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
						// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
						//ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, КэшированныеЗначения);									
						ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, КэшированныеЗначения);									
						// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
					КонецЕсли;  
					
				КонецЦикла;				 
				ДокументРТУОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Строка.ПометкаВыделения = Ложь;
			Исключение	 
				ТекстСообщенияОшибки = ТекстСообщенияОшибки + 
				"Не удалось записать документ " + ДокументРТУ + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат ТекстСообщенияОшибки;	
КонецФункции

&НаКлиенте
Процедура ПровестиВыбранныеРеализации(Команда)
	ТекстСообщенияОшибки = ПровестиВыбранныеРеализацииНаСервере();  
	Если ТекстСообщенияОшибки <> "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОшибки);
	КонецЕсли;
	//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
	ТекстСообщенияОшибки = ПровестиВыбранныеРеализацииНаСервере("СписокПередачТоваровМеждуОрганизациями"); 
	Если ТекстСообщенияОшибки <> "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОшибки);
	КонецЕсли;
	//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962

КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ВыборПериода 		= Новый ДиалогРедактированияСтандартногоПериода();
	ВыборПериода.Период = Новый СтандартныйПериод;	 
	ОповещениеВыбора = Новый ОписаниеОповещения("ОбработкаВыбораПериода", ЭтотОбъект, 
		Новый Структура("ДиалогВыбораПериода", ВыборПериода));
	ВыборПериода.Показать(ОповещениеВыбора);
КонецПроцедуры

  &НаКлиенте
Процедура ОбработкаВыбораПериода(ВыборПериода, ДопПараметры) Экспорт
	
	Если ВыборПериода <> Неопределено Тогда  		
		Период.ДатаНачала = ВыборПериода.ДатаНачала;
		Период.ДатаОкончания = ВыборПериода.ДатаОкончания;
	КонецЕсли;   
	
КонецПроцедуры // ВыборПериода()  

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьКомпоновщик()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет("Макет");
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	
	Обработка.КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	Обработка.КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	ОтборКомпоновки = Обработка.КомпоновщикНастроек.Настройки.Отбор;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
КонецПроцедуры // ИнициализироватьКомпоновщик()

&НаКлиенте
Процедура УстановитьПометкиВТаблице(НоваяПометка)
	
	//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
	//Для Каждого СтрокаТЗ Из СписокДокументов Цикл
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПередачаТоваровМеждуОрганизациями Тогда
		ТаблицаСДокументами = СписокПередачТоваровМеждуОрганизациями;
	Иначе
		ТаблицаСДокументами = СписокДокументов;
	КонецЕсли;	
	Для Каждого СтрокаТЗ Из ТаблицаСДокументами Цикл		
	//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
		СтрокаТЗ.ПометкаВыделения = НоваяПометка;
	КонецЦикла; 
	
КонецПроцедуры // УстановитьПометкиВТаблице()

&НаСервере
Процедура ЗаполнитьСписокДокументовНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Обработка.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	Обработка.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", Период.ДатаОкончания);
	
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет("Макет");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Обработка.КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки); 
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	//НАЧАЛО Качикина 05.07.2024 Выполнение задач №000049962
	//ЗначениеВРеквизитФормы(Результат, "СписокДокументов");
	Для каждого СтрокаТЗ Из Результат Цикл
		Если ТипЗнч(СтрокаТЗ.ДокументСсылка) = Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
			НоваяСтрока = СписокПередачТоваровМеждуОрганизациями.Добавить();	
		Иначе
			НоваяСтрока = СписокДокументов.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
	КонецЦикла;
	//КОНЕЦ Качикина 05.07.2024 Выполнение задач №000049962
	
КонецПроцедуры // ЗаполнитьСписокДокументовНаСервере()

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	УстановитьПометкиВТаблице(Истина);
	
КонецПроцедуры // УстановитьПометки()

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	УстановитьПометкиВТаблице(Ложь);

КонецПроцедуры // СнятьПометки()

#КонецОбласти  
 
 &НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда 
		//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
		//Период.ДатаОкончания = тн_Интеграция_УПП.ТекущаяДатаСервера();
		Период.ДатаОкончания = ТекущаяДатаСервера();
		//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
		Период.ДатаНачала = НачалоМесяца(Период.ДатаОкончания);
	КонецЕсли;
	
КонецПроцедуры // ПриОткрытии()  

 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьКомпоновщик();
	
КонецПроцедуры // ПриСозданииНаСервере()
