// Борисенко Игорь 23.03.2025 Выполнение задач №000053134
Процедура УдалитьНекорректныеЗаписи(АдресРезультата) Экспорт
	
	РезультатФоновыхЗаданий = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Не РезультатФоновыхЗаданий.Свойство("ПараметрыУдаления") Тогда
		Возврат;
	КонецЕсли;
	Если Не РезультатФоновыхЗаданий.Свойство("ТаблицаНастройкиШаблоновНеСоответствуютПараметрам") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыУдаления 									= РезультатФоновыхЗаданий.ПараметрыУдаления;
	ТаблицаНастройкиШаблоновНеСоответствуютПараметрам 	= РезультатФоновыхЗаданий.ТаблицаНастройкиШаблоновНеСоответствуютПараметрам;

	Измерения = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей().Метаданные().Измерения;
	
	Для каждого КлючЗаписи Из ПараметрыУдаления.Ключи_ОтражениеДокументовПоШаблонам_КУдалению Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			//Блокировка: т.к. сначала читаем запись, а затем удаляем ее
			Блокировка = Новый БлокировкаДанных;
			элБлокировки = Блокировка.Добавить("РегистрСведений.ОтражениеДокументовПоШаблонам");
			элБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Для каждого Измерение Из Измерения Цикл
				ИмяПоля = Измерение.Имя;
				элБлокировки.УстановитьЗначение(ИмяПоля, КлючЗаписи[ИмяПоля]);
			КонецЦикла;
			Блокировка.Заблокировать();
			
			Запись = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, КлючЗаписи);
			Запись.Прочитать();

			//Пометка на удления Док.ТрансформационнаяКорректировка
			ДокументОбъект = Запись.ДокументПервогоОтражения.ПолучитьОбъект();   
			ДокументОбъект.Проведен = Ложь;
			ДокументОбъект.ПометкаУдаления = Истина;  
			ДокументОбъект.ОбменДанными.Загрузка = Истина; // Т.к. сюда попадает документ ТК, с пустыми движениями
			ДокументОбъект.Записать();
			
			//Удаление записей рс.ОтражениеДокументовПоШаблонам
			Запись.Удалить();
			
			//Удаление строк тз.ТаблицаНастройкиШаблоновНеСоответствуютПараметрам
			МассивСтрокиТЗКУдалению = ТаблицаНастройкиШаблоновНеСоответствуютПараметрам.НайтиСтроки(Новый Структура("ИсходныйДокумент", КлючЗаписи.ИсходныйДокумент));
			Для Каждого Строка Из МассивСтрокиТЗКУдалению Цикл 
				ТаблицаНастройкиШаблоновНеСоответствуютПараметрам.Удалить(Строка);				
			КонецЦикла;
		
			ЗафиксироватьТранзакцию();
		
		Исключение
			ОтменитьТранзакцию();
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

// Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
//
Процедура СостояниеОтраженияЗаписейПоШаблонамТКСФлагомТрансляции(Параметры, АдресРезультата)  Экспорт
	
	ТаблицаЗаписиПоШаблонамТКСФлагомТрансляция = Новый ТаблицаЗначений;   
	ТаблицаЗаписиПоШаблонамТКСФлагомТрансляция.Колонки.Добавить("ИсходныйДокумент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.МассивОрганизаций);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаОкончания, Дата(3999, 12, 31)));
	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаНачала, Дата(1,1,1)));
	
	Запрос.Текст = ПолучитьТекстЗапросаПоОбъектамБД(Неопределено, Параметры.МассивОрганизаций);   
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МассивДокументов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			МассивДокументов.Добавить(Выборка.ИсходныйДокумент);	
		КонецЦикла;
		
		Запрос.Текст =     
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент
			|ИЗ
			|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
			|ГДЕ
			|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент В(&МассивДокументов)
			|	И ОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансформационныхКорректировок
			|	И ОтражениеДокументовПоШаблонам.Трансляция";   
		
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		
		ТаблицаЗаписиПоШаблонамТКСФлагомТрансляция = Запрос.Выполнить().Выгрузить();
		
