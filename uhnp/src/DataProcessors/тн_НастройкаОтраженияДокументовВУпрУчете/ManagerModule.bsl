#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
 
Функция ПолучитьТекстЗапросаПоОбъектамБД(Выборка, Организация, Поместить = Ложь) Экспорт
	
	ТестЗапросаВидыОбъектов = "";
	ЭтоПервыйБлок = Истина;  
	
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	Если Выборка = Неопределено Тогда
		
		Для Каждого Документ Из Метаданные.Документы Цикл
			ТекНаименованиеОбъектаМетаданных = Документ.Имя; 
			
			Если ТекНаименованиеОбъектаМетаданных = "Трансляция"
				Или ТекНаименованиеОбъектаМетаданных = "ТрансформационнаяКорректировка" Тогда 
				Продолжить;	
			КонецЕсли;
			
			МетаданныеДокумента = Метаданные.Документы.Найти(ТекНаименованиеОбъектаМетаданных);
			Если МетаданныеДокумента <> Неопределено Тогда				
				
				Если Не ЭтоПервыйБлок Тогда
					ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов + "
					|	ОБЪЕДИНИТЬ ВСЕ ";
				КонецЕсли;
				
				ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов +"
				|ВЫБРАТЬ 
				|	Таблица.Ссылка КАК ИсходныйДокумент" 
				+ ?(Поместить И ЭтоПервыйБлок,"
				| ПОМЕСТИТЬ втТаблица", "") + "
				|ИЗ
				|	Документ." + ТекНаименованиеОбъектаМетаданных + " КАК Таблица
				|ГДЕ
				|	Таблица.Проведен 
				|   И Не Таблица.ПометкаУдаления   
				|	И Таблица.Дата <= &ДатаОкончания
				|	И Таблица.Дата >= &ДатаНачала";
				
				Если ЗначениеЗаполнено(Организация) И МетаданныеДокумента.Реквизиты.Найти("Организация") <> Неопределено Тогда
					ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов + "
					|  И Таблица.Организация В (&МассивОрганизаций)";
				КонецЕсли;
				
				ЭтоПервыйБлок = Ложь;
			КонецЕсли;
		КонецЦикла;  
		
	Иначе
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
		
		Пока Выборка.Следующий() Цикл
			ТекНаименованиеОбъектаМетаданных = Выборка.ОбъектБД.Наименование; 
			МетаданныеДокумента = Метаданные.Документы.Найти(ТекНаименованиеОбъектаМетаданных);
			Если МетаданныеДокумента <> Неопределено Тогда				
				
				Если Не ЭтоПервыйБлок Тогда
					ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов + "
					|	ОБЪЕДИНИТЬ ВСЕ ";
				КонецЕсли;
				
				ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов +"
				|ВЫБРАТЬ 
				|	Таблица.Ссылка КАК ИсходныйДокумент" 
				+ ?(Поместить И ЭтоПервыйБлок,"
				| ПОМЕСТИТЬ втТаблица", "") + "
				|ИЗ
				|	Документ." + ТекНаименованиеОбъектаМетаданных + " КАК Таблица
				|ГДЕ
				|	Таблица.Проведен 
				|   И Не Таблица.ПометкаУдаления   
				|	И Таблица.Дата <= &ДатаОкончания
				|	И Таблица.Дата >= &ДатаНачала";
				
				Если ЗначениеЗаполнено(Организация) И МетаданныеДокумента.Реквизиты.Найти("Организация") <> Неопределено Тогда
					ТестЗапросаВидыОбъектов = ТестЗапросаВидыОбъектов + "
					|  И Таблица.Организация В (&МассивОрганизаций)";
				КонецЕсли;
				
				ЭтоПервыйБлок = Ложь;
			КонецЕсли;
		КонецЦикла;  
		
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	
	Возврат ТестЗапросаВидыОбъектов;
	
КонецФункции
 
Процедура СостояниеОтраженияДокументовЕстьШаблоныПроводок(Параметры, АдресРезультата) Экспорт
	
	ТаблицаОбработатьНеобработанныеЗаписи = Новый ТаблицаЗначений;   
	ТаблицаОбработатьНеобработанныеЗаписи.Колонки.Добавить("ИсходныйДокумент");
	
	ТаблицаПерепроведениеИсходныхДокументов = Новый ТаблицаЗначений; 
	ТаблицаПерепроведениеИсходныхДокументов.Колонки.Добавить("ИсходныйДокумент"); 
	
	ТаблицаПерепроведениеИсходныхДокументовВФоне = Новый ТаблицаЗначений; 
	ТаблицаПерепроведениеИсходныхДокументовВФоне.Колонки.Добавить("ИсходныйДокумент"); 
	
	// НАЧАЛО Борисенко Игорь 23.03.2025 Выполнение задач №000053134
	ПараметрыУдаления = Новый Структура("ЕстьЗаписи_ОтражениеДокументовПоШаблонам_КУдалению", Ложь);
	// КОНЕЦ Борисенко Игорь 23.03.2025 Выполнение задач №000053134
	
	ТаблицаНастройкиШаблоновНеСоответствуютПараметрам = Новый ТаблицаЗначений; 
	ТаблицаНастройкиШаблоновНеСоответствуютПараметрам.Колонки.Добавить("ИсходныйДокумент"); 
	
	// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044
	ТаблицаНетПроводок = Новый ТаблицаЗначений; 
	ТаблицаНетПроводок.Колонки.Добавить("ИсходныйДокумент"); 
	// КОНЕЦ Гутарова Екатерина 30.06.2023 Выполнение задач №000046044
	
	// НАЧАЛО Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	ТаблицаРазличныеШаблоны = Новый ТаблицаЗначений; 
	ТаблицаРазличныеШаблоны.Колонки.Добавить("ИсходныйДокумент");
	// КОНЕЦ  Белоконенко Денис 19.07.2023 Выполнение задач №000046209	
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаОбработатьНеобработанныеЗаписи",             ТаблицаОбработатьНеобработанныеЗаписи);
	Результат.Вставить("ТаблицаПерепроведениеИсходныхДокументов",           ТаблицаПерепроведениеИсходныхДокументов);
	Результат.Вставить("ТаблицаПерепроведениеИсходныхДокументовВФоне",      ТаблицаПерепроведениеИсходныхДокументовВФоне);
	Результат.Вставить("ТаблицаНастройкиШаблоновНеСоответствуютПараметрам", ТаблицаНастройкиШаблоновНеСоответствуютПараметрам);
	// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044 
	Результат.Вставить("ТаблицаНетПроводок",                                ТаблицаНетПроводок);
	// КОНЕЦ Гутарова Екатерина 30.06.2023 Выполнение задач №000046044
 	// НАЧАЛО Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	Результат.Вставить("ТаблицаРазличныеШаблоны",                           ТаблицаРазличныеШаблоны);
	// КОНЕЦ  Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	
	Запрос = Новый Запрос;     
	
	Запрос.Текст =     
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокументыБД.Ссылка КАК ОбъектБД
	|ИЗ
	|	Справочник.ДокументыБД КАК ДокументыБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
	|		ПО ДокументыБД.Ссылка = ШаблоныТрансформационныхКорректировок.ДокументБД
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
	//|			И (ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ))
	//|ГДЕ
	//|	НЕ ДокументыБД.тн_НеОтражатьВУУ 
	|			И (ШаблоныТрансформационныхКорректировок.тн_ТипУчета = &ТипУчета)
	|ГДЕ
	|	НЕ ДокументыБД.тн_НеОтражатьВУУ 
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	|	И НЕ ДокументыБД.ОтсутствуетВКонфигурации
	|	И ДокументыБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И НЕ ШаблоныТрансформационныхКорректировок.Ссылка ЕСТЬ NULL";
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.МассивОрганизаций);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаОкончания, Дата(2399, 1, 1)));
	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаНачала, Дата(1,1,1)));
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
	ТипУчета = ?(Параметры.ВариантАнализа = 0, Перечисления.тн_ТипыУчета.УчетУУ, Перечисления.тн_ТипыУчета.УчетМСФО); 	
	Запрос.УстановитьПараметр("ТипУчета", ТипУчета);  
	Если  Параметры.ВариантАнализа = 1 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ ДокументыБД.тн_НеОтражатьВУУ","Истина");  
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	
	Выборка =  Запрос.Выполнить().Выбрать();
	
	Запрос.Текст = ПолучитьТекстЗапросаПоОбъектамБД(Выборка, Параметры.МассивОрганизаций);   
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МассивДокументов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			МассивДокументов.Добавить(Выборка.ИсходныйДокумент);	
		КонецЦикла;
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтражениеДокументов.ИсходныйДокумент КАК ИсходныйДокумент,
		|	КОЛИЧЕСТВО(ОтражениеДокументов.Трансляция) КАК Количество
		|ИЗ
		|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументов
		|ГДЕ
		|	ОтражениеДокументов.ИсходныйДокумент В(&МассивДокументов)
		// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044   
		|	И Не ОтражениеДокументов.Трансляция 
		|	И ОтражениеДокументов.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансформационныхКорректировок
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
		//|	И ОтражениеДокументов.ШаблонОперации.тн_ТипУчета = Значение(Перечисление.тн_ТипыУчета.УчетУУ)  
		|	И ОтражениеДокументов.ШаблонОперации.тн_ТипУчета = &ТипУчета 
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
		// КОНЕЦ Гутарова Екатерина 30.06.2023 Выполнение задач №000046044
		|
		|СГРУППИРОВАТЬ ПО
		|	ОтражениеДокументов.ИсходныйДокумент
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(ОтражениеДокументов.Трансляция) = 1
		|";  
		
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);

		ТЗ = Запрос.Выполнить().Выгрузить();
		Массив = ТЗ.ВыгрузитьКолонку("ИсходныйДокумент");
		Запрос.УстановитьПараметр("Массив", Массив);
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ОтражениеДокументов.ИсходныйДокумент КАК ИсходныйДокумент,
		               |	ОтражениеДокументов.Организация КАК Организация,
		               |	ОтражениеДокументов.ОбработкаВыполнена КАК ОбработкаВыполнена,
		               |	ОтражениеДокументов.ШаблонОперации КАК ШаблонОперации,
		               |	ОтражениеДокументов.Трансляция КАК Трансляция,
		               |	ОтражениеДокументов.ПроведениеОтменено КАК ПроведениеОтменено,
		               |	ОтражениеДокументов.ОтражениеФоновымЗаданием КАК ОтражениеФоновымЗаданием,
		               |	НЕ ТрансформационнаяКорректировкаПроводки.Ссылка ЕСТЬ NULL КАК ИмеютсяПроводки
		               |ИЗ
		               |	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТрансформационнаяКорректировка.Проводки КАК ТрансформационнаяКорректировкаПроводки
		               |		ПО ОтражениеДокументов.ДокументПервогоОтражения = ТрансформационнаяКорректировкаПроводки.Ссылка
		               |			И (ТрансформационнаяКорректировкаПроводки.НомерСтроки = 1)
		               |ГДЕ
		               |	ОтражениеДокументов.ИсходныйДокумент В(&Массив)   
					   // НАЧАЛО Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584    
					   //|	И ОтражениеДокументов.Организация = &МассивОрганизаций";       
					   |	И ОтражениеДокументов.Организация В (&МассивОрганизаций)";  
					   // КОНЕЦ Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584    
	    Если Не ЗначениеЗаполнено(Параметры.МассивОрганизаций) Тогда 
		    // НАЧАЛО Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584    
		    // Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ОтражениеДокументов.Организация = &МассивОрганизаций", "");	
		    Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ОтражениеДокументов.Организация В (&МассивОрганизаций)", "");
		    // КОНЕЦ Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584    
	    КонецЕсли;		
		Выборка = Запрос.Выполнить().Выбрать();
				
		Пока Выборка.Следующий() Цикл  
			
			Если ТипЗнч(Выборка.ШаблонОперации) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок")  
				// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
				//И Выборка.ШаблонОперации.тн_ТипУчета = Перечисления.тн_ТипыУчета.УчетУУ Тогда  
				И Выборка.ШаблонОперации.тн_ТипУчета = ТипУчета Тогда
				// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
			Если Выборка.ОбработкаВыполнена = Перечисления.ДаНет.нет Тогда  
				//		2.1.1.	Необходимо обработать необработанные записи
				НС = ТаблицаОбработатьНеобработанныеЗаписи.Добавить();
				ЗаполнитьЗначенияСвойств(НС, Выборка);
			ИначеЕсли Не Выборка.ПроведениеОтменено 
				И Выборка.ОбработкаВыполнена = Перечисления.ДаНет.да 
				И Не Выборка.ОтражениеФоновымЗаданием  Тогда
				Если Не Выборка.ИмеютсяПроводки Тогда
					//				2.1.2.1.2.	Настройки шаблонов не соответствуют параметрам Исходного документа
					//					ЕСЛИ по документу трансформационной корректировки нет проводок
					НС = ТаблицаНастройкиШаблоновНеСоответствуютПараметрам.Добавить(); 
					ЗаполнитьЗначенияСвойств(НС, Выборка);
				КонецЕсли;
			ИначеЕсли Выборка.ПроведениеОтменено Тогда   
				ДанныеДляПроверки = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
				
				НоваяСтрока = ДанныеДляПроверки.Добавить();
				НоваяСтрока.Дата   = Выборка.ИсходныйДокумент.Дата;
				НоваяСтрока.Объект = Выборка.Организация;
				// НАЧАЛО Белоконенко Денис 07.05.2026 Выполнение задач №000057385 
				НоваяСтрока.Раздел = "УчетПоМСФО";
				// КОНЕЦ Белоконенко Денис 07.05.2026 Выполнение задач №000057385
				
				ОписаниеДанных = Новый Структура;
				ОписаниеДанных.Вставить("НоваяВерсия", Истина);
				ОписаниеДанных.Вставить("Данные",      Выборка.ИсходныйДокумент);
				
				ОписаниеОшибки = "";
				Если ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ДанныеДляПроверки, ОписаниеДанных, ОписаниеОшибки) Тогда
					
					НС = ТаблицаПерепроведениеИсходныхДокументовВФоне.Добавить(); 
					ЗаполнитьЗначенияСвойств(НС, Выборка);
					//			2.1.3.2.	Следует удостовериться, что Исходный документ проведён и не помечен на удаление, и установить значение в записи по документу:
					//				ЕСЛИ период для проведения Исходных документов закрыт
					
				Иначе
					//			2.1.3.1.	Требуется перепроведение Исходного документа
