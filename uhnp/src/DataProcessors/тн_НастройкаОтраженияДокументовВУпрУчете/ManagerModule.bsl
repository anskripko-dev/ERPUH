	//|			И (ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ))    
	|			И (ШаблоныТрансформационныхКорректировок.тн_ТипУчета = &ТипУчета)
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	|ГДЕ
	|	НЕ ДокументыБД.тн_НеОтражатьВУУ 
	|	И НЕ ДокументыБД.ОтсутствуетВКонфигурации
	|	И ДокументыБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И ШаблоныТрансформационныхКорректировок.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.МассивОрганизаций);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаОкончания, Дата(2399, 1, 1)));
	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаНачала, Дата(1,1,1)));
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
	ТипУчета = ?(Параметры.ВариантАнализа = 0, Перечисления.тн_ТипыУчета.УчетУУ, Перечисления.тн_ТипыУчета.УчетМСФО); 	
	Запрос.УстановитьПараметр("ТипУчета", ТипУчета);
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Запрос.Текст = ПолучитьТекстЗапросаПоОбъектамБД(Выборка, Параметры.МассивОрганизаций, Истина);
		
		Запрос.Текст = Запрос.Текст + "				
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТИПЗНАЧЕНИЯ(втТаблица.ИсходныйДокумент) КАК ТипЗначения
		|ИЗ
		|	втТаблица КАК втТаблица";
		
		РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		Выборка = РезультатЗапроса[1].Выбрать();
		
		МассивСтрокиИнформации = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			МассивСтрокиИнформации.Добавить(Выборка.ТипЗначения);
		КонецЦикла;  
		
		Если Выборка.Количество() > 0 Тогда 
			ИнформацияНетШаблоновПроводок = "Не найдены шаблоны трансформационных корректировок по следующим видам документов: " + СтрСоединить(МассивСтрокиИнформации, ", ");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("ИнформацияНетШаблоновПроводок", ИнформацияНетШаблоновПроводок);
	Результат.Вставить("ТаблицаНетШаблоновПроводок", РезультатЗапроса[0].Выгрузить());     
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

// Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
//
Процедура СостояниеОтраженияДокументовТрансляции(Параметры, АдресРезультата) Экспорт
	
	ТаблицаОбработатьНеобработанныеЗаписи = Новый ТаблицаЗначений;   
	ТаблицаОбработатьНеобработанныеЗаписи.Колонки.Добавить("ИсходныйДокумент");
	
	ТаблицаТрансляцииЕстьМэппинг = Новый ТаблицаЗначений;   
	ТаблицаТрансляцииЕстьМэппинг.Колонки.Добавить("ИсходныйДокумент");
	
	ТаблицаТрансляцииНетМэппинга = Новый ТаблицаЗначений;   
	ТаблицаТрансляцииНетМэппинга.Колонки.Добавить("ИсходныйДокумент");
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаОбработатьНеобработанныеЗаписи", ТаблицаОбработатьНеобработанныеЗаписи);
	Результат.Вставить("ТаблицаТрансляцииЕстьМэппинг", ТаблицаТрансляцииЕстьМэппинг);
	Результат.Вставить("ТаблицаТрансляцииНетМэппинга", ТаблицаТрансляцииНетМэппинга);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивОрганизаций", Параметры.МассивОрганизаций);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаОкончания, Дата(2399, 1, 1)));
	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(Параметры.Период), Параметры.Период.ДатаНачала, Дата(1,1,1)));
	
	Запрос.Текст = ПолучитьТекстЗапросаПоОбъектамБД(Неопределено, Параметры.МассивОрганизаций);   
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МассивДокументов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			МассивДокументов.Добавить(Выборка.ИсходныйДокумент);	
		КонецЦикла;
		
		Запрос.Текст =     
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент
		|ИЗ
		|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
		|ГДЕ
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент В(&МассивДокументов)
		|	И ОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансляций
		|	И ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.нет)";   
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		
		ТаблицаОбработатьНеобработанныеЗаписи = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ШаблонТрансляций) Тогда
		
		ЗапросПО = Новый Запрос;
		ЗапросПО.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПравилаОбработки КАК ПравилаОбработки
		|ГДЕ
		|	ПравилаОбработки.НаправлениеТрансляции = &НаправлениеТрансляции
		|	И ПравилаОбработки.Владелец = &Владелец";
		
		ЗапросПО.УстановитьПараметр("НаправлениеТрансляции", Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии);
		ЗапросПО.УстановитьПараметр("Владелец", Параметры.ШаблонТрансляций);
		
		РезультатПО = ЗапросПО.Выполнить().Выбрать();
		
		Если РезультатПО.Следующий() Тогда
			ПравилоОбработки = РезультатПО.Ссылка;
			
			Запрос.Текст = Обработки.КорректировкиЗначенийПоказателей.ПолучитьИсточникТрансляции();
			Запрос.УстановитьПараметр("НазначениеРасчетов", ПравилоОбработки);
			
			мОперанды = Запрос.Выполнить().Выгрузить();
			
			Если мОперанды.Количество() > 0 Тогда
				
				ЗапросРесурсы = Новый Запрос;
				ЗапросРесурсы.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РегистрыБухгалтерииБДРесурсы.Имя КАК РесурсИсточник,
				|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК Отображать,
				|	ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник,
				|	РегистрыБухгалтерииБДРесурсы.Балансовый КАК РесурсИсточникБалансовый
				|ИЗ
				|	Справочник.ШаблоныТрансляций.СоответствиеРесурсов КАК ШаблоныТрансляцийСоответствиеРесурсов
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрыБухгалтерииБД.Ресурсы КАК РегистрыБухгалтерииБДРесурсы
				|		ПО ШаблоныТрансляцийСоответствиеРесурсов.Ссылка.РегистрБухгалтерииИсточник = РегистрыБухгалтерииБДРесурсы.Ссылка
				|			И ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = РегистрыБухгалтерииБДРесурсы.Имя
				|ГДЕ
				|	ШаблоныТрансляцийСоответствиеРесурсов.Ссылка = &Ссылка
				|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсИсточник = """"
				|	И НЕ ШаблоныТрансляцийСоответствиеРесурсов.РесурсПриемник = """"";
				
				ЗапросРесурсы.УстановитьПараметр("Ссылка", Параметры.ШаблонТрансляций);
				РесурсыДляОтображения =  ЗапросРесурсы.Выполнить().Выгрузить();
				
				мОперанды.Колонки.Код.Имя = "Имя";
				мОперанды.Колонки.Добавить("Код");
				
				Для Каждого Стр Из мОперанды Цикл
					Стр.Код = СокрЛП(Стр.Имя);
				КонецЦикла;
				
				мОперанды.Колонки.Удалить(мОперанды.Колонки.Имя);	
				мОперанды.Индексы.Добавить("Код");
				
				мОперанды.Колонки.Добавить("АналитикВидаОтчета",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(1,0));
				мОперанды.Колонки.Добавить("Ресурс",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
				мОперанды.Колонки.Добавить("ПравилаВычисленияПараметровЗапроса");
				
				СтрОперанд=мОперанды[0];
				СтрОперанд.ПравилаИспользованияПолейЗапроса.Очистить();
				
				ТекстРесурсыИсточник="";
				
				Для Каждого СтрРесурс Из РесурсыДляОтображения Цикл
					
					Если НЕ СтрРесурс.Отображать Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрРесурс.РесурсИсточникБалансовый Тогда
						
						ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
						|СУММА("+СтрРесурс.РесурсИсточник+") КАК "+СтрРесурс.РесурсИсточник;
						
						ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
						ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник;
						ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник;
						ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник;
						
					Иначе
						
						ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
						ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Дт";
						ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Дт";
						ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Дт";
						
						ПолеРесурс=СтрОперанд.ПравилаИспользованияПолейЗапроса.Добавить();
						ПолеРесурс.Поле			= СтрРесурс.РесурсИсточник+"Кт";
						ПолеРесурс.Синоним		= СтрРесурс.РесурсИсточник+"Кт";
						ПолеРесурс.КодАналитики	= СтрРесурс.РесурсПриемник+"Кт";
						
						ТекстРесурсыИсточник=ТекстРесурсыИсточник+",
						|СУММА("+СтрРесурс.РесурсИсточник+"Дт) КАК "+СтрРесурс.РесурсИсточник+"Дт,
						|СУММА("+СтрРесурс.РесурсИсточник+"Кт) КАК "+СтрРесурс.РесурсИсточник+"Кт";
						
					КонецЕсли;
					
				КонецЦикла;
												
				ТекстОтбора=СтрОперанд.ТекстОтбора;
								
				СтрОперанд.ТекстЗапросаМодуля="ВЫБРАТЬ " + Сред(ТекстРесурсыИсточник,2) + " {ВЫБРАТЬ СчетДт.*,СчетКт.*,Регистратор.*} ИЗ РегистрБухгалтерии." + Параметры.ШаблонТрансляций.РегистрБухгалтерииИсточник + ".ДвиженияССубконто({&ДатаНач}, {&ДатаКон},Активность "+?(ПустаяСтрока(СтрОперанд.ТекстОтбора),""," И "+СтрОперанд.ТекстОтбора)+")";
				
				ДанныеРасчета = УправлениеОтчетамиУХ.ПодготовитьОперандыДляПолученияДанных(мОперанды,Ложь,,,Ложь);
				
				СтрЗапрос = ДанныеРасчета.мТабПоказателиЗапросы[0];
				
				ДанныеОбъекта = Новый Структура;
				ДанныеОбъекта.Вставить("Организация",	Параметры.МассивОрганизаций);
				ДанныеОбъекта.Вставить("ПериодОтчета",	Параметры.Период);
				ДанныеОбъекта.Вставить("Сценарий",		Константы.СценарийМСФО.Получить());
				ДанныеОбъекта.Вставить("ИспользуемаяИБ", Справочники.ВнешниеИнформационныеБазы.ПустаяСсылка());
				ДанныеОбъекта.Вставить("Регистратор",	Неопределено);
				ДанныеОбъекта.Вставить("АнализЧувствительности", Ложь);
				ДанныеОбъекта.Вставить("База", Неопределено);
				
				ТаблицаДанныхИсточник=УправлениеОтчетамиУХ.ПолучитьТаблицуПоИсточникуВнутрРегистрНакопления(ДанныеОбъекта,СтрЗапрос);
				ТаблицаДанныхИсточник.Колонки.Добавить("СуммаИсключения",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
				
				Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
				
				Если ТаблицаДанныхИсточник.Колонки.Найти("Период")=Неопределено Тогда
					
					ТаблицаДанныхИсточник.Колонки.Добавить("Период",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
					
				КонецЕсли;
				
				Если ТаблицаДанныхИсточник.Колонки.Найти("Организация")=Неопределено Тогда
					
					ТаблицаДанныхИсточник.Колонки.Добавить("Организация",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Организации"));
					
				КонецЕсли;
				//НАЧАЛО Блинова М.А. 08.09.2025 Выполнение задач №000054939  
				Если ТаблицаДанныхИсточник.Колонки.Найти("Сумма")=Неопределено Тогда
					
					ТаблицаДанныхИсточник.Колонки.Добавить("Сумма", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
					
				КонецЕсли; 
				Если ТаблицаДанныхИсточник.Колонки.Найти("Регистратор")=Неопределено Тогда  
					
					ОписаниеТиповСсылка = Новый ОписаниеТипов(Документы.ТипВсеСсылки()); 
					ТаблицаДанныхИсточник.Колонки.Добавить("Регистратор", ОписаниеТиповСсылка);
					
				КонецЕсли;
				//КОНЕЦ Блинова М.А. 08.09.2025 Выполнение задач №000054939
				
				Запрос.Текст = "ВЫБРАТЬ
				|	ТаблицаДанныхИсточник.Счет КАК СчетДтИсточникКод,
				|	ТаблицаДанныхИсточник.КоррСчет КАК СчетКтИсточникКод,
				|	ТаблицаДанныхИсточник.Сумма КАК Сумма,
				|	ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
				|	ТаблицаДанныхИсточник.Регистратор КАК ДокументРСБУ
				|ПОМЕСТИТЬ ТаблицаДанныхИсточник
				|ИЗ
				|	&ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СчетаБД.Ссылка КАК СчетБД,
				|	СчетаБД.СчетСсылка КАК СчетСсылка
				|ПОМЕСТИТЬ СчетаПриемник
				|ИЗ
				|	Справочник.СчетаБД КАК СчетаБД
				|ГДЕ
				|	СчетаБД.Владелец = &ПланСчетовПриемник
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	СчетаБД.СчетСсылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СчетаБД.Ссылка КАК СчетБД,
				|	СчетаБД.Код КАК СчетКод
				|ПОМЕСТИТЬ СчетаИсточник
				|ИЗ
				|	Справочник.СчетаБД КАК СчетаБД
				|ГДЕ
				|	СчетаБД.Владелец = &ПланСчетовИсточник
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	СчетаБД.Код
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ОтражениеДокументовПоШаблонам.ДокументРСБУ КАК ДокументРСБУ,
				|	ОтражениеДокументовПоШаблонам.ДокументМСФО КАК ДокументМСФО
				|ПОМЕСТИТЬ ОДПШ
				|ИЗ
				|	(ВЫБРАТЬ
				|		ТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ,
				|		ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения КАК ДокументМСФО
				|	ИЗ
				|		ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
				|				ПО ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = МСФО.Регистратор
				|					И (МСФО.НомерСтроки = 1)
				|			ПО ТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
				|	ГДЕ
				|		ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
				|		И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО
				|	
				|	ОБЪЕДИНИТЬ ВСЕ
				|	
				|	ВЫБРАТЬ
				|		ТаблицаДанныхИсточник.ДокументРСБУ,
				|		ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения
				|	ИЗ
				|		ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.МСФО КАК МСФО
				|				ПО ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения = МСФО.Регистратор
				|					И (МСФО.НомерСтроки = 1)
				|			ПО ТаблицаДанныхИсточник.ДокументРСБУ = ОтражениеДокументовПоШаблонам.ИсходныйДокумент
				|	ГДЕ
				|		(ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения <> НЕОПРЕДЕЛЕНО
				|					И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения <> НЕОПРЕДЕЛЕНО
				|				ИЛИ ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения = НЕОПРЕДЕЛЕНО
				|					И ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения = НЕОПРЕДЕЛЕНО)
				|		И ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения <> НЕОПРЕДЕЛЕНО) КАК ОтражениеДокументовПоШаблонам"; 
				
				Запрос.УстановитьПараметр("Организация", Параметры.МассивОрганизаций);
				Запрос.УстановитьПараметр("Сценарий", Константы.СценарийМСФО.Получить());
				Запрос.УстановитьПараметр("ПланСчетовПриемник", Параметры.ШаблонТрансляций.ПланСчетовПриемник);
				
				Запрос.УстановитьПараметр("ДатаНач", Параметры.Период.ДатаНачала);
				Запрос.УстановитьПараметр("ДатаКон", Параметры.Период.ДатаОкончания);
				
				Запрос.УстановитьПараметр("ПланСчетовИсточник", Параметры.ШаблонТрансляций.ПланСчетовИсточник);
				Запрос.УстановитьПараметр("ИсходныйДокумент", Неопределено);
				Запрос.УстановитьПараметр("ДокументТрансляции", Документы.Трансляция.ПустаяСсылка());
				Запрос.УстановитьПараметр("ТаблицаДанныхИсточник", ТаблицаДанныхИсточник);
				
				Запрос.Выполнить();
				
				Запрос.Текст = "ВЫБРАТЬ
				|	СравнениеОборотов.СчетДтИсточник КАК СчетДтИсточник,
				|	СравнениеОборотов.СчетКтИсточник КАК СчетКтИсточник,
				|	СравнениеОборотов.СчетДтПриемник КАК СчетДтПриемник,
				|	СравнениеОборотов.СчетКтПриемник КАК СчетКтПриемник,
				|	СравнениеОборотов.Сумма КАК Сумма,
				|	СравнениеОборотов.СуммаИсключения КАК СуммаИсключения,
				|	СравнениеОборотов.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
				|	СравнениеОборотов.Расхождение_Сумма_СуммаВВалютеУчета КАК Расхождение_Сумма_СуммаВВалютеУчета,
				|	СравнениеОборотов.СчетДтИсточник.Код,
				|	СравнениеОборотов.СчетКтИсточник.Код,
				|	СравнениеОборотов.СчетДтПриемник.Код,
				|	СравнениеОборотов.СчетКтПриемник.Код,
				|	СравнениеОборотов.Регистратор КАК ДокументМСФО,
				|	СравнениеОборотов.ДокументРСБУ КАК ДокументРСБУ
				|ИЗ
				|	(ВЫБРАТЬ
				|		ОбъединениеДанных.СчетДтИсточник КАК СчетДтИсточник,
				|		ОбъединениеДанных.СчетКтИсточник КАК СчетКтИсточник,
				|		ОбъединениеДанных.СчетДтПриемник КАК СчетДтПриемник,
				|		ОбъединениеДанных.СчетКтПриемник КАК СчетКтПриемник,
				|		СУММА(ОбъединениеДанных.Сумма) КАК Сумма,
				|		СУММА(ОбъединениеДанных.СуммаИсключения) КАК СуммаИсключения,
				|		СУММА(ОбъединениеДанных.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
				|		СУММА(ОбъединениеДанных.Сумма - ОбъединениеДанных.СуммаВВалютеУчета) КАК Расхождение_Сумма_СуммаВВалютеУчета,
				|		ОбъединениеДанных.Регистратор КАК Регистратор,
				|		ОбъединениеДанных.ДокументРСБУ КАК ДокументРСБУ
				|	ИЗ
				|		(ВЫБРАТЬ
				|			СчетаБДИсточникДт.Ссылка КАК СчетДтИсточник,
				|			СчетаБДИсточникКт.Ссылка КАК СчетКтИсточник,
				|			ТаблицаДанныхИсточник.Сумма КАК Сумма,
				|			ТаблицаДанныхИсточник.СуммаИсключения КАК СуммаИсключения,
				|			0 КАК СуммаВВалютеУчета,
				|			NULL КАК СчетДтПриемник,
				|			NULL КАК СчетКтПриемник,
				|			ТаблицаДанныхИсточник.ДокументРСБУ КАК Регистратор,
				|			ТаблицаДанныхИсточник.ДокументРСБУ КАК ДокументРСБУ
				|		ИЗ
				|			ТаблицаДанныхИсточник КАК ТаблицаДанныхИсточник
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникДт
				|				ПО ТаблицаДанныхИсточник.СчетДтИсточникКод = СчетаБДИсточникДт.Код
				|					И (СчетаБДИсточникДт.Владелец = &ПланСчетовИсточник)
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДИсточникКт
				|				ПО ТаблицаДанныхИсточник.СчетКтИсточникКод = СчетаБДИсточникКт.Код
				|					И (СчетаБДИсточникКт.Владелец = &ПланСчетовИсточник)
				|		
				|		ОБЪЕДИНИТЬ ВСЕ
				|		
				|		ВЫБРАТЬ
				|			РегистрБухгалтерииПриемник.СчетДтИсточник,
				|			РегистрБухгалтерииПриемник.СчетКтИсточник,
				|			0,
				|			0,
				|			СУММА(РегистрБухгалтерииПриемник.СуммаВВалютеУчета),
				|			СчетаДт.СчетБД,
				|			СчетаКт.СчетБД, 
				|			ВЫРАЗИТЬ(РегистрБухгалтерииПриемник.Регистратор КАК Документ.Трансляция),
				|			ОДПШ.ДокументРСБУ
				|		ИЗ
				|			РегистрБухгалтерии.МСФО.ДвиженияССубконто(
				|					&ДатаНач,
				|					&ДатаКон,
				|					Организация = &Организация
				|						И Сценарий = &Сценарий
				|						И Активность
				|						И (НЕ (СчетДтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка) ИЛИ СчетКтИсточник=ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяССылка)))
				|И (Регистратор Ссылка Документ.Трансляция И Регистратор.ШаблонКорректировки=&ШаблонКорректировки)
				|					,
				|					) КАК РегистрБухгалтерииПриемник
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаДт
				|				ПО РегистрБухгалтерииПриемник.СчетДт = СчетаДт.СчетСсылка
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаКт
				|				ПО РегистрБухгалтерииПриемник.СчетКт = СчетаКт.СчетСсылка
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОДПШ КАК ОДПШ
				|				ПО РегистрБухгалтерииПриемник.Регистратор = ОДПШ.ДокументМСФО
				|		СГРУППИРОВАТЬ ПО
				|			СчетаДт.СчетБД,
				|			РегистрБухгалтерииПриемник.СчетДтИсточник,
				|			СчетаКт.СчетБД,
				|			РегистрБухгалтерииПриемник.СчетКтИсточник,
				|			ВЫРАЗИТЬ(РегистрБухгалтерииПриемник.Регистратор КАК Документ.Трансляция),
				|			ОДПШ.ДокументРСБУ
				|		ОБЪЕДИНИТЬ ВСЕ
				|		
				|		ВЫБРАТЬ
				|			РегистрБухгалтерииПриемник.СчетДтИсточник,
				|			РегистрБухгалтерииПриемник.СчетКтИсточник,
				|			0,
				|			0,
				|			СУММА(РегистрБухгалтерииПриемник.СуммаВВалютеУчета),
				|			СчетаДт.СчетБД,
				|			СчетаКт.СчетБД,
				|			ВЫРАЗИТЬ(РегистрБухгалтерииПриемник.Регистратор КАК Документ.ТрансформационнаяКорректировка),
				|			ОДПШ.ДокументРСБУ
				|		ИЗ
				|			РегистрБухгалтерии.МСФО.ДвиженияССубконто(
				|					&ДатаНач,
				|					&ДатаКон,
				|					Организация = &Организация
				|						И Активность
				|						И (Регистратор ССЫЛКА Документ.ТрансформационнаяКорректировка),	
				|					,
				|					) КАК РегистрБухгалтерииПриемник
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаДт
				|				ПО РегистрБухгалтерииПриемник.СчетДт = СчетаДт.СчетСсылка
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаПриемник КАК СчетаКт
				|				ПО РегистрБухгалтерииПриемник.СчетКт = СчетаКт.СчетСсылка
				|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОДПШ КАК ОДПШ
				|				ПО РегистрБухгалтерииПриемник.Регистратор = ОДПШ.ДокументМСФО
				|		СГРУППИРОВАТЬ ПО
				|			СчетаДт.СчетБД,
				|			РегистрБухгалтерииПриемник.СчетДтИсточник,
				|			СчетаКт.СчетБД,
				|			РегистрБухгалтерииПриемник.СчетКтИсточник,
				|			ВЫРАЗИТЬ(РегистрБухгалтерииПриемник.Регистратор КАК Документ.ТрансформационнаяКорректировка),
				|			ОДПШ.ДокументРСБУ
				|) КАК ОбъединениеДанных
				|	
				|	СГРУППИРОВАТЬ ПО
				|		ОбъединениеДанных.СчетДтИсточник,
				|		ОбъединениеДанных.СчетКтИсточник,
				|		ОбъединениеДанных.СчетДтПриемник,
				|		ОбъединениеДанных.СчетКтПриемник,
				|		ОбъединениеДанных.Регистратор,
				|		ОбъединениеДанных.ДокументРСБУ
				|) КАК СравнениеОборотов
				|
				|УПОРЯДОЧИТЬ ПО
				|	СчетДтИсточник,
				|	СчетКтИсточник
				|ИТОГИ
				|	СУММА(Сумма),
				|	СУММА(СуммаИсключения),
				|	СУММА(СуммаВВалютеУчета),
				|	СУММА(Расхождение_Сумма_СуммаВВалютеУчета)
				|ПО
				|	ДокументРСБУ,
				|	СчетДтИсточник,
				|	СчетКтИсточник,
				|	СчетДтПриемник,
				|	СчетКтПриемник";
				Запрос.УстановитьПараметр("ШаблонКорректировки", Параметры.ШаблонТрансляций);
				
				ТаблицаСоответствия = ПолучитьТаблицуСоответствияСчетов(Параметры, ПравилоОбработки);
				
				ИтогоРасхождение = 0;
				ИтогоЗначениеИсточник = 0;
				ИтогоЗначениеПриемник = 0;
				ИтогоСуммаИсключения = 0;
				
				ТаблицаТрансляции = Параметры.ТаблицаТрансляции;
				
				ВыборкаДокументРСБУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаДокументРСБУ.Следующий() Цикл  
					
					НоваяСтрока = ТаблицаТрансляции.Добавить(); 
					
					НоваяСтрока.ДокументРСБУ = ВыборкаДокументРСБУ.ДокументРСБУ;
					
					НоваяСтрока.СчетДтИсточник = ВыборкаДокументРСБУ.СчетДтИсточник;
					НоваяСтрока.РасхождениеДт = ВыборкаДокументРСБУ.Расхождение_Сумма_СуммаВВалютеУчета;
					
					ВыборкаСчетИсточникДт = ВыборкаДокументРСБУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаСчетИсточникДт.Следующий() Цикл
						
						ВыборкаСчетИсточникКт = ВыборкаСчетИсточникДт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						
						Пока ВыборкаСчетИсточникКт.Следующий() Цикл
							
							НоваяСтрока.СчетДтИсточник = ВыборкаСчетИсточникКт.СчетДтИсточник;
							НоваяСтрока.СчетКтИсточник = ВыборкаСчетИсточникКт.СчетКтИсточник;
							
							СтруктураПараметров = Новый Структура;
							СтруктураПараметров.Вставить("СчетДтИсточник",ВыборкаСчетИсточникКт.СчетДтИсточник);
							СтруктураПараметров.Вставить("СчетКтИсточник",ВыборкаСчетИсточникКт.СчетКтИсточник);
							
							ЕстьСоответствиеСчетов=Истина;
							
							СтрокаИсточникДт = ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетДтИсточникКод,"СчетИсточникКод");
							СтрокаИсточникКт = ТаблицаСоответствия.Найти(ВыборкаСчетИсточникКт.СчетКтИсточникКод,"СчетИсточникКод");
							
							Если СтрокаИсточникДт = Неопределено Или СтрокаИсточникКт = Неопределено Тогда
								
								ЕстьСоответствиеСчетов = Ложь;
								
								Если СтрокаИсточникДт = Неопределено И СтрокаИсточникКт = Неопределено Тогда
									
								ИначеЕсли Не СтрокаИсточникДт = Неопределено Тогда
									
									НоваяСтрока.СчетДтПриемник = СтрокаИсточникДт.СчетПриемник;    
									
								Иначе
									НоваяСтрока.СчетКтПриемник = СтрокаИсточникКт.СчетПриемник;    
									
								КонецЕсли;
								
							КонецЕсли;
							
							Если ЕстьСоответствиеСчетов Тогда
								
								ТаблицаСчетовПриемникКорр = Параметры.ТаблицаСчетовПриемникКорр;
								
								ПолучитьТаблицуСчетовПриемникКорр(ВыборкаСчетИсточникКт, ИтогоЗначениеПриемник, ТаблицаСчетовПриемникКорр);
								
								Если ТаблицаСчетовПриемникКорр.Количество()=0 Тогда
									
									НоваяСтрока.СчетДтПриемник = СтрокаИсточникДт.СчетПриемник;    
									НоваяСтрока.СчетКтПриемник = СтрокаИсточникКт.СчетПриемник;    
									
								ИначеЕсли ТаблицаСчетовПриемникКорр.Количество()=1 Тогда
									
									СтрокаПриемник=ТаблицаСчетовПриемникКорр[0];	
									НоваяСтрока.СчетДтПриемник = СтрокаПриемник.СчетДтПриемник;    
									НоваяСтрока.СчетКтПриемник = СтрокаПриемник.СчетКтПриемник;    
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
				КонецЦикла;	   
				
				Для Каждого Строка Из ТаблицаТрансляции Цикл
					Если Строка.РасхождениеДт <> 0 Или Строка.РасхождениеКт <> 0 Тогда
						
						Если Не (ЗначениеЗаполнено(Строка.СчетДтПриемник) 
							Или ЗначениеЗаполнено(Строка.СчетКтПриемник)) Тогда 
							НС = ТаблицаТрансляцииНетМэппинга.Добавить();
							НС.ИсходныйДокумент = Строка.ДокументРСБУ;
						Иначе
							НС = ТаблицаТрансляцииЕстьМэппинг.Добавить();
							НС.ИсходныйДокумент = Строка.ДокументРСБУ;
						КонецЕсли;  
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;  
	КонецЕсли;
	
	Результат.Вставить("ТаблицаОбработатьНеобработанныеЗаписи", ТаблицаОбработатьНеобработанныеЗаписи);
	Результат.Вставить("ТаблицаТрансляцииЕстьМэппинг", ТаблицаТрансляцииЕстьМэппинг);
	Результат.Вставить("ТаблицаТрансляцииНетМэппинга", ТаблицаТрансляцииНетМэппинга);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);       
	
КонецПроцедуры
	
Процедура СостояниеРегламентногоЗадания(Параметры, АдресРезультата) Экспорт
	
	СтруктураВозврата = Новый Структура;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
	
	Задание = РегламентныеЗаданияСервер.Задание(Метаданные.РегламентныеЗадания.ОтражениеДокументовВРеглУчете);
	Если РазделениеВключено И ЗначениеЗаполнено(Задание.Шаблон) Тогда
		РасписаниеРегламентногоЗадания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задание.Шаблон, "Расписание").Получить();
	Иначе
		РасписаниеРегламентногоЗадания	= Задание.Расписание;
	КонецЕсли;
	ИспользоватьАвтоматическоеОтражениеВУчете = Задание.Использование;	
	СвойстваПоследнегоФоновогоЗадания = ОбщегоНазначенияУТ.ПолучитьСостояниеПоследнегоЗадания(Задание);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	СтруктураВозврата.Вставить("ИспользоватьАвтоматическоеОтражениеВУчете", ИспользоватьАвтоматическоеОтражениеВУчете);
	СтруктураВозврата.Вставить("РазделениеВключено", РазделениеВключено);
	СтруктураВозврата.Вставить("РасписаниеРегламентногоЗадания", РасписаниеРегламентногоЗадания);
	СтруктураВозврата.Вставить("СвойстваПоследнегоФоновогоЗадания", СвойстваПоследнегоФоновогоЗадания);
	
	ПоместитьВоВременноеХранилище(СтруктураВозврата, АдресРезультата);
	
КонецПроцедуры  
   
