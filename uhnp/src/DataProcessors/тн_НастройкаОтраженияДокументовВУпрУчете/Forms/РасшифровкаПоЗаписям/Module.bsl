
&НаСервере
Процедура ОбработатьДокументыНаСервере(ВключаяОбработанные)
		
    Схема = Элементы.Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
    Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
    
    ТЗДокументов = Новый ТаблицаЗначений;
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    ПроцессорВывода.УстановитьОбъект(ТЗДокументов);      
    ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);	  
	
	ОбработатьМассивДокументовНаСервере(ТЗДокументов, ВключаяОбработанные);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДокументы(Команда)
	
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ОбработкаДокументов_Завершение", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ФормаНастройкиОбработки",, , , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДокументов_Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ВыбранноеЗначение.СпособОбработки = "Все" Тогда
		
		ОбработатьДокументыНаСервере(ВыбранноеЗначение.ВключаяОбработанные);
		
	Иначе
		
		ОбработатьВыделенныеДокументы(ВыбранноеЗначение.ВключаяОбработанные);
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	Если Поле.Имя = "ДокументПервогоОтражения"
		Или Поле.Имя = "ДокументПоследнегоОтражения"
		Или Поле.Имя = "ДокументСторноПервогоОтражения"
		Или Поле.Имя = "ИсходныйДокумент" Тогда
		
		СтандартнаяОбработка = Ложь;
		РабочийДокумент = Элементы.Список.ТекущиеДанные[Поле.Имя];
		
		Если Не ЗначениеЗаполнено(РабочийДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначение(,РабочийДокумент);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаправлениеТрансляции(ШаблонОперации)
	
	Если ТипЗнч(ШаблонОперации)=Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") Тогда
		
		Возврат "РегистрБухгалтерии";
		
	Иначе
		
		Возврат ?(ШаблонОперации.НаправлениеТрансляции = Перечисления.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии, "РегистрБухгалтерии", "ПоказателиОтчетов");
		
	КонецЕсли;
	
КонецФункции // ПолучитьНаправлениеТрансляции()

&НаКлиенте
Процедура ДвиженияДокумента(Команда)
	
	Поле = Элементы.Список.ТекущийЭлемент;
	
	Если Поле = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Поле.Имя="ДокументПервогоОтражения"
		Или Поле.Имя = "ДокументПоследнегоОтражения"
		Или Поле.Имя = "ДокументСторноПервогоОтражения"
		Или Поле.Имя = "ИсходныйДокумент" Тогда
		
		РабочийДокумент = Элементы.Список.ТекущиеДанные[Поле.Имя];
		
		Если Не ЗначениеЗаполнено(РабочийДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		Если Поле.Имя = "ИсходныйДокумент" Тогда
			
			ОткрытьФорму("Обработка.ДвиженияДокумента.Форма",Новый Структура("ДокументСсылка",РабочийДокумент),ЭтаФорма,Новый УникальныйИдентификатор);
			
		Иначе	
			
			НаправлениеТрансляции = ПолучитьНаправлениеТрансляции(Элементы.Список.ТекущиеДанные.ШаблонОперации);
			
			Если НаправлениеТрансляции = "РегистрБухгалтерии" Тогда
				
				ОткрытьФорму("Обработка.ДвиженияДокумента.Форма", Новый Структура("ДокументСсылка",РабочийДокумент),ЭтаФорма,Новый УникальныйИдентификатор);
				
			Иначе
				
				ОткрытьФорму("Отчет.ДвиженияНастраиваемойОтчетности.Форма", Новый Структура("Документ",РабочийДокумент),ЭтаФорма,Новый УникальныйИдентификатор);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаКлиенте
Процедура ДвиженияДокументаДерево(Команда)
	
	Поле = Элементы.Дерево.ТекущийЭлемент;
	
	Если Поле = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Поле.Имя="ДеревоДокументПервогоОтражения"
		Или Поле.Имя = "ДеревоДокументПоследнегоОтражения"
		Или Поле.Имя = "ДеревоДокументСторноПервогоОтражения"
		Или Поле.Имя = "ДеревоПерваяКолонка" Тогда
		
		ИмяРеквизита = СтрЗаменить(Поле.Имя, "Дерево", ""); 
		
		РабочийДокумент = Элементы.Дерево.ТекущиеДанные[ИмяРеквизита];
		
		Если Не ЗначениеЗаполнено(РабочийДокумент) Тогда
			Возврат;
		КонецЕсли;
				
		Если Поле.Имя = "ДеревоПерваяКолонка" Тогда
			ЭтоДокумент = ЭтоДокумент(РабочийДокумент);
			
			Если ЭтоДокумент Тогда
			
				ОткрытьФорму("Обработка.ДвиженияДокумента.Форма",Новый Структура("ДокументСсылка",РабочийДокумент),ЭтаФорма,Новый УникальныйИдентификатор);
				
			КонецЕсли;
			
		Иначе	
			
			ОткрытьФорму("Обработка.ДвиженияДокумента.Форма", Новый Структура("ДокументСсылка",РабочийДокумент),ЭтаФорма,Новый УникальныйИдентификатор);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресВХ") Тогда
		
		АдресВХ = Параметры.АдресВХ	  
		
	КонецЕсли;  
	
	// НАЧАЛО Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	Если Параметры.Свойство("ВыводитьВВидеДерева") Тогда
		
		ВыводитьВВидеДерева = Параметры.ВыводитьВВидеДерева	  
		
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	
	ЗаполнитьПараметрыСписка();  
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПараметрыСписка()
		
	Если ЗначениеЗаполнено(АдресВХ) Тогда     
		СтруктураПараметров = ПолучитьИзВременногоХранилища(АдресВХ);
		МассивИсходныхДокументов = СтруктураПараметров.МассивДокументов;
		Организация = СтруктураПараметров.МассивОрганизаций; 
		ЕстьОтборОбработка = СтруктураПараметров.Свойство("ОтборОбработка");  
		ЕстьОтборОтменаПроведения = СтруктураПараметров.Свойство("ОтборОтменаПроведения"); 
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
		ВариантАнализа = СтруктураПараметров.ВариантАнализа;
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
		//НАЧАЛО Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192
		ТолькоСПроводкамиВТрансформационныхКорректировках = СтруктураПараметров.Свойство("ТолькоСПроводкамиВТрансформационныхКорректировках")
			И СтруктураПараметров.ТолькоСПроводкамиВТрансформационныхКорректировках;
		//КОНЕЦ Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192 
		//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
		ШаблоныТКСФлагомТрансляция = СтруктураПараметров.Свойство("ШаблоныТКСФлагомТрансляция")
			И СтруктураПараметров.ШаблоныТКСФлагомТрансляция;
		//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	Иначе
		МассивИсходныхДокументов = Новый Массив; 
		Организация = Новый Массив; 
		ЕстьОтборОбработка = Ложь;
		ЕстьОтборОтменаПроведения = Ложь; 
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
		ВариантАнализа = 0;
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
		//НАЧАЛО Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192
		ТолькоСПроводкамиВТрансформационныхКорректировках = Ложь;
		//КОНЕЦ Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192 
		//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
		ШаблоныТКСФлагомТрансляция = Ложь;
		//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	КонецЕсли; 
	
    ЕстьОтборОрганизация = СтрНайти(Список.ТекстЗапроса,"И РегистрСведенийОтражениеДокументовПоШаблонам.Организация В (&МассивОрганизаций)") > 0;
	
	Если ЗначениеЗаполнено(Организация) И Не ЕстьОтборОрганизация Тогда
		
		Список.ТекстЗапроса = Список.ТекстЗапроса + " И РегистрСведенийОтражениеДокументовПоШаблонам.Организация В (&МассивОрганизаций)";
		Список.Параметры.УстановитьЗначениеПараметра("МассивОрганизаций", Организация);    

	ИначеЕсли ЗначениеЗаполнено(Организация) И ЕстьОтборОрганизация Тогда

		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"И РегистрСведенийОтражениеДокументовПоШаблонам.Организация В (&МассивОрганизаций)"," ");
		
	КонецЕсли;   
	
	Если ЕстьОтборОбработка Тогда
		
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"Перечисление.ДаНет.да","Перечисление.ДаНет.нет");

	Иначе 
		
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"Перечисление.ДаНет.нет","Перечисление.ДаНет.да");
		
	КонецЕсли;  
	
	Если ЕстьОтборОтменаПроведения Тогда
		
		Если СтрНайти(Список.ТекстЗапроса,"И РегистрСведенийОтражениеДокументовПоШаблонам.ПроведениеОтменено") = 0 Тогда
			Список.ТекстЗапроса = Список.ТекстЗапроса + " И РегистрСведенийОтражениеДокументовПоШаблонам.ПроведениеОтменено";
		КонецЕсли; 
		
	Иначе 
		
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"И РегистрСведенийОтражениеДокументовПоШаблонам.ПроведениеОтменено"," ");
		
	КонецЕсли;  
	
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
	Если ВариантАнализа = 0 Тогда
		Если СтрНайти(Список.ТекстЗапроса,"тн_ТипУчета") = 0 Тогда
			Список.ТекстЗапроса = Список.ТекстЗапроса + " И ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ)";
		КонецЕсли;  
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "ШаблоныТрансляций",  "ШаблоныТрансформационныхКорректировок");
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"УчетМСФО","УчетУУ");
	ИначеЕсли ВариантАнализа = 1 Тогда
		Если СтрНайти(Список.ТекстЗапроса,"тн_ТипУчета") = 0 Тогда
			Список.ТекстЗапроса = Список.ТекстЗапроса + " И ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетМСФО)";
		КонецЕсли; 
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"УчетУУ","УчетМСФО");  
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "ШаблоныТрансляций",  "ШаблоныТрансформационныхКорректировок");
	ИначеЕсли ВариантАнализа = 2 Тогда 
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "И ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ)","И РегистрСведенийОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансляций");
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "И ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетМСФО)","И РегистрСведенийОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансляций");
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, "ШаблоныТрансформационныхКорректировок", "ШаблоныТрансляций");
	КонецЕсли;
    // КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	
	//НАЧАЛО Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192
	Если ТолькоСПроводкамиВТрансформационныхКорректировках Тогда 
		Список.ТекстЗапроса = Список.ТекстЗапроса + " И НЕ ТрансформационнаяКорректировкаПроводки.Ссылка ЕСТЬ NULL";
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192 
	
	//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	Если ШаблоныТКСФлагомТрансляция Тогда 
		ТекстЗапроса = Список.ТекстЗапроса;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И РегистрСведенийОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.нет)", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И РегистрСведенийОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.да)", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ)", "");
		ТекстЗапроса = ТекстЗапроса 
			+ "И РегистрСведенийОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансформационныхКорректировок И РегистрСведенийОтражениеДокументовПоШаблонам.Трансляция"; 
		Список.ТекстЗапроса = ТекстЗапроса;	
		Элементы.СписокОбработатьДокументы.Видимость = Ложь;
		Элементы.ФормаДвиженияДокумента.Видимость = Ложь;
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	
	Список.Параметры.УстановитьЗначениеПараметра("МассивДокументов", МассивИсходныхДокументов);    
	
	// НАЧАЛО Белоконенко Денис 19.07.2023 Выполнение задач №000046209
	Если ВыводитьВВидеДерева Тогда
		Элементы.Список.Видимость = Ложь;
		Элементы.Дерево.Видимость = Истина;
		
		ПостроитьДеревоЗначений();
	Иначе
		Элементы.Список.Видимость = Истина;
		Элементы.Дерево.Видимость = Ложь;
	КонецЕсли;
	// КОНЕЦ  Белоконенко Денис 19.07.2023 Выполнение задач №000046209
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыделенныеДокументы(ВключаяОбработанные)
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Строка Из Элементы.Список.ВыделенныеСтроки Цикл
		
		МассивДокументов.Добавить(Строка);
		
	КонецЦикла;
	
	ОбработатьМассивДокументовНаСервере(Новый ФиксированныйМассив(МассивДокументов),ВключаяОбработанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьМассивДокументовНаСервере(МассивДокументов,ВключаяОбработанные)
	
	Для Каждого Запись Из МассивДокументов Цикл
		
		НаборЗаписей = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(Запись.ИсходныйДокумент);
		НаборЗаписей.Отбор.ШаблонОперации.Установить(Запись.ШаблонОперации);
		
		НаборЗаписей.Прочитать();
		
		Для Каждого ДанныеОбъекта Из НаборЗаписей Цикл
			
			Если (ДанныеОбъекта.ОбработкаВыполнена = Перечисления.ДаНет.нет Или ВключаяОбработанные)  Тогда
				
				ДанныеЗакрытияПериода = УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеОбъекта.Организация);
				//НАЧАЛО Блинова М.А. 07.06.2024 Выполнение задач №000049817
				// там уже нет такого метода
				//УправлениеОтчетамиУХ.ОбработатьДанныеОбъекта(ДанныеОбъекта,Перечисления.СпособыТрансляции.ПоДокументамПриПроведении,ДанныеЗакрытияПериода,Не ДанныеОбъекта.ИсходныйДокумент.Проведен);
				КорректировкиЗначенийПоказателей32.ОбработатьДанныеОбъекта(ДанныеОбъекта, Новый Структура("СпособТрансляции", Перечисления.СпособыТрансляции.ПоДокументамПриПроведении), ДанныеЗакрытияПериода, Не ДанныеОбъекта.ИсходныйДокумент.Проведен);  
				//КОНЕЦ Блинова М.А. 07.06.2024 Выполнение задач №000049817
					
			КонецЕсли;	
			
		КонецЦикла;
		
		НаборЗаписей.Записать(Истина); 
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	Если ИмяСобытия = "РасшифровкаПоЗаписям_ИзмененийУсловийОтбора" Тогда
		
	Если Параметр.Свойство("АдресВХ") Тогда
		
		АдресВХ = Параметр.АдресВХ	  
		
	КонецЕсли; 
		
		ЗаполнитьПараметрыСписка();  
		
		Активизировать();
		
	КонецЕсли;
	
КонецПроцедуры  

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаСервере
Процедура ПостроитьДеревоЗначений()

	ДеревоЗначений = РеквизитФормыВЗначение("Дерево");
	ДеревоЗначений.Строки.Очистить();
	
	ТекстЗапроса = Список.ТекстЗапроса;
	
	ТекстИтоги = "     
		|ИТОГИ ПО
		|	ТипИсходногоДокумента,
		|	ИсходныйДокумент";
	
	Запрос = Новый Запрос;	
	Запрос.Текст = ТекстЗапроса + ТекстИтоги;
	
	Для Каждого ТекПараметр Из Список.Параметры.Элементы Цикл
		ИмяПараметра 		= Строка(ТекПараметр.Параметр);
		ЗначениеПараметра 	= ТекПараметр.Значение;
		
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра);	
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТипИсходногоДокумента = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТипИсходногоДокумента.Следующий() Цикл
		Группа1 = ДеревоЗначений.Строки.Добавить();
		Группа1.ПерваяКолонка = ВыборкаТипИсходногоДокумента.ТипИсходногоДокумента;
	
		ВыборкаИсходныйДокумент = ВыборкаТипИсходногоДокумента.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаИсходныйДокумент.Следующий() Цикл
			Группа2 = Группа1.Строки.Добавить();
			Группа2.ПерваяКолонка = ВыборкаИсходныйДокумент.ИсходныйДокумент;
	
			ВыборкаДетальныеЗаписи = ВыборкаИсходныйДокумент.Выбрать();
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ГруппаДетальныеЗаписи = Группа2.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(ГруппаДетальныеЗаписи, ВыборкаДетальныеЗаписи);
				
				ГруппаДетальныеЗаписи.ПерваяКолонка = ВыборкаДетальныеЗаписи.ШаблонОперации;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;	
	
	ЗначениеВРеквизитФормы(ДеревоЗначений, "Дерево");
КонецПроцедуры 

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаСервере
Функция ЭтоДокумент(РабочийДокумент)
	ТипЗначения = ТипЗнч(РабочийДокумент);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	
	Если ОбъектМетаданных <> Неопределено Тогда
		ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
	Иначе
		ЭтоДокумент = Ложь;
	КонецЕсли;
	
	Возврат ЭтоДокумент;	
КонецФункции

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаКлиенте
Процедура ОбработатьДокументыДерево(Команда)
	
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ОбработкаДокументовДерево_Завершение", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ФормаНастройкиОбработки",, , , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаКлиенте
Процедура ОбработкаДокументовДерево_Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ВыбранноеЗначение.СпособОбработки = "Все" Тогда
		
		ОбработатьДокументыНаСервере(ВыбранноеЗначение.ВключаяОбработанные);
		
	Иначе
		
		МассивДокументов = Новый Массив;
		Для Каждого ИдДерева Из Элементы.Дерево.ВыделенныеСтроки Цикл
			ДанныеСтрокиДерева = Элементы.Дерево.ДанныеСтроки(ИдДерева);
			ПолучитьМассивДокументовДереваРекурсивно(МассивДокументов, ДанныеСтрокиДерева);
		КонецЦикла;
		ОбработатьМассивДокументовНаСервере(Новый ФиксированныйМассив(МассивДокументов), ВыбранноеЗначение.ВключаяОбработанные);
		
	КонецЕсли;
	
	ПостроитьДеревоЗначений();
	
КонецПроцедуры

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаКлиенте
Процедура ПолучитьМассивДокументовДереваРекурсивно(МассивДокументов, ДанныеСтрокиДерева)
	СтрокиДерева = ДанныеСтрокиДерева.ПолучитьЭлементы();
	
	Если СтрокиДерева.Количество() = 0 Тогда
		Родитель = ДанныеСтрокиДерева.ПолучитьРодителя();
		
		СтруктураДокумента = Новый Структура;
		СтруктураДокумента.Вставить("ШаблонОперации", ДанныеСтрокиДерева.ПерваяКолонка); 
		СтруктураДокумента.Вставить("ИсходныйДокумент", Родитель.ПерваяКолонка);
		
		МассивДокументов.Добавить(СтруктураДокумента); 
	Иначе
		Для Каждого СтрокаДерева Из СтрокиДерева Цикл
			ПолучитьМассивДокументовДереваРекурсивно(МассивДокументов, СтрокаДерева);	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Белоконенко Денис 19.07.2023 Выполнение задач №000046209
&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя="ДеревоДокументПервогоОтражения"
		Или Поле.Имя = "ДеревоДокументПоследнегоОтражения"
		Или Поле.Имя = "ДеревоДокументСторноПервогоОтражения"
		Или Поле.Имя = "ДеревоПерваяКолонка" Тогда
		
		ИмяРеквизита = СтрЗаменить(Поле.Имя, "Дерево", "");
		
		РабочийДокумент = Элементы.Дерево.ТекущиеДанные[ИмяРеквизита];
		
		Если Не ЗначениеЗаполнено(РабочийДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоДокумент = ЭтоДокумент(РабочийДокумент);
		
		Если ЭтоДокумент Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(,РабочийДокумент);
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры
