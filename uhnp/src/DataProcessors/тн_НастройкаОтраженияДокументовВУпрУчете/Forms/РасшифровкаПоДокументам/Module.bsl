&НаСервере  
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресВХ") Тогда
		
		АдресВХ = Параметры.АдресВХ;
		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоТипам()  
		
	ТекстЗапроса = "";
	Для Каждого Строка Из СписокТипов Цикл    
		Если Строка.Отражать Тогда
			МетаданныеДокумента = Метаданные.Документы.Найти(Строка.ИмяТипа);
			Если МетаданныеДокумента.ДлинаНомера > 0 Тогда
				тНом = "," + МетаданныеДокумента.Имя + ".Номер КАК Номер";	
			Иначе
				тНом = ",Null КАК Номер";	
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Организация") <> Неопределено Тогда
				тОрг = "," + МетаданныеДокумента.Имя + ".Организация КАК Организация";	
			Иначе
				тОрг = ",Null КАК Организация";	
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				тКонт = "," + МетаданныеДокумента.Имя+".Контрагент КАК Контрагент";	
			Иначе
				тКонт = ",Null КАК Контрагент";	
			КонецЕсли;
			Если МетаданныеДокумента.Реквизиты.Найти("Партнер") <> Неопределено Тогда
				тКонт = "," + МетаданныеДокумента.Имя+".Партнер КАК Партнер";	
			Иначе
				тКонт = ",Null КАК Партнер";	
			КонецЕсли;
			Если ТекстЗапроса <> "" Тогда
				ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";	
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ
			|	ВЫБОР КОГДА " + МетаданныеДокумента.Имя + ".Проведен ТОГДА 1 КОГДА " + МетаданныеДокумента.Имя + ".ПометкаУдаления ТОГДА 3 ИНАЧЕ 0 КОНЕЦ КАК Статус,
			|	" + МетаданныеДокумента.Имя + ".Ссылка КАК Ссылка,
			|	" + МетаданныеДокумента.Имя + ".Дата КАК Дата,
			|	""" + МетаданныеДокумента.Имя + """ КАК ИмяТипа
			|" + тНом + тОрг + тКонт + "
			|ИЗ
			|	Документ."+ МетаданныеДокумента.Имя + " КАК " + МетаданныеДокумента.Имя + " 
			|	ГДЕ " + МетаданныеДокумента.Имя + ".Ссылка В (&МассивДокументов) ";
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		СписокДокументов.ТекстЗапроса = ТекстЗапроса;
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено("АдресВХ") Тогда
		
		СтруктураДанных = ПолучитьИзВременногоХранилища(АдресВХ);     
		ТЗ = СтруктураДанных.ТЗ;
		
		МассивДокументов = ТЗ.ВыгрузитьКолонку("ИсходныйДокумент");
		
	Иначе
		МассивДокументов = Новый Массив;
	КонецЕсли;   
	
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("МассивДокументов", МассивДокументов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТипы()
	
	СписокТипов.Очистить();	

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.ИсходныйДокумент КАК ИсходныйДокумент
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТИПЗНАЧЕНИЯ(втТаблица.ИсходныйДокумент) КАК ТипЗначения,
	|	КОЛИЧЕСТВО(втТаблица.ИсходныйДокумент) КАК Количество
	|ИЗ
	|	втТаблица КАК втТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ТИПЗНАЧЕНИЯ(втТаблица.ИсходныйДокумент)";
	
	СтруктураДанных = ПолучитьИзВременногоХранилища(АдресВХ);     
	ТЗ = СтруктураДанных.ТЗ;

	Запрос.УстановитьПараметр("Таблица", ТЗ);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Результат Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(Строка.ТипЗначения);
		Если Строка.Количество > 0 Тогда
			НайденныеСтроки = СписокТипов.НайтиСтроки(Новый Структура("ИмяТипа", МетаданныеДокумента.Имя));
			Если НайденныеСтроки.Количество() = 0 ТОгда
				НС = СписокТипов.Добавить();
				НС.ИмяТипа = МетаданныеДокумента.Имя;
				НС.Синоним = МетаданныеДокумента.Синоним;  
				НС.Отражать = Истина;
			Иначе
				НС = НайденныеСтроки[0];
			КонецЕсли;
			НС.Количество = Строка.Количество;
		КонецЕсли;
	КонецЦикла;     
		
КонецПроцедуры

&НаСервере
Процедура ОтменаПроведенияНаСервере()    
	
	Для Каждого Строка Из Элементы.СписокДокументов.ВыделенныеСтроки Цикл
		Если Строка.Проведен Тогда		
			ДокументОбъект = Строка.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
	КонецЦикла;   
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаПроведения(Команда)    
	
	ОтменаПроведенияНаСервере();
	Элементы.СписокДокументов.Обновить();  
	
КонецПроцедуры

&НаСервере
Процедура ПровестиНаСервере()    
	
	Для Каждого Строка Из Элементы.СписокДокументов.ВыделенныеСтроки Цикл
		Если Не Строка.ПометкаУдаления Тогда		
			ДокументОбъект = Строка.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура Провести(Команда) 
	
	ПровестиНаСервере();
	Элементы.СписокДокументов.Обновить();   
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)    
	
	ОткрытьЗначение(ВыбраннаяСтрока);      
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДокументов(Команда)  
	
	// НАЧАЛО Юдина Екатерина 25.05.2026 Выполнение задач №000057752
	//// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044
