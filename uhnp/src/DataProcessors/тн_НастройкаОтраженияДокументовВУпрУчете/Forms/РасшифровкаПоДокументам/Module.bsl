КонецПроцедуры

&НаСервере
Процедура ПолучитьМассивДокументов() 
	
	СтруктураДанных = ПолучитьИзВременногоХранилища(АдресВХ);
	// НАЧАЛО Юдина Екатерина 25.05.2026 Выполнение задач №000057752
	Если СтруктураДанных.Свойство("БезПроводок") 
		И Не СтруктураДанных.БезПроводок Тогда   
		Возврат;
	КонецЕсли;
	// КОНЕЦ Юдина Екатерина 25.05.2026 Выполнение задач №000057752
	
	Запрос = Новый Запрос;  
	
	Запрос.Текст =     
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыБД.Ссылка КАК ОбъектБД
	|ИЗ
	|	Справочник.ДокументыБД КАК ДокументыБД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
	|		ПО ДокументыБД.Ссылка = ШаблоныТрансформационныхКорректировок.ДокументБД
	|			И (ШаблоныТрансформационныхКорректировок.тн_ТипУчета = ЗНАЧЕНИЕ(Перечисление.тн_ТипыУчета.УчетУУ))
	|ГДЕ
	|	НЕ ДокументыБД.тн_НеОтражатьВУУ 
	|	И НЕ ДокументыБД.ОтсутствуетВКонфигурации
	|	И ДокументыБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	|	И ШаблоныТрансформационныхКорректировок.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("МассивОрганизаций", СтруктураДанных.Организация);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(СтруктураДанных.ДатаОкончания), СтруктураДанных.ДатаОкончания, Дата(2399, 1, 1)));
	Запрос.УстановитьПараметр("ДатаНачала", ?(ЗначениеЗаполнено(СтруктураДанных.ДатаНачала), СтруктураДанных.ДатаНачала, Дата(1,1,1)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Запрос.Текст = Обработки.тн_НастройкаОтраженияДокументовВУпрУчете.ПолучитьТекстЗапросаПоОбъектамБД(Выборка, СтруктураДанных.Организация);
		ТЗНовая = Запрос.Выполнить().Выгрузить();
		СтруктураДанных.Вставить("ТЗ", ТЗНовая);    
		ПоместитьВовременноеХранилище(СтруктураДанных, АдресВХ);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СписокТиповОтражатьПриИзменении(Элемент)     
	
	ОбновитьПоТипам();        
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)   
	
	ЗаполнитьТипы();
	ОбновитьПоТипам();   
	
КонецПроцедуры        

&НаКлиенте
Процедура ВыбратьВсеТипы(Команда) 
	
	Для Каждого Строка Из СписокТипов Цикл
		Строка.Отражать = Истина;		
	КонецЦикла;
	ОбновитьПоТипам();
	Элементы.СписокДокументов.Обновить(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсеТипы(Команда)      
	
	Для Каждого Строка Из СписокТипов Цикл
		Строка.Отражать = Ложь;		
	КонецЦикла;
	ОбновитьПоТипам();
	Элементы.СписокДокументов.Обновить();
	
КонецПроцедуры            

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	Если ИмяСобытия = "РасшифровкаПоДокументам_ИзмененийУсловийОтбора" Тогда
		
		Если Параметр.Свойство("АдресВХ") Тогда
			
			АдресВХ = Параметр.АдресВХ; 
			
		КонецЕсли; 
	
		ЗаполнитьТипы();
		ОбновитьПоТипам();   
		Активизировать();
		
	КонецЕсли;
	
КонецПроцедуры