	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Документ Из ТаблицаДокументов Цикл
		
		Попытка 
			ДокументОбъект = Документ.ПолучитьОбъект();   
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки
		
	КонецЦикла; 
	
    // НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047426		
	ОбработатьНеобработанныеЗаписиАвтоматическиНаСервере("ТаблицаПерепроведениеИсходныхДокументов", 
	                                                         ПредопределенноеЗначение("Перечисление.СпособыТрансляции.ПоДокументамПриПроведении"));   
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047426	
	
КонецПроцедуры

