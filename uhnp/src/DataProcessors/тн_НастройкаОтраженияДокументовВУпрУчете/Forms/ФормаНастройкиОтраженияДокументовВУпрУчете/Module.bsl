&НаСервере
Процедура ОбработатьНеобработанныеЗаписиАвтоматическиНаСервере(ИмяТаблицы, СпособТрансляции)
	
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	//ТаблицаДокументов = РеквизитФормыВЗначение("ТаблицаОбработатьНеобработанныеЗаписи", Тип("ТаблицаЗначений"));
	ТаблицаДокументов = РеквизитФормыВЗначение(ИмяТаблицы, Тип("ТаблицаЗначений"));
    // КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424  
	
	// НАЧАЛО Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	// перенес цикл до транзакции
	Для Каждого Запись Из ТаблицаДокументов Цикл
	// КОНЕЦ  Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	
	// НАЧАЛО Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый); 
	
	Попытка
	// КОНЕЦ  Горелов Дмитрий 05.03.2024 Выполнение задач №000048724

	// НАЧАЛО Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	// перенес цикл до транзакции
	//Для Каждого Запись Из ТаблицаДокументов Цикл
	// КОНЕЦ  Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
		
		// НАЧАЛО Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ОтражениеДокументовПоШаблонам");   
		ЭлементБлокировкиДанных.УстановитьЗначение("ИсходныйДокумент", Запись.ИсходныйДокумент);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", Запись.ИсходныйДокумент.Организация);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		// КОНЕЦ  Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
		
		НаборЗаписей = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(Запись.ИсходныйДокумент);

		НаборЗаписей.Прочитать();  
		
		Для Каждого ДанныеОбъекта Из НаборЗаписей Цикл  
			// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
			//Если ТипЗнч(ДанныеОбъекта.ШаблонОперации) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") 
			//	И ДанныеОбъекта.ШаблонОперации.тн_ТипУчета = Перечисления.тн_ТипыУчета.УчетУУ Тогда   
			ОбработатьЗапись = Ложь;
			Если ВариантАнализа = 0 Тогда
				ОбработатьЗапись = ТипЗнч(ДанныеОбъекта.ШаблонОперации) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") 
				    И ДанныеОбъекта.ШаблонОперации.тн_ТипУчета = Перечисления.тн_ТипыУчета.УчетУУ; 
			ИначеЕсли ВариантАнализа = 1 Тогда 
				ОбработатьЗапись = ТипЗнч(ДанныеОбъекта.ШаблонОперации) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") 
				    И ДанныеОбъекта.ШаблонОперации.тн_ТипУчета = Перечисления.тн_ТипыУчета.УчетМСФО; 
			ИначеЕсли ВариантАнализа = 2 Тогда
				ОбработатьЗапись = ТипЗнч(ДанныеОбъекта.ШаблонОперации) = Тип("СправочникСсылка.ШаблоныТрансляций"); 
			КонецЕсли; 
			
			Если ОбработатьЗапись Тогда
			// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
				
				ДанныеЗакрытияПериода = УправлениеОтчетамиУХ.ПолучитьДанныеЗакрытогоПериода(ДанныеОбъекта.Организация);
				// НАЧАЛО Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
				//// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
				////УправлениеОтчетамиУХ.ОбработатьДанныеОбъекта(ДанныеОбъекта, Перечисления.СпособыТрансляции.ПоДокументамПриПроведении, ДанныеЗакрытияПериода, Не ДанныеОбъекта.ИсходныйДокумент.Проведен);
				//УправлениеОтчетамиУХ.ОбработатьДанныеОбъекта(ДанныеОбъекта, СпособТрансляции, ДанныеЗакрытияПериода, Не ДанныеОбъекта.ИсходныйДокумент.Проведен);
				КорректировкиЗначенийПоказателей32.ОбработатьДанныеОбъекта(ДанныеОбъекта, Новый Структура("СпособТрансляции", СпособТрансляции), ДанныеЗакрытияПериода, Ложь, Не ДанныеОбъекта.ИсходныйДокумент.Проведен);
				//// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
				// КОНЕЦ  Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
			КонецЕсли;
			
		КонецЦикла;
		
		НаборЗаписей.Записать(Истина); 
		
	// НАЧАЛО Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	// перенес конец цикла ниже закрытия транзакции
	//КонецЦикла;     
	// КОНЕЦ  Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	
	// НАЧАЛО Горелов Дмитрий 05.03.2024 Выполнение задач №000048724
	ЗафиксироватьТранзакцию();
	Исключение
			
		ОтменитьТранзакцию();
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = СтрШаблон("Не удалось выполнить отражение документов по причине: %1",
		                           ТекстОшибки); 
		Если СтрНайти(ТекстОшибки, "Превышено максимальное время ожидания") > 0 Тогда
			ТекстСообщенияПользователю = ТекстСообщения + Символы.ПС + "Повторите попытку";	
		Иначе
			ТекстСообщенияПользователю = ТекстСообщения;
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		                         УровеньЖурналаРегистрации.Ошибка,
		                         Метаданные.РегистрыСведений.ОтражениеДокументовПоШаблонам,,
		                         ТекстСообщения);
	КонецПопытки;
	// КОНЕЦ  Горелов Дмитрий 05.03.2024 Выполнение задач №000048724

	// НАЧАЛО Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	// перенес конец цикла ниже закрытия транзакции
	КонецЦикла;     
	// КОНЕЦ  Абрамкин П.Ю. (БИТ) 29-01-2025 Выполнение задач №000052269
	
КонецПроцедуры

