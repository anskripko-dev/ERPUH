			Символы.ПС + "Выбранной организации не соответствует выбранная учетная политика. Обработка сформирована не будет!";
			Элементы.ГлобальныеОшибки.Видимость = Истина; 
			
			Возврат;
			
		КонецЕсли;
		
	Иначе	
	// КОНЕЦ Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584
		ПараметрыФоновогоЗадания.Вставить("МассивОрганизаций", Организация);     
	// НАЧАЛО Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584 
    КонецЕсли;  
	// КОНЕЦ Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584
	ПараметрыФоновогоЗадания.Вставить("Период", Период);
	ПараметрыФоновогоЗадания.Вставить("ВидЗадания", ""); // Заполняется в цикле
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	ПараметрыФоновогоЗадания.Вставить("ВариантАнализа", ВариантАнализа);
	
	Если ВариантАнализа = 2 Тогда  
		ПараметрыФоновогоЗадания.Вставить("ШаблонТрансляций",   ШаблонТрансляций);
		ПараметрыФоновогоЗадания.Вставить("ТаблицаТрансляции",   ДанныеФормыВЗначение(ТаблицаТрансляции,Тип("ТаблицаЗначений")));
		ПараметрыФоновогоЗадания.Вставить("ТаблицаСчетовПриемникКорр", ДанныеФормыВЗначение(ТаблицаСчетовПриемникКорр, Тип("ТаблицаЗначений")));
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424 
	ВыполненныеЗадания = Новый Массив;
	
	Для каждого Задание Из ЗаданияКЗапуску Цикл
				
		Если СтрНайти(Задание.Ключ, "_") = 0 Тогда
			ИмяМетода = Задание.Ключ;
			ПараметрыФоновогоЗадания.ВидЗадания = "";
		Иначе
			МассивСтрокЗадания = СтрРазделить(Задание.Ключ, "_");
			ИмяМетода = МассивСтрокЗадания.Получить(0);
			ПараметрыФоновогоЗадания.ВидЗадания = МассивСтрокЗадания.Получить(1);
		КонецЕсли;
		
		РезультатВыполнения = ЗапуститьВыполнениеВФоне("Обработки.тн_НастройкаОтраженияДокументовВУпрУчете." + ИмяМетода, ПараметрыФоновогоЗадания);
		РезультатВыполнения.Вставить("ЗаданиеЗавершено", РезультатВыполнения.Статус = "Выполнено" Или РезультатВыполнения.Статус = "Ошибка");
		ОбновитьДанные(Задание.Ключ, РезультатВыполнения);
		
		Если РезультатВыполнения.ЗаданиеЗавершено Тогда
			ВыполненныеЗадания.Добавить(Задание.Ключ);
		Иначе
			ЗаданияКЗапуску.Вставить(Задание.Ключ, РезультатВыполнения);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ВыполненноеЗадание Из ВыполненныеЗадания Цикл
		ЗаданияКЗапуску.Удалить(ВыполненноеЗадание);
	КонецЦикла;
	
	СтруктураОбновленияСостоянийОтражения = ЗаданияКЗапуску;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьВыполнениеВФоне(ВыполняемыйМетод, ПараметрыОбработки)

	СоответствиеНаименованийЗаданийВыполняемымМетодам = Новый Соответствие;
	СоответствиеНаименованийЗаданийВыполняемымМетодам.Вставить("Обработки.НастройкаОтраженияДокументовВРеглУчете.СостояниеОтраженияДокументовНетШаблоновПроводок",
		"Рабочее место отражения документов в упр. учете: Обновление состояния отражения документов в упр. учете (без шаблонов)");
	СоответствиеНаименованийЗаданийВыполняемымМетодам.Вставить("Обработки.НастройкаОтраженияДокументовВРеглУчете.СостояниеОтраженияДокументовЕстьШаблоныПроводок",
		"Рабочее место отражения документов в упр. учете: Обновление состояния отражения документов в упр. учете (с шаблонами)");
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424  
	СоответствиеНаименованийЗаданийВыполняемымМетодам.Вставить("Обработки.НастройкаОтраженияДокументовВРеглУчете.СостояниеОтраженияДокументовТрансляции",
		"Рабочее место отражения документов в упр. учете: Обновление состояния отражения документов в упр. учете (трансляции)");
	// КОНЕЦ  Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	СоответствиеНаименованийЗаданийВыполняемымМетодам.Вставить("Обработки.тн_НастройкаОтраженияДокументовВУпрУчете.СостояниеОтраженияЗаписейПоШаблонамТКСФлагомТрансляции",
		"Рабочее место отражения документов в упр. учете: Обновление состояния отражения документов в упр. учете (ошибочные записи с флагом ""Трансляция"")");
	СоответствиеНаименованийЗаданийВыполняемымМетодам.Вставить("Обработки.тн_НастройкаОтраженияДокументовВУпрУчете.СостояниеТКПомеченныеНаУдаление",
		"Рабочее место отражения документов в упр. учете: Обновление состояния отражения документов в упр. учете (трансформационные корректировки, помеченные на удаление)");
	//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	ПараметрыФоновогоЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(ЭтотОбъект.УникальныйИдентификатор);
	ПараметрыФоновогоЗадания.КлючФоновогоЗадания = Новый УникальныйИдентификатор;
	ПараметрыФоновогоЗадания.ОжидатьЗавершение = 0;
	ПараметрыФоновогоЗадания.НаименованиеФоновогоЗадания = СоответствиеНаименованийЗаданийВыполняемымМетодам.Получить(ВыполняемыйМетод);
	
	РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыОбработки, ПараметрыФоновогоЗадания);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьВыполнениеФоновыхЗаданийОбновленияСостоянийКлиент()
	
	Если СтруктураОбновленияСостоянийОтражения = Неопределено ИЛИ СтруктураОбновленияСостоянийОтражения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьВыполнениеФоновыхЗаданийОбновленияСостоянийСервер();
	
	Если СтруктураОбновленияСостоянийОтражения.Количество() Тогда
		
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("ПроверитьВыполнениеФоновыхЗаданийОбновленияСостоянийКлиент", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВыполнениеФоновыхЗаданийОбновленияСостоянийСервер()
	
	ВыполненныеЗадания = Новый Массив;
	
	Для каждого ПроверяемоеЗадание Из СтруктураОбновленияСостоянийОтражения Цикл
		
		Если ВыполненныеЗадания.Найти(ПроверяемоеЗадание.Ключ) <> Неопределено Или ПроверяемоеЗадание.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПроверитьВыполнениеФоновогоЗадания(ПроверяемоеЗадание.Ключ, ПроверяемоеЗадание.Значение, ВыполненныеЗадания);
		
	КонецЦикла;
	
	Для каждого ВыполненноеЗадание Из ВыполненныеЗадания Цикл
		СтруктураОбновленияСостоянийОтражения.Удалить(ВыполненноеЗадание);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВыполнениеФоновогоЗадания(ИмяЗадания, Задание, ВыполненныеЗадания)
	
	Если Задание.Статус = "Выполняется" И Задание.Свойство("ИдентификаторЗадания") Тогда
		РезультатВыполнения = ДлительныеОперации.ОперацияВыполнена(Задание.ИдентификаторЗадания);
		РезультатВыполнения.Вставить("ЗаданиеЗавершено", РезультатВыполнения.Статус = "Выполнено" ИЛИ РезультатВыполнения.Статус = "Ошибка");
		РезультатВыполнения.Вставить("АдресРезультата", Задание.АдресРезультата);
	Иначе
		РезультатВыполнения = Задание;
	КонецЕсли;
	ОбновитьДанные(ИмяЗадания, РезультатВыполнения);
	
	Если РезультатВыполнения.ЗаданиеЗавершено Тогда
		ВыполненныеЗадания.Добавить(ИмяЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
//Функция ИнициализироватьСтруктуруЗаданийОбновления(ПеречисленныеЗаданияСтрокой = Неопределено)
Функция ИнициализироватьСтруктуруЗаданийОбновления(ВариантАнализа, ПеречисленныеЗаданияСтрокой = Неопределено)
// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424

	Если ПеречисленныеЗаданияСтрокой = Неопределено Тогда   
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
		Если ВариантАнализа = 2 Тогда 
			ПеречисленныеЗаданияСтрокой = "СостояниеОтраженияДокументовТрансляции";   
		ИначеЕсли ВариантАнализа = 2 Тогда
            ПеречисленныеЗаданияСтрокой = "СостояниеОтраженияДокументовЕстьШаблоныПроводок"; 
		Иначе
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
			ПеречисленныеЗаданияСтрокой = "СостояниеОтраженияДокументовНетШаблоновПроводок,СостояниеОтраженияДокументовЕстьШаблоныПроводок"; 
			//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
			ПеречисленныеЗаданияСтрокой = ПеречисленныеЗаданияСтрокой + ",СостояниеОтраженияЗаписейПоШаблонамТКСФлагомТрансляции,СостояниеТКПомеченныеНаУдаление";
			//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424		
		КонецЕсли;
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	КонецЕсли;

	СтруктураВозврата = Новый Структура;
	
	МассивЗаданий = СтрРазделить(ПеречисленныеЗаданияСтрокой, ",");
	
	Для каждого Задание Из МассивЗаданий Цикл
		СтруктураВозврата.Вставить(Задание);
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
