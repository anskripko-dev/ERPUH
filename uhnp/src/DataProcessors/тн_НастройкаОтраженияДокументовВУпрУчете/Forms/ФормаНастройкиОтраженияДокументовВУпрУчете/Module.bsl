// Сафиуллина З.Р. 05.08.2024 Выполнение задач №000050397
//
&НаСервере
Процедура ОбработатьЗаписиРСПоТКПомеченнымНаУдалениеНаСервере(УдалятьСвязанныеЗаписиРС)
	
	МассивДокументов = ТаблицаТКПомеченныеНаУдаление.Выгрузить().ВыгрузитьКолонку("ТК");
	
	Запрос = Новый Запрос;
	Запрос.Текст =     
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент,
		|	ОтражениеДокументовПоШаблонам.Организация КАК Организация,
		|	ОтражениеДокументовПоШаблонам.Сценарий КАК Сценарий,
		|	ОтражениеДокументовПоШаблонам.ОбработкаВыполнена КАК ОбработкаВыполнена,
		|	ОтражениеДокументовПоШаблонам.ШаблонОперации КАК ШаблонОперации,
		|	ОтражениеДокументовПоШаблонам.Трансляция КАК Трансляция,
		|	ОтражениеДокументовПоШаблонам.ДатаОтражения КАК ДатаОтражения
		|ИЗ
		|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
		|ГДЕ
		|	ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения В(&МассивДокументов)";   
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(Выборка.ИсходныйДокумент);
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.Сценарий.Установить(Выборка.Сценарий);
		НаборЗаписей.Отбор.ОбработкаВыполнена.Установить(Выборка.ОбработкаВыполнена);
		НаборЗаписей.Отбор.ШаблонОперации.Установить(Выборка.ШаблонОперации);
		НаборЗаписей.Отбор.Трансляция.Установить(Выборка.Трансляция);
		НаборЗаписей.Отбор.ДатаОтражения.Установить(Выборка.ДатаОтражения);
		
		Если УдалятьСвязанныеЗаписиРС Тогда 
			
			НаборЗаписей.Записать();  
			
		Иначе   
			
			НаборЗаписей.Прочитать(); 
			
			Для Каждого Запись Из НаборЗаписей Цикл 
				Запись.ДокументПервогоОтражения = Неопределено;  
			КонецЦикла;  
			
			НаборЗаписей.Записать(); 
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОбработатьЗаписиРСПоТКПомеченнымНаУдалениеНаСервере()

