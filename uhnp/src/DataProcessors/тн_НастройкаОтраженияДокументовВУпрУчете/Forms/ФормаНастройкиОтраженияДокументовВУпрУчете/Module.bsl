//
&НаКлиенте
Процедура ПослеЗавершенияУдаленияТК(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.АдресРезультата) Тогда
		ПослеЗавершенияУдаленияТКНаСервере(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Возникла ошибка при получении результатов удаления");	
	КонецЕсли;
	
	ЗапуститьФоновыеЗадания();
	
КонецПроцедуры  //ПослеЗавершенияУдаленияТК()

//Сафиуллина З.Р. 05.08.2024 Выполнение задач №000050397
//
&НаСервере
Процедура ПослеЗавершенияУдаленияТКНаСервере(АдресРезультата)
	
	РезультатУдаления = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если НЕ РезультатУдаления.Успешно Тогда
		ОбщегоНазначения.СообщитьПользователю("Удаление неуспешно!");
		
		Если РезультатУдаления.НеУдаленные.Количество() > 0 Тогда
			НеудаленныеОбъектыПредставления = Новый Массив;
			Для Каждого НеудаленныйОбъект Из РезультатУдаления.НеУдаленные Цикл
				НеудаленныеОбъектыПредставления.Добавить(Строка(НеудаленныйОбъект));	
			КонецЦикла;	
			ОбщегоНазначения.СообщитьПользователю("Список неудаленных объектов:" + Символы.ПС + СтрСоединить(НеудаленныеОбъектыПредставления,	Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры  //ПослеЗавершенияУдаленияТКНаСервере()

