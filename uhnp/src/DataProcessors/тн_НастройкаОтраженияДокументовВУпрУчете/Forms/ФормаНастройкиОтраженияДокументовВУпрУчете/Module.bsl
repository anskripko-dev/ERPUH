&НаСервере
Процедура ОбработатьЗаписиПоШаблонамТКСФлагомТрансляцияАвтоматическиНаСервере() 
	
	МассивДокументов = ТаблицаЗаписиПоШаблонамТКСФлагомТрансляция.Выгрузить().ВыгрузитьКолонку("ИсходныйДокумент");
	
	Запрос = Новый Запрос;
	Запрос.Текст =     
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент,
		|	ОтражениеДокументовПоШаблонам.Организация КАК Организация,
		|	ОтражениеДокументовПоШаблонам.Сценарий КАК Сценарий,
		|	ОтражениеДокументовПоШаблонам.ОбработкаВыполнена КАК ОбработкаВыполнена,
		|	ОтражениеДокументовПоШаблонам.ШаблонОперации КАК ШаблонОперации,
		|	ОтражениеДокументовПоШаблонам.Трансляция КАК Трансляция,
		|	ОтражениеДокументовПоШаблонам.ДатаОтражения КАК ДатаОтражения,
		|	ОтражениеДокументовПоШаблонам.УдалитьСценарий КАК УдалитьСценарий,
		|	ОтражениеДокументовПоШаблонам.ДатаЗаписиДоЗакрытияПериода КАК ДатаЗаписиДоЗакрытияПериода,
		|	ОтражениеДокументовПоШаблонам.ПериодОтбора КАК ПериодОтбора,
		|	ОтражениеДокументовПоШаблонам.ДокументПервогоОтражения КАК ДокументПервогоОтражения,
		|	ОтражениеДокументовПоШаблонам.ДатаЗаписиПослеЗакрытияПериода КАК ДатаЗаписиПослеЗакрытияПериода,
		|	ОтражениеДокументовПоШаблонам.ДокументСторноПервогоОтражения КАК ДокументСторноПервогоОтражения,
		|	ОтражениеДокументовПоШаблонам.ПериодОтражения КАК ПериодОтражения,
		|	ОтражениеДокументовПоШаблонам.ДокументПоследнегоОтражения КАК ДокументПоследнегоОтражения,
		|	ОтражениеДокументовПоШаблонам.ДатаЗакрытияПериодаОтражения КАК ДатаЗакрытияПериодаОтражения,
		|	ОтражениеДокументовПоШаблонам.ПроведениеОтменено КАК ПроведениеОтменено,
		|	ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием КАК ОтражениеФоновымЗаданием,
		|	ОтражениеДокументовПоШаблонам.УчетнаяПолитика КАК УчетнаяПолитика,
		|	ОтражениеДокументовПоШаблонам.ОтраженоВСледующемПериоде КАК ОтраженоВСледующемПериоде,
		|	ОтражениеДокументовПоШаблонам.СпособТрансляции КАК СпособТрансляции
		|ИЗ
		|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
		|ГДЕ
		|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент В(&МассивДокументов)
		|	И ОтражениеДокументовПоШаблонам.ШаблонОперации ССЫЛКА Справочник.ШаблоныТрансформационныхКорректировок
		|	И ОтражениеДокументовПоШаблонам.Трансляция";   
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		НаборЗаписей = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсходныйДокумент.Установить(Выборка.ИсходныйДокумент);
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.Сценарий.Установить(Выборка.Сценарий);
		НаборЗаписей.Отбор.ОбработкаВыполнена.Установить(Выборка.ОбработкаВыполнена);
		НаборЗаписей.Отбор.ШаблонОперации.Установить(Выборка.ШаблонОперации);
		НаборЗаписей.Отбор.ДатаОтражения.Установить(Выборка.ДатаОтражения);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Трансляция = Ложь;
		КонецЦикла;
		НаборЗаписей.Записать(); 
		
	КонецЦикла;
	
КонецПроцедуры // ОбработатьЗаписиПоШаблонамТКСФлагомТрансляцияАвтоматическиНаСервере()

