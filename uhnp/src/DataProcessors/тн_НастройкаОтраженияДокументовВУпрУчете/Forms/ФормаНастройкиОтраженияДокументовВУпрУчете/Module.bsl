#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаРасшифровкаПоДокументамОткрыта;   
&НаКлиенте
Перем ФормаРасшифровкаПоЗаписямОткрыта;
&НаКлиенте
Перем ПараметрыОбработчикаОжидания;
&НаСервере
Перем ОрганизацияДоЗагрузкиНастроек;
&НаСервере
Перем ДатаОкончанияПериодаДоЗагрузкиНастроек;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	Если Параметры.Свойство("Период") Тогда
		Период.Вариант = ВариантСтандартнойДатыНачала.ПроизвольнаяДата;
		Период.ДатаНачала = Параметры.ДатаНачала;    
		Период.ДатаОкончания = Параметры.Период;    
	КонецЕсли;
	
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	//ЗапуститьЗаданияПоОбновлениюДанныхСостоянияУпрУчета(ИнициализироватьСтруктуруЗаданийОбновления()); 
	ЗапуститьЗаданияПоОбновлениюДанныхСостоянияУпрУчета(ИнициализироватьСтруктуруЗаданийОбновления(ВариантАнализа));  
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	
	ДополнительныеПараметры = Новый Структура;
	ИнтеграцияССППР.ДобавитьРазмещениеКомандСППРВДополнительныеПараметры(Элементы.ГруппаСППР, ДополнительныеПараметры);
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка, ДополнительныеПараметры);
	
	ОрганизацияДоЗагрузкиНастроек = Организация;
	ДатаОкончанияПериодаДоЗагрузкиНастроек = Период;   
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ФормаРасшифровкаПоДокументамОткрыта = Ложь;
	ФормаРасшифровкаПоЗаписямОткрыта    = Ложь;

	ПодключитьПроверкуВыполненияФоновыхЗаданий();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Организация = Настройки.Получить("Организация");
	Период.Вариант = Настройки.Получить("Период.Вариант");
	Если Период.Вариант = ВариантСтандартнойДатыНачала.ПроизвольнаяДата Тогда
		Период.ДатаНачала = Настройки.Получить("Период.ДатаНачала");
		Период.ДатаОкончания = Настройки.Получить("Период.ДатаОкончания");
	КонецЕсли; 
	// НАЧАЛО Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584
	УчетныеПолитикиМСФО = Настройки.Получить("УчетныеПолитикиМСФО");   
	// КОНЕЦ Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584 
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	Если Параметры.Свойство("Период") Тогда
		Период.Вариант = ВариантСтандартнойДатыНачала.ПроизвольнаяДата;
		Период.ДатаНачала = Параметры.ДатаНачала;    
		Период.ДатаОкончания = Параметры.Период;    
	КонецЕсли;
		
	Если ОрганизацияДоЗагрузкиНастроек <> Организация Или ДатаОкончанияПериодаДоЗагрузкиНастроек <> Период Тогда  
		// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
		//ЗапуститьЗаданияПоОбновлениюДанныхСостоянияУпрУчета(ИнициализироватьСтруктуруЗаданийОбновления()); 
		ЗапуститьЗаданияПоОбновлениюДанныхСостоянияУпрУчета(ИнициализироватьСтруктуруЗаданийОбновления(ВариантАнализа));  
		// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
 
#Область СлужебныеПроцедурыИФункции

#Область Общие

&НаКлиенте
Функция ИнициализироватьПараметрыФормыДлительнойОперации(РезультатЗапускаФоновогоЗадания)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторЗадания", РезультатЗапускаФоновогоЗадания.ИдентификаторЗадания);
	ПараметрыФормы.Вставить("ВыводитьОкноОжидания", Истина);
	ПараметрыФормы.Вставить("ПолучатьРезультат", Истина);
	ПараметрыФормы.Вставить("АдресРезультата", РезультатЗапускаФоновогоЗадания.АдресРезультата);
		
	Возврат ПараметрыФормы;

КонецФункции

&НаСервере
//Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397: + ШаблоныТКСФлагомТрансляция
////Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192: + ТолькоСПроводкамиВТрансформационныхКорректировках
////// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044 
//////Функция ПолучитьАдресВременногоХранилища(ИмяРеквизитаФормы, ФормироватьСтруктуру = Истина, ОтборОбработка = Ложь, ОтборОтменаПроведения = Ложь)  
////Функция ПолучитьАдресВременногоХранилища(ИмяРеквизитаФормы, ФормироватьСтруктуру = Истина, ОтборОбработка = Ложь, ОтборОтменаПроведения = Ложь, БезПроводок = Ложь)  
////// КОНЕЦ Гутарова Екатерина 30.06.2023 Выполнение задач №000046044	
//Функция ПолучитьАдресВременногоХранилища(ИмяРеквизитаФормы, ФормироватьСтруктуру = Истина, ОтборОбработка = Ложь, ОтборОтменаПроведения = Ложь, БезПроводок = Ложь, ТолькоСПроводкамиВТрансформационныхКорректировках = Ложь)  
Функция ПолучитьАдресВременногоХранилища(ИмяРеквизитаФормы, ФормироватьСтруктуру = Истина, ОтборОбработка = Ложь, ОтборОтменаПроведения = Ложь, БезПроводок = Ложь, 
	ТолькоСПроводкамиВТрансформационныхКорректировках = Ложь, ШаблоныТКСФлагомТрансляция = Ложь)

	ТЗ = РеквизитФормыВЗначение(ИмяРеквизитаФормы, Тип("ТаблицаЗначений"));
	
	Если ФормироватьСтруктуру Тогда
		МассивДокументов = ТЗ.ВыгрузитьКолонку("ИсходныйДокумент");  
		СтруктураДанных = Новый Структура;
		Если ОтборОбработка Тогда 
			СтруктураДанных.Вставить("ОтборОбработка", Истина);
		КонецЕсли;      
	    Если ОтборОтменаПроведения Тогда 
			СтруктураДанных.Вставить("ОтборОтменаПроведения", Истина);
		КонецЕсли;
		//НАЧАЛО Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192
		Если ТолькоСПроводкамиВТрансформационныхКорректировках Тогда 
			СтруктураДанных.Вставить("ТолькоСПроводкамиВТрансформационныхКорректировках", Истина);
		КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 16.07.2024 Выполнение задач №000050192
		//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
		Если ШаблоныТКСФлагомТрансляция Тогда 
			СтруктураДанных.Вставить("ШаблоныТКСФлагомТрансляция", Истина);
		КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
		СтруктураДанных.Вставить("МассивОрганизаций", Организация);
		СтруктураДанных.Вставить("МассивДокументов", МассивДокументов);
		Адрес = ПоместитьВоВременноеХранилище(СтруктураДанных, Новый УникальныйИдентификатор);      
	Иначе    
		СтруктураДанных = Новый Структура;       
		СтруктураДанных.Вставить("Организация", Организация);
		СтруктураДанных.Вставить("ТЗ", ТЗ);    
		СтруктураДанных.Вставить("ДатаНачала", Период.ДатаНачала);
        СтруктураДанных.Вставить("ДатаОкончания", Период.ДатаОкончания);  
		// НАЧАЛО Гутарова Екатерина 30.06.2023 Выполнение задач №000046044 
		СтруктураДанных.Вставить("БезПроводок", БезПроводок);
	    // КОНЕЦ Гутарова Екатерина 30.06.2023 Выполнение задач №000046044	
		Адрес = ПоместитьВоВременноеХранилище(СтруктураДанных, Новый УникальныйИдентификатор)
	КонецЕсли;    
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	СтруктураДанных.Вставить("ВариантАнализа", ВариантАнализа);
    // КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьУниверсальнуюФормуРасшифровкиПоДокументам(ПараметрыФормыРасшифровки)
	
	Если ФормаРасшифровкаПоДокументамОткрыта Тогда
		Оповестить("РасшифровкаПоДокументам_ИзмененийУсловийОтбора", ПараметрыФормыРасшифровки, ЭтотОбъект);
	Иначе
		ОповещениеОЗакрытииФормы = Новый ОписаниеОповещения("ПриЗакрытииФормыРасшифровкаПоДокументам", ЭтотОбъект);
		ОткрытьФорму("Обработка.тн_НастройкаОтраженияДокументовВУпрУчете.Форма.РасшифровкаПоДокументам", ПараметрыФормыРасшифровки, ЭтотОбъект,,,, ОповещениеОЗакрытииФормы);
		ФормаРасшифровкаПоДокументамОткрыта = Истина;
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ПоказатьУниверсальнуюФормуРасшифровкиПоЗаписям(ПараметрыФормыРасшифровки)
	
	Если ФормаРасшифровкаПоЗаписямОткрыта Тогда
		Оповестить("РасшифровкаПоЗаписям_ИзмененийУсловийОтбора", ПараметрыФормыРасшифровки, ЭтотОбъект);
	Иначе
		ОповещениеОЗакрытииФормы = Новый ОписаниеОповещения("ПриЗакрытииФормыРасшифровкаПоЗаписям", ЭтотОбъект);
		ОткрытьФорму("Обработка.тн_НастройкаОтраженияДокументовВУпрУчете.Форма.РасшифровкаПоЗаписям", ПараметрыФормыРасшифровки, ЭтотОбъект,,,, ОповещениеОЗакрытииФормы);
		ФормаРасшифровкаПоЗаписямОткрыта = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584  
//
&НаСервереБезКонтекста
Функция ПолучитьМассивОрганизацийПоУчетнымПолитикам(МассивУчетныхПолитикМСФО, Период, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеПолитикиМСФОСрезПоследних.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.УчетныеПолитикиМСФО.СрезПоследних(&Период, 
	|    // Организация = &Организация
	|     ) КАК УчетныеПолитикиМСФОСрезПоследних
	|ГДЕ
	|	УчетныеПолитикиМСФОСрезПоследних.УчетнаяПолитика В(&МассивУчетныхПолитикМСФО)";

	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//", "");
	КонецЕсли;
	Запрос.УстановитьПараметр("МассивУчетныхПолитикМСФО", МассивУчетныхПолитикМСФО);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивОрганизаций = Новый Массив;	
	Пока Выборка.Следующий() Цикл
		МассивОрганизаций.Добавить(Выборка.Организация);
	КонецЦикла;   

	Возврат МассивОрганизаций;  
	
КонецФункции

// Юдина (Гутарова) Екатерина 21.08.2024 Выполнение задач №000050584 
//
&НаКлиенте
Процедура ПроверитьЗаполнениеШапки()
	
	Если ЗначениеЗаполнено(Период.ДатаОкончания) И Период.ДатаНачала > Период.ДатаОкончания Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата окончания раньше, чем дата начала!");
		Возврат;
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена дата начала периода!");   
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеЭлементамиФормы

&НаКлиенте
Процедура ПриЗакрытииФормыРасшифровкаПоЗаписям(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ФормаРасшифровкаПоЗаписямОткрыта = Ложь;
	
КонецПроцедуры      

&НаКлиенте
Процедура ПриЗакрытииФормыРасшифровкаПоДокументам(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ФормаРасшифровкаПоДокументамОткрыта = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные(ИмяОперации, РезультатВыполнения)
	
	Если ИмяОперации = "СостояниеОтраженияДокументовЕстьШаблоныПроводок" Тогда
	    ОбновитьДанныеСостояниеОтраженияДокументовЕстьШаблоныПроводок(РезультатВыполнения);
	ИначеЕсли ИмяОперации = "СостояниеОтраженияДокументовНетШаблоновПроводок" Тогда
		ОбновитьДанныеСостояниеОтраженияДокументовНетШаблоновПроводок(РезультатВыполнения);  
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	ИначеЕсли ИмяОперации = "СостояниеОтраженияДокументовТрансляции" Тогда
		ОбновитьДанныеСостояниеОтраженияДокументовТрансляции(РезультатВыполнения); 
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424
	//НАЧАЛО Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	ИначеЕсли ИмяОперации = "СостояниеОтраженияЗаписейПоШаблонамТКСФлагомТрансляции" Тогда
		ОбновитьДанныеСостояниеОтраженияЗаписейПоШаблонамТКСФлагомТрансляции(РезультатВыполнения);
	ИначеЕсли ИмяОперации = "СостояниеТКПомеченныеНаУдаление" Тогда
		ОбновитьДанныеСостояниеТКПомеченныеНаУдаление(РезультатВыполнения);	
	//КОНЕЦ Сафиуллина З.Р. 02.08.2024 Выполнение задач №000050397
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСостояниеОтраженияДокументовНетШаблоновПроводок(РезультатВыполненияФоновогоЗадания)
	
	// НАЧАЛО Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	Если ВариантАнализа = 2 Тогда
		Элементы.ГруппаТрансляции.Видимость = Истина;
		Элементы.ГруппаУУМСФО.Видимость = Ложь;
		Возврат;
	ИначеЕсли ВариантАнализа = 1 Тогда
		Элементы.ОтборОперации.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	// КОНЕЦ Гутарова Екатерина 09.11.2023 Выполнение задач №000047424	
	
	Если РезультатВыполненияФоновогоЗадания.Статус = "Выполнено" Тогда
		
		Данные = ПолучитьИзВременногоХранилища(РезультатВыполненияФоновогоЗадания.АдресРезультата);
		
		ЗначениеВРеквизитФормы(Данные.ТаблицаНетШаблоновПроводок, "ТаблицаНетШаблоновПроводок");  
		
		Элементы.ГруппаНастройкаОтображенияПроводокИнформация.Видимость = Ложь;  
		
		Если Данные.ТаблицаНетШаблоновПроводок.Количество() > 0 Тогда
			
			Элементы.НадписьОтборОперации.Видимость = Истина;   
			Элементы.НадписьОтборОперации.Заголовок = "Следует проверить исходные документы на вхождение в отбор по операции(" + Данные.ТаблицаНетШаблоновПроводок.Количество() +")";
			Элементы.НадписьНастройкиШаблонов.Видимость = Истина;
			Элементы.ПерейтиОтборОперации.Видимость = Истина; 
			Элементы.НадписьОтборОперации.ЦветТекста = ЦветаСтиля.ЦветШрифтаОшибки;
			Элементы.НадписьИнформацияНетШаблоновПроводок.Заголовок = Данные.ИнформацияНетШаблоновПроводок;	
