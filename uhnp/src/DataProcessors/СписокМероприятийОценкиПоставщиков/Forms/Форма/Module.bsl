
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	текПользователи.Очистить();
	МодульУправленияПроцессамиУХ.ПолучитьЗамещаемых(ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь"),текПользователи);
	МассивПользователей = текПользователи.ВыгрузитьЗначения();
	текПользователи.Добавить(ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь"));
	ОбщегоНазначенияКлиентСерверУХ.УстановитьЭлементОтбора(МероприятияОценкиПоставщиков.Отбор,		 "Ответственный", текПользователи, ВидСравненияКомпоновкиДанных.ВСписке, , Истина);

КонецПроцедуры

&НаКлиенте
Процедура МероприятияОценкиПоставщиковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	// Открыть выбранную задачу.
	ТекДанные = Элементы.МероприятияОценкиПоставщиков.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекДанные.МероприятиеПоОценке) Тогда
			Мероприятие = ТекДанные.МероприятиеПоОценке;
			ОткрытьЗначение(Мероприятие);
			//ПараметрыФормы = Новый Структура("ВладелецОбъектовВыбора", Мероприятие);
			//ОткрытьФорму("Документ.Мероприятие.ОценкаОбъектов.Форма", ПараметрыФормы, );
		Иначе
			// Нет данных для открытия
		КонецЕсли;
	Иначе	
		// Нет связанного объекта
	КонецЕсли;

КонецПроцедуры
