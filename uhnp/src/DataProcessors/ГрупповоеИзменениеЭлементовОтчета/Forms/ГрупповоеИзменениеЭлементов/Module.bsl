&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)

	ПриИзмененииТипаЗначения();
	ИзменитьСостояниеИзменения(Элемент);
	
КонецПроцедуры
	
&НаСервере
Процедура ПриИзмененииТипаЗначения()
	
	ВидИтогаИзменить = Истина;
	
	Если ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
		
		ВидИтога = Перечисления.ВидыИтоговПоказателя.Сумма;
		
	Иначе
		
		Валютный = Ложь;
		ВалютныйИзменить = Истина;
		ПересчитыватьВалютнуюСумму = Ложь;
		ПересчитыватьВалютнуюСуммуИзменить = Истина;
		НеСуммируется = Истина;
		НеСуммируетсяИзменить = Истина;
		КонтролируемыйПоказатель = Ложь;
		КонтролируемыйПоказательИзменить = Истина;
		
		ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается;
		
	КонецЕсли;
	
	ЗаполнитьСпискиВидовИтогов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВидовИтогов()
	
	Элементы.ВидИтога.СписокВыбора.Очистить();
	Элементы.ВидИтога.СписокВыбора.Добавить(Перечисления.ВидыИтоговПоказателя.НеРассчитывается);
	Элементы.ВидИтога.СписокВыбора.Добавить(Перечисления.ВидыИтоговПоказателя.Минимум);
	Элементы.ВидИтога.СписокВыбора.Добавить(Перечисления.ВидыИтоговПоказателя.Максимум);
	
	Если ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
		Элементы.ВидИтога.СписокВыбора.Добавить(Перечисления.ВидыИтоговПоказателя.Среднее);
		Элементы.ВидИтога.СписокВыбора.Добавить(Перечисления.ВидыИтоговПоказателя.Сумма);
	КонецЕсли;
	
КонецПроцедуры

