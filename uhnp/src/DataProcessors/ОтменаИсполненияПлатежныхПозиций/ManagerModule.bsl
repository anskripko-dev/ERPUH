#Область ПрограмныйИнтерфейс

Процедура ОтменитьИсполнениеПоЗаявкам(МассивИдентификаторов, 
				ОтменаСогласования = Ложь, РеестрПлатежей = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛОЖЬ КАК Пометка,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК Заявка,
	|	ПРЕДСТАВЛЕНИЕ(РазмещениеЗаявок.ЗаявкаНаОперацию) КАК ЗаявкаПредставление,
	|	РазмещениеЗаявок.ДатаИсполнения КАК Дата,
	|	РазмещениеЗаявок.Сумма КАК Сумма,
	|	РазмещениеЗаявок.ВалютаОплаты КАК ВалютаПлатежа,
	|	РазмещениеЗаявок.Организация КАК Организация,
	|	РазмещениеЗаявок.БанковскийСчетКасса КАК СчетОрганизации,
	|	РазмещениеЗаявок.Контрагент КАК Контрагент,
	|	РазмещениеЗаявок.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ПриходРасход КАК ПриходРасход,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения КАК Состояние,
	|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка КАК ПлатежноеПоручение,
	|	РеестрПлатежейЗаявкиНаОплату.Ссылка КАК Реестр,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СостоянияИсполненныхЗаявок.СостояниеИсполнения) КАК КоличествоИсполнены
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненияДокументовПланированияСрезПоследних
	|		ПО (СостоянияИсполненияДокументовПланированияСрезПоследних.ДокументПланирования = РазмещениеЗаявок.ЗаявкаНаОперацию)
	|			И (СостоянияИсполненияДокументовПланированияСрезПоследних.ИдентификаторПозиции = РазмещениеЗаявок.ИдентификаторПозиции)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПлатежноеПоручениеРасшифровкаПлатежа
	|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = ПлатежноеПоручениеРасшифровкаПлатежа.ДокументПланирования
	|			И РазмещениеЗаявок.ИдентификаторПозиции = ПлатежноеПоручениеРасшифровкаПлатежа.ИдентификаторПозиции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеестрПлатежей.ЗаявкиНаОплату КАК РеестрПлатежейЗаявкиНаОплату
	|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = РеестрПлатежейЗаявкиНаОплату.ЗаявкаНаОплату
	|			И (РеестрПлатежейЗаявкиНаОплату.Ссылка.Проведен)
	|			И РазмещениеЗаявок.ИдентификаторПозиции = РеестрПлатежейЗаявкиНаОплату.ИдентификаторПозиции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненныхЗаявок
	|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = СостоянияИсполненныхЗаявок.ДокументПланирования
	|			И (СостоянияИсполненныхЗаявок.СостояниеИсполнения В (ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.Исполнена), ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НаИсполнении)))
	|ГДЕ
	|	(СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.ВключенаВРеестрПлатежей)
	|			ИЛИ СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НаИсполнении))
	|	И РазмещениеЗаявок.ИдентификаторПозиции В(&МассивИдентификаторов)
	|	И ВЫБОР
	|			КОГДА &РеестрПлатежейЗаполнен
	|				ТОГДА РеестрПлатежейЗаявкиНаОплату.Ссылка = &РеестрПлатежей
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеЗаявок.ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ДатаИсполнения,
	|	РазмещениеЗаявок.Сумма,
	|	РазмещениеЗаявок.ВалютаОплаты,
	|	РазмещениеЗаявок.Организация,
	|	РазмещениеЗаявок.БанковскийСчетКасса,
	|	РазмещениеЗаявок.Контрагент,
	|	РазмещениеЗаявок.ДоговорКонтрагента,
	|	РазмещениеЗаявок.ПриходРасход,
	|	РазмещениеЗаявок.ИдентификаторПозиции,
	|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения,
	|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка,
	|	РеестрПлатежейЗаявкиНаОплату.Ссылка,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию";

	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Запрос.УстановитьПараметр("РеестрПлатежейЗаполнен", ЗначениеЗаполнено(РеестрПлатежей));
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КоличествоИсполнены) И ОтменаСогласования Тогда
			ТекстСообщения = НСтр("ru = 'Отмена позиции невозможна, имеются исполненные/на исполнение позиции по объекту %1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.ЗаявкаПредставление);
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Продолжить;
		КонецЕсли;	   
		
		Если ЗначениеЗаполнено(Выборка.ПлатежноеПоручение) Тогда 
			ПлатежноеПоручение = Выборка.ПлатежноеПоручение.ПолучитьОбъект();
			ПлатежноеПоручение.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Реестр) Тогда 
			
			Реестр = Выборка.Реестр.ПолучитьОбъект();
			
			СтрокиРеестра = Реестр.ЗаявкиНаОплату.НайтиСтроки(
				Новый Структура("ИдентификаторПозиции", Выборка.ИдентификаторПозиции));
			Для Каждого СтрокаРеестра Из СтрокиРеестра Цикл
				СтрокаРеестра.Исключена 		= Истина;
				СтрокаРеестра.КтоИсключил 		= ПользователиКлиентСервер.ТекущийПользователь();
				СтрокаРеестра.ПричинаИсключения = "Исключена администратором";
			КонецЦикла; 
			Реестр.Записать(РежимЗаписиДокумента.Проведение);	   
			
		КонецЕсли;
		
		НЗ = РегистрыСведений.СостоянияИсполненияДокументовПланирования.СоздатьНаборЗаписей();
		НЗ.Отбор.ИдентификаторПозиции.Установить(Выборка.ИдентификаторПозиции);
		НЗ.Прочитать();
		
		Для Каждого СтрокаНЗ Из НЗ Цикл
			СтрокаНЗ.СостояниеИсполнения = Перечисления.СостоянияИсполненияЗаявки.НеОбработана;
		КонецЦикла; 
		
		НЗ.Записать(Истина);
		
		Если ОтменаСогласования Тогда
			МодульУправленияПроцессамиУХ.ОтменитьСогласованиеОбъекта(Выборка.Заявка);
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

#КонецОбласти 