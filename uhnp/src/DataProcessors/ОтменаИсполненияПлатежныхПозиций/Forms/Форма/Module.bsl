#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНаСервере();
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	
    МассивПараметров = Новый Массив;

    Если ЗначениеЗаполнено(Организация) Тогда

        НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", 	Организация);

        МассивПараметров.Добавить(НовыйПараметр);

	КонецЕсли;
	
    Если ЗначениеЗаполнено(Контрагент) Тогда

        НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", 		Контрагент);

        МассивПараметров.Добавить(НовыйПараметр);

    КонецЕсли;
 
    НовыйПараметр = Новый ПараметрВыбора("Отбор.Проведен", Истина);

    МассивПараметров.Добавить(НовыйПараметр);

    Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыПлатежныеПозиции
&НаКлиенте
Процедура ПлатежныеПозицииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные  = Неопределено Тогда
	    Возврат;		
	КонецЕсли; 
	
	Если Поле.Имя = "ПлатежныеПозицииРеестр" Тогда
	     ОткрытьЗначение(Элемент.ТекущиеДанные.Реестр);
	ИначеЕсли Поле.Имя = "ПлатежныеПозицииЗаявка" Тогда
	     ОткрытьЗначение(Элемент.ТекущиеДанные.Заявка);
	ИначеЕсли Поле.Имя = "ПлатежныеПозицииПлатежноеПоручение" Тогда
	     ОткрытьЗначение(Элемент.ТекущиеДанные.ПлатежноеПоручение);
    КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы
&НаСервере
Процедура ЗаполнитьНаСервере()

	Объект.ПлатежныеПозиции.Очистить();
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛОЖЬ КАК Пометка,
		|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК Заявка,
		|	РазмещениеЗаявок.ДатаИсполнения КАК Дата,
		|	РазмещениеЗаявок.Сумма КАК Сумма,
		|	РазмещениеЗаявок.ВалютаОплаты КАК ВалютаПлатежа,
		|	РазмещениеЗаявок.Организация КАК Организация,
		|	РазмещениеЗаявок.БанковскийСчетКасса КАК СчетОрганизации,
		|	РазмещениеЗаявок.Контрагент КАК Контрагент,
		|	РазмещениеЗаявок.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
		|	РазмещениеЗаявок.ПриходРасход КАК ПриходРасход,
		|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
		|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения КАК Состояние,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка КАК ПлатежноеПоручение,
		|	РеестрПлатежейЗаявкиНаОплату.Ссылка КАК Реестр,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СостоянияИсполненныхЗаявок.СостояниеИсполнения) КАК КоличествоИсполнены
		|ИЗ
		|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненияДокументовПланированияСрезПоследних
		|		ПО (СостоянияИсполненияДокументовПланированияСрезПоследних.ДокументПланирования = РазмещениеЗаявок.ЗаявкаНаОперацию)
		|			И (СостоянияИсполненияДокументовПланированияСрезПоследних.ИдентификаторПозиции = РазмещениеЗаявок.ИдентификаторПозиции)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПлатежноеПоручениеРасшифровкаПлатежа
		|		ПО РазмещениеЗаявок.ИдентификаторПозиции = ПлатежноеПоручениеРасшифровкаПлатежа.ИдентификаторПозиции
		|			И РазмещениеЗаявок.ЗаявкаНаОперацию = ПлатежноеПоручениеРасшифровкаПлатежа.ДокументПланирования
      	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеестрПлатежей.ЗаявкиНаОплату КАК РеестрПлатежейЗаявкиНаОплату
		|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = РеестрПлатежейЗаявкиНаОплату.ЗаявкаНаОплату
		|			И (РеестрПлатежейЗаявкиНаОплату.Ссылка.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних КАК СостоянияИсполненныхЗаявок
		|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = СостоянияИсполненныхЗаявок.ДокументПланирования
		|			И (СостоянияИсполненныхЗаявок.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.Исполнена))
		|ГДЕ
		|	(СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.ВключенаВРеестрПлатежей)
		|			ИЛИ СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения = ЗНАЧЕНИЕ(Перечисление.СостоянияИсполненияЗаявки.НаИсполнении))
		|	И &ОрганизацияОтбор
		|	И &КонтрагентОтбор
		|	И &ДоговорОтбор
		|
		|СГРУППИРОВАТЬ ПО
		|	РазмещениеЗаявок.ЗаявкаНаОперацию,
		|	РазмещениеЗаявок.ДатаИсполнения,
		|	РазмещениеЗаявок.Сумма,
		|	РазмещениеЗаявок.ВалютаОплаты,
		|	РазмещениеЗаявок.Организация,
		|	РазмещениеЗаявок.БанковскийСчетКасса,
		|	РазмещениеЗаявок.Контрагент,
		|	РазмещениеЗаявок.ДоговорКонтрагента,
		|	РазмещениеЗаявок.ЗаявкаНаОперацию,
		|	РазмещениеЗаявок.ПриходРасход,
		|	РазмещениеЗаявок.ИдентификаторПозиции,
		|	СостоянияИсполненияДокументовПланированияСрезПоследних.СостояниеИсполнения,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка,
		|	РеестрПлатежейЗаявкиНаОплату.Ссылка";
	
	Если ЗначениеЗаполнено(Организация) Тогда
	    Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОрганизацияОтбор", "РазмещениеЗаявок.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", 		Организация);
	Иначе
		Запрос.УстановитьПараметр("ОрганизацияОтбор", 	Истина);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
	    Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КонтрагентОтбор", "РазмещениеЗаявок.Контрагент = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", 		Контрагент);
	Иначе
		Запрос.УстановитьПараметр("КонтрагентОтбор", 	Истина);
	КонецЕсли; 

	Если ЗначениеЗаполнено(Договор) Тогда
	    Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДоговорОтбор", "РазмещениеЗаявок.ДоговорКонтрагента = &Договор");
		Запрос.УстановитьПараметр("Договор", 			Договор);
	Иначе
		Запрос.УстановитьПараметр("ДоговорОтбор", 		Истина);
	КонецЕсли; 

	РезультатЗапроса 		= Запрос.Выполнить();
	Выборка				 	= РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаПлатежныеПозиции = Объект.ПлатежныеПозиции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПлатежныеПозиции, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СброситьСостояниеНаСервере(ОтменаСогласования = Ложь)
	Для каждого СтрокаПлатежныеПозиции Из Объект.ПлатежныеПозиции Цикл
		Если НЕ СтрокаПлатежныеПозиции.Пометка Тогда
			Продолжить;		   
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаПлатежныеПозиции.КоличествоИсполнены) И ОтменаСогласования Тогда
			ТекстСообщения = НСтр("ru = 'Отмена позиции невозможна, имеются исполненные позиции по объекту %1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(СтрокаПлатежныеПозиции.Заявка));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Продолжить;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СтрокаПлатежныеПозиции.ПлатежноеПоручение) Тогда 
			ПлатежноеПоручение = СтрокаПлатежныеПозиции.ПлатежноеПоручение.ПолучитьОбъект();
			ПлатежноеПоручение.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПлатежныеПозиции.Реестр) Тогда 
			Реестр 			= СтрокаПлатежныеПозиции.Реестр.ПолучитьОбъект();
			СтрокиРеестра 	= Реестр.ЗаявкиНаОплату.НайтиСтроки(Новый Структура("ИдентификаторПозиции", СтрокаПлатежныеПозиции.ИдентификаторПозиции));
			Для каждого СтрокаРеестра Из СтрокиРеестра Цикл
				СтрокаРеестра.Исключена 		= Истина;
				СтрокаРеестра.КтоИсключил 		= ПользователиКлиентСервер.ТекущийПользователь();
				СтрокаРеестра.ПричинаИсключения = "Исключена администратором";
			КонецЦикла; 
			Реестр.Записать(РежимЗаписиДокумента.Проведение);	   
			
		КонецЕсли;
		
		НЗ = РегистрыСведений.СостоянияИсполненияДокументовПланирования.СоздатьНаборЗаписей();
		НЗ.Отбор.ИдентификаторПозиции.Установить(СтрокаПлатежныеПозиции.ИдентификаторПозиции);
		НЗ.Прочитать();
		
		Для каждого СтрокаНЗ Из НЗ Цикл
			СтрокаНЗ.СостояниеИсполнения = Перечисления.СостоянияИсполненияЗаявки.НеОбработана;
		КонецЦикла; 
		
		НЗ.Записать(Истина);
		
	   	Если ОтменаСогласования Тогда
			МодульУправленияПроцессамиУХ.ОтменитьСогласованиеОбъекта(СтрокаПлатежныеПозиции.Заявка);
		КонецЕсли;

	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СброситьСостояние(Команда)
	СброситьСостояниеНаСервере();
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметку(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуСоВсех(Команда)
	УстановитьОтметку(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИсполнениеИСогласование(Команда)
	СброситьСостояниеНаСервере(Истина);
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтменитьИсполнениеИСогласованиеНаСервере()
	Для каждого СтрокаПлатежныеПозиции Из Объект.ПлатежныеПозиции Цикл
	       Если НЕ СтрокаПлатежныеПозиции.Пометка Тогда
		        Продолжить;		   
		   КонецЕсли; 
		   
		   Если ЗначениеЗаполнено(СтрокаПлатежныеПозиции.ПлатежноеПоручение) Тогда 
			   ПлатежноеПоручение = СтрокаПлатежныеПозиции.ПлатежноеПоручение.ПолучитьОбъект();
			   ПлатежноеПоручение.УстановитьПометкуУдаления(Истина);
		   КонецЕсли;
		   
		   Если ЗначениеЗаполнено(СтрокаПлатежныеПозиции.Реестр) Тогда 
			   Реестр 			= СтрокаПлатежныеПозиции.Реестр.ПолучитьОбъект();
			   СтрокиРеестра 	= Реестр.ЗаявкиНаОплату.НайтиСтроки(Новый Структура("ИдентификаторПозиции", СтрокаПлатежныеПозиции.ИдентификаторПозиции));
			   Для каждого СтрокаРеестра Из СтрокиРеестра Цикл
			    	СтрокаРеестра.Исключена 		= Истина;
					СтрокаРеестра.КтоИсключил 		= ПользователиКлиентСервер.ТекущийПользователь();
					СтрокаРеестра.ПричинаИсключения = "Исключена администратором";
			   КонецЦикла; 
			   Реестр.Записать(РежимЗаписиДокумента.Проведение);	   
				
		   КонецЕсли;

		   НЗ = РегистрыСведений.СостоянияИсполненияДокументовПланирования.СоздатьНаборЗаписей();
		   НЗ.Отбор.ИдентификаторПозиции.Установить(СтрокаПлатежныеПозиции.ИдентификаторПозиции);
		   НЗ.Прочитать();
		   
		   Для каждого СтрокаНЗ Из НЗ Цикл
		   		СтрокаНЗ.СостояниеИсполнения = Перечисления.СостоянияИсполненияЗаявки.НеОбработана;
		   КонецЦикла; 
				   
		   НЗ.Записать(Истина);
	   
	КонецЦикла; 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура УстановитьОтметку(Отметка)
	
	Для каждого СтрокаПлатежныеПозиции Из Объект.ПлатежныеПозиции Цикл
		СтрокаПлатежныеПозиции.Пометка = Отметка;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
