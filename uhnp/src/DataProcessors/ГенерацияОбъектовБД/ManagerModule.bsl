#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ПолучитьПараметрыДляЗаполненияОбъектовБДПоИсходному(ИсходныйОбъектБД,Организация=Неопределено,Сценарий=Неопределено,ТипБДПриемник=Неопределено,ИмяОбъектаБД=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	НастройкиЗаполненияОбъектовБД.ПравилоЗаполнения,
	|	НастройкиЗаполненияОбъектовБД.ИспользуемаяИБ,
	|	НастройкиЗаполненияОбъектовБД.ОбъектБД,
	|	НастройкиЗаполненияОбъектовБД.ВыполнятьАвтоматически,
	|	НастройкиЗаполненияОбъектовБД.ПроводитьДокументы,
	|	НастройкиЗаполненияОбъектовБД.ОбластьГенерации,
	|	НастройкиЗаполненияОбъектовБД.ИсходныйОбъектБД.Наименование КАК НаименованиеДокументаБД
	|ИЗ
	|	РегистрСведений.НастройкиЗаполненияОбъектовБД КАК НастройкиЗаполненияОбъектовБД
	|ГДЕ
	|	НастройкиЗаполненияОбъектовБД.ИсходныйОбъектБД = &ИсходныйОбъектБД";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос.Текст=Запрос.Текст+"	
		|	И (НастройкиЗаполненияОбъектовБД.Организация = &Организация ИЛИ НастройкиЗаполненияОбъектовБД.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))";
		Запрос.УстановитьПараметр("Организация",Организация);
					
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Сценарий) Тогда
		
		Запрос.Текст=Запрос.Текст+"	
		|	И ( НастройкиЗаполненияОбъектовБД.Сценарий = &Сценарий ИЛИ НастройкиЗаполненияОбъектовБД.Сценарий = ЗНАЧЕНИЕ(Справочник.Сценарии.ПустаяСсылка))";
		Запрос.УстановитьПараметр("Сценарий",Сценарий);
						
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ИсходныйОбъектБД",ИсходныйОбъектБД);
	
	Если ЗначениеЗаполнено(ТипБДПриемник) Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|И НастройкиЗаполненияОбъектовБД.ОбъектБД.Владелец=&ТипБДПриемник";
		
		Запрос.УстановитьПараметр("ТипБДПриемник",ТипБДПриемник);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяОбъектаБД) Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|И НастройкиЗаполненияОбъектовБД.ОбъектБД=&ОбъектБД";
		
		Запрос.УстановитьПараметр("ОбъектБД",Справочники.ДокументыБД.НайтиПоНаименованию(ИмяОбъектаБД,Истина,,ТипБДПриемник));
		
	КонецЕсли;
		
	Результат=Запрос.Выполнить().Выбрать();
	
	МассивОбъектов=Новый Массив;
	
	Пока Результат.Следующий() Цикл 
		
		МассивОбъектов.Добавить(Новый Структура("ОбъектБД,ПравилоЗаполнения,ИспользуемаяИБ,ВыполнятьАвтоматически,ПроводитьДокументы,ОбластьГенерации,НаименованиеДокументаБД",
		                        Результат.ОбъектБД,
								Результат.ПравилоЗаполнения,
								Результат.ИспользуемаяИБ,
								Результат.ВыполнятьАвтоматически,
								Результат.ПроводитьДокументы,
								Результат.ОбластьГенерации,
								Результат.НаименованиеДокументаБД));
			
	КонецЦикла;
							
	Возврат МассивОбъектов;						
		
КонецФункции // ПолучитьПараметрыДляЗаполненияОбъектовБДПоИсходному()

Процедура СоздатьОбновитьДокументыПоПравилам() Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.Организация КАК Организация,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.Сценарий КАК Сценарий,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ОбъектБД КАК ОбъектБД,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ПравилоЗаполнения КАК ПравилоЗаполнения,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ИсходныйОбъектБД КАК ИсходныйОбъектБД,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ОбластьГенерации КАК ОбластьГенерации,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ИспользуемаяИБ КАК ИспользуемаяИБ,
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.ПроводитьДокументы КАК ПроводитьДокументы
	             |ПОМЕСТИТЬ НастройкиОбработки
	             |ИЗ
	             |	РегистрСведений.НастройкиЗаполненияОбъектовБД.СрезПоследних(, ) КАК НастройкиЗаполненияОбъектовБДСрезПоследних
	             |ГДЕ
	             |	НастройкиЗаполненияОбъектовБДСрезПоследних.СпособФормирования = ЗНАЧЕНИЕ(Перечисление.СпособыФормированияДокументовПоПравилам.РегламентнымЗаданием)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	НастройкиОбработки.Организация КАК Организация,
	             |	НастройкиОбработки.Сценарий КАК Сценарий,
	             |	НастройкиОбработки.ОбъектБД КАК ОбъектБД,
	             |	НастройкиОбработки.ПравилоЗаполнения КАК ПравилоЗаполнения,
	             |	НастройкиОбработки.ИсходныйОбъектБД КАК ИсходныйОбъектБД,
	             |	НастройкиОбработки.ОбластьГенерации КАК ОбластьГенерации,
	             |	НастройкиОбработки.ИспользуемаяИБ КАК ИспользуемаяИБ,
	             |	НастройкиОбработки.ПроводитьДокументы КАК ПроводитьДокументы
	             |ИЗ
	             |	НастройкиОбработки КАК НастройкиОбработки
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	НастройкиОбработки.ИспользуемаяИБ КАК ИспользуемаяИБ
	             |ИЗ
	             |	НастройкиОбработки КАК НастройкиОбработки
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	НастройкиОбработки.ОбъектБД КАК ОбъектБД
	             |ИЗ
	             |	НастройкиОбработки КАК НастройкиОбработки
	             |ГДЕ
	             |	НастройкиОбработки.ИспользуемаяИБ = ЗНАЧЕНИЕ(Справочник.ВнешниеИнформационныеБазы.ТекущаяИБ)";

	Результат=Запрос.ВыполнитьПакет();
	
	НастройкиОбработки=Результат[1].Выгрузить();
	ИспользуемыеИБ=Результат[2].Выгрузить();
	ОбъектыБД=Результат[3].Выгрузить(); 
	
	// Обработка документов текущей информационной базы по данным текущей
	
	НастройкиТекущаяИБ=НастройкиОбработки.Скопировать(Новый Структура("ИспользуемаяИБ",Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ));
	
	Для Каждого СтрокаОбъект ИЗ ОбъектыБД Цикл
		
		НастройкиОбработкиОбъект=НастройкиТекущаяИБ.Скопировать(Новый Структура("ОбъектБД",СтрокаОбъект.ОбъектБД));
		
		ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Обработка документов по правилам для текущей ИБ, документ %1'"),СтрокаОбъект.ОбъектБД);
		КлючЗадания=Новый УникальныйИдентификатор;
		
		ПараметрыЗадания=Новый Массив;
		ПараметрыЗадания.Добавить(НастройкиОбработкиОбъект);
		
		ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ОбработатьОбъектыПоПравилам",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
	
	КонецЦикла;
	
	// Импорт и экспорт документов по внешним информационным базам
	
	Для Каждого СтрокаИБ ИЗ ИспользуемыеИБ Цикл
		
		Если СтрокаИБ.ИспользуемаяИБ=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		НастройкиОбработкиИБ=НастройкиОбработки.Скопировать(Новый Структура("ИспользуемаяИБ",СтрокаИБ.ИспользуемаяИБ));
		
		ОписаниеЗадания=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Обработка документов по правилам, внешняя ИБ %1'"),СтрокаИБ.ИспользуемаяИБ);
		КлючЗадания=Новый УникальныйИдентификатор;
		
		ПараметрыЗадания=Новый Массив;
		ПараметрыЗадания.Добавить(НастройкиОбработкиИБ);
		
		ФоновыеЗадания.Выполнить("ОбменДаннымиНСИУХ.ОбработатьОбъектыПоПравилам",ПараметрыЗадания,КлючЗадания,ОписаниеЗадания);
		
	КонецЦикла;
	
КонецПроцедуры // СоздатьОбновитьДокументыПоПравилам() 


#КонецЕсли