
&НаСервере
Процедура ЗаполнитьТЧНаСервере()
		
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения необходимо заполнить Период!",,,, Истина) ;
	КонецЕсли;
	
	Если  НЕ ЗначениеЗаполнено(Объект.Организация) Тогда  
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения необходимо заполнить Организацию!",,,, Истина)
	КонецЕсли;

    Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	АмортизацияОСОбороты.ОсновноеСредство КАК ОсновноеСредство
		|ИЗ
		|	РегистрНакопления.АмортизацияОС.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Запись,
		|			Организация = &Организация
		|				И ОсновноеСредство.тн_ПрименяемИнвестиционныйНалоговыйВычет) КАК АмортизацияОСОбороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(АмортизацияОСОбороты.Регистратор) = ТИП(Документ.АмортизацияОС2_4)";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ОсновныеСредства = РезультатЗапроса.Выгрузить();
	Для Каждого СтрокаОС Из ОсновныеСредства Цикл
    // Ищем такое же значение в уже добавленных строках
	    НайденоДубль = Ложь;
	    Для Каждого СуществующаяСтрока Из Объект.ОсновныеСредства Цикл
	        Если СуществующаяСтрока.ОсновноеСредство = СтрокаОС.ОсновноеСредство Тогда
	            НайденоДубль = Истина;
	            Прервать;
	        КонецЕсли;
	    КонецЦикла;
	    
	    Если Не НайденоДубль Тогда
	        СтрокаТЧ = Объект.ОсновныеСредства.Добавить();
	        СтрокаТЧ.ОсновноеСредство = СтрокаОС.ОсновноеСредство;
	    КонецЕсли;
	КонецЦикла;	
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧ(Команда)
	ЗаполнитьТЧНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументКорректировкаРегистровНаСервере()
	 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КорректировкаРегистровтн_ЗаполнениеДвижений.Документ КАК Документ,
		|	КорректировкаРегистровтн_ЗаполнениеДвижений.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Корректировки
		|ИЗ
		|	Документ.КорректировкаРегистров.тн_ЗаполнениеДвижений КАК КорректировкаРегистровтн_ЗаполнениеДвижений
		|ГДЕ
		|	КорректировкаРегистровтн_ЗаполнениеДвижений.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ КорректировкаРегистровтн_ЗаполнениеДвижений.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	АмортизацияОС.ОсновноеСредство КАК ОсновноеСредство,
		|	АмортизацияОС.Организация КАК Организация,
		|	АмортизацияОС.АмортизацияВР КАК АмортизацияВР,
		|	АмортизацияОС.АмортизацияПР КАК АмортизацияПР,
		|	АмортизацияОС.Подразделение КАК Подразделение,
		|	АмортизацияОС.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
		|	АмортизацияОС.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	ПрочиеРасходы.СтатьяРасходов КАК СтатьяРасходов,
		|	ПрочиеРасходы.АналитикаРасходов КАК АналитикаРасходов,
		|	ПрочиеРасходы.ВременнаяРазница КАК ВременнаяРазница,
		|	ПрочиеРасходы.ПостояннаяРазница КАК ПостояннаяРазница,
		|	АмортизацияОС.Активность КАК Активность,
		|	АмортизацияОС.ВидДвижения КАК ВидДвижения,
		|	ПрочиеРасходы.ВидДвижения КАК ПрочиеРасходыВидДвижения,
		|	АмортизацияОС.НомерСтроки КАК НомерСтроки,
		|	АмортизацияОС.Регистратор КАК Регистратор,
		|	ЕСТЬNULL(ВТ_Корректировки.Ссылка, ЗНАЧЕНИЕ(Документ.КорректировкаРегистров.ПустаяСсылка)) КАК СсылкаКорректировки
		|ИЗ
		|	РегистрНакопления.АмортизацияОС КАК АмортизацияОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрочиеРасходы КАК ПрочиеРасходы
		|		ПО АмортизацияОС.ИдентификаторФинЗаписи = ПрочиеРасходы.ИдентификаторФинЗаписи
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Корректировки КАК ВТ_Корректировки
		|		ПО АмортизацияОС.Регистратор = ВТ_Корректировки.Документ
		|ГДЕ
		|	АмортизацияОС.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И АмортизацияОС.ОсновноеСредство В(&СписокОсновныхСредств)
		|	И ТИПЗНАЧЕНИЯ(АмортизацияОС.Регистратор) = ТИП(Документ.АмортизацияОС2_4)
		|	И АмортизацияОС.АмортизацияВР > 0
		|ИТОГИ
		|	МАКСИМУМ(СсылкаКорректировки)
		|ПО
		|	Регистратор";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.Дата)); 
	МассивОсновныхСредств = Новый Массив;
	Для Каждого СтрокаОС Из Объект.ОсновныеСредства Цикл    
		Если СтрокаОС.Пометка Тогда  
			МассивОсновныхСредств.Добавить(СтрокаОС.ОсновноеСредство);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("СписокОсновныхСредств", МассивОсновныхСредств);
	
	РезультатЗапроса = Запрос.Выполнить();	
	  
	Если НЕ РезультатЗапроса.Пустой() Тогда     
		ВыборкаПоРегистратору = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоРегистратору.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаПоРегистратору.СсылкаКорректировки) Тогда
				ОбщегоНазначения.СообщитьПользователю("По документу " + ВыборкаПоРегистратору.Регистратор + " уже создана " + ВыборкаПоРегистратору.СсылкаКорректировки, ВыборкаПоРегистратору.СсылкаКорректировки);
			Иначе
			 НачатьТранзакцию();				
				Попытка
					ДокументКорректировкаРегистров = Документы.КорректировкаРегистров.СоздатьДокумент(); 
					ДокументКорректировкаРегистров.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
					ДокументКорректировкаРегистров.Дата = КонецМесяца(Объект.Дата);
					ДокументКорректировкаРегистров.Ответственный = Пользователи.ТекущийПользователь();
					ДокументКорректировкаРегистров.Комментарий = "Создано автоматически из обработки ""Создание корректировок движения по ОС и ИНВ (тн)"" за " +  Формат(Объект.Дата, "ДФ='MMMM yyyy ''г.'''"); 
					СтрокаСРегистром = ДокументКорректировкаРегистров.ТаблицаРегистров.Добавить(); 
					СтрокаСРегистром.Имя = "АмортизацияОС";
					СтрокаСРегистром = ДокументКорректировкаРегистров.ТаблицаРегистров.Добавить(); 
					СтрокаСРегистром.Имя = "ПрочиеРасходы";
					ДокументКорректировкаРегистров.тн_ИспользоватьЗаполнениеДвижений = Истина;
					СтрокаЗаполнения = ДокументКорректировкаРегистров.тн_ЗаполнениеДвижений.Добавить();
					СтрокаЗаполнения.Документ = ВыборкаПоРегистратору.Регистратор;
					ДокументКорректировкаРегистров.Записать();
					
					СторнируемыйНаборЗаписейАмортизации = РегистрыНакопления.АмортизацияОС.СоздатьНаборЗаписей();
					СторнируемыйНаборЗаписейАмортизации.Отбор.Регистратор.Установить(ДокументКорректировкаРегистров.Ссылка);
					
					СторнируемыйНаборЗаписейПрочихРасходов = РегистрыНакопления.ПрочиеРасходы.СоздатьНаборЗаписей();
					СторнируемыйНаборЗаписейПрочихРасходов.Отбор.Регистратор.Установить(ДокументКорректировкаРегистров.Ссылка);
					ВыборкаДетальныеЗаписи = ВыборкаПоРегистратору.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						
						ДвижениеСторноАмортизации = СторнируемыйНаборЗаписейАмортизации.Добавить();
						ЗаполнитьЗначенияСвойств(ДвижениеСторноАмортизации, ВыборкаДетальныеЗаписи);
						ДвижениеСторноАмортизации.АмортизацияВР = - ВыборкаДетальныеЗаписи.АмортизацияВР;  
						ДвижениеСторноАмортизации.АмортизацияПР =   ВыборкаДетальныеЗаписи.АмортизацияВР;
						ДвижениеСторноАмортизации.Период        =   КонецМесяца(Объект.Дата);
						
						ДвижениеСторноПрочихРасходов = СторнируемыйНаборЗаписейПрочихРасходов.Добавить();
						ЗаполнитьЗначенияСвойств(ДвижениеСторноПрочихРасходов, ВыборкаДетальныеЗаписи);
						ДвижениеСторноПрочихРасходов.ВременнаяРазница  = - ВыборкаДетальныеЗаписи.ВременнаяРазница;  
						ДвижениеСторноПрочихРасходов.ПостояннаяРазница =   ВыборкаДетальныеЗаписи.ВременнаяРазница;
						ДвижениеСторноПрочихРасходов.Период            =   КонецМесяца(Объект.Дата);     
						ДвижениеСторноПрочихРасходов.ВидДвижения       =   ВыборкаДетальныеЗаписи.ПрочиеРасходыВидДвижения;
					КонецЦикла;
					
					СторнируемыйНаборЗаписейАмортизации.Записать();
					СторнируемыйНаборЗаписейПрочихРасходов.Записать();
					
					ОбщегоНазначения.СообщитьПользователю("Сформирован документ: " + ДокументКорректировкаРегистров, ДокументКорректировкаРегистров); 
					
					ЗафиксироватьТранзакцию();
					
				Исключение 
					
					ОтменитьТранзакцию();
					ТекстОшибки = "Документ " + ДокументКорректировкаРегистров +":" + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации("Обработка ""Создание корректировок движения по ОС и ИНВ (тн)""", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
					ОбщегоНазначения.СообщитьПользователю("Возникли ошибки при корректировке движения по ОС и ИНВ." + ТекстОшибки);
					
				КонецПопытки; 
							 
			КонецЕсли;  
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументКорректировкаРегистров(Команда)
	СоздатьДокументКорректировкаРегистровНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьОперацияНаСервере()    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОперацияБухЗаполнениеДвижений.Документ КАК Документ,
	|	ОперацияБухЗаполнениеДвижений.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Операции
	|ИЗ
	|	Документ.ОперацияБух.ЗаполнениеДвижений КАК ОперацияБухЗаполнениеДвижений
	|ГДЕ
	|	ОперацияБухЗаполнениеДвижений.Ссылка.Организация = &Организация
	|	И ОперацияБухЗаполнениеДвижений.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ОперацияБухЗаполнениеДвижений.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйДвиженияССубконто.Период КАК Период,
	|	ХозрасчетныйДвиженияССубконто.Регистратор КАК Регистратор,
	|	ХозрасчетныйДвиженияССубконто.НомерСтроки КАК НомерСтроки,
	|	ХозрасчетныйДвиженияССубконто.Активность КАК Активность,
	|	ХозрасчетныйДвиженияССубконто.СчетДт КАК СчетДт,
	|	ХозрасчетныйДвиженияССубконто.Организация КАК Организация,
	|	ХозрасчетныйДвиженияССубконто.ВалютаДт КАК ВалютаДт,
	|	ХозрасчетныйДвиженияССубконто.ВалютаКт КАК ВалютаКт,
	|	ХозрасчетныйДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	|	ХозрасчетныйДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	|	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	|	ХозрасчетныйДвиженияССубконто.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	|	ХозрасчетныйДвиженияССубконто.СуммаПРДт КАК СуммаПРДт,
	|	ХозрасчетныйДвиженияССубконто.СуммаПРКт КАК СуммаПРКт,
	|	ХозрасчетныйДвиженияССубконто.СуммаВРДт КАК СуммаВРДт,
	|	ХозрасчетныйДвиженияССубконто.СуммаВРКт КАК СуммаВРКт,
	|	ХозрасчетныйДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	|	ХозрасчетныйДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	|	ХозрасчетныйДвиженияССубконто.СчетКт КАК СчетКт,
	|	ХозрасчетныйДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	|	ХозрасчетныйДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	|	ХозрасчетныйДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	|	ХозрасчетныйДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	|	ХозрасчетныйДвиженияССубконто.Содержание КАК Содержание,
	|	ЕСТЬNULL(ВТ_Операции.Ссылка, ЗНАЧЕНИЕ(Документ.ОперацияБух.ПустаяСсылка)) КАК СсылкаОперации
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(, , , , ) КАК ХозрасчетныйДвиженияССубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Операции КАК ВТ_Операции
	|		ПО ХозрасчетныйДвиженияССубконто.Регистратор = ВТ_Операции.Документ
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ХозрасчетныйДвиженияССубконто.Регистратор) = ТИП(Документ.АмортизацияОС2_4)
	|	И ХозрасчетныйДвиженияССубконто.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ХозрасчетныйДвиженияССубконто.СубконтоКт1 В(&СписокОсновныхСредств)
	|ИТОГИ
	|	МАКСИМУМ(СсылкаОперации)
	|ПО
	|	Регистратор";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	МассивОсновныхСредств = Новый Массив;
	Для Каждого СтрокаОС Из Объект.ОсновныеСредства Цикл    
		Если СтрокаОС.Пометка Тогда  
			МассивОсновныхСредств.Добавить(СтрокаОС.ОсновноеСредство);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("СписокОсновныхСредств", МассивОсновныхСредств);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоРегистратору = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Пока ВыборкаПоРегистратору.Следующий() Цикл  
			Если ЗначениеЗаполнено(ВыборкаПоРегистратору.СсылкаОперации) Тогда
				ОбщегоНазначения.СообщитьПользователю("По документу " + ВыборкаПоРегистратору.Регистратор + " уже создана " + ВыборкаПоРегистратору.СсылкаОперации, ВыборкаПоРегистратору.СсылкаОперации);
			Иначе
				ОперацияОбъект = Документы.ОперацияБух.СоздатьДокумент();
				ОперацияОбъект.Дата = КонецМесяца(Объект.Дата);
				ОперацияОбъект.Организация = Объект.Организация;   
				ОперацияОбъект.Ответственный = Пользователи.ТекущийПользователь();
				ОперацияОбъект.Содержание = НСтр("ru = 'Корректировка документа'" + ВыборкаПоРегистратору.Регистратор);
				ОперацияОбъект.Комментарий = "Создано автоматически из обработки ""Создание корректировок движения по ОС и ИНВ (тн)"" за " +  Формат(Объект.Дата, "ДФ='MMMM yyyy ''г.'''");
				Попытка
					ОперацияОбъект.Записать();
					НоваяСтрока = ОперацияОбъект.ЗаполнениеДвижений.Добавить();
					НоваяСтрока.Документ = ВыборкаПоРегистратору.Регистратор; 
					
					ВыборкаДетальныеЗаписи = ВыборкаПоРегистратору.Выбрать();  
					СторнируемыйНаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
					СторнируемыйНаборЗаписей.Отбор.Регистратор.Установить(ОперацияОбъект.Ссылка);
					
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						ДвижениеСторно = СторнируемыйНаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(ДвижениеСторно, ВыборкаДетальныеЗаписи,,"Период,Регистратор");
						ДвижениеСторно.СуммаПРДт = ВыборкаДетальныеЗаписи.СуммаВРДт;
						ДвижениеСторно.СуммаПРКт = ВыборкаДетальныеЗаписи.СуммаВРКт;
						ДвижениеСторно.СуммаВРДт = - ВыборкаДетальныеЗаписи.СуммаВРДт;
						ДвижениеСторно.СуммаВРКт = - ВыборкаДетальныеЗаписи.СуммаВРКт;
						ДвижениеСторно.Период    =  КонецМесяца(Объект.Дата);
						ДвижениеСторно.Регистратор =  ОперацияОбъект.Ссылка; 
						
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетКт,  ДвижениеСторно.СубконтоКт,  1, ВыборкаДетальныеЗаписи.СубконтоКт1);
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетКт,  ДвижениеСторно.СубконтоКт,  2, ВыборкаДетальныеЗаписи.СубконтоКт2); 
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетКт,  ДвижениеСторно.СубконтоКт,  3, ВыборкаДетальныеЗаписи.СубконтоКт3); 
						
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетДт,  ДвижениеСторно.СубконтоДт,  1, ВыборкаДетальныеЗаписи.СубконтоДт1);
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетДт,  ДвижениеСторно.СубконтоДт,  2, ВыборкаДетальныеЗаписи.СубконтоДт2); 
						БухгалтерскийУчет.УстановитьСубконто(ДвижениеСторно.СчетДт,  ДвижениеСторно.СубконтоДт,  3, ВыборкаДетальныеЗаписи.СубконтоДт3); 					
					КонецЦикла;			
					СторнируемыйНаборЗаписей.Записать();			
					ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
					
					ОбщегоНазначения.СообщитьПользователю("Сформирован документ: " + ОперацияОбъект, ОперацияОбъект); 
				Исключение				
					
					ТекстОшибки = "Документ " + ОперацияОбъект +":" + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации("Обработка ""Создание корректировок движения по ОС и ИНВ (тн)""", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
					ОбщегоНазначения.СообщитьПользователю("Возникли ошибки при корректировке движения по ОС и ИНВ:" + ТекстОшибки);		
					ОтменитьТранзакцию();
				КонецПопытки; 
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОперация(Команда)
	СоздатьОперацияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметкиОбъектовЭксплуатации(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОтметкиОбъектовЭксплуатации(Ложь);
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции 

&НаКлиенте
Процедура УстановитьОтметкиОбъектовЭксплуатации(Отметка)
	Для каждого СтрокаОбъекты Из Объект.ОсновныеСредства Цикл
		СтрокаОбъекты.Пометка = Отметка;
	КонецЦикла; 	
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение", ЭтотОбъект);
	
	ПараметрыФормыВыбораПериода = Новый Структура("Значение, РежимВыбораПериода", Объект.Дата, "МЕСЯЦ");
	ОткрытьФорму("ОбщаяФорма.ВыборПериода",
		ПараметрыФормыВыбораПериода, 
		ЭтотОбъект, 
		УникальныйИдентификатор,,, 
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Модифицированность = Истина;
	
	ПериодРегистрации = НачалоМесяца(Объект.Дата);
	ОбщегоНазначенияУТКлиент.РегулированиеПредставленияПериодаРегистрации(Направление,
		СтандартнаяОбработка,
		ПериодРегистрации,
		ПредставлениеПериодаРегистрации);
		
	Объект.Дата = ПериодРегистрации;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры 

#КонецОбласти

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйПериод <> Неопределено Тогда
		Модифицированность = Истина;
		Объект.Дата = КонецМесяца(ВыбранныйПериод);
		ПредставлениеПериодаРегистрации = ОбщегоНазначенияУТКлиентСервер.ПолучитьПредставлениеПериодаРегистрации(Объект.Дата);
		Объект.ОсновныеСредства.Очистить();

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Объект.ОсновныеСредства.Очистить();
КонецПроцедуры