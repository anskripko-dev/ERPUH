
&НаКлиенте
Процедура ВыборФайлаНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выбор файла данных с кодами Статей расходов ЕРП УХ";
	ДиалогВыбораФайла.Фильтр = "Табличный документ (*.xls?,*.xlsx)|*.xls;*.xlsx";    
	
	ОповещениеВыбора = Новый ОписаниеОповещения("ОкончаниеВыбораФайла", ЭтотОбъект);
	
	ДиалогВыбораФайла.Показать(ОповещениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеНажатие(Элемент)
	
	ФайлДанных = Новый Файл(ВыборФайла);
	
	Если ФайлДанных.Существует() Тогда
		Попытка
			
			Excel = Новый COMОбъект("Excel.Application");
			Excel.WorkBooks.Open(ВыборФайла);
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Открытие файла Microsoft Excel...'"));

			SheetExcel = Excel.Sheets(1);
			КоличествоСтрок 	= SheetExcel.UsedRange.rows.count()-1;
			КоличествоКолонок 	= SheetExcel.UsedRange.columns.count();
			
		Исключение
			ТекстСообщения = НСтр("ru = 'В процессе открытия файла, произошла ошибка - %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки());
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

			Excel.Application.Quit();
			Возврат;
		КонецПопытки;		
		
		Попытка     
			ПериодРегистрации = Дата(СокрЛП(Excel.Cells(1, 1).Value));
			СтавкаНДС = СокрЛП(Excel.Cells(1, 2).Value);
			
			Данные = Новый Массив; // Для передачи на сервер, и обработки данных.
			
			//с 7 столбца по три - данные по одному оператору    
			Стб=7;                                                              
			Оператор = СокрЛП(Excel.Cells(3, Стб+1).Value);    
			Пока ЗначениеЗаполнено(Оператор) Цикл                   
				Строка = 6; // Данные начинаются с 6 строки.
				Пока Строка <= КоличествоСтрок Цикл
					УИНПодразделения =  СокрЛП(Excel.Cells(Строка, 3).Value);
					Если ЗначениеЗаполнено(УИНПодразделения) Тогда
						СтруктураДанных = Новый Структура;
						СтруктураДанных.Вставить("Подразделение", СокрЛП(Excel.Cells(Строка, 3).Value)); 
						
						СтруктураДанных.Вставить("Оператор", Оператор);
						СтруктураДанных.Вставить("Договор", СокрЛП(Excel.Cells(4, Стб+1).Value));    
						СтруктураДанных.Вставить("Удержано", Число(СокрЛП(Excel.Cells(Строка, Стб).Value)));
						СтруктураДанных.Вставить("Затраты", Число(СокрЛП(Excel.Cells(Строка, Стб+1).Value)));    
						СтруктураДанных.Вставить("НДСЗатрат", Число(СокрЛП(Excel.Cells(Строка, Стб+2).Value)));  
						Данные.Добавить(СтруктураДанных);	
					Иначе 
						ТекстСообщения = НСтр("ru = 'Не заполнен УИН подразделения в строке %1, документы по нему созданы не будут'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка(Строка));
						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения); 
					КонецЕсли;
					Строка = Строка + 1;
						
				КонецЦикла;    
				Стб = Стб+3;
				Оператор = СокрЛП(Excel.Cells(3, Стб+1).Value);
			КонецЦикла;
			
			Если Данные.Количество()=0 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось получить данные из файла. Проверьте правильность заполнения файла'"));
				Возврат;
			КонецЕсли;
			ЗагрузитьДанныеНаСервере(Данные, ПериодРегистрации, СтавкаНДС);
			
		Исключение
			ТекстСообщения = НСтр("ru = 'В процессе обработки файла, произошла ошибка - %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки());
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Excel.Application.Quit();
			Возврат;
		КонецПопытки;
		
		Excel.Application.Quit();

		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Обработка успешно завершена.'"));
		
	Иначе	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите файл!'"));
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(Данные, ПериодРегистрации, СтавкаНДС)
	
	ВсеОК = Истина;
	
	//проверка заполенности         
	Если Не ЗначениеЗаполнено(Объект.ОрганизацияДляЗагрузкиСверхлимитныхРазговоров) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнено значение ""Организация""'"));
		ВсеОк = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Статья5421) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнено значение ""Статья 5.4.2.1""'"));
		ВсеОк = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СтатьяПрочиеРасчетыСРаботниками) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнено значение ""Статья Прочие расчеты с работниками""'"));
		ВсеОк = Ложь;
	КонецЕсли;    
	
	Если Не ВсеОк Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТЗ = Новый ТаблицаЗначений;   
	ДанныеТЗ.Колонки.Добавить("ОблагаетсяНДС");
	ДанныеТЗ.Колонки.Добавить("Подразделение");
	ДанныеТЗ.Колонки.Добавить("Оператор");
	ДанныеТЗ.Колонки.Добавить("Договор");
	ДанныеТЗ.Колонки.Добавить("Удержано");
	ДанныеТЗ.Колонки.Добавить("Затраты");
	ДанныеТЗ.Колонки.Добавить("НДСЗатрат");
	
    Для Каждого Элемент Из Данные Цикл
		НовСтр = ДанныеТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Элемент);
		УИНПодразделения = Новый УникальныйИдентификатор(СокрЛП(Элемент.Подразделение));      
		ПодразделениеСсылка = Справочники.СтруктураПредприятия.ПолучитьСсылку(УИНПодразделения);   
		НовСтр.Подразделение = ПодразделениеСсылка;
		НовСтр.ОблагаетсяНДС = НЕ ПодразделениеСсылка.тн_ДеятельностьНеОблагаетсяНДС;
	КонецЦикла;
	
	НачатьТранзакцию();
	
	Попытка  
        ПараметрыПУиПА = Новый Структура("НалогообложениеНДС, СтрокиОператора, Комментарий");
		ПараметрыПУиПА.Вставить("ПериодРегистрации", ПериодРегистрации);
		ПараметрыПУиПА.Вставить("ОрганизацияДляЗагрузкиСверхлимитныхРазговоровЗУП", Объект.ОрганизацияДляЗагрузкиСверхлимитныхРазговоров);
		ПараметрыПУиПА.Вставить("СтатьяПрочиеРасчетыСРаботникамиЗУП", Объект.СтатьяПрочиеРасчетыСРаботниками);
		ПараметрыПУиПА.Вставить("СтавкаНДС", Справочники.СтавкиНДС.НайтиПоНаименованию(СтавкаНДС));
		ПараметрыПУиПА.Вставить("Статья5421ЗУП", Объект.Статья5421);
		ПараметрыПУиПА.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());    
		Операторы = ДанныеТЗ.Скопировать();
		Операторы.Свернуть("Оператор");		   
		Для Каждого Оператор Из Операторы Цикл
			//головная организация
			Отбор = Новый Структура("Оператор,ОблагаетсяНДС", Оператор.Оператор, Истина);
			СтрокиОператора = ДанныеТЗ.НайтиСтроки(Отбор);
			Если СтрокиОператора.Количество()>0 Тогда
				ПараметрыПУиПА.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				ПараметрыПУиПА.СтрокиОператора = СтрокиОператора;   
				ПараметрыПУиПА.Комментарий = "Мобильная связь за " + Формат(ПериодРегистрации, "ДФ=ММММ") + " месяц Основное подразделение";
				СтруктураРезультат = СоздатьПУПАиСФ(ПараметрыПУиПА); 
				Если СтруктураРезультат.Успешно Тогда
					Если ЗначениеЗаполнено(СтруктураРезультат.ПУиПА) ИЛИ  ЗначениеЗаполнено(СтруктураРезультат.СФ) Тогда            
						НовСтр = Объект.СозданныеДокументы.Добавить();
						НовСтр.ПУиПА = СтруктураРезультат.ПУиПА;
						НовСтр.СФ = СтруктураРезультат.СФ;
					КонецЕсли;
				ИначеЕсли ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
					Объект.СозданныеДокументы.Очистить();
					ОбщегоНазначения.СообщитьПользователю(СтруктураРезультат.ОписаниеОшибки);
					Возврат;        
				КонецЕсли;
			КонецЕсли;
			
			//филиал центр
			Отбор = Новый Структура("Оператор,ОблагаетсяНДС", Оператор.Оператор, Ложь);
			СтрокиОператора = ДанныеТЗ.НайтиСтроки(Отбор);     
			Если СтрокиОператора.Количество()>0 Тогда
				ПараметрыПУиПА.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
				ПараметрыПУиПА.СтрокиОператора = СтрокиОператора;
				ПараметрыПУиПА.Комментарий = "По необлагаемой деятельности, Филиал Центр";
				СтруктураРезультат = СоздатьПУПАиСФ(ПараметрыПУиПА); 
				Если СтруктураРезультат.Успешно Тогда
					Если ЗначениеЗаполнено(СтруктураРезультат.ПУиПА) ИЛИ  ЗначениеЗаполнено(СтруктураРезультат.СФ) Тогда            
						НовСтр = Объект.СозданныеДокументы.Добавить();
						НовСтр.ПУиПА = СтруктураРезультат.ПУиПА;
						НовСтр.СФ = СтруктураРезультат.СФ;
					КонецЕсли;
				ИначеЕсли ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
					Объект.СозданныеДокументы.Очистить();
					ОбщегоНазначения.СообщитьПользователю(СтруктураРезультат.ОписаниеОшибки);
					Возврат;        
				КонецЕсли;    
			КонецЕсли;
		КонецЦикла;
		
		Если СтруктураРезультат.Успешно Тогда	
			ЗафиксироватьТранзакцию();
		ИначеЕсли ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
			Объект.СозданныеДокументы.Очистить();
		КонецЕсли;
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
			Объект.СозданныеДокументы.Очистить();
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'В процессе записи данных, произошла ошибка (Транзакция отменена, данные не сохранены)- %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьПУПАиСФ(ПараметрыПУиПА)
	
	//НАЧАЛО: Гимадиев Марат 17.02.2023 Выполнение задач №000044438 
	// Блок перенесен "как есть" выше, а ниже закомментирован (сначала выполнеем провеку)
	
	СтруктураРезультат = Новый Структура("Успешно, ОписаниеОшибки, ПУиПА, СФ", Истина, "", "");
	Договор = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Номер", СокрЛП(ПараметрыПУиПА.СтрокиОператора[0].Договор));
	//Договор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(СокрЛП(ПараметрыПУиПА.СтрокиОператора[0].Договор), Истина);
	Если Не ЗначениеЗаполнено(Договор) Тогда
		СтруктураРезультат.Успешно = Ложь;
		ТекстСообщения = НСтр("ru = 'В процессе записи данных, произошла ошибка (Транзакция отменена, данные не сохранены)- Не найден Договор %1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПараметрыПУиПА.СтрокиОператора[0].Договор);
		СтруктураРезультат.ОписаниеОшибки = ТекстСообщения;
		Возврат СтруктураРезультат;
	КонецЕсли;          
	//КОНЕЦ: Гимадиев Марат 17.02.2023 Выполнение задач №000044438
	
	//проверить уже созданные
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриобретениеУслугПрочихАктивов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
		|ГДЕ
		|	НЕ ПриобретениеУслугПрочихАктивов.ПометкаУдаления
		|	И ПриобретениеУслугПрочихАктивов.Дата = &Дата 
		//НАЧАЛО: Гимадиев Марат 17.02.2023 Выполнение задач №000044438 
		|	И ПриобретениеУслугПрочихАктивов.Договор = &Договор 
		//КОНЕЦ: Гимадиев Марат 17.02.2023 Выполнение задач №000044438
		|	И ПриобретениеУслугПрочихАктивов.Комментарий ПОДОБНО &Комментарий";
	
	Запрос.УстановитьПараметр("Дата", ПараметрыПУиПА.ПериодРегистрации);
	Запрос.УстановитьПараметр("Комментарий", ПараметрыПУиПА.Комментарий);
	//НАЧАЛО: Гимадиев Марат 17.02.2023 Выполнение задач №000044438 
	Запрос.УстановитьПараметр("Договор", Договор);
	//КОНЕЦ: Гимадиев Марат 17.02.2023 Выполнение задач №000044438
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = Истина;
		ДокОбъект.Проведен = Ложь;
		ДокОбъект.Записать();
	КонецЦикла;
	
	//НАЧАЛО: Гимадиев Марат 17.02.2023 Выполнение задач №000044438    
	// Блок перенесен выше, т.к проверку необходимо выполнить в первую очередь
	
	//СтруктураРезультат = Новый Структура("Успешно, ОписаниеОшибки, ПУиПА, СФ", Истина, "", "");
	//Договор = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Номер", СокрЛП(ПараметрыПУиПА.СтрокиОператора[0].Договор));
	////Договор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(СокрЛП(ПараметрыПУиПА.СтрокиОператора[0].Договор), Истина);
	//Если Не ЗначениеЗаполнено(Договор) Тогда
	//	СтруктураРезультат.Успешно = Ложь;
	//	ТекстСообщения = НСтр("ru = 'В процессе записи данных, произошла ошибка (Транзакция отменена, данные не сохранены)- Не найден Договор %1'");
	//	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПараметрыПУиПА.СтрокиОператора[0].Договор);
	//	СтруктураРезультат.ОписаниеОшибки = ТекстСообщения;
	//	Возврат СтруктураРезультат;
	//КонецЕсли;          
	//КОНЕЦ: Гимадиев Марат 17.02.2023 Выполнение задач №000044438
	
	ДокументПУ = Документы.ПриобретениеУслугПрочихАктивов.СоздатьДокумент();
	ДокументПУ.Дата = ПараметрыПУиПА.ПериодРегистрации;
	ДокументПУ.Организация = ПараметрыПУиПА.ОрганизацияДляЗагрузкиСверхлимитныхРазговоровЗУП;
	ДокументПУ.Договор = Договор;   
	КонтрагентДоговора = Договор.Контрагент;
	ДокументПУ.Контрагент = КонтрагентДоговора;
	ДокументПУ.Партнер = КонтрагентДоговора.Партнер;    
	ДокументПУ.ЦенаВключаетНДС = Истина;
	ДокументПУ.НалогообложениеНДС = ПараметрыПУиПА.НалогообложениеНДС;
	ДокументПУ.ЗакупкаПодДеятельность = ПараметрыПУиПА.НалогообложениеНДС;
	ДокументПУ.Валюта = ПараметрыПУиПА.Валюта;
	ДокументПУ.ВалютаВзаиморасчетов = ПараметрыПУиПА.Валюта;
	ДокументПУ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ДокументПУ.НаименованиеВходящегоДокумента = "Акт";  
	ДокументПУ.Комментарий = ПараметрыПУиПА.Комментарий;
	
	Для Каждого Строка Из ПараметрыПУиПА.СтрокиОператора Цикл   
		Сотрудники = Строка.Подразделение.тн_ФизическоеЛицо;	
		ДанныеНастройки = НастройкаСчетовУчетаКлиентСервер.СоставНастройкиСчетовУчета();
		ДанныеНастройки.СчетУчета = ПланыСчетов.Хозрасчетный.РасчетыПоПрочимОперациям;
		ДанныеНастройки.Субконто1 = Сотрудники;
		НастройкаСчетаУчета = НастройкаСчетовУчетаСервер.НоваяНастройкаСчетовУчета(ДанныеНастройки);
		Если Строка.Удержано>0 Тогда
			НовСтр = ДокументПУ.Расходы.Добавить();
			НовСтр.Содержание = "Удержания связь";
			НовСтр.Количество = 1;
			НовСтр.Цена = Строка.Удержано;
			НовСтр.Сумма = Строка.Удержано;   
			НовСтр.СуммаВзаиморасчетов = Строка.Удержано;
			НовСтр.СуммаСНДС = Строка.Удержано;
			НовСтр.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
			НовСтр.АналитикаРасходов = Сотрудники;
			НовСтр.Подразделение = Справочники.СтруктураПредприятия.тн_ОтражатьТолькоВРегламентированномУчете;
			НовСтр.СтатьяРасходов = ПараметрыПУиПА.СтатьяПрочиеРасчетыСРаботникамиЗУП;
			НовСтр.НастройкаСчетовУчета = НастройкаСчетаУчета.Ссылка;
			НовСтр.АналитикаАктивовПассивов = Сотрудники;      
			Если Не ОбщегоНазначения.СсылкаСуществует(Строка.Подразделение) Тогда
				СтруктураРезультат.Успешно = Ложь;
				ТекстСообщения = НСтр("ru = 'По строке %1 не нашлось Подразделение'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НовСтр.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				СтруктураРезультат.ОписаниеОшибки = ТекстСообщения;
				Возврат СтруктураРезультат;
			КонецЕсли;
		КонецЕсли;
		
		Если Строка.Затраты>0 Тогда
			НовСтрЗатраты = ДокументПУ.Расходы.Добавить();
			НовСтрЗатраты.Содержание = "Услуги сторонних организаций 26";
			НовСтрЗатраты.Количество = 1;
			НовСтрЗатраты.Цена = Строка.Затраты;
			НовСтрЗатраты.Сумма = Строка.Затраты;
			НовСтрЗатраты.СуммаВзаиморасчетов = Строка.Затраты;
			НовСтрЗатраты.СуммаСНДС = Строка.Затраты;
			НовСтрЗатраты.СуммаНДС = Строка.НДСЗатрат;   
			НовСтрЗатраты.СуммаНДСВзаиморасчетов = Строка.НДСЗатрат;
			НовСтрЗатраты.СтавкаНДС = ПараметрыПУиПА.СтавкаНДС;       
			
			НовСтрЗатраты.АналитикаРасходов = Строка.Подразделение;
			НовСтрЗатраты.Подразделение = Строка.Подразделение.Родитель;
			НовСтрЗатраты.СтатьяРасходов = ПараметрыПУиПА.Статья5421ЗУП;
			Если Не ОбщегоНазначения.СсылкаСуществует(Строка.Подразделение) Тогда
				СтруктураРезультат.Успешно = Ложь;
				ТекстСообщения = НСтр("ru = 'По строке %1 не нашлось Подразделение'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НовСтрЗатраты.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				СтруктураРезультат.ОписаниеОшибки = ТекстСообщения;
				Возврат СтруктураРезультат;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ДокументПУ.Расходы.Количество()>0 Тогда
		
		ДокументПУ.Записать(); 
		
		СтруктураРезультат.ПУиПА = ДокументПУ.Ссылка;
		
		//Создание СФ
		СтруктураЗаполненияСФ = Новый Структура;
		СтруктураЗаполненияСФ.Вставить("ДокументОснование", ДокументПУ.Ссылка);
		СтруктураЗаполненияСФ.Вставить("Корректировочный", Ложь);
		
		НовыйДокументСчетФактураПолученный = Документы.СчетФактураПолученный.СоздатьДокумент();
		НовыйДокументСчетФактураПолученный.Заполнить(СтруктураЗаполненияСФ);
		НовыйДокументСчетФактураПолученный.ПолученВЭлектронномВиде = Ложь;
		НовыйДокументСчетФактураПолученный.Дата = ДокументПУ.Дата;
		НовыйДокументСчетФактураПолученный.ДатаЗаписиКнигиПродаж = НовыйДокументСчетФактураПолученный.Дата;
		НовыйДокументСчетФактураПолученный.ДатаСоставления = НовыйДокументСчетФактураПолученный.Дата;
		НовыйДокументСчетФактураПолученный.Корректировочный = Ложь;					
		//Запись СФ в транзакции 
		НовыйДокументСчетФактураПолученный.Записать(РежимЗаписиДокумента.Запись); 
		СтруктураРезультат.СФ = НовыйДокументСчетФактураПолученный.Ссылка;
		
	КонецЕсли;
			
	Возврат СтруктураРезультат;
	
КонецФункции

&НаКлиенте
Процедура ОкончаниеВыбораФайла(ВыбранныеФайлы, Параметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено Тогда
		ВыборФайла = ВыбранныеФайлы[0];	
	КонецЕсли;

КонецПроцедуры