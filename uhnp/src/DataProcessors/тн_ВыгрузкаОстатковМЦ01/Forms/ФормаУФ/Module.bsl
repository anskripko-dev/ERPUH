 
&НаСервере
Процедура ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	
	ТаблицаПроводок = Новый ТаблицаЗначений;
	
	МассивДокументов 	= Новый Массив;
	ДокОбъект 			= Неопределено;
	ОрганизацияПред 	= Неопределено;	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата 		= ТекущаяДата();  
	ТекущаяДата 		= ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	
	Если ТаблицаЗначений.Количество() = 0 Тогда
		УдалитьФайлы(ВремИмяФайла);
		ОбщегоНазначения.СообщитьПользователю("Таблица данных пустая.");
		ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + МассивДокументов.Количество());
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = Число(?(ПустаяСтрока(Стр.КоличествоОстаток), 0, СтрЗаменить(Стр.КоличествоОстаток, " ", "")));
		Сумма = Число(?(ПустаяСтрока(Стр.СуммаОстаток), 0, СтрЗаменить(Стр.СуммаОстаток, " ", "")));
		
		Если Количество <= 0 Тогда
			Продолжить;	
		КонецЕсли; 
		
		СчетЗабалансовогоУчетаКод = СокрЛП(Стр.СчетКод); 
		Если ПустаяСтрока(СчетЗабалансовогоУчетаКод) Тогда
			Продолжить;	
		КонецЕсли; 
		
		СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СчетЗабалансовогоУчетаКод);
		Если Не ЗначениеЗаполнено(СчетЗабалансовогоУчета) Тогда
			ОбщегоНазначения.СообщитьПользователю("Забалансовый счет учета не определен: " + СчетЗабалансовогоУчетаКод);
			Продолжить;
		КонецЕсли;

		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.Организация));
		
		Если Организация <> ОрганизацияПред Тогда
			
			Если ДокОбъект <> Неопределено Тогда
				ДокОбъект.Движения.Хозрасчетный.Загрузить(ТаблицаПроводок);
			КонецЕсли;
			
			ДокОбъект 				= Документы.ОперацияБух.СоздатьДокумент();
			ДокОбъект.Дата 			= ДатаДокументов;
			ДокОбъект.Организация 	= Организация;
			ДокОбъект.Содержание 	= "МЦ01 – перенос остатков ОС на забаланс";
			ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
			ДокОбъект.Комментарий 	= "#Загружено обработкой ВыгрузкаОстатковМЦ01";
						
			МассивДокументов.Добавить(ДокОбъект); 
			
			ТаблицаПроводок = ДокОбъект.Движения.Хозрасчетный.Выгрузить();
		КонецЕсли;
					
		НовСтр 					= ТаблицаПроводок.Добавить();
		НовСтр.Активность 		= Истина;
		НовСтр.Период			= ДатаДокументов;
		НовСтр.Организация 		= Организация;		
		НовСтр.СчетДт 			= СчетЗабалансовогоУчета;
		НовСтр.ВидСубконтоДт1 	= ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ОсновныеСредства;
		НовСтр.СубконтоДт1 		= Справочники.ОбъектыЭксплуатации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.Субконто1));
		НовСтр.Сумма            = Сумма;
		НовСтр.КоличествоДт     = Количество; 
		НовСтр.Содержание 		= "МЦ01 – перенос остатков ОС на забаланс";
			
		ОрганизацияПред = Организация;
	КонецЦикла;
	
	Если ДокОбъект = Неопределено Тогда
		УдалитьФайлы(ВремИмяФайла);
		ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + МассивДокументов.Количество());
		Возврат;
	КонецЕсли;
	
	// Последний документ
	ДокОбъект.Движения.Хозрасчетный.Загрузить(ТаблицаПроводок);
	
	Для Каждого ДокОбъект Из МассивДокументов Цикл
		ДокОбъект.Движения.Хозрасчетный.Записывать = Истина;
		ДокОбъект.СуммаОперации = ДокОбъект.Движения.Хозрасчетный.Итог("Сумма");
		
		Попытка		
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ДокСсылка = ДокОбъект.Ссылка;
			ОбщегоНазначения.СообщитьПользователю(ДокСсылка, ДокСсылка);
		Исключение 		
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа по организации " + ДокОбъект.Организация + 
				" по причине " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
		
	УдалитьФайлы(ВремИмяФайла);	
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + МассивДокументов.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры
