
#Область ОбработкаОсновныхСобытийФормы


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗакрыватьПриВыборе = Ложь;
	ПараметрОрганизация = Параметры.ОрганизацияДляЗаключенияДоговора;
	ОтборОрганизации.Очистить();
	Если ЗначениеЗаполнено(ПараметрОрганизация) Тогда
		ОтборОрганизации.Добавить(ПараметрОрганизация);
	Иначе
		// Оставляем список пустым.                 
	КонецЕсли;   
	
	Параметры.Свойство("МестоПоставки", МестоПоставки);
	Параметры.Свойство("ФиксироватьМестоПоставки", ФиксироватьМестоПоставки);
	Параметры.Свойство("Валюта", Валюта);
	Параметры.Свойство("ЦФОПотребитель", ЦФОПотребитель);
	Параметры.Свойство("ФункциональноеНаправление", ФункциональноеНаправление);
	Параметры.Свойство("ЭтапПланирования", ЭтапПланирования);
	Если Параметры.Свойство("ДокументПланирования") Тогда 	
		Параметры.Свойство("ДокументПланирования", ДокументПланирования);
	КонецЕсли;      
	Если Параметры.Свойство("ДокументОтбора") Тогда 	
		Параметры.Свойство("ДокументОтбора", ДокументОтбора);
	КонецЕсли;  	
	Если Параметры.Свойство("ТипДокументаОтбора") Тогда  
		ТипДокументаОтбора = "ДокументСсылка."+Строка(Параметры.ТипДокументаОтбора);
		Массив = Новый Массив(); 
		Массив.Добавить(Тип(ТипДокументаОтбора)); 
		Описание = Новый ОписаниеТипов(Массив);  
		Элементы.ДокументПланирования.ОграничениеТипа = Описание; 
		ДокументПланирования = Описание.ПривестиЗначение(ДокументПланирования); 
	КонецЕсли;
	Если Параметры.Свойство("ТекущаяНоменклатура") Тогда
		Номенклатуры = ПолучитьИзВременногоХранилища(Параметры.ТекущаяНоменклатура);
		Для Каждого СтрокаПотребностей ИЗ Номенклатуры Цикл
                
			НоваяСтрока = ВыбранныеПотребностиВНоменклатуре.Добавить();	    
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаПотребностей);    
			Если Номенклатуры.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
				НоваяСтрока.Сумма = СтрокаПотребностей.СуммаСНДС;
			КонецЕсли;	    
			Если Номенклатуры.Колонки.Найти("Номенклатура") <> Неопределено
				И Номенклатуры.Колонки.Найти("НоменклатураИсходная") <> Неопределено 
				И НЕ ЗначениеЗаполнено(СтрокаПотребностей.Номенклатура)
				И ЗначениеЗаполнено(СтрокаПотребностей.НоменклатураИсходная) Тогда
				НоваяСтрока.Номенклатура = СтрокаПотребностей.НоменклатураИсходная;
				СтрокаПотребностей.Номенклатура = СтрокаПотребностей.НоменклатураИсходная;
			КонецЕсли;	
			
			НоваяСтрока.ПериодПотребности = СтрокаПотребностей.ДатаПоставки;
			НоваяСтрока.КоличествоОстаток = СтрокаПотребностей.Количество;
            НоваяСтрока.ЦФО = СтрокаПотребностей.АналитикаПланирования.АналитикаСтруктуры.ЦФО;
            НоваяСтрока.Организация = СтрокаПотребностей.АналитикаПланирования.АналитикаСтруктуры.Организация;
            НоваяСтрока.ДокументПланирования = СтрокаПотребностей.АналитикаПланирования.ОбъектПланирования.Объект;
			НоваяСтрока.СтавкаНДС = СтрокаПотребностей.АналитикаПланирования.АналитикаПоставки.СтавкаНДС;
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СтавкаНДС) Тогда
				НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНоменклатуры(НоваяСтрока.Номенклатура);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	ВыбранныеПотребностиВНоменклатуреИзначальные.Загрузить(ВыбранныеПотребностиВНоменклатуре.Выгрузить());
	Если ЗначениеЗаполнено(ДокументПланирования) Тогда
		Элементы.ДокументПланирования.ТолькоПросмотр = Истина;
	КонецЕсли;	
	ОтборТоварнаяКатегория = Параметры.ТоварнаяКатегория;
	ДатаСреза = Параметры.ДатаСреза;
	Если ДатаСреза = '00010101' Тогда
		ДатаСреза = ТекущаяДатаСеанса();
	КонецЕсли;                            
  
	ЗначениеВДанныеФормы(
		Обработки.ВыборПериодаЗакупок.СоздатьВыборПериодаДиапазоном(
			 НачалоГода(ДатаСреза),
			КонецГода(ДатаСреза),
		Ложь),
		ВыборПериодаЗакупок);	
	УстановитьРеквизитыФормыПоОрганизации();
	ОбновитьВыборПериодаЗакупкиИзПараметров(Параметры);
	РеквизитПериодаЗакупокПриИзмененииНаСервере(Элементы.Инновационный.Имя);
	ПриИзмененииОтбораНаСервере();
	ИнициализироватьОформлениеФормы(); 
	Элементы.ДокументПланирования.Доступность = НЕ ЗначениеЗаполнено(ДокументПланирования);  
	
	Если Параметры.Свойство("НастройкаЭлементов") Тогда
		Для Каждого ЭлементНастройки Из Параметры.НастройкаЭлементов Цикл  
			ЭлементФормы = Элементы.Найти(ЭлементНастройки.Ключ);
			Если ЭлементФормы <> Неопределено Тогда       
				Для Каждого ПараметрНастройки Из ЭлементНастройки.Значение Цикл
					ЭлементФормы[ПараметрНастройки.Ключ] = ПараметрНастройки.Значение;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ФормаВладелец = ОбщегоНазначенияКлиентСерверУХ.ПолучитьФормуПоЭлементу(
		ЭтаФорма.ВладелецФормы);
	Если ИмяСобытия = "ЗакрытьПодчиненнуюФорму"
			И Параметр = "ПодборПотребностейИзПлана"
			И Источник = ФормаВладелец Тогда
		Закрыть();       
	ИначеЕсли ИмяСобытия = "ИзменитьПериодЗавершение" Тогда
		ПриИзмененииОтбораНаСервере();	
	КонецЕсли;
КонецПроцедуры


#КонецОбласти


#Область ОбработкаСобытийЭлементовФормы


&НаКлиенте
Процедура ВыбранныеПотребностиВНоменклатуреКоличествоПриИзменении(Элемент)
	ТекДанные = Элементы.ВыбранныеПотребностиВНоменклатуре.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекДанные.Количество > ТекДанные.КоличествоОстаток Тогда
		ТекДанные.Количество = ТекДанные.КоличествоОстаток;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСОжиданиемЗакрытия(Команда)
	ПроверкаЦен = ПроверкаОдинаковыхЦен();
	Если ПроверкаЦен = Истина Тогда
		АдресТаблицы = ПолучитьАдресТаблицыСВыбраннымиСтрокамиНаСервере(ЭтаФорма.УникальныйИдентификатор);
		ОповеститьОВыборе(АдресТаблицы);
		Если ЭтаФорма.Открыта() Тогда
			ЭтаФорма.Закрыть();
		Иначе     
			// Форма уже закрыта.
		КонецЕсли;                
	Иначе      
		ТекстВопроса = ТекстВопросаПоЦенам(ПроверкаЦен); 
		Оповещение = Новый ОписаниеОповещения(
				"ВозвратРазныхЦенПоНоменклатуре", ЭтаФорма);
		ПоказатьВопрос(Оповещение,
			ТекстВопроса,
			РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ТекстВопросаПоЦенам(ПроверкаЦен)
	
	ПроверкаЦенТаблица = ПолучитьИзВременногоХранилища(ПроверкаЦен);
	ТекстВопроса = "Указаны разные цены по одинаковым номенклатурам: ";
	Для Каждого Строка ИЗ ПроверкаЦенТаблица Цикл
		ТекстВопроса = ТекстВопроса+Символы.ПС+" -"+ Строка(Строка.Номенклатура)+ ", по ЦФО -" + Строка(Строка.ЦФО);
	КонецЦикла;
	ТекстВопроса = ТекстВопроса +Символы.ПС+"Продолжить?"; 
	Возврат ТекстВопроса;
КонецФункции

&НаКлиенте
Процедура ВозвратРазныхЦенПоНоменклатуре(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АдресТаблицы = ПолучитьАдресТаблицыСВыбраннымиСтрокамиНаСервере(ЭтаФорма.УникальныйИдентификатор);
		ОповеститьОВыборе(АдресТаблицы);
		Если ЭтаФорма.Открыта() Тогда
			ЭтаФорма.Закрыть();
		Иначе     
			// Форма уже закрыта.
		КонецЕсли;                
	КонецЕсли;
КонецПроцедуры
			
&НаСервере
Функция ПроверкаОдинаковыхЦен()
	
	ТаблицаЦен = Новый ТаблицаЗначений();
	ТаблицаЦен.Колонки.Добавить("Номенклатура");
	ТаблицаЦен.Колонки.Добавить("ЦФО");  
	Для Каждого Строка ИЗ ВыбранныеПотребностиВНоменклатуре Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("АналитикаПланирования",Строка.АналитикаПланирования);
		СтруктураОтбора.Вставить("АналитикаИсточника",Строка.АналитикаИсточника);
		СтруктураОтбораЦен = Новый Структура;
		СтруктураОтбораЦен.Вставить("АналитикаПланирования",Строка.АналитикаПланирования);
		СтруктураОтбораЦен.Вставить("АналитикаИсточника",Строка.АналитикаИсточника);
		СтруктураОтбораЦен.Вставить("Цена",Строка.Цена);
		Если ВыбранныеПотребностиВНоменклатуре.НайтиСтроки(СтруктураОтбора).Количество() <>	 ВыбранныеПотребностиВНоменклатуре.НайтиСтроки(СтруктураОтбораЦен).Количество()
		     Тогда
			 СтрокаНоменклатур = ТаблицаЦен.Добавить();
			 ЗаполнитьЗначенияСвойств(СтрокаНоменклатур,Строка);
		КонецЕсли;
	КонецЦикла;	       
	ТаблицаЦен.Свернуть("Номенклатура,ЦФО");
	Если ТаблицаЦен.Количество() > 0 Тогда
		АдресТаблицы = ПоместитьВоВременноеХранилище(
		ТаблицаЦен, 
		ЭтаФорма.УникальныйИдентификатор);
		Возврат АдресТаблицы;
	КонецЕсли;	
    Возврат Истина;
КонецФункции

