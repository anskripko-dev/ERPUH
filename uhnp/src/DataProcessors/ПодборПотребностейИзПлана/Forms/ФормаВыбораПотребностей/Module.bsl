&НаКлиенте
Процедура ВыбранныеПотребностиВНоменклатуреПриИзменении(Элемент)
	ПриИзмененииОтбораНаСервере();
	УстановитьОформлениеФормы();   
	КолСтрок = ВыбранныеПотребностиВНоменклатуре.Количество()-1;
	Пока КолСтрок >= 0 Цикл
		Если ВыбранныеПотребностиВНоменклатуре[КолСтрок].Сумма <= 0 Тогда
			ВыбранныеПотребностиВНоменклатуре.Удалить(КолСтрок);
		КонецЕсли;
		КолСтрок = КолСтрок - 1;
	КонецЦикла;	   
	Элементы.СписокПотребностейСумма.ТекстПодвала =  Формат(СписокПотребностей.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	Элементы.СписокПотребностейКоличество.ТекстПодвала = Формат(СписокПотребностей.Итог("Количество"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреКоличествоОстаток.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("КоличествоОстаток"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреСумма.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПотребностиВНоменклатуреКоличествоОстатокПриИзменении(Элемент)

	ТекДанные = Элементы.ВыбранныеПотребностиВНоменклатуре.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекДанные.КоличествоОстаток > ТекДанные.Количество Тогда
		ТекДанные.КоличествоОстаток = ТекДанные.Количество; 
	КонецЕсли;  
	Если ТипЗНЧ(ТекДанные.Номенклатура) = ТИП("СправочникСсылка.Номенклатура") Тогда
		ТекДанные.Сумма = ТекДанные.КоличествоОстаток*ТекДанные.Цена*ТекДанные.Коэффициент;  
	КонецЕсли;
	ПриИзмененииОтбораНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПотребностиВНоменклатуреСуммаПриИзменении(Элемент)
	ТекДанные = Элементы.ВыбранныеПотребностиВНоменклатуре.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗНЧ(ТекДанные.Номенклатура) = ТИП("СправочникСсылка.Номенклатура") Тогда
		ТекДанные.Сумма = ТекДанные.КоличествоОстаток*ТекДанные.Цена*ТекДанные.Коэффициент;	 	
	КонецЕсли;
	Если (ТипЗНЧ(ТекДанные.Номенклатура) = ТИП("СправочникСсылка.ТоварныеКатегории") 
		ИЛИ ТипЗНЧ(ТекДанные.Номенклатура) = ТИП("СправочникСсылка.КатегорииЗакупок")) 
		И ТекДанные.Сумма > ТекДанные.СуммаОбщая Тогда
		ТекДанные.Сумма = ТекДанные.СуммаОбщая;	 	
    КонецЕсли;
	ПриИзмененииОтбораНаСервере();
КонецПроцедуры

