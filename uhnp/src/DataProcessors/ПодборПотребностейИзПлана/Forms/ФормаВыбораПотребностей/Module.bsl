&НаСервере
Функция ПолучитьАдресТаблицыСВыбраннымиСтрокамиНаСервере(УИДВладельца)
	ТаблицаПотребностей = ПодготовитьТаблицуПотребностей();
	АдресТаблицы = ПоместитьВоВременноеХранилище(
		ТаблицаПотребностей, 
		УИДВладельца);
	Возврат АдресТаблицы;
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуПотребностей()
	ТаблицаПотребностей = РеквизитФормыВЗначение(
			"ВыбранныеПотребностиВНоменклатуре");   
	
	ТаблицаПотребностей.Колонки.Добавить("НоменклатураПоставщика",Новый ОписаниеТипов("СправочникСсылка.НоменклатураКонтрагентов"));
	Для Каждого СтрокаТаблицы Из ТаблицаПотребностей Цикл  
//		СтрокаТаблицы.НоменклатураПоставщика = СтрокаТаблицы.
		Если СтрокаТаблицы.Количество = 0 Тогда
			СтрокаТаблицы.Цена = 0;
		Иначе
			Цена = СтрокаТаблицы.Сумма / 
				?(СтрокаТаблицы.КоличествоОстаток = 0,
					1, 
					СтрокаТаблицы.КоличествоОстаток);
			СтрокаТаблицы.Сумма = Окр(Цена * СтрокаТаблицы.КоличествоОстаток, 2);
		КонецЕсли; 
		СтрокаТаблицы.Количество = СтрокаТаблицы.КоличествоОстаток;  
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) И 
			ТипЗнч(СтрокаТаблицы.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			СтрокаТаблицы.СтавкаНДС = СтрокаТаблицы.Номенклатура.СтавкаНДС;  
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) И 
			ТипЗнч(СтрокаТаблицы.Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории") 
			ИЛИ ТипЗнч(СтрокаТаблицы.Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда
			СтрокаТаблицы.СтавкаНДС = СтрокаТаблицы.Номенклатура.СтавкаНДС;
		КонецЕсли;	
	    СтрокаТаблицы.НоменклатураПоставщика = СтрокаТаблицы.АналитикаПланирования.АналитикаПоставки.НоменклатураПоставщика;
	КонецЦикла;   
	ТаблицаПотребностей.Сортировать("Номенклатура,МестоПоставки,Организация,ЦФО");
	
	Возврат ТаблицаПотребностей;
КонецФункции

