&НаКлиенте
Процедура ВыборТоварнойКатегории_Завершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ОтборТоварнаяКатегория = Результат.Значение;
		ТоварнаяКатегорияПриИзмененииНаСервере();
    Иначе
		// Пользователь отказался.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборТоварнаяКатегорияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если флРазделятьНоменклатуруПоКатегорийнымМенеджерам Тогда
		СтандартнаяОбработка = Ложь;
		ТекПользователь = ПользователиКлиент.ТекущийПользователь();
		МассивКатегорий = ПолучитьМассивКатегорий(ТекПользователь, ОтборОрганизации);
		Если МассивКатегорий.Количество() > 0 Тогда
			СписокВыбора = Новый СписокЗначений;
			СписокВыбора.ЗагрузитьЗначения(МассивКатегорий);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборТоварнойКатегории_Завершение", ЭтаФорма);
			СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения);
		Иначе
			ТекстСообщения = НСтр("ru = 'Нет доступных категорий закупок по оргазации ""%Организация%"" для текущего пользователя. Уточните матрицу категорийных менеджеров.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Строка(ОтборОрганизации));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;                  
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборТоварнаяКатегорияНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыНаКлиенте

&НаСервере
Функция ПолучитьСтавкуНоменклатуры(Номенклатура)

	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		СтавкаНДС = Номенклатура.СтавкаНДС;  
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ТоварныеКатегории") ИЛИ ТипЗнч(Номенклатура) = Тип("СправочникСсылка.КатегорииЗакупок") Тогда
		СтавкаНДС = Номенклатура.СтавкаНДС;
	КонецЕсли;	
	Возврат СтавкаНДС;	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуПотребностейВыбраннымиСтроками()
	
	Для Каждого Ключ ИЗ Элементы.СписокПотребностей.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.СписокПотребностей.ДанныеСтроки(Ключ);
		Поиск = Новый Структура(
		ЦентрализованныеЗакупкиКлиентСерверУХ.ИменаКлючевыхПолейПотребности()+",ЦФО,Цена,АналитикаПланирования,АналитикаИсточника");
		ЗаполнитьЗначенияСвойств(Поиск, ДанныеСтроки);
		НайденныеСтроки = ВыбранныеПотребностиВНоменклатуре.НайтиСтроки(Поиск);
		Если НайденныеСтроки.Количество() = 0 Тогда
			ИзменяемаяСтрока = ВыбранныеПотребностиВНоменклатуре.Добавить();
			ЗаполнитьЗначенияСвойств(ИзменяемаяСтрока, ДанныеСтроки);    
			ИзменяемаяСтрока.КоличествоОстаток = ДанныеСтроки.Количество;     
			ИзменяемаяСтрока.СуммаОбщая = ДанныеСтроки.Сумма;
		Иначе
			ИзменяемаяСтрока = НайденныеСтроки[0];                   
			СуммаОбщая = ДанныеСтроки.Сумма + ИзменяемаяСтрока.Сумма;
			ЗаполнитьЗначенияСвойств(ИзменяемаяСтрока, ДанныеСтроки,,"Количество"); 
			ИзменяемаяСтрока.КоличествоОстаток = ИзменяемаяСтрока.Количество;     
            ИзменяемаяСтрока.СуммаОбщая = СуммаОбщая; 
			ИзменяемаяСтрока.Сумма = СуммаОбщая;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИзменяемаяСтрока.СтавкаНДС) Тогда
			ИзменяемаяСтрока.СтавкаНДС =  ДанныеСтроки.СтавкаНДС; 
		КонецЕсли;			
	КонецЦикла;  
	КоличествоСтрок = Элементы.СписокПотребностей.ВыделенныеСтроки.Количество()-1;
	Пока КоличествоСтрок >=0 Цикл     
		Ключ = Элементы.СписокПотребностей.ВыделенныеСтроки[КоличествоСтрок];
		ДанныеСтроки = Элементы.СписокПотребностей.ДанныеСтроки(Ключ);
		СписокПотребностей.Удалить(СписокПотребностей.индекс(ДанныеСтроки));
		КоличествоСтрок = КоличествоСтрок - 1;
	КонецЦикла;  
	Элементы.СписокПотребностейСумма.ТекстПодвала =  Формат(СписокПотребностей.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	Элементы.СписокПотребностейКоличество.ТекстПодвала = Формат(СписокПотребностей.Итог("Количество"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреКоличествоОстаток.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("КоличествоОстаток"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреСумма.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	
КонецПроцедуры


#КонецОбласти


#Область СлужебныеПроцедурыНаСервере


&НаСервере
Процедура УстановитьРеквизитыФормыПоОрганизации()
	Если ОтборОрганизации.Количество() = 1 Тогда
		ТекОрганизация = ОтборОрганизации[0].Значение;
		МожноВыбратьИнновационный = (ЗначениеЗаполнено(ТекОрганизация) И ТекОрганизация.ЗакупкаПоФЗ223);
	Иначе
		МожноВыбратьИнновационный = Истина;
	КонецЕсли;
	Если НЕ МожноВыбратьИнновационный Тогда
		ВыборПериодаЗакупок.Инновационный = Ложь;
		РеквизитПериодаЗакупокПриИзмененииНаСервере(Элементы.Инновационный.Имя);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОформлениеФормы()
	флРазделятьНоменклатуруПоКатегорийнымМенеджерам = Константы.РазделятьНоменклатуруПоКатегорийнымМенеджерам.Получить();
	ОтображатьМестоПоставки = (НЕ ФиксироватьМестоПоставки) ИЛИ (НЕ ЗначениеЗаполнено(МестоПоставки));
	Элементы.МестоПоставкиОтбор.Доступность = ОтображатьМестоПоставки;
	УстановитьОформлениеФормы();
КонецПроцедуры
	
&НаСервере
Процедура УстановитьОформлениеФормы()

	Элементы.СписокПотребностейСумма.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.СписокПотребностейКоличество.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ВыбранныеПотребностиВНоменклатуреКоличествоОстаток.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ВыбранныеПотребностиВНоменклатуреСумма.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЦФО", Истина));
	
	//Элементы.ЦФОПотребитель.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВыборПериодаЗакупкиИзПараметров(Параметры)
	ЗначениеВДанныеФормы(
		Обработки.ВыборПериодаЗакупок.СоздатьВыборПериодаДиапазоном(
			Параметры.ПериодНачала,
			Параметры.ПериодОкончания,
			Параметры.Инновационный),
		ВыборПериодаЗакупок);
КонецПроцедуры
	
&НаСервере
Процедура РеквизитПериодаЗакупокПриИзмененииНаСервере(ИмяРеквизита)
	Обработки.ВыборПериодаЗакупок.ОбработатьПриИзмененииРеквизита(
		ВыборПериодаЗакупок,
		ИмяРеквизита);
	ПриИзмененииОтбораНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОтбораНаСервере()
	НоваяДатаНачала = ВыборПериодаЗакупок.ПериодНачала.ДатаНачала;
	НоваяДатаОкончания = ВыборПериодаЗакупок.ПериодОкончания.ДатаОкончания;
	
	Запрос = Новый	Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НоваяДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", НоваяДатаОкончания);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Если ОтборОрганизации.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("Организация", ОтборОрганизации);
		Запрос.УстановитьПараметр("ОтборПоОрганизации", Истина);
	Иначе
		Запрос.УстановитьПараметр("Организация", Новый СписокЗначений);
		Запрос.УстановитьПараметр("ОтборПоОрганизации", Ложь);
	КонецЕсли;     
	Запрос.УстановитьПараметр("МестоПоставки", МестоПоставки);    
	Запрос.УстановитьПараметр("ЦФОПотребитель", ЦФОПотребитель);
	
	Запрос.УстановитьПараметр("ТоварнаяКатегория", ОтборТоварнаяКатегория);
	Если Значениезаполнено(ДокументПланирования) Тогда
	Запрос.УстановитьПараметр("ДокументПланирования", ОбъектыПланирования.ПолучитьОбъектПланирования(ДокументПланирования));
	Иначе Запрос.УстановитьПараметр("ДокументПланирования",Неопределено);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	Запрос.УстановитьПараметр("ДокументОтбора", ДокументОтбора); 
	Если Значениезаполнено(ДокументПланирования) И ТИПЗНЧ(ДокументПланирования) = ТИП("ДокументСсылка.СтрокаПланаЗакупок") Тогда
		Запрос.УстановитьПараметр("ДокументИЭтап",Истина);
	Иначе
		Запрос.УстановитьПараметр("ДокументИЭтап",Ложь);
	КонецЕсли;		 
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
   	Запрос.УстановитьПараметр("ВыбранныеПотребностиВНоменклатуре",ВыбранныеПотребностиВНоменклатуре.Выгрузить()); 
   	Запрос.УстановитьПараметр("ВыбранныеПотребностиВНоменклатуреИзначальные",ВыбранныеПотребностиВНоменклатуреИзначальные.Выгрузить()); 
	Если ТИПЗНЧ(ЭтапПланирования) = ТИП("СписокЗначений") Тогда
		Запрос.УстановитьПараметр("ЭтапПланирования", ЭтапПланирования);
	Иначе  
		ЭтапыСписок = Новый СписокЗначений();
		ЭтапыСписок.Добавить(ЭтапПланирования);
		Запрос.УстановитьПараметр("ЭтапПланирования",ЭтапыСписок);
	КонецЕсли; 
	  
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(ДатаСреза,ВидГраницы.Исключая));
		
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаИсточника,
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования КАК АналитикаПланирования,
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.КоличествоОстаток КАК Количество,
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.Сумма КАК Сумма
	               |ПОМЕСТИТЬ ВТ_ВыбранныеПотребностиВНоменклатуре
	               |ИЗ
	               |	&ВыбранныеПотребностиВНоменклатуре КАК ВТ_ВыбранныеПотребностиВНоменклатуре
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаИсточника,
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования КАК АналитикаПланирования,
	               |	СУММА(ВТ_ВыбранныеПотребностиВНоменклатуре.Количество) КАК Количество,
	               |	СУММА(ВТ_ВыбранныеПотребностиВНоменклатуре.Сумма) КАК Сумма
	               |ПОМЕСТИТЬ ВыбранныеПотребностиВНоменклатуре
	               |ИЗ
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре КАК ВТ_ВыбранныеПотребностиВНоменклатуре
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника,
	               |	ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника КАК АналитикаИсточника,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования КАК АналитикаПланирования,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.ДатаОперации КАК ПериодПотребности,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.ОбъектПланирования.Объект КАК ДокументПланирования,
	               |	ВыбранныеПотребностиВНоменклатуре.Количество - ЕСТЬNULL(ВТ_ВыбранныеПотребностиВНоменклатуре.Количество, 0) КАК Количество,
	               |	ВыбранныеПотребностиВНоменклатуре.Сумма - ЕСТЬNULL(ВТ_ВыбранныеПотребностиВНоменклатуре.Сумма, 0) КАК Сумма,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Характеристика КАК Характеристика,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК Коэффициент,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаСтруктуры.Проект КАК Проект,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаПотребностей.МестоПоставки КАК МестоПоставки,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаСтруктуры КАК АналитикаСтруктуры,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВыбранныеПотребностиВНоменклатуре.Сумма / ВыбранныеПотребностиВНоменклатуре.Количество
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Цена,
	               |	ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаПоставки.СтавкаНДС КАК СтавкаНДС
	               |ПОМЕСТИТЬ ВыбранныеПотребностиВНоменклатуреИзначальные
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей КАК ВыбранныеПотребностиВНоменклатуре
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВыбранныеПотребностиВНоменклатуре КАК ВТ_ВыбранныеПотребностиВНоменклатуре
	               |		ПО ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника = ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника
	               |			И ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования = ВТ_ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования
	               |ГДЕ
	               |	ВыбранныеПотребностиВНоменклатуре.Регистратор = &ДокументОтбора
	               |	И ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.Этап В(&ЭтапПланирования)
	               |	И (ВыбранныеПотребностиВНоменклатуре.Сумма - ЕСТЬNULL(ВТ_ВыбранныеПотребностиВНоменклатуре.Сумма, 0) > 0
	               |			ИЛИ ВыбранныеПотребностиВНоменклатуре.Количество - ЕСТЬNULL(ВТ_ВыбранныеПотребностиВНоменклатуре.Количество, 0) > 0)
	               |	И ВЫБОР
	               |			КОГДА &ТоварнаяКатегория <> ЗНАЧЕНИЕ(Справочник.КатегорииЗакупок.ПустаяСсылка)
	               |				ТОГДА ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура.КатегорияЗакупок = &ТоварнаяКатегория
	               |						ИЛИ ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура = &ТоварнаяКатегория
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ЦФОПотребитель <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |				ТОГДА ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника.АналитикаСтруктуры.ЦФО = &ЦФОПотребитель
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |				ТОГДА ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура = &Номенклатура
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &МестоПоставки <> ЗНАЧЕНИЕ(Справочник.МестаПоставки.ПустаяСсылка)
	               |				ТОГДА ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.АналитикаПотребностей.МестоПоставки = &МестоПоставки
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ДокументПланирования <> НЕОПРЕДЕЛЕНО
	               |				ТОГДА ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования.ОбъектПланирования = &ДокументПланирования
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПланированиеПотребностейОстатки.АналитикаИсточника КАК АналитикаИсточника,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования КАК АналитикаПланирования,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации КАК ПериодПотребности,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования.Объект КАК ДокументПланирования,
	               |	ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0) КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.Цена * (ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0))
	               |		ИНАЧЕ ПланированиеПотребностейОстатки.СуммаОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Сумма, 0)
	               |	КОНЕЦ КАК Сумма,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика КАК Характеристика,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Коэффициент КАК Коэффициент,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.ЦФО КАК ЦФО,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Проект КАК Проект,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.МестоПоставки КАК МестоПоставки,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры КАК АналитикаСтруктуры,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Назначение КАК Назначение,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |				И ПланированиеПотребностейОстатки.АналитикаПланирования.Цена > 0
	               |			ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.Цена
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |				И ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0) > 0
	               |			ТОГДА (ПланированиеПотребностейОстатки.СуммаОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Сумма, 0)) / (ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0))
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Цена,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПоставки.СтавкаНДС КАК СтавкаНДС,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
				   |	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура.СтавкаНДС КАК НоменклатураСтавкаНДС				   
	               |ИЗ
	               |	РегистрНакопления.ПланированиеПотребностей.Остатки(
	               |			,
	               |			АналитикаПланирования.Валюта = &Валюта
	               |				И АналитикаПланирования.Этап В (&ЭтапПланирования)) КАК ПланированиеПотребностейОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВыбранныеПотребностиВНоменклатуре КАК ВыбранныеПотребностиВНоменклатуре
	               |		ПО ПланированиеПотребностейОстатки.АналитикаИсточника = ВыбранныеПотребностиВНоменклатуре.АналитикаИсточника
	               |			И ПланированиеПотребностейОстатки.АналитикаПланирования = ВыбранныеПотребностиВНоменклатуре.АналитикаПланирования
	               |ГДЕ
	               |	ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации >= &ДатаНачала
	               |	И ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации <= &ДатаОкончания
	               |	И ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |				ТОГДА ПланированиеПотребностейОстатки.КоличествоОстаток > 0
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И (ПланированиеПотребностейОстатки.СуммаОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Сумма, 0) > 0
	               |			ИЛИ ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0) > 0)
	               |	И ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация В(&Организация)
	               |	И ВЫБОР
	               |			КОГДА &ТоварнаяКатегория <> ЗНАЧЕНИЕ(Справочник.КатегорииЗакупок.ПустаяСсылка)
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура.КатегорияЗакупок = &ТоварнаяКатегория
	               |						ИЛИ ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура = &ТоварнаяКатегория
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ЦФОПотребитель <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаИсточника.АналитикаСтруктуры.ЦФО = &ЦФОПотребитель
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |					И &Номенклатура <> ЗНАЧЕНИЕ(Справочник.КатегорииЗакупок.ПустаяСсылка)
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура = &Номенклатура
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &МестоПоставки <> ЗНАЧЕНИЕ(Справочник.МестаПоставки.ПустаяСсылка)
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.МестоПоставки = &МестоПоставки
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ДокументПланирования <> НЕОПРЕДЕЛЕНО
	               |					И НЕ &ДокументИЭтап
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования = &ДокументПланирования
	               |			КОГДА &ДокументПланирования <> НЕОПРЕДЕЛЕНО
	               |					И ТИПЗНАЧЕНИЯ(&ДокументПланирования) = ТИП(Документ.СтрокаПланаЗакупок)
	               |				ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.ОбъектПланирования = &ДокументПланирования
	               |							И ПланированиеПотребностейОстатки.АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.БюджетЗакупокОрганизации)
	               |						ИЛИ ПланированиеПотребностейОстатки.АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ЗаявкиСогласованные)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               | 	И ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ПланированиеПотребностейОстатки.АналитикаПланирования.Цена * (ПланированиеПотребностейОстатки.КоличествоОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Количество, 0))
	               |		ИНАЧЕ ПланированиеПотребностейОстатки.СуммаОстаток - ЕСТЬNULL(ВыбранныеПотребностиВНоменклатуре.Сумма, 0)
	               |	КОНЕЦ > 0
	               |УПОРЯДОЧИТЬ ПО
	               |	АналитикаИсточника,
	               |	ПериодПотребности";	
	СписокПотребностей.Очистить();           
	СписокПотребностей.Загрузить(Запрос.Выполнить().Выгрузить());           
	
	Элементы.СписокПотребностейСумма.ТекстПодвала =  Формат(СписокПотребностей.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	Элементы.СписокПотребностейКоличество.ТекстПодвала = Формат(СписокПотребностей.Итог("Количество"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреКоличествоОстаток.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("КоличествоОстаток"),"ЧДЦ=3; ЧН=0,000");
 	Элементы.ВыбранныеПотребностиВНоменклатуреСумма.ТекстПодвала = Формат(ВыбранныеПотребностиВНоменклатуре.Итог("Сумма"),"ЧДЦ=2; ЧН=0,00");
	

КонецПроцедуры

