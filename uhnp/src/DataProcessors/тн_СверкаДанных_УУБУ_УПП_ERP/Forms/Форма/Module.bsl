Функция СписокДоступныхСчетов_Взаиморасчеты()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ХозрасчетныйВидыСубконто.Ссылка КАК Счет,
		|	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) КАК НомерСтроки
		|ИЗ
		|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ХозрасчетныйВидыСубконто.НомерСтроки = 1
		|					И ХозрасчетныйВидыСубконто.ВидСубконто = &ВидСубконтоКонтрагентХозр
		|				ТОГДА ИСТИНА
		|			КОГДА ХозрасчетныйВидыСубконто.НомерСтроки = 2
		|					И ХозрасчетныйВидыСубконто.ВидСубконто = &ВидСубконтоДоговорХозр
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ХозрасчетныйВидыСубконто.Ссылка
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ХозрасчетныйВидыСубконто.НомерСтроки) > 1";
	
	Запрос.УстановитьПараметр("ВидСубконтоДоговорХозр", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	Запрос.УстановитьПараметр("ВидСубконтоКонтрагентХозр", ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	
	СписокСчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");
	
	Возврат СписокСчетов;
	
КонецФункции

