&НаСервереБезКонтекста
Функция ПолучитьДанныеУПП_Взаиморасчеты(АдресХранилища) 
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокументУПП = Новый ТабличныйДокумент;
	ТабличныйДокументУПП.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокументУПП.Область(1, 4, ТабличныйДокументУПП.ВысотаТаблицы, ТабличныйДокументУПП.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаДанныхУПП = Построитель.Результат.Выгрузить();
	
	ТаблицаДанныхУПП.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанныхУПП.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанныхУПП.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанныхУПП Цикл
		СтрокаТаблицы.Организация = ПолучитьСсылкуПоГУИД(Справочники.Организации, СтрокаТаблицы.Организация_GUID);
		СтрокаТаблицы.Контрагент = ПолучитьСсылкуПоГУИД(Справочники.Контрагенты, СтрокаТаблицы.Контрагент_GUID);
		СтрокаТаблицы.Договор = ПолучитьСсылкуПоГУИД(Справочники.ДоговорыКонтрагентов, СтрокаТаблицы.Договор_GUID);
	КонецЦикла;
	
	Возврат ТаблицаДанныхУПП;
	
КонецФункции

&НаСервере
