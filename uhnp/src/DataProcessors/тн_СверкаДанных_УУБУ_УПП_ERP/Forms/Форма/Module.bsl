&НаСервереБезКонтекста
Функция ТаблицаДанныхERP_Взаиморасчеты(ПараметрыСверки, ДатаСверки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСверки", Новый Граница(ДатаСверки));
	Запрос.УстановитьПараметр("СписокСчетов", ПараметрыСверки.ОтборПоСчетам);
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры); 
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);

	УсловияОтбора = Новый Массив;
	ЗначениеОтбора = Неопределено;
	
	Если ПараметрыСверки.Свойство("ОтборПоОрганизациям", ЗначениеОтбора) Тогда
		Запрос.УстановитьПараметр("Организации", ЗначениеОтбора);
		УсловияОтбора.Добавить("Организация В (&Организации)");
	КонецЕсли;
	
	Если ПараметрыСверки.Свойство("ОтборПоКонтрагентам", ЗначениеОтбора) Тогда
		Запрос.УстановитьПараметр("Контрагенты", ЗначениеОтбора);
		//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272
		//УсловияОтбора.Добавить("Субконто1 В (&Контрагенты)");
		УсловияОтбора.Добавить("Субконто1 В (ВЫБРАТЬ втОтборПоКонтрагентам.Контрагент ИЗ втОтборПоКонтрагентам КАК втОтборПоКонтрагентам)"); 
		Запрос.УстановитьПараметр("ИспользоватьОтборПоКонтрагентам", Истина);
	Иначе
		Запрос.УстановитьПараметр("Контрагенты", Неопределено); 
		Запрос.УстановитьПараметр("ИспользоватьОтборПоКонтрагентам", Ложь);
		//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
	КонецЕсли;
	
	Если ПараметрыСверки.Свойство("ОтборПоДоговорам", ЗначениеОтбора) Тогда
		Запрос.УстановитьПараметр("Договоры", ЗначениеОтбора);
		УсловияОтбора.Добавить("Субконто2 В (&Договоры)");
	КонецЕсли;
	
	ТекстУсловий = "";
	Если УсловияОтбора.Количество() > 0 Тогда
		ТекстУсловий = СтрСоединить(УсловияОтбора, " И ");
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272 
        |	Контрагенты.Ссылка КАК Контрагент
		|ПОМЕСТИТЬ втОтборПоКонтрагентам
        |ИЗ
        |	Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |	&ИспользоватьОтборПоКонтрагентам 
		|	И Контрагенты.Партнер В ИЕРАРХИИ(&Контрагенты)
	    |;
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
		|	ХозрасчетныйОстатки.Субконто1 КАК Контрагент,
		|	ХозрасчетныйОстатки.Субконто2 КАК Договор,
		|	ХозрасчетныйОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ХозрасчетныйОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.Счет.Валютный
		|			ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстатокДт
		|		ИНАЧЕ ХозрасчетныйОстатки.СуммаОстатокДт
		|	КОНЕЦ КАК ВалютнаяСуммаОстатокДт,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.Счет.Валютный
		|			ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстатокКт
		|		ИНАЧЕ ХозрасчетныйОстатки.СуммаОстатокКт
		|	КОНЕЦ КАК ВалютнаяСуммаОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаСверки, Счет В ИЕРАРХИИ (&СписокСчетов), &СубконтоКонтрагентыДоговоры, " + ТекстУсловий + " ) КАК ХозрасчетныйОстатки";
	

	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

&НаСервере
Функция ПараметрыERP_Взаиморасчеты() 
	
	ПараметрыСверки = Новый Структура;
	
	СписокКонтрагентов = Взаиморасчеты_Контрагенты.ВыгрузитьЗначения();
	Если СписокКонтрагентов.Количество() > 0 Тогда
		ПараметрыСверки.Вставить("ОтборПоКонтрагентам", СписокКонтрагентов);   
	КонецЕсли; 
	СписокДоговоров = Взаиморасчеты_Договоры.ВыгрузитьЗначения();
	Если СписокДоговоров.Количество() > 0 Тогда
		ПараметрыСверки.Вставить("ОтборПоДоговорам", СписокДоговоров);
	КонецЕсли;
	СписокОрганизаций = Взаиморасчеты_Организации.ВыгрузитьЗначения();
	Если СписокОрганизаций.Количество() > 0 Тогда
		ПараметрыСверки.Вставить("ОтборПоОрганизациям", СписокОрганизаций);
	КонецЕсли;
	СписокСчетов = Взаиморасчеты_СчетаБУ.ВыгрузитьЗначения();
	Если СписокСчетов.Количество() > 0 Тогда
		ПараметрыСверки.Вставить("ОтборПоСчетам", СписокСчетов);
	Иначе
		ПараметрыСверки.Вставить("ОтборПоСчетам", Взаиморасчеты_СчетаБУ.ДоступныеЗначения.ВыгрузитьЗначения());
	КонецЕсли;
	
	Возврат ПараметрыСверки;
   
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаРезультатСверки_Взаиморасчеты(ТаблицаДанныхУПП, ТаблицаДанныхERP) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанныхУПП", ТаблицаДанныхУПП);
	Запрос.УстановитьПараметр("ТаблицаДанныхERP", ТаблицаДанныхERP);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТаблицаДанныхУПП.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
		|	ТаблицаДанныхУПП.Договор КАК Договор,
		|	ТаблицаДанныхУПП.СальдоДтУпр КАК СальдоДтУпр,
		|	ТаблицаДанныхУПП.СальдоКтУпр КАК СальдоКтУпр,
		|	ТаблицаДанныхУПП.СальдоДтУпрВал КАК СальдоДтУпрВал,
		|	ТаблицаДанныхУПП.СальдоКтУпрВал КАК СальдоКтУпрВал
		|ПОМЕСТИТЬ ВТ_ДанныеУПП
		|ИЗ
		|	&ТаблицаДанныхУПП КАК ТаблицаДанныхУПП
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент,
		|	Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТаблицаДанныхERP.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
		|	ТаблицаДанныхERP.Договор КАК Договор,
		|	ТаблицаДанныхERP.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ТаблицаДанныхERP.СуммаОстатокКт КАК СуммаОстатокКт,
		|	ТаблицаДанныхERP.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
		|	ТаблицаДанныхERP.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт
		|ПОМЕСТИТЬ ВТ_ДанныеERP
		|ИЗ
		|	&ТаблицаДанныхERP КАК ТаблицаДанныхERP
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент,
		|	Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_ДанныеERP.Контрагент, ВТ_ДанныеУПП.Контрагент) КАК Контрагент,
		|	ЕСТЬNULL(ВТ_ДанныеERP.Договор, ВТ_ДанныеУПП.Договор) КАК Договор,
		|	ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокДт, 0) КАК СальдоДтБУ,
		|	ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокКт, 0) КАК СальдоКтБУ,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпр, 0) КАК СальдоДтУУ,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпр, 0) КАК СальдоКтУУ,
		|	ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокДт, 0) КАК СальдоДтВалБУ,
		|	ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокКт, 0) КАК СальдоКтВалБУ,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпрВал, 0) КАК СальдоДтВалУУ,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпрВал, 0) КАК СальдоКтВалУУ,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпр, 0) - ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокДт, 0) КАК РазницаСальдоДт,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпр, 0) - ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокКт, 0) КАК РазницаСальдоКт,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпрВал, 0) - ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокДт, 0) КАК РазницаСальдоДтВал,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпрВал, 0) - ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокКт, 0) КАК РазницаСальдоКтВал,
		|	ЕСТЬNULL(ЕСТЬNULL(ВТ_ДанныеERP.Контрагент.Партнер.Родитель, ВТ_ДанныеУПП.Контрагент.Партнер.Родитель), ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)) КАК ИерархияПартнера,
		|	ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпр, 0) - ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокДт, 0) <> 0
		|		ИЛИ ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпр, 0) - ЕСТЬNULL(ВТ_ДанныеERP.СуммаОстатокКт, 0) <> 0
		|		ИЛИ ЕСТЬNULL(ВТ_ДанныеУПП.СальдоДтУпрВал, 0) - ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокДт, 0) <> 0
		|		ИЛИ ЕСТЬNULL(ВТ_ДанныеУПП.СальдоКтУпрВал, 0) - ЕСТЬNULL(ВТ_ДанныеERP.ВалютнаяСуммаОстатокКт, 0) <> 0 КАК ЕстьРазница
		|ИЗ
		|	ВТ_ДанныеУПП КАК ВТ_ДанныеУПП
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ДанныеERP КАК ВТ_ДанныеERP
		|		ПО ВТ_ДанныеУПП.Контрагент = ВТ_ДанныеERP.Контрагент
		|			И ВТ_ДанныеУПП.Договор = ВТ_ДанныеERP.Договор";
	
	РезультатСверки = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатСверки;
	
КонецФункции

&НаСервере
Процедура УстановитьОтборыПоВариантуСверки_Взаиморасчеты(Настройки)
	
	ПолеЕстьРазница = Новый ПолеКомпоновкиДанных("ЕстьРазница");
	Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.ЛевоеЗначение = ПолеЕстьРазница Тогда
			
			ЭлементОтбора.Использование = Взаиморасчеты_ПоказыватьТолькоРасхождения;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Истина;
			
			Прервать; 
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

