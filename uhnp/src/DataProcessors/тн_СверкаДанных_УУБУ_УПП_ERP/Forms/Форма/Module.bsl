#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Взаиморасчеты
	СписокЗначенийДоступныхСчетов_Взаиморасчеты = Новый СписокЗначений;
	СписокЗначенийДоступныхСчетов_Взаиморасчеты.ЗагрузитьЗначения(СписокДоступныхСчетов_Взаиморасчеты());
	Взаиморасчеты_СчетаБУ.ДоступныеЗначения = СписокЗначенийДоступныхСчетов_Взаиморасчеты;; 
	
	ИнициализироватьКомпоновкуДанных();
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)  
	
	УстановитьВидимостьДоступность(); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы  

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантСверкиПриИзменении(Элемент) 
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПровестиСверку(Команда) 
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл, выгруженный из УПП!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВариантСверки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать вариант сверки!"); 
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСверки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо указать дату сверки!");
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	ПровестиСверкуНаСервере(АдресХранилища);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТабДок(Команда)
	ОбновитьТабДокНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийРасшифровкиРезультата

&НаКлиенте
Процедура ТабличныйДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначениеРасшифровки(Расшифровка, Элемент.ТекущаяОбласть.Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗначениеРасшифровки(Расшифровка, ТекстовоеЗначениеПоля)
	
	//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272
	//ЗначениеРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстовоеЗначениеПоля);
	//Если ЗначениеРасшифровки <> Неопределено Тогда
	//	ПоказатьЗначение(,ЗначениеРасшифровки);
	//КонецЕсли;
	
	СтруктураРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстовоеЗначениеПоля);
	ЗначениеРасшифровки	 = СтруктураРасшифровки.ЗначениеРасшифровки;
	
	Если СтруктураРасшифровки.Действие = "РасшифровкаАнализСубконто" Тогда
		РасшифровкаАнализСубконто(ЗначениеРасшифровки);		
	Иначе 
		Если ЗначениеРасшифровки <> Неопределено Тогда   
			ПоказатьЗначение(,ЗначениеРасшифровки);
		КонецЕсли; 
	КонецЕсли;
	//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки)
	
	//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272 
	СтруктураРасшифровки = Новый Структура("Действие, ЗначениеРасшифровки", Неопределено, Неопределено);
	//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
	СсылкаРасшифровки = Неопределено;
	
	ДанныеРасшифровкиСверки = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Если ТипЗнч(ДанныеРасшифровкиСверки) = Тип("ДанныеРасшифровкиКомпоновкиДанных")
		И Число(Расшифровка) <= ДанныеРасшифровкиСверки.Элементы.Количество() - 1 
		И ТипЗнч(ДанныеРасшифровкиСверки.Элементы[Расшифровка]) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля")
		//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272
		//И ДанныеРасшифровкиСверки.Элементы[Расшифровка].ОсновноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		Тогда 
		
		Если  ДанныеРасшифровкиСверки.Элементы[Расшифровка].ОсновноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
			МассивЗначений = ДанныеРасшифровкиСверки.Элементы[Расшифровка].ПолучитьПоля();
			Если МассивЗначений.Количество() > 0 И Строка(МассивЗначений[0].Значение) = ТекстПоляРасшифровки Тогда
				СсылкаРасшифровки = МассивЗначений[0].Значение;		
			КонецЕсли; 
		//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272  
		СтруктураРасшифровки.ЗначениеРасшифровки = СсылкаРасшифровки;
		
		Иначе 
			
			МассивЗначений = ДанныеРасшифровкиСверки.Элементы[Расшифровка].ПолучитьПоля();
			
			НайденноеПоле = Неопределено;
			МассивПолейРасшифровки = Новый Массив; //доступные для расшифровки ресурсы
			МассивПолейРасшифровки.Добавить("СальдоДтБУ");
			МассивПолейРасшифровки.Добавить("СальдоКтБУ");
			МассивПолейРасшифровки.Добавить("СальдоДтВалБУ");
			МассивПолейРасшифровки.Добавить("СальдоКтВалБУ");
			Для Каждого ИмяПоля Из МассивПолейРасшифровки Цикл 
				НайденноеПоле = МассивЗначений.Найти(ИмяПоля);
				Если НайденноеПоле <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НайденноеПоле <> Неопределено Тогда
				
				МассивГруппировокОтборов = Новый Массив; //доступные для расшифровки группировки
				МассивГруппировокОтборов.Добавить("Контрагент");
				МассивГруппировокОтборов.Добавить("Договор"); 
				
				МассивГруппировок = ТиповыеОтчетыУХ.ПолучитьМассивПолейРасшифровки(Расшифровка, ДанныеРасшифровки);	
				ЗначениеРасшифровки = Новый Массив;
				Для Каждого ПолеРасшифровки Из МассивГруппировок Цикл
					Если МассивГруппировокОтборов.Найти(ПолеРасшифровки.Поле)<>Неопределено Тогда
						ЗначениеРасшифровки.Добавить(Новый Структура("Поле, Значение", ПолеРасшифровки.Поле, ПолеРасшифровки.Значение));
					КонецЕсли;
				КонецЦикла;
				
				Если ЗначениеРасшифровки.Количество()>0 Тогда
					СтруктураРасшифровки.Действие  = "РасшифровкаАнализСубконто";
					СтруктураРасшифровки.ЗначениеРасшифровки = ЗначениеРасшифровки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272	
	КонецЕсли; 
	
	//НАЧАЛО Качикина 27.04.2026 Выполнение задач №000057272
	//Возврат СсылкаРасшифровки;
	Возврат СтруктураРасшифровки;
	//КОНЕЦ Качикина 27.04.2026 Выполнение задач №000057272
	
КонецФункции

//Качикина 27.04.2026 Выполнение задач №000057272   
&НаКлиенте
Процедура РасшифровкаАнализСубконто(ЗначениеОтбора)
	    		
    ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных; 
	
    ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
    ДополнительныеСвойства.Вставить("РежимРасшифровки", Истина);
    ДополнительныеСвойства.Вставить("НачалоПериода",    НачалоМесяца(ДатаСверки));
    ДополнительныеСвойства.Вставить("КонецПериода",     КонецДня(ДатаСверки));
	ДополнительныеСвойства.Вставить("ПоСубсчетам",		Истина);
	ДополнительныеСвойства.Вставить("ЕстьВалюта",		Истина);                 
	ДополнительныеСвойства.Вставить("ПоказательБУ",		Истина);
	//ДополнительныеСвойства.Вставить("РазвернутоеСальдо",Истина);
	
	//ВидыСубконто >>>>>
	СписокВидовСубконто = Новый СписокЗначений;
    СписокВидовСубконто.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты"));
	СписокВидовСубконто.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры"));
	
	ДополнительныеСвойства.Вставить("СписокВидовСубконто", СписокВидовСубконто);
	//ВидыСубконто >>>>>
	
	//Группировки >>>>> 
	ГруппировкаОтчета = Новый Массив;
	
	ГруппировкаКонтрагент = Новый Структура;
	ГруппировкаКонтрагент.Вставить("Использование",  Истина);
	ГруппировкаКонтрагент.Вставить("Поле",           Новый ПолеКомпоновкиДанных("Субконто1"));
	ГруппировкаКонтрагент.Вставить("Представление",  "Контрагенты");
	ГруппировкаКонтрагент.Вставить("ТипГруппировки", 0);
	ГруппировкаОтчета.Добавить(ГруппировкаКонтрагент); 
	
	ГруппировкаДоговор = Новый Структура;
	ГруппировкаДоговор.Вставить("Использование",  Истина);
	ГруппировкаДоговор.Вставить("Поле",           Новый ПолеКомпоновкиДанных("Субконто2"));
	ГруппировкаДоговор.Вставить("Представление",  "Договоры");
	ГруппировкаДоговор.Вставить("ТипГруппировки", 0);
	ГруппировкаОтчета.Добавить(ГруппировкаДоговор);

	ДополнительныеСвойства.Вставить("Группировка", ГруппировкаОтчета);  
	//Группировки <<<<<<  
	
	//Отборы >>>>>>>>>>>>>
	НастройкаОтбора = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	НастройкаОтбора.ИдентификаторПользовательскойНастройки = "Отбор"; 
	Если ЗначениеЗаполнено(Взаиморасчеты_Организации) Тогда 
		//отдельно добавляем отбор на организацию, т.к. может быть задан список
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(НастройкаОтбора, "Организация", Взаиморасчеты_Организации, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;
	Если ЗначениеЗаполнено(Взаиморасчеты_СчетаБУ) Тогда 
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(НастройкаОтбора, "Счет", Взаиморасчеты_СчетаБУ, ВидСравненияКомпоновкиДанных.ВИерархии); 
	Иначе 
		БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(НастройкаОтбора, "Счет", Взаиморасчеты_СчетаБУ.ДоступныеЗначения, ВидСравненияКомпоновкиДанных.ВИерархии);
	КонецЕсли;
    
	Для Каждого ЭлементМассива Из ЗначениеОтбора Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
			Если ЭлементМассива.Поле = "Контрагент" Тогда
				БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(НастройкаОтбора, "Субконто1", ЭлементМассива.Значение, ВидСравненияКомпоновкиДанных.ВИерархии);	
			ИначеЕсли ЭлементМассива.Поле = "Договор" Тогда
            	БухгалтерскиеОтчетыКлиентСервер.ДобавитьОтбор(НастройкаОтбора, "Субконто2", ЭлементМассива.Значение, ВидСравненияКомпоновкиДанных.Равно);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	//Отборы <<<<<<<<<<<<
	
    ПараметрыОтчета = Новый Структура;
    ПараметрыОтчета.Вставить("РежимРасшифровки",            Истина);
    ПараметрыОтчета.Вставить("ВидРасшифровки",              2);
    ПараметрыОтчета.Вставить("ПользовательскиеНастройки",   ПользовательскиеНастройки);
    ПараметрыОтчета.Вставить("ЗаполняемыеНастройки",        Новый Структура("Показатели", Истина));
    ПараметрыОтчета.Вставить("СформироватьПриОткрытии",     Истина);
		
    ОткрытьФорму("Отчет.АнализСубконто.Форма.ФормаОтчета", ПараметрыОтчета, ЭтотОбъект, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщиеСлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьКомпоновкуДанных()
	
	//Взаиморасчеты
	СКД 				= РеквизитФормыВЗначение("Объект").ПолучитьМакет("Взаиморасчеты_Результат");
	АдресВХ 			= ПоместитьВоВременноеХранилище(СКД, УникальныйИдентификатор);
	ИсточникНастроек 	= Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВХ);
	Взаиморасчеты_КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	Взаиморасчеты_КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность() 
	
	Элементы.ГруппаОтборы_Взаиморасчеты.Видимость = ВариантСверки = "Взаиморасчеты";
	Элементы.ГруппаНастройкиВывода_Взаиморасчеты.Видимость = ВариантСверки = "Взаиморасчеты"; 
	Элементы.ГруппаРезультатСверки.Доступность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПровестиСверкуНаСервере(АдресХранилища)
	
	Если ВариантСверки = "Взаиморасчеты" Тогда
		ВыполнитьСверкуНаСервере_Взаиморасчеты(АдресХранилища);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиОтчетНаФорму(ТаблицаСверки)
	
	ТабличныйДокументРезультат.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИмяМакета = ВариантСверки + "_Результат";
	СхемаКомпоновкиДанных = ОбработкаОбъект.ПолучитьМакет(ИмяМакета);
	
	РеквизитКомпоновщик = ЭтотОбъект[ВариантСверки + "_КомпоновщикНастроек"];
	Настройки = РеквизитКомпоновщик.ПолучитьНастройки(); 
	
	УстановитьОтборыПоВариантуСверки(Настройки);

	ДанныеРасшифровкиОтчета = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровкиОтчета);
	
	ВнешнийНаборДанных = Новый Структура("ТаблицаРезультат", ТаблицаСверки);

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных, ДанныеРасшифровкиОтчета);
	
	ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОтчета, Новый УникальныйИдентификатор);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Элементы.ГруппаРезультатСверки.Доступность = Истина;
	ТекущийЭлемент =  Элементы.ГруппаРезультатСверки;
    
КонецПроцедуры

