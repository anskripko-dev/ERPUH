&НаКлиенте
Процедура ПолучитьДанныеСПортала(Команда) 
	
	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	//Если Зачеты.Количество() > 0 Тогда    
	Если Объект.Зачеты.Количество() > 0 Тогда 
	// КОНЕЦ Юдина Екатерина 06.10.2025 Выполнение задач №000055378	
		ТекстВопроса = "Табличная часть будет очищена. Продолжить?"; 
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОчисткеТЧ", ЭтотОбъект);
