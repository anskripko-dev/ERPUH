&НаСервере
Процедура СоздатьДокументыВзаимозачетЗадолженностиНаСервере()
	
	ТЗЗачеты = Объект.Зачеты.Выгрузить();
	
	Обработки.тн_ЗагрузкаВыгрузкаВзаиморасчетовСПортала.СоздатьДокументы(ТЗЗачеты);  
	
	Объект.Зачеты.Загрузить(ТЗЗачеты);

КонецПроцедуры  

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()    
	
	РезультатПроверки = Ложь;
	
	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	//Для Сч = 0 По Зачеты.Количество() - 1 Цикл
	//	Стр = Зачеты[Сч]; 
	Для Сч = 0 По Объект.Зачеты.Количество() - 1 Цикл
		Стр =  Объект.Зачеты[Сч];
	// КОНЕЦ Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	
		Если НЕ Стр.Пометка Тогда
			Продолжить;
		КонецЕсли; 
		
		Результат = Истина;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.ДатаЗачета, 		 "Дата зачета",    	   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].ДатаЗачета",  	  	   Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Плательщик, 	 	 "Плательщик",     	   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Плательщик",	  	   Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.ДоговорПлательщика, "Договор плательщика", "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].ДоговорПлательщика", Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Получатель, 		 "Получатель", 		   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Получатель", 		   Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.ДоговорПолучателя,  "Договор получателя",  "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].ДоговорПолучателя",  Сч) И Результат;
		Результат = ПроверитьЗаполнениеРеквизита(Стр.Сумма, 		     "Сумма", 		   	   "Зачеты[" + Формат(Сч, "ЧН=0; ЧГ=0") + "].Сумма",		  	   Сч) И Результат;
		
		Стр.РезультатПроверки 	= Результат;
		РезультатПроверки 		= РезультатПроверки ИЛИ Результат;
	КонецЦикла;
	
	Возврат РезультатПроверки;  
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизита(Значение, Имя, Поле, НомерСтроки = Неопределено)  
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина; 
	КонецЕсли; 
	
	ТекстСообщения	= ?(НомерСтроки <> Неопределено, "В строке №" + (НомерСтроки + 1) + " не ", "Не ") + "заполнено значение реквизита: " + Имя;
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле);
	
	Возврат Ложь; 
	
КонецФункции

&НаКлиенте
Процедура ИзменитьПометки(Пометка = Неопределено)   
	
	// НАЧАЛО Юдина Екатерина 06.10.2025 Выполнение задач №000055378
	//Для Каждого Стр Из Зачеты Цикл 
	Для Каждого Стр Из Объект.Зачеты Цикл
	// КОНЕЦ Юдина Екатерина 06.10.2025 Выполнение задач №000055378
		Стр.Пометка = ?(Пометка = Неопределено, НЕ Стр.Пометка, Пометка);
	КонецЦикла;  
	
КонецПроцедуры

