&НаКлиенте
Процедура ЗачетыПлательщикПриИзменении(Элемент) 
	
	ТекущиеДанные = Элементы.Зачеты.ТекущиеДанные;
	ДанныеПоКонтрагенту = ДанныеПоКонтрагенту(ТекущиеДанные.Плательщик);
	ТекущиеДанные.ИННПлательщика = ДанныеПоКонтрагенту.ИНН;
	ТекущиеДанные.КПППлательщика = ДанныеПоКонтрагенту.КПП;
    ТекущиеДанные.ЕККПлательщика = ДанныеПоКонтрагенту.тн_ЕКК;
	ТекущиеДанные.ДоговорПлательщика = ДанныеПоКонтрагенту.Договор; 
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗачетыПолучательПриИзменении(Элемент)  
	
	ТекущиеДанные = Элементы.Зачеты.ТекущиеДанные;
	ДанныеПоКонтрагенту = ДанныеПоКонтрагенту(ТекущиеДанные.Получатель);
	ТекущиеДанные.ИННПолучателя = ДанныеПоКонтрагенту.ИНН;
	ТекущиеДанные.КПППолучателя = ДанныеПоКонтрагенту.КПП;
    ТекущиеДанные.ЕККПолучателя = ДанныеПоКонтрагенту.тн_ЕКК;
	ТекущиеДанные.ДоговорПолучателя = ДанныеПоКонтрагенту.Договор; 

КонецПроцедуры

#КонецОбласти

