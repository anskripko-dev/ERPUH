// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция СформироватьТекстСообщенияЗапросДанных(ПараметрыСообщения, ОбъектXDTO_ЗапросДанных)
	
	ИмяТипаЭлементаXDTO	 = "headers";
	ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_Integration_Portal", ИмяТипаЭлементаXDTO);
	ОбъектXDTO_ЗапросДанных[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO;
	
	ПараметрыСообщения.КонтейнерXDTO = ОбъектXDTO_ЗапросДанных;
	тн_Интеграция_УПП.ДобавитьСистемныеПараметры(ПараметрыСообщения);
	
	ТекстСообщения = тн_Интеграция.СериализоватьКонтейнерXDTO(ОбъектXDTO_ЗапросДанных,, "JSON");
	тн_Интеграция_УПП.ЗаменитьПредставлениеФорматов(ТекстСообщения);
	тн_ИнтеграцияFinAppPortal.УдалитьТипизациюВСтрокеJSON(ТекстСообщения);
	
	ПараметрыСообщения.ТекстСообщения = ТекстСообщения;
	
	Возврат ТекстСообщения;
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция ПолучитьОбъектXDTO_ЗапросДанных(ПараметрыСообщения, ДокументыСозданы = Ложь, ИдентификаторВзаимозачета = 0, СтатусВзаимозачета = "",
		СписокКонтрагентов = Неопределено, ДатаНачала = '00010101', ДатаОкончания = '00010101')

	ИдентификаторЗапроса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСообщения, "ИдентификаторЗапроса");
	
	ИмяПакетаXDTO = "tn_Integration_Portal";
	ИмяТипаЭлементаXDTO	 = "requestSettlements"; 
	
	КонтейнерXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO);

	ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + "_DTO");
	ЭлементКонтейнераXDTO.date = ТекущаяДатаСеанса();
	ЭлементКонтейнераXDTO.idRequest = ИдентификаторЗапроса;
	ЭлементКонтейнераXDTO.documentsAreCreated = ДокументыСозданы;
	ЭлементКонтейнераXDTO.beginPeriod = ДатаНачала;
	ЭлементКонтейнераXDTO.endPeriod = ДатаОкончания;
	Если ТипЗнч(СписокКонтрагентов) = Тип("ТаблицаЗначений") И СписокКонтрагентов.Количество() > 0 Тогда   
		ЭлементКонтейнераXDTO.byCounterparties = Истина;
	Иначе
		ЭлементКонтейнераXDTO.byCounterparties = Ложь;
	КонецЕсли;
	
	Если ДокументыСозданы Тогда
        ЭлементКонтейнераXDTO.idSettlement = ИдентификаторВзаимозачета; 
		Если СтатусВзаимозачета = "10" Тогда
			ЭлементКонтейнераXDTO.status = "20";
		КонецЕсли;
	КонецЕсли;	
		
	Если ЭлементКонтейнераXDTO.byCounterparties = Истина Тогда
		XDTO_ИмяТЧ = "TableCounterparties";
		XDTO_ТипТЧ = ФабрикаXDTO.Тип(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ);
		XDTO_ТЧ	= ФабрикаXDTO.Создать(XDTO_ТипТЧ);
		XDTO_ТипСтрокаТЧ = ФабрикаXDTO.Тип(ИмяПакетаXDTO, ИмяТипаЭлементаXDTO + XDTO_ИмяТЧ + "String"); 
		
		Для Каждого СтрокаПоКонтрагенту Из СписокКонтрагентов Цикл
			XDTO_СтрокаТЧ = ФабрикаXDTO.Создать(XDTO_ТипСтрокаТЧ);
			XDTO_СтрокаТЧ.inn = СтрокаПоКонтрагенту.ИНН;
			XDTO_СтрокаТЧ.kpp = СтрокаПоКонтрагенту.КПП;   
			XDTO_СтрокаТЧ.ekk = СтрокаПоКонтрагенту.ЕКК;
			XDTO_ТЧ.String.Добавить(XDTO_СтрокаТЧ);
		КонецЦикла;
		
		ЭлементКонтейнераXDTO[XDTO_ИмяТЧ] = XDTO_ТЧ; 
		
    КонецЕсли;
	
	КонтейнерXDTO[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO; 
	
	Возврат КонтейнерXDTO;

КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Процедура ОтправитьСообщениеЗапрос(ПараметрыСообщения)
	
	ПараметрыОтправки = Новый Структура();
	// - xdto-пакет
	ПараметрыОтправки.Вставить("ИмяПакетаXDTO"		 , "tn_Integration_Portal");	
	ПараметрыОтправки.Вставить("ИмяТипаОтветногоXDTO", "requestSettlements");
		
	// - транспорт (RabbitMQ)
	УИДПортала = Новый УникальныйИдентификатор("8859a021-d63f-11ea-b819-00155d4d7383");
	ПроизводственноеПодразделениеПортал = Справочники.тн_ПроизводственныеПодразделения.ПолучитьСсылку(УИДПортала);
	ПараметрыОтправки.Вставить("Профиль"			 		  , Справочники.тн_ПрофилиПодключений.ERP_УХ);
	ПараметрыОтправки.Вставить("ФорматСообщения"	 		  , "JSON");
	ПараметрыОтправки.Вставить("ТочкаОбменаRabbitMQ" 		  , Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	ПараметрыОтправки.Вставить("КлючМаршрутизации"	 		  , XMLСтрока(ПроизводственноеПодразделениеПортал));
    ПараметрыОтправки.Вставить("ПроизводственноеПодразделение", ПроизводственноеПодразделениеПортал);
    ПараметрыОтправки.Вставить("КонтейнерXDTO"				  , ПараметрыСообщения.КонтейнерXDTO);

	// - логирование
	ДанныеДляЛогирования = тн_ИнтеграцияFinAppPortal.ДанныеДляЛогирования(
		ПараметрыСообщения.ВидСообщения,,, ПараметрыОтправки.Профиль.ВестиЛоги, Перечисления.тн_ВидыИнтеграций.Портал_Отправка);
	ПараметрыОтправки.Вставить("ДанныеДляЛогирования", ДанныеДляЛогирования); 
	
	Попытка
		тн_ИнтеграцияFinAppPortal.ОтправитьПакет(ПараметрыСообщения.ТекстСообщения, ПараметрыОтправки); 
