Функция ЗагрузитьДанныеСПорталаНаСервере(УникальныйИдентификатор, ПериодЗагрузки, РегламентноеЗадание = Ложь) Экспорт 
	
	//Формируем и отправляем сообщение-запрос 
	ПараметрыСообщения = ПараметрыСообщения();
	
	СписокКонтрагентов = КонтрагентыДляЗагрузки(); 
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(ПараметрыСообщения,,,, СписокКонтрагентов, ПериодЗагрузки.ДатаНачала, ПериодЗагрузки.ДатаОкончания);
	ТекстСообщения = СформироватьТекстСообщенияЗапросДанных(ПараметрыСообщения, ОбъектXDTO_ЗапросДанных); 
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОтправитьСообщениеЗапрос(ПараметрыСообщения);
	
	ДобавитьЗаписьЗапросыRabbitMQ(ПараметрыСообщения);
		
	ДлительнаяОперация = ДлительнаяОперацияОжиданияОбработкиОтветногоСообщения(ПараметрыСообщения, УникальныйИдентификатор, РегламентноеЗадание); 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДлительнаяОперация;
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Процедура ЗаполнитьЗачеты(РезультатВыполненияДлительнойОперации, Зачеты, ПериодЗагрузки = Неопределено) Экспорт 
	
	СообщениеXDTO = тн_ИнтеграцияFinAppPortal.ПрочитатьСообщениеJSON(РезультатВыполненияДлительнойОперации.Результат);
	Если СообщениеXDTO = Неопределено Тогда 
		Возврат;
	КонецЕсли;

	ДанныеПоЗачетам = СообщениеXDTO.responseSettlements[0].tableData.string;      

	Для Сч = 1 По ДанныеПоЗачетам.Количество() Цикл
		
		Зачет = ДанныеПоЗачетам[Сч - 1];
		
		Стр = Зачеты.Добавить();
		
		Стр.НомерСтроки		   = Сч; 
		Стр.ДатаЗачета		   = Зачет.date;
		Стр.НомерЗачета		   = Зачет.id;
		Стр.ЕККПлательщика     = Зачет.ekkPayer;
		Стр.ИННПлательщика     = СокрЛП(Зачет.innPayer);
		Стр.КПППлательщика     = СокрЛП(Зачет.kppPayer);
		Стр.Плательщик		   = Справочники.Контрагенты.НайтиКонтрагента(Стр.ЕККПлательщика, Стр.ИННПлательщика, Стр.КПППлательщика);
		Стр.ДоговорПлательщика = НайтиДоговор(Стр.Плательщик);
		Стр.ЕККПолучателя      = Зачет.ekkReceiver;
		Стр.ИННПолучателя      = СокрЛП(Зачет.innReceiver);
		Стр.КПППолучателя      = СокрЛП(Зачет.kppReceiver);
		Стр.Получатель		   = Справочники.Контрагенты.НайтиКонтрагента(Стр.ЕККПолучателя, Стр.ИННПолучателя, Стр.КПППолучателя);
		Стр.ДоговорПолучателя  = НайтиДоговор(Стр.Получатель);
		Стр.Сумма       	   = Зачет.sum; 
		Стр.Комментарий		   = "№" + Формат(Зачет.id, "ЧГ=0") + " " + СокрЛП(Зачет.comment);
		Стр.Статус			   = СокрЛП(Зачет.status); 
		Стр.Взаимозачет		   = НайтиДокументВзаимозачетЗадолженности(Зачет.id);
		
	КонецЦикла; 
	
КонецПроцедуры

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Процедура СоздатьДокументы(Зачеты, РегламентноеЗадание = Ложь) Экспорт
	
	ОрганизацияКЦДляВеденияУУ = КонстантаОрганизацияКЦДляВеденияУУ(); 
	Если Не ЗначениеЗаполнено(ОрганизацияКЦДляВеденияУУ) Тогда
		ОбщегоНазначения.СообщитьПользователю("Заполните константу ""Организация КЦ для ведения упр. учета."""); 
		Возврат;
	КонецЕсли;  
	
	Для Сч = 0 По Зачеты.Количество() - 1 Цикл 
		
		Стр = Зачеты[Сч];
		
		НеНужноСоздаватьДокумент = ЗначениеЗаполнено(Стр.Взаимозачет)
			Или ЗначениеЗаполнено(НайтиДокументВзаимозачетЗадолженности(Стр.НомерЗачета))
			Или Не Стр.РезультатПроверки
			Или Не Стр.Пометка;
			
		Если НеНужноСоздаватьДокумент Тогда	
			Продолжить;
		КонецЕсли; 
		
		Попытка
			Стр.Взаимозачет = СоздатьДокументВзаимозачетЗадолженности(Стр, ОрганизацияКЦДляВеденияУУ);
			ПередатьДанныеВзаимозачетаНаПортал(Стр.НомерЗачета, Стр.Статус);    
			
			Если РегламентноеЗадание Тогда
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, Стр.Взаимозачет,
					"Успешно создан и передан на Портал документ ""Взаимозачет задолженности""(Номер зачета " 
				    + Формат(Стр.НомерЗачета, "ЧГ=0") + ")"); 
			Иначе
				
				ОбщегоНазначения.СообщитьПользователю("Успешно создан и передан на Портал документ ""Взаимозачет задолженности""(Номер зачета " 
					+ Формат(Стр.НомерЗачета, "ЧГ=0") + ")", Стр.Взаимозачет);   
				
			КонецЕсли;
			
		Исключение
			Если ЗначениеЗаполнено(Стр.Взаимозачет) Тогда
				ДокументОбъект = Стр.Взаимозачет.ПолучитьОбъект();
				ДокументОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
			Стр.Взаимозачет = Неопределено;
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если РегламентноеЗадание Тогда
				
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
					"Ошибка создания документа ""Взаимозачет задолженности""(Номер зачета " 
					+ Формат(Стр.НомерЗачета, "ЧГ=0") + "): " + ТекстОшибки); 
			Иначе   
				
				ОбщегоНазначения.СообщитьПользователю("Ошибка создания документа ""Взаимозачет задолженности""(Номер зачета " 
					+ Формат(Стр.НомерЗачета, "ЧГ=0") + "): " + ТекстОшибки);  
			КонецЕсли;
				
			Продолжить;
		КонецПопытки;  
		
	КонецЦикла;
		
КонецПроцедуры

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция НайтиДоговор(Контрагент) Экспорт 
	
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ВидВзиморасчетовРасчеты = Константы.тн_ВидВзаиморасчетовРасчеты.Получить();
	НаименованиеДоговора = Константы.тн_НаименованиеДоговораДляЗагрузкиДанныхСПортала.Получить();
	
	Если НЕ ЗначениеЗаполнено(Контрагент) 
		ИЛИ НЕ ЗначениеЗаполнено(ВидВзиморасчетовРасчеты) 
		ИЛИ НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		Возврат Договор;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.тн_ВидВзаиморасчетовРасчеты КАК тн_ВидВзаиморасчетовРасчеты
		|		ПО ДоговорыКонтрагентов.тн_ВидВзаиморасчетов = тн_ВидВзаиморасчетовРасчеты.Значение
		|ГДЕ
		|	ДоговорыКонтрагентов.Контрагент = &Контрагент
		|	И ДоговорыКонтрагентов.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	Запрос.УстановитьПараметр("Наименование", НаименованиеДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоДоговоров	= Выборка.Количество();
	
	Если КоличествоДоговоров = 1 Тогда
		Выборка.Следующий();
		Договор = Выборка.Ссылка;
	ИначеЕсли КоличествоДоговоров = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Для контрагента """ + Контрагент + """ не найден договор с видом взаиморасчетов " 
			+ ВидВзиморасчетовРасчеты + " и наименованием " + НаименованиеДоговора + ".");
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Для контрагента """ + Контрагент + """ найдено более одного договора с видом взаиморасчетов """ + ВидВзиморасчетовРасчеты + """.");
	КонецЕсли; 
	
	Возврат Договор; 
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Процедура ПроверитьЗаполнениеРеквизитов(Зачеты) Экспорт   
		
	Для Сч = 0 По Зачеты.Количество() - 1 Цикл
		Стр = Зачеты[Сч]; 
	
		Если Не Стр.Пометка Тогда
			Продолжить;
		КонецЕсли; 
		
		Результат = Истина;
		Результат = ЗначениеЗаполнено(Стр.ДатаЗачета) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Плательщик) И Результат;
		Результат = ЗначениеЗаполнено(Стр.ДоговорПлательщика) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Получатель) И Результат;
		Результат = ЗначениеЗаполнено(Стр.ДоговорПолучателя) И Результат;
		Результат = ЗначениеЗаполнено(Стр.Сумма) И Результат;
		
		Стр.РезультатПроверки 	= Результат;    
		
		Если Не Результат Тогда
		
				ЗаписьЖурналаРегистрации("Фоновое задание. Загрузка зачетов и взаиморасчетов с Портала (тн)",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.РегламентныеЗадания.тн_ЗагрузкаЗачетовВзаиморасчетовСПортала, ,
					"Для создания документа" + Стр.НомерЗачета + "  недостаточно данных");  
					
		КонецЕсли;
				
	КонецЦикла;
		
КонецПроцедуры

