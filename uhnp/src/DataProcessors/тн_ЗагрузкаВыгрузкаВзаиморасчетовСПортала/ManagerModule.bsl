// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция СоздатьДокументВзаимозачетЗадолженности(Параметры, ОрганизацияКЦДляВеденияУУ) 

	//Шапка
	ДокументВзаимозачет = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	ДокументВзаимозачет.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный; 
	ДокументВзаимозачет.Организация = ОрганизацияКЦДляВеденияУУ;
	ДокументВзаимозачет.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументВзаимозачет.Ответственный = Пользователи.ТекущийПользователь();
	ДокументВзаимозачет.Дата = Параметры.ДатаЗачета;
	ДокументВзаимозачет.Комментарий	= Строка(Параметры.Комментарий) + " ID: " + Формат(Параметры.НомерЗачета, "ЧГ=0");
	ДокументВзаимозачет.тн_ИдентификаторВзаимозачетаНаПортале = Параметры.НомерЗачета;
	ДокументВзаимозачет.тн_НеОтражатьВРегУчете = Истина; 
	ДокументВзаимозачет.КонтрагентДебитор  = Параметры.Получатель;
	ДокументВзаимозачет.КонтрагентКредитор = Параметры.Плательщик;   
	ДокументВзаимозачет.ТипДебитора = ОпределитьТипУчастниковВзаимозачета(Параметры.ДоговорПолучателя);
	ДокументВзаимозачет.ТипКредитора = ОпределитьТипУчастниковВзаимозачета(Параметры.ДоговорПлательщика); 
	ДокументВзаимозачет.СуммаДокумента = Параметры.Сумма;
	ДокументВзаимозачет.СуммаРегл = Параметры.Сумма; 
	ДокументВзаимозачет.СуммаУпр = Параметры.Сумма; 
	
	//ТЧ Дебиторская задолженность
	СтрокаТЧ = ДокументВзаимозачет.ДебиторскаяЗадолженность.Добавить();
	СтрокаТЧ.ТипРасчетов = ОпределитьТипРасчетовСПартнерами(ДокументВзаимозачет.ТипДебитора);
	СтрокаТЧ.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(ДокументВзаимозачет.КонтрагентДебитор);
	СтрокаТЧ.Организация = ОрганизацияКЦДляВеденияУУ;
	СтрокаТЧ.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Параметры.ДоговорПолучателя);  
	СтрокаТЧ.ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДоговорПолучателя, "ВалютаВзаиморасчетов"); 
	СтрокаТЧ.СуммаВзаиморасчетов = Параметры.Сумма; 
	СтрокаТЧ.СуммаРегл = Параметры.Сумма; 
	СтрокаТЧ.СуммаУпр = Параметры.Сумма; 
	
	//ТЧ Кредиторская задолженность 
	СтрокаТЧ = ДокументВзаимозачет.КредиторскаяЗадолженность.Добавить();
	СтрокаТЧ.ТипРасчетов = ОпределитьТипРасчетовСПартнерами(ДокументВзаимозачет.ТипКредитора);
	СтрокаТЧ.Партнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(ДокументВзаимозачет.КонтрагентКредитор);
	СтрокаТЧ.Организация = ОрганизацияКЦДляВеденияУУ;  
	СтрокаТЧ.ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Параметры.ДоговорПлательщика);
	СтрокаТЧ.ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДоговорПлательщика, "ВалютаВзаиморасчетов");
	СтрокаТЧ.СуммаВзаиморасчетов = Параметры.Сумма; 
	СтрокаТЧ.СуммаРегл = Параметры.Сумма; 
	СтрокаТЧ.СуммаУпр = Параметры.Сумма;
	
	ДокументВзаимозачет.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ДокументВзаимозачет.Ссылка;  
	
КонецФункции 

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция ОпределитьТипУчастниковВзаимозачета(Договор) 
	
	ТипДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговора");
	СоответствиеТипаДоговораИТипаУчастника = Новый Соответствие;
	СоответствиеТипаДоговораИТипаУчастника.Вставить(Перечисления.ТипыДоговоров.СПоставщиком, Перечисления.ТипыУчастниковВзаимозачета.Поставщик);
	СоответствиеТипаДоговораИТипаУчастника.Вставить(Перечисления.ТипыДоговоров.СПокупателем, Перечисления.ТипыУчастниковВзаимозачета.Клиент);
	
	ТипУчастника = СоответствиеТипаДоговораИТипаУчастника.Получить(ТипДоговора);
	Если ТипУчастника = Неопределено Тогда
		ТипУчастника = Перечисления.ТипыУчастниковВзаимозачета.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ТипУчастника;
	
КонецФункции

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Функция ОпределитьТипРасчетовСПартнерами(ТипУчастниковВзаимозачета) 
	
	СоответствиеТипаУчастниковИТипаРасчетов = Новый Соответствие;
	СоответствиеТипаУчастниковИТипаРасчетов.Вставить(Перечисления.ТипыУчастниковВзаимозачета.Поставщик, Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком);
	СоответствиеТипаУчастниковИТипаРасчетов.Вставить(Перечисления.ТипыУчастниковВзаимозачета.Клиент, Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом);
	
	ТипРасчетов = СоответствиеТипаУчастниковИТипаРасчетов.Получить(ТипУчастниковВзаимозачета);
	Если ТипРасчетов = Неопределено Тогда
		ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ТипРасчетов;
	
КонецФункции		

// Юдина Екатерина 06.10.2025 Выполнение задач №000055378
//
Процедура ПередатьДанныеВзаимозачетаНаПортал(ИдентификаторВзаимозачета, СтатусВзаимозачета) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	//1. Формируем и отправляем сообщение-запрос 
	ПараметрыСообщения = ПараметрыСообщения(); 
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(ПараметрыСообщения, Истина, ИдентификаторВзаимозачета, СтатусВзаимозачета);
	ТекстСообщения = СформироватьТекстСообщенияЗапросДанных(ПараметрыСообщения, ОбъектXDTO_ЗапросДанных); 
	
	ОтправитьСообщениеЗапрос(ПараметрыСообщения);  
	
	ДобавитьЗаписьЗапросыRabbitMQ(ПараметрыСообщения);
	
	//2. Ожидаем ответа   в той же транзакции
	РезультатЗапросаДанных = тн_ИнтеграцияFinAppPortal.РезультатЗапросаДанныхСПортала(ПараметрыСообщения);  
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапросаДанных.ЕстьОшибки Тогда
		ВызватьИсключение (РезультатЗапросаДанных.ТекстОшибки);
	КонецЕсли;
		
