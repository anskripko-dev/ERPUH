&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для каждого стр из Метаданные.Документы Цикл
		СписокОбъектовМетаданных.Добавить(стр.Имя,стр.Синоним,Истина,);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьДокументы(Команда)
	ОтобратьДокументыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтобратьДокументыНаСервере() 
	
	Сч = 0;	
	ТекстЗапроса = "";
	Для каждого стр из СписокОбъектовМетаданных Цикл
		
		Если ТипЗнч(ШаблонТрансляций) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок")
			И ЗначениеЗаполнено(ШаблонТрансляций.ДокументБД)
			И ШаблонТрансляций.ДокументБД.Наименование <> стр.Значение
			Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если  стр.Пометка Тогда
			Если Сч = 0 Тогда
				ТекстЗапроса  =
				" ВЫБРАТЬ
				|    Д.ССылка КАК Ссылка,
				|    Д.Организация КАК Организация
				| ПОМЕСТИТЬ Т
				| ИЗ 
				|   Документ." + стр.Значение + " КАК Д 
				| ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Д1 И &Д2
				|//@//И Организация В (&Организация)
				|//@К//И ЕстьNULL(Д.Контрагент, Неопределено) В (&Контрагент)
				|";
				
			Иначе
				
				ТекстЗапроса  = ТекстЗапроса + Символы.ВК + 
				" ОБЪЕДИНИТЬ ВСЕ
				|
				| ВЫБРАТЬ
				|    Д.ССылка,
				|    Д.Организация КАК Организация
				| ИЗ 
				|   Документ." + стр.Значение + " КАК Д 
				| ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Д1 И &Д2
				|//@//И Организация В (&Организация)
				|//@К//И ЕстьNULL(Д.Контрагент, Неопределено) В (&Контрагент)
				|";
			КонецЕсли;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла; 
	
	
	ТекстЗапроса  = ТекстЗапроса + Символы.ВК + 
	" ;
	| ВЫБРАТЬ
	| Ложь КАК Пометка,
	| Т.Ссылка, 
	| Т.Организация
	//| ,Р.Трансляция
	| ИЗ 
	|   Т КАК Т
	|    ЛЕВОЕ СОЕДИНЕНИЕ
	|       РегистрСведений.ОтражениеДокументовПоШаблонам КАК Р
	|       ПО Т.Ссылка = Р.ИсходныйДокумент
	|       	И Р.ШаблонОперации В (&ШаблонТрансляций)
	| ГДЕ 
	|     Р.ДокументПервогоОтражения IS NULL
	|     ИЛИ (Р.ДокументПервогоОтражения = ЗНАЧЕНИЕ(Документ.Трансляция.ПустаяСсылка) ИЛИ Р.ДокументПервогоОтражения = ЗНАЧЕНИЕ(Документ.ТрансформационнаяКорректировка.ПустаяСсылка))
	|";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Д1",Период.ДатаНачала); 
	Запрос.УстановитьПараметр("Д2",Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ШаблонТрансляций",ШаблонТрансляций.ВыгрузитьЗначения());
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"//@//","");
		Запрос.УстановитьПараметр("Организация",Организация.ВыгрузитьЗначения());
	КонецЕсли;	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"//@К//","");
		Запрос.УстановитьПараметр("Контрагент",Контрагент.ВыгрузитьЗначения());
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса; 
	РЕЗ = Запрос.Выполнить().Выгрузить();
	ОтобранныеДокументы.Загрузить(РЕЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаписиВРегистрОтраженияДокументовПоШаблонам(Команда)
	СоздатьЗаписиВРегистрОтраженияДокументовПоШаблонамНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаписиВРегистрОтраженияДокументовПоШаблонамНаСервере() 
	
	Сч = 0;
	Для каждого стр из ОтобранныеДокументы Цикл
		Если стр.Пометка Тогда
			
			ИмяДокумента = стр.Ссылка.Метаданные().Имя;

			Для каждого элШаблон из ШаблонТрансляций Цикл
				Шаблон = элШаблон.Значение;
				
				Если ТипЗнч(Шаблон) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") Тогда
					ДокументБД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шаблон, "ДокументБД");
					Если ЗначениеЗаполнено(ДокументБД) Тогда
						ИмяОбъектаМетаданных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБД, "ИмяОбъектаМетаданных");
						Если ИмяОбъектаМетаданных <> ИмяДокумента Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				Набор = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
				Набор.Отбор.ИсходныйДокумент.Установить(стр.Ссылка);
				//Набор.Отбор.ШаблонОперации.Установить(ШаблонТрансляций);
				Набор.Отбор.ШаблонОперации.Установить(Шаблон);
				Набор.Прочитать();
				
				Если Набор.Количество() = 0 Тогда
					МенеджерЗап = Набор.Добавить();
				Иначе
					МенеджерЗап = Набор[0];
				КонецЕсли;
				
				//МенеджерЗап = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьМенеджерЗаписи();
				МенеджерЗап.ИсходныйДокумент             = стр.Ссылка;
				МенеджерЗап.Организация                  = стр.Организация;       //стр.Ссылка.Организация;
				МенеджерЗап.Сценарий                     = Сценарий;             //Справочники.Сценарии.НайтиПоНаименованию("факт"); 
				МенеджерЗап.ОбработкаВыполнена           = Перечисления.ДаНет.нет;
				//МенеджерЗап.ШаблонОперации               = ШаблонТрансляций;     //Справочники.ШаблоныТрансляций.НайтиПоНаименованию("Регистр бухгалтерии - регистр бухгалтерии",истина);
				МенеджерЗап.ШаблонОперации               = Шаблон;     //Справочники.ШаблоныТрансляций.НайтиПоНаименованию("Регистр бухгалтерии - регистр бухгалтерии",истина);
				Если ТипЗнч(Шаблон) = Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок") Тогда
					МенеджерЗап.Трансляция               = Ложь;
				Иначе                             
					МенеджерЗап.Трансляция               = Истина;
				КонецЕсли;

				МенеджерЗап.Период                       = стр.Ссылка.Дата;
				МенеджерЗап.ПериодОтражения              = ЗначениеПериода;      //Справочники.Периоды.НайтиПоНаименованию("Декабрь 2021 г.",истина);
				МенеджерЗап.ПериодОтбора                 = ЗначениеПериода;      //Справочники.Периоды.НайтиПоНаименованию("Декабрь 2021 г.",истина);
				МенеджерЗап.УчетнаяПолитика              = УчетнаяПолитикаМСФО;  //Документы.УчетнаяПолитикаМСФО.НайтиПоНомеру("0004",дата(2020,1,1));
				МенеджерЗап.ДатаЗаписиДоЗакрытияПериода  = ТекущаяДатаСеанса();
				
				Попытка
					//МенеджерЗап.Записать(Истина);
					Набор.Записать(Истина);
				Исключение
					ОбщегоНазначения.СообщитьПользователю("Запись с документом "+стр.Ссылка+" не записана "+Описаниеошибки());
				КонецПопытки;
				Сч = Сч+1;
				//Если Сч = 1 Тогда
				//	Прервать;
				//КонецЕсли;
			
			КонецЦикла;
		
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьВсе(Команда)
	ПометитьВсеНаСервере();
КонецПроцедуры 

Процедура ПометитьВсеНаСервере()
	Для каждого стр из ОтобранныеДокументы Цикл
		стр.Пометка = истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиВсе(Команда)
	СнятьПометкиВсеНаСервере();
КонецПроцедуры 

Процедура СнятьПометкиВсеНаСервере()
	Для каждого стр из ОтобранныеДокументы Цикл
		стр.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

