&НаКлиенте
Процедура УдалитьБитыеСсылкиТрансляции(Команда)
	УдалитьБитыеСсылкиТрансляцииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьБитыеСсылкиТрансляцииНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТТ1.ДокументПервогоОтражения КАК ДокументПервогоОтражения,
	|	ТТ1.ИсходныйДокумент КАК ИсходныйДокумент
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ТТ1
	|ГДЕ
	|	((НЕ ТТ1.ДокументПервогоОтражения = НЕОПРЕДЕЛЕНО
	|	И НЕ ТТ1.ДокументПервогоОтражения В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					Документ.Трансляция КАК ВТ)
	|	И НЕ ТТ1.ДокументПервогоОтражения = ЗНАЧЕНИЕ(Документ.Трансляция.ПустаяСсылка)
	|	И НЕ ТТ1.ДокументПервогоОтражения В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					Документ.ТрансформационнаяКорректировка КАК ВТ)
	|	И НЕ ТТ1.ДокументПервогоОтражения = ЗНАЧЕНИЕ(Документ.ТрансформационнаяКорректировка.ПустаяСсылка))
	| ИЛИ (ТТ1.ДокументПервогоОтражения = ЗНАЧЕНИЕ(Документ.Трансляция.ПустаяСсылка) И  
	| ТТ1.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)))
	//| И ТТ1.Трансляция
	|";
	
	Выб = Запрос.Выполнить().Выбрать(); 
	Сч = 0; СчИсправленных = 0;
	Пока Выб.Следующий() Цикл 
		Записать = Ложь;	
		Набор = РегистрыСведений.ОтражениеДокументовПоШаблонам.СоздатьНаборЗаписей();
		Набор.Отбор.ИсходныйДокумент.Установить(Выб.ИсходныйДокумент);
		Набор.Прочитать();
		Для каждого стр из Набор Цикл 
			
			Если СтрНайти(Строка(стр.ДокументПервогоОтражения),"Объект не найден" , НаправлениеПоиска.СНачала,1,1) > 0 Тогда
				стр.ДокументПервогоОтражения = Документы.Трансляция.ПустаяСсылка();
				стр.ОбработкаВыполнена           = Перечисления.ДаНет.нет;
				Записать = Истина; 
			ИначеЕсли НЕ ЗначениеЗаполнено(стр.ДокументПервогоОтражения) И НЕ ЗначениеЗаполнено(стр.ДокументПоследнегоОтражения) 
				И стр.ОбработкаВыполнена = Перечисления.ДаНет.да И стр.Трансляция Тогда
				стр.ОбработкаВыполнена           = Перечисления.ДаНет.нет;
				Записать = Истина; 
			КонецЕсли;	
			Сч = Сч+1;
			//Если Сч=1 Тогда
			//	Прервать;
			//КонецЕсли;	
		КонецЦикла;	
		
		Если Записать Тогда 
			Попытка
				Набор.Записать(истина); 
				СчИсправленных = СчИсправленных +1;	
			Исключение
				ОбщегоНазначения.СообщитьПользователю("Запись при документе "+Выб.ИсходныйДокумент+" НЕ исправлена "+ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла; 
	ОбщегоНазначения.СообщитьПользователю("Исправлено записей -"+СчИсправленных);
КонецПроцедуры


