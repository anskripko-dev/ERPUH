// Белоконенко Денис 15.07.2024 Выполнение задач №000050219
&НаСервере
Процедура ЗагрузитьИзменениеПараметровНаСервере(АдресХранилища)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);

	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата(); 
	ТекущаяДата = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов), ДатаДокументов, ТекущаяДата);
		
	УправленческаяОрганизация = Справочники.Организации.УправленческаяОрганизация;
	// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
	//СтруктураЗаполнения = Новый Структура("Дата, ЭтоОС, Организация, Подразделение, СтатьяРасходов",
	СтруктураЗаполнения = Новый Структура("Дата, ЭтоОС, Организация, Подразделение, СтатьяРасходов, ОтражатьВБУ, ОтражатьВНУ, ОтражатьВРеглУчете, ОтражатьВУпрУчете",
	// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383
			Дата);
			
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	// НАЧАЛО Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052552
	Если ОтсутствуютОбязательныеКолонкиВФайле(ТаблицаЗначений) Тогда
		Возврат;
	КонецЕсли;
	// КОНЕЦ Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052552
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр.ОбъектУчета) Тогда
			Продолжить;
		КонецЕсли;			
		
		// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
		ОтраженВБУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВБУ, "Булево");
		ОтраженВНУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВНУ, "Булево");
		ОтраженВУУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВУУ, "Булево");
		
		Если Не ОтраженВБУ И Не ОтраженВНУ Тогда
			ОтражатьВРеглУчете = Ложь;
		Иначе
			ОтражатьВРеглУчете = Истина;			
		КонецЕсли;
		
		СтруктураЗаполнения.ОтражатьВБУ			= ОтраженВБУ;
		СтруктураЗаполнения.ОтражатьВНУ			= ОтраженВНУ;
		СтруктураЗаполнения.ОтражатьВРеглУчете 	= ОтражатьВРеглУчете;
		СтруктураЗаполнения.ОтражатьВУпрУчете 	= ОтраженВУУ;
		// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383	
		
		ЭтоОС = Стр.ЭтоОС = "Да";
		
		Если ЗначениеЗаполнено(Стр.Организация) Тогда
			Организация = ПреобразоватьЗначениеИзСтроки(Стр.Организация, "Справочник", "Организации");
		Иначе
			Организация = УправленческаяОрганизация;
		КонецЕсли;		
		СтруктураЗаполнения.Организация = Организация;
		
		Подразделение 	= ПреобразоватьЗначениеИзСтроки(Стр.Подразделение, "Справочник", "СтруктураПредприятия");
		Если СокрЛП(Стр.КодСтатьиЕРП_УХ) = "" Тогда
			СтатьяРасходов = СтатьяРасходовПоУмолчанию;
		Иначе
			СтатьяРасходов = ТН_Интеграция_ERP_УХ.СтатьяРасходовПоКоду(СокрЛП(Стр.КодСтатьиЕРП_УХ)); 
		КонецЕсли;
		СтруктураЗаполнения.Подразделение 	= Подразделение;
		СтруктураЗаполнения.СтатьяРасходов 	= СтатьяРасходов; 
		СтруктураЗаполнения.ЭтоОС 			= ЭтоОС;
		
		//Поиск объекта учета 
		Если ЭтоОС Тогда
			ОбъектУчета = ПреобразоватьЗначениеИзСтроки(Стр.ОбъектУчета, "Справочник", "ОбъектыЭксплуатации");	
		Иначе
			ОбъектУчета = ПреобразоватьЗначениеИзСтроки(Стр.ОбъектУчета, "Справочник", "НематериальныеАктивы");		
		КонецЕсли;
		
		//Проверка на пустую ссылку или объект не найден
		Если ОбъектУчета.Пустая()
			Или ОбъектУчета.ПолучитьОбъект() = Неопределено Тогда 
			ОбщегоНазначения.СообщитьПользователю("Не найден ОбъектУчета по гуиду " + Стр.ОбъектУчета);
			Продолжить;	
		КонецЕсли;		
		
		//Поиск документа
		НайденыДокументы = ТаблицаДокументов.НайтиСтроки(СтруктураЗаполнения);
		Если НайденыДокументы.Количество() = 0 Тогда
			
			Если ЭтоОС Тогда
				ДокументОбъект 	= Документы.ИзменениеПараметровОС2_4.СоздатьДокумент();
				ДокументОбъект.ОтражениеАмортизационныхРасходовФлаг = Истина;
				
				СтрокаТЧ_ОС 		 = ДокументОбъект.ОС.Добавить();
				СтрокаТЧ_Амортизация = ДокументОбъект.Амортизация.Добавить();
			Иначе
				ДокументОбъект 	= Документы.ИзменениеПараметровНМА2_4.СоздатьДокумент();
				// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
				ДокументОбъект.ОтражениеАмортизационныхРасходовФлаг = Истина;
				// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383
				
				СтрокаТЧ_ОС 		 = ДокументОбъект.НМА.Добавить();
				СтрокаТЧ_Амортизация = ДокументОбъект.Амортизация.Добавить();
			КонецЕсли;	
			
			ТекДокСтр = ТаблицаДокументов.Добавить();
			ТекДокСтр.ДокументОбъект = ДокументОбъект;
			ЗаполнитьЗначенияСвойств(ТекДокСтр, СтруктураЗаполнения);
			
		Иначе
			ТекДокСтр = НайденыДокументы[0];
			ДокументОбъект = ТекДокСтр.ДокументОбъект;
			Если ЭтоОС Тогда				
				СтрокаТЧ_ОС 		 = ДокументОбъект.ОС.Добавить();
				СтрокаТЧ_Амортизация = ДокументОбъект.Амортизация[0];
			Иначе
				СтрокаТЧ_ОС 		 = ДокументОбъект.НМА.Добавить();
				СтрокаТЧ_Амортизация = ДокументОбъект.Амортизация[0];
			КонецЕсли;
		КонецЕсли; 
		
		// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
		//ДокументОбъект.ОтражатьВУпрУчете 	= Истина;
		//ДокументОбъект.ОтражатьВРеглУчете 	= Истина;
		//ДокументОбъект.ОтражатьВБУ          = Истина;
		// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383
		ДокументОбъект.СуммаКоэффициентовАмортизации = 1;
		Комментарий = "#Перенос СпособыОтраженияРасходовПоАмортизации ОС и НМА: " + ТекущаяДата;
		ДокументОбъект.Комментарий = Комментарий;
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураЗаполнения);
		
		//Заполнение табличной части
		
		// ТЧ ОС
		Если ЭтоОС Тогда
			СтрокаТЧ_ОС.ОсновноеСредство 	= ОбъектУчета;	
		Иначе
			СтрокаТЧ_ОС.НематериальныйАктив = ОбъектУчета;		
		КонецЕсли; 	
		
		// ТЧ Амортизация				
		СтрокаТЧ_Амортизация.Подразделение = СтруктураЗаполнения.Подразделение;
		СтрокаТЧ_Амортизация.СтатьяРасходов = СтруктураЗаполнения.СтатьяРасходов;
		СтрокаТЧ_Амортизация.АналитикаРасходов = СтруктураЗаполнения.Подразделение;
		СтрокаТЧ_Амортизация.ПередаватьРасходыВДругуюОрганизацию = Ложь;
		СтрокаТЧ_Амортизация.Коэффициент = 1; 
				
	КонецЦикла;
		
	Для Каждого ТекДокСтр Из ТаблицаДокументов Цикл
		ДокументОбъект = ТекДокСтр.ДокументОбъект;
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
		КонецПопытки;
	КонецЦикла;
		
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ТаблицаДокументов.Количество());
	

КонецПроцедуры

// Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052552
&НаСервере
Функция ОтсутствуютОбязательныеКолонкиВФайле(ТаблицаЗначений)
	
	Колонки = ТаблицаЗначений.Колонки;
	
	Если КолонкаОтсутствует(Колонки, "ОбъектУчета") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если КолонкаОтсутствует(Колонки, "ЭтоОС") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если КолонкаОтсутствует(Колонки, "Организация") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если КолонкаОтсутствует(Колонки, "Подразделение") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если КолонкаОтсутствует(Колонки, "КодСтатьиЕРП_УХ") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // ОтсутствуютОбязательныеКолонкиВФайле()

// Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052552
&НаСервере
Функция КолонкаОтсутствует(Колонки, ИмяКолонки)
	
	Если Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В файле отсутствует колонка ""%1"".", ИмяКолонки));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // КолонкаОтсутствует()

// Белоконенко Денис 15.07.2024 Выполнение задач №000050219
&НаКлиенте
Процедура ЗагрузитьИзменениеПараметров(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	
	ЗагрузитьИзменениеПараметровНаСервере(АдресХранилища);
КонецПроцедуры

// Белоконенко Денис 11.04.2025 Выполнение задач №000053383
&НаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыПоСпособуРасходов(СтрокаТаблицы)   
	
	// БУ
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПоСпособуОтраженияРасходов(
		СтрокаТаблицы.СпособОтраженияРасходовБУ, 
		СтрокаТаблицы.СтатьяРасходовБУ, 
		СтрокаТаблицы.АналитикаРасходовБУ, 
		СтрокаТаблицы.ПодразделениеБУ, 
		СтрокаТаблицы.НаправлениеДеятельностиБУ, 
		СтрокаТаблицы.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчетаБУ);
		
	// УУ
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПоСпособуОтраженияРасходов(
		СтрокаТаблицы.СпособОтраженияРасходовУУ, 
		СтрокаТаблицы.СтатьяРасходовУУ, 
		СтрокаТаблицы.АналитикаРасходовУУ, 
		СтрокаТаблицы.ПодразделениеУУ, 
		СтрокаТаблицы.НаправлениеДеятельностиУУ, 
		СтрокаТаблицы.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчетаУУ);
		
	// НУ
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПоСпособуОтраженияРасходов(
		СтрокаТаблицы.СпособОтраженияРасходовНУ, 
		СтрокаТаблицы.СтатьяРасходовНУ, 
		СтрокаТаблицы.АналитикаРасходовНУ, 
		СтрокаТаблицы.ПодразделениеНУ, 
		СтрокаТаблицы.НаправлениеДеятельностиНУ, 
		СтрокаТаблицы.ПодразделениеИНаправлениеДеятельностиСовпадаютСДаннымиУчетаНУ);		
		
КонецПроцедуры