&НаСервереБезКонтекста
Функция ПолучитьГруппуФинансовогоУчета(Наименование, ВидАктива)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыФинансовогоУчетаВнеоборотныхАктивов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыФинансовогоУчетаВнеоборотныхАктивов КАК ГруппыФинансовогоУчетаВнеоборотныхАктивов
		|ГДЕ
		|	ГруппыФинансовогоУчетаВнеоборотныхАктивов.Наименование ПОДОБНО &Наименование
		|	И ГруппыФинансовогоУчетаВнеоборотныхАктивов.ВидАктива = &ВидАктива";
	
	Запрос.УстановитьПараметр("ВидАктива", ВидАктива);
	Запрос.УстановитьПараметр("Наименование", Наименование + "%");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьЗначениеИзСтроки(СтрЗначение, Тип="Число", Вид="")

	Если ПустаяСтрока(СтрЗначение) И Не Тип="Булево"Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	// НАЧАЛО Белоконенко Денис 13.10.2025 Выполнение задач №000055468
	Попытка
	// КОНЕЦ Белоконенко Денис 13.10.2025 Выполнение задач №000055468
		Если Тип = "Дата" Тогда
			Результат = Дата(СтрЗначение);	
		ИначеЕсли Тип = "Число" Тогда
			Результат = Число(СтрЗаменить(СтрЗначение, " ", ""));
		ИначеЕсли Тип = "Булево" Тогда
			Результат = СтрЗначение = "Да" ИЛИ СтрЗначение = "Истина" ИЛИ СтрЗначение = "+" ИЛИ СтрЗначение = "1";
		ИначеЕсли Тип = "Перечисление" Тогда
			Результат = Перечисления[Вид][СтрЗначение];
		ИначеЕсли Тип = "Справочник" Тогда
			Результат = Справочники[Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗначение));
		Иначе
			Результат = СтрЗначение;
		КонецЕсли;
	// НАЧАЛО Белоконенко Денис 13.10.2025 Выполнение задач №000055468
	Исключение
	 	Возврат Неопределено;
	КонецПопытки;
	// КОНЕЦ Белоконенко Денис 13.10.2025 Выполнение задач №000055468		
		
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбъектУчета(СтрДанные, ЭтоОС)
	
	Результат = Неопределено;
	
	Если ЭтоОС Тогда
		Результат = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчета, "Справочник", "ОбъектыЭксплуатации");	
	Иначе
		Результат = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчета, "Справочник", "НематериальныеАктивы");		
	КонецЕсли;
	
	//Проверка на пустую ссылку или объект не найден
	Если Не (Результат.Пустая()
		ИЛИ Результат.ПолучитьОбъект() = Неопределено) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Если ЭтоОС Тогда
		НовОбъектУчета = Справочники.ОбъектыЭксплуатации.СоздатьЭлемент();
		НовОбъектУчета.УстановитьСсылкуНового(Результат);
		НовОбъектУчета.Код = СокрЛП(СтрДанные.ОбъектУчетаКод);
		НовОбъектУчета.ИнвентарныйНомер = НовОбъектУчета.Код;
		НовОбъектУчета.Наименование = СтрДанные.ОбъектУчетаНаименование;
		НовОбъектУчета.Изготовитель = СтрДанные.ОбъектУчетаИзготовитель;
		НовОбъектУчета.НомерПаспорта = СтрДанные.ОбъектУчетаНомерПаспорта;
		НовОбъектУчета.ЗаводскойНомер = СтрДанные.ОбъектУчетаЗаводскойНомер;
		НовОбъектУчета.ДатаВыпуска = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчетаДатаВыпуска, "Дата"); 		
		
		//КодПоОКОФ
		Если Не ПустаяСтрока(СтрДанные.ОбъектУчетаКодПоОКОФ) Тогда
			НовОбъектУчета.КодПоОКОФ = Справочники.ОбщероссийскийКлассификаторОсновныхФондов.НайтиПоКоду(СокрЛП(СтрДанные.ОбъектУчетаКодПоОКОФ));
		КонецЕсли;
		
		// НАЧАЛО Белоконенко Денис 15.07.2024 Выполнение задач №000050219
		////АмортизационнаяГруппа
		//// НАЧАЛО Белоконенко Денис 08.09.2023 Выполнение задач №000046788
		////НовОбъектУчета.АмортизационнаяГруппа = ПреобразоватьЗначениеИзСтроки(
		////		СтрДанные.ОбъектУчетаАмортизационнаяГруппа, "Перечисление", "АмортизационныеГруппы");
		//НовОбъектУчета.УдалитьАмортизационнаяГруппа = ПреобразоватьЗначениеИзСтроки(
		//		СтрДанные.ОбъектУчетаАмортизационнаяГруппа, "Перечисление", "АмортизационныеГруппы");
		//// КОНЕЦ Белоконенко Денис 08.09.2023 Выполнение задач №000046788
		// КОНЕЦ Белоконенко Денис 15.07.2024 Выполнение задач №000050219
				
		//ГруппаОС
		ГруппаОС = СтрДанные.ОбъектУчетаГруппаОС;
		//ПередаточныеУстройства, МалоценныеНеоборотныеМА, БиблиотечныеФонды в ДругиеВидыОсновныхСредств. 
		//ДвижимыеЗдания - Здания, ДвижимыеСооружения - Сооружения
		
		// НАЧАЛО Белоконенко Денис 15.07.2024 Выполнение задач №000050219
		//Если ГруппаОС = "Здания" или ГруппаОС = "Сооружения" Тогда
		//	НовОбъектУчета.НедвижимоеИмущество = Истина;
		//КонецЕсли;
		//
		//Если ГруппаОС = "ПередаточныеУстройства" или ГруппаОС = "МалоценныеНеоборотныеМА" или ГруппаОС = "БиблиотечныеФонды" Тогда
		//	НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.ДругиеВидыОсновныхСредств;			
		//ИначеЕсли ГруппаОС = "ДвижимыеЗдания" Тогда
		//	НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.Здания;
		//	НовОбъектУчета.НедвижимоеИмущество = Ложь;		
		//ИначеЕсли ГруппаОС = "ДвижимыеСооружения" Тогда
		//	НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.Сооружения;
		//	НовОбъектУчета.НедвижимоеИмущество = Ложь;
		
		Если ГруппаОС = "ПередаточныеУстройства" или ГруппаОС = "МалоценныеНеоборотныеМА" или ГруппаОС = "БиблиотечныеФонды" Тогда
			НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.ДругиеВидыОсновныхСредств;			
		ИначеЕсли ГруппаОС = "ДвижимыеЗдания" Тогда
			НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.Здания;		
		ИначеЕсли ГруппаОС = "ДвижимыеСооружения" Тогда
			НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.Сооружения; 		
		// КОНЕЦ Белоконенко Денис 15.07.2024 Выполнение задач №000050219	
		Иначе
			Попытка
				НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС[ГруппаОС];
			Исключение
				НовОбъектУчета.ГруппаОС = Перечисления.ГруппыОС.ДругиеВидыОсновныхСредств;
			КонецПопытки 			
		КонецЕсли;
	Иначе
		НовОбъектУчета = Справочники.НематериальныеАктивы.СоздатьЭлемент();
		НовОбъектУчета.УстановитьСсылкуНового(Результат);
		НовОбъектУчета.Код = СокрЛП(СтрДанные.ОбъектУчетаКод);
		НовОбъектУчета.Наименование = СтрДанные.ОбъектУчетаНаименование;
		НовОбъектУчета.АмортизационнаяГруппа = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчетаАмортизационнаяГруппа, 
					"Перечисление", "АмортизационныеГруппы");
		НовОбъектУчета.ВидНМА = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчетаВидНМА, "Перечисление", "ВидыНМА");
		НовОбъектУчета.ВидОбъектаУчета = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчетаВидОбъектаУчета, 
					"Перечисление", "ВидыОбъектовУчетаНМА"); 
	КонецЕсли;
	
	Попытка
		НовОбъектУчета.Записать();
	Исключение
		НовОбъектУчета.ОбменДанными.Загрузка = Истина;
		НовОбъектУчета.Записать();
	КонецПопытки;
	
	//Результат = НовОбъектУчета.Ссылка;

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры

// Белоконенко Денис 04.12.2023 Выполнение задач №000047710
&НаСервере
Процедура ПерезаписатьИнвентарныеНомераНаСервере(АдресХранилища)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);
	
	ДокументОбъект = Неопределено;
	ЭтоОС = Неопределено;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата();   
	ТекущаяДата = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	Комментарий = "#Перенос остатков ОС и НМА "+ТекущаяДата;		
	УправленческаяОрганизация = Справочники.Организации.УправленческаяОрганизация;
	ГруппаФинансовогоУчетаОС = ПолучитьГруппуФинансовогоУчета("ОС", Перечисления.ВидыВнеоборотныхАктивов.ОсновноеСредство);
	ГруппаФинансовогоУчетаНМА = ПолучитьГруппуФинансовогоУчета("НМА", Перечисления.ВидыВнеоборотныхАктивов.НМА);
	ГруппаФинансовогоУчетаНИКОР = ПолучитьГруппуФинансовогоУчета("НИКОР", Перечисления.ВидыВнеоборотныхАктивов.НИОКР);
	СтруктураЗаполнения = Новый Структура("Организация, Местонахождение, ОтражатьВБУиНУ, ОтражатьВУУ, ХозяйственнаяОперация, Комментарий, Завершен",
			,,,,,Комментарий, Ложь);
			
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр.ОбъектУчета) Тогда
			Продолжить;
		КонецЕсли;	
		
		//Заполняются основные реквизиты для определения документа
		ЭтоОС = Стр.ЭтоОС = "Да";
					
		ПерезаписатьОбъектУчета(Стр, ЭтоОС);
				
	КонецЦикла;
				
	ОбщегоНазначения.СообщитьПользователю("Запись завершена");
КонецПроцедуры

// Белоконенко Денис 04.12.2023 Выполнение задач №000047710
&НаСервереБезКонтекста
Процедура ПерезаписатьОбъектУчета(СтрДанные, ЭтоОС)
	
	Результат = Неопределено;
	
	Если ЭтоОС Тогда
		Результат = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчета, "Справочник", "ОбъектыЭксплуатации");	
	Иначе
		Результат = ПреобразоватьЗначениеИзСтроки(СтрДанные.ОбъектУчета, "Справочник", "НематериальныеАктивы");		
	КонецЕсли;
	
	//Проверка на пустую ссылку или объект не найден
	Если (Результат.Пустая()
		ИЛИ Результат.ПолучитьОбъект() = Неопределено) Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЭтоОС Тогда
		
		НовОбъектУчета = Результат.ПолучитьОбъект();
		НовОбъектУчета.Код = СокрЛП(СтрДанные.ОбъектУчетаКод);
		НовОбъектУчета.ИнвентарныйНомер = СокрЛП(СтрДанные.ОбъектУчетаКод);
		
		Попытка
			НовОбъектУчета.Записать();
		Исключение
			НовОбъектУчета.ОбменДанными.Загрузка = Истина;
			НовОбъектУчета.Записать(); 
			
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
		
КонецПроцедуры


// Белоконенко Денис 04.12.2023 Выполнение задач №000047710
