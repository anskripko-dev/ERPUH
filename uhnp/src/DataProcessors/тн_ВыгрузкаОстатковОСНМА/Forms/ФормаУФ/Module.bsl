//&НаСервереБезКонтекста
&НаСервере
Процедура ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);
	
	ДокументОбъект = Неопределено;
	ЭтоОС = Неопределено;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата(); 
	ТекущаяДата = ТекущаяДатаСервера(); 
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	// НАЧАЛО Белоконенко Денис 15.07.2024 Выполнение задач №000050219
	//Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов), ДатаДокументов, ТекущаяДата);
	// КОНЕЦ Белоконенко Денис 15.07.2024 Выполнение задач №000050219
	Комментарий = "#Перенос остатков ОС и НМА "+ТекущаяДата;		
	УправленческаяОрганизация = Справочники.Организации.УправленческаяОрганизация;
	ГруппаФинансовогоУчетаОС = ПолучитьГруппуФинансовогоУчета("ОС", Перечисления.ВидыВнеоборотныхАктивов.ОсновноеСредство);
	ГруппаФинансовогоУчетаНМА = ПолучитьГруппуФинансовогоУчета("НМА", Перечисления.ВидыВнеоборотныхАктивов.НМА);
	ГруппаФинансовогоУчетаНИКОР = ПолучитьГруппуФинансовогоУчета("НИКОР", Перечисления.ВидыВнеоборотныхАктивов.НИОКР);
	// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
	//СтруктураЗаполнения = Новый Структура("Организация, Местонахождение, ОтражатьВБУиНУ, ОтражатьВУУ, ХозяйственнаяОперация, Комментарий, Завершен",
	//		,,,,,Комментарий, Ложь); 
	СтруктураЗаполнения = Новый Структура(
		"Организация, Местонахождение, ОтражатьВБУиНУ, ОтражатьВРеглУчете, ОтражатьВУУ, ОтражатьВУпрУчете, ОтражатьВБУ, ОтражатьВНУ, ХозяйственнаяОперация, тн_ОперацияМСФО, Комментарий, Завершен",
			,,,,,,,,,,Комментарий, Ложь);	
	// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383
			
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОбъект");
	Для Каждого КлючИЗначение Из СтруктураЗаполнения Цикл
		ТаблицаДокументов.Колонки.Добавить(КлючИЗначение.Ключ);	
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр.ОбъектУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		//Если здесь нули или минусовые значения, в документ ничего заполнить не удастся - пропускаем
		ТекущаяСтоимостьБУ = ПреобразоватьЗначениеИзСтроки(Стр.ТекущаяСтоимостьБУ);
		ТекущаяСтоимостьНУ = ПреобразоватьЗначениеИзСтроки(Стр.ТекущаяСтоимостьНУ);
		ТекущаяСтоимостьУУ = ПреобразоватьЗначениеИзСтроки(Стр.ТекущаяСтоимостьУУ);
				
		Если ТекущаяСтоимостьБУ<= 0 
			И ТекущаяСтоимостьНУ <= 0
			И ТекущаяСтоимостьУУ <= 0 Тогда
			Продолжить;
		КонецЕсли; 			
		
		//Заполняются основные реквизиты для определения документа
		ЭтоОС = Стр.ЭтоОС = "Да";
		Если ЭтоОС Тогда
			СтруктураЗаполнения.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковОсновныхСредств; 
		Иначе
			СтруктураЗаполнения.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковНМАиРасходовНаНИОКР;			
		КонецЕсли;
		
		// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383
		//Если ПустаяСтрока(Стр.НачислятьАмортизациюБУ)
		//	 И ПустаяСтрока(Стр.НачислятьАмортизациюНУ) Тогда
		//	ОтражатьВБУиНУ = Ложь;
		//	ОтражатьВРеглУчете = Ложь;
		//	//ОтражатьВОперативномУчете = Ложь;
		//Иначе
		//	ОтражатьВБУиНУ = Истина;
		//	ОтражатьВРеглУчете = Истина;
		//	//ОтражатьВОперативномУчете = Истина;
		//КонецЕсли;
		//Если ПустаяСтрока(Стр.НачислятьАмортизациюУУ) Тогда
		//	ОтражатьВУУ = Ложь;
		//	ОтражатьВУпрУчете = Ложь;
		//	//ОтражатьВОперативномУчете = Ложь;
		//Иначе
		//	ОтражатьВУУ = Истина;
		//	ОтражатьВУпрУчете = Истина;
		//	//ОтражатьВОперативномУчете = Истина;
		//КонецЕсли;  
		
		СтруктураЗаполнения.тн_ОперацияМСФО = ПреобразоватьЗначениеИзСтроки(Стр.ОперацияМСФО, "Перечисление", "тн_ОперацияМСФО");
		
		ОтраженВБУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВБУ, "Булево");
		ОтраженВНУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВНУ, "Булево");
		ОтраженВУУ = ПреобразоватьЗначениеИзСтроки(Стр.ОтраженВУУ, "Булево");
		
		Если Не ОтраженВБУ И Не ОтраженВНУ Тогда
			ОтражатьВБУиНУ = Ложь;
			ОтражатьВРеглУчете = Ложь;
		Иначе
			ОтражатьВБУиНУ = Истина;
			ОтражатьВРеглУчете = Истина;			
		КонецЕсли;  
				
		ОтражатьВУпрУчете 	= ОтраженВУУ;
		ОтражатьВУУ 		= ОтраженВУУ;
		
		СтруктураЗаполнения.ОтражатьВБУ			= ОтраженВБУ;
		СтруктураЗаполнения.ОтражатьВНУ			= ОтраженВНУ;
		СтруктураЗаполнения.ОтражатьВРеглУчете 	= ОтражатьВРеглУчете;
		СтруктураЗаполнения.ОтражатьВУпрУчете 	= ОтражатьВУпрУчете;
		// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383		
		СтруктураЗаполнения.ОтражатьВБУиНУ = ОтражатьВБУиНУ;
		СтруктураЗаполнения.ОтражатьВУУ = ОтражатьВУУ;
		
		Если ЗначениеЗаполнено(Стр.Организация) Тогда
			Организация = ПреобразоватьЗначениеИзСтроки(Стр.Организация, "Справочник", "Организации");
		Иначе
			Организация = УправленческаяОрганизация;
		КонецЕсли;		
		СтруктураЗаполнения.Организация = Организация;
		ПодразделениеБУ = ПреобразоватьЗначениеИзСтроки(Стр.ПодразделениеБУ, "Справочник", "СтруктураПредприятия");
		ПодразделениеУУ = ПреобразоватьЗначениеИзСтроки(Стр.ПодразделениеУУ, "Справочник", "СтруктураПредприятия");
		СтатьяПодразделениеБУ = ПреобразоватьЗначениеИзСтроки(Стр.СтатьяПодразделениеБУ, "Справочник", "СтруктураПредприятия");
		СтатьяПодразделениеУУ = ПреобразоватьЗначениеИзСтроки(Стр.СтатьяПодразделениеУУ, "Справочник", "СтруктураПредприятия");
		// НАЧАЛО Белоконенко Денис 08.09.2023 Выполнение задач №000046788
		//СтруктураЗаполнения.Местонахождение = ?(ЗначениеЗаполнено(ПодразделениеУУ), ПодразделениеУУ, ПодразделениеБУ);
		Если Стр.ЭтоБазаПП Тогда
			СтруктураЗаполнения.Местонахождение = ПодразделениеБУ;
		Иначе
			СтруктураЗаполнения.Местонахождение = ?(ЗначениеЗаполнено(ПодразделениеУУ), ПодразделениеУУ, ПодразделениеБУ);
		КонецЕсли;	
		// КОНЕЦ Белоконенко Денис 08.09.2023 Выполнение задач №000046788
		// НАЧАЛО Белоконенко Денис 15.07.2024 Выполнение задач №000050219
		ПодразделениеСлужебноеУУ = ПреобразоватьЗначениеИзСтроки(Стр.ПодразделениеСлужебное, "Справочник", "СтруктураПредприятия");
		Если ПриоритетУУ Тогда
			СтруктураЗаполнения.Местонахождение =  ?(ЗначениеЗаполнено(ПодразделениеУУ), ПодразделениеУУ, ПодразделениеСлужебноеУУ);	
		КонецЕсли;
		// КОНЕЦ Белоконенко Денис 15.07.2024 Выполнение задач №000050219
		
		//поиск документа
		НайденыДокументы = ТаблицаДокументов.НайтиСтроки(СтруктураЗаполнения);
		Если НайденыДокументы.Количество() = 0 Тогда
			ДокументОбъект = Документы.ВводОстатковВнеоборотныхАктивов2_4.СоздатьДокумент();
			ДокументОбъект.Заполнить(Новый Структура("Дата, Местонахождение, ХозяйственнаяОперация",
						Дата, СтруктураЗаполнения.Местонахождение, СтруктураЗаполнения.ХозяйственнаяОперация));
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураЗаполнения);
			ДокументОбъект.ОтражатьВОперативномУчете = Истина; //ОтражатьВУУ;
			ДокументОбъект.ОтражатьВРеглУчете = ОтражатьВБУиНУ;
			ДокументОбъект.ОтражатьВУпрУчете = ОтражатьВУУ;
			ТекДокСтр = ТаблицаДокументов.Добавить();
			ТекДокСтр.ДокументОбъект = ДокументОбъект;
			ЗаполнитьЗначенияСвойств(ТекДокСтр, СтруктураЗаполнения);
		Иначе
			ТекДокСтр = НайденыДокументы[0];
			ДокументОбъект = ТекДокСтр.ДокументОбъект;
		КонецЕсли;
		
		//Заполнение табличной части
		
		//Поиск объекта учета
		ОбъектУчета = ПолучитьОбъектУчета(Стр, ЭтоОС);
		
		НачислятьАмортизациюБУ = ПреобразоватьЗначениеИзСтроки(Стр.НачислятьАмортизациюБУ, "Булево");
		НачислятьАмортизациюНУ = ПреобразоватьЗначениеИзСтроки(Стр.НачислятьАмортизациюНУ, "Булево");
		НачислятьАмортизациюУУ = ПреобразоватьЗначениеИзСтроки(Стр.НачислятьАмортизациюУУ, "Булево");

		Если ЭтоОС Тогда
			НовСтр = ДокументОбъект.ОС.Добавить();
			НовСтр.ОсновноеСредство = ОбъектУчета;
			// НАЧАЛО Белоконенко Денис 20.11.2023 Выполнение задач №000046788
			НовСтр.ВариантРаздельногоУчетаНДС 	= Перечисления.ВариантыРаздельногоУчетаНДС.ИзДокумента; 
			НовСтр.НалогообложениеНДС			= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			// КОНЕЦ Белоконенко Денис 20.11.2023 Выполнение задач №000046788
			НовСтр.Подразделение = СтруктураЗаполнения.Местонахождение;			
			// НАЧАЛО Белоконенко Денис 16.05.2025 Выполнение задач №000053714
			//МОЛБУ = ПреобразоватьЗначениеИзСтроки(Стр.МОЛБУ, "Справочник", "ФизическиеЛица");
			//МОЛУУ = ПреобразоватьЗначениеИзСтроки(Стр.МОЛУУ, "Справочник", "ФизическиеЛица");			
			МОЛБУ = Справочники.ФизическиеЛица.ПолучитьФизЛицоСсылка(Стр.МОЛ_ЕКС_БУ);
			МОЛУУ = Справочники.ФизическиеЛица.ПолучитьФизЛицоСсылка(Стр.МОЛ_ЕКС_УУ);			
			// КОНЕЦ Белоконенко Денис 16.05.2025 Выполнение задач №000053714
			НовСтр.МОЛ = ?(ЗначениеЗаполнено(МОЛБУ), МОЛБУ, МОЛУУ);
			НовСтр.МетодНачисленияАмортизацииБУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииБУ, "Перечисление", "СпособыНачисленияАмортизацииОС");
			НовСтр.МетодНачисленияАмортизацииУУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииУУ, "Перечисление", "СпособыНачисленияАмортизацииОС");
			Если НачислятьАмортизациюБУ Тогда
				НовСтр.ПорядокУчетаБУ = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации;
			Иначе
				НовСтр.ПорядокУчетаБУ = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается;	
			КонецЕсли;
			НовСтр.ПорядокУчетаНУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииНУ, "Перечисление", "ПорядокВключенияСтоимостиОСВСоставРасходовНУ");			
			
			Если Не ЗначениеЗаполнено(НовСтр.ПорядокУчетаНУ) Тогда
				Если НачислятьАмортизациюНУ Тогда
					НовСтр.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации;
				Иначе
					НовСтр.ПорядокУчетаНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы;	
				КонецЕсли;
			КонецЕсли;
			Если НачислятьАмортизациюУУ Тогда
				НовСтр.ПорядокУчетаУУ = Перечисления.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию;
			Иначе
				НовСтр.ПорядокУчетаУУ = Перечисления.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеНачислятьАмортизацию;	
			КонецЕсли;
			// НАЧАЛО Белоконенко Денис 08.09.2023 Выполнение задач №000046788
			НовСтр.АмортизационнаяГруппа = ПреобразоватьЗначениеИзСтроки(
					Стр.ОбъектУчетаАмортизационнаяГруппа, "Перечисление", "АмортизационныеГруппы");
			// КОНЕЦ Белоконенко Денис 08.09.2023 Выполнение задач №000046788 
			// НАЧАЛО Белоконенко Денис 15.07.2024 Выполнение задач №000050219
			НовСтр.НачислятьАмортизациюБУ = НачислятьАмортизациюБУ;
			НовСтр.НачислятьАмортизациюНУ = НачислятьАмортизациюНУ;
			НовСтр.НачислятьАмортизациюУУ = НачислятьАмортизациюУУ;
			
			ГруппаОС = Стр.ОбъектУчетаГруппаОС;
			
			Если ГруппаОС = "Здания" или ГруппаОС = "Сооружения" Тогда
				НовСтр.НедвижимоеИмущество = Истина;
			Иначе
				НовСтр.НедвижимоеИмущество = Ложь;
			КонецЕсли;	
			// КОНЕЦ Белоконенко Денис 15.07.2024 Выполнение задач №000050219			
		Иначе
			НовСтр = ДокументОбъект.НМА.Добавить();
			НовСтр.НематериальныйАктив = ОбъектУчета; 
			// НАЧАЛО Белоконенко Денис 11.04.2025 Выполнение задач №000053383  		
			НовСтр.ВариантРаздельногоУчетаНДС 	= Перечисления.ВариантыРаздельногоУчетаНДС.ИзДокумента; 
			НовСтр.НалогообложениеНДС			= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			// КОНЕЦ Белоконенко Денис 11.04.2025 Выполнение задач №000053383			
			ДатаПриобретенияБУ = ПреобразоватьЗначениеИзСтроки(Стр.ДатаПриобретенияБУ, "Дата");
			ДатаПриобретенияУУ = ПреобразоватьЗначениеИзСтроки(Стр.ДатаПриобретенияУУ, "Дата");
			НовСтр.ДатаПриобретения = ?(ЗначениеЗаполнено(ДатаПриобретенияБУ), ДатаПриобретенияБУ, ДатаПриобретенияУУ); 
			НовСтр.МетодНачисленияАмортизацииБУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииБУ, "Перечисление", "СпособыНачисленияАмортизацииНМА");
			НовСтр.МетодНачисленияАмортизацииУУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииУУ, "Перечисление", "СпособыНачисленияАмортизацииНМА");
			НовСтр.МетодНачисленияАмортизацииНУ = ПреобразоватьЗначениеИзСтроки(Стр.МетодНачисленияАмортизацииБУ, "Перечисление", "МетодыНачисленияАмортизации");
			Если НачислятьАмортизациюБУ Тогда
