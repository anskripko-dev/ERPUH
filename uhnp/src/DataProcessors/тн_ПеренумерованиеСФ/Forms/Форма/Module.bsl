&НаСервере
Процедура ОтобратьСФНаСервере()
	
	Объект.СФ.Очистить();
	// НАЧАЛО Егоров Петр 22.05.2023 Выполнение задач №000045546
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("Обработка_тн_тн_ПеренумерованиеСФ_ОтобратьСФ");
	// КОНЕЦ  Егоров Петр 22.05.2023 Выполнение задач №000045546
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК СФ,
		//НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		//|	СчетФактураВыданный.Дата КАК Дата
		|	СчетФактураВыданный.Дата КАК Дата,
		|	СчетФактураВыданный.Номер КАК Номер,
		|	СчетФактураВыданный.Исправление КАК Исправление,
		|	СчетФактураВыданный.Организация КАК Организация
        //КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		//НАЧАЛО Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		| ПОМЕСТИТЬ ВТ
		//КОНЕЦ Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		//НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|ГДЕ
		|	НЕ СчетФактураВыданный.ПометкаУдаления 
		// НАЧАЛО Егоров Петр 14.12.2023 Выполнение задач №000047833
		| И НЕ СчетФактураВыданный.Исправление
		// КОНЕЦ  Егоров Петр 14.12.2023 Выполнение задач №000047833
		|	И СчетФактураВыданный.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураВыданный.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &НомерНеСодержитТН
		|               ТОГДА СТРНАЙТИ(СчетФактураВыданный.Номер, ""ТН"")= 0
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйАванс.Ссылка,
		|	СчетФактураВыданныйАванс.Дата,
		|	СчетФактураВыданныйАванс.Номер,
		|	СчетФактураВыданныйАванс.Исправление,
		|	СчетФактураВыданныйАванс.Организация
		|ИЗ
		|	Документ.СчетФактураВыданныйАванс КАК СчетФактураВыданныйАванс
		|ГДЕ
		|	НЕ СчетФактураВыданныйАванс.ПометкаУдаления
		// НАЧАЛО Егоров Петр 14.12.2023 Выполнение задач №000047833
		| И НЕ СчетФактураВыданныйАванс.Исправление
		// КОНЕЦ  Егоров Петр 14.12.2023 Выполнение задач №000047833
		|	И СчетФактураВыданныйАванс.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураВыданныйАванс.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &НомерНеСодержитТН
		|               ТОГДА СТРНАЙТИ(СчетФактураВыданныйАванс.Номер, ""ТН"")=0
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураНалоговыйАгент.Ссылка,
		|	СчетФактураНалоговыйАгент.Дата,
		|	СчетФактураНалоговыйАгент.Номер,
		|	ЛОЖЬ,
		|	СчетФактураНалоговыйАгент.Организация
		|ИЗ
		|	Документ.СчетФактураНалоговыйАгент КАК СчетФактураНалоговыйАгент
		|ГДЕ
		|	НЕ СчетФактураНалоговыйАгент.ПометкаУдаления
		|	И СчетФактураНалоговыйАгент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураНалоговыйАгент.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &НомерНеСодержитТН
	    |               ТОГДА СТРНАЙТИ(СчетФактураНалоговыйАгент.Номер, ""ТН"")=0
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ 
		//НАЧАЛО Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		|;
		|/////////////////////////////////////////////////
		| ВЫБРАТЬ
		|	ВТ.СФ,
		|	ВТ.Дата,
		|	ВТ.Номер,
		|	ВТ.Исправление,
		|	ВТ.Организация
		|УПОРЯДОЧИТЬ ПО
		|	НАЧАЛОПЕРИОДА(ВТ.Дата, ДЕНЬ),ВТ.Номер 
        //КОНЕЦ Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		|";
        //КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		
	//НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Период.ДатаОкончания));
	//Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	//Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("НомерНеСодержитТН", НомерНеСодержитТН);
	Запрос.УстановитьПараметр("ЕстьОтборПоОрганизациям", Организации.Количество()>0);
    Запрос.УстановитьПараметр("Организации", Организации.ВыгрузитьЗначения());
    //КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592	
		
	Объект.СФ.Загрузить(Запрос.Выполнить().Выгрузить());	
	// НАЧАЛО Егоров Петр 22.05.2023 Выполнение задач №000045546	
		ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера,1);
    // КОНЕЦ  Егоров Петр 22.05.2023 Выполнение задач №000045546
КонецПроцедуры

