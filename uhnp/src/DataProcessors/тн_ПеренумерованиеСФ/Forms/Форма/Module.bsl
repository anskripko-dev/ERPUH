			ОбСФ.ПредставлениеНомера = ПолучитьНомерБезНулей(СтрЗаменить(обСФ.Номер,"ТН",""));     
			// КОНЕЦ Юдина Екатерина 25.12.2024 Выполнение задач №000052157
			КонецЕсли;
	       //КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592

			ОбСФ.ОбменДанными.Загрузка = Истина;
	        //НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
			//обСФ.Записать();
			ОбСФ.Записать(РежимЗаписиДокумента.Запись);
			Поиск = Новый Структура("СФ",ВыборкаДетальныеЗаписи.СФ);
			НайденныеСтроки = Объект.СФ.НайтиСтроки(Поиск); 
			Если НайденныеСтроки <> Неопределено Тогда 
				Для каждого стр Из НайденныеСтроки Цикл
					стр.Номер = ОбСФ.Номер; 
					стр.НайденнныйМаксНомер = ВыборкаДата.Номер;
					стр.СФ = ОбСФ.Ссылка;
				КонецЦикла;	
			КонецЕсли;	
	       //КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
			ТекНомер = ТекНомер + 1;
		КонецЦикла;
	КонецЦикла; 
