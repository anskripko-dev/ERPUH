&НаСервере
Процедура ПеренумероватьСФНаСервере()
	// НАЧАЛО Егоров Петр 22.05.2023 Выполнение задач №000045546
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("Обработка_тн_тн_ПеренумерованиеСФ_ПеренумероватьСФ");
	// КОНЕЦ  Егоров Петр 22.05.2023 Выполнение задач №000045546
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗСФ.СФ КАК СФ,
		|	ТЗСФ.Дата КАК Дата,
	    //НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		 |	ТЗСФ.Отметка КАК Пометка,
		 |	ТЗСФ.Номер КАК Номер,
		//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|	ТЗСФ.Исправление КАК Исправление
		|ПОМЕСТИТЬ ВТ_СФ
		|ИЗ
		|	&ТЗСФ КАК ТЗСФ
		|;
	    //НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		| СчетФактураВыданный.Номер КАК Номер,
		| НАЧАЛОПЕРИОДА(СчетФактураВыданный.Дата, ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ ВТ_МаксНомер 
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ 
		// НАЧАЛО Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		//| СТРНАЙТИ(СчетФактураВыданный.Номер, ""ТН"") > 0  
		| СТРНАЙТИ(СчетФактураВыданный.Номер, ""ТН"") = 1   
		// КОНЕЦ Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		|	И СчетФактураВыданный.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		//НАЧАЛО Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураВыданный.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|		
		| 
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		| СчетФактураВыданныйАванс.Номер КАК Номер,
        | НАЧАЛОПЕРИОДА(СчетФактураВыданныйАванс.Дата, ДЕНЬ) КАК Дата		
		|ИЗ
		|	Документ.СчетФактураВыданныйАванс КАК СчетФактураВыданныйАванс
		|ГДЕ
		|  НЕ СчетФактураВыданныйАванс.ПометкаУдаления
		// НАЧАЛО Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		//| И СТРНАЙТИ(СчетФактураВыданныйАванс.Номер, ""ТН"") > 0  
		| И СТРНАЙТИ(СчетФактураВыданныйАванс.Номер, ""ТН"") = 1   
		// КОНЕЦ Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		|	И СчетФактураВыданныйАванс.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураВыданныйАванс.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|   СчетФактураНалоговыйАгент.Номер,
		|	НАЧАЛОПЕРИОДА(СчетФактураНалоговыйАгент.Дата, ДЕНЬ) КАК Дата
		|ИЗ
		|	Документ.СчетФактураНалоговыйАгент КАК СчетФактураНалоговыйАгент
		|ГДЕ
		|  НЕ СчетФактураНалоговыйАгент.ПометкаУдаления 
		// НАЧАЛО Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		//|  И СТРНАЙТИ(СчетФактураНалоговыйАгент.Номер, ""ТН"") > 0  
		|  И СТРНАЙТИ(СчетФактураНалоговыйАгент.Номер, ""ТН"") = 1   
		// КОНЕЦ Гутарова Екатерина 26.07.2023 Выполнение задач №000046343
		|	И СчетФактураНалоговыйАгент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ЕстьОтборПоОрганизациям
		|				ТОГДА СчетФактураНалоговыйАгент.Организация В (&Организации)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ 
		//|ОБЪЕДИНИТЬ ВСЕ 
		//|
		//|ВЫБРАТЬ
		//|	ВТ_СФ.Номер КАК Номер, 
		//|	НАЧАЛОПЕРИОДА(ВТ_СФ.Дата, ДЕНЬ) КАК Дата
		//|ИЗ
		//|	ВТ_СФ КАК ВТ_СФ 
		//| ГДЕ 
		//|    СТРНАЙТИ(ВТ_СФ.Номер, ""ТН"")=0 
		//КОНЕЦ Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
		|////////////////////////////////////////////////////////////////////////////////
		|;
		|ВЫБРАТЬ 
		|	МАКСИМУМ(ВТ_МаксНомер.Номер) КАК Номер,
		|	ВТ_МаксНомер.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ_МаксНомерПоДате
		|ИЗ
		|	ВТ_МаксНомер КАК ВТ_МаксНомер
		|СГРУППИРОВАТЬ ПО
		|	ВТ_МаксНомер.Дата
		|; 
		|////////////////////////////////////////////////////////////////////////////////
		//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|ВЫБРАТЬ
		|	ВТ_СФ.СФ КАК СФ, 
	    //НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		//|	ЕСТЬNULL(ВТ_МаксНомерПоДате.Номер, ""ТН0000"") КАК Номер,
		|	ЕСТЬNULL(ВТ_МаксНомерПоДате.Номер, ""0000"") КАК Номер, 
		//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|	НАЧАЛОПЕРИОДА(ВТ_СФ.Дата, ДЕНЬ) КАК Дата,
		|	ВТ_СФ.Исправление КАК Исправление
		|ИЗ
		|	ВТ_СФ КАК ВТ_СФ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаксНомерПоДате КАК ВТ_МаксНомерПоДате
		|		ПО (НАЧАЛОПЕРИОДА(ВТ_СФ.Дата, ДЕНЬ) = ВТ_МаксНомерПоДате.Дата)
		| 
	    //НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		| ГДЕ
        |   ВЫБОР 
		|      КОГДА &ТолькоНесодержащиеТН ТОГДА
	    |        СТРНАЙТИ(ВТ_СФ.Номер, ""ТН"")=0
        |      ИНАЧЕ
        |        Истина
        |   КОНЕЦ 
		| И ВТ_СФ.Пометка
		//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_СФ.Дата
		|ИТОГИ
		|	МАКСИМУМ(Номер)
		|ПО
		|	Дата";
	
	ОтборОтмеченных = Новый Структура();
	ОтборОтмеченных.Вставить("Отметка", Истина);
	Запрос.УстановитьПараметр("ТЗСФ", Объект.СФ.Выгрузить(ОтборОтмеченных));
	//НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
	//Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Объект.ДатаНачала));
	//Запрос.УстановитьПараметр("КонецДня", КонецДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("ДатаНачала",           НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания",        КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ТолькоНесодержащиеТН", ПеренумероватьТолькоТеКоторыеНеСодержатТН);
	//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592 
	//НАЧАЛО Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
	Запрос.УстановитьПараметр("ЕстьОтборПоОрганизациям",  ?(Организации.Количество()>0,Истина,Ложь));
	Запрос.УстановитьПараметр("Организации",              Организации.ВыгрузитьЗначения());
	//КОНЕЦ Шабалкина Е.В. 07.03.2023 Выполнение задач №000044683
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДата = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//НАЧАЛО Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592
    НачатьТранзакцию();
	//КОНЕЦ Шабалкина Е.В. 05.12.2022 Выполнение задач №000043592

	Пока ВыборкаДата.Следующий() Цикл
		
		Префикс = "ТН";
		МесяцДата = "";
		Если ИспользоватьПравилаПрефиксаииИзОКС Тогда
			МесяцДата = Формат(Месяц(ВыборкаДата.Дата), "ЧЦ=2; ЧВН=") + Формат(День(ВыборкаДата.Дата), "ЧЦ=2; ЧВН="); 
			//Префикс = Префикс + "00" + ;
		КонецЕсли;
		
		КрайнийНомер = Число(Прав(ВыборкаДата.Номер, 4));
		ТекНомер = КрайнийНомер +1;
		
		ВыборкаДетальныеЗаписи = ВыборкаДата.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			//Для Каждого Строка Из Объект.СФ Цикл
			//	Если НЕ Строка.Отметка 	Тогда
			//		Продолжить;
			//	КонецЕсли;
			
			ОбСФ = ВыборкаДетальныеЗаписи.СФ.ПОлучитьОбъект();
