#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьКомпоновщикНастроек() Экспорт
	
	// Инициализируем компоновщик настроек.
	СхемаКомпоновкиДанных 		= ПолучитьМакет("ВерсииДоговоров");
	
	УстановитьТекстЗапросаНабораДанных(СхемаКомпоновкиДанных);
	
	НастроитьПоляСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
	
	АдресСхемыКомпоновкиДанных 	= ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор);
	
	// Создадим источник.
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьТекстЗапросаНабораДанных(СхемаКомпоновкиДанных)

	ВсеВерсииСоглашений = ВсеВерсииСоглашений();
	
	ЧастиЗапроса = Новый Массив;
	
	Для Каждого ВерсияСоглашения Из ВсеВерсииСоглашений Цикл
		
		ЧастьЗапроса =
		"ВЫБРАТЬ
		|	Документ.Ссылка КАК Ссылка,
		|	Документ.ДоговорКонтрагента.Номер КАК Номер,
		|	Документ.ДоговорКонтрагента.Дата КАК Дата,
		|	Документ.Организация КАК Организация,
		|	Документ.Контрагент КАК Контрагент,
		|	Документ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Документ.ВидДоговораУХ КАК ТекущийВидДоговора,
		|	&НовыйВидДоговора КАК НовыйВидДоговора,
		|	&ИмяДокумента КАК ИмяДокумента,
		|	ЛОЖЬ КАК ЕстьИзменение,
		|	ЛОЖЬ КАК Выбран,
		|	ЛОЖЬ КАК КонвертацияПроизведена,
		|	ДоговорыКонтрагентов.Наименование КАК Наименование,
		|	0 КАК НомерСтроки
		|ИЗ
		|	Документ.ВерсияСоглашенияАккредитив КАК Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО Документ.Ссылка = ДоговорыКонтрагентов.ВерсияСоглашения
		|ГДЕ
		|	ДоговорыКонтрагентов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Документ.Проведен
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
		
		ЧастьЗапроса = СтрЗаменить(ЧастьЗапроса,"ВерсияСоглашенияАккредитив",ВерсияСоглашения.Ключ);
		ЧастьЗапроса = СтрЗаменить(ЧастьЗапроса,"&ИмяДокумента",""""+ВерсияСоглашения.Значение+"""");
		
		ЧастиЗапроса.Добавить(ЧастьЗапроса);
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса,"
											|
											|ОБЪЕДИНИТЬ ВСЕ
											|
											|");
	
	НаборыДанных = НаборДанныхСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
	
	НаборыДанных.Запрос = ТекстЗапроса;
	
КонецПроцедуры

Процедура НастроитьПоляСхемыКомпоновкиДанных(СхемаКомпоновкиДанных)

	НаборыДанных = НаборДанныхСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
	
	ПолеИмяДокумента = НаборыДанных.Поля.Найти("ИмяДокумента");
	
	Если Не ПолеИмяДокумента = Неопределено Тогда
		
		ДоступныеЗначения = ДоступныеЗначенияПоляИмяДокумента();
		ПолеИмяДокумента.УстановитьДоступныеЗначения(ДоступныеЗначения);	
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ДоступныеЗначенияПоляИмяДокумента()

	ДоступныеЗначения = Новый СписокЗначений;
	
	ВсеВерсииСоглашений = ВсеВерсииСоглашений();
	
	Для Каждого ВерсияСоглашения Из ВсеВерсииСоглашений Цикл
		
		ДоступныеЗначения.Добавить(ВерсияСоглашения.Значение);	
		
	КонецЦикла;
	
	Возврат ДоступныеЗначения;
	
КонецФункции // ДоступныеЗначенияПоляИмяДокумента()

Функция ВсеВерсииСоглашений()
	
	ВерсииСоглашений = Новый Соответствие;
	ВерсииСоглашений.Вставить("ВерсияСоглашенияАккредитив",НСтр("ru = 'Версия договора аккредитива'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияБанковскаяГарантия",НСтр("ru = 'Версия договора банковской гарантии'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияВалютноПроцентныйСвоп",НСтр("ru = 'Версия договора процентого, валютно-процентного свопа'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияВалютныйСвоп",НСтр("ru = 'Версия договора валютного свопа'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияВалютныйФорвард",НСтр("ru = 'Версия договора валютного форварда'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияДепозит",НСтр("ru = 'Версия договора депозита, МНО'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияКоммерческийДоговор",НСтр("ru = 'Версия коммерческого договора'"));
	ВерсииСоглашений.Вставить("ВерсияСоглашенияКредит",НСтр("ru = 'Версия договора кредита, займа'"));
	// ЕРПУХ ++
	//ВерсииСоглашений.Вставить("ВерсияСоглашенияЛизинг",НСтр("ru = 'Версия договора лизинга'"));
	// ЕРПУХ --
	
	Возврат ВерсииСоглашений;
	
КонецФункции

Функция НаборДанныхСхемыКомпоновкиДанных(СхемаКомпоновкиДанных)

	Возврат СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1;	

КонецФункции

#КонецОбласти

#Область Инициализация
ИнициализироватьКомпоновщикНастроек();
#КонецОбласти

#КонецЕсли
