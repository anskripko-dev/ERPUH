Процедура ВыполнитьКонвертациюВерсийДоговоров(Параметры,АдресХранилища)Экспорт
	
	ТаблицаДокументов = Параметры.ТаблицаДокументов;
	
	КэшКонвертацииВерсийДоговоров = НовыйКэшКонвертацииВерсийДоговоров();
	
	ПротоколСозданияВерсийДоговоров = НовыйПротоколСозданияВерсийДоговоров();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл     
		
			СоздатьНовуюВерсиюДоговора(СтрокаТаблицы.Ссылка, СтрокаТаблицы.НовыйВидДоговора, КэшКонвертацииВерсийДоговоров, ПротоколСозданияВерсийДоговоров);
		
	КонецЦикла;
	
	ЗаполнитьРезультатВыполнения(ПротоколСозданияВерсийДоговоров);
	
	ПоместитьВоВременноеХранилище(ПротоколСозданияВерсийДоговоров,АдресХранилища);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьРезультатВыполнения(ПротоколСозданияВерсийДоговоров)

	РезультатВыполнения = ПротоколСозданияВерсийДоговоров.РезультатВыполнения;
	Протокол = ПротоколСозданияВерсийДоговоров.Протокол;
	
	РезультатВыполнения.Вставить("ВсегоОшибок",Протокол.Итог("КоличествоОшибок"));
	РезультатВыполнения.Вставить("ВсегоОбъектов",Протокол.Итог("КоличествоОбработанных"));
	РезультатВыполнения.Вставить("ПомеченоНаУдаление",Протокол.Итог("КоличествоПомеченныхНаУдаление"));
	РезультатВыполнения.Вставить("ПропущеноОбъектов",Протокол.Итог("КоличествоПропущенных"));	
	
КонецПроцедуры


Функция ДанныеЗаполненияВерсииДоговора(НоваяВерсияДоговора,
										ТекущаяВерсияДоговора,
										ИмяДокументаТекущаяВерсияДоговора,
										ИмяДокументаНоваяВерсияДоговора,
										КэшКонвертацииВерсийДоговоров,
										НовыйВидДоговора)

	СвойстваЗаполнения = ОдноименныеСвойстваВерсийДоговоров(ИмяДокументаТекущаяВерсияДоговора,
																ИмяДокументаНоваяВерсияДоговора,
																КэшКонвертацииВерсийДоговоров);

	ДанныеЗаполнения = Новый Структура;
	
	Для Каждого СвойствоЗаполнения Из СвойстваЗаполнения Цикл
		ДанныеЗаполнения.Вставить(СвойствоЗаполнения);	
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ДанныеЗаполнения,ТекущаяВерсияДоговора);
	
	ДанныеЗаполнения.Вставить("ВидДоговораУХ",НовыйВидДоговора);
	
	Возврат ДанныеЗаполнения;                                                                                                
	
КонецФункции 

Функция СтрокаПротокола(Протокол,ТекущаяВерсияДоговора)

	НайдСтроки = Протокол.НайтиСтроки(Новый Структура("ТекущаяВерсияДоговора",ТекущаяВерсияДоговора));	
	
	Если НайдСтроки.Количество() Тогда
		Возврат НайдСтроки[0];
	Иначе
		СтрокаПротокола = Протокол.Добавить();
		СтрокаПротокола.ТекущаяВерсияДоговора = ТекущаяВерсияДоговора;
		Возврат СтрокаПротокола;
	КонецЕсли;
	
КонецФункции

Процедура СоздатьНовуюВерсиюДоговора(ТекущаяВерсияДоговора,
									НовыйВидДоговора,
									КэшКонвертацииВерсийДоговоров,
									ПротоколСозданияВерсийДоговоров)

	
	ИмяДокументаТекущаяВерсияДоговора = ИмяДокументаВерсияДоговора(ТекущаяВерсияДоговора);
	ИмяДокументаНоваяВерсияДоговора = УправлениеДоговорамиУХВызовСервераПовтИсп.ПолучитьИмяДокументаПоВидуДоговора(НовыйВидДоговора);

	Если Не ЗначениеЗаполнено(ИмяДокументаНоваяВерсияДоговора) Тогда
		
		ПричинаПропуска = СтрШаблон(НСтр("ru = 'Для вида договора %1 не найдено соответствующее имя документа версии соглашения'"),НовыйВидДоговора);
		ДобавитьПропущенныйДокументВПротокол(ТекущаяВерсияДоговора, ПричинаПропуска, ПротоколСозданияВерсийДоговоров);
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяДокументаНоваяВерсияДоговора) Тогда
		
		ПричинаПропуска = СтрШаблон(НСтр("ru = 'Для вида договора %1 не найдено соответствующее имя документа версии соглашения'"),НовыйВидДоговора);
		ДобавитьПропущенныйДокументВПротокол(ТекущаяВерсияДоговора, ПричинаПропуска, ПротоколСозданияВерсийДоговоров);
		
		Возврат;
		
	КонецЕсли;
	
	ТекущийВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяВерсияДоговора,"ВидДоговораУХ");
	
	ЕстьПроведенныеДокументыПоДоговору = Ложь;
	
	НеобходимаПроверка = ОпределитьНеобходимостьПроверки(ТекущаяВерсияДоговора, ТекущийВидДоговора, НовыйВидДоговора, 
			ЕстьПроведенныеДокументыПоДоговору);

	
	Если НеобходимаПроверка Тогда
		
		Если ЕстьПроведенныеДокументыПоДоговору Тогда
			
			ПричинаПропуска = СтрШаблон(НСтр("ru = 'Существуют документы, проведенные по договору %1.'"),ТекущаяВерсияДоговора);
			ПричинаПропуска = ПричинаПропуска + НСтр("ru = '
					|Реквизит ""Вид операции"" не может быть изменен.'");

			ДобавитьПропущенныйДокументВПротокол(ТекущаяВерсияДоговора, ПричинаПропуска, ПротоколСозданияВерсийДоговоров);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	НеобходимаКонвертация = ТекущийВидДоговора <> НовыйВидДоговора; 
	
	Если НеобходимаКонвертация Тогда

		НоваяВерсияДоговораОбъект = Документы[ИмяДокументаНоваяВерсияДоговора].СоздатьДокумент();
		
	Иначе
		
		Если ТекущийВидДоговора = НовыйВидДоговора Тогда
			ПричинаПропуска = СтрШаблон(НСтр("ru = 'Текущий вид договора %1 равен новому %2'"),ТекущийВидДоговора,НовыйВидДоговора);
			ДобавитьПропущенныйДокументВПротокол(ТекущаяВерсияДоговора, ПричинаПропуска, ПротоколСозданияВерсийДоговоров);
			
			Возврат;
			
		Иначе
		
			НоваяВерсияДоговораОбъект = ТекущаяВерсияДоговора.ПолучитьОбъект();
			НоваяВерсияДоговораОбъект.ВидДоговораУХ = НовыйВидДоговора;
			
		КонецЕсли;
		
	КонецЕсли;

	НачатьТранзакцию();
	
	МожноПродолжатьВыполнениеОпераций = Истина;
	
	Если НеобходимаКонвертация Тогда
		
		РезультатОперации = ОперацияЗаполнениеНовойВерсииДоговора(НоваяВерсияДоговораОбъект,
																	ТекущаяВерсияДоговора,
																	ИмяДокументаТекущаяВерсияДоговора,
																	ИмяДокументаНоваяВерсияДоговора,
																	КэшКонвертацииВерсийДоговоров,
																	ТекущийВидДоговора,
																	НовыйВидДоговора,
																	ПротоколСозданияВерсийДоговоров);
																	
		МожноПродолжатьВыполнениеОпераций = МожноПродолжатьВыполнениеОпераций(РезультатОперации); 
		
	КонецЕсли;
	
	Если МожноПродолжатьВыполнениеОпераций Тогда
		РезультатОперации = ОперацияПроведениеДокумента(ТекущаяВерсияДоговора, НоваяВерсияДоговораОбъект, ПротоколСозданияВерсийДоговоров);
	Иначе
		ОтменитьТранзакцию();
		Возврат;  	
	КонецЕсли;
	
	МожноПродолжатьВыполнениеОпераций = МожноПродолжатьВыполнениеОпераций(РезультатОперации); 

	Если МожноПродолжатьВыполнениеОпераций Тогда
		РезультатОперации = ОперацияПометкаНаУдалениеТекущейВерсииДоговора(ТекущаяВерсияДоговора, ПротоколСозданияВерсийДоговоров);
	Иначе 
		ОтменитьТранзакцию();
		Возврат;   
	КонецЕсли;
	
	МожноПродолжатьВыполнениеОпераций = МожноПродолжатьВыполнениеОпераций(РезультатОперации); 
	
	Если МожноПродолжатьВыполнениеОпераций Тогда
		РезультатОперации = ОперацияЗаменаСсылокТекущейВерсииДоговораНаНовуюВерсиюДоговора(ТекущаяВерсияДоговора, НоваяВерсияДоговораОбъект.Ссылка, ПротоколСозданияВерсийДоговоров);
	Иначе 
		ОтменитьТранзакцию();
		Возврат;                                          
	КонецЕсли;			
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Функция МожноПродолжатьВыполнениеОпераций(РезультатОперации)

	Возврат Не РезультатОперации.ЕстьОшибка; 

КонецФункции

Функция ОперацияЗаполнениеНовойВерсииДоговора(НоваяВерсияДоговора,
															ТекущаяВерсияДоговора,
															ИмяДокументаТекущаяВерсияДоговора,
															ИмяДокументаНоваяВерсияДоговора,
															КэшКонвертацииВерсийДоговоров,
															ТекущийВидДоговора,
															НовыйВидДоговора,
															ПротоколСозданияВерсийДоговоров)

	РезультатОперации = НовыйРезультатВыполненияОперации();
	
	ДанныеЗаполнения = ДанныеЗаполненияВерсииДоговора(НоваяВерсияДоговора,
															ТекущаяВерсияДоговора,
															ИмяДокументаТекущаяВерсияДоговора,
															ИмяДокументаНоваяВерсияДоговора,
															КэшКонвертацииВерсийДоговоров,
															НовыйВидДоговора);														
	Попытка
																													
		НоваяВерсияДоговора.Заполнить(ДанныеЗаполнения);
		
		ЗаполнитьГрафикРасчетовВНовойВерсииДоговора(ТекущаяВерсияДоговора,
													НоваяВерсияДоговора,
													ИмяДокументаТекущаяВерсияДоговора,
													ИмяДокументаНоваяВерсияДоговора,
													ТекущийВидДоговора,
													НовыйВидДоговора);
	Исключение
		РезультатОперации.ЕстьОшибка = Истина;
		ДобавитьОшибкуВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора, "ЗаполнениеДокумента", ОписаниеОшибки());
	КонецПопытки;
	
	ДобавитьОбработанныйОбъектВПротокол(ТекущаяВерсияДоговора, НоваяВерсияДоговора.Ссылка, ПротоколСозданияВерсийДоговоров);
	
	Возврат РезультатОперации;

КонецФункции


Функция ОперацияПроведениеДокумента(ТекущаяВерсияДоговора, НоваяВерсияДоговораОбъект, ПротоколСозданияВерсийДоговоров)

	РезультатОперации = НовыйРезультатВыполненияОперации();
	
	Попытка
		НоваяВерсияДоговораОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		РезультатОперации.ЕстьОшибка = Истина;
		ДобавитьОшибкуВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора, "ПроведениеДокумента", ОписаниеОшибки());
	КонецПопытки;
	
	ДобавитьОбработанныйОбъектВПротокол(ТекущаяВерсияДоговора, НоваяВерсияДоговораОбъект.Ссылка, ПротоколСозданияВерсийДоговоров);
	
	Возврат РезультатОперации;

КонецФункции // ОперацияПроведениеДокумента()

Функция ОперацияПометкаНаУдалениеТекущейВерсииДоговора(ТекущаяВерсияДоговора, ПротоколСозданияВерсийДоговоров)

	РезультатОперации = НовыйРезультатВыполненияОперации();

	Попытка
		ДокументОбъект = ТекущаяВерсияДоговора.ПолучитьОбъект();	
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ДобавитьПомеченныйНаУдалениеДокументВПротокол(ПротоколСозданияВерсийДоговоров,ТекущаяВерсияДоговора); 
	Исключение
		РезультатОперации.ЕстьОшибка = Истина;
		ДобавитьОшибкуВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора, "ПометкаУдаления", ОписаниеОшибки());
	КонецПопытки;

	Возврат РезультатОперации;
	
КонецФункции

Функция ОперацияЗаменаСсылокТекущейВерсииДоговораНаНовуюВерсиюДоговора(ТекущаяВерсияДоговора, НоваяВерсияДоговора, ПротоколСозданияВерсийДоговоров)

	РезультатОперации = НовыйРезультатВыполненияОперации();
	
	Попытка
		ПарыЗамен = Новый Соответствие;
		ПарыЗамен.Вставить(ТекущаяВерсияДоговора,НоваяВерсияДоговора);
		ОбщегоНазначения.ЗаменитьСсылки(ПарыЗамен,);
	Исключение
		РезультатОперации.ЕстьОшибка = Истина;
		ДобавитьОшибкуВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора, "ЗаменаСсылок", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат РезультатОперации;

КонецФункции

Функция НовыйРезультатВыполненияОперации()
	
	РезультатОперации = Новый Структура;
	РезультатОперации.Вставить("ЕстьОшибка", Ложь);
	
	Возврат РезультатОперации;
	
КонецФункции

Функция ИмяДокументаВерсияДоговора(ВерсияДоговора)

	Возврат ВерсияДоговора.Метаданные().Имя;

КонецФункции 

Процедура ЗаполнитьГрафикРасчетовВНовойВерсииДоговора(ТекущаяВерсияДоговора,
													НоваяВерсияДоговора,
													ИмяДокументаТекущаяВерсияДоговора,
													ИмяДокументаНоваяВерсияДоговора,
													ТекущийВидДоговора,
													НовыйВидДоговора)

	ОписаниеГрафикаТекущаяВерсияДоговора = Документы[ИмяДокументаТекущаяВерсияДоговора].ОписаниеГрафика(ТекущийВидДоговора);
	ОписаниеГрафикаНоваяВерсияДоговора = Документы[ИмяДокументаНоваяВерсияДоговора].ОписаниеГрафика(НовыйВидДоговора);

	Если ОписаниеГрафикаТекущаяВерсияДоговора = Неопределено Или ОписаниеГрафикаНоваяВерсияДоговора = Неопределено  Тогда
		Возврат;
	КонецЕсли;
	
	НоваяВерсияДоговора.ГрафикРасчетов.Очистить();
	Для каждого СекцияТекущегоГрафика Из ОписаниеГрафикаТекущаяВерсияДоговора Цикл
		СекцияНовогоГрафика = Неопределено;
		
		Если ОписаниеГрафикаНоваяВерсияДоговора.Свойство(СекцияТекущегоГрафика.Ключ,СекцияНовогоГрафика) Тогда

			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("ЭлементСтруктурыЗадолженности",СекцияТекущегоГрафика.Значение.ЭлементСтруктурыЗадолженности);
			НайдСтроки = ТекущаяВерсияДоговора.ГрафикРасчетов.НайтиСтроки(ОтборСтрок);
			
			ОперацииГрафика = РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафикаНоваяВерсияДоговора, НоваяВерсияДоговора);
			
			Для Каждого ТекущаяСтрокаГрафика Из НайдСтроки Цикл
				НоваяСтрокаГрафика = НоваяВерсияДоговора.ГрафикРасчетов.Добавить();	
				
				Если ФинансовыеИнструментыУХ.ЭтоСтрокаПриходнойКолонкиГрафика(НоваяСтрокаГрафика) Тогда
					НоваяСтрокаГрафика.ОперацияГрафика = СекцияНовогоГрафика.КолонкаПриходОперация;	
				Иначе
					НоваяСтрокаГрафика.ОперацияГрафика = СекцияНовогоГрафика.КолонкаРасходОперация;	
				КонецЕсли;
				
				ОперацияГрафика = ОперацииГрафика[НоваяСтрокаГрафика.ОперацияГрафика];
				
				Если Не ОперацияГрафика = Неопределено Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрокаГрафика, ОперацияГрафика);
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаГрафика, ТекущаяСтрокаГрафика,"Дата,ИдентификаторПозицииГрафика,Проект,
																				|РучнаяКорректировка,Сумма,СуммаКорректировка,СуммаРасчет,
																				|СчетКонтрагента,СчетОрганизации,ЦФО");

				

			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция НовыйПротоколСозданияВерсийДоговоров()

	ПротоколСозданияВерсийДоговоров = Новый Структура;
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ВсегоОшибок",0);
	РезультатВыполнения.Вставить("ВсегоОбъектов",0);
	РезультатВыполнения.Вставить("ПомеченоНаУдаление",0);
	РезультатВыполнения.Вставить("ПропущеноОбъектов",0);

	Протокол = Новый ТаблицаЗначений;
	Протокол.Колонки.Добавить("ТекущаяВерсияДоговора");
	Протокол.Колонки.Добавить("НоваяВерсияДоговора");
	Протокол.Колонки.Добавить("Комментарий");
	Протокол.Колонки.Добавить("КоличествоОшибок",Новый ОписаниеТипов("Число"));
	Протокол.Колонки.Добавить("КоличествоПомеченныхНаУдаление",Новый ОписаниеТипов("Число"));
	Протокол.Колонки.Добавить("КоличествоПропущенных",Новый ОписаниеТипов("Число"));
	Протокол.Колонки.Добавить("КоличествоОбработанных",Новый ОписаниеТипов("Число"));
	
	ПротоколСозданияВерсийДоговоров.Вставить("РезультатВыполнения", РезультатВыполнения);
	ПротоколСозданияВерсийДоговоров.Вставить("Протокол",Протокол);
	
	Возврат ПротоколСозданияВерсийДоговоров;
	
КонецФункции 

Функция НовыйКэшКонвертацииВерсийДоговоров()

	КэшКонвертацииВерсийДоговоров = Новый Структура;	
	КэшКонвертацииВерсийДоговоров.Вставить("ОдноименныеСвойства",Новый Структура);
	
	Возврат КэшКонвертацииВерсийДоговоров;
	
КонецФункции

Процедура ДобавитьОбработанныйОбъектВПротокол(ТекущаяВерсияДоговора, НоваяВерсияДоговора = Неопределено, ПротоколСозданияВерсийДоговоров)

	РезультатВыполнения = ПротоколСозданияВерсийДоговоров.РезультатВыполнения;
	
	Протокол = ПротоколСозданияВерсийДоговоров.Протокол;
	
	СтрокаПротокола = СтрокаПротокола(Протокол,ТекущаяВерсияДоговора);
	
	СтрокаПротокола.НоваяВерсияДоговора = НоваяВерсияДоговора;
	СтрокаПротокола.КоличествоОбработанных = 1;

КонецПроцедуры

Процедура ДобавитьПропущенныйДокументВПротокол(ТекущаяВерсияДоговора, Причина, ПротоколСозданияВерсийДоговоров)

	РезультатВыполнения = ПротоколСозданияВерсийДоговоров.РезультатВыполнения;
	
	Протокол = ПротоколСозданияВерсийДоговоров.Протокол;
	
	СтрокаПротокола = СтрокаПротокола(Протокол,ТекущаяВерсияДоговора);

	СтрокаПротокола.Комментарий = Причина;
	СтрокаПротокола.КоличествоПропущенных = 1;
	
	ДобавитьОбработанныйОбъектВПротокол(ТекущаяВерсияДоговора,, ПротоколСозданияВерсийДоговоров);
	
КонецПроцедуры

Процедура ДобавитьПомеченныйНаУдалениеДокументВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора)

	РезультатВыполнения = ПротоколСозданияВерсийДоговоров.РезультатВыполнения;
	
	Протокол = ПротоколСозданияВерсийДоговоров.Протокол;
	
	СтрокаПротокола = СтрокаПротокола(Протокол,ТекущаяВерсияДоговора);

	СтрокаПротокола.КоличествоПомеченныхНаУдаление = 1;
	
КонецПроцедуры

Процедура ДобавитьОшибкуВПротокол(ПротоколСозданияВерсийДоговоров, ТекущаяВерсияДоговора, КодОшибки, ОписаниеОшибки)
	
	РезультатВыполнения = ПротоколСозданияВерсийДоговоров.РезультатВыполнения;
	
	Протокол = ПротоколСозданияВерсийДоговоров.Протокол;
	
	СтрокаПротокола = СтрокаПротокола(Протокол,ТекущаяВерсияДоговора);

	ПолныйТекстОшибки = "";                 
	
	Если КодОшибки = "ПроведениеДокумента" Тогда
		ПолныйТекстОшибки = НСтр("ru = 'Ошибка при проведении документа'");
	ИначеЕсли КодОшибки = "ЗаполнениеДокумента" Тогда
		ПолныйТекстОшибки = НСтр("ru = 'Ошибка при заполнении документа'");
	ИначеЕсли КодОшибки = "ПометкаНаУдаление" Тогда
		ПолныйТекстОшибки = НСтр("ru = 'Ошибка при пометке удаления старых версий договоров'");
	ИначеЕсли КодОшибки = "ЗаменаСсылок" Тогда
		ПолныйТекстОшибки = НСтр("ru = 'Ошибка при замене ссылок старых версий договоров на новую версию договора'");
	КонецЕсли;
	
	СтрокаПротокола.Комментарий = ПолныйТекстОшибки +" "+ОписаниеОшибки ;
	СтрокаПротокола.КоличествоОшибок = 1;

КонецПроцедуры

Функция ОдноименныеСвойстваВерсийДоговоров(ИмяДокументаТекущаяВерсияДоговора, ИмяДокументаНоваяВерсияДоговора, КэшКонвертацииВерсийДоговоров)

	КлючКэша = ИмяДокументаТекущаяВерсияДоговора+"_"+ИмяДокументаНоваяВерсияДоговора;
	
	ОдноименныеСвойстваКэш = КэшКонвертацииВерсийДоговоров.ОдноименныеСвойства;
	
	Если ОдноименныеСвойстваКэш.Свойство(КлючКэша) Тогда
		Возврат ОдноименныеСвойстваКэш[КлючКэша];
	КонецЕсли;
	
	ОдноименныеРеквизиты = Новый Массив;
	
	РеквизитыСтаройВерсии = Метаданные.Документы[ИмяДокументаТекущаяВерсияДоговора].Реквизиты;	
	РеквизитыНовойВерсии = Метаданные.Документы[ИмяДокументаНоваяВерсияДоговора].Реквизиты;	
	
	Для Каждого РеквизитСтаройВерсии Из РеквизитыСтаройВерсии Цикл
		
		Если РеквизитыНовойВерсии.Найти(РеквизитСтаройВерсии.Имя) <> Неопределено Тогда
			
			ОдноименныеРеквизиты.Добавить(РеквизитСтаройВерсии.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОдноименныеСвойстваКэш.Вставить(КлючКэша, ОдноименныеРеквизиты);
	
	Возврат ОдноименныеРеквизиты;
	
КонецФункции

Функция ОпределитьНеобходимостьПроверки(ТекущаяВерсияДоговора, ТекущийВидДоговора, НовыйВидДоговора, ЕстьПроведенныеДокументыПоДоговору)

	ЕстьПроведенныеДокументыПоДоговору = Ложь;
	ЕстьОформленныеДокументыПоДоговору = Ложь;

	Возврат Ложь;

КонецФункции


