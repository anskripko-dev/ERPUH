#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьПериодОтбора();
	
	ОбновитьТаблицуДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "КонвертацииВерсийДоговоровВыполнена" Тогда
		АдресХранилища = Параметр;
		ОбновитьТаблицуДокументовПослеКонвертацииВерсийДоговоров(АдресХранилища);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодОтбораПриИзменении(Элемент)
	ОбновитьТаблицуДокументов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаДокументов

&НаКлиенте
Процедура ТаблицаДокументовНовыйВидДоговораПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если Не ВидыДоговораСовпадают(ТекущиеДанные.ТекущийВидДоговора, ТекущиеДанные.НовыйВидДоговора)  Тогда
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.НовыйВидДоговора) Тогда
			ТекущиеДанные.ЕстьИзменение = Ложь;
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные.ЕстьИзменение = Истина;
		ТекущиеДанные.Выбран = Истина;
		ЗаписатьИзменениеВидаДоговора(ТекущиеДанные);
		
		Возврат;
	Иначе
		ТекущиеДанные.ЕстьИзменение = Ложь;
		ТекущиеДанные.Выбран = Ложь;
		УдалитьИзменениеВидаДоговора(ТекущиеДанные);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	ПоляИсключения = Новый Массив;
	ПоляИсключения.Добавить("Выбран");
	ПоляИсключения.Добавить("НовыйВидДоговора");
	
	Если ПоляИсключения.Найти(Поле.Имя) = Неопределено Тогда
		
		ТекущиеДанные.Выбран = Не ТекущиеДанные.Выбран;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовПослеУдаления(Элемент)
	ПронумероватьТаблицуДокументов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьВерсиюДоговора(Команда)
	ТекущиеДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено тогда
		
		ПоказатьЗначение(,ТекущиеДанные.Ссылка);
		
	КонецЕсли;
		
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНовыйВидДоговора(Команда)
	
	Если Не ЕстьВыбранныеСтроки() Тогда
		НачатьУстановкуНовогоВидаДоговора();
		Возврат;
	КонецЕсли;
	
	ВыбратьНовыйВидДоговора();
	
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьНовыйВидДоговора()

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораНовогоВидаДоговора",ЭтотОбъект);
	
	ПоказатьВводЗначения(Оповещение,,НСтр("ru = 'Выберите новый вид договора'"),Новый ОписаниеТипов("СправочникСсылка.ВидыДоговоровКонтрагентовУХ"));

КонецПроцедуры 


&НаКлиенте
Процедура ПослеВыбораНовогоВидаДоговора(Результат, Параметры) Экспорт

	Если Не Результат = Неопределено Тогда
		
		ВыбранныеСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("Выбран",Истина));
	    
		Для каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
			
			Если Не ВидыДоговораСовпадают(ВыбраннаяСтрока.ТекущийВидДоговора, Результат) Тогда
				ВыбраннаяСтрока.НовыйВидДоговора = Результат;
				ВыбраннаяСтрока.ЕстьИзменение = Истина;
				ЗаписатьИзменениеВидаДоговора(ВыбраннаяСтрока);
			Иначе
				ВыбраннаяСтрока.Выбран = Ложь;	
			КонецЕсли;
			
	    КонецЦикла; 		
			
	КонецЕсли;
	

КонецПроцедуры 

&НаКлиенте
Процедура КонвертироватьВерсииДоговоров(Команда)
	
	Если Не ЕстьВыбранныеСтроки() Тогда
		НачатьУстановкуНовогоВидаДоговора();
		Возврат;
	КонецЕсли;
	
	ИзмененныеСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("Выбран,ЕстьИзменение",Истина,Истина));
	
	Если Не ИзмененныеСтроки.Количество() Тогда
		Оповещение = Новый ОписаниеОповещения("НетИзмененныхСтрокПослеОтветаНаВопрос", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Необходимо выбрать новый вид договора для выбранных строк. Выбрать новый вид договора?'"),РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;                     
	
	
	Оповещение = Новый ОписаниеОповещения("КонвертироватьВерсииДоговоровПослеОтветаНаВопрос",ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Начать конвертацию версий договоров?'"),РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуДокументовПринудительно(Команда)
	ОбновитьТаблицуДокументов();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагВыбран(Команда)
	УстановитьЗначениеФлагаВыбран(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлагВыбран(Команда)
	УстановитьЗначениеФлагаВыбран(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьТаблицуДокументовПослеКонвертацииВерсийДоговоров(АдресХранилища)

	РезультатВыполненияКонвертацииВерсийДоговоров = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Протокол = РезультатВыполненияКонвертацииВерсийДоговоров.Протокол;
	
	Для Каждого СтрокаПротокола Из Протокол Цикл
		
		Если СтрокаПротокола.КоличествоОбработанных > 0 
			И СтрокаПротокола.КоличествоПропущенных = 0 
			И  СтрокаПротокола.КоличествоОшибок = 0 Тогда
			
			НайдСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("Ссылка",СтрокаПротокола.ТекущаяВерсияДоговора));
			
			Для Каждого НайдСтрока Из НайдСтроки Цикл
				НайдСтрока.КонвертацияПроизведена = Истина;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуНовогоВидаДоговора()

		Оповещение = Новый ОписаниеОповещения("УстановитьНовыйВидДоговораПослеОтветаНаВопрос",ЭтотОбъект);
		ПоказатьВопрос(Оповещение,НСтр("ru = 'Необходимо выбрать версию договора. Выбрать все версии и начать выбор нового вида договора?'")
					,РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Функция ЕстьВыбранныеСтроки()

	Возврат ТаблицаДокументов.НайтиСтроки(Новый Структура("Выбран",Истина)).Количество();

КонецФункции

&НаКлиенте
Процедура НетИзмененныхСтрокПослеОтветаНаВопрос(Ответ, Параметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ВыбратьНовыйВидДоговора();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьНовыйВидДоговораПослеОтветаНаВопрос(Ответ, Параметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		УстановитьЗначениеФлагаВыбран(Истина);
		ВыбратьНовыйВидДоговора();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьВерсииДоговоровПослеОтветаНаВопрос(Ответ, Параметры)Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеКонвертацииВерсийДоговоров",ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресТаблицыДокументов", ПоместитьВоВременноеХранилищеТаблицуДокументов(ТаблицаДокументов));
		
		ОткрытьФорму("Обработка.КонвертацияВерсийДоговоров.Форма.ФормаРезультатКонвертации", ПараметрыФормы, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
		
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура УстановитьЗначениеФлагаВыбран(ЗначениеФлага)

	Для каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		
		СтрокаТаблицы.Выбран = ЗначениеФлага;	
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаписатьИзменениеВидаДоговора(ДанныеСтроки)

	//Запишем изменение для того, чтобы при обновлении таблицы документов (например, изменили отбор) восстановить сделанные изменения
	//см.ВосстановитьИзменения()
	
	НайдСтроки = ТаблицаИзменений.НайтиСтроки(Новый Структура("Ссылка",ДанныеСтроки.Ссылка));
	Если НайдСтроки.Количество() Тогда
		СтрокаИзменений = НайдСтроки[0];
	Иначе
		СтрокаИзменений = ТаблицаИзменений.Добавить();
		СтрокаИзменений.Ссылка = ДанныеСтроки.Ссылка;
	КонецЕсли;
	
	СтрокаИзменений.НовыйВидДоговора = ДанныеСтроки.НовыйВидДоговора;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзменениеВидаДоговора(ДанныеСтроки)

	НайдСтроки = ТаблицаИзменений.НайтиСтроки(Новый Структура("Ссылка",ДанныеСтроки.Ссылка));
	Если НайдСтроки.Количество() Тогда
		СтрокаИзменений = НайдСтроки[0];
		ТаблицаИзменений.Удалить(СтрокаИзменений);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьПериодОтбора()

	Объект.ПериодОтбора.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	Объект.ПериодОтбора.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуДокументов()

	Настройки = Объект.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", Объект.ПериодОтбора.ДатаНачала);	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", Объект.ПериодОтбора.ДатаОкончания);	
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(ПолучитьИзВременногоХранилища(Объект.АдресСхемыКомпоновкиДанных), Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Результат = Новый ТаблицаЗначений;

	ПроцессорВывода.УстановитьОбъект(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ОбновитьТаблицуИзменений(Результат);
	
	ЗначениеВРеквизитФормы(Результат, "ТаблицаДокументов");
	
	ПронумероватьТаблицуДокументов();

	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуИзменений(ИсходнаяТаблица)

	УдаляемыеСтроки = Новый Массив;
	
	
	Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
		
		НайдСтроки = ТаблицаИзменений.НайтиСтроки(Новый Структура("Ссылка",СтрокаТаблицы.Ссылка));

		Если НайдСтроки.Количество() Тогда
			
			СтрокаИзменений = НайдСтроки[0];
			
			Если СтрокаТаблицы.НовыйВидДоговора = СтрокаИзменений.НовыйВидДоговора Тогда
				УдаляемыеСтроки.Добавить(СтрокаИзменений);
				Продолжить;
			КонецЕсли;
			СтрокаТаблицы.НовыйВидДоговора = СтрокаИзменений.НовыйВидДоговора;
			СтрокаТаблицы.ЕстьИзменение = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		
		ТаблицаИзменений.Удалить(УдаляемаяСтрока);	
		
	КонецЦикла;
	
	ПронумероватьТаблицуДокументов();

КонецПроцедуры

Процедура ПронумероватьТаблицуДокументов()
	
	НомерСтроки = 0;

	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаТаблицы.НомерСтроки = НомерСтроки;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
		ОбновитьТаблицуДокументов();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоместитьВоВременноеХранилищеТаблицуДокументов(Знач ТаблицаДокументов)

	ТаблицаДокументов = ТаблицаДокументов.Выгрузить();
	ТаблицаДокументовКопия = ТаблицаДокументов.Скопировать(Новый Структура("Выбран,ЕстьИзменение,КонвертацияПроизведена",Истина,Истина,Ложь));	
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДокументовКопия);

КонецФункции 

&НаКлиенте
Процедура ПослеКонвертацииВерсийДоговоров(Результат, Параметры) Экспорт

	

КонецПроцедуры 

&НаКлиенте
Функция ВидыДоговораСовпадают(ТекущийВидДоговора,НовыйВидДоговора )

	Возврат ТекущийВидДоговора = НовыйВидДоговора

КонецФункции

#КонецОбласти



