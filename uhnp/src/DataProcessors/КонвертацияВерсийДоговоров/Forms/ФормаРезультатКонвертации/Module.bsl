#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресТаблицыДокументов = Параметры.АдресТаблицыДокументов;
	
	ТаблицаДокументов.Загрузить(ПолучитьИзВременногоХранилища(АдресТаблицыДокументов));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НачатьКонвертациюВерсийДоговоров();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтчетОРезультатеВыполненияКонвертации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресХранилища",АдресХранилища);
	
	ОткрытьФорму("Обработка.КонвертацияВерсийДоговоров.Форма.ФормаОтчетаОРезультатеКонвертации", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеКонвертацииОбъектов(Команда)
	
	ОтменитьВыполнениеКонвертацииОбъектовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьСтраницуОперации(ИмяСтраницы)
	Элементы.Страницы.ТекущаяСтраница = Элементы[ИмяСтраницы];
КонецПроцедуры 

&НаКлиенте
Процедура НачатьКонвертациюВерсийДоговоров()

	УправлениеФормой();
	
	ДлительнаяОперация = ВыполнитьКонвертациюВерсийДоговоров();
	
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВыполненияКонвертацииВерсийДоговоров", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой(ЗаданиеВыполнено = Ложь,
							ЗаданиеОтменено = Ложь,
							ЗаданиеВыполненоСОшибкой = Ложь)

	Если Не ЗаданиеВыполнено  И Не ЗаданиеОтменено И Не ЗаданиеВыполненоСОшибкой Тогда
		УстановитьСтраницуОперации("СтраницаФоновоеЗадание");
		Элементы.ФормаОтменитьВыполнениеКонвертацииОбъектов.Видимость = Истина;
		Элементы.ФормаОтчетОРезультатеВыполненияКонвертации.Видимость = Ложь;
	Иначе							
		Если ЗаданиеВыполнено Тогда
			УстановитьСтраницуОперации("СтраницаРезультат");
			Элементы.ФормаОтменитьВыполнениеКонвертацииОбъектов.Видимость = Ложь;
			Элементы.ФормаОтчетОРезультатеВыполненияКонвертации.Видимость = Истина;
		ИначеЕсли ЗаданиеОтменено Тогда
			УстановитьСтраницуОперации("СтраницаЗаданиеОтменено");
			Элементы.ФормаОтменитьВыполнениеКонвертацииОбъектов.Видимость = Ложь;
			Элементы.ФормаОтчетОРезультатеВыполненияКонвертации.Видимость = Ложь;
		ИначеЕсли ЗаданиеВыполненоСОшибкой Тогда
			УстановитьСтраницуОперации("СтраницаЗаданиеВыполненоСОшибкой");
			Элементы.ФормаОтменитьВыполнениеКонвертацииОбъектов.Видимость = Ложь;
			Элементы.ФормаОтчетОРезультатеВыполненияКонвертации.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ВыполнитьКонвертациюВерсийДоговоров()

	ИмяПроцедуры = "Обработки.КонвертацияВерсийДоговоров.ВыполнитьКонвертациюВерсийДоговоров";

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТаблицаДокументов", РеквизитФормыВЗначение("ТаблицаДокументов"));
		
	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Конвертация версий договоров'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыПроцедуры, НастройкиЗапуска);
	
КонецФункции

&НаКлиенте
Процедура ПослеВыполненияКонвертацииВерсийДоговоров(Задание, Параметры) Экспорт
	
	Если Задание = Неопределено Тогда
		
		Если ЗаданиеОтменено Тогда
			УправлениеФормой(Ложь, Истина);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Задание.Статус = "Ошибка" Тогда
		ТекстОшибки = Задание.КраткоеПредставлениеОшибки;
		УправлениеФормой(,,Истина);
	Иначе
		УправлениеФормой(Истина);
		АдресХранилища = Задание.АдресРезультата;
		ПоказатьРезультатВыполненияКонвертацииВерсийДоговоров();
		
		Оповестить("КонвертацииВерсийДоговоровВыполнена", АдресХранилища);

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьРезультатВыполненияКонвертацииВерсийДоговоров()

	РезультатВыполненияКонвертацииВерсийДоговоров = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, РезультатВыполненияКонвертацииВерсийДоговоров.РезультатВыполнения);

КонецПроцедуры 

&НаСервере
Процедура ОтменитьВыполнениеКонвертацииОбъектовНаСервере()
	
	ЗаданиеОтменено = Истина;
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

#КонецОбласти


