Функция СобратьМассивВходныхПолейЗапросаДляАнализаДанных(КолонкиВходные,ИмяТаблицы,ДобавлятьПсевдоним = Истина)

	МассивПолейЗапросаВходныхДанных = Новый Массив;
	
	Для Каждого ОписаниеВходнойКолонки Из КолонкиВходные Цикл
		
		МассивПолейЗапросаВходныхДанных.Добавить(ИмяТаблицы+"."+ОписаниеВходнойКолонки.ИмяКолонки 
			+?(ДобавлятьПсевдоним," КАК "+ОписаниеВходнойКолонки.ИмяКолонки,""));
		
	КонецЦикла;

	Возврат МассивПолейЗапросаВходныхДанных;
	
КонецФункции

Функция ТекстУсловияПоПрогнозируемомуПолюДляЗапросаАнализаДанных(ОписаниеТипа,ИмяПоля)

	МассивУсловий = Новый Массив;
	ПроверятьНаНеопределено = ОписаниеТипа.Типы().Количество() > 1;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		
		Если Не ОбъектМетаданных = Неопределено Тогда
			
			ИмяОбъекта = ОбъектМетаданных.Имя;
			ВидОбъекта = ОбщегоНазначения.ВидОбъектаПоТипу(Тип);
			
			Условие = " НЕ Выразить("+ИмяПоля+" КАК "+ВидОбъекта+"."+ИмяОбъекта+") =  Значение("+ВидОбъекта+"."+ИмяОбъекта+".ПустаяСсылка) ";
			МассивУсловий.Добавить(Условие);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивУсловий.Количество() = 0 Тогда
		ТекстУсловия = "ИСТИНА"; 
	ИначеЕсли ПроверятьНаНеопределено Тогда
		Условие = " НЕ " + ИмяПоля + " = Неопределено";
		МассивУсловий.Добавить(Условие);
	КонецЕсли;
	
	ТекстУсловия = СтрСоединить(МассивУсловий, "И");
	
	Возврат ТекстУсловия;
	
КонецФункции	

Функция ИнициализироватьТаблицуОписанияКолонок()

	ОписаниеКолонок = Новый ТаблицаЗначений;
	ОписаниеКолонок.Колонки.Добавить("ИмяКолонки");
	ОписаниеКолонок.Колонки.Добавить("ТипКолонки");
	ОписаниеКолонок.Колонки.Добавить("Использование");
	ОписаниеКолонок.Колонки.Добавить("ТолькоПервыйУровеньДерева");
	ОписаниеКолонок.Колонки.Добавить("ИмяРеквизита");

	Возврат ОписаниеКолонок;
	
КонецФункции 

// Добавляет в таблицу значений строку с заполнением
//
// Параметры:
//  <Таблица>  - <ТаблицаЗначений> - Таблица занчений, в которую добавляется строка
//  <ИмяКолонки>  - <Строка> - Имя добавляемой колонки
//  <ТипКолонки>  - <ОписаниеТипов> - Тип добавляемой колонки
//  <Использование>  - <Число> - 1: используется в шапке и расшифровке 2: только в шапке 3: только в  расшифровке
//
Процедура ДобавитьОписаниеКолонки(Таблица,
								ИмяКолонки,
								ТипКолонки,
								Использование = 1,
								ТолькоПервыйУровеньДерева = Ложь,
								ИмяРеквизита = "")

	НовСтр = Таблица.Добавить();
	НовСтр.ИмяКолонки = ИмяКолонки;
	НовСтр.ТипКолонки = ТипКолонки;
	НовСтр.Использование = Использование;
	НовСтр.ТолькоПервыйУровеньДерева = ТолькоПервыйУровеньДерева;
	НовСтр.ИмяРеквизита = ИмяРеквизита;

КонецПроцедуры

Функция ПолучитьСтруктуруДанныхДляЗапросаАнализаДанных(Знач ДеревоДокументов,ВидДвиженияОтбор)
	
	КолонкиВходные = ИнициализироватьТаблицуОписанияКолонок();
	ДобавитьОписаниеКолонки(КолонкиВходные,"Организация",ДеревоДокументов.Колонки.Организация.ТипЗначения,2,Истина);
	ДобавитьОписаниеКолонки(КолонкиВходные,"Контрагент", ДеревоДокументов.Колонки.Контрагент.ТипЗначения,2,Истина);
	ДобавитьОписаниеКолонки(КолонкиВходные,"СчетОрганизации",ДеревоДокументов.Колонки.СчетОрганизации.ТипЗначения,2,Истина);
	
	КолонкиПрогнозируемые = ИнициализироватьТаблицуОписанияКолонок();
	ТипыДоговоры = Новый Массив;
    ТипыДоговоры.Добавить(Тип("СправочникСсылка.ДоговорыКонтрагентов"));
	ТипыДоговоры.Добавить(Тип("СправочникСсылка.ДоговорыМеждуОрганизациями"));
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые, "ДоговорКонтрагента", 
								Новый ОписаниеТипов(ТипыДоговоры), 2 , , "Договор");
		
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"СтатьяДвиженияДенежныхСредств",  
		ДеревоДокументов.Колонки.СтатьяДвиженияДенежныхСредств.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"ЦФО",		ДеревоДокументов.Колонки.ЦФО.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Проект",		ДеревоДокументов.Колонки.Проект.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика1",	ДеревоДокументов.Колонки.АналитикаБДДС1.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика2",	ДеревоДокументов.Колонки.АналитикаБДДС2.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика3",	ДеревоДокументов.Колонки.АналитикаБДДС3.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика4",	ДеревоДокументов.Колонки.АналитикаБДДС4.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика5",	ДеревоДокументов.Колонки.АналитикаБДДС5.ТипЗначения,3);
	ДобавитьОписаниеКолонки(КолонкиПрогнозируемые,"Аналитика6",	ДеревоДокументов.Колонки.АналитикаБДДС6.ТипЗначения,3);
	
	ИмяДокумента = ?(ВидДвиженияОтбор = Перечисления.ВидыДвиженийПриходРасход.Приход,
		НСтр("ru = 'ПоступлениеБезналичныхДенежныхСредств'"),НСтр("ru = 'СписаниеБезналичныхДенежныхСредств'"));
	
	ТаблицаВходныхДанных = Новый ТаблицаЗначений;
	
	Для Каждого ОписаниеВходнойКолонки Из КолонкиВходные Цикл		
		ТаблицаВходныхДанных.Колонки.Добавить(ОписаниеВходнойКолонки.ИмяКолонки, ОписаниеВходнойКолонки.ТипКолонки);		
	КонецЦикла;
	
	Для Каждого ТекСтр Из ДеревоДокументов.Строки Цикл		
		ЗаполнитьЗначенияСвойств(ТаблицаВходныхДанных.Добавить(), ТекСтр);		
	КонецЦикла;
		
	ТаблицаВходныхДанных.Свернуть(ИменаКолонокТаблицы(ТаблицаВходныхДанных));
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КолонкиВходные", КолонкиВходные);
	СтруктураДанных.Вставить("КолонкиПрогнозируемые", КолонкиПрогнозируемые);
	СтруктураДанных.Вставить("ИмяДокумента", ИмяДокумента);
	СтруктураДанных.Вставить("ТаблицаВходныхДанных", ТаблицаВходныхДанных);
	СтруктураДанных.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ИменаКолонокТаблицы(Таблица)
	
	МассивИменКолонок = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		МассивИменКолонок.Добавить(Колонка.Имя);	
	КонецЦикла;
	
	Возврат СтрСоединить(МассивИменКолонок, ",");

КонецФункции

Процедура ЗаполнитьДеревоПодобраннымиЗначениями(Знач ДеревоДокументов, Знач Выборка, ИмяИнструмента)
	
	// Получим массив реквизитов из шаблона
	МассивРеквизитов = Новый Массив;
	Для Каждого ТекРеквизит Из Метаданные.РегистрыСведений.ШаблоныАналитикПлатежей.Ресурсы Цикл
		
		МассивРеквизитов.Добавить(ТекРеквизит.Имя);
		
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаДокумента = ДеревоДокументов.Строки.Найти(Выборка.Ссылка, "Ссылка");
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьНезаполненныеЗначенияСтроки(СтрокаДокумента, Выборка, МассивРеквизитов, ИмяИнструмента);
		
		Для Каждого СтрокаРасшифровкиДокумента Из СтрокаДокумента.Строки Цикл
			ЗаполнитьНезаполненныеЗначенияСтроки(СтрокаРасшифровкиДокумента, Выборка, МассивРеквизитов, ИмяИнструмента);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНезаполненныеЗначенияСтроки(Приемник, Источник, МассивРеквизитов, ИмяИнструмента)
	
	ЕстьИзменениеВСтроке = Ложь;
	Для Каждого ТекИмяРеквизита Из МассивРеквизитов Цикл
		
		Если ЗначениеЗаполнено(Источник[ТекИмяРеквизита]) Тогда
			Приемник[ТекИмяРеквизита] = Источник[ТекИмяРеквизита];
			ЕстьИзменениеВСтроке = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьИзменениеВСтроке Тогда
		Приемник.РезультатЗаполненияАналитик = Приемник.РезультатЗаполненияАналитик + ИмяИнструмента + ";"; 	
	КонецЕсли;
	
	Приемник.ДанныеИзменены = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
