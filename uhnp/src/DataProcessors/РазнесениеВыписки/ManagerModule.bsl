#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоШаблонамАналитик(Параметры,АдресХранилища) Экспорт
	
	ДеревоДокументов = Параметры.ДеревоДокументов;
	
	ТаблицаИсходныхДанных = СформироватьТаблицуИсходныхДанных(ДеревоДокументов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка КАК Ссылка,
	|	ДанныеДокументов.Организация КАК Организация,
	|	ДанныеДокументов.Контрагент КАК Контрагент,
	|	ДанныеДокументов.СчетОрганизации КАК СчетОрганизации,
	|	ДанныеДокументов.НазначениеПлатежа КАК НазначениеПлатежа
	|ПОМЕСТИТЬ ВТ_ДанныеДокументов
	|ИЗ
	|	&ДанныеДокументов КАК ДанныеДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокументов.Ссылка КАК Ссылка,
	|	ШаблоныАналитикПлатежей.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ШаблоныАналитикПлатежей.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	4 - ВЫБОР
	|		КОГДА ШаблоныАналитикПлатежей.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ШаблоныАналитикПлатежей.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ШаблоныАналитикПлатежей.СчетОрганизации = &ПустойБанковскийСчет
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ШаблоныАналитикПлатежей.НазначениеПлатежа = """"
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК РейтингШаблона,
	|	ШаблоныАналитикПлатежей.ЦФО КАК ЦФО,
	|	ШаблоныАналитикПлатежей.Проект КАК Проект,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС1 КАК АналитикаБДДС1,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС2 КАК АналитикаБДДС2,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС3 КАК АналитикаБДДС3,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС4 КАК АналитикаБДДС4,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС5 КАК АналитикаБДДС5,
	|	ШаблоныАналитикПлатежей.АналитикаБДДС6 КАК АналитикаБДДС6,
	|	ШаблоныАналитикПлатежей.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ПОМЕСТИТЬ ВТ_ДанныеШаблоновНесгруппированные
	|ИЗ
	|	РегистрСведений.ШаблоныАналитикПлатежей КАК ШаблоныАналитикПлатежей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДанныеДокументов КАК ВТ_ДанныеДокументов
	|		ПО (ВТ_ДанныеДокументов.Организация = ШаблоныАналитикПлатежей.Организация
	|				ИЛИ ШаблоныАналитикПлатежей.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|			И (ВТ_ДанныеДокументов.Контрагент = ШаблоныАналитикПлатежей.Контрагент
	|				ИЛИ ШаблоныАналитикПлатежей.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			И (ВТ_ДанныеДокументов.СчетОрганизации = ШаблоныАналитикПлатежей.СчетОрганизации
	|				ИЛИ ШаблоныАналитикПлатежей.СчетОрганизации = &ПустойБанковскийСчет)
	|			И (ВТ_ДанныеДокументов.НазначениеПлатежа ПОДОБНО ШаблоныАналитикПлатежей.НазначениеПлатежа СПЕЦСИМВОЛ ""\""
	|				ИЛИ ШаблоныАналитикПлатежей.НазначениеПлатежа = """")
	|			И (ВЫБОР
	|				КОГДА ШаблоныАналитикПлатежей.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
	|					ТОГДА ВТ_ДанныеДокументов.Ссылка ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|				КОГДА ШаблоныАналитикПлатежей.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
	|					ТОГДА ВТ_ДанныеДокументов.Ссылка ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеШаблоновНесгруппированные.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.РейтингШаблона) КАК РейтингШаблона
	|ПОМЕСТИТЬ ВТ_МаксимальныеВесаШаблонов
	|ИЗ
	|	ВТ_ДанныеШаблоновНесгруппированные КАК ВТ_ДанныеШаблоновНесгруппированные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеШаблоновНесгруппированные.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеШаблоновНесгруппированные.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.ДоговорКонтрагента) КАК ДоговорКонтрагента,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.ЦФО) КАК ЦФО,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.Проект) КАК Проект,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС1) КАК АналитикаБДДС1,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС2) КАК АналитикаБДДС2,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС3) КАК АналитикаБДДС3,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС4) КАК АналитикаБДДС4,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС5) КАК АналитикаБДДС5,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.АналитикаБДДС6) КАК АналитикаБДДС6,
	|	МАКСИМУМ(ВТ_ДанныеШаблоновНесгруппированные.ХозяйственнаяОперация) КАК ХозяйственнаяОперация
	|ИЗ
	|	ВТ_ДанныеШаблоновНесгруппированные КАК ВТ_ДанныеШаблоновНесгруппированные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксимальныеВесаШаблонов КАК ВТ_МаксимальныеВесаШаблонов
	|		ПО ВТ_ДанныеШаблоновНесгруппированные.Ссылка = ВТ_МаксимальныеВесаШаблонов.Ссылка
	|			И ВТ_ДанныеШаблоновНесгруппированные.РейтингШаблона = ВТ_МаксимальныеВесаШаблонов.РейтингШаблона
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеШаблоновНесгруппированные.Ссылка";

	Запрос.УстановитьПараметр("ДанныеДокументов", ТаблицаИсходныхДанных);
	Запрос.УстановитьПараметр("ПустойБанковскийСчет", 	
		ДенежныеСредстваВстраиваниеУХКлиентСервер.ПолучитьПустойБанковскийСчет());
	
	Выборка = Запрос.Выполнить().Выбрать();
	                                          
	ЗаполнитьДеревоПодобраннымиЗначениями(ДеревоДокументов, Выборка, НСтр("ru = 'По шаблонам аналитик'"));

	ПоместитьВоВременноеХранилище(ДеревоДокументов, АдресХранилища);
	
КонецПроцедуры

Процедура ЗаполнитьПоДаннымДоговоров(Параметры,АдресХранилища) Экспорт
	
	ДеревоДокументов = Параметры.ДеревоДокументов;
	
	ТаблицаИсходныхДанных = СформироватьТаблицуИсходныхДанных(ДеревоДокументов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка КАК Ссылка,
	|	ДанныеДокументов.Организация КАК Организация,
	|	ДанныеДокументов.Контрагент КАК Контрагент,
	|	ДанныеДокументов.СчетОрганизации КАК СчетОрганизации,
	|	ДанныеДокументов.НазначениеПлатежа КАК НазначениеПлатежа
	|ПОМЕСТИТЬ ВТ_ДанныеДокументов
	|ИЗ
	|	&ДанныеДокументов КАК ДанныеДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокументов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.Ссылка КАК ДоговорКонтрагента,
	|	ДоговорыКонтрагентов.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	ДоговорыКонтрагентов.ОсновнойЦФО КАК ЦФО,
	|	ДоговорыКонтрагентов.ОсновнойПроект КАК Проект,
	|	ДоговорыКонтрагентов.АналитикаБДДС1 КАК АналитикаБДДС1,
	|	ДоговорыКонтрагентов.АналитикаБДДС2 КАК АналитикаБДДС2,
	|	ДоговорыКонтрагентов.АналитикаБДДС3 КАК АналитикаБДДС3,
	|	ДоговорыКонтрагентов.АналитикаБДДС4 КАК АналитикаБДДС4,
	|	ДоговорыКонтрагентов.АналитикаБДДС5 КАК АналитикаБДДС5,
	|	ДоговорыКонтрагентов.АналитикаБДДС6 КАК АналитикаБДДС6
	|ИЗ
	|	ВТ_ДанныеДокументов КАК ВТ_ДанныеДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ВТ_ДанныеДокументов.Организация = ДоговорыКонтрагентов.Организация
	|			И ВТ_ДанныеДокументов.Контрагент = ДоговорыКонтрагентов.Контрагент
	|			И (ВТ_ДанныеДокументов.НазначениеПлатежа ПОДОБНО ДоговорыКонтрагентов.Наименование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокументов.Ссылка,
	|	ДоговорыАренды.Ссылка,
	|	ДоговорыАренды.СтатьяДвиженияДенежныхСредств,
	|	ДоговорыАренды.ОсновнойЦФО,
	|	ДоговорыАренды.ОсновнойПроект,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL
	|ИЗ
	|	ВТ_ДанныеДокументов КАК ВТ_ДанныеДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыАренды КАК ДоговорыАренды
	|		ПО ВТ_ДанныеДокументов.Организация = ДоговорыАренды.Организация
	|			И ВТ_ДанныеДокументов.Контрагент = ДоговорыАренды.Контрагент
	|			И (ВТ_ДанныеДокументов.НазначениеПлатежа ПОДОБНО ДоговорыАренды.Наименование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеДокументов.Ссылка,
	|	ДоговорыКредитовИДепозитов.Ссылка,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL
	|ИЗ
	|	ВТ_ДанныеДокументов КАК ВТ_ДанныеДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКредитовИДепозитов КАК ДоговорыКредитовИДепозитов
	|		ПО ВТ_ДанныеДокументов.Организация = ДоговорыКредитовИДепозитов.Организация
	|			И ВТ_ДанныеДокументов.Контрагент = ДоговорыКредитовИДепозитов.Контрагент
	|			И (ВТ_ДанныеДокументов.НазначениеПлатежа ПОДОБНО ДоговорыКредитовИДепозитов.Наименование)";

	Запрос.УстановитьПараметр("ДанныеДокументов", ТаблицаИсходныхДанных);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаполнитьДеревоПодобраннымиЗначениями(ДеревоДокументов, Выборка, НСтр("ru = 'Поиск договоров в назначении платежа'"));
	
	ПоместитьВоВременноеХранилище(ДеревоДокументов,АдресХранилища);
	
КонецПроцедуры

Процедура ЗаполнитьПоИсторическимДанным(Параметры,АдресХранилища) Экспорт

	ДанныеДляЗапросаАнализаДанных = ПолучитьСтруктуруДанныхДляЗапросаАнализаДанных(Параметры.ДеревоДокументов, Параметры.ВидДвиженияОтбор);
	
	СоздатьВременнуюТаблицуВходныхДанныхДляАнализаДанных(ДанныеДляЗапросаАнализаДанных);
	
	МассивПакетовЗапроса = ПакетыЗапросаДляАнализаДанных(ДанныеДляЗапросаАнализаДанных);
	        	
	ТекстЗапроса = СтрСоединить(МассивПакетовЗапроса, ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета());
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДанныеДляЗапросаАнализаДанных.МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатАнализаДанныхТабличныйДокумент = Новый ТабличныйДокумент;
	
	РезультатАнализаДанных = Новый Структура;
	МассивДанныхМоделиПрогноза = Новый Массив;
	ВыводитьРезультатАнализаДанныхВТабличныйДокумент = Ложь;
	Для НомерПакета = 0 По ДанныеДляЗапросаАнализаДанных.КолонкиПрогнозируемые.Количество()-1 Цикл
		
		РезультатАнализа = ВыполнитьАнализДанных(РезультатЗапроса[НомерПакета]);
		
		ДанныеМоделиПрогноза = ИнициализироватьТаблицуДанныхМоделиПрогноза(ДанныеДляЗапросаАнализаДанных.КолонкиВходные);
		                                                           
		ОписаниеПрогнозируемойКолонки = ДанныеДляЗапросаАнализаДанных.КолонкиПрогнозируемые[НомерПакета];
		
		СобратьДанныеМоделиПрогноза(РезультатАнализа.СоздатьМодельПрогноза(),ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки);
		
		ВывестиРезультатАнализаДанныхВТабличныйДокумент(РезультатАнализа,РезультатАнализаДанныхТабличныйДокумент,ВыводитьРезультатАнализаДанныхВТабличныйДокумент);
		
		МассивДанныхМоделиПрогноза.Добавить(Новый Структура("ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки"
															,ДанныеМоделиПрогноза
															,ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ОписаниеПрогнозируемойКолонки)));

	КонецЦикла;

	РезультатАнализаДанных.Вставить("МассивДанныхМоделиПрогноза",МассивДанныхМоделиПрогноза);
	РезультатАнализаДанных.Вставить("РезультатАнализаДанныхТабличныйДокумент",РезультатАнализаДанныхТабличныйДокумент);
	РезультатАнализаДанных.Вставить("ВыводитьРезультатАнализаДанныхВТабличныйДокумент",ВыводитьРезультатАнализаДанныхВТабличныйДокумент);
	ПоместитьВоВременноеХранилище(РезультатАнализаДанных,АдресХранилища);
	
КонецПроцедуры // ЗаполнитьПоИсторическимДаннымНаСервере()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьТаблицуИсходныхДанных(Знач ДеревоДокументов)
	
	ТаблицаИсходныхДанных = Новый ТаблицаЗначений;
	ТаблицаИсходныхДанных.Колонки.Добавить("Ссылка",              ДеревоДокументов.Колонки.Ссылка.ТипЗначения);
	ТаблицаИсходныхДанных.Колонки.Добавить("Организация",         ДеревоДокументов.Колонки.Организация.ТипЗначения);
	ТаблицаИсходныхДанных.Колонки.Добавить("Контрагент",          ДеревоДокументов.Колонки.Контрагент.ТипЗначения);
	ТаблицаИсходныхДанных.Колонки.Добавить("СчетОрганизации",     ДеревоДокументов.Колонки.СчетОрганизации.ТипЗначения);
	ТаблицаИсходныхДанных.Колонки.Добавить("НазначениеПлатежа",   ДеревоДокументов.Колонки.НазначениеПлатежа.ТипЗначения);
	
	Для Каждого ТекСтр Из ДеревоДокументов.Строки Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаИсходныхДанных.Добавить(), ТекСтр);
		
	КонецЦикла;
	
	Возврат ТаблицаИсходныхДанных;

КонецФункции

Процедура ВывестиРезультатАнализаДанныхВТабличныйДокумент(РезультатАнализа, 
			ТабличныйДокумент, ВыводитьРезультатАнализаДанныхВТабличныйДокумент)
	
	Если Не ВыводитьРезультатАнализаДанныхВТабличныйДокумент Тогда
		Возврат;	
	КонецЕсли;
	
	Построитель = Новый ПостроительОтчетаАнализаДанных();
	Построитель.Макет = Неопределено;
	Построитель.ТипАнализа = Тип("АнализДанныхДеревоРешений");
	Построитель.Вывести(РезультатАнализа, ТабличныйДокумент);		
	
КонецПроцедуры

Функция ВыполнитьАнализДанных(ИсточникДанных)

	Анализ = Новый АнализДанных;
    Анализ.ТипАнализа = Тип("АнализДанныхДеревоРешений");
	Анализ.ИсточникДанных = ИсточникДанных;
    Анализ.Параметры.ТипУпрощения.Значение = ТипУпрощенияДереваРешений.Упрощать;
	РезультатАнализа = Анализ.Выполнить();
	Возврат  РезультатАнализа;
		
КонецФункции

Процедура СобратьДанныеМоделиПрогноза(МодельПрогноза,ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки)
	
	ДобавитьПрогнозируемуюКолонкуВТаблицу(ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки);
	
	ВыполнитьСборДанныхДереваРешений(МодельПрогноза.КорневыеУзлы,ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки.ИмяКолонки,0,Неопределено);
	
КонецПроцедуры 

Процедура ВыполнитьСборДанныхДереваРешений(Узлы,
										ДанныеМоделиПрогноза,
										ИмяКолонкиРешения,
										УровеньДерева,
										ПредыдущаяСтрокаТаблицы)

	Если Узлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Узел Из Узлы Цикл
		
		УровеньДерева = УровеньДерева + 1;
		
		Если УровеньДерева >=2 Тогда
			СтрокаДанных = ДанныеМоделиПрогноза.Добавить();
			
			Если Не ПредыдущаяСтрокаТаблицы = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаДанных,ПредыдущаяСтрокаТаблицы,,ИмяКолонкиРешения+",КоличествоСлучаев,Вероятность");
			КонецЕсли;
		Иначе
			СтрокаДанных = Неопределено;
		КонецЕсли;
		
		Если Не СтрокаДанных = Неопределено Тогда
			ДанныеУзла = ДанныеУзлаДереваРешений(Узел,ИмяКолонкиРешения);
			ЗаполнитьЗначенияСвойств(СтрокаДанных,ДанныеУзла);
		КонецЕсли;
		
		ВыполнитьСборДанныхДереваРешений(Узел.Узлы,ДанныеМоделиПрогноза,ИмяКолонкиРешения,УровеньДерева,СтрокаДанных);
		
		УровеньДерева = УровеньДерева - 1;
	КонецЦикла;
	
КонецПроцедуры 

Функция ДанныеУзлаДереваРешений(Узел,ИмяКолонкиРешения)

	ДанныеУзла = Новый Структура;
	ДанныеУзла.Вставить(Узел.Условие[0].Имя,Узел.Условие[0].Значение);
	ДанныеУзла.Вставить("КоличествоСлучаев",Узел.КоличествоСлучаев);
	ДанныеУзла.Вставить("Вероятность",Узел.Решение.Вероятность);
	ДанныеУзла.Вставить(ИмяКолонкиРешения,Узел.Решение.Решение[ИмяКолонкиРешения].Значение);
	
	Возврат ДанныеУзла;
	
КонецФункции 

Процедура ДобавитьПрогнозируемуюКолонкуВТаблицу(ДанныеМоделиПрогноза,ОписаниеПрогнозируемойКолонки)

	ДанныеМоделиПрогноза.Колонки.Добавить(
		ОписаниеПрогнозируемойКолонки.ИмяКолонки,
		ОписаниеПрогнозируемойКолонки.ТипКолонки);

КонецПроцедуры

Функция ИнициализироватьТаблицуДанныхМоделиПрогноза(КолонкиВходные)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	Для Каждого ОписаниеВходойКолонки Из КолонкиВходные Цикл
		ТаблицаДанных.Колонки.Добавить(ОписаниеВходойКолонки.ИмяКолонки,ОписаниеВходойКолонки.ТипКолонки);
	КонецЦикла;
	
	КвЧисла = Новый КвалификаторыЧисла(15,0);
	
	ТаблицаДанных.Колонки.Добавить("КоличествоСлучаев", Новый ОписаниеТипов("Число",,,КвЧисла));
	ТаблицаДанных.Колонки.Добавить("Вероятность", Новый ОписаниеТипов("Число",,,КвЧисла));
	
	Возврат ТаблицаДанных;

КонецФункции

Функция ПакетыЗапросаДляАнализаДанных(ДанныеДляЗапросаАнализаДанных)

	МассивПакетовЗапроса = Новый Массив;
	
	Для Каждого ОписаниеПрогнозируемойКолонки Из ДанныеДляЗапросаАнализаДанных.КолонкиПрогнозируемые Цикл
		
		Если  ОписаниеПрогнозируемойКолонки.Использование = 1 Тогда	// В шапке и расшифровке

			ТекстЗапросаШапка = ТекстЗапросаПоШапкеДокументаДляАнализаДанных();
			ТекстЗапросРасшифровка = ТекстЗапросаПоРасшифровкеДокументаДляАнализаДанных();
			
			ТекстЗапроса = ТекстЗапросаШапка+"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|"+ТекстЗапросРасшифровка;
			
		ИначеЕсли ОписаниеПрогнозируемойКолонки.Использование = 2 Тогда // Только в шапке
			ТекстЗапроса = ТекстЗапросаПоШапкеДокументаДляАнализаДанных();
		ИначеЕсли ОписаниеПрогнозируемойКолонки.Использование = 3 Тогда // Только в расшифровке
			ТекстЗапроса = ТекстЗапросаПоРасшифровкеДокументаДляАнализаДанных();
		КонецЕсли;
		
		ПрогнозируемоеПоле = "Документ." + ?(ОписаниеПрогнозируемойКолонки.ИмяРеквизита = "",
					ОписаниеПрогнозируемойКолонки.ИмяКолонки, ОписаниеПрогнозируемойКолонки.ИмяРеквизита); 

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПрогнозируемоеПолеШапки",ПрогнозируемоеПоле);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПрогнозируемоеПолеРасшифровки",ПрогнозируемоеПоле);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИмяПрогнозируемогоПоля",ОписаниеПрогнозируемойКолонки.ИмяКолонки);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&УсловиеПоПрогнозируемомуПолюШапка"
												,ТекстУсловияПоПрогнозируемомуПолюДляЗапросаАнализаДанных(ОписаниеПрогнозируемойКолонки.ТипКолонки,ПрогнозируемоеПоле));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&УсловиеПоПрогнозируемомуПолюРасшифровка"
												,ТекстУсловияПоПрогнозируемомуПолюДляЗапросаАнализаДанных(ОписаниеПрогнозируемойКолонки.ТипКолонки,ПрогнозируемоеПоле));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ПоступлениеБезналичныхДенежныхСредств",ДанныеДляЗапросаАнализаДанных.ИмяДокумента);
								
		МассивПакетовЗапроса.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	Возврат МассивПакетовЗапроса;

КонецФункции 

Функция ТекстЗапросаПоШапкеДокументаДляАнализаДанных()
			
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Документ.Организация КАК Организация,
		|	Документ.Контрагент КАК Контрагент,
		|	Документ.БанковскийСчет КАК СчетОрганизации,
		|	&ПрогнозируемоеПолеШапки КАК ИмяПрогнозируемогоПоля
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Документ
		|ГДЕ
		|	 &УсловиеПоПрогнозируемомуПолюШапка
		|	И Документ.Контрагент В
		|			(ВЫБРАТЬ
		|				ВТ_ТаблицаВходныхДанных.Контрагент
		|			ИЗ
		|				ВТ_ТаблицаВходныхДанных КАК ВТ_ТаблицаВходныхДанных)";
	
	Возврат	ТекстЗапроса;

КонецФункции 

Функция ТекстЗапросаПоРасшифровкеДокументаДляАнализаДанных()
			
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Документ.Ссылка.Организация КАК Организация,
		|	Документ.Ссылка.Контрагент КАК Контрагент,
		|	Документ.Ссылка.БанковскийСчет КАК СчетОрганизации,
		|	&ПрогнозируемоеПолеРасшифровки КАК ИмяПрогнозируемогоПоля
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Документ
		|ГДЕ
		|	&УсловиеПоПрогнозируемомуПолюРасшифровка
		|	И Документ.Ссылка.Контрагент В
