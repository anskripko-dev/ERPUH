КонецФункции 

Процедура СоздатьВременнуюТаблицуВходныхДанныхДляАнализаДанных(ДанныеДляЗапросаАнализаДанных)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДанныеДляЗапросаАнализаДанных.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ПоляЗапроса
	|ПОМЕСТИТЬ ВТ_ТаблицаВходныхДанных
	|ИЗ
	|	&ТаблицаВходныхДанных КАК ТаблицаВходныхДанных";
	
	ПоляЗапроса = ПоляЗапросаВходныхДанных(ДанныеДляЗапросаАнализаДанных.КолонкиВходные,"ТаблицаВходныхДанных");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ПоляЗапроса",ПоляЗапроса);
	
	Запрос.УстановитьПараметр("ТаблицаВходныхДанных",ДанныеДляЗапросаАнализаДанных.ТаблицаВходныхДанных);
	Запрос.Выполнить();

КонецПроцедуры

Функция ПоляЗапросаВходныхДанных(КолонкиВходные,ИмяТаблицы)

	МассивПолейЗапросаВходныхДанных = СобратьМассивВходныхПолейЗапросаДляАнализаДанных(КолонкиВходные,ИмяТаблицы);
	
	ПоляЗапроса = СтрСоединить(МассивПолейЗапросаВходныхДанных,",");

	Возврат ПоляЗапроса;
	
