
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьИнструментыЗаполненияАналитик();
	
	СоздатьРеквизитыИЭлементыФормы();
	
	ВидДвиженияОтбор = Параметры.ВидДвиженияОтбор;
	ИсходноеДеревоДокументов = ПолучитьИзВременногоХранилища(Параметры.АдресДереваДокументов);
	СоздатьКолонкиДереваДокументов(ИсходноеДеревоДокументов);
	ЗначениеВРеквизитФормы(ИсходноеДеревоДокументов,"ДеревоДокументов");
	
	СброситьСостояниеВыполненияИнструмента(ЭтотОбъект);
	
	Элементы.ПринятьИзменения.Доступность = АналитикиЗаполнены;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьАналитики(Команда)
	
	Если Не ИнструментВыбран() Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Необходимо выбрать хотя бы один инструмент заполнения аналитик выписки'"));
		Возврат;
		
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос",ЭтотОбъект);
	ПоказатьВопрос(Оповещение,НСтр("ru = 'Начать заполнение аналитик выписки?'"),РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	УстановитьВыборИнструмента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьВыборИнструмента(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьИзменения(Команда)
	
	СкорректироватьРезультатЗаполненияАналитик();
	
	Закрыть(ПоместитьДеревоДокументовВоВременноеХранилище());
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДеревоДокументовВоВременноеХранилище()

	Возврат ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ДеревоДокументов"));

КонецФункции 

&НаКлиенте
Процедура ОтменитьЗаполнениеАналитик(Команда)
	
	ОтменитьЗаполнениеАналитикНаСервере();
	Закрыть();
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтменитьЗаполнениеАналитикНаСервере()
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

&НаКлиенте
Процедура СкорректироватьРезультатЗаполненияАналитик()

	Для Каждого СтрокаДереваУровень1 Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		
		СтрокаДереваУровень1.РезультатЗаполненияАналитик = РезультатЗаполненияАналитик(СтрокаДереваУровень1.РезультатЗаполненияАналитик);
		Для Каждого СтрокаДереваУровень2 Из СтрокаДереваУровень1.ПолучитьЭлементы() Цикл
			СтрокаДереваУровень2.РезультатЗаполненияАналитик = РезультатЗаполненияАналитик(СтрокаДереваУровень2.РезультатЗаполненияАналитик);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Функция РезультатЗаполненияАналитик(Знач РезультатЗаполненияАналитик)

	Если ЗначениеЗаполнено(РезультатЗаполненияАналитик) Тогда
		
		ВыполненныеИнструменты = СтрРазделить(РезультатЗаполненияАналитик,";");
		
		ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВыполненныеИнструменты);
		
		РезультатЗаполненияАналитик = СтрСоединить(ВыполненныеИнструменты,";");
		РезультатЗаполненияАналитик = Лев(РезультатЗаполненияАналитик,СтрДлина(РезультатЗаполненияАналитик)-1);
		
		Возврат РезультатЗаполненияАналитик;
		
	КонецЕсли;

КонецФункции 

&НаКлиенте
Процедура УстановитьВыборИнструмента(ЗначениеВыбора)

	Для Каждого Инструмент Из ИнструментыЗаполнения Цикл
		
		ЭтаФорма[Инструмент.ИмяИнструмента] = ЗначениеВыбора;	
		
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ИнициализироватьИнструментыЗаполненияАналитик()

	НовСтрока = ИнструментыЗаполнения.Добавить();
	НовСтрока.ИмяИнструмента = "ИнструментЗаполненияПоШаблонамАналитик";
	НовСтрока.Заголовок = НСтр("ru = 'По шаблонам заполнения'");
	НовСтрока.Подсказка = НСтр("ru = '1'");
	
	НовСтрока = ИнструментыЗаполнения.Добавить();
	НовСтрока.ИмяИнструмента = "ИнструментЗаполненияПоДаннымДоговоров";
	НовСтрока.Заголовок = НСтр("ru = 'Поиск договоров в назначении платежа'");
	НовСтрока.Подсказка = НСтр("ru = '2'");
	
	НовСтрока = ИнструментыЗаполнения.Добавить();
	НовСтрока.ИмяИнструмента = "ИнструментЗаполненияПоИсторическимДанным";
	НовСтрока.Заголовок = НСтр("ru = 'По историческим данным при помощи дерева решений'");
	НовСтрока.Подсказка = НСтр("ru = '3'");
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыИЭлементыФормы()

	МассивДобавляемыхРеквизитов = Новый Массив;
	
	Для Каждого Инструмент Из ИнструментыЗаполнения Цикл
		
		НовыйРеквизит = Новый РеквизитФормы(Инструмент.ИмяИнструмента,Новый ОписаниеТипов("Булево"),,Инструмент.Заголовок);
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);	
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	Для Каждого Инструмент Из ИнструментыЗаполнения Цикл
		
		ДобавитьБлокЭлементовФормыДляИнструмента(Инструмент);
		
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ДобавитьБлокЭлементовФормыДляИнструмента(Инструмент)

	НовГруппа = ФормыУХ.СоздатьГруппуФормы(Элементы,"Группа_"+Инструмент.ИмяИнструмента,,,Элементы.ГруппаИнструментыЗаполнения);
	НовГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовГруппа.ОтображатьЗаголовок = Ложь;
	
	НовПоле = ФормыУХ.СоздатьПолеФормы(Элементы,Инструмент.ИмяИнструмента,,Инструмент.ИмяИнструмента,ВидПоляФормы.ПолеФлажка,НовГруппа);
	НовПоле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;	
	НовПоле.Подсказка = Инструмент.Подсказка;	
	НовПоле.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	
	НовДекорацияОперация = ФормыУХ.СоздатьДекорациюФормы(Элементы,Инструмент.ИмяИнструмента+"_Операция",,ВидДекорацииФормы.Картинка,НовГруппа);
	НовДекорацияОперация.Картинка = БиблиотекаКартинок.ДлительнаяОперация16;
	НовДекорацияОперация.Высота = 1;
	НовДекорацияОперация.Ширина = 2;
	
	НовДекорацияРезультатУспех = ФормыУХ.СоздатьДекорациюФормы(Элементы,Инструмент.ИмяИнструмента+"_РезультатУспех",,ВидДекорацииФормы.Картинка,НовГруппа);
	НовДекорацияРезультатУспех.Картинка = БиблиотекаКартинок.ВыполненоУспешно;
	НовДекорацияРезультатУспех.Высота = 1;
	НовДекорацияРезультатУспех.Ширина = 2;
	
	НовДекорацияРезультатОшибка = ФормыУХ.СоздатьДекорациюФормы(Элементы,Инструмент.ИмяИнструмента+"_РезультатОшибка",,ВидДекорацииФормы.Картинка,НовГруппа);
	НовДекорацияРезультатОшибка.Картинка = БиблиотекаКартинок.ОперацияВыполненаСОшибками;
	НовДекорацияРезультатОшибка.Высота = 1;
	НовДекорацияРезультатОшибка.Ширина = 2;
	
	НовДекорацияТекстОшибки = ФормыУХ.СоздатьДекорациюФормы(Элементы,Инструмент.ИмяИнструмента+"_ТекстОшибки",,,НовГруппа);
	НовДекорацияТекстОшибки.РастягиватьПоГоризонтали = Истина;
	НовДекорацияТекстОшибки.РастягиватьПоГоризонтали = Ложь;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СброситьСостояниеВыполненияИнструмента(Форма)

	ИнструментыЗаполнения = Форма.ИнструментыЗаполнения;
	Элементы = Форма.Элементы;
	Для Каждого Инструмент Из ИнструментыЗаполнения Цикл
		
		Инструмент.Выполнено = Ложь;
		Инструмент.ТекстОшибки = "";
		
		Элементы[Инструмент.ИмяИнструмента+"_Операция"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатУспех"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатОшибка"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_ТекстОшибки"].Видимость = Ложь;
		
	КонецЦикла;
	
	Форма.АналитикиЗаполнены = Ложь;

КонецПроцедуры

&НаСервере
Процедура СоздатьКолонкиДереваДокументов(ИсходноеДеревоДокументов)

	МассивДобавляемыхРеквизитов = Новый Массив;

	Для Каждого Колонка Из ИсходноеДеревоДокументов.Колонки Цикл
		
		НовыйРеквизит = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "ДеревоДокументов");
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);

КонецПроцедуры 

&НаСервере
Функция ИнструментВыбран()

	Для Каждого Инструмент Из ИнструментыЗаполнения Цикл
		Инструмент.Выполнять = ЭтаФорма[Инструмент.ИмяИнструмента];	
	КонецЦикла;
	
	РезультатСтроки = ИнструментыЗаполнения.НайтиСтроки(Новый Структура("Выполнять",Истина));
	
	Возврат РезультатСтроки.Количество() > 0;

КонецФункции

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ,Параметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		СброситьСостояниеВыполненияИнструмента(ЭтотОбъект);
		
		Элементы.ПринятьИзменения.Доступность = АналитикиЗаполнены;
		
		НачатьЗаполнениеАналитикВыписки();
		
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура НачатьЗаполнениеАналитикВыписки()

	ТекущийИнструмент = ТекущийИнструментЗаполненияАналитикВыписки();
	
	Если ТекущийИнструмент = Неопределено Тогда
		АналитикиЗаполнены = Истина;
		Элементы.ПринятьИзменения.Доступность = АналитикиЗаполнены;
		Возврат;
	КонецЕсли;
	
	ВывестиСостояниеВыполненияИнструмента(ТекущийИнструмент, "Операция");

	ДлительнаяОперация = ВыполнитьИнструментЗаполненияАналитикВыписки(
					ТекущийИнструмент.ИмяИнструмента, УникальныйИдентификатор);
	
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВыполненияИнструмента", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ВыполнитьИнструментЗаполненияАналитикВыписки(ИмяИнструмента,УникальныйИдентификатор)
	
	Если ИмяИнструмента = "ИнструментЗаполненияПоШаблонамАналитик" Тогда
		
		ИмяПроцедуры = "Обработки.РазнесениеВыписки.ЗаполнитьПоШаблонамАналитик";
	
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ДеревоДокументов", РеквизитФормыВЗначение("ДеревоДокументов"));
		
	ИначеЕсли ИмяИнструмента = "ИнструментЗаполненияПоДаннымДоговоров" Тогда
		
		ИмяПроцедуры = "Обработки.РазнесениеВыписки.ЗаполнитьПоДаннымДоговоров";
	
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ДеревоДокументов", РеквизитФормыВЗначение("ДеревоДокументов"));
		
	ИначеЕсли ИмяИнструмента = "ИнструментЗаполненияПоИсторическимДанным" Тогда
		
		ИмяПроцедуры = "Обработки.РазнесениеВыписки.ЗаполнитьПоИсторическимДанным";
	
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ДеревоДокументов", РеквизитФормыВЗначение("ДеревоДокументов"));
		ПараметрыПроцедуры.Вставить("ВидДвиженияОтбор",ВидДвиженияОтбор);
		
	КонецЕсли;
	
	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Разнесение выписки'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыПроцедуры, НастройкиЗапуска);
	
КонецФункции

&НаКлиенте
Процедура ПослеВыполненияИнструмента(Задание,Параметры) Экспорт
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийИнструмент = ТекущийИнструментЗаполненияАналитикВыписки();

	Если Задание.Статус = "Ошибка" Тогда
		УстановитьСтатусВыполненияИнструмента(ТекущийИнструмент, Задание.КраткоеПредставлениеОшибки);
		ВывестиСостояниеВыполненияИнструмента(ТекущийИнструмент,"РезультатОшибка");
	Иначе
		АдресХранилища = Задание.АдресРезультата;
		ЗаполнитьДеревоДокументовРезультатомВыполненияИнструмента(ТекущийИнструмент.ИмяИнструмента);
		
		УстановитьСтатусВыполненияИнструмента(ТекущийИнструмент);
		ВывестиСостояниеВыполненияИнструмента(ТекущийИнструмент,"РезультатУспех");
	КонецЕсли;
	
	НачатьЗаполнениеАналитикВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСостояниеВыполненияИнструмента(Инструмент, Состояние)
	
	Если Состояние = "Операция" Тогда
		
		Элементы[Инструмент.ИмяИнструмента+"_Операция"].Видимость = Истина;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатУспех"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатОшибка"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_ТекстОшибки"].Видимость = Ложь;
		
	ИначеЕсли Состояние = "РезультатУспех" Тогда
		
		Элементы[Инструмент.ИмяИнструмента+"_Операция"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатУспех"].Видимость = Истина;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатОшибка"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_ТекстОшибки"].Видимость = Ложь;
	ИначеЕсли Состояние = "РезультатОшибка" Тогда
		
		Элементы[Инструмент.ИмяИнструмента+"_Операция"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатУспех"].Видимость = Ложь;
		Элементы[Инструмент.ИмяИнструмента+"_РезультатОшибка"].Видимость = Истина;
		Элементы[Инструмент.ИмяИнструмента+"_ТекстОшибки"].Видимость = Истина;
		Элементы[Инструмент.ИмяИнструмента+"_ТекстОшибки"].Заголовок = Инструмент.ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДокументовРезультатомВыполненияИнструмента(ИмяИнструмента)
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	УдалитьИзВременногоХранилища(АдресХранилища);
	
	Если ИмяИнструмента = "ИнструментЗаполненияПоШаблонамАналитик" Тогда
		ЗначениеВРеквизитФормы(РезультатВыполнения,"ДеревоДокументов");	
	ИначеЕсли ИмяИнструмента = "ИнструментЗаполненияПоДаннымДоговоров" Тогда
		ЗначениеВРеквизитФормы(РезультатВыполнения,"ДеревоДокументов");	
	ИначеЕсли ИмяИнструмента = "ИнструментЗаполненияПоИсторическимДанным" Тогда	
		
		Дерево = РеквизитФормыВЗначение("ДеревоДокументов");
		
		Для Каждого ЭлементМассива Из РезультатВыполнения.МассивДанныхМоделиПрогноза Цикл
			
			ОписаниеПрогнозируемойКолонки = ЭлементМассива.ОписаниеПрогнозируемойКолонки;
			ДанныеМоделиПрогноза = ЭлементМассива.ДанныеМоделиПрогноза;
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДанныеМоделиПрогноза.Контрагент КАК Контрагент,
				|	ДанныеМоделиПрогноза.Организация КАК Организация,
				|	ДанныеМоделиПрогноза.СчетОрганизации КАК СчетОрганизации,
				|	ДанныеМоделиПрогноза.Вероятность КАК Вероятность,
				|	&ПолеРешение КАК Решение
				|ПОМЕСТИТЬ ВТ_ДанныеМоделиПрогноза
				|ИЗ
				|	&ДанныеМоделиПрогноза КАК ДанныеМоделиПрогноза
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_ДанныеМоделиПрогноза.Контрагент КАК Контрагент,
				|	ВТ_ДанныеМоделиПрогноза.Организация КАК Организация,
				|	ВТ_ДанныеМоделиПрогноза.СчетОрганизации КАК СчетОрганизации,
				|	МАКСИМУМ(ВТ_ДанныеМоделиПрогноза.Вероятность) КАК Вероятность
				|ПОМЕСТИТЬ ВТ_МаксимальнаяВероятностьПрогноза
				|ИЗ
				|	ВТ_ДанныеМоделиПрогноза КАК ВТ_ДанныеМоделиПрогноза
				|
				|СГРУППИРОВАТЬ ПО
				|	ВТ_ДанныеМоделиПрогноза.Контрагент,
				|	ВТ_ДанныеМоделиПрогноза.Организация,
				|	ВТ_ДанныеМоделиПрогноза.СчетОрганизации
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Контрагент,
				|	Организация,
				|	СчетОрганизации
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_ДанныеМоделиПрогноза.Контрагент КАК Контрагент,
				|	ВТ_ДанныеМоделиПрогноза.Организация КАК Организация,
				|	ВТ_ДанныеМоделиПрогноза.СчетОрганизации КАК СчетОрганизации,
				|	МАКСИМУМ(ВТ_ДанныеМоделиПрогноза.Решение) КАК Решение
				|ИЗ
				|	ВТ_ДанныеМоделиПрогноза КАК ВТ_ДанныеМоделиПрогноза
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаксимальнаяВероятностьПрогноза КАК ВТ_МаксимальнаяВероятностьПрогноза
				|		ПО ВТ_ДанныеМоделиПрогноза.Контрагент = ВТ_МаксимальнаяВероятностьПрогноза.Контрагент
				|			И ВТ_ДанныеМоделиПрогноза.Организация = ВТ_МаксимальнаяВероятностьПрогноза.Организация
				|			И ВТ_ДанныеМоделиПрогноза.СчетОрганизации = ВТ_МаксимальнаяВероятностьПрогноза.СчетОрганизации
				|			И ВТ_ДанныеМоделиПрогноза.Вероятность = ВТ_МаксимальнаяВероятностьПрогноза.Вероятность
				|
				|СГРУППИРОВАТЬ ПО
				|	ВТ_ДанныеМоделиПрогноза.Контрагент,
				|	ВТ_ДанныеМоделиПрогноза.Организация,
				|	ВТ_ДанныеМоделиПрогноза.СчетОрганизации";
			
			Запрос.УстановитьПараметр("ДанныеМоделиПрогноза",ДанныеМоделиПрогноза);
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ПолеРешение",
				"ДанныеМоделиПрогноза." + ОписаниеПрогнозируемойКолонки.ИмяКолонки);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			ПриоритетыОтбора = Новый Массив;
			ПриоритетыОтбора.Добавить("Контрагент,Организация,СчетОрганизации");
			ПриоритетыОтбора.Добавить("Контрагент,Организация");
			ПриоритетыОтбора.Добавить("Контрагент");
			ПриоритетыОтбора.Добавить("СчетОрганизации");
			ПриоритетыОтбора.Добавить("Организация");
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Для Каждого ПриоритетОтбора Из ПриоритетыОтбора Цикл
				
					СтруктураОтбора = Новый Структура(ПриоритетОтбора);
					ЗаполнитьЗначенияСвойств(СтруктураОтбора,ВыборкаДетальныеЗаписи);
					СтрокиПервогоУровня = Дерево.Строки.НайтиСтроки(СтруктураОтбора);
					
					СтрокиНайдены = Ложь;
					
					Для Каждого СтрокаПервогоУровня Из СтрокиПервогоУровня Цикл
						
						Если ОписаниеПрогнозируемойКолонки.ТолькоПервыйУровеньДерева Тогда
							ЗаполнитьСтрокуДереваПоДаннымАнализаДанных(СтрокаПервогоУровня,
									ВыборкаДетальныеЗаписи, ОписаниеПрогнозируемойКолонки.ИмяКолонки);
						Иначе
							Для Каждого СтрокаВторогоУровня Из СтрокаПервогоУровня.Строки Цикл
								ЗаполнитьСтрокуДереваПоДаннымАнализаДанных(СтрокаВторогоУровня,
										ВыборкаДетальныеЗаписи, ОписаниеПрогнозируемойКолонки.ИмяКолонки);
							КонецЦикла;
						КонецЕсли;
						
						СтрокиНайдены = Истина;
						
					КонецЦикла;
					
					// Если строки были найдены по отбору, то прервем дальнейший поиск по приоритету отбора.
					Если СтрокиНайдены Тогда
						Прервать;
					КонецЕсли;
					
				 КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	
		ЗначениеВРеквизитФормы(Дерево, "ДеревоДокументов");
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСтрокуДереваПоДаннымАнализаДанных(СтрокаДерева, ДанныеЗаполнения, ИмяКолонки)

	Если Не ЗначениеЗаполнено(СтрокаДерева[ИмяКолонки]) Тогда
		
		СтрокаДерева[ИмяКолонки] = ДанныеЗаполнения.Решение;
		СтрокаДерева.РезультатЗаполненияАналитик = СтрокаДерева.РезультатЗаполненияАналитик
				+ НСтр("ru = 'По историческим данным при помощи дерева решений'")+";";
		
		Если СтрокаДерева.Родитель = Неопределено Тогда
			СтрокаДерева.ДанныеИзменены = Истина;
		Иначе
			СтрокаДерева.Родитель.ДанныеИзменены = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусВыполненияИнструмента(ТекущийИнструмент, ТекстОшибки = "")

	ТекущийИнструмент.Выполнено = Истина;
	ТекущийИнструмент.ТекстОшибки = ТекстОшибки;
	
КонецПроцедуры 

&НаКлиенте
Функция ТекущийИнструментЗаполненияАналитикВыписки()

	РезультатСтроки = ИнструментыЗаполнения.НайтиСтроки(Новый Структура("Выполнено,Выполнять", Ложь, Истина));
	
	Если РезультатСтроки.Количество() Тогда
		ТекущийИнструмент = РезультатСтроки[0];
	КонецЕсли;
	
	Возврат ТекущийИнструмент;
	
КонецФункции 

#КонецОбласти
