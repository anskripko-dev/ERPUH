#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Если Не ЗначениеЗаполнено(Параметры.АдресДвиженияОперации)
		ИЛИ Не ЗначениеЗаполнено(Параметры.ДокументПланирования) Тогда
		
		ВызватьИсключение НСтр("ru = 'Предусмотрено открытие обработки только из документов';
								|en = 'Data processor can be opened only from documents'");
	КонецЕсли;
	
	ЗаполнитьРезервы(Параметры.ДокументПланирования, Параметры.АдресДвиженияОперации, Параметры.ДатаПланирования);
	
	СуммаДокумента = Параметры.СуммаДокумента;  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметкиОбъектыРасчетов(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОтметкиОбъектыРасчетов(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	АдресОбъектовРасчетовВХранилище = ПоместитьРезервыВХранилище();
	Результат = Новый Структура("АдресОбъектовРасчетовВХранилище", АдресОбъектовРасчетовВХранилище);
	
	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьДействие(Команда)
	Закрыть(Неопределено);	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовРезервы

&НаКлиенте
Процедура РезервыПометкаПриИзменении(Элемент)

	СтрокаОбъекты = Элементы.Резервы.ТекущиеДанные;
	
	Если СтрокаОбъекты.Пометка Тогда
		СтрокаОбъекты.Сумма = СтрокаОбъекты.Резерв;
	Иначе
		СтрокаОбъекты.Сумма = 0;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РезервыЗаявленоПриИзменении(Элемент)
	
	СтрокаОбъекты = Элементы.Резервы.ТекущиеДанные;
	
	Если Не СтрокаОбъекты.Пометка Тогда
		СтрокаОбъекты.Пометка = Истина;
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРезервы(ДокументПланирования, АдресДвиженияОперации, ДатаПланирования)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДвиженияОперации.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	ДвиженияОперации.Аналитика1 КАК Аналитика1,
	|	ДвиженияОперации.Аналитика2 КАК Аналитика2,
	|	ДвиженияОперации.Аналитика3 КАК Аналитика3,
	|	ДвиженияОперации.Аналитика4 КАК Аналитика4,
	|	ДвиженияОперации.Аналитика5 КАК Аналитика5,
	|	ДвиженияОперации.Аналитика6 КАК Аналитика6,
	|	ДвиженияОперации.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТДвиженияОперации
	|ИЗ
	|	&ДвиженияОперации КАК ДвиженияОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.СтатьяБюджета КАК СтатьяБюджета,
	|	ВложенныйЗапрос.Аналитика1 КАК Аналитика1,
	|	ВложенныйЗапрос.Аналитика2 КАК Аналитика2,
	|	ВложенныйЗапрос.Аналитика3 КАК Аналитика3,
	|	ВложенныйЗапрос.Аналитика4 КАК Аналитика4,
	|	ВложенныйЗапрос.Аналитика5 КАК Аналитика5,
	|	ВложенныйЗапрос.Аналитика6 КАК Аналитика6,
	|	СУММА(ВложенныйЗапрос.Резерв) КАК Резерв,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
	|	МАКСИМУМ(ВложенныйЗапрос.Пометка) КАК Пометка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика1 КАК Аналитика1,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика2 КАК Аналитика2,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика3 КАК Аналитика3,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика4 КАК Аналитика4,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика5 КАК Аналитика5,
	|		ОперацииБюджетов.АналитикаСтатейБюджетов.Аналитика6 КАК Аналитика6,
	|		ОперацииБюджетов.ЛимитОборот КАК Резерв,
	|		0 КАК Сумма,
	|		ЛОЖЬ КАК Пометка
	|	ИЗ
	|		РегистрНакопления.ОперацииБюджетов.Обороты(
	|				&ДатаНачалаПериода,
	|				&ДатаКонцаПериода,
	|				,
	|				ОбъектПланирования.Объект = &ДокументПланирования
	|					И ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств)) КАК ОперацииБюджетов
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияОперации.СтатьяДвиженияДенежныхСредств,
	|		ДвиженияОперации.Аналитика1,
	|		ДвиженияОперации.Аналитика2,
	|		ДвиженияОперации.Аналитика3,
	|		ДвиженияОперации.Аналитика4,
	|		ДвиженияОперации.Аналитика5,
	|		ДвиженияОперации.Аналитика6,
	|		0,
	|		ДвиженияОперации.Сумма,
	|		ИСТИНА
	|	ИЗ
	|		ВТДвиженияОперации КАК ДвиженияОперации) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.СтатьяБюджета,
	|	ВложенныйЗапрос.Аналитика1,
	|	ВложенныйЗапрос.Аналитика2,
	|	ВложенныйЗапрос.Аналитика3,
	|	ВложенныйЗапрос.Аналитика4,
	|	ВложенныйЗапрос.Аналитика5,
	|	ВложенныйЗапрос.Аналитика6
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВложенныйЗапрос.Резерв) > 0
	|		ИЛИ СУММА(ВложенныйЗапрос.Сумма) > 0)";
	
	Запрос.УстановитьПараметр("ДокументПланирования", ДокументПланирования);
	Запрос.УстановитьПараметр("ДвиженияОперации", ПолучитьИзВременногоХранилища(АдресДвиженияОперации));   
	ДатаПланированияЛимитирования = ?(ЗначениеЗаполнено(ДатаПланирования),ДатаПланирования,ТекущаяДатаСеанса());
	ПараметрыЛимитированияПериода = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств, ДатаПланированияЛимитирования, -1);
	Если ПараметрыЛимитированияПериода <> Неопределено Тогда
		 // ПараметрыЛимитированияПериода.ПериодичностьЛимитирования	
		ДатаНачалаПериода = КэшируемыеПроцедурыУХ.ДатаНачалаПериода(ДатаПланированияЛимитирования,ПараметрыЛимитированияПериода.ПериодичностьЛимитирования);
		ДатаКонцаПериода = КэшируемыеПроцедурыУХ.ДатаКонцаПериода(ДатаПланированияЛимитирования,ПараметрыЛимитированияПериода.ПериодичностьЛимитирования);
	Иначе
		ДатаНачалаПериода = НачалоГода(ДатаПланированияЛимитирования);
		ДатаКонцаПериода = КонецГода(ДатаПланированияЛимитирования);
	КонецЕсли;            
		
	Запрос.УстановитьПараметр("ДвиженияОперации", ПолучитьИзВременногоХранилища(АдресДвиженияОперации));   
	Запрос.УстановитьПараметр("ДатаНачалаПериода", ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДатаКонцаПериода", ДатаКонцаПериода);
		
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаРезервы = Объект.Резервы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезервы, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Если Объект.Резервы.Количество() = 0 Тогда
		
		СтрокаРезервы = Объект.Резервы.Добавить();
		СтрокаРезервы.Сумма = СуммаДокумента;
		СтрокаРезервы.Пометка = Истина;
	
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкиОбъектыРасчетов(Отметка)

	Для Каждого СтрокаОбъекты Из Объект.Резервы Цикл
		СтрокаОбъекты.Пометка = Отметка;
		Если Отметка Тогда
			СтрокаОбъекты.Сумма = СтрокаОбъекты.Резерв;
		Иначе
			СтрокаОбъекты.Сумма = 0;
		КонецЕсли; 
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Функция ПоместитьРезервыВХранилище()
	
	ТабВыбранныхПозиций = Объект.Резервы.Выгрузить(Новый Структура("Пометка", Истина));
	АдресПозицийВХранилище = ПоместитьВоВременноеХранилище(ТабВыбранныхПозиций);
	
	Возврат АдресПозицийВХранилище;
	
КонецФункции

#КонецОбласти	
