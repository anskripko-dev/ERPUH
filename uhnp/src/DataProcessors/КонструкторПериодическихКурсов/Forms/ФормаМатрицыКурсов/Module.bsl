
&НаКлиенте
Перем НастройкиИзменены;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПраваДоступа = ОбщегоНазначенияПовтИспУХ.ПраваДоступаБюджетирование();
	Элементы.ГруппаДополнительно.Видимость = ПраваДоступа.ПериодическиеКурсы_Изменение;
	Элементы.ПолеТабличногоДокументаМакетКонтекстноеМенюКомманды.Видимость = ПраваДоступа.ПериодическиеКурсы_Изменение;
		
	ВосстановитьНастройкиФормы();
		
	ЗаполнитьДеревоВалют();
		
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьТекущуюОбласть(тСтрока)
	
	Если ТипЗнч(тСтрока) = Тип("СправочникСсылка.СтрокиОтчетов") Тогда
		
		Для Инд = 1 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл	
			ТекущаяОбласть				= ПолеТабличногоДокументаМакет.Область(Инд,1,Инд,1);
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(ТекущаяОбласть);
			Если ТипЗнч(ТекущаяОбласть.Расшифровка) = Тип("Структура") И ТекущаяОбласть.Расшифровка.Свойство("Строка") И ТекущаяОбласть.Расшифровка.Строка = тСтрока Тогда		
				Элементы.ПолеТабличногоДокументаМакет.ТекущаяОбласть = ТекущаяОбласть;
				Элементы.ПолеТабличногоДокументаМакет.УстановитьВыделенныеОбласти(МассивОбластей);
				Возврат;
			КонецЕсли;							
		КонецЦикла;	
	Иначе	
		
		Для Инд = 1 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл	
			ТекущаяОбласть				= ПолеТабличногоДокументаМакет.Область(1,Инд,1,Инд);
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(ТекущаяОбласть);
			
			
			Если ТипЗнч(ТекущаяОбласть.Расшифровка) = Тип("Структура") И ТекущаяОбласть.Расшифровка.Свойство("Колонка") И ТекущаяОбласть.Расшифровка.Колонка = тСтрока Тогда		
				Элементы.ПолеТабличногоДокументаМакет.ТекущаяОбласть = ТекущаяОбласть;
				Элементы.ПолеТабличногоДокументаМакет.УстановитьВыделенныеОбласти(МассивОбластей);
				Возврат;
			КонецЕсли;	
			
		КонецЦикла;	
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеТабличногоДокументаМакетВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если НЕ Элементы.ГруппаДополнительно.Видимость Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Область.Расшифровка) = Тип("Структура") И Область.Расшифровка.Свойство("Ресурс") Тогда
		СтандартнаяОбработка = Истина;
	Иначе	
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоВалют()
		
	Если НЕ ЗначениеЗаполнено(Сценарий)
		ИЛИ НЕ ЗначениеЗаполнено(ПериодПланированияОтборНачало) Тогда
		УстановитьСостояниеНеИспользовать();
	Иначе	
		СброситьСостояниеНеИспользовать();
		ДеревоНастройкиСервер 	= ВывестиДеревоСтруктурыСтрок();
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Функция ВывестиДеревоСтруктурыСтрок() Экспорт
	
	РезультатФункции 		= Новый ДеревоЗначений;
	тРеквизитыСтрок 		= "";
	тРеквизитыПоказателей   = "";
	
	РезультатФункции.Колонки.Добавить("Валюта",, Нстр("ru = 'Валюта'"));
	РезультатФункции.Колонки.Добавить("КурсНаНачалоПериода",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4), Нстр("ru = 'Курс на начало периода'"));
    РезультатФункции.Колонки.Добавить("КурсНаКонецПериода",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4), Нстр("ru = 'Курс на конец периода'"));	
	РезультатФункции.Колонки.Добавить("СреднийКурсЗаПериод",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4), Нстр("ru = 'Средний курс'"));
	РезультатФункции.Колонки.Добавить("СреднийКурсЗаПериодМСФО",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4), Нстр("ru = 'Средний курc МСФО'"));
	РезультатФункции.Колонки.Добавить("СреднийКурсЗаПериодЦБ",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4), Нстр("ru = 'Средний курc (ЦБ)'"));
	РезультатФункции.Колонки.Добавить("Кратность",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0), Нстр("ru = 'Кратность'"));
	
	тКолонки.Очистить();
	
	Для Каждого СтрКол Из РезультатФункции.Колонки Цикл	
		нКолонка 						= тКолонки.Добавить();
		нКолонка.Код        			= СтрКол.Имя;
		нКолонка.Представление        	= СтрКол.Заголовок;	
	КонецЦикла;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Периоды.Ссылка КАК Период
	|ПОМЕСТИТЬ втПериоды
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.ПометкаУдаления = ЛОЖЬ
	|	И Периоды.ДатаНачала >= &ДатаНачала
	|	И Периоды.ДатаОкончания <= &ДатаОкончания
	|	И Периоды.Периодичность = &Периодичность
	|	И Периоды.Произвольный = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Валюты.Ссылка КАК Валюта,
	|	втПериоды.Период КАК Период
	|ПОМЕСТИТЬ втПериодыВалюты
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|		ПОЛНОЕ СОЕДИНЕНИЕ втПериоды КАК втПериоды
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Валюты.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПериодыВалюты.Валюта КАК Валюта,
	|	ПериодическиеКурсы.Сценарий КАК Сценарий,
	|	втПериодыВалюты.Период КАК ПериодКурса,
	|	ПериодическиеКурсы.СреднийКурсЗаПериод КАК СреднийКурсЗаПериод,
	|	ПериодическиеКурсы.СреднийКурсЗаПериодМСФО КАК СреднийКурсЗаПериодМСФО,
	|	ПериодическиеКурсы.КурсНаНачалоПериода КАК КурсНаНачалоПериода,
	|	ПериодическиеКурсы.КурсНаКонецПериода КАК КурсНаКонецПериода,
	|	ПериодическиеКурсы.СреднийКурсЗаПредыдущийПериод КАК СреднийКурсЗаПредыдущийПериод,
	|	ПериодическиеКурсы.КурсНаКонецПредыдущегоПериода КАК КурсНаКонецПредыдущегоПериода,
	|	ПериодическиеКурсы.Кратность КАК Кратность,
	|	ПериодическиеКурсы.СреднийКурсЗаПериодЦБ КАК СреднийКурсЗаПериодЦБ,
	|	ПериодическиеКурсы.СреднийКурсЗаПредыдущийПериодЦБ КАК СреднийКурсЗаПредыдущийПериодЦБ
	|ИЗ
	|	втПериодыВалюты КАК втПериодыВалюты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПериодическиеКурсы КАК ПериодическиеКурсы
	|		ПО втПериодыВалюты.Валюта = ПериодическиеКурсы.Валюта
	|			И втПериодыВалюты.Период = ПериодическиеКурсы.ПериодКурса
	|			И (ПериодическиеКурсы.Сценарий = &Сценарий)
	|
	|УПОРЯДОЧИТЬ ПО
	|	втПериодыВалюты.Период.ДатаНачала
	|ИТОГИ ПО
	|	Валюта";
		
	Запрос.УстановитьПараметр("ДатаНачала", 		ПериодПланированияОтборНачало.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 		ПериодПланированияОтборОкончание.ДатаОкончания);
    Запрос.УстановитьПараметр("Периодичность", 		Периодичность);
	Запрос.УстановитьПараметр("Сценарий", 			Сценарий);
	
	Если ЗначениеЗаполнено(Валюта) тогда
		
		УсловиеИсходное = "Валюты.ПометкаУдаления = ЛОЖЬ";
		УсловиеНовое 	= "Валюты.ПометкаУдаления = ЛОЖЬ И Валюты.Ссылка = &Валюта";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, УсловиеИсходное, УсловиеНовое);
		
		Запрос.УстановитьПараметр("Валюта", Валюта);
		
	КонецЕсли;
			
	ПолеТабличногоДокументаМакет.Очистить();
	СтруктураШаблонов = ПодготовитьМакетШаблоновВывода();
	
	ПолеТабличногоДокументаМакет.Вывести(СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонЗаголовка.ПолучитьОбласть("ШаблонВыводаЗаголовка"));
	
	ВыводимаяСтрокаОтчета=Справочники.СтрокиОтчетов.ПустаяСсылка();
	
	СоответствиеСтрок			=	Новый Соответствие;
	СоответствиеРодителей		=	Новый Соответствие;
	
	ДеревоНастройкиСервер_Строки 		= Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
			
	ДеревоНастройкиСервер_СтрокиАдрес 	= ПоместитьВоВременноеХранилище(ДеревоНастройкиСервер_Строки,ЭтаФорма.УникальныйИдентификатор);
	
	
	Если ДеревоНастройкиСервер_Строки.Строки.Количество()>0 Тогда
		ПодготовитьТаблицыПоДеревуРекурсивноВалюты(ДеревоНастройкиСервер_Строки,СтруктураШаблонов);		
	КонецЕсли;
	
	
	ПолеТабличногоДокументаМакет.Область(1,0,1,0).ВысотаСтроки 	= 50;
	ПолеТабличногоДокументаМакет.Область(0,1,0,1).ШиринаКолонки = 50;

	
	ПолеТабличногоДокументаМакет.ФиксацияСлева = РеквизитыСтрок.Количество();
	ПолеТабличногоДокументаМакет.ФиксацияСверху = 1;
	
	
	Возврат РезультатФункции;
	
	
КонецФункции		

&НаСервере
Функция ПодготовитьМакетШаблоновВывода();
	
		
	СтруктураОтвета = Новый Структура;
	
	ПолеТабличногоДокументаМакетШаблонЗаголовка 	= Новый ТабличныйДокумент;
	
	Обработка 				= РеквизитФормыВЗначение("Объект");
	МакетШаблонаСтроки 		= Обработка.ПолучитьМакет("МакетШаблонОформленияСтроки"); 
	МакетШаблонаКолонки 	= Обработка.ПолучитьМакет("МакетШаблонОформленияКолонки");
	
	//Выводим шапку строк	
	ОбластьЗаголовокШапки = МакетШаблонаСтроки.ПолучитьОбласть("ОбластьШапкаТаблицы");
	
	//Выводим шапку реквизитов строк
	ОбластьЗаголовокКолонки = МакетШаблонаКолонки.ПолучитьОбласть("ОбластьКолонкаШапки");
	
	ИндексПервогоРеквизита = Истина;
		
			
	//Выводим шапку колонок
	
	Для Каждого СтрКол Из тКолонки Цикл
		
		СтруктураРасшифровки = Новый Структура();
		СтруктураРасшифровки.Вставить("КолонкаКод",СокрЛП(СтрКол.Код));
		СтруктураРасшифровки.Вставить("КолонкаНаименование",СтрКол.Представление);
		
		ПолеТабличногоДокументаМакетШаблонЗаголовка.Присоединить(ОбластьЗаголовокКолонки);
		ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы,1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы).Текст = СтрКол.Представление;
		ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы,1,ПолеТабличногоДокументаМакетШаблонЗаголовка.ШиринаТаблицы).Расшифровка = СтруктураРасшифровки;
		
	КонецЦикла;	
				
	ПолеТабличногоДокументаМакетШаблонЗаголовка.Область(1,0,1,0).Имя = "ШаблонВыводаЗаголовка";
	
	ПолеТабличногоДокументаМакетШаблонСтроки 			= Новый ТабличныйДокумент;
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог 		= Новый ТабличныйДокумент;
	
	ОбластьЗаголовокСтороки 			= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаСтроки");
	ОбластьЗаголовокПоказателя 			= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаПоказателя");
	
	ОбластьЗаголовокСторокиИтог 		= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаСтрокиИтог");
	ОбластьЗаголовокПоказателяИтог 		= МакетШаблонаКолонки.ПолучитьОбласть("ОбластьЗаголовкаПоказателяИтог");
		
	//Выводим шаблон для колонок отчета
	
	Для Каждого СтрКол Из тКолонки Цикл				
		ПолеТабличногоДокументаМакетШаблонСтроки.Присоединить(ОбластьЗаголовокПоказателя);	
		ПолеТабличногоДокументаМакетШаблонСтрокиИтог.Присоединить(ОбластьЗаголовокПоказателяИтог);	
	КонецЦикла;	
	
		
	ПолеТабличногоДокументаМакетШаблонСтроки.Область(1,0,1,0).Имя = "ШаблонВыводаСтроки";
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог.Область(1,0,1,0).Имя = "ШаблонВыводаСтроки";
	
	
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонЗаголовка",ПолеТабличногоДокументаМакетШаблонЗаголовка);
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонСтроки",ПолеТабличногоДокументаМакетШаблонСтроки);
	СтруктураОтвета.Вставить("ПолеТабличногоДокументаМакетШаблонСтрокиИтог",ПолеТабличногоДокументаМакетШаблонСтрокиИтог);
	
	Возврат СтруктураОтвета;
	
КонецФункции
		

#КонецОбласти

&НаСервере
Процедура ПодготовитьТаблицыПоДеревуРекурсивноВалюты(тДеревоВыбранныхСтрок,СтруктураШаблонов)
	
	Для Каждого Стр Из тДеревоВыбранныхСтрок.Строки Цикл	
		
		
		ВывестиСтрокуВТабличныйДокументФормулы(Стр,СтруктураШаблонов);
		
		Если Стр.Уровень()>0 Тогда 		
			ПолеТабличногоДокументаМакет.НачатьГруппуСтрок();	 
		КонецЕсли;
		
		ПодготовитьТаблицыПоДеревуРекурсивноВалюты(Стр,СтруктураШаблонов);		
		
		Если Стр.Уровень()>0 Тогда 
			Попытка
				ПолеТабличногоДокументаМакет.ЗакончитьГруппуСтрок() 
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуВТабличныйДокументФормулы(СтрокаВыборки,СтруктураШаблонов);
	
	
	ПолеТабличногоДокументаМакетШаблонСтрокиИтог 	= СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонСтрокиИтог;
	ОбластьШаблонСторокиИтог                     	= ПолеТабличногоДокументаМакетШаблонСтрокиИтог.ПолучитьОбласть("ШаблонВыводаСтроки");
	
	ПолеТабличногоДокументаМакетШаблонСтроки	 	= СтруктураШаблонов.ПолеТабличногоДокументаМакетШаблонСтроки;
	ОбластьШаблонСтороки	                     	= ПолеТабличногоДокументаМакетШаблонСтроки.ПолучитьОбласть("ШаблонВыводаСтроки");
	
	
	Если СтрокаВыборки.Строки.Количество() = 0 Тогда
		ПолеТабличногоДокументаМакет.Вывести(ОбластьШаблонСтороки);
	Иначе
		ПолеТабличногоДокументаМакет.Вывести(ОбластьШаблонСторокиИтог);
	КонецЕсли;	
	
	Если СтрокаВыборки.Уровень() = 0 Тогда
		
		СтруктураРасшифровки 	= Новый Структура;
		СтруктураРасшифровки.Вставить("Валюта",СтрокаВыборки.Валюта);
		
		тЯчейка 				= ПолеТабличногоДокументаМакет.Область(ПолеТабличногоДокументаМакет.ВысотаТаблицы,1,ПолеТабличногоДокументаМакет.ВысотаТаблицы,1);
		тЯчейка.Текст           = СтрокаВыборки.Валюта;	
		тЯчейка.Расшифровка 	= СтруктураРасшифровки;
		тЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	Иначе	
		
		СтруктураРасшифровки 	= Новый Структура;
		СтруктураРасшифровки.Вставить("Валюта",СтрокаВыборки.Валюта);
		СтруктураРасшифровки.Вставить("ПериодКурса",СтрокаВыборки.ПериодКурса);
		
		тЯчейка 				= ПолеТабличногоДокументаМакет.Область(ПолеТабличногоДокументаМакет.ВысотаТаблицы,1,ПолеТабличногоДокументаМакет.ВысотаТаблицы,1);
		тЯчейка.Текст           = СтрокаВыборки.ПериодКурса;	
		тЯчейка.Отступ          = 2;									
		тЯчейка.Шрифт          	= Новый Шрифт(тЯчейка.Шрифт,,,Ложь);
		тЯчейка.Расшифровка 	= СтруктураРасшифровки;
		тЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
				
		НачальныйИндексКолонокПоказателей = 2;

		Для Каждого СтрКол Из тКолонки Цикл
			
			Если Не СтрКол.Код = "Валюта" Тогда
				
				
				СтруктураРасшифровки 	= Новый Структура;
				СтруктураРасшифровки.Вставить("Валюта",СтрокаВыборки.Валюта);
				СтруктураРасшифровки.Вставить("ПериодКурса",СтрокаВыборки.ПериодКурса);
				СтруктураРасшифровки.Вставить("Ресурс",СтрКол.Код);

				тЯчейка 				= ПолеТабличногоДокументаМакет.Область(ПолеТабличногоДокументаМакет.ВысотаТаблицы,НачальныйИндексКолонокПоказателей,ПолеТабличногоДокументаМакет.ВысотаТаблицы,НачальныйИндексКолонокПоказателей);										
				тЯчейка.Шрифт          	= Новый Шрифт(тЯчейка.Шрифт,,,Ложь);
				тЯчейка.Расшифровка 	= СтруктураРасшифровки;
				тЯчейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
				//тЯчейка.Текст = Формат( ?(СтрокаВыборки[СтрКол.Код]=null,0,СтрокаВыборки[СтрКол.Код]),"ЧДЦ=4;ЧН=0,0000");
				тЯчейка.СодержитЗначение = Истина;
				Если СтрКол.Код = "Кратность" Тогда
					тЯчейка.ТипЗначения =  ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,0,ДопустимыйЗнак.Неотрицательный);
				Иначе
					тЯчейка.ТипЗначения =  ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10,4,ДопустимыйЗнак.Неотрицательный);
					тЯчейка.Формат =  "ЧДЦ=4;ЧН=0,0000";
				КонецЕсли;
				тЯчейка.Значение = ?(СтрокаВыборки[СтрКол.Код]=null,0,СтрокаВыборки[СтрКол.Код]);
				
				НачальныйИндексКолонокПоказателей = НачальныйИндексКолонокПоказателей+1;
				
			КонецЕсли;	
			
		КонецЦикла;	
			
	КонецЕсли;	
					
			
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	ПрименитьИзменения();
	
	ЛогИзмененныхКурсов.Очистить();
	
	Элементы.ГруппаПрименитьОтменить.Доступность = Ложь;
	
	ЗаполнитьДеревоВалют();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("СтандартныйПериод") Тогда
		
		РезультатДатаНачала = РезультатВыбора.ДатаНачала;
		РезультатДатаОкончания = РезультатВыбора.ДатаОкончания;
		
		Если (ЗначениеЗаполнено(РезультатДатаНачала)) И (ЗначениеЗаполнено(РезультатДатаОкончания)) Тогда
			
			ПериодыУХПовтИсп.ПроверитьИнтервалПериодов(РезультатДатаНачала, РезультатДатаОкончания, Периодичность);
			
			ПериодПланированияОтборНачало		 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатВыбора.ДатаНачала, Периодичность);
			ПериодПланированияОтборОкончание	 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатВыбора.ДатаОкончания, Периодичность);
			
		КонецЕсли;
		
		ЗаполнитьДеревоВалют();

		
	ИначеЕсли РезультатВыбора = Неопределено Тогда	
		// Пользователь отказался. Не изменяем периоды.
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный вариант периода ""%Период%"". Операция отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Период%", Строка(РезультатВыбора));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Команда)
	
	ПустаяДата = Дата(1, 1, 1);
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Если ЗначениеЗаполнено(ПериодПланированияОтборНачало) Тогда
		Диалог.Период.ДатаНачала	 = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодПланированияОтборНачало, "ДатаНачала");
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодПланированияОтборОкончание) Тогда
		Диалог.Период.ДатаОкончания	 = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодПланированияОтборОкончание, "ДатаОкончания");
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	НастройкиИзменены = Истина;
	ЗаполнитьДеревоВалют();

КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	НастройкиИзменены = Истина;
	
	ДатаНачала = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодПланированияОтборНачало, "ДатаНачала");
	ДатаОкончания = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(ПериодПланированияОтборОкончание, "ДатаОкончания");
	
	Если (ЗначениеЗаполнено(ДатаНачала)) И (ЗначениеЗаполнено(ДатаОкончания)) Тогда
		
		ПериодыУХПовтИсп.ПроверитьИнтервалПериодов(ДатаНачала, ДатаОкончания, Периодичность);
		
		ПериодПланированияОтборНачало		 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ДатаНачала, Периодичность);
		ПериодПланированияОтборОкончание	 = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ДатаОкончания, Периодичность);
		
	КонецЕсли;
	
	ЗаполнитьДеревоВалют();

КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	НастройкиИзменены = Истина;
	ЗаполнитьДеревоВалют();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоФактичесикмДанным(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоФактичесикмДаннымВопрос",ЭтаФорма);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Плановые курсы будут заполнены на основании регистра ""Курсы валют"". Продолжить?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоФактичесикмДаннымВопрос(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда	
		 ОбновитьТаблицуКурсов();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуКурсов()
	
	ЛогИзмененныхКурсов.Очистить();
	
	МассивПериодов = ПериодыУХ.ПолучитьПодчиненныеПериодыТаблица(ПериодПланированияОтборНачало, ПериодПланированияОтборОкончание);
	
	ВыборкаВалюты = Справочники.Валюты.Выбрать();
	
	Пока ВыборкаВалюты.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Валюта) И НЕ ВыборкаВалюты.Ссылка = Валюта Тогда
			 Продолжить;
		КонецЕсли;	
		
		Для Каждого СтрПериод Из МассивПериодов Цикл
			
			ТаблицаКурсов = ОбщегоНазначенияСерверУХ.ЗаполнитьПериодическиеКурсыВалют(ПериодПланированияОтборНачало,Сценарий,ПериодПланированияОтборОкончание);
			
			ТаблицаКурсов = ТаблицаКурсов.Скопировать(Новый Структура("Валюта",ВыборкаВалюты.Ссылка));
			
			Для Каждого Элемент ИЗ ТаблицаКурсов Цикл
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","КурсНаНачалоПериода");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","КурсНаКонецПериода");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","СреднийКурсЗаПериод");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","СреднийКурсЗаПериодМСФО");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","СреднийКурсЗаПериодЦБ");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
				СтруткураРасшифровки = Новый Структура;
				СтруткураРасшифровки.Вставить("ПериодКурса",СтрПериод.ПериодКурса);
				СтруткураРасшифровки.Вставить("Валюта",Элемент.Валюта);
				СтруткураРасшифровки.Вставить("Ресурс","Кратность");
				
				ДобавитьЗаписьВЛог(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				ОбновитьЗначениеЯчейки(Элемент[СтруткураРасшифровки.Ресурс],СтруткураРасшифровки);
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьЗначениеЯчейки(Значение,СтруткураРасшифровки)
	
	тВалюта     = ПолеТабличногоДокументаМакет.НайтиТекст(Строка(СтруткураРасшифровки.Валюта));	
	тСтрока  	= ПолеТабличногоДокументаМакет.НайтиТекст(Строка(СтруткураРасшифровки.ПериодКурса),тВалюта);
	
	тКолонка = Неопределено;
	Для ИндКол =2 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
		Если  ПолеТабличногоДокументаМакет.Область(1,ИндКол,1,ИндКол).Расшифровка.КолонкаКод = СтруткураРасшифровки.Ресурс Тогда	
			тКолонка = ПолеТабличногоДокументаМакет.Область(1,ИндКол,1,ИндКол);
			Прервать;
		КонецЕсли;		
	КонецЦикла;	
		
	Если тСтрока = Неопределено ИЛИ тКолонка = Неопределено Тогда	
		Возврат;	
	КонецЕсли;
		
	ПолеТабличногоДокументаМакет.Область(тСтрока.Верх,тКолонка.Лево,тСтрока.Верх,тКолонка.Лево).Значение = Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеТабличногоДокументаМакетПриИзменении(Элемент)
	
	ДобавитьЗаписьВЛог(ПолеТабличногоДокументаМакет.ТекущаяОбласть.Значение,ПолеТабличногоДокументаМакет.ТекущаяОбласть.Расшифровка)
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписьВЛог(Значение,СтруктураРасшифровки)
	
	Если Не ТипЗнч(СтруктураРасшифровки) = Тип("Структура") Тогда
		 Возврат;
	КонецЕсли;	
	
	тЗначение = ЛогИзмененныхКурсов.НайтиСтроки(Новый Структура("Валюта,ПериодКурса",СтруктураРасшифровки.Валюта,СтруктураРасшифровки.ПериодКурса));
	
	Если тЗначение.Количество() = 1 Тогда	
		тСтрокаЛога = тЗначение[0];
	Иначе
		тСтрокаЛога 						= ЛогИзмененныхКурсов.Добавить();
		тСтрокаЛога.ПериодКурса 			= СтруктураРасшифровки.ПериодКурса;
		тСтрокаЛога.Валюта 					= СтруктураРасшифровки.Валюта;
		тСтрокаЛога.КурсНаНачалоПериода 	= -1;
        тСтрокаЛога.КурсНаКонецПериода	 	= -1;
        тСтрокаЛога.СреднийКурсЗаПериод	 	= -1;
		тСтрокаЛога.СреднийКурсЗаПериодМСФО	= -1;
		тСтрокаЛога.СреднийКурсЗаПериодЦБ	= -1;
		тСтрокаЛога.Кратность				= 1;	
	КонецЕсли;	   
	
	тСтрокаЛога[СтруктураРасшифровки.Ресурс] = Значение;
	
	Элементы.ГруппаПрименитьОтменить.Доступность = Истина;
	
КонецПроцедуры	 

&НаКлиенте
Процедура Отменить(Команда)
	
	ЛогИзмененныхКурсов.Очистить();
	
	ЗаполнитьДеревоВалют();
	
	Элементы.ГруппаПрименитьОтменить.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьИзБуфера(Команда)	
	
	ОбъектКопирования = Новый COMОбъект("htmlfile");
	ДанныеБуфера =ОбъектКопирования.ParentWindow.ClipboardData.GETdata("Text");
	МассивСтрок = Новый Массив;
    МассивЗначений = Новый Массив;		
	Если КодСимвола(Прав(ДанныеБуфера,1)) = 10 И КодСимвола(Прав(ДанныеБуфера,2)) = 13 Тогда	
		 ДанныеБуфера = Лев(ДанныеБуфера,СтрДлина(ДанныеБуфера)-2);	
	КонецЕсли;	
	РазобратьДанныеБУфера(ДанныеБуфера,МассивСтрок,МассивЗначений);
	Для Каждого Область Из ПолеТабличногоДокументаМакет.ВыделенныеОбласти Цикл
		ВставитьЗначениеВОбласть(ПолеТабличногоДокументаМакет,Область.Имя,МассивЗначений);
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура РазобратьДанныеБуфера(ДанныеБуфера,МассивСтрок,МассивЗначений)
		     	
	МассивСтрок = СтроковыеФункцииКлиентСерверУХ.РазложитьСтрокуВМассивПодстрок(ДанныеБуфера,Символ(13));	
	Для Каждого Стр Из МассивСтрок Цикл
		Если Лев(Стр,1) = Символ(10) Тогда
			МассивЗначенийСтроки =  СтроковыеФункцииКлиентСерверУХ.РазложитьСтрокуВМассивПодстрок(Прав(Стр,СтрДлина(Стр)-1),"	");
		Иначе
			МассивЗначенийСтроки =  СтроковыеФункцииКлиентСерверУХ.РазложитьСтрокуВМассивПодстрок(Стр,"	");
		КонецЕсли;
		МассивЗначений.Добавить(МассивЗначенийСтроки);
	КонецЦикла;
		 		
КонецПроцедуры

Процедура ВставитьЗначениеВОбласть(ПолеТабличногоДокументаМакет,ИмяОбласти,Значение,КодРесурса="");
		
	ТабИзмененныхДанных = Неопределено;
	
			
	ОблДляВставки=ПолеТабличногоДокументаМакет.Область(ИмяОбласти);
	ОС=ПолеТабличногоДокументаМакет.ПолучитьОбласть(ИмяОбласти);
		
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		МассивДляВставки = Значение; 
	КонецЕсли;
	
	//Нечего вставлять - возвращаемся
	Если МассивДляВставки.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	ОднаЯчейка = Ложь;
		
	//Выделяли одну ячейку и вставлем одно значение в нее
	Если МассивДляВставки.Количество()=1 И МассивДляВставки[0].Количество()=1 И ОблДляВставки.Лево=ОблДляВставки.Право И ОблДляВставки.Верх=ОблДляВставки.Низ тогда
	    ОднаЯчейка=Истина;
	    ЗначениеДляВставки=МассивДляВставки[0][0];
	КонецЕсли;
	
	//Определим размер вставляемой области
	МаксКоличествоХ = 0;
	МаксКоличествоУ = МассивДляВставки.Количество();

	Для Каждого Элстроки Из МассивДляВставки Цикл
		Если Элстроки.Количество()>МаксКоличествоХ Тогда
			 МаксКоличествоХ =Элстроки.Количество(); 
		КонецЕсли;		
	КонецЦикла;
	
	//Видимо вставляем только пустые значения по Х или 0, если число
	Если МаксКоличествоХ = 0 Тогда
		 ЗначениеДляВставки = "";
	КонецЕсли;
		
	ОднаКолонка = Ложь;
	ОднаСтрока=Ложь;
	
	Если МаксКоличествоУ=1 И МаксКоличествоХ>1 тогда
		ОднаСтрока=Истина;
	КонецЕсли;
	Если МаксКоличествоУ>1 И МаксКоличествоХ=1 тогда
		ОднаКолонка=Истина;
	КонецЕсли;
	
	Если ОднаЯчейка Тогда
		Если  ОблДляВставки.СодержитЗначение Тогда
			ДобавитьЗаписьВЛог(Число(ЗначениеДляВставки),ОблДляВставки.Расшифровка);
			ОблДляВставки.Значение = ЗначениеДляВставки;		
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	//Если выделено много ячеек, а вставляется одно значение - то копируем его  во все
	Если МаксКоличествоУ=1 И  МаксКоличествоХ=1 Тогда
		
		Для ИндексСтрока = ОблДляВставки.Верх По ОблДляВставки.Низ Цикл
			Для ИндексКолонка = ОблДляВставки.Лево По ОблДляВставки.Право Цикл
				НужноеЗначение = МассивДляВставки[0][0];
				ТекОбласть = ПолеТабличногоДокументаМакет.Область(ИндексСтрока,ИндексКолонка,ИндексСтрока,ИндексКолонка);
				Если  ТекОбласть.СодержитЗначение Тогда
					ДобавитьЗаписьВЛог(Число(НужноеЗначение),ТекОбласть.Расшифровка);
					ТекОбласть.Значение = НужноеЗначение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	ИндХ = 1;
	ИндУ = 1;

	//Границы области = границы вставки
	//Во всех остальных случаях размер области вставки корректируется  автоматически по размеру буфера	
	Для ИндексСтрока = ОблДляВставки.Верх По ОблДляВставки.Верх+МаксКоличествоУ-1 Цикл
		
		Если ИндХ>МаксКоличествоУ Тогда
			ИндХ = 1;		
		КонецЕсли;
		
		Для ИндексКолонка = ОблДляВставки.Лево По ОблДляВставки.Лево+МаксКоличествоХ-1 Цикл
			
			Если ИндУ>МаксКоличествоХ Тогда
				ИндУ = 1;
			КонецЕсли;
			
			Если МассивДляВставки[ИндХ-1].Количество()<ИндУ Тогда
				НужноеЗначение = 0;
			Иначе	
				НужноеЗначение = МассивДляВставки[ИндХ-1][ИндУ-1];
			КонецЕсли;			
			
			ТекОбласть = ПолеТабличногоДокументаМакет.Область(ИндексСтрока,ИндексКолонка,ИндексСтрока,ИндексКолонка);
			
			ДобавитьЗаписьВЛог(Число(НужноеЗначение),ТекОбласть.Расшифровка);
			ТекОбласть.Значение = НужноеЗначение;
			
			ИндУ = ИндУ+1;
			
		КонецЦикла;
		
		ИндХ = ИндХ+1;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ПрименитьИзменения()
	
	Для Каждого Стр Из ЛогИзмененныхКурсов Цикл
				
		
		НаборЗаписей = РегистрыСведений.ПериодическиеКурсы.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Валюта.Установить(Стр.Валюта); 
		НаборЗаписей.Отбор.ПериодКурса.Установить(Стр.ПериодКурса);
		НаборЗаписей.Отбор.Сценарий.Установить(Сценарий);
		
		НаборЗаписей.Прочитать();
		
		тНабор = НаборЗаписей.Выгрузить();
		
		Если тНабор.Количество() = 1 Тогда	
			нСтрока = тНабор[0];	
		Иначе		
			нСтрока 					= тНабор.Добавить();
			нСтрока.Валюта 				= Стр.Валюта;
			нСтрока.ПериодКурса         = Стр.ПериодКурса;
			нСтрока.Сценарий            = Сценарий;	
		КонецЕсли;	
		
		Если Стр.КурсНаНачалоПериода>0 Тогда
			нСтрока.КурсНаНачалоПериода = Стр.КурсНаНачалоПериода;
		КонецЕсли;	
		
		Если Стр.КурсНаКонецПериода>0 Тогда
			нСтрока.КурсНаКонецПериода = Стр.КурсНаКонецПериода;
		КонецЕсли;	
		
		Если Стр.СреднийКурсЗаПериод>0 Тогда
			нСтрока.СреднийКурсЗаПериод = Стр.СреднийКурсЗаПериод;
		КонецЕсли;	
		
		Если Стр.СреднийКурсЗаПериодМСФО>0 Тогда
			нСтрока.СреднийКурсЗаПериодМСФО = Стр.СреднийКурсЗаПериодМСФО;
		КонецЕсли;	
		
		Если Стр.СреднийКурсЗаПериодЦБ>0 Тогда
			нСтрока.СреднийКурсЗаПериодЦБ = Стр.СреднийКурсЗаПериодЦБ;
		КонецЕсли;	
		
		Если Стр.Кратность>0 Тогда
			нСтрока.Кратность = Стр.Кратность;
		Иначе	
			нСтрока.Кратность = 1;
		КонецЕсли;	

		
		НаборЗаписей.Загрузить(тНабор);
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;	
	
	// Пересчитываем показатели по другим курсам.
	ТаблицаИзмененныхКурсов=ПодготовитьТаблицуИзмененийКурсов(ЛогИзмененныхКурсов);	
	УправлениеОтчетамиУХ.ПересчитатьВалютныеПоказатели(Сценарий, ТаблицаИзмененныхКурсов);
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ИзменитьПоказатели(Команда)
		
	Оповещение = Новый ОписаниеОповещения("ИзменениеПоказателей", ЭтаФорма);
	
	ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаИзмененияПоказателей", 
	, ЭтаФорма,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаКлиенте
Процедура ИзменениеПоказателей(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	ОписаниеИзменений = "";
	
	Для Каждого Область Из ПолеТабличногоДокументаМакет.ВыделенныеОбласти Цикл
		ИзменитьПоказателиСервер(Область.Имя,Результат);
	КонецЦикла;
		
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПоказателиСервер(ИмяОбласти,СтруктураПараметров)
		
	ОблДляВставки=ПолеТабличногоДокументаМакет.Область(ИмяОбласти);
		
	Если ОблДляВставки.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Таблица Тогда
		оВерх 	=  ПолеТабличногоДокументаМакет.ФиксацияСверху+1;
		оНиз  	=  ПолеТабличногоДокументаМакет.ВысотаТаблицы;
		оЛево 	=  ПолеТабличногоДокументаМакет.ФиксацияСлева+1;
		оПраво 	=  ПолеТабличногоДокументаМакет.ШиринаТаблицы;	
	Иначе			
		оВерх 	=  ОблДляВставки.Верх;
		оНиз  	=  ОблДляВставки.Низ;
		оЛево 	=  ОблДляВставки.Лево;
		оПраво 	=  ОблДляВставки.Право;		
	КонецЕсли;
		
	ОС=ПолеТабличногоДокументаМакет.ПолучитьОбласть(ИмяОбласти);
					
	Для ИндексСтрока = ОВерх По ОНиз Цикл	
		Для ИндексКолонка = ОЛево По ОПраво Цикл
			
			ТекОбласть = ПолеТабличногоДокументаМакет.Область(ИндексСтрока,ИндексКолонка,ИндексСтрока,ИндексКолонка);
			
			Если ТекОбласть.СодержитЗначение Тогда 
				
				ЗначениеЧисло = ТекОбласть.Значение;	
				
				Если СтруктураПараметров.ВидКорректировки = "Процент" Тогда
					ЗначениеЧислоИтог = ЗначениеЧисло*(1+СтруктураПараметров.ЗначениеКорректировки/100);
				ИначеЕсли СтруктураПараметров.ВидКорректировки = "Значение" Тогда	
					ЗначениеЧислоИтог = ЗначениеЧисло+СтруктураПараметров.ЗначениеКорректировки;
				КонецЕсли;	
				
				ДобавитьЗаписьВЛог(ЗначениеЧислоИтог,ТекОбласть.Расшифровка);
				ТекОбласть.Значение = ЗначениеЧислоИтог;
				
			КонецЕсли;
			
		КонецЦикла;			
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция ПодготовитьТаблицуИзмененийКурсов(ЛогИзмененныхКурсов)
	
	
	ТаблицаТекущихКурсов = ПолучитьИзВременногоХранилища(ДеревоНастройкиСервер_СтрокиАдрес);
	
	ТаблицаОтвета = Новый ТаблицаЗначений;
	ТаблицаОтвета.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаОтвета.Колонки.Добавить("ВидКурса", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКурсов"));
	ТаблицаОтвета.Колонки.Добавить("Отношение", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18, 12 ));
	ТаблицаОтвета.Колонки.Добавить("ПериодКурса", Новый ОписаниеТипов("СправочникСсылка.Периоды"));	
	ТаблицаОтвета.Колонки.Добавить("Кратность", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10, 0));
	ТаблицаОтвета.Колонки.Добавить("Курс", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10, 4));
		
	Для Каждого Элемент Из ЛогИзмененныхКурсов Цикл
		
		тИсходноеЗначениеКурса =  ТаблицаТекущихКурсов.Строки.НайтиСтроки(Новый Структура("ПериодКурса",Элемент.ПериодКурса),Истина);
		
		Если тИсходноеЗначениеКурса.Количество() =0 Тогда
			СреднийКурсЗаПериод_ИсходноеЗначение				= 0;
			СреднийКурсЗаПериодМСФО_ИсходноеЗначение            = 0;
			КурсНаНачалоПериода_ИсходноеЗначение                = 0;
			КурсНаКонецПериода_ИсходноеЗначение                 = 0;
			СреднийКурсЗаПериодЦБ_ИсходноеЗначение              = 0
		Иначе
			СреднийКурсЗаПериод_ИсходноеЗначение				= тИсходноеЗначениеКурса[0].СреднийКурсЗаПериод;
			СреднийКурсЗаПериодМСФО_ИсходноеЗначение            = тИсходноеЗначениеКурса[0].СреднийКурсЗаПериодМСФО;
			КурсНаНачалоПериода_ИсходноеЗначение                = тИсходноеЗначениеКурса[0].КурсНаНачалоПериода;
			КурсНаКонецПериода_ИсходноеЗначение                 = тИсходноеЗначениеКурса[0].КурсНаКонецПериода;
			СреднийКурсЗаПериодЦБ_ИсходноеЗначение              = тИсходноеЗначениеКурса[0].СреднийКурсЗаПериодЦБ;
		КонецЕсли;	
		
		Если Элемент.СреднийКурсЗаПериод>0 Тогда	
			НоваяСтрока = ТаблицаОтвета.Добавить();
			НоваяСтрока.ПериодКурса=Элемент.ПериодКурса;
			НоваяСтрока.Валюта    = Элемент.Валюта;
			НоваяСтрока.ВидКурса  = Перечисления.ВидыКурсов.СреднийКурсЗаПериод;
			НоваяСтрока.Отношение = ВернутьОтношение(Элемент.СреднийКурсЗаПериод, СреднийКурсЗаПериод_ИсходноеЗначение);
			НоваяСтрока.Кратность=Элемент.Кратность;
			НоваяСтрока.Курс=Элемент.СреднийКурсЗаПериод;	
		КонецЕсли;
		
		Если Элемент.СреднийКурсЗаПериодМСФО>0 Тогда	
			НоваяСтрока = ТаблицаОтвета.Добавить();
			НоваяСтрока.Валюта    = Элемент.Валюта;
			НоваяСтрока.ПериодКурса=Элемент.ПериодКурса;
			НоваяСтрока.ВидКурса  = Перечисления.ВидыКурсов.СреднийКурсЗаПериодМСФО;
			НоваяСтрока.Отношение = ВернутьОтношение(Элемент.СреднийКурсЗаПериодМСФО, СреднийКурсЗаПериодМСФО_ИсходноеЗначение);	
			НоваяСтрока.Кратность=Элемент.Кратность;
			НоваяСтрока.Курс=Элемент.СреднийКурсЗаПериодМСФО;
		КонецЕсли;
		
		Если Элемент.КурсНаНачалоПериода>0 Тогда
			НоваяСтрока = ТаблицаОтвета.Добавить();
			НоваяСтрока.Валюта    = Элемент.Валюта;
			НоваяСтрока.ПериодКурса=Элемент.ПериодКурса;
			НоваяСтрока.ВидКурса  = Перечисления.ВидыКурсов.КурсНаНачалоПериода;
			НоваяСтрока.Отношение = ВернутьОтношение(Элемент.КурсНаНачалоПериода, КурсНаНачалоПериода_ИсходноеЗначение);
			НоваяСтрока.Кратность=Элемент.Кратность;
			НоваяСтрока.Курс=Элемент.КурсНаНачалоПериода;
		КонецЕсли;
		
		Если Элемент.КурсНаКонецПериода>0 Тогда
			НоваяСтрока = ТаблицаОтвета.Добавить();
			НоваяСтрока.Валюта    = Элемент.Валюта;
			НоваяСтрока.ПериодКурса=Элемент.ПериодКурса;
			НоваяСтрока.ВидКурса  = Перечисления.ВидыКурсов.КурсНаКонецПериода;
			НоваяСтрока.Отношение = ВернутьОтношение(Элемент.КурсНаКонецПериода, КурсНаКонецПериода_ИсходноеЗначение);
			НоваяСтрока.Кратность=Элемент.Кратность;
			НоваяСтрока.Курс=Элемент.КурсНаКонецПериода;
		КонецЕсли;
		
		Если Элемент.СреднийКурсЗаПериодЦБ>0 Тогда		
			НоваяСтрока = ТаблицаОтвета.Добавить();		
			НоваяСтрока.Валюта    	= Элемент.Валюта;
			НоваяСтрока.ПериодКурса	= Элемент.ПериодКурса;
			НоваяСтрока.ВидКурса  	= Перечисления.ВидыКурсов.СреднийКурсЗаПериодЦБ;
			НоваяСтрока.Отношение 	= ВернутьОтношение(Элемент.СреднийКурсЗаПериодЦБ, СреднийКурсЗаПериодЦБ_ИсходноеЗначение);
			НоваяСтрока.Кратность	= Элемент.Кратность;
			НоваяСтрока.Курс		= Элемент.СреднийКурсЗаПериодЦБ;		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаОтвета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВернутьОтношение(ПервыйЭлемент, ВторойЭлемент)	
	
	ПервыйЭлемент = ?(ПервыйЭлемент = null,0,ПервыйЭлемент);
	ВторойЭлемент = ?(ВторойЭлемент = null,0,ВторойЭлемент);
	
	Возврат ?(ВторойЭлемент = 0, 0, ПервыйЭлемент/ВторойЭлемент);	
КонецФункции
	
&НаСервере
Процедура СброситьСостояниеНеИспользовать()
	
	ОтображениеСостояния = Элементы.ПолеТабличногоДокументаМакет.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Ложь;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
	ОтображениеСостояния.Картинка                       = Новый Картинка;
	ОтображениеСостояния.Текст                          = "";
	
	Элементы.ПолеТабличногоДокументаМакет.Доступность 		= Истина;
	Элементы.ГруппаКоманднаяПанельСтруктура.Доступность 			= Истина;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеНеИспользовать()
	
	ОтображениеСостояния = Элементы.ПолеТабличногоДокументаМакет.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	ОтображениеСостояния.Картинка                       = Новый Картинка;
	
	Если НЕ ЗначениеЗаполнено(Сценарий) Тогда
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Не выбран сценарий.'");
	ИначеЕсли НЕ ЗначениеЗаполнено(ПериодПланированияОтборНачало) Тогда
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Не выбран период.'");	
	КонецЕсли;	
		
	Элементы.ПолеТабличногоДокументаМакет.Доступность 	= Ложь;
	Элементы.ГруппаКоманднаяПанельСтруктура.Доступность 		= Ложь;
		                                         	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НастройкиИзменены = Истина тогда
		Если Не ЗавершениеРаботы тогда
			СохранитьНастройкиФормы();
		Иначе
			Отказ = Истина;
			ТекстПредупреждения = Нстр("ru = 'Работа в данном окне не завершена: настройки не будут сохранены'");
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()
	
	КлючОбъекта = "<FN>" + ЭтаФорма.ИмяФормы + "</FN>";
	КлючОбъекта = СтрЗаменить(КлючОбъекта, " ", "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ВК, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ВТаб, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.НПП, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ПС, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ПФ, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.Таб, "");
	
	ТекущийПользователь = ПользователиУХ.АвторизованныйПользователь();
	КлючНастроек = "<User>" + Строка(ТекущийПользователь) + "</User><UserGUID>" + ТекущийПользователь.УникальныйИдентификатор() + "</UserGUID>";
	КлючНастроек = СтрЗаменить(КлючНастроек, " ", "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ВК, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ВТаб, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.НПП, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ПС, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ПФ, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.Таб, "");
	
	СтруктураНастроек = Новый Структура("Сценарий, Периодичность, ПериодПланированияОтборНачало, ПериодПланированияОтборОкончание, Валюта");
	
	Для Каждого ЭлементНастроек Из СтруктураНастроек Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, ЭлементНастроек.Ключ) тогда
			СтруктураНастроек.Вставить(ЭлементНастроек.Ключ, ЭтаФорма[ЭлементНастроек.Ключ]);
		КонецЕсли;
	КонецЦикла;
	
	ХранилищаНастроек.Общие.Сохранить(КлючОбъекта, КлючНастроек, СтруктураНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиФормы()
	
	КлючОбъекта = "<FN>" + ЭтаФорма.ИмяФормы + "</FN>";
	КлючОбъекта = СтрЗаменить(КлючОбъекта, " ", "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ВК, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ВТаб, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.НПП, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ПС, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.ПФ, "");
	КлючОбъекта = СтрЗаменить(КлючОбъекта, Символы.Таб, "");
	
	ТекущийПользователь = ПользователиУХ.АвторизованныйПользователь();
	КлючНастроек = "<User>" + Строка(ТекущийПользователь) + "</User><UserGUID>" + ТекущийПользователь.УникальныйИдентификатор() + "</UserGUID>";
	КлючНастроек = СтрЗаменить(КлючНастроек, " ", "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ВК, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ВТаб, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.НПП, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ПС, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.ПФ, "");
	КлючНастроек = СтрЗаменить(КлючНастроек, Символы.Таб, "");
	
	ОписаниеНастроек = Новый ОписаниеНастроек;
	
	ХранилищаНастроек.Общие.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек);
	
	СтруктураНастроек = ОписаниеНастроек.ДополнительныеСвойства;
	
	Для Каждого ЭлементНастроек Из СтруктураНастроек Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтаФорма, ЭлементНастроек.Ключ) тогда
			ЭтаФорма[ЭлементНастроек.Ключ] = СтруктураНастроек[ЭлементНастроек.Ключ];
		КонецЕсли;
	КонецЦикла;
	
	Если Периодичность.Пустая() тогда
		Периодичность = Перечисления.Периодичность.Месяц;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастройкиИзменены = Ложь;
	
КонецПроцедуры
