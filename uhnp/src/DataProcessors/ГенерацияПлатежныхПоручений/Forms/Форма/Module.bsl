#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаявкиКИсполнениюДерево

&НаКлиенте
Процедура ЗаявкиКИсполнениюДеревоСоздаватьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ЗаявкиКИсполнениюДерево.ТекущиеДанные;
	
	Если ТекДанные.Создавать = 2 Тогда 
		ТекДанные.Создавать = 0;
	КонецЕсли;
	
	СуммаГруппировки = 0;
	
	РодительскийЭлемент = ТекДанные.ПолучитьРодителя();
	Если РодительскийЭлемент = Неопределено Тогда
		ДочерниеЭлементы = ТекДанные.ПолучитьЭлементы();	
		Для Каждого СтрокаДерева Из ДочерниеЭлементы Цикл 
			СтрокаДерева.Создавать = ТекДанные.Создавать; 
			Если СтрокаДерева.Создавать = 1 Тогда	
				СуммаГруппировки = СуммаГруппировки + СтрокаДерева.СуммаДокумента;  
			КонецЕсли;
		КонецЦикла;    
		ТекДанные.ЕстьВыбранные = ТекДанные.Создавать; 
		Если ДочерниеЭлементы.Количество() Тогда
			ТекДанные.СуммаДокумента = СуммаГруппировки; 
		КонецЕсли;
	Иначе       
		ДочерниеЭлементы = РодительскийЭлемент.ПолучитьЭлементы();	
		СостояниеФлажка = 0;
		ЕстьВыбранные = Ложь;
		ЕстьНеВыбранные = Ложь;
		Для Каждого СтрокаДерева Из ДочерниеЭлементы Цикл 
			Если СтрокаДерева.Создавать = 1 Тогда	
				ЕстьВыбранные = Истина;
				СуммаГруппировки = СуммаГруппировки + СтрокаДерева.СуммаДокумента;
			КонецЕсли;
			Если СтрокаДерева.Создавать = 0 Тогда	
				ЕстьНеВыбранные = Истина;	
			КонецЕсли; 
		КонецЦикла; 
		
		Если ЕстьВыбранные И ЕстьНеВыбранные Тогда
			СостояниеФлажка = 2;
		ИначеЕсли ЕстьВыбранные Тогда    
			СостояниеФлажка = 1;
		Иначе  
			СостояниеФлажка = 0;
		КонецЕсли;
		
		РодительскийЭлемент.Создавать = СостояниеФлажка;
		РодительскийЭлемент.ЕстьВыбранные = ЕстьВыбранные;
		РодительскийЭлемент.СуммаДокумента = СуммаГруппировки;
	КонецЕсли;
	
	ОбновитьИтогиВПодвале();

КонецПроцедуры

