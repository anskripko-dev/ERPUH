Процедура УдалитьДокументы()
	
	Для Каждого СтрДокумент Из ТаблицаДокументы Цикл
		
		Если СтрДокумент.НеУдалять Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДокументОбъект=СтрДокумент.ДокументСсылка.ПолучитьОбъект();
		
		Если ДокументОбъект=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ТипЗнч(ДокументОбъект)=Тип("ДокументОбъект.НастраиваемыйОтчет") Тогда	
			
			ДокументОбъект.ОбменДанными.Загрузка=Истина;
			
		ИначеЕсли НЕ ДокументОбъект.ПометкаУдаления Тогда
			
			ДокументОбъект.ПометкаУдаления=Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
		ДокументОбъект.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры // УдалитьДокументы()
 

