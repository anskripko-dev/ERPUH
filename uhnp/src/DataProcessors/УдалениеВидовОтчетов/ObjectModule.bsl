#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем СоответствиеТипСсылкиНаОбъект Экспорт;
Перем МассивОбработанных Экспорт;
Перем ДеревоЗависимых Экспорт;
Перем МассивПредопределенных;

Перем МассивВидовОтчетов;
Перем МассивПравилОбработки;
Перем МассивБланковОтчетов;
Перем МассивОбластейОтчетов;

Перем ТаблицаПодчиненныхЭлементов;
Перем МассивПодчиненныхОбъектов;

Перем ТаблицаДокументы Экспорт;
Перем ТаблицаРегистрыСведений Экспорт;
Перем ТаблицаСправочники Экспорт;

#Область ПодготовкаДанных

Процедура ПостроитьТаблицуПодчиненныхОбъектов()
	
	МассивПодчиненныхОбъектов=Новый Массив;
	ОбъектДляПоиска=Метаданные.Справочники.ВидыОтчетов;
	
	Для Каждого ОбъектМетаданных ИЗ Метаданные.Справочники Цикл
		
		Для Каждого Владелец ИЗ ОбъектМетаданных.Владельцы Цикл
			
			Если Владелец=ОбъектДляПоиска Тогда
				
				МассивПодчиненныхОбъектов.Добавить(ОбъектМетаданных.ПолноеИмя());
							
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТекстОбъединение="";
	
	Для Каждого Объект ИЗ МассивПодчиненныхОбъектов Цикл
		
		ДанныеОбъекта=СтрРазделить(Объект,".");
		
		ТекстОбъединение=ТекстОбъединение+"
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ """+ДанныеОбъекта[1]+""" КАК ИмяСправочника,
		|"+ДанныеОбъекта[1]+".Ссылка
		|ИЗ "+Объект+" КАК "+ДанныеОбъекта[1]+"
		|ГДЕ "+ДанныеОбъекта[1]+".Владелец В(&МассивВидовОтчетов)";
		
		Если ТолькоЭлементыСтруктуры=1 Тогда
			
			ТекстОбъединение=ТекстОбъединение+"
			|И "+ДанныеОбъекта[1]+".ПометкаУдаления";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст=Сред(ТекстОбъединение,СтрДлина("ОБЪЕДИНИТЬ ВСЕ") + 2);
	Запрос.УстановитьПараметр("МассивВидовОтчетов",ВидыОтчетовДляУдаления.ВыгрузитьКолонку("ВидОтчета"));
	
	ТаблицаПодчиненныхЭлементов=Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры // ПостроитьТаблицуПодчиненныхОбъектов() 

Процедура ПостроитьВетвьДерева(ИсходнаяСсылка)
	
	МассивОбработанных.Добавить(ИсходнаяСсылка);
	
//	МассивМетаданных=НайтиЗависимыеМетаданные(ТипЗнч(ИсходнаяСсылка),ИсходнаяСсылка.Метаданные());
	
	МассивСсылок=Новый Массив;
	МассивСсылок.Добавить(ИсходнаяСсылка);
		
	ТаблицаСсылок=НайтиПоСсылкам(МассивСсылок,,,МассивПредопределенных);
	
	Для Каждого Строка Из ТаблицаСсылок Цикл

		ПолноеИмя=Строка.Метаданные.ПолноеИмя();
		
		НоваяСтрока=ДеревоЗависимых.Строки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		НоваяСтрока.ИмяОбъектаМетаданных=ПолноеИмя;
		НоваяСтрока.ТипОбъектаМетаданных=СтрРазделить(НоваяСтрока.ИмяОбъектаМетаданных,".")[0];
		
		Если НоваяСтрока.ТипОбъектаМетаданных="Справочник" 
			ИЛИ НоваяСтрока.ТипОбъектаМетаданных="Документ"
			ИЛИ НоваяСтрока.ТипОбъектаМетаданных="ПланВидовХарактеристик" Тогда
			
			НоваяСтрока.ПометкаУдаления=НоваяСтрока.Данные.ПометкаУдаления;
			
		КонецЕсли;
		
		МассивОбработанных.Добавить(Строка.Данные);
		
	КонецЦикла;
	
	Для Каждого Строка ИЗ ДеревоЗависимых.Строки Цикл 
	
		Если СтрНайти(Строка.ИмяОбъектаМетаданных,"Справочник")>0
			ИЛИ СтрНайти(Строка.ИмяОбъектаМетаданных,"Документ")>0
			ИЛИ СтрНайти(Строка.ИмяОбъектаМетаданных,"ПланВидовХарактеристик")>0 Тогда
			
			ДобавитьСтрокиЗависимыхРекурсивно(Строка,Строка.Данные);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПостроитьВетвьДерева()

