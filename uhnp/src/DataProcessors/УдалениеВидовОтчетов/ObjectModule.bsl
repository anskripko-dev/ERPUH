	ДеревоЗависимых=Новый ДеревоЗначений;
	ДеревоЗависимых.Колонки.Добавить("Ссылка");
	ДеревоЗависимых.Колонки.Добавить("Данные");
	ДеревоЗависимых.Колонки.Добавить("ИмяОбъектаМетаданных");
