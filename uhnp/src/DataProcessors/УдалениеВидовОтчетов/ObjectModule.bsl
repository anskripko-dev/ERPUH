КонецПроцедуры // ОчиститьРегистрыСведенийИнтерфейс()

Процедура ОчиститьЗаписиРегистра(СтрокаЗаписи)
	
	МетаданныеРегистра=Метаданные.НайтиПоПолномуИмени(СтрокаЗаписи.ИмяРегистра);
	
	Если СтрокаЗаписи.ТипПоля="Измерение" Тогда
		
		НаборЗаписей=РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор[СтрокаЗаписи.ИмяПоля].Установить(СтрокаЗаписи.СсылаетсяНа);
		НаборЗаписей.Записать(Истина);
		Возврат;
		
	КонецЕсли;
	
	ТекстВыборки="";
	
	МассивИзмерений=Новый Массив;
	
	Для Каждого Измерение ИЗ МетаданныеРегистра.Измерения Цикл
		
		МассивИзмерений.Добавить(Измерение.Имя);
		ТекстВыборки=ТекстВыборки+","+Измерение.Имя;
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ "+Сред(ТекстВыборки,2)+"
	|ИЗ "+СтрокаЗаписи.ИмяРегистра+"
	|ГДЕ "+СтрокаЗаписи.ИмяПоля+"=&СсылаетсяНа";
	
	Запрос.УстановитьПараметр("СсылаетсяНа",СтрокаЗаписи.СсылаетсяНа);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НаборЗаписей=РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		
		Для Каждого Измерение ИЗ МассивИзмерений Цикл
			
			НаборЗаписей.Отбор[Измерение].Установить(Результат[Измерение]);
			
		КонецЦикла;
	
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
			
КонецПроцедуры // ОчиститьЗаписиРегистра() 

Процедура УдалитьСправочники()
	
	МассивСправочники=ДеревоЗависимых.Строки.НайтиСтроки(Новый Структура("ТипОбъектаМетаданных","Справочник"),Истина);
	
	Для Каждого Строка ИЗ МассивСправочники Цикл
		
		СтрИнтерфейс=ТаблицаСправочники.Найти(Строка.Данные,"СправочникСсылка");
		
		Если ((НЕ СтрИнтерфейс=Неопределено) И СтрИнтерфейс.НеУдалять) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СправочникОбъект=Строка.Данные.ПолучитьОбъект();
		
		Если НЕ СправочникОбъект=Неопределено Тогда
			
			СправочникОбъект.ОбменДанными.Загрузка=Истина;
			СправочникОбъект.Удалить();
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры // УдалитьСправочники() 


