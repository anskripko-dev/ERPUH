Функция ВыполнитьУдаление() Экспорт
	
	МассивВидовОтчетов=ВидыОтчетовДляУдаления.ВыгрузитьКолонку("ВидОтчета");
	
	ПостроитьТаблицуПодчиненныхОбъектов();
	ПодготовитьМассивБланковОтчетов();
	ПодготовитьМассивПравилОбработки();
	ПодготовитьМассивОбластейОтчетов();
			
	НачатьТранзакцию();
	
	Попытка
		
		Если ТолькоЭлементыСтруктуры=1 Тогда
			
			УдалитьДанныеПоказателейПоСсылкам();
			
		Иначе
			
			УдалитьДанныеПоказателейПоВерсиям();
			
		КонецЕсли;
		
		Если ТолькоЭлементыСтруктуры=0 Тогда
			ОчиститьРегистрыПоВидамОтчетов();
		КонецЕсли;
		
		ОчиститьРегистрыПоПравиламОбработки();
		ОчиститьРегистрыПоБланкамОтчетов();
		
		ОчиститьРегистрыСведенийИнтерфейс();
		
		УдалитьДокументы();
		УдалитьСправочники();
		
		Если ТолькоЭлементыСтруктуры=0 Тогда
			УдалитьВидыОтчетов();
		Иначе
			УдалитьПодчиненныеСправочники();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Возврат Истина;
		
	Исключение
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),,,СтатусСообщения.Важное);
		ОтменитьТранзакцию();
		Возврат Ложь;
		
	КонецПопытки;
			
КонецФункции // УдалитьОбъекты()

