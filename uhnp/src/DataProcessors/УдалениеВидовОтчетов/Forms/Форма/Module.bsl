&НаСервере
Функция ПроверитьЗависимыеВидыОтчетов()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	РеквизитыИсточниковДанныхДляФормул.ВидОтчета КАК ВидОтчета
	|ИЗ
	|	РегистрСведений.РеквизитыИсточниковДанныхДляФормул КАК РеквизитыИсточниковДанныхДляФормул
	|ГДЕ
	|	НЕ РеквизитыИсточниковДанныхДляФормул.ВидОтчета В (&ВидыОтчетов)
	|	И РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор В(&ВидыОтчетов)
	|	И НЕ(РеквизитыИсточниковДанныхДляФормул.НеИспользуется
	|				ИЛИ РеквизитыИсточниковДанныхДляФормул.ВидОтчета = ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка)
	|				ИЛИ РеквизитыИсточниковДанныхДляФормул.ВидОтчетаОтбор = ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка))";
	
	
	ВидыОтчетов=Объект.ВидыОтчетовДляУдаления.Выгрузить().ВыгрузитьКолонку("ВидОтчета");
	Запрос.УстановитьПараметр("ВидыОтчетов",ВидыОтчетов);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		Возврат ВидыОтчетов;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
		
КонецФункции // ПроверитьЗависимыеВидыОтчетов()

&НаСервере
Процедура ОпределитьПолеСсылки(СтрокаЗаписи,Данные)
	
	МетаданныеРегистра=Метаданные.НайтиПоПолномуИмени(СтрокаЗаписи.ИмяРегистра);
	
	СтруктураДанные=Новый Структура;
	
	Для Каждого Измерение ИЗ МетаданныеРегистра.Измерения Цикл
		
		Если Данные[Измерение.Имя]=СтрокаЗаписи.СсылаетсяНа Тогда
			
			СтрокаЗаписи.ТипПоля="Измерение";
			СтрокаЗаписи.ИмяПоля=Измерение.Имя;
			Возврат;
			
		КонецЕсли;
		
		СтруктураДанные.Вставить(Измерение.Имя,Данные[Измерение.Имя]);
		
	КонецЦикла;
	
	НаборЗаписей=РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
	
	Для Каждого Элемент ИЗ СтруктураДанные Цикл
		
		НаборЗаписей.Отбор[Элемент.Ключ].Установить(Элемент.Значение);
		
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаНабора=НаборЗаписей[0];
	
	Для Каждого Ресурс ИЗ МетаданныеРегистра.Ресурсы Цикл
		
		Если СтрокаНабора[Ресурс.Имя]=СтрокаЗаписи.СсылаетсяНа Тогда
			
			СтрокаЗаписи.ТипПоля="Ресурс";
			СтрокаЗаписи.ИмяПоля=Ресурс.Имя;
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Реквизит ИЗ МетаданныеРегистра.Реквизиты Цикл
		
		Если СтрокаНабора[Реквизит.Имя]=СтрокаЗаписи.СсылаетсяНа Тогда
			
			СтрокаЗаписи.ТипПоля="Реквизит";
			СтрокаЗаписи.ИмяПоля=Реквизит.Имя;
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОпределитьПолеСсылки()

Процедура ОчиститьТаблицыИнтерфейса()

	ТаблицаДокументы.Очистить();
	ТаблицаСправочники.Очистить();
	ТаблицаРегистрыСведений.Очистить();
	ДеревоЗависимых.ПолучитьЭлементы().Очистить();
	
	Элементы.ЗависимыеДокументы.Заголовок=Нстр("ru = 'Документы'");
	Элементы.ЗависимыеСправочники.Заголовок=Нстр("ru = 'Справочники'");
	Элементы.ЗависимыеРегистрыСведений.Заголовок=Нстр("ru = 'Регистры сведений'");
	Элементы.ГруппаЗависимыеОбъекты.Заголовок=Нстр("ru = 'Зависимые объекты'");
	
КонецПроцедуры // ОчиститьТаблицыИнтерфейса() 

&НаСервере
Функция ВыполнитьПоискНаСервере()
	
	ОчиститьТаблицыИнтерфейса();
	РезультатПроверки=ПроверитьЗависимыеВидыОтчетов();
	
	Если Не РезультатПроверки=Неопределено Тогда
		
		Возврат РезультатПроверки;
		
	КонецЕсли;
	
	ОбработкаОбъект=РеквизитФормыВЗначение("Объект");
	ТабДеревоЗависимых=ОбработкаОбъект.ПостроитьДеревоСсылок();
	
	МассивИсточников=ПолучитьИсточникиКУдалению();
		
	ЭлементыСтруктуры=Новый Массив;
	ЭлементыСтруктуры.Добавить("Справочник.ПоказателиОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.БланкиОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.КолонкиОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.СтрокиОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.ГруппыРаскрытия");
	ЭлементыСтруктуры.Добавить("Справочник.ПоказателиОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.ПравилаОбработки");
	ЭлементыСтруктуры.Добавить("Справочник.ПравилаПроверки");
	ЭлементыСтруктуры.Добавить("Справочник.ПротоколируемыеСобытия");
	ЭлементыСтруктуры.Добавить("Справочник.ОбластиДанныхВидовОтчетов");
	ЭлементыСтруктуры.Добавить("Справочник.НастройкиСтруктурыБланка");


	МассивДокументы=ТабДеревоЗависимых.Строки.НайтиСтроки(Новый Структура("ТипОбъектаМетаданных","Документ"),Истина);
		
	Для Каждого Строка ИЗ МассивДокументы Цикл
		
		НоваяСтрока=ТаблицаДокументы.Добавить();
		НоваяСтрока.ДокументСсылка=Строка.Данные;
		НоваяСтрока.СсылаетсяНа=Строка.Ссылка;
		НоваяСтрока.СсылкаМетаданные=Строка.Ссылка.Метаданные().ПолноеИмя();
		НоваяСтрока.ПометкаУдаления=Строка.ПометкаУдаления;
		НоваяСтрока.ИмяОбъектаМетаданных=Строка.ИмяОбъектаМетаданных;
		
	КонецЦикла;
	
	Элементы.ЗависимыеДокументы.Заголовок=Элементы.ЗависимыеДокументы.Заголовок + " ("+ТаблицаДокументы.Количество()+")";
	
	МассивСправочники=ТабДеревоЗависимых.Строки.НайтиСтроки(Новый Структура("ТипОбъектаМетаданных","Справочник"),Истина);
		
	Для Каждого Строка ИЗ МассивСправочники Цикл
		
		Если НЕ ЭлементыСтруктуры.Найти(Строка.ИмяОбъектаМетаданных)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Строка.ИмяОбъектаМетаданных="Справочник.ИсточникиДанныхДляРасчетов"
			И (НЕ МассивИсточников.Найти(Строка.Данные)=Неопределено) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока=ТаблицаСправочники.Добавить();
		НоваяСтрока.СправочникСсылка=Строка.Данные;
		НоваяСтрока.СсылаетсяНа=Строка.Ссылка;
		НоваяСтрока.СсылкаМетаданные=Строка.Ссылка.Метаданные().ПолноеИмя();
		НоваяСтрока.ИмяОбъектаМетаданных=Строка.ИмяОбъектаМетаданных;
		НоваяСтрока.ПометкаУдаления=Строка.ПометкаУдаления;
		
	КонецЦикла;
	
	МассивПВХ=ТабДеревоЗависимых.Строки.НайтиСтроки(Новый Структура("ТипОбъектаМетаданных","ПланВидовХарактеристик"),Истина);
		
	Для Каждого Строка ИЗ МассивПВХ Цикл
				
		НоваяСтрока=ТаблицаСправочники.Добавить();
		НоваяСтрока.СправочникСсылка=Строка.Данные;
		НоваяСтрока.СсылаетсяНа=Строка.Ссылка;
		НоваяСтрока.СсылкаМетаданные=Строка.Ссылка.Метаданные().ПолноеИмя();
		НоваяСтрока.ИмяОбъектаМетаданных=Строка.ИмяОбъектаМетаданных;
		НоваяСтрока.ПометкаУдаления=Строка.ПометкаУдаления;
		
	КонецЦикла;
	
	Элементы.ЗависимыеСправочники.Заголовок=Элементы.ЗависимыеСправочники.Заголовок + " ("+ТаблицаСправочники.Количество()+")";
	
	ТабРегистры=РеквизитФормыВЗначение("ТаблицаРегистрыСведений");
	
	МассивРегистры=ТабДеревоЗависимых.Строки.НайтиСтроки(Новый Структура("ТипОбъектаМетаданных","РегистрСведений"),Истина);
		
	Для Каждого Строка ИЗ МассивРегистры Цикл
		
		НоваяСтрока=ТабРегистры.Добавить();
		НоваяСтрока.ИмяРегистра=Строка.ИмяОбъектаМетаданных;
		НоваяСтрока.СсылаетсяНа=Строка.Ссылка;
		НоваяСтрока.СсылкаМетаданные=Строка.Ссылка.Метаданные().ПолноеИмя();
		
		ОпределитьПолеСсылки(НоваяСтрока,Строка.Данные);
		
	КонецЦикла;
	
	ТабРегистры.Свернуть("ИмяРегистра,СсылаетсяНа,СсылкаМетаданные,НеУдалять,ТипПоля,ИмяПоля");
	
	ЗначениеВРеквизитФормы(ТабРегистры,"ТаблицаРегистрыСведений");
	
	Элементы.ЗависимыеРегистрыСведений.Заголовок=Элементы.ЗависимыеРегистрыСведений.Заголовок + " ("+ТаблицаРегистрыСведений.Количество()+")";
	
	Элементы.ГруппаЗависимыеОбъекты.Заголовок=Элементы.ГруппаЗависимыеОбъекты.Заголовок + " ("+
			(ТаблицаДокументы.Количество()+
			ТаблицаСправочники.Количество()+
			ТаблицаРегистрыСведений.Количество())+")";
	
	ЗначениеВРеквизитФормы(ТабДеревоЗависимых,"ДеревоЗависимых");
	
	Возврат "";
	
КонецФункции // ВыполнитьПоискНаСервере() 

&НаСервере
Функция НайтиЗависимыеМетаданные(ТипДляПоиска,ОбъектДляПоиска)
	
	МассивМетаданных=Новый Массив;
	
	Для Каждого ОбъектМетаданных ИЗ Метаданные.Справочники Цикл
		
		ПроверитьВхождениеСправочник(МассивМетаданных,"Справочник",ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска);
		
	КонецЦикла;
	
	Для Каждого ОбъектМетаданных ИЗ Метаданные.Документы Цикл
		
		ПроверитьВхождениеСправочник(МассивМетаданных,"Документ",ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска);
		
	КонецЦикла;
	
	Для Каждого ОбъектМетаданных ИЗ Метаданные.ПланыВидовХарактеристик Цикл
		
		ПроверитьВхождениеСправочник(МассивМетаданных,"ПланВидовХарактеристик",ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска);
		
	КонецЦикла;
	
	Для Каждого ОбъектМетаданных ИЗ Метаданные.РегистрыСведений Цикл
		
		ПроверитьВхождениеРегистр(МассивМетаданных,"РегистрСведений",ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска);
		
	КонецЦикла;
	
	Возврат МассивМетаданных;
		
КонецФункции // НайтиЗависимыеМетаданные()

&НаСервере
Процедура ПроверитьВхождениеСправочник(МассивМетаданных,ТипОбъектаМетаданных,ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска)
	
	Для Каждого Реквизит ИЗ ОбъектМетаданных.Реквизиты Цикл
		
		Если СтрНайти(Реквизит.Имя,"Субконто")>0 Тогда
				
				Продолжить;
				
			КонецЕсли;
		
		Если Реквизит.Тип.СодержитТип(ТипДляПоиска) И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
			
			МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
			Возврат;
						
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого ТабличнаяЧасть ИЗ ОбъектМетаданных.ТабличныеЧасти Цикл
		
		Для Каждого РеквизитТЧ ИЗ ТабличнаяЧасть.Реквизиты Цикл
			
			Если СтрНайти(РеквизитТЧ.Имя,"Субконто")>0 Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если РеквизитТЧ.Тип.СодержитТип(ТипДляПоиска) И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
				
				МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
				Возврат;
	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Если ТипОбъектаМетаданных="Справочник" Тогда
		
		Для Каждого Владелец ИЗ ОбъектМетаданных.Владельцы Цикл
			
			Если Владелец=ОбъектДляПоиска И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
				
				МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
				Возврат;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
			
КонецПроцедуры  // ПроверитьВхождениеСправочник()

&НаСервере
Процедура ПроверитьВхождениеРегистр(МассивМетаданных,ТипОбъектаМетаданных,ОбъектМетаданных,ТипДляПоиска,ОбъектДляПоиска)
	
	Для Каждого Измерение ИЗ ОбъектМетаданных.Измерения Цикл
		
		Если Измерение.Тип.СодержитТип(ТипДляПоиска)  И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
			
			МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого Ресурс ИЗ ОбъектМетаданных.Ресурсы Цикл
		
		Если Ресурс.Тип.СодержитТип(ТипДляПоиска)  И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
			
			МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Для Каждого Реквизит ИЗ ОбъектМетаданных.Реквизиты Цикл
		
		Если Реквизит.Тип.СодержитТип(ТипДляПоиска) И МассивМетаданных.Найти(ОбъектМетаданных.ПолноеИмя())=Неопределено Тогда
			
			МассивМетаданных.Добавить(ОбъектМетаданных.ПолноеИмя());
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры  // ПроверитьВхождениеСправочник()

&НаКлиенте
Процедура ВыполнитьПоиск(Команда)
	
	РезультатПоиска=ВыполнитьПоискНаСервере();
	
	Если ТипЗнч(РезультатПоиска)=Тип("Массив") Тогда
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("МассивВидовОтчетов",РезультатПоиска);
		СтруктураПараметров.Вставить("СпособСопоставления",2);
		СтруктураПараметров.Вставить("СпособГруппировки",2);
		СтруктураПараметров.Вставить("ТекстСообщения",Нстр("ru = 'Существуют виды отчетов, данные которых зависят от удаляемых.'"));
		
		ОткрытьФорму("Отчет.ОтчетОСвязяхМеждуОтчетами.Форма",СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГруппе(Команда)
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ЭтоГруппа", Истина));
	ГруппаОтчетов = Неопределено;

	Оповещение = Новый ОписаниеОповещения("Подключаемый_ВыборГруппыОтчетов", ЭтотОбъект);
	ОткрытьФорму("Справочник.ВидыОтчетов.ФормаВыбора", 
					ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыборГруппыОтчетов(Результат, ДополнительныеПараметры) Экспорт
    
    ГруппаОтчетов = Результат;
    
    Если ГруппаОтчетов <> Неопределено Тогда
                
        ЗаполнитьТаблицуОтборов(ГруппаОтчетов);
        
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИсточникиКУдалению()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсточникиДанныхДляРасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	ИсточникиДанныхДляРасчетов.НазначениеРасчетов.Владелец В(&ВидыОтчетовКУдалению)";
	
	Запрос.УстановитьПараметр("ВидыОтчетовКУдалению",Объект.ВидыОтчетовДляУдаления.Выгрузить().ВыгрузитьКолонку("ВидОтчета"));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	
КонецФункции // ПолучитьИсточникиКУдалению()

&НаСервере
Процедура ЗаполнитьТаблицуОтборов(Параметр)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Параметр);	
	Запрос.УстановитьПараметр("ОтборОтчетов", РеквизитФормыВЗначение("Объект.ВидыОтчетовДляУдаления").Выгрузить().ВыгрузитьКолонку("ВидОтчета"));
	
	Если ТипЗнч(Параметр) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыОтчетов.Ссылка КАК Отчет
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Ссылка В ИЕРАРХИИ(&Ссылка)
		|	И НЕ ВидыОтчетов.Ссылка В (&ОтборОтчетов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидыОтчетов.Наименование";
		
	ИначеЕсли ТипЗнч(Параметр) = Тип("Булево") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыОтчетов.Ссылка КАК Отчет
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	НЕ ВидыОтчетов.Ссылка В (&ОтборОтчетов)
		|	И ВидыОтчетов.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидыОтчетов.Наименование";
					   
	КонецЕсли;
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=Объект.ВидыОтчетовДляУдаления.Добавить();
		НоваяСтрока.ВидОтчета=Результат.Отчет;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПомеченные(Команда)
	
	ЗаполнитьТаблицуОтборов(Истина);
	
КонецПроцедуры

