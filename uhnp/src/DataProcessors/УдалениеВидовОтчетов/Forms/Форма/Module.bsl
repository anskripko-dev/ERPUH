&НаСервере
Процедура УдалитьОбъектыНаСервере()
	
	ОбработкаОбъект=РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ТаблицаДокументы=РеквизитФормыВЗначение("ТаблицаДокументы");
	ОбработкаОбъект.ТаблицаРегистрыСведений=РеквизитФормыВЗначение("ТаблицаРегистрыСведений");
	ОбработкаОбъект.ТаблицаСправочники=РеквизитФормыВЗначение("ТаблицаСправочники");
	ОбработкаОбъект.ДеревоЗависимых=РеквизитФормыВЗначение("ДеревоЗависимых");
	
	Если ОбработкаОбъект.ВыполнитьУдаление() Тогда
		
		ОчиститьТаблицыИнтерфейса();
		Объект.ВидыОтчетовДляУдаления.Очистить();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция СформироватьТекстПредупреждения()
	
	ТекстПредупреждения=Нстр("ru = 'Процедура удаления является необратимой.'")+Символы.ПС+
				Нстр("ru = 'Помимо элементов настройки модели, будут удалены следующие объекты:'");
				
	ТекстОбъекты="";
	
	ДокументыКУдалению=ТаблицаДокументы.НайтиСтроки(Новый Структура("НеУдалять",Ложь));
	
	Если ДокументыКУдалению.Количество()>0 Тогда
		
		ТекстОбъекты=ТекстОбъекты+Символы.ПС+Нстр("ru = 'Документы: '")+ДокументыКУдалению.Количество();
		
	КонецЕсли;
	
	СправочникиКУдалению=ТаблицаСправочники.НайтиСтроки(Новый Структура("НеУдалять",Ложь));
	
	Если СправочникиКУдалению.Количество()>0 Тогда
		
		ТекстОбъекты=ТекстОбъекты+Символы.ПС+Нстр("ru = 'Справочники: '")+СправочникиКУдалению.Количество();
		
	КонецЕсли;
	
	РегистрыКУдалению=ТаблицаРегистрыСведений.НайтиСтроки(Новый Структура("НеУдалять",Ложь));
	
	Если РегистрыКУдалению.Количество()>0 Тогда
		
		ТекстОбъекты=ТекстОбъекты+Символы.ПС+Нстр("ru = 'Связанные наборы записей регистров: '")+РегистрыКУдалению.Количество();
		
	КонецЕсли;
	
	ТекстПредупреждения=ТекстПредупреждения+ТекстОбъекты+Символы.ПС+Нстр("ru = 'Продолжить?'");
	
	Возврат ТекстПредупреждения;
	
КонецФункции // СформироватьТекстПредупреждения() 

&НаКлиенте
Процедура УдалитьВыбранныеОбъекты(Команда)
	
	ТекстПредупреждения=СформироватьТекстПредупреждения();
	
	ОписаниеЗакрытие = Новый ОписаниеОповещения("ПередУдалением_Завершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеЗакрытие, ТекстПредупреждения, РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередУдалением_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьОбъектыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруОтбора(ИмяОбъектаМетаданных,Ссылка)
	
	МассивПолей=Новый Массив;
	
	ТипДляПоиска=ТипЗнч(Ссылка);
	ОбъектМетаданных=Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданных);
	
	Для Каждого Измерение ИЗ ОбъектМетаданных.Измерения Цикл
		
		Если Измерение.Тип.СодержитТип(ТипДляПоиска) Тогда
			
			МассивПолей.Добавить(Измерение.Имя);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого Ресурс ИЗ ОбъектМетаданных.Ресурсы Цикл
		
		Если Ресурс.Тип.СодержитТип(ТипДляПоиска) Тогда
			
			МассивПолей.Добавить(Ресурс.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
		
	Для Каждого Реквизит ИЗ ОбъектМетаданных.Реквизиты Цикл
		
		Если Реквизит.Тип.СодержитТип(ТипДляПоиска) Тогда
			
			МассивПолей.Добавить(Ресурс.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрПоле ИЗ МассивПолей Цикл
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ Первые 1
		|РегистрДляПоиска."+СтрПоле+"
		|ИЗ " + ИмяОбъектаМетаданных + " КАК РегистрДляПоиска
		|ГДЕ РегистрДляПоиска."+СтрПоле+"=&Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			СтруктураОтбора=Новый Структура;
			СтруктураОтбора.Вставить(СтрПоле,Ссылка);
			Возврат СтруктураОтбора;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции // ПолучитьСтруктуруОтбора() 


&НаКлиенте
Процедура ТаблицаРегистрыСведенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные=Элементы.ТаблицаРегистрыСведений.ТекущиеДанные;
	
	СтруктураОтбора=ПолучитьСтруктуруОтбора(ТекущиеДанные.ИмяРегистра,ТекущиеДанные.СсылаетсяНа);
	СтруктураПараметров=Новый Структура;
	
	Если НЕ СтруктураОтбора=Неопределено Тогда
		
		СтруктураПараметров.Вставить("Отбор",СтруктураОтбора);
		
	КонецЕсли;
	
	ОткрытьФорму(Элементы.ТаблицаРегистрыСведений.ТекущиеДанные.ИмяРегистра+".ФормаСписка",СтруктураПараметров);

	
КонецПроцедуры
