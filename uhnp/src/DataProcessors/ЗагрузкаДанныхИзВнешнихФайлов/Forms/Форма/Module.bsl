	|	ДанныеДляСопоставления.КонтрольЛимитовЗагружаемое КАК КонтрольЛимитовЗагружаемое,
	|	ДанныеДляСопоставления.КонтрольРезервовЗагружаемое КАК КонтрольРезервовЗагружаемое,
	|	ВЫРАЗИТЬ(ДанныеДляСопоставления.КодСтроки КАК ЧИСЛО(15, 0)) КАК КодСтроки
	|ПОМЕСТИТЬ ДанныеДляСопоставления
	|ИЗ
	|	&ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВидыБюджетов.Ссылка) КАК ВидБюджета,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""ВидБюджета"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|		ПО (ВидыБюджетов.Наименование ПОДОБНО ДанныеДляСопоставления.ВидБюджетаЗагружаемое)
	|ГДЕ
	|	НЕ ВидыБюджетов.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(СтатьиБюджета.Ссылка) КАК СтатьяБюджета,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""СтатьяБюджета"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиБюджета
	|		ПО (СтатьиБюджета.Наименование ПОДОБНО ДанныеДляСопоставления.СтатьяБюджетаЗагружаемое)
	|ГДЕ
	|	НЕ СтатьиБюджета.Ссылка ЕСТЬ NULL
	|	И &ЕстьТаблицаСтатьиБюджета
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1";
	
	
	ИмяТаблицыСтатьиБюджета = ИмяТаблицыСтатьиБюджетаПоВидуБюджета();
	
	ЕстьТаблицаСтатьиБюджета = ЗначениеЗаполнено(ИмяТаблицыСтатьиБюджета);
	
	Если ЗначениеЗаполнено(ИмяТаблицыСтатьиБюджета) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Справочник.СтатьиДвиженияДенежныхСредств",ИмяТаблицыСтатьиБюджета);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЕстьТаблицаСтатьиБюджета", ЕстьТаблицаСтатьиБюджета);
	Запрос.УстановитьПараметр("ДанныеДляСопоставления", ТаблицаДанных.Выгрузить());
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();  
	
	КоличествоПакетов = РезультатыЗапросов.Количество()-1;
	
	Для НомерПакета = 0 По КоличествоПакетов Цикл
		
		Если НомерПакета = КоличествоПакетов Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаСопоставления = РезультатыЗапросов[КоличествоПакетов - НомерПакета].Выгрузить();
		
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл 
			
			СтрокаДанных = ТаблицаСопоставления.Найти(СтрокаТаблицы.КодСтроки, "КодСтроки");
			Если СтрокаДанных <> Неопределено Тогда 
				СтрокаТаблицы[СтрокаДанных.ИмяПоля]  = СтрокаДанных[СтрокаДанных.ИмяПоля];
				ПроверитьСопоставлениеДанныхСтрокиЗагрузки(ЭтотОбъект, СтрокаТаблицы);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Функция ИмяТаблицыСтатьиБюджетаПоВидуБюджета()   
	
	Если ЗначениеЗаполнено(Объект.ВидБюджета) Тогда
	   ТипСтатьиБюджета =  Объект.ВидБюджета.ТипЗначения.Типы()[0];
	   
	   ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипСтатьиБюджета); 
	   
	   Возврат ОбъектМетаданных.ПолноеИмя();
	   
   КонецЕсли;   
   
КонецФункции

&НаСервере
Функция НайтиЗначениеПеречисления(ИмяПеречисления, Значение)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
			
			Если ЗначениеПеречисления.Имя = Значение Или ЗначениеПеречисления.Синоним = Значение тогда  
				Возврат Перечисления[ИмяПеречисления][ЗначениеПеречисления.Имя];
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗначениеПеречисления(ДанныеПоля)
	
	ТипыПоля = ДанныеПоля.Тип.Типы();
	
	Если ТипыПоля.Количество() = 1 Тогда
		ТипПоля = ТипыПоля[0];
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипПоля); 
		
		Если ОбъектМетаданных <> Неопределено И ОбщегоНазначения.ЭтоПеречисление(ОбъектМетаданных) Тогда
			
			Значение = НайтиЗначениеПеречисления(ОбъектМетаданных.Имя, ДанныеПоля.Значение);
			
			Возврат Значение; 
			
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ИнициализироватьТабличныйДокумент()
	
	МакетЗаполненияПоВнешнемуИсточнику = Обработки.ЗагрузкаДанныхИзВнешнихФайлов.ПолучитьМакет("Макет"+Объект.ПриемникЗагрузки);
	ТабличныйДокумент.Очистить();  
	
	Для Каждого Область Из СтруктураПолейТаблицыДанных Цикл
		
		ОбластьДанные = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть(Область.ИмяПоля);
		ТабличныйДокумент.Присоединить(ОбластьДанные);
		
	КонецЦикла;
	
	ТабличныйДокумент.ФиксацияСверху = 1;
		
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличества(СтруктураДействий)
	
	СтруктураДействий.Вставить("ПересчитатьСумму");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораНоменклатурыХарактеристик(КодТекущейСтроки, СписокХарактеристик = Ложь)
	
	Если СписокХарактеристик Тогда
		СписокВыбораХарактеристка = Элементы.ДанныеХарактеристика.СписокВыбора;
		СписокВыбораХарактеристка.Очистить();
	Иначе
		СписокВыбораНоменклатура  = Элементы.ДанныеНоменклатура.СписокВыбора;
		СписокВыбораНоменклатура.Очистить();
	КонецЕсли;
	
	МассивПодобраннойНоменклатуры = ПодобраннаяНоменклатура.НайтиСтроки(Новый Структура("КодСтроки", КодТекущейСтроки));
	Для каждого ЭлементМассива Из МассивПодобраннойНоменклатуры Цикл
		Если СписокХарактеристик Тогда
			Если СписокВыбораХарактеристка.НайтиПоЗначению(ЭлементМассива.Характеристика) = Неопределено Тогда
				СписокВыбораХарактеристка.Добавить(ЭлементМассива.Характеристика);
			КонецЕсли;
		Иначе
			Если СписокВыбораНоменклатура.НайтиПоЗначению(ЭлементМассива.Номенклатура) = Неопределено Тогда
				СписокВыбораНоменклатура.Добавить(ЭлементМассива.Номенклатура);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеВХранилище()

	Возврат ПоместитьВоВременноеХранилище(ТаблицаДанных.Выгрузить());

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВариантыОтображенияСтрок(Форма)
	
	СписокВыбора = Форма.Элементы.ВариантОтображенияСтрок.СписокВыбора;
	СписокВыбора.Очистить();
	
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Все (%1)';
			|en = 'All (%1)'"), 
		Форма.ТаблицаДанных.Количество());
		
	СписокВыбора.Добавить(0, Представление); 
	
	СтрокиЕстьНесопоставленныеДанные = Форма.ТаблицаДанных.НайтиСтроки(Новый Структура("ЕстьНесопоставленныеДанные", Истина));
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Несопоставленные (%1)';
			|en = 'Unmapped (%1)'"), 
		СтрокиЕстьНесопоставленныеДанные.Количество());
		
	СписокВыбора.Добавить(1, Представление);
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьАналитикиСтатейБюджета()
	
	КоличествоАналитик = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();	

	ТаблицаЗагружаемыхДанных = ТаблицаДанных.Выгрузить(); 
	
	Для НомерАналитики = 1  По КоличествоАналитик Цикл  
		ТаблицаЗагружаемыхДанных.Колонки.Добавить("ИсточникДанных"+НомерАналитики,ОбщегоНазначения.ОписаниеТипаСтрока(255));
	КонецЦикла;   
	
	ВсеИсточникиДанных = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗагружаемыхДанных Цикл   
		
		Для НомерАналитики = 1 По КоличествоАналитик Цикл 
			ВидАналитикиТипЗначения = СтрокаТаблицы["ВидАналитики"+НомерАналитики+"ТипЗначения"];
			
			Если ВидАналитикиТипЗначения.Типы().Количество() = 1 Тогда
				
				ТипЗначения = ВидАналитикиТипЗначения.Типы()[0];
				
				ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
				
				ИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();	
				
				СтрокаТаблицы["ИсточникДанных"+НомерАналитики] = ИмяОбъектаМетаданных; 
				
				Если ВсеИсточникиДанных.Получить(ИмяОбъектаМетаданных) = Неопределено Тогда
				
					ВсеИсточникиДанных.Вставить(ИмяОбъектаМетаданных,ОбъектМетаданных);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;   
		
	КонецЦикла;
	
	СписокЗагружаемойНоменклатуры = Новый Массив;
	
	Если ТаблицаЗагружаемыхДанных.Количество() <> 0 Тогда
		
		МВТ = Новый МенеджерВременныхТаблиц; 
		
		Запрос = Новый Запрос; 
		Запрос.МенеджерВременныхТаблиц = МВТ;
		
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ЗагружаемыеДанные.НомерСтроки КАК Идентификатор,
		               |	&ПоляАналитики КАК ПоляАналитики,
		               |	&ИсточникиДанных КАК ИсточникиДанных
		               |ПОМЕСТИТЬ ВТ_ЗагружаемыеДанные
		               |ИЗ
		               |	&ЗагружаемыеДанные КАК ЗагружаемыеДанные";
		
		МассивПолейЗапроса = Новый Массив;
		МассивИсточниковДанных = Новый Массив;
		
		Для НомерАналитики = 1 По КоличествоАналитик Цикл  
			ПолеЗапроса = "";
			МассивПолейЗапроса.Добавить(СтрШаблон("ЗагружаемыеДанные.Аналитика%1Загружаемое КАК Аналитика%1Загружаемое",НомерАналитики));
			МассивИсточниковДанных.Добавить(СтрШаблон("ЗагружаемыеДанные.ИсточникДанных%1 КАК ИсточникДанных%1",НомерАналитики));
		КонецЦикла;   
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ПоляАналитики КАК ПоляАналитики", СтрСоединить(МассивПолейЗапроса,","));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ИсточникиДанных КАК ИсточникиДанных", СтрСоединить(МассивИсточниковДанных,","));
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ЗагружаемыеДанные", ТаблицаЗагружаемыхДанных);
		
		Запрос.Выполнить();
		
		МассивТекстовЗапроса = Новый Массив;
		
		Для НомерАналитики = 1 По КоличествоАналитик Цикл  
		
			ТекстЗапроса = "ВЫБРАТЬ
			               |	ЗагружаемыеДанные.Идентификатор КАК Идентификатор,
			               |	&НомерАналитики КАК НомерАналитики,
			               |	&АналитикаЗагружаемое КАК АналитикаЗагружаемое,
			               |	&ИсточникДанных КАК ИсточникДанных,
						   |	НЕОПРЕДЕЛЕНО КАК ЗначениеБД
			               |ИЗ
			               |	ВТ_ЗагружаемыеДанные КАК ЗагружаемыеДанные
			               |ГДЕ
			               |	&Условие";	 
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&НомерАналитики",НомерАналитики);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&АналитикаЗагружаемое","ЗагружаемыеДанные.Аналитика"+НомерАналитики+"Загружаемое");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ИсточникДанных","ЗагружаемыеДанные.ИсточникДанных"+НомерАналитики);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&Условие","ЗагружаемыеДанные.ИсточникДанных"+НомерАналитики+" <> """"");
			
			Если НомерАналитики > 1 Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ПОМЕСТИТЬ ВТ_ЗагружаемыеДанныеОбъединение","");
			КонецЕсли;
			
			МассивТекстовЗапроса.Добавить(ТекстЗапроса); 
			
			
			
		КонецЦикла;	
		
		ТекстЗапроса = СтрСоединить(МассивТекстовЗапроса,"
														|ОБЪЕДИНИТЬ ВСЕ
														|");
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МВТ;
		
		Запрос.Текст = ТекстЗапроса;
		
		ЗагружаемыеДанные = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ИсточникДанных Из ВсеИсточникиДанных Цикл  
			
			ЗагружаемыеСтроки = ЗагружаемыеДанные.НайтиСтроки(Новый Структура("ИсточникДанных",ИсточникДанных.Ключ));
			
			ОбъектМетаданных = ИсточникДанных.Значение;
			
			Если ОбщегоНазначения.ЭтоПеречисление(ОбъектМетаданных) Тогда
				
				Для Каждого ЗагружаемаяСтрока Из ЗагружаемыеСтроки Цикл  
					ЗагружаемаяСтрока.ЗначениеБД = НайтиЗначениеПеречисления(ОбъектМетаданных.Имя,ЗагружаемаяСтрока.АналитикаЗагружаемое);
				КонецЦикла;
				
			ИначеЕсли ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных) Тогда 
				
				ЗначенияАналитик = Новый Массив;
				Для Каждого ЗагружаемаяСтрока Из ЗагружаемыеСтроки Цикл   
					Если ЗначениеЗаполнено(ЗагружаемаяСтрока.АналитикаЗагружаемое) тогда
						ЗначенияАналитик.Добавить(ЗагружаемаяСтрока.АналитикаЗагружаемое);  
					КонецЕсли;
				КонецЦикла;	
				
				Если ЗначенияАналитик.Количество() Тогда
				
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ИсточникДанных.Ссылка КАК Ссылка,
					               |	ИсточникДанных.Наименование КАК Наименование
					               |ИЗ
					               |	&ИсточникДанных КАК ИсточникДанных
					               |ГДЕ
					               |	НЕ ИсточникДанных.ПометкаУдаления
					               |	И ИсточникДанных.Наименование В(&ЗначенияАналитик)";			
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ИсточникДанных",ИсточникДанных.Ключ);
					Запрос.УстановитьПараметр("ЗначенияАналитик",ЗначенияАналитик);
					
					ТаблицаЗначенийАналитик = Запрос.Выполнить().Выгрузить(); 
					
					Для Каждого ЗагружаемаяСтрока Из ЗагружаемыеСтроки Цикл  
						
						НайдСтроки = ТаблицаЗначенийАналитик.НайтиСтроки(Новый Структура("Наименование",ЗагружаемаяСтрока.АналитикаЗагружаемое));
						
						Если НайдСтроки.Количество() = 1 Тогда   
							ЗагружаемаяСтрока.ЗначениеБД = НайдСтроки[0].Ссылка;
						КонецЕсли;
						
					КонецЦикла;	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;	
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл  
		
		Для НомерАналитики = 1 По КоличествоАналитик Цикл 
			
			НайдСтроки = ЗагружаемыеДанные.НайтиСтроки(Новый Структура("НомерАналитики,АналитикаЗагружаемое,Идентификатор",НомерАналитики, СтрокаТаблицы["Аналитика"+НомерАналитики+"Загружаемое"],СтрокаТаблицы.НомерСтроки));
			
			Если НайдСтроки.Количество() Тогда
				СтрокаТаблицы["Аналитика"+НомерАналитики] = НайдСтроки[0].ЗначениеБД;
				ПроверитьСопоставлениеДанныхСтрокиЗагрузки(ЭтотОбъект, СтрокаТаблицы);
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНоменклатуры()
	
	ТаблицаЗагружаемойНоменклатуры = ТаблицаДанных.Выгрузить();
	
	СписокЗагружаемойНоменклатуры = Новый Массив;
	
	Если ТаблицаЗагружаемойНоменклатуры.Количество() <> 0 Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗагружаемыеДанные.НомерСтроки КАК Идентификатор,
		                      |	ВЫРАЗИТЬ(ЗагружаемыеДанные.НоменклатураЗагружаемое КАК СТРОКА(200)) КАК Номенклатура
		                      |ПОМЕСТИТЬ ВтЗагружаемыеДанные
		                      |ИЗ
		                      |	&ЗагружаемыеДанные КАК ЗагружаемыеДанные
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	СпрНоменклатура.Идентификатор КАК Идентификатор,
		                      |	МАКСИМУМ(СпрНоменклатура.Номенклатура) КАК Номенклатура,
		                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СпрНоменклатура.Номенклатура) КАК КоличествоНоменклатуры
		                      |ИЗ
		                      |	(ВЫБРАТЬ
		                      |		ЗагружаемыеДанные.Идентификатор КАК Идентификатор,
		                      |		СпрНоменклатура.Ссылка КАК Номенклатура
		                      |	ИЗ
		                      |		ВтЗагружаемыеДанные КАК ЗагружаемыеДанные
		                      |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		                      |			ПО (СпрНоменклатура.Наименование = ЗагружаемыеДанные.Номенклатура)
		                      |	ГДЕ
		                      |		НЕ СпрНоменклатура.ПометкаУдаления) КАК СпрНоменклатура
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	СпрНоменклатура.Идентификатор
		                      |
		                      |ИМЕЮЩИЕ
		                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СпрНоменклатура.Номенклатура) < 2");
		
		Запрос.УстановитьПараметр("ЗагружаемыеДанные", ТаблицаЗагружаемойНоменклатуры);
		
		СписокЗагружаемойНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	Номенклатура.Код КАК Код
	|ПОМЕСТИТЬ НомХар
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
	|	И Номенклатура.Ссылка В(&ОтборПоЗагружаемойНоменклатуре)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	ХарактеристикиНоменклатуры.Ссылка,
	|	Номенклатура.Код
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО (ВЫБОР
	|				КОГДА Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
	|					ТОГДА Номенклатура.Ссылка
	|				КОГДА Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
	|					ТОГДА Номенклатура.ВладелецХарактеристик
	|				КОГДА Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
	|					ТОГДА Номенклатура.ВидНоменклатуры
	|				ИНАЧЕ НЕОПРЕДЕЛЕНО
	|			КОНЕЦ = ХарактеристикиНоменклатуры.Владелец)
	|ГДЕ
	|	Номенклатура.ИспользованиеХарактеристик <> ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И Номенклатура.Ссылка В(&ОтборПоЗагружаемойНоменклатуре)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомХар.Код КАК Код,
	|	"""" КАК АртикулПоиск,
	|	НомХар.Номенклатура.Наименование КАК Наименование,
	|	"""" КАК НаименованиеПоиск,
	|	НомХар.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	"""" КАК НаименованиеПолноеПоиск,
	|	НомХар.Номенклатура КАК Номенклатура,
	|	НомХар.Характеристика.Наименование КАК НаименованиеХарактеристики,
	|	"""" КАК НаименованиеХарактеристикиПоиск,
	|	НомХар.Характеристика КАК Характеристика
	|ИЗ
	|	НомХар КАК НомХар";
	
	Запрос.УстановитьПараметр("ОтборПоЗагружаемойНоменклатуре", СписокЗагружаемойНоменклатуры);
	Запрос.УстановитьПараметр("Данные", ТаблицаДанных.Выгрузить());
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаНоменклатуры.Загрузить(Результаты[1].Выгрузить());
	
	Для Каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		ТекСтрока.Код = ВРег(СтрЗаменить(ТекСтрока.Код, " ", ""));
		ТекСтрока.НаименованиеПоиск = ВРег(СтрЗаменить(ТекСтрока.Наименование, " ", ""));
		ТекСтрока.НаименованиеПолноеПоиск = ВРег(СтрЗаменить(ТекСтрока.НаименованиеПолное, " ", ""));
		ТекСтрока.НаименованиеХарактеристикиПоиск = ВРег(СтрЗаменить(ТекСтрока.НаименованиеХарактеристики, " ", ""));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НайтиНоменклатуруПоЗагружаемымДанным(СтрокаТЧ)
	
	НомерСтроки = СтрокаТЧ.НомерСтроки;
	СтрокаПоискаНоменклатура   = ВРег(СтрЗаменить(СтрокаТЧ.НоменклатураЗагружаемое, " ", ""));
	СтрокаПоискаХарактеристика = ВРег(СтрЗаменить(СтрокаТЧ.ХарактеристикаЗагружаемое, " ", ""));
	
	ТаблицаНоменклатурыВрем = ТаблицаНоменклатуры.Выгрузить();
	
	Если ЗначениеЗаполнено(СтрокаТЧ.НоменклатураЗагружаемое) И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаЗагружаемое) Тогда
		
		НайденныеСтроки = ТаблицаНоменклатурыВрем.Скопировать(Новый Структура("НаименованиеПоиск,НаименованиеХарактеристикиПоиск",
														СтрокаПоискаНоменклатура,СтрокаПоискаХарактеристика));
														
		ПоискБезУчетаХарактеристики = Ложь;												
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки = ТаблицаНоменклатурыВрем.Скопировать(Новый Структура("НаименованиеПоиск",СтрокаПоискаНоменклатура));
			ПоискБезУчетаХарактеристики = Истина;	
		КонецЕсли;
															
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки = ТаблицаНоменклатурыВрем.Скопировать(Новый Структура("НаименованиеПолноеПоиск",СтрокаПоискаНоменклатура));
			ПоискБезУчетаХарактеристики = Истина;											
		КонецЕсли;
		
		Если ПоискБезУчетаХарактеристики Тогда
			НайденныеСтроки.Свернуть("Номенклатура");												
			Если НайденныеСтроки.Количество() Тогда
				ПодобраннаяСтрока = ПодобраннаяНоменклатура.Добавить();
				ПодобраннаяСтрока.КодСтроки = НомерСтроки;
				ЗаполнитьЗначенияСвойств(ПодобраннаяСтрока, НайденныеСтроки[0]);
			КонецЕсли;
		Иначе
			НайденныеСтроки.Свернуть("Номенклатура,Характеристика");												
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ПодобраннаяСтрока = ПодобраннаяНоменклатура.Добавить();
				ПодобраннаяСтрока.КодСтроки = НомерСтроки;
				ЗаполнитьЗначенияСвойств(ПодобраннаяСтрока, НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли  ЗначениеЗаполнено(СтрокаТЧ.НоменклатураЗагружаемое) И Не ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаЗагружаемое) Тогда
		
		НайденныеСтроки = ТаблицаНоменклатурыВрем.Скопировать(Новый Структура("НаименованиеПоиск",СтрокаПоискаНоменклатура));
			
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки = ТаблицаНоменклатурыВрем.Скопировать(Новый Структура("НаименованиеПолноеПоиск",СтрокаПоискаНоменклатура));
		КонецЕсли;
		
		НайденныеСтроки.Свернуть("Номенклатура");
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ПодобраннаяСтрока = ПодобраннаяНоменклатура.Добавить();
			ПодобраннаяСтрока.КодСтроки = НомерСтроки;
			ЗаполнитьЗначенияСвойств(ПодобраннаяСтрока, НайденнаяСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	МассивПодобраннойНоменклатуры = ПодобраннаяНоменклатура.НайтиСтроки(Новый Структура("КодСтроки", НомерСтроки));
	
	Если МассивПодобраннойНоменклатуры.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, МассивПодобраннойНоменклатуры.Получить(0));
	Иначе
		СтрокаТЧ.КодСтроки = СтрокаТЧ.НомерСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗагружаемыеДанные()
	
	СтруктураДанных = СтруктураЗаполненныхДанных(ЭтотОбъект);
	
	НомерСтроки = 0;                               
	
	Для Каждого ЭлементСтруктуры Из СтруктураДанных Цикл  
		
		НоваяСтрока = Новый Структура("КодСтроки", ЭлементСтруктуры.Значение.КодСтроки);
		
		ДанныеСтроки = ЭлементСтруктуры.Значение.ДанныеСтроки;
		
		Для Каждого ЭлементДанных Из ДанныеСтроки Цикл 
			
			ДанныеПоля = ЭлементДанных.Значение;
			
			ЗначениеПеречисления = ЗначениеПеречисления(ДанныеПоля);

			Если ДанныеПоля.Загружаемое Тогда  
				НоваяСтрока.Вставить(ЭлементДанных.Ключ+"Загружаемое", ДанныеПоля.Значение); 
      		КонецЕсли;
			
			Если Не ДанныеПоля.Поиск Тогда 
				НоваяСтрока.Вставить(ЭлементДанных.Ключ, ДанныеПоля.Значение); 
			КонецЕсли;  
			
			Если ЗначениеЗаполнено(ЗначениеПеречисления) Тогда 
				НоваяСтрока.Вставить(ЭлементДанных.Ключ, ЗначениеПеречисления); 
			КонецЕсли; 
				
		КонецЦикла;
		
		НоваяСтрока.Вставить("ЕстьНесопоставленныеДанные", Истина);
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрокаДанные = ТаблицаДанных.Добавить();
		НоваяСтрокаДанные.НомерСтроки = НомерСтроки;

		ЗаполнитьЗначенияСвойств(НоваяСтрокаДанные, НоваяСтрока);
	
		ПересчитатьСуммуВСтрокеТЧ(ЭтотОбъект, НоваяСтрокаДанные.ПолучитьИдентификатор());
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОписаниеПоляТаблицыДанных(ОписаниеПоля, НомерКолонки)
	
	НовСтр = СтруктураПолейТаблицыДанных.Добавить(); 
	
	ЗаполнитьЗначенияСвойств(НовСтр, ОписаниеПоля);
	НовСтр.НомерКолонки = НомерКолонки;	 
	
	НомерКолонки = НомерКолонки + 1;
	
	Если ОписаниеПоля.Загружаемое Тогда  
		
		Если Не ТипЗнч(НовСтр.НастройкиЭлементаЗагружаемое) = Тип("Структура") Тогда
			НовСтр.НастройкиЭлементаЗагружаемое = Новый Структура;  
		КонецЕсли;
		
		НовСтр.НастройкиЭлементаЗагружаемое.Вставить("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);  
		НовСтр.НастройкиЭлементаЗагружаемое.Вставить("ОтображатьВШапке", Ложь);
		
	КонецЕсли;   
	
	Если ОписаниеПоля.СобытияЭлемента = Неопределено И ОписаниеПоля.Обязательное Тогда
		
		СобытияЭлемента = Новый Структура;    
	
		СобытияЭлемента.Вставить("ПриИзменении","Подключаемый_ПриИзмененииОбязательногоПоля");	
		
		НовСтр.СобытияЭлемента = СобытияЭлемента;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НовыйОписаниеПоляТаблицыДанных()
	
	ОписаниеПоля = Новый Структура;
	ОписаниеПоля.Вставить("ИмяПоля","");
	ОписаниеПоля.Вставить("Поиск", Истина);
	ОписаниеПоля.Вставить("Обязательное", Истина);
	ОписаниеПоля.Вставить("Служебное", Ложь);
	ОписаниеПоля.Вставить("Заголовок", "");
	ОписаниеПоля.Вставить("ТипЗагружаемое", Новый ОписаниеТипов("Строка"));
	ОписаниеПоля.Вставить("ТипПоляОбъекта");
	ОписаниеПоля.Вставить("Загружаемое", Истина);
	ОписаниеПоля.Вставить("СобытияЭлемента");
	ОписаниеПоля.Вставить("Зависимости");
	ОписаниеПоля.Вставить("Аналитика", Ложь);
	ОписаниеПоля.Вставить("НастройкиЭлементаЗагружаемое");
	ОписаниеПоля.Вставить("НастройкиЭлемента");
	ОписаниеПоля.Вставить("СвязиПараметровВыбора");
	
	Возврат ОписаниеПоля;

КонецФункции

&НаСервере
Функция СобытияЭлемента(ОписаниеПоля, ПриИзменении)
	
	СобытияЭлемента = Новый Структура;    
	
	Если ПриИзменении Тогда 
		СобытияЭлемента.Вставить("ПриИзменении","Подключаемый_"+ОписаниеПоля.ИмяПоля+"_ПриИзменении");	
	КонецЕсли;
	
	Возврат СобытияЭлемента;

КонецФункции

&НаСервере
Функция ЗависимостиПолеНоменклатура()
	
	Зависимости = Новый СписокЗначений; 
	
	Действия = Новый Структура;
	Действия.Вставить("ОчищатьПоля","ТоварнаяКатегория");	
	Действия.Вставить("БлокироватьПоля","ТоварнаяКатегория");	
	Действия.Вставить("РазблокироватьПоля","Номенклатура,Характеристика,ЕдиницаИзмерения,Количество,Цена");	
	Действия.Вставить("УстановитьПризнакОбязательногоПоляЛожь","ТоварнаяКатегория");	
	Действия.Вставить("УстановитьПризнакОбязательногоПоляИстина","Номенклатура,ЕдиницаИзмерения,ДатаОперации,Валюта,МестоПоставки,УсловиеОплаты,СтатьяБюджета");	

	Зависимость = Новый Структура;
	Зависимость.Вставить("Условие","ПолеЗаполнено");	
	Зависимость.Вставить("Действия",Действия);
	
	Зависимости.Добавить(Зависимость);
	
	Возврат Зависимости; 

КонецФункции  

&НаСервере
Функция ЗависимостиПолеТоварнаяКатегория()
	
	Зависимости = Новый СписокЗначений; 
	
	ЗависимыеПоля = "Номенклатура,Характеристика,ЕдиницаИзмерения,Количество,Цена";

	Действия = Новый Структура;
	Действия.Вставить("ОчищатьПоля",ЗависимыеПоля);	
	Действия.Вставить("БлокироватьПоля",ЗависимыеПоля);	
	Действия.Вставить("УстановитьПризнакОбязательногоПоляЛожь",ЗависимыеПоля);	
	Действия.Вставить("УстановитьПризнакОбязательногоПоляИстина","ТоварнаяКатегория,ДатаОперации,Валюта,МестоПоставки,УсловиеОплаты,СтатьяБюджета");	
	
	
	Зависимость = Новый Структура;
	Зависимость.Вставить("Условие","ПолеЗаполнено");	
	Зависимость.Вставить("Действия",Действия);
	
	Зависимости.Добавить(Зависимость);
	
	Возврат Зависимости; 

КонецФункции  

&НаСервере
Функция УстановитьЗависимостьОбязательногоПоля(ОписаниеПоля)
	
	Зависимости = Новый СписокЗначений; 
	
	ЗависимыеПоля = ОписаниеПоля.ИмяПоля;

	ДействиеПолеЗаполнено = Новый Структура;
	ДействиеПолеЗаполнено.Вставить("УстановитьПризнакОбязательногоПоляИстина",ЗависимыеПоля);	
	
	
	Зависимость = Новый Структура;
	Зависимость.Вставить("Условие","ПолеЗаполнено");	
	Зависимость.Вставить("Действия",ДействиеПолеЗаполнено);

	Зависимости.Добавить(Зависимость);

	Возврат Зависимости; 

КонецФункции   

&НаСервере
Процедура СопоставитьДанныеЗаявкаНаЗакупкуБезАналитик()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеДляСопоставления", ТаблицаДанных.Выгрузить());
	ПустоеУсловиеОплаты = КэшируемыеПроцедурыОПК.ПустоеУсловиеОплаты();
	Запрос.УстановитьПараметр("ПустоеУсловиеОплаты", ПустоеУсловиеОплаты);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеДляСопоставления.ТоварнаяКатегорияЗагружаемое КАК ТоварнаяКатегорияЗагружаемое,
	|	ДанныеДляСопоставления.ЕдиницаИзмеренияЗагружаемое КАК ЕдиницаИзмеренияЗагружаемое,
	|	ДанныеДляСопоставления.ВалютаЗагружаемое КАК ВалютаЗагружаемое,
	|	ДанныеДляСопоставления.МестоПоставкиЗагружаемое КАК МестоПоставкиЗагружаемое,
	|	ДанныеДляСопоставления.УсловиеОплатыЗагружаемое КАК УсловиеОплатыЗагружаемое,
	|	ДанныеДляСопоставления.СтатьяБюджетаЗагружаемое КАК СтатьяБюджетаЗагружаемое,
	|	ДанныеДляСопоставления.ТоварнаяКатегория КАК ТоварнаяКатегория,
	|	ДанныеДляСопоставления.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДляСопоставления.Валюта КАК Валюта,
	|	ДанныеДляСопоставления.МестоПоставки КАК МестоПоставки,
	|	ДанныеДляСопоставления.УсловиеОплаты КАК УсловиеОплаты,
	|	ДанныеДляСопоставления.СтатьяБюджета КАК СтатьяБюджета,
	|	ВЫРАЗИТЬ(ДанныеДляСопоставления.КодСтроки КАК ЧИСЛО(15, 0)) КАК КодСтроки
	|ПОМЕСТИТЬ ДанныеДляСопоставления
	|ИЗ
	|	&ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТоварныеКатегории.Ссылка) КАК ТоварнаяКатегория,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""ТоварнаяКатегория"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТоварныеКатегории КАК ТоварныеКатегории
	|		ПО (ТоварныеКатегории.Наименование ПОДОБНО ДанныеДляСопоставления.ТоварнаяКатегорияЗагружаемое)
	|ГДЕ
	|	НЕ ТоварныеКатегории.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.ТоварнаяКатегория = ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Валюты.Ссылка) КАК Валюта,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""Валюта"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО (Валюты.Наименование ПОДОБНО ДанныеДляСопоставления.ВалютаЗагружаемое)
	|ГДЕ
	|	НЕ Валюты.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(КлассификаторЕдиницИзмерения.Ссылка) КАК ЕдиницаИзмерения,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""ЕдиницаИзмерения"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО (КлассификаторЕдиницИзмерения.Наименование ПОДОБНО ДанныеДляСопоставления.ЕдиницаИзмеренияЗагружаемое)
	|ГДЕ
	|	НЕ КлассификаторЕдиницИзмерения.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(МестаПоставки.Ссылка) КАК МестоПоставки,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""МестоПоставки"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МестаПоставки КАК МестаПоставки
	|		ПО (МестаПоставки.Наименование ПОДОБНО ДанныеДляСопоставления.МестоПоставкиЗагружаемое)
	|ГДЕ
	|	НЕ МестаПоставки.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.МестоПоставки = ЗНАЧЕНИЕ(Справочник.МестаПоставки.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(УсловияОплаты.Ссылка) КАК УсловиеОплаты,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""УсловиеОплаты"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УсловияОплаты КАК УсловияОплаты
	|		ПО (УсловияОплаты.Наименование ПОДОБНО ДанныеДляСопоставления.УсловиеОплатыЗагружаемое)
	|ГДЕ
	|	НЕ УсловияОплаты.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.УсловиеОплаты = &ПустоеУсловиеОплаты
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(СтатьиДвиженияДенежныхСредств.Ссылка) КАК СтатьяБюджета,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""СтатьяБюджета"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|		ПО (СтатьиДвиженияДенежныхСредств.Наименование ПОДОБНО ДанныеДляСопоставления.СтатьяБюджетаЗагружаемое)
	|ГДЕ
	|	НЕ СтатьиДвиженияДенежныхСредств.Ссылка ЕСТЬ NULL
	|	И (ДанныеДляСопоставления.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ИЛИ ДанныеДляСопоставления.СтатьяБюджета = НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_УсловияОплаты", ПустоеУсловиеОплаты.Метаданные().ПолноеИмя());
	Запрос.Текст = ТекстЗапроса;
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();  
	КоличествоПакетов = РезультатыЗапросов.Количество()-1;
	Для НомерПакета = 0 По КоличествоПакетов Цикл
		
		Если НомерПакета = КоличествоПакетов Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаСопоставления = РезультатыЗапросов[КоличествоПакетов - НомерПакета].Выгрузить();
		
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл 
			
			СтрокаДанных = ТаблицаСопоставления.Найти(СтрокаТаблицы.КодСтроки, "КодСтроки");
			Если СтрокаДанных <> Неопределено Тогда 
				СтрокаТаблицы[СтрокаДанных.ИмяПоля]  = СтрокаДанных[СтрокаДанных.ИмяПоля];
				ПроверитьСопоставлениеДанныхСтрокиЗагрузки(ЭтотОбъект, СтрокаТаблицы);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьДанныеБюджетнаяЗаявкаБезАналитик()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляСопоставления.ОрганизацияЗагружаемое КАК ОрганизацияЗагружаемое,
	|	ДанныеДляСопоставления.ЦФОЗагружаемое КАК ЦФОЗагружаемое,
	|	ДанныеДляСопоставления.ВалютаЗагружаемое КАК ВалютаЗагружаемое,
	|	ДанныеДляСопоставления.ПроектЗагружаемое КАК ПроектЗагружаемое,
	|	ДанныеДляСопоставления.ПриходРасходЗагружаемое КАК ПриходРасходЗагружаемое,
	|	ДанныеДляСопоставления.СтатьяБюджетаЗагружаемое КАК СтатьяБюджетаЗагружаемое,
	|	ДанныеДляСопоставления.Валюта КАК Валюта,
	|	ДанныеДляСопоставления.Организация КАК Организация,
	|	ДанныеДляСопоставления.Проект КАК Проект,
	|	ДанныеДляСопоставления.ЦФО КАК ЦФО,
	|	ДанныеДляСопоставления.ПриходРасход КАК ПриходРасход,
	|	ДанныеДляСопоставления.СтатьяБюджета КАК СтатьяБюджета,
	|	ВЫРАЗИТЬ(ДанныеДляСопоставления.КодСтроки КАК ЧИСЛО(15, 0)) КАК КодСтроки
	|ПОМЕСТИТЬ ДанныеДляСопоставления
	|ИЗ
	|	&ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Организации.Ссылка) КАК Организация,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""Организация"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (Организации.Наименование ПОДОБНО ДанныеДляСопоставления.ОрганизацияЗагружаемое)
	|ГДЕ
	|	НЕ Организации.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Организации.Ссылка) КАК ЦФО,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""ЦФО"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (Организации.Наименование ПОДОБНО ДанныеДляСопоставления.ЦФОЗагружаемое)
	|ГДЕ
	|	НЕ Организации.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.ЦФО = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Проекты.Ссылка) КАК Проект,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""Проект"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО (Проекты.Наименование ПОДОБНО ДанныеДляСопоставления.ПроектЗагружаемое)
	|ГДЕ
	|	НЕ Проекты.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.Проект = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Валюты.Ссылка) КАК Валюта,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""Валюта"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО (Валюты.Наименование ПОДОБНО ДанныеДляСопоставления.ВалютаЗагружаемое)
	|ГДЕ
	|	НЕ Валюты.Ссылка ЕСТЬ NULL
	|	И ДанныеДляСопоставления.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(СтатьиДвиженияДенежныхСредств.Ссылка) КАК СтатьяБюджета,
	|	ДанныеДляСопоставления.КодСтроки КАК КодСтроки,
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) КАК Количество,
	|	""СтатьяБюджета"" КАК ИмяПоля
	|ИЗ
	|	ДанныеДляСопоставления КАК ДанныеДляСопоставления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|		ПО (СтатьиДвиженияДенежныхСредств.Наименование ПОДОБНО ДанныеДляСопоставления.СтатьяБюджетаЗагружаемое)
	|ГДЕ
	|	НЕ СтатьиДвиженияДенежныхСредств.Ссылка ЕСТЬ NULL
	|	И (ДанныеДляСопоставления.СтатьяБюджета = ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ИЛИ ДанныеДляСопоставления.СтатьяБюджета = НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДляСопоставления.КодСтроки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДанныеДляСопоставления.КодСтроки) = 1";

	
	Запрос.УстановитьПараметр("ДанныеДляСопоставления", ТаблицаДанных.Выгрузить());
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();  
	
	КоличествоПакетов = РезультатыЗапросов.Количество()-1;
	
	Для НомерПакета = 0 По КоличествоПакетов Цикл
		
		Если НомерПакета = КоличествоПакетов Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаСопоставления = РезультатыЗапросов[КоличествоПакетов - НомерПакета].Выгрузить();
		
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл 
			
			СтрокаДанных = ТаблицаСопоставления.Найти(СтрокаТаблицы.КодСтроки, "КодСтроки");
			Если СтрокаДанных <> Неопределено Тогда 
				СтрокаТаблицы[СтрокаДанных.ИмяПоля]  = СтрокаДанных[СтрокаДанных.ИмяПоля];
				ПроверитьСопоставлениеДанныхСтрокиЗагрузки(ЭтотОбъект, СтрокаТаблицы);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОписаниеПолейТаблицыДанных() Экспорт
	
	Если Объект.ПриемникЗагрузки = "ЗаявкаНаОбеспечение" Тогда  
		ИнициализироватьОписаниеПолейТаблицыДанных_ЗаявкаНаЗакупку();
	ИначеЕсли Объект.ПриемникЗагрузки = "Резервирование" Тогда  
		ИнициализироватьОписаниеПолейТаблицыДанных_БюджетнаяЗаявка();
	ИначеЕсли Объект.ПриемникЗагрузки = "ПараметрыЛимитирования" Тогда  
		ИнициализироватьОписаниеПолейТаблицыДанных_ПараметрыЛимитирования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СопоставитьДанныеТабличногоДокументаСДаннымиИБ()Экспорт
	
	ТаблицаДанных.Очистить();
	
	Если Объект.ПриемникЗагрузки = "ЗаявкаНаОбеспечение" Тогда  
		СопоставитьДанныеТабличногоДокументаСДаннымиИБ_ЗаявкаНаЗакупку();
	ИначеЕсли Объект.ПриемникЗагрузки = "Резервирование" Тогда  
		СопоставитьДанныеТабличногоДокументаСДаннымиИБ_БюджетнаяЗаявка();
	ИначеЕсли Объект.ПриемникЗагрузки = "ПараметрыЛимитирования" Тогда  
		СопоставитьДанныеТабличногоДокументаСДаннымиИБ_ПараметрыЛимитирования();
	КонецЕсли;
	
	НастроитьВариантыОтображенияСтрок(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()Экспорт
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл 
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда 
			ИспользованиеХарактеристик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Номенклатура, "ИспользованиеХарактеристик");
			СтрокаТаблицы.ХарактеристикиИспользуются = ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакОбязательногоПоля(Форма, ДанныеСтроки, ДанныеПоля)Экспорт

	Зависимости = ДанныеПоля.Зависимости;
	
	Если ТипЗнч(Зависимости) = Тип("СписокЗначений") Тогда  
		
		Для Каждого СтрокаСписка Из Зависимости Цикл  
			
			СтруктураЗависимости = СтрокаСписка.Значение;
			
			Если УсловиеВыполнено(СтруктураЗависимости.Условие, ДанныеСтроки, ДанныеПоля) Тогда
				
				Для Каждого Действие Из СтруктураЗависимости.Действия Цикл
					
					Поля = СтрРазделить(Действие.Значение,",");
					
					Если Действие.Ключ = "УстановитьПризнакОбязательногоПоляИстина" Тогда 
						
						Значение = Истина;	
						
					ИначеЕсли Действие.Ключ = "УстановитьПризнакОбязательногоПоляЛожь" Тогда 
						
						Значение = Ложь;	
						
					КонецЕсли;
					
					Если Значение <> Неопределено Тогда
					
						Для Каждого Поле Из Поля Цикл  
							
							ДанныеСтроки[Поле].Обязательное = Значение;	
							
						КонецЦикла; 
						
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбластьСтрокой(НомерСтроки, НомерКолонки)Экспорт
	
	Возврат "R"+ Формат(НомерСтроки, "ЧН=0; ЧГ=0") + "C" + Формат(НомерКолонки, "ЧН=0; ЧГ=0")

КонецФункции   

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеЯчейки(Знач Значение, СтруктураПолейТаблицыДанных, ОписаниеПоля)Экспорт
	
	Если ТипЗнч(Значение) = Тип("Строка") 
		И ОписаниеПоля.Тип.СодержитТип(Тип("Число")) 
		И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Значение = Число(Значение); 
		Исключение
			Значение = Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") 
		И ОписаниеПоля.Тип.СодержитТип(Тип("Дата")) 
		И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Значение = Дата(Прав(Значение,4) + Сред(Значение,4,2) + Лев(Значение,2)); // Преобразование к дате для строки формата "dd.MM.yyyy"
		Исключение
			Значение = Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") 
		И ОписаниеПоля.Тип.СодержитТип(Тип("Булево")) Тогда
		
		Если ВРег(Значение) = "ДА" ИЛИ ВРег(Значение) = "1" ИЛИ ВРег(Значение) = "TRUE" ИЛИ ВРег(Значение) = "V" Тогда
			Значение = Истина;
		Иначе
			Значение = Ложь;
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат Значение;

КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураЗаполненныхДанных(Форма, ДанныеТабличнойЧасти = Ложь)Экспорт
	
	СтруктураПолейТаблицыДанных = Форма.СтруктураПолейТаблицыДанных;
	
	ТабличныйДокумент = Форма.ТабличныйДокумент;
	
	Если ДанныеТабличнойЧасти Тогда   
		СтрокаНачалаДанных = 0; 
  		ТаблицаДанных = Форма.ТаблицаДанных;
		КоличествоСтрок = ТаблицаДанных.Количество()-1;  
	Иначе
		СтрокаНачалаДанных = 2; 
		КоличествоСтрок = ТабличныйДокумент.ВысотаТаблицы;
	КонецЕсли;
	
	
	СтруктураДанных = Новый Структура;
	
	Для НомерСтроки = СтрокаНачалаДанных По КоличествоСтрок Цикл
		
		КлючСтруктуры = "Строка"+Формат(НомерСтроки - СтрокаНачалаДанных + 1, "ЧН=0; ЧГ=0");
		ДанныеСтроки = Новый Структура;	
		
		Для каждого ОписаниеПоля Из СтруктураПолейТаблицыДанных Цикл 
			
			Если ОписаниеПоля.Служебное Тогда
				Продолжить;
			КонецЕсли;
			
			Область = ОбластьСтрокой(НомерСтроки,ОписаниеПоля.НомерКолонки);
			
			Если ДанныеТабличнойЧасти Тогда
				СтрокаТаблицы = ТаблицаДанных[НомерСтроки];	

				ЗначениеЯчейки = ЗначениеЯчейки(СтрокаТаблицы[ОписаниеПоля.ИмяПоля], СтруктураПолейТаблицыДанных, ОписаниеПоля); 
			Иначе     
				ЗначениеЯчейки = ЗначениеЯчейки(ТабличныйДокумент.Область(Область).Текст, СтруктураПолейТаблицыДанных, ОписаниеПоля);
			КонецЕсли;
			
			ДанныеСтроки.Вставить(ОписаниеПоля.ИмяПоля, Новый Структура("ИмяПоля,
																		|Значение,
																		|Зависимости,
																		|Заголовок,
																		|Область,
																		|Обязательное,
																		|Загружаемое,
																		|Поиск,
																		|Тип",
																		ОписаниеПоля.ИмяПоля,
																		ЗначениеЯчейки,
																		ОписаниеПоля.Зависимости,
																		ОписаниеПоля.Заголовок,
																		Область,
																		ОписаниеПоля.Обязательное,
																		ОписаниеПоля.Загружаемое,
																		ОписаниеПоля.Поиск,
																		ОписаниеПоля.Тип));
			
		КонецЦикла;   
		
		ЕстьЗначениеВСтроке = Ложь;
		
		Для Каждого КлючЗначение Из ДанныеСтроки Цикл 
			
			Если Не ДанныеСтроки.Свойство(КлючЗначение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеПоля = ДанныеСтроки[КлючЗначение.Ключ]; 
			
			Если ЗначениеЗаполнено(ДанныеПоля.Значение) Тогда
				ЕстьЗначениеВСтроке = Истина;	
			КонецЕсли;  
			
			УстановитьПризнакОбязательногоПоля(Форма, ДанныеСтроки, ДанныеПоля);
			
		КонецЦикла;
		
		Если ЕстьЗначениеВСтроке Тогда
		    СтруктураДанных.Вставить(КлючСтруктуры, Новый Структура("КодСтроки,ДанныеСтроки",НомерСтроки,ДанныеСтроки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураДанных;

КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Функция УсловиеВыполнено(Условие, ДанныеСтроки, ДанныеПоля) Экспорт
	
	Если Условие = "ПолеЗаполнено" Тогда 
		
		Если ТипЗнч(ДанныеСтроки) = Тип("Структура") Тогда
			Возврат ЗначениеЗаполнено(ДанныеСтроки[ДанныеПоля.ИмяПоля].Значение);
		Иначе 
			Возврат ЗначениеЗаполнено(ДанныеСтроки[ДанныеПоля.ИмяПоля]);
		КонецЕсли;
		
	ИначеЕсли Условие = "ПолеНеЗаполнено" Тогда          
		
		Если ТипЗнч(ДанныеСтроки) = Тип("Структура") Тогда
			Возврат Не ЗначениеЗаполнено(ДанныеСтроки[ДанныеПоля.ИмяПоля].Значение);
		Иначе 
			Возврат Не ЗначениеЗаполнено(ДанныеСтроки[ДанныеПоля.ИмяПоля]);
		КонецЕсли;      
		
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьСопоставлениеДанныхСтрокиЗагрузки(Форма, СтрокаЗагрузки)Экспорт
	
	Если СтрокаЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	СтруктураПолейТаблицыДанных = Форма.СтруктураПолейТаблицыДанных;
	
	СтрокаЗагрузки.ЕстьНесопоставленныеДанные = Ложь;
	
	СтрокиПоиска = СтруктураПолейТаблицыДанных.НайтиСтроки(Новый Структура("Обязательное",Истина));
	
	Для Каждого ОписаниеПоля Из СтрокиПоиска Цикл 
		
		Если ОписаниеПоля.Загружаемое И Не ОписаниеПоля.Служебное Тогда
		
			Если ЗначениеЗаполнено(СтрокаЗагрузки[ОписаниеПоля.ИмяПоля+"Загружаемое"]) 
					И НЕ ЗначениеЗаполнено(СтрокаЗагрузки[ОписаниеПоля.ИмяПоля]) Тогда
					СтрокаЗагрузки.ЕстьНесопоставленныеДанные = Истина;
				Возврат;
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммуВСтрокеТЧ(Форма, ИдентификаторСтроки)Экспорт
	
	ТаблицаДанных = Форма.ТаблицаДанных;
	
	ТекущиеДанные = ТаблицаДанных.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Количество")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Цена")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Сумма") Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
			ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПронумероватьСтроки(Форма)
	
	ТаблицаДанных = Форма.ТаблицаДанных;
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл  
		НомерСтроки = НомерСтроки + 1;
		СтрокаТаблицы.НомерСтроки = НомерСтроки;	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВидСравненияКомпоновкиДанныхПоУсловиюДействияЗависимости(Условие)
	
	Если Условие = "ПолеЗаполнено" Тогда
		Возврат ВидСравненияКомпоновкиДанных.Заполнено;
	ИначеЕсли Условие = "ПолеНеЗаполнено" Тогда
		Возврат ВидСравненияКомпоновкиДанных.НеЗаполнено;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ВыполнитьЗависимыеДействия(Форма, ИмяЭлемента)
	
	ИмяПоля = Сред(ИмяЭлемента,7,СтрДлина(ИмяЭлемента)); 
	
	СтруктураПолейТаблицыДанных = Форма.СтруктураПолейТаблицыДанных;

	Элементы = Форма.Элементы;
	
	ОписаниеПоля = ОписаниеПоляПоИмениПоля(СтруктураПолейТаблицыДанных, ИмяПоля);
	
	Зависимости = ОписаниеПоля.Зависимости;
	
	ДанныеСтроки = Элементы.ТаблицаДанных.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Зависимости) = Тип("СписокЗначений") Тогда  
		
		Для Каждого СтрокаСписка Из Зависимости Цикл  
			
			СтруктураЗависимости = СтрокаСписка.Значение;
			
			Если УсловиеВыполнено(СтруктураЗависимости.Условие, ДанныеСтроки, ОписаниеПоля) Тогда
				
				Для Каждого Действие Из СтруктураЗависимости.Действия Цикл
					
					Если Действие.Ключ = "ОчищатьПоля" Тогда 
						
						Поля = СтрРазделить(Действие.Значение,",");
						
						Для Каждого Поле Из Поля Цикл  
							ДанныеСтроки[Поле] = Неопределено;	
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыЭлементыФормы()
	
	Родитель = Элементы.ТаблицаДанныхГруппаОсновныеРеквизиты;
	
	ДобавляемыеРеквизиты = Новый Массив;	

	Для Каждого ОписаниеПоля Из СтруктураПолейТаблицыДанных Цикл    
		
		Если ОписаниеПоля.Служебное Или Не ОписаниеПоля.Загружаемое Тогда
			Продолжить;
		КонецЕсли;
		
		НовРеквизит = Новый РеквизитФормы(ОписаниеПоля.ИмяПоля,ОписаниеПоля.Тип, "ТаблицаДанных");
		НовРеквизитЗагружаемое = Новый РеквизитФормы(ОписаниеПоля.ИмяПоля+"Загружаемое",ОписаниеПоля.ТипЗагружаемое, "ТаблицаДанных");
		
		ДобавляемыеРеквизиты.Добавить(НовРеквизит);        
		ДобавляемыеРеквизиты.Добавить(НовРеквизитЗагружаемое);        
	
	
	КонецЦикла;   
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	//Создадим элементы 
	
	Для Каждого ОписаниеПоля Из СтруктураПолейТаблицыДанных Цикл    
		
		Если ОписаниеПоля.Служебное Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяГруппа = ФормыУХ.СоздатьГруппуФормы(Элементы, "ДанныеГруппа"+ОписаниеПоля.ИмяПоля,,ВидГруппыФормы.ГруппаКолонок,Элементы.ТаблицаДанныхГруппаОсновныеРеквизиты); 

		ПолеФормыЗначение = ФормыУХ.СоздатьПолеФормы(Элементы,
													"Данные"+ОписаниеПоля.ИмяПоля,
													ОписаниеПоля.Заголовок,
													"ТаблицаДанных."+ОписаниеПоля.ИмяПоля,,
													НоваяГруппа,,,
													ОписаниеПоля.СобытияЭлемента);
		УстановитьСвязиПараметровВыбора(ПолеФормыЗначение, ОписаниеПоля.СвязиПараметровВыбора);	
		УстановитьСвязьПоТипу(ПолеФормыЗначение, ОписаниеПоля.СвязьПоТипу);
		НастроитьЭлемент(ПолеФормыЗначение, ОписаниеПоля.НастройкиЭлемента);												
		
		Если ОписаниеПоля.Загружаемое Тогда 
			ПолеФормыЗагружаемое = ФормыУХ.СоздатьПолеФормы(Элементы,
															"Данные"+ОписаниеПоля.ИмяПоля+"Загружаемое",
															ОписаниеПоля.Заголовок,
															"ТаблицаДанных."+ОписаниеПоля.ИмяПоля+"Загружаемое",
															ВидПоляФормы.ПолеНадписи,
															НоваяГруппа,,,
															ОписаниеПоля.СобытияЭлемента);  
															
			НастроитьЭлемент(ПолеФормыЗагружаемое, ОписаниеПоля.НастройкиЭлементаЗагружаемое);												

		КонецЕсли;
		
	КонецЦикла;   
	
	
	СоздатьРеквизитыЭлементыСтатьяБюджетовИАналитики();	

КонецПроцедуры   

&НаСервере
Процедура НастроитьЭлемент(Элемент, НастройкиЭлемента)
	
	Если ТипЗнч(НастройкиЭлемента) = Тип("Структура") Тогда   
		
		НастройкиИсключения = Новый Массив;
		
		Если НастройкиЭлемента.Свойство("ГоризонтальноеПоложение") Тогда 
			Элемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента[НастройкиЭлемента.ГоризонтальноеПоложение]; 
			НастройкиИсключения.Добавить("ГоризонтальноеПоложение");
		КонецЕсли;  
		
		ЗаполнитьЗначенияСвойств(Элемент, НастройкиЭлемента,,СтрСоединить(НастройкиИсключения,","));
		
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура УстановитьСвязиПараметровВыбора(Элемент, СвязиПараметровВыбора)
	
	Если ТипЗнч(СвязиПараметровВыбора) = Тип("СписокЗначений") Тогда
	
	    МассивСвязей = Новый Массив; 
		
		Для Каждого Связь Из СвязиПараметровВыбора Цикл 
			
			ЧастиСвязи = СтрРазделить(Связь,",");
		   	МассивСвязей.Добавить(Новый СвязьПараметраВыбора(ЧастиСвязи[0], ЧастиСвязи[1]));
			
		КонецЦикла;
	 
	    НовыеСвязи = Новый ФиксированныйМассив(МассивСвязей);
		
	    Элемент.СвязиПараметровВыбора = НовыеСвязи;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьПоТипу(Элемент, СвязьПоТипу)
	
	Если ЗначениеЗаполнено(СвязьПоТипу) Тогда  
		Элемент.СвязьПоТипу = Новый СвязьПоТипу(СвязьПоТипу);	 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыЭлементыСтатьяБюджетовИАналитики()
	
	НайдСтроки = СтруктураПолейТаблицыДанных.НайтиСтроки(Новый Структура("Аналитика",Истина));
	
	Если Не НайдСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	// Статьи и их аналитики
	ПараметрыПоляВводаШапки = Новый Структура;
	ПараметрыПоляВводаШапки.Вставить("АвтоМаксимальнаяШирина",	Истина);
	ПараметрыПоляВводаШапки.Вставить("МаксимальнаяШирина",		0);

	МассивОписанийСтатей = Новый Массив;

	АналитикиСтатейБюджетовУХ.СтатьяИАналитикиТаблицыЗначенийРеквизитаФормыВТаблицеФормы(МассивОписанийСтатей,
		"ТаблицаДанных", "ТаблицаДанных",
		"СтатьяБюджета", "ДанныеСтатьяБюджета",
		"Аналитика%1", "ДанныеАналитика%1",
		ФормыУХ.РазместитьВГруппеСтрокой(Элементы.ТаблицаДанныхГруппаСтатьяИАналитики));
		
	АналитикиСтатейБюджетовУХ.СоздатьСтатьиБюджетовИАналитики(ЭтаФорма, МассивОписанийСтатей, ПараметрыПоляВводаШапки); //ПараметрыПоляВвода());

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеДанных(ДанныеТабличнойЧасти = Ложь)

	СтруктураДанных = СтруктураЗаполненныхДанных(ЭтотОбъект, ДанныеТабличнойЧасти);
	
	ВсеПоляЗаполнены = Истина; 
	НезаполненныеПоля = Новый Массив; 

	Для Каждого ЭлементСтруктуры Из СтруктураДанных Цикл  
		
		ДанныеСтроки = ЭлементСтруктуры.Значение.ДанныеСтроки;
		
		Для Каждого КлючЗначение Из ДанныеСтроки Цикл 
			ДанныеПоля = ДанныеСтроки[КлючЗначение.Ключ]; 
			Если Не ЗначениеЗаполнено(ДанныеПоля.Значение) И ДанныеПоля.Обязательное Тогда 
				ВсеПоляЗаполнены = Ложь;  
				НезаполненныеПоля.Добавить(ДанныеПоля.Заголовок);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	НезаполненныеПоля = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НезаполненныеПоля);
	
	УстановитьЦветФонаЯчеек(ЭтотОбъект);
	
	Если Не ВсеПоляЗаполнены Тогда
		ПоказатьПредупреждение(,СтрШаблон(НСтр("ru = 'Необходимо заполнить обязательные поля: %1'"),СтрСоединить(НезаполненныеПоля,",")));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ПриИзмененииНоменклатурыНаСервере(ИдентификаторСтроки)

	ТекущаяСтрока = ТаблицаДанных.НайтиПоИдентификатору(ИдентификаторСтроки);

	ИспользованиеХарактеристик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Номенклатура, "ИспользованиеХарактеристик");
	
	ТекущаяСтрока.Характеристика             = Неопределено;
	ТекущаяСтрока.ХарактеристикиИспользуются = ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	
	ПересчитатьСуммуВСтрокеТЧ(ЭтотОбъект, ИдентификаторСтроки);
	
	ПроверитьСопоставлениеДанныхСтрокиЗагрузки(ЭтотОбъект, ТекущаяСтрока);
	НастроитьВариантыОтображенияСтрок(ЭтотОбъект);

КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()

	Если Объект.ПриемникЗагрузки = "ЗаявкаНаОбеспечение" Тогда  
		УстановитьУсловноеОформление_ЗаявкаНаЗакупку();
	ИначеЕсли Объект.ПриемникЗагрузки = "ПараметрыЛимитирования" Тогда  
		УстановитьУсловноеОформление_ПараметрыЛимитирования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление_ЗаявкаНаЗакупку()
	УстановитьУсловноеОформлениеХарактеристикНоменклатуры();
	УстановитьУсловноеОформлениеЗависимыхПолей();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеТоварнаяКатегория");
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
    ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеНоменклатура");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных.ТоварнаяКатегория");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных.Номенклатура");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоРозовый);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление_ПараметрыЛимитирования()

	УстановитьУсловноеОформлениеЗависимыхПолей();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦенуПоСумме(ИдентификаторСтроки)
	
	СтруктураДанных = СтруктураЗаполненныхДанных(ЭтотОбъект);
	
	Если СтруктураДанных.Свойство("Цена") 
		И СтруктураДанных.Свойство("Количество")
		И СтруктураДанных.Свойство("Сумма") Тогда
	
		ТекущиеДанные = ТаблицаДанных.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если ТекущиеДанные.Количество <> 0 Тогда
		
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "ТоварнаяПозиция") Тогда
				Если ТипЗнч(ТекущиеДанные.ТоварнаяПозиция) <> Тип("СправочникСсылка.ТоварныеКатегории") Тогда
					ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
				КонецЕсли;
			Иначе
				Если ТекущиеДанные <> Неопределено Тогда
					ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
				КонецЕсли;
			КонецЕсли;    
		Иначе                   
			ТекущиеДанные.Цена = 0; 
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДанныеВТабличныйДокумент(СтрокаДанных)
	
	МакетЗаполненияПоВнешнемуИсточнику = Обработки.ЗагрузкаДанныхИзВнешнихФайлов.ПолучитьМакет("Макет"+Объект.ПриемникЗагрузки);
	
	ВыводПервойКолонки = Истина;
	Для Каждого ОписаниеПоля Из СтруктураПолейТаблицыДанных Цикл
		
		ОбластьДанных = МакетЗаполненияПоВнешнемуИсточнику.ПолучитьОбласть(ОписаниеПоля.ИмяПоля+"_Значение");
		ЗаполнитьЗначенияСвойств(ОбластьДанных.Параметры, СтрокаДанных);	
		
		Если ВыводПервойКолонки Тогда
			ТабличныйДокумент.Вывести(ОбластьДанных);   
			ВыводПервойКолонки = Ложь;
		Иначе
			ТабличныйДокумент.Присоединить(ОбластьДанных);
		КонецЕсли;	
	КонецЦикла;
	

КонецПроцедуры
      
&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеПоляПоИмениПоля(СтруктураПолейТаблицыДанных, ИмяПоля)
	
	НайдСтроки = СтруктураПолейТаблицыДанных.НайтиСтроки(Новый Структура("ИмяПоля",ИмяПоля));
	
	Если НайдСтроки.Количество() Тогда
		Возврат НайдСтроки[0]; 
	КонецЕсли;

КонецФункции 

&НаСервере
Процедура УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ИмяПоляВводаХарактеристики = "ДанныеХарактеристика",
																ПутьКПолюОтбора = "ТаблицаДанных.ХарактеристикиИспользуются") Экспорт
	
	Если Не ИспользоватьХарактеристикиНоменклатуры Тогда
		Возврат;
	КонецЕсли;
																
	ЭлементыФормы = ЭтаФорма.Элементы;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеФормы    = ЭлементыФормы[ИмяПоляВводаХарактеристики]; // ПолеФормы
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
																					|en = '<variants are not used>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЗависимыхПолей() Экспорт
													  
	ЭлементыФормы = ЭтаФорма.Элементы; 
	
	Для Каждого ОписаниеПоля Из СтруктураПолейТаблицыДанных Цикл
		
		Если ТипЗнч(ОписаниеПоля.Зависимости) = Тип("СписокЗначений") Тогда
			
			Зависимости = ОписаниеПоля.Зависимости;
			
			Для Каждого СтрокаСписка Из Зависимости Цикл
				
				СтруктураЗависимости = СтрокаСписка.Значение;
				
				Для Каждого Действие Из СтруктураЗависимости.Действия Цикл
					Поля = СтрРазделить(Действие.Значение,",");
					
					Если Действие.Ключ = "БлокироватьПоля" Тогда 
						
						ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
						
						Для Каждого Поле Из Поля Цикл 
							
							ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
							ПолеФормы    = ЭлементыФормы["Данные"+Поле];
							ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
							
						КонецЦикла;
						
						ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
						ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных."+ОписаниеПоля.ИмяПоля);
						ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанныхПоУсловиюДействияЗависимости(СтруктураЗависимости.Условие);						
						ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);	
		
					ИначеЕсли Действие.Ключ = "РазблокироватьПоля" Тогда
						
						ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
						
						Для Каждого Поле Из Поля Цикл 
							
							ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
							ПолеФормы    = ЭлементыФормы["Данные"+Поле];
							ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
							
						КонецЦикла;
						
						ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
						ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных."+ОписаниеПоля.ИмяПоля);
						ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанныхПоУсловиюДействияЗависимости(СтруктураЗависимости.Условие);						
						ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Ложь);	
						
					ИначеЕсли Действие.Ключ = "УстановитьПризнакОбязательногоПоляЛожь"
						Или Действие.Ключ = "УстановитьПризнакОбязательногоПоляИстина" Тогда 
						
						Если Действие.Ключ = "УстановитьПризнакОбязательногоПоляИстина" Тогда
							ЦветФона = WebЦвета.СветлоРозовый;
						Иначе
							ЦветФона = Новый Цвет;
						КонецЕсли;
						
						Для Каждого Поле Из Поля Цикл 
							ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
							
							ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
							ПолеФормы    = ЭлементыФормы["Данные"+Поле];
							ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
							
							ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
							ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных."+ОписаниеПоля.ИмяПоля);
							ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанныхПоУсловиюДействияЗависимости(СтруктураЗависимости.Условие);						
							
							ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
							ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДанных."+Поле);
							ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;						
							
							ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;

				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЦветФонаЯчеек(Форма)
	
	СтруктураДанных = СтруктураЗаполненныхДанных(Форма);
	ТабличныйДокумент = Форма.ТабличныйДокумент;
	
	Для Каждого ЭлементСтруктуры Из СтруктураДанных Цикл  
		
		ДанныеСтроки = ЭлементСтруктуры.Значение.ДанныеСтроки;
		
		Для Каждого КлючЗначение Из ДанныеСтроки Цикл 
			ДанныеПоля = ДанныеСтроки[КлючЗначение.Ключ]; 
			Если Не ЗначениеЗаполнено(ДанныеПоля.Значение) И ДанныеПоля.Обязательное Тогда 
				ТабличныйДокумент.Область(ДанныеПоля.Область).ЦветФона = WebЦвета.СветлоРозовый;	
	
			Иначе
				ТабличныйДокумент.Область(ДанныеПоля.Область).ЦветФона = Новый Цвет;	
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
           
КонецПроцедуры
     
#Область РаботаСБуферомОбмена

&НаСервере
Процедура СкопироватьСтрокиНаСервере()
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(ТаблицаДанных, Элементы.ТаблицаДанных.ВыделенныеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена()
	
	ВсеПоля = СтруктураПолейТаблицыДанных.Выгрузить().ВыгрузитьКолонку("ИмяПоля");
	
	Колонки = СтрСоединить(ВсеПоля,",");
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена(, Колонки);

	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	НомерСтроки = ТаблицаДанных.Количество();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПересчитатьСуммуВСтрокеТЧ(ЭтотОбъект, ТекущаяСтрока.ПолучитьИдентификатор());
		ТекущаяСтрока.НомерСтроки = НомерСтроки;
	КонецЦикла;

	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКомандБуфераОбмена()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ДанныеВставитьСтроки");
	МассивЭлементов.Добавить("ДанныеКонтекстноеМенюВставитьСтроки");
	
	ОбщегоНазначенияБЗККлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность",
		РаботаСТабличнымиЧастями.ЕстьСтрокиВБуфереОбмена());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандБуфераОбменаНаКлиенте()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ДанныеВставитьСтроки");
	МассивЭлементов.Добавить("ДанныеКонтекстноеМенюВставитьСтроки");
	
	ОбщегоНазначенияБЗККлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", Истина);
	
КонецПроцедуры

