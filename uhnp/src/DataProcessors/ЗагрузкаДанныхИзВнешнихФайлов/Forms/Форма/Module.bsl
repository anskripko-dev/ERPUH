		ОписаниеПоля.Вставить("ИмяПоля", "Характеристика");
		ОписаниеПоля.Вставить("Заголовок", НСтр("ru = 'Характеристика'"));
		ОписаниеПоля.Вставить("Тип",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));   
		ОписаниеПоля.Вставить("Обязательное",Ложь);   
		ОписаниеПоля.Вставить("СобытияЭлемента", СобытияЭлемента(ОписаниеПоля, Истина));   
		ОписаниеПоля.Вставить("СвязиПараметровВыбора", СвязиПараметровВыбора);   
		
		ОписаниеПоля.НастройкиЭлемента = Новый Структура;
		ОписаниеПоля.НастройкиЭлемента.Вставить("ИсторияВыбораПриВводе", ИсторияВыбораПриВводе.НеИспользовать);
		ОписаниеПоля.НастройкиЭлемента.Вставить("АвтоОтметкаНезаполненного", Истина);
		
