#Область РаботаССоставомГруппировки

&НаКлиенте
Процедура СоставГруппировкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НастройкиПолейСводнойТаблицыАдрес",НастройкиПолейСводнойТаблицыАдрес);
	СтруктураПараметров.Вставить("ВыбиратьТолькоПроизводныеПоля",Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ДобавлениеРеквизитовЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаВыбораПроизводногоПоля",СтруктураПараметров,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура СоставГруппировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если  Поле.Имя = "СоставГруппировкиАналитикаПредставление" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НастройкиПолейСводнойТаблицыАдрес",НастройкиПолейСводнойТаблицыАдрес);
		СтруктураПараметров.Вставить("ДобавлятьБазовыеПоля",Истина);
		
		Оповещение = Новый ОписаниеОповещения("ИзменениеРеквизитовЗавершение", ЭтаФорма);
		ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаВыбораПроизводногоПоля",СтруктураПараметров,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоставГруппировкиПослеУдаления(Элемент)

    ОбновитьДоступныеОтборыИСортировки();

КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	Аналитика   = ЭтаФорма["НастройкиПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("Поле,ЭтоПроизводноеПоле",Результат.ИсходноеПоле,Ложь));
	
	Если Аналитика.Количество() = 1 Тогда
		
		ДополнительныеСвойстваАналитики  = УточнитьСвойстваАналитики(Результат);
	
		НэлДерева = СоставГруппировки.Добавить();
		НэлДерева.АналитикаКод					 			 = Аналитика[0].КодПоля;
		
		ПозицияТочки = СтрНайти(Результат.ПутьКРеквизиту,".");
		
		тСтруктураАналитик	    = Новый Структура;

		Если ПозицияТочки>0 Тогда 			
			НэлДерева.АналитикаПредставление = Строка(Аналитика[0].Поле)+"."+Прав(Результат.ПутьКРеквизиту,СтрДлина(Результат.ПутьКРеквизиту)-ПозицияТочки);			
			НэлДерева.ЭтоПроизводноеПоле = Истина;
			НэлДерева.ТипПроизводногоПоляСтрока = ДополнительныеСвойстваАналитики.ТипПроизводногоПоляСтрока;
			НэлДерева.ПутьКРеквизиту = Результат.ПутьКРеквизиту;
					
		Иначе			
			НэлДерева.АналитикаПредставление = Строка(Аналитика[0].Поле);		
		КонецЕсли;			
		
		НэлДерева.ИерархияДоступна = ДополнительныеСвойстваАналитики.ИерархияДоступна;

		
	КонецЕсли;
	
	ОбновитьДоступныеОтборыИСортировки();


КонецПроцедуры

&НаКлиенте
Процедура ИзменениеРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
			
	Если Элементы.СоставГруппировки.ТекущиеДанные = Неопределено Тогда	
		Возврат;		
	Иначе	
		
		Аналитика   = ЭтаФорма["НастройкиПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("Поле,ЭтоПроизводноеПоле",Результат.ИсходноеПоле,Ложь));
		
		Если Аналитика.Количество() = 1 Тогда
			
			ДополнительныеСвойстваАналитики  = УточнитьСвойстваАналитики(Результат);
			
			НэлДерева 	= СоставГруппировки.НайтиПоИдентификатору(Элементы.СоставГруппировки.ТекущаяСтрока);
			
			НэлДерева.АналитикаКод					 			 = Аналитика[0].КодПоля;
			
			ПозицияТочки = СтрНайти(Результат.ПутьКРеквизиту,".");
			
			тСтруктураАналитик	    = Новый Структура;
			
			Если ПозицияТочки>0 Тогда 			
				НэлДерева.АналитикаПредставление = Строка(Аналитика[0].Поле)+"."+Прав(Результат.ПутьКРеквизиту,СтрДлина(Результат.ПутьКРеквизиту)-ПозицияТочки);			
				НэлДерева.ЭтоПроизводноеПоле = Истина;
				НэлДерева.ТипПроизводногоПоляСтрока = ДополнительныеСвойстваАналитики.ТипПроизводногоПоляСтрока;
				НэлДерева.ПутьКРеквизиту = Результат.ПутьКРеквизиту;

			Иначе			
				НэлДерева.АналитикаПредставление = Строка(Аналитика[0].Поле);		
				НэлДерева.ЭтоПроизводноеПоле = Ложь;
                НэлДерева.ТипПроизводногоПоляСтрока = "";
				НэлДерева.ПутьКРеквизиту = "";
				
			КонецЕсли;			
			
			НэлДерева.ИерархияДоступна = ДополнительныеСвойстваАналитики.ИерархияДоступна;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ОбновитьДоступныеОтборыИСортировки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УточнитьСвойстваАналитики(Результат)
	
	 СтруктураОтвета = Новый Структура;
	 СтруктураОтвета.Вставить("ТипПроизводногоПоляСтрока",Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(Результат.ТипЗначения));
	 СтруктураОтвета.Вставить("ИерархияДоступна",ПоддерживаетИерархию(СтруктураОтвета.ТипПроизводногоПоляСтрока));
	 
	 Возврат СтруктураОтвета;
	
КонецФункции	
	
#КонецОбласти


#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.РазделСтруктура.Видимость 		= БланкДляОтображения;  
	Элементы.РазделОтборы.Видимость 		= БланкДляОтображения;  
	Элементы.РазделШкалаПериодов.Видимость 	= БланкДляОтображения И ФлВыводаПериода;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Закрыть(ПодготовитьСтруктуруПараметров());  
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставГруппировки(НастройкиАналитикРаскрытия)
		
	ТзДоступныеАналитики = ПолучитьИзВременногоХранилища(ТзДоступныеАналитикиАдрес);
	
	Если ЗначениеЗаполнено(НастройкиИерархииСтрока) Тогда
		НастройкиИерархии = ЗначениеИзСтрокиВнутр(НастройкиИерархииСтрока);
	Иначе	
		НастройкиИерархии = Новый Структура;
	КонецЕсли;	
		
	//Таблица НастройкиПолейСводнойТаблицы нужна для совместимости вызова формы выбора аналитик группировки
	ЗаполнитьНастройкПолейСводнойТаблицы(ТзДоступныеАналитики);	
		
	Для Каждого СтрАналитика Из НастройкиАналитикРаскрытия Цикл	
					
		ДоступнаяАналитика 						= ТзДоступныеАналитики.НайтиСтроки(Новый Структура("АналитикаКод",СтрАналитика.АналитикаКод))[0];
		//ДоступнаяАналитика.АналитикаСортировка 	= СтрАналитика.АналитикаСортировка;	
		
		нСтрока = СоставГруппировки.Добавить();
		ЗаполнитьЗначенияСвойств(нСтрока,СтрАналитика);
		
		//Выведем заголовок поля
		СвойстваОсновнойАналитики = ЭтаФорма["НастройкиПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("КодПоля,ЭтоПроизводноеПоле",СтрАналитика.АналитикаКод,Ложь))[0];
		нСтрока.АналитикаПредставление = ПолучитьПредставлениеПоляАналитики(СтрАналитика,СвойстваОсновнойАналитики);

		//проверим, можно ли выводить иерархию по текущей аналитике
		Если СтрАналитика.АналитикаКод = "ПериодОтчета" Тогда	
			ФлВыводаПериода 			= Истина;
			нСтрока.ИерархияДоступна 	= Ложь;
			//по периоду иерерхия определяется в настройках итогов периодов 
		Иначе	
			нСтрока.ИерархияДоступна = ПоддерживаетИерархию(СтрАналитика.АналитикаТипСтрока);	 			
		КонецЕсли;	
			
		Если НастройкиИерархии.Свойство(СтрАналитика.АналитикаКод) Тогда			
			нСтрока.ТипИерархии 			= ТипГруппировкиКомпоновкиДанных.Иерархия;
			нСтрока.ВыводитьИерархию        = Истина;
		КонецЕсли;	
		
		//Заполним сохраненный порядок   
		Если ЗначениеЗаполнено(СтрАналитика.АналитикаСортировкаСКД) Тогда
			Для Каждого ЭлПорядка Из СтрАналитика.АналитикаСортировкаСКД.Элементы Цикл
				НовыйЭлПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));		
				ЗаполнитьЗначенияСвойств(НовыйЭлПорядка,ЭлПорядка);
			КонецЦикла;			
			
		ИначеЕсли ЗначениеЗаполнено(СтрАналитика.АналитикаСортировка) Тогда	
			
			НовыйЭлПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			НовыйЭлПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
			НовыйЭлПорядка.Поле = Новый ПолеКомпоновкиДанных(СтрАналитика.АналитикаСортировка);
			
		КонецЕсли;	
		
		
	КонецЦикла;	
		
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкПолейСводнойТаблицы(ТзДоступныеАналитики)
		
	Для Каждого СтрАналитика Из ТзДоступныеАналитики Цикл 
		
		Нстр = ЭтаФорма["НастройкиПолейСводнойТаблицы"].Добавить();
		
		Нстр.КодПоля = СтрАналитика.АналитикаКод;
		
		Если Нстр.КодПоля ="Проект"  Тогда
			
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект;
			
		ИначеЕсли Нстр.КодПоля ="Организация"   Тогда
			
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация;
			
		ИначеЕсли Нстр.КодПоля ="ПериодОтчета"   Тогда
			
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета;
			
		ИначеЕсли Нстр.КодПоля ="Сценарий"   Тогда
			
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий;
			
		Иначе			
			
			ТекущийЭлементПВХ = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Нстр.КодПоля);
			Если Не ТекущийЭлементПВХ = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка() Тогда
				 Нстр.Поле = ТекущийЭлементПВХ;
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
		
    НастройкиПолейСводнойТаблицыАдрес = ПоместитьВоВременноеХранилище(ЭтаФорма["НастройкиПолейСводнойТаблицы"].Выгрузить(),ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеГруппировки(СтруктураАналитикСтрока,НастройкиИерархииСтрока)
	
	Если ТипЗнч(СтруктураАналитикСтрока) = Тип("Строка") Тогда		
		СтруктураАналитик = ЗначениеИзСтрокиВнутр(СтруктураАналитикСтрока);
	Иначе	
		СтруктураАналитик = СтруктураАналитикСтрока;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиИерархииСтрока) Тогда
		 НастройкиИерархии = ЗначениеИзСтрокиВнутр(НастройкиИерархииСтрока);
	КонецЕсли;	
	
	ПолеПредставление = "";
	
	Для Каждого Стр Из СтруктураАналитик Цикл		
			
		ПолеИерархия      = "";
		
		Если Не НастройкиИерархии = Неопределено И НастройкиИерархии.Свойство(Стр.Ключ) Тогда
			 ПолеИерархия = "("+ТипГруппировкиКомпоновкиДанных.Иерархия+")";
		КонецЕсли;	
				
		ПолеПредставление = ПолеПредставление+Стр.Значение[0].АналитикаПредставление+ПолеИерархия+",";
				
	КонецЦикла;	

	ПолеПредставление = Лев(ПолеПредставление,СтрДлина(ПолеПредставление)-1);
	
	Возврат ПолеПредставление;
		
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеГруппировкиСервер(СтруктураАналитик)
	
	ПолеПредставление = "";
	
	Для Каждого Стр Из СтруктураАналитик Цикл		
			
		ПолеИерархия      = "";
		
		Если НЕ Стр.Значение[0].Владелец().Колонки.Найти("ИерархииАналитики") = Неопределено Тогда
			тИерархия         = Стр.Значение[0].ИерархииАналитики;
		Иначе	 
			тИерархия  = "";
		КонецЕсли;	
	
		Если ЗначениеЗаполнено(тИерархия) И НЕ тИерархия = ПредопределенноеЗначение("ТипГруппировкиКомпоновкиДанных.Элементы") Тогда
			 ПолеИерархия = "("+Строка(тИерархия)+")";
		КонецЕсли;	
		
		ПолеПредставление = ПолеПредставление+Стр.Значение[0].АналитикаПредставление+ПолеИерархия+",";
				
	КонецЦикла;	

	ПолеПредставление = Лев(ПолеПредставление,СтрДлина(ПолеПредставление)-1);
	
	Возврат ПолеПредставление;
		
КонецФункции

&НаСервере
Процедура ОбновитьДоступныеОтборыИСортировки();
	
	ТзДоступныеАналитики 			= ПолучитьИзВременногоХранилища(ТзДоступныеАналитикиАдрес);
	ВыбранныеАналитики              = Новый ТаблицаЗначений;
	ВыбранныеАналитики.Колонки.Добавить("БазовоеПоле");
	ВыбранныеАналитики.Колонки.Добавить("ПроизводноеПоле");
	
	//Заполнить таблицу состава аналитик значениями по-умолчанию
	ПолучитьПоляГруппировок(ТзДоступныеАналитики,ВыбранныеАналитики);
	
	//Если меняли состав текущей группировки - удалим лишние элементы из настроек состава аналитик
	МассивУдаляемыхОтборов = Новый Массив;
	Для Каждого СтрОтбор Из ПараметрыОтбора Цикл
		Если ВыбранныеАналитики.Найти(СтрОтбор.ПолеКод,"БазовоеПоле") = Неопределено Тогда	
			 МассивУдаляемыхОтборов.Добавить(СтрОтбор);
		КонецЕсли;	
	КонецЦикла;	
	Для Каждого СтрОтбор Из МассивУдаляемыхОтборов Цикл
		ПараметрыОтбора.Удалить(СтрОтбор);
	КонецЦикла;	
	
	//Обновить и прочитать порядок выбранных аналитик
	ПрочитатьИОбновитьПоляПорядкаСКД(ВыбранныеАналитики);
	
КонецПроцедуры

&НаСервере
Процедура  ПолучитьПоляГруппировок(ТзДоступныеАналитики,ВыбранныеАналитики)
	
	//Заполнить таблицу состава аналитик стандартными значениями
	Для Каждого Стр Из СоставГруппировки Цикл	
		
		нВыбраннаяАналитика = ВыбранныеАналитики.Добавить();
		
		Если Стр.ЭтоПроизводноеПоле Тогда 		
			нВыбраннаяАналитика.БазовоеПоле 	= Стр.АналитикаКод;
			нВыбраннаяАналитика.ПроизводноеПоле = Стр.ПутьКРеквизиту;
		Иначе	
			нВыбраннаяАналитика.БазовоеПоле 	= Стр.АналитикаКод;
			нВыбраннаяАналитика.ПроизводноеПоле = Стр.АналитикаКод;
		КонецЕсли;
		
		Если Стр.АналитикаКод = "ПериодОтчета" Тогда 
			Если ПараметрыОтбора.НайтиСтроки(Новый Структура("ПолеКод","ПериодС")).Количество() = 1 Тогда	
				нВыбраннаяАналитика.БазовоеПоле 	= "ПериодС";
				нВыбраннаяАналитика.ПроизводноеПоле = "ПериодС";
				нВыбраннаяАналитика = ВыбранныеАналитики.Добавить();
                нВыбраннаяАналитика.БазовоеПоле 	= "ПериодПо";
				нВыбраннаяАналитика.ПроизводноеПоле = "ПериодПо";	
				Продолжить;
			КонецЕсли;
		Иначе	
			Если ПараметрыОтбора.НайтиСтроки(Новый Структура("ПолеКод",Стр.АналитикаКод)).Количество() = 1 Тогда	
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		нДоступныеЭлементы = ТзДоступныеАналитики.НайтиСтроки(Новый Структура("АналитикаКод",Стр.АналитикаКод));
		
		Если нДоступныеЭлементы.Количество() = 1 Тогда
			НовыйОтбор = ПараметрыОтбора.Добавить();
			НовыйОтбор.Использовать = Истина;
			НовыйОтбор.Поле 				= нДоступныеЭлементы[0].АналитикаПредставление;
			НовыйОтбор.ПолеКод 				= нДоступныеЭлементы[0].АналитикаКод;
			ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(НовыйОтбор.ПолеКод);
			Если ЗначениеЗаполнено(ТекСубконто) Тогда
				НовыйОтбор.ПолеСсылка  = ТекСубконто;
			КонецЕсли;	
			НовыйОтбор.ТипЗначенияСтрока    = нДоступныеЭлементы[0].АналитикаТипСтрока;
			Если НовыйОтбор.ПолеКод = "Организация" Тогда
				НовыйОтбор.Отбор =  Перечисления.ВидыСравненияПоказателейОтчетов.ОрганизацияОтчета;	
				НовыйОтбор.ПорядокОтбора = 4;
			ИначеЕсли НовыйОтбор.ПолеКод = "Проект" Тогда
				НовыйОтбор.Отбор =  Перечисления.ВидыСравненияПоказателейОтчетов.ПроектОтчета;
				НовыйОтбор.ПорядокОтбора = 5;
			ИначеЕсли НовыйОтбор.ПолеКод = "Сценарий" Тогда
				НовыйОтбор.Отбор =  Перечисления.ВидыСравненияПоказателейОтчетов.СценарийОтчета;
				НовыйОтбор.ПорядокОтбора = 3;
			ИначеЕсли НовыйОтбор.ПолеКод = "ПериодОтчета" Тогда
				НовыйОтбор.ПолеКод = "ПериодС";
				НовыйОтбор.Отбор 		=  Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаОтчета;
				НовыйОтбор.Поле 		= Нстр("ru = 'Период начала отбора'");
				НовыйОтбор.ПорядокОтбора = 1;
				НовыйОтбор = ПараметрыОтбора.Добавить();
				НовыйОтбор.Использовать = Истина;
				НовыйОтбор.Поле 				= нДоступныеЭлементы[0].АналитикаПредставление;
				НовыйОтбор.ПолеКод 				= "ПериодПо";
				НовыйОтбор.Поле 				= Нстр("ru = 'Период окончания отбора'");
				НовыйОтбор.ТипЗначенияСтрока    = нДоступныеЭлементы[0].АналитикаТипСтрока;
				НовыйОтбор.Отбор 		=  Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета;
				ВыбранныеАналитики.Вставить("ПериодС");
				ВыбранныеАналитики.Вставить("ПериодПо");	
				НовыйОтбор.ПорядокОтбора = 2;
			Иначе	
				НовыйОтбор.Отбор =  Перечисления.ВидыСравненияПоказателейОтчетов.ОтборНеПроизводится;
				НовыйОтбор.ПорядокОтбора = 99;
			КонецЕсли;	
			
			НовыйОтбор.ОтборПредставление 	= НовыйОтбор.Отбор;
			НовыйОтбор.ПолеПредставление 	= НовыйОтбор.Поле;		
			
		КонецЕсли;			
		
	КонецЦикла;
	
	ВыбранныеАналитики.Свернуть("БазовоеПоле,ПроизводноеПоле");
	
КонецПроцедуры	

&НаКлиенте
Процедура ПараметрыОтбораОтборПредставлениеПриИзменении(Элемент)
	
	АналитическийБланкУХКлиент.ПараметрыОтбораОтборПриИзменении(Элемент,Элементы);

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтбораОтборПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	АналитическийБланкУХКлиент.ЗаполнитьСписокТиповОтбора(Элементы.ПараметрыОтбораОтбор.СписокВыбора,Элемент.СписокВыбора,Элементы.ПараметрыОтбора.ТекущиеДанные,Ложь,ПоддерживаетИерархию(Элементы.ПараметрыОтбора.ТекущиеДанные.ТипЗначенияСтрока));

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если  Элемент.ТекущийЭлемент.Имя  = "ПараметрыОтбораПолеПредставление" Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	АналитическийБланкУХКлиент.ПараметрыОтбораВыбор(Элементы,Элемент,СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыПриИзменении(Элемент)
	
	ОбновитьДоступныеОтборыИСортировки();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьИОбновитьПоляПорядкаСКД(ВыбранныеАналитики)
	
	МакетСкд 						= ПолучитьОбщийМакет("МакетНастройкиОтборов");	
	МакетСкд.НаборыДанных[0].Поля.Очистить();
	ТзДоступныеАналитики 			= ПолучитьИзВременногоХранилища(ТзДоступныеАналитикиАдрес);
	
	//Если уже были ранее выбраны элементы порядка - сохраним их в специальный кэш, чтобы не потерять
	Для Каждого ЭлПорядка Из КомпоновщикНастроек.Настройки.Порядок.Элементы Цикл
		НовыйЭлПорядка = КомпоновщикНастроекКэш.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));		
		ЗаполнитьЗначенияСвойств(НовыйЭлПорядка,ЭлПорядка);
	КонецЦикла;	

	КомпоновщикНастроек.Настройки.Порядок.Элементы.Очистить();
		
	Для Каждого ДоступнаяАналитика Из ТзДоступныеАналитики Цикл	
		Если ДоступнаяАналитика.АналитикаКод = "ПериодОтчета" Тогда
			 Продолжить;
		КонецЕсли;		
		Если  ВыбранныеАналитики.Найти(ДоступнаяАналитика.АналитикаКод,"БазовоеПоле") = Неопределено Тогда
			 Продолжить;
		КонецЕсли;	
		
		ИмяДляПоиска = "";
		
		АналитическийБланкУХСервер.ДобавитьОписаниеПоляСКД(ДоступнаяАналитика.АналитикаКод,ДоступнаяАналитика.АналитикаПредставление,ДоступнаяАналитика.АналитикаТипСтрока,МакетСкд);
				
	КонецЦикла;	
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(МакетСКД, УникальныйИдентификатор)));
	
	//Вернем сохраненные настройки из кэша
	КэшСохраненныхИДобавленных = Новый Структура;	
	
	Для Каждого ЭлПорядка Из КомпоновщикНастроекКэш.Настройки.Порядок.Элементы Цикл
		
		ПозицияТочки = СтрНайти(Строка(ЭлПорядка.Поле),".");
		ПолеПорядокСтрока = "";
		
		Если ПозицияТочки>0 Тогда 			
			ПолеПорядокСтрока =	Лев(Строка(ЭлПорядка.Поле),ПозицияТочки-1);			
		Иначе	
			ПолеПорядокСтрока = Строка(Строка(ЭлПорядка.Поле));
		КонецЕсли;
		
		//Период сортируется всегда по дате начала
		Если ПолеПорядокСтрока = "ПериодОтчета" Тогда
			Продолжить;
		КонецЕсли;	
		
		//Нет такого поля в группировках - не неужно добавлять в порядок.
		Если ВыбранныеАналитики.Найти(ПолеПорядокСтрока,"БазовоеПоле") = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		//Нет такого производного поля в группировках - не неужно добавлять в порядок.		
		Если ВыбранныеАналитики.Найти(ПолеПорядокСтрока,"ПроизводноеПоле") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЕстьПолеПорядка(КомпоновщикНастроек.Настройки.Порядок.Элементы,ЭлПорядка.Поле) Тогда
			НовыйЭлПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));		
			ЗаполнитьЗначенияСвойств(НовыйЭлПорядка,ЭлПорядка);			
			КэшСохраненныхИДобавленных.Вставить(ПолеПорядокСтрока);
		КонецЕсли;
		
	КонецЦикла;	
	
	//дополним сортировки новыми базовыми полями, если добавились 
	Для Каждого СтрПоле Из ВыбранныеАналитики Цикл
		
		ТекущаяАналитика = ТзДоступныеАналитики.Найти(СтрПоле.БазовоеПоле,"АналитикаКод");
		Если ТекущаяАналитика = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//Период сортируется всешда по дате начала
		Если СтрПоле.БазовоеПоле = "ПериодОтчета" Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрПоле.БазовоеПоле = СтрПоле.ПроизводноеПоле Тогда
			ПолеСортировки = Новый ПолеКомпоновкиДанных(ТекущаяАналитика.АналитикаСортировка);
		Иначе	
			//это производное поле.
			тПоле = СоставГруппировки.НайтиСтроки(Новый Структура("ПутьКРеквизиту",СтрПоле.ПроизводноеПоле))[0];
			МассивТипов = Новый Массив;
			Для Каждого СтрТип Из СтрРазделить(тПоле.ТипПроизводногоПоляСтрока,"|") Цикл
				МассивТипов.Добавить(Тип(СтрТип));
			КонецЦикла;		
			
			СвойстваАналитики = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьТипСортировкуАналитики(тПоле.ПутьКРеквизиту,Новый ОписаниеТипов(МассивТипов));
			
			ПолеСортировки = Новый ПолеКомпоновкиДанных(СвойстваАналитики.АналитикаСортировка);
			
		КонецЕсли;
		
		Если НЕ ЕстьПолеПорядка(КомпоновщикНастроек.Настройки.Порядок.Элементы,ПолеСортировки) Тогда
			Если Не ТекущаяАналитика = Неопределено Тогда
				НовыйЭлПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
				НовыйЭлПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
				НовыйЭлПорядка.Поле = ПолеСортировки;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	КомпоновщикНастроекКэш.Настройки.Порядок.Элементы.Очистить();
	
		
КонецПроцедуры	

Функция ЕстьПолеПорядка(ПоляПорядка,ПолеПорядка) 
	
	Для Каждого Поле Из ПоляПорядка Цикл
		Если Поле.Поле = ПолеПорядка Тогда
			Возврат Истина;		
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции	



&НаСервере
Функция ПодготовитьСтруктуруПараметров() 
				
	Для Каждого Стр Из ПараметрыОтбора Цикл	
		Стр.ЗначениеОтбораСтрока 		=  ЗначениеВСтрокуВнутр(Стр.ЗначениеОтбора);
		Стр.ЗначениеДляПроверкиСтрока	=  ЗначениеВСтрокуВнутр(Стр.ЗначениеДляПроверки);		
	КонецЦикла;	   
		
	НастройкиАналитикРаскрытия 			= Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыНастроекАналитик();
	РасшифровкаВыводаИерархии           = Новый Структура;
	ТаблицаНасройкиИерархии             = ЭтаФорма["НастройкиПолейСводнойТаблицы"].Выгрузить().СкопироватьКолонки("ВыводитьИерархиюЭлементов,СкрыватьЭлементыГруппы,ВыводитьДанныеСУровня,ВыводитьДанныеДоУровня");
	
	Для Каждого стрАналитики Из СоставГруппировки Цикл
		
		//Формируем структуру таблицы НастройкиАналитикРаскрытия:
		СвойстваОсновнойАналитики = ЭтаФорма["НастройкиПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("КодПоля,ЭтоПроизводноеПоле",стрАналитики.АналитикаКод,Ложь))[0];

		нСтрокаАналитикаРаскрытия = НастройкиАналитикРаскрытия.Добавить();
			
			
		нСтрокаАналитикаРаскрытия.АналитикаКод 				= стрАналитики.АналитикаКод;
		нСтрокаАналитикаРаскрытия.АналитикаПредставление 	= ПолучитьПредставлениеПоляАналитики(стрАналитики,СвойстваОсновнойАналитики,Истина);
		нСтрокаАналитикаРаскрытия.АналитикаТипСтрока 		= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(СвойстваОсновнойАналитики.Поле);
		
		//для Периода отчета нужно добавить сортировку по умолчанию
		Если стрАналитики.АналитикаКод ="ПериодОтчета" Тогда
			нСтрокаАналитикаРаскрытия.АналитикаСортировка = "ПериодОтчета.ДатаНачала";
		Иначе	
			//сортировка поля
			нСтрокаАналитикаРаскрытия.АналитикаСортировкаСКД = КомпоновщикНастроек.Настройки.Порядок;		
		КонецЕсли;
		
		//Настройки полей с точкой
		Если стрАналитики.ЭтоПроизводноеПоле Тогда		
			нСтрокаАналитикаРаскрытия.ЭтоПроизводноеПоле		= стрАналитики.ЭтоПроизводноеПоле;
			нСтрокаАналитикаРаскрытия.ПутьКРеквизиту 			= стрАналитики.ПутьКРеквизиту;
			нСтрокаАналитикаРаскрытия.ТипПроизводногоПоляСтрока = стрАналитики.ТипПроизводногоПоляСтрока;		
			нСтрокаАналитикаРаскрытия.АналитикаПредставление 	= Строка(СвойстваОсновнойАналитики.Поле);
		КонецЕсли;	
			
		//Насройка иерархии
		Если стрАналитики.ВыводитьИерархию Тогда		
              ТаблицаНасройкиИерархии.Добавить();
			  ТаблицаНасройкиИерархии[0].ВыводитьИерархиюЭлементов = Истина;			  
			  РасшифровкаВыводаИерархии.Вставить(стрАналитики.АналитикаКод,ТаблицаНасройкиИерархии);		  			  
		КонецЕсли;
		
		//Аналитика версии
		Если СвойстваОсновнойАналитики.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация 
			ИЛИ СвойстваОсновнойАналитики.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета
			ИЛИ СвойстваОсновнойАналитики.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий
			ИЛИ СвойстваОсновнойАналитики.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект ТОГДА
			
			нСтрокаАналитикаРаскрытия.ЭтоАналитикаВерсии 		= Истина;
			
		Иначе			
			нСтрокаАналитикаРаскрытия.ЭтоАналитикаВерсии 		= Ложь;
		КонецЕсли;	
				
		
	КонецЦикла;	
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ПараметрыОтбора",			ЗначениевстрокуВнутр(РеквизитформыВЗначение("ПараметрыОтбора") ));
	
	Если ФлВыводаПериода И  НастройкиПериодовСводнойТаблицы.Количество()=1 Тогда 
		Если НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогГод 
			ИЛИ НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогПолугодие 
			ИЛИ НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогКвартал 
			ИЛИ НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогМесяц
			ИЛИ НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогДекада
			ИЛИ НастройкиПериодовСводнойТаблицы[0].ВыводитьИтогНеделя  Тогда
			СтруктураОтвета.Вставить("НастройкиПериодов", 				ЗначениевстрокуВнутр(НастройкиПериодовСводнойТаблицы.Выгрузить() ));			
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета.Вставить("НастройкиАналитикРаскрытия",ЗначениевстрокуВнутр(НастройкиАналитикРаскрытия));
	
	Если РасшифровкаВыводаИерархии.Количество()>0 Тогда
		СтруктураОтвета.Вставить("НастройкиИерархии",ЗначениевстрокуВнутр(РасшифровкаВыводаИерархии));
	КонецЕсли;
	
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаСервереБезКонтекста
Функция  ПоддерживаетИерархию(ТипСтрока)
		
	МассивТиповИсходный = СтрРазделить(ТипСтрока,"|");
	
	МассивТипов = Новый Массив;
	Для Каждого СтрТип Из МассивТиповИсходный Цикл
		МассивТипов.Добавить(Тип(СтрТип));
	КонецЦикла;	
	
	Если МассивТипов.Количество() = 1 Тогда  //Для составных типов не поддерживаем
		
		Если Справочники.ТипВсеСсылки().СодержитТип(МассивТипов[0]) Тогда	  
			
			ТипСсылка =  Новый (ТипСтрока);
			Если ТипСсылка.Метаданные().Иерархический И 
				(ТипСсылка.Метаданные().ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов
				ИЛИ ТипСсылка.Метаданные().ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияЭлементов) Тогда 	 
				
				Возврат Истина			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Ложь;
		
КонецФункции

&НаСервере
Процедура ПрочитатьСоставАналитикОбласти(ТзРашифровкаОтборов)

	Для Каждого СтрОтбор Из  ТзРашифровкаОтборов Цикл	
		
		нСтр  = ПараметрыОтбора.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СтрОтбор);
		
		ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(СтрОтбор.ПолеКод);
		
		Если ЗначениеЗаполнено(ТекСубконто) Тогда
			нСтр.ПолеСсылка  = ТекСубконто;
		КонецЕсли;	
		
		нСтр.ЗначениеОтбора = ?(НЕ ЗначениеЗаполнено(СтрОтбор.ЗначениеОтбораСтрока),"",ЗначениеИзСтрокиВнутр(СтрОтбор.ЗначениеОтбораСтрока));	
		нСтр.ПолеПредставление 	= АналитическийБланкГенерацияМакетаУХСервер.ПолучитьПредставлениеПоля(СтрОтбор.Поле);
			
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьПредставлениеПоляАналитики(стрАналитики,СвойстваОсновнойАналитики,ДобавлятьСвойства = Ложь)
	
	Если стрАналитики.ЭтоПроизводноеПоле Тогда
		ПредставлениеПоля = Строка(СвойстваОсновнойАналитики.Поле)
		+СтрЗаменить(стрАналитики.ПутьКРеквизиту,стрАналитики.АналитикаКод,"");	
  	Иначе	
		ПредставлениеПоля = Строка(СвойстваОсновнойАналитики.Поле);	
	КонецЕсли;	
	
	Если ДобавлятьСвойства Тогда
		//Если стрАналитики.ВыводитьИерархию Тогда
		//	ПредставлениеПоля = ПредставлениеПоля+"("+Нстр("ru = 'Иерархия'")+")";
		//КонецЕсли;		
	КонецЕсли;
	
	Возврат ПредставлениеПоля;

КонецФункции	

&НаКлиенте
Процедура СоставГруппировкиВыводитьИерархиюПриИзменении(Элемент)

	ТекущаяСтрокаТЧ = Элементы.СоставГруппировки.ТекущиеДанные;

	Для Каждого СтрокаТЧ Из СоставГруппировки Цикл
		Если СтрокаТЧ.ПолучитьИдентификатор() <> ТекущаяСтрокаТЧ.ПолучитьИдентификатор() Тогда
			СтрокаТЧ.ВыводитьИерархию = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры


#КонецОбласти

