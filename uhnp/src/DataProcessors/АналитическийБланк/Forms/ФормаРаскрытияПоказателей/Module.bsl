		// Создаем поля оформления
		Для Каждого СтрРесурс Из  РесурыПериодыВСтроках Цикл
			
			Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(СтрРесурс.ПоказательОтчета) = Неопределено Тогда		
					
				ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
				ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВЗапросе);
				ПолеОформления.Использование = Истина;
			КонецЕсли;	
			
		КонецЦикла;
		
	Иначе
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
				
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(230,255,230));
		ЭлементУсловногоОформления.Использование = Истина;
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУсловногоОформления.Использование = Истина;
		
		// Создаем поля оформления
		Для Каждого СтрРесурс Из  РесурыПериодыВКолонках Цикл
			
			Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(СтрРесурс.ПоказательОтчета) = Неопределено Тогда		
					
				ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
				ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВЗапросе);
				ПолеОформления.Использование = Истина;
			КонецЕсли;	
			
		КонецЦикла;
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура РаскрытиеПоказателейПриАктивизацииЯчейки(Элемент)

	ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.5);
	ПодключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииЯчейкиПодключаемый", ИнтервалОжидания, Истина);
			
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизацииЯчейкиПодключаемый()
	
	Элемент = ЭтаФорма.ТекущийЭлемент;
	
	ТекстЗначениеЗаблокированоПериод = "";
	ТекстЗначениеЗаблокированоФормула = "";
	
	Если Элемент = Неопределено ИЛИ НЕ Элемент.Имя = "РаскрытиеПоказателей"
		ИЛИ Элемент.ТекущийЭлемент = Неопределено Тогда
		 Возврат;
	КонецЕсли;	
	
	//Периоды
	Если  НЕ Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка Тогда
		  Если НЕ Элемент.ТекущиеДанные = Неопределено И Элемент.ТекущиеДанные.Свойство("ПериодОтчета") Тогда
			  Если НЕ ЗаблокированныеПериоды.НайтиПоЗначению(Элемент.ТекущиеДанные.ПериодОтчета) = Неопределено Тогда
				    ТекстЗначениеЗаблокированоПериод = ТекстЗначениеЗаблокированоПериод+
					НСтр("ru = ' Период %Аналитика% заблокирован для изменения '");
				    ТекстЗначениеЗаблокированоПериод = СтрЗаменить(ТекстЗначениеЗаблокированоПериод, "%Аналитика%", Строка(Элемент.ТекущиеДанные.ПериодОтчета));
			   КонецЕсли;	   
		  КонецЕсли;
	Иначе	
          ТекущийРесурс = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ИмяВЗапросе",Элемент.ТекущийЭлемент.Имя));
		  Если ТекущийРесурс.Количество()>0 Тогда
			  
			   Если НЕ ЗаблокированныеПериоды.НайтиПоЗначению(ТекущийРесурс[0].ПериодОтчета) = Неопределено Тогда
				    ТекстЗначениеЗаблокированоПериод = ТекстЗначениеЗаблокированоПериод+
					НСтр("ru = ' Период %Аналитика% заблокирован для изменения '");
				    ТекстЗначениеЗаблокированоПериод = СтрЗаменить(ТекстЗначениеЗаблокированоПериод, "%Аналитика%", Строка(ТекущийРесурс[0].ПериодОтчета));

			   КонецЕсли;	   
				   
		  КонецЕсли;		  		
	КонецЕсли;	
	
	//Показатели
	Если  НЕ Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка Тогда
		  ТекущийРесурс = РесурыПериодыВСтроках.НайтиСтроки(Новый Структура("ИмяВЗапросе",Элемент.ТекущийЭлемент.Имя));
		  Если ТекущийРесурс.Количество()>0 Тогда
			  
			   Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(ТекущийРесурс[0].ПоказательОтчета) = Неопределено Тогда
				    ТекстЗначениеЗаблокированоФормула = ТекстЗначениеЗаблокированоФормула+
					НСтр("ru = ' Показатель %Аналитика% используется в формуле и недоступен для изменения '");
				    ТекстЗначениеЗаблокированоФормула = СтрЗаменить(ТекстЗначениеЗаблокированоФормула, "%Аналитика%", Строка(ТекущийРесурс[0].ПоказательОтчета));

			   КонецЕсли;	   
				   
		КонецЕсли;	
	Иначе	
          ТекущийРесурс = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ИмяВЗапросе",Элемент.ТекущийЭлемент.Имя));
		  Если ТекущийРесурс.Количество()>0 Тогда
			  
			   Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(ТекущийРесурс[0].ПоказательОтчета) = Неопределено Тогда
				    ТекстЗначениеЗаблокированоФормула = ТекстЗначениеЗаблокированоФормула+
					НСтр("ru = ' Показатель %Аналитика% используется в формуле и недоступен для изменения '");
				    ТекстЗначениеЗаблокированоФормула = СтрЗаменить(ТекстЗначениеЗаблокированоФормула, "%Аналитика%", Строка(ТекущийРесурс[0].ПоказательОтчета));

			   КонецЕсли;	   
				   
		  КонецЕсли;		  		
	КонецЕсли;	
	
	ДопИнформация =  ДопИнформацияФормы+ТекстЗначениеЗаблокированоПериод+" "+ТекстЗначениеЗаблокированоФормула;
		
	ОтключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииЯчейкиПодключаемый");
	
КонецПроцедуры

&НаКлиенте
Процедура ТочностьПриИзменении(Элемент)
	
	ИзменитьТочностьМасштаб(); 
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьТочностьМасштаб()
	
	РаскрываемыеАналитики = ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);
	
	РаскрытиеПоказателейТаблица =  РеквизитФормыВЗначение("РаскрытиеПоказателей");
	
	Для Каждого Кол Из РаскрытиеПоказателейТаблица.Колонки Цикл       
		Если НЕ РаскрываемыеАналитики.Свойство(Кол.Имя) Тогда 			
			 Элементы[Кол.Имя].Формат 		= УстановитьФорматКолонокПоказателей(Кол.Имя);			 
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Функция УстановитьФорматКолонокПоказателей(КолонкаИмя)
					
		
	Если  ТекущийДелитель = 1 Тогда
		КоличествоГрупп = "";
	ИначеЕсли ТекущийДелитель = 1000 Тогда
		КоличествоГрупп = "3";
	ИначеЕсли ТекущийДелитель = 1000000 Тогда
		КоличествоГрупп = "6";                 
	КонецЕсли;	
	
	ФорматнаяСтрока = "ЧДЦ="+УровеньТочности+"; ЧС="+КоличествоГрупп+"; ДЛФ=Д";
	
	Возврат ФорматнаяСтрока;
	
КонецФункции	

#Область СлужебныеПроцедурыИФункции

#Область ОбработкаФиксацииКолонок

&НаКлиенте
Процедура ОтменитьФиксациюКолонок()
	
	Для Каждого ИмяКолонки Из КолонкиФиксации Цикл
		ЭлементФормы = Элементы.Найти(ИмяКолонки);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.ФиксацияВТаблице = ФиксацияВТаблице.Нет;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ТекущаяКолонкаДляФиксации()
	
	ТекущаяКолонка = Элементы.РаскрытиеПоказателей.ТекущийЭлемент.Имя;
	
	Если КолонкиФиксации.НайтиПоЗначению(ТекущаяКолонка) = Неопределено Тогда
		Если ОтображатьПериодыВКолонках Тогда
			
			Если СтрНайти(ТекущаяКолонка, "Период_") > 0 Тогда
				ЧастиИмени = СтрРазделить(ТекущаяКолонка, "_"); // ИндексПериода
				ТекущаяКолонка = "Группа_Период" + ЧастиИмени[1];
			Иначе
				ТекущаяКолонка = Неопределено;
			КонецЕсли;
			
		Иначе
			
			Если СтрНайти(ТекущаяКолонка, "Значение") > 0 Тогда
				ТекущаяКолонка = "Группа_" + ТекущаяКолонка;
			Иначе
				ТекущаяКолонка = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	
	Возврат ТекущаяКолонка;
	
КонецФункции

&НаКлиенте
Процедура УстановитьФиксациюКолонок(ГраницаФиксации)
	
	Для Каждого ИмяКолонки Из КолонкиФиксации Цикл
		
		ЭлементФормы = Элементы.Найти(ИмяКолонки.Значение);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
		КонецЕсли;
		
		Если ИмяКолонки.Значение = ГраницаФиксации Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Функция ЗависимаяПоВалютеКолонка(Знач ИмяКолонки)
	
	ИмяЗависимойКолонки = "";
	
	Если СтрНайти(ИмяКолонки, "ЗначениеВалюта") = 0 Тогда
		ИмяЗависимойКолонки = СтрЗаменить(ИмяКолонки, "Значение", "ЗначениеВалюта");
	Иначе
		ИмяЗависимойКолонки = СтрЗаменить(ИмяКолонки, "ЗначениеВалюта", "Значение");
	КонецЕсли;
	
	Возврат ИмяЗависимойКолонки;
	
КонецФункции

#КонецОбласти

