&НаКлиенте
Процедура РаскрытиеПоказателейПриИзменении(Элемент)
			
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		 Возврат;
	КонецЕсли;		
			
	ИмяОсновнойКолонки = Неопределено;
	ИмяВалютнойКолонки = Неопределено;
	Пересчитывать      = Ложь;
	СтруктураРасшифровки = Новый Структура;
	
	ЗаполнитьСвойстваДляПересчетаВалютныхЗначений(Элемент.ТекущийЭлемент.Имя,ИмяОсновнойКолонки,ИмяВалютнойКолонки,Пересчитывать,СтруктураРасшифровки);
	Если НЕ СтруктураРасшифровки.Свойство("ПериодОтчета") Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элемент.ТекущиеДанные, "ПериодОтчета") Тогда
			СтруктураРасшифровки.Вставить("ПериодОтчета", Элемент.ТекущиеДанные.ПериодОтчета);
		КонецЕсли;
	КонецЕсли;
	
	Если  Пересчитывать Тогда		
		Попытка 
			ПересчитатьВалютноеЗначение(Элемент.ТекущийЭлемент.Имя,Элемент.ТекущаяСтрока,СтруктураРасшифровки,ИмяОсновнойКолонки,ИмяВалютнойКолонки);
		Исключение
			ОБщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = '(Возникли ошибки при пересчете валютного значения)'"));
		КонецПопытки;		
	КонецЕсли;	
			
	ОбновитьИтогиПоКолонкам();
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПрименить(Команда)
	
	Если Не ПровериьЗаполнениеОбязательных() Тогда
		Возврат;
	КонецЕсли;	
		
	ПрименитьИзменения();
	
	Если ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		УидФормыВладельца = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	Иначе	
		УидФормыВладельца = Неопределено;
	КонецЕсли;	
	
	СтруктураОтвета = Новый Структура("мПоказателиРаскрытияАдрес,логИзмененныхПоказателейАдрес,АдресТаблицыИзмененныхПоказателей,УидФормыВладельца"
	,мПоказателиРаскрытияАдрес
	,логИзмененныхПоказателейАдрес
	,АдресТаблицыИзмененныхПоказателей
	,УидФормыВладельца);
	
	Оповестить("ИзменилисьПоказатели",СтруктураОтвета);
 
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОК(Команда)
	
	Если Не ПровериьЗаполнениеОбязательных() Тогда
		Возврат;
	КонецЕсли;

	ПрименитьИзменения();
	
	СтруктураОтвета = Новый Структура("мПоказателиРаскрытияАдрес,логИзмененныхПоказателейАдрес,АдресЛогаИзмененныхПоказателей,АдресТаблицыИзмененныхПоказателей",
		мПоказателиРаскрытияАдрес,логИзмененныхПоказателейАдрес,АдресЛогаИзмененныхПоказателей,АдресТаблицыИзмененныхПоказателей);
	
	Закрыть(СтруктураОтвета);
	 
КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьКолонки(Команда)
	
	Если Элементы.РаскрытиеПоказателей.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РаскрытиеПоказателейЗафиксироватьКолонки.Пометка = НЕ Элементы.РаскрытиеПоказателейЗафиксироватьКолонки.Пометка;
	
	Если Элементы.РаскрытиеПоказателейЗафиксироватьКолонки.Пометка Тогда
		
		ГраницаФиксации = ТекущаяКолонкаДляФиксации();
		Если ГраницаФиксации = Неопределено Тогда
			ТекстСообщения = НСтр("ru='Фиксация выбранной колонки не поддерживается.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		УстановитьФиксациюКолонок(ГраницаФиксации);
		
	Иначе
		ОтменитьФиксациюКолонок();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьДанныеПоСтроке(Команда)
	
	ТекущиеДанные = Элементы.РаскрытиеПоказателей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = Элементы.РаскрытиеПоказателей.ТекущийЭлемент.Имя;
	Если СтрНайти(ИмяКолонки, "Значение") = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Копирование поддерживается только для значений.'"));
		Возврат;
	КонецЕсли;
	
	ЧастиИмени = СтрРазделить(ИмяКолонки, "_");
	ИндексТекущегоПериода = Число(ЧастиИмени[1]) - 1;
	тГоризонт = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	Если ИндексТекущегоПериода = тГоризонт.ВГраница() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='В последнем периоде копирование не выполняется.'"));
		Возврат;
	КонецЕсли;
	
	ИмяЗависимойКолонки = ЗависимаяПоВалютеКолонка(ИмяКолонки);
	ЕстьЗависимаяКолонка = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, ИмяЗависимойКолонки);
	
	ПервыйПериодКопирования = Число(ЧастиИмени[1]) + 1;
	Для Каждого ВыделеннаяСтрока Из Элементы.РаскрытиеПоказателей.ВыделенныеСтроки Цикл
		
		СтрокаТЗ = Элементы.РаскрытиеПоказателей.ДанныеСтроки(ВыделеннаяСтрока);
		ЗначниеКопирования = СтрокаТЗ[ИмяКолонки];
		Если ЕстьЗависимаяКолонка Тогда
			ЗависимоеЗначниеКопирования = СтрокаТЗ[ИмяЗависимойКолонки];
		КонецЕсли;
		
		Для Номер = ПервыйПериодКопирования По тГоризонт.Количество() Цикл
			
			ИмяКолонкиКопирования = "Период_" + Номер + "_" + ЧастиИмени[2];
			СтрокаТЗ[ИмяКолонкиКопирования] = ЗначниеКопирования;
			Если ЕстьЗависимаяКолонка Тогда
				ИмяЗависимойКолонкиКопирования = ЗависимаяПоВалютеКолонка(ИмяКолонкиКопирования);
				СтрокаТЗ[ИмяЗависимойКолонкиКопирования] = ЗависимоеЗначниеКопирования;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбновитьИтогиПоКолонкам();
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьДанныеПоКолонке(Команда)
	
	ТекущиеДанные = Элементы.РаскрытиеПоказателей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = Элементы.РаскрытиеПоказателей.ТекущийЭлемент.Имя;
	Если СтрНайти(ИмяКолонки, "Значение") = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Копирование поддерживается только для значений.'"));
		Возврат;
	КонецЕсли;
	
	Если РаскрытиеПоказателей.Индекс(ТекущиеДанные) = РаскрытиеПоказателей.Количество() - 1 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='В последней строке копирование не выполняется.'"));
		Возврат;
	КонецЕсли;
	
	ИмяЗависимойКолонки = ЗависимаяПоВалютеКолонка(ИмяКолонки);
	ЕстьЗависимаяКолонка = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, ИмяЗависимойКолонки);
	ЕстьРаскрытиеПоВалютам = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "АналитикаВалюта");
	
	Для Индекс = РаскрытиеПоказателей.Индекс(ТекущиеДанные) + 1 По РаскрытиеПоказателей.Количество() - 1 Цикл
		
		СтрокаТЗ = РаскрытиеПоказателей.Получить(Индекс);
		Если ЕстьРаскрытиеПоВалютам И (СтрокаТЗ.АналитикаВалюта <> ТекущиеДанные.АналитикаВалюта) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЗ[ИмяКолонки] = ТекущиеДанные[ИмяКолонки];
		
		Если ЕстьЗависимаяКолонка Тогда
			СтрокаТЗ[ИмяЗависимойКолонки] = ТекущиеДанные[ИмяЗависимойКолонки];
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьИтогиПоКолонкам();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ЗаполнитьСвойстваДляПересчетаВалютныхЗначений(ИмяТекущейКолонки,ИмяОсновнойКолонки,ИмяВалютнойКолонки,Пересчитывать,СтруктураРасшифровки)
		
	Если ОтображатьПериодыВКолонках Тогда
		
		ЗначениеРесурса =  РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ИмяВЗапросе",ИмяТекущейКолонки));
		Если ЗначениеРесурса.Количество() = 0 Тогда
			 Возврат;
		КонецЕсли;	
		
		СтруктураРасшифровки.Вставить("Показатель",ЗначениеРесурса[0].ПоказательОтчета);
		СтруктураРасшифровки.Вставить("ПериодОтчета",ЗначениеРесурса[0].ПериодОтчета);

		
		Если ЗначениеРесурса[0].ЗначениеВалюта Тогда   //Редактируем валютное значение;
			 
			 ИмяОсновнойКолонки = ЗначениеРесурса[0].ИмяОсновнойКолонки;
			 ИмяВалютнойКолонки = ЗначениеРесурса[0].ИмяВЗапросе;
			 Пересчитывать      = ЗначениеРесурса[0].ПересчитыватьВалютнуюСумму;
			 
		 Иначе	//Редактируем основное значение 
			 ЗначениеВалютногоРесурса =  РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ИмяОсновнойКолонки,ЗначениеВалюта",ИмяТекущейКолонки,Истина));

			 Если ЗначениеВалютногоРесурса.Количество() = 0 Тогда
				 Возврат;
			 КонецЕсли;	  
			   
			 ИмяОсновнойКолонки = ЗначениеВалютногоРесурса[0].ИмяОсновнойКолонки;
			 ИмяВалютнойКолонки = ЗначениеВалютногоРесурса[0].ИмяВЗапросе;
			 Пересчитывать      = ЗначениеВалютногоРесурса[0].ПересчитыватьВалютнуюСумму;
		 
		 КонецЕсли;	 
		
	Иначе	
		
		ЗначениеРесурса =  РесурыПериодыВСтроках.НайтиСтроки(Новый Структура("ИмяВЗапросе",ИмяТекущейКолонки));
		
		Если ЗначениеРесурса.Количество() = 0 Тогда
			 Возврат;
		КонецЕсли;		
		
		СтруктураРасшифровки.Вставить("Показатель",ЗначениеРесурса[0].ПоказательОтчета);
	
		Если ЗначениеРесурса[0].ЗначениеВалюта Тогда   //Редактируем валютное значение;
			 
			 ИмяОсновнойКолонки = ЗначениеРесурса[0].ИмяОсновнойКолонки;
			 ИмяВалютнойКолонки = ЗначениеРесурса[0].ИмяВЗапросе;
			 Пересчитывать      = ЗначениеРесурса[0].ПересчитыватьВалютнуюСумму;
			 
		 Иначе	//Редактируем основное значение 
			 ЗначениеВалютногоРесурса =  РесурыПериодыВСтроках.НайтиСтроки(Новый Структура("ИмяОсновнойКолонки,ЗначениеВалюта",ИмяТекущейКолонки,Истина));
			 
			 Если ЗначениеВалютногоРесурса.Количество() = 0 Тогда
				 Возврат;
			 КонецЕсли;	
			 
			 ИмяОсновнойКолонки = ЗначениеВалютногоРесурса[0].ИмяОсновнойКолонки;
			 ИмяВалютнойКолонки = ЗначениеВалютногоРесурса[0].ИмяВЗапросе;
			 Пересчитывать      = ЗначениеВалютногоРесурса[0].ПересчитыватьВалютнуюСумму;
			 
		 КонецЕсли;	 
			
	КонецЕсли;	

	 
КонецПроцедуры

&НаСервере
Функция ПересчитатьВалютноеЗначение(ИмяТекущейКолонки,ТекущаяСтрока,СтруктураРасшифровки,ИмяОсновнойКолонки,ИмяВалютнойКолонки)
	
	Для Каждого Стр Из СписокКолонокФильтра Цикл
		СтруктураРасшифровки.Вставить(Стр.Представление,Стр.Значение);
	КонецЦикла;	
	
	СтрокаТаблицы = РаскрытиеПоказателей.НайтиПоИдентификатору(ТекущаяСтрока);
	
	//Преобразование текущих колонок аналитик к виду (А1,А2,...).
    КэшАналитикПоказателей      		= ПолучитьИзВременногоХранилища(КэшАналитикПоказателейАдрес); 
    ГруппаПоказателя = КэшАналитикПоказателей.Найти(СтруктураРасшифровки.Показатель,"Показатель");

	Для ИндА=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл 
		Если НЕ ЗначениеЗаполнено(ГруппаПоказателя["ВидАналитики"+Строка(ИндА)+"Код"]) Тогда 
			Прервать;
		КонецЕсли;
		Если СтрокаТаблицы.Свойство(ГруппаПоказателя["ВидАналитики"+Строка(ИндА)+"Код"]) Тогда
			СтруктураРасшифровки.Вставить("Аналитика"+ИндА,СтрокаТаблицы[СокрЛП(ГруппаПоказателя["ВидАналитики"+Строка(ИндА)+"Код"])]);	
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаТаблицы.Свойство("АналитикаВалюта") Тогда
		СтруктураРасшифровки.Вставить("АналитикаВалюта",СтрокаТаблицы["АналитикаВалюта"]);	
	КонецЕсли;
	
	РасчетИЗаписьПоказателей = Обработки.РасчетИЗаписьПоказателей.Создать();
	РасчетИЗаписьПоказателей.УникальныйИдентификаторСеанса = УникальныйИдентификаторСеанса;
	
	Если ИмяТекущейКолонки = ИмяВалютнойКолонки Тогда
		//Редактируем валютное значение
		СтруктураРасшифровки.Вставить("ЗначениеВалюта",СтрокаТаблицы[ИмяВалютнойКолонки]);
		СтруктураРасшифровки.Вставить("Значение",0);
		РасчетИЗаписьПоказателей.РассчитатьЗначениеВВалюте(СтруктураРасшифровки);
		СтрокаТаблицы[ИмяОсновнойКолонки] = СтруктураРасшифровки.Значение;
	ИначеЕсли ИмяТекущейКолонки = ИмяОсновнойКолонки Тогда 	
		//Редактируем основное значение
		СтруктураРасшифровки.Вставить("ЗначениеВалюта",0);
		СтруктураРасшифровки.Вставить("Значение",СтрокаТаблицы[ИмяОсновнойКолонки]);
		РасчетИЗаписьПоказателей.РассчитатьЗначениеВВалюте(СтруктураРасшифровки);
		СтрокаТаблицы[ИмяВалютнойКолонки] = СтруктураРасшифровки.ЗначениеВалюта;
	Иначе	
		 //Редактируем аналитику.	
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ОбновитьНадписьФильтраПоАналитике(Отбор)
	
	ТекстУстановленногоФильтра = "";
	РеквизитыОтборыКДобавлению 		= Новый Массив;	
	
	Если НЕ Отбор = Неопределено Тогда			
		Для каждого Стр из Отбор Цикл		
			
			ЗаголовокПоля = "";
			
			Если Стр.Ключ = "УидГруппыОтборов" ИЛИ Стр.Ключ = "УИДГруппыОтборов" ИЛИ  Стр.Ключ = "ВидОтчета" Тогда
				 Продолжить;
			ИначеЕсли Стр.Ключ = "ПериодОтчета" Тогда	 
				 ЗаголовокПоля = "Период";
			ИначеЕсли Стр.Ключ = "ПоказательОтчета" Тогда	 
				 ЗаголовокПоля = "Показатель";
	        ИначеЕсли Стр.Ключ = "Сценарий" Тогда	 
				 ЗаголовокПоля = "Сценарий";
            ИначеЕсли Стр.Ключ = "Организация" Тогда	 
				 ЗаголовокПоля = "Организация";
            ИначеЕсли Стр.Ключ = "Проект" Тогда	 
				 ЗаголовокПоля = "Проект";
            Иначе
				Если ЗначениеЗаполнено(Стр.Значение) И НЕ ТипЗнч(Стр.Значение) = Тип("Массив") Тогда 
					ЗаголовокПоля =Стр.Значение.Метаданные().Синоним;
				КонецЕсли;
			КонецЕсли;	
			
			Если ТипЗнч(Стр.Значение) = Тип("Массив") Тогда
				Если Стр.Ключ = "ПоказательОтчета"  И Стр.Значение.Количество() =  1 Тогда
					//СписокКолонок.Добавить(Стр.Значение[0],"ПоказательОтчета");	
					//СписокКолонок.Добавить(Стр.Значение[0].ТипЗначения,"ПоказательТипЗначения");	
					СписокКолонокФильтра.Добавить(Стр.Значение[0],Стр.Ключ);
				КонецЕсли;		
				Продолжить;
			КонецЕсли;	
			
			
			ТекстУстановленногоФильтра = ТекстУстановленногоФильтра + ?(ТекстУстановленногоФильтра = "", "", " | ")
			+ ЗаголовокПоля + "=" + Стр.Значение;
			//СписокКолонок.Добавить(Стр.Значение,Стр.Ключ);
			СписокКолонокФильтра.Добавить(Стр.Значение,Стр.Ключ);
		КонецЦикла;		
	КонецЕсли;		
		
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок+": "+ ТекстУстановленногоФильтра;
	
КонецПроцедуры	

&НаКлиенте
Процедура Отсортировать(Направление)
	
	ВыделеннаяСтрока = Элементы.РаскрытиеПоказателей.ТекущийЭлемент;
	
	Если Не ВыделеннаяСтрока = Неопределено Тогда		
		РаскрытиеПоказателей.Сортировать(ВыделеннаяСтрока.Имя + Направление);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура ПрименитьИзменения()
		
	логИзмененныхПоказателейё	= ПолучитьИзВременногоХранилища(логИзмененныхПоказателейАдрес);
	ОтбираемыеАналитики			= ПолучитьИзВременногоХранилища(АдресСтруктураОтбираемыхАналитик);
	КэшАналитикПоказателей		= ПолучитьИзВременногоХранилища(КэшАналитикПоказателейАдрес);
		
	//Исходная таблица, на момент открытия формы
	мПоказателиРаскрытияЭталон = ПолучитьИзВременногоХранилища(АдресТзРаскрытия);
	
	//Текущая таблица на форме
	Если Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка Тогда
		//Периоды на форме в колонках
		мПоказателиРаскрытияТекущие = ТранспонироватьТаблицуРаскрытияПоказателиПериодыВСтроки();
	Иначе
		//Периоды на форме в строках, показатели в колонках
		мПоказателиРаскрытияТекущие = ПреобразоватьТаблицуТекущихПоказателей();
	КонецЕсли;
		
	//Получим таблицы для записи изменений
	ТаблицыДляЗаписи = ПолучитьТаблицыДляЗаписиИзмененныхПоказателей(мПоказателиРаскрытияЭталон,мПоказателиРаскрытияТекущие);
	
	РезультатИзмененныеНечисловые = ТаблицыДляЗаписи.РезультатИзмененныеНечисловые;
	РезультатИзмененныеЧисловые = ТаблицыДляЗаписи.РезультатИзмененныеЧисловые;
	
	//Подготовым запись в логи показателей.
	ТаблицаИзмененныхПоказателей		= УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	АдресТаблицыИзмененныхПоказателей	= ПоместитьВоВременноеХранилище(ТаблицаИзмененныхПоказателей,АдресФормыВладельца);
	
	Если РезультатИзмененныеНечисловые.Количество() +  РезультатИзмененныеЧисловые.Количество() = 0 Тогда
		 Возврат;
	КонецЕсли;
		
	СтруктураРасшифровки = Новый Структура;
	СтруктураРасшифровки.Вставить("ПоказательКод");
	Для Каждого Стр Из СписокКолонок Цикл 
		Если НЕ РезультатИзмененныеЧисловые.Колонки.Найти(Стр.Представление) = Неопределено Тогда
			СтруктураРасшифровки.Вставить(Стр.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ОтбираемыеАналитики Цикл
		
		Если Стр.Ключ = "ВидОтчета"
			ИЛИ Стр.Ключ = "УидГруппыОтборов"
			ИЛИ Стр.Ключ = "ПоказательОтчета" Тогда 
			Продолжить;
		КонецЕсли;

		СтруктураРасшифровки.Вставить(Стр.Ключ,Стр.Значение);
	
	КонецЦикла;
	
	СтруктураРасшифровки.Вставить("НеМасштабируется",Истина);
	СтруктураРасшифровки.Вставить("ПоказательТипЗначения");
	
	ФлНезаблокированныхЯчеек = Ложь;
	Если ЗначениеЗАполнено(АдресСтруктураКлючевыхРеквизитов) Тогда
		СтруктураКлючевыхРеквизитов = ПолучитьИзВременногоХранилища(АдресСтруктураКлючевыхРеквизитов);
	Иначе	
		СтруктураКлючевыхРеквизитов = Неопределено;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КэшАналитикПоказателей",КэшАналитикПоказателей);
	СтруктураПараметров.Вставить("НомерТранзакции",НомерТранзакции);
	СтруктураПараметров.Вставить("ТаблицаИзмененныхПоказателей",ТаблицаИзмененныхПоказателей);
	СтруктураПараметров.Вставить("ФлОшибки",Ложь);
	
	СтруктураРасшифровки.Вставить("ПравилоОбработки", ПравилоОбработки);
	СтруктураРасшифровки.Вставить("ИспользуемаяИБ", ВИБ);
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	
	// Пишем числовые показатели
	Для Каждого иСтрока Из РезультатИзмененныеЧисловые Цикл
		
		Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(иСтрока.ПоказательОтчета) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураРасшифровки,иСтрока);
		СтруктураРасшифровки.Вставить("ПоказательСсылка",иСтрока.ПоказательОтчета);
		
		СтруктураПараметров.Вставить("ЗначениеНовое",иСтрока.ЗначениеТекущее);
		СтруктураПараметров.Вставить("ЗначениеСтарое",иСтрока.ЗначениеЭталон);
		СтруктураПараметров.Вставить("СтруктураРасшифровки",СтруктураРасшифровки);
		
		ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметров);
		
	КонецЦикла;
	
	// Пишем нечисловые показатели
	Для Каждого иСтрока Из РезультатИзмененныеНеЧисловые Цикл
		
		Если НЕ ЗаблокированныеПоказатели.НайтиПоЗначению(иСтрока.ПоказательОтчета) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураРасшифровки,иСтрока);
		СтруктураРасшифровки.Вставить("ПоказательСсылка", иСтрока.ПоказательОтчета);
		
		СтруктураПараметров.Вставить("ЗначениеНовое", иСтрока.ЗначениеНеЧисловоеТекущее);
		СтруктураПараметров.Вставить("ЗначениеСтарое", иСтрока.ЗначениеНеЧисловоеЭталон);
		СтруктураПараметров.Вставить("СтруктураРасшифровки", СтруктураРасшифровки);
		
		ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметров);
		
	КонецЦикла;
	
	АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(ТаблицаИзмененныхПоказателей, АдресФормыВладельца);
	АдресТзРаскрытия = ПоместитьВоВременноеХранилище(мПоказателиРаскрытияТекущие, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере 
Функция ПолучитьТаблицыДляЗаписиИзмененныхПоказателей(мПоказателиРаскрытияЭталон,мПоказателиРаскрытияТекущие)
			
	//Разобъем показатели по типам значений.
	ТзРесурсы = РеквизитФормывЗначение("РесурыПериодыВСтроках");
	ТзРесурсы.Свернуть("ПоказательОтчета,ТипЗначенияПоказателя");
	
	ЧисловыеПоказатели = Новый Массив;
	НеЧисловыеПоказатели = Новый Массив;
	
	ТипЧисло = Перечисления.ТипыЗначенийПоказателейОтчетов.Число;
	Для Каждого СтрРесурс Из ТзРесурсы Цикл
		
		Если СтрРесурс.ТипЗначенияПоказателя = ТипЧисло Тогда
			ЧисловыеПоказатели.Добавить(СтрРесурс.ПоказательОтчета);
		Иначе
			 НеЧисловыеПоказатели.Добавить(СтрРесурс.ПоказательОтчета);
		КонецЕсли;
		
	КонецЦикла;

	СтрокаВыбираемыхПолейВсе = "";
	СтрокаПолейГруппировки = "";
	ТекстСоединенияНечисловые = "";

	СписокКолонокДополненный = Новый СписокЗначений;
	Для Каждого Кол Из мПоказателиРаскрытияТекущие.Колонки Цикл
		СписокКолонокДополненный.Добавить(Неопределено,Кол.Имя);
	КонецЦикла;
	
	//Формируем текст запроса с отличиями таблицы исходной и таблицы текущей.
	Для Каждого Кол Из СписокКолонокДополненный Цикл
		
		Если мПоказателиРаскрытияЭталон.Колонки.Найти(Кол.Представление) = Неопределено  Тогда
			Продолжить;
		КонецЕсли;
			
		СтрокаВыбираемыхПолейВсе = СтрокаВыбираемыхПолейВсе+"
		|	мПоказателиРаскрытия."+Кол.Представление+",";
		
		Если Кол.Представление = "Значение" 
			ИЛИ Кол.Представление = "ЗначениеВалюта"
			ИЛИ Кол.Представление = "ЗначениеНечисловое" Тогда
			Продолжить;
		Иначе
			СтрокаПолейГруппировки = СтрокаПолейГруппировки + "
			|	мПоказателиРаскрытия." + Кол.Представление + ",";
			ТекстСоединенияНечисловые = ТекстСоединенияНечисловые + "
			|		И мПоказателиРаскрытия." + Кол.Представление + " = МаксимальныйНомерСтрокиНечисловые." + Кол.Представление;
		КонецЕсли;
			
	КонецЦикла;
	
	СтрокаВыбираемыхПолейВсе = Лев(СтрокаВыбираемыхПолейВсе, СтрДлина(СтрокаВыбираемыхПолейВсе)-1);
	СтрокаПолейГруппировки = Лев(СтрокаПолейГруппировки, СтрДлина(СтрокаПолейГруппировки)-1);
	
	Запрос = Новый Запрос;
	
	// Поместим таблицу текущих значений и таблицу исходных значений в пакет
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&СтрокаВыбираемыхПолей
		|ПОМЕСТИТЬ мПоказателиРаскрытияЭталон
		|ИЗ
		|	&мПоказателиРаскрытияЭталон КАК мПоказателиРаскрытия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
		|	&СтрокаВыбираемыхПолей
		|ПОМЕСТИТЬ мПоказателиРаскрытияТекущие
		|ИЗ
		|	&мПоказателиРаскрытияТекущие КАК мПоказателиРаскрытия";
	
	// Разобъем таблицы по числовым и нечисловым показателям отдельно
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	МАКСИМУМ(мПоказателиРаскрытия.НомерСтроки) КАК НомерСтроки,
		|	&СтрокаПолейГруппы
		|ПОМЕСТИТЬ втМаксимальныйНомерСтрокиНечисловые
		|ИЗ
		|	мПоказателиРаскрытияТекущие КАК мПоказателиРаскрытия
		|ГДЕ
		|	мПоказателиРаскрытия.ПоказательОтчета В(&НеЧисловыеПоказатели)
		|
		|СГРУППИРОВАТЬ ПО
		|	&СтрокаПолейГруппы
		|;
		|
		|///////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО КАК ЗначениеНеЧисловоеЭталон,
		|	мПоказателиРаскрытия.ЗначениеНеЧисловое КАК ЗначениеНеЧисловоеТекущее,
		|	&СтрокаПолейГруппы
		|ПОМЕСТИТЬ мПоказателиРаскрытияНечисловые
		|ИЗ
		|	мПоказателиРаскрытияТекущие КАК мПоказателиРаскрытия
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерСтрокиНечисловые КАК МаксимальныйНомерСтрокиНечисловые
		|		ПО мПоказателиРаскрытия.НомерСтроки = МаксимальныйНомерСтрокиНечисловые.НомерСтроки 
		|		И &ТекстСоединенияНечисловые
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	мПоказателиРаскрытия.ЗначениеНеЧисловое,
		|	НЕОПРЕДЕЛЕНО,
		|	&СтрокаПолейГруппы
		|ИЗ
		|	мПоказателиРаскрытияЭталон КАК мПоказателиРаскрытия
		|ГДЕ
		|	мПоказателиРаскрытия.ПоказательОтчета В(&НеЧисловыеПоказатели)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	0 КАК ЗначениеЭталон,
		|	0 КАК ЗначениеВалютаЭталон,
		|	СУММА(ВЫРАЗИТЬ(мПоказателиРаскрытия.Значение КАК ЧИСЛО(18, 5))) КАК ЗначениеТекущее,
		|	СУММА(ВЫРАЗИТЬ(мПоказателиРаскрытия.ЗначениеВалюта КАК ЧИСЛО(18, 5))) КАК ЗначениеВалютаТекущее,
		|	&СтрокаПолейГруппы
		|ПОМЕСТИТЬ мПоказателиРаскрытияЧисловые
		|ИЗ
		|	мПоказателиРаскрытияТекущие КАК мПоказателиРаскрытия
		|ГДЕ
		|	мПоказателиРаскрытия.ПоказательОтчета В(&ЧисловыеПоказатели)
		|
		|СГРУППИРОВАТЬ ПО
		|	&СтрокаПолейГруппы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	мПоказателиРаскрытия.Значение,
		|	мПоказателиРаскрытия.ЗначениеВалюта,
		|	0,
		|	0,
		|	&СтрокаПолейГруппы
		|ИЗ
		|	мПоказателиРаскрытияЭталон КАК мПоказателиРаскрытия
		|ГДЕ
		|	мПоказателиРаскрытия.ПоказательОтчета В(&ЧисловыеПоказатели)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(мПоказателиРаскрытия.ЗначениеНеЧисловоеЭталон) КАК ЗначениеНеЧисловоеЭталон,
		|	МАКСИМУМ(мПоказателиРаскрытия.ЗначениеНеЧисловоеТекущее) КАК ЗначениеНеЧисловоеТекущее,
		|	&СтрокаПолейГруппы
		|ПОМЕСТИТЬ мПоказателиРаскрытияНечисловые_
		|ИЗ
		|	мПоказателиРаскрытияНечисловые КАК мПоказателиРаскрытия
		|
		|СГРУППИРОВАТЬ ПО
		|	&СтрокаПолейГруппы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(мПоказателиРаскрытия.ЗначениеЭталон) КАК ЗначениеЭталон,
		|	СУММА(мПоказателиРаскрытия.ЗначениеВалютаЭталон) КАК ЗначениеВалютаЭталон,
		|	СУММА(мПоказателиРаскрытия.ЗначениеТекущее) КАК ЗначениеТекущее,
		|	СУММА(мПоказателиРаскрытия.ЗначениеВалютаТекущее) КАК ЗначениеВалютаТекущее,
		|	&СтрокаПолейГруппы
		|ПОМЕСТИТЬ мПоказателиРаскрытияЧисловые_
		|ИЗ
		|	мПоказателиРаскрытияЧисловые КАК мПоказателиРаскрытия
		|
		|СГРУППИРОВАТЬ ПО
		|	&СтрокаПолейГруппы";
	
	// Оставим только дельты
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	мПоказателиРаскрытия.ЗначениеНеЧисловоеЭталон КАК ЗначениеНеЧисловоеЭталон,
		|	мПоказателиРаскрытия.ЗначениеНеЧисловоеТекущее КАК ЗначениеНеЧисловоеТекущее,
		|	ВЫРАЗИТЬ(мПоказателиРаскрытия.ПоказательОтчета КАК Справочник.ПоказателиОтчетов).ТипЗначения КАК ПоказательТипЗначения,
		|	ВЫРАЗИТЬ(мПоказателиРаскрытия.ПоказательОтчета КАК Справочник.ПоказателиОтчетов).НормализованныйКод КАК ПоказательКод,
		|	&СтрокаПолейГруппы
		|ИЗ
		|	мПоказателиРаскрытияНечисловые_ КАК мПоказателиРаскрытия 
		|ГДЕ
		|	НЕ мПоказателиРаскрытия.ЗначениеНеЧисловоеЭталон = мПоказателиРаскрытия.ЗначениеНеЧисловоеТекущее
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	мПоказателиРаскрытия.ЗначениеЭталон КАК ЗначениеЭталон,
		|	мПоказателиРаскрытия.ЗначениеВалютаЭталон КАК ЗначениеВалютаЭталон,
		|	мПоказателиРаскрытия.ЗначениеТекущее КАК ЗначениеТекущее,
		|	мПоказателиРаскрытия.ЗначениеВалютаТекущее КАК ЗначениеВалютаТекущее,
		|	ВЫРАЗИТЬ(мПоказателиРаскрытия.ПоказательОтчета КАК Справочник.ПоказателиОтчетов).ТипЗначения КАК ПоказательТипЗначения,
		|	ВЫРАЗИТЬ(мПоказателиРаскрытия.ПоказательОтчета КАК Справочник.ПоказателиОтчетов).НормализованныйКод КАК ПоказательКод,
		|	&СтрокаПолейГруппы
		|ИЗ
		|	мПоказателиРаскрытияЧисловые_ КАК мПоказателиРаскрытия
		|ГДЕ
		|	НЕ мПоказателиРаскрытия.ЗначениеЭталон = мПоказателиРаскрытия.ЗначениеТекущее";
	
	Запрос.УстановитьПараметр("мПоказателиРаскрытияЭталон", мПоказателиРаскрытияЭталон);
	Запрос.УстановитьПараметр("мПоказателиРаскрытияТекущие", мПоказателиРаскрытияТекущие);
	Запрос.УстановитьПараметр("ЧисловыеПоказатели", ЧисловыеПоказатели);
	Запрос.УстановитьПараметр("НеЧисловыеПоказатели", НеЧисловыеПоказатели);
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтрокаВыбираемыхПолей", СтрокаВыбираемыхПолейВсе);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтрокаПолейГруппы", СтрокаПолейГруппировки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ТекстСоединенияНечисловые", ТекстСоединенияНечисловые);
	
	Результат = Запрос.ВыполнитьПакет();
	
	РезультатИзмененныеНечисловые = Результат[7].Выгрузить();
	РезультатИзмененныеЧисловые = Результат[8].Выгрузить();
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("РезультатИзмененныеНечисловые", РезультатИзмененныеНечисловые);
	СтруктураОтвета.Вставить("РезультатИзмененныеЧисловые", РезультатИзмененныеЧисловые);
	
	Возврат СтруктураОтвета;

КонецФункции

&НаКлиенте
Процедура РаскрытиеПоказателейПослеУдаления(Элемент)
	
	ОбновитьИтогиПоКолонкам();

КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьВалютныеСуммы(Команда)
	
	Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка = НЕ Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка;	
	
	Если  НЕ Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка Тогда
		Для Каждого СтрРесурс Из РесурыПериодыВСтроках Цикл
			Если СтрРесурс.ЗначениеВалюта Тогда
				ЭтаФорма.Элементы[СтрРесурс.ИмяВЗапросе].Видимость = Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка;	
			КонецЕсли;			
		КонецЦикла;	
	Иначе	
		Для Каждого СтрРесурс Из РесурыПериодыВКолонках Цикл
			Если СтрРесурс.ЗначениеВалюта Тогда
				ЭтаФорма.Элементы[СтрРесурс.ИмяВЗапросе].Видимость = Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка;	
			КонецЕсли;			
		КонецЦикла;	
		
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура СоздатьОграничениеПоПериодам(тГоризонт)
	
	МассивЗнченийПараметров  = Новый ФиксированныйМассив(тГоризонт);
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", МассивЗнченийПараметров);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	Элементы.ПериодОтчета.ПараметрыВыбора = НовыеПараметры;	
		
КонецПроцедуры

