

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	АдресТзРаскрытия       				= Параметры.АдресТзРаскрытия;
	АдресЛогаИзмененныхПоказателей      = Параметры.АдресЛогаИзмененныхПоказателей;
	АдресТаблицыСвойствАналитик      	= Параметры.АдресТаблицыСвойствАналитик;
	АдресСтруктураКлючевыхРеквизитов    = Параметры.АдресСтруктураКлючевыхРеквизитов;
	АдресСтруктураНезаполненныхАналитик = ПоместитьВоВременноеХранилище(Параметры.СтруктураНезаполненныхАналитик,ЭтаФорма.УникальныйИдентификатор);
	АдресСтруктураОтбираемыхАналитик    = ПоместитьВоВременноеХранилище(Параметры.СтруктураОтбираемыхАналитик,ЭтаФорма.УникальныйИдентификатор);
	АдресТекущегоГоризонта              = ПоместитьВоВременноеХранилище(Параметры.тГоризонт,ЭтаФорма.УникальныйИдентификатор);
	АдресТекущегоОбъекта                = ПоместитьВоВременноеХранилище(Параметры.тОбъект,ЭтаФорма.УникальныйИдентификатор);
	УникальныйИдентификаторСеанса		= Параметры.УникальныйИдентификаторСеанса;
	
	РежимРасшифровки                    = Параметры.РежимРасшифровки;
	КлючРасшифровки                     = Параметры.КлючРасшифровки;
	
	ТекущийДелитель                     = Параметры.ТекущийДелитель;
	УровеньТочности                     = Параметры.УровеньТочности;
	
	Заблокирован                        = Параметры.Заблокирован;
	
	ПравилоОбработки                    = Параметры.ПравилоОбработки;
	ВИБ                                 = Параметры.ВИБ;
	
	Если ТипЗнч(Параметры.ЗаблокированныеПериоды) = Тип("Массив") Тогда
		 ЗаблокированныеПериоды.ЗагрузитьЗначения(Параметры.ЗаблокированныеПериоды);
	КонецЕсли;
	Если ТипЗнч(Параметры.ЗаблокированныеПоказатели) = Тип("Массив") Тогда
		 ЗаблокированныеПоказатели.ЗагрузитьЗначения(Параметры.ЗаблокированныеПоказатели);
	КонецЕсли;
	
	РежимРаботыСНесколькимиПоказателями = Истина;
	
	Если ЗначениеЗАполнено(Параметры.АдресРесурсыПериодыВСтроках) Тогда //Пришла готовая таблица с показателями и их свойствами
		РесурсыПериодыВстрокахТаблица       = ПолучитьИзВременногоХранилища(Параметры.АдресРесурсыПериодыВСтроках);
		Для Каждого Стр Из РесурсыПериодыВстрокахТаблица Цикл
			Нстр = РесурыПериодыВСтроках.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
		КонецЦикла;	
	Иначе	
		//Работаем с одним показателем.
		//Таблицу РесурыПериодыВСтроках заполним сами
		РежимТолькоПросмотр = Параметры.СтруктураЗаблокированныхПоказателей.Заблокирован ИЛИ Параметры.РежимТолькоЧтение;
		
		Показатель 							= Параметры.СтруктураОтбираемыхАналитик.ПоказательОтчета[0];
		Ссылка 								= Параметры.Ссылка;
		ТипЗначениеПоказателя 				= Показатель.ТипЗначения;
		
		Нстр = РесурыПериодыВСтроках.Добавить();
		Нстр.ПоказательОтчета  			= Показатель;
		Нстр.РежимТолькоПросмотр      	= РежимТолькоПросмотр;
		Нстр.ТипЗначенияПоказателя      = ТипЗначениеПоказателя;
		Нстр.ИмяВЗапросе       			= "Значение1";
		Нстр.ИмяОсновнойКолонки         = "Значение1";
		
		//Есть валютное раскрытие	
		Нстр = РесурыПериодыВСтроках.Добавить();
		Нстр.ПоказательОтчета  			= Показатель;
		Нстр.РежимТолькоПросмотр      	= РежимТолькоПросмотр;
		Нстр.ТипЗначенияПоказателя      = ТипЗначениеПоказателя;
		Нстр.ИмяВЗапросе       			= "ЗначениеВалюта1";
		Нстр.ЗначениеВалюта    			= Истина;
		Нстр.ПересчитыватьВалютнуюСумму = Показатель.ПересчитыватьВалютнуюСумму;
		Нстр.ИмяОсновнойКолонки         = "Значение1";
		
		Если Параметры.СтруктураЗаблокированныхПоказателей.Заблокирован ИЛИ Параметры.РежимТолькоЧтение Тогда
			
			СтрокаШаблона = Нстр("ru = '%1 (только просмотр)'");
			
			Если Не ПустаяСтрока(СтрокаШаблона) тогда				
				ЭтаФорма.Заголовок = СтрШаблон(СтрокаШаблона, ЭтаФорма.Заголовок);
			КонецЕсли;
			
			Элементы.РаскрытиеПоказателей.ТолькоПросмотр = Истина;
			Элементы.ФормаКнопкаОК.Доступность = Ложь;
			Элементы.ФормаКнопкаПрименить.Доступность = Ложь;
			Элементы.Редактирование.Пометка = Ложь;
			Элементы.Редактирование.Видимость = Ложь;
			ДопИнформацияФормы  = Параметры.СтруктураЗаблокированныхПоказателей.Пояснение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТзРаскрытияПоказателей 				= ПолучитьИзВременногоХранилища(Параметры.АдресТзРаскрытия);	
	РежимЗаписиВлог                     = Параметры.РежимЗаписиВлог;
	
	//Выведем кнопку работы с доп.валютами, если они есть.	
	ПересчитыватьВалютнуюСумму = Ложь;
	Для Каждого СтрРесурс Из РесурыПериодыВСтроках Цикл
		Если СтрРесурс.ПересчитыватьВалютнуюСумму Тогда
			ПересчитыватьВалютнуюСумму	= Истина;	
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Если  Параметры.СтруктураНезаполненныхАналитик.Свойство("АналитикаВалюта") И ПересчитыватьВалютнуюСумму Тогда
		Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Видимость = Истина;
		Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка = Истина;
	КонецЕсли;
	
	//Если нет периода в раскрытии, то нечего транспонировать.
	Если НЕ Параметры.СтруктураНезаполненныхАналитик.Свойство("ПериодОтчета") Тогда
		 Элементы.РаскрытиеПоказателейПериодыВКолонках.Доступность = Ложь;
		 ОтображатьПериодыВКолонках = Ложь;
	КонецЕсли;
	
	ОтобразитьТаблицуПериодыВстроках();
	
	ОбновитьНадписьФильтраПоАналитике(Параметры.СтруктураОтбираемыхАналитик);
	
	логИзмененныхПоказателейАдрес 		= Параметры.логИзмененныхПоказателейАдрес;
	мПоказателиРаскрытияАдрес		 	= Параметры.мПоказателиРаскрытияАдрес;
	КэшАналитикПоказателейАдрес         = Параметры.КэшАналитикПоказателейАдрес;
	ЕдиницаИзмерения                    = Параметры.ЕдиницаИзмерения;
	УровеньТочности                     = Параметры.УровеньТочности;
	
	Если ЗначениеЗаполнено(логИзмененныхПоказателейАдрес) Тогда
		логИзмененныхПоказателейАдрес 		= Параметры.логИзмененныхПоказателейАдрес 				
	Иначе	
		логИзмененныхПоказателей 			= Обработки.ЗаписьПоказателяСРасчетомЗависимых.Создать().ТаблицаИзмененныхПоказателей.ВыгрузитьКолонки();		
		логИзмененныхПоказателей.Индексы.Добавить("Сценарий,ПериодОтчета,Организация,Проект,ПоказательОтчета,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
		логИзмененныхПоказателейАдрес		= ПоместитьВоВременноеХранилище(логИзмененныхПоказателей,Новый УникальныйИдентификатор);
	КонецЕсли;

	Если Параметры.Свойство("ДополнительныйОтбор") Тогда	
		Для Каждого СтрФильтр Из Параметры.ДополнительныйОтбор Цикл
			ТекЭлемент 		= СтрФильтр.Ключ;
			ТекЗначение     = СтрФильтр.Значение;
			ФлОтбора = Ложь;
			Для Каждого СтОтбор Из СписокОтборов Цикл
				Если СтОтбор.Представление = ТекЭлемент Тогда
					СтОтбор.Значение = ТекЗначение;
					ФлОтбора = Истина;
					Прервать;
				КонецЕсли;		
			КонецЦикла; 
			
			Если Не ФлОтбора Тогда
				СтОтбор = СписокОтборов.Добавить();             
				СтОтбор.Представление 		= ТекЭлемент;
				СтОтбор.Значение		 	= ТекЗначение;
			КонецЕсли;	
						
		КонецЦикла;			
	КонецЕсли;	

	Если НЕ Заблокирован Тогда
		
		СтрокаШаблона = Нстр("ru = '%1 (только просмотр)'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда				
			ЭтаФорма.Заголовок = СтрШаблон(СтрокаШаблона, ЭтаФорма.Заголовок);
		КонецЕсли;
		
		Элементы.РаскрытиеПоказателей.ТолькоПросмотр = Истина;
		Элементы.ФормаКнопкаОК.Доступность = Ложь;
		Элементы.ФормаКнопкаПрименить.Доступность = Ложь;
		Элементы.Редактирование.Пометка = Ложь;
		Элементы.РаскрытиеПоказателейСкопироватьДанныеПоСтроке.Доступность = Ложь;
		Элементы.РаскрытиеПоказателейСкопироватьДанныеПоКолонке.Доступность = Ложь;
	Иначе	
		Элементы.Редактирование.Пометка = Истина;
		Элементы.Редактирование.Доступность = Ложь;
	КонецЕсли;	
			
	ОбновитьИзмеренияИОтборы(Параметры.СтруктураОтбираемыхАналитик);
	
	ДопИнформация =  ДопИнформацияФормы;
		
	флОшибки = Ложь;	
	Если Параметры.ОтображатьПериодыВКолонках  
		И Параметры.тГоризонт.Количество()>0 Тогда
		ОтображатьПериодыВКолонках = Истина;
		Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка = Истина;

		ОтобразитьТаблицуПериодыВКолонках(Истина,ФлОшибки);
		
		Если ФлОшибки Тогда
			Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка = Ложь;
			ОтображатьПериодыВКолонках = Элементы.РаскрытиеПоказателейПериодыВКолонках.Пометка;	
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.РаскрытиеПоказателейСкопироватьДанныеПоСтроке.Видимость = ОтображатьПериодыВКолонках;
	
	ИзменитьТочностьМасштаб();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	АдресФормыВладельца = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	
	Если РежимРасшифровки
		И ТипЗнч(КлючРасшифровки) = Тип("Структура")
		И КлючРасшифровки.Количество()>0 Тогда
		
		СтруктураОтбора = Новый Структура;
		Для Каждого Стр Из КлючРасшифровки Цикл
			Если НЕ Стр.Значение = Неопределено Тогда
				СтруктураОтбора.Вставить(Стр.Ключ,Стр.Значение);
			КонецЕсли;	
		КонецЦикла;	
		
		Элементы.РаскрытиеПоказателей.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
		ОбновитьНадписьФильтраПоРасшифровке(СтруктураОтбора);
		
	КонецЕсли;	
	
КонецПроцедуры


#КонецОбласти

&НаКлиенте
Процедура ОбновитьНадписьФильтраПоРасшифровке(Отбор)
	
	ТекстУстановленногоФильтра = "";
	РеквизитыОтборыКДобавлению 		= Новый Массив;	
	
	Для Каждого Стр из Отбор Цикл		
		
		ЗаголовокПоля = "";
		
		Если ЗначениеЗаполнено(Стр.Значение) 
			И НЕ ТипЗнч(Стр.Значение) = Тип("Массив") Тогда 
			
			СинонимКолонки = КолонкиИСинонимы.НайтиПоЗначению(Стр.Ключ);
			
			Если Не СинонимКолонки = Неопределено Тогда
				ЗаголовокПоля = СинонимКолонки.Представление;
			Иначе	
				ЗаголовокПоля = Стр.Ключ;
			КонецЕсли;	
		КонецЕсли;	
		
		ТекстУстановленногоФильтра = ТекстУстановленногоФильтра + ?(ТекстУстановленногоФильтра = "", "", "; ")
		+ ЗаголовокПоля + ": " + Стр.Значение;
		
	КонецЦикла;
	
	Элементы.ГруппаЗаголовокОтборов.Видимость = Истина;
	
КонецПроцедуры	




#Область РаботаСФормойОтборов

&НаСервере
Процедура ОбновитьИзмеренияИОтборы(СтруктураНезаполненныхАналитик)
	
	//Читаем и типизируем все поля-аналитики, доступные для выбранных строк
	СТ_ДополнительныеНастройки.Настройки.Отбор.Элементы.Очистить();
	СКДПолейОтборов = ПолучитьОбщийМакет("МакетНастройкиОтборов");
	ТзРаскрытия      = ПолучитьИзВременногоХранилища(Параметры.АдресТзРаскрытия);
	
	Для Каждого СтрДоступноеПоле Из СтруктураНезаполненныхАналитик Цикл
		
		КолонкаТаблицы = ТзРаскрытия.Колонки.Найти(СтрДоступноеПоле.Ключ);
		Если СтрДоступноеПоле.Ключ = "Валюта" 
			ИЛИ СтрДоступноеПоле.Ключ = "ВидОтчета"
			ИЛИ СтрДоступноеПоле.Ключ = "УидГруппыОтборов"
			ИЛИ СтрДоступноеПоле.Ключ = "ПоказательОтчета" 
			ИЛИ КолонкаТаблицы =  Неопределено  Тогда
			Продолжить;
		КонецЕсли;	
		
		НП =  СКДПолейОтборов.НаборыДанных[0].Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));

		Если КолонкаТаблицы.Имя = "АналитикаВалюта" Тогда
			ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникВалюты;
		Иначе	
			ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(КолонкаТаблицы.Имя);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТекСубконто) Тогда
			НП.Заголовок 			= ТекСубконто.Наименование;
		Иначе	
			НП.Заголовок 			= КолонкаТаблицы.Заголовок;
		КонецЕсли;	
		
		НП.ПутьКДанным 			= СтрДоступноеПоле.Ключ;		
		НП.ТипЗначения 			= КолонкаТаблицы.ТипЗначения;
		НП.Поле 				= Строка(СтрДоступноеПоле.Ключ);
		
		НовыйЭлементОтбора = СТ_ДополнительныеНастройки.Настройки.Отбор.Элементы.
		Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ПолеОтбора = Новый ПолеКомпоновкиДанных(СтрДоступноеПоле.Ключ);
		НовыйЭлементОтбора.ЛевоеЗначение  = ПолеОтбора;
		НовыйЭлементОтбора.Использование  = Ложь;
		
		Если ТипЗнч(СтрДоступноеПоле.Значение) = Тип("Массив") Тогда
			НовыйЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
			СписокОтборов  = Новый СписокЗначений;
			СписокОтборов.ЗагрузитьЗначения(СтрДоступноеПоле.Значение);
			НовыйЭлементОтбора.ПравоеЗначение = СписокОтборов;
		Иначе	
			НовыйЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
            НовыйЭлементОтбора.ПравоеЗначение = СтрДоступноеПоле.Значение;
		КонецЕсли;
		
	КонецЦикла;	
		
	СКДПолейОтборовАдрес = ПоместитьВоВременноеХранилище(СКДПолейОтборов, ЭтаФорма.УникальныйИдентификатор);
	СТ_ДополнительныеНастройки.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКДПолейОтборовАдрес));
	
	ЗаполнитьДеревоОтборов();
	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДеревоОтборов()
	
	НастройкиОтборовДерево = РеквизитФормыВЗначение("НастройкиОтборов"); 
	Если НастройкиОтборовДерево.Строки.Количество() = 0 Тогда   			
		//Первая инициализация доп отборов
		ПервыйЭлемент =  НастройкиОтборовДерево.Строки.Добавить();
		ПервыйЭлемент.ПолеПредставление = "Отбор";
		
		Для Каждого СтрПолеОтбор Из СТ_ДополнительныеНастройки.Настройки.Отбор.Элементы Цикл
			
			ПолеСКД =  СТ_ДополнительныеНастройки.Настройки.ДоступныеПоляОтбора.Элементы.Найти(СтрПолеОтбор.ЛевоеЗначение);
			нЭлемент 					= ПервыйЭлемент.Строки.Добавить();
			нЭлемент.ПолеПредставление 	= ПолеСКД.Заголовок;
			нЭлемент.ПолеКод 			= ПолеСКД.Поле;
			нЭлемент.ВидСравнения 		= СтрПолеОтбор.ВидСравнения;
			нЭлемент.РежимОтбора        = Перечисления.РежимыОтборовАналитическихТаблиц.Данные;
			нЭлемент.ТипЗначения        = ПолеСКД.ТипЗначения;
			нЭлемент.ДоступныеЗначенияВыбора.ЗагрузитьЗначения(ПолеСКД.ДоступныеВидыСравнения.ВыгрузитьЗначения());
			нЭлемент.ЗначениеОтбора     = СтрПолеОтбор.ПравоеЗначение;
			
		КонецЦикла;	
			
	Иначе	
		
		МассивУдаляемыхОтборов = Новый Массив;
		МассивПолейОтборов     = Новый Массив;
		//Удаляем отборы, которые потеряли смысл в ноовм составе настроек
		Для Каждого ЭлементДереваОтборов Из НастройкиОтборовДерево.Строки[0].Строки Цикл 
			
			//Вычислим базовое поле  отбора без точек.
			БазовоеПоле  = ?(СтрНайти(ЭлементДереваОтборов.ПолеКод,".")>0,Лев(ЭлементДереваОтборов.ПолеКод,СтрНайти(ЭлементДереваОтборов.ПолеКод,".")-1),ЭлементДереваОтборов.ПолеКод);

			ПолеСКД =  СТ_ДополнительныеНастройки.Настройки.ДоступныеПоляОтбора.Элементы.Найти(БазовоеПоле);
			Если ПолеСКД = Неопределено Тогда
				 МассивУдаляемыхОтборов.Добавить(ЭлементДереваОтборов);
			КонецЕсли;	
			
			МассивПолейОтборов.Добавить(БазовоеПоле);
			
		КонецЦикла;			
		
		Для Каждого СтрУдаляемоеПоле Из МассивУдаляемыхОтборов Цикл
			НастройкиОтборовДерево.Строки[0].Строки.Удалить(СтрУдаляемоеПоле);
		КонецЦикла;	
		
		//Добавим поля, котрых ранее не было
		Для Каждого СтрПолеОтбор Из СТ_ДополнительныеНастройки.Настройки.Отбор.Элементы Цикл
			
			ПолеСКД =  СТ_ДополнительныеНастройки.Настройки.ДоступныеПоляОтбора.Элементы.Найти(СтрПолеОтбор.ЛевоеЗначение);
			
			Если МассивПолейОтборов.Найти(Строка(ПолеСКД.Поле))= Неопределено Тогда
				
				нЭлемент 					= НастройкиОтборовДерево.Строки[0].Строки.Добавить();
				нЭлемент.ПолеПредставление 	= ПолеСКД.Заголовок;
				нЭлемент.ПолеКод 			= ПолеСКД.Поле;
				нЭлемент.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
				нЭлемент.РежимОтбора        = Перечисления.РежимыОтборовАналитическихТаблиц.Данные;
				нЭлемент.ТипЗначения        = ПолеСКД.ТипЗначения;
				нЭлемент.ДоступныеЗначенияВыбора.ЗагрузитьЗначения(ПолеСКД.ДоступныеВидыСравнения.ВыгрузитьЗначения())
				
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(НастройкиОтборовДерево,"НастройкиОтборов");
	
КонецПроцедуры	

#КонецОбласти


#Область ОбработчикиПреобразованиеТаблицыРаскрытия

&НаСервере
Процедура ОтобразитьТаблицуПериодыВстроках(ТекущиеДанные = Ложь)

	КолонкиФиксации.Очистить();
	
	РеквизитыКДобавлению			= Новый Массив;
	СтруктураНезаполненныхАналитик  = ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);
	СтруктураОтбираемыхАналитик     = ПолучитьИзВременногоХранилища(АдресСтруктураОтбираемыхАналитик);
	тГоризонт                       = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	тОбъект                         = ПолучитьИзВременногоХранилища(АдресТекущегоОбъекта);
	
	Если ТекущиеДанные Тогда
		ТзРаскрытияПоказателей = ТранспонироватьТаблицуРаскрытияПериодыВСтроки();
	Иначе	
		Если РежимРаботыСНесколькимиПоказателями Тогда
			ТзРаскрытияПоказателей = ПреобразоватьИсходнуюТаблицуВПоказателиКолонки();
		Иначе	
			ТзРаскрытияПоказателей = ПолучитьИзВременногоХранилища(АдресТзРаскрытия);
		КонецЕсли;
	КонецЕсли;
	
	ТипЗначениеПоказателя = Показатель.ТипЗначения;
	ТипКолонкиЗначение = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5);
	
	ТипКолонкиЗначениеЧисло = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5);
	ТипКолонкиЗначениеБулево = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево();
	ТипКолонкиЗначениеДата = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипКолонкиЗначениеСтрока = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255);
	
	тСвойствАналитик 						 = ПолучитьИзВременногоХранилища(АдресТаблицыСвойствАналитик);
	
	//Удалим ранее созданные реквизиты таблицы
	РеквизтыКУдалению = Новый Массив;
	Для Каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты("РаскрытиеПоказателей") Цикл
		ИмяРеквизита = Реквизит.Имя; 
		РеквизтыКУдалению.Добавить("РаскрытиеПоказателей."+ИмяРеквизита);
	КонецЦикла;	
	
    СписокКолонок.Очистить();
	
	//Удалить реквизиты формы
	МассивУдаляемыхЭлементовФормы = Новый Массив;
	Для Каждого Элемент Из Элементы.РаскрытиеПоказателей.ПодчиненныеЭлементы Цикл
		МассивУдаляемыхЭлементовФормы.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из МассивУдаляемыхЭлементовФормы Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
	
	//Добавляем колонки-аналитики
	Для Каждого Кол ИЗ СтруктураНезаполненныхАналитик Цикл	                                                 		
		Колонка = ТзРаскрытияПоказателей.Колонки.Найти(Кол.Ключ);
		Если Колонка = Неопределено Тогда
			 Продолжить;
		КонецЕсли;	
		
		ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Колонка.Имя);
		Если ЗначениеЗаполнено(ТекСубконто) Тогда
			 ТипКолонки = Новый ОписаниеТипов(ТекСубконто.ТипЗначения);
		Иначе	
			 ТипКолонки = Новый ОписаниеТипов(Колонка.ТипЗначения,,"NULL");	
		КонецЕсли;	
				
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Колонка.Имя,
		ТипКолонки,
		"РаскрытиеПоказателей",
		Колонка.Заголовок,
		Ложь));	
			
		СписокКолонок.Добавить(Неопределено,Колонка.Имя);		

	КонецЦикла;

	//Добавляем колонки-показатели
	Для Каждого Кол Из РесурыПериодыВСтроках Цикл
		
		Если Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			 ТипКолонки = ТипКолонкиЗначениеЧисло;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда	
			 ТипКолонки = ТипКолонкиЗначениеДата;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда	
			 ТипКолонки = ТипКолонкиЗначениеСтрока;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда	
			 ТипКолонки = ТипКолонкиЗначениеБулево;
		КонецЕсли;	
		
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Кол.ИмяВЗапросе,
		ТипКолонки,
		"РаскрытиеПоказателей",
		Кол.ИмяВЗапросе,
		Ложь));	
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, Кол.ИмяВЗапросе + "_Итог") Тогда
			РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Кол.ИмяВЗапросе + "_Итог", ТипКолонки));
		КонецЕсли;
		
		СписокКолонок.Добавить(Неопределено,Кол.ИмяВЗапросе);
		
	КонецЦикла;
	
	ДобавитьОтступ(РеквизитыКДобавлению);
	ДобавитьОтступ(ТзРаскрытияПоказателей);
	
	// Добавим новые реквизиты
	ИзменитьРеквизиты(РеквизитыКДобавлению,РеквизтыКУдалению);
	ЗначениеВРеквизитФормы(ТзРаскрытияПоказателей,"РаскрытиеПоказателей");
		
	Для Каждого Кол ИЗ СтруктураНезаполненныхАналитик Цикл			
		Колонка = ТзРаскрытияПоказателей.Колонки.Найти(Кол.Ключ);
		
		Если Колонка = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		КолонкиФиксации.Добавить(Колонка.Имя);
		
		ЭтаФорма.Элементы.Добавить(Колонка.Имя,Тип("ПолеФормы"),ЭтаФорма.Элементы.РаскрытиеПоказателей);	
		ЭтаФорма.Элементы[Колонка.Имя].ПутьКДанным		= "РаскрытиеПоказателей."+Колонка.Имя;
		ЭтаФорма.Элементы[Колонка.Имя].Вид				= ВидПоляФормы.ПолеВвода;						
		ЭтаФорма.Элементы[Колонка.Имя].ВыбиратьТип		= Ложь;		
		ЭтаФорма.Элементы[Колонка.Имя].Ширина=12;
		ЭтаФорма.Элементы[Колонка.Имя].МаксимальнаяШирина=12;
		ЭтаФорма.Элементы[Колонка.Имя].АвтоМаксимальнаяШирина=Ложь;
        ЭтаФорма.Элементы[Колонка.Имя].РастягиватьПоГоризонтали = Ложь;

		
		Если  Колонка.Имя = "Организация" 
			ИЛИ Колонка.Имя = "Проект" 
			ИЛИ Колонка.Имя = "Сценарий"  
			ИЛИ Колонка.Имя = "ПериодОтчета" Тогда	
			ЭтаФорма.Элементы[Колонка.Имя].ДоступныеТипы=Новый ОписаниеТипов(Колонка.ТипЗначения,,"NULL");
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаВыбора=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОчистки=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОткрытия=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].АвтоОтметкаНезаполненного = Истина;
			
			Если  Колонка.Имя = "ПериодОтчета" Тогда
				ЭтаФорма.Элементы[Колонка.Имя].Заголовок = Нстр("ru = 'Период отчета'");
				тГоризонт  = тГоризонт;
				СоздатьОграничениеПоПериодам(тГоризонт);
				
			Иначе	
				СоздатьОграничениеПоКлючевойАналитике(Колонка.Имя,тОбъект);
			КонецЕсли;			
			
		Иначе
				ТекСтрокаСвойств = тСвойствАналитик.НайтиСтроки(Новый Структура("КодАналитики",Колонка.Имя))[0];
				
			Если Колонка.Имя = "АналитикаВалюта" Тогда
				ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникВалюты;
			Иначе	
				ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Колонка.Имя);
			КонецЕсли;	
			
			ЭтаФорма.Элементы[Колонка.Имя].ДоступныеТипы=Новый ОписаниеТипов(ТекСубконто.ТипЗначения);
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаВыбора=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОчистки=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОткрытия=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
			ЭтаФорма.Элементы[Колонка.Имя].Заголовок=ТекСубконто.Наименование;
			Если ТекСтрокаСвойств.ОбязательноеЗаполнение Тогда
				ЭтаФорма.Элементы[Колонка.Имя].АвтоОтметкаНезаполненного = Истина;
			КонецЕсли;	
			Если ТекСубконто.ТипЗначения.Типы().Количество()>1 Тогда
				ЭтаФорма.Элементы[Колонка.Имя].ВыбиратьТип = Истина;
			КонецЕсли;	

			УстановитьСвязиПараметровВыбора(ТекСтрокаСвойств);
			
			Если ТекСтрокаСвойств.ЭтоЭтапПроекта Тогда             
				УстановитьОтборПоПроекту(ТекСтрокаСвойств,СтруктураОтбираемыхАналитик);
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ТекСтрокаСвойств.ОтборЗначений) И ТекСтрокаСвойств.типАналитики.Типы().Количество()=1 Тогда
				УстановитьОтборПоФильтру(ТекСтрокаСвойств);
			КонецЕсли;	
			
			Если ТекСтрокаСвойств.МетаИмяАналитики = "ПроизвольныйКлассификаторУХ" Тогда
				НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", ТекСубконто);
				НовыйМассив = Новый Массив();
				НовыйМассив.Добавить(НовыйПараметр);				
						
				Если  ТекСубконто.РазделятьПоОрганизациям И СтруктураОтбираемыхАналитик.Свойство("Организация") Тогда		
					НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", СтруктураОтбираемыхАналитик.Организация);
					НовыйМассив.Добавить(НовыйПараметр);							
				КонецЕсли;	
				
				НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
				ЭтаФорма.Элементы[ТекСтрокаСвойств.КодАналитики].ПараметрыВыбора=НовыеПараметры;
				
			КонецЕсли;	
					
		КонецЕсли;
		ЭтаФорма.Элементы[Колонка.Имя].ГоризонтальноеПоложениеВПодвале=ГоризонтальноеПоложениеЭлемента.Право;					 
		
		КолонкиИСинонимы.Добавить(Колонка.Имя,ЭтаФорма.Элементы[Колонка.Имя].Заголовок);
		
	КонецЦикла;

	//Добавляем колонки-показатели
	СписокВалютныхКолонок.Очистить();
	Для Каждого Кол Из РесурыПериодыВСтроках Цикл
		
		Если Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			 ТипКолонки = ТипКолонкиЗначениеЧисло;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда	
			 ТипКолонки = ТипКолонкиЗначениеДата;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда	
			 ТипКолонки = ТипКолонкиЗначениеСтрока;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда	
			 ТипКолонки = ТипКолонкиЗначениеБулево;
		КонецЕсли;	
		
		КолонкиФиксации.Добавить("Группа_"+Строка(Кол.ИмяВЗапросе));
		
		ГруппаКолонки = ЭтаФорма.Элементы.Добавить("Группа_"+Строка(Кол.ИмяВЗапросе),Тип("ГруппаФормы"),ЭтаФорма.Элементы.РаскрытиеПоказателей); 
		ГруппаКолонки.Вид = ВидГруппыФормы.ГруппаКолонок;
		ГруппаКолонки.ОтображатьВШапке = Ложь;
		
		ГруппаКолонки_ = ЭтаФорма.Элементы.Добавить("ГруппаЗаголовок_"+Строка(Кол.ИмяВЗапросе),Тип("ГруппаФормы"),ГруппаКолонки); 
		ГруппаКолонки_.Вид = ВидГруппыФормы.ГруппаКолонок;
		ГруппаКолонки_.ОтображатьВШапке = Истина;
        ГруппаКолонки_.Ширина = 12;
        ГруппаКолонки_.РастягиватьПоГоризонтали = Ложь;
	
		Если Кол.ЗначениеВалюта  Тогда
			ГруппаКолонки_.Заголовок=Строка(Кол.ПоказательОтчета.Колонка);   //Заголовок валютного показателя
			ГруппаКолонки_.КартинкаШапки = БиблиотекаКартинок.Валюты;

			Если Кол.ПересчитыватьВалютнуюСумму Тогда 
				СписокВалютныхКолонок.Добавить(Кол.ИмяВЗапросе);
			Иначе	
				ГруппаКолонки_.Видимость = Ложь;
				//Элементы[Кол.ИмяВЗапросе].Видимость = Ложь; 
			КонецЕсли;	
		Иначе	
			ГруппаКолонки_.Заголовок=Строка(Кол.ПоказательОтчета.Колонка);
		КонецЕсли;
		
		ЭтаФорма.Элементы.Добавить(Кол.ИмяВЗапросе,Тип("ПолеФормы"),ГруппаКолонки_);	
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ПутьКДанным		= "РаскрытиеПоказателей."+Кол.ИмяВЗапросе;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].Вид				= ВидПоляФормы.ПолеВвода;						
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ВыбиратьТип		= Ложь;	
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ОтображатьВШапке = Ложь;
		
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ДоступныеТипы=ТипКолонки;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].КнопкаВыбора=Истина;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].РедактированиеТекста=Истина;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ПутьКДаннымПодвала = Кол.ИмяВЗапросе + "_Итог";
		
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].Ширина=12;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].МаксимальнаяШирина=12;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].АвтоМаксимальнаяШирина=Ложь;
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].РастягиватьПоГоризонтали = Ложь;	
		
		ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		
	КонецЦикла;	

	ДобавитьОтступ(Элементы);
	
	Для Каждого ВалютнаяКолонка Из СписокВалютныхКолонок Цикл
		Элементы[ВалютнаяКолонка.Значение].Видимость = Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка;
	КонецЦикла;
	
	ОбновитьИтогиПоКолонкам();
	ОбновитьУсловноеОформление();
	
КонецПроцедуры	

&НаСервере
Процедура ОтобразитьТаблицуПериодыВКолонках(ТекущиеДанные = Ложь,ФлОшибки = Ложь) 
	
	ТзРаскрытияПоказателейПериодыВКолонках = ТранспонироватьТаблицуРаскрытияПериодыВКолонки(ТекущиеДанные);
	
	Если ТзРаскрытияПоказателейПериодыВКолонках = Неопределено Тогда	
		ФлОшибки = Истина;
		Возврат;	
	КонецЕсли;	
	
	КолонкиФиксации.Очистить();
	
	РеквизитыКДобавлению			= Новый Массив;
	РеквизитыОтборыКДобавлению 		= Новый Массив;	
	СтруктураНезаполненныхАналитик   = ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);
	СтруктураОтбираемыхАналитик     = ПолучитьИзВременногоХранилища(АдресСтруктураОтбираемыхАналитик);
	тГоризонт                       = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	тОбъект                         = ПолучитьИзВременногоХранилища(АдресТекущегоОбъекта);
	
	ТзРаскрытияПоказателей = ПолучитьИзВременногоХранилища(АдресТзРаскрытия);
	ТипЗначениеПоказателя = Показатель.ТипЗначения;
	
	ТипКолонкиЗначениеЧисло = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5);	
	ТипКолонкиЗначениеБулево = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево();
	ТипКолонкиЗначениеДата = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипКолонкиЗначениеСтрока = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255);
	
	тСвойствАналитик 						 = ПолучитьИзВременногоХранилища(АдресТаблицыСвойствАналитик);
	
	//Удалим ранее созданные реквизиты таблицы
	РеквизтыКУдалению = Новый Массив;
	Для Каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты("РаскрытиеПоказателей") Цикл
		ИмяРеквизита = Реквизит.Имя; 
		РеквизтыКУдалению.Добавить("РаскрытиеПоказателей."+ИмяРеквизита);
	КонецЦикла;	
	
    СписокКолонок.Очистить();
	
	//Удалить реквизиты формы
	МассивУдаляемыхЭлементовФормы = Новый Массив;
	Для Каждого Элемент Из Элементы.РаскрытиеПоказателей.ПодчиненныеЭлементы Цикл
		МассивУдаляемыхЭлементовФормы.Добавить(Элемент);
	КонецЦикла;	
	Для Каждого Элемент Из МассивУдаляемыхЭлементовФормы Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;	
	
	//Добавляем колонки-аналитики
	Для Каждого Кол ИЗ СтруктураНезаполненныхАналитик Цикл	                                                 		
		Колонка = ТзРаскрытияПоказателейПериодыВКолонках.Колонки.Найти(Кол.Ключ);
		Если Колонка = Неопределено Тогда
			 Продолжить;
		КонецЕсли;	
		
		ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Колонка.Имя);
		Если ЗначениеЗаполнено(ТекСубконто) Тогда
			 ТипКолонки = Новый ОписаниеТипов(ТекСубконто.ТипЗначения);
		Иначе	
			 ТипКолонки = Новый ОписаниеТипов(Колонка.ТипЗначения,,"NULL");	
		КонецЕсли;	
				
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Колонка.Имя,
		ТипКолонки,
		"РаскрытиеПоказателей",
		Колонка.Заголовок,
		Ложь));	
			
		СписокКолонок.Добавить(Неопределено,Колонка.Имя);		
	КонецЦикла;

		
	//Добавляем колонки-показатели
	Для Каждого Кол Из РесурыПериодыВКолонках Цикл
		
		Если Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			 ТипКолонки = ТипКолонкиЗначениеЧисло;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда	
			 ТипКолонки = ТипКолонкиЗначениеДата;
		ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда	
			 ТипКолонки = ТипКолонкиЗначениеСтрока;
	    ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда	
			 ТипКолонки = ТипКолонкиЗначениеБулево;
		КонецЕсли;	

		
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Кол.ИмяВЗапросе,
		ТипКолонки,
		"РаскрытиеПоказателей",
		Кол.ИмяВЗапросе,
		Ложь));	
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, Кол.ИмяВЗапросе + "_Итог") Тогда
			РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Кол.ИмяВЗапросе + "_Итог", ТипКолонки));
		КонецЕсли;
		
	КонецЦикла;	
	
	ДобавитьОтступ(РеквизитыКДобавлению);
	ДобавитьОтступ(ТзРаскрытияПоказателейПериодыВКолонках);
	
	//Добавим новые реквизиты
	ИзменитьРеквизиты(РеквизитыКДобавлению,РеквизтыКУдалению);
	ЗначениеВРеквизитФормы(ТзРаскрытияПоказателейПериодыВКолонках,"РаскрытиеПоказателей");
		
	Для Каждого Кол ИЗ СтруктураНезаполненныхАналитик Цикл			
		Колонка = ТзРаскрытияПоказателейПериодыВКолонках.Колонки.Найти(Кол.Ключ);
     			
		Если Колонка = Неопределено Тогда
			 Продолжить;
		КонецЕсли;	
		
		КолонкиФиксации.Добавить(Колонка.Имя);
		
		ЭтаФорма.Элементы.Добавить(Колонка.Имя,Тип("ПолеФормы"),ЭтаФорма.Элементы.РаскрытиеПоказателей);	
		ЭтаФорма.Элементы[Колонка.Имя].ПутьКДанным		= "РаскрытиеПоказателей."+Колонка.Имя;
		ЭтаФорма.Элементы[Колонка.Имя].Вид				= ВидПоляФормы.ПолеВвода;						
		ЭтаФорма.Элементы[Колонка.Имя].ВыбиратьТип		= Ложь;		
		ЭтаФорма.Элементы[Колонка.Имя].Ширина=12;
		ЭтаФорма.Элементы[Колонка.Имя].МаксимальнаяШирина=12;
		ЭтаФорма.Элементы[Колонка.Имя].АвтоМаксимальнаяШирина=Ложь;	
		ЭтаФорма.Элементы[Колонка.Имя].РастягиватьПоГоризонтали = Ложь;
		
		Если  Колонка.Имя = "Организация" 
			ИЛИ Колонка.Имя = "Проект" 
			ИЛИ Колонка.Имя = "Сценарий"  Тогда	
			ЭтаФорма.Элементы[Колонка.Имя].ДоступныеТипы=Новый ОписаниеТипов(Колонка.ТипЗначения,,"NULL");
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаВыбора=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОчистки=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОткрытия=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].АвтоОтметкаНезаполненного = Истина;
				
			СоздатьОграничениеПоКлючевойАналитике(Колонка.Имя,тОбъект);
		
		Иначе
			
			ТекСтрокаСвойств = тСвойствАналитик.НайтиСтроки(Новый Структура("КодАналитики",Колонка.Имя))[0];
			
			Если Колонка.Имя = "АналитикаВалюта" Тогда
				ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникВалюты;
			Иначе	
				ТекСубконто =  ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Колонка.Имя);
			КонецЕсли;	
			
			Если  Колонка.Имя = "ПериодОтчета" Тогда
				ЭтаФорма.Элементы[Колонка.Имя].Заголовок = Нстр("ru = 'Период отчета'");
            КонецЕсли;
			
			ЭтаФорма.Элементы[Колонка.Имя].ДоступныеТипы=Новый ОписаниеТипов(ТекСубконто.ТипЗначения);
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаВыбора=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОчистки=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].КнопкаОткрытия=Истина;
			ЭтаФорма.Элементы[Колонка.Имя].ВыборГруппИЭлементов = ГруппыИЭлементы.Элементы;
			ЭтаФорма.Элементы[Колонка.Имя].Заголовок=ТекСубконто.Наименование;
			Если ТекСтрокаСвойств.ОбязательноеЗаполнение Тогда
				ЭтаФорма.Элементы[Колонка.Имя].АвтоОтметкаНезаполненного = Истина;
			КонецЕсли;	
			Если ТекСубконто.ТипЗначения.Типы().Количество()>1 Тогда
				ЭтаФорма.Элементы[Колонка.Имя].ВыбиратьТип = Истина;
			КонецЕсли;	

			УстановитьСвязиПараметровВыбора(ТекСтрокаСвойств);
			
			Если ТекСтрокаСвойств.ЭтоЭтапПроекта Тогда             
				УстановитьОтборПоПроекту(ТекСтрокаСвойств,СтруктураОтбираемыхАналитик);
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ТекСтрокаСвойств.ОтборЗначений) И ТекСтрокаСвойств.типАналитики.Типы().Количество()=1 Тогда
				УстановитьОтборПоФильтру(ТекСтрокаСвойств);
			КонецЕсли;	
			
			Если ТекСтрокаСвойств.МетаИмяАналитики = "ПроизвольныйКлассификаторУХ" Тогда
				НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", ТекСубконто);
				НовыйМассив = Новый Массив();
				НовыйМассив.Добавить(НовыйПараметр);				
						
				Если  ТекСубконто.РазделятьПоОрганизациям И СтруктураОтбираемыхАналитик.Свойство("Организация") Тогда		
					НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", СтруктураОтбираемыхАналитик.Организация);
					НовыйМассив.Добавить(НовыйПараметр);							
				КонецЕсли;	
				
				НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
				ЭтаФорма.Элементы[ТекСтрокаСвойств.КодАналитики].ПараметрыВыбора=НовыеПараметры;
				
			КонецЕсли;	
					
		КонецЕсли;
		ЭтаФорма.Элементы[Колонка.Имя].ГоризонтальноеПоложениеВПодвале=ГоризонтальноеПоложениеЭлемента.Право;					 
		
		КолонкиИСинонимы.Добавить(Колонка.Имя,ЭтаФорма.Элементы[Колонка.Имя].Заголовок);

	КонецЦикла;
		
	//Добавляем колонки-показатели
	СписокВалютныхКолонок.Очистить();
	РесурыПериодыТаблица =  РесурыПериодыВКолонках.Выгрузить();
	РесурыПериодыТаблица.Свернуть("ПериодОтчета");
	ИндексПериода = 1;
	
	Для Каждого Период Из РесурыПериодыТаблица Цикл
		
		КолонкиФиксации.Добавить("Группа_Период"+Строка(ИндексПериода));
		
		ГруппаКолонки = ЭтаФорма.Элементы.Добавить("Группа_Период"+Строка(ИндексПериода),Тип("ГруппаФормы"),ЭтаФорма.Элементы.РаскрытиеПоказателей); 
		ГруппаКолонки.Вид = ВидГруппыФормы.ГруппаКолонок;
		ГруппаКолонки.ОтображатьВШапке = Истина;
		ГруппаКолонки.Заголовок = Строка(Период.ПериодОтчета);  
		ГруппаКолонки.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
		ГруппаКолонки.Группировка                   = ГруппировкаКолонок.Горизонтальная;
		
		ГруппаКолонки.ЦветФонаЗаголовка = Новый Цвет(220,220,220);
		ГруппаКолонки.Ширина = 12;
        ГруппаКолонки.РастягиватьПоГоризонтали = Ложь;
		
		КолонкиПериода = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ПериодОтчета",Период.ПериодОтчета));
		Для Каждого Кол Из КолонкиПериода Цикл
			
			Если Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				ТипКолонки = ТипКолонкиЗначениеЧисло;
			ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда	
				ТипКолонки = ТипКолонкиЗначениеДата;
			ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда	
				ТипКолонки = ТипКолонкиЗначениеСтрока;
			ИначеЕсли Кол.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда	
				ТипКолонки = ТипКолонкиЗначениеБулево;
			КонецЕсли;	
			
			ГруппаКолонки_ = ЭтаФорма.Элементы.Добавить("ГруппаЗаголовок_"+Строка(Кол.ИмяВЗапросе),Тип("ГруппаФормы"),ГруппаКолонки); 
			ГруппаКолонки_.Вид = ВидГруппыФормы.ГруппаКолонок;
			ГруппаКолонки_.ОтображатьВШапке = Истина;
			ГруппаКолонки_.Подсказка = Строка(Кол.ПоказательОтчета.Колонка);
			
			Если Кол.ЗначениеВалюта  Тогда
				ГруппаКолонки_.Заголовок=Строка(Кол.ПоказательОтчета.Колонка);   //Заголовок валютного показателя
				ГруппаКолонки_.КартинкаШапки = БиблиотекаКартинок.Валюты;
				
				Если Кол.ПересчитыватьВалютнуюСумму Тогда 
					СписокВалютныхКолонок.Добавить(Кол.ИмяВЗапросе);
				Иначе	
					ГруппаКолонки_.Видимость = Ложь;
				КонецЕсли;	
			Иначе	
				ГруппаКолонки_.Заголовок=Строка(Кол.ПоказательОтчета.Колонка);
			КонецЕсли;

			
			ЭтаФорма.Элементы.Добавить(Кол.ИмяВЗапросе,Тип("ПолеФормы"),ГруппаКолонки_);	
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ПутьКДанным		= "РаскрытиеПоказателей."+Кол.ИмяВЗапросе;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].Вид				= ВидПоляФормы.ПолеВвода;						
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ВыбиратьТип		= Ложь;				
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ДоступныеТипы=ТипКолонки;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].КнопкаВыбора=Истина;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].РедактированиеТекста=Истина;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].Ширина=12;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].МаксимальнаяШирина = 12;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].АвтоМаксимальнаяШирина = Ложь;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].РастягиватьПоГоризонтали = Ложь;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
            ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ОтображатьВШапке = Ложь;
			ЭтаФорма.Элементы[Кол.ИмяВЗапросе].ПутьКДаннымПодвала = Кол.ИмяВЗапросе + "_Итог";
			
		КонецЦикла;
		ИндексПериода = ИндексПериода+1;
	КонецЦикла;	
	
	ДобавитьОтступ(Элементы);
	
	Для Каждого ВалютнаяКолонка Из СписокВалютныхКолонок Цикл
		Элементы[ВалютнаяКолонка.Значение].Видимость = Элементы.РаскрытиеПоказателейОтобразитьВалютныеСуммы.Пометка;
	КонецЦикла;
	
	ОбновитьИтогиПоКолонкам();
	ОбновитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтступ(Коллекция)
	
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		
		Коллекция.Добавить(Новый РеквизитФормы(
			"Отступ",
			ОбщегоНазначения.ОписаниеТипаСтрока(1),
			"РаскрытиеПоказателей"));
		
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ВсеЭлементыФормы") Тогда
		
		ЭлементОтступ = Коллекция.Добавить("Отступ", Тип("ПолеФормы"), Коллекция.РаскрытиеПоказателей);
		ЭлементОтступ.ПутьКДанным = "РаскрытиеПоказателей.Отступ";
		ЭлементОтступ.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементОтступ.Ширина = 1;
		ЭлементОтступ.РастягиватьПоГоризонтали = Истина;
		
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		
		Коллекция.Колонки.Добавить("Отступ", ОбщегоНазначения.ОписаниеТипаСтрока(1));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
//Функция ТранспонироватьТаблицуРаскрытияПериодыВКолонки
//Преобразует таблицу с периодами в стоках 
//в таблицу где периоды являются ресурсами в колонках.
//Используется для переключения режимов отображения на форме
Функция ТранспонироватьТаблицуРаскрытияПериодыВКолонки(ТекущиеДанные) 
	
	//Если ТекущиеДанные то берем таблицу из реквизита на форме (с пользовательскими изменениями), 
	//иначе исходную таблицу, сформированную в момент вызова формы
	РесурыПериодыВКолонках.Очистить();
	
	Если ТекущиеДанные Тогда 
		ТзРаскрытияПоказателей 				= РеквизитФормыВЗначение("РаскрытиеПоказателей");			
	Иначе
		ТзРаскрытияПоказателей 				= ПолучитьИзВременногоХранилища(АдресТзРаскрытия);			
	КонецЕсли;	
	
	РаскрываемыеАналитики = ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);
	
	МассивПериодов                      = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	
	Запрос = Новый Запрос;
	ТекущиеПоля  = "";
	ТекущиеПоляТранспонированные = "";
	ТекстПоляАгрегаты            = "";
	ТекстПоляГруппировки         = "";
	
	Для Каждого СтрПоле Из ТзРаскрытияПоказателей.Колонки Цикл
		
		ТекущиеПоля = ТекущиеПоля+"
		|	"+"ТзРаскрытияПоказателей."+СтрПоле.Имя+",";
		
		
		Если СтрПоле.Имя = "ПериодОтчета" 
			ИЛИ СтрПоле.Имя = "УидГруппыОтборов" 
			ИЛИ СтрПоле.Имя = "Значение"
			ИЛИ СтрПоле.Имя = "ЗначениеВалюта"
			ИЛИ СтрПоле.Имя = "ЗначениеНечисловое" Тогда
			Продолжить;
		КонецЕсли;	
		
		ТекущиеПоляТранспонированные = ТекущиеПоляТранспонированные+"
		|	"+"ВтТаблицаРаскрытия."+СтрПоле.Имя+",";	
		
		Если РаскрываемыеАналитики.Свойство(СтрПоле.Имя) Тогда
			ТекстПоляГруппировки = ТекстПоляГруппировки+"
			|	"+"ВтТаблицаТранспонированная."+СтрПоле.Имя+",";		
			
			ТекстПоляАгрегаты = ТекстПоляАгрегаты+"
			|	"+"ВтТаблицаТранспонированная."+СтрПоле.Имя+",";	
		КонецЕсли;	
		
	КонецЦикла;	
	
		
	ИндексПериода = 1;
	Для Каждого Период Из МассивПериодов Цикл
		
		
		//Если поднимаем даные из таблицы на форме, то используем псевдонимы колонок-показателей
		//измерения показатель отсутствует
		Если ТекущиеДанные Тогда	
			
			ИндексПоказателя = 1;
			
			Для Каждого Ресурс Из РесурыПериодыВСтроках Цикл
				
				ПсевдонимПоля 			= "Период_"+ИндексПериода+"_"+Ресурс.ИмяВЗапросе;
				ПсевдонимОсновногоПоля  = "Период_"+ИндексПериода+"_"+Ресурс.ИмяОсновнойКолонки;
				
				//Если Показатель.ТипЗначениеПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				
				ТекущиеПоляТранспонированные = ТекущиеПоляТранспонированные+"
				|	ВЫБОР КОГДА ВтТаблицаРаскрытия.ПериодОтчета = &ПараметрПериод_"+ИндексПериода+" ТОГДА ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" КОНЕЦ КАК "+ПсевдонимПоля+",";
				
				
				ТекстПоляАгрегаты = ТекстПоляАгрегаты+"
				|	МАКСИМУМ(ВтТаблицаТранспонированная."+ПсевдонимПоля+"),";
				
				НстрокаРесурсы = РесурыПериодыВКолонках.Добавить();
				НстрокаРесурсы.ПоказательОтчета 		= Ресурс.ПоказательОтчета;
				НстрокаРесурсы.ПериодОтчета     		= Период;
				НстрокаРесурсы.ИмяВЗапросе      		= ПсевдонимПоля;
				НстрокаРесурсы.ТипЗначенияПоказателя  	= Ресурс.ТипЗначенияПоказателя;
				НстрокаРесурсы.ЗначениеВалюта  			= Ресурс.ЗначениеВалюта;
				НстрокаРесурсы.ПересчитыватьВалютнуюСумму = Ресурс.ПересчитыватьВалютнуюСумму;
				НстрокаРесурсы.ИмяОсновнойКолонки         = ПсевдонимОсновногоПоля;
	
				//КонецЕсли;	
				
				ИндексПоказателя = ИндексПоказателя+1;
				
			КонецЦикла;

			
		Иначе
		//Если поднимаем даные из хранилища, то там ресурсы  всегда называются Значение,ЗначениеВалюта,ЗначениеНечисловое
		//и хранятся в разрезе показателей отчета.
						
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПараметрПериод_"+ИндексПериода,Период);
		
		ИндексПериода = ИндексПериода+1;
		
	КонецЦикла;	
	
	
	ТекущиеПоля = Лев(ТекущиеПоля,СтрДлина(ТекущиеПоля)-1);
	ТекущиеПоляТранспонированные 	= Лев(ТекущиеПоляТранспонированные,СтрДлина(ТекущиеПоляТранспонированные)-1);
	ТекстПоляАгрегаты 				= Лев(ТекстПоляАгрегаты,СтрДлина(ТекстПоляАгрегаты)-1);
	ТекстПоляГруппировки 			= Лев(ТекстПоляГруппировки,СтрДлина(ТекстПоляГруппировки)-1);
	
	
	Запрос.Текст = "ВЫБРАТЬ"+ТекущиеПоля+"
	|ПОМЕСТИТЬ ВтТаблицаРаскрытия
	|ИЗ 
	|&ТзРаскрытияПоказателей КАК ТзРаскрытияПоказателей
	|;
	|ВЫБРАТЬ"+ТекущиеПоляТранспонированные+"
	|ПОМЕСТИТЬ ВтТаблицаТранспонированная
	|ИЗ 
	|ВтТаблицаРаскрытия КАК ВтТаблицаРаскрытия
	|;
	|ВЫБРАТЬ"+ТекстПоляАгрегаты;
	Если НЕ ТекстПоляГруппировки = "" Тогда
		Запрос.Текст = Запрос.Текст +"	
		|СГРУППИРОВАТЬ ПО
		|"+ТекстПоляГруппировки;	
	КонецЕсли;	
			
	Запрос.УстановитьПараметр("ТзРаскрытияПоказателей",ТзРаскрытияПоказателей);
		
	Если РесурыПериодыВКолонках.Количество()<1000 Тогда 
		Возврат Запрос.Выполнить().Выгрузить();
	Иначе	
		//Такое количество колонок в виде ресурсов роняет SQL...
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции	

&НаСервере
//Функция ТранспонироватьТаблицуРаскрытияПериодыВСтроки
//Преобразует таблицу на форме с периодам и ресурсами в колонках 
//в таблицу где период в строке, ресурсы в колонках.
//Используется для переключения режимов отображения на форме
Функция ТранспонироватьТаблицуРаскрытияПериодыВСтроки() 
	
	
	ТзРаскрытияПоказателей 				= РеквизитФормыВЗначение("РаскрытиеПоказателей");						
	РаскрываемыеАналитики 				= ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);	
	МассивПериодов                      = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	
	//Берем список периодов и делаем объединение c каждой колонкой периода
	
	Запрос = Новый Запрос;
	
	ИндексПериода = 1;
	ИндексРесурса = 1;
	ТекстПодзапроса = "";
	
	Для Каждого Период Из МассивПериодов Цикл      //Цикл по периодам
		
		ТекущиеРесурсы = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ПериодОтчета",Период));
		ТекущиеПоляАналитики = "";
		ИндексРесурса  = 1;
		ТекущиеПоляРесурсы  = "";
		ТекстУсловия    = "";
		
		
		//Колонки - аналитики
		Для Каждого РаскрываемоеПоле Из РаскрываемыеАналитики Цикл
			Если РаскрываемоеПоле.Ключ = "ПериодОтчета" Тогда
				ТекущиеПоляАналитики = ТекущиеПоляАналитики+"
				|	&ПараметрПериод_"+ИндексПериода+" КАК ПериодОтчета,";
				
				Запрос.УстановитьПараметр("ПараметрПериод_"+ИндексПериода,Период);			
			Иначе		
				ТекущиеПоляАналитики = ТекущиеПоляАналитики+"
				|	ВтТаблицаРаскрытия."+РаскрываемоеПоле.Ключ+" КАК "+РаскрываемоеПоле.Ключ+",";
			КонецЕсли;	
			
		КонецЦикла;	
			
		ИндексРесурсаЛокальный = 1;
		
		Для Каждого Ресурс Из ТекущиеРесурсы Цикл   //Цикл по ресурсам
				
			ИмяВЗапросеПоказателиСтроки = РесурыПериодыВСтроках.НайтиСтроки(Новый Структура("ПоказательОтчета,ЗначениеВалюта",Ресурс.ПоказательОтчета,Ресурс.ЗначениеВалюта))[0]; 
			
			ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
			|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" КАК "+ИмяВЗапросеПоказателиСтроки.ИмяВЗапросе+",";
			
						
			Если НЕ Ресурс.ЗначениеВалюта Тогда
				Если Ресурс.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда	
					
					Если ИндексРесурсаЛокальный = 1 Тогда
						ТекстУсловия = ТекстУсловия+"
						|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" <>0";		
					Иначе	
						ТекстУсловия = ТекстУсловия+"
						|	ИЛИ ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" <>0";		
					КонецЕсли;
					
				ИначеЕсли Ресурс.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда	
					
					Если ИндексРесурсаЛокальный = 1 Тогда
						ТекстУсловия = ТекстУсловия+"
						|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" <>ДАТАВРЕМЯ(1,1,1,0,0,0)";	
					Иначе
						ТекстУсловия = ТекстУсловия+"
						|	ИЛИ ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" <>ДАТАВРЕМЯ(1,1,1,0,0,0)";	
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;
			
			ИндексРесурсаЛокальный = 		ИндексРесурсаЛокальный +1;
			
		КонецЦикла;	           
		
		Если ИндексПериода>1  Тогда 
			ТекстПодзапроса = ТекстПодзапроса+"
			|ОБЪЕДИНИТЬ ВСЕ";
		КонецЕсли;	
		
		ТекущиеПоляРесурсы = Лев(ТекущиеПоляРесурсы,СтрДлина(ТекущиеПоляРесурсы)-1);

		
		ТекстПодзапроса = ТекстПодзапроса+"
		|ВЫБРАТЬ"+ТекущиеПоляАналитики+ТекущиеПоляРесурсы+"
		|ИЗ 
		|ВтТаблицаРаскрытия КАК ВтТаблицаРаскрытия";
			
		Если НЕ ТекстУсловия = "" Тогда
			
			ТекстПодзапроса = ТекстПодзапроса+"
            |ГДЕ 
			| "+ТекстУсловия;
			
		КонецЕсли;	
		
		
		ИндексПериода = ИндексПериода+1;
		
	КонецЦикла;
	
	ТекущиеПоля = Лев(ТекущиеПоля,СтрДлина(ТекущиеПоля)-1);
	
	Запрос.Текст = "ВЫБРАТЬ *
	|ПОМЕСТИТЬ ВтТаблицаРаскрытия
	|ИЗ 
	|&ТзРаскрытияПоказателей КАК ТзРаскрытияПоказателей
	|;";
	
	Запрос.Текст = Запрос.Текст+ТекстПодзапроса;
	Запрос.УстановитьПараметр("ТзРаскрытияПоказателей",ТзРаскрытияПоказателей);
	
	тзДанные = Запрос.Выполнить().Выгрузить();
	
	// Проверка на типизированные колонки с видами субконто
	МассивУдаляемыхКолонок = Новый Массив();
	Для Каждого Кол Из тзДанные.Колонки Цикл
		Если Кол.ТипЗначения.Типы().Количество()=0 ИЛИ (Кол.ТипЗначения.Типы().Количество()=1 И Кол.ТипЗначения.Типы()[0]= Тип("null")) Тогда
			МассивУдаляемыхКолонок.Добавить(Кол);
		КонецЕсли;	 	 	 
	КонецЦикла;	 
	
	Для Каждого УдКолонка Из МассивУдаляемыхКолонок Цикл
		ИмяКолонки = УдКолонка.Имя;
		тзДанные.Колонки.Удалить(УдКолонка);
		Если ИмяКолонки = "ЗначениеНечисловое" Тогда	 
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("Дата"));
			МассивТипов.Добавить(Тип("Строка"));
			КвалификаторыСтроки = Новый КвалификаторыСтроки(1000);
			МассивТипов.Добавить(Тип("Булево"));
			тзДанные.Колонки.Добавить(ИмяКолонки,Новый ОписаниеТипов(МассивТипов, , , ,КвалификаторыСтроки)); 
		Иначе	 
			тзДанные.Колонки.Добавить(ИмяКолонки,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконтоКорпоративные")); 
		КонецЕсли;
	КонецЦикла;	 
	
	Возврат тзДанные;
	
КонецФункции	

&НаСервере
//Функция ТранспонироватьТаблицуРаскрытияПоказателиПериодыВСтроки
//Преобразует таблицу на форме  с периодами и ресурсами в колонках 
//в таблицу с показателями где ресурсы называются Значение и ЗначениеВалюта. 
//Используется для записи лога в режиме отображения периодов в колонках
Функция ТранспонироватьТаблицуРаскрытияПоказателиПериодыВСтроки()
	
	ТзРаскрытияПоказателей 				= РеквизитФормыВЗначение("РаскрытиеПоказателей");						
	РаскрываемыеАналитики 				= ПолучитьИзВременногоХранилища(АдресСтруктураНезаполненныхАналитик);	
	МассивПериодов                      = ПолучитьИзВременногоХранилища(АдресТекущегоГоризонта);
	
	//Берем список периодов и делаем объединение c каждой колонкой периода	
	Запрос = Новый Запрос;
	
	ИндексПериода = 1;
	ИндексРесурса = 1;
	ТекстПодзапроса = "";
	
	Для Каждого Период Из МассивПериодов Цикл      //Цикл по периодам
		
		ТекущиеРесурсы = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ПериодОтчета,ЗначениеВалюта",Период,Ложь));
		ТекущиеПоляАналитики = "";
		ИндексРесурса  = 1;
		ТекущиеПоляРесурсы  = "";
		ТекстУсловия    = "";
			
		Для Каждого РаскрываемоеПоле Из РаскрываемыеАналитики Цикл
			Если РаскрываемоеПоле.Ключ = "ПериодОтчета" Тогда
				ТекущиеПоляАналитики = ТекущиеПоляАналитики+"
				|	&ПараметрПериод_"+ИндексПериода+" КАК ПериодОтчета,";
				
				Запрос.УстановитьПараметр("ПараметрПериод_"+ИндексПериода,Период);
				
			Иначе		
				ТекущиеПоляАналитики = ТекущиеПоляАналитики+"
				|	ВтТаблицаРаскрытия."+РаскрываемоеПоле.Ключ+" КАК "+РаскрываемоеПоле.Ключ+",";
			КонецЕсли;	
			
		КонецЦикла;	
			
		//Для записи лога изменений, показатель должен быть измерением.
		ИндексРесурсаЛокальный = 1;
		Для Каждого Ресурс Из ТекущиеРесурсы Цикл   //Цикл по ресурсам
			
			
			ТекущиеПоляРесурсы  = "";
			ТекстУсловия    = "";
			ИмяВЗапросеРесурсВалютный = РесурыПериодыВКолонках.НайтиСтроки(Новый Структура("ПоказательОтчета,ПериодОтчета,ЗначениеВалюта",Ресурс.ПоказательОтчета,Период,Истина))[0]; 
			
			Если Ресурс.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда	
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	ВтТаблицаРаскрытия."+ИмяВЗапросеРесурсВалютный.ИмяВЗапросе+" КАК ЗначениеВалюта,";
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" КАК Значение,";
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	НЕОПРЕДЕЛЕНО  КАК ЗначениеНечисловое,";
				
			Иначе
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	0 КАК ЗначениеВалюта,";
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	0 КАК Значение,";
				
				ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
				|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" КАК ЗначениеНечисловое,";
				
			КонецЕсли;
				
			Если Ресурс.ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				
				ТекстУсловия = ТекстУсловия+"
				|	ВтТаблицаРаскрытия."+Ресурс.ИмяВЗапросе+" <> 0";
				
			КонецЕсли;
			
			ТекущиеПоляРесурсы = ТекущиеПоляРесурсы+"
			|	&ПараметрПоказатель_"+ИндексРесурсаЛокальный+" КАК ПоказательОтчета";
			
			Если ИндексПериода>1 ИЛИ ИндексРесурса>1  Тогда 
				ТекстПодзапроса = ТекстПодзапроса+"
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|";
			КонецЕсли;	
			
			ТекстПодзапроса = ТекстПодзапроса+"
			|ВЫБРАТЬ"+ТекущиеПоляАналитики+ТекущиеПоляРесурсы+"
			|ИЗ 
			|	ВтТаблицаРаскрытия КАК ВтТаблицаРаскрытия";
			Если Не ПустаяСтрока(ТекстУсловия) Тогда
				ТекстПодзапроса = ТекстПодзапроса + "
				|ГДЕ
				|	"+ТекстУсловия;
			КонецЕсли;			
			
			Запрос.УстановитьПараметр("ПараметрПоказатель_"+ИндексРесурсаЛокальный,Ресурс.ПоказательОтчета);		
			
			ИндексРесурса = ИндексРесурса+1;
			ИндексРесурсаЛокальный = ИндексРесурсаЛокальный +1;
			
		КонецЦикла;
		
		ИндексПериода = ИндексПериода+1;
		
	КонецЦикла;
	
	ТекущиеПоля = Лев(ТекущиеПоля,СтрДлина(ТекущиеПоля)-1);
	
	Запрос.Текст = "ВЫБРАТЬ *
	|ПОМЕСТИТЬ ВтТаблицаРаскрытия
	|ИЗ 
	|	&ТзРаскрытияПоказателей КАК ТзРаскрытияПоказателей
	|;";
	
	Запрос.Текст = Запрос.Текст+ТекстПодзапроса;
	Запрос.УстановитьПараметр("ТзРаскрытияПоказателей",ТзРаскрытияПоказателей);
	
	тзДанные = Запрос.Выполнить().Выгрузить();
	
	// Проверка на типизированные колонки с видами субконто
	МассивУдаляемыхКолонок = Новый Массив();
	Для Каждого Кол Из тзДанные.Колонки Цикл
		Если Кол.ТипЗначения.Типы().Количество()=0 ИЛИ (Кол.ТипЗначения.Типы().Количество()=1 И Кол.ТипЗначения.Типы()[0]= Тип("null")) Тогда
			МассивУдаляемыхКолонок.Добавить(Кол);
		КонецЕсли;	 	 	 
	КонецЦикла;	 
	
	Для Каждого УдКолонка Из МассивУдаляемыхКолонок Цикл
		ИмяКолонки = УдКолонка.Имя;
		тзДанные.Колонки.Удалить(УдКолонка);
		Если ИмяКолонки = "ЗначениеНечисловое" Тогда	 
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("Дата"));
			МассивТипов.Добавить(Тип("Строка"));
			КвалификаторыСтроки = Новый КвалификаторыСтроки(1000);
			МассивТипов.Добавить(Тип("Булево"));
			тзДанные.Колонки.Добавить(ИмяКолонки,Новый ОписаниеТипов(МассивТипов, , , ,КвалификаторыСтроки)); 
		Иначе	 
			тзДанные.Колонки.Добавить(ИмяКолонки,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконтоКорпоративные")); 
		КонецЕсли;
	КонецЦикла;	 
	
	Возврат тзДанные;
	
КонецФункции	


