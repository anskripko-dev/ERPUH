	//		 СтрокаПериодаОстатка = ТзРасшифровокОбластей.НайтиСтроки(СтруктураПоиска);
	//		 Если СтрокаПериодаОстатка.Количество() = 1 Тогда
	//			 Для Каждого Ресурс Из ИменаОбластейРесурсов Цикл
	//				 СмещениеКолонки = СтруктураПараметров.СтруктураИменПолейСКД[Ресурс.Ключ];
	//				 ЗначениеОстатка  = МакетТаблиц.Область(СтрокаПериодаОстатка[0].ОтступИсходный,СмещениеКолонки,СтрокаПериодаОстатка[0].ОтступИсходный,СмещениеКолонки).Текст;
	
	//				 МакетТаблиц.Область(СтрРазметка.ОтступИсходный,СмещениеКолонки,СтрРазметка.ОтступИсходный,СмещениеКолонки).Текст = ЗначениеОстатка;
