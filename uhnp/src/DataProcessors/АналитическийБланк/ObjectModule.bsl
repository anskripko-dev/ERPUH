#КонецОбласти


Функция ПолучитьОбластьРаскрытия(тРаскрываемаяОбласть,СтруктураМакетаСтрок,СтруктураМакетаКолонок,МакетТаблиц)
	
	//Строки
	Если  тРаскрываемаяОбласть.ТипОбласти = "Строки" Тогда	
		
		Если НЕ СтруктураМакетаСтрок.Свойство(тРаскрываемаяОбласть.ИмяОбластиСтрок) Тогда
			 Возврат Неопределено;
		КонецЕсли;			
		тМакетСтрок = СтруктураМакетаСтрок[тРаскрываемаяОбласть.ИмяОбластиСтрок];
		НачалоY 	= 1;
		ОкончаниеY  = тМакетСтрок.ВысотаТаблицы;;
		ОкончаниеХ  = тМакетСтрок.ШиринаТаблицы;	 	
		ИтоговаяОбласть  = тМакетСтрок.ПолучитьОбласть(НачалоY,1,ОкончаниеY,ОкончаниеХ);	
		
	КонецЕсли;	
	//Колонки
	Если  тРаскрываемаяОбласть.ТипОбласти = "Колонки" Тогда	
		
		тМакетКолонок = СтруктураМакетаКолонок[тРаскрываемаяОбласть.ИмяОбластиКолонок];		
		НачалоY 	= 1;
		ОкончаниеY  = тМакетКолонок.ВысотаТаблицы;;
		ОкончаниеХ  = тМакетКолонок.ШиринаТаблицы;	 	
		ИтоговаяОбласть  = тМакетКолонок.ПолучитьОбласть(НачалоY,1,ОкончаниеY,ОкончаниеХ);	
		
	КонецЕсли;	
	
	Возврат ИтоговаяОбласть;
	
КонецФункции	

Функция ПодготовитьТаблицуПараметров()
	
	ТаблицаПараметров = Новый ТаблицаЗначений;
	ТаблицаПараметров.Колонки.Добавить("ИмяПараметра"		,ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255));
	ТаблицаПараметров.Колонки.Добавить("ЗначениеПараметра"	,);
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "Сценарий";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "ПериодОтчетаНачало";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект["ПериодОтчета"];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "ПериодОтчетаОкончание";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "Организация";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "Проект";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "Валюта";
	Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	
	Нстр 					= ТаблицаПараметров.Добавить();
	Нстр.ИмяПараметра 		= "ЕдиницаИзмерения";
	Нстр.ЗначениеПараметра 	= ВернутьПредставлениеЕдиницыИзмерения();
	
	Для Инд=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Нстр 					= ТаблицаПараметров.Добавить();
		Нстр.ИмяПараметра 		= "Аналитика"+Инд;
		Нстр.ЗначениеПараметра 	= ЭтотОбъект[Нстр.ИмяПараметра];
	КонецЦикла;
		
	ЗапросПоЗначениямПараметров = Новый Запрос("ВЫБРАТЬ
	|	МАКСИМУМ(ЗначенияПараметровОтчетов.Период) КАК Период,
	|	ЗначенияПараметровОтчетов.ВидОтчета КАК ВидОтчета,
	|	ЗначенияПараметровОтчетов.Организация КАК Организация,
	|	ЗначенияПараметровОтчетов.Сценарий КАК Сценарий,
	|	ЗначенияПараметровОтчетов.Проект КАК Проект,
	|	ЗначенияПараметровОтчетов.Аналитика1 КАК Аналитика1,
	|	ЗначенияПараметровОтчетов.Аналитика2 КАК Аналитика2,
	|	ЗначенияПараметровОтчетов.Аналитика3 КАК Аналитика3,
	|	ЗначенияПараметровОтчетов.Аналитика4 КАК Аналитика4,
	|	ЗначенияПараметровОтчетов.Аналитика5 КАК Аналитика5,
	|	ЗначенияПараметровОтчетов.Аналитика6 КАК Аналитика6,
	|	ЗначенияПараметровОтчетов.КодПараметра КАК КодПараметра
	|ПОМЕСТИТЬ ВТ_ЗначенияПараметровОтчетовСрезПоследних
	|ИЗ
	|	РегистрСведений.ЗначенияПараметровОтчетов КАК ЗначенияПараметровОтчетов
	|ГДЕ
	|	ЗначенияПараметровОтчетов.Период <= &ДатаНачала
	|	И ЗначенияПараметровОтчетов.ВидОтчета = &ВидОтчета
	|	И ЗначенияПараметровОтчетов.Организация = &Организация
	|	И ЗначенияПараметровОтчетов.Сценарий = &Сценарий
	|	И ЗначенияПараметровОтчетов.Проект = &Проект
	|	И ЗначенияПараметровОтчетов.Аналитика1 = &Аналитика1
	|	И ЗначенияПараметровОтчетов.Аналитика2 = &Аналитика2
	|	И ЗначенияПараметровОтчетов.Аналитика3 = &Аналитика3
	|	И ЗначенияПараметровОтчетов.Аналитика4 = &Аналитика4
	|	И ЗначенияПараметровОтчетов.Аналитика5 = &Аналитика5
	|	И ЗначенияПараметровОтчетов.Аналитика6 = &Аналитика6
	|	И ЗначенияПараметровОтчетов.КодПараметра В(&КодыПараметров)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗначенияПараметровОтчетов.ВидОтчета,
	|	ЗначенияПараметровОтчетов.Организация,
	|	ЗначенияПараметровОтчетов.Сценарий,
	|	ЗначенияПараметровОтчетов.Проект,
	|	ЗначенияПараметровОтчетов.Аналитика1,
	|	ЗначенияПараметровОтчетов.Аналитика2,
	|	ЗначенияПараметровОтчетов.Аналитика3,
	|	ЗначенияПараметровОтчетов.Аналитика4,
	|	ЗначенияПараметровОтчетов.Аналитика5,
	|	ЗначенияПараметровОтчетов.Аналитика6,
	|	ЗначенияПараметровОтчетов.КодПараметра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПараметровОтчетовСрезПоследних.КодПараметра КАК КодПараметра,
	|	ЗначенияПараметровОтчетов.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	ВТ_ЗначенияПараметровОтчетовСрезПоследних КАК ЗначенияПараметровОтчетовСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровОтчетов КАК ЗначенияПараметровОтчетов
	|		ПО ЗначенияПараметровОтчетовСрезПоследних.Период = ЗначенияПараметровОтчетов.Период
	|			И ЗначенияПараметровОтчетовСрезПоследних.ВидОтчета = ЗначенияПараметровОтчетов.ВидОтчета
	|			И ЗначенияПараметровОтчетовСрезПоследних.Организация = ЗначенияПараметровОтчетов.Организация
	|			И ЗначенияПараметровОтчетовСрезПоследних.Сценарий = ЗначенияПараметровОтчетов.Сценарий
	|			И ЗначенияПараметровОтчетовСрезПоследних.Проект = ЗначенияПараметровОтчетов.Проект
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика1 = ЗначенияПараметровОтчетов.Аналитика1
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика2 = ЗначенияПараметровОтчетов.Аналитика2
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика3 = ЗначенияПараметровОтчетов.Аналитика3
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика4 = ЗначенияПараметровОтчетов.Аналитика4
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика5 = ЗначенияПараметровОтчетов.Аналитика5
	|			И ЗначенияПараметровОтчетовСрезПоследних.Аналитика6 = ЗначенияПараметровОтчетов.Аналитика6
	|			И ЗначенияПараметровОтчетовСрезПоследних.КодПараметра = ЗначенияПараметровОтчетов.КодПараметра");
		
	ЗапросПоЗначениямПараметров.УстановитьПараметр("ДатаНачала", ЭтотОбъект["ПериодОтчета"].ДатаНачала);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("ВидОтчета", ЭтотОбъект.Бланк.Владелец);	
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Сценарий", ЭтотОбъект.Сценарий);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Проект", ЭтотОбъект.Проект);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика1", ЭтотОбъект.Аналитика1);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика2", ЭтотОбъект.Аналитика2);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика3", ЭтотОбъект.Аналитика3);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика4", ЭтотОбъект.Аналитика4);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика5", ЭтотОбъект.Аналитика5);
	ЗапросПоЗначениямПараметров.УстановитьПараметр("Аналитика6", ЭтотОбъект.Аналитика6);
	
	КодыПараметров = Новый Массив;
	Для Каждого ПараметрОтчета Из ЭтотОбъект.Бланк.Владелец.ПараметрыОтчета Цикл
		КодыПараметров.Добавить(ПараметрОтчета.Код);
	КонецЦикла;
	ЗапросПоЗначениямПараметров.УстановитьПараметр("КодыПараметров", КодыПараметров);
		
	ТаблицаЗначенийПараметровОтчетов = ЗапросПоЗначениямПараметров.Выполнить().Выгрузить();
	
	Для Каждого ПараметрОтчета Из ЭтотОбъект.Бланк.Владелец.ПараметрыОтчета Цикл
		ЗначениеПараметраОтчета = ТаблицаЗначенийПараметровОтчетов.Найти(ПараметрОтчета.Код, "КодПараметра");
		Если ЗначениеПараметраОтчета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Нстр 					= ТаблицаПараметров.Добавить();
		Нстр.ИмяПараметра 		= ЗначениеПараметраОтчета.КодПараметра;
		Нстр.ЗначениеПараметра 	= ЗначениеПараметраОтчета.ЗначениеПараметра;
	КонецЦикла;
		
	Возврат ТаблицаПараметров;
	
КонецФункции	

Функция ВернутьПредставлениеЕдиницыИзмерения()

   Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1 Тогда
	    Возврат "единицы";
   ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
	  	Возврат "тысячи"; 
   ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 тогда	   
	    Возврат "миллионы";
   КонецЕсли;

КонецФункции	

Функция ОбработатьСтрокуШаблонаЗаголовкаПараметра(ИсходнаяСтрока,ДоступныеПоля)
	
	Параметры = Новый Структура;
	Для Каждого Стр Из ДоступныеПоля Цикл
		Параметры.Вставить(Стр.ИмяПараметра,Стр.ЗначениеПараметра);
	КонецЦикла;	
		
	ТзВозврата = Новый ТаблицаЗначений;
	ТзВозврата.Колонки.Добавить("ТекстОбласти");
	ТзВозврата.Колонки.Добавить("ТипОбласти");
	ТзВозврата.Колонки.Добавить("ЗначениеПараметра");
	
	Пока СтрНайти(ИсходнаяСтрока,"Параметры.")>0 Цикл		
		
		ПозицияНачалаПараметра 			= СтрНайти(ИсходнаяСтрока,"["); 
		ПозицияОкончанияПараметра       = ?(СтрНайти(ИсходнаяСтрока,"]")=0,СтрДлина(ИсходнаяСтрока),СтрНайти(ИсходнаяСтрока,"]")); 
		ТекстДоПараметра                = Лев(ИсходнаяСтрока,ПозицияНачалаПараметра-1);
		Параметр 						= Сред(ИсходнаяСтрока,ПозицияНачалаПараметра+1,ПозицияОкончанияПараметра-ПозицияНачалаПараметра-1);		
				
		нСтрока = ТзВозврата.Добавить();
		нСтрока.ТекстОбласти = ТекстДоПараметра;
		нСтрока.ТипОбласти = "Строка";
		
		ПараметрТочка 	= СтрНайти(Параметр,".");	
		ПараметрДоТочки 			= ?(ПараметрТочка=0,Параметр,Лев(Параметр,ПараметрТочка-1));
		ПарамтерПослеТочки          = ?(ПараметрТочка=0,"Ссылка",Сред(Параметр,ПараметрТочка+1,СтрДлина(Параметр)-ПараметрТочка+1));
		
		нСтрока = ТзВозврата.Добавить();
		нСтрока.ТекстОбласти	= Параметр;
		нСтрока.ТипОбласти 		= "Параметр";
		
		Попытка                                             						
			нСтрока.ЗначениеПараметра = Вычислить(Параметр);		
		Исключение
			нСтрока.ЗначениеПараметра	    = "#ОшибкаВычисленияВыражения";
		КонецПопытки;	
		
		ИсходнаяСтрока =  Прав(ИсходнаяСтрока,СтрДлина(ИсходнаяСтрока)-ПозицияОкончанияПараметра);	
		
	КонецЦикла;	
	
	нСтрока = ТзВозврата.Добавить();
	нСтрока.ТекстОбласти = ИсходнаяСтрока;
	нСтрока.ТипОбласти = "Строка";
		
	Возврат ТзВозврата;
	
КонецФункции	

Процедура СформироватьОтборПоПериодам(ЗапросСинтетика,УидГруппыОтборов,ИмяПараметра,ЭтоОтборТаблицы = Ложь)
	 
	ОтборС  		=  РасшифровкаГруппОтборов.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",(УидГруппыОтборов),"ПериодС"));
	ОтборПо  		=  РасшифровкаГруппОтборов.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",(УидГруппыОтборов),"ПериодПо"));	
	
	Если ОтборС.Количество() = 0 Тогда
		ОтборС  		=  НастройкиТаблицРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",УидГруппыОтборов,"ПериодС"));
		ОтборПо  		=  НастройкиТаблицРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",УидГруппыОтборов,"ПериодПо"));
	КонецЕсли;
	
	Если ОтборС.Количество() = 0 Тогда	
		ОтборС  		=  НастройкиРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",УидГруппыОтборов,"ПериодС"));          
		ОтборПо  		=  НастройкиРаскрываемыхОбластей.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод",УидГруппыОтборов,"ПериодПо"));
	КонецЕсли;
		
	
	Если ОтборС.Количество() = 0 Тогда
	Иначе	
		ОтборС = ОтборС[0];
	КонецЕсли;		
	Если ОтборПо.Количество() = 0 Тогда
		
	Иначе	
		ОтборПо = ОтборПо[0];
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(ТзКэшПериодовАдрес) Тогда
		ТзКэшПериодов = Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыКэшаПериодов();
	Иначе	  
		ТзКэшПериодов = ПолучитьИзВременногоХранилища(ТзКэшПериодовАдрес);
	КонецЕсли;	  
	
	СуществующийОтборПоПериоду = ТзКэшПериодов.НайтиСтроки(Новый Структура("ПериодСОтбор,ПериодС,ПериодПоОтбор,ПериодПо",ОтборС.Отбор,Строка(ОтборС.ЗначениеОтбора),ОтборПо.Отбор,Строка(ОтборПо.ЗначениеОтбора)));
	 	
	Если СуществующийОтборПоПериоду.Количество() = 0 Тогда		
		Если ОтборС.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаОтчета Тогда
			тПериодС  = ПериодОтчета;
		ИначеЕсли ОтборС.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета Тогда
			тПериодС  = ПериодОтчетаОкончание;
		ИначеЕсли ОтборС.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаСоСдвигом Тогда
			тПериодС  = АналитическийБланкУХСервер.ПолучитьПериодПоСдвигу(ПериодОтчета.ДатаНачала,ОтборС,Периодичность);
		ИначеЕсли ОтборС.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияСоСдвигом Тогда
			тПериодС  = АналитическийБланкУХСервер.ПолучитьПериодПоСдвигу(ПериодОтчетаОкончание.ДатаНачала,ОтборС,Периодичность);
		Иначе	
			тПериодС  = ЗначениеИзСтрокиВнутр(ОтборС.ЗначениеОтбораСтрока);;
		КонецЕсли;		
		Если ОтборПо.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаОтчета Тогда
			тПериодПо  = ПериодОтчета;
		ИначеЕсли ОтборПо.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета Тогда
			тПериодПо  = ПериодОтчетаОкончание;
		ИначеЕсли ОтборПо.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаСоСдвигом Тогда
			тПериодПо  = АналитическийБланкУХСервер.ПолучитьПериодПоСдвигу(ПериодОтчета.ДатаНачала,ОтборПо,Периодичность);
		ИначеЕсли ОтборПо.Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияСоСдвигом Тогда
			тПериодПо  = АналитическийБланкУХСервер.ПолучитьПериодПоСдвигу(ПериодОтчетаОкончание.ДатаНачала,ОтборПо,Периодичность);
		Иначе	                                                                                                                
			тПериодПо  = ЗначениеИзСтрокиВнутр(ОтборПо.ЗначениеОтбораСтрока);
		КонецЕсли;
		
		тПериоды 				=  ПериодыУХ.ПолучитьПодчиненныеПериоды(тПериодС,тПериодПо,Периодичность);
		нСтрокаКэш      		=  ТзКэшПериодов.Добавить();
		нСтрокаКэш.ПериодС      =  Строка(ОтборС.ЗначениеОтбора);
		нСтрокаКэш.ПериодПо     =  Строка(ОтборПо.ЗначениеОтбора);
		нСтрокаКэш.ПериодСОтбор =  ОтборС.Отбор;
		нСтрокаКэш.ПериодПоОтбор=  ОтборПо.Отбор;

		нСтрокаКэш.Периоды      =  тПериоды;	
	Иначе		
		тПериоды = СуществующийОтборПоПериоду[0].Периоды;	
	КонецЕсли;	
		
	ЗапросСинтетика.УстановитьПараметр(ИмяПараметра,тПериоды);	
	ТзКэшПериодовАдрес = ПоместитьВоВременноеХранилище(ТзКэшПериодов,Новый УникальныйИдентификатор);
	
КонецПроцедуры

