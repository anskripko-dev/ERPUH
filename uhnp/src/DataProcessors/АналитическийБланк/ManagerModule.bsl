Функция ПолучитьИмяОбластиПоСтруктуреАналитик(СтруктураАналитик,ПолеТабличногоДокументаМакет)
	
	СтрИмениОбласти = "";
	Для Каждого СтрАналитика Из СтруктураАналитик Цикл
		СтрИмениОбластиЭталон = "Раскрытие_"+ОбщегоНазначенияУх.ВернутьАлфавитноЦифровоеПредставление(СтрАналитика.АналитикаПредставление)+"_";
	КонецЦикла;
	
	ИндексОбласти = 1;
	СтрИмениОбласти = СтрИмениОбластиЭталон;
	
	Пока НЕ ПолеТабличногоДокументаМакет.Области.Найти(СтрИмениОбласти) = Неопределено Цикл
		СтрИмениОбласти = СтрИмениОбластиЭталон+ИндексОбласти;
		ИндексОбласти = ИндексОбласти+1;
	КонецЦикла;	
	
	Возврат СтрИмениОбласти;
	
КонецФункции	

Процедура СконверироватьАналитикиБланка(БланкВход) Экспорт

	Если БланкВход.РежимБланка = 1 Тогда  //Сводная таблица
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВариантыСводныхТаблиц.Бланк КАК Бланк,
		|	ВариантыСводныхТаблиц.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВариантыСводныхТаблиц КАК ВариантыСводныхТаблиц
		|ГДЕ
		|	ВариантыСводныхТаблиц.ПометкаУдаления = ЛОЖЬ
		|	И ВариантыСводныхТаблиц.Бланк = &Бланк";
		
		Запрос.УстановитьПараметр("Бланк",БланкВход);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Попытка
				СконвертироватьСтруктуруАналитикБланков(Выборка.Ссылка);
			Исключение	 
				
				ТекстСообщения = НСтр("ru = 'При конвертации отборов бланка %Бланк% произошла ошибка
				|			%ОписаниеОшибки%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Бланк%", Строка(Выборка.Ссылка));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", Строка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.БланкиОтчетов,
				Выборка.Ссылка, 
				ТекстСообщения);
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);	
								
			КонецПопытки;	 
			
		КонецЦикла;			
		
	ИначеЕсли БланкВход.РежимБланка = 2 Тогда  //Бланк экземпляра
		
		Попытка
			
			СконвертироватьСтруктуруАналитикБланков(БланкВход);		
			
		Исключение	 
			
			ТекстСообщения = НСтр("ru = 'При конвертации отборов бланка %Бланк% произошла ошибка
			|			%ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Бланк%", Строка(БланкВход));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", Строка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.БланкиОтчетов,
			БланкВход, 
			ТекстСообщения);
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);	
			
		КонецПопытки;	 
			
	КонецЕсли;	


КонецПроцедуры	

Процедура СконвертироватьСтруктуруАналитикБланков(ВариантНастройки)
	
		
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	ПолеТабличногоДокументаКопия    = Новый ТабличныйДокумент;
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	//ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантНастройки);
	текНаборЗаписей.Прочитать();
	Если  текНаборЗаписей.Количество() =1 Тогда			
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();	
		Если  ЗначениеСохраняемойНастройки.Свойство("ТабДокМакет") Тогда		
			ПолеТабличногоДокументаМакет.Вывести(ЗначениеСохраняемойНастройки.ТабДокМакет);
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСверху") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСверху = ЗначениеСохраняемойНастройки.ФиксацияСверху;
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСлева") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСлева = ЗначениеСохраняемойНастройки.ФиксацияСлева;
		КонецЕсли;	
	КонецЕсли;	

	ПолеТабличногоДокументаКопия.Вывести(ПолеТабличногоДокументаМакет);
	
	Для Каждого СтрОбласть Из ПолеТабличногоДокументаМакет.Области Цикл
		
		Если 	СтрОбласть.Лево = 0 И НЕ СтрОбласть.Имя = "ОбластьНастроекРаскрытийКолонок" Тогда   //Раскрытия строк
			
			ОбластьНастроек   = ПолеТабличногоДокументаМакет.Область(СтрОбласть.Верх,1,СтрОбласть.Верх,1);
			Если ТипЗнч(ОбластьНастроек.Расшифровка) = Тип("Структура") И ОбластьНастроек.Расшифровка.Свойство("НастройкиАналитикРаскрытия") Тогда
				тРасшифровка = ОбластьНастроек.Расшифровка;
				ТекущиеНастройкиАналитикРаскрытия      = ЗначениеИзСтрокиВнутр(ОбластьНастроек.Расшифровка.НастройкиАналитикРаскрытия);
				
				НастройкиАналитикРаскрытия 		= Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыНастроекАналитик();
				Для Каждого Стр Из ТекущиеНастройкиАналитикРаскрытия Цикл
					НовНастройка = НастройкиАналитикРаскрытия.Добавить(); 
					ЗаполнитьЗначенияСвойств(НовНастройка,Стр);
				КонецЦикла;	
				
				ОбластьНастроек.Расшифровка.НастройкиАналитикРаскрытия = ЗначениеВСтрокуВнутр(НастройкиАналитикРаскрытия);
			Иначе
				Продолжить;
			КонецЕсли;
					
		ИначеЕсли 	СтрОбласть.Верх = 0 И НЕ СтрОбласть.Имя = "ОбластьНастроекРаскрытийСтрок" Тогда	  //Раскрытия колонок
			
			ОбластьНастроек   = ПолеТабличногоДокументаМакет.Область(1,СтрОбласть.Лево,1,СтрОбласть.Лево);
			Если ТипЗнч(ОбластьНастроек.Расшифровка) = Тип("Структура") И ОбластьНастроек.Расшифровка.Свойство("НастройкиАналитикРаскрытия") Тогда
				тРасшифровка = ОбластьНастроек.Расшифровка;
				ТекущиеНастройкиАналитикРаскрытия    = ЗначениеИзСтрокиВнутр(ОбластьНастроек.Расшифровка.НастройкиАналитикРаскрытия);
				
				НастройкиАналитикРаскрытия 		= Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыНастроекАналитик();
				Для Каждого Стр Из ТекущиеНастройкиАналитикРаскрытия Цикл
					НовНастройка = НастройкиАналитикРаскрытия.Добавить(); 
					ЗаполнитьЗначенияСвойств(НовНастройка,Стр);
				КонецЦикла;				
				
				ОбластьНастроек.Расшифровка.НастройкиАналитикРаскрытия = ЗначениеВСтрокуВнутр(НастройкиАналитикРаскрытия);
				
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
				
	КонецЦикла;
	
	ЗначениеСохраняемойНастройки.ТабДокМакет = ПолеТабличногоДокументаМакет;
	ЗначениеСохраняемойНастройки.Вставить("ТабДокМакетКопия",ПолеТабличногоДокументаКопия);
	
	//Перезапишем макет
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантНастройки);
	текНаборЗаписей.Очистить();
	нЗапись  									= текНаборЗаписей.Добавить();
	нЗапись.Бланк								= ВариантНастройки;
	нЗапись.ХранилищеДополнительныхНастроек 	= Новый ХранилищеЗначения(ЗначениеСохраняемойНастройки);
    текНаборЗаписей.Записать(Истина);
	
	//Перезапишем все кэши
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	Обработки.АналитическийБланк.ПрочитатьНастройкиАналитическогоБланка(ПолеТабличногоДокументаМакет,ВариантНастройки,ОбъектАБ);	
	ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	Отказ = Ложь;				
	Уид   = Новый УникальныйИдентификатор;
	Справочники.БланкиОтчетов.СохранитьМакетМногопериодногоБланка(ВариантНастройки,ПолеТабличногоДокументаМакет,ОбъектАБ,Уид,Отказ);
	

		
КонецПроцедуры


Процедура ПерезаписатьБланки(БланкВход) Экспорт

	Если БланкВход.РежимБланка = 1 Тогда  //Сводная таблица
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВариантыСводныхТаблиц.Бланк КАК Бланк,
		|	ВариантыСводныхТаблиц.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВариантыСводныхТаблиц КАК ВариантыСводныхТаблиц
		|ГДЕ
		|	ВариантыСводныхТаблиц.ПометкаУдаления = ЛОЖЬ
		|	И ВариантыСводныхТаблиц.Бланк = &Бланк";
		
		Запрос.УстановитьПараметр("Бланк",БланкВход);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Попытка
				ПерезаписатьМакетыБланков(Выборка.Ссылка);
			Исключение	 
				
				ТекстСообщения = НСтр("ru = 'При конвертации отборов бланка %Бланк% произошла ошибка
				|			%ОписаниеОшибки%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Бланк%", Строка(Выборка.Ссылка));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", Строка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.БланкиОтчетов,
				Выборка.Ссылка, 
				ТекстСообщения);
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);	
								
			КонецПопытки;	 
			
		КонецЦикла;			
		
	ИначеЕсли БланкВход.РежимБланка = 2 Тогда  //Бланк экземпляра
		
		Попытка
			
			ПерезаписатьМакетыБланков(БланкВход);		
			
		Исключение	 
			
			ТекстСообщения = НСтр("ru = 'При конвертации отборов бланка %Бланк% произошла ошибка
			|			%ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Бланк%", Строка(БланкВход));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", Строка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.БланкиОтчетов,
			БланкВход, 
			ТекстСообщения);
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);	
			
		КонецПопытки;	 
			
	КонецЕсли;	


КонецПроцедуры	

Процедура ПерезаписатьМакетыБланков(ВариантНастройки)
		
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	ПолеТабличногоДокументаКопия    = Новый ТабличныйДокумент;
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	//ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
		
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантНастройки);
	текНаборЗаписей.Прочитать();
	Если  текНаборЗаписей.Количество() =1 Тогда			
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();	
		Если  ЗначениеСохраняемойНастройки.Свойство("ТабДокМакет") Тогда		
			ПолеТабличногоДокументаМакет.Вывести(ЗначениеСохраняемойНастройки.ТабДокМакет);
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСверху") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСверху = ЗначениеСохраняемойНастройки.ФиксацияСверху;
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСлева") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСлева = ЗначениеСохраняемойНастройки.ФиксацияСлева;
		КонецЕсли;	
	Иначе	
		Возврат;
	КонецЕсли;	

	ПолеТабличногоДокументаКопия.Вывести(ПолеТабличногоДокументаМакет);
		
	ЗначениеСохраняемойНастройки.ТабДокМакет = ПолеТабличногоДокументаМакет;
	ЗначениеСохраняемойНастройки.Вставить("ТабДокМакетКопия",ПолеТабличногоДокументаКопия);
	
	//Перезапишем макет
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантНастройки);
	текНаборЗаписей.Очистить();
	нЗапись  									= текНаборЗаписей.Добавить();
	нЗапись.Бланк								= ВариантНастройки;
	нЗапись.ХранилищеДополнительныхНастроек 	= Новый ХранилищеЗначения(ЗначениеСохраняемойНастройки);
    текНаборЗаписей.Записать(Истина);
	
	//Перезапишем все кэши
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	Обработки.АналитическийБланк.ПрочитатьНастройкиАналитическогоБланка(ПолеТабличногоДокументаМакет,ВариантНастройки,ОбъектАБ);	
	ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	// Если копирование - заменить показатели
	Для Каждого СтрОбласть Из ПолеТабличногоДокументаМакет.Области Цикл
		
		ВидОтчета = Неопределено;
		Если ТипЗнч(ВариантНастройки) = Тип("СправочникСсылка.БланкиОтчетов") Тогда
			ВидОтчета = ВариантНастройки.Владелец;
		ИначеЕсли ТипЗнч(ВариантНастройки) = Тип("СправочникСсылка.ВариантыСводныхТаблиц") Тогда
			ВидОтчета = ВариантНастройки.Бланк.Владелец;
		КонецЕсли;
			
		Если СтрОбласть.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник 
			И  ТипЗнч(СтрОбласть.Расшифровка) = Тип("Структура")
			И СтрОбласть.Расшифровка.Свойство("Ссылка")
			И ЗначениеЗаполнено(ВидОтчета) Тогда
			
			Если ТипЗнч(СтрОбласть.Расшифровка.Ссылка) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
				НовыйПоказатель = Справочники.ПоказателиОтчетов.НайтиПоКоду(СтрОбласть.Расшифровка.Ссылка.Код,,, ВидОтчета);
				Если ЗначениеЗаполнено(НовыйПоказатель) И (СтрОбласть.Расшифровка.Ссылка <> НовыйПоказатель) Тогда
					СтарыйКодВладельца = СокрЛП(СтрОбласть.Расшифровка.Ссылка.Владелец.Код);
					НовыйКодВладельца = СокрЛП(НовыйПоказатель.Владелец.Код);
					
					СтрОбласть.Имя = СтрЗаменить(СтрОбласть.Имя, СтарыйКодВладельца, НовыйКодВладельца);
					СтрОбласть.Текст = СтрЗаменить(СтрОбласть.Текст, СтарыйКодВладельца, НовыйКодВладельца);
					СтрОбласть.Расшифровка.Вставить("Ссылка", НовыйПоказатель);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
	Отказ = Ложь;				
	Уид   = Новый УникальныйИдентификатор;
	Справочники.БланкиОтчетов.СохранитьМакетМногопериодногоБланка(ВариантНастройки,ПолеТабличногоДокументаМакет,ОбъектАБ,Уид,Отказ);
		
КонецПроцедуры

//При переходе на версию 3.2.4.34 + поменялся интерфейс настройки бланков ЭО
//Необходимо отрисовать новые служебные области управления раскрытиями
Процедура СконверироватьМакетБланка(БланкВход) Экспорт

	Если БланкВход.РежимБланка = 2 Тогда  //Бланк экземпляра
		
		Попытка
			
			СконвертироватьМакетРазработкиБланкаЭО(БланкВход);		
			
		Исключение	 
			
			ТекстСообщения = НСтр("ru = 'При конвертации отборов бланка %Бланк% произошла ошибка
			|			%ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Бланк%", Строка(БланкВход));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", Строка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.БланкиОтчетов,
			БланкВход, 
			ТекстСообщения);
			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);	
			
		КонецПопытки;	 
			
	КонецЕсли;	


КонецПроцедуры	

Процедура СконвертироватьМакетРазработкиБланкаЭО(БланкВход) Экспорт
	
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	ПолеТабличногоДокументаКопия    = Новый ТабличныйДокумент;
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	//ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(БланкВход);
	текНаборЗаписей.Прочитать();
	Если  текНаборЗаписей.Количество() =1 Тогда			
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();	
		Если  ЗначениеСохраняемойНастройки.Свойство("ТабДокМакет") Тогда		
			ПолеТабличногоДокументаМакет.Вывести(ЗначениеСохраняемойНастройки.ТабДокМакет);
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСверху") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСверху = ЗначениеСохраняемойНастройки.ФиксацияСверху;
		КонецЕсли;
		Если  ЗначениеСохраняемойНастройки.Свойство("ФиксацияСлева") Тогда		
			ПолеТабличногоДокументаМакет.ФиксацияСлева = ЗначениеСохраняемойНастройки.ФиксацияСлева;
		КонецЕсли;	
	КонецЕсли;	
	
	ПолеТабличногоДокументаКопия.Вывести(ПолеТабличногоДокументаМакет);

	ПроверитьНаличиеСлужебныхОбластейРасширенный(ПолеТабличногоДокументаМакет);
	
	ЗначениеСохраняемойНастройки.Вставить("ТабДокМакетКопия",ПолеТабличногоДокументаКопия);
	ЗначениеСохраняемойНастройки.Вставить("ТабДокМакет",ПолеТабличногоДокументаМакет);
	ЗначениеСохраняемойНастройки.Вставить("ФиксацияСлева",ПолеТабличногоДокументаМакет.ФиксацияСлева);
    ЗначениеСохраняемойНастройки.Вставить("ФиксацияСверху",ПолеТабличногоДокументаМакет.ФиксацияСверху);

	
	//Перезапишем макет
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(БланкВход);
	текНаборЗаписей.Очистить();
	нЗапись  									= текНаборЗаписей.Добавить();
	нЗапись.Бланк								= БланкВход;
	нЗапись.ХранилищеДополнительныхНастроек 	= Новый ХранилищеЗначения(ЗначениеСохраняемойНастройки);
    текНаборЗаписей.Записать(Истина);
	
	//Перезапишем все кэши
	ПолеТабличногоДокументаМакет 	= Новый ТабличныйДокумент;
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	Обработки.АналитическийБланк.ПрочитатьНастройкиАналитическогоБланка(ПолеТабличногоДокументаМакет,БланкВход,ОбъектАБ);	
	ПодготовитьКэшСГруппировками(ПолеТабличногоДокументаМакет,ОбъектАБ);
	
	Отказ = Ложь;				
	Уид   = Новый УникальныйИдентификатор;
	Справочники.БланкиОтчетов.СохранитьМакетМногопериодногоБланка(БланкВход,ПолеТабличногоДокументаМакет,ОбъектАБ,Уид,Отказ);

	
КонецПроцедуры	

Процедура ПроверитьНаличиеСлужебныхОбластейРасширенный(ПолеТабличногоДокументаМакет) Экспорт
	
	//Получили таблицы служебных областей по макету, состоящему из одной области строки и колонок
	СтруктураГруппировок 				  = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьСтруктуруГруппировокМакета(ПолеТабличногоДокументаМакет);
		
	МаксимальныйУровеньГруппировкиСтрок 	= СтруктураГруппировок.МаксимальныйУровеньГруппировкиСтрок;
	МаксимальныйУровеньГруппировкиКолонок   = СтруктураГруппировок.МаксимальныйУровеньГруппировкиКолонок;
			
	//Удалили "старые" области
	Обработки.АналитическийБланк.УдалитьСлужебныеОбласти(ПолеТабличногоДокументаМакет); //удалим служебные области...
		
	//Нарисовали новые области.
	УстановитьСлужебныеОбласти(ПолеТабличногоДокументаМакет,СтруктураГруппировок);
	
	//Таблицы координат служебных макетов нужно обновить по новым координатам
	ДельтаПоСтрокам = МаксимальныйУровеньГруппировкиСтрок-1;
	Если ДельтаПоСтрокам>0 Тогда	
		Для Каждого Строка Из СтруктураГруппировок.ТаблицаРаскрываемыхОбластейКолонок Цикл		
			Строка.Лево = Строка.Лево+ДельтаПоСтрокам;
			Строка.Право = Строка.Право+ДельтаПоСтрокам;		
		КонецЦикла;			
	КонецЕсли;	
	
	ДельтаПоКолонкам = МаксимальныйУровеньГруппировкиКолонок-1;
	Если ДельтаПоКолонкам>0 Тогда	
		Для Каждого Строка Из СтруктураГруппировок.ТаблицаРаскрываемыхОбластейСтрок Цикл		
			Строка.Верх = Строка.Верх+ДельтаПоКолонкам;
			Строка.Низ = Строка.Низ+ДельтаПоКолонкам;		
		КонецЦикла;			
	КонецЕсли;	
	
	//Скорректируем зафиксированную область
	ПолеТабличногоДокументаМакет.ФиксацияСлева 	= ПолеТабличногоДокументаМакет.ФиксацияСлева+ДельтаПоСтрокам;
	ПолеТабличногоДокументаМакет.ФиксацияСверху = ПолеТабличногоДокументаМакет.ФиксацияСверху+ДельтаПоКолонкам;
		
	НарисоватьОбластиРаскрытияСтрок(СтруктураГруппировок,ПолеТабличногоДокументаМакет,МаксимальныйУровеньГруппировкиСтрок);
	
	НарисоватьОбластиРаскрытияКолонок(СтруктураГруппировок,ПолеТабличногоДокументаМакет,МаксимальныйУровеньГруппировкиКолонок);	
	  	
КонецПроцедуры

Процедура УстановитьСлужебныеОбласти(ПолеТабличногоДокументаМакет,СтруктураГруппировок)
	
	МакетСлужебныхОбластей = Справочники.БланкиОтчетов.ПолучитьМакет("ШаблонСлужебныхОбластей");
	
	ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийКолонок");
	
	Для ИндексОбласти = 1 По СтруктураГруппировок.МаксимальныйУровеньГруппировкиКолонок Цикл
		ОбластьПриемник = ПолеТабличногоДокументаМакет.Область(ИндексОбласти,0,ИндексОбласти,0);
		ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЦикла;	
	
	
	ПолеТабличногоДокументаМакет.Область(СтруктураГруппировок.МаксимальныйУровеньГруппировкиКолонок,0,СтруктураГруппировок.МаксимальныйУровеньГруппировкиКолонок,1).Имя = "ОбластьНастроекРаскрытийКолонок";
	ПолеТабличногоДокументаМакет.Область(1,0,СтруктураГруппировок.МаксимальныйУровеньГруппировкиКолонок,1).Имя = "ОбластьНастроекРаскрытийКолонок";
	
	
	ОбластьИсточник = МакетСлужебныхОбластей.Область("ОбластьНастроекРаскрытийСтрок");
	
	Для ИндексОбласти = 1 По СтруктураГруппировок.МаксимальныйУровеньГруппировкиСтрок Цикл
		ОбластьПриемник = ПолеТабличногоДокументаМакет.Область(0,ИндексОбласти,0,ИндексОбласти);
		ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЦикла;	
	
	
	ПолеТабличногоДокументаМакет.Область(0,СтруктураГруппировок.МаксимальныйУровеньГруппировкиСтрок,0,СтруктураГруппировок.МаксимальныйУровеньГруппировкиСтрок).Имя = "";
	ПолеТабличногоДокументаМакет.Область(0,1,0,СтруктураГруппировок.МаксимальныйУровеньГруппировкиСтрок).Имя = "ОбластьНастроекРаскрытийСтрок";
	
КонецПроцедуры	

Процедура НарисоватьОбластиРаскрытияСтрок(СтруктураГруппировок,ПолеТабличногоДокументаМакет,МаксимальныйУровеньГруппировкиСтрок) 
	
	КартинкаОбластиИзмерения = БиблиотекаКартинок.МетаданныеИзмерения;
	КартинкаОбластиПериоды   = БиблиотекаКартинок.СводнаяТаблицаПериоды;
	
    ИмяОбластиГруппы = "";
	
	ЦветУзораЗаголовкаГруппировки                  	= Новый Цвет(255,255,255);
	ЦветУзораСлужебнойОбласти                  		= Новый Цвет(192,192,192);
	ЦветРамки                   					= Новый Цвет(125,125,125);
	
	ГраницаОбластиРаскрытия 	= Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	
	Для Каждого СтрокаРаскрытия Из СтруктураГруппировок.ТаблицаРаскрываемыхОбластейСтрок Цикл
		
				
		ОбластьРаскрытия 			= ПолеТабличногоДокументаМакет.Область(СтрокаРаскрытия.ИмяОбласти);
		ЗаголовокОбластиРаскрытия  	= Справочники.БланкиОтчетов.ПолучитьЗаголовокОбластиРаскрытия(СтрокаРаскрытия.Расшифровка);
					
		ОбластьЗаголовка            = ПолеТабличногоДокументаМакет.Область(ОбластьРаскрытия.Верх,СтрокаРаскрытия.УровеньГруппировки,ОбластьРаскрытия.Верх,СтрокаРаскрытия.УровеньГруппировки);
		ОбластьЗаголовкаВсеЯчейки    =  ПолеТабличногоДокументаМакет.Область(
			  ОбластьРаскрытия.Верх
			 ,СтрокаРаскрытия.УровеньГруппировки
			 ,ОбластьРаскрытия.Верх+СтрокаРаскрытия.ВысотаМакета-1
			 ,МаксимальныйУровеньГруппировкиСтрок);
		
		//Установим свойства области заголовка по-умолчанию	
		Для ИндСтроки = ОбластьЗаголовкаВсеЯчейки.Верх По ОбластьЗаголовкаВсеЯчейки.Низ  Цикл 
			Для ИндКолонки = 1 По ОбластьЗаголовкаВсеЯчейки.Право  Цикл 
                ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Картинка = Неопределено;
				ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Текст = "";
				ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Узор = ТипУзораТабличногоДокумента.Узор3;
                ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).ЦветУзора = ЦветУзораСлужебнойОбласти;

			КонецЦикла;	
		КонецЦикла;	
	 
			 			 
		//Выведем линии области
		//Если НЕ СтрокаРаскрытия.ИмяОбластиГруппы = ИмяОбластиГруппы Тогда
			 ИмяОбластиГруппы 		= СтрокаРаскрытия.ИмяОбластиГруппы;

			 ОбластьЗаголовкаВсеЯчейки.ГраницаСверху 	= ГраницаОбластиРаскрытия; 
			 ОбластьЗаголовкаВсеЯчейки.ГраницаСнизу	 	= ГраницаОбластиРаскрытия; 
			 ОбластьЗаголовкаВсеЯчейки.ГраницаСлева	 	= ГраницаОбластиРаскрытия; 
		 
			 ОбластьЗаголовкаВсеЯчейки.ЦветРамки = ЦветРамки;	 
			 ОбластьЗаголовкаВсеЯчейки.ЦветУзора = ЦветУзораЗаголовкаГруппировки;		 
		//КонецЕсли;
		
					
		//Установим картинку строк 
		Если НЕ СтрокаРаскрытия.Расшифровка.НастройкиАналитикРаскрытия.Найти("ПериодОтчета","АналитикаКод") = Неопределено Тогда	
			ОбластьЗаголовка.Картинка =  КартинкаОбластиПериоды;		 
		Иначе	 	 
			ОбластьЗаголовка.Картинка =  КартинкаОбластиИзмерения;
		КонецЕсли;	
		ОбластьЗаголовка.РазмерКартинки 				 = РазмерКартинки.РеальныйРазмер;
		ОбластьЗаголовка.ВертикальноеПоложениеКартинки 	 = ВертикальноеПоложение.Верх;
		ОбластьЗаголовка.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Лево;
		
		//Выведем заголовок области
		ОбластьЗаголовка.Текст 					=  ЗаголовокОбластиРаскрытия;
		ОбластьЗаголовка.ВертикальноеПоложение 	= ВертикальноеПоложение.Верх;
		ОбластьЗаголовка.Отступ                 = 0;
		
		//Установим расшифровку
		 ПолеТабличногоДокументаМакет.Область(ОбластьРаскрытия.Верх,1,ОбластьРаскрытия.Верх,1).Расшифровка = СтрокаРаскрытия.РасшифровкаИсходная;
		
		//Объединим область
		ОбластьЗаголовкаВсеЯчейки.Объединить();
		
		
	КонецЦикла;	

	//Установим ширину колонок технической области
	ШиринаПоследнейКолонки = 18;
	Для ИндексКолонки = 1 По МаксимальныйУровеньГруппировкиСтрок-1 Цикл		
		ПолеТабличногоДокументаМакет.Область(0,ИндексКолонки,0,ИндексКолонки).ШиринаКолонки = 2;	
		//ШиринаПоследнейКолонки = ШиринаПоследнейКолонки-3;
	КонецЦикла;			
	
	//ШиринаПоследнейКолонки = Макс(ШиринаПоследнейКолонки,3);
	
	ПолеТабличногоДокументаМакет.Область(0,МаксимальныйУровеньГруппировкиСтрок,0,МаксимальныйУровеньГруппировкиСтрок).ШиринаКолонки = ШиринаПоследнейКолонки;
			
КонецПроцедуры	

Процедура НарисоватьОбластиРаскрытияКолонок(СтруктураГруппировок,ПолеТабличногоДокументаМакет,МаксимальныйУровеньГруппировкиКолонок) 
	
	КартинкаОбластиИзмерения = БиблиотекаКартинок.МетаданныеИзмерения;
	КартинкаОбластиПериоды   = БиблиотекаКартинок.СводнаяТаблицаПериоды;
	
    ИмяОбластиГруппы = "";
	
	ЦветУзораЗаголовкаГруппировки                  	= Новый Цвет(255,255,255);
	ЦветУзораСлужебнойОбласти                  		= Новый Цвет(192,192,192);
	ЦветРамки                   					= Новый Цвет(125,125,125);
	

	ГраницаОбластиРаскрытия 	= Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	
	Для Каждого СтрокаРаскрытия Из СтруктураГруппировок.ТаблицаРаскрываемыхОбластейКолонок Цикл
					
		ОбластьРаскрытия 			= ПолеТабличногоДокументаМакет.Область(СтрокаРаскрытия.ИмяОбласти);
		ЗаголовокОбластиРаскрытия  	= Справочники.БланкиОтчетов.ПолучитьЗаголовокОбластиРаскрытия(СтрокаРаскрытия.Расшифровка);
					
		ОбластьЗаголовка            = ПолеТабличногоДокументаМакет.Область(СтрокаРаскрытия.УровеньГруппировки,ОбластьРаскрытия.Лево,СтрокаРаскрытия.УровеньГруппировки,ОбластьРаскрытия.Лево);
		ОбластьЗаголовкаВсеЯчейки   = ПолеТабличногоДокументаМакет.Область(СтрокаРаскрытия.УровеньГруппировки
		,ОбластьРаскрытия.Лево
		,СтрокаРаскрытия.УровеньГруппировки
		,ОбластьРаскрытия.Право);
		
		//Установим свойства области заголовка по-умолчанию	
		Для ИндСтроки = 1 По ОбластьЗаголовкаВсеЯчейки.Низ  Цикл 
			Для ИндКолонки = ОбластьЗаголовкаВсеЯчейки.Лево По ОбластьЗаголовкаВсеЯчейки.Право  Цикл 
                ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Картинка = Неопределено;
				ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Текст = "";
				ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Узор = ТипУзораТабличногоДокумента.Узор3;
                ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).ЦветУзора = ЦветУзораСлужебнойОбласти;

			КонецЦикла;	
		КонецЦикла;
		
		ИмяОбластиГруппы 		= СтрокаРаскрытия.ИмяОбластиГруппы;
		
		ОбластьЗаголовкаВсеЯчейки.ГраницаСверху 	= ГраницаОбластиРаскрытия; 
		//ОбластьЗаголовкаВсеЯчейки.ГраницаСправа	= ГраницаОбластиРаскрытия; 
		//ОбластьЗаголовкаВсеЯчейки.ГраницаСлева	 	= ГраницаОбластиРаскрытия; 
		ОбластьЗаголовкаВсеЯчейки.ГраницаСнизу	 	= ГраницаОбластиРаскрытия; 
		
		
		ОбластьЗаголовкаВсеЯчейки.ЦветРамки = ЦветРамки;	 
		ОбластьЗаголовкаВсеЯчейки.ЦветУзора = ЦветУзораЗаголовкаГруппировки;		 
		
		//Установим картинку строк 
		Если НЕ СтрокаРаскрытия.Расшифровка.НастройкиАналитикРаскрытия.Найти("ПериодОтчета","АналитикаКод") = Неопределено Тогда	
			ОбластьЗаголовка.Картинка =  КартинкаОбластиПериоды;		 
		Иначе	 	 
			ОбластьЗаголовка.Картинка =  КартинкаОбластиИзмерения;
		КонецЕсли;	
		ОбластьЗаголовка.РазмерКартинки 				= РазмерКартинки.РеальныйРазмер;
		ОбластьЗаголовка.ВертикальноеПоложениеКартинки 	= ВертикальноеПоложение.Центр;
		
		
		//Выведем заголовок области
		ОбластьЗаголовка.Текст 								= ЗаголовокОбластиРаскрытия;
		ОбластьЗаголовка.ВертикальноеПоложение 				= ВертикальноеПоложение.Центр;
		ОбластьЗаголовка.ГоризонтальноеПоложение 			= ГоризонтальноеПоложение.Лево;
		ОбластьЗаголовка.ГоризонтальноеПоложениеКартинки 	= ГоризонтальноеПоложение.Лево;
		
		//Установим расшифровку
		 ШиринаОбластиМакета = СтрокаРаскрытия.Лево+(СтрокаРаскрытия.ШиринаМакета-1);
		 Для ИндКолонки = СтрокаРаскрытия.Лево  По ШиринаОбластиМакета Цикл		 
			 
			 СтруктураРсшифровкиНовая = Новый Структура;
			 Для Каждого СтрокаРасшифровки Из СтрокаРаскрытия.РасшифровкаИсходная Цикл
				 СтруктураРсшифровкиНовая.Вставить(СтрокаРасшифровки.Ключ,СтрокаРасшифровки.Значение);
			 КонецЦикла;	 
			 
			 ПолеТабличногоДокументаМакет.Область(1,ИндКолонки,1,ИндКолонки).Расшифровка = СтруктураРсшифровкиНовая; 
			 ПолеТабличногоДокументаМакет.Область(1,ИндКолонки,1,ИндКолонки).ЦветУзора   = ЦветУзораЗаголовкаГруппировки;
		 КонецЦикла;
		
	КонецЦикла;	

	//Установим высоту строк технической области
	Для ИндексСтроки = 1 По МаксимальныйУровеньГруппировкиКолонок Цикл		
		ПолеТабличногоДокументаМакет.Область(ИндексСтроки,0,ИндексСтроки,0).ВысотаСтроки = 15;	
	КонецЦикла;					
		
КонецПроцедуры	



#КонецОбласти

#КонецЕсли
