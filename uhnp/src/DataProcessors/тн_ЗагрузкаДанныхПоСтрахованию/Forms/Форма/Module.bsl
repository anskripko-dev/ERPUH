
&НаКлиенте
Процедура ВыбранныйФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьДанныеИзФайла", ЭтотОбъект);
	ДиалогЗагрузкиФайла(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ДиалогЗагрузкиФайла(ОповещениеЗавершения)
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Все поддерживаемые форматы файлов(*.xls;*.xlsx)|*.xls;*.xlsx|Книга Excel 97 (*.xls)|*.xls|Книга Excel 2007 (*.xlsx)|*.xlsx';");
	ПараметрыЗагрузки.ИдентификаторФормы = ОповещениеЗавершения.Модуль.УникальныйИдентификатор;
		
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОповещениеЗавершения, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеИзФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Объект.ВыбранныйФайл                 = Результат.Имя;
		АдресВременногоХранилища = Результат.Хранение;
		Расширение = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(Результат.Имя));
		
		ПрочитатьНаСервере(АдресВременногоХранилища, Расширение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТаблицаСопоставленияКолонок();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицаСопоставленияКолонок()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МакетСопоставления = ОбработкаОбъект.ПолучитьМакет("МакетСопоставленияКолонок");
	 	
	ТаблицаКолонок = ПолучитьДанныеТабличногоДокументаТаблицаЗначений(МакетСопоставления);
	
	ТаблицаСопоставленияКолонок.Загрузить(ТаблицаКолонок);
	
	МассивДобавляемыхРеквизитов = Новый Массив();
		
	Для Каждого СтрокаКолонка Из ТаблицаКолонок Цикл
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(СтрокаКолонка.ИмяКолонки, ПолучитьТипКолонки(СтрокаКолонка.ТипКолонки), "Объект.ТаблицаДанных", СтрокаКолонка.ПредставлениеКолонкиТаблицаДанных));	
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	ТаблицаФормы = Элементы.Добавить("ТаблицаДанных", Тип("ТаблицаФормы"), Элементы.ГруппаТаблицаДанных);
	ТаблицаФормы.ПутьКДанным = "Объект.ТаблицаДанных";
	
	НоваяКолонка = Элементы.Добавить("НомерСтроки", Тип("ПолеФормы"), Элементы["ТаблицаДанных"]);
	НоваяКолонка.Заголовок = "N";
	НоваяКолонка.ПутьКДанным = "Объект.ТаблицаДанных.НомерСтроки";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	
	Для Каждого СтрокаКолонка Из ТаблицаКолонок Цикл
		НоваяКолонка = Элементы.Добавить(СтрокаКолонка.ИмяКолонки, Тип("ПолеФормы"), Элементы["ТаблицаДанных"]);
		НоваяКолонка.Заголовок = СтрокаКолонка.ПредставлениеКолонкиТаблицаДанных;
		НоваяКолонка.ПутьКДанным = "Объект.ТаблицаДанных." + СтрокаКолонка.ИмяКолонки;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Функция ПолучитьТипКолонки(ТипКолонкиСтрока)
	
	МассивТиповСтрока = СтрРазделить(ТипКолонкиСтрока, "#", Истина);
	
	МассивТипов = Новый Массив();
	КвалификаторЧисла = Неопределено;
	Для Каждого ТипСтрока Из МассивТиповСтрока Цикл
			
		Если СтрНайти(ВРег(ТипКолонкиСтрока), ВРег("Число"))>0 Тогда
			СтрокиТипа = СтрРазделить(ТипКолонкиСтрока, "_");
			МассивТипов.Добавить(Тип("Число"));
			КвалификаторЧисла = Новый КвалификаторыЧисла(СтрокиТипа[1], СтрокиТипа[2]);
		ИначеЕсли СтрНайти(ВРег(ТипКолонкиСтрока), ВРег("Строка"))>0 Тогда	
			МассивТипов.Добавить(Тип("Строка"));
		Иначе
			МассивТипов.Добавить(Тип(ТипСтрока));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(МассивТипов,,,КвалификаторЧисла);
	
КонецФункции

&НаСервере
Процедура ПрочитатьНаСервере(АдресВременногоХранилища, Расширение)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ПолучитьИзВременногоХранилища(АдресВременногоХранилища).Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент();
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);
	
	ТаблицаДанныхФайл = ПолучитьДанныеТабличногоДокументаТаблицаЗначений(ТабличныйДокумент);
	
	Объект.ТаблицаДанных.Очистить();
	ТаблицаДанных = Объект.ТаблицаДанных.Выгрузить();
	
	ТаблицаСопоставления = ПолучитьТаблицуСопоставления(ТаблицаДанных, ТаблицаДанныхФайл);
	
	Объект.ТаблицаДанных.Загрузить(ТаблицаСопоставления);
	
	Попытка
		РаботаСФайламиУХ.УдалитьФайлыАсинхронно(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеТабличногоДокументаТаблицаЗначений(ТабличныйДокумент)
	
	Построитель = Новый ПостроительОтчета();
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(1, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	
	Возврат Построитель.Результат.Выгрузить();
	
КонецФункции	

&НаСервере
Функция ПолучитьТаблицуСопоставления(ТаблицаДанных, ТаблицаДанныхФайл)
	
	СтруктураПодразделений = Новый Структура();
	
	ТаблицаПодразделений = ПолучитьТаблицуПодразделений(ТаблицаДанныхФайл.ВыгрузитьКолонку("Подразделение"));
	ТаблицаФизическиеЛица = ПолучитьТаблицуФизическихЛиц(ТаблицаДанныхФайл.ВыгрузитьКолонку("СотрудникиОрганизации"));
	
	Для Каждого СтрокаФайл Из ТаблицаДанныхФайл Цикл
		Если Не ЗначениеЗаполнено(СтрокаФайл.Наименование) Тогда
			Прервать;
		КонецЕсли;	
		СтрокаДанных = ТаблицаДанных.Добавить();
		СтрокаДанных.Содержание = СтрокаФайл.Наименование;
		СтрокаДанных.Количество = 1;
		СтрокаДанных.Сумма = ?(ЗначениеЗаполнено(СтрокаФайл.Сумма), Число(СтрокаФайл.Сумма), 0);
		СтрокаДанных.СуммаСНДС = СтрокаДанных.Сумма;
		СтрокаДанных.Цена = СтрокаДанных.Сумма;
		СтрокаДанных.СчетУчета = ОпределитьСчетУчета(СтрокаФайл.ВидРБП);
		СтрокаДанных.Подразделение = ПолучитьПодразделение(ТаблицаПодразделений, СтрокаФайл.Подразделение);
		СтрокаДанных.ПодразделениеНаименование = СтрокаФайл.Подразделение;
		СтрокаДанных.СтатьяРасходов = ОпределитьСтатьюРасходов(СтрокаДанных.СчетУчета);
		СтрокаДанных.АналитикаРасходов = ОпределитьАналитикуРасходов(ТаблицаФизическиеЛица, СтрокаФайл, СтрокаДанных);
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуПодразделений(МассивНаименований)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СтруктураПредприятия.Ссылка КАК Ссылка,
	|	СтруктураПредприятия.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.Наименование В(&МассивНаименований)");
	
	Запрос.УстановитьПараметр("МассивНаименований", МассивНаименований);
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

&НаСервере
Функция ПолучитьТаблицуФизическихЛиц(МассивНаименований)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.ФИО В(&МассивНаименований)");
	
	Запрос.УстановитьПараметр("МассивНаименований", МассивНаименований);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьПодразделение(ТаблицаПодразделений, ПодразделениеНаименование)
	
	СтрокаПодразделения = ТаблицаПодразделений.Найти(ПодразделениеНаименование, "Наименование");
	Если Не СтрокаПодразделения = Неопределено Тогда
		Возврат СтрокаПодразделения.Ссылка; 	
	КонецЕсли;
	Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция ПолучитьФизическоеЛицо(ТаблицаФизЛиц, ФизЛицоНаименование)
	
	СтрокаФизЛицо = ТаблицаФизЛиц.Найти(ФизЛицоНаименование, "Наименование");
	Если Не СтрокаФизЛицо = Неопределено Тогда
		Возврат СтрокаФизЛицо.Ссылка; 	
	КонецЕсли;
	Возврат Справочники.ФизическиеЛица.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция ОпределитьСчетУчета(ВидРБП)
	
	Если ЗначениеЗаполнено(ВидРБП) Тогда
		Возврат ПланыСчетов.Хозрасчетный.РасчетыПоИмущественномуИЛичномуСтрахованию; //76.01
	Иначе
		Возврат ПланыСчетов.Хозрасчетный.РасчетыПоПрочимОперациям; //73.03
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ОпределитьСтатьюРасходов(СчетРеглУчета)
	
	Если СчетРеглУчета = ПланыСчетов.Хозрасчетный.РасчетыПоПрочимОперациям Тогда
		Возврат Объект.СтатьяРасходов73_03;
	ИначеЕсли СчетРеглУчета = ПланыСчетов.Хозрасчетный.РасчетыПоИмущественномуИЛичномуСтрахованию Тогда	
		Возврат Объект.СтатьяРасходов76_01;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ОпределитьАналитикуРасходов(ТаблицаФизическиеЛица, СтрокаФайл, СтрокаДанных)
	
	Если СтрокаДанных.СчетУчета = ПланыСчетов.Хозрасчетный.РасчетыПоПрочимОперациям Тогда
		Возврат ПолучитьФизическоеЛицо(ТаблицаФизическиеЛица, СтрокаФайл.СотрудникиОрганизации); 		
	ИначеЕсли СтрокаДанных.СчетУчета = ПланыСчетов.Хозрасчетный.РасчетыПоИмущественномуИЛичномуСтрахованию Тогда	
		Возврат СтрокаДанных.Подразделение;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Процедура ЗагрузитьДанныеНаСервере()
	
	ТаблицаДанных = Объект.ТаблицаДанных.Выгрузить();;
	
	ТаблицаДанных.Колонки.Добавить("СтавкаНДС");
	ТаблицаДанных.ЗаполнитьЗначения(Перечисления.СтавкиНДС.БезНДС, "СтавкаНДС");
	
	ПриобретениеУслугПрочихАктивов_Указатель = Объект.ВыбранныйДокумент.ПолучитьОбъект();
	ПриобретениеУслугПрочихАктивов_Указатель.Расходы.Загрузить(ТаблицаДанных);
	ПриобретениеУслугПрочихАктивов_Указатель.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	ЗагрузитьДанныеНаСервере();
	
КонецПроцедуры


