
&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ОбъектыПечати") тогда 
		Для Каждого ОбъектПечати Из Параметры.ОбъектыПечати Цикл
			НоваяСтрока = Объект.ДокументыПечати.Добавить();
			НоваяСтрока.Документ = ОбъектПечати;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура Печать(Команда)
	
	МенеджерПечати = "Обработка.тн_Печать_ПриказПоОС";
	Идентификатор = "тн_ПриказПоОС";
	ОбъектыПечати = ПолучитьМассивДокументовПечати();  

	ДанныеПриказа = ПолучитьСтруктуруДанныхПриказа();
	ЗаполнитьЗначенияСвойств(ДанныеПриказа,Объект); 
	
	ДанныеПриказа.ДатаПриказа 				= Формат(ДанныеПриказа.ДатаПриказа,"ДФ='дд ММММ гггг'");
	ДанныеПриказа.КОсмотруПриступить 		= Формат(ДанныеПриказа.КОсмотруПриступить,"ДФ='дд ММММ гггг'");
	ДанныеПриказа.ОкончитьОсмотр 			= Формат(ДанныеПриказа.ОкончитьОсмотр,"ДФ='дд ММММ гггг'");
	ДанныеПриказа.СдатьВБухгалтериюНеПозднее = Формат(ДанныеПриказа.СдатьВБухгалтериюНеПозднее,"ДФ='дд ММММ гггг'");
	
	ДополнительныеПараметрыПечати = Новый Структура;
	ДополнительныеПараметрыПечати.Вставить("ДанныеПриказа", ДанныеПриказа);  
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(МенеджерПечати, Идентификатор, ОбъектыПечати, , ДополнительныеПараметрыПечати);	

КонецПроцедуры 

&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция  ПолучитьСтруктуруДанныхПриказа()
	Возврат Обработки.тн_Печать_ПриказПоОС.ПолучитьСтруктуруДанныхПриказа();
КонецФункции	

&НаСервере
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ПолучитьМассивДокументовПечати()
	ОбъектыПечати = Новый Массив;  
	Для Каждого СтрокаДокументыПечати Из Объект.ДокументыПечати Цикл
		ОбъектыПечати.Добавить(СтрокаДокументыПечати.Документ);
	КонецЦикла;
	Возврат ОбъектыПечати;
КонецФункции