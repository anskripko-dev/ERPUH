#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Печать

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "тн_ПриказПоОС") Тогда
		
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "тн_ПриказПоОС");
		Если ПечатнаяФорма <> Неопределено Тогда
			ИмяМакета = "тн_ПФ_DOC_ПриказПоОС";
			МакетИДанныеОбъекта = УправлениеПечатьюВызовСервера.МакетыИДанныеОбъектовДляПечати("Обработка.тн_Печать_ПриказПоОС", ИмяМакета, МассивОбъектов);
			
			ОфисныеДокументы = Новый Соответствие;
			
			Шаблон = НСтр("ru = 'Приказ №[Номер] от [Дата]'");
			ЗначенияРеквизитовДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов, "Организация,Номер,Дата,Ссылка");  
			ДанныеПриказа = ПолучитьСтруктуруДанныхПриказа();
			Если ПараметрыПечати.Свойство("ДанныеПриказа") тогда 
				ЗаполнитьЗначенияСвойств(ДанныеПриказа,ПараметрыПечати.ДанныеПриказа);
			КонецЕсли;	
			Для Каждого Ссылка Из МассивОбъектов Цикл
				ЗначенияРеквизитовДокумента = ЗначенияРеквизитовДокументов[Ссылка];
				ЗначенияРеквизитовДокумента.Дата = Формат(ЗначенияРеквизитовДокумента.Дата, "ДЛФ=D");
				Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПрефиксацияОбъектов") Тогда
					МодульПрефиксацияОбъектовКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовКлиентСервер");
					ЗначенияРеквизитовДокумента.Номер = МодульПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ЗначенияРеквизитовДокумента.Номер);
				КонецЕсли;
				ИмяДокумента = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ЗначенияРеквизитовДокументов[Ссылка]);
				
				АдресХранилищаОфисныйДокумент = НапечататьПриказПоОС(Ссылка, МакетИДанныеОбъекта, ИмяМакета,ДанныеПриказа);
				
				ОфисныеДокументы.Вставить(АдресХранилищаОфисныйДокумент, ИмяДокумента);
			КонецЦикла;
			
			ПечатнаяФорма.СинонимМакета    = НСтр("ru = 'Приказ по ОС (документ Microsoft Word)'");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ПолучитьДанныеПечати(Знач МассивОбъектов, Знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	СоответствиеПриказПоОС = СоответствиеДанныхДляПечатиПриказПоОС(МассивОбъектов);
	
	Для Каждого ОбъектСсылка Из МассивОбъектов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, СоответствиеПриказПоОС[ОбъектСсылка]);
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ДвоичныеДанныеМакетов = Новый Соответствие;
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		Если ИмяМакета = "тн_ПФ_DOC_ПриказПоОС" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.МакетПечатнойФормы("Обработка.тн_Печать_ПриказПоОС.тн_ПФ_DOC_ПриказПоОС"));
		КонецЕсли;
		ОписаниеОбластей.Вставить(ИмяМакета, ОписаниеОбластейМакетаОфисногоДокумента());
	КонецЦикла;
	
	Макеты = Новый Структура("ОписаниеОбластей, ДвоичныеДанныеМакетов");
	Макеты.ОписаниеОбластей = ОписаниеОбластей;
	Макеты.ДвоичныеДанныеМакетов = ДвоичныеДанныеМакетов;
	
	ДанныеПечати = Новый Структура("Данные, Макеты");
	ДанныеПечати.Данные = ДанныеПоВсемОбъектам;
	ДанныеПечати.Макеты = Макеты;
	
	Возврат ДанныеПечати;
	
КонецФункции

// Структура данных для подготовки печатных форм.
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ПринятиеКУчетуОС24.
//
// Возвращаемое значение:
//   Массив из см. Документ.ПринятиеКУчетуОС24.ОписаниеСогласия
//
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ДанныеДляПечатиПриказПоОС(МассивОбъектов)
	
	ДанныеДляПечати = Новый Массив;
	
	Запрос = Новый Запрос(
                "ВЫБРАТЬ
                |	ПринятиеКУчетуОС2_4ОС.ОсновноеСредство КАК ОсновноеСредство,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка.СрокИспользованияБУ КАК СрокИспользования,
                |	ПринятиеКУчетуОС2_4ОС.ОсновноеСредство.ГруппаОС КАК НаименованиеГруппы,
                |	ПринятиеКУчетуОС2_4ОС.ОсновноеСредство.КодПоОКОФ КАК ОКОФ,
                |	ПорядокУчетаОСБУСрезПоследних.АмортизационнаяГруппа.Порядок + 1 КАК Группа,
                |	ПринятиеКУчетуОС2_4ОС.ОсновноеСредство.Наименование КАК Наименование,
                |	ПринятиеКУчетуОС2_4ОС.ОсновноеСредство.ИнвентарныйНомер КАК ИнвНомер,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка КАК Ссылка,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка КАК ДокументОснование,
                |	ПринятиеКУчетуОС2_4ОС.НомерСтроки КАК НомерСтроки,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка.Номер КАК Номер,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка.Дата КАК Дата,
                |	ПринятиеКУчетуОС2_4ОС.Ссылка.Организация КАК Организация
                |ИЗ
                |	Документ.ПринятиеКУчетуОС2_4.ОС КАК ПринятиеКУчетуОС2_4ОС
                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокУчетаОСБУ.СрезПоследних КАК ПорядокУчетаОСБУСрезПоследних
                |		ПО (ПорядокУчетаОСБУСрезПоследних.Регистратор = ПринятиеКУчетуОС2_4ОС.Ссылка)
                |			И (ПорядокУчетаОСБУСрезПоследних.ОсновноеСредство = ПринятиеКУчетуОС2_4ОС.ОсновноеСредство)
                |ГДЕ
                |	ПринятиеКУчетуОС2_4ОС.Ссылка В(&ПринятиеКУчетуОС)
                |ИТОГИ
                |	МАКСИМУМ(НомерСтроки),
                |	МАКСИМУМ(Номер),
                |	МАКСИМУМ(Дата),
                |	МАКСИМУМ(Организация)
                |ПО
                |	Ссылка");
		
	Запрос.УстановитьПараметр("ПринятиеКУчетуОС", МассивОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		Описание = ОписаниеПриказПоОС();                                      
		
		ЗаполнитьЗначенияСвойств(Описание, Выборка);  
		ВыборкаСтроки =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		МассивСтрок = Новый Массив; 
		НаименованиеОС = "";
		Пока ВыборкаСтроки.Следующий() Цикл
			СтруктураСтроки = ПолучитьСтруктуруСтроки();
			ЗаполнитьЗначенияСвойств(СтруктураСтроки,ВыборкаСтроки);
			МассивСтрок.Добавить(СтруктураСтроки);
			НаименованиеОС = НаименованиеОС + ВыборкаСтроки.Наименование + ?(Выборка.НомерСтроки=ВыборкаСтроки.НомерСтроки,"",", ");
		КонецЦикла;	
		
		СтруктураОтветственных = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Выборка.Организация,
			КонецДня(Выборка.Дата));
		
		Описание.Дата 	= Формат(Описание.Дата,"ДФ='дд ММММ гггг'");
		Описание.Вставить("ДолжностьПредседательКомиссии",СтруктураОтветственных.РуководительДолжность); 
		Описание.Вставить("ФИОПредседательКомиссии",СтруктураОтветственных.Руководитель); 
		Описание.Вставить("ДолжностьЧленКомиссии1","Гл.бухгалтер"); 
		Описание.Вставить("ФИОЧленКомиссии1",СтруктураОтветственных.ГлавныйБухгалтер); 
		Описание.Вставить("ДолжностьЧленКомиссии2",""); 
		Описание.Вставить("ФИОЧленКомиссии2",""); 
		Описание.Вставить("ФИОРуководитель",СтруктураОтветственных.Руководитель); 
		Описание.Вставить("ДолжностьРуководитель",СтруктураОтветственных.РуководительДолжность);
		
		Описание.Вставить("НаименованиеОС", НаименованиеОС);
		Описание.Вставить("МассивДанныхПоОС",МассивСтрок); 
		ДанныеДляПечати.Добавить(Описание);
	КонецЦикла;
	
	Возврат ДанныеДляПечати;
	
КонецФункции                                    

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ПолучитьСтруктуруСтроки() 
	Возврат Новый Структура("НомерСтроки,ИнвНомер,Наименование,Группа,НаименованиеГруппы,ОКОФ,СрокИспользования");
КонецФункции                                    

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ПолучитьСтруктуруДанныхПриказа() Экспорт
	Возврат Новый Структура("НомерПриказа,ДатаПриказа,КОсмотруПриступить,ОкончитьОсмотр,ПричинаПеремещения,СдатьВБухгалтериюНеПозднее");
КонецФункции                                    

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция ОписаниеПриказПоОС()
	
	ОписаниеПриказПоОС = Новый Структура(
		"ДатаСогласия,
		|Дата, 
		|ДокументОснование, 
		|МассивДанныхПоОС, 
		|Организация, 
		|НомерПриказа, 
		|ДолжностьПредседательКомиссии, 
		|ФИОПредседательКомиссии, 
		|ДолжностьЧленКомиссии1, 
		|ФИОЧленКомиссии1, 
		|ДолжностьЧленКомиссии2, 
		|ФИОЧленКомиссии2, 
		|НаименованиеОС, 
		|КОсмотруПриступить, 
		|ОкончитьОсмотр, 
		|ПричинаПеремещения, 
		|СдатьВБухгалтериюНеПозднее, 
		|ФИОРуководитель, 
		|ДолжностьРуководитель");
		
	Возврат ОписаниеПриказПоОС;
	
КонецФункции

// Структура данных для подготовки печатных форм.
//
// Параметры:
//  Согласия - Массив из ДокументСсылка.СогласиеНаОбработкуПерсональныхДанных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка.СогласиеНаОбработкуПерсональныхДанных
//   * Значение - см. Документ.СогласиеНаОбработкуПерсональныхДанных.ОписаниеСогласия
//
// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция СоответствиеДанныхДляПечатиПриказПоОС(МассивОбъектов)
	
	Соответствие = Новый Соответствие;
	
	ДанныеДляПечати = ДанныеДляПечатиПриказПоОС(МассивОбъектов);
	
	Для Каждого ОписаниеПриказПоОС Из ДанныеДляПечати Цикл
		Соответствие.Вставить(ОписаниеПриказПоОС.ДокументОснование, ОписаниеПриказПоОС);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

// Федоров Максим 13.05.2022 Выполнение задач №000041233
Функция НапечататьПриказПоОС(ДокументСсылка, МакетИДанныеОбъекта, ИмяМакета,ДанныеПриказа)
	
	ТипМакета				= МакетИДанныеОбъекта.Макеты.ТипыМакетов[ИмяМакета];
	ДвоичныеДанныеМакетов	= МакетИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов;
	Области					= МакетИДанныеОбъекта.Макеты.ОписаниеОбластей;
	ДанныеОбъекта			= МакетИДанныеОбъекта.Данные[ДокументСсылка][ИмяМакета];
	
	Макет = УправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(ДвоичныеДанныеМакетов[ИмяМакета], ТипМакета, ИмяМакета);
	Если Макет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗакрытьОкноПечатнойФормы = Ложь;
	Попытка
		ПечатнаяФорма = УправлениеПечатью.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
		АдресХранилищаПечатнойФормы = "";
		Если ПечатнаяФорма = Неопределено Тогда
			УправлениеПечатью.ОчиститьСсылки(Макет);
			Возврат "";
		КонецЕсли;        
		
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта,ДанныеПриказа);
		
		// Вывод обычных областей с параметрами.
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ЗаголовокДокумента"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТекстПриказОсмотр"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		//УправлениеПечатью.ЗаполнитьПараметры(ПечатнаяФорма, ДанныеПриказа);

		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТекстОсмотра"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);      
		//УправлениеПечатью.ЗаполнитьПараметры(ПечатнаяФорма, ДанныеПриказа);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТекстКомиссияОсмотр"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);      
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Комиссия"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
 		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Подвал"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);

		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ЗаголовокДокумента"]);
		Область.НомерРаздела = 2;
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Истина);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТекстПриказПослеОсмотра"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ТекстКомиссияПослеОсмотра"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Комиссия"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["ШапкаТаблицы"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["СтрокаТаблицы"]);
		Для Каждого СтрокаОС из ДанныеОбъекта.МассивДанныхПоОС Цикл 
			УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, СтрокаОС, Ложь);
		КонецЦикла;
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, Области[ИмяМакета]["Подвал"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
					
		АдресХранилищаПечатнойФормы = УправлениеПечатью.СформироватьДокумент(ПечатнаяФорма);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗакрытьОкноПечатнойФормы = Истина;
		Возврат "";
	КонецПопытки;
	
	УправлениеПечатью.ОчиститьСсылки(ПечатнаяФорма, ЗакрытьОкноПечатнойФормы);
	УправлениеПечатью.ОчиститьСсылки(Макет);
	
	Возврат АдресХранилищаПечатнойФормы;
	
