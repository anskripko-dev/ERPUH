
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ЭтаФорма.ДатаДокументов = ТекущаяДата();      
	ЭтаФорма.ДатаДокументов = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ЭтаФорма.Менеджер		= Пользователи.ТекущийПользователь();
	ЭтаФорма.ПропускатьНулевыеКолва = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл";
	ДиалогВыбора.Фильтр = "MXL (*.mxl)";
	
	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
	
	ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла);
	
	Элементы.СоздатьДоки.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла)
	
	Расширение = Прав(ИмяФайла,3);
	
	ФайлПриемник = ПолучитьИмяВременногоФайла(Расширение);
	ДанныеХранилища = ПолучитьИзВременногоХранилища(Адрес);
	ДанныеХранилища.Записать(ФайлПриемник);
	
	ТабДокумент.Очистить();
	ТабДокумент.Прочитать(ФайлПриемник,СпособЧтенияЗначенийТабличногоДокумента.Текст);
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДокумент(Документ, ДокументСоздан, Счетчик)
	
	Если ДокументСоздан Тогда
		
		Если Документ.Кассы.Количество() = 0
			И Документ.БанковскиеСчета.Количество() = 0 Тогда
			Результат.ДобавитьСтроку(Строка(Счетчик)+" Документ не содержит строк (вероятно произошла загрузка отрицательных остатков)");
			ДокументСоздан = Ложь;	
		КонецЕсли;
		
		Документ.Записать();
		Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ.Номер+ " от "+Документ.Дата);
		ДокументСоздан = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокиНаСервере()  ////////////////////////////////////////////////////////////////////////
	
	Результат.Очистить();
	
	КолОрг		= 1;
	КолОргID	= 2;
	КолВидДС	= 3;
	КолКодВалюты= 4;
	КолСчетКасса= 5;
	КолСчКассаID= 6;
	КолСумма	= 7;
	КолУпрСумма	= 8;
	
	// Ищем первую строку с данными
	Для ПерваяСтрокаДанныхВФайле = 1 По ТабДокумент.ВысотаТаблицы Цикл
		Если  ТабДокумент.Область(ПерваяСтрокаДанныхВФайле,КолОрг,ПерваяСтрокаДанныхВФайле,КолОрг).Текст = "Организация" Тогда
			ПерваяСтрокаДанныхВФайле = ПерваяСтрокаДанныхВФайле +1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если  ПерваяСтрокаДанныхВФайле > ТабДокумент.ВысотаТаблицы Тогда
		Результат.ДобавитьСтроку("Файл не соответствует");
		Возврат;
	Иначе
		Результат.ДобавитьСтроку("Обрабатываем со строки "+Строка(ПерваяСтрокаДанныхВФайле)+" по "+Строка(ТабДокумент.ВысотаТаблицы) );
	КонецЕсли;
	
	Документ  = Неопределено;
	ДокументСоздан = Ложь;
	
	Для Счетчик=ПерваяСтрокаДанныхВФайле По ТабДокумент.ВысотаТаблицы Цикл
		
		ПредОрганизация = ТабДокумент.Область(Счетчик-1,КолОргID,Счетчик-1,КолОргID).Текст;
		ТекОрганизация	= ТабДокумент.Область(Счетчик,КолОргID,Счетчик,КолОргID).Текст;
		ПредВидДС			= ТабДокумент.Область(Счетчик-1,КолВидДС,Счетчик-1,КолВидДС).Текст;
		ТекВидДС			= ТабДокумент.Область(Счетчик,КолВидДС,Счетчик,КолВидДС).Текст;
		ОкраситьСтроку(Счетчик);
		
		Если НЕ (ТекОрганизация = ПредОрганизация И ТекВидДС = ПредВидДС) Тогда
			ЗаписатьДокумент(Документ, ДокументСоздан, Счетчик);
			СсылкаОрганизация = СсылкаПоГУИД(ТекОрганизация, Справочники.Организации);
			Если СсылкаОрганизация = Неопределено Тогда
			    СообщитьОбОшибке(Счетчик, " Не найдена Организация: "+ТабДокумент.Область(Счетчик,КолОрг,Счетчик,КолОрг).Текст, КолОргID);
				Продолжить;
			Иначе
				Документ = Документы.ВводОстатков.СоздатьДокумент();
				ЗаполнитьШапку(Документ, СсылкаОрганизация, ТекВидДС);
				ДокументСоздан = Истина;
			КонецЕсли;
		КонецЕсли;
						
		Если ДокументСоздан Тогда
			СуммаДока = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолСумма,Счетчик,КолСумма).Текст);  
			Если СуммаДока < 0 Тогда
				СообщитьОбОшибке(Счетчик, "Отрицательный остаток:", КолСумма);
				Продолжить;
			КонецЕсли;
			
			СуммаУпр = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолУпрСумма,Счетчик,КолУпрСумма).Текст);
			Если СуммаУпр < 0 Тогда
				СообщитьОбОшибке(Счетчик, "Отрицательный остаток: ", КолУпрСумма);
				Продолжить;
			КонецЕсли;
			
			ТекСчетИлиКасса = ТабДокумент.Область(Счетчик,КолСчКассаID,Счетчик,КолСчКассаID).Текст;
			Если ТекВидДС = "Наличные" Тогда
				СсылкаСчетИлиКасса = СсылкаПоГУИД(ТекСчетИлиКасса, Справочники.Кассы);
			Иначе
				СсылкаСчетИлиКасса = СсылкаПоГУИД(ТекСчетИлиКасса, Справочники.БанковскиеСчетаОрганизаций);
			КонецЕсли;	
			
			Если СсылкаСчетИлиКасса  = Неопределено Тогда
				СообщитьОбОшибке(Счетчик, " Не найдено касса или счет: "+ТабДокумент.Область(Счетчик,КолСчетКасса,Счетчик,КолСчетКасса).Текст, КолСчКассаID);
				Продолжить;
			КонецЕсли;	
						
			Если ТекВидДС = "Наличные" Тогда
				СтрокаТЧ = Документ.Кассы.Добавить();
				СтрокаТЧ.Касса = СсылкаСчетИлиКасса;  
			Иначе
				СтрокаТЧ = Документ.БанковскиеСчета.Добавить();
				СтрокаТЧ.БанковскийСчет = СсылкаСчетИлиКасса;
			КонецЕсли;	
			
				
			СтрокаТЧ.Сумма		= СуммаДока;	
			СтрокаТЧ.СуммаРегл	= СуммаУпр;
			СтрокаТЧ.СуммаУпр	= СуммаУпр;   
			
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьДокумент(Документ, ДокументСоздан, Счетчик);
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоки(Команда)
	СоздатьДокиНаСервере();
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.Результат;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьШапку(Документ, Организация, ВидДС)
	
	Документ.Дата			= ДатаДокументов;
	Документ.Менеджер		= Менеджер;
	Документ.Ответственный	= Менеджер;
	Документ.Организация	= Организация;
	
	// НАЧАЛО Иванов ВЮ (Код-Эксперт) 20.02.2025 Выполнение задач №000052552
	//Если ВидДС = "Наличные" Тогда
	//	Документ.ТипОперации	= Перечисления.ТипыОперацийВводаОстатков.ОстаткиВКассах;
	//Иначе
	//	Документ.ТипОперации	= Перечисления.ТипыОперацийВводаОстатков.ОстаткиНаБанковскихСчетах;
	//КонецЕсли;
	Если ВидДС = "Наличные" Тогда
		Документ.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковВКассах;
	Иначе
		Документ.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковНаБанковскихСчетах;
	КонецЕсли;
	// КОНЕЦ Иванов ВЮ (Код-Эксперт) 20.02.2025 Выполнение задач №000052552
	
	Документ.ОтражатьВБУиНУ				= Истина;
	Документ.ОтражатьВУУ				= Истина;
	Документ.ОтражатьВОперативномУчете	= Истина;

	Документ.Комментарий = "Создано обработкой Х00010982";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоЯчейки(Текст)
	
	Текст = СтрЗаменить(СокрЛП(Текст),Символы.НПП,"");
	Если Текст="" Тогда
		Возврат 0;
	Иначе
		Возврат Число(Текст);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПоГУИД(УИД, ОбластьПоиска)
	
	Попытка
		GUID	= Новый УникальныйИдентификатор(УИД);
		Ссылка  = ОбластьПоиска.ПолучитьСсылку(GUID);
		Если Лев(Строка(Ссылка),7)="<Объект" Тогда 
			Ссылка = Неопределено;
		КонецЕсли;
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
КонецФункции

&НаСервере
Процедура СообщитьОбОшибке(Счетчик, Текст, Колонка=0)
	
	Результат.ДобавитьСтроку(Строка(Счетчик)+Текст);
	
	ТабДокумент.Область(Счетчик,1,Счетчик,ТабДокумент.ШиринаТаблицы).ЦветФона = WebЦвета.ОранжевоКрасный;
	ТабДокумент.Область(Счетчик,Колонка,Счетчик,Колонка).ЦветФона = WebЦвета.Красный;
	
КонецПроцедуры

&НаСервере
Процедура ОкраситьСтроку(Счетчик)
	
	ТабДокумент.Область(Счетчик,1,Счетчик,ТабДокумент.ШиринаТаблицы).ЦветФона = WebЦвета.БледноЗеленый;
	
КонецПроцедуры
