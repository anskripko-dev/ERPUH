  
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполним параметры формы
	РасчетПоСвязаннымВидамОтчетов = Параметры.РасчетПоСвязаннымВидамОтчетов;
	СворачиватьГруппировки = Параметры.СворачиватьГруппировки;	
	ЦелевыеПоказателиСнизу = Параметры.ЦелевыеПоказателиСнизу;
	СоставАналитик = Параметры.СоставАналитик;
	
	РежимВыводаОбщихАналитик = Параметры.РежимВыводаОбщихАналитик;
	Если РежимВыводаОбщихАналитик = 0 Тогда
		РежимВыводаОбщихАналитик = 1;
	КонецЕсли;
	
	ОбработкаРасчета.УникальныйИдентификаторСеанса = Параметры.УникальныйИдентификаторСеанса;
	Если Не ЗначениеЗаполнено(ОбработкаРасчета.УникальныйИдентификаторСеанса) Тогда
		ОбработкаРасчета.УникальныйИдентификаторСеанса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	УровеньТочности = Параметры.УровеньТочности;
	Делитель = Параметры.Делитель;
	Если Делитель = 0 Тогда
		Делитель = 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.АдресТаблицыЦелевыхПоказателей) Тогда
		ЦелевыеПоказатели.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыЦелевыхПоказателей));
	КонецЕсли;
	
	СформироватьОтчет();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтобразитьПротокол();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтобразитьПротокол()
	
	// Отобразим прокол
	Если ЗначениеЗаполнено(ОбработкаРасчета.АдресТаблицыСобытий) Тогда
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",Новый Структура("АдресТаблицыСобытий",ОбработкаРасчета.АдресТаблицыСобытий));
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если ЦелевыеПоказатели.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена таблица с целевыми показателями'");
		Возврат;
	КонецЕсли;

	СформироватьОтчет();
	ОтобразитьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчет()
	
	ТекОбработкаРасчета = РеквизитФормыВЗначение("ОбработкаРасчета");
	РезультатРасчета = ТекОбработкаРасчета.РассчитатьПоЗначениямЦелевыхПоказателей(ЦелевыеПоказатели.Выгрузить(), РасчетПоСвязаннымВидамОтчетов);
	ЗначениеВРеквизитФормы(ТекОбработкаРасчета, "ОбработкаРасчета");
	
	Если РезультатРасчета.БылиОшибки Тогда
		Возврат;
	КонецЕсли;

	// Заполним аналитики по данным расчета, если они не были переданы
	Если СоставАналитик.Количество() = 0 Тогда		
		тДанныеАналитик = РезультатРасчета.ДанныеАналитик.Скопировать(,"ВидАналитики,ПредставлениеАналитики");
		тДанныеАналитик.Свернуть("ВидАналитики,ПредставлениеАналитики");
		Для Каждого СтрокаТаблицы Из тДанныеАналитик Цикл
			СоставАналитик.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, Истина);
		КонецЦикла;
	КонецЕсли;

	// Параметры вывода
	ПараметрыВывода = Новый Структура;
	ПараметрыВывода.Вставить("ЦелевыеПоказателиСнизу", ЦелевыеПоказателиСнизу);
	ПараметрыВывода.Вставить("РежимВыводаОбщихАналитик", РежимВыводаОбщихАналитик);
	ПараметрыВывода.Вставить("СворачиватьГруппировки", СворачиватьГруппировки);
	ПараметрыВывода.Вставить("УровеньТочности", УровеньТочности);
	ПараметрыВывода.Вставить("Делитель", Делитель);
	ПараметрыВывода.Вставить("СоставАналитик", СоставАналитик);	
	
	// Сформируем отчет
	РабочийОбъект = РеквизитФормыВЗначение("Объект");
	ТабличныйДокумент = РабочийОбъект.ПоказатьАнализРасчетаПоказателя(РезультатРасчета, ПараметрыВывода); 
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаЦелевыеПоказателиНажатие(Элемент)
	
	ТекущееЗначение = Элементы.ГруппаЦелевыеПоказатели.Видимость;	
	
	Элементы.ГруппаЦелевыеПоказатели.Видимость = Не ТекущееЗначение;
	Элементы.ГруппаСоставАналитик.Видимость = Ложь;
	Элементы.ГруппаНастройки.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаСоставАналитикНажатие(Элемент)
	
	ТекущееЗначение = Элементы.ГруппаСоставАналитик.Видимость;
	
	Элементы.ГруппаЦелевыеПоказатели.Видимость = Ложь;	
	Элементы.ГруппаСоставАналитик.Видимость = Не ТекущееЗначение;
	Элементы.ГруппаНастройки.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиНажатие(Элемент)
	
	ТекущееЗначение = Элементы.ГруппаНастройки.Видимость;
	
	Элементы.ГруппаЦелевыеПоказатели.Видимость = Ложь;
	Элементы.ГруппаСоставАналитик.Видимость = Ложь;
	Элементы.ГруппаНастройки.Видимость = Не ТекущееЗначение;	
	
КонецПроцедуры

&НаКлиенте
Процедура МасштабПриИзменении(Элемент)

	Пометка = НЕ Элементы.КрупныйМасштаб.Пометка;
	Элементы.КрупныйМасштаб.Пометка = Пометка;
	Если Пометка Тогда
		Элементы.ТабличныйДокумент.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Крупный;
	Иначе
		Элементы.ТабличныйДокумент.РежимМасштабированияПросмотра = РежимМасштабированияПросмотра.Обычный;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Расшифровка = Область.Расшифровка;
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		
		СтандартнаяОбработка = Ложь; 
		ОтобразитьПротокол();
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

