КонецФункции

Процедура ДобавитьПоказателиИсточникиРекурсивно(тРезультатФильтр, тРезультат, Показатель)
	
	НайденныеСтроки = тРезультат.НайтиСтроки(Новый Структура("Потребитель", Показатель));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		НСтрока = тРезультатФильтр.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрока, НайденнаяСтрока);
		Если НайденнаяСтрока.Потребитель <> НайденнаяСтрока.ПоказательОперанд Тогда
			ДобавитьПоказателиИсточникиРекурсивно(тРезультатФильтр, тРезультат, НайденнаяСтрока.ПоказательОперанд);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ВывестиПоказателиРучнойВвод(ТабДокумент, ВидОтчета, НуженВыводШапки = Ложь)
	
	Макет = ПолучитьМакет("Макет");
	
	Если НуженВыводШапки Тогда
		
		ОбластьПропуск 		= Макет.ПолучитьОбласть("Пропуск|Показатель");
		ОбластьШапкаУровень = Макет.ПолучитьОбласть("ШапкаУровень|Показатель");
	
		ТабДокумент.Вывести(ОбластьПропуск);
		ОбластьШапкаУровень.Параметры.УровеньРасчета = 0;
		ТабДокумент.Вывести(ОбластьШапкаУровень);
		
	КонецЕсли;
	
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПоказатель|Показатель");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПотребителиРасчета.Ссылка КАК Показатель
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПотребителиРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
		|		ПО (ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.НазначениеРасчетов КАК Справочник.ПравилаОбработки).Владелец = &ВидОтчета)
		|			И (ИсточникиДанныхДляРасчетов.ПотребительРасчета = ПотребителиРасчета.Ссылка
		|				ИЛИ ИсточникиДанныхДляРасчетов.ПоказательОтбор = ПотребителиРасчета.Ссылка)
		|ГДЕ
		|	ПотребителиРасчета.Владелец = &ВидОтчета
		|	И ПотребителиРасчета.ПометкаУдаления = ЛОЖЬ
		|	И ИсточникиДанныхДляРасчетов.Ссылка ЕСТЬ NULL";

	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);			
	РезультатЗапроса = Запрос.Выполнить(); 			
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();			
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// Выводим строку
		ОбластьСтрока.Параметры.Показатель = ВыборкаДетальныеЗаписи.Показатель;
		ОбластьСтрока.Параметры.Расшифровка = ВыборкаДетальныеЗаписи.Показатель;
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла; 	
	
КонецПроцедуры

Процедура ВывестиАналитикиРекурсивно(СчАналитика, тРезультатПоказатели, текСтрока, НомерСтроки, ТекУровень, СтруктураДляАналитик, СтруктураРасшифровки)
	
	Если СчАналитика > текСтрока.ЧислоАналитик + 3 Тогда
		ИмяАналитики = "АналитикаВалюта";
		Если НЕ текСтрока.ЕстьАналитикаВалюта Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли СчАналитика = 1 Тогда
		ИмяАналитики = "Сценарий";
	ИначеЕсли СчАналитика = 2 Тогда
		ИмяАналитики = "Организация"
	ИначеЕсли СчАналитика = 3 Тогда
		ИмяАналитики = "Проект";
	Иначе
		ИмяАналитики = "Аналитика" + (СчАналитика - 3);
	КонецЕсли;	
	
	МассивАналитик 				= СтруктураДляАналитик.МассивАналитик;
	ТабДокумент 				= СтруктураДляАналитик.ТабДокумент;
	ОбластьАналитикаПоказатель 	= СтруктураДляАналитик.ОбластьАналитикаПоказатель;
	ОбластьАналитикаПериод 		= СтруктураДляАналитик.ОбластьАналитикаПериод;
	МассивПериодов				= СтруктураДляАналитик.МассивПериодов;
			
	тРазличныеАналитики = тРезультатПоказатели.Скопировать(,ИмяАналитики);
	тРазличныеАналитики.Свернуть(ИмяАналитики);
		
	Для Каждого стрАналитика Из тРазличныеАналитики Цикл
		
		// Выводим строку с аналитикой
		Аналитика = стрАналитика[ИмяАналитики];
		СтруктураРасшифровки.Вставить(ИмяАналитики,Аналитика);
		
		НомерАналитикиВСписке = МассивАналитик.Найти(ИмяАналитики);
		Если НомерАналитикиВСписке <> Неопределено Тогда
	
			ОбластьАналитикаПоказатель.Параметры.Аналитика = Аналитика;
			ОбластьАналитикаПоказатель.Область(1,2).Отступ = НомерАналитикиВСписке+1;
			ТабДокумент.Вывести(ОбластьАналитикаПоказатель,НомерАналитикиВСписке+1);
			
			НомерСтроки = НомерСтроки + 1;		
			
			// Выводим значения по периоду
			СуммаПоПериоду = 0;
			Для Каждого Период Из МассивПериодов Цикл
				тРезультатПериод = тРезультатПоказатели.Скопировать(Новый Структура("ПериодОтчета," + ИмяАналитики,Период,Аналитика));
				Если текСтрока.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
					тРезультатПериод.Свернуть(,"Значение");
					Если тРезультатПериод.Количество() Тогда
						Значение = тРезультатПериод.Получить(0).Значение;
						СуммаПоПериоду = СуммаПоПериоду + Значение;
					Иначе
						Значение = 0;
					КонецЕсли;
				Иначе
					СуммаПоПериоду = "";
					Если тРезультатПериод.Количество() Тогда
						Значение = тРезультатПериод.Получить(0).ЗначениеНечисловое;
					Иначе
						Значение = "";
					КонецЕсли;
				КонецЕсли;
				СтруктураРасшифровки.Вставить("ПериодОтчета",Период);
				СтруктураРасшифровки.Вставить("Значение",Значение);
				ОбластьАналитикаПериод.Параметры.Значение = Значение;
				ОбластьАналитикаПериод.Параметры.Расшифровка = СтруктураРасшифровки;
				ТабДокумент.Присоединить(ОбластьАналитикаПериод);
			КонецЦикла;
			Если МассивПериодов.Количество() > 1 Тогда
				ОбластьАналитикаПериод.Параметры.Значение = СуммаПоПериоду;
				ТабДокумент.Присоединить(ОбластьАналитикаПериод);
			КонецЕсли;
			
		КонецЕсли;
		
		// Выводим следующую аналитику
		Если ИмяАналитики <> "АналитикаВалюта" Тогда
			ВывестиАналитикиРекурсивно(СчАналитика+1, тРезультатПоказатели, текСтрока, НомерСтроки, ТекУровень, СтруктураДляАналитик, СтруктураРасшифровки);
		КонецЕсли;		
		
	КонецЦикла;					
	
КонецПроцедуры


#Область ФакторныйАнализ

Функция ВывестиОбщиеАналитики(РежимВыводаОбщихАналитик, НомерСтроки, тЗначенияПоказателей, СтруктураДляВывода)

	СоставАналитик = СтруктураДляВывода.СоставАналитик;
	ИменаАналитик = "Сценарий,Проект,Организация";
	
	СтруктураОбщихАналитик = Новый Структура;	
	
	// Соберем значения общих аналитик
	тОбщиеАналитики = тЗначенияПоказателей.Скопировать(,ИменаАналитик);
	тОбщиеАналитики.Свернуть(ИменаАналитик);
	Для Каждого ИмяАналитики Из СтрРазделить(ИменаАналитик,",") Цикл
		Если тОбщиеАналитики.Количество() = 1 Тогда
			СтруктураОбщихАналитик.Вставить(ИмяАналитики, тОбщиеАналитики[0][ИмяАналитики]);
		Иначе
			тВспомогательная = тОбщиеАналитики.Скопировать(,ИмяАналитики);
			тВспомогательная.Свернуть(ИмяАналитики);
			Если тВспомогательная.Количество() = 1 Тогда
				СтруктураОбщихАналитик.Вставить(ИмяАналитики, тВспомогательная[0][ИмяАналитики]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Выведем общие аналитики в отчет
	Если РежимВыводаОбщихАналитик <> 2 И СтруктураОбщихАналитик.Количество() Тогда
		
		ТабДокумент 			= СтруктураДляВывода.ТабДокумент;
		ОбластьШапкаУровень 	= СтруктураДляВывода.ОбластьШапкаУровень;	
		ОбластьОбщиеАналитики 	= СтруктураДляВывода.ОбластьОбщиеАналитики;
		
		ОбластьШапкаУровень.Параметры.ЗаголовокУровня = НСтр("ru = 'Общие аналитики:'");
		ТабДокумент.НачатьАвтогруппировкуСтрок();
		ТабДокумент.Вывести(ОбластьШапкаУровень, 1);			
		НомерСтроки = НомерСтроки + 1;
		
		Для Каждого СтрокаСписка Из СоставАналитик Цикл
			Если СтрокаСписка.Пометка Тогда
				Если СтрокаСписка.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
					ИмяАналитики = "Сценарий";
				ИначеЕсли СтрокаСписка.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект Тогда
					ИмяАналитики = "Проект";
				ИначеЕсли СтрокаСписка.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация Тогда
					ИмяАналитики = "Организация";
				Иначе
					Продолжить;
				КонецЕсли;
				Значение = Неопределено;
				Если СтруктураОбщихАналитик.Свойство(ИмяАналитики,Значение) Тогда
					// Аналитика является общей для текущего расчета
					Если РежимВыводаОбщихАналитик = 1 Тогда
						ОбластьОбщиеАналитики.Параметры.Аналитика = ИмяАналитики;
						ОбластьОбщиеАналитики.Параметры.Значение = Значение;
						ТабДокумент.Вывести(ОбластьОбщиеАналитики, 2);
						НомерСтроки = НомерСтроки + 1;
						СтрокаСписка.Пометка = Ложь;
					ИначеЕсли РежимВыводаОбщихАналитик = 3 Тогда
						СтрокаСписка.Пометка = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	
		ТабДокумент.ЗакончитьАвтогруппировкуСтрок();
		
	КонецЕсли;
	
	Если тОбщиеАналитики.Количество() = 1 Тогда
		// Состав общих аналитик уникальный в рамках расчета
		Возврат СтруктураОбщихАналитик;
	Иначе
		// Есть неуникальные общие аналитики
		Возврат Новый Структура;
	КонецЕсли;
		
КонецФункции

Процедура ВывестиАналитики(НомерСтрокиАналитик, Отступ, НомерСтроки, тРезультатПоказатели, СтруктураДляВывода)
	
	ТабДокумент 		= СтруктураДляВывода.ТабДокумент;
	ОбластьАналитика	= СтруктураДляВывода.ОбластьАналитика;
	МассивПериодов		= СтруктураДляВывода.МассивПериодов;
	Расшифровка			= СтруктураДляВывода.Расшифровка;
    СтрокаТаблицы		= СтруктураДляВывода.СтрокаТаблицы;
	СоставАналитик		= СтруктураДляВывода.СоставАналитик;
	тДанныеАналитик		= СтруктураДляВывода.ДанныеАналитик;

	Если НомерСтрокиАналитик = СоставАналитик.Количество() Тогда
		Возврат;
	КонецЕсли;
	СтрокаСписка = СоставАналитик.Получить(НомерСтрокиАналитик);

	// Найдем данные аналитики для показателя
	НайденнаяСтрока = тДанныеАналитик.Найти(СтрокаСписка.Значение, "ВидАналитики");
	Если НайденнаяСтрока = Неопределено Тогда
		// Данной аналитики нет среди аналитик показателя
		ВывестиАналитики(НомерСтрокиАналитик+1, Отступ, НомерСтроки, тРезультатПоказатели, СтруктураДляВывода);
		Возврат;
	Иначе
		ИмяАналитики = НайденнаяСтрока.ИмяАналитики;
		КодАналитики = НайденнаяСтрока.КодАналитики;
	КонецЕсли;

	Если СтрокаСписка.Пометка Тогда
		Отступ = Отступ + 1;
	КонецЕсли;	
			
	тРазличныеАналитики = тРезультатПоказатели.Скопировать(,ИмяАналитики);
	тРазличныеАналитики.Свернуть(ИмяАналитики);
		
	Для Каждого стрАналитика Из тРазличныеАналитики Цикл
		
		// Выводим строку с аналитикой
		Аналитика = стрАналитика[ИмяАналитики];
		Расшифровка.Вставить(КодАналитики,Аналитика);
		Расшифровка.Вставить(ИмяАналитики,Аналитика);
		
		тРезультатАналитика = тРезультатПоказатели.Скопировать(Новый Структура(ИмяАналитики,Аналитика));
		
		// Выводим аналитику в отчет
		Если СтрокаСписка.Пометка Тогда			
			
			НомерСтроки = НомерСтроки + 1;
			ОбластьАналитика.Параметры.Аналитика = Аналитика; // ДОДЕЛАТЬ: Запрос к БД при выводе
			ОбластьАналитика.Параметры.Расшифровка = Аналитика;
			ОбластьАналитика.Область(1,2).Отступ = Отступ;
			ТабДокумент.Вывести(ОбластьАналитика, Отступ);					
			
			// Выводим значения по периоду
			Если МассивПериодов.Количество() > 1 Тогда
				ВывестиЗначение(МассивПериодов, тРезультатАналитика, СтруктураДляВывода); 
			КонецЕсли;
			Для Каждого Период Из МассивПериодов Цикл
				ВывестиЗначение(Период, тРезультатАналитика, СтруктураДляВывода);
			КонецЦикла;
			
		КонецЕсли;
		
		// Выводим следующую аналитику
		ВывестиАналитики(НомерСтрокиАналитик+1, Отступ, НомерСтроки, тРезультатАналитика, СтруктураДляВывода);
		
	КонецЦикла;					
	
КонецПроцедуры

Процедура ВывестиЗначение(Период, тРезультат, СтруктураДляВывода)
	
	ТабДокумент 	= СтруктураДляВывода.ТабДокумент;
	ОбластьПериод 	= СтруктураДляВывода.ОбластьПериод;
	СтрокаТаблицы	= СтруктураДляВывода.СтрокаТаблицы;
	Расшифровка		= СтруктураДляВывода.Расшифровка;
	
	// Скопируем структуру расшифровки
	СтруктураРасшифровки = Новый Структура;
	Для Каждого КлючЗначение Из Расшифровка Цикл
		СтруктураРасшифровки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	ПоПериоду = ТипЗнч(Период) = Тип("СправочникСсылка.Периоды");
	
	Если СтрокаТаблицы.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
		Значение = 0;
		Если ПоПериоду Тогда
			Если ПоПериоду Тогда
				тРезультатПериод = тРезультат.Скопировать(Новый Структура("ПериодОтчета",Период), "Значение");
			Иначе
				тРезультатПериод = тРезультат.Скопировать(, "Значение");
			КонецЕсли;
			Если тРезультатПериод.Количество() Тогда
				тРезультатПериод.Свернуть(,"Значение"); //ДОДЕЛАТЬ: Здесь могут быть разные виды агрегации
				Значение = тРезультатПериод.Получить(0).Значение;
			КонецЕсли;
		КонецЕсли;
		СтруктураРасшифровки.Вставить("Значение",Значение);
	Иначе
		Значение = ""; //ДОДЕЛАТЬ: Итог по нечисловым показателям
		СтруктураРасшифровки.Вставить("ЗначениеНечисловое",Значение);
	КонецЕсли; 
	
	Если СтруктураРасшифровки.Свойство("Сценарий") 
		И СтруктураРасшифровки.Свойство("Проект")
		И СтруктураРасшифровки.Свойство("Организация") Тогда
		// Все общие аналитики заполнены
		СтруктураРасшифровки.Вставить("ПериодОтчета", Период);
		ОбластьПериод.Параметры.Расшифровка = СтруктураРасшифровки;
	Иначе
		ОбластьПериод.Параметры.Расшифровка = Неопределено;
	КонецЕсли;
	ОбластьПериод.Параметры.Значение = Значение;
	
	ТабДокумент.Присоединить(ОбластьПериод);
	
КонецПроцедуры

Процедура НарисоватьСтрелку(НомерСтрокиНачало, НомерСтрокиКонец, СтруктураДляВывода)

	СтруктураДляВывода.НомерСвязи = СтруктураДляВывода.НомерСвязи+1;
	
	НомерСвязи		= СтруктураДляВывода.НомерСвязи;
	МассивЦветов 	= СтруктураДляВывода.МассивЦветов;
	ТабДокумент 	= СтруктураДляВывода.ТабДокумент;
	ШиринаКолонок 	= СтруктураДляВывода.ШиринаКолонок;
	
	ВсегоЦветов = МассивЦветов.Количество();
	ТекЦвет = МассивЦветов.Получить(НомерСтрокиКонец - Цел(НомерСтрокиКонец/ВсегоЦветов)*ВсегоЦветов - 1);
	
	Если НомерСтрокиНачало > НомерСтрокиКонец Тогда
		Знак = -1;
	Иначе
		Знак = 1;
	КонецЕсли;
	
	// Ширина всех колонок
	Лево = ШиринаКолонок*1.8525; // Магическая постоянная при высоте строк = 12
	КоэффициентВерх = 4.2335;
	ВерхСтарт = НомерСтрокиНачало*КоэффициентВерх-3.5; 
	ВерхФиниш = НомерСтрокиКонец*КоэффициентВерх-1.5;
	
	// Отступ
	Отступ = 3*НомерСвязи;
	НомерСвязи = НомерСвязи + 1;
	
	// Старт
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево;
	Линия.Верх   = ВерхСтарт;
	Линия.Ширина = Отступ;
	Линия.Высота = 0;
	
	// Сгиб
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево + Отступ;
	Линия.Верх   = ВерхСтарт;
	Линия.Ширина = 1.5;
	Линия.Высота = Знак * 1.5;
	
	// Линия
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево + Отступ + 1.5;
	Линия.Верх   = ВерхСтарт + Знак*1.5;
	Линия.Ширина = 0;
	Линия.Высота = ВерхФиниш - ВерхСтарт - Знак * 3;
	
	// Сгиб
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево + Отступ;
	Линия.Верх   = ВерхФиниш;
	Линия.Ширина = 1.5;
	Линия.Высота = -Знак * 1.5;
	
	// Стрелка
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево;
	Линия.Верх   = ВерхФиниш;
	Линия.Ширина = Отступ;
	Линия.Высота = 0;
	
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево;
	Линия.Верх   = ВерхФиниш;
	Линия.Ширина = 0.5;
	Линия.Высота = 0.5;
	
	Линия = ТабДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямая);
	Линия.ЦветЛинии = ТекЦвет;
	Линия.Лево   = Лево;
	Линия.Верх   = ВерхФиниш;
	Линия.Ширина = 0.5;
	Линия.Высота = -0.5;
	
КонецПроцедуры

