//Блинова М.А. 30.01.2026 Выполнение задач №000056585
//Функция СсылкаПоГУИД(УИД, ОбластьПоиска)
Функция СсылкаПоГУИД(УИД, ОбластьПоиска, ДатаДокументов = Неопределено, ГоловнаяОрганизация = Неопределено)
	
	Попытка
		GUID	= Новый УникальныйИдентификатор(УИД);
		Ссылка  = ОбластьПоиска.ПолучитьСсылку(GUID);
		Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда 
			Ссылка = Неопределено;
		//НАЧАЛО Блинова М.А. 30.01.2026 Выполнение задач №000056585 
		Иначе 
			Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда 
				Ссылка = НайтиГоловнуюОрганизацию(Ссылка, ДатаДокументов);
			ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда 
				Если ГоловнаяОрганизация <> Ссылка.Организация Тогда  
					  Ссылка = ПолучитьДоговорИзРегистраДублей(Ссылка); 
				КонецЕсли; 
			КонецЕсли;
		//КОНЕЦ Блинова М.А. 30.01.2026 Выполнение задач №000056585	
		КонецЕсли;
	Исключение 
		Ссылка = Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
КонецФункции

//Блинова М.А. 30.01.2026 Выполнение задач №000056585
&НаСервереБезКонтекста
Функция НайтиГоловнуюОрганизацию(СсылкаОрганизация, ДатаДокументов)   
	
	//надо найти организацию для схемы ОП			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация КАК ГоловнаяОрганизация
	|ИЗ
	|	РегистрСведений.тн_НастройкиЗагрузкиДанныхВЕРП КАК тн_НастройкиЗагрузкиДанныхВЕРП
	|ГДЕ
	|	тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= &ДатаДокументов
	|	И тн_НастройкиЗагрузкиДанныхВЕРП.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ДатаДокументов", ДатаДокументов);
	Запрос.УстановитьПараметр("Организация", СсылкаОрганизация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СсылкаОрганизация = ВыборкаДетальныеЗаписи.ГоловнаяОрганизация
	КонецЦикла;		
	Возврат СсылкаОрганизация;   
	
КонецФункции			

