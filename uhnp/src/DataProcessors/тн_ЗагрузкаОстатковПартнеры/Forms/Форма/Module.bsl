&НаСервере
Процедура ЗаполнитьТЧ(Документ, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, СуммаВал, СуммаРег=0, ТекСчет, НомерПерв="", ДатаПерв="", СуммаПерв=0, Коммент="", РеглПерв=0)
	
	Строка = Документ.РасчетыСПартнерами.Добавить();
	Строка.Контрагент	= СсылкаКонтрагент;
	Строка.Партнер		= СсылкаКонтрагент.Партнер;
	
	Строка.Договор		= СсылкаДоговор;
	Если ВалютаКод = "643" Тогда
		Строка.Сумма		= СуммаРег;	
	Иначе	
		Строка.Сумма		= СуммаВал;	
	КонецЕсли;
	
	Строка.ДатаПлатежа  = ДатаДокументов;
	
	Строка.СуммаРегл	= СуммаРег;
	Строка.СуммаУпр		= СуммаРег;
	
	//НАЧАЛО Блинова М.А. 03.02.2026 Выполнение задач №000056585
	//Строка.Договор			= Справочники.ДоговорыКонтрагентов;  
	Строка.Договор			= СсылкаДоговор;  
	  	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбъектыРасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
		|ГДЕ
		|	ОбъектыРасчетов.Договор = &Договор";
	
	Запрос.УстановитьПараметр("Договор", СсылкаДоговор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка.ОбъектРасчетовОтправитель = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	//КОНЕЦ Блинова М.А. 03.02.2026 Выполнение задач №000056585
	Строка.ОбъектРасчетов	= СсылкаДоговор;
	Строка.ВалютаВзаиморасчетов = СсылкаДоговор.ВалютаВзаиморасчетов;
	Строка.ДокументРасчетов = СоздатьПервичныйДокумент(Документ, СсылкаКонтрагент, СсылкаДоговор, Строка.ВалютаВзаиморасчетов, СуммаПерв, ТекСчет, НомерПерв, ДатаПерв, Коммент, РеглПерв);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьПервичныйДокумент(Документ, СсылкаКонтрагент, СсылкаДоговор, Валюта, СуммаВал, ТекСчет, НомерПерв, ДатаПерв, Коммент, РеглПерв)
	
	ПервичныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
	ПервичныйДокумент.Дата			= Документ.Дата; 
	ПервичныйДокумент.Организация	= Документ.Организация; 
	ПервичныйДокумент.Контрагент 	= СсылкаКонтрагент; 
	ПервичныйДокумент.Договор 		= СсылкаДоговор; 
	ПервичныйДокумент.Партнер		= СсылкаКонтрагент.Партнер; 
	ПервичныйДокумент.Валюта 		= Валюта; 
	ПервичныйДокумент.СуммаДокумента= СуммаВал; 
	ПервичныйДокумент.СуммаРегл		= РеглПерв; 
	ПервичныйДокумент.Комментарий	= "#Создана загрузкой 11185. По документу УПП - " + Коммент;
	ПервичныйДокумент.ПорядокРасчетов= Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	ПервичныйДокумент.НомерВходящегоДокумента	= НомерПерв; 
	ПервичныйДокумент.ДатаВходящегоДокумента	= Дата(ДатаПерв);
	
	Если ТекСчет="60.01" ИЛИ ТекСчет="60.21" ИЛИ ТекСчет="60.31" Тогда		// Задолженность перед поставщиками
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ПриобретениеУПоставщика;
	ИначеЕсли ТекСчет="60.02" ИЛИ ТекСчет="60.22" ИЛИ ТекСчет="60.32" Тогда // Авансы выданные поставщикам
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику;
	ИначеЕсли ТекСчет="62.01" ИЛИ ТекСчет="62.21" ИЛИ ТекСчет="62.31" Тогда // Задолженность клиентов
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.РеализацияКлиенту;
	ИначеЕсли ТекСчет="62.02" ИЛИ ТекСчет="62.22" ИЛИ ТекСчет="62.32" Тогда // Авансы, полученные от клиентов
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаОтКлиента;
	КонецЕсли;
	
	//Если Лев(ТекСчет,2)="60" Тогда
	//	ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику;
	//ИначеЕсли Лев(ТекСчет,2)="62" Тогда
	//	ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаОтКлиента;
	//КонецЕсли;
	                                      
	ПервичныйДокумент.Записать();
	Возврат ПервичныйДокумент.Ссылка;
КонецФункции


