&НаСервереБезКонтекста
Функция ПолучитьДоговорИзРегистраДублей(СсылкаДоговораФилиала)   
	
	СсылкаДоговораГоловнойОрганизации = Неопределено;
	//надо найти договор головной для схемы ОП			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	тн_ДублиДоговоровФилиала.ДоговорГоловнойОрганизации КАК ДоговорГоловнойОрганизации
		 |ИЗ
		 |	РегистрСведений.тн_ДублиДоговоровФилиала КАК тн_ДублиДоговоровФилиала
		 |ГДЕ
		 |	тн_ДублиДоговоровФилиала.ДоговорФилиала = &ДоговорФилиала";
	
	Запрос.УстановитьПараметр("ДоговорФилиала", СсылкаДоговораФилиала);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СсылкаДоговораГоловнойОрганизации = ВыборкаДетальныеЗаписи.ДоговорГоловнойОрганизации;
	КонецЦикла;		
	Возврат СсылкаДоговораГоловнойОрганизации;   
	
КонецФункции			

