		нСтрРасшифровка.ИмяВФормуле  = ТекстЯчейки;
		нСтрРасшифровка.ИндексПоказателя   = 0;

		нСтрРасшифровка = РасшифровкаФормулы.Добавить();
		нСтрРасшифровка.Показатель   = СтрПоказатель.Ссылка;
		нСтрРасшифровка.ИмяВФормуле  = ТекстЯчейки+"#"+ИндексОперанда;
		нСтрРасшифровка.ИндексПоказателя   = 1;
				
		Если ЗначениеЗаполнено(СтрКолонка.Сценарий) Тогда
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "Сценарий";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "Сценарий\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.Равно)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.Сценарий);
		КонецЕсли;	
		Если  ЗначениеЗаполнено(СтрКолонка.Организация) Тогда		
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "Организация";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "Организация\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.Равно)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.Организация);
		КонецЕсли;	
		Если  ЗначениеЗаполнено(СтрКолонка.Проект) Тогда						
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "Проект";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "Проект\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.Равно)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.Проект);
		КонецЕсли;	
		Если  ЗначениеЗаполнено(СтрКолонка.ПериодОтчета) Тогда	
			
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "ПериодС";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.Равно)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.ПериодОтчета);

			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "ПериодПо";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "ПериодПо\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.Равно)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.ПериодОтчета);

		КонецЕсли;	
		Если  ЗначениеЗаполнено(СтрКолонка.ПериодСдвиг) Тогда							
				
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "ПериодС";
			Если УстановитьОтборДляОстатка Тогда
				нРасшифровкаГруппОтборовОперандов.Значение 		= "ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияСоСдвигом)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.ПериодСдвиг);
			Иначе	
				нРасшифровкаГруппОтборовОперандов.Значение 		= "ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодНачалаСоСдвигом)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.ПериодСдвиг);
			КонецЕсли;
	
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			нРасшифровкаГруппОтборовОперандов.Ключ          = "ПериодПо";
			нРасшифровкаГруппОтборовОперандов.Значение 		= "ПериодПо\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияСоСдвигом)+"\"+ЗначениеВСтрокуВнутр(СтрКолонка.ПериодСдвиг);

		КонецЕсли;	

		//Дополнить отборами строки раскрытия.
		Если ЭтоОбластьСинтетики Тогда
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки;
			ДополнитьОтборыСинтетикиРаскрытиямиАналитикСтрок(СтруктураПараметров,нРасшифровкаГруппОтборовОперандов);
			
			нРасшифровкаГруппОтборовОперандов 				= РасшифровкаОперандовФормулы.Добавить();
			нРасшифровкаГруппОтборовОперандов.ИмяОперанда  	= ТекстЯчейки+"#"+ИндексОперанда;
			ДополнитьОтборыСинтетикиРаскрытиямиАналитикСтрок(СтруктураПараметров,нРасшифровкаГруппОтборовОперандов);
		КонецЕсли;

			
		СтруктураРасшифровки.Вставить("РасшифровкаГруппОтборовОперандов"			,ЗначениеВСтрокуВнутр(РасшифровкаОперандовФормулы));
		СтруктураРасшифровки.Вставить("РасшифровкаФормулы"							,ЗначениеВстрокуВнутр(РасшифровкаФормулы));
		СтруктураРасшифровки.Вставить("ТекстФормулы"								,ТекстФормулы);
		ОбластьЯчейки.Имя 	= "Формула_"+СтрЗаменить(Новый УникальныйИдентификатор(),"-",""); 	
		ОбластьЯчейки.ЦветФона      =  СтруктураПараметров.СтруктураОформления.ОбластьЯчейкаАгрегат.ЦветФона;

		ИндексОперанда = ИндексОперанда +1;

	КонецЕсли;
	
	//Если это итог по остаточному показателю, то установим отбор по периоду окончания
	Если СтрПоказатель.СпособРасчетаИтогаПоПериоду = Перечисления.ВидыИтоговПоказателяПоПериоду.Остаток
		И ЭтоОбластьСинтетики 
		И СтруктураПараметров.АналитикиКолонок.Количество()=1 Тогда
		Если НЕ РасшифровкаГруппОтборов.Свойство("ПериодС") Тогда
			РасшифровкаГруппОтборов.Вставить("ПериодС","ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета)+"\");
		КонецЕсли;		
	КонецЕсли;	
	
	Если РасшифровкаГруппОтборов.Количество()>0 Тогда
		СтруктураРасшифровки.Вставить("РасшифровкаГруппОтборов",РасшифровкаГруппОтборов);
	КонецЕсли;	
					
	ОбластьЯчейки.Расшифровка 	 = СтруктураРасшифровки;
	
КонецПроцедуры

Процедура УстановитьФормулуТаблицыПоНастройке(СтруктураПараметров,СтрокаФормула = Неопределено,КолонкаФормула = Неопределено) Экспорт 
	
	НастройкиВычисляемыхВыраженийСводнойТаблицы = СтруктураПараметров.НастройкиВычисляемыхВыраженийСводнойТаблицы;
	ПолеТабличногоДокументаШаблон               = СтруктураПараметров.ПолеТабличногоДокументаШаблон;
	
	Для Каждого Формула Из НастройкиВычисляемыхВыраженийСводнойТаблицы Цикл
		
		УстановитьФормулуВШаблоне(СтруктураПараметров,Формула);
		
	КонецЦикла;	
		
	
КонецПроцедуры	

Процедура УстановитьФормулуВШаблоне(СтруктураПараметров,Формула)
		
    СтрокиТопологии = СтруктураПараметров.ТопополгияОбластейШаблонаМакета.НайтиСтроки(Новый Структура("СтрокаФормула,КолонкаФормула",Формула.СтрокаФормула,Формула.КолонкаФормула));
	
	Для Каждого СтрШабона Из СтрокиТопологии Цикл
		
		ОбластьФормулыШаблона =  СтруктураПараметров.ПолеТабличногоДокументаШаблон.Область(СтрШабона.ИмяОбласти);
		
		СтруктураРасшифровки = Новый Структура;
			
		Если ЗначениеЗаполнено(Формула.РасшифровкаГруппОтборовОперандов) Тогда
			СтруктураРасшифровки.Вставить("РасшифровкаГруппОтборовОперандов"			,Формула.РасшифровкаГруппОтборовОперандов);
		КонецЕсли;
		
		СтруктураРасшифровки.Вставить("РасшифровкаФормулы"							,Формула.РасшифровкаФормулы);
		СтруктураРасшифровки.Вставить("ТекстФормулы"								,Формула.ТекстФормулы);
		
		
		ОбластьФормулыШаблона.Расшифровка   = СтруктураРасшифровки;
		ОбластьФормулыШаблона.Имя 			= "Формула_"+СтрЗаменить(Новый УникальныйИдентификатор(),"-",""); 	
		ОбластьФормулыШаблона.ЦветФона      =  СтруктураПараметров.СтруктураОформления.ОбластьЯчейкаАгрегат.ЦветФона;
        ОбластьФормулыШаблона.Текст         =  НСтр("ru = 'Формула'");    
		
	КонецЦикла;	


КонецПроцедуры	

Функция ПолучитьГруппуРаскрытияФормулы(СтруктураПараметров,Формула)

	ОперандыФормулы  = СтруктураПараметров.РасшифровкаФормулТаблицы.НайтиСтроки(Новый Структура("СтрокаФормула",Формула));
	
	СтруктураУникальныхАналитик = Новый Структура;
	
	Для Каждого СтрОперанд Из ОперандыФормулы Цикл
		
		тПоказатель = СтруктураПараметров.текПоказатели.Найти(СтрОперанд.Показатель,"Ссылка"); 
		ТекАналитики = СтруктураПараметров.кэшРаскрытияПоказателей_.Найти(тПоказатель.Строка,"СтрокаОтчета");
		Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			Если ЗначениеЗаполнено(ТекАналитики["ВидАналитики"+Инд+"Код"])  Тогда			
				СтруктураУникальныхАналитик.Вставить(ТекАналитики["ВидАналитики"+Инд+"Код"],ТекАналитики["ВидАналитики"+Инд]);
			КонецЕсли;	
			
		КонецЦикла;	
				
	КонецЦикла;	
	
	Если СтруктураУникальныхАналитик.Количество()=0 Тогда
		Возврат Неопределено;
	Иначе
		АналитикиФормулы 	= СтруктураПараметров.кэшРаскрытияПоказателей_.СкопироватьКолонки();
		НоваяСтрокаАналитик = АналитикиФормулы.Добавить();
	
		ИндексАналитики = 1;
		Для Каждого СтрУникальнаяАналитика Из СтруктураУникальныхАналитик Цикл
			
			Если ИндексАналитики>ПараметрыСеанса.ЧислоДопАналитик Тогда
				 Прервать;
			КонецЕсли;	
			
			НоваяСтрокаАналитик["ВидАналитики"+ИндексАналитики+"Код"] 	=  СтрУникальнаяАналитика.Ключ;
			НоваяСтрокаАналитик["ВидАналитики"+ИндексАналитики] 		=  СтрУникальнаяАналитика.Значение;
			
			ИндексАналитики = ИндексАналитики+1;
			
		КонецЦикла;	
				
		Возврат НоваяСтрокаАналитик; 
		
	КонецЕсли;	
	

КонецФункции	

Процедура УстановитьОтборыОстаточногоПоказателя(Расшифровка) Экспорт
	
	Если НЕ Расшифровка.Свойство("РасшифровкаГруппОтборов") Тогда	
		РасшифровкаГруппОтборов = Новый Структура;	
		РасшифровкаГруппОтборов.Вставить("ПериодС","ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета)+"\");
		Расшифровка.Вставить("РасшифровкаГруппОтборов",РасшифровкаГруппОтборов);
	Иначе	
		Если Не Расшифровка.РасшифровкаГруппОтборов.Свойство("ПериодС") Тогда
			Расшифровка.РасшифровкаГруппОтборов.Вставить("ПериодС","ПериодС\"+ЗначениеВСтрокуВнутр(Перечисления.ВидыСравненияПоказателейОтчетов.ПериодОкончанияОтчета)+"\");
		КонецЕсли;	
		
	КонецЕсли;	
		
КонецПроцедуры	


//Если у раскрытия текущей строки есть предопределенные раскрытия с отборами, то необходимо дополнить синтетику этими отборами 
Процедура ДополнитьОтборыСинтетикиРаскрытиямиАналитикСтрок(СтруктураПараметров,РасшифровкаГруппОтборов)
	
	НастройкаОтбораСКД   = СтруктураПараметров.НастройкиСоставаАналитикиСтрокСводнойТаблицы.НайтиСтроки(Новый Структура("СтрокаОтчета",СтруктураПараметров.СтрСтрока.СтрокаОтчета)); 
	
	Для Каждого СтрОтбор Из НастройкаОтбораСКД Цикл
		
		РасшифровкаПоля = СтруктураПараметров.НастройкиПолейСводнойТаблицы.Найти(СтрОтбор.Назначение,"Поле");
		
		Если РасшифровкаПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ЗначениеОтбора = ЗначениеИзСтрокиВнутр(СтрОтбор.ЗначениеНастройки);
		Для Каждого тОтбор Из ЗначениеОтбора.Элементы Цикл
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ПолеКод",РасшифровкаПоля.КодПоля);
			СтруктураОтбора.Вставить("Поле",Строка(СтрОтбор.Назначение));
			СтруктураОтбора.Вставить("Отбор",АналитическийБланкГенерацияМакетаУХСервер.ПолучитьОтборПоказателяПоОтборуСКД(тОтбор.ВидСравнения));
			СтруктураОтбора.Вставить("ЗначениеОтбора",тОтбор.ПравоеЗначение);
			
			Если ТипЗнч(РасшифровкаГруппОтборов) = Тип("Структура") Тогда  //Для показателей
				 АналитическийБланкГенерацияМакетаУХСервер.СформироватьСтрокуОтбора(РасшифровкаГруппОтборов,СтруктураОтбора);
			Иначе //Для операндов формул.	
				
				РасшифровкаГруппОтборов_ = Новый Структура;
				АналитическийБланкГенерацияМакетаУХСервер.СформироватьСтрокуОтбора(РасшифровкаГруппОтборов_,СтруктураОтбора);
				РасшифровкаГруппОтборов.Ключ 		= РасшифровкаПоля.КодПоля;
				РасшифровкаГруппОтборов.Значение    = РасшифровкаГруппОтборов_[РасшифровкаПоля.КодПоля];
				
			КонецЕсли;	
								
		КонецЦикла;
		
	КонецЦикла;	
	
	
КонецПроцедуры	

Процедура УстановитьШаблонУсловногоОформления(СтруктураОформления,МакетШаблонаСводнойТаблицы = Неопределено) Экспорт
	
	Если МакетШаблонаСводнойТаблицы = Неопределено Тогда
		 МакетШаблонаСводнойТаблицы 	= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьМакет("МакетШаблонаСводнойТаблицы"); 
	КонецЕсли;	
	
	МассивСвойствОбластей = Новый Массив();
	
	МассивСвойствОбластей.Добавить("ЦветФона");
	МассивСвойствОбластей.Добавить("ЦветТекста");
	МассивСвойствОбластей.Добавить("ГраницаСверху");
    МассивСвойствОбластей.Добавить("ГраницаСнизу");
    МассивСвойствОбластей.Добавить("ГраницаСлева");
    МассивСвойствОбластей.Добавить("ГраницаСправа");
    МассивСвойствОбластей.Добавить("ЦветРамки");
    МассивСвойствОбластей.Добавить("ВертикальноеПоложение");
    МассивСвойствОбластей.Добавить("ГоризонтальноеПоложение");
    МассивСвойствОбластей.Добавить("Шрифт");
    МассивСвойствОбластей.Добавить("РазмещениеТекста");

    МассивМакетовОбластей  = Новый Массив;
	
	МассивМакетовОбластей.Добавить("ЗаголовокШапкиСводнойТаблицы");
	МассивМакетовОбластей.Добавить("ЗаголовокКолонкиСводнойТаблицы");
	МассивМакетовОбластей.Добавить("ЗаголовокСтрокиСводнойТаблицы");
	МассивМакетовОбластей.Добавить("ЗаголовокАналитикиСводнойТаблицы");
    МассивМакетовОбластей.Добавить("ОбластьЯчейкаАгрегат");
	МассивМакетовОбластей.Добавить("ОбластьЯчейкаНеЗаблокировано");
	МассивМакетовОбластей.Добавить("ОбластьЯчейкаЗаблокировано");

	Для Каждого Обл Из МассивМакетовОбластей Цикл
		
		СтруктураСвойствОформления          = Новый Структура;

		Для Каждого Свойство Из МассивСвойствОбластей Цикл
			
			СтруктураСвойствОформления.Вставить(Свойство,МакетШаблонаСводнойТаблицы.ПолучитьОбласть(Обл).Область(1,1,1,1)[Свойство]);
			
		КонецЦикла;	
		
		СтруктураОформления.Вставить(Обл,СтруктураСвойствОформления);
		
	КонецЦикла;
	
		
КонецПроцедуры	

Процедура СгенерироватьШапкуТаблицы(СтруктураПараметров);
	
	ПолеТабличногоДокументаШаблон       = СтруктураПараметров.ПолеТабличногоДокументаШаблон; // ТабличныйДокумент
	КартинкаМакета          			= СтруктураПараметров.КартинкаМакета;
    ВыводитьАналитикиСтрокВИерархии 	= СтруктураПараметров.ВыводитьАналитикиСтрокВИерархии;
	ВыводитьАналитикиКолонокВИерархии 	= СтруктураПараметров.ВыводитьАналитикиКолонокВИерархии;
    АналитикиСтрок  					= СтруктураПараметров.АналитикиСтрок;
	АналитикиКолонок 					= СтруктураПараметров.АналитикиКолонок;
	нСтрока 							= СтруктураПараметров.нСтрока;
	нКолонка 							= СтруктураПараметров.нКолонка;
    СтруктураОформления                 = СтруктураПараметров.СтруктураОформления;
	НастройкиСоставаКолонокСводнойТаблицы = СтруктураПараметров.НастройкиСоставаКолонокСводнойТаблицы;
	НастройкиПолейСводнойТаблицы        = СтруктураПараметров.НастройкиПолейСводнойТаблицы;
	
	Если ВыводитьАналитикиСтрокВИерархии Тогда 
		Если ВыводитьАналитикиКолонокВИерархии Тогда
			
		Иначе	
			//Выводим колонку заголовка
			КартинкаВыведена = Ложь;
			текКолонкаВывода =  нКолонка;
			ВывестиОбластьШаблона(ПолеТабличногоДокументаШаблон.Область(нСтрока,нКолонка,нСтрока,нКолонка),СтруктураОформления.ЗаголовокШапкиСводнойТаблицы,НСтр("ru = 'Сводная таблица'"));	
			ПолеТабличногоДокументаШаблон.Область(0,текКолонкаВывода,0,текКолонкаВывода).ШиринаКолонки = 35;
			текСтрокаВывода 	= нСтрока;
			
			СтруктураПараметров.Вставить("нКолонкаНачалаПоказателей",ПолеТабличногоДокументаШаблон.ШиринаТаблицы);
			
			Для Каждого СтрАналитикаКолонки Из АналитикиКолонок Цикл
				
				текКолонкаВывода    = нКолонка;
				
				ВывестиОбластьШаблона(ПолеТабличногоДокументаШаблон.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода),СтруктураОформления.ЗаголовокШапкиСводнойТаблицы,НСтр("ru = 'Сводная таблица'"));	
				ПолеТабличногоДокументаШаблон.Область(0,текКолонкаВывода,0,текКолонкаВывода).ШиринаКолонки = 35;
				текСтрокаВывода = текСтрокаВывода +1;
				
			КонецЦикла;
			
			//Объединяем ячейки
			текКолонкаВывода    = нКолонка;
			ПолеТабличногоДокументаШаблон.Область(нСтрока,текКолонкаВывода,ПолеТабличногоДокументаШаблон.ВысотаТаблицы,текКолонкаВывода).Объединить();
			текКолонкаВывода = текКолонкаВывода+1;
			
			текСтрокаВывода  							= нСтрока;
			текКолонкаВывода 							= ПолеТабличногоДокументаШаблон.ШиринаТаблицы+1;
			КолонкаЗаголовкаРесурсов 					= ПолеТабличногоДокументаШаблон.ШиринаТаблицы+1;
			ИндексСтрокиРесурсов        				= Неопределено;			
			
			//Генерация раскрытия по колонкам
			Для Каждого СтрКолонка Из НастройкиСоставаКолонокСводнойТаблицы Цикл
				
				Если Не СтрКолонка.ПризнакИспользования Тогда
					Продолжить;
				КонецЕсли;	
				
				СтруктураРасшифровкиАналитикКолонки  		= Новый Структура;
				
				Для Каждого СтрАналитикаКолонки Из АналитикиКолонок Цикл
					Если НЕ СтрАналитикаКолонки.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.КолонкиОтчетов Тогда
						
						СвойстваАналитики = НастройкиПолейСводнойТаблицы.НайтиСтроки(Новый Структура("КодПоля,ПутьКРеквизиту",СтрАналитикаКолонки.КодПоля,СтрАналитикаКолонки.ПутьКРеквизиту))[0];
						ПредставлениеПоля = СвойстваАналитики.ВыражениеПредставления;
	
						ВывестиОбластьШаблона(ПолеТабличногоДокументаШаблон.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода),СтруктураОформления.ЗаголовокКолонкиСводнойТаблицы,ПредставлениеПоля);	
