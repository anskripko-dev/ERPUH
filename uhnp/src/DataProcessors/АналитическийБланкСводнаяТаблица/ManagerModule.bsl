			Нстр.Поле         			= Стр.ТипСубконто;
		ИначеЕсли Стр.Код = "Фильтр_Показатели" Тогда
			Нстр.Поле         			= Перечисления.ПостоянныеПоляСводнойТаблицы.СтрокиОтчетов;
