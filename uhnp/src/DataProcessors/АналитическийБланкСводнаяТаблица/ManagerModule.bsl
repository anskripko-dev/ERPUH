	Запрос.УстановитьПараметр("ВариантСводнойТаблицы",ВариантСводнойТаблицы);
	
	Результат = Запрос.ВыполнитьПакет();
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("НастройкиСоставаСтрокСводнойТаблицы",Результат[0].Выгрузить());
	СтруктураОтвета.Вставить("НастройкиРасположенияПолейСводнойТаблицы",Результат[1].Выгрузить());
	СтруктураОтвета.Вставить("НастройкиСоставаКолонокСводнойТаблицы",Результат[2].Выгрузить());
	СтруктураОтвета.Вставить("НастройкиПериодовСводнойТаблицы",Результат[3].Выгрузить());
	СтруктураОтвета.Вставить("НастройкиПолейСводнойТаблицы",Результат[4].Выгрузить());
	СтруктураОтвета.Вставить("НастройкиВариантаСводнойТаблицы",Результат[5].Выгрузить());
	
	ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиСоставаСтрокСводнойТаблицы);
	ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиСоставаКолонокСводнойТаблицы);
	
	Если СтруктураОтвета.НастройкиРасположенияПолейСводнойТаблицы.Количество()>0 Тогда 
		ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиРасположенияПолейСводнойТаблицы);
	КонецЕсли;
	
	ЭтаФорма["НастройкиПолейСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиПолейСводнойТаблицы);
	
	Для Каждого СтрПоле Из ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"] Цикл
		СтрПоле.ТипСтрока = Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(СтрПоле.Поле);
	КонецЦикла;	
	
	Если СтруктураОтвета.НастройкиПериодовСводнойТаблицы.Количество()>0 Тогда 
		ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиПериодовСводнойТаблицы);
	КонецЕсли;
	
	Если СтруктураОтвета.НастройкиВариантаСводнойТаблицы.Количество()>0 Тогда 
		ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Загрузить(СтруктураОтвета.НастройкиВариантаСводнойТаблицы);
	КонецЕсли;
	
	тНастройкиСоставаАналитикиСтрокСводнойТаблицы =  РегистрыСведений.НастройкиСоставаАналитикиСтрокСводнойТаблицы.СоздатьНаборЗаписей();
	тНастройкиСоставаАналитикиСтрокСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	тНастройкиСоставаАналитикиСтрокСводнойТаблицы.Прочитать();	
	ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Загрузить(тНастройкиСоставаАналитикиСтрокСводнойТаблицы.Выгрузить());
	
	//Закэшированные настройки макета
	ЭтаФорма["СтруктураНастроекАналитическогоБланкаАдрес"] = "";
	СтруктураНастроекАналитическогоБланка  = Новый Структура;
	
	текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	Если  текНаборЗаписей.Количество() =1 Тогда			
		ЗначениеСохраняемойНастройки = текНаборЗаписей[0].ХранилищеДополнительныхНастроек.Получить();	
		СтруктураНастроекАналитическогоБланка.Вставить("НастройкиАналитическихБланков",ЗначениеСохраняемойНастройки);
		Если НЕ ПолеТабличногоДокументаШаблон = Неопределено Тогда
			ПолеТабличногоДокументаШаблон.Вывести(ЗначениеСохраняемойНастройки.ТабДокМакет);
		КонецЕсли;	
		Если НЕ ПолеТабличногоДокументаНастройкаМакета = Неопределено И ЗначениеСохраняемойНастройки.Свойство("ПолеТабличногоДокументаНастройкаМакета") Тогда
			ПолеТабличногоДокументаНастройкаМакета.Вывести(ЗначениеСохраняемойНастройки.ПолеТабличногоДокументаНастройкаМакета);
		КонецЕсли;		
	Иначе	
		Возврат; //Нет закэшированного макета, далее нечего загружать. 
	КонецЕсли;	
	
	//Поля через точку
	текНаборЗаписей = РегистрыСведений.НастройкиПроизводныхПолейСводнойТаблицы.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	Для Каждого СтрНастройка Из текНаборЗаписей Цикл
		
		НПроизводноеПоле = ЭтаФорма["НастройкиПроизводныхПолейСводнойТаблицы"].Добавить();
		ЗаполнитьЗначенияСвойств(НПроизводноеПоле,СтрНастройка);
		НПроизводноеПоле.ТипЗначенияПоля = ЗначениеИзСтрокиВнутр(СтрНастройка.ТипЗначенияПоляСтрока);
		
	КонецЦикла;	
	
	//Формулы таблицы
	ЭтаФорма["НастройкиВычисляемыхВыраженийСводнойТаблицы"].Очистить();
	текНаборЗаписей = РегистрыСведений.НастройкиВычисляемыхВыраженийСводнойТаблицы.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	Для Каждого СтрНастройка Из текНаборЗаписей Цикл
		
		НПроизводноеПоле = ЭтаФорма["НастройкиВычисляемыхВыраженийСводнойТаблицы"].Добавить();
		ЗаполнитьЗначенияСвойств(НПроизводноеПоле,СтрНастройка);
		
	КонецЦикла;	
	
	//Условное оформление таблицы
	текНаборЗаписей = РегистрыСведений.НастройкиУсловногоОформленияСводнойТаблицы.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	Если текНаборЗаписей.Количество() = 1 Тогда
		ЭтаФорма["НастройкиУсловногоОформленияСводнойТаблицы"].Загрузить(ЗначениеИзСтрокиВнутр(текНаборЗаписей[0].УсловноеОформление));
	КонецЕсли;
		
	текНаборЗаписей = РегистрыСведений.КэшГруппОтборовПоказателей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("КэшГруппОтборовПоказателей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.РасшифровкаГруппОтборов.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("РасшифровкаГруппОтборов",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.КэшИменОбластейПоказателей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("КэшИменОбластейПоказателей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.КэшИменОбластейПоказателей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("КэшРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.НастройкиРаскрываемыхОбластей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("НастройкиРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.НастройкиТаблицРаскрываемыхОбластей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("НастройкиТаблицРаскрываемыхОбластей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.КэшИменФормул.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("КэшИменФормул",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.КэшФормулОбластейПоказателей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("КэшФормулОбластейПоказателей",текНаборЗаписей.Выгрузить());
	
	текНаборЗаписей = РегистрыСведений.РасшифровкаФормулОбластейПоказателей.СоздатьНаборЗаписей();
	текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
	текНаборЗаписей.Прочитать();
	СтруктураНастроекАналитическогоБланка.Вставить("РасшифровкаФормулОбластейПоказателей",текНаборЗаписей.Выгрузить());
	
	ЭтаФорма["СтруктураНастроекАналитическогоБланкаАдрес"] = ПоместитьВоВременноеХранилище(СтруктураНастроекАналитическогоБланка,ЭтаФорма.УникальныйИдентификатор);
	
	
	Если РежимМоделирования Тогда
		
		текНаборЗаписей = РегистрыСведений.НастройкиЦелевыхПоказателейМоделирование.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.ВариантАнализа.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		ЭтаФорма["ТаблицаВыделенныхПоказателейМоделирование"].Загрузить(текНаборЗаписей.Выгрузить());
		НомерСтроки = 0;
		
		Для Каждого Стр Из ЭтаФорма["ТаблицаВыделенныхПоказателейМоделирование"] Цикл
			Стр.НомерСтроки 		= НомерСтроки;
			НомерСтроки 			= НомерСтроки+1;
			
			МассивПериодов = Неопределено;
			ТекущаяПериодичность = ЭтаФорма["ПериодС"].Периодичность;
			Если  НЕ Стр.ПериодОтчета.Периодичность = ТекущаяПериодичность Тогда
				МассивПериодов = ЭтаФорма.ПолучитьПериодыПотомки(Стр.ПериодОтчета,ТекущаяПериодичность);
			КонецЕсли;	
				
			//Значения показателей пересчитываем
			Стр.Значение    		= ПолучитьЗначениеЦелевогоПоказателя(Стр,Ложь,МассивПериодов,Истина);
			Стр.ЗначениеМодель    	= ПолучитьЗначениеЦелевогоПоказателя(Стр,Истина,МассивПериодов,Истина);
			
		КонецЦикла;	
		
		текНаборЗаписей = РегистрыСведений.НастройкиАнализируемыхПоказателейМоделирование.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.ВариантАнализа.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		ЭтаФорма["ТаблицаЧувствительностиФакторов"].Загрузить(текНаборЗаписей.Выгрузить());
		
		//Значения показателей пересчитываем
		Для Каждого Стр Из ЭтаФорма["ТаблицаЧувствительностиФакторов"] Цикл
			Стр.ВидОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Показатель, "Владелец");			
			Стр.БазовоеЗначение    		= ПолучитьЗначениеЦелевогоПоказателя(Стр,Ложь,,Истина);
			Стр.ЗначениеМоделирование   = ПолучитьЗначениеЦелевогоПоказателя(Стр,Истина,,Истина);	
			ЭтаФорма.ПересчитатьКонечнуюСуммуИОтклоненияСервер(ЭтаФорма.Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование,Стр);
		КонецЦикла;	
		
		текНаборЗаписей = РегистрыСведений.НастройкиАналитическогоРазрезаМоделирование.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.ВариантАнализа.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Прочитать();
		
		ЭтаФорма["ДетализацияАналитикВлияние"].Очистить();
		Для Каждого Стр Из текНаборЗаписей Цикл	
			Нстр = ЭтаФорма["ДетализацияАналитикВлияние"].Добавить(Стр.ВидАналитики,Стр.ВидАналитикиПредставление,Стр.Пометка);		
		КонецЦикла;		

		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура CгенерироватьШаблонСводнойТаблицы(ЭтаФорма) Экспорт
	    
	ПолеТабличногоДокументаШаблон = Новый ТабличныйДокумент;
	
	СтруктураПараметровВход = Новый Структура;
	
	СтруктураПараметровВход.Вставить("ПолеТабличногоДокументаШаблон",ПолеТабличногоДокументаШаблон);
	СтруктураПараметровВход.Вставить("НастройкиСоставаСтрокСводнойТаблицы",ЭтаФорма.НастройкиСоставаСтрокСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиСоставаКолонокСводнойТаблицы",ЭтаФорма.НастройкиСоставаКолонокСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиРасположенияПолейСводнойТаблицы",ЭтаФорма.НастройкиРасположенияПолейСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиВариантаСводнойТаблицы",ЭтаФорма.НастройкиВариантаСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиПериодовСводнойТаблицы",ЭтаФорма.НастройкиПериодовСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиПолейСводнойТаблицы",ЭтаФорма.НастройкиПолейСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы",ЭтаФорма.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("УникальныйИдентификатор",ЭтаФорма.УникальныйИдентификатор);
	СтруктураПараметровВход.Вставить("СтруктураНастроекАналитическогоБланкаАдрес","");
	СтруктураПараметровВход.Вставить("НастройкиВычисляемыхВыраженийСводнойТаблицы",ЭтаФорма.НастройкиВычисляемыхВыраженийСводнойТаблицы.Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиУсловногоОформленияСводнойТаблицы",ЭтаФорма.НастройкиУсловногоОформленияСводнойТаблицы.Выгрузить());
	
	СгенерироватьМакетШаблона(СтруктураПараметровВход);
	
	ЭтаФорма.СтруктураНастроекАналитическогоБланкаАдрес = СтруктураПараметровВход.СтруктураНастроекАналитическогоБланкаАдрес;
		
КонецПроцедуры

Процедура СкопироватьНастройкиБланка(БланкИсточник, БланкПриемник) Экспорт

	//Прочитаем основной вариант по бланку
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВариантыСводныхТаблиц.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВариантыСводныхТаблиц КАК ВариантыСводныхТаблиц
	|ГДЕ
	|	ВариантыСводныхТаблиц.Бланк = &Бланк
	|	И ВариантыСводныхТаблиц.ОсновнойВариант = Истина";
	
	Запрос.УстановитьПараметр("Бланк",БланкИсточник);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		ВариантСводнойТаблицыИсточник  = Выборка.Ссылка;			
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ВариантСводнойТаблицыИсточник) Тогда
		 Возврат;
	КонецЕсли;	
	
	ОНовыйВариант = Справочники.ВариантыСводныхТаблиц.СоздатьЭлемент();
	ОНовыйВариант.Бланк        = БланкПриемник.Ссылка;
	ОНовыйВариант.Наименование = Строка(БланкПриемник)+" (Основной)";
	ОНовыйВариант.ОсновнойВариант = Истина;
	ОНовыйВариант.Записать();
	ВариантСводнойТаблицыПриемник      = ОНовыйВариант.Ссылка;
		
	МассивИменКопируемыхРегистров = Новый Массив;
	МассивИменКопируемыхРегистров.Добавить("НастройкиСоставаСтрокСводнойТаблицы");
	МассивИменКопируемыхРегистров.Добавить("НастройкиСоставаКолонокСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиРасположенияПолейСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиПериодовСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиПолейСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиВариантаСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиПроизводныхПолейСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиВычисляемыхВыраженийСводнойТаблицы");
    МассивИменКопируемыхРегистров.Добавить("НастройкиУсловногоОформленияСводнойТаблицы");

	
	Для Каждого ИмяРегистра Из МассивИменКопируемыхРегистров Цикл
		
		текНаборЗаписейИсточник = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		текНаборЗаписейИсточник.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицыИсточник);
		текНаборЗаписейИсточник.Прочитать();
		
		текНаборЗаписейПриемник = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		текНаборЗаписейПриемник.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицыПриемник);
		текНаборЗаписейПриемник.Прочитать();
		
		
		Для Каждого СтрНастройка Из текНаборЗаписейИсточник Цикл
			
			Нстр = текНаборЗаписейПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрНастройка);
			Нстр.ВариантСводнойТаблицы = ВариантСводнойТаблицыПриемник;
			
		КонецЦикла;	
		
		текНаборЗаписейПриемник.Записать(Истина);
		
	КонецЦикла;
	
	текНаборЗаписейИсточник = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписейИсточник.Отбор.Бланк.Установить(ВариантСводнойТаблицыИсточник);
	текНаборЗаписейИсточник.Прочитать();
	
	текНаборЗаписейПриемник = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
	текНаборЗаписейПриемник.Отбор.Бланк.Установить(ВариантСводнойТаблицыПриемник);
	текНаборЗаписейПриемник.Прочитать();
	
	
	Для Каждого СтрНастройка Из текНаборЗаписейИсточник Цикл
		
		Нстр = текНаборЗаписейПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,СтрНастройка);
		Нстр.Бланк = ВариантСводнойТаблицыПриемник;
		
	КонецЦикла;	
	
	текНаборЗаписейПриемник.Записать(Истина);
	
	
	
	Справочники.БланкиОтчетов.ОбновитьКэшБланков(Ложь,БланкПриемник);
			

КонецПроцедуры	
	
#КонецОбласти

#КонецЕсли

