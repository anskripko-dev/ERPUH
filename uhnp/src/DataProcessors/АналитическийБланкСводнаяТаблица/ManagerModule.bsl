#Область ДлительныеОперации

Функция РасчетВлиянияФакторовПолныйПересчет(ПараметрыРасчета) Экспорт
	
	Результат = Новый Структура;
	
	// Выделенный целевой базовый показатель 
	тЦелевыеПоказатели = ПараметрыРасчета.ЦелевыеПоказатели; 
	
	// Преобразуем таблицу факторов к нужному виду	
	тПоказателиФакторов = ПараметрыРасчета.ПоказателиФакторов;
	тДанныеДляПересчета = ПараметрыРасчета.ДанныеДляПересчета;
	ТаблицаЧувствительностиФакторов = ПараметрыРасчета.ТаблицаЧувствительностиФакторов;
	
	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл
		Если Стр.ВключатьВАнализ Тогда
			
			ОбработкаРасчета                               = Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса = ПараметрыРасчета.УникальныйИдентификаторСеанса;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
			
			тРезультат = РассчитатьЧувствительностьПоПоказателю(
				Стр,
				ОбработкаРасчета,
				тЦелевыеПоказатели,
				тПоказателиФакторов,
				Стр.БазовоеЗначение,
				ПараметрыРасчета);
			
			Если тРезультат.Количество() = 1 Тогда
				Стр.Влияние        = тРезультат[0].Влияние;
				Стр.Градиент       = тРезультат[0].Градиент;
				Стр.КоэффГрадиента = тРезультат[0].КоэффГрадиента;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЧувствительностиФакторов.Сортировать("Влияние УБЫВ");

	Результат.Вставить("ТаблицаЧувствительностиФакторов", ТаблицаЧувствительностиФакторов);
	Результат.Вставить("АдресТаблицыСобытий",             "");

	Если ЗначениеЗаполнено(ОбработкаРасчета.АдресТаблицыСобытий) Тогда
		ТаблицаСобытий = ПолучитьИзВременногоХранилища(ОбработкаРасчета.АдресТаблицыСобытий);
		ОбработкаРасчета.АдресТаблицыСобытий = ПоместитьВоВременноеХранилище(ТаблицаСобытий, ПараметрыРасчета.АдресТаблицыСобытий);
		Результат.АдресТаблицыСобытий = ПараметрыРасчета.АдресТаблицыСобытий;
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция РассчитатьЧувствительностьПоПоказателю(
		СтрокаИсходойТаблицы,
		ОбработкаРасчета,
		тЦелевыеПоказатели,
		тПоказателиФакторов,
		ЗначениеДляАнализа,
		ПараметрыРасчета)
	
	тПоказателиФакторов.Очистить();
	
	// Заполним таблицу факторов.
	Нстр = тПоказателиФакторов.Добавить();
	ЗаполнитьЗначенияСвойств(Нстр,СтрокаИсходойТаблицы);
	Нстр.Значение = ЗначениеДляАнализа;
	// Преобразуем строку с аналитиками к инлексам группы раскрытия.
	тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(СтрокаИсходойТаблицы.Показатель);
	ПреобразоватьИндексыАналитик(Нстр, тКэшАналитикПоказателей, ПараметрыРасчета.ДетализацияАналитикВлияние, ПараметрыРасчета.ЧислоДопАналитик);
	ОбработкаРасчета.РассчитатьВлияниеФакторовПоДаннымДляПересчета(
		тЦелевыеПоказатели, тПоказателиФакторов, ПараметрыРасчета.ВалютаОтображения);

	Возврат тПоказателиФакторов; 
	
КонецФункции

#Область ПодборПоказателя

Функция ВыполнитьПоискРешения(ПараметрыПодбора) Экспорт
	
	Результат = Новый Структура;
	
	ТаблицаЧувствительностиФакторов           = ПараметрыПодбора.ТаблицаЧувствительностиФакторов;
	ТаблицаВыделенныхПоказателейМоделирование = ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование;
	
	// Заполним исходные данные для поиска решения
	ТекТаблицаМоделирования = ТаблицаЧувствительностиФакторов.СкопироватьКолонки();
	ТекТаблицаМоделирования.Колонки.Добавить("СтрокаТаблицыЧувствительности");
	ТекТаблицаМоделирования.Колонки.Добавить("ОбработкаВыполнена", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаМоделирования.Колонки.Добавить("ТекущееЗначение",    ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	СтрокиДляАнализа = ТаблицаЧувствительностиФакторов.НайтиСтроки(Новый Структура("ВключатьВАнализ", Истина));
	
	// Подготовим данные для расчета влияния
	// Выделенный целевой базовый показатель 
	тЦелевыеПоказатели = ТаблицаВыделенныхПоказателейМоделирование.Скопировать(Новый Структура("Базовый", Истина));
	
	// Преобразуем таблицу факторов к нужному виду
	тПоказателиФакторов = ТаблицаЧувствительностиФакторов.СкопироватьКолонки();
	тПоказателиФакторов.Колонки.Добавить("Значение", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	ТаблицаЧувствительностиФакторовКопия = ТекТаблицаМоделирования.Скопировать();
	
	тДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Скопировать( , "ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	тДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	тДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
	тДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	тДанныеДляПересчета.ЗаполнитьЗначения(ПараметрыПодбора.ПериодПо, "ПериодОкончания");
	
	ЦелевойПоказательНовоеЗначение = ПараметрыПодбора.ЦелевойПоказательНовоеЗначение;
	
	Если ПараметрыПодбора.КэшДанных <> Неопределено Тогда
		АдресКэшаДанных = ПоместитьВоВременноеХранилище(ПараметрыПодбора.КэшДанных, Новый УникальныйИдентификатор);
	КонецЕсли;
	ОбработкаРасчета = Неопределено;

	Для Каждого Строка Из СтрокиДляАнализа Цикл
		
		Если Строка.Влияние = 0 Тогда //Рассчитаем влияние, если не сделали ранее.
				
			ОбработкаРасчета                               = Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса = ПараметрыПодбора.ИдентификаторДанныхМоделирование;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
			Если АдресКэшаДанных <> Неопределено Тогда
				ОбработкаРасчета.АдресКэшаДанных = АдресКэшаДанных;
			КонецЕсли;
			АдресКэшаДанных = "";
			
			тРезультат = РассчитатьЧувствительностьПоПоказателю(
				Строка,
				ОбработкаРасчета,
				тЦелевыеПоказатели,
				тПоказателиФакторов,
				Строка.ЗначениеМоделирование,
				ПараметрыПодбора);
			
			Если тРезультат.Количество() = 1 Тогда
				Строка.Влияние        = тРезультат[0].Влияние;
				Строка.Градиент       = тРезультат[0].Градиент;
				Строка.КоэффГрадиента = тРезультат[0].КоэффГрадиента;
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = ТекТаблицаМоделирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
		НоваяСтрока.СтрокаТаблицыЧувствительности = Строка;
		НоваяСтрока.ТекущееЗначение = ?(Строка.ЗначениеМоделирование = 0, Строка.БазовоеЗначение, Строка.ЗначениеМоделирование);
		
	КонецЦикла;
	
	ТекЗначениеЦелевогоПоказателя = ПолучитьТекущееЗначениеЦелевогоПоказателя(
		ТаблицаВыделенныхПоказателейМоделирование,
		,
		ПараметрыПодбора.ЧислоДопАналитик,
		ПараметрыПодбора.ИдентификаторДанныхМоделирование);
	
	Если ТекТаблицаМоделирования.Количество()=0 Тогда
		ВызватьИСключение Нстр("ru = 'Не указаны исходные данные для моделирования.'");
	КонецЕсли;

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ТаблицаМоделирования",           ТекТаблицаМоделирования);
	ПараметрыПроверки.Вставить("ТекЗначениеЦелевогоПоказателя",  ТекЗначениеЦелевогоПоказателя);
	ПараметрыПроверки.Вставить("ЦелевойПоказательНовоеЗначение", ПараметрыПодбора.ЦелевойПоказательНовоеЗначение);
	
	Если Не ЗначениеПринципиальноДостижимо(ПараметрыПроверки, ПараметрыПодбора) Тогда
		Если ОбработкаРасчета <> Неопределено И ЗначениеЗаполнено(ОбработкаРасчета.АдресТаблицыСобытий) Тогда
			ВременнаяТаблицаСобытий = ПолучитьИзВременногоХранилища(ОбработкаРасчета.АдресТаблицыСобытий);
			ПоместитьВоВременноеХранилище(ВременнаяТаблицаСобытий, ПараметрыПодбора.АдресТаблицыСобытий);
		КонецЕсли;
		ТекстОшибки = Нстр("ru = 'По указанным параметрам достижение целевого значения невозможно.
			|Выберите другие базовые показатели или измените граничные условия.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ТекТаблицаМоделирования.Сортировать("Влияние Убыв");
	
	РешениеНайдено   = Ложь;
	ЧислоИтераций    = 1;
	ТекСходимость    = 0;
	СходимостьШаг    = 0;
	ИсходнаяТочность = 0.04;
	ТекущаяТочность  = 0.04;
	ВремяСтарта      = ТекущаяДата();
	ТекстСообщения   = "";

	НомерТранзакции  = 99999;
	
	Пока ЧислоИтераций <= 100 Цикл //Делаем максимум 100 итераций
		
		СтрокаДляАнализа = ТекТаблицаМоделирования.Найти(Ложь, "ОбработкаВыполнена");
		
		Если СтрокаДляАнализа = Неопределено Тогда // На текущем шаге итерации все значения были использованы
			
			Если ТекСходимость = 0 Тогда
				
				ТекСходимость = ОбщегоНазначенияУХ.ЗначениеПоМодулю(
					ПолучитьТекущееЗначениеЦелевогоПоказателя(
						ТаблицаВыделенныхПоказателейМоделирование,
						,
						ПараметрыПодбора.ЧислоДопАналитик,
						ПараметрыПодбора.ИдентификаторДанныхМоделирование) - ПараметрыПодбора.ЦелевойПоказательНовоеЗначение);
			
			ИначеЕсли СходимостьШаг >= ТекСходимость Тогда // Не удалось повысить сходимось
				ВызватьИсключение Нстр("ru = 'Не удалось достичь целевого показателя. Выберите другие базовые показатели или расширьте границы изменения.'");
			КонецЕсли;
			
			ТекТаблицаМоделирования.ЗаполнитьЗначения(Ложь, "ОбработкаВыполнена");
			ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования, ПараметрыПодбора);
			
			СтрокаДляАнализа = ТекТаблицаМоделирования[0];
			
			ТекСходимость = СходимостьШаг;
			ЧислоИтераций = ЧислоИтераций + 1;
			
		КонецЕсли;
		
		ВыполнитьГрадиентныйСпуск(
			СтрокаДляАнализа,
			ТекущаяТочность,
			ВремяСтарта,
			НомерТранзакции,
			ПараметрыПодбора);
		
		тЗначениеЦелевого = ПолучитьТекущееЗначениеЦелевогоПоказателя(
			ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование,
			,
			ПараметрыПОдбора.ЧислоДопАналитик,
			ПараметрыПодбора.ИдентификаторДанныхМоделирование);
		Если ДостигнутоЦелевоеЗначение(тЗначениеЦелевого, ТекущаяТочность, ЦелевойПоказательНовоеЗначение) Тогда	
			
			ТекВремяВыполнения = ТекущаяДата();
			
			Если (ТекВремяВыполнения-ВремяСтарта) < 60 И (НЕ ТекущаяТочность = 0.01) Тогда // Проведем поиск по более высокой точности
				
				ТекущаяТочность = ТекущаяТочность / 2;

			Иначе
				
				ТекстСообщения = СохранитьЗначенияМоделирования(
					ТекТаблицаМоделирования,
					,
					тЗначениеЦелевого,
					ЦелевойПоказательНовоеЗначение);
				Прервать;
				
			КонецЕсли;
			
		ИначеЕсли ТекущаяТочность < 0.04 Тогда
			ТекстСообщения = СохранитьЗначенияМоделирования(
				ТекТаблицаМоделирования,
				,
				тЗначениеЦелевого,
				ЦелевойПоказательНовоеЗначение);
			Прервать;
			
		ИначеЕсли НЕ ТекТаблицаМоделирования.Найти(Ложь,"ОбработкаВыполнена") = Неопределено Тогда
			
			ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования, ПараметрыПодбора);
		
		КонецЕсли;
		
		СходимостьШаг = ОбщегоНазначенияУХ.ЗначениеПоМодулю(тЗначениеЦелевого - ЦелевойПоказательНовоеЗначение);
		
	КонецЦикла;
	
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(
		ПараметрыПодбора.ИдентификаторДанныхМоделирование,
		НомерТранзакции);
		
	Результат.Вставить("ТаблицаЧувствительностиФакторов", ТаблицаЧувствительностиФакторов);
	Результат.Вставить("ТекстСообщения",                  ТекстСообщения);
	Результат.Вставить("ЦелевойПоказательНовоеЗначение",  ЦелевойПоказательНовоеЗначение);
	
	// Если есть ошибки для протокола, то перемещаем данные в зарезервированный адрес на форме.
	Если ЗначениеЗаполнено(ПараметрыПодбора.РеквизитыРасчетаИЗаписиПоказателей.АдресТаблицыСобытий) Тогда
		ТаблицаСобытий = ПолучитьИзВременногоХранилища(ПараметрыПодбора.РеквизитыРасчетаИЗаписиПоказателей.АдресТаблицыСобытий);
		ПараметрыПодбора.РеквизитыРасчетаИЗаписиПоказателей.АдресТаблицыСобытий = 
			ПоместитьВоВременноеХранилище(ТаблицаСобытий, ПараметрыПодбора.АдресТаблицыСобытий);
	КонецЕсли;
	Результат.Вставить("РеквизитыРасчетаИЗаписиПоказателей", ПараметрыПодбора.РеквизитыРасчетаИЗаписиПоказателей);
	
	Возврат Результат;
	
КонецФункции
	
Функция СохранитьЗначенияМоделирования(
		ТекТаблицаМоделирования,
		ПоискЭкстремума = Ложь,
		ДостигнутоеЗначениеЦелевого,
		ЦелевойПоказательНовоеЗначение)
	
	МассивПоказателей = Новый Массив;
	ТекстСообщения    = "";
	
	Для Каждого Строка Из ТекТаблицаМоделирования Цикл
		
		Если Строка.ТекущееЗначение = Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Строка.СтрокаТаблицыЧувствительности.ЗначениеДляЛогаИзменений = Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование;
		Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование    = Строка.ТекущееЗначение;
		Строка.СтрокаТаблицыЧувствительности.ПризнакИзменения         = Истина;
		
		ПересчитатьКонечнуюСуммуИОтклонения(Строка.СтрокаТаблицыЧувствительности);
		
	КонецЦикла;
		
	Если НЕ ПоискЭкстремума Тогда
		
		СтрокаШаблона = Нстр("ru = 'Моделирование выполнено. Достигнуто целевое значение %1'");
		
		ТекстСообщения= "";
		Если Не ПустаяСтрока(СтрокаШаблона) тогда
			ТекстСообщения = СтрШаблон(СтрокаШаблона, Формат(ДостигнутоеЗначениеЦелевого,"ЧЦ=18; ЧДЦ=5"));
		КонецЕсли;
		
		Если НЕ (ЦелевойПоказательНовоеЗначение = 0 ИЛИ ДостигнутоЦелевоеЗначение(ДостигнутоеЗначениеЦелевого, 0.02, ЦелевойПоказательНовоеЗначение)) Тогда
			
			ТочностьМоделирования = ОбщегоНазначенияУХ.ЗначениеПоМодулю(
				(ЦелевойПоказательНовоеЗначение - ДостигнутоеЗначениеЦелевого) / ЦелевойПоказательНовоеЗначение) * 100;
			
			СтрокаШаблона = Нстр("ru = '
			|Отклонение от заданного значения %1 = %2 %%.
			|Для повышения точности выберите другие базовые показатели или измените граничные условия.'");
			
			Если Не ПустаяСтрока(СтрокаШаблона) Тогда
				ТекстСообщения = ТекстСообщения + СтрШаблон(СтрокаШаблона, Формат(ЦелевойПоказательНовоеЗначение,"ЧЦ=18; ЧДЦ=5"), Формат(ТочностьМоделирования,"ЧЦ=10; ЧДЦ=2"));
			КонецЕсли;
		
		КонецЕсли;
		
		ЦелевойПоказательНовоеЗначение = ДостигнутоеЗначениеЦелевого;
		
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

Процедура ПересчитатьКонечнуюСуммуИОтклонения(тСтрокаТаблицы)
	
	тСтрокаТаблицы.ОтклонениеАБС = тСтрокаТаблицы.ЗначениеМоделирование - тСтрокаТаблицы.БазовоеЗначение;
	Если тСтрокаТаблицы.БазовоеЗначение = 0 Тогда
		тСтрокаТаблицы.ОтклонениеОтн = 0;
	Иначе	 
		тСтрокаТаблицы.ОтклонениеОтн = 
			((тСтрокаТаблицы.ЗначениеМоделирование - тСтрокаТаблицы.БазовоеЗначение) / тСтрокаТаблицы.БазовоеЗначение) * 100;
	КонецЕсли;

КонецПроцедуры
	
Процедура ВыполнитьГрадиентныйСпуск(
		СтрокаМоделирования,
		ТекущаяТочность,
		ВремяСтарта,
		НомерТранзакции,
		ПараметрыПодбора)
		
	СтрокаМоделирования.ОбработкаВыполнена = Истина;
	ЦелевойПоказательНовоеЗначение = ПараметрыПодбора.ЦелевойПоказательНовоеЗначение;
		
	ТекЗначениеЦелевого = ПолучитьТекущееЗначениеЦелевогоПоказателя(
		ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование,
		,
		ПараметрыПОдбора.ЧислоДопАналитик,
		ПараметрыПодбора.ИдентификаторДанныхМоделирование);
	НеобходимоеИзменение = ЦелевойПоказательНовоеЗначение - ТекЗначениеЦелевого;
	ТекСходимость        = ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
	СходимостьШаг        = 0;
	
	РасчетВыполнен       = Истина;
	ЕстьСходимость       = Истина;
	РабочаяТочность      = ТекущаяТочность;
	
	Пока ЕстьСходимость Цикл
		
		Если СтрокаМоделирования.Градиент = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекШагРасчета = НеобходимоеИзменение * СтрокаМоделирования.КоэффГрадиента / СтрокаМоделирования.Градиент;
		
		// Проверим на соответствие граничным условиям.
		Если ЗначениеЗаполнено(СтрокаМоделирования.ЗначениеМакс) И (СтрокаМоделирования.ТекущееЗначение + ТекШагРасчета)> СтрокаМоделирования.ЗначениеМакс Тогда
			
			ТекШагРасчета = СтрокаМоделирования.ЗначениеМакс - СтрокаМоделирования.ТекущееЗначение;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаМоделирования.ЗначениеМин) И (СтрокаМоделирования.ТекущееЗначение + ТекШагРасчета)< СтрокаМоделирования.ЗначениеМин Тогда
			
			ТекШагРасчета=СтрокаМоделирования.ЗначениеМин - СтрокаМоделирования.ТекущееЗначение;
			
		КонецЕсли;
		
		Если ТекШагРасчета = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ЦелевоеЗначениеСШагом = 0;
		
		СтруктураРасшифровкиКонтекста = ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(
			РасшифровкаПоказателяПоТаблице(СтрокаМоделирования, ПараметрыПодбора));
		
		ЦелевоеЗначениеСШагом = РассчитатьРезультирующееЗначениеЦелевогоПоказателя(
			СтруктураРасшифровкиКонтекста,
			СтрокаМоделирования.ТекущееЗначение,
			СтрокаМоделирования.ТекущееЗначение + ТекШагРасчета,
			,
			,
			ПараметрыПодбора);
		
		НеобходимоеИзменение = ЦелевойПоказательНовоеЗначение - ЦелевоеЗначениеСШагом;
		
		Если (Не РасчетВыполнен) Тогда
			
			Возврат;
			
		ИначеЕсли ДостигнутоЦелевоеЗначение(ЦелевоеЗначениеСШагом,РабочаяТочность, ЦелевойПоказательНовоеЗначение)Тогда
			
			СтрокаМоделирования.Градиент = (
				(ЦелевоеЗначениеСШагом - ТекЗначениеЦелевого) / ТекШагРасчета) * СтрокаМоделирования.КоэффГрадиента;	
			СтрокаМоделирования.ТекущееЗначение = СтрокаМоделирования.ТекущееЗначение + ТекШагРасчета;
			
			ТекВремяВыполнения = ТекущаяДата();
			
			Если (ТекВремяВыполнения-ВремяСтарта) < 60 И (НЕ РабочаяТочность = 0.01) Тогда // Проведем поиск по более высокой точности
				
				РабочаяТочность=РабочаяТочность / 2;
				ВыполнитьГрадиентныйСпуск(
					СтрокаМоделирования,
					РабочаяТочность,
					ВремяСтарта,
					НомерТранзакции,
					ПараметрыПодбора);
					
				Возврат;
				
			Иначе
				
				Возврат;
				
			КонецЕсли;
			
		ИначеЕсли (Не СходимостьШаг = 0) И ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение) >= СходимостьШаг Тогда // Достигнут предел сходимости
			
			Возврат;
			
		Иначе
			
			СтрокаМоделирования.Градиент = (
				(ЦелевоеЗначениеСШагом - ТекЗначениеЦелевого) / ТекШагРасчета) * СтрокаМоделирования.КоэффГрадиента;
			СтрокаМоделирования.ТекущееЗначение = СтрокаМоделирования.ТекущееЗначение + ТекШагРасчета;
			
		КонецЕсли;
		
		// Определим текущее значение градиента
		
		ТекСходимость       = ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
		ТекЗначениеЦелевого = ЦелевоеЗначениеСШагом;
		СходимостьШаг       = ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
		
	КонецЦикла;
	
КонецПроцедуры

Функция РассчитатьРезультирующееЗначениеЦелевогоПоказателя(
		СтруктураРасшифровкиКонтекста,
		ТекущееЗначение,
		УстанавливаемоеЗначение,
		НомерТранзакции = 0,
		Базовый = Истина,
		ПараметрыПодбора)
		
	НомерТранзакции = 99999;
	УстановитьЗначениеПоказателя(
		СтруктураРасшифровкиКонтекста,
		ТекущееЗначение,
		УстанавливаемоеЗначение,
		НомерТранзакции,
		ПараметрыПодбора);

	НовоеЗначение = ПолучитьТекущееЗначениеЦелевогоПоказателя(
		ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование,
		Базовый,
		ПараметрыПОдбора.ЧислоДопАналитик,
		ПараметрыПодбора.ИдентификаторДанныхМоделирование);
	
	Возврат НовоеЗначение;
	
КонецФункции
	
Процедура ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования, ПараметрыПодбора)
	
	ТаблицаВыделенныхПоказателейМоделирование = ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование;
	ТаблицаЧувствительностиФакторов           = ПараметрыПодбора.ТаблицаЧувствительностиФакторов;
	// Выделенный целевой базовый показатель.
	тЦелевыеПоказатели = ТаблицаВыделенныхПоказателейМоделирование.Скопировать(Новый Структура("Базовый", Истина));
	
	// Преобразуем таблицу факторов к нужному виду.
	тПоказателиФакторов = ТаблицаЧувствительностиФакторов.СкопироватьКолонки();
	тПоказателиФакторов.Колонки.Добавить("Значение", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
		
	ТаблицаЧувствительностиФакторовКопия = ТекТаблицаМоделирования.Скопировать(); 
	
	тДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Скопировать( , "ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	тДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	тДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
	тДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	тДанныеДляПересчета.ЗаполнитьЗначения(ПараметрыПодбора.ПериодПо, "ПериодОкончания");

	Для Каждого Строка ИЗ ТекТаблицаМоделирования Цикл
		
		Если Не Строка.ОбработкаВыполнена Тогда
			
			ОбработкаРасчета                               = Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса = ПараметрыПодбора.ИдентификаторДанныхМоделирование;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
		
			тРезультат = РассчитатьЧувствительностьПоПоказателю(
				Строка,
				ОбработкаРасчета,
				тЦелевыеПоказатели,
				тПоказателиФакторов,
				Строка.ТекущееЗначение,
				ПараметрыПодбора);
			
			Если тРезультат.Количество() = 1 Тогда
				Строка.Влияние        = тРезультат[0].Влияние;
				Строка.Градиент       = тРезультат[0].Градиент;
				Строка.КоэффГрадиента = тРезультат[0].КоэффГрадиента;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	ТекТаблицаМоделирования.Сортировать("Влияние Убыв");
	
КонецПроцедуры

Функция ПолучитьТекущееЗначениеЦелевогоПоказателя(
		ТаблицаВыделенныхПоказателейМоделирование,
		Базовый = Истина,
		ЧислоДопАналитик = 0,
		ИдентификаторДанныхМоделирование = "")
	
	Для Каждого СтрЦелевой Из ТаблицаВыделенныхПоказателейМоделирование Цикл
		
		Если СтрЦелевой.Базовый = Базовый Тогда
			Возврат ПолучитьЗначениеЦелевогоПоказателя(
				СтрЦелевой,
				Истина,
				Неопределено,
				Истина,
				ЧислоДопАналитик,
				ИдентификаторДанныхМоделирование);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьЗначениеЦелевогоПоказателя(
		тСтрока,
		ВключатьДанныеМодели,
		МассивПериодов = Неопределено,
		ОбщийИтог = Ложь,
		ЧислоДопАналитик = 0,
		ИдентификаторДанныхМоделирование = "")
	
	СтруктураОтбираемыхАналитик   = Новый Структура;
	СтруктураРаскрываемыхАналитик = Новый Структура;
	
	СтруктураОтбираемыхАналитик.Вставить("Сценарий",    тСтрока.Сценарий);
	СтруктураОтбираемыхАналитик.Вставить("Организация", тСтрока.Организация);
	Если МассивПериодов = Неопределено  Тогда
		СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета",тСтрока.ПериодОтчета);
	Иначе	
		СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета",МассивПериодов);
	КонецЕсли;
	
	СтруктураОтбираемыхАналитик.Вставить("Проект",тСтрока.Проект);
	
	Для  Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(тСтрока["Аналитика"+Инд]) Тогда
			СтруктураОтбираемыхАналитик.Вставить("Аналитика"+Инд,тСтрока["Аналитика"+Инд]);
		КонецЕсли;
	КонецЦикла;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(тСтрока.Показатель);
	
	СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
	
	Результат = ПолучитьДанныеПоказателяМоделирование(
		СтруктураОтбираемыхАналитик,
		СтруктураРаскрываемыхАналитик,
		ВключатьДанныеМодели,
		ОбщийИтог,
		ИдентификаторДанныхМоделирование);
	
	Если Результат.Количество() = 1 Тогда
		Возврат Результат[0].Значение;
	КонецЕсли;

КонецФункции

Функция ПолучитьДанныеПоказателяМоделирование(
		СтруктураОтбираемыхАналитик,
		СтруктураРаскрываемыхАналитик,
		ВключатьДанныеМодели,
		ОбщийИтог = Ложь,
		ИдентификаторДанныхМоделирование = "")
	
	ДополнительныеПараметры = Новый Структура;
	Если ВключатьДанныеМодели Тогда
		ДополнительныеПараметры.Вставить("ИдентификаторСеанса",ИдентификаторДанныхМоделирование);
	КонецЕсли;
		
	Результат = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(
		СтруктураОтбираемыхАналитик,
		СтруктураРаскрываемыхАналитик,ДополнительныеПараметры);
	
	СтрокаСвертки = "ПоказательОтчета";
	Если Не ОбщийИтог Тогда
		Для Каждого СтрКол Из Результат.Колонки Цикл
			Если СтрКол.Имя = "СинтетическоеЗначение" 
				ИЛИ СтрКол.Имя = "Значение"
				ИЛИ СтрКол.Имя = "ЗначениеВалюта"
				ИЛИ СтрКол.Имя = "ПоказательОтчета" Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаСвертки = СтрокаСвертки+"," + СтрКол.Имя;
			
		КонецЦикла;
	КонецЕсли;
	
	Результат.Свернуть(СтрокаСвертки, "Значение,ЗначениеВалюта");
	
	Возврат Результат;

КонецФункции

// Функция берет максимальное или минимальное значение границы (если они заданы) и проверяет:
// можно ли в принципе достичь целевого значения по заданной границе.
Функция ЗначениеПринципиальноДостижимо(ПараметрыПроверки, ПараметрыПодбора)
	
	ТаблицаМоделирования           = ПараметрыПроверки.ТаблицаМоделирования;
	ТекЗначениеЦелевогоПоказателя  = ПараметрыПроверки.ТекЗначениеЦелевогоПоказателя;
	ЦелевойПоказательНовоеЗначение = ПараметрыПроверки.ЦелевойПоказательНовоеЗначение;
	
	// Проверим, для всех ли базовых показателей установлены граничные условия.
	НеобходимоеИзменение = ЦелевойПоказательНовоеЗначение - ТекЗначениеЦелевогоПоказателя;
	
	Для Каждого Строка ИЗ ТаблицаМоделирования Цикл
		
		// Проверим на вхождение целевого значения в установленные границы.
		Если НЕ ((Строка.ЗначениеМин = 0 ИЛИ Строка.ТекущееЗначение > Строка.ЗначениеМин) 
			И (Строка.ЗначениеМакс=0 ИЛИ Строка.ТекущееЗначение<Строка.ЗначениеМакс)) Тогда
			
			СтрокаШаблона = Нстр("ru = 'Некорректно установлены границы:
				|Показатель: %1,
				|ТекущееЗначение: %2,
				|Граница (мин.): %3,
				|Граница (макс.): %4
				|Моделирование отменено.'");
			
			Если Не ПустаяСтрока(СтрокаШаблона) Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					СтрокаШаблона,
					Строка.Показатель,
					Строка.ТекущееЗначение,
					Строка.ЗначениеМин,
					Строка.ЗначениеМакс);
			КонецЕсли;
				
			Возврат Ложь;
			
		КонецЕсли;
		
		// Проверим на возможное отсутствие границы в предполагаемом направлении изменения показателя.
		Если НеобходимоеИзменение > 0 Тогда
			
			Если (Строка.Градиент > 0 И Строка.ЗначениеМакс = 0)
				ИЛИ (Строка.Градиент < 0 И Строка.ЗначениеМин = 0) Тогда // Может приниматься любое значение, чтобы достигнуть целевого.
				
				Возврат Истина;
				
			КонецЕсли;
			
		Иначе
			
			Если (Строка.Градиент > 0 И Строка.ЗначениеМин = 0)
				ИЛИ (Строка.Градиент < 0 И Строка.ЗначениеМакс = 0) Тогда // Может приниматься любое значение, чтобы достигнуть целевого.
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверим достижимость значения по установленным границам.
	НомерТранзакции    = 99999;
	ДостижимоеЗначение = ПолучитьЗначениеНаГраницах(
		ТаблицаМоделирования,
		НеобходимоеИзменение,
		Ложь,
		НомерТранзакции,
		ПараметрыПодбора);
	
	ЗначениеДостижимо = ДостигнутоЦелевоеЗначение(ДостижимоеЗначение, 0.04, ЦелевойПоказательНовоеЗначение)
		ИЛИ ((НеобходимоеИзменение > 0 И ДостижимоеЗначение >= ЦелевойПоказательНовоеЗначение) ИЛИ (НеобходимоеИзменение < 0 И ДостижимоеЗначение <= ЦелевойПоказательНовоеЗначение)); 

	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(
		ПараметрыПодбора.ИдентификаторДанныхМоделирование,
		НомерТранзакции);
	
	Возврат ЗначениеДостижимо;
	
КонецФункции

Функция ДостигнутоЦелевоеЗначение(ТекЗначениеЦелевого, ТекущаяТочность, ЦелевойПоказательНовоеЗначение)
	
	Если ЦелевойПоказательНовоеЗначение = 0 Тогда
		
		Возврат ТекЗначениеЦелевого=ЦелевойПоказательНовоеЗначение;
		
	Иначе
		
		Возврат ОбщегоНазначенияУХ.ЗначениеПоМодулю(
			(ТекЗначениеЦелевого - ЦелевойПоказательНовоеЗначение) / ЦелевойПоказательНовоеЗначение) <= ТекущаяТочность;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗначениеНаГраницах(
		ТаблицаМоделирования,
		НеобходимоеИзменение,
		ПоискЭкстремума,
		НомерТранзакции,
		ПараметрыПодбора)
	
	ТаблицаИзмененныхОтчетов = Новый ТаблицаЗначений;
	ТаблицаИзмененныхОтчетов.Колонки.Добавить("ЭкземплярОтчета");
	ТаблицаИзмененныхОтчетов.Колонки.Добавить("Показатель");
		
	Для Каждого БазовыйПоказатель ИЗ ТаблицаМоделирования Цикл
		
		// Установим каждый базовый показатель в необходимое граничное значение.
		Если НЕ БазовыйПоказатель.ЗначениеМакс = 0 И  БазовыйПоказатель.Градиент > 0 И НеобходимоеИзменение > 0 Тогда
			
			УстанавливаемоеЗначение = БазовыйПоказатель.ЗначениеМакс;
			
		ИначеЕсли НЕ БазовыйПоказатель.ЗначениеМин = 0 И  БазовыйПоказатель.Градиент < 0 И НеобходимоеИзменение > 0 Тогда
	
			УстанавливаемоеЗначение = БазовыйПоказатель.ЗначениеМин;
	
		ИначеЕсли НЕ БазовыйПоказатель.ЗначениеМин=0 И НеобходимоеИзменение<0 И БазовыйПоказатель.Градиент>0 Тогда
 	
			УстанавливаемоеЗначение = БазовыйПоказатель.ЗначениеМин;
			
		ИначеЕсли НЕ БазовыйПоказатель.ЗначениеМин = 0 И НеобходимоеИзменение < 0 И БазовыйПоказатель.Градиент < 0 Тогда
 	
			УстанавливаемоеЗначение = БазовыйПоказатель.ЗначениеМакс;
			
		ИначеЕсли ПоискЭкстремума Тогда
			
			УстанавливаемоеЗначение = 
				?(БазовыйПоказатель.ЗначениеМин = 0,БазовыйПоказатель.ЗначениеМакс, БазовыйПоказатель.ЗначениеМин);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		// Устанавливаем значение новое.
		СтруктураРасшифровкиКонтекста = ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(
			РасшифровкаПоказателяПоТаблице(
				БазовыйПоказатель,
				ПараметрыПодбора));
		НомерТранзакции = 99999;
		
		УстановитьЗначениеПоказателя(
			СтруктураРасшифровкиКонтекста,
			БазовыйПоказатель.ТекущееЗначение,
			УстанавливаемоеЗначение,
			НомерТранзакции,
			ПараметрыПодбора);
		
		Если ПоискЭкстремума Тогда
			
			БазовыйПоказатель.ТекущееЗначение = УстанавливаемоеЗначение;
			
		КонецЕсли;
			
	КонецЦикла;

	Возврат ПолучитьТекущееЗначениеЦелевогоПоказателя(
		ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование,
		,
		ПараметрыПОдбора.ЧислоДопАналитик,
		ПараметрыПодбора.ИдентификаторДанныхМоделирование); 
	
КонецФункции

Функция ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(СтруктураРасшифровки)
	
	СтруктураНезаполненныхАналитик = Новый Структура;
	СтруктураОтбираемыхАналитик   = Новый Структура;
	
	тПоказатели = Новый Массив;
	тПоказатели.Добавить(СтруктураРасшифровки.Показатель);
	ТзСвойстваПоказателей = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьСвойстваВыбранныхПоказателей(тПоказатели);
	
	тПоказатель = ТзСвойстваПоказателей.Найти(СтруктураРасшифровки.Показатель," Ссылка");
	
	ПолнаяСтруктураАналитик = АналитическийБланкУХСервер.ПолучитьПолнуюСтруктуруАналитик(тПоказатель);
	
	Для Каждого нАналитика Из ПолнаяСтруктураАналитик Цикл
		
		Если нАналитика.Ключ = "АналитикаВалюта" Тогда
			Если НЕ СтруктураРасшифровки.Свойство(нАналитика.Значение) Тогда
				СтруктураНезаполненныхАналитик.Вставить("АналитикаВалюта");
			Иначе
				СтруктураОтбираемыхАналитик.Вставить("АналитикаВалюта",СтруктураРасшифровки[нАналитика.Значение]);
				СтруктураРасшифровки.Вставить("АналитикаВалюта",СтруктураРасшифровки[нАналитика.Значение]);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если НЕ  СтруктураРасшифровки.Свойство(нАналитика.Ключ) Тогда
			СтруктураНезаполненныхАналитик.Вставить(нАналитика.Ключ);
		Иначе	
			СтруктураОтбираемыхАналитик.Вставить(нАналитика.Ключ, СтруктураРасшифровки[нАналитика.Ключ]);
		КонецЕсли;
	КонецЦикла;
		
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("СтруктураНезаполненныхАналитик", СтруктураНезаполненныхАналитик);
	СтруктураОтвета.Вставить("СтруктураОтбираемыхАналитик",   СтруктураОтбираемыхАналитик);
	СтруктураОтвета.Вставить("СтруктураРасшифровки",          СтруктураРасшифровки);
	
	Возврат СтруктураОтвета;

КонецФункции

Процедура УстановитьЗначениеПоказателя(
		СтруктураРасшифровкиКонтекста,
		ЗначениеСтарое,
		ЗначениеНовое,
		НомерТранзакции,
		ПараметрыПодбора)
	
	Если СтруктураРасшифровкиКонтекста.СтруктураНезаполненныхАналитик.Количество() = 0 Тогда
		
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеСтарое", ЗначениеСтарое);
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеНовое",  ЗначениеНовое);
		ЗаписатьПоказательПоТаблицеФакторов(СтруктураРасшифровкиКонтекста, НомерТранзакции, ПараметрыПодбора);
		
	Иначе
		
		// Это агрегат - необходимо выполнить пропорциональное распределение по аналитикам.
		ПараметрыФормыРаскрытия = ПодготовитьПараметрыВызоваФормыРаскрытий(
			СтруктураРасшифровкиКонтекста.СтруктураРасшифровки,
			СтруктураРасшифровкиКонтекста.СтруктураНезаполненныхАналитик,
			СтруктураРасшифровкиКонтекста.СтруктураОтбираемыхАналитик,
			ПараметрыПодбора);
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеСтарое", ЗначениеСтарое);
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеНовое",  ЗначениеНовое);
		ЗаписатьРаскрытиеПоТаблицеФакторов(
			СтруктураРасшифровкиКонтекста,
			ПараметрыФормыРаскрытия,
			НомерТранзакции,
			ПараметрыПодбора);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьПараметрыВызоваФормыРаскрытий(
		СтруктураРасшифровки,
		СтруктураНезаполненныхАналитик,
		СтруктураОтбираемыхАналитик,
		ПараметрыПодбора)
		
	АналитикиОтчета = ПараметрыПодбора.АналитикиОтчета;
	ДанныеПоАдресам = ПараметрыПодбора.ДанныеПоАдресам;
	
	СтруктураОтбираемыхАналитик.Вставить("Валюта", ПараметрыПодбора.ВалютаОтображения);
	
	тОбъектАБ = ПараметрыПодбора.РеквизитыОбработкиАБ;
	
	МассивПериодов = Новый Массив;

	Для Каждого СтрНезаполненнаяАналитика Из СтруктураНезаполненныхАналитик Цикл
		Если СтруктураОтбираемыхАналитик.Свойство(СтрНезаполненнаяАналитика.Ключ) Тогда //Мы имеем дело с аналитикой -группой, нужно ее расшифровать
			Если СтрНезаполненнаяАналитика.Ключ = "ПериодОтчета" Тогда
				МассивПериодов = ПолучитьВложенныеПериоды(
					СтруктураОтбираемыхАналитик.ПериодОтчета,
					ПараметрыПодбора.РеквизитыОбработкиАБ.Периодичность);
				СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета", МассивПериодов);
			Иначе
				МассивЗначений = ПолучитьЭлементыПотомки(СтруктураОтбираемыхАналитик[СтрНезаполненнаяАналитика.Ключ]);
				СтруктураОтбираемыхАналитик.Вставить(СтрНезаполненнаяАналитика.Ключ, МассивЗначений);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураНезаполненныхАналитик.Свойство("ПериодОтчета")     //Если не указан период, то берем весь текущий диапазон
		И НЕ СтруктураОтбираемыхАналитик.Свойство("ПериодОтчета") Тогда	
			МассивПериодов = ПериодыУХ.ПолучитьПодчиненныеПериоды(
				СтруктураРасшифровки.ПериодС, 
				СтруктураРасшифровки.ПериодПо,
				ПараметрыПодбора.РеквизитыОбработкиАБ.Периодичность);
			СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета", МассивПериодов);
	КонецЕсли;
	
	МассивПоказателей = Новый Массив();
	МассивПоказателей.Добавить(СтруктураРасшифровки.ПоказательСсылка);
	СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета", МассивПоказателей);
	СтруктураОтбираемыхАналитик.Вставить("УидГруппыОтборов", СтруктураРасшифровки.УидГруппыОтборов);

	мПоказателиРаскрытия = ДанныеПоАдресам.мПоказателиРаскрытияАдрес;
	
	МассивУдаляемыхКолонок = Новый Массив;
	
	тСвойствАналитик = Новый ТаблицаЗначений;
	тСвойствАналитик.Колонки.Добавить("КодАналитики");
	тСвойствАналитик.Колонки.Добавить("типАналитики");
	тСвойствАналитик.Колонки.Добавить("Аналитика");
	тСвойствАналитик.Колонки.Добавить("СвязьПоВладельцу");
	тСвойствАналитик.Колонки.Добавить("ЭтоЭтапПроекта",         ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	тСвойствАналитик.Колонки.Добавить("ОбязательноеЗаполнение", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	тСвойствАналитик.Колонки.Добавить("МетаИмяАналитики");
	тСвойствАналитик.Колонки.Добавить("ОтборЗначений");
	тСвойствАналитик.Колонки.Добавить("ПараметрыОтбораЗначений");
	
	тГруппаРаскрытия = СтруктураРасшифровки.ПоказательСсылка.ГруппаРаскрытия;
	
	ДополнительныйОтбор = Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыТекущихОтборов();
	
	Для Каждого Аналитика Из СтруктураНезаполненныхАналитик Цикл
		
		нСвойство = тСвойствАналитик.Добавить();
		нСвойство.КодАналитики = Аналитика.Ключ;
		
		Если Аналитика.Ключ = "ПериодОтчета" Тогда
			нСвойство.типАналитики = Новый ОписаниеТипов("СправочникСсылка.Периоды");
			нСвойство.ОбязательноеЗаполнение = Истина;
		ИначеЕсли Аналитика.Ключ = "Организация" Тогда 
			нСвойство.типАналитики = Новый ОписаниеТипов("СправочникСсылка.Организации");
			нСвойство.ОбязательноеЗаполнение = Истина;
		ИначеЕсли Аналитика.Ключ = "Проект"   Тогда
			нСвойство.типАналитики = Новый ОписаниеТипов("СправочникСсылка.Проекты");
			нСвойство.ОбязательноеЗаполнение = Истина;
		ИначеЕсли Аналитика.Ключ = "Сценарий" Тогда
			нСвойство.типАналитики = Новый ОписаниеТипов("СправочникСсылка.Сценарии");
			нСвойство.ОбязательноеЗаполнение = Истина;
		ИначеЕсли Аналитика.Ключ = "АналитикаВалюта" Тогда
			нСвойство.типАналитики = Новый ОписаниеТипов("СправочникСсылка.Валюты");
			нСвойство.ОбязательноеЗаполнение = Истина;
		
		Иначе
			
			ТекСубконто = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Аналитика.Ключ);
			
			Если ЗначениеЗаполнено(ТекСубконто) Тогда
				нСвойство.типАналитики = Новый ОписаниеТипов(ТекСубконто.ТипЗначения);
			КонецЕсли;
			
			Для Инд = 1 по ПараметрыСеанса.ЧислоДопАналитик Цикл	
				Если тГруппаРаскрытия["ВидАналитики" + Инд] = ТекСубконто Тогда
					нСвойство.ОбязательноеЗаполнение = тГруппаРаскрытия["Аналитика" + Инд + "Обязательна"];
					Если Инд = тГруппаРаскрытия.АналитикаЭтапПроекта Тогда
						 нСвойство.ЭтоЭтапПроекта = Истина;
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если нСвойство.типАналитики.ПривестиЗначение() = Неопределено Тогда
			нСвойство.МетаИмяАналитики = "СправочникСсылка." + Метаданные.НайтиПоТипу(нСвойство.типАналитики.Типы()[0]).Имя;
		Иначе
			нСвойство.МетаИмяАналитики = нСвойство.типАналитики.ПривестиЗначение().Метаданные().Имя;
		КонецЕсли;

		тРасшифровкаГруппыОтборов = тОбъектАБ.ТабличныеЧасти.РасшифровкаГруппОтборов.НайтиСтроки(Новый Структура("УидГруппыОтборов,ПолеКод", СтруктураОтбираемыхАналитик.УидГруппыОтборов, Аналитика.Ключ));
		
		Если тРасшифровкаГруппыОтборов.Количество() = 1 И ЗначениеЗаполнено(тРасшифровкаГруппыОтборов[0].ЗначениеОтбораСтрока) И НЕ тРасшифровкаГруппыОтборов[0].Отбор = Перечисления.ВидыСравненияПоказателейОтчетов.ОтборНеПроизводится Тогда
			
			ТзПараметровЗапроса = Новый ТаблицаЗначений;
			ТзПараметровЗапроса.Колонки.Добавить("ИмяОтбора");
			ТзПараметровЗапроса.Колонки.Добавить("ТипОтбора");
			ТзПараметровЗапроса.Колонки.Добавить("ЗначениеОтбора");
			ТзПараметровЗапроса.Колонки.Добавить("УидГруппыОтбора");
				
			ТекстОтбора = АналитическийБланкУХСервер.СформироватьТекстОтбораПоМакету("ТекущийСправочник","",тРасшифровкаГруппыОтборов[0],ТзПараметровЗапроса,"Ссылка");
			ТекстОтбора = Прав(ТекстОтбора,СтрДлина(ТекстОтбора)-1);
			
			ТекстЗапроса = "ВЫБРАТЬ 
			|	ТекущийСправочник.Ссылка
			|ИЗ
			|	Справочник."+нСвойство.МетаИмяАналитики+" КАК ТекущийСправочник
			|ГДЕ "+ТекстОтбора;
			
			Если ЗначениеЗАполнено(ТекстОтбора) Тогда		
				нСвойство.ОтборЗначений 			= ТекстЗапроса;
				нСвойство.ПараметрыОтбораЗначений 	= ТзПараметровЗапроса;	
			КонецЕсли;	
					
			нДополнительныйОтбор 				= ДополнительныйОтбор.Добавить();
			нДополнительныйОтбор.ПолеКод      	= Аналитика.Ключ;
			нДополнительныйОтбор.ВидСравнения   = тРасшифровкаГруппыОтборов[0].Отбор;
			нДополнительныйОтбор.ЗначениеОтбора = ЗначениеИзСтрокиВнутр(тРасшифровкаГруппыОтборов[0].ЗначениеОтбораСтрока);
	
		КонецЕсли;

	КонецЦикла;
	
	//В расшифровке есть группировочное поле, добавим его в отбор
	Если СтруктураРасшифровки.Свойство("ПутьКРеквизиту") Тогда
		Для Каждого СтрПутьКРеквизиту Из СтруктураРасшифровки.ПутьКРеквизиту Цикл
			Если СтруктураРасшифровки.Свойство(СтрПутьКРеквизиту.Ключ) Тогда
				
				нДополнительныйОтбор 				= ДополнительныйОтбор.Добавить();
				нДополнительныйОтбор.ПолеКод      	= СтрПутьКРеквизиту.Значение;
				нДополнительныйОтбор.ВидСравнения   = Перечисления.ВидыСравненияПоказателейОтчетов.Равно;
				нДополнительныйОтбор.ЗначениеОтбора = СтруктураРасшифровки[СтрПутьКРеквизиту.Ключ];
				
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	
	ДополнительныеПараметры = Новый Структура;
	Если ПараметрыПодбора.РежимМоделирования Тогда
		ДополнительныеПараметры.Вставить("ИдентификаторСеанса", ПараметрыПодбора.ИдентификаторДанныхМоделирование);
	Иначе	
		ДополнительныеПараметры.Вставить("ИдентификаторСеанса", ПараметрыПодбора.УникальныйИдентификаторФормы);
	КонецЕсли;

	ДополнительныеПараметры.Вставить("ДополнительныйФильтр", ДополнительныйОтбор);
	
	Если НЕ СтруктураРасшифровки.ПоказательСсылка.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда 
		ДополнительныеПараметры.Вставить("ЭтоНечисловые",Истина);
	КонецЕсли;
	
	Если СтруктураНезаполненныхАналитик.Свойство("Проект") Тогда
		СтруктураНезаполненныхАналитик.Удалить("Проект"); 
	КонецЕсли;
	
	Результат = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(
		СтруктураОтбираемыхАналитик,
		СтруктураНезаполненныхАналитик,
		ДополнительныеПараметры);
	
	Если НЕ СтруктураРасшифровки.ПоказательСсылка.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
		Результат.Колонки.Удалить("Значение");
		Результат.Колонки.ЗначениеНеЧисловое.Имя = "Значение";
	КонецЕсли;
	
	АдресТзРаскрытия = ПоместитьВовременноеХранилище(Результат, Новый УникальныйИдентификатор);
		
	//Заполняем возможные связи по владельцу
	Для Каждого Аналитика Из тСвойствАналитик Цикл
		
		мВладельцы = Новый Массив;
		
		Если Аналитика.типАналитики.ПривестиЗначение() = Неопределено ИЛИ СтрНайти(Аналитика.типАналитики.ПривестиЗначение().Метаданные().ПолноеИмя(),"Справочник") = 0 Тогда
			Аналитика.СвязьПоВладельцу =  мВладельцы;
			Продолжить;
		Иначе	
			Владельцы = Аналитика.типАналитики.ПривестиЗначение().Метаданные().Владельцы;
		КонецЕсли;

		Владельцы =  Аналитика.типАналитики.ПривестиЗначение().Метаданные().Владельцы;
		
		Для Каждого тВладелец Из Владельцы Цикл
			СущВладельцы = тСвойствАналитик.НайтиСтроки(Новый Структура("МетаИмяАналитики", тВладелец.Имя));
			Для Каждого сВладелец Из СущВладельцы Цикл
				мВладельцы.Добавить(сВладелец.КодАналитики);
			КонецЦикла;
		КонецЦикла;
		Аналитика.СвязьПоВладельцу =  мВладельцы;
		
	КонецЦикла;
	
	ТабличныеСастиОбъектаАБ = тОбъектАБ.ТабличныеЧасти;
	
	СтруктураКлючевыхРеквизитов = Новый Структура;
	СтруктураКлючевыхРеквизитов.Вставить("Сценарий",                  АналитикиОтчета["Сценарий"]);
	СтруктураКлючевыхРеквизитов.Вставить("Организация",               АналитикиОтчета["Организация"]);
	СтруктураКлючевыхРеквизитов.Вставить("Проект",                    Неопределено);
	СтруктураКлючевыхРеквизитов.Вставить("ПериодОтчета",              ПараметрыПодбора.ПериодС);
	СтруктураКлючевыхРеквизитов.Вставить("ВидОтчета",                 ПараметрыПодбора.тВидыОтчетов);
	СтруктураКлючевыхРеквизитов.Вставить("ВложенныеПериоды",          ТабличныеСастиОбъектаАБ.ВложенныеПериоды);
	СтруктураКлючевыхРеквизитов.Вставить("ЗаблокированныеПоказатели", ТабличныеСастиОбъектаАБ.ЗаблокированныеПоказатели);
	СтруктураКлючевыхРеквизитов.Вставить("ЗаблокированныеПериоды",    ТабличныеСастиОбъектаАБ.ЗаблокированныеПериоды);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СтруктураОтбираемыхАналитик",   СтруктураОтбираемыхАналитик);
	СтруктураПараметров.Вставить("СтруктураНезаполненныхАналитик", СтруктураНезаполненныхАналитик);
	СтруктураПараметров.Вставить("АдресТзРаскрытия",              АдресТзРаскрытия);
	СтруктураПараметров.Вставить("логИзмененныхПоказателейАдрес", ПараметрыПодбора.логИзмененныхДанныхАдрес);
	СтруктураПараметров.Вставить("мПоказателиРаскрытияАдрес",     тОбъектАБ.мПоказателиРаскрытияАдрес);
	СтруктураПараметров.Вставить("КэшАналитикПоказателейАдрес",   тОбъектАБ.КэшАналитикПоказателейАдрес);
	СтруктураПараметров.Вставить("Заблокирован",                  Истина);
	СтруктураПараметров.Вставить("ЕдиницаИзмерения",              ПараметрыПодбора.ТекущийДелитель);
	СтруктураПараметров.Вставить("УровеньТочности",               ПараметрыПодбора.УровеньТочности);
	СтруктураПараметров.Вставить("УидГруппыОтборов",              СтруктураРасшифровки.УидГруппыОтборов);
	СтруктураПараметров.Вставить("тГоризонт",                     МассивПериодов);
	СтруктураПараметров.Вставить("АдресТаблицыСвойствАналитик",         ПоместитьВоВременноеХранилище(
		тСвойствАналитик,
		ПараметрыПодбора.УникальныйИдентификаторФормы));
	СтруктураПараметров.Вставить("ПравилоОбработки",              Неопределено);
	СтруктураПараметров.Вставить("ВИБ",                           Неопределено);
	СтруктураПараметров.Вставить("АдресСтруктураКлючевыхРеквизитов", 
		ПоместитьВоВременноеХранилище(СтруктураКлючевыхРеквизитов, ПараметрыПодбора.УникальныйИдентификаторФормы));
	
	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьВложенныеПериоды(ПериодОтчета, Периодичность)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Периоды.Ссылка КАК ПериодОтчета,
		|	Периоды.Периодичность КАК Периодичность
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.ПометкаУдаления = ЛОЖЬ
		|	И Периоды.ДатаНачала >= &ДатаНачала
		|	И Периоды.ДатаОкончания <= &ДатаОкончания
		|	И Периоды.Периодичность = &Периодичность
		|	И Периоды.Произвольный = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Периодичность", Периодичность);
	Запрос.УстановитьПараметр("ДатаНачала",    ПериодОтчета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодОтчета.ДатаОкончания);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПериодОтчета");
	
КонецФункции

Функция ПолучитьЭлементыПотомки(ЭлементРодитель)
	
	ТекущийТип = ЭлементРодитель.Метаданные().Имя;
	
	Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗначениеСправочика.Ссылка КАК Ссылка
		|ИЗ
		|	//ТекущийСправочник// КАК ЗначениеСправочика
		|ГДЕ
		|	ЗначениеСправочика.ПометкаУдаления = ЛОЖЬ
		|	И ЗначениеСправочика.Родитель  В ИЕРАРХИИ(&ЭлементРодитель)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"//ТекущийСправочник//","Справочник." + ТекущийТип);
	
	Запрос.УстановитьПараметр("ЭлементРодитель", ЭлементРодитель);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ЗаписатьПоказательПоТаблицеФакторов(СтруктураРасшифровкиКонтекста, НомерТранзакции = 0, ПараметрыПодбора)

	СтруктураРасшифровки = СтруктураРасшифровкиКонтекста.СтруктураРасшифровки;
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	ЗаполнитьЗначенияСвойств(ОбъектАБ, ПараметрыПодбора.РеквизитыОбработкиАБ);
	ТаблицаИзмененныхПоказателей = УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	
	Показатели = Новый Массив;
	Показатели.Добавить(СтруктураРасшифровки.Показатель);
	КэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Показатели);
	ФлОшибки             = Ложь;
	
	СтруктураПараметровЛог = Новый Структура;
	СтруктураПараметровЛог.Вставить("ЗначениеНовое",                СтруктураРасшифровкиКонтекста.ЗначениеНовое);
	СтруктураПараметровЛог.Вставить("ЗначениеСтарое",               СтруктураРасшифровкиКонтекста.ЗначениеСтарое);
	СтруктураПараметровЛог.Вставить("СтруктураРасшифровки",         СтруктураРасшифровки);
	СтруктураПараметровЛог.Вставить("КэшАналитикПоказателей",       КэшАналитикПоказателей);
	СтруктураПараметровЛог.Вставить("ТаблицаИзмененныхПоказателей", ТаблицаИзмененныхПоказателей);
	СтруктураПараметровЛог.Вставить("НомерТранзакции",              НомерТранзакции);
	СтруктураПараметровЛог.Вставить("ПредставлениеТранзакции",      Перечисления.ТранзакцииИзмененияПоказателей.ИзменениеПоказателя);
	СтруктураПараметровЛог.Вставить("ФлОшибки",                     ФлОшибки);
	
	ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметровЛог);

	ОбработкаОбъект = Обработки.РасчетИЗаписьПоказателей.Создать();
	ОбработкаОбъект.УникальныйИдентификаторСеанса = ПараметрыПодбора.ИдентификаторДанныхМоделирование;
	
	ПараметрыРасчета = ОбработкаОбъект.ПараметрыРасчета();	
	ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(
		ТаблицаИзмененныхПоказателей, ПараметрыПодбора.УникальныйИдентификаторФормы);
	ПараметрыРасчета.НомерТранзакции = НомерТранзакции;
	Результат = ОбработкаОбъект.РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета);
	
КонецПроцедуры

Процедура ЗаписатьРаскрытиеПоТаблицеФакторов(
		СтруктураРасшифровкиКонтекста,
		ПараметрыФормыРаскрытия,
		НомерТранзакции = 0,
		ПараметрыПодбора)

	СтруктураРасшифровки         = СтруктураРасшифровкиКонтекста.СтруктураРасшифровки;
	
	ОбъектАБ                     = Обработки.АналитическийБланк.Создать();
	ЗаполнитьЗначенияСвойств(ОбъектАБ, ПараметрыПодбора.РеквизитыОбработкиАБ);
	ТаблицаИзмененныхПоказателей = УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	
	Показатели = Новый Массив;
	Показатели.Добавить(СтруктураРасшифровки.Показатель);
	КэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Показатели);
	ФлОшибки = Ложь;
	
	ТзРаскрытия = ПолучитьИзВременногоХранилища(ПараметрыФормыРаскрытия.АдресТзРаскрытия);
	
	Пропорция = (СтруктураРасшифровкиКонтекста.ЗначениеНовое - СтруктураРасшифровкиКонтекста.ЗначениеСтарое)/ СтруктураРасшифровкиКонтекста.ЗначениеСтарое;
	
	Для Каждого СтрРаскрытие Из ТзРаскрытия Цикл
		
		Для Каждого СтрАналитика Из СтруктураРасшифровкиКонтекста.СтруктураНезаполненныхАналитик Цикл
			СтруктураРасшифровки.Вставить(СтрАналитика.Ключ, СтрРаскрытие[СтрАналитика.Ключ]);
		КонецЦикла;
		
		ЗначениеНовое  = СтрРаскрытие.Значение + СтрРаскрытие.Значение*  Пропорция;
		ЗначениеСтарое = СтрРаскрытие.Значение;
		
		СтруктураПараметровЛог = Новый Структура;
		СтруктураПараметровЛог.Вставить("ЗначениеНовое",                ЗначениеНовое);
		СтруктураПараметровЛог.Вставить("ЗначениеСтарое",               ЗначениеСтарое);
		СтруктураПараметровЛог.Вставить("СтруктураРасшифровки",         СтруктураРасшифровки);
		СтруктураПараметровЛог.Вставить("КэшАналитикПоказателей",       КэшАналитикПоказателей);
		СтруктураПараметровЛог.Вставить("ТаблицаИзмененныхПоказателей", ТаблицаИзмененныхПоказателей);
		СтруктураПараметровЛог.Вставить("НомерТранзакции",              НомерТранзакции);
		СтруктураПараметровЛог.Вставить("ПредставлениеТранзакции",      Перечисления.ТранзакцииИзмененияПоказателей.ИзменениеПоказателя);
		СтруктураПараметровЛог.Вставить("ФлОшибки",                     ФлОшибки);
		
		ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметровЛог);
		
	КонецЦикла;
	
	ОбработкаОбъект = Обработки.РасчетИЗаписьПоказателей.Создать();
	ОбработкаОбъект.УникальныйИдентификаторСеанса = ПараметрыПодбора.ИдентификаторДанныхМоделирование;
	Если ПараметрыПодбора.КэшДанных <> Неопределено Тогда
		ОбработкаОбъект.АдресКэшаДанных = ПоместитьВоВременноеХранилище(ПараметрыПодбора.КэшДанных, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ПараметрыРасчета = ОбработкаОбъект.ПараметрыРасчета();
	ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(
		ТаблицаИзмененныхПоказателей,
		ПараметрыПодбора.УникальныйИдентификаторФормы);
	ПараметрыРасчета.НомерТранзакции = НомерТранзакции;
	Результат = ОбработкаОбъект.РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета);
		
	// Обновим адреса таблиц в сеансе длительной операции.
	ЗаполнитьЗначенияСвойств(ПараметрыПодбора.РеквизитыРасчетаИЗаписиПоказателей, ОбработкаОбъект);
	
КонецПроцедуры

Функция РасшифровкаПоказателяПоТаблице(ТекущаяСтрока, ПараметрыПодбора);
	
	НастройкиРасположенияПолейСводнойТаблицы  = ПараметрыПодбора.НастройкиРасположенияПолейСводнойТаблицы;
	ТаблицаЧувствительностиФакторов           = ПараметрыПодбора.ТаблицаЧувствительностиФакторов;
	ТаблицаВыделенныхПоказателейМоделирование = ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование; 
	ДетализацияАналитикВлияние                = ПараметрыПодбора.ДетализацияАналитикВлияние;
	АналитикиОтчета                           = ПараметрыПодбора.АналитикиОтчета;
	ДетализацияАналитикВлияние =  ИзменитьСоставАналитикиТаблицыФакторов(ТаблицаЧувствительностиФакторов, ДетализацияАналитикВлияние);
	
	СтруктураРасшифровки = Новый Структура;
	СтруктураРасшифровки.Вставить("Показатель",            ТекущаяСтрока.Показатель);
	СтруктураРасшифровки.Вставить("ПоказательСсылка",      ТекущаяСтрока.Показатель);
	СтруктураРасшифровки.Вставить("УидГруппыОтборов",      0);
	СтруктураРасшифровки.Вставить("Валюта",                ПараметрыПодбора.ВалютаОтображения);
	СтруктураРасшифровки.Вставить("ПоказательТипЗначения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Показатель, "ТипЗначения"));
	
	ИндАналитики = 1;
	Для Каждого СтрАналитика Из ДетализацияАналитикВлияние Цикл
		
		Если СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Сценарий")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Организация")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.ПериодОтчета")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Проект") Тогда
			
			Если СтрАналитика.Пометка Тогда //Если аналитика есть в текущей таблице, тогда берем из таблицы.
				СтруктураРасшифровки.Вставить(СтрАналитика.Представление, ТекущаяСтрока[СтрАналитика.Представление]);
			Иначе // Берем из общих отборов, если есть.
				
				СтруктураРасшифровки.Вставить(
					СтрАналитика.Представление, 
					ТаблицаВыделенныхПоказателейМоделирование[0][СтрАналитика.Представление]);
				
			КонецЕсли;
			
		Иначе
			
			Если СтрАналитика.Пометка Тогда // Если аналитика есть в текущей таблице, тогда берем из таблицы.
				СтруктураРасшифровки.Вставить(ПолучитьКодПВХАналитики(СтрАналитика.Значение),ТекущаяСтрока["Аналитика" + ИндАналитики]);
				ИндАналитики = ИндАналитики + 1;
			Иначе
				тБыстрыеОтборы = НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(
					Новый Структура("ОсьТаблицы,КодПоля",
					ПредопределенноеЗначение("Перечисление.ОсиСводнойТаблицы.Отборы"),
					СтрАналитика.Представление));
				Если тБыстрыеОтборы.Количество() = 1 Тогда
					СтруктураРасшифровки.Вставить(
						СтрАналитика.Представление,
						АналитикиОтчета[СтрАналитика.Представление]);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураРасшифровки;
	
КонецФункции

Функция ПолучитьКодПВХАналитики(ПВХСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПВХСсылка, "Код");
	
КонецФункции

Функция ИзменитьСоставАналитикиТаблицыФакторов(ТаблицаЧувствительностиФакторов, ДетализацияАналитикВлияние)
	
	//Заполним выбранные аналитики по текущей таблице показателей
	ДетализацияАналитикВлияниеПредв = Новый СписокЗначений;
	
	//Заполним ключевые аналитики
	ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий,     "Сценарий");
	ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Организация,  "Организация");
	ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета, "ПериодОтчета");
	ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Проект,       "Проект");
	
	//Заполним аналитики, доступные из списка текущих показателей
	тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(
		ТаблицаЧувствительностиФакторов.ВыгрузитьКолонку("Показатель"));
	
	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Показатель) Тогда
			Продолжить;
		КонецЕсли;
		
		тПоказательКэш = тКэшАналитикПоказателей.Найти(Стр.Показатель,"Показатель");
		Для ИндАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			
			ТекАналитика = тПоказательКэш["ВидАналитики"+ИндАналитики];
			Если Не ЗначениеЗаполнено(ТекАналитика) Тогда
				Прервать;
			Иначе
				
				Если ДетализацияАналитикВлияниеПредв.НайтиПоЗначению(ТекАналитика) = Неопределено Тогда
					ДетализацияАналитикВлияниеПредв.Добавить(ТекАналитика,Строка(ТекАналитика));
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрАналитика из ДетализацияАналитикВлияние Цикл
		
		ТекАналитика = ДетализацияАналитикВлияниеПредв.НайтиПоЗначению(СтрАналитика.Значение);
		Если НЕ ТекАналитика = Неопределено Тогда
			ТекАналитика.Пометка = СтрАналитика.Пометка 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДетализацияАналитикВлияниеПредв;
	
КонецФункции

#КонецОбласти

Функция РеквизитыОбработкиАналитическийБланк() Экспорт
	
	РеквизитыОбработкиАналитическийБланк = Новый Структура;
	МетаданныеОбработки = Метаданные.Обработки.АналитическийБланк;
	Для Каждого Реквизит Из МетаданныеОбработки.Реквизиты Цикл
		РеквизитыОбработкиАналитическийБланк.Вставить(Реквизит.Имя);
	КонецЦикла;
	ТабличныеЧасти = Новый Структура;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбработки.ТабличныеЧасти Цикл
		ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя);
	КонецЦикла;
	
	РеквизитыОбработкиАналитическийБланк.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	Возврат РеквизитыОбработкиАналитическийБланк;
	
КонецФункции

Функция РеквизитыРасчетаИЗаписиПоказателей() Экспорт
	
	РеквизитыОбработкиРасчетаИЗаписиПоказателей = Новый Структура;
	МетаданныеОбработки = Метаданные.Обработки.РасчетИЗаписьПоказателей;
	Для Каждого Реквизит Из МетаданныеОбработки.Реквизиты Цикл
		РеквизитыОбработкиРасчетаИЗаписиПоказателей.Вставить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат РеквизитыОбработкиРасчетаИЗаписиПоказателей;
	
КонецФункции

#Область ВыводДиаграммы

Функция РассчитатьВлияниеФакторовИВывестиДиаграмму(ПараметрыПодбора) Экспорт
	
	Результат = Новый Структура;
	
	ТаблицаВыделенныхПоказателейМоделирование = ПараметрыПодбора.ТаблицаВыделенныхПоказателейМоделирование;
	ТаблицаЧувствительностиФакторов           = ПараметрыПодбора.ТаблицаЧувствительностиФакторов;
	СтрокаЦелевойДополнительный               = ТаблицаВыделенныхПоказателейМоделирование.НайтиСтроки(Новый Структура("Базовый",Ложь));
	СтрокаЦелевойБазовый                      = ТаблицаВыделенныхПоказателейМоделирование.НайтиСтроки(Новый Структура("Базовый",Истина));
	
	ТекТаблицаМоделирования = ТаблицаЧувствительностиФакторов.СкопироватьКолонки();
	ТекТаблицаМоделирования.Колонки.Добавить("СтрокаТаблицыЧувствительности");
	ТекТаблицаМоделирования.Колонки.Добавить("ОбработкаВыполнена",      ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаМоделирования.Колонки.Добавить("БазовоеЗначение1",        ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	ТекТаблицаМоделирования.Колонки.Добавить("ЗначениеМоделирование1",  ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	ТекТаблицаМоделирования.Колонки.Добавить("РезультатРасчетаВлияния", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	Для Каждого Строка Из ТаблицаЧувствительностиФакторов Цикл 
		
		НоваяСтрока = ТекТаблицаМоделирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		НоваяСтрока.СтрокаТаблицыЧувствительности=Строка;
		
		НоваяСтрока.ЗначениеМоделирование1 = ПолучитьДанныеПоказателяПоДополнительнойЦели(
			СтрокаЦелевойДополнительный[0],
			Строка,
			Истина,
			ПараметрыПодбора);
		
	КонецЦикла;
	
	тПараметрыДиаграммыВодопад = Новый ТаблицаЗначений;

	тПараметрыДиаграммыВодопад.Колонки.Добавить("Заголовок",               ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(200));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("Расшифровка");
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ОтклонениеОтПредыдущего", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("АбсолютноеЗначение",      ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ЗначениеНачалоКонец",     ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ОтрицательнаяБаза",       ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ОтрицательныйКрасный",    ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ОтрицательныйЗеленый",    ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ПоложительнаяБаза",       ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ПоложительныйКрасный",    ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	тПараметрыДиаграммыВодопад.Колонки.Добавить("ПоложительныйЗеленый",    ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	// Добавляем первую строку - начальное значение базового целевого показателя.
	нСтрВодопад                         = тПараметрыДиаграммыВодопад.Добавить();
	нСтрВодопад.Заголовок               = Строка(СтрокаЦелевойБазовый[0].Показатель);
	нСтрВодопад.Расшифровка             = СтрокаЦелевойБазовый[0].Показатель;
	нСтрВодопад.ОтклонениеОтПредыдущего = СтрокаЦелевойБазовый[0].Значение;
	нСтрВодопад.АбсолютноеЗначение      = СтрокаЦелевойБазовый[0].Значение;
	нСтрВодопад.ЗначениеНачалоКонец     = СтрокаЦелевойБазовый[0].Значение;
	
	// Расчет влияния факторов дополнительного сценария на целевой результат методом цепных подстановок.
	НомерТранзакции = 99999;
	Для Каждого СтрФактор Из ТекТаблицаМоделирования Цикл
		
		СтруктураРасшифровкиКонтекста      = ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(
			РасшифровкаПоказателяПоТаблице(Строка, ПараметрыПодбора));
		СтрФактор.РезультатРасчетаВлияния  = РассчитатьРезультирующееЗначениеЦелевогоПоказателя(
			СтруктураРасшифровкиКонтекста,
			СтрФактор.ЗначениеМоделирование,
			СтрФактор.ЗначениеМоделирование1,
			НомерТранзакции,
			,
			ПараметрыПодбора);
		
		//Добавляем строку в таблицы диаграммы
		нСтрВодопад                         = тПараметрыДиаграммыВодопад.Добавить();
		нСтрВодопад.Заголовок               = Строка(СтрФактор.Показатель);
		нСтрВодопад.Расшифровка             = СтрФактор.Показатель;
		нСтрВодопад.АбсолютноеЗначение      = СтрФактор.РезультатРасчетаВлияния;
		
		нСтрВодопадПредыдущая               = тПараметрыДиаграммыВодопад[тПараметрыДиаграммыВодопад.Количество()-2];
		
		нСтрВодопад.ОтклонениеОтПредыдущего = нСтрВодопад.АбсолютноеЗначение-нСтрВодопадПредыдущая.ОтклонениеОтПредыдущего;
		нСтрВодопад.ОтрицательнаяБаза       = ?((нСтрВодопад.АбсолютноеЗначение <0 И нСтрВодопадПредыдущая.АбсолютноеЗначение < 0), Макс(нСтрВодопад.АбсолютноеЗначение, нСтрВодопадПредыдущая.АбсолютноеЗначение), 0);
		нСтрВодопад.ОтрицательныйКрасный    = ?((нСтрВодопад.АбсолютноеЗначение <0 И нСтрВодопад.ОтклонениеОтПредыдущего < 0), Макс(нСтрВодопад.АбсолютноеЗначение, нСтрВодопад.ОтклонениеОтПредыдущего), 0);
		нСтрВодопад.ОтрицательныйЗеленый    = ?((нСтрВодопадПредыдущая.АбсолютноеЗначение <0 И нСтрВодопад.ОтклонениеОтПредыдущего > 0), Макс(нСтрВодопадПредыдущая.АбсолютноеЗначение, -1 * нСтрВодопад.ОтклонениеОтПредыдущего), 0);
		
		нСтрВодопад.ПоложительнаяБаза       = ?((нСтрВодопад.АбсолютноеЗначение >0 И нСтрВодопадПредыдущая.АбсолютноеЗначение > 0), Мин(нСтрВодопад.АбсолютноеЗначение, нСтрВодопадПредыдущая.АбсолютноеЗначение), 0);
		нСтрВодопад.ПоложительныйКрасный    = ?((нСтрВодопадПредыдущая.АбсолютноеЗначение >0 И нСтрВодопад.ОтклонениеОтПредыдущего > 0),Мин(нСтрВодопадПредыдущая.АбсолютноеЗначение, -1 * нСтрВодопад.ОтклонениеОтПредыдущего), 0);
		нСтрВодопад.ПоложительныйЗеленый    = ?((нСтрВодопад.АбсолютноеЗначение >0 И нСтрВодопад.ОтклонениеОтПредыдущего > 0), Мин(нСтрВодопад.АбсолютноеЗначение, нСтрВодопад.ОтклонениеОтПредыдущего), 0);
	
	КонецЦикла;
	
	тПараметрыДиаграммыВодопадАдрес = ПоместитьВоВременноеХранилище(
		тПараметрыДиаграммыВодопад,
		ПараметрыПодбора.тПараметрыДиаграммыВодопадАдресВФоне);
	
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(ПараметрыПодбора.ИдентификаторДанныхМоделирование, НомерТранзакции);
	
	Результат.Вставить("тПараметрыДиаграммыВодопадАдрес", тПараметрыДиаграммыВодопадАдрес);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеПоказателяПоДополнительнойЦели(СтрокаЦелевой, Строка, ВключатьДанныеМодели, ПараметрыПодбора)
	
	ЧислоДопАналитик = ПараметрыПодбора.ЧислоДопАналитик;
	СтруктураРасшифровки = Новый Структура;
	
	// Преобразуем строку с аналитиками к инлексам группы раскрытия.
	тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Строка.Показатель);
	ПреобразоватьИндексыАналитик(Строка, тКэшАналитикПоказателей, ПараметрыПодбора.ДетализацияАналитикВлияние, ЧислоДопАналитик);
	
	СтруктураРасшифровки.Вставить("Показатель",   Строка.Показатель);
	СтруктураРасшифровки.Вставить("Сценарий",     СтрокаЦелевой.Сценарий);
	СтруктураРасшифровки.Вставить("Организация",  СтрокаЦелевой.Организация);
	СтруктураРасшифровки.Вставить("ПериодОтчета", Строка.ПериодОтчета);
	
	СтруктураРасшифровки.Вставить("Проект", Строка.Проект);
	СтруктураРасшифровки.Вставить("Валюта", ПараметрыПодбора.ВалютаОтображения);
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СтруктураРасшифровки.Вставить("Аналитика" + Инд, Строка["Аналитика" + Инд]);
	КонецЦикла;
	
	Возврат ПолучитьТекущееЗначениеПоказателя(СтруктураРасшифровки, ВключатьДанныеМодели, ПараметрыПодбора);
	
КонецФункции

Процедура ПреобразоватьИндексыАналитик(СтрокаТаблицы, тКэшАналитикПоказателей, ДетализацияАналитикВлияние, ЧислоДопАналитик)
	
	тПоказатель                   = тКэшАналитикПоказателей.Найти(СтрокаТаблицы.Показатель,"Показатель"); 
	ИндексАналитикиВТаблице       = 0;
	ЧислоДопАналитик              = ЧислоДопАналитик;
	СтруктураСоответствияАналитик = Новый Структура;
	
	Для Каждого СтрСписка Из ДетализацияАналитикВлияние Цикл
		Если СтрСписка.Пометка И Не ТипЗнч(СтрСписка.Значение) = Тип("ПеречислениеСсылка.ПостоянныеПоляСводнойТаблицы") Тогда
			
			ИндексАналитикиВТаблице = ИндексАналитикиВТаблице + 1;
			ПвхАналитики            = СтрСписка.Значение;
			Для Инд=1 По ЧислоДопАналитик Цикл
				Если тПоказатель["ВидАналитики" + Инд] = ПвхАналитики Тогда
					СтруктураСоответствияАналитик.Вставить("Аналитика" + Инд, СтрокаТаблицы["Аналитика" + ИндексАналитикиВТаблице]);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Инд = 1 По ЧислоДопАналитик Цикл
		ПредставлениеАналитики = "Аналитика" + Инд;
		СтрокаТаблицы[ПредставлениеАналитики] = Неопределено;
		Если СтруктураСоответствияАналитик.Свойство(ПредставлениеАналитики) Тогда 
			СтрокаТаблицы[ПредставлениеАналитики] = СтруктураСоответствияАналитик[ПредставлениеАналитики];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекущееЗначениеПоказателя(СтруктураРасшифровки, ВключатьДанныеМодели, ПараметрыПодбора)
	
	СтруктураОтбираемыхАналитик   = Новый Структура;
	СтруктураРаскрываемыхАналитик = Новый Структура;
	
	Если НЕ СтруктураРасшифровки.Свойство("Показатель") 
		ИЛИ НЕ СтруктураРасшифровки.Свойство("Сценарий")
		ИЛИ НЕ СтруктураРасшифровки.Свойство("Организация")
		ИЛИ НЕ СтруктураРасшифровки.Свойство("ПериодОтчета") Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Показатель) 
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Сценарий)
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.ПериодОтчета) Тогда
		Возврат 0;
	КонецЕсли;
	
	Для Каждого тОтбор Из СтруктураРасшифровки Цикл
		Если тОтбор.Ключ = "Показатель" Тогда
			МассивПоказателей = Новый Массив;
			МассивПоказателей.Добавить(тОтбор.Значение);
			СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета", МассивПоказателей);
		Иначе	
			СтруктураОтбираемыхАналитик.Вставить(тОтбор.Ключ, тОтбор.Значение);
		КонецЕсли;
	КонецЦикла;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(СтруктураРасшифровки.Показатель);
	
	Результат = ПолучитьДанныеПоказателяМоделирование(
		СтруктураОтбираемыхАналитик,
		СтруктураРаскрываемыхАналитик,
		ВключатьДанныеМодели,
		,
		ПараметрыПодбора.ИдентификаторДанныхМоделирование);
	
	Если Результат.Количество() = 1 Тогда
		Возврат Результат[0].Значение;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеСводнойТаблицыИПересчет

Функция НарисоватьТаблицуПриОбновлении(ПараметрыЗадания) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СтруктураНастроекАналитическогоБланкаАдрес", "");
	Результат.Вставить("ОбновитьМакетШаблона",                       Ложь);
	Результат.Вставить("СброситьСостояниеНеИспользоватьШаблон",      Истина);
	Результат.Вставить("РеквизитыОбработки",                         Новый Структура);
	Результат.Вставить("ТабличныеЧастиОбработки",                    Новый Структура);
	Результат.Вставить("ПолеТабличногоДокументаМакет",               Неопределено);
	Результат.Вставить("СтруктураНастроекАналитическогоБланка",      Неопределено);
	Результат.Вставить("ОткрытиеФормы",                              ПараметрыЗадания.ОткрытиеФормы);
	
	РезультатОбновленияМакетаШаблона = Неопределено;
	
	Если ПараметрыЗадания.ОбновитьМакетШаблона Тогда;
		РезультатОбновленияМакетаШаблона = МакетШаблонаСФоне(ПараметрыЗадания);
		ПараметрыЗадания.СтруктураНастроекАналитическогоБланка =
			РезультатОбновленияМакетаШаблона.СтруктураНастроекАналитическогоБланка;
		Результат.Вставить("СтруктураНастроекАналитическогоБланка", РезультатОбновленияМакетаШаблона.СтруктураНастроекАналитическогоБланка);
	КонецЕсли;
	
	РезультатВыводаТаблицы = ВывестиСводнуюТаблицу(ПараметрыЗадания);
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатВыводаТаблицы);
	
	Возврат Результат;
	
КонецФункции

Процедура СгенерироватьМакетШаблонаВФоне(СтруктураПараметровВход) Экспорт
	
	ПолеТабличногоДокументаШаблон  					= СтруктураПараметровВход.ПолеТабличногоДокументаШаблон;
	НастройкиСоставаСтрокСводнойТаблицы         	= СтруктураПараметровВход.НастройкиСоставаСтрокСводнойТаблицы;
	НастройкиСоставаКолонокСводнойТаблицы       	= СтруктураПараметровВход.НастройкиСоставаКолонокСводнойТаблицы;
	НастройкиРасположенияПолейСводнойТаблицы    	= СтруктураПараметровВход.НастройкиРасположенияПолейСводнойТаблицы;
	НастройкиВариантаСводнойТаблицы             	= СтруктураПараметровВход.НастройкиВариантаСводнойТаблицы;
	НастройкиПериодовСводнойТаблицы             	= СтруктураПараметровВход.НастройкиПериодовСводнойТаблицы;
	НастройкиПолейСводнойТаблицы                	= СтруктураПараметровВход.НастройкиПолейСводнойТаблицы;
	НастройкиСоставаАналитикиСтрокСводнойТаблицы    = СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы;
	УникальныйИдентификатор                     	= СтруктураПараметровВход.УникальныйИдентификатор;
	
	МакетШаблонаСводнойТаблицы 						= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьМакет("МакетШаблонаСводнойТаблицы"); 

	ПолеТабличногоДокументаШаблон.Очистить();
	АналитическийБланкГенерацияМакетаУХСервер.ПроверитьНаличиеСлужебныхОбластей(ПолеТабличногоДокументаШаблон,Истина);
	
	
	ТопополгияОбластейШаблонаМакета = Новый ТаблицаЗначений;
	ТипыКолонки = Новый Массив;
	ТипыКолонки.Добавить(Тип("СправочникСсылка.СтрокиОтчетов"));
	ТипыКолонки.Добавить(Тип("СправочникСсылка.ФормулыСводнойТаблицы"));
		
	ТопополгияОбластейШаблонаМакета.Колонки.Добавить("СтрокаФормула",Новый ОписаниеТипов(ТипыКолонки));
	
	ТипыКолонки = Новый Массив;
	ТипыКолонки.Добавить(Тип("СправочникСсылка.КолонкиОтчетов"));
	ТипыКолонки.Добавить(Тип("СправочникСсылка.ФормулыСводнойТаблицы"));
		
	ТопополгияОбластейШаблонаМакета.Колонки.Добавить("КолонкаФормула",Новый ОписаниеТипов(ТипыКолонки));
	ТопополгияОбластейШаблонаМакета.Колонки.Добавить("ИмяОбласти",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	ТопополгияОбластейШаблонаМакета.Колонки.Добавить("Колонка",Новый ОписаниеТипов("Число"));
	ТопополгияОбластейШаблонаМакета.Колонки.Добавить("ЗаголовокКолонки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
		

	
	//Прочитаем оформление ячеек из макета
	СтруктураОформления  = Новый Структура;
	УстановитьШаблонУсловногоОформления(СтруктураОформления,МакетШаблонаСводнойТаблицы);

	//Получим все неудаленные показатели для текущих настроек строк
	СтрокиОтчетаМассив 	= НастройкиСоставаСтрокСводнойТаблицы.ВыгрузитьКолонку("СтрокаОтчета");
	КолонкиОтчетаМассив = НастройкиСоставаКолонокСводнойТаблицы.ВыгрузитьКолонку("КолонкаОтчета");
	текПоказатели = ПолучитьТаблицуПоказателейВидаОтчета(СтрокиОтчетаМассив,КолонкиОтчетаМассив);
	текПоказатели.Индексы.Добавить("Строка,Колонка");
	текПоказатели.Индексы.Добавить("Ссылка");

	//Получим доступные аналитики показателей
	кэшРаскрытияПоказателей = АналитическийБланкГенерацияМакетаУХСервер.ПолучитьАналитикиРаскрытияПоказателей(текПоказатели.ВыгрузитьКолонку("Ссылка"));
	кэшРаскрытияПоказателей.Индексы.Добавить("Показатель"); 
	
	//Получим доступные аналитики строк показателей
	кэшРаскрытияПоказателей_ = кэшРаскрытияПоказателей.Скопировать();
	
	ТекСтрокаСверткиПоАналитике = "СтрокаОтчета,";
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитики"+Инд+",";
		ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитики"+Инд+"Код,";
	КонецЦикла;	
	
	ТекСтрокаСверткиПоАналитике = ТекСтрокаСверткиПоАналитике+"ВидАналитикиВалюта,ВидАналитикиВалютаКод";
		
	кэшРаскрытияПоказателей_.Свернуть(ТекСтрокаСверткиПоАналитике);
	кэшРаскрытияПоказателей_.Индексы.Добавить("СтрокаОтчета");

	//Инициализация переменных
	КартинкаМакета          			= БиблиотекаКартинок.НайтиВСодержании;
	ВыводитьАналитикиСтрокВИерархии 	= НастройкиВариантаСводнойТаблицы[0].ВыводитьАналитикиСтрокВИерархии;
	ВыводитьАналитикиКолонокВИерархии 	= НастройкиВариантаСводнойТаблицы[0].ВыводитьАналитикиКолонокВИерархии;
	ВыводитьОбщийИтогПоКолонкам         = НастройкиВариантаСводнойТаблицы[0].ВыводитьОбщийИтогПоКолонкам;
	АналитикиСтрок  					= НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Строки));
	АналитикиКолонок 					= НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Колонки));
	нСтрока 	=  3;
	нКолонка 	=  2;

	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПолеТабличногоДокументаШаблон",ПолеТабличногоДокументаШаблон);
	СтруктураПараметров.Вставить("АналитикиСтрок",АналитикиСтрок);
	СтруктураПараметров.Вставить("АналитикиКолонок",АналитикиКолонок);
	СтруктураПараметров.Вставить("ВыводитьАналитикиСтрокВИерархии",ВыводитьАналитикиСтрокВИерархии);
	СтруктураПараметров.Вставить("ВыводитьАналитикиКолонокВИерархии",ВыводитьАналитикиКолонокВИерархии);
	СтруктураПараметров.Вставить("КартинкаМакета",КартинкаМакета);
	СтруктураПараметров.Вставить("нСтрока",нСтрока);
	СтруктураПараметров.Вставить("нКолонка",нКолонка);
	СтруктураПараметров.Вставить("СтруктураОформления",СтруктураОформления);
	СтруктураПараметров.Вставить("кэшРаскрытияПоказателей_",кэшРаскрытияПоказателей_);
	СтруктураПараметров.Вставить("текПоказатели",текПоказатели);
	СтруктураПараметров.Вставить("ВыводитьОбщийИтогПоКолонкам",ВыводитьОбщийИтогПоКолонкам);
	
	СтруктураПараметров.Вставить("НастройкиСоставаСтрокСводнойТаблицы",НастройкиСоставаСтрокСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиСоставаКолонокСводнойТаблицы",НастройкиСоставаКолонокСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиРасположенияПолейСводнойТаблицы",НастройкиРасположенияПолейСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиВариантаСводнойТаблицы"	,НастройкиВариантаСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиПериодовСводнойТаблицы"	,НастройкиПериодовСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиПолейСводнойТаблицы"		,НастройкиПолейСводнойТаблицы);
	СтруктураПараметров.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы"	,НастройкиСоставаАналитикиСтрокСводнойТаблицы);

	СтруктураПараметров.Вставить("ТопополгияОбластейШаблонаМакета",ТопополгияОбластейШаблонаМакета);

	
	СтруктураТекущихАналитикОтбор = Новый Структура;
	Для Каждого СтрОтбор Из НастройкиРасположенияПолейСводнойТаблицы Цикл
		Если СтрОтбор.ОсьТаблицы = Перечисления.ОсиСводнойТаблицы.Отборы И НЕ СтрОтбор.ЭтоПроизводноеПоле Тогда
			СтруктураТекущихАналитикОтбор.Вставить(СтрОтбор.КодПоля);
		КонецЕсли;	
	КонецЦикла;
	СтруктураПараметров.Вставить("СтруктураТекущихАналитикОтбор",СтруктураТекущихАналитикОтбор);
	
	//Рисуем шапку таблицы по заданной структуре колонок	
	СгенерироватьШапкуТаблицы(СтруктураПараметров);
		
	//Герерируем макеты выбранных строк и раскрытий
	СгенерироватьСтрокиШаблонаСводнойТаблицы(СтруктураПараметров);
	
	//Скопируем еще одну область выбранных колонок для итога, если нужно
	Если ВыводитьОбщийИтогПоКолонкам Тогда
		
		СдвигПоГоризонтали 		= СтруктураПараметров.ПоследняяКолонкаЗаголовка - СтруктураПараметров.нКолонкаНачалаПоказателей;
		ИсходнаяШиринаТаблицы   = СтруктураПараметров.ПоследняяКолонкаЗаголовка;
		
		МассивСвойствОбластей = Новый Массив;
		МассивСвойствОбластей.Добавить("ЦветТекста");
		МассивСвойствОбластей.Добавить("ГраницаСверху");
		МассивСвойствОбластей.Добавить("ГраницаСнизу");
		МассивСвойствОбластей.Добавить("ГраницаСлева");
		МассивСвойствОбластей.Добавить("ГраницаСправа");
		МассивСвойствОбластей.Добавить("ЦветРамки");
		МассивСвойствОбластей.Добавить("ВертикальноеПоложение");
		МассивСвойствОбластей.Добавить("ГоризонтальноеПоложение");
		МассивСвойствОбластей.Добавить("Шрифт");
		МассивСвойствОбластей.Добавить("РазмещениеТекста");
		МассивСвойствОбластей.Добавить("Расшифровка");
		МассивСвойствОбластей.Добавить("Текст");

		ИндексСтрокиТопологии = 0;

		Для ИндСтрока = СтруктураПараметров.ПоследняяСтрокаЗаголовка+1 По ПолеТабличногоДокументаШаблон.ВысотаТаблицы Цикл
			Для ИндКолонка = СтруктураПараметров.нКолонкаНачалаПоказателей+1 По ИсходнаяШиринаТаблицы Цикл
				
				ЯчейкаИсточник = ПолеТабличногоДокументаШаблон.Область(ИндСтрока,ИндКолонка,ИндСтрока,ИндКолонка);
				ЯчейкаПриемник = ПолеТабличногоДокументаШаблон.Область(ИндСтрока,ИндКолонка+СдвигПоГоризонтали,ИндСтрока,ИндКолонка+СдвигПоГоризонтали);
				Если ЯчейкаИсточник.Расшифровка = Неопределено Тогда
					
					Для Каждого СвойствоОбласти Из МассивСвойствОбластей Цикл
						ЯчейкаПриемник[СвойствоОбласти] = ЯчейкаИсточник[СвойствоОбласти];
						ЯчейкаПриемник.ЦветФона = СтруктураОформления.ОбластьЯчейкаАгрегат.ЦветФона;
					КонецЦикла;
						
				Иначе
					
					Для Каждого СвойствоОбласти Из МассивСвойствОбластей Цикл
						ЯчейкаПриемник[СвойствоОбласти] = ЯчейкаИсточник[СвойствоОбласти];
						ЯчейкаПриемник.ЦветФона = СтруктураОформления.ОбластьЯчейкаАгрегат.ЦветФона;
					КонецЦикла;	
					
					Если ЯчейкаИсточник.Расшифровка.Свойство("Ссылка") Тогда
						СтрПоказатель = текПоказатели.Найти(ЯчейкаИсточник.Расшифровка.Ссылка,"Ссылка");
						ЯчейкаПриемник.Имя 	= АналитическийБланкГенерацияМакетаУХСервер.ПолучитьИмяСледующейОбластиСервер(ПолеТабличногоДокументаШаблон, СокрЛП(СтрПоказатель.ВидОтчетаКод), СокрЛП(СтрПоказатель.ПоказательКод)); 
					КонецЕсли;
					
					Если ЯчейкаИсточник.Расшифровка.Свойство("ТекстФормулы") Тогда
						ЯчейкаПриемник.Имя 	= "Формула_"+СтрЗаменить(Новый УникальныйИдентификатор(),"-",""); 
					КонецЕсли;
	
				КонецЕсли;
				
				СтрокаТопологии = СтруктураПараметров.ТопополгияОбластейШаблонаМакета[ИндексСтрокиТопологии];
				НстрокаТопологии = СтруктураПараметров.ТопополгияОбластейШаблонаМакета.Добавить();
				ЗаполнитьЗначенияСвойств(НстрокаТопологии,СтрокаТопологии);
				НстрокаТопологии.ИмяОбласти = ЯчейкаПриемник.Имя;
				
				ИндексСтрокиТопологии = ИндексСтрокиТопологии+1;
								
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Для ИндКолонки = 1 По  ПолеТабличногоДокументаШаблон.ШиринаТаблицы Цикл
		ЯчейкаИсточник = ПолеТабличногоДокументаШаблон.Область(2,ИндКолонки,2,ИндКолонки);
		ЯчейкаИсточник.АвтоОтступ = 1;
	КонецЦикла;
	 
	// Получаем готовые запросы  и таблицы для работы аналитческого бланка.
	Отказ    = Ложь;
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	
	СтруктураНастроек = Новый Структура;
	АналитическийБланкГенерацияМакетаУХСервер.СохранитьМакетМногопериодногоБланка(
		СтруктураНастроек,
		ПолеТабличногоДокументаШаблон,
		ОбъектАБ,
		Новый УникальныйИдентификатор,
		Отказ);
	
	СтруктураНастроекАналитическогоБланкаАдрес = ПоместитьВоВременноеХранилище(СтруктураНастроек,УникальныйИдентификатор);
	СтруктураПараметровВход.Вставить("СтруктураНастроекАналитическогоБланкаАдрес",СтруктураНастроекАналитическогоБланкаАдрес);
	СтруктураПараметровВход.Вставить("СтруктураНастроек", СтруктураНастроек);
	
	ТопополгияОбластейШаблонаМакетаАдрес  = ПоместитьВоВременноеХранилище(ТопополгияОбластейШаблонаМакета,УникальныйИдентификатор);
	СтруктураПараметровВход.Вставить("ТопополгияОбластейШаблонаМакетаАдрес",ТопополгияОбластейШаблонаМакетаАдрес);


	
КонецПроцедуры

Функция МакетШаблонаСФоне(ПараметрыЗадания)
	
	ПолеТабличногоДокументаШаблон = ПараметрыЗадания.ПолеТабличногоДокументаШаблон;
	ПолеТабличногоДокументаШаблон.Очистить();

	СтруктураПараметровВход = Новый Структура;
	
	СтруктураПараметровВход.Вставить("ПолеТабличногоДокументаШаблон",              ПолеТабличногоДокументаШаблон);
	СтруктураПараметровВход.Вставить("НастройкиСоставаСтрокСводнойТаблицы",        ПараметрыЗадания.НастройкиСоставаСтрокСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиСоставаКолонокСводнойТаблицы",      ПараметрыЗадания.НастройкиСоставаКолонокСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиРасположенияПолейСводнойТаблицы",   ПараметрыЗадания.НастройкиРасположенияПолейСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиВариантаСводнойТаблицы",            ПараметрыЗадания.НастройкиВариантаСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиПериодовСводнойТаблицы",            ПараметрыЗадания.НастройкиПериодовСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиПолейСводнойТаблицы",               ПараметрыЗадания.НастройкиПолейСводнойТаблицы);
	СтруктураПараметровВход.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы",ПараметрыЗадания.НастройкиСоставаАналитикиСтрокСводнойТаблицы);	
	СтруктураПараметровВход.Вставить("УникальныйИдентификатор",                    ПараметрыЗадания.СтруктураНастроекАналитическогоБланкаАдрес);
	
	
	НастройкиСоставаАналитикиСтрокСводнойТаблицы 	= СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы;

	СтруктураПараметровВход.Вставить("СтруктураНастроекАналитическогоБланкаАдрес", "");
	
	Обработки.АналитическийБланкСводнаяТаблица.СгенерироватьМакетШаблонаВФоне(СтруктураПараметровВход); 
	
	РезультатОбновленияМакетаШаблона = Новый Структура;
	РезультатОбновленияМакетаШаблона.Вставить("СтруктураНастроекАналитическогоБланка",      СтруктураПараметровВход.СтруктураНастроек);

	Возврат РезультатОбновленияМакетаШаблона;
	
КонецФункции

Функция ВывестиСводнуюТаблицу(ПараметрыЗадания)
	
	ПолеТабличногоДокументаМакет = ПараметрыЗадания.ПолеТабличногоДокументаМакет;
	ПолеТабличногоДокументаМакет.Очистить();

	ОтчетАБ = Обработки.АналитическийБланк.Создать();
	ЗаполнитьЗначенияСвойств(ОтчетАБ, ПараметрыЗадания.РеквизитыОбработки);
	
	СтруктураПараметров     = Новый Структура;
	СтруктураПараметров.Вставить("ПолеТабличногоДокументаМакет", ПолеТабличногоДокументаМакет);
	СтруктураПараметров.Вставить("ОбновитьДанные",               Истина);
	СтруктураПараметров.Вставить("ДополнительныеНастройки",      ОтчетАБ.СТ_ДополнительныеНастройки_Объект); 
	СтруктураПараметров.Вставить("ТекущийДелитель",              ПараметрыЗадания.ТекущийДелитель);
	СтруктураПараметров.Вставить("ТекущаяТочность",              ПараметрыЗадания.УровеньТочности);
	
	Если ПараметрыЗадания.ОбновитьМакетШаблона И ТипЗнч(ПараметрыЗадания.СтруктураНастроекАналитическогоБланка) = Тип("Структура") Тогда
		СтруктураПараметров.Вставить("СтруктураНастроекВарианта", ПараметрыЗадания.СтруктураНастроекАналитическогоБланка);
	ИначеЕсли НЕ ЗначениеЗАполнено(ПараметрыЗадания.СтруктураНастроекАналитическогоБланкаАдрес)  Тогда
		СтруктураПараметров.Вставить("Бланк", ПараметрыЗадания.ВариантСводнойТаблицы);
	Иначе
		СтруктураПараметров.Вставить("СтруктураНастроекВарианта", ПараметрыЗадания.СтруктураНастроекАналитическогоБланка);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("тДополнительныхОтборов", ПодготовитьТаблицуОтборов(ПараметрыЗадания));
	
	// Если работаем в режиме базы - получим список версий для сравнения с базой.
	Если ПараметрыЗадания.РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.СравнениеСБазой Тогда
		ПараметрыБазовойВерсии = ПараметрыБазовойВерсии(СтруктураПараметров.тДополнительныхОтборов, ПараметрыЗадания);
		СтруктураПараметров.Вставить("ПараметрыБазовойВерсии",ПараметрыБазовойВерсии);
	КонецЕсли;
	
	//Офоомление групп иерарахии по нужному шаблону.
	СтруктураОформления  = Новый Структура;
	Обработки.АналитическийБланкСводнаяТаблица.УстановитьШаблонУсловногоОформления(СтруктураОформления);
	СтруктураПараметров.Вставить("СтруктураОформления",СтруктураОформления);
	
	СтруктураПараметров.Вставить("МакетКолонок",ПараметрыЗадания.МакетКолонок);
	СтруктураПараметров.Вставить("МакетСтрок",ПараметрыЗадания.МакетСтрок);
	СтруктураПараметров.Вставить("МакетТаблиц",ПараметрыЗадания.МакетТаблиц);
	СтруктураПараметров.Вставить("МакетСинтетики",ПараметрыЗадания.МакетСинтетики);

	СтруктураПараметров.Вставить("ЗаголовокСводнойТаблицы",ПараметрыЗадания.Бланк);
	
	Если ПараметрыЗадания.РежимМоделирования Тогда
		ОтчетАБ.ИдентификаторСеанса     = ПараметрыЗадания.ИдентификаторДанныхМоделирование;
	Иначе	
		ОтчетАБ.ИдентификаторСеанса     = ПараметрыЗадания.ИдентификаторФормы;
	КонецЕсли;
	
	ОтчетАБ.РежимСводнойТаблицы     = Истина;
	ОтчетАБ.ПериодОтчета			= ПараметрыЗадания.ПериодС;
	ОтчетАБ.ПериодОтчетаОкончание 	= ПараметрыЗадания.ПериодПо;
	ОтчетАБ.Валюта 			 		= ПараметрыЗадания.ВалютаОтображения;
	ОтчетАБ.Сценарий 				= ПараметрыЗадания.Сценарий;
	
	// Для корректного получения правила расчета, необходимо добавить аналитики видов отчетов
	ПараметрыНастроек = УправлениеОтчетамиУХ.ПараметрыНастроекОбработкиШаблонов(ПараметрыЗадания.АналитикиОтчета);
	ПараметрыНастроек.Вставить("ШаблонДокумента", ПараметрыЗадания.ВидОтчета);
	ПараметрыНастроек.Вставить("ПериодОтчета", ПараметрыЗадания.ПериодС);
	ОтчетАБ.ТекущееПравило = УправлениеОтчетамиУХ.ЗначениеНастройкиОбработкиШаблонов(ПараметрыНастроек, "ПравилоОбработки");
	
	ОтчетАБ.ПолучитьРезультирующийМакет(СтруктураПараметров);
	
	ОтчетАБ.ТекущийДелитель = ПараметрыЗадания.ТекущийДелитель;
	ОтчетАБ.ТекущаяТочность = ПараметрыЗадания.УровеньТочности;
	ОтчетАБ.РежимРаботы     = ПараметрыЗадания.РежимРаботы;
	
	ТЧОбработки = Метаданные.Обработки.АналитическийБланк.ТабличныеЧасти;
	ТабличныеЧастиОбработки = Новый Структура;
	Для Каждого ТЧ Из ТЧОбработки Цикл
		ТабличныеЧастиОбработки.Вставить(ТЧ.Имя, ОтчетАБ[ТЧ.Имя].Выгрузить());
	КонецЦикла;
	
	Результат = Новый Структура;
	ЗаполнитьЗначенияСвойств(ПараметрыЗадания.РеквизитыОбработки, ОтчетАБ);
	
	// Переместим данные по зарезервированным адресам, 
	// которые доступны в форме Аналитического бланка сводной таблицы.
	Для Каждого Адрес Из ПараметрыЗадания.ЗарезервированыеАдреса Цикл
		Если ЗначениеЗаполнено(ОтчетАБ[Адрес.Ключ]) Тогда
			ЗначениеВСеансеДлительнойОперации = ПолучитьИзВременногоХранилища(ОтчетАБ[Адрес.Ключ]);
			ПараметрыЗадания.РеквизитыОбработки[Адрес.Ключ] =
				ПоместитьВоВременноеХранилище(ЗначениеВСеансеДлительнойОперации, Адрес.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("РеквизитыОбработки",           ПараметрыЗадания.РеквизитыОбработки);
	Результат.Вставить("ТабличныеЧастиОбработки",      ТабличныеЧастиОбработки);
	Результат.Вставить("ПолеТабличногоДокументаМакет", ПолеТабличногоДокументаМакет);
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьТаблицуОтборов(ПараметрыЗадания); 
	
	тРасшифровкаОтборов = Новый ТаблицаЗначений;
	
	тДеревоОтборов = ПараметрыЗадания.ДЗНастройкиОтборов;
	Для Каждого СтрОтборКолонка Из тДеревоОтборов.Колонки Цикл
		тРасшифровкаОтборов.Колонки.Добавить(СтрОтборКолонка.Имя,СтрОтборКолонка.ТипЗначения);
	КонецЦикла;	
	
	тРасшифровкаОтборов.Колонки.Добавить("ИдентификаторСтроки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	тРасшифровкаОтборов.Колонки.Добавить("ИдентификаторРодителя",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	
	ИдентификаторСтроки = 1;
	
	тБыстрыеОтборы = ПараметрыЗадания.НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Отборы));
	
	Для Каждого тБыстрыйОтбор Из тБыстрыеОтборы Цикл
		
		
		
		нСтр = тРасшифровкаОтборов.Добавить();
		нСтр.ИдентификаторСтроки = ИдентификаторСтроки;
		нСтр.ПолеПредставление   = тБыстрыйОтбор.ПредставлениеПоля;
		нСтр.ПолеКод             = тБыстрыйОтбор.КодПоля;
		нСтр.ВидСравнения        = ВидСравненияКомпоновкиДанных.Равно;
		нСтр.Использовать        = Истина;
		нСтр.РежимОтбора         = Перечисления.РежимыОтборовАналитическихТаблиц.Данные;
					
		Если  тБыстрыйОтбор.ЭтоПроизводноеПоле Тогда	
			МассивТиповСтрока = СтрРазделить(тБыстрыйОтбор.ТипПроизводногоПоляСтрока,"|");
			МассивТипов       = Новый Массив;
			Для Каждого СтрТип Из МассивТиповСтрока Цикл
				МассивТипов.Добавить(Тип(СтрТип));
			КонецЦикла;		
			нСтр.ПолеКод  = тБыстрыйОтбор.ПутьКРеквизиту;		
			ПолеКод       = СтрЗаменить(нСтр.ПолеКод,".","");
		Иначе	
			
			МассивТиповСтрока = СтрРазделить(тБыстрыйОтбор.ТипСтрока,"|");
			МассивТипов       = Новый Массив;
			Для Каждого СтрТип Из МассивТиповСтрока Цикл
				МассивТипов.Добавить(Тип(СтрТип));
			КонецЦикла;	
			ПолеКод       = нСтр.ПолеКод;	
		КонецЕсли;	
	
		нСтр.ТипЗначения    = Новый ОписаниеТипов(МассивТипов);
		нСтр.ЗначениеОтбора = ПараметрыЗадания.АналитикиОтчета[ПолеКод]
		
	КонецЦикла;
	
	Для Каждого СтрЭлемент Из ПараметрыЗадания.ДЗНастройкиОтборов.Строки[0].Строки Цикл
		
		нСтр = тРасшифровкаОтборов.Добавить();
		ЗаполнитьЗначенияСвойств(нСтр,СтрЭлемент);
		нСтр.ИдентификаторСтроки = ИдентификаторСтроки;
		ИдентификаторСтроки      = ИдентификаторСтроки + 1;
		
	КонецЦикла;
	
	Возврат тРасшифровкаОтборов;
	
КонецФункции

Функция ПараметрыБазовойВерсии(тДополнительныхОтборов, ПараметрыЗадания)
	
	ПараметрыБазовойВерсии = Новый Структура;
	
	ТаблицаТекущихОтборов = Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыТекущихОтборов();
		
	ТзПараметровЗапроса = Новый ТаблицаЗначений;
	ТзПараметровЗапроса.Колонки.Добавить("ИмяОтбора");
	ТзПараметровЗапроса.Колонки.Добавить("ТипОтбора");
	ТзПараметровЗапроса.Колонки.Добавить("ЗначениеОтбора");
	ТзПараметровЗапроса.Колонки.Добавить("УидГруппыОтбора");
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВерсииЗначенийПоказателей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
	|ГДЕ
	|	ВерсииЗначенийПоказателей.ПериодОтчета В(&ПериодОтчета)
	|	И ВерсииЗначенийПоказателей.Сценарий = &Сценарий
	|	И ВерсииЗначенийПоказателей.Валюта = &Валюта
	|	И ВерсииЗначенийПоказателей.ВидОтчета В(&ВидОтчета)
	|	И ВерсииЗначенийПоказателей.ЧерноваяВерсия = ЛОЖЬ
	|	И ВерсииЗначенийПоказателей.ПометкаУдаления = ЛОЖЬ";	 
	
	Если ПараметрыЗадания.ПериодыБазаИспользовать Тогда
		СписокПериодовБазовойВерсии = Новый СписокЗначений;
		СписокПериодовБазовойВерсии.Добавить(ПараметрыЗадания.ПериодБаза);
	Иначе	 		 
		СписокПериодовБазовойВерсии = ПериодыУХ.ПолучитьПодчиненныеПериоды(
			ПараметрыЗадания.ПериодБазаС,
			ПараметрыЗадания.ПериодБазаПо);	 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗадания.СценарииБаза) Тогда
		СценарийБазовойВерсии = ПараметрыЗадания.СценарииБаза;
	Иначе 		 
		СценарийБазовойВерсии = ПараметрыЗадания.Сценарий;
	КонецЕсли;	 
	
	Запрос.УстановитьПараметр("ПериодОтчета",	СписокПериодовБазовойВерсии);
	Запрос.УстановитьПараметр("Сценарий",		СценарийБазовойВерсии);
	Запрос.УстановитьПараметр("ВидОтчета",		ПараметрыЗадания.тВидыОтчетов.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Валюта",		    ПараметрыЗадания.ВалютаОтображения);
		
	Если ЗначениеЗаполнено(ПараметрыЗадания.ОрганизацияБаза) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ВерсииЗначенийПоказателей.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация",		ПараметрыЗадания.ОрганизацияБаза);
		
	Иначе	//Получим запрос по организациям из контектса
		
		Для Каждого СтрОтбор Из тДополнительныхОтборов Цикл
			
			ОсновноеПолеКод     = ?(СтрНайти(СтрОтбор.ПолеКод,".")>0,Лев(СтрОтбор.ПолеКод,СтрНайти(СтрОтбор.ПолеКод,".")-1),СтрОтбор.ПолеКод);
			
			Если НЕ ОсновноеПолеКод 	    = "Организация" ИЛИ НЕ СтрОтбор.Использовать Тогда
				 Продолжить;
			КонецЕсли;	
	
			нСтр  						= ТаблицаТекущихОтборов.Добавить();
			нСтр.ОсновноеПолеКод        = ОсновноеПолеКод;
			ЗаполнитьЗначенияСвойств(нСтр,СтрОтбор);		
			АналитическийБланкУХСервер.ПреобразоватьОтборСКДВСтроку(нСтр,СтрОтбор); 
				
		КонецЦикла;	
			
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(ПараметрыЗадания.ПроектыБаза) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ВерсииЗначенийПоказателей.Проект = &Проект";
		Запрос.УстановитьПараметр("Проект",		ПараметрыЗадания.ПроектыБаза);
	Иначе	
		Для Каждого СтрОтбор Из тДополнительныхОтборов Цикл
			
			ОсновноеПолеКод     = ?(СтрНайти(СтрОтбор.ПолеКод,".")>0,Лев(СтрОтбор.ПолеКод,СтрНайти(СтрОтбор.ПолеКод,".")-1),СтрОтбор.ПолеКод);
			
			Если НЕ ОсновноеПолеКод 	    = "Проект" ИЛИ НЕ СтрОтбор.Использовать Тогда
				Продолжить;
			КонецЕсли;	
			
			нСтр  						= ТаблицаТекущихОтборов.Добавить();
			нСтр.ОсновноеПолеКод        = ОсновноеПолеКод;
			ЗаполнитьЗначенияСвойств(нСтр,СтрОтбор);		
			АналитическийБланкУХСервер.ПреобразоватьОтборСКДВСтроку(нСтр,СтрОтбор); 
			
		КонецЦикла;
	КонецЕсли;	 
	
	ТекстОтбораПоКлючамВерсии = АналитическийБланкУХСервер.СформироватьТекстОтбора("ВерсииЗначенийПоказателей","1",ТаблицаТекущихОтборов,ТзПараметровЗапроса);
	
	Запрос.Текст = Запрос.Текст +" 
	|	"+ТекстОтбораПоКлючамВерсии;
	Для Каждого ПараметрОтчета Из ТзПараметровЗапроса Цикл	
		Запрос.УстановитьПараметр(ПараметрОтчета.ИмяОтбора,ПараметрОтчета.ЗначениеОтбора);
	КонецЦикла;	
	
	Результат = Запрос.Выполнить();
	
	ПараметрыБазовойВерсии.Вставить("СписокВерсий",Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	ПараметрыБазовойВерсии.Вставить("СдвигПоПериоду",ПараметрыЗадания.СдвигПоПериоду);
	
	Возврат ПараметрыБазовойВерсии;
	
КонецФункции

Функция РеквизитыОбработкиАналитическийОтчет() Экспорт
	
	РеквизитыОбработкиАналитическийБланк = Новый Структура;
	МетаданныеОбработки = Метаданные.Обработки.АналитическийБланк;
	Для Каждого Реквизит Из МетаданныеОбработки.Реквизиты Цикл
		РеквизитыОбработкиАналитическийБланк.Вставить(Реквизит.Имя);
	КонецЦикла;
	ТабличныеЧасти = Новый Структура;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбработки.ТабличныеЧасти Цикл
		ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя);
	КонецЦикла;
	
	РеквизитыОбработкиАналитическийБланк.Вставить(ТабличныеЧасти);
	
	Возврат РеквизитыОбработкиАналитическийБланк;
	
КонецФункции

Функция РассчитатьПоПравилу(ПараметрыРасчета, ПараметрыЗадания, ПараметрыВыводаСводнойТаблицы) Экспорт
	
	Результат = Новый Структура;
	
	ПараметрыЗадания.ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес = 
		ПоместитьВоВременноеХранилище(ПараметрыЗадания.ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейY);
	ПараметрыЗадания.ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейXАдрес = 
		ПоместитьВоВременноеХранилище(ПараметрыЗадания.ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейX);
	
	РезультатРасчета = РасчитатьПоПравилуОбработки(ПараметрыРасчета, ПараметрыЗадания);
	Результат.Вставить("РезультатПересчета", РезультатРасчета);
	
	РезультатВыводаСводнойТаблицы = ВывестиСводнуюТаблицу(ПараметрыВыводаСводнойТаблицы);
	Результат.Вставить("РезультатВыводаСводнойТаблицы", РезультатВыводаСводнойТаблицы);
	
	Результат.Вставить("ПараметрыРасчета", ПараметрыРасчета);
	
	Возврат Результат;
	
КонецФункции

Функция РасчитатьПоПравилуОбработки(ПараметрыРасчета, ПараметрыЗадания)
	
	РасчетИЗаписьПоказателей = Обработки.РасчетИЗаписьПоказателей.Создать();
	ЗаполнитьЗначенияСвойств(РасчетИЗаписьПоказателей, ПараметрыЗадания.РеквизитыРасчетаИЗаписиПоказателей);
	РасчетИЗаписьПоказателей.АдресКэшаДанных = ПараметрыЗадания.АдресКэшаДанных;
	
	Если ПараметрыРасчета.Свойство("УточнениеСпособаФормированияОтчета")
		И ЗначениеЗаполнено(ПараметрыРасчета.УточнениеСпособаФормированияОтчета) Тогда
		ПараметрыРасчета.УточнениеСпособаФормированияОтчета = ПоместитьВоВременноеХранилище(ПараметрыРасчета.УточнениеСпособаФормированияОтчета);
	КонецЕсли;
	
	Для Каждого стрВидОтчета Из ПараметрыЗадания.тВидыОтчетов Цикл
		
		// Если выбран конкретный вид отчета, заполним только по нему
		Если ПараметрыРасчета.Свойство("ВидОтчета")
			И ПараметрыРасчета.ВидОтчета <> стрВидОтчета.Значение Тогда
			Продолжить;
		КонецЕсли;

		тДанныеДляПересчета = КлючевыеСрезыДляПересчета(стрВидОтчета.Значение, ПараметрыЗадания);
		Если тДанныеДляПересчета.СписокНезаполненныхОбязательныхСрезов.Количество() > 0 Тогда
			ОбщегоНазначенияУХ.СообщитьОбОшибке(тДанныеДляПересчета.СтрокаНезаполненныхОбязательныхСрезов);
			Прервать;
		КонецЕсли;
	
		Для Каждого СтрокаДляПересчета Из тДанныеДляПересчета.ТаблицаКлючевыхСрезовДляПересчета Цикл
			
			// Если выбрана конкретная организация, заполним только по ней
			Если ПараметрыРасчета.Свойство("Организация")
				И ПараметрыРасчета.Организация <> СтрокаДляПересчета.Организация Тогда
				Продолжить;
			КонецЕсли;
	
			НСтрока = РасчетИЗаписьПоказателей.ДанныеДляПересчетаПоказателей.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, ПараметрыРасчета);
			
			НСтрока.ВидОтчета		= стрВидОтчета.Значение;
			НСтрока.Сценарий		= ПараметрыЗадания.Сценарий;
			НСтрока.ПериодОтчета	= ПараметрыЗадания.ПериодС;
			НСтрока.ПериодОкончания	= ПараметрыЗадания.ПериодПо;
			НСтрока.Организация		= СтрокаДляПересчета.Организация;
			НСтрока.Проект			= СтрокаДляПересчета.Проект;
			
			Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				Если ЗначениеЗаполнено(стрВидОтчета.Значение["ВидАналитики"+Инд]) Тогда	
					НСтрока["Аналитика"+Инд] = СтрокаДляПересчета[стрВидОтчета.Значение["ВидАналитики"+Инд].Код];
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Если ПараметрыЗадания.КэшДанных <> Неопределено Тогда
		РасчетИЗаписьПоказателей.АдресКэшаДанных = ПоместитьВоВременноеХранилище(ПараметрыЗадания.КэшДанных, Новый УникальныйИдентификатор);
	Иначе
		РасчетИЗаписьПоказателей.АдресКэшаДанных = "";
	КонецЕсли;
	
	РезультатРасчета = РасчетИЗаписьПоказателей.РассчитатьПоДаннымДляПересчета(ПараметрыЗадания.НомерТранзакции);
	
	РеквизитыРасчетаИЗаписиПоказателей = РеквизитыРасчетаИЗаписиПоказателей();
	Если ЗначениеЗаполнено(РасчетИЗаписьПоказателей.АдресТаблицыСобытий) Тогда
		ТаблицаСобытий = ПолучитьИзВременногоХранилища(РасчетИЗаписьПоказателей.АдресТаблицыСобытий);
		РасчетИЗаписьПоказателей.АдресТаблицыСобытий = ПоместитьВоВременноеХранилище(ТаблицаСобытий, ПараметрыЗадания.АдресТаблицыСобытий);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(РеквизитыРасчетаИЗаписиПоказателей, РасчетИЗаписьПоказателей);
	
	РеквизитыРасчетаИЗаписиПоказателей.Вставить("БылиОшибки", НЕ РезультатРасчета);
	
	Возврат РеквизитыРасчетаИЗаписиПоказателей;
	
КонецФункции

Функция КлючевыеСрезыДляПересчета(ВидОтчета, ПараметрыЗадания = Неопределено)
	
	НастройкиРасположенияПолейСводнойТаблицы = ПараметрыЗадания.НастройкиРасположенияПолейСводнойТаблицы;
	ОбъектАналитическогоБланка               = ПараметрыЗадания.ОбъектАналитическогоБланка;
	
	//Вычисляем все комбинации ключевых аналитик текущего вида отчета, кроме периодов и сценария
	СписокНезаполненныхОбязательныхСрезов = Новый СписокЗначений;
	
	тКлючевыхСрезовДляПересчета = Новый ТаблицаЗначений;
	
	тКлючевыхСрезовДляПересчета.Колонки.Добавить("Проект",,"Проект");
	тКлючевыхСрезовДляПересчета.Колонки.Добавить("Организация",,"Организация");
	РазделениеПоПроектам  = ВидОтчета.РазделениеПоПроектам;
	
	МаксАналитикОтчета = 0;
	Для аИнд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(ВидОтчета["ВидАналитики"+аИнд]) Тогда	
			тКлючевыхСрезовДляПересчета.Колонки.Добавить(ВидОтчета["ВидАналитики"+аИнд].Код,,Строка(ВидОтчета["ВидАналитики"+аИнд]));
			МаксАналитикОтчета = 	МаксАналитикОтчета +1;
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого СтрКолонка Из тКлючевыхСрезовДляПересчета.Колонки цикл
		Если НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("КодПоля",СтрКолонка.Имя)).Количество() = 0 Тогда
			Если  СтрКолонка.Имя = "Проект" Тогда
				Если РазделениеПоПроектам Тогда
					СписокНезаполненныхОбязательныхСрезов.Добавить(СтрКолонка.Имя,СтрКолонка.Заголовок);
				КонецЕсли;
			Иначе	
				СписокНезаполненныхОбязательныхСрезов.Добавить(СтрКолонка.Имя,СтрКолонка.Заголовок);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	СтруктураЗначенийОтборов  	=  Новый Структура;
	тКлючевыхСрезовОтбор		 = тКлючевыхСрезовДляПересчета.СкопироватьКолонки();
	
	//Заполняем срез значениями быстрых отбров
	
	Для Каждого СтрКолонка Из тКлючевыхСрезовДляПересчета.Колонки цикл			
		Если НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("КодПоля,ОсьТаблицы",СтрКолонка.Имя,Перечисления.ОсиСводнойТаблицы.Отборы)).Количество() = 1 Тогда
			Если тКлючевыхСрезовОтбор.Количество()=0 Тогда
				нтКлючевыхСрезовОтбор = тКлючевыхСрезовОтбор.Добавить();
			Иначе	
				нтКлючевыхСрезовОтбор = тКлючевыхСрезовОтбор[0];
			КонецЕсли;
			
			СтруктураЗначенийОтборов.Вставить(СтрКолонка.Имя);		
			//нтКлючевыхСрезовОтбор[СтрКолонка.Имя] = ЭтаФорма[СтрКолонка.Имя];
			нтКлючевыхСрезовОтбор[СтрКолонка.Имя] = ПараметрыЗадания.АналитикиОтчета[СтрКолонка.Имя];
		КонецЕсли;	
	КонецЦикла;	
	
	
	СтруктураПолейСтрок       = Новый Структура;
	//Заполняем срез значениями строк 
	Для Каждого СтрКолонка Из тКлючевыхСрезовДляПересчета.Колонки цикл			
		Если НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("КодПоля,ОсьТаблицы",СтрКолонка.Имя,Перечисления.ОсиСводнойТаблицы.Строки)).Количество() = 1 Тогда
			СтруктураПолейСтрок.Вставить(СтрКолонка.Имя);		
		КонецЕсли;	
	КонецЦикла;	
	
	СтруктураПолейКолонок       = Новый Структура;
	//Заполняем срез значениями колонок 
	Для Каждого СтрКолонка Из тКлючевыхСрезовДляПересчета.Колонки цикл			
		Если НастройкиРасположенияПолейСводнойТаблицы.НайтиСтроки(Новый Структура("КодПоля,ОсьТаблицы",СтрКолонка.Имя,Перечисления.ОсиСводнойТаблицы.Колонки)).Количество() = 1 Тогда
			СтруктураПолейКолонок.Вставить(СтрКолонка.Имя);		
		КонецЕсли;	
	КонецЦикла;	
	
	//Соберем все значения ключей в строках
	тКлючевыхСрезовСтрока = тКлючевыхСрезовДляПересчета.СкопироватьКолонки();
	Если СтруктураПолейСтрок.Количество()>0 Тогда
		Если ЗначениеЗаполнено(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес) Тогда 
			СтруктураРасшифровкаОбластейY		    = ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес);
			Для Каждого СтрКлюч Из СтруктураРасшифровкаОбластейY Цикл
				Для Каждого СтрЗначение Из СтрКлюч.Значение Цикл		
					ЭтоИтог = Ложь;
					Для Каждого СтрПоле Из СтруктураПолейСтрок Цикл	
						Если  (СтрЗначение[СтрПоле.Ключ]) = Неопределено Тогда
							ЭтоИтог = Истина;
							Прервать;		
						КонецЕсли;	
					КонецЦикла;
					Если Не ЭтоИтог Тогда
						нтКлючевыхСрезовСтрока = тКлючевыхСрезовСтрока.Добавить();
						Для Каждого СтрПоле Из СтруктураПолейСтрок Цикл		
							нтКлючевыхСрезовСтрока[СтрПоле.Ключ] = СтрЗначение[СтрПоле.Ключ];
						КонецЦикла;	
					КонецЕсли;		
				КонецЦикла;		
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	//Соберем все значения ключей в Колонках
	тКлючевыхСрезовКолонка = тКлючевыхСрезовДляПересчета.СкопироватьКолонки();
	Если СтруктураПолейКолонок.Количество()>0 Тогда
		Если ЗначениеЗаполнено(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейXАдрес) Тогда 
			СтруктураРасшифровкаОбластейХ		    = ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейXАдрес);
			Для Каждого СтрКлюч Из СтруктураРасшифровкаОбластейХ Цикл
				Для Каждого СтрЗначение Из СтрКлюч.Значение Цикл		
					ЭтоИтог = Ложь;
					Для Каждого СтрПоле Из СтруктураПолейКолонок Цикл	
						Если  (СтрЗначение[СтрПоле.Ключ]) = Неопределено Тогда
							ЭтоИтог = Истина;
							Прервать;		
						КонецЕсли;	
					КонецЦикла;
					Если Не ЭтоИтог Тогда
						нтКлючевыхСрезовКолонка = тКлючевыхСрезовКолонка.Добавить();
						Для Каждого СтрПоле Из СтруктураПолейКолонок Цикл				
							нтКлючевыхСрезовКолонка[СтрПоле.Ключ] = СтрЗначение[СтрПоле.Ключ];
						КонецЦикла;	
					КонецЕсли;		
				КонецЦикла;			
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	
	тВнутреннеСоединениеТаблиц = Новый ТаблицаЗначений;
	тВнутреннеСоединениеТаблиц.Колонки.Добавить("ИмяТаблицы");
	тВнутреннеСоединениеТаблиц.Колонки.Добавить("КоличествоСтрок");
	тВнутреннеСоединениеТаблиц.Колонки.Добавить("Таблица");
	тВнутреннеСоединениеТаблиц.Колонки.Добавить("ПоляТаблицы");
	
	нтВнутреннеСоединениеТаблиц 					= тВнутреннеСоединениеТаблиц.Добавить();
	нтВнутреннеСоединениеТаблиц.ИмяТаблицы          = "тКлючевыхСрезовОтбор";
	нтВнутреннеСоединениеТаблиц.КоличествоСтрок     = тКлючевыхСрезовОтбор.Количество();
	нтВнутреннеСоединениеТаблиц.Таблица     		= тКлючевыхСрезовОтбор;
	нтВнутреннеСоединениеТаблиц.ПоляТаблицы     	= СтруктураЗначенийОтборов;
	
	нтВнутреннеСоединениеТаблиц 					= тВнутреннеСоединениеТаблиц.Добавить();
	нтВнутреннеСоединениеТаблиц.ИмяТаблицы          = "тКлючевыхСрезовСтрока";
	нтВнутреннеСоединениеТаблиц.КоличествоСтрок     = тКлючевыхСрезовСтрока.Количество();
	нтВнутреннеСоединениеТаблиц.Таблица     		= тКлючевыхСрезовСтрока;
	нтВнутреннеСоединениеТаблиц.ПоляТаблицы     	= СтруктураПолейСтрок;
	
	нтВнутреннеСоединениеТаблиц 					= тВнутреннеСоединениеТаблиц.Добавить();
	нтВнутреннеСоединениеТаблиц.ИмяТаблицы          = "тКлючевыхСрезовКолонка";
	нтВнутреннеСоединениеТаблиц.КоличествоСтрок     = тКлючевыхСрезовКолонка.Количество();
	нтВнутреннеСоединениеТаблиц.Таблица    			= тКлючевыхСрезовКолонка;
	нтВнутреннеСоединениеТаблиц.ПоляТаблицы     	= СтруктураПолейКолонок;
	
	тВнутреннеСоединениеТаблиц.Сортировать("КоличествоСтрок УБЫВ");
	
	тКлючевыхСрезовИтог = тКлючевыхСрезовДляПересчета.СкопироватьКолонки();
	
	//Если нет незаполненных ключевых аналитик, соберем финальную таблицу для пересчета из всех комбинаций строк, колонок, отборов
	Если СписокНезаполненныхОбязательныхСрезов.Количество() = 0 Тогда 	
		Для Каждого СтрТаблица1 Из тВнутреннеСоединениеТаблиц[0].Таблица Цикл
			
			Если тВнутреннеСоединениеТаблиц[1].КоличествоСтрок = 0 Тогда
				нтКлючевыхСрезов = тКлючевыхСрезовИтог.Добавить();
				Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[0].ПоляТаблицы Цикл				
					нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица1[СтрПоле.Ключ];
				КонецЦикла;		
			КонецЕсли;	
			
			Для Каждого СтрТаблица2 Из тВнутреннеСоединениеТаблиц[1].Таблица Цикл
				
				Если тВнутреннеСоединениеТаблиц[2].КоличествоСтрок = 0 Тогда
					нтКлючевыхСрезов = тКлючевыхСрезовИтог.Добавить();
					Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[0].ПоляТаблицы Цикл				
						нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица1[СтрПоле.Ключ];
					КонецЦикла;	
					Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[1].ПоляТаблицы Цикл				
						нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица2[СтрПоле.Ключ];
					КонецЦикла;	
				КонецЕсли;	
				
				Для Каждого СтрТаблица3 Из тВнутреннеСоединениеТаблиц[2].Таблица Цикл
					нтКлючевыхСрезов = тКлючевыхСрезовИтог.Добавить();
					Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[0].ПоляТаблицы Цикл				
						нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица1[СтрПоле.Ключ];
					КонецЦикла;	
					Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[1].ПоляТаблицы Цикл				
						нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица2[СтрПоле.Ключ];
					КонецЦикла;	
					Для Каждого СтрПоле Из тВнутреннеСоединениеТаблиц[2].ПоляТаблицы Цикл				
						нтКлючевыхСрезов[СтрПоле.Ключ] = СтрТаблица3[СтрПоле.Ключ];
					КонецЦикла;	
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	СтрокаСвертки = "";
	Для Каждого СтрКолонка Из тКлючевыхСрезовДляПересчета.Колонки цикл
		СтрокаСвертки = СтрокаСвертки+","+СтрКолонка.Имя;
	КонецЦикла;
	
	тКлючевыхСрезовИтог.Свернуть(СтрокаСвертки);
	
	СтрокаНезаполненныхОбязательныхСрезов =Нстр("ru = 'В таблице не определены следующие обязательные ключевые аналитики: '");
	Для Каждого Стр Из СписокНезаполненныхОбязательныхСрезов цикл
		СтрокаНезаполненныхОбязательныхСрезов = СтрокаНезаполненныхОбязательныхСрезов+","+Стр.Представление;
	КонецЦикла;
	СтрокаШаблона = Нстр("ru = '. Заполнение вида отчета %1 отменено'");
	СтрокаНезаполненныхОбязательныхСрезов = СтрокаНезаполненныхОбязательныхСрезов+СтрШаблон(СтрокаШаблона,Строка(ВидОтчета));
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("СписокНезаполненныхОбязательныхСрезов",СписокНезаполненныхОбязательныхСрезов);
	СтруктураОтвета.Вставить("ТаблицаКлючевыхСрезовДляПересчета",тКлючевыхСрезовИтог);
	СтруктураОтвета.Вставить("СтрокаНезаполненныхОбязательныхСрезов",СтрокаНезаполненныхОбязательныхСрезов);
	
	Возврат СтруктураОтвета;
	
КонецФункции

#КонецОбласти

Процедура ПрочитатьНастройкиВариантаСводнойТаблицы(ЭтаФорма,ВариантСводнойТаблицы,ПолеТабличногоДокументаШаблон = Неопределено,РежимМоделирования = Ложь,ПолеТабличногоДокументаНастройкаМакета = Неопределено) Экспорт 
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиСоставаСтрокСводнойТаблицы.ВариантСводнойТаблицы КАК ВариантСводнойТаблицы,
