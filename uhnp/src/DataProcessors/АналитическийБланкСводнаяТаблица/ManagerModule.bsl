	        МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Размещение",Новый ОписаниеТипов("Строка"),СтрРеквизит));
            МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ЭтоЭтапПроекта",Новый ОписаниеТипов("Булево"),СтрРеквизит));

			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ЭтоПроизводноеПоле",Новый ОписаниеТипов("Булево"),СтрРеквизит));
            МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ПутьКРеквизиту",Новый ОписаниеТипов("Строка"),СтрРеквизит));
            МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТипПроизводногоПоляСтрока",Новый ОписаниеТипов("Строка"),СтрРеквизит));
			
		ИначеЕсли СтрРеквизит = "НастройкиВычисляемыхВыраженийСводнойТаблицы" Тогда
			
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(СтрРеквизит,	Новый ОписаниеТипов("ТаблицаЗначений")));

			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ВариантСводнойТаблицы",Новый ОписаниеТипов("СправочникСсылка.ВариантыСводныхТаблиц"),СтрРеквизит));		

			ТипыКолонки = Новый Массив;
			ТипыКолонки.Добавить(Тип("СправочникСсылка.СтрокиОтчетов"));
			ТипыКолонки.Добавить(Тип("СправочникСсылка.ФормулыСводнойТаблицы"));
		
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("СтрокаФормула",Новый ОписаниеТипов(ТипыКолонки),СтрРеквизит));
			
			ТипыКолонки = Новый Массив;
			ТипыКолонки.Добавить(Тип("СправочникСсылка.КолонкиОтчетов"));
			ТипыКолонки.Добавить(Тип("СправочникСсылка.ФормулыСводнойТаблицы"));
			
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("КолонкаФормула",Новый ОписаниеТипов(ТипыКолонки),СтрРеквизит));
            МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("РасшифровкаГруппОтборовОперандов",Новый ОписаниеТипов("Строка"),СтрРеквизит));
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("РасшифровкаФормулы",Новый ОписаниеТипов("Строка"),СтрРеквизит));
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТекстФормулы",Новый ОписаниеТипов("Строка"),СтрРеквизит));

