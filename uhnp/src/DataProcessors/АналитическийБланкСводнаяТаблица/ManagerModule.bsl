		СтруктураОтбора = ПреобразоватьОтборСКДВОтборМакета(Поле,НастройкаОтбораСКД);
		
		нПараметрОтбора 					= ПараметрыОтбора.Добавить();
		нПараметрОтбора.Поле        		= СтрАналитикаКолонки.ПредставлениеПоля;
		нПараметрОтбора.Отбор       		= СтруктураОтбора.Отбор;
		нПараметрОтбора.ЗначениеОтбора      = СтруктураОтбора.ЗначениеОтбора;
		нПараметрОтбора.ЗначениеОтбораСтрока  = СтруктураОтбора.ЗначениеОтбораСтрока;							
		нПараметрОтбора.ТипЗначенияСтрока   = СтрАналитикаКолонки.ТипСтрока;
		нПараметрОтбора.Использовать   		= Истина;
		нПараметрОтбора.ПолеКод  			= СтрАналитикаКолонки.КодПоля;
		нПараметрОтбора.ПорядокОтбора				= 1;
				
	ИначеЕсли Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
		
		
		нПараметрОтбора 					= ПараметрыОтбора.Добавить();
		нПараметрОтбора.Поле        		= СтрАналитикаКолонки.ПредставлениеПоля;
		нПараметрОтбора.Отбор       		= Перечисления.ВидыСравненияПоказателейОтчетов.СценарийОтчета;
		нПараметрОтбора.ЗначениеОтбора      = Неопределено;
		нПараметрОтбора.ЗначениеОтбораСтрока  = ЗначениеВСтрокуВнутр(нПараметрОтбора.ЗначениеОтбора);							нПараметрОтбора.ТипЗначенияСтрока   = СтрАналитикаКолонки.ТипСтрока;
		нПараметрОтбора.Использовать   		= Истина;
		нПараметрОтбора.ПолеКод  			= СтрАналитикаКолонки.КодПоля;
		нПараметрОтбора.ПорядокОтбора				= 1;
				
	ИначеЕсли Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект Тогда
		
		СтруктураОтбора = ПреобразоватьОтборСКДВОтборМакета(Поле,НастройкаОтбораСКД);
	
		нПараметрОтбора 					= ПараметрыОтбора.Добавить();
		нПараметрОтбора.Поле        		= СтрАналитикаКолонки.ПредставлениеПоля;
		нПараметрОтбора.Отбор       		= СтруктураОтбора.Отбор;
		нПараметрОтбора.ЗначениеОтбора      = СтруктураОтбора.ЗначениеОтбора;
		нПараметрОтбора.ЗначениеОтбораСтрока  = СтруктураОтбора.ЗначениеОтбораСтрока;								
		нПараметрОтбора.ТипЗначенияСтрока   = СтрАналитикаКолонки.ТипСтрока;
		нПараметрОтбора.Использовать   		= Истина;
		нПараметрОтбора.ПолеКод  			= СтрАналитикаКолонки.КодПоля;
		нПараметрОтбора.ПорядокОтбора				= 1;
				
	Иначе	
		
		СтруктураОтбора = ПреобразоватьОтборСКДВОтборМакета(Поле,НастройкаОтбораСКД);
		
		нПараметрОтбора 					= ПараметрыОтбора.Добавить();
		нПараметрОтбора.Поле        		= СтрАналитикаКолонки.ПредставлениеПоля;
		нПараметрОтбора.Отбор       		= СтруктураОтбора.Отбор;
		нПараметрОтбора.ЗначениеОтбора      = СтруктураОтбора.ЗначениеОтбора;
		нПараметрОтбора.ЗначениеОтбораСтрока  = СтруктураОтбора.ЗначениеОтбораСтрока;								
		нПараметрОтбора.ТипЗначенияСтрока   = СтрАналитикаКолонки.ТипСтрока;
		нПараметрОтбора.Использовать   		= Истина;
		нПараметрОтбора.ПолеКод  			= СтрАналитикаКолонки.КодПоля;
		нПараметрОтбора.ПорядокОтбора				= 1;
		
	КонецЕсли;
	
		
КонецПроцедуры

Функция ПреобразоватьОтборСКДВОтборМакета(Поле,НастройкаОтбораСКД)

	СтруктураВозврата = Новый Структура;
	
	Если НастройкаОтбораСКД.Количество() = 0 Тогда
		
		//Если Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация Тогда
			
		//Иначе	
			
			СтруктураВозврата.Вставить("ЗначениеОтбора",Неопределено);
			СтруктураВозврата.Вставить("ЗначениеОтбораСтрока",ЗначениеВСтрокуВнутр(Неопределено));
			СтруктураВозврата.Вставить("Отбор",Перечисления.ВидыСравненияПоказателейОтчетов.ОтборНеПроизводится);
			
		//КонецЕсли;
		
	Иначе	
		
		Для Каждого СтрОтбор Из НастройкаОтбораСКД Цикл 
			
			ЗначениеНастройкиСКД = ЗначениеИзСтрокиВнутр(СтрОтбор.ЗначениеНастройки);
			
			Для Каждого ЭлементОтбор Из ЗначениеНастройкиСКД.Элементы Цикл
				
				СтруктураВозврата.Вставить("ЗначениеОтбора",ЭлементОтбор.ПравоеЗначение);
				СтруктураВозврата.Вставить("ЗначениеОтбораСтрока",ЗначениеВСтрокуВнутр(ЭлементОтбор.ПравоеЗначение));
				СтруктураВозврата.Вставить("Отбор",АналитическийБланкГенерацияМакетаУХСервер.ПолучитьОтборПоказателяПоОтборуСКД(ЭлементОтбор.ВидСравнения));
					
			КонецЦикла;	
				
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
		
КонецФункции	

Процедура УстановитьИерархиюГруппировокСтрок(СтруктураПараметров)
	
	ПолеТабличногоДокументаШаблон       = СтруктураПараметров.ПолеТабличногоДокументаШаблон;
    НастройкиСоставаСтрокСводнойТаблицы = СтруктураПараметров.НастройкиСоставаСтрокСводнойТаблицы;
	КоличествоСтрок =1;		
	
	ТЗГрупп = Новый ТаблицаЗначений;
	ТЗГрупп.Колонки.Добавить("ИндексНачалаСтроки",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(10));
	ТЗГрупп.Колонки.Добавить("УровеньТекущейОбласти",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(3));
	ТЗГрупп.Колонки.Добавить("ГруппаОткрыта",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	
	УровеньПоследнейСтроки = 0;
	
	СтруктураПоиска 	= Новый Структура();
	ВсегоСтрок          = НастройкиСоставаСтрокСводнойТаблицы.Количество()-1;

	
	Для ИндексСтроки=0 по ВсегоСтрок Цикл
			
		СтрСтрока 				= НастройкиСоставаСтрокСводнойТаблицы[ИндексСтроки];
		
		ТекущаяСтрока    	=  СтрСтрока;
		ПредыдущаяСтрока  	=  ?(ИндексСтроки=0,СтрСтрока,НастройкиСоставаСтрокСводнойТаблицы[ИндексСтроки-1]);
		СледующаяСтрока 	=  ?(ИндексСтроки = ВсегоСтрок,НастройкиСоставаСтрокСводнойТаблицы[0],НастройкиСоставаСтрокСводнойТаблицы[ИндексСтроки+1]);
		КоординатаВтаблице  =  ПолеТабличногоДокументаШаблон.Область("СтрокаСТ_Номер"+Формат(СтрСтрока.НомерПоПорядку,"ЧГ=0")).Верх;
				
		Если  ТекущаяСтрока.УровеньСтроки < ПредыдущаяСтрока.УровеньСтроки Тогда // Закрываем все открытые группы с уровнем большим текущего  			
			ОткрытыеСтроки = ТЗГрупп.НайтиСтроки(Новый Структура("ГруппаОткрыта",Истина)); 	
			Для Каждого оСтр Из ОткрытыеСтроки Цикл  
				
				Если  оСтр.УровеньТекущейОбласти >= ТекущаяСтрока.УровеньСтроки Тогда 					
					оСтр.ГруппаОткрыта = Ложь;  									
					ПолеТабличногоДокументаШаблон.Область(оСтр.ИндексНачалаСтроки,0,КоординатаВтаблице-1,0).Сгруппировать();   
				КонецЕсли;			
				
			КонецЦикла;
		КонецЕсли;
				
		Если СледующаяСтрока.УровеньСтроки > ТекущаяСтрока.УровеньСтроки Тогда //Открываем группу
			
			Нгруппа = ТЗГрупп.Добавить();
			Нгруппа.УровеньТекущейОбласти 	= ТекущаяСтрока.УровеньСтроки;
			Нгруппа.ИндексНачалаСтроки 		= КоординатаВтаблице+1;
			Нгруппа.ГруппаОткрыта 			= Истина;	
			
		КонецЕсли;	
		
	КонецЦикла;	

	//Закрываем последнюю группу строк до конца таблицы
	ОткрытыеСтроки = ТЗГрупп.НайтиСтроки(Новый Структура("ГруппаОткрыта",Истина)); 
	Для Каждого оСтр Из ОткрытыеСтроки Цикл  
		оСтр.ГруппаОткрыта = Ложь;  									
		ПолеТабличногоДокументаШаблон.Область(оСтр.ИндексНачалаСтроки,0,КоординатаВтаблице,0).Сгруппировать();   	
	КонецЦикла;

		
КонецПроцедуры	

Процедура СгенерироватьМакетНастроекСводнойТаблицы(СтруктураПараметров)
	
    ПолеТабличногоДокументаШаблон = СтруктураПараметров.ПолеТабличногоДокументаШаблон;
	
	СтруктураОформления = СтруктураПараметров.СтруктураОформления;
	
	ПолеТабличногоДокументаНастройкаМакета = СтруктураПараметров.ПолеТабличногоДокументаНастройкаМакета;
    ПолеТабличногоДокументаНастройкаМакета.Очистить();
	
	ОбластьРаскрытияКолонок = ПолеТабличногоДокументаШаблон.Области.Найти("Раскрытие_Колонки_1");
	
	текСтрокаВывода  			= 2;
	текКолонкаВывода 			= 1;	
	//Генерация заголовка шапки
    ВывестиОбластьШаблона(ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода),СтруктураОформления.ЗаголовокШапкиСводнойТаблицы,"Строки\Колонки");	
    ПолеТабличногоДокументаНастройкаМакета.Область(0,текКолонкаВывода,0,текКолонкаВывода).ШиринаКолонки = 50;
    ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,0,текСтрокаВывода,0).ВысотаСтроки = 30;
		
	текКолонкаВывода = текКолонкаВывода+1;
	//Генерация шапки для общего итога по колонкам	
	
	КолонкаЗаголовкаРесурсов 	= ПолеТабличногоДокументаШаблон.ШиринаТаблицы+1;
	
    ВыведенныеКолонки 			= Новый Массив;
	ВыведенныеКолонкиСсылки     = Новый Массив;
	
	Для Каждого СтрКолонка Из СтруктураПараметров.НастройкиСоставаКолонокСводнойТаблицы Цикл
								
		Если СтрКолонка.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.Формула Тогда
			КолонкаФормула = СтрКолонка.ФормулаСводнойТаблицы;
		Иначе	
			КолонкаФормула = СтрКолонка.КолонкаОтчета;
		КонецЕсли;	
			
		Если ВыведенныеКолонки.Найти(КолонкаФормула) = Неопределено Тогда	//Ищем только по ключу колонки, без отборов	
			
			ВыведенныеКолонки.Добавить(КолонкаФормула);		
			ВыведенныеКолонкиСсылки.Добавить(СтрКолонка);
			
			ВывестиОбластьШаблона(ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода),СтруктураОформления.ЗаголовокКолонкиСводнойТаблицы,КолонкаФормула);	
			
			СтруктураРасшифровки = Новый Структура();
            СтруктураРасшифровки.Вставить("КолонкаФормула",КолонкаФормула);

			ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текКолонкаВывода,текКолонкаВывода).Расшифровка  = СтруктураРасшифровки;
		
			ПолеТабличногоДокументаНастройкаМакета.Область(0,текКолонкаВывода,0,текКолонкаВывода).ШиринаКолонки = 20;		
			текКолонкаВывода = текКолонкаВывода+1;
					
		КонецЕсли;	
		
		
	КонецЦикла;
	
	СтруктураПараметров.Вставить("НастройкиСоставаКолонокСводнойТаблицыРазличные",ВыведенныеКолонкиСсылки);
	
	текСтрокаВывода = текСтрокаВывода+1;
	
	Для ИндексСтроки=0 по СтруктураПараметров.НастройкиСоставаСтрокСводнойТаблицы.Количество()-1 Цикл
		
		нКолонка = 1;

		СтрСтрока 				= СтруктураПараметров.НастройкиСоставаСтрокСводнойТаблицы[ИндексСтроки];						
		//Вывод строки с колонками
		Если СтрСтрока.ЭтоФормула Тогда
			ЗаголовокСтрокиДляВывода = СтрСтрока.ЗаголовокФормулы;
		Иначе	
			ЗаголовокСтрокиДляВывода = Строка(СтрСтрока.СтрокаОтчета);
		КонецЕсли;
		
		ВывестиОбластьШаблона(ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,нКолонка,текСтрокаВывода,нКолонка),СтруктураОформления.ЗаголовокСтрокиСводнойТаблицы,ЗаголовокСтрокиДляВывода);		
		ТекущийОтступСтроки = (СтрСтрока.УровеньСтроки-1)*2;
		ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,нКолонка,текСтрокаВывода,нКолонка).Отступ  = ТекущийОтступСтроки;
		
		НастройкаОтбораСКД   = СтруктураПараметров.НастройкиСоставаАналитикиСтрокСводнойТаблицы.НайтиСтроки(Новый Структура("СтрокаОтчета",СтрСтрока.СтрокаОтчета)); 
	
		Если НастройкаОтбораСКД.Количество()>0 Тогда
			 ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,нКолонка,текСтрокаВывода,нКолонка).Картинка  = БиблиотекаКартинок.СводнаяТаблицаФиксированныеАналитики;
		КонецЕсли;	
				
		СтруктураРасшифровки = Новый Структура();
		Если СтрСтрока.ЭтоФормула Тогда
			СтруктураРасшифровки.Вставить("СтрокаФормула",СтрСтрока.ФормулаСводнойТаблицы);
			СтруктураПараметров.Вставить("СтрокаФормула",СтрСтрока.ФормулаСводнойТаблицы);
		Иначе	
			СтруктураРасшифровки.Вставить("СтрокаФормула",СтрСтрока.СтрокаОтчета);
			СтруктураПараметров.Вставить("СтрокаФормула",СтрСтрока.СтрокаОтчета);
		КонецЕсли;	
		
		ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,нКолонка,текСтрокаВывода,нКолонка).Расшифровка  = СтруктураРасшифровки;
		ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,нКолонка,текСтрокаВывода,нКолонка).Имя  		  = "СтрокаСТ_Номер"+Формат(СтрСтрока.НомерПоПорядку,"ЧГ=0");
		
		СтруктураПараметров.Вставить("СтрСтрока",СтрСтрока);
		СтруктураПараметров.Вставить("текСтрокаВывода",текСтрокаВывода);
		
		ЗаполнитьПоказателиОбластиМакетаНастроек(СтруктураПараметров);
		
		текСтрокаВывода = текСтрокаВывода+1;
	
	КонецЦикла;	
	
	УстановитьФормулуТаблицыПоНастройке(СтруктураПараметров);
	
	
КонецПроцедуры

Процедура ЗаполнитьПоказателиОбластиМакетаНастроек(СтруктураПараметров)
	
	текПоказатели 							= СтруктураПараметров.текПоказатели;	
	текФормулы                              = СтруктураПараметров.НастройкиВычисляемыхВыраженийСводнойТаблицы;
	нСтрока 								= СтруктураПараметров.нСтрока;
	нКолонка 								= 1;
    СтруктураОформления                 	= СтруктураПараметров.СтруктураОформления;
	НастройкиСоставаКолонокСводнойТаблицы   = СтруктураПараметров.НастройкиСоставаКолонокСводнойТаблицыРазличные;
	ПолеТабличногоДокументаНастройкаМакета = СтруктураПараметров.ПолеТабличногоДокументаНастройкаМакета;
		
	текКолонкаВывода = нКолонка+1;
	текСтрокаВывода  = СтруктураПараметров.текСтрокаВывода;
		
	ИндексОперанда = 1;
	
	Для Каждого СтрКолонка Из НастройкиСоставаКолонокСводнойТаблицы Цикл
		
		Если СтрКолонка.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.Формула Тогда
			КолонкаФормула = СтрКолонка.ФормулаСводнойТаблицы;
		Иначе	
			КолонкаФормула = СтрКолонка.КолонкаОтчета;
		КонецЕсли;	
		
		тПоказатель =  текПоказатели.НайтиСтроки(Новый Структура("Строка,Колонка",СтруктураПараметров.СтрСтрока.СтрокаОтчета,СтрКолонка.КолонкаОтчета));
		
		Если тПоказатель.Количество() = 1 Тогда  //Это ячейка показателя
			
			СтрПоказатель 		=  тПоказатель[0];
			ТекстЯчейки 		= СокрЛП(СтрПоказатель.ПоказательКод);	
			ОбластьЯчейки   	= ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода);	
			
			ВывестиОбластьШаблона(ОбластьЯчейки,СтруктураОформления.ОбластьЯчейкаНеЗаблокировано,ТекстЯчейки);
			
			ОбластьЯчейки.ЦветТекста    = Новый Цвет(178,178,178);

			СтруктураРасшифровки = Новый Структура;
			СтруктураРасшифровки.Вставить("Ссылка"				,СтрПоказатель.Ссылка);	
			ОбластьЯчейки.Расшифровка = СтруктураРасшифровки;
			
			
		Иначе	
				
			Если  ТипЗнч(СтруктураПараметров.СтрокаФормула) = Тип("СправочникСсылка.ФормулыСводнойТаблицы")
				ИЛИ ТипЗнч(КолонкаФормула) = Тип("СправочникСсылка.ФормулыСводнойТаблицы") Тогда
				//Это ячейка формулы
				
				тФормула =  текФормулы.НайтиСтроки(Новый Структура("СтрокаФормула,КолонкаФормула",СтруктураПараметров.СтрокаФормула,КолонкаФормула));
				
				Если тФормула.Количество() = 1 Тогда				
					//Формула уже есть.
					ОбластьЯчейки   	= ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода);	
					ВывестиОбластьШаблона(ОбластьЯчейки,СтруктураОформления.ОбластьЯчейкаАгрегат,"");		
					ОбластьЯчейки.Картинка 		= БиблиотекаКартинок.СводнаяТаблицаФормулаРавно;
					ОбластьЯчейки.Текст    		= тФормула[0].ТекстФормулы;
					ОбластьЯчейки.Имя           = "Формула_"+СтрЗаменить(Новый УникальныйИдентификатор,"-","");	
					
					СтруктураРасшифровки = Новый Структура;
					СтруктураРасшифровки.Вставить("ТекстФормулы"			,тФормула[0].ТекстФормулы);	
					СтруктураРасшифровки.Вставить("РасшифровкаФормулы"		,тФормула[0].РасшифровкаФормулы);	
					Если ЗначениеЗаполнено(тФормула[0].РасшифровкаГруппОтборовОперандов) Тогда
						СтруктураРасшифровки.Вставить("РасшифровкаГруппОтборовОперандов", тФормула[0].РасшифровкаГруппОтборовОперандов);
					КонецЕсли;	
					
					ОбластьЯчейки.Расшифровка = СтруктураРасшифровки;
					ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
					
				Иначе			
					
					//Формулы еще нет.
					ОбластьЯчейки   	= ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода);	
					ВывестиОбластьШаблона(ОбластьЯчейки,СтруктураОформления.ОбластьЯчейкаАгрегат,"");			
					ОбластьЯчейки.Картинка 		= БиблиотекаКартинок.СводнаяТаблицаФормулаРавно;
					ОбластьЯчейки.Текст    		= "";
					ОбластьЯчейки.ЦветТекста    = Новый Цвет(178,178,178);
					
					СтруктураРасшифровки = Новый Структура;
					СтруктураРасшифровки.Вставить("ТекстФормулы"				,"");	
					ОбластьЯчейки.Расшифровка = СтруктураРасшифровки;
					
				КонецЕсли;	
				
			Иначе
				 //Это пустая ячейка. 
				 ОбластьЯчейки   	= ПолеТабличногоДокументаНастройкаМакета.Область(текСтрокаВывода,текКолонкаВывода,текСтрокаВывода,текКолонкаВывода);	
				 ВывестиОбластьШаблона(ОбластьЯчейки,СтруктураПараметров.СтруктураОформления.ОбластьЯчейкаЗаблокировано,"Х"); 
                 ОбластьЯчейки.ЦветТекста    = Новый Цвет(178,178,178);
			КонецЕсли;	
			
		КонецЕсли;	
		
		текКолонкаВывода = текКолонкаВывода+1;
		
	КонецЦикла;
		
		
КонецПроцедуры

Функция ПолучитьНастройкиУсловногоОформления(СтруктураПараметров)
			
	Если СтруктураПараметров.НастройкиУсловногоОформленияСводнойТаблицы.Количество() = 0 Тогда
		 Возврат Неопределено;
	КонецЕсли;	
		
	НастройкиУсловногоОформленияМакетов = СтруктураПараметров.НастройкиУсловногоОформленияСводнойТаблицы.СкопироватьКолонки();
	НастройкиУсловногоОформленияМакетов.Колонки.Добавить("ИменаОформляемыхОбластейИсходные");
	НастройкиУсловногоОформленияМакетов.Колонки.Добавить("ИменаОформляемыхОбластейМакета");
	
	ТопополгияОбластейШаблонаМакета = СтруктураПараметров.ТопополгияОбластейШаблонаМакета;
	
	НастройкаСКДКолонок 			= Новый КомпоновщикНастроекКомпоновкиДанных;	
	МенеждежВТ 						= Новый МенеджерВременныхТаблиц;
	
	ПодготовитьЗапросТопологииОбластей(МенеждежВТ,ТопополгияОбластейШаблонаМакета);
	
	ПараметрыУсловногоОформления = Новый СписокЗначений;
	
	Для Каждого СтрокаИсходногоУО Из СтруктураПараметров.НастройкиУсловногоОформленияСводнойТаблицы Цикл
		 
		НоваяСтрокаУсловногоОформления = НастройкиУсловногоОформленияМакетов.Добавить();		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаУсловногоОформления,СтрокаИсходногоУО);
		
		//Вычислить имена областей макета, если заданы оформляемые строки или колонки
		НоваяСтрокаУсловногоОформления.ИменаОформляемыхОбластейИсходные = ПолучитьСписокОбластейПоСтркамКолонкам(МенеждежВТ,СтрокаИсходногоУО.ОформляемыеСтроки,СтрокаИсходногоУО.ОформляемыеПоля);
							
	КонецЦикла;	
	
	СтруктураНастроекУсловногоОформления = Новый Структура;	
	СтруктураНастроекУсловногоОформления.Вставить("НастройкиУсловногоОформленияМакетов",ЗначениеВСтрокуВнутр(НастройкиУсловногоОформленияМакетов));
	
	Возврат СтруктураНастроекУсловногоОформления;
	
КонецФункции	

Процедура ПодготовитьЗапросТопологииОбластей(МенеждежВТ,ТопополгияОбластейШаблонаМакета)
	
	   Запрос = Новый Запрос;
	   Запрос.МенеджерВременныхТаблиц = МенеждежВТ;
	   Запрос.Текст = "ВЫБРАТЬ  *
	   | 
	   |ПОМЕСТИТЬ ТопополгияОбластейШаблонаМакетаВрем
	   |ИЗ
	   |	&ТопополгияОбластейШаблонаМакета КАК ТопополгияОбластейШаблонаМакета";
	   
	   Запрос.УстановитьПараметр("ТопополгияОбластейШаблонаМакета",ТопополгияОбластейШаблонаМакета);
	   
	   Результат = Запрос.Выполнить();
	   	
КонецПроцедуры	

Функция ПолучитьСписокОбластейПоСтркамКолонкам(МенеждежВТ,СтрокиТаблицы,КолонкиТаблицы)
		
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеждежВТ;
	Запрос.Текст = "ВЫБРАТЬ ТопополгияОбластейШаблонаМакета.ИмяОбласти КАК ИмяОбласти 
	| 
	|ИЗ
	|	ТопополгияОбластейШаблонаМакетаВрем КАК ТопополгияОбластейШаблонаМакета
	|ГДЕ ИСТИНА"; 
		
	Если СтрокиТаблицы.Количество() > 0 Тогда
		
		Запрос.Текст = Запрос.Текст+"
		| И ТопополгияОбластейШаблонаМакета.СтрокаФормула В (&СписокСтрок)";
		Запрос.УстановитьПараметр("СписокСтрок",СтрокиТаблицы);
		
	КонецЕсли;
	
	//Для колонок уникальность определеяется представлением колонки в списке
	МассивПредставленийКолонок = Новый Массив;
	Для Каждого Колонка Из КолонкиТаблицы Цикл
		МассивПредставленийКолонок.Добавить(Колонка.Представление);
	КонецЦикла;	
	
	Если КолонкиТаблицы.Количество() > 0 Тогда
		
		Запрос.Текст = Запрос.Текст+"
		| И ТопополгияОбластейШаблонаМакета.ЗаголовокКолонки В(&СписокКолонок)";		
		Запрос.УстановитьПараметр("СписокКолонок",МассивПредставленийКолонок);
			
	КонецЕсли;
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяОбласти");
	
КонецФункции

Процедура ДобавитьФильтрПоГруппеБюджета(СтрокиОтчетаМассив,СтруктураПараметровВход)

	Если НЕ Константы.КонтролироватьСоставАналитикСтатейНаУровнеГруппы.Получить() = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтрокиОтчетов.ГруппаСтатейДляУстановкиАналитикБДДС КАК ГруппаСтатейДляУстановкиАналитикБДДС,
	               |	СтрокиОтчетов.ГруппаСтатейДляУстановкиАналитикБДР КАК ГруппаСтатейДляУстановкиАналитикБДР,
	               |	СтрокиОтчетов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	               |ГДЕ
	               |	СтрокиОтчетов.СтатьяУказываетсяВАналитике = ИСТИНА
	               |	И СтрокиОтчетов.Предназначение В(&Предназначение)
	               |	И СтрокиОтчетов.Ссылка В(&Ссылка)";
	
	Запрос.УстановитьПараметр("Ссылка",СтрокиОтчетаМассив);
	
	Предназначения = Новый Массив;
	Предназначения.Добавить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств);
	Предназначения.Добавить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов);

	
	Запрос.УстановитьПараметр("Предназначение",Предназначения);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	
	СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Сортировать("НомерНастройки");
	
	Если СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Количество() = 0 Тогда
		МаксНомер = -1;
	Иначе	
		МаксНомер = СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы[СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Количество()-1].НомерНастройки;
	КонецЕсли;	
	
	
	Пока Выборка.Следующий() Цикл
		
		МаксНомер = МаксНомер+1;
		
		АналитикаДДС = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникСтатьиДДС;
		
		ТекущаяНастройка = СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы.НайтиСтроки(Новый Структура("СтрокаОтчета,Назначение",Выборка.Ссылка,АналитикаДДС));
		Если ТекущаяНастройка.Количество() = 0 Тогда
			нСтр = СтруктураПараметровВход.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Добавить();
            нСтр.СтрокаОтчета = Выборка.Ссылка;
			нСтр.Назначение = АналитикаДДС;
			нСтр.НомерНастройки =  МаксНомер;
		Иначе	
			нСтр = ТекущаяНастройка[0];
		КонецЕсли;	
		
		ЗначениеНастройки = Новый ОтборКомпоновкиДанных;
		
		НовыйЭлементОтбора = ЗначениеНастройки.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		ПолеОтбора = Новый ПолеКомпоновкиДанных(Строка(АналитикаДДС));
		
		НовыйЭлементОтбора.ЛевоеЗначение  = ПолеОтбора;
		НовыйЭлементОтбора.Использование  = Истина;
		НовыйЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
		
		Если ЗначениеЗАполнено(Выборка.ГруппаСтатейДляУстановкиАналитикБДДС) Тогда
			НовыйЭлементОтбора.ПравоеЗначение = Выборка.ГруппаСтатейДляУстановкиАналитикБДДС;   
		ИначеЕсли ЗначениеЗАполнено(Выборка.ГруппаСтатейДляУстановкиАналитикБДР) Тогда
			НовыйЭлементОтбора.ПравоеЗначение = Выборка.ГруппаСтатейДляУстановкиАналитикБДР;	
		Иначе	
			Продолжить;
		КонецЕсли;
		
		нСтр.ЗначениеНастройки 		= ЗначениеВСтрокуВнутр(ЗначениеНастройки);
		нСтр.ПредставлениеНастройки = Строка(ЗначениеНастройки);

		
	КонецЦикла;
	
КонецПроцедуры	


#КонецОбласти


#Область КонвертацияБланковСводнойТаблицы

Процедура СконвертироватьБланки() Экспорт
	
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	БланкиОтчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БланкиОтчетов КАК БланкиОтчетов
	|ГДЕ
	|	БланкиОтчетов.РежимБланка = 1
	|	И БланкиОтчетов.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("", );
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ВсегоБланков = 0;
	СконвертированныхБланков = 0;
    ОшибочныхБланков   = 0;
	
	Пока Выборка.Следующий() Цикл
	
		Попытка
			ВыполнитьКонвертациюСервер(Выборка.Ссылка);
			СконвертированныхБланков = СконвертированныхБланков+1;
		Исключение
			ИнфоОшибки = ИнформацияОбОшибке();
			ТекОшибка = ПодробноеПредставлениеОшибки(ИнфоОшибки);
			ТекстОшибки1 = СтрШаблон(Нстр("ru = 'Ошибка конвертации бланка сводной таблицы %1%2'"), 
			               	Выборка.Ссылка, Символы.ПС);
			ТекстОшибки1 = СтрШаблон(Нстр("ru = '%1Текст ошибки:%2%3'"), ТекстОшибки1 + Символы.ПС, Символы.ПС, 
			               	ТекОшибка);
			ЗаписьЖурналаРегистрации("КонвертироватьБланкиСТ", УровеньЖурналаРегистрации.Ошибка,,, ТекОшибка);	
			ОшибочныхБланков = ОшибочныхБланков+1;
		КонецПопытки;

		ВсегоБланков = ВсегоБланков+1;
	
	КонецЦикла;
	
	
КонецПроцедуры	

Процедура ВыполнитьКонвертациюСервер(БланкИсточник)
	
			
	тНастройкиВариантаСводнойТаблицы  			= РегистрыСведений.НастройкиВариантаСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	тНастройкиПериодовСводнойТаблицы  			= РегистрыСведений.НастройкиПериодовСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
    тНастройкиПолейСводнойТаблицы  				= РегистрыСведений.НастройкиПолейСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	тНастройкиРасположенияПолейСводнойТаблицы  	= РегистрыСведений.НастройкиРасположенияПолейСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	тНастройкиРасположенияПолейСводнойТаблицы.Колонки.Добавить("ТипСтрока");
	тНастройкиСоставаКолонокСводнойТаблицы  	= РегистрыСведений.НастройкиСоставаКолонокСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	тНастройкиСоставаСтрокСводнойТаблицы  		= РегистрыСведений.НастройкиСоставаСтрокСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
    тНастройкиСоставаАналитикиСтрокСводнойТаблицы = РегистрыСведений.НастройкиСоставаАналитикиСтрокСводнойТаблицы.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	СтруктураТаблиц = Новый Структура;
    СтруктураТаблиц.Вставить("НастройкиВариантаСводнойТаблицы",тНастройкиВариантаСводнойТаблицы);
	СтруктураТаблиц.Вставить("НастройкиПериодовСводнойТаблицы",тНастройкиПериодовСводнойТаблицы);
    СтруктураТаблиц.Вставить("НастройкиПолейСводнойТаблицы",тНастройкиПолейСводнойТаблицы);
    СтруктураТаблиц.Вставить("НастройкиРасположенияПолейСводнойТаблицы",тНастройкиРасположенияПолейСводнойТаблицы);
    СтруктураТаблиц.Вставить("НастройкиСоставаКолонокСводнойТаблицы",тНастройкиСоставаКолонокСводнойТаблицы);
    СтруктураТаблиц.Вставить("НастройкиСоставаСтрокСводнойТаблицы",тНастройкиСоставаСтрокСводнойТаблицы);
    СтруктураТаблиц.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы",тНастройкиСоставаАналитикиСтрокСводнойТаблицы);

	
	ЗаполнитьСоставСтрок(БланкИсточник,СтруктураТаблиц);				
	
	ЗаполнитьСоставКолонок(БланкИсточник,СтруктураТаблиц);
	
	ЗаполнитьСтруктуруОсей(БланкИсточник,СтруктураТаблиц);			
	
	ЗаполнитьСвойстваИзмерений(СтруктураТаблиц);	
	
	ЗаполнитьНастройкуПериодов(БланкИсточник,СтруктураТаблиц);			
	
	ЗаполнитьНастройкуСоставаАналитикиСтрок(БланкИсточник,СтруктураТаблиц);
	
	ЗаписатьНастройки(БланкИсточник,СтруктураТаблиц);

	
КонецПроцедуры

Процедура ЗаполнитьСоставСтрок(БланкИсточник,СтруктураТаблиц)

	
	Запрос = Новый Запрос;
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиСтруктурыБланка.Ссылка КАК Ссылка,
	               |	НастройкиСтруктурыБланка.ВерсияДанных КАК ВерсияДанных,
	               |	НастройкиСтруктурыБланка.ПометкаУдаления КАК ПометкаУдаления,
	               |	НастройкиСтруктурыБланка.Наименование КАК Наименование,
	               |	НастройкиСтруктурыБланка.ТипЭлемента КАК ТипЭлемента,
	               |	НастройкиСтруктурыБланка.ИндексЭлемента КАК ИндексЭлемента,
	               |	НастройкиСтруктурыБланка.СтрокаОтчета КАК СтрокаОтчета,
	               |	НастройкиСтруктурыБланка.ПоказательОтчета КАК ПоказательОтчета,
	               |	НастройкиСтруктурыБланка.Защищенный КАК Защищенный,
	               |	НастройкиСтруктурыБланка.Уровень КАК Уровень,
	               |	НастройкиСтруктурыБланка.КолонкаОтчета КАК КолонкаОтчета,
	               |	НастройкиСтруктурыБланка.ПорядковыйНомер КАК ПорядковыйНомер,
	               |	НастройкиСтруктурыБланка.ЭтоЭлементГруппа КАК ЭтоЭлементГруппа,
	               |	НастройкиСтруктурыБланка.Расчетный КАК Расчетный,
	               |	НастройкиСтруктурыБланка.ВидОтклонения КАК ВидОтклонения,
	               |	НастройкиСтруктурыБланка.Сценарии КАК Сценарии,
	               |	НастройкиСтруктурыБланка.Периоды КАК Периоды,
	               |	НастройкиСтруктурыБланка.Организации КАК Организации,
	               |	НастройкиСтруктурыБланка.Проекты КАК Проекты,
	               |	НастройкиСтруктурыБланка.КодПоказателя КАК КодПоказателя,
	               |	НастройкиСтруктурыБланка.ИндексПоказателя КАК ИндексПоказателя,
	               |	НастройкиСтруктурыБланка.Использовать КАК Использовать,
	               |	НастройкиСтруктурыБланка.Предопределенный КАК Предопределенный,
	               |	НастройкиСтруктурыБланка.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	               |	НастройкиСтруктурыБланка.Представление КАК Представление,
	               |	НастройкиСтруктурыБланка.глПорядковыйНомер КАК глПорядковыйНомер,
	               |	НастройкиСтруктурыБланка.Родитель.СтрокаОтчета КАК РодительСтрокаОтчета 
	               |ИЗ
	               |	Справочник.НастройкиСтруктурыБланка КАК НастройкиСтруктурыБланка
	               |ГДЕ
	               |	НастройкиСтруктурыБланка.Владелец = &Владелец
	               |	И НастройкиСтруктурыБланка.ИндексЭлемента = 2
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	глПорядковыйНомер";
	
	Запрос.УстановитьПараметр("Владелец",БланкИсточник);
	Результат = Запрос.Выполнить().Выгрузить();
	НомерПоПорядку = 1;
	Для Каждого Стр Из Результат Цикл
		
		Нстр 						= СтруктураТаблиц.НастройкиСоставаСтрокСводнойТаблицы.Добавить();
		Нстр.СтрокаОтчета           = Стр.СтрокаОтчета;
		Нстр.СтрокаРодитель         = Стр.РодительСтрокаОтчета;
		Нстр.НомерПоПорядку         = НомерПоПорядку;
		Нстр.УровеньСтроки          = Стр.Уровень+1;
		
		НомерПоПорядку = НомерПоПорядку+1;
	КонецЦикла;	
		
КонецПроцедуры

Процедура ЗаполнитьСоставКолонок(БланкИсточник,СтруктураТаблиц)

	
	Запрос = Новый Запрос;
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиСтруктурыБланка.Ссылка КАК Ссылка,
	               |	НастройкиСтруктурыБланка.ВерсияДанных КАК ВерсияДанных,
	               |	НастройкиСтруктурыБланка.ПометкаУдаления КАК ПометкаУдаления,
	               |	НастройкиСтруктурыБланка.Наименование КАК Наименование,
	               |	НастройкиСтруктурыБланка.ТипЭлемента КАК ТипЭлемента,
	               |	НастройкиСтруктурыБланка.ИндексЭлемента КАК ИндексЭлемента,
	               |	НастройкиСтруктурыБланка.СтрокаОтчета КАК СтрокаОтчета,
	               |	НастройкиСтруктурыБланка.ПоказательОтчета КАК ПоказательОтчета,
	               |	НастройкиСтруктурыБланка.Защищенный КАК Защищенный,
	               |	НастройкиСтруктурыБланка.Уровень КАК Уровень,
	               |	НастройкиСтруктурыБланка.КолонкаОтчета КАК КолонкаОтчета,
	               |	НастройкиСтруктурыБланка.ПорядковыйНомер КАК ПорядковыйНомер,
	               |	НастройкиСтруктурыБланка.ЭтоЭлементГруппа КАК ЭтоЭлементГруппа,
	               |	НастройкиСтруктурыБланка.Расчетный КАК Расчетный,
	               |	НастройкиСтруктурыБланка.ВидОтклонения КАК ВидОтклонения,
	               |	НастройкиСтруктурыБланка.Сценарии КАК Сценарии,
	               |	НастройкиСтруктурыБланка.Периоды КАК Периоды,
	               |	НастройкиСтруктурыБланка.Организации КАК Организации,
	               |	НастройкиСтруктурыБланка.Проекты КАК Проекты,
	               |	НастройкиСтруктурыБланка.КодПоказателя КАК КодПоказателя,
	               |	НастройкиСтруктурыБланка.ИндексПоказателя КАК ИндексПоказателя,
	               |	НастройкиСтруктурыБланка.Использовать КАК Использовать,
	               |	НастройкиСтруктурыБланка.Предопределенный КАК Предопределенный,
	               |	НастройкиСтруктурыБланка.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	               |	НастройкиСтруктурыБланка.Представление КАК Представление,
	               |	НастройкиСтруктурыБланка.глПорядковыйНомер КАК глПорядковыйНомер
	               |ИЗ
	               |	Справочник.НастройкиСтруктурыБланка КАК НастройкиСтруктурыБланка
	               |ГДЕ
	               |	НастройкиСтруктурыБланка.Владелец = &Владелец
	               |	И НастройкиСтруктурыБланка.ИндексЭлемента = 10
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер";

	
	Запрос.УстановитьПараметр("Владелец",БланкИсточник);
	Результат = Запрос.Выполнить().Выгрузить();
	НомерПоПорядку = 1;
	Для Каждого Стр Из Результат Цикл
		
		Нстр 						= СтруктураТаблиц.НастройкиСоставаКолонокСводнойТаблицы.Добавить();
		Нстр.КолонкаОтчета          = Стр.Ссылка.КолонкиОтчетов[0].Колонка;
				
		Если ТипЗнч(Стр.Сценарии) =  Тип("СправочникСсылка.Сценарии") Тогда
			Нстр.Сценарий          		= Стр.Сценарии;
		КонецЕсли;
		Если ТипЗнч(Стр.Организации) = Тип("СправочникСсылка.Организации") Тогда
			Нстр.Организация          		= Стр.Организации;
		КонецЕсли;
        Если ТипЗнч(Стр.Проекты) =  Тип("СправочникСсылка.Проекты") Тогда
			Нстр.Проект          		= Стр.Проекты;
		КонецЕсли;
			
		Если СтрНайти(Стр.Периоды,НСтр("ru = 'Сдвиг по периоду: '"))>0 Тогда
			Сдвиг = Число(СтрЗаменить(Стр.Периоды,НСтр("ru = 'Сдвиг по периоду: '"),""));
			Нстр.ПериодСдвиг          	= Сдвиг;
		КонецЕсли;
		
		Если Стр.ВидОтклонения = "ТекущееЗначение" Тогда 
			Нстр.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.БазовоеЗначение;
		ИначеЕсли Стр.ВидОтклонения = "Значение" Тогда 	
			Нстр.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.БазовоеЗначение;
		ИначеЕсли Стр.ВидОтклонения = "АбсОтклонение" Тогда 		
			Нстр.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.ОтклонениеАБС;
		ИначеЕсли Стр.ВидОтклонения = "ОтнОтклонение" Тогда 	
			Нстр.ТипКолонки = Перечисления.ВидыКолонокСводнойТаблицы.ОтклонениеОтн;
		КонецЕсли;
		
		Нстр.ПредставлениеКолонки = Стр.Представление;
		Нстр.ПризнакИспользования = Стр.Использовать;
		Нстр.НомерПоПорядку       = НомерПоПорядку;
		
		НомерПоПорядку = НомерПоПорядку+1;
	КонецЦикла;	
	
		
КонецПроцедуры

Процедура ЗаполнитьСтруктуруОсей(БланкИсточник,СтруктураТаблиц)

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиСтруктурыБланка.Ось КАК Ось,
	               |	НастройкиСтруктурыБланка.Код КАК Код,
	               |	НастройкиСтруктурыБланка.Наименование КАК Наименование,
	               |	НастройкиСтруктурыБланка.ТипСтрока КАК ТипСтрока,
	               |	НастройкиСтруктурыБланка.ИндексКартинки КАК ИндексКартинки,
	               |	НастройкиСтруктурыБланка.НПП КАК НПП,
	               |	НастройкиСтруктурыБланка.ТипСубконто КАК ТипСубконто,
	               |	НастройкиСтруктурыБланка.Редактируется КАК Редактируется,
	               |	НастройкиСтруктурыБланка.Представление КАК Представление,
	               |	НастройкиСтруктурыБланка.Сортировка КАК Сортировка,
	               |	НастройкиСтруктурыБланка.ГлобальнаяАналитика КАК ГлобальнаяАналитика
	               |ИЗ
	               |	РегистрСведений.НастройкиСтруктурыБланка КАК НастройкиСтруктурыБланка
	               |ГДЕ
	               |	НастройкиСтруктурыБланка.Бланк = &Бланк
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НПП";
	
	Запрос.УстановитьПараметр("Бланк",БланкИсточник);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из Результат Цикл
		
		Если Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Валюты Тогда
            Продолжить;
        КонецЕсли;
		
		Если НЕ БланкИсточник.Владелец.РазделениеПоПроектам
			И Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Проекты Тогда
			Продолжить;
		КонецЕсли;	
		
		Нстр 						= СтруктураТаблиц.НастройкиРасположенияПолейСводнойТаблицы.Добавить();
		
		Если Стр.Ось = Перечисления.ВидыНастроекБланковСводнойТаблицы.Строка Тогда
			Нстр.ОсьТаблицы = Перечисления.ОсиСводнойТаблицы.Строки;
		ИначеЕсли Стр.Ось = Перечисления.ВидыНастроекБланковСводнойТаблицы.Колонка Тогда
			Нстр.ОсьТаблицы = Перечисления.ОсиСводнойТаблицы.Колонки;
		ИначеЕсли Стр.Ось = Перечисления.ВидыНастроекБланковСводнойТаблицы.Страница Тогда
			Нстр.ОсьТаблицы = Перечисления.ОсиСводнойТаблицы.Отборы;
		КонецЕсли;	
		
		Если Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Сценарии Тогда
			Нстр.ПредставлениеПоля = НСтр("ru = 'Сценарий'");
			Нстр.ТипСтрока = "СправочникСсылка.Сценарии";
			Нстр.КодПоля = "Сценарий";	
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий;
		ИначеЕсли Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Периоды Тогда
			Нстр.ПредставлениеПоля = НСтр("ru = 'Период отчета'");
			Нстр.ТипСтрока = "СправочникСсылка.Периоды";
			Нстр.КодПоля = "ПериодОтчета";	
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета;
		ИначеЕсли Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Организации Тогда
			Нстр.ПредставлениеПоля = НСтр("ru = 'Организация'");
			Нстр.ТипСтрока = "СправочникСсылка.Организации";
			Нстр.КодПоля = "Организация";	
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация;
		ИначеЕсли Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.Проекты Тогда
			Нстр.ПредставлениеПоля = НСтр("ru = 'Проект'");
			Нстр.ТипСтрока = "СправочникСсылка.Проекты";
			Нстр.КодПоля = "Проект";	
			Нстр.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект;
		ИначеЕсли Стр.ТипСубконто = Перечисления.ПредназначенияЭлементовАналитик.АналитикаВалюта Тогда
