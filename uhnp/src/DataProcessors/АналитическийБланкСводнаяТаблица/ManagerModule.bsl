Процедура ЗаполнитьНастройкуПериодов(БланкИсточник,СтруктураТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиМасштабаВремени.Бланк,
	|	НастройкиМасштабаВремени.ВыбранныйПериод,
