
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	
	МассивДобавляемыхТаблиц = Новый Массив;
	МассивДобавляемыхТаблиц.Добавить("НастройкиПолейСводнойТаблицы");
	Обработки.АналитическийБланкСводнаяТаблица.СоздатьРеквизитыНастроекСводнойТаблицы(ЭтаФорма);
	
	ВыбиратьТолькоПроизводныеПоля = Параметры.ВыбиратьТолькоПроизводныеПоля;
	
	ЭтаФорма["НастройкиПолейСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Параметры.НастройкиПолейСводнойТаблицыАдрес));
	
	Для Каждого СтрПоле Из ЭтаФорма["НастройкиПолейСводнойТаблицы"] Цикл
			
		Если СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.СтрокиОтчетов 
			ИЛИ СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.КолонкиОтчетов 
			ИЛИ СтрПоле.ЭтоПроизводноеПоле 
			ИЛИ  СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
			Продолжить;
        КонецЕсли;
			
		КорневойЭлемент 				= ДеревоТипов.ПолучитьЭлементы().Добавить();
		КорневойЭлемент.Имя 			= СтрПоле.Поле;
		КорневойЭлемент.Синоним 		= СтрПоле.Поле;
		КорневойЭлемент.Поле            = СтрПоле.Поле;
		КорневойЭлемент.ПутьКРеквизиту  = СтрПоле.КодПоля;
		
		Если СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект Тогда
			
			КорневойЭлемент.ТипЗначения  	= Новый ОписаниеТипов("СправочникСсылка.Проекты");
		
		ИначеЕсли СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация Тогда
			
			КорневойЭлемент.ТипЗначения  	= Новый ОписаниеТипов("СправочникСсылка.Организации");
		
		ИначеЕсли СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета Тогда
			
			КорневойЭлемент.ТипЗначения  	= Новый ОписаниеТипов("СправочникСсылка.Периоды");
		
		ИначеЕсли СтрПоле.Поле = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
			
			КорневойЭлемент.ТипЗначения  	= Новый ОписаниеТипов("СправочникСсылка.Сценарии");
			
		Иначе	
			
			КорневойЭлемент.ТипЗначения  = СтрПоле.Поле.ТипЗначения;

		КонецЕсли;	
		
		
		ЭлементЗаготовка = КорневойЭлемент.ПолучитьЭлементы().Добавить();
	
	КонецЦикла;	 
	 
КонецПроцедуры

&НаКлиенте
Процедура ИсходныйТипДанныхПриИзменении(Элемент)

	ОбновитьДеревоТипов()

КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповПередРазворачиванием(Элемент, Строка, Отказ)
	
	// Вставить содержимое обработчика.
	
	тСтрокаДерева =  ДеревоТипов.НайтиПоИдентификатору(Строка);
	Если тСтрокаДерева.ПолучитьЭлементы().Количество() = 1 
		И тСтрокаДерева.ПолучитьЭлементы()[0].Имя = "" Тогда
		ДобавитьПроизводныеРеквизиты(Строка);
		тСтрокаДерева.ПолучитьЭлементы().Удалить(тСтрокаДерева.ПолучитьЭлементы()[0]);
		
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ДеревоТиповВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Выбрать(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)

	Если Не Элементы.ДеревоТипов.ТекущиеДанные = Неопределено Тогда
		
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ИсходноеПоле",	Элементы.ДеревоТипов.ТекущиеДанные.Поле);
		СтруктураВозврата.Вставить("ПутьКРеквизиту",Элементы.ДеревоТипов.ТекущиеДанные.ПутьКРеквизиту);
        СтруктураВозврата.Вставить("ТипЗначения",	Элементы.ДеревоТипов.ТекущиеДанные.ТипЗначения);
		
		//Незачем добавлять само поле, без реквизита
		Если ВыбиратьТолькоПроизводныеПоля 
			И СтрНайти(СтруктураВозврата.ПутьКРеквизиту,".") = 0 Тогда
			Закрыть(Неопределено);
		Иначе	
			Закрыть(СтруктураВозврата);
		КонецЕсли;	
		
	Иначе
		
		Закрыть(Неопределено);
		
	КонецЕсли;
	
	
КонецПроцедуры


Процедура ОбновитьДеревоТипов()
	
	
	Если ДеревоТипов.ПолучитьЭлементы().Количество()=1 Тогда
		ДеревоТипов.ПолучитьЭлементы().Очистить();
	КонецЕсли;
	
	КорневойЭлемент 			= ДеревоТипов.ПолучитьЭлементы().Добавить();
	КорневойЭлемент.Имя 		= ИсходныйТипДанных.Наименование;
	КорневойЭлемент.Синоним 	= ИсходныйТипДанных.Наименование;
	КорневойЭлемент.ТипЗначения  = ИсходныйТипДанных.ТипЗначения;
	
	Для Каждого СтрТип Из ИсходныйТипДанных.ТипЗначения.Типы() Цикл
		
		ТекЭлемент 			= Новый(СтрТип);
		ТекМетаДанные    	= ТекЭлемент.Метаданные();		
		
		Для Каждого СтрРеквизит Из ТекМетаДанные.Реквизиты Цикл
			
			КорневойРеквизит 				= КорневойЭлемент.ПолучитьЭлементы().Добавить();
			КорневойРеквизит.Имя 			= СтрРеквизит.Имя;
			КорневойРеквизит.Синоним 		= СтрРеквизит.Синоним;
			КорневойРеквизит.ТипЗначения 	= СтрРеквизит.Тип;
				
			Если НЕ (ПроверитьЭтоПростойТип(КорневойРеквизит.ТипЗначения) ИЛИ  ЭтоПеречисление(КорневойРеквизит.ТипЗначения))   Тогда
				ЭлементЗаготовка = КорневойРеквизит.ПолучитьЭлементы().Добавить();
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	
	
КонецПроцедуры

Функция ПроверитьЭтоПростойТип(ТипЗначения)
	
	Если ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") Тогда
		Для Каждого СтрТип Из ТипЗначения.Типы() Цикл
			Если НЕ СтрТип = Тип("Число")
				И НЕ СтрТип = Тип("Строка") 
				И НЕ СтрТип = Тип("Дата")
				И НЕ СтрТип = Тип("Булево")
				И НЕ СтрТип = Тип("УникальныйИдентификатор")
				И НЕ СтрТип = Тип("ХранилищеЗначения") Тогда
				Возврат Ложь;
			КонецЕсли;	
		КонецЦикла;	
	Иначе	
		СтрТип = ТипЗначения;
		Если НЕ СтрТип = Тип("Число")
			И НЕ СтрТип = Тип("Строка") 
			И НЕ СтрТип = Тип("Дата")
			И НЕ СтрТип = Тип("Булево")
			И НЕ СтрТип = Тип("УникальныйИдентификатор")
			И НЕ СтрТип = Тип("ХранилищеЗначения") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Истина;

КонецФункции	

Функция ЭтоПеречисление(ТипЗначения)
	
	Если ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") Тогда	
		Для Каждого СтрТип Из ТипЗначения.Типы() Цикл
			Если Не ПроверитьЭтоПростойТип(СтрТип) Тогда
				ТекЭлемент 			= Новый(СтрТип);
				ТекМетаДанные    	= ТекЭлемент.Метаданные();	
				Возврат Метаданные.Перечисления.Содержит(ТекМетаДанные);			
			КонецЕсли;	
		КонецЦикла;		
	Иначе	
		СтрТип = ТипЗначения;
		ТекЭлемент 			= Новый(СтрТип);
		ТекМетаДанные    	= ТекЭлемент.Метаданные();	
		Возврат Метаданные.Перечисления.Содержит(ТекМетаДанные);	
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции	 


Функция ДобавлятьТип(ТипЗначения)
	
	Для Каждого СтрТип Из ТипЗначения.Типы() Цикл
		Если СтрТип = Тип("УникальныйИдентификатор")
			ИЛИ  СтрТип = Тип("ХранилищеЗначения") Тогда
			Возврат Ложь;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Истина;

КонецФункции	


Процедура ДобавитьПроизводныеРеквизиты(ТекущаяСтрока)

	 тСтрокаДерева =  ДеревоТипов.НайтиПоИдентификатору(ТекущаяСтрока);
	 
	 ТаблицаПроизводныхРеквизитов = Новый ТаблицаЗначений;
	 РеквизитыДерева              = ЭтаФорма.ПолучитьРеквизиты("ДеревоТипов");
	 Для Каждого СтрРеквизит Из РеквизитыДерева Цикл
		 ТаблицаПроизводныхРеквизитов.Колонки.Добавить(СтрРеквизит.Имя,СтрРеквизит.ТипЗначения);
	 КонецЦикла;	 
		 
		 	 
	 Для Каждого СтрТип Из тСтрокаДерева.ТипЗначения.Типы() Цикл
		
		ТекЭлемент 			= Новый(СтрТип);
		ТекМетаДанные    	= ТекЭлемент.Метаданные();		
		
		Если ПроверитьЭтоПростойТип(СтрТип) 
			ИЛИ  ЭтоПеречисление(СтрТип) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрРеквизит Из ТекМетаДанные.Реквизиты Цикл
				
			ЭлементТаблицы = ТаблицаПроизводныхРеквизитов.Добавить();
			
			ЭлементТаблицы.Имя 			= СтрРеквизит.Имя;
			ЭлементТаблицы.Синоним 		= СтрРеквизит.Синоним;
			ЭлементТаблицы.ТипЗначения 	= СтрРеквизит.Тип;
			ЭлементТаблицы.Поле           = тСтрокаДерева.Поле;
			ЭлементТаблицы.ПутьКРеквизиту = тСтрокаДерева.ПутьКРеквизиту+"."+СтрРеквизит.Имя;
							
		КонецЦикла;	
		
		//добавим владельца и родителя, если есть
		Для Каждого СтрРеквизит Из ТекМетаДанные.СтандартныеРеквизиты Цикл
			
			Если СтрРеквизит.Имя =   "Владелец" Тогда			
				ЭлементТаблицы = ТаблицаПроизводныхРеквизитов.Добавить();			
				ЭлементТаблицы.Имя 			= СтрРеквизит.Имя;
				ЭлементТаблицы.Синоним 		= СтрРеквизит.Синоним;
				ЭлементТаблицы.ТипЗначения 	= СтрРеквизит.Тип;
				ЭлементТаблицы.Поле         = тСтрокаДерева.Поле;
				ЭлементТаблицы.ПутьКРеквизиту = тСтрокаДерева.ПутьКРеквизиту+"."+СтрРеквизит.Имя;
			КонецЕсли;
			
			Если СтрРеквизит.Имя =   "Родитель" Тогда			
				ЭлементТаблицы = ТаблицаПроизводныхРеквизитов.Добавить();			
				ЭлементТаблицы.Имя 			= СтрРеквизит.Имя;
				ЭлементТаблицы.Синоним 		= СтрРеквизит.Имя;
				ЭлементТаблицы.ТипЗначения 	= СтрРеквизит.Тип;
				ЭлементТаблицы.Поле         = тСтрокаДерева.Поле;
				ЭлементТаблицы.ПутьКРеквизиту = тСтрокаДерева.ПутьКРеквизиту+"."+СтрРеквизит.Имя;
			КонецЕсли;
			
		КонецЦикла;	
		
		//Добавим общие реквизиты
		Для Каждого СтрОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
			ТекМетаданноеОбщегоРеквизита = СтрОбщийРеквизит.Состав.Найти(ТекМетаДанные);
			Если НЕ ТекМетаданноеОбщегоРеквизита = Неопределено
				И ТекМетаданноеОбщегоРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Тогда
				
				ЭлементТаблицы = ТаблицаПроизводныхРеквизитов.Добавить();
				
				ЭлементТаблицы.Имя 			= СтрОбщийРеквизит.Имя;
				ЭлементТаблицы.Синоним 		= СтрОбщийРеквизит.Синоним;
				ЭлементТаблицы.ТипЗначения 	= СтрОбщийРеквизит.Тип;
				ЭлементТаблицы.Поле           = тСтрокаДерева.Поле;
				ЭлементТаблицы.ПутьКРеквизиту = тСтрокаДерева.ПутьКРеквизиту+"."+СтрОбщийРеквизит.Имя;
					
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	ТаблицаПроизводныхРеквизитов.Сортировать("Синоним");
	
	Для Каждого СтрПоле Из ТаблицаПроизводныхРеквизитов Цикл
		
		Если ДобавлятьТип(СтрПоле.ТипЗначения) Тогда
			КорневойРеквизит 				= тСтрокаДерева.ПолучитьЭлементы().Добавить();
			
			ЗаполнитьЗначенияСвойств(КорневойРеквизит,СтрПоле);
			
			Если НЕ (ПроверитьЭтоПростойТип(КорневойРеквизит.ТипЗначения) ИЛИ  ЭтоПеречисление(КорневойРеквизит.ТипЗначения))   Тогда
				ЭлементЗаготовка = КорневойРеквизит.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;	
	
	
	
	
КонецПроцедуры

	


