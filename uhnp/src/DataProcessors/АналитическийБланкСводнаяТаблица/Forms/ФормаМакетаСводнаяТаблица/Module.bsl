&НаСервере
Процедура УстановитьЗначениеПоказателя(СтруктураРасшифровкиКонтекста,ЗначениеСтарое,ЗначениеНовое,НомерТранзакции)
	
	Если СтруктураРасшифровкиКонтекста.СтруктураНезаполненныхАналитик.Количество() = 0 Тогда
		
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеСтарое",ЗначениеСтарое);
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеНовое", ЗначениеНовое);
		ЗаписатьПоказательПоТаблицеФакторов(СтруктураРасшифровкиКонтекста,НомерТранзакции);
		
	Иначе	
		
		// Это агрегат - необходимо выполнить пропорциональное распределение по аналитикам
		ПараметрыФормыРаскрытия 		= АналитическийБланкУХВызовСервера.ПодготовитьПараметрыВызоваФормыРаскрытий(СтруктураРасшифровкиКонтекста.СтруктураРасшифровки,СтруктураРасшифровкиКонтекста,ПолучитьСвойстваТекущегоКонтекста());	
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеСтарое",ЗначениеСтарое);
		СтруктураРасшифровкиКонтекста.Вставить("ЗначениеНовое", ЗначениеНовое);
		ЗаписатьРаскрытиеПоТаблицеФакторов(СтруктураРасшифровкиКонтекста,ПараметрыФормыРаскрытия,НомерТранзакции);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьЗначениеЦелевогоПоказателя(тСтрока,ВключатьДанныеМодели,МассивПериодов=Неопределено,ОбщийИтог = Ложь)
	
	СтруктураОтбираемыхАналитик = Новый Структура;
    СтруктураРаскрываемыхАналитик = Новый Структура;
	 	
	СтруктураОтбираемыхАналитик.Вставить("Сценарий",тСтрока.Сценарий);
	СтруктураОтбираемыхАналитик.Вставить("Организация",тСтрока.Организация);
	СтруктураОтбираемыхАналитик.Вставить("Валюта",ВалютаОтображения);

	
	Если МассивПериодов = Неопределено  Тогда
		СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета",тСтрока.ПериодОтчета);
	Иначе	
		СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета",МассивПериодов);
	КонецЕсли;
	
	СтруктураОтбираемыхАналитик.Вставить("Проект",тСтрока.Проект);

	Для  Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(тСтрока["Аналитика"+Инд]) Тогда
			 СтруктураОтбираемыхАналитик.Вставить("Аналитика"+Инд,тСтрока["Аналитика"+Инд]);
		КонецЕсли;		
	КонецЦикла;	
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(тСтрока.Показатель);
	
	СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
	
	Результат = ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,ВключатьДанныеМодели,ОбщийИтог);
		
	Если Результат.Количество() = 1 Тогда
		 Возврат Результат[0].Значение;
	КонецЕсли;	

КонецФункции

&НаСервере
Функция ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,ВключатьДанныеМодели,ОбщийИтог = Ложь)
	
	ДополнительныеПараметры 	= Новый Структура;
	Если ВключатьДанныеМодели Тогда
		ДополнительныеПараметры.Вставить("ИдентификаторСеанса",ИдентификаторДанныхМоделирование);
	КонецЕсли;
			
	Результат = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,ДополнительныеПараметры);	
	
	СтрокаСвертки = "ПоказательОтчета";
	Если Не ОбщийИтог Тогда
		Для Каждого СтрКол Из Результат.Колонки Цикл
			Если СтрКол.Имя = "СинтетическоеЗначение" 
				ИЛИ СтрКол.Имя = "Значение" 
				ИЛИ СтрКол.Имя = "ЗначениеВалюта"
				ИЛИ СтрКол.Имя = "ПоказательОтчета" Тогда
				Продолжить;
			КонецЕсли;	
			
			СтрокаСвертки = СтрокаСвертки+","+СтрКол.Имя;
			
		КонецЦикла;	
	КонецЕсли;
	
	Результат.Свернуть(СтрокаСвертки,"Значение,ЗначениеВалюта");
	
    Возврат Результат;

КонецФункции	

#КонецОбласти

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(СтруктураРасшифровки)
		
	СтруктураНезаполненныхАналитик 	= Новый Структура;
	СтруктураОтбираемыхАналитик 	= Новый Структура;
	
	тПоказатели = Новый Массив;
	тПоказатели.Добавить(СтруктураРасшифровки.Показатель);
	ТзСвойстваПоказателей 			= АналитическийБланкГенерацияМакетаУХСервер.ПолучитьСвойстваВыбранныхПоказателей(тПоказатели);
	
	
	тПоказатель  = ТзСвойстваПоказателей.Найти(СтруктураРасшифровки.Показатель,"Ссылка");
	
	ПолнаяСтруктураАналитик = АналитическийБланкУХСервер.ПолучитьПолнуюСтруктуруАналитик(тПоказатель);	
	
	Для Каждого нАналитика Из ПолнаяСтруктураАналитик Цикл
		
		Если нАналитика.Ключ = "АналитикаВалюта" Тогда
			Если НЕ СтруктураРасшифровки.Свойство(нАналитика.Значение) Тогда
				СтруктураНезаполненныхАналитик.Вставить("АналитикаВалюта");
			Иначе	
				СтруктураОтбираемыхАналитик.Вставить("АналитикаВалюта",СтруктураРасшифровки[нАналитика.Значение]);
				СтруктураРасшифровки.Вставить("АналитикаВалюта",СтруктураРасшифровки[нАналитика.Значение]);
			КонецЕсли;	
			Продолжить;
		КонецЕсли;	
		
		Если НЕ  СтруктураРасшифровки.Свойство(нАналитика.Ключ) Тогда
			СтруктураНезаполненныхАналитик.Вставить(нАналитика.Ключ);
		Иначе	
			СтруктураОтбираемыхАналитик.Вставить(нАналитика.Ключ,СтруктураРасшифровки[нАналитика.Ключ]);
		КонецЕсли;	
	КонецЦикла;	
	
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("СтруктураНезаполненныхАналитик",СтруктураНезаполненныхАналитик);
	СтруктураОтвета.Вставить("СтруктураОтбираемыхАналитик",СтруктураОтбираемыхАналитик);
	СтруктураОтвета.Вставить("СтруктураРасшифровки",СтруктураРасшифровки);
	
	Возврат СтруктураОтвета;


КонецФункции	

&НаСервереБезКонтекста
Процедура ПроверитьДоступностьАналитики(ДетализацияАналитикВлияние,Показатель,ИндексАналитики,СтандартнаяОбработка);
	
	СтандартнаяОбработка = Ложь;
	
	Показатели = Новый Массив;
	Показатели.Добавить(Показатель);
	КэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Показатели);
	тПоказательКэш = КэшАналитикПоказателей[0]; 
	
	ИндАналитики = 0;
	Для Каждого стр Из ДетализацияАналитикВлияние Цикл
		
		Если ТипЗнч(Стр.Значение) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконтоКорпоративные") И стр.Пометка Тогда
			 ИндАналитики = ИндАналитики+1;
		КонецЕсли;	
		Если ИндАналитики = ИндексАналитики Тогда
			Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				ТекАналитика = тПоказательКэш["ВидАналитики"+Инд];
				Если ТекАналитика =  стр.Значение Тогда
					СтандартнаяОбработка = Истина;
					Возврат;
				КонецЕсли;	
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЦикла;	
	

КонецПроцедуры	

