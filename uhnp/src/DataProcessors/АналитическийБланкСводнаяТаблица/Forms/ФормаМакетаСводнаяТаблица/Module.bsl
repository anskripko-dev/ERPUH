			Если ЗначениеЗаполнено(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейХАдрес) Тогда 
				СтруктураРасшифровкаОбластейХ		    = ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейХАдрес);
				
				Для Каждого СтрКлюч Из СтруктураРасшифровкаОбластейХ Цикл
					
					Для Каждого СтрЗначение Из СтрКлюч.Значение Цикл
						Если НЕ СтрКлюч.Значение.Колонки.Найти("Проект") = Неопределено 
							И тПроекты.НайтиПоЗначению(СтрЗначение["Проект"]) = Неопределено Тогда
							тПроекты.Добавить(СтрЗначение["Проект"]);
						КонецЕсли;	
					КонецЦикла;	
				КонецЦикла;	
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	ЗаполнитьТекущиеУОП();
	
КонецПроцедуры

&НаСервере
Функция ВставитьЗначениеПоказателя(ИмяОбласти,Значение,ОписаниеИзменений="",ПредставлениеТранзакции)
	
	Возврат Обработки.АналитическийБланк.ВставитьЗначениеПоказателя(ЭтаФорма,ВалютаОтображения,ИмяОбласти,Значение,ОписаниеИзменений="",ПредставлениеТранзакции);
	
КонецФункции

&НаСервере
Процедура ВставитьЗначениеПоказателяДляОбратногоРаспределения(ИмяОбласти, ЗначениеОбласти)
	
	ТаблицаИзмененныхПоказателей = ПолучитьИзВременногоХранилища(АдресТаблицыИзмененныхПоказателейОбратноеРаспределение);
	ОбъектАБ            		= Обработки.АналитическийБланк.Создать();
	КэшАналитикПоказателей      = ПолучитьИзВременногоХранилища(ЭтаФорма[ТекущийОбъектАБ].КэшАналитикПоказателейАдрес);
	тМакет						= ЭтаФорма[ТекущийМакет];
	ТзСвойстваПоказателей       = ПолучитьИзВременногоХранилища(ЭтаФорма[ТекущийОбъектАБ].ТзСвойстваПоказателейАдрес);
    тОбъектАБ                   = ЭтаФорма[ТекущийОбъектАБ];
	тОбъект                  	= ПолучитьСвойстваТекущегоОбъектаСервер();
	ОбъектАБ.РежимРаботы        = РежимРаботы;
	АдресРасшифровки 		= Неопределено;
	ОбластьИмя 				=  ИмяОбласти;
	ОбластьРасшифровка      =  тМакет.Область(ИмяОбласти).Расшифровка;
	
	СтруктураНезаполненныхАналитик 	= Новый Структура;
	СтруктураОтбираемыхАналитик 	= Новый Структура;
	
	ОблДляВставки				= тМакет.Область(ИмяОбласти);

	СтруктураРасшифровки 		= АналитическийБланкУХСервер.ПолучитьСтруктуруРасшифровки(тМакет,тОбъект,тОбъектАБ,ИмяОбласти,ОблДляВставки.Расшифровка,СтруктураНезаполненныхАналитик,СтруктураОтбираемыхАналитик,ТзСвойстваПоказателей);	
	
	СтруктураОтвета = ПолучитьСтруктуруРасшифровкиБезКонтекста(СтруктураРасшифровки,АдресРасшифровки,тОбъект,тОбъектАБ.АдресРасшифровкиГруппОтборов,ОбластьИмя,ОбластьРасшифровка,тОбъектАБ.ТзСвойстваПоказателейАдрес);

	
	тОбъектСтруктура = Новый Структура;
	ЗаполнитьЗаблокированныеПериоды(тОбъектСтруктура,,тУправленияПериодом,тОрганизации);
	
	Для Каждого тПериод Из тОбъектСтруктура.ЗаблокированныеПериоды Цикл
		нтПериод 				=  тОбъектАБ.ЗаблокированныеПериоды.Добавить();
		нтПериод.ПериодОтчета   =  тПериод;
	КонецЦикла;	
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормыРаскрытия = АналитическийБланкУХВызовСервера.ПодготовитьПараметрыВызоваФормыРаскрытий(СтруктураРасшифровки,СтруктураОтвета,ПолучитьСвойстваТекущегоКонтекста());	
	
	ЗначениеКРаспределению 		= ЗначениеОбласти;
	ТаблицаДляРаспределения     = ПолучитьИзВременногоХранилища(ПараметрыФормыРаскрытия.АдресТзРаскрытия);
	
	Если ТаблицаДляРаспределения.Количество() = 0 Тогда
		
		СтрокаШаблона = Нстр("ru = 'Не найдены аналитики для распределения. Распределение значений для показателя  %1 отменено'");
		ТекстСообщенияРаспределитьНевозможно = СтрШаблон(СтрокаШаблона,Строка(СтруктураОтвета.СтруктураРасшифровки.ПоказательСсылка));
		
		ОбщегоНазначенияУх.СообщитьОбОшибке(ТекстСообщенияРаспределитьНевозможно);
		Возврат;
		
	КонецЕсли;	
	
	ИзменныеДанныеДляРаспределения = УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
    СуммаЗаблокированных = 0;
	
	Для Каждого СтрАналитика Из ТаблицаДляРаспределения Цикл
				
		АналитикиТекущегоПоказателя     = КэшАналитикПоказателей.Найти(СтрАналитика.ПоказательОтчета,"Показатель");
		
		СтруктураАналитикПоказателя     = Новый Структура;
		СтруктураАналитикПоказателя.Вставить("Показатель",СтрАналитика["ПоказательОтчета"]);
		
		Для  Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			Если  ЗначениеЗаполнено(АналитикиТекущегоПоказателя["ВидАналитики"+Инд])  Тогда				
				Если НЕ ТаблицаДляРаспределения.Колонки.Найти(АналитикиТекущегоПоказателя["ВидАналитики"+Инд+"Код"]) = Неопределено Тогда 
					СтруктураАналитикПоказателя.Вставить("Аналитика"+Инд,СтрАналитика[АналитикиТекущегоПоказателя["ВидАналитики"+Инд+"Код"]]);
				КонецЕсли;
			Иначе	
				Прервать;
			КонецЕсли;
			
		КонецЦикла;	
		
		Если НЕ ТаблицаДляРаспределения.Колонки.Найти("ПериодОтчета") = Неопределено Тогда		
			СтруктураАналитикПоказателя.Вставить("ПериодОтчета",СтрАналитика["ПериодОтчета"]);
		КонецЕсли;	
		Если НЕ ТаблицаДляРаспределения.Колонки.Найти("Сценарий") = Неопределено Тогда		
			СтруктураАналитикПоказателя.Вставить("Сценарий",СтрАналитика["Сценарий"]);
		КонецЕсли;
		Если НЕ ТаблицаДляРаспределения.Колонки.Найти("Организация") = Неопределено Тогда		
			СтруктураАналитикПоказателя.Вставить("Организация",СтрАналитика["Организация"]);
		КонецЕсли;
        Если НЕ ТаблицаДляРаспределения.Колонки.Найти("Проект") = Неопределено Тогда		
			СтруктураАналитикПоказателя.Вставить("Проект",СтрАналитика["Проект"]);
		КонецЕсли;
        	
		ЗаблокированнаяСтрока = ТаблицаЗаблокированныхПоказателейРаспределение.НайтиСтроки(СтруктураАналитикПоказателя);
		//Если область на замке  - она не должна меняться при распределении
		Если ЗаблокированнаяСтрока.Количество()>0 Тогда
			ОбластьЯчейки        = тМакет.Область(ЗаблокированнаяСтрока[0].ИмяОбласти);
			СуммаЗаблокированных = СуммаЗаблокированных+ОбластьЯчейки.Значение;
			Продолжить;
		КонецЕсли;	
		
		НстрокаИзменяемых = ИзменныеДанныеДляРаспределения.Добавить();
		ЗаполнитьЗначенияСвойств(НстрокаИзменяемых,СтруктураАналитикПоказателя);
		
		НстрокаИзменяемых.Значение = СтрАналитика.Значение;
		
	КонецЦикла;	
		
	Если РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеРавномерно Тогда
		МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.Равномерно;
	ИначеЕсли РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеПропорционально Тогда
		МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.ПоТекущемуЗначению;
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВалютаОтображения",ВалютаОтображения);
	СтруктураПараметров.Вставить("МетодРаспределения",МетодРаспределения);
	СтруктураПараметров.Вставить("ЗначениеДляРаспределения",ЗначениеОбласти-СуммаЗаблокированных);
	СтруктураПараметров.Вставить("ДанныеДляРаспределения",ИзменныеДанныеДляРаспределения);
	
	Обработки.АналитическийБланк.ВставитьЗначениеПоказателяОбратноеРаспределение(ЭтаФорма,СтруктураПараметров);
	
	ФлОшибки = Ложь;
	СтруктураПараметровЛог = Новый Структура;
	СтруктураПараметровЛог.Вставить("ЗначениеНовое",ЗначениеОбласти);
	СтруктураПараметровЛог.Вставить("ЗначениеСтарое",0);
	СтруктураПараметровЛог.Вставить("СтруктураРасшифровки",СтруктураРасшифровки);
	СтруктураПараметровЛог.Вставить("КэшАналитикПоказателей",КэшАналитикПоказателей);
	СтруктураПараметровЛог.Вставить("ТаблицаИзмененныхПоказателей",ТаблицаИзмененныхПоказателей);
	СтруктураПараметровЛог.Вставить("НомерТранзакции",0);
	СтруктураПараметровЛог.Вставить("ПредставлениеТранзакции","");
	СтруктураПараметровЛог.Вставить("ФлОшибки",ФлОшибки);
	
	ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметровЛог);
	
	ТаблицаИзмененныхПоказателей[ТаблицаИзмененныхПоказателей.Количество()-1].ИмяОбласти 		= ИмяОбласти;
	ТаблицаИзмененныхПоказателей[ТаблицаИзмененныхПоказателей.Количество()-1].УидГруппыОтборов 	= СтруктураРасшифровки.УидГруппыОтборов;
	
	АдресТаблицыИзмененныхПоказателейОбратноеРаспределение = ПоместитьВоВременноеХранилище(ТаблицаИзмененныхПоказателей,УникальныйИдентификатор);
	
		
КонецПроцедуры

