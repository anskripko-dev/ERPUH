	УправлениеВидимостьюПустыхКолонок(ПолеТабличногоДокументаМакет);
		
КонецПроцедуры

// Скрывает в макете строки, содержащие области со значеними,
// если такие области не содержат значений в пределах строки.
//
&НаКлиенте
Процедура УправлениеВидимостьюПустыхСтрок(Макет = Неопределено)
	
	Если Макет = Неопределено Тогда
		Макет = Элементы.ПолеТабличногоДокументаМакет;
	КонецЕсли;
		
	ИндексПервойСтроки = Макет.ВысотаТаблицы + 1;
	ИндексПервойКолонки = Макет.ШиринаТаблицы + 1;
	
	Для НомСтр = 1 по Макет.ВысотаТаблицы Цикл
		Для НомКол = 1 по Макет.ШиринаТаблицы Цикл
			
			ТекОбласть = Макет.Область(НомСтр, НомКол, НомСтр, НомКол);
			
			Если ТипЗнч(ТекОбласть.Расшифровка) = Тип("Структура") тогда
				Если ТекОбласть.Расшифровка.Свойство("Ссылка") тогда
					ИндексПервойСтроки = Мин(ИндексПервойСтроки, НомСтр);
					ИндексПервойКолонки = Мин(ИндексПервойКолонки, НомКол);
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	
	Если Элементы.ФормаНепустыеСтроки.Пометка Тогда
		
		СписокНеЗаполненных = Новый СписокЗначений;
		СписокЗаполненных = Новый СписокЗначений;
				
		Для НомСтр = ИндексПервойСтроки по Макет.ВысотаТаблицы Цикл
			Для НомКол = ИндексПервойКолонки по Макет.ШиринаТаблицы Цикл
				
				ТекОбласть = Макет.Область(НомСтр, НомКол, НомСтр, НомКол);
				
				Если ЗначениеЗаполнено(ТекОбласть.Текст) И ТекОбласть.Текст <> "0" Тогда
					Если СписокЗаполненных.НайтиПоЗначению(НомСтр) = Неопределено Тогда
						СписокЗаполненных.Добавить(НомСтр);
					КонецЕсли;
				Иначе
					Если СписокНеЗаполненных.НайтиПоЗначению(НомСтр) = Неопределено Тогда
						СписокНеЗаполненных.Добавить(НомСтр);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
				
		Для НомСтр = 1 По Макет.ВысотаТаблицы Цикл
			Если СписокНеЗаполненных.НайтиПоЗначению(НомСтр) <> Неопределено И СписокЗаполненных.НайтиПоЗначению(НомСтр) = Неопределено Тогда
				Макет.Область(НомСтр, 0, НомСтр, 0).Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для НомСтр = 1 По Макет.ВысотаТаблицы Цикл
			Макет.Область(НомСтр, 0, НомСтр, 0).Видимость = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Скрывает в макете колонки, содержащие области со значеними,
// если такие области не содержат значений в пределах колонки.
//
&НаКлиенте
Процедура УправлениеВидимостьюПустыхКолонок(Макет = Неопределено)
	
	Если Макет = Неопределено Тогда
		Макет = Элементы.ПолеТабличногоДокументаМакет;
	КонецЕсли;
		
	ИндексПервойСтроки = Макет.ВысотаТаблицы + 1;
	ИндексПервойКолонки = Макет.ШиринаТаблицы + 1;
	
	Для НомСтр = 1 по Макет.ВысотаТаблицы Цикл
		Для НомКол = 1 по Макет.ШиринаТаблицы Цикл
			
			ТекОбласть = Макет.Область(НомСтр, НомКол, НомСтр, НомКол);
			
			Если ТипЗнч(ТекОбласть.Расшифровка) = Тип("Структура") тогда
				Если ТекОбласть.Расшифровка.Свойство("Ссылка") тогда
					ИндексПервойСтроки = Мин(ИндексПервойСтроки, НомСтр);
					ИндексПервойКолонки = Мин(ИндексПервойКолонки, НомКол);
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
		
	Если Элементы.ФормаНепустыеКолонки.Пометка Тогда
		
		СписокНеЗаполненных = Новый СписокЗначений;
		СписокЗаполненных = Новый СписокЗначений;
				
		Для НомКол = ИндексПервойКолонки по Макет.ШиринаТаблицы Цикл
			Для НомСтр = ИндексПервойСтроки по Макет.ВысотаТаблицы Цикл
						
				ТекОбласть = Макет.Область(НомСтр, НомКол, НомСтр, НомКол);
				
				Если ЗначениеЗаполнено(ТекОбласть.Текст) И ТекОбласть.Текст <> "0" Тогда
					Если СписокЗаполненных.НайтиПоЗначению(НомКол) = Неопределено Тогда
						СписокЗаполненных.Добавить(НомКол);
					КонецЕсли;
				Иначе
					Если СписокНеЗаполненных.НайтиПоЗначению(НомКол) = Неопределено Тогда
						СписокНеЗаполненных.Добавить(НомКол);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
				
		Для НомКол = 1 По Макет.ШиринаТаблицы Цикл
			Если СписокНеЗаполненных.НайтиПоЗначению(НомКол) <> Неопределено И СписокЗаполненных.НайтиПоЗначению(НомКол) = Неопределено Тогда
				Макет.Область(0, НомКол, 0, НомКол).Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для НомКол = 1 По Макет.ШиринаТаблицы Цикл
			Макет.Область(0, НомКол, 0, НомКол).Видимость = Истина;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФакторныйАнализ(Команда)
	
	ВызватьОтчетСценарныйАнализ();
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОтчетСценарныйАнализ() Экспорт
		
	тМакет 							= ЭтаФорма["ПолеТабличногоДокументаМакет"];
	ТекущаяОбластьРасшифровка  		= тМакет.ВыделенныеОбласти[0];
	СтруктураНезаполненныхАналитик 	= Новый Структура;
	СтруктураОтбираемыхАналитик 	= Новый Структура;

	тМакет = ЭтаФорма[ТекущийМакет];
	ТекущаяОбластьРасшифровка  = тМакет.ВыделенныеОбласти[0];
	СтруктураНезаполненныхАналитик 	= Новый Структура;
	СтруктураОтбираемыхАналитик 	= Новый Структура;
		
	СписокПоказателей 	 = Новый СписокЗначений;
	МассивПериодов    	 = Новый Массив;
		
	Для ИндСтроки = ТекущаяОбластьРасшифровка.Верх По ТекущаяОбластьРасшифровка.Низ Цикл
		Для ИндКолонки  =  ТекущаяОбластьРасшифровка.Лево По ТекущаяОбластьРасшифровка.Право Цикл
			
			СтруктураНезаполненныхАналитик 	= Новый Структура;
			СтруктураОтбираемыхАналитик 	= Новый Структура;
			ТекущаяОбластьРасшифровка 		= тМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки);
			
			Если НЕ ТекущаяОбластьРасшифровка.Расшифровка  = Неопределено Тогда		
				СтруктураРасшифровки = 	ПолучитьСтруктуруРасшифровки(ТекущаяОбластьРасшифровка.Имя,ТекущаяОбластьРасшифровка.Расшифровка,СтруктураНезаполненныхАналитик,СтруктураОтбираемыхАналитик);	
				Если СтруктураРасшифровки.Свойство("ПоказательКод")  Тогда		
					СписокПоказателей.Добавить(СтруктураРасшифровки.ПоказательСсылка);
				КонецЕсли;	
				
				Если СтруктураРасшифровки.Свойство("ПериодОтчета") Тогда		
					МассивПериодов.Добавить(СтруктураРасшифровки.ПериодОтчета);
				КонецЕсли;		
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	Если СписокПоказателей.Количество() = 0 Тогда
		 ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Выделенная область не содержит показателей.'"));
		 Возврат;
	КонецЕсли;	
	
	//Упорядочим список периодов по возрастанию			
	СписокПериодовПоВозрастанию = ВернутьСписокПериодовПоПорядку(МассивПериодов);
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("РежимыДоступаКФункциямСводнойТаблицы",ПредопределенноеЗначение("Перечисление.РежимыДоступаКФункциямСводнойТаблицы.Моделирование"));
	СтруктураПараметров.Вставить("ВалютаОтображения",ВалютаОтображения);
	СтруктураПараметров.Вставить("СписокПоказателей",СписокПоказателей);
	СтруктураПараметров.Вставить("Сценарий",ЭтаФорма.Сценарий);
	СтруктураПараметров.Вставить("Организация",СтруктураРасшифровки.Организация);
	//СтруктураПараметров.Вставить("Проект",СтруктураРасшифровки.Проект);
	СтруктураПараметров.Вставить("ПериодС",СписокПериодовПоВозрастанию[0].Значение);
	СтруктураПараметров.Вставить("ПериодПо",СписокПериодовПоВозрастанию[СписокПериодовПоВозрастанию.Количество()-1].Значение);
	
	ИмяФормыАнализа		= "Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаМакетаСводнаяТаблица";
	ОткрытьФорму(ИмяФормыАнализа, СтруктураПараметров, ЭтаФорма, Новый УникальныйИдентификатор); 

	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьСписокПериодовПоПорядку(МассивПериодов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Периоды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Ссылка В(&Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Периоды.ДатаНачала";
	
	Запрос.УстановитьПараметр("Ссылка",МассивПериодов);
	
	РезультатПериоды = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

    СписокПериодовПоВозрастанию = Новый СписокЗначений;
	СписокПериодовПоВозрастанию.ЗагрузитьЗначения(РезультатПериоды); 
	Возврат СписокПериодовПоВозрастанию;
	
КонецФункции	

&НаКлиенте
Процедура СохранитьВЕксель(Команда)
	
	ПараметрыОткрытия = Новый Структура("ИмяФайла", ВариантСводнойТаблицы);
	Оповещение = Новый ОписаниеОповещения("СохранитьВЕксельЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ДиалогСохраненияВExcel",
		ПараметрыОткрытия,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВЕксельЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;

	Попытка
	#Если НЕ ВебКлиент Тогда
		
		ФайлXLSX = ТипФайлаТабличногоДокумента.XLSX;
		РазделительКаталогов = ПолучитьРазделительПути();
		ПолеТабличногоДокументаКопия = ПолеТабличногоДокументаМакет;
		
		Если Результат.ВариантСохранения = "НовыйФайл" Тогда
			
			ПолныйПутьКФайлу = Результат.Каталог + РазделительКаталогов + Результат.СуществующийФайл + ".xlsx";
			
		ИначеЕсли Результат.ВариантСохранения = "СуществующийФайл" Тогда
			
			ПолныйПутьКФайлу = Результат.СуществующийФайл;
			
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ЗаписьВЕксельЗавершение", ЭтотОбъект, ПолныйПутьКФайлу);
		ПолеТабличногоДокументаКопия.НачатьЗапись(Оповещение, ПолныйПутьКФайлу, ФайлXLSX);
		
	#Иначе
		//В режиме ВебКлиент файл на клиенте не сохраняем.
	#КонецЕсли
	Исключение
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписьВЕксельЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина И ДополнительныеПараметры <> Неопределено Тогда
		СтрокаШаблона = Нстр("ru = 'Файл ""%1"" успешно записан.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(СтрокаШаблона, ДополнительныеПараметры));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзЕкселя(Команда)
	
	Параметры_ = Новый Структура("ИмяФайла",ВариантСводнойТаблицы);
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзЕкселяЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ДиалогИмпортаИзExcel", 
	Параметры_,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзЕкселяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗагрузитьДанныеИзЕкселяСервер(Результат.ИмяКниги);
		УстановитьРежимРедактированияДанныхКлиент(Истина);
	Исключение
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеИзЕкселяСервер(ИмяКниги)
	
	ТДИзФайла = Новый ТабличныйДокумент;
	Попытка
		ТДИзФайла.Прочитать(ИмяКниги, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Добавляем заголовочную строку "Номер_1", "Номер_2", ... перед данными
	ТДСЗаголовком = Новый ТабличныйДокумент;
	Для НомерСтолбца = 1 По ТДИзФайла.ШиринаТаблицы Цикл
		ТДСЗаголовком.Область(1, НомерСтолбца, 1, НомерСтолбца).Текст =
			"Номер_" + Формат(НомерСтолбца, "ЧГ=0");
	КонецЦикла;
	ТДСЗаголовком.Вывести(ТДИзФайла);
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТДСЗаголовком.Область());
	Построитель.Выполнить();
	ТаблицаДанных = Построитель.Результат.Выгрузить();
	
	МассивСтрок = Новый Массив;
	
	#Если ВебКлиент Тогда
		ЦветКнопки = WebЦвета.Бежевый;
	#Иначе	
		ЦветКнопки = WindowsЦвета.Кнопка; 
	#КонецЕсли	
	
	ПерваяСтрока  = 0;
	ПерваяКолонка = 0;
	
	Для мСтрока = 1 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
		Для мКолонка = 1 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			ТекОбластьСТ = ПолеТабличногоДокументаМакет.Область(мСтрока, мКолонка, мСтрока, мКолонка);
			Если НЕ ТекОбластьСТ.Расшифровка = Неопределено И ТекОбластьСТ.Расшифровка.Свойство("Ссылка") Тогда
				ПерваяСтрока  = мСтрока;
				ПерваяКолонка = мКолонка;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если ПерваяСтрока > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для мСтрока = ПерваяСтрока По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
		МассивЗначений = Новый Массив;
		Для мКолонка = ПерваяКолонка По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			
			ТекОбластьСТ = ПолеТабличногоДокументаМакет.Область(мСтрока, мКолонка, мСтрока, мКолонка);
			
			ЯчейкаЯвляетсяПоказателем = НЕ ТекОбластьСТ.Расшифровка = Неопределено
				И ТекОбластьСТ.Расшифровка.Свойство("Ссылка");
			
			Если ЯчейкаЯвляетсяПоказателем Тогда
				
				ИмяКолонки        = "Номер_" + Формат(мКолонка, "ЧГ=0");
				СтрокаСуществует  = мСтрока - 1 < ТаблицаДанных.Количество();
				КолонкаСуществует = ТаблицаДанных.Колонки.Найти(ИмяКолонки) <> Неопределено;
				
				Если СтрокаСуществует И КолонкаСуществует Тогда
					ТекЗначениеЕксель = СокрЛП(Строка(ТаблицаДанных[мСтрока - 1][ИмяКолонки]));
				Иначе
					ТекЗначениеЕксель = "";
				КонецЕсли;
				
				Если ТекЗначениеЕксель <> ТекОбластьСТ.Текст Тогда
					МассивЗначений.Добавить(ТекЗначениеЕксель);
				Иначе
					МассивЗначений.Добавить(ТекОбластьСТ.Text);
				КонецЕсли;
				
			Иначе	
				МассивЗначений.Добавить(ТекОбластьСТ.Text);
			КонецЕсли;
		КонецЦикла;
		МассивСтрок.Добавить(МассивЗначений);
	КонецЦикла;
	
	РабочаяОбласть = ПолеТабличногоДокументаМакет.Область(ПерваяСтрока, ПерваяКолонка,
		ПолеТабличногоДокументаМакет.ВысотаТаблицы, ПолеТабличногоДокументаМакет.ШиринаТаблицы);
	
	ВставитьЗначенияСервер(РабочаяОбласть.Имя,МассивСтрок,МассивСтрок);
	
КонецПроцедуры

&НаСервере
Процедура ВставитьЗначенияСервер(ИмяОбласти,МассивСтрок,МассивЗначений)
	
	ПредставлениеТранзакции = Перечисления.ТранзакцииИзмененияПоказателей.ЗагрузкаИзMSExcel;	
	Обработки.АналитическийБланк.СкопироватьЗначения(ЭтаФорма,ВалютаОтображения,ИмяОбласти,МассивЗначений,,,ПредставлениеТранзакции)
		
КонецПроцедуры

&НаКлиенте
Процедура УправлениеСогласованием(Команда)
	
	Если Не ПроверитьСогласованиеПоРакурсам() Тогда
		ТекстСообщения = Нстр("ru = 'В таблице отсутствуют показатели, согласуемые через ракурсы'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
		
	Оповещение = Новый ОписаниеОповещения("УправлениеСогласованиемЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаУправленияСогласованием", 
	ПодготовитьПараметрыДляВызоваСогласования(),,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСогласованиеПоРакурсам()
	
	Для Каждого СтрВО Из тВидыОтчетов Цикл
		
		Если СтрВО.Значение.ОбъектДляСогласованияЗначений = Перечисления.ОбъектыСогласованияЗначенийПоказателейОтчетов.Ракурс Тогда
			 Возврат Истина;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции	

&НаСервере
Функция ПодготовитьПараметрыДляВызоваСогласования()
	
	СтруктураПараметров = Новый Структура;
	
	тСогласуемыеВидыОтчетов = Новый СписокЗначений;
	
	Для Каждого СтрВО Из тВидыОтчетов Цикл
		
		Если СтрВО.Значение.ОбъектДляСогласованияЗначений = Перечисления.ОбъектыСогласованияЗначенийПоказателейОтчетов.Ракурс Тогда
			 тСогласуемыеВидыОтчетов.Добавить(СтрВО.Значение);
		КонецЕсли;	
		
	КонецЦикла;	

	СтруктураПараметров.Вставить("ВидыОтчетов",тСогласуемыеВидыОтчетов);
	СтруктураПараметров.Вставить("ПериодПланированияОтборНачало",ПериодС);
	СтруктураПараметров.Вставить("ПериодПланированияОтборОкончание",ПериодПо);
	
	МассивСценариев = Новый Массив;
	МассивСценариев.Добавить(ЭтаФорма["Сценарий"]);
	
	СтруктураПараметров.Вставить("Организации",тОрганизации.ВыгрузитьЗначения()); 
	СтруктураПараметров.Вставить("Сценарии",МассивСценариев);
	СтруктураПараметров.Вставить("Проекты",тПроекты.ВыгрузитьЗначения());
	СтруктураПараметров.Вставить("ВариантСводнойТаблицы",ВариантСводнойТаблицы);
	
	Возврат СтруктураПараметров;
	
КонецФункции	

&НаКлиенте
Процедура УправлениеСогласованиемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ВывестиСводнуюТаблицу();
		
КонецПроцедуры

&НаКлиенте
Процедура КопированиеДанных(Команда)
	
	Параметры_ = Новый Структура;	
	Параметры_.Вставить("тПоказатели",ПолучитьТекущиеПоказатели());
	Параметры_.Вставить("ПериодПланированияОтборНачало",ПериодС);
	Параметры_.Вставить("ПериодПланированияОтборОкончание",ПериодПо);
	Параметры_.Вставить("Сценарий",ЭтаФорма["Сценарий"]);
	Параметры_.Вставить("РежимРаботыОбработки",ПредопределенноеЗначение("Перечисление.РежимыКопированияДанныхПоказателей.ПроизвольныеОтборы"));
	
	Оповещение = Новый ОписаниеОповещения("КопированиеИПереносЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.КопированиеПоСрезам.Форма.Форма", 
	Параметры_,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаКлиенте
Процедура КопированиеИПереносЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ВывестиСводнуюТаблицу();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекущиеПоказатели()
	
	СтрокиОтчетаМассив 	= ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Выгрузить().ВыгрузитьКолонку("СтрокаОтчета");
	КолонкиОтчетаМассив = ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Выгрузить().ВыгрузитьКолонку("КолонкаОтчета");
	текПоказатели 		= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТаблицуПоказателейВидаОтчета(СтрокиОтчетаМассив,КолонкиОтчетаМассив);
	
	Возврат текПоказатели.ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

&НаСервере
Процедура ОбновитьПометкуКомандЗависимогоОбновленияЯчеек()
	
	Элементы.ВычислятьАвтоматически.Пометка = Ложь;
	Элементы.РучнойПересчет.Пометка 		= Ложь;
	
	Если ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = Перечисления.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.АвтоматическиВсе Тогда
		Элементы.ВычислятьАвтоматически.Пометка = Истина;
	ИначеЕсли ПараметрыКонтекстногоОбновленияЗависимыхЯчеек = Перечисления.ПараметрыКонтекстногоОбновленияЗависимыхЯчеек.Вручную Тогда
		Элементы.РучнойПересчет.Пометка = Истина;
	КонецЕсли;	
		
КонецПроцедуры

#Область РасчетЗначенийПоказателей

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	
	ЗаполнитьЗавершение(Новый Структура("СпособФормированияОтчета", Неопределено));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПрочимСпособом(Команда)
	
	Если КэшПараметрыОткрытия = Неопределено Тогда
		
		КэшПараметрыОткрытия = Новый Структура;
		КэшПараметрыОткрытия.Вставить("ВидОтчета", ВидОтчета);
		КэшПараметрыОткрытия.Вставить("Сценарий", ЭтаФорма.Сценарий);
		КэшПараметрыОткрытия.Вставить("ПериодОтчета", ПериодС);
		Если тОрганизации.Количество() = 1 Тогда
			КэшПараметрыОткрытия.Вставить("Организация", тОрганизации.Получить(0).Значение);
		ИначеЕсли тОрганизации.Количество() > 1 Тогда
			КэшПараметрыОткрытия.Вставить("Организация", тОрганизации);
		КонецЕсли;
		Если тУправленияПериодом.Количество() > 0 Тогда
			КэшПараметрыОткрытия.Вставить("УправлениеПериодом", тУправленияПериодом.Получить(0).Значение);
		КонецЕсли;
	
		КэшПараметрыОткрытия.Вставить("СпособФормированияОтчета", Неопределено);
		КэшПараметрыОткрытия.Вставить("ПравилоОбработки", Неопределено);
		КэшПараметрыОткрытия.Вставить("ПравилоПроверки", Неопределено);
		КэшПараметрыОткрытия.Вставить("ВнешняяИнформационнаяБаза", Неопределено);
		КэшПараметрыОткрытия.Вставить("БланкИмпорта", Неопределено);
		КэшПараметрыОткрытия.Вставить("ПериодичностьСвертки", Неопределено);
		
		КэшПараметрыОткрытия.Вставить("ФайлИмпорта", Неопределено);
		КэшПараметрыОткрытия.Вставить("СпособИмпортирования", 0);
		КэшПараметрыОткрытия.Вставить("ПутьКФайлу", "");
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПослеВыбораСпособаРасчетаПоказателей", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ВыборСпособаРасчетаПоказателей",
		КэшПараметрыОткрытия, , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция СтруктураОтбораФайловИмпорта()
	
	СтруктураОтбора = Новый Структура;
	
	Если тОрганизации.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не указана организация импорта.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Неопределено;
	ИначеЕсли тОрганизации.Количество() <> 1 Тогда
		ТекстСообщения = НСтр("ru = 'Импорт возможен только по одной организации.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	СтруктураОтбора.Вставить("Организация", тОрганизации.Получить(0).Значение);
	
	Если тУправленияПериодом.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Ну указан документ управления периодом сценария.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Неопределено;
	ИначеЕсли тУправленияПериодом.Количество() <> 1 Тогда
		ТекстСообщения = НСтр("ru = 'Импорт возможен только по одному периоду сценария.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ДанныеПериодаСценаря = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(тУправленияПериодом.Получить(0).Значение, "ПериодСценария, Сценарий");
	СтруктураОтбора.Вставить("Сценарий", ДанныеПериодаСценаря.Сценарий);
	СтруктураОтбора.Вставить("ПериодСценария", ДанныеПериодаСценаря.ПериодСценария);
	
	Возврат СтруктураОтбора;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПослеВыбораСпособаРасчетаПоказателей(ПараметрыРасчета, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если ПараметрыРасчета = Неопределено ИЛИ ПараметрыРасчета = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	// Закэшируем выбранные значения
	Если КэшПараметрыОткрытия <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(КэшПараметрыОткрытия, ПараметрыРасчета);
	КонецЕсли;
	
	Если ПараметрыРасчета.НужнаОбработкаФайла Тогда
		
		// Использование внешнего файла
		ПараметрыРасчета.Вставить("Форма", ЭтаФорма);
		
		СтруктураОтбора = СтруктураОтбораФайловИмпорта();
		ПараметрыРасчета.Вставить("СтруктураОтбора", СтруктураОтбора);
		
		БюджетированиеИОтчетностьКлиент.ОбработатьИмпортФайла(ПараметрыРасчета);
		
	Иначе
		// Расчет значений показателей
		ЗаполнитьЗавершение(ПараметрыРасчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(ПараметрыРасчета) Экспорт
	
	// Запуск фонового задания на сервере.
	ДлительнаяОперация = НачатьРасчет(ПараметрыРасчета);
	
	// При ошибках проверки заполнения параметров не запускаем длительную операцию.
	Если ТипЗнч(ДлительнаяОперация) = Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	
	// Подключение обработчика завершения фонового задания
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется расчет значений показателей...'");
	
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииРасчета", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьРасчет(ПараметрыРасчета)
	
	Если Не ВозможностьОбновитьСводнуюТаблицу() ИЛИ Не ВозможностьСгенерироватьМакетШаблона() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор),
		"Обработки.АналитическийБланкСводнаяТаблица.РассчитатьПоПравилу",
		ПараметрыРасчета,
		ПараметрыЗадания(),
		ПараметрыВыводаСводнойТаблицы());
		
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииРасчета(Результат, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		УстановитьСостояниеНеИспользовать(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	ОбработатьРезультатРасчета(Результат);
	ПоказатьПротокол();
	Элементы.НадписьОбновитеТаблицу.Видимость = Ложь;
	НуженПересчет = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатРасчета(Результат)
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	ДанныеОбработки = РезультатВыполнения.РезультатПересчета;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект, ДанныеОбработки, , "УникальныйИдентификаторСеанса, АдресКэшаДанных");
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "РасчетИЗаписьПоказателей");
	
	Если ДанныеОбработки.БылиОшибки Тогда
		// Были ошибки при расчете показателей
		Возврат;
	КонецЕсли;
	
	СтруктураРезультата = РезультатВыполнения.РезультатВыводаСводнойТаблицы;
	ОбработкаОбъектАналитическийБланк = РеквизитФормыВЗначение("ОбъектАналитическогоБланка");
	
	ПолеТабличногоДокументаМакет  = СтруктураРезультата.ПолеТабличногоДокументаМакет;
	ЗаполнитьЗначенияСвойств(ОбработкаОбъектАналитическийБланк, СтруктураРезультата.РеквизитыОбработки);
	
	Для Каждого ТЧ Из СтруктураРезультата.ТабличныеЧастиОбработки Цикл
		ОбработкаОбъектАналитическийБланк[ТЧ.Ключ].Загрузить(ТЧ.Значение);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъектАналитическийБланк,"ОбъектАналитическогоБланка");
	
	Если РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеРавномерно ИЛИ
		РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеПропорционально Тогда
		УстановитьОформлениеЯчеекОбратноеРаспределение();
		ВосстановитьЗаблокированныеОбластиРаспределение();
	КонецЕсли;
	
	ОбновитьСписокТекущихОрганизаций();
	ОбновитьСписокТекущихПроектов();
	СброситьСостояниеНеИспользовать();
	УстановитьВыбранныйРежимРаботы();
	
	Если РежимМоделирования Тогда
		ОбновитьПанельЦелевыхПоказателей();
		Элементы.ГруппаДанныеМодели.Доступность =
			НЕ Обработки.АналитическийБланк.ПолучитьПоследнийНомерТранзакции(ИдентификаторДанныхМоделирование) = Неопределено;
	Иначе
		Обработки.АналитическийБланк.ДобавитьЗаписьвЖурналДействийПослеРасчета(ЭтаФорма, РезультатВыполнения.ПараметрыРасчета);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область РаботаСВариантамиТаблицы

&НаКлиенте
Процедура СохранитьВариантТаблицы(Команда)
	
	Если Не ЗначениеЗаполнено(ВариантСводнойТаблицы) Тогда
		СохранитьВариантТаблицыКак(Неопределено);
	ИначеЕсли  ЗначениеЗаполнено(Бланк) 
			 И  ЗначениеЗаполнено(ВариантСводнойТаблицы)
			 И ЭтоОсновнойВариант(ВариантСводнойТаблицы) Тогда
	    СохранитьВариантТаблицыКак(Неопределено);
	Иначе		
		СохранитьНастройкиТекущегоВарианта();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантТаблицыКак(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавлениеВариантаНастройкиЗавершение", ЭтаФорма);
	Параметры_ = Новый Структура("ИмяТекущегоВарианта,Бланк,РежимМоделирования,ИдентификаторДанныхМоделирование",
	ВариантСводнойТаблицы
	,Бланк
	,РежимМоделирования
	,ИдентификаторДанныхМоделирование);
	
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаДиалогаСохраненияНастройки",Параметры_,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеВариантаНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	СохранитьНастройкиТекущегоВарианта(Результат.НовыйВариант);
				
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВариантТаблицы(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе,ТекущаяСтрока,РежимВыбора", Истина,ВариантСводнойТаблицы,Истина);
	Оповещение = Новый ОписаниеОповещения("ВыборВариантаЗавершение", ЭтаФорма);

	ОткрытьФорму("Справочник.ВариантыСводныхТаблиц.ФормаВыбора", ПараметрыФормы,,,,,Оповещение);
									
КонецПроцедуры

&НаКлиенте
Процедура ВыборВариантаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если  Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ВариантСводнойТаблицы = Результат;
	
	ВариантСводнойТаблицыПриИзмененииСервер();
	НарисоватьТаблицуСервер();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиТекущегоВарианта(НовыйВариант = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
		
	Если Не НовыйВариант = Неопределено Тогда
		ВариантСводнойТаблицы = НовыйВариант;	
		СформироватьЗаголовокФормы();
	КонецЕсли;	
	
	Если РежимДоступаКФункциямСводнойТаблицы = Перечисления.РежимыДоступаКФункциямСводнойТаблицы.РаботаСДанными Тогда
		Если ВариантСводнойТаблицы.ОсновнойВариант Тогда
			ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = ' Запись отменена. Текущий вариант является основным. Выберите другой вариант для сохранения настроек. '"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Настройки состава строк
	регНастройкиСоставаСтрокСводнойТаблицы = РегистрыСведений.НастройкиСоставаСтрокСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиСоставаСтрокСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиСоставаСтрокСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Выгрузить());
	регНастройкиСоставаСтрокСводнойТаблицы.Записать(Истина);
	
	//Настройки состава колонок
	регНастройкиСоставаКолонокСводнойТаблицы = РегистрыСведений.НастройкиСоставаКолонокСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиСоставаКолонокСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиСоставаКолонокСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Выгрузить());
	регНастройкиСоставаКолонокСводнойТаблицы.Записать(Истина);
	
	//Настройки расположения измерений
	регНастройкиРасположенияПолейСводнойТаблицы = РегистрыСведений.НастройкиРасположенияПолейСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиРасположенияПолейСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиРасположенияПолейСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
	регНастройкиРасположенияПолейСводнойТаблицы.Записать(Истина);
	
	//Настройки шкалы периодов 
	регНастройкиПериодовСводнойТаблицы = РегистрыСведений.НастройкиПериодовСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиПериодовСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиПериодовСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиПериодовСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Выгрузить());
	регНастройкиПериодовСводнойТаблицы.Записать(Истина);
	
	//Настройки свойств вывода измерений 
	регНастройкиПолейСводнойТаблицы = РегистрыСведений.НастройкиПолейСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиПолейСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиПолейСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиПолейСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиПолейСводнойТаблицы"].Выгрузить());
	регНастройкиПолейСводнойТаблицы.Записать(Истина);

	//Настройки прочих свойств текущего варианта  
	регНастройкиВариантаСводнойТаблицы = РегистрыСведений.НастройкиВариантаСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиВариантаСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиВариантаСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиВариантаСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Выгрузить());
	регНастройкиВариантаСводнойТаблицы.Записать(Истина);
	
	//Настройки состава аналитики строк текущего макета   
	регНастройкиСоставаАналитикиСтрокСводнойТаблицы = РегистрыСведений.НастройкиСоставаАналитикиСтрокСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиСоставаАналитикиСтрокСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;	   
	
	регНастройкиСоставаАналитикиСтрокСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Выгрузить());
	регНастройкиСоставаАналитикиСтрокСводнойТаблицы.Записать(Истина);

	//Настройки производных полей группировок сводной таблицы   
	регНастройкиПроизводныхПолейСводнойТаблицы = РегистрыСведений.НастройкиПроизводныхПолейСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиПроизводныхПолейСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиПроизводныхПолейСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
		СтрЗапись.ТипЗначенияПоляСтрока = ЗначениеВСтрокуВнутр(СтрЗапись.ТипЗначенияПоля);
	КонецЦикла;	
	
	регНастройкиПроизводныхПолейСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиПроизводныхПолейСводнойТаблицы"].Выгрузить());
	регНастройкиПроизводныхПолейСводнойТаблицы.Записать(Истина);
	
	
	//Настройки формул  сводной таблицы   
	регНастройкиВычисляемыхВыраженийСводнойТаблицы = РегистрыСведений.НастройкиВычисляемыхВыраженийСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиВычисляемыхВыраженийСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	
	Для Каждого СтрЗапись Из ЭтаФорма["НастройкиВычисляемыхВыраженийСводнойТаблицы"] Цикл   
		СтрЗапись.ВариантСводнойТаблицы = ВариантСводнойТаблицы;   
	КонецЦикла;
	
	регНастройкиВычисляемыхВыраженийСводнойТаблицы.Загрузить(ЭтаФорма["НастройкиВычисляемыхВыраженийСводнойТаблицы"].Выгрузить());
	регНастройкиВычисляемыхВыраженийСводнойТаблицы.Записать(Истина);
	
	//Настройки условного оформления   
	регНастройкиУсловногоОформленияСводнойТаблицы = РегистрыСведений.НастройкиУсловногоОформленияСводнойТаблицы.СоздатьНаборЗаписей();
	регНастройкиУсловногоОформленияСводнойТаблицы.Отбор.ВариантСводнойТаблицы.Установить(ВариантСводнойТаблицы);
	регНастройкиУсловногоОформленияСводнойТаблицы.Прочитать();
	регНастройкиУсловногоОформленияСводнойТаблицы.Очистить();
	НоваяЗаписьУсловногоОформления = регНастройкиУсловногоОформленияСводнойТаблицы.Добавить();	
	
	НоваяЗаписьУсловногоОформления.ВариантСводнойТаблицы 	= ВариантСводнойТаблицы;
	НоваяЗаписьУсловногоОформления.УсловноеОформление 		= ЗначениеВСтрокуВнутр(ЭтаФорма["НастройкиУсловногоОформленияСводнойТаблицы"].Выгрузить());
	регНастройкиУсловногоОформленияСводнойТаблицы.Записать(Истина);
		
	
	//Сохранияем настройки макета, если есть
	Если ЗначениеЗАполнено(СтруктураНастроекАналитическогоБланкаАдрес)  Тогда
		
		СтруктураНастроек = ПолучитьИзВременногоХранилища(СтруктураНастроекАналитическогоБланкаАдрес);
		//Обработки.АналитическийБланк.ЗаписатьНастройкиАналитическогоБланка(ПолеТабличногоДокументаМакет,МакетДляВыводаПоказателей,Приемник,ОбъектАБ,Отказ);
		
		текНаборЗаписей = РегистрыСведений.КэшГруппОтборовПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.КэшГруппОтборовПоказателей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
		
		текНаборЗаписей = РегистрыСведений.РасшифровкаГруппОтборов.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.РасшифровкаГруппОтборов);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);

		текНаборЗаписей = РегистрыСведений.КэшРаскрываемыхОбластей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.КэшРаскрываемыхОбластей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);

		текНаборЗаписей = РегистрыСведений.НастройкиРаскрываемыхОбластей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		
		текНаборЗаписей.Загрузить(СтруктураНастроек.НастройкиРаскрываемыхОбластей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);

		текНаборЗаписей = РегистрыСведений.НастройкиТаблицРаскрываемыхОбластей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.НастройкиТаблицРаскрываемыхОбластей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
			
		текНаборЗаписей = РегистрыСведений.РасшифровкаФормулОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		тТаблица  = СтруктураНастроек.РасшифровкаФормулОбластейПоказателей;
		тТаблица.Свернуть("УидФормулы,УидГруппыОтборов,Показатель,ИндексПоказателя,ВидОтчета,ВидОтчетаКод,ПоказательКод,ИмяВФормуле");
		текНаборЗаписей.Загрузить(тТаблица);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
		
		текНаборЗаписей = РегистрыСведений.КэшИменОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.КэшИменОбластейПоказателей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
	
		текНаборЗаписей = РегистрыСведений.КэшИменФормул.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.КэшИменФормул);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);

		текНаборЗаписей = РегистрыСведений.КэшФормулОбластейПоказателей.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(СтруктураНастроек.КэшФормулОбластейПоказателей);
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.Бланк = ВариантСводнойТаблицы;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
			
		текНаборЗаписей = РегистрыСведений.НастройкиАналитическихБланков.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.Бланк.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Очистить();
		нЗапись  									= текНаборЗаписей.Добавить();
		нЗапись.Бланк								= ВариантСводнойТаблицы;
		нЗапись.ХранилищеДополнительныхНастроек 	= Новый ХранилищеЗначения(СтруктураНастроек.НастройкиАналитическихБланков);
		текНаборЗаписей.Записать(Истина);
		
			
	КонецЕсли;	
	
	//Сохраняем настройки режима моделирования
	Если РежимМоделирования Тогда
		
		текНаборЗаписей = РегистрыСведений.НастройкиЦелевыхПоказателейМоделирование.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.ВариантАнализа.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(ТаблицаВыделенныхПоказателейМоделирование.Выгрузить());
		УникальныйНомерСтроки = 0;
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.ВариантАнализа = ВариантСводнойТаблицы; 
			Стр.УникальныйНомерСтроки = УникальныйНомерСтроки;
			УникальныйНомерСтроки = УникальныйНомерСтроки+1;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
	
		текНаборЗаписей = РегистрыСведений.НастройкиАнализируемыхПоказателейМоделирование.СоздатьНаборЗаписей();
		текНаборЗаписей.Отбор.ВариантАнализа.Установить(ВариантСводнойТаблицы);
		текНаборЗаписей.Загрузить(ТаблицаЧувствительностиФакторов.Выгрузить());
		УникальныйНомерСтроки = 0;
		Для Каждого Стр Из текНаборЗаписей Цикл
			Стр.ВариантАнализа = ВариантСводнойТаблицы; 
			Стр.УникальныйНомерСтроки = УникальныйНомерСтроки;
			УникальныйНомерСтроки = УникальныйНомерСтроки+1;
		КонецЦикла;	
		текНаборЗаписей.Записать(Истина);
	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим (Ложь);
	
КонецПроцедуры	

