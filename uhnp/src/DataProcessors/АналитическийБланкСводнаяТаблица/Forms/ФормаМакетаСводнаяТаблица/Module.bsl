#Область РаботаСБлокировкамиДетальныхПоказателей


&НаКлиенте
Процедура ЗаблокироватьЯчейкуДляРаспределения(Команда)
	
	тМакет 										= ЭтаФорма[ТекущийМакет];
	ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];
    КартинкаЗаблокирован                        = БиблиотекаКартинок.ЗанятьФайл;

	Для ИндексСтроки = ТекущаяОбластьРасшифровка.Верх По ТекущаяОбластьРасшифровка.Низ Цикл
		Для ИндексКолонки = ТекущаяОбластьРасшифровка.Лево По ТекущаяОбластьРасшифровка.Право Цикл
			тОбласть = тМакет.Область(ИндексСтроки,ИндексКолонки,ИндексСтроки,ИндексКолонки);
			
			Если НЕ ЗначениеЗаполнено(ТекущаяОбластьРасшифровка.Расшифровка) ИЛИ НЕ ТекущаяОбластьРасшифровка.Расшифровка.Свойство("Ссылка")  Тогда	
				ПоказатьОповещениеПользователя(Нстр("ru = 'Необходимо выделить область показателя'"),, Нстр("ru = 'Необходимо выделить область показателя'"), БиблиотекаКартинок.Внимание16);
				Продолжить;
			КонецЕсли;
			
			Если НЕ тОбласть.ЦветФона = Новый Цвет(230,255,230) Тогда
				 ПоказатьОповещениеПользователя(Нстр("ru = 'Область не должна быть итогом'"),, Нстр("ru = 'Область не должна быть итогом'"), БиблиотекаКартинок.Внимание16);
				 Продолжить;
			КонецЕсли;	
			
			Если  НЕ тОбласть.Картинка = Неопределено Тогда   //Уже заблокировали
				 Продолжить;
			КонецЕсли;	
			
			УстановитьЗаблокированныйПоказательВТаблице(тОбласть.Имя);			
			
		КонецЦикла;	
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьБлокировкуЯчейкиДляРаспределения(Команда)
	
	тМакет 										= ЭтаФорма[ТекущийМакет];
	ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];
	КартинкаЗаблокирован                        = БиблиотекаКартинок.ЗанятьФайл;
	
	Для ИндексСтроки = ТекущаяОбластьРасшифровка.Верх По ТекущаяОбластьРасшифровка.Низ Цикл
		Для ИндексКолонки = ТекущаяОбластьРасшифровка.Лево По ТекущаяОбластьРасшифровка.Право Цикл
			тОбласть = тМакет.Область(ИндексСтроки,ИндексКолонки,ИндексСтроки,ИндексКолонки);
			
			Если НЕ ЗначениеЗаполнено(ТекущаяОбластьРасшифровка.Расшифровка) ИЛИ НЕ ТекущаяОбластьРасшифровка.Расшифровка.Свойство("Ссылка")  Тогда	
				Продолжить;
			КонецЕсли;
			
			Если   тОбласть.Картинка = Неопределено Тогда
				 Продолжить;
			КонецЕсли;	
			
			СнятьЗаблокированныйПоказательВТаблице(тОбласть.Имя);			
			
		КонецЦикла;	
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура УстановитьЗаблокированныйПоказательВТаблице(ИмяОбласти)
		
	тМакет 										= ЭтаФорма[ТекущийМакет];
	ТекущаяОбластьРасшифровка  					= тМакет.Область(ИмяОбласти);		
	СтруктураРасшифровки 						= ПолучитьРасшифровкуВРазрезеИндексовАналитик(ТекущаяОбластьРасшифровка.Расшифровка,ТекущаяОбластьРасшифровка.Имя);
	
	НстрПоказатель 				= ТаблицаЗаблокированныхПоказателейРаспределение.Добавить();
	ЗаполнитьЗначенияСвойств(НстрПоказатель,СтруктураРасшифровки);
	НстрПоказатель.Показатель 	= СтруктураРасшифровки.ПоказательСсылка;
	НстрПоказатель.ИмяОбласти 	= ТекущаяОбластьРасшифровка.Имя;
	
	ВыделитьЗаблокированныйПоказательСервер(ТекущаяОбластьРасшифровка);
				
КонецПроцедуры	
 
&НаСервере
Процедура ВосстановитьЗаблокированныеОбластиРаспределение()
	
	Если ТаблицаЗаблокированныхПоказателейРаспределение.Количество() = 0 Тогда
		 Возврат;
	КонецЕсли;	
		
	//Обновим картинку выделенного показателя в таблице, если нашли
	тОбъект 						= ПолучитьСвойстваТекущегоОбъектаСервер();
	КэшАналитикПоказателей		 	= ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.КэшАналитикПоказателейАдрес);
	
	Для ИндСтроки = 2 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
				
		Для ИндКолонки  = 2 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			
			 тОбласть = ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки);
			 Если ТипЗнч(тОбласть.Расшифровка)=Тип("Структура") 
				 И тОбласть.Расшифровка.Свойство("Ссылка") Тогда 
				 
				 Для Каждого СтрПоказатель Из ТаблицаЗаблокированныхПоказателейРаспределение Цикл
					 //Проверяем показатель
					 Если НЕ тОбласть.Расшифровка.Ссылка = СтрПоказатель.Показатель Тогда 
						  Продолжить;
					 КонецЕсли;
					 
					 тСтруктураРасшифровкиПоказателя = Новый Структура; 
					 ЗаполнитьЗначенияРасшифровкиПоТекущемуКонтекстуСервер(тОбласть,тСтруктураРасшифровкиПоказателя);
					  
					 ОбластьИмя 			=  тОбласть.Имя;
					 ОбластьРасшифровка     =  тОбласть.Расшифровка;
						 
					 СтруктураОтвета = ПолучитьСтруктуруРасшифровкиБезКонтекста(тСтруктураРасшифровкиПоказателя,Неопределено,тОбъект,ОбъектАналитическогоБланка.АдресРасшифровкиГруппОтборов,ОбластьИмя,ОбластьРасшифровка,ОбъектАналитическогоБланка.ТзСвойстваПоказателейАдрес);
					  
					 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство("Организация") 
						 ИЛИ (СтруктураОтвета.СтруктураРасшифровки.Свойство("Организация") 
						 И НЕ СтруктураОтвета.СтруктураРасшифровки.Организация =  СтрПоказатель.Организация) Тогда
						 Продолжить;
					 КонецЕсли;	 
					 Если СтруктураОтвета.СтруктураРасшифровки.Свойство("Сценарий") 
						 И  НЕ СтруктураОтвета.СтруктураРасшифровки.Сценарий =  СтрПоказатель.Сценарий Тогда
						 Продолжить;
					 КонецЕсли;	 
					 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство("ПериодОтчета") 
						 ИЛИ (СтруктураОтвета.СтруктураРасшифровки.Свойство("ПериодОтчета") 
						 И  НЕ СтруктураОтвета.СтруктураРасшифровки.ПериодОтчета =  СтрПоказатель.ПериодОтчета) Тогда
						 Продолжить;
					 КонецЕсли;	 
					 
					 тПоказатель =  КэшАналитикПоказателей.Найти(СтрПоказатель.Показатель,"Показатель");
					 
					 //Ищем соответствие по аналитикам
					 ФлСоответствияПоАналитикм = Истина;
					 Для Инд=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
						 Если ЗначениеЗаполнено(СтрПоказатель["Аналитика"+Инд]) Тогда
							 КодАналитики = тПоказатель["ВидАналитики"+Инд+"Код"];		 
							 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство(КодАналитики) Тогда
								 ФлСоответствияПоАналитикм = Ложь;
								 Прервать;
							 КонецЕсли;	   
							 Если  НЕ СтруктураОтвета.СтруктураРасшифровки[КодАналитики] =  СтрПоказатель["Аналитика"+Инд] Тогда
								 ФлСоответствияПоАналитикм = Ложь;
								 Прервать;
							 КонецЕсли;	 	 
						 КонецЕсли;	 	 
					 КонецЦикла;	 
					  
					 Если ФлСоответствияПоАналитикм Тогда
						 ВыделитьЗаблокированныйПоказательСервер(тОбласть);
						 СтрПоказатель.ИмяОбласти = тОбласть.Имя; 
					 КонецЕсли;
					 
				 КонецЦикла;		 	 
			 КонецЕсли;			 	 
		КонецЦикла;		 
	 КонецЦикла;	

КонецПроцедуры	

&НаСервере
Процедура ВыделитьЗаблокированныйПоказательСервер(тОбласть)
		
	тОбласть.Картинка = БиблиотекаКартинок.ЗанятьФайл;	
	тОбласть.ПоложениеТекстаОтносительноКартинки = ПоложениеТекстаОтносительноКартинки.Слева; 
	тОбласть.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Право;
		
КонецПроцедуры

&НаСервере
Процедура СнятьЗаблокированныйПоказательВТаблице(ИмяОбласти)
		
	тМакет 										= ЭтаФорма[ТекущийМакет];
	ТекущаяОбластьРасшифровка  					= тМакет.Область(ИмяОбласти);		
	СтруктураРасшифровки 						= ПолучитьРасшифровкуВРазрезеИндексовАналитик(ТекущаяОбластьРасшифровка.Расшифровка,ТекущаяОбластьРасшифровка.Имя);
	ТаблицаЗаблокированныхПоказателейРаспределение_ = РеквизитФормыВЗначение("ТаблицаЗаблокированныхПоказателейРаспределение");
	
	
	СтруктураПоиска  = Новый Структура;
	Для ИндАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СтруктураПоиска.Вставить("Аналитика"+ИндАналитики,СтруктураРасшифровки["Аналитика"+ИндАналитики]);
	КонецЦикла;	
	СтруктураПоиска.Вставить("Показатель",СтруктураРасшифровки.ПоказательСсылка);
	СтруктураПоиска.Вставить("Сценарий",СтруктураРасшифровки.Сценарий);
	СтруктураПоиска.Вставить("ПериодОтчета",СтруктураРасшифровки.ПериодОтчета); 
	Если СтруктураРасшифровки.Свойство("Организация") Тогда
		 СтруктураПоиска.Вставить("Организация",СтруктураРасшифровки.Организация); 
	КонецЕсли;
	Если СтруктураРасшифровки.Свойство("Проект") Тогда
		 СтруктураПоиска.Вставить("Проект",СтруктураРасшифровки.Проект); 
	КонецЕсли;

	НстрПоказатель 				= ТаблицаЗаблокированныхПоказателейРаспределение_.НайтиСтроки(СтруктураПоиска);
	МассивУдаляемыхСтрок        = Новый Массив;
	Для Каждого СтрПоказатель Из НстрПоказатель Цикл
		МассивУдаляемыхСтрок.Добавить(СтрПоказатель);	
	КонецЦикла;	
	
	Для Каждого СтрУдПоказатель Из МассивУдаляемыхСтрок Цикл
		ТаблицаЗаблокированныхПоказателейРаспределение_.Удалить(СтрУдПоказатель);
	КонецЦикла;	
	
	ЗначениеВРеквизитФормы(ТаблицаЗаблокированныхПоказателейРаспределение_,"ТаблицаЗаблокированныхПоказателейРаспределение");
	
	СнятьВыделениеЗаблокированногоПоказателяСервер(ТекущаяОбластьРасшифровка);
				
КонецПроцедуры	
 
&НаСервере
Процедура СнятьВыделениеЗаблокированногоПоказателяСервер(тОбласть)
	
	тОбласть.Картинка = Неопределено;
		
КонецПроцедуры


 
 #КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НарисоватьТаблицуВФоне(ОткрытиеФормы = Ложь)
	
	// 1. Запуск фонового задания на сервере.
	ДлительнаяОперация = НачатьВыводТаблицы(ОткрытиеФормы);
	
	// При ошибках проверки заполнения параметров не запускаем длительную операцию.
	Если ТипЗнч(ДлительнаяОперация) = Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Подключение обработчика завершения фонового задания.
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Обновление сводной таблицы...'");
	Оповещение        = Новый ОписаниеОповещения("ПриЗавершенииВыводаТаблицы", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьВыводТаблицы(ОткрытиеФормы)
	
	Если ПроверитьВозможностьОтображенияПоБланкуОтчета() И ВозможностьОбновитьСводнуюТаблицу() И ВозможностьСгенерироватьМакетШаблона() Тогда
		
		Возврат ДлительныеОперации.ВыполнитьФункцию(
			ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор),
			"Обработки.АналитическийБланкСводнаяТаблица.НарисоватьТаблицуПриОбновлении",
			ПараметрыВыводаСводнойТаблицы(ОткрытиеФормы));
		
	КонецЕсли;
		
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ВозможностьСгенерироватьМакетШаблона()
	
	Если ОбновитьМакетШаблона Тогда
		Если ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Количество() = 0 Тогда
			УстановитьСостояниеНеИспользоватьШаблон(НСтр("ru = 'Не заполнен состав строк сводной таблицы'"));
			Возврат Ложь;
		КонецЕсли;
		
		Если ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Количество() = 0 Тогда
			УстановитьСостояниеНеИспользоватьШаблон(НСтр("ru = 'Не заполнен состав колонок сводной таблицы'"));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ВозможностьОбновитьСводнуюТаблицу()
	
	Если ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Количество() = 0 Тогда
		Если  РежимМоделирования Тогда
			УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнены целевые показатели'"));
		Иначе	
			УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен состав строк сводной таблицы'"));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Количество() = 0 Тогда
		Если  РежимМоделирования Тогда
			УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнены целевые показатели'"));
		Иначе	
			УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен состав колонок сводной таблицы'"));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодС) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен период начала'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодПо) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен период окончания'"));
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВалютаОтображения) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнена валюта отображения'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("ОсьТаблицы,Поле",Перечисления.ОсиСводнойТаблицы.Отборы,Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий)).Количество()=0 Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен сценарий '"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииВыводаТаблицы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		УстановитьСостояниеНеИспользовать(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействияПослеВыводаТаблицы(Результат.АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияПослеВыводаТаблицы(АдресРезультата, СброситьСостояниеНеИспользоватьШаблон = Ложь)

	СтруктураРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);

	ОбработкаОбъектАналитическийБланк = РеквизитФормыВЗначение("ОбъектАналитическогоБланка");
	
	ОбновитьМакетШаблона          = СтруктураРезультата.ОбновитьМакетШаблона;
	ПолеТабличногоДокументаМакет  = СтруктураРезультата.ПолеТабличногоДокументаМакет;
	ЗаполнитьЗначенияСвойств(ОбработкаОбъектАналитическийБланк, СтруктураРезультата.РеквизитыОбработки);
	Если ТипЗнч(СтруктураРезультата.СтруктураНастроекАналитическогоБланка) = Тип("Структура") Тогда
		СтруктураНастроекАналитическогоБланкаАдрес = ПоместитьВоВременноеХранилище(
			СтруктураРезультата.СтруктураНастроекАналитическогоБланка,
			УникальныйИдентификатор);
	КонецЕсли;
	
	Для Каждого ТЧ Из СтруктураРезультата.ТабличныеЧастиОбработки Цикл
		ОбработкаОбъектАналитическийБланк[ТЧ.Ключ].Загрузить(ТЧ.Значение);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъектАналитическийБланк,"ОбъектАналитическогоБланка");
	
	Если СтруктураРезультата.СброситьСостояниеНеИспользоватьШаблон Тогда
		СброситьСостояниеНеИспользоватьШаблон();
	КонецЕсли;
	
	Если РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеПропорционально ИЛИ
		РежимРаботы = Перечисления.РежимыРаботыСводнойТаблицы.ОбратноеРаспределениеРавномерно Тогда	
		УстановитьОформлениеЯчеекОбратноеРаспределение();
		ВосстановитьЗаблокированныеОбластиРаспределение();
	КонецЕсли;
	
	ОбновитьСписокТекущихОрганизаций();
	ОбновитьСписокТекущихПроектов();
	СброситьСостояниеНеИспользовать();
	УстановитьВыбранныйРежимРаботы();
	
	Если РежимМоделирования Тогда
		ОбновитьПанельЦелевыхПоказателей();
		Элементы.ГруппаДанныеМодели.Доступность = НЕ Обработки.АналитическийБланк.ПолучитьПоследнийНомерТранзакции(ИдентификаторДанныхМоделирование) = Неопределено; 
	КонецЕсли;
	
	Если СтруктураРезультата.ОткрытиеФормы Тогда
		ОбновитьСтрокуКлючевыхПараметров();
	КонецЕсли;
	
	Элементы.НадписьОбновитеТаблицу.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыВыводаСводнойТаблицы(ОткрытиеФормы = Ложь)

	ПараметрыФункции = Новый Структура;
	
	РеквизитыОбработки = Обработки.АналитическийБланкСводнаяТаблица.РеквизитыОбработкиАналитическийОтчет();
	ЗаполнитьЗначенияСвойств(РеквизитыОбработки, ОбъектАналитическогоБланка);
	РеквизитыОбработки.СТ_ДополнительныеНастройки_Объект = Неопределено;
	ПараметрыФункции.Вставить("РеквизитыОбработки",      РеквизитыОбработки);
	ПараметрыФункции.Вставить("ВалютаОтображения",       ВалютаОтображения);
	ПараметрыФункции.Вставить("СдвигПоПериоду",          СдвигПоПериоду); 
	ПараметрыФункции.Вставить("ПроектыБаза",             ПроектыБаза);
	ПараметрыФункции.Вставить("УровеньТочности",         УровеньТочности);
	ПараметрыФункции.Вставить("ТекущийДелитель",         ТекущийДелитель);
	ПараметрыФункции.Вставить("РежимРаботы",             РежимРаботы);
	ПараметрыФункции.Вставить("ВариантСводнойТаблицы",   ВариантСводнойТаблицы);
	ПараметрыФункции.Вставить("РежимРаботы",             РежимРаботы);
	ПараметрыФункции.Вставить("МакетКолонок",            МакетКолонок);
	ПараметрыФункции.Вставить("МакетСтрок",              МакетСтрок);
	ПараметрыФункции.Вставить("МакетТаблиц",             МакетТаблиц);
	ПараметрыФункции.Вставить("МакетСинтетики",			 МакетСинтетики);
	ПараметрыФункции.Вставить("Бланк",                   Бланк);
	ПараметрыФункции.Вставить("РежимМоделирования",      РежимМоделирования);
	ПараметрыФункции.Вставить("ИдентификаторДанныхМоделирование", ИдентификаторДанныхМоделирование);
	ПараметрыФункции.Вставить("Сценарий",                ЭтаФорма.Сценарий);
	ПараметрыФункции.Вставить("ПериодыБазаИспользовать", ПериодыБазаИспользовать); 
	ПараметрыФункции.Вставить("СдвигПоПериоду",          СдвигПоПериоду);
	ПараметрыФункции.Вставить("ПроектБаза",              ПроектыБаза);
	ПараметрыФункции.Вставить("ОрганизацияБаза",         ОрганизацияБаза);
	ПараметрыФункции.Вставить("ПериодБаза",              ПериодБаза);
	ПараметрыФункции.Вставить("ПериодС",                 ПериодС);
	ПараметрыФункции.Вставить("ПериодПо",                ПериодПо);
	
	//Параметры режима работы сравнения с базой
	ПараметрыФункции.Вставить("ПериодБазаС",             ПериодБазаС);
	ПараметрыФункции.Вставить("ПериодБазаПо",            ПериодБазаПо);
	ПараметрыФункции.Вставить("СценарииБазаИспользовать",СценарииБазаИспользовать);
	ПараметрыФункции.Вставить("СценарииБаза",            СценарииБаза);
    ПараметрыФункции.Вставить("ОрганизацииБазаИспользовать",ОрганизацииБазаИспользовать);
	ПараметрыФункции.Вставить("ОрганизацияБаза",            ОрганизацияБаза);
    ПараметрыФункции.Вставить("ПроектыБазаИспользовать",ПроектыБазаИспользовать);
	ПараметрыФункции.Вставить("ПроектыБаза",            ПроектыБаза);	
	
	ПараметрыФункции.Вставить("ВидОтчета",               ВидОтчета);
	ПараметрыФункции.Вставить("СценарийБаза",            СценарииБаза);
	ПараметрыФункции.Вставить("тВидыОтчетов",            тВидыОтчетов);
	ПараметрыФункции.Вставить("ДЗНастройкиОтборов",      РеквизитФормыВЗначение("НастройкиОтборов"));
	ПараметрыФункции.Вставить("ОткрытиеФормы",           ОткрытиеФормы);

	ПараметрыФункции.Вставить("ОбновитьМакетШаблона",                     ОбновитьМакетШаблона);
	Если ОбновитьМакетШаблона Тогда
		ПараметрыФункции.Вставить("НастройкиСоставаСтрокСводнойТаблицы",      ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиСоставаКолонокСводнойТаблицы",    ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиРасположенияПолейСводнойТаблицы", ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиВариантаСводнойТаблицы",          ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиПериодовСводнойТаблицы",          ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиПолейСводнойТаблицы",             ЭтаФорма["НастройкиПолейСводнойТаблицы"].Выгрузить());
		ПараметрыФункции.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы", ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Выгрузить());	
	КонецЕсли;
	ПараметрыФункции.Вставить("НастройкиРасположенияПолейСводнойТаблицы", ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
	ПараметрыФункции.Вставить("ПолеТабличногоДокументаШаблон",            ПолеТабличногоДокументаШаблон);
	ПараметрыФункции.Вставить("ПолеТабличногоДокументаМакет",             ПолеТабличногоДокументаМакет);
	ПараметрыФункции.Вставить("ИдентификаторФормы",                       ЭтотОбъект.УникальныйИдентификатор);
	
	АналитикиОтчета = Новый Структура;
	АналитикиОтчета.Вставить("Проект");
	АналитикиОтчета.Вставить("Организация");
	АналитикиОтчета.Вставить("Сценарий");

	Для аИнд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		АналитикиОтчета.Вставить("ВидАналитики" + аИнд);
	КонецЦикла;
	
	БыстрыеОтборы = ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Отборы));
	Для Каждого Стр Из БыстрыеОтборы Цикл
		Если Стр.ЭтоПроизводноеПоле Тогда
			КодПоля = СтрЗаменить(Стр.ПутьКРеквизиту,".","");
		Иначе	
			КодПоля = Стр.КодПоля;
		КонецЕсли;	
		АналитикиОтчета.Вставить(КодПоля);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(АналитикиОтчета, ЭтотОбъект);
	ПараметрыФункции.Вставить("АналитикиОтчета", АналитикиОтчета);
	
	ПараметрыФункции.Вставить("СтруктураНастроекАналитическогоБланкаАдрес", СтруктураНастроекАналитическогоБланкаАдрес);
	Если Не ПустаяСтрока(СтруктураНастроекАналитическогоБланкаАдрес) Тогда
		ПараметрыФункции.Вставить("СтруктураНастроекАналитическогоБланка",
			ПолучитьИзВременногоХранилища(СтруктураНастроекАналитическогоБланкаАдрес));
	Иначе
		ПараметрыФункции.Вставить("СтруктураНастроекАналитическогоБланка", Неопределено);
	КонецЕсли;
	
	СтруктураЗарезервированыеАдреса = Новый Структура;
	ДанныеПоАдресам                 = Новый Структура;
	
	ПараметрыОтбора = Новый Структура("ОбъектМетаданных", "АналитическийБланк");
	ЗарезервированныеАдресаАБ = ЗарезервированныеАдреса.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из ЗарезервированныеАдресаАБ Цикл
		СтруктураЗарезервированыеАдреса.Вставить(Стр.Реквизит, Стр.Адрес);
		ДанныеПоАдресам.Вставить(Стр.Реквизит, ПолучитьИзВременногоХранилища(Стр.Адрес));
	КонецЦикла;
	
	ПараметрыФункции.Вставить("ЗарезервированыеАдреса", СтруктураЗарезервированыеАдреса);
	ПараметрыФункции.Вставить("ДанныеПоАдресам",        ДанныеПоАдресам);
	
	Возврат ПараметрыФункции;

КонецФункции
	
&НаСервере
Функция ПараметрыЗадания()
	
	ПараметрыЗадания = Новый Структура;
	
	врОбъектАналитическогоБланка = Новый Структура;
	врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейYАдрес", ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес);
	врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейXАдрес", ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейХАдрес);
	Если Не ПустаяСтрока(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес) Тогда
		врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейY", ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейYАдрес));		
	Иначе
		врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейY", Неопределено);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейХАдрес) Тогда
		врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейX", ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.СтруктураРасшифровкаОбластейХАдрес));
	Иначе
		врОбъектАналитическогоБланка.Вставить("СтруктураРасшифровкаОбластейX", Неопределено);
	КонецЕсли;

	АналитикиОтчета = Новый Структура;
	АналитикиОтчета.Вставить("Проект");
	АналитикиОтчета.Вставить("Организация"); 
	
	Для аИнд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		АналитикиОтчета.Вставить("ВидАналитики" + аИнд);
	КонецЦикла;
	
	БыстрыеОтборы = ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Отборы));
	Для Каждого Стр Из БыстрыеОтборы Цикл
		Если Стр.ЭтоПроизводноеПоле Тогда
			КодПоля = СтрЗаменить(Стр.ПутьКРеквизиту,".","");
		Иначе	
			КодПоля = Стр.КодПоля;
		КонецЕсли;	
		АналитикиОтчета.Вставить(КодПоля);
	КонецЦикла;	
	
	ЗаполнитьЗначенияСвойств(АналитикиОтчета, ЭтотОбъект);

	РеквизитыРасчетаИЗаписиПоказателей = Обработки.АналитическийБланкСводнаяТаблица.РеквизитыРасчетаИЗаписиПоказателей();
	ЗаполнитьЗначенияСвойств(РеквизитыРасчетаИЗаписиПоказателей, РасчетИЗаписьПоказателей);
	
	ПараметрыОтбора = Новый Структура("ОбъектМетаданных", "РасчетИЗаписьПоказателей");
	АдресаРасчетаИЗаписиПоказателей = ЗарезервированныеАдреса.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из АдресаРасчетаИЗаписиПоказателей Цикл
		ПараметрыЗадания.Вставить(Стр.Реквизит, Стр.Адрес);
		Если Стр.Реквизит = "АдресКэшаДанных" Тогда
			Если ЗначениеЗаполнено(РасчетИЗаписьПоказателей.АдресКэшаДанных) Тогда
				ПараметрыЗадания.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(РасчетИЗаписьПоказателей.АдресКэшаДанных));
			Иначе
				ПараметрыЗадания.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(Стр.Адрес));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если тПериоды.Количество()= 0 Тогда
		ЗаполнитьПериоды();
	КонецЕсли;

	ПараметрыЗадания.Вставить("тПериоды",                                 тПериоды);
	ПараметрыЗадания.Вставить("ПериодС" ,                                 ПериодС);
	ПараметрыЗадания.Вставить("ПериодПо",                                 ПериодПо);
	ПараметрыЗадания.Вставить("тВидыОтчетов",                             тВидыОтчетов);
	ПараметрыЗадания.Вставить("Сценарий",                                 ЭтотОбъект.Сценарий);
	ПараметрыЗадания.Вставить("НастройкиРасположенияПолейСводнойТаблицы", ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
	ПараметрыЗадания.Вставить("ОбъектАналитическогоБланка",               врОбъектАналитическогоБланка);
	ПараметрыЗадания.Вставить("АналитикиОтчета",                          АналитикиОтчета); 
	ПараметрыЗадания.Вставить("РеквизитыРасчетаИЗаписиПоказателей",       РеквизитыРасчетаИЗаписиПоказателей);
	ПараметрыЗадания.Вставить("ВидОтчета",                                ВидОтчета);
	ПараметрыЗадания.Вставить("ВалютаОтображения",                        ВалютаОтображения);
	ПараметрыЗадания.Вставить("НомерТранзакции",                          НомерТранзакции);
	
	Возврат ПараметрыЗадания;
	
КонецФункции

&НаСервере
Функция ПолучитьСвойстваТекущегоКонтекста()
	
	 ТекущийКонтекст = Новый Структура;
	
	 ТекущийКонтекст.Вставить("ОбъектАналитическогоБланка",ОбъектАналитическогоБланка);
	 ТекущийКонтекст.Вставить("ВалютаОтображения",ВалютаОтображения);
     ТекущийКонтекст.Вставить("НастройкиОтборов",НастройкиОтборов);
     ТекущийКонтекст.Вставить("РежимМоделирования",РежимМоделирования);
     ТекущийКонтекст.Вставить("ИдентификаторСеанса",УникальныйИдентификатор);
     ТекущийКонтекст.Вставить("логИзмененныхДанныхАдрес",логИзмененныхДанныхАдрес);
     ТекущийКонтекст.Вставить("ИдентификаторДанныхМоделирование",ИдентификаторДанныхМоделирование);
	 ТекущийКонтекст.Вставить("Сценарий",ЭтаФорма["Сценарий"]);
	 ТекущийКонтекст.Вставить("тОбъект",ПолучитьСвойстваТекущегоОбъектаСервер());

	 
	 Возврат ТекущийКонтекст; 
	 
КонецФункции	

