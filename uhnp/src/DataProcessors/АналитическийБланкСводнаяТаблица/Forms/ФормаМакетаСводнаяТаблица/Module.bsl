&НаКлиенте
Процедура ПоказатьНастройкуСоставаАналитики(Команда)
	
	
	Параметры_ = Новый Структура("ВариантСводнойТаблицы,АдресТаблицИнтерфейса", ВариантСводнойТаблицы,ПодготовитьОписаниеТаблицИнтерфейса());
	
	Оповещение = Новый ОписаниеОповещения("НастрйкаСоставаАналитикиЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаНастройкиСоставаАналитик", 
	Параметры_,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

КонецПроцедуры

&НаКлиенте
Процедура НастрйкаСоставаАналитикиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьНастройкиСоставаАналитики(Результат);
	
	УстановитьСостояниеНеИспользовать(НСтр("ru = 'Таблица не актуальна. Нажмите ""Сформировать (F5)"" для обновления данных.'"));

	Если РежимДоступаКФункциямСводнойТаблицы = ПредопределенноеЗначение("Перечисление.РежимыДоступаКФункциямСводнойТаблицы.РазработкаМакета")  Тогда
		СгенерироватьМакетШаблона();
	КонецЕсли;
	
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПрименитьНастройкиСоставаАналитики(Результат);
	
	ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиСоставаАналитикиСтрокСводнойТаблицыАдрес));
		
КонецПроцедуры

&НаСервере
Функция ПодготовитьОписаниеТаблицИнтерфейса()
	
	СтруктураПараметровВход = Новый Структура;
	
	СтруктураПараметровВход.Вставить("ПолеТабличногоДокументаШаблон", ПолеТабличногоДокументаШаблон);
	СтруктураПараметровВход.Вставить("НастройкиСоставаСтрокСводнойТаблицы", ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиСоставаКолонокСводнойТаблицы", ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиРасположенияПолейСводнойТаблицы", ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиВариантаСводнойТаблицы", ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиПериодовСводнойТаблицы", ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиПолейСводнойТаблицы", ЭтаФорма["НастройкиПолейСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы", ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Выгрузить());
	СтруктураПараметровВход.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	АдресТаблицИнтерфейса = ПоместитьВоВременноеХранилище(СтруктураПараметровВход, УникальныйИдентификатор);
	
	Возврат АдресТаблицИнтерфейса;		
 
