#КонецОбласти


#Область ВариантАнализаВодопад

&НаКлиенте
Процедура РассчитатьФакторыВодопад(Команда)
	
	ДлительнаяОперация = РассчитатьВлияниеФакторовИВывестиДиаграмму();
	
	// При ошибках проверки заполнения параметров не запускаем длительную операцию.
	Если ТипЗнч(ДлительнаяОперация) = Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания  = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется расчет влияния факторов...'");
	Оповещение         = Новый ОписаниеОповещения("ПриЗавершенииРасчетаВлиянияФакторовИВыводаДиаграммы", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииРасчетаВлиянияФакторовИВыводаДиаграммы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Результат.КраткоеПредставлениеОшибки, , , СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействияПослеРасчетаВлиянияФактороИВыводаДиаграммы(Результат);
	РасчетФакторовАктуален = Истина;
	ПоказатьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияПослеРасчетаВлиянияФактороИВыводаДиаграммы(Результат)
	
	СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	тПараметрыДиаграммыВодопадАдрес = СтруктураРезультата.тПараметрыДиаграммыВодопадАдрес;
	ВывестиДиаграммуВодопад();

КонецПроцедуры

Функция ПараметрыПодбораПоказателей()
	
	ПараметрыПодбора = Новый Структура;
	
	РеквизитыОбработкиАБ = Обработки.АналитическийБланкСводнаяТаблица.РеквизитыОбработкиАналитическийБланк();
	ЗаполнитьЗначенияСвойств(РеквизитыОбработкиАБ, ОбъектАналитическогоБланка);
	РеквизитыОбработкиАБ.СТ_ДополнительныеНастройки_Объект = Неопределено;
	Для Каждого ТЧОбработкиАБ Из РеквизитыОбработкиАБ.ТабличныеЧасти Цикл
		РеквизитыОбработкиАБ.ТабличныеЧасти.Вставить(
			ТЧОбработкиАБ.Ключ,
			ОбъектАналитическогоБланка[ТЧОбработкиАБ.Ключ].Выгрузить());
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура("ОбъектМетаданных", "РасчетИЗаписьПоказателей");
	
	АдресаРасчетаИЗаписиПоказателей = ЗарезервированныеАдреса.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из АдресаРасчетаИЗаписиПоказателей Цикл
		ПараметрыПодбора.Вставить(Стр.Реквизит, Стр.Адрес);
		Если Стр.Реквизит = "АдресКэшаДанных" Тогда
			Если ЗначениеЗаполнено(РасчетИЗаписьПоказателей.АдресКэшаДанных) Тогда
				ПараметрыПодбора.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(РасчетИЗаписьПоказателей.АдресКэшаДанных))
			Иначе
				ПараметрыПодбора.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(Стр.Адрес));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	РеквизитыРасчетаИЗаписиПоказателей = Обработки.АналитическийБланкСводнаяТаблица.РеквизитыРасчетаИЗаписиПоказателей();
	ЗаполнитьЗначенияСвойств(РеквизитыРасчетаИЗаписиПоказателей, РасчетИЗаписьПоказателей);
	тПараметрыДиаграммыВодопадАдресВФоне = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыПодбора.Вставить("ТаблицаВыделенныхПоказателейМоделирование", ТаблицаВыделенныхПоказателейМоделирование.Выгрузить()); 
	ПараметрыПодбора.Вставить("ТаблицаЧувствительностиФакторов",           ТаблицаЧувствительностиФакторов.Выгрузить());
	ПараметрыПодбора.Вставить("ИдентификаторДанныхМоделирование",          ИдентификаторДанныхМоделирование);
	ПараметрыПодбора.Вставить("ДетализацияАналитикВлияние",                ДетализацияАналитикВлияние);
	ПараметрыПодбора.Вставить("ВалютаОтображения",                         ВалютаОтображения);
	ПараметрыПодбора.Вставить("ЧислоДопАналитик",                          ПараметрыСеанса.ЧислоДопАналитик);
	ПараметрыПодбора.Вставить("ЦелевойПоказательНовоеЗначение",            ЦелевойПоказательНовоеЗначение);
	ПараметрыПодбора.Вставить("ПериодПо",                                  ПериодПо);
	ПараметрыПодбора.Вставить("ПериодС",                                   ПериодС);
	ПараметрыПодбора.Вставить("РеквизитыОбработкиАБ",                      РеквизитыОбработкиАБ);
	ПараметрыПодбора.Вставить("УникальныйИдентификаторФормы",              УникальныйИдентификатор);
	ПараметрыПодбора.Вставить("тВидыОтчетов",                              тВидыОтчетов);
	ПараметрыПодбора.Вставить("ТекущийДелитель",                           ТекущийДелитель);
	ПараметрыПодбора.Вставить("УровеньТочности",                           УровеньТочности);
	ПараметрыПодбора.Вставить("РежимМоделирования",                        РежимМоделирования);
	ПараметрыПодбора.Вставить("логИзмененныхДанныхАдрес",                  логИзмененныхДанныхАдрес); 
	ПараметрыПодбора.Вставить("НастройкиРасположенияПолейСводнойТаблицы",  ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить());
	ПараметрыПодбора.Вставить("РеквизитыРасчетаИЗаписиПоказателей",        РеквизитыРасчетаИЗаписиПоказателей);
	ПараметрыПодбора.Вставить("тПараметрыДиаграммыВодопадАдресВФоне",      тПараметрыДиаграммыВодопадАдресВФоне);
	АналитикиОтчета = Новый Структура;
	АналитикиОтчета.Вставить("Проект");
	АналитикиОтчета.Вставить("Организация");
	АналитикиОтчета.Вставить("Сценарий");
	АналитикиОтчета.Вставить("Представление");

	Для аИнд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		АналитикиОтчета.Вставить("ВидАналитики" + аИнд);
	КонецЦикла;
	
	БыстрыеОтборы = ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("ОсьТаблицы",Перечисления.ОсиСводнойТаблицы.Отборы));
	Для Каждого Стр Из БыстрыеОтборы Цикл
		Если Стр.ЭтоПроизводноеПоле Тогда
			КодПоля = СтрЗаменить(Стр.ПутьКРеквизиту,".","");
		Иначе	
			КодПоля = Стр.КодПоля;
		КонецЕсли;	
		АналитикиОтчета.Вставить(КодПоля);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(АналитикиОтчета, ЭтотОбъект);
	ПараметрыПодбора.Вставить("АналитикиОтчета", АналитикиОтчета);
	
	СтруктураЗарезервированыеАдреса = Новый Структура;
	ДанныеПоАдресам                 = Новый Структура;
	
	Для Каждого Стр Из ЗарезервированныеАдреса Цикл
		СтруктураЗарезервированыеАдреса.Вставить(Стр.Реквизит, Стр.Адрес);
		ДанныеПоАдресам.Вставить(Стр.Реквизит, ПолучитьИзВременногоХранилища(Стр.Адрес));
	КонецЦикла;
	
	ПараметрыПодбора.Вставить("ЗарезервированыеАдреса", СтруктураЗарезервированыеАдреса);
	ПараметрыПодбора.Вставить("ДанныеПоАдресам",        ДанныеПоАдресам);
	
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция РассчитатьВлияниеФакторовИВывестиДиаграмму()
	
	СтрокаЦелевойДополнительный = ТаблицаВыделенныхПоказателейМоделирование.НайтиСтроки(Новый Структура("Базовый",Ложь));
	Если СтрокаЦелевойДополнительный.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыПодбора    = ПараметрыПодбораПоказателей();
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.АналитическийБланкСводнаяТаблица.РассчитатьВлияниеФакторовИВывестиДиаграмму",
		ПараметрыПодбора);
		
КонецФункции

&НаСервере
Процедура ВывестиДиаграммуВодопад() Экспорт
			
	ПолеТабличногоДокументаАнализГрафический.Очистить();

	Если ТаблицаВыделенныхПоказателейМоделирование.Количество() < 2 Тогда
		ПолеТабличногоДокументаАнализГрафический.Очистить();
		УстановитьСостояниеНеИспользоватьДляТекущегоРежима(НСтр("ru = 'Для вывода дерева факторов необходимо выбрать базовый и дополнительный целевые показатели'"),3);
		Элементы.ГруппаКомандыДиаграммаВодопад.Доступность = Ложь;
		Возврат;
	Иначе	
		СброситьСостояниеНеИспользоватьДляТекущегоРежима(3);
	КонецЕсли;	

	Если тПараметрыДиаграммыВодопадАдрес  = "" Тогда		
		ОтображениеСостояния = Элементы.ПолеТабличногоДокументаАнализВодопад.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Для вывода диаграммы необходимо рассчитать влияние факторов'");	
		Возврат;
	Иначе	
		СброситьСостояниеНеИспользоватьДляТекущегоРежима(3);
	КонецЕсли;	
		
	//Прочитаем доступные уровни факторов
	Элементы.УровеньДетализацииДиаграммыВодопад.СписокВыбора.Очистить();
	тУровни = ТаблицаЧувствительностиФакторов.Выгрузить(,"УровеньРасчета");
	тУровни.Сортировать("УровеньРасчета УБЫВ");
	
	тУровни.Свернуть("УровеньРасчета");
	Для Каждого тУровень Из тУровни Цикл
		Элементы.УровеньДетализацииДиаграммыВодопад.СписокВыбора.Добавить("Уровень "+тУровень.УровеньРасчета);
	КонецЦикла;	
	
		
	тПараметрыДиаграммыВодопад = ПолучитьИзВременногоХранилища(тПараметрыДиаграммыВодопадАдрес);
	
	Макет = Обработки.АналитическийБланкСводнаяТаблица.ПолучитьМакет("МакетФакторныйАнализВодопад");
	
	Если Не ЗначениеЗаполнено(УровеньДетализацииДиаграммыВодопад) Тогда
		УровеньДетализацииДиаграммыВодопад="1"; 
	КонецЕсли;	
	
		
	ВывестиОбластьДиаграммы(Макет,тПараметрыДиаграммыВодопад);
		
КонецПроцедуры

&НаСервере
Процедура ВывестиОбластьДиаграммы(Макет,тПараметрыДиаграммыВодопад)
		
	СекцияДиаграмма  =Макет.ПолучитьОбласть("ДиаграммаВывод");
	
	Диаграмма1 = СекцияДиаграмма.Рисунки.Диаграмма.Объект; // Диаграмма
	Диаграмма1.Очистить();
	Диаграмма1.ТипДиаграммы = ТипДиаграммы.ГистограммаСНакоплением;
	Диаграмма1.Обновление = Ложь; 
	Диаграмма1.ОтображатьЛегенду = Ложь;
	Диаграмма1.ОтображатьЗаголовок = Ложь;
	Диаграмма1.Окантовка = Ложь;

	Диаграмма1.КоличествоСерий = 7;
    Диаграмма1.Серии[0].Цвет = Новый Цвет(255,255,255); //База сливается с цветом фона диаграмма
	Диаграмма1.Серии[0].Текст="";
	
	Диаграмма1.Серии[1].Цвет = Новый Цвет(255,0,0); 
	Диаграмма1.Серии[1].Текст=Нстр("ru = 'Отрицательная динамика'");
	Диаграмма1.Серии[2].Цвет = Новый Цвет(173,255,47);
	Диаграмма1.Серии[2].Текст=Нстр("ru = 'Положительная динамика'");
	Диаграмма1.Серии[3].Цвет = Новый Цвет(204,255,255);
    Диаграмма1.Серии[3].Текст=Нстр("ru = 'Значение'");
	
	Диаграмма1.Серии[4].Цвет = Новый Цвет(255,0,0);
	Диаграмма1.Серии[4].Текст=Нстр("ru = 'Отрицательная динамика'");
	Диаграмма1.Серии[5].Цвет = Новый Цвет(173,255,47);
	Диаграмма1.Серии[5].Текст=Нстр("ru = 'Положительная динамика'");
	
	Диаграмма1.Серии[6].Цвет = Новый Цвет(255,255,255); //База сливается с цветом фона диаграмма
	Диаграмма1.Серии[6].Текст="";

	
	
	Диаграмма1.ПоложениеПодписей 		= ПоложениеПодписейКДиаграмме.ПравоНиз;
	Диаграмма1.РежимПробелов 			= РежимПробеловДиаграммы.ПолнаяШирина;
	Диаграмма1.ОбластьПостроения.ОтображатьЛинииЗначенийШкалы = Ложь;
	
	ИндексСтроки = 1;
	
	Для Каждого СтрокаТЗ Из тПараметрыДиаграммыВодопад Цикл
		
				
		Диаграмма1.КоличествоТочек = Диаграмма1.КоличествоТочек + 1;
		Диаграмма1.Точки[Диаграмма1.КоличествоТочек - 1].Текст = СтрокаТЗ.Заголовок;
		
		Если ИндексСтроки = 1 ИЛИ ИндексСтроки = тПараметрыДиаграммыВодопад.Количество() Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,3,СтрокаТЗ.ЗначениеНачалоКонец,);
			 ИндексСтроки = ИндексСтроки+1;
			 Продолжить;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СтрокаТЗ.ОтрицательныйКрасный)  Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,1,СтрокаТЗ.ОтрицательныйКрасный,);	
		КонецЕсли;	 
		Если ЗначениеЗаполнено(СтрокаТЗ.ПоложительныйКрасный) Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,4,СтрокаТЗ.ПоложительныйКрасный,);	
		КонецЕсли;	 
			
		Если ЗначениеЗаполнено(СтрокаТЗ.ОтрицательныйЗеленый) Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,2,СтрокаТЗ.ОтрицательныйЗеленый,);	
		КонецЕсли;	
		
		Если  ЗначениеЗаполнено(СтрокаТЗ.ПоложительныйЗеленый) Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,5,СтрокаТЗ.ПоложительныйЗеленый,);	
		КонецЕсли;	
	
		Если ЗначениеЗаполнено(СтрокаТЗ.ОтрицательнаяБаза) Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,0,СтрокаТЗ.ОтрицательнаяБаза,);	
		КонецЕсли;	
		
		Если  ЗначениеЗаполнено(СтрокаТЗ.ПоложительнаяБаза) Тогда
			 Диаграмма1.УстановитьЗначение(Диаграмма1.КоличествоТочек - 1,0,СтрокаТЗ.ПоложительнаяБаза,);	
		КонецЕсли;	

		ИндексСтроки = ИндексСтроки+1;
		
	КонецЦикла; 
	
	
	Диаграмма1.Обновление = Истина;
	ПолеТабличногоДокументаАнализГрафический.Очистить();
	ПолеТабличногоДокументаАнализГрафический.Вывести(СекцияДиаграмма);

	
	
КонецПроцедуры	

&НаКлиенте
Процедура УровеньДетализацииДиаграммыВодопадПриИзменении(Элемент)
	ВывестиДиаграммуВодопад();
КонецПроцедуры

#КонецОбласти


#Область МоделированиеПодборЗначения

&НаКлиенте
Процедура Моделирование_ВыполнитьПодборЗначения(Команда)
	
	// 1. Запуск фонового задания на сервере.
	ДлительнаяОперация = ВыполнитьПодборЗначения();
	
	// 2. Подключение обработчика завершения фонового задания.
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется подбор значения...'");
	Оповещение = Новый ОписаниеОповещения("ПриЗваершенииПодбораЗначения", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗваершенииПодбораЗначения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Результат.КраткоеПредставлениеОшибки, , , СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействияПослеПодбораЗначения(Результат);
	УстановитьРежимОжиданияПримененияИзменений();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияПослеПодбораЗначения(Результат)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ТаблицаЧувствительностиФакторов.Загрузить(РезультатОперации.ТаблицаЧувствительностиФакторов);
	ЦелевойПоказательНовоеЗначение = РезультатОперации.ЦелевойПоказательНовоеЗначение;
	ЗаполнитьЗначенияСвойств(РасчетИЗаписьПоказателей, РезультатОперации.РеквизитыРасчетаИЗаписиПоказателей);
	ОбщегоНазначения.СообщитьПользователю(РезультатОперации.ТекстСообщения);

КонецПроцедуры

&НаСервере
Функция ВыполнитьПодборЗначения()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);	
	ПараметрыПодбора    = ПараметрыПодбораПоказателей();

	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.АналитическийБланкСводнаяТаблица.ВыполнитьПоискРешения",
		ПараметрыПодбора);

КонецФункции

&НаСервере
Процедура ВыполнитьПоискРешения()
	
	// Заполним исходные данные для поиска решения
	
	ТекТаблицаМоделирования=ТаблицаЧувствительностиФакторов.Выгрузить().СкопироватьКолонки();
	ТекТаблицаМоделирования.Колонки.Добавить("СтрокаТаблицыЧувствительности");
	ТекТаблицаМоделирования.Колонки.Добавить("ОбработкаВыполнена",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТекТаблицаМоделирования.Колонки.Добавить("ТекущееЗначение",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	СтрокиДляАнализа=ТаблицаЧувствительностиФакторов.НайтиСтроки(Новый Структура("ВключатьВАнализ",Истина));
	
	//Подготовим данные для расчета влияния
	//Выделенный целевой базовый показатель 
	тЦелевыеПоказатели   = ТаблицаВыделенныхПоказателейМоделирование.Выгрузить().Скопировать(Новый Структура("Базовый",Истина));
		
	//Преобразуем таблицу факторов к нужному виду	
	тПоказателиФакторов  	= ТаблицаЧувствительностиФакторов.Выгрузить().СкопироватьКолонки();
	тПоказателиФакторов.Колонки.Добавить("Значение",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
			
	ТаблицаЧувствительностиФакторовКопия = ТекТаблицаМоделирования.Скопировать(); 
	
	тДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Выгрузить(,"ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	тДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	тДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
    тДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	Для Каждого СтрПересчета Из тДанныеДляПересчета Цикл
		СтрПересчета.ПериодОкончания = ПериодПо;
	КонецЦикла;

	Для Каждого Строка ИЗ СтрокиДляАнализа Цикл
		
		Если Строка.Влияние=0 Тогда //Рассчитаем влияние, если не сделали ранее.
				
			ОбработкаРасчета 								= Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса 	= ИдентификаторДанныхМоделирование;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
			
			тРезультат = РассчитатьЧувствительностьПоПоказателю(Строка,ОбработкаРасчета,тЦелевыеПоказатели,тПоказателиФакторов,Строка.ЗначениеМоделирование);
			
			Если тРезультат.Количество() = 1 Тогда
				Строка.Влияние 				=  тРезультат[0].Влияние;
				Строка.Градиент 			=  тРезультат[0].Градиент;
				Строка.КоэффГрадиента    	=  тРезультат[0].КоэффГрадиента;
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока=ТекТаблицаМоделирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
	
		НоваяСтрока.СтрокаТаблицыЧувствительности=Строка;
		НоваяСтрока.ТекущееЗначение=?(Строка.ЗначениеМоделирование=0,Строка.БазовоеЗначение,Строка.ЗначениеМоделирование);
		
	КонецЦикла;
	
	ТекЗначениеЦелевогоПоказателя = ПолучитьТекущееЗначениеЦелевогоПоказателя();
	
	Если ТекТаблицаМоделирования.Количество()=0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Не указаны исходные данные для моделирования.'"),,, СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
		
	Если Не ЗначениеПринципиальноДостижимо(ТекТаблицаМоделирования,ТекЗначениеЦелевогоПоказателя) Тогда	
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'По указанным параметрам достижение целевого значения невозможно.
		|Выберите другие базовые показатели или измените граничные условия.'"),,,СтатусСообщения.Внимание);
		Возврат;
		
	КонецЕсли;
	
	ТекТаблицаМоделирования.Сортировать("Влияние Убыв");
	
	РешениеНайдено=Ложь;
	ЧислоИтераций=1;
	ТекСходимость=0;
	СходимостьШаг=0;
	ИсходнаяТочность=0.04;
	ТекущаяТочность=0.04;
	ВремяСтарта=ТекущаяДата();
	НомерТранзакции = 99999;	
	
	Пока ЧислоИтераций<=100 Цикл //Делаем максимум 100 итераций
		
		СтрокаДляАнализа=ТекТаблицаМоделирования.Найти(Ложь,"ОбработкаВыполнена");
		
		Если СтрокаДляАнализа=Неопределено Тогда // На текущем шаге итерации все значения были использованы
			
			Если ТекСходимость=0 Тогда
				
				ТекСходимость=ОбщегоНазначенияУХ.ЗначениеПоМодулю(ПолучитьТекущееЗначениеЦелевогоПоказателя()-ЦелевойПоказательНовоеЗначение);
			
			ИначеЕсли СходимостьШаг>=ТекСходимость Тогда // Не удалось повысить сходимось
				
				ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Не удалось достичь целевого показателя. Выберите другие базовые показатели или расширьте границы изменения.'"),,, СтатусСообщения.Важное);
				Прервать;
				
			КонецЕсли;	
						
			ТекТаблицаМоделирования.ЗаполнитьЗначения(ЛОЖЬ,"ОбработкаВыполнена");
			ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования);
			
			СтрокаДляАнализа=ТекТаблицаМоделирования[0];
			
			ТекСходимость=СходимостьШаг;
			ЧислоИтераций=ЧислоИтераций+1;
			
		КонецЕсли;
		
		ВыполнитьГрадиентныйСпуск(СтрокаДляАнализа,ТекущаяТочность,ВремяСтарта,НомерТранзакции);
		
		тЗначениеЦелевого = ПолучитьТекущееЗначениеЦелевогоПоказателя();
		Если ДостигнутоЦелевоеЗначение(тЗначениеЦелевого,ТекущаяТочность) Тогда	
			
			ТекВремяВыполнения=ТекущаяДата();
			
			Если (ТекВремяВыполнения-ВремяСтарта)<60 И (НЕ ТекущаяТочность=0.01) Тогда // Проведем поиск по более высокой точности
				
				ТекущаяТочность=ТекущаяТочность/2;

			Иначе
				
				СохранитьЗначенияМоделирования(ТекТаблицаМоделирования,,тЗначениеЦелевого);
				Прервать;
				
			КонецЕсли;
			
		ИначеЕсли ТекущаяТочность<0.04 Тогда
			
			СохранитьЗначенияМоделирования(ТекТаблицаМоделирования,,тЗначениеЦелевого);
			Прервать;
			
		ИначеЕсли НЕ ТекТаблицаМоделирования.Найти(Ложь,"ОбработкаВыполнена")=Неопределено Тогда
			
			ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования);
			
		КонецЕсли;
		
		СходимостьШаг=ОбщегоНазначенияУХ.ЗначениеПоМодулю(тЗначениеЦелевого-ЦелевойПоказательНовоеЗначение);
		
	КонецЦикла;
	
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(ИдентификаторДанныхМоделирование,НомерТранзакции);
	
КонецПроцедуры // ВыполнитьПоискРешения()

//функция берет максимальное или минимальное значение границы (если они заданы) и проверяет:
//можно ли в принципе достичь целевого значения по заданной границе.
&НаСервере
Функция ЗначениеПринципиальноДостижимо(ТаблицаМоделирования,ТекЗначениеЦелевогоПоказателя)
	
	// Проверим, для всех ли базовых показателей установлены граничные условия
	
	НеобходимоеИзменение=ЦелевойПоказательНовоеЗначение-ТекЗначениеЦелевогоПоказателя;
	
	Для Каждого Строка ИЗ ТаблицаМоделирования Цикл
		
		// Проверим на вхождение целевого значения в установленные границы
		
		Если НЕ ((Строка.ЗначениеМин=0 ИЛИ Строка.ТекущееЗначение>Строка.ЗначениеМин) 
			И (Строка.ЗначениеМакс=0 ИЛИ Строка.ТекущееЗначение<Строка.ЗначениеМакс)) Тогда
			
			СтрокаШаблона = Нстр("ru = 'Некорректно установлены границы:
			|Показатель: %1,
			|ТекущееЗначение: %2,
			|Граница (мин.): %3,
			|Граница (макс.): %4
			|Моделирование отменено.'");
			
			Если Не ПустаяСтрока(СтрокаШаблона) тогда				
				ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(СтрокаШаблона, Строка.показатель, Строка.ТекущееЗначение, Строка.ЗначениеМин, Строка.ЗначениеМакс),,, СтатусСообщения.Внимание);
			КонецЕсли;
						
			Возврат Ложь;
			
		КонецЕсли;
		
		// Проверим на возможное отсутствие границы в предполагаемом направлении изменения показателя
		
		Если НеобходимоеИзменение>0 Тогда
			
			Если (Строка.Градиент>0 И Строка.ЗначениеМакс=0)
				ИЛИ (Строка.Градиент<0 И Строка.ЗначениеМин=0) Тогда // Значение может принимать любое значение, чтобы достигнуть целевого
				
				Возврат Истина;
				
			КонецЕсли;
			
		Иначе
			
			Если (Строка.Градиент>0 И Строка.ЗначениеМин=0)
				ИЛИ (Строка.Градиент<0 И Строка.ЗначениеМакс=0) Тогда // Значение может принимать любое значение, чтобы достигнуть целевого
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверим достижимость значения по установленным границам	
	НомерТранзакции = 99999;
	ДостижимоеЗначение=ПолучитьЗначениеНаГраницах(ТаблицаМоделирования,НеобходимоеИзменение,Ложь,НомерТранзакции);
	
	ЗначениеДостижимо=ДостигнутоЦелевоеЗначение(ДостижимоеЗначение,0.04)
		ИЛИ ((НеобходимоеИзменение>0 И ДостижимоеЗначение>=ЦелевойПоказательНовоеЗначение) ИЛИ (НеобходимоеИзменение<0 И ДостижимоеЗначение<=ЦелевойПоказательНовоеЗначение)); 

	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(ИдентификаторДанныхМоделирование,НомерТранзакции);
	
	Возврат ЗначениеДостижимо;	
	
КонецФункции // ЗначениеПринципиальноДостижимо()

&НаСервере
Функция ДостигнутоЦелевоеЗначение(ТекЗначениеЦелевого,ТекущаяТочность)
	
	Если ЦелевойПоказательНовоеЗначение=0 Тогда
		
		Возврат ТекЗначениеЦелевого=ЦелевойПоказательНовоеЗначение;
		
	Иначе
		
		Возврат ОбщегоНазначенияУХ.ЗначениеПоМодулю((ТекЗначениеЦелевого-ЦелевойПоказательНовоеЗначение)/ЦелевойПоказательНовоеЗначение)<=ТекущаяТочность;
		
	КонецЕсли;
	
КонецФункции // ДостигнутоЦелевоеЗначение

&НаСервере
Функция ПолучитьЗначениеНаГраницах(ТаблицаМоделирования,НеобходимоеИзменение,ПоискЭкстремума,НомерТранзакции)
		
	ТаблицаИзмененныхОтчетов=Новый ТаблицаЗначений;
	ТаблицаИзмененныхОтчетов.Колонки.Добавить("ЭкземплярОтчета");
	ТаблицаИзмененныхОтчетов.Колонки.Добавить("Показатель");
	
		
	Для Каждого БазовыйПоказатель ИЗ ТаблицаМоделирования Цикл
				
		// Установим каждый базовый показатель в необходимое граничное значение	
		Если НЕ БазовыйПоказатель.ЗначениеМакс=0 И  БазовыйПоказатель.Градиент>0 И НеобходимоеИзменение>0 Тогда
				
			УстанавливаемоеЗначение=БазовыйПоказатель.ЗначениеМакс;
							
		ИначеЕсли НЕ БазовыйПоказатель.ЗначениеМин=0 И  БазовыйПоказатель.Градиент<0 И НеобходимоеИзменение>0 Тогда
	
			УстанавливаемоеЗначение=БазовыйПоказатель.ЗначениеМин;
	
		ИначеЕсли НЕ  БазовыйПоказатель.ЗначениеМин=0 И НеобходимоеИзменение<0 И БазовыйПоказатель.Градиент>0 Тогда
 	
			 УстанавливаемоеЗначение=БазовыйПоказатель.ЗначениеМин;
			
		ИначеЕсли НЕ  БазовыйПоказатель.ЗначениеМин=0 И НеобходимоеИзменение<0 И БазовыйПоказатель.Градиент<0 Тогда
 	
			 УстанавливаемоеЗначение=БазовыйПоказатель.ЗначениеМакс;
					
		ИначеЕсли ПоискЭкстремума Тогда
			
			УстанавливаемоеЗначение=?(БазовыйПоказатель.ЗначениеМин=0,БазовыйПоказатель.ЗначениеМакс,БазовыйПоказатель.ЗначениеМин);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		//Устанавливаем значение новое
		//УстановитьЗначениеПоказателя(СтрПоказатель,"Пересчитать",УстанавливаемоеЗначение) Тогда
		СтруктураРасшифровкиКонтекста 	= ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(ПолучитьРасшифровкуПоказателяПоТаблицеСервер(БазовыйПоказатель)); 
		НомерТранзакции = 99999;
		УстановитьЗначениеПоказателя(СтруктураРасшифровкиКонтекста,БазовыйПоказатель.ТекущееЗначение,УстанавливаемоеЗначение,НомерТранзакции);	
		
		Если ПоискЭкстремума Тогда
			
			БазовыйПоказатель.ТекущееЗначение=УстанавливаемоеЗначение;
			
		КонецЕсли;
				
	КонецЦикла;	
			
	Возврат ПолучитьТекущееЗначениеЦелевогоПоказателя(); 
	
КонецФункции // ПолучитьЗначениеНаГраницах()

&НаСервере
Функция ПолучитьТекущееЗначениеЦелевогоПоказателя(Базовый = Истина)
	
	Для Каждого СтрЦелевой Из ТаблицаВыделенныхПоказателейМоделирование Цикл	
		
		Если СтрЦелевой.Базовый = Базовый Тогда			
			Возврат  ПолучитьЗначениеЦелевогоПоказателя(СтрЦелевой,Истина,Неопределено,Истина);		
		КонецЕсли;			
		
	КонецЦикла;	
	
КонецФункции	

&НаСервере
Процедура ОбновитьТаблицуЧувствительности(ТекТаблицаМоделирования)
		
	//Выделенный целевой базовый показатель 
	тЦелевыеПоказатели   = ТаблицаВыделенныхПоказателейМоделирование.Выгрузить().Скопировать(Новый Структура("Базовый",Истина));
		
	//Преобразуем таблицу факторов к нужному виду	
	тПоказателиФакторов  	= ТаблицаЧувствительностиФакторов.Выгрузить().СкопироватьКолонки();
	тПоказателиФакторов.Колонки.Добавить("Значение",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
			
	ТаблицаЧувствительностиФакторовКопия = ТекТаблицаМоделирования.Скопировать(); 
	
	тДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Выгрузить(,"ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	тДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	тДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
    тДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	Для Каждого СтрПересчета Из тДанныеДляПересчета Цикл
		СтрПересчета.ПериодОкончания = ПериодПо;
	КонецЦикла;

	Для Каждого Строка ИЗ ТекТаблицаМоделирования Цикл
		
		Если Не Строка.ОбработкаВыполнена Тогда
			
			ОбработкаРасчета 								= Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса 	= ИдентификаторДанныхМоделирование;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
															
			тРезультат = РассчитатьЧувствительностьПоПоказателю(Строка,ОбработкаРасчета,тЦелевыеПоказатели,тПоказателиФакторов,Строка.ТекущееЗначение);
			
			Если тРезультат.Количество() = 1 Тогда
				Строка.Влияние 	=  тРезультат[0].Влияние;
				Строка.Градиент 	=  тРезультат[0].Градиент;
				Строка.КоэффГрадиента    	=  тРезультат[0].КоэффГрадиента;
			КонецЕсли;	
									
		КонецЕсли;
			
	КонецЦикла;
	
	ТекТаблицаМоделирования.Сортировать("Влияние Убыв");
	
КонецПроцедуры // ОбновитьТаблицуЧувствительности(ТаблицаМоделирования)

&НаСервере
Процедура ВыполнитьГрадиентныйСпуск(СтрокаМоделирования,ТекущаяТочность,ВремяСтарта,НомерТранзакции)
		
	СтрокаМоделирования.ОбработкаВыполнена=Истина;
		
	ТекЗначениеЦелевого=ПолучитьТекущееЗначениеЦелевогоПоказателя();
	НеобходимоеИзменение=ЦелевойПоказательНовоеЗначение-ТекЗначениеЦелевого;
	ТекСходимость=ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
	СходимостьШаг=0;
	
	РасчетВыполнен=Истина;
	ЕстьСходимость=Истина;
	РабочаяТочность=ТекущаяТочность;
	
	Пока ЕстьСходимость Цикл
		
		Если СтрокаМоделирования.Градиент=0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекШагРасчета=НеобходимоеИзменение*СтрокаМоделирования.КоэффГрадиента/СтрокаМоделирования.Градиент;
		
		// Проверим на соответствие граничным условиям
		
		Если ЗначениеЗаполнено(СтрокаМоделирования.ЗначениеМакс) И (СтрокаМоделирования.ТекущееЗначение+ТекШагРасчета)> СтрокаМоделирования.ЗначениеМакс Тогда
			
			ТекШагРасчета=СтрокаМоделирования.ЗначениеМакс-СтрокаМоделирования.ТекущееЗначение;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаМоделирования.ЗначениеМин) И (СтрокаМоделирования.ТекущееЗначение+ТекШагРасчета)< СтрокаМоделирования.ЗначениеМин Тогда
			
			ТекШагРасчета=СтрокаМоделирования.ЗначениеМин-СтрокаМоделирования.ТекущееЗначение;
			
		КонецЕсли;
		
		Если ТекШагРасчета=0 Тогда
			Возврат;
		КонецЕсли;
		
		ЦелевоеЗначениеСШагом = 0;
		
		СтруктураРасшифровкиКонтекста 	= ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(ПолучитьРасшифровкуПоказателяПоТаблицеСервер(СтрокаМоделирования)); 

		ЦелевоеЗначениеСШагом=РассчитатьРезультирующееЗначениеЦелевогоПоказателя(СтруктураРасшифровкиКонтекста,СтрокаМоделирования.ТекущееЗначение,СтрокаМоделирования.ТекущееЗначение+ТекШагРасчета);
		
		НеобходимоеИзменение=ЦелевойПоказательНовоеЗначение-ЦелевоеЗначениеСШагом;
		
		Если (Не РасчетВыполнен) Тогда
			
			Возврат;
			
		ИначеЕсли ДостигнутоЦелевоеЗначение(ЦелевоеЗначениеСШагом,РабочаяТочность)Тогда
			
			СтрокаМоделирования.Градиент=((ЦелевоеЗначениеСШагом-ТекЗначениеЦелевого)/ТекШагРасчета)*СтрокаМоделирования.КоэффГрадиента;	
			СтрокаМоделирования.ТекущееЗначение=СтрокаМоделирования.ТекущееЗначение+ТекШагРасчета;
			
			ТекВремяВыполнения=ТекущаяДата();
			
			Если (ТекВремяВыполнения-ВремяСтарта)<60 И (НЕ РабочаяТочность=0.01) Тогда // Проведем поиск по более высокой точности
				
				РабочаяТочность=РабочаяТочность/2;
				ВыполнитьГрадиентныйСпуск(СтрокаМоделирования,РабочаяТочность,ВремяСтарта,НомерТранзакции);
				Возврат;
				
			Иначе
				
				Возврат;
				
			КонецЕсли;
			
		ИначеЕсли (Не СходимостьШаг=0) И ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение)>=СходимостьШаг Тогда // Достигнут предел сходимости
			
			Возврат;
			
		Иначе
			
			СтрокаМоделирования.Градиент=((ЦелевоеЗначениеСШагом-ТекЗначениеЦелевого)/ТекШагРасчета)*СтрокаМоделирования.КоэффГрадиента;
			СтрокаМоделирования.ТекущееЗначение=СтрокаМоделирования.ТекущееЗначение+ТекШагРасчета;
			
		КонецЕсли;
		
		// Определим текущее значение градиента
		
		ТекСходимость=ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
		ТекЗначениеЦелевого=ЦелевоеЗначениеСШагом;
		СходимостьШаг=ОбщегоНазначенияУХ.ЗначениеПоМодулю(НеобходимоеИзменение);
						
	КонецЦикла;
			
КонецПроцедуры // ВыполнитьГрадиентныйСпуск()

&НаСервере
Функция РассчитатьРезультирующееЗначениеЦелевогоПоказателя(СтруктураРасшифровкиКонтекста,ТекущееЗначение,УстанавливаемоеЗначение,НомерТранзакции=0,Базовый=Истина)
		
	НомерТранзакции = 99999;
	УстановитьЗначениеПоказателя(СтруктураРасшифровкиКонтекста,ТекущееЗначение,УстанавливаемоеЗначение,НомерТранзакции);	

	НовоеЗначение = ПолучитьТекущееЗначениеЦелевогоПоказателя(Базовый);
	
	Возврат НовоеЗначение;
	
КонецФункции	

&НаСервере
Процедура СохранитьЗначенияМоделирования(ТекТаблицаМоделирования,ПоискЭкстремума=Ложь,ДостигнутоеЗначениеЦелевого)
	
	МассивПоказателей=Новый Массив;
	
	Для Каждого Строка ИЗ ТекТаблицаМоделирования Цикл
		
		Если Строка.ТекущееЗначение=Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Строка.СтрокаТаблицыЧувствительности.ЗначениеДляЛогаИзменений 					= Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование;
		Строка.СтрокаТаблицыЧувствительности.ЗначениеМоделирование						= Строка.ТекущееЗначение;
		Строка.СтрокаТаблицыЧувствительности.ПризнакИзменения 							= Истина;
		
		ПересчитатьКонечнуюСуммуИОтклоненияСервер(Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование,Строка.СтрокаТаблицыЧувствительности);	
		
	КонецЦикла;
		
	Если НЕ ПоискЭкстремума Тогда
		
		СтрокаШаблона = Нстр("ru = 'Моделирование выполнено. Достигнуто целевое значение %1'");
		
		ТекстСообщения= "";
		Если Не ПустаяСтрока(СтрокаШаблона) тогда				
			ТекстСообщения = СтрШаблон(СтрокаШаблона, Формат(ДостигнутоеЗначениеЦелевого,"ЧЦ=18; ЧДЦ=5"));
		КонецЕсли;
		
		Если НЕ (ЦелевойПоказательНовоеЗначение=0 ИЛИ ДостигнутоЦелевоеЗначение(ДостигнутоеЗначениеЦелевого,0.02)) Тогда
			
			ТочностьМоделирования=ОбщегоНазначенияУХ.ЗначениеПоМодулю((ЦелевойПоказательНовоеЗначение-ДостигнутоеЗначениеЦелевого)/ЦелевойПоказательНовоеЗначение)*100;
			
			СтрокаШаблона = Нстр("ru = '
			|Отклонение от заданного значения %1 = %2 %%.
			|Для повышения точности выберите другие базовые показатели или измените граничные условия.'");
			
			Если Не ПустаяСтрока(СтрокаШаблона) тогда				
				ТекстСообщения = ТекстСообщения + СтрШаблон(СтрокаШаблона, Формат(ЦелевойПоказательНовоеЗначение,"ЧЦ=18; ЧДЦ=5"), Формат(ТочностьМоделирования,"ЧЦ=10; ЧДЦ=2"));
			КонецЕсли;
						
		КонецЕсли;	
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Информация);
		
		ЦелевойПоказательНовоеЗначение=ДостигнутоеЗначениеЦелевого;
		
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоказателяПоДополнительнойЦели(СтрокаЦелевой,Строка,ВключатьДанныеМодели)
	
	СтруктураРасшифровки = Новый Структура;
	
	//Преобразуем строку с аналитиками к инлексам группы раскрытия
	тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Строка.Показатель);
	ПреобразоватьИндексыАналитик(Строка,тКэшАналитикПоказателей);
	
	СтруктураРасшифровки.Вставить("Показатель",Строка.Показатель);
	СтруктураРасшифровки.Вставить("Сценарий",СтрокаЦелевой.Сценарий);
    СтруктураРасшифровки.Вставить("Организация",СтрокаЦелевой.Организация);
	СтруктураРасшифровки.Вставить("ПериодОтчета",Строка.ПериодОтчета);

	СтруктураРасшифровки.Вставить("Проект",Строка.Проект);
    СтруктураРасшифровки.Вставить("Валюта",ВалютаОтображения);
	Для Инд=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		 СтруктураРасшифровки.Вставить("Аналитика"+Инд,Строка["Аналитика"+Инд]);
	КонецЦикла;	
		
	Возврат ПолучитьТекущееЗначениеПоказателя(СтруктураРасшифровки,ВключатьДанныеМодели);
	
КонецФункции	

