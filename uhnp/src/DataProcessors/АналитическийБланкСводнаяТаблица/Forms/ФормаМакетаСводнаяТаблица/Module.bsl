	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьДанныеМоделирования()

    РасчетПоказателейОбъект = Обработки.РасчетИЗаписьПоказателей.Создать();
	РасчетПоказателейОбъект.УникальныйИдентификаторСеанса = ИдентификаторДанныхМоделирование;
	РасчетПоказателейОбъект.ЗаписатьЛогИзмененныхПоказателей();
	ОбновитьДанныеТаблицыФакторов();
	
КонецПроцедуры	


&НаСервере
Процедура ОчиститьДанныеМодели();

	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(ИдентификаторДанныхМоделирование);
	НарисоватьТаблицуСервер();
    ОбновитьДанныеТаблицыФакторов();
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьДанныеТаблицыФакторов();

	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл
		
		СтруктураРаскрываемыхАналитик = Новый Структура;
		СтруктураОтбираемыхАналитик   = ПолучитьРасшифровкуПоказателяПоТаблицеСервер(Стр);
		
		МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить(СтруктураОтбираемыхАналитик.Показатель);
		
		СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
	
		БазовоеЗначение 					= ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,Ложь);	
		Если БазовоеЗначение.Количество() = 1 Тогда
			 Стр.БазовоеЗначение = БазовоеЗначение[0].Значение;
		КонецЕсли;	
		
		Стр.ЗначениеМоделирование 				= Стр.БазовоеЗначение;
		
		ПересчитатьКонечнуюСуммуИОтклоненияСервер(Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование,Стр);
		
		Стр.КомментарийКСтроке = "";
		
	КонецЦикла;	

КонецПроцедуры	

&НаСервере
Процедура УстановитьРежимМоделирования() 
	
	Элементы.ГруппаДанныеМодели.Видимость         	= РежимМоделирования;
	Элементы.ГруппаПрименитьОтменить.Видимость      = НЕ РежимМоделирования;
	Элементы.ГруппаАнализИМоделирование.Видимость 	= РежимМоделирования;
	Элементы.КомандыАнализаМоделирования.Видимость 	= РежимМоделирования;
	Элементы.КомандыРежимаРаботыСДанными.Видимость 	= НЕ РежимМоделирования;
	Элементы.Бланк.Видимость                       	= НЕ РежимМоделирования;
	Элементы.ПоказатьСоставСтрок.Видимость         	= РежимМоделирования;
	Элементы.кмКомандыРаботыСРедактированиемЗначений.Видимость = НЕ РежимМоделирования;
	Элементы.ПоказатьНастройкуСоставаАналитики.Видимость = Ложь;
	
	Элементы.РежимРаботы.Видимость                 = НЕ РежимМоделирования;
	Элементы.ВариантСводнойТаблицы.Видимость       = НЕ РежимМоделирования;	
	Элементы.СброситьНастройки.Видимость           = НЕ РежимМоделирования;
	Элементы.Дополнительно.Видимость               = НЕ РежимМоделирования;
		
	Элементы.СохранитьТекущийВариантТаблицы.Заголовок = ?(РежимМоделирования
	,Нстр("ru = 'Сохранить текущий вариант анализа'")
	,Нстр("ru = 'Сохранить текущий вариант таблицы'"));
	
	Элементы.СохранитьТекущийВариантТаблицыКак.Заголовок = ?(РежимМоделирования
	,Нстр("ru = 'Сохранить текущий вариант анализа как...'")
	,Нстр("ru = 'Сохранить текущий вариант таблицы как...'"));

	Элементы.ВариантыПодменю.Заголовок  = ?(РежимМоделирования
	,Нстр("ru = 'Варианты анализа'")
	,Нстр("ru = 'Варианты таблицы'"));
	
	Элементы.ЗагрузитьВариантТаблицы.Видимость = РежимМоделирования;
	
	Элементы.кмКомандыРаботыСРедактированиемЗначений.Видимость 	= НЕ РежимМоделирования;
	Элементы.кмРежимМоделирования.Видимость 					= РежимМоделирования;

	Если Не ЗначениеЗаполнено(РежимыАнализаИМоделирования) Тогда
		РежимыАнализаИМоделирования = Перечисления.РежимыАнализаИМоделирования.ФакторныйАнализДиаграмма;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ВариантСводнойТаблицы) Тогда
		 ИдентификаторДанныхМоделирование = Новый УникальныйИдентификатор;
	КонецЕсли;	
	
	Если ЗначениеЗАполнено(ВариантСводнойТаблицы) Тогда
		МодельРежимРедактирования = МодельРедактируется(ВариантСводнойТаблицы); 
		УстановитьДоступностьЭлементовРежимаРедактированияМодели();
		Элементы.Модель_ПерейтиВРежимРедактирования.Пометка = МодельРежимРедактирования;
	КонецЕсли;
				
	УстановитьВидРежимаМоделирования();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидРежимаМоделирования() 
	
	Элементы.УстановитьДополнительныйПоказатель.Доступность 											= Ложь;
	Элементы.ПолеТабличногоДокументаМакетКонтекстноеМенюУстановитьДополнительныйПоказатель.Доступность 	=Ложь;
	ОбновитьПанельЦелевыхПоказателей();
	
	Если РежимыАнализаИМоделирования = Перечисления.РежимыАнализаИМоделирования.ФакторныйАнализДиаграмма Тогда
		
		ВывестиДеревоФакторов();
		
	ИначеЕсли РежимыАнализаИМоделирования = Перечисления.РежимыАнализаИМоделирования.ФакторныйАнализТаблица Тогда
		
		Если ТаблицаВыделенныхПоказателейМоделирование.Количество() = 0 Тогда
			
			Элементы.ГруппаАнализВлияния.ТекущаяСтраница = Элементы.ГруппаВлияниеОшибка;
			ПолеТабличногоДокументаАнализГрафический.Очистить();
			УстановитьСостояниеНеИспользоватьДляТекущегоРежима(НСтр("ru = 'Выделите целевой показатель для анализа в таблице сверху'"),2);
			
		Иначе	
			
			Элементы.ГруппаАнализВлияния.ТекущаяСтраница = Элементы.ГруппаТаблицаВлияния;	
			
		КонецЕсли;	
		
		УстановитьВидимостьКолонокТаблицыФакторов();
						
	ИначеЕсли РежимыАнализаИМоделирования = Перечисления.РежимыАнализаИМоделирования.ФакторныйАнализВодопад Тогда	
			
		ВывестиДиаграммуВодопад();
		
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеНеИспользоватьДляТекущегоРежима(ТекстСообщения,Режим)
		
	Если Режим = 1 Тогда
		
		ОтображениеСостояния = Элементы.ПолеТабличногоДокументаАнализ.ОтображениеСостояния;
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = ТекстСообщения;
		
