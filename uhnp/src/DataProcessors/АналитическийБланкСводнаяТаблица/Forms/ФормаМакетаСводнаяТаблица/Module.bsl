&НаСервере
Процедура ПересчитатьКонечнуюСуммуИОтклоненияСервер(Элемент,тСтрокаТаблицы)
		 
	 Если Элемент = Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС Тогда
		 
		 тСтрокаТаблицы.ЗначениеМоделирование  = тСтрокаТаблицы.БазовоеЗначение+тСтрокаТаблицы.ОтклонениеАБС;
		 Если тСтрокаТаблицы.БазовоеЗначение = 0 Тогда
			 тСтрокаТаблицы.ОтклонениеОтн = 0; 
		 Иначе	 
			 тСтрокаТаблицы.ОтклонениеОтн  = ((тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение)/тСтрокаТаблицы.БазовоеЗначение)*100;
		 КонецЕсли;	 
			 
	 ИначеЕсли Элемент = Элементы.ТаблицаЧувствительностиФакторовОтклонениеОтн Тогда
		 
		 тСтрокаТаблицы.ЗначениеМоделирование  = тСтрокаТаблицы.БазовоеЗначение+тСтрокаТаблицы.БазовоеЗначение*(тСтрокаТаблицы.ОтклонениеОтн/100);
         тСтрокаТаблицы.ОтклонениеАБС  = тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение;
		 
	 ИначеЕсли Элемент = Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование Тогда
		 
		 тСтрокаТаблицы.ОтклонениеАБС  = тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение;
		 Если тСтрокаТаблицы.БазовоеЗначение = 0 Тогда
			 тСтрокаТаблицы.ОтклонениеОтн = 0; 
		 Иначе	 
			 тСтрокаТаблицы.ОтклонениеОтн  = ((тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение)/тСтрокаТаблицы.БазовоеЗначение)*100;
		 КонецЕсли;	
		 		 		 
	 КонецЕсли;
	 
	 	 
КонецПроцедуры	


#Область РаботаСПанельюЦелевыхПоказателей

&НаКлиенте
Процедура ПересчитатьКонечнуюСуммуИОтклоненияПанельЦелевых(Элемент)
		
	 Если Элемент = Элементы.ЦелевойПоказательАсболютноеОтклонение Тогда
		 
		 ЦелевойПоказательЗначениеМоделирование  = ЦелевойПоказательЗначениеИсходное+ЦелевойПоказательАсболютноеОтклонение;
		 Если ЦелевойПоказательЗначениеИсходное = 0 Тогда
			 ЦелевойПоказательОтносительноеОтклонение = 0; 
		 Иначе	 
			 ЦелевойПоказательОтносительноеОтклонение  = ((ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное)/ЦелевойПоказательЗначениеИсходное)*100;
		 КонецЕсли;	 
			 
	 ИначеЕсли Элемент = Элементы.ЦелевойПоказательОтносительноеОтклонение Тогда
		 
		 ЦелевойПоказательЗначениеМоделирование  	= ЦелевойПоказательЗначениеИсходное+ЦелевойПоказательЗначениеИсходное*(ЦелевойПоказательОтносительноеОтклонение/100);
         ЦелевойПоказательАсболютноеОтклонение 		= ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное;
		 
	 ИначеЕсли Элемент = Элементы.ЦелевойПоказательЗначениеМоделирование Тогда
		 
		 ЦелевойПоказательАсболютноеОтклонение  	= ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное;
		 Если ЦелевойПоказательЗначениеИсходное = 0 Тогда
			 ЦелевойПоказательОтносительноеОтклонение = 0; 
		 Иначе	 
			 ЦелевойПоказательОтносительноеОтклонение  = ((ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное)/ЦелевойПоказательЗначениеИсходное)*100;
		 КонецЕсли;	
		 		 		 
	 КонецЕсли;
	 	 	 
КонецПроцедуры	

&НаСервере
Процедура ОбновитьПанельЦелевыхПоказателей()
			
	ЦелевойПоказательПредставление 				= Нстр("ru = 'Целевой показатель не выбран:'");
	ЦелевойПоказательЗначениеИсходное      		= 0;
	ЦелевойПоказательЗначениеМоделирование  	= 0;
	ЦелевойПоказательОтносительноеОтклонение    = 0;
	ЦелевойПоказательАсболютноеОтклонение    	= 0;
	
	ФлЦелевого = Ложь;
	Для Каждого СтрЦелевой Из ТаблицаВыделенныхПоказателейМоделирование Цикл	
		
		МассивПериодов = Неопределено;
		Если  НЕ СтрЦелевой.ПериодОтчета.Периодичность = ПериодС.Периодичность Тогда
			МассивПериодов = ПолучитьПериодыПотомки(СтрЦелевой.ПериодОтчета,ПериодС.Периодичность);
		КонецЕсли;	
				
		СтрЦелевой.Значение    			= ПолучитьЗначениеЦелевогоПоказателя(СтрЦелевой,Ложь,МассивПериодов,Истина);
		СтрЦелевой.ЗначениеМодель    	= ПолучитьЗначениеЦелевогоПоказателя(СтрЦелевой,Истина,МассивПериодов,Истина);
		
		Если СтрЦелевой.Базовый Тогда	
			ЦелевойПоказательПредставление 			= Нстр("ru = 'Целевой показатель:'")+Строка(СтрЦелевой.Показатель)+" "+СтрЦелевой.ПериодОтчета;
			ЦелевойПоказательЗначениеИсходное      	= СтрЦелевой.Значение;
			ЦелевойПоказательЗначениеМоделирование  = СтрЦелевой.ЗначениеМодель;
			ПересчитатьКонечнуюСуммуИОтклоненияПанельЦелевыхСервер(Элементы.ЦелевойПоказательЗначениеМоделирование);		
			ФлЦелевого = Истина;
		КонецЕсли;			
		
	КонецЦикла;	
	
	Элементы.ГруппаЦелевойИндикаторы.Видимость 					= ФлЦелевого; 
	Элементы.ГруппаАнализИМоделированиеСтраницы.Доступность 	= ФлЦелевого;
	Элементы.ЦелевойПоказательПредставление.ЦветТекста = ?(ФлЦелевого,Новый Цвет(0,0,255),Новый Цвет(255,0,0));
	
	Элементы.УстановитьДополнительныйПоказатель.Доступность     = ФлЦелевого;
	Элементы.СнятьВыделениеПоказателей.Доступность              = ФлЦелевого;
	Элементы.ПолеТабличногоДокументаМакетКонтекстноеМенюУстановитьДополнительныйПоказатель.Доступность = ФлЦелевого;
	Элементы.ПолеТабличногоДокументаМакетКонтекстноеМенюСнятьВыделениеПоказателей.Доступность = ФлЦелевого;

	
КонецПроцедуры	

&НаСервере
Процедура ПересчитатьКонечнуюСуммуИОтклоненияПанельЦелевыхСервер(Элемент)
		
	 Если Элемент = Элементы.ЦелевойПоказательАсболютноеОтклонение Тогда
		 
		 ЦелевойПоказательЗначениеМоделирование  = ЦелевойПоказательЗначениеИсходное+ЦелевойПоказательАсболютноеОтклонение;
		 Если ЦелевойПоказательЗначениеИсходное = 0 Тогда
			 ЦелевойПоказательОтносительноеОтклонение = 0; 
		 Иначе	 
			 ЦелевойПоказательОтносительноеОтклонение  = ((ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное)/ЦелевойПоказательЗначениеИсходное)*100;
		 КонецЕсли;	 
			 
	 ИначеЕсли Элемент = Элементы.ЦелевойПоказательОтносительноеОтклонение Тогда
		 
		 ЦелевойПоказательЗначениеМоделирование  	= ЦелевойПоказательЗначениеИсходное+ЦелевойПоказательЗначениеИсходное*(ЦелевойПоказательОтносительноеОтклонение/100);
         ЦелевойПоказательАсболютноеОтклонение 		= ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное;
		 
	 ИначеЕсли Элемент = Элементы.ЦелевойПоказательЗначениеМоделирование Тогда
		 
		 ЦелевойПоказательАсболютноеОтклонение  	= ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное;
		 Если ЦелевойПоказательЗначениеИсходное = 0 Тогда
			 ЦелевойПоказательОтносительноеОтклонение = 0; 
		 Иначе	 
			 ЦелевойПоказательОтносительноеОтклонение  = ((ЦелевойПоказательЗначениеМоделирование-ЦелевойПоказательЗначениеИсходное)/ЦелевойПоказательЗначениеИсходное)*100;
		 КонецЕсли;	
		 		 		 
	 КонецЕсли;
	 	 	 
КонецПроцедуры	

#КонецОбласти

#Область РаботаСФиксаторамиЦелевыхПоказателей

&НаКлиенте
Процедура УстановитьБазовыйПоказатель(Команда)
		
	тМакет 										= ПолеТабличногоДокументаМакет;
	ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];

	Если НЕ ЗначениеЗаполнено(ТекущаяОбластьРасшифровка.Расшифровка) ИЛИ НЕ ТекущаяОбластьРасшифровка.Расшифровка.Свойство("Ссылка")  Тогда	
		ПоказатьОповещениеПользователя(Нстр("ru = 'Необходимо выделить область показателя'"),, Нстр("ru = 'Необходимо выделить область показателя'"), БиблиотекаКартинок.Внимание16);
		Возврат;
	КонецЕсли;
	
	УстановитьБазовыйПоказательВТаблице();
	ПоказатьПротокол();
	
КонецПроцедуры	


&НаКлиенте
Процедура УстановитьБазовыйПоказательВТаблице() 
	
	Если НЕ Элементы.УстановитьБазовыйПоказатель.Пометка Тогда  //Выделяем новый показатель
		СнятьВыделениеПоказателейИУстановитьНовый();
	Иначе		
		СнятьВыделениеПоказателей(Неопределено);		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДополнительныйПоказатель(Команда)
	
	тМакет 										= ПолеТабличногоДокументаМакет;
	ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];

	Если НЕ ЗначениеЗаполнено(ТекущаяОбластьРасшифровка.Расшифровка) ИЛИ НЕ ТекущаяОбластьРасшифровка.Расшифровка.Свойство("Ссылка")  Тогда	
		ПоказатьОповещениеПользователя(Нстр("ru = 'Необходимо выделить область показателя'"),, Нстр("ru = 'Необходимо выделить область показателя'"), БиблиотекаКартинок.Внимание16);
		Возврат;
	КонецЕсли;
	
	СтруктураРасшифровки 						= ПолучитьРасшифровкуВРазрезеИндексовАналитик(ТекущаяОбластьРасшифровка.Расшифровка,ТекущаяОбластьРасшифровка.Имя);
	
	//Дополнительный показатель для факторного анаиза должен быть тот же, что и базовый
	тБазовыйПоказатель = ТаблицаВыделенныхПоказателейМоделирование.НайтиСтроки(Новый Структура("Показатель,Базовый",СтруктураРасшифровки.ПоказательСсылка,Истина));
	Если тБазовыйПоказатель.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(Нстр("ru = 'Дополнительный показатель не должен отличаться от базового'"),, Нстр("ru = 'Дополнительный показатель не должен отличаться от базового'"), БиблиотекаКартинок.Внимание16);
	Иначе	
		УстановитьДополнительныйПоказательВТаблице(); 
	КонецЕсли;	
	
	ПоказатьПротокол();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДополнительныйПоказательВТаблице() 
	
	Если НЕ Элементы.УстановитьДополнительныйПоказатель.Пометка Тогда  //Выделяем новый показатель
		СнятьВыделениеДопПоказателеяИУстановитьНовый();
	Иначе		
		СнятьВыделениеДопПоказателя();		
	КонецЕсли;
			
КонецПроцедуры




&НаКлиенте
Процедура ВыделитьВыбранныйПоказатель(тОбласть,Базовый = Ложь)
	
	Если Базовый Тогда
		тОбласть.Картинка = БиблиотекаКартинок.ВыделитьБазовыйПоказатель;
	Иначе	
		тОбласть.Картинка = БиблиотекаКартинок.ВыделитьДополнительныйПоказатель;
	КонецЕсли;
	
	тОбласть.ПоложениеТекстаОтносительноКартинки = ПоложениеТекстаОтносительноКартинки.Слева; 
	тОбласть.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Право;
	тОбласть.Шрифт = Новый Шрифт(тОбласть.Шрифт,,10);
	тОбласть.РазмерКартинки =  РазмерКартинки.РеальныйРазмер;	
	
	ЦветЛинии	= Новый Цвет(128,128,128);
	Линия		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,3);
	Линия1		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);

	тОбласть.Обвести(Линия1,Линия1,Линия,Линия);
	тОбласть.ЦветРамки  = ЦветЛинии;
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеВыбранногоПоказателя(тОбласть)
	
	тОбласть.Картинка = Неопределено;
	тОбласть.Шрифт = Новый Шрифт(тОбласть.Шрифт,,8);
	
	ЦветЛинии	= Новый Цвет(230,230,230);
	Линия		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	тОбласть.Обвести(Линия,Линия,Линия,Линия);
	тОбласть.ЦветРамки  = ЦветЛинии;
	
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеПоказателей(Команда)
		
	Если ТаблицаВыделенныхПоказателейМоделирование.Количество() >0 Тогда	
		Оповещение = Новый ОписаниеОповещения("СнятьВыделениеЦелевыхПоказателейЗавершение",ЭтаФорма);
		ПоказатьВопрос(Оповещение, Нстр("ru = 'Текущие данные анализа целевых показателей будут очищены, продолжить?'"), РежимДиалогаВопрос.ДаНет);			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеЦелевыхПоказателейЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если  Результат = КодВозвратаДиалога.Да  Тогда	
		
		Для Каждого СтрПоказатель Из ТаблицаВыделенныхПоказателейМоделирование Цикл
			
			СнятьВыделениеВыбранногоПоказателяСервер(СтрПоказатель.ИмяОбласти);
			
		КонецЦикла;	
			
		ТаблицаВыделенныхПоказателейМоделирование.Очистить();
		ТаблицаЧувствительностиФакторов.Очистить();
		УстановитьВидРежимаМоделирования();
		Элементы.УстановитьБазовыйПоказатель.Пометка = Ложь;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеПоказателейИУстановитьНовый()
		
	Если ТаблицаВыделенныхПоказателейМоделирование.Количество() >0 Тогда	
		Оповещение = Новый ОписаниеОповещения("СнятьВыделениеЦелевыхПоказателейИУстановитьНовыйЗавершение",ЭтаФорма);
		ПоказатьВопрос(Оповещение, Нстр("ru = 'Текущие данные анализа целевых показателей будут очищены, продолжить?'"), РежимДиалогаВопрос.ДаНет);			
	Иначе	
		СнятьВыделениеЦелевыхПоказателейИУстановитьНовыйЗавершение(КодВозвратаДиалога.Да, Неопределено);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеЦелевыхПоказателейИУстановитьНовыйЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если  Результат = КодВозвратаДиалога.Да  Тогда	
		
		Для Каждого СтрПоказатель Из ТаблицаВыделенныхПоказателейМоделирование Цикл
			
			СнятьВыделениеВыбранногоПоказателяСервер(СтрПоказатель.ИмяОбласти);
			
		КонецЦикла;	
		
		тМакет 										= ПолеТабличногоДокументаМакет;
		ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];		
		СтруктураРасшифровки 						= ПолучитьРасшифровкуВРазрезеИндексовАналитик(ТекущаяОбластьРасшифровка.Расшифровка,ТекущаяОбластьРасшифровка.Имя);
		
		ТаблицаВыделенныхПоказателейМоделирование.Очистить();
		ТаблицаЧувствительностиФакторов.Очистить();
		ДобавитьПоказательВТаблицуФакторногоАнализа(СтруктураРасшифровки,ТекущаяОбластьРасшифровка.Имя,Истина);
		ВыделитьВыбранныйПоказатель(ТекущаяОбластьРасшифровка,Истина);
		Элементы.УстановитьБазовыйПоказатель.Пометка = Истина;
		УстановитьВидРежимаМоделирования();
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеДопПоказателеяИУстановитьНовый()
	
	Для Каждого СтрПоказатель Из ТаблицаВыделенныхПоказателейМоделирование Цикл
		Если Не СтрПоказатель.Базовый Тогда
			СнятьВыделениеВыбранногоПоказателяСервер(СтрПоказатель.ИмяОбласти);
			УдаляемаяСтрока = ТаблицаВыделенныхПоказателейМоделирование.Индекс(СтрПоказатель);
		КонецЕсли;
	КонецЦикла;	
	
	Если Не УдаляемаяСтрока = Неопределено Тогда 
		ТаблицаВыделенныхПоказателейМоделирование.Удалить(УдаляемаяСтрока);
	КонецЕсли;
	
	тМакет 										= ПолеТабличногоДокументаМакет;
	ТекущаяОбластьРасшифровка  					= тМакет.ВыделенныеОбласти[0];		
	СтруктураРасшифровки 						= ПолучитьРасшифровкуВРазрезеИндексовАналитик(ТекущаяОбластьРасшифровка.Расшифровка,ТекущаяОбластьРасшифровка.Имя);
	
	ДобавитьПоказательВТаблицуФакторногоАнализа(СтруктураРасшифровки,ТекущаяОбластьРасшифровка.Имя,Ложь);
	ВыделитьВыбранныйПоказатель(ТекущаяОбластьРасшифровка,Ложь);
	Элементы.УстановитьДополнительныйПоказатель.Пометка = Истина;
	УстановитьВидРежимаМоделирования();
	
		
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеДопПоказателя()
	
	Для Каждого СтрПоказатель Из ТаблицаВыделенныхПоказателейМоделирование Цикл
		Если Не СтрПоказатель.Базовый Тогда
			СнятьВыделениеВыбранногоПоказателяСервер(СтрПоказатель.ИмяОбласти);
			УдаляемаяСтрока = ТаблицаВыделенныхПоказателейМоделирование.Индекс(СтрПоказатель);
		КонецЕсли;
	КонецЦикла;	
	
	Если Не УдаляемаяСтрока = Неопределено Тогда 
		ТаблицаВыделенныхПоказателейМоделирование.Удалить(УдаляемаяСтрока);
	КонецЕсли;
	
	Элементы.УстановитьДополнительныйПоказатель.Пометка = Ложь;
	УстановитьВидРежимаМоделирования();
	
КонецПроцедуры

&НаСервере
Процедура ВыделитьВыбранныйПоказательСервер(тОбласть,Базовый = Ложь)
	
	Если Базовый Тогда
		тОбласть.Картинка = БиблиотекаКартинок.ВыделитьБазовыйПоказатель;
	Иначе	
		тОбласть.Картинка = БиблиотекаКартинок.ВыделитьДополнительныйПоказатель;
	КонецЕсли;	
	тОбласть.ПоложениеТекстаОтносительноКартинки = ПоложениеТекстаОтносительноКартинки.Слева; 
	тОбласть.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Право;
	тОбласть.Шрифт = Новый Шрифт(тОбласть.Шрифт,,10);
	тОбласть.РазмерКартинки =  РазмерКартинки.РеальныйРазмер;	
	
	ЦветЛинии	= Новый Цвет(128,128,128);
	Линия		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,3);
	Линия1		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);

	тОбласть.Обвести(Линия1,Линия1,Линия,Линия);
	тОбласть.ЦветРамки  = ЦветЛинии;
		
КонецПроцедуры

&НаСервере
Процедура СнятьВыделениеВыбранногоПоказателяСервер(тОбластьИмя)
	
	тОбласть = ПолеТабличногоДокументаМакет.Область(тОбластьИмя);
	
	тОбласть.Картинка = Неопределено;
	тОбласть.Шрифт = Новый Шрифт(тОбласть.Шрифт,,8);
	
	ЦветЛинии	= Новый Цвет(230,230,230);
	Линия		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	тОбласть.Обвести(Линия,Линия,Линия,Линия);
	тОбласть.ЦветРамки  = ЦветЛинии;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоказательВТаблицуФакторногоАнализа(СтруктураРасшифровки,ИмяОбласти,Базовый = Ложь)
	
	НстрПоказатель 				= ТаблицаВыделенныхПоказателейМоделирование.Добавить();
	ЗаполнитьЗначенияСвойств(НстрПоказатель,СтруктураРасшифровки);
	НстрПоказатель.Показатель 	= СтруктураРасшифровки.ПоказательСсылка;
	НстрПоказатель.Базовый		= Базовый;
	НстрПоказатель.ИмяОбласти 	= ИмяОбласти;
		
КонецПроцедуры 

&НаСервере
Функция ПолучитьРасшифровкуВРазрезеИндексовАналитик(Расшифровка,ОбластьИмя)
	
	СтруктураНезаполненныхАналитик 	= Новый Структура;
	СтруктураОтбираемыхАналитик 	= Новый Структура;
	ТекущийОбъектАБ                 = "ОбъектАналитическогоБланка";
	ТекущийМакет                    = "ПолеТабличногоДокументаМакет";	
				
	Если  Расшифровка.Свойство("Ссылка") Тогда	
		
		СтруктураРасшифровки = 	ПолучитьСтруктуруРасшифровки(ОбластьИмя,Расшифровка,СтруктураНезаполненныхАналитик,СтруктураОтбираемыхАналитик);
		
		ОбработкаОбъект 						= Обработки.ЗаписьПоказателяСРасчетомЗависимых.Создать();
		оТаблицаИзмененныхПоказателей 			= ОбработкаОбъект.ТаблицаИзмененныхПоказателей.Выгрузить();
		оТаблицаИзмененныхПоказателей.Колонки.Добавить("ID");
		ФлагОшибки = Ложь;	
		КэшАналитикПоказателей  = ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.КэшАналитикПоказателейАдрес);
		
		АналитическийБланкУХСервер.ЗаписатьЗначениеВПоказатель(оТаблицаИзмененныхПоказателей,,"",СтруктураРасшифровки,КэшАналитикПоказателей,ФлагОшибки,ТекущийДелитель);
				
		КэшАналитикПоказателейТекущий = КэшАналитикПоказателей.Скопировать(Новый Структура("Показатель",СтруктураРасшифровки.ПоказательСсылка)); 
		
		Для Каждого Стр Из оТаблицаИзмененныхПоказателей Цикл
			
			Для Инд=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				Если Не КэшАналитикПоказателейТекущий[0]["ВидАналитики"+Инд] = Null Тогда
					СтруктураРасшифровки.Вставить("Аналитика"+Инд,Стр["Аналитика"+Инд]);
				КонецЕсли;	
			КонецЦикла;	
		
		КонецЦикла;	
		
		Возврат СтруктураРасшифровки;
		
	Иначе	
		 Возврат Неопределено
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ВосстановитьВыделенныеОбласти()
	
	Если ТаблицаВыделенныхПоказателейМоделирование.Количество() = 0 Тогда
		 Возврат;
	КонецЕсли;	
	
	//Обновим значение целевого показателя в информ. панели
	ОбновитьПанельЦелевыхПоказателей();	
	
	//Обновим картинку выделенного показателя в таблице, если нашли
	тОбъект 						= ПолучитьСвойстваТекущегоОбъектаСервер();
	КэшАналитикПоказателей		 	= ПолучитьИзВременногоХранилища(ОбъектАналитическогоБланка.КэшАналитикПоказателейАдрес);
	
	Для ИндСтроки = 2 По ПолеТабличногоДокументаМакет.ВысотаТаблицы Цикл
				
		Для ИндКолонки  = 2 По ПолеТабличногоДокументаМакет.ШиринаТаблицы Цикл
			
			 тОбласть = ПолеТабличногоДокументаМакет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки);
			 Если ТипЗнч(тОбласть.Расшифровка)=Тип("Структура") 
				 И тОбласть.Расшифровка.Свойство("Ссылка") Тогда 
				 
				 Для Каждого СтрПоказатель Из ТаблицаВыделенныхПоказателейМоделирование Цикл
					 //Проверяем показатель
					 Если НЕ тОбласть.Расшифровка.Ссылка = СтрПоказатель.Показатель Тогда 
						  Продолжить;
					 КонецЕсли;
					 
					 тСтруктураРасшифровкиПоказателя = Новый Структура; 
					 ЗаполнитьЗначенияРасшифровкиПоТекущемуКонтекстуСервер(тОбласть,тСтруктураРасшифровкиПоказателя);
					  
					 ОбластьИмя 			=  тОбласть.Имя;
					 ОбластьРасшифровка     =  тОбласть.Расшифровка;
						 
					 СтруктураОтвета = ПолучитьСтруктуруРасшифровкиБезКонтекста(тСтруктураРасшифровкиПоказателя,Неопределено,тОбъект,ОбъектАналитическогоБланка.АдресРасшифровкиГруппОтборов,ОбластьИмя,ОбластьРасшифровка,ОбъектАналитическогоБланка.ТзСвойстваПоказателейАдрес);
					  
					 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство("Организация") 
						 ИЛИ (СтруктураОтвета.СтруктураРасшифровки.Свойство("Организация") 
						 И НЕ СтруктураОтвета.СтруктураРасшифровки.Организация =  СтрПоказатель.Организация) Тогда
						 Продолжить;
					 КонецЕсли;	 
					 Если СтруктураОтвета.СтруктураРасшифровки.Свойство("Сценарий") 
						 И  НЕ СтруктураОтвета.СтруктураРасшифровки.Сценарий =  СтрПоказатель.Сценарий Тогда
						 Продолжить;
					 КонецЕсли;	 
					 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство("ПериодОтчета") 
						 ИЛИ (СтруктураОтвета.СтруктураРасшифровки.Свойство("ПериодОтчета") 
						 И  НЕ СтруктураОтвета.СтруктураРасшифровки.ПериодОтчета =  СтрПоказатель.ПериодОтчета) Тогда
						 Продолжить;
					 КонецЕсли;	 
					 
					 тПоказатель =  КэшАналитикПоказателей.Найти(СтрПоказатель.Показатель,"Показатель");
					 
					 тПоказатель =  КэшАналитикПоказателей.Найти(СтрПоказатель.Показатель,"Показатель");
					 
					 //Ищем соответствие по аналитикам
					 ФлСоответствияПоАналитикм = Истина;
					 Для Инд=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
						 Если ЗначениеЗаполнено(СтрПоказатель["Аналитика"+Инд]) Тогда
							 КодАналитики = тПоказатель["ВидАналитики"+Инд+"Код"];		 
							 Если НЕ СтруктураОтвета.СтруктураРасшифровки.Свойство(КодАналитики) Тогда
								 ФлСоответствияПоАналитикм = Ложь;
								 Прервать;
							 КонецЕсли;	   
							 Если  НЕ СтруктураОтвета.СтруктураРасшифровки[КодАналитики] =  СтрПоказатель["Аналитика"+Инд] Тогда
								 ФлСоответствияПоАналитикм = Ложь;
								 Прервать;
							 КонецЕсли;	 	 
						 КонецЕсли;	 	 
					 КонецЦикла;	 
					  
					 Если ФлСоответствияПоАналитикм Тогда
						 ВыделитьЗаблокированныйПоказательСервер(тОбласть);
						 СтрПоказатель.ИмяОбласти = тОбласть.Имя; 
					 КонецЕсли;
					 
				 КонецЦикла;		 	 
			 КонецЕсли;			 	 
		КонецЦикла;		 
	 КонецЦикла;	

КонецПроцедуры	


#КонецОбласти

 #Область РаботаВРежимеМоделированияМодели

&НаКлиенте
Процедура Модель_ПерейиВРежимРедактирования(Команда)
	
	Если Элементы.Модель_ПерейтиВРежимРедактирования.Пометка И ТаблицаЧувствительностиФакторов.НайтиСтроки(Новый Структура("ПризнакИзменения",Истина)).Количество()>0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросВыйтиИзРежимаРедактированияМоделиЗавершение",ЭтаФорма);
		ПоказатьВопрос(Оповещение, Нстр("ru = 'Применить сделанные изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);		
		
	Иначе	
		Если НЕ ЗначениеЗаполнено(ВариантСводнойТаблицы) Тогда
			Оповещение = Новый ОписаниеОповещения("СохранитьВариантДляРедактированияЗавершение",ЭтаФорма);
			ПоказатьВопрос(Оповещение, Нстр("ru = 'Для перехода в режим редактирования необходимо сохранить текущий вариант модели, продолжить?'"), РежимДиалогаВопрос.ДаНет);			
		Иначе	
			УстановитьРежимРедактированияМодели();
		КонецЕсли;	
		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВыйтиИзРежимаРедактированияМоделиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		 ОтменитьИзмененияМоделирование(Неопределено);
	КонецЕсли;	
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		 ПересчитатьМодель(Неопределено);
	КонецЕсли;			

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантДляРедактированияЗавершение(Результат, ДополнительныеПараметры) Экспорт      
		
	Если Результат = КодВозвратаДиалога.Да Тогда
		 СохранитьВариантТаблицыКак(Неопределено);
	КонецЕсли;	
			
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимРедактированияМодели()
	 
	Если НЕ МодельРежимРедактирования И НЕ УстановитьРежимРедактированияМоделиСервер(ВариантСводнойТаблицы) Тогда
		Возврат;
	КонецЕсли;	
	
	Если МодельРежимРедактирования Тогда
		СнятьРежимРедактированияМодели(ВариантСводнойТаблицы); 
	КонецЕсли;	
	
	Элементы.Модель_ПерейтиВРежимРедактирования.Пометка 						= НЕ Элементы.Модель_ПерейтиВРежимРедактирования.Пометка;

	МодельРежимРедактирования 													= Элементы.Модель_ПерейтиВРежимРедактирования.Пометка;
	
	УстановитьДоступностьЭлементовРежимаРедактированияМодели();

	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьРежимРедактированияМоделиСервер(ВариантСводнойТаблицы) 
	
	тРедактирующийПользователь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВариантСводнойТаблицы, "РедактирующийПользователь"); 
	Если ЗначениеЗаполнено(тРедактирующийПользователь) И НЕ тРедактирующийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь") Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Не удалось установить режим редактирования: текущий вариант модели уже редактируется пользователем '")+тРедактирующийПользователь);
		Возврат Ложь;
	Иначе	
		ВариантСводнойТаблицыОбъект = ВариантСводнойТаблицы.ПолучитьОбъект();
		ВариантСводнойТаблицыОбъект.РедактирующийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
		ВариантСводнойТаблицыОбъект.Записать();
		Возврат Истина;
	КонецЕсли;	
		
КонецФункции	

&НаСервереБезКонтекста
Процедура СнятьРежимРедактированияМодели(ВариантСводнойТаблицы) 
		
	ВариантСводнойТаблицыОбъект = ВариантСводнойТаблицы.ПолучитьОбъект();
	ВариантСводнойТаблицыОбъект.РедактирующийПользователь = Справочники.Пользователи.ПустаяСсылка();
	ВариантСводнойТаблицыОбъект.Записать();
		
КонецПроцедуры	

&НаСервереБезКонтекста
Функция МодельРедактируется(ВариантСводнойТаблицы) 
		
	тРедактирующийПользователь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВариантСводнойТаблицы, "РедактирующийПользователь"); 
	Возврат тРедактирующийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	
КонецФункции	

&НаСервере
Процедура УстановитьДоступностьЭлементовРежимаРедактированияМодели()
	
	//Установим доступность колонок в таблице 
	Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС.ТолькоПросмотр 			= НЕ МодельРежимРедактирования;
	Элементы.ТаблицаЧувствительностиФакторовОтклонениеОтн.ТолькоПросмотр 			= НЕ МодельРежимРедактирования;
	Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование.ТолькоПросмотр 	= НЕ МодельРежимРедактирования;
	
	//Установим доступность команд в панеле
	Элементы.ГруппаПрменитьОтменитьМоделрование.Видимость                      		= МодельРежимРедактирования;
	Элементы.ГруппаКомандыАнализаФакторов.Доступность                          		= НЕ МодельРежимРедактирования;
	Элементы.Модель_ПерейтиВРежимПодбораЗначения.Доступность                   		= МодельРежимРедактирования;
	
КонецПроцедуры	

#КонецОбласти


 #Область ВариантАнализаДеревоВлияющихПоказателей

&НаКлиенте
Процедура ВывестиДетализациюПоАналитикеДерево(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменениеДетализацииАналитикДеревоЗавершение", ЭтаФорма);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокАналитик", ДетализацияАналитикДерево);

	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаВыбораДетализацииАнализа",СтруктураПараметров,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеДетализацииАналитикДеревоЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
		
	ДетализацияАналитикДерево.Очистить();
	Для Каждого Стр Из Результат Цикл
		Нстр = ДетализацияАналитикДерево.Добавить(Стр.Значение,Стр.Представление,Стр.Пометка);
	КонецЦикла;	
	
	УстановитьВидРежимаМоделирования(); 
		
КонецПроцедуры

&НаСервере
Процедура ВывестиДеревоФакторов(МассивПоказателей=Неопределено,Моделирование=Ложь) Экспорт
		
	Если ТаблицаВыделенныхПоказателейМоделирование.Количество() = 0 Тогда
		ПолеТабличногоДокументаАнализГрафический.Очистить();
		УстановитьСостояниеНеИспользоватьДляТекущегоРежима(НСтр("ru = 'Выделите целевой показатель для анализа в таблице сверху'"),1);
		Возврат;
	КонецЕсли;	
			
	// Начнем запись протокола
	АдресТаблицыСобытий = "";
	ПротоколируемыеСобытияУХ.Начать();
		
	тзЦелевыеПоказатели = УправлениеРасчетомПоказателей.ОписаниеЛогаИзмененныхПоказателей();
	
	Для Каждого СтрЦелевой Из ТаблицаВыделенныхПоказателейМоделирование Цикл
		
		Если Не СтрЦелевой.Базовый Тогда
			 Продолжить;
		КонецЕсли;	
		
		МассивПериодов = Новый Массив;
		Если  СтрЦелевой.ПериодОтчета.Периодичность = ПериодС.Периодичность Тогда
			МассивПериодов.Добавить(СтрЦелевой.ПериодОтчета);
		Иначе	
			МассивПериодов = ПолучитьПериодыПотомки(СтрЦелевой.ПериодОтчета,ПериодС.Периодичность);
		КонецЕсли;	
		
		Для Каждого СтрПериод Из МассивПериодов Цикл
			Нстр = тзЦелевыеПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрЦелевой);
			Нстр.ПериодОтчета  = СтрПериод;
			Нстр.Валюта  = ВалютаОтображения;
		КонецЦикла;	
		
	КонецЦикла;	
	
	ОбработкаРасчета = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
		
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(ОбработкаРасчета.УникальныйИдентификаторСеанса);
	
	СтруктураРасчета = ОбработкаРасчета.РассчитатьПоЗначениямЦелевыхПоказателей(тзЦелевыеПоказатели, Истина);	
	Если СтруктураРасчета.БылиОшибки Тогда
		ЗначениеВРеквизитФормы(ОбработкаРасчета, "РасчетИЗаписьПоказателей");
		Возврат;
	КонецЕсли;		
	
	ЗначениеВРеквизитФормы(ОбработкаРасчета, "РасчетИЗаписьПоказателей");
	
	// Заполним аналитики по данным рассчета, если они не были переданы
	Если ДетализацияАналитикДерево.Количество() = 0 Тогда		
		тДанныеАналитик = СтруктураРасчета.ДанныеАналитик.Скопировать(,"ВидАналитики,ПредставлениеАналитики");
		тДанныеАналитик.Свернуть("ВидАналитики,ПредставлениеАналитики");
		Для Каждого СтрокаТаблицы Из тДанныеАналитик Цикл
			ДетализацияАналитикДерево.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, Ложь);
		КонецЦикла;
		
	Иначе	
		//Обновим дерево и пометим аналитики из предыдущей настройки
		ДетализацияАналитикДеревоКопия = ДетализацияАналитикДерево.Скопировать();
		ДетализацияАналитикДерево.Очистить();
		тДанныеАналитик = СтруктураРасчета.ДанныеАналитик.Скопировать(,"ВидАналитики,ПредставлениеАналитики");
		тДанныеАналитик.Свернуть("ВидАналитики,ПредставлениеАналитики");
		Для Каждого СтрокаТаблицы Из тДанныеАналитик Цикл
			тЭлемент = ДетализацияАналитикДеревоКопия.НайтиПоЗначению(СтрокаТаблицы.ВидАналитики);
			Если тЭлемент = Неопределено Тогда 
				ДетализацияАналитикДерево.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, Ложь);
			Иначе	
				ДетализацияАналитикДерево.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, тЭлемент.Пометка);
			КонецЕсли;		
		КонецЦикла;	
	КонецЕсли;
	
	// Параметры вывода
	ПараметрыВывода = Новый Структура;
	ПараметрыВывода.Вставить("ЦелевыеПоказателиСнизу", Ложь);
	ПараметрыВывода.Вставить("РежимВыводаОбщихАналитик", 1);
	ПараметрыВывода.Вставить("СворачиватьГруппировки", Ложь);
	ПараметрыВывода.Вставить("УровеньТочности", УровеньТочности);
	ПараметрыВывода.Вставить("Делитель", ТекущийДелитель);
	ПараметрыВывода.Вставить("СоставАналитик", ДетализацияАналитикВлияние);	
		
	// Сформируем отчет
	РабочийОбъект = Обработки.ВыводСтруктурыРасчетаПоказателей.Создать();
	ТабличныйДокумент = РабочийОбъект.ПоказатьАнализРасчетаПоказателя(СтруктураРасчета, ПараметрыВывода);

	ПолеТабличногоДокументаАнализГрафический.Очистить();
	ПолеТабличногоДокументаАнализГрафический.Вывести(ТабличныйДокумент);
	
	СброситьСостояниеНеИспользоватьДляТекущегоРежима(1);
		
КонецПроцедуры

&НаСервере
Функция ПолучитьПериодыПотомки(ПериодРодитель, Периодичность) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Периоды.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Периоды КАК Периоды
	               |ГДЕ
	               |	Периоды.ПометкаУдаления = ЛОЖЬ
	               |	И Периоды.ДатаНачала >= &ДатаНачала
	               |	И Периоды.ДатаНачала <= &ДатаОкончания
	               |	И Периоды.Произвольный = ЛОЖЬ
	               |	И Периоды.Периодичность = &Периодичность
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Периоды.ДатаНачала";

	Запрос.УстановитьПараметр("ДатаНачала", ПериодРодитель.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодРодитель.ДатаОкончания);
	Запрос.УстановитьПараметр("Периодичность", Периодичность);
	
	Результат = Запрос.Выполнить();
		
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
КонецФункции // ПолучитьПодчиненныеПериоды()

#КонецОбласти


#Область ВариантАнализаВлияниеТаблица

&НаКлиенте
Процедура ВывестиДетализациюПоАналитикеВлияние(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменениеДетализацииАналитикВлияниеЗавершение", ЭтаФорма);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокАналитик", ИзменитьСоставАналитикиТаблицыФакторов());
	
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаВыбораДетализацииАнализа",СтруктураПараметров,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаСервере
Функция ИзменитьСоставАналитикиТаблицыФакторов()

     //Заполним выбранные аналитики по текущей таблице показателей
     ДетализацияАналитикВлияниеПредв = Новый СписокЗначений;
	 
	 //Заполним ключевые аналитики
	 ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий,"Сценарий");
	 ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Организация,"Организация");
     ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета,"ПериодОтчета");
     ДетализацияАналитикВлияниеПредв.Добавить(Перечисления.ПостоянныеПоляСводнойТаблицы.Проект,"Проект");

	 //Заполним аналитики, доступные из списка текущих показателей
	 тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(ТаблицаЧувствительностиФакторов.Выгрузить().ВыгрузитьКолонку("Показатель"));
	 
	 Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл
		 
		 Если Не ЗначениеЗаполнено(Стр.Показатель) Тогда
			  Продолжить;
		 КонецЕсли;	 
		 
		 тПоказательКэш = тКэшАналитикПоказателей.Найти(Стр.Показатель,"Показатель");
		 Для ИндАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			 
			 ТекАналитика = тПоказательКэш["ВидАналитики"+ИндАналитики];
			 Если Не ЗначениеЗаполнено(ТекАналитика) Тогда
				  Прервать;
			 Иначе	 
				 
				 Если ДетализацияАналитикВлияниеПредв.НайтиПоЗначению(ТекАналитика) = Неопределено Тогда
				 	  ДетализацияАналитикВлияниеПредв.Добавить(ТекАналитика,Строка(ТекАналитика));
                 КонецЕсли;
				 
			 КонецЕсли;	 
			 
		 КонецЦикла;	 		 
	 КонецЦикла;	 
	 
	 Для Каждого СтрАналитика из ДетализацияАналитикВлияние Цикл
		 
		 ТекАналитика = ДетализацияАналитикВлияниеПредв.НайтиПоЗначению(СтрАналитика.Значение);
		 Если НЕ ТекАналитика = Неопределено Тогда
			  ТекАналитика.Пометка = СтрАналитика.Пометка 
		 КонецЕсли;	 
		 
	 КонецЦикла;
		 
		 
	 Возврат ДетализацияАналитикВлияниеПредв; 
	 
КонецФункции	

&НаКлиенте
Процедура ИзменениеДетализацииАналитикВлияниеЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	ДетализацияАналитикВлияние.Очистить();
	Для Каждого Стр Из Результат Цикл
		Нстр = ДетализацияАналитикВлияние.Добавить(Стр.Значение,Стр.Представление,Стр.Пометка);
	КонецЦикла;	
	
	РасчетФакторовАктуален = Ложь;
	УстановитьВидимостьКолонокТаблицыФакторов(); 
		
КонецПроцедуры

&НаСервере
Функция УстановитьВидимостьКолонокТаблицыФакторов()

 //Выполним первоначальное заполнение списка доступных колонок	
  ИзменитьСоставАналитикиТаблицыФакторов();
 	
	
  //Скроем все дополнительные колонки
  Элементы.ТаблицаЧувствительностиФакторовСценарий.Видимость 		= Ложь; 
  Элементы.ТаблицаЧувствительностиФакторовПериодОтчета.Видимость 	= Ложь; 	
  Элементы.ТаблицаЧувствительностиФакторовОрганизация.Видимость 	= Ложь; 	
  Элементы.ТаблицаЧувствительностиФакторовПроект.Видимость 			= Ложь; 	
  
  Для ИндАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
	  Элементы["ТаблицаЧувствительностиФакторовАналитика"+ИндАналитики].Видимость =  Ложь;
  КонецЦикла;	  
  
  Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС.ТолькоПросмотр 			= НЕ МодельРежимРедактирования;
  Элементы.ТаблицаЧувствительностиФакторовОтклонениеОтн.ТолькоПросмотр 			= НЕ МодельРежимРедактирования;
  Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование.ТолькоПросмотр 	= НЕ МодельРежимРедактирования;
  
  Элементы.ТаблицаЧувствительностиФакторовЗначениеМин.Видимость 				=  МодельРежимПодбораЗначения;
  Элементы.ТаблицаЧувствительностиФакторовЗначениеМакс.Видимость 				=  МодельРежимПодбораЗначения;
  
  
  ИндИспользованнойАналитики = 1;
  СоответствиеАналитик       = Новый Соответствие;
  Для Каждого СтрАналитика Из ДетализацияАналитикВлияние Цикл
	  
	  Если  СтрАналитика.Пометка Тогда
		  Если СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета Тогда
			  Элементы.ТаблицаЧувствительностиФакторовПериодОтчета.Видимость = Истина;
		  ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация Тогда
			  Элементы.ТаблицаЧувствительностиФакторовОрганизация.Видимость = Истина;	
		  ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект Тогда
			  Элементы.ТаблицаЧувствительностиФакторовПроект.Видимость = Истина;		
		  ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
			  Элементы.ТаблицаЧувствительностиФакторовСценарий.Видимость = Истина;	
		  Иначе 	
			  Элементы["ТаблицаЧувствительностиФакторовАналитика"+ИндИспользованнойАналитики].Видимость = Истина;
			  Элементы["ТаблицаЧувствительностиФакторовАналитика"+ИндИспользованнойАналитики].Заголовок = СтрАналитика.Представление;
			  Элементы["ТаблицаЧувствительностиФакторовАналитика"+ИндИспользованнойАналитики].ОграничениеТипа = СтрАналитика.Значение.ТипЗначения;
			  
			  КодАналитики = СтрАналитика.Значение.Код;			  
			  ИндИспользованнойАналитики = ИндИспользованнойАналитики+1;
		  КонецЕсли;	  
	  КонецЕсли;		  
  КонецЦикла;	
  
  
КонецФункции	

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл		
		//Если Не Стр.ЕстьФормула Тогда
			Стр.ВключатьВАнализ = Истина;		
		//КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл		
		Стр.ВключатьВАнализ = Ложь;		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуФакторовВлияние(Команда)

	Если ТаблицаЧувствительностиФакторов.Количество()>0 Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьТаблицуФакторовЗавершение",ЭтаФорма);
		ПоказатьВопрос(Оповещение, Нстр("ru = 'Текущая таблица содержит значения. При продолжении все факторы будут автоматически заполнены по результатм анализа формул, продолжить?'"), РежимДиалогаВопрос.ДаНет);				
	Иначе	
		ЗаполнитьТаблицуФакторов();
	КонецЕсли;
	
	ПоказатьПротокол();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьТаблицуФакторовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьТаблицуФакторов();
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФакторов() Экспорт
	
	ТаблицаЧувствительностиФакторов.Очистить();
	
	// Начнем запись протокола
	АдресТаблицыСобытий = "";
	ПротоколируемыеСобытияУХ.Начать();
		
	тзЦелевыеПоказатели = УправлениеРасчетомПоказателей.ОписаниеЛогаИзмененныхПоказателей();
	
	Для Каждого СтрЦелевой Из ТаблицаВыделенныхПоказателейМоделирование Цикл
		
		Если Не СтрЦелевой.Базовый Тогда
			 Продолжить;
		КонецЕсли;	
		
		МассивПериодов = Новый Массив;
		Если  СтрЦелевой.ПериодОтчета.Периодичность = ПериодС.Периодичность Тогда
			МассивПериодов.Добавить(СтрЦелевой.ПериодОтчета);
		Иначе	
			МассивПериодов = ПолучитьПериодыПотомки(СтрЦелевой.ПериодОтчета,ПериодС.Периодичность);
		КонецЕсли;	
		
		Для Каждого СтрПериод Из МассивПериодов Цикл
			Нстр = тзЦелевыеПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрЦелевой);
			Нстр.ПериодОтчета  = СтрПериод;
			Нстр.Валюта  = ВалютаОтображения;
		КонецЦикла;	
		
	КонецЦикла;	
	
	// Получим кэш данных
	КэшДанных = Новый Соответствие;
	АдресКэшаДанных = ПоместитьВоВременноеХранилище(КэшДанных, УникальныйИдентификатор);
		
	УникальныйИдентификаторРасчета =                    Новый УникальныйИдентификатор;
	
	ОбработкаРасчета 									= Обработки.РасчетИЗаписьПоказателей.Создать();
	ОбработкаРасчета.УникальныйИдентификаторСеанса 		= УникальныйИдентификаторРасчета;
	ОбработкаРасчета.АдресКэшаДанных                    = АдресКэшаДанных;
	
	дзДеревоРасчета = Неопределено;
	
	СтруктураРасчета = ОбработкаРасчета.РассчитатьПоЗначениямЦелевыхПоказателей(тзЦелевыеПоказатели, Истина);
	
	Если СтруктураРасчета.БылиОшибки Тогда
		// Были ошибки расчета, сформируем протокол
		Протокол = ПротоколируемыеСобытияУХ.Завершить("РассчитатьПоЗначениямЦелевыхПоказателей",,,,Ложь);
		Если Протокол <> Неопределено Тогда
			Если Протокол.Количество() Тогда
				АдресТаблицыСобытий = ПоместитьВоВременноеХранилище(Протокол, УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Заполним аналитики по данным рассчета, если они не были переданы
	Если ДетализацияАналитикВлияние.Количество() = 0 Тогда
		тДанныеАналитик = СтруктураРасчета.ДанныеАналитик.Скопировать(,"ВидАналитики,ПредставлениеАналитики");
		тДанныеАналитик.Свернуть("ВидАналитики,ПредставлениеАналитики");
		Для Каждого СтрокаТаблицы Из тДанныеАналитик Цикл
			ДетализацияАналитикВлияние.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, Ложь);
		КонецЦикла;
		
	Иначе	
		//Обновим дерево и пометим аналитики из предыдущей настройки
		ДетализацияАналитикДеревоКопия = ДетализацияАналитикВлияние.Скопировать();
		ДетализацияАналитикВлияние.Очистить();
		тДанныеАналитик = СтруктураРасчета.ДанныеАналитик.Скопировать(,"ВидАналитики,ПредставлениеАналитики");
		тДанныеАналитик.Свернуть("ВидАналитики,ПредставлениеАналитики");
		Для Каждого СтрокаТаблицы Из тДанныеАналитик Цикл
			тЭлемент = ДетализацияАналитикДеревоКопия.НайтиПоЗначению(СтрокаТаблицы.ВидАналитики);
			Если тЭлемент = Неопределено Тогда 
				ДетализацияАналитикВлияние.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, Ложь);
			Иначе	
				ДетализацияАналитикВлияние.Добавить(СтрокаТаблицы.ВидАналитики, СтрокаТаблицы.ПредставлениеАналитики, тЭлемент.Пометка);
			КонецЕсли;		
		КонецЦикла;	
	КонецЕсли;
	
	СтруктураРаскрываемыхАналитик = Новый Структура;
	//СтруктураРаскрываемыхАналитик.Вставить("ВидОтчета");
	
	ИндИспользованнойАналитики = 1;
	СоответствиеАналитик       = Новый Соответствие;
	Для Каждого СтрАналитика Из ДетализацияАналитикВлияние Цикл	
		Если  СтрАналитика.Пометка Тогда
			Если СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.ПериодОтчета Тогда
			ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Организация Тогда
			ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Проект Тогда
			ИначеЕсли СтрАналитика.Значение = Перечисления.ПостоянныеПоляСводнойТаблицы.Сценарий Тогда
			Иначе
				КодАналитики = СтрАналитика.Значение.Код;
				СтруктураРаскрываемыхАналитик.Вставить(КодАналитики);
				СоответствиеАналитик.Вставить("Аналитика"+ИндИспользованнойАналитики,КодАналитики);
				ИндИспользованнойАналитики = ИндИспользованнойАналитики+1;
			КонецЕсли;		
		КонецЕсли;		
	КонецЦикла;	
	
	СтруктураОтбираемыхАналитик = Новый Структура;
	//Свернем таблицу влияющих факторов по ключевым срезам:
	СтруктураРасчета.ЗначенияПоказателей.Свернуть("Показатель,Сценарий,Организация,Проект,ПериодОтчета,Валюта"); 
		
	ТаблицаЧувствительностиФакторов.Очистить();
	
	Для Каждого СтрКлючевойСрез Из СтруктураРасчета.ЗначенияПоказателей Цикл
		
		МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить(СтрКлючевойСрез.Показатель);
		
		СтруктураОтбираемыхАналитик = Новый Структура;
		СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
		СтруктураОтбираемыхАналитик.Вставить("Сценарий",СтрКлючевойСрез.Сценарий);
		СтруктураОтбираемыхАналитик.Вставить("Организация",СтрКлючевойСрез.Организация);
		СтруктураОтбираемыхАналитик.Вставить("ПериодОтчета",СтрКлючевойСрез.ПериодОтчета);
		СтруктураОтбираемыхАналитик.Вставить("Проект",СтрКлючевойСрез.Проект);
		СтруктураОтбираемыхАналитик.Вставить("Валюта",СтрКлючевойСрез.Валюта);
		
		Результат 		= ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,Ложь);	
		
		Для Каждого СтрокаРезультат Из Результат Цикл
			
			тПоказательУровень = СтруктураРасчета.Показатели.Найти(СтрокаРезультат.ПоказательОтчета,"Показатель");
			Если тПоказательУровень.Уровень = 1 Тогда   //Целевой показатель имеет 1 уровень.
				 Продолжить;
			КонецЕсли;	
			
			нСтр 					= ТаблицаЧувствительностиФакторов.Добавить();
			нСтр.Показатель			= СтрокаРезультат.ПоказательОтчета;
			нСтр.ВидОтчета          = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(нСтр.Показатель, "Владелец");
			нСтр.ВключатьВАнализ    = НЕ ЗначениеЗаполнено(тПоказательУровень.Процедура);
			Нстр.ПериодОтчета       = СтрокаРезультат.ПериодОтчета;
			Нстр.Организация        = СтрокаРезультат.Организация;
			Нстр.Проект             = СтрокаРезультат.Проект;
			Нстр.Сценарий           = СтрокаРезультат.Сценарий;
			Нстр.УровеньРасчета     = тПоказательУровень.Уровень;
			Нстр.ЕстьФормула        = ЗначениеЗаполнено(тПоказательУровень.Процедура);
			
			Для ИндАналитики = 1 По ИндИспользованнойАналитики - 1 Цикл
				нСтр["Аналитика"+ИндАналитики] = СтрокаРезультат[СоответствиеАналитик["Аналитика"+ИндАналитики]]; 
				Если ЗначениеЗаполнено(СтрокаРезультат[СоответствиеАналитик["Аналитика"+ИндАналитики]]) Тогда
					СтруктураОтбираемыхАналитик.Вставить(СоответствиеАналитик["Аналитика"+ИндАналитики],СтрокаРезультат[СоответствиеАналитик["Аналитика"+ИндАналитики]]);
				КонецЕсли;	
			КонецЦикла;	
			
			
			РезультатМодель = ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,Истина);

			
			нСтр.БазовоеЗначение   	= СтрокаРезультат.Значение;
			Если РезультатМодель.Количество() = 1 Тогда
				 нСтр.ЗначениеМоделирование = РезультатМодель[0].Значение; 
			Иначе	
				 нСтр.ЗначениеМоделирование = нСтр.БазовоеЗначение;
			КонецЕсли;	
			
			ПересчитатьКонечнуюСуммуИОтклоненияСервер(Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование,нСтр);
			
		КонецЦикла;	
				
	КонецЦикла;	

	ТаблицаЧувствительностиФакторов.Сортировать("Естьформула,Влияние УБЫВ,БазовоеЗначение УБЫВ");
		
    СброситьСостояниеНеИспользоватьДляТекущегоРежима(2);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовПриИзменении(Элемент)
	 
	Если Элемент.ТекущийЭлемент = Элементы.ТаблицаЧувствительностиФакторовПоказатель Тогда
		
		Для Инд = 1 По 6 Цикл	
			Элемент.ТекущиеДанные["Аналитика"+Инд] = Неопределено;	
		КонецЦикла;	
		
	КонецЕсли;	
	
	Если Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС		ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовОтклонениеОТН 		ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовКомментарийКСтроке 	ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовЗначениеМин 			ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовЗначениеМакс 			ИЛИ
		Элемент.ТекущийЭлемент  = Элементы.ТаблицаЧувствительностиФакторовВключатьВАнализ 		Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущиеДанные.БазовоеЗначение 		= ПолучитьТекущееЗначениеПоказателя(ПолучитьРасшифровкуПоказателяПоТаблице(),Ложь);
	Элемент.ТекущиеДанные.ЗначениеМоделирование = ПолучитьТекущееЗначениеПоказателя(ПолучитьРасшифровкуПоказателяПоТаблице(),Истина);
	ПересчитатьКонечнуюСуммуИОтклонения(Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование);

	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.ТаблицаЧувствительностиФакторовВидОтчета  
		ИЛИ Поле = Элементы.ТаблицаЧувствительностиФакторовБазовоеЗначение 
		ИЛИ Поле = Элементы.ТаблицаЧувствительностиФакторовЧувствительность Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	

	Если Поле =  Элементы.ТаблицаЧувствительностиФакторовАналитика1 ИЛИ
		Поле = Элементы.ТаблицаЧувствительностиФакторовАналитика2 ИЛИ
		Поле = Элементы.ТаблицаЧувствительностиФакторовАналитика3 ИЛИ
        Поле = Элементы.ТаблицаЧувствительностиФакторовАналитика4 ИЛИ
        Поле = Элементы.ТаблицаЧувствительностиФакторовАналитика5 ИЛИ
	    Поле = Элементы.ТаблицаЧувствительностиФакторовАналитика6     Тогда
		
		ПроверитьДоступностьАналитики(ДетализацияАналитикВлияние,Элемент.ТекущиеДанные.Показатель,Число(Прав(Поле.Имя,1)),СтандартнаяОбработка);
		
	КонецЕсли;	
	
	Если Поле = Элементы.ТаблицаЧувствительностиФакторовБазовоеЗначение  Тогда
		
		СтруктураРасшифровкиКонтекста 	= ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(ПолучитьРасшифровкуПоказателяПоТаблице()); 
		//Получим чистые данные без данных модлели
		РежимМоделирования = Ложь;
		ПараметрыФормыРаскрытия 		= АналитическийБланкУХВызовСервера.ПодготовитьПараметрыВызоваФормыРаскрытий(СтруктураРасшифровкиКонтекста.СтруктураРасшифровки,СтруктураРасшифровкиКонтекста,ПолучитьСвойстваТекущегоКонтекста());	
		РежимМоделирования = Истина;
	
		СтруктураЗаблокированныхПоказателей = Новый Структура;
		СтруктураЗаблокированныхПоказателей.Вставить("ТекстОповещения", Нстр("ru = 'Только просмотр'"));
		СтруктураЗаблокированныхПоказателей.Вставить("Пояснение","");
		СтруктураЗаблокированныхПоказателей.Вставить("Заблокирован",Истина);
		
		тОбъект = ПолучитьСвойстваТекущегоОбъекта();
	
		ПараметрыФормыРаскрытия.Вставить("СтруктураЗаблокированныхПоказателей",СтруктураЗаблокированныхПоказателей);
		ПараметрыФормыРаскрытия.Вставить("тОбъект",тОбъект);	
		ПараметрыФормыРаскрытия.Вставить("РежимТолькоЧтение",Истина);
		ПараметрыФормыРаскрытия.Вставить("УникальныйИдентификаторСеанса", УникальныйИдентификатор);
		
		//Оповещение = Новый ОписаниеОповещения("РедактированиеРаскрытияЗавершение", ЭтаФорма);
		ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаРаскрытияПоказателей",ПараметрыФормыРаскрытия,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.Независимый);		
			
	КонецЕсли;	
	
	Если Поле = Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование  Тогда
		
		СтруктураРасшифровкиКонтекста 	= ПодготовитьПараметрыРасшифровкиПоТаблицеФакторов(ПолучитьРасшифровкуПоказателяПоТаблице()); 
		ПараметрыФормыРаскрытия 		= АналитическийБланкУХВызовСервера.ПодготовитьПараметрыВызоваФормыРаскрытий(СтруктураРасшифровкиКонтекста.СтруктураРасшифровки,СтруктураРасшифровкиКонтекста,ПолучитьСвойстваТекущегоКонтекста());	
			
		СтруктураЗаблокированныхПоказателей = Новый Структура;
		СтруктураЗаблокированныхПоказателей.Вставить("ТекстОповещения", Нстр("ru = 'Только просмотр'"));
		СтруктураЗаблокированныхПоказателей.Вставить("Пояснение","");
		СтруктураЗаблокированныхПоказателей.Вставить("Заблокирован",Истина);
		
		тОбъект = ПолучитьСвойстваТекущегоОбъекта();
	
		ПараметрыФормыРаскрытия.Вставить("СтруктураЗаблокированныхПоказателей",СтруктураЗаблокированныхПоказателей);
		ПараметрыФормыРаскрытия.Вставить("тОбъект",тОбъект);	
		ПараметрыФормыРаскрытия.Вставить("РежимТолькоЧтение",Истина);
		ПараметрыФормыРаскрытия.Вставить("УникальныйИдентификаторСеанса", УникальныйИдентификатор);
		
		//Оповещение = Новый ОписаниеОповещения("РедактированиеРаскрытияЗавершение", ЭтаФорма);
		ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаРаскрытияПоказателей",ПараметрыФормыРаскрытия,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.Независимый);		
			
	КонецЕсли;	

	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовПриАктивизацииСтроки(Элемент)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		 ЗначениеДоИзмененияФактор = Элемент.ТекущиеДанные.ЗначениеМоделирование;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовПоказательПриИзменении(Элемент)
	
	Если ЗначениеЗАполнено(Элементы.ТаблицаЧувствительностиФакторов.ТекущиеДанные.Показатель) Тогда	
		 Элементы.ТаблицаЧувствительностиФакторов.ТекущиеДанные.ВидОтчета  = ПолучитьВидОтчетаПоПоказателю(Элементы.ТаблицаЧувствительностиФакторов.ТекущиеДанные.Показатель);		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидОтчетаПоПоказателю(Показатель)
		
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Показатель, "Владелец");
	
КонецФункции	

&НаКлиенте
Процедура ПересчитатьКонечнуюСуммуИОтклонения(Элемент)
	
	 тСтрокаТаблицы = Элементы.ТаблицаЧувствительностиФакторов.ТекущиеДанные;
	 
	 Если Элемент = Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС Тогда
		 
		 тСтрокаТаблицы.ЗначениеМоделирование  = тСтрокаТаблицы.БазовоеЗначение+тСтрокаТаблицы.ОтклонениеАБС;
		 Если тСтрокаТаблицы.БазовоеЗначение = 0 Тогда
			 тСтрокаТаблицы.ОтклонениеОтн = 0; 
		 Иначе	 
			 тСтрокаТаблицы.ОтклонениеОтн  = ((тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение)/тСтрокаТаблицы.БазовоеЗначение)*100;
		 КонецЕсли;	 
			 
	 ИначеЕсли Элемент = Элементы.ТаблицаЧувствительностиФакторовОтклонениеОтн Тогда
		 
		 тСтрокаТаблицы.ЗначениеМоделирование  = тСтрокаТаблицы.БазовоеЗначение+тСтрокаТаблицы.БазовоеЗначение*(тСтрокаТаблицы.ОтклонениеОтн/100);
         тСтрокаТаблицы.ОтклонениеАБС  = тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение;
		 
	 ИначеЕсли Элемент = Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование Тогда
		 
		 тСтрокаТаблицы.ОтклонениеАБС  = тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение;
		 Если тСтрокаТаблицы.БазовоеЗначение = 0 Тогда
			 тСтрокаТаблицы.ОтклонениеОтн = 0; 
		 Иначе	 
			 тСтрокаТаблицы.ОтклонениеОтн  = ((тСтрокаТаблицы.ЗначениеМоделирование-тСтрокаТаблицы.БазовоеЗначение)/тСтрокаТаблицы.БазовоеЗначение)*100;
		 КонецЕсли;	
		 		 		 
	 КонецЕсли;
	 	 
	 тСтрокаТаблицы.ЗначениеДляЛогаИзменений =  ЗначениеДоИзмененияФактор;
	 	 
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьВлияниеФакторовПолныйПересчет(Команда)
	
	// 1. Запуск фонового задания на сервере.
	ДлительнаяОперация = НачатьРасчетВлиянияФакторовПолныйПересчет();
	
	// 2. Подключение обработчика завершения фонового задания.
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется расчет влияния показателей...'");
	Оповещение = Новый ОписаниеОповещения("ПриЗваершенииРасчетаВлиянияФакторовПолныйПересчет", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьРасчетВлиянияФакторовПолныйПересчет()
	
	ПоказателиФакторов = ТаблицаЧувствительностиФакторов.Выгрузить().СкопироватьКолонки();
	ПоказателиФакторов.Колонки.Добавить("Значение",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	ДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Выгрузить(
		,
		"ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	ДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	ДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
	ДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	ДанныеДляПересчета.ЗаполнитьЗначения(ПериодПо, "ПериодОкончания");
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыРасчета = Новый Структура;
	
	ПараметрыОтбора = Новый Структура("ОбъектМетаданных", "РасчетИЗаписьПоказателей");
	
	АдресаРасчетаИЗаписиПоказателей = ЗарезервированныеАдреса.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из АдресаРасчетаИЗаписиПоказателей Цикл
		ПараметрыРасчета.Вставить(Стр.Реквизит, Стр.Адрес);
		Если Стр.Реквизит = "АдресКэшаДанных" Тогда
			Если ЗначениеЗаполнено(РасчетИЗаписьПоказателей.АдресКэшаДанных) Тогда
				ПараметрыРасчета.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(РасчетИЗаписьПоказателей.АдресКэшаДанных));
			Иначе
				ПараметрыРасчета.Вставить("КэшДанных", ПолучитьИзВременногоХранилища(Стр.Адрес));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыРасчета.Вставить(
		"ЦелевыеПоказатели", 
		ТаблицаВыделенныхПоказателейМоделирование.Выгрузить().Скопировать(Новый Структура("Базовый",Истина)));
	ПараметрыРасчета.Вставить("ПоказателиФакторов",              ПоказателиФакторов);
	ПараметрыРасчета.Вставить("ДанныеДляПересчета",              ДанныеДляПересчета);
	ПараметрыРасчета.Вставить("ТаблицаЧувствительностиФакторов", ТаблицаЧувствительностиФакторов.Выгрузить());
	ПараметрыРасчета.Вставить("ДетализацияАналитикВлияние",      ДетализацияАналитикВлияние);
	ПараметрыРасчета.Вставить("ВалютаОтображения",               ВалютаОтображения);
	ПараметрыРасчета.Вставить("УникальныйИдентификаторСеанса",   УникальныйИдентификатор);
	ПараметрыРасчета.Вставить("ЧислоДопАналитик",                ПараметрыСеанса.ЧислоДопАналитик);
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.АналитическийБланкСводнаяТаблица.РасчетВлиянияФакторовПолныйПересчет",
		ПараметрыРасчета);
			
КонецФункции

&НаКлиенте
Процедура ПриЗваершенииРасчетаВлиянияФакторовПолныйПересчет(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИСключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ВыполнитьДействияПослеРасчетаВлиянияФакторовПолныйПересчет(Результат);
	ПоказатьПротокол();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияПослеРасчетаВлиянияФакторовПолныйПересчет(Результат)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ТаблицаЧувствительностиФакторов.Загрузить(РезультатОперации.ТаблицаЧувствительностиФакторов);
	РасчетИЗаписьПоказателей.АдресТаблицыСобытий = РезультатОперации.АдресТаблицыСобытий;
	
КонецПроцедуры

&НаКлиенте
Процедура МоделированиеУстановитьРежимПодбораЗначения(Команда)
	
	УстановитьРежимПодбораЗначения();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимПодбораЗначения()
	 
	 Элементы.Модель_ПерейтиВРежимПодбораЗначения.Пометка 						= НЕ Элементы.Модель_ПерейтиВРежимПодбораЗначения.Пометка;
	 МодельРежимПодбораЗначения 												= Элементы.Модель_ПерейтиВРежимПодбораЗначения.Пометка;
	 
	 //Установим доступность колонок в таблице 
	 Элементы.ТаблицаЧувствительностиФакторовОтклонениеАБС.ТолькоПросмотр 			= МодельРежимПодбораЗначения;
	 Элементы.ТаблицаЧувствительностиФакторовОтклонениеОтн.ТолькоПросмотр 			= МодельРежимПодбораЗначения;
	 Элементы.ТаблицаЧувствительностиФакторовЗначениеМоделирование.ТолькоПросмотр 	= МодельРежимПодбораЗначения;
	 Элементы.ТаблицаЧувствительностиФакторовЗначениеМин.Видимость 					= МодельРежимПодбораЗначения;
	 Элементы.ТаблицаЧувствительностиФакторовЗначениеМакс.Видимость 				= МодельРежимПодбораЗначения;
 
	 //Установим доступность команд в панеле целевых показателей
	 Элементы.Моделирование_ВыполнитьПодборЗначения.Видимость                        = МодельРежимПодбораЗначения;
	 Элементы.ЦелевойПоказательНовоеЗначение.Видимость                        		 = МодельРежимПодбораЗначения;

	 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовОтклонениеАБСПриИзменении(Элемент)
	
    ПересчитатьКонечнуюСуммуИОтклонения(Элемент);
	Элементы.ТаблицаЧувствительностиФакторов.ТекущиеДанные.ПризнакИзменения = Истина;
	УстановитьРежимОжиданияПримененияИзменений();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧувствительностиФакторовОтклонениеОтнРегулирование(Элемент, Направление, СтандартнаяОбработка)
	 ТаблицаЧувствительностиФакторовОтклонениеАБСПриИзменении(Элемент);
КонецПроцедуры

&НаСервере
Процедура РассчитатьВлияниеФакторовПоВидамОтчетов()	
	
	//Выделенный целевой базовый показатель 
	тЦелевыеПоказатели   = ТаблицаВыделенныхПоказателейМоделирование.Выгрузить().Скопировать(Новый Структура("Базовый",Истина));
		
	//Преобразуем таблицу факторов к нужному виду	
	тПоказателиФакторов  	= ТаблицаЧувствительностиФакторов.Выгрузить().СкопироватьКолонки();
	тПоказателиФакторов.Колонки.Добавить("Значение",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5));
	
	тДанныеДляПересчета = ТаблицаЧувствительностиФакторов.Выгрузить(,"ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект,УровеньРасчета");
	тДанныеДляПересчета.Сортировать("УровеньРасчета УБЫВ");
	тДанныеДляПересчета.Свернуть("ВидОтчета,ПериодОтчета,Сценарий,Организация,Проект");
    тДанныеДляПересчета.Колонки.Добавить("ПериодОкончания");
	Для Каждого СтрПересчета Из тДанныеДляПересчета Цикл
		СтрПересчета.ПериодОкончания = ПериодПо;
	КонецЦикла;
	
	Для Каждого Стр Из ТаблицаЧувствительностиФакторов Цикл
		Если Стр.ВключатьВАнализ Тогда
									
			ОбработкаРасчета 								= Обработки.РасчетИЗаписьПоказателей.Создать();
			ОбработкаРасчета.УникальныйИдентификаторСеанса 	= УникальныйИдентификатор;
			ОбработкаРасчета.ДанныеДляПересчетаПоказателей.Загрузить(тДанныеДляПересчета);
															
			тРезультат = РассчитатьЧувствительностьПоПоказателю(Стр,ОбработкаРасчета,тЦелевыеПоказатели,тПоказателиФакторов,Стр.БазовоеЗначение);
			
			Если тРезультат.Количество() = 1 Тогда
				Стр.Влияние 		=  тРезультат[0].Влияние;
				Стр.Градиент 		=  тРезультат[0].Градиент;
				Стр.КоэффГрадиента 	=  тРезультат[0].КоэффГрадиента;
			КонецЕсли;	
						
		КонецЕсли;	
	КонецЦикла;
	
	ТаблицаЧувствительностиФакторов.Сортировать("Влияние УБЫВ");
		
КонецПроцедуры

&НаСервере
Функция РассчитатьЧувствительностьПоПоказателю(СтрокаИсходойТаблицы,ОбработкаРасчета,тЦелевыеПоказатели,тПоказателиФакторов,ЗначениеДляАнализа)
	
	тПоказателиФакторов.Очистить();
	
	//Заполним таблицу факторов
	Нстр 						= тПоказателиФакторов.Добавить();
	ЗаполнитьЗначенияСвойств(Нстр,СтрокаИсходойТаблицы);	
	Нстр.Значение 				= ЗначениеДляАнализа;
	//Преобразуем строку с аналитиками к инлексам группы раскрытия
	тКэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(СтрокаИсходойТаблицы.Показатель);
	ПреобразоватьИндексыАналитик(Нстр,тКэшАналитикПоказателей);
	
	ОбработкаРасчета.РассчитатьВлияниеФакторовПоДаннымДляПересчета(тЦелевыеПоказатели, тПоказателиФакторов, ВалютаОтображения);
	
	Возврат тПоказателиФакторов; 
		
КонецФункции	

&НаСервере
Функция ПолучитьТекущееЗначениеПоказателя(СтруктураРасшифровки,ВключатьДанныеМодели)
	
	СтруктураОтбираемыхАналитик = Новый Структура;
    СтруктураРаскрываемыхАналитик = Новый Структура;
	
	Если НЕ СтруктураРасшифровки.Свойство("Показатель") 
		ИЛИ НЕ СтруктураРасшифровки.Свойство("Сценарий")
		ИЛИ НЕ СтруктураРасшифровки.Свойство("Организация")
		ИЛИ НЕ СтруктураРасшифровки.Свойство("ПериодОтчета") Тогда
		Возврат 0;
	КонецЕсли;	
 
    Если НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Показатель) 
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Сценарий)
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.ПериодОтчета) Тогда
		Возврат 0;
	КонецЕсли;	
 	
	Для Каждого тОтбор Из СтруктураРасшифровки Цикл
		Если тОтбор.Ключ = "Показатель" Тогда
			МассивПоказателей = Новый Массив;
			МассивПоказателей.Добавить(тОтбор.Значение);
			СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
		Иначе	
			СтруктураОтбираемыхАналитик.Вставить(тОтбор.Ключ,тОтбор.Значение);
		КонецЕсли;	
	КонецЦикла;	
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(СтруктураРасшифровки.Показатель);
	
	Результат = ПолучитьДанныеПоказателяМоделирование(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,ВключатьДанныеМодели);
		
	Если Результат.Количество() = 1 Тогда
		 Возврат Результат[0].Значение;
	КонецЕсли;	
		
КонецФункции	  

&НаСервере
Процедура ПреобразоватьИндексыАналитик(СтрокаТаблицы,тКэшАналитикПоказателей)

	тПоказатель 					= тКэшАналитикПоказателей.Найти(СтрокаТаблицы.Показатель,"Показатель"); 
	ИндексАналитикиВТаблице 		= 0;
	ЧислоДопАналитик 				= ПараметрыСеанса.ЧислоДопАналитик;
	СтруктураСоответствияАналитик   = Новый Структура;
	
	Для Каждого СтрСписка Из ДетализацияАналитикВлияние Цикл
		Если СтрСписка.Пометка И Не ТипЗнч(СтрСписка.Значение) = Тип("ПеречислениеСсылка.ПостоянныеПоляСводнойТаблицы") Тогда
			
			 ИндексАналитикиВТаблице = ИндексАналитикиВТаблице+1;
			 ПвхАналитики         	 = СтрСписка.Значение;
			 Для Инд=1  По ЧислоДопАналитик Цикл
				 Если тПоказатель["ВидАналитики"+Инд] = ПвхАналитики Тогда
					 СтруктураСоответствияАналитик.Вставить("Аналитика"+Инд,СтрокаТаблицы["Аналитика"+ИндексАналитикиВТаблице]);
					 Прервать;
				 КонецЕсли;	 	 
			 КонецЦикла;	 
			 
		КонецЕсли;
	КонецЦикла;	
	
	Для Инд=1  По  ЧислоДопАналитик Цикл
		ПредставлениеАналитики = "Аналитика"+Инд;
		СтрокаТаблицы[ПредставлениеАналитики] = Неопределено;
		Если СтруктураСоответствияАналитик.Свойство(ПредставлениеАналитики) Тогда 
			СтрокаТаблицы[ПредставлениеАналитики] = СтруктураСоответствияАналитик[ПредставлениеАналитики];
		КонецЕсли;	
	КонецЦикла;	
	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьПоказательПоТаблицеФакторов(СтруктураРасшифровкиКонтекста,НомерТранзакции=0)

	СтруктураРасшифровки 				= СтруктураРасшифровкиКонтекста.СтруктураРасшифровки;
	
	ОбъектАБ 							= РеквизитФормыВЗначение("ОбъектАналитическогоБланка");
	ТаблицаИзмененныхПоказателей 		= УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	
	Показатели = Новый Массив;
	Показатели.Добавить(СтруктураРасшифровки.Показатель);
	КэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Показатели);
	ФлОшибки = Ложь;
	
	СтруктураПараметровЛог = Новый Структура;
	СтруктураПараметровЛог.Вставить("ЗначениеНовое",СтруктураРасшифровкиКонтекста.ЗначениеНовое);
	СтруктураПараметровЛог.Вставить("ЗначениеСтарое",СтруктураРасшифровкиКонтекста.ЗначениеСтарое);
	СтруктураПараметровЛог.Вставить("СтруктураРасшифровки",СтруктураРасшифровки);
	СтруктураПараметровЛог.Вставить("КэшАналитикПоказателей",КэшАналитикПоказателей);
	СтруктураПараметровЛог.Вставить("ТаблицаИзмененныхПоказателей",ТаблицаИзмененныхПоказателей);
	СтруктураПараметровЛог.Вставить("НомерТранзакции",НомерТранзакции);
	СтруктураПараметровЛог.Вставить("ПредставлениеТранзакции",Перечисления.ТранзакцииИзмененияПоказателей.ИзменениеПоказателя);
	СтруктураПараметровЛог.Вставить("ФлОшибки",ФлОшибки);
	
	ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметровЛог);

	ОбработкаОбъект = Обработки.РасчетИЗаписьПоказателей.Создать();
	ОбработкаОбъект.УникальныйИдентификаторСеанса = ИдентификаторДанныхМоделирование;
	
	ПараметрыРасчета = ОбработкаОбъект.ПараметрыРасчета();
	ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(
		ТаблицаИзмененныхПоказателей, УникальныйИдентификатор);;
	ПараметрыРасчета.НомерТранзакции = НомерТранзакции;
	Результат = ОбработкаОбъект.РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета); 
 
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьРаскрытиеПоТаблицеФакторов(СтруктураРасшифровкиКонтекста,ПараметрыФормыРаскрытия,НомерТранзакции=0)

	СтруктураРасшифровки 				= СтруктураРасшифровкиКонтекста.СтруктураРасшифровки;
	
	ОбъектАБ 							= РеквизитФормыВЗначение("ОбъектАналитическогоБланка");
	ТаблицаИзмененныхПоказателей 		= УправлениеРасчетомПоказателей.ОписаниеТаблицыИзмененныхПоказателей();
	
	Показатели = Новый Массив;
	Показатели.Добавить(СтруктураРасшифровки.Показатель);
	КэшАналитикПоказателей = АналитическийБланкУХСервер.ПолучитьКэшАналитикПоказателей(Показатели);
	ФлОшибки = Ложь;
	
	ТзРаскрытия = ПолучитьИзВременногоХранилища(ПараметрыФормыРаскрытия.АдресТзРаскрытия);
	
	Пропорция = (СтруктураРасшифровкиКонтекста.ЗначениеНовое - СтруктураРасшифровкиКонтекста.ЗначениеСтарое)/СтруктураРасшифровкиКонтекста.ЗначениеСтарое;
	
	Для Каждого СтрРаскрытие Из ТзРаскрытия Цикл
		
		Для Каждого СтрАналитика Из СтруктураРасшифровкиКонтекста.СтруктураНезаполненныхАналитик Цикл
			СтруктураРасшифровки.Вставить(СтрАналитика.Ключ,СтрРаскрытие[СтрАналитика.Ключ]);
		КонецЦикла;	
		
		ЗначениеНовое 	= СтрРаскрытие.Значение+СтрРаскрытие.Значение*Пропорция;
		ЗначениеСтарое 	= СтрРаскрытие.Значение;
		
		СтруктураПараметровЛог = Новый Структура;
		СтруктураПараметровЛог.Вставить("ЗначениеНовое",ЗначениеНовое);
		СтруктураПараметровЛог.Вставить("ЗначениеСтарое",ЗначениеСтарое);
		СтруктураПараметровЛог.Вставить("СтруктураРасшифровки",СтруктураРасшифровки);
		СтруктураПараметровЛог.Вставить("КэшАналитикПоказателей",КэшАналитикПоказателей);
		СтруктураПараметровЛог.Вставить("ТаблицаИзмененныхПоказателей",ТаблицаИзмененныхПоказателей);
		СтруктураПараметровЛог.Вставить("НомерТранзакции",НомерТранзакции);
		СтруктураПараметровЛог.Вставить("ПредставлениеТранзакции",Перечисления.ТранзакцииИзмененияПоказателей.ИзменениеПоказателя);
		СтруктураПараметровЛог.Вставить("ФлОшибки",ФлОшибки);
		
		ОбъектАБ.ВставитьЗначениеПоказателяВЛог(СтруктураПараметровЛог);
		
	КонецЦикла;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("РасчетИЗаписьПоказателей");
	ОбработкаОбъект.УникальныйИдентификаторСеанса = ИдентификаторДанныхМоделирование;
	
	ПараметрыРасчета = ОбработкаОбъект.ПараметрыРасчета();
	ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(
		ТаблицаИзмененныхПоказателей, УникальныйИдентификатор);;
	ПараметрыРасчета.НомерТранзакции = НомерТранзакции;
	Результат = ОбработкаОбъект.РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета);
 
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "РасчетИЗаписьПоказателей");	
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьРасшифровкуПоказателяПоТаблице()

	ДетализацияАналитикВлияние =  ИзменитьСоставАналитикиТаблицыФакторов();
	
	Элемент = Элементы.ТаблицаЧувствительностиФакторов;
	
	СтруктураРасшифровки = Новый Структура;
	СтруктураРасшифровки.Вставить("Показатель",Элемент.ТекущиеДанные.Показатель);
	СтруктураРасшифровки.Вставить("ПоказательСсылка",Элемент.ТекущиеДанные.Показатель);
	СтруктураРасшифровки.Вставить("УидГруппыОтборов",0);
	СтруктураРасшифровки.Вставить("Валюта",ВалютаОтображения);
	
	ИндАналитики = 1;
	Для Каждого СтрАналитика Из ДетализацияАналитикВлияние Цикл
		
		Если СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Сценарий")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Организация")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.ПериодОтчета")
			ИЛИ СтрАналитика.Значение = ПредопределенноеЗначение("Перечисление.ПостоянныеПоляСводнойТаблицы.Проект") Тогда
			
			Если СтрАналитика.Пометка Тогда //Если аналитика есть в текущей таблице, тогда берем из таблицы
				СтруктураРасшифровки.Вставить(СтрАналитика.Представление,Элемент.ТекущиеДанные[СтрАналитика.Представление]);
			Иначе //берем из общих отборов, если есть	
				
				
				СтруктураРасшифровки.Вставить(СтрАналитика.Представление,ТаблицаВыделенныхПоказателейМоделирование[0][СтрАналитика.Представление]);
							
			КонецЕсли;	
			
		Иначе	
			
			Если СтрАналитика.Пометка Тогда //Если аналитика есть в текущей таблице, тогда берем из таблицы
				 СтруктураРасшифровки.Вставить(ПолучитьКодПВХАналитики(СтрАналитика.Значение),Элемент.ТекущиеДанные["Аналитика"+ИндАналитики]);
				 ИндАналитики = ИндАналитики +1;
			Иначе	
				тБыстрыеОтборы   = ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].НайтиСтроки(Новый Структура("ОсьТаблицы,КодПоля",ПредопределенноеЗначение("Перечисление.ОсиСводнойТаблицы.Отборы"),СтрАналитика.Представление));
				Если тБыстрыеОтборы.Количество() = 1 Тогда
					СтруктураРасшифровки.Вставить(СтрАналитика.Представление,ЭтаФорма[СтрАналитика.Представление]);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	

	Возврат СтруктураРасшифровки;
		
КонецФункции 

