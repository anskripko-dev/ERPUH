#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	УстановитьОтображениеЗаголовкаИЭлементовУправления();
	Элементы.СчетаУчета.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивДоступныхСчетов()); 

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

 #Область ОбработчикиКомандФормы
 
&НаКлиенте
Процедура КнопкаНазад(Команда)
			
	Если Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаОформлениеДокументов Тогда  
		ПереходНаШаг(Элементы.СтраницаСписаниеОстатков);    
	Иначе 		                
		ПереходНаШаг(Элементы.СтраницаНастройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаДалее(Команда)
	
	ТекущаяСтраница = Элементы.ОсновнаяПанель.ТекущаяСтраница;
	Если ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		ПереходНаШаг(Элементы.СтраницаСписаниеОстатков);
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаСписаниеОстатков Тогда
		ПереходНаШаг(Элементы.СтраницаОформлениеДокументов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаЗакрыть(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументыСписанияОстатков(Команда)    
	
	ОчиститьСообщения(); 
	
	Если Не ЗначениеЗаполнено(ОрганизацияФилиал) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию-филиал!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтатьяРасходов) Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить статью расходов!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСписанияОстатков) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату списания остатков!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СчетСписания) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить счет списания!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда  
		Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл загрузки!");
			Возврат;
		КонецЕсли;  
		Загрузить();  
	КонецЕсли;
	
	СформироватьДокументыСписанияОстатковНаСервере();   
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументыВводаНачальныхОстатков(Команда)  
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСписанияОстатков) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату списания остатков!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда 
		Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл загрузки!");
			Возврат;
		КонецЕсли;  
		Загрузить();  
	КонецЕсли;
	
	СформироватьДокументыВводаНачальныхОстатковНаСервере();  
	
КонецПроцедуры 

&НаКлиенте
Процедура Загрузить()
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьДанные(АдресХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузкуОстатков(Команда) 
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать файл для выгрузки!");
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент; 
	ЗаполнитьТабличныйДокумент(ТабДок);  
	ТабДок.Записать(ПутькФайлу, ТипФайлаТабличногоДокумента.XLSX);   
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Выгрузка данных успешно завершена!");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстатки(Команда)
	
	ОчиститьСообщения();          
	
	Если Не ЗначениеЗаполнено(ОрганизацияФилиал) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить организацию!");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПолученияОстатков) Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить дату получения остатков!");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();   
	Элементы.ГруппаДанные.Показать(); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьТабличныйДокумент(ТабДок) 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("МакетВыгрузки");	 
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого Строка Из Объект.ТаблицаДанных Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Строка);  
		
		ОбластьСтрока.Параметры.НоменклатураID     = ?(ЗначениеЗаполнено(Строка.Номенклатура), Строка(Строка.Номенклатура.УникальныйИдентификатор()), "");	
		ОбластьСтрока.Параметры.ПодразделениеID    = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка(Строка.Подразделение.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.СкладID            = ?(ЗначениеЗаполнено(Строка.Склад), Строка(Строка.Склад.УникальныйИдентификатор()), "");
		ОбластьСтрока.Параметры.ВидДеятельностиНДС = ?(ЗначениеЗаполнено(Строка.ВидДеятельностиНДС), Строка(ПолучитьИмяПеречисления(Строка.ВидДеятельностиНДС)), "");
		
		ТабДок.Вывести(ОбластьСтрока); 
		
	КонецЦикла;
		
	Возврат(ТабДок);
	
КонецФункции  

&НаСервере
Функция ПолучитьИмяПеречисления(ПеречислениеСсылка)
	
	ИмяПеречисления = ПеречислениеСсылка.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ПеречислениеСсылка);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя; 
	
	Возврат ИмяЗначенияПеречисления;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанные(АдресХранилища)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла   = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(1,1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаДанных = Построитель.Результат.Выгрузить();
	УдалитьФайлы(ВремИмяФайла);     
	
	Если ОтсутствуютОбязательныеКолонкиВФайле(ТаблицаДанных) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаДанных Цикл
		
		НС = Объект.ТаблицаДанных.Добавить();	
		
		ЗаполнитьЗначенияСвойств(НС, Строка);

		НС.Склад              = ?(ЗначениеЗаполнено(Строка.СкладID),            ПреобразоватьЗначениеИзСтроки(Строка.СкладID,            "Справочник",   "Склады"),                 Неопределено);	
		НС.Подразделение      = ?(ЗначениеЗаполнено(Строка.ПодразделениеID),    ПреобразоватьЗначениеИзСтроки(Строка.ПодразделениеID,    "Справочник",   "СтруктураПредприятия"),   Неопределено);	
		НС.Номенклатура       = ?(ЗначениеЗаполнено(Строка.НоменклатураID),     ПреобразоватьЗначениеИзСтроки(Строка.НоменклатураID,     "Справочник",   "Номенклатура"),           Неопределено);
		НС.ВидДеятельностиНДС = ?(ЗначениеЗаполнено(Строка.ВидДеятельностиНДС), ПреобразоватьЗначениеИзСтроки(Строка.ВидДеятельностиНДС, "Перечисление", "ТипыНалогообложенияНДС"), Неопределено);		
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПреобразоватьЗначениеИзСтроки(СтрЗначение, Тип, Вид)
	
	Если Тип = "Перечисление" Тогда
		Результат = Перечисления[Вид][СтрЗначение];
	ИначеЕсли Тип = "Справочник" Тогда
		Результат = Справочники[Вид].ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗначение));   
	Иначе
		Результат = СтрЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивДоступныхСчетов() 
	
	МассивСчетов = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Хозрасчетный.Ссылка КАК Счет
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Родитель = &Родитель
	|	И НЕ Хозрасчетный.Ссылка В ИЕРАРХИИ (&МассивИсключений)";
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить(ПланыСчетов.Хозрасчетный.СпецоснасткаИСпецодеждаВЭксплуатации);  
	МассивИсключений.Добавить(ПланыСчетов.Хозрасчетный.МатериалыПереданныеВПереработку); 
	МассивИсключений.Добавить(ПланыСчетов.Хозрасчетный.ДопРасходыМатериалы); 
	Запрос.УстановитьПараметр("МассивИсключений", МассивИсключений);
	Запрос.УстановитьПараметр("Родитель", ПланыСчетов.Хозрасчетный.Материалы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСчетов.Добавить(Выборка.Счет);	
	КонецЦикла;
	Возврат МассивСчетов;  
	
КонецФункции

&НаСервере
Функция ОтсутствуютОбязательныеКолонкиВФайле(Таблица)
		
	Колонки = Таблица.Колонки;
	
	МассивОбязательныхКолонок = Новый Массив;    
	МассивОбязательныхКолонок.Добавить("КоличествоОстаток"); 
	МассивОбязательныхКолонок.Добавить("СтоимостьОстаток");
	МассивОбязательныхКолонок.Добавить("СтоимостьБезНДСОстаток");
	МассивОбязательныхКолонок.Добавить("КоличествоОстаток");
	МассивОбязательныхКолонок.Добавить("СтоимостьРеглОстаток");
	МассивОбязательныхКолонок.Добавить("ПостояннаяРазницаОстаток");      
	МассивОбязательныхКолонок.Добавить("ВременнаяРазницаОстаток");
	МассивОбязательныхКолонок.Добавить("РезервПодОбесценениеУпрОстаток");
	МассивОбязательныхКолонок.Добавить("ВидДеятельностиНДС");
	МассивОбязательныхКолонок.Добавить("НоменклатураID");
	МассивОбязательныхКолонок.Добавить("ПодразделениеID");	
	
	Для Каждого ОбязательнаяКолонка Из МассивОбязательныхКолонок Цикл
		
		Если КолонкаОтсутствует(Колонки, ОбязательнаяКолонка) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции 

&НаСервере
Функция КолонкаОтсутствует(Колонки, ИмяКолонки)
	
	Если Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В файле отсутствует колонка ""%1"". Исправьте или выгрузите файл заново.", ИмяКолонки));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции 
	
&НаСервере
Процедура УстановитьОтображениеЗаголовкаИЭлементовУправления()
	
	ТекущаяСтраница = Элементы.ОсновнаяПанель.ТекущаяСтраница;
	
	ЗаголовкиСтраниц = Новый Соответствие;
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаНастройки, "Шаг 1 из 3 «Получение остатков по организации-филиалу по счету 10 в группе (исключая счета 10.11,10.07, 10.ДР)»");       
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаСписаниеОстатков, "Шаг 2 из 3 «Списание остатков с организации филиала»");
	ЗаголовкиСтраниц.Вставить(Элементы.СтраницаОформлениеДокументов, "Шаг 3 из 3 «Ввод остатков на головную организацию»");
	
	Элементы.ДекорацияЗаголовокСтраницы.Заголовок = ЗаголовкиСтраниц[ТекущаяСтраница];
	
	Элементы.КнопкиСлева.ТекущаяСтраница = ?(ТекущаяСтраница = Элементы.СтраницаНастройки,
																Элементы.ГруппаКнопокСлеваНет,
																Элементы.ГруппаКнопкиСлеваЕсть);

	Если ТекущаяСтраница = Элементы.СтраницаОформлениеДокументов Тогда
		Элементы.КнопкиСправа.ТекущаяСтраница   = Элементы.ГруппаКнопкиСправаНаПоследнейСтранице;
		Элементы.КнопкаГотово.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.КнопкиСправа.ТекущаяСтраница  = Элементы.ГруппаКнопкиСправаНаПервойСтранице;
		Элементы.КнопкаДалее.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ПереходНаШаг(Страница)
	
	Элементы.ОсновнаяПанель.ТекущаяСтраница = Страница;
	УстановитьОтображениеЗаголовкаИЭлементовУправления();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыСписанияОстатковНаСервере()	
	
	ТаблицаПоВидам = Объект.ТаблицаДанных.Выгрузить(,"Склад, Подразделение, ВидДеятельностиНДС"); 
	ТаблицаПоВидам.Свернуть("Склад, Подразделение, ВидДеятельностиНДС");
	ТаблицаПодготовленныхДанных = Объект.ТаблицаДанных.Выгрузить();	
	Для Каждого Строка Из ТаблицаПоВидам Цикл
		СформироватьДокументыСписанияОстатковПоВидам(ТаблицаПодготовленныхДанных, Строка.Склад, Строка.Подразделение, Строка.ВидДеятельностиНДС);
	КонецЦикла;
		
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ДокументыСписания.Количество());
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыСписанияОстатковПоВидам(ТаблицаПодготовленныхДанных, Склад, Подразделение, ВидДеятельностиНДС)
	
	ТаблицаПроверки = ПолучитьТаблицуПроверки(ДатаСписанияОстатков, ОрганизацияФилиал, Объект.ТаблицаДанных.Выгрузить(,"Номенклатура, Склад"));
		
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Склад", Склад);
	СтруктураПоиска.Вставить("Подразделение",  Подразделение); 
	СтруктураПоиска.Вставить("ВидДеятельностиНДС",  ВидДеятельностиНДС); 
	
	НайденныеСтроки = ТаблицаПодготовленныхДанных.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда   
		Возврат;	
	КонецЕсли;
	
	ДокументОбъект = Документы.СписаниеНедостачТоваров.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, НайденныеСтроки[0]);
	Ссылка = Документы.СписаниеНедостачТоваров.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ДокументОбъект.УстановитьСсылкуНового(Ссылка);
	
	ДокументОбъект.НастройкаСчетовУчета = Справочники.НастройкиСчетовУчетаПрочихОпераций.ВернутьНастройкаСчетовУчета(Ссылка, СчетСписания, Организация);
		
	Для Каждого Строка Из НайденныеСтроки Цикл   
		
		НайденныеСтрокиСписания = ТаблицаПроверки.НайтиСтроки(Новый Структура("Номенклатура, Склад", Строка.Номенклатура, Строка.Склад));
		Если НайденныеСтрокиСписания.Количество() > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("По номенклатуре %1 уже списаны остатки ТМЦ по складу %2", Строка.Номенклатура, Строка.Склад));   
			Продолжить;
		КонецЕсли;
		
		СтрокаЗадолженность = ДокументОбъект.Товары.Добавить();
		СтрокаЗадолженность.Номенклатура = Строка.Номенклатура; 
		СтрокаЗадолженность.Количество   = Строка.КоличествоОстаток; 
	КонецЦикла; 
	
	Если ДокументОбъект.Товары.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ДокументОбъект.СтатьяРасходов        = СтатьяРасходов;      
	ДокументОбъект.Организация           = ОрганизацияФилиал;      
	ДокументОбъект.Автор                 = ТекущийПользователь;    
	ДокументОбъект.Дата                  = КонецДня(ДатаСписанияОстатков);
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДокументОбъект.Комментарий           = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДата();
	ДокументОбъект.Комментарий           = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	ДокументОбъект.ИсточникИнформацииОЦенахДляПечати = Перечисления.ИсточникиИнформацииОЦенахДляПечати.ПоВидуЦен;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение					
		ДокументОбъект.УстановитьНовыйНомер();
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
	КонецПопытки;
	
	НС = ДокументыСписания.Добавить();  
	НС.Документ = ДокументОбъект.Ссылка;  
	НС.Подразделение = ДокументОбъект.Подразделение;
	НС.Склад = Склад;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуПроверки(ДатаСписания, Организация, Таблица)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Склад КАК Склад
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	&Таблица КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РегистрАналитикаУчетаНоменклатуры.КлючАналитики КАК КлючАналитики
	|ПОМЕСТИТЬ ВТ_АналитикаУчетаНоменклатуры
	|ИЗ
	|	РегистрСведений.АналитикаУчетаНоменклатуры КАК РегистрАналитикаУчетаНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|		ПО РегистрАналитикаУчетаНоменклатуры.Номенклатура = ВТ_ТаблицаДанных.Номенклатура
	|			И РегистрАналитикаУчетаНоменклатуры.МестоХранения = ВТ_ТаблицаДанных.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад
	|ПОМЕСТИТЬ вт_Остатки
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(
	|			&Граница,
	|			Организация = &Организация
	|				И АналитикаУчетаНоменклатуры В
	|					(ВЫБРАТЬ
	|						РегистрАналитикаУчетаНоменклатуры.КлючАналитики КАК АналитикаУчетаПоПартнерам
	|					ИЗ
	|						ВТ_АналитикаУчетаНоменклатуры КАК РегистрАналитикаУчетаНоменклатуры)) КАК РасчетыСКлиентамиОстатки
	|ГДЕ
	|	РасчетыСКлиентамиОстатки.КоличествоОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаДанных.Склад КАК Склад
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Остатки КАК вт_Остатки
	|		ПО ВТ_ТаблицаДанных.Номенклатура = вт_Остатки.Номенклатура
	|			И ВТ_ТаблицаДанных.Склад = вт_Остатки.Склад
	|ГДЕ
	|	вт_Остатки.Номенклатура ЕСТЬ NULL";

	Запрос.УстановитьПараметр("Таблица", Таблица); 
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(ДатаСписания), ВидГраницы.Включая));   
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура СформироватьДокументыВводаНачальныхОстатковНаСервере()

	ТаблицаПоВидам = Объект.ТаблицаДанных.Выгрузить(,"Подразделение"); 
	ТаблицаПоВидам.Свернуть("Подразделение");      
	ТаблицаПодготовленныхДанных = Объект.ТаблицаДанных.Выгрузить();
	Для Каждого Строка Из ТаблицаПоВидам Цикл
		СформироватьДокументыВводаНачальныхОстатковНаСервереПоПодразделениям(ТаблицаПодготовленныхДанных, Строка.Подразделение);
	КонецЦикла;
		
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + ДокументыВводаНачальныхОстатков.Количество());
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыВводаНачальныхОстатковНаСервереПоПодразделениям(ТаблицаПодготовленныхДанных, Подразделение)
		
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Подразделение",  Подразделение); 
	
	НайденныеСтроки = ТаблицаПодготовленныхДанных.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда   
		Возврат;	
	КонецЕсли;
	
	ДокументОбъект = Документы.ВводОстатковТоваров.СоздатьДокумент();

	ДокументОбъект.Дата			             = КонецДня(ДатаПолученияОстатков);
	ДокументОбъект.Менеджер		             = ?(ЗначениеЗаполнено(Менеджер), Менеджер, ТекущийПользователь);
	ДокументОбъект.Ответственный	         = ТекущийПользователь;
	ДокументОбъект.ХозяйственнаяОперация	 = Перечисления.ХозяйственныеОперации.ВводОстатковСобственныхТоваров;
	ДокументОбъект.Организация	             = Организация;
	ДокументОбъект.Склад	 	             = СкладОстатка;
	ДокументОбъект.Подразделение             = Подразделение;
	ДокументОбъект.ОтражатьВБУиНУ	         = Истина;
	ДокументОбъект.ОтражатьВУУ   	         = Ложь;
	//НАЧАЛО Блинова М.А. 27.02.2026 Выполнение задач №000056898
	//ДокументОбъект.ЦенаВключаетНДС           = Истина;
	//КОНЕЦ Блинова М.А. 27.02.2026 Выполнение задач №000056898
	ДокументОбъект.ОтражатьСебестоимость	 = Истина;
	ДокументОбъект.ОтражатьВОперативномУчете = Истина;
	ДокументОбъект.ВидДеятельностиНДС		 = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ДокументОбъект.Комментарий               = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДата();
	ДокументОбъект.Комментарий               = "Создан обработкой переноса остатков с филиала на головную организацию " + ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Для Каждого Стр Из НайденныеСтроки Цикл
				
		Если Стр.КоличествоОстаток = 0 
			Или (Стр.СтоимостьОстаток = 0 
			И Стр.СтоимостьБезНДСОстаток = 0    
			И Стр.РезервПодОбесценениеУпрОстаток = 0     
			И Стр.ПостояннаяРазницаОстаток = 0    
			И Стр.ВременнаяРазницаОстаток = 0
			И Стр.СтоимостьРеглОстаток = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Товар = ДокументОбъект.Товары.Добавить();
		Товар.Номенклатура		 = Стр.Номенклатура;
		//НАЧАЛО Блинова М.А. 27.02.2026 Выполнение задач №000056898
		//Товар.Сумма				 = Стр.СтоимостьОстаток; 
		Товар.Сумма				 = Стр.СтоимостьБезНДСОстаток +  Стр.СуммаДопРасходовБезНДС; 
        //КОНЕЦ Блинова М.А. 27.02.2026 Выполнение задач №000056898
		Товар.СуммаСНДС			 = Стр.СтоимостьОстаток;
		Товар.СуммаБезНДС	     = Стр.СтоимостьБезНДСОстаток;   
		Товар.СуммаНДС           = Товар.СуммаСНДС - Товар.СуммаБезНДС;	
		
		Товар.КоличествоУпаковок = Стр.КоличествоОстаток;
		Товар.Количество		 = Стр.КоличествоОстаток;
		//НАЧАЛО Блинова М.А. 27.02.2026 Выполнение задач №000056898
		//Товар.СуммаРегл          = Стр.СтоимостьРеглОстаток;
		Товар.СуммаРегл          = Стр.СтоимостьБезНДСОстаток +  Стр.СуммаДопРасходовБезНДС;
		//КОНЕЦ Блинова М.А. 27.02.2026 Выполнение задач №000056898

		//НАЧАЛО Блинова М.А. 27.02.2026 Выполнение задач №000056898
		//Товар.Цена               = Стр.СтоимостьОстаток;            
		//Товар.СтавкаНДС          = УчетНДСУП.СтавкаНДСНоменклатуры(Товар.Номенклатура, , ДокументОбъект.Дата);  
		Если НЕ Стр.КоличествоОстаток = 0 Тогда
				Товар.Цена = (Стр.СтоимостьБезНДСОстаток +  Стр.СуммаДопРасходовБезНДС)/Товар.Количество;  
		КонецЕсли;
		Товар.СтавкаНДС          = Справочники.СтавкиНДС.БезНДС;
		//КОНЕЦ Блинова М.А. 27.02.2026 Выполнение задач №000056898
        Товар.СуммаПР            = Стр.ПостояннаяРазницаОстаток;
        Товар.СуммаВР            = Стр.ВременнаяРазницаОстаток;
		//НАЧАЛО Блинова М.А. 20.02.2026 Выполнение задач №000056838
		//Товар.НДСРегл            = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Товар.СуммаРегл, Ложь, ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Товар.СтавкаНДС, "Ставка"));	
		Ставка = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Товар.СтавкаНДС, "Ставка"); 
		Ставка = ?(Ставка = Неопределено, 0, Ставка);
		Товар.НДСРегл            = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Товар.СуммаРегл, Ложь, Ставка);	
		//КОНЕЦ Блинова М.А. 20.02.2026 Выполнение задач №000056838
		Товар.РезервПодОбесценениеУпр = Стр.РезервПодОбесценениеУпрОстаток;
		
	КонецЦикла;

	Если ДокументОбъект.Товары.Количество() > 0 Тогда	
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокументОбъект.Ссылка, ДокументОбъект.Ссылка);
		КонецПопытки;   
		
		НС = ДокументыВводаНачальныхОстатков.Добавить();
		НС.Документ = ДокументОбъект.Ссылка;   
		НС.Подразделение = Подразделение;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК Счет,
	|	ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
	|	ХозрасчетныйОстатки.Субконто2 КАК Склады
	|ПОМЕСТИТЬ втХозрасчетный
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&КонецПериодаГраница, Счет В (&Счета), &Субконто, Организация = &Организация
	| //УсловиеСкладХозрасчетный 
	| ) КАК ХозрасчетныйОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад,
	|	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваровОстатки.РазделУчета КАК РазделУчета,
	|	СебестоимостьТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	СебестоимостьТоваровОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СебестоимостьТоваровОстатки.СтоимостьБезНДСОстаток КАК СтоимостьБезНДСОстаток,
	|	СебестоимостьТоваровОстатки.СтоимостьЗабалансоваяОстаток КАК СтоимостьЗабалансоваяОстаток,
	|	СебестоимостьТоваровОстатки.СтоимостьРеглОстаток КАК СтоимостьРеглОстаток,
	|	СебестоимостьТоваровОстатки.ПостояннаяРазницаОстаток КАК ПостояннаяРазницаОстаток,
	|	СебестоимостьТоваровОстатки.ВременнаяРазницаОстаток КАК ВременнаяРазницаОстаток,
	|	СебестоимостьТоваровОстатки.СтоимостьУпрОстаток КАК СтоимостьУпрОстаток,
	|	СебестоимостьТоваровОстатки.РезервПодОбесценениеУпрОстаток КАК РезервПодОбесценениеУпрОстаток,
	|	СебестоимостьТоваровОстатки.РезервПодОбесценениеРеглОстаток КАК РезервПодОбесценениеРеглОстаток,
	|	СебестоимостьТоваровОстатки.ВидДеятельностиНДС КАК ВидДеятельностиНДС,
	|	СебестоимостьТоваровОстатки.ВидЗапасов КАК ВидЗапасов,
	|	СебестоимостьТоваровОстатки.Организация КАК Организация,
	|	СебестоимостьТоваровОстатки.Партия КАК Партия,   
