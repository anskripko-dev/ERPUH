// Белоконенко Денис 25.10.2022 Выполнение задач №000043105
Функция ПолучитьРеквизитыТЧ(МассивДокументов)
	
	ЗначенияРеквизитов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрочиеДоходыРасходыПрочиеРасходы.Ссылка КАК Ссылка,
		|	ПрочиеДоходыРасходыПрочиеРасходы.НаправлениеДеятельности КАК НаправлениеДеятельности
		|ИЗ
		|	Документ.ПрочиеДоходыРасходы.ПрочиеРасходы КАК ПрочиеДоходыРасходыПрочиеРасходы
		|ГДЕ
		|	ПрочиеДоходыРасходыПрочиеРасходы.Ссылка В(&МассивДокументов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрочиеДоходыРасходыПрочиеРасходы.Ссылка,
		|	ПрочиеДоходыРасходыПрочиеРасходы.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Новый Структура("НаправлениеДеятельности");
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗначенияРеквизитов[Выборка.Ссылка] = Результат;
	КонецЦикла;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

//Климов Антон 17.05.2023 Выполнение задач №000045477
// Получаем соответствие Идентификатор - Ссылка по массиву идентификаторов и предмету поиска:
//	- Предмент поиска : Строка - "Контрагенты", "Договоры", "ВидыВзаиморасчетов", "ВидыДоговоров", "Валюты"
//	- Идентификаторы - массив идентификаторов:
//			для Контрагентов 	- GUID
//			для Договоров		- Код договороа УПП
//			для ВидовВзаиморасчетов - GUID
//			для ВидовДоговоров	- наименование 
//			для Валют			- Код
Функция ПолучитьСоответствияСсылокИдентификаторам(мИдентификаторы, ПредметПоиска = "")
	
	мИдентификаторы = ОбщегоНазначенияКлиентСервер.СвернутьМассив(мИдентификаторы);
	ИдентификаторыСсылки = Новый Соответствие;
	
	Для Каждого Идентификатор Из мИдентификаторы Цикл
		
		Ссылка = Неопределено;
		
		Если ПредметПоиска = "Контрагенты" Тогда
			Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		ИначеЕсли ПредметПоиска = "Договоры" Тогда
			Ссылка = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		ИначеЕсли ПредметПоиска = "ВидыВзаиморасчетов" Тогда
			Ссылка = Справочники.тн_ВидыВзаиморасчетов.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		ИначеЕсли ПредметПоиска = "ВидыДоговоров" Тогда
			Ссылка = Справочники.ВидыДоговоровКонтрагентовУХ.НайтиПоНаименованию(Идентификатор);
		ИначеЕсли ПредметПоиска = "Валюты" Тогда
			Ссылка = Справочники.Валюты.НайтиПоКоду(Идентификатор);  
		//НАЧАЛО Блинова М.А. 14.03.2024 Выполнение задач №000048144	
		ИначеЕсли ПредметПоиска = "Организации" Тогда
			Ссылка = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	    //КОНЕЦ Блинова М.А. 14.03.2024 Выполнение задач №000048144

		КонецЕсли;
		
		ИдентификаторыСсылки.Вставить(Идентификатор, Ссылка);
		
	КонецЦикла;
	
	Возврат ИдентификаторыСсылки;
	
КонецФункции

// Климов Антон 17.05.2023 Выполнение задач №000045477
Функция ПолучитьДочерниеСегменты(СегментыПартнера)
	
	//СписокМассива = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СегментыПартнеров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СегментыПартнеров КАК СегментыПартнеров
	               |ГДЕ
	               |	СегментыПартнеров.Ссылка В ИЕРАРХИИ(&СегментПартнера)";
	Если СегментыПартнера.Количество() Тогда
		Запрос.УстановитьПараметр("СегментПартнера", СегментыПартнера[0]);
		МассивСегментов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСегментов, СегментыПартнера);
		МассивСегментов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСегментов);
	Иначе
		МассивСегментов = Новый Массив;
	КонецЕсли;
	
	Возврат МассивСегментов;
	
КонецФункции

//Блинова М.А. 09.04.2025 Выполнение задач №000053284      
Функция ПолучитьСкладоОтправитель(Регистратор); 
	
	Складоотправитель = "";
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда  
		Распоряжение = Регистратор.Распоряжение;
		Если ЗначениеЗаполнено(Распоряжение) И ТипЗнч(Распоряжение) = Тип("ДокументСсылка.СборкаТоваров") Тогда 
			Складоотправитель = Распоряжение.Подразделение;
		Иначе	
			Складоотправитель = Регистратор.Отправитель;
		КонецЕсли; 
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Складоотправитель = Регистратор.Склад;
	КонецЕсли;
	Возврат Складоотправитель;
КонецФункции    

