	МассивВозврат = Новый Массив();
	
	СтруктураРазделов = ПолучитьСтруктуруРазделов();
	Для Каждого КлючЗначение Из СтруктураРазделов Цикл
		Если ЭтотОбъект["Активно_" + КлючЗначение.Ключ] Тогда
			МассивВозврат.Добавить(КлючЗначение.Ключ);
