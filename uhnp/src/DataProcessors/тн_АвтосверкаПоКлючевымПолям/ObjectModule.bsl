							ИмяКолонки = СтрокаТаблицыСоответствия.ИмяКолонкиСКД + "_" + АктивныйРаздел;   
							
							НастройкиКомпоновщика = СтруктураПараметров.КомпоновщикНастроек.ПолучитьНастройки();
