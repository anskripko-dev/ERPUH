	СтруктураСоответствияМакетовСКД.Вставить("Склад", "ERP_СкладОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("Пользователь", "ERP_ПользовательОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("Контрагент", "ERP_КонтрагентОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("СтатьяРасходов", "ERP_СтатьяРасходовОтбор");
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	СтруктураСоответствияМакетовСКД.Вставить("Банк", "ERP_БанкОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("Касса", "ERP_КассаОтбор");
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	СтруктураСоответствияМакетовСКД.Вставить("Сегмент", "ERP_СегментОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("ВидДоговора", "ERP_ВидДоговораОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("ВидВзаиморасчетов", "ERP_ВидВзаиморасчетовОтбор");
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	СтруктураСоответствияМакетовСКД.Вставить("СтатьяДоходов", "ERP_СтатьяДоходовОтбор");
	СтруктураСоответствияМакетовСКД.Вставить("Подразделение", "ERP_ПодразделениеОтбор");
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	//НАЧАЛО Блинова М.А. 12.02.2024 Выполнение задач №000048144  
	СтруктураСоответствияМакетовСКД.Вставить("Организация", "ERP_ОрганизацияОтбор");
	//КОНЕЦ Блинова М.А. 12.02.2024 Выполнение задач №000048144  

	Для Каждого КлючЗначение Из СтруктураСоответствияМакетовСКД Цикл
		СтрокаНастройкиСКД = НастройкиСКД.Добавить();
		ИдентификаторХранилища = Новый УникальныйИдентификатор();
		СтрокаНастройкиСКД.Идентификатор = ИдентификаторХранилища;
		СтрокаНастройкиСКД.ИмяКолонки = КлючЗначение.Ключ;
		МакетКомпоновки = ПолучитьМакет(КлючЗначение.Значение);
		СтрокаНастройкиСКД.URL_СКД = ПоместитьВоВременноеХранилище(МакетКомпоновки, ИдентификаторХранилища);
	КонецЦикла;
	
КонецПроцедуры

