		ТаблицаСтатейДоходов = ПолучитьТаблицуСтатейДоходов_ERP(КодыСтатейДоходов);
		
		Для Каждого СтрокаПриемник Из ТаблицаПриемник Цикл
			СтрокаПриемник.Подразделение = Справочники.СтруктураПредприятия.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаПриемник.id_Department));
			СтрокаПриемник.СтатьяДоходов = ПолучитьСтатьюДоходов_ERP(ТаблицаСтатейДоходов, СтрокаПриемник.id_IncomeItem);
		КонецЦикла;	
		
		ЗапросДанных = Новый Запрос();
		ЗапросДанных.Текст = "ВЫБРАТЬ
		|	ТаблицаERP.Подразделение КАК Подразделение,
		|	ВЫРАЗИТЬ(ТаблицаERP.id_Department КАК СТРОКА(36)) КАК Идентификатор_Подразделение,
		|	ВЫРАЗИТЬ(ТаблицаERP.id_IncomeItem КАК СТРОКА(36)) КАК Идентификатор_СтатьяДоходов,
		|	ТаблицаERP.qount КАК СуммаДоходов_ERP,
		|	ТаблицаERP.СтатьяДоходов КАК СтатьяДоходов,
		|	ВЫРАЗИТЬ(ТаблицаERP.id_Document КАК СТРОКА (36)) КАК Идентификатор_Документ_ERP,
		|	ТаблицаERP.Регистратор КАК Документ_ERP,
		|	ТаблицаERP.name_Document КАК Наименование_Документ_ERP
		|ПОМЕСТИТЬ ВТ_ТаблицаERP
		|ИЗ
		|	&ТаблицаERP КАК ТаблицаERP
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_Подразделение,
		|	Идентификатор_СтатьяДоходов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОКС.name_OKS_Department КАК Наименование_ОКС_Подразделение,
		|	ТаблицаОКС.name_OKS_IncomeItem КАК Наименование_ОКС_СтатьяДоходов,
		|	ТаблицаОКС.code_OKS_Department КАК Код_ОКС_Подразделение,
		|	ВЫРАЗИТЬ(ТаблицаОКС.id_Department КАК СТРОКА(36)) КАК Идентификатор_Подразделение,
		|	ТаблицаОКС.qount КАК СуммаДоходов_ОКС,
		|	ВЫРАЗИТЬ(ТаблицаОКС.id_IncomeItem КАК СТРОКА(36)) КАК Идентификатор_СтатьяДоходов,
		|	ТаблицаОКС.Подразделение КАК Подразделение,
		|	ТаблицаОКС.СтатьяДоходов КАК СтатьяДоходов,
		|	ВЫРАЗИТЬ(ТаблицаОКС.id_Document КАК СТРОКА (36)) КАК Идентификатор_Документ_ОКС,
		|	ТаблицаОКС.name_Document КАК Наименование_Документ_ОКС
		|ПОМЕСТИТЬ ВТ_ТаблицаОКС
		|ИЗ
		|	&ТаблицаОКС КАК ТаблицаОКС
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_СтатьяДоходов,
		|	Идентификатор_Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Подразделение, ВТ_ТаблицаОКС.Подразделение) КАК Подразделение,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_Подразделение, ВТ_ТаблицаОКС.Идентификатор_Подразделение) КАК Идентификатор_Подразделение,
		|	ВТ_ТаблицаERP.Идентификатор_Документ_ERP КАК Идентификатор_Документ_ERP,
		|	ВТ_ТаблицаОКС.Идентификатор_Документ_ОКС КАК Идентификатор_Документ_ОКС,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_СтатьяДоходов, ВТ_ТаблицаОКС.Наименование_ОКС_СтатьяДоходов) КАК Идентификатор_СтатьяДоходов,
		|	ВТ_ТаблицаERP.Документ_ERP КАК Документ_ERP,
		|	ВТ_ТаблицаОКС.Наименование_Документ_ОКС КАК Документ_ОКС,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.СтатьяДоходов, ВТ_ТаблицаОКС.СтатьяДоходов) КАК СтатьяДоходов,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.СуммаДоходов_ERP, 0) КАК СуммаДоходов_ERP,
		|	ЕСТЬNULL(ВТ_ТаблицаОКС.СуммаДоходов_ОКС, 0) КАК СуммаДоходов_ОКС,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.СуммаДоходов_ERP, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.СуммаДоходов_ОКС, 0) КАК ДельтаДок
		|ИЗ
		|	ВТ_ТаблицаERP КАК ВТ_ТаблицаERP
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТаблицаОКС КАК ВТ_ТаблицаОКС
		|		ПО ВТ_ТаблицаERP.Идентификатор_Подразделение = ВТ_ТаблицаОКС.Идентификатор_Подразделение
		|			И ВТ_ТаблицаERP.Идентификатор_Документ_ERP = ВТ_ТаблицаОКС.Идентификатор_Документ_ОКС
		|			И ВТ_ТаблицаERP.Идентификатор_СтатьяДоходов = ВТ_ТаблицаОКС.Идентификатор_СтатьяДоходов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ТаблицаERP
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ТаблицаОКС";
		
		ЗапросДанных.УстановитьПараметр("ТаблицаERP", ТаблицаИсточник);
		ЗапросДанных.УстановитьПараметр("ТаблицаОКС", ТаблицаПриемник);
		
		Результат = ЗапросДанных.Выполнить();
		Возврат Результат.Выгрузить();
		// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	КонецЕсли;
	
КонецФункции


// Устанавливает параметры настроек компоновки данных
//Параметры
//	Настройки - НастройкиКомпоновкиДанных, ПользовательскиеНастройкиКомпоновкиДанных, 
//		КомпоновщикНастроекКомпоновкиДанных - настройки СКД, для которых требуется установить параметры
//	УстанавливаемыеПараметры - Соответствие, в котором
//		* Ключ - Строка - имя параметра компоновки данных, как оно задано в схеме
//		* Значение - ПроизвольноеЗначение - устанавливаемое значение.
//
Процедура УстановитьКоллекциюПараметров(Настройки, УстанавливаемыеПараметры) Экспорт
	
	Если НЕ Настройки = Неопределено Тогда
		Для Каждого УстанавливаемыйПараметр Из УстанавливаемыеПараметры Цикл
			// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
			Если УстанавливаемыйПараметр.Значение = Неопределено Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(УстанавливаемыйПараметр.Значение) = Тип("Массив") Тогда
				Если УстанавливаемыйПараметр.Значение.Количество() = 0 Тогда
					// НАЧАЛО Климов Антон 23.04.2024 Выполнение задач №000049307
					КлючПараметра =  УстанавливаемыйПараметр.Ключ;
					ЗначениеПараметра = УстанавливаемыйПараметр.Значение;
					УстановитьПараметр(Настройки, КлючПараметра, ЗначениеПараметра, Ложь);
					// КОНЕЦ  Климов Антон 23.04.2024 Выполнение задач №000049307	
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
			КлючПараметра =  УстанавливаемыйПараметр.Ключ;
			ЗначениеПараметра = УстанавливаемыйПараметр.Значение;
			
			// НАЧАЛО Белоконенко Денис 26.02.2023 Выполнение задач №000044559
			// НАЧАЛО Белоконенко Денис 16.03.2023 Выполнение задач №000044804
			//Если ТипЗнч(ЗначениеПараметра) = Тип("Дата") Тогда
			Если УстанавливаемыйПараметр.Ключ = "ДатаОстатковГраница" Тогда	
			// КОНЕЦ Белоконенко Денис 16.03.2023 Выполнение задач №000044804
				ЗначениеПараметра = Новый Граница(ЗначениеПараметра, ВидГраницы.Включая);	
			КонецЕсли;
			// КОНЕЦ Белоконенко Денис 26.02.2023 Выполнение задач №000044559
			
			ЗначениеПараметраНастроек = ПолучитьПараметр(Настройки, КлючПараметра);
			Если НЕ ЗначениеПараметраНастроек = Неопределено Тогда
				ТипЗначенияПараметрыНастроек = ТипЗнч(ЗначениеПараметраНастроек.Значение);
				
				УстановитьПараметр(Настройки, КлючПараметра, ЗначениеПараметра, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает параметр настроек компоновки данных
//
// Параметры:
//	Настройки - НастройкиКомпоновкиДанных, ПользовательскиеНастройкиКомпоновкиДанных,
//		КомпоновщикНастроекКомпоновкиДанных - настройки КД, для которых требуется установить параметры
//	Параметр - Строка, ПараметрКомпоновкиДанных - параметр, который требуется установить
//	Значение - Произвольный - значение, которое требуется установить
//	Использование - Булево - признак использования параметра КД.
//
// Возвращаемое значение:
//	ЗначениеПараметраНастроекКомпоновкиДанных - установленный параметр настроек КД. Неопределено, если параметр на найден.
//
Функция УстановитьПараметр(Настройки, Параметр, Значение, Использование = Истина, Недоступный = Ложь) Экспорт
	ЗначениеПараметра = ПолучитьПараметр(Настройки, Параметр);
	
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Значение		= Значение;
		ЗначениеПараметра.Использование	= Использование;
		Если Недоступный Тогда
			ЗначениеПараметра.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
КонецФункции

// Возвращает значение параметра компоновки данных
//
// Параметры:
//	ОбъектНастройки	- НастройкиКомпоновкиДанных, ПользовательскиеНастройкиКомпоновкиДанных, КомпоновщикНастроекКомпоновкиДанных, 
//		НастройкиВложенногоОбъектаКомпоновкиДанных, ДанныеРасшифровкиКомпоновкиДанных, КоллекцияЗначенийПараметровКомпоновкиДанных,
//		ОформлениеКомпоновкиДанных
//	Параметр		- Строка, ПараметрКомпоновкиДанных - поле или имя поля, для которого нужно вернуть параметр.
//
// Возвращаемое значение:
//	ЗначениеПараметраНастроекКомпоновкиДанных - Неопределено, если параметр не найден.
//
Функция ПолучитьПараметр(ОбъектНастройки, Параметр) Экспорт
	
	ЗначениеПараметра = Неопределено;
	ПолеПараметр = ?(ТипЗнч(Параметр) = Тип("Строка"), Новый ПараметрКомпоновкиДанных(Параметр), Параметр);
	
	Если ТипЗнч(ОбъектНастройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастройки Из ОбъектНастройки.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ЭлементНастройки.Параметр = ПолеПараметр Тогда
				ЗначениеПараметра = ЭлементНастройки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастройки Из ОбъектНастройки.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ЭлементНастройки.Параметр = ПолеПараметр Тогда
				ЗначениеПараметра = ЭлементНастройки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеПараметра = Неопределено Тогда
			ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
		КонецЕсли;
		Если ЗначениеПараметра = Неопределено Тогда
			ЗначениеПараметра = ОбъектНастройки.ФиксированныеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ДанныеРасшифровкиКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("КоллекцияЗначенийПараметровКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.Найти(ПолеПараметр);
	ИначеЕсли ТипЗнч(ОбъектНастройки) = Тип("ОформлениеКомпоновкиДанных") Тогда
		ЗначениеПараметра = ОбъектНастройки.НайтиЗначениеПараметра(ПолеПараметр);
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
	
КонецФункции

// Копирует элементы из одной коллекции в другую
//
// Параметры:
//	ПриемникЗначения	- КоллекцияЗначенийПараметровКомпоновкиДанных, ЗначенияПараметровДанныхКомпоновкиДанных - коллекция элементов КД, куда копируются параметры
//	ИсточникЗначения	- КоллекцияЗначенийПараметровКомпоновкиДанных, ЗначенияПараметровДанныхКомпоновкиДанных - коллекция элементов КД, откуда копируются параметры
//	ОчищатьПриемник		- Булево - признак необходимости очистки приемника.
//
Процедура СкопироватьЭлементы(ПриемникЗначения, ИсточникЗначения, ОчищатьПриемник = Истина) Экспорт
	
	Если ТипЗнч(ИсточникЗначения) = Тип("УсловноеОформлениеКомпоновкиДанных")
		ИЛИ ТипЗнч(ИсточникЗначения) = Тип("ВариантыПользовательскогоПоляВыборКомпоновкиДанных")
		ИЛИ ТипЗнч(ИсточникЗначения) = Тип("ОформляемыеПоляКомпоновкиДанных")
		ИЛИ ТипЗнч(ИсточникЗначения) = Тип("ЗначенияПараметровДанныхКомпоновкиДанных") Тогда
		СоздаватьПоТипу = Ложь;
	Иначе
		СоздаватьПоТипу = Истина;
	КонецЕсли;
	ПриемникЭлементов = ПриемникЗначения.Элементы;
	ИсточникЭлементов = ИсточникЗначения.Элементы;
	Если ОчищатьПриемник Тогда
		ПриемникЭлементов.Очистить();
	КонецЕсли;
	
	Для каждого ЭлементИсточник Из ИсточникЭлементов Цикл
		
		Если ТипЗнч(ЭлементИсточник) = Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
			// Элементы порядка добавляем в начало
			Индекс = ИсточникЭлементов.Индекс(ЭлементИсточник);
			ЭлементПриемник = ПриемникЭлементов.Вставить(Индекс, ТипЗнч(ЭлементИсточник));
		Иначе
			Если СоздаватьПоТипу Тогда
				ЭлементПриемник = ПриемникЭлементов.Добавить(ТипЗнч(ЭлементИсточник));
			Иначе
				ЭлементПриемник = ПриемникЭлементов.Добавить();
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		// В некоторых коллекциях необходимо заполнить другие коллекции
		Если ТипЗнч(ИсточникЭлементов) = Тип("КоллекцияЭлементовУсловногоОформленияКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Поля, ЭлементИсточник.Поля);
			СкопироватьЭлементы(ЭлементПриемник.Отбор, ЭлементИсточник.Отбор);
			ЗаполнитьЭлементы(ЭлементПриемник.Оформление, ЭлементИсточник.Оформление); 
		ИначеЕсли ТипЗнч(ИсточникЭлементов)	= Тип("КоллекцияВариантовПользовательскогоПоляВыборКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Отбор, ЭлементИсточник.Отбор);
		КонецЕсли;
		
		// В некоторых элементах коллекции необходимо заполнить другие коллекции
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник, ЭлементИсточник);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник, ЭлементИсточник);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ПользовательскоеПолеВыборКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Варианты, ЭлементИсточник.Варианты);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных") Тогда
			ЭлементПриемник.УстановитьВыражениеДетальныхЗаписей (ЭлементИсточник.ПолучитьВыражениеДетальныхЗаписей());
			ЭлементПриемник.УстановитьВыражениеИтоговыхЗаписей(ЭлементИсточник.ПолучитьВыражениеИтоговыхЗаписей());
			ЭлементПриемник.УстановитьПредставлениеВыраженияДетальныхЗаписей(ЭлементИсточник.ПолучитьПредставлениеВыраженияДетальныхЗаписей ());
			ЭлементПриемник.УстановитьПредставлениеВыраженияИтоговыхЗаписей(ЭлементИсточник.ПолучитьПредставлениеВыраженияИтоговыхЗаписей ());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет одну коллекцию элементов настроек на основании другой
//
// Параметры:
//	ПриемникЗначения	- КоллекцияЗначенийПараметровКомпоновкиДанных, ЗначенияПараметровДанныхКомпоновкиДанных - коллекция элементов КД, куда копируются параметры
//	ИсточникЗначения	- КоллекцияЗначенийПараметровКомпоновкиДанных, ЗначенияПараметровДанныхКомпоновкиДанных - коллекция элементов КД, откуда копируются параметры
//	ПервыйУровень		- ЗначенияПараметровДанныхКомпоновкиДанных - уровень структуры коллекции элементов КД для копирования параметров.
//
Процедура ЗаполнитьЭлементы(ПриемникЗначения, ИсточникЗначения, ПервыйУровень = Неопределено) Экспорт
	
	Если ТипЗнч(ПриемникЗначения) = Тип("КоллекцияЗначенийПараметровКомпоновкиДанных") Тогда
		КоллекцияЗначений = ИсточникЗначения;
	Иначе
		КоллекцияЗначений = ИсточникЗначения.Элементы;
	КонецЕсли;
	
	Для каждого ЭлементИсточник Из КоллекцияЗначений Цикл
		Если ПервыйУровень = Неопределено Тогда
			ЭлементПриемник = ПриемникЗначения.НайтиЗначениеПараметра(ЭлементИсточник.Параметр);
		Иначе
			ЭлементПриемник = ПервыйУровень.НайтиЗначениеПараметра(ЭлементИсточник.Параметр);
		КонецЕсли;
		Если ЭлементПриемник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		Если ТипЗнч(ЭлементИсточник) = Тип("ЗначениеПараметраКомпоновкиДанных") Тогда
			Если ЭлементИсточник.ЗначенияВложенныхПараметров.Количество() <> 0 Тогда
				ЗаполнитьЭлементы(ЭлементПриемник.ЗначенияВложенныхПараметров, ЭлементИсточник.ЗначенияВложенныхПараметров, ПриемникЗначения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти //РаботаС_Компоновкой_Данных

#Область Работа_С_Сохраниением_И_Восстановлением_Настроек


Функция ПолучитьСтруктуруТекущихНастроекОбработки() Экспорт
	
	СтруктураСохраненияДанных = Новый Структура();
	
	СтруктураРазделовОбработка = ПолучитьСтруктуруРазделов();
	СтруктураРазделовТекущиеНастройки = Новый Структура();
	//1. получаем настройки по разделам
	Для Каждого КлючЗначение Из СтруктураРазделовОбработка Цикл
		ИмяТекущегоРаздела = КлючЗначение.Ключ; 
		СтруктураРаздела = Новый Структура("ИмяРаздела", ИмяТекущегоРаздела);
		
		АктивностьРазделаКлюч = "Активно_" + ИмяТекущегоРаздела;
		СтруктураРаздела.Вставить(АктивностьРазделаКлюч, ЭтотОбъект[АктивностьРазделаКлюч]);
				
		//Перенос Табличной части "НастройкиКомпоновки_"
		ТаблицаНастроекКомпоновки_Имя = "НастройкиКомпоновки_" + ИмяТекущегоРаздела;
		ТаблицаНастроекКомпоновки = ЭтотОбъект[ТаблицаНастроекКомпоновки_Имя].Выгрузить();
		
		СтруктураКолонокАдресаНастроекКомпоновщика = Новый Структура();
		Для Каждого Колонка_ТаблицаНастроекКомпоновки Из ТаблицаНастроекКомпоновки.Колонки Цикл
			Если СтрНайти(Колонка_ТаблицаНастроекКомпоновки.Имя, "АдресХранилищаНастроекКомпоновщика")>0 Тогда
				СтруктураКолонокАдресаНастроекКомпоновщика.Вставить(Колонка_ТаблицаНастроекКомпоновки.Имя, Колонка_ТаблицаНастроекКомпоновки.Имя + "_Настройки");	
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого КлючЗначение Из СтруктураКолонокАдресаНастроекКомпоновщика Цикл
			ТаблицаНастроекКомпоновки.Колонки.Добавить(КлючЗначение.Значение);
		КонецЦикла;
		
		Для Каждого Строка_ТаблицаНастроекКомпоновки Из ТаблицаНастроекКомпоновки Цикл
			Для Каждого КлючЗначение Из СтруктураКолонокАдресаНастроекКомпоновщика Цикл
				Строка_ТаблицаНастроекКомпоновки[КлючЗначение.Значение] = 
				ПолучитьИзВременногоХранилища(Строка_ТаблицаНастроекКомпоновки[КлючЗначение.Ключ]);
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого КлючЗначение Из СтруктураКолонокАдресаНастроекКомпоновщика Цикл
			ТаблицаНастроекКомпоновки.Колонки.Удалить(КлючЗначение.Ключ);
		КонецЦикла;
			
		СтруктураРаздела.Вставить(ТаблицаНастроекКомпоновки_Имя, ТаблицаНастроекКомпоновки);
		СтруктураРаздела.Вставить("СтруктураСоответствияКолонокАдресХранилищаНастроекКомпоновщика", СтруктураКолонокАдресаНастроекКомпоновщика);
		
		Если ИмяТекущегоРаздела = "ВРЧ" Тогда
			СтруктураРаздела.Вставить("ДатаСверкиНач_ВРЧ", ЭтотОбъект["ДатаСверкиНач_ВРЧ"]);	
		ИначеЕсли ИмяТекущегоРаздела = "ЗТР" Тогда	
			СтруктураРаздела.Вставить("ДатаСверкиНач_ЗТР", ЭтотОбъект["ДатаСверкиНач_ЗТР"]);
		ИначеЕсли ИмяТекущегоРаздела = "ОТН" Тогда
			СтруктураРаздела.Вставить("ДатаСверкиНач_ОТН", ЭтотОбъект["ДатаСверкиНач_ОТН"]); 
		// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
		ИначеЕсли ИмяТекущегоРаздела = "ДС" Тогда
			СтруктураРаздела.Вставить("ДатаСверкиНач_ДС", ЭтотОбъект["ДатаСверкиНач_ДС"]);
		// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886				
		// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
		ИначеЕсли ИмяТекущегоРаздела = "РСК" Тогда	
			СтруктураРаздела.Вставить("ДатаСверкиНач_РСК", ЭтотОбъект["ДатаСверкиНач_РСК"]);
		// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477		
		// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
		ИначеЕсли ИмяТекущегоРаздела = "ВРЧ_отб" Тогда
			СтруктураРаздела.Вставить("ДатаСверкиНач_ВРЧ_отб", ЭтотОбъект["ДатаСверкиНач_ВРЧ_отб"]);	
		ИначеЕсли ИмяТекущегоРаздела = "ЗТР_отб" Тогда	
			СтруктураРаздела.Вставить("ДатаСверкиНач_ЗТР_отб", ЭтотОбъект["ДатаСверкиНач_ЗТР_отб"]);
		ИначеЕсли ИмяТекущегоРаздела = "ОТН_отб" Тогда
			СтруктураРаздела.Вставить("ДатаСверкиНач_ОТН_отб", ЭтотОбъект["ДатаСверкиНач_ОТН_отб"]); 
		ИначеЕсли ИмяТекущегоРаздела = "ПД" Тогда	
			СтруктураРаздела.Вставить("ДатаСверкиНач_ПД", ЭтотОбъект["ДатаСверкиНач_ПД"]);
		// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
		КонецЕсли;
				
		СтруктураРазделовТекущиеНастройки.Вставить(ИмяТекущегоРаздела, СтруктураРаздела);
				
	КонецЦикла;
	
	СтруктураСохраненияДанных.Вставить("НастройкиРазделов", СтруктураРазделовТекущиеНастройки);
	СтруктураСохраненияДанных.Вставить("ДатаСохранения", ТекущаяДатаСеанса());
	СтруктураСохраненияДанных.Вставить("Пользователь", Пользователи.ТекущийПользователь());
	СтруктураСохраненияДанных.Вставить("НормативноеВремяОжиданияОтветаСекунд", НормативноеВремяОжиданияОтветаСекунд);
	// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	СтруктураСохраненияДанных.Вставить("КлючМаршрутизации", КлючМаршрутизации);
	// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	
	Возврат СтруктураСохраненияДанных;
	
КонецФункции

Функция СохранитьНастройкиОбработки() Экспорт
	
	СтруктураТекущихНастроек = ПолучитьСтруктуруТекущихНастроекОбработки();
	
	СтруктураЗаписиНастроек = Новый Структура();
	СтруктураЗаписиНастроек.Вставить("ИмяОбъекта", ИмяОбъектаСохраненияНастроек);
	СтруктураЗаписиНастроек.Вставить("НаименованиеНастройки", "Основная");
	СтруктураЗаписиНастроек.Вставить("ИспользоватьПриОткрытии", Истина);
	СтруктураЗаписиНастроек.Вставить("СохраненнаяНастройка", Новый ХранилищеЗначения(СтруктураТекущихНастроек));
	
	МенеджерЗаписи = РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписиНастроек);
	МенеджерЗаписи.Записать();
	
КонецФункции

Функция ЗагрузитьНастройкиОбработки() Экспорт
	
	СтруктураТекущихНастроек = ПолучитьСтруктуруСохраненныхНастроек();
	Если ТипЗнч(СтруктураТекущихНастроек) = Тип("Структура") Тогда
		
		НастройкиРазделов = СтруктураТекущихНастроек.НастройкиРазделов;
		Для Каждого НастройкаРаздела Из НастройкиРазделов Цикл
			Попытка
				ИмяТекущегоРаздела = НастройкаРаздела.Ключ;	
				СтруктураТекущегоРаздела = НастройкаРаздела.Значение;
				
				АктивностьРазделаКлюч = "Активно_" + ИмяТекущегоРаздела;
				ЭтотОбъект[АктивностьРазделаКлюч] = СтруктураТекущегоРаздела[АктивностьРазделаКлюч];
				
				ТаблицаНастройкиКомпоновки_Имя = "НастройкиКомпоновки_" + ИмяТекущегоРаздела;
				ТаблицаНастройкиКомпоновки = СтруктураТекущегоРаздела[ТаблицаНастройкиКомпоновки_Имя];
				
				СтруктураСоответствияКолонокАдресХранилищаНастроекКомпоновщика = СтруктураТекущегоРаздела.СтруктураСоответствияКолонокАдресХранилищаНастроекКомпоновщика;
				Для Каждого КлючЗначение Из СтруктураСоответствияКолонокАдресХранилищаНастроекКомпоновщика Цикл
					ТаблицаНастройкиКомпоновки.Колонки.Добавить(КлючЗначение.Ключ);
				КонецЦикла;
				
				Для Каждого СтрокаТаблицаНастройкиКомпоновки Из ТаблицаНастройкиКомпоновки Цикл
					Для Каждого КлючЗначение Из СтруктураСоответствияКолонокАдресХранилищаНастроекКомпоновщика Цикл
						СтрокаТаблицаНастройкиКомпоновки[КлючЗначение.Ключ] = ПоместитьВоВременноеХранилище(СтрокаТаблицаНастройкиКомпоновки[КлючЗначение.Значение], Новый УникальныйИдентификатор());	
					КонецЦикла;
				КонецЦикла;
				
				ЭтотОбъект[ТаблицаНастройкиКомпоновки_Имя].Загрузить(ТаблицаНастройкиКомпоновки);
				
				Если ИмяТекущегоРаздела = "ВРЧ" Тогда
					ЭтотОбъект["ДатаСверкиНач_ВРЧ"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ВРЧ"]
				ИначеЕсли ИмяТекущегоРаздела = "ЗТР" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ЗТР"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ЗТР"]
				ИначеЕсли ИмяТекущегоРаздела = "ОТН" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ОТН"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ОТН"]
				// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
				ИначеЕсли ИмяТекущегоРаздела = "ДС" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ДС"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ДС"]
				// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
				// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
				ИначеЕсли ИмяТекущегоРаздела = "РСК" Тогда
					ЭтотОбъект["ДатаСверкиНач_РСК"] = СтруктураТекущегоРаздела["ДатаСверкиНач_РСК"];
				// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
				// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
				ИначеЕсли ИмяТекущегоРаздела = "ВРЧ_отб" Тогда
					ЭтотОбъект["ДатаСверкиНач_ВРЧ_отб"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ВРЧ_отб"]
				ИначеЕсли ИмяТекущегоРаздела = "ЗТР_отб" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ЗТР_отб"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ЗТР_отб"]
				ИначеЕсли ИмяТекущегоРаздела = "ОТН_отб" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ОТН_отб"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ОТН_отб"]
				ИначеЕсли ИмяТекущегоРаздела = "ПД" Тогда	
					ЭтотОбъект["ДатаСверкиНач_ПД"] = СтруктураТекущегоРаздела["ДатаСверкиНач_ПД"];
				// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
				КонецЕсли;
												
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		НормативноеВремяОжиданияОтветаСекунд = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураТекущихНастроек, "НормативноеВремяОжиданияОтветаСекунд", 900);  
		// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		КлючМаршрутизации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураТекущихНастроек, "КлючМаршрутизации", Справочники.тн_ПроизводственныеПодразделения.ОКС_Сбыт);
		// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
		
		Возврат Истина;
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСтруктуруСохраненныхНастроек() Экспорт
	
	СтруктураЗаписиНастроек = Новый Структура();
	СтруктураЗаписиНастроек.Вставить("ИмяОбъекта", ИмяОбъектаСохраненияНастроек);
	СтруктураЗаписиНастроек.Вставить("НаименованиеНастройки", "Основная");
	СтруктураЗаписиНастроек.Вставить("Пользователь", Справочники.Пользователи.ПустаяСсылка());
	
	МенеджерЗаписи = РегистрыСведений.СохраненныеНастройки.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписиНастроек);
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи.СохраненнаяНастройка.Получить();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьНеСохраняемыеНастройки(ЕстьСохраненныеНастройки) Экспорт
	
	ДатаУстановкиАвтосверки = ТекущаяДатаСеанса();
	
	ДатаСверкиКон_ОТН = ДатаУстановкиАвтосверки;
	ДатаСверкиКон_ВРЧ = ДатаУстановкиАвтосверки;
	ДатаСверкиКон_ЗТР = ДатаУстановкиАвтосверки;
  	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	ДатаСверкиКон_ДС  = ДатаУстановкиАвтосверки;
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
  	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ДатаСверкиКон_РСК  = ДатаУстановкиАвтосверки;
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	ДатаСверкиКон_ОТН_отб = ДатаУстановкиАвтосверки;
	ДатаСверкиКон_ВРЧ_отб = ДатаУстановкиАвтосверки;
	ДатаСверкиКон_ЗТР_отб = ДатаУстановкиАвтосверки;
	ДатаСверкиКон_ПД  = ДатаУстановкиАвтосверки;
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	
	НормативноеВремяОжиданияОтветаСекунд_Минимум = 300;
