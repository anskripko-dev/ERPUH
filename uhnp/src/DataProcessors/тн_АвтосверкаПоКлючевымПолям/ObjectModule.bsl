						СписокДанных.Добавить(Значение);
					КонецЦикла;
					
					// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
					СписокЗначенийОтбора = ПолучитьМассивПоКолонкеДанных(КлючЗначение.Ключ, ТаблицаРезультат);
					СписокЗначенийОтбора = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокЗначенийОтбора);
					Для Каждого Значение Из СписокЗначенийОтбора Цикл
						Если ЗначениеЗаполнено(Значение) Тогда
							НовыйОтбор 					= ОтборУточнений.Добавить();  
							// НАЧАЛО Юдина Екатерина 26.12.2024 Выполнение задач №000052167
							//НовыйОтбор.КлючОтбора 	= КлючЗначение.Ключ;    
							КлючОтбора = КлючЗначение.Ключ + "_" + АктивныйРаздел; 
