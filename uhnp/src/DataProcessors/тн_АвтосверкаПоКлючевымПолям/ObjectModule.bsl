Функция ДобавитьЗаписьДанныеАвтосверка(ПараметрыСтруктура) Экспорт
			
	ОтправкаЗапроса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСтруктура, "ОтправкаЗапроса", Ложь);
	
	СтруктураЗаписи = Новый Структура();
	Если ОтправкаЗапроса Тогда
		Если ПараметрыСтруктура["ПоДокументам"] Тогда
			СтруктураЗаписи.Вставить("ЗапросДанных", СообщениеЗапросERP_В_ОКС_ПоДокументам);
		Иначе	
			СтруктураЗаписи.Вставить("ЗапросДанных", СообщениеЗапросERP_В_ОКС);
		КонецЕсли;
	Иначе
		СтруктураЗаписи.Вставить("ОтветНаЗапрос", СообщениеОтветERP_От_ОКС);
	КонецЕсли;	
	СтруктураЗаписи.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура["ИдентификаторЗапроса"]);
	СтруктураЗаписи.Вставить("ПоДокументам", ПараметрыСтруктура["ПоДокументам"]);
	
	РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.ДобавитьОбновитьЗапись(СтруктураЗаписи);
	
КонецФункции

Функция ПолучитьДанныеРазделаЗапрос(СтруктураЗапрос, ИмяТекущегоРаздела, ИдентификаторНастройки, ИмяПоля)
	
	Для Каждого СтруктураРаздел Из СтруктураЗапрос.value.dataVerificationRequestSections Цикл
		Если СтруктураРаздел["name"] = ИмяТекущегоРаздела Тогда
			Для Каждого НастройкаРаздел Из СтруктураРаздел.settings Цикл
				Если НастройкаРаздел.id = ИдентификаторНастройки Тогда
					Возврат НастройкаРаздел[ИмяПоля];	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;	
	
КонецФункции

