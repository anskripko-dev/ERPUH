КонецФункции

//Качикина 23.01.2025 Выполнение задач №000052362 -добавила СтруктураАдресовВХ
Функция ПолучитьРезультатПоМакетуСКД(СКД_Или_URL, НастройкиКомпоновщика = Неопределено, ВнешниеНаборыДанных = Неопределено, РезультатВ_ТЗ = Истина, РезультатТЗ_ТД = Неопределено, РеквизитРасшифровки = Неопределено,СтруктураАдресовВХ=Неопределено) Экспорт
//// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872
////Функция ПолучитьРезультатПоМакетуСКД(СКД_Или_URL, НастройкиКомпоновщика = Неопределено, ВнешниеНаборыДанных = Неопределено, РезультатВ_ТЗ = Истина, РезультатТЗ_ТД = Неопределено) Экспорт
//Функция ПолучитьРезультатПоМакетуСКД(СКД_Или_URL, НастройкиКомпоновщика = Неопределено, ВнешниеНаборыДанных = Неопределено, РезультатВ_ТЗ = Истина, РезультатТЗ_ТД = Неопределено, РеквизитРасшифровки = Неопределено) Экспорт
//// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	
	ЭтоURL_СКД = (ТипЗнч(СКД_Или_URL) = Тип("Строка") И ЭтоАдресВременногоХранилища(СКД_Или_URL));
	Если ЭтоURL_СКД Тогда
		СКД = ПолучитьИзВременногоХранилища(СКД_Или_URL);
		URL_СКД = СКД_Или_URL; 
	Иначе
		СКД = СКД_Или_URL; 
		URL_СКД = ПоместитьВоВременноеХранилище(URL_СКД, Новый УникальныйИдентификатор());	
	КонецЕсли;
	
	Если ВнешниеНаборыДанных = Неопределено Тогда
		ВнешниеНаборыДанных = Новый Структура();
	КонецЕсли;	
	
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	Если Не НастройкиКомпоновщика = Неопределено Тогда
		СкопироватьЭлементы(НастройкиПоУмолчанию.Отбор, НастройкиКомпоновщика.Отбор);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	Если РезультатВ_ТЗ Тогда
		ТипГенератораМакетаКомпоновки = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	Иначе
		ТипГенератораМакетаКомпоновки = Тип("ГенераторМакетаКомпоновкиДанных");
	КонецЕсли;	

	// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872	
	//МакетКомпоновки   = КомпоновщикМакета.Выполнить(СКД, НастройкиПоУмолчанию,,,ТипГенератораМакетаКомпоновки);
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных; 
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СКД, НастройкиПоУмолчанию, ДанныеРасшифровки,,ТипГенератораМакетаКомпоновки);
	// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных(); 
	// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	//ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина); 
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	
	Если РезультатВ_ТЗ Тогда
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		
		Если НЕ РезультатТЗ_ТД = Неопределено Тогда
			ПроцессорВывода.УстановитьОбъект(РезультатТЗ_ТД);
		Иначе
			
		КонецЕсли;	
		Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
	Иначе
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент();
		
		Если РезультатТЗ_ТД = Неопределено Тогда
			ТабличныйДокумент = Новый ТабличныйДокумент();
		Иначе
			ТабличныйДокумент = РезультатТЗ_ТД;
		КонецЕсли;
		ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		//НАЧАЛО Качикина 23.01.2025 Выполнение задач №000052362
		//// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872
		//Если РеквизитРасшифровки <> Неопределено Тогда
		//	ЭтотОбъект[РеквизитРасшифровки] = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, Новый УникальныйИдентификатор);		
		//КонецЕсли;
		//// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872		
		Если РеквизитРасшифровки <> Неопределено
			И СтруктураАдресовВХ <> Неопределено Тогда
			
			ЭтотОбъект[РеквизитРасшифровки] = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, СтруктураАдресовВХ[РеквизитРасшифровки]);		
			
		КонецЕсли;
		//КОНЕЦ Качикина 23.01.2025 Выполнение задач №000052362
		Возврат ТабличныйДокумент;
		
	КонецЕсли;
			
КонецФункции

Функция ПолучитьТаблицуРезультатПоТаблицамЗначений(ТаблицаИсточник, ТаблицаПриемник, РазделДанных) Экспорт
	
	Если РазделДанных = "ОТН" Тогда
		
		// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
		//// НАЧАЛО Гутарова Екатерина 06.12.2023 Выполнение задач №000045946
		//// Так как из ОКС по задаче Климова по остаткам теперь летит множество строк по складам, а ранее все приходило без склада одной строкой. 
		//ТаблицаПриемник.Свернуть("id_Nomenclature, code_OKS_Nomenclature, name_OKS_Nomenclature","qount");
		//// КОНЕЦ Гутарова Екатерина 06.12.2023 Выполнение задач №000045946
		// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
		
		ЗапросДанных = Новый Запрос();

		ЗапросДанных.Текст = "ВЫБРАТЬ
		|	ТаблицаERP.Номенклатура КАК Номенклатура,
		|	ТаблицаERP.Идентификатор_Номенклатура КАК Идентификатор_Номенклатура,
		|	ТаблицаERP.Код_ERP_Номенклатура КАК Код_ERP_Номенклатура,
		|	ТаблицаERP.Наименование_ERP_Номенклатура КАК Наименование_ERP_Номенклатура,
		|	ТаблицаERP.Остаток_ERP КАК Остаток_ERP
		|ПОМЕСТИТЬ ВТ_ТаблицаERP
		|ИЗ
		|	&ТаблицаERP КАК ТаблицаERP
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОКС.id_Nomenclature КАК Идентификатор_Номенклатура,
		|	ТаблицаОКС.code_OKS_Nomenclature КАК Код_ОКС_Номенклатура,
		|	ТаблицаОКС.name_OKS_Nomenclature КАК Наименование_ОКС_Номенклатура,
		|	ТаблицаОКС.qount КАК Остаток_ОКС
		|ПОМЕСТИТЬ ВТ_ТаблицаОКС
		|ИЗ
