		|	ВТ_ТаблицаОКС.Идентификатор_Документ_ОКС КАК Идентификатор_Документ_ОКС,
		|	ВТ_ТаблицаОКС.Остаток_ОКС КАК Остаток_ОКС,
		|	ВТ_ТаблицаОКС.Документ_ОКС КАК Документ_ОКС,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Остаток_ERP, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.Остаток_ОКС, 0) КАК ДельтаДок,
		|	0 КАК Дельта, 
		// НАЧАЛО Белоконенко Денис 15.12.2022 Выполнение задач №000043705
		|	ВТ_ТаблицаОКС.ОсновнойДокумент_ОКС КАК ОсновнойДокумент_ОКС,
		// КОНЕЦ  Белоконенко Денис 15.12.2022 Выполнение задач №000043705 
		//НАЧАЛО Блинова М.А. 14.04.2025 Выполнение задач №000053284 
		//|	ЕСТЬNULL(ВТ_ТаблицаОКС.Склад, """") КАК Склад  
		|	ЕСТЬNULL(ВТ_ТаблицаОКС.Склад, ВТ_ТаблицаERP.Склад) КАК Склад 
		//КОНЕЦ Блинова М.А. 14.04.2025 Выполнение задач №000053284
		// НАЧАЛО Гутарова Екатерина 06.12.2023 Выполнение задач №000047753
		|	ПОМЕСТИТЬ ВТ_ОбщаяПредварительно	
		// КОНЕЦ Гутарова Екатерина 06.12.2023 Выполнение задач №000047753
		|ИЗ
		|	ВТ_ТаблицаERP КАК ВТ_ТаблицаERP
