		|	ТаблицаERP.id_Document КАК Идентификатор_Документ_ERP,
		|	ТаблицаERP.qount КАК Остаток_ERP
		|ПОМЕСТИТЬ ВТ_ТаблицаERP
		|ИЗ
		|	&ТаблицаERP КАК ТаблицаERP
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_БанкКасса,
		//НАЧАЛО Блинова М.А. 05.04.2024 Выполнение задач №000048144
		|	Идентификатор_Организация,
		//КОНЕЦ Блинова М.А. 05.04.2024 Выполнение задач №000048144
		|	Идентификатор_Документ_ERP
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОКС.БанкКасса КАК БанкКасса,
		|	ТаблицаОКС.id_BankKassa КАК Идентификатор_БанкКасса,
		|	ТаблицаОКС.name_Document КАК Документ_ОКС,
		|	ТаблицаОКС.id_Document КАК Идентификатор_Документ_ОКС,  
		//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144 
		|	ТаблицаОКС.Организация КАК Организация,
		|	ТаблицаОКС.id_Organization КАК Идентификатор_Организация, 
		//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144
		|	ТаблицаОКС.is_Bank КАК is_Bank,
		|	ТаблицаОКС.qount КАК Остаток_ОКС
		|ПОМЕСТИТЬ ВТ_ТаблицаОКС
		|ИЗ
		|	&ТаблицаОКС КАК ТаблицаОКС
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_БанкКасса, 
		//НАЧАЛО Блинова М.А. 05.04.2024 Выполнение задач №000048144  
		|	Идентификатор_Организация, 
		//КОНЕЦ Блинова М.А. 05.04.2024 Выполнение задач №000048144
		|	Идентификатор_Документ_ОКС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаERP.Документ_ERP КАК Документ_ERP,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_БанкКасса, ВТ_ТаблицаОКС.Идентификатор_БанкКасса) КАК Идентификатор_БанкКасса,
		|	ВТ_ТаблицаERP.Идентификатор_Документ_ERP КАК Идентификатор_Документ_ERP,
		|	ВТ_ТаблицаERP.Остаток_ERP КАК Остаток_ERP,
		|	ВТ_ТаблицаОКС.Идентификатор_Документ_ОКС КАК Идентификатор_Документ_ОКС,
		|	ВТ_ТаблицаОКС.Остаток_ОКС КАК Остаток_ОКС,
		|	ВТ_ТаблицаОКС.Документ_ОКС КАК Документ_ОКС,
		//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144 
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Организация, ВТ_ТаблицаОКС.Организация) КАК Организация,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_Организация, ВТ_ТаблицаОКС.Идентификатор_Организация) КАК Идентификатор_Организация, 
		//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Остаток_ERP, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.Остаток_ОКС, 0) КАК ДельтаДок,
		|	0 КАК Дельта,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.БанкКасса, ВТ_ТаблицаОКС.БанкКасса) КАК БанкКасса
		|ИЗ
		|	ВТ_ТаблицаERP КАК ВТ_ТаблицаERP
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТаблицаОКС КАК ВТ_ТаблицаОКС
		|		ПО ВТ_ТаблицаERP.Идентификатор_БанкКасса = ВТ_ТаблицаОКС.Идентификатор_БанкКасса
		|			И ВТ_ТаблицаERP.Идентификатор_Документ_ERP = ВТ_ТаблицаОКС.Идентификатор_Документ_ОКС
		|			И ВТ_ТаблицаERP.is_Bank = ВТ_ТаблицаОКС.is_Bank  
		//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144 
		|			И ВТ_ТаблицаERP.Идентификатор_Организация = ВТ_ТаблицаОКС.Идентификатор_Организация 
		//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144
		|ГДЕ
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Остаток_ERP, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.Остаток_ОКС, 0) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ТаблицаERP
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ТаблицаОКС";
		
		ЗапросДанных.УстановитьПараметр("ТаблицаERP", ТаблицаИсточник);
		ЗапросДанных.УстановитьПараметр("ТаблицаОКС", ТаблицаПриемник);
				
		Результат = ЗапросДанных.Выполнить();
		Возврат Результат.Выгрузить();
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886	
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ИначеЕсли РазделДанных = "РСК" Тогда
		
		мИдДоговоров = ТаблицаПриемник.ВыгрузитьКолонку("id_Contract");
		ОбщегоНазначенияКлиентСервер.СвернутьМассив(мИдДоговоров);
		сДоговоры = ПолучитьСоответствияСсылокИдентификаторам(мИдДоговоров, "Договоры");
		
		мИдВидовДоговоров = ТаблицаПриемник.ВыгрузитьКолонку("type_Contract");
		сВидыДоговоров = ПолучитьСоответствияСсылокИдентификаторам(мИдВидовДоговоров, "ВидыДоговоров");
		
		мИдВидовВзаиморасчетов = ТаблицаПриемник.ВыгрузитьКолонку("id_Settlement");
		сВидыВзаиморасчетов = ПолучитьСоответствияСсылокИдентификаторам(мИдВидовВзаиморасчетов, "ВидыВзаиморасчетов");
		
		мИдВалют = ТаблицаПриемник.ВыгрузитьКолонку("id_Currency");
		сВалюты = ПолучитьСоответствияСсылокИдентификаторам(мИдВалют, "Валюты");
		
		//НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144 
		мИдОрганизаций = ТаблицаПриемник.ВыгрузитьКолонку("id_Organization");
		сОрганизации = ПолучитьСоответствияСсылокИдентификаторам(мИдОрганизаций, "Организации");
		//КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144

		Для Каждого СтрокаПриемник Из ТаблицаПриемник Цикл
			СтрокаПриемник.Договор = сДоговоры[СтрокаПриемник.id_Contract];
			СтрокаПриемник.ВидДоговора = сВидыДоговоров[СтрокаПриемник.type_Contract];
			СтрокаПриемник.ВидВзаиморасчетов = сВидыВзаиморасчетов[СтрокаПриемник.id_Settlement];
			СтрокаПриемник.Валюта = сВалюты[СтрокаПриемник.id_Currency];  
			//НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144  
			СтрокаПриемник.Организация = сОрганизации[СтрокаПриемник.id_Organization]; 
			//КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
		КонецЦикла;	
		
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.Текст = "ВЫБРАТЬ
         |	ВЫРАЗИТЬ(ТаблицаERP.Идентификатор_Контрагент КАК СТРОКА(36)) КАК Идентификатор_Контрагент,
         |	ТаблицаERP.ВидДоговора КАК ВидДоговора,
         |	ТаблицаERP.ВидВзаиморасчетов КАК ВидВзаиморасчетов,
         |	ТаблицаERP.Контрагент КАК Контрагент,
         |	ТаблицаERP.Договор КАК Договор,
         |	ВЫРАЗИТЬ(ТаблицаERP.Идентификатор_Договор КАК СТРОКА(36)) КАК Идентификатор_Договор, 
		  //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144
		 |	ТаблицаERP.Организация КАК Организация,
         |	ВЫРАЗИТЬ(ТаблицаERP.Идентификатор_Организация КАК СТРОКА(36)) КАК Идентификатор_Организация, 
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |	ВЫРАЗИТЬ(ТаблицаERP.Идентификатор_ВидВзаиморасчетов КАК СТРОКА(36)) КАК Идентификатор_ВидВзаиморасчетов,
         |	ТаблицаERP.Сумма КАК Сумма,
         |	ТаблицаERP.СуммаУпр КАК СуммаУпр,
         |	ВЫРАЗИТЬ(ТаблицаERP.Идентификатор_Регистратор КАК СТРОКА(36)) КАК Идентификатор_Регистратор,
         |	ТаблицаERP.НаименованиеERP_Документ КАК НаименованиеERP_Документ,
         |	ТаблицаERP.Документ_ERP КАК Документ_ERP,
         |	ТаблицаERP.Валюта КАК Валюта
         |ПОМЕСТИТЬ ВТ_ТаблицаERP
         |ИЗ
         |	&ТаблицаERP КАК ТаблицаERP
         |
         |ИНДЕКСИРОВАТЬ ПО
         |	Идентификатор_Контрагент,
         |	ВидДоговора,
		   //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144
		 |	Идентификатор_Организация, 
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |	Договор,
         |	Идентификатор_ВидВзаиморасчетов
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |ВЫБРАТЬ
         |	ВЫРАЗИТЬ(ТаблицаОКС.id_Contract КАК СТРОКА(36)) КАК Идентификатор_Договор,
         |	ТаблицаОКС.qount КАК qount,
         |	ТаблицаОКС.qountMan КАК qountMan,
         |	ВЫРАЗИТЬ(ТаблицаОКС.id_Contragent КАК СТРОКА(36)) КАК Идентификатор_Контрагент,
         |	ТаблицаОКС.ВидДоговора КАК ВидДоговора,
		   //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144
		 |	ТаблицаОКС.Организация КАК Организация,
         |	ВЫРАЗИТЬ(ТаблицаОКС.id_Organization КАК СТРОКА(36)) КАК Идентификатор_Организация, 
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |	ТаблицаОКС.Name_OKS_Contragent КАК КонтрагентОКС,
         |	ТаблицаОКС.Договор КАК Договор,
         |	ТаблицаОКС.ВидВзаиморасчетов КАК ВидВзаиморасчетов,
         |	ВЫРАЗИТЬ(ТаблицаОКС.id_Settlement КАК СТРОКА(36)) КАК Идентификатор_ВидВзаиморасчетов,
         |	ВЫРАЗИТЬ(ТаблицаОКС.id_Document КАК СТРОКА(36)) КАК Идентификатор_Регистратор,
         |	ТаблицаОКС.name_Document КАК НаименованиеОКС_Документ,
         |	ТаблицаОКС.Валюта КАК Валюта
         |ПОМЕСТИТЬ ВТ_ТаблицаОКС
         |ИЗ
         |	&ТаблицаОКС КАК ТаблицаОКС
         |
         |ИНДЕКСИРОВАТЬ ПО
         |	Идентификатор_Контрагент,
         |	ВидДоговора,
         |	Договор, 
		  //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144
		 |	Идентификатор_Организация, 
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |	Идентификатор_ВидВзаиморасчетов
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |ВЫБРАТЬ
         |	ЕСТЬNULL(ВТ_ТаблицаERP.Договор, ВТ_ТаблицаОКС.Договор) КАК Договор,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.Сумма, 0) КАК Сумма,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.СуммаУпр, 0) КАК СуммаУпр,
         |	ЕСТЬNULL(ВТ_ТаблицаОКС.qount, 0) КАК Сумма_ОКС,
         |	ЕСТЬNULL(ВТ_ТаблицаОКС.qountMan, 0) КАК СуммаУпр_ОКС, 
		 //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144  
		 |	ЕСТЬNULL(ВТ_ТаблицаERP.Организация,  ВТ_ТаблицаОКС.Организация) КАК Организация,
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |	ЕСТЬNULL(ВТ_ТаблицаERP.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК КонтрагентERP,
         |	ЕСТЬNULL(ВТ_ТаблицаОКС.КонтрагентОКС, """") КАК КонтрагентОКС,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.ВидДоговора, ВТ_ТаблицаОКС.ВидДоговора) КАК ВидДоговора,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.ВидВзаиморасчетов, ВТ_ТаблицаОКС.ВидВзаиморасчетов) КАК ВидВзаиморасчетов,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.Документ_ERP, """") КАК ДокументERP,
         |	ЕСТЬNULL(ВТ_ТаблицаОКС.НаименованиеОКС_Документ, """") КАК ДокументОКС,
         |	ЕСТЬNULL(ВТ_ТаблицаERP.Валюта, ВТ_ТаблицаОКС.Валюта) КАК Валюта
         |ИЗ
         |	ВТ_ТаблицаERP КАК ВТ_ТаблицаERP
         |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТаблицаОКС КАК ВТ_ТаблицаОКС
         |		ПО ВТ_ТаблицаERP.Договор = ВТ_ТаблицаОКС.Договор
         |			И ВТ_ТаблицаERP.Идентификатор_Контрагент = ВТ_ТаблицаОКС.Идентификатор_Контрагент
         |			И ВТ_ТаблицаERP.Идентификатор_ВидВзаиморасчетов = ВТ_ТаблицаОКС.Идентификатор_ВидВзаиморасчетов 
		  //НАЧАЛО Блинова М.А. 13.03.2024 Выполнение задач №000048144 
		 |			И ВТ_ТаблицаERP.Идентификатор_Организация = ВТ_ТаблицаОКС.Идентификатор_Организация
		 //КОНЕЦ Блинова М.А. 13.03.2024 Выполнение задач №000048144
         |			И ВТ_ТаблицаERP.Идентификатор_Регистратор = ВТ_ТаблицаОКС.Идентификатор_Регистратор
         |ГДЕ
         |	(ЕСТЬNULL(ВТ_ТаблицаERP.Сумма, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.qount, 0) <> 0
         |			ИЛИ ЕСТЬNULL(ВТ_ТаблицаERP.СуммаУпр, 0) - ЕСТЬNULL(ВТ_ТаблицаОКС.qountMan, 0) <> 0)
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |УНИЧТОЖИТЬ ВТ_ТаблицаERP
         |;
         |
         |////////////////////////////////////////////////////////////////////////////////
         |УНИЧТОЖИТЬ ВТ_ТаблицаОКС";

		ЗапросДанных.УстановитьПараметр("ТаблицаERP", ТаблицаИсточник);
		ЗапросДанных.УстановитьПараметр("ТаблицаОКС", ТаблицаПриемник);
		
		Результат = ЗапросДанных.Выполнить();
		Возврат Результат.Выгрузить();
		
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	ИначеЕсли РазделДанных = "ОТН_отб" Тогда
					
		ТаблицаПриемник.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		Для Каждого СтрокаПриемник Из ТаблицаПриемник Цикл
			СтрокаПриемник.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаПриемник.id_Nomenclature));
		КонецЦикла;
		
		ЗапросДанных = Новый Запрос();
