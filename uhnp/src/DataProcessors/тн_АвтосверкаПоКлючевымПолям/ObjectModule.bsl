		|	Идентификатор_Документ_ERP
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОКС.id_Nomenclature КАК Идентификатор_Номенклатура,
		|	ТаблицаОКС.name_Document КАК Документ_ОКС,
		|	ТаблицаОКС.id_Document КАК Идентификатор_Документ_ОКС,
		|	ТаблицаОКС.qount КАК Остаток_ОКС,
		// НАЧАЛО Белоконенко Денис 15.12.2022 Выполнение задач №000043705
		|	ТаблицаОКС.name_DocumentMain КАК ОсновнойДокумент_ОКС,
		// КОНЕЦ  Белоконенко Денис 15.12.2022 Выполнение задач №000043705
		|	ТаблицаОКС.name_Warehouse КАК Склад
		|ПОМЕСТИТЬ ВТ_ТаблицаОКС
		|ИЗ
		|	&ТаблицаОКС КАК ТаблицаОКС
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор_Номенклатура,
		|	Идентификатор_Документ_ОКС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаERP.Документ_ERP КАК Документ_ERP,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_Номенклатура, ВТ_ТаблицаОКС.Идентификатор_Номенклатура) КАК Идентификатор_Номенклатура,
		|	ВТ_ТаблицаERP.Идентификатор_Документ_ERP КАК Идентификатор_Документ_ERP,
