// Белоконенко Денис 26.09.2022 Выполнение задач №000042739
Процедура ДополнитьТаблицуПослеСКДПоДокументамЕРП(ИмяТекущегоРаздела, ТаблицаERP_ПоДокументам)
	КолСимволовНомераОКС = 12;
	
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	//Если ИмяТекущегоРаздела = "ЗТР" Тогда
	Если Лев(ИмяТекущегоРаздела,3) = "ЗТР" Тогда
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
		МассивДокументов = Новый Массив;
		Для Каждого Стр Из ТаблицаERP_ПоДокументам Цикл
			Если ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
				МассивДокументов.Добавить(Стр.Регистратор);
			КонецЕсли;
		КонецЦикла;
				
		РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивДокументов, "ХозяйственнаяОперация, Основание");
		// НАЧАЛО Белоконенко Денис 25.10.2022 Выполнение задач №000043105
		РеквизитыТЧДокументов = ПолучитьРеквизитыТЧ(МассивДокументов);
		// КОНЕЦ  Белоконенко Денис 25.10.2022 Выполнение задач №000043105
		
		Для Каждого Стр Из ТаблицаERP_ПоДокументам Цикл
			Если ТипЗнч(Стр.Регистратор) = Тип("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
				РеквизитыДокумента 	= РеквизитыДокументов.Получить(Стр.Регистратор);
				Если РеквизитыДокумента = Неопределено Тогда
					Продолжить;
				КонецЕсли;
					
				ОперацияДокумента 	= РеквизитыДокумента.ХозяйственнаяОперация;
				ОснованиеДокумента	= РеквизитыДокумента.Основание;
				
				// Начисление Ретро-бонусов
				Если Прав(Стр.number_Document, 2) = "РП" И ОперацияДокумента = Перечисления.ХозяйственныеОперации.ПрочиеРасходы Тогда
					КолСпецСимволов = 2;
					// НАЧАЛО Белоконенко Денис 18.05.2023 Выполнение задач №000045513
					//ТипДокументаОКС = "Поступление товаров и услуг";
					ТипДокументаОКС = "Документ.ПоступлениеТоваровУслуг";
					// КОНЕЦ Белоконенко Денис 18.05.2023 Выполнение задач №000045513
				// Сторнирование Ретро-бонусов
				ИначеЕсли Прав(Стр.number_Document, 2) = "РН" И ОперацияДокумента = Перечисления.ХозяйственныеОперации.СторнированиеПрочихРасходов Тогда 
					КолСпецСимволов = 2;
					// НАЧАЛО Белоконенко Денис 18.05.2023 Выполнение задач №000045513
					//ТипДокументаОКС = "Поступление товаров и услуг";
					ТипДокументаОКС = "Документ.ПоступлениеТоваровУслуг";
					// КОНЕЦ Белоконенко Денис 18.05.2023 Выполнение задач №000045513
				// Начисление премий, пени и штрафов
				ИначеЕсли Прав(Стр.number_Document, 1) = "Б" И ОперацияДокумента = Перечисления.ХозяйственныеОперации.ПрочиеРасходы Тогда
					КолСпецСимволов = 1;
					// НАЧАЛО Белоконенко Денис 18.05.2023 Выполнение задач №000045513
					//ТипДокументаОКС = "Начисление премий, пени и штрафов";
					ТипДокументаОКС = "Документ.НачислениеБонусовИШтрафовПоОтгрузкеВКредит";
					// КОНЕЦ Белоконенко Денис 18.05.2023 Выполнение задач №000045513
				// Комиссия кредитного комитета
				ИначеЕсли СтрНайти(ОснованиеДокумента, "КомиссияКредитногоКомитета") > 0 И ОперацияДокумента = Перечисления.ХозяйственныеОперации.РеклассификацияРасходов Тогда 
					СпецСимвол 		= "_";
					ДлинаСпецСимвол	= СтрДлина(СпецСимвол);
					КолСпецСимволов = СтрДлина(Стр.number_Document) - СтрНайти(Стр.number_Document, СпецСимвол) + ДлинаСпецСимвол;
					// НАЧАЛО Белоконенко Денис 18.05.2023 Выполнение задач №000045513
					//ТипДокументаОКС = "Комиссия кредитного комитета";
					ТипДокументаОКС = "Документ.КомиссияКредитногоКомитета";
					// КОНЕЦ Белоконенко Денис 18.05.2023 Выполнение задач №000045513
					
					// НАЧАЛО Белоконенко Денис 25.10.2022 Выполнение задач №000043105
					РеквизитыТЧДокумента 	= РеквизитыТЧДокументов.Получить(Стр.Регистратор);
					Если РеквизитыТЧДокумента <> Неопределено Тогда
						Стр.id_Nomenclature = XMLСтрока(РеквизитыТЧДокумента.НаправлениеДеятельности);	
					КонецЕсли;
					// КОНЕЦ  Белоконенко Денис 25.10.2022 Выполнение задач №000043105 
				// НАЧАЛО Белоконенко Денис 02.06.2023 Выполнение задач №000045695
				// Сторнирование расходов по бонусам
				ИначеЕсли Прав(Стр.number_Document, 2) = "СБ" И ОперацияДокумента = Перечисления.ХозяйственныеОперации.СторнированиеПрочихРасходов Тогда 
					КолСпецСимволов = 2;
					ТипДокументаОКС = "Документ.ПоступлениеТоваровУслуг";	
				// КОНЕЦ Белоконенко Денис 02.06.2023 Выполнение задач №000045695 
				//НАЧАЛО Блинова М.А. 17.01.2025 Выполнение задач №000052314  
				//не сторнировались расходы
				ИначеЕсли СтрНайти(ОснованиеДокумента, "Сторнирование расходов по ПТиУ")> 0 И ОперацияДокумента = Перечисления.ХозяйственныеОперации.СторнированиеПрочихРасходов Тогда 
					КолСпецСимволов = 0;
					ТипДокументаОКС = "Документ.ПоступлениеТоваровУслуг";
				//КОНЕЦ Блинова М.А. 17.01.2025 Выполнение задач №000052314
				Иначе
					Продолжить;
				КонецЕсли;
				
				// Преобразование номера к номеру ОКСа для связи
				ПрефиксНомера 			= ПрефиксацияОбъектовКлиентСервер.ПользовательскийПрефикс(Стр.number_Document);
				ДлинаПрефикса			= СтрДлина(ПрефиксНомера);
				
				Стр.ПоискПоНомеруИДате 	= Истина;
				Стр.type_Document 		= ТипДокументаОКС;
				ПоисковыйНомерЕРП 		= Лев(Стр.number_Document, СтрДлина(Стр.number_Document) - КолСпецСимволов);
				ПоисковыйНомерЕРП		= Прав(ПоисковыйНомерЕРП, СтрДлина(ПоисковыйНомерЕРП) - ДлинаПрефикса);
				Стр.number_Document 	= ПрефиксНомера + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ПоисковыйНомерЕРП, КолСимволовНомераОКС - ДлинаПрефикса, "0", "Слева");
	
			КонецЕсли;
		КонецЦикла;
	// НАЧАЛО Белоконенко Денис 15.12.2022 Выполнение задач №000043705	
	ИначеЕсли ИмяТекущегоРаздела = "ОТН" Тогда
				
		КопияТаблицы = ТаблицаERP_ПоДокументам.Скопировать();
		ТаблицаERP_ПоДокументам.Свернуть("id_Nomenclature, id_Document", "qount");
		Типы = Документы.ТипВсеСсылки().Типы();
		Типы.Добавить(Тип("Строка"));
		
		ТаблицаERP_ПоДокументам.Колонки.Добавить("Регистратор", Новый ОписаниеТипов(Типы,,,,Новый КвалификаторыСтроки(250)));
		//НАЧАЛО Блинова М.А. 08.04.2025 Выполнение задач №000053284 
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ТаблицаERP_ПоДокументам.Колонки.Добавить("Складоотправитель", Новый ОписаниеТипов(МассивТипов,,,,Новый КвалификаторыСтроки(250)));
		//КОНЕЦ Блинова М.А. 08.04.2025 Выполнение задач №000053284

		Для Каждого Стр Из ТаблицаERP_ПоДокументам Цикл
			МассивДокументов = КопияТаблицы.НайтиСтроки(Новый Структура("id_Nomenclature, id_Document", Стр.id_Nomenclature, Стр.id_Document));		
			Если МассивДокументов.Количество() > 1 Тогда
				СтрокаРегистратор = "";   
				//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284
				Складоотправитель = ""; 
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
				Для Каждого СтрокаМассива Из МассивДокументов Цикл
					СтрокаРегистратор = СтрокаРегистратор + СтрокаМассива.name_Document + Символы.ПС;
					//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284  
					Складоотправитель = Складоотправитель + ", " + ПолучитьСкладоотправитель(СтрокаМассива.Регистратор);
					//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
				КонецЦикла;
				
				Стр.Регистратор = СтрокаРегистратор; 
				//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284 
				Стр.Складоотправитель = Складоотправитель; 
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
			ИначеЕсли МассивДокументов.Количество() = 1 Тогда
				Стр.Регистратор = МассивДокументов[0].Регистратор; 
				//НАЧАЛО Блинова М.А. 08.04.2025 Выполнение задач №000053284  
				Стр.Складоотправитель = ПолучитьСкладоотправитель(Стр.Регистратор);
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
			Иначе
				Стр.Регистратор = "";
			КонецЕсли;
		КонецЦикла;				
	// КОНЕЦ Белоконенко Денис 15.12.2022 Выполнение задач №000043705	
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	ИначеЕсли ИмяТекущегоРаздела = "ОТН_отб" Тогда	
				
		КопияТаблицы = ТаблицаERP_ПоДокументам.Скопировать();
		ТаблицаERP_ПоДокументам.Свернуть("id_Nomenclature, id_Document, Склад, id_Warehouse, name_Warehouse, Код_ERP_Номенклатура, Номенклатура", "qount");		
	
		Типы = Документы.ТипВсеСсылки().Типы();
		Типы.Добавить(Тип("Строка"));
		
		ТаблицаERP_ПоДокументам.Колонки.Добавить("Регистратор", Новый ОписаниеТипов(Типы,,,,Новый КвалификаторыСтроки(250)));
		//НАЧАЛО Блинова М.А. 08.04.2025 Выполнение задач №000053284   
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ТаблицаERP_ПоДокументам.Колонки.Добавить("Складоотправитель", Новый ОписаниеТипов(МассивТипов,,,,Новый КвалификаторыСтроки(250)));
		//КОНЕЦ Блинова М.А. 08.04.2025 Выполнение задач №000053284

		Для Каждого Стр Из ТаблицаERP_ПоДокументам Цикл
			МассивДокументов = КопияТаблицы.НайтиСтроки(Новый Структура("id_Nomenclature, id_Document, id_Warehouse", Стр.id_Nomenclature, Стр.id_Document, Стр.id_Warehouse));
			Если МассивДокументов.Количество() > 1 Тогда
				СтрокаРегистратор = "";  
				//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284
				Складоотправитель = ""; 
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
				Для Каждого СтрокаМассива Из МассивДокументов Цикл
					СтрокаРегистратор = СтрокаРегистратор + СтрокаМассива.name_Document + Символы.ПС;	
					//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284  
					Складоотправитель = Складоотправитель + ", " + ПолучитьСкладоотправитель(СтрокаМассива.Регистратор);
					//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
				КонецЦикла;
				//НАЧАЛО Блинова М.А. 09.04.2025 Выполнение задач №000053284 
				Стр.Складоотправитель = Складоотправитель; 
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284

				Стр.Регистратор = СтрокаРегистратор;
			ИначеЕсли МассивДокументов.Количество() = 1 Тогда
				Стр.Регистратор = МассивДокументов[0].Регистратор;  
				//НАЧАЛО Блинова М.А. 08.04.2025 Выполнение задач №000053284  
				Стр.Складоотправитель = ПолучитьСкладоотправитель(Стр.Регистратор);
				//КОНЕЦ Блинова М.А. 09.04.2025 Выполнение задач №000053284
			Иначе
				Стр.Регистратор = "";
			КонецЕсли;
		КонецЦикла;				
		// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	КонецЕсли;
