		|	ЕСТЬNULL(ВТ_ТаблицаERP.Подразделение, ВТ_ТаблицаОКС.Подразделение) КАК Подразделение,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.Идентификатор_СтатьяДоходов, ВТ_ТаблицаОКС.id_IncomeItem) КАК Идентификатор_СтатьяДоходов,
		|	ЕСТЬNULL(ВТ_ТаблицаERP.СтатьяДоходов, ВТ_ТаблицаОКС.СтатьяДоходов) КАК СтатьяДоходов,
