Функция ПолучитьТаблицуДанныхПоПараметрам(ИмяРазделаСтрока, ПараметрыНастройкиСтруктура, ТаблицаБитыхСсылок, ПроверятьСсылку = Истина)
	
	ИмяКолонки = ПараметрыНастройкиСтруктура["columnName"];
	
	ТаблицаДанных = Новый ТаблицаЗначений();
	ТаблицаДанных.Колонки.Добавить(ИмяКолонки);
	
	Если ПараметрыНастройкиСтруктура.columnName = "Склад" Тогда
		Менеджер = Справочники.Склады;
	ИначеЕсли ИмяКолонки = "Контрагент" Тогда	
		Менеджер = Справочники.Контрагенты;
	ИначеЕсли ИмяКолонки = "СтатьяРасходов" Тогда	
		Если ЭтоБазаERP Тогда
			Менеджер = ПланыВидовХарактеристик.СтатьиРасходов;
		Иначе
			Менеджер = Справочники["СтатьиЗатрат"];	
		КонецЕсли;
	ИначеЕсли ИмяКолонки = "Подразделение" Тогда
		Если ЭтоБазаERP Тогда
			Менеджер = Справочники["СтруктураПредприятия"];
		Иначе
			Менеджер = Справочники["Подразделения"];	
		КонецЕсли;
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	//НАЧАЛО Блинова М.А. 19.02.2024 Выполнение задач №000048144 
	ИначеЕсли ИмяКолонки = "Организация" Тогда
		Менеджер = Справочники["Организации"];
		ПроверятьСсылку = Ложь;
	//КОНЕЦ Блинова М.А. 19.02.2024 Выполнение задач №000048144
	ИначеЕсли ИмяКолонки = "Банк" Тогда
		Менеджер = Справочники["БанковскиеСчетаОрганизаций"];
		ПроверятьСсылку = Ложь;
	ИначеЕсли ИмяКолонки = "Касса" Тогда
		Менеджер = Справочники["Кассы"];
		ПроверятьСсылку = Ложь;
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	ИначеЕсли ИмяКолонки = "СтатьяДоходов" Тогда	
		Если ЭтоБазаERP Тогда
			Менеджер = ПланыВидовХарактеристик.СтатьиДоходов;
		Иначе
			Менеджер = Справочники["ДоходыРасходы"];	
		КонецЕсли;
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ИначеЕсли ИмяКолонки = "Сегмент" Тогда
		Если ЭтоБазаERP Тогда
			Менеджер = Справочники["СегментыПартнеров"];
			ПроверятьСсылку = Ложь;
		КонецЕсли;
	ИначеЕсли ИмяКолонки = "ВидДоговора" Тогда
		Если ЭтоБазаERP Тогда
			Менеджер = Справочники["ВидыДоговоровКонтрагентовУХ"];
			ПроверятьСсылку = Ложь;
		КонецЕсли;
	ИначеЕсли ИмяКолонки = "ВидВзаиморасчетов" Тогда
		Если ЭтоБазаERP Тогда
			Менеджер = Справочники["тн_ВидыВзаиморасчетов"];
			ПроверятьСсылку = Ложь;
		КонецЕсли;
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	Иначе
		Менеджер = Справочники[ИмяКолонки];
	КонецЕсли;
	
	МассивЗначений = ПолучитьМассив_ИзСпискаXDTO(ПараметрыНастройкиСтруктура.columnData);
	
	Если ИмяКолонки = "СтатьяРасходов" Тогда
		Если ЭтоБазаERP Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтатьиЗатрат.Ссылка КАК Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиЗатрат
			|ГДЕ
			|	СтатьиЗатрат.Код В(&МассивКодов)");
			Запрос.УстановитьПараметр("МассивКодов", МассивЗначений);
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Пока Выборка.Следующий() Цикл
					СтруктураДобавления = Новый Структура(ИмяКолонки, Выборка.Ссылка); 
					ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), СтруктураДобавления);
				КонецЦикла;	
			КонецЕсли;
			
		Иначе
			
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтатьиЗатрат.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СтатьиЗатрат КАК СтатьиЗатрат
			|ГДЕ
			|	СтатьиЗатрат.тн_КодСтатьиЕРП_УХ В (&МассивКодов)");
			Запрос.УстановитьПараметр("МассивКодов", МассивЗначений);
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Пока Выборка.Следующий() Цикл
					СтруктураДобавления = Новый Структура(ИмяКолонки, Выборка.Ссылка); 
					ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), СтруктураДобавления);
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;	

	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
