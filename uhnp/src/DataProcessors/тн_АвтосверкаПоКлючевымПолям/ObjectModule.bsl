Функция ПолучитьОбъектXDTO_ОтветНаЗапросДанных(СтруктураПараметров = Неопределено) Экспорт
	
	СообщениеXDTO_ЗапросДанных = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "СообщениеXDTO");
	ТекстСообщенияJSON = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметров, "ТекстСообщенияJSON");
	
	КонтейнерXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationResponse");
	КонтейнерXDTO["dateResponse"] = ТекущаяДатаСеанса();
	КонтейнерXDTO["idForm"] = СообщениеXDTO_ЗапросДанных.idForm;
	КонтейнерXDTO["idRequest"] = СообщениеXDTO_ЗапросДанных.idRequest;
	ПоДокументам = СообщениеXDTO_ЗапросДанных.byDocument;
	
	Для Каждого СтруктураРаздел Из СообщениеXDTO_ЗапросДанных["dataVerificationRequestSections"] Цикл
		ИмяТекущегоРаздела = СтруктураРаздел["name"]; 
		
		dataVerificationResponseSection = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationResponseSection");
		dataVerificationResponseSection["name"] = ИмяТекущегоРаздела;
		dataVerificationResponseSection["dateOfVerificationBegin"] = СтруктураРаздел.dateOfVerificationBegin;
		dataVerificationResponseSection["dateOfVerificationEnd"] = СтруктураРаздел.dateOfVerificationEnd;
		
		Для Каждого НастройкаЗапроса Из СтруктураРаздел["settings"] Цикл
			
			ИдентификаторНастройки = НастройкаЗапроса["id"];
			
			dataVerificationResponseSectionSetting = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationResponseSectionSetting");
			dataVerificationResponseSectionSetting["id"] = ИдентификаторНастройки;
			
			СтруктураТаблицПараметровЗапроса = ПолучитьСтруктуруТаблицПараметровНастройкиЗапросаДанных(ИмяТекущегоРаздела, НастройкаЗапроса["data"]);
			
			Если ИмяТекущегоРаздела = "ОТН" Тогда
				
				Если ПоДокументам Тогда
					МакетКомпоновкиЗапросДанных_ПоДокументам = ПолучитьМакет("ОКС_ОТН_ПоДокументам");
					
					СоответствиеПараметров_ПоДокументам = Новый Соответствие();
					СоответствиеПараметров_ПоДокументам.Вставить("МассивНоменклатура", СтруктураТаблицПараметровЗапроса["Номенклатура"].ВыгрузитьКолонку("Номенклатура"));
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаНач", СтруктураРаздел.dateOfVerificationBegin);
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаКон", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных_ПоДокументам.НастройкиПоУмолчанию, СоответствиеПараметров_ПоДокументам);
					
					ТаблицаРезультат_ПоДокументам = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных_ПоДокументам);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат_ПоДокументам, dataVerificationResponseSectionSetting);
					
				Иначе
					
					МакетКомпоновкиЗапросДанных = ПолучитьМакет("ОКС_ОТН");
					
					СоответствиеПараметров = Новый Соответствие();
					СоответствиеПараметров.Вставить("МассивНоменклатура", СтруктураТаблицПараметровЗапроса["Номенклатура"].ВыгрузитьКолонку("Номенклатура"));
					СоответствиеПараметров.Вставить("ДатаСверки", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных.НастройкиПоУмолчанию, СоответствиеПараметров);
					
					ТаблицаРезультат = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат, dataVerificationResponseSectionSetting);
				КонецЕсли;	
				
			ИначеЕсли ИмяТекущегоРаздела = "ВРЧ" Тогда
				
				Если ПоДокументам Тогда
					МакетКомпоновкиЗапросДанных_ПоДокументам = ПолучитьМакет("ОКС_ВРЧ_ПоДокументам");
					
					СоответствиеПараметров_ПоДокументам = Новый Соответствие();
					СоответствиеПараметров_ПоДокументам.Вставить("МассивКонтрагентов", СтруктураТаблицПараметровЗапроса["Контрагент"].ВыгрузитьКолонку("Контрагент"));
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаНач", СтруктураРаздел.dateOfVerificationBegin);
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаКон", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных_ПоДокументам.НастройкиПоУмолчанию, СоответствиеПараметров_ПоДокументам);
					
					ТаблицаРезультат_ПоДокументам = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных_ПоДокументам);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат_ПоДокументам, dataVerificationResponseSectionSetting);
					
				Иначе
					
					МакетКомпоновкиЗапросДанных = ПолучитьМакет("ОКС_ВРЧ");
					
					СоответствиеПараметров = Новый Соответствие();
					СоответствиеПараметров.Вставить("МассивКонтрагентов", СтруктураТаблицПараметровЗапроса["Контрагент"].ВыгрузитьКолонку("Контрагент"));
					СоответствиеПараметров.Вставить("ДатаНач", СтруктураРаздел.dateOfVerificationBegin);
					СоответствиеПараметров.Вставить("ДатаКон", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных.НастройкиПоУмолчанию, СоответствиеПараметров);
					
					ТаблицаРезультат = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат, dataVerificationResponseSectionSetting);
								
				КонецЕсли;
				
			ИначеЕсли ИмяТекущегоРаздела = "ЗТР" Тогда
				
				Если ПоДокументам Тогда
					МакетКомпоновкиЗапросДанных_ПоДокументам = ПолучитьМакет("ОКС_ЗТР_ПоДокументам");
					
					СоответствиеПараметров_ПоДокументам = Новый Соответствие();
					СоответствиеПараметров_ПоДокументам.Вставить("МассивСтатейРасходов", СтруктураТаблицПараметровЗапроса["СтатьяРасходов"].ВыгрузитьКолонку("СтатьяРасходов"));
					СоответствиеПараметров_ПоДокументам.Вставить("МассивПодразделения", СтруктураТаблицПараметровЗапроса["Подразделение"].ВыгрузитьКолонку("Подразделение"));
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаНач", СтруктураРаздел.dateOfVerificationBegin);
					СоответствиеПараметров_ПоДокументам.Вставить("ДатаКон", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных_ПоДокументам.НастройкиПоУмолчанию, СоответствиеПараметров_ПоДокументам);
					
					ТаблицаРезультат_ПоДокументам = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных_ПоДокументам);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат_ПоДокументам, dataVerificationResponseSectionSetting);
					
				Иначе
					
					МакетКомпоновкиЗапросДанных = ПолучитьМакет("ОКС_ЗТР");
					
					СоответствиеПараметров = Новый Соответствие();
					СоответствиеПараметров.Вставить("МассивСтатейРасходов", СтруктураТаблицПараметровЗапроса["СтатьяРасходов"].ВыгрузитьКолонку("СтатьяРасходов"));
					СоответствиеПараметров.Вставить("ДатаНач", СтруктураРаздел.dateOfVerificationBegin);
					СоответствиеПараметров.Вставить("ДатаКон", СтруктураРаздел.dateOfVerificationEnd);
					
					УстановитьКоллекциюПараметров(МакетКомпоновкиЗапросДанных.НастройкиПоУмолчанию, СоответствиеПараметров);
					
					ТаблицаРезультат = ПолучитьРезультатПоМакетуСКД(МакетКомпоновкиЗапросДанных);
					ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат, dataVerificationResponseSectionSetting);
					
				КонецЕсли;
				
			КонецЕсли;
			
			dataVerificationResponseSection.settings.Добавить(dataVerificationResponseSectionSetting);
		КонецЦикла;
		КонтейнерXDTO.dataVerificationResponseSections.Добавить(dataVerificationResponseSection);
	КонецЦикла;
	
	Возврат КонтейнерXDTO;
		
КонецФункции

Функция ПеренестиТаблицуРезультатВ_XDTO(ТаблицаРезультат, РазделXDTO)
	
	Для Каждого СтрокаРезультат Из ТаблицаРезультат Цикл
		dataVerificationResponseRow = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", "dataVerificationResponseRow");
		ЗаполнитьЗначенияСвойств(dataVerificationResponseRow, СтрокаРезультат);
		РазделXDTO["dataResponse"].Добавить(dataVerificationResponseRow);	
	КонецЦикла;
	
КонецФункции	

Функция СформироватьТекстСообщенияЗапросДанных(СтруктураПараметров = Неопределено) Экспорт
	
	ОбъектXDTO_ЗапросДанных = ПолучитьОбъектXDTO_ЗапросДанных(СтруктураПараметров);
	ИмяТипаЭлементаXDTO	 = "headers";
	ЭлементКонтейнераXDTO = тн_Интеграция.СоздатьКонтейнерXDTO("tn_integrationERP", ИмяТипаЭлементаXDTO);
	ОбъектXDTO_ЗапросДанных[ИмяТипаЭлементаXDTO] = ЭлементКонтейнераXDTO;
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("КонтейнерXDTO", ОбъектXDTO_ЗапросДанных);
	ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_УПП").ДобавитьСистемныеПараметры(ПараметрыОтправки);
	// НАЧАЛО Борисенко И.Н. 22.02.2022 Выполнение задач №000039202
	//Возврат ОбщегоНазначения.ОбщийМодуль("тн_Интеграция").СериализоватьКонтейнерXDTO(ОбъектXDTO_ЗапросДанных, , "JSON");
	
	ТекстСообщения = ОбщегоНазначения.ОбщийМодуль("тн_Интеграция").СериализоватьКонтейнерXDTO(ОбъектXDTO_ЗапросДанных, , "JSON");
	тн_Интеграция_УПП.ЗаменитьПредставлениеФорматов(ТекстСообщения);
	Возврат ТекстСообщения;
	// КОНЕЦ Борисенко И.Н. 22.02.2022 Выполнение задач №000039202
	
