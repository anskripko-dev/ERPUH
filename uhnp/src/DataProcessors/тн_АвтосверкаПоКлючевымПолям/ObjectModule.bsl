Функция ПолучитьСтруктуруТаблицПараметровНастройкиЗапросаДанных(ИмяРазделаСтрока, ПараметрыНастройкиМассив)
	
	СтруктураВозврат = Новый Структура();
	
	ТаблицаБитыхСсылок = ИнициализироватьТаблицуПоСтруктуре(ПолучитьСтруктуруБитыхСсылок());
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ЕстьОтборПоСтруктуре = Ложь;
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477	
	Для Каждого ПараметрыНастройки Из ПараметрыНастройкиМассив Цикл
		Если ПараметрыНастройки["columnName"] = "Пользователь" Тогда
			Продолжить;
		КонецЕсли;
		ТаблицаДанных = ПолучитьТаблицуДанныхПоПараметрам(ИмяРазделаСтрока, ПараметрыНастройки, ТаблицаБитыхСсылок);
		СтруктураВозврат.Вставить(ПараметрыНастройки["columnName"], ТаблицаДанных);
		// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
		// НАЧАЛО ГенатулинМА 25.02.22 Выполнение задачи №000040502
		//СтруктураВозврат.Вставить("ЕстьОтбор", ЗначениеЗаполнено(ПараметрыНастройки.selectionString));
		// КОНЕЦ ГенатулинМА 25.02.22 Выполнение задачи №000040502
		ЕстьОтборПоСтруктуре = ЕстьОтборПоСтруктуре Или ЗначениеЗаполнено(ПараметрыНастройки.selectionString);
		// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477	
	КонецЦикла;
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	СтруктураВозврат.Вставить("ЕстьОтбор", ЕстьОтборПоСтруктуре);
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477	
	СтруктураВозврат.Вставить("ТаблицаБитыхСсылок", ТаблицаБитыхСсылок);
	
	Возврат СтруктураВозврат;
	
