			БанкКасса = Справочники.Кассы.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаПриемник.id_BankKassa));
			
			Если Не ЗначениеЗаполнено(БанкКасса) Тогда
				БанкКасса = Справочники.БанковскиеСчетаОрганизаций.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаПриемник.id_BankKassa));
			КонецЕсли;
			
			СтрокаПриемник.БанкКасса = БанкКасса;   
			//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144  
			Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаПриемник.id_Organization));
			СтрокаПриемник.Организация = Организация;
			//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144
		КонецЦикла;
		
		ЗапросДанных = Новый Запрос();
		ЗапросДанных.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаERP.БанкКасса КАК БанкКасса,
