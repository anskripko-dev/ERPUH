Функция ОтправитьСообщениеОтвет(КлючМаршрутизации = Неопределено) Экспорт
	
	ТекстСообщения = СообщениеОтветОКС_В_ERP;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
			
	ПараметрыОтправки = Новый Структура();
			
	// - xdto-пакет
	ПараметрыОтправки.Вставить("ИмяПакетаXDTO"		, "tn_integrationERP");
	ПараметрыОтправки.Вставить("ИмяТипаXDTO"		, "dataVerificationRequest");
	
	// - транспорт (RabbitMQ)
	ПараметрыОтправки.Вставить("Профиль"			, Справочники.тн_ПрофилиПодключений.ERP_УХ);
	ПараметрыОтправки.Вставить("ФорматСообщения"	, "JSON");
	ПараметрыОтправки.Вставить("ТочкаОбменаRabbitMQ", Справочники.ТочкиОбменаRMQ.ТекущаяБаза);
	КлючМаршрутизацииСообщения = ?(КлючМаршрутизации = Неопределено, ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_ERP_УХ").КлючОтправителя(), КлючМаршрутизации);
	ПараметрыОтправки.Вставить("КлючМаршрутизации"	, КлючМаршрутизацииСообщения);
	
	// - логирование
	ПараметрыОтправки.Вставить("Лог_ВидСообщения"	, Перечисления.тн_ВидыСообщений_ERP_УХ.СообщениеОбмена);
	ПараметрыОтправки.Вставить("Лог_ВидИнтеграции"	, Перечисления.тн_ВидыИнтеграций.ERP_УХ_Отправка);
	ПараметрыОтправки.Вставить("КонтейнерXDTO", ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON));
		
	ОбщегоНазначения.ОбщийМодуль("тн_Интеграция_ERP_УХ").ОтправитьПакет(ТекстСообщения, ПараметрыОтправки);
	
КонецФункции

Функция ПолучитьМассив_ИзСпискаXDTO(СписокXDTO, ТолькоУникальные = Истина)
	
	МассивВозврат = Новый Массив();
	
	Для Каждого Значение Из СписокXDTO Цикл
		Если ТолькоУникальные 
			И Не МассивВозврат.Найти(Значение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		МассивВозврат.Добавить(Значение);
	КонецЦикла;
	
	Возврат МассивВозврат;
	
КонецФункции	


