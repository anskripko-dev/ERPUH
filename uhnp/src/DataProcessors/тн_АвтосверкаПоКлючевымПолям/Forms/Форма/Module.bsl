&НаКлиенте
Процедура НастройкиКомпоновки_ДС_ПриАктивизацииЯчейки(Элемент)
	
	ДанныеСтроки = Элементы.НастройкиКомпоновки_ДС.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрока = ДанныеСтроки.ИдентификаторСтроки;
	ИдентификаторКолонка = Элемент.ТекущийЭлемент.Имя;
		
	Если СтрНайти(ИдентификаторКолонка, "НомерСтроки")>0 Тогда
		ЭтоКолонкаОтбора = Ложь;
		ТекущийИдентификаторКолонка = "";
	Иначе
		ЭтоКолонкаОтбора = Истина;
	КонецЕсли;
	Элементы.ОтборДанных_ДС.Доступность = ЭтоКолонкаОтбора;
	Если Не ЭтоКолонкаОтбора Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНоваяСтрока = НЕ ЗначениеЗаполнено(ИдентификаторСтрока);
	Если ЭтоНоваяСтрока Тогда
		КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	КонецЕсли;	
	
	Если (НЕ ИдентификаторКолонка = ТекущийИдентификаторКолонка 
		Или НЕ ИдентификаторСтрока = ТекущийИдентификаторСтрока Или РежимДобавленияСтроки) Тогда
		Если Не ЭтоНоваяСтрока Тогда
			ОтобразитьОтборКомпоновкиДанных(ДанныеСтроки, ИдентификаторКолонка);
		КонецЕсли;
		
		ТекущийИдентификаторСтрока = ИдентификаторСтрока;
		ТекущийИдентификаторКолонка = ИдентификаторКолонка;
		РежимДобавленияСтроки = Ложь;
	КонецЕсли;

КонецПроцедуры

