// Белоконенко Денис 11.07.2022 Выполнение задач №000041872 
// Открывает форму элемента значения расшифровки.
//
// Параметры:
//  Расшифровка - Числовой индекс расшифровки табл. документа
//  ТекстовоеЗначениеПоля - Строковое значение текущего поля расшифровки
//  ИмяРеквизитаДанныхРасшифровки - Необязательное. Реквизит строкой объекта обработки, где хранятся данные расшифровки. Если не указано, то ищется по всем реквизитам расшифровок
&НаКлиенте
Процедура ОткрытьЗначениеРасшифровки(Расшифровка, ТекстовоеЗначениеПоля, ИмяРеквизитаДанныхРасшифровки = Неопределено)
	ЗначениеРасшифровки = ПолучитьЗначениеРасшифровки(Расшифровка, ТекстовоеЗначениеПоля, ИмяРеквизитаДанныхРасшифровки);
	Если ЗначениеРасшифровки <> Неопределено Тогда
		ПоказатьЗначение(,ЗначениеРасшифровки);		
	КонецЕсли	
КонецПроцедуры

// Белоконенко Денис 11.07.2022 Выполнение задач №000041872
&НаСервере
Функция ПолучитьЗначениеРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки)
	СсылкаРасшифровки = Неопределено;
	
	Если РеквизитРасшифровки = Неопределено Тогда
		// Проверим по всем расшифровкам
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ОТН) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ОТН");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ЗТР) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ЗТР");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ВРЧ) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ВРЧ");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		
		// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ДС) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ДС");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
		
		// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_РСК) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_РСК");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
		
		// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ОТН_отб) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ОТН_отб");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ЗТР_отб) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ЗТР_отб");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ВРЧ_отб) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ВРЧ_отб");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621 
		
		//НАЧАЛО Качикина 27.01.2025 Выполнение задач №000052362 
		Если ЗначениеЗаполнено(Объект.ДанныеРасшифровки_ERP_ОКС_ПД) Тогда
			ТекСсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, "ДанныеРасшифровки_ERP_ОКС_ПД");	
			Если ТекСсылкаРасшифровки <> Неопределено Тогда
				СсылкаРасшифровки = ТекСсылкаРасшифровки;			
			КонецЕсли;
		КонецЕсли;
		//КОНЕЦ Качикина 27.01.2025 Выполнение задач №000052362
		
	Иначе
		СсылкаРасшифровки = ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки);	
	КонецЕсли;
	
	Возврат СсылкаРасшифровки;
КонецФункции

// Белоконенко Денис 11.07.2022 Выполнение задач №000041872
&НаСервере
Функция ПолучитьЗначениеРасшифровкиПоДаннымРасшифровки(Расшифровка, ТекстПоляРасшифровки, РеквизитРасшифровки)
	СсылкаРасшифровки = Неопределено;
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(Объект[РеквизитРасшифровки]);
	//НАЧАЛО Качикина 23.01.2025 Выполнение задач №000052362
	//Если Число(Расшифровка) <= ДанныеРасшифровки.Элементы.Количество() - 1 
	Если ТипЗнч(ДанныеРасшифровки)=Тип("ДанныеРасшифровкиКомпоновкиДанных")
		И Число(Расшифровка) <= ДанныеРасшифровки.Элементы.Количество() - 1 
	//КОНЕЦ Качикина 23.01.2025 Выполнение задач №000052362
		И ТипЗнч(ДанныеРасшифровки.Элементы[Расшифровка]) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля")
		И ДанныеРасшифровки.Элементы[Расшифровка].ОсновноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		
		МассивЗначений = ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля();
		Если МассивЗначений.Количество() > 0 И Строка(МассивЗначений[0].Значение) = ТекстПоляРасшифровки Тогда
			СсылкаРасшифровки = МассивЗначений[0].Значение;		
		КонецЕсли;
	КонецЕсли; 
	
	Возврат СсылкаРасшифровки;
КонецФункции	

