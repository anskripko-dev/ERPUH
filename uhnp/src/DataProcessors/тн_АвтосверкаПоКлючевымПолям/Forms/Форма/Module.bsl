			//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144 
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Организация = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_ДС_Организация");
			//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Банк) Тогда
			ДанныеСтроки.Банк = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_ДС_Банк");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Касса) Тогда
			ДанныеСтроки.Касса = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_ДС_Касса");
		КонецЕсли;		
					
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Пользователь) Тогда
			ДанныеСтроки.Пользователь = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_ДС_Пользователь");
		КонецЕсли;
			
		//НАЧАЛО Блинова М.А. 31.01.2024 Выполнение задач №000048144 
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Организация) Тогда
			ДанныеСтроки.Организация = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_ДС_Организация");
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 31.01.2024 Выполнение задач №000048144

		РежимДобавленияСтроки = Истина;
		ЭтоКопированиеСтроки = Ложь;
		НастройкиКомпоновки_ДС_ПриАктивизацииЯчейки(Элемент);
	КонецЕсли;
	
