&НаСервере
Процедура ОбработатьЗапросОтERP_НаСервере()
	
	ОКС_ДатаНачалаОбработки = ТекущаяДатаСеанса();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТекстСообщенияJSON = ОбработкаОбъект.СообщениеЗапросОКС_Из_ERP;
			
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТекстСообщенияJSON);
	СообщениеXDTO = ФабрикаXDTO.ПрочитатьJSON(ЧтениеJSON);
	
	СтруктураПараметровЗапросДанных = Новый Структура();
	СтруктураПараметровЗапросДанных.Вставить("ТекстСообщенияJSON", ТекстСообщенияJSON);
	СтруктураПараметровЗапросДанных.Вставить("СообщениеXDTO", СообщениеXDTO);
	ОбработкаОбъект.СообщениеОтветОКС_В_ERP = ОбработкаОбъект.СформироватьТекстСообщенияОтветНаЗапросДанных(СтруктураПараметровЗапросДанных);
		
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	ОКС_ДатаОкончанияОбработки = ТекущаяДатаСеанса();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗапросОтERP(Команда)
		
	ОбработатьЗапросОтERP_НаСервере();
	
