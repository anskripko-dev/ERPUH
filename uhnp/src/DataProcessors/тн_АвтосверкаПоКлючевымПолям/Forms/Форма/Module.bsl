&НаСервере
Функция ПолучитьДлительнуюОперациюОжиданияОбработкиОтветногоСообщения(ПараметрыСтруктура)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", Объект.НормативноеВремяОжиданияОтветаСекунд);
	ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
	ПараметрыВыполнения.Вставить("ПоДокументам", ПараметрыСтруктура.ПоДокументам);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработки.тн_АвтосверкаПоКлючевымПолям.ПолучитьСтруктуруРезультат", ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872 
    СтруктураПроверки = ПроверитьЗаполненностьРеквизитов();
	Если НЕ СтруктураПроверки.РезультатПроверки Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураПроверки.СообщениеПользователю);
		Возврат;
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	
	// НАЧАЛО Юдина Екатерина 21.04.2025 Выполнение задач №000053482   
	ОчиститьРезультат();
	ОчиститьВременныеХранилища();
	// КОНЕЦ Юдина Екатерина 21.04.2025 Выполнение задач №000053482
	
	//1. Формируем и отправляем сообщение-запрос
	
	ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанныхСервер();
	
	ПараметрыСтруктура = Новый Структура();
	ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
	ПараметрыСтруктура.Вставить("ПоДокументам", Ложь);
	ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
	
	СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура); 
	
	Если ОтправитьСообщениеЗапросСервер() Тогда
		// НАЧАЛО Белоконенко Денис 25.10.2022 Выполнение задач №000043105
		ОчиститьРезультат();
		// КОНЕЦ  Белоконенко Денис 25.10.2022 Выполнение задач №000043105
		
		ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура);
		//2. Ожидаем ответа
		
		ДлительнаяОперация = ПолучитьДлительнуюОперациюОжиданияОбработкиОтветногоСообщения(ПараметрыСтруктура);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиОтветногоСообщения", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	КонецЕсли;	
		
КонецПроцедуры

