&НаСервере
Процедура СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ПараметрыСтруктура.ПоДокументам Тогда
		ОбработкаОбъект.СообщениеЗапросERP_В_ОКС_ПоДокументам = ОбработкаОбъект.СформироватьТекстСообщенияЗапросДанных(ПараметрыСтруктура);
	Иначе
		ОбработкаОбъект.СообщениеЗапросERP_В_ОКС = ОбработкаОбъект.СформироватьТекстСообщенияЗапросДанных(ПараметрыСтруктура);
	КонецЕсли;
	
	ОбработкаОбъект.ЭтоОтладка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСтруктура, "ЭтоОтладка", Ложь);
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСообщениеЗапрос(Команда)
	
	ИдентификаторЗапроса = ПолучитьИдентификаторЗапросаДанныхСервер();
	
	ПараметрыСтруктура = Новый Структура();
	ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
	ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
	ПараметрыСтруктура.Вставить("ПоДокументам", Ложь);
	ПараметрыСтруктура.Вставить("ЭтоОтладка", Истина);
	
	СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура);
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
