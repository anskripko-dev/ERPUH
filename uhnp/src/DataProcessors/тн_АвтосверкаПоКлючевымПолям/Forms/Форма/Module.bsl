&НаСервере
Процедура ОчиститьВременныеХранилища()
	
	МассивАдресовВХ = Новый Массив;   
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ОТН);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ОТН_отб);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ЗТР);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ЗТР_отб);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ВРЧ);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ВРЧ_отб);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ДС);         
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_РСК);
	МассивАдресовВХ.Добавить(Объект.ДанныеРасшифровки_ERP_ОКС_ПД);         
	
	Для Каждого Адрес Из МассивАдресовВХ Цикл   
		
		Попытка
			УдалитьИзВременногоХранилища(Объект.Адрес);
		Исключение	
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

