	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроекКомпоновкиДанных, "ПД", Объект.Активно_ПД);
	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроекКомпоновкиДанных, "ЗТР_отб", Объект.Активно_ЗТР_отб);
	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроекКомпоновкиДанных, "ОТН_отб", Объект.Активно_ОТН_отб); 
	УстановитьПользовательскийПараметрСКД(КомпоновщикНастроекКомпоновкиДанных, "РСК", Объект.Активно_РСК);
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621  
	
	ПараметрыОткрытия = Новый Структура(); 	
	ПараметрыОткрытия.Вставить("Вариант", КомпоновщикНастроекКомпоновкиДанных.Настройки);
	ПараметрыОткрытия.Вставить("ПользовательскиеНастройки", КомпоновщикНастроекКомпоновкиДанных.ПользовательскиеНастройки);
	ПараметрыОткрытия.Вставить("КлючВарианта", "Основной");
	
	Возврат ПараметрыОткрытия;

КонецФункции

// Чекордина Ирина 26.06.2024 Выполнение задач №000049505
&НаСервере
Функция ПолучитьДлительнуюОперациюОжиданияПодготовкиРезультатаОтчета(ПараметрыСтруктура)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.Вставить("НормативноеВремяОжиданияОтветаСекунд", Объект.НормативноеВремяОжиданияОтветаСекунд);
	ПараметрыВыполнения.Вставить("ИдентификаторЗапроса", ПараметрыСтруктура.ИдентификаторЗапроса);
	ПараметрыВыполнения.Вставить("СтруктураДанныхОбработки", ПараметрыСтруктура.СтруктураДанныхОбработки);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработка.тн_АвтосверкаПоКлючевымПолям.МодульОбъекта.СформироватьСтруктуруОбработкаОтветаНаЗапрос", ПараметрыВыполнения);
	
КонецФункции

// Чекордина Ирина 26.06.2024 Выполнение задач №000049505
&НаКлиенте
Процедура ПриЗавершенииПодготовкиРезультатаОтчета(Результат, ДополнительныеПараметры) Экспорт
		
	//1. Отменено пользователем
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//2. Возникла ошибка
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;	
	КонецЕсли;
	
	ЗаданиеВыполнено = (Результат.Статус = "Выполнено");
	
	//3. Обрабатываем результат
	Если ЗаданиеВыполнено Тогда
		ТребуетсяДетализация = ЗаполнитьРеквизитыОбъектаИзРезультата(Результат.АдресРезультата);
		Если Объект.ПоДокументам Тогда
			ЭтотОбъект.ТекущийЭлемент = Элементы.ГруппаРезультатОтчетСтраница;
		КонецЕсли;  
	КонецЕсли;
	
	//4. Анализируем требуется ли детализация по документам
	Если ТребуетсяДетализация = Истина Тогда
		ПараметрыСтруктура = Новый Структура();
		ПараметрыСтруктура.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		ПараметрыСтруктура.Вставить("ИдентификаторФормы", Строка(УникальныйИдентификатор));
		ПараметрыСтруктура.Вставить("ПоДокументам", Истина);
		ПараметрыСтруктура.Вставить("ОтправкаЗапроса", Истина);
		
		СформироватьСообщениеЗапросНаСервере(ПараметрыСтруктура);
		
		Если ОтправитьСообщениеЗапросСервер() Тогда
			
			ДобавитьЗаписьДанныеАвтосверкаСервер(ПараметрыСтруктура);
						
			ДлительнаяОперация = ПолучитьДлительнуюОперациюОжиданияОбработкиОтветногоСообщения(ПараметрыСтруктура);
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			Оповещение = Новый ОписаниеОповещения("ПриЗавершенииОбработкиОтветногоСообщения", ЭтотОбъект);
			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

// Чекордина Ирина 26.06.2024 Выполнение задач №000049505
&НаСервере
Функция ЗаполнитьРеквизитыОбъектаИзРезультата(АдресРезультата)
	 
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.РезультатТД = Результат.РезультатТД;
	ОбработкаОбъект.РезультатТД_ВРЧ = Результат.РезультатТД_ВРЧ;
	ОбработкаОбъект.РезультатТД_ВРЧ_отб = Результат.РезультатТД_ВРЧ_отб;
	ОбработкаОбъект.РезультатТД_ДС = Результат.РезультатТД_ДС;
	ОбработкаОбъект.РезультатТД_ЗТР = Результат.РезультатТД_ЗТР;
	ОбработкаОбъект.РезультатТД_ЗТР_отб = Результат.РезультатТД_ЗТР_отб;
	ОбработкаОбъект.РезультатТД_ОТН = Результат.РезультатТД_ОТН;
	ОбработкаОбъект.РезультатТД_ОТН_отб = Результат.РезультатТД_ОТН_отб;
	ОбработкаОбъект.РезультатТД_ПД = Результат.РезультатТД_ПД;
	ОбработкаОбъект.РезультатТД_РСК = Результат.РезультатТД_РСК;
	//НАЧАЛО Качикина 23.01.2025 Выполнение задач №000052362
	СтруктураАдресовВХ = Результат.СтруктураАдресовВХ;
	Если СтруктураАдресовВХ <> Неопределено Тогда 
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ОТН		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ОТН; 
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ОТН_отб	= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ОТН_отб;  	
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ЗТР		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ЗТР;
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ЗТР_отб	= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ЗТР_отб;
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ВРЧ		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ВРЧ;
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ВРЧ_отб	= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ВРЧ_отб;
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ДС		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ДС;
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_РСК		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_РСК;  
		ОбработкаОбъект.ДанныеРасшифровки_ERP_ОКС_ПД		= СтруктураАдресовВХ.ДанныеРасшифровки_ERP_ОКС_ПД;
	КонецЕсли;
	//КОНЕЦ Качикина 23.01.2025 Выполнение задач №000052362
	Если Результат.ТребуетсяДетализация = Истина Тогда
		ОбработкаОбъект.СтруктураСообщенияСверкаПоОстаткам = ЗначениеВСтрокуВнутр(Результат);
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Возврат Результат.ТребуетсяДетализация;
	 
КонецФункции

