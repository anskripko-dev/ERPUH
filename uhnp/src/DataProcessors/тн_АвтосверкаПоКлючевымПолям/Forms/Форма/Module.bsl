&НаСервере
Процедура ОчиститьРезультат()
	Объект.РезультатТД.Очистить();
	
	Если Объект.Активно_ОТН Тогда
		Объект.РезультатТД_ОТН.Очистить();
	КонецЕсли;
	
	Если Объект.Активно_ВРЧ Тогда
		Объект.РезультатТД_ВРЧ.Очистить();
	КонецЕсли;
	
	Если Объект.Активно_ЗТР Тогда
		Объект.РезультатТД_ЗТР.Очистить();
	КонецЕсли;
	
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	Если Объект.Активно_ДС Тогда
		Объект.РезультатТД_ДС.Очистить();
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	Если Объект.Активно_РСК Тогда
		Объект.РезультатТД_РСК.Очистить();
	КонецЕсли;
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477

	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	Если Объект.Активно_ОТН_отб Тогда
		Объект.РезультатТД_ОТН_отб.Очистить();
	КонецЕсли;
	
	Если Объект.Активно_ВРЧ_отб Тогда
		Объект.РезультатТД_ВРЧ_отб.Очистить();
	КонецЕсли;
	
	Если Объект.Активно_ЗТР_отб Тогда
		Объект.РезультатТД_ЗТР_отб.Очистить();
	КонецЕсли;
	
	Если Объект.Активно_ПД Тогда
		Объект.РезультатТД_ПД.Очистить();
	КонецЕсли;
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	
КонецПроцедуры

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047114
//
&НаСервере
Функция ПолучитьНастройкиКомпоновки(КомпоновщикНастроекКомпоновкиДанных) Экспорт
		
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		
	Если НЕ Объект.СоответствиеКолонокИ_КолонокСКД.Количество() Тогда
		ОбработкаОбъект.ЗаполнитьСоответствиеКолонокИ_МакетовСКД();	
	КонецЕсли;
	
	ТаблицаСоответствиеКолонокИ_КолонокСКД = Объект.СоответствиеКолонокИ_КолонокСКД.Выгрузить();
	 				
	МассивАктивныхРазделов = ОбработкаОбъект.ПолучитьМассивАктивныхРазделов();
	
	Для Каждого АктивныйРаздел Из МассивАктивныхРазделов Цикл
				
		ТаблицаНастройкиКомпоновки_Имя = "НастройкиКомпоновки_" + АктивныйРаздел;
		ТаблицаНастройкиКомпоновки = ОбработкаОбъект[ТаблицаНастройкиКомпоновки_Имя].Выгрузить();
				
		Если НЕ ТаблицаНастройкиКомпоновки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		МассивНастроек = Новый Массив();
		
		Для Каждого Строка_ТаблицаНастройкиКомпоновки Из ТаблицаНастройкиКомпоновки Цикл
				
			СтруктураДобавленныхКолонок = Новый Структура();
			
			Для Каждого СтрокаТаблицыСоответствия Из ТаблицаСоответствиеКолонокИ_КолонокСКД Цикл
					
					КолонкаТаблицаНастройкиКомпоновки_ПоТаблицеСоответствия = ТаблицаНастройкиКомпоновки.Колонки.Найти(СтрокаТаблицыСоответствия.ИмяКолонкиСКД);
					
					Если НЕ КолонкаТаблицаНастройкиКомпоновки_ПоТаблицеСоответствия = Неопределено
						И НЕ СтруктураДобавленныхКолонок.Свойство(СтрокаТаблицыСоответствия.ИмяКолонкиСКД) Тогда
						
						СтруктураДобавленныхКолонок.Вставить(СтрокаТаблицыСоответствия.ИмяКолонкиСКД);
						URL_СКД = ОбработкаОбъект.ПолучитьURL_СКД_Колонки(СтрокаТаблицыСоответствия.ИмяКолонкиСКД);
						
							АдресНастроек_Имя = "АдресХранилищаНастроекКомпоновщика_" + СтрокаТаблицыСоответствия.ИмяКолонкиСКД;
							АдресНастроек_Значение = Строка_ТаблицаНастройкиКомпоновки[АдресНастроек_Имя];
							НастройкиКомпоновщика = ПолучитьИзВременногоХранилища(АдресНастроек_Значение);
							
							Если Не НастройкиКомпоновщика = Неопределено Тогда
								Отчеты.тн_АвтосверкаПоКлючевымПолям.СкопироватьЭлементы(КомпоновщикНастроекКомпоновкиДанных.Настройки.Отбор, НастройкиКомпоновщика.Отбор, Ложь,СтрокаТаблицыСоответствия.ИмяКолонкиСКД,СтрокаТаблицыСоответствия.ИмяКолонкиСКД + "_" + АктивныйРаздел, Истина);	
							КонецЕсли;
							
					КонецЕсли;
					
				КонецЦикла;
										
		КонецЦикла;
				
	КонецЦикла;
			
	Возврат Истина;
	
КонецФункции   

// Гутарова Екатерина 10.10.2023 Выполнение задач №000047114
//
&НаСервере
Процедура УстановитьПользовательскийПараметрСКД(КомпоновщикНастроекКомпоновкиДанных, ИмяПараметра, Значение)
	
	Перем ПараметрДанных, Настройки, ПользовательскиеНастройки, ПользовательскийПараметр;
	
	Настройки = КомпоновщикНастроекКомпоновкиДанных.Настройки;
	ПараметрДанных = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки) Тогда
		ПользовательскиеНастройки = КомпоновщикНастроекКомпоновкиДанных.ПользовательскиеНастройки;
		ПользовательскийПараметр = ПользовательскиеНастройки.Элементы.Найти(ПараметрДанных.ИдентификаторПользовательскойНастройки);
		ПользовательскийПараметр.Использование = Истина;
		ПользовательскийПараметр.Значение = Значение;
	КонецЕсли;
	
КонецПроцедуры 

