&НаКлиенте
Процедура ОтобразитьОтборКомпоновкиДанных(ДанныеСтроки, ИдентификаторКолонка)
	
	АдресСкд = ПолучитьURL_СКД_Колонки(ИдентификаторКолонка);
	ИнициализироватьКомпоновщикНастроекПоСКД(АдресСкд);
	//КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	ТекущиеНастройкиКомпоновщика = ПолучитьИзВременногоХранилища(ПолучитьАдресХранилищаНастроекПоКолонке(ДанныеСтроки, ИдентификаторКолонка));
	Если НЕ ТекущиеНастройкиКомпоновщика = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(ТекущиеНастройкиКомпоновщика);
		КомпоновщикНастроек.Восстановить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиКомпоновщикаКлиент(ДанныеСтроки, ИдентификаторКолонка)
	
	АдресХранилищаНастроек = ПолучитьАдресХранилищаНастроекПоКолонке(ДанныеСтроки, ИдентификаторКолонка);
	СохранитьНастройкиКомпоновщикаСервер(АдресХранилищаНастроек);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиКомпоновщикаСервер(АдресХранилищаНастроек)
	
	ПоместитьВоВременноеХранилище(КомпоновщикНастроек.ПолучитьНастройки(), АдресХранилищаНастроек);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьАдресХранилищаНастроекПоКолонке(ДанныеСтроки, ИдентификаторКолонка)
	
Возврат ДанныеСтроки["АдресХранилищаНастроекКомпоновщика_" + ПолучитьИмяКолонкиДляСКД(ИдентификаторКолонка)];
	
КонецФункции	

&НаСервере
Функция ПолучитьАдресНастроекКомпоновкиКолонки(ИмяКолонки)
	
	//КомпоновщикНастроекСКД = Новый КомпоновщикНастроекКомпоновкиДанных();
	СтрокаАдресСКД = ПолучитьURL_СКД_Колонки(ИмяКолонки);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СтрокаАдресСКД));
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();
	Возврат ПоместитьВоВременноеХранилище(НастройкиКомпоновщика, Новый УникальныйИдентификатор());
		
КонецФункции

&НаСервере
Функция ПолучитьURL_СКД_Колонки(ИмяКолонки)
	
	Возврат Объект.НастройкиСКД.НайтиСтроки(Новый Структура("ИмяКолонки", ПолучитьИмяКолонкиДляСКД(ИмяКолонки)))[0].URL_СКД;
	
КонецФункции

&НаСервере
Функция ПолучитьИмяКолонкиДляСКД(ИмяКолонки)
	
	Возврат Объект.СоответствиеКолонокИ_КолонокСКД.НайтиСтроки(Новый Структура("ИмяКолонки", ИмяКолонки))[0].ИмяКолонкиСКД;
	
КонецФункции	

