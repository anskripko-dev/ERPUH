// Белоконенко Денис 11.07.2022 Выполнение задач №000041872 
// Проверяет заполнение основных параметров перед отправкой запроса.
//
// Возвращаемое значение:
//  Структура: РезультатПроверки - Булево. Если Истина, то проверка прошла успешно
//  СообщениеПользователю - Строка. Текст сообщения если РезультатПроверки = Ложь
&НаКлиенте
Функция ПроверитьЗаполненностьРеквизитов()
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("РезультатПроверки", Истина);
	СтруктураПроверки.Вставить("СообщениеПользователю", "");
	
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	//Если НЕ Объект.Активно_ОТН И НЕ Объект.Активно_ЗТР И НЕ Объект.Активно_ВРЧ Тогда
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	//Если НЕ Объект.Активно_ОТН И НЕ Объект.Активно_ЗТР И НЕ Объект.Активно_ВРЧ И НЕ Объект.Активно_ДС Тогда
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	//Если НЕ Объект.Активно_ОТН И НЕ Объект.Активно_ЗТР И НЕ Объект.Активно_ВРЧ И НЕ Объект.Активно_ДС И НЕ Объект.Активно_РСК Тогда
	Если НЕ Объект.Активно_ОТН И НЕ Объект.Активно_ЗТР И НЕ Объект.Активно_ВРЧ И НЕ Объект.Активно_ДС И НЕ Объект.Активно_РСК И НЕ Объект.Активно_ОТН_отб И НЕ Объект.Активно_ЗТР_отб И НЕ Объект.Активно_ВРЧ_отб И НЕ Объект.Активно_ПД Тогда
	// КОНЕЦ Климов Антон 27.02.2024 Выполнение задач №000048621
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
		СтруктураПроверки.РезультатПроверки	= Ложь;
