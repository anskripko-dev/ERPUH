
#Область Обработчики_Событий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.ЗаполнитьНастройкиСКД_ЗапросДанных();
	ОбработкаОбъект.ЗаполнитьСоответствиеКолонокИ_МакетовСКД();
	ОбработкаОбъект.ЕстьСохраненныеНастройки = ОбработкаОбъект.ЗагрузитьНастройкиОбработки();
	ОбработкаОбъект.ЗаполнитьНеСохраняемыеНастройки(ОбработкаОбъект.ЕстьСохраненныеНастройки);
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	// НАЧАЛО Белоконенко Денис 11.07.2022 Выполнение задач №000041872
    ДозаполнитьЭлементыФормы();
	// КОНЕЦ Белоконенко Денис 11.07.2022 Выполнение задач №000041872
	
	УстановитьВидимостьДоступностьСервер();
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКомпоновки_ОТН_ПриАктивизацииЯчейки(Элемент)
	
	ДанныеСтроки = Элементы.НастройкиКомпоновки_ОТН.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрока = ДанныеСтроки.ИдентификаторСтроки;
	ИдентификаторКолонка = Элемент.ТекущийЭлемент.Имя;
		
	Если СтрНайти(ИдентификаторКолонка, "НомерСтроки")>0 Тогда
		ЭтоКолонкаОтбора = Ложь;
		ТекущийИдентификаторКолонка = "";
	Иначе
		ЭтоКолонкаОтбора = Истина;
	КонецЕсли;
	Элементы.ОтборДанных_ОТН.Доступность = ЭтоКолонкаОтбора;
	Если Не ЭтоКолонкаОтбора Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНоваяСтрока = НЕ ЗначениеЗаполнено(ИдентификаторСтрока);
	Если ЭтоНоваяСтрока Тогда
		КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	КонецЕсли;	
	
	Если (НЕ ИдентификаторКолонка = ТекущийИдентификаторКолонка 
		Или НЕ ИдентификаторСтрока = ТекущийИдентификаторСтрока Или РежимДобавленияСтроки) Тогда
		Если Не ЭтоНоваяСтрока Тогда
			ОтобразитьОтборКомпоновкиДанных(ДанныеСтроки, ИдентификаторКолонка);
		КонецЕсли;
		
		ТекущийИдентификаторСтрока = ИдентификаторСтрока;
		ТекущийИдентификаторКолонка = ИдентификаторКолонка;
		РежимДобавленияСтроки = Ложь;
	КонецЕсли;

КонецПроцедуры

