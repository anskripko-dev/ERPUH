&НаСервере
Процедура ОбработатьРезультатВыполнения(СтруктураРезультат)
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СообщениеОтветERP_От_ОКС = СтруктураРезультат.Результат;
	ОбработкаОбъект.ПоДокументам = СтруктураРезультат.ПоДокументам;
		
	СтруктураОбработка = ОбработкаОбъект.СформироватьСтруктуруОбработкаОтветаНаЗапрос();
	СтруктураРезультат.Вставить("ТребуетсяДетализация", СтруктураОбработка.ТребуетсяДетализация);
	Если СтруктураОбработка.ТребуетсяДетализация = Истина Тогда
		ОбработкаОбъект.СтруктураСообщенияСверкаПоОстаткам = ЗначениеВСтрокуВнутр(СтруктураОбработка);
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Если ОбработкаОбъект.ПоДокументам Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.ГруппаРезультатОтчетСтраница;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура Группа_Разделы_СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	
	ТекущийИдентификаторСтрока = "";
	
	Если ТекущаяСтраница = Элементы.Группа_ОТН_Страница Тогда
		НастройкиКомпоновки_ОТН_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ОТН);
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ВРЧ_Страница Тогда
		НастройкиКомпоновки_ВРЧ_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ВРЧ);
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ЗТР_Страница Тогда
		НастройкиКомпоновки_ЗТР_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ЗТР);
	// НАЧАЛО Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ДС_Страница Тогда
		НастройкиКомпоновки_ДС_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ДС);
	// КОНЕЦ  Белоконенко Денис 06.10.2022 Выполнение задач №000042886
	// НАЧАЛО Климов Антон 17.05.2023 Выполнение задач №000045477
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_РСК_Страница Тогда
		НастройкиКомпоновки_РСК_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_РСК);
	// КОНЕЦ  Климов Антон 17.05.2023 Выполнение задач №000045477
	// НАЧАЛО Климов Антон 27.02.2024 Выполнение задач №000048621
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ОТН_отб_Страница Тогда
		НастройкиКомпоновки_ОТН_отб_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ОТН_отб);
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ВРЧ_отб_Страница Тогда
		НастройкиКомпоновки_ВРЧ_отб_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ВРЧ_отб);
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ЗТР_отб_Страница Тогда
		НастройкиКомпоновки_ЗТР_отб_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ЗТР_отб);
	ИначеЕсли ТекущаяСтраница = Элементы.Группа_ПД_Страница Тогда
		НастройкиКомпоновки_ПД_ПриАктивизацииЯчейки(Элементы.НастройкиКомпоновки_ПД);
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	КонецЕсли;	
	
КонецПроцедуры

