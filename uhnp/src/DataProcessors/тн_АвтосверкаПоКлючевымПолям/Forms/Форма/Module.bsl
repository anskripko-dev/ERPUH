	НеЗаданОтборПодразделение = ПроверитьЗаполненностьОтборовРаздела(Объект.Активно_ЗТР_отб, "НастройкиКомпоновки_ЗТР_отб", "НастройкиКомпоновки_ЗТР_отб_Подразделение"); 
	//НАЧАЛО Блинова М.А. 28.02.2024 Выполнение задач №000048144
	//Если НеЗаданОтборСтатьяРасходов И НеЗаданОтборПодразделение Тогда 
	НеЗаданОтборПоОрганизации = ПроверитьЗаполненностьОтборовРаздела(Объект.Активно_ЗТР_отб, "НастройкиКомпоновки_ЗТР_отб", "НастройкиКомпоновки_ЗТР_отб_Организация"); 
	Если НеЗаданОтборСтатьяРасходов И НеЗаданОтборПодразделение И НеЗаданОтборПоОрганизации Тогда
    //КОНЕЦ Блинова М.А. 26.02.2024 Выполнение задач №000048144
		СтруктураПроверки.РезультатПроверки	= Ложь;  
		//НАЧАЛО Блинова М.А. 28.02.2024 Выполнение задач №000048144 
		//СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Должен быть заполнен хотя бы один отбор Статьям затрат/Подразделение" + Символы.ПС;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Должен быть заполнен хотя бы один отбор Статьям затрат/Подразделение/Организации" + Символы.ПС;
		//КОНЕЦ Блинова М.А. 26.02.2024 Выполнение задач №000048144
	КонецЕсли;

	// Проверка отборов по разделу Прочие доходы
	НеЗаданОтборСтатьяДоходов 	= ПроверитьЗаполненностьОтборовРаздела(Объект.Активно_ПД, "НастройкиКомпоновки_ПД", "НастройкиКомпоновки_ПД_СтатьяДоходов");
	НеЗаданОтборПодразделение 	= ПроверитьЗаполненностьОтборовРаздела(Объект.Активно_ПД, "НастройкиКомпоновки_ПД", "НастройкиКомпоновки_ПД_Подразделение");   
	//НАЧАЛО Блинова М.А. 08.04.2024 Выполнение задач №000048144
	//Если НеЗаданОтборБанк И НеЗаданОтборКасса Тогда
	Если НеЗаданОтборПодразделение И НеЗаданОтборСтатьяДоходов Тогда 
    //КОНЕЦ Блинова М.А. 08.04.2024 Выполнение задач №000048144		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Должен быть заполнен хотя бы один отбор Статья доходов/Подразделение" + Символы.ПС;
	КонецЕсли;
	// КОНЕЦ  Климов Антон 27.02.2024 Выполнение задач №000048621
	
	// НАЧАЛО Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	Если Не ЗначениеЗаполнено(Объект.КлючМаршрутизации) Тогда 		
		СтруктураПроверки.РезультатПроверки	= Ложь;
		СтруктураПроверки.СообщениеПользователю	= СтруктураПроверки.СообщениеПользователю + "Заполните ключ маршрутизации (ПП базы получателя)" + Символы.ПС;
	КонецЕсли;
	// КОНЕЦ Белоконенко Денис 15.07.2025 Выполнение задач №000053911
	
	Возврат СтруктураПроверки;
КонецФункции	

// Белоконенко Денис 11.07.2022 Выполнение задач №000041872
&НаКлиенте
Функция ПроверитьЗаполненностьОтборовРаздела(АктивностьРаздела, РеквизитНастроекКомпоновки, ИдентификаторКолонки)
	НеЗаданОтбор = Ложь;
	
	Если АктивностьРаздела И (Объект[РеквизитНастроекКомпоновки].Количество() = 0) Тогда
		НеЗаданОтбор = Истина;
	ИначеЕсли АктивностьРаздела Тогда
		ДанныеСтроки = Элементы[РеквизитНастроекКомпоновки].ТекущиеДанные;
		//ИдентификаторКолонка = "НастройкиКомпоновки_ОТН_Номенклатура";
		//НАЧАЛО Блинова М.А. 02.04.2024 Выполнение задач №000049080
		//надо проверить не по текущим данным, если вкладку не открывали то текущие данные активного раздела не установились
		Если ДанныеСтроки = Неопределено Тогда 
			ДанныеСтроки = Объект[РеквизитНастроекКомпоновки][0];
		КонецЕсли; 
		//КОНЕЦ Блинова М.А. 02.04.2024 Выполнение задач №000049080
		АдресСкд = ПолучитьURL_СКД_Колонки(ИдентификаторКолонки);  
		// НАЧАЛО Юдина Екатерина 25.04.2024 Выполнение задач №000049341 
		Если Не ЗначениеЗаполнено(ПолучитьАдресХранилищаНастроекПоКолонке(ДанныеСтроки, ИдентификаторКолонки)) Тогда
			ОбщегоНазначенияУХ.СообщитьОбОшибке("Проверьте заполнение строк отборов в верхней таблице!"); 
			Возврат Истина;
		КонецЕсли;
		// КОНЕЦ Юдина Екатерина 25.04.2024 Выполнение задач №000049341
		НастройкиКомпоновщика = ПолучитьИзВременногоХранилища(ПолучитьАдресХранилищаНастроекПоКолонке(ДанныеСтроки, ИдентификаторКолонки));
		Если НастройкиКомпоновщика = Неопределено Тогда 
			НеЗаданОтбор = Истина;
		Иначе 
			ЕстьЭлементыОтбора = Ложь;
			Для Каждого ЭлементОтбора Из НастройкиКомпоновщика.Отбор.Элементы Цикл
				ЕстьЭлементыОтбора = Макс(ЕстьЭлементыОтбора, ЭлементОтбора.Использование);			
			КонецЦикла;
			
			Если НЕ ЕстьЭлементыОтбора Тогда
				НеЗаданОтбор = Истина;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат НеЗаданОтбор;
КонецФункции	

