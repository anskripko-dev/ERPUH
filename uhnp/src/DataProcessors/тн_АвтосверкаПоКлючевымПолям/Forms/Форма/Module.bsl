// Климов Антон 17.05.2023 Выполнение задач №000045477
&НаКлиенте
Процедура НастройкиКомпоновки_РСК_ПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ДанныеСтроки = Элементы.НастройкиКомпоновки_РСК.ТекущиеДанные;
		ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		ТекущийИдентификаторСтрока = ДанныеСтроки.ИдентификаторСтроки;
		
		Если ЭтоКопированиеСтроки Тогда
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Сегмент = СкопироватьНастройкиКомпоновкиДанныхПоАдресу(ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Сегмент);
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Пользователь = СкопироватьНастройкиКомпоновкиДанныхПоАдресу(ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Пользователь);	
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидДоговора = СкопироватьНастройкиКомпоновкиДанныхПоАдресу(ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидДоговора);
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидВзаиморасчетов = СкопироватьНастройкиКомпоновкиДанныхПоАдресу(ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидВзаиморасчетов);	
			//НАЧАЛО Блинова М.А. 01.03.2024 Выполнение задач №000048144    
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Организация = СкопироватьНастройкиКомпоновкиДанныхПоАдресу(ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Организация);
			//КОНЕЦ Блинова М.А. 01.03.2024 Выполнение задач №000048144
		Иначе	
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Сегмент = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_РСК_Сегмент");
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Пользователь = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_РСК_Пользователь");
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидДоговора = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_РСК_ВидДоговора");
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_ВидВзаиморасчетов = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_РСК_ВидВзаиморасчетов");
			//НАЧАЛО Блинова М.А. 01.03.2024 Выполнение задач №000048144 
			ДанныеСтроки.АдресХранилищаНастроекКомпоновщика_Организация = ПолучитьАдресНастроекКомпоновкиКолонки("НастройкиКомпоновки_РСК_Организация"); 
			//КОНЕЦ Блинова М.А. 01.03.2024 Выполнение задач №000048144
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Сегмент) Тогда
			ДанныеСтроки.Сегмент = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_РСК_Сегмент");
		КонецЕсли;
					
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Пользователь) Тогда
			ДанныеСтроки.Пользователь = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_РСК_Пользователь");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.ВидДоговора) Тогда
			ДанныеСтроки.ВидДоговора = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_РСК_ВидДоговора");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.ВидВзаиморасчетов) Тогда
			ДанныеСтроки.ВидВзаиморасчетов = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_РСК_ВидВзаиморасчетов");
		КонецЕсли;
		
		//НАЧАЛО Блинова М.А. 01.03.2024 Выполнение задач №000048144
			Если Не ЗначениеЗаполнено(ДанныеСтроки.Организация) Тогда
			ДанныеСтроки.Организация = СформироватьНаименованиеКолонки(ДанныеСтроки, "НастройкиКомпоновки_РСК_Организация");
		КонецЕсли;
		//КОНЕЦ Блинова М.А. 01.03.2024 Выполнение задач №000048144

		РежимДобавленияСтроки = Истина;
		ЭтоКопированиеСтроки = Ложь;
		НастройкиКомпоновки_РСК_ПриАктивизацииЯчейки(Элемент);
	КонецЕсли;
	
КонецПроцедуры

