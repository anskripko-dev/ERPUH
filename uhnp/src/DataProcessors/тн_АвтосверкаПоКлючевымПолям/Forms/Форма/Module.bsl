&НаСервере
Процедура ОбработатьОтветОтОКС_НаСервере()
	
	ERP_ДатаНачалаОбработки = ТекущаяДатаСеанса();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	СообщениеОтветERP_От_ОКС = ОбработкаОбъект.СообщениеОтветERP_От_ОКС;
	ТекстСообщенияJSON = СтрЗаменить(СообщениеОтветERP_От_ОКС, "#", "");
		
	СтруктураОтветногоСообщения = ОбработкаОбъект.ПолучитьСтруктуруДанныхJSON(ТекстСообщенияJSON);
	СтруктураОтветногоСообщения.Вставить("ЭтоОтладка", Истина);
	
	СтруктураОбработка = ОбработкаОбъект.СформироватьСтруктуруОбработкаОтветаНаЗапрос();
	Если СтруктураОбработка.ТребуетсяДетализация = Истина Тогда
		ОбработкаОбъект.СтруктураСообщенияСверкаПоОстаткам = ЗначениеВСтрокуВнутр(СтруктураОбработка);
	КонецЕсли;
	
	// НАЧАЛО ГенатулинМА 25.02.22 Выполнение задачи №000040502
	//Если СтруктураОбработка.ТребуетсяДетализация = Неопределено Тогда
	//	ЭтотОбъект.ТекущийЭлемент = Элементы.ГруппаРезультатОтчетСтраница 
	//КонецЕсли;
	Если Не ЗначениеЗаполнено(СтруктураОбработка.ТребуетсяДетализация) Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.ГруппаРезультатОтчетСтраница;
	КонецЕсли;	
	// КОНЕЦ ГенатулинМА 25.02.22 Выполнение задачи №000040502
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	ERP_ДатаОкончанияОбработки = ТекущаяДатаСеанса();
	
КонецПроцедуры

