			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	// Нечисловые показатели
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&УникальныйИдентификаторСеанса КАК УникальныйИдентификаторСеанса,
