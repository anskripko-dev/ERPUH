	СтруктураРасчетаПоказателей.Вставить("тИспользуемыеАналитики", тИспользуемыеАналитики);
	
	тИспользуемыеРесурсы = Новый ТаблицаЗначений;
	тИспользуемыеРесурсы.Колонки.Добавить("УровеньРасчета", ОписаниеТиповЧисло5Н);
	тИспользуемыеРесурсы.Колонки.Добавить("Поле", ОписаниеТиповСтрока100);
	тИспользуемыеРесурсы.Колонки.Добавить("Суммируется", ОписаниеТиповБулево); 
	тИспользуемыеРесурсы.Колонки.Добавить("ВыводитсяВОтчет", ОписаниеТиповБулево); 
	СтруктураРасчетаПоказателей.Вставить("тИспользуемыеРесурсы", тИспользуемыеРесурсы);
	
	тСчетаСИерархией = Новый ТаблицаЗначений;
	СтруктураРасчетаПоказателей.Вставить("тСчетаСИерархией", тСчетаСИерархией);

	Возврат СтруктураРасчетаПоказателей;
	
КонецФункции

Функция ЭтоВнешнийИсточник(СпособПолучения)
	
	Возврат 
		СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеADO
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеДокументы
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеОстаткиИОборотыИзПланаСчетов
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПараметрическаяНастройка
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистр
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрБухгалтерии
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрНакопления
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеРегистрСведений
		ИЛИ СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеСправочники;	
	
КонецФункции

Функция ЭтоЦикличныйОперанд(СтрОперанд, СтрОперандИсходная, тДанныеДляРасчетов, МассивОперандов)
		
	Если МассивОперандов.Найти(СтрОперанд.Ссылка) = Неопределено Тогда
		МассивОперандов.Добавить(СтрОперанд.Ссылка); 
	Иначе
		Возврат СтрОперанд.Ссылка = СтрОперандИсходная.Ссылка;
	КонецЕсли;
	
	Результат = Ложь;
	
	тРекурсивныеОперанды = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("Потребитель",СтрОперанд.ПоказательОтбор,Истина));
	Для Каждого Стр Из тРекурсивныеОперанды Цикл
		Результат = Результат ИЛИ ЭтоЦикличныйОперанд(Стр, СтрОперандИсходная, тДанныеДляРасчетов, МассивОперандов);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПоказательТекущегоОтчетаБезУчетаПериода(СтрОперанд, ДанныеДляРасчета)
	
	Если СтрОперанд.ВидОтчетаПоказателя <> СтрОперанд.ВидОтчетаПотребителя Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеВидаОтчета = ДанныеДляРасчета.ДанныеВидаОтчета[0];

	тТекущихПараметровОтбораБД = ДанныеДляРасчета.тПараметрыОтбораБД.Скопировать(Новый Структура("Ссылка",СтрОперанд.Ссылка));
	
	СтруктураОтборовПоиска = Новый Структура;
	СтруктураОтборовПоиска.Вставить("Организация", Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета);
	СтруктураОтборовПоиска.Вставить("Сценарий", Перечисления.СпособыВычисленияПараметровОперандов.СценарийОтчета);
	СтруктураОтборовПоиска.Вставить("Валюта", Перечисления.СпособыВычисленияПараметровОперандов.ВалютаОтчета);
	Если ДанныеВидаОтчета.РазделениеПоПроектам Тогда
		СтруктураОтборовПоиска.Вставить("Проект", Перечисления.СпособыВычисленияПараметровОперандов.ПроектОтчета);
	КонецЕсли;
	Для Сч = 1 По ДанныеВидаОтчета.МаксКлючевыхАналитик Цикл
		СтруктураОтборовПоиска.Вставить("Аналитика" + Сч, Перечисления.СпособыВычисленияПараметровОперандов["Аналитика" + Сч]);
	КонецЦикла;
	
	Для Каждого ОтборПоиска Из СтруктураОтборовПоиска Цикл
		НайденныеСтрокиОтбора = тТекущихПараметровОтбораБД.НайтиСтроки(Новый Структура("ПолеБД", "Версия." + ОтборПоиска.Ключ));
		Если НайденныеСтрокиОтбора.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого НайденнаяСтрокаОтбора Из НайденныеСтрокиОтбора Цикл
			Если НайденнаяСтрокаОтбора.СпособВычисленияПараметра <> ОтборПоиска.Значение Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьУровеньРасчетаОперандаРекурсивно(
	дУровни,
	СтрОперанд,
	тДанныеДляРасчетов,
	мПоказателиСРекурсивнымРасчетомПериода,
	СтрОперандИсходная,
	тМаксимальныйУровень,
	ДанныеДляРасчета,
	Отказ)
	
	ПоказательСРекурсивнымРасчетомПериода = Ложь;
	
	Если тМаксимальныйУровень.Количество() > 0 
		И СтрОперанд.Ссылка = СтрОперандИсходная.Ссылка Тогда
		// Рекурсия в связях показателей
		ТекстОшибки = НСтр("ru = 'Дерево расчета:'");
		тСтрокаДерева = дУровни.Строки.Добавить();
		нУровень = тМаксимальныйУровень.Добавить();
		нУровень.Уровень = тСтрокаДерева.Уровень() + 1;
		нУровень.Показатель = СтрОперанд.ПоказательОтбор;
		Для Каждого СтрТаблицы Из тМаксимальныйУровень Цикл
			Отступ = "";
			Для Сч = 0 По СтрТаблицы.Уровень-1 Цикл
				Отступ = Отступ + Символы.Таб;
			КонецЦикла;
			ТекстОшибки = ТекстОшибки + Символы.ПС + Отступ + СтрТаблицы.Показатель;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Обнаружена рекурсия в связях при расчете показателя: ""%1"".
			|Проверьте формулы расчета и перезапишите правило расчета.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СтрОперанд.Потребитель);
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("УправлениеРасчетомПоказателей.ПолучитьУровеньРасчетаОперандаРекурсивно", , , ТекстСообщения, ТекстОшибки);
		Отказ = Истина;
		Возврат ПоказательСРекурсивнымРасчетомПериода;
	КонецЕсли;
	
	тСтрокаДерева = дУровни.Строки.Добавить();
	нУровень = тМаксимальныйУровень.Добавить();
	нУровень.Уровень = тСтрокаДерева.Уровень() + 1;
	нУровень.Потребитель = СтрОперанд.Потребитель;
	нУровень.Показатель = СтрОперанд.ПоказательОтбор;
	нУровень.ИсточникДанных = СтрОперанд.Ссылка;
	
	Если НЕ СтрОперанд.ПоказательТекущегоОтчета Тогда
		
		Если тДанныеДляРасчетов.Индексы.Количество() = 0 Тогда
			тДанныеДляРасчетов.Индексы.Добавить("Потребитель");
		КонецЕсли;
		
		// Операнд рассчитывается в том числе и из данных другого отчета
		Если НЕ СтрОперанд.ТекущийПериод
			И тДанныеДляРасчетов.Найти(СтрОперанд.ПоказательОтбор, "Потребитель") <> Неопределено
			И ЭтоПоказательТекущегоОтчетаБезУчетаПериода(СтрОперанд, ДанныеДляРасчета)
			Тогда
			
			ПоказательСРекурсивнымРасчетомПериода = Истина;
			
			// Это операнд с рекурсивным сдвигом периода, уровень расчета будет установлен позже
			Если мПоказателиСРекурсивнымРасчетомПериода.Найти(СтрОперанд.Потребитель) = Неопределено Тогда
				мПоказателиСРекурсивнымРасчетомПериода.Добавить(СтрОперанд.Потребитель);
			КонецЕсли;
		
			// А может быть это еще и цикличный операнд
			МассивОперандов = Новый Массив;
			Если ЭтоЦикличныйОперанд(СтрОперанд, СтрОперанд, тДанныеДляРасчетов, МассивОперандов) Тогда
				Возврат ПоказательСРекурсивнымРасчетомПериода;
			КонецЕсли;
			
		Иначе
			// Операнд рассчитывается из данных другого отчета
			Если СтрОперандИсходная.УровеньОперанда < нУровень.Уровень Тогда
				СтрОперандИсходная.УровеньОперанда = нУровень.Уровень;
			КонецЕсли;
			Возврат ПоказательСРекурсивнымРасчетомПериода;
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьПоказательТекущегоОтчета = Ложь;
	тРекурсивныеОперанды = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("Потребитель",СтрОперанд.ПоказательОтбор,Истина));
	Для Каждого Стр Из тРекурсивныеОперанды Цикл
		Если Стр.ПоказательТекущегоОтчета Тогда
			ЕстьПоказательТекущегоОтчета = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьПоказательТекущегоОтчета И тРекурсивныеОперанды.Количество() > 0 Тогда
		нУровень.Уровень = нУровень.Уровень + 1;
	КонецЕсли;
	
	Если СтрОперандИсходная.УровеньОперанда < нУровень.Уровень Тогда
		СтрОперандИсходная.УровеньОперанда = нУровень.Уровень;
	КонецЕсли;
	
	Для Каждого Стр Из тРекурсивныеОперанды Цикл
		
		ПоказательСРекурсивнымРасчетомПериода = Макс(
		ПолучитьУровеньРасчетаОперандаРекурсивно(
			тСтрокаДерева,
			Стр,
			тДанныеДляРасчетов,
			мПоказателиСРекурсивнымРасчетомПериода,
			СтрОперандИсходная,
			тМаксимальныйУровень,
			ДанныеДляРасчета,
			Отказ), ПоказательСРекурсивнымРасчетомПериода);
			
		Если ПоказательСРекурсивнымРасчетомПериода
			И мПоказателиСРекурсивнымРасчетомПериода.Найти(СтрОперанд.Потребитель) = Неопределено Тогда
			мПоказателиСРекурсивнымРасчетомПериода.Добавить(СтрОперанд.Потребитель);	
		КонецЕсли;
			
	КонецЦикла;
		
	Возврат ПоказательСРекурсивнымРасчетомПериода;
		
КонецФункции

Функция УИДГруппыОтборовПериодов(тКэшГруппОтборовПериодов, тТекущихПараметровОтбораБД, УИДГруппыОтборовВерсии)
	
	НайденнаяСтрокаКэша = тКэшГруппОтборовПериодов.Найти(УИДГруппыОтборовВерсии, "УИДГруппыОтборов");
	
	Если НайденнаяСтрокаКэша = Неопределено Тогда

		тРасшифровкаГруппОтборовПоПериоду = тТекущихПараметровОтбораБД.Скопировать(Новый Структура("ПолеБД","Версия.ПериодОтчета"));	
		
		ХешГруппыОтборовВерсии = РассчитатьХешПоОтборам(тРасшифровкаГруппОтборовПоПериоду);
		НайденнаяСтрокаКэша = тКэшГруппОтборовПериодов.Найти(ХешГруппыОтборовВерсии, "ХешГруппыОтборов");
		
		Если НайденнаяСтрокаКэша = Неопределено Тогда
			
			НайденнаяСтрокаКэша = тКэшГруппОтборовПериодов.Добавить(); 
			НайденнаяСтрокаКэша.УИДГруппыОтборов = УИДГруппыОтборовВерсии;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НайденнаяСтрокаКэша.УИДГруппыОтборов;
	
КонецФункции	

Процедура УстановитьУИДДляПоказателя(СтруктураРасчетаПоказателей, СтрОперанд, тТекущихПараметровОтбораБД, МаксУИД, ТекущийПериод)
	
	тКэшГруппОтборовВерсии			= СтруктураРасчетаПоказателей.тКэшГруппОтборовВерсии;
	тКэшГруппОтборовПоказателей		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПоказателей;
	тКэшГруппОтборовПериодов		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПериодов;

	тРасшифровкаГруппОтборовВерсии	= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии;
	тРасшифровкаГруппОтборов		= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов;
	
	/////////////////////////////////
	// Рассчитаем УИД группы отбора версий
	тТекущихПараметровОтбораБДВерсии = тТекущихПараметровОтбораБД.Скопировать(Новый Структура("ПолеВерсии",Истина));
	ХешГруппыОтборовВерсии = РассчитатьХешПоОтборам(тТекущихПараметровОтбораБДВерсии);
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ХешГруппыОтборов",	ХешГруппыОтборовВерсии);
	Если СтрОперанд.ИндексРегистраОперанда = -1 ИЛИ СтрОперанд.ИндексРегистраОперанда = -11 Тогда
		СтруктураПоиска.Вставить("ИндексРегистра", СтрОперанд.ИндексРегистраОперанда);
	Иначе
		СтруктураПоиска.Вставить("ИндексРегистра", 0);
	КонецЕсли;
	
	НайденнаяСтрокаКэша = тКэшГруппОтборовВерсии.НайтиСтроки(СтруктураПоиска); 
	
	Если НайденнаяСтрокаКэша.Количество() = 0 Тогда
		
		НСтрокаКэшВерсии = тКэшГруппОтборовВерсии.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрокаКэшВерсии,СтруктураПоиска);

		НСтрокаКэшВерсии.УИДГруппыОтборов = тКэшГруппОтборовВерсии.Количество();
		НСтрокаКэшВерсии.ВидыОтчетов = Новый Массив;
		
		Для Каждого СтрРасшифровка Из тТекущихПараметровОтбораБДВерсии Цикл
			НСтрРасшифровка = тРасшифровкаГруппОтборовВерсии.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрРасшифровка,СтрРасшифровка);
			Если СтрРасшифровка.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
				Или СтрРасшифровка.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
				НСтрРасшифровка.УточнениеСпособаОпределения = СтрРасшифровка.ТекстМодуля;
			КонецЕсли;
			НСтрРасшифровка.УИДГруппыОтборов = НСтрокаКэшВерсии.УИДГруппыОтборов;
			НСтрРасшифровка.ПолеБД = СтрЗаменить(СтрРасшифровка.ПолеБД, "Версия.", "");
		КонецЦикла;
			
	Иначе
		НСтрокаКэшВерсии = НайденнаяСтрокаКэша[0];
	КонецЕсли;
	Если СтрОперанд.УровеньРасчетаОперанда = 1 Тогда
		Если НСтрокаКэшВерсии.ВидыОтчетов.Найти(СтрОперанд.ВидОтчетаПоказателя) = Неопределено Тогда
			НСтрокаКэшВерсии.ВидыОтчетов.Добавить(СтрОперанд.ВидОтчетаПоказателя);
		КонецЕсли;
	КонецЕсли;	
	
	/////////////////////////////////
	// Рассчитаем УИД группы отбора периодов
	Если НЕ ТекущийПериод Тогда
		СтрОперанд.УИДГруппыОтборовПериодов = УИДГруппыОтборовПериодов(тКэшГруппОтборовПериодов, тТекущихПараметровОтбораБДВерсии, НСтрокаКэшВерсии.УИДГруппыОтборов);	
	КонецЕсли;
	
	/////////////////////////////////
	// Рассчитаем УИД группы отбора регистра
	тТекущихПараметровОтбораБДРегистр = тТекущихПараметровОтбораБД.НайтиСтроки(Новый Структура("ПолеВерсии",Ложь));
	ХешГруппыОтборовРегистры = РассчитатьХешПоОтборам(тТекущихПараметровОтбораБДРегистр);
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ХешГруппыОтборов",		ХешГруппыОтборовРегистры);
	СтруктураПоиска.Вставить("УИДГруппыОтборовВерсии",	НСтрокаКэшВерсии.УИДГруппыОтборов);
	СтруктураПоиска.Вставить("ИндексРегистра",			СтрОперанд.ИндексРегистраОперанда);
	
	НайденнаяСтрокаКэша = тКэшГруппОтборовПоказателей.НайтиСтроки(СтруктураПоиска);
	
	Если НайденнаяСтрокаКэша.Количество() = 0 Тогда
		
		НСтрокаКэш = тКэшГруппОтборовПоказателей.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрокаКэш, СтруктураПоиска);
		
		МаксУИД = МаксУИД + 1;
		НСтрокаКэш.УИДГруппыОтборов = МаксУИД;
		НСтрокаКэш.Показатели = Новый Массив;
		
		Для Каждого СтрРасшифровка Из тТекущихПараметровОтбораБДРегистр Цикл
			НСтрРасшифровка = тРасшифровкаГруппОтборов.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрРасшифровка,СтрРасшифровка);
			Если СтрРасшифровка.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
				Или СтрРасшифровка.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
				НСтрРасшифровка.УточнениеСпособаОпределения = СтрРасшифровка.ТекстМодуля;
			КонецЕсли;
			НСтрРасшифровка.УИДГруппыОтборов = МаксУИД;
		КонецЦикла;
		
	Иначе
		НСтрокаКэш = НайденнаяСтрокаКэша[0];
	КонецЕсли;
	Если СтрОперанд.УровеньРасчетаОперанда = 1 Тогда
		Если НСтрокаКэш.Показатели.Найти(СтрОперанд.ПоказательОперанд) = Неопределено Тогда
			НСтрокаКэш.Показатели.Добавить(СтрОперанд.ПоказательОперанд);
		КонецЕсли;
	КонецЕсли;
	
	СтрОперанд.УИДГруппыОтборов = НСтрокаКэш.УИДГруппыОтборов;

КонецПроцедуры

Функция РассчитатьХешПоОтборам(Знач ПараметрыОтбора)
	
	СтрокаХешаОтборов = "";
	
	Для Каждого Стр Из ПараметрыОтбора Цикл
		
		ЗначениеОтбора = Стр.УточнениеСпособаОпределения;
		Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
			СтрЗначениеОтбора = ЗначениеВСтрокуВнутр(ЗначениеОтбора.ВыгрузитьЗначения());
		ИначеЕсли ЗначениеОтбора = "" Тогда
			СтрЗначениеОтбора = "";
		ИначеЕсли ЗначениеОтбора = Неопределено 
			И (Стр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение 
			Или Стр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений) Тогда
			СтрЗначениеОтбора = Стр.ТекстМодуля;
		Иначе	
			СтрЗначениеОтбора = ЗначениеВСтрокуВнутр(ЗначениеОтбора);
		КонецЕсли;
		
		СтрокаХешаОтборов = СтрокаХешаОтборов + "#"
			+ Стр.ПолеБД + "@" 
			+ Стр.СпособВычисленияПараметра + "@" 
			+ СтрЗначениеОтбора +"@" 
			+ Строка(Стр.ПолеВерсии);
				
	КонецЦикла;
	
	Возврат СтрокаХешаОтборов;
	
КонецФункции

Процедура ОбработатьПоказателиСРекурсивнымРасчетомПериода(СтруктураРасчетаПоказателей, мПоказателиСРекурсивнымРасчетомПериода)

	тПоказателиОперанды = СтруктураРасчетаПоказателей.тПоказателиОперанды;
	МаксУровеньСовместныхРасчетов = 0;
	МинУровеньСовместныхРасчетов = 999999;
	
	Для Каждого Показатель Из мПоказателиСРекурсивнымРасчетомПериода Цикл
		
		СтрокиРасчета = тПоказателиОперанды.НайтиСтроки(Новый Структура("Потребитель", Показатель));
		РекурсивныйРасчетПериодов = Ложь;
		
		Для Каждого СтрокаРасчета Из СтрокиРасчета Цикл
			
			Если НЕ СтрокаРасчета.ТекущийПериод Тогда
				// Есть операнды со смещениями периодов
				РекурсивныйРасчетПериодов = Истина;
			КонецЕсли;
			
			Если СтрокаРасчета.УровеньРасчетаОперанда <> 1 Тогда
				СтрокиОперанды = тПоказателиОперанды.НайтиСтроки(Новый Структура("Потребитель", СтрокаРасчета.ПоказательОперанд));
				СтрокаРасчета.УровеньРасчетаОперанда = СтрокиОперанды.Получить(0).УровеньРасчетаПотребителя + 1;
				Если СтрокаРасчета.УровеньРасчетаОперанда > СтрокаРасчета.УровеньРасчетаПотребителя Тогда
					МаксУровеньСовместныхРасчетов = Макс(МаксУровеньСовместныхРасчетов, СтрокаРасчета.УровеньРасчетаОперанда-1, СтрокаРасчета.УровеньРасчетаПотребителя);
					МинУровеньСовместныхРасчетов = Мин(МинУровеньСовместныхРасчетов, СтрокаРасчета.УровеньРасчетаОперанда-1, СтрокаРасчета.УровеньРасчетаПотребителя);
				КонецЕсли;
				Если СтрокаРасчета.УровеньРасчетаПотребителя <= МаксУровеньСовместныхРасчетов
					И СтрокаРасчета.УровеньРасчетаПотребителя >= МинУровеньСовместныхРасчетов Тогда
					// Уровень расчета среди совместных уровней расчета
					РекурсивныйРасчетПериодов = Истина;					
				КонецЕсли;
			КонецЕсли;		
		КонецЦикла;
		
		Если РекурсивныйРасчетПериодов Тогда
			// Это рекурсивный расчет, установим для всех операндов расчета
			Для Каждого СтрокаРасчета Из СтрокиРасчета Цикл
				СтрокаРасчета.РекурсивныйРасчетПериодов = Истина;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если МаксУровеньСовместныхРасчетов > 0 И МаксУровеньСовместныхРасчетов <> МинУровеньСовместныхРасчетов Тогда
		// Есть несколько уровней для совместного расчета
		СтруктураРасчетаПоказателей.МаксУровеньСовместныхРасчетов = МаксУровеньСовместныхРасчетов;
		СтруктураРасчетаПоказателей.МинУровеньСовместныхРасчетов = МинУровеньСовместныхРасчетов;		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьТаблицуВнешнихДанных(тВнешниеДанные, ПравилоОбработки,тОперандыТекущегоПоказателя = Неопределено)
	
	ДанныеПараметрическойНастройки = ПолучитьДанныеПараметрическойНастройкиБезКэша(ПравилоОбработки);
	//УправлениеОтчетамиУХ.ПолучитьДанныеОперандовДляРасчета(,
	
	Если ДанныеПараметрическойНастройки = Неопределено Тогда
		ТекОбъектРасчета = Документы.НастраиваемыйОтчет.СоздатьДокумент();
		ТекОбъектРасчета.ПравилоОбработки = ПравилоОбработки;
		ТекОбъектРасчета.СформироватьСтруктуруПараметров();
		ТекОбъектРасчета.ИнициализироватьКонтекст();
		УправлениеОтчетамиУХ.ПодготовитьДанныеПараметрическойНастройки(ТекОбъектРасчета);
		ДанныеПараметрическойНастройки = УправлениеОтчетамиУХ.ПолучитьДанныеПараметрическойНастройки(ПравилоОбработки);
	КонецЕсли;
	мТабПоказателиЗапросы = ДанныеПараметрическойНастройки.мТабПоказателиЗапросы;
	
	Для Каждого ПоказательЗапрос Из мТабПоказателиЗапросы Цикл
		
		Если ЭтоВнешнийИсточник(ПоказательЗапрос.СпособПолучения) Тогда
			
			Если Не тОперандыТекущегоПоказателя = Неопределено И
				 НЕ ОтобратьЗапросПоОперандам(ПоказательЗапрос,тОперандыТекущегоПоказателя) Тогда
				 Продолжить;
			КонецЕсли;
			
			нСтрокаТаблицы = тВнешниеДанные.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрокаТаблицы, ПоказательЗапрос);
			Если ПоказательЗапрос.СтруктураЗапроса.Свойство("ОбъектЗапрос") Тогда
				ПоказательЗапрос.СтруктураЗапроса.ОбъектЗапрос = Неопределено;
			КонецЕсли;
			Если ПоказательЗапрос.СтруктураЗапроса.Свойство("База") Тогда
				ПоказательЗапрос.СтруктураЗапроса.База = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ОтобратьЗапросПоОперандам(ПоказательЗапрос,тОперандыТекущегоПоказателя)
	
	Для Каждого Стр Из  ПоказательЗапрос.ТаблицаОперандов Цикл
		
		Для Каждого СтрОтбор Из тОперандыТекущегоПоказателя Цикл 
			Если  СтрОтбор.Ссылка = Стр.Ссылка Тогда
				 Возврат Истина;
			КонецЕсли;		
		КонецЦикла;	
			
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции	


Процедура СформироватьДанныеДляРасчетаКлассическимДвижкомРасчета(
	тТаблицаДанных,
	СтрокаОперанд,
	тТекущихПравилИспользованияПолейЗапроса,
	тТекущихПараметровОтбораБД,
	МаксКлючевыхАналитик)
	
	// Заполним таблицу операндов
	ТаблицаОперандов = Новый ТаблицаЗначений;
	ТаблицаОперандов.Колонки.Добавить("АналитикВидаОтчета");
	ТаблицаОперандов.Колонки.Добавить("ВидИтогаПоказателя");
	ТаблицаОперандов.Колонки.Добавить("Код");
	ТаблицаОперандов.Колонки.Добавить("КоррСчет");
	ТаблицаОперандов.Колонки.Добавить("Наименование");
	ТаблицаОперандов.Колонки.Добавить("Показатель");
	ТаблицаОперандов.Колонки.Добавить("ПоказательОтбор");
	ТаблицаОперандов.Колонки.Добавить("ПравилаИспользованияПолейЗапроса");
	ТаблицаОперандов.Колонки.Добавить("Ресурс");
	ТаблицаОперандов.Колонки.Добавить("Ссылка");
	ТаблицаОперандов.Колонки.Добавить("Счет");
	ТаблицаОперандов.Колонки.Добавить("ТипЗначения");
	ТаблицаОперандов.Колонки.Добавить("ТипЗначенияПоказателя");
	ТаблицаОперандов.Колонки.Добавить("ТолькоАналитическиеЗначения");
	ТаблицаОперандов.Колонки.Добавить("ЧислоАналитикГруппыРаскрытия");
	
	нСтрокаТаблицыОперандов = ТаблицаОперандов.Добавить();
	ЗаполнитьЗначенияСвойств(нСтрокаТаблицыОперандов, СтрокаОперанд);
	нСтрокаТаблицыОперандов.АналитикВидаОтчета = МаксКлючевыхАналитик;
	нСтрокаТаблицыОперандов.Показатель = СтрокаОперанд.Потребитель;
	нСтрокаТаблицыОперандов.ПравилаИспользованияПолейЗапроса = тТекущихПравилИспользованияПолейЗапроса;
	нСтрокаТаблицыОперандов.Ресурс = СтрокаОперанд.РесурсРегистра;
	нСтрокаТаблицыОперандов.ЧислоАналитикГруппыРаскрытия = СтрокаОперанд.ЧислоАналитик;
	
	// Добавим строку в таблицу данных
	нСтрокаТаблицы = тТаблицаДанных.Добавить();
	нСтрокаТаблицы.ТаблицаОперандов = ТаблицаОперандов;
	нСтрокаТаблицы.СпособПолучения = СтрокаОперанд.СпособПолучения;
	нСтрокаТаблицы.ТекстЗапроса = СтрокаОперанд.ТекстЗапросаМодуля;
	
	нСтрокаТаблицы.СтруктураЗапроса = Новый Структура;
	
	тТекущихПараметровОтбораБД.Колонки.Добавить("ЗначениеДляПроверки");
	нСтрокаТаблицы.ПравилаВычисленияПараметров = тТекущихПараметровОтбораБД;	
	
КонецПроцедуры	

Процедура ОпределитьПравилаТрансформацииПолей(СтруктураРасчетаПоказателей, тПравилаИспользованияПолейЗапроса)
	
	тПоказателиОперанды			= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	УровниСВременнымРасчетом	= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	МаксКлючевыхАналитик		= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	
	тИспользуемыеКлючевыеАналитики = Новый Структура;
	Для Сч = 1 По МаксКлючевыхАналитик Цикл
		тИспользуемыеКлючевыеАналитики.Вставить("Аналитика" + Сч);
	КонецЦикла;	
	ИндексГруппыТрансформации = 1;
	РазличныеГруппыТрансформации = Новый Соответствие;
	
	Для Каждого СтрОперанд Из тПоказателиОперанды Цикл
		
		ПравилаИспользованияПолейЗапроса = тПравилаИспользованияПолейЗапроса.НайтиСтроки(
			Новый Структура("Ссылка",стрОперанд.ИсточникДанныхДляРасчетов));
		
		МаксимальныйУровеньДополненияАналитик = 0;
		ТекстТрансформацииДополненияАналитик = "";
		ТекстТрансформации = "";
		
		Для Каждого Поле Из ПравилаИспользованияПолейЗапроса Цикл
			
			Если Поле.КодАналитики = "Значение"
				И (ЭтоВнешнийИсточник(стрОперанд.СпособПолучения)
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрСведений
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеДокументы
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРеквизитОбъектаБД
				ИЛИ СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеСправочники) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнешниеДанныеADO
				И (Поле.КодАналитики <> "Значение") Тогда
				
				ТекстТрансформации = ТекстТрансформации+XMLСтрока(Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы)+"@"+Поле.КодАналитики+"@"+Поле.КодАналитики+";";
				Если стрОперанд.УровеньРасчетаОперанда = 1 Тогда
					Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",0,Поле.КодАналитики)).Количество() = 0 Тогда						
						нСтр					= тИспользуемыеАналитики.Добавить();
						нСтр.УровеньРасчета		= 0;
						нСтр.Поле				= Поле.КодАналитики;
						нСтр.ПолеВерсии			= Ложь;
						нСтр.ПолеТрансформации	= Поле.КодАналитики;
					КонецЕсли;
				КонецЕсли;
				Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,Поле.КодАналитики)).Количество() = 0 Тогда					
					нСтр				= тИспользуемыеАналитики.Добавить();
					нСтр.УровеньРасчета	= стрОперанд.УровеньРасчетаОперанда;
					нСтр.Поле			= Поле.КодАналитики;
					нСтр.ПолеВерсии		= Ложь;
				КонецЕсли;
			
			ИначеЕсли Поле.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПустаяСсылка() Тогда
				Продолжить;
				
			ИначеЕсли (Поле.КодАналитики = "Период" ИЛИ Поле.КодАналитики = "Значение")
				И СтрОперанд.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос Тогда
				Продолжить;
				
			ИначеЕсли Поле.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы И ЗначениеЗаполнено(Поле.Поле) Тогда
				
				Если ЗначениеЗаполнено(СтрОперанд.ПоказательОперанд) Тогда
					
					// Поле из другого отчета
					ПолеИмя = Поле.Поле;
					
					// Проверим на ошибки реструктуризации
					Если СтрНачинаетсяС(ПолеИмя, "Аналитика") И НЕ ПолеИмя = "АналитикаВалюта"
						И СтрОперанд.МаксКлючевыхАналитикПоказателя + СтрОперанд.ЧислоАналитикПоказателя < Число(Сред(ПолеИмя, СтрДлина("Аналитика")+1, 1)) Тогда
						// Трансформация аналитик, оставшаяся от ошибок реструктуризации
						Продолжить;
					ИначеЕсли СтрНачинаетсяС(Поле.КодАналитики, "Аналитика") И НЕ Поле.КодАналитики = "АналитикаВалюта"
						И МаксКлючевыхАналитик >= Число(Сред(Поле.КодАналитики, СтрДлина("Аналитика")+1, 1)) Тогда
						// Трансформация аналитик, оставшаяся от ошибок реструктуризации
						Продолжить;
					КонецЕсли;
				
				Иначе
					// Поле из внешних источников
					ПолеИмя = Поле.КодАналитики;
					Если ПолеИмя = "Значение" Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				ПолеВерсии = тИспользуемыеКлючевыеАналитики.Свойство(Поле.КодАналитики) ИЛИ СтрНайти(ПолеИмя,"Версия.");
				ПолеИмя = СтрЗаменить(ПолеИмя,"Версия.","");
				
				Если ПолеИмя <> Поле.КодАналитики Тогда
					// Это трансформация полей
					Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,Поле.КодАналитики)).Количество() = 0 Тогда
						нСтр				= тИспользуемыеАналитики.Добавить();
						нСтр.УровеньРасчета	= стрОперанд.УровеньРасчетаОперанда;
						нСтр.Поле			= Поле.КодАналитики;
						нСтр.ПолеВерсии		= Ложь;
					КонецЕсли;
				Иначе
					Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,ПолеИмя)).Количество() = 0 Тогда
						нСтр					= тИспользуемыеАналитики.Добавить();
						нСтр.УровеньРасчета		= стрОперанд.УровеньРасчетаОперанда;
						нСтр.Поле				= ПолеИмя;
						нСтр.ПолеВерсии			= ПолеВерсии;
						нСтр.ПолеТрансформации	= Поле.КодАналитики;
					КонецЕсли;
				КонецЕсли;
				
				Если стрОперанд.УровеньРасчетаОперанда = 1 Тогда
					Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",0,ПолеИмя)).Количество() = 0 Тогда
						нСтр					= тИспользуемыеАналитики.Добавить();
						нСтр.УровеньРасчета		= 0;
						нСтр.Поле				= ПолеИмя;
						нСтр.ПолеВерсии			= ПолеВерсии;
						нСтр.ПолеТрансформации	= Поле.КодАналитики;
					КонецЕсли;
				КонецЕсли;
				
				ТекстТрансформации = ТекстТрансформации+XMLСтрока(Поле.СпособЗаполнения)+"@"+ПолеИмя+"@"+Поле.КодАналитики+";"
				
			ИначеЕсли Поле.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				
				ТекстТрансформации = ТекстТрансформации+XMLСтрока(Поле.СпособЗаполнения)+"@"+ЗначениеВСтрокуВнутр(Поле.ФиксированноеЗначение)+"@"+Поле.КодАналитики+";";
				
				Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,Поле.КодАналитики)).Количество() = 0 Тогда
					нСтр				= тИспользуемыеАналитики.Добавить();
					нСтр.УровеньРасчета	= стрОперанд.УровеньРасчетаОперанда;
					нСтр.Поле			= Поле.КодАналитики;
					нСтр.ПолеВерсии		= Ложь;
				КонецЕсли;
				
			ИначеЕсли Поле.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки Тогда
				
				ТекстТрансформации = ТекстТрансформации+XMLСтрока(Поле.СпособЗаполнения)+"@"+Строка(Поле.Поле)+"@"+Поле.КодАналитики+";";
				
				Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,Поле.КодАналитики)).Количество() = 0 Тогда
					нСтр				= тИспользуемыеАналитики.Добавить();
					нСтр.УровеньРасчета	= стрОперанд.УровеньРасчетаОперанда;
					нСтр.Поле			= Поле.КодАналитики;
					нСтр.ПолеВерсии		= Ложь;
				КонецЕсли;
				
			ИначеЕсли Поле.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеДругогоИсточникаДанных Тогда
				
				ДанныеПоказателя = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(Поле.ФиксированноеЗначение,"ПоказательОтбор,Код");
				СтрокаПоказателя = тПоказателиОперанды.НайтиСтроки(
					Новый Структура("ПоказательОперанд,КодВФормуле",ДанныеПоказателя.ПоказательОтбор,СокрЛП(ДанныеПоказателя.Код))).Получить(0);
				
				ТекстТрансформацииДополненияАналитик = ТекстТрансформацииДополненияАналитик+XMLСтрока(Поле.СпособЗаполнения)
					+"@"+ЗначениеВСтрокуВнутр(СтрокаПоказателя.ПоказательОперанд)
					+"@"+Поле.КодАналитики
					+"@"+Формат(СтрокаПоказателя.УровеньРасчетаОперанда, "ЧН=0; ЧГ=0")
					+"@"+СтрокаПоказателя.КодВФормуле
					+"@"+Формат(СтрокаПоказателя.УИДГруппыОтборов, "ЧН=0; ЧГ=0")
					+"@"+Формат(СтрокаПоказателя.УИДГруппыТрансформации, "ЧН=0; ЧГ=0")
					+"@"+Формат(СтрокаПоказателя.УИДГруппыОтборовПериодов, "ЧН=0; ЧГ=0")
					+";";

				МаксимальныйУровеньДополненияАналитик = Макс(МаксимальныйУровеньДополненияАналитик,СтрокаПоказателя.УровеньРасчетаОперанда);	
				
				Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",стрОперанд.УровеньРасчетаОперанда,Поле.КодАналитики)).Количество() = 0 Тогда
					нСтр				= тИспользуемыеАналитики.Добавить();
					нСтр.УровеньРасчета	= стрОперанд.УровеньРасчетаОперанда;
					нСтр.Поле			= Поле.КодАналитики;
					нСтр.ПолеВерсии		= Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если МаксимальныйУровеньДополненияАналитик > стрОперанд.УровеньРасчетаОперанда
			И НЕ стрОперанд.ВременныйРасчет Тогда
			
			// Есть дополнения аналитик вышестоящего уровня. Добавим еще один операнд в таблицу.
			НСтрока = тПоказателиОперанды.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, стрОперанд); 
			
			Если стрОперанд.ВариантРасчета = 3 Тогда
				
				НСтрока.УровеньРасчетаОперанда    = МаксимальныйУровеньДополненияАналитик;
				НСтрока.УровеньРасчетаПотребителя = МаксимальныйУровеньДополненияАналитик;
				НСтрока.ВариантРасчета = 3;
				
			ИначеЕсли стрОперанд.ВариантРасчета = 4 Тогда
				
				НСтрока.УровеньРасчетаОперанда    = МаксимальныйУровеньДополненияАналитик;
				НСтрока.УровеньРасчетаПотребителя = МаксимальныйУровеньДополненияАналитик;
				НСтрока.ВариантРасчета = 4;
				
			Иначе
				
				НСтрока.УровеньРасчетаОперанда    = МаксимальныйУровеньДополненияАналитик + 1;
				НСтрока.УровеньРасчетаПотребителя = МаксимальныйУровеньДополненияАналитик + 1;
				НСтрока.ВариантРасчета = 2;
				
			КонецЕсли;
			
			СтруктураРасчетаПоказателей.МаксУровеньРасчета = Макс(СтруктураРасчетаПоказателей.МаксУровеньРасчета, НСтрока.УровеньРасчетаПотребителя);
			
			УровниСВременнымРасчетом.Добавить(МаксимальныйУровеньДополненияАналитик);
			
			стрОперанд.ВременныйРасчет = Истина;
			стрОперанд.ТрансформацияПолей = ТекстТрансформации;
			
		Иначе
			стрОперанд.ТрансформацияПолей = ТекстТрансформации + ТекстТрансформацииДополненияАналитик;
		КонецЕсли;
		
		ГруппаТрансформации = РазличныеГруппыТрансформации.Получить(стрОперанд.ТрансформацияПолей);
		Если ГруппаТрансформации = Неопределено Тогда
			ИндексГруппыТрансформации = ИндексГруппыТрансформации + 1;
			РазличныеГруппыТрансформации.Вставить(стрОперанд.ТрансформацияПолей,ИндексГруппыТрансформации);
			СтрОперанд.УИДГруппыТрансформации = ИндексГруппыТрансформации;
		Иначе
			СтрОперанд.УИДГруппыТрансформации = ГруппаТрансформации;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрОперанд.ПоказательОперанд) Тогда
			СтрОперанд.ПоказательОперанд = СтрОперанд.Потребитель;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПодготовитьПоляВыборкиЗапроса(СтруктураРасчетаПоказателей)
	
	тРасшифровкаГруппОтборов	= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов;
	тПоказателиОперанды			= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы		= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	
	// Добавим числовые и нечисловые показатели
	тПоказателиОперандыСвернутая = тПоказателиОперанды.Скопировать(,"ТипПотребителя,ТипПоказателя,УровеньРасчетаПотребителя,УровеньРасчетаОперанда,УИДГруппыОтборов");
	тПоказателиОперандыСвернутая.Свернуть("ТипПотребителя,ТипПоказателя,УровеньРасчетаПотребителя,УровеньРасчетаОперанда,УИДГруппыОтборов");
	Для Каждого СтрПолей Из тПоказателиОперандыСвернутая Цикл		
		
		// Добавим поля, которые участвуют в отборах будущих уровней
		СтрокиОтбораПолей = тРасшифровкаГруппОтборов.НайтиСтроки(Новый Структура("УИДГруппыОтборов",СтрПолей.УИДГруппыОтборов));
		Для Каждого СтрОтбор Из СтрокиОтбораПолей Цикл
			
			Если СтрОтбор.ПолеБД = "" Тогда
				Продолжить;
			КонецЕсли;
			
			ПерваяТочка = СтрНайти(СтрОтбор.ПолеБД,".");
			Если ПерваяТочка > 0 Тогда
				ПолеБД = Лев(СтрОтбор.ПолеБД,ПерваяТочка-1);
			Иначе
				ПолеБД = СтрОтбор.ПолеБД;
			КонецЕсли;
			
			Для СчУровень = 0 По СтрПолей.УровеньРасчетаОперанда-1 Цикл
				НайденныеСтроки = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("Поле,УровеньРасчета",ПолеБД,СчУровень));
				Если НайденныеСтроки.Количество() = 0 Тогда
					НПоле = тИспользуемыеАналитики.Добавить();
					НПоле.Поле = ПолеБД;
					НПоле.ПолеТрансформации = ПолеБД;
					НПоле.УровеньРасчета = СчУровень;
					НПоле.ПолеВерсии = Ложь;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Если СтрПолей.ТипПотребителя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			Поле = "Значение";
			Суммируется = Истина;
		Иначе
			Поле = "ЗначениеНечисловое";
			Суммируется = Ложь;
		КонецЕсли;
		
		// Добавим текущий уровень потребителя
		Для СчУровень = 1 По СтрПолей.УровеньРасчетаПотребителя Цикл
			
			НайденныеСтроки = тИспользуемыеРесурсы.НайтиСтроки(Новый Структура("Поле,УровеньРасчета",Поле,СчУровень));
			Если НайденныеСтроки.Количество() = 0 Тогда
				НПоле = тИспользуемыеРесурсы.Добавить();
				НПоле.Поле				= Поле;
				НПоле.УровеньРасчета	= СчУровень;
				НПоле.Суммируется		= Суммируется;
				НПоле.ВыводитсяВОтчет	= Истина;
			Иначе
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					Если Не НайденнаяСтрока.ВыводитсяВОтчет Тогда
						НайденнаяСтрока.ВыводитсяВОтчет	= Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрПолей.ТипПоказателя) Тогда
			Если СтрПолей.ТипПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				Поле = "Значение";
				Суммируется = Истина;
			Иначе
				Поле = "ЗначениеНечисловое";
				Суммируется = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Для СчУровень = 1 По СтрПолей.УровеньРасчетаОперанда Цикл
			НайденныеСтроки = тИспользуемыеРесурсы.НайтиСтроки(Новый Структура("Поле,УровеньРасчета",Поле,СчУровень-1));
			Если НайденныеСтроки.Количество() = 0 Тогда
				НПоле = тИспользуемыеРесурсы.Добавить();
				НПоле.Поле				= Поле;
				НПоле.УровеньРасчета	= СчУровень-1;
				НПоле.Суммируется		= Суммируется;
				НПоле.ВыводитсяВОтчет	= Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	// Определим настройки валютной аналитики
	тИспользуемыеАналитики.Сортировать("УровеньРасчета, Поле");
	тАналитикиВалюта = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("Поле","АналитикаВалюта"));
	Для Каждого СтрокаТаблицы Из тАналитикиВалюта Цикл
		Если СтрокаТаблицы.УровеньРасчета <> 0 Тогда
			СтруктураРасчетаПоказателей.Вставить("ЕстьАналитикаВалюта", Истина);
			СтруктураРасчетаПоказателей.Вставить("ЕстьЗначениеВалюта", СтруктураРасчетаПоказателей.тПоказателиОперанды.НайтиСтроки(Новый Структура("ПересчитыватьВалютнуюСумму", Истина)).Количество() > 0);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ИтоговыеРесурсы = тИспользуемыеРесурсы.Скопировать(Новый Структура("ВыводитсяВОтчет",Истина));
	СтруктураРасчетаПоказателей.Вставить("ЕстьЗначение", ИтоговыеРесурсы.Найти("Значение","Поле") <> Неопределено);
	СтруктураРасчетаПоказателей.Вставить("ЕстьЗначениеНечисловое", ИтоговыеРесурсы.Найти("ЗначениеНечисловое","Поле") <> Неопределено);
	
КонецПроцедуры


Функция ПолучитьДанныеПараметрическойНастройкиБезКэша(ПравилоОбработки) Экспорт
	
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	
	Запрос.Текст="ВЫБРАТЬ
	|	ХранилищаПравилПересчета.ДатаАктуальности
	|ИЗ
	|	РегистрСведений.ХранилищаПравилПересчета КАК ХранилищаПравилПересчета
	|ГДЕ
	|	ХранилищаПравилПересчета.ПравилоОбработки = &ПравилоОбработки";
	
	Результат=Запрос.Выполнить().Выбрать();			 
	
	Если Результат.Следующий() Тогда	
		СтруктураПересчета=КэшируемыеПроцедурыУХ.ПолучитьПравилаПересчетаПоказателей(ПравилоОбработки,Результат.ДатаАктуальности);		
	Иначе		
		Возврат Неопределено;		
	КонецЕсли;
	
		
	Запрос.Текст="ВЫБРАТЬ
	|	ХранилищаПараметрическойНастройки.ДанныеПараметрическойНастройки
	|ИЗ
	|	РегистрСведений.ХранилищаПараметрическойНастройки КАК ХранилищаПараметрическойНастройки
	|ГДЕ
	|	ХранилищаПараметрическойНастройки.ПравилоОбработки = &ПравилоОбработки";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		СтруктураПараметрики=Результат.ДанныеПараметрическойНастройки.Получить();
		
		Для Каждого КлючИЗначение Из СтруктураПараметрики Цикл
			
			СтруктураПересчета.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	Возврат СтруктураПересчета;
	
				 
	
КонецФункции // ПолучитьДанныеПараметрическойНастройки()


Процедура ДобавитьЗависимыеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, ПоказательДляПоиска)
	
	НайденныеСтроки = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("ПоказательОтбор", ПоказательДляПоиска));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Показатель",НайденнаяСтрока.Потребитель);
		СтруктураПоиска.Вставить("АналитикаВалюта",стрПоказатель.АналитикаВалюта);
		Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			СтруктураПоиска.Вставить("Аналитика" + Сч, стрПоказатель["Аналитика" + Сч]);
		КонецЦикла;	
		Если тПотребители.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
			НСтрокаТаблицы = тПотребители.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрокаТаблицы, стрПоказатель);
			НСтрокаТаблицы.Показатель = НайденнаяСтрока.Потребитель;
			ДобавитьЗависимыеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, НайденнаяСтрока.Потребитель);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтфильтроватьПоИзмененнымПоказателям(ДанныеДляРасчета, тИзмененныеПоказатели)	
	
	Если тИзмененныеПоказатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	тДанныеДляРасчетов = ДанныеДляРасчета.тДанныеДляРасчетов;
	тДанныеДляРасчетов.Индексы.Добавить("ПоказательОтбор");
	тДанныеДляРасчетов.Индексы.Добавить("Потребитель");
	тДанныеДляРасчетовНовая = тДанныеДляРасчетов.СкопироватьКолонки();
	тПараметрыОтбораБДНовая = ДанныеДляРасчета.тПараметрыОтбораБД.Скопировать();
	тПравилаИспользованияПолейЗапроса = ДанныеДляРасчета.тПравилаИспользованияПолейЗапроса;
	
	СтруктураСложныхОтборов = Новый Структура;
	
	тПотребители = Новый ТаблицаЗначений;
	тПотребители.Колонки.Добавить("Показатель");
	тПотребители.Колонки.Добавить("АналитикаВалюта");
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		тПотребители.Колонки.Добавить("Аналитика" + Сч);
	КонецЦикла;
	Для Каждого стрПоказатель Из тИзмененныеПоказатели Цикл
		ДобавитьЗависимыеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, стрПоказатель.Показатель);
	КонецЦикла;
	
	тРазличныеПотребители = тПотребители.Скопировать(,"Показатель");
	тРазличныеПотребители.Свернуть("Показатель");
	
	МассивПотребителейСВнешнимИсточником = Новый Массив;
	
	// Оставим только полученных потребителей	
	Для Каждого стрПотребитель Из тРазличныеПотребители Цикл
		
		НайденныеПотребители = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("Потребитель", стрПотребитель.Показатель));
		
		// Исключим формулы с внешними источниками из расчета
		Для Каждого СтрНайденныйПотребитель Из НайденныеПотребители Цикл
			Если ЭтоВнешнийИсточник(СтрНайденныйПотребитель.СпособПолучения)
				ИЛИ МассивПотребителейСВнешнимИсточником.Найти(СтрНайденныйПотребитель.ПоказательОтбор) <> Неопределено Тогда
				МассивПотребителейСВнешнимИсточником.Добавить(стрПотребитель.Показатель);
			КонецЕсли;
		КонецЦикла;
		Если МассивПотребителейСВнешнимИсточником.Найти(стрПотребитель.Показатель) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрНайденныйПотребитель Из НайденныеПотребители Цикл
			
			// Добавляем строку потребителя в таблицу для расчета
			НСтрока = тДанныеДляРасчетовНовая.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, СтрНайденныйПотребитель);
			
			// Добавим в таблицу потребителей для формирования отборов
			НайденныеСтроки = тПотребители.НайтиСтроки(Новый Структура("Показатель",стрПотребитель.Показатель));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НСтрока = тПотребители.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, НайденнаяСтрока);
				НСтрока.Показатель = СтрНайденныйПотребитель.ПоказательОтбор;
			КонецЦикла;
		
			// Проверим наличие сложных отборов по аналитикам
			Для Сч = 0 По Макс(СтрНайденныйПотребитель.ЧислоАналитикПоказателя, СтрНайденныйПотребитель.ЧислоАналитик) Цикл
				
				Если Сч = 0 Тогда
					Если СтрНайденныйПотребитель.ЕстьАналитикаВалютаПоказателя Тогда
						ИмяОтбора = "АналитикаВалюта";
					Иначе
						Продолжить;
					КонецЕсли;
				Иначе
					ИмяОтбора = "Аналитика" + Строка(Сч + СтрНайденныйПотребитель.МаксКлючевыхАналитикПоказателя);
				КонецЕсли;
				
				Если СтруктураСложныхОтборов.Свойство(ИмяОтбора) Тогда
					// Отбор уже определен, как сложный
					Продолжить;
				КонецЕсли;
				
				Если СтрНайденныйПотребитель.ВариантРасчета = 1 Тогда
					// Рассчитывается в коде, отбор не устанавливаем
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				Если СтрНайденныйПотребитель.ЧислоАналитикПоказателя <> СтрНайденныйПотребитель.ЧислоАналитик Тогда
					// Есть трансформация аналитик, отборы не устанавливаем
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				// Найдем правила заполнения аналитик
				ПравилаТрансформации = тПравилаИспользованияПолейЗапроса.НайтиСтроки(Новый Структура("Ссылка,Поле", СтрНайденныйПотребитель.Ссылка, ИмяОтбора));
				Если ПравилаТрансформации.Количество() <> 1 Тогда
					// Нет правил трансформации
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				ПравилоТрансформации = ПравилаТрансформации.Получить(0);
				Если ПравилоТрансформации.СпособЗаполнения <> Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы
					ИЛИ ПравилоТрансформации.КодАналитики <> ИмяОтбора Тогда
					// Нестандартные правила трансформации
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				// Ищем отборы по аналитикам 
				СтрокиОтбора = тПараметрыОтбораБДНовая.НайтиСтроки(Новый Структура("Ссылка,ПолеБД", СтрНайденныйПотребитель.Ссылка, ИмяОтбора));
				Если СтрокиОтбора.Количество() <> 0 Тогда
					// Уже задан отбор по аналитике
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрПотребитель Из тДанныеДляРасчетовНовая Цикл

		// Добавим отборы по аналитикам, если в дереве расчета нет сложных отборов
		Для Сч = 0 По СтрПотребитель.ЧислоАналитикПоказателя Цикл
			
			Если Сч = 0 Тогда
				Если СтрПотребитель.ЕстьАналитикаВалютаПоказателя Тогда
					ИмяОтбора = "АналитикаВалюта";
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				ИмяОтбора = "Аналитика" + Строка(Сч + СтрПотребитель.МаксКлючевыхАналитикПоказателя);
			КонецЕсли;
			
			Если СтруктураСложныхОтборов.Свойство(ИмяОтбора) Тогда
				// По этой аналитике есть сложный отбор
				Продолжить;
			КонецЕсли;
			
			тТекущиеПотребители = тПотребители.Скопировать(Новый Структура("Показатель",СтрПотребитель.Потребитель));
			тТекущиеПотребители.Свернуть(ИмяОтбора);
			МассивЗначений = Новый Массив;
			Для Каждого ТекСтрока Из тТекущиеПотребители Цикл
				ТекЗначение = ТекСтрока[ИмяОтбора];
				Если ЗначениеЗаполнено(ТекЗначение) Тогда
					МассивЗначений.Добавить(ТекЗначение);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивЗначений.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Установим отбор по аналитике
			стрОтбор = тПараметрыОтбораБДНовая.Добавить();
			стрОтбор.ИдентификаторРодителя = 0;
			стрОтбор.ИдентификаторСтроки = 1000 + Сч;
			стрОтбор.ИмяПараметра = 1000 + Сч;
			стрОтбор.КодВФормуле = СтрПотребитель.Код;
			стрОтбор.ПоказательОперанд = СтрПотребитель.ПоказательОтбор;
			стрОтбор.ПолеБД = ИмяОтбора;
			стрОтбор.Ссылка = СтрПотребитель.Ссылка;
			стрОтбор.ТекстМодуля = "";
			Если МассивЗначений.Количество() = 1 Тогда
				стрОтбор.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
				стрОтбор.УточнениеСпособаОпределения = МассивЗначений.Получить(0);
			Иначе
				стрОтбор.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
				стрОтбор.УточнениеСпособаОпределения = МассивЗначений;
			КонецЕсли;
	
		КонецЦикла;
		
	КонецЦикла;
	
	ДанныеДляРасчетаНовые = Новый Структура;
	Для Каждого КлючЗначение Из ДанныеДляРасчета Цикл
		Если КлючЗначение.Ключ = "тПараметрыОтбораБД" Тогда
			Значение = тПараметрыОтбораБДНовая;
		ИначеЕсли КлючЗначение.Ключ = "тДанныеДляРасчетов" Тогда
			Значение = тДанныеДляРасчетовНовая;
		Иначе
			Значение = КлючЗначение.Значение;
		КонецЕсли;
		ДанныеДляРасчетаНовые.Вставить(КлючЗначение.Ключ, Значение);	
	КонецЦикла;
	
	ДанныеДляРасчета = ДанныеДляРасчетаНовые;
	
КонецПроцедуры

Процедура ДобавитьВлияющиеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, ПоказательДляПоиска)
	
	НайденныеСтроки = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("Потребитель", ПоказательДляПоиска));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.ВидОтчетаПотребителя = НайденнаяСтрока.ВидОтчетаПоказателя Тогда
			// Оставляем показатели только текущего вида отчета
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Показатель",НайденнаяСтрока.ПоказательОтбор);
			СтруктураПоиска.Вставить("АналитикаВалюта",стрПоказатель.АналитикаВалюта);
			Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				СтруктураПоиска.Вставить("Аналитика" + Сч, стрПоказатель["Аналитика" + Сч]);
			КонецЦикла;	
			Если тПотребители.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
				НСтрокаТаблицы = тПотребители.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрокаТаблицы, стрПоказатель);
				НСтрокаТаблицы.Показатель = НайденнаяСтрока.ПоказательОтбор;
				ДобавитьВлияющиеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, НайденнаяСтрока.ПоказательОтбор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтфильтроватьПоЦелевымПоказателям(ДанныеДляРасчета, тЦелевыеПоказатели)	
	
	Если тЦелевыеПоказатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	тДанныеДляРасчетов = ДанныеДляРасчета.тДанныеДляРасчетов;
	тДанныеДляРасчетовНовая = тДанныеДляРасчетов.СкопироватьКолонки();
	тПараметрыОтбораБДНовая = ДанныеДляРасчета.тПараметрыОтбораБД.Скопировать();
	тПравилаИспользованияПолейЗапроса = ДанныеДляРасчета.тПравилаИспользованияПолейЗапроса;
	
	СтруктураСложныхОтборов = Новый Структура;
	
	тПотребители = Новый ТаблицаЗначений;
	тПотребители.Колонки.Добавить("Показатель");
	тПотребители.Колонки.Добавить("АналитикаВалюта");
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		тПотребители.Колонки.Добавить("Аналитика" + Сч);
	КонецЦикла;
	Для Каждого стрПоказатель Из тЦелевыеПоказатели Цикл
		НСтрокаТаблицы = тПотребители.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрокаТаблицы, стрПоказатель);
		Если НЕ ЭтоРасшифровка Тогда
			ДобавитьВлияющиеПоказателиРекурсивно(тПотребители, тДанныеДляРасчетов, стрПоказатель, стрПоказатель.Показатель);
		КонецЕсли;
	КонецЦикла;
	
	тРазличныеПотребители = тПотребители.Скопировать(,"Показатель");
	тРазличныеПотребители.Свернуть("Показатель");

	// Оставим только полученных потребителей	
	Для Каждого стрПотребитель Из тРазличныеПотребители Цикл
		
		НайденныеПотребители = тДанныеДляРасчетов.НайтиСтроки(Новый Структура("Потребитель", стрПотребитель.Показатель));
		
		// Здесь отличие
		Для Каждого СтрНайденныйПотребитель Из НайденныеПотребители Цикл
			
			// Добавляем строку потребителя в таблицу для расчета
			НСтрока = тДанныеДляРасчетовНовая.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, СтрНайденныйПотребитель);
			
			// Добавим в таблицу потребителей для формирования отборов
			НайденныеСтроки = тПотребители.НайтиСтроки(Новый Структура("Показатель",стрПотребитель.Показатель));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НСтрока = тПотребители.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, НайденнаяСтрока);
				НСтрока.Показатель = СтрНайденныйПотребитель.ПоказательОтбор;
			КонецЦикла;
		
			// Проверим наличие сложных отборов по аналитикам
			Для Сч = 0 По Макс(СтрНайденныйПотребитель.ЧислоАналитикПоказателя, СтрНайденныйПотребитель.ЧислоАналитик) Цикл
				
				Если Сч = 0 Тогда
					Если СтрНайденныйПотребитель.ЕстьАналитикаВалютаПоказателя Тогда
						ИмяОтбора = "АналитикаВалюта";
					Иначе
						Продолжить;
					КонецЕсли;
				Иначе
					ИмяОтбора = "Аналитика" + Строка(Сч + СтрНайденныйПотребитель.МаксКлючевыхАналитикПоказателя);
				КонецЕсли;
				
				Если СтруктураСложныхОтборов.Свойство(ИмяОтбора) Тогда
					// Отбор уже определен, как сложный
					Продолжить;
				КонецЕсли;
				
				Если СтрНайденныйПотребитель.ВариантРасчета = 1 Тогда
					// Рассчитывается в коде, отбор не устанавливаем
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				Если СтрНайденныйПотребитель.ЧислоАналитикПоказателя <> СтрНайденныйПотребитель.ЧислоАналитик Тогда
					// Есть трансформация аналитик, отборы не устанавливаем
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				// Найдем правила заполнения аналитик
				ПравилаТрансформации = тПравилаИспользованияПолейЗапроса.НайтиСтроки(Новый Структура("Ссылка,Поле", СтрНайденныйПотребитель.Ссылка, ИмяОтбора));
				Если ПравилаТрансформации.Количество() <> 1 Тогда
					// Нет правил трансформации
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
				
				ПравилоТрансформации = ПравилаТрансформации.Получить(0);
				Если ПравилоТрансформации.СпособЗаполнения <> Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы
					ИЛИ ПравилоТрансформации.КодАналитики <> ИмяОтбора Тогда
					// Нестандартные правила трансформации
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
					Продолжить;
				КонецЕсли;
					
				// Ищем отборы по аналитикам 
				СтрокиОтбора = тПараметрыОтбораБДНовая.НайтиСтроки(Новый Структура("Ссылка,ПолеБД", СтрНайденныйПотребитель.Ссылка, ИмяОтбора));
				Если СтрокиОтбора.Количество() <> 0 Тогда
					// Уже задан отбор по аналитике
					СтруктураСложныхОтборов.Вставить(ИмяОтбора);
				КонецЕсли;

			КонецЦикла;
	
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрПотребитель Из тДанныеДляРасчетовНовая Цикл

		// Добавим отборы по аналитикам, если в дереве расчета нет сложных отборов
		Для Сч = 0 По СтрПотребитель.ЧислоАналитикПоказателя Цикл
			
			Если Сч = 0 Тогда
				Если СтрПотребитель.ЕстьАналитикаВалютаПоказателя Тогда
					ИмяОтбора = "АналитикаВалюта";
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				ИмяОтбора = "Аналитика" + Строка(Сч + СтрПотребитель.МаксКлючевыхАналитикПоказателя);
			КонецЕсли;
			
			Если СтруктураСложныхОтборов.Свойство(ИмяОтбора) Тогда
				// По этой аналитике есть сложный отбор
				Продолжить;
			КонецЕсли;
			
			// Установим отбор по аналитике
			тТекущиеПотребители = тПотребители.Скопировать(Новый Структура("Показатель",СтрПотребитель.Потребитель));
			тТекущиеПотребители.Свернуть(ИмяОтбора); 
			Если тТекущиеПотребители.Количество() <> 1 Тогда
			стрОтбор = тПараметрыОтбораБДНовая.Добавить();
			стрОтбор.ИдентификаторРодителя = 0;
			стрОтбор.ИдентификаторСтроки = 1000 + Сч;
			стрОтбор.ИмяПараметра = 1000 + Сч;
			стрОтбор.КодВФормуле = СтрПотребитель.Код;
			стрОтбор.ПоказательОперанд = СтрПотребитель.ПоказательОтбор;
			стрОтбор.ПолеБД = ИмяОтбора;
			стрОтбор.Ссылка = СтрПотребитель.Ссылка;
			стрОтбор.ТекстМодуля = "";
			Если тТекущиеПотребители.Количество() = 1 Тогда 
				стрОтбор.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
				стрОтбор.УточнениеСпособаОпределения = тТекущиеПотребители[0][ИмяОтбора];
			Иначе
				стрОтбор.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
				стрОтбор.УточнениеСпособаОпределения = тТекущиеПотребители.ВыгрузитьКолонку(ИмяОтбора);
			КонецЕсли;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	ДанныеДляРасчетаНовые = Новый Структура;
	Для Каждого КлючЗначение Из ДанныеДляРасчета Цикл
		Если КлючЗначение.Ключ = "тПараметрыОтбораБД" Тогда
			Значение = тПараметрыОтбораБДНовая;
		ИначеЕсли КлючЗначение.Ключ = "тДанныеДляРасчетов" Тогда
			Значение = тДанныеДляРасчетовНовая;
		Иначе
			Значение = КлючЗначение.Значение;
		КонецЕсли;
		ДанныеДляРасчетаНовые.Вставить(КлючЗначение.Ключ, Значение);	
	КонецЦикла;
	
	ДанныеДляРасчета = ДанныеДляРасчетаНовые;
	
КонецПроцедуры

Процедура ОтфильтроватьПоПоказателямИсключениям(ДанныеДляРасчета, мПоказателиИсключения)
	
	тДанныеДляРасчетовНовая	= ДанныеДляРасчета.тДанныеДляРасчетов.Скопировать();
	МассивСтрокДляУдаления	= Новый Массив;
	
	// Найдем и удалим из параметрики строки с показателями-исключениями
	Для Каждого ТекПоказатель Из мПоказателиИсключения Цикл
		НайденныеСтроки = тДанныеДляРасчетовНовая.НайтиСтроки(Новый Структура("Потребитель", ТекПоказатель));
		Для Каждого СтрОперанд Из НайденныеСтроки Цикл
			МассивСтрокДляУдаления.Добавить(СтрОперанд);
		КонецЦикла;
	КонецЦикла;
	
	// Удалим также все строки с данными из внешних источников
	Для Каждого СтрОперанд Из тДанныеДляРасчетовНовая Цикл
		Если ЭтоВнешнийИсточник(СтрОперанд.СпособПолучения) Тогда
			Если МассивСтрокДляУдаления.Найти(СтрОперанд) = Неопределено Тогда
				МассивСтрокДляУдаления.Добавить(СтрОперанд);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Удалим строки
	Для Каждого СтрОперанд Из МассивСтрокДляУдаления Цикл
		тДанныеДляРасчетовНовая.Удалить(СтрОперанд);
	КонецЦикла;
	
	// Заменим данные для расчета если были сроки для удаления
	Если МассивСтрокДляУдаления.Количество() Тогда
		ДанныеДляРасчетаНовые = Новый Структура;
		Для Каждого КлючЗначение Из ДанныеДляРасчета Цикл
			Если КлючЗначение.Ключ = "тДанныеДляРасчетов" Тогда
				Значение = тДанныеДляРасчетовНовая;
			Иначе
				Значение = КлючЗначение.Значение;
			КонецЕсли;
			ДанныеДляРасчетаНовые.Вставить(КлючЗначение.Ключ, Значение);	
		КонецЦикла;
		
		ДанныеДляРасчета = ДанныеДляРасчетаНовые;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыДляГенерацииЗапросаОперандов0Уровня

////////////////////////////////////////////////////////////////////////////////
// Процедуры для генерации текста запроса по операндам 0-го уровня выборки
// 
////////////////////////////////////////////////////////////////////////////////

Функция ТекстПолученияАналитики(ТрансформацияПолей, ИмяАналитики, тПараметрыПакета)
	
	ПравилаИспользованияАналитик = СтрРазделить(ТрансформацияПолей,";",Ложь);

	Для Каждого СтрПравило Из ПравилаИспользованияАналитик Цикл
					
		ЗначенияПравилИспользованияПолей = СтрРазделить(СтрПравило,"@");
		ТипОтбора = ЗначенияПравилИспользованияПолей[0];
		ЗначениеОтбора = ЗначенияПравилИспользованияПолей[1];
		ИмяОтбора = ЗначенияПравилИспользованияПолей[2];
		
		Если ИмяОтбора <> ИмяАналитики Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипОтбора = "ПолеИсходнойТаблицы" Тогда
			
			Возврат "ЗначенияОперандов."+СтрЗаменить(ЗначениеОтбора,".","")+" КАК "+ИмяОтбора;
		
		ИначеЕсли ТипОтбора = "ФиксированноеЗначение" Тогда
					
			нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
				Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,
				ЗначениеИзСтрокиВнутр(СтрЗаменить(ЗначениеОтбора,".","")),
				ИмяОтбора);
				
			Возврат "&" + нПараметр.ИмяОтбора + " КАК " + ИмяОтбора;
			
		ИначеЕсли ТипОтбора = "КонтекстОбъектаЗагрузки" Тогда
			
			нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
				"КонтекстВызоваЗаполнения",
				ЗначениеОтбора,
				ИмяОтбора);
		
			Возврат "&" + нПараметр.ИмяОтбора + " КАК " + ИмяОтбора;
			
		
		ИначеЕсли ТипОтбора = "ПолеДругогоИсточникаДанных" Тогда
			
			ТекстОшибки = НСтр("ru = 'Нельзя использовать поле другого источника для дополнения аналитик в источнике данных, который сам является источником для дополнения аналитик'");
			ВызватьИсключение(ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "НЕОПРЕДЕЛЕНО КАК " + ИмяАналитики;	
	
КонецФункции

Процедура ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей)
	 
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тПоказателиОперанды				= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	ЕстьДополненияАналитик			= СтруктураРасчетаПоказателей.ЕстьДополненияАналитик;
	ЕстьЗначениеВалюта				= СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта;
	ЕстьВременныйРасчет				= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом.Количество() > 0;
	ПересчитатьВОсновнуюВалюту		= СтруктураРасчетаПоказателей.ПересчитатьВОсновнуюВалюту;
	
	тПараметрыПакета = ОписаниеТаблицыПараметров();
	
	НОтбор					= тПараметрыПакета.Добавить();
	НОтбор.ИмяОтбора		= "тПоказателиОперанды";
	НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НОтбор.ЗначениеОтбора	= тПоказателиОперанды;
	
	ПеременныеПоляЗапроса = "";
	ПоляДополненияАналитик = "";
	
	Если ЕстьДополненияАналитик Тогда
		ПоляДополненияАналитик = ПоляДополненияАналитик + ",
		|	ПоказателиОперанды.ДляДополненияАналитик КАК ДляДополненияАналитик";
		ПеременныеПоляЗапроса = ПеременныеПоляЗапроса + ПоляДополненияАналитик;
	КонецЕсли;
	
	Если ЕстьВременныйРасчет Тогда
		ПеременныеПоляЗапроса = ПеременныеПоляЗапроса + ",
		|	ПоказателиОперанды.ВременныйРасчет КАК ВременныйРасчет";
	КонецЕсли;	
	
	Если ЕстьЗначениеВалюта Тогда
		ПеременныеПоляЗапроса = ПеременныеПоляЗапроса + ",
		|	ПоказателиОперанды.ПересчитыватьВалютнуюСумму КАК ПересчитыватьВалютнуюСумму";
	КонецЕсли;
	
	Если ПересчитатьВОсновнуюВалюту Тогда
		ПеременныеПоляЗапроса = ПеременныеПоляЗапроса + ",
		|	ПоказателиОперанды.ПересчитатьВОсновнуюВалюту КАК ПересчитатьВОсновнуюВалюту";
	КонецЕсли;

	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПоказателиОперанды.Потребитель КАК Потребитель,
		|	ПоказателиОперанды.ПоказательОперанд КАК ПоказательОперанд,
		|	ПоказателиОперанды.УровеньРасчетаПотребителя КАК УровеньРасчетаПотребителя,
		|	ПоказателиОперанды.УровеньРасчетаОперанда КАК УровеньРасчетаОперанда,
		|	ПоказателиОперанды.КодВФормуле КАК КодВФормуле,
		|	ПоказателиОперанды.ТипПотребителя КАК ТипПотребителя,
		|	ПоказателиОперанды.ТипПоказателя КАК ТипПоказателя,
		|	ПоказателиОперанды.РекурсивныйРасчетПериодов КАК РекурсивныйРасчетПериодов,
		|	ПоказателиОперанды.ИндексРегистраПотребителя КАК ИндексРегистраПотребителя,
		|	ПоказателиОперанды.УИДГруппыОтборов КАК УИДГруппыОтборов,
		|	ПоказателиОперанды.УИДГруппыТрансформации КАК УИДГруппыТрансформации,
		|	ПоказателиОперанды.ВидИтога КАК ВидИтога,
		|	ПоказателиОперанды.ВариантРасчета КАК ВариантРасчета"+ПеременныеПоляЗапроса+"
		|ПОМЕСТИТЬ втПоказателиОперанды
		|ИЗ
		|	&тПоказателиОперанды КАК ПоказателиОперанды
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	РекурсивныйРасчетПериодов,
		|	УровеньРасчетаПотребителя,
		|	ВариантРасчета,
		|	ПоказательОперанд,
		|	УИДГруппыОтборов,
		|	УИДГруппыТрансформации		
		|;
		|
		|//////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоказателиОперанды.ПоказательОперанд,
		|	ПоказателиОперанды.УИДГруппыОтборов,
		|	ПоказателиОперанды.КодВФормуле"+ПоляДополненияАналитик+"
		|ПОМЕСТИТЬ втПоказателиОперанды0
		|ИЗ
		|	втПоказателиОперанды КАК ПоказателиОперанды
		|ГДЕ
		|	ПоказателиОперанды.УровеньРасчетаОперанда = 1";

	нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса;
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ТАБЛИЦА ВСЕХ ОПЕРАНДОВ ТЕКУЩЕГО РАСЧЕТА'");
	нСтрокаТаблицыЗапросов.тПараметрыПакета		= тПараметрыПакета;
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеТаблицыОперандов;
	
КонецПроцедуры	

Процедура ДобавитьПодзапросСоответствияПериодов(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов)
	
	тРасшифровкаГруппОтборов	= СтруктураПараметровТекущегоУровня.тРасшифровкаГруппОтборовВерсии;
	тПараметрыПакетаВТ			= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	
	УИДГруппыОтборов			= СтрКэшГруппОтборов.УИДГруппыОтборов;
	
	тРасшифровкаГруппОтборовПоПериоду = тРасшифровкаГруппОтборов.Скопировать(Новый Структура("ПолеБД,УИДГруппыОтборов","ПериодОтчета",УИДГруппыОтборов));	
	
	тПараметрыОтбора	= ОписаниеТаблицыПараметров();
	ТекстОтбора			= ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборовПоПериоду, тПараметрыОтбора, УИДГруппыОтборов);
	ТекстОтбора			= Сред(СтрЗаменить(ТекстОтбора, "#ИмяТаблицы.ПериодОтчета", "Периоды.Ссылка"), СтрДлина(" И "));
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ТекстОтбора",	ТекстОтбора);
	СтруктураОтбора.Вставить("ПараметрыОтбора",тПараметрыОтбора);
	
	НСтрока = тПараметрыПакетаВТ.Добавить();
	НСтрока.ИмяОтбора = "втСоответствиеПериодов_" + Формат(УИДГруппыОтборов,"ЧН=0; ЧГ=0");
	НСтрока.ТипОтбора = "СоответствиеПериодов";
	НСтрока.ЗначениеОтбора = СтруктураОтбора;
	
КонецПроцедуры

Процедура ДобавитьПодзапросСоответствияПериодовПриСверткеПоПериоду(СтруктураПараметровТекущегоУровня)

	мПодзапросыДанныхВТ	= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тПараметрыПакетаВТ	= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Периоды.Ссылка КАК ПериодОтчета,
		|	ПериодыВерсий.Ссылка КАК ПериодИсходный
		|ПОМЕСТИТЬ втСоответствиеПериодов_СверткаПоПериоду
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК ПериодыВерсий
		|		ПО (ПериодыВерсий.Периодичность = &УточнениеСпособаФормированияОтчета)
		|			И (ПериодыВерсий.ДатаНачала >= Периоды.ДатаНачала)
		|			И (ПериодыВерсий.ДатаОкончания <= Периоды.ДатаОкончания)
		|			И (Периоды.Ссылка В (&ПериодОтчета))";
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
		
	ДобавитьПараметрВПакет(тПараметрыПакетаВТ, "УточнениеСпособаФормированияОтчета",, "УточнениеСпособаФормированияОтчета");
	ДобавитьПараметрВПакет(тПараметрыПакетаВТ, Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета,, "ПериодОтчета");
	
КонецПроцедуры

Процедура ДобавитьПодзапросОрганизацийПериметра(СтруктураПараметровТекущегоУровня)
	
	мПодзапросыДанныхВТ	= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тПараметрыПакетаВТ	= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	ТипПараметрическойНастройки = СтруктураПараметровТекущегоУровня.ТипПараметрическойНастройки;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ОрганизацииПериметра.Организация КАК Организация,
		|	&ОрганизацияКонтрагента,
		|	ВЫРАЗИТЬ(ОрганизацииПериметра.Коэффициент КАК ЧИСЛО(6,5)) КАК Коэффициент
		|ПОМЕСТИТЬ втОрганизацииПериметра
		|ИЗ
		|	&УточнениеСпособаФормированияОтчета КАК ОрганизацииПериметра";
	
	Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОрганизацияКонтрагента",
			"ОрганизацииПериметра.ОрганизацияКонтрагента КАК ОрганизацияКонтрагента");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС + Символы.Таб + "&ОрганизацияКонтрагента,", "");
	КонецЕсли;
	
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
		
	ДобавитьПараметрВПакет(тПараметрыПакетаВТ, "УточнениеСпособаФормированияОтчета", , "УточнениеСпособаФормированияОтчета");

КонецПроцедуры

Процедура ДобавитьПодзапросТекущейВерсии(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов)
	
	тРасшифровкаГруппОтборов		= СтруктураПараметровТекущегоУровня.тРасшифровкаГруппОтборовВерсии;
	мПодзапросыДанныхВТ				= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тПараметрыПакетаВТ				= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	тИспользуемыеАналитики			= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	ТипПараметрическойНастройки		= СтруктураПараметровТекущегоУровня.ТипПараметрическойНастройки;
	
	ВидыОтчетов						= СтрКэшГруппОтборов.ВидыОтчетов;
	УИДГруппыОтборов				= СтрКэшГруппОтборов.УИДГруппыОтборов;
	ИндексРегистра					= СтрКэшГруппОтборов.ИндексРегистра;
	
	#Область ТекстЗамены
	
	// УИД группы отборов
	УИДГруппыОтборовСтрока = Формат(УИДГруппыОтборов,"ЧН=0; ЧГ=0");
	
	// Текст аналитики
	ТекстАналитик = ТекстПолейАналитик(тИспользуемыеАналитики,0,0);
	ТекстАналитик = СтрЗаменить(ТекстАналитик,"#ИмяТаблицы","ВерсииЗначенийПоказателей");
	
	// Прочие режимы заполнения
	ТекстСоединение = "";
	ТекстПериод = "ВерсииЗначенийПоказателей.ПериодОтчета";
	Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.СвернувПоПериоду Тогда
		
		ТекстСоединение = "
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСоответствиеПериодов_СверткаПоПериоду КАК СоответствиеПериодов
		|		ПО ВерсииЗначенийПоказателей.ПериодОтчета = СоответствиеПериодов.ПериодИсходный";
		ТекстПериод = "СоответствиеПериодов.ПериодОтчета";
		
	ИначеЕсли ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Консолидация
		ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.КонсолидацияПропорционально
		ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
		
		ТекстСоединение = "
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОрганизацииПериметра КАК ОрганизацииПериметра
		|		ПО ВерсииЗначенийПоказателей.Организация = ОрганизацииПериметра.Организация";
		
		Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
			ТекстПериод = "ОрганизацииПериметра.ОрганизацияКонтрагента КАК ОрганизацияКонтрагента,
			|	ВЫРАЗИТЬ(ОрганизацииПериметра.Коэффициент КАК ЧИСЛО(6,5)) КАК Коэффициент,
			|	" + ТекстПериод;
		Иначе
			ТекстПериод = "ВЫРАЗИТЬ(ОрганизацииПериметра.Коэффициент КАК ЧИСЛО(6,5)) КАК Коэффициент,
			|	" + ТекстПериод;
		КонецЕсли;

	КонецЕсли;
	
	// Отбор по видам отчетов
	НОтбор					= тПараметрыПакетаВТ.Добавить();
	НОтбор.ИмяОтбора		= "ВидыОтчетов_" + УИДГруппыОтборовСтрока;
	НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	Если ТипЗнч(ВидыОтчетов) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		ОтборВидыОтчетов = "= &" + НОтбор.ИмяОтбора;
		НОтбор.ЗначениеОтбора = ВидыОтчетов;
	ИначеЕсли ВидыОтчетов.Количество() = 1 Тогда
		ОтборВидыОтчетов = "= &" + НОтбор.ИмяОтбора;
		НОтбор.ЗначениеОтбора = ВидыОтчетов.Получить(0);
	Иначе
		ОтборВидыОтчетов = "В (&" + НОтбор.ИмяОтбора + ")";
		НОтбор.ЗначениеОтбора = ВидыОтчетов;
	КонецЕсли;
	
	// Текст отбора версий
	ТекстОтбора = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов, тПараметрыПакетаВТ, УИДГруппыОтборов);
	ТекстОтбора = СтрЗаменить(ТекстОтбора,"#ИмяТаблицы","ВерсииЗначенийПоказателей");
	
	#КонецОбласти
	
	#Область ТекстЗапроса
	
	ТекстЗапроса = "
		|// ВЕРСИИ ЗНАЧЕНИЙ ПОКАЗАТЕЛЕЙ
		|
		|ВЫБРАТЬ
		|	ВерсииЗначенийПоказателей.Ссылка КАК Версия,
		|	ВерсииЗначенийПоказателей.Код КАК Код,
		|	"+УИДГруппыОтборовСтрока+" КАК УИДГруппыОтборов,
		|	"+ТекстПериод+" КАК ПериодОтчета"+ТекстАналитик+"
		|ПОМЕСТИТЬ втВерсииПоказателей_"+УИДГруппыОтборовСтрока+"
		|ИЗ
		|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей"+ТекстСоединение+"
		|
		|ГДЕ
		|	ВерсииЗначенийПоказателей.ВидОтчета "+ОтборВидыОтчетов+ТекстОтбора+"
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Версия";
	
	#Область ТекстЗапросаНечисловые
	
	// Формируем текст запросов
	Если ИндексРегистра = -1 ИЛИ ИндексРегистра = -11 Тогда
		// Это нечисловые значения. По ним срез по версиям не агрегируется. Просто берем последнюю версию.
		
		// Текст итоговое значение
		ТекстИтоговоеЗначение = ?(ИндексРегистра = -11, "ИСТИНА", "ЛОЖЬ");
		
		// Текст группировки по используемым аналитикам версии
		ТекстАналитикГруппировка = "";
		тПоляУровня = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,ПолеВерсии",0,Истина));
		Для Каждого СтрПоле Из тПоляУровня Цикл			
			ТекстАналитикГруппировка = ТекстАналитикГруппировка + ",
			|	ВерсииЗначенийПоказателей." + СтрПоле.Поле;
		КонецЦикла;
		
		// Текст отбора версий
		Если НЕ ПустаяСтрока(ТекстОтбора) Тогда	
			ТекстОтбора = "
			|
			|ГДЕ
			|	" + Сред(ТекстОтбора, СтрДлина(" И "));
		КонецЕсли;
		
		ТекстЗапроса = ?(УИДГруппыОтборов = 0, "", ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов()) + "
		|ВЫБРАТЬ
		|	ВерсииЗначенийПоказателей.Код КАК НомерТранзакции,
		|	ВерсииЗначенийПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
		|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
		|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
		|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
		|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
		|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
		|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
		|	ЗначенияПоказателей.Значение КАК ЗначениеНечисловое"+ТекстАналитик+"
		|ПОМЕСТИТЬ втЗначенияНечисловых_"+УИДГруппыОтборовСтрока+"_ИТОГ_"+ТекстИтоговоеЗначение+"
		|ИЗ
		|	втВерсииПоказателей_"+УИДГруппыОтборовСтрока+" КАК ВерсииЗначенийПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПоказателейОтчетовНечисловые КАК ЗначенияПоказателей
		|		ПО ВерсииЗначенийПоказателей.Версия = ЗначенияПоказателей.Версия
		|		И ЗначенияПоказателей.ИтоговоеЗначение = "+ТекстИтоговоеЗначение+"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВерсииЗначенийПоказателей.НомерТранзакции + 10000000000 КАК НомерТранзакции,
		|	ВерсииЗначенийПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ВерсииЗначенийПоказателей.Показатель КАК Показатель,
		|	ВерсииЗначенийПоказателей.Аналитика1 КАК Аналитика1,
		|	ВерсииЗначенийПоказателей.Аналитика2 КАК Аналитика2,
		|	ВерсииЗначенийПоказателей.Аналитика3 КАК Аналитика3,
		|	ВерсииЗначенийПоказателей.Аналитика4 КАК Аналитика4,
		|	ВерсииЗначенийПоказателей.Аналитика5 КАК Аналитика5,
		|	ВерсииЗначенийПоказателей.Аналитика6 КАК Аналитика6,
		|	ВерсииЗначенийПоказателей.АналитикаВалюта КАК АналитикаВалюта,
		|	ВерсииЗначенийПоказателей.Значение КАК ЗначениеНечисловое"+ТекстАналитик+"
		|ИЗ
		|	втЛогИзмененныхПоказателейНечисловые КАК ВерсииЗначенийПоказателей"+ТекстОтбора+"
		|;
		|
		|/////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВерсииЗначенийПоказателей.НомерТранзакции) КАК НомерТранзакции,
		|	ВерсииЗначенийПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ВерсииЗначенийПоказателей.Показатель КАК Показатель,
		|	ВерсииЗначенийПоказателей.Аналитика1 КАК Аналитика1,
		|	ВерсииЗначенийПоказателей.Аналитика2 КАК Аналитика2,
		|	ВерсииЗначенийПоказателей.Аналитика3 КАК Аналитика3,
		|	ВерсииЗначенийПоказателей.Аналитика4 КАК Аналитика4,
		|	ВерсииЗначенийПоказателей.Аналитика5 КАК Аналитика5,
		|	ВерсииЗначенийПоказателей.Аналитика6 КАК Аналитика6,
		|	ВерсииЗначенийПоказателей.АналитикаВалюта КАК АналитикаВалюта"+ТекстАналитик+"
		|ПОМЕСТИТЬ втМаксимальныйНомерТранзакцииНечисловых_"+УИДГруппыОтборовСтрока+"_ИТОГ_"+ТекстИтоговоеЗначение+"
		|ИЗ
		|	втЗначенияНечисловых_"+УИДГруппыОтборовСтрока+"_ИТОГ_"+ТекстИтоговоеЗначение+" КАК ВерсииЗначенийПоказателей
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсииЗначенийПоказателей.ПериодОтчета,
		|	ВерсииЗначенийПоказателей.Показатель,
		|	ВерсииЗначенийПоказателей.Аналитика1,
		|	ВерсииЗначенийПоказателей.Аналитика2,
		|	ВерсииЗначенийПоказателей.Аналитика3,
		|	ВерсииЗначенийПоказателей.Аналитика4,
		|	ВерсииЗначенийПоказателей.Аналитика5,
		|	ВерсииЗначенийПоказателей.Аналитика6,
		|	ВерсииЗначенийПоказателей.АналитикаВалюта"+ТекстАналитикГруппировка;

	КонецЕсли;
	
	#КонецОбласти
	
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	#КонецОбласти
	
КонецПроцедуры

Процедура ДобавитьПодзапросЗначенийПоказателей(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов)
	
	тРасшифровкаГруппОтборов		= СтруктураПараметровТекущегоУровня.тРасшифровкаГруппОтборов;
	тРасшифровкаГруппОтборовВерсии	= СтруктураПараметровТекущегоУровня.тРасшифровкаГруппОтборовВерсии;
	тИспользуемыеАналитики			= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	ТекстРесурсы					= СтруктураПараметровТекущегоУровня.ТекстРесурсы;
	ФильтрПоИзмененнымЗначениям		= СтруктураПараметровТекущегоУровня.ФильтрПоИзмененнымЗначениям;
	мПодзапросыДанных				= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тПараметрыПакета				= СтруктураПараметровТекущегоУровня.тПараметрыПакета;
	ТипПараметрическойНастройки		= СтруктураПараметровТекущегоУровня.ТипПараметрическойНастройки;	
	
	УИДГруппыОтборов				= СтрКэшГруппОтборов.УИДГруппыОтборов;
	УИДГруппыОтборовВерсии			= СтрКэшГруппОтборов.УИДГруппыОтборовВерсии;
	Показатели						= СтрКэшГруппОтборов.Показатели;	
	ИндексРегистра					= СтрКэшГруппОтборов.ИндексРегистра;
	
	#Область ТекстЗамены
	
	// УИД группы отборов
	УИДГруппыОтборовСтрока = Формат(УИДГруппыОтборов,"ЧН=0; ЧГ=0");
	УИДГруппыОтборовВерсииСтрока = Формат(УИДГруппыОтборовВерсии,"ЧН=0; ЧГ=0");
	
	// Текст отбора по регистру
	ТекстОтбораРегистр	= ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов, тПараметрыПакета, УИДГруппыОтборов);
	ТекстОтбораРегистр	= СтрЗаменить(ТекстОтбораРегистр,"#ИмяТаблицы","ЗначенияПоказателей");
	ТекстОтбора			= СтрЗаменить(ТекстОтбораРегистр,"#ИмяТаблицы","ЗначенияПоказателей");
	ТекстОтбораЛог		= СтрЗаменить(СтрЗаменить(ТекстОтбораРегистр,"Версия.",""),"#ИмяТаблицы","ЗначенияПоказателей");
	
	// Текст отбора по версиям
	ТекстОтбораВерсии = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборовВерсии, тПараметрыПакета, УИДГруппыОтборовВерсии);
	ТекстОтбораВерсии = СтрЗаменить(ТекстОтбораВерсии,"#ИмяТаблицы","ЗначенияПоказателей");
	
	// Текст отбор по показателям
	НОтбор					= тПараметрыПакета.Добавить();
	НОтбор.ИмяОтбора		= "ОтборПоказатели_" + УИДГруппыОтборовСтрока + СтрЗаменить(Формат(ИндексРегистра,"ЧН=0; ЧГ=0"),"-","_");
	НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НОтбор.УИДГруппыОтбора	= УИДГруппыОтборов;
	Если Показатели.Количество() = 1 Тогда
		ТекстОтборПоказатели = "= &" + НОтбор.ИмяОтбора;
		НОтбор.ЗначениеОтбора = Показатели.Получить(0);
	Иначе
		ТекстОтборПоказатели = "В (&" + НОтбор.ИмяОтбора + ")";
		НОтбор.ЗначениеОтбора = Показатели;
	КонецЕсли;
	
	// Текст по ресурсам
	ТекстРесурсы = СтрЗаменить(ТекстРесурсы, "#ИмяТаблицы", "ЗначенияПоказателей");

	#КонецОбласти
	
	#Область ТекстЗаменыАналитик

	ТекстАналитики = "";
	ТекстАналитикиВерсии = "";
	ТекстПоляВерсии = "";
	ТекстПоля = "";
	ТекстСоединенияАналитик = "";
	
	Если ИндексРегистра = -1 ИЛИ ИндексРегистра = -11 Тогда
		ЧислоАналитик = ПараметрыСеанса.ЧислоДопАналитик;
	Иначе
		ЧислоАналитик = ИндексРегистра;
	КонецЕсли;
	
	Для Каждого СтрАналитика Из тИспользуемыеАналитики Цикл
		
		ПолеСиноним = СтрЗаменить(СтрАналитика.Поле,".","");
		Если ПолеСиноним = "ПериодОтчета" Тогда
			Продолжить;	
		ИначеЕсли ПолеСиноним = "АналитикаВалюта" Тогда
			Если ИндексРегистра = 0 Тогда
				// Это синтетика
				ТекстАналитики = ТекстАналитики + ",
				|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта";
			Иначе
				ТекстСоединенияАналитик = ТекстСоединенияАналитик + "
				|			И ЗначенияПоказателей.АналитикаВалюта = #ИмяТаблицы.АналитикаВалюта"; 
				ТекстАналитики = ТекстАналитики + ",
				|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта";
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(ПолеСиноним, "Аналитика") Тогда
			Инд = Число(Сред(ПолеСиноним, СтрДлина("Аналитика")+1, 1));
			Если ЧислоАналитик < Инд Тогда
				ТекстАналитики = ТекстАналитики + ",
				|	НЕОПРЕДЕЛЕНО КАК " + ПолеСиноним;
			Иначе
				Если СтрАналитика.ПолеВерсии Тогда
					ТекстАналитикиВерсии = ТекстАналитикиВерсии + ",
					|	#ИмяТаблицы." + СтрАналитика.Поле + " КАК " + ПолеСиноним;
				Иначе
					ТекстАналитики = ТекстАналитики + ",
					|	ЗначенияПоказателей." + СтрАналитика.Поле + " КАК " + ПолеСиноним;
					ТекстСоединенияАналитик = ТекстСоединенияАналитик + "
					|			И ЗначенияПоказателей." + СтрАналитика.Поле + " = #ИмяТаблицы." + ПолеСиноним;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрАналитика.ПолеВерсии Тогда 
			ТекстПоляВерсии = ТекстПоляВерсии + ",
			|	#ИмяТаблицы." + СтрАналитика.Поле + " КАК " + ПолеСиноним;
		Иначе
			ТекстПоля = ТекстПоля + ",
			|	ЗначенияПоказателей." + СтрАналитика.Поле + " КАК " + ПолеСиноним;
		КонецЕсли;
		
	КонецЦикла;

	ТекстАналитикиВерсииЛог		= СтрЗаменить(ТекстАналитикиВерсии,		"#ИмяТаблицы", "ЗначенияПоказателей");
	ТекстАналитикиВерсии		= СтрЗаменить(ТекстАналитикиВерсии,		"#ИмяТаблицы", "ВерсииПоказателей");
	ТекстПоляВерсииЛог			= СтрЗаменить(ТекстПоляВерсии,			"#ИмяТаблицы", "ЗначенияПоказателей");
	ТекстПоляВерсии				= СтрЗаменить(ТекстПоляВерсии,			"#ИмяТаблицы", "ВерсииПоказателей");
	ТекстСоединенияАналитикЛог	= СтрЗаменить(ТекстСоединенияАналитик,	"#ИмяТаблицы", "ЛогИзмененныхПоказателей");
	ТекстСоединенияАналитик		= СтрЗаменить(ТекстСоединенияАналитик,	"#ИмяТаблицы", "НовыеЗначенияПоказателей");	
	
	#КонецОбласти
	
	#Область ТекстЗаменыРежимУстановкиПоказателей
	
	// Отбор по режиму установки значений показателей
	Если ФильтрПоИзмененнымЗначениям Тогда
	
		ТекстФильтрПоИзмененнымЗначениям = ",
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ЗначенияПоказателей.Показатель,
		|				ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики+"
		|			ИЗ втЗначенияПотребителейРасчет КАК ЗначенияПоказателей) КАК НовыеЗначенияПоказателей
		|			ПО ЗначенияПоказателей.Показатель = НовыеЗначенияПоказателей.Показатель
		|			И ВерсииПоказателей.ПериодОтчета = НовыеЗначенияПоказателей.ПериодОтчета"+ТекстСоединенияАналитик;
		
		ТекстФильтрПоИзмененнымЗначениямЛог = СтрЗаменить(ТекстФильтрПоИзмененнымЗначениям, "ВерсииПоказателей", "ЗначенияПоказателей");
	
	Иначе
		ТекстФильтрПоИзмененнымЗначениям = "";
		ТекстФильтрПоИзмененнымЗначениямЛог = "";
	КонецЕсли;
		
	#КонецОбласти
	
	#Область ТекстЗапроса
	
	Если ИндексРегистра = -1 ИЛИ ИндексРегистра = -11 Тогда
		// Это нечисловые значения. По ним срез по версиям не агрегируется. Просто берем последнюю версию.
		
		// Текст итоговое значение
		ТекстИтоговоеЗначение = ?(ИндексРегистра = -11, "ИСТИНА", "ЛОЖЬ");
		
		// Текст ресурсов
		ТекстРесурсы = СтрЗаменить(ТекстРесурсы, "ЗначенияПоказателей.Значение КАК","0 КАК");
		
		// Текст запроса
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+УИДГруппыОтборовСтрока+" КАК УИДГруппыОтборов,
		|	ЗначенияПоказателей.Показатель КАК Показатель, 
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитикиВерсииЛог+ТекстПоляВерсииЛог+ТекстАналитики+ТекстПоля+ТекстРесурсы+"
		|ИЗ
		|	втЗначенияНечисловых_"+УИДГруппыОтборовВерсииСтрока+"_ИТОГ_"+ТекстИтоговоеЗначение+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерТранзакцииНечисловых_"+УИДГруппыОтборовВерсииСтрока+"_ИТОГ_"+ТекстИтоговоеЗначение+" КАК МаксимальныйНомерТранзакции
		|			ПО ЗначенияПоказателей.НомерТранзакции = МаксимальныйНомерТранзакции.НомерТранзакции
		|			И ЗначенияПоказателей.ПериодОтчета = МаксимальныйНомерТранзакции.ПериодОтчета
		|			И ЗначенияПоказателей.Показатель = МаксимальныйНомерТранзакции.Показатель
		|			И ЗначенияПоказателей.Аналитика1 = МаксимальныйНомерТранзакции.Аналитика1
		|			И ЗначенияПоказателей.Аналитика2 = МаксимальныйНомерТранзакции.Аналитика2
		|			И ЗначенияПоказателей.Аналитика3 = МаксимальныйНомерТранзакции.Аналитика3
		|			И ЗначенияПоказателей.Аналитика4 = МаксимальныйНомерТранзакции.Аналитика4
		|			И ЗначенияПоказателей.Аналитика5 = МаксимальныйНомерТранзакции.Аналитика5
		|			И ЗначенияПоказателей.Аналитика6 = МаксимальныйНомерТранзакции.Аналитика6
		|			И ЗначенияПоказателей.АналитикаВалюта = МаксимальныйНомерТранзакции.АналитикаВалюта"+ТекстФильтрПоИзмененнымЗначениямЛог+"
		|
		|ГДЕ
		|	НЕ (ЗначенияПоказателей.НомерТранзакции < 10000000000 И ЗначенияПоказателей.ЗначениеНечисловое = НЕОПРЕДЕЛЕНО)
		|	И ЗначенияПоказателей.Показатель "+ТекстОтборПоказатели+ТекстОтбора;
		
	Иначе
		
		// Прочие режимы заполнения
		ТекстСоединение = "";
		ТекстПериод = "ЗначенияПоказателей.ПериодОтчета";
		ТекстСвязьЭлиминации = "";
		
		Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.СвернувПоПериоду Тогда
			
			ТекстСоединение = "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСоответствиеПериодов_СверткаПоПериоду КАК СоответствиеПериодов
			|		ПО ЗначенияПоказателей.ПериодОтчета = СоответствиеПериодов.ПериодИсходный";
			ТекстПериод = "СоответствиеПериодов.ПериодОтчета";
			
		ИначеЕсли ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Консолидация
			ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.КонсолидацияПропорционально
			ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
			
			ТекстСоединение = "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОрганизацииПериметра КАК ВерсииПоказателей
			|		ПО ЗначенияПоказателей.Организация = ВерсииПоказателей.Организация";
			ТекстРесурсы = СтрЗаменить(ТекстРесурсы, "ЗначенияПоказателей.Значение КАК", 
				"ВЫРАЗИТЬ(ЗначенияПоказателей.Значение * ВерсииПоказателей.Коэффициент КАК ЧИСЛО(18,5)) КАК");

		КонецЕсли;
		
		Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
			
			НомерАналитикиВГО = СтрРазделить(СтрКэшГруппОтборов.ХешГруппыОтборов, "@")[1];
			ТекстСвязьЭлиминации = УправлениеРабочимиПроцессамиУХ.ТекстСвязи_АналитикаВГО(
				"ЗначенияПоказателей", "ВерсииПоказателей", НомерАналитикиВГО);
			
			ТекстСоединение = ТекстСоединение + ТекстСвязьЭлиминации;
			
		КонецЕсли;
		
		// Текст ресурсы 
		ТекстРесурсы = СтрЗаменить(ТекстРесурсы, "ЗначенияПоказателей.ЗначениеНечисловое КАК","НЕОПРЕДЕЛЕНО КАК");
		
		// Текст имя таблицы регистра
		Если ИндексРегистра = -2 Тогда
			// Валютные
			ИмяТаблицыРегистра = "ЗначенияПоказателейОтчетовВалютные";
		ИначеЕсли ИндексРегистра = 0 Тогда
			// Синтетика
			ИмяТаблицыРегистра = "ЗначенияПоказателейОтчетовСинтетика";
		Иначе
			// Значения показателей N
			ИмяТаблицыРегистра = "ЗначенияПоказателейОтчетов"+ИндексРегистра;
		КонецЕсли;
		
		Если ЭтоРасшифровка И ТипЗнч(ОбъектРасчета) = Тип("Структура")
			И ОбъектРасчета.Свойство("РасчетныеВалютныеПоказатели")
			И СтруктураПараметровТекущегоУровня.ФильтрПоИзмененнымЗначениям = Истина Тогда
			ТекстОтбора = ТекстОтбора + " И ЛОЖЬ";
		КонецЕсли;
		
		// Текст запроса
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+УИДГруппыОтборовСтрока+" КАК УИДГруппыОтборов,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	"+ТекстПериод+" КАК ПериодОтчета"+ТекстАналитикиВерсииЛог+ТекстПоляВерсииЛог+ТекстАналитики+ТекстПоля+ТекстРесурсы+"
		|ИЗ
		|	втЛогИзмененныхПоказателей КАК ЗначенияПоказателей"+ТекстФильтрПоИзмененнымЗначениямЛог+ТекстСоединение+"
		|
		|ГДЕ
		|	ЗначенияПоказателей.Показатель "+ТекстОтборПоказатели+ТекстОтбораВерсии+ТекстОтбораЛог+"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	"+УИДГруппыОтборовСтрока+" КАК УИДГруппыОтборов,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ВерсииПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитикиВерсии+ТекстПоляВерсии+ТекстАналитики+ТекстПоля+ТекстРесурсы+"
		|ИЗ
		|	РегистрСведений."+ИмяТаблицыРегистра+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсииПоказателей_"+УИДГруппыОтборовВерсииСтрока+" КАК ВерсииПоказателей
		|			ПО ЗначенияПоказателей.Версия = ВерсииПоказателей.Версия"+ ТекстСвязьЭлиминации +ТекстФильтрПоИзмененнымЗначениям+"
		|
		|ГДЕ
		|	ЗначенияПоказателей.Показатель "+ТекстОтборПоказатели+ТекстОтбора;
		
	КонецЕсли;
	
	мПодзапросыДанных.Добавить(ТекстЗапроса);
	
	#КонецОбласти
	
КонецПроцедуры

Процедура ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей, ИмяТаблицы = "втПоказателиРаскрытия0", ТипПараметрическойНастройки=Неопределено)
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тКэшГруппОтборовПоказателей		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПоказателей;
	тКэшГруппОтборовВерсии			= СтруктураРасчетаПоказателей.тКэшГруппОтборовВерсии;
	тКэшГруппОтборовПериодов		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПериодов;
	
	// Подготовим структуру параметров для расчета текущего уровня
	СтруктураПараметровТекущегоУровня = Новый Структура;
	СтруктураПараметровТекущегоУровня.Вставить("тРасшифровкаГруппОтборов",		СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов);
	СтруктураПараметровТекущегоУровня.Вставить("тРасшифровкаГруппОтборовВерсии",СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии);
	СтруктураПараметровТекущегоУровня.Вставить("ТекстРесурсы",					ТекстПолейРесурсов(СтруктураРасчетаПоказателей.тИспользуемыеРесурсы,0));
	СтруктураПараметровТекущегоУровня.Вставить("тИспользуемыеАналитики",		СтруктураРасчетаПоказателей.тИспользуемыеАналитики.Скопировать(Новый Структура("УровеньРасчета",0)));
	СтруктураПараметровТекущегоУровня.Вставить("ТипПараметрическойНастройки",	ТипПараметрическойНастройки);
	СтруктураПараметровТекущегоУровня.Вставить("ФильтрПоИзмененнымЗначениям",	Ложь);

	мПодзапросыДанных = Новый Массив;
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанных", мПодзапросыДанных);
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакета", ОписаниеТаблицыПараметров());
	
	мПодзапросыДанныхВТ = Новый Массив;
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанныхВТ", мПодзапросыДанныхВТ);
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ", ОписаниеТаблицыПараметров());
	
	#Область ВнутренниеДанные
	
	// Подготовим данные для получения внутренних данных для разной периодичности
	Если СтруктураРасчетаПоказателей.тВнутренниеДанные.Количество() > 0 Тогда
		
		СоответствиеОпераций = Новый Соответствие;
		СоответствиеОпераций.Вставить(Перечисления.ВидыОперацийРасчетаПоказателей.ВнутренниеДанныеПериодичность, Неопределено);
		СоответствиеОпераций.Вставить(Перечисления.ВидыОперацийРасчетаПоказателей.ВнутренниеДанныеПериодичностьНеделя, Перечисления.Периодичность.Неделя);
		СоответствиеОпераций.Вставить(Перечисления.ВидыОперацийРасчетаПоказателей.ВнутренниеДанныеПериодичностьДевятьМесяцев, Перечисления.Периодичность.ДевятьМесяцев);
	
		Для Каждого КлючЗначение Из СоответствиеОпераций Цикл
			
			мПодзапросыДанных.Очистить();
			СтруктураПараметровТекущегоУровня.Вставить("Периодичность", КлючЗначение.Значение);
		
			// Запросы для получения данных из регистров и справочников
			ДобавитьЗапросПоВнутреннимДанным(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);

			// Добавим запросы по временным таблицам в таблицу пересчета показателей
			Если мПодзапросыДанныхВТ.Количество() Тогда
				нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
				нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ИтоговыйТекстПодзапросовВТ(мПодзапросыДанныхВТ);
				нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ВРЕМЕННЫЕ ТАБЛИЦЫ ДЛЯ ПОЛУЧЕНИЯ ВНУТРЕННИХ ДАННЫХ'");
				нСтрокаТаблицыЗапросов.тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
				нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= КлючЗначение.Ключ;
				мПодзапросыДанныхВТ.Очистить();
				СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ", ОписаниеТаблицыПараметров());
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ВнешниеТаблицы
	
	// Запросы для получения данных из произвольного запроса
	ДобавитьПодзапросПоПроизвольномуЗапросу(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
	
	// Запросы для получения данных рассчитанных произвольным кодом
	ДобавитьПодзапросПоПроизвольномуКоду(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
	
	// Запросы для получения данных из внешних источников
	ДобавитьПодзапросПоИсточникуВнешнему(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
	
	// Добавим запросы по временным таблицам в таблицу пересчета показателей
	Если мПодзапросыДанныхВТ.Количество() Тогда
		нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
		нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ИтоговыйТекстПодзапросовВТ(мПодзапросыДанныхВТ);
		нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ВРЕМЕННЫЕ ТАБЛИЦЫ ДЛЯ ПОЛУЧЕНИЯ ДАННЫХ ВНЕШНИХ ТАБЛИЦ'");
		нСтрокаТаблицыЗапросов.тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
		нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ВнешниеТаблицы;
		мПодзапросыДанныхВТ.Очистить();
		СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ",ОписаниеТаблицыПараметров());
	КонецЕсли;
	
	#КонецОбласти
	
	#Область СоответствияПериодов
	
	// Получим параметры для построения таблиц соответствия периодов
	Для Каждого СтрКэшГруппОтборов Из тКэшГруппОтборовПериодов Цикл
		ДобавитьПодзапросСоответствияПериодов(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
	КонецЦикла;

	// Добавим запросы по таблицам соответствия периодов
	Если СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ.Количество() Тогда
		нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
		нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ТАБЛИЦЫ СООТВЕТСТВИЯ ПЕРИОДОВ'");
		нСтрокаТаблицыЗапросов.тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
		нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.СоответствиеПериодов;
		СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ", ОписаниеТаблицыПараметров());
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ПрочиеРежимыЗаполнения
	
	// Добавим запрос для режима свертки по периоду
	Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.СвернувПоПериоду Тогда
		ДобавитьПодзапросСоответствияПериодовПриСверткеПоПериоду(СтруктураПараметровТекущегоУровня);
	ИначеЕсли ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Консолидация
		ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.КонсолидацияПропорционально
		ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
		ДобавитьПодзапросОрганизацийПериметра(СтруктураПараметровТекущегоУровня);
	КонецЕсли;
		
	#КонецОбласти
	
	#Область ВерсииПоказателей
		
	// Получим текст запроса для версий показателей	
	Для Каждого СтрКэшГруппОтборов Из тКэшГруппОтборовВерсии Цикл
		Если ЗначениеЗаполнено(СтрКэшГруппОтборов.ВидыОтчетов) Тогда
			ДобавитьПодзапросТекущейВерсии(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
		КонецЕсли;
	КонецЦикла;
	
	// Добавим запросы по версиям в таблицу пересчета показателей
	Если мПодзапросыДанныхВТ.Количество() Тогда
		нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
		нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ИтоговыйТекстПодзапросовВТ(мПодзапросыДанныхВТ);
		нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ВЕРСИИ ЗНАЧЕНИЙ ПОКАЗАТЕЛЕЙ'");
		нСтрокаТаблицыЗапросов.тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
		нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеЗначенийОперандов;
		мПодзапросыДанныхВТ.Очистить();
		СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ",ОписаниеТаблицыПараметров());
	КонецЕсли;
	
	#КонецОбласти

	#Область ЗначенияОперандов
	
	Для Каждого СтрКэшГруппОтборов Из тКэшГруппОтборовПоказателей Цикл
		Если ЗначениеЗаполнено(СтрКэшГруппОтборов.Показатели) Тогда
			ДобавитьПодзапросЗначенийПоказателей(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьЗапросВТаблицуПересчетаПоказателей(
		мПодзапросыДанных,
		СтруктураПараметровТекущегоУровня.тПараметрыПакета,
		ИмяТаблицы,
		глТаблицаПересчетаПоказателей,
		Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеЗначенийОперандов,
		НСтр("ru = 'ЗАПРОС ДЛЯ ПОДЪЕМА ОПЕРАНДОВ УРОВНЯ - 0'"));
		
	#КонецОбласти
	
	// Пересчет в основную валюту
	Если СтруктураРасчетаПоказателей.ПересчитатьВОсновнуюВалюту Тогда
		ДобавитьЗапросПересчетаВОсновнуюВалюту(СтруктураРасчетаПоказателей);
	КонецЕсли;
	
	// Трансформация данных текущего уровня
	ДобавитьЗапросТрансформацииТекущегоУровня(СтруктураРасчетаПоказателей, 0);
	
КонецПроцедуры

Процедура ДобавитьЗапросТрансформацииТекущегоУровня(СтруктураРасчетаПоказателей, УровеньРасчета, РекурсивныйРасчетПериодов=Ложь)
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тПоказателиОперанды				= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	тИспользуемыеАналитики			= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы			= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	тРасшифровкаГруппОтборов		= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	МаксУровеньРучныхРасчетов		= СтруктураРасчетаПоказателей.МаксУровеньРучныхРасчетов;
	ЕстьДополненияАналитик			= СтруктураРасчетаПоказателей.ЕстьДополненияАналитик;	
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;

	// Получим итоговые показатели
	тГруппыИтоговыхПоказателейТекущегоУровня = тПоказателиОперанды.Скопировать(Новый Структура("УровеньРасчетаОперанда",УровеньРасчета+1));
	Если УровеньРасчета = 0 Тогда		
		тГруппыИтоговыхПоказателей = тГруппыИтоговыхПоказателейТекущегоУровня.Скопировать(,"ТрансформацияПолей,УИДГруппыОтборовПериодов");
		тГруппыИтоговыхПоказателей.Свернуть("ТрансформацияПолей,УИДГруппыОтборовПериодов");		
	Иначе
		тГруппыИтоговыхПоказателей = тГруппыИтоговыхПоказателейТекущегоУровня.Скопировать(,"УИДГруппыОтборов,УИДГруппыОтборовПериодов,УИДГруппыТрансформации");
		тГруппыИтоговыхПоказателей.Свернуть("УИДГруппыОтборов,УИДГруппыОтборовПериодов,УИДГруппыТрансформации");		
	КонецЕсли;
	Если тГруппыИтоговыхПоказателей.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	// Переменные
	тПараметрыПакета		= ОписаниеТаблицыПараметров();
	мПодзапросыДанных		= Новый Массив;
	УровеньРасчетаСтрока	= Формат(УровеньРасчета,"ЧН=0; ЧГ=0");
	
	// Тексты аналитик и ресурсов	
	ТекстРесурсовПолей = ТекстПолейРесурсов(тИспользуемыеРесурсы,УровеньРасчета,2) + ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчета+1,2,Истина);
	ТекстРесурсовПолей = СтрЗаменить(ТекстРесурсовПолей,"#ИмяТаблицы","ПоказателиРаскрытия"); 
	
	// Тексты группировок аналитик и ресурсов
	ТекстРесурсовПолейГруппировка = ТекстПолейРесурсов(тИспользуемыеРесурсы,УровеньРасчета,3) + ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчета+1,3,Истина);; 
	ТекстРесурсовПолейГруппировка = СтрЗаменить(ТекстРесурсовПолейГруппировка,"#ИмяТаблицы","ПоказателиРаскрытия");
	
	Для Каждого СтрГруппа Из тГруппыИтоговыхПоказателей Цикл
		
		#Область ТекстЗамены
		
		// Получим показатели текущей группы
		Если УровеньРасчета = 0 Тогда
			ПоказателиТекущейГруппы = тГруппыИтоговыхПоказателейТекущегоУровня.Скопировать(
				Новый Структура("ТрансформацияПолей,УИДГруппыОтборовПериодов",СтрГруппа.ТрансформацияПолей,СтрГруппа.УИДГруппыОтборовПериодов),"КодВФормуле").ВыгрузитьКолонку("КодВФормуле");
			ТрансформацияПолей = СтрГруппа.ТрансформацияПолей;
		Иначе
			ПоказателиТекущейГруппы = тГруппыИтоговыхПоказателейТекущегоУровня.Скопировать(
				Новый Структура("УИДГруппыОтборов,УИДГруппыОтборовПериодов,УИДГруппыТрансформации",СтрГруппа.УИДГруппыОтборов,СтрГруппа.УИДГруппыОтборовПериодов,СтрГруппа.УИДГруппыТрансформации),"ПоказательОперанд").ВыгрузитьКолонку("ПоказательОперанд");
			ТрансформацияПолей = тГруппыИтоговыхПоказателейТекущегоУровня.Найти(СтрГруппа.УИДГруппыТрансформации,"УИДГруппыТрансформации").ТрансформацияПолей;			
		КонецЕсли;
		
		// Установим отбор по показателям
		НОтбор					= тПараметрыПакета.Добавить();
		НОтбор.ИмяОтбора		= "ОтборПоказателейДляТрансформации_"+СтрЗаменить(Новый УникальныйИдентификатор,"-","");
		НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		НОтбор.ЗначениеОтбора	= ПоказателиТекущейГруппы;
		ТекстОтборПоказателей	= НОтбор.ИмяОтбора;
		
		// Если необходимо, добавим соединение с таблицей соответствия периодов
		Если СтрГруппа.УИДГруппыОтборовПериодов > 0 Тогда
			ТекстПериод = "СоответствиеПериодов.ПериодОтчета";
			ТекстСоединениеСТаблицейПериодов = "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСоответствиеПериодов_" + Формат(СтрГруппа.УИДГруппыОтборовПериодов,"ЧН=0; ЧГ=0") + " КАК СоответствиеПериодов
			|		ПО ПоказателиРаскрытия.ПериодОтчета = СоответствиеПериодов.ПериодИсточник
			|		И НЕ СоответствиеПериодов.ПериодОтчета = ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)";
		Иначе
			ТекстПериод = "ПоказателиРаскрытия.ПериодОтчета";
			ТекстСоединениеСТаблицейПериодов = "";
		КонецЕсли;
		
		#КонецОбласти
		
		#Область ТекстЗаменыАналитик
				
		// Подготовим текст по аналитикам
		СтруктураИспользуемыхАналитик = Новый Структура;
		Для Инд = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
			СтруктураИспользованияПолей = Новый Структура;
			СтруктураИспользованияПолей.Вставить("ТекстАналитик",",
			|	НЕОПРЕДЕЛЕНО КАК Аналитика"+Инд);
			СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик","");
			СтруктураИспользуемыхАналитик.Вставить("Аналитика"+Инд,СтруктураИспользованияПолей);			
		КонецЦикла;
		Если ЕстьАналитикаВалюта Тогда
			СтруктураИспользованияПолей = Новый Структура;
			СтруктураИспользованияПолей.Вставить("ТекстАналитик",",
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта");
			СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик","");
			СтруктураИспользуемыхАналитик.Вставить("АналитикаВалюта",СтруктураИспользованияПолей);
		КонецЕсли;
		
		СоединениеДругиеИсточники = "";
		ОперандСДополнениемАналитикВыбранПредварительно = Ложь;
		ОперандСДополнениемАналитикВДругомПериоде = Ложь;
		Если ЗначениеЗаполнено(ТрансформацияПолей) Тогда
			
			ПравилаИспользованияАналитик = СтрРазделить(ТрансформацияПолей,";",Ложь);
			
			Для Каждого СтрПравило Из ПравилаИспользованияАналитик Цикл
					
				ЗначенияПравилИспользованияПолей = СтрРазделить(СтрПравило,"@");
				ТипОтбора = ЗначенияПравилИспользованияПолей[0];
				ЗначениеОтбора = ЗначенияПравилИспользованияПолей[1];
				ИмяОтбора = ЗначенияПравилИспользованияПолей[2];
				
				Если ТипОтбора = "ПолеИсходнойТаблицы" Тогда
					
					ТекстАналитик = ",
					|	ПоказателиРаскрытия."+СтрЗаменить(ЗначениеОтбора,".","")+" КАК "+ИмяОтбора;
					
					ТекстГруппировкиАналитик = ",
					|	ПоказателиРаскрытия."+СтрЗаменить(ЗначениеОтбора,".","");
					
					СтруктураИспользованияПолей = Новый Структура;
					СтруктураИспользованияПолей.Вставить("ТекстАналитик",ТекстАналитик);
					СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик",ТекстГруппировкиАналитик);
					СтруктураИспользуемыхАналитик.Вставить(ИмяОтбора,СтруктураИспользованияПолей);
					
				ИначеЕсли ТипОтбора = "ФиксированноеЗначение" Тогда
					
					нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
						Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,
						ЗначениеИзСтрокиВнутр(СтрЗаменить(ЗначениеОтбора,".","")),
						ИмяОтбора);
						
					ТекстАналитик = ",
					|	&" + нПараметр.ИмяОтбора + " КАК " + ИмяОтбора;
					
					СтруктураИспользованияПолей = Новый Структура;
					СтруктураИспользованияПолей.Вставить("ТекстАналитик",ТекстАналитик);
					СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик","");
					СтруктураИспользуемыхАналитик.Вставить(ИмяОтбора,СтруктураИспользованияПолей);
					
				ИначеЕсли ТипОтбора = "КонтекстОбъектаЗагрузки" Тогда
					
					нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
						"КонтекстВызоваЗаполнения",
						ЗначениеОтбора,
						ИмяОтбора);
				
					ТекстАналитик = ",
					|	&" + нПараметр.ИмяОтбора + " КАК " + ИмяОтбора;
					
					СтруктураИспользованияПолей = Новый Структура;
					СтруктураИспользованияПолей.Вставить("ТекстАналитик",ТекстАналитик);
					СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик","");
					СтруктураИспользуемыхАналитик.Вставить(ИмяОтбора,СтруктураИспользованияПолей);
					
				ИначеЕсли ТипОтбора = "ПолеДругогоИсточникаДанных" Тогда
					
					Показатель = ЗначениеИзСтрокиВнутр(СтрЗаменить(ЗначениеОтбора,".",""));
					нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
						Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,
						Показатель,
						"Показатель");
						
					ОперандИсточник = тПоказателиОперанды.Найти(ЗначенияПравилИспользованияПолей[4], "КодВФормуле");
					
					УровеньРасчетаИсточник = Число(ЗначенияПравилИспользованияПолей[3])-1;
					Если УровеньРасчетаИсточник > УровеньРасчета Тогда
						// Ситуация, когда данные поднимаются для временного расчета
						// Не поддерживаем, пока просто пропускаем
						Продолжить;
					ИначеЕсли УровеньРасчетаИсточник = УровеньРасчета Тогда
						ТаблицаИсточник = "втПоказателиРаскрытия" + УровеньРасчетаИсточник;
						ОтборПоУИДу = "";
					Иначе 
						ТаблицаИсточник = "втЗначенияОперандов" + УровеньРасчетаИсточник;
						Если УровеньРасчетаИсточник = 0 Тогда
							ОтборПоУИДу = "
							|			И ЗначенияОперандов.КодВФормуле = """ + ?(ОперандИсточник.ДляДополненияАналитик,"",ЗначенияПравилИспользованияПолей[4]) + """"; 
						Иначе
							ОтборПоУИДу = "
							|			И ЗначенияОперандов.УИДГруппыОтборов = " + Формат(ЗначенияПравилИспользованияПолей[5],"ЧН=0; ЧГ=0") + "
							|			И ЗначенияОперандов.УИДГруппыТрансформации = " + Формат(ЗначенияПравилИспользованияПолей[6],"ЧН=0; ЧГ=0");
						КонецЕсли;
					КонецЕсли;
					
					// Возможно в операнде дополнения аналитик тоже есть смещение периода
					ОтборПоУИДуПериодов = ЗначенияПравилИспользованияПолей[7];
					Если ОтборПоУИДуПериодов <> "0" И УровеньРасчетаИсточник = УровеньРасчета Тогда
						// Смещение периода происходит на том же уровне расчета, что и дополнение аналитик
						ТекстПериодДругиеИсточники = "СоответствиеПериодов.ПериодОтчета";
						ТекстСоединениеСТаблицейПериодовДругиеИсточники = "
						|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСоответствиеПериодов_" + ОтборПоУИДуПериодов + " КАК СоответствиеПериодов
						|			ПО ЗначенияОперандов.ПериодОтчета = СоответствиеПериодов.ПериодИсточник
						|				И НЕ СоответствиеПериодов.ПериодОтчета = ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)";
					Иначе
						ТекстПериодДругиеИсточники = "ЗначенияОперандов.ПериодОтчета";
						ТекстСоединениеСТаблицейПериодовДругиеИсточники = "";
					КонецЕсли;
					
					// Найдем текст трансформации полей источника данных
					Если ТаблицаИсточник = "втПоказателиРаскрытия0" Тогда
						// Необходимо выполнить трансформацию аналитик
						ТекстПолученияАналитики = ТекстПолученияАналитики(ОперандИсточник.ТрансформацияПолей, ИмяОтбора, тПараметрыПакета);
					Иначе
						// Трансформация аналитик была выполнена на соответствующем уровне расчета
						ТекстПолученияАналитики = "ЗначенияОперандов."+СтрЗаменить(ИмяОтбора,".","")+" КАК "+ИмяОтбора;
					КонецЕсли; 
						
					СоединениеДругиеИсточники = СоединениеДругиеИсточники + "
						|	ЛЕВОЕ СОЕДИНЕНИЕ 
						|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
						|			"+ТекстПериодДругиеИсточники+" КАК ПериодОтчета,
						|			"+ТекстПолученияАналитики+ "
						|		ИЗ
						|			"+ТаблицаИсточник+" КАК ЗначенияОперандов"+ТекстСоединениеСТаблицейПериодовДругиеИсточники+"
						|		ГДЕ
						|			ЗначенияОперандов.Показатель = &"+нПараметр.ИмяОтбора+ОтборПоУИДу+") КАК ПоказателиРаскрытияДругиеИсточники_"+ИмяОтбора+"
						|		ПО ПоказателиРаскрытияДругиеИсточники_" + ИмяОтбора + ".ПериодОтчета = ПоказателиРаскрытия.ПериодОтчета";
				
					ТекстАналитик = ",
					|	ISNULL(ПоказателиРаскрытияДругиеИсточники_" + ИмяОтбора + "."+ИмяОтбора+",НЕОПРЕДЕЛЕНО) КАК "+ИмяОтбора;
					
					ТекстГруппировкиАналитик = ",
					|	ISNULL(ПоказателиРаскрытияДругиеИсточники_" + ИмяОтбора + "."+ИмяОтбора+",НЕОПРЕДЕЛЕНО)";
					
					СтруктураИспользованияПолей = Новый Структура;
					СтруктураИспользованияПолей.Вставить("ТекстАналитик",ТекстАналитик);
					СтруктураИспользованияПолей.Вставить("ТекстГруппировкиАналитик",ТекстГруппировкиАналитик);
					СтруктураИспользуемыхАналитик.Вставить(ИмяОтбора,СтруктураИспользованияПолей);
					
					Если УровеньРасчета = 0 Тогда
						
						Если СтрГруппа.УИДГруппыОтборовПериодов > 0 Тогда
							СоединениеДругиеИсточники = СтрЗаменить(СоединениеДругиеИсточники,
								"ПоказателиРаскрытия.ПериодОтчета", "СоответствиеПериодов.ПериодОтчета");
						КонецЕсли;
						
					Иначе
						
						Отбор = Новый Структура("ПоказательОперанд, ВременныйРасчет", ПоказателиТекущейГруппы[0], Истина);
						СтрокиВременногоРасчета = тПоказателиОперанды.НайтиСтроки(Отбор);
						Если ЗначениеЗаполнено(СтрокиВременногоРасчета) 
							И (СтрокиВременногоРасчета[0].ВариантРасчета = 4 ИЛИ СтрокиВременногоРасчета[0].ВариантРасчета = 3) Тогда
							
							ОперандСДополнениемАналитикВыбранПредварительно = Истина;
							УровеньДанныхОперандаСДополнениемАналитик = СтрокиВременногоРасчета[0].УровеньРасчетаОперанда - 1;
							Если СтрокиВременногоРасчета[0].УИДГруппыОтборовПериодов > 0 Тогда
								ОперандСДополнениемАналитикВДругомПериоде = Истина;
							КонецЕсли;
							
							Если РекурсивныйРасчетПериодов Тогда
								СоединениеДругиеИсточники = СтрЗаменить(СоединениеДругиеИсточники, ТаблицаИсточник + " ", ТаблицаИсточник + "_#ИндексПериода ");
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ТекстАналитикРесурсов				= ТекстРесурсовПолей;
		ТекстАналитикРесурсовГруппировка	= ТекстРесурсовПолейГруппировка;
		Для Каждого СтрАналитика Из СтруктураИспользуемыхАналитик Цикл
			ТекстАналитикРесурсов				= ТекстАналитикРесурсов + СтрАналитика.Значение.ТекстАналитик;
			ТекстАналитикРесурсовГруппировка	= ТекстАналитикРесурсовГруппировка + СтрАналитика.Значение.ТекстГруппировкиАналитик;
		КонецЦикла;
		
		#КонецОбласти
		
		#Область ТекстЗапроса
		
		// Тексты запросов
		Если УровеньРасчета = 0 Тогда
			
			// Текст код в формуле
			Если ЕстьДополненияАналитик Тогда
				КодВФормуле = "ВЫБОР
				|		КОГДА ПоказателиОперанды.ДляДополненияАналитик 
				|			ТОГДА """"
				|		ИНАЧЕ ПоказателиОперанды.КодВФормуле
				|	КОНЕЦ";
			Иначе
				КодВФормуле = "ПоказателиОперанды.КодВФормуле";
			КонецЕсли;
			
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	"+КодВФормуле+" КАК КодВФормуле,
			|	ПоказателиРаскрытия.Показатель КАК Показатель,
			|	"+ТекстПериод+" КАК ПериодОтчета "+ТекстАналитикРесурсов+"
			|ИЗ
			|	втПоказателиРаскрытия0 КАК ПоказателиРаскрытия
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиОперанды0 КАК ПоказателиОперанды
			|		ПО ПоказателиРаскрытия.Показатель = ПоказателиОперанды.ПоказательОперанд
			|			И ПоказателиРаскрытия.УИДГруппыОтборов = ПоказателиОперанды.УИДГруппыОтборов
			|	" + ТекстСоединениеСТаблицейПериодов + СоединениеДругиеИсточники + "
			|
			|ГДЕ 
			|	ПоказателиОперанды.КодВФормуле В (&"+ТекстОтборПоказателей+")
			|
			|СГРУППИРОВАТЬ ПО
			|	"+КодВФормуле+",
			|	ПоказателиРаскрытия.Показатель,
			|	"+ТекстПериод+ТекстАналитикРесурсовГруппировка;
			
		Иначе
			
			Если РекурсивныйРасчетПериодов Тогда
				ТекстИндексПериода = "_#ИндексПериода"
			Иначе
				ТекстИндексПериода = "";
			КонецЕсли;
			
			// Текст отбора
			ТекстОтбора = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов,тПараметрыПакета,СтрГруппа.УИДГруппыОтборов);
			ТекстОтбора = СтрЗаменить(ТекстОтбора,"#ИмяТаблицы","ПоказателиРаскрытия");
			
			УровеньДанныхОперанда = УровеньРасчетаСтрока;
			ТаблицаДанныхОперанда = "втПоказателиРаскрытия";
			Если ОперандСДополнениемАналитикВыбранПредварительно Тогда
				УровеньДанныхОперанда = УровеньДанныхОперандаСДополнениемАналитик;
				Если УровеньДанныхОперанда = 0 Тогда
					ТекстИндексПериода = "";
				КонецЕсли;
				Если ОперандСДополнениемАналитикВДругомПериоде Тогда
					ТаблицаДанныхОперанда = "втЗначенияОперандов";
					ТекстПериод = "ПоказателиРаскрытия.ПериодОтчета";
					ТекстСоединениеСТаблицейПериодов = "";
				КонецЕсли;
			КонецЕсли;
			
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	"+Формат(СтрГруппа.УИДГруппыОтборов,"ЧН=0; ЧГ=0")+" КАК УИДГруппыОтборов,
			|	"+Формат(СтрГруппа.УИДГруппыТрансформации,"ЧН=0; ЧГ=0")+" КАК УИДГруппыТрансформации,
			|	ПоказателиРаскрытия.Показатель КАК Показатель,
			|	"+ТекстПериод+" КАК ПериодОтчета"+ТекстАналитикРесурсов+"
			|ИЗ
			|	" + ТаблицаДанныхОперанда + УровеньДанныхОперанда + ТекстИндексПериода + " КАК ПоказателиРаскрытия
			|	"+СоединениеДругиеИсточники+ТекстСоединениеСТаблицейПериодов+"
			|
			|ГДЕ 
			|	ПоказателиРаскрытия.Показатель В (&"+ТекстОтборПоказателей+")
			|	"+ТекстОтбора+"
			|
			|СГРУППИРОВАТЬ ПО
			|	ПоказателиРаскрытия.Показатель,
			|	"+ТекстПериод+ТекстАналитикРесурсовГруппировка;
			
		КонецЕсли;
		
		// Добавим подзапрос в таблицу
		мПодзапросыДанных.Добавить(ТекстЗапроса);
		
		#КонецОбласти
	
	КонецЦикла;
	
	#Область ДобавлениеЗапросаВПакет
	
	Если РекурсивныйРасчетПериодов Тогда
		
		ДобавитьЗапросВТаблицуПересчетаПоказателей(
			мПодзапросыДанных,
			тПараметрыПакета,
			"втЗначенияОперандов" + УровеньРасчетаСтрока + "_#ИндексПериода",
			глТаблицаПересчетаПоказателей,
			Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандовЗависимыхПоПериоду,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'ПОДГОТОВЛЕННЫЕ ДАННЫЕ ОПЕРАНДОВ УРОВНЯ - %1, ПЕРИОД - %2'"), УровеньРасчетаСтрока, "#ИндексПериода"),
			УровеньРасчета <= МаксУровеньРучныхРасчетов);
			
		// Добавим в текст последнего запроса объединение таблиц
		нСтрокаТаблицыЗапросов = глТаблицаПересчетаПоказателей.Получить(
			глТаблицаПересчетаПоказателей.Количество()-1);
		нСтрокаТаблицыЗапросов.ТекстПодзапросов = ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов(нСтрокаТаблицыЗапросов.ТекстПодзапросов) + "
			|ВЫБРАТЬ *
			|ИЗ
			|	втЗначенияОперандов"+УровеньРасчетаСтрока+" КАК ЗначенияПоказателей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втЗначенияОперандов"+УровеньРасчетаСтрока+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ *
			|ПОМЕСТИТЬ втЗначенияОперандов"+УровеньРасчетаСтрока+"
			|ИЗ
			|	втЗначенияОперандов"+УровеньРасчетаСтрока+"_#ИндексПериода
			|";
	Иначе
		
		ДобавитьЗапросВТаблицуПересчетаПоказателей(
			мПодзапросыДанных,
			тПараметрыПакета,
			"втЗначенияОперандов" + УровеньРасчетаСтрока,
			глТаблицаПересчетаПоказателей,
			Перечисления.ВидыОперацийРасчетаПоказателей.ТрансформацияОперандов,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'ПОДГОТОВЛЕННЫЕ ДАННЫЕ ОПЕРАНДОВ УРОВНЯ - %1'"), УровеньРасчетаСтрока),
			УровеньРасчета < МаксУровеньРучныхРасчетов);
			
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыГенерацииЗапросовРегистровИСправочниковВнутр

////////////////////////////////////////////////////////////////////////////////
// Процедуры для подготовки текстов запросов для подъема данных из регистров и справочников
//
////////////////////////////////////////////////////////////////////////////////

Процедура ДобавитьТаблицуПериодов(СтруктураПараметров)
	
	тПараметрыПакетаВТ	= СтруктураПараметров.тПараметрыПакетаВТ;
	мПодзапросыДанныхВТ	= СтруктураПараметров.мПодзапросыДанныхВТ;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Периоды.ДатаНачала КАК ДатаНачала,
		|	КОНЕЦПЕРИОДА(Периоды.ДатаОкончания, ДЕНЬ) КАК ДатаОкончания,
		|	Периоды.Ссылка КАК ПериодОтчета
		|ПОМЕСТИТЬ втПериоды
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Периодичность = &ПериодичностьОтчета
		|	И НЕ Периоды.Произвольный
		|	И НЕ Периоды.ПометкаУдаления
		|	И Периоды.ДатаНачала МЕЖДУ &НачалоПериодаОтчета И &КонецПериодаОтчета";

	// Добавим временную таблицу с периодами
	Если мПодзапросыДанныхВТ.Количество() = 0 
		ИЛИ мПодзапросыДанныхВТ.Получить(0) <> ТекстЗапроса Тогда
	
		мПодзапросыДанныхВТ.Вставить(0, ТекстЗапроса);
		
		ДобавитьПараметрВПакет(тПараметрыПакетаВТ, Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета,,"НачалоПериодаОтчета");
		ДобавитьПараметрВПакет(тПараметрыПакетаВТ, Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета,,"КонецПериодаОтчета");
		ДобавитьПараметрВПакет(тПараметрыПакетаВТ, "ПериодичностьОтчета",,"ПериодичностьОтчета");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстНачалоПериода(СтрокаДата, Периодичность = Неопределено)
	
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		
		Возврат 
		"ВЫБОР 
		|	КОГДА НАЧАЛОПЕРИОДА(" + СтрокаДата + ", НЕДЕЛЯ) < НАЧАЛОПЕРИОДА(" + СтрокаДата + ", МЕСЯЦ)
		|		ТОГДА НАЧАЛОПЕРИОДА(" + СтрокаДата + ", МЕСЯЦ) 
		|	ИНАЧЕ 
		|		НАЧАЛОПЕРИОДА(" + СтрокаДата + ", НЕДЕЛЯ)
		|КОНЕЦ";
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.ДевятьМесяцев Тогда
		
		Возврат "НАЧАЛОПЕРИОДА(" + СтрокаДата + ", ГОД)";
		
	ИначеЕсли ЗначениеЗаполнено(Периодичность) Тогда
		
		Возврат "НАЧАЛОПЕРИОДА(" + СтрокаДата + ", " + Строка(Периодичность) + ")";
		
	Иначе
		
		Возврат "НАЧАЛОПЕРИОДА(" + СтрокаДата + ", #ПериодичностьОтчета)";
		
	КонецЕсли;
	
КонецФункции

Функция ТекстКонецПериода(СтрокаДата, Периодичность = Неопределено)
	
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		
		Возврат 
		"ВЫБОР 
		|	КОГДА КОНЕЦПЕРИОДА(" + СтрокаДата + ", НЕДЕЛЯ) > КОНЕЦПЕРИОДА(" + СтрокаДата + ", МЕСЯЦ)
		|		ТОГДА КОНЕЦПЕРИОДА(" + СтрокаДата + ", МЕСЯЦ) 
		|	ИНАЧЕ 
		|		КОНЕЦПЕРИОДА(" + СтрокаДата + ", НЕДЕЛЯ)
		|КОНЕЦ";
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.ДевятьМесяцев Тогда
		
		Возврат "ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(" + СтрокаДата + ", ГОД), МЕСЯЦ, -3)";
		
	ИначеЕсли ЗначениеЗаполнено(Периодичность) Тогда
		
		Возврат "КОНЕЦПЕРИОДА(" + СтрокаДата + ", " + Строка(Периодичность) + ")";
		
	Иначе
		
		Возврат "КОНЕЦПЕРИОДА(" + СтрокаДата + ", #ПериодичностьОтчета)";
		
	КонецЕсли;
	
КонецФункции

Функция ТекстДобавитьКДате(СтрокаДата, Периодичность, УточнениеСпособаОпределения)
	
	Если УточнениеСпособаОпределения = Неопределено Тогда
		ТекстЗначениеСдвига = "0";
	Иначе
		ТекстЗначениеСдвига = Формат(УточнениеСпособаОпределения,"ЧН=0; ЧГ=0");
	КонецЕсли;

	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		
		Возврат 
		"ВЫБОР
		|	КОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), МЕСЯЦ) 
		|		< НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), НЕДЕЛЯ), МЕСЯЦ)
		|		ТОГДА НАЧАЛОПЕРИОДА( КОНЕЦПЕРИОДА (ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), НЕДЕЛЯ), МЕСЯЦ)
		|	КОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), МЕСЯЦ) 
		|		> НАЧАЛОПЕРИОДА(НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), НЕДЕЛЯ), МЕСЯЦ)
		|		ТОГДА КОНЕЦПЕРИОДА(НАЧАЛОПЕРИОДА( ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + "), НЕДЕЛЯ), МЕСЯЦ) 
		|	ИНАЧЕ ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", НЕДЕЛЯ, " + ТекстЗначениеСдвига + ")
		|КОНЕЦ";
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.ДевятьМесяцев Тогда
		
		Возврат "ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", ГОД, " + ТекстЗначениеСдвига + ")";
		
	ИначеЕсли ЗначениеЗаполнено(Периодичность) Тогда
		
		Возврат "ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", " + Строка(Периодичность) + ", " + ТекстЗначениеСдвига + ")";
		
	Иначе
		
		Возврат "ДОБАВИТЬКДАТЕ(" + СтрокаДата + ", #ПериодичностьОтчета, " + ТекстЗначениеСдвига + ")";		
		
	КонецЕсли;
	
КонецФункции

Функция ПривестиПериод(СтрокаДата, Периодичность, СпособВычисленияПараметра, Знач УточнениеСпособаОпределения, ПривестиКНачалуПериода = Ложь)
	
	Если СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета Тогда
		
		Возврат ТекстНачалоПериода(СтрокаДата, Периодичность);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета Тогда
		
		Если ПривестиКНачалуПериода Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета,УточнениеСпособаОпределения);
		КонецЕсли;
		
		Возврат ТекстКонецПериода(СтрокаДата, Периодичность);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода Тогда
		
		Если УточнениеСпособаОпределения = Неопределено Тогда
			Возврат ТекстНачалоПериода(СтрокаДата, Периодичность);
		Иначе
			Возврат ТекстНачалоПериода(СтрокаДата, УточнениеСпособаОпределения);
		КонецЕсли;
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода Тогда	
		
		Если ПривестиКНачалуПериода Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода,УточнениеСпособаОпределения);
		КонецЕсли;
		
		Если УточнениеСпособаОпределения = Неопределено Тогда
			Возврат ТекстКонецПериода(СтрокаДата, Периодичность);
		Иначе
			Возврат ТекстКонецПериода(СтрокаДата, УточнениеСпособаОпределения);
		КонецЕсли;
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода Тогда
		
		Возврат ТекстНачалоПериода(СтрокаДата, Перечисления.Периодичность.Год);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода Тогда
		
		Если ПривестиКНачалуПериода Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода,УточнениеСпособаОпределения);
		КонецЕсли;
		
		Возврат ТекстКонецПериода(СтрокаДата, Перечисления.Периодичность.Год);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом Тогда
		
		Если УточнениеСпособаОпределения = Неопределено ИЛИ УточнениеСпособаОпределения = 0 Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета,УточнениеСпособаОпределения);
		КонецЕсли;

		Возврат ТекстНачалоПериода(ТекстДобавитьКДате(СтрокаДата, Периодичность, УточнениеСпособаОпределения), Периодичность);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом Тогда
		
		Если ПривестиКНачалуПериода Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом,УточнениеСпособаОпределения);
		КонецЕсли;
		
		Если УточнениеСпособаОпределения = Неопределено ИЛИ УточнениеСпособаОпределения = 0 Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета,УточнениеСпособаОпределения);
		КонецЕсли;
			
		Возврат ТекстКонецПериода(ТекстДобавитьКДате(СтрокаДата, Периодичность, УточнениеСпособаОпределения), Периодичность);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом Тогда
		
		Если УточнениеСпособаОпределения = Неопределено ИЛИ УточнениеСпособаОпределения = 0 Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода,УточнениеСпособаОпределения);
		КонецЕсли;
	
		Возврат ТекстДобавитьКДате(ТекстНачалоПериода(СтрокаДата, Перечисления.Периодичность.Год), Перечисления.Периодичность.Год, УточнениеСпособаОпределения);
		
	ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом Тогда
		
		Если ПривестиКНачалуПериода Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом,УточнениеСпособаОпределения);;
		КонецЕсли;
		
		Если УточнениеСпособаОпределения = Неопределено ИЛИ УточнениеСпособаОпределения = 0 Тогда
			Возврат ПривестиПериод(СтрокаДата,Периодичность,Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода,УточнениеСпособаОпределения);
		КонецЕсли;
				
		Возврат ТекстДобавитьКДате(ТекстКонецПериода(СтрокаДата, Перечисления.Периодичность.Год), Перечисления.Периодичность.Год, УточнениеСпособаОпределения);
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

Функция ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД)
	
	// Номер записи
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		СД.Вставить("НомерЗаписи", ",
		|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи");
		СД.Вставить("ТекстНумерацияПериодов", "
		|		ЛЕВОЕ СОЕДИНЕНИЕ втНумерацияПериодов_"+СД.УИД+" КАК НумерацияПериодов
		|		ПО ТаблицаДанных.ПериодОтчета = НумерацияПериодов.ПериодОтчета "+СД.ТекстАналитикиСоединениеНумерация);
	Иначе
		СД.Вставить("НомерЗаписи", "");
		СД.Вставить("ТекстНумерацияПериодов", "");
	КонецЕсли;
	
	// Сформируем тексты запросов
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления Тогда
		
		Если ДанныеДляРасчета.Свойство("ЕстьОстатки") Тогда
			
			ТекстЗапросаВТ = "
			|ВЫБРАТЬ
			|	Периоды.ДатаНачала КАК ДатаНачала,
			|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+СД.НомерЗаписи+"
			|ПОМЕСТИТЬ втДанныеРегистра_"+СД.УИД+"
			|ИЗ
			|	втПериоды КАК Периоды
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления."+СД.ИмяТаблицы+".ОстаткиИОбороты("+СД.ТекстОтборДатаНач+","+СД.ТекстОтборДатаКон+","+СД.ПериодичностьОтчета+",,
			|		"+СД.ТекстОтборВТ+") КАК ТаблицаДанных
			|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
			
			Если Периодичность = Перечисления.Периодичность.Неделя Тогда
				ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначения.РазделительПакетаЗапросов() + "
				|ВЫБРАТЬ 
				|	МАКСИМУМ(ТаблицаДанных.НомерЗаписи) КАК МаксНомерЗаписи,
				|	МИНИМУМ(ТаблицаДанных.НомерЗаписи) КАК МинНомерЗаписи,
				|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+"
				|ПОМЕСТИТЬ втНумерацияПериодов_"+СД.УИД+"
				|ИЗ 
				|	втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаДанных.ПериодОтчета"+СД.ТекстАналитикиГруппировка;
			КонецЕсли;
			
			ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначения.РазделительПакетаЗапросов() + "
			|ВЫБРАТЬ
			|	МаксимальныеНеПустыеПериоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсыОстатки+"
			|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
			|ИЗ
			|	(ВЫБРАТЬ
			|		МАКСИМУМ(ТаблицаДанных.ДатаНачала) КАК ДатаНачала,
			|		Данные.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+"
			|	ИЗ
			|		втДанныеРегистра_"+СД.УИД+" КАК Данные
			|			ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|			ПО Данные.ДатаНачала >= ТаблицаДанных.ДатаНачала
			|	ГДЕ "+СД.ТекстРесурсыУсловиеНО+"
			|	
			|	СГРУППИРОВАТЬ ПО
			|		Данные.ПериодОтчета"+СД.ТекстАналитикиГруппировка+") КАК МаксимальныеНеПустыеПериоды
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|		ПО ТаблицаДанных.ДатаНачала = МаксимальныеНеПустыеПериоды.ДатаНачала"+СД.ТекстАналитикиСоединение+СД.ТекстНумерацияПериодов;
			
			Если ДанныеДляРасчета.Свойство("ЕстьОбороты") Тогда
				ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов() + "
				|ВЫБРАТЬ
				|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсыОбороты+"
				|ИЗ
				|	втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных";
			КонецЕсли;
			
		Иначе
			
			Если ДанныеДляРасчета.ОсновнаяТаблицаРегистра Тогда
				
				Если ДанныеДляРасчета.ВидРегистраИсточникаДанных = "Остатки" Тогда
					
					ТекстЗапросаВТ = "
					|ВЫБРАТЬ
					|	Периоды.ПериодОтчета КАК ПериодОтчета,
					|	ТаблицаДанных.ВидДвижения КАК ВидДвижения" + СД.ТекстАналитики + СД.ТекстРесурсы + "
					|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
					|ИЗ
					|	втПериоды КАК Периоды
					|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления."+СД.ИмяТаблицы+" КАК ТаблицаДанных
					|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтбор+СД.ТекстОтборПериод;
					
				Иначе
					
					ТекстЗапросаВТ = "
					|ВЫБРАТЬ
					|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
					|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
					|ИЗ
					|	втПериоды КАК Периоды
					|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления."+СД.ИмяТаблицы+" КАК ТаблицаДанных
					|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтбор+СД.ТекстОтборПериод;
					
				КонецЕсли;
				
			Иначе
			
				ТекстЗапросаВТ = "
				|ВЫБРАТЬ
				|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
				|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
				|ИЗ
				|	втПериоды КАК Периоды
				|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления."+СД.ИмяТаблицы+".Обороты("+СД.ТекстОтборДатаНач+","+СД.ТекстОтборДатаКон+","+СД.ПериодичностьОтчета+",
				|		"+СД.ТекстОтборВТ+") КАК ТаблицаДанных
				|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
				
			КонецЕсли;
				
		КонецЕсли;
			
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
		
		Если ДанныеДляРасчета.Свойство("ЕстьОстатки") Тогда
			
			МетодДополнения = "";
			Если НЕ (ДанныеДляРасчета.Свойство("ЕстьОбороты") ИЛИ Периодичность = Перечисления.Периодичность.Неделя) Тогда
				МетодДополнения = "Движения";
			КонецЕсли;
			
			ТекстЗапросаВТ = "
			|ВЫБРАТЬ
			|	ПоказателиСчета.НомерСреза КАК НомерСреза,
			|	ПоказателиСчета.Показатель КАК Показатель,
			|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
			|	ПоказателиСчета.Счет КАК Счет
			|ПОМЕСТИТЬ втПоказателиСчета_"+СД.УИД+"
			|	ИЗ &ПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета
			|;
			|
			|/////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаДанных.Счет КАК Счет,
			|	ТаблицаДанных.Период КАК Период"+СД.ТекстАналитики+СД.ТекстРесурсы+"
			|ПОМЕСТИТЬ втДанныеРегистраИсходные_"+СД.УИД+"
			|ИЗ
			|	РегистрБухгалтерии."+СД.ИмяТаблицы+".ОстаткиИОбороты("+СД.ТекстОтборДатаНач+", "+СД.ТекстОтборДатаКон+", "
					+ СД.ПериодичностьОтчета + "," + МетодДополнения + ",
			|		Счет В (&Счета_"+СД.УИД+"), , "+СД.ТекстОтборВТ+") КАК ТаблицаДанных
			|;
			|
			|/////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Счета.Счет КАК Счет,
			|	Периоды.ДатаНачала КАК ДатаНачала,
			|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсы+СД.НомерЗаписи+"
			|ПОМЕСТИТЬ втДанныеРегистра_"+СД.УИД+"
			|ИЗ
			|	втПериоды КАК Периоды
			|	ЛЕВОЕ СОЕДИНЕНИЕ (
			|		ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			Счета.Счет
			|		ИЗ втДанныеРегистраИсходные_"+СД.УИД+" КАК Счета) КАК Счета
			|		ПО ИСТИНА
			|	ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистраИсходные_"+СД.УИД+" КАК ТаблицаДанных
			|		ПО ТаблицаДанных.Счет = Счета.Счет 
			|		И "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
			
			Если Периодичность = Перечисления.Периодичность.Неделя Тогда
				ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначения.РазделительПакетаЗапросов() + "
				|ВЫБРАТЬ 
				|	МАКСИМУМ(ТаблицаДанных.НомерЗаписи) КАК МаксНомерЗаписи,
				|	МИНИМУМ(ТаблицаДанных.НомерЗаписи) КАК МинНомерЗаписи,
				|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+"
				|ПОМЕСТИТЬ втНумерацияПериодов_"+СД.УИД+"
				|ИЗ 
				|	втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаДанных.ПериодОтчета"+СД.ТекстАналитикиГруппировка;
			КонецЕсли;
			
			Если ДанныеДляРасчета.Свойство("ЕстьОбороты") ИЛИ Периодичность = Перечисления.Периодичность.Неделя Тогда
				
				ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначения.РазделительПакетаЗапросов() + "
				|ВЫБРАТЬ
				|	ТаблицаДанных.Счет,
				|	МаксимальныеНеПустыеПериоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсыОстатки+"
				|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
				|ИЗ
				|	(ВЫБРАТЬ
				|		МАКСИМУМ(ТаблицаДанных.ДатаНачала) КАК ДатаНачала,
				|		Данные.Счет КАК Счет,
				|		Данные.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+"
				|	ИЗ
				|		втДанныеРегистра_"+СД.УИД+" КАК Данные
				|			ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
				|			ПО Данные.Счет = ТаблицаДанных.Счет 
				|			И Данные.ДатаНачала >= ТаблицаДанных.ДатаНачала
				|	ГДЕ "+СД.ТекстРесурсыУсловиеНО+"
				|	
				|	СГРУППИРОВАТЬ ПО
				|		Данные.Счет,
				|		Данные.ПериодОтчета"+СД.ТекстАналитикиГруппировка+") КАК МаксимальныеНеПустыеПериоды
				|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
				|		ПО ТаблицаДанных.Счет = МаксимальныеНеПустыеПериоды.Счет
				|		И ТаблицаДанных.ДатаНачала = МаксимальныеНеПустыеПериоды.ДатаНачала"+СД.ТекстАналитикиСоединение+СД.ТекстНумерацияПериодов;
				
				Если ДанныеДляРасчета.Свойство("ЕстьОбороты") Тогда
					ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов() + "
					|ВЫБРАТЬ
					|	ТаблицаДанных.Счет,
					|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсыОбороты+" 
					|ИЗ
					|	втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных";
				КонецЕсли;
				
			Иначе // Только остатки
				
				ТекстАналитикиВТ_Остатки = СтрЗаменить(СД.ТекстАналитикиВТ, "ТаблицаДанных", "Данные");
				ТекстРесурсыУсловиеНО_Остатки = СтрЗаменить(СД.ТекстРесурсыУсловиеНО, "ТаблицаДанных", "Данные");
				ТекстАналитикиГруппировка_Остатки = СтрЗаменить(СД.ТекстАналитикиГруппировка, "ТаблицаДанных", "Данные");
				
				ТекстОстатки = "
				|ВЫБРАТЬ
				|	ТаблицаДанных.Счет,
				|	МаксимальныеНеПустыеПериоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсыОстатки+"
				|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
				|ИЗ
				|	(ВЫБРАТЬ
				|		МАКСИМУМ(Данные.ДатаНачала) КАК ДатаНачала,
				|		Данные.Счет КАК Счет,
				|		Данные.ПериодОтчета КАК ПериодОтчета"+ТекстАналитикиВТ_Остатки+"
				|	ИЗ
				|		втДанныеРегистра_"+СД.УИД+" КАК Данные
				|	ГДЕ "+ТекстРесурсыУсловиеНО_Остатки+"
				|	
				|	СГРУППИРОВАТЬ ПО
				|		Данные.Счет,
				|		Данные.ПериодОтчета"+ТекстАналитикиГруппировка_Остатки+") КАК МаксимальныеНеПустыеПериоды
				|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
				|		ПО ТаблицаДанных.Счет = МаксимальныеНеПустыеПериоды.Счет
				|		И ТаблицаДанных.ДатаНачала = МаксимальныеНеПустыеПериоды.ДатаНачала"+СД.ТекстАналитикиСоединение+СД.ТекстНумерацияПериодов;
				
				ТекстЗапросаВТ = ТекстЗапросаВТ + ОбщегоНазначения.РазделительПакетаЗапросов() + ТекстОстатки;
				
			КонецЕсли;
			
		Иначе
			
			Если ДанныеДляРасчета.КорреспонденцияСчетов Тогда
				
				Если ДанныеДляРасчета.ОтборПоРегистратору Тогда
					ТекстЗапросаВТ = "
					|ВЫБРАТЬ
					|	ПоказателиСчета.НомерСреза КАК НомерСреза,
					|	ПоказателиСчета.Показатель КАК Показатель,
					|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
					|	ПоказателиСчета.Счет КАК Счет,
					|	ПоказателиСчета.КоррСчет КАК КоррСчет
					|ПОМЕСТИТЬ втПоказателиСчета_"+СД.УИД+"
					|	ИЗ &ПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета
					|;
					|
					|/////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТаблицаДанных.СчетДт КАК Счет,
					|	ТаблицаДанных.СчетКт КАК КоррСчет,
					|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
					|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
					|ИЗ
					|	втПериоды КАК Периоды
					|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии."+СД.ИмяТаблицы+".ДвиженияССубконто("+СД.ТекстОтборДатаНач+", "+СД.ТекстОтборДатаКон+",
					|		СчетДт В (&Счета_"+СД.УИД+") И СчетКт В (&СчетаКт_"+СД.УИД+") И "+СД.ТекстОтборВТ+") КАК ТаблицаДанных
					|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
				Иначе
					ТекстЗапросаВТ = "
					|ВЫБРАТЬ
					|	ПоказателиСчета.НомерСреза КАК НомерСреза,
					|	ПоказателиСчета.Показатель КАК Показатель,
					|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
					|	ПоказателиСчета.Счет КАК Счет,
					|	ПоказателиСчета.КоррСчет КАК КоррСчет
					|ПОМЕСТИТЬ втПоказателиСчета_"+СД.УИД+"
					|	ИЗ &ПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета
					|;
					|
					|/////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТаблицаДанных.СчетДт КАК Счет,
					|	ТаблицаДанных.СчетКт КАК КоррСчет,
					|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
					|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
					|ИЗ
					|	втПериоды КАК Периоды
					|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии."+СД.ИмяТаблицы+".ОборотыДтКт("+СД.ТекстОтборДатаНач+", "+СД.ТекстОтборДатаКон+", "+СД.ПериодичностьОтчета+",
					|		СчетДт В (&Счета_"+СД.УИД+"), , СчетКт В (&СчетаКт_"+СД.УИД+"), , "+СД.ТекстОтборВТ+") КАК ТаблицаДанных
					|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
				КонецЕсли;
				
			ИначеЕсли ДанныеДляРасчета.УчитыватьКоррСчета Тогда
				
				Если ДанныеДляРасчета.ДтКт = "Дт" Тогда
					СтрокаСчет = "СчетДт";
					СтрокаКоррСчет = "СчетКт";
				Иначе
					СтрокаСчет = "СчетКт";
					СтрокаКоррСчет = "СчетДт";
				КонецЕсли;
				
				ТекстЗапросаВТ = "
				|ВЫБРАТЬ
				|	ПоказателиСчета.НомерСреза КАК НомерСреза,
				|	ПоказателиСчета.Показатель КАК Показатель,
				|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
				|	ПоказателиСчета.Счет КАК Счет
				|ПОМЕСТИТЬ втПоказателиСчета_"+СД.УИД+"
				|	ИЗ &ПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета
				|;
				|
				|/////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТаблицаДанных."+СтрокаСчет+" КАК Счет,
				|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
				|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
				|ИЗ
				|	втПериоды КАК Периоды
				|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии."+СД.ИмяТаблицы+".ДвиженияССубконто("+СД.ТекстОтборДатаНач+", "+СД.ТекстОтборДатаКон+",
				|		"+СтрокаСчет+" В (&Счета_"+СД.УИД+") И "+СД.ТекстОтборВТ+") КАК ТаблицаДанных
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБД
				|		ПО (СчетаБД.Владелец = &ПланСчетов_"+СД.УИД+" И ТаблицаДанных."+СтрокаКоррСчет+".Код = СчетаБД.Код)
				|	ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;
				
			Иначе
				
				ТекстЗапросаВТ = "
				|ВЫБРАТЬ
				|	ПоказателиСчета.НомерСреза КАК НомерСреза,
				|	ПоказателиСчета.Показатель КАК Показатель,
				|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
				|	ПоказателиСчета.Счет КАК Счет
				|ПОМЕСТИТЬ втПоказателиСчета_"+СД.УИД+" 
				|	ИЗ &ПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета
				|;
				|
				|/////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТаблицаДанных.Счет КАК Счет,
				|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
				|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
				|ИЗ
				|	втПериоды КАК Периоды
				|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии."+СД.ИмяТаблицы+".Обороты("+СД.ТекстОтборДатаНач+", "+СД.ТекстОтборДатаКон+", "+СД.ПериодичностьОтчета+",
				|		Счет В (&Счета_"+СД.УИД+"), , "+СД.ТекстОтборВТ+", ,) КАК ТаблицаДанных
				|		ПО "+СД.ТекстПериодСоединение+СД.ТекстОтборПериод;

			КонецЕсли;
				
		КонецЕсли;
	
	КонецЕсли;

	Возврат ТекстЗапросаВТ;

КонецФункции

Функция ТекстЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, тПараметрыПакетаВТ, СД)

	// Найдем условия вычисления периода регистра даты начала
	ПараметрПериодДН = ДанныеДляРасчета.ТаблицаПараметровОтбораБД.Найти("ДатаНач","ПолеБД");
	Если ПараметрПериодДН = Неопределено Тогда
		Если ДанныеДляРасчета.ОсновнаяТаблицаРегистра Тогда
			ПараметрПериодДН = Новый Структура;
			ПараметрПериодДН.Вставить("СпособВычисленияПараметра", Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется);
		Иначе
			ТекстОшибки = НСтр("ru = 'Не найден обязательный отбор ""ДатаНач""'");
			ВызватьИсключение(ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПараметрПериодДН.СпособВычисленияПараметра) Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнен способ вычисления параметра для отбора ""ДатаНач""'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
		
	// Найдем условия вычисления периода регистра даты окончания
	ПараметрПериодДК = ДанныеДляРасчета.ТаблицаПараметровОтбораБД.Найти("ДатаКон","ПолеБД");
	Если ПараметрПериодДК = Неопределено Тогда
		Если ДанныеДляРасчета.ОсновнаяТаблицаРегистра Тогда
			ПараметрПериодДК = Новый Структура;
			ПараметрПериодДК.Вставить("СпособВычисленияПараметра", Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется);
		Иначе
			ТекстОшибки = НСтр("ru = 'Не найден обязательный отбор ""ДатаКон""'");
			ВызватьИсключение(ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПараметрПериодДК.СпособВычисленияПараметра) Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнен способ вычисления параметра для отбора ""ДатаКон""'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
		
	// Сформируем текст соединения с таблицей Периоды
	Если Периодичность = Перечисления.Периодичность.Неделя
		И (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета)
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
		И НЕ ЗначениеЗаполнено(ПараметрПериодДН.УточнениеСпособаОпределения))
		ИЛИ (ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода
		И НЕ ЗначениеЗаполнено(ПараметрПериодДК.УточнениеСпособаОпределения))) Тогда
		
		СтруктураОтбора = Новый Структура;
		
		// Вычислить дату начала периода отчета в запросе не получится
		Если ПараметрПериодДН.СпособВычисленияПараметра <> Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
				ПараметрПериодДН.СпособВычисленияПараметра, ПараметрПериодДН.УточнениеСпособаОпределения, ПараметрПериодДН.ПолеБД);
			СД.Вставить("ТекстОтборДатаНач", "&" + нПараметр.ИмяОтбора);
			СтруктураОтбора.Вставить("ДатаНач", Новый Структура("ТипОтбора, ЗначениеОтбора", ПараметрПериодДН.СпособВычисленияПараметра, ПараметрПериодДН.УточнениеСпособаОпределения));
		КонецЕсли;
		Если ПараметрПериодДК.СпособВычисленияПараметра <> Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
				ПараметрПериодДК.СпособВычисленияПараметра, ПараметрПериодДК.УточнениеСпособаОпределения, ПараметрПериодДК.ПолеБД);
			СД.Вставить("ТекстОтборДатаКон", "&" + нПараметр.ИмяОтбора);
			СтруктураОтбора.Вставить("ДатаКон", Новый Структура("ТипОтбора, ЗначениеОтбора", ПараметрПериодДК.СпособВычисленияПараметра, ПараметрПериодДК.УточнениеСпособаОпределения));
		КонецЕсли;
		СД.Вставить("ПериодичностьОтчета", "ДЕНЬ");
		
		НПараметр = тПараметрыПакетаВТ.Добавить();
		НПараметр.ИмяОтбора = "Периоды_" + СД.УИД;
		НПараметр.ТипОтбора = "ПериодыСоСдвигом";
		НПараметр.ЗначениеОтбора = СтруктураОтбора;
		
		// Соединение с таблицей периодов
		СД.Вставить("ТекстПериодСоединение",
			"ТаблицаДанных.Период >= Периоды.ДатаНачалаСдвиг И КОНЕЦПЕРИОДА(ТаблицаДанных.Период, ДЕНЬ) <= Периоды.ДатаОкончанияСдвиг");
			
		ТекстЗапросаВТ =
			"ВЫБРАТЬ
			|	Периоды.ДатаНачала КАК ДатаНачала,
			|	Периоды.ДатаОкончания КАК ДатаОкончания,
			|	Периоды.ПериодОтчета КАК ПериодОтчета,
			|	Периоды.ДатаНачалаСдвиг КАК ДатаНачалаСдвиг,
			|	Периоды.ДатаОкончанияСдвиг КАК ДатаОкончанияСдвиг
			|ПОМЕСТИТЬ втПериоды
			|ИЗ
			|	&Периоды_"+СД.УИД+" КАК Периоды" + 
			ОбщегоНазначения.РазделительПакетаЗапросов() + ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);
			
		Возврат СтрЗаменить(ТекстЗапросаВТ, "втПериоды", "втПериоды_"+СД.УИД);
	
	КонецЕсли;
		
	Если (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется)
		И (ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется) Тогда
		
		// 1. Все даты фиксированы
		СД.Вставить("ПериодичностьОтчета", "");
		СД.Вставить("ТекстПериодСоединение", "ИСТИНА");
		
		ТекстЗапросаВТ = ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);

		Возврат СтрЗаменить(ТекстЗапросаВТ,",
		|	ТаблицаДанных.Период КАК Период","");
		
	ИначеЕсли (ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение) Тогда
		
		// 2. Дата окончания фиксирована
		СД.Вставить("ПериодичностьОтчета", "ЧАС");
		СД.Вставить("ТекстОтборДатаНач", 
			ПривестиПериод("&НачалоПериодаОтчета",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения));
		СД.Вставить("ТекстПериодСоединение", "ТаблицаДанных.Период МЕЖДУ "
			+ ПривестиПериод("Периоды.ДатаНачала",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения)
			+ " И " + СД.ТекстОтборДатаКон);
			
		Возврат ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);
		
	ИначеЕсли ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
		
		// 3. Дата окончания не задана
		СД.Вставить("ПериодичностьОтчета", "ЧАС");
		СД.Вставить("ТекстПериодСоединение", "ТаблицаДанных.Период >= "
			+ ПривестиПериод("Периоды.ДатаНачала",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения));
			
		Возврат ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);
		
	ИначеЕсли (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение) Тогда
		
		// 4. Дата начала фиксирована
		СД.Вставить("ПериодичностьОтчета", "ЧАС");
		СД.Вставить("ТекстОтборДатаКон",
			ПривестиПериод("&НачалоПериодаОтчета",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения));
		СД.Вставить("ТекстПериодСоединение", "ТаблицаДанных.Период МЕЖДУ "+СД.ТекстОтборДатаНач+" И "
			+ ПривестиПериод("Периоды.ДатаОкончания",Периодичность,ПараметрПериодДК.СпособВычисленияПараметра,ПараметрПериодДК.УточнениеСпособаОпределения));
			
		Возврат ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);
		
	ИначеЕсли ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
		
		// 4. Дата начала не задана
		СД.Вставить("ПериодичностьОтчета", "ЧАС");
		СД.Вставить("ТекстПериодСоединение", "ТаблицаДанных.Период <= "
			+ ПривестиПериод("Периоды.ДатаОкончания",Периодичность,ПараметрПериодДК.СпособВычисленияПараметра,ПараметрПериодДК.УточнениеСпособаОпределения));
			
		Возврат ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);
		
	ИначеЕсли (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета)
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом
		И ПараметрПериодДК.УточнениеСпособаОпределения = ПараметрПериодДН.УточнениеСпособаОпределения)
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода)
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом
		И ПараметрПериодДК.УточнениеСпособаОпределения = ПараметрПериодДН.УточнениеСпособаОпределения)
		ИЛИ (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
		И ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода) Тогда
		
		// 5. Периодичность отборов дат совпадает с периодичностью получения данных
		СД.Вставить("ТекстПериодСоединение",
			ПривестиПериод("Периоды.ДатаНачала",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения,Истина)
			+ " = " + ТекстНачалоПериода("ТаблицаДанных.Период", Периодичность)
			+ " И " 
			+ ПривестиПериод("Периоды.ДатаОкончания",Периодичность,ПараметрПериодДК.СпособВычисленияПараметра,ПараметрПериодДК.УточнениеСпособаОпределения,Ложь)
			+ " >= ТаблицаДанных.Период");
	
	Иначе
		
		// 6. Сложный случай с произвольными отборами по периоду
		СД.Вставить("ПериодичностьОтчета", "ЧАС");
		СД.Вставить("ТекстПериодСоединение", "ТаблицаДанных.Период МЕЖДУ "
			+ СтрЗаменить(
				ПривестиПериод("Периоды.ДатаНачала",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения),
				"#ПериодичностьОтчета","#ДНПериодичностьОтчета")
			+ " И "
			+ СтрЗаменить(
				ПривестиПериод("Периоды.ДатаОкончания",Периодичность,ПараметрПериодДК.СпособВычисленияПараметра,ПараметрПериодДК.УточнениеСпособаОпределения),
				"#ПериодичностьОтчета","#ДКПериодичностьОтчета"));
	
	КонецЕсли;
			
	// Установим параметры по периоду
	СД.Вставить("ТекстОтборДатаНач",
		ПривестиПериод("&НачалоПериодаОтчета",Периодичность,ПараметрПериодДН.СпособВычисленияПараметра,ПараметрПериодДН.УточнениеСпособаОпределения));
	СД.Вставить("ТекстОтборДатаКон",
		ПривестиПериод("&КонецПериодаОтчета",Периодичность,ПараметрПериодДК.СпособВычисленияПараметра,ПараметрПериодДК.УточнениеСпособаОпределения));
		
	ТекстЗапросаВТ = ШаблонЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, СД);

	// Изменим периодичность отчета, если это необходимо
	Если ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода 
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода Тогда
		
		Если ПараметрПериодДН.УточнениеСпособаОпределения = Перечисления.Периодичность.ДевятьМесяцев Тогда
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДНПериодичностьОтчета","ГОД");
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ПериодичностьОтчета","ГОД");
				
		ИначеЕсли ЗначениеЗаполнено(ПараметрПериодДН.УточнениеСпособаОпределения) Тогда
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДНПериодичностьОтчета",ПараметрПериодДН.УточнениеСпособаОпределения);
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ПериодичностьОтчета",ПараметрПериодДН.УточнениеСпособаОпределения);
		КонецЕсли;
	
	ИначеЕсли ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом Тогда
		
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДНПериодичностьОтчета","ГОД");
		
	КонецЕсли;
		
	Если ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода Тогда
		
		Если ПараметрПериодДК.УточнениеСпособаОпределения = Перечисления.Периодичность.ДевятьМесяцев Тогда
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДКПериодичностьОтчета","ГОД");
		ИначеЕсли ЗначениеЗаполнено(ПараметрПериодДК.УточнениеСпособаОпределения) Тогда
			ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДКПериодичностьОтчета",ПараметрПериодДК.УточнениеСпособаОпределения);
		КонецЕсли;
		
	ИначеЕсли ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
		ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом Тогда
		
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДКПериодичностьОтчета","ГОД");
		
	КонецЕсли;
	
	Если (ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
		ИЛИ ПараметрПериодДН.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом)
			И (ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
			ИЛИ ПараметрПериодДК.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом) Тогда
		
		ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ПериодичностьОтчета","ГОД");
		
	КонецЕсли;
	
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДНПериодичностьОтчета","#ПериодичностьОтчета");
	ТекстЗапросаВТ = СтрЗаменить(ТекстЗапросаВТ,"#ДКПериодичностьОтчета","#ПериодичностьОтчета");
	
	Возврат ТекстЗапросаВТ;

КонецФункции

Функция ТекстЗапросаВнутрРегистрСведений(ДанныеДляРасчета, Знач Периодичность, СД)
	
	Если НЕ ЗначениеЗаполнено(ДанныеДляРасчета.ВидСреза) Тогда
		
		Возврат "
		|ВЫБРАТЬ
		|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
		|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
		|ИЗ
		|	втПериоды КАК Периоды
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений."+СД.ИмяТаблицы+" КАК ТаблицаДанных
		|		ПО ИСТИНА
		|		"+СД.ТекстОтборПериод+СД.ТекстОтбор;
		
	КонецЕсли;
		
	// Найдем условия вычисления периода периодического регистра
	ПараметрПериод = ДанныеДляРасчета.ТаблицаПараметровОтбораБД.Найти("ДатаНач","ПолеБД");
	Если ПараметрПериод = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не найден обязательный отбор ""ДатаНач""'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	СпособВычисленияПараметра = ПараметрПериод.СпособВычисленияПараметра;
	Если Не ЗначениеЗаполнено(СпособВычисленияПараметра) Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнен способ вычисления параметра для отбора ""ДатаНач""'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Если СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		Или СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
		Или СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
		
		Возврат "
		|ВЫБРАТЬ
		|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
		|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
		|ИЗ
		|	втПериоды КАК Периоды
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений."+СД.ИмяТаблицы+"."+ДанныеДляРасчета.ВидСреза+"(
		|		"+СД.ТекстОтборДатаНач+", 
		|		"+СД.ТекстОтборВТ+") КАК ТаблицаДанных
		|		ПО ИСТИНА";
		
	Иначе
		
		СД.Вставить("ТекстОтборДатаНач",
			ПривестиПериод("&НачалоПериодаОтчета",Периодичность,ПараметрПериод.СпособВычисленияПараметра,ПараметрПериод.УточнениеСпособаОпределения));
		СД.Вставить("ТекстОтборДатаКон",
			ПривестиПериод("&КонецПериодаОтчета",Периодичность,ПараметрПериод.СпособВычисленияПараметра,ПараметрПериод.УточнениеСпособаОпределения));
		СД.Вставить("ТекстПериодСоединение",
			ПривестиПериод("Периоды.ДатаНачала",Периодичность,ПараметрПериод.СпособВычисленияПараметра,ПараметрПериод.УточнениеСпособаОпределения,Истина));
			
		Если СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода Тогда
			
			Если ЗначениеЗаполнено(ПараметрПериод.УточнениеСпособаОпределения) Тогда
				Периодичность = ПараметрПериод.УточнениеСпособаОпределения;
			КонецЕсли;	
			
		ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом Тогда
			
			Периодичность = Перечисления.Периодичность.Год;
			
		КонецЕсли;
		
		Если СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета 
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
			Тогда
		
			Если ДанныеДляРасчета.ВидСреза = "СрезПоследних" Тогда
				СД.Вставить("ТекстПериодРСДляСреза", ТекстДобавитьКДате("ТаблицаДанных.Период", Периодичность, 1));
			ИначеЕсли ДанныеДляРасчета.ВидСреза = "СрезПервых" Тогда
				СД.Вставить("ТекстПериодРСДляСреза", "ТаблицаДанных.Период");
			КонецЕсли;
				
		ИначеЕсли СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом
			ИЛИ СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом
			Тогда
			
			Если ДанныеДляРасчета.ВидСреза = "СрезПоследних" Тогда
				СД.Вставить("ТекстПериодРСДляСреза", "ТаблицаДанных.Период");
			ИначеЕсли ДанныеДляРасчета.ВидСреза = "СрезПервых" Тогда
				СД.Вставить("ТекстПериодРСДляСреза", ТекстДобавитьКДате("ТаблицаДанных.Период", Периодичность, -1));
			КонецЕсли;
			
		Иначе
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Способ вычисления параметра %1 для отбора ""ДатаНач""'"), СпособВычисленияПараметра);
			ВызватьИсключение(ТекстОшибки);
			
		КонецЕсли;
		
		Если ДанныеДляРасчета.ВидСреза = "СрезПоследних" Тогда
			
			Возврат "
			|ВЫБРАТЬ
			|	"+СД.ТекстОтборДатаНач+" КАК Период,
			|	"+ТекстНачалоПериода(СД.ТекстОтборДатаНач, Периодичность)+" КАК ДатаДляСреза"
				+ СД.ТекстАналитики + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ПОМЕСТИТЬ втДанныеРегистра_"+СД.УИД+"
			|ИЗ
			|	РегистрСведений."+СД.ИмяТаблицы+".СрезПоследних(
			|			"+СД.ТекстОтборДатаНач+",
			|			"+СД.ТекстОтборВТ+") КАК ТаблицаДанных
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаДанных.Период КАК Период,
			|	ВЫБОР
			|		КОГДА ТаблицаДанных.Период = " + ТекстНачалоПериода("ТаблицаДанных.Период", Периодичность) + "
			|			ТОГДА ТаблицаДанных.Период
			|		ИНАЧЕ " + ТекстНачалоПериода(СД.ТекстПериодРСДляСреза, Периодичность) + "
			|	КОНЕЦ КАК ДатаДляСреза" + СД.ТекстАналитики + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ИЗ
			|	РегистрСведений."+СД.ИмяТаблицы+" КАК ТаблицаДанных
			|
			|ГДЕ
			|	ТаблицаДанных.Период МЕЖДУ ДОБАВИТЬКДАТЕ("+СД.ТекстОтборДатаНач+", СЕКУНДА, 1) И "+СД.ТекстОтборДатаКон+СД.ТекстОтбор+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Периоды.ДатаНачала КАК ДатаНачала,
			|	Периоды.ПериодОтчета КАК ПериодОтчета" + СД.ТекстАналитикиВТ + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ПОМЕСТИТЬ втДанныеРегистраСПериодами_"+СД.УИД+"
			|ИЗ
			|	втПериоды КАК Периоды
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				МАКСИМУМ(ТаблицаДанных.Период) КАК МаксимальныйПериод,
			|				ТаблицаДанных.ДатаДляСреза КАК ДатаДляСреза" + СД.ТекстАналитикиВТ + СД.СрезРСОтборПериод_Поле + "
			|			ИЗ
			|				втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ТаблицаДанных.ДатаДляСреза" + СД.ТекстАналитикиГруппировка + СД.СрезРСОтборПериод_Группировка + "
			|			) КАК МаксимальныеНеПустыеПериоды
			|			ПО ТаблицаДанных.Период = МаксимальныеНеПустыеПериоды.МаксимальныйПериод
			|				И ТаблицаДанных.ДатаДляСреза = МаксимальныеНеПустыеПериоды.ДатаДляСреза"+СД.ТекстАналитикиСоединение+" 
			|		ПО "+СД.ТекстПериодСоединение+" = ТаблицаДанных.ДатаДляСреза
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МаксимальныеНеПустыеПериоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсы+"
			|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
			|ИЗ
			|	(ВЫБРАТЬ
			|		Данные.ПериодОтчета КАК ПериодОтчета,
			|		МАКСИМУМ(ТаблицаДанных.ДатаНачала) КАК ДатаНачала" + СД.ТекстАналитикиВТ + СД.СрезРСОтборПериод_Поле + "
			|	ИЗ
			|		втДанныеРегистраСПериодами_"+СД.УИД+" КАК Данные
			|			ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистраСПериодами_"+СД.УИД+" КАК ТаблицаДанных
			|			ПО Данные.ДатаНачала >= ТаблицаДанных.ДатаНачала
			|	ГДЕ " + СД.ТекстРесурсыУсловие + СД.СрезРСОтборПериод_Отбор + "
			|	
			|	СГРУППИРОВАТЬ ПО
			|		Данные.ПериодОтчета" + СД.ТекстАналитикиГруппировка + СД.СрезРСОтборПериод_Группировка + ") КАК МаксимальныеНеПустыеПериоды
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистраСПериодами_"+СД.УИД+" КАК ТаблицаДанных
			|		ПО (ТаблицаДанных.ДатаНачала = МаксимальныеНеПустыеПериоды.ДатаНачала)"
					+ СД.ТекстАналитикиСоединение + СД.СрезРСОтборПериод_Соединение;

		ИначеЕсли ДанныеДляРасчета.ВидСреза = "СрезПервых" Тогда

			Возврат " 
			|ВЫБРАТЬ
			|	"+СД.ТекстОтборДатаКон+" КАК Период,
			|	"+ТекстНачалоПериода(СД.ТекстОтборДатаКон, Периодичность)+" КАК ДатаДляСреза"
				+ СД.ТекстАналитики + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ПОМЕСТИТЬ втДанныеРегистра_"+СД.УИД+"
			|ИЗ
			|	РегистрСведений."+СД.ИмяТаблицы+".СрезПервых(
			|			"+СД.ТекстОтборДатаКон+",
			|			"+СД.ТекстОтборВТ+") КАК ТаблицаДанных
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаДанных.Период КАК Период,
			|	ВЫБОР
			|		КОГДА ТаблицаДанных.Период = "+ТекстНачалоПериода("ТаблицаДанных.Период", Периодичность)+"
			|			ТОГДА "+СД.ТекстПериодРСДляСреза+"
			|		ИНАЧЕ "+ТекстНачалоПериода(СД.ТекстПериодРСДляСреза, Периодичность)+"
			|	КОНЕЦ КАК ДатаДляСреза" + СД.ТекстАналитики + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ИЗ
			|	РегистрСведений."+СД.ИмяТаблицы+" КАК ТаблицаДанных
			|
			|ГДЕ
			|	ТаблицаДанных.Период МЕЖДУ "+СД.ТекстОтборДатаНач+" И ДОБАВИТЬКДАТЕ(" + ТекстКонецПериода(СД.ТекстОтборДатаКон, Периодичность) + ", СЕКУНДА, -1)
			|	"+СД.ТекстОтбор+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Периоды.ДатаНачала КАК ДатаНачала,
			|	Периоды.ПериодОтчета КАК ПериодОтчета" + СД.ТекстАналитикиВТ + СД.ТекстРесурсы + СД.СрезРСОтборПериод_Поле + "
			|ПОМЕСТИТЬ втДанныеРегистраСПериодами_"+СД.УИД+"
			|ИЗ
			|	втПериоды КАК Периоды
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				МИНИМУМ(ТаблицаДанных.Период) КАК МинимальныйПериод,
			|				ТаблицаДанных.ДатаДляСреза КАК ДатаДляСреза" + СД.ТекстАналитикиВТ + СД.СрезРСОтборПериод_Поле + "
			|			ИЗ
			|				втДанныеРегистра_"+СД.УИД+" КАК ТаблицаДанных
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ТаблицаДанных.ДатаДляСреза" + СД.ТекстАналитикиГруппировка + СД.СрезРСОтборПериод_Группировка + "
			|			) КАК МаксимальныеНеПустыеПериоды
			|			ПО ТаблицаДанных.Период = МаксимальныеНеПустыеПериоды.МинимальныйПериод
			|				И ТаблицаДанных.ДатаДляСреза = МаксимальныеНеПустыеПериоды.ДатаДляСреза"+СД.ТекстАналитикиСоединение+"
			|		ПО "+СД.ТекстПериодСоединение+" = ТаблицаДанных.ДатаДляСреза
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МаксимальныеНеПустыеПериоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитикиВТ+СД.ТекстРесурсы+"
			|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
			|ИЗ
			|	(ВЫБРАТЬ
			|		Данные.ПериодОтчета КАК ПериодОтчета,
			|		МИНИМУМ(ТаблицаДанных.ДатаНачала) КАК ДатаНачала" + СД.ТекстАналитикиВТ + СД.СрезРСОтборПериод_Поле + "
			|	ИЗ
			|		втДанныеРегистраСПериодами_"+СД.УИД+" КАК Данные
			|			ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистраСПериодами_"+СД.УИД+" КАК ТаблицаДанных
			|			ПО Данные.ДатаНачала <= ТаблицаДанных.ДатаНачала
			|	ГДЕ " + СД.ТекстРесурсыУсловие + СД.СрезРСОтборПериод_Отбор + "
			|	
			|	СГРУППИРОВАТЬ ПО
			|		Данные.ПериодОтчета" + СД.ТекстАналитикиГруппировка + СД.СрезРСОтборПериод_Группировка + ") КАК МаксимальныеНеПустыеПериоды
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРегистраСПериодами_"+СД.УИД+" КАК ТаблицаДанных
			|		ПО (ТаблицаДанных.ДатаНачала = МаксимальныеНеПустыеПериоды.ДатаНачала)"
					+ СД.ТекстАналитикиСоединение + СД.СрезРСОтборПериод_Соединение;

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ТекстЗапросаВнутрСправочник(СД)
	
	Возврат "
	|ВЫБРАТЬ
	|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"
	|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
	|ИЗ
	|	втПериоды КАК Периоды
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник."+СД.ИмяТаблицы+" КАК ТаблицаДанных
	|		ПО ИСТИНА
	|		"+СД.ТекстОтборПериод+СД.ТекстОтбор;
	
КонецФункции	

Функция ТекстЗапросаВнутрПроизвольныйЗапрос(ДанныеДляРасчета, тПараметрыПакетаВТ, СД)
	
	// Условие соединения для произвольного запроса
	СтрокаПериод = ДанныеДляРасчета.ПоляАналитикПоказателей.Найти("Период","КодАналитики");
	Если СтрокаПериод = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не найден ресурс ""Период"" для произвольного запроса'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;

	ТекстУсловияСоединенияПЗ = "";
	Если СтрокаПериод.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
		ТекстУсловияСоединенияПЗ = "ТаблицаДанных." + СтрокаПериод.Поле + " МЕЖДУ Периоды.ДатаНачала И Периоды.ДатаОкончания";
	ИначеЕсли СтрокаПериод.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
		нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ, 
			Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,
			СтрокаПериод.ФиксированноеЗначение, "Период");
		ТекстУсловияСоединенияПЗ = "&" + нПараметр.ИмяОтбора + " МЕЖДУ Периоды.ДатаНачала И Периоды.ДатаОкончания";
	ИначеЕсли СтрокаПериод.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки Тогда
		нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ, 
			"КонтекстВызоваЗаполнения",
			СтрокаПериод.Поле, "Период");
		ТекстУсловияСоединенияПЗ = "&" + нПараметр.ИмяОтбора + " МЕЖДУ Периоды.ДатаНачала И Периоды.ДатаОкончания";
	Иначе
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Способ заполнения параметра ""%1"" для отбора ""Период"" не поддерживается.'"), СтрокаПериод.СпособЗаполнения);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Вынесем временные таблицы
	ТекстЗапросаВТ = "";
	Если СтрНайти(СД.ТекстПроизвольногоЗапроса,"ПОМЕСТИТЬ") > 0 Тогда
		
		УИДЗапросов = СтрЗаменить(Новый УникальныйИдентификатор,"-","");
		СхемаЗапроса = Новый СхемаЗапроса();
		СхемаЗапроса.УстановитьТекстЗапроса(СД.ТекстПроизвольногоЗапроса);
		Для Каждого Пакет Из СхемаЗапроса.ПакетЗапросов Цикл
			Если Не ПустаяСтрока(Пакет.ТаблицаДляПомещения) Тогда
				Пакет.ТаблицаДляПомещения = Пакет.ТаблицаДляПомещения + "_" + УИДЗапросов;
				ТекстЗапросаВТ = ТекстЗапросаВТ + Пакет.ПолучитьТекстЗапроса() + ОбщегоНазначения.РазделительПакетаЗапросов();
			Иначе
				ТекстИтоговогоЗапроса = Пакет.ПолучитьТекстЗапроса();
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ТекстИтоговогоЗапроса = СД.ТекстПроизвольногоЗапроса;
	КонецЕсли;
	
	Возврат ТекстЗапросаВТ + "
	|ВЫБРАТЬ
	|	Периоды.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсы+"	
	|ПОМЕСТИТЬ втДанные_"+СД.УИД+"
	|ИЗ
	|	втПериоды КАК Периоды
	|	ЛЕВОЕ СОЕДИНЕНИЕ (
	|
	|"+ТекстИтоговогоЗапроса+"
	|
	|		) КАК ТаблицаДанных
	|		ПО "+ТекстУсловияСоединенияПЗ+"
	|		"+СД.ТекстОтборПериод+СД.ТекстОтбор;
		
КонецФункции

Функция ТекстЗапросаИтоговый(ДанныеДляРасчета, СД)
	
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
		
		Если ДанныеДляРасчета.КорреспонденцияСчетов Тогда
			ТекстКорреспонденцияСчетов = "
			|		И ТаблицаДанных.КоррСчет = ПоказателиСчета.КоррСчет";
		Иначе
			ТекстКорреспонденцияСчетов = "";
		КонецЕсли;
	
		Возврат "
		|// ДАННЫЕ ИЗ РЕГИСТРА БУХГАЛТЕРИИ
		|
		|ВЫБРАТЬ
		|	ПоказателиСчета.УИДГруппыОтборов КАК УИДГруппыОтборов,
		|	ПоказателиСчета.Показатель КАК Показатель,
		|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсов+"
		|ИЗ
		|	втДанные_"+СД.УИД+" КАК ТаблицаДанных
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоказателиСчета_"+СД.УИД+" КАК ПоказателиСчета 
		|		ПО ПоказателиСчета.НомерСреза = "+СД.НомерСреза+"
		|		И ТаблицаДанных.Счет = ПоказателиСчета.Счет"+ТекстКорреспонденцияСчетов;		
		
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления
		И ДанныеДляРасчета.ОсновнаяТаблицаРегистра И ДанныеДляРасчета.ВидРегистраИсточникаДанных = "Остатки" Тогда
		
		ОтборПоВидуДвижения = "";
		Если СД.ВидИтогаИсточникаДанных = "Приход" Тогда
			
			ОтборПоВидуДвижения = "
			|ГДЕ
			|	ТаблицаДанных.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
			
		ИначеЕсли СД.ВидИтогаИсточникаДанных = "Расход" Тогда
			
			ОтборПоВидуДвижения = "
			|ГДЕ
			|	ТаблицаДанных.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
			
		КонецЕсли;
		
		Возврат "
		|// ДАННЫЕ ИЗ ОСНОВНОЙ ТАБЛИЦЫ РЕГИСТРА НАКОПЛЕНИЯ С ВИДОМ ОСТАТКИ
		|
		|ВЫБРАТЬ
		|	"+СД.УИДГруппыОтборов+" КАК УИДГруппыОтборов,
		|	"+СД.Показатель+" КАК Показатель,
		|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсов+"
		|ИЗ
		|	втДанные_"+СД.УИД+" КАК ТаблицаДанных" + ОтборПоВидуДвижения ;
		
	Иначе
		
		Возврат "
		|// ДАННЫЕ ИЗ ВНУТРЕННИХ ИСТОЧНИКОВ
		|
		|ВЫБРАТЬ
		|	"+СД.УИДГруппыОтборов+" КАК УИДГруппыОтборов,
		|	"+СД.Показатель+" КАК Показатель,
		|	ТаблицаДанных.ПериодОтчета КАК ПериодОтчета"+СД.ТекстАналитики+СД.ТекстРесурсов+"
		|ИЗ
		|	втДанные_"+СД.УИД+" КАК ТаблицаДанных";

	КонецЕсли;

КонецФункции

Процедура ДобавитьЗапросПоВнутреннимДанным(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тВнутренниеДанные	= СтруктураРасчетаПоказателей.тВнутренниеДанные;
	тПоказателиОперанды	= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	
	Если тВнутренниеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Добавим временную таблицу с периодами
	ДобавитьТаблицуПериодов(СтруктураПараметровТекущегоУровня);

	тСвернутыеДанные = тВнутренниеДанные.Скопировать();
	
	ПоляСвертки = "СпособПолучения, РегистрБД , ОбъектБД, ТабличнаяЧастьБД, ОсновнаяТаблицаРегистра, КорреспонденцияСчетов,
	|ВидСреза, ТекстЗапроса, ХешОтбораПоказателей, ВидРегистраИсточникаДанных, УчитыватьКоррСчета, ДтКт";
	тСвернутыеДанные.Свернуть(ПоляСвертки);

	СчЗапроса = 0;
	Для Каждого ТекущийСрез Из тСвернутыеДанные Цикл
		
		// Найдем строки по одному срезу
		СтруктураОтбора = Новый Структура(ПоляСвертки);
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, ТекущийСрез);
		СтрокиСреза = тВнутренниеДанные.НайтиСтроки(СтруктураОтбора);
		
		// Соберем таблицу значений по регистру
		ПоляЗначенийПоказателей = Новый ТаблицаЗначений;
		ПоляЗначенийПоказателей.Колонки.Добавить("Показатель");
		ПоляЗначенийПоказателей.Колонки.Добавить("Поле");
		ПоляЗначенийПоказателей.Колонки.Добавить("ТипЗначения");
		ПоляЗначенийПоказателей.Колонки.Добавить("Код");
		ПоляЗначенийПоказателей.Колонки.Добавить("СпособЗаполнения");
		ПоляЗначенийПоказателей.Колонки.Добавить("ФиксированноеЗначение");
		ПоляЗначенийПоказателей.Колонки.Добавить("Счет");
		ПоляЗначенийПоказателей.Колонки.Добавить("КоррСчет");
		ПоляЗначенийПоказателей.Колонки.Добавить("УИДГруппыОтборов");
		ПоляЗначенийПоказателей.Колонки.Добавить("УИДЗаполненияАналитик");
		ПоляЗначенийПоказателей.Колонки.Добавить("ВидИтогаИсточникаДанных");
		
		ПоляАналитикПоказателей = Новый ТаблицаЗначений;
		ПоляАналитикПоказателей.Колонки.Добавить("Показатель");
		ПоляАналитикПоказателей.Колонки.Добавить("Поле");
		ПоляАналитикПоказателей.Колонки.Добавить("КодАналитики");
		ПоляАналитикПоказателей.Колонки.Добавить("СпособЗаполнения");
		ПоляАналитикПоказателей.Колонки.Добавить("ФиксированноеЗначение");
		ПоляАналитикПоказателей.Колонки.Добавить("ПредставлениеТипа");
		
		ОтборПоРегистратору = Ложь;
		
		Для Каждого СтрокаСреза Из СтрокиСреза Цикл
			
			НСтрокаПоказатель = ПоляЗначенийПоказателей.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрокаПоказатель, СтрокаСреза);
			НайденнаяСтрока = тПоказателиОперанды.НайтиСтроки(
				Новый Структура("ПоказательОперанд,КодВФормуле",НСтрокаПоказатель.Показатель,НСтрокаПоказатель.Код));
			НСтрокаПоказатель.УИДГруппыОтборов = НайденнаяСтрока.Получить(0).УИДГруппыОтборов;
			НСтрокаПоказатель.УИДЗаполненияАналитик = "";
			
			Для Каждого СтрокаПравила Из СтрокаСреза.ПравилаИспользованияПолейЗапроса Цикл
				
				Если СтрокаПравила.КодАналитики = "Значение" Тогда
					
					Если СтрокаСреза.ОсновнаяТаблицаРегистра Тогда
						НСтрокаПоказатель.Поле = СтрокаСреза.РесурсРегистра;
					Иначе
						
						НСтрокаПоказатель.Поле = СтрокаПравила.Поле;
						Если ЗначениеЗаполнено(СтрокаСреза.КоррСчет) Тогда
							// Может быть установлен отбор по регистратору
							Для Каждого СтрокаОтбор Из СтрокаСреза.ТаблицаПараметровОтбораБД Цикл
								Если СтрНачинаетсяС(СтрокаОтбор.ПолеБД, "Регистратор") Тогда
									ОтборПоРегистратору = Истина;
								КонецЕсли;
							КонецЦикла;
							Если НЕ ОтборПоРегистратору Тогда
								Если Прав(НСтрокаПоказатель.Поле,2) = "Кт"
									И Прав(НСтрокаПоказатель.Поле,6) <> "ОборотКт" Тогда
									НСтрокаПоказатель.Поле = СтрЗаменить(НСтрокаПоказатель.Поле, "Кт", "ОборотКт");
								ИначеЕсли Прав(НСтрокаПоказатель.Поле,2) = "Дт"
									И Прав(НСтрокаПоказатель.Поле,6) <> "ОборотДт" Тогда
									НСтрокаПоказатель.Поле = СтрЗаменить(НСтрокаПоказатель.Поле, "Дт", "ОборотДт");
								ИначеЕсли Прав(НСтрокаПоказатель.Поле,6) <> "Оборот" Тогда
									НСтрокаПоказатель.Поле = НСтрокаПоказатель.Поле + "Оборот";
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(НСтрокаПоказатель, СтрокаПравила, "СпособЗаполнения,ФиксированноеЗначение");
					
				Иначе
			
					// Поля аналитик
					НСтрока = ПоляАналитикПоказателей.Добавить();
					НСтрока.Показатель = СтрокаСреза.Показатель;
					ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПравила);
					НСтрокаПоказатель.УИДЗаполненияАналитик = НСтрокаПоказатель.УИДЗаполненияАналитик 
						+ "$" + НСтрока.Поле + "@" + НСтрока.КодАналитики + "@"
						+ ЗначениеВСтрокуВнутр(НСтрока.СпособЗаполнения) + "@"
						+ ЗначениеВСтрокуВнутр(НСтрока.ФиксированноеЗначение);
					
				КонецЕсли;
				
			КонецЦикла;

		КонецЦикла;
		
		// Подготовим данные для расчета
		ДанныеДляРасчета = Новый Структура;
		ДанныеДляРасчета.Вставить("УИДСреза", Формат(СчЗапроса, "ЧН=0; ЧГ=0"));
		СчЗапроса = СчЗапроса + 1;
		ДанныеДляРасчета.Вставить("СпособПолучения", ТекущийСрез.СпособПолучения);
		ДанныеДляРасчета.Вставить("ОсновнаяТаблицаРегистра", ТекущийСрез.ОсновнаяТаблицаРегистра);
		ДанныеДляРасчета.Вставить("КорреспонденцияСчетов", ТекущийСрез.КорреспонденцияСчетов);
		ДанныеДляРасчета.Вставить("ОтборПоРегистратору", ОтборПоРегистратору);
		ДанныеДляРасчета.Вставить("ВидСреза", ТекущийСрез.ВидСреза);
		ДанныеДляРасчета.Вставить("ТекстЗапроса", ТекущийСрез.ТекстЗапроса);
		ДанныеДляРасчета.Вставить("ТаблицаПараметровОтбораБД", СтрокиСреза.Получить(0).ТаблицаПараметровОтбораБД);
		ДанныеДляРасчета.Вставить("ПоляЗначенийПоказателей", ПоляЗначенийПоказателей);
		ДанныеДляРасчета.Вставить("ПоляАналитикПоказателей", ПоляАналитикПоказателей);
		ДанныеДляРасчета.Вставить("ВидРегистраИсточникаДанных", ТекущийСрез.ВидРегистраИсточникаДанных);
		ДанныеДляРасчета.Вставить("УчитыватьКоррСчета", ТекущийСрез.УчитыватьКоррСчета);
		ДанныеДляРасчета.Вставить("ДтКт", ТекущийСрез.ДтКт);
		
		// Вычислим имя таблицы
		Если (ТекущийСрез.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии
			ИЛИ ТекущийСрез.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления
			ИЛИ ТекущийСрез.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрСведений)
			И ЗначениеЗаполнено(ТекущийСрез.РегистрБД) Тогда
			ДанныеДляРасчета.Вставить("ИмяТаблицы", ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ТекущийСрез.РегистрБД,"Наименование"));
			Если ДанныеДляРасчета.УчитыватьКоррСчета Тогда
				ДанныеДляРасчета.Вставить("ПланСчетов", ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ТекущийСрез.РегистрБД, "ПланСчетов"));
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ТекущийСрез.ОбъектБД) Тогда
			ИмяОбъектаМетаданных = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ТекущийСрез.ОбъектБД,"ИмяОбъектаМетаданных");
			Если ЗначениеЗаполнено(ТекущийСрез.ТабличнаяЧастьБД) Тогда
				ИмяОбъектаМетаданных = ИмяОбъектаМетаданных + "." + ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ТекущийСрез.ТабличнаяЧастьБД,"Имя")
			КонецЕсли;
			ДанныеДляРасчета.Вставить("ИмяТаблицы", ИмяОбъектаМетаданных);
		Иначе
			ДанныеДляРасчета.Вставить("ИмяТаблицы", "");
		КонецЕсли;
		
		ДобавитьПодзапросПоИсточникуВнутреннихДанных(ДанныеДляРасчета, СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПодзапросПоИсточникуВнутреннихДанных(ДанныеДляРасчета, СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тСчетаСИерархией		= СтруктураРасчетаПоказателей.тСчетаСИерархией;

	тПараметрыПакетаВТ		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	мПодзапросыДанныхВТ		= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакета;
	мПодзапросыДанных		= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тИспользуемыеАналитики	= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	ТекстРесурсовОбщая		= СтруктураПараметровТекущегоУровня.ТекстРесурсы;
	Периодичность			= СтруктураПараметровТекущегоУровня.Периодичность;
	
	ЭтоПериодическийРС = (ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрСведений
		И ЗначениеЗаполнено(ДанныеДляРасчета.ВидСреза));
	
	#Область ВременныеТаблицыДляРасчетов
	
	#Область ТекстЗамены
	
	// Структура с данными замен
	СД = Новый Структура;
	СД.Вставить("УИД", ДанныеДляРасчета.УИДСреза);
	СД.Вставить("ИмяТаблицы", ДанныеДляРасчета.ИмяТаблицы);
	СД.Вставить("ПериодичностьОтчета", "#ПериодичностьОтчета");
	СД.Вставить("ТекстПроизвольногоЗапроса", ДанныеДляРасчета.ТекстЗапроса);
	СД.Вставить("ТекстРесурсы", "");
	СД.Вставить("ТекстРесурсыОстатки", "");
	СД.Вставить("ТекстРесурсыУсловие", "");
	СД.Вставить("ТекстРесурсыУсловиеНО", "");
	СД.Вставить("ТекстРесурсыОбороты", "");
	СД.Вставить("ТекстАналитики", "");
	СД.Вставить("ТекстАналитикиВТ", "");
	СД.Вставить("ТекстАналитикиГруппировка", "");
	СД.Вставить("ТекстАналитикиСоединение", "");
	СД.Вставить("ТекстАналитикиСоединениеНумерация", "");
	СД.Вставить("ТекстПериодСоединение", "");
	СД.Вставить("ТекстОтборПериод", "");
	СД.Вставить("ТекстОтборДатаНач", "&НачалоПериодаОтчета");
	СД.Вставить("ТекстОтборДатаКон", "&КонецПериодаОтчета");
	СД.Вставить("ТекстОтбор", "");
	СД.Вставить("ТекстОтборВТ", "");
	СД.Вставить("ВидИтогаИсточникаДанных", "");
	Если ЭтоПериодическийРС Тогда
		СД.Вставить("СрезРСОтборПериод_Поле", "");
		СД.Вставить("СрезРСОтборПериод_Группировка", "");
		СД.Вставить("СрезРСОтборПериод_Соединение", "");
		СД.Вставить("СрезРСОтборПериод_Отбор", "");
	КонецЕсли;
	
	#Область ТекстЗаменыРесурсы

	// Сформируем текст ресурсов
	ТаблицаРесурсов = ДанныеДляРасчета.ПоляЗначенийПоказателей.Скопировать();
	ТаблицаРесурсов.Свернуть("Поле");
	Для Каждого СтрокаРесурс Из ТаблицаРесурсов Цикл
		
		Если ПустаяСтрока(СтрокаРесурс.Поле) Тогда
			Продолжить;
		КонецЕсли;
		
		СД.ТекстРесурсы = СД.ТекстРесурсы + ",
		|	ТаблицаДанных." + СтрокаРесурс.Поле + " КАК " + СтрЗаменить(СтрокаРесурс.Поле,".","");
		
		СД.ТекстРесурсыУсловие = СД.ТекстРесурсыУсловие + Символы.ПС + Символы.Таб + Символы.Таб 
			+ ?(СД.ТекстРесурсыУсловие = "","", "И ") + "НЕ ТаблицаДанных." + СтрокаРесурс.Поле + " ЕСТЬ NULL";
		
		Если СтрНайти(СтрокаРесурс.Поле,"НачальныйОстаток") > 0
			ИЛИ СтрНайти(СтрокаРесурс.Поле,"НачальныйРазвернутыйОстаток") > 0 Тогда
			
			// Начальный остаток добавим вручную
			ПолеКО = СтрЗаменить(СтрокаРесурс.Поле,"НачальныйРазвернутыйОстаток","КонечныйРазвернутыйОстаток");
			ПолеКО = СтрЗаменить(ПолеКО,"НачальныйОстаток","КонечныйОстаток");
			Если Периодичность = Перечисления.Периодичность.Неделя Тогда
				СД.ТекстРесурсыОстатки = СД.ТекстРесурсыОстатки + ",
				|	ВЫБОР
				|		КОГДА МаксимальныеНеПустыеПериоды.ПериодОтчета <> ТаблицаДанных.ПериодОтчета ТОГДА 
				|			ВЫБОР
				|				КОГДА ТаблицаДанных.НомерЗаписи = НумерацияПериодов.МаксНомерЗаписи ТОГДА
				|					ТаблицаДанных." + ПолеКО + "
				|				ИНАЧЕ 0
				|			КОНЕЦ
				|		ИНАЧЕ 
				|			ВЫБОР
				|				КОГДА ТаблицаДанных.НомерЗаписи = НумерацияПериодов.МинНомерЗаписи ТОГДА
				|					ТаблицаДанных." + СтрокаРесурс.Поле + "
				|				ИНАЧЕ 0
				|			КОНЕЦ
				|	КОНЕЦ КАК " + СтрокаРесурс.Поле;
			Иначе
				СД.ТекстРесурсыОстатки = СД.ТекстРесурсыОстатки + ",
				|	ВЫБОР
				|		КОГДА МаксимальныеНеПустыеПериоды.ПериодОтчета <> ТаблицаДанных.ПериодОтчета
				|			ТОГДА ТаблицаДанных." + ПолеКО + "
				|		ИНАЧЕ ТаблицаДанных." + СтрокаРесурс.Поле + "
				|	КОНЕЦ КАК " + СтрокаРесурс.Поле;
			КонецЕсли;
			
			// Добавим конечные остаток, если его нет в ресурсах
			Если ТаблицаРесурсов.Найти(ПолеКО, "Поле") = Неопределено Тогда
				СД.ТекстРесурсы = СД.ТекстРесурсы + ",
				|	ТаблицаДанных." + ПолеКО + " КАК " + ПолеКО;
			КонецЕсли;
			
			СД.ТекстРесурсыУсловиеНО = СД.ТекстРесурсыУсловиеНО + Символы.ПС + Символы.Таб + Символы.Таб 
				+ ?(СД.ТекстРесурсыУсловиеНО = "","", "И ") + "НЕ ТаблицаДанных." + СтрокаРесурс.Поле + " ЕСТЬ NULL";
			
			СД.ТекстРесурсыОбороты = СД.ТекстРесурсыОбороты + ",
			|	0 КАК " + СтрокаРесурс.Поле;
			
			ДанныеДляРасчета.Вставить("ЕстьОстатки", Истина);
		
		ИначеЕсли СтрНайти(СтрокаРесурс.Поле,"КонечныйОстаток") > 0
			ИЛИ СтрНайти(СтрокаРесурс.Поле,"КонечныйРазвернутыйОстаток") > 0 Тогда
			
			// Конечный остаток добавим вручную
			ПолеНО = СтрЗаменить(СтрокаРесурс.Поле,"КонечныйРазвернутыйОстаток","НачальныйРазвернутыйОстаток");
			ПолеНО = СтрЗаменить(ПолеНО,"КонечныйОстаток","НачальныйОстаток");
			Если Периодичность = Перечисления.Периодичность.Неделя Тогда
				СД.ТекстРесурсыОстатки = СД.ТекстРесурсыОстатки + ",
				|	ВЫБОР
				|		КОГДА ТаблицаДанных.НомерЗаписи = НумерацияПериодов.МаксНомерЗаписи ТОГДА
				|			ТаблицаДанных." + СтрокаРесурс.Поле + "
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК " + СтрокаРесурс.Поле;
			Иначе	
				СД.ТекстРесурсыОстатки = СД.ТекстРесурсыОстатки + ",
				|	ТаблицаДанных." + СтрокаРесурс.Поле + " КАК " + СтрокаРесурс.Поле;
			КонецЕсли;
			
			// Добавим начальный остаток, если его не в ресурсах
			Если ТаблицаРесурсов.Найти(ПолеНО, "Поле") = Неопределено Тогда
				СД.ТекстРесурсы = СД.ТекстРесурсы + ",
				|	ТаблицаДанных." + ПолеНО + " КАК " + ПолеНО;
				СД.ТекстРесурсыУсловиеНО = СД.ТекстРесурсыУсловиеНО + Символы.ПС + Символы.Таб + Символы.Таб 
					+ ?(СД.ТекстРесурсыУсловиеНО = "","", "И ") + "НЕ ТаблицаДанных." + ПолеНО + " ЕСТЬ NULL";
			КонецЕсли;
			
			СД.ТекстРесурсыОбороты = СД.ТекстРесурсыОбороты + ",
			|	0 КАК " + СтрокаРесурс.Поле;
			
			ДанныеДляРасчета.Вставить("ЕстьОстатки", Истина);
			
		Иначе
				
			СД.ТекстРесурсыОбороты = СД.ТекстРесурсыОбороты + ",
			|	ТаблицаДанных." + СтрокаРесурс.Поле + " КАК " + СтрокаРесурс.Поле;
			
			СД.ТекстРесурсыОстатки = СД.ТекстРесурсыОстатки + ",
			|	0 КАК " + СтрокаРесурс.Поле;
			
			ДанныеДляРасчета.Вставить("ЕстьОбороты", Истина);
	
		КонецЕсли;
		
	КонецЦикла;
			
	#КонецОбласти
	
	#Область ТекстЗаменаАналитики
	
	// Сформируем текст аналитик	
	ПоляАналитикПоказателей = ДанныеДляРасчета.ПоляАналитикПоказателей.Скопировать(
		Новый Структура("СпособЗаполнения",Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы));
	ПоляАналитикПоказателей.Свернуть("Поле");
	Для Каждого СтрокаАналитика Из ПоляАналитикПоказателей Цикл 
		Если ТаблицаРесурсов.Найти(СтрокаАналитика.Поле, "Поле") <> Неопределено Тогда 
			// Поле уже есть в ресурсах
			Продолжить;
		КонецЕсли;
		Синоним = СтрЗаменить(СтрокаАналитика.Поле,".","");
		Если ДанныеДляРасчета.Свойство("ЕстьОстатки") Тогда
			СД.ТекстАналитики = СД.ТекстАналитики + ",
			|	ISNULL(ТаблицаДанных." + СтрокаАналитика.Поле + ",НЕОПРЕДЕЛЕНО) КАК " + Синоним;
		Иначе
			СД.ТекстАналитики = СД.ТекстАналитики + ",
			|	ТаблицаДанных." + СтрокаАналитика.Поле + " КАК " + Синоним;
		КонецЕсли;
		СД.ТекстАналитикиВТ = СД.ТекстАналитикиВТ + ",
		|		ТаблицаДанных." + Синоним + " КАК " + Синоним;
		СД.ТекстАналитикиГруппировка = СД.ТекстАналитикиГруппировка + ",
		|		ТаблицаДанных." + Синоним;
		СД.ТекстАналитикиСоединение = СД.ТекстАналитикиСоединение + "
		|		И ТаблицаДанных." + Синоним + " = МаксимальныеНеПустыеПериоды." + Синоним;
		СД.ТекстАналитикиСоединениеНумерация = СД.ТекстАналитикиСоединениеНумерация + "
		|		И ТаблицаДанных." + Синоним + " = НумерацияПериодов." + Синоним;
	КонецЦикла;	
	
	Если ДанныеДляРасчета.УчитыватьКоррСчета Тогда
		
		СД.ТекстАналитики = СтрЗаменить(СД.ТекстАналитики,
			"ТаблицаДанных.КоррСчетОборот", "СчетаБД.Ссылка");
		
		Если ДанныеДляРасчета.ДтКт = "Дт" Тогда
			СД.ТекстАналитики = СтрЗаменить(СД.ТекстАналитики, ".Субконто", ".СубконтоДт");
			СД.ТекстАналитики = СтрЗаменить(СД.ТекстАналитики, ".Валюта", ".ВалютаДт");
		Иначе
			СД.ТекстАналитики = СтрЗаменить(СД.ТекстАналитики, ".Субконто", ".СубконтоКт");
			СД.ТекстАналитики = СтрЗаменить(СД.ТекстАналитики, ".Валюта", ".ВалютаКт");
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ТекстЗаменыОтборы

	// Обработаем отборы
	ОбработанныеСтроки = Новый Массив;
	ТаблицаПараметровОтбораБД = ДанныеДляРасчета.ТаблицаПараметровОтбораБД.Скопировать();
	
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос Тогда
		// Обработаем отборы произвольного запроса
		Для Каждого ПравилоВычисления Из ТаблицаПараметровОтбораБД Цикл 
			ПолеБД = ПравилоВычисления.ПолеБД;
			Если ПолеБД <> "" И СтрНайти(СД.ТекстПроизвольногоЗапроса,"&" + ПолеБД) > 0 Тогда
				Если ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
					Или ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
					нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
						ПравилоВычисления.СпособВычисленияПараметра,ПравилоВычисления.ТекстМодуля,ПравилоВычисления.ПолеБД);
				Иначе
					нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
						ПравилоВычисления.СпособВычисленияПараметра,ПравилоВычисления.УточнениеСпособаОпределения,ПравилоВычисления.ПолеБД);
				КонецЕсли;
				СД.ТекстПроизвольногоЗапроса = СтрЗаменить(СД.ТекстПроизвольногоЗапроса,"&" + ПолеБД,"&" + нПараметр.ИмяОтбора);
				ОбработанныеСтроки.Добавить(ПравилоВычисления);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
		// Обработаем отбор плана счетов, если он задан
		Для Каждого ПравилоВычисления Из ТаблицаПараметровОтбораБД Цикл
			Если ПравилоВычисления.ПолеБД = "ПланСчетов"
				И ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение
				И ТипЗнч(ПравилоВычисления.УточнениеСпособаОпределения) = Тип("СправочникСсылка.ПланыСчетовБД") Тогда
				ОбработанныеСтроки.Добавить(ПравилоВычисления);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ОбработаннаяСтрока Из ОбработанныеСтроки Цикл
		ТаблицаПараметровОтбораБД.Удалить(ОбработаннаяСтрока);
	КонецЦикла;
	ОбработанныеСтроки.Очистить();
	
	// Обработаем отборы по периоду
	Для Каждого ПравилоВычисления Из ТаблицаПараметровОтбораБД Цикл
		
		ПолеБД = ПравилоВычисления.ПолеБД;
		Если ПолеБД = "ДатаНач"
			Или ПолеБД = "ДатаКон" Тогда
			
			Если ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.Дата Тогда
				
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
					ПравилоВычисления.СпособВычисленияПараметра,ПравилоВычисления.УточнениеСпособаОпределения,ПолеБД);
				СД.Вставить("ТекстОтбор" + ПолеБД, "&" + нПараметр.ИмяОтбора);
				
			ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
				Или ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
				
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
					ПравилоВычисления.СпособВычисленияПараметра,ПравилоВычисления.ТекстМодуля,ПолеБД);
				СД.Вставить("ТекстОтбор" + ПолеБД, "&" + нПараметр.ИмяОтбора);	
				
			ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
				Тогда
				
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
					Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета,,ПолеБД);
				СД.Вставить("ТекстОтбор" + ПолеБД, "&" + нПараметр.ИмяОтбора);
				
			ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом
				ИЛИ ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода
				Тогда
				
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакетаВТ,
					Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета,,ПолеБД);
				СД.Вставить("ТекстОтбор" + ПолеБД, "&" + нПараметр.ИмяОтбора);	
				
			ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
				
				СД.Вставить("ТекстОтбор" + ПолеБД, "");
				
			Иначе
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Способ вычисления параметра ""%1"" для отбора ""%2"" не поддерживается.'"),
					ПравилоВычисления.СпособВычисленияПараметра, ПолеБД);
				ВызватьИсключение(ТекстОшибки);
				
			КонецЕсли;
			
			ОбработанныеСтроки.Добавить(ПравилоВычисления);
			
		ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета Тогда
			
			СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И Периоды.ПериодОтчета = ТаблицаДанных." + ПолеБД;
			
		ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчетаСоСдвигом Тогда
			
			Если ПравилоВычисления.УточнениеСпособаОпределения = Неопределено Тогда
				ТекстЗначениеСдвига = "0";
			Иначе
				ТекстЗначениеСдвига = Формат(ПравилоВычисления.УточнениеСпособаОпределения, "ЧН=0; ЧГ=0");
			КонецЕсли;
			
			СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И ДОБАВИТЬКДАТЕ(Периоды.ПериодОтчета.ДатаНачала, #ПериодичностьОтчета, " + ТекстЗначениеСдвига + ") = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
			
		ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ВышестоящийПериод Тогда
			
			Если ПравилоВычисления.УточнениеСпособаОпределения = Перечисления.Периодичность.ДевятьМесяцев Тогда
				СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И НАЧАЛОПЕРИОДА(Периоды.ПериодОтчета.ДатаНачала, ГОД) = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
			ИначеЕсли НЕ ЗначениеЗаполнено(ПравилоВычисления.УточнениеСпособаОпределения) Тогда
				СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И НАЧАЛОПЕРИОДА(Периоды.ПериодОтчета.ДатаНачала, #ПериодичностьОтчета) = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
			Иначе
				СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И НАЧАЛОПЕРИОДА(Периоды.ПериодОтчета.ДатаНачала, " + Строка(ПравилоВычисления.УточнениеСпособаОпределения) + ") = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
			КонецЕсли;
			
		ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодПредыдущегоГода Тогда
			
			СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И ДОБАВИТЬКДАТЕ(Периоды.ПериодОтчета.ДатаНачала, ГОД, -1) = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
			
		ИначеЕсли ПравилоВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодГодаСоСдвигом Тогда
			
			Если ПравилоВычисления.УточнениеСпособаОпределения = Неопределено Тогда
				ТекстЗначениеСдвига = "0";
			Иначе
				ТекстЗначениеСдвига = Формат(ПравилоВычисления.УточнениеСпособаОпределения, "ЧН=0; ЧГ=0");
			КонецЕсли;
			
			СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И ДОБАВИТЬКДАТЕ(Периоды.ПериодОтчета.ДатаНачала, ГОД, " + ТекстЗначениеСдвига + ") = ТаблицаДанных." + ПолеБД + ".ДатаНачала";
		
		Иначе
			
			ТекстПриведенныйПериод = ПривестиПериод("Периоды.ДатаНачала", Периодичность, ПравилоВычисления.СпособВычисленияПараметра, ПравилоВычисления.УточнениеСпособаОпределения);
			Если НЕ ПустаяСтрока(ТекстПриведенныйПериод) Тогда
				СД.ТекстОтборПериод = СД.ТекстОтборПериод + " И ТаблицаДанных." + ПолеБД + " = " + ТекстПриведенныйПериод;
				ОбработанныеСтроки.Добавить(ПравилоВычисления);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоПериодическийРС И ЗначениеЗаполнено(СД.ТекстОтборПериод) Тогда
			
			СД.СрезРСОтборПериод_Поле = СД.СрезРСОтборПериод_Поле + ",
				|	ТаблицаДанных." + ПолеБД + " КАК "+ ПолеБД;
			СД.СрезРСОтборПериод_Группировка = СД.СрезРСОтборПериод_Группировка + ",
				|	ТаблицаДанных." + ПолеБД;
			СД.СрезРСОтборПериод_Соединение = СД.СрезРСОтборПериод_Соединение + "
				|	И ТаблицаДанных." + ПолеБД + " = МаксимальныеНеПустыеПериоды." + ПолеБД;
			
			СД.СрезРСОтборПериод_Отбор = СД.СрезРСОтборПериод_Отбор + СД.ТекстОтборПериод;
			СД.СрезРСОтборПериод_Отбор = СтрЗаменить(СД.СрезРСОтборПериод_Отбор, "Периоды", "Данные.ПериодОтчета");
			СД.ТекстОтборПериод = "";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ОбработаннаяСтрока Из ОбработанныеСтроки Цикл
		ТаблицаПараметровОтбораБД.Удалить(ОбработаннаяСтрока);
	КонецЦикла;
	
	// Добавим остальные отборы
	ТаблицаПараметровОтбораБД.Колонки.Добавить("УИДГруппыОтборов");
	ТаблицаПараметровОтбораБД.ЗаполнитьЗначения(0,"УИДГруппыОтборов");
	ТаблицаПараметровОтбораБД.ЗаполнитьЗначения(Истина,"ПолеВерсии");	
	ТекстОтбора = ТекстЗапросаПоОтборам(ТаблицаПараметровОтбораБД,тПараметрыПакетаВТ);
	Если ДанныеДляРасчета.УчитыватьКоррСчета Тогда
		ТекстОтбора = СтрЗаменить(ТекстОтбора, "КоррСчетОборот ", ?(ДанныеДляРасчета.ДтКт = "Дт", "СчетКт ", "СчетДт "));
		Если ДанныеДляРасчета.ДтКт = "Дт" Тогда
			ТекстОтбора = СтрЗаменить(ТекстОтбора, ".Субконто", ".СубконтоДт");
			ТекстОтбора = СтрЗаменить(ТекстОтбора, ".Валюта", ".ВалютаДт");
		Иначе
			ТекстОтбора = СтрЗаменить(ТекстОтбора, ".Субконто", ".СубконтоКт");
			ТекстОтбора = СтрЗаменить(ТекстОтбора, ".Валюта", ".ВалютаКт");
		КонецЕсли;
	КонецЕсли;
	СД.ТекстОтбор = СтрЗаменить(ТекстОтбора,"#ИмяТаблицы","ТаблицаДанных");
	СД.ТекстОтборВТ = Сред(СтрЗаменить(ТекстОтбора,"#ИмяТаблицы.",""), СтрДлина(" И "));	
			
	#КонецОбласти
	
	#КонецОбласти
	
	#Область ТекстЗапроса
	
	// Получим текст шаблонов запросов для подъема данных
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрНакопления
		Или ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
		ТекстЗапросаВТ = ТекстЗапросаВнутрРегистрНакоплений(ДанныеДляРасчета, Периодичность, тПараметрыПакетаВТ, СД);
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрСведений Тогда
		ТекстЗапросаВТ = ТекстЗапросаВнутрРегистрСведений(ДанныеДляРасчета, Периодичность, СД);
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеСправочники Тогда
		ТекстЗапросаВТ = ТекстЗапросаВнутрСправочник(СД);
	ИначеЕсли ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос Тогда
		ТекстЗапросаВТ = ТекстЗапросаВнутрПроизвольныйЗапрос(ДанныеДляРасчета, тПараметрыПакетаВТ, СД);
	КонецЕсли;

	// Добавим запрос ВТ в массив
	мПодзапросыДанныхВТ.Добавить(ТекстЗапросаВТ);
	
	#КонецОбласти

	#КонецОбласти

	#Область ТаблицыДляИтоговыхДанных
	
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
	
		тПоказателейИсходная = ДанныеДляРасчета.ПоляЗначенийПоказателей;
		тПоказателей = тПоказателейИсходная.Скопировать();
		тПоказателей.Свернуть("Поле,ТипЗначения,УИДЗаполненияАналитик,СпособЗаполнения");
		
		СчетаДт = Новый Массив;
		СчетаКт = Новый Массив;
		
		тПоказателиСчета = Новый ТаблицаЗначений;
		тПоказателиСчета.Колонки.Добавить("НомерСреза", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(5));
		тПоказателиСчета.Колонки.Добавить("Показатель", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.ПоказателиОтчетов"));
		тПоказателиСчета.Колонки.Добавить("УИДГруппыОтборов", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(5));
		МассивТиповСчет = Новый Массив;
		МассивТиповСчет.Добавить(ТипЗнч(тПоказателейИсходная.Получить(0).Счет));
		тПоказателиСчета.Колонки.Добавить("Счет", Новый ОписаниеТипов(МассивТиповСчет));
		Если ДанныеДляРасчета.КорреспонденцияСчетов Тогда
			тПоказателиСчета.Колонки.Добавить("КоррСчет", Новый ОписаниеТипов(МассивТиповСчет));
		КонецЕсли;
		
	Иначе
		тПоказателей = ДанныеДляРасчета.ПоляЗначенийПоказателей;
	КонецЕсли;
	
	// Общие тексты аналитик и ресурсов
	ТекстАналитикиОбщая = "";
	тАналитикиУровня = тИспользуемыеАналитики.Скопировать(Новый Структура("УровеньРасчета",0));
	тАналитикиУровня.Сортировать("ПолеВерсии УБЫВ");
	Для Каждого СтрАналитика Из тАналитикиУровня Цикл
		Если СтрАналитика.ПолеВерсии Тогда
			ТекстАналитикиОбщая = ТекстАналитикиОбщая + ",
			|	НЕОПРЕДЕЛЕНО";
		Иначе
			ТекстАналитикиОбщая = ТекстАналитикиОбщая + ",
			|	#ИмяТаблицы." + СтрАналитика.Поле;
		КонецЕсли;
		ТекстАналитикиОбщая = ТекстАналитикиОбщая + " КАК " + СтрЗаменить(СтрАналитика.Поле,".","");	
	КонецЦикла;
	
	// Формирование текстов запросов
	НомерСреза = 0;
	Для Каждого СтрокаРесурс Из тПоказателей Цикл	
		
		// Текст ресурсов
		ТекстРесурсов = ТекстРесурсовОбщая;
		Если СтрокаРесурс.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.ЗначениеНечисловое","НЕОПРЕДЕЛЕНО");
			Если СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,СтрокаРесурс.ФиксированноеЗначение);
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","&" + нПараметр.ИмяОтбора);
			ИначеЕсли СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,"КонтекстВызоваЗаполнения",СтрокаРесурс.Поле);
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","&" + нПараметр.ИмяОтбора);
			ИначеЕсли СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеДругогоИсточникаДанных Тогда
				// Данный способ не поддерживаются
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","0");
			Иначе
				Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос
					Или ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеСправочники Тогда
					ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","ВЫРАЗИТЬ(ТаблицаДанных." + СтрЗаменить(СтрокаРесурс.Поле,".","") + " КАК Число)");
				Иначе				
					ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","ТаблицаДанных." + СтрЗаменить(СтрокаРесурс.Поле,".",""));
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,СтрокаРесурс.ФиксированноеЗначение);
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.ЗначениеНечисловое","&" + нПараметр.ИмяОтбора);
			ИначеЕсли СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,"КонтекстВызоваЗаполнения",СтрокаРесурс.Поле);
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.ЗначениеНечисловое","&" + нПараметр.ИмяОтбора);
			ИначеЕсли СтрокаРесурс.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеДругогоИсточникаДанных Тогда
				// Данный способ не поддерживаются
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.ЗначениеНечисловое","НЕОПРЕДЕЛЕНО");
			Иначе
				ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.ЗначениеНечисловое","ТаблицаДанных." + СтрЗаменить(СтрокаРесурс.Поле,".",""));
			КонецЕсли;
			ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы.Значение","0");
		КонецЕсли;
		СД.Вставить("ТекстРесурсов", ТекстРесурсов);
		
		// Текст для установки показателей
		НомерСреза = НомерСреза + 1;
		Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда			
			
			СД.Вставить("НомерСреза", Формат(НомерСреза, "ЧН=0; ЧГ="));
			
			// Таблица счетов и показателей
			СтрокиПоказателей = тПоказателейИсходная.НайтиСтроки(
				Новый Структура("Поле,ТипЗначения,УИДЗаполненияАналитик",
				СтрокаРесурс.Поле,СтрокаРесурс.ТипЗначения,СтрокаРесурс.УИДЗаполненияАналитик));			
				
			Для Каждого СтрокаПоказатель Из СтрокиПоказателей Цикл
					
				СтрокаСчетаСИерархией = тСчетаСИерархией.Найти(СтрокаПоказатель.Счет,"Счет");
				Если СтрокаСчетаСИерархией = Неопределено Тогда
					
					// Счет без иерархии
					Если СчетаДт.Найти(СтрокаПоказатель.Счет) = Неопределено Тогда
						СчетаДт.Добавить(СтрокаПоказатель.Счет);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаПоказатель.КоррСчет) Тогда
						
						СтрокаСчетаСИерархией = тСчетаСИерархией.Найти(СтрокаПоказатель.КоррСчет,"Счет");
						Если СтрокаСчетаСИерархией = Неопределено Тогда
							
							// КоррСчет без иерархии
							Если СчетаКт.Найти(СтрокаПоказатель.КоррСчет) = Неопределено Тогда
								СчетаКт.Добавить(СтрокаПоказатель.КоррСчет);
							КонецЕсли;
							
							НСтрока = тПоказателиСчета.Добавить();
							ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
							НСтрока.НомерСреза = НомерСреза;
							
						Иначе
							
							// КоррСчет с иерархией
							Для Каждого ТекКоррСчет Из СтрокаСчетаСИерархией.МассивПодчиненныхСчетов Цикл
								
								Если СчетаКт.Найти(ТекКоррСчет) = Неопределено Тогда
									СчетаКт.Добавить(ТекКоррСчет);
								КонецЕсли;
								
								НСтрока = тПоказателиСчета.Добавить();
								ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
								НСтрока.КоррСчет = ТекКоррСчет;
								НСтрока.НомерСреза = НомерСреза;
								
							КонецЦикла;
							
						КонецЕсли;
						
					Иначе
						
						НСтрока = тПоказателиСчета.Добавить();
						ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
						НСтрока.НомерСреза = НомерСреза;
						
					КонецЕсли;
					
				Иначе
					
					Для Каждого ТекСчет Из СтрокаСчетаСИерархией.МассивПодчиненныхСчетов Цикл
						
						Если СчетаДт.Найти(ТекСчет) = Неопределено Тогда
							СчетаДт.Добавить(ТекСчет);
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаПоказатель.КоррСчет) Тогда
						
							СтрокаСчетаСИерархией = тСчетаСИерархией.Найти(СтрокаПоказатель.КоррСчет,"Счет");
							Если СтрокаСчетаСИерархией = Неопределено Тогда
								
								// КоррСчет без иерархии
								Если СчетаКт.Найти(СтрокаПоказатель.КоррСчет) = Неопределено Тогда
									СчетаКт.Добавить(СтрокаПоказатель.КоррСчет);
								КонецЕсли;
								
								НСтрока = тПоказателиСчета.Добавить();
								ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
								НСтрока.Счет = ТекСчет;
								НСтрока.НомерСреза = НомерСреза;
								
							Иначе
								
								// КоррСчет с иерархией
								Для Каждого ТекКоррСчет Из СтрокаСчетаСИерархией.МассивПодчиненныхСчетов Цикл
								
									Если СчетаКт.Найти(ТекКоррСчет) = Неопределено Тогда
										СчетаКт.Добавить(ТекКоррСчет);
									КонецЕсли;
							
									НСтрока = тПоказателиСчета.Добавить();
									ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
									НСтрока.Счет = ТекСчет;
									НСтрока.КоррСчет = ТекКоррСчет;
									НСтрока.НомерСреза = НомерСреза;
									
								КонецЦикла;
								
							КонецЕсли;
							
						Иначе
							
							НСтрока = тПоказателиСчета.Добавить();
							ЗаполнитьЗначенияСвойств(НСтрока, СтрокаПоказатель);
							НСтрока.Счет = ТекСчет;
							НСтрока.НомерСреза = НомерСреза;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПоказательОтбор = СтрокаПоказатель.Показатель;
			
		Иначе
			
			ПоказательОтбор = СтрокаРесурс.Показатель;
			
			// Добавим параметр-показатель
			НСтрока = тПараметрыПакета.Добавить();
			НСтрока.ИмяОтбора = "Показатель_" + Формат(НомерСреза, "ЧН=0; ЧГ=") + "_" + ДанныеДляРасчета.УИДСреза;
			НСтрока.ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НСтрока.ЗначениеОтбора = ПоказательОтбор;
			
			СД.Вставить("Показатель", "&" + НСтрока.ИмяОтбора);
			СД.Вставить("УИДГруппыОтборов", Формат(СтрокаРесурс.УИДГруппыОтборов,"ЧН=0; ЧГ=0"));

		КонецЕсли;
		
		// Текст аналитик
		ТекстАналитики = ТекстАналитикиОбщая;
		ПоляАналитикПоказателей = ДанныеДляРасчета.ПоляАналитикПоказателей.НайтиСтроки(
			Новый Структура("Показатель", ПоказательОтбор));
		Для Каждого СтрокаАналитика Из ПоляАналитикПоказателей Цикл
				
			ПредставлениеТипа = СтрокаАналитика.ПредставлениеТипа;
			НомерПервойЗапятой = СтрНайти(ПредставлениеТипа, ",");
			Если НомерПервойЗапятой > 0 Тогда
				// Берем первое значение составного типа
				ПредставлениеТипа = Лев(ПредставлениеТипа, НомерПервойЗапятой-1);
			КонецЕсли;
			
			Если СтрокаАналитика.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы Тогда
				Поле = СтрЗаменить(СтрокаАналитика.Поле,".","");
				ТекстАналитики = СтрЗаменить(ТекстАналитики, "#ИмяТаблицы." + СтрокаАналитика.КодАналитики + " ","ISNULL(ВЫБОР
					|		КОГДА ТаблицаДанных." + Поле + " = НЕОПРЕДЕЛЕНО ТОГДА
					|			ЗНАЧЕНИЕ(" + ПредставлениеТипа + ".ПустаяСсылка)
					|		ИНАЧЕ
					|			ТаблицаДанных." + Поле + "
					|		КОНЕЦ, ЗНАЧЕНИЕ(" + ПредставлениеТипа + ".ПустаяСсылка)) ");
			ИначеЕсли СтрокаАналитика.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.ФиксированноеЗначение Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
					Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,СтрокаАналитика.ФиксированноеЗначение,СтрокаАналитика.КодАналитики);
				АналитикаУровня = тАналитикиУровня.Найти(СтрокаАналитика.КодАналитики, "ПолеТрансформации");
				Если АналитикаУровня = Неопределено Тогда
					ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы." + СтрокаАналитика.КодАналитики + " ","&" + нПараметр.ИмяОтбора + " ");
				Иначе
					ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы." + АналитикаУровня.Поле + " ","&" + нПараметр.ИмяОтбора + " ");
				КонецЕсли;
			ИначеЕсли СтрокаАналитика.СпособЗаполнения = Перечисления.СпособыЗаполненияПолейИсточника.КонтекстОбъектаЗагрузки Тогда
				нПараметр = ДобавитьПараметрВПакет(тПараметрыПакета,
					"КонтекстВызоваЗаполнения",СтрокаАналитика.Поле,СтрокаАналитика.КодАналитики);
				ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы." + СтрокаАналитика.КодАналитики,"&" + нПараметр.ИмяОтбора);
			Иначе
				ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы." + СтрокаАналитика.КодАналитики, "ЗНАЧЕНИЕ(" + ПредставлениеТипа + ".ПустаяСсылка)");
			КонецЕсли;
			
		КонецЦикла;
		
		ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы.АналитикаВалюта","ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)");
		Если СтрНайти(ТекстАналитики,"#ИмяТаблицы") > 0 Тогда
			// В зависимых операндах есть отборы по отличным от аналитик реквизитам
			Для Каждого СтрокаАналитика Из тИспользуемыеАналитики Цикл	
				// Пробел после имени поля служит признаком окончания строки для предотвращения избыточной замены
				ТекстАналитики = СтрЗаменить(ТекстАналитики, "#ИмяТаблицы." + СтрокаАналитика.Поле + " ", "НЕОПРЕДЕЛЕНО ");
			КонецЦикла;
		КонецЕсли;
		СД.Вставить("ТекстАналитики", ТекстАналитики);
		
		Если ДанныеДляРасчета.СпособПолучения <> Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
			СД.ВидИтогаИсточникаДанных = СтрокаРесурс.ВидИтогаИсточникаДанных;
		КонецЕсли;
		
		// Добавляем запрос в таблицы 
		мПодзапросыДанных.Добавить(ТекстЗапросаИтоговый(ДанныеДляРасчета, СД));
		
	КонецЦикла;
	
	Если ДанныеДляРасчета.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеРегистрБухгалтерии Тогда
		
		// Добавляем таблицу счетов и показателей в параметры
		НСтрока = тПараметрыПакетаВТ.Добавить();
		НСтрока.ИмяОтбора = "ПоказателиСчета_" + ДанныеДляРасчета.УИДСреза;
		НСтрока.ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		НСтрока.ЗначениеОтбора = тПоказателиСчета;
			
		// Счета для РБ
		НСтрока = тПараметрыПакетаВТ.Добавить();
		НСтрока.ИмяОтбора = "Счета_" + ДанныеДляРасчета.УИДСреза;
		НСтрока.ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		НСтрока.ЗначениеОтбора = СчетаДт;
		
		Если ДанныеДляРасчета.КорреспонденцияСчетов Тогда
			НСтрока = тПараметрыПакетаВТ.Добавить();
			НСтрока.ИмяОтбора = "СчетаКт_" + ДанныеДляРасчета.УИДСреза;
			НСтрока.ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НСтрока.ЗначениеОтбора = СчетаКт;
			
		ИначеЕсли ДанныеДляРасчета.УчитыватьКоррСчета Тогда
			
			НСтрока = тПараметрыПакетаВТ.Добавить();
			НСтрока.ИмяОтбора = "ПланСчетов_" + ДанныеДляРасчета.УИДСреза;
			НСтрока.ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НСтрока.ЗначениеОтбора = ДанныеДляРасчета.ПланСчетов;
			
		КонецЕсли;
	
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыГенерацииЗапросовРегистровИСправочниковВнешних

////////////////////////////////////////////////////////////////////////////////
// Процедуры для подготовки текстов запросов для подъема данных из внешних регистров и справочников
//
////////////////////////////////////////////////////////////////////////////////

Процедура ДобавитьПодзапросПоПроизвольномуКоду(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тПроизвольныйКод		= СтруктураРасчетаПоказателей.тПроизвольныйКод;
	Если тПроизвольныйКод.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мПодзапросыДанных		= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;	
	тПараметрыПакетаВТ		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	мПодзапросыДанныхВТ		= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тИспользуемыеАналитики	= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	
	ТекстРесурсы			= СтруктураПараметровТекущегоУровня.ТекстРесурсы;
	ТекстРесурсы = СтрЗаменить(ТекстРесурсы,"#ИмяТаблицы","ПроизвольныйКод");
	
	// Запрос для временной таблицы
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	ПроизвольныйКод.Показатель КАК Показатель,
	|	ПроизвольныйКод.ПериодОтчета КАК ПериодОтчета"+ТекстРесурсы+"
	|ПОМЕСТИТЬ втДанныеПроизвольныйКод
	|ИЗ
	|	&тзДанныеПроизвольныйКод КАК ПроизвольныйКод";
	
	нПараметр = тПараметрыПакетаВТ.Добавить();
	нПараметр.ИмяОтбора			= "тзДанныеПроизвольныйКод";
	нПараметр.ТипОтбора			= "ДанныеПроизвольныйКод";
	нПараметр.ЗначениеОтбора	= тПроизвольныйКод;
	
	// Добавим запрос в массив
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	// Сформируем текст аналитик и ресурсов
	ТекстАналитики = "";
	Для Каждого СтрАналитика Из тИспользуемыеАналитики Цикл
		ТекстАналитики = ТекстАналитики + ",
		|	НЕОПРЕДЕЛЕНО КАК " + СтрАналитика.Поле;
	КонецЦикла;
	
	// Подзапрос для запроса 0 уровня
	ТекстЗапроса = "
	|// ДАННЫЕ ИЗ ПРОИЗВОЛЬНОГО ЗАПРОСА
	|
	|ВЫБРАТЬ
	|	ПоказателиОперанды.УИДГруппыОтборов КАК УИДГруппыОтборов,
	|	ПроизвольныйКод.Показатель КАК Показатель,
	|	ПроизвольныйКод.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+"
	|ИЗ
	|	втПоказателиОперанды КАК ПоказателиОперанды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеПроизвольныйКод КАК ПроизвольныйКод
	|		ПО ПоказателиОперанды.ПоказательОперанд = ПроизвольныйКод.Показатель
	|		И ПоказателиОперанды.УровеньРасчетаОперанда = 1";
	
	// Добавим запрос в массив	
	мПодзапросыДанных.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Процедура ДобавитьПодзапросПоПроизвольномуЗапросу(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тПроизвольныеЗапросы = СтруктураРасчетаПоказателей.тПроизвольныеЗапросы;
	Если тПроизвольныеЗапросы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	тИспользуемыеРесурсы	= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	
	мПодзапросыДанных		= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тПараметрыПакетаВТ		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	мПодзапросыДанныхВТ		= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тИспользуемыеАналитики	= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	
	// Сформируем текст ресурсов
	ТекстРесурсов = СтрЗаменить(ТекстПолейРесурсов(тИспользуемыеРесурсы,0),"#ИмяТаблицы","ПроизвольныйЗапрос");
	
	// Сформируем текст аналитик
	ТекстАналитик = "";
	тПоляУровня = тИспользуемыеАналитики.Скопировать(Новый Структура("УровеньРасчета",0));
	тПоляУровня.Сортировать("ПолеВерсии УБЫВ");
	Для Каждого СтрПоле Из тПоляУровня Цикл
		Если СтрНачинаетсяС(СтрПоле.Поле, "Аналитика") Тогда
			// Это аналитика
			ТекстАналитик = ТекстАналитик + ",
			|	ПроизвольныйЗапрос." + СтрПоле.Поле + " КАК " + СтрПоле.Поле;
		Иначе
			// Прочие поля
			ТекстАналитик = ТекстАналитик + ",
			|	"""" КАК " + СтрПоле.Поле;
		КонецЕсли;
	КонецЦикла;
	
	// Запрос для временной таблицы
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	ПроизвольныйЗапрос.Показатель КАК Показатель,
	|	ПроизвольныйЗапрос.КодВФормуле КАК КодВФормуле,
	|	ПроизвольныйЗапрос.ПериодОтчета КАК ПериодОтчета"+ТекстАналитик+ТекстРесурсов+"
	|ПОМЕСТИТЬ втДанныеПроизвольныйЗапрос
	|ИЗ
	|	&тзДанныеПроизвольныйЗапрос КАК ПроизвольныйЗапрос";
	
	нПараметр = тПараметрыПакетаВТ.Добавить();
	нПараметр.ИмяОтбора = "тзДанныеПроизвольныйЗапрос";
	нПараметр.ТипОтбора = "ДанныеПроизвольныйЗапрос";
	нПараметр.ЗначениеОтбора = тПроизвольныеЗапросы;
	
	// Добавим запрос в массив
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	// Подзапрос для запроса 0 уровня
	ТекстЗапроса = "
	|// ДАННЫЕ ИЗ ПРОИЗВОЛЬНОГО ЗАПРОСА
	|
	|ВЫБРАТЬ
	|	тПоказателиОперанды.УИДГруппыОтборов КАК УИДГруппыОтборов,
	|	ПроизвольныйЗапрос.Показатель КАК Показатель,
	|	ПроизвольныйЗапрос.ПериодОтчета КАК ПериодОтчета"+ТекстАналитик+ТекстРесурсов+"
	|ИЗ
	|	втПоказателиОперанды КАК тПоказателиОперанды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеПроизвольныйЗапрос КАК ПроизвольныйЗапрос
	|		ПО тПоказателиОперанды.ПоказательОперанд = ПроизвольныйЗапрос.Показатель
	|		И тПоказателиОперанды.КодВФормуле = ПроизвольныйЗапрос.КодВФормуле
	|		И тПоказателиОперанды.УровеньРасчетаОперанда = 1";
	
	// Добавим запрос в массив
	мПодзапросыДанных.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Процедура ДобавитьПодзапросПоИсточникуВнешнему(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тВнешниеДанные = СтруктураРасчетаПоказателей.тВнешниеДанные;
	Если тВнешниеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мПодзапросыДанных		= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тПараметрыПакетаВТ		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	мПодзапросыДанныхВТ		= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тИспользуемыеАналитики	= СтруктураПараметровТекущегоУровня.тИспользуемыеАналитики;
	
	// Сформируем текст ресурсов
	ТекстРесурсов = СтруктураПараметровТекущегоУровня.ТекстРесурсы;
	ТекстРесурсов = СтрЗаменить(ТекстРесурсов,"#ИмяТаблицы","ВнешниеДанные");
	
	// Сформируем текст аналитик
	ТекстАналитик = СтрЗаменить(ТекстПолейАналитик(тИспользуемыеАналитики,0),"#ИмяТаблицы","ВнешниеДанные");	
	
	// Запрос для временной таблицы
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	ВнешниеДанные.Показатель КАК Показатель,
	|	ВнешниеДанные.КодВФормуле КАК КодВФормуле,
	|	ВнешниеДанные.ПериодОтчета КАК ПериодОтчета"+ТекстАналитик+ТекстРесурсов+"
	|ПОМЕСТИТЬ втДанныеВнешнийИсточник
	|ИЗ
	|	&тзДанныеВнешнийИсточник КАК ВнешниеДанные";
	
	нПараметр = тПараметрыПакетаВТ.Добавить();
	нПараметр.ИмяОтбора = "тзДанныеВнешнийИсточник";
	нПараметр.ТипОтбора = "ДанныеВнешнийИсточник";
	нПараметр.ЗначениеОтбора = тВнешниеДанные;
	
	// Добавим запрос в массив
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	// Подзапрос для запроса 0 уровня
	ТекстЗапроса = "
	|// ДАННЫЕ ИЗ ВНЕШНИХ ИСТОЧНИКОВ
	|
	|ВЫБРАТЬ
	|	тПоказателиОперанды.УИДГруппыОтборов КАК УИДГруппыОтборов,
	|	ВнешниеДанные.Показатель КАК Показатель,
	|	ВнешниеДанные.ПериодОтчета КАК ПериодОтчета"+ТекстАналитик+ТекстРесурсов+"
	|ИЗ
	|	втПоказателиОперанды КАК тПоказателиОперанды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеВнешнийИсточник КАК ВнешниеДанные
	|		ПО тПоказателиОперанды.ПоказательОперанд = ВнешниеДанные.Показатель
	|		И тПоказателиОперанды.КодВФормуле = ВнешниеДанные.КодВФормуле
	|		И тПоказателиОперанды.УровеньРасчетаОперанда = 1";
	
	// Добавим запрос в массив
	мПодзапросыДанных.Добавить(ТекстЗапроса);
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыПодготовкиЗапросовДляРасчетаВыраженийОперандов

////////////////////////////////////////////////////////////////////////////////
// Процедуры для подготовки текстов запросов для расчета операндов
//
////////////////////////////////////////////////////////////////////////////////

Процедура ДобавитьПодзапросОперандовРучнойПодсчет(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы		= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	МаксИспользуемыхАналитик	= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	МаксКлючевыхАналитик		= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	ЕстьАналитикаВалюта			= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	УровниСВременнымРасчетом	= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	
	мПодзапросыДанных			= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тПараметрыПакета			= СтруктураПараметровТекущегоУровня.тПараметрыПакета;
	мПодзапросыДанныхВТ			= СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ;
	тПараметрыПакетаВТ			= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
	УровеньРасчета				= СтруктураПараметровТекущегоУровня.УровеньРасчета;
	ПоказателиТекущегоУровня	= СтруктураПараметровТекущегоУровня.ПоказателиТекущегоУровня;
	РекурсивныйРасчетПериодов	= СтруктураПараметровТекущегоУровня.РекурсивныйРасчетПериодов;
	
	// Текст замен
	ТекстУровеньРасчета = Формат(УровеньРасчета, "ЧН=0; ЧГ=0");
	ТекстИндексТаблицы = ТекстУровеньРасчета + ?(РекурсивныйРасчетПериодов, "_#ИндексПериода", "");
	
	// Замены текстов аналитик
	ТекстАналитики = ТекстПолейАналитик(тИспользуемыеАналитики, УровеньРасчета);
	ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы","ЗначенияПоказателей");
	
	// Замеры текстов ресурсов
	ТекстРесурсы = ТекстПолейРесурсов(тИспользуемыеРесурсы, УровеньРасчета);
	ТекстРесурсы = СтрЗаменить(ТекстРесурсы,"#ИмяТаблицы","ЗначенияПоказателей");
	
	// Установим флаг временного расчета
	Если УровниСВременнымРасчетом.Найти(УровеньРасчета) = Неопределено Тогда
		ТекстВременныйРасчет = "";
		ТекстВременныйРасчетСоединение = "";
	Иначе
		ТекстВременныйРасчет = ",
		|	ПоказателиОперанды.ВременныйРасчет КАК ВременныйРасчет";
		ТекстВременныйРасчетСоединение = "
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
		|		(ВЫБРАТЬ
		|			ПоказателиОперанды.Потребитель,
		|			МАКСИМУМ(ПоказателиОперанды.ВременныйРасчет) КАК ВременныйРасчет
		|		ИЗ
		|			втПоказателиОперанды КАК ПоказателиОперанды
		|		СГРУППИРОВАТЬ ПО
		|			ПоказателиОперанды.Потребитель) КАК ПоказателиОперанды
		|		ПО ЗначенияПоказателей.Показатель = ПоказателиОперанды.Потребитель";
	КонецЕсли;
		
	// Создадим таблицу с формулами для расчета
	тФормулыДляРасчетаВКоде = Новый ТаблицаЗначений;
	тФормулыДляРасчетаВКоде.Колонки.Добавить("Потребитель");
	тФормулыДляРасчетаВКоде.Колонки.Добавить("ТипПотребителя");
	тФормулыДляРасчетаВКоде.Колонки.Добавить("ФормулаРасчета");
	тФормулыДляРасчетаВКоде.Колонки.Добавить("ПоказателиДляРасчета");
	тФормулыДляРасчетаВКоде.Колонки.Добавить("Синтетика");
	
	ПоказателиДляРасчета = Новый ТаблицаЗначений;
	ПоказателиДляРасчета.Колонки.Добавить("Показатель");
	ПоказателиДляРасчета.Колонки.Добавить("ТипПоказателя");
	ПоказателиДляРасчета.Колонки.Добавить("КодВФормуле");
	ПоказателиДляРасчета.Колонки.Добавить("УИДГруппыОтборов");
	ПоказателиДляРасчета.Колонки.Добавить("УИДГруппыТрансформации");
	
	Для Каждого СтрПоказатель Из ПоказателиТекущегоУровня Цикл
		
		Если Не ЗначениеЗаполнено(СтрПоказатель.Потребитель) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрФормулаДляРасчета = тФормулыДляРасчетаВКоде.Найти(СтрПоказатель.Потребитель,"Потребитель");
		Если СтрФормулаДляРасчета = Неопределено Тогда
			СтрФормулаДляРасчета						= тФормулыДляРасчетаВКоде.Добавить();
			ЗаполнитьЗначенияСвойств(СтрФормулаДляРасчета,СтрПоказатель);
			СтрФормулаДляРасчета.ФормулаРасчета			= СтрПоказатель.Процедура;
			СтрФормулаДляРасчета.Синтетика				= СтрПоказатель.ЧислоАналитик = 0 И НЕ СтрПоказатель.ЕстьАналитикаВалюта;
			СтрФормулаДляРасчета.ПоказателиДляРасчета	= ПоказателиДляРасчета.Скопировать();
		КонецЕсли;
		
		СтрокаПоказателя = СтрФормулаДляРасчета.ПоказателиДляРасчета.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоказателя,СтрПоказатель);
		СтрокаПоказателя.Показатель = СтрПоказатель.ПоказательОперанд;
		
	КонецЦикла;
	
	СтруктураОтбора	= Новый Структура;
	СтруктураОтбора.Вставить("МаксИспользуемыхАналитик", МаксИспользуемыхАналитик);
	СтруктураОтбора.Вставить("МаксКлючевыхАналитик", МаксКлючевыхАналитик);
	СтруктураОтбора.Вставить("ЕстьАналитикаВалюта", ЕстьАналитикаВалюта);
	СтруктураОтбора.Вставить("тФормулыДляРасчетаВКоде", тФормулыДляРасчетаВКоде);
	
	нСтрПараметр				= тПараметрыПакетаВТ.Добавить();
	нСтрПараметр.ИмяОтбора		= "тзРассчитанныеЗначения_" + ТекстИндексТаблицы;
	нСтрПараметр.ТипОтбора		= "РассчитанныеЗначения";
	нСтрПараметр.ЗначениеОтбора	= СтруктураОтбора;
	
	// Запрос с временной таблицей
	ТекстЗапроса = "
	|// ВРЕМЕННАЯ ТАБЛИЦА С РАССЧИТАННЫМИ ДАННЫМИ УРОВЕНЬ - "+ТекстУровеньРасчета+" 
	|
	|ВЫБРАТЬ
	|	ЗначенияПоказателей.Показатель КАК Показатель,
	|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+"
	|ПОМЕСТИТЬ втРассчитанныеЗначения_" + ТекстИндексТаблицы + "
	|ИЗ
	|	&тзРассчитанныеЗначения_" + ТекстИндексТаблицы + " КАК ЗначенияПоказателей";
	
	мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = "
	|// РАСЧЕТ ПОКАЗАТЕЛЕЙ БЕЗ ФОРМУЛ УРОВЕНЬ - "+ТекстУровеньРасчета+"
	|
	|ВЫБРАТЬ 
	|	ЗначенияПоказателей.Показатель КАК Показатель,
	|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+ТекстВременныйРасчет+"
	|ИЗ
	|	втРассчитанныеЗначения_" + ТекстИндексТаблицы + " КАК ЗначенияПоказателей"+ТекстВременныйРасчетСоединение;

	мПодзапросыДанных.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Процедура ДобавитьПодзапросОперандовБезФормул(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)
	
	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы		= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	УровниСВременнымРасчетом	= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	ЕстьДополненияАналитик		= СтруктураРасчетаПоказателей.ЕстьДополненияАналитик;
	
	мПодзапросыДанных			= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	УровеньРасчетаПотребителя	= СтруктураПараметровТекущегоУровня.УровеньРасчета;	
	ПоказателиТекущегоУровня	= СтруктураПараметровТекущегоУровня.ПоказателиТекущегоУровня; 
	РекурсивныйРасчетПериодов	= СтруктураПараметровТекущегоУровня.РекурсивныйРасчетПериодов;
	
	// Текст замен
	ТекстУровеньРасчетаПотребителя = Формат(УровеньРасчетаПотребителя, "ЧН=0; ЧГ=0");
	
	// Установим флаг временного расчета
	Если УровниСВременнымРасчетом.Найти(УровеньРасчетаПотребителя) = Неопределено Тогда
		ТекстВременныйРасчет = "";
	Иначе
		ТекстВременныйРасчет = ",
		|	ПоказателиОперанды.ВременныйРасчет КАК ВременныйРасчет";
	КонецЕсли;
	
	// Установим фильтр по дополнению аналитик
	Если ЕстьДополненияАналитик Тогда
		ТекстУсловиеДляДополненияАналитик = "
		|		И НЕ ПоказателиОперанды.ДляДополненияАналитик";
	Иначе
		ТекстУсловиеДляДополненияАналитик = "";
	КонецЕсли;
	
	// Установим отбор по периоду
	Если РекурсивныйРасчетПериодов Тогда
		ТекстУсловиеДляПериода = "
		|		И ПоказателиОперанды.РекурсивныйРасчетПериодов = ИСТИНА
		|		И ЗначенияПоказателей.ПериодОтчета = &РасчетныйПериод"; 
	Иначе
		ТекстУсловиеДляПериода = "
		|		И ПоказателиОперанды.РекурсивныйРасчетПериодов = ЛОЖЬ";
	КонецЕсли;
		
	// Замены текстов аналитик
	ТекстАналитики = ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчетаПотребителя);
	ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы","ЗначенияПоказателей"); 

	// Формируем тексты запросов
	ИспользуемыеПредыдущиеУровниОперандов = ПоказателиТекущегоУровня.Скопировать(Новый Структура("УровеньРасчетаПотребителя",УровеньРасчетаПотребителя));
	ИспользуемыеПредыдущиеУровниОперандов.Свернуть("УровеньРасчетаОперанда");	
	Для Каждого СтрУровеньИспОперандов Из ИспользуемыеПредыдущиеУровниОперандов Цикл
		
		УровеньРасчетаОперанда = СтрУровеньИспОперандов.УровеньРасчетаОперанда-1;		
		ТекстУровеньРасчетаОперандаИсходный = Формат(УровеньРасчетаОперанда,"ЧГ=0;ЧН=0"); 
		ТекстУровеньРасчетаОперанда = Формат(СтрУровеньИспОперандов.УровеньРасчетаОперанда,"ЧГ=0;ЧН=0");
		
		// Сформируем текст ресурсов
		ТекстРесурсы = "";
		тПоляУровняПотребителя = тИспользуемыеРесурсы.Скопировать(Новый Структура("УровеньРасчета",УровеньРасчетаПотребителя), "Поле");
		тПоляУровняОперанда = тИспользуемыеРесурсы.Скопировать(Новый Структура("УровеньРасчета",УровеньРасчетаОперанда), "Поле");
		Для Каждого СтрокаТаблицы Из тПоляУровняПотребителя Цикл
			Если тПоляУровняОперанда.Найти(СтрокаТаблицы.Поле, "Поле") = Неопределено Тогда
				Если СтрокаТаблицы.Поле = "Значение" Тогда
					ТекстРесурсы = ТекстРесурсы + ",
					|	0 КАК Значение";
				Иначе
					ТекстРесурсы = ТекстРесурсы + ",
					|	НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловое";
				КонецЕсли;
			Иначе
				ТекстРесурсы = ТекстРесурсы + ",
				|	ЗначенияПоказателей." + СтрокаТаблицы.Поле + " КАК " + СтрокаТаблицы.Поле;
			КонецЕсли;
		КонецЦикла;

		Если УровеньРасчетаОперанда = 0 Тогда
			ТекстУсловияСоединения = "
			|		И ПоказателиОперанды.КодВФормуле = ЗначенияПоказателей.КодВФормуле";
		Иначе
			ТекстУсловияСоединения = "
			|		И ПоказателиОперанды.ПоказательОперанд = ЗначенияПоказателей.Показатель
			|		И ПоказателиОперанды.УИДГруппыОтборов = ЗначенияПоказателей.УИДГруппыОтборов
			|		И ПоказателиОперанды.УИДГруппыТрансформации = ЗначенияПоказателей.УИДГруппыТрансформации";
		КонецЕсли;
		
		ТекстЗапроса = "
		|// РАСЧЕТ ПОКАЗАТЕЛЕЙ БЕЗ ФОРМУЛ УРОВЕНЬ - "+ТекстУровеньРасчетаПотребителя+"
		|
		|ВЫБРАТЬ 
		|	ПоказателиОперанды.Потребитель КАК Показатель,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+ТекстВременныйРасчет+"
		|ИЗ
		|	втПоказателиОперанды КАК ПоказателиОперанды
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗначенияОперандов"+ТекстУровеньРасчетаОперандаИсходный+" КАК ЗначенияПоказателей
		|		ПО ПоказателиОперанды.ВариантРасчета = 2
		|		И ПоказателиОперанды.УровеньРасчетаПотребителя = "+ТекстУровеньРасчетаПотребителя+"
		|		И ПоказателиОперанды.УровеньРасчетаОперанда = "+ТекстУровеньРасчетаОперанда+ТекстУсловиеДляДополненияАналитик+ТекстУсловиеДляПериода+ТекстУсловияСоединения;
		
		мПодзапросыДанных.Добавить(ТекстЗапроса);

	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПодзапросОперандовТолькоСумма(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)

	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы		= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	УровниСВременнымРасчетом	= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	ЕстьДополненияАналитик		= СтруктураРасчетаПоказателей.ЕстьДополненияАналитик;
	
	мПодзапросыДанных			= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	УровеньРасчетаПотребителя	= СтруктураПараметровТекущегоУровня.УровеньРасчета;
	ПоказателиТекущегоУровня	= СтруктураПараметровТекущегоУровня.ПоказателиТекущегоУровня;
	РекурсивныйРасчетПериодов	= СтруктураПараметровТекущегоУровня.РекурсивныйРасчетПериодов;
	
	// Текст замен
	ТекстУровеньРасчетаПотребителя = Формат(УровеньРасчетаПотребителя, "ЧН=0; ЧГ=0");
	
	// Установим флаг временного расчета
	Если УровниСВременнымРасчетом.Найти(УровеньРасчетаПотребителя) = Неопределено Тогда
		ТекстВременныйРасчет = "";
		ТекстВременныйРасчетУр1 = "";
	Иначе
		ТекстВременныйРасчет = ",
		|		ПоказателиОперанды.ВременныйРасчет КАК ВременныйРасчет";
		ТекстВременныйРасчетУр1 = ",
		|	МАКСИМУМ(ЗначенияПоказателей.ВременныйРасчет) КАК ВременныйРасчет";
	КонецЕсли;
	
	// Установим фильтр по дополнению аналитик
	Если ЕстьДополненияАналитик Тогда
		ТекстУсловиеДляДополненияАналитик = "
		|			И НЕ ПоказателиОперанды.ДляДополненияАналитик";
	Иначе
		ТекстУсловиеДляДополненияАналитик = "";
	КонецЕсли;
	
	// Установим отбор по периоду
	Если РекурсивныйРасчетПериодов Тогда
		ТекстУсловиеДляПериода = "
		|			И ПоказателиОперанды.РекурсивныйРасчетПериодов = ИСТИНА
		|			И ЗначенияПоказателей.ПериодОтчета = &РасчетныйПериод";
	Иначе
		ТекстУсловиеДляПериода = "
		|			И ПоказателиОперанды.РекурсивныйРасчетПериодов = ЛОЖЬ";
	КонецЕсли;	
	
	// Замены текстов аналитик
	ТекстАналитики = ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчетаПотребителя);
	ТекстАналитикиУр1 = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы", "ЗначенияПоказателей");
	ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы", Символы.Таб + "ЗначенияПоказателей");
	
	ТекстАналитикиГруппировка = ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчетаПотребителя,3);
	ТекстАналитикиГруппировка = СтрЗаменить(ТекстАналитикиГруппировка, "#ИмяТаблицы", "ЗначенияПоказателей");
		
	// Замены текстов ресурсов
	ТекстРесурсыУр1 = ТекстПолейРесурсов(тИспользуемыеРесурсы,УровеньРасчетаПотребителя,2);
	ТекстРесурсыУр1 = СтрЗаменить(ТекстРесурсыУр1,"#ИмяТаблицы","ЗначенияПоказателей");

	ТекстРесурсыГруппировка = ТекстПолейРесурсов(тИспользуемыеРесурсы,УровеньРасчетаПотребителя,3);
	ТекстРесурсыГруппировка = СтрЗаменить(ТекстРесурсыГруппировка,"#ИмяТаблицы","ЗначенияПоказателей");
	
	// Формируем текст вложенного запроса
	ТекстВложенногоЗапроса = "";
	ИспользуемыеПредыдущиеУровниОперандов = ПоказателиТекущегоУровня.Скопировать(Новый Структура("УровеньРасчетаПотребителя",УровеньРасчетаПотребителя),"УровеньРасчетаОперанда");
	ИспользуемыеПредыдущиеУровниОперандов.Свернуть("УровеньРасчетаОперанда");
	Для Каждого СтрУровеньИспОперандов Из ИспользуемыеПредыдущиеУровниОперандов Цикл
		
		УровеньРасчетаОперанда = СтрУровеньИспОперандов.УровеньРасчетаОперанда-1;
		ТекстУровеньРасчетаОперандаИсходный = Формат(УровеньРасчетаОперанда, "ЧГ=0; ЧН=0");
		ТекстУровеньРасчетаОперанда = Формат(СтрУровеньИспОперандов.УровеньРасчетаОперанда, "ЧГ=0; ЧН=0");
		
		// Сформируем текст ресурсов
		ТекстРесурсы = "";
		тПоляУровняПотребителя = тИспользуемыеРесурсы.Скопировать(Новый Структура("УровеньРасчета",УровеньРасчетаПотребителя), "Поле");
		тПоляУровняОперанда = тИспользуемыеРесурсы.Скопировать(Новый Структура("УровеньРасчета",УровеньРасчетаОперанда), "Поле");
		Для Каждого СтрокаТаблицы Из тПоляУровняПотребителя Цикл
			Если тПоляУровняОперанда.Найти(СтрокаТаблицы.Поле, "Поле") = Неопределено Тогда
				Если СтрокаТаблицы.Поле = "Значение" Тогда
					ТекстРесурсы = ТекстРесурсы + ",
					|		0 КАК Значение";
				Иначе
					ТекстРесурсы = ТекстРесурсы + ",
					|		НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловое";
				КонецЕсли;
			Иначе
				ТекстРесурсы = ТекстРесурсы + ",
				|		ЗначенияПоказателей." + СтрокаТаблицы.Поле + " КАК " + СтрокаТаблицы.Поле;
			КонецЕсли;
		КонецЦикла;

		// Условие соединения
		Если УровеньРасчетаОперанда = 0 Тогда
			ТекстУсловияСоединения = "
			|			И ПоказателиОперанды.КодВФормуле = ЗначенияПоказателей.КодВФормуле";
		Иначе
			ТекстУсловияСоединения = "
			|			И ПоказателиОперанды.ПоказательОперанд = ЗначенияПоказателей.Показатель
			|			И ПоказателиОперанды.УИДГруппыОтборов = ЗначенияПоказателей.УИДГруппыОтборов
			|			И ПоказателиОперанды.УИДГруппыТрансформации = ЗначенияПоказателей.УИДГруппыТрансформации";
		КонецЕсли;
		
		ТекстВложенногоЗапроса = ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов(ТекстВложенногоЗапроса, 1) + "
		|	ВЫБРАТЬ
		|		ПоказателиОперанды.Потребитель КАК Потребитель,
		|		ПоказателиОперанды.ПоказательОперанд КАК Показатель,
		|		ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+ТекстВременныйРасчет+"
		|	ИЗ
		|		втПоказателиОперанды КАК ПоказателиОперанды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗначенияОперандов"+ТекстУровеньРасчетаОперандаИсходный+" КАК ЗначенияПоказателей
		|			ПО ПоказателиОперанды.ВариантРасчета = 3
		|			И ПоказателиОперанды.УровеньРасчетаПотребителя = "+ТекстУровеньРасчетаПотребителя+"
		|			И ПоказателиОперанды.УровеньРасчетаОперанда = "+ТекстУровеньРасчетаОперанда+ТекстУсловиеДляДополненияАналитик+ТекстУсловиеДляПериода+ТекстУсловияСоединения;
	
	КонецЦикла;
	
	ТекстЗапроса = "
		|// РАСЧЕТ ПОКАЗАТЕЛЕЙ АГРЕГАЦИЕЙ УРОВЕНЬ - "+ТекстУровеньРасчетаПотребителя+"
		|
		|ВЫБРАТЬ
		|	ЗначенияПоказателей.Потребитель КАК Показатель,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитикиУр1+ТекстРесурсыУр1+ТекстВременныйРасчетУр1+"
		|ИЗ
		|	(
		|"+ТекстВложенногоЗапроса+"
		|	) КАК ЗначенияПоказателей
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗначенияПоказателей.Потребитель,
		|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитикиГруппировка+ТекстРесурсыГруппировка;
	
	мПодзапросыДанных.Добавить(ТекстЗапроса);
		
КонецПроцедуры

Процедура ДобавитьПодзапросОперандовВыражение(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня)

	тИспользуемыеАналитики		= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы		= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	УровниСВременнымРасчетом	= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	ЕстьДополненияАналитик		= СтруктураРасчетаПоказателей.ЕстьДополненияАналитик;
	
	мПодзапросыДанных			= СтруктураПараметровТекущегоУровня.мПодзапросыДанных;
	тПараметрыПакета			= СтруктураПараметровТекущегоУровня.тПараметрыПакета;
	УровеньРасчетаПотребителя	= СтруктураПараметровТекущегоУровня.УровеньРасчета;
	ПоказателиТекущегоУровня	= СтруктураПараметровТекущегоУровня.ПоказателиТекущегоУровня;
	РекурсивныйРасчетПериодов	= СтруктураПараметровТекущегоУровня.РекурсивныйРасчетПериодов;
	
	// Текст замен
	ТекстУровеньРасчетаПотребителя = Формат(УровеньРасчетаПотребителя, "ЧН=0; ЧГ=0");
	
	// Установим флаг временного расчета
	Если УровниСВременнымРасчетом.Найти(УровеньРасчетаПотребителя) = Неопределено Тогда
		ТекстВременныйРасчет = "";
		ТекстВременныйРасчетУр1 = "";
		ТекстВременныйРасчетУр2 = "";
	Иначе
		ТекстВременныйРасчет = ",
		|	ПоказателиОперанды.ВременныйРасчет КАК ВременныйРасчет";
		ТекстВременныйРасчетУр1 = ",
		|	МАКСИМУМ(ВложенныйЗапросУр1.ВременныйРасчет) КАК ВременныйРасчет";
		ТекстВременныйРасчетУр2 = ",
		|	ВложенныйЗапросУр2.ВременныйРасчет КАК ВременныйРасчет";
	КонецЕсли;
	
	// Установим фильтр по дополнению аналитик
	Если ЕстьДополненияАналитик Тогда
		ТекстУсловиеДляДополненияАналитик = "
		|				И НЕ ПоказателиОперанды.ДляДополненияАналитик";
	Иначе
		ТекстУсловиеДляДополненияАналитик = "";
	КонецЕсли;
	
	// Установим отбор по периоду
	Если РекурсивныйРасчетПериодов Тогда
		ТекстУсловиеДляПериода = "
		|				И ПоказателиОперанды.РекурсивныйРасчетПериодов = ИСТИНА
		|				И ЗначенияПоказателей.ПериодОтчета = &РасчетныйПериод"; 
	Иначе
		ТекстУсловиеДляПериода = "
		|				И ПоказателиОперанды.РекурсивныйРасчетПериодов = ЛОЖЬ";
	КонецЕсли;
		
	// Замены текстов аналитик
	ТекстАналитики = ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчетаПотребителя);
	ТекстАналитикиУр1 = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы", Символы.Таб + "ВложенныйЗапросУр1");
	ТекстАналитикиУр2 = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы", "ВложенныйЗапросУр2");
	ТекстАналитики = СтрЗаменить(ТекстАналитики,"#ИмяТаблицы", Символы.Таб + Символы.Таб + "ЗначенияПоказателей");
	ТекстАналитикиГруппировка = ТекстПолейАналитик(тИспользуемыеАналитики, УровеньРасчетаПотребителя, 3);
	ТекстАналитикиГруппировка = СтрЗаменить(ТекстАналитикиГруппировка,"#ИмяТаблицы","ВложенныйЗапросУр1");
	
	ТекстРесурсовОбщий = ТекстПолейРесурсов(тИспользуемыеРесурсы, УровеньРасчетаПотребителя);
	
	// Формируем тексты запросов
	ИндексПотребителя = 1;
	ПотребителиТекущегоУровня = ПоказателиТекущегоУровня.Скопировать(,"Потребитель,ТипПотребителя,Процедура");
	ПотребителиТекущегоУровня.Свернуть("Потребитель,ТипПотребителя,Процедура");
	Для Каждого стрПотребитель Из ПотребителиТекущегоУровня Цикл
		
		// Получим выражения для ресурсов итогового запроса
		ТекстДляЯзыкаЗапросов = ТекстПроцедурыДляЯзыкаЗапросов(стрПотребитель.Процедура,"ВложенныйЗапросУр2");
		Если стрПотребитель.ТипПотребителя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			ТекстРесурсыУр2 = СтрЗаменить(ТекстРесурсовОбщий,"#ИмяТаблицы.ЗначениеНечисловое","НЕОПРЕДЕЛЕНО");
			ТекстРесурсыУр2 = СтрЗаменить(ТекстРесурсыУр2,"#ИмяТаблицы.Значение","ВЫРАЗИТЬ(" + ТекстДляЯзыкаЗапросов + " КАК ЧИСЛО(18,5))");
		Иначе
			ТекстРесурсыУр2 = СтрЗаменить(ТекстРесурсовОбщий,"#ИмяТаблицы.ЗначениеНечисловое",ТекстДляЯзыкаЗапросов);
			ТекстРесурсыУр2 = СтрЗаменить(ТекстРесурсыУр2,"#ИмяТаблицы.Значение","0");
		КонецЕсли;
		ТекстРесурсы = "";
		ТекстРесурсыУр1 = "";
		
		// Получим выражения для ресурсов вложенного запроса
		УровниРасчетаОперандов = Новый Массив;
		ИспользуемыеПредыдущиеУровниОперандов = ПоказателиТекущегоУровня.Скопировать(Новый Структура("Потребитель,УровеньРасчетаПотребителя",стрПотребитель.Потребитель,УровеньРасчетаПотребителя));
		тКодВФормуле = ИспользуемыеПредыдущиеУровниОперандов.Скопировать(,"ТипПоказателя,КодВФормуле");
		тКодВФормуле.Свернуть("ТипПоказателя,КодВФормуле");
		Для Каждого СтрОперанд Из тКодВФормуле Цикл
			
			Если СтрНайти(ТекстДляЯзыкаЗапросов,СтрОперанд.КодВФормуле) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Отбор по показателями
			НОтбор					= тПараметрыПакета.Добавить();
			НОтбор.ИмяОтбора		= "Параметр_"+СтрОперанд.КодВФормуле;
			НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			НОтбор.ЗначениеОтбора	= СтрОперанд.КодВФормуле;
			
			Если СтрОперанд.ТипПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
				ТекстРесурсы = ТекстРесурсы+",
				|			ВЫБОР КОГДА ПоказателиОперанды.КодВФормуле = &"+НОтбор.ИмяОтбора+" ТОГДА ЗначенияПоказателей.Значение ИНАЧЕ 0 КОНЕЦ КАК _"+СтрОперанд.КодВФормуле;
				ТекстРесурсыУр1 = ТекстРесурсыУр1+",
				|		СУММА(ВложенныйЗапросУр1._"+СтрОперанд.КодВФормуле+") КАК _"+СтрОперанд.КодВФормуле;
			ИначеЕсли СтрОперанд.ТипПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
				ТекстРесурсы = ТекстРесурсы+",
				|			ВЫБОР КОГДА ПоказателиОперанды.КодВФормуле = &"+НОтбор.ИмяОтбора+" ТОГДА ВЫРАЗИТЬ(ЗначенияПоказателей.ЗначениеНечисловое КАК БУЛЕВО) ИНАЧЕ ЛОЖЬ КОНЕЦ КАК _"+СтрОперанд.КодВФормуле;
				ТекстРесурсыУр1 = ТекстРесурсыУр1+",
				|		МАКСИМУМ(ВложенныйЗапросУр1._"+СтрОперанд.КодВФормуле+") КАК _"+СтрОперанд.КодВФормуле;
			ИначеЕсли СтрОперанд.ТипПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
				ТекстРесурсы = ТекстРесурсы+",
				|			ВЫБОР КОГДА ПоказателиОперанды.КодВФормуле = &"+НОтбор.ИмяОтбора+" ТОГДА ВЫРАЗИТЬ(ЗначенияПоказателей.ЗначениеНечисловое КАК ДАТА) ИНАЧЕ ДАТАВРЕМЯ(1,1,1) КОНЕЦ КАК _"+СтрОперанд.КодВФормуле;
				ТекстРесурсыУр1 = ТекстРесурсыУр1+",
				|		МАКСИМУМ(ВложенныйЗапросУр1._"+СтрОперанд.КодВФормуле+") КАК _"+СтрОперанд.КодВФормуле;
			ИначеЕсли СтрОперанд.ТипПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
				ТекстРесурсы = ТекстРесурсы+",
				|			ВЫБОР КОГДА ПоказателиОперанды.КодВФормуле = &"+НОтбор.ИмяОтбора+" ТОГДА ВЫРАЗИТЬ(ЗначенияПоказателей.ЗначениеНечисловое КАК СТРОКА(1024)) ИНАЧЕ """" КОНЕЦ КАК _"+СтрОперанд.КодВФормуле;
				ТекстРесурсыУр1 = ТекстРесурсыУр1+",
				|		МАКСИМУМ(ВложенныйЗапросУр1._"+СтрОперанд.КодВФормуле+") КАК _"+СтрОперанд.КодВФормуле;
			КонецЕсли;
		
		КонецЦикла;
		
		// Отбор по потребителями
		НОтбор					= тПараметрыПакета.Добавить();
		НОтбор.ИмяОтбора		= "Потребитель_"+Формат(ИндексПотребителя, "ЧГ=0; ЧН=0");
		НОтбор.ТипОтбора		= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		НОтбор.ЗначениеОтбора	= стрПотребитель.Потребитель;
		ИндексПотребителя		= ИндексПотребителя + 1;
		
		// Получим текст вложенного запроса
		ТекстВложенногоЗапроса = "";
		тУровниРасчетаОперандов = ИспользуемыеПредыдущиеУровниОперандов.Скопировать(,"УровеньРасчетаОперанда");
		тУровниРасчетаОперандов.Свернуть("УровеньРасчетаОперанда");
		Для Каждого СтрокаУровеньРасчетаОперанда Из тУровниРасчетаОперандов Цикл
			
			ТекстУровеньРасчетаОперандаИсходный = Формат(СтрокаУровеньРасчетаОперанда.УровеньРасчетаОперанда-1, "ЧГ=0; ЧН=0");
			ТекстУровеньРасчетаОперанда = Формат(СтрокаУровеньРасчетаОперанда.УровеньРасчетаОперанда, "ЧГ=0; ЧН=0");
			
			Если СтрокаУровеньРасчетаОперанда.УровеньРасчетаОперанда = 1 Тогда
				ТекстУсловияСоединения = "
				|				И ПоказателиОперанды.КодВФормуле = ЗначенияПоказателей.КодВФормуле";
			Иначе
				ТекстУсловияСоединения = "
				|				И ПоказателиОперанды.ПоказательОперанд = ЗначенияПоказателей.Показатель
				|				И ПоказателиОперанды.УИДГруппыОтборов = ЗначенияПоказателей.УИДГруппыОтборов
				|				И ПоказателиОперанды.УИДГруппыТрансформации = ЗначенияПоказателей.УИДГруппыТрансформации";
			КонецЕсли;
			
			ТекстВложенногоЗапроса = ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов(ТекстВложенногоЗапроса, 1) +"
			|		ВЫБРАТЬ
			|			ПоказателиОперанды.Потребитель КАК Потребитель,
			|			ПоказателиОперанды.ПоказательОперанд КАК Показатель,
			|			ПоказателиОперанды.КодВФормуле КАК КодВФормуле,
			|			ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+ТекстВременныйРасчет+"
			|		ИЗ
			|			втПоказателиОперанды КАК ПоказателиОперанды
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗначенияОперандов"+ТекстУровеньРасчетаОперандаИсходный+" КАК ЗначенияПоказателей
			|				ПО ПоказателиОперанды.ВариантРасчета = 4
			|				И ПоказателиОперанды.УровеньРасчетаПотребителя = "+ТекстУровеньРасчетаПотребителя+"
			|				И ПоказателиОперанды.УровеньРасчетаОперанда = "+ТекстУровеньРасчетаОперанда+ТекстУсловиеДляДополненияАналитик+ТекстУсловиеДляПериода+ТекстУсловияСоединения+"
			|		ГДЕ 
			|			ПоказателиОперанды.Потребитель = &"+НОтбор.ИмяОтбора;
			
		КонецЦикла;
			
		// Текст итогового запроса
		ТекстЗапроса = "
			|// РАСЧЕТ ПОКАЗАТЕЛЕЙ ФОРМУЛОЙ В ЗАПРОСЕ УРОВЕНЬ - "+ТекстУровеньРасчетаПотребителя+"
			|
			|ВЫБРАТЬ
			|	ВложенныйЗапросУр2.Показатель КАК Показатель, 
			|	ВложенныйЗапросУр2.ПериодОтчета КАК ПериодОтчета "+ТекстАналитикиУр2+ТекстРесурсыУр2+ТекстВременныйРасчетУр2+"
			|ИЗ
			|	(
			|	ВЫБРАТЬ
			|		ВложенныйЗапросУр1.Потребитель КАК Показатель,
			|		ВложенныйЗапросУр1.ПериодОтчета КАК ПериодОтчета"+ТекстАналитикиУр1+ТекстРесурсыУр1+ТекстВременныйРасчетУр1+"
			|	ИЗ 
			|		(
			|"+ТекстВложенногоЗапроса+"
			|		) КАК ВложенныйЗапросУр1
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапросУр1.Потребитель,
			|	ВложенныйЗапросУр1.ПериодОтчета"+ТекстАналитикиГруппировка+") КАК ВложенныйЗапросУр2";
		
		мПодзапросыДанных.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПодзапросОперандовПустой(СтруктураРасчетаПоказателей, УровеньРасчета)

	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тИспользуемыеАналитики			= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы			= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	УровниСВременнымРасчетом		= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	
	// Текст замен
	ТекстУровеньРасчета = Формат(УровеньРасчета, "ЧН=0; ЧГ=0");
	
	// Установим флаг временного расчета
	Если УровниСВременнымРасчетом.Найти(УровеньРасчета) = Неопределено Тогда
		ТекстВременныйРасчет = "";
	Иначе
		ТекстВременныйРасчет = ",
		|	ЛОЖЬ КАК ВременныйРасчет";
	КонецЕсли;
	
	// Сформируем текст ресурсов
	ТекстРесурсы = "";
	тРесурсыТекУровня = тИспользуемыеРесурсы.НайтиСтроки(Новый Структура("УровеньРасчета", УровеньРасчета));
	Для Каждого СтрРесурс Из тРесурсыТекУровня Цикл
		Если СтрРесурс.Поле = "ЗначениеНечисловое" Тогда
			ТекстРесурсы = ТекстРесурсы + ",
			|	НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловое";
		Иначе
			ТекстРесурсы = ТекстРесурсы + ",
			|	0 КАК " + СтрРесурс.Поле;
		КонецЕсли;
	КонецЦикла;
	
	// Сформируем текст аналитик
	ТекстАналитики = "";
	тАналитикиТекУровня = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета", УровеньРасчета));
	Для Каждого СтрАналитика Из тАналитикиТекУровня Цикл
		Если СтрАналитика.Поле = "АналитикаВалюта" Тогда
			ТекстАналитики = ТекстАналитики + ",
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта";
		Иначе
			ТекстАналитики = ТекстАналитики + ",
			|	НЕОПРЕДЕЛЕНО КАК " + СтрАналитика.Поле;
		КонецЕсли;
	КонецЦикла;
	
	// Сформируем текст аналитик таблицы трансформации
	ТекстАналитикиТрансформации = "";
	Для Инд = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		ТекстАналитикиТрансформации = ТекстАналитикиТрансформации + ",
		|	НЕОПРЕДЕЛЕНО КАК Аналитика" + Инд;
	КонецЦикла;
	Если ЕстьАналитикаВалюта Тогда
		ТекстАналитикиТрансформации = ТекстАналитикиТрансформации + ",
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта";
	КонецЕсли;
	
	ТекстЗапроса = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ПоказателиОтчетов.ПустаяСсылка) КАК Показатель,
		|	ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка) КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+ТекстВременныйРасчет+"
		|ПОМЕСТИТЬ втПоказателиРаскрытия"+ТекстУровеньРасчета+"
		|ГДЕ
		|	ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	0 КАК УИДГруппыОтборов,
		|	0 КАК УИДГруппыТрансформации,
		|	ЗНАЧЕНИЕ(Справочник.ПоказателиОтчетов.ПустаяСсылка) КАК Показатель,
		|	ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка) КАК ПериодОтчета"+ТекстРесурсы+ТекстАналитикиТрансформации+"
		|ПОМЕСТИТЬ втЗначенияОперандов"+ТекстУровеньРасчета+"
		|ГДЕ
		|	ЛОЖЬ";
	
	НовСтрТаб						= глТаблицаПересчетаПоказателей.Добавить();
	НовСтрТаб.КомментарийКПакету	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'ПУСТЫЕ ТАБЛИЦЫ ДЛЯ РАСЧЕТА - %1'"), ТекстУровеньРасчета);
	НовСтрТаб.ТекстПодзапросов		= ТекстЗапроса;
	НовСтрТаб.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандов;
	
КонецПроцедуры

Процедура ДобавитьЗапросыПоУровнямРасчета(СтруктураРасчетаПоказателей)

	МаксУровеньРасчета				= СтруктураРасчетаПоказателей.МаксУровеньРасчета;
	МаксУровеньСовместныхРасчетов	= СтруктураРасчетаПоказателей.МаксУровеньСовместныхРасчетов;
	МинУровеньСовместныхРасчетов	= СтруктураРасчетаПоказателей.МинУровеньСовместныхРасчетов;
	
	// Последовательный расчет
	Для СчПоУровнюРасчета = 1 По МинУровеньСовместныхРасчетов-1 Цикл
		Для СчПоПериоду = 0 По 1 Цикл
			ДобавитьЗапросПоУровнюРасчета(СтруктураРасчетаПоказателей, СчПоУровнюРасчета, СчПоПериоду = 1);
		КонецЦикла;
	КонецЦикла;
	
	// Совместный расчет
	Для СчПоПериоду = 0 По 1 Цикл
		Для СчПоУровнюРасчета = МинУровеньСовместныхРасчетов По МаксУровеньСовместныхРасчетов Цикл
			ДобавитьЗапросПоУровнюРасчета(СтруктураРасчетаПоказателей, СчПоУровнюРасчета, СчПоПериоду = 1);
		КонецЦикла;
	КонецЦикла;
	
	// Последовательный расчет
	Для СчПоУровнюРасчета = МаксУровеньСовместныхРасчетов+1 По МаксУровеньРасчета Цикл
		Для СчПоПериоду = 0 По 1 Цикл
			ДобавитьЗапросПоУровнюРасчета(СтруктураРасчетаПоказателей, СчПоУровнюРасчета, СчПоПериоду = 1);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗапросПоУровнюРасчета(СтруктураРасчетаПоказателей, СчПоУровнюРасчета, РекурсивныйРасчетПериодов);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("УровеньРасчетаПотребителя", СчПоУровнюРасчета);
	СтруктураОтбора.Вставить("ДляДополненияАналитик", Ложь);
	СтруктураОтбора.Вставить("РекурсивныйРасчетПериодов", РекурсивныйРасчетПериодов);
	тПоказателиОперандыТекущегоПериода = СтруктураРасчетаПоказателей.тПоказателиОперанды.Скопировать(СтруктураОтбора);
	Если тПоказателиОперандыТекущегоПериода.Количество() = 0 Тогда
		// Создадим пустую таблицу втЗначенияОперандов
		Если НЕ РекурсивныйРасчетПериодов Тогда
			ДобавитьПодзапросОперандовПустой(СтруктураРасчетаПоказателей, СчПоУровнюРасчета);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СтруктураПараметровТекущегоУровня = Новый Структура;
	СтруктураПараметровТекущегоУровня.Вставить("УровеньРасчета", СчПоУровнюРасчета);
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанных", Новый Массив);
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакета", ОписаниеТаблицыПараметров());
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанныхВТ", Новый Массив);
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ", ОписаниеТаблицыПараметров());
	СтруктураПараметровТекущегоУровня.Вставить("РекурсивныйРасчетПериодов", РекурсивныйРасчетПериодов);
	
	// Получаем подзапрос для потребителей, для текущего варианта расчета
	Для СчПоВариантуРасчета = 1 По 4 Цикл
		ПоказателиТекущегоУровня = тПоказателиОперандыТекущегоПериода.Скопировать(Новый Структура("ВариантРасчета",СчПоВариантуРасчета));
		Если ПоказателиТекущегоУровня.Количество()>0 Тогда
			СтруктураПараметровТекущегоУровня.Вставить("ПоказателиТекущегоУровня",ПоказателиТекущегоУровня);
			Если СчПоВариантуРасчета = 1 Тогда
				ДобавитьПодзапросОперандовРучнойПодсчет(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
			ИначеЕсли СчПоВариантуРасчета = 2 Тогда
				ДобавитьПодзапросОперандовБезФормул(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
			ИначеЕсли СчПоВариантуРасчета = 3 Тогда
				ДобавитьПодзапросОперандовТолькоСумма(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
			Иначе
				ДобавитьПодзапросОперандовВыражение(СтруктураРасчетаПоказателей, СтруктураПараметровТекущегоУровня);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Добавим запросы временных таблиц
	УровеньРасчетаСтрока = Формат(СчПоУровнюРасчета,"ЧН=0; ЧГ=0");
	Если СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ.Количество() > 0 Тогда
		нСтрокаТаблицыЗапросов						= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей.Добавить();
		нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ИтоговыйТекстПодзапросовВТ(СтруктураПараметровТекущегоУровня.мПодзапросыДанныхВТ);
		нСтрокаТаблицыЗапросов.тПараметрыПакета		= СтруктураПараметровТекущегоУровня.тПараметрыПакетаВТ;
		Если РекурсивныйРасчетПериодов Тогда
			нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандовЗависимыхПоПериоду;
			нСтрокаТаблицыЗапросов.КомментарийКПакету	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'РАСЧЕТ ВРЕМЕННЫХ ТАБЛИЦ ПОКАЗАТЕЛЕЙ УРОВНЯ - %1, ПЕРИОД - %2'"), УровеньРасчетаСтрока, "#ИндексПериода");
		Иначе
			нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандов;
			нСтрокаТаблицыЗапросов.КомментарийКПакету	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'РАСЧЕТ ВРЕМЕННЫХ ТАБЛИЦ ПОКАЗАТЕЛЕЙ УРОВНЯ - %1'"), УровеньРасчетаСтрока);
		КонецЕсли;
	КонецЕсли;
	
	// Добавим запрос в таблицу пересчета показателей
	Если РекурсивныйРасчетПериодов Тогда
		
		ДобавитьЗапросВТаблицуПересчетаПоказателей(
			СтруктураПараметровТекущегоУровня.мПодзапросыДанных,
			СтруктураПараметровТекущегоУровня.тПараметрыПакета,
			"втПоказателиРаскрытия" + УровеньРасчетаСтрока + "_#ИндексПериода",
			СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей,
			Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандовЗависимыхПоПериоду,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'РЕКУРСИВНО ЗАВИСИМЫЕ ПОКАЗАТЕЛИ УРОВНЯ - %1, ПЕРИОД - %2'"), УровеньРасчетаСтрока, "#ИндексПериода"));
			
		// Добавим в текст последнего запроса объединение таблиц
		нСтрокаТаблицыЗапросов = СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей.Получить(
			СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей.Количество()-1);
		нСтрокаТаблицыЗапросов.ТекстПодзапросов = нСтрокаТаблицыЗапросов.ТекстПодзапросов
			+ ОбщегоНазначения.РазделительПакетаЗапросов() + "
			|ВЫБРАТЬ *
			|ПОМЕСТИТЬ втПоказателиРаскрытия_Временная
			|ИЗ
			|	втПоказателиРаскрытия"+УровеньРасчетаСтрока+" КАК ЗначенияПоказателей
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ *
			|ИЗ
			|	втПоказателиРаскрытия"+УровеньРасчетаСтрока+"_#ИндексПериода КАК ЗначенияПоказателей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втПоказателиРаскрытия"+УровеньРасчетаСтрока+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ *
			|ПОМЕСТИТЬ втПоказателиРаскрытия"+УровеньРасчетаСтрока+"
			|ИЗ
			|	втПоказателиРаскрытия_Временная
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втПоказателиРаскрытия_Временная
			|";
		
	Иначе
		
		ДобавитьЗапросВТаблицуПересчетаПоказателей(
			СтруктураПараметровТекущегоУровня.мПодзапросыДанных,
			СтруктураПараметровТекущегоУровня.тПараметрыПакета,
			"втПоказателиРаскрытия" + УровеньРасчетаСтрока,
			СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей,
			Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандов,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'РАСЧЕТ ПОКАЗАТЕЛЕЙ УРОВНЯ - %1'"), УровеньРасчетаСтрока));

	КонецЕсли;

	// Добавим таблицу трансформации текущего уровня
	Если СтруктураПараметровТекущегоУровня.мПодзапросыДанных.Количество()>0 Тогда
		ДобавитьЗапросТрансформацииТекущегоУровня(СтруктураРасчетаПоказателей, СчПоУровнюРасчета, РекурсивныйРасчетПериодов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыПодготовкиЗапросовДляЗаписиПоказателей

////////////////////////////////////////////////////////////////////////////////
// Процедуры для подготовки текстов запросов измененных показателей
// 
////////////////////////////////////////////////////////////////////////////////

Процедура ДобавитьЗапросПоИзмененнымПоказателям(СтруктураРасчетаПоказателей, тИзмененныеПоказатели, ИндексироватьПоСценарию)
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;		
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	ЕстьЗначение					= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеВалюта				= СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта;
	ЕстьЗначениеНечисловое			= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	
	// Текст аналитик	
	ТекстАналитики = "";
	ТекстАналитикиСоединение = "";
	ТекстАналитикиГруппировка = "";
	ТекстЗначения = "";
	ТекстСвернуть = "Показатель,ПериодОтчета";
	ТекстИтоги = "";
	Для Сч = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		ТекстАналитики = ТекстАналитики + ",
		|	ISNULL(ЗначенияПоказателей.Аналитика" + Сч + ", НЕОПРЕДЕЛЕНО) КАК Аналитика" + Сч;
		ТекстАналитикиСоединение = ТекстАналитикиСоединение + "
		|	И ЗначенияПоказателей.Аналитика" + Сч + " = ЗначенияПоказателейСценарийИндексации.Аналитика" + Сч;
		ТекстАналитикиГруппировка = ТекстАналитикиГруппировка + ",
		|	ЗначенияПоказателей.Аналитика" + Сч;
		ТекстСвернуть = ТекстСвернуть + ",Аналитика" + Сч;	
	КонецЦикла;
	Если ЕстьАналитикаВалюта Тогда
		ТекстАналитики = ТекстАналитики + ",
		|	ISNULL(ЗначенияПоказателей.АналитикаВалюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК АналитикаВалюта";
		ТекстАналитикиСоединение = ТекстАналитикиСоединение + "
		|	И ЗначенияПоказателей.АналитикаВалюта = ЗначенияПоказателейСценарийИндексации.АналитикаВалюта";
		ТекстАналитикиГруппировка = ТекстАналитикиГруппировка + ",
		|	ЗначенияПоказателей.АналитикаВалюта";
		ТекстСвернуть = ТекстСвернуть + ",АналитикаВалюта";
	КонецЕсли;
	Если ЕстьЗначение Тогда
		ТекстЗначения = ТекстЗначения + ",
		|	ЗначенияПоказателей.Значение КАК Значение";
		ТекстИтоги = ТекстИтоги + ",Значение";
	КонецЕсли;
	Если ЕстьЗначениеВалюта Тогда
		ТекстЗначения = ТекстЗначения + ",
		|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта";
		ТекстИтоги = ТекстИтоги + ",ЗначениеВалюта";
	КонецЕсли;	
	Если ЕстьЗначениеНечисловое Тогда
		ТекстЗначения = ТекстЗначения + ",
		|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНечисловое";
		ТекстСвернуть = ТекстСвернуть + ",ЗначениеНечисловое";
	КонецЕсли;
	
	Если ИндексироватьПоСценарию Тогда
		
		Если НЕ ЕстьЗначение Тогда
			ТекстЗначения = ТекстЗначения + ",
			|	0 КАК Значение";
		КонецЕсли;
		
		ТекстЗапроса = "
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстЗначения+"
			|ПОМЕСТИТЬ втРассчитанныеПоказателиИсходная
			|ИЗ
			|	&ИзмененныеПоказатели КАК ЗначенияПоказателей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	СУММА(ЗначенияПоказателей.Значение) КАК Значение"+ТекстАналитики+"
			|ПОМЕСТИТЬ втЗначенияПоказателейДоИзмененияСвернутая
			|ИЗ
			|	втЗначенияПоказателейДоИзменения КАК ЗначенияПоказателей
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗначенияПоказателей.Показатель,
			|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитикиГруппировка+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Значение * ЗначенияПоказателейСценарийИндексации.Значение - ЗначенияПоказателей.Значение КАК Значение"+ТекстАналитики+"
			|ПОМЕСТИТЬ втРассчитанныеПоказатели
			|ИЗ
			|	втРассчитанныеПоказателиИсходная КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗначенияПоказателейДоИзмененияСвернутая КАК ЗначенияПоказателейСценарийИндексации
			|		ПО ЗначенияПоказателей.Показатель = ЗначенияПоказателейСценарийИндексации.Показатель
			|			И ЗначенияПоказателей.ПериодОтчета = ЗначенияПоказателейСценарийИндексации.ПериодОтчета"+ТекстАналитикиСоединение; 
		
	Иначе
		
		ТекстЗапроса = "
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстЗначения+"
			|ПОМЕСТИТЬ втРассчитанныеПоказатели
			|ИЗ
			|	&ИзмененныеПоказатели КАК ЗначенияПоказателей";
		
	КонецЕсли;
	
	тПараметрыПакета = ОписаниеТаблицыПараметров();
	
	ИзмененныеПоказатели = тИзмененныеПоказатели.Скопировать(, ТекстСвернуть + ?(ТекстИтоги="", "", "," + Сред(ТекстИтоги,2)));
	ИзмененныеПоказатели.Свернуть(ТекстСвернуть, ТекстИтоги);
	
	НПараметр					= тПараметрыПакета.Добавить();
	НПараметр.ТипОтбора			= Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НПараметр.ИмяОтбора			= "ИзмененныеПоказатели";
	НПараметр.ЗначениеОтбора	= ИзмененныеПоказатели;
	
	нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ДОБАВЛЕНИЕ ТАБЛИЦЫ ИЗМЕНЕННЫХ ПОКАЗАТЕЛЕЙ'");
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеИзмененныхПоказателей;
	нСтрокаТаблицыЗапросов.тПараметрыПакета		= тПараметрыПакета;
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса;

КонецПроцедуры

Процедура ДобавитьЗапросПоНовымЗначениямПотребителей(СтруктураРасчетаПоказателей)
	
	тПоказателиОперанды				= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тИспользуемыеАналитики			= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тИспользуемыеРесурсы			= СтруктураРасчетаПоказателей.тИспользуемыеРесурсы;
	МаксУровеньРасчета				= СтруктураРасчетаПоказателей.МаксУровеньРасчета;
	УровниСВременнымРасчетом		= СтруктураРасчетаПоказателей.УровниСВременнымРасчетом;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	тРасшифровкаГруппОтборовВерсии	= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии;
	тРасшифровкаГруппОтборов		= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов;
	тКэшГруппОтборовПоказателей		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПоказателей;
	
	мПодзапросыДанных = Новый Массив;
	
	ИтоговыеРесурсы = тИспользуемыеРесурсы.Скопировать(Новый Структура("ВыводитсяВОтчет",Истина));
	ИтоговыеРесурсы.Свернуть("Поле,Суммируется");
	
	// Рассчитанные значения получаем из временных таблиц соответствующего уровня расчета
	тУровниРасчетаПотребителей = тПоказателиОперанды.Скопировать(, "УровеньРасчетаПотребителя");
	тУровниРасчетаПотребителей.Свернуть("УровеньРасчетаПотребителя");
	тУровниРасчетаПотребителей.Сортировать("УровеньРасчетаПотребителя");
	Для Каждого СтрРасчетаПотребителя Из тУровниРасчетаПотребителей Цикл
		
		УровеньРасчетаПотребителя = СтрРасчетаПотребителя.УровеньРасчетаПотребителя;		
		ТекстУровеньРасчетаПотребителя = Формат(УровеньРасчетаПотребителя, "ЧН=0; ЧГ=0");		
		
		// Текст полей на текущем уровне
		ТекстАналитики = "";		
		Для ИндПоля = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
			Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",УровеньРасчетаПотребителя,"Аналитика" + ИндПоля)).Количество() > 0 Тогда
				ТекстАналитики = ТекстАналитики + ",
				|	ЗначенияПоказателей.Аналитика" + ИндПоля + " КАК " + "Аналитика" + ИндПоля;
			Иначе
				ТекстАналитики = ТекстАналитики + ",
				|	НЕОПРЕДЕЛЕНО КАК " + "Аналитика" + ИндПоля;
			КонецЕсли;
		КонецЦикла;
		
		// Значение валюта
		Если ЕстьАналитикаВалюта Тогда
			Если тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",УровеньРасчетаПотребителя,"АналитикаВалюта")).Количество() > 0 Тогда
				ТекстАналитики = ТекстАналитики + ",
				|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта";
			Иначе
				ТекстАналитики = ТекстАналитики + ",
				|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта";
			КонецЕсли;	
		КонецЕсли;
		
		// Текст ресурсов на текущем уровне
		ТекстРесурсы = "";
		Для Каждого Ресурс Из ИтоговыеРесурсы Цикл
			Если тИспользуемыеРесурсы.НайтиСтроки(Новый Структура("УровеньРасчета,Поле",УровеньРасчетаПотребителя,Ресурс.Поле)).Количество() > 0 Тогда
				ТекстРесурсы = ТекстРесурсы + ",
				|	ЗначенияПоказателей." + Ресурс.Поле + " КАК " + Ресурс.Поле;				
			ИначеЕсли Ресурс.Суммируется Тогда
				ТекстРесурсы = ТекстРесурсы + ",
				|	0 КАК " + Ресурс.Поле;
			Иначе
				ТекстРесурсы = ТекстРесурсы + ",
				|	НЕОПРЕДЕЛЕНО КАК " + Ресурс.Поле;
			КонецЕсли;
		КонецЦикла;
		
		// Текст запроса
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+ТекстУровеньРасчетаПотребителя+" КАК УровеньРасчета,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстРесурсы+"
		|ИЗ
		|	втПоказателиРаскрытия"+ТекстУровеньРасчетаПотребителя+" КАК ЗначенияПоказателей";
		
		// Фильтр по операндам временного расчета
		Если УровниСВременнымРасчетом.Найти(УровеньРасчетаПотребителя) <> Неопределено Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	НЕ ЗначенияПоказателей.ВременныйРасчет";
		КонецЕсли;
		
		мПодзапросыДанных.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	ДобавитьЗапросВТаблицуПересчетаПоказателей(
		мПодзапросыДанных,
		Неопределено,
		"втЗначенияПотребителейРасчет",
		глТаблицаПересчетаПоказателей,
		Перечисления.ВидыОперацийРасчетаПоказателей.РасчетИтоговыхЗначенийПоказателей,
		НСтр("ru = 'ОБЪЕДИНЕННАЯ ТАБЛИЦА НОВЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ'"));
	
	ДобавитьЗапросПоПустымАналитикам(СтруктураРасчетаПоказателей);
	
КонецПроцедуры

Процедура СвернутьТаблицуНовыхЗначенийПотребителей(СтруктураРасчетаПоказателей)

	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	ЕстьЗначение					= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеНечисловое			= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	
	ТекстАналитики = "";
	Для ИндПоля = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.Аналитика" + ИндПоля;
	КонецЦикла;
	
	ТекстЗначение = "";
	Если ЕстьЗначение Тогда
		ТекстЗначение = ",
		|	СУММА(ЗначенияПоказателей.Значение) КАК Значение";
	КонецЕсли;
	Если ЕстьЗначениеНечисловое Тогда
		ТекстЗначение = ",
		|	МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловое) КАК ЗначениеНечисловое"; 
	КонецЕсли;
	
	Если ЭтоРасшифровка И СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта Тогда
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.АналитикаВалюта";
	КонецЕсли;
	
	ТекстЗапроса = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗначенияПоказателей.УровеньРасчета КАК УровеньРасчета,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстАналитики+ТекстЗначение+"
		|ПОМЕСТИТЬ втРассчитанныеПоказатели
		|ИЗ
		|	втЗначенияПотребителейРасчет КАК ЗначенияПоказателей
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗначенияПоказателей.УровеньРасчета,
		|	ЗначенияПоказателей.Показатель,
		|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики;

	нСтрокаТаблицыЗапросов = глТаблицаПересчетаПоказателей.Добавить();	
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса;
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'СВЕРНУТАЯ ТАБЛИЦА НОВЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ'");
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.РасчетИтоговыхЗначенийПоказателей;
	
КонецПроцедуры

Процедура ДобавитьОтборыПоКлючевымСрезам(СтруктураРасчетаПоказателей, ТипПараметрическойНастройки = Неопределено);
	
	тКэшГруппОтборовВерсии			= СтруктураРасчетаПоказателей.тКэшГруппОтборовВерсии;
	тРасшифровкаГруппОтборовВерсии	= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	СпособФормированияОтчета		= СтруктураРасчетаПоказателей.СпособФормированияОтчета;
	РазделениеПоПроектам			= СтруктураРасчетаПоказателей.ДанныеВидаОтчета.РазделениеПоПроектам;
	ВидОтчета						= СтруктураРасчетаПоказателей.ДанныеВидаОтчета.ВидОтчета;
	
	тКэшГруппОтборовВерсии.Очистить();
	тРасшифровкаГруппОтборовВерсии.Очистить();
	
	Если ТипПараметрическойНастройки = Неопределено 
		ИЛИ ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.ИндексироватьПоСценарию Тогда
		УИДГруппыОтборов = 0;
	Иначе
		УИДГруппыОтборов = 1;
	КонецЕсли;
	
	Если ТипПараметрическойНастройки <> Перечисления.ТипПараметрическойНастройки.Консолидация
		И ТипПараметрическойНастройки <> Перечисления.ТипПараметрическойНастройки.КонсолидацияПропорционально
		И ТипПараметрическойНастройки <> Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
		
		НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
		НСтрРасшифровка.ПолеБД						= "Организация";
		НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета;
		НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
	
	КонецЕсли;
	
	Если ТипПараметрическойНастройки <> Перечисления.ТипПараметрическойНастройки.СвернувПоПериоду Тогда
		
		НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
		НСтрРасшифровка.ПолеБД						= "ПериодОтчета";
		НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета;
		НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
	
	КонецЕсли;
	
	Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.ИндексироватьПоСценарию Тогда
		
		НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
		НСтрРасшифровка.ПолеБД						= "Сценарий";
		НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение;
		НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
		НСтрРасшифровка.ТекстМодуля					= "Результат = ОбъектРасчета.УточнениеСпособаФормированияОтчета";
		
	Иначе	
		
		НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
		НСтрРасшифровка.ПолеБД						= "Сценарий";
		НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.СценарийОтчета;
		НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
	
	КонецЕсли;
	
	НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
	НСтрРасшифровка.ПолеБД						= "Валюта";
	НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ВалютаОтчета;
	НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
		
	// Добавим фильтр по проекту, если он используется
	Если РазделениеПоПроектам Тогда
		НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
		НСтрРасшифровка.ПолеБД						= "Проект";
		НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ПроектОтчета;
		НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
	КонецЕсли;
	
	// Добавим фильтр по ключевым аналитикам
	Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.СвернувПоАналитикам Тогда
		Для ИндПоля = 1 По МаксКлючевыхАналитик Цикл
			НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
			НСтрРасшифровка.ПолеБД						= "Аналитика"+ИндПоля;
			НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений;
			НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
			НСтрРасшифровка.ТекстМодуля					= "Результат = ПолучитьАналитикиПриСвертке(" + ИндПоля + ")";
		КонецЦикла;
	Иначе
		Для ИндПоля = 1 По МаксКлючевыхАналитик Цикл
			НСтрРасшифровка								= тРасшифровкаГруппОтборовВерсии.Добавить();
			НСтрРасшифровка.ПолеБД						= "Аналитика"+ИндПоля;
			НСтрРасшифровка.СпособВычисленияПараметра	= Перечисления.СпособыВычисленияПараметровОперандов[НСтрРасшифровка.ПолеБД];
			НСтрРасшифровка.УИДГруппыОтборов			= УИДГруппыОтборов;
		КонецЦикла;
	КонецЕсли;
	
	// Добавим строку и в таблицу кэш групп отборов версий
	НСтрокаКэшВерсии = тКэшГруппОтборовВерсии.Добавить();
	НСтрокаКэшВерсии.УИДГруппыОтборов	= УИДГруппыОтборов;
	НСтрокаКэшВерсии.ВидыОтчетов		= ВидОтчета;
	
КонецПроцедуры

Процедура ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей, ФильтрПоИзмененнымЗначениям = Ложь, ТипПараметрическойНастройки = Неопределено)
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	тПоказателиОперанды				= СтруктураРасчетаПоказателей.тПоказателиОперанды;
	тИспользуемыеАналитики			= СтруктураРасчетаПоказателей.тИспользуемыеАналитики;
	тРасшифровкаГруппОтборовВерсии	= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	ДанныеВидаОтчета				= СтруктураРасчетаПоказателей.ДанныеВидаОтчета;
	ЕстьЗначение					= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеНечисловое			= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	тКэшГруппОтборовВерсии			= СтруктураРасчетаПоказателей.тКэшГруппОтборовВерсии;
	тКэшГруппОтборовПоказателей		= СтруктураРасчетаПоказателей.тКэшГруппОтборовПоказателей;
	
	// Текущие уровни потребителей
	УровниРегистраПотребителей = тПоказателиОперанды.Скопировать(,"Потребитель,ИндексРегистраПотребителя");
	УровниРегистраПотребителей.Свернуть("Потребитель,ИндексРегистраПотребителя");
	УровниРегистра = УровниРегистраПотребителей.Скопировать(,"ИндексРегистраПотребителя");
	УровниРегистра.Свернуть("ИндексРегистраПотребителя");
	УровниРегистра.Сортировать("ИндексРегистраПотребителя Возр");

	// Добавим фильтры по всем ключевым срезам отчета
	ДобавитьОтборыПоКлючевымСрезам(СтруктураРасчетаПоказателей, ТипПараметрическойНастройки);
	
	// Подготовим структуру параметров для расчета текущего уровня
	СтруктураПараметровТекущегоУровня = Новый Структура;
	СтруктураПараметровТекущегоУровня.Вставить("тРасшифровкаГруппОтборовВерсии", тРасшифровкаГруппОтборовВерсии);
	СтруктураПараметровТекущегоУровня.Вставить("тРасшифровкаГруппОтборов", тРасшифровкаГруппОтборовВерсии.СкопироватьКолонки());
	СтруктураПараметровТекущегоУровня.Вставить("ТипПараметрическойНастройки", Неопределено);

	мПодзапросыДанных = Новый Массив;
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанных", мПодзапросыДанных);
	
	тПараметрыПакета = ОписаниеТаблицыПараметров();
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакета",тПараметрыПакета);
	
	мПодзапросыДанныхВТ = Новый Массив;
	СтруктураПараметровТекущегоУровня.Вставить("мПодзапросыДанныхВТ", мПодзапросыДанныхВТ);
	
	тПараметрыПакетаВТ = ОписаниеТаблицыПараметров();
	СтруктураПараметровТекущегоУровня.Вставить("тПараметрыПакетаВТ",тПараметрыПакетаВТ);	
	
	// Добавим аналитики и ресурсы
	ТекстРесурсы = "";
	тИспользуемыеАналитикиТекущая = тИспользуемыеАналитики.СкопироватьКолонки();	
	Для ИндПоля = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		нСтр							= тИспользуемыеАналитикиТекущая.Добавить();
		нСтр.УровеньРасчета				= 1;
		нСтр.Поле						= "Аналитика"+ИндПоля;
		нСтр.ПолеВерсии					= Ложь;
	КонецЦикла;	
	Если ЕстьАналитикаВалюта Тогда
		нСтр							= тИспользуемыеАналитикиТекущая.Добавить();
		нСтр.УровеньРасчета				= 1;
		нСтр.Поле						= "АналитикаВалюта";
		нСтр.ПолеВерсии					= Ложь;
	КонецЕсли;
	СтруктураПараметровТекущегоУровня.Вставить("тИспользуемыеАналитики", тИспользуемыеАналитикиТекущая);
		
	// Получим текст запроса для версий показателей
	СтрКэшГруппОтборов = тКэшГруппОтборовВерсии.Получить(0);
	
	// По числовым
	Если ЕстьЗначение Тогда
		ТекстРесурсы = ТекстРесурсы + ",
		|	#ИмяТаблицы.Значение КАК Значение";
		СтрКэшГруппОтборов.ИндексРегистра = 0;
	КонецЕсли;
	ДобавитьПодзапросТекущейВерсии(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
	
	// По нечисловым
	Если ЕстьЗначениеНечисловое Тогда
		ТекстРесурсы = ТекстРесурсы + ",
		|	#ИмяТаблицы.ЗначениеНечисловое КАК ЗначениеНечисловое";
		Если УровниРегистра.Найти(-1, "ИндексРегистраПотребителя") <> Неопределено Тогда
			СтрКэшГруппОтборов.ИндексРегистра = -1;
			ДобавитьПодзапросТекущейВерсии(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
		КонецЕсли;
		Если УровниРегистра.Найти(-11, "ИндексРегистраПотребителя") <> Неопределено Тогда
			СтрКэшГруппОтборов.ИндексРегистра = -11;
			ДобавитьПодзапросТекущейВерсии(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
		КонецЕсли;
	КонецЕсли;
	
	// Получим текст запроса для значений показателей
	СтрКэшГруппОтборов = тКэшГруппОтборовПоказателей.Добавить();
	СтруктураПараметровТекущегоУровня.Вставить("ТекстРесурсы", ТекстРесурсы);
	СтруктураПараметровТекущегоУровня.Вставить("ФильтрПоИзмененнымЗначениям", ФильтрПоИзмененнымЗначениям);
	Для Каждого СтрУровеньПотребителя Из УровниРегистра Цикл
		СтрКэшГруппОтборов.ИндексРегистра = СтрУровеньПотребителя.ИндексРегистраПотребителя; 
		СтрКэшГруппОтборов.Показатели = УровниРегистраПотребителей.Скопировать(Новый Структура("ИндексРегистраПотребителя",СтрУровеньПотребителя.ИндексРегистраПотребителя)).ВыгрузитьКолонку("Потребитель");
		ДобавитьПодзапросЗначенийПоказателей(СтруктураПараметровТекущегоУровня, СтрКэшГруппОтборов);
	КонецЦикла;
	
	// Добавим запросы по версиям в таблицу пересчета показателей
	нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ИтоговыйТекстПодзапросовВТ(мПодзапросыДанныхВТ);
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ВЕРСИИ ЗНАЧЕНИЙ ПОКАЗАТЕЛЕЙ ТЕКУЩЕГО СРЕЗА'");
	нСтрокаТаблицыЗапросов.тПараметрыПакета		= тПараметрыПакетаВТ;
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеЗначенийПотребителей;
	
	// Добавим запросы по значениям показателей в таблицу пересчета показателей
	ДобавитьЗапросВТаблицуПересчетаПоказателей(
		мПодзапросыДанных,
		тПараметрыПакета,
		"втЗначенияПоказателейДоИзменения",
		глТаблицаПересчетаПоказателей,
		Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеЗначенийПотребителей,
		НСтр("ru = 'ЗНАЧЕНИЯ ПОКАЗАТЕЛЕЙ ТЕКУЩЕГО СРЕЗА'"));
		
КонецПроцедуры

Процедура ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей)
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта; 
	ЕстьЗначение					= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеНечисловое			= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	
	// Подготовим тексты для аналитик
	ТекстАналитики						= "";
	ТекстАналитикиВыбор					= "";
	ТекстЗначение						= "";
	ТекстЗначениеДоИзменения			= "";
	ТекстЗначениеНечисловое				= "";
	ТекстЗначениеНечисловоеДоИзменения	= "";
	
	// Добавим аналитики рассчитанных показателей
	Для ИндПоля = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.Аналитика" + ИндПоля;
		ТекстАналитикиВыбор = ТекстАналитикиВыбор + ",
		|	ВЫБОР
		|		КОГДА Потребители.ИндексРегистраПотребителя >= " + ИндПоля + "
		|			ИЛИ Потребители.ИндексРегистраПотребителя = -1
		|			ТОГДА ISNULL(ЗначенияПоказателей.Аналитика" + ИндПоля + ", НЕОПРЕДЕЛЕНО)
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Аналитика" + ИндПоля;
	КонецЦикла;
	Если ЕстьАналитикаВалюта Тогда
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.АналитикаВалюта";
		ТекстАналитикиВыбор = ТекстАналитикиВыбор + ",
		|	ЗначенияПоказателей.АналитикаВалюта";
	КонецЕсли;
	
	// Подготовим тесты ресурсов
	Если ЕстьЗначение Тогда		
		ТекстЗначение = ",
			|	ЗначенияПоказателей.Значение КАК Значение";
		ТекстЗначениеДоИзменения = ",
			|	-1 * ЗначенияПоказателей.Значение КАК Значение";
	КонецЕсли;	
	Если ЕстьЗначениеНечисловое Тогда		
		ТекстЗначениеНечисловое = ",
			|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНечисловое,
			|	НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловоеДоИзменения";
		ТекстЗначениеНечисловоеДоИзменения = ",
			|	НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловое,
			|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНечисловоеДоИзменения";
	КонецЕсли;
	
	// ОБЪЕДИНЕННАЯ ТАБЛИЦА НОВЫХ И ИСХОДНЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ
	ТекстЗапроса = "
		|////////////////////////////////////////////////////////////////////////////////
		|// ОБЪЕДИНЕННАЯ ТАБЛИЦА НОВЫХ И ИСХОДНЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Потребители.Потребитель КАК Потребитель,
		|	Потребители.ИндексРегистраПотребителя КАК ИндексРегистраПотребителя,
		|	ВЫБОР
		|		КОГДА Потребители.ИндексРегистраПотребителя = -1
		|				ИЛИ Потребители.ИндексРегистраПотребителя = -11
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Числовой
		|ПОМЕСТИТЬ втИндексыПотребителей
		|ИЗ
		|	втПоказателиОперанды КАК Потребители
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	Потребители.Числовой КАК Числовой,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстЗначение+ТекстЗначениеНечисловое+ТекстАналитикиВыбор+"
		|ПОМЕСТИТЬ втЗначенияПотребителейОбъединенные
		|ИЗ
		|	втЗначенияПотребителейРасчет КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ втИндексыПотребителей КАК Потребители
		|		ПО Потребители.Потребитель = ЗначенияПоказателей.Показатель
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ 
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	Потребители.Числовой КАК Числовой,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстЗначениеДоИзменения+ТекстЗначениеНечисловоеДоИзменения+ТекстАналитики+"
		|ИЗ
		|	втЗначенияПоказателейДоИзменения КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ втИндексыПотребителей КАК Потребители
		|		ПО Потребители.Потребитель = ЗначенияПоказателей.Показатель
		|;
		|";
	
	Если ЕстьЗначение Тогда
		
		Если ЕстьЗначениеНечисловое Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|////////////////////////////////////////////////////////////////////////////////
				|// СГРУППИРОВАННАЯ ТАБЛИЦА НОВЫХ И ИСХОДНЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ 
				|
				|ВЫБРАТЬ 
				|	ЗначенияПоказателей.Показатель КАК Показатель,
				|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
				|	СУММА(ЗначенияПоказателей.Значение) КАК Значение,
				|	НЕОПРЕДЕЛЕНО КАК ЗначениеНечисловое"+ТекстАналитики+"
				|ПОМЕСТИТЬ втРассчитанныеПоказатели
				|ИЗ
				|	втЗначенияПотребителейОбъединенные КАК ЗначенияПоказателей
				|ГДЕ
				|	ЗначенияПоказателей.Числовой
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗначенияПоказателей.Показатель, 
				|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики+"
				|
				|ИМЕЮЩИЕ 
				|	СУММА(ЗначенияПоказателей.Значение) <> 0
				|";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
				|////////////////////////////////////////////////////////////////////////////////
				|// СГРУППИРОВАННАЯ ТАБЛИЦА НОВЫХ И ИСХОДНЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ 
				|
				|ВЫБРАТЬ 
				|	ЗначенияПоказателей.Показатель КАК Показатель,
				|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
				|	СУММА(ЗначенияПоказателей.Значение) КАК Значение"+ТекстАналитики+"
				|ПОМЕСТИТЬ втРассчитанныеПоказатели
				|ИЗ
				|	втЗначенияПотребителейОбъединенные КАК ЗначенияПоказателей
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗначенияПоказателей.Показатель, 
				|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики+"
				|
				|ИМЕЮЩИЕ 
				|	СУММА(ЗначенияПоказателей.Значение) <> 0
				|";
		КонецЕсли;
		
	КонецЕсли;
		
	Если ЕстьЗначениеНечисловое Тогда
		
		Если ЕстьЗначение Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|
				|ОБЪЕДИНИТЬ ВСЕ 
				|
				|ВЫБРАТЬ 
				|	ЗначенияПоказателей.Показатель КАК Показатель,
				|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета, 
				|	0 КАК Значение, 
				|	МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловое) КАК ЗначениеНечисловое"+ТекстАналитики+"
				|ИЗ
				|	втЗначенияПотребителейОбъединенные КАК ЗначенияПоказателей
				|ГДЕ
				|	НЕ ЗначенияПоказателей.Числовой
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗначенияПоказателей.Показатель, 
				|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики+"
				|
				|ИМЕЮЩИЕ
				|	МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловое) <> МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловоеДоИзменения)
				|";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
				|////////////////////////////////////////////////////////////////////////////////
				|// СГРУППИРОВАННАЯ ТАБЛИЦА НОВЫХ И ИСХОДНЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ 
				|
				|ВЫБРАТЬ 
				|	ЗначенияПоказателей.Показатель КАК Показатель,
				|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета, 
				|	МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловое) КАК ЗначениеНечисловое"+ТекстАналитики+"
				|ПОМЕСТИТЬ втРассчитанныеПоказатели
				|ИЗ
				|	втЗначенияПотребителейОбъединенные КАК ЗначенияПоказателей
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗначенияПоказателей.Показатель, 
				|	ЗначенияПоказателей.ПериодОтчета"+ТекстАналитики+"
				|
				|ИМЕЮЩИЕ
				|	МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловое) <> МАКСИМУМ(ЗначенияПоказателей.ЗначениеНечисловоеДоИзменения)
				|";
		КонецЕсли;
		
	КонецЕсли;
		
	нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса;
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ИТОГОВАЯ ТАБЛИЦА ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ'");
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ИтоговаяТаблицаРасчетаПоказателей;

КонецПроцедуры

Процедура ДобавитьЗапросПоПустымАналитикам(СтруктураРасчетаПоказателей, ИмяИсходнойТаблицы = "втЗначенияПотребителейРасчет")
	
	глТаблицаПересчетаПоказателей	= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	МаксИспользуемыхАналитик		= СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик;
	МаксКлючевыхАналитик			= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	ЕстьАналитикаВалюта				= СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта;
	ЕстьЗначение					= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеНечисловое			= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	
	тПараметрыПакета = ОписаниеТаблицыПараметров();
	
	// Текст ресурсов
	Если ИмяИсходнойТаблицы = "втЗначенияПотребителейРасчет" Тогда
		ТекстРесурсы = ",
		|	ЗначенияПоказателей.УровеньРасчета КАК УровеньРасчета";
	Иначе
		ТекстРесурсы = "";
	КонецЕсли;	
	Если ЕстьЗначение Тогда
		ТекстРесурсы = ТекстРесурсы + ",
		|	ЗначенияПоказателей.Значение КАК Значение";
	КонецЕсли;
	Если ЕстьЗначениеНечисловое Тогда
		ТекстРесурсы = ТекстРесурсы + ",
		|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНечисловое";
	КонецЕсли;
	
	// Текст аналитик
	ТекстАналитики = "";
	ТекстВидыАналитик = "";
	ТекстВидыАналитикСоединение = "";
	ТекстАналитикиВыбор = "";
	ТекстАналитикиСоединение = "";
	Для Инд = МаксКлючевыхАналитик+1 По МаксИспользуемыхАналитик Цикл
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.Аналитика" + Инд + " КАК Аналитика" + Инд;
		ТекстВидыАналитик = ТекстВидыАналитик + ",
		|	ГруппыРаскрытия.ВидАналитики" + Инд + " КАК ВидАналитики" + Инд;
		ТекстВидыАналитикСоединение = ТекстВидыАналитикСоединение + "
		|			ИЛИ ЗначенияАналитикПоУмолчанию.ВидАналитики = ЗначенияПоказателей.ВидАналитики" + Инд;
		ТекстАналитикиВыбор = ТекстАналитикиВыбор + ",
		|	ВЫБОР
		|		КОГДА ЗначенияПоказателей.ЧислоАналитик >= " + Инд + "
		|			ТОГДА ВЫБОР
		|					КОГДА ЗначенияПоказателей.Аналитика" + Инд + " В (&ПустыеАналитики)
		|						ТОГДА ISNULL(АналитикиПоУмолчанию" + Инд + ".ЗначениеПоУмолчанию, ЗначенияПоказателей.Аналитика" + Инд + ")
		|					ИНАЧЕ ЗначенияПоказателей.Аналитика" + Инд + "
		|				КОНЕЦ
		|		ИНАЧЕ ЗначенияПоказателей.Аналитика" + Инд + "
		|	КОНЕЦ КАК Аналитика" + Инд;
		ТекстАналитикиСоединение = ТекстАналитикиСоединение + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ втАналитикиПоУмолчанию КАК АналитикиПоУмолчанию" + Инд + "
		|		ПО ЗначенияПоказателей.ПериодОтчета = АналитикиПоУмолчанию" + Инд + ".ПериодОтчета
		|			И ЗначенияПоказателей.ВидАналитики" + Инд + " = АналитикиПоУмолчанию" + Инд + ".ВидАналитики"
	КонецЦикла;	
	Если ЗначениеЗаполнено(ТекстВидыАналитикСоединение) Тогда
		ТекстВидыАналитикСоединение = "И (" + Сред(ТекстВидыАналитикСоединение, 6 + СтрДлина("ИЛИ")) + ")";	
	КонецЕсли;
	Если ЕстьАналитикаВалюта Тогда
		ТекстАналитики = ТекстАналитики + ",
		|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта";
		ТекстВидыАналитик = ТекстВидыАналитик + ",
		|	ГруппыРаскрытия.Валютная КАК Валютная";
		ТекстАналитикиВыбор = ТекстАналитикиВыбор + ",
		|	ВЫБОР
		|		КОГДА ЗначенияПоказателей.Валютная
		|			ТОГДА ВЫБОР
		|					КОГДА ЗначенияПоказателей.АналитикаВалюта = НЕОПРЕДЕЛЕНО 
		|						ИЛИ ЗначенияПоказателей.АналитикаВалюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|						ТОГДА &Валюта
		|					ИНАЧЕ ЗначенияПоказателей.АналитикаВалюта
		|				КОНЕЦ
		|		ИНАЧЕ ЗначенияПоказателей.АналитикаВалюта
		|	КОНЕЦ КАК АналитикаВалюта";
		ДобавитьПараметрВПакет(тПараметрыПакета, Перечисления.СпособыВычисленияПараметровОперандов.ВалютаОтчета,,"Валюта");
	КонецЕсли;
	
	Если МаксКлючевыхАналитик = 0 Тогда
		ТекстМаксКлючевыхАналитик = ""; 
	Иначе
		ТекстМаксКлючевыхАналитик = " + " + Формат(МаксКлючевыхАналитик, "ЧГ=0");
	КонецЕсли;
	
	ДобавитьПараметрВПакет(тПараметрыПакета, "ПустыеАналитики",, "ПустыеАналитики");

	ТекстЗапроса =	
		"ВЫБРАТЬ
		|	ГруппыРаскрытия.ЧислоАналитик"+ТекстМаксКлючевыхАналитик+" КАК ЧислоАналитик,
		|	ЗначенияПоказателей.Показатель КАК Показатель,		
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстРесурсы+ТекстАналитики+ТекстВидыАналитик+"
		|ПОМЕСТИТЬ втДанныеДляРасчетаАналитикПредварительные
		|ИЗ
		|	"+ИмяИсходнойТаблицы+" КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ЗначенияПоказателей.Показатель = ПоказателиОтчетов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ПО ПоказателиОтчетов.ГруппаРаскрытия = ГруппыРаскрытия.Ссылка		
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ "+ИмяИсходнойТаблицы+"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыРаскрытия.ПериодОтчета КАК ПериодОтчета,
		|	Периоды.ДатаНачала КАК ДатаНачала"+ТекстВидыАналитик+"
		|ПОМЕСТИТЬ втВсеАналитикиДаты
		|ИЗ
		|	втДанныеДляРасчетаАналитикПредварительные КАК ГруппыРаскрытия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
		|		ПО ГруппыРаскрытия.ПериодОтчета = Периоды.Ссылка		
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ЗначенияАналитикПоУмолчанию.Период КАК Период,
		|	ЗначенияАналитикПоУмолчанию.ВидАналитики КАК ВидАналитики,
		|	ЗначенияАналитикПоУмолчанию.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втДанныеДляРасчетаАналитик
		|ИЗ
		|	РегистрСведений.ЗначенияАналитикПоУмолчанию КАК ЗначенияАналитикПоУмолчанию
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВсеАналитикиДаты КАК ЗначенияПоказателей
		|		ПО ЗначенияАналитикПоУмолчанию.Период <= ЗначенияПоказателей.ДатаНачала
		|			"+ТекстВидыАналитикСоединение+"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ДанныеДляРасчетаАналитик.Период) КАК Период,
		|	ДанныеДляРасчетаАналитик.ПериодОтчета КАК ПериодОтчета,
		|	ДанныеДляРасчетаАналитик.ВидАналитики КАК ВидАналитики
		|ПОМЕСТИТЬ втДатыДляРасчетаАналитик
		|ИЗ
		|	втДанныеДляРасчетаАналитик КАК ДанныеДляРасчетаАналитик
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеДляРасчетаАналитик.ПериодОтчета,
		|	ДанныеДляРасчетаАналитик.ВидАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляРасчетаАналитик.ПериодОтчета КАК ПериодОтчета,
		|	ДанныеДляРасчетаАналитик.ВидАналитики КАК ВидАналитики,
		|	ДанныеДляРасчетаАналитик.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втАналитикиПоУмолчанию
		|ИЗ
		|	втДанныеДляРасчетаАналитик КАК ДанныеДляРасчетаАналитик
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДатыДляРасчетаАналитик КАК ДатыДляРасчетаАналитик
		|		ПО ДанныеДляРасчетаАналитик.Период = ДатыДляРасчетаАналитик.Период
		|			И ДанныеДляРасчетаАналитик.ПериодОтчета = ДатыДляРасчетаАналитик.ПериодОтчета
		|			И ДанныеДляРасчетаАналитик.ВидАналитики = ДатыДляРасчетаАналитик.ВидАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета"+ТекстРесурсы+ТекстАналитикиВыбор+"
		|ПОМЕСТИТЬ "+ИмяИсходнойТаблицы+"
		|ИЗ
		|	втДанныеДляРасчетаАналитикПредварительные КАК ЗначенияПоказателей"+ТекстАналитикиСоединение;
	
	нСтрокаТаблицыЗапросов						= глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса;
	нСтрокаТаблицыЗапросов.тПараметрыПакета		= тПараметрыПакета;
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ТАБЛИЦА НОВЫХ ЗНАЧЕНИЙ ПОТРЕБИТЕЛЕЙ С ЗАПОЛНЕННЫМИ АНАЛИТИКАМИ'");
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ЗаполнениеПустыхАналитик;	
	
КонецПроцедуры

Функция ТекстЗапросаПересчетаКурсовВалют(СтруктураРасчетаПоказателей, тПараметрыПакета, ПересчетВДопВалюты = Ложь, ТекстАналитики = "")
	
	ДанныеВидаОтчета						= СтруктураРасчетаПоказателей.ДанныеВидаОтчета;
	МаксКлючевыхАналитик					= СтруктураРасчетаПоказателей.МаксКлючевыхАналитик;
	тРасшифровкаГруппОтборов				= СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборов;
	ЕстьЗначение							= СтруктураРасчетаПоказателей.ЕстьЗначение;
	ЕстьЗначениеВалюта						= СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта;
	ЕстьЗначениеНечисловое					= СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое;
	ЕстьВидКурсаПрочее						= СтруктураРасчетаПоказателей.ЕстьВидКурсаПрочее;
	ЕстьВидКурсаЗначениеУказанноеВДокументе	= СтруктураРасчетаПоказателей.ЕстьВидКурсаЗначениеУказанноеВДокументе;
	ЕстьВидКурсаКурсНаМоментНачисления		= СтруктураРасчетаПоказателей.ЕстьВидКурсаКурсНаМоментНачисления;
	ПересчитатьВОсновнуюВалюту				= СтруктураРасчетаПоказателей.ПересчитатьВОсновнуюВалюту;
	
	Если ПересчетВДопВалюты Тогда
		ДобавитьПараметрВПакет(тПараметрыПакета, "ДополнительныеВалюты",, "ДополнительныеВалюты");
	КонецЕсли;
	
	// Если только нечисловые, тогда передадим только дополнительные валюты
	Если НЕ ЕстьЗначение И НЕ ПересчитатьВОсновнуюВалюту Тогда
		
		ТекстОбщегоЗапроса = 
			"////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	РассчитанныеПоказатели.ПериодОтчета КАК ПериодОтчета,
			|	РассчитанныеПоказатели.Показатель КАК Показатель,
			|	Валюты.Ссылка КАК Валюта,
			|	1 КАК КоэффициентПересчета
			|ПОМЕСТИТЬ втКурсыВалют
			|ИЗ
			|	втРассчитанныеПоказатели КАК РассчитанныеПоказатели,
			|	Справочник.Валюты КАК Валюты
			|ГДЕ
			|	Валюты.Ссылка В (&ДополнительныеВалюты)
			|;";

		Возврат ТекстОбщегоЗапроса;
		
	КонецЕсли;
	
	// Шаблон запроса
	ТекстЗапроса = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РассчитанныеПоказатели.Показатель КАК Показатель,
		|	РассчитанныеПоказатели.ПериодОтчета КАК ПериодОтчета
		|ПОМЕСТИТЬ втКурсыВсеПоказателиПериоды
		|ИЗ 
		|	втРассчитанныеПоказатели КАК РассчитанныеПоказатели
		|
		|ИНДЕКСИРОВАТЬ ПО 
		|	Показатель, 
		|	ПериодОтчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РассчитанныеПоказатели.Показатель КАК Показатель
		|ПОМЕСТИТЬ втКурсыВсеПоказатели
		|ИЗ
		|	втКурсыВсеПоказателиПериоды КАК РассчитанныеПоказатели
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеПоказатели.Показатель КАК Показатель,
		|	ПоказателиОтчетов.ВидКурса КАК ВидКурса,
		|	ПоказателиОтчетов.СвязанныйПоказатель КАК СвязанныйПоказатель,
		|	ПоказателиОтчетов.НеФинансовый КАК НеФинансовый,
		|	ПоказателиОтчетов.ПересчитыватьВалютнуюСумму КАК ПересчитыватьВалютнуюСумму
		|ПОМЕСТИТЬ втКурсыДанныеПоказателей
		|ИЗ
		|	втКурсыВсеПоказатели КАК ВсеПоказатели
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ВсеПоказатели.Показатель = ПоказателиОтчетов.Ссылка";	
	
	Если ЕстьЗначениеВалюта Тогда
			
		Если ПересчетВДопВалюты Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|ИНДЕКСИРОВАТЬ ПО 
			|	Показатель
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Валюты.Ссылка КАК Валюта
			|ПОМЕСТИТЬ втКурсыВсеВалюты 
			|ИЗ
			|	втРассчитанныеПоказатели КАК ПериодыПоказатели
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
			|		ПО Валюты.Ссылка = ПериодыПоказатели.АналитикаВалюта
			|			ИЛИ Валюты.Ссылка В (&ДополнительныеВалюты)
			|;
			|";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|			И ПоказателиОтчетов.ПересчитыватьВалютнуюСумму
			|ИНДЕКСИРОВАТЬ ПО 
			|	Показатель
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Валюты.Ссылка КАК Валюта
			|ПОМЕСТИТЬ втКурсыВсеВалюты 
			|ИЗ
			|	втРассчитанныеПоказатели КАК ПериодыПоказатели
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
			|		ПО Валюты.Ссылка = ПериодыПоказатели.АналитикаВалюта
			|			ИЛИ Валюты.Ссылка = &Валюта
			|;
			|";
			ДобавитьПараметрВПакет(тПараметрыПакета, Перечисления.СпособыВычисленияПараметровОперандов.ВалютаОтчета,,"Валюта");
		КонецЕсли;
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Валюты.Ссылка КАК Валюта
			|ПОМЕСТИТЬ втКурсыВсеВалюты 
			|ИЗ
			|	Справочник.Валюты КАК Валюты
			|ГДЕ
			|	Валюты.Ссылка В (&ДополнительныеВалюты)
			|;
			|";
	
	КонецЕсли;
	
	// Сформируем текст отбора, если необходимо
	Если ЕстьВидКурсаЗначениеУказанноеВДокументе ИЛИ ЕстьВидКурсаКурсНаМоментНачисления Тогда	
		ДобавитьОтборыПоКлючевымСрезам(СтруктураРасчетаПоказателей);
		ТекстОтбора = ТекстЗапросаПоОтборам(СтруктураРасчетаПоказателей.тРасшифровкаГруппОтборовВерсии, тПараметрыПакета);
		ТекстОтбора = СтрЗаменить(ТекстОтбора,"#ИмяТаблицы","ВерсииЗначенийПоказателей");
	Иначе
		ТекстОтбора = "";
	КонецЕсли;
	
	ТекстОбщегоЗапроса = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоказателиПериоды.ПериодОтчета,
		|	ПоказателиПериоды.Показатель,
		|	Валюты.Валюта КАК Валюта,
		|	1 КАК Курс,
		|	1 КАК Кратность
		|ПОМЕСТИТЬ втКурсы 
		|ИЗ
		|	втКурсыВсеПоказателиПериоды КАК ПоказателиПериоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКурсыДанныеПоказателей КАК ДанныеПоказателей
		|		ПО ПоказателиПериоды.Показатель = ДанныеПоказателей.Показатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсыВсеВалюты КАК Валюты
		|		ПО ИСТИНА
		|ГДЕ
		|	ДанныеПоказателей.НеФинансовый
		|";
	
	ТекстУничтожить = "
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втКурсыВсеПоказателиПериоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втКурсыВсеПоказатели
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втКурсыДанныеПоказателей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втКурсыВсеВалюты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втКурсы
		|;";
		
	Если ЕстьВидКурсаЗначениеУказанноеВДокументе Тогда 
		
		ТекстЗапроса = ТекстЗапроса + "
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоказателиДляКурсовВалют.Ссылка КАК Показатель,
			|	ПоказателиДляКурсовВалют.ПоказательКурса КАК ПоказательКурса,
			|	ПоказателиДляКурсовВалют.Кратность КАК Кратность,
			|	ПоказателиДляКурсовВалют.Валюта КАК Валюта
			|ПОМЕСТИТЬ втКурсыПоказателиДляКурсовВалют
			|ИЗ
			|	втКурсыДанныеПоказателей КАК ДанныеПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов.ПоказателиДляКурсовВалют КАК ПоказателиДляКурсовВалют
			|		ПО ДанныеПоказателей.Показатель = ПоказателиДляКурсовВалют.Ссылка
			|ГДЕ
			|	НЕ ДанныеПоказателей.НеФинансовый
			|	И ДанныеПоказателей.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ПоказательКурса	
			|;	
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
