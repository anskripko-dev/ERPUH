	// Запись нечисловых, необходимо агрегировать по номеру транзакции, чтобы не было дублирующих записей
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
		|	ЗначенияПоказателей.Значение КАК Значение
		|ПОМЕСТИТЬ втДанныеДляРасчетаНечисловыеИтог
		|ИЗ
		|	втЛогИзмененныхПоказателейНечисловыеИтог"+СтруктураДанных.ФильтрПоСтатусам+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеПоказателей КАК ДанныеПоказателей
		|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеПоказателей.ПравилоОбработки
		|		И ЗначенияПоказателей.Показатель = ДанныеПоказателей.Показатель
		|ГДЕ
		|	ДанныеПоказателей.ИндексРегистраПоказателя = -11";
	
	СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	////////////////////////////////////////////////////////////////////////////////
	// Добавим получившиеся записи в итоговый запрос
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
		|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	0 КАК ЗначениеВалюта,
		|	-1 КАК ИндексРегистраПоказателя,
		|	ИСТИНА КАК ИтоговоеЗначение
		|ИЗ
		|	втДанныеДляРасчетаНечисловыеИтог КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
		|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
		|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
		|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета";
	
	СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
	
КонецПроцедуры

Процедура ПодготовитьДанныеНечисловыхПоказателейДляЗаписи(ВыборкаИндексы, СтруктураДанных)
	
	ТекстАналитики = "
		|	ЗначенияПоказателей.АналитикаВалюта,
		|	ЗначенияПоказателей.Аналитика1,
		|	ЗначенияПоказателей.Аналитика2,
		|	ЗначенияПоказателей.Аналитика3,
		|	ЗначенияПоказателей.Аналитика4,
		|	ЗначенияПоказателей.Аналитика5,
		|	ЗначенияПоказателей.Аналитика6";
	
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
		|	ДанныеВидовОтчетов.ВидОтчета КАК ВидОтчета,
		|	ДанныеВидовОтчетов.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
		|	ДанныеВидовОтчетов.МаксАналитикОтчета КАК МаксАналитикОтчета,
		|	ДанныеПоказателей.ВидИтога КАК ВидИтога,
		|	ДанныеПоказателей.ТипЗначения КАК ТипЗначения,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции
		|ПОМЕСТИТЬ втДанныеДляРасчетаНечисловые
		|ИЗ
		|	втЛогИзмененныхПоказателейНечисловыеИтог"+СтруктураДанных.ФильтрПоСтатусам+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеВидовОтчетов КАК ДанныеВидовОтчетов
		|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеВидовОтчетов.ПравилоОбработки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеПоказателей КАК ДанныеПоказателей
		|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеПоказателей.ПравилоОбработки
		|		И ЗначенияПоказателей.Показатель = ДанныеПоказателей.Показатель
		|ГДЕ
		|	ДанныеПоказателей.ИндексРегистраПоказателя = -1";
	
	СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
		
	ВыборкаКлючевыеАналитики = ВыборкаИндексы.Выбрать();
	Пока ВыборкаКлючевыеАналитики.Следующий() Цикл
			
		ТекстМаксАналитикОтчета = Формат(ВыборкаКлючевыеАналитики.МаксАналитикОтчета, "ЧН=0; ЧГ=0");		
		ТекстКлючевыеАналитикиСоединение = "";
		ТекстАналитикиСинтетика = "";
		ТекстАналитикиСинтетикаНеопределено = "";
		ТекстАналитикиУсловие = "";
		
		Для Сч = 1 По ВыборкаКлючевыеАналитики.МаксАналитикОтчета Цикл
			ТекстКлючевыеАналитикиСоединение = ТекстКлючевыеАналитикиСоединение + "
				|		И ТаблицаСоединения.Аналитика" + Сч + " = ЗначенияПоказателей.Аналитика" + Сч;
			ТекстАналитикиСинтетика = ТекстАналитикиСинтетика + "
				|	ЗначенияПоказателей.Аналитика" + Сч + ",";
		КонецЦикла;
		Для Сч = ВыборкаКлючевыеАналитики.МаксАналитикОтчета+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			ТекстАналитикиСинтетикаНеопределено = ТекстАналитикиСинтетикаНеопределено + "
				|	НЕОПРЕДЕЛЕНО КАК Аналитика" + Сч + ",";
			ТекстАналитикиУсловие = ТекстАналитикиУсловие + "
				|	И ЗначенияПоказателей.Аналитика" + Сч + " = НЕОПРЕДЕЛЕНО"; 
		КонецЦикла;
			
		////////////////////////////////////////////////////////////////////////////////
		// Запись нечисловых, необходимо агрегировать по номеру транзакции, чтобы не было дублирующих записей
			
		ТекстЗапроса = "
			|ВЫБРАТЬ
			|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
			|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
			|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
			|	ЗначенияПоказателей.ТипЗначения КАК ТипЗначения,
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции,
			|	10000000000 КАК НомерЗаписи
			|ПОМЕСТИТЬ втПронумерованныеЗаписиНечисловые_"+ТекстМаксАналитикОтчета+"
			|ИЗ
			|	втДанныеДляРасчетаНечисловые КАК ЗначенияПоказателей
			|ГДЕ
			|	ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	"+СтруктураДанных.ТекстПоля+"
			|	ЗначенияПоказателейОтчетов.АналитикаВалюта,
			|	ЗначенияПоказателейОтчетов.Аналитика1,
			|	ЗначенияПоказателейОтчетов.Аналитика2,
			|	ЗначенияПоказателейОтчетов.Аналитика3,
			|	ЗначенияПоказателейОтчетов.Аналитика4,
			|	ЗначенияПоказателейОтчетов.Аналитика5,
			|	ЗначенияПоказателейОтчетов.Аналитика6,
			|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
			|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
			|	ЗначенияПоказателей.ТипЗначения КАК ТипЗначения,
			|	ЗначенияПоказателейОтчетов.Значение КАК Значение,
			|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции,
			|	ТаблицаСоединения.Код КАК НомерЗаписи
			|ИЗ
			|	РегистрСведений.ЗначенияПоказателейОтчетовНечисловые КАК ЗначенияПоказателейОтчетов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииЗначенийПоказателей КАК ТаблицаСоединения
			|			ПО ЗначенияПоказателейОтчетов.Версия = ТаблицаСоединения.Ссылка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДляРасчетаНечисловые КАК ЗначенияПоказателей
			|			ПО ТаблицаСоединения.ВидОтчета = ЗначенияПоказателей.ВидОтчета
			|			И ТаблицаСоединения.Сценарий = ЗначенияПоказателей.Сценарий
			|			И ТаблицаСоединения.Организация = ЗначенияПоказателей.Организация
			|			И ТаблицаСоединения.Проект = ЗначенияПоказателей.Проект
			|			И ТаблицаСоединения.ПериодОтчета = ЗначенияПоказателей.ПериодОтчета
			|			И ТаблицаСоединения.Валюта = ЗначенияПоказателей.Валюта"+ТекстКлючевыеАналитикиСоединение+" 
			|			И ЗначенияПоказателей.Показатель = ЗначенияПоказателейОтчетов.Показатель
			|			И ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
			|			И НЕ ЗначенияПоказателейОтчетов.ИтоговоеЗначение
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
			|	МАКСИМУМ(ЗначенияПоказателей.НомерЗаписи) КАК НомерЗаписи
			|ПОМЕСТИТЬ втМаксимальныеНомераЗаписейНечисловые_"+ТекстМаксАналитикОтчета+"
			|ИЗ
			|	втПронумерованныеЗаписиНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
			|
			|СГРУППИРОВАТЬ ПО
			|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
			|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
			|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
			|	ЗначенияПоказателей.ТипЗначения КАК ТипЗначения,
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции
			|ПОМЕСТИТЬ втВсеЗначенияПоказателейНечисловые_"+ТекстМаксАналитикОтчета+"
			|ИЗ
			|	втПронумерованныеЗаписиНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныеНомераЗаписейНечисловые_"+ТекстМаксАналитикОтчета+" КАК МаксимальныеНомераЗаписей
			|			ПО ЗначенияПоказателей.ПравилоОбработки = МаксимальныеНомераЗаписей.ПравилоОбработки
			|			И ЗначенияПоказателей.Сценарий = МаксимальныеНомераЗаписей.Сценарий
			|			И ЗначенияПоказателей.Организация = МаксимальныеНомераЗаписей.Организация
			|			И ЗначенияПоказателей.Проект = МаксимальныеНомераЗаписей.Проект
			|			И ЗначенияПоказателей.ПериодОтчета = МаксимальныеНомераЗаписей.ПериодОтчета
			|			И ЗначенияПоказателей.Валюта = МаксимальныеНомераЗаписей.Валюта
			|			И ЗначенияПоказателей.Показатель = МаксимальныеНомераЗаписей.Показатель
			|			И ЗначенияПоказателей.АналитикаВалюта = МаксимальныеНомераЗаписей.АналитикаВалюта
			|			И ЗначенияПоказателей.Аналитика1 = МаксимальныеНомераЗаписей.Аналитика1
			|			И ЗначенияПоказателей.Аналитика2 = МаксимальныеНомераЗаписей.Аналитика2
			|			И ЗначенияПоказателей.Аналитика3 = МаксимальныеНомераЗаписей.Аналитика3
			|			И ЗначенияПоказателей.Аналитика4 = МаксимальныеНомераЗаписей.Аналитика4
			|			И ЗначенияПоказателей.Аналитика5 = МаксимальныеНомераЗаписей.Аналитика5
			|			И ЗначенияПоказателей.Аналитика6 = МаксимальныеНомераЗаписей.Аналитика6
			|			И ЗначенияПоказателей.НомерЗаписи = МаксимальныеНомераЗаписей.НомерЗаписи";
			
		СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
			
		Если НЕ ВыборкаИндексы.СохранятьИсториюИзменений Тогда
			
			// Есть виды отчетов без сохранения истории изменений
			// Добавим все значения показателей в результирующую таблицу
			
			ТекстЗапроса = "
				|ВЫБРАТЬ
				|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
				|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
				|	ЗначенияПоказателей.Значение КАК Значение,
				|	0 КАК ЗначениеВалюта,
				|	-1 КАК ИндексРегистраПоказателя,
				|	ЛОЖЬ КАК ИтоговоеЗначение
				|ИЗ
				|	втВсеЗначенияПоказателейНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
				|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
				|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
				|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
				|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
				|ГДЕ
				|	НЕ ЗначенияПоказателей.СохранятьИсториюИзменений";
			
			СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
			
		КонецЕсли;
			
		////////////////////////////////////////////////////////////////////////////////
		// Сделаем расчет синтетических итогов
		
		ТекстПоляСинтетика = СтрЗаменить(СтруктураДанных.ТекстПоля,"
			|	ЗначенияПоказателей.СпособФормированияОтчета,
			|	ЗначенияПоказателей.ИспользуемаяИБ,", "");
		
		// Вычислим способ формирования отчета для записи в синтетику
		ТекстЗапроса = "
			|ВЫБРАТЬ
			|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
			|	МАКСИМУМ(ЗначенияПоказателей.НомерТранзакции) КАК НомерТранзакции
			|ПОМЕСТИТЬ втМаксимальныйНомерТранзакцииДляСинтетикиНечисловые_"+ТекстМаксАналитикОтчета+"
			|ИЗ
			|	втВсеЗначенияПоказателейНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
			|
			|СГРУППИРОВАТЬ ПО
			|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
			|	ИСТИНА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
			|	ЗначенияПоказателей.СпособФормированияОтчета КАК СпособФормированияОтчета,
			|	ЗначенияПоказателей.ИспользуемаяИБ КАК ИспользуемаяИБ
			|ПОМЕСТИТЬ втСпособФормированияОтчетаДляСинтетикиНечисловые_"+ТекстМаксАналитикОтчета+"
			|ИЗ
			|	втВсеЗначенияПоказателейНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерТранзакцииДляСинтетикиНечисловые_"+ТекстМаксАналитикОтчета+" КАК ТаблицаСоединения
			|		ПО (ЗначенияПоказателей.НомерТранзакции = ТаблицаСоединения.НомерТранзакции)
			|			И(ЗначенияПоказателей.ПравилоОбработки = ТаблицаСоединения.ПравилоОбработки)
			|			И (ЗначенияПоказателей.Сценарий = ТаблицаСоединения.Сценарий)
			|			И (ЗначенияПоказателей.Организация = ТаблицаСоединения.Организация)
			|			И (ЗначенияПоказателей.Проект = ТаблицаСоединения.Проект)
			|			И (ЗначенияПоказателей.ПериодОтчета = ТаблицаСоединения.ПериодОтчета)
			|			И (ЗначенияПоказателей.Валюта = ТаблицаСоединения.Валюта)
			|			И (ЗначенияПоказателей.Показатель = ТаблицаСоединения.Показатель)"+ТекстКлючевыеАналитикиСоединение;
			
		СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
			
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	"+ТекстПоляСинтетика+"
			|	ТаблицаСоединения.СпособФормированияОтчета КАК СпособФормированияОтчета,
			|	ТаблицаСоединения.ИспользуемаяИБ КАК ИспользуемаяИБ,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта,"+ТекстАналитикиСинтетика+ТекстАналитикиСинтетикаНеопределено+"
			|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
			|	ВЫБОР
			|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.НеРассчитывается)
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Максимум)
			|			ТОГДА МАКСИМУМ(ЗначенияПоказателей.Значение)
			|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Минимум)
			|			ТОГДА МИНИМУМ(ЗначенияПоказателей.Значение)
			|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Сумма)
			|			И ЗначенияПоказателей.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Дата)
			|			ТОГДА МИНИМУМ(ЗначенияПоказателей.Значение)
			|		КОГДА ЗначенияПоказателей.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Дата)
			|			ТОГДА МАКСИМУМ(ЗначенияПоказателей.Значение)
			|		КОГДА ЗначенияПоказателей.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Булево)
			|			ТОГДА МАКСИМУМ(ЗначенияПоказателей.Значение)
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК Значение,
			|	0 КАК ЗначениеВалюта,
			|	-1 КАК ИндексРегистраПоказателя,
			|	ИСТИНА КАК ИтоговоеЗначение
			|ИЗ
			|	втВсеЗначенияПоказателейНечисловые_"+ТекстМаксАналитикОтчета+" КАК ЗначенияПоказателей
			|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
			|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
			|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
			|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ втСпособФормированияОтчетаДляСинтетикиНечисловые_"+ТекстМаксАналитикОтчета+" КАК ТаблицаСоединения
			|		ПО (ЗначенияПоказателей.ПравилоОбработки = ТаблицаСоединения.ПравилоОбработки)
			|			И (ЗначенияПоказателей.Сценарий = ТаблицаСоединения.Сценарий)
			|			И (ЗначенияПоказателей.Организация = ТаблицаСоединения.Организация)
			|			И (ЗначенияПоказателей.Проект = ТаблицаСоединения.Проект)
			|			И (ЗначенияПоказателей.ПериодОтчета = ТаблицаСоединения.ПериодОтчета)
			|			И (ЗначенияПоказателей.Валюта = ТаблицаСоединения.Валюта)
			|			И (ЗначенияПоказателей.Показатель = ТаблицаСоединения.Показатель)"+ТекстКлючевыеАналитикиСоединение+"
			|
			|ГДЕ НЕ ЗначенияПоказателей.Значение = НЕОПРЕДЕЛЕНО
			|	И НЕ (ЗначенияПоказателей.АналитикаВалюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)"+ТекстАналитикиУсловие+")
			|
			|СГРУППИРОВАТЬ ПО 
			|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
			|	ТаблицаСоединения.СпособФормированияОтчета,
			|	ТаблицаСоединения.ИспользуемаяИБ,
			|	ЗначенияПоказателей.ВидИтога,
			|	ЗначенияПоказателей.ТипЗначения,
			|	ДанныеУправленияПериодом.УправлениеПериодом";
		
		СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// Добавим получившиеся записи в итоговый запрос
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+",
		|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	0 КАК ЗначениеВалюта,
		|	-1 КАК ИндексРегистраПоказателя,
		|	ЛОЖЬ КАК ИтоговоеЗначение
		|ИЗ
		|	втДанныеДляРасчетаНечисловые КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
		|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
		|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
		|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
		|ГДЕ
		|	ЗначенияПоказателей.СохранятьИсториюИзменений";
	
	СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);

КонецПроцедуры

Процедура ПодготовитьДанныеПоказателейДляЗаписи(ВыборкаИндексы, СтруктураДанных)
	
	ТекстАналитики = "";
	ТекстАналитикиНеопределено = "";
	ТекстАналитикиСоединение = "";
	
	ИндексРегистра = ВыборкаИндексы.ИндексРегистраПоказателя;
	ТекстИндексРегистра = Формат(ИндексРегистра, "ЧН=0; ЧГ=0");
	Если ИндексРегистра = -2 Тогда
		ПостфиксРегистра = "Валютные";
		ТекстАналитики = "
		|	ЗначенияПоказателей.АналитикаВалюта,";
		ТекстАналитикиСоединение = "
		|	И ЗначенияПоказателей.АналитикаВалюта = ЗначенияПоказателейКонтроль.АналитикаВалюта";
	ИначеЕсли ИндексРегистра = 0 Тогда
		ПостфиксРегистра = "Синтетика";
		ТекстАналитикиНеопределено = "
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта,";
	Иначе
		ПостфиксРегистра = Строка(ВыборкаИндексы.ИндексРегистраПоказателя);
		ТекстАналитики = "
		|	ЗначенияПоказателей.АналитикаВалюта,";
		ТекстАналитикиСоединение = "
		|	И ЗначенияПоказателей.АналитикаВалюта = ЗначенияПоказателейКонтроль.АналитикаВалюта";
	КонецЕсли;
	
	Для Сч = 1 По ИндексРегистра Цикл
		ТекстАналитики = ТекстАналитики + "
		|	ЗначенияПоказателей.Аналитика" + Сч + ",";
		ТекстАналитикиСоединение = ТекстАналитикиСоединение + "
		|	И ЗначенияПоказателей.Аналитика" + Сч + " = ЗначенияПоказателейКонтроль.Аналитика" + Сч;
	КонецЦикла;
	Для Сч = Макс(ИндексРегистра,0)+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТекстАналитикиНеопределено = ТекстАналитикиНеопределено + "
		|	НЕОПРЕДЕЛЕНО КАК Аналитика" + Сч + ",";
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////
	// Сгруппируем значения показателей
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+"
		|	ДанныеВидовОтчетов.ВидОтчета КАК ВидОтчета,
		|	ДанныеВидовОтчетов.МаксАналитикОтчета КАК МаксАналитикОтчета,
		|	ДанныеВидовОтчетов.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
		|	ДанныеПоказателей.КонтролируемыйПоказатель КАК КонтролируемыйПоказатель,
		|	ДанныеПоказателей.ВидИтога КАК ВидИтога,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,
		|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции
		|ПОМЕСТИТЬ втДанныеДляРасчета_"+ПостфиксРегистра+"
		|ИЗ
		|	втЛогИзмененныхПоказателей"+СтруктураДанных.ФильтрПоСтатусам+" КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеВидовОтчетов КАК ДанныеВидовОтчетов
		|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеВидовОтчетов.ПравилоОбработки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеПоказателей КАК ДанныеПоказателей
		|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеПоказателей.ПравилоОбработки
		|			И ЗначенияПоказателей.Показатель = ДанныеПоказателей.Показатель
		|ГДЕ
		|	ДанныеПоказателей.ИндексРегистраПоказателя = "+ТекстИндексРегистра+"
		|";
	
	СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
	
	////////////////////////////////////////////////////////////////////////////////
	// Добавим сгруппированные значения показателей в результирующую таблицу
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+ТекстАналитикиНеопределено+"
		|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,
		|	"+ТекстИндексРегистра+" КАК ИндексРегистраПоказателя,
		|	ЗначенияПоказателей.МаксАналитикОтчета = " + ТекстИндексРегистра + " КАК ИтоговоеЗначение
		|ИЗ
		|	втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
		|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
		|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
		|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
		|ГДЕ
		|	ЗначенияПоказателей.СохранятьИсториюИзменений";
	
	СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
	
	////////////////////////////////////////////////////////////////////////////////
	// Цикл по ключевым аналитикам
	ВыборкаКлючевыеАналитики = ВыборкаИндексы.Выбрать();
	Пока ВыборкаКлючевыеАналитики.Следующий() Цикл
		
		МаксАналитикОтчета = ВыборкаКлючевыеАналитики.МаксАналитикОтчета;
		ТекстМаксАналитикОтчета = Формат(МаксАналитикОтчета, "ЧН=0; ЧГ=0");
		КонтролируемыйПоказатель = ВыборкаКлючевыеАналитики.КонтролируемыйПоказатель;
		ТекстКонтролируемыйПоказатель = Формат(КонтролируемыйПоказатель,"БЛ=Ложь; БИ=Истина");
		ПостфиксТаблицы = ПостфиксРегистра + "_" + ТекстМаксАналитикОтчета + "_" + ТекстКонтролируемыйПоказатель;
	
		////////////////////////////////////////////////////////////////////////////////
		// Получим абсолютные новые значения показателей
		Если (ИндексРегистра <> МаксАналитикОтчета И ВыборкаИндексы.ЕстьСложныеРасчетыСинтетики) 
			ИЛИ НЕ ВыборкаИндексы.СохранятьИсториюИзменений
			ИЛИ КонтролируемыйПоказатель Тогда
			
			ТекстКлючевыеАналитикиСоединение = "";
			Для Сч = 1 По МаксАналитикОтчета Цикл
				ТекстКлючевыеАналитикиСоединение = ТекстКлючевыеАналитикиСоединение + "
					|		И ВерсииЗначенийПоказателей.Аналитика" + Сч + " = ЗначенияПоказателей.Аналитика" + Сч;
			КонецЦикла;
				
			// Для сложных расчетов синтетики нужны абсолютные значения по всем значениям аналитик
			// Для видов отчетов без хранения истории нужны абсолютные значения по всем значениям аналитик
			ТекстЗапроса = "
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	"+СтруктураДанных.ТекстПоля+"
				|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
				|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
				|	ВерсииЗначенийПоказателей.Ссылка КАК Версия
				|ПОМЕСТИТЬ втВерсииЗначенийПоказателей_"+ПостфиксТаблицы+"
				|ИЗ
				|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
				|			ПО (ВерсииЗначенийПоказателей.ВидОтчета = ЗначенияПоказателей.ВидОтчета)
				|			И (ВерсииЗначенийПоказателей.Сценарий = ЗначенияПоказателей.Сценарий)
				|			И (ВерсииЗначенийПоказателей.Организация = ЗначенияПоказателей.Организация)
				|			И (ВерсииЗначенийПоказателей.Проект = ЗначенияПоказателей.Проект)
				|			И (ВерсииЗначенийПоказателей.ПериодОтчета = ЗначенияПоказателей.ПериодОтчета)
				|			И (ВерсииЗначенийПоказателей.Валюта = ЗначенияПоказателей.Валюта)"+ТекстКлючевыеАналитикиСоединение+"
				|			И ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
				|			И ЗначенияПоказателей.КонтролируемыйПоказатель = "+ТекстКонтролируемыйПоказатель+"
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+"
				|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
				|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
				|	ЗначенияПоказателей.Значение КАК Значение,
				|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта
				|ПОМЕСТИТЬ втНовыеЗначенияПоказателейБезГруппировки_"+ПостфиксТаблицы+"
				|ИЗ
				|	втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
				|ГДЕ
				|	ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
				|	И ЗначенияПоказателей.КонтролируемыйПоказатель = "+ТекстКонтролируемыйПоказатель+"
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	"+СтруктураДанных.ТекстПоля+СтрЗаменить(ТекстАналитики,"ЗначенияПоказателей","ЗначенияПоказателейОтчетов")+"
				|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
				|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
				|	ЗначенияПоказателейОтчетов.Значение КАК Значение,
				|	"+?(ИндексРегистра=0,"0","ЗначенияПоказателейОтчетов.ЗначениеВалюта")+" КАК ЗначениеВалюта
				|ИЗ
				|	РегистрСведений.ЗначенияПоказателейОтчетов"+ПостфиксРегистра+" КАК ЗначенияПоказателейОтчетов
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсииЗначенийПоказателей_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
				|		ПО ЗначенияПоказателейОтчетов.Версия = ЗначенияПоказателей.Версия
				|		И ЗначенияПоказателейОтчетов.Показатель = ЗначенияПоказателей.Показатель
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+"
				|	ЗначенияПоказателей.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
				|	ЗначенияПоказателей.ВидИтога КАК ВидИтога,
				|	СУММА(ЗначенияПоказателей.Значение) КАК Значение,
				|	СУММА(ЗначенияПоказателей.ЗначениеВалюта) КАК ЗначениеВалюта
				|ПОМЕСТИТЬ втНовыеЗначенияПоказателей_"+ПостфиксТаблицы+"
				|ИЗ
				|	втНовыеЗначенияПоказателейБезГруппировки_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
				|
				|СГРУППИРОВАТЬ ПО
				|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+"
				|	ЗначенияПоказателей.СохранятьИсториюИзменений,
				|	ЗначенияПоказателей.ВидИтога";
			
			СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
			
			Если НЕ ВыборкаИндексы.СохранятьИсториюИзменений Тогда
				
				// Есть виды отчетов без сохранения истории изменений
				// Добавим сгруппированные значения показателей в результирующую таблицу
				ТекстЗапроса = "
					|ВЫБРАТЬ
					|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+ТекстАналитикиНеопределено+"
					|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
					|	ЗначенияПоказателей.Значение КАК Значение,
					|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта,
					|	"+ТекстИндексРегистра+" КАК ИндексРегистраПоказателя,
					|	"+?(ИндексРегистра = МаксАналитикОтчета, "ИСТИНА", "ЛОЖЬ")+" КАК ИтоговоеЗначение
					|ИЗ
					|	втНовыеЗначенияПоказателей_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
					|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
					|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
					|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
					|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
					|ГДЕ
					|	НЕ ЗначенияПоказателей.СохранятьИсториюИзменений";
				
				СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
				
			КонецЕсли;
			
			Если КонтролируемыйПоказатель Тогда
				
				// Добавим запросы по контролю значений показателей
				Если СтруктураДанных.мПодзапросыКонтроль.Количество() = 0 Тогда
					
					// Вычислим основные валюты
					ТекстЗапроса = 
						"ВЫБРАТЬ РАЗЛИЧНЫЕ
						|	ВалютыОтчетностиСрезПоследних.Регламент КАК Регламент,
						|	ВалютыОтчетностиСрезПоследних.Организация КАК Организация,
						|	ВалютыОтчетностиСрезПоследних.Валюта КАК Валюта
						|ПОМЕСТИТЬ втОсновныеВалюты
						|ИЗ
						|	РегистрСведений.ВалютыОтчетности.СрезПоследних(
						|			,
						|			(Регламент, Организация) В
						|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						|						ДанныеУправленияПериодом.Регламент КАК Регламент,
						|						ДанныеУправленияПериодом.Организация КАК Организация
						|					ИЗ
						|						втДанныеУправленияПериодом КАК ДанныеУправленияПериодом)
						|				И Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
						|				И ОсновнаяВалюта = ИСТИНА) КАК ВалютыОтчетностиСрезПоследних";
					
					СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
					
				КонецЕсли;
				
				ТекстЗапроса = "
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	"+СтруктураДанных.ТекстПоля+"
					|	ЗначенияПоказателей.Сценарий.КонтролирующийСценарий КАК КонтролирующийСценарий,
					|	ВерсииЗначенийПоказателей.Ссылка КАК Версия
					|ПОМЕСТИТЬ втВерсииЗначенийПоказателей_Контроль_"+ПостфиксТаблицы+"
					|ИЗ
					|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
					|			ПО (ВерсииЗначенийПоказателей.ВидОтчета = ЗначенияПоказателей.ВидОтчета)
					|			И (ВерсииЗначенийПоказателей.Сценарий = ЗначенияПоказателей.Сценарий.КонтролирующийСценарий)
					|			И (ВерсииЗначенийПоказателей.Организация = ЗначенияПоказателей.Организация)
					|			И (ВерсииЗначенийПоказателей.Проект = ЗначенияПоказателей.Проект)
					|			И (ВерсииЗначенийПоказателей.ПериодОтчета = ЗначенияПоказателей.ПериодОтчета)
					|			И (ВерсииЗначенийПоказателей.Валюта = ЗначенияПоказателей.Валюта)"+ТекстКлючевыеАналитикиСоединение+"
					|			И ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
					|			И ЗначенияПоказателей.КонтролируемыйПоказатель = "+ТекстКонтролируемыйПоказатель+"
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
					|			ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
					|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
					|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОсновныеВалюты КАК ОсновныеВалюты
					|			ПО ДанныеУправленияПериодом.Регламент = ОсновныеВалюты.Регламент
					|			И ДанныеУправленияПериодом.Организация = ОсновныеВалюты.Организация
					|			И ЗначенияПоказателей.Валюта = ОсновныеВалюты.Валюта
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	"+СтруктураДанных.ТекстПоля+СтрЗаменить(ТекстАналитики,"ЗначенияПоказателей","ЗначенияПоказателейОтчетов")+"
					|	ЗначенияПоказателей.КонтролирующийСценарий КАК КонтролирующийСценарий,
					|	СУММА(ЗначенияПоказателейОтчетов.Значение) КАК Значение
					|ПОМЕСТИТЬ втНовыеЗначенияПоказателей_Контроль_"+ПостфиксТаблицы+"
					|ИЗ
					|	РегистрСведений.ЗначенияПоказателейОтчетов"+ПостфиксРегистра+" КАК ЗначенияПоказателейОтчетов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсииЗначенийПоказателей_Контроль_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
					|		ПО ЗначенияПоказателейОтчетов.Версия = ЗначенияПоказателей.Версия
					|		И ЗначенияПоказателейОтчетов.Показатель = ЗначенияПоказателей.Показатель
					|
					|СГРУППИРОВАТЬ ПО
					|	"+СтруктураДанных.ТекстПоля+СтрЗаменить(ТекстАналитики,"ЗначенияПоказателей","ЗначенияПоказателейОтчетов")+"
					|	ЗначенияПоказателей.КонтролирующийСценарий
					|
					|ИМЕЮЩИЕ
					|	СУММА(ЗначенияПоказателейОтчетов.Значение) <> 0";
				
				СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
		
				ТекстЗапроса =
					"ВЫБРАТЬ
					|	"+СтруктураДанных.ТекстПоля+ТекстАналитики+ТекстАналитикиНеопределено+"
					|	ЗначенияПоказателейКонтроль.КонтролирующийСценарий КАК КонтролирующийСценарий,
					|	ЗначенияПоказателей.Значение,
					|	ЗначенияПоказателейКонтроль.Значение КАК ЗначениеКонтроль
					|ИЗ
					|	втНовыеЗначенияПоказателей_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНовыеЗначенияПоказателей_Контроль_"+ПостфиксТаблицы+" КАК ЗначенияПоказателейКонтроль
					|		ПО ЗначенияПоказателей.Сценарий = ЗначенияПоказателейКонтроль.Сценарий
					|		И ЗначенияПоказателей.Организация = ЗначенияПоказателейКонтроль.Организация
					|		И ЗначенияПоказателей.Проект = ЗначенияПоказателейКонтроль.Проект
					|		И ЗначенияПоказателей.ПериодОтчета = ЗначенияПоказателейКонтроль.ПериодОтчета
					|		И ЗначенияПоказателей.Валюта = ЗначенияПоказателейКонтроль.Валюта
					|		И ЗначенияПоказателей.Показатель = ЗначенияПоказателейКонтроль.Показатель
					|		И ЗначенияПоказателей.СпособФормированияОтчета = ЗначенияПоказателейКонтроль.СпособФормированияОтчета
					|		И ЗначенияПоказателей.ИспользуемаяИБ = ЗначенияПоказателейКонтроль.ИспользуемаяИБ" + ТекстАналитикиСоединение + "
					|ГДЕ
					|	ЗначенияПоказателей.Значение > ЗначенияПоказателейКонтроль.Значение";
				
				СтруктураДанных.мПодзапросыКонтроль.Добавить(ТекстЗапроса);
			
			КонецЕсли;
		
		КонецЕсли;
	
		////////////////////////////////////////////////////////////////////////////////
		// Сформируем итоги по синтетике

		Если ИндексРегистра <> МаксАналитикОтчета Тогда
			
			// Нужны итоги по синтетике
			ТекстАналитикиСинтетикаСоединение = "";
			Если МаксАналитикОтчета = 0 Тогда
				ПостфиксРегистраСинтетика = "Синтетика";
				ТекстАналитикиСинтетика = "";
				ТекстАналитикиСинтетикаНеопределено = "
				|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК АналитикаВалюта,";
			Иначе
				ПостфиксРегистраСинтетика = Строка(МаксАналитикОтчета);
				ТекстАналитикиСинтетика = "
				|	ЗначенияПоказателей.АналитикаВалюта,";
				ТекстАналитикиСинтетикаНеопределено = "";
			КонецЕсли;
			
			Для Сч = 1 По МаксАналитикОтчета Цикл
				ТекстАналитикиСинтетика = ТекстАналитикиСинтетика + "
				|	ЗначенияПоказателей.Аналитика" + Сч + ",";
				ТекстАналитикиСинтетикаСоединение = ТекстАналитикиСинтетикаСоединение + "
					|			И ЗначенияПоказателей.Аналитика" + Сч + " = ТаблицаСоединения.Аналитика" + Сч;
			КонецЦикла;
			Для Сч = МаксАналитикОтчета+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				ТекстАналитикиСинтетикаНеопределено = ТекстАналитикиСинтетикаНеопределено + "
				|	НЕОПРЕДЕЛЕНО КАК Аналитика" + Сч + ",";
			КонецЦикла;
			
			ТекстПоляСинтетика = СтрЗаменить(СтруктураДанных.ТекстПоля,"
				|	ЗначенияПоказателей.СпособФормированияОтчета,
				|	ЗначенияПоказателей.ИспользуемаяИБ,", "");
			
			// Вычислим способ формирования отчета для записи в синтетику
			ТекстЗапроса = "
				|ВЫБРАТЬ
				|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
				|	МАКСИМУМ(ЗначенияПоказателей.НомерТранзакции) КАК НомерТранзакции
				|ПОМЕСТИТЬ втМаксимальныйНомерТранзакцииДляСинтетики_"+ПостфиксТаблицы+"
				|ИЗ
				|	втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
				|
				|СГРУППИРОВАТЬ ПО
				|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
				|	ИСТИНА
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
				|	ЗначенияПоказателей.СпособФормированияОтчета КАК СпособФормированияОтчета,
				|	ЗначенияПоказателей.ИспользуемаяИБ КАК ИспользуемаяИБ
				|ПОМЕСТИТЬ втСпособФормированияОтчетаДляСинтетики_"+ПостфиксТаблицы+"
				|ИЗ
				|	втДанныеДляРасчета_"+ПостфиксРегистра+" КАК ЗначенияПоказателей
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальныйНомерТранзакцииДляСинтетики_"+ПостфиксТаблицы+" КАК ТаблицаСоединения
				|		ПО (ЗначенияПоказателей.НомерТранзакции = ТаблицаСоединения.НомерТранзакции)
				|			И(ЗначенияПоказателей.ПравилоОбработки = ТаблицаСоединения.ПравилоОбработки)
				|			И (ЗначенияПоказателей.Сценарий = ТаблицаСоединения.Сценарий)
				|			И (ЗначенияПоказателей.Организация = ТаблицаСоединения.Организация)
				|			И (ЗначенияПоказателей.Проект = ТаблицаСоединения.Проект)
				|			И (ЗначенияПоказателей.ПериодОтчета = ТаблицаСоединения.ПериодОтчета)
				|			И (ЗначенияПоказателей.Валюта = ТаблицаСоединения.Валюта)
				|			И (ЗначенияПоказателей.Показатель = ТаблицаСоединения.Показатель)"+ТекстАналитикиСинтетикаСоединение;
			
			СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
			
			// Сформируем данные для записи синтетических итогов
			Если ВыборкаИндексы.ЕстьСложныеРасчетыСинтетики ИЛИ НЕ ВыборкаИндексы.СохранятьИсториюИзменений Тогда
				
				ТекстЗапроса = "
					|ВЫБРАТЬ
					|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
					|	ВЫБОР
					|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Максимум)
					|			ТОГДА МАКСИМУМ(ЗначенияПоказателей.Значение)
					|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Минимум)
					|			ТОГДА МИНИМУМ(ЗначенияПоказателей.Значение)
					|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.Среднее)
					|			ТОГДА СРЕДНЕЕ(ЗначенияПоказателей.Значение)
					|		КОГДА ЗначенияПоказателей.ВидИтога = ЗНАЧЕНИЕ(Перечисление.ВидыИтоговПоказателя.НеРассчитывается)
					|			ТОГДА 0
					|		ИНАЧЕ СУММА(ЗначенияПоказателей.Значение)
					|	КОНЕЦ КАК Значение
					|ПОМЕСТИТЬ втНовыеЗначенияПоказателейСинтетикиБезГруппировки_"+ПостфиксТаблицы+"
					|ИЗ
					|	втНовыеЗначенияПоказателей_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
					|
					|СГРУППИРОВАТЬ ПО
					|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
					|	ЗначенияПоказателей.ВидИтога
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	"+ТекстПоляСинтетика+СтрЗаменить(ТекстАналитикиСинтетика,"ЗначенияПоказателей","ЗначенияПоказателейОтчетов")+"
					|	-1 * ЗначенияПоказателейОтчетов.Значение
					|ИЗ
					|	РегистрСведений.ЗначенияПоказателейОтчетов"+ПостфиксРегистраСинтетика+" КАК ЗначенияПоказателейОтчетов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВерсииЗначенийПоказателей_"+ПостфиксТаблицы+" КАК ЗначенияПоказателей
					|		ПО ЗначенияПоказателейОтчетов.Версия = ЗначенияПоказателей.Версия
					|		И ЗначенияПоказателейОтчетов.Показатель = ЗначенияПоказателей.Показатель
					|ГДЕ
					|	ЗначенияПоказателей.СохранятьИсториюИзменений";
				
				СтруктураДанных.мПодзапросыДанныхВТ.Добавить(ТекстЗапроса);
				
				ИмяТаблицыИсточникаСинтетика = "втНовыеЗначенияПоказателейСинтетикиБезГруппировки_"+ПостфиксТаблицы;
				ТекстОтборСинтетика = "";
				
			Иначе
				
				ИмяТаблицыИсточникаСинтетика = "втДанныеДляРасчета_"+ПостфиксРегистра;
				ТекстОтборСинтетика = "
					|ГДЕ
					|	ЗначенияПоказателей.МаксАналитикОтчета = "+ТекстМаксАналитикОтчета+"
					|	И ЗначенияПоказателей.КонтролируемыйПоказатель = "+ТекстКонтролируемыйПоказатель;
				
			КонецЕсли;
				
			// Добавим данные синтетических значений показателей в результирующую таблицу
			ТекстЗапроса = "
				|ВЫБРАТЬ
				|	"+ТекстПоляСинтетика+"
				|	ТаблицаСоединения.СпособФормированияОтчета КАК СпособФормированияОтчета,
				|	ТаблицаСоединения.ИспользуемаяИБ КАК ИспользуемаяИБ,"+ТекстАналитикиСинтетика+ТекстАналитикиСинтетикаНеопределено+"
				|	ДанныеУправленияПериодом.УправлениеПериодом КАК УправлениеПериодом,
				|	СУММА(ЗначенияПоказателей.Значение) КАК Значение,
				|	0 КАК ЗначениеВалюта,
				|	"+ТекстМаксАналитикОтчета+" КАК ИндексРегистраПоказателя,
				|	ИСТИНА КАК ИтоговоеЗначение
				|ИЗ
				|	"+ИмяТаблицыИсточникаСинтетика+" КАК ЗначенияПоказателей
				|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеУправленияПериодом КАК ДанныеУправленияПериодом
				|		ПО ЗначенияПоказателей.Сценарий = ДанныеУправленияПериодом.Сценарий
				|			И ЗначенияПоказателей.Организация = ДанныеУправленияПериодом.Организация
				|			И ЗначенияПоказателей.ПериодОтчета = ДанныеУправленияПериодом.ПериодОтчета
				|		ЛЕВОЕ СОЕДИНЕНИЕ втСпособФормированияОтчетаДляСинтетики_"+ПостфиксТаблицы+" КАК ТаблицаСоединения
				|		ПО (ЗначенияПоказателей.ПравилоОбработки = ТаблицаСоединения.ПравилоОбработки)
				|			И (ЗначенияПоказателей.Сценарий = ТаблицаСоединения.Сценарий)
				|			И (ЗначенияПоказателей.Организация = ТаблицаСоединения.Организация)
				|			И (ЗначенияПоказателей.Проект = ТаблицаСоединения.Проект)
				|			И (ЗначенияПоказателей.ПериодОтчета = ТаблицаСоединения.ПериодОтчета)
				|			И (ЗначенияПоказателей.Валюта = ТаблицаСоединения.Валюта)
				|			И (ЗначенияПоказателей.Показатель = ТаблицаСоединения.Показатель)"+ТекстАналитикиСинтетикаСоединение+ТекстОтборСинтетика+"
				|
				|СГРУППИРОВАТЬ ПО
				|	"+ТекстПоляСинтетика+ТекстАналитикиСинтетика+"
				|	ТаблицаСоединения.СпособФормированияОтчета,
				|	ТаблицаСоединения.ИспользуемаяИБ,
				|	ДанныеУправленияПериодом.УправлениеПериодом";
			
			СтруктураДанных.мПодзапросыДанных.Добавить(ТекстЗапроса);
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьВозможностьЗаписиПоказателей(Запрос, МаксАналитикОтчета, РазделениеПоПроектам, ЕстьКомментарии, ЕстьНечисловые) 
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ДанныеДляПроверки());
	ТекстыЗапросов.Добавить(ТекстЗапроса_ПроверкиСтатусов());
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Условия = Новый Структура;
	Условия.Вставить("ЕстьКомментарии", ЕстьКомментарии);
	Условия.Вставить("ЕстьНечисловые", ЕстьНечисловые);
	Условия.Вставить("РазделениеПоПроектам", РазделениеПоПроектам);
	Условия.Вставить("МаксАналитикОтчета", МаксАналитикОтчета);
	ДобавитьДополнительныеАналитики(ТекстЗапроса, Условия);
	
	Запрос.Текст = ТекстЗапроса;
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ЕстьБлокировкаПоСтатусам = Ложь;
	
	// Найдем не открытые периоды
	Результат = МассивРезультатов.Получить(5);
	Если НЕ Результат.Пустой() Тогда
		ЕстьБлокировкаПоСтатусам = Истина;
		ВыборкаЗапроса = Результат.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно записать значения показателей. Не найден открытый период по параметрам:
				|	Сценарий: ""%1"",
				|	Организация: ""%2"",
				|	Период: ""%3""'"), 
			ВыборкаЗапроса.Сценарий, ВыборкаЗапроса.Организация, ВыборкаЗапроса.ПериодОтчета);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ПроверитьВозможностьЗаписиПоказателей", , , ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	
	// Найдем заблокированные периоды
	Результат = МассивРезультатов.Получить(6);
	Если НЕ Результат.Пустой() Тогда
		ЕстьБлокировкаПоСтатусам = Истина;
		ВыборкаЗапроса = Результат.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно записать значения показателей. Установлен запрет на изменение по параметрам:
				|	Сценарий: ""%1"",
				|	Организация: ""%2"",
				|	Период: ""%3""'"), 
			ВыборкаЗапроса.Сценарий, ВыборкаЗапроса.Организация, ВыборкаЗапроса.ПериодОтчета);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ПроверитьВозможностьЗаписиПоказателей", , , ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	
	// Найдем заблокированные показатели
	Результат = МассивРезультатов.Получить(7);
	Если НЕ Результат.Пустой() Тогда
		ЕстьБлокировкаПоСтатусам = Истина;
		ВыборкаЗапроса = Результат.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно записать значение показателя. Заблокировано значение по параметрам:
				|	Сценарий: ""%1"",
				|	Организация: ""%2"",
				|	Период: ""%3""'"),
			ВыборкаЗапроса.Сценарий, ВыборкаЗапроса.Организация, ВыборкаЗапроса.ПериодОтчета);
			Для Сч = 1 По ВыборкаЗапроса.МаксАналитикОтчета Цикл
				ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб 
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Аналитика%1: ""%2""'"), Сч, ВыборкаЗапроса["Аналитика" + Сч]);
			КонецЦикла;
			Если ВыборкаЗапроса.РазделениеПоПроектам Тогда
				ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб 
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Проект: ""%1""'"), ВыборкаЗапроса.Проект);
			КонецЕсли;
			ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
				+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Показатель: ""%1""'"), ВыборкаЗапроса.Показатель);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ПроверитьВозможностьЗаписиПоказателей", , , ТекстСообщения);
		КонецЦикла;
	КонецЕсли;

	// Найдем утвержденные показатели
	Результат = МассивРезультатов.Получить(8);
	Если НЕ Результат.Пустой() Тогда
		ЕстьБлокировкаПоСтатусам = Истина;
		ВыборкаЗапроса = Результат.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно записать значение показателя. Утверждено значение по параметрам:
				|	Сценарий: ""%1"",
				|	Организация: ""%2"",
				|	Период: ""%3""'"),
			ВыборкаЗапроса.Сценарий, ВыборкаЗапроса.Организация, ВыборкаЗапроса.ПериодОтчета);
			
			Для Сч = 1 По ВыборкаЗапроса.МаксАналитикОтчета Цикл
				ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Аналитика%1: ""%2""'"), Сч, ВыборкаЗапроса["Аналитика" + Сч]);
			КонецЦикла;
			Если ВыборкаЗапроса.РазделениеПоПроектам Тогда
				ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Проект: ""%1""'"), ВыборкаЗапроса.Проект);
			КонецЕсли;
			
			ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
				+ СтрШаблон(НСтр("ru = 'Показатель: ""%1""'"), ВыборкаЗапроса.Показатель);
			
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ПроверитьВозможностьЗаписиПоказателей", , , ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	
	// Проверим, что все показатели в рамках процесса подготовки отчетности
	Результат = МассивРезультатов.Получить(9);
	Если НЕ Результат.Пустой() Тогда
		ЕстьБлокировкаПоСтатусам = Истина;
		ВыборкаЗапроса = Результат.Выбрать();
		Пока ВыборкаЗапроса.Следующий() Цикл
			ДанныеКлючевогоСреза = Новый Структура("ВерсияРегламента, УправлениеПериодом, Сценарий, ПериодОтчета, Организация, ВидОтчета, Проект");
			Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
				ДанныеКлючевогоСреза.Вставить("Аналитика" + Сч);
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(ДанныеКлючевогоСреза, ВыборкаЗапроса);
			Если НЕ УправлениеПроцессамиПодготовкиОтчетности.КлючевойСрезВРамкахПроцессаПодготовкиОтчетности(ДанныеКлючевогоСреза) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не найден этап процесса подготовки отчетности для ключевого среза:
				|	Сценарий: ""%1"",
				|	Организация: ""%2"",
				|	Период: ""%3""'"),
				ВыборкаЗапроса.Сценарий, ВыборкаЗапроса.Организация, ВыборкаЗапроса.ПериодОтчета);
				Для Сч = 1 По ВыборкаЗапроса.МаксАналитикОтчета Цикл
					ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
						+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Аналитика%1: ""%2""'"), Сч, ВыборкаЗапроса["Аналитика" + Сч]);
				КонецЦикла;
				Если ВыборкаЗапроса.РазделениеПоПроектам Тогда
					ТекстСообщения = ТекстСообщения + "," + Символы.ПС + Символы.Таб
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Проект: ""%1""'"), ВыборкаЗапроса.Проект);
				КонецЕсли;
				ТекстСообщения = ТекстСообщения + "." + Символы.ПС + Символы.Таб
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ввод документов по регламенту ""%1"" вне этапов процесса запрещен.'"), ВыборкаЗапроса.ВерсияРегламента);
				ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ПроверитьВозможностьЗаписиПоказателей", , , ТекстСообщения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Отфильтруем итоговые записи
	Если ЕстьБлокировкаПоСтатусам Тогда
		
		УсловиеПоАналитикам = "";
		Для Сч = 1 По МаксАналитикОтчета Цикл
			УсловиеПоАналитикам = УсловиеПоАналитикам + Символы.ПС + ?(УсловиеПоАналитикам="","ГДЕ","	И") + "
			|	ВЫБОР
			|		КОГДА ДанныеДляПроверки.МаксАналитикОтчета > " + (Сч-1) + "
			|			ТОГДА ЗначенияПоказателей.Аналитика" + Сч + " = ДанныеДляПроверки.Аналитика" + Сч + "
			|	КОНЕЦ";
		КонецЦикла;
		
		ТекстыЗапросов.Очистить();
		ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ДоступныеДляЗаписиПоказатели(УсловиеПоАналитикам));
		Если ЕстьНечисловые Тогда
			ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ДоступныеДляЗаписиНечисловыеПоказатели(УсловиеПоАналитикам));
		КонецЕсли;
		Если ЕстьКомментарии Тогда
			ТекстыЗапросов.Добавить(ТекстЗапросаВТ_ДоступныеДляЗаписиКомментарии(УсловиеПоАналитикам));
		КонецЕсли;
		ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.Выполнить();
		
	КонецЕсли;
		
	Возврат ЕстьБлокировкаПоСтатусам;
		
КонецФункции

Функция ТекстЗапросаВТ_ДанныеДляПроверки()
	
	ТекстЗапроса =
	// Пакет 1
	"ВЫБРАТЬ
	|	ДанныеВидовОтчетов.ВидОтчета КАК ВидОтчета,
	|	ДанныеВидовОтчетов.ВидОтчета.ОбъектДляСогласованияЗначений КАК ОбъектДляСогласованияЗначений,
