Функция ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов,тПараметрыПакета,УИДГруппыОтборов=0,ОператорОбъединения=" И ",ИдентификаторРодителя=0)
	
	ТекстЗапросаПоОтборам = "";
	ОтборГруппОтборов = тРасшифровкаГруппОтборов.НайтиСтроки(
		Новый Структура("УИДГруппыОтборов,ИдентификаторРодителя",УИДГруппыОтборов,ИдентификаторРодителя));
		
	Для Каждого СтрокаГруппыОтборов Из ОтборГруппОтборов Цикл
		
		Если СтрокаГруппыОтборов.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ГруппаИ Тогда			
			
			ТекстОтбора = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов,тПараметрыПакета,УИДГруппыОтборов,,СтрокаГруппыОтборов.ИдентификаторСтроки);
			Если СокрЛП(ТекстОтбора) <> "" Тогда
				ТекстЗапросаПоОтборам = ТекстЗапросаПоОтборам + ?(ТекстЗапросаПоОтборам = "","",Символы.ПС + Символы.Таб) + ОператорОбъединения + "(" + Сред(ТекстОтбора,СтрДлина(" И ")) + ")";
			КонецЕсли;	
				
		ИначеЕсли СтрокаГруппыОтборов.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ГруппаИЛИ Тогда
			
			ТекстОтбора = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов,тПараметрыПакета,УИДГруппыОтборов," ИЛИ ",СтрокаГруппыОтборов.ИдентификаторСтроки);
			Если СокрЛП(ТекстОтбора) <> "" Тогда				
				ТекстЗапросаПоОтборам = ТекстЗапросаПоОтборам + ?(ТекстЗапросаПоОтборам = "","",Символы.ПС + Символы.Таб) + ОператорОбъединения + "(" + Сред(ТекстОтбора,СтрДлина(" ИЛИ ")) + ")";
			КонецЕсли;
			
		ИначеЕсли СтрокаГруппыОтборов.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ГруппаНЕ Тогда			
			
			ТекстОтбора = ТекстЗапросаПоОтборам(тРасшифровкаГруппОтборов,тПараметрыПакета,УИДГруппыОтборов,,СтрокаГруппыОтборов.ИдентификаторСтроки);
			Если СокрЛП(ТекстОтбора) <> "" Тогда
				ТекстЗапросаПоОтборам = ТекстЗапросаПоОтборам + ?(ТекстЗапросаПоОтборам = "","",Символы.ПС + Символы.Таб) + ОператорОбъединения + "НЕ (" + Сред(ТекстОтбора,СтрДлина(" И ")) + ")";
			КонецЕсли;
			
		Иначе
			
			ТекстЗапросаПоОтборам = ТекстЗапросаПоОтборам + ?(ТекстЗапросаПоОтборам = "","",Символы.ПС + Символы.Таб)
				+ ТекстЗапросаПоОтбору(СтрокаГруппыОтборов,тПараметрыПакета,ОператорОбъединения);					
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстЗапросаПоОтборам;
	
КонецФункции

Функция ТекстЗапросаПоОтбору(СтрокаОтбора, тПараметрыПакета, ОператорОбъединения="")
	
	ПереопределитьТипОтбора(СтрокаОтбора.ПолеБД, СтрокаОтбора.СпособВычисленияПараметра);
	Отбор = СтрокаОтбора.СпособВычисленияПараметра;
	
	Если ЗначениеЗаполнено(СтрокаОтбора.ТипЗначенияАналитики)
		И Отбор <> Перечисления.СпособыВычисленияПараметровОперандов.ТипЗначения 
		И Отбор <> Перечисления.СпособыВычисленияПараметровОперандов.СписокТиповЗначений Тогда
		ПервыйРазделитель = СтрНайти(СтрокаОтбора.ПолеБД, ".");
		Если ПервыйРазделитель = 0 Тогда
			ИмяПоля = ОператорОбъединения 
				+ "ВЫРАЗИТЬ(#ИмяТаблицы." + СтрокаОтбора.ПолеБД + " КАК " + СтрокаОтбора.ТипЗначенияАналитики + ")";
		Иначе
			ИмяПоля = ОператорОбъединения 
				+ "ВЫРАЗИТЬ(#ИмяТаблицы." + Лев(СтрокаОтбора.ПолеБД, ПервыйРазделитель-1) + " КАК " + СтрокаОтбора.ТипЗначенияАналитики + ")" 
				+ Сред(СтрокаОтбора.ПолеБД, ПервыйРазделитель);
		КонецЕсли;
	Иначе	
		ИмяПоля = ОператорОбъединения + "#ИмяТаблицы." + СтрокаОтбора.ПолеБД;
	КонецЕсли;
	
	Если Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
		Возврат "";
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
		ЗначениеОтбора = СтрокаОтбора.ТекстМодуля;
	Иначе
		ПереопределитьЗначениеОтбора(СтрокаОтбора.ПолеБД, СтрокаОтбора.УточнениеСпособаОпределения);
		ЗначениеОтбора = СтрокаОтбора.УточнениеСпособаОпределения;
	КонецЕсли;
		
	НОтбор = ДобавитьПараметрВПакет(тПараметрыПакета, Отбор, ЗначениеОтбора, СтрокаОтбора.ПолеБД, Истина);
	
	Если Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.СценарийОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.СценарийФакта
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ПроектОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ВалютаОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Булево
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Строка
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Число
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Дата
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаВышестоящегоПериода
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаВышестоящегоПериода
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом		
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика1
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика2
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика3
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика4
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика5
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Аналитика6
		Тогда
		
		Возврат ИмяПоля + " = &" + НОтбор.ИмяОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению Тогда
		
		Возврат ИмяПоля + " <> &" + НОтбор.ИмяОтбора;											 
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ПериметрОтчета 
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета 
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ВышестоящийПериод
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодПредыдущегоГода
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодГодаСоСдвигом
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчетаСоСдвигом
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений
		Тогда
		
		Возврат ИмяПоля + " В (&" + НОтбор.ИмяОтбора + ")";
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений 
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеПериметрОтчета
		Или Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеПериодОтчета Тогда
		
		Возврат ИмяПоля + " НЕ В (&" + НОтбор.ИмяОтбора + ")";
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии Тогда
		
		Возврат ИмяПоля + " В ИЕРАРХИИ(&" + НОтбор.ИмяОтбора + ")";
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии Тогда
		
		Возврат ИмяПоля + " НЕ В ИЕРАРХИИ(&" + НОтбор.ИмяОтбора + ")";
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Больше Тогда
		
		Возврат ИмяПоля + " > &" + НОтбор.ИмяОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.БольшеИлиРавно Тогда
		
		Возврат ИмяПоля + " >= &" + НОтбор.ИмяОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.Меньше Тогда
		
		Возврат ИмяПоля + " < &" + НОтбор.ИмяОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.МеньшеИлиРавно Тогда
		
		Возврат ИмяПоля + " <= &" + НОтбор.ИмяОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.ТипЗначения Тогда
		
		Возврат ИмяПоля + " ССЫЛКА " + ЗначениеОтбора;
		
	ИначеЕсли Отбор = Перечисления.СпособыВычисленияПараметровОперандов.СписокТиповЗначений Тогда
		
		ТекстУсловия = "";			
		Для Каждого ТипЗначения Из ЗначениеОтбора Цикл			
			ТекстУсловия = ТекстУсловия + СтрЗаменить(ИмяПоля, " И ", " ИЛИ ") + " ССЫЛКА " + ТипЗначения.Значение;			
		КонецЦикла;
		Возврат "И (" + Сред(ТекстУсловия, СтрДлина(" ИЛИ ")) + ")";	
		
	Иначе
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Тип отборов %1 в настоящий момент не поддерживается.'"), Отбор);
		ВызватьИсключение(ТекстОшибки);
		
	КонецЕсли;
	
КонецФункции

Функция ДобавитьПараметрВПакет(тПараметрыПакета, ТипОтбора, ЗначениеОтбора=Неопределено, ПолеБД = "Параметр", Отбор = Ложь)
	
	УИДГруппыОтбора = ЗначениеВСтрокуВнутр(ТипОтбора) + "#" + ЗначениеВСтрокуВнутр(ЗначениеОтбора) + "#" + ЗначениеВСтрокуВнутр(Отбор);
		
	НСтрока = тПараметрыПакета.Найти(УИДГруппыОтбора,"УИДГруппыОтбора");
	Если НСтрока = Неопределено Тогда
		НСтрока = тПараметрыПакета.Добавить();
		НСтрока.ИмяОтбора = СтрЗаменить(ПолеБД,".","") + ?(ЗначениеОтбора=Неопределено И НЕ Отбор,"","_" + СтрЗаменить(Новый УникальныйИдентификатор,"-",""));
		НСтрока.ТипОтбора = ТипОтбора;
		НСтрока.ЗначениеОтбора = ЗначениеОтбора;
		НСтрока.УИДГруппыОтбора = УИДГруппыОтбора;
	КонецЕсли;
	
	Возврат НСтрока;
	
КонецФункции

Функция ТекстПолейАналитик(тИспользуемыеАналитики,УровеньРасчета,Режим = 1,ТрансформацияПолей=Ложь)

	// Режим:
	//	0 - Для запроса по версиям
	//	1 - Для запроса по таблицам
	//	2 - Для трансформации полей
	//	3 - Для группировки
	//	4 - Для соединения
	ТекстДополнительныхПолей = "";

	Если Режим = 0 Тогда
		тПоляУровня = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета,ПолеВерсии",УровеньРасчета,Истина));
	Иначе
		тПоляУровня = тИспользуемыеАналитики.НайтиСтроки(Новый Структура("УровеньРасчета",УровеньРасчета));
	КонецЕсли;
	
	Для Каждого СтрПоле Из тПоляУровня Цикл
		
		Если СтрПоле.Поле = "ПериодОтчета" Тогда
			Продолжить;
	
		ИначеЕсли Режим = 4 Тогда
			
			ТекстДополнительныхПолей = ТекстДополнительныхПолей + "
			|	И #ИмяТаблицы." + СтрПоле.Поле + " = #ИмяТаблицыСоединение." + СтрПоле.Поле;
			
		Иначе
			
			Если ТрансформацияПолей Тогда
				// Построение текста по аналитикам происходит в самой процедуре
				Если СтрНачинаетсяС(СтрПоле.Поле, "Аналитика") Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		
			ТекстДополнительныхПолей = ТекстДополнительныхПолей + ",
				|	#ИмяТаблицы." + СтрПоле.Поле;
		
			Если Режим <> 3 Тогда
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + " КАК " + СтрЗаменить(СтрПоле.Поле,".","");
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТекстДополнительныхПолей;
	
КонецФункции

Функция ТекстПолейРесурсов(тИспользуемыеРесурсы,УровеньРасчета,Режим = 1)

	// Режим:
	//	1 - Для запроса по таблицам
	//	2 - Для трансформации полей
	//	3 - Для группировки
	//	4 - Для отбора
	ТекстДополнительныхПолей = "";

	тПоляУровня = тИспользуемыеРесурсы.НайтиСтроки(Новый Структура("УровеньРасчета",УровеньРасчета));
	
	Для Каждого СтрПоле Из тПоляУровня Цикл
		
		Если Режим = 4 Тогда
			Если СтрПоле.Суммируется Тогда
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + "
				|
				|ИМЕЮЩИЕ
				|	СУММА(#ИмяТаблицы." + СтрПоле.Поле + ") <> 0";
			Иначе
				// Есть нечисловые показатели, не будем фильтровать
				Возврат "";
			КонецЕсли;
		ИначеЕсли Режим = 2 Тогда 
			Если СтрПоле.Суммируется Тогда
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + ",
					|	СУММА(#ИмяТаблицы." + СтрПоле.Поле + ")";
			Иначе
				ТекстДополнительныхПолей = ТекстДополнительныхПолей + ",
					|	МАКСИМУМ(#ИмяТаблицы." + СтрПоле.Поле + ")";
			КонецЕсли;
		ИначеЕсли Режим = 3 Тогда
			Продолжить;
		Иначе
			ТекстДополнительныхПолей = ТекстДополнительныхПолей + ",
				|	#ИмяТаблицы." + СтрПоле.Поле;
		КонецЕсли;
		
		Если Режим < 3 Тогда
			ТекстДополнительныхПолей = ТекстДополнительныхПолей + " КАК " + СтрПоле.Поле;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстДополнительныхПолей;
	
КонецФункции

Функция ОписаниеТаблицыПараметров()
	
	тПараметрыПакета = Новый ТаблицаЗначений;
	тПараметрыПакета.Колонки.Добавить("ИмяОтбора");
	тПараметрыПакета.Колонки.Добавить("ТипОтбора");
	тПараметрыПакета.Колонки.Добавить("ЗначениеОтбора");
	тПараметрыПакета.Колонки.Добавить("УИДГруппыОтбора");
	
	Возврат тПараметрыПакета;
	
КонецФункции

Функция ТекстПроцедурыДляЯзыкаЗапросов(Знач ТекстПроцедуры, ИмяТаблицы)
	
	// Уберем все пробелы из строки формулы
	Пока СтрНайти(ТекстПроцедуры," ") > 0 Цикл
		ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры, " ", "");
	КонецЦикла;
	
	// Проверим и обработаем условные операторы
	Пока СтрНайти(ТекстПроцедуры,"?") > 0 Цикл
		ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры);
	КонецЦикла;
	
	// Заменим фигурные скобки на идентификатор временной таблицы
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"[",ИмяТаблицы + "._");
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"]",""); 
	
	Возврат ТекстПроцедуры;
	
КонецФункции

Процедура ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры,нсТекущий = 1,Знач Отступ = "")
	
	нсВопрос			= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
	нсОткрытаяСкобка	= СтрНайти(ТекстПроцедуры,"(",,нсВопрос);
	нсТекущий			= нсОткрытаяСкобка + 1;
	ТекстПроцедуры		= Лев(ТекстПроцедуры,нсВопрос-1) + ?(нсВопрос=1,"",Символы.ПС) + Отступ
		+ "ВЫБОР" // @query-part
		+ " " + Символы.ПС + Отступ + Символы.Таб + "КОГДА " + Сред(ТекстПроцедуры,нсТекущий);
	
	// Секция "ВЫБОР КОГДА"
	нсВопрос	= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
	нсЗапятая	= СтрНайти(ТекстПроцедуры,",",,нсТекущий);		
	
	Пока нсВопрос > 0 И нсВопрос < нсЗапятая Цикл
		// Далее идет вложенный оператор
		ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры,нсТекущий,Отступ + Символы.Таб + Символы.Таб);
		нсВопрос	= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
		нсЗапятая	= СтрНайти(ТекстПроцедуры,",",,нсТекущий);
	КонецЦикла;
	
	Если нсЗапятая > 0 Тогда
		нсТекущий		= нсЗапятая + 1;
		ТекстПроцедуры	= Лев(ТекстПроцедуры,нсЗапятая-1) + " ТОГДА " + Сред(ТекстПроцедуры,нсТекущий);
	КонецЕсли;
	
	// Секция "ТОГДА"
	нсВопрос		= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
	нсЗапятая		= СтрНайти(ТекстПроцедуры,",",,нсТекущий);		
	
	Пока нсВопрос > 0 И нсВопрос < нсЗапятая Цикл
		// Далее идет вложенный оператор
		ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры,нсТекущий,Отступ + Символы.Таб + Символы.Таб);
		нсВопрос	= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
		нсЗапятая	= СтрНайти(ТекстПроцедуры,",",,нсТекущий);
	КонецЦикла;
	
	Если нсЗапятая > 0 Тогда
		нсТекущий		= нсЗапятая + 1;
		ТекстПроцедуры	= Лев(ТекстПроцедуры,нсЗапятая-1) + Символы.ПС + Отступ + Символы.Таб + "ИНАЧЕ " + Сред(ТекстПроцедуры,нсТекущий);
	КонецЕсли;
	
	// Секция "КОНЕЦ"
	счСкобок = 0;
	Пока Истина Цикл
		нсВопрос			= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
		нсОткрытаяСкобка	= СтрНайти(ТекстПроцедуры,"(",,нсТекущий);
		нсЗакрытаяСкобка	= СтрНайти(ТекстПроцедуры,")",,нсТекущий);
		Если нсВопрос > 0 И нсВопрос < нсЗакрытаяСкобка Тогда
			// Далее идет вложенный оператор
			ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры,нсТекущий,Отступ + Символы.Таб + Символы.Таб);
			нсВопрос			= СтрНайти(ТекстПроцедуры,"?",,нсТекущий);
			нсОткрытаяСкобка	= СтрНайти(ТекстПроцедуры,"(",,нсТекущий);
			нсЗакрытаяСкобка	= СтрНайти(ТекстПроцедуры,")",,нсТекущий);
		КонецЕсли;	
		Если нсОткрытаяСкобка > 0 И нсОткрытаяСкобка < нсЗакрытаяСкобка Тогда
			// Далее идут вложенные скобки
			счСкобок	= счСкобок + 1;
			нсТекущий	= нсОткрытаяСкобка+1;
		ИначеЕсли счСкобок > 0 Тогда
			// Пропустим все закрывающие вложенные скобки
			счСкобок	= счСкобок - 1;
			нсТекущий	= нсЗакрытаяСкобка + 1;
		Иначе
			// Нашли "лишнюю" закрывающую скобку
			Прервать;
		КонецЕсли;
		Если нсТекущий > СтрДлина(ТекстПроцедуры) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	нсТекущий		= нсЗакрытаяСкобка + 1;
	ТекстПроцедуры	= Лев(ТекстПроцедуры,нсЗакрытаяСкобка-1) + Символы.ПС + Отступ + "КОНЕЦ " + Сред(ТекстПроцедуры,нсТекущий);

	Если нсВопрос > 0 И нсВопрос < нсЗакрытаяСкобка Тогда
		// Есть еще вложенные операторы
		ОбработатьУсловныеОператорыРекурсивно(ТекстПроцедуры,нсТекущий);	
	КонецЕсли;
	
КонецПроцедуры

Функция ИтоговыйТекстПодзапросовВТ(мПодзапросыДанных)
	
	Если мПодзапросыДанных.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
		
	Возврат СтрСоединить(мПодзапросыДанных, ОбщегоНазначения.РазделительПакетаЗапросов())
		+ ОбщегоНазначения.РазделительПакетаЗапросов();
	
КонецФункции
	
Функция ИтоговыйТекстПодзапросов(мПодзапросыДанных, ИмяВременнойТаблицы=Неопределено)
	
	ТекстЗапроса = "";
	Если мПодзапросыДанных.Количество() = 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяВременнойТаблицы) Тогда
		
		// Результат объединения необходимо поместить во временную таблицу
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(мПодзапросыДанных.Получить(0));
		СхемаЗапроса.ПакетЗапросов.Получить(0).ТаблицаДляПомещения = ИмяВременнойТаблицы;
		мПодзапросыДанных.Установить(0, СхемаЗапроса.ПолучитьТекстЗапроса());
		
	КонецЕсли;
	
	Возврат ТекстЗапроса + СтрСоединить(мПодзапросыДанных, Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
КонецФункции

Процедура ДобавитьЗапросВТаблицуПересчетаПоказателей(мПодзапросыДанных, тПараметрыПакета, ИмяВременнойТаблицы,
	глТаблицаПересчетаПоказателей, ВидОперацииРасчета, КомментарийКПакету, ВыгружатьРезультатВТаблицу = Ложь, УровеньРекурсии = 0)
	
	МаксОбъединенийВЗапросе = 200;
	ЧислоЭлементовЗапроса = мПодзапросыДанных.Количество();
	
	Если ЧислоЭлементовЗапроса <= МаксОбъединенийВЗапросе Тогда
		// Все подзапросы помещаются в один запрос
		нСтрокаТаблицыЗапросов = глТаблицаПересчетаПоказателей.Добавить();
		нСтрокаТаблицыЗапросов.тПараметрыПакета = тПараметрыПакета;
		нСтрокаТаблицыЗапросов.ВидОперацииРасчета = ВидОперацииРасчета;
		нСтрокаТаблицыЗапросов.КомментарийКПакету = КомментарийКПакету;
		нСтрокаТаблицыЗапросов.ВыгружатьРезультатВТаблицу = ВыгружатьРезультатВТаблицу;
		нСтрокаТаблицыЗапросов.ТекстПодзапросов = ИтоговыйТекстПодзапросов(мПодзапросыДанных, ИмяВременнойТаблицы);
		Возврат;
	КонецЕсли;
	
	// Сформируем шаблон итогового запроса
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(мПодзапросыДанных.Получить(0));
	ШаблонИтоговогоЗапроса = "ВЫБРАТЬ";
	Для Каждого КолонкаЗапроса Из СхемаЗапроса.ПакетЗапросов.Получить(0).Колонки Цикл
		ШаблонИтоговогоЗапроса = ШаблонИтоговогоЗапроса + Символы.ПС + Символы.Таб +
			"ТаблицаДанных." + КолонкаЗапроса.Псевдоним + " КАК " + КолонкаЗапроса.Псевдоним + ",";
	КонецЦикла;
	ШаблонИтоговогоЗапроса = Лев(ШаблонИтоговогоЗапроса, СтрДлина(ШаблонИтоговогоЗапроса)-1) + Символы.ПС + "ИЗ #ИмяТаблицы КАК ТаблицаДанных";
	
	// Разбиваем подзапросы на пачки, помещаем их во временные таблицы
	мПодзапросыНовые = Новый Массив;
	мПодзапросыИтоговые = Новый Массив;
	тПараметрыПакетаНовые = ОписаниеТаблицыПараметров();
	Для НомерЗапроса = 1 По ЧислоЭлементовЗапроса Цикл
		
		ТекстЗапроса = мПодзапросыДанных.Получить(НомерЗапроса-1);
		мПодзапросыНовые.Добавить(ТекстЗапроса);
		
		Если НомерЗапроса % МаксОбъединенийВЗапросе = 0
			ИЛИ НомерЗапроса = ЧислоЭлементовЗапроса Тогда
			
			НомерЗапросаСтрока = Формат(НомерЗапроса,"ЧГ=0");
			ИмяВременнойТаблицыНовое = ИмяВременнойТаблицы + "_Запросы_" + Формат(УровеньРекурсии,"ЧН=0; ЧГ=0") + "_" + НомерЗапросаСтрока;
			
			ДобавитьЗапросВТаблицуПересчетаПоказателей(мПодзапросыНовые, тПараметрыПакета, ИмяВременнойТаблицыНовое,
				глТаблицаПересчетаПоказателей, ВидОперацииРасчета, КомментарийКПакету + ", ЗАПРОСЫ - " + НомерЗапросаСтрока);
			
			мПодзапросыИтоговые.Добавить(СтрЗаменить(ШаблонИтоговогоЗапроса, "#ИмяТаблицы", ИмяВременнойТаблицыНовое));
			
			мПодзапросыНовые.Очистить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьЗапросВТаблицуПересчетаПоказателей(мПодзапросыИтоговые, тПараметрыПакетаНовые, ИмяВременнойТаблицы,
		глТаблицаПересчетаПоказателей, ВидОперацииРасчета, КомментарийКПакету, ВыгружатьРезультатВТаблицу, УровеньРекурсии + 1);
	
КонецПроцедуры

Процедура ПереопределитьТипОтбора(ПолеБД, ТипОтбора)
	
	Если ПолеБД = "КоррСчетОборот" Тогда
		
		Если ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение
			ИЛИ ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений
			ИЛИ ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеЗначение
			ИЛИ ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыкеСписокЗначений Тогда
			
			ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.СписокПоИерархии;
			
		ИначеЕсли ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.НеРавноФиксированномуЗначению
			ИЛИ ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеФиксированныхЗначений Тогда
			
			ТипОтбора = Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереопределитьЗначениеОтбора(ПолеБД, ЗначениеОтбора)
	
	Если ПолеБД = "КоррСчетОборот" Тогда
		
		Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
			
			КоррСчет = Новый Массив;
			Для Каждого Элемент Из ЗначениеОтбора Цикл
				КоррСчет.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.Значение, "СчетСсылка"));
			КонецЦикла;
			
		Иначе
			
			КоррСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеОтбора, "СчетСсылка");
			
		КонецЕсли;
		
		ЗначениеОтбора = КоррСчет;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьПромежуточнымиРезультатамиРасчета(СтруктураВозврата)
	
	ТрансформацияОперандов = Перечисления.ВидыОперацийРасчетаПоказателей.ТрансформацияОперандов;
	СтрокаРасчета = ОбъектРасчета.тТрассировкаРасчета.Найти(ТрансформацияОперандов, "ВидОперацииРасчета");
	Если СтрокаРасчета <> Неопределено Тогда
		СтруктураВозврата.Вставить("тОперанды", СтрокаРасчета.тРезультатВыполненияЗапроса);
	КонецЕсли;
	
	Если ОбъектРасчета.ЕстьАналитикаВалюта Тогда
		ДополнитьДетализациейВалютногоРаскрытия(СтруктураВозврата);
	КонецЕсли;
	
	Если ОбъектРасчета.ПересчетВДопВалюты Тогда
		ОбработатьВалютныеЗначения(СтруктураВозврата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьДетализациейВалютногоРаскрытия(СтруктураВозврата)
	
	РасчетВыраженийОперандов = Перечисления.ВидыОперацийРасчетаПоказателей.РасчетВыраженийОперандов;
	СтрокаРасчета = ОбъектРасчета.тТрассировкаРасчета.Найти(РасчетВыраженийОперандов, "ВидОперацииРасчета");
	Если СтрокаРасчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаРасчета.тРезультатВыполненияЗапроса) Тогда
		СтруктураВозврата.Вставить("рОперанды", СтрокаРасчета.тРезультатВыполненияЗапроса)
	Иначе
		СтруктураВозврата.Вставить("рОперанды", СтруктураВозврата.тОперанды);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьВалютныеЗначения(СтруктураВозврата)
	
	Отбор = Новый Структура("Валюта", ОбъектРасчета.ВалютаОтображения);
	СтруктураВозврата.ЗначенияПоказателей = СтруктураВозврата.ЗначенияПоказателей.Скопировать(Отбор);
	
	ЗаписьВЛогСДопВалютами = Перечисления.ВидыОперацийРасчетаПоказателей.ЗаписьВЛогИзмененныхПоказателейСДопВалютами;
	СтрокаРасчета = ОбъектРасчета.тТрассировкаРасчета.Найти(ЗаписьВЛогСДопВалютами, "ВидОперацииРасчета");
	Если СтрокаРасчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтрокаРасчета.РезультатыВыполненияЗапроса.Свойство("Т5") Тогда
		Возврат; // Не найдена таблица коэффициентов пересчета
	КонецЕсли;
	
	КоэффициентыПересчета = СтрокаРасчета.РезультатыВыполненияЗапроса.Т5;
	СтрокаПересчета = КоэффициентыПересчета.Найти(ОбъектРасчета.ВалютаОтображения, "Валюта");
	Если СтрокаПересчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Точность = 5;
	ИменаТаблиц = ИменаТаблицДетализации(СтруктураВозврата);
	ПересчитатьЗначенияПоКоэффициенту(СтруктураВозврата, ИменаТаблиц, СтрокаПересчета.КоэффициентПересчета, Точность);
	РаспределитьВалютнуюПоправку(СтруктураВозврата, ИменаТаблиц, Точность);
	
КонецПроцедуры

Функция ИменаТаблицДетализации(СтруктураВозврата)
	
	ИменаТаблиц = Новый Массив;
	
	Если СтруктураВозврата.Свойство("тОперанды") Тогда
		ИменаТаблиц.Добавить("тОперанды");
	КонецЕсли;
	
	Если СтруктураВозврата.Свойство("рОперанды") Тогда
		ИменаТаблиц.Добавить("рОперанды");
	КонецЕсли;
	
	Возврат ИменаТаблиц;
	
КонецФункции

Процедура ПересчитатьЗначенияПоКоэффициенту(СтруктураВозврата, ИменаТаблиц, КоэффициентПересчета, Знач Точность)
	
	ДелительПересчета = 1000000;
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		
		Для Каждого Строка Из СтруктураВозврата[ИмяТаблицы] Цикл
			
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Показатель, "НеФинансовый") Тогда
				Продолжить;
			КонецЕсли;
			
			Строка.Значение = Окр(Строка.Значение * КоэффициентПересчета / ДелительПересчета, Точность);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьВалютнуюПоправку(СтруктураВозврата, ИменаТаблиц, Знач Точность)
	
	Если НЕ ОбъектРасчета.Свойство("РасчетныеВалютныеПоказатели") Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураВозврата.ЗначенияПоказателей.Количество() <= 1 Тогда
		Возврат; // Нет поправки для распределения
	КонецЕсли;
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		
		Если СтруктураВозврата[ИмяТаблицы].Количество() = 1 Тогда
			
			// Получаем сумму поправки из второй строки (первая - основная валюта)
			СуммаВалютнойПоправки = СтруктураВозврата.ЗначенияПоказателей[1].Значение;
			
			Строка = СтруктураВозврата[ИмяТаблицы][0];
			Строка.Значение = Строка.Значение + СуммаВалютнойПоправки;
			Продолжить;
			
		Иначе
			
			Отбор = Новый Структура;
			Для Каждого Колонка Из СтруктураВозврата[ИмяТаблицы].Колонки Цикл
				Если Колонка.Имя = "Значение" ИЛИ Колонка.Имя = "Показатель" ИЛИ Колонка.Имя = "КодВФормуле" Тогда
					Продолжить;
				КонецЕсли;
				Отбор.Вставить(Колонка.Имя);
			КонецЦикла;
			
			Для Каждого Строка Из СтруктураВозврата[ИмяТаблицы] Цикл
				ЗаполнитьЗначенияСвойств(Отбор, Строка);
				СтрокиСПоправкой = СтруктураВозврата.ЗначенияПоказателей.НайтиСтроки(Отбор);
				Для Каждого нСтроки Из СтрокиСПоправкой Цикл
					Если нСтроки.Значение = Строка.Значение Тогда
						Продолжить;
					КонецЕсли;
					Строка.Значение = Строка.Значение + нСтроки.Значение;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

