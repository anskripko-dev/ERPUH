Процедура ДобавитьДополнительныеАналитики(ТекстЗапроса, Условия)
	
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	Пакет1 = СхемаЗапроса.ПакетЗапросов[0];
	Если НЕ Условия.ЕстьКомментарии Тогда
		Пакет1.Операторы.Удалить(2);
	КонецЕсли;
	Если НЕ Условия.ЕстьНечисловые Тогда
		Пакет1.Операторы.Удалить(1);
	КонецЕсли;
	
	Пакет2 = СхемаЗапроса.ПакетЗапросов[1];
	Пакет3 = СхемаЗапроса.ПакетЗапросов[2];
	Пакет4 = СхемаЗапроса.ПакетЗапросов[3];
	Пакет5 = СхемаЗапроса.ПакетЗапросов[4];
	Пакет8 = СхемаЗапроса.ПакетЗапросов[7];
	Пакет9 = СхемаЗапроса.ПакетЗапросов[8];
	Пакет10 = СхемаЗапроса.ПакетЗапросов[9];
	
	ШаблонСвязиЭкземпляр = "ДанныеДляПроверки.%1 = СтатусыКлючевыхСрезов.%1";
	ШаблонСвязиРакурс = "ДанныеДляПроверки.%1 = СтатусыПоказателейСинтетика.%1";
	Если Условия.РазделениеПоПроектам Тогда
		Пакет4Соединения0 = Пакет4.Операторы[0].Источники[0].Соединения;
		Пакет4Соединения0.Добавить("СтатусыКлючевыхСрезов", СтрШаблон(ШаблонСвязиЭкземпляр, "Проект"));
		Пакет4Соединения1 = Пакет4.Операторы[1].Источники[0].Соединения;
		Пакет4Соединения1.Добавить("СтатусыПоказателейСинтетика", СтрШаблон(ШаблонСвязиРакурс, "Проект"));
	КонецЕсли;
	
	ШаблонПоляВыбора =
	"ВЫБОР
	|	КОГДА ДанныеВидовОтчетов.МаксАналитикОтчета > %1
	|		ТОГДА ЗначенияПоказателей.%2
	|	ИНАЧЕ НЕОПРЕДЕЛЕНО
	|КОНЕЦ";
	
	Для Номер = 1 По Условия.МаксАналитикОтчета Цикл
		
		АналитикаН = "Аналитика" + Номер;
		
		Для Каждого Оператор Из Пакет1.Операторы Цикл
			
			ЗначенияПоказателей = Оператор.Источники.НайтиПоПсевдониму("ЗначенияПоказателей");
			ЗначенияПоказателей.Источник.ДоступныеПоля.Добавить(АналитикаН);
			Оператор.ВыбираемыеПоля.Добавить(СтрШаблон(ШаблонПоляВыбора, Номер - 1, АналитикаН));
			
		КонецЦикла;
		Пакет1.Колонки[Пакет1.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет2.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет2.Колонки[Пакет2.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет3.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет3.Колонки[Пакет3.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет4.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет4.Колонки[Пакет4.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		Пакет4Соединения0 = Пакет4.Операторы[0].Источники[0].Соединения;
		Пакет4Соединения0.Добавить("СтатусыКлючевыхСрезов", СтрШаблон(ШаблонСвязиЭкземпляр, АналитикаН));
		
		Пакет4.Операторы[1].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет4Соединения1 = Пакет4.Операторы[1].Источники[0].Соединения;
		Пакет4Соединения1.Добавить("СтатусыПоказателейСинтетика", СтрШаблон(ШаблонСвязиРакурс, АналитикаН));
		
		Пакет5.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет5.Колонки[Пакет5.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет8.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет8.Колонки[Пакет8.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет9.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет9.Колонки[Пакет9.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
		Пакет10.Операторы[0].ВыбираемыеПоля.Добавить("ДанныеДляПроверки." + АналитикаН);
		Пакет10.Колонки[Пакет10.Колонки.Количество() - 1].Псевдоним = АналитикаН;
		
	КонецЦикла;
	
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецПроцедуры

Функция ТекстЗапросаВТ_ДоступныеДляЗаписиПоказатели(УсловиеПоАналитикам)
	
	ТекстЗапроса =
	"УНИЧТОЖИТЬ втПоказателиПравилаОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втПравилаОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втДанныеВидовОтчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДляПроверки.Показатель КАК Показатель,
	|	ДанныеДляПроверки.ПравилоОбработки КАК ПравилоОбработки
	|ПОМЕСТИТЬ втПоказателиПравилаОбработки
	|ИЗ
	|	втДанныеДляПроверки КАК ДанныеДляПроверки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеДляПроверки.ПравилоОбработки КАК ПравилоОбработки,
	|	ДанныеДляПроверки.ВидОтчета КАК ВидОтчета,
	|	ДанныеДляПроверки.РазделениеПоПроектам КАК РазделениеПоПроектам,
	|	ДанныеДляПроверки.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
	|	ДанныеДляПроверки.МаксАналитикОтчета КАК МаксАналитикОтчета
	|ПОМЕСТИТЬ втДанныеВидовОтчетов
	|ИЗ
	|	втДанныеДляПроверки КАК ДанныеДляПроверки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции,
	|	ЗначенияПоказателей.ПравилоОбработки КАК ПравилоОбработки,
	|	ЗначенияПоказателей.Показатель КАК Показатель,
	|	ЗначенияПоказателей.Сценарий КАК Сценарий,
	|	ЗначенияПоказателей.Организация КАК Организация,
	|	ЗначенияПоказателей.Проект КАК Проект,
	|	ЗначенияПоказателей.СпособФормированияОтчета КАК СпособФормированияОтчета,
	|	ЗначенияПоказателей.ИспользуемаяИБ КАК ИспользуемаяИБ,
	|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
	|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
	|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
	|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
	|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
	|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
	|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
	|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияПоказателей.Валюта КАК Валюта,
	|	ЗначенияПоказателей.Значение КАК Значение,
	|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта
	|ПОМЕСТИТЬ втЛогИзмененныхПоказателейФильтрПоСтатусам
	|ИЗ
	|	втЛогИзмененныхПоказателей КАК ЗначенияПоказателей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДляПроверки КАК ДанныеДляПроверки
	|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеДляПроверки.ПравилоОбработки
	|			И ЗначенияПоказателей.Показатель = ДанныеДляПроверки.Показатель
	|			И ЗначенияПоказателей.Сценарий = ДанныеДляПроверки.Сценарий
	|			И ЗначенияПоказателей.Организация = ДанныеДляПроверки.Организация
	|			И ЗначенияПоказателей.Проект = ДанныеДляПроверки.Проект
	|			И ЗначенияПоказателей.ПериодОтчета = ДанныеДляПроверки.ПериодОтчета"+УсловиеПоАналитикам;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВТ_ДоступныеДляЗаписиНечисловыеПоказатели(УсловиеПоАналитикам)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции,
	|	ЗначенияПоказателей.ПравилоОбработки КАК ПравилоОбработки,
	|	ЗначенияПоказателей.Показатель КАК Показатель,
	|	ЗначенияПоказателей.Сценарий КАК Сценарий,
	|	ЗначенияПоказателей.Организация КАК Организация,
	|	ЗначенияПоказателей.Проект КАК Проект,
	|	ЗначенияПоказателей.СпособФормированияОтчета КАК СпособФормированияОтчета,
	|	ЗначенияПоказателей.ИспользуемаяИБ КАК ИспользуемаяИБ,
	|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
	|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
	|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
	|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
	|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
	|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
	|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
	|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияПоказателей.Валюта КАК Валюта,
	|	ЗначенияПоказателей.Значение КАК Значение
	|ПОМЕСТИТЬ втЛогИзмененныхПоказателейНечисловыеИтогФильтрПоСтатусам
	|ИЗ
	|	втЛогИзмененныхПоказателейНечисловыеИтог КАК ЗначенияПоказателей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДляПроверки КАК ДанныеДляПроверки
	|		ПО ЗначенияПоказателей.ПравилоОбработки = ДанныеДляПроверки.ПравилоОбработки
	|			И ЗначенияПоказателей.Показатель = ДанныеДляПроверки.Показатель
	|			И ЗначенияПоказателей.Сценарий = ДанныеДляПроверки.Сценарий
	|			И ЗначенияПоказателей.Организация = ДанныеДляПроверки.Организация
	|			И ЗначенияПоказателей.Проект = ДанныеДляПроверки.Проект
	|			И ЗначенияПоказателей.ПериодОтчета = ДанныеДляПроверки.ПериодОтчета"+УсловиеПоАналитикам;
	
	Возврат ТекстЗапроса;
	
КонецФункции

