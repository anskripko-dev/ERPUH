КонецФункции

// Добавляет значения измененных показатели в лог измененных показателей
//
// Параметры:
//	мОбъектРасчета				- Структура - Структура с данными для расчета показателей
//	НомерТранзакции				- Число - Номер транзакции для добавления записей в лог измененных показателей
//	АбсолютныеЗначения			- Булево - Признак того, что в записываются абсолютные значения показателей (не дельты)
//	ЗаписыватьДанныеВРегистры	- Булево - Признак, что необходимо записать в регистры значения рассчитанных показателей
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ДобавитьЗначенияПоказателейВЛог(мОбъектРасчета, НомерТранзакции = 0, АбсолютныеЗначения = Ложь, ЗаписыватьДанныеВРегистры = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
	
	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НомерТранзакции", НомерТранзакции);
	ПараметрыРасчета.Вставить("АбсолютныеЗначения", АбсолютныеЗначения);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", ЗаписыватьДанныеВРегистры);
	
	// Выполним расчет
	Результат = ВыполнитьДобавлениеЗначенийИзмененныхПоказателиВЛог(мОбъектРасчета, ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов();
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Обрабатывает ситуацию когда поменялся ключевой срез для имеющихся значений показателей
//
// Параметры:
//	мОбъектРасчета				- Структура - Структура с данными для расчета показателей
//	Источник					- Число - Ссылка на документ с предыдущими ключевыми срезами
//	НомерТранзакции				- Число - Номер транзакции для добавления записей в лог измененных показателей
//	ЗаписыватьДанныеВРегистры	- Булево - Признак, что необходимо записать в регистры значения рассчитанных показателей
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ОбработатьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов(мОбъектРасчета, Источник, НомерТранзакции = 0, ЗаписыватьДанныеВРегистры = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
		
	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Источник", Источник);
	ПараметрыРасчета.Вставить("НомерТранзакции", НомерТранзакции);
	ПараметрыРасчета.Вставить("АбсолютныеЗначения", Истина);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", ЗаписыватьДанныеВРегистры);
	
	// Выполним расчет
	Результат = ВыполнитьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов(мОбъектРасчета, ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов();
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Записывает лог измененных показателей
//
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ЗаписатьЛогИзмененныхПоказателей() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
	
	// Выполним запись
	Результат = ВыполнитьЗаписьЛогаИзмененныхПоказателей();
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("ЗаписатьЛогИзмененныхПоказателей");
	ОбщееВремяЗаписиВерсий = ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Инициализирует структуру, с необходимыми полями для расчета
// 
// Возвращаемое значение:
//	Структура - Структура для расчета показателей, заполнена пустыми значениями
//
Функция ИнициализироватьОбъектРасчета() Экспорт
	
	// Основные реквизиты, необходимые для расчета
	ОбъектРасчета = Новый Структура;
	
	// Обязательные реквизиты - должны быть заполнены всегда
	ОбъектРасчета.Вставить("ВидОтчета",Справочники.ВидыОтчетов.ПустаяСсылка());
	ОбъектРасчета.Вставить("ПериодОтчета",Справочники.Периоды.ПустаяСсылка());
	ОбъектРасчета.Вставить("ПериодОкончания",Справочники.Периоды.ПустаяСсылка()); 
	ОбъектРасчета.Вставить("Сценарий",Справочники.Сценарии.ПустаяСсылка());
	ОбъектРасчета.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
	
	// Опциональные реквизиты - обязательные для конкретных видов отчетов
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ОбъектРасчета.Вставить("Аналитика" + Сч,Неопределено);
	КонецЦикла;	
	ОбъектРасчета.Вставить("Проект",Справочники.Проекты.ПустаяСсылка());
	
	// Для работы с внешними источниками
	ОбъектРасчета.Вставить("ИспользуемаяИБ", Неопределено);
	ОбъектРасчета.Вставить("БланкДляИмпорта", Неопределено);
	ОбъектРасчета.Вставить("ПутьКФайлуADO", "");
	ОбъектРасчета.Вставить("СтрокаСоединения", "");
	ОбъектРасчета.Вставить("ФайлИмпорта", "");
	ОбъектРасчета.Вставить("ВерсияХранимогоФайла", "");
	ОбъектРасчета.Вставить("ФлагОшибкиИмпорта", Ложь);
	ОбъектРасчета.Вставить("ДополнительныеСвойства", Новый Структура);
	
	// Необязательные реквизиты - рассчитываются исходя из обязательных реквизитов
	ОбъектРасчета.Вставить("УправлениеПериодом", Документы.УправлениеПериодомСценария.ПустаяСсылка());
	ОбъектРасчета.Вставить("ВерсияРегламента", Справочники.ВерсииРегламентовПодготовкиОтчетности.ПустаяСсылка());
	ОбъектРасчета.Вставить("СпособФормированияОтчета", Неопределено);
	ОбъектРасчета.Вставить("УточнениеСпособаФормированияОтчета", Неопределено);
	ОбъектРасчета.Вставить("ПравилоОбработки", Справочники.ПравилаОбработки.ПустаяСсылка());
	ОбъектРасчета.Вставить("ПериодичностьСвертывания", Перечисления.Периодичность.ПустаяСсылка());
	ОбъектРасчета.Вставить("ОсновнаяВалюта", Справочники.Валюты.ПустаяСсылка());
	ОбъектРасчета.Вставить("ДополнительныеВалюты", Новый Массив);
	ОбъектРасчета.Вставить("ЗаполнятьПустыеАналитики", Неопределено); 
	
	// Необязательные реквизиты
	ОбъектРасчета.Вставить("Регистратор",Неопределено);
	ОбъектРасчета.Вставить("ИдентификаторСеанса","");
	
	// Данные для пересчета зависимых показателей
	ОбъектРасчета.Вставить("тИзмененныеПоказатели",Неопределено);
	ОбъектРасчета.Вставить("тЦелевыеПоказатели",Неопределено);
	ОбъектРасчета.Вставить("ВалютаИзмененныхПоказателей", Неопределено);
	
	// Служебные реквизиты - рассчитываются перед началом расчета
	ОбъектРасчета.Вставить("МаксАналитикОтчета", 0);
	ОбъектРасчета.Вставить("МаксАналитикПоказателя", 0);
	ОбъектРасчета.Вставить("МассивПериодов", Новый Массив);
	ОбъектРасчета.Вставить("Периодичность", Перечисления.Периодичность.ПустаяСсылка());
	ОбъектРасчета.Вставить("ДатаНачала", Неопределено);
	ОбъектРасчета.Вставить("тТрассировкаРасчета", ОписаниеТаблицыТрассировкиРасчета());
	ОбъектРасчета.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц); 
	ОбъектРасчета.Вставить("ВидРасчета", "");
	ОбъектРасчета.Вставить("НомерТранзакции", 0);
	ОбъектРасчета.Вставить("ЗаписыватьДанныеВРегистры", Ложь);
	
	// Служебные реквизиты - используются для получения данных из внешних ИБ
	ОбъектРасчета.Вставить("ВсегдаЗаполнятьАналитики",Истина);
	ОбъектРасчета.Вставить("мЗначенияОперандов",Неопределено);
	ОбъектРасчета.Вставить("База",Неопределено);
	
	// Реквизиты для совместимости с классическим движком расчета
	ОбъектРасчета.Вставить("АнализЧувствительности", Ложь);
	
	Возврат ОбъектРасчета;
	
КонецФункции

// Функция - Получить параметры расчета
// 
// Возвращаемое значение:
//	 - Структура - Структура с параметрами расчета показателей
//
Функция ПараметрыРасчета() Экспорт
	
	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("АдресТаблицыИзмененныхПоказателей", "");
	ПараметрыРасчета.Вставить("АдресТаблицыРассчитанныхПоказателей", "");
	ПараметрыРасчета.Вставить("НомерТранзакции", 0);
	ПараметрыРасчета.Вставить("РасчетПоТекущимВидамОтчетов", Истина);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", Ложь);
	ПараметрыРасчета.Вставить("ЗначениеДляРаспределения", 0);
	ПараметрыРасчета.Вставить("МетодРаспределения", Неопределено);
	ПараметрыРасчета.Вставить("СценарийДляИндексации", Неопределено);
	
	Возврат ПараметрыРасчета;
	
КонецФункции

// Функция - Проверить модуль
//
// Параметры:
//	ТекстМодуля				- Строка - Текст проверяемого модуля
//	ОписаниеОшибки			- Строка - Переменная, в которую будет передан текст ошибки
//	ВычисляемыйПоказатель	- Булево - Признак того, что это текст отбора или формулы расчета показателя
//	ВидОтчетаПоказатель		- СправочникСсылка - Ссылка на текущий показатель или вид отчета
// 
// Возвращаемое значение:
//	- Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ПроверитьМодуль(Знач ТекстМодуля, ОписаниеОшибки, ВычисляемыйПоказатель = Ложь, ВидОтчетаПоказатель = Неопределено) Экспорт
	
	Если ТипЗнч(ОбъектРасчета) <> Тип("Структура") Тогда
		ОбъектРасчета = ИнициализироватьОбъектРасчета();
	КонецЕсли;
	
	ТекстМодуля = НРег(ТекстМодуля);
	
	Если ВычисляемыйПоказатель Тогда
		
		Если СтрНайти(ТекстМодуля, "результат =") = 0 И СтрНайти(ТекстМодуля, "результат=") = 0
			И СтрНайти(ТекстМодуля, "result =") = 0 И СтрНайти(ТекстМодуля, "result=") = 0 Тогда
			Если ТекущийЯзык() = Метаданные.Языки.Русский Тогда
				ТекстРезультат = "Результат";
			Иначе
				ТекстРезультат = "Result";
			КонецЕсли;
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не присвоено значение переменной ""%1""'"), ТекстРезультат);
			Возврат Ложь;
		КонецЕсли;
		
		Если ТипЗнч(ВидОтчетаПоказатель) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
			
			ТипЗначенияПоказателя = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ВидОтчетаПоказатель,"ТипЗначения");
			Если ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
				ПустоеЗначение = """""";
			ИначеЕсли ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
				ПустоеЗначение = "ЛОЖЬ";
			ИначеЕсли ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
				ПустоеЗначение = "ДАТА(1,1,1)";
			Иначе
				ПустоеЗначение = "0";
			КонецЕсли;
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	ИсточникиДанныхДляРасчетов.Код КАК Код
			|ИЗ
			|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
			|ГДЕ
			|	ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.ПотребительРасчета КАК Справочник.ПоказателиОтчетов) = &ПотребительРасчета");
			Запрос.УстановитьПараметр("ПотребительРасчета", ВидОтчетаПоказатель);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекстМодуля = СтрЗаменить(ТекстМодуля, "[" + НРег(СокрЛП(Выборка.Код)) + "]", ПустоеЗначение);
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ВидОтчетаПоказатель) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	ИсточникиДанныхДляРасчетов.Код КАК Код,
			|	ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.ПотребительРасчета КАК Справочник.ПоказателиОтчетов).ТипЗначения КАК ТипЗначенияПоказателя
			|ИЗ
			|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
			|ГДЕ
			|	ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.ПотребительРасчета КАК Справочник.ПоказателиОтчетов).Владелец = &ВидОтчета");
			
			Запрос.УстановитьПараметр("ВидОтчета", ВидОтчетаПоказатель);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
					ПустоеЗначение = """""";
				ИначеЕсли ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
					ПустоеЗначение = "ЛОЖЬ";
				ИначеЕсли ТипЗначенияПоказателя = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
					ПустоеЗначение = "ДАТА(1,1,1)";
				Иначе
					ПустоеЗначение = "0";
				КонецЕсли;
				
				ТекстМодуля = СтрЗаменить(ТекстМодуля, "[" + НРег(СокрЛП(Выборка.Код)) + "]", ПустоеЗначение);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстМодуля = "Если Ложь Тогда " + ТекстМодуля + "
	|КонецЕсли;";
	
	Попытка
		// АПК:487-выкл Выполняется в контексте данной обработки
		ДанныеРасчета = Новый Структура;
		Выполнить(ТекстМодуля);
		// АПК:487-вкл
		Возврат Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = ИнформацияОбОшибке.Причина.Описание;
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Функция - Параметрическая настройка
//
// Параметры:
//	ВидРасчета	 - Строка - Вид расчета для параметрической настройки строкой
//	Параметр1	 - Произвольный - Первый параметр
//	Параметр2	 - Произвольный - Второй параметр
//	Параметр3	 - Произвольный - Третий параметр
// 
// Возвращаемое значение:
//	 - ТаблицаЗначений - Таблица содержащая строки параметрической настройки для расчета показателей
//
Функция ПараметрическаяНастройка(ВидРасчета, Параметр1=Неопределено, Параметр2=Неопределено, Параметр3=Неопределено) Экспорт

	глТаблицаПересчетаПоказателей = Неопределено;
	
	ПроцедураВычисленияНачало = "глТаблицаПересчетаПоказателей = ПараметрическаяНастройка" + ВидРасчета;

	Если Параметр3 <> Неопределено Тогда
		ПроцедураВычисления = ПроцедураВычисленияНачало + "(Параметр1,Параметр2,Параметр3)";
	ИначеЕсли Параметр2 <> Неопределено Тогда
		ПроцедураВычисления = ПроцедураВычисленияНачало + "(Параметр1,Параметр2)";
	ИначеЕсли Параметр1 <> Неопределено Тогда
		ПроцедураВычисления = ПроцедураВычисленияНачало + "(Параметр1)";
	КонецЕсли;
		
	// АПК:487-выкл Выполняется в контексте данной обработки
	Выполнить(ПроцедураВычисления);
	// АПК:487-вкл;
	
	Возврат глТаблицаПересчетаПоказателей;
	
КонецФункции

// Процедура - Сообщает о событиях по таблице событий
//
Процедура СообщитьОСобытиях() Экспорт
	
	Если ПустаяСтрока(АдресТаблицыСобытий) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСобытий = ПолучитьИзВременногоХранилища(АдресТаблицыСобытий);
	Для Каждого СтрокаТаблицы Из ТаблицаСобытий Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрокаТаблицы.Сообщение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область РасчетПоДаннымДляПересчета

Функция ВыполнитьРасчетПоДаннымДляПересчета(ПараметрыРасчета)
	
	// Подготовим данные для пересчета
	ДанныеДляПересчета = ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием();
	ДанныеДляПересчетаПоказателей.Очистить();
	Если ДанныеДляПересчета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Добавим лог измененных показателей и инициализируем менеджер временных таблиц
	Если ПараметрыРасчета.Свойство("МенеджерВременныхТаблиц") Тогда
		МенеджерВременныхТаблиц = ПараметрыРасчета.МенеджерВременныхТаблиц;
	Иначе
		МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ДанныеДляПересчета Цикл
		
		Если СтрокаТаблицы.МассивПериодов.Количество() = 0 Тогда
			// Нет открытых периодов для расчета
			Продолжить;
		КонецЕсли;
		
		ВремяНачалаРасчетов = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ИнициализироватьОбъектРасчета();
		// "БланкИмпорта" в строке ТЧ заполняется при заполнении с выбором способа заполнения
		ОбъектРасчета.БланкДляИмпорта = СтрокаТаблицы.БланкИмпорта;
		Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, СтрокаТаблицы, ПараметрыРасчета) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Выполним заполнение показателей
		ТипРасчетаПоказателей = 3;
		Если ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Консолидация
			ИЛИ ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.КонсолидацияПропорционально
			ИЛИ ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Элиминация Тогда
			РезультатЗаполнения = РассчитатьПоДаннымПериметраОрганизации();
		ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоАналитикам Тогда
			РезультатЗаполнения = РассчитатьСвернувПоАналитикам();
		ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоПериоду Тогда
			РезультатЗаполнения = РассчитатьСвернувПоПериоду();
		ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Импорт Тогда
			РезультатЗаполнения = ВыполнитьИмпортДанных();
		ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение Тогда
			Продолжить;
		Иначе
			ТипРасчетаПоказателей = СтрокаТаблицы.ТипРасчетаПоказателей;
			РезультатЗаполнения = Истина;
		КонецЕсли;
		
		Если Не РезультатЗаполнения Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Выполним расчет показателей по правилу расчета
		Если Не РассчитатьПоПравилуРасчета(ПараметрыРасчета.мПоказателиИсключения, ТипРасчетаПоказателей) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ВремяОкончанияРасчетов = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СтрокаТаблицы.ВремяРасчетов = ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
		
	КонецЦикла;
	
	// Обработаем данные расчета
	Если ПараметрыРасчета.ЗаписыватьДанныеВРегистры Тогда
		Если Не ВыполнитьЗаписьЛогаИзмененныхПоказателей(МенеджерВременныхТаблиц) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если Не СохранитьЛогИзмененныхПоказателей(МенеджерВременныхТаблиц, ПараметрыРасчета.НомерТранзакции) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием()
	
	АвтоматическийПересчетЗависимыхПоказателей = Ложь;

	// Определим документ "Управление периодом" для каждого из интервалов
	ДанныеДляПересчета = ДанныеДляПересчетаПоказателей.ВыгрузитьКолонки();
	ДанныеДляПересчета.Колонки.Добавить("УправлениеПериодом");
	ДанныеДляПересчета.Колонки.Добавить("ВерсияРегламента");
	ДанныеДляПересчета.Колонки.Добавить("ЗаполнятьПустыеАналитики");
	ДанныеДляПересчета.Колонки.Добавить("ГруппаВидовОтчетов");
	ДанныеДляПересчета.Колонки.Добавить("МассивПериодов");
	ДанныеДляПересчета.Колонки.Добавить("ТипРасчетаПоказателей");
	ДанныеДляПересчета.Колонки.Добавить("ВремяРасчетов");
	Для Каждого СтрокаТаблицы Из ДанныеДляПересчетаПоказателей Цикл
		
		ЕстьОшибкиПроверки = Ложь;
	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ПериодОтчета) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ""Период отчета"" в данных для пересчета показателей'"); 
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием", , , ТекстСообщения); 
			ЕстьОшибкиПроверки = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Сценарий) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ""Сценарий"" в данных для пересчета показателей'"); 
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием", , , ТекстСообщения); 
			ЕстьОшибкиПроверки = Истина;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Организация) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана ""Организация"" в данных для пересчета показателей'"); 
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием", , , ТекстСообщения); 
			ЕстьОшибкиПроверки = Истина;
		КонецЕсли;
		
		Если ЕстьОшибкиПроверки Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Получим данные управления периодом
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ 
			|	ДокументУправлениеПериодомСценария.Ссылка КАК УправлениеПериодом,
			|	ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры КАК ВерсияРегламента,
			|	ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры.ВидОтчета КАК ГруппаВидовОтчетов,
			|	ДокументУправлениеПериодомСценария.ПериодСценария КАК ПериодОтчета,
			|	ДокументУправлениеПериодомСценария.ПериодСценарияОкончание КАК ПериодОкончания,
			|	СтатусыПериодовСценариев.СтатусБлокировки КАК СтатусБлокировки,
			|	СтатусыПериодовСценариев.Периоды КАК Период,
			|	ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры.АвтоматическиПересчитыватьЗависимыеПоказатели КАК АвтоматическиПересчитыватьЗависимыеПоказатели,
			|	ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры.ПодставлятьЗначенияАналитикПоУмолчанию КАК ЗаполнятьПустыеАналитики
			|ИЗ
			|	РегистрСведений.СтатусыПериодовСценариев КАК СтатусыПериодовСценариев
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УправлениеПериодомСценария КАК ДокументУправлениеПериодомСценария
			|		ПО СтатусыПериодовСценариев.УправлениеПериодомСценария = ДокументУправлениеПериодомСценария.Ссылка
			|			И СтатусыПериодовСценариев.ВерсияРегламента = ДокументУправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры
			|			И (СтатусыПериодовСценариев.Сценарии = &Сценарий)
			|			И (СтатусыПериодовСценариев.Организации = &Организация)
			|			И (ДокументУправлениеПериодомСценария.ТекущаяПериодичность = &Периодичность)
			|			И (СтатусыПериодовСценариев.Периоды.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания)
			|
			|УПОРЯДОЧИТЬ ПО
			|	СтатусыПериодовСценариев.Периоды.ДатаНачала
			|ИТОГИ 
			|	МАКСИМУМ(АвтоматическиПересчитыватьЗависимыеПоказатели),
			|	МАКСИМУМ(ЗаполнятьПустыеАналитики)
			|ПО
			|	УправлениеПериодом";
		
		ДанныеПериода = ПолучитьДанныеПериода(СтрокаТаблицы.ПериодОтчета);
		Запрос.УстановитьПараметр("Периодичность", ДанныеПериода.Периодичность);
		Запрос.УстановитьПараметр("ДатаНачала", ДанныеПериода.ДатаНачала);
		
		ДанныеПериода = ПолучитьДанныеПериода(СтрокаТаблицы.ПериодОкончания);
		Запрос.УстановитьПараметр("ДатаОкончания", ДанныеПериода.ДатаОкончания);
		Запрос.УстановитьПараметр("Организация", СтрокаТаблицы.Организация);
		Запрос.УстановитьПараметр("Сценарий", СтрокаТаблицы.Сценарий);
	
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось определить документ управления отчетным периодом по параметрам:
			|	Сценарий: ""%1"",
			|	Организация: ""%2"",
			|	Период: ""%3""'"), 
			СтрокаТаблицы.Сценарий, СтрокаТаблицы.Организация, СтрокаТаблицы.ПериодОтчета);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием", , , ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		ВыборкаУправлениеПериодом = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
		Пока ВыборкаУправлениеПериодом.Следующий() Цикл
			
			// Добавим строку в таблицу расчета
			НСтрока = ДанныеДляПересчета.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаУправлениеПериодом);
			НСтрока.ТипРасчетаПоказателей = 1;
			
			// Добавим периоды
			НСтрока.МассивПериодов = Новый Массив;
			ВыборкаПериоды = ВыборкаУправлениеПериодом.Выбрать();
			Пока ВыборкаПериоды.Следующий() Цикл
				Если ВыборкаПериоды.СтатусБлокировки = 1 Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Из расчета исключен заблокированный период по параметрам:
					|	Период: ""%1""
					|	Регламент: ""%2"",
					|	Сценарий: ""%3"",
					|	Организация: ""%4""'"), 
					ВыборкаПериоды.Период, ВыборкаПериоды.ВерсияРегламента, СтрокаТаблицы.Сценарий, СтрокаТаблицы.Организация);
					ПротоколируемыеСобытияУХ.ДобавитьЗаписьИнформация("РасчетИЗаписьПоказателей.МодульОбъекта.ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием", , , ТекстСообщения);
				Иначе
					НСтрока.МассивПериодов.Добавить(ВыборкаПериоды.Период);
				КонецЕсли;
			КонецЦикла;
			
			// Добавим все зависимые срезы для расчета
			Если ВыборкаУправлениеПериодом.АвтоматическиПересчитыватьЗависимыеПоказатели Тогда
				
				АвтоматическийПересчетЗависимыхПоказателей = Истина;
				
				// Получим все правила расчета, установленные в регламенте
				ДанныеДляРасчетов = ПолучитьДанныеПериода(НСтрока.ПериодОкончания);
				ДанныеДляРасчетов.Вставить("УправлениеПериодом", НСтрока.УправлениеПериодом);
				ДанныеДляРасчетов.Вставить("ВерсияРегламента", НСтрока.ВерсияРегламента);
				ДанныеДляРасчетов.Вставить("Организация", НСтрока.Организация);
				ДанныеДляРасчетов.Вставить("ГруппаВидовОтчетов", НСтрока.ГруппаВидовОтчетов);
				ДанныеДляРасчетов.Вставить("ВидОтчета", НСтрока.ВидОтчета);
				
				// Заполним ключевые аналитики
				ДобавитьДанныеВидаОтчета(ДанныеДляРасчетов);
				Если ДанныеДляРасчетов.РазделениеПоПроектам Тогда
					ДанныеДляРасчетов.Вставить("Проект", НСтрока.Проект);
				КонецЕсли;
				Для Сч = 1 По ДанныеДляРасчетов.МаксКлючевыхАналитик Цикл
					ДанныеДляРасчетов.Вставить("Аналитика" + Сч, НСтрока["Аналитика" + Сч]);
				КонецЦикла;
				
				// Получим правила обработки
				ДобавитьПравилаОбработки(ДанныеДляРасчетов);
				
				// Получим правило обработки, если оно не передано явно
				Если НЕ ЗначениеЗаполнено(НСтрока.ПравилоОбработки) Тогда
					Если НЕ ДобавитьНастройкиОбработкиШаблонов(ДанныеДляРасчетов) Тогда
						Возврат Неопределено;
					КонецЕсли;
					НСтрока.ПравилоОбработки = ДанныеДляРасчетов.ПравилоОбработки;
				КонецЕсли;
				
				// Подготовим таблицу процедур расчета
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("ПравилаОбработки", ДанныеДляРасчетов.ПравилаОбработки);
				Запрос.УстановитьПараметр("ВерсияРегламента", ДанныеДляРасчетов.ВерсияРегламента);
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	ПроцедурыРасчетов.ПотребительРасчета КАК ПотребительРасчета
					|ПОМЕСТИТЬ втПроцедурыРасчетов
					|ИЗ
					|	РегистрСведений.ПроцедурыРасчетов КАК ПроцедурыРасчетов
					|ГДЕ
					|	ПроцедурыРасчетов.НазначениеРасчетов В(&ПравилаОбработки)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиница КАК ОрганизационнаяЕдиница,
					|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.ОрганизационнаяЕдиницаРодитель КАК ОрганизационнаяЕдиницаРодитель
					|ПОМЕСТИТЬ втСтруктураОрганизационныхЕдиниц
					|ИЗ
					|	Справочник.ВерсииРегламентовПодготовкиОтчетности.СтруктураГруппы КАК ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы
					|ГДЕ
					|	ВерсииРегламентовПодготовкиОтчетностиСтруктураГруппы.Ссылка = &ВерсияРегламента";
				Запрос.Выполнить();
				
				// Добавим аналитики вида отчета и проекты, но только уже существующие в рамках текущего среза
				ДобавитьАналитикиПроекты(ДанныеДляПересчета, НСтрока);
				
				// Получим все организации периметра из регламента
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	СтруктураОрганизационныхЕдиниц.ОрганизационнаяЕдиницаРодитель КАК ОрганизационнаяЕдиницаРодитель
					|ИЗ
					|	втСтруктураОрганизационныхЕдиниц КАК СтруктураОрганизационныхЕдиниц
					|ГДЕ
					|	СтруктураОрганизационныхЕдиниц.ОрганизационнаяЕдиница = &ОрганизационнаяЕдиница";
				мОрганизации = Новый Массив;
				ДобавитьОрганизационныеЕдиницыРекурсивно(мОрганизации, НСтрока.Организация, Запрос);
				
				// Добавим вышестоящие организации для текущего среза
				Для Каждого Организация Из мОрганизации Цикл
					НСтрокаЗависимая = ДанныеДляПересчета.Добавить();
					НСтрокаЗависимая.Организация = Организация;
					НСтрокаЗависимая.ТипРасчетаПоказателей = 2;
					ЗаполнитьЗначенияСвойств(НСтрокаЗависимая, НСтрока, , "ПравилоОбработки, СпособФормированияОтчета, ИспользуемаяИБ, Организация, ТипРасчетаПоказателей");					
					ДобавитьАналитикиПроекты(ДанныеДляПересчета, НСтрокаЗависимая);
				КонецЦикла;
				мОрганизации.Вставить(0, НСтрока.Организация);
				
				// Получим все зависимые срезы рекурсивно
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ИсточникиДанныхДляРасчетов.НазначениеРасчетов КАК ПравилоОбработки,
					|	ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.НазначениеРасчетов КАК Справочник.ПравилаОбработки).Владелец КАК ВидОтчета,
					|	1 КАК Уровень
					|ИЗ
					|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПроцедурыРасчетов КАК ПроцедурыРасчетов
					|		ПО ИсточникиДанныхДляРасчетов.ПотребительРасчета = ПроцедурыРасчетов.ПотребительРасчета
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаОбработки КАК ПравилаОбработки
					|		ПО (ПравилаОбработки.Ссылка = &НазначениеРасчетов)
					|ГДЕ
					|	НЕ ИсточникиДанныхДляРасчетов.НеИспользуется
					|	И НЕ ИсточникиДанныхДляРасчетов.НазначениеРасчетов = ПравилаОбработки.Ссылка
					|	И ИсточникиДанныхДляРасчетов.ПоказательОтбор.Владелец = ПравилаОбработки.Владелец
					|	И НЕ ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.НазначениеРасчетов КАК Справочник.ПравилаОбработки).Владелец = ПравилаОбработки.Владелец
					|
					|ОБЪЕДИНИТЬ
					|
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ПравилаОбработкиИспользуемыеОтчеты.Ссылка,
					|	ПравилаОбработкиИспользуемыеОтчеты.Ссылка.Владелец,
					|	1
					|ИЗ
					|	Справочник.ПравилаОбработки.ИспользуемыеОтчеты КАК ПравилаОбработкиИспользуемыеОтчеты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаОбработки КАК ПравилаОбработкиИсточник
					|		ПО (ПравилаОбработкиИсточник.Ссылка = &НазначениеРасчетов)
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
					|		ПО (ПравилаОбработкиИсточник.Владелец = ВидыОтчетов.Ссылка)
					|			И (ВидыОтчетов.Ссылка = ПравилаОбработкиИспользуемыеОтчеты.ВидОтчета)
					|ГДЕ
					|	НЕ ПравилаОбработкиИспользуемыеОтчеты.ВидОтчета = ПравилаОбработкиИспользуемыеОтчеты.Ссылка.Владелец
					|	И ПравилаОбработкиИспользуемыеОтчеты.Ссылка В(&ПравилаОбработки)";
				тСвязанныеПравилаОбработки = Новый ТаблицаЗначений;
				тСвязанныеПравилаОбработки.Колонки.Добавить("ПравилоОбработки");
				тСвязанныеПравилаОбработки.Колонки.Добавить("ВидОтчета");
				тСвязанныеПравилаОбработки.Колонки.Добавить("Уровень");
				ДобавитьПравилаОбработкиРекурсивно(тСвязанныеПравилаОбработки, НСтрока.ПравилоОбработки, Запрос);
				тСвязанныеПравилаОбработки.Свернуть("ПравилоОбработки,ВидОтчета", "Уровень");
				тСвязанныеПравилаОбработки.Сортировать("Уровень");
				
				// Добавим зависимые срезы для связанных срезов и организаций
				Для Каждого СтрПравилоОбработки Из тСвязанныеПравилаОбработки Цикл
					Если СтрПравилоОбработки.ПравилоОбработки <> НСтрока.ПравилоОбработки Тогда
						Для Каждого Организация Из мОрганизации Цикл
							НСтрокаЗависимая = ДанныеДляПересчета.Добавить();
							НСтрокаЗависимая.Организация = Организация;
							НСтрокаЗависимая.ТипРасчетаПоказателей = 2;
							ЗаполнитьЗначенияСвойств(НСтрокаЗависимая, НСтрока, , "ВидОтчета, ПравилоОбработки, СпособФормированияОтчета, ИспользуемаяИБ, Организация, ТипРасчетаПоказателей");
							ЗаполнитьЗначенияСвойств(НСтрокаЗависимая, СтрПравилоОбработки, , ?(Организация = НСтрока.Организация, "", "ПравилоОбработки"));
							ДобавитьАналитикиПроекты(ДанныеДляПересчета, НСтрокаЗависимая);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	// Если расчет производился по нескольким видам отчетов, результирующую таблицу необходимо свернуть
	Если АвтоматическийПересчетЗависимыхПоказателей И ДанныеДляПересчетаПоказателей.Количество() > 1 Тогда
		ДанныеДляПересчета.Свернуть("ВидОтчета,ПравилоОбработки,СпособФормированияОтчета,ИспользуемаяИБ,ПериодОтчета,ПериодОкончания,Сценарий,Организация,
			|Проект,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,
			|УправлениеПериодом,ВерсияРегламента,ГруппаВидовОтчетов,
			|ТипРасчетаПоказателей,ВремяРасчетов");
	КонецЕсли;
	
	Возврат ДанныеДляПересчета;
	
КонецФункции

Процедура ДобавитьОрганизационныеЕдиницыРекурсивно(мОрганизации, Организация, Запрос)
	
	// Выполним запрос
	Запрос.УстановитьПараметр("ОрганизационнаяЕдиница", Организация);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Добавим вышестоящую организацию
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОрганизационнаяЕдиницаРодитель) Тогда			
			мОрганизации.Добавить(ВыборкаДетальныеЗаписи.ОрганизационнаяЕдиницаРодитель);
			ДобавитьОрганизационныеЕдиницыРекурсивно(мОрганизации, ВыборкаДетальныеЗаписи.ОрганизационнаяЕдиницаРодитель, Запрос);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПравилаОбработкиРекурсивно(тСвязанныеПравилаОбработки, ПравилоОбработки, Запрос)	
	
	// Выполним запрос
	Запрос.УстановитьПараметр("НазначениеРасчетов", ПравилоОбработки);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Добавим все зависимые правила расчета
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если тСвязанныеПравилаОбработки.Найти(ВыборкаДетальныеЗаписи.ПравилоОбработки, "ПравилоОбработки") = Неопределено Тогда
			НСтрока = тСвязанныеПравилаОбработки.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаДетальныеЗаписи);
			ДобавитьПравилаОбработкиРекурсивно(тСвязанныеПравилаОбработки, ВыборкаДетальныеЗаписи.ПравилоОбработки, Запрос);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьАналитикиПроекты(ДанныеДляПересчета, СтрокаРасчета)
	
	// Добавим аналитики вида отчета и проекты, но только уже существующие в рамках текущего среза
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВерсииЗначенийПоказателей.Аналитика1 КАК Аналитика1,
		|	ВерсииЗначенийПоказателей.Аналитика2 КАК Аналитика2,
		|	ВерсииЗначенийПоказателей.Аналитика3 КАК Аналитика3,
		|	ВерсииЗначенийПоказателей.Аналитика4 КАК Аналитика4,
		|	ВерсииЗначенийПоказателей.Аналитика5 КАК Аналитика5,
		|	ВерсииЗначенийПоказателей.Аналитика6 КАК Аналитика6,
		|	ВерсииЗначенийПоказателей.Проект КАК Проект
		|ИЗ
		|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
		|ГДЕ
		|	ВерсииЗначенийПоказателей.ВидОтчета = &ВидОтчета
		|	И ВерсииЗначенийПоказателей.Организация = &Организация
		|	И ВерсииЗначенийПоказателей.Сценарий = &Сценарий
		|	И ВерсииЗначенийПоказателей.ПериодОтчета В(&ПериодыОтчета)
		|	И (ВерсииЗначенийПоказателей.Проект <> &Проект
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика1 <> &Аналитика1
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика2 <> &Аналитика2
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика3 <> &Аналитика3
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика4 <> &Аналитика4
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика5 <> &Аналитика5
		|			ИЛИ ВерсииЗначенийПоказателей.Аналитика6 <> &Аналитика6)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НастраиваемыйОтчет.Аналитика1,
		|	НастраиваемыйОтчет.Аналитика2,
		|	НастраиваемыйОтчет.Аналитика3,
		|	НастраиваемыйОтчет.Аналитика4,
		|	НастраиваемыйОтчет.Аналитика5,
		|	НастраиваемыйОтчет.Аналитика6,
		|	НастраиваемыйОтчет.Проект
		|ИЗ
		|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
		|ГДЕ
		|	НастраиваемыйОтчет.ВидОтчета = &ВидОтчета
		|	И НастраиваемыйОтчет.Организация = &Организация
		|	И НастраиваемыйОтчет.Сценарий = &Сценарий
		|	И НастраиваемыйОтчет.УправлениеПериодом = &УправлениеПериодом
		|	И (НастраиваемыйОтчет.Проект <> &Проект
		|			ИЛИ НастраиваемыйОтчет.Аналитика1 <> &Аналитика1
		|			ИЛИ НастраиваемыйОтчет.Аналитика2 <> &Аналитика2
		|			ИЛИ НастраиваемыйОтчет.Аналитика3 <> &Аналитика3
		|			ИЛИ НастраиваемыйОтчет.Аналитика4 <> &Аналитика4
		|			ИЛИ НастраиваемыйОтчет.Аналитика5 <> &Аналитика5
		|			ИЛИ НастраиваемыйОтчет.Аналитика6 <> &Аналитика6)";
	
	Запрос.УстановитьПараметр("Аналитика1",			СтрокаРасчета.Аналитика1);
	Запрос.УстановитьПараметр("Аналитика2",			СтрокаРасчета.Аналитика2);
	Запрос.УстановитьПараметр("Аналитика3",			СтрокаРасчета.Аналитика3);
	Запрос.УстановитьПараметр("Аналитика4",			СтрокаРасчета.Аналитика4);
	Запрос.УстановитьПараметр("Аналитика5",			СтрокаРасчета.Аналитика5);
	Запрос.УстановитьПараметр("Аналитика6",			СтрокаРасчета.Аналитика6);
	Запрос.УстановитьПараметр("ВидОтчета",			СтрокаРасчета.ВидОтчета);
	Запрос.УстановитьПараметр("Организация",		СтрокаРасчета.Организация);
	Запрос.УстановитьПараметр("ПериодыОтчета",		СтрокаРасчета.МассивПериодов);
	Запрос.УстановитьПараметр("Проект",				СтрокаРасчета.Проект);
	Запрос.УстановитьПараметр("Сценарий",			СтрокаРасчета.Сценарий);
	Запрос.УстановитьПараметр("УправлениеПериодом", СтрокаРасчета.УправлениеПериодом);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НСтрока = ДанныеДляПересчета.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрока, СтрокаРасчета, , "Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6,Проект");
		ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаДетальныеЗаписи);
		НСтрока.ТипРасчетаПоказателей = 2;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область Расчет

Функция РассчитатьПоПравилуРасчета(мПоказателиИсключения = Неопределено, ТипРасчетаПоказателей=1)
	
	// Получаем структуру расчета показателей
	глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляПравилаРасчета(ОбъектРасчета.ПравилоОбработки, мПоказателиИсключения, ТипРасчетаПоказателей);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.ПоПравилуОбработки;
	
	// Вызываем процедуру ДоПересчетаПоПравилу
	Если Не ВыполнитьПроцедуруДоВычисления() Тогда
		Возврат Ложь;
	КонецЕсли;
			
	
	// Выполним расчет по формулам
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Пересчет зависимых валютных показателей
	ФлагОшибки = Ложь;
	ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки);	
	Если ФлагОшибки Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	// Вызываем процедуру ПослеПересчетаПоПравилу
	Если НЕ ВыполнитьПроцедуруПослеВычисления() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Уничтожим временные таблицы
	УничтожитьВременныеТаблицыРасчета();
	
	Возврат Истина;
	
КонецФункции

Функция РассчитатьПоДаннымПериметраОрганизации()

	/////////////////////////////////////////////////////////////////
	// Сформируем массив организаций периметра
	
	Если ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Консолидация Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОрганизацииВерсии.ОрганизационнаяЕдиница КАК Организация,
			|	&Коэффициент КАК Коэффициент
			|ИЗ
			|	Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ОрганизацииВерсии
			|ГДЕ
			|	ОрганизацииВерсии.Ссылка = &ВерсияРегламента
			|	И ОрганизацииВерсии.ОрганизационнаяЕдиницаРодитель = &Организация";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Коэффициент",
			УправлениеРабочимиПроцессамиУХ.ПолеЗапроса_ПреобразованиеДолиККоэффициенту());
		
		ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Консолидация;
		
	ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.КонсолидацияПропорционально Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОрганизацииВерсии.ОрганизационнаяЕдиница КАК Организация,
			|	ВЫБОР
			|		КОГДА ОрганизацииВерсии.Ссылка.ИспользоватьРасширенныеНастройкиПериметра
			|			ТОГДА ОрганизацииВерсии.ЭффективнаяДоля / 100
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Коэффициент
			|ИЗ
			|	Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ОрганизацииВерсии
			|ГДЕ
			|	ОрганизацииВерсии.Ссылка = &ВерсияРегламента
			|	И ОрганизацииВерсии.ОрганизационнаяЕдиницаРодитель = &Организация";
		
		ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.КонсолидацияПропорционально;
		
	ИначеЕсли ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Элиминация Тогда
		
		// Организация расчета обязательно должна быть элиминирующей
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектРасчета.Организация, "ЭлиминирующаяОрганизация") Тогда		
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Организация %1 не является элиминирующей. Заполнение способом ""Элиминация"" невозможно.'"), 
				Строка(ОбъектРасчета.Организация));
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьПоАвтоматическойЭлиминации", , , ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ТекстЗапроса = УправлениеРабочимиПроцессамиУХ.ТекстЗапроса_ОрганизацииПериметраСКоэффициентамиЭлиминации();
		
		ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация;
	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", ОбъектРасчета.Организация);
	Запрос.УстановитьПараметр("ВерсияРегламента", ОбъектРасчета.ВерсияРегламента);
	тОрганизацииПериметра = Запрос.Выполнить().Выгрузить();
	
	Если тОрганизацииПериметра.Количество() = 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В документе ""%1"", к области действия которого относится текущий отчет,
			|		не определен состав периметра для организационной единицы ""%2"".'"),
			Строка(ОбъектРасчета.УправлениеПериодом),
			Строка(ОбъектРасчета.Организация));
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьПоДаннымПериметраОрганизации", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектРасчета.Вставить("УточнениеСпособаФормированияОтчета", тОрганизацииПериметра);
	
	// Получаем структуру расчета показателей
	глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляПрочихРежимовЗаполнения(ОбъектРасчета.ПравилоОбработки, ТипПараметрическойНастройки);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выполним расчет
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Пересчет зависимых валютных показателей
	ФлагОшибки = Ложь;
	ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки);	
	Если ФлагОшибки Тогда
		Возврат Ложь;
	КонецЕсли;	

	
	// Уничтожим временные таблицы
	УничтожитьВременныеТаблицыРасчета();
	
	Возврат Истина;
	
КонецФункции

Функция РассчитатьСвернувПоАналитикам()
	
	// Проверим наличие пустых аналитик вида отчета
	ЕстьПустыеАналитикиОтчета = Ложь;
	СтрокаРеквизитов = "";
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СтрокаРеквизитов = СтрокаРеквизитов + ",ВидАналитики" + Инд;
	КонецЦикла;
	ДанныеВидаОтчета = ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(ОбъектРасчета.ВидОтчета,Сред(СтрокаРеквизитов,2));
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		ТекВидАналитики = ДанныеВидаОтчета["ВидАналитики" + Инд];
		ТекАналитика = ОбъектРасчета["Аналитика" + Инд];
		Если (ЗначениеЗаполнено(ТекВидАналитики)) И (НЕ ЗначениеЗаполнено(ТекАналитика)) Тогда
			ЕстьПустыеАналитикиОтчета = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если нет пустых аналитик, отчет не предназначен для заполнения данным способом
	Если НЕ ЕстьПустыеАналитикиОтчета Тогда
		ТекстСообщения = НСтр("ru = 'Заполнение по аналитикам отчетов допустимо только в случае, когда одна из таких аналитик не задана'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьСвернувПоАналитикам", , , ТекстСообщения);
		Возврат Истина;
	КонецЕсли;

	// Получаем структуру расчета показателей
	глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляПрочихРежимовЗаполнения(ОбъектРасчета.ПравилоОбработки, Перечисления.ТипПараметрическойНастройки.СвернувПоАналитикам);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выполним расчет
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Пересчет зависимых валютных показателей
	ФлагОшибки = Ложь;
	ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки);	
	Если ФлагОшибки Тогда
		Возврат Ложь;
	КонецЕсли;	

	
	// Уничтожим временные таблицы
	УничтожитьВременныеТаблицыРасчета();
	
	Возврат Истина;
	
КонецФункции

Функция РассчитатьСвернувПоПериоду()
	
	Если НЕ ЗначениеЗаполнено(ОбъектРасчета.УточнениеСпособаФормированияОтчета) Тогда
		ОбъектРасчета.УточнениеСпособаФормированияОтчета = ОбъектРасчета.ПериодичностьСвертывания;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбъектРасчета.УточнениеСпособаФормированияОтчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не задана периодичность свертывания по периоду'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьСвернувПоПериоду", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим соответствие периодичности свертывания периодичности отчета
	Если ОбщегоНазначенияУХ.ИндексПеречисления(ОбъектРасчета.УточнениеСпособаФормированияОтчета, "Периодичность") 
		>= ОбщегоНазначенияУХ.ИндексПеречисления(ОбъектРасчета.Периодичность, "Периодичность") Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Периодичность свертывания ""%1"" должна быть меньше периодичности отчета ""%2""'"),
			ОбъектРасчета.УточнениеСпособаФормированияОтчета, ОбъектРасчета.Периодичность); 
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьСвернувПоПериоду", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем структуру расчета показателей
	глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляПрочихРежимовЗаполнения(ОбъектРасчета.ПравилоОбработки, Перечисления.ТипПараметрическойНастройки.СвернувПоПериоду);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выполним расчет
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Пересчет зависимых валютных показателей
	ФлагОшибки = Ложь;
	ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки);	
	Если ФлагОшибки Тогда
		Возврат Ложь;
	КонецЕсли;	

	
	// Уничтожим временные таблицы
	УничтожитьВременныеТаблицыРасчета();

	Возврат Истина;
	
КонецФункции

Функция ВыполнитьИмпортДанных()
	
	// Определим бланк импорта
	Если НЕ ЗначениеЗаполнено(ОбъектРасчета.БланкДляИмпорта) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось определить бланк для импорта по параметрам:
		|	Управление отчетным периодом: ""%1"",
		|	Регламент: ""%2"",
		|	Организация: ""%3"",
		|	Вид отчета: ""%4""'"),
		ОбъектРасчета.УправлениеПериодом, ОбъектРасчета.ВерсияРегламента, 
		ОбъектРасчета.Организация, ОбъектРасчета.ВидОтчета);
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИмпортДанных", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектРасчета.УточнениеСпособаФормированияОтчета) = Тип("Структура") Тогда
		
		// Данные файла импорта переданы напрямую
		ДанныеХранимогоФайла = ОбъектРасчета.УточнениеСпособаФормированияОтчета;
		Для Каждого КлючЗначение Из ДанныеХранимогоФайла Цикл
			ОбъектРасчета.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ОбъектРасчета.ИспользуемаяИБ) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось определить внешнюю информационную базу по параметрам:
			|	Управление отчетным периодом: ""%1"",
			|	Регламент: ""%2"",
			|	Организация: ""%3"",
			|	Вид отчета: ""%4""'"),
			ОбъектРасчета.УправлениеПериодом, ОбъектРасчета.ВерсияРегламента,
			ОбъектРасчета.Организация, ОбъектРасчета.ВидОтчета);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИмпортДанных", , , ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ТипБД = ПолучитьЗначениеРеквизитаОбъекта(ОбъектРасчета.ИспользуемаяИБ, "ТипБД");
		Если ТипБД <> Справочники.ТипыБазДанных.ОбменТаблДок Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неподходящий тип информационной базы:
			|	Информационная база: ""%1"",
			|	Текущий тип: ""%2"",
			|	Ожидаемый тип: ""%3""'"),
			ОбъектРасчета.ИспользуемаяИБ, ТипБД, Справочники.ТипыБазДанных.ОбменТаблДок);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИмпортДанных", , , ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ФайлИмпорта = НайтиФайлИмпорта();
		
		Если ФайлИмпорта = Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось найти файлы импорта по параметрам:
			|	Сценарий: ""%1"",
			|	Организация: ""%2"",
			|	Период: ""%3"", 
			|	Вид отчета: ""%4""'"),
			ОбъектРасчета.Сценарий, ОбъектРасчета.Организация, ОбъектРасчета.ПериодОтчета, ОбъектРасчета.ВидОтчета);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИмпортДанных", , , ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ОбъектРасчета.Вставить("ПериодСценария", ОбъектРасчета.ПериодОтчета);
		ОбъектРасчета.Вставить("ИмяФайла", ФайлИмпорта.Имя);
		ОбъектРасчета.Вставить("ХранимыйФайл", Неопределено);
		ОбъектРасчета.Вставить("ВерсияХранимогоФайла", ХранимыеФайлыУХ.ДобавитьХранимыйФайлИлиВерсию(ФайлИмпорта.ПолноеИмя, ОбъектРасчета, , ОбъектРасчета.ХранимыйФайл));
			
		ОбъектРасчета.Вставить("ИмяЛиста", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектРасчета.БланкДляИмпорта,"ИмяЛиста"));
		ОбъектРасчета.Вставить("Пароль", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектРасчета.ИспользуемаяИБ, "Пароль"));
		ОбъектРасчета.Вставить("НуженПароль", ЗначениеЗаполнено(ОбъектРасчета.Пароль));
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектРасчета.ХранимыйФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось получить файл импорта по версии хранимого файла'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИмпортДанных", , , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(ОбъектРасчета.ХранимыйФайл.РасширениеФайла);
	ФайлИмпорта = ХранимыеФайлыУХ.ПолучитьХранимыйФайл(ОбъектРасчета.ХранимыйФайл, ИмяВременногоФайла, , , ОбъектРасчета.ВерсияХранимогоФайла);
	Если ФайлИмпорта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектРасчета.Вставить("АдресХранилищаФайла", РаботаСФайламиУХ.ПоместитьФайлВоВременноеХранилище(ИмяВременногоФайла));
	ОбъектРасчета.Вставить("Excel2003", Ложь);
	
	// Получим массив показателей, которые требуется загрузить
	тДанныеДляРасчетов = ПолучитьОперандыПоПравилуОбработки(ОбъектРасчета.ПравилоОбработки).тДанныеДляРасчетов;
	мПоказатели = тДанныеДляРасчетов.Скопировать(Новый Структура("ТипРасчетаПоказателя", 0), "Потребитель").ВыгрузитьКолонку("Потребитель");
	ОбъектРасчета.Вставить("мПоказатели", мПоказатели);
	
	Результат = ИмпортДанныхБланкУХ.ИмпортироватьДанныеИзМакета(ОбъектРасчета);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Если НЕ Результат Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДобавитьИзмененныеПоказателиВЛог(Истина, Ложь);

КонецФункции

#КонецОбласти


#Область ДобавлениеИзмененныхПоказателейВЛог

Функция ВыполнитьДобавлениеЗначенийИзмененныхПоказателиВЛог(мОбъектРасчета, ПараметрыРасчета)
	
	// Добавим лог измененных показателей и инициализируем менеджер временных таблиц
	МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
	
	// Заполним Объект расчета и проверим корректность данных
	ИнициализироватьОбъектРасчета();
	Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, мОбъектРасчета, ПараметрыРасчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получим таблицы для расчета
	Если ЗначениеЗаполнено(АдресТаблицыИзмененныхПоказателей) Тогда
		ОбъектРасчета.Вставить("тИзмененныеПоказатели", ПолучитьИзВременногоХранилища(АдресТаблицыИзмененныхПоказателей));
		АдресТаблицыИзмененныхПоказателей = "";
	КонецЕсли;
	
	// Выполним расчет по правилу расчета
	Если Не ДобавитьИзмененныеПоказателиВЛог(ПараметрыРасчета.АбсолютныеЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыРасчета.ЗаписыватьДанныеВРегистры Тогда
		Если НЕ ВыполнитьЗаписьЛогаИзмененныхПоказателей(МенеджерВременныхТаблиц) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если НЕ СохранитьЛогИзмененныхПоказателей(МенеджерВременныхТаблиц, ПараметрыРасчета.НомерТранзакции) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДобавитьИзмененныеПоказателиВЛог(АбсолютныеЗначения = Ложь, ФильтрПоИзмененнымЗначениям = Истина, глТаблицаПересчетаПоказателей = Неопределено)
	
	// Получим параметрику расчета
	Если АбсолютныеЗначения Тогда
		глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляУстановкиАбсолютныхЗначенийВЛог(ОбъектРасчета, Ложь, ФильтрПоИзмененнымЗначениям);
	Иначе
		глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляУстановкиЗначенийВЛог(ОбъектРасчета);
	КонецЕсли;
	
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Добавим рассчитанные показатели в лог рассчитанных показателей, выполнив необходимые расчеты
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Уничтожим временные таблицы
	УничтожитьВременныеТаблицыРасчета();
		
	Возврат Истина;
	
КонецФункции

#КонецОбласти


#Область РасчетПоИзмененнымПоказателям

Функция ВыполнитьРасчетЗависимыхПоказателей(ПараметрыРасчета)
	
	// Получим таблицы для расчета
	ТабИзмененныхПоказателей = ПолучитьИзВременногоХранилища(ПараметрыРасчета.АдресТаблицыИзмененныхПоказателей).Скопировать();
	Если ТабИзмененныхПоказателей.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Добавим лог измененных показателей и инициализируем менеджер временных таблиц
	МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
	ПараметрыРасчета.Вставить("КэшОбработанныхСрезов", Новый Массив);
	ПараметрыРасчета.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	// Дополним таблицу
	ТабИзмененныхПоказателей.Колонки.Добавить("УправлениеПериодом", Новый ОписаниеТипов("ДокументСсылка.УправлениеПериодомСценария"));
	ТабИзмененныхПоказателей.Колонки.Добавить("ВидОтчета", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
	ТабИзмененныхПоказателей.Колонки.Добавить("ЗависимыйПоказатель", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТабИзмененныхПоказателей.Колонки.Добавить("ПересчитыватьЗависимыеПоказатели", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТабИзмененныхПоказателей.Колонки.Добавить("ЗаполнятьПустыеАналитики", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	Если Не ДополнитьДанныеИзмененныхПоказателей(
		ТабИзмененныхПоказателей, ТабИзмененныхПоказателей, ПараметрыРасчета, Истина) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выполним рекурсивный пересчет показателей
	Если НЕ ВыполнитьРасчетЗависимыхПоказателейРекурсивно(ПараметрыРасчета, ТабИзмененныхПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Записываем изменения в лог измененных показателей
	Если ПараметрыРасчета.ВидРасчета = "ПоИзмененным" Тогда
		Если ПараметрыРасчета.ЗаписыватьДанныеВРегистры Тогда
			Возврат ВыполнитьЗаписьЛогаИзмененныхПоказателей(МенеджерВременныхТаблиц);
		Иначе
			Возврат СохранитьЛогИзмененныхПоказателей(МенеджерВременныхТаблиц, ПараметрыРасчета.НомерТранзакции);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Функция ВыполнитьРасчетЗависимыхПоказателейРекурсивно(ПараметрыРасчета, ТабИзмененныхПоказателей)
	
	РасчетПоТекущимВидамОтчетов		= ПараметрыРасчета.РасчетПоТекущимВидамОтчетов;
	КэшОбработанныхСрезов			= ПараметрыРасчета.КэшОбработанныхСрезов;
	МенеджерВременныхТаблиц			= ПараметрыРасчета.МенеджерВременныхТаблиц;

	ТабРассчитанныхПоказателей = ТабИзмененныхПоказателей.СкопироватьКолонки();
		
	// Сгруппируем данные по правилам расчета
	тПравилаОбработки = ТабИзмененныхПоказателей.Скопировать(,"ВидОтчета,ПравилоОбработки,ЗависимыйПоказатель");
	тПравилаОбработки.Свернуть("ВидОтчета,ПравилоОбработки,ЗависимыйПоказатель");
	Для Каждого СтрПравилоОбработки Из тПравилаОбработки Цикл
		
		// Получим строки с ключевыми срезами
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ВидОтчета", СтрПравилоОбработки.ВидОтчета); 
		ДобавитьДанныеВидаОтчета(СтруктураВозврата);
		
		// Построим строку ключевых срезов
		СтрокаКлючевыхАналитик = "ВидОтчета,ПравилоОбработки,УправлениеПериодом,ПересчитыватьЗависимыеПоказатели,ЗаполнятьПустыеАналитики,Сценарий,Организация,Проект,Валюта";
		Если ТабИзмененныхПоказателей.Колонки.Найти("ИспользуемаяИБ") <> Неопределено Тогда
			СтрокаКлючевыхАналитик = СтрокаКлючевыхАналитик + ",ИспользуемаяИБ";
		КонецЕсли;
		Если ТабИзмененныхПоказателей.Колонки.Найти("СпособФормированияОтчета") <> Неопределено Тогда
			СтрокаКлючевыхАналитик = СтрокаКлючевыхАналитик + ",СпособФормированияОтчета";
		КонецЕсли;
		Для Сч = 1 По СтруктураВозврата.МаксКлючевыхАналитик Цикл
			СтрокаКлючевыхАналитик = СтрокаКлючевыхАналитик + ",Аналитика" + Сч;
		КонецЦикла;
		
		// Цикл по строкам ключевого среза
		СтруктураОтбора = Новый Структура();
		Для Каждого Срез Из тПравилаОбработки.Колонки Цикл
			СтруктураОтбора.Вставить(Срез.Имя, СтрПравилоОбработки[Срез.Имя]);
		КонецЦикла;
		тСтрокиРасчета = ТабИзмененныхПоказателей.Скопировать(СтруктураОтбора);
		тСтрокиРасчета.Свернуть(СтрокаКлючевыхАналитик);
		Для Каждого СтрРасчета Из тСтрокиРасчета Цикл
			
			// Проверим, обрабатывался ли уже данный набор ключевых срезов
			СтруктураОтбора = Новый Структура();
			СтрокаОбработанныхСрезов = "";
			Для Каждого Срез Из тСтрокиРасчета.Колонки Цикл
				ТекущийСрез = СтрРасчета[Срез.Имя];
				Если ТекущийСрез = Неопределено Тогда
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + "НЕОПРЕДЕЛЕНО@";
				ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущийСрез))
					ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущийСрез)) Тогда
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + ТекущийСрез.УникальныйИдентификатор() + "@";
				Иначе
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + Строка(ТекущийСрез) + "@";
				КонецЕсли;
				СтруктураОтбора.Вставить(Срез.Имя, СтрРасчета[Срез.Имя]);
			КонецЦикла;
			
			тИзмененныеПоказатели = ТабИзмененныхПоказателей.Скопировать(СтруктураОтбора);
			тВсеПоказатели = тИзмененныеПоказатели.Скопировать(,"Показатель");
			тВсеПоказатели.Свернуть("Показатель");
			Для Каждого СтрокаТаблицы Из тВсеПоказатели Цикл
				СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + СтрокаТаблицы.Показатель.УникальныйИдентификатор() + "@";
				Если КэшОбработанныхСрезов.Найти(СтрокаОбработанныхСрезов) = Неопределено Тогда
					КэшОбработанныхСрезов.Добавить(СтрокаОбработанныхСрезов);
				Иначе
					ТекстСообщения = НСтр("ru = 'Произошло зацикливание расчета по ключевым срезам:'");
					Для Каждого Срез Из тСтрокиРасчета.Колонки Цикл
						ТекстСообщения = ТекстСообщения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
						|	%1: ""%2"";", Срез.Имя, СтрРасчета[Срез.Имя]);
					КонецЦикла;
					ТекстСообщения = ТекстСообщения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
						|	%1: ""%2"";", "Показатель", СтрокаТаблицы.Показатель);
					ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьРасчетЗависимыхПоказателейРекурсивно", , , ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
			
			// Инициализируем данные объекта расчета
			ИнициализироватьОбъектРасчета();
			
			ОбъектРасчета.ПериодОтчета = ПолучитьЗначениеРеквизитаОбъекта(СтрРасчета.УправлениеПериодом, "ПериодСценария");
			ОбъектРасчета.ПериодОкончания = ПолучитьЗначениеРеквизитаОбъекта(СтрРасчета.УправлениеПериодом, "ПериодСценарияОкончание");
			
			// Подготовим остальные данные для расчета
			ОбъектРасчета.тИзмененныеПоказатели = тИзмененныеПоказатели;
			Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, СтрРасчета, ПараметрыРасчета) Тогда
				Возврат Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрРасчета.Валюта) И СтрРасчета.Валюта <> ОбъектРасчета.ОсновнаяВалюта Тогда
				// Изменения в дополнительной валюте
				Если ОбъектРасчета.ДополнительныеВалюты.Найти(СтрРасчета.Валюта) = Неопределено Тогда
					// Выбрана валюта не из регламента
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выбранная валюта %1 не соответствует валютам установленным в регламенте по параметрам:
						|	Сценарий: ""%2"",
						|	Организация: ""%3"",
						|	Период: ""%4""'"),
						СтрРасчета.Валюта, ОбъектРасчета.Сценарий, ОбъектРасчета.Организация, ОбъектРасчета.ПериодОтчета);
					ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДополнитьДанныеИзмененныхПоказателей", , , ТекстСообщения); 
					Возврат Ложь;
				КонецЕсли;
				ОбъектРасчета.ДополнительныеВалюты.Добавить(ОбъектРасчета.ОсновнаяВалюта);
				ОбъектРасчета.ОсновнаяВалюта = СтрРасчета.Валюта;
			КонецЕсли;
			
			глТаблицаПересчетаПоказателей = Неопределено;
			
			// Если это исходные показатели, добавим их в лог
			Если НЕ СтрПравилоОбработки.ЗависимыйПоказатель Тогда
				Если ЗначениеЗаполнено(ПараметрыРасчета.СценарийДляИндексации) Тогда
					ОбъектРасчета.Вставить("УточнениеСпособаФормированияОтчета", ПараметрыРасчета.СценарийДляИндексации);
				КонецЕсли;
				ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение;
				Если НЕ ДобавитьИзмененныеПоказателиВЛог(,, глТаблицаПересчетаПоказателей) Тогда
					Возврат Ложь;
				КонецЕсли;
				ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.ПоПравилуОбработки;
			КонецЕсли;
			
			// Расчет по переданным измененным показателям
			Если ПараметрыРасчета.ВидРасчета = "ПоИзмененнымПоДаннымДляПересчета" Тогда
				// Показатели по данным для пересчета будут пересчитаны позже по данным для пересчета
				Продолжить;
			КонецЕсли;
			
			Если СтрРасчета.ПересчитыватьЗависимыеПоказатели Тогда
				ОбъектРасчета.Вставить("ТабРассчитанныхПоказателей", ТабРассчитанныхПоказателей);
			КонецЕсли;		
			Если РасчетПоТекущимВидамОтчетов Тогда
				Если Не РассчитатьПоИзмененнымПоказателям() Тогда
					Возврат Ложь;
				КонецЕсли;
				УничтожитьВременныеТаблицыРасчета();
			Иначе
				//Пересчет зависимых валютных показателей
				ФлагОшибки = Ложь;
				Если НЕ СтрПравилоОбработки.ЗависимыйПоказатель Тогда
					ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение;
				КонецЕсли;
				ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки, Истина);
				Если ФлагОшибки Тогда
					Возврат Ложь;
				КонецЕсли;
				ОбъектРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.ПоПравилуОбработки;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	// Теперь выполним расчет для новых значений показателей
	Если ТабРассчитанныхПоказателей.Количество() > 0 Тогда
		
		ТабИзмененныхПоказателей.Очистить();
		Если Не ДополнитьДанныеИзмененныхПоказателей(ТабРассчитанныхПоказателей, ТабИзмененныхПоказателей, ПараметрыРасчета) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Возврат ВыполнитьРасчетЗависимыхПоказателейРекурсивно(ПараметрыРасчета, ТабИзмененныхПоказателей);
			
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

Функция ДополнитьДанныеИзмененныхПоказателей(ИзмененныеПоказатели, СвязанныеПоказатели, ПараметрыРасчета, ВыполнятьОбратноеРаспределение=Ложь)
	
	ВсегоСтрок = ИзмененныеПоказатели.Количество();
	
	// Подготовим данные обратного распределения, если необходимо
	Если ВыполнятьОбратноеРаспределение Тогда
		Если ПараметрыРасчета.МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.Равномерно Тогда
			ЗначениеРаспределения = ПараметрыРасчета.ЗначениеДляРаспределения / ВсегоСтрок;
		ИначеЕсли ПараметрыРасчета.МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.ПоТекущемуЗначению Тогда
			СуммаЗначение = ИзмененныеПоказатели.Итог("Значение");
			Если СуммаЗначение = 0 Тогда
				ЗначениеРаспределения = 0;
			Иначе
				ЗначениеРаспределения = ПараметрыРасчета.ЗначениеДляРаспределения / СуммаЗначение;
			КонецЕсли;
		Иначе
			ВыполнятьОбратноеРаспределение = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Сч = 0 По ВсегоСтрок-1 Цикл
		
		СтрПоказатели = ИзмененныеПоказатели.Получить(Сч);
		
		// Выполним обратное распределение, если необходимо
		Если ВыполнятьОбратноеРаспределение Тогда
			Если ПараметрыРасчета.МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.Равномерно Тогда
				СтрПоказатели.Значение = ЗначениеРаспределения - СтрПоказатели.Значение;
			ИначеЕсли ПараметрыРасчета.МетодРаспределения = Перечисления.МетодыОбратногоРаспределения.ПоТекущемуЗначению Тогда 
				СтрПоказатели.Значение = (СтрПоказатели.Значение * ЗначениеРаспределения) - СтрПоказатели.Значение;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеДляРасчетов = Новый Структура;
		ДанныеДляРасчетов.Вставить("Организация", СтрПоказатели.Организация);
		ДанныеДляРасчетов.Вставить("Сценарий", СтрПоказатели.Сценарий);
		ДанныеДляРасчетов.Вставить("ПериодОтчета", СтрПоказатели.ПериодОтчета);
		
		// Добавим показатель
		Если НЕ ЗначениеЗаполнено(СтрПоказатели.Показатель) Тогда
			ТекстСообщения = НСтр("ru = 'Пустое значение ""Показатель"" в таблице измененных показателей'"); 
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ДополнитьДанныеИзмененныхПоказателей", , , ТекстСообщения); 
			Возврат Ложь;
		КонецЕсли;
		ДанныеДляРасчетов.Вставить("Показатель", СтрПоказатели.Показатель);
		
		// Получим вид отчета
		ВидОтчета = ПолучитьЗначениеРеквизитаОбъекта(СтрПоказатели.Показатель, "Владелец");
		ДанныеДляРасчетов.Вставить("ВидОтчета", ВидОтчета);
		СтрПоказатели.ВидОтчета = ВидОтчета;
		
		// Заполним ключевые аналитики
		ДобавитьДанныеВидаОтчета(ДанныеДляРасчетов);
		Если ДанныеДляРасчетов.РазделениеПоПроектам Тогда
			ДанныеДляРасчетов.Вставить("Проект", СтрПоказатели.Проект);
		КонецЕсли;
		Для СчАналитик = 1 По ДанныеДляРасчетов.МаксКлючевыхАналитик Цикл
			ДанныеДляРасчетов.Вставить("Аналитика" + СчАналитик, СтрПоказатели["Аналитика" + СчАналитик]);
		КонецЦикла;
		
		// Получим данные периода
		ДанныеПериода = ПолучитьДанныеПериода(СтрПоказатели.ПериодОтчета);
		ДанныеДляРасчетов.Вставить("ДатаНачала", ДанныеПериода.ДатаНачала);
		ДанныеДляРасчетов.Вставить("ДатаОкончания", ДанныеПериода.ДатаОкончания);
		ДанныеДляРасчетов.Вставить("Периодичность", ДанныеПериода.Периодичность);
		
		// Добавим данные управления периодом
		Если НЕ ДобавитьДанныеУправленияПериодомСценария(ДанныеДляРасчетов) Тогда
			Возврат Ложь;
		КонецЕсли;
		СтрПоказатели.УправлениеПериодом = ДанныеДляРасчетов.УправлениеПериодом;
		СтрПоказатели.ПересчитыватьЗависимыеПоказатели = ДанныеДляРасчетов.ПересчитыватьЗависимыеПоказатели;
		СтрПоказатели.ЗаполнятьПустыеАналитики = ДанныеДляРасчетов.ЗаполнятьПустыеАналитики;
		
		// Добавим правило обработки
		Если ЗначениеЗаполнено(СтрПоказатели.ПравилоОбработки)
			И ПолучитьЗначениеРеквизитаОбъекта(СтрПоказатели.ПравилоОбработки, "Владелец") = ВидОтчета Тогда
			ДанныеДляРасчетов.Вставить("ПравилоОбработки", СтрПоказатели.ПравилоОбработки);
		Иначе
			Если НЕ ДобавитьНастройкиОбработкиШаблонов(ДанныеДляРасчетов) Тогда
				Возврат Ложь;
			КонецЕсли;
			СтрПоказатели.ПравилоОбработки = ДанныеДляРасчетов.ПравилоОбработки;
		КонецЕсли;
		
		// Добавим в таблицу связанные правила расчетов
		Если ДанныеДляРасчетов.ПересчитыватьЗависимыеПоказатели Тогда
			
			Если НЕ ДобавитьПравилаОбработки(ДанныеДляРасчетов) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если ПараметрыРасчета.ВидРасчета = "ПоЦелевым" Тогда
				МассивСвязанныхПравилОбработки = ПолучитьИсходныеПравилаОбработки(ДанныеДляРасчетов, СтрПоказатели.ЗависимыйПоказатель);
				// Сохраним последние правила обработки
				КэшДанных.Вставить("ПравилаОбработки#Последние", ДанныеДляРасчетов.ПравилаОбработки);
			Иначе
				МассивСвязанныхПравилОбработки = ПолучитьЗависимыеПравилаОбработки(ДанныеДляРасчетов);
			КонецЕсли;
			
			Для Каждого СвязанноеПравилоОбработки Из МассивСвязанныхПравилОбработки Цикл
				НСтрока = СвязанныеПоказатели.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, СтрПоказатели);
				НСтрока.ПравилоОбработки = СвязанноеПравилоОбработки;
				НСтрока.УправлениеПериодом = ДанныеДляРасчетов.УправлениеПериодом;
				НСтрока.ЗависимыйПоказатель = Истина;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РассчитатьПоИзмененнымПоказателям(глТаблицаПересчетаПоказателей = Неопределено)
	
	// Получим параметрику расчета
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляИзмененныхПоказателей(ОбъектРасчета);
		Если глТаблицаПересчетаПоказателей = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Здесь проверить, что есть показатели с видом расчетов по формулам в валюте
	//Если есть, то получить таблицу доп валют и таких показателей
	//И сделать рукурсивный пересчет еще и в разрезе валют.
	
	// Заменим периоды, если нет рекурсивных сдвигов по периоду
	Если глТаблицаПересчетаПоказателей.Найти(Перечисления.ВидыОперацийРасчетаПоказателей.СоответствиеПериодов, "ВидОперацииРасчета") = Неопределено Тогда
		тВсеПериоды = Неопределено;
		Если ТипЗнч(ОбъектРасчета.тИзмененныеПоказатели) = Тип("ТаблицаЗначений") Тогда	
			тВсеПериоды = ОбъектРасчета.тИзмененныеПоказатели.Скопировать(,"ПериодОтчета");
		КонецЕсли;
		Если ТипЗнч(ОбъектРасчета.тЦелевыеПоказатели) = Тип("ТаблицаЗначений") Тогда
			Если тВсеПериоды = Неопределено Тогда
				тВсеПериоды = ОбъектРасчета.тЦелевыеПоказатели.Скопировать(,"ПериодОтчета");
			Иначе
				Для Каждого стрЦелевойПоказатель Из ОбъектРасчета.тЦелевыеПоказатели Цикл
					тВсеПериоды.Добавить(стрЦелевойПоказатель.ПериодОтчета);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		тВсеПериоды.Свернуть("ПериодОтчета");
		ОбъектРасчета.МассивПериодов = тВсеПериоды.ВыгрузитьКолонку("ПериодОтчета");
	КонецЕсли;
	
	// Выполним расчет показателей
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Пересчет зависимых валютных показателей
	ФлагОшибки = Ложь;
	ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки);	
	Если ФлагОшибки Тогда
		Возврат Ложь;
	КонецЕсли;	
		
	Возврат Истина;
	
КонецФункции

#КонецОбласти


#Область РасчетПоЗначениямЦелевыхПоказателей

Функция ВыполнитьРасчетПоЗначениямЦелевыхПоказателей(ЦелевыеПоказатели, ПараметрыРасчета)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("БылиОшибки", Истина);
	
	// Добавим лог измененных показателей и инициализируем менеджер временных таблиц
	МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
	
	// Создадим все таблицы и структуры для расчета
	ТабЦелевыхПоказателей = ЦелевыеПоказатели.Скопировать(); 
	ТабЦелевыхПоказателей.Колонки.Добавить("УправлениеПериодом", Новый ОписаниеТипов("ДокументСсылка.УправлениеПериодомСценария"));
	ТабЦелевыхПоказателей.Колонки.Добавить("ВидОтчета", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
	ТабЦелевыхПоказателей.Колонки.Добавить("ЗависимыйПоказатель", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТабЦелевыхПоказателей.Колонки.Добавить("ПересчитыватьЗависимыеПоказатели", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	ТабЦелевыхПоказателей.Колонки.Добавить("ЗаполнятьПустыеАналитики", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповБулево());
	
	тПоказатели = Новый ТаблицаЗначений;
	тПоказатели.Колонки.Добавить("Показатель");
	тПоказатели.Колонки.Добавить("Представление");
	тПоказатели.Колонки.Добавить("Уровень");
	тПоказатели.Колонки.Добавить("Процедура");
	тПоказатели.Колонки.Добавить("ТипЗначения");
	тПоказатели.Колонки.Добавить("ЧислоАналитик");
	тПоказатели.Колонки.Добавить("ЕстьАналитикаВалюта");
	тПоказатели.Колонки.Добавить("ВидИтога"); 
	тПоказатели.Колонки.Добавить("ВидИтогаПоПериоду");
	тПоказатели.Колонки.Добавить("ТипРасчета");
	
	тСвязиПоказателей = Новый ТаблицаЗначений;
	тСвязиПоказателей.Колонки.Добавить("Потребитель");
	тСвязиПоказателей.Колонки.Добавить("Показатель");	
	тСвязиПоказателей.Колонки.Добавить("Уровень", ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(2));
	
	ПараметрыРасчета.Вставить("КэшОбработанныхСрезов", Новый Массив);
	ПараметрыРасчета.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	ПараметрыРасчета.Вставить("тПоказатели", тПоказатели);
	ПараметрыРасчета.Вставить("тСвязиПоказателей", тСвязиПоказателей);
	ПараметрыРасчета.Вставить("ЛогИзмененныхПоказателейУровень0", УправлениеРасчетомПоказателей.ОписаниеЛогаИзмененныхПоказателей());
		
	// Дополним таблицу
	Если Не ДополнитьДанныеИзмененныхПоказателей(
		ТабЦелевыхПоказателей, ТабЦелевыхПоказателей, ПараметрыРасчета) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;

	// Выполним рекурсивный пересчет показателей
	Если НЕ РассчитатьПоЗначениямЦелевыхПоказателейРекурсивно(ТабЦелевыхПоказателей, ПараметрыРасчета) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	// Вычислим окончательные уровни в таблице связей
	МассивПоказателей = Новый Массив;
	Для Каждого СтрокаТаблицы Из ЦелевыеПоказатели Цикл
		НайденныеСтроки = тСвязиПоказателей.НайтиСтроки(Новый Структура("Потребитель",СтрокаТаблицы.Показатель));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			// Для показателей из таблицы целевых установим максимальный уровень
			НайденнаяСтрока.Уровень = 1;
			МассивПоказателей.Добавить(НайденнаяСтрока.Показатель);
		КонецЦикла;
	КонецЦикла;
		
	МассивПоказателей0Уровень = Новый Массив;
	Для Каждого СтрокаТаблицы Из тСвязиПоказателей Цикл
		Если тПоказатели.Найти(СтрокаТаблицы.Показатель, "Показатель") = Неопределено Тогда
			МассивПоказателей0Уровень.Добавить(СтрокаТаблицы.Показатель);
		КонецЕсли;
	КонецЦикла;
	
	тСвязиПоказателей.Сортировать("Уровень Убыв");
	
	// Установим уровень в таблице показателей
	Для Каждого СтрокаТаблицы Из тПоказатели Цикл
		СтрокаТаблицы.Уровень = тСвязиПоказателей.Найти(СтрокаТаблицы.Показатель,"Потребитель").Уровень;
		СтрокаТаблицы.ТипРасчета = 1;
	КонецЦикла;
	
	// Добавим данные показателей 0-уровня
	тДанныеПоказателей0Уровень = ПолучитьДанныеПоказателейУровень0(МассивПоказателей0Уровень, 
		КэшДанных.Получить("ПравилаОбработки#Последние"));
	Для Каждого СтрокаТаблицы Из тДанныеПоказателей0Уровень Цикл
		НайденнаяСтрока = тПоказатели.Найти(СтрокаТаблицы.Показатель, "Показатель");
		Если НайденнаяСтрока = Неопределено Тогда
			НайденнаяСтрока = тПоказатели.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НайденнаяСтрока, СтрокаТаблицы);
		НайденнаяСтрока.Представление = СтрокаТаблицы.ПоказательПредставление + " (" + СтрокаТаблицы.ВидОтчетаПредставление + ")";
		НайденнаяСтрока.ТипРасчета = ?(ЗначениеЗаполнено(СтрокаТаблицы.Процедура),2,3);
		НайденнаяСтрока.Уровень = тСвязиПоказателей.Найти(СтрокаТаблицы.Показатель,"Показатель").Уровень+1;
	КонецЦикла;
	тПоказатели.Сортировать("Уровень Убыв, Представление");

	// Получим итоговые значения показателей
	тЗначенияПоказателей = МенеджерВременныхТаблиц.Таблицы.Найти("втЛогИзмененныхПоказателей").ПолучитьДанные().Выгрузить();
	Для Каждого СтрокаТаблицы Из ПараметрыРасчета.ЛогИзмененныхПоказателейУровень0 Цикл
		НСтрока = тЗначенияПоказателей.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрока, СтрокаТаблицы);
		Если ЭтоРасшифровка Тогда
			НСтрока.ЭтоЛог = Ложь;
		КонецЕсли;
	КонецЦикла;

	// Получим данные аналитик
	тВсеПоказатели = тЗначенияПоказателей.Скопировать(,"Показатель");
	тВсеПоказатели.Свернуть("Показатель");
	тДанныеАналитик = ПолучитьДанныеАналитик(тВсеПоказатели.ВыгрузитьКолонку("Показатель"));
	
	// Получим массив всех периодов
	тВсеПериоды = тЗначенияПоказателей.Скопировать(,"ПериодОтчета");
	Для Каждого СтрокаТаблицы Из ЦелевыеПоказатели Цикл
		НСтрока = тВсеПериоды.Добавить();
		НСтрока.ПериодОтчета = СтрокаТаблицы.ПериодОтчета;
	КонецЦикла;
	тВсеПериоды.Свернуть("ПериодОтчета");
	тВсеПериоды.Колонки.Добавить("ДатаНачала");
	Для Каждого СтрокаТаблицы Из тВсеПериоды Цикл
		ТекДанные = ПолучитьДанныеПериода(СтрокаТаблицы.ПериодОтчета);
		СтрокаТаблицы.ДатаНачала = ТекДанные.ДатаНачала;
	КонецЦикла;
	тВсеПериоды.Сортировать("ДатаНачала");
	МассивПериодов = тВсеПериоды.ВыгрузитьКолонку("ПериодОтчета");
	
	// Заполним результат
	СтруктураВозврата.БылиОшибки = Ложь;
	СтруктураВозврата.Вставить("ЗначенияПоказателей", тЗначенияПоказателей);
	СтруктураВозврата.Вставить("Показатели", тПоказатели);
	СтруктураВозврата.Вставить("СвязиПоказателей", тСвязиПоказателей); 
	СтруктураВозврата.Вставить("ДанныеАналитик", тДанныеАналитик);
	СтруктураВозврата.Вставить("МассивПериодов", МассивПериодов);
	
	Если ЭтоРасшифровка Тогда
		ДополнитьПромежуточнымиРезультатамиРасчета(СтруктураВозврата);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция РассчитатьПоЗначениямЦелевыхПоказателейРекурсивно(ТабЦелевыхПоказателей, ПараметрыРасчета)
	
	КэшОбработанныхСрезов				= ПараметрыРасчета.КэшОбработанныхСрезов;
	МенеджерВременныхТаблиц				= ПараметрыРасчета.МенеджерВременныхТаблиц;
	РасчетПоСвязаннымВидамОтчетов		= ПараметрыРасчета.РасчетПоСвязаннымВидамОтчетов;
	тПоказатели							= ПараметрыРасчета.тПоказатели;
	тСвязиПоказателей					= ПараметрыРасчета.тСвязиПоказателей;
	тЛогИзмененныхПоказателейУровень0	= ПараметрыРасчета.ЛогИзмененныхПоказателейУровень0;
	
	ЗначенияПоказателей0ТекущийРасчет = ТабЦелевыхПоказателей.СкопироватьКолонки();
	
	// Сгруппируем данные по правилам расчета
	тПравилаОбработки = ТабЦелевыхПоказателей.Скопировать(,"ПравилоОбработки");
	тПравилаОбработки.Свернуть("ПравилоОбработки");
	Для Каждого СтрПравилоОбработки Из тПравилаОбработки Цикл 
		
		ПравилоОбработки = СтрПравилоОбработки.ПравилоОбработки;
		
		// Получим вид отчета
		ТекВидОтчета = КэшДанных.Получить(ПравилоОбработки);
		Если ТекВидОтчета = Неопределено Тогда
			ТекВидОтчета = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ПравилоОбработки, "Владелец");
		КонецЕсли;
		
		// Получим строки с ключевыми срезами
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ВидОтчета", ТекВидОтчета);
		ДобавитьДанныеВидаОтчета(СтруктураВозврата);
		
		// Построим строку ключевых срезов
		СтрокаКлючевыхАналитик = "Сценарий,Организация,Проект";
		Для Сч = 1 По СтруктураВозврата.МаксКлючевыхАналитик Цикл
			СтрокаКлючевыхАналитик = СтрокаКлючевыхАналитик + ",Аналитика" + Сч;
		КонецЦикла;
		
		// Цикл по строкам ключевого среза
		тСтрокиРасчета = ТабЦелевыхПоказателей.Скопировать(Новый Структура("ПравилоОбработки",ПравилоОбработки));
		ДанныеПараметрики = ПараметрическаяНастройкаДляЦелевыхПоказателей(ПравилоОбработки, тСтрокиРасчета);
		Если ДанныеПараметрики = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		глТаблицаПересчетаПоказателей = ДанныеПараметрики.глТаблицаПересчетаПоказателей;
		тПоказателиОперанды = ДанныеПараметрики.тПоказателиОперанды;
		
		тСтрокиРасчета.Свернуть(СтрокаКлючевыхАналитик + ",ПравилоОбработки,УправлениеПериодом");
		Для Каждого СтрРасчета Из тСтрокиРасчета Цикл	
			
			// Проверим, обрабатывался ли уже данный набор ключевых срезов
			СтруктураОтбора = Новый Структура();
			СтрокаОбработанныхСрезов = "";
			Для Каждого Срез Из тСтрокиРасчета.Колонки Цикл
				ТекущийСрез = СтрРасчета[Срез.Имя];
				Если ТекущийСрез = Неопределено Тогда
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + "НЕОПРЕДЕЛЕНО@";
				ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущийСрез))
					ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущийСрез)) Тогда
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + ТекущийСрез.УникальныйИдентификатор() + "@";
				Иначе
					СтрокаОбработанныхСрезов = СтрокаОбработанныхСрезов + Строка(ТекущийСрез) + "@";
				КонецЕсли;
				СтруктураОтбора.Вставить(Срез.Имя, СтрРасчета[Срез.Имя]);
			КонецЦикла;
			Если КэшОбработанныхСрезов.Найти(СтрокаОбработанныхСрезов) = Неопределено Тогда
				КэшОбработанныхСрезов.Добавить(СтрокаОбработанныхСрезов);
			Иначе
				ТекстСообщения = НСтр("ru = 'Произошло зацикливание расчета по ключевым срезам:'");
				Для Каждого Срез Из тСтрокиРасчета.Колонки Цикл
					ТекстСообщения = ТекстСообщения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
					|	%1: ""%2"";", Срез.Имя, СтрРасчета[Срез.Имя]);
				КонецЦикла;
				ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.РассчитатьПоЗначениямЦелевыхПоказателейРекурсивно", , , ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			
			// Инициализируем данные объекта расчета
			ИнициализироватьОбъектРасчета();
			ОбъектРасчета.ВидОтчета = ТекВидОтчета;
			ОбъектРасчета.ПериодОтчета = ПолучитьЗначениеРеквизитаОбъекта(СтрРасчета.УправлениеПериодом, "ПериодСценария");
			ОбъектРасчета.ПериодОкончания = ПолучитьЗначениеРеквизитаОбъекта(СтрРасчета.УправлениеПериодом, "ПериодСценарияОкончание");
		
			// Подготовим остальные данные для расчета
			ОбъектРасчета.тЦелевыеПоказатели = ТабЦелевыхПоказателей.Скопировать(СтруктураОтбора);
			Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, СтрРасчета) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если ЭтоРасшифровка Тогда
				ОбъектРасчета.Вставить("ВалютаОтображения", ТабЦелевыхПоказателей[0].ВалютаОтображения);
				ОбъектРасчета.Вставить("ПересчетВДопВалюты", ТабЦелевыхПоказателей[0].ПересчетВДопВалюты);
			КонецЕсли;
			
			Если ЭтоРасшифровка И НЕ ОбъектРасчета.ПересчетВДопВалюты Тогда
				// НЕ пересчитываем в валюты
				ОбъектРасчета.ДополнительныеВалюты.Очистить();
			КонецЕсли;
			
			// Выполним расчет
			Если Не РассчитатьПоИзмененнымПоказателям(глТаблицаПересчетаПоказателей) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если РасчетПоСвязаннымВидамОтчетов Тогда
				// Получим показатели 0-уровня для дальнейшего рекурсивного расчета
				втПоказателиРаскрытия0 = МенеджерВременныхТаблиц.Таблицы.Найти("втПоказателиРаскрытия0");
				Если втПоказателиРаскрытия0 <> Неопределено Тогда
					ВыборкаЗапроса = втПоказателиРаскрытия0.ПолучитьДанные().Выбрать();
					Пока ВыборкаЗапроса.Следующий() Цикл
						НСтрока = ЗначенияПоказателей0ТекущийРасчет.Добавить();
						ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаЗапроса);
						ЗаполнитьЗначенияСвойств(НСтрока, ОбъектРасчета, СтрокаКлючевыхАналитик);
						НСтрока.Валюта = ОбъектРасчета.ОсновнаяВалюта;
						НСтрока.ЗависимыйПоказатель = Истина;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			// Уничтожим временные таблицы расчета
			УничтожитьВременныеТаблицыРасчета();
			
		КонецЦикла;
			
		// Добавим показатели в дерево расчета			
		Для Каждого СтрокаТаблицы Из тПоказателиОперанды Цикл
			
			НСтрокаСвязи = тСвязиПоказателей.Добавить();
			НСтрокаСвязи.Потребитель = СтрокаТаблицы.Потребитель;
			НСтрокаСвязи.Показатель = СтрокаТаблицы.ПоказательОперанд;
			
			НайденнаяСтрока = тСвязиПоказателей.Найти(СтрокаТаблицы.Потребитель, "Показатель"); 
			Если НайденнаяСтрока = Неопределено Тогда
				// Это потребитель верхнего уровня
				НСтрокаСвязи.Уровень = 1;
			Иначе
				НСтрокаСвязи.Уровень = НайденнаяСтрока.Уровень + 1;
			КонецЕсли;
		
			Если тПоказатели.Найти(СтрокаТаблицы.Потребитель,"Показатель") = Неопределено Тогда
					
				НСтрока = тПоказатели.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, СтрокаТаблицы);
				НСтрока.Показатель = СтрокаТаблицы.Потребитель;
				НСтрока.Представление = СтрокаТаблицы.ПотребительПредставление + " (" + СтрокаТаблицы.ВидОтчетаПотребителяПредставление + ")";
				НСтрока.ТипЗначения = СтрокаТаблицы.ТипПотребителя;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	// Теперь выполним расчет для новых значений показателей
	Если ЗначенияПоказателей0ТекущийРасчет.Количество() > 0 Тогда
		
		Если РасчетПоСвязаннымВидамОтчетов Тогда		
	
			ТабЦелевыхПоказателей.Очистить();
			Если Не ДополнитьДанныеИзмененныхПоказателей(ЗначенияПоказателей0ТекущийРасчет, ТабЦелевыхПоказателей, ПараметрыРасчета) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			// Сохраним результаты 0-уровня расчета
			Для Каждого СтрокаТаблицы Из ЗначенияПоказателей0ТекущийРасчет Цикл
				Если ТабЦелевыхПоказателей.Найти(СтрокаТаблицы.Показатель, "Показатель") = Неопределено Тогда 
					// Это показатель 0-уровня	
					НСтрока = тЛогИзмененныхПоказателейУровень0.Добавить();
					ЗаполнитьЗначенияСвойств(НСтрока, СтрокаТаблицы);
				КонецЕсли;
			КонецЦикла;

			Если ТабЦелевыхПоказателей.Количество() > 0 Тогда
				// Есть еще уровни расчета
				Возврат РассчитатьПоЗначениямЦелевыхПоказателейРекурсивно(ТабЦелевыхПоказателей, ПараметрыРасчета);
			КонецЕсли;
			
		Иначе
			
			// Сохраним результаты 0-уровня расчета
			Для Каждого СтрокаТаблицы Из ЗначенияПоказателей0ТекущийРасчет Цикл
				НСтрока = тЛогИзмененныхПоказателейУровень0.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, СтрокаТаблицы);
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура УстановитьУровниРекурсивно(тСвязиПоказателей, МассивПоказателей, Уровень)

	МассивПоказателейНовый = Новый Массив;
	Для Каждого Показатель Из МассивПоказателей Цикл
		НайденныеСтроки = тСвязиПоказателей.НайтиСтроки(Новый Структура("Потребитель", Показатель));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Уровень = Уровень;
			МассивПоказателейНовый.Добавить(НайденнаяСтрока.Показатель);
		КонецЦикла;
	КонецЦикла;
	
	Если МассивПоказателейНовый.Количество() Тогда 
		УстановитьУровниРекурсивно(тСвязиПоказателей, МассивПоказателейНовый, Уровень+1);
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьДанныеАналитик(ВсеПоказатели)
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ПустаяАналитика", ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка());
	Запрос.Параметры.Вставить("ВсеПоказатели", ВсеПоказатели);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка КАК Показатель,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики1 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики1
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики1, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики1,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики2 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики2
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики2, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики2,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики3 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики3
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики3, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики3,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики4 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики4
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики4, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики4,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики5 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики5
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики5, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики5,
		|	ВЫБОР
		|		КОГДА ВидыОтчетов.ВидАналитики6 = &ПустаяАналитика
		|			ТОГДА ГруппыРаскрытия.ВидАналитики6
		|		ИНАЧЕ ЕСТЬNULL(ВидыОтчетов.ВидАналитики6, &ПустаяАналитика)
		|	КОНЕЦ КАК ВидАналитики6,
		|	ГруппыРаскрытия.Валютная КАК Валютная,
		|	ВидыОтчетов.РазделениеПоПроектам КАК РазделениеПоПроектам
		|ПОМЕСТИТЬ втДанныеПоказателей
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ПО (ПоказателиОтчетов.ГруппаРаскрытия = ГруппыРаскрытия.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
		|		ПО (ПоказателиОтчетов.Владелец = ВидыОтчетов.Ссылка)
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка В (&ВсеПоказатели)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель КАК Показатель,
		|	ЗНАЧЕНИЕ(Перечисление.ПостоянныеПоляСводнойТаблицы.Сценарий) КАК ВидАналитики,
		|	""Сценарий"" КАК ИмяАналитики
		|ПОМЕСТИТЬ втДанныеАналитик
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ЗНАЧЕНИЕ(Перечисление.ПостоянныеПоляСводнойТаблицы.Проект),
		|	""Проект""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.РазделениеПоПроектам
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ЗНАЧЕНИЕ(Перечисление.ПостоянныеПоляСводнойТаблицы.Организация),
		|	""Организация""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики1,
		|	""Аналитика1""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики1 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики2,
		|	""Аналитика2""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики2 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики3,
		|	""Аналитика3""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики3 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики4,
		|	""Аналитика4""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики4 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики5,
		|	""Аналитика5""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики5 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	ДанныеПоказателей.ВидАналитики6,
		|	""Аналитика6""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.ВидАналитики6 <> &ПустаяАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеПоказателей.Показатель,
		|	""АналитикаВалюта"",
		|	""АналитикаВалюта""
		|ИЗ
		|	втДанныеПоказателей КАК ДанныеПоказателей
		|ГДЕ
		|	ДанныеПоказателей.Валютная
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеАналитик.Показатель КАК Показатель,
		|	ДанныеАналитик.ВидАналитики КАК ВидАналитики,
		|	ДанныеАналитик.ИмяАналитики КАК ИмяАналитики,
		|	ЕСТЬNULL(ВидыСубконтоКорпоративные.Код, ДанныеАналитик.ИмяАналитики) КАК КодАналитики,
		|	ЕСТЬNULL(ВидыСубконтоКорпоративные.Представление, ДанныеАналитик.ИмяАналитики) КАК ПредставлениеАналитики,
		|	ВидыСубконтоКорпоративные.ТипЗначения КАК ТипЗначения,
		|	ВидыСубконтоКорпоративные.ПредставлениеТипа КАК ПредставлениеТипа
		|ИЗ
		|	втДанныеАналитик КАК ДанныеАналитик
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыСубконтоКорпоративные КАК ВидыСубконтоКорпоративные
		|		ПО ДанныеАналитик.ВидАналитики = ВидыСубконтоКорпоративные.Ссылка";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДанныеПоказателейУровень0(ПотребителиРасчета, ПравилаОбработки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПравилаОбработки", ПравилаОбработки);
	Запрос.УстановитьПараметр("ПотребителиРасчета", ПотребителиРасчета);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроцедурыРасчетов.ПотребительРасчета КАК Потребитель,
		|	ПроцедурыРасчетов.Процедура КАК Процедура
		|ПОМЕСТИТЬ втПроцедурыРасчетов
		|ИЗ
		|	РегистрСведений.ПроцедурыРасчетов КАК ПроцедурыРасчетов
		|ГДЕ
		|	ПроцедурыРасчетов.НазначениеРасчетов В(&ПравилаОбработки)
		|	И ПроцедурыРасчетов.ПотребительРасчета В(&ПотребителиРасчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка КАК Показатель,
		|	ПоказателиОтчетов.Представление КАК ПоказательПредставление,
		|	ПоказателиОтчетов.Владелец.Представление КАК ВидОтчетаПредставление,
		|	ПоказателиОтчетов.ТипЗначения КАК ТипЗначения,
		|	ПоказателиОтчетов.ВидИтога КАК ВидИтога,
		|	ПоказателиОтчетов.СпособРасчетаИтогаПоПериоду КАК ВидИтогаПоПериоду,
		|	ПоказателиОтчетов.ГруппаРаскрытия.ЧислоАналитик КАК ЧислоАналитик,
		|	ПоказателиОтчетов.ГруппаРаскрытия.Валютная КАК ЕстьАналитикаВалюта,
		|	ЕСТЬNULL(ПроцедурыРасчетов.Процедура, """") КАК Процедура,
		|	0 КАК Уровень
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПроцедурыРасчетов КАК ПроцедурыРасчетов
		|		ПО ПоказателиОтчетов.Ссылка = ПроцедурыРасчетов.Потребитель
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка В(&ПотребителиРасчета)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти


#Область РасчетПрочее

Функция ВыполнитьРасчетЗначениеВВалюте(ДанныеДляПересчета)
	
	// Получим данные показателя
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Показатель", ДанныеДляПересчета.Показатель);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Владелец КАК ВидОтчета,
		|	ИСТИНА КАК ЕстьАналитикаВалюта,
		|	ПоказателиОтчетов.ПересчитыватьВалютнуюСумму КАК ЕстьЗначениеВалюта,
		|	ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число) КАК ЕстьЗначение,
		|	ПоказателиОтчетов.ТипЗначения <> ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число) КАК ЕстьЗначениеНечисловое,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе) КАК ЕстьВидКурсаЗначениеУказанноеВДокументе,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления) КАК ЕстьВидКурсаКурсНаМоментНачисления,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления)
		|		И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе) КАК ЕстьВидКурсаПрочее
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка = &Показатель";
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если Не ВыборкаЗапроса.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ВыборкаЗапроса.ЕстьВидКурсаЗначениеУказанноеВДокументе
		ИЛИ ВыборкаЗапроса.ЕстьВидКурсаКурсНаМоментНачисления Тогда
		// Значения курса зависят от значений других показателей
		// Получим лог измененных показателей в менеджер временных таблиц
		МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
	Иначе
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	// Подготовим объект расчета
	ИнициализироватьОбъектРасчета();
	ОбъектРасчета.ВидОтчета = ВыборкаЗапроса.ВидОтчета;
	Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, ДанныеДляПересчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Загрузим данные в менеджер временных таблиц
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПериодОтчета", ДанныеДляПересчета.ПериодОтчета);
	Запрос.УстановитьПараметр("АналитикаВалюта", ДанныеДляПересчета.АналитикаВалюта);
	Запрос.УстановитьПараметр("Значение", ДанныеДляПересчета.Значение);
	Запрос.УстановитьПараметр("ЗначениеВалюта", ДанныеДляПересчета.ЗначениеВалюта);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&Показатель КАК Показатель,
		|	&ПериодОтчета КАК ПериодОтчета,
		|	&АналитикаВалюта КАК АналитикаВалюта,
		|	&Значение КАК Значение,
		|	&ЗначениеВалюта КАК ЗначениеВалюта
		|ПОМЕСТИТЬ втРассчитанныеПоказатели";
	Запрос.Выполнить();
	
	глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляДляРасчетаЗначенияВВалюте(ОбъектРасчета, ВыборкаЗапроса);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выполнение запросов
	Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Получаем данные
	тРезультат = ПолучитьИзВременногоХранилища(АдресТаблицыРассчитанныхПоказателей);
	Если тРезультат.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрРезультат = тРезультат.Получить(0);
	ДанныеДляПересчета.Значение = СтрРезультат.Значение;
	ДанныеДляПересчета.ЗначениеВалюта = СтрРезультат.ЗначениеВалюта;
		
	Возврат Истина;
	
КонецФункции

Функция ВыполнитьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов(мОбъектРасчета, ПараметрыРасчета)
	
	Если ТипЗнч(ПараметрыРасчета.Источник) = Тип("ДокументСсылка.НастраиваемыйОтчет") Тогда
		
		// В качестве источника передан другой документ
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НастраиваемыйОтчет.Ссылка КАК Ссылка,
			|	НастраиваемыйОтчет.ПериодОтчета КАК ПериодОтчета,
			|	НастраиваемыйОтчет.ПериодОкончания КАК ПериодОкончания,
			|	НастраиваемыйОтчет.ВидОтчета КАК ВидОтчета,
			|	НастраиваемыйОтчет.Сценарий КАК Сценарий,
			|	НастраиваемыйОтчет.Организация КАК Организация,
			|	НастраиваемыйОтчет.Проект КАК Проект,
			|	НастраиваемыйОтчет.ОсновнаяВалюта КАК Валюта,
			|	НастраиваемыйОтчет.Аналитика1 КАК Аналитика1,
			|	НастраиваемыйОтчет.Аналитика2 КАК Аналитика2,
			|	НастраиваемыйОтчет.Аналитика3 КАК Аналитика3,
			|	НастраиваемыйОтчет.Аналитика4 КАК Аналитика4,
			|	НастраиваемыйОтчет.Аналитика5 КАК Аналитика5,
			|	НастраиваемыйОтчет.Аналитика6 КАК Аналитика6,
			|	ВидыОтчетов.КоличествоАналитик КАК МаксАналитикОтчета
			|ИЗ
			|	Документ.НастраиваемыйОтчет КАК НастраиваемыйОтчет
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
			|		ПО НастраиваемыйОтчет.ВидОтчета = ВидыОтчетов.Ссылка
			|ГДЕ
			|	НастраиваемыйОтчет.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрыРасчета.Источник);
		ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
		Если НЕ ВыборкаЗапроса.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;
		
		ДанныеИсточника = Новый Структура("Ссылка, ВидОтчета, Сценарий, Организация, Проект, Валюта, МаксАналитикОтчета, ПериодОтчета, ПериодОкончания, МаксАналитикОтчета");
		ЗаполнитьЗначенияСвойств(ДанныеИсточника, ВыборкаЗапроса);
	
		Для Сч = 1 По ВыборкаЗапроса.МаксАналитикОтчета Цикл
			ДанныеИсточника.Вставить("Аналитика" + Сч, ВыборкаЗапроса["Аналитика" + Сч]);
		КонецЦикла;
		
	ИначеЕсли ЭтоАдресВременногоХранилища(ПараметрыРасчета.Источник) Тогда
		
		ДанныеИсточника = ПолучитьИзВременногоХранилища(ПараметрыРасчета.Источник);
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Неизвестный источник копирования показателей'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов", , , ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
	
	ДанныеИсточника.Вставить("ИдентификаторСеанса", УникальныйИдентификаторСеанса);
		
	ДанныеПериодОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИсточника.ПериодОтчета, "ДатаНачала, Периодичность");
	ДатаОкончания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИсточника.ПериодОкончания, "ДатаОкончания");
	ДанныеИсточника.Вставить("МассивПериодов", ПериодыУХ.ПолучитьПодчиненныеПериоды(ДанныеПериодОтчета.ДатаНачала, ДатаОкончания, ДанныеПериодОтчета.Периодичность));
	
	РаскрываемыеАналитики = Новый Структура("АналитикаВалюта");
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		РаскрываемыеАналитики.Вставить("Аналитика" + Сч);
	КонецЦикла;
	
	ИзменениеКлючевогоРеквизита = мОбъектРасчета.Ссылка = ДанныеИсточника.Ссылка;
	
	тЗначенияПоказателей = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(ДанныеИсточника, РаскрываемыеАналитики, Новый Структура("ИдентификаторСеанса", УникальныйИдентификаторСеанса));
		
	тЗначенияКомментариев = ПолучитьЗначенияКомментариев(ДанныеИсточника, ИзменениеКлючевогоРеквизита);
	
	Если тЗначенияПоказателей.Количество() = 0
		И тЗначенияКомментариев.Количество() = 0 Тогда
		// Нет значений показателей
		Возврат Истина;
	КонецЕсли;
	
	ТекстАналитики = "";
	Для Сч = 1 По ДанныеИсточника.МаксАналитикОтчета Цикл
		ТекстАналитики = ТекстАналитики + "Аналитика" + Сч + ", ";
	КонецЦикла;
	
	ИзмененПериодОтчета = мОбъектРасчета.ПериодОтчета <> ДанныеИсточника.ПериодОтчета;
	ПриемникМассивПериодов = ПериодыУХ.ПолучитьПодчиненныеПериоды(
		мОбъектРасчета.ПериодОтчета, мОбъектРасчета.ПериодОкончания);
	
	СтрокиКУдалению = Новый Массив();
	
	// Меняем данные ключевого среза
	тЗначенияПоказателей.Колонки.Найти("ПоказательОтчета").Имя = "Показатель";
	Для Каждого СтрТаблицы Из тЗначенияПоказателей Цикл
		
		ЗаполнитьЗначенияСвойств(СтрТаблицы, мОбъектРасчета,
			ТекстАналитики + "Сценарий, Организация, Проект");
		
		Если ИзмененПериодОтчета Тогда
			ИндексИсточника = ДанныеИсточника.МассивПериодов.Найти(СтрТаблицы.ПериодыСвязанныйПериод);
			Если ИндексИсточника <= ПриемникМассивПериодов.ВГраница() Тогда
				СтрТаблицы.ПериодОтчета = ПриемникМассивПериодов[ИндексИсточника];
			Иначе
				СтрокиКУдалению.Добавить(СтрТаблицы);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокиКУдалению.Количество() > 0 Тогда
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			тЗначенияПоказателей.Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	// Начнем транзакцию, если необходимо
	Результат = Истина;
	СозданаТранзакция = Не ТранзакцияАктивна();
	Если СозданаТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	// Очищаем версии прошлого ключевого среза
	УправлениеРасчетомПоказателей.ОчиститьЛогИзмененныхПоказателей(УникальныйИдентификаторСеанса);
	Если ИзменениеКлючевогоРеквизита Тогда
		// Изменен ключевой срез существующего экземпляра отчетов
		Результат = УправлениеРасчетомПоказателей.ОчиститьСтарыеДанные(ДанныеИсточника, Истина, Ложь, Ложь);
	КонецЕсли;

	// Записываем новые значения комментариев
	Если Результат И тЗначенияКомментариев.Количество() > 0 Тогда
		НаборЗаписей = РегистрыСведений.ЛогИзмененныхКомментариевПоказателейОтчетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.УникальныйИдентификаторСеанса.Установить(УникальныйИдентификаторСеанса);
		НомерЗаписи = 1;
		ПравилоОбработки = мОбъектРасчета.ПравилоОбработки;
		Если НЕ ЗначениеЗаполнено(ПравилоОбработки) Тогда
			ПравилоОбработки = Документы.НастраиваемыйОтчет.ЗначениеНастройкиОбработкиДокумента(мОбъектРасчета, "ПравилоОбработки");
		КонецЕсли;
		Для Каждого СтрТаблицы Из тЗначенияКомментариев Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.УникальныйИдентификаторСеанса = УникальныйИдентификаторСеанса;
			НоваяЗапись.НомерТранзакции = 0;
			НоваяЗапись.НомерЗаписи = НомерЗаписи;
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрТаблицы);
			ЗаполнитьЗначенияСвойств(НоваяЗапись, мОбъектРасчета,
				ТекстАналитики + "Сценарий, Организация, Проект");
			НоваяЗапись.Валюта = мОбъектРасчета.ОсновнаяВалюта;
			НоваяЗапись.ПравилоОбработки = ПравилоОбработки;
			НомерЗаписи = НомерЗаписи + 1;
		КонецЦикла;
		Попытка
			НаборЗаписей.Записать();
		Исключение
			Результат = Ложь;
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ТекстСообщения = НСтр("ru = 'Не удалось выполнить запись комментариев измененных показателей по причине:
				|%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекстОшибки);
			ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("РасчетИЗаписьПоказателей.МодульОбъекта.ВыполнитьИзменениеКлючевогоСрезаЗначенийПоказателейОтчетов", , , ТекстСообщения, ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	// Записываем новые значения показателей
	Если Результат Тогда
		АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(тЗначенияПоказателей);
		ПараметрыРасчета.Вставить("СпособФормированияОтчета", Перечисления.СпособыФормированияОтчетов.КопированиеЗначений);
		Результат = ВыполнитьДобавлениеЗначенийИзмененныхПоказателиВЛог(мОбъектРасчета, ПараметрыРасчета);
	КонецЕсли;
	
	Если СозданаТранзакция Тогда
		Если Результат Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначенияКомментариев(ДанныеИсточника, ДанныеВерсий = Истина)
	
	// Получим комментарии источника
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеКлючевогоСреза.НомерТранзакции + 10000000000 КАК НомерТранзакции,
		|	ДанныеКлючевогоСреза.ПериодОтчета КАК ПериодОтчета,
		|	ДанныеКлючевогоСреза.Показатель КАК Показатель,
		|	ДанныеКлючевогоСреза.Аналитика1 КАК Аналитика1,
		|	ДанныеКлючевогоСреза.Аналитика2 КАК Аналитика2,
		|	ДанныеКлючевогоСреза.Аналитика3 КАК Аналитика3,
		|	ДанныеКлючевогоСреза.Аналитика4 КАК Аналитика4,
		|	ДанныеКлючевогоСреза.Аналитика5 КАК Аналитика5,
		|	ДанныеКлючевогоСреза.Аналитика6 КАК Аналитика6,
		|	ДанныеКлючевогоСреза.АналитикаВалюта КАК АналитикаВалюта,
		|	ДанныеКлючевогоСреза.Значение КАК Значение
		|ПОМЕСТИТЬ втВсеКомментарии
		|ИЗ
		|	РегистрСведений.ЛогИзмененныхКомментариевПоказателейОтчетов КАК ДанныеКлючевогоСреза
		|ГДЕ
		|	ДанныеКлючевогоСреза.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса
		|	И ДанныеКлючевогоСреза.Показатель.Владелец = &ВидОтчета
		|	И ДанныеКлючевогоСреза.Сценарий = &Сценарий
		|	И ДанныеКлючевогоСреза.Организация = &Организация
		|	И ДанныеКлючевогоСреза.ПериодОтчета В(&МассивПериодов)
		|	И ДанныеКлючевогоСреза.Проект = &Проект
		|	И ДанныеКлючевогоСреза.Валюта = &Валюта
		|	И &ТекстОтборАналитики";
	
	Если ДанныеВерсий Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияУХ.ОбъединениеПакетаЗапросов() +
			"ВЫБРАТЬ
			|	ЗначенияПоказателей.Версия.Код КАК НомерТранзакции,
			|	ЗначенияПоказателей.Версия.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЗначенияПоказателей.Комментарий КАК Значение
			|ИЗ
			|	РегистрСведений.КомментарииЗначенийПоказателей КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииЗначенийПоказателей КАК ДанныеКлючевогоСреза
			|		ПО ЗначенияПоказателей.Версия = ДанныеКлючевогоСреза.Ссылка
			|ГДЕ
			|	ДанныеКлючевогоСреза.ВидОтчета = &ВидОтчета
			|	И ДанныеКлючевогоСреза.Организация = &Организация
			|	И ДанныеКлючевогоСреза.ПериодОтчета В(&МассивПериодов)
			|	И ДанныеКлючевогоСреза.Сценарий = &Сценарий
			|	И ДанныеКлючевогоСреза.Проект = &Проект
			|	И ДанныеКлючевогоСреза.Валюта = &Валюта
			|	И &ТекстОтборАналитики";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст
		+ ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	втВсеКомментарии.ПериодОтчета КАК ПериодОтчета,
		|	втВсеКомментарии.Показатель КАК Показатель,
		|	втВсеКомментарии.Аналитика1 КАК Аналитика1,
		|	втВсеКомментарии.Аналитика2 КАК Аналитика2,
		|	втВсеКомментарии.Аналитика3 КАК Аналитика3,
		|	втВсеКомментарии.Аналитика4 КАК Аналитика4,
		|	втВсеКомментарии.Аналитика5 КАК Аналитика5,
		|	втВсеКомментарии.Аналитика6 КАК Аналитика6,
		|	втВсеКомментарии.АналитикаВалюта КАК АналитикаВалюта,
		|	МАКСИМУМ(втВсеКомментарии.НомерТранзакции) КАК НомерТранзакции
		|ПОМЕСТИТЬ втПоследниеКомментарии
		|ИЗ
		|	втВсеКомментарии КАК втВсеКомментарии
		|
		|СГРУППИРОВАТЬ ПО
		|	втВсеКомментарии.ПериодОтчета,
		|	втВсеКомментарии.Показатель,
		|	втВсеКомментарии.Аналитика1,
		|	втВсеКомментарии.Аналитика2,
		|	втВсеКомментарии.Аналитика3,
		|	втВсеКомментарии.Аналитика4,
		|	втВсеКомментарии.Аналитика5,
		|	втВсеКомментарии.Аналитика6,
		|	втВсеКомментарии.АналитикаВалюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втВсеКомментарии.ПериодОтчета КАК ПериодОтчета,
		|	втВсеКомментарии.Показатель КАК Показатель,
		|	втВсеКомментарии.Аналитика1 КАК Аналитика1,
		|	втВсеКомментарии.Аналитика2 КАК Аналитика2,
		|	втВсеКомментарии.Аналитика3 КАК Аналитика3,
		|	втВсеКомментарии.Аналитика4 КАК Аналитика4,
		|	втВсеКомментарии.Аналитика5 КАК Аналитика5,
		|	втВсеКомментарии.Аналитика6 КАК Аналитика6,
		|	втВсеКомментарии.АналитикаВалюта КАК АналитикаВалюта,
		|	втВсеКомментарии.Значение КАК Значение
		|ИЗ
		|	втВсеКомментарии КАК втВсеКомментарии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПоследниеКомментарии КАК втПоследниеКомментарии
		|		ПО втВсеКомментарии.НомерТранзакции = втПоследниеКомментарии.НомерТранзакции
		|			И втВсеКомментарии.ПериодОтчета = втПоследниеКомментарии.ПериодОтчета
		|			И втВсеКомментарии.Показатель = втПоследниеКомментарии.Показатель
		|			И втВсеКомментарии.Аналитика1 = втПоследниеКомментарии.Аналитика1
		|			И втВсеКомментарии.Аналитика2 = втПоследниеКомментарии.Аналитика2
		|			И втВсеКомментарии.Аналитика3 = втПоследниеКомментарии.Аналитика3
		|			И втВсеКомментарии.Аналитика4 = втПоследниеКомментарии.Аналитика4
		|			И втВсеКомментарии.Аналитика5 = втПоследниеКомментарии.Аналитика5
		|			И втВсеКомментарии.Аналитика6 = втПоследниеКомментарии.Аналитика6
		|			И втВсеКомментарии.АналитикаВалюта = втПоследниеКомментарии.АналитикаВалюта";
	
	Запрос.УстановитьПараметр("ВидОтчета", ДанныеИсточника.ВидОтчета);
	Запрос.УстановитьПараметр("Организация", ДанныеИсточника.Организация);
	Запрос.УстановитьПараметр("МассивПериодов", ДанныеИсточника.МассивПериодов);
	Запрос.УстановитьПараметр("Проект", ДанныеИсточника.Проект);
	Запрос.УстановитьПараметр("Сценарий", ДанныеИсточника.Сценарий);
	Запрос.УстановитьПараметр("Валюта", ДанныеИсточника.Валюта);
	Запрос.УстановитьПараметр("УникальныйИдентификаторСеанса", УникальныйИдентификаторСеанса);
	
	ТекстОтборАналитики = "ИСТИНА";
	Для Сч = 1 По ДанныеИсточника.МаксАналитикОтчета Цикл
		ТекстОтборАналитики = ТекстОтборАналитики + "
		|	И ДанныеКлючевогоСреза.Аналитика" + Сч + " = &Аналитика" + Сч;
		Запрос.УстановитьПараметр("Аналитика" + Сч, ДанныеИсточника["Аналитика" + Сч]);
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстОтборАналитики", ТекстОтборАналитики);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти


#Область ФакторныйАнализ

Функция ВыполнитьРасчетВлиянияФакторов(тЦелевыеПоказатели, тПоказателиФакторов, ПараметрыРасчета)
	
	Если ПараметрыРасчета.ВидРасчета = "ПоИзмененнымПоЦелевымПоДаннымДляПересчета" Тогда
		
		// Подготовим данные для пересчета
		ДанныеДляПересчета = ДанныеДляПересчетаРазбитыеПоУправлениюПериодомСценарием();
		Если ДанныеДляПересчета = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ДанныеДляПересчетаЧислоСтрок = ДанныеДляПересчета.Количество()-1;
		
	КонецЕсли;
	
	// Структура для раскрытия аналитик
	РаскрываемыеАналитики = Новый Структура;
	Для Сч = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		РаскрываемыеАналитики.Вставить("Аналитика" + Сч);
	КонецЦикла;
	РаскрываемыеАналитики.Вставить("АналитикаВалюта");

	// Получим данные целевого показателя, он всегда должен быть один
	СтрокаЦелевыеПоказатели = тЦелевыеПоказатели.Получить(0); 
	СтруктураОтбораЦелевых = СтруктураДляОтбораПоСтрокеТаблицы(СтрокаЦелевыеПоказатели);
	ЦелевоеЗначение = СтрокаЦелевыеПоказатели.Значение;
	
	// Выполняем расчет
	Для Каждого СтрокаТаблицы Из тПоказателиФакторов Цикл
		
		ЗначениеИсходное = СтрокаТаблицы.Значение;
		Если ЗначениеИсходное = 0 Тогда
			// Нечисловой или нулевой показатель
			Продолжить;
		КонецЕсли;
		
		// Получим таблицу факторов в разрезе всех аналитик
		СтруктураПараметровОтбора = СтруктураДляОтбораПоСтрокеТаблицы(СтрокаТаблицы);
		СтруктураПараметровОтбора.Вставить("ПоказательОтчета", СтрокаТаблицы.Показатель);
		Если ЗначениеЗаполнено(ПараметрыРасчета.ВалютаИзмененныхПоказателей) Тогда
			СтруктураПараметровОтбора.Вставить("Валюта", ПараметрыРасчета.ВалютаИзмененныхПоказателей);
		КонецЕсли;
		тЗначенияФакторовПоАналитикам = СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей(СтруктураПараметровОтбора, РаскрываемыеАналитики);
		Если тЗначенияФакторовПоАналитикам = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		тЗначенияФакторовПоАналитикам.Колонки.Удалить(тЗначенияФакторовПоАналитикам.Колонки.Найти("Показатель"));
		тЗначенияФакторовПоАналитикам.Колонки.Найти("ПоказательОтчета").Имя = "Показатель";
		тЗначенияФакторовПоАналитикам.Колонки.Добавить("ПравилоОбработки");
			
		// Получим общую сумму по всем аналитикам
		тСуммаПоАналитикам = тЗначенияФакторовПоАналитикам.Скопировать(,"Значение");
		тСуммаПоАналитикам.Свернуть(,"Значение");
		Если тСуммаПоАналитикам.Количество() = 1 Тогда 
			СуммаПоАналитикам = тСуммаПоАналитикам.Получить(0).Значение;
		Иначе
			СуммаПоАналитикам = 0;
		КонецЕсли;
		
		// Проверим, что рассчитанные данные имеются
		Если СуммаПоАналитикам = 0 Тогда
			СтрокаТаблицы.Градиент = 0;
			СтрокаТаблицы.Влияние = 0;
			Продолжить;
		КонецЕсли;
		
		// Увеличим значения на шаг расчета
		ШагРасчета = ЗначениеИсходное * 0.1;
		ШагРасчета = ?(ШагРасчета < 0, -1 * ШагРасчета, ШагРасчета);
		Для Каждого СтрокаТаблицыПоАналитикам Из тЗначенияФакторовПоАналитикам Цикл
			СтрокаТаблицыПоАналитикам.Значение = СтрокаТаблицыПоАналитикам.Значение * ШагРасчета / СуммаПоАналитикам;
		КонецЦикла;
			
		// Выполним пересчет зависимых показателей
		Если ПараметрыРасчета.ВидРасчета = "ПоИзмененнымПоЦелевымПоДаннымДляПересчета" Тогда
			
			// Инициируем менеджер временных таблиц
			МенеджерВременныхТаблиц = ЗагрузитьЛогИзмененныхПоказателейВМенеджерВТ();
			
			///////////////////////////////////////////////////////
			// Поместим новые значения в лог измененных показателей
			ВидОтчета = ПолучитьЗначениеРеквизитаОбъекта(СтрокаТаблицы.Показатель, "Владелец");
			
			ИнициализироватьОбъектРасчета();
			ОбъектРасчета.ВидОтчета = ВидОтчета; 
			ОбъектРасчета.тИзмененныеПоказатели = тЗначенияФакторовПоАналитикам;
			Если ЗначениеЗаполнено(СтрокаТаблицы.ПериодОтчета) Тогда
				Если ТипЗнч(СтрокаТаблицы.ПериодОтчета) = Тип("СправочникСсылка.Периоды") Тогда
					ОбъектРасчета.ПериодОтчета = СтрокаТаблицы.ПериодОтчета;
					ОбъектРасчета.ПериодОкончания = СтрокаТаблицы.ПериодОтчета;
				ИначеЕсли ТипЗнч(СтрокаТаблицы.ПериодОтчета) = Тип("Массив") Тогда
					ОбъектРасчета.ПериодОтчета = СтрокаТаблицы.ПериодОтчета.Получить(0);
					ОбъектРасчета.ПериодОкончания = СтрокаТаблицы.ПериодОтчета.Получить(СтрокаТаблицы.ПериодОтчета.Количество()-1);
				КонецЕсли;
			КонецЕсли;
			Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, СтрокаТаблицы, ПараметрыРасчета) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			// Добавим показатели в лог
			Если НЕ ДобавитьИзмененныеПоказателиВЛог() Тогда
				Возврат Ложь;
			КонецЕсли;
			
			///////////////////////////////////////////////////////
			// Найдем номер первой строки для пересчета
			Для ДанныеДляПересчетаНачальнаяСтрока = 0 По ДанныеДляПересчетаЧислоСтрок Цикл
				Если ДанныеДляПересчета.Получить(ДанныеДляПересчетаНачальнаяСтрока).ВидОтчета = ВидОтчета Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Добавим показатель в исключения расчета
			мПоказателиИсключения = Новый Массив;
			мПоказателиИсключения.Добавить(СтрокаТаблицы.Показатель);
			
			///////////////////////////////////////////////////////
			// Выполним пересчет по данным для пересчета
			Для Сч = ДанныеДляПересчетаНачальнаяСтрока По ДанныеДляПересчетаЧислоСтрок Цикл
				
				ИнициализироватьОбъектРасчета();
				Если Не ПодготовитьОбъектРасчета(МенеджерВременныхТаблиц, ДанныеДляПересчета.Получить(Сч), ПараметрыРасчета) Тогда
					Возврат Ложь;
				КонецЕсли;

				// Выполним расчет по правилу расчета
				Если Не РассчитатьПоПравилуРасчета(мПоказателиИсключения) Тогда
					Возврат Ложь;
				КонецЕсли;
				
			КонецЦикла;
			
			тРассчитанныеПоказатели = МенеджерВременныхТаблиц.Таблицы.Найти("втЛогИзмененныхПоказателей").ПолучитьДанные().Выгрузить();
			
		Иначе
			АдресТаблицыИзмененныхПоказателей = ПоместитьВоВременноеХранилище(тЗначенияФакторовПоАналитикам);
			Если НЕ ВыполнитьРасчетЗависимыхПоказателей(ПараметрыРасчета) Тогда
				Возврат Ложь;
			КонецЕсли;
			тРассчитанныеПоказатели = ПолучитьИзВременногоХранилища(АдресТаблицыРассчитанныхПоказателей);
		КонецЕсли;
		
		// Обработаем результат
		тРассчитанныеПоказателиОтборПоЦелевому = тРассчитанныеПоказатели.Скопировать(СтруктураОтбораЦелевых);
		тРассчитанныеПоказателиОтборПоЦелевому.Свернуть(,"Значение");
		Если тРассчитанныеПоказателиОтборПоЦелевому.Количество() Тогда
			
			СтрокаРассчитанныеПоказатели = тРассчитанныеПоказателиОтборПоЦелевому.Получить(0);
			ШагЦелевоеЗначение = СтрокаРассчитанныеПоказатели.Значение;
			КоэффГрадиента = Pow(10,Окр(Log10(ШагРасчета),0,РежимОкругления.Окр15как10)); 
			
			СтрокаТаблицы.Градиент = ШагЦелевоеЗначение*КоэффГрадиента/ШагРасчета;
			Влияние = Окр((ШагЦелевоеЗначение/ЦелевоеЗначение/0.1),2);
			СтрокаТаблицы.Влияние = ?(Влияние < 0, -1 * Влияние, Влияние);
			СтрокаТаблицы.КоэффГрадиента = КоэффГрадиента;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СтруктураДляОтбораПоСтрокеТаблицы(СтрокаТаблицы)

	СтруктураОтбора = Новый Структура;
	
	// Показатель
	Если ЗначениеЗаполнено(СтрокаТаблицы.Показатель) Тогда
		СтруктураОтбора.Вставить("Показатель", СтрокаТаблицы.Показатель);
	КонецЕсли;
	
	// Ключевые срезы
	Если ЗначениеЗаполнено(СтрокаТаблицы.Организация) Тогда
		СтруктураОтбора.Вставить("Организация", СтрокаТаблицы.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТаблицы.ПериодОтчета) Тогда
		СтруктураОтбора.Вставить("ПериодОтчета", СтрокаТаблицы.ПериодОтчета);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТаблицы.Сценарий) Тогда
		СтруктураОтбора.Вставить("Сценарий", СтрокаТаблицы.Сценарий);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТаблицы.Проект) Тогда
		СтруктураОтбора.Вставить("Проект", СтрокаТаблицы.Проект);
	КонецЕсли;
	
	// Ключевые срезы по аналитикам
	ДанныеДляРасчетов = Новый Структура;
	ДанныеДляРасчетов.Вставить("ВидОтчета", ПолучитьЗначениеРеквизитаОбъекта(СтрокаТаблицы.Показатель, "Владелец"));
	ДобавитьДанныеВидаОтчета(ДанныеДляРасчетов);
	Для Сч = 1 По ДанныеДляРасчетов.МаксКлючевыхАналитик Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы["Аналитика" + Сч]) Тогда
			СтруктураОтбора.Вставить("Аналитика" + Сч, СтрокаТаблицы["Аналитика" + Сч]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураОтбора;
	
КонецФункции

#КонецОбласти


#Область ЗаписьПоказателей

Функция СтандартныйРежимЗаписи()

	Если Регистратор = Неопределено
		ИЛИ ТипЗнч(Регистратор) = Тип("ДокументСсылка.НастраиваемыйОтчет") Тогда
		// Стандартный режим записи
		Возврат Истина;
	КонецЕсли;
	
	// Запись из прочих документов
	// В этому случае всегда пишутся дельты значений в одну уникальную версию
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьОписаниеВерсии(СтруктураРасчета)
	
	Если НЕ СтруктураРасчета.СохранятьИсториюИзменений 
		ИЛИ НЕ СтандартныйРежимЗаписи() Тогда
		
		// Ищем существующий элемент описания версии
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ОписаниеВерсий.Ссылка
			|ИЗ
			|	Справочник.ОписаниеВерсий КАК ОписаниеВерсий
			|ГДЕ
			|	НЕ ОписаниеВерсий.ПометкаУдаления
			|	И ОписаниеВерсий.Организация = &Организация
			|	И ОписаниеВерсий.ВидОтчета = &ВидОтчета
			|	И ОписаниеВерсий.УправлениеПериодом = &УправлениеПериодом
			|	И ОписаниеВерсий.Проект = &Проект
			|	И НЕ ОписаниеВерсий.ЧерноваяВерсия";
		
		Запрос.УстановитьПараметр("Организация",		СтруктураРасчета.Организация);
		Запрос.УстановитьПараметр("ВидОтчета",			СтруктураРасчета.ВидОтчета);
		Запрос.УстановитьПараметр("УправлениеПериодом",	СтруктураРасчета.УправлениеПериодом);
		Запрос.УстановитьПараметр("Проект",				СтруктураРасчета.Проект);
	
		Для Индекс = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			
			Если СтруктураРасчета.Свойство("Аналитика" + Индекс) Тогда
				Запрос.УстановитьПараметр("Аналитика" + Индекс, СтруктураРасчета["Аналитика" + Индекс]);
			Иначе
				Запрос.УстановитьПараметр("Аналитика" + Индекс, Неопределено);
			КонецЕсли;
			
			Запрос.Текст = Запрос.Текст + "
			|	И ОписаниеВерсий.Аналитика" + Индекс + " = &Аналитика" + Индекс;
			
		КонецЦикла;
		
		Если НЕ СтандартныйРежимЗаписи() Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И ОписаниеВерсий.Регистратор = &Регистратор";
			Запрос.УстановитьПараметр("Регистратор", СтруктураРасчета.Регистратор);
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	// Создаем новый элемент описания версии
	ОписаниеВерсии = Справочники.ОписаниеВерсий.СоздатьЭлемент();
	ОписаниеВерсии.ЭкземплярОтчета		= СтруктураРасчета.Регистратор;
	ОписаниеВерсии.Регистратор			= СтруктураРасчета.Регистратор;
	ОписаниеВерсии.Организация			= СтруктураРасчета.Организация;
	ОписаниеВерсии.ВидОтчета			= СтруктураРасчета.ВидОтчета;
	ОписаниеВерсии.УправлениеПериодом	= СтруктураРасчета.УправлениеПериодом;
	ОписаниеВерсии.Проект				= СтруктураРасчета.Проект;
	ОписаниеВерсии.Автор				= СтруктураРасчета.ПоследнийРедактировавший;
	ОписаниеВерсии.ДатаИзмененияMs		= СтруктураРасчета.ДатаИзмененияMs;
	ОписаниеВерсии.РучнаяОперация		= ?(СтруктураРасчета.СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.РучноеЗаполнение, 0, 1);
	ОписаниеВерсии.Дата					= ТекущаяДатаСеанса();
	Для Индекс = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СтруктураРасчета.Свойство("Аналитика"+Индекс, ОписаниеВерсии["Аналитика"+Индекс]);
	КонецЦикла;
	ОписаниеВерсии.Записать();
	
	Возврат ОписаниеВерсии.Ссылка;
		
КонецФункции 

Функция ПолучитьВерсию(СтруктураРасчета, ОписаниеВерсии)
	
	Если НЕ СтруктураРасчета.СохранятьИсториюИзменений 
		ИЛИ НЕ СтандартныйРежимЗаписи() Тогда
		
		// Ищем существующую основную версию
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВерсииЗначенийПоказателей.Ссылка КАК Ссылка,
			|	ВерсииЗначенийПоказателей.ЗаписьВДополнительнойВалюте КАК ЗаписьВДополнительнойВалюте
			|ИЗ
			|	Справочник.ВерсииЗначенийПоказателей КАК ВерсииЗначенийПоказателей
			|ГДЕ
			|	НЕ ВерсииЗначенийПоказателей.ПометкаУдаления
			|	И ВерсииЗначенийПоказателей.Владелец = &Владелец
			|	И ВерсииЗначенийПоказателей.ВидОтчета = &ВидОтчета
			|	И ВерсииЗначенийПоказателей.Организация = &Организация
			|	И ВерсииЗначенийПоказателей.ПериодОтчета = &ПериодОтчета
			|	И ВерсииЗначенийПоказателей.Сценарий = &Сценарий
			|	И ВерсииЗначенийПоказателей.Валюта = &Валюта
			|	И ВерсииЗначенийПоказателей.Проект = &Проект
			|	И НЕ ВерсииЗначенийПоказателей.ЧерноваяВерсия";
				
		Запрос.УстановитьПараметр("Владелец",		ОписаниеВерсии);
		Запрос.УстановитьПараметр("Валюта",			СтруктураРасчета.Валюта);
		Запрос.УстановитьПараметр("Организация",	СтруктураРасчета.Организация);
		Запрос.УстановитьПараметр("ВидОтчета",		СтруктураРасчета.ВидОтчета);
		Запрос.УстановитьПараметр("ПериодОтчета",	СтруктураРасчета.ПериодОтчета);
		Запрос.УстановитьПараметр("Сценарий",		СтруктураРасчета.Сценарий);
		Запрос.УстановитьПараметр("Проект",			СтруктураРасчета.Проект);
		
		Для Индекс = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			
			Если СтруктураРасчета.Свойство("Аналитика" + Индекс) Тогда
				Запрос.УстановитьПараметр("Аналитика" + Индекс, СтруктураРасчета["Аналитика" + Индекс]);
			Иначе
				Запрос.УстановитьПараметр("Аналитика" + Индекс,Неопределено);
			КонецЕсли;
			
			Запрос.Текст = Запрос.Текст + "
			|	И ВерсииЗначенийПоказателей.Аналитика" + Индекс + " = &Аналитика" + Индекс;
			
		КонецЦикла;
		
		Если НЕ СтандартныйРежимЗаписи() Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И ВерсииЗначенийПоказателей.Регистратор = &Регистратор";
			Запрос.УстановитьПараметр("Регистратор", СтруктураРасчета.Регистратор);
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	// Создаем новую версию
	Версия = Справочники.ВерсииЗначенийПоказателей.СоздатьЭлемент();
	Версия.Владелец				= ОписаниеВерсии;
	Версия.ЭкземплярОтчета		= СтруктураРасчета.Регистратор;
	Версия.Регистратор			= СтруктураРасчета.Регистратор;
	Версия.Организация			= СтруктураРасчета.Организация;
	Версия.ВидОтчета			= СтруктураРасчета.ВидОтчета;
	Версия.Валюта				= СтруктураРасчета.Валюта;
	Версия.ПериодОтчета			= СтруктураРасчета.ПериодОтчета;
	Версия.Сценарий				= СтруктураРасчета.Сценарий;
	Версия.Проект				= СтруктураРасчета.Проект;
	Версия.Активность			= Истина;
	Версия.ВидОперации			= СтруктураРасчета.ВидОперации;
	Версия.ОсновнаяВерсия		= НЕ СтруктураРасчета.СохранятьИсториюИзменений;
	Для Индекс = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СтруктураРасчета.Свойство("Аналитика"+Индекс, Версия["Аналитика"+Индекс]);
	КонецЦикла;
	Версия.ЗаписьВДополнительнойВалюте = СтруктураРасчета.Валюта <> СтруктураРасчета.ОсновнаяВалюта;
	Версия.Записать();
	
	Возврат Версия.Ссылка;
	
КонецФункции

Функция ПодготовитьСтруктуруРасчетаДляЗаписиВерсий(СтрокаРасчета)
	
	СтруктураРасчета = Новый Структура;
	
	// Ключевые срезы для поиска и создания версий
	СтруктураРасчета.Вставить("Сценарий");
	СтруктураРасчета.Вставить("Организация");
	СтруктураРасчета.Вставить("УправлениеПериодом");
	СтруктураРасчета.Вставить("Проект");
	СтруктураРасчета.Вставить("ПериодОтчета");
	СтруктураРасчета.Вставить("Валюта");
	
	// Данные регистратора для версий
	СтруктураРасчета.Вставить("Регистратор", Регистратор);
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.Трансляция")
		ИЛИ ТипЗнч(Регистратор) = Тип("ДокументСсылка.ТрансформационнаяКорректировка") Тогда
		СтруктураРасчета.Вставить("ВидОперации", ПолучитьЗначениеРеквизитаОбъекта(Регистратор, "ВидОперации"));
	Иначе
		СтруктураРасчета.Вставить("ВидОперации", Справочники.ВидыОпераций.УчетныеОперации);
	КонецЕсли;
	
	// Для записи реквизитов регистров
	СтруктураРасчета.Вставить("ПравилоОбработки", СтрокаРасчета.ПравилоОбработки);
	СтруктураРасчета.Вставить("СпособФормированияОтчета");
	СтруктураРасчета.Вставить("ИспользуемаяИБ");
	СтруктураРасчета.Вставить("ДатаИзменения", ТекущаяДатаСеанса());
	СтруктураРасчета.Вставить("ДатаИзмененияMs",ТекущаяУниверсальнаяДатаВМиллисекундах());
	СтруктураРасчета.Вставить("ПоследнийРедактировавший",ПараметрыСеанса.ТекущийПользователь);
	
	// Заполняются из запроса по правилу обработки
	СтруктураРасчета.Вставить("ВидОтчета", СтрокаРасчета.ВидОтчета);
	СтруктураРасчета.Вставить("СохранятьИсториюИзменений", СтрокаРасчета.СохранятьИсториюИзменений);
	СтруктураРасчета.Вставить("МаксАналитикОтчета", СтрокаРасчета.МаксАналитикОтчета);
	
	Возврат СтруктураРасчета;
	
КонецФункции

Функция ЗагрузитьЛогКомментариевПоказателейВМенеджерВТ(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияПоказателей.ПравилоОбработки КАК ПравилоОбработки,
		|	ЗначенияПоказателей.Показатель КАК Показатель,
		|	ЗначенияПоказателей.Сценарий КАК Сценарий,
		|	ЗначенияПоказателей.Организация КАК Организация,
		|	ЗначенияПоказателей.Проект КАК Проект,
		|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
		|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
		|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
		|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
		|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
		|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
		|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
		|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
		|	ЗначенияПоказателей.Валюта КАК Валюта,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	ЗначенияПоказателей.НомерТранзакции КАК НомерТранзакции,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеИнформационныеБазы.ПустаяСсылка) КАК СпособФормированияОтчета,
		|	ЗНАЧЕНИЕ(Перечисление.СпособыФормированияОтчетов.ПустаяСсылка) КАК ИспользуемаяИБ
		|ПОМЕСТИТЬ втЛогКомментариевПоказателей
		|ИЗ
		|	РегистрСведений.ЛогИзмененныхКомментариевПоказателейОтчетов КАК ЗначенияПоказателей
		|ГДЕ
		|	ЗначенияПоказателей.УникальныйИдентификаторСеанса = &УникальныйИдентификаторСеанса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗначенияПоказателей.Показатель КАК Показатель
		|ИЗ
		|	втЛогКомментариевПоказателей КАК ЗначенияПоказателей";
	
	Запрос.УстановитьПараметр("УникальныйИдентификаторСеанса", УникальныйИдентификаторСеанса);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПодготовитьДанныеКомментариевПоказателейДляЗаписи(Запрос, СтруктураДанных)
	
	ТекстАналитики = "
		|	ЗначенияПоказателей.АналитикаВалюта,
		|	ЗначенияПоказателей.Аналитика1,
		|	ЗначенияПоказателей.Аналитика2,
		|	ЗначенияПоказателей.Аналитика3,
		|	ЗначенияПоказателей.Аналитика4,
		|	ЗначенияПоказателей.Аналитика5,
		|	ЗначенияПоказателей.Аналитика6";
			
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеВидовОтчетов.СохранятьИсториюИзменений КАК СохранятьИсториюИзменений,
