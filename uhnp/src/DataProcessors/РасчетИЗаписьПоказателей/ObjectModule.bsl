// Функция - Получает из регистра сведений "ХранилищаПараметрическойНастройкиРасширенный" 
//	структуру для расчета показателей по правилу расчета.
//	Если в регистре сведений нет данных для переданного правила расчета, происходит расчет параметрики расчета
//
// Параметры:
//	ПравилоОбработки		- СправочникСсылка.ПравилаОбработки - Привило обработки для расчета
//	мПоказателиИсключения	- Массив - Массив с показателями, которые исключаются из расчета
//	ТипРасчетаПоказателей	- Число - тип расчета показателей отчетов 
// 
// Возвращаемое значение:
//	 - Структура - Структура для расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляПравилаРасчета(ПравилоОбработки, мПоказателиИсключения = Неопределено, ТипРасчетаПоказателей = 1)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если мПоказателиИсключения = Неопределено Тогда
		ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки["ПоПравилуОбработки" + Строка(ТипРасчетаПоказателей)];
		глТаблицаПересчетаПоказателей = ДанныеИзХранилищаПараметрическойНастройки(ПравилоОбработки, ТипПараметрическойНастройки);
	Иначе
		ТипПараметрическойНастройки = Неопределено;
		глТаблицаПересчетаПоказателей = Неопределено;
	КонецЕсли;
	
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
		
		// Сформируем данные для расчета запросов
		СтруктураРасчетаПоказателей = ПодготовитьТаблицыДляРасчетаПоказателейПоПравилуРасчета(ПравилоОбработки, , , мПоказателиИсключения, ТипРасчетаПоказателей);
		
		Если СтруктураРасчетаПоказателей.тПоказателиОперанды.Количество() > 0 Тогда
		
			// Создадим таблицу показателей
			ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
			
			// Генерация таблицы запросов для получения независимых операндов (0 уровень расчета)
			ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей);
			
			// Генерация таблиц запросов для расчета операндов всех зависимых уровней расчета
			ДобавитьЗапросыПоУровнямРасчета(СтруктураРасчетаПоказателей);

			// Получаем объединенную таблицу потребителей 
			ДобавитьЗапросПоНовымЗначениямПотребителей(СтруктураРасчетаПоказателей);
			
			// Получаем исходные данные потребителей
			ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей);	
			
			// Получаем таблицы с дельтами, относительно исходных данных
			ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей);
			
			// Запишем данные в лог измененных показателей
			ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей);
			ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, Истина);
				
		КонецЕсли;
		
		Если СтруктураРасчетаПоказателей.Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		глТаблицаПересчетаПоказателей = СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
		
		Если ТипПараметрическойНастройки <> Неопределено Тогда
			СохранитьДанныеВХранилищеПараметрическойНастройки(ПравилоОбработки, ТипПараметрическойНастройки, глТаблицаПересчетаПоказателей);
		КонецЕсли;
		
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
	
	Возврат глТаблицаПересчетаПоказателей;
	
КонецФункции

// Функция - Получить структуру расчета показателей по прочим режимам расчета
//
// Параметры:
//	ПравилоОбработки			- Справочник.ПравилаОбработки - Правило обработки, для которого строится параметрика
//	ТипПараметрическойНастройки - Перечисление.ТипПараметрическойНастройки - режим расчета, для которого рассчитывается структура расчета показателей
// 
// Возвращаемое значение:
//	 - ТаблицаЗначений - Таблица со строками этапов расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляПрочихРежимовЗаполнения(ПравилоОбработки, ТипПараметрическойНастройки)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	глТаблицаПересчетаПоказателей = ДанныеИзХранилищаПараметрическойНастройки(ПравилоОбработки, ТипПараметрическойНастройки);
	Если глТаблицаПересчетаПоказателей = Неопределено Тогда
	
		/////////////////////////////////////////////////////////////////
		// Сформируем структуру расчета для построения текстов запросов
		
		// Данные для расчета
		ДанныеДляРасчета = ПолучитьОперандыПоПравилуОбработки(ПравилоОбработки);
		
		СтруктураРасчетаПоказателей							= СтруктураРасчетаПоказателей();
		СтруктураРасчетаПоказателей.ДанныеВидаОтчета		= ДанныеДляРасчета.ДанныеВидаОтчета.Получить(0);
		СтруктураРасчетаПоказателей.МаксКлючевыхАналитик	= СтруктураРасчетаПоказателей.ДанныеВидаОтчета.МаксКлючевыхАналитик;
		
		ПоляСвертки = "Потребитель, ИндексРегистраПотребителя, ЕстьАналитикаВалюта, ПересчитыватьВалютнуюСумму, ВидКурса, НеФинансовый";
		Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
			ПоляСвертки = ПоляСвертки + ", НомерАналитикиВГО";
		КонецЕсли;
		
		тДанныеДляРасчетов = ДанныеДляРасчета.тДанныеДляРасчетов.СкопироватьКолонки(ПоляСвертки);
		Для Каждого СтрокаРасчета Из ДанныеДляРасчета.тДанныеДляРасчетов Цикл
			Если СтрокаРасчета.ТипРасчетаПоказателя < 3 И НЕ СтрокаРасчета.НеСуммируется Тогда
				Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация 
					И СтрокаРасчета.ВнутриГрупповой = Ложь Тогда
					Продолжить;
				КонецЕсли;
				НСтрока = тДанныеДляРасчетов.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, СтрокаРасчета);
			КонецЕсли;
		КонецЦикла;
		тДанныеДляРасчетов.Свернуть(ПоляСвертки);

		Если тДанныеДляРасчетов.Количество() > 0 Тогда
	
			// Добавим отборы версий для текущего среза
			ДобавитьОтборыПоКлючевымСрезам(СтруктураРасчетаПоказателей, ТипПараметрическойНастройки);
			тКэшГруппОтборовПоказателей = СтруктураРасчетаПоказателей.тКэшГруппОтборовПоказателей;
			
			Для Каждого СтрРасчета Из тДанныеДляРасчетов Цикл
				
				ИндексРегистраПотребителя = СтрРасчета.ИндексРегистраПотребителя;
				Если ИндексРегистраПотребителя = 0 И СтрРасчета.ЕстьАналитикаВалюта Тогда
					ИндексРегистраПотребителя = -2;
				КонецЕсли;
				
				// Добавим отборы
				Если ТипПараметрическойНастройки = Перечисления.ТипПараметрическойНастройки.Элиминация Тогда
					
					Если СтрРасчета.НомерАналитикиВГО = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					ХешГруппыОтборов = Строка(ИндексРегистраПотребителя) + "@" + Строка(СтрРасчета.НомерАналитикиВГО);
					
				Иначе
					ХешГруппыОтборов = ИндексРегистраПотребителя;
				КонецЕсли;
				
				НСтрокаКэш = тКэшГруппОтборовПоказателей.Найти(ИндексРегистраПотребителя, "ИндексРегистра");
				Если НСтрокаКэш = Неопределено Тогда
					
					НСтрокаКэш = тКэшГруппОтборовПоказателей.Добавить(); 
					НСтрокаКэш.ХешГруппыОтборов = ХешГруппыОтборов;
					НСтрокаКэш.УИДГруппыОтборов = тКэшГруппОтборовПоказателей.Количество();
					НСтрокаКэш.УИДГруппыОтборовВерсии = 1;
					НСтрокаКэш.ИндексРегистра = ИндексРегистраПотребителя;
					НСтрокаКэш.Показатели = Новый Массив;
			
				КонецЕсли;
				НСтрокаКэш.Показатели.Добавить(СтрРасчета.Потребитель);
			
				// Добавим в таблицу показателей 
				НСтр = СтруктураРасчетаПоказателей.тПоказателиОперанды.Добавить();
				ЗаполнитьЗначенияСвойств(НСтр, СтрРасчета);
				
				// Добавим признак использования аналитики валюта
				СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик = Макс(СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик, ИндексРегистраПотребителя);
				
				// Заполним данные для пересчета значений в валюты
				Если Не СтрРасчета.НеФинансовый Тогда
					Если СтрРасчета.ВидКурса = Перечисления.ВидыКурсов.ЗначениеУказанноеВДокументе Тогда
						СтруктураРасчетаПоказателей.ЕстьВидКурсаЗначениеУказанноеВДокументе = Истина;
					ИначеЕсли СтрРасчета.ВидКурса = Перечисления.ВидыКурсов.КурсНаМоментНачисления Тогда
						СтруктураРасчетаПоказателей.ЕстьВидКурсаКурсНаМоментНачисления = Истина;
					Иначе
						СтруктураРасчетаПоказателей.ЕстьВидКурсаПрочее = Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если СтрРасчета.ЕстьАналитикаВалюта Тогда
					СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта = Истина;
					Если СтрРасчета.ПересчитыватьВалютнуюСумму Тогда
						СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			// Добавим аналитики
			Для СчАналитик = СтруктураРасчетаПоказателей.МаксКлючевыхАналитик + 1 По СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик Цикл
				НСтр				= СтруктураРасчетаПоказателей.тИспользуемыеАналитики.Добавить();
				НСтр.УровеньРасчета	= 0;
				НСтр.Поле			= "Аналитика" + СчАналитик;
			КонецЦикла;
			Если СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта Тогда
				НСтр				= СтруктураРасчетаПоказателей.тИспользуемыеАналитики.Добавить();
				НСтр.УровеньРасчета	= 0;
				НСтр.Поле			= "АналитикаВалюта";
			КонецЕсли;
			
			// Добавим ресурсы 
			НСтр = СтруктураРасчетаПоказателей.тИспользуемыеРесурсы.Добавить();
			НСтр.УровеньРасчета = 0;
			НСтр.Поле = "Значение";
			НСтр.Суммируется = Истина;
			НСтр.ВыводитсяВОтчет = Истина;
			СтруктураРасчетаПоказателей.ЕстьЗначение = Истина;
			
			// Создадим таблицу показателей
			ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
			
			// Получаем исходные данные потребителей по массиву организаций
			ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей, "втЗначенияПотребителейРасчет", ТипПараметрическойНастройки);
			
			// Получаем исходные данные потребителей текущего отчета
			ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей);
			
			// Получаем таблицы с дельтами, относительно исходных данных
			ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей);
			
			// Запишем данные в лог измененных показателей
			ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей);
			ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, Истина);
			
		КонецЕсли;
		
		Если СтруктураРасчетаПоказателей.Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		глТаблицаПересчетаПоказателей = СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
		СохранитьДанныеВХранилищеПараметрическойНастройки(ПравилоОбработки, ТипПараметрическойНастройки, глТаблицаПересчетаПоказателей);
		
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;

	Возврат глТаблицаПересчетаПоказателей;

КонецФункции

// Функция - Получить структуру для установки новых значений показателей
//
// Параметры:
//	ОбъектРасчета - Структура - Структура с данными для расчета 
// 
// Возвращаемое значение:
//	 - ТаблицаЗначений - Таблица со строками этапов расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляУстановкиЗначенийВЛог(ОбъектРасчета)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Инициализируем служебные таблицы 
	СтруктураРасчетаПоказателей = СтруктураРасчетаПоказателей();
	СтруктураРасчетаПоказателей.ДанныеВидаОтчета = ОбъектРасчета.ДанныеВидаОтчета;
	СтруктураРасчетаПоказателей.МаксКлючевыхАналитик = ОбъектРасчета.МаксАналитикОтчета;
	
	Если ОбъектРасчета.тИзмененныеПоказатели.Количество() = 0 Тогда
		Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	КонецЕсли;
	
	тВсеПоказатели = ОбъектРасчета.тИзмененныеПоказатели.Скопировать(,"Показатель");
	тВсеПоказатели.Свернуть("Показатель");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаксКлючевыхАналитик", ОбъектРасчета.МаксАналитикОтчета);
	Запрос.УстановитьПараметр("ВсеПоказатели",тВсеПоказатели.ВыгрузитьКолонку("Показатель"));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0)) + &МаксКлючевыхАналитик КАК МаксИспользуемыхАналитик,
		|	МАКСИМУМ(ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ)) КАК ЕстьАналитикаВалюта,
		|	МАКСИМУМ(ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ) И ПоказателиОтчетов.ПересчитыватьВалютнуюСумму) КАК ЕстьЗначениеВалюта,
		|	МАКСИМУМ(ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)) КАК ЕстьЗначение,
		|	МАКСИМУМ(ПоказателиОтчетов.ТипЗначения <> ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)) КАК ЕстьЗначениеНечисловое,
		|	МАКСИМУМ(НЕ ПоказателиОтчетов.НеФинансовый
		|			И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе)) КАК ЕстьВидКурсаЗначениеУказанноеВДокументе,
		|	МАКСИМУМ(НЕ ПоказателиОтчетов.НеФинансовый
		|			И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления)) КАК ЕстьВидКурсаКурсНаМоментНачисления,
		|	МАКСИМУМ(НЕ ПоказателиОтчетов.НеФинансовый
		|			И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления)
		|			И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе)) КАК ЕстьВидКурсаПрочее
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ПО ПоказателиОтчетов.ГруппаРаскрытия = ГруппыРаскрытия.Ссылка
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка В(&ВсеПоказатели)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	КонецЕсли;
	
	ВыборкаЗапроса = Результат.Выбрать();
	ВыборкаЗапроса.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураРасчетаПоказателей, ВыборкаЗапроса);
	СтруктураРасчетаПоказателей.Вставить("РасчетПоИзмененнымПоказателям", Истина);
	
	ИндексироватьПоСценарию = ЗначениеЗаполнено(ОбъектРасчета.УточнениеСпособаФормированияОтчета)
		И ТипЗнч(ОбъектРасчета.УточнениеСпособаФормированияОтчета) = Тип("СправочникСсылка.Сценарии");
	
	Если ИндексироватьПоСценарию Тогда
				
		СтруктураРасчетаПоказателей.Вставить("ЕстьЗначениеНечисловое", Ложь);
			
		// Получим таблицу потребителей
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ПоказателиОтчетов.Ссылка КАК Потребитель,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик = 0
			|				И ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ)
			|			ТОГДА -2
			|		ИНАЧЕ ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик
			|	КОНЕЦ КАК ИндексРегистраПотребителя
			|ИЗ
			|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
			|		ПО ПоказателиОтчетов.ГруппаРаскрытия = ГруппыРаскрытия.Ссылка
			|ГДЕ
			|	ПоказателиОтчетов.Ссылка В(&ВсеПоказатели)
			|	И ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)";
		
		СтруктураРасчетаПоказателей.Вставить("тПоказателиОперанды", Запрос.Выполнить().Выгрузить());	
		
		// Получим данные текущего среза
		ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей, , Перечисления.ТипПараметрическойНастройки.ИндексироватьПоСценарию);			
		
	КонецЕсли; 
		
	// Добавим таблицу измененных показателей
	ДобавитьЗапросПоИзмененнымПоказателям(СтруктураРасчетаПоказателей, ОбъектРасчета.тИзмененныеПоказатели, ИндексироватьПоСценарию);
	
	// Заполним пустые аналитики, если необходимо
	Если ОбъектРасчета.ЗаполнятьПустыеАналитики Тогда
		ДобавитьЗапросПоПустымАналитикам(СтруктураРасчетаПоказателей, "втРассчитанныеПоказатели");
	КонецЕсли;
	
	// Запишем данные в лог измененных показателей
	ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, ОбъектРасчета.ДополнительныеВалюты.Количество() > 0);
	
	// Получим таблицу только новых значений ЗначениеВалюта
	Если СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта Тогда
		ДобавитьЗапросПересчетаВалютныхПоказателей(СтруктураРасчетаПоказателей);
	КонецЕсли;
	
	Если СтруктураРасчетаПоказателей.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
	
	Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	
КонецФункции

// Функция - Получить структуру для установки новых значений показателей
//
// Параметры:
//	ОбъектРасчета - Структура - Структура с данными для расчета 
//	ПоказателиПоКодам - Булево - Признак того, что вместо ссылок на показатели передаются коды показателей
//	ФильтрПоИзмененнымЗначениям - Булево - Признать того, что текущие значения показателей необходимо фильтровать по измененным значениям показателей
// 
// Возвращаемое значение:
//	 - ТаблицаЗначений - Таблица со строками этапов расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляУстановкиАбсолютныхЗначенийВЛог(ОбъектРасчета, ПоказателиПоКодам = Ложь, ФильтрПоИзмененнымЗначениям = Истина)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ВидОтчета				= ОбъектРасчета.ВидОтчета;
	МаксАналитикОтчета		= ОбъектРасчета.МаксАналитикОтчета;
	МаксАналитикПоказателя	= ОбъектРасчета.МаксАналитикПоказателя;
	МенеджерВременныхТаблиц	= ОбъектРасчета.МенеджерВременныхТаблиц;
	ПравилоОбработки		= ОбъектРасчета.ПравилоОбработки;
	Если ПоказателиПоКодам Тогда
		тИзмененныеПоказатели = ОбъектРасчета.ТаблицаУстановкиЗначенийПоказателей
	Иначе
		тИзмененныеПоказатели = ОбъектРасчета.тИзмененныеПоказатели;
	КонецЕсли;
	
	// Инициализируем служебные таблицы 
	СтруктураРасчетаПоказателей = СтруктураРасчетаПоказателей();
	СтруктураРасчетаПоказателей.ДанныеВидаОтчета = ОбъектРасчета.ДанныеВидаОтчета;
	СтруктураРасчетаПоказателей.МаксКлючевыхАналитик = ОбъектРасчета.МаксАналитикОтчета;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ЗначенияПоказателей", тИзмененныеПоказатели);
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("МаксКлючевыхАналитик", МаксАналитикОтчета);
	
	Если ПоказателиПоКодам Тогда

		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.КодВФормуле КАК КодПоказателя,
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.УровеньРасчета КАК Счетчик
			|ПОМЕСТИТЬ втЗначенияПоказателейИсходные
			|ИЗ
			|	&ЗначенияПоказателей КАК ЗначенияПоказателей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЕСТЬNULL(ПоказателиОтчетов.Ссылка, ЗначенияПоказателей.Показатель) КАК Показатель,
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЗначенияПоказателей.Счетчик КАК Счетчик
			|ПОМЕСТИТЬ втЗначенияПоказателейИсходныеСПоказателями
			|ИЗ
			|	втЗначенияПоказателейИсходные КАК ЗначенияПоказателей
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|		ПО ЗначенияПоказателей.КодПоказателя = ПоказателиОтчетов.Код
			|			И (ПоказателиОтчетов.Владелец = &ВидОтчета)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	МАКСИМУМ(ЗначенияПоказателей.Счетчик) КАК Счетчик
			|ПОМЕСТИТЬ втКрайниеЗначенияПоказателейПоказателейИсходные
			|ИЗ
			|	втЗначенияПоказателейИсходныеСПоказателями КАК ЗначенияПоказателей
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗначенияПоказателей.ПериодОтчета,
			|	ЗначенияПоказателей.Аналитика1,
			|	ЗначенияПоказателей.Аналитика2,
			|	ЗначенияПоказателей.Аналитика3,
			|	ЗначенияПоказателей.Аналитика4,
			|	ЗначенияПоказателей.Аналитика5,
			|	ЗначенияПоказателей.Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта,
			|	ЗначенияПоказателей.Показатель
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	1 КАК УровеньРасчета,
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ВЫБОР
			|		КОГДА ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
			|			ТОГДА ВЫРАЗИТЬ(ЗначенияПоказателей.Значение КАК ЧИСЛО(18, 5))
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Значение,
			|	ВЫБОР
			|		КОГДА ПоказателиОтчетов.ТипЗначения <> ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
			|			ТОГДА ЗначенияПоказателей.Значение
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК ЗначениеНечисловое,
			|	0 КАК ЗначениеВалюта
			|ПОМЕСТИТЬ втЗначенияПотребителейРасчет
			|ИЗ
			|	втЗначенияПоказателейИсходныеСПоказателями КАК ЗначенияПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКрайниеЗначенияПоказателейПоказателейИсходные КАК КрайниеЗначенияПоказателейПоказателейИсходные
			|		ПО ЗначенияПоказателей.Показатель = КрайниеЗначенияПоказателейПоказателейИсходные.Показатель
			|			И ЗначенияПоказателей.ПериодОтчета = КрайниеЗначенияПоказателейПоказателейИсходные.ПериодОтчета
			|			И ЗначенияПоказателей.Аналитика1 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика1
			|			И ЗначенияПоказателей.Аналитика2 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика2
			|			И ЗначенияПоказателей.Аналитика3 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика3
			|			И ЗначенияПоказателей.Аналитика4 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика4
			|			И ЗначенияПоказателей.Аналитика5 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика5
			|			И ЗначенияПоказателей.Аналитика6 = КрайниеЗначенияПоказателейПоказателейИсходные.Аналитика6
			|			И ЗначенияПоказателей.АналитикаВалюта = КрайниеЗначенияПоказателейПоказателейИсходные.АналитикаВалюта
			|			И ЗначенияПоказателей.Счетчик = КрайниеЗначенияПоказателейПоказателейИсходные.Счетчик
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
			|		ПО ЗначенияПоказателей.Показатель = ПоказателиОтчетов.Ссылка
			|			И (ПоказателиОтчетов.Владелец = &ВидОтчета)";
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	1 КАК УровеньРасчета,
			|	ЗначенияПоказателей.Показатель КАК Показатель,
			|	ЗначенияПоказателей.ПериодОтчета КАК ПериодОтчета,
			|	ЗначенияПоказателей.Аналитика1 КАК Аналитика1,
			|	ЗначенияПоказателей.Аналитика2 КАК Аналитика2,
			|	ЗначенияПоказателей.Аналитика3 КАК Аналитика3,
			|	ЗначенияПоказателей.Аналитика4 КАК Аналитика4,
			|	ЗначенияПоказателей.Аналитика5 КАК Аналитика5,
			|	ЗначенияПоказателей.Аналитика6 КАК Аналитика6,
			|	ЗначенияПоказателей.АналитикаВалюта КАК АналитикаВалюта,
			|	ЗначенияПоказателей.Значение КАК Значение,
			|	ЗначенияПоказателей.ЗначениеНечисловое КАК ЗначениеНечисловое,
			|	ЗначенияПоказателей.ЗначениеВалюта КАК ЗначениеВалюта
			|ПОМЕСТИТЬ втЗначенияПотребителейРасчет
			|ИЗ
			|	&ЗначенияПоказателей КАК ЗначенияПоказателей";
	
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоказателиОтчетов.Ссылка КАК Потребитель,
		|	ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик КАК МаксИспользуемыхАналитик,
		|	ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ) КАК ЕстьАналитикаВалюта,
		|	ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ) И ПоказателиОтчетов.ПересчитыватьВалютнуюСумму КАК ЕстьЗначениеВалюта,
		|	ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число) КАК Числовой,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе) КАК ЕстьВидКурсаЗначениеУказанноеВДокументе,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса = ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления) КАК ЕстьВидКурсаКурсНаМоментНачисления,
		|	НЕ ПоказателиОтчетов.НеФинансовый
		|		И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.КурсНаМоментНачисления)
		|		И ПоказателиОтчетов.ВидКурса <> ЗНАЧЕНИЕ(Перечисление.ВидыКурсов.ЗначениеУказанноеВДокументе) КАК ЕстьВидКурсаПрочее,
		|	ВЫБОР
		|		КОГДА ПоказателиОтчетов.ТипЗначения = ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик = 0
		|							И ЕСТЬNULL(ГруппыРаскрытия.Валютная, ЛОЖЬ)
		|						ТОГДА -2
		|					ИНАЧЕ ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик
		|				КОНЕЦ
		|		КОГДА ЕСТЬNULL(ГруппыРаскрытия.ЧислоАналитик, 0) + &МаксКлючевыхАналитик = 0
		|			ТОГДА -11
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК ИндексРегистраПотребителя
		|ИЗ
		|	втЗначенияПотребителейРасчет КАК ЗначенияПоказателей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ЗначенияПоказателей.Показатель = ПоказателиОтчетов.Ссылка
		|			И (ПоказателиОтчетов.Владелец = &ВидОтчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ПО (ПоказателиОтчетов.ГруппаРаскрытия = ГруппыРаскрытия.Ссылка)";
	
	// Если не нужен фильтр по измененным значениям, то добавим фильтр по типу расчета показателя
	Если НЕ ФильтрПоИзмененнымЗначениям Тогда
		
		ПоляСвертки = "Потребитель, ТипРасчетаПоказателя";
		
		ДанныеДляРасчета = ПолучитьОперандыПоПравилуОбработки(ПравилоОбработки);
		тДанныеДляРасчетов = ДанныеДляРасчета.тДанныеДляРасчетов.Скопировать(, ПоляСвертки);
		тДанныеДляРасчетов.Свернуть(ПоляСвертки);
		
		МассивПоказателей = Новый Массив;
		Для Каждого СтрокаРасчета Из тДанныеДляРасчетов Цикл
			Если СтрокаРасчета.ТипРасчетаПоказателя < 3 Тогда
				МассивПоказателей.Добавить(СтрокаРасчета.Потребитель);
			КонецЕсли;
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка В (&МассивПоказателей)";
		
		Запрос.УстановитьПараметр("МассивПоказателей", МассивПоказателей);
	
	КонецЕсли;
	
	// Заполним показатели отчета
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	КонецЕсли;
	
	ВыборкаЗапроса = Результат.Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		// Операнды
		НСтрока = СтруктураРасчетаПоказателей.тПоказателиОперанды.Добавить();
		ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаЗапроса);
		
		// Данные расчета
		СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик = Макс(СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик, ВыборкаЗапроса.МаксИспользуемыхАналитик);
		СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта = Макс(СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта, ВыборкаЗапроса.ЕстьАналитикаВалюта);
		СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта = Макс(СтруктураРасчетаПоказателей.ЕстьЗначениеВалюта, ВыборкаЗапроса.ЕстьЗначениеВалюта);
		СтруктураРасчетаПоказателей.ЕстьЗначение = Макс(СтруктураРасчетаПоказателей.ЕстьЗначение, ВыборкаЗапроса.Числовой);
		СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое = Макс(СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое, НЕ ВыборкаЗапроса.Числовой);
		СтруктураРасчетаПоказателей.ЕстьВидКурсаЗначениеУказанноеВДокументе = Макс(СтруктураРасчетаПоказателей.ЕстьВидКурсаЗначениеУказанноеВДокументе, ВыборкаЗапроса.ЕстьВидКурсаЗначениеУказанноеВДокументе);
		СтруктураРасчетаПоказателей.ЕстьВидКурсаКурсНаМоментНачисления = Макс(СтруктураРасчетаПоказателей.ЕстьВидКурсаКурсНаМоментНачисления, ВыборкаЗапроса.ЕстьВидКурсаКурсНаМоментНачисления);
		СтруктураРасчетаПоказателей.ЕстьВидКурсаПрочее = Макс(СтруктураРасчетаПоказателей.ЕстьВидКурсаПрочее, ВыборкаЗапроса.ЕстьВидКурсаПрочее);
		
	КонецЦикла;
	
	// Добавим аналитики и ресурсы
	Для Сч = СтруктураРасчетаПоказателей.МаксКлючевыхАналитик+1 По СтруктураРасчетаПоказателей.МаксИспользуемыхАналитик Цикл
		НСтрока					= СтруктураРасчетаПоказателей.тИспользуемыеАналитики.Добавить();
		НСтрока.УровеньРасчета	= 0;
		НСтрока.Поле			= "Аналитика" + Сч;
	КонецЦикла;	
	Если СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта Тогда
		НСтрока					= СтруктураРасчетаПоказателей.тИспользуемыеАналитики.Добавить();
		НСтрока.УровеньРасчета	= 0;
		НСтрока.Поле			= "АналитикаВалюта";
	КонецЕсли;
	Если СтруктураРасчетаПоказателей.ЕстьЗначение Тогда
		НСтрока = СтруктураРасчетаПоказателей.тИспользуемыеРесурсы.Добавить();
		НСтрока.УровеньРасчета	= 0;
		НСтрока.Поле			= "Значение";
		НСтрока.Суммируется		= Истина;
		НСтрока.ВыводитсяВОтчет	= Истина;
	КонецЕсли;
	Если СтруктураРасчетаПоказателей.ЕстьЗначениеНечисловое Тогда
		НСтрока = СтруктураРасчетаПоказателей.тИспользуемыеРесурсы.Добавить();
		НСтрока.УровеньРасчета	= 0;
		НСтрока.Поле			= "ЗначениеНечисловое";
		НСтрока.Суммируется		= Ложь;
		НСтрока.ВыводитсяВОтчет	= Истина;
	КонецЕсли;
	
	// Добавим таблицу измененных показателей
	ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
	
	// Заполним пустые аналитики, если необходимо
	Если ОбъектРасчета.ЗаполнятьПустыеАналитики Тогда
		ДобавитьЗапросПоПустымАналитикам(СтруктураРасчетаПоказателей);
	КонецЕсли;
	
	// Получим исходные данные потребителей
	ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей, ФильтрПоИзмененнымЗначениям);
	
	// Получим таблицы с дельтами, относительно исходных данных
	ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей);
	
	// Запишем данные в лог измененных показателей
	ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, ОбъектРасчета.ДополнительныеВалюты.Количество() > 0);
	
	Если СтруктураРасчетаПоказателей.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;

	Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	
КонецФункции

// Функция - Рассчитывает параметрические данные для расчета показателей для переданных 
//		в таблице значений "ОбъектРасчета.тИзмененныеПоказатели" измененных показателей
//
// Параметры:
//	ОбъектРасчета				- Структура - Структура с данным для расчета параметрики
// 
// Возвращаемое значение:
//	 - Структура - Структура для расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляИзмененныхПоказателей(ОбъектРасчета)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Сформируем данные для расчета запросов
	СтруктураРасчетаПоказателей = ПодготовитьТаблицыДляРасчетаПоказателейПоПравилуРасчета(ОбъектРасчета.ПравилоОбработки, ОбъектРасчета.тИзмененныеПоказатели, , , 2);
	
	Если СтруктураРасчетаПоказателей.тПоказателиОперанды.Количество() > 0 Тогда
		
		Если ОбъектРасчета.ВидРасчета = "ПоИзмененнымПоЦелевым" Тогда
			// Не делаем пересчеты в валюты
			СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта = Ложь;
		КонецЕсли;
	
		// Создадим таблицу показателей
		ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
		
		// Генерация таблицы запросов для получения независимых операндов (0 уровень расчета)
		ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей);
		
		// Генерация таблиц запросов для расчета операндов всех зависимых уровней расчета
		ДобавитьЗапросыПоУровнямРасчета(СтруктураРасчетаПоказателей);

		// Получим объединенную таблицу потребителей 
		ДобавитьЗапросПоНовымЗначениямПотребителей(СтруктураРасчетаПоказателей);
		
		// Получим исходные данные потребителей
		ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей, Истина);	
		
		// Получаем таблицы с дельтами, относительно исходных данных
		ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей);
		
		// Запишем данные в лог измененных показателей
		ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, ОбъектРасчета.ДополнительныеВалюты.Количество() > 0);	
		
		
	КонецЕсли;
	
	Если СтруктураРасчетаПоказателей.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
		
	// Получаем итоговую таблицу пересчета показателей
	Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	
КонецФункции


#Область ПараллельныйВалютныйПересчет
// Функция - Рассчитывает параметрические данные для расчета только показателей с видом курса Расчетный 
// Показатели исключения, которые не нужно пересчитывать пердаются в параметре ОбъектРасчета.мПоказателиИсключения 
//
// Параметры:
//	ОбъектРасчета				- Структура - Структура с данным для расчета параметрики
// 
// Возвращаемое значение:
//	 - Структура - Структура для расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляРасчетныхВалютныхПоказателей(ОбъектРасчета)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Сформируем данные для расчета запросов
	Если ЭтоРасшифровка Тогда
		СтруктураРасчетаПоказателей = ПодготовитьТаблицыДляРасчетаПоказателейПоПравилуРасчета(ОбъектРасчета.ПравилоОбработки,
			, ОбъектРасчета.тЦелевыеПоказатели,, 2);
	Иначе
		СтруктураРасчетаПоказателей = ПодготовитьТаблицыДляРасчетаПоказателейПоПравилуРасчета(ОбъектРасчета.ПравилоОбработки,
			ОбъектРасчета.тИзмененныеПоказатели,, ОбъектРасчета.мПоказателиИсключения, 2);
	КонецЕсли;
	
	Если СтруктураРасчетаПоказателей.тПоказателиОперанды.Количество() > 0 Тогда
		
		Если ОбъектРасчета.ВидРасчета = "ПоИзмененнымПоЦелевым" Тогда
			// Не делаем пересчеты в валюты
			СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта = Ложь;
		КонецЕсли;
	
		// Создадим таблицу показателей
		ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
		
		// Генерация таблицы запросов для получения независимых операндов (0 уровень расчета)
		ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей);
		
		// Генерация таблиц запросов для расчета операндов всех зависимых уровней расчета
		ДобавитьЗапросыПоУровнямРасчета(СтруктураРасчетаПоказателей);

		// Получим объединенную таблицу потребителей 
		ДобавитьЗапросПоНовымЗначениямПотребителей(СтруктураРасчетаПоказателей);
		
		// Получим исходные данные потребителей
		ДобавитьЗапросПоИсходнымЗначениямПотребителей(СтруктураРасчетаПоказателей, Истина);	
		
		// Получаем таблицы с дельтами, относительно исходных данных
		ДобавитьЗапросДляРасчетаОтклонений(СтруктураРасчетаПоказателей);
		
		// Запишем данные в лог измененных показателей
		ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, ОбъектРасчета.ДополнительныеВалюты.Количество() > 0);	
		
		
	КонецЕсли;
	
	Если СтруктураРасчетаПоказателей.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
		
	// Получаем итоговую таблицу пересчета показателей
	Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;
	
КонецФункции

//Процедура - доплняет ОбъектРасчета показателями, пересчет которых в доп. валютах необходимо
//делать независимо от основного пересчета
Процедура ДополнитьОбъектРасчетаВалютнымиПоказателямиДляПересчета(ОбъектРасчета,глТаблицаПересчетаПоказателей, РасчетЗависимых = Ложь)
	
	Если РасчетЗависимых Тогда
		ТаблицаОперандов = глТаблицаПересчетаПоказателей.НайтиСтроки(Новый Структура("ВидОперацииРасчета",
			Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеИзмененныхПоказателей));
	Иначе
		ТаблицаОперандов = глТаблицаПересчетаПоказателей.НайтиСтроки(Новый Структура("ВидОперацииРасчета",
			Перечисления.ВидыОперацийРасчетаПоказателей.ПолучениеТаблицыОперандов));
	КонецЕсли;
	
	Если ТаблицаОперандов.Количество()>0 Тогда
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПоказателиОтчетов.Ссылка КАК Ссылка,
		               |	ПоказателиОтчетов.РассчитываетсяПослеКонвертации КАК РассчитываетсяПослеКонвертации
		               |ПОМЕСТИТЬ мПоказателиОперанды
		               |ИЗ
		               |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		               |ГДЕ
		               |	ПоказателиОтчетов.Ссылка В(&Ссылка)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	мПоказателиОперанды.Ссылка КАК Ссылка
		               |ИЗ
		               |	мПоказателиОперанды КАК мПоказателиОперанды
		               |ГДЕ
		               |	мПоказателиОперанды.РассчитываетсяПослеКонвертации = ИСТИНА
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	мПоказателиОперанды.Ссылка КАК Ссылка
		               |ИЗ
		               |	мПоказателиОперанды КАК мПоказателиОперанды
		               |ГДЕ
		               |	мПоказателиОперанды.РассчитываетсяПослеКонвертации = ЛОЖЬ";
		
		Если РасчетЗависимых Тогда
			Запрос.УстановитьПараметр("Ссылка", ТаблицаОперандов[0].тПараметрыПакета[0].ЗначениеОтбора.ВыгрузитьКолонку("Показатель"));
		Иначе
			Запрос.УстановитьПараметр("Ссылка",ТаблицаОперандов[0].тПараметрыПакета[0].ЗначениеОтбора.ВыгрузитьКолонку("Потребитель") );
		КонецЕсли;
		
		Результат = Запрос.ВыполнитьПакет();
		
		РезультатРассчитываетсяПослеКонвертации = Результат[1].Выгрузить().ВыгрузитьКолонку("Ссылка");
				
		Если РезультатРассчитываетсяПослеКонвертации.Количество()>0 Тогда
			
			ОбъектРасчета.Вставить("РасчетныеВалютныеПоказатели",РезультатРассчитываетсяПослеКонвертации);
		 
			Если ЭтоПрочиеРежимыЗаполнения(ОбъектРасчета.СпособФормированияОтчета) Тогда
				
				ВсеПоказателиИсключения = ПоказателиИсключенияПрочихРежимовЗаполнения();
				ОбъектРасчета.Вставить("мПоказателиИсключения", ВсеПоказателиИсключения);
				
			Иначе
				
				ОбъектРасчета.Вставить("мПоказателиИсключения", Результат[2].Выгрузить().ВыгрузитьКолонку("Ссылка"));
				
			КонецЕсли;
		
		КонецЕсли;	   
					
	КонецЕсли;
	
		
	
КонецПроцедуры	

Функция ЭтоПрочиеРежимыЗаполнения(СпособФормированияОтчета)
	
	Возврат СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Элиминация
		ИЛИ СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.Консолидация
		ИЛИ СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.КонсолидацияПропорционально
		ИЛИ СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоАналитикам
		ИЛИ СпособФормированияОтчета = Перечисления.СпособыФормированияОтчетов.СвернувПоПериоду;
	
КонецФункции

Функция ПоказателиИсключенияПрочихРежимовЗаполнения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляРасчетов.Потребитель КАК Потребитель
	|ПОМЕСТИТЬ ВТ_ДанныеДляРасчетов
	|ИЗ
	|	&ДанныеДляРасчетов КАК ДанныеДляРасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДанныеДляРасчетов.Потребитель КАК Потребитель
	|ИЗ
	|	ВТ_ДанныеДляРасчетов КАК ВТ_ДанныеДляРасчетов
	|ГДЕ
	|	ВТ_ДанныеДляРасчетов.Потребитель НЕ В(&Ссылка)
	|";
	
	ДанныеДляРасчета = ПолучитьОперандыПоПравилуОбработки(ОбъектРасчета.ПравилоОбработки);
	Запрос.УстановитьПараметр("ДанныеДляРасчетов", ДанныеДляРасчета.тДанныеДляРасчетов);
	Запрос.УстановитьПараметр("Ссылка", ОбъектРасчета.РасчетныеВалютныеПоказатели);
	
	ПоказателиИсключения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Потребитель");
	
	Возврат ПоказателиИсключения;
	
КонецФункции

Процедура ВыполнитьПараллельныйВалютныйПересчет(ОбъектРасчета,глТаблицаПересчетаПоказателей,ФлагОшибки, РасчетЗависимых = Ложь)
	
	ДополнитьОбъектРасчетаВалютнымиПоказателямиДляПересчета(ОбъектРасчета,глТаблицаПересчетаПоказателей, РасчетЗависимых);
			
	Если ОбъектРасчета.Свойство("РасчетныеВалютныеПоказатели") Тогда
		
		ОсновнаяВалюта 			= ОбъектРасчета.ОсновнаяВалюта;
		ДополнительныеВалюты    = ОбъектРасчета.ДополнительныеВалюты;
		
		Для Каждого ВалютаРасчета Из ОбъектРасчета.ДополнительныеВалюты Цикл
			
			Если ЭтоРасшифровка И НЕ ВалютаРасчета = ОбъектРасчета.ВалютаОтображения Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ВалютаРасчета = ОсновнаяВалюта Тогда
				
				УничтожитьВременныеТаблицыРасчета();

				ОбъектРасчета.ОсновнаяВалюта = ВалютаРасчета;
				
				ДополнительныеВалюты_ = Новый Массив;
				ДополнительныеВалюты_.Добавить(ВалютаРасчета);
				ОбъектРасчета.ДополнительныеВалюты = ДополнительныеВалюты_;
				
				глТаблицаПересчетаПоказателей = ПараметрическаяНастройкаДляРасчетныхВалютныхПоказателей(ОбъектРасчета);
				Если НЕ ВыполнитьРасчетЗапросов(глТаблицаПересчетаПоказателей) Тогда
					ФлагОшибки = Истина;
					Возврат;
				КонецЕсли;
				
			КонецЕсли;	
			
			
		КонецЦикла;	
		
		//Восстановим переменные как было
		ОбъектРасчета.ОсновнаяВалюта = ОсновнаяВалюта;
		ОбъектРасчета.ДополнительныеВалюты  =  ДополнительныеВалюты;

		
	КонецЕсли;	
		
КонецПроцедуры	

#КонецОбласти



// Функция - Рассчитывает параметрические данные для расчета целевых показателей переданных 
//		в таблице значений "ОбъектРасчета.тЦелевыеПоказатели" 
//
// Параметры:
//	ПравилоОбработки			- СправочникСсылка.ПравилаОбработки - Привило обработки для расчета
//	тЦелевыеПоказатели			- ТаблицаЗначений - Таблица с целевыми показателями
// 
// Возвращаемое значение:
//	 - Структура - Структура для расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляЦелевыхПоказателей(ПравилоОбработки, тЦелевыеПоказатели)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Сформируем данные для расчета запросов
	СтруктураРасчетаПоказателей = ПодготовитьТаблицыДляРасчетаПоказателейПоПравилуРасчета(ПравилоОбработки, , тЦелевыеПоказатели);
	
	Если СтруктураРасчетаПоказателей.тПоказателиОперанды.Количество() > 0 Тогда
		
		Если НЕ ЭтоРасшифровка Тогда
			// Не пересчитываем в валютные значения
			СтруктураРасчетаПоказателей.ЕстьАналитикаВалюта = Ложь;
		КонецЕсли;
	
		// Создадим таблицу показателей
		ДобавитьЗапросПоказателейОперандов(СтруктураРасчетаПоказателей);
		
		// Генерация таблицы запросов для получения независимых операндов (0 уровень расчета)
		ДобавитьЗапросУровня0(СтруктураРасчетаПоказателей);
		
		// Генерация таблиц запросов для расчета операндов всех зависимых уровней расчета
		ДобавитьЗапросыПоУровнямРасчета(СтруктураРасчетаПоказателей);

		// Получим объединенную таблицу потребителей 
		ДобавитьЗапросПоНовымЗначениямПотребителей(СтруктураРасчетаПоказателей);
		
		// Свернем таблицу новых значений потребителей
		СвернутьТаблицуНовыхЗначенийПотребителей(СтруктураРасчетаПоказателей);
		
		ПересчетВДопВалюты = Ложь;
		Если ЭтоРасшифровка И тЦелевыеПоказатели[0].ПересчетВДопВалюты Тогда
			ПересчетВДопВалюты = Истина;
		КонецЕсли;
		// Сгруппируем таблицу новых значений потребителей
		ДобавитьЗапросПомещенияИзмененныхПоказателейВЛог(СтруктураРасчетаПоказателей, ПересчетВДопВалюты);
		
	КонецЕсли;
	
	Если СтруктураРасчетаПоказателей.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	// Получаем итоговую таблицу пересчета показателей
	СтруктураПересчета = Новый Структура;
	СтруктураПересчета.Вставить("глТаблицаПересчетаПоказателей", СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей);
	СтруктураПересчета.Вставить("тПоказателиОперанды", СтруктураРасчетаПоказателей.тПоказателиОперанды);
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
	
	Возврат СтруктураПересчета;
	
КонецФункции

// Функция - Получить таблицу расчета показателей для расчета значения в валюте
//
// Параметры:
//	ОбъектРасчета	 - Структура - Структура с данными для расчета
//	ДанныеПоказателя - Структура - Структура с данными показателя
// 
// Возвращаемое значение:
//	 - ТаблицаЗначений - Таблица со строками этапов расчета показателей по правилу расчета
//
Функция ПараметрическаяНастройкаДляДляРасчетаЗначенияВВалюте(ОбъектРасчета, ДанныеПоказателя)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	// Инициализируем служебные таблицы 
	СтруктураРасчетаПоказателей = СтруктураРасчетаПоказателей();
	СтруктураРасчетаПоказателей.Вставить("ДанныеВидаОтчета", ОбъектРасчета.ДанныеВидаОтчета);
	СтруктураРасчетаПоказателей.Вставить("МаксКлючевыхАналитик", ОбъектРасчета.МаксАналитикОтчета);
	СтруктураРасчетаПоказателей.Вставить("ЕстьАналитикаВалюта", ДанныеПоказателя.ЕстьАналитикаВалюта);
	СтруктураРасчетаПоказателей.Вставить("ЕстьЗначение", ДанныеПоказателя.ЕстьЗначение);
	СтруктураРасчетаПоказателей.Вставить("ЕстьЗначениеНечисловое", ДанныеПоказателя.ЕстьЗначениеНечисловое);
	СтруктураРасчетаПоказателей.Вставить("ЕстьЗначениеВалюта", ДанныеПоказателя.ЕстьАналитикаВалюта И ДанныеПоказателя.ЕстьЗначениеВалюта И ДанныеПоказателя.ЕстьЗначение);
	СтруктураРасчетаПоказателей.Вставить("ЕстьВидКурсаЗначениеУказанноеВДокументе", ДанныеПоказателя.ЕстьВидКурсаЗначениеУказанноеВДокументе);
	СтруктураРасчетаПоказателей.Вставить("ЕстьВидКурсаКурсНаМоментНачисления", ДанныеПоказателя.ЕстьВидКурсаКурсНаМоментНачисления);
	СтруктураРасчетаПоказателей.Вставить("ЕстьВидКурсаПрочее", ДанныеПоказателя.ЕстьВидКурсаПрочее);
	СтруктураРасчетаПоказателей.Вставить("РасчетПоИзмененнымПоказателям", Истина);
	
	// Подготовим запрос пересчета курсов
	тПараметрыПакета = ОписаниеТаблицыПараметров();
	ТекстЗапроса = ТекстЗапросаПересчетаКурсовВалют(СтруктураРасчетаПоказателей, тПараметрыПакета);
	
	нСтрокаТаблицыЗапросов						= СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей.Добавить();
	нСтрокаТаблицыЗапросов.КомментарийКПакету	= НСтр("ru = 'ПОЛУЧЕНИЕ ДАННЫХ ИЗМЕНИВШИХСЯ ВАЛЮТНЫХ ЗНАЧЕНИЙ'");
	нСтрокаТаблицыЗапросов.ВидОперацииРасчета	= Перечисления.ВидыОперацийРасчетаПоказателей.ИтоговаяТаблицаРасчетаПоказателей;
	нСтрокаТаблицыЗапросов.тПараметрыПакета		= тПараметрыПакета;
	нСтрокаТаблицыЗапросов.ТекстПодзапросов		= ТекстЗапроса; 
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбщееВремяПолученияПараметрики = ОбщееВремяПолученияПараметрики + ВремяОкончания - ВремяНачала;
	
	Возврат СтруктураРасчетаПоказателей.глТаблицаПересчетаПоказателей;

КонецФункции

#КонецОбласти


#Область ХранилищаПараметрическойНастройки

////////////////////////////////////////////////////////////////////////////////
// Работа с данными хранилища параметрической настройки
//
////////////////////////////////////////////////////////////////////////////////

Функция ДанныеИзХранилищаПараметрическойНастройки(ИсточникПараметрическойНастройки, ТипПараметрическойНастройки)

	// Проверим, есть ли сохраненные рассчитанные показатели
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХранилищаПараметрическойНастройкиРасширенный.ДатаАктуальности КАК ДатаАктуальности
		|ИЗ
		|	РегистрСведений.ХранилищаПараметрическойНастройкиРасширенный КАК ХранилищаПараметрическойНастройкиРасширенный
		|ГДЕ
		|	ХранилищаПараметрическойНастройкиРасширенный.ИсточникПараметрическойНастройки = &ИсточникПараметрическойНастройки
		|	И ХранилищаПараметрическойНастройкиРасширенный.ТипПараметрическойНастройки = &ТипПараметрическойНастройки";
		
	Запрос.УстановитьПараметр("ИсточникПараметрическойНастройки",	ИсточникПараметрическойНастройки);
	Запрос.УстановитьПараметр("ТипПараметрическойНастройки",		ТипПараметрическойНастройки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	// Получим сохраненные рассчитанные показатели
	ВыборкаИзЗапроса = РезультатЗапроса.Выбрать();
	ВыборкаИзЗапроса.Следующий();
	
	Возврат БюджетированиеИОтчетностьПовтИсп.ПолучитьДанныеПараметрическойНастройкиРасширенный(ИсточникПараметрическойНастройки, ТипПараметрическойНастройки, ВыборкаИзЗапроса.ДатаАктуальности);
	
КонецФункции

Процедура СохранитьДанныеВХранилищеПараметрическойНастройки(ИсточникПараметрическойНастройки, ТипПараметрическойНастройки, ДанныеПараметрическойНастройки)

	// Сохраним сформированные правила расчета показателей в регистр сведений	
	НаборЗаписей = РегистрыСведений.ХранилищаПараметрическойНастройкиРасширенный.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИсточникПараметрическойНастройки.Установить(ИсточникПараметрическойНастройки);
	НаборЗаписей.Отбор.ТипПараметрическойНастройки.Установить(ТипПараметрическойНастройки);
	
	НоваяСтрока = НаборЗаписей.Добавить();
	НоваяСтрока.ИсточникПараметрическойНастройки	= ИсточникПараметрическойНастройки;
	НоваяСтрока.ТипПараметрическойНастройки			= ТипПараметрическойНастройки;
	НоваяСтрока.ДанныеПараметрическойНастройки		= Новый ХранилищеЗначения(ДанныеПараметрическойНастройки, Новый СжатиеДанных());
	НоваяСтрока.ДатаАктуальности					= ТекущаяДатаСеанса();
	
	НаборЗаписей.Записать();
		
КонецПроцедуры

#КонецОбласти


#Область ПодъемДанныхДляРасчетаПараметрики

////////////////////////////////////////////////////////////////////////////////
// Получение данных для расчета параметрики
//
////////////////////////////////////////////////////////////////////////////////

Функция РассчитатьОперандыПоПравилуОбработки(ПравилоОбработки)
	
	// Получим данные источников
	#Область Запрос
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НазначениеРасчетов", ПравилоОбработки);
	Запрос.Текст = 
		"ВЫБРАТЬ // 0
		|	ПроцедурыРасчетов.ПотребительРасчета КАК Потребитель,
		|	ПроцедурыРасчетов.Процедура КАК Процедура,
		|	ПроцедурыРасчетов.ПроизвольныйКод КАК ПроизвольныйКод
		|ПОМЕСТИТЬ втПроцедурыРасчетов
		|ИЗ
		|	РегистрСведений.ПроцедурыРасчетов КАК ПроцедурыРасчетов
		|ГДЕ
		|	ПроцедурыРасчетов.НазначениеРасчетов = &НазначениеРасчетов
		|	И НЕ ВЫРАЗИТЬ(ПроцедурыРасчетов.ПотребительРасчета КАК Справочник.ПоказателиОтчетов).ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ // 1
		|	ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.Код КАК СТРОКА(50)) КАК Код,
		|	ИсточникиДанныхДляРасчетов.Ссылка КАК Ссылка,
		|	ИсточникиДанныхДляРасчетов.ИсточникШаблон КАК ИсточникШаблон,
		|	ИсточникиДанныхДляРасчетов.ПотребительРасчета КАК Потребитель,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.СпособПолучения, ИсточникиДанныхДляРасчетов.СпособПолучения) = ЗНАЧЕНИЕ(Перечисление.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета)
		|			ТОГДА ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ПоказательОтбор, ИсточникиДанныхДляРасчетов.ПоказательОтбор)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПоказателиОтчетов.ПустаяСсылка) 
		|	КОНЕЦ КАК ПоказательОтбор,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ПоказательТекущегоОтчета, ИсточникиДанныхДляРасчетов.ПоказательТекущегоОтчета) КАК ПоказательТекущегоОтчета,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.СпособПолучения, ИсточникиДанныхДляРасчетов.СпособПолучения) КАК СпособПолучения,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.РегистрБД, ИсточникиДанныхДляРасчетов.РегистрБД) КАК РегистрБД,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.РесурсРегистра, ИсточникиДанныхДляРасчетов.РесурсРегистра) КАК РесурсРегистра,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ОсновнаяТаблицаРегистра, ИсточникиДанныхДляРасчетов.ОсновнаяТаблицаРегистра) КАК ОсновнаяТаблицаРегистра,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ВидСреза, ИсточникиДанныхДляРасчетов.ВидСреза) КАК ВидСреза,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ОбъектБД, ИсточникиДанныхДляРасчетов.ОбъектБД) КАК ОбъектБД,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ТабличнаяЧастьБД, ИсточникиДанныхДляРасчетов.ТабличнаяЧастьБД) КАК ТабличнаяЧастьБД,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ТипЗначения, ИсточникиДанныхДляРасчетов.ТипЗначения) КАК ТипЗначения,
		|	ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ИспользоватьМногопериодныйКонтекст, ИсточникиДанныхДляРасчетов.ИспользоватьМногопериодныйКонтекст) КАК ИспользоватьМногопериодныйКонтекст,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.СпособПолучения, ИсточникиДанныхДляРасчетов.СпособПолучения) = ЗНАЧЕНИЕ(Перечисление.СпособыПолученияОперандов.ВнутренниеДанныеПроизвольныйЗапрос)
		|				ИЛИ ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.СпособПолучения, ИсточникиДанныхДляРасчетов.СпособПолучения) = ЗНАЧЕНИЕ(Перечисление.СпособыПолученияОперандов.ВнешниеДанныеПроизвольныйЗапрос)
		|			ТОГДА ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.ТекстЗапросаМодуля, ИсточникиДанныхДляРасчетов.ТекстЗапросаМодуля)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТекстЗапросаМодуля,
		|	СчетаБДСчет.СчетСсылка КАК Счет,
		|	СчетаБДКоррСчет.СчетСсылка КАК КоррСчет,
		|	ИсточникиДанныхДляРасчетов.ПересчитатьВОсновнуюВалюту КАК ПересчитатьВОсновнуюВалюту,
		|	ИсточникиДанныхДляРасчетов.ВидИтога КАК ВидИтогаИсточникаДанных,
		|	ВЫБОР
		|		КОГДА ИсточникиДанныхДляРасчетов.РегистрБД ССЫЛКА Справочник.РегистрыНакопленияБД
		|			ТОГДА ВЫРАЗИТЬ(ИсточникиДанныхДляРасчетов.РегистрБД КАК Справочник.РегистрыНакопленияБД).ВидРегистра
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидРегистраИсточникаДанных,
		|	ИсточникиДанныхДляРасчетов.УчитыватьКоррСчета КАК УчитыватьКоррСчета,
		|	ИсточникиДанныхДляРасчетов.ДтКт КАК ДтКт
		|ПОМЕСТИТЬ втИсточникиДанныхДляРасчетов
		|ИЗ
		|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПроцедурыРасчетов КАК ПроцедурыРасчетов
		|		ПО ИсточникиДанныхДляРасчетов.ПотребительРасчета = ПроцедурыРасчетов.Потребитель
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетовШаблон
		|		ПО ИсточникиДанныхДляРасчетов.ИсточникШаблон = ИсточникиДанныхДляРасчетовШаблон.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДСчет
		|		ПО (ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.Счет, ИсточникиДанныхДляРасчетов.Счет) = СчетаБДСчет.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД КАК СчетаБДКоррСчет
		|		ПО (ЕСТЬNULL(ИсточникиДанныхДляРасчетовШаблон.КоррСчет, ИсточникиДанныхДляРасчетов.КоррСчет) = СчетаБДКоррСчет.Ссылка)
		|ГДЕ
		|	НЕ ИсточникиДанныхДляРасчетов.ПометкаУдаления
		|	И НЕ ИсточникиДанныхДляРасчетов.НеИспользуется
		|	И ИсточникиДанныхДляРасчетов.СпособИспользования = ЗНАЧЕНИЕ(Перечисление.СпособыИспользованияОперандов.ДляФормулРасчета)
		|	И ИсточникиДанныхДляРасчетов.НазначениеРасчетов = &НазначениеРасчетов
		|;
		|
