// Выполняет расчет экземпляра отчета. Расчет происходит по данным, переданным в ДанныеДляРасчета1 и ДанныеДляРасчета2 
//
// Параметры:
//	ДанныеДляРасчета1			- Структура - Структура с данными для расчета показателей
//	ДанныеДляРасчета2			- Структура - Структура с данными для расчета показателей
//	НомерТранзакции				- Число - Номер транзакции для добавления записей в лог измененных показателей
//	ЗаписыватьДанныеВРегистры	- Булево - Признак, что необходимо записать в регистры значения рассчитанных показателей
// 
// Возвращаемое значение:
//	- Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция ЗаполнитьДанныеПоПериодам(ДанныеДляРасчета1, ДанныеДляРасчета2 = Неопределено, НомерТранзакции = 0, Знач ЗаписыватьДанныеВРегистры=Ложь) Экспорт
	
	// Добавляем данные для пересчета
	ДанныеДляПересчетаПоказателей.Очистить();
	ДанныеДляРасчета = ДанныеДляПересчетаПоказателей.Добавить();
	
	ЗаполнитьЗначенияСвойств(ДанныеДляРасчета, ДанныеДляРасчета1);
	
	Если ДанныеДляРасчета2 <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДляРасчета, ДанныеДляРасчета2);
	КонецЕсли;
	
	// Добавим регистратор, если необходимо
	Если ТипЗнч(ДанныеДляРасчета1) = Тип("ДокументОбъект.НастраиваемыйОтчет") Тогда
		Регистратор = ДанныеДляРасчета1.Ссылка;
	ИначеЕсли ТипЗнч(ДанныеДляРасчета1) = Тип("Структура") Тогда
		Если ДанныеДляРасчета1.Свойство("Регистратор") Тогда
			Регистратор = ДанныеДляРасчета1.Регистратор;
		ИначеЕсли ДанныеДляРасчета1.Свойство("Ссылка") Тогда
			Регистратор = ДанныеДляРасчета1.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РассчитатьПоДаннымДляПересчета(НомерТранзакции, ЗаписыватьДанныеВРегистры);
	
КонецФункции

// Рассчитывает значения показателей по данным для пересчета, хранящимся в таблице ДанныеДляПересчетаПоказателей
//
// Параметры:
//	НомерТранзакции				 - Число - номер транзакции для записи в лог измененных показателей
//	ЗаписыватьДанныеВРегистры	 - Булево - Признак, что необходимо записать в регистры значения рассчитанных показателей
//	мПоказателиИсключения		 - Массив - Массив показателей, которые будут исключены из расчета. Значения данных показателей будут взяты из соответствующих регистров сведений. 
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьПоДаннымДляПересчета(НомерТранзакции = 0, ЗаписыватьДанныеВРегистры = Ложь, мПоказателиИсключения = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
	
	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НомерТранзакции", НомерТранзакции);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", ЗаписыватьДанныеВРегистры);
	ПараметрыРасчета.Вставить("мПоказателиИсключения", мПоказателиИсключения);

	// Выполним расчет 
	Результат = ВыполнитьРасчетПоДаннымДляПересчета(ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьПоДаннымДляПересчета");
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Выполняет расчет всех зависимых показателей по значениям измененных показателей
//
// Параметры:
//	ПараметрыРасчета	- Структура - Структура с параметрами для выполнения расчета
//		Инициализируется с помощью экспортной функции ПараметрыРасчета() данного модуля 
//
//	Источник для расчета - таблица расположенная по адресу АдресТаблицыИзмененныхПоказателей в параметрах расчета. Структура таблицы:
//		- Показатель, Сценарий, Организация, Проект (при использовании), Аналитика1-Аналитика6, АналитикаВалюта (при использовании) - обязательные данные для расчета
//		- ПериодОтчета или УправлениеПериодомСценария - используются для вычисления массива периодов для расчета
//		- ВидОтчета (необязательный) - может передаваться для сокращения времени расчета, если присутствует в контексте вызова функции
//		- Значение или ЗначениеНечисловое - новое значение показателя
//
//	Результат расчета сохраняется по адресу АдресТаблицыРассчитанныхПоказателей
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьПоЗначениямИзмененныхПоказателей(ПараметрыРасчета) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();

	// Сформируем параметры расчета
	ПараметрыРасчета.Вставить("ВидРасчета", "ПоИзмененным");

	// Выполним расчет
	АдресТаблицыРассчитанныхПоказателей = "";
	Результат = ВыполнитьРасчетЗависимыхПоказателей(ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьПоЗначениямИзмененныхПоказателей");
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов; 
	
	Возврат Результат;
	
КонецФункции

// Рассчитывает значения показателей по данным для пересчета, хранящимся в таблице ДанныеДляПересчетаПоказателей
//
// Параметры:
//	НомерТранзакции				 - Число - Номер транзакции для добавления записей в лог измененных показателей
//	ЗаписыватьДанныеВРегистры	 - Булево - Признак, что необходимо записать в регистры значения рассчитанных показателей
//
//	Источник для расчета - таблица расположенная по адресу АдресТаблицыИзмененныхПоказателей. Структура таблицы:
//		- Показатель, Сценарий, Организация, Проект (при использовании), Аналитика1-Аналитика6, АналитикаВалюта (при использовании) - обязательные данные для расчета
//		- ПериодОтчета или УправлениеПериодомСценария - используются для вычисления массива периодов для расчета
//		- ВидОтчета (необязательный) - может передаваться для сокращения времени расчета, если присутствует в контексте вызова функции
//		- Значение или ЗначениеНечисловое - новое значение показателя
//
//	Результат расчета сохраняется по адресу АдресТаблицыРассчитанныхПоказателей
//
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьПоЗначениямИзмененныхПоказателейПоДаннымДляПересчета(НомерТранзакции = 0, ЗаписыватьДанныеВРегистры = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();

	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НомерТранзакции", НомерТранзакции);
	ПараметрыРасчета.Вставить("РасчетПоСвязаннымВидамОтчетов", Ложь);
	ПараметрыРасчета.Вставить("РасчетПоТекущимВидамОтчетов", Истина);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", ЗаписыватьДанныеВРегистры);
	ПараметрыРасчета.Вставить("ВидРасчета", "ПоИзмененнымПоДаннымДляПересчета");
	ПараметрыРасчета.Вставить("мПоказателиИсключения", Неопределено);

	// Поместим измененные показатели в лог измененных показателей
	Результат = ВыполнитьРасчетЗависимыхПоказателей(ПараметрыРасчета);

	// Выполним расчет по данным для пересчета
	Если Результат Тогда
		Результат = ВыполнитьРасчетПоДаннымДляПересчета(ПараметрыРасчета);
	КонецЕсли;
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьПоЗначениямИзмененныхПоказателейПоДаннымДляПересчета");
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

/// Выполняет расчет всех исходных показателей по значениям целевых показателей
//
// Параметры:
//	ЦелевыеПоказатели				 - ТаблицаЗначений - Таблица со значениями целевых показателей
//	РасчетПоСвязаннымВидамОтчетов	 - Булево - При значении "Истина" будут пересчитаны все связанные показатели из других видов отчетов
// 
// Возвращаемое значение:
//	 - Структура - Структура с рассчитанными данными
//
Функция РассчитатьПоЗначениямЦелевыхПоказателей(ЦелевыеПоказатели, РасчетПоСвязаннымВидамОтчетов=Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
	
	
	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("РасчетПоСвязаннымВидамОтчетов", РасчетПоСвязаннымВидамОтчетов);	
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", Ложь);
	ПараметрыРасчета.Вставить("ВидРасчета", "ПоЦелевым");
	
	// Выполним расчет
	Результат = ВыполнитьРасчетПоЗначениямЦелевыхПоказателей(ЦелевыеПоказатели, ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьПоЗначениямЦелевыхПоказателей");
	
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции	



// Выполняет расчет влияния факторов по таблице факторов для переданного целевого показателя
//
// Параметры:
//	тЦелевыеПоказатели				 - ТаблицаЗначений - Таблица значений с одной строкой целевого показателя
//	тПоказателиФакторов				 - ТаблицаЗначений - Таблица с факторами для анализа
//	ВалютаОтображения				 - СправочникСсылка.Валюты - Валюта в которой происходит пересчет
//	РасчетПоСвязаннымВидамОтчетов	 - Булево - При значении "Истина" будут пересчитаны все связанные показатели из других видов отчетов 
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьВлияниеФакторов(тЦелевыеПоказатели, тПоказателиФакторов, ВалютаОтображения, РасчетПоСвязаннымВидамОтчетов=Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();

	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НомерТранзакции", 0);
	ПараметрыРасчета.Вставить("ВалютаИзмененныхПоказателей", ВалютаОтображения);
	ПараметрыРасчета.Вставить("РасчетПоСвязаннымВидамОтчетов", РасчетПоСвязаннымВидамОтчетов);
	ПараметрыРасчета.Вставить("РасчетПоТекущимВидамОтчетов", Истина);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", Ложь);
	ПараметрыРасчета.Вставить("ВидРасчета", "ПоИзмененнымПоЦелевым");
	
	// Выполним расчет
	Результат = ВыполнитьРасчетВлиянияФакторов(тЦелевыеПоказатели, тПоказателиФакторов, ПараметрыРасчета);
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьВлияниеФакторов");
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Выполняет расчет влияния факторов по таблице факторов для переданного целевого показателя по данным для пересчета
//
// Параметры:
//	тЦелевыеПоказатели	 - ТаблицаЗначений - Таблица значений с одной строкой целевого показателя 
//	тПоказателиФакторов	 - ТаблицаЗначений - Таблица с факторами для анализа 
//	ВалютаОтображения	 - СправочникСсылка.Валюты - Валюта в которой происходит пересчет 
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьВлияниеФакторовПоДаннымДляПересчета(тЦелевыеПоказатели, тПоказателиФакторов, ВалютаОтображения) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();

	// Сформируем параметры расчета
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НомерТранзакции", 0);
	ПараметрыРасчета.Вставить("ВалютаИзмененныхПоказателей", ВалютаОтображения);
	ПараметрыРасчета.Вставить("РасчетПоСвязаннымВидамОтчетов", Ложь);
	ПараметрыРасчета.Вставить("ЗаписыватьДанныеВРегистры", Ложь);
	ПараметрыРасчета.Вставить("ВидРасчета", "ПоИзмененнымПоЦелевымПоДаннымДляПересчета");
	
	// Расчеты не привязаны к идентификатору расчета
	УникальныйИдентификаторСеансаСтарый = УникальныйИдентификаторСеанса;
	УникальныйИдентификаторСеанса = Новый УникальныйИдентификатор;
	
	// Выполним расчет
	Результат = ВыполнитьРасчетВлиянияФакторов(тЦелевыеПоказатели, тПоказателиФакторов, ПараметрыРасчета);
	
	// Вернем прошлый уникальный идентификатор сеанса
	УникальныйИдентификаторСеанса = УникальныйИдентификаторСеансаСтарый;
	
	ВремяОкончанияРасчетов = ВыполнитьДействияПослеРасчетов("РассчитатьВлияниеФакторовПоДаннымДляПересчета");
	ОбщееВремяРасчетов = ОбщееВремяРасчетов + ВремяОкончанияРасчетов - ВремяНачалаРасчетов;
	
	Возврат Результат;
	
КонецФункции

// Выполняет пересчет валютных сумм
//
// Параметры:
//	ДанныеДляПересчета	 - Структура - Структура с данными для пересчета значения 
// 
// Возвращаемое значение:
//	 - Булево - "Истина" - ошибок не было, "Ложь" - были ошибки
//
Функция РассчитатьЗначениеВВалюте(ДанныеДляПересчета) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРасчетов = ВыполнитьДействияПередНачаломРасчетов();
	
