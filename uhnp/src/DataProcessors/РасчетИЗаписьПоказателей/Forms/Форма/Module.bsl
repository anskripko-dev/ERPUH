
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.РежимТрассировки = Константы.ИспользоватьРежимТрассировкиПересчетаПоказателей.Получить();
	Объект.УникальныйИдентификаторСеанса = УникальныйИдентификатор;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СпособФормированияОтчетаПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ПриЗакрытииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтобразитьПротокол()

	Если ЗначениеЗаполнено(Объект.АдресТаблицыСобытий) Тогда
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",Новый Структура("АдресТаблицыСобытий",Объект.АдресТаблицыСобытий));
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ОткрыватьДокументПослеРасчета Тогда
		ФормаДокумента = ПолучитьФорму("Документ.НастраиваемыйОтчет.ФормаОбъекта",
			Новый Структура("Ключ", ЭкземплярОтчета));
		УИРасчета = ФормаДокумента.УникальныйИдентификатор;
	Иначе
		УИРасчета = УникальныйИдентификатор;
	КонецЕсли;
	
	Если РассчитатьДокументНаСервере(УИРасчета) Тогда
		Если ОткрыватьДокументПослеРасчета Тогда
			ФормаДокумента.Открыть();
			ФормаДокумента.Модифицированность = НЕ ЗаписыватьЗначенияПоказателей;
			Оповестить("ЗаписанДокументКорректировки", ФормаДокумента, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
	ОтобразитьПротокол();
	
КонецПроцедуры

&НаСервере
Функция РассчитатьДокументНаСервере(УИРасчета)
	
	СтрокаДанныхДокумента = 
		"ВидОтчета,ПравилоОбработки,ИспользуемаяИБ,ПериодОтчета,ПериодОкончания,Сценарий,Организация,Проект,
		|Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6";
	
	// Создаем обработку
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.АдресКэшаДанных = "";
	ОбработкаОбъект.УникальныйИдентификаторСеанса = УИРасчета;
	ОбработкаОбъект.Регистратор = ЭкземплярОтчета;
	ОбработкаОбъект.ОбщееВремяПолученияПараметрики = 0;
	ОбработкаОбъект.ОбщееВремяРасчетов = 0;
	ОбработкаОбъект.ОбщееВремяЗаписиВерсий = 0;
	ОбработкаОбъект.ИспользоватьЛогИзмененныхЗначенийПоказателейОтчетов = Истина;
	
	РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.ОчиститьЗаписи(УИРасчета);
	РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые.ОчиститьЗаписи(УИРасчета);
	
	// Добавляем данные для пересчета
	ОбработкаОбъект.ДанныеДляПересчетаПоказателей.Очистить();
	ДанныеДляРасчета = ОбработкаОбъект.ДанныеДляПересчетаПоказателей.Добавить();
	ЗаполнитьЗначенияСвойств(
		ДанныеДляРасчета, 
		ОбщегоНазначенияУХ.ЗначенияРеквизитовОбъекта(ЭкземплярОтчета,СтрокаДанныхДокумента));
	ДанныеДляРасчета.СпособФормированияОтчета = СпособФормированияОтчета;
	ДанныеДляРасчета.УточнениеСпособаФормированияОтчета = УточнениеСпособаФормированияОтчета;
	
	// Очищаем версию, если необходимо
	Если ОчищатьВерсии Тогда
		ОчиститьСтарыеДанныеНаСервере(Истина, Ложь, Ложь);
	КонецЕсли;
	// Обновляем параметрику, если необходимо
	Если ОчищатьПараметрику Тогда
		ОчиститьСтарыеДанныеНаСервере(Ложь);
	КонецЕсли;
	
	// Рассчитываем показатели
	Результат = ОбработкаОбъект.РассчитатьПоДаннымДляПересчета();
	
	// Записываем показатели
	Если Результат И ЗаписыватьЗначенияПоказателей Тогда
		Результат = ОбработкаОбъект.ЗаписатьЛогИзмененныхПоказателей();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьСтарыеДанные(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСтарыеДанныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСтарыеДанныеНаСервере(УдалятьВерсии=Истина, УдалятьПараметрикуНовогоДвижка=Истина, УдалятьПараметрикуСтарогоДвижка=Истина)
	
	ЭкземплярОтчетаОбъект	= ЭкземплярОтчета.ПолучитьОбъект();
	ОбъектРасчета			= ЭкземплярОтчетаОбъект.ПодготовитьСтруктуруПеременныхДляРасчета();
	ОбъектРасчета.Вставить("ПравилоОбработки", Документы.НастраиваемыйОтчет.ЗначениеНастройкиОбработкиДокумента(ОбъектРасчета, "ПравилоОбработки"));
	
	УправлениеРасчетомПоказателей.ОчиститьСтарыеДанные(ОбъектРасчета, УдалятьВерсии, УдалятьПараметрикуНовогоДвижка, УдалятьПараметрикуСтарогоДвижка);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимТрассировкиПриИзменении(Элемент)
	РежимТрассировкиПриИзмененииСервер(Объект.РежимТрассировки);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура РежимТрассировкиПриИзмененииСервер(ТекЗначение)	
	Константы.ИспользоватьРежимТрассировкиПересчетаПоказателей.Установить(ТекЗначение);	
КонецПроцедуры

&НаКлиенте
Процедура СпособФормированияОтчетаПриИзменении(Элемент)
	
	Если СпособФормированияОтчета = ПредопределенноеЗначение("Перечисление.СпособыФормированияОтчетов.СвернувПоПериоду") Тогда
		Элементы.УточнениеСпособаФормированияОтчета.Заголовок = НСтр("ru = 'Периодичность'");
		Элементы.УточнениеСпособаФормированияОтчета.Видимость = Истина;
	Иначе
		Элементы.УточнениеСпособаФормированияОтчета.Видимость = Ложь;	    
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетов.ОчиститьЗаписи(УникальныйИдентификатор);
	РегистрыСведений.ЛогИзмененныхЗначенийПоказателейОтчетовНечисловые.ОчиститьЗаписи(УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти





