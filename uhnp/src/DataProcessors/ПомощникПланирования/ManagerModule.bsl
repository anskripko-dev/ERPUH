Функция ПолучитьТекущееСостояниеКлассификацииОКПД2НаСервере(Параметры) Экспорт 
	
	Если Параметры.Свойство("ОтборыПоРеквизитам") Тогда
		ОтборыПоРеквизитам = Параметры.ОтборыПоРеквизитам;
	Иначе
		ОтборыПоРеквизитам = Неопределено;
	КонецЕсли;
	
	КолвоПозиций = Отчеты.ПозицииПотребностейБезКодаОКПД2.ПолучитьКолвоПозицийБезОКПД2(Параметры.Пользователь, Параметры.ПериодЗакупок, ОтборыПоРеквизитам);
	
	ЧастиСтроки = Новый Массив;
	
	Если КолвоПозиций > 0 Тогда
		СтрКолвоПозиций = СтрШаблон(НСтр("ru = '%1 поз.'"), КолвоПозиций);
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(СтрКолвоПозиций, Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиБезОКПД2"));
	Иначе
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'нет'"), Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиБезОКПД2"));
	КонецЕсли;
	
	Возврат Новый Структура("Значение, Описание, Действие", 
								КолвоПозиций, 
								Новый ФорматированнаяСтрока(ЧастиСтроки), 
								"ОКПД2");
	
КонецФункции   

Функция ПолучитьТекущееСостояниеАналоговНаСервере(Параметры) Экспорт 
	
	Если ЗначениеЗаполнено(Параметры.ПериодПотребностей) Тогда    
		
		Отборы = Параметры.ОтборыПоРеквизитам;
		Отборы.Вставить("АналогНоменклатура", Новый Структура("ВидСравнения, Значение", "Заполнено", 	""));
		Отборы.Вставить("ЕстьАналоги", 		  Новый Структура("ВидСравнения, Значение", "Равно", 		Истина));    
		
		КолвоПозицийЗаменыНаАналоги = Отчеты.ОтчетОПримененииАналогов.ПолучитьКолвоПозицийДляЗаменыНаАналоги(Параметры.Пользователь, Параметры.ПериодЗакупок, Отборы); 
		КолвоПозицийБезЗаменыНаАналоги = Отчеты.ОтчетОПримененииАналогов.ПолучитьКолвоПозицийДляЗаменыНаАналоги(Параметры.Пользователь, Параметры.ПериодЗакупок, Отборы);	
		
		// Наличие унификатов
		ЧастиСтроки = Новый Массив;
		Если КолвоПозицийЗаменыНаАналоги > 0 Тогда
			СтрКолвоПозиций = СтрШаблон(НСтр("ru = '%1 поз.'"), КолвоПозицийЗаменыНаАналоги);
			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(СтрКолвоПозиций, Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиКЗаменеНаАналоги"));
			ЧастиСтроки.Добавить("   ");
			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Нстр("ru = '<Обработать>'"), Новый Шрифт("Consolas",,Истина,,Истина), ЦветаСтиля.ГиперссылкаЦвет, , "Обработать_ВыполнитьОбработкуАналогов"));
			ЧастиСтроки.Добавить("   ");
		Иначе
			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'нет'"), Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиКЗаменеНаАналоги"));
			ЧастиСтроки.Добавить("   ");
		КонецЕсли;
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Нстр("ru = '<Настроить>'"), Новый Шрифт("Consolas",,Истина,,Истина), ЦветаСтиля.ГиперссылкаЦвет, , "Обработка_УправлениеАналогами"));
		ЧастиСтроки.Добавить(".");                 
		
	Иначе   
		
		ЧастиСтроки = Новый Массив;	
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'нет'"), Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиКЗаменеНаАналоги"));
		КолвоПозицийЗаменыНаАналоги = 0;
		
	КонецЕсли;   
	
	ТекстНастройка = СтрШаблон(НСтр("ru = ' (доступно к замене %1 позиций)'"), КолвоПозицийБезЗаменыНаАналоги);
	
	Возврат Новый Структура("Значение, Описание, Действие, ОписаниеНастройка", 
								КолвоПозицийЗаменыНаАналоги, 
								Новый ФорматированнаяСтрока(ЧастиСтроки), 
								"Аналоги", 
								ТекстНастройка);
	
КонецФункции

Функция ПолучитьТекущееСостояниеПравилНаСервере(Параметры) Экспорт
	// Инициализация.
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("КолвоПозиций", 0);
	РезультатФункции.Вставить("Описание", "");
	// Получение исходных данных.
	ВыгрузкаОрганизации = ПолучитьМассивОрганизацияПотребностиБезПравил(Параметры.ПериодЗакупок.ПериодЗакупок, Параметры);
	// Формирование строки представления.
	КолвоПозиций = ВыгрузкаОрганизации.Количество();
	ЧастиСтроки = Новый Массив;
	Если КолвоПозиций > 0 Тогда
		СтрКолвоПозиций = СтрШаблон(НСтр("ru = '%1 поз.'"), КолвоПозиций);
		ШрифтОбычный = Новый Шрифт("Consolas");
		ШрифтВыделенный = Новый Шрифт("Consolas", , Истина, , Истина);
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(СтрКолвоПозиций, ШрифтОбычный, ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПравилаПотребностей"));
		ЧастиСтроки.Добавить("   ");
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '<Обработать>'"), ШрифтВыделенный, ЦветаСтиля.ГиперссылкаЦвет, , "Обработать_ПравилаПотребностей"));
	Иначе
		ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'нет'"), ШрифтОбычный, ЦветаСтиля.ГиперссылкаЦвет, , "Отчет_ПравилаПотребностей"));
	КонецЕсли;
	Описание = Новый ФорматированнаяСтрока(ЧастиСтроки);
	// Заполение итоговой структуры.
	
	Возврат Новый Структура("Значение, Описание, Действие, ОписаниеНастройка", 
								КолвоПозиций, 
								Описание, 
								"ПравилаПотребностей");
КонецФункции     
							
Функция РасчитатьПараметрыПотребностейПоПользователю(Параметры) Экспорт

	РезультатРасчета = РегистрыСведений.ПараметрыЗакупкиПотребностей1.РассчитатьПараметрыЗакупкиПоПользователю(Параметры.Пользователь, Параметры);
	Возврат Новый Структура("Значение, Описание, Действие, ОписаниеНастройка", 
								РезультатРасчета.Количество, 
								"", 
								"ПараметрыПотребностейПоПользователю");

КонецФункции // РасчитатьПараметрыПотребностейПоПользователю()

Функция СформироватьПроектыЗакупокНаСервере(Параметры) Экспорт
	
	ДеревоПроектов 		= Параметры.ДеревоПроектов.Получить();   
	ТекущийПользователь = Параметры.ТекущийПользователь;  
	ПериодПотребностей 	= Параметры.ПериодПотребностей;
	ПустойУИД 			= Параметры.ПустойУИД;
	
	// Расчет параметров СПЗ
	ПростыеТипы = Новый Массив;
	ПростыеТипы.Добавить(Тип("Число"));
	ПростыеТипы.Добавить(Тип("Строка"));
	ПростыеТипы.Добавить(Тип("Дата"));
	ПростыеТипы.Добавить(Тип("Булево"));      
	
	СписокДокументов = Новый СписокЗначений; 
	
	ЭтоУХ = ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы");
	
	Для Каждого Проект Из ДеревоПроектов.Строки Цикл   
		
		НачатьТранзакцию();
		ЗаписьПроект = РегистрыСведений.ПроектыСПЗ.СоздатьМенеджерЗаписи(); 
		ЗаписьПроект.Активность = Истина;
		//Измерения
		ЗаписьПроект.Автор = Параметры.ТекущийПользователь; 
		ЗаписьПроект.ПериодЗакупки = Параметры.ПериодПотребностей; 
		ЗаписьПроект.ИД = Новый УникальныйИдентификатор;
		ЗаписьПроект.Дата = ТекущаяДата(); 
		
		ЗаписьПроект.МестоПоставки = Проект.МестоПоставки;
		ЗаписьПроект.Обеспечение = Проект.Обеспечение; 
		ЗаписьПроект.ОрганизацияЗаказчик = Проект.Контрактант; 
		ЗаписьПроект.Дата = Проект.ПериодЗакупки;       
		ЗаписьПроект.ОбщиеТребования = Проект.ПредставлениеПотребности;   
		ЗаписьПроект.Сумма = Проект.Сумма;
		ЗаписьПроект.ПериодПредставление = Проект.ПредставлениеДатаОперации;
		  
		
		//Позиции
		Для Каждого Потребность Из Проект.Строки Цикл   
			
			нз = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(Параметры.ТекущийПользователь);
			нз.Отбор.ПериодЗакупки.Установить(Параметры.ПериодПотребностей);
			нз.Отбор.ИД.Установить(Параметры.ПустойУИД);    
			нз.Отбор.АналитикаИсточника.Установить(Потребность.АналитикаИсточника); 
			нз.Отбор.АналитикаПланирования.Установить(Потребность.АналитикаПланирования);
			нз.Очистить();
			нз.Записать(Истина);
		
			Менеджер = РегистрыСведений.ПроектыСПЗПозиции.СоздатьМенеджерЗаписи();     
			ЗаполнитьЗначенияСвойств(Менеджер, Потребность);
			Менеджер.ИД 			= ЗаписьПроект.ИД;     
			Менеджер.Автор 			= ЗаписьПроект.Автор;  
			Менеджер.ПериодЗакупки 	= ЗаписьПроект.ПериодЗакупки;  
			Менеджер.ПериодПотребности = Потребность.ПериодПотребности;  
			//todo msle 2023-06-02 Одним запросом 
			Менеджер.АналитикаНоменклатуры 	= Менеджер.АналитикаПланирования.АналитикаНоменклатуры;
			Менеджер.АналитикаПотребностей 	= Менеджер.АналитикаПланирования.АналитикаПотребностей; 
			Менеджер.АналитикаСтруктуры 	= Менеджер.АналитикаПланирования.АналитикаСтруктуры;
			
			Менеджер.Записать(Истина);  
			
		КонецЦикла; //Позиции 
		
		// Параметры ПроектаСПЗ
		нзПараметры = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
		нзПараметры.Отбор.Автор.Установить(ЗаписьПроект.Автор);
		нзПараметры.Отбор.ПериодЗакупки.Установить(ЗаписьПроект.ПериодЗакупки);
		нзПараметры.Отбор.ИД.Установить(ЗаписьПроект.ИД);
		нзПараметры.Очистить();
		
		Ключ = Новый Структура("Автор, ПериодЗакупки, ИД, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей",
								ЗаписьПроект.Автор, ЗаписьПроект.ПериодЗакупки, ЗаписьПроект.ИД,
								Справочники.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка(),
								Справочники.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка(),
								Справочники.КлючиАналитикиПланированияПотребностей.ПустаяСсылка());
		
		Итоговые = "Свойство, Значение, ЗапретИзменения";
		Детали = "Свойство, Значение, ЗапретИзменения, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей, ПоложениеОЗакупках, УИДУсловия";  
		//
		СвойстваПроекта = Новый Соответствие;               
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.Организатор, 		Проект.Организатор);
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки, 	Проект.СпособЗакупки);    
		
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.Электронно, 		Проект.СпособЗакупки.ЭлектроннаяФорма); 
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.СМП, 				Проект.СпособЗакупки.МСП);
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП, 	Проект.СпособЗакупки.МСПСубПодряд);
		
		////////////////////////////////////////////////////////////////////////////////////
		
		ДанныеАвтоФормирования = Новый Структура("Параметры", Новый Структура);
		ДанныеАвтоФормирования.Параметры.Вставить("ПериодЗакупки", 	Параметры.ПериодПотребностей);
		ДанныеАвтоФормирования.Параметры.Вставить("ПустойУИД", 		Параметры.ПустойУИД);
		ДанныеАвтоФормирования.Параметры.Вставить("Автор", 			Параметры.ТекущийПользователь);
		
		ВсеПотребности = ВсеПотребностиВКорзине(Проект, ДеревоПроектов); 
		ВсеПотребности.Колонки.Количество.Имя = "КоличествоКОбработке"; 
		ВсеПотребности.Колонки.Сумма.Имя = "СуммаКОбработке";
		//
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ОбщегоНазначенияУХ.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_Потребности", ВсеПотребности);
		
		Для Каждого КлючЗначение Из ДанныеАвтоФормирования.Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;   
		
		Запрос.Текст = ТекстЗапроса_ПолучитьДанныеДляАвтоматическогоФормированияСПЗ();
		Запрос.УстановитьПараметр("ПериодЗакупки",ПериодПотребностей);
		Результат = Запрос.Выполнить();
		
		ПотребностиСПараметрамиЗакупки = Результат.Выгрузить();  
		
		ТаблицаПараметровЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
		
		ПараметрыЗакупки = СформироватьДеревоПараметровЗакупки(ПотребностиСПараметрамиЗакупки, ТаблицаПараметровЗакупки); 
		
		ПараметрыОплатыПроектов = Новый Соответствие;
		
		Для Каждого ПараметрЗакупки Из ПараметрыЗакупки.Строки Цикл   
			
			Если Не ЭтоУХ Тогда	
				//ПараметрыОплаты
				ПараметрыОплаты = ПараметрыОплатыПроектов.Получить(ЗаписьПроект.ИД);
				Если ПараметрыОплаты = Неопределено Тогда       
					ПараметрыОплаты = Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(ПараметрЗакупки.ПоложениеОЗакупках, ПараметрЗакупки.УИДУсловия);  
					ПараметрыОплатыПроектов.Вставить(ЗаписьПроект.ИД, ПараметрыОплаты);
					ЗаписьПроект.ПоложениеОплаты 	= ПараметрЗакупки.ПоложениеОЗакупках;
					ЗаписьПроект.УИДУсловияОплаты 	= ПараметрЗакупки.УИДУсловия;	
				КонецЕсли;            
				
				//ГрафикОплаты
				Если ПараметрЗакупки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты Тогда
					ПараметрЗакупки.Значение = ПараметрыОплаты.ГрафикОплаты;  
					ПараметрЗакупки.ЗапретИзменения = ПараметрыОплаты.ЗапретИзменения_ГрафикОплаты;    
				КонецЕсли;   
				//КалендарьГрафика
				Если ПараметрЗакупки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.КалендарьГрафика Тогда
					ПараметрЗакупки.Значение = ПараметрыОплаты.КалендарьГрафика;  
					ПараметрЗакупки.ЗапретИзменения = ПараметрыОплаты.ЗапретИзменения_КалендарьГрафика;    
				КонецЕсли;         
			КонецЕсли;
			
			
			дв = нзПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(дв, Ключ); 
			дв.Свойство = ПараметрЗакупки.Свойство;
			
			ЗначениеПроекта = СвойстваПроекта.Получить(ПараметрЗакупки.Свойство);
			Если ЗначениеПроекта = Неопределено Тогда           
				дв.Значение = ПараметрЗакупки.Значение;     
			Иначе
				дв.Значение = ЗначениеПроекта;
			КонецЕсли;        
			
		КонецЦикла;
		
		ЗаписьПроект.Записать(Истина); 
		нзПараметры.Записать(Истина); 
		
		РегистрыСведений.ПроектыСПЗ.ОбработатьПроектСПЗ(Параметры.ТекущийПользователь, ЗаписьПроект.ОрганизацияЗаказчик, ЗаписьПроект.ПериодЗакупки, ЗаписьПроект.ИД, СписокДокументов);
		
		ЗафиксироватьТранзакцию();
		                                              
	КонецЦикла;   
	
	Возврат СписокДокументов;
	
КонецФункции
#КонецОбласти

							
#Область СлужебныйПрограммныйИнтерфейс
Функция ПолучитьМассивОрганизацияПотребностиБезПравил(ПериодЗакупокВход, Параметры) Экспорт   
	
	РезультатФункции = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.Организация КАК Организация,
		|	ЕСТЬNULL(ДействиеПоложенийОЗакупках.Положение, ЗНАЧЕНИЕ(Справочник.ПоложениеОЗакупках.ПустаяСсылка)) КАК Положение,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Характеристика КАК Характеристика,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ДанныеРегистра.КоличествоОстаток КАК КоличествоОстаток,
		|	ДанныеРегистра.СуммаОстаток КАК СуммаОстаток,
		|	ДанныеРегистра.АналитикаПланирования КАК АналитикаПланирования
		|ПОМЕСТИТЬ ВТ_ДанныеПотребностей
		|ИЗ
		|	РегистрНакопления.ПланированиеПотребностей.Остатки(
		|			,
		|			(АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ЗаявкиНаЗакупку)
		|				ИЛИ АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ЗаявкиСогласованные))
		|				И (АналитикаПланирования.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода)) КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействиеПоложенийОЗакупках КАК ДействиеПоложенийОЗакупках
		|		ПО ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.Организация = ДействиеПоложенийОЗакупках.Организация
		|			И (ДействиеПоложенийОЗакупках.ПериодЗакупок = &ПериодЗакупок)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ДействиеПоложенийОЗакупках.Положение, ЗНАЧЕНИЕ(Справочник.ПоложениеОЗакупках.ПустаяСсылка)),
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.Характеристика,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения,
		|	ДанныеРегистра.КоличествоОстаток,
		|	ДанныеРегистра.СуммаОстаток,
		|	ДанныеРегистра.АналитикаПланирования.АналитикаСтруктуры.Организация,
		|	ДанныеРегистра.АналитикаПланирования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеПотребностей.Организация КАК Организация,
		|	ВТ_ДанныеПотребностей.Номенклатура КАК Номенклатура,
		|	ВТ_ДанныеПотребностей.Характеристика КАК Характеристика,
		|	ВТ_ДанныеПотребностей.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_ДанныеПотребностей.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	ВТ_ДанныеПотребностей КАК ВТ_ДанныеПотребностей
		|ГДЕ
		|	ВТ_ДанныеПотребностей.Положение = ЗНАЧЕНИЕ(Справочник.ПоложениеОЗакупках.ПустаяСсылка)
		|	И (&ВсеОрганизации
		|			ИЛИ ВТ_ДанныеПотребностей.Организация В (&Организация))";   
	      
	
	Организации = Неопределено;
	Если Параметры <> Неопределено Тогда
		Если Параметры.Свойство("ОтборыПоРеквизитам") И Параметры.ОтборыПоРеквизитам.Свойство("Организация") Тогда
			Организации = Параметры.ОтборыПоРеквизитам.Организация.Значение;
		КонецЕсли;
	КонецЕсли;    
	
	Запрос.УстановитьПараметр("НачалоПериода", Параметры.ПериодЗакупок.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Параметры.ПериодЗакупок.ДатаОкончания);
	Запрос.УстановитьПараметр("ПериодЗакупок", ПериодЗакупокВход);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организации = Неопределено);
	Запрос.УстановитьПараметр("Организация", 	?(Организации <> Неопределено, Организации, Новый СписокЗначений));
	
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	РезультатФункции = Выгрузка.ВыгрузитьКолонку("Организация");
	РезультатФункции = ОбщегоНазначенияКлиентСервер.СвернутьМассив(РезультатФункции);
	РезультатФункции = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(РезультатФункции);
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьМассивОрганизацияПотребностиБезПравил()

Функция ВсеПотребностиВКорзине(ПроектОтбор, КорзинаДерево)
	
	Перем КолонкаДерева, КорзинаТаблица, Потребность, Проект;
	
	КорзинаТаблица = Новый ТаблицаЗначений;
	Для Каждого КолонкаДерева Из КорзинаДерево.Колонки Цикл 
		КорзинаТаблица.Колонки.Добавить(КолонкаДерева.Имя, КолонкаДерева.ТипЗначения, КолонкаДерева.Заголовок);
	КонецЦикла;    
	Если ПроектОтбор = Неопределено Тогда
		Для Каждого Проект Из КорзинаДерево.Строки Цикл     
			Для Каждого Потребность Из Проект.Строки Цикл    
				ЗаполнитьЗначенияСвойств(КорзинаТаблица.Добавить(), Потребность);
			КонецЦикла;                                                   
		КонецЦикла;
	Иначе
		Для Каждого Потребность Из ПроектОтбор.Строки Цикл    
			ЗаполнитьЗначенияСвойств(КорзинаТаблица.Добавить(), Потребность);
		КонецЦикла;
	КонецЕсли;
	Возврат КорзинаТаблица;

КонецФункции

Функция СформироватьДеревоПараметровЗакупки(ДанныеСПЗ, Знач ТаблицаПараметровЗакупки = неопределено)
	
	Если ТаблицаПараметровЗакупки = неопределено Тогда
		ТаблицаПараметровЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
	КонецЕсли;       
	
	ТаблицаПараметровЗакупкиКопия = ТаблицаПараметровЗакупки.Скопировать();   
	
	ЭтоУХ = ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы");
	
	//
	Дерево = Новый ДеревоЗначений;
	Таблица = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей().Выгрузить();
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Дерево.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;    
	
	Дерево.Колонки.Добавить("ДетальнаяЗапись", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ИндексКартинки", ОбщегоНазначения.ОписаниеТипаЧисло(3,0));   
	
	// Формируем список необходимых реквизитов таблицы ДанныеСПЗ
	мРеквизитыПотребностей = Новый Массив;
	мРеквизитыПотребностей.Добавить("АналитикаНоменклатуры");
	мРеквизитыПотребностей.Добавить("АналитикаПотребностей");
	мРеквизитыПотребностей.Добавить("АналитикаСтруктуры");
	мРеквизитыПотребностей.Добавить("ПоложениеОЗакупках");
	мРеквизитыПотребностей.Добавить("УИДУсловия");    
	
	Для Каждого ПараметрЗакупки Из ТаблицаПараметровЗакупкиКопия Цикл   
		Если ДанныеСПЗ.Колонки.Найти(ПараметрЗакупки.ПараметрИмя) <> Неопределено Тогда
			мРеквизитыПотребностей.Добавить(ПараметрЗакупки.ПараметрИмя);     
		КонецЕсли;                           
		Если ДанныеСПЗ.Колонки.Найти(ПараметрЗакупки.ЗапретИзменения) <> Неопределено Тогда
			мРеквизитыПотребностей.Добавить(ПараметрЗакупки.ЗапретИзменения);  
		КонецЕсли;
	КонецЦикла;
	РеквизитыПотребностей = СтрСоединить(мРеквизитыПотребностей, ",");
	
	//
	Потребности = ДанныеСПЗ.Скопировать(,РеквизитыПотребностей);
	Потребности.Свернуть(РеквизитыПотребностей);    
	
	РеквизитыОплаты = ?(ЭтоУХ, 
						"", 
						", КалендарьГрафика, ЗапретИзменения_КалендарьГрафика, ГрафикОплаты, ЗапретИзменения_ГрафикОплаты");  
	Колонки = СтрРазделить("ПоложениеОЗакупках, УИДУсловия, " + РеквизитыОплаты, ",");      
	КолонкиРезультат = Новый Массив;
	Для Каждого ИмяКолонки Из Колонки Цикл    
		Если ДанныеСПЗ.Колонки.Найти(СокрЛП(ИмяКолонки)) <> Неопределено Тогда
			КолонкиРезультат.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОплатыПроектов = ДанныеСПЗ.Скопировать(, СтрСоединить(КолонкиРезультат, ", ")); 
	ПараметрыОплатыПроектов.Свернуть(СтрСоединить(КолонкиРезультат, ", "));  
	
	Если Не ЭтоУХ Тогда
		Для Каждого ПараметрыОплатыПроекта Из ПараметрыОплатыПроектов Цикл   
			ПараметрыОплаты = Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(ПараметрыОплатыПроекта.ПоложениеОЗакупках, ПараметрыОплатыПроекта.УИДУсловия);	
			ЗаполнитьЗначенияСвойств(ПараметрыОплатыПроекта, ПараметрыОплаты, РеквизитыОплаты);  	
		КонецЦикла; 
	КонецЕсли;
	
	//
	Для Каждого ПараметрЗакупки Из ТаблицаПараметровЗакупкиКопия Цикл
		ДеревоСвойство = Дерево.Строки.Добавить();
		ДеревоСвойство.Свойство = ПараметрЗакупки.Параметр;
		ДеревоСвойство.ДетальнаяЗапись = Ложь;       
		
		Для Каждого СтрокаПотребности Из Потребности Цикл   
			
			Если Не ЭтоУХ Тогда
				//ПараметрыОплаты
				ПараметрыОплатыСтроки = ПараметрыОплатыПроектов.НайтиСтроки(Новый Структура("ПоложениеОЗакупках, УИДУсловия", 
				СтрокаПотребности.ПоложениеОЗакупках, 
				СтрокаПотребности.УИДУсловия));
				Если ПараметрыОплатыСтроки.Количество() = 0 Тогда       
					ПараметрыОплаты = Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(СтрокаПотребности.ПоложениеОЗакупках, СтрокаПотребности.УИДУсловия); 
					НовыйПараметр = ПараметрыОплатыПроектов.Добавить();    
					ЗаполнитьЗначенияСвойств(НовыйПараметр, ПараметрыОплаты);
				Иначе
					ПараметрыОплаты = ПараметрыОплатыСтроки[0];
				КонецЕсли; 
				
				Если Потребности.Колонки.Найти(ПараметрЗакупки.ПараметрИмя) = Неопределено Или Потребности.Колонки.Найти(ПараметрЗакупки.ЗапретИзменения) = Неопределено Тогда
					Продолжить;
				КонецЕсли;         
			КонецЕсли;
			
			Если СтрокаПотребности[ПараметрЗакупки.ПараметрИмя] <> Null Тогда  
				
				Если Не ЭтоУХ Тогда
					//ГрафикОплаты
					Если ПараметрЗакупки.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты Тогда
						СтрокаПотребности.ГрафикОплаты 					= ПараметрыОплаты.ГрафикОплаты;  
						СтрокаПотребности.ЗапретИзменения_ГрафикОплаты 	= ПараметрыОплаты.ЗапретИзменения_ГрафикОплаты;    
					КонецЕсли;   
					//КалендарьГрафика
					Если ПараметрЗакупки.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.КалендарьГрафика Тогда
						СтрокаПотребности.КалендарьГрафика 					= ПараметрыОплаты.КалендарьГрафика;  
						СтрокаПотребности.ЗапретИзменения_КалендарьГрафика 	= ПараметрыОплаты.ЗапретИзменения_КалендарьГрафика;    
					КонецЕсли;  
				КонецЕсли;
				
				СтрокаДерева = ДеревоСвойство.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаПотребности);
				СтрокаДерева.Свойство = ДеревоСвойство.Свойство;
				СтрокаДерева.Значение = СтрокаПотребности[ПараметрЗакупки.ПараметрИмя];
				СтрокаДерева.ЗапретИзменения = СтрокаПотребности[ПараметрЗакупки.ЗапретИзменения];
				СтрокаДерева.ДетальнаяЗапись = Истина;
				СтрокаДерева.ИндексКартинки = ?(СтрокаДерева.ЗапретИзменения, 0, 1);      
				
				СтрокаДерева.ПоложениеОЗакупках = СтрокаПотребности.ПоложениеОЗакупках;
				СтрокаДерева.УИДУсловия = СтрокаПотребности.УИДУсловия; 
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//
	РассчитатьИтоговыеПараметрыЗакупки(Дерево);
	
	Возврат Дерево;
	
КонецФункции

Функция СформироватьПараметрыЗакупкиКорзины(Автор, ПериодЗакупки, ПустойУИД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ПустойУИД", ПустойУИД);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура.КодОКПД2 КАК ОКПД2,
	|	ВЫБОР
	|		КОГДА ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.ТоварныеКатегории
	|			ТОГДА ВЫРАЗИТЬ(ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура КАК Справочник.ТоварныеКатегории)
	|		КОГДА ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ВЫРАЗИТЬ(ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура КАК Справочник.Номенклатура).ТоварнаяКатегория
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
	|	КОНЕЦ КАК ТоварнаяКатегория,
	|	СУММА(ПроектыСПЗПозиции.Количество) КАК КоличествоКОбработке,
	|	СУММА(ПроектыСПЗПозиции.Сумма) КАК СуммаКОбработке
	|ПОМЕСТИТЬ ВТ_Потребности
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ИД = &ПустойУИД
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.ПериодЗакупки,
	|	ПроектыСПЗПозиции.ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаПотребностей
	|
	|ИМЕЮЩИЕ
	|	НЕ(СУММА(ПроектыСПЗПозиции.Количество) = 0
	|			И СУММА(ПроектыСПЗПозиции.Сумма) = 0)
	|;
	|"
