&НаКлиенте
Процедура КорзинаПроектыСПЗОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	КорзинаПроектыСПЗОкончаниеПеретаскиванияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОтборовКорзиныОтборПриИзменении(Элемент)
	ТекущиеДанные = ЭтотОбъект.ДеревоОтборовКорзина.НайтиПоИдентификатору(Элементы.ДеревоОтборовКорзины.ТекущаяСтрока);           
	Родитель = ТекущиеДанные.ПолучитьРодителя();             
	Если Родитель.ТолькоОдноЗначение Тогда      
		Если ТекущиеДанные.Отбор Тогда
			Для Каждого СтрокаГруппировки Из Родитель.ПолучитьЭлементы() Цикл 
				Если СтрокаГруппировки <> ТекущиеДанные Тогда
					СтрокаГруппировки.Отбор = Ложь;
				КонецЕсли;
			КонецЦикла;   
		Иначе
			ТекущиеДанные.Отбор = Истина;
		КонецЕсли;
	КонецЕсли;  
	
	Если Родитель.ИмяРеквизита = "ФорматДаты" Тогда
		ПересчитатьДанныеПроектов(ОбщегоНазначенияКлиентСервер.МассивЗначений("Валюта", "СпособЗакупки", "Контрактант"), ЗначениеДереваОтбораКорзина("ФорматДаты")[0]);
	КонецЕсли;
	
	Если Родитель.ИмяРеквизита = "ОрганизацияЗаказчик" Тогда    
		ЭтотОбъект.ПотребностиВКорзине.Отбор.Элементы.Очистить();
		Отбор = ЭтотОбъект.ПотребностиВКорзине.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОрганизацияЗаказчик");
		Отбор.ПравоеЗначение = ТекущиеДанные.ЗначениеОтбора;
	КонецЕсли;   
	
	Если Родитель.ИмяРеквизита = "Группировки" Тогда
		Элементы.КорзинаПроектыСПЗСформироватьПроекты.Заголовок = Нстр("ru = 'Применить'");   
		Элементы.КорзинаПроектыСПЗСформироватьПроекты.Доступность = Истина;    
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПотребностиВКорзинеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаСервере
Процедура КорзинаУдалитьНаСервере()
	ВыделенныеСтроки = Элементы.КорзинаПроектыСПЗ1.ВыделенныеСтроки;    
	Проекты = КорзинаПроектыСПЗ.ПолучитьЭлементы();
	
	Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл    
		Позиция = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(НомерСтроки);  
		Если Не Позиция.ЭтоПроект Тогда  
			Проект = Позиция.ПолучитьРодителя(); 
			ЭлементыРодителя = Проект.ПолучитьЭлементы();
			ЭлементыРодителя.Удалить(Позиция); 
		КонецЕсли;
	КонецЦикла;    
	Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл    
		Позиция = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(НомерСтроки);  
		Если Позиция <> Неопределено И Позиция.ЭтоПроект Тогда     
			Проекты.Удалить(Позиция);
		КонецЕсли;
	КонецЦикла;   
	Для Каждого Проект Из Проекты Цикл 
		ЭлементыРодителя = Проект.ПолучитьЭлементы();
		Если ЭлементыРодителя.Количество() = 0 Тогда 
			Проекты.Удалить(Проект);
		КонецЕсли;
	КонецЦикла;
	
	КорзинаПроектыСПЗ1ПослеУдаленияНаСервере();    
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаУдалить(Команда) 
	КорзинаУдалитьНаСервере();
КонецПроцедуры  

&НаСервере
Процедура КорзинаПроектыСПЗ1ПриИзмененииНаСервере() 
	
	ТекущиеДанные = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
		|	ПроектыСПЗПозиции.Автор КАК Автор,
		|	ПроектыСПЗПозиции.ИД КАК ИД,
		|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
		|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ПроектыСПЗПозиции.Валюта КАК Валюта,
		|	ПроектыСПЗПозиции.АналитикаИсточника КАК АналитикаИсточника,
		|	ПроектыСПЗПозиции.АналитикаПланирования КАК АналитикаПланирования,
		|	ПроектыСПЗПозиции.Количество КАК Количество,
		|	ПроектыСПЗПозиции.Сумма КАК Сумма,
		|	ПроектыСПЗПозиции.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
		|ГДЕ
		|	ПроектыСПЗПозиции.АналитикаИсточника = &АналитикаИсточника
		|	И ПроектыСПЗПозиции.АналитикаПланирования = &АналитикаПланирования";
	
	Запрос.УстановитьПараметр("АналитикаИсточника", 	ТекущиеДанные.АналитикаИсточника);
	Запрос.УстановитьПараметр("АналитикаПланирования", 	ТекущиеДанные.АналитикаПланирования);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Менеджер = РегистрыСведений.ПроектыСПЗПозиции.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер, ВыборкаДетальныеЗаписи);
		ЗаполнитьЗначенияСвойств(Менеджер, ТекущиеДанные, "Количество, Сумма");	
		Менеджер.Записать();
	КонецЦикла;
	
	УстановитьТекстИнформационнойНадписи();   
	Элементы.СписокПотребности.Обновить(); 
	
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Заголовок = Нстр("ru = 'Применить'");   
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Доступность = Истина; 
	
КонецПроцедуры 

&НаКлиенте
Процедура КорзинаПроектыСПЗ1ПриИзменении(Элемент)
	Если Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока <> Неопределено Тогда   
		ТекущиеДанные = Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные;
		Если ТекущиеДанные.ЭтоНоменклатура Тогда
			Если ТекущиеДанные.Количество > ТекущиеДанные.КоличествоИсходное Тогда
				ТекущиеДанные.Количество = ТекущиеДанные.КоличествоИсходное;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Нстр("ru = 'Превышено исходное значение - %1'"), ТекущиеДанные.Количество),,, 
																	СтрШаблон("КорзинаПроектыСПЗ[%1].Количество", ТекущиеДанные.ПолучитьИдентификатор())); 
			КонецЕсли;
			ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;   
		Иначе
			Если ТекущиеДанные.Сумма > ТекущиеДанные.СуммаИсходная Тогда
				ТекущиеДанные.Сумма = ТекущиеДанные.СуммаИсходная;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Нстр("ru = 'Превышено исходное значение - %1'"), ТекущиеДанные.СуммаИсходная),,, 
																	СтрШаблон("КорзинаПроектыСПЗ[%1].Сумма", ТекущиеДанные.ПолучитьИдентификатор())); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	КорзинаПроектыСПЗ1ПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КорзинаПроектыСПЗ1ПослеУдаленияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", 			ЭтотОбъект.ТекущийПользователь);
	Запрос.УстановитьПараметр("ПустойУИД", 		ПотребностиУХ.ПустойУИД());   
	
	Потребности = Новый ТаблицаЗначений;
	Потребности.Колонки.Добавить("АналитикаПланирования", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикПланирования")); 
	Потребности.Колонки.Добавить("АналитикаИсточника", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикПланирования"));
	Для Каждого Проект Из ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы() Цикл
		Для Каждого Потребность Из Проект.ПолучитьЭлементы() Цикл      
			ЗаполнитьЗначенияСвойств(Потребности.Добавить(), Потребность);
		КонецЦИкла;
	КонецЦикла;      
	Потребности.Индексы.Добавить("АналитикаПланирования, АналитикаИсточника");    
	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроектыСПЗ.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗ.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗ.Автор КАК Автор,
	|	ПроектыСПЗ.ИД КАК ИД,
	|	ПроектыСПЗ.АналитикаИсточника КАК АналитикаИсточника,
	|	ПроектыСПЗ.АналитикаПланирования КАК АналитикаПланирования
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗ
	|ГДЕ
	|	ПроектыСПЗ.Автор = &Автор
	|	И ПроектыСПЗ.ИД = &ПустойУИД";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		
		// ПозицииСПЗ
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗПозиции");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ОрганизацияЗаказчик", 	"ОрганизацияЗаказчик");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодЗакупки", 		"ПериодЗакупки");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Автор", 				"Автор");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИД", 					"ИД");
		
		Блокировка.Заблокировать();
		
		Для Каждого Строка Из Результат Цикл     
			
			Если Потребности.НайтиСтроки(Новый Структура("АналитикаПланирования, АналитикаИсточника", 
															Строка.АналитикаПланирования, Строка.АналитикаИсточника)).Количество() Тогда
				Продолжить;
			КонецЕсли;
		
			// ПроектыСПЗПозиции
			нз = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(ЭтотОбъект.ТекущийПользователь);
			нз.Отбор.ИД.Установить(Строка.ИД);    
			нз.Отбор.АналитикаИсточника.Установить(Строка.АналитикаИсточника); 
			нз.Отбор.АналитикаПланирования.Установить(Строка.АналитикаПланирования);
			нз.Очистить();
			нз.Записать(Истина);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
	
		ОтменитьТранзакцию();
		
		ТекстШаблона = НСтр("ru = 'Очистка корзины пользователя %1 за период %2'");
		ТекстСообщения = СтрШаблон(ТекстШаблона, ЭтотОбъект.ТекущийПользователь, ЭтотОбъект.ПериодПотребностей);
		
	    ЗаписьЖурналаРегистрации(ТекстСообщения,
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ВызватьИсключение;
		
	КонецПопытки;
	
	Элементы.СписокПотребности.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗ1ПослеУдаления(Элемент)
	КорзинаПроектыСПЗ1ПослеУдаленияНаСервере();
КонецПроцедуры

