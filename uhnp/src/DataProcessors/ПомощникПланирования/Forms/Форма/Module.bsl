&НаСервере
Функция ВыделитьВПроектНаСервере()       
	
	Родитель = Неопределено;      
	СтрокиПереноса = Новый Массив;          
	
	Для Каждого ИдСтроки Из Элементы.КорзинаПроектыСПЗ1.ВыделенныеСтроки Цикл
		Потребность = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(ИдСтроки);
		Если Потребность.ПолучитьРодителя() = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru = 'Выделять в новую группировку можно только потребности'"), , "КорзинаПроектыСПЗ1");
			Возврат Неопределено;    
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИдСтроки Из Элементы.КорзинаПроектыСПЗ1.ВыделенныеСтроки Цикл
		Потребность = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(ИдСтроки);
		Если Родитель = Неопределено Тогда
			Родитель = Потребность.ПолучитьРодителя();
		КонецЕсли;
		Если Родитель <> Потребность.ПолучитьРодителя() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru = 'Выделять в новую группировку можно только потребности одной группировки'"), , "КорзинаПроектыСПЗ1");
			Возврат Неопределено;    
		Иначе
			СтрокиПереноса.Добавить(ИдСтроки);	
		КонецЕсли;
	КонецЦикла;    
	
	Если СтрокиПереноса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущиеДанные = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(ДобавитьПроектНаСервере());  
	
	Для Каждого Значение Из СтрокиПереноса Цикл
		СтрокаПереноса = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Значение);
		НоваяПотребность = ТекущиеДанные.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПотребность, СтрокаПереноса);	
		
		НоваяПотребность.Контрактант = ТекущиеДанные.Контрактант;    
		
		РодительУдаляемойСтроки = СтрокаПереноса.ПолучитьРодителя();
		РодительУдаляемойСтроки.ПолучитьЭлементы().Удалить(СтрокаПереноса);      
		Если РодительУдаляемойСтроки.ПолучитьЭлементы().Количество() = 0 Тогда
			ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Удалить(РодительУдаляемойСтроки);     
		КонецЕсли;
		
	КонецЦикла;     
	
	КорзинаПроектыСПЗОкончаниеПеретаскиванияНаСервере();    
	
	Возврат ТекущиеДанные.ПолучитьИдентификатор();
	
КонецФункции

&НаКлиенте
Процедура ВыделитьВПроект(Команда)   
	Если Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока <> Неопределено Тогда
		Ид = ВыделитьВПроектНаСервере();    
		Если Ид <> Неопределено Тогда
			Элементы.КорзинаПроектыСПЗ1.Развернуть(Ид);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗ1ПриАктивизацииСтроки(Элемент)       
	
	Если Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	СуммаКорзины = "";
	Сумма = 0;           
	Проект = Неопределено;                   
	
	Для Каждого Строка Из Элементы.КорзинаПроектыСПЗ1.ВыделенныеСтроки Цикл      
		
		Потребность = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Строка);  
		
		Если Потребность.ЭтоПроект Тогда
			Сумма = 0;  
			Прервать;
		КонецЕсли;     
		
		Сумма = Сумма +Потребность.Сумма;
		
	КонецЦикла;  
	
	СуммаКорзины = СтрШаблон(Нстр("ru = 'Σ %1'"), Формат(Сумма, "ЧДЦ=2; ЧРД=.; ЧРГ=' '; ЧГ=3,0"));
	
КонецПроцедуры

&НаСервере
Процедура КонтрактантПриИзмененииНаСервере()  
	
	
КонецПроцедуры

&НаКлиенте                                                         
Процедура КонтрактантПриИзменении(Элемент)
	КонтрактантПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗ1Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные;    
	Если ТекущиеДанные.ЭтоПроект Тогда      
		СтандартнаяОбработка = Ложь; 
		ПоказатьВводСтроки(Новый ОписаниеОповещения("КорзинаПроектыСПЗ1ВыборЗавершение", 
													ЭтаФорма, 
													Новый Структура("ТекущиеДанные", 
																	ТекущиеДанные)), 
							ТекущиеДанные.ПредставлениеПотребности, 
							Нстр("ru = 'Описание документа'"),);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗ1ВыборЗавершение(Строка, ДополнительныеПараметры) Экспорт   
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекущиеДанные.ПредставлениеПотребности = Строка;

КонецПроцедуры

