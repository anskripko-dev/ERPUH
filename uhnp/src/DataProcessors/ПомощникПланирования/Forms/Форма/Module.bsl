		Для Каждого Колонка Из Колонки Цикл
			Если СтрНайти(КолонкаГруппировки, Колонка.Имя) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Значение = СтрокаРеквизита.Строки.Добавить();   
