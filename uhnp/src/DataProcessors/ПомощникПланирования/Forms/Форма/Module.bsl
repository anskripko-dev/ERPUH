			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Нстр("ru = '<Обработать>'"), Новый Шрифт("Consolas",,Истина,,Истина), ЦветаСтиля.ГиперссылкаЦвет, , "Обработать_ВыполнитьОбработкуАналогов"));
