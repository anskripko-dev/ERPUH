&НаКлиенте
Процедура СписокПотребностиРасшифроватьПоПериодуПотребности(Команда)
	
	ДопПараметры = Новый Структура("Объект", Объект);
	Отбор = Новый Структура;
	Отбор.Вставить("ТекущийПользователь", ТекущийПользователь);
	Отбор.Вставить("ПустойУИД", ПустойУИД);
	
	ТД = Элементы.СписокПотребности.ТекущиеДанные;
	
	Отбор.Вставить("Номенклатура", ТД.Номенклатура);
	Если ТД.Свойство("Характеристика") Тогда
		Отбор.Вставить("Характеристика", ТД.Характеристика);
	КонецЕсли;
	Отбор.Вставить("МестоПоставки", ТД.МестоПоставки);
	Отбор.Вставить("Организация", ТД.Организация);
	Отбор.Вставить("Проект", ТД.Проект);
	
	ДопПараметры.Вставить("Отбор", Отбор);
	
	Если СтрначинаетсяС(ИмяФормы, "Внешняя") Тогда
		ОткрытьФорму("ВнешняяОбработка.ПомощникПланирования.Форма.РасшифровкаПоПериодамПотребности", ДопПараметры, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Обработка.ПомощникПланирования.Форма.РасшифровкаПоПериодамПотребности", ДопПараметры, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗакупокНовогоПроектаСПЗВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Возврат;
	
	ТД = Элемент.ТекущиеДанные;
	Если ТД = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТД.ПоложениеОЗакупках) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДопПараметры = Новый Структура("Ключ, УИДУсловия", ТД.ПоложениеОЗакупках, ТД.УИДУсловия);
	ОткрытьФорму("Справочник.ПоложениеОЗакупках.Форма.ФормаЭлемента", ДопПараметры, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПравило(Команда)
	
	ТД = Элементы.ПараметрыЗакупокНовогоПроектаСПЗ.ТекущиеДанные;
	Если ТД = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТД.ПоложениеОЗакупках) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДопПараметры = Новый Структура("Ключ, УИДУсловия", ТД.ПоложениеОЗакупках, ТД.УИДУсловия);
	ОткрытьФорму("Справочник.ПоложениеОЗакупках.Форма.ФормаЭлемента", ДопПараметры, Элементы.ПараметрыЗакупокНовогоПроектаСПЗ);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПроектыНаСервере()
	
	Схема = Новый СхемаКомпоновкиДанных;      
	Источник = Схема.ИсточникиДанных.Добавить();   
	Источник.Имя = "ИсточникДанных";
	Источник.ТипИсточникаДанных = "Local";   
	
	КорзинаТаблица = ВсеПотребностиВКорзине(Неопределено);
	ВнешниеНаборыДанных = Новый Структура("ВыбранныеПотребности", КорзинаТаблица);
	
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			= "НаборДанныхВыбранныеПотребности";
	НаборДанных.ИмяОбъекта 		= "ВыбранныеПотребности";
	НаборДанных.ИсточникДанных 	= "ИсточникДанных";
	Для Каждого Колонка Из ВнешниеНаборыДанных.ВыбранныеПотребности.Колонки Цикл
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле 		 =  Колонка.Имя;
		Поле.ПутьКДанным = Колонка.Имя;
	КонецЦикла;  
	
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));       
	НаборДанных.Имя 			= "НаборДанных1";  
	НаборДанных.ИсточникДанных	= "ИсточникДанных";
	НаборДанных.Запрос 			= "ВЫБРАТЬ
	                   			  |	ВТ_ПараметрыЗакупок.КлючПараметровЗакупки КАК КлючПараметровЗакупки,
	                   			  |	ВТ_ПараметрыЗакупок.КлючПараметровЗакупки.СпособЗакупки КАК СпособЗакупки,
	                   			  |	ВТ_ПараметрыЗакупок.ПериодЗакупки КАК ПериодЗакупки,
	                   			  |	ВТ_ПараметрыЗакупок.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	                   			  |	ВТ_ПараметрыЗакупок.АналитикаПотребностей КАК АналитикаПотребностей,
	                   			  |	ВТ_ПараметрыЗакупок.АналитикаСтруктуры КАК АналитикаСтруктуры,
	                   			  |	ВТ_ПараметрыЗакупок.Автор КАК Автор,
	                   			  |	ВЫБОР
	                   			  |		КОГДА Организации.ИспользоватьПрограммуЗакупок = ИСТИНА
	                   			  |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыВключенияПозицийПотребностей.СПЗ)
	                   			  |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВариантыВключенияПозицийПотребностей.Лот)
	                   			  |	КОНЕЦ КАК ВидДокументаЗакупки,
	                   			  |	ВЫБОР
	                   			  |		КОГДА КлючиПараметровЗакупки.ЗапретИзменения_СпособЗакупки
	                   			  |			ТОГДА 0
	                   			  |		ИНАЧЕ 1
	                   			  |	КОНЕЦ КАК ЗапретИзменения_СпособЗакупки
	                   			  |ИЗ
	                   			  |	РегистрСведений.ПараметрыЗакупкиПотребностей1 КАК ВТ_ПараметрыЗакупок
	                   			  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПланированияСтруктуры КАК КлючиАналитикиПланированияСтруктуры
	                   			  |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	                   			  |			ПО КлючиАналитикиПланированияСтруктуры.Организация = Организации.Ссылка
	                   			  |		ПО ВТ_ПараметрыЗакупок.АналитикаСтруктуры = КлючиАналитикиПланированияСтруктуры.Ссылка
	                   			  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиПараметровЗакупки КАК КлючиПараметровЗакупки
	                   			  |		ПО ВТ_ПараметрыЗакупок.КлючПараметровЗакупки = КлючиПараметровЗакупки.Ссылка";    
	
	Колонки = СтрРазделить("КлючПараметровЗакупки, СпособЗакупки, ЗапретИзменения_СпособЗакупки, ПериодЗакупки, АналитикаНоменклатуры, АналитикаПотребностей, АналитикаСтруктуры, Автор, ВидДокументаЗакупки, Контрактант, Обеспечение", ", ", Ложь);
	Для Каждого Колонка Из Колонки Цикл
		// Поле набора данных
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле 		 = Колонка;
		Поле.ПутьКДанным = Колонка;
	КонецЦикла; 
	
	// Связь набора данных
	ДобавитьСвязьДанных(Схема, "АналитикаСтруктуры", 	"АналитикаСтруктуры");   
	ДобавитьСвязьДанных(Схема, "АналитикаНоменклатуры", "АналитикаНоменклатуры");
	ДобавитьСвязьДанных(Схема, "АналитикаПотребностей", "АналитикаПотребностей");
	
	Настройки = Схема.НастройкиПоУмолчанию;
	
	ГруппировкаСхемы = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));    
	ГруппировкаСхемы.Использование = Истина;       
	
	Группировки = ЗначениеДереваОтбораКорзина("Группировки");
	ФорматДаты = ЗначениеДереваОтбораКорзина("ФорматДаты")[0];
	
	Для Каждого ЗначениеГруппировки Из Группировки Цикл   
		ДобавитьГруппировкуВПроектЗакупки(ГруппировкаСхемы, ЗначениеГруппировки);
	КонецЦикла;              
	
	ГруппировкаНоменклутуры = ГруппировкаСхемы.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));    
	ГруппировкаНоменклутуры.Использование = Истина;     
	
	Для Каждого Колонка Из ВнешниеНаборыДанных.ВыбранныеПотребности.Колонки Цикл
		
		Выбор = ГруппировкаНоменклутуры.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));      
		Выбор.Использование = Истина;
		Выбор.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);    
		
	КонецЦикла;      
	
	Выбор = ГруппировкаНоменклутуры.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
	Выбор.Использование = Истина;
	Выбор.Поле = Новый ПолеКомпоновкиДанных("СпособЗакупки");      
	
	Выбор = ГруппировкаНоменклутуры.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
	Выбор.Использование = Истина;
	Выбор.Поле = Новый ПолеКомпоновкиДанных("ЗапретИзменения_СпособЗакупки");
	
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
                            
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
    
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;  
	
	ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Очистить();
	Дерево = РеквизитФормыВЗначение("КорзинаПроектыСПЗ");
	
	ПроцессорВывода.УстановитьОбъект(Дерево);
    
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);       
	ЗначениеВРеквизитФормы(Дерево, "КорзинаПроектыСПЗ");     
	
	ПересчитатьДанныеПроектов(Группировки, 
								ЗначениеДереваОтбораКорзина("ФорматДаты")[0],
								"Контрактант, СпособЗакупки, Валюта, Организатор, Обеспечение");
	ЭтотОбъект.Элементы.СписокПотребности.Обновить();
	
КонецПроцедуры

&НаСервере
Функция ВсеПотребностиВКорзине(ПроектОтбор)
	
	Перем КолонкаДерева, КорзинаДерево, КорзинаТаблица, Потребность, Проект;
	
	КорзинаДерево = РеквизитФормыВЗначение("КорзинаПроектыСПЗ");   
	КорзинаТаблица = Новый ТаблицаЗначений;
	Для Каждого КолонкаДерева Из КорзинаДерево.Колонки Цикл 
		КорзинаТаблица.Колонки.Добавить(КолонкаДерева.Имя, КолонкаДерева.ТипЗначения, КолонкаДерева.Заголовок);
	КонецЦикла;    
	Если ПроектОтбор = Неопределено Тогда
		Для Каждого Проект Из КорзинаДерево.Строки Цикл     
			Для Каждого Потребность Из Проект.Строки Цикл    
				ЗаполнитьЗначенияСвойств(КорзинаТаблица.Добавить(), Потребность);
			КонецЦикла;                                                   
		КонецЦикла;
	Иначе
		Для Каждого Потребность Из ПроектОтбор.Строки Цикл    
			ЗаполнитьЗначенияСвойств(КорзинаТаблица.Добавить(), Потребность);
		КонецЦикла;
	КонецЕсли;
	Возврат КорзинаТаблица;

КонецФункции

&НаСервере
Процедура СформироватьПроектыЗакупокНаСервере()
	
	ДеревоПроектов = РеквизитФормыВЗначение("КорзинаПроектыСПЗ");   
	
	// Расчет параметров СПЗ
	ПростыеТипы = Новый Массив;
	ПростыеТипы.Добавить(Тип("Число"));
	ПростыеТипы.Добавить(Тип("Строка"));
	ПростыеТипы.Добавить(Тип("Дата"));
	ПростыеТипы.Добавить(Тип("Булево"));    
	
	Для Каждого Проект Из ДеревоПроектов.Строки Цикл   
		
		НачатьТранзакцию();
		ЗаписьПроект = РегистрыСведений.ПроектыСПЗ.СоздатьМенеджерЗаписи(); 
		ЗаписьПроект.Активность = Истина;
		//Измерения
		ЗаписьПроект.Автор = ЭтотОбъект.ТекущийПользователь; 
		ЗаписьПроект.ПериодЗакупки = ЭтотОбъект.ПериодПотребностей; 
		ЗаписьПроект.ИД = Новый УникальныйИдентификатор;
		ЗаписьПроект.Дата = ТекущаяДата(); 
		
		ЗаписьПроект.МестоПоставки = Проект.МестоПоставки;
		ЗаписьПроект.Обеспечение = Проект.Обеспечение; 
		ЗаписьПроект.ОрганизацияЗаказчик = Проект.Контрактант; 
		ЗаписьПроект.Дата = Проект.ПериодЗакупки;       
		ЗаписьПроект.ОбщиеТребования = Проект.ПредставлениеПотребности;   
		ЗаписьПроект.Сумма = Проект.Сумма;
		ЗаписьПроект.ПериодПредставление = Проект.ПредставлениеДатаОперации;
		  
		
		//Позиции
		Для Каждого Потребность Из Проект.Строки Цикл   
			
			нз = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(ЭтотОбъект.ТекущийПользователь);
			нз.Отбор.ПериодЗакупки.Установить(ЭтотОбъект.ПериодПотребностей);
			нз.Отбор.ИД.Установить(ЭтотОбъект.ПустойУИД);    
			нз.Отбор.АналитикаИсточника.Установить(Потребность.АналитикаИсточника); 
			нз.Отбор.АналитикаПланирования.Установить(Потребность.АналитикаПланирования);
			нз.Очистить();
			нз.Записать(Истина);
		
			Менеджер = РегистрыСведений.ПроектыСПЗПозиции.СоздатьМенеджерЗаписи();     
			ЗаполнитьЗначенияСвойств(Менеджер, Потребность);
			Менеджер.ИД 			= ЗаписьПроект.ИД;     
			Менеджер.Автор 			= ЗаписьПроект.Автор;  
			Менеджер.ПериодЗакупки 	= ЗаписьПроект.ПериодЗакупки;  
			Менеджер.ПериодПотребности = Потребность.ПериодПотребности;     
			
			Менеджер.АналитикаНоменклатуры 	= Менеджер.АналитикаПланирования.АналитикаНоменклатуры;
			Менеджер.АналитикаПотребностей 	= Менеджер.АналитикаПланирования.АналитикаПотребностей; 
			Менеджер.АналитикаСтруктуры 	= Менеджер.АналитикаПланирования.АналитикаСтруктуры;
			
			Менеджер.Записать(Истина);  
			
		КонецЦикла; //Позиции 
		
		// Параметры ПроектаСПЗ
		нзПараметры = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
		нзПараметры.Отбор.Автор.Установить(ЗаписьПроект.Автор);
		нзПараметры.Отбор.ПериодЗакупки.Установить(ЗаписьПроект.ПериодЗакупки);
		нзПараметры.Отбор.ИД.Установить(ЗаписьПроект.ИД);
		нзПараметры.Очистить();
		
		Ключ = Новый Структура("Автор, ПериодЗакупки, ИД, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей",
								ЗаписьПроект.Автор, ЗаписьПроект.ПериодЗакупки, ЗаписьПроект.ИД,
								Справочники.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка(),
								Справочники.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка(),
								Справочники.КлючиАналитикиПланированияПотребностей.ПустаяСсылка());
		
		Итоговые = "Свойство, Значение, ЗапретИзменения";
		Детали = "Свойство, Значение, ЗапретИзменения, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей, ПоложениеОЗакупках, УИДУсловия";  
		//
		СвойстваПроекта = Новый Соответствие;               
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.Организатор, 		Проект.Организатор);
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки, 	Проект.СпособЗакупки);    
		
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.Электронно, 		Проект.СпособЗакупки.ЭлектроннаяФорма); 
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.СМП, 				Проект.СпособЗакупки.МСП);
		СвойстваПроекта.Вставить(ПланыВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП, 	Проект.СпособЗакупки.МСПСубПодряд);
		
		////////////////////////////////////////////////////////////////////////////////////
		
		ДанныеАвтоФормирования = Новый Структура("Параметры", Новый Структура);
		ДанныеАвтоФормирования.Параметры.Вставить("ПериодЗакупки", 	ЭтотОбъект.ПериодПотребностей);
		ДанныеАвтоФормирования.Параметры.Вставить("ПустойУИД", 		ЭтотОбъект.ПустойУИД);
		ДанныеАвтоФормирования.Параметры.Вставить("Автор", 			ЭтотОбъект.ТекущийПользователь);
		
		ВсеПотребности = ВсеПотребностиВКорзине(Проект); 
		ВсеПотребности.Колонки.Количество.Имя = "КоличествоКОбработке"; 
		ВсеПотребности.Колонки.Сумма.Имя = "СуммаКОбработке";
		//
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ОбщегоНазначенияУХ.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ВТ_Потребности", ВсеПотребности);
		
		Для Каждого КлючЗначение Из ДанныеАвтоФормирования.Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;   
		
		Запрос.Текст = ТекстЗапроса_ПолучитьДанныеДляАвтоматическогоФормированияСПЗ();
		Запрос.УстановитьПараметр("ПериодЗакупки",ПериодПотребностей);
		Результат = Запрос.Выполнить();
		
		ПотребностиСПараметрамиЗакупки = Результат.Выгрузить();  
		
		ТаблицаПараметровЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
		
		ПараметрыЗакупки = СформироватьДеревоПараметровЗакупки(ПотребностиСПараметрамиЗакупки, ТаблицаПараметровЗакупки); 
		
		ПараметрыОплатыПроектов = Новый Соответствие;
		
		Для Каждого ПараметрЗакупки Из ПараметрыЗакупки.Строки Цикл   
			
			//ПараметрыОплаты
			ПараметрыОплаты = ПараметрыОплатыПроектов.Получить(ЗаписьПроект.ИД);
			Если ПараметрыОплаты = Неопределено Тогда       
				ПараметрыОплаты = Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(ПараметрЗакупки.ПоложениеОЗакупках, ПараметрЗакупки.УИДУсловия);  
				ПараметрыОплатыПроектов.Вставить(ЗаписьПроект.ИД, ПараметрыОплаты);
				ЗаписьПроект.ПоложениеОплаты 	= ПараметрЗакупки.ПоложениеОЗакупках;
				ЗаписьПроект.УИДУсловияОплаты 	= ПараметрЗакупки.УИДУсловия;	
			КонецЕсли;            
			
			//ГрафикОплаты
			Если ПараметрЗакупки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты Тогда
				ПараметрЗакупки.Значение = ПараметрыОплаты.ГрафикОплаты;  
				ПараметрЗакупки.ЗапретИзменения = ПараметрыОплаты.ЗапретИзменения_ГрафикОплаты;    
			КонецЕсли;   
			//КалендарьГрафика
			Если ПараметрЗакупки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.КалендарьГрафика Тогда
				ПараметрЗакупки.Значение = ПараметрыОплаты.КалендарьГрафика;  
				ПараметрЗакупки.ЗапретИзменения = ПараметрыОплаты.ЗапретИзменения_КалендарьГрафика;    
			КонецЕсли;
			
			
			дв = нзПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(дв, Ключ); 
			дв.Свойство = ПараметрЗакупки.Свойство;
			
			ЗначениеПроекта = СвойстваПроекта.Получить(ПараметрЗакупки.Свойство);
			Если ЗначениеПроекта = Неопределено Тогда           
				дв.Значение = ПараметрЗакупки.Значение;     
			Иначе
				дв.Значение = ЗначениеПроекта;
			КонецЕсли;        
			
		КонецЦикла;
		
		ЗаписьПроект.Записать(Истина); 
		нзПараметры.Записать(Истина); 
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;     
	
	ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Очистить();
		
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДанныеПроектов(Знач Группировки, Знач ФорматДаты, Знач ИтоговыеПоля = "")
	
	Перем ДатаМаксимум, ДатаМинимум, ЗначениеГруппировки, Потребность, ПредставлениеПроекта, Проект;    
	
	ПоляИтогов = СтрРазделить(ИтоговыеПоля, ",", Ложь);
	
	Для Каждого Проект Из ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы() Цикл    
		
		ДатаМинимум = Дата(3999, 12, 31); 
		ДатаМаксимум = Дата(0001, 01, 01); 
		Проект.Сумма = 0;    
		
		Для Каждого Потребность Из Проект.ПолучитьЭлементы() Цикл
			
			Если Не ЗначениеЗаполнено(Потребность.АналитикаНоменклатуры) Тогда
				Потребность.АналитикаНоменклатуры = Потребность.АналитикаПланирования.АналитикаНоменклатуры;
			КонецЕсли;
			
			Потребность.ПредставлениеПотребности = Строка(Потребность.АналитикаНоменклатуры);      
			Проект.Сумма = Проект.Сумма + Потребность.Сумма;       
			Если ДатаМинимум > Потребность.АналитикаПланирования.ДатаОперации Тогда
				ДатаМинимум = Потребность.АналитикаПланирования.ДатаОперации;
			КонецЕсли;
			Если ДатаМаксимум < Потребность.АналитикаПланирования.ДатаОперации Тогда
				ДатаМаксимум = Потребность.АналитикаПланирования.ДатаОперации;
			КонецЕсли;	         
			
			Потребность.ПредставлениеДатаОперации = Формат(Потребность.АналитикаПланирования.ДатаОперации, ФорматДаты);  
			
			Для Каждого ЗначениеГруппировки Из Группировки Цикл    
				Если Не ЗначениеЗаполнено(Проект[ЗначениеГруппировки]) И ЗначениеЗаполнено(Потребность[ЗначениеГруппировки]) Тогда   
					Проект[ЗначениеГруппировки] = Потребность[ЗначениеГруппировки];	
				КонецЕсли;
			КонецЦикла;    
			
			Потребность.ЭтоНоменклатура = (ТипЗнч(Потребность.Номенклатура) = Тип("СправочникСсылка.Номенклатура"));
			
			Для Каждого ПолеИтога Из ПоляИтогов Цикл 
				Если Не ЗначениеЗаполнено(Проект[СокрЛП(ПолеИтога)]) Тогда    
					Проект[СокрЛП(ПолеИтога)] = Потребность[СокрЛП(ПолеИтога)];
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;   
		
		Проект.ПредставлениеДатаОперации = Формат(ДатаМинимум, ФорматДаты) + " - " + Формат(ДатаМаксимум, ФорматДаты);    
		
		ПредставлениеПроекта = Новый Массив;             
		Для Каждого ЗначениеГруппировки Из Группировки Цикл  
			Если ТипЗнч(Проект[ЗначениеГруппировки]) = Тип("ПеречислениеСсылка.ВариантыВключенияПозицийПотребностей") Тогда
				Если Проект[ЗначениеГруппировки] = Перечисления.ВариантыВключенияПозицийПотребностей.Лот Тогда
					ПредставлениеПроекта.Добавить("Лот");
				ИначеЕсли Проект[ЗначениеГруппировки] = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
					ПредставлениеПроекта.Добавить("СПЗ"); 
				Иначе
					ПредставлениеПроекта.Добавить(Строка(Проект[ЗначениеГруппировки]));	
				КонецЕсли; 
			Иначе
				ПредставлениеПроекта.Добавить(Строка(Проект[ЗначениеГруппировки]));	
			КонецЕсли;
		КонецЦикла;
		
		Проект.ПредставлениеПотребности = СтрСоединить(ПредставлениеПроекта, ", "); 
		
		Проект.ЭтоПроект = Истина;    
		
		
	КонецЦикла;  
	
КонецПроцедуры

&НаСервере
Функция ЗначениеДереваОтбораКорзина(Знач Значение)
	
	Перем Параметр, ПодчиненнаяСтрока, Результат;
	
	Результат = Новый Массив;
	Для Каждого Параметр Из ЭтотОбъект.ДеревоОтборовКорзина.ПолучитьЭлементы() Цикл   
		Если Параметр.ИмяРеквизита = Значение Тогда    
			Для Каждого ПодчиненнаяСтрока Из Параметр.ПолучитьЭлементы() Цикл 
				Если ПодчиненнаяСтрока.Отбор Тогда
					Результат.Добавить(ПодчиненнаяСтрока.ЗначениеОтбора);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьГруппировкуВПроектЗакупки(Знач ГруппировкаСхемы, Знач ИмяГруппировки)
	
	Перем Выбор, СпособЗакупки;
	
	СпособЗакупки = ГруппировкаСхемы.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	СпособЗакупки.Поле = Новый ПолеКомпоновкиДанных(ИмяГруппировки);     
	Выбор = ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
	Выбор.Использование = Истина;
	Выбор.Поле = Новый ПолеКомпоновкиДанных(ИмяГруппировки); 
	
	Если ИмяГруппировки = "Контрактант" Тогда 
		ДобавитьГруппировкуВПроектЗакупки(ГруппировкаСхемы, "Обеспечение")
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьСвязьДанных(Знач Схема, Знач ПолеПриемник, Знач ПолеИсточник)
	
	Перем Связь;
	
	Связь = Схема.СвязиНаборовДанных.Добавить();
	Связь.НаборДанныхИсточник = "НаборДанныхВыбранныеПотребности";
	Связь.НаборДанныхПриемник = "НаборДанных1";
	Связь.ВыражениеИсточник = ПолеИсточник;
	Связь.ВыражениеПриемник = ПолеПриемник;
	Связь.Обязательная = Истина; 
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПроекты(Команда)
	СформироватьПроектыНаСервере();    
	Для Каждого Проект Из ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы() Цикл
		Элементы.КорзинаПроектыСПЗ1.Развернуть(Проект.ПолучитьИдентификатор());  
	КонецЦикла;
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Заголовок = Нстр("ru = 'Группировки применены'");   
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Доступность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизации223Да(Команда)
	Объект.Субъекты223ФЗ = Истина; 
	Элементы.ДеревоОрганизацийОтборОрганизации223Да.Пометка = Объект.Субъекты223ФЗ; 
	Элементы.ДеревоОрганизацийОтборОрганизации223Нет.Пометка = Не Объект.Субъекты223ФЗ;
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизации223Нет(Команда)
	Объект.Субъекты223ФЗ = Ложь;  
	Элементы.ДеревоОрганизацийОтборОрганизации223Да.Пометка = Объект.Субъекты223ФЗ; 
	Элементы.ДеревоОрганизацийОтборОрганизации223Нет.Пометка = Не Объект.Субъекты223ФЗ;
КонецПроцедуры

&НаСервере
Функция ДекорацияОрганизацииОтборНажатиеНаСервере()   
	Результат = Новый Структура("ДеревоОрганизацийПолное, ДеревоОрганизаций, Субъекты223ФЗ", 
								ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ДеревоОрганизацийПолное"),Новый УникальныйИдентификатор),
								ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ДеревоОрганизаций"), 		Новый УникальныйИдентификатор),
								Объект.Субъекты223ФЗ);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ДекорацияОрганизацииОтборНажатие(Элемент)
	ПараметрыФормы = ДекорацияОрганизацииОтборНажатиеНаСервере(); 
	ОткрытьФорму("Обработка.ПомощникПланирования.Форма.ОтборОрганизаций", 
					ПараметрыФормы, 
					ЭтотОбъект, 
					Истина,,, 
					Новый ОписаниеОповещения("ДекорацияОрганизацииОтборНажатиеЗавершение", ЭтотОбъект),  
					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОрганизацииОтборНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗагрузитьОтборОрганизацийСервер(Результат);
	КонецЕсли;      
	
	ОбновитьСписокДействийАсинхронно(Новый Структура("Аналоги, ПравилаПотребностей, ОКПД2"));
	ЗаполнитьДеревоОтборовСервер();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтборОрганизацийСервер(Знач Результат)
	
	ЭтотОбъект.ДеревоОрганизаций.Загрузить(ПолучитьИзВременногоХранилища(Результат.ДеревоОрганизаций)); 
	ЭтотОбъект.ДеревоОрганизацийПолное.Загрузить(ПолучитьИзВременногоХранилища(Результат.ДеревоОрганизацийПолное)); 
	Объект.Субъекты223ФЗ = Результат.Субъекты223ФЗ; 
	
	УстановитьОтборПоОрганизациям(ЭтотОбъект); 
	 

КонецПроцедуры


&НаСервере
Функция СоздатьДокументИзЧерновикаНаСервере()         
	
	КорзинаДерево = РеквизитФормыВЗначение("КорзинаПроектыСПЗ").Скопировать(); 
	ИдАдрес = Новый УникальныйИдентификатор();
	
	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("ДеревоПроектов", 	Новый ХранилищеЗначения(КорзинаДерево));  
	ПараметрыЗадания.Вставить("ТекущийПользователь",ЭтотОбъект.ТекущийПользователь);
	ПараметрыЗадания.Вставить("ПериодПотребностей", ЭтотОбъект.ПериодПотребностей);
	ПараметрыЗадания.Вставить("ПустойУИД", 			ЭтотОбъект.ПустойУИД);     
	
	ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);    
		
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(
												ПараметрыВыполненияВФоне,
												"Обработки.ПомощникПланирования.СформироватьПроектыЗакупокНаСервере",
												ПараметрыЗадания);   
												
	ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Очистить();	 
	
	Элементы.СоздатьДокументИзЧерновика.Доступность = Ложь;
	Элементы.СоздатьДокументИзЧерновика.Картинка 	= БиблиотекаКартинок.ДлительнаяОперация16;
	
	Возврат ДлительнаяОперация;
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокументИзЧерновика(Команда)  
	
	ДлительнаяОперация = СоздатьДокументИзЧерновикаНаСервере();  
	
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияПроектов", ЭтотОбъект, ДлительнаяОперация);   
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется расчет показателей...'");  
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания); 
	
КонецПроцедуры   

&НаКлиенте
Процедура ПослеСозданияПроектов(Результат, ДопПараметры) Экспорт
	
	Если Результат.Статус = "Выполнено" Тогда               
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Документы созданы'"),,, "КорзинаПроектыСПЗ1"); 
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки); 
		КорзинаПроектыСПЗ1ПослеУдаленияНаСервере();
	КонецЕсли;       
	Элементы.СоздатьДокументИзЧерновика.Доступность = Истина;
	Элементы.СоздатьДокументИзЧерновика.Картинка = БиблиотекаКартинок.СоздатьЭлементСписка;     
	
	РезультатЗначение = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);   
	
	Если Объект.Субъекты223ФЗ Тогда
		ИмяФормыСписка = "Документ.СтрокаПланаЗакупок.ФормаСписка";
	Иначе    
		ИмяФормыСписка = "Документ.Лот.ФормаСписка";
	КонецЕсли;
	
	Если РезультатЗначение <> Неопределено И РезультатЗначение.Количество() > 0 Тогда
		ОткрытьФорму(ИмяФормыСписка,                                       	//ИмяФормы
						Новый Структура("Отбор",                          	//Отбор
										Новый Структура("Ссылка", 
										РезультатЗначение)), 
						ЭтотОбъект, Истина,,,,                             	//Владелец, Уникальность
						РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 	//РежимОткрытияОкнаФормы
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти   

#Область ДекорацииПервойСтраницы

&НаКлиенте
Процедура ДекорацияОрганизацииБезПоложенийНажатие(Элемент)
	МассивОрганизаций = ПолучитьМассивОрганизацияПотребностиБезПравил(ПериодГод(ЭтотОбъект.ПериодПотребности.ДатаНачала));
	СписокОрганизаций223 = Новый СписокЗначений;
	СписокОрганизаций223.ЗагрузитьЗначения(МассивОрганизаций);
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ВыборОрганизацииПравила_Завершение", ЭтаФорма);
	СписокОрганизаций223.ПоказатьВыборЭлемента(ОписаниеОЗакрытии, НСтр("ru = 'Организации'"));
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПозицииБезОКПД2Нажатие(Элемент)
	ОткрытьОтчет_ПотребностиБезОКПД2();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОрганизацииБезПоложенийВыполнитьНажатие(Элемент)
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПериодЗакупок", ПериодГод(ЭтотОбъект.ПериодПотребности.ДатаНачала));
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);    
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("РегистрСведений.ДействиеПоложенийОЗакупках.Форма.ФормаСпискаПоГодам", СтруктураПараметров,,,,, Новый ОписаниеОповещения("ОбновитьПараметрыПотребностей", ЭтаФорма), );
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЗаменаНаАналогиНажатие(Элемент)
	УправлениеАналогамиОбработка();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаНаАналогиВыполнитьНажатие(Элемент)
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ВыполнитьОбработкуАналогов", ЭтаФорма), 
		НСтр("ru = 'Будет выполнена замена потребностей на аналоги. Продолжить?'"), 
		РежимДиалогаВопрос.ДаНет);
	СтандартнаяОбработка = Ложь; 
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьОтборПоОрганизациям(Форма, ОтборПоОрганизациям = Истина)
	
	Перем ОрганизацииДляОтбора;
	
	ОрганизацииДляОтбора = Форма.ДеревоОрганизаций.Выгрузить(Новый Структура("Отбор", Истина)).ВыгрузитьКолонку("Организация");        
	ОрганизацииДляОтбораСписок = Новый СписокЗначений;
	ОрганизацииДляОтбораСписок.ЗагрузитьЗначения(ОрганизацииДляОтбора);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.СписокПотребности, "ОрганизацииОтбора",	ОрганизацииДляОтбораСписок); 
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.СписокПотребности, "ОтборПоОрганизациям", 	ОтборПоОрганизациям);
	
	Форма.Элементы.ДекорацияОрганизацииОтбор.Заголовок = НСтр("ru = 'Организации для отбора '") + СтрШаблон("(%1)", ОрганизацииДляОтбора.Количество()); 
	Форма.Элементы.ГруппаНастройкиЦЗ.Видимость = Не Форма.Объект.Субъекты223ФЗ; 
	Форма.Элементы.Декорация223ФЗ.Видимость = Форма.Объект.Субъекты223ФЗ;

КонецПроцедуры
	
#КонецОбласти
