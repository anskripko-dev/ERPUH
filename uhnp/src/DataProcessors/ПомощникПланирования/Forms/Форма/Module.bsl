&НаСервере
Процедура УстановитьИнформациюПоПользователю()
	
				
	ТекущийПользвательТекст = СокрЛП(ТекущийПользователь);	
	
	Если Константы.РазделятьНоменклатуруПоКатегорийнымМенеджерам.Получить() = Ложь Тогда  
		Элементы.ТекстПользователя.Заголовок = ТекущийПользвательТекст + ": " + НСтр("ru = 'без разделения по категорийным менеджерам'");
		Элементы.ТоварныеКатегории.Видимость = Ложь;   
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория КАК ТоварнаяКатегория,
	               |	1 КАК Пометка,
	               |	ПРЕДСТАВЛЕНИЕ(ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория) КАК ТоварнаяКатегорияНаименование
	               |ИЗ
	               |	РегистрСведений.ПолномочияКатегорийныхМенеджеров КАК ПолномочияКатегорийныхМенеджеров
	               |ГДЕ
	               |	ПолномочияКатегорийныхМенеджеров.Менеджер = &ТекущийПользователь
	               |	И ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория <> ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
	               |	И ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория ССЫЛКА Справочник.ТоварныеКатегории
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТоварнаяКатегория
	               |АВТОУПОРЯДОЧИВАНИЕ";   
	Запрос.УстановитьПараметр("ТекущийПользователь",ТекущийПользователь); 
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда    
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ТоварныеКатегории", "Справочник.КатегорииЗакупок");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() = 0 Тогда
		Элементы.ТекстПользователя.Заголовок = ТекущийПользвательТекст + ": "+"без доступа к товарным категориям";
		Элементы.ТоварныеКатегории.Видимость = Ложь;	
	Иначе
		Элементы.ТекстПользователя.Заголовок = ТекущийПользвательТекст + ": "+"категорийный менеджер "; 
		ТоварныеКатегории = "";
	КонецЕсли;	

КонецПроцедуры

