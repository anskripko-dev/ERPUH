&НаСервере
Функция ДобавитьПроектНаСервере()  
	
	ТекущиеДанные = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока); 
	
	Если ТекущиеДанные.ПолучитьРодителя() <> Неопределено Тогда
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;             
	
	Индекс = ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Индекс(ТекущиеДанные);
	
	НовыйПроект = ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Вставить(Индекс+1);  
	ЗаполнитьЗначенияСвойств(НовыйПроект, ТекущиеДанные, , "Сумма");    
	НовыйПроект.ЭтоПроект = Истина;
	
	Возврат НовыйПроект.ПолучитьИдентификатор();     
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПроект(Команда)   
	ДобавитьВыбранныеПотребности(Элементы.СписокПотребности);
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Строка);    
	Если Не ТекущиеДанные.ЭтоПроект Тогда
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	Для Каждого Значение Из ПараметрыПеретаскивания.Значение Цикл
		СтрокаПереноса = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Значение);
		НоваяПотребность = ТекущиеДанные.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПотребность, СтрокаПереноса);	
		
		НоваяПотребность.Контрактант = ТекущиеДанные.Контрактант;    
		
		РодительУдаляемойСтроки = СтрокаПереноса.ПолучитьРодителя();
		РодительУдаляемойСтроки.ПолучитьЭлементы().Удалить(СтрокаПереноса);      
		Если РодительУдаляемойСтроки.ПолучитьЭлементы().Количество() = 0 Тогда
			ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы().Удалить(РодительУдаляемойСтроки);     
		КонецЕсли;
		
	КонецЦикла;     
	
	Элемент.Развернуть(Строка); 
	
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Заголовок = Нстр("ru = 'Применить'");   
	Элементы.КорзинаПроектыСПЗСформироватьПроекты.Доступность = Истина; 
		
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПроектыСПЗПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)  
	СтандартнаяОбработка = Ложь;
	
	Проект = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Строка);  
	Для Каждого Значение Из ПараметрыПеретаскивания.Значение Цикл
		ТекущиеДанные = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Значение);	
		Если ТекущиеДанные.ЭтоПроект = Истина Тогда
			ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;   
			Возврат;
		КонецЕсли;  
		Если ТекущиеДанные.ЗапретИзменения_СпособЗакупки И Проект.СпособЗакупки <> ТекущиеДанные.СпособЗакупки 
			Или ТекущиеДанные.ЗапретИзменения_Организатор И Проект.Организатор <> ТекущиеДанные.Организатор
			Или Проект.Валюта <> ТекущиеДанные.Валюта Тогда
			ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;   
			Возврат;
		КонецЕсли;	
	КонецЦикла;   
	
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	
КонецПроцедуры     

&НаСервере
