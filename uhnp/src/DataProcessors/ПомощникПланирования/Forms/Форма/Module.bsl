	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИСключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;  
	
	РезультатЗначение = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); 
	УстановитьКолвоПозицийДействия(ЭтаФорма, ДополнительныеПараметры.Действие, РезультатЗначение.Значение, РезультатЗначение.ОписаниеНастройка);  
	Элементы.ДекорацияОрганизацииБезПоложений.Заголовок = НСтр("ru = 'Организации без положений о закупках ['") + РезультатЗначение.Значение + "]";  
