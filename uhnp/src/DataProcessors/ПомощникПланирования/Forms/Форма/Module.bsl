
#Область ОбработчикиСобытийФормы
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ПериодПотребностей = ПериодГод(ТекущаяДата()); 
	ЭтотОбъект.ПериодПотребности.ДатаНачала = НачалоГода(ТекущаяДата());
	ЭтотОбъект.ПериодПотребности.ДатаОкончания = КонецГода(ТекущаяДата());
	ЭтотОбъект.ПериодПотребности.Вариант = ВариантСтандартногоПериода.ЭтотГод;   
	Объект.ПериодЗакупки = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ЭтотОбъект.ПериодПотребностей.ДатаОкончания, Перечисления.Периодичность.Год);

	УстановитьПараметрыСпискаПотребностей();
	
	ПомощникПланированияСерверВстраивание.ПриСозданииНаСервере(ЭтотОбъект);    
	
	ЗаполнитьДеревоОрганизаций(ЭтотОбъект);
	
	ЭтотОбъект.ПериодичностьЗакупокГод = Константы.ПериодичностьЦентрализованныхЗакупок.Получить();
	
	Параметры.Свойство("АдресХранилища", АдресХранилища);
	Параметры.Свойство("ИсточникЗамены", ИсточникЗамены);
	УстановитьЗаголовокГиперссылки();
	//
	ИспользоватьДействиеСозданиеНовыхСПЗ = Ложь;
     
	УстановитьУсловноеОформление();
	
	ПолучитьМассивТК();     
		
	УстановитьСтраницыПомощникаНаСервере("ШагОтборПотребностей");  
	
	УдалитьВсеПроектыСПЗНаСервере(ТекущийПользователь, Объект.ПериодЗакупки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.СписокПотребности, "НачалоПериода",	ЭтотОбъект.ПериодПотребности.ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.СписокПотребности, "КонецПериода",	ЭтотОбъект.ПериодПотребности.ДатаОкончания);  
	
	Для Каждого ЭлементПотребностей Из Элементы.СписокПотребности.ПодчиненныеЭлементы Цикл
		ЭлементПотребностей.Видимость = Истина;
	КонецЦикла;     
	
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда 
		Элементы.КорзинаПроектыСПЗТоварнаяКатегория1.Заголовок = НСтр("ru = 'Товарная категория'");
	Иначе
		Элементы.КорзинаПроектыСПЗТоварнаяКатегория1.Заголовок = НСтр("ru = 'Категория закупки'");
	КонецЕсли;
	
КонецПроцедуры

Функция ПериодГод(Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Ссылка
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	НЕ Периоды.ПометкаУдаления
		|	И Периоды.ДатаНачала <= &Дата
		|	И Периоды.ДатаОкончания >= &Дата
		|	И Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)";

	Запрос.УстановитьПараметр("Дата", Дата);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
    
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПоказыватьТолькоНеОбеспеченные = Истина;
	
	// 
	ПредупреждатьПриПомещенииВКарзинуВсехПотребностей = Ложь;
	
	УправлениеДоступностьюДополнительныхФункций();     
	
	ЗаполнитьДеревоОтборовСервер();  
	
	ОбновитьСписокДействийАсинхронно();
	
КонецПроцедуры


#Область СлужебныеПроцедурыИФункции    

#Область ОбработкиДлительныхОпераций  

&НаКлиенте
Процедура ОбновитьСписокДействийАсинхронно(ПараметрыДлительныхОпераций = Неопределено)
	
	Если ПараметрыДлительныхОпераций = Неопределено Тогда
		ПараметрыДлительныхОпераций = Новый Структура("Аналоги, ПравилаПотребностей, ОКПД2, ПараметрыПотребностейПоПользователю");       
	КонецЕсли;
	
	ПроверитьНаборПотребностейСПерезаполнением(ПараметрыДлительныхОпераций);    
	ПодключитьСписокДлительныхОпераций(ПараметрыДлительныхОпераций);

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСписокДлительныхОпераций(Знач ПараметрыДлительныхОпераций)
	
	Перем КлючИЗначение, Оповещение, ПараметрыОжидания;
	
	Для Каждого КлючИЗначениеПараметры Из ПараметрыДлительныхОпераций Цикл 
		КлючИЗначение = КлючИЗначениеПараметры.Значение;
		Оповещение = Новый ОписаниеОповещения(КлючИЗначение.ИмяОповещения, ЭтотОбъект, КлючИЗначение.ДлительнаяОперация);   
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения = Нстр("ru = 'Выполняется расчет показателей...'");  
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(КлючИЗначение.ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ФоновоеПолучитьТекущееСостояниеКлассификацииОКПД2(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Не Объект.Субъекты223ФЗ Тогда
		Элементы.ГруппаПозицииБезОКПД2.Видимость = Ложь;
		Возврат; 
	Иначе
		Элементы.ГруппаПозицииБезОКПД2.Видимость = Истина;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИСключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;  
	
	РезультатЗначение = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); 
	УстановитьКолвоПозицийДействия(ЭтаФорма, ДополнительныеПараметры.Действие, РезультатЗначение.Значение);   
	
	Элементы.ДекорацияПозицииБезОКПД2.Заголовок = НСтр("ru = 'Позиции без ОКПД2 ['") + РезультатЗначение.Значение + "]";  
	Если РезультатЗначение.Значение = 0 Тогда
		Элементы.ДекорацияПозицииБезОКПД2Ожидание.Картинка = БиблиотекаКартинок.ОформлениеЗнакФлажок;
	Иначе
		Элементы.ДекорацияПозицииБезОКПД2Ожидание.Картинка = БиблиотекаКартинок.ОформлениеЗнакКрест;
	КонецЕсли;

	
КонецПроцедуры 

&НаКлиенте
Процедура ФоновоеПолучитьТекущееСостояниеАналогов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИСключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;  
	
	РезультатЗначение = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); 
	УстановитьКолвоПозицийДействия(ЭтаФорма, ДополнительныеПараметры.Действие, РезультатЗначение.Значение, РезультатЗначение.ОписаниеНастройка);  
	Элементы.ДекорацияЗаменаНаАналоги.Заголовок = НСтр("ru = 'Замена на аналоги'") + РезультатЗначение.ОписаниеНастройка;  
	
	Если РезультатЗначение.Значение = 0 Тогда
		Элементы.ЗаменаНаАналогиВыполнить.Видимость = Ложь;
	Иначе
		Элементы.ЗаменаНаАналогиВыполнить.Видимость = Истина;
	КонецЕсли;
	Элементы.ДекорацияЗаменаНаАналогиОжидание.Картинка = БиблиотекаКартинок.Информация16;  
	
КонецПроцедуры

&НаКлиенте
