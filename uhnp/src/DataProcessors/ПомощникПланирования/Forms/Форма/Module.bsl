&НаСервереБезКонтекста
Процедура УстановитьОбязательныеПоляПотребностей(Выбор)
	
	Обязательные = Новый Структура("Организация, Обеспечение, ПоложениеОЗакупках, ЗапретИзменения_СпособЗакупки, СпособЗакупки, ЗапретИзменения_Организатор, Организатор, УИДУсловия, Номенклатура, Валюта, ТоварнаяКатегория, Характеристика, МестоПоставки, Организация, ОрганизацияЗаказчик, АналитикаИсточника, АналитикаПланирования, АналитикаНоменклатуры, ПериодЗакупки, КоличествоОстаток, СуммаОстаток, Цена, Валюта, ПериодПотребности, Проект, КлючПараметровЗакупки");
    Обязательные.Вставить("ОКПД2");   
	Обязательные.Вставить("Комментарий223"); 
	Обязательные.Вставить("Назначение");  
	Обязательные.Вставить("ЗакупкаПоФЗ223");
	
	Для Каждого КлючЗначение Из Обязательные Цикл
		
		Если НЕ ПолеВыбрано(Выбор.Элементы, Врег(КлючЗначение.Ключ)) Тогда
			НовоеПоле = Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ);
			НовоеПоле.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолеВыбрано(Элементы, ИмяПоля)
	
	Результат = Ложь;
	Для Каждого Элемент Из Элементы Цикл
	
		Если ТипЗнч(Элемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Результат = ПолеВыбрано(Элемент.Элементы, ИмяПоля);
		Иначе
			Результат = ИмяПоля = ВРег(Строка(Элемент.Поле));
		КонецЕсли;
	
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	Возврат Результат;
	
КонецФункции

