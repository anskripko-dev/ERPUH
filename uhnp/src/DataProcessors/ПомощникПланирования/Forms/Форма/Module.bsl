&НаКлиенте
Процедура РазвернутьТекущийПроектПриОжидании() Экспорт 
	
	ОтключитьОбработчикОжидания("РазвернутьТекущийПроектПриОжидании");
	
	Если Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Проект = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные.ПолучитьИдентификатор()); 
	Если Проект.ЭтоПроект = Ложь Тогда
		Проект = Проект.ПолучитьРодителя();
	КонецЕсли; 
	Элементы.КорзинаПроектыСПЗ1.Развернуть(Проект.ПолучитьИдентификатор());

