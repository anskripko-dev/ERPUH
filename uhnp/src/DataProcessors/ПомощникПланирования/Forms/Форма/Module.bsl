	ОткрытьФорму("Документ.Лот.ФормаСписка",,, Истина);
КонецПроцедуры

&НаКлиенте
Процедура КорзинаРазвернутьВсе(Команда)
	Для Каждого Проект Из ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы() Цикл
		Элементы.КорзинаПроектыСПЗ1.Развернуть(Проект.ПолучитьИдентификатор());  
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КорзинаСвернутьВсе(Команда)
	Для Каждого Проект Из ЭтотОбъект.КорзинаПроектыСПЗ.ПолучитьЭлементы() Цикл
		Элементы.КорзинаПроектыСПЗ1.Свернуть(Проект.ПолучитьИдентификатор());  
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСвернутьПроект(Команда)
	Проект = ЭтотОбъект.КорзинаПроектыСПЗ.НайтиПоИдентификатору(Элементы.КорзинаПроектыСПЗ1.ТекущаяСтрока);  
	Если Проект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не Проект.ЭтоПроект Тогда
		Проект = Проект.ПолучитьРодителя();
	КонецЕсли;  
	Элементы.КорзинаПроектыСПЗ1.Свернуть(Проект.ПолучитьИдентификатор());
КонецПроцедуры

&НаКлиенте
Процедура ЦентрализованнаяЗакупкаПриИзменении(Элемент)
	Элементы.Контрактант.ТолькоПросмотр = Не ЭтотОбъект.ЦентрализованнаяЗакупка;
	Если ЭтотОбъект.ЦентрализованнаяЗакупка = Ложь Тогда
		ЭтотОбъект.Контрактант = Неопределено; 
		КонтрактантПриИзменении(Элементы.Контрактант);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПериодПотребностиПриИзмененииНаСервере()      
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.СписокПотребности, "НачалоПериода",	ЭтотОбъект.ПериодПотребности.ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.СписокПотребности, "КонецПериода",	ЭтотОбъект.ПериодПотребности.ДатаОкончания);  
	ЭтотОбъект.Элементы.СписокПотребности.Обновить(); 
	ЗаполнитьДеревоОрганизаций(ЭтотОбъект);
	ЗаполнитьДеревоОтборовСервер();
КонецПроцедуры

&НаКлиенте
Процедура ПериодПотребностиПриИзменении(Элемент)
	ПериодПотребностиПриИзмененииНаСервере(); 
	ОбновитьСписокДействийАсинхронно();
	РазвернутьДеревоОтборов();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоложение(Команда)
	Если Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Положение = Элементы.КорзинаПроектыСПЗ1.ТекущиеДанные.ПоложениеОЗакупках;
