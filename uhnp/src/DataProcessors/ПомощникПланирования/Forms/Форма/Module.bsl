&НаСервере
Процедура СкрытьПотребностиНаСервере()             
	
	Элементы.СкрытьПотребности.Пометка = Не Элементы.СкрытьПотребности.Пометка;   
	
	Если Элементы.СкрытьПотребности.Пометка Тогда
		Элементы.СкрытьПотребности.Заголовок 				= НСтр("ru = 'Показать потребности'");  
		Элементы.СкрытьПотребностиВПотребностях.Заголовок 	= НСтр("ru = 'Показать потребности'");
		Элементы.СкрытьПотребности.Картинка 				= БиблиотекаКартинок.РазвернутьПанель;
		Элементы.СкрытьПотребностиВПотребностях.Картинка 	= БиблиотекаКартинок.РазвернутьПанель;
	Иначе
		Элементы.СкрытьПотребности.Заголовок 				= НСтр("ru = 'Скрыть потребности'"); 
		Элементы.СкрытьПотребностиВПотребностях.Заголовок 	= НСтр("ru = 'Скрыть потребности'");
		Элементы.СкрытьПотребности.Картинка 				= БиблиотекаКартинок.СвернутьПанель;   
		Элементы.СкрытьПотребностиВПотребностях.Картинка 	= БиблиотекаКартинок.СвернутьПанель;
	КонецЕсли;                                     
	
	Элементы.ГруппаСписокПотребностей.Видимость = Не Элементы.СкрытьПотребности.Пометка;
	Элементы.ДекорацияСписокПотребностей.Видимость = Не Элементы.ГруппаСписокПотребностей.Видимость;  
	Элементы.ГруппаОтборы.Видимость = Не Элементы.СкрытьПотребности.Пометка;  
	Элементы.ГруппаГлавная.Видимость = Не Элементы.СкрытьПотребности.Пометка;

	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПотребности(Команда)
	СкрытьПотребностиНаСервере();
КонецПроцедуры

