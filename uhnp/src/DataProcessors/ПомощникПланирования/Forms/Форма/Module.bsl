			Элемент.Значение = Пользователь;
			Элемент.Использование = Истина;
		ИначеЕсли Строка(Элемент.Параметр) = "ПериодЗакупки" Тогда
			Элемент.Значение = ПериодЗакупки;
			Элемент.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отчет.КомпоновщикНастроек.ПользовательскиеНастройки;
	
