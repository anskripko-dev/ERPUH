			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'нет'"), Новый Шрифт("Consolas"), ЦветаСтиля.ГиперссылкаЦвет,, "Отчет_ПотребностиКЗаменеНаАналоги"));
