&НаСервере
Функция ТаблицаЗаменыНаАналоги()                     
	
	ПараметрыПериода = Новый Структура("ДатаНачала, ДатаОкончания, ПериодЗакупок", 
										ЭтотОбъект.ПериодПотребности.ДатаНачала,
										ЭтотОбъект.ПериодПотребности.ДатаОкончания,
										ЭтотОбъект.ПериодПотребностей);
	
	СхемаКомпоновкиДанных = Отчеты.ОтчетОПримененииАналогов.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	//
	ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("САналитикамиПланирования");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();        
	
	Выбор = Настройки.Выбор;
	Обязательные = Новый Структура("Коэффициент, АналитикаПланирования, АналитикаИсточника, СуммаПотребностиИсходная, ЦенаПотребностиИсходная");
	
	Для Каждого КлючЗначение Из Обязательные Цикл
		
		Если НЕ ПолеВыбрано(Выбор.Элементы, Врег(КлючЗначение.Ключ)) Тогда
			НовоеПоле = Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ);
			НовоеПоле.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ПеренестиПоляВыбораНаВерхнийУровень(Настройки, Настройки.Выбор.Элементы, неопределено);     
	
	// Параметры вывода
	Параметр = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("РасположениеИтогов"));
	Параметр.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
	Параметр.Использование = Истина;
	
	// Параметры данных
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Автор"));
	Параметр.Значение = ЭтотОбъект.ТекущийПользователь;
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИспользуетсяЦенообразование25")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Константа.ИспользуетсяЦенообразование25").Получить();
		Параметр.Использование = Истина;
	КонецЕсли;                                       
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("БезУчетаТоварныхКатегорий")); 
	Если Параметр <> Неопределено Тогда                     
		Параметр.Значение = Не ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Константа.РазделятьНоменклатуруПоКатегорийнымМенеджерам").Получить();
		Параметр.Использование = Истина;
	КонецЕсли; 
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаНачала"));  
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаНачала; 
		Параметр.Использование = Истина;	
	КонецЕсли;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончания")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ДатаОкончания;
		Параметр.Использование = Истина;
	КонецЕсли;   
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодЗакупки")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ПараметрыПериода.ПериодЗакупок;
		Параметр.Использование = Истина;
	КонецЕсли;   
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СтандартныйПериод")); 
	Если Параметр <> Неопределено Тогда
		Параметр.Значение.ДатаНачала 	= ПараметрыПериода.ДатаНачала;
		Параметр.Значение.ДатаОкончания = ПараметрыПериода.ДатаОкончания;
		Параметр.Значение.Вариант 		= ВариантСтандартногоПериода.ПроизвольныйПериод;
		Параметр.Использование = Истина;
	КонецЕсли;  
	
	РеквизитыОтбора = СтруктураПараметровОтбора();    
	Для Каждого КлючИЗнчение Из РеквизитыОтбора Цикл
		Если СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Найти(КлючИЗнчение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;     
		ПолеОтбораСубъекты = Новый ПолеКомпоновкиДанных(КлючИЗнчение.Ключ);
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = ПолеОтбораСубъекты;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных[КлючИЗнчение.Значение.ВидСравнения];
		ЭлементОтбора.Использование = Истина;     
		Если ЗначениеЗаполнено(КлючИЗнчение.Значение.Значение) Тогда
			ЭлементОтбора.ПравоеЗначение = КлючИЗнчение.Значение.Значение;
		КонецЕсли;
	КонецЦикла;   
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	Таблица = Новый ДеревоЗначений;
	ПроцессорВыводаВТЗ = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТЗ.УстановитьОбъект(Таблица);
	
	ПроцессорВыводаВТЗ.Вывести(ПроцессорКомпоновкиДанных); 
	
	Таблица.Колонки.Добавить("АналогКоличество",ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	Таблица.Колонки.Добавить("АналогСумма", 	ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	Таблица.Колонки.Добавить("Экономия", 		ОбщегоНазначения.ОписаниеТипаЧисло(15,3));  
	
	НайтиИУстановитьИмяКолонки(Таблица, "КоличествоИсходное", 		"Количество");
    НайтиИУстановитьИмяКолонки(Таблица, "СуммаПотребность", 		"Сумма");    
	
	НайтиИУстановитьИмяКолонки(Таблица, "КоличествоАналог", 		"КоличествоАналог");
	НайтиИУстановитьИмяКолонки(Таблица, "СуммаАналог", 				"СуммаАналог");  
	
	НайтиИУстановитьИмяКолонки(Таблица, "Цена", 					"ЦенаАналог");
	НайтиИУстановитьИмяКолонки(Таблица, "ЦенаПотребность", 			"Цена");   
	
	НайтиИУстановитьИмяКолонки(Таблица, "АналогНоменклатура", 		"НоменклатураАналог");
	НайтиИУстановитьИмяКолонки(Таблица, "АналогХарактеристика", 	"ХарактеристикаАналог");
	НайтиИУстановитьИмяКолонки(Таблица, "АналогЕдиницаИзмерения", 	"ЕдиницаИзмеренияАналог");
	
	
	ТаблицаСОтбором = Новый ТаблицаЗначений; 
	Для Каждого Колонка Из Таблица.Колонки Цикл 
		ТаблицаСОтбором.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок);
	КонецЦикла; 
	
	ТаблицаСОтбором.Очистить();      
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПериодЗакупки", 			ЭтотОбъект.ПериодПотребностей);
	ПараметрыЗаполнения.Вставить("ДокументЗамены", 			Неопределено);
	ПараметрыЗаполнения.Вставить("НоменклатураДляЗамены", 	ТаблицаСОтбором);
	
	Результат = Новый Массив;
	
	Для Каждого ДанныеЗаявки Из Таблица.Строки Цикл     
		
		ТаблицаСОтбором.Очистить();       
		ПараметрыЗаполнения.ДокументЗамены = ДанныеЗаявки.АналитикаПланированияОбъектПланирования;       

		Для Каждого СтрокаИсходная Из ДанныеЗаявки.Строки Цикл
			
			Если СтрокаИсходная.ЕстьАналоги Тогда   
				
				Если ЗначениеЗаполнено(СтрокаИсходная.Цена) И ЗначениеЗаполнено(СтрокаИсходная.Коэффициент) И ЗначениеЗаполнено(СтрокаИсходная.ЦенаАналог) И ЗначениеЗаполнено(СтрокаИсходная.СуммаАналог) Тогда	
				
					Строка = ТаблицаСОтбором.Добавить();
					ЗаполнитьЗначенияСвойств(Строка, СтрокаИсходная);    
					
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаИсходная, "ХарактеристикаАналог") Тогда
						Строка.ХарактеристикаАналог = СтрокаИсходная.ХарактеристикаАналог; 
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Строка.НоменклатураАналог) Тогда
						
						Если Строка.ЦенаАналог <> 0 Тогда
							Строка.Экономия = Строка.Сумма - Строка.СуммаАналог;
						Иначе
							Строка.Экономия = 0;
						КонецЕсли;    
						
					КонецЕсли;
					
				КонецЕсли;    
			КонецЕсли;   
			
		КонецЦикла;    
		
		Если ТаблицаСОтбором.Количество() > 0 Тогда
			
			ДокументЗамены = Документы.ЗаменаНоменклатуры.СоздатьДокумент();   
			ДокументЗамены.Заполнить(ПараметрыЗаполнения);     
			ДокументЗамены.Валюта = ДанныеЗаявки.Валюта;
			ДокументЗамены.Записать(РежимЗаписиДокумента.Проведение);    
			
			Результат.Добавить(ДокументЗамены.Ссылка);  
			
		КонецЕсли;
		
	КонецЦикла;       
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура НайтиИУстановитьИмяКолонки(Знач ТаблицаСОтбором, Знач ИмяСтарое, Знач ИмяНовое)
	
	Колонка = ТаблицаСОтбором.Колонки.Найти(ИмяСтарое);
	Если Колонка <> Неопределено Тогда
		Колонка.Имя = ИмяНовое;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДалееКШагуНовыйПроектСПЗНаСервере()
	
	// Получаем и обрабатываем параметры закупки для корзины
	ДеревоПараметров = СформироватьПараметрыЗакупкиКорзины(ТекущийПользователь, Объект.ПериодЗакупки, ПустойУИД);
	ЗначениеВРеквизитФормы(ДеревоПараметров, "ПараметрыЗакупокНовогоПроектаСПЗ");
	РассчитатьСпискиВыбораДляСвойствНовогоПроектаСПЗ(ДеревоПараметров);
	
	// Установить ОрганизациюЗаказчки
	ЭлементОргЗаказчик = Элементы.ОрганизацияЗаказчик;
	ЭлементОргЗаказчик.СписокВыбора.Очистить();
	
	//
	СписокОрганизацийЗаказчиков = РегистрыСведений.ПроектыСПЗ.СписокОрганизацийЗаказчиков(ТекущийПользователь, Объект.ПериодЗакупки, ПустойУИД);
	
	Колво = СписокОрганизацийЗаказчиков.Количество();
	Если Колво = 0 Тогда
		Объект.ОрганизацияЗаказчик = Справочники.Организации.ПустаяСсылка();
	ИначеЕсли Колво = 1 Тогда
		Объект.ОрганизацияЗаказчик = СписокОрганизацийЗаказчиков[0];
	Иначе
		Объект.ОрганизацияЗаказчик = СписокОрганизацийЗаказчиков[0];
		ЭлементОргЗаказчик.СписокВыбора.ЗагрузитьЗначения(СписокОрганизацийЗаказчиков);
	КонецЕсли;
	
	ЭлементОргЗаказчик.ТолькоПросмотр = Объект.Субъекты223ФЗ;
	
	УстановитьСтраницыПомощникаНаСервере("ШагНовыйПроектСПЗ");
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗавершениеШагаНовыйПроектСПЗНаСервере()
	
	//
	ДеревоПараметровСПЗ = РеквизитФормыВЗначение("ПараметрыЗакупокНовогоПроектаСПЗ");
	
	ИспользоватьПрограммуЗакупок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОрганизацияЗаказчик, "ИспользоватьПрограммуЗакупок") = Истина;     
	Если ИспользоватьПрограммуЗакупок Тогда
		ВариантВключенияПозиций = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ;
	Иначе
		ВариантВключенияПозиций = Перечисления.ВариантыВключенияПозицийПотребностей.Лот;
	КонецЕсли;
	
	//
	РегистрыСведений.ПроектыСПЗ.ЗаписатьНовыйПроектСПЗ(
		ТекущийПользователь, Объект.ПериодЗакупки, Объект.Субъекты223ФЗ,
		Объект.ОрганизацияЗаказчик, ДеревоПараметровСПЗ, , 
		Объект.ПредметДоговора, Объект.ОбщиеТребования,
		ВариантВключенияПозиций);
	
	//
	УстановитьСтраницыПомощникаНаСервере("ШагПроектыСПЗ");
	
	Возврат Истина;
	
КонецФункции

