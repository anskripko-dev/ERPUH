&НаСервере
Процедура СоздатьНаСервере()
	
	Счетчик = 0;
	Пока Счетчик < СписокНоменклатуры.Количество() Цикл  
		СтрокаНоменклатуры = СписокНоменклатуры[Счетчик];
		Если СтрокаНоменклатуры.ПометкаВыделения Тогда   
			Попытка   
				НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
				НоваяНоменклатура.Наименование = СтрокаНоменклатуры.Наименование;
				НоваяНоменклатура.ГруппаФинансовогоУчета = СтрокаНоменклатуры.ГФУ;  
				Если СтрокаНоменклатуры.Вид = Справочники.ВидыНоменклатуры.ПустаяСсылка() Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры " + СтрокаНоменклатуры.Наименование + " не заполнен вид номенклатуры! Создание невозможно");
					Счетчик = Счетчик + 1;
					Продолжить;
				КонецЕсли;
				Если СтрокаНоменклатуры.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры " + СтрокаНоменклатуры.Наименование + " не заполнена единица измерения! Создание невозможно");
					Счетчик = Счетчик + 1;
					Продолжить;
				КонецЕсли;
				Если СтрокаНоменклатуры.Папка = Справочники.Номенклатура.ПустаяСсылка() Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для номенклатуры " + СтрокаНоменклатуры.Наименование + " не заполнена папка! Создание невозможно");
					Счетчик = Счетчик + 1;
					Продолжить;
				КонецЕсли;	
				НоваяНоменклатура.ВидНоменклатуры = СтрокаНоменклатуры.Вид;    
				Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НоваяНоменклатура,
																	Ложь,
																	Ложь,
																	Справочники.ВидыНоменклатуры.ПустаяСсылка(),
																	Ложь);
				НоваяНоменклатура.ЕдиницаИзмерения = СтрокаНоменклатуры.ЕдиницаИзмерения;
				НоваяНоменклатура.Родитель = СтрокаНоменклатуры.Папка;
				НоваяНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
				НоваяНоменклатура.Артикул = СтрокаНоменклатуры.Артикул;
				НоваяНоменклатура.Код = СтрокаНоменклатуры.Код;
				НоваяНоменклатура.Записать(); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создана номенклатура " + НоваяНоменклатура.Наименование);
				СписокНоменклатуры.Удалить(Счетчик);  
				
			Исключение
			КонецПопытки;  
		Иначе
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)  
	СоздатьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Для Каждого ЗначениеНоменклатуры Из Параметры.НенайденныеНоменклатуры Цикл 
		СтрокаСписка = СписокНоменклатуры.Добавить();
		СтрокаСписка.Наименование = ЗначениеНоменклатуры.Значение;  
		СтрокаСписка.Код = ЗначениеНоменклатуры.Код;
		СтрокаСписка.Артикул = ЗначениеНоменклатуры.Артикул;
	КонецЦикла;		
КонецПроцедуры

