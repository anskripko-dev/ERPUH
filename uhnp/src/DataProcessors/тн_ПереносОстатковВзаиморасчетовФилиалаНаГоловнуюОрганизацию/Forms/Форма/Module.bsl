	|	КОНЕЦ,
	|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Организация,
	|	РасчетыСПоставщикамиОстатки.АналитикаУчетаПоПартнерам,
	|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Дата,
	|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПредварительныеДанные.Документ КАК Документ,
	|	МАКСИМУМ(НДСЗаписиКнигиПродаж.Регистратор) КАК Регистратор
	|ПОМЕСТИТЬ втДанныеСФ
	|ИЗ
	|	втПредварительныеДанные КАК втПредварительныеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.НДСЗаписиКнигиПродаж КАК НДСЗаписиКнигиПродаж
	|		ПО втПредварительныеДанные.Документ = НДСЗаписиКнигиПродаж.СчетФактура
	|
	|СГРУППИРОВАТЬ ПО
	|	втПредварительныеДанные.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(тн_ДублиДоговоровФилиала.ДоговорГоловнойОрганизации, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК ДоговорГоловнойОрганизации,
	|	втПредварительныеДанные.ТипРасчетов КАК ТипРасчетов,
	|	втПредварительныеДанные.ОбъектРасчетов КАК ОбъектРасчетов,
	|	втПредварительныеДанные.ТипЗадолженности КАК ТипЗадолженности,
	|	втПредварительныеДанные.Организация КАК Организация,
	|	втПредварительныеДанные.Дата КАК Дата,
	|	втПредварительныеДанные.Номер КАК Номер,
	|	втПредварительныеДанные.ДолгОстаток КАК ДолгОстаток,
	|	втПредварительныеДанные.ПредоплатаОстаток КАК ПредоплатаОстаток,
	|	втПредварительныеДанные.ВалютныйДолгОстаток КАК ВалютныйДолгОстаток,
	|	втПредварительныеДанные.ВалютнаяПредоплатаОстаток КАК ВалютнаяПредоплатаОстаток,
	|	втПредварительныеДанные.Валюта КАК Валюта,
	|	ЕСТЬNULL(РегистрАналитикаУчетаПоПартнерам.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	ЕСТЬNULL(РегистрАналитикаУчетаПоПартнерам.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
	|	ЕСТЬNULL(РегистрАналитикаУчетаПоПартнерам.Договор.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	ЕСТЬNULL(РегистрАналитикаУчетаПоПартнерам.Договор.ВидДоговораУХ, ЗНАЧЕНИЕ(Справочник.ВидыДоговоровКонтрагентовУХ.ПустаяСсылка)) КАК ВидДоговора,
	|	ЕСТЬNULL(НДСЗаписиКнигиПродаж.Регистратор, втПредварительныеДанные.Документ) КАК Документ,
	|	ЕСТЬNULL(НДСЗаписиКнигиПродаж.Регистратор.Номер, втПредварительныеДанные.Документ.Номер) КАК ДокументНомер,
	|	ЕСТЬNULL(НДСЗаписиКнигиПродаж.Регистратор.Дата, втПредварительныеДанные.Документ.Дата) КАК ДокументДата,
	|	НДСЗаписиКнигиПродаж.Регистратор КАК Регистратор
	|ИЗ
	|	втПредварительныеДанные КАК втПредварительныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_ДублиДоговоровФилиала КАК тн_ДублиДоговоровФилиала
	|		ПО втПредварительныеДанные.АналитикаУчетаПоПартнерам.Договор = тн_ДублиДоговоровФилиала.ДоговорФилиала
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК РегистрАналитикаУчетаПоПартнерам
	|		ПО втПредварительныеДанные.АналитикаУчетаПоПартнерам = РегистрАналитикаУчетаПоПартнерам.КлючАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеСФ КАК НДСЗаписиКнигиПродаж
	|		ПО втПредварительныеДанные.Документ = НДСЗаписиКнигиПродаж.Документ
	|			И (втПредварительныеДанные.ПредоплатаОстаток > 0)";
		
	Запрос.УстановитьПараметр("Организация", ОрганизацияФилиал);
	ДатаНаКонецДня = КонецДня(ДатаПолученияОстатков);
	Запрос.УстановитьПараметр("Граница", Новый Граница(ДатаНаКонецДня, ВидГраницы.Включая));   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Объект.ТаблицаДанных.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДублиДоговоровНаСервере()
	
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда 
		Если Не ЗначениеЗаполнено(ДатаПолученияОстатков) Тогда  
			ОбщегоНазначения.СообщитьПользователю("Необходимо заполнить дату получения остатков!");
			Возврат;
		КонецЕсли;
		ЗаполнитьОстаткиНаСервере();   
	КонецЕсли;
	
	МассивДоговоров = Объект.ТаблицаДанных.Выгрузить(,"Договор").ВыгрузитьКолонку("Договор");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	тн_ДублиДоговоровФилиала.ДоговорФилиала ЕСТЬ NULL КАК СоздатьДоговор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тн_ДублиДоговоровФилиала КАК тн_ДублиДоговоровФилиала
	|		ПО ДоговорыКонтрагентов.Ссылка = тн_ДублиДоговоровФилиала.ДоговорФилиала
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка В(&МассивДоговоров)";
	
	Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДоговорФилиала = Выборка.Ссылка;	 
		
		Если Выборка.СоздатьДоговор Тогда
			
			ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();    
			ЗаполнитьЗначенияСвойств(ДоговорОбъект, ДоговорФилиала, ,"Родитель, Владелец, Ссылка, ВерсияСоглашения");
			ДоговорОбъект.Организация = Организация;        
			СсылкаНового = ДоговорОбъект.ПолучитьСсылкуНового();
			ДоговорОбъект.УстановитьСсылкуНового(СсылкаНового);
			ДоговорОбъект.Наименование = ДоговорОбъект.Наименование; 
			РаботаСДоговорамиКонтрагентовУХ.СоздатьВерсиюСоглашенияПоДоговору(ДоговорОбъект); 
			
			Набор = РегистрыСведений.тн_ДублиДоговоровФилиала.СоздатьМенеджерЗаписи();
			Набор.ДоговорФилиала = ДоговорФилиала;              
			
			Попытка     
				НачатьТранзакцию();
				ДоговорОбъект.Записать();
				Набор.ДоговорГоловнойОрганизации = ДоговорОбъект.Ссылка;
				Набор.Записать();
				ЗафиксироватьТранзакцию();
			Исключение   
				ОтменитьТранзакцию();
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось создать новый договор""%1"", по причине: ""%2""", ДоговорФилиала, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), ДоговорФилиала);
			КонецПопытки;  
			
		Иначе 
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Договор головной организации к договору ""%1"" уже создан!", ДоговорФилиала), ДоговорФилиала);
			
		КонецЕсли;
		
	КонецЦикла;	    
	
	ДополнитьТаблицуДанныхДоговорамиГоловнойОрганизации();
	
КонецПроцедуры

#КонецОбласти