	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ЭтаФорма.ДатаДокументов = ТекущаяДата();   
	ЭтаФорма.ДатаДокументов = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ЭтаФорма.ДатаДокументов = Дата(2020,6,30,23,59,59);
	ЭтаФорма.Менеджер		= Пользователи.ТекущийПользователь();
	ЭтаФорма.ПропускатьНулевыеКолва = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоки(Команда)
	СоздатьДокиНаСервере();
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.Результат;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧ(Документ, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, СуммаВал, СуммаРег=0, ТекСчет, НомерПерв="", ДатаПерв="", СуммаПерв=0, Коммент="", РеглПерв=0)
	
	Строка = Документ.РасчетыСПартнерами.Добавить();
	Строка.Контрагент	= СсылкаКонтрагент;
	Строка.Партнер		= СсылкаКонтрагент.Партнер;
	
	Строка.Договор		= СсылкаДоговор;
	Если ВалютаКод = "643" Тогда
		Строка.Сумма		= СуммаРег;	
	Иначе	
		Строка.Сумма		= СуммаВал;	
	КонецЕсли;
	
	Строка.ДатаПлатежа  = ДатаДокументов;
	
	Строка.СуммаРегл	= СуммаРег;
	Строка.СуммаУпр		= СуммаРег;
	
	Строка.Договор			= Справочники.ДоговорыКонтрагентов;
	Строка.ОбъектРасчетов	= СсылкаДоговор;
	Строка.ВалютаВзаиморасчетов = СсылкаДоговор.ВалютаВзаиморасчетов;
	Строка.ДокументРасчетов = СоздатьПервичныйДокумент(Документ, СсылкаКонтрагент, СсылкаДоговор, Строка.ВалютаВзаиморасчетов, СуммаПерв, ТекСчет, НомерПерв, ДатаПерв, Коммент, РеглПерв);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьПервичныйДокумент(Документ, СсылкаКонтрагент, СсылкаДоговор, Валюта, СуммаВал, ТекСчет, НомерПерв, ДатаПерв, Коммент, РеглПерв)
	
	ПервичныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
	ПервичныйДокумент.Дата			= Документ.Дата; 
	ПервичныйДокумент.Организация	= Документ.Организация; 
	ПервичныйДокумент.Контрагент 	= СсылкаКонтрагент; 
	ПервичныйДокумент.Договор 		= СсылкаДоговор; 
	ПервичныйДокумент.Партнер		= СсылкаКонтрагент.Партнер; 
	ПервичныйДокумент.Валюта 		= Валюта; 
	ПервичныйДокумент.СуммаДокумента= СуммаВал; 
	ПервичныйДокумент.СуммаРегл		= РеглПерв; 
	ПервичныйДокумент.Комментарий	= "#Создана загрузкой по задаче №11411 ";
	ПервичныйДокумент.ПорядокРасчетов= Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	ПервичныйДокумент.НомерВходящегоДокумента	= НомерПерв; 
	ПервичныйДокумент.ДатаВходящегоДокумента	= Дата(ДатаПерв);
	
	Если Коммент="С поставщиком" Тогда		// Задолженность перед поставщиками
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику;
	Иначе																			 // Задолженность клиентов
		ПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаОтКлиента;
	КонецЕсли;
	
	                                      
	ПервичныйДокумент.Записать();
	Возврат ПервичныйДокумент.Ссылка;
КонецФункции


&НаСервере
Функция ЗаполнитьШапку(Документ, Организация, Счет="")
	
	Документ.Дата			= ДатаДокументов;
	Документ.Менеджер		= Менеджер;
	Документ.Ответственный	= Менеджер;
	Документ.Организация	= Организация;
	
	Документ.ОтражатьВБУиНУ				= Истина;
	Документ.ОтражатьВУУ				= Истина;
	Документ.ОтражатьВОперативномУчете	= Истина;
	Документ.Комментарий	= "#Создан загрузкой 11185";
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл";
	ДиалогВыбора.Фильтр = "MXL (*.mxl)";
	
	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
	
	ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла);
	
	Элементы.СоздатьДоки.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТабличныйДокументИзФайла(Адрес, ИмяФайла)
	
	Расширение = Прав(ИмяФайла,3);
	
	ФайлПриемник = ПолучитьИмяВременногоФайла(Расширение);
	ДанныеХранилища = ПолучитьИзВременногоХранилища(Адрес);
	ДанныеХранилища.Записать(ФайлПриемник);
	
	ТабДокумент.Очистить();
	ТабДокумент.Прочитать(ФайлПриемник,СпособЧтенияЗначенийТабличногоДокумента.Текст);
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЧислоЯчейки(Текст)
	
	Текст = СтрЗаменить(СокрЛП(Текст),Символы.НПП,"");
	Если Текст="" Тогда
		Возврат 0;
	Иначе
		Попытка
			Возврат Число(Текст);
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СсылкаПоГУИД(УИД, ОбластьПоиска)
	
	Попытка
		GUID	= Новый УникальныйИдентификатор(УИД);
		Ссылка  = ОбластьПоиска.ПолучитьСсылку(GUID);
		Если Лев(Строка(Ссылка),7)="<Объект" Тогда 
			Ссылка = Неопределено;
		КонецЕсли;
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
КонецФункции

&НаСервере
Процедура СообщитьОбОшибке(Счетчик, Текст, Колонка=0)
	
	Результат.ДобавитьСтроку(Строка(Счетчик)+" строка."+Текст);
	
	ТабДокумент.Область(Счетчик,1,Счетчик,ТабДокумент.ШиринаТаблицы).ЦветФона = WebЦвета.ОранжевоКрасный;
	ТабДокумент.Область(Счетчик,Колонка,Счетчик,Колонка).ЦветФона = WebЦвета.Красный;
	
КонецПроцедуры

