&НаСервере
Процедура СоздатьДокиНаСервере()
	
	//Пример = Документы.ВводОстатков.НайтиПоНомеру("00-00000069",);
	//Возврат;
	
	Результат.Очистить();
	
	КолвоСтрокВДокументе = 2999; // в создаваемых документах
	КолОрг	 	= 1;
	КолОргID 	= 2;
	КолСчет	 	= 3;
	КолВалютаКод= 4;
	КолВалСумма	= 6;
	КолСумма	= 5;
	КолКон	 	= 7;
	КолКонID 	= 8;
	КолДог	 	= 9;
	КолДогID 	=10;
	
	КолДок		=11;
	КолДокДата	=12;
	КолДокНомер	=13;
	КолДокСумма	=14;
	КолДокВалюта=15;
	КолДокКурс	=16;
	
	// Ищем первую строку с данными
	Для ПерваяСтрокаДанныхВФайле = 1 По ТабДокумент.ВысотаТаблицы Цикл
		Если  ТабДокумент.Область(ПерваяСтрокаДанныхВФайле,КолОрг,ПерваяСтрокаДанныхВФайле,КолОрг).Текст = "Организация" Тогда
			ПерваяСтрокаДанныхВФайле = ПерваяСтрокаДанныхВФайле +1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если  ПерваяСтрокаДанныхВФайле > ТабДокумент.ВысотаТаблицы Тогда
		Результат.ДобавитьСтроку("Файл не соответствует");
		Возврат;
	Иначе
		Результат.ДобавитьСтроку("Обрабатываем со строки "+Строка(ПерваяСтрокаДанныхВФайле)+" по "+Строка(ТабДокумент.ВысотаТаблицы) );
		//Результат.ДобавитьСтроку("Номер строки и результат: ");
	КонецЕсли;
	
	ПредОрганизация = "";      
	ПредСчет	= "";
	Документ1  = Документы.ВводОстатков.ПустаяСсылка(); // ОстаткиЗадолженностиКлиентов
	Документ2  = Документы.ВводОстатков.ПустаяСсылка(); // ОстаткиЗадолженностиПередПоставщиками
	Документ3  = Документы.ВводОстатков.ПустаяСсылка(); // ОстаткиПоАвансамКлиентов
	Документ4  = Документы.ВводОстатков.ПустаяСсылка(); // ОстаткиПоАвансамПоставщикам
	ДокументСоздан = Ложь;
	
	
	Для Счетчик=ПерваяСтрокаДанныхВФайле По ТабДокумент.ВысотаТаблицы Цикл
		
		ТекСчет	= ТабДокумент.Область(Счетчик,КолСчет,Счетчик,КолСчет).Текст;
		
		ТекОрганизация	= ТабДокумент.Область(Счетчик,КолОргID,Счетчик,КолОргID).Текст;
		
		ТекКонтрагент	= ТабДокумент.Область(Счетчик,КолКонID,Счетчик,КолКонID).Текст;
		ТекДоговор		= ТабДокумент.Область(Счетчик,КолДогID,Счетчик,КолДогID).Текст;
		ВалютаКод		= ТабДокумент.Область(Счетчик,КолВалютаКод,Счетчик,КолВалютаКод).Текст;		
		Если ВалютаКод="" Тогда
			ВалютаКод = "643";
		КонецЕсли;
		
		Если НЕ(ДокументСоздан И (ТекОрганизация = ПредОрганизация) ) Тогда    			
	
			Если ДокументСоздан Тогда								// не первый документ
				Если Документ1.РасчетыСПартнерами.Количество()>0 Тогда
					Документ1.Записать();
					Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ1.Номер+ " от "+Документ1.Дата+" "+Документ1.ХозяйственнаяОперация);
				КонецЕсли;	
				Если Документ2.РасчетыСПартнерами.Количество()>0 Тогда
					Документ2.Записать();
					Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ2.Номер+ " от "+Документ2.Дата+" "+Документ2.ХозяйственнаяОперация);
				КонецЕсли;	
				Если Документ3.РасчетыСПартнерами.Количество()>0 Тогда
					Документ3.Записать();
					Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ3.Номер+ " от "+Документ3.Дата+" "+Документ3.ХозяйственнаяОперация);
				КонецЕсли;	
				Если Документ4.РасчетыСПартнерами.Количество()>0 Тогда
					Документ4.Записать();
					Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ4.Номер+ " от "+Документ4.Дата+" "+Документ4.ХозяйственнаяОперация);
				КонецЕсли;	
			КонецЕсли;
			
			СсылкаОрганизация = СсылкаПоГУИД(ТекОрганизация, Справочники.Организации);
			
			Если СсылкаОрганизация = Неопределено Тогда
				ДокументСоздан = Ложь;
				СообщитьОбОшибке(Счетчик, " Не найдена Организация:"+ТабДокумент.Область(Счетчик,КолОрг,Счетчик,КолОрг).Текст, КолОргID);
			Иначе
				Документ1 						= Документы.ВводОстатков.СоздатьДокумент();
				Документ1.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиКлиентов;
				
				ЗаполнитьШапку(Документ1, СсылкаОрганизация );
				Документ2 						= Документы.ВводОстатков.СоздатьДокумент();
				Документ2.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиПоставщикам;
				
				ЗаполнитьШапку(Документ2, СсылкаОрганизация );
				Документ3 						= Документы.ВводОстатков.СоздатьДокумент();
				Документ3.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковАвансовКлиентов;
				
				ЗаполнитьШапку(Документ3, СсылкаОрганизация );
				Документ4 						= Документы.ВводОстатков.СоздатьДокумент();
				Документ4.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВводОстатковАвансовПоставщикам;
				
				ЗаполнитьШапку(Документ4, СсылкаОрганизация );
				
				ДокументСоздан = Истина;
			КонецЕсли;
			
		КонецЕсли;	
		
		// новая строка в ТЧ
		Если ДокументСоздан Тогда
			
			СсылкаКонтрагент = СсылкаПоГУИД(ТекКонтрагент, Справочники.Контрагенты);
			СсылкаДоговор	 = СсылкаПоГУИД(ТекДоговор, Справочники.ДоговорыКонтрагентов);
			
			СуммаВал = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолВалСумма,Счетчик,КолВалСумма).Текст);
			СуммаРег = ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолСумма,Счетчик,КолСумма).Текст);
			Коммент  =ТабДокумент.Область(Счетчик,КолДок,Счетчик,КолДок).Текст;
			
			Если СсылкаКонтрагент = Неопределено Тогда 				
				СообщитьОбОшибке(Счетчик, " Не найден Контрагент:"+ТабДокумент.Область(Счетчик,КолКон,Счетчик,КолКон).Текст, КолКонID);
			ИначеЕсли СсылкаДоговор = Неопределено Тогда
				СообщитьОбОшибке(Счетчик, " Не найден Договор:"+ТабДокумент.Область(Счетчик,КолДог,Счетчик,КолДог).Текст, КолДогID);
			ИначеЕсли ВалютаКод <> СсылкаДоговор.ВалютаВзаиморасчетов.Код Тогда
				СообщитьОбОшибке(Счетчик, " Не совпадает валюта Договора и из файла:"+ТабДокумент.Область(Счетчик,КолДог,Счетчик,КолДог).Текст, КолВалютаКод);
			ИначеЕсли СуммаВал = 0 И НЕ(ВалютаКод = "643") Тогда
				СообщитьОбОшибке(Счетчик, " Нулевая сумма", КолВалСумма);
			Иначе	
				Если Ложь Тогда
					//НомерПерв=ТабДокумент.Область(Счетчик,КолДокНомер,Счетчик,КолДокНомер).Текст;
					//ДатаПерв =ТабДокумент.Область(Счетчик,КолДокДата,Счетчик,КолДокДата).Текст;
					//СуммаПерв=ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолДокСумма,Счетчик,КолДокСумма).Текст);
					//РеглПерв =СуммаПерв * ЧислоЯчейки(ТабДокумент.Область(Счетчик,КолДокКурс,Счетчик,КолДокКурс).Текст);
				Иначе
					НомерПерв="7602-"+Счетчик;
					ДатаПерв =Строка(ДатаДокументов);
					
					Если ВалютаКод = "643" Тогда
						СуммаПерв=?(СуммаРег>0, СуммаРег, -СуммаРег);
						РеглПерв =СуммаПерв;
					Иначе	
						СуммаПерв=?(СуммаВал>0, СуммаВал, -СуммаВал);
						РеглПерв =?(СуммаВал>0, СуммаРег, -СуммаРег);
					КонецЕсли;
				КонецЕсли;
				
				
				Если Коммент="С поставщиком"  Тогда												// Задолженность перед поставщиками
					Если СуммаРег > 0 Тогда
						ЗаполнитьТЧ(Документ2, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, СуммаВал, СуммаРег, ТекСчет, НомерПерв, ДатаПерв, СуммаПерв, Коммент, РеглПерв);
					Иначе
						ЗаполнитьТЧ(Документ4, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, -СуммаВал, -СуммаРег, ТекСчет, НомерПерв, ДатаПерв, СуммаПерв, Коммент, РеглПерв);
					КонецЕсли;	
				Иначе								 											// Задолженность клиентов
					Если СуммаРег > 0 Тогда
						ЗаполнитьТЧ(Документ1, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, СуммаВал, СуммаРег, ТекСчет, НомерПерв, ДатаПерв, СуммаПерв, Коммент, РеглПерв);
					Иначе
						ЗаполнитьТЧ(Документ3, СсылкаКонтрагент, СсылкаДоговор, ВалютаКод, -СуммаВал, -СуммаРег, ТекСчет, НомерПерв, ДатаПерв, СуммаПерв, Коммент, РеглПерв);
					КонецЕсли;	
					КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПредОрганизация = ТекОрганизация;
		ПредСчет		= ТекСчет;
		
	
		
	КонецЦикла;
		
		
	Если Документ1.РасчетыСПартнерами.Количество()>0 Тогда
		Документ1.Записать();
		Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ1.Номер+ " от "+Документ1.Дата+" "+Документ1.ХозяйственнаяОперация);
	КонецЕсли;	
	Если Документ2.РасчетыСПартнерами.Количество()>0 Тогда
		Документ2.Записать();
		Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ2.Номер+ " от "+Документ2.Дата+" "+Документ2.ХозяйственнаяОперация);
	КонецЕсли;	
	Если Документ3.РасчетыСПартнерами.Количество()>0 Тогда
		Документ3.Записать();
		Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ3.Номер+ " от "+Документ3.Дата+" "+Документ3.ХозяйственнаяОперация);
	КонецЕсли;	
	Если Документ4.РасчетыСПартнерами.Количество()>0 Тогда
		Документ4.Записать();
		Результат.ДобавитьСтроку(Строка(Счетчик)+" Создан документ "+Документ4.Номер+ " от "+Документ4.Дата+" "+Документ4.ХозяйственнаяОперация);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
