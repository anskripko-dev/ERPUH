
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ДокументыПланаПоУмолчанию() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("НачислениеОперацийМСФО"));
	Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("РеализацияМСФО"));
	Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("ПоступлениеМСФО"));

	Если Метаданные.Справочники.Найти("УрегулированиеРасхожденияВГО") <> Неопределено Тогда// не БМ, НМ
		Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("УрегулированиеРасхожденияВГО"));
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ДокументыФактаПоУмолчанию() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("РеализацияМСФО"));
	Результат.Добавить(Справочники.ДокументыБД.НайтиПоНаименованию("ПоступлениеМСФО"));
	
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли

