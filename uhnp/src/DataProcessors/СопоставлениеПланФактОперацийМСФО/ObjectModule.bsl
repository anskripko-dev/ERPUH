
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура СформироватьКорректировки(Отказ = Ложь) Экспорт
	
	Построитель = Новый ПостроительЗапроса(ПолучитьТекстЗапросаКорректировок());
	
	ВозможныеОтборы = Новый Структура("Организация,Сценарий,Контрагент,ДоговорКонтрагента,ПериодНачисления");
	Для каждого ТекОтбор Из ВозможныеОтборы Цикл
		Если (ТекОтбор.Ключ = "ПериодНачисления") И ЗначениеЗаполнено(ПериодНачисления) Тогда
			
			текОтбор = Построитель.Отбор.Добавить("Дата");
			текОтбор.ВидСравнения	= ВидСравнения.ИнтервалВключаяГраницы;
			текОтбор.ЗначениеС		= ПериодНачисления.ДатаНачала;
			текОтбор.ЗначениеПо		= ПериодНачисления.ДатаОкончания;
			текОтбор.Использование 	= Истина;
			
		ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект[ТекОтбор.Ключ]) Тогда
			Построитель.Отбор.Добавить(ТекОтбор.Ключ).Установить(ЭтотОбъект[ТекОтбор.Ключ]);
		КонецЕсли;
	КонецЦикла;
	
	Выборка = Построитель.ПолучитьЗапрос().Выполнить().Выбрать();
	КолонкиСторно = КолонкиСторно();
	
	КэшУП = Неопределено;
 
	Пока Выборка.Следующий() Цикл
		
		ДатаФакта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ДокументФакт, "Дата");
		Реквизиты = ПолучитьРеквизитыНачисления(Выборка.ДокументПлан, ДатаФакта, КэшУП);
		
		СформироватьДокументСторно(Выборка.ДокументПлан, Реквизиты, КолонкиСторно);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьДокументСторно(ДокументПлан, Реквизиты, КолонкиСторно = Неопределено) Экспорт
	
	Если КолонкиСторно = Неопределено Тогда
		КолонкиСторно = КолонкиСторно();
	КонецЕсли;
	
	Отказ = Ложь;
	СсылкаТК = Неопределено;
	
	ТаблицаПроводок = ПолучитьТаблицуПроводок(ДокументПлан, КолонкиСторно, Отказ);
	
	Если Реквизиты.ФормироватьПроводкиМСФО Тогда
		
		СтруктураЗаполненияРучнойОперации = ПреобразоватьРеквизиты(Реквизиты, ТаблицаПроводок);
		ПреобразованнаяТаблицаПроводок = ПреобразоватьТаблицуПроводок(ТаблицаПроводок);
		СсылкаТК = МСФОВызовСервераУХ.СформироватьОперациюМСФО(ПреобразованнаяТаблицаПроводок, СтруктураЗаполненияРучнойОперации, Отказ);
		
	ИначеЕсли ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		
		МодульТК = ОбщегоНазначения.ОбщийМодуль("ТрансформационныеКорректировкиУХ");
		СсылкаТК = МодульТК.СформироватьКорректировку(Реквизиты, Отказ, ТаблицаПроводок);
		
	КонецЕсли;
	
	Если Отказ Или Не ЗначениеЗаполнено(СсылкаТК) Тогда
		Возврат ложь;
	КонецЕсли; 
	
	ЗаписатьСопоставление(Реквизиты, СсылкаТК);

	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуПроводок(ДокументПлан, КолонкиСторно, Отказ)
	
	Если ТипЗнч(ДокументПлан) = Тип("ДокументСсылка.НачислениеОперацийМСФО") Тогда
		
		ДополнительныеСвойства = Новый Структура;
		ПроведениеСерверУХ.ИнициализироватьДополнительныеСвойстваДляПроведения(
			ДокументПлан, ДополнительныеСвойства);
		ТаблицаПроводок = Документы.НачислениеОперацийМСФО.ПодготовитьПараметрыПроведения(
			ДополнительныеСвойства, Отказ).ТаблицаПроводок;
		
	Иначе 
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(т.ВидСубконтоДт1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоДт1,
		|	ЕСТЬNULL(т.ВидСубконтоДт2, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоДт2,
		|	ЕСТЬNULL(т.ВидСубконтоДт3, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоДт3,
		|	ЕСТЬNULL(т.ВидСубконтоКт1, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоКт1,
		|	ЕСТЬNULL(т.ВидСубконтоКт2, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоКт2,
		|	ЕСТЬNULL(т.ВидСубконтоКт3, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконтоКт3
		|ИЗ
		|	РегистрБухгалтерии.МСФО.ДвиженияССубконто(, , Регистратор = &Регистратор, , ) КАК т";
		
		Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "ИЗ", ",* ИЗ"));
		Запрос.УстановитьПараметр("Регистратор", ДокументПлан);
		ТаблицаПроводок = Запрос.Выполнить().Выгрузить();
		
		ТаблицаПроводок.Колонки.СуммаВВалютеУчета.Имя = "СуммаВФункциональнойВалюте";//для Итога
				
	КонецЕсли;
	
	Для каждого СтрокаТаб Из ТаблицаПроводок Цикл
		
		Для каждого КолонкаТаб Из КолонкиСторно Цикл
			
			ИмяКолонки = КолонкаТаб.Ключ;
			Если ТаблицаПроводок.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаб[ИмяКолонки]) Тогда
				СтрокаТаб[ИмяКолонки] = - СтрокаТаб[ИмяКолонки];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаПроводок;

КонецФункции

Процедура ЗаписатьСопоставление(Реквизиты, СсылкаТК)
	
	нз = РегистрыСведений.СопоставлениеПланФактОперацийНачисленияМСФО.СоздатьНаборЗаписей();
	
	нз.Отбор.Организация.Установить(Реквизиты.Организация);
	нз.Отбор.ДокументПлан.Установить(Реквизиты.Ссылка);
	
	нз.Прочитать();
	
	Для каждого СтрокаТаб Из нз Цикл
		СтрокаТаб.Корректировка = СсылкаТК;
	КонецЦикла;
	
	нз.Записать();

КонецПроцедуры

Функция ПолучитьРеквизитыНачисления(ДокументПлан, ДатаФакта, КэшУП)
	
	ЗначенияУП = ЗначенияУП(ДокументПлан.Организация, КэшУП); 
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Период", 				ДатаФакта);
	Реквизиты.Вставить("Ссылка", 				ДокументПлан);
	Реквизиты.Вставить("Организация", 			ДокументПлан.Организация);
	Реквизиты.Вставить("Сценарий", 				ДокументПлан.Сценарий);
	Реквизиты.Вставить("ФункциональнаяВалюта", 	ЗначенияУП.ФункциональнаяВалюта);
	Реквизиты.Вставить("ВидОперации", 			Справочники.ВидыОпераций.СторноНачисленияДоходовРасходовМСФО);
	Реквизиты.Вставить("ПланСчетовМСФО", 		ЗначенияУП.ПланСчетовМСФО);
	Реквизиты.Вставить("ПериодСценария", 		ОбщегоНазначенияУХ.глОтносительныйПериодПоДате(ДатаФакта, Перечисления.Периодичность.Год, 0));
	Реквизиты.Вставить("ФормироватьПроводкиМСФО", ЗначенияУП.ФормироватьПроводкиМСФО);
	
	Возврат Реквизиты;

КонецФункции

Функция ЗначенияУП(Организация, КэшУП)

	Если КэшУП = Неопределено Тогда
		КэшУП = Новый Соответствие;
	КонецЕсли;
	
	ЗначенияКэша = КэшУП.Получить(Организация);
	Если ЗначенияКэша <> Неопределено Тогда
		Возврат ЗначенияКэша;
	КонецЕсли;
	
	ИменаРеквизитовУП = "ФункциональнаяВалюта, ФормироватьПроводкиМСФО, ПланСчетовМСФО";
	РеквизитыУП = МСФОВызовСервераУХ.ПутиРеквизитовУП(ИменаРеквизитовУП);
	
	Таб = МСФОВызовСервераУХ.ЗначенияУП(РеквизитыУП, Организация, 
				ЭтотОбъект.ПериодНачисления.ДатаОкончания, ЭтотОбъект.Сценарий);
			
	ЗначенияКэша = Новый Структура(ИменаРеквизитовУП, Истина);
	Если Таб.Количество() Тогда
		ЗаполнитьЗначенияСвойств(ЗначенияКэша, Таб[0]);
	Иначе 
		
		ЗначенияКэша.Вставить("ФункциональнаяВалюта", ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуРегламентированногоУчета());
		ЗначенияКэша.Вставить("ПланСчетовМСФО", МСФОВызовСервераУХ.ПланСчетовУП(Неопределено));
		
	КонецЕсли;
	
	КэшУП.Вставить(Организация, ЗначенияКэша);
	Возврат ЗначенияКэша;
		
КонецФункции

Функция ПреобразоватьРеквизиты(Реквизиты, ТаблицаПроводок)
	
	СтруктураЗаполненияРучнойОперации = Новый Структура;
	СтруктураЗаполненияРучнойОперации.Вставить("Дата", 					Реквизиты.Период);
	СтруктураЗаполненияРучнойОперации.Вставить("СпособЗаполнения", 		МСФОКлиентСерверУХ.СпособЗаполненияСторно());
	СтруктураЗаполненияРучнойОперации.Вставить("СторнируемыйДокумент", 	Реквизиты.Ссылка);
	СтруктураЗаполненияРучнойОперации.Вставить("Организация", 			Реквизиты.Организация);
	СтруктураЗаполненияРучнойОперации.Вставить("Сценарий", 				Реквизиты.Сценарий);
	СтруктураЗаполненияРучнойОперации.Вставить("СуммаОперации",			ТаблицаПроводок.Итог("СуммаВФункциональнойВалюте"));
	
	Возврат СтруктураЗаполненияРучнойОперации;
	
КонецФункции

Функция ПреобразоватьТаблицуПроводок(ТаблицаПроводок)
	
	ТаблицаПроводокРучнойОперации = ТаблицаПроводок.Скопировать();
	КолонкиТаблицы = ТаблицаПроводокРучнойОперации.Колонки;
	КолонкиТаблицы.СуммаВФункциональнойВалюте.Имя = "СуммаВВалютеУчета";
	//КолонкиТаблицы.ЗначениеВалютаДт.Имя = "СуммаВВалютеДт";
	//КолонкиТаблицы.ЗначениеВалютаКт.Имя = "СуммаВВалютеКт";

	Если КолонкиТаблицы.СчетДт.ТипЗначения.СодержитТип(Тип("ПланСчетовСсылка.МСФО")) Тогда
		Возврат ТаблицаПроводокРучнойОперации;//получение счетов не требуется	
	КонецЕсли;
	
	КолонкиТаблицы.СчетДт.Имя = "СчетДтСчетаБД";
	КолонкиТаблицы.СчетКт.Имя = "СчетКтСчетаБД";
	
	КолонкиТаблицы.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.МСФО"));
	КолонкиТаблицы.Добавить("СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.МСФО"));
	
	Для Каждого ТекСтрокаТаблицы Из ТаблицаПроводокРучнойОперации Цикл
		ТекСтрокаТаблицы.СчетДт = ТекСтрокаТаблицы.СчетДтСчетаБД.СчетСсылка;
		ТекСтрокаТаблицы.СчетКт = ТекСтрокаТаблицы.СчетКтСчетаБД.СчетСсылка;
	КонецЦикла;
	
	Возврат ТаблицаПроводокРучнойОперации;
	
КонецФункции

Функция ПолучитьТипыДокументовПлана()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК ДокументБД,
	|	т.РеквизитСуммыДокумента КАК РеквизитСуммыДокумента,
	|	т.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
	|	ИдентификаторыОбъектовМетаданных.Ссылка КАК СсылкаИД,
	|	ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовМетаданных.ЗначениеПустойСсылки) КАК ТипДокумента
	|ПОМЕСТИТЬ втДокументыБД
	|ИЗ
	|	Справочник.ДокументыБД КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|		ПО т.ИмяОбъектаМетаданных = ИдентификаторыОбъектовМетаданных.Имя
	|ГДЕ
	|	НЕ т.ПометкаУдаления
	|	И т.ИмяОбъектаМетаданных <> НЕОПРЕДЕЛЕНО
	|	И т.РеквизитСуммыДокумента <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТИПЗНАЧЕНИЯ(т.ДокументПлан) КАК ТипДокумента,
	|	NULL КАК ИмяДокумента,
	|	NULL КАК РеквизитСуммыДокумента
	|ИЗ
	|	РегистрСведений.СопоставлениеПланФактОперацийНачисленияМСФО КАК т
	|ГДЕ
	|	НЕ ТИПЗНАЧЕНИЯ(т.ДокументПлан) В
	|				(ВЫБРАТЬ
	|					втДокументыБД.ТипДокумента
	|				ИЗ
	|					втДокументыБД КАК втДокументыБД)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.ТипДокумента,
	|	т.ИмяОбъектаМетаданных,
	|	т.РеквизитСуммыДокумента
	|ИЗ
	|	втДокументыБД КАК т");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Пока Выборка.Следующий() Цикл
		
		ИмяДокумента = Выборка.ИмяДокумента;
		РеквизитСуммыДокумента = Выборка.РеквизитСуммыДокумента;
		Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
			
			ДокументМетаданные = Метаданные.НайтиПоТипу(Выборка.ТипДокумента);
			Если ДокументМетаданные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяДокумента = ДокументМетаданные.Имя;
			
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокумента", ДокументМетаданные) Тогда
				РеквизитСуммыДокумента = "СуммаДокумента";
			ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("Сумма", ДокументМетаданные) Тогда
				РеквизитСуммыДокумента = "Сумма";
			ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаОперации", ДокументМетаданные) Тогда
				РеквизитСуммыДокумента = "СуммаОперации";
			Иначе
				Продолжить;
			КонецЕсли;

		КонецЕсли;
		
		Результат.Вставить(ИмяДокумента, РеквизитСуммыДокумента);
			
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВыражениеДокументаПлан(ТипыДокументовПлана, ПутьСсылки)

	ИменаСумм = Новый Массив;
	Для каждого ДокументПлана Из ТипыДокументовПлана Цикл
		
		ИмяДокумента = ДокументПлана.Ключ;
		РеквизитСуммыДокумента = ДокументПлана.Значение;
		
		Шаблон = "КОГДА %1 ССЫЛКА Документ.%2 ТОГДА ВЫРАЗИТЬ(%1 КАК Документ.%2)";
		ИменаСумм.Добавить(СтрШаблон(Шаблон, ПутьСсылки, ИмяДокумента));
		
	КонецЦикла;
	
	Возврат СтрШаблон(
	"(ВЫБОР 
	|	%1 
	|	ИНАЧЕ NULL 
	|КОНЕЦ)", СтрСоединить(ИменаСумм, Символы.ПС));
	
КонецФункции

Функция ПолучитьТекстЗапросаКорректировок()
	
	ТипыДокументовПлана = ПолучитьТипыДокументовПлана();
	ТекстЗапроса = Новый Массив;
	
	Для каждого _ Из ТипыДокументовПлана Цикл
		ТекстЗапроса.Добавить(ТекстЗапроса_ДокументыПлана(_.Ключ, _.Значение));
	КонецЦикла;
	
	ТекстРазделитель = ПроведениеСерверУХ.РазделительЗапросовВОбъединении();
	Возврат СтрЗаменить(
		ТекстЗапроса_ДокументыДляСоздания(),
		"#ТаблицаИсточник",
		"(" + СтрСоединить(ТекстЗапроса, ТекстРазделитель) + ")");
	
КонецФункции

Функция ТекстЗапроса_ДокументыДляСоздания()

	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тк.ДокументПлан КАК ДокументПлан,
	|	СУММА(тк.СуммаФакт) КАК СуммаФакт,
	|	МИНИМУМ(тк.ДокументФакт) КАК ДокументФакт,
	|	МАКСИМУМ(тк.Корректировка) КАК Корректировка
	|ИЗ
	|	#ТаблицаИсточник КАК тк
	|
	|СГРУППИРОВАТЬ ПО
	|	тк.ДокументПлан
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(тк.Корректировка В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Документ.ТрансформационнаяКорректировка.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.ОперацияМСФО.ПустаяСсылка))) = ИСТИНА";

КонецФункции

Функция ТекстЗапроса_ДокументыПлана(ИмяДокумента, РеквизитСуммыДокумента)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДокументТип.Сумма КАК СуммаПлан,
	|	т.ДокументПлан КАК ДокументПлан,
	|	т.СуммаФакт КАК СуммаФакт,
	|	т.Корректировка КАК Корректировка,
	|	т.ДокументФакт КАК ДокументФакт
	|ИЗ
	|	РегистрСведений.СопоставлениеПланФактОперацийНачисленияМСФО КАК т
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеОперацийМСФО КАК ДокументТип
	|	ПО т.ДокументПлан = ДокументТип.Ссылка
	|{ГДЕ
	|	т.Организация.* КАК Организация,
	|	ДокументТип.Дата КАК Дата,
	|	ДокументТип.Сценарий.* КАК СценарийОтбор,
	|	ДокументТип.Контрагент.* КАК КонтрагентОтбор,
	|	ДокументТип.ДоговорКонтрагента.* КАК ДоговорКонтрагентаОтбор}";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НачислениеОперацийМСФО", ИмяДокумента);
	
	ЕстьСумма = ЗначениеЗаполнено(РеквизитСуммыДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументТип.Сумма", ?(ЕстьСумма, "ДокументТип." + РеквизитСуммыДокумента, "0"));
	
	мдДокумент = Метаданные.Документы.Найти(ИмяДокумента);
	ПоляОтборов = Новый Структура("Сценарий, Контрагент, ДоговорКонтрагента");
	Для каждого _ Из ПоляОтборов Цикл
		
		ЕстьПоле = ОбщегоНазначения.ЕстьРеквизитОбъекта(_.Ключ, мдДокумент);
		Если ЕстьПоле Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, _.Ключ + "Отбор", _.Ключ);
		Иначе 
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументТип." + _.Ключ, "ДокументТип.Ссылка");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция КолонкиСторно()

	Возврат Новый Структура(
		"Значение, СуммаВФункциональнойВалюте, СуммаВВалютеОтчетности,
		|КоличествоДт, КоличествоКт, ЗначениеВалютаДт, ЗначениеВалютаКт");

КонецФункции

