
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Объект,Параметры);
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры


&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораФайла.Заголовок					= "Выберите каталог";
	ДиалогВыбораФайла.ПредварительныйПросмотр	=Ложь;
	ДиалогВыбораФайла.МножественныйВыбор		=Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбораФайла.Каталог;
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСоставУведомления(Команда)
	
	Результат = ВыгрузитьСоставУведомленияНаСервере();
	
	Если НЕ Результат = Неопределено Тогда
		
		ПутьКфайлу	= ПутьКФайлу +  "\";
		ИмяФайла	= ПолучитьИмяФайла();
		МаксИндекс	= Контрагент.Количество()-1;
		
		Для каждого Элемент Из Контрагент Цикл
			Если Элемент = Контрагент[МаксИндекс] Тогда
				ИмяФайла = ИмяФайла+Элемент.Значение+".xml";	
			Иначе
				ИмяФайла = ИмяФайла+Элемент.Значение+", ";
			КонецЕсли;
		КонецЦикла;
		
		ПолноеИмяФайла = ПутьКФайлу+ИмяФайла;
		
		Файл = Новый ТекстовыйДокумент;
		Файл.Записать(ПолноеИмяФайла); 
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ПолноеИмяФайла, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьБезОбработки(Результат);
		ЗаписьXML.Закрыть();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка прошла успешно!
														|Файл выгрузки: " + ИмяФайла);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данных для выгрузки не найдено!");		
	КонецЕсли;
	
КонецПроцедуры


#Область СлужебныеПроцедурыИФункции
	
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	Форма.Элементы.ВыгрузитьВФайл.Доступность = Форма.Контрагент.Количество()>0 И ЗначениеЗаполнено(Форма.ПутьКфайлу);	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайла()
	
	ИмяФайла = "Уведомление за " + Формат(Объект.Уведомление.ОтчетныйГод, "ДФ=гггг") + "год, корректировка "+ 
				Строка(?(ЗначениеЗаполнено(Объект.Уведомление.НомерКорректировки),Объект.Уведомление.НомерКорректировки,0)) + ", по контрагентам ";
				
	Возврат ИмяФайла;
	
КонецФункции

&НаСервере
Функция ВыгрузитьСоставУведомленияНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА КонтролируемаяСделка.ТипСделки = ЗНАЧЕНИЕ(Перечисление.ТипыКонтролируемыхСделок.ПолученДоход)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролируемыхСделок.ОсуществленРасход)
	               |		КОГДА КонтролируемаяСделка.ТипСделки = ЗНАЧЕНИЕ(Перечисление.ТипыКонтролируемыхСделок.ОсуществленРасход)
