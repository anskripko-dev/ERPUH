				   //КОНЕЦ Качикина 06.05.2026 Выполнение задач №000057586
				   |	КонтролируемаяСделкаСделки.ОКТМОСовершенияСделки КАК ОКТМОСовершенияСделки,  
				   |	КонтролируемаяСделкаСделки.ИдентификаторЛиста1Б КАК ИдентификаторЛиста1Б,  
				   // КОНЕЦ Юдина Екатерина 20.03.2025 Выполнение задач №000053113
	               |	КонтролируемаяСделка.Валюта КАК Валюта,
	               |	КонтролируемаяСделка.СделкаСовершенаЧерезКомиссионера КАК СделкаСовершенаЧерезКомиссионера,
	               |	КонтролируемаяСделка.Комиссионер КАК Комиссионер,
	               |	КонтролируемаяСделка.ОснованиеКонтролируемости136 КАК Строка136СделкаМорскогоМесторождения,
	               |	КонтролируемаяСделка.ОснованиеКонтролируемости137 КАК Строка137СделкаИнвестиционныйПроект,
	               |	КонтролируемаяСделка.ОснованиеКонтролируемости138 КАК Строка138СделкаОсвобождениеОтНДС,
	               |	КонтролируемаяСделка.ОснованиеКонтролируемости139 КАК Строка139СделкаНалоговыйВычетПоНалогуНаПрибыль,
	               |	КонтролируемаяСделкаСделки.НомерСтроки КАК НомерСтроки,
	               |	КонтролируемаяСделкаСделки.ДатаСовершенияСделки КАК ДатаСовершенияСделки,
	               |	КонтролируемаяСделкаСделки.Количество КАК Количество,
	               |	ЕСТЬNULL(КонтролируемаяСделкаСделки.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмерения,
	               |	КонтролируемаяСделкаСделки.Цена КАК Цена,
	               |	КонтролируемаяСделкаСделки.КодУсловийПоставки КАК КодУсловийПоставки,
	               |	ВЫРАЗИТЬ(КонтролируемаяСделкаСделки.Стоимость КАК ЧИСЛО(15, 2)) КАК Стоимость,
	               |	КонтролируемаяСделкаСделки.СтранаОтправкиТовара.Код КАК СтранаОтправкиТовара,
	               |	КонтролируемаяСделкаСделки.КодРегионаОтправкиТовара КАК КодРегионаОтправкиТовара,
	               |	КонтролируемаяСделкаСделки.ГородОтправкиТовара КАК ГородОтправкиТовара,
	               |	КонтролируемаяСделкаСделки.НаселенныйПунктОтправкиТовара КАК НаселенныйПунктОтправкиТовара,
	               |	КонтролируемаяСделкаСделки.СтранаСовершенияСделки.Код КАК СтранаСовершенияСделки,
	               |	КонтролируемаяСделкаСделки.КодРегионаСовершенияСделки КАК КодРегионаСовершенияСделки,
	               |	КонтролируемаяСделкаСделки.ГородСовершенияСделки КАК ГородСовершенияСделки,
	               |	КонтролируемаяСделкаСделки.НаселенныйПунктСовершенияСделки КАК НаселенныйПунктСовершенияСделки,
	               |	КонтролируемаяСделкаСделки.ПроцентнаяСтавка КАК ПроцентнаяСтавка
	               |ИЗ
	               |	Документ.КонтролируемаяСделка.Сделки КАК КонтролируемаяСделкаСделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтролируемаяСделка КАК КонтролируемаяСделка
	               |		ПО КонтролируемаяСделкаСделки.Ссылка = КонтролируемаяСделка.Ссылка
	               |ГДЕ
	               |	НЕ КонтролируемаяСделка.ПометкаУдаления
	               |	И КонтролируемаяСделка.Контрагент В(&Контрагент) 
				   //НАЧАЛО Качикина 13.05.2026 Выполнение задач №000057648
				   //|	И КонтролируемаяСделка.УведомлениеОКонтролируемойСделке.ОтчетныйГод = &ОтчетныйГод
				   //|	И КонтролируемаяСделка.УведомлениеОКонтролируемойСделке.НомерКорректировки = &НомерКорректировки"; 
				   |	И КонтролируемаяСделка.УведомлениеОКонтролируемойСделке = &Уведомление";
				   //КОНЕЦ Качикина 13.05.2026 Выполнение задач №000057648
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	//НАЧАЛО Качикина 13.05.2026 Выполнение задач №000057648
	//Запрос.УстановитьПараметр("ОтчетныйГод", Дата(Год(Объект.Уведомление.ОтчетныйГод),1,1));
	//Запрос.УстановитьПараметр("НомерКорректировки", Объект.Уведомление.НомерКорректировки); 
	Запрос.УстановитьПараметр("Уведомление", Объект.Уведомление);
	//КОНЕЦ Качикина 13.05.2026 Выполнение задач №000057648
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	//типы колонки ПредметСделки в ерп и каркас отличаются 
	МассивТиповПС = Новый Массив;
	МассивТиповПС.Добавить(Тип("СправочникСсылка.Номенклатура"));
	МассивТиповПС.Добавить(Тип("СправочникСсылка.НематериальныеАктивы"));
	МассивТиповПС.Добавить(Тип("Строка")); 
	
	РезультатЗапроса.Колонки.Добавить("ПредметСделки",Новый ОписаниеТипов(МассивТиповПС));
	
	СоответствиеКодов = КонтролируемыеСделкиПовтИсп.СоответствиеКодовСтороныСделки();
	
	Для каждого Строка Из РезультатЗапроса Цикл
		ПротивоположныйКод = ПолучитьПротивоположныйКодСделки(Строка, СоответствиеКодов);
		Строка.КодСтороныСделки = ПротивоположныйКод;  
		
		Если ТипЗнч(Строка.ПредметСделки_ERP) = Тип("СправочникСсылка.ОбъектыЭксплуатации") Тогда
			Строка.ПредметСделки = Строка(Строка.ПредметСделки_ERP.УникальныйИдентификатор());
		ИначеЕсли ТипЗнч(Строка.ПредметСделки_ERP) = Тип("ПеречислениеСсылка.ТипыСуммГрафикаКредитовИДепозитов") Тогда 
			Строка.ПредметСделки = Неопределено; 
		Иначе
			Строка.ПредметСделки = Строка.ПредметСделки_ERP;	
		КонецЕсли; 
		
	КонецЦикла;	
	
	РезультатЗапроса.Колонки.Удалить("ПредметСделки_ERP"); 
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Результат = WebPort1C.Сериализовать(РезультатЗапроса);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

&НаСервере
Функция ПолучитьПротивоположныйКодСделки(Строка, СоответствиеКодов)
	
	КодСделки = Неопределено;
	
	СписокКодов = СоответствиеКодов.Получить(Строка.КодНаименованияСделки);
	Если НЕ СписокКодов = Неопределено Тогда
		Для каждого Код Из СписокКодов Цикл
			Если НЕ Код.Значение = Строка.КодСтороныСделки Тогда
				КодСделки = Код.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Возврат КодСделки
	
КонецФункции

#КонецОбласти