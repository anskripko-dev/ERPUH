
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.тн_СписокКонтрагентов = Параметры.тн_СписокКонтрагентов;
	КонтрагентыДляВыбора.ЗагрузитьЗначения(ПолучитьСписокКонтрагентовДляВыбора(Параметры.Организация));
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	Закрыть(Объект.тн_СписокКонтрагентов);
КонецПроцедуры

&НаКлиенте
Процедура тн_СписокКонтрагентовЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = КонтрагентыДляВыбора;
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьСписокКонтрагентовДляВыбора(Организация)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ВзаимозависимыеЛица.Контрагент КАК Контрагент
	               |ИЗ
	               |	РегистрСведений.ВзаимозависимыеЛица КАК ВзаимозависимыеЛица
	               |ГДЕ
	               |	ВзаимозависимыеЛица.Организация = &Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВзаимозависимыеЛица.Контрагент.Наименование";
	
	Запрос.УстановитьПараметр("Организация", Организация); 
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Контрагент"); 
	
	
КонецФункции


