#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОтправитьУведомления() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РеестрДокументов.Ссылка КАК Ссылка,
	               |	РеестрДокументов.ТипСсылки КАК ТипСсылки,
	               |	СостоянияОригиналовПервичныхДокументов.Состояние КАК СостояниеОригиналаПервичногоДокумента,
	               |	ВЫБОР
	               |		КОГДА СостоянияОригиналовПервичныхДокументов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияОригиналовПервичныхДокументов.ОригиналПолучен)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СостояниеОригиналПолучен,
	               |	ВЫБОР
	               |		КОГДА СостоянияОригиналовПервичныхДокументов.Состояние = ЗНАЧЕНИЕ(Справочник.СостоянияОригиналовПервичныхДокументов.Пустаяссылка)
	               |				ИЛИ СостоянияОригиналовПервичныхДокументов.Состояние ЕСТЬ NULL
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СостояниеОригиналНеПолучен
	               |ПОМЕСТИТЬ СостоянияДокументов
	               |ИЗ
	               |	РегистрСведений.РеестрДокументов КАК РеестрДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОригиналовПервичныхДокументов КАК СостоянияОригиналовПервичныхДокументов
	               |		ПО (СостоянияОригиналовПервичныхДокументов.Владелец = РеестрДокументов.Ссылка)
	               |ГДЕ
	               |	РеестрДокументов.Проведен
	               |	И (ТИПЗНАЧЕНИЯ(РеестрДокументов.Ссылка) = ТИП(Документ.ПриобретениеТоваровУслуг)
	               |			ИЛИ ТИПЗНАЧЕНИЯ(РеестрДокументов.Ссылка) = ТИП(Документ.ПриобретениеУслугПрочихАктивов))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫРАЗИТЬ(ПриобретениеУслугПрочихАктивов.тн_ЗамечаниеКДокументу КАК СТРОКА(10)) КАК тн_ЗамечаниеКДокументу,
	               |	ПриобретениеУслугПрочихАктивов.Ссылка КАК Ссылка,
	               |	ПриобретениеУслугПрочихАктивов.тн_ОтветственныйСотрудник КАК тн_ОтветственныйСотрудник
	               |ПОМЕСТИТЬ ДокументыПоступления
	               |ИЗ
	               |	Документ.ПриобретениеУслугПрочихАктивов КАК ПриобретениеУслугПрочихАктивов
	               |ГДЕ
	               |	ПриобретениеУслугПрочихАктивов.Ссылка В
	               |			(ВЫБРАТЬ
	               |				СостоянияДокументов.Ссылка КАК Ссылка
	               |			ИЗ
	               |				СостоянияДокументов КАК СостоянияДокументов)
	               |	И НЕ ПриобретениеУслугПрочихАктивов.тн_ОтветственныйСотрудник = &тн_ОтветственныйСотрудник
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ПриобретениеТоваровУслуг.тн_ЗамечаниеКДокументу КАК СТРОКА(10)),
	               |	ПриобретениеТоваровУслуг.Ссылка,
	               |	ПриобретениеТоваровУслуг.тн_ОтветственныйСотрудник
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	               |ГДЕ
	               |	ПриобретениеТоваровУслуг.Ссылка В
	               |			(ВЫБРАТЬ
	               |				СостоянияДокументов.Ссылка КАК Ссылка
	               |			ИЗ
	               |				СостоянияДокументов КАК СостоянияДокументов)
	               |	И НЕ ПриобретениеТоваровУслуг.тн_ОтветственныйСотрудник = &тн_ОтветственныйСотрудник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокументыПоступления.тн_ОтветственныйСотрудник КАК ОтветственныйСотрудник,
	               |	ПРЕДСТАВЛЕНИЕ(ДокументыПоступления.тн_ОтветственныйСотрудник) КАК ОтветственныйСотрудникПредставление
	               |ИЗ
	               |	СостоянияДокументов КАК СостоянияДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыПоступления КАК ДокументыПоступления
	               |		ПО СостоянияДокументов.Ссылка = ДокументыПоступления.Ссылка
	               |ГДЕ
	               |	СостоянияДокументов.СостояниеОригиналПолучен = 1
	               |	И НЕ ДокументыПоступления.тн_ЗамечаниеКДокументу = &ПустаяСтрока
	               |	И НЕ ДокументыПоступления.тн_ОтветственныйСотрудник ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДокументыПоступления.тн_ОтветственныйСотрудник
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ДокументыПоступления.тн_ОтветственныйСотрудник,
	               |	ПРЕДСТАВЛЕНИЕ(ДокументыПоступления.тн_ОтветственныйСотрудник)
	               |ИЗ
	               |	СостоянияДокументов КАК СостоянияДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыПоступления КАК ДокументыПоступления
	               |		ПО СостоянияДокументов.Ссылка = ДокументыПоступления.Ссылка
	               |ГДЕ
	               |	СостоянияДокументов.СостояниеОригиналНеПолучен = 1
	               |	И НЕ ДокументыПоступления.тн_ОтветственныйСотрудник ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДокументыПоступления.тн_ОтветственныйСотрудник";
	
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	Запрос.УстановитьПараметр("тн_ОтветственныйСотрудник", Справочники.ФизическиеЛица.ПустаяСсылка());
	
	ОтветственныеСотрудники = Запрос.Выполнить().Выгрузить(); 
	
	Если ОтветственныеСотрудники.Количество() > 0 Тогда
		
		СхемаКомпоновки = Отчеты.тн_СостоянияОригиналовПервичныхДокументов.ПолучитьМакет("СостоянияОригиналовПервичныхДокументовПоОтветственному"); 
		
		Настройки = СхемаКомпоновки.НастройкиПоУмолчанию;
		
		МассивПисем = Новый Массив;
		УчетнаяЗапись =  УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();

		Для Каждого СтрокаТЧ Из ОтветственныеСотрудники Цикл 
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			
			ПараметрОтветствтенный = Настройки.ПараметрыДанных.Элементы.Найти("тн_ОтветственныйСотрудник");
			ПараметрОтветствтенный.Значение = СтрокаТЧ.ОтветственныйСотрудник;
			ПараметрОтветствтенный.Использование = Истина;
			
			Расшифровка = Новый ДанныеРасшифровкиКомпоновкиДанных;
			КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;    
			
			МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки, Расшифровка);    
			ВнешниеПараметры = Новый Структура;    
			
			ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
			ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеПараметры, Расшифровка);    
			
			ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
			ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);    
			ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);     
			
			ИмяФайла = СтрЗаменить(СтрокаТЧ.ОтветственныйСотрудникПредставление, " ", "") + ".xls";
			
			//НАЧАЛО Блинова М.А. 14.02.2023 Выполнение задач №000044382
			Если УчетнаяЗапись.тн_ИспользоватьEWSService Тогда 
			//КОНЕЦ Блинова М.А. 14.02.2023 Выполнение задач №000044382	
			  ДобавитьПисьмо(МассивПисем, ТабличныйДокумент, ИмяФайла, СтрокаТЧ.ОтветственныйСотрудник);
			//НАЧАЛО Блинова М.А. 14.02.2023 Выполнение задач №000044382
		    Иначе
			  ДобавитьПисьмоДляВстроенногоКлиента(МассивПисем, ТабличныйДокумент, ИмяФайла, СтрокаТЧ.ОтветственныйСотрудник, УчетнаяЗапись)
		 	КонецЕсли;
		    //КОНЕЦ Блинова М.А. 14.02.2023 Выполнение задач №000044382
		КонецЦикла;
		
		Если МассивПисем.Количество() > 0 Тогда 
			ОписаниеОшибки = "";
			РезультатОтправки = РаботаСПочтовымиСообщениямиСлужебный.ОтправитьПисьма(УчетнаяЗапись, МассивПисем, ОписаниеОшибки); 
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры 

Процедура ДобавитьПисьмо(Письма, ТабличныйДокумент, ИмяФайла, ОтветственныйСотрудник)
	
	Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		Возврат;
	КонецЕсли;   
	
	Письмо = Новый Структура; 
	Письмо.Вставить("ИмяОтправителя",	"");
	Письмо.Вставить("Отправитель", Новый Структура("ОтображаемоеИмя, Адрес"));
	Письмо.Вставить("СлепыеКопии", Новый Массив);
	
	ПолучателиПисьма = Новый ТаблицаЗначений;
	ПолучателиПисьма.Колонки.Добавить("Адрес");
	ПолучателиПисьма.Колонки.Добавить("Представление");
	ПолучателиПисьма.Колонки.Добавить("Контакт");
	
	НоваяСтрока = ПолучателиПисьма.Добавить();
	АдресПолучателя					= ПолучитьПолучателяПисьма(ОтветственныйСотрудник);
	
	Если Не ЗначениеЗаполнено(АдресПолучателя) Тогда 
		Возврат;
	КонецЕсли;
	
	НоваяСтрока.Адрес				= АдресПолучателя;
	НоваяСтрока.Представление		= АдресПолучателя;
	НоваяСтрока.Контакт				= ОтветственныйСотрудник;

	Письмо.Вставить("Получатели", ПолучателиПисьма);
	Письмо.Вставить("ИдентификаторСообщения", Строка(Новый УникальныйИдентификатор));
	Письмо.Вставить("Тема", "Отчет о состоянии оригиналов первичных документов");
	Письмо.Вставить("Копии", Новый Массив);
	Письмо.Вставить("ОбратныйАдрес", Новый Массив);
	
	Письмо.Вставить("Вложения", СформироватьВложение(ТабличныйДокумент, ИмяФайла));

	Письмо.Вставить("Важность", Перечисления.ВариантыВажностиВзаимодействия.Обычная);
	
	Письмо.Вставить("УведомитьОДоставке", Ложь);
	Письмо.Вставить("УведомитьОПрочтении", Ложь);
	
	
	ШаблонТекста = НСтр("ru = 'Уважаемый(ая) %1!  
	|Во вложении отчет о состоянии оригиналов первичных документов. 
	|С уважением, Финансовая служба Компании ТехноНИКОЛЬ'");
	ТекстПисьма = СтрШаблон(ШаблонТекста, ОтветственныйСотрудник);
	Тексты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("Текст",ТекстПисьма));
	
	Письмо.Вставить("Тексты", Тексты);
	
	Письма.Добавить(Письмо);		
	
КонецПроцедуры	

Функция СформироватьВложение(ТабличныйДокумент, ИмяФайла)
	
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоКаталога); 
	ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога) + ИмяФайла);
	
	ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS);     
	Вложение = Новый Структура("Данные, ИмяФайла, Идентификатор", Новый ДвоичныеДанные(ПолноеИмяФайла), ИмяФайла, Строка(Новый УникальныйИдентификатор));
	
	СписокВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);  
	УдалитьФайлы(ПолноеИмяФайла);

	Возврат  СписокВложений;

КонецФункции // СформироватьВложение()

Функция ПолучитьПолучателяПисьма(ОтветственныйСотрудник)
	
	Почта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ОтветственныйСотрудник,Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
	Если ТипЗнч(Почта) = Тип("Строка") Тогда 
		Возврат Почта;
	КонецЕсли;	
	
	Возврат "";
	
КонецФункции

//Блинова М.А. 14.02.2023 Выполнение задач №000044382
Процедура ДобавитьПисьмоДляВстроенногоКлиента(Письма, ТабличныйДокумент, ИмяФайла, ОтветственныйСотрудник, УчетнаяЗапись)

	Если ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
		Возврат;
	КонецЕсли;   
	
	Письмо = Новый ИнтернетПочтовоеСообщение;	
	АдресПолучателя					= ПолучитьПолучателяПисьма(ОтветственныйСотрудник);
	Если Не ЗначениеЗаполнено(АдресПолучателя) Тогда 
		Возврат;
	КонецЕсли;

	Получатель = Письмо.Получатели.Добавить(АдресПолучателя);
	Получатель.ОтображаемоеИмя = Строка(ОтветственныйСотрудник);
	РеквизитыОтправителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "ИмяПользователя, АдресЭлектроннойПочты");
	Письмо.ИмяОтправителя = РеквизитыОтправителя.ИмяПользователя;
	Письмо.Тема = "Отчет о состоянии оригиналов первичных документов"; 
	
	ИмяВременногоКаталога = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременногоКаталога); 
	ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога) + ИмяФайла);
	
	ТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS);     
	
	Письмо.Вложения.Добавить(Новый ДвоичныеДанные(ПолноеИмяФайла), ИмяФайла); 
	УдалитьФайлы(ПолноеИмяФайла);

	Письмо.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;	
	Письмо.УведомитьОДоставке = Ложь;
	Письмо.УведомитьОПрочтении = Ложь;	
	
	ШаблонТекста = НСтр("ru = 'Уважаемый(ая) %1!  
	|Во вложении отчет о состоянии оригиналов первичных документов. 
	|С уважением, Финансовая служба Компании ТехноНИКОЛЬ'");
	ТекстПисьма = СтрШаблон(ШаблонТекста, ОтветственныйСотрудник);
		
	Письмо.Тексты.Добавить(ТекстПисьма, ТипТекстаПочтовогоСообщения.ПроизвольныйТекст);	
	Письма.Добавить(Письмо);		

КонецПроцедуры 

#КонецЕсли  