#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	тн_ОбщегоНазначения.ОбновитьСписокКодовВидаОперации(Период.ДатаОкончания, Элементы.СписокДокументовКодВидаОперации.СписокВыбора);	
	ИнициализироватьКомпоновщик();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы 


#КонецОбласти

#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура Заполнить(Команда) 
	
	Если СписокДокументов.Количество() > 0  Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса_Заполнить_Завершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Таблица документов будет перезаполнена. Продолжить выполнение операции?'"),
		РежимДиалогаВопрос.ДаНет, 0);	
	Иначе
		ЗаполнитьСписокДокументовНаСервере(); 
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияВопроса_Заполнить_Завершение(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда   
		Возврат;
	КонецЕсли; 
	СписокДокументов.Очистить();
	ЗаполнитьСписокДокументовНаСервере(); 
	
КонецПроцедуры     

&НаКлиенте
Процедура ЗаписатьКодОперации(Команда)   
	
	ТекстСообщенияОшибки = ЗаписатьКодОперацииНаСервере();  
	Если ТекстСообщенияОшибки <> "" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщенияОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодОпераций(Команда)
	
	ЗаполнитьКодОперацийНаСервере();  
	
КонецПроцедуры   

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	УстановитьПометкиВТаблице(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	УстановитьПометкиВТаблице(Ложь);

КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьКодОперацииСВыборомКода(Команда) 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьКодОперацииСВыборомКода_Завершение",ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура;
	
	ОткрытьФорму("Обработка.тн_ГрупповоеИзменениеКодаВидаОперации.Форма.ФормаВыбораКода", 
	    ПараметрыОткрытия, , , , ,ОписаниеОповещения ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры 
			
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьКодОперацииНаСервере()  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписокДокументов.Ссылка КАК Документ,
	               |	СписокДокументов.тн_КодВидаОперации КАК тн_КодВидаОперации,
	               |	СписокДокументов.Номенклатура КАК Номенклатура,
	               |	СписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки
	               |ПОМЕСТИТЬ втСписокДокументовПредварительно
	               |ИЗ
	               |	&СписокДокументов КАК СписокДокументов
	               |ГДЕ
	               |	СписокДокументов.ПометкаВыделения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СписокДокументов.Документ КАК Документ,
	               |	СписокДокументов.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	СписокДокументов.Номенклатура КАК Номенклатура,
	               |	СписокДокументов.тн_КодВидаОперации КАК тн_КодВидаОперации,
	               |	ЕСТЬNULL(СведенияТаможенныхДекларацийЭкспорт.Регистратор, НЕОПРЕДЕЛЕНО) КАК Регистратор,
	               |	СведенияТаможенныхДекларацийЭкспорт.Период КАК Период,
	               |	СведенияТаможенныхДекларацийЭкспорт.Организация КАК Организация,
	               |	СведенияТаможенныхДекларацийЭкспорт.КодТС КАК КодТС,
	               |	СведенияТаможенныхДекларацийЭкспорт.ВидДокумента КАК ВидДокумента,
	               |	СведенияТаможенныхДекларацийЭкспорт.НомерТСД КАК НомерТСД,
	               |	СведенияТаможенныхДекларацийЭкспорт.ДатаТСД КАК ДатаТСД,
	               |	СведенияТаможенныхДекларацийЭкспорт.НомерТаможеннойДекларации КАК НомерТаможеннойДекларации,
	               |	СведенияТаможенныхДекларацийЭкспорт.Примечание КАК Примечание
	               |ИЗ
	               |	втСписокДокументовПредварительно КАК СписокДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияТаможенныхДекларацийЭкспорт КАК СведенияТаможенныхДекларацийЭкспорт
	               |		ПО СписокДокументов.Документ = СведенияТаможенныхДекларацийЭкспорт.ДокументОтгрузки
	               |			И (СведенияТаможенныхДекларацийЭкспорт.Регистратор ССЫЛКА Документ.ТаможеннаяДекларацияЭкспорт)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СписокДокументов.Документ,
	               |	ЕСТЬNULL(СведенияТаможенныхДекларацийЭкспорт.Регистратор, НЕОПРЕДЕЛЕНО),
	               |	СписокДокументов.ИдентификаторСтроки,
	               |	СписокДокументов.тн_КодВидаОперации,
	               |	СписокДокументов.Номенклатура,
	               |	СведенияТаможенныхДекларацийЭкспорт.Период,
	               |	СведенияТаможенныхДекларацийЭкспорт.Организация,
	               |	СведенияТаможенныхДекларацийЭкспорт.КодТС,
	               |	СведенияТаможенныхДекларацийЭкспорт.ВидДокумента,
	               |	СведенияТаможенныхДекларацийЭкспорт.НомерТСД,
	               |	СведенияТаможенныхДекларацийЭкспорт.ДатаТСД,
	               |	СведенияТаможенныхДекларацийЭкспорт.НомерТаможеннойДекларации,
	               |	СведенияТаможенныхДекларацийЭкспорт.Примечание
	               |ИТОГИ ПО
	               |	Документ,
	               |	Регистратор";
	
	Запрос.УстановитьПараметр("СписокДокументов", РеквизитФормыВЗначение("СписокДокументов")); 	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТекстСообщенияОшибки = ""; 
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Документ = ВыборкаДокумент.Документ; 
		ДокументОбъект = Документ.ПолучитьОбъект();
		ВыборкаСведенияТД = ВыборкаДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Регистратор");
		
		Пока ВыборкаСведенияТД.Следующий() Цикл
			
			ЕстьСведенияТД = ЗначениеЗаполнено(ВыборкаСведенияТД.Регистратор);
			
			Если ЕстьСведенияТД Тогда
				НаборЗаписей = РегистрыСведений.тн_СведенияТаможенныхДекларацийЭкспорт.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаСведенияТД.Регистратор);
				ТаблицаСведений = НаборЗаписей.Выгрузить();
			КонецЕсли;
			
			Выборка = ВыборкаСведенияТД.Выбрать();
			Пока Выборка.Следующий() Цикл  
				
				НайденнаяСтрока = ДокументОбъект.Товары.Найти(Выборка.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если НайденнаяСтрока <> Неопределено Тогда  
					НайденнаяСтрока.тн_КодВидаОперации = Выборка.тн_КодВидаОперации;
				КонецЕсли;
				
				Если ЕстьСведенияТД Тогда  
					НС = ТаблицаСведений.Добавить();
					ЗаполнитьЗначенияСвойств(НС, Выборка);
					НС.ДокументОтгрузки = Выборка.Документ;
					НС.КодОперации  = Выборка.тн_КодВидаОперации;  
					НС.Активность  = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;  
		
		Если ЕстьСведенияТД Тогда
			НаборЗаписей.Загрузить(ТаблицаСведений);
		КонецЕсли;  
		
		НачатьТранзакцию();
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);      
			Если ЕстьСведенияТД Тогда
				НаборЗаписей.Записать(); 
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение  
			ОтменитьТранзакцию();
			ТекстСообщенияОшибки = ТекстСообщенияОшибки + 
			"Не удалось записать документ " + Документ + ОписаниеОшибки();
		КонецПопытки;  
		
	КонецЦикла;
	
	Возврат ТекстСообщенияОшибки;
	
КонецФункции

&НаСервере
Процедура ИнициализироватьКомпоновщик()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет("Макет");
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	
	Обработка.КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	Обработка.КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	ОтборКомпоновки = Обработка.КомпоновщикНастроек.Настройки.Отбор;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
КонецПроцедуры // ИнициализироватьКомпоновщик()

&НаКлиенте
Процедура УстановитьПометкиВТаблице(НоваяПометка)
	
	Для Каждого СтрокаТЗ Из СписокДокументов Цикл
		СтрокаТЗ.ПометкаВыделения = НоваяПометка;
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовНаСервере()
		
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Обработка.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	Обработка.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", Период.ДатаОкончания);
	Обработка.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", Организация);
	
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет("Макет");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Обработка.КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки); 
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ЗначениеВРеквизитФормы(Результат, "СписокДокументов");
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьКодОперацийНаСервере()
	
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
		
	Результат = тн_ОбщегоНазначения.ЗаполнитьКодВидаОперацииОтгрузки(Организация, РеквизитФормыВЗначение("СписокДокументов"));
	ЗначениеВРеквизитФормы(Результат, "СписокДокументов"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодОперацииСВыборомКода_Завершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если Не РезультатЗакрытия = Неопределено Тогда 
		
		Для Каждого Строка Из СписокДокументов Цикл  
			Если Строка.ПометкаВыделения Тогда
				Строка.тн_КодВидаОперации = РезультатЗакрытия;
			КонецЕсли;
		КонецЦикла;    
		
	КонецЕсли;
	
КонецПроцедуры
			
#КонецОбласти  