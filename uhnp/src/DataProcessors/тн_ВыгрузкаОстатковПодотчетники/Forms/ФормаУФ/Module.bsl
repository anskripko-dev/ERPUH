
&НаСервереБезКонтекста
Процедура ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ВремИмяФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ДвоичныеДанные.Записать(ВремИмяФайла);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВремИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область(4,2, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы));
	Построитель.Выполнить();
	ТаблицаЗначений = Построитель.Результат.Выгрузить();
	
	МассивДокументов = Новый Массив;
	ДокОбъектЗадолженность = Неопределено;
	ДокОбъектПерерасход = Неопределено;
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ТекущаяДата = ТекущаяДата();  
	ТекущаяДата = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Дата = ?(ЗначениеЗаполнено(ДатаДокументов),КонецДня(ДатаДокументов), ТекущаяДата);
	Задолженность = Неопределено;
	Комментарий = "#Перенос остатков по подотчетникам "+ТекущаяДата;
	СтруктураЗаполненияЗадолженность = Новый Структура("ХозяйственнаяОперация, Комментарий", Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиПодотчетников, Комментарий);
	СтруктураЗаполненияПерерасход = Новый Структура("ХозяйственнаяОперация, Комментарий", Перечисления.ХозяйственныеОперации.ВводОстатковПерерасходовПодотчетныхСредств, Комментарий);
	
	ВалютаРуб = Справочники.Валюты.НайтиПоКоду("643");
	ОрганизацияТНСС = Справочники.Организации.НайтиПоНаименованию("ТН-Строительные Системы");
	
	Для Каждого Стр Из ТаблицаЗначений Цикл
		
		Если ПустаяСтрока(Стр.Физлицо) Тогда
			Продолжить;
		КонецЕсли;
		
		Сумма = ПреобразоватьВЧисло(Стр.СуммаВзаиморасчетовОстаток);
		СуммаУпр = ПреобразоватьВЧисло(Стр.СуммаУпрОстаток);
		
		Если Сумма > 0 Тогда
			Задолженность = Истина;	
		Иначе
			Задолженность = Ложь;
			Сумма = -Сумма;
			СуммаУпр = -СуммаУпр;
		КонецЕсли;
		
		Если Сумма < 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Задолженность Тогда
			ДокОбъект = ДокОбъектЗадолженность;	
		Иначе
			ДокОбъект = ДокОбъектПерерасход;	
		КонецЕсли;
		
		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.Организация));
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = ОрганизацияТНСС;
		КонецЕсли;
		
		Если ДокОбъект = Неопределено
			ИЛИ (ДокОбъект <> Неопределено И Организация <> ДокОбъект.Организация) 
			ИЛИ (ДокОбъект <> Неопределено И ДокОбъект.РасчетыСПодотчетниками.Количество() > 9999) Тогда
			Если ДокОбъект <> Неопределено Тогда
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				Исключение					
					ДокОбъект.ОбменДанными.Загрузка = Истина;
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
					ОбщегоНазначения.СообщитьПользователю("Ошибка записи документа " + ДокОбъект.Ссылка, ДокОбъект.Ссылка);
				КонецПопытки;
				МассивДокументов.Добавить(ДокОбъект.Ссылка);
			КонецЕсли;
			ДокОбъект = Документы.ВводОстатков.СоздатьДокумент();
			Если Задолженность Тогда
				ДокОбъект.Заполнить(СтруктураЗаполненияЗадолженность);	
			Иначе
				ДокОбъект.Заполнить(СтруктураЗаполненияПерерасход);
			КонецЕсли;			
			ДокОбъект.Дата = Дата;
			ДокОбъект.Организация = Организация;
			ДокОбъект.ОтражатьВОперативномУчете = Истина;
			ДокОбъект.ОтражатьВБУиНУ = Истина;
		КонецЕсли;
		
		НовСтр = ДокОбъект.РасчетыСПодотчетниками.Добавить();
		
		НовСтр.ПодотчетноеЛицо = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ФизЛицо));
		НовСтр.Валюта = Справочники.Валюты.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.Валюта));
		Если Не ЗначениеЗаполнено(НовСтр.Валюта) Тогда
			НовСтр.Валюта = ВалютаРуб;	
		КонецЕсли;
		НовСтр.Сумма = Сумма;
		//валюта регл и упр учета совпадают 		
		НовСтр.СуммаУпр = СуммаУпр;
		НовСтр.СуммаРегл = НовСтр.СуммаУпр;
				
		Если Задолженность Тогда
			ДокОбъектЗадолженность = ДокОбъект;	
		Иначе
			ДокОбъектПерерасход = ДокОбъект;;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокОбъектЗадолженность <> Неопределено 
		И ДокОбъектЗадолженность.РасчетыСПодотчетниками.Количество() > 0 Тогда
		ДокОбъектЗадолженность.Записать(РежимЗаписиДокумента.Запись);
		МассивДокументов.Добавить(ДокОбъектЗадолженность.Ссылка);
	КонецЕсли;
	
	Если ДокОбъектПерерасход <> Неопределено 
		И ДокОбъектПерерасход.РасчетыСПодотчетниками.Количество() > 0 Тогда
		ДокОбъектПерерасход.Записать(РежимЗаписиДокумента.Запись);
		МассивДокументов.Добавить(ДокОбъектПерерасход.Ссылка);
	КонецЕсли;
	
	Для Каждого ДокСсылка Из МассивДокументов Цикл
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Попытка
			//ДокОбъект.ОбменДанными.Загрузка = Ложь;
			ОбщегоНазначения.СообщитьПользователю(ДокСсылка, ДокСсылка);
			Если ДокОбъект.ПроверитьЗаполнение() Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Ошибка проведения документа " + ДокСсылка, ДокСсылка);
		КонецПопытки;
	КонецЦикла;
		
	УдалитьФайлы(ВремИмяФайла);	
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка завершена. Создано документов: " + МассивДокументов.Количество());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПреобразоватьВЧисло(ЧислоСтр)
	
	Возврат  Число(?(ПустаяСтрока(ЧислоСтр), 0, СтрЗаменить(ЧислоСтр, " ", "")));
	
КонецФункции

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	ЗагрузитьНаСервере(АдресХранилища, ДатаДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборФайла", ЭтаФорма);
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx";
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];	
	КонецЕсли;
	
КонецПроцедуры
