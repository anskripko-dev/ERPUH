// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура ЗаполнитьПартииВДокументахВозврата()

	КоличествоОбработанныхДокументов = 0;
	КоличествоНеОбработанныхДокументов = 0;
	
	// НАЧАЛО Майдан Василий 27.06.2023 Выполнение задач №000045968 
	пОтказ = Ложь;
	
	ДокументыПриобретения = Новый ТаблицаЗначений;
	ДокументыПриобретения.Колонки.Добавить("Регистратор", 					Новый ОписаниеТипов("ДокументСсылка.ВозвратТоваровПоставщику"));
	ДокументыПриобретения.Колонки.Добавить("АналитикаУчетаНоменклатуры", 	Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиУчетаНоменклатуры"));
	ДокументыПриобретения.Колонки.Добавить("ИдентификаторСтроки",			ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ДокументыПриобретения.Колонки.Добавить("КоличествоУпаковок", 			ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ДокументыПриобретения.Колонки.Добавить("КоличествоУпаковокБаза",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ДокументыПриобретения.Колонки.Добавить("Сумма", 						ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДокументыПриобретения.Колонки.Добавить("СуммаБаза",						ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДокументыПриобретения.Колонки.Добавить("СуммаНДС", 						ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДокументыПриобретения.Колонки.Добавить("СуммаНДСБаза",					ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДокументыПриобретения.Колонки.Добавить("СуммаСНДС", 					ОбщегоНазначения.ОписаниеТипаЧисло(15, 2)); 
	ДокументыПриобретения.Колонки.Добавить("СуммаСНДСБаза",					ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ДокументыПриобретения.Колонки.Добавить("Цена", 							ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	// КОНЕЦ Майдан Василий 27.06.2023 Выполнение задач №000045968
	
	//Получение выборки с сопоставленными приобретениями к возвратам
	РезультатПоРегистраторам = ПолучитьВыборкуПоРегистраторам();
	//Далее контролируется обеспечение по документам возврата в целом и происходит заполнение возвратов
	Пока РезультатПоРегистраторам.Следующий() Цикл
		
		Попытка
			Регистратор = РезультатПоРегистраторам.ДокументВозврата;
			
			КоличествоПартииОкр = Формат(РезультатПоРегистраторам.КоличествоПартии, "ЧЦ=15; ЧДЦ=3");
			КоличествоПоДокументуОкр = Формат(РезультатПоРегистраторам.КоличествоПоДокументу, "ЧЦ=15; ЧДЦ=3");  
			
			ДокументНеОбработан = Ложь;
			Если РезультатПоРегистраторам.КоличествоПартии <> РезультатПоРегистраторам.КоличествоПоДокументу
				И КоличествоПартииОкр <> КоличествоПоДокументуОкр Тогда
				ОбщегоНазначения.СообщитьПользователю("! Документ не обработан "+Строка(Регистратор), Регистратор);
				
				КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
				НоваяСтрока = НеобработанныеДокументы.Добавить();									
				НоваяСтрока.Документ = Регистратор;
				НоваяСтрока.НомерСтроки = КоличествоНеОбработанныхДокументов;
				ДокументНеОбработан = Истина;
			КонецЕсли;
			
			ДокументОбъект	 = Регистратор.ПолучитьОбъект();			
			ТЧТовары		 = ДокументОбъект.Товары;
			СтрокаСДанными	 = Неопределено;
			МассивСтрок		 = Новый массив;
			АналитикаДляСообщения = Неопределено; 		
			
			Результат		 = РезультатПоРегистраторам.Выбрать();			
			Пока Результат.Следующий() Цикл
				
				//Если документ не обработан частично, тогда все строки заполнены не будут
				//Заполняется только документ который полностью удается обеспечить остатком
				Если ДокументНеОбработан Тогда
					//вывод расшифровки ошибки по аналитике учета номенклатуры
					Если Результат.КоличествоПартии < Результат.Количество Тогда
						//Вывод сообщения по общему количеству аналитики
						Если АналитикаДляСообщения <> Результат.АналитикаУчетаНоменклатуры Тогда
							ОбщегоНазначения.СообщитьПользователю("! - "+Результат.АналитикаУчетаНоменклатуры+
							". Количество возврата ("+Строка(Результат.КоличествоВозврата)+
							") не соответствует приобретениям!");
						КонецЕсли;
						
						АналитикаДляСообщения = Результат.АналитикаУчетаНоменклатуры;
					КонецЕсли;
					Продолжить;	
				КонецЕсли;
				
				//ищем строки по текущей номенклатуре, удаляем их и добавляем столько строк, сколько в регистре
				Если СтрокаСДанными = Неопределено ИЛИ
					НЕ (СтрокаСДанными.АналитикаУчетаНоменклатуры = Результат.АналитикаУчетаНоменклатуры)
					Тогда
					
					//удаляем предыдущие элементы
					//удаляем незаполненные строки
					Если СтрокаСДанными <> Неопределено Тогда
						Для Каждого ЭлементМассива из МассивСтрок Цикл
							ТЧТовары.Удалить(ЭлементМассива);
						КонецЦикла;
					КонецЕсли;
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("АналитикаУчетаНоменклатуры",Результат.АналитикаУчетаНоменклатуры);			
					МассивСтрок = ТЧТовары.НайтиСтроки(ПараметрыОтбора);
					Если МассивСтрок.Количество() > 0 Тогда
						СтрокаСДанными = МассивСтрок[0];						
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрокаСДанными <> Неопределено Тогда
					НоваяСтрока = ТЧТовары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСДанными);
					НоваяСтрока.ДокументПоступления  = Результат.ДокументПриобретения;
					НоваяСтрока.Количество           = Результат.Количество;
					Если ЗначениеЗаполнено(Результат.ДокументПриобретения)
						И (Результат.ДокументПриобретения.Дата <= '20190101'
					//НАЧАЛО Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320 
						//И Результат.СтавкаНДС = Перечисления.СтавкиНДС.НДС18) Тогда
						//НоваяСтрока.СтавкаНДС		 = Перечисления.СтавкиНДС.НДС20;
					    И Результат.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка",18)) Тогда
						  НоваяСтрока.СтавкаНДС		 = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка",20);
					//КОНЕЦ Шабалкина Е.В. 10.11.2022 Выполнение задач №№000043320	
					Иначе
						НоваяСтрока.СтавкаНДС			 = Результат.СтавкаНДС;
					КонецЕсли;
					
					Цена = ПолучитьЦену(Результат.ДокументПриобретения, Результат.Цена, Результат.АналитикаУчетаНоменклатуры);
					
					//расчитываем цену и сумму
					Если ДокументОбъект.ЦенаВключаетНДС и НЕ Результат.ПартияЦенаВключаетНДС  Тогда
						//нужно прибавить НДС к цене в поступлении
						//НАЧАЛО Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
						//СтавкаНДСЧислом   = УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС)/100;
						СтавкаНДСЧислом   = НоваяСтрока.СтавкаНДС.Ставка/100;
						//КОНЕЦ Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
						НоваяСтрока.Цена  = Цена*(1 + СтавкаНДСЧислом);
					ИначеЕсли НЕ ДокументОбъект.ЦенаВключаетНДС и Результат.ПартияЦенаВключаетНДС  Тогда
						//нужно отнять НДС от цены в поступлении
						//НАЧАЛО Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
						//СтавкаНДСЧислом   = УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС)/100;
						СтавкаНДСЧислом   = НоваяСтрока.СтавкаНДС.Ставка/100;
						//КОНЕЦ Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
						НоваяСтрока.Цена  = Цена/(1+СтавкаНДСЧислом);
					Иначе
						НоваяСтрока.Цена = Цена;
					КонецЕсли;
					
					// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
					//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);						
					СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);						
					// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
					
					СтруктураДействий = Новый Структура;
					СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
                    // НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211					
                    //СтруктураДействий.Вставить("ПересчитатьСумму", "Количество"); 
					СтруктураДействий.Вставить("ПересчитатьСумму", "КоличествоУпаковок");
                    // КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211					
                    СтруктураДействий.Вставить("ПересчитатьЦенуПоСумме", "КоличествоУпаковок");
					СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
					
					// НАЧАЛО Майдан Василий 27.06.2023 Выполнение задач №000045968
					//ОбработкаТабличнойЧастиВызовСервера.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
					
					пТребуетсяПересчетЦены 	= Истина;
					
					Если ТипЗнч(СтрокаСДанными.ДокументПоступления) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
						
						пПараметрыОтбора = Новый Структура;
						пПараметрыОтбора.Вставить("АналитикаУчетаНоменклатуры", СтрокаСДанными.АналитикаУчетаНоменклатуры);	
						
						пМассивСтрокПриобретения = СтрокаСДанными.ДокументПоступления.Товары.НайтиСтроки(пПараметрыОтбора);
						
						Если пМассивСтрокПриобретения.Количество() > 0 Тогда           
							
							пСтрокаДокументаПоступления = пМассивСтрокПриобретения[0];
							
							Если пСтрокаДокументаПоступления.КоличествоУпаковок = СтрокаСДанными.КоличествоУпаковок Тогда
								
								пТребуетсяПересчетЦены = Ложь;	
								
								НоваяСтрока.Сумма 		= пСтрокаДокументаПоступления.Сумма;
								НоваяСтрока.СуммаНДС	= пСтрокаДокументаПоступления.СуммаНДС;
								НоваяСтрока.СуммаСНДС	= пСтрокаДокументаПоступления.СуммаСНДС;
								
							КонецЕсли;
							
							Если пТребуетсяПересчетЦены Тогда  
								
								пНоваяСтрока = ДокументыПриобретения.Добавить();
								ЗаполнитьЗначенияСвойств(пНоваяСтрока, пСтрокаДокументаПоступления);
								
								пНоваяСтрока.Регистратор			= Регистратор;
								пНоваяСтрока.ИдентификаторСтроки	= СтрокаСДанными.ИдентификаторСтроки;
								пНоваяСтрока.Сумма 					= СтрокаСДанными.Сумма;
								пНоваяСтрока.СуммаБаза				= пСтрокаДокументаПоступления.Сумма;
								пНоваяСтрока.СуммаНДС				= СтрокаСДанными.СуммаНДС;
								пНоваяСтрока.СуммаНДСБаза			= пСтрокаДокументаПоступления.СуммаНДС;
								пНоваяСтрока.СуммаСНДС				= СтрокаСДанными.СуммаСНДС;
								пНоваяСтрока.СуммаСНДСБаза			= пСтрокаДокументаПоступления.СуммаСНДС;
								пНоваяСтрока.КоличествоУпаковок		= СтрокаСДанными.КоличествоУпаковок;
								пНоваяСтрока.КоличествоУпаковокБаза	= пСтрокаДокументаПоступления.КоличествоУпаковок;
								
							КонецЕсли;
							
						КонецЕсли;
												
					КонецЕсли;
					
					Если пТребуетсяПересчетЦены Тогда 
						// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
						//ОбработкаТабличнойЧастиВызовСервера.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
						ПакетнаяОбработкаТабличнойЧастиВызовСервера.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
						// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
					КонецЕсли;
					// КОНЕЦ Майдан Василий 27.06.2023 Выполнение задач №000045968
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Пропускается дозаполнение документа если он не обеспечен полностью.
			Если ДокументНеОбработан Тогда				
				//Очищается ДокументПоступления, 
				// чтобы определить его необходимость заполнения на следующем шаге загрузки из УПП
				ДокументыПриобретенийОчищены = Ложь;
				
				Для Каждого Стр Из ТЧТовары Цикл
					Если ЗначениеЗаполнено(Стр.ДокументПоступления) Тогда
						Стр.ДокументПоступления = Неопределено;
						ДокументыПриобретенийОчищены = Истина;	
					КонецЕсли;
				КонецЦикла;
				
				Если ДокументыПриобретенийОчищены Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
				Продолжить;
				
			КонецЕсли;
			
			//удаляем незаполненные строки
			Если СтрокаСДанными <> Неопределено Тогда
				Для Каждого ЭлементМассива из МассивСтрок Цикл
					ТЧТовары.Удалить(ЭлементМассива);
				КонецЦикла;
			КонецЕсли;
			
			Если ТЧТовары.Количество() Тогда
				Если ЗначениеЗаполнено(ТЧТовары[0].ДокументПоступления) Тогда
					ДокументОбъект.Контрагент = ТЧТовары[0].ДокументПоступления.Контрагент;
					ДокументОбъект.Договор = ТЧТовары[0].ДокументПоступления.Договор;
				КонецЕсли;
			КонецЕсли;	
			
			// Установка грузополучателя
			Если ТЧТовары.Количество() Тогда
				Если ЗначениеЗаполнено(ТЧТовары[0].ДокументПоступления) Тогда
					ДокументОбъект.Грузополучатель = ТЧТовары[0].ДокументПоступления.Грузоотправитель;
					КонтрагентНашеПредприятие = Справочники.Контрагенты.НайтиПоРеквизиту("Партнер", Справочники.Партнеры.НашеПредприятие);
					Если ЗначениеЗаполнено(КонтрагентНашеПредприятие) 
						И Не ЗначениеЗаполнено(ДокументОбъект.Грузоотправитель) Тогда
						ДокументОбъект.Грузоотправитель = КонтрагентНашеПредприятие;
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли;	
			
			СуммаТоваров = ДокументОбъект.Товары.Итог("СуммаСНДС");
			ФинансыКлиентСервер.ПересчитатьСуммыВСтрокеРасшифровкиПлатежа(ДокументОбъект, СуммаТоваров);
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначения.СообщитьПользователю("Обработан документ " + Строка(Регистратор), Регистратор);
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
			
			НоваяСтрока = ОбработанныеДокументы.Добавить();
			НоваяСтрока.Документ = Регистратор;

		Исключение
			// НАЧАЛО Майдан Василий 17.07.2023 Выполнение задач №000045968
			пОтказ = Истина;
			// КОНЕЦ Майдан Василий 17.07.2023 Выполнение задач №000045968
			
			ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка(Регистратор) + " по причине " + ОписаниеОшибки(), Регистратор);
			КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
			НоваяСтрока					 = НеобработанныеДокументы.Добавить();									
			НоваяСтрока.Документ		 = Регистратор; 
			НоваяСтрока.НомерСтроки		 = КоличествоНеОбработанныхДокументов;
		КонецПопытки;
		
	КонецЦикла;
	
	//Разделение документов попавших в список "ОбработанныеДокументы" 
    // НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	//РазделитьДокументыПоДоговорамПартий();
    // КОНЕЦ Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	
	// НАЧАЛО Майдан Василий 17.07.2023 Выполнение задач №000045968
	Если НЕ пОтказ Тогда
		
		ДокументыПриобретения.Сортировать("АналитикаУчетаНоменклатуры, КоличествоУпаковок, Сумма");
		
		ТаблицаНоменклатурыДляКорректировки = ДокументыПриобретения.Скопировать(, "АналитикаУчетаНоменклатуры");
		ТаблицаНоменклатурыДляКорректировки.Свернуть("АналитикаУчетаНоменклатуры");
		
		ДокументыПриобретенияПоСуммам = ДокументыПриобретения.Скопировать(, "АналитикаУчетаНоменклатуры, Сумма, СуммаНДС, СуммаСНДС");
		ДокументыПриобретенияПоСуммам.Свернуть("АналитикаУчетаНоменклатуры", "Сумма, СуммаНДС, СуммаСНДС");
		
		Для каждого ТекАналитика Из ТаблицаНоменклатурыДляКорректировки Цикл
			
			пПараметрыОтбора = Новый Структура;
			пПараметрыОтбора.Вставить("АналитикаУчетаНоменклатуры", ТекАналитика.АналитикаУчетаНоменклатуры);	
			
			пМассивСтрокПоДокументамПриобретения = ДокументыПриобретения.НайтиСтроки(пПараметрыОтбора);
			
			СуммаБаза 	= пМассивСтрокПоДокументамПриобретения[0].СуммаБаза;
			Сумма		= СуммаБаза - ДокументыПриобретенияПоСуммам.НайтиСтроки(пПараметрыОтбора)[0].Сумма;
			
			РаспределитьСуммыПоБазе(Сумма, СуммаБаза, пМассивСтрокПоДокументамПриобретения, "Сумма");
			
			СуммаНДСБаза  	= пМассивСтрокПоДокументамПриобретения[0].СуммаНДСБаза;
			СуммаНДС    	= СуммаНДСБаза - ДокументыПриобретенияПоСуммам.НайтиСтроки(пПараметрыОтбора)[0].СуммаНДС; 
			
			РаспределитьСуммыПоБазе(СуммаНДС, СуммаНДСБаза, пМассивСтрокПоДокументамПриобретения, "СуммаНДС"); 
			
			СуммаСНДСБаза  	= пМассивСтрокПоДокументамПриобретения[0].СуммаСНДСБаза;
			СуммаСНДС    	= СуммаСНДСБаза - ДокументыПриобретенияПоСуммам.НайтиСтроки(пПараметрыОтбора)[0].СуммаСНДС; 
			
			РаспределитьСуммыПоБазе(СуммаСНДС, СуммаСНДСБаза, пМассивСтрокПоДокументамПриобретения, "СуммаСНДС");
			
		КонецЦикла;
		
		ТаблицаРегистраторы = ДокументыПриобретения.Скопировать(, "Регистратор");
		ТаблицаРегистраторы.Свернуть("Регистратор");
		
		Для каждого ТекРегистратор Из ТаблицаРегистраторы Цикл
			
			Попытка
				
				пЕстьИзмененияВТЧ 	= Ложь;
				
				ДокументОбъект	 	= ТекРегистратор.Регистратор.ПолучитьОбъект();			
				ТЧТовары		 	= ДокументОбъект.Товары; 
				
				пПараметрыОтбора 	= Новый Структура;
				пПараметрыОтбора.Вставить("Регистратор", ТекРегистратор.Регистратор); 
				
				пМассивСтрокПоРегистраторам = ДокументыПриобретения.НайтиСтроки(пПараметрыОтбора);
								
				Для каждого ТекСтрока Из пМассивСтрокПоРегистраторам Цикл
					
					СтрокаТЧТовары = ТЧТовары.Найти(ТекСтрока.ИдентификаторСтроки, "ИдентификаторСтроки"); 
					
					Если СтрокаТЧТовары.Сумма = ТекСтрока.Сумма 
						И СтрокаТЧТовары.СуммаНДС = ТекСтрока.СуммаНДС
						И СтрокаТЧТовары.СуммаСНДС = ТекСтрока.СуммаСНДС Тогда
						
						Продолжить;
						
					КонецЕсли;
					
					пЕстьИзмененияВТЧ			= Истина;
					
					СтрокаТЧТовары.Сумма 		= ТекСтрока.Сумма;
					СтрокаТЧТовары.СуммаНДС		= ТекСтрока.СуммаНДС;
					СтрокаТЧТовары.СуммаСНДС	= ТекСтрока.СуммаСНДС;
					
				КонецЦикла;
				
				Если пЕстьИзмененияВТЧ Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
			Исключение
				
				ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка(Регистратор) + " по причине " + ОписаниеОшибки(), Регистратор);
				КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
				НоваяСтрока					 = НеобработанныеДокументы.Добавить();									
				НоваяСтрока.Документ		 = Регистратор; 
				НоваяСтрока.НомерСтроки		 = КоличествоНеОбработанныхДокументов;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	// КОНЕЦ Майдан Василий 17.07.2023 Выполнение задач №000045968
	
	ОбщегоНазначения.СообщитьПользователю("Обработано документов: " + Строка(КоличествоОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Не обработано документов " + Строка(КоличествоНеОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Выполнение обработки закончено: "+Строка(ТекущаяДатаСеанса()));

КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура РазделитьДокументыПоДоговорамПартий()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВозвратТоваровПоставщику.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втВсеРегистраторы
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК ВозвратТоваровПоставщику
	|ГДЕ
	|	ВозвратТоваровПоставщику.Ссылка В(&ОбработанныеДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	втВсеРегистраторы.Ссылка КАК Ссылка,
	|	ВозвратТоваровПоставщикуТовары.ДокументПоступления.Договор КАК Договор,
	|	ВозвратТоваровПоставщикуТовары.НомерСтроки КАК НомерСтроки,
	|	ВозвратТоваровПоставщикуТовары.НоменклатураПартнера КАК НоменклатураПартнера,
	|	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	ВозвратТоваровПоставщикуТовары.Характеристика КАК Характеристика,
	|	ВозвратТоваровПоставщикуТовары.Назначение КАК Назначение,
	|	ВозвратТоваровПоставщикуТовары.Упаковка КАК Упаковка,
	|	ВозвратТоваровПоставщикуТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВозвратТоваровПоставщикуТовары.Количество КАК Количество,
	|	ВозвратТоваровПоставщикуТовары.Цена КАК Цена,
	|	ВозвратТоваровПоставщикуТовары.Сумма КАК Сумма,
	|	ВозвратТоваровПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
	|	ВозвратТоваровПоставщикуТовары.СуммаНДС КАК СуммаНДС,
	|	ВозвратТоваровПоставщикуТовары.СуммаСНДС КАК СуммаСНДС,
	|	ВозвратТоваровПоставщикуТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	ВозвратТоваровПоставщикуТовары.ДокументПоступления КАК ДокументПоступления,
	|	ВозвратТоваровПоставщикуТовары.Серия КАК Серия,
	|	ВозвратТоваровПоставщикуТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ВозвратТоваровПоставщикуТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВозвратТоваровПоставщикуТовары.Ссылка.Подразделение КАК Подразделение
	|ИЗ
	|	втВсеРегистраторы КАК втВсеРегистраторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
	|		ПО втВсеРегистраторы.Ссылка = ВозвратТоваровПоставщикуТовары.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка,
	|	Договор";
	
	Запрос.УстановитьПараметр("ОбработанныеДокументы", ОбработанныеДокументы.Выгрузить().ВыгрузитьКолонку("Документ"));
	
	ДеревоРезультатовЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаРегистратор  Из ДеревоРезультатовЗапроса.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаРегистратор.Ссылка.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаРегистратор.Строки.Количество() > 1 Тогда
			Попытка
				НачатьТранзакцию();
				ПостфиксДляНомераПретензии = 1;
				Для Каждого СтрокаДоговорКонтрагента  Из СтрокаРегистратор.Строки Цикл
					Если НЕ ЗначениеЗаполнено(СтрокаДоговорКонтрагента.Договор) Тогда
						Прервать;
					КонецЕсли;
					Если СтрокаРегистратор.Строки.Индекс(СтрокаДоговорКонтрагента) = 0 Тогда
						РегистраторВозвратТоваровПоставщику = СтрокаРегистратор.Ссылка.ПолучитьОбъект();
						РегистраторВозвратТоваровПоставщику.Товары.Очистить();
						СозданНовыйДокумент =  Ложь;
					Иначе
						СозданНовыйДокумент =  Истина;
						РегистраторВозвратТоваровПоставщику = Документы.ВозвратТоваровПоставщику.СоздатьДокумент();
						ЗаполнитьЗначенияСвойств(РегистраторВозвратТоваровПоставщику, СтрокаРегистратор.Ссылка);
						РегистраторВозвратТоваровПоставщику.Комментарий = "Создан автоматически в результате деления по договору партии поступления. На основе документа: "+Строка(СтрокаРегистратор.Ссылка);
						РегистраторВозвратТоваровПоставщику.Номер = "";
						Если ЗначениеЗаполнено(РегистраторВозвратТоваровПоставщику.тн_НомерПретензии) Тогда
