				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
				
				ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка(ДокументВозврата), ДокументВозврата);
				КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
				НоваяСтрока = НеобработанныеДокументы.Добавить();									
				НоваяСтрока.Документ = ДокументВозврата;
				НоваяСтрока.НомерСтроки = КоличествоНеОбработанныхДокументов;
				Прервать;
			КонецПопытки;
			
			ПостфиксДляНомераПретензии = ПостфиксДляНомераПретензии + 1;
			
		КонецЦикла;
		
		Если ДокументКПТУПроведен Тогда
			ОбщегоНазначения.СообщитьПользователю("Обработан документ " + Строка(ДокументВозврата), ДокументВозврата);
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
			СписокОбработанныхВозвратов.Добавить(ДокументВозврата);
		КонецЕсли;
				
	КонецЦикла;
	
	УдалитьОбработанныеВозвраты(СписокОбработанныхВозвратов);
	
	ОбщегоНазначения.СообщитьПользователю("Обработано документов: " + Строка(КоличествоОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Не обработано документов: " + Строка(КоличествоНеОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Выполнение обработки закончено: " + Строка(ТекущаяДатаСеанса()));
	
КонецПроцедуры

// Борисенко Игорь 11.01.2023 Выполнение задач №000043931
&НаСервере
Процедура СозданиеВозвратовПоставщикам() 

	// НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	//ДатаНачалаВеденияУчета = Константы.ДатаНачалаВеденияРеглУчета.Получить(); 
	ДатаНачалаВеденияУчета = Константы.тн_ДатаНачалаВеденияУчета.Получить(); 
	 // КОНЕЦ Шабалкина Елена 22.03.2023 Выполнение задач №000044881 

	КоличествоОбработанныхДокументов = 0;
	КоличествоНеОбработанныхДокументов = 0;
	СписокОбработанныхВозвратов = Новый Массив;
	СписокОбработанныхВозвратов.Очистить();

	РезультатПоРегистраторам = ПолучитьВыборкуДляСозданияКорректировок();
	
	Пока РезультатПоРегистраторам.Следующий() Цикл
		
		ДокументВозврата = РезультатПоРегистраторам.ДокументВозврата;	
		
		Результат = РезультатПоРегистраторам.Выбрать();
		
		ПостфиксДляНомераПретензии = 1;
		
		Пока Результат.Следующий() Цикл
			
			ДокументВозвратаПроведен = Ложь;	
			
			ДокументПТУ = Результат.ДокументПриобретения;
			Если Не ЗначениеЗаполнено(ДокументПТУ) Тогда
				Продолжить;
			КонецЕсли;
			
			//Проверка на заполнение вида запасов в ТЧ "Товары" и на флажок "Проведен"
			ЗаписатьПТУ = Ложь; 
			ОбъектПТУ = ДокументПТУ.ПолучитьОбъект();
			Для каждого строкаТЧ из ОбъектПТУ.Товары Цикл 
				Если НЕ ЗначениеЗаполнено(строкаТЧ.ВидЗапасов) Тогда 
					строкаТЧ.ВидЗапасов = ПолучитьВидЗапасов(ДокументПТУ.Организация);
					ЗаписатьПТУ = Истина;
				КонецЕсли;	
			КонецЦикла;
			Если (НЕ ОбъектПТУ.Проведен) И (ОбъектПТУ.Дата < ДатаНачалаВеденияУчета)  Тогда 
				ОбъектПТУ.Проведен = Истина; 
			    //НАЧАЛО Шабалкина Е.В. 26.01.2023 Выполнение задач №000044121 
			    ЗаписатьПТУ = Истина;
		        //КОНЕЦ Шабалкина Е.В. 26.01.2023 Выполнение задач №000044121
			КонецЕсли;	
			Если ЗаписатьПТУ Тогда  
				Попытка
					ОбъектПТУ.ОбменДанными.Загрузка = Истина;	
					ОбъектПТУ.Записать(РежимЗаписиДокумента.Запись);	
				Исключение
					ОбщегоНазначения.СообщитьПользователю("Не удалось записать ПТиУ (с флажком ""Проведен"" или с заполнением Вида запаса) " + ДокументПТУ+" "+ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;	
			
			//Создание ВозвратаПоставщику
			НовыйДокументВозврата = Документы.ВозвратТоваровПоставщику.СоздатьДокумент();
			НовыйДокументВозврата.Заполнить(ДокументПТУ);
			ЗаполнитьЗначенияСвойств(НовыйДокументВозврата,ДокументПТУ,"Организация,Партнер,Контрагент,Соглашение,Подразделение,Валюта,Склад,СуммаДокумента,ЦенаВключаетНДС,Менеджер,
			|НалогообложениеНДС,БанковскийСчетОрганизации,БанковскийСчетКонтрагента,Сделка,Договор,ГруппаФинансовогоУчета,НаправлениеДеятельности,ОплатаВВалюте");
			НовыйДокументВозврата.ДокументПоступления = ДокументПТУ;
			НовыйДокументВозврата.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровПоставщику;
			НовыйДокументВозврата.тн_ПередаватьКакКорректировку = Истина;
						
			ДокументОснование = ПолучитьПоследнийКорректирующийДокумент(ДокументПТУ);			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаПриобретения") И ДокументВозврата.Дата <= ДокументОснование.Дата Тогда	
				НоваяДата = ДокументОснование.Дата + 1;
				НовыйДокументВозврата.Дата = ?(НачалоДня(ДокументОснование.Дата) =  НачалоДня(НоваяДата), НоваяДата, ДокументОснование.Дата);
			Иначе	
				НовыйДокументВозврата.Дата = ДокументВозврата.Дата;
			КонецЕсли;
			НовыйДокументВозврата.Грузоотправитель = ДокументВозврата.Грузоотправитель;
			НовыйДокументВозврата.Грузополучатель  = ДокументВозврата.Грузополучатель;
			НовыйДокументВозврата.тн_УпрУчетНДС = НовыйДокументВозврата.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			ВозвратКоличество = Результат.Количество;
			Для Каждого СтрокаТовары Из НовыйДокументВозврата.Товары Цикл
				Если СтрокаТовары.Номенклатура = Результат.Номенклатура Тогда
					//Если возращаем больше, чем в строке, тогда надо переносить остаток на другую строку...					
					Если СтрокаТовары.Количество < ВозвратКоличество Тогда 						
						
						ВозвратКоличество = ВозвратКоличество - СтрокаТовары.Количество;
						СтрокаТовары.Количество = 0;
						
					Иначе
						
						СтрокаТовары.Количество = СтрокаТовары.Количество - ВозвратКоличество;
						ВозвратКоличество = 0;
						
					КонецЕсли; 
					
					// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
					//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокументВозврата);
					СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокументВозврата);
					// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
					СтруктураДействий = Новый Структура;
					СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");					
					СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
                    СтруктураДействий.Вставить("ПересчитатьСумму", "КоличествоУпаковок");					
					СтруктураДействий.Вставить("ПересчитатьЦенуПоСумме", "КоличествоУпаковок");
					СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
					
					// НАЧАЛО Николаев Павел 30.06.2025 Выполнение задач №000054247
					//ОбработкаТабличнойЧастиВызовСервера.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
					ПакетнаяОбработкаТабличнойЧастиВызовСервера.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
					// КОНЕЦ Николаев Павел 30.06.2025 Выполнение задач №000054247
				КонецЕсли;
			КонецЦикла;
			
			НовыйДокументВозврата.тн_Филиал = ДокументВозврата.тн_Филиал;						
			Если ЗначениеЗаполнено(ДокументВозврата.тн_НомерПретензии) Тогда
				НовыйДокументВозврата.тн_НомерПретензии = ДокументВозврата.тн_НомерПретензии + "/" + ПостфиксДляНомераПретензии;
			КонецЕсли;			
			НовыйДокументВозврата.тн_ДатаПретензии 				= ДокументВозврата.тн_ДатаПретензии;
			НовыйДокументВозврата.тн_ПричинаПретензии 			= ДокументВозврата.тн_ПричинаПретензии;
			НовыйДокументВозврата.тн_ЗаключениеКомиссии 		= ДокументВозврата.тн_ЗаключениеКомиссии;
			НовыйДокументВозврата.тн_РасчетныйСчет 				= ДокументВозврата.тн_РасчетныйСчет;
			НовыйДокументВозврата.тн_ПодразделениеОрганизации 	= ДокументВозврата.тн_ПодразделениеОрганизации;
			
			//НовыйДокументВозврата.НомерВходящегоДокумента = ДокументПТУ.НомерВходящегоДокумента;
			//НовыйДокументВозврата.ДатаВходящегоДокумента  = ДокументПТУ.ДатаВходящегоДокумента;
			
			НовыйДокументВозврата.Комментарий = "Документ создан обработкой ""Заполнение документа партии в возвратах товаров поставщику"" на основании: " + ДокументВозврата;
			
			ЗаписьСоответствия = РегистрыСведений.тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.СоздатьНаборЗаписей();
			ЗаписьСоответствия.Отбор.ДокументВозврата.Значение = ДокументВозврата;
			ЗаписьСоответствия.Отбор.ДокументВозврата.Использование = Истина;
			ЗаписьСоответствия.Отбор.ДокументПриобретения.Значение = ДокументПТУ;
			ЗаписьСоответствия.Отбор.ДокументПриобретения.Использование = Истина;
			ЗаписьСоответствия.Отбор.Номенклатура.Значение = Результат.АналитикаУчетаНоменклатуры.Номенклатура;
			ЗаписьСоответствия.Отбор.Номенклатура.Использование = Истина;
			ЗаписьСоответствия.Очистить();
			
			Если НовыйДокументВозврата.Товары.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоТоваров = НовыйДокументВозврата.Товары.Количество();
			Пока КоличествоТоваров > 0 Цикл
				Строка = НовыйДокументВозврата.Товары[КоличествоТоваров - 1];
				Если Строка.Количество = 0 Тогда
					НовыйДокументВозврата.Товары.Удалить(Строка);	
				КонецЕсли;
				КоличествоТоваров = КоличествоТоваров - 1;
			КонецЦикла;

									
			Попытка
				НачатьТранзакцию();
				НовыйДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);
				
				//Создание СФ
				СтруктураЗаполненияСФ = Новый Структура;
				СтруктураЗаполненияСФ.Вставить("ДокументОснование", НовыйДокументВозврата.Ссылка);
				СтруктураЗаполненияСФ.Вставить("Корректировочный", Истина);
				
				ПараметрыРегистрации = Документы.ПриобретениеТоваровУслуг.ПараметрыРегистрацииСчетовФактурПолученных(ДокументПТУ);
				СчетаФактурыПолученныеНаОсновании = УчетНДСУП.СчетаФактурыПолученныеНаОсновании(ПараметрыРегистрации);					
				СФПриобретения = Неопределено;
				Если СчетаФактурыПолученныеНаОсновании.СчетаФактуры.Количество() > 0 Тогда
					СФПриобретения = СчетаФактурыПолученныеНаОсновании.СчетаФактуры[0];
					СтруктураЗаполненияСФ.Вставить("СчетФактураОснование", СФПриобретения);
				КонецЕсли;  				
				НовыйДокументСчетФактураПолученный = Документы.СчетФактураПолученный.СоздатьДокумент();
				НовыйДокументСчетФактураПолученный.Заполнить(СтруктураЗаполненияСФ);
				НовыйДокументСчетФактураПолученный.ПолученВЭлектронномВиде = Ложь;
				НовыйДокументСчетФактураПолученный.Дата = НовыйДокументВозврата.Дата;
				НовыйДокументСчетФактураПолученный.ДатаЗаписиКнигиПродаж = НовыйДокументСчетФактураПолученный.Дата;
				НовыйДокументСчетФактураПолученный.ДатаСоставления = НовыйДокументСчетФактураПолученный.Дата;
				НовыйДокументСчетФактураПолученный.Номер = ПостфиксДляНомераПретензии;
				НовыйДокументСчетФактураПолученный.Корректировочный = Истина;					
				//Запись СФ в транзакции 
				НовыйДокументСчетФактураПолученный.Записать(РежимЗаписиДокумента.Запись);
				НоваяЗапись = ЗаписьСоответствия.Добавить();
				НоваяЗапись.Номенклатура = Результат.Номенклатура;
				НоваяЗапись.ДокументВозврата = ДокументВозврата;
				НоваяЗапись.ДокументПриобретения = ДокументПТУ;
				НоваяЗапись.КорректировкаПриобретения = НовыйДокументВозврата.Ссылка;
				НоваяЗапись.СчетФактура = НовыйДокументСчетФактураПолученный.Ссылка;
				//Запись РС в транзакции
				ЗаписьСоответствия.Записать();
				
				ЗафиксироватьТранзакцию();
				
				ДокументВозвратаПроведен = Истина;
				
				ОбщегоНазначения.СообщитьПользователю("Создан документ " + Строка(НовыйДокументВозврата), НовыйДокументВозврата.Ссылка);
				ОбщегоНазначения.СообщитьПользователю("Создан документ " + Строка(НовыйДокументСчетФактураПолученный), НовыйДокументСчетФактураПолученный.Ссылка);
				
			Исключение
				ОтменитьТранзакцию();
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
				
				ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка(ДокументВозврата), ДокументВозврата);
				КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
				НоваяСтрока = НеобработанныеДокументы.Добавить();									
				НоваяСтрока.Документ = ДокументВозврата;
				НоваяСтрока.НомерСтроки = КоличествоНеОбработанныхДокументов;
				Прервать;
			КонецПопытки;
			
			ПостфиксДляНомераПретензии = ПостфиксДляНомераПретензии + 1;
			
		КонецЦикла;
		
		Если ДокументВозвратаПроведен Тогда
			ОбщегоНазначения.СообщитьПользователю("Обработан документ " + Строка(ДокументВозврата), ДокументВозврата);
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
			СписокОбработанныхВозвратов.Добавить(ДокументВозврата);
		КонецЕсли;
				
	КонецЦикла;
	
	УдалитьОбработанныеВозвраты(СписокОбработанныхВозвратов);
	
	ОбщегоНазначения.СообщитьПользователю("Обработано документов: " + Строка(КоличествоОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Не обработано документов: " + Строка(КоличествоНеОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Выполнение обработки закончено: " + Строка(ТекущаяДатаСеанса()));
	
КонецПроцедуры

// Шабалкина Елена 11.01.2023 Выполнение задач  №000043931	
Процедура СозданиеВозвратовПоставщикам_ПоДокументамПоступления() 
	 // НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211
	//ДатаНачалаВеденияУчета = Константы.ДатаНачалаВеденияРеглУчета.Получить(); 
	ДатаНачалаВеденияУчета = Константы.тн_ДатаНачалаВеденияУчета.Получить(); 
	 // КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
	КоличествоОбработанныхДокументов = 0;
	КоличествоНеОбработанныхДокументов = 0; 
	КоличествоСозданныхДокументов = 0;
	СписокОбработанныхВозвратов = Новый Массив;
	СписокОбработанныхВозвратов.Очистить();
	РезультатПоДокументамПриобретения = ПолучитьВыборкуДляСозданияКорректировок();
	
    // НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
   	ТабПостфикс = Новый ТаблицаЗначений;
