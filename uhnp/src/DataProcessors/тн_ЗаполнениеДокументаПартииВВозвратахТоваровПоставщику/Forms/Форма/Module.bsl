&НаСервере
Функция ПолучитьПоследнийКорректирующийДокумент(ДокументПТУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументПТУ", ДокументПТУ);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КорректировкаПриобретения.Ссылка КАК ДокументКПТУ
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК КорректировкаПриобретения
	|ГДЕ
	|	КорректировкаПриобретения.ДокументОснование = &ДокументПТУ
	|	И КорректировкаПриобретения.ВидКорректировки = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.КорректировкаПоСогласованиюСТОРОН)
	|	И КорректировкаПриобретения.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаПриобретения.Дата УБЫВ";
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ДокументКПТУ;
	Иначе
		Возврат ДокументПТУ;
	КонецЕсли;
	
КонецФункции

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура ЗаписатьРегистрРедактированияДокументов(Документ, НоваяЗапись_Флаг = Истина)  
	
	НаборЗаписей = РегистрыСведений.тн_СписокРедактированияДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Значение = Документ.Ссылка;
	НаборЗаписей.Отбор.Документ.Использование = Истина;
	НаборЗаписей.Очистить();
	
	Если НоваяЗапись_Флаг Тогда
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Документ = Документ.Ссылка;
		НоваяЗапись.ЗапретРедактирования = Истина;
		НоваяЗапись.ДокументИнициатор = Ложь;
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

