// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура УдалитьСФПолученныеНаОснованииВозврата(ДокументВозврата)
	
	Попытка		
		ПараметрыРегистрации = Документы.ВозвратТоваровПоставщику.ПараметрыРегистрацииСчетовФактурВыданных(ДокументВозврата);
		СчетаФактурыВыданныеНаОсновании = УчетНДСУП.СчетаФактурыВыданныеНаОсновании(ПараметрыРегистрации);
		ПараметрыРегистрации = Документы.ВозвратТоваровПоставщику.ПараметрыРегистрацииСчетовФактурПолученных(ДокументВозврата);
		СчетаФактурыПолученныеНаОсновании = УчетНДСУП.СчетаФактурыПолученныеНаОсновании(ПараметрыРегистрации);
		
		Если СчетаФактурыВыданныеНаОсновании.СчетаФактуры.Количество() > 0 
			И СчетаФактурыПолученныеНаОсновании.СчетаФактуры.Количество() > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("На основании возврата созданы полученные и выданные счета-фактуры: " + ДокументВозврата);
		КонецЕсли;
		
		Для Каждого СФ Из  СчетаФактурыВыданныеНаОсновании.СчетаФактуры Цикл
			СФ_Об = СФ.ПолучитьОбъект();	
			СФ_Об.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
		
		Для Каждого СФ Из  СчетаФактурыПолученныеНаОсновании.СчетаФактуры Цикл
			СФ_Об = СФ.ПолучитьОбъект();	
			СФ_Об.УстановитьПометкуУдаления(Истина);	
		КонецЦикла; 		
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

