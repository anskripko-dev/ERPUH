// Шабалкина Елена 22.03.2023 Выполнение задач №000044881
&НаСервере
Процедура ОчиститьДокументыПоступленияВВозвратахНаСервере()
	//Получение выборки с сопоставленными приобретениями к возвратам
	Запрос = Новый Запрос;
	Запрос.Текст =" 
	|ВЫБРАТЬ
	|Д.Ссылка
	|ИЗ Документ.ВозвратТоваровПоставщику КАК Д
	|ГДЕ 
	|  //Д.Проведен И
	| ВЫБОР
	|    КОГДА &ОтборПоКонтрагентам ТОГДА
	|  Д.Контрагент В (&СписокКонтрагентов)
    | ИНАЧЕ ИСТИНА
	| КОНЕЦ
	| И ВЫБОР
	|    КОГДА &ОтборПоОрганизациям ТОГДА
	|      Д.Организация В (&СписокОрганизаций)
    |    ИНАЧЕ ИСТИНА
	|    КОНЕЦ
	|    И Д.Дата МЕЖДУ &Д1 И &Д2
	| И НЕ Д.тн_ПередаватьКакКорректировку
	|";
	
	Запрос.УстановитьПараметр("ОтборПоКонтрагентам",Контрагенты.Количество()>0); 
	Запрос.УстановитьПараметр("СписокКонтрагентов",Контрагенты.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ОтборПоОрганизациям",Организации.Количество()>0); 
	Запрос.УстановитьПараметр("СписокОрганизаций",Организации.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Д1",Период.ДатаНачала);
	Запрос.УстановитьПараметр("Д2",Период.ДатаОкончания);
	
	Результат  = Запрос.Выполнить().Выбрать();  //Запрос.Выполнить().Выгрузить()
	
	Пока Результат.Следующий() Цикл  
		 ДокументВозврата = Результат.Ссылка.ПолучитьОбъект();
		 ЗаписатьПТУ = Ложь;
		 Для каждого Строка ИЗ ДокументВозврата.Товары Цикл
			 Если ЗначениеЗаполнено(Строка.ДокументПоступления) Тогда
				Строка.ДокументПоступления = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка(); 
				Строка.Цена = 1;
				Строка.Сумма = Строка.Цена*Строка.КоличествоУпаковок;
				ЗаписатьПТУ = Истина;
			 КонецЕсли;	 
		 Конеццикла;
		 Если ЗаписатьПТУ Тогда
			 Попытка  
				 Если ДокументВозврата.Проведен Тогда
					 Попытка
					 ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение); 
				     Исключение 
					 ДокументВозврата.Записать(РежимЗаписиДокумента.Запись); 
					 ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Документ %1 НЕ проведен %2",ДокументВозврата.Ссылка,ОписаниеОшибки()));
                     КонецПопытки;
				 Иначе
				   ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Документ %1 записан в обход ошибок %2",ДокументВозврата.Ссылка,ОписаниеОшибки()));
				   ДокументВозврата.ОбменДанными.Загрузка = Истина; 
				   ДокументВозврата.Записать(РежимЗаписиДокумента.Запись);
			     КонецЕсли;
			 Исключение
			     ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Документ %1 НЕ записан  %2",ДокументВозврата.Ссылка,ОписаниеОшибки()));
			 КонецПопытки;
		КонецЕсли;	 
	КонецЦикла;	
КонецПроцедуры

