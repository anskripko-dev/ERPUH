&НаСервереБезКонтекста
Функция ПолучитьВидЗапасов(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	" ВЫБРАТЬ ПЕРВЫЕ 1
	| С.Ссылка
	| ИЗ Справочник.ВидыЗапасов КАК С
	| ГДЕ С.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Товар)
	| И С.Организация = &Организация
	|";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	Возврат Справочники.ВидыЗапасов.ПустаяСсылка();	
КонецФункции
