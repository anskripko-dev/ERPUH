// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	
	Если РежимРаботы = 0 Тогда
		Элементы.ГруппаВосстановлениеВозвратов.Видимость = Ложь;
		Элементы.ГруппаЗаполнениеВозвратов.Видимость = Истина;
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
	    Элементы.ЦенаИзПриобретения.Видимость = Ложь;
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
    // НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
		Элементы.ФормаОчиститьДокументыПоступленияВВозвратах.Видимость = Истина;  
    // КОНЕЦ Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	// НАЧАЛО Егоров Петр 15.05.2023 Выполнение задач №000045467
	    Элементы.ПередаватьКакКорректировку.Видимость = Ложь;
	// КОНЕЦ  Егоров Петр 15.05.2023 Выполнение задач №000045467
		ИначеЕсли РежимРаботы = 1 Тогда
		Элементы.ГруппаВосстановлениеВозвратов.Видимость = Ложь;
		Элементы.ГруппаЗаполнениеВозвратов.Видимость = Истина;
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
	    Элементы.ЦенаИзПриобретения.Видимость = Истина; 
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211 	
    // НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
		Элементы.ФормаОчиститьДокументыПоступленияВВозвратах.Видимость = Ложь;  
    // КОНЕЦ Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	// НАЧАЛО Егоров Петр 15.05.2023 Выполнение задач №000045467
	    Элементы.ПередаватьКакКорректировку.Видимость = Истина;
	// КОНЕЦ  Егоров Петр 15.05.2023 Выполнение задач №000045467
	ИначеЕсли РежимРаботы = 2 Тогда
		Элементы.ГруппаВосстановлениеВозвратов.Видимость = Истина;
		Элементы.ГруппаЗаполнениеВозвратов.Видимость = Ложь;
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
	    Элементы.ЦенаИзПриобретения.Видимость = Ложь; 
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211	
    // НАЧАЛО Шабалкина Елена 22.03.2023 Выполнение задач №000044881
		Элементы.ФормаОчиститьДокументыПоступленияВВозвратах.Видимость = Ложь;  
    // КОНЕЦ Шабалкина Елена 22.03.2023 Выполнение задач №000044881
	// НАЧАЛО Егоров Петр 15.05.2023 Выполнение задач №000045467
	    Элементы.ПередаватьКакКорректировку.Видимость = Ложь;
	// КОНЕЦ  Егоров Петр 15.05.2023 Выполнение задач №000045467
	 
	КонецЕсли;
	
КонецПроцедуры

