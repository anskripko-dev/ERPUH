					НоваяЗапись.Номенклатура              = стр.Номенклатура;
					НоваяЗапись.ДокументВозврата          = ДокументВозврата;
					НоваяЗапись.ДокументПриобретения      = ДокументПТУ;
					НоваяЗапись.КорректировкаПриобретения = НовыйДокументВозврата.Ссылка;
					//НоваяЗапись.СчетФактура               = НовыйДокументСчетФактураПолученный.Ссылка; 
				КонецЦикла;
				//Запись РС в транзакции
				ЗаписьСоответствия.Записать();
				
				ЗафиксироватьТранзакцию();
				
				ДокументВозвратаПроведен = Истина;
				
				ОбщегоНазначения.СообщитьПользователю("Создан документ " + Строка(НовыйДокументВозврата), НовыйДокументВозврата.Ссылка);
				//ОбщегоНазначения.СообщитьПользователю("Создан документ " + Строка(НовыйДокументСчетФактураПолученный), НовыйДокументСчетФактураПолученный.Ссылка);
				
			Исключение
				ОтменитьТранзакцию();
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
				
				ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка(ДокументВозврата), ДокументВозврата);
				КоличествоНеОбработанныхДокументов = КоличествоНеОбработанныхДокументов + 1;
				НоваяСтрока = НеобработанныеДокументы.Добавить();									
				НоваяСтрока.Документ = ДокументВозврата;
				НоваяСтрока.НомерСтроки = КоличествоНеОбработанныхДокументов;   
				ДокументВозвратаОбъект.Записать(РежимЗаписиДокумента.Проведение);
				//Прервать;
			КонецПопытки;
			
			ПостфиксДляНомераПретензии = ПостфиксДляНомераПретензии + 1;
			
			Если ДокументВозвратаПроведен Тогда
				Если ДокументВозврата<>ТекДокументВозврата Тогда
					Если СписокОбработанныхВозвратов.Найти(ДокументВозврата) = Неопределено Тогда 
					   ОбщегоНазначения.СообщитьПользователю("Обработан документ " + Строка(ДокументВозврата), ДокументВозврата); 
					   КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;	
			           СписокОбработанныхВозвратов.Добавить(ДокументВозврата);
		            КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ТекДокументВозврата = ДокументВозврата;
		КонецЦикла;
		
		Если СписокОбработанныхВозвратов.Найти(ДокументВозврата) = Неопределено Тогда
		    ОбщегоНазначения.СообщитьПользователю("Обработан документ " + Строка(ДокументВозврата), ДокументВозврата); 
			КоличествоОбработанныхДокументов = КоличествоОбработанныхДокументов + 1;
			СписокОбработанныхВозвратов.Добавить(ДокументВозврата);
		КонецЕсли;
	КонецЦикла;
	
	УдалитьОбработанныеВозвраты(СписокОбработанныхВозвратов);
	ОбщегоНазначения.СообщитьПользователю("Обработано документов ""Возврат товаров поставщику"": " + Строка(КоличествоОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Создано новых документов: " + Строка(КоличествоСозданныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Не обработано документов ""Возврат товаров поставщику"": " + Строка(КоличествоНеОбработанныхДокументов));
	ОбщегоНазначения.СообщитьПользователю("Выполнение обработки закончено: " + Строка(ТекущаяДатаСеанса()));
	
КонецПроцедуры


// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура ЗаполнитьСписокВозвратовНаСервере()
	
	СписокВозвратов.Очистить();
	
	Запрос = НОВЫЙ Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.ДокументВозврата КАК Возврат,
	               |	тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.КорректировкаПриобретения КАК Корректировка,
	               |	тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.СчетФактура КАК СчетФактура
	               |ИЗ
	               |	РегистрСведений.тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения КАК тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ОтборПоКонтрагенту
	               |				ТОГДА тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.ДокументВозврата.Контрагент В (&Контрагент)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.ДокументВозврата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоОрганизации
	               |				ТОГДА тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.ДокументВозврата.Организация В (&Организация)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	
	ОтборПоКонтрагенту = ЗначениеЗаполнено(Контрагенты);
	ОтборПоОрганизации = ЗначениеЗаполнено(Организации);
	Запрос.УстановитьПараметр("Контрагент",    Контрагенты.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ОтборПоКонтрагенту);
	Запрос.УстановитьПараметр("Организация",    Организации.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ОтборПоОрганизации);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",  Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = СписокВозвратов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
КонецПроцедуры

// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаСервере
Процедура ВосстановитьВозвраты()
	
	Для Каждого Строка Из СписокВозвратов Цикл
		
		Если Не Строка.Обработать 
			ИЛИ Строка.СтрокаОбработана Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументВозврата         = Строка.Возврат.ПолучитьОбъект();
		ДокументКорректировкиПТУ = Строка.Корректировка.ПолучитьОбъект();
		
		ЗаписьСоответствия = РегистрыСведений.тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения.СоздатьНаборЗаписей();
		ЗаписьСоответствия.Отбор.ДокументВозврата.Значение = ДокументВозврата.Ссылка;
		ЗаписьСоответствия.Отбор.ДокументВозврата.Использование = Истина;
		// НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
	    // НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
		Если ТипЗнч(ДокументКорректировкиПТУ.Ссылка) = ТИП("ДокументСсылка.КорректировкаПриобретения") Тогда 
        // КОНЕЦ Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
		ЗаписьСоответствия.Отбор.ДокументПриобретения.Значение = ДокументКорректировкиПТУ.ДокументОснование;
		// НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
	    ИначеЕсли ТипЗнч(ДокументКорректировкиПТУ.Ссылка) = ТИП("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
            ЗаписьСоответствия.Отбор.ДокументПриобретения.Значение = ДокументКорректировкиПТУ.ДокументПоступления;
		КонецЕсли;	
        // КОНЕЦ Шабалкина Елена 11.01.2023 Выполнение задач №000043931
		ЗаписьСоответствия.Отбор.ДокументПриобретения.Использование = Истина;
		ЗаписьСоответствия.Очистить();
		
		Попытка
			НачатьТранзакцию();
			ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);
			ДокументКорректировкиПТУ.УстановитьПометкуУдаления(Истина);
			ЗаписатьРегистрРедактированияДокументов(ДокументВозврата, Ложь);
			ЗаписьСоответствия.Записать();
			ЗафиксироватьТранзакцию();
			Строка.СтрокаОбработана = Истина;
		Исключение
			ОтменитьТранзакцию(); 
			// НАЧАЛО Шабалкина Елена 10.11.2022 Выполнение задач №000043320 
			//ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка.ДокументВозврата + " по причине " + ОписаниеОшибки(), Строка.ДокументВозврата);
			ОбщегоНазначения.СообщитьПользователю("Не удалось обработать документ " + Строка.Возврат + " по причине " + ОписаниеОшибки(), Строка.Возврат);
			// КОНЕЦ Шабалкина Елена 10.11.2022 Выполнение задач №000043320 
		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры

