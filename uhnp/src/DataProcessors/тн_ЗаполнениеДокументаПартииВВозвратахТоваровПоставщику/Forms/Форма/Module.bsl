&НаСервере
Функция ОтчетПоЦенамНаСервере()

ТабДокумент = Новый ТабличныйДокумент;
Запрос = Новый Запрос;	
Запрос.Текст = 
"ВЫБРАТЬ
  |Рег.Номенклатура,
  |Рег.Номенклатура.Код, 
  |ПЕРВ.Цена                              КАК ЦенаВДокПервичногоВозврата, 
  |ВЫБОР
  | КОГДА ПЕРВ.Ссылка.ЦенаВключаетНДС ТОГДА
  |  ПЕРВ.Цена
  |ИНАЧЕ
  |  ПЕРВ.Цена*Рег.Номенклатура.СтавкаНДС.Ставка  
  |КОНЕЦ     
  |      КАК ЦенаСНДСВДокПервичногоВозврата,
  |ПЕРВ.Ссылка.ЦенаВключаетНДС            КАК ЦенаВклНДСВДокПервичногоВозврата,
  |ПЕРВ.Ссылка                            КАК ДокПервичногоВозврата, 
  |ПТиУ.Цена                              КАК ЦенаВДокПриобретения, 
  |ПТиУ.Ссылка.ЦенаВключаетНДС            КАК ЦенаВклНДСВДокПриобретения, 
  |ПТиУ.Ссылка                            КАК ДокПриобретения, 
  |ВТОРВ.Цена                             КАК ЦенаВДокВторичногоВозврата,
  |ВТОРВ.Ссылка.ЦенаВключаетНДС           КАК ЦенаВклНДСВДокВторичногоВозвр,
  |ВТОРВ.Ссылка                           КАК ДокВторичногоВозврата
  |  ИЗ 
  |     РегистрСведений.тн_СоответствиеВозвратовПоставщикуИКорректировокПриобретения КАК Рег
  |
  | ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары   КАК ПЕРВ
  |     ПО Рег.Номенклатура = ПЕРВ.Номенклатура 
  |      И Рег.ДокументВозврата = ПЕРВ.Ссылка
  |      И НЕ ПЕРВ.Ссылка.тн_ПередаватьКакКорректировку
  |      И ПЕРВ.ДокументПоступления = Рег.ДокументПриобретения 
  |  
  |   ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары   КАК ПТиУ
  |      ПО Рег.Номенклатура = ПТиУ.Номенклатура
  |       И Рег.ДокументПриобретения = ПТиУ.Ссылка
  |
  |    ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары   КАК ВТОРВ
  |     ПО Рег.Номенклатура = ВТОРВ.Номенклатура 
  |       И Рег.КорректировкаПриобретения = ВТОРВ.Ссылка 
  |       И ВТОРВ.ДокументПоступления = ПТиУ.Ссылка
  |       И ВТОРВ.Ссылка.тн_ПередаватьКакКорректировку
  | ГДЕ  
  |  ВЫБОР
  |    КОГДА &ОтборПоКонтрагенту ТОГДА
  |     Рег.ДокументВозврата.Контрагент В (&Контрагенты) 
  |    ИНАЧЕ Истина
  |  КОНЕЦ 
  |  И ВЫБОР
  |    КОГДА &ОтборПоОрганизации ТОГДА
  |     Рег.ДокументВозврата.Организация В (&Организации)  
  |    ИНАЧЕ Истина
  |  КОНЕЦ
  |  И Рег.ДокументВозврата.Дата МЕЖДУ &Д1 И &Д2
  |";

   Запрос.УстановитьПараметр("ОтборПоКонтрагенту",Контрагенты.Количество()>0);
   Запрос.УстановитьПараметр("Контрагенты",Контрагенты.ВыгрузитьЗначения());
   Запрос.УстановитьПараметр("ОтборПоОрганизации",Организации.Количество()>0);
   Запрос.УстановитьПараметр("Организации",Организации.ВыгрузитьЗначения());
   Запрос.УстановитьПараметр("Д1",Период.ДатаНачала);
   Запрос.УстановитьПараметр("Д2",Период.ДатаОкончания);
   
   ТЗ = Запрос.Выполнить().Выгрузить();
   
   Построитель = Новый ПостроительОтчета;
   Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТЗ);
   Построитель.Вывести(ТабДокумент);
   ТабДокумент.Защита = Истина;
   ТабДокумент.ОтображатьСетку = Ложь;
   ТабДокумент.ОтображатьЗаголовки = Ложь; 
   Возврат ТабДокумент;
КонецФункции

