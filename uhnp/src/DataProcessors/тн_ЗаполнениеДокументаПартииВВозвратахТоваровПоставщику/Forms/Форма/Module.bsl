
// Хоменко Вадим 08.09.2021 Выполнение задач №000038969
&НаКлиенте
Процедура ОбработатьДокументы(Команда)
	
	НеобработанныеДокументы.Очистить();
	ОбработанныеДокументы.Очистить();
	// НАЧАЛО Егоров Петр 15.05.2023 Выполнение задач №000045467
	СозданныеВторичныеВозвраты.Очистить();   
	// КОНЕЦ  Егоров Петр 15.05.2023 Выполнение задач №000045467

	Если РежимРаботы = 0 Тогда
		//Заполнение возвратов		
		ЗаполнитьПартииВДокументахВозврата();		
	ИначеЕсли РежимРаботы = 1 Тогда
		//Создание корректировок поступления
		//Создание корректировок поступления
        // НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
		//СозданиеКорректировокПоступления();
		СозданиеВозвратовПоставщикам_ПоДокументамПоступления();
        // КОНЕЦ  Шабалкина Елена 11.01.2023 Выполнение задач №000043931
	ИначеЕсли РежимРаботы = 2 Тогда
		//Восстановление возвратов
		ВосстановитьВозвраты();
	КонецЕсли;
	
КонецПроцедуры


