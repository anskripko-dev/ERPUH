	ТаблицаРаспределения.Колонки.Добавить("КоличествоПартии", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));	
	ТаблицаРаспределения.Колонки.Добавить("КоличествоВозврата", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));	
	ТаблицаРаспределения.Колонки.Добавить("КоличествоПоДокументу", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));	
	ТаблицаРаспределения.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));	
	ТаблицаРаспределения.Колонки.Добавить("НомерВходящегоДокумента", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30)));	
	ТаблицаРаспределения.Колонки.Добавить("ДатаВходящегоДокумента", Новый ОписаниеТипов("Дата"));	
	ТаблицаРаспределения.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
	//НАЧАЛО Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320
	//ТаблицаРаспределения.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаРаспределения.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	//КОНЕЦ Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320
	ТаблицаРаспределения.Колонки.Добавить("ПартияЦенаВключаетНДС", Новый ОписаниеТипов("Булево"));	
	ТаблицаРаспределения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));	
	ТаблицаРаспределения.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));	
	ТаблицаРаспределения.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));	
	ТаблицаРаспределения.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));	
	ТаблицаРаспределения.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));	
	ТаблицаРаспределения.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.Серииноменклатуры"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляСредней();	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	//НАЧАЛО Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320
	//Запрос.УстановитьПараметр("ПериодПодбораПартийНач", ДобавитьМесяц(Период.ДатаНачала, -36));
	Запрос.УстановитьПараметр("ПериодПодбораПартийНач", ДобавитьМесяц(Период.ДатаНачала, -60));
	//КОНЕЦ Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ОтборПоКонтрагенту);
	Запрос.УстановитьПараметр("Контрагент",Контрагенты.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ОтборПоОрганизации);
	Запрос.УстановитьПараметр("Организация",Организации.ВыгрузитьЗначения());
	//НАЧАЛО Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320 
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211
	//изменение типовой константы даты начала вендения регл учета на специальную, тк типовую передвинули на декабрь изза остатков
    //Запрос.УстановитьПараметр("НачалоРеглУчета", Константы.ДатаНачалаВеденияРеглУчета.Получить());
	  Запрос.УстановитьПараметр("НачалоРеглУчета", Константы.тн_ДатаНачалаВеденияУчета.Получить());
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211
    //КОНЕЦ Шабалкина Е.В. 10.11.2022 Выполнение задач №000043320
	
	//Обработка результатов запроса и формирование таблицы распределения вручную
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаВозвраты = ПакетРезультатов[ПакетРезультатов.ВГраница()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаПартий = ПакетРезультатов[ПакетРезультатов.ВГраница()].Выгрузить();
	
	Пока ВыборкаВозвраты.Следующий() Цикл
		//Доступные поля итога: ДокументВозврата, Сумма(Количество)
		КоличествоПоДокументу = ВыборкаВозвраты.Количество;
		
		Выборка = ВыборкаВозвраты.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтруктураПоиска = Новый Структура("АналитикаУчетаНоменклатуры, Контрагент, Организация");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Выборка);
			
			НайденныеПартии = ТаблицаПартий.НайтиСтроки(СтруктураПоиска);
			МассивСтрокПартийУдалить = Новый Массив;
			ОстатокВозврата = Выборка.Количество;
			Для Каждого СтрокаПартии Из НайденныеПартии Цикл
				//В запросе остаток партий отбирается больше нуля
				//поэтому остаток = 0 контролируется после подбора партии
				Если ОстатокВозврата = 0 Тогда
					Прервать;
				КонецЕсли;
				Если Выборка.День < СтрокаПартии.День Тогда
					Продолжить;
				КонецЕсли;
								
				СтрРаспределения = ТаблицаРаспределения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрРаспределения, СтрокаПартии);
				СтрРаспределения.ДокументВозврата = Выборка.ДокументВозврата;
				СтрРаспределения.Количество = Мин(ОстатокВозврата, СтрокаПартии.Количество);
				СтрРаспределения.КоличествоПартии = СтрРаспределения.Количество;
				СтрРаспределения.КоличествоВозврата = Выборка.Количество;
				СтрРаспределения.КоличествоПоДокументу = КоличествоПоДокументу;
				СтрокаПартии.Количество = СтрокаПартии.Количество - СтрРаспределения.Количество;
				ОстатокВозврата = ОстатокВозврата - СтрРаспределения.Количество;
				
				Если СтрокаПартии.Количество = 0 Тогда
					МассивСтрокПартийУдалить.Добавить(СтрокаПартии);
				КонецЕсли;
			КонецЦикла;
			Если ОстатокВозврата > 0 Тогда
				СтрРаспределения = ТаблицаРаспределения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрРаспределения, Выборка);
				СтрРаспределения.Количество = ОстатокВозврата;
				СтрРаспределения.КоличествоПартии = 0;
				СтрРаспределения.КоличествоВозврата = Выборка.Количество;
				СтрРаспределения.КоличествоПоДокументу = КоличествоПоДокументу;
				ОстатокВозврата = 0;
			КонецЕсли;
			Для Каждого СтрПартииУдалить Из МассивСтрокПартийУдалить Цикл
				ТаблицаПартий.Удалить(СтрПартииУдалить);	
			КонецЦикла;
			
		КонецЦикла;		
	КонецЦикла;	
	
	//Запрос по даным таблицы и вывод в группировке подходящей для обработки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаРаспределения.ДокументПриобретения КАК ДокументПриобретения,
