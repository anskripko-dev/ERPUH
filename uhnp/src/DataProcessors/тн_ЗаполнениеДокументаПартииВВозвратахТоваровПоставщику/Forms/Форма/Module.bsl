&НаСервере
Функция ПолучитьВыборкуДляСозданияКорректировок()
	
	ОтборПоКонтрагенту = ЗначениеЗаполнено(Контрагенты);
	ОтборПоОрганизации = ЗначениеЗаполнено(Организации);
	
	ТаблицаРаспределения = Новый ТаблицаЗначений;
	ТаблицаРаспределения.Колонки.Добавить("ДокументВозврата", Новый ОписаниеТипов("ДокументСсылка.ВозвратТоваровПоставщику"));	
	ТаблицаРаспределения.Колонки.Добавить("ДокументПриобретения", Новый ОписаниеТипов("ДокументСсылка.ПриобретениеТоваровУслуг"));	
	ТаблицаРаспределения.Колонки.Добавить("АналитикаУчетаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиУчетаНоменклатуры"));	
	ТаблицаРаспределения.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));	
	ТаблицаРаспределения.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число" , , , Новый КвалификаторыЧисла(15,3)));		
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляСозданияКорректировок();	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ОтборПоКонтрагенту);
	Запрос.УстановитьПараметр("Контрагент", Контрагенты.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ОтборПоОрганизации);
	Запрос.УстановитьПараметр("Организация", Организации.ВыгрузитьЗначения());
	
	РезультатФункции = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат РезультатФункции;
	
КонецФункции

// Османов Нагим 28.06.2022 Выполнение задач №000041068
&НаСервере
Функция ПолучитьТекстЗапросаДляСозданияКорректировок()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВозвратТоваровПоставщикуТовары.Ссылка КАК ДокументВозврата,
	|	ВозвратТоваровПоставщикуТовары.ДокументПоступления КАК ДокументПриобретения,
	|	ВозвратТоваровПоставщикуТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
    |	ВозвратТоваровПоставщикуТовары.Цена КАК ЦенаВВозврате,
	|	ВозвратТоваровПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
    |   ПТУТовары.Цена Как ЦенаВПриобретении,
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211
	|	ВозвратТоваровПоставщикуТовары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Возвраты
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары 
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
	|   ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК ПТУТовары 
	|   ПО  ВозвратТоваровПоставщикуТовары.ДокументПоступления = ПТУТовары.Ссылка 
	|   И   ВозвратТоваровПоставщикуТовары.АналитикаУчетаНоменклатуры = ПТУТовары.АналитикаУчетаНоменклатуры 
	// КОНЕЦ Шабалкина Елена 01.02.2023 Выполнение задач №000044211
	|ГДЕ
	|	ВозвратТоваровПоставщикуТовары.Ссылка.Проведен
	// НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
	|   И НЕ ВозвратТоваровПоставщикуТовары.Ссылка.тн_ПередаватьКакКорректировку  
    // НАЧАЛО Шабалкина Елена 11.01.2023 Выполнение задач №000043931	
	|	И ВозвратТоваровПоставщикуТовары.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВозвратТоваровПоставщикуТовары.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратТоваровПоставщику)
	|	И ВЫБОР
	|			КОГДА &ОтборПоКонтрагенту
	|				ТОГДА ВозвратТоваровПоставщикуТовары.Ссылка.Контрагент В (&Контрагент)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоОрганизации
	|				ТОГДА ВозвратТоваровПоставщикуТовары.Ссылка.Организация В (&Организация)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Возвраты.ДокументВозврата КАК ДокументВозврата,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ВТ_Возвраты.ДокументПриобретения = ЗНАЧЕНИЕ(Документ.ПриобретениеТоваровУслуг.ПустаяСсылка)
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ПустыеСтроки
	|ПОМЕСТИТЬ ВТ_ПустыеСтрокиВВозвратах
	|ИЗ
	|	ВТ_Возвраты КАК ВТ_Возвраты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Возвраты.ДокументВозврата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПустыеСтрокиВВозвратах.ДокументВозврата КАК ДокументВозврата
	|ПОМЕСТИТЬ ВТ_ВозвратыБезПустыхСтрок
	|ИЗ
	|	ВТ_ПустыеСтрокиВВозвратах КАК ВТ_ПустыеСтрокиВВозвратах
	|ГДЕ
	|	ВТ_ПустыеСтрокиВВозвратах.ПустыеСтроки > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Возвраты.ДокументВозврата КАК ДокументВозврата, 
	|	ВТ_Возвраты.ДокументПриобретения КАК ДокументПриобретения,
	|	ВТ_Возвраты.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ВТ_Возвраты.Номенклатура КАК Номенклатура,
	// НАЧАЛО Шабалкина Елена 01.02.2023 Выполнение задач №000044211 
    |	ВТ_Возвраты.ЦенаВВозврате КАК ЦенаВВозврате, 
	|	ВТ_Возвраты.СтавкаНДС КАК СтавкаНДС, 
