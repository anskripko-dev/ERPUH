	               |	ТаблицаРаспределения.КоличествоПартии КАК КоличествоПартии,
	               |	ТаблицаРаспределения.КоличествоВозврата КАК КоличествоВозврата,
	               |	ТаблицаРаспределения.КоличествоПоДокументу КАК КоличествоПоДокументу,
	               |	ТаблицаРаспределения.Организация КАК Организация,
	               |	ТаблицаРаспределения.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	               |	ТаблицаРаспределения.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	               |	ТаблицаРаспределения.Цена КАК Цена,
	               |	ТаблицаРаспределения.СтавкаНДС КАК СтавкаНДС,
	               |	ТаблицаРаспределения.ПартияЦенаВключаетНДС КАК ПартияЦенаВключаетНДС,
	               |	ТаблицаРаспределения.Номенклатура КАК Номенклатура,
	               |	ТаблицаРаспределения.Склад КАК Склад,
	               |	ТаблицаРаспределения.Контрагент КАК Контрагент,
	               |	ТаблицаРаспределения.Дата КАК Дата,
	               |	ТаблицаРаспределения.Характеристика КАК Характеристика,
	               |	ТаблицаРаспределения.Серия КАК Серия
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ТаблицаРаспределения КАК ТаблицаРаспределения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.ДокументПриобретения КАК ДокументПриобретения,
	               |	ВТ.ДокументВозврата КАК ДокументВозврата,
	               |	ВТ.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	               |	ВТ.Количество КАК Количество,
				   |	ВТ.КоличествоВозврата КАК КоличествоВозврата,
	               |	ВТ.КоличествоПартии КАК КоличествоПартии,
	               |	ВТ.КоличествоПоДокументу КАК КоличествоПоДокументу,
	               |	ВТ.Организация КАК Организация,
	               |	ВТ.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	               |	ВТ.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	               |	ВТ.Цена КАК Цена,
	               |	ВТ.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ.ПартияЦенаВключаетНДС КАК ПартияЦенаВключаетНДС,
	               |	ВТ.Номенклатура КАК Номенклатура,
	               |	ВТ.Склад КАК Склад,
	               |	ВТ.Контрагент КАК Контрагент,
	               |	ВТ.Дата КАК Дата,
	               |	ВТ.Характеристика КАК Характеристика,
	               |	ВТ.Серия КАК Серия
	               |ИЗ
	               |	ВТ КАК ВТ 
	               |ИТОГИ
	               |	СУММА(Количество),
	               |	МАКСИМУМ(КоличествоПоДокументу),
	               |	СУММА(КоличествоВозврата),
	               |	СУММА(КоличествоПартии)
	               |ПО
	               |	ДокументВозврата";
	
	Запрос.УстановитьПараметр("ТаблицаРаспределения", ТаблицаРаспределения);
	РезультатПоРегистраторам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат РезультатПоРегистраторам;
	
КонецФункции

