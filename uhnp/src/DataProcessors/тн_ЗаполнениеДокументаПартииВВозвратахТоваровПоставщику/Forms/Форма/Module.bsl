&НаСервереБезКонтекста
Процедура РаспределитьСуммыПоБазе(Сумма, СуммаБазы, МассивСтрок, ИмяКолонки)
	
	Если СуммаБазы = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Для каждого ТекСтрока Из МассивСтрок Цикл
		
		К = Сумма / СуммаБазы;
		
		СуммаКРаспределению 	= Окр(ТекСтрока[ИмяКолонки] * К, 2);
		ТекСтрока[ИмяКолонки] 	= ТекСтрока[ИмяКолонки] + СуммаКРаспределению;
		
		Сумма 		= Сумма - СуммаКРаспределению;
		СуммаБазы 	= СуммаБазы - ТекСтрока[ИмяКолонки];
		
	КонецЦикла;
	
КонецПроцедуры //РаспределитьСуммыПоБазе()

