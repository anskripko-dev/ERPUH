&НаСервере
Функция ПолучитьЦену(ДокументПТУ, ЦенаВПТУ, АналитикаУчетаНоменклатуры)
	
	Цена = ЦенаВПТУ;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументПТУ);
	Запрос.УстановитьПараметр("АналитикаУчетаНоменклатуры", АналитикаУчетаНоменклатуры);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияТовары.Количество = 0
	|			ТОГДА КорректировкаПоступленияТовары.Цена
	// НАЧАЛО Белоконенко Денис 14.06.2023 Выполнение задач №000045815
	//|		ИНАЧЕ ВЫРАЗИТЬ(КорректировкаПоступленияТовары.Сумма / КорректировкаПоступленияТовары.Количество КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ ВЫРАЗИТЬ(КорректировкаПоступленияТовары.Сумма / КорректировкаПоступленияТовары.КоличествоУпаковок КАК ЧИСЛО(15, 2))
	// КОНЕЦ Белоконенко Денис 14.06.2023 Выполнение задач №000045815
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Документ.КорректировкаПриобретения.Расхождения КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка.ДокументОснование = &Ссылка
	|	И КорректировкаПоступленияТовары.Ссылка.ВидКорректировки = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.КорректировкаПоСогласованиюСТОРОН)
	|	И КорректировкаПоступленияТовары.Ссылка.Проведен
	|	И КорректировкаПоступленияТовары.АналитикаУчетаНоменклатуры = &АналитикаУчетаНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаПоступленияТовары.Ссылка.Дата УБЫВ";	
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Цена = Результат.Цена;	
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

