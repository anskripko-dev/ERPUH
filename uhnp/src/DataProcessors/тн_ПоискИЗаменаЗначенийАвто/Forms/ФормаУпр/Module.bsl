&НаКлиенте
Процедура ПослеВыбораПредставлениеТипа(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    Объект.ТипЗнач = ВыбранныйЭлемент.Значение; 
	ПредставлениеТипа = Строка(Типзнч(ВыбранныйЭлемент.Значение));
	
КонецПроцедуры // ПослеВыбораПредставлениеТипа()

&НаКлиенте
Процедура ОбработчикПрогресса() Экспорт
	
	ДанныеОВыполнении = ПолучитьИзВременногоХранилища(Объект.АдресХранилища);
	
	Если ТипЗнч(ДанныеОВыполнении) = Тип("Структура") Тогда
		
		Индикатор = ДанныеОВыполнении.Инд * 100 / ДанныеОВыполнении.КоличествоОбходов;
		ОбновитьЗаголовокВсего(ДанныеОВыполнении.Инд, ДанныеОВыполнении.КоличествоОбходов);
	
		Если ДанныеОВыполнении.Инд <> ДанныеОВыполнении.КоличествоОбходов Тогда
			
			ПодключитьОбработчикОжидания("ОбработчикПрогресса", 5, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработчикПрогресса()

&НаСервере
Процедура ВыполнитьЗаменуНаСервере()
	
	Индикатор = 0;
	КоличествоОбходов = Объект.НайденныеСсылки.Количество();
	
	ОбновитьЗаголовокВсего(0, КоличествоОбходов);
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ВыполнитьЗамену();
	ЗначениеВРеквизитФормы(Об, "Объект");
			
КонецПроцедуры // ВыполнитьЗаменуНаСервере()

&НаКлиенте
Процедура АвтозаменаСПаузой()
	
	Если Объект.УжеЗапущена Тогда
		Возврат;
	КонецЕсли;
	
	АвтозаменаСПаузойНаСервере();
	
	Если Не Объект.УжеЗапущена Тогда
		ОтключитьОбработчикОжидания("АвтозаменаСПаузой");
	КонецЕсли;
	
КонецПроцедуры // АвтозаменаСПаузой()

&НаСервере
Процедура АвтозаменаСПаузойНаСервере()
	
	ЗаполнитьНаСервере();
	
	Если Объект.ЗаменяемыеЗначения.Количество() > 0 Тогда
		НайтиСсылкиНаСервере();
		ВыполнитьЗаменуНаСервере();
	Иначе
		Объект.УжеЗапущена = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка завершена!");
	КонецЕсли;
	
КонецПроцедуры // АвтозаменаСПаузойНаСервере()     

&НаСервере
Процедура АвтозаменаНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.Автозамена();
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка завершена!");
	
КонецПроцедуры // АвтозаменаНаСервере()

&НаСервере
Процедура ЗаполнитьФлагНаСервере(Значение)
	
	ТЗ = РеквизитФормыВЗначение("Объект.НайденныеСсылки", Тип("ТаблицаЗначений"));  	
	ТЗ.ЗаполнитьЗначения(Значение, "Включено");
	ЗначениеВРеквизитФормы(ТЗ, "Объект.НайденныеСсылки");
	
КонецПроцедуры // ЗаполнитьФлагНаСервере()

&НаСервере
Процедура УстановитьНаСервере()
	
	Если Объект.ТипЗнач = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран тип справочника!");
		
	ИначеЕсли СтрНайти(XMLТипЗнч(Объект.ТипЗнач).ИмяТипа, "CatalogRef") > 0 Тогда
		
		НоваяЗамена = Объект.ЗаменяемыеЗначения.Добавить();
		НоваяЗамена.ЧтоЗаменять = Справочники[Объект.ТипЗнач.Метаданные().Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Объект.ГУИД)));
		НоваяЗамена.НаЧтоЗаменять = Справочники[Объект.ТипЗнач.Метаданные().Имя].ПустаяСсылка();
		НоваяЗамена.Пометка = Истина;
		
	ИначеЕсли СтрНайти(XMLТипЗнч(Объект.ТипЗнач).ИмяТипа, "DocumentRef") > 0 Тогда
		
		НоваяЗамена = Объект.ЗаменяемыеЗначения.Добавить();
		НоваяЗамена.ЧтоЗаменять = Документы[Объект.ТипЗнач.Метаданные().Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Объект.ГУИД)));
		НоваяЗамена.НаЧтоЗаменять = Документы[Объект.ТипЗнач.Метаданные().Имя].ПустаяСсылка();
		НоваяЗамена.Пометка = Истина;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вообще ерунда какая-то..... такого быть не должно....");
		
	КонецЕсли;
	
КонецПроцедуры // Установить()

&НаСервере
Функция ПолучитьСписокВыбораТипа()
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений1 = Новый СписокЗначений;
	СписокЗначений2 = Новый СписокЗначений;

	Для Каждого МетаданныеОбъекта Из Метаданные.Справочники Цикл		
		СписокЗначений1.Добавить(Справочники[МетаданныеОбъекта.Имя].ПустаяСсылка(), МетаданныеОбъекта.Синоним, , БиблиотекаКартинок.Справочник);
	КонецЦикла;  	
	СписокЗначений1.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
	Для Каждого МетаданныеОбъекта Из Метаданные.Документы Цикл		
		СписокЗначений2.Добавить(Документы[МетаданныеОбъекта.Имя].ПустаяСсылка(), МетаданныеОбъекта.Синоним, , БиблиотекаКартинок.Документ);
	КонецЦикла;
	СписокЗначений2.СортироватьПоПредставлению(НаправлениеСортировки.Возр);

	ЗагрузитьВТаблицуЗначений(СписокЗначений1, СписокЗначений);
	ЗагрузитьВТаблицуЗначений(СписокЗначений2, СписокЗначений);
	
	Возврат СписокЗначений;
	
КонецФункции // ПолучитьСписокВыбораТипа()

&НаСервере
Процедура ЗагрузитьВТаблицуЗначений(ТаблицаИсточник, ТаблицаПриемник)
	
	Для Каждого Строка Из ТаблицаИсточник Цикл
	    ТаблицаПриемник.Добавить(Строка.Значение, Строка.Представление, Строка.Пометка, Строка.Картинка);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьВТаблицуЗначений()

