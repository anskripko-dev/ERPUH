&НаСервере
Процедура ОсталосьЗаменВРегистре()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаменяемыеОбъекты.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.тн_ЗаменяемыеОбъекты КАК ЗаменяемыеОбъекты
		|ГДЕ
		|	ЗаменяемыеОбъекты.Объект <> ЗаменяемыеОбъекты.ОбъектЦБ
		|	//УсловиеПоТипу";
	
	Если Объект.ИспользоватьОтборПоТипу Тогда		
		ИмяМД = Объект.ТипОбъекта.Метаданные().ПолноеИмя();	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоТипу", СтрШаблон("И ЗаменяемыеОбъекты.Объект ССЫЛКА %1", ИмяМД));  		
	Иначе  		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоТипу", "");  		
	КонецЕсли;
	
	Элементы.ЗаменяемыеЗначенияОсталосьЗамен.Заголовок = СтрШаблон("Осталось замен: %1", Запрос.Выполнить().Выбрать().Количество());
	
КонецПроцедуры // ОсталосьЗаменВРегистре()

&НаСервере
Процедура УдалитьНенайденныеЗаменяемыеНаСервере()
	
	Регистр = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаменяемыеОбъекты.Объект КАК Объект,
	|	ЗаменяемыеОбъекты.ОбъектЦБ КАК ОбъектЦБ
	|ИЗ
	|	РегистрСведений.тн_ЗаменяемыеОбъекты КАК ЗаменяемыеОбъекты";

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектБД = Выборка.Объект;
		ОбъектЦБ = Выборка.ОбъектЦБ;
		
		Если СтрНайти(СокрЛП(ОбъектБД), "Объект не найден") > 0 Тогда
			
			Регистр.Объект = ОбъектБД;
			Регистр.Прочитать();
			
			Если Регистр.Выбран() Тогда
				Регистр.Удалить();
			КонецЕсли;
			
		ИначеЕсли СтрНайти(СокрЛП(ОбъектЦБ), "Объект не найден") > 0 Тогда
			
			Регистр.ОбъектЦБ = ОбъектЦБ;
			Регистр.Прочитать();
			
			Если Регистр.Выбран() Тогда
				Регистр.Удалить();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры // УдалитьНенайденныеЗаменяемыеНаСервере()

