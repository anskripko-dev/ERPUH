&НаСервере
Процедура ДобавитьСвязанныеОбъектыКонтрагентаНаСервере(ЧтоЗаменять, НаЧтоЗаменять)
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ДобавитьСвязанныеОбъектыКонтрагента(ЧтоЗаменять, НаЧтоЗаменять);
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры // ДобавитьЕдиницыИзмеренияНаСервере()

// Борисенко Игорь 12.03.2025 Выполнение задач №000052995
&НаСервере
Процедура НастроитьФорму()
	
	ИмяЭлемента = "ИгнорироватьДатыЗапретаДляВсехТиповОбъектов";
	Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.Группа1);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = "Объект.ИгнорироватьДатыЗапретаДляВсехТиповОбъектов";
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		НовыйЭлемент.Заголовок = "Игнорировать даты запрета редактирования для всех типов объектов (иначе - только для рег.свед. по физ.лицам)";
		НовыйЭлемент.Подсказка = "иначе - только для рег.свед. ФИО физ.лиц., Гражданство физ.лиц., Документы физ.диц., Свед.об инвалид.физ.лиц.";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
