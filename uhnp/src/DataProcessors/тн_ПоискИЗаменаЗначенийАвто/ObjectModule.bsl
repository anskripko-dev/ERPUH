
Перем мМассивОбъектовСОшибкой;
// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
Перем КонтрольДатыЗапретаОтключаетсяДляВсехОбъектов;
Перем КонтрольДатыЗапретаОтключаетсяТолькоДляТекущегоОбъекта;
// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995

#Область ПрограммныйИнтерфейс

Процедура Заполнить() Экспорт
	
	ЗаменяемыеЗначения.Очистить();
		
	Если ЗапуститьЧерез > 0 Тогда
		УжеЗапущена = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОшибкиАвтоматическогоПоискаИЗаменыЗначений.ЧтоЗаменять КАК ЧтоЗаменять
	|ПОМЕСТИТЬ ВТ_Ошибки
	|ИЗ
	|	РегистрСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений КАК ОшибкиАвтоматическогоПоискаИЗаменыЗначений
	|ГДЕ
	|	&НеОбрабатыватьОбъектыСОшибками
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ //КоличествоОбъектовВВыборке
	|	ЗаменяемыеОбъекты.Объект КАК Объект,
	|	ЗаменяемыеОбъекты.ОбъектЦБ КАК ОбъектЦБ,
	|	ЗаменяемыеОбъекты.Ошибка КАК Ошибка,
	|	ВЫБОР
	|		КОГДА ЗаменяемыеОбъекты.Приоритет = 0
	|			ТОГДА 99999
	|		ИНАЧЕ ЗаменяемыеОбъекты.Приоритет
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	РегистрСведений.тн_ЗаменяемыеОбъекты КАК ЗаменяемыеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Ошибки КАК ВТ_Ошибки
	|		ПО ЗаменяемыеОбъекты.Объект = ВТ_Ошибки.ЧтоЗаменять
	|ГДЕ
	|	ЗаменяемыеОбъекты.Объект <> ЗаменяемыеОбъекты.ОбъектЦБ
	|	И Не ЗаменяемыеОбъекты.НеЗаменять
	|	//УсловиеПоТипу
	|	И ВТ_Ошибки.ЧтоЗаменять ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ошибка УБЫВ,
	|	Приоритет";  
	
	Запрос.УстановитьПараметр("НеОбрабатыватьОбъектыСОшибками", НеОбрабатыватьОбъектыСОшибками);
	
	Если ИспользоватьОтборПоТипу Тогда		
		ИмяМД = ТипОбъекта.Метаданные().ПолноеИмя();	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоТипу", СтрШаблон("И ЗаменяемыеОбъекты.Объект ССЫЛКА %1", ИмяМД));  		
	Иначе  		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеПоТипу", "");  		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоОбъектовВВыборке) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//КоличествоОбъектовВВыборке", СтрШаблон("ПЕРВЫЕ %1", Формат(КоличествоОбъектовВВыборке, "ЧДЦ=0; ЧГ=0")));  		
	Иначе  		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//КоличествоОбъектовВВыборке", "ПЕРВЫЕ 3");  		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомСтр = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НовСтр = ЗаменяемыеЗначения.Добавить();
		НовСтр.Пометка 			= Истина;
		НовСтр.ЧтоЗаменять 		= Выборка.Объект;
		НовСтр.НаЧтоЗаменять	= Выборка.ОбъектЦБ;
		
		НомСтр = НомСтр + 1;
		
		Если ТипЗнч(Выборка.ОбъектЦБ) = Тип("СправочникСсылка.Номенклатура") Тогда	
			НомСтр = НомСтр + ДобавитьЕдиницыИзмерения(Выборка.Объект, Выборка.ОбъектЦБ);    
		ИначеЕсли ТипЗнч(Выборка.ОбъектЦБ) = Тип("СправочникСсылка.Контрагенты") Тогда 
			НомСтр = НомСтр + ДобавитьСвязанныеОбъектыКонтрагента(Выборка.Объект, Выборка.ОбъектЦБ, НомСтр); 	
		КонецЕсли;
		
		Если КоличествоОбъектовВВыборке = 0
			И ЗаменяемыеЗначения.Количество() > 2 Тогда
			Прервать;
		КонецЕсли;
	                     		
	КонецЦикла;
	
КонецПроцедуры // Заполнить()

Процедура НайтиСсылки() Экспорт
	
	МассивЗаменяемых = Новый Массив;
	Для Каждого Стр Из ЗаменяемыеЗначения Цикл
		Если Стр.Пометка Тогда
			МассивЗаменяемых.Добавить(Стр.ЧтоЗаменять);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивЗаменяемых.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано ни одного значения для поиска!");
		Возврат;
	КонецЕсли;
	
	НайденныеСсылки = НайтиПоСсылкам(МассивЗаменяемых);
	
	НайденныеСсылки.Колонки[0].Имя = "Ссылка";
	НайденныеСсылки.Колонки[1].Имя = "Данные";
	НайденныеСсылки.Колонки[2].Имя = "Метаданные";
	
	НайденныеСсылки.Колонки.Добавить("Включено", 			Новый ОписаниеТипов("Булево"));
	НайденныеСсылки.Колонки.Добавить("Тип", 				Новый ОписаниеТипов("Строка"));
	НайденныеСсылки.Колонки.Добавить("ПолноеИмяМетаданных",	Новый ОписаниеТипов("Строка"));
	НайденныеСсылки.Колонки.Добавить("Приоритет",			Новый ОписаниеТипов("Число"));
	
	Для Каждого Строка Из НайденныеСсылки Цикл
		Строка.Тип = ТипЗнч(Строка.Данные);
		Строка.ПолноеИмяМетаданных = Строка.Метаданные.ПолноеИмя();
		Если Строка.ПолноеИмяМетаданных = "РегистрСведений.тн_ЗаменяемыеОбъекты" Тогда
			Строка.Приоритет = 1;
		КонецЕсли;
	КонецЦикла;
	
	НайденныеСсылки.ЗаполнитьЗначения(Истина, "Включено");
	НайденныеСсылки.Сортировать("Приоритет");

КонецПроцедуры // НайтиСсылки()

Процедура ВыполнитьЗамену() Экспорт
	      	
	мМенеджеры = ИнициализацияМенеджеров();
	
	Сч = 0;
	КоличествоОбходов = НайденныеСсылки.Количество();
	
	Заменяемые = Новый Соответствие;
	Для Каждого Стр Из ЗаменяемыеЗначения Цикл
		Если Стр.Пометка Тогда
			Заменяемые.Вставить(Стр.ЧтоЗаменять, Стр.НаЧтоЗаменять);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ВыполнятьЗаменыБезТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	мМассивОбъектовСОшибкой = Новый Массив;
	
	ИсключаемыеРегистрыСведений = Новый СписокЗначений;
	//НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	РеквизитыПроверкиЗамен = Новый Массив;
	//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	Если ИспользоватьОтборПоТипу Тогда 		
		ПараметрыПоиска = Новый Структура("ТипОбъекта", ТипОбъекта.Метаданные().ПолноеИмя());
		Выборка = РегистрыСведений.тн_НастройкаАвтоматическогоПоискаИЗаменыЗначений.Выбрать(ПараметрыПоиска);
		Если Выборка.Следующий() Тогда
			ИсключаемыеРегистрыСведений = Выборка.ИсключаемыеРегистрыСведений.Получить();
			Если ИсключаемыеРегистрыСведений = Неопределено Тогда
				ИсключаемыеРегистрыСведений = Новый СписокЗначений;
			КонецЕсли;
			//НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
			РеквизитыПроверкиЗамен = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Выборка.РеквизитыПроверкиЗамен, ",");
			//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
		КонецЕсли; 		
	КонецЕсли;
	
	// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	ПроверитьУстановитьИгнорировниеДатыЗапретаДляВсехТиповОбъектов();
	// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	
	Для Каждого Стр Из НайденныеСсылки Цикл
		
		Сч = Сч + 1;
		ПоместитьВоВременноеХранилище(Новый Структура("Инд, КоличествоОбходов", Сч, КоличествоОбходов),	АдресХранилища);
		
		МетДанные = Метаданные.НайтиПоПолномуИмени(Стр.ПолноеИмяМетаданных);
		
		// Не заменять в регистре заменяемые объекты
		Если МетДанные.Имя = "тн_ЗаменяемыеОбъекты"
			И НеЗаменятьВРегистреЗамОбъекты Тогда
			Продолжить;
		КонецЕсли; 	
		
		Если МетДанные.Имя = "тн_ЗаменяемыеОбъекты" Тогда      			
			ЕстьОшибки = ЕстьОшибкиВРегистре(Стр.Ссылка);
			Если ЕстьОшибки Тогда
				Продолжить;
			КонецЕсли;  			
		КонецЕсли;
		
		Если Не Стр.Включено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектДанных   	= Стр.Данные;
		ОбъектМД 		= МетДанные;
		Свойства 		= мМенеджеры[ОбъектМД];
		ЧтоЗаменять 	= Стр.Ссылка;
		
		Если Свойства = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неизвестный тип: " + Строка(ОбъектМД));
			Продолжить;
		КонецЕсли;
		 		
		ИмяТипа  = Свойства.ИмяТипа;
		
		СтруктураЛога = ПолучитьСтруктуруЛога();
		СтруктураЛога.ЧтоЗаменять = Стр.Ссылка;
		СтруктураЛога.НаЧтоЗаменять = Заменяемые[Стр.Ссылка];
		СтруктураЛога.Данные = ОбъектДанных;
			
		// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
		ПроверитьУстановитьИгнорировниеДатыЗапретаДляОтдельныхТиповОбъектов(Свойства.Менеджер);
		// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995
		
		//НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
		Если ЗначениеЗаполнено(РеквизитыПроверкиЗамен) Тогда
			НеЗаменять = Ложь;
			Для Каждого Реквизит Из РеквизитыПроверкиЗамен Цикл
				Если Стр.Ссылка[Реквизит] <> Заменяемые[Стр.Ссылка][Реквизит] Тогда
					НеЗаменять = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НеЗаменять Тогда
				СтруктураЛога.ОписаниеОшибки = СтрШаблон("Не совпадают значения реквизитов объекта замены и заменяемого объекта: %1",
					Реквизит);
				ЗаписатьОшибку(СтруктураЛога);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
		
		Если ИмяТипа = "Константа" Тогда
			
			Попытка
				
				Свойства.Менеджер.Установить(Заменяемые[Стр.Ссылка]);
				
			Исключение 				
				СтруктураЛога.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());				
				ЗаписатьОшибку(СтруктураЛога);
				Если Не ВыполнятьЗаменыБезТранзакции Тогда
					ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецЕсли;
			КонецПопытки;
			
		ИначеЕсли ИмяТипа = "РегистрСведений" Тогда
			        						
			Набор = Свойства.Менеджер.СоздатьНаборЗаписей();
			
			Периодический = (ОбъектМД.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
			Если Периодический Тогда
				Набор.Отбор.Период.Установить(ОбъектДанных.Период);
			КонецЕсли;
			Для Каждого Рекв Из ОбъектМД.Измерения Цикл
				Набор.Отбор[Рекв.Имя].Установить(ОбъектДанных[Рекв.Имя]);
			КонецЦикла;
			
			Набор.Прочитать();
			
			// НАЧАЛО Луконин Е.А. 27.03.2025 Выполнение задач №000053183
			Набор.ОбменДанными.Загрузка = Истина;
			Если УдалятьРегистрациюИзменений Тогда
				Набор.ОбменДанными.Получатели.Автозаполнение = Ложь;
				Набор.ОбменДанными.Получатели.Очистить();
			КонецЕсли;
			// КОНЕЦ Луконин Е.А. 27.03.2025 Выполнение задач №000053183
			
			Если Набор.Выбран() Тогда
				
				УдалитьБезЗамены = УдалитьБезЗамены(ЧтоЗаменять, Стр.ПолноеИмяМетаданных);
				Если УдалитьБезЗамены Тогда
					Набор.Очистить();
					Набор.Записать();
					Продолжить;    				
				КонецЕсли; 	
				
			КонецЕсли;
			
			// Обработка измерений объекта  			
			Для Каждого Запись Из Набор Цикл
				Для Каждого Рекв Из ОбъектМД.Измерения Цикл
					ИмяРеквизита  = Рекв.Имя;
					НаЧтоЗаменять = Заменяемые[Запись[ИмяРеквизита]];
					Если НаЧтоЗаменять = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Запись[ИмяРеквизита] = НаЧтоЗаменять;
				КонецЦикла;    			
			КонецЦикла;
			
			НеЗаменятьСуществующуюЗапись = ИсключаемыеРегистрыСведений.НайтиПоЗначению(ОбъектМД.Имя) <> Неопределено;
			
			Если НеЗаменятьСуществующуюЗапись Тогда
				
				Набор.Прочитать();
				
				// Не заменяем существующую запись
				Если Набор.Выбран() Тогда
					
					Для Каждого Рекв Из ОбъектМД.Измерения Цикл
						Набор.Отбор[Рекв.Имя].Установить(ОбъектДанных[Рекв.Имя]);
					КонецЦикла;
					
					Набор.Прочитать();
					
					Если Набор.Выбран() Тогда
						Набор.Очистить();
						Набор.Записать();
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				// Если не было, то все очистилось  				
				Для Каждого Рекв Из ОбъектМД.Измерения Цикл
					Набор.Отбор[Рекв.Имя].Установить(ОбъектДанных[Рекв.Имя]);
				КонецЦикла;
				
				Набор.Прочитать();
				
				Для Каждого Запись Из Набор Цикл
					Для Каждого Рекв Из ОбъектМД.Измерения Цикл
						ИмяРеквизита  = Рекв.Имя;
						НаЧтоЗаменять = Заменяемые[Запись[ИмяРеквизита]];
						Если НаЧтоЗаменять = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						Запись[ИмяРеквизита] = НаЧтоЗаменять;
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
			
			// Обработка ресурсов объекта 			
			Для Каждого Запись Из Набор Цикл
				Для Каждого Рекв Из ОбъектМД.Ресурсы Цикл
					ИмяРеквизита  = Рекв.Имя;
					НаЧтоЗаменять = Заменяемые[Запись[ИмяРеквизита]];
					Если НаЧтоЗаменять = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Запись[ИмяРеквизита] = НаЧтоЗаменять;
				КонецЦикла; 
				
				// Обработка реквизитов объекта 			
				Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
					ИмяРеквизита  = Рекв.Имя;
					НаЧтоЗаменять = Заменяемые[Запись[ИмяРеквизита]];
					Если НаЧтоЗаменять = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Запись[ИмяРеквизита] = НаЧтоЗаменять;
				КонецЦикла; 			
				
			КонецЦикла;
			
			Если Набор.Количество() > 0 Тогда
				
				НовыйНабор = Свойства.Менеджер.СоздатьНаборЗаписей();
				
				Если Периодический Тогда
					НовыйНабор.Отбор.Период.Установить(Набор[0].Период);
				КонецЕсли;
				
				Для Каждого Рекв Из ОбъектМД.Измерения Цикл
					НовыйНабор.Отбор[Рекв.Имя].Установить(Набор[0][Рекв.Имя]);
				КонецЦикла;
				
				НовыйНабор.Загрузить(Набор.Выгрузить());
				
				// НАЧАЛО Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052736
				ОтключитьЭлементОтбора_ИдентификаторЗаписи_ЕслиИмеетсяПустоеЗначениеИдентификатора(НовыйНабор);
				
				Если НеСоответствуютЗначенияЗаписейОтборуНабораЗаписей(МетДанные.Имя, НовыйНабор) Тогда
					Продолжить;
				КонецЕсли;
				// КОНЕЦ Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052736
				
				Набор.Очистить();
				Набор.Записать();
				
				ЗаписатьДанные(НовыйНабор, СтруктураЛога);
				
			КонецЕсли;
			
		Иначе  // Справочник, ПланВидовХарактеристик, ПланСчетов
			
			ОбъектДанных = ОбъектДанных.ПолучитьОбъект();
			
			Если ОбъектДанных = Неопределено Тогда
				СтруктураЛога.ОписаниеОшибки = СтрШаблон("Битая ссылка - %1", Стр.Данные);
				ЗаписатьОшибку(СтруктураЛога);     				
				Продолжить;
			КонецЕсли;
			
			ОбъектДанных.ОбменДанными.Загрузка = Истина;
			Если ИмяТипа = "Справочник"
				Или ИмяТипа = "ПланВидовХарактеристик"
				Или ИмяТипа = "ПланСчетов" Тогда
				
				// Родитель
				Если ИмяТипа <> "ПланСчетов" Тогда
					Если ОбъектМД.Иерархический Тогда
						ИмяРеквизита  = "Родитель";
						НаЧтоЗаменять = Заменяемые[ОбъектДанных[ИмяРеквизита]];
						Если НаЧтоЗаменять <> Неопределено Тогда
							ОбъектДанных[ИмяРеквизита] = НаЧтоЗаменять;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если ИмяТипа = "Справочник" Тогда
					// Владелец
					Если ОбъектМД.Владельцы.Количество() > 0 Тогда
						ИмяРеквизита  = "Владелец";
						НаЧтоЗаменять = Заменяемые[ОбъектДанных[ИмяРеквизита]];
						Если НаЧтоЗаменять <> Неопределено Тогда
							ОбъектДанных[ИмяРеквизита] = НаЧтоЗаменять;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли; 			
			
			ЭтоСправочникКонтрагенты = ОбъектМД = Метаданные.Справочники.Контрагенты;
			
			// Обработка реквизитов объекта    			
			Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
				ИмяРеквизита  = Рекв.Имя;
				НаЧтоЗаменять = Заменяемые[ОбъектДанных[ИмяРеквизита]];
				Если НаЧтоЗаменять = Неопределено
					Или ИмяРеквизита = "ГоловнойКонтрагент" Тогда
					Продолжить;
				КонецЕсли;
				
				// Логика для Справочник.Контрагенты
				Если ЭтоСправочникКонтрагенты
					И (ИмяРеквизита = "Покупатель"
					Или ИмяРеквизита = "Поставщик")
					И Не НаЧтоЗаменять Тогда
					Продолжить;
				КонецЕсли;
				
				ОбъектДанных[ИмяРеквизита] = НаЧтоЗаменять;
			КонецЦикла; 
			               			
			// Обработка табличных частей объекта     			
			Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
				ИмяТЧ = ТЧ.Имя;
				Для Каждого СтрокаТЧ Из ОбъектДанных[ИмяТЧ] Цикл
					Для Каждого Рекв Из ТЧ.Реквизиты Цикл
						ИмяРеквизита  = Рекв.Имя;
						НаЧтоЗаменять = Заменяемые[СтрокаТЧ[ИмяРеквизита]];
						Если НаЧтоЗаменять = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						СтрокаТЧ[ИмяРеквизита] = НаЧтоЗаменять;
					КонецЦикла; 
				КонецЦикла; 
			КонецЦикла;
			
			Если ОбъектМД.Имя = "СпецификацииНоменклатуры" Тогда
				ТабЧасть = ОбъектДанных["ИсходныеКомплектующие"];
				ТабЧасть.Свернуть("ВидНорматива, Номенклатура, ЕдиницаИзмерения, СтатьяЗатрат, КоэффициентМассы", "Количество");
			КонецЕсли;
			
			Если ИмяТипа = "Документ" Тогда
				
				НаЧтоЗаменять = Заменяемые.Получить(ЧтоЗаменять);
				
				Для Каждого НаборЗаписей Из ОбъектДанных.Движения Цикл 
					
					НаборЗаписей.Прочитать();
					НаборЗаписей.ОбменДанными.Загрузка = Истина;
					
					ИмяМД = НаборЗаписей.Метаданные().Имя;
					
					ЗаменятьВДвижениях = ИмяМД = "РаспределениеЗатратПоПеределам" ИЛИ 
						ИмяМД = "РаспределениеЗатратПоНаправлениям" ИЛИ 
						ИмяМД = "РаспределениеЗатратПоПеределамОрганизаций" ИЛИ 
						ИмяМД = "РаспределениеПродукцииПоПеределам" ИЛИ 
						ИмяМД = "РаспределениеПродукцииПоПеределамОрганизаций" ИЛИ
						ИмяМД = "ПлановаяСебестоимостьСырья" ИЛИ
						ИмяМД = "ЦеныНоменклатурыКонтрагентов" ИЛИ
						ИмяМД = "ЗаказыПокупателей" ИЛИ
						ИмяМД = "СпособыПланированияНоменклатуры" ИЛИ
						ИмяМД = "РасценкаЗаказаПокупателя" ИЛИ
						ИмяМД = "ЦеныНоменклатурыПоОбъектамКИСО" ИЛИ
						ИмяМД = "ЦеныНоменклатуры";
						
					Если ЗаменятьВДвижениях Тогда
						
						ТаблицаДвижений = НаборЗаписей.Выгрузить();
						
						Если ТаблицаДвижений.Количество() > 0 Тогда
							
							ИзмененыДвижения = Ложь;
							Для НомКол = 0 По ТаблицаДвижений.Колонки.Количество() - 1 Цикл
								
								Если ТаблицаДвижений.Колонки[НомКол].ТипЗначения.СодержитТип(ТипЗнч(ЧтоЗаменять)) Тогда
									
									ИмяКолонки = ТаблицаДвижений.Колонки[НомКол].Имя;
									Отбор = Новый Структура(ИмяКолонки);
									Отбор.Вставить(ИмяКолонки, ЧтоЗаменять);
									НайденныеСтроки = ТаблицаДвижений.НайтиСтроки(Отбор);
									
									Для ТекСтр = 0 По НайденныеСтроки.Количество() - 1 Цикл
										
										СтрокаТЗ = НайденныеСтроки[ТекСтр];
										Если ТаблицаДвижений.Найти(Заменяемые.Получить(ЧтоЗаменять),ИмяКолонки) <> Неопределено Тогда
											ТаблицаДвижений.Удалить(СтрокаТЗ);
										Иначе
											СтрокаТЗ[ИмяКолонки] = Заменяемые.Получить(ЧтоЗаменять);
										КонецЕсли;
										ИзмененыДвижения = Истина;
										
									КонецЦикла;
									
								КонецЕсли;
								
							КонецЦикла;
							
							Если ИзмененыДвижения Тогда
								НаборЗаписей.Отбор.Регистратор.Установить(ОбъектДанных.Ссылка);
								НаборЗаписей.Очистить();
								НаборЗаписей.Загрузить(ТаблицаДвижений);
								ЗаписатьДанные(НаборЗаписей, СтруктураЛога);
							КонецЕсли;
							
						КонецЕсли;
						
					Иначе
						
						ТаблицаДвижений = НаборЗаписей.Выгрузить();
						
						Если ТаблицаДвижений.Количество() > 0 Тогда
							
							ИзмененыДвижения = Ложь;
							
							Для НомКол = 0 По ТаблицаДвижений.Колонки.Количество() - 1 Цикл
								
								Если ТаблицаДвижений.Колонки[НомКол].ТипЗначения.СодержитТип(ТипЗнч(ЧтоЗаменять)) Тогда
									
									ИмяКолонки = ТаблицаДвижений.Колонки[НомКол].Имя;
									Отбор = Новый Структура(ИмяКолонки);
									Отбор.Вставить(ИмяКолонки, ЧтоЗаменять);
									НайденныеСтроки = ТаблицаДвижений.НайтиСтроки(Отбор);
									Для ТекСтр = 0 По НайденныеСтроки.Количество() - 1 Цикл
										СтрокаТЗ = НайденныеСтроки[ТекСтр];
										СтрокаТЗ[ИмяКолонки] = Заменяемые.Получить(ЧтоЗаменять);
										ИзмененыДвижения = Истина;
									КонецЦикла;
									
								КонецЕсли;
							КонецЦикла;
							
							Если ИзмененыДвижения Тогда								
								НаборЗаписей.Отбор.Регистратор.Установить(ОбъектДанных.Ссылка);
								НаборЗаписей.Очистить();
								НаборЗаписей.Загрузить(ТаблицаДвижений);		
								ЗаписатьДанные(НаборЗаписей, СтруктураЛога);  								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			ОбъектДанных.ОбменДанными.Загрузка = Истина;
			ЗаписатьДанные(ОбъектДанных, СтруктураЛога);
			ОбъектДанных.ОбменДанными.Загрузка = Ложь;
			
		КонецЕсли; // Если ИмяТипа = "Константа" Тогда...
			
		// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
		ПроверитьСнятьИгнорировниеДатыЗапретаДляОтдельныхТиповОбъектов(Свойства.Менеджер);
		// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995
			
	КонецЦикла; // Для Каждого Стр Из НайденныеСсылки Цикл...

	// НАЧАЛО Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	ПроверитьСнятьИгнорировниеДатыЗапретаДляВсехТиповОбъектов();
	// КОНЕЦ Борисенко Игорь 12.03.2025 Выполнение задач №000052995
	
	Если НЕ ВыполнятьЗаменыБезТранзакции Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
		
	//Чтоб повторялось 1 раз
	Если ЗаменяемыеЗначения.Количество() > 0 Тогда
		
		Для Каждого Строчка Из ЗаменяемыеЗначения Цикл
			
			Если ЕстьОшибкиВРегистре(Строчка.ЧтоЗаменять) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				
				// Сбросим флаг ошибки
				МЗ = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
				МЗ.Объект = Строчка.НаЧтоЗаменять; 				
				МЗ.Прочитать(); 				
				Если МЗ.Выбран() Тогда 					
					МЗ.Ошибка = Ложь;
					МЗ.Приоритет = 0;
					МЗ.Записать();					
				КонецЕсли;
				
				ОбъектЗаменяемый = Строчка.ЧтоЗаменять.ПолучитьОбъект();
				
				Если Не ОбъектЗаменяемый.Предопределенный Тогда
					ОбъектЗаменяемый.ОбменДанными.Загрузка = Истина;
					
					// НАЧАЛО Луконин Е.А. 27.03.2025 Выполнение задач №000053183
					ОбъектЗаменяемый.ОбменДанными.Получатели.Автозаполнение = Ложь;
					ОбъектЗаменяемый.ОбменДанными.Получатели.Очистить();
					// КОНЕЦ Луконин Е.А. 27.03.2025 Выполнение задач №000053183
					
					Если УдалятьФизическиЗамененныеЭлементы Тогда
						ОбъектЗаменяемый.Удалить();
					Иначе
						ОбъектЗаменяемый.УстановитьПометкуУдаления(Истина, Истина);
					КонецЕсли;
					ОбъектЗаменяемый.ОбменДанными.Загрузка = Ложь;
				КонецЕсли;
				
			Исключение
				
				Если УдалятьФизическиЗамененныеЭлементы Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка при попытке удалить объект - %1", Строка(ОбъектЗаменяемый)));
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка при попытке пометить на удаление объект - %1", Строка(ОбъектЗаменяемый)));
				КонецЕсли;
				
			КонецПопытки;
			
		КонецЦикла;
		
		ЗаменяемыеЗначения.Очистить();
		
	КонецЕсли;
	                                              	
КонецПроцедуры // ВыполнитьЗамену()

// Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052736
Функция НеСоответствуютЗначенияЗаписейОтборуНабораЗаписей(ИмяРегистраСведений, НовыйНабор)
	
	СоставОтбора = Новый Структура;
	
	Для Каждого ЭлементОтбора Из НовыйНабор.Отбор Цикл
		СоставОтбора.Вставить(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
	КонецЦикла;
	
	ПредставлениеСтруктуры = "";
	Для Каждого КлючЗначение Из СоставОтбора Цикл
		ПредставлениеСтруктуры = СтрШаблон("%1%2=%3; ", ПредставлениеСтруктуры, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	ТекстСообщенияОшибки =
		СтрШаблон(
			"Ошибка: значения полей регистра сведений %1 не соответствуют значениям отбора:
			|%2",
			ИмяРегистраСведений,
			ПредставлениеСтруктуры);
	
	Для Каждого Запись Из НовыйНабор Цикл
		Для Каждого КлючЗначение Из СоставОтбора Цикл
			Если Запись[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияОшибки);
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции // НеСоответствуютЗначенияЗаписейОтборуНабораЗаписей()

// Иванов ВЮ (Код-Эксперт) 21.02.2025 Выполнение задач №000052736
Процедура ОтключитьЭлементОтбора_ИдентификаторЗаписи_ЕслиИмеетсяПустоеЗначениеИдентификатора(НовыйНабор)
	
	ЭлементОтбора_ИдентификаторЗаписи = НовыйНабор.Отбор.Найти("ИдентификаторЗаписи");
	
	Если ЭлементОтбора_ИдентификаторЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗаписей = НовыйНабор.Выгрузить();
	
	Если ТаблицаЗаписей.Найти("", "ИдентификаторЗаписи") <> Неопределено Тогда
		ЭлементОтбора_ИдентификаторЗаписи.Использование = Ложь;
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ТаблицаЗаписей Цикл
		Если ТекущаяСтрока.ИдентификаторЗаписи <> ЭлементОтбора_ИдентификаторЗаписи.Значение Тогда
			ЭлементОтбора_ИдентификаторЗаписи.Использование = Ложь;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ОтключитьЭлементОтбора_ИдентификаторЗаписи_ЕслиИмеетсяПустоеЗначениеИдентификатора()

Процедура Автозамена() Экспорт
	
	Пока ЗаменяемыеЗначения.Количество() > 0 Цикл
		
		Если ИспользоватьОтборПоТипу 
			И ТипЗнч(ТипОбъекта) = Тип("СправочникСсылка.Номенклатура") Тогда
			
			ЕстьЕдиницы = Ложь;
			
			Для Каждого Строка Из ЗаменяемыеЗначения Цикл
				Если ТипЗнч(Строка.НаЧтоЗаменять) = Тип("СправочникСсылка.Номенклатура") Тогда
					Строка.Пометка = Ложь;
				Иначе
					ЕстьЕдиницы = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьЕдиницы Тогда
				
				НайтиСсылки();
				ВыполнитьЗамену();
				Заполнить();
				НайтиСсылки();
				ВыполнитьЗамену();
				Заполнить();
				
			Иначе
				
				Заполнить();
				НайтиСсылки();
				ВыполнитьЗамену();
				Заполнить();
				
			КонецЕсли;
			
		Иначе
			
			НайтиСсылки();
			ВыполнитьЗамену();
			Заполнить();
			
		КонецЕсли;
		
	КонецЦикла;
	    	
КонецПроцедуры // Автозамена()

Функция ДобавитьЕдиницыИзмерения(ЧтоЗаменять, НаЧтоЗаменять) Экспорт
	
	ЗапросКЕдиницам = Новый Запрос;
	
	ЗапросКЕдиницам.УстановитьПараметр("ЧтоЗаменять", ЧтоЗаменять);
	ЗапросКЕдиницам.УстановитьПараметр("НаЧтоЗаменять", НаЧтоЗаменять);
	
	ЗапросКЕдиницам.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕдиницыИзмерения.Ссылка КАК Ссылка,
	|	ЕдиницыИзмерения.ЕдиницаИзмерения.Код КАК Код
	|ПОМЕСТИТЬ ВТ_ЧтоЗаменять
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &ЧтоЗаменять
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕдиницыИзмерения.Ссылка КАК Ссылка,
	|	ЕдиницыИзмерения.ЕдиницаИзмерения.Код КАК Код
	|ПОМЕСТИТЬ ВТ_НаЧтоЗаменять
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения  КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &НаЧтоЗаменять
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ЧтоЗаменять.Ссылка КАК ЕдиницаЧтоЗаменять,
	|	ВТ_НаЧтоЗаменять.Ссылка КАК ЕдиницаНаЧтоЗаменять
	|ИЗ
	|	ВТ_ЧтоЗаменять КАК ВТ_ЧтоЗаменять
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НаЧтоЗаменять КАК ВТ_НаЧтоЗаменять
	|		ПО ВТ_ЧтоЗаменять.Код = ВТ_НаЧтоЗаменять.Код";
		
	Выборка = ЗапросКЕдиницам.Выполнить().Выбрать();
	Добавлено = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ЕдиницаЧтозаменять)
			И ЗначениеЗаполнено(Выборка.ЕдиницаНаЧтоЗаменять) Тогда
			
			НовСтр = ЗаменяемыеЗначения.Добавить();
			НовСтр.ЧтоЗаменять 		= Выборка.ЕдиницаЧтозаменять;
			НовСтр.НаЧтоЗаменять 	= Выборка.ЕдиницаНаЧтоЗаменять;
			НовСтр.Пометка 			= Истина; 
			
			Добавлено = Добавлено + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Добавлено;
	
КонецФункции // ДобавитьЕдиницыИзмерения()

Функция ДобавитьСвязанныеОбъектыКонтрагента(КонтрагентЧтоЗаменять, КонтрагентНаЧтоЗаменять, НомерДобавляемойСтроки = 0) Экспорт
	
	Добавлено = 0;
	Добавлено = ДобавитьПартнеры(КонтрагентЧтоЗаменять, КонтрагентНаЧтоЗаменять);
	
	Если Не НомерДобавляемойСтроки = 0 Тогда
		ЗаменяемыеЗначения.Сдвинуть(НомерДобавляемойСтроки - 1, Добавлено);
	КонецЕсли;
	
	Возврат Добавлено;
	
КонецФункции // ДобавитьПартнеры()

Функция ДобавитьКлючиАналитикиУчетаПартнера(КонтрагентЧтоЗаменять, ПартнерЧтоЗаменять, КонтрагентНаЧтоЗаменять, ПартнерНаЧтоЗаменять) 
	
	Добавлено = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиАналитикиУчетаПоПартнерам.Ссылка КАК СсылкаКлючАналитикиЧтоЗаменять,
		|	КлючиАналитикиУчетаПоПартнерам.Организация КАК Организация,
		|	КлючиАналитикиУчетаПоПартнерам.Договор КАК Договор,
		|	КлючиАналитикиУчетаПоПартнерам.НаправлениеДеятельности КАК НаправлениеДеятельности
		|ПОМЕСТИТЬ ВТ_КлючиАналитикиПартнера_ЧтоЗаменять
		|ИЗ
		|	Справочник.КлючиАналитикиУчетаПоПартнерам КАК КлючиАналитикиУчетаПоПартнерам
		|ГДЕ
		|	КлючиАналитикиУчетаПоПартнерам.Контрагент = &КонтрагентЧтоЗаменять
		|	И КлючиАналитикиУчетаПоПартнерам.Партнер = &ПартнерЧтоЗаменять
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиАналитикиУчетаПоПартнерам.Ссылка КАК СсылкаКлючАналитикиНаЧтоЗаменять,
		|	КлючиАналитикиУчетаПоПартнерам.Организация КАК Организация,
		|	КлючиАналитикиУчетаПоПартнерам.Договор КАК Договор,
		|	КлючиАналитикиУчетаПоПартнерам.НаправлениеДеятельности КАК НаправлениеДеятельности
		|ПОМЕСТИТЬ ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять
		|ИЗ
		|	Справочник.КлючиАналитикиУчетаПоПартнерам КАК КлючиАналитикиУчетаПоПартнерам
		|ГДЕ
		|	КлючиАналитикиУчетаПоПартнерам.Контрагент = &КонтрагентНаЧтоЗаменять   
		|	И КлючиАналитикиУчетаПоПартнерам.Партнер = &ПартнерНаЧтоЗаменять
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КлючиАналитикиПартнера_ЧтоЗаменять.СсылкаКлючАналитикиЧтоЗаменять КАК СсылкаКлючАналитикиЧтоЗаменять, 
		|	ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять.СсылкаКлючАналитикиНаЧтоЗаменять КАК СсылкаКлючАналитикиНаЧтоЗаменять
		|ИЗ
		|	ВТ_КлючиАналитикиПартнера_ЧтоЗаменять КАК ВТ_КлючиАналитикиПартнера_ЧтоЗаменять
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять КАК ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять
		|		ПО ВТ_КлючиАналитикиПартнера_ЧтоЗаменять.Организация = ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять.Организация
		|			И ВТ_КлючиАналитикиПартнера_ЧтоЗаменять.Договор = ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять.Договор
		|			И ВТ_КлючиАналитикиПартнера_ЧтоЗаменять.НаправлениеДеятельности = ВТ_КлючиАналитикиПартнера_НаЧтоЗаменять.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("КонтрагентЧтоЗаменять", КонтрагентЧтоЗаменять);
	Запрос.УстановитьПараметр("ПартнерЧтоЗаменять", ПартнерЧтоЗаменять);
	Запрос.УстановитьПараметр("КонтрагентНаЧтоЗаменять", КонтрагентНаЧтоЗаменять);
	Запрос.УстановитьПараметр("ПартнерНаЧтоЗаменять", ПартнерНаЧтоЗаменять);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НовСтр = ЗаменяемыеЗначения.Добавить();
		НовСтр.ЧтоЗаменять 		= ВыборкаДетальныеЗаписи.СсылкаКлючАналитикиЧтоЗаменять;
		НовСтр.НаЧтоЗаменять 	= ВыборкаДетальныеЗаписи.СсылкаКлючАналитикиНаЧтоЗаменять;
		НовСтр.Пометка 			= Истина; 
		
		Добавлено = Добавлено + 1;
	
	КонецЦикла;
	
	Возврат Добавлено;
	
КонецФункции // ДобавитьПартнеры()

Функция ДобавитьПартнеры(КонтрагентЧтоЗаменять, КонтрагентНаЧтоЗаменять) 
	
	Добавлено = 0;
	
	ПартнерЧтоЗаменять = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(КонтрагентЧтоЗаменять, "Партнер");
	ПартнерНаЧтоЗаменять = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(КонтрагентНаЧтоЗаменять, "Партнер");
	
	//НАЧАЛО Ведутенко С.А. 11.07.2023 Выполнение задач №000046155
	
	//Если Не ЗначениеЗаполнено(ПартнерЧтоЗаменять)
	//	И Не ЗначениеЗаполнено(ПартнерНаЧтоЗаменять) Тогда
		
	Если Не ЗначениеЗаполнено(ПартнерЧтоЗаменять)
		Или ПартнерЧтоЗаменять = ПартнерНаЧтоЗаменять Тогда
	
	//КОНЕЦ  Ведутенко С.А. 11.07.2023 Выполнение задач №000046155 
		
		Возврат Добавлено;
		
	КонецЕсли;   
	
	Добавлено = ДобавитьКлючиАналитикиУчетаПартнера(КонтрагентЧтоЗаменять, ПартнерЧтоЗаменять, КонтрагентНаЧтоЗаменять, ПартнерНаЧтоЗаменять);
	
	НовСтр = ЗаменяемыеЗначения.Добавить();
	НовСтр.ЧтоЗаменять 		= ПартнерЧтоЗаменять;
	НовСтр.НаЧтоЗаменять 	= ПартнерНаЧтоЗаменять;
	НовСтр.Пометка 			= Истина; 
	
	Добавлено = Добавлено + 1;
		
	Возврат Добавлено;
	
КонецФункции // ДобавитьПартнеры()

#КонецОбласти

