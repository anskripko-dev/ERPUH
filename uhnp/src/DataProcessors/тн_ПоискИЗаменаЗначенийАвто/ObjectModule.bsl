Процедура ЗаписатьДанные(Данные, СтруктураЛога)
				
	Если Не УдалятьРегистрациюИзменений Тогда  		                         		
		
		Попытка
			//НАЧАЛО Качикина 31.01.2025 Выполнение задач №000052341
			//НАЧАЛО Сафиуллина З.Р. 05.02.2025 Выполнение задач №000052506
			//Если ТипЗнч(Данные)=Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда
			Если ТипЗнч(Данные) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") 
				ИЛИ ТипЗнч(Данные) = Тип("ДокументОбъект.ВнутреннееПотребление") 
				ИЛИ ТипЗнч(Данные) = Тип("ДокументОбъект.АвансовыйОтчет") Тогда
            //КОНЕЦ Сафиуллина З.Р. 05.02.2025 Выполнение задач №000052506
				Данные.ДополнительныеСвойства.Вставить("ОтключитьВсеПроверки",Истина);
			КонецЕсли;
			//КОНЕЦ Качикина 31.01.2025 Выполнение задач №000052341 
			//НАЧАЛО Сафиуллина З.Р. 06.02.2025 Выполнение задач №000052563
			Если ТипЗнч(Данные) = Тип("РегистрБухгалтерииНаборЗаписей.МСФО") Тогда
				Данные.ДополнительныеСвойства.Вставить("ПропуститьПроверкуРучныхКорректировок", Истина);
			КонецЕсли;
            //КОНЕЦ Сафиуллина З.Р. 06.02.2025 Выполнение задач №000052563
			Данные.Записать();
			
		Исключение
			СтруктураЛога.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());				
			ЗаписатьОшибку(СтруктураЛога);
			Если Не ВыполнятьЗаменыБезТранзакции Тогда
				ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
		
		Возврат;  		
	КонецЕсли;
	
	// НАЧАЛО Луконин Е.А. 27.03.2025 Выполнение задач №000053183
	Данные.ОбменДанными.Получатели.Автозаполнение = Ложь;
	Данные.ОбменДанными.Получатели.Очистить();
	// КОНЕЦ Луконин Е.А. 27.03.2025 Выполнение задач №000053183
	
	ТЗУдалениеРегистрации = Новый ТаблицаЗначений;
	ТЗУдалениеРегистрации.Колонки.Добавить("Ссылка");
	
	МетаданныеОбъекта = Данные.Метаданные();
		
	Для Каждого ПланОбмена Из Метаданные.ПланыОбмена Цикл
		
		Если Не ПланОбмена.Состав.Содержит(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПланаОбмена = ПланОбмена.Имя;
		МенеджерПланаОбмена = ПланыОбмена[ИмяПланаОбмена];
		ВыборкаПланаОбмена = МенеджерПланаОбмена.Выбрать();
		
		Пока ВыборкаПланаОбмена.Следующий() Цикл
			
			Если ВыборкаПланаОбмена.Ссылка <> МенеджерПланаОбмена.ЭтотУзел() Тогда
				
				Если Не ПланыОбмена.ИзменениеЗарегистрировано(ВыборкаПланаОбмена.Ссылка, Данные) Тогда
					СтрокаТЗУ = ТЗУдалениеРегистрации.Добавить();
					СтрокаТЗУ.Ссылка = ВыборкаПланаОбмена.Ссылка;
				КонецЕсли;  
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Попытка
		
		//НАЧАЛО Сафиуллина З.Р. 05.02.2025 Выполнение задач №000052506
		Если ТипЗнч(Данные) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") 
			ИЛИ ТипЗнч(Данные) = Тип("ДокументОбъект.ВнутреннееПотребление") 
			ИЛИ ТипЗнч(Данные) = Тип("ДокументОбъект.АвансовыйОтчет") Тогда
			Данные.ДополнительныеСвойства.Вставить("ОтключитьВсеПроверки", Истина);
		КонецЕсли;
        //КОНЕЦ Сафиуллина З.Р. 05.02.2025 Выполнение задач №000052506
		//НАЧАЛО Сафиуллина З.Р. 06.02.2025 Выполнение задач №000052563
		Если ТипЗнч(Данные) = Тип("РегистрБухгалтерииНаборЗаписей.МСФО") Тогда
			Данные.ДополнительныеСвойства.Вставить("ПропуститьПроверкуРучныхКорректировок", Истина);
		КонецЕсли;
        //КОНЕЦ Сафиуллина З.Р. 06.02.2025 Выполнение задач №000052563
			
		Данные.Записать();
		
	Исключение
		СтруктураЛога.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());				
		ЗаписатьОшибку(СтруктураЛога);
		Если Не ВыполнятьЗаменыБезТранзакции Тогда
			ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	
	Для Каждого СтрочкаУзел Из ТЗУдалениеРегистрации Цикл
		Попытка
			ПланыОбмена.УдалитьРегистрациюИзменений(СтрочкаУзел.Ссылка, Данные);	
		Исключение
		КонецПопытки;
	КонецЦикла;
		
КонецПроцедуры // ЗаписатьДанные()

Процедура ЗаписатьОшибку(СтруктураЛога)
	
	РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.ЗаписатьОшибку(СтруктураЛога.ЧтоЗаменять, СтруктураЛога.НаЧтоЗаменять, СтруктураЛога.Данные, СтруктураЛога.ОписаниеОшибки);
	
	Если мМассивОбъектовСОшибкой.Найти(СтруктураЛога.ЧтоЗаменять) = Неопределено Тогда
		
		мМассивОбъектовСОшибкой.Добавить(СтруктураЛога.ЧтоЗаменять);
		
		МЗ = РегистрыСведений.тн_ЗаменяемыеОбъекты.СоздатьМенеджерЗаписи();
		МЗ.Объект = СтруктураЛога.ЧтоЗаменять;
		
		МЗ.Прочитать();
		
		Если МЗ.Выбран() Тогда
			
			МЗ.Ошибка = Истина;
			МЗ.Записать();
			
		КонецЕсли;
		
	КонецЕсли;		
	
КонецПроцедуры // ЗаписатьОшибку()

Функция ПолучитьСтруктуруЛога()
	
	Возврат Новый Структура("ЧтоЗаменять, НаЧтоЗаменять, Данные, ОписаниеОшибки");
	
КонецФункции // ПолучитьСтруктуруЛога()

Функция ЕстьОшибкиВРегистре(ЧтоЗаменять)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	РегистрСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений КАК ОшибкиАвтоматическогоПоискаИЗаменыЗначений
		|ГДЕ
		|	ОшибкиАвтоматическогоПоискаИЗаменыЗначений.ЧтоЗаменять = &ЧтоЗаменять";
	
	Запрос.УстановитьПараметр("ЧтоЗаменять", ЧтоЗаменять);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции // ЕстьОшибкиВРегистре()

Функция УдалитьБезЗамены(ЧтоЗаменять, ИмяМетаданных)
	
	Если ТипЗнч(ЧтоЗаменять) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если ИмяМетаданных = "РегистрСведений.ПринадлежностьККомпанииДляМСФО"
			Или ИмяМетаданных = "РегистрСведений.ХранениеИерархииСправочникаКонтрагенты" Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЧтоЗаменять) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		Если ИмяМетаданных = "РегистрСведений.ХранениеИерархииСправочникаНоменклатура" Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;		
	
КонецФункции // УдалитьБезЗамены()

