
&НаКлиенте
Процедура ЗапросыНалоговогоМониторингаПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ТекстОтвета = ПолучитьТекстОтвета(Элемент.ТекущиеДанные.Ответ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОтветыНаЗапросы, "Основание", Элемент.ТекущиеДанные.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстОтвета(Ответ)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ответ, "Ответ");
КонецФункции

&НаКлиенте
Процедура БезОтвета(Команда)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыНалоговогоМониторинга, "Ответ", Неопределено, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	УстановитьПометки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Все(Команда)
	ЗапросыНалоговогоМониторинга.Отбор.Элементы.Очистить();
	УстановитьПометки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(НачальноеЗначение)
	Элементы.ЗапросыНалоговогоМониторингаВсе.Пометка = НачальноеЗначение;
	Элементы.ЗапросыНалоговогоМониторингаБезОтвета.Пометка = НЕ НачальноеЗначение;
	Элементы.ЗапросыНалоговогоМониторингаБезОтвета.Заголовок = СтрШаблон("Без ответа (%1)", ПолучитьКоличествоЭлементов());
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЭлементов()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗапросДанныхНалоговогоМониторинга.Ссылка) КАК Ссылка
		|ИЗ
		|	Документ.ЗапросДанныхНалоговогоМониторинга КАК ЗапросДанныхНалоговогоМониторинга
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтветНаЗапросНалоговогоМониторинга КАК ОтветНаЗапросНалоговогоМониторинга
		|		ПО ЗапросДанныхНалоговогоМониторинга.Ссылка = ОтветНаЗапросНалоговогоМониторинга.Основание
		|ГДЕ
		|	ОтветНаЗапросНалоговогоМониторинга.Ссылка ЕСТЬ NULL
		|	И ЗапросДанныхНалоговогоМониторинга.Проведен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьПометки(Истина);
	Элементы.ЗапросыНалоговогоМониторингаРегламентированныеОтчеты.Пометка = ПанельОтчетов;
КонецПроцедуры

&НаКлиенте
Процедура УведомленияНМПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("ВидыПрочихУведомлений", НалоговыйМониторингВызовСервера.МассивУведомленийНалоговогоМониторинга());
	ПараметрыФормы.Вставить("Создание_УведомлениеОСпецрежимахНалогообложения", Истина);
	ПараметрыФормы.Вставить("УчитыватьУведомленияНеВходящиеВБРО", Истина);
	
	ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.Форма.ФормаВыбораВидаСообщения", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНМ(Команда)
	ПоказатьВводЗначения(Новый ОписаниеОповещения("ОрганизацияНМЗавершение", ЭтотОбъект, Новый Структура("Организация", Организация)), Организация, "Организация налогового мониторинга", Тип("СправочникСсылка.Организации"));
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНМЗавершение(Значение, ДополнительныеПараметры) Экспорт
	Если Значение <> Неопределено Тогда
		Организация = Значение;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(УведомленияНМ, "Организация", Организация, ВидСравненияКомпоновкиДанных.Равно);
		УстановитьКонстанту(Организация);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьКонстанту(Организация)
	Если ПравоДоступа("Изменение", Метаданные.Константы.ОрганизацияНалоговогоМониторинга) Тогда
		Константы.ОрганизацияНалоговогоМониторинга.Установить(Организация);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Организация = Константы.ОрганизацияНалоговогоМониторинга.Получить();
	Если ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(УведомленияНМ, "Организация", Организация, ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;
КонецПроцедуры
