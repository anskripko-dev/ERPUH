&НаСервере
Процедура ЗаполнитьПараметрыКонтроляПоВидуБюджета()
	
	ПараметрыКонтроляПоВидуБюджета = ПолучитьКонтрольПоВидуБюджета();    
	
	ПланированиеЗакупокДействует = ПараметрыКонтроляПоВидуБюджета.Период;
	КонтролироватьПоВидуБюджета = ПараметрыКонтроляПоВидуБюджета.ВидБюджета;     

	ВидыБюджетаПредставление = РегистрыСведений.ПараметрыЛимитирования.ПолучитьВидыБюджетаПредставление();  	

	ШаблонСообщения = НСтр("ru = 'Контроль по виду бюджета: %1,'");	
	ТекстСообщения = СтрШаблон(ШаблонСообщения, ВидыБюджетаПредставление.Получить(КонтролироватьПоВидуБюджета)); 
	Элементы.КонтрольПоВидуБюджета.Заголовок = ТекстСообщения;
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучитьКонтрольПоВидуБюджета()
	
	ВидыБюджета = Новый Массив;  
	ВидыБюджета.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	ВидыБюджета.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	
	Запрос = Новый Запрос;     
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("ВидыБюджета", ВидыБюджета);

	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитированияСрезПоследних.Период КАК Период,
	|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(&Дата, ВидБюджета В (&ВидыБюджета)) КАК ПараметрыЛимитированияСрезПоследних
	|ГДЕ
	|	ПараметрыЛимитированияСрезПоследних.ПланированиеЗакупок
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПараметрыЛимитированияСрезПоследних.Период КАК Период,
		|	ПараметрыЛимитированияСрезПоследних.ВидБюджета КАК ВидБюджета
		|ПОМЕСТИТЬ ВТ_ПланированиеЗакупок
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования.СрезПоследних(
		|			&Дата,
		|			ПланированиеЗакупок
		|				И ВидБюджета В (&ВидыБюджета)) КАК ПараметрыЛимитированияСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ПараметрыЛимитирования.Период) КАК Период,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка) КАК ВидБюджета
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПланированиеЗакупок КАК ВТ_ПланированиеЗакупок
		|		ПО ПараметрыЛимитирования.Период > ВТ_ПланированиеЗакупок.Период
		|			И ПараметрыЛимитирования.ВидБюджета = ВТ_ПланированиеЗакупок.ВидБюджета
		|ГДЕ
		|	НЕ ПараметрыЛимитирования.ПланированиеЗакупок";
		
		РезультатЗапроса = Запрос.Выполнить();    
		
	КонецЕсли;
	
	ПараметрыКонтроля = РезультатЗапроса.Выбрать();
	ПараметрыКонтроля.Следующий();  

	Если Не ЗначениеЗаполнено(ПараметрыКонтроля.Период) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПараметрыЛимитирования.Период КАК Период,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка) КАК ВидБюджета
		|ИЗ
		|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
		|ГДЕ
		|	ПараметрыЛимитирования.ВидБюджета В(&ВидыБюджета)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ПараметрыКонтроля = РезультатЗапроса.Выбрать();
		ПараметрыКонтроля.Следующий();
		
	КонецЕсли;
	
	ПараметрыКонтроля = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ПараметрыКонтроля);         
	
	ТаблицаИстория = РегистрыСведений.ПараметрыЛимитирования.ПолучитьИсториюИзмененийПланированиеЗакупок();
	ВидыБюджетаПредставление = РегистрыСведений.ПараметрыЛимитирования.ПолучитьВидыБюджетаПредставление();
	
	Если Не ТаблицаИстория.Количество() = 0 Тогда
		
		АктуальнаяЗапись = ТаблицаИстория[ТаблицаИстория.Количество()-1];
		
		ТекущееПредставление = ВидыБюджетаПредставление.Получить(ПараметрыКонтроля.ВидБюджета);  
		
		Если АктуальнаяЗапись.ВидБюджетаПредставление = ТекущееПредставление Тогда
			ПараметрыКонтроля.Период = АктуальнаяЗапись.ДатаНачала;	
		КонецЕсли;
		
	КонецЕсли;  
	
	Возврат ПараметрыКонтроля;
	
КонецФункции  

&НаКлиенте
Процедура ПланированиеЗакупокИсторияИзмененийНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;   		
	ПараметрыФормы.Вставить("Действует",  ПланированиеЗакупокДействует);   
	ПараметрыФормы.Вставить("ВидБюджета", КонтролироватьПоВидуБюджета);
	
	ОткрытьФорму("РегистрСведений.ПараметрыЛимитирования.Форма.ИсторияИзменений", 
				 ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойСценарийТоварногоПланированияНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;  
	
	Если НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'Необходимо заполнить валюту учета закупок'"),, "НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок");
	КонецЕсли;
	Если НаборКонстант.ПериодичностьЦентрализованныхЗакупок.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'Необходимо заполнить периодичность закупок'"),, "НаборКонстант.ПериодичностьЦентрализованныхЗакупок");
	КонецЕсли;       
	Если НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок.Пустая() Или НаборКонстант.ПериодичностьЦентрализованныхЗакупок.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если СценарииТоварногоПланированияСуществуют Тогда      
		
		ОткрытьФорму("Справочник.СценарииТоварногоПланирования.Форма.ФормаСписка",
						Новый Структура("Отбор", Новый Структура("ФормированиеПотребностейПланомЗакупок, ПланЗакупокПланироватьПоСумме, Валюта, Периодичность", 
																	Истина, Истина, 
																	НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок,
																	НаборКонстант.ПериодичностьЦентрализованныхЗакупок)), 
						Новый ОписаниеОповещения("ОсновнойСценарийТоварногоПланированияНажатиеЗавершение", ЭтотОбъект), );   
						
	Иначе
		
		ОткрытьФорму("Справочник.СценарииТоварногоПланирования.Форма.ФормаЭлемента", 
						Новый Структура("ДанныеЗаполнения", Новый Структура("ЭтоПотребности, Валюта, Периодичность, Наименование, ИспользоватьДляПланированияМатериалов,ФормированиеПотребностейПланомЗакупок",
										Истина,                                                   	//ЭтоПотребности
										НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок,        	//Валюта
										НаборКонстант.ПериодичностьЦентрализованныхЗакупок,         //Периодичность
										Нстр("ru = 'Корпоративные закупки '") + "(" + Строка(НаборКонстант.ВалютаУчетаЦентрализованныхЗакупок)+"), "+ Строка(НаборКонстант.ПериодичностьЦентрализованныхЗакупок),	//Наименование
										Истина,                                                    	//ИспользоватьДляПланированияМатериалов
										Истина)),,,,, 	//ФормированиеПотребностейПланомЗакупок
						Новый ОписаниеОповещения("ОсновнойСценарийТоварногоПланированияНажатиеЗавершение", ЭтотОбъект), );   
						
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойСценарийТоварногоПланированияНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьОсновнойСценарийПланирования();	

КонецПроцедуры

#КонецОбласти