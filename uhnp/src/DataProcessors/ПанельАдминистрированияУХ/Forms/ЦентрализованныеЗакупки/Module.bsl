#Область КонтролиНастроек

&НаСервере
Функция ЗапуститьФоновоеЗадание(ИмяЗадания, ИмяМетода, ПараметрыПроцедуры)
	
	ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
	ПараметрыВыполненияВФоне.ОжидатьЗавершение = 0;
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(ИмяМетода, ПараметрыПроцедуры, ПараметрыВыполненияВФоне);
	
	Контроли = ОписаниеКонтролей.НайтиСтроки(Новый Структура("ИмяКонтроля", ИмяЗадания)); 
	Если Контроли.Количество() = 0 Тогда
		Контроль = ОписаниеКонтролей.Добавить();
	Иначе
		Контроль = Контроли[0];      
	КонецЕсли;                
	
	ЗаполнитьЗначенияСвойств(Контроль, ДлительнаяОперация);
	Контроль.ИмяКонтроля = ИмяМетода;       
	
	Возврат ДлительнаяОперация;
	
КонецФункции    

&НаКлиенте
Процедура ВыполнитьКонтрольНачало(ИмяЗадания, ИмяМетода, ПараметрыПроцедуры)
	ДлительнаяОперация = ЗапуститьФоновоеЗадание(ИмяЗадания, ИмяМетода, ПараметрыПроцедуры);        
	ПодключитьОбработчикОжидания("ПроверкаРезультатаКонтроля", 10, Истина);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);  
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;       
	ПараметрыОжидания.ПолучатьРезультат = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьКонтрольЗавершение", ЭтотОбъект, Новый Структура("ИмяСвойства", ИмяЗадания));
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);      
	ЭтотОбъект[ОповещениеОЗавершении.ДополнительныеПараметры.ИмяСвойства] = 4;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКонтрольЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;       
	Если Результат Тогда
		ЭтотОбъект[ДополнительныеПараметры.ИмяСвойства] = 1;
	Иначе
		ЭтотОбъект[ДополнительныеПараметры.ИмяСвойства] = 3;
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ПроверкаРезультатаКонтроля()
	
	Выполнены = Истина;  
		
	ТекущиеДлительныеОперации = ПараметрыПриложения["СтандартныеПодсистемы.АктивныеДлительныеОперации"];    
	Если ТекущиеДлительныеОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Контроль Из ЭтотОбъект.ОписаниеКонтролей Цикл
		Если Контроль.Статус = "Выполняется" Тогда
			Свойства = ТекущиеДлительныеОперации.Список.Получить(Контроль.ИдентификаторЗадания); 
			Результат = ПолучитьИзВременногоХранилища(Свойства.АдресРезультата);      
			Если Результат = Неопределено Тогда
				Выполнены = Ложь;
			Иначе
				Контроль.Статус = "Выполнено";
				ВыполнитьОбработкуОповещения(Свойства.ОповещениеОЗавершении, Результат);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Выполнены Тогда
		ПодключитьОбработчикОжидания("ПроверкаРезультатаКонтроля", 10, Истина);
	КонецЕсли;
КонецПроцедуры
	
#КонецОбласти   

&НаСервере
Процедура ОбновитьОсновнойСценарийПланирования()
	
	ПараметрыОсновнойСценарийТоварногоПланирования = Обработки.ПанельАдминистрированияУХ.СценарииТовароногоПланирования(); 
	СценарииТоварногоПланированияСуществуют = ПараметрыОсновнойСценарийТоварногоПланирования.Количество() > 0;
	Если Не СценарииТоварногоПланированияСуществуют Тогда
		ОсновнойСценарийТоварногоПланированияТекст = Нстр("ru = '<Создать>'"); 
		Элементы.ДекорацияСтатусСценария.Подсказка = "";
		Элементы.ДекорацияСтатусСценария.Видимость = Ложь;
	Иначе
		ОсновнойСценарийТоварногоПланированияТекст = Строка(Нстр("ru = 'Используемые сценарии'"));  
		Элементы.ДекорацияСтатусСценария.Подсказка = "";	
		Элементы.ДекорацияСтатусСценария.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьВидОперацииПоступленияПоВидуНоменклатуры()
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНоменклатуры.Ссылка КАК НоменклатураВидНоменклатуры
	               |ПОМЕСТИТЬ НоменклатураПоступлений
	               |ИЗ
	               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВидыНоменклатуры.Ссылка;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураПоступлений.НоменклатураВидНоменклатуры КАК НоменклатураВидНоменклатуры
	               |ИЗ
	               |	НоменклатураПоступлений КАК НоменклатураПоступлений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыОперацийПоступленияПоВидамНоменклатуры КАК ВидыОперацийПоступленияПоВидамНоменклатуры
	               |		ПО НоменклатураПоступлений.НоменклатураВидНоменклатуры = ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры
	               |ГДЕ
	               |	(ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры ЕСТЬ NULL)
				   //|			ИЛИ ВидыОперацийПоступленияПоВидамНоменклатуры.ВидОперацииПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеТоваровУслуг.ПустаяСсылка))
	               |
	               |СГРУППИРОВАТЬ ПО
