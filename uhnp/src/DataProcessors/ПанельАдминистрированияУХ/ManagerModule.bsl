#Область СлужебныйПрограммныйИнтерфейс
Процедура КонтрольНаличияСценариевТоварногоПланирования(Параметры, АдресРезультата) Экспорт    
	
	Результат = СценарииТовароногоПланирования();
		
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

Функция СценарииТовароногоПланирования() Экспорт
	
	Перем Валюта, Запрос, Периодичность, Результат;
	
	Валюта 			= Константы.ВалютаУчетаЦентрализованныхЗакупок.Получить();
	ПустаяВалюта 	= Справочники.Валюты.ПустаяСсылка();
	Периодичность 	= Константы.ПериодичностьЦентрализованныхЗакупок.Получить();  
	ПустаяПериодичность = Перечисления.Периодичность.ПустаяСсылка(); 
	
	Если Валюта.Пустая() Или Периодичность.Пустая() Тогда
		Возврат Новый Массив;
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СценарииТоварногоПланирования.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА СценарииТоварногоПланирования.Периодичность <> &Периодичность
		|				ИЛИ СценарииТоварногоПланирования.ПланЗакупокПланироватьПоСумме = ЛОЖЬ
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьОшибка
		|ИЗ
		|	Справочник.СценарииТоварногоПланирования КАК СценарииТоварногоПланирования
		|ГДЕ
		|	СценарииТоварногоПланирования.Валюта = &Валюта
		|	И НЕ СценарииТоварногоПланирования.ПометкаУдаления
		|	И СценарииТоварногоПланирования.ФормированиеПотребностейПланомЗакупок
		|	И СценарииТоварногоПланирования.Периодичность = &Периодичность
		|	И СценарииТоварногоПланирования.Валюта <> &ПустаяВалюта
		|	И СценарииТоварногоПланирования.Периодичность <> &ПустаяПериодичность
		|	И СценарииТоварногоПланирования.ПланЗакупокПланироватьПоСумме";
		
		Запрос.УстановитьПараметр("Валюта", 			 Валюта);
		Запрос.УстановитьПараметр("Периодичность", 		 Периодичность);  
		Запрос.УстановитьПараметр("ПустаяВалюта", 		 ПустаяВалюта);
		Запрос.УстановитьПараметр("ПустаяПериодичность", ПустаяПериодичность);
		
		Результат = Запрос.Выполнить(); 
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;

КонецФункции

#КонецОбласти