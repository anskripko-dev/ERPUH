&НаСервере
Процедура ОтобратьНаСервере()
	
	СтатьиРасходов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВариантРаспределенияРасходовРегл", ВариантРаспределенияРасходовРегл);
	Запрос.УстановитьПараметр("ВариантРаспределенияРасходовУпр", ВариантРаспределенияРасходовУпр);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтатьиРасходов.Ссылка КАК СтатьяРасходов
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов
	|ГДЕ
	|	СтатьиРасходов.ВариантРаспределенияРасходовРегл = &ВариантРаспределенияРасходовРегл
	|	И СтатьиРасходов.ВариантРаспределенияРасходовУпр = &ВариантРаспределенияРасходовУпр
	|	И Не СтатьиРасходов.ПометкаУдаления";
	УстановитьПривилегированныйРежим(Истина);
	СтатьиРасходов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравилаПоУмолчаниюНаСервере()
	
	ПравилаРаспределения.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсобенныеПодразделения", ОсобенныеПодразделения.Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсобенныеПодразделения.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ втОсобенныеПодразделения
	|ИЗ
	|	&ОсобенныеПодразделения КАК ОсобенныеПодразделения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка КАК Подразделение,
	|	ВЫБОР
	|		КОГДА втОсобенныеПодразделения.Подразделение ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоОсобенноеПодразделение
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОсобенныеПодразделения КАК втОсобенныеПодразделения
	|		ПО СтруктураПредприятия.Ссылка = втОсобенныеПодразделения.Подразделение
	|ГДЕ
	|	НЕ СтруктураПредприятия.ПометкаУдаления";
	УстановитьПривилегированныйРежим(Истина);
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаПравил = ПравилаРаспределения.Добавить();
		СтрокаПравил.Организация = Организация;
		СтрокаПравил.Подразделение = Выборка.Подразделение;
		
		Если Выборка.ЭтоОсобенноеПодразделение Тогда
			
			СтрокаПравил.НастройкаУпр = НастройкаУпрОсобенныеПодразделения;
			СтрокаПравил.НастройкаРегл = НастройкаРеглОсобенныеПодразделения;
			
		Иначе
			
			СтрокаПравил.НастройкаУпр = НастройкаУпрОстальныеПодразделения;
			СтрокаПравил.НастройкаРегл = НастройкаРеглОстальныеПодразделения;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПравилаРаспределенияДляСтатейНаСервере()
	
	Для каждого СтрокаСтатей из СтатьиРасходов Цикл
		Для каждого СтрокаПравил из ПравилаРаспределения Цикл
			
			Запись = РегистрыСведений.НастройкиРаспределенияПостатейныхРасходов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаСтатей); //СтатьяРасходов
			ЗаполнитьЗначенияСвойств(Запись, СтрокаПравил); //Организация, Подразделением, НастройкаУпр, НастройкаРегл
			
			Запись.Записать(Истина);
			
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти
