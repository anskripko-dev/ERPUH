#Область КомандыФормы

&НаКлиенте
Процедура Отобрать(Команда)
	
	Если Не ЗначениеЗаполнено(ВариантРаспределенияРасходовРегл) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен Вариант распределения расходов (регл.)", , "ВариантРаспределенияРасходовРегл",);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВариантРаспределенияРасходовУпр) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Вариант распределения расходов (упр.)", , "ВариантРаспределенияРасходовУпр",);
		Возврат;
	КонецЕсли;
		
	ОтобратьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПравилаПоУмолчанию(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена Организация", , "Организация",);
		Возврат;
	КонецЕсли;

	ЗаполнитьПравилаПоУмолчаниюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПравилаРаспределенияДляСтатей(Команда)
	
	//Проверка заполненности обязательных полей
	Если СтатьиРасходов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнены Статьи расходов", , "СтатьиРасходов",);
		Возврат;
	КонецЕсли;
	Для каждого СтрокаСтатей из СтатьиРасходов Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСтатей.СтатьяРасходов) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("В таблице статей расхода есть строки с незаполненной Статьей", , "СтатьиРасходов",);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;

	Если ПравилаРаспределения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнены Правила распределения", , "ПравилаРаспределения",);
		Возврат;
	КонецЕсли;
	Для каждого СтрокаПравил из ПравилаРаспределения Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПравил.Организация) Или Не ЗначениеЗаполнено(СтрокаПравил.Подразделение) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("В правилах распределения есть строки с незаполненной Организацией или Подразделением", , "ПравилаРаспределения",);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьПравилаРаспределенияДляСтатейНаСервере();
	
	ПоказатьПредупреждение(,"Запись выполнена");
	
КонецПроцедуры

#КонецОбласти

