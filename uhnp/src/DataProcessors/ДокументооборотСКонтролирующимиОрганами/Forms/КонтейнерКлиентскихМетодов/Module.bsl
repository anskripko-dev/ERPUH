&НаКлиенте
Процедура ОсуществитьОбменПоОрганизацииМЧДРР(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 					= ДополнительныеПараметры.Форма;
	Организация 			= ДополнительныеПараметры.Организация;
	ВыполняемоеОповещение	= ДополнительныеПараметры.ВыполняемоеОповещение;
	КонтролирующийОрган 	= ДополнительныеПараметры.КонтролирующийОрган;
	ОписаниеОповещения 		= Новый ОписаниеОповещения("ОсуществитьОбменПоРегистрацииЮЛ", ЭтотОбъект, ДополнительныеПараметры);
	
	Если КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "ЦПРР" Тогда
		Отправки = ПолучитьНезавершенныеОтправкиМЧДРР(Организация);
		ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизации(Форма, Организация, Отправки, 0, ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизации(
		Форма,
		Организация,
		Отправки,
		НомерОбъекта,
		ВыполняемоеОповещение)
	
	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииМЧДРР",
			"ЦПРР",
			Отправка.Ссылка);
		
		ДополнительныеПараметры = Новый Структура("Форма, Организация, Отправки, НомерОбъекта, ВыполняемоеОповещение",
			Форма, Организация, Отправки, НомерОбъекта, ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизацииЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка.Ссылка) Тогда
			Если Отправка.РежимыИспользования = "ФТС" Тогда
				ОбновитьМашиночитаемуюДоверенностьФТС(
					ОписаниеОповещения,
					Организация,,,
					Отправка.Ссылка);
					
			Иначе
				ДокументооборотСКОКлиент.ОбновитьСостояниеМЧДРР(ОписаниеОповещения, Отправка.Ссылка);
			КонецЕсли;
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизацииЗавершение(
		Результат,
		ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.НомерОбъекта % 10 = 0 Тогда
		// для предотвращения переполнения стека
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
			"БРО.ВходящийКонтекстОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРР");
		ПодключитьОбработчикОжидания("Подключаемый_СбросСтекаОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРР",
			0.1, Истина);
		
	Иначе
		ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизации(
			ДополнительныеПараметры.Форма,
			ДополнительныеПараметры.Организация,
			ДополнительныеПараметры.Отправки,
			ДополнительныеПараметры.НомерОбъекта + 1,
			ДополнительныеПараметры.ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СбросСтекаОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРР() Экспорт
	
	ДополнительныеПараметры = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ВходящийКонтекстОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРР");
	
	ОбновитьРезультатНезавершенныхПоследнихОтправокМЧДРРПоОрганизации(
		ДополнительныеПараметры.Форма,
		ДополнительныеПараметры.Организация,
		ДополнительныеПараметры.Отправки,
		ДополнительныеПараметры.НомерОбъекта + 1,
		ДополнительныеПараметры.ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНезавершенныеОтправкиМЧДРР(Организация) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	МашиночитаемыеДоверенностиРаспределенныйРеестр.Ссылка КАК Ссылка,
		|	МашиночитаемыеДоверенностиРаспределенныйРеестр.РежимыИспользования КАК РежимыИспользования
		|ИЗ
		|	Справочник.МашиночитаемыеДоверенностиРаспределенныйРеестр КАК МашиночитаемыеДоверенностиРаспределенныйРеестр
		|ГДЕ
		|	НЕ МашиночитаемыеДоверенностиРаспределенныйРеестр.ПометкаУдаления
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Организация = &Организация
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.ВРаботе)
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.ОтказВРегистрации)
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.ОшибкаРегистрации)
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.ИстекСрокДействия)
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.Зарегистрировано)
		|	И МашиночитаемыеДоверенностиРаспределенныйРеестр.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМашиночитаемойДоверенностиКО.Отозвано)
		|УПОРЯДОЧИТЬ ПО
		|	МашиночитаемыеДоверенностиРаспределенныйРеестр.РежимыИспользования");
	
	Запрос.Параметры.Вставить("Организация", Организация);
	
	ТаблицаОтправок = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаТаблицы Из ТаблицаОтправок Цикл
		СтрокаРезультата = Новый Структура;
		СтрокаРезультата.Вставить("Ссылка", 				СтрокаТаблицы.Ссылка);
		СтрокаРезультата.Вставить("РежимыИспользования", 	СтрокаТаблицы.РежимыИспользования);
		Результат.Добавить(СтрокаРезультата);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкаРоссии(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	Если ДополнительныеПараметры.Свойство("ОтчетСсылка") Тогда
		ОтчетаСсылка = ДополнительныеПараметры.ОтчетСсылка;
	Иначе
		ОтчетСсылка = ДополнительныеПараметры.СсылкаНаОтчет;
	КонецЕсли;
	ОрганизацияОтчета = ДополнительныеПараметры.ОрганизацияОтчета;
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетаСсылка);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
		Иначе
			// отправляем только из записанной формы
			Если Форма.Модифицированность Тогда
				ДополнительныеПараметры = Новый Структура("ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет", ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкаРоссии", ЭтотОбъект, ДополнительныеПараметры);
				Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			Иначе
				ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляБанкРоссииРегламентированныйОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность, ЭтоРегламентированныйОтчет)
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаУдалитьЦБСуществует() Тогда
		МодульУдалитьДокументооборотСБанкомРоссииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УдалитьДокументооборотСБанкомРоссииКлиент");
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			МодульУдалитьДокументооборотСБанкомРоссииКлиент.ОтправитьОтчет(ОрганизацияОтчета, ОтчетСсылка, Форма);
		Иначе
			МодульУдалитьДокументооборотСБанкомРоссииКлиент.ОтправитьОтчет(
				Форма.СтруктураРеквизитовФормы.Организация,
				Форма.СтруктураРеквизитовФормы.мСохраненныйДок, Форма);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РегистрацияЮЛ

&НаКлиенте
Процедура ОсуществитьОбменПоРегистрацииЮЛ(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 					= ДополнительныеПараметры.Форма;
	Организация 			= ДополнительныеПараметры.Организация;
	ВыполняемоеОповещение	= ДополнительныеПараметры.ВыполняемоеОповещение;
	КонтролирующийОрган 	= ДополнительныеПараметры.КонтролирующийОрган;
	СсылкаЗаявления			= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	
	Права = ДополнительныеПараметры.Права;
	ЕстьДоступ = Права.ЭтоМультиРежим И Права.СдаватьВФНС ИЛИ НЕ Права.ЭтоМультиРежим;
	
	Если ЕстьДоступ И (КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "РегистрацияЮЛФНС")
		И ОбщегоНазначенияКлиент.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ГосударственнаяРегистрацияВФНС") Тогда
		МодульДокументооборотРегистрацияВФНССлужебныйКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотРегистрацияВФНССлужебныйКлиент");
		ОповещениеЗавершения = Новый ОписаниеОповещения("ОсуществитьОбменПоРегистрацииЮЛЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(СсылкаЗаявления) Тогда
			МодульДокументооборотРегистрацияВФНССлужебныйКлиент.ОбновитьСостояниеЗаявленияНаРегистрациюЮЛ(ОповещениеЗавершения, СсылкаЗаявления);
		Иначе
			МодульДокументооборотРегистрацияВФНССлужебныйКлиент.ОбновитьСостояниеЗаявленийНаРегистрациюЮЛ(ОповещениеЗавершения, Организация);
		КонецЕсли;
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоРегистрацииЮЛЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	СсылкаЗаявления			= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	ВыполняемоеОповещение	= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка обмена с сервисом ФНС.';
								|en = 'Ошибка обмена с сервисом ФНС.'") + Символы.ПС + Символы.ПС + Результат.Ошибка;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПакетДокументовВФНСЗавершение(РезультатОтправки, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	ОтправкаСсылка = Неопределено;
	Если РезультатОтправки <> Неопределено Тогда
		ОтправкаСсылка = РезультатОтправки.ОтправкаСсылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		Оповестить("Завершение обновления");
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатОтправки);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизации(
		Форма,
		Отправки,
		НомерОбъекта,
		ЭтоВызовИзСписка,
		ВыполняемоеОповещение,
		ОрганизацияПолученияУведомлений = Неопределено)
	
	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		Если ОрганизацияПолученияУведомлений = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
			
		Иначе
			ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
				"ОсуществитьОбменПоОрганизацииРПН",
				ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН"));
			ПолучитьУведомленияРПН(ВыполняемоеОповещение, ОрганизацияПолученияУведомлений);
		КонецЕсли;
		
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииРПН",
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН"),
			Отправка);
			
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", 							Форма);
		ДополнительныеПараметры.Вставить("Отправки", 						Отправки);
		ДополнительныеПараметры.Вставить("НомерОбъекта", 					НомерОбъекта);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка", 				ЭтоВызовИзСписка);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ОрганизацияПолученияУведомлений", ОрганизацияПолученияУведомлений);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка) Тогда
			ОбновитьРезультатКонкретнойОтправкиРПН(Форма, Отправка, ОписаниеОповещения,, ЭтоВызовИзСписка);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 							= ДополнительныеПараметры.Форма;
	Отправки 						= ДополнительныеПараметры.Отправки;
	НомерОбъекта 					= ДополнительныеПараметры.НомерОбъекта;
	ЭтоВызовИзСписка 				= ДополнительныеПараметры.ЭтоВызовИзСписка;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияПолученияУведомлений = ДополнительныеПараметры.ОрганизацияПолученияУведомлений;
	
	ОбновитьРезультатНезавершенныхПоследнихОтправокРПНПоОрганизации(
		Форма,
		Отправки,
		НомерОбъекта + 1,
		ЭтоВызовИзСписка,
		ВыполняемоеОповещение,
		ОрганизацияПолученияУведомлений);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсуществитьОбменПоОрганизацииФТС(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 						= ДополнительныеПараметры.Форма;
	Организация 				= ДополнительныеПараметры.Организация;
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	КонтролирующийОрган 		= ДополнительныеПараметры.КонтролирующийОрган;
	СсылкаНаОтправляемыйОбъект 	= ДополнительныеПараметры.СсылкаНаОтправляемыйОбъект;
	
	Права = ДополнительныеПараметры.Права;
	ЕстьДоступ = Права.ЭтоМультиРежим И Права.ПодатьЗаявкуНаПодключениеФТС ИЛИ НЕ Права.ЭтоМультиРежим;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОсуществитьОбменПоОрганизацииФСРАР", ЭтотОбъект, ДополнительныеПараметры);
	
	// ФТС
	Если ЕстьДоступ И (КонтролирующийОрган = Неопределено ИЛИ КонтролирующийОрган = "ФТС") Тогда
		Если СсылкаНаОтправляемыйОбъект = Неопределено Тогда
			// Выполняем отправку для нескольких ссылок
			Отправки = НезавершенныеПоследниеОтправкиФТСПоОрганизации(Организация);
		Иначе
			// Выполняем отправку только для одной ссылки 
			Отправки = Новый Массив;
			Отправка = ПолучитьПоследнююОтправкуОтчетаВФТС(СсылкаНаОтправляемыйОбъект);
			Если Отправка <> Неопределено Тогда 
				Отправки.Добавить(Отправка);
			КонецЕсли;
		КонецЕсли;
		
		Если Отправки = Неопределено Или Отправки.Количество() = 0 Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе
			ЭтоВызовИзСписка = (СсылкаНаОтправляемыйОбъект = Неопределено);
			ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизации(Форма, Отправки, 0, ЭтоВызовИзСписка, ОписаниеОповещения);
		КонецЕсли;
	Иначе
		// После ФТС выполняем обмен по ФСРАР
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизации(Форма, Отправки, НомерОбъекта, ЭтоВызовИзСписка, ВыполняемоеОповещение)

	Если НомерОбъекта + 1 > Отправки.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	Иначе
		Отправка = Отправки[НомерОбъекта];
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
			"ОсуществитьОбменПоОрганизацииФТС", 
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФТС"),
			Отправка);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", 					Форма);
		ДополнительныеПараметры.Вставить("Отправки", 				Отправки);
		ДополнительныеПараметры.Вставить("НомерОбъекта", 			НомерОбъекта);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка", 		ЭтоВызовИзСписка);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизацииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Отправка) Тогда
			ОбновитьРезультатКонкретнойОтправкиФТС(Форма, Отправка, ОписаниеОповещения,, ЭтоВызовИзСписка);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 					= ДополнительныеПараметры.Форма;
	Отправки 				= ДополнительныеПараметры.Отправки;
	НомерОбъекта 			= ДополнительныеПараметры.НомерОбъекта;
	ЭтоВызовИзСписка 		= ДополнительныеПараметры.ЭтоВызовИзСписка;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ОбновитьРезультатНезавершенныхПоследнихОтправокФТСПоОрганизации(Форма, Отправки, НомерОбъекта + 1, ЭтоВызовИзСписка, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервере
