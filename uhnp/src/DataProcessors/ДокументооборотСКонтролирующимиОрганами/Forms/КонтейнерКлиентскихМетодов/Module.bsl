Функция НаименованиеТОГСаПоКоду(КодТОГСа, Спецоператор) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.НаименованиеТОГСаПоКоду(КодТОГСа, Спецоператор);
	
КонецФункции

&НаКлиенте
Процедура ВосстановитьНаправленияПоУмолчаниюФСС(Получатели, ДанныеОрганизации) 
	
	// ФСС
	КодПодчФСС = "";

	Если ДанныеОрганизации.Свойство("КодПодчиненностиФСС",КодПодчФСС) Тогда
		КодПодчФСС = ДанныеОрганизации.КодПодчиненностиФСС;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ДанныеОрганизации.РеквизитДопКодФСС) Тогда
		ДопКодФСС = ДанныеОрганизации.РеквизитДопКодФСС;
	ИначеЕсли ДанныеОрганизации.Свойство("ОбъектДополнительныйКодФСС") И НЕ ПустаяСтрока(ДанныеОрганизации.ОбъектДополнительныйКодФСС) Тогда 
		ДопКодФСС = ДанныеОрганизации.ОбъектДополнительныйКодФСС;
	КонецЕсли; 

	КодПодразделенияФССПоУмолчанию = ПолучитьКодПодразделенияФССПоУмолчанию(
		КодПодчФСС,
		ДопКодФСС,
		ДанныеОрганизации.РегистрационныйНомерФСС);
		
	ЕстьНаправлениеФСС = НЕ ПустаяСтрока(КодПодразделенияФССПоУмолчанию);
	
	Если ЕстьНаправлениеФСС Тогда
		НовоеНаправление(Получатели,СтруктураСсылочныхДанных.Перечисления_ТипыКонтролирующихОрганов_ФСС,"",);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНаправленияПоУмолчаниюПФР(Получатели, ДанныеОрганизации)
	
	// ПФР
	Если ПустаяСтрока(ДанныеОрганизации.КодОрганаПФР) ИЛИ СтрДлина(ДанныеОрганизации.КодОрганаПФР) < 7 Тогда
		КодПолучателяПФР = Лев(ДанныеОрганизации.КодОрганаПФР,7); 
	Иначе
		КодПолучателяПФР = ДанныеОрганизации.КодОрганаПФР;
	КонецЕсли;
	
	Если ПроверитьНомерОрганаПФР(КодПолучателяПФР) Тогда
		Если СтрДлина(СокрЛП(ДанныеОрганизации.РегНомПФР))= 14 Тогда
			
			НовоеНаправление(
				Получатели,
				ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ПФР"),
				КодПолучателяПФР);
				
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НаправлениеУникально(Получатели, Действие, НовыеЗначенияПолучателя, ПредыдущиеЗначенияПолучателя = Неопределено) Экспорт
	
	ФНС	= ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФНС");
	ПФР 	= ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ПФР");
	ФСГС 	= ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСГС");
	ФСС 	= ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС");
	
	Отбор = Новый Структура();
	Отбор.Вставить("ТипПолучателя", НовыеЗначенияПолучателя.ТипПолучателя);

	Если НовыеЗначенияПолучателя.ТипПолучателя = ФНС Тогда
	
		Отбор.Вставить("КодПолучателя", НовыеЗначенияПолучателя.КодПолучателя);
		Отбор.Вставить("КПП", 			НовыеЗначенияПолучателя.КПП);
		
	ИначеЕсли НовыеЗначенияПолучателя.ТипПолучателя = ФСГС Тогда
		
		Отбор.Вставить("КодПолучателя", НовыеЗначенияПолучателя.КодПолучателя);
		
	КонецЕсли;
		
	СредиПолучателейУжеЕстьТакой = Получатели.НайтиСтроки(Отбор).Количество() > 0;
	
	ОтказатьВДобавлениие 	= СредиПолучателейУжеЕстьТакой И Действие = "Добавить";
	
	ОтказатьВРедактировании = СредиПолучателейУжеЕстьТакой И Действие = "Редактировать"
		И (ПредыдущиеЗначенияПолучателя.ТипПолучателя <> НовыеЗначенияПолучателя.ТипПолучателя
		ИЛИ ПредыдущиеЗначенияПолучателя.КодПолучателя <> НовыеЗначенияПолучателя.КодПолучателя
		ИЛИ ПредыдущиеЗначенияПолучателя.КПП <> НовыеЗначенияПолучателя.КПП);
	
	Если ОтказатьВДобавлениие ИЛИ ОтказатьВРедактировании Тогда
		
		Если НовыеЗначенияПолучателя.ТипПолучателя = ФНС Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Получатель с таким кодом налоговой уже добавлен.';
															|en = 'Получатель с таким кодом налоговой уже добавлен.'"));
		ИначеЕсли НовыеЗначенияПолучателя.ТипПолучателя = ФСС Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Направление сдачи в ФСС уже добавлено.';
															|en = 'Направление сдачи в ФСС уже добавлено.'"));
		ИначеЕсли НовыеЗначенияПолучателя.ТипПолучателя = ПФР Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Направление сдачи в ПФР уже добавлено.';
															|en = 'Направление сдачи в ПФР уже добавлено.'"));
		ИначеЕсли НовыеЗначенияПолучателя.ТипПолучателя = ФСГС Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Направление сдачи в Росстат уже добавлено.';
															|en = 'Направление сдачи в Росстат уже добавлено.'"));
		КонецЕсли;
				
		Возврат Ложь;
			
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

