&НаСервереБезКонтекста
Функция ПреобразоватьXMLКЗначению(Тип, СтрокаXML)
	
	Если ТипЗнч(Тип) = Тип("Строка") Тогда
		ЗаданныйТип = Тип(Тип);
	Иначе
		ЗаданныйТип = Тип;
	КонецЕсли;
	
	Если ЗаданныйТип = Тип("Дата") Тогда
		Возврат ДатаПоСтроке(СтрокаXML);
	Иначе
		Попытка
			Возврат XMLЗначение(ЗаданныйТип, СтрокаXML);
		Исключение
			Возврат РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначениеТипа(ЗаданныйТип);
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойстваИФНСИзИБ(КодыИФНС)
	
	// создаем массив-результат
	СведенияОбИФНС = Новый Массив;
	
	// получаем из ИБ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ИФНСы.Код,
	                      |	ИФНСы.Наименование,
	                      |	ИФНСы.Сертификаты.(
	                      |		Сертификат
	                      |	)
	                      |ИЗ
	                      |	Справочник.НалоговыеОрганы КАК ИФНСы
	                      |ГДЕ
	                      |	ИФНСы.Код В(&Код)");
	Запрос.УстановитьПараметр("Код", КодыИФНС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// формируем результат
	Пока Выборка.Следующий() Цикл
		
		СертификатыИФНС = Новый Массив;
		ВыборкаСертификаты = Выборка.Сертификаты.Выбрать();
		Пока ВыборкаСертификаты.Следующий() Цикл
			СертификатыИФНС.Добавить(СокрЛП(ВыборкаСертификаты.Сертификат));
		КонецЦикла;
		
		СведенияОбИФНС.Добавить(Новый Структура("Код, Наименование, Сертификаты",
								СокрЛП(Выборка.Код), СокрЛП(Выборка.Наименование), СертификатыИФНС));
		
	КонецЦикла;
	
	Возврат СведенияОбИФНС;
	
КонецФункции

