// Представление уведомлений в налоговые органы

#Область ОтправкаУведомлениеФНС

&НаСервереБезКонтекста
Функция ОтправкаУведомлениеФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст, РезультатВыгрузкиУведомления, ПриложенияУведомления)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	УведомлениеСсылка = Контекст.Документ;
	
	ЭтоУведомлениеОКонтролируемыхСделках 	= Ложь;
	ЭтоИсходящееУведомлениеФНС 				= Ложь;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(УведомлениеСсылка);
	ИмяДокументаУведомлениеОКонтролируемыхСделках 	= ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("УведомлениеОКонтролируемыхСделках");
	ИмяДокументаИсходящееУведомлениеФНС 			= "УведомлениеОСпецрежимахНалогообложения";
	
	Если ИмяДокументаУведомлениеОКонтролируемыхСделках <> Неопределено И ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка." + ИмяДокументаУведомлениеОКонтролируемыхСделках) Тогда
		ЭтоУведомлениеОКонтролируемыхСделках = Истина;
	ИначеЕсли ИмяДокументаИсходящееУведомлениеФНС <> Неопределено И ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка." + ИмяДокументаИсходящееУведомлениеФНС) Тогда
		ЭтоИсходящееУведомлениеФНС = Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УведомлениеСсылка, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	КонецЕсли;

	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
	КонецЕсли;
		
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	//Определяем Регистрацию ИФНС и Налоговый орган
	Если ЭтоУведомлениеОКонтролируемыхСделках Тогда
		// это уведомление о контролируемых сделках
		
		// ищем РегистрацияВИФНС по организации и коду налогового органа
		КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодНО").КодНО);
		Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
		Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
				|en = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.'"), Символ(34) + КодНалоговогоОргана + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
		
	ИначеЕсли ЭтоИсходящееУведомлениеФНС Тогда
		// это исходящее уведомление ФНС
		
		Если ТипЗнч(УведомлениеСсылка) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
			ЭлРегистрацияВИФНС = УведомлениеСсылка.РегистрацияВИФНС;
		Иначе 
			ЭлРегистрацияВИФНС = Неопределено;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		КодНалоговогоОргана = ЭлРегистрацияВИФНС.Код;
		Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
									|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
		Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
				|en = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.'"), Символ(34) + КодНалоговогоОргана + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоУведомлениеОКонтролируемыхСделках Тогда
		ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.УведомлениеОКонтролируемыхСделках;
	ИначеЕсли ЭтоИсходящееУведомлениеФНС Тогда
		ВидОтправляемогоДокумента =
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьВидОтправляемогоДокументаПоСсылке(
			УведомлениеСсылка);
	Иначе
		ВидОтправляемогоДокумента = Неопределено;
	КонецЕсли;
	
	ДанныеФайлаПредставление = РезультатВыгрузкиУведомления;
	ИмяФайлаПредставления = РезультатВыгрузкиУведомления.ИмяФайлаВыгрузки;
	АдресФайлаПредставления = РезультатВыгрузкиУведомления.АдресФайлаВыгрузки;
	
	ДанныеРегистрации = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС);
	ДоверенностьПредставителя = ДанныеРегистрации.Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(ДоверенностьПредставителя) Тогда
		
		Если ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ЗапретПредставленияУполномоченнымиЛицами Тогда
			ТекстСообщения =
				НСтр("ru = 'Отправка по доверенности уведомления о запрете/отмене запрета представления деклараций по НДС уполномоченными лицами не предусмотрена законодательством';
					|en = 'Отправка по доверенности уведомления о запрете/отмене запрета представления деклараций по НДС уполномоченными лицами не предусмотрена законодательством'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		// формируем файл доверенности
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
			ЭлРегистрацияВИФНС,
			КороткоеИмяФайлаДоверенности,
			Организация,,,
			Истина);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
		
		// получаем реквизиты доверенности
		// если представитель ЮЛ или [ФЛ и не сотрудник организации], то подменяем имя файла
		ИмяТипаСправочникаМашиночитаемыеДоверенности = ?(ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует(),
			"МашиночитаемыеДоверенности", "");
		ЯвляетсяСотрудникомОрганизацииПоМЧД = Неопределено;
		Если ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
			ИЛИ ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
			ИЛИ ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности) И ТипЗнч(ДоверенностьПредставителя) =
				Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
			
			РеквизитыДоверенности = ДокументооборотСКОВызовСервера.ЗначенияРеквизитовМЧД(ДоверенностьПредставителя,
				"ДоверительЮЛ_ИНН, ДоверительЮЛ_КПП, ДоверительФЛ_ИНН, Представитель, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, "
				+ "ПредставительФЛ_ИНН, ПредставительФЛ_ОГРН, ФИО, ВерсияФормата, КоличествоПредставителей, Представители, "
				+ "ПредставительЯвляетсяСотрудником");
			Если РеквизитыДоверенности = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			ЭтоВерсия5_02 = ЗначениеЗаполнено(РеквизитыДоверенности.ВерсияФормата)
				И ОбщегоНазначенияКлиентСервер.СравнитьВерсии(РеквизитыДоверенности.ВерсияФормата + ".0.0", "5.02.0.0") >= 0;
			ПредставительЗаданСтрокойФИО = (ЗначениеЗаполнено(РеквизитыДоверенности.Представитель)
				И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
				И ТипЗнч(РеквизитыДоверенности.Представитель) = Тип("Строка"));
			Если ПредставительЗаданСтрокойФИО И НЕ ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности)
				ИЛИ ТипЗнч(ДоверенностьПредставителя) <>
				Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
				СтрокиФИО = РеквизитыДоверенности.ФИО.Выгрузить().НайтиСтроки(Новый Структура("Владелец",
					Перечисления.СубъектыДоверенностиНалогоплательщика.ПредставительФЛ));
				ПредставительЗаданСтрокойФИО = ?(СтрокиФИО.Количество() <> 0,
					РеквизитыДоверенности.Представитель = ДокументооборотСКОКлиентСервер.ПолучитьПредставлениеФИО(СтрокиФИО[0]),
					Ложь); // сотрудник ИП, если "ПредставительЯвляетсяСотрудником" не поддерживается
			КонецЕсли;
			
			ТекстСообщения = ДокументооборотСКОВызовСервера.УточнитьРеквизитыПредставителяМЧДФНС(РеквизитыДоверенности,
				ДоверенностьПредставителя, ДанныеРегистрации);
			Если ЗначениеЗаполнено(ТекстСообщения) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			
			ЯвляетсяСотрудникомОрганизацииПоМЧД =
				?(ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
						ИЛИ ЭтоВерсия5_02, РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
						И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН), Ложь)
					ИЛИ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
						И ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_КПП)
						И РеквизитыДоверенности.ДоверительЮЛ_ИНН = РеквизитыДоверенности.ПредставительЮЛ_ИНН
						И РеквизитыДоверенности.ДоверительЮЛ_КПП = РеквизитыДоверенности.ПредставительЮЛ_КПП
					ИЛИ ПредставительЗаданСтрокойФИО;
			РеквизитыДоверенности = Новый Структура("ПредставительЯвляетсяЮЛ, ПредставительЯвляетсяСотрудником, "
				+ "ДоверительЮЛ_ИНН, ДоверительЮЛ_КПП, ДоверительФЛ_ИНН, "
				+ "ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, ПредставительФЛ_ИНН",
				ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН),
				ЯвляетсяСотрудникомОрганизацииПоМЧД
					ИЛИ НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
						И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительФЛ_ОГРН),
				РеквизитыДоверенности.ДоверительЮЛ_ИНН,
				РеквизитыДоверенности.ДоверительЮЛ_КПП,
				РеквизитыДоверенности.ДоверительФЛ_ИНН,
				РеквизитыДоверенности.ПредставительЮЛ_ИНН,
				РеквизитыДоверенности.ПредставительЮЛ_КПП,
				РеквизитыДоверенности.ПредставительФЛ_ИНН);
			
		Иначе
			РеквизитыДоверенности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоверенностьПредставителя,
				"ПредставительЯвляетсяЮЛ, ПредставительЯвляетсяСотрудником, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, "
				+ "ПредставительФЛ_ИНН");
		КонецЕсли;
		
		Если РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
			ИЛИ (НЕ РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
				И (НЕ РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
					ИЛИ (ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
						И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица")))) Тогда
			
			ИспользоватьРеквизитыДоверителя = НЕ РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
				И РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
				И ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь;
			
			Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
				КодНалоговогоОргана = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
					Организация,, "КодНО").КодНО);
			КонецЕсли;
			НастройкиВызова = Новый Структура;
			НастройкиВызова.Вставить("РеквизитыДоверенности", 			РеквизитыДоверенности);
			НастройкиВызова.Вставить("ДанныеРегистрации", 				ДанныеРегистрации);
			НастройкиВызова.Вставить("ИспользоватьРеквизитыДоверителя", ИспользоватьРеквизитыДоверителя);
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			Если НЕ КонтекстЭДОСервер.ИзменитьФайлВыгрузкиПриОтправкеЧерезУполномоченногоПредставителя(
				АдресФайлаПредставления,
				ИмяФайлаПредставления,
				ДоверенностьПредставителя,
				КодНалоговогоОргана,,,
				НастройкиВызова) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	НачатьТранзакцию();
		
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = УведомлениеСсылка;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	
	ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Представление;
	
	//определяем вид отправляемого докумнта
	Если ЭтоУведомлениеОКонтролируемыхСделках ИЛИ ЭтоИсходящееУведомлениеФНС Тогда
		ЦиклОбмена.ВидОтчета = ВидОтправляемогоДокумента;
		
		Если ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.УведомлениеОсвобождениеНалогНаПрибыльСколково
			И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ув.осв.приб.Сколк.01")
			ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.УведомлениеОсвобождениеНДССколково
			И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ув.осв.НДС Сколк.01")
			ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ИсчисленныеСуммыНалогов
			И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ув.об исчис.сум.н.12")
			ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СоблюдениеУсловийПониженныхСтавок
			И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.собл.усл.пон.став.12") Тогда
			
			ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность;
			ЦиклОбмена.ДатаНачалаПериода = НачалоДня(УведомлениеСсылка.Дата);
			ЦиклОбмена.ДатаОкончанияПериода = НачалоДня(УведомлениеСсылка.Дата);
		КонецЕсли;
	КонецЕсли;
	
	ЦиклОбмена.Тип = ТипЦиклаОбмена;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = ?(ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Представление,
		Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП,
		Перечисления.ТипыТранспортныхСообщений.ДекларацияНП);
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	//добавляем файл Представление
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаПредставления);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	Если ИнтерфейсыВзаимодействияБРОВызовСервера.СведенияДляБакета(, ИмяФайлаПредставления).Выполнено Тогда
		ТекстСведений = ИнтерфейсыВзаимодействияБРОВызовСервера.СведенияДляБакета(ИмяВременногоФайла,
			ИмяФайлаПредставления).ТекстСведений;
	Иначе
		ТекстСведений = "";
	КонецЕсли;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
		ТранспортноеСообщение.Ссылка,
		?(ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Представление,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности),
		ДвоичныеДанныеФайла,
		ИмяФайлаПредставления,,,,,,,
		СгенерироватьUUID(),
		Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к уведомлению
	Для каждого ПриложениеУведомления Из ПриложенияУведомления Цикл
		ДвоичныеДанныеПриложения = ПолучитьИзВременногоХранилища(ПриложениеУведомления.АдресФайлаВыгрузки);
		РезультатДобавления = ДобавитьСодержимоеТранспортногоКонтейнера(
			ТранспортноеСообщение.Ссылка,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение,
			ДвоичныеДанныеПриложения,
			ПриложениеУведомления.ИмяФайлаВыгрузки,
			ДвоичныеДанныеПриложения.Размер(),,,,,,
			СгенерироватьUUID(),
			ТипСодержимогоПоИмениФайла(ПриложениеУведомления.ИмяФайлаВыгрузки));
		
		Если НЕ РезультатДобавления Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(УведомлениеСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТекстСведений", ТекстСведений);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаУведомлениеФНС(УведомлениеСсылка, ОрганизацияОтчета, УникальныйИдентификаторФормы, ВыполняемоеОповещение) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	МассивВыгруженныхУведомлений = Неопределено;
	Если НЕ ВыгрузитьУведомлениеФНС(УведомлениеСсылка, МассивВыгруженныхУведомлений) Тогда
		
		ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
		
		ТекстСообщения = НСтр("ru = 'Отправка уведомления прервана. Не удалось выгрузить файл выгрузки уведомления';
								|en = 'Отправка уведомления прервана. Не удалось выгрузить файл выгрузки уведомления'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	
	ПриложенияВыгруженныхУведомлений = Новый Массив;
	НомерУведомления = 0;
	ПриложенияРазрешены = Ложь;
	ЛюбыеXMLПриложенияРазрешены = Ложь;
	Пока НомерУведомления < МассивВыгруженныхУведомлений.Количество() Цикл
		ВыгруженноеУведомление = МассивВыгруженныхУведомлений[НомерУведомления];
		ИмяФайлаПриведенное = ВРЕГ(ВыгруженноеУведомление.ИмяФайлаВыгрузки);
		Если ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 3) = "PR_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 5) = "0250_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1125332_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1110304_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1125315_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1110305_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1125336_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1125337_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1125338_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1110313_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1150140_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 8) = "1110395_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 5) = "0300_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 5) = "9996_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 12) = "ON_ZVNALMON_"
			ИЛИ ПриложенияРазрешены И Лев(ИмяФайлаПриведенное, 10) = "NO_MFSOAZ_"
			ИЛИ ПриложенияРазрешены И ЛюбыеXMLПриложенияРазрешены И Прав(ИмяФайлаПриведенное, 4) = ".XML" Тогда
				ДвоичныеДанныеВыгрузки = ПолучитьИзВременногоХранилища(ВыгруженноеУведомление.АдресФайлаВыгрузки);
				ВыгруженноеУведомление.АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеВыгрузки, Новый УникальныйИдентификатор);
				ПриложенияВыгруженныхУведомлений[НомерУведомления - 1].Добавить(ВыгруженноеУведомление);
				МассивВыгруженныхУведомлений.Удалить(НомерУведомления);
		Иначе
			Если Лев(ИмяФайлаПриведенное, 11) = "ON_UVNPDUS_"
				ИЛИ Лев(ИмяФайлаПриведенное, 8) = "NP_GALB_"
				ИЛИ Лев(ИмяФайлаПриведенное, 16) = "ON_UCHPOLNALMON_"
				ИЛИ Лев(ИмяФайлаПриведенное, 13) = "ON_RIVNALMON_"
				ИЛИ Лев(ИмяФайлаПриведенное, 15) = "ON_SRSVKNALMON_"
				ИЛИ Лев(ИмяФайлаПриведенное, 11) = "ON_ZAPMMNO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 14) = "ON_UVSOGLMMNO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 12) = "ON_RAZNMMNO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 13) = "ON_UVVPRMMNO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 12) = "ON_IPDNOISO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 12) = "ON_ZAKLSZPK_"
				ИЛИ Лев(ИмяФайлаПриведенное, 12) = "ON_UVSDELOP_"
				ИЛИ Лев(ИмяФайлаПриведенное, 12) = "UT_DOKUVKSD_"
				ИЛИ Лев(ИмяФайлаПриведенное, 16) = "NO_UVNPOKODOKNO_"
				ИЛИ Лев(ИмяФайлаПриведенное, 14) = "NO_UVEDAUDZAK_" Тогда
					ПриложенияРазрешены = Истина;
					Если Лев(ИмяФайлаПриведенное, 11) = "ON_ZAPMMNO_" Тогда
						ЛюбыеXMLПриложенияРазрешены = Истина;
					КонецЕсли;
			КонецЕсли;
			ПриложенияВыгруженныхУведомлений.Добавить(Новый Массив);
			НомерУведомления = НомерУведомления + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивВыгруженныхУведомлений.Количество() >= 1
		И ВРег(Лев(МассивВыгруженныхУведомлений[0].ИмяФайлаВыгрузки, 16)) = "SR_ISCHTRZEMNAL_"
		И СтрНайти(МассивВыгруженныхУведомлений[0].ТестВыгрузки, "ПрСообщ=""2""") > 0
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.пер.сооб.нал.пр.2", '20230101') Тогда
		
		ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
		
		ТекстСообщения = НСтр("ru = 'Запрос сообщения об исчисленном налоге на имущество в электронном виде предусматривается с 01.01.2023';
								|en = 'Запрос сообщения об исчисленном налоге на имущество в электронном виде предусматривается с 01.01.2023'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("УведомлениеСсылка",					УведомлениеСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета",					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("УникальныйИдентификаторФормы",		УникальныйИдентификаторФормы);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("МассивВыгруженныхУведомлений",		МассивВыгруженныхУведомлений);
	ДополнительныеПараметры.Вставить("ПриложенияВыгруженныхУведомлений",	ПриложенияВыгруженныхУведомлений);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаУведомлениеФНСПослеАвтонастройкиУчетнойЗаписи", ЭтотОбъект, ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("УведомлениеСсылка", 	УведомлениеСсылка);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= УведомлениеСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 4;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка уведомления в ФНС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаУведомлениеФНС",  0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаУведомлениеФНС() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	УведомлениеСсылка 	= КонтекстДлительнойОперации.УведомлениеСсылка;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(УведомлениеСсылка,ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаУведомлениеФНС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ДополнительныеПараметры.УведомлениеСсылка, ДополнительныеПараметры.ОрганизацияОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНС_ПослеПроверкиСертификатаИЛицензии(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	УведомлениеСсылка 					= ДополнительныеПараметры.УведомлениеСсылка;
	УникальныйИдентификаторФормы 		= ДополнительныеПараметры.УникальныйИдентификаторФормы;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	МассивВыгруженныхУведомлений 		= ДополнительныеПараметры.МассивВыгруженныхУведомлений;
	ПриложенияВыгруженныхУведомлений 	= ДополнительныеПараметры.ПриложенияВыгруженныхУведомлений;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", УведомлениеСсылка);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 				ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", 					КонтекстОтправки);
	Контекст.Вставить("МассивВыгруженныхУведомлений", 		МассивВыгруженныхУведомлений);
	Контекст.Вставить("ПриложенияВыгруженныхУведомлений", 	ПриложенияВыгруженныхУведомлений);
	Контекст.Вставить("ТекущееУведомление", 			0);
	
	ОтправкаУведомлениеФНСПоследовательнаяОтправка(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПоследовательнаяОтправка(ВходящийКонтекст)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если ВходящийКонтекст.ТекущееУведомление < ВходящийКонтекст.МассивВыгруженныхУведомлений.Количество() Тогда
		
		ВыгруженноеУведомление 	= ВходящийКонтекст.МассивВыгруженныхУведомлений[ВходящийКонтекст.ТекущееУведомление];
		ПриложенияУведомления 	= ВходящийКонтекст.ПриложенияВыгруженныхУведомлений[ВходящийКонтекст.ТекущееУведомление];
		
		// отражаем изменения в базе
		Если НЕ ОтправкаУведомлениеФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки, ВыгруженноеУведомление, ПриложенияУведомления) Тогда // сервер
			
			Если КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
				ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
				ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(КонтекстОтправки.Документ, ВходящийКонтекст.ОповещениеОЗавершении, Ложь);//+
			Иначе
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
				ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
				
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
			КонецЕсли;
			
			Возврат;
			
		ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(КонтекстОтправки.Документ) Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(КонтекстОтправки.Документ, ВходящийКонтекст.ОповещениеОЗавершении, Ложь);//+
			Возврат;
			
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		Оповещение = Новый ОписаниеОповещения(
			"ОтправкаУведомлениеФНСПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
		
		ТекстСведений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КонтекстОтправки, "ТекстСведений");
		ПараметрыОперации = Новый Структура("ТекстСведений", ТекстСведений);
		
		Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС", ПараметрыОперации);
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Уведомления.
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаУведомлениеФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Уведомления.
		
		Возврат;
	КонецЕсли;
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	ВходящийКонтекст.ТекущееУведомление = ВходящийКонтекст.ТекущееУведомление + 1;
	
	ОтправкаУведомлениеФНСПоследовательнаяОтправка(ВходящийКонтекст);
	
КонецПроцедуры

