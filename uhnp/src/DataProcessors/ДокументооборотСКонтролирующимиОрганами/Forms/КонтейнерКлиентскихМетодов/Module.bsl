&НаСервереБезКонтекста
Функция ПолучитьСвойстваФайлаВыгрузки(
		ОбъектСсылка,
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		УникальныйИдентификатор = Неопределено,
		Приложения = Неопределено)
	
	СвойстваФайлаВыгрузки = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ВыгрузитьДокументСервер(
		ОбъектСсылка,
		УникальныйИдентификатор);
	Если СвойстваФайлаВыгрузки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(СвойстваФайлаВыгрузки) = Тип("Массив")
		ИЛИ ТипЗнч(СвойстваФайлаВыгрузки) = Тип("ФиксированныйМассив") Тогда
		
		МассивФайловВыгрузки = СвойстваФайлаВыгрузки;
		СвойстваОсновногоФайлаВыгрузки = Неопределено;
		Для каждого СвойстваФайлаВыгрузки Из МассивФайловВыгрузки Цикл
			Если СтрНачинаетсяС(СвойстваФайлаВыгрузки.ТипФайлаВыгрузки, "Приложение") Тогда
				Приложение = Новый Структура;
				Приложение.Вставить("ТипФайлаВыгрузки", СвойстваФайлаВыгрузки.ТипФайлаВыгрузки);
				Приложение.Вставить("АдресФайлаВыгрузки", СвойстваФайлаВыгрузки.АдресФайлаВыгрузки);
				Приложение.Вставить("ИмяФайлаВыгрузки", СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки);
				Приложение.Вставить("КодировкаФайлаВыгрузки", СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки);
				Если ТипЗнч(Приложения) <> Тип("Массив") Тогда
					Приложения = Новый Массив;
				КонецЕсли;
				Приложения.Добавить(Приложение);
				
			Иначе
				СвойстваОсновногоФайлаВыгрузки = СвойстваФайлаВыгрузки;
			КонецЕсли;
		КонецЦикла;
		
		СвойстваФайлаВыгрузки = СвойстваОсновногоФайлаВыгрузки;
	КонецЕсли;
	
	Если СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки = КодировкаТекста.ANSI Тогда
		КодировкаФайлаВыгрузки = "windows-1251";
	ИначеЕсли СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки = КодировкаТекста.OEM Тогда
		КодировкаФайлаВыгрузки = "cp866";
	Иначе
		КодировкаФайлаВыгрузки = СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки;
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СвойстваФайлаВыгрузки.АдресФайлаВыгрузки);
	ДвоичныеДанныеФайла.Записать(ВремФайл);
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, КодировкаФайлаВыгрузки);
	
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	ИмяФайлаВыгрузки = СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(Контекст, ВыполняемоеОповещение, ДополнительныеДанные = Неопределено)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	
	// выгружаем отчет
	ТипОтправляемогоДокумента = Контекст.ТипОтправляемогоДокумента;
	Приложения = Неопределено;
	Если ТипОтправляемогоДокумента = "РегламентированныйОтчет"
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"СправкиНДФЛДляПередачиВНалоговыйОрган")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"СведенияОДоходахСотрудникаДляСоцВыплат") Тогда
		
		// выгружаем
		ТекстВыгрузки = "";
		ИмяФайлаВыгрузки = "";
		КодировкаФайлаВыгрузки = "";
		ТипФайлаВыгрузки = "";
		РезультатВыгрузки = СдачаОтчетностиЧерезСервисСпецоператораКлиент.ВыгрузитьРегламентированныйОтчет(
			Контекст.Документ,
			Ложь,
			ТекстВыгрузки,
			ИмяФайлаВыгрузки,
			КодировкаФайлаВыгрузки,
			ТипФайлаВыгрузки,
			Приложения,
			Контекст.УникальныйИдентификатор);
		Если НЕ РезультатВыгрузки Тогда
			
			ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
									|en = 'Отправка отчета прервана.'");
			
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ВыполняемоеОповещение) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ТекстСообщения);
			Иначе
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекстВыгрузки) И ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") И ИмяФайлаВыгрузки.Количество() = 1
			И ТипЗнч(Приложения) = Тип("Массив") И Приложения.Количество() > 0 И ТипЗнч(Приложения[0]) = Тип("Структура") Тогда
			ТекстВыгрузки = Приложения[0].АдресФайлаВыгрузки;
			ИмяФайлаВыгрузки = ИмяФайлаВыгрузки[0];
			ТипФайлаВыгрузки = Приложения[0].ТипФайлаВыгрузки;
			Приложения = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипОтправляемогоДокумента = "УведомлениеОПолучателеДокументов" Тогда
		
		Если ДополнительныеДанные = Неопределено Тогда
			СертификатыДолжностныхЛиц = СертификатыДолжностныхЛицПолучателяДокументов(Контекст.Документ);
			
			Если СертификатыДолжностныхЛиц <> Неопределено 
				И ЭтоЛокальнаяПодпись(СертификатыДолжностныхЛиц)
				И ЗначениеЗаполнено(СертификатыДолжностныхЛиц.ОтпечатокСертификатаДляШифрования) Тогда
				
				СвойстваСертификатаДляШифроания = Новый Структура("Отпечаток", СертификатыДолжностныхЛиц.ОтпечатокСертификатаДляШифрования);
				
				ДополнительныеПараметры = Новый Структура("Контекст, ВыполняемоеОповещение", Контекст, ВыполняемоеОповещение);
				Оповещение = Новый ОписаниеОповещения(
					"ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеПоискаСертификатаДляШифрования", ЭтотОбъект, ДополнительныеПараметры);
				КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, СвойстваСертификатаДляШифроания,, Ложь);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ВладелецСертификатаОтветственногоЗаШифрование = ?(ДополнительныеДанные <> Неопределено,
			ДополнительныеДанные.ВладелецСертификатаОтветственногоЗаШифрование, Неопределено);
		
		ФайлУведомленияОПолучателеДокументов = СформироватьФайлУведомленияОПолучателеДокументов(
			Контекст.Документ,
			ВладелецСертификатаОтветственногоЗаШифрование,
			Контекст.УникальныйИдентификатор,
			Истина);
		
		Если ФайлУведомленияОПолучателеДокументов = Неопределено Тогда
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
		ТекстВыгрузки = ФайлУведомленияОПолучателеДокументов.ТекстФайлаУведомления;
		ИмяФайлаВыгрузки = ФайлУведомленияОПолучателеДокументов.ИмяФайлаУведомления;
		Приложения = Неопределено;
		
	ИначеЕсли ТипОтправляемогоДокумента = "МашиночитаемыеДоверенностиФНС"
		ИЛИ ТипОтправляемогоДокумента = "ЗаявленияОбОтзывеМЧДФНС" Тогда
		
		ОпределятьКодНалоговогоОрганаПолучателя = Истина;
		ФорматДоверенностиПоПриказуФНС 			= Истина;
		ПараметрыВозврата = Новый Структура;
		ПараметрыВозврата.Вставить("ВозвращатьИмяФайлаСРасширением", 	Истина);
		ПараметрыВозврата.Вставить("ВозвращатьПриложеннуюПодпись", 		Истина);
		Если ТипОтправляемогоДокумента = "МашиночитаемыеДоверенностиФНС" Тогда
			РезультатыВыгрузки = ДокументооборотСКОВызовСервера.ВыгрузитьМЧД(
				Контекст.Документ,,,
				ОпределятьКодНалоговогоОрганаПолучателя,
				ФорматДоверенностиПоПриказуФНС,
				Истина,
				ПараметрыВозврата);
		Иначе
			РезультатыВыгрузки = ДокументооборотСКОВызовСервера.ВыгрузитьЗаявлениеОбОтзывеМЧДФНС(
				Контекст.Документ,,,
				ОпределятьКодНалоговогоОрганаПолучателя,
				ФорматДоверенностиПоПриказуФНС,
				Истина,
				ПараметрыВозврата);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(РезультатыВыгрузки) Тогда
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(РезультатыВыгрузки) = Тип("Массив") Тогда
			Если РезультатыВыгрузки.Количество() <> 0 Тогда
				ТекстВыгрузки 		= РезультатыВыгрузки[0].Адрес;
				ИмяФайлаВыгрузки 	= РезультатыВыгрузки[0].Имя;
				Приложения 			= Новый Массив;
				Для ИндексПриложения = 1 По РезультатыВыгрузки.Количество() - 1 Цикл
					Приложение = Новый Структура;
					Приложение.Вставить("АдресФайлаВыгрузки", 		РезультатыВыгрузки[ИндексПриложения].Адрес);
					Приложение.Вставить("ИмяФайлаВыгрузки", 		РезультатыВыгрузки[ИндексПриложения].Имя);
					Приложение.Вставить("ТипФайлаВыгрузки", 		"");
					Приложение.Вставить("КодировкаФайлаВыгрузки", 	"");
					Приложения.Добавить(Приложение);
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			ТекстВыгрузки 		= РезультатыВыгрузки.Содержимое;
			ИмяФайлаВыгрузки 	= РезультатыВыгрузки.ИмяФайла;
			Приложения 			= Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"БухгалтерскийОтчетГосударственногоУчреждения")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"ЗаявлениеОВвозеТоваров")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОбОстаткахПрослеживаемыхТоваров")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОВвозеПрослеживаемыхТоваров")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОПеремещенииПрослеживаемыхТоваров")
		ИЛИ ТипОтправляемогоДокумента =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"ДокументацияПоКонтролируемымСделкам") Тогда
		
		// выгружаем
		ТекстВыгрузки = "";
		ИмяФайлаВыгрузки = "";
		Приложения = Неопределено;

		РезультатВыгрузки = ПолучитьСвойстваФайлаВыгрузки(
			Контекст.Документ,
			ТекстВыгрузки,
			ИмяФайлаВыгрузки,
			Контекст.УникальныйИдентификатор,
			Приложения);
		Если НЕ РезультатВыгрузки Тогда
			
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			КонецЕсли;
			
			ТекстСообщения = НСтр("ru = 'Не удалось получить файл выгрузки. Отправка отчета прервана.';
									|en = 'Не удалось получить файл выгрузки. Отправка отчета прервана.'");
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ТекстСообщения);
				
			Иначе
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			КонецЕсли;

			Возврат;
		КонецЕсли;
		
	Иначе // внешнее электронное представление
		
		// выгружаем
		ТекстВыгрузки = "";
		ИмяФайлаВыгрузки = "";
		Приложения = ПолучитьПриложенияКОтчету(Контекст.Документ);
		Если НЕ ИзвлечьЭлектронноеПредставлениеИзХранилищаИНараститьСчетчикПриНеобходимости(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки) Тогда
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// 
	Контекст.Вставить("ТекстВыгрузки", ТекстВыгрузки);
	Контекст.Вставить("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
	
	ПрефиксИмениФайла = Лев(ИмяФайлаВыгрузки, 9);
	Если ВРег(ПрефиксИмениФайла) = "NO_NDFL2_" Тогда
		Если ЭтоАдресВременногоХранилища(ТекстВыгрузки) Тогда
			ДанныеВыгрузки = ПолучитьИзВременногоХранилища(ТекстВыгрузки);
			СтрокаВыгрузки = ПолучитьСтрокуИзДвоичныхДанных(ДанныеВыгрузки, "windows-1251");
		Иначе
			СтрокаВыгрузки = ТекстВыгрузки;
		КонецЕсли;
		// С 1 июля 2023 2-НДФЛ с форматом, действовавшим по 2015 год включительно, отправлять письмом (ДО 02)
		Если (СтрНайти(СтрокаВыгрузки, "ВерсФорм=""5.01""") <> 0 ИЛИ СтрНайти(СтрокаВыгрузки, "ВерсФорм=""5.02""") <> 0
			ИЛИ СтрНайти(СтрокаВыгрузки, "ВерсФорм=""5.03""") <> 0 ИЛИ СтрНайти(СтрокаВыгрузки, "ВерсФорм=""5.04""") <> 0)
			И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.2-НДФЛ 2015 ДО 02") Тогда
			
			ДополнительныеПараметры = Новый Структура("Контекст", Контекст);
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеПредупреждения2НДФЛ",
				ЭтотОбъект,
				ДополнительныеПараметры);
			ПоказатьПредупреждение(ОписаниеОповещения,
				НСтр("ru = 'Внимание! 2-НДФЛ в формате, действовавшем по 2015 год включительно, принимается налоговым органом в виде письма.
						   |Далее откроется письмо c файлом выгрузки 2-НДФЛ, письмо следует отправить в налоговую. Протокол обработки и реестр поступят ответным письмом налоговой.';
						   |en = 'Внимание! 2-НДФЛ в формате, действовавшем по 2015 год включительно, принимается налоговым органом в виде письма.
						   |Далее откроется письмо c файлом выгрузки 2-НДФЛ, письмо следует отправить в налоговую. Протокол обработки и реестр поступят ответным письмом налоговой.'"));
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Неопределено);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Приложения) Тогда
		ИндексПриложения = 0;
		Пока ИндексПриложения < Приложения.Количество() Цикл
			Если Приложения[ИндексПриложения].ТипФайлаВыгрузки = "ПояснительнаяЗапискаКЕНВД" Тогда
				ТекстСообщения = НСтр("ru = 'Внимание! Далее откроется письмо с пояснительной запиской в формате PDF, письмо следует отправить в налоговую для завершения отправки отчета.';
										|en = 'Внимание! Далее откроется письмо с пояснительной запиской в формате PDF, письмо следует отправить в налоговую для завершения отправки отчета.'");
				Контекст.Вставить("ДополнительноеСообщениеПриУдачнойОтправке", ТекстСообщения);
				
				ДополнительныеРеквизитыДляОтправки = Новый Структура("КодНалоговогоОргана", Контекст.КодНалоговогоОргана);
				Контекст.Вставить("ДополнительныеРеквизитыДляОтправкиПриУдачнойОтправке", ДополнительныеРеквизитыДляОтправки);
				
				ДополнительныеВложенияДляОтправки = Новый СписокЗначений;
				ДополнительныеВложенияДляОтправки.Добавить(Приложения[ИндексПриложения].АдресФайлаВыгрузки,
					Приложения[ИндексПриложения].ИмяФайлаВыгрузки);
				Контекст.Вставить("ДополнительныеВложенияДляОтправкиПриУдачнойОтправке", ДополнительныеВложенияДляОтправки);
				
				Приложения.Удалить(ИндексПриложения);
				
			Иначе
				ИндексПриложения = ИндексПриложения + 1;
			КонецЕсли;
		КонецЦикла;
	
		Контекст.Вставить("Приложения", Приложения);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеВыгрузкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	// выгружаем приложения к бухгалтерской отчетности
	ВыгрузитьПриложенияКБухгалтерскойОтчетности(Контекст, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеПоискаСертификатаДляШифрования(Результат, ДополнительныеПараметры) Экспорт
	
	Контекст 				= ДополнительныеПараметры.Контекст;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ВладелецСертификатаОтветственногоЗаШифрование = ?(Результат.Выполнено И Результат.СертификатНайден,
		Результат.СвойстваСертификата.Владелец, Неопределено);
	ДополнительныеДанные = Новый Структура("ВладелецСертификатаОтветственногоЗаШифрование", ВладелецСертификатаОтветственногоЗаШифрование);
	
	ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(Контекст, ВыполняемоеОповещение, ДополнительныеДанные);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПриложенияКОтчету(ЭлектронноеПредставление) 
	
	ВсеФайлы = ИзвлечьЭлектронныеПредставленияИзХранилища(ЭлектронноеПредставление);
	
	Если ВсеФайлы = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Приложения = Новый Массив;
		
		Для Каждого Выборка Из ВсеФайлы Цикл
			
			Если Выборка.ТипФайлаОтчетности <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение Тогда
				Продолжить;
			КонецЕсли;
			
			Если Выборка.ВАрхиве Тогда
				ДанныеПредставления = Base64Значение("");
			Иначе
				ДанныеПредставления = Выборка.Данные;
			КонецЕсли;
		
			Приложение = Новый Структура("ТипФайлаВыгрузки, АдресФайлаВыгрузки, ИмяФайлаВыгрузки, КодировкаФайлаВыгрузки", "", "", "", "");
			Приложение.ИмяФайлаВыгрузки = Выборка.ИмяФайла;			
			Приложение.АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(ДанныеПредставления, Новый УникальныйИдентификатор);
			Приложения.Добавить(Приложение);
		КонецЦикла;
		
		Возврат Приложения;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправкиПослеВыгрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Контекст = Результат.Контекст;
	РезультатВыгрузки = Результат.РезультатВыгрузки;
	
	Если РезультатВыгрузки Тогда
		// выгружаем доверенность
		Если НЕ ВыгрузитьДоверенностьИНараститьСчетчикФайловПриНеобходимости(Контекст) Тогда
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
		// корректируем сведения о подписантах в файле бухгалтерской отчетности, при необходимости
		ИзменитьСоставТеговПодписантВБухгалтерскойОтчетностиПриНеобходимости(Контекст);
		
		Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
	Иначе
		Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСоставТеговПодписантВБухгалтерскойОтчетностиПриНеобходимости(Контекст)
	
	// определяем, является ли файл бухотчетностью
	ПрефиксИмениФайлаБО = "NO_BUHOTCH_";
	Если Лев(Контекст.ИмяФайлаВыгрузки, СтрДлина(ПрефиксИмениФайлаБО)) <> ПрефиксИмениФайлаБО Тогда
		Возврат;
	КонецЕсли;
	
	// модифицируем файл выгрузки
	ИзменитьСоставТеговПодписантВБухгалтерскойОтчетностиПриНеобходимостиНаСервере(Контекст);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьФИОПодписантовИзСвойствУчетнойЗаписи(Контекст)
	
	// составляем массив отпечатков сертификатов подписантов
	СертификатыПодписантов = Новый Массив;
	СертификатыПодписантов.Добавить(Контекст.ОбъектСертификатРуководителя);
	Если ЗначениеЗаполнено(Контекст.СертификатГлавногоБухгалтера) И Контекст.СертификатГлавногоБухгалтера <> Контекст.СертификатРуководителя Тогда
		СертификатыПодписантов.Добавить(Контекст.ОбъектСертификатГлавногоБухгалтера);
	КонецЕсли;
	
	// получаем свойства сертификатов
	ФИОПодписантов = Новый Массив;
	Для Инд = 0 По СертификатыПодписантов.Количество() - 1 Цикл
		
		ОбъектСертификат = СертификатыПодписантов[Инд];
		
		// получаем ФИО из свойств сертификата
		СвойстваВладельца = РазобратьСтрокуСвойств(СокрЛП(ОбъектСертификат.Владелец));
		ФИОПодписантаИзСертификата = СокрЛП(СвойстваВладельца["CN"]);
		Если ЗначениеЗаполнено(ФИОПодписантаИзСертификата) И ФИОПодписантов.Найти(ФИОПодписантаИзСертификата) = Неопределено Тогда
			ФИОПодписантов.Добавить(ФИОПодписантаИзСертификата);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ФИОПодписантов;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьСтрокуСвойств(Знач СтрокаСвойств)
	
	СоответствиеРезультат = Новый Соответствие;
	ИсходнаяДлинаСтрокиСвойств = СтрДлина(СтрокаСвойств);
	
	Для ОбрИнд = 0 По ИсходнаяДлинаСтрокиСвойств - 1 Цикл
		Инд = ИсходнаяДлинаСтрокиСвойств - ОбрИнд;
		Если Сред(СтрокаСвойств, Инд, 1) = "," Тогда
			СтрокаСвойства = Сред(СтрокаСвойств, Инд + 1);
			СтрокаСвойств = Лев(СтрокаСвойств, Инд - 1);
			ВхождениеРавно = СтрНайти(СтрокаСвойства, "=");
			Если ВхождениеРавно <> 0 Тогда
				ИмяПараметра = СокрЛП(Лев(СтрокаСвойства, ВхождениеРавно - 1));
				ЗначениеПараметра = СокрЛП(Сред(СтрокаСвойства, ВхождениеРавно + 1));
				Если НЕ ПустаяСтрока(ИмяПараметра) Тогда
					СоответствиеРезультат.Вставить(ИмяПараметра, ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(СтрокаСвойств) Тогда
		ВхождениеРавно = СтрНайти(СтрокаСвойств, "=");
		Если ВхождениеРавно <> 0 Тогда
			ИмяПараметра = СокрЛП(Лев(СтрокаСвойств, ВхождениеРавно - 1));
			ЗначениеПараметра = СокрЛП(Сред(СтрокаСвойств, ВхождениеРавно + 1));
			Если НЕ ПустаяСтрока(ИмяПараметра) Тогда
				СоответствиеРезультат.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СоответствиеРезультат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИзменитьСоставТеговПодписантВБухгалтерскойОтчетностиПриНеобходимостиНаСервере(Контекст)
	
	КНДБО = Новый Массив;
	КНДБО.Добавить("0710099");
	КНДБО.Добавить("0710098");
	КНДБО.Добавить("0710097");
	КНДБО.Добавить("0710096");
	
	ИмяТегаКНДБО = "КНД";
	
	ТекстВыгрузки = Контекст.ТекстВыгрузки;
	
	// загружаем файл XML в дерево
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , ТекстВыгрузки);
	Если ДеревоXML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// убеждаемся еще раз, что файл является файлом выгрузки бухгалтерской отчетности
	РезультатПоиска = ДеревоXML.Строки.Найти(ИмяТегаКНДБО, "Имя", Истина);
	Если РезультатПоиска = Неопределено ИЛИ КНДБО.Найти(РезультатПоиска.Значение) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// ищем теги Подписант
	СоответствиеФИОТегамПодписант = Новый Соответствие;
	Подписанты = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "Подписант", "Э"), Истина);
	Если Подписанты.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	// получаем ФИО подписантов из абонентских сертификатов подписи
	ФИОПодписантовИзСертификатов = ПолучитьФИОПодписантовИзСвойствУчетнойЗаписи(Контекст);
	
	// определяем ФИО для каждого из узлов Подписант
	Для Каждого Подписант Из Подписанты Цикл
		
		УзелФИО = Подписант.Строки.Найти("ФИО", "Имя");
		Если УзелФИО = Неопределено Тогда // неизвестный формат файла выгрузки
			Возврат;
		КонецЕсли;
		
		УзелФамилия = Подписант.Строки.Найти("Фамилия", "Имя", Истина);
		УзелИмя = Подписант.Строки.Найти("Имя", "Имя", Истина);
		УзелОтчество = Подписант.Строки.Найти("Отчество", "Имя", Истина);
		
		СтрФамилия = ?(УзелФамилия = Неопределено, "", СокрЛП(УзелФамилия.Значение));
		СтрИмя = ?(УзелИмя = Неопределено, "", СокрЛП(УзелИмя.Значение));
		СтрОтчество = ?(УзелОтчество = Неопределено, "", СокрЛП(УзелОтчество.Значение));
		
		СтрФИО = СокрЛП(СтрФамилия + " " + СтрИмя + " " + СтрОтчество);
		
		СоответствиеФИОТегамПодписант.Вставить(СтрФИО, Подписант);
		
	КонецЦикла;
	
	// ищем узлы Подписант, соответствующие ФИО в сертификатах
	УзлыПодписантовИзСертификата = Новый Массив;
	Для Каждого ФИОПодписантаИзСертификата Из ФИОПодписантовИзСертификатов Цикл
		УзелПодписантаИзСертификата = СоответствиеФИОТегамПодписант[ФИОПодписантаИзСертификата];
		Если УзелПодписантаИзСертификата <> Неопределено Тогда
			УзлыПодписантовИзСертификата.Добавить(УзелПодписантаИзСертификата);
		КонецЕсли;
	КонецЦикла;
	
	// вычисляем, не удалим ли мы все узлы Подписант, если очистим от несоответствующих сертификатам
	Если УзлыПодписантовИзСертификата.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// удаляем узел, не соответствующий подписанту из сертификата
	Для Каждого Подписант Из Подписанты Цикл
		Если УзлыПодписантовИзСертификата.Найти(Подписант) = Неопределено Тогда
			Подписант.Родитель.Строки.Удалить(Подписант);
		КонецЕсли;
	КонецЦикла;
	
	// пишем полученное дерево в тот же файл, откуда считали
	ДеревоXML.Колонки.Имя.Имя = "Код";
	ТекстВыгрузки = ВыгрузитьДеревоВXML_ПФР(ДеревоXML);
	
	Контекст.Вставить("ТекстВыгрузки", ТекстВыгрузки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПриложенияКБухгалтерскойОтчетности(Контекст)
	
	Док = Контекст.Документ;
	
	Если ТипЗнч(Док) <> Тип("ДокументСсылка.РегламентированныйОтчет")
	ИЛИ (Док.ИсточникОтчета <> "РегламентированныйОтчетБухОтчетность" И Док.ИсточникОтчета <> "РегламентированныйОтчетБухОтчетностьМП") Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстВыгрузки = Контекст.ТекстВыгрузки;
	
	// объявляем массив-результат
	ПриложенияКБО = Новый Массив;
	
	// получаем сведения о расположении файлов с приложениями из документа
	Попытка
		СтруктураПриложения = Док.ДанныеОтчета.Получить().СписокДополнительныхФайлов;
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка получения сведений о приложениях из документа бухгалтерской отчетности.';
								|en = 'Ошибка получения сведений о приложениях из документа бухгалтерской отчетности.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	ЗаписьРегистраСведений = РегистрыСведений.ДополнительныеФайлыРегламентированныхОтчетов.СоздатьМенеджерЗаписи();
	ЗаписьРегистраСведений.РегламентированныйОтчет = Док.Ссылка;
	ЗаписьРегистраСведений.ВидДополнительногоФайла = "Пояснительная записка";
	ЗаписьРегистраСведений.Прочитать();
	Если НЕ ПустаяСтрока(ЗаписьРегистраСведений.ВидДополнительногоФайла) Тогда
		СтрПояснительнаяЗаписка = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрПояснительнаяЗаписка.Тип = "ПояснительнаяЗаписка";
		ДанныеДопФайла = ЗаписьРегистраСведений.СодержимоеФайла.Получить();
		СтрПояснительнаяЗаписка.ПолноеИмяФайла = ПоместитьВоВременноеХранилище(ДанныеДопФайла, Контекст.УникальныйИдентификатор);
		СтрПояснительнаяЗаписка.ВХранилище = Истина;
		ПриложенияКБО.Добавить(СтрПояснительнаяЗаписка);
		
	ИначеЕсли СтруктураПриложения.Свойство("ИмяФайлаПояснительнойЗаписки")
	И ЗначениеЗаполнено(СтруктураПриложения.ИмяФайлаПояснительнойЗаписки) Тогда
		СтрПояснительнаяЗаписка = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрПояснительнаяЗаписка.Тип = "ПояснительнаяЗаписка";
		СтрПояснительнаяЗаписка.ПолноеИмяФайла = СтруктураПриложения.ИмяФайлаПояснительнойЗаписки;
		СтрПояснительнаяЗаписка.ВХранилище = Ложь;
		ПриложенияКБО.Добавить(СтрПояснительнаяЗаписка);
	КонецЕсли;
	
	ЗаписьРегистраСведений = РегистрыСведений.ДополнительныеФайлыРегламентированныхОтчетов.СоздатьМенеджерЗаписи();
	ЗаписьРегистраСведений.РегламентированныйОтчет = Док.Ссылка;
	ЗаписьРегистраСведений.ВидДополнительногоФайла = "Аудиторское заключение";
	ЗаписьРегистраСведений.Прочитать();
	Если НЕ ПустаяСтрока(ЗаписьРегистраСведений.ВидДополнительногоФайла) Тогда
		СтрАудиторскоеЗаключение = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрАудиторскоеЗаключение.Тип = "АудиторскоеЗаключение";
		ДанныеДопФайла = ЗаписьРегистраСведений.СодержимоеФайла.Получить();
		СтрАудиторскоеЗаключение.ПолноеИмяФайла = ПоместитьВоВременноеХранилище(ДанныеДопФайла, Контекст.УникальныйИдентификатор);
		СтрАудиторскоеЗаключение.ВХранилище = Истина;
		ПриложенияКБО.Добавить(СтрАудиторскоеЗаключение);
		
	ИначеЕсли СтруктураПриложения.Свойство("ИмяФайлаАудиторскогоЗаключения")
	И ЗначениеЗаполнено(СтруктураПриложения.ИмяФайлаАудиторскогоЗаключения) Тогда
		СтрАудиторскоеЗаключение = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрАудиторскоеЗаключение.Тип = "АудиторскоеЗаключение";
		СтрАудиторскоеЗаключение.ПолноеИмяФайла = СтруктураПриложения.ИмяФайлаАудиторскогоЗаключения;
		СтрАудиторскоеЗаключение.ВХранилище = Ложь;
		ПриложенияКБО.Добавить(СтрАудиторскоеЗаключение);
	КонецЕсли;
	
	ЗаписьРегистраСведений = РегистрыСведений.ДополнительныеФайлыРегламентированныхОтчетов.СоздатьМенеджерЗаписи();
	ЗаписьРегистраСведений.РегламентированныйОтчет = Док.Ссылка;
	ЗаписьРегистраСведений.ВидДополнительногоФайла = "Заявление союза сельхозпроизводителей";
	ЗаписьРегистраСведений.Прочитать();
	Если НЕ ПустаяСтрока(ЗаписьРегистраСведений.ВидДополнительногоФайла) Тогда
		СтрЗаявлениеРевизионногоСоюза = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрЗаявлениеРевизионногоСоюза.Тип = "ЗаявлениеРевизионногоСоюза";
		ДанныеДопФайла = ЗаписьРегистраСведений.СодержимоеФайла.Получить();
		СтрЗаявлениеРевизионногоСоюза.ПолноеИмяФайла = ПоместитьВоВременноеХранилище(ДанныеДопФайла, Контекст.УникальныйИдентификатор);
		СтрЗаявлениеРевизионногоСоюза.ВХранилище = Истина;
		ПриложенияКБО.Добавить(СтрЗаявлениеРевизионногоСоюза);
		
	ИначеЕсли СтруктураПриложения.Свойство("ИмяФайлаЗаявленияРевизионногоСоюза")
	И ЗначениеЗаполнено(СтруктураПриложения.ИмяФайлаЗаявленияРевизионногоСоюза) Тогда
		СтрЗаявлениеРевизионногоСоюза = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого, ВХранилище");
		СтрЗаявлениеРевизионногоСоюза.Тип = "ЗаявлениеРевизионногоСоюза";
		СтрЗаявлениеРевизионногоСоюза.ПолноеИмяФайла = СтруктураПриложения.ИмяФайлаЗаявленияРевизионногоСоюза;
		СтрЗаявлениеРевизионногоСоюза.ВХранилище = Ложь;
		ПриложенияКБО.Добавить(СтрЗаявлениеРевизионногоСоюза);
	КонецЕсли;
	
	// получаем сведения об именах файлов с приложениями из текста выгрузки
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , ТекстВыгрузки, ОписаниеОшибки);
	Если ДеревоXML = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка разбора XML файла выгрузки бухгалтерской отчетности:
                               |';
                               |en = 'Ошибка разбора XML файла выгрузки бухгалтерской отчетности:
                               |'" + ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелНаимФайлПЗ = ДеревоXML.Строки.Найти("НаимФайлПЗ", "Имя", Истина);
	Если УзелНаимФайлПЗ <> Неопределено И ЗначениеЗаполнено(СтрПояснительнаяЗаписка) Тогда
		СтрПояснительнаяЗаписка.ИмяФайла = СокрЛП(УзелНаимФайлПЗ.Значение);
	КонецЕсли;
	
	УзелНаимФайлАЗ = ДеревоXML.Строки.Найти("НаимФайлАЗ", "Имя", Истина);
	Если УзелНаимФайлАЗ <> Неопределено И ЗначениеЗаполнено(СтрАудиторскоеЗаключение) Тогда
		СтрАудиторскоеЗаключение.ИмяФайла = СокрЛП(УзелНаимФайлАЗ.Значение);
	КонецЕсли;
	
	УзелНаимФайлЗСХП = ДеревоXML.Строки.Найти("НаимФайлЗСХП", "Имя", Истина);
	Если УзелНаимФайлЗСХП <> Неопределено И ЗначениеЗаполнено(СтрЗаявлениеРевизионногоСоюза) Тогда
		СтрЗаявлениеРевизионногоСоюза.ИмяФайла = СокрЛП(УзелНаимФайлЗСХП.Значение);
	КонецЕсли;
	
	Для Каждого Стр Из ПриложенияКБО Цикл
		Стр.ТипСодержимого = ТипСодержимогоПоИмениФайла(Стр.ИмяФайла);
	КонецЦикла;
	
	Контекст.Вставить("ПриложенияКБО", ПриложенияКБО);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьПриложенияКБухгалтерскойОтчетностиИзХранилищаВнешнихЭлектронныхПредставлений(Контекст)
	
	СоответствиеТипаПриложенияСтроковомуИдентификатору = Новый Соответствие;
	СоответствиеТипаПриложенияСтроковомуИдентификатору.Вставить(Перечисления.ТипыФайловБухОтчетности.АудиторскоеЗаключение, "АудиторскоеЗаключение");
	СоответствиеТипаПриложенияСтроковомуИдентификатору.Вставить(Перечисления.ТипыФайловБухОтчетности.ПояснительнаяЗаписка, "ПояснительнаяЗаписка");
	СоответствиеТипаПриложенияСтроковомуИдентификатору.Вставить(Перечисления.ТипыФайловБухОтчетности.ЗаявлениеСоюзаСельхозПроизводителей, "ЗаявлениеРевизионногоСоюза");
	
	ПриложенияКБО = Новый Массив;
	
	СтрПредставления = ИзвлечьЭлектронныеПредставленияИзХранилища(Контекст.Документ);
	Для Каждого СтрПредставление Из СтрПредставления Цикл
		Если СоответствиеТипаПриложенияСтроковомуИдентификатору[СтрПредставление.ТипФайлаОтчетности] <> Неопределено Тогда
			СтрПриложение = Новый Структура("Тип, ИмяФайла, ПолноеИмяФайла, ТипСодержимого");
			СтрПриложение.Тип = СоответствиеТипаПриложенияСтроковомуИдентификатору[СтрПредставление.ТипФайлаОтчетности];
			СтрПриложение.ИмяФайла = СтрПредставление.ИмяФайла;
			СтрПриложение.ПолноеИмяФайла = ПоместитьВоВременноеХранилище(СтрПредставление.Данные, Контекст.УникальныйИдентификатор);
			СтрПриложение.ТипСодержимого = ТипСодержимогоПоИмениФайла(СтрПредставление.ИмяФайла);
			ПриложенияКБО.Добавить(СтрПриложение);
		КонецЕсли;
	КонецЦикла;
	
	Контекст.Вставить("ПриложенияКБО", ПриложенияКБО);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПриложенияКБухгалтерскойОтчетности(Контекст, ВыполняемоеОповещение)
	
	ТипОтправляемогоДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ТипОтправляемогоДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		Если НЕ ВыгрузитьПриложенияКБухгалтерскойОтчетностиИзХранилищаВнешнихЭлектронныхПредставлений(Контекст) Тогда // сервер
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Иначе
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
	Иначе
		
		// получаем имена файлов приложений к бухгалтерской отчетности, если они есть
		РезультатПолучения = ПолучитьПриложенияКБухгалтерскойОтчетности(Контекст);
		Если РезультатПолучения = Неопределено Тогда
			Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
		Результат = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

