&НаСервереБезКонтекста
Процедура ИзвлечьЭлектронноеПредставлениеИзХранилища(Владелец, ИмяФайла, Данные, ВозможныеТипыФайла = Неопределено) Экспорт
	
	ТипыПриложенийБО = Новый Массив;
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.АудиторскоеЗаключение);
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.ЗаявлениеСоюзаСельхозПроизводителей);
	ТипыПриложенийБО.Добавить(Перечисления.ТипыФайловБухОтчетности.ПояснительнаяЗаписка);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла,
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.Данные
						  |	, ВЫБОР
						  |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						  |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						  |	ИНАЧЕ
						  |		Истина
						  |	КОНЕЦ ВАрхиве
	                      |ИЗ
	                      |	РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов КАК ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
						  |
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						  |			ПО 		(СостояниеОбъектов.Объект = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление)
						  |				И	(СостояниеОбъектов.ИмяФайла = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла)
						  |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов))
						  |
	                      |ГДЕ
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление = &ЭлектронноеПредставление
	                      |	И НЕ (ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности В(&ТипыПриложенийБО))");
	Запрос.УстановитьПараметр("ТипыПриложенийБО", ТипыПриложенийБО);
	Если ЗначениеЗаполнено(ВозможныеТипыФайла) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности В (&ВозможныеТипыФайла)";
		Запрос.УстановитьПараметр("ВозможныеТипыФайла", ВозможныеТипыФайла);
	КонецЕсли;
	Запрос.УстановитьПараметр("ЭлектронноеПредставление", Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ИмяФайла = СокрЛП(Выборка.ИмяФайла);
			Если Выборка.ВАрхиве Тогда
				Данные = Неопределено;
				Возврат;
			КонецЕсли;
			Данные = Выборка.Данные;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ИмяФайла = "";
	Данные = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзвлечьЭлектронныеПредставленияИзХранилища(Владелец, Знач ЛимитЗаписей = 0) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ИмяФайла");
	ТаблицаРезультат.Колонки.Добавить("Данные");
	ТаблицаРезультат.Колонки.Добавить("ТипФайлаОтчетности");
	ТаблицаРезультат.Колонки.Добавить("ВАрхиве");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ //$Ограничение
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла,
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ТипФайлаОтчетности
						  |	, ВЫБОР
						  |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						  |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						  |	ИНАЧЕ
						  |		Истина
						  |	КОНЕЦ ВАрхиве
	                      |ИЗ
	                      |	РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов КАК ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
						  |
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						  |			ПО 		(СостояниеОбъектов.Объект = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление)
						  |				И	(СостояниеОбъектов.ИмяФайла = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла)
						  |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов))
						  |
	                      |ГДЕ
	                      |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление = &ЭлектронноеПредставление";
	
	Если ЛимитЗаписей > 0 Тогда
		ТекстОграничения = "ПЕРВЫЕ " + СокрЛП(Формат(ЛимитЗаписей, "ЧДЦ=; ЧН=; ЧГ="));
	Иначе
		ТекстОграничения = "";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "//$Ограничение", ТекстОграничения);	 
	
	Запрос.УстановитьПараметр("ЭлектронноеПредставление", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.ИмяФайла 			= Выборка.ИмяФайла;
			НоваяСтрока.ТипФайлаОтчетности 	= Выборка.ТипФайлаОтчетности;
			НоваяСтрока.ВАрхиве 			= Выборка.ВАрхиве;
			Если Выборка.ВАрхиве Тогда
				НоваяСтрока.Данные 			= Base64Значение("");
			Иначе
				НоваяСтрока.Данные 			= ДанныеОдногоФайлаЭлектронногоПредставления(Владелец, Выборка.ИмяФайла);
			КонецЕсли;
		КонецЦикла;
		
		Возврат ТаблицаРезультат;
		
	КонецЕсли;
	
КонецФункции

