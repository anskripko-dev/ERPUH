	ПараметрыДлительнойОтправки.Вставить("СведенияОбОтчете", СведенияОбОтчете);
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ЗагрузитьМашиночитаемуюДоверенностьФССПослеОтправки", 0.1, Истина);
	
