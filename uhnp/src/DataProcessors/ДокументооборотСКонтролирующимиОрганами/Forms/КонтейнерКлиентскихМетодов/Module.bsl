Функция ТипФайлаВыгрузкиЦенаПродукцииГОЗ()
	
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	Возврат МодульДокументооборотСМинобороныКлиентСервер.ТипФайлаВыгрузкиЦенаПродукцииГОЗ();
	
КонецФункции

#КонецОбласти 

&НаКлиенте
Процедура ЗапроситьВыпискуОперацийПоРасчетуСБюджетом(ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗапроситьВыпискуОперацийПоРасчетуСБюджетом_ПослеОтправки", 
		ЭтотОбъект, 
		ВходящийКонтекст); 
	
	ЗапросИОН = СоздатьВыпискуОперацийПоРасчетуСБюджетом(
		ВходящийКонтекст.Организация, 
		ВходящийКонтекст.РегистрацияВНалоговомОргане, 
		ВходящийКонтекст.Год);
		
	ВходящийКонтекст.Вставить("ЗапросИОН", ЗапросИОН);
		
	ОтправкаЗапросаНаИнформационноеОбслуживание(ЗапросИОН, ВходящийКонтекст.Организация,  ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВыпискуОперацийПоРасчетуСБюджетом_ПослеОтправки(Результат, ВходящийКонтекст) Экспорт
	
	ЗапросИОН = ВходящийКонтекст.ЗапросИОН;
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, ЗапросИОН);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьВыпискуОперацийПоРасчетуСБюджетом(Организация, РегистрацияВНалоговомОргане, Год)

	ЗапросИОН 						= Документы.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика.СоздатьДокумент();
	ЗапросИОН.Дата 		 			= ТекущаяДатаСеанса();
	ЗапросИОН.Организация 			= Организация;
	ЗапросИОН.Получатель 			= РегистрацияВНалоговомОргане;
	ЗапросИОН.ДатаНачалаПериода 	= Дата(Год, 1, 1);	
	Если Год(ТекущаяДатаСеанса()) <> Год(ЗапросИОН.ДатаНачалаПериода) Тогда
		ЗапросИОН.ДатаОкончанияПериода 	= НачалоДня(КонецГода(ЗапросИОН.ДатаНачалаПериода));
	Иначе
		ЗапросИОН.ДатаОкончанияПериода 	= НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	ЗапросИОН.ВидУслуги 			= Перечисления.ВидыУслугПриИОН.ПредставлениеВыпискиОперацийИзКарточкиРасчетыСБюджетом;
	ЗапросИОН.ТипСверки             = Перечисления.ТипыСверокИОН.ПоОдномуКППВОднуФНС;
	ЗапросИОН.ФорматОтвета 			= Перечисления.ФорматОтветаНаЗапросИОН.XML;
	ЗапросИОН.ФорматЗапроса 		= Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЗапросИОН.КоличествоНалогов 	= Перечисления.КоличествоЭлементовДляСверкиИОН.Все;
	
	ЗапросИОН.Записать();
	
	Возврат ЗапросИОН.Ссылка;

КонецФункции

&НаКлиенте
Процедура ВключаемыйСертификатНажатие(Форма, ОповещениеОЗавершении, ПараметрыФормы = Неопределено) Экспорт
	
	РежимВыбора = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФормы, "РежимВыбора", "");
	
	Если Форма.ЗапретитьИзменение И РежимВыбора <> "МестоХранения" 
		ИЛИ Форма.ЭтоОткрытиеСВыбраннойЭЦП И Форма.ВключаемыйСертификат <> Неопределено Тогда
		
		КриптографияЭДКОКлиент.ПоказатьСертификат(Форма.ВключаемыйСертификат, Форма);
		Возврат;
		
	КонецЕсли;
	
	РезультатПроверки = ОбработкаЗаявленийАбонентаКлиентСервер.РезультатПроверкиДанныхДляОтбораСертификатов(Форма, Ложь);
		
	Если РежимВыбора = "Сертификат" 
		И РезультатПроверки.ЕстьОшибка Тогда
		
		ТекстОшибки = ОбработкаЗаявленийАбонентаКлиентСервер.ТекстОшибкиНеНайденоНиОдногоСертификата(Форма, Ложь);
		ПоказатьПредупреждение(, ТекстОшибки);
			
	Иначе
		
		ПоказатьФормуВыбораМестаХраненияСертификата(
			Форма, 
			ОповещениеОЗавершении, 
			РежимВыбора, 
			ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФормуВыбораМестаХраненияСертификата(Форма, ОповещениеОЗавершении, РежимВыбора, ПараметрыФормы) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ПредлагатьУстановкуРасширения", Истина);
	ДополнительныеПараметры.Вставить("РежимВыбора", РежимВыбора);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВключаемыйСертификатНажатие_Завершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ДополнительныеПараметры = ПараметрыОткрытияФормыВыбораСуществующегоСертификата(Форма);
	Если ПараметрыФормы <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДополнительныеПараметры, ПараметрыФормы, Истина);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("РежимВыбора", РежимВыбора);

	ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_ВыборВключаемогоСертификата", ДополнительныеПараметры,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключаемыйСертификатНажатие_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	Форма                 = ВходящийКонтекст.Форма;
	ПредлагатьУстановкуРасширения = ВходящийКонтекст.ПредлагатьУстановкуРасширения;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	Форма.РежимРаботыСКлючами = Результат.РежимРаботыСКлючами;
	
	Если ВходящийКонтекст.РежимВыбора = "Сертификат" Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Результат);
		
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			Форма.ИдентификаторПолученияСпискаОблачныхСертификатов = Результат.ИдентификаторПроверки;
			Форма.ОблачныеСертификатыКалуги = Результат.ОблачныеСертификатыКалуги;
			
			Форма.ТелефонМобильныйДляПаролей = Результат.ТелефонМобильныйДляПаролей;
			Форма.ТелефонМобильный  = Результат.ТелефонМобильныйДляПаролей;
			
			ОткрытьСписокВключаемыхСертификатовИлиПредупредить(Форма, ОповещениеОЗавершении);
			
		ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
			ОткрытьСписокВключаемыхСертификатовОблачнойПодписи(МестоХраненияКлюча, ОповещениеОЗавершении);
			
		ИначеЕсли Результат.ВыбранТокен Тогда
			
			ОбработкаЗаявленийАбонентаКлиент.НайтиИУстановитьСертификатСТокена(
				Форма,
				ОповещениеОЗавершении);
			
		Иначе
			
			ПолучитьИОткрытьСписокЛокальныхСертификатовКалуги(Форма, ОповещениеОЗавершении, ПредлагатьУстановкуРасширения)
			
		КонецЕсли;
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокВключаемыхСертификатовИлиПредупредить(Форма, ОповещениеОЗавершении)
	
	Если Форма.ОблачныеСертификатыКалуги.Количество() = 0 Тогда
		
		Текст = НСтр("ru = 'Не найдено ни одного сертификата из программы для ИНН %2 и телефона %1';
					|en = 'Не найдено ни одного сертификата из программы для ИНН %2 и телефона %1'");
		Текст = СтрШаблон(Текст, Форма.ТелефонМобильныйДляПаролей, Форма.ИНН);
		
		ПоказатьПредупреждение(, Текст);
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
		
	Иначе
		ОткрытьСписокОблачныхСертификатовКалуги(Форма, ОповещениеОЗавершении);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИОткрытьСписокЛокальныхСертификатовКалуги(Форма, ОповещениеОЗавершении, ПредлагатьУстановкуРасширения) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьИОткрытьСписокЛокальныхСертификатовКалуги_ПослеПолученияСертификатов", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", ПредлагатьУстановкуРасширения);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	Хранилище = Новый Структура("Хранилище, ЭтоЛокальноеХранилище", "MY", Истина);
	КриптографияЭДКОКлиент.ПолучитьСертификаты(ОписаниеОповещения, Хранилище, ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИОткрытьСписокЛокальныхСертификатовКалуги_ПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	Форма = ВходящийКонтекст.Форма;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	Форма.ВсеСертификаты = Результат.Сертификаты;
	НаденныеСертификаты  = СертификатыПоРеквизитамОрганизацииИВладельца(Форма, Ложь);
	Форма.СертификатыОрганизацииПоИНН.ЗагрузитьЗначения(НаденныеСертификаты);
	
	Если Форма.СертификатыОрганизацииПоИНН.Количество() = 0 Тогда
		
		Форма.СообщитьОбОтсутствииПодходящихСертификатов(Форма);
		
	Иначе
		
		Форма.ОткрытьСписокЛокальныхСертификатовКалуги(ОповещениеОЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьКлючевыеРеквизитыСертификата(Субъект) Экспорт

	ПолеINNФЛ   = "INN";
	ПолеINNЮЛ   = "INNLE";
	ПолеСНИЛС   = "SNILS";
	ПолеИмя     = "GN";
	ПолеФамилия = "SN";
	
	ЕстьИНН = Субъект.Свойство(ПолеINNФЛ) ИЛИ Субъект.Свойство(ПолеINNЮЛ);
	
	ЕстьОшибка = 
		НЕ ЕстьИНН
		ИЛИ НЕ Субъект.Свойство(ПолеСНИЛС)
		ИЛИ НЕ Субъект.Свойство(ПолеИмя)
		ИЛИ НЕ Субъект.Свойство(ПолеФамилия);
		
	Возврат НЕ ЕстьОшибка;
		
КонецФункции

&НаКлиенте
Функция СертификатыПоРеквизитамОрганизацииИВладельца(Форма, ПроверятьЗаполненностьДанныхДляОтбора) Экспорт
	
	НайденныеСертификаты = Новый Массив;
	
	Если ПроверятьЗаполненностьДанныхДляОтбора Тогда
		
		ЕстьОшибка = ОбработкаЗаявленийАбонентаКлиентСервер.РезультатПроверкиДанныхДляОтбораСертификатов(Форма, Ложь).ЕстьОшибка;
		Если ЕстьОшибка Тогда
			Возврат НайденныеСертификаты;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоБыстрыйСтарт = ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаБыстрыйСтарт(Форма);
	
	Для каждого НайденныйСертификат Из Форма.ВсеСертификаты Цикл
		
		Субъект = НайденныйСертификат.ВладелецСтруктура;
		
		Если НЕ ЕстьКлючевыеРеквизитыСертификата(Субъект) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоСертификатВладельца(Форма, Субъект) Тогда
			
			// Валидность
			Валиден = 
				НайденныйСертификат.ДействителенС < ТекущаяДата() 
				И НайденныйСертификат.ДействителенПо > ТекущаяДата();
				
			Если Валиден ИЛИ ЭтоБыстрыйСтарт Тогда
				НайденныйСертификат.Вставить("Валиден", Валиден);
				
				НайденныеСертификаты.Добавить(НайденныйСертификат);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныеСертификаты;
	
КонецФункции

&НаКлиенте
Функция ПараметрыОткрытияФормыВыбораСуществующегоСертификата(Форма) Экспорт
	
	// Все эти параметры должны быть в реквизитах формы Мастер_ВыборВключаемогоСертификата
	ПараметрыФормы = 
		"ТелефонМобильныйДляПаролей,
		|ИгнорироватьКонфликт,
		|CryptoProCSPУстановлен,
		|ViPNetCSPУстановлен,
		|КрасныйЦвет,
		|ИНН,
		|КомпонентаДляРаботыСКриптографиейПодключена,
		|РежимРаботыСКлючами,
		|ВладелецЭЦПТип,
		|ЭтоМультиРежим";
	
	ДополнительныеПараметры = Новый Структура(ПараметрыФормы);
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, Форма, ПараметрыФормы); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСписокОблачныхСертификатовКалуги(Форма, ОповещениеОЗавершении)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьСписокОблачныхСертификатовКалуги_ПослеВыбора", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОблачныеСертификатыКалуги", Форма.ОблачныеСертификатыКалуги);
	
	Если Форма.ВключаемыйСертификат = Неопределено Тогда
		ДополнительныеПараметры.Вставить("ОтпечатокВключаемогоСертификата", "");
	Иначе
		ДополнительныеПараметры.Вставить("ОтпечатокВключаемогоСертификата", Форма.ВключаемыйСертификат.Отпечаток);
	КонецЕсли;
		
	ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_ВыборОблачногоВключаемогоСертификата", ДополнительныеПараметры,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокОблачныхСертификатовКалуги_ПослеВыбора(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВыбранныйСертификат = Результат;
	КонтекстМоделиХраненияКлюча(Истина, ВыбранныйСертификат);
	
	ВходящийКонтекст.Вставить("ВыбранныйСертификат", ВыбранныйСертификат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьСписокОблачныхСертификатовКалуги_ПослеПоиска", 
		ЭтотОбъект,
		ВходящийКонтекст);
	
	КриптографияЭДКОКлиент.НайтиСертификат(
		ОписаниеОповещения,
		ВыбранныйСертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокОблачныхСертификатовКалуги_ПослеПоиска(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если НЕ Результат.Выполнено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удается использовать выбранный сертификат по причине: ';
										|en = 'Не удается использовать выбранный сертификат по причине: '" + Результат.ОписаниеОшибки));
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВыбранныйСертификат = ВходящийКонтекст.ВыбранныйСертификат;
	КонтекстМоделиХраненияКлюча(Истина, ВыбранныйСертификат);
	
	Если Результат.СертификатНайден Тогда
		
		ОткрытьСписокОблачныхСертификатовКалуги_ПослеВыбораОблачногоСертификата(Результат, ВходящийКонтекст);
		
	Иначе
		
		ДвДанные = Base64Значение(ВыбранныйСертификат.Base64);
		ИмпортироватьОблачныйСертификат(ДвДанные);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьСписокОблачныхСертификатовКалуги_ПослеВыбораОблачногоСертификата", 
			ЭтотОбъект,
			ВходящийКонтекст);
		
		КриптографияЭДКОКлиент.НайтиСертификат(
			ОписаниеОповещения,
			ВыбранныйСертификат);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокОблачныхСертификатовКалуги_ПослеВыбораОблачногоСертификата(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если НЕ Результат.Выполнено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось использовать выбранный сертификат по причине: ';
										|en = 'Не удалось использовать выбранный сертификат по причине: '" + Результат.ОписаниеОшибки));
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВключаемыйСертификат", 			Результат.СвойстваСертификата);
	ДополнительныеПараметры.Вставить("ВключаемыйСертификатОблачный", 	Истина);
	ДополнительныеПараметры.Вставить("ЭтоСертификатДругогоУЦ", 			Ложь);
	ДополнительныеПараметры.Вставить("МестоХраненияКлюча", 				КонтекстМоделиХраненияКлюча(Истина));
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ИмпортироватьОблачныйСертификат(ДвДанные)
	
	ХранилищеСертификатов.Добавить(ДвДанные, Перечисления.ТипХранилищаСертификатов.ПерсональныеСертификаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокЛокальныхСертификатовКалуги(Форма, ОповещениеОЗавершении) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("Форма", Форма);

	ОтпечаткиЗапрещенных = ОтпечаткиЗапрещенныхСертификатовСУЦ(Форма);
	ОтпечаткиВсе = ОтпечаткиЛокальныхСертификатовКалуги(Форма);
	
	Если Форма.ВключаемыйСертификат = Неопределено Тогда
		ТекущийОтпечаток = "";
	Иначе
		ТекущийОтпечаток = Форма.ВключаемыйСертификат.Отпечаток;
	КонецЕсли;
	
	ТекстПредупреждения = НСтр("ru = 'Сертификат не может быть использован, поскольку он выдан удостоверяющим центром, который не входит в список доверенных удостоверяющих центров оператора ""Калуга Астрал"".';
								|en = 'Сертификат не может быть использован, поскольку он выдан удостоверяющим центром, который не входит в список доверенных удостоверяющих центров оператора ""Калуга Астрал"".'");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеВыбораЛокальногоСертификатаВЗаявлении", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	КриптографияЭДКОКлиент.ВыбратьСертификат(
		ОписаниеОповещения,
		Ложь,
		ТекущийОтпечаток,
		"My",
		Ложь,
		Ложь,
		ОтпечаткиВсе,
		Ложь,
		,
		ОтпечаткиЗапрещенных,
		ТекстПредупреждения);
	
КонецПроцедуры
	
&НаКлиенте
Функция ОтпечаткиЛокальныхСертификатовКалуги(Форма) Экспорт
	
	Отпечатки = Новый СписокЗначений;
		
	Для каждого СертификатОрганизации Из Форма.СертификатыОрганизацииПоИНН Цикл
		
		Сертификат = СертификатОрганизации.Значение; 
		
		Отпечаток  = Сертификат.Отпечаток;
		Отпечатки.Добавить(Отпечаток);
		
	КонецЦикла;
	
	Возврат Отпечатки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьCNsПоФорме(Форма)
	
	Если ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаПервичногоЗаявления(Форма)
		ИЛИ ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаВторичногоЗаявления(Форма) Тогда
		
		CNsСУЦ = Форма.CNsСУЦ;
		АдресЗадания = Форма.АдресЗаданияПоПолучениюДанныхССервераКА;
		
	ИначеЕсли ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаПервичногоЗаявления(Форма.ВладелецФормы)
		ИЛИ ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаВторичногоЗаявления(Форма.ВладелецФормы) Тогда
		
		CNsСУЦ = Форма.ВладелецФормы.CNsСУЦ;
		АдресЗадания = Форма.ВладелецФормы.АдресЗаданияПоПолучениюДанныхССервераКА;
		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(CNsСУЦ) И ЗначениеЗаполнено(АдресЗадания) Тогда
		CNsСУЦ = CNsСУЦПоАдресуЗадания(АдресЗадания);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(CNsСУЦ) Тогда
		CNsСУЦ = CNsДоверенныхСтороннихУЦ();
	КонецЕсли;
	
	Возврат CNsСУЦ;
	
КонецФункции

&НаСервере
Функция CNsДоверенныхСтороннихУЦ(ДоверенныеСторонниеУЦ = Неопределено) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.CNsДоверенныхСтороннихУЦ(ДоверенныеСторонниеУЦ);
	
КонецФункции

&НаСервере
Функция CNsСУЦПоАдресуЗадания(АдресЗадания)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.CNsСУЦПоАдресуЗадания(АдресЗадания);

КонецФункции
	
&НаКлиенте
Функция ОтпечаткиЗапрещенныхСертификатовСУЦ(Форма)
	
	CNsСУЦ    = ПолучитьCNsПоФорме(Форма);
	Отпечатки = Новый СписокЗначений;
	
	СертификатыОрганизации = Форма.СертификатыОрганизацииПоИНН;
	
	Для каждого Сертификат Из СертификатыОрганизации Цикл
		
		СвойстваСертификата = Сертификат.Значение;
		
		Если СвойстваСертификата.Свойство("ПоставщикСтруктура")
			И СвойстваСертификата.Свойство("ПоставщикСтруктура") Тогда 
			CN = СвойстваСертификата.ПоставщикСтруктура.CN;
		Иначе
			Продолжить;
		КонецЕсли;
			
		ЭтоСертификатКалуги = ЭтоСертификатКалуги(СвойстваСертификата);
		ЭтоСертификатДоверенногоСУЦ = ЭтоДоверенныйСтороннийУЦ(CN, CNsСУЦ);

		Если НЕ ЭтоСертификатДоверенногоСУЦ И НЕ ЭтоСертификатКалуги Тогда
			Отпечатки.Добавить(СвойстваСертификата.Отпечаток);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Отпечатки;
	
КонецФункции
	
&НаКлиенте
Процедура ПослеВыбораЛокальногоСертификатаВЗаявлении(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	Сертификат = Результат.ВыбранноеЗначение;
	КонтекстМоделиХраненияКлюча(Ложь, Сертификат);
	ВходящийКонтекст.Вставить("Сертификат", Сертификат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьСписокЛокальныхСертификатовКалуги_ПослеПолученияДвДанных", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	ПолучитьДвоичныеДанныеСертификата(ОписаниеОповещения, Сертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокЛокальныхСертификатовКалуги_ПослеПолученияДвДанных(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	Форма = ВходящийКонтекст.Форма;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДвДанныеСертификата") Тогда
		Форма.ДвДанныеСертификата = Результат.ДвДанные;
	КонецЕсли;
	
	Подходит = КриптопровайдерСертификатаПодходит(
		Результат.ДвДанные, 
		Форма.CryptoProCSPУстановлен, 
		Форма.ViPNetCSPУстановлен);
		
	Если НЕ Подходит Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	Сертификат = ВходящийКонтекст.Сертификат;
	
	ЭтоСертификатКалуги = ЭтоСертификатКалуги(Сертификат);

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВключаемыйСертификат", 			Сертификат);
	ДополнительныеПараметры.Вставить("ВключаемыйСертификатОблачный", 	Ложь);
	ДополнительныеПараметры.Вставить("ЭтоСертификатДругогоУЦ", 			НЕ ЭтоСертификатКалуги);
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Функция КриптопровайдерСертификатаПодходит(ДвДанные, CryptoProCSPУстановлен, ViPNetCSPУстановлен) Экспорт
	
	Подходит = Истина;
	
	// Временно возвращаем всегда Истина, т.к. ФНС может писать в сертификат неправильный криптопровайдер.
	Возврат Подходит;
	
	Если НЕ CryptoProCSPУстановлен И НЕ ViPNetCSPУстановлен Тогда
		// Не удалось получить. Не будем препятствовать
		Возврат Подходит;
	КонецЕсли;
	
	Сертификат = Новый Структура("Сертификат", ДвДанные);
	МассивИзОдного = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сертификат);
	
	ИнформацияОСертификате = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьИнформациюОКриптопровайдереПоСертификату(МассивИзОдного);
	
	Если ИнформацияОСертификате.Количество() = 0 Тогда
		// Не удалось получить. Не будем препятствовать
		Возврат Подходит;
	КонецЕсли;
		
	СвойстваКриптопровайдера = ИнформацияОСертификате[0].Криптопровайдер;
	
	Если СвойстваКриптопровайдера = Неопределено Тогда
		// Не удалось получить. Не будем препятствовать
		Возврат Подходит;
	КонецЕсли;
	
	CryptoPro = КриптографияЭДКОКлиентСервер.КриптопровайдерCryptoPro().ТипКриптопровайдера;
	ViPNet    = КриптографияЭДКОКлиентСервер.КриптопровайдерViPNet().ТипКриптопровайдера;
	
	КриптопровайдерСертификата = СвойстваКриптопровайдера.ТипКриптопровайдера;
	
	Подходит = КриптопровайдерСертификата = CryptoPro И CryptoProCSPУстановлен 
		ИЛИ КриптопровайдерСертификата = ViPNet И ViPNetCSPУстановлен;
		
	Если НЕ Подходит Тогда
		
		Шаблон = НСтр("ru = 'Данный сертификат не может быть выбран, т.к. криптопровайдер (%1), на котором был издан сертификат,
			|не соответствует криптопровайдеру, установленному на компьютере (%2)';
			|en = 'Данный сертификат не может быть выбран, т.к. криптопровайдер (%1), на котором был издан сертификат,
			|не соответствует криптопровайдеру, установленному на компьютере (%2)'");
		
		Если CryptoProCSPУстановлен Тогда
			КриптопровайдерКомпьютера = CryptoPro;
		Иначе
			КриптопровайдерКомпьютера = ViPNet;
		КонецЕсли;
			
		Текст = СтрШаблон(Шаблон, Строка(КриптопровайдерСертификата), Строка(КриптопровайдерКомпьютера));
		
		ПоказатьПредупреждение(, Текст);
		
	КонецЕсли;
		
	Возврат Подходит;

КонецФункции

&НаСервере
Функция ЭтоДоверенныйСтороннийУЦ(CN, CNs = Неопределено)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоДоверенныйСтороннийУЦ(CN, CNs);

КонецФункции

&НаКлиенте
Функция ЭтоСертификатКалуги(Сертификат) Экспорт
	
	ПоставщикСтруктура = Сертификат.ПоставщикСтруктура;
	Если ПоставщикСтруктура.Свойство("O") Тогда
		ЭтоСертификатКалуги = ЭтоСертификатУЦКалугиПоИмениУЦ(ПоставщикСтруктура.O);
	Иначе
		ЭтоСертификатКалуги = Ложь;
	КонецЕсли;

	Возврат ЭтоСертификатКалуги;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоСертификатУЦКалугиПоИмениУЦ(ИмяУЦСертификта) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоСертификатУЦКалугиПоИмениУЦ(ИмяУЦСертификта);
	
КонецФункции

&НаКлиенте
Процедура ПолучитьДвоичныеДанныеСертификата(ВыполняемоеОповещение, СвойстваСертификата, Компонента = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДвоичныеДанныеСертификата_ПослеЭкспортаСертификата", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(ОписаниеОповещения, СвойстваСертификата, Ложь, , Компонента);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДвоичныеДанныеСертификата_ПослеЭкспортаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ДвДанные = Base64Значение(Результат.СтрокаBase64);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДвДанные", ДвДанные);
	ДополнительныеПараметры.Вставить("Компонента", Результат.ДвоичныеДанные);

	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПоЕГРЮЛ(ВходящийКонтекст) Экспорт
	
	ПараметрыОперации = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ВходящийКонтекст);
	ПараметрыОперации.Удалить("ОповещениеОЗавершении");
	
	ОбработкаРезультата = Новый ОписаниеОповещения("ОтправитьПакетДокументовВФНСЗавершение", ЭтотОбъект, ВходящийКонтекст);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормированиеПакетаПоЕГРЮЛ",
		ПараметрыОперации,
		,
		,
		,
		,
		ОбработкаРезультата, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
	
#Область ЗаявленияВПФР

&НаКлиенте
Процедура ПредупредитьОЗаявленияхЭДОПФРКлиент() Экспорт
	
	Организации = ОрганизацииПоКоторымНужноПредупредитьОЗаявленияхЭДОПФР();
	
	Если Организации <> Неопределено Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Организации", Организации.Организации);
		ДополнительныеПараметры.Вставить("ОрганизацииПредупредитьПовторно", Организации.ОрганизацииПредупредитьПовторно);
		
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ОтправьтеЗаявлениеЭДОПФР", ДополнительныеПараметры,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОрганизацииПоКоторымНужноПредупредитьОЗаявленияхЭДОПФР() Экспорт
	
	// Нужны только следующие организации:
	// 1. Только если настал срок показать форму
	// 2. Только если есть учетка и текущей пользователь является ее пользователем или полноправным.
	// 3. Только если есть сотрудники
	// 4. Только если не отправлено заявление
	
	ДатаКогдаНапомнить = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_ОтправьтеЗаявлениеЭДОПФР");
	ДатаСеанса = ТекущаяДатаСеанса();
	БезНапоминания = ДатаКогдаНапомнить <> Неопределено И (ДатаКогдаНапомнить = '00010101000000'
		ИЛИ ДатаКогдаНапомнить > ДатаСеанса);
	Если БезНапоминания И ДатаСеанса >= '20200201' Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущиеУчетныеЗаписиНалогоплательщика = ДокументооборотСКО.ТекущиеУчетныеЗаписиНалогоплательщика();
		
	Если ТекущиеУчетныеЗаписиНалогоплательщика.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|	И Организации.УчетнаяЗаписьОбмена В(&ТекущиеУчетныеЗаписиНалогоплательщика)";
	
	Запрос.УстановитьПараметр("ТекущиеУчетныеЗаписиНалогоплательщика", ТекущиеУчетныеЗаписиНалогоплательщика);
	
	// Оставляем организации, доступные текущему пользователю по учетке
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	Иначе
		ОрганизацииТекущегоПользователя = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
		ОрганизацииССотрудниками = Новый Массив;
		Для каждого Организация Из ОрганизацииТекущегоПользователя Цикл
			
			// Оставляем организации с сотрудниками
			ЭтоЮридическоеЛицо = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоЮрЛицо(Организация);
			Если ЭтоЮридическоеЛицо Тогда
				ОрганизацииССотрудниками.Добавить(Организация);
			Иначе
				ИПИспользуетТрудНаемныхРаботников = РегламентированнаяОтчетность.ИПИспользуетТрудНаемныхРаботников(Организация);
				Если ИПИспользуетТрудНаемныхРаботников Тогда
					ОрганизацииССотрудниками.Добавить(Организация);
				КонецЕсли;
			КонецЕсли;
		
		КонецЦикла; 
		
		// Проверяем, что отобранным организациям надо отправить заявление
		Если ОрганизацииССотрудниками.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
		
		НадоПредупредить = Новый Массив;
		НадоПредупредитьПовторно = Новый Массив;
		Для каждого Организация Из ОрганизацииССотрудниками Цикл
			Состояние = КонтекстЭДОСервер.СостояниеЭДОсПФР(Организация);
			Если Состояние.НаПодключение.НужноОтправитьЗаявление И НЕ Состояние.НаОтключение.ОрганизацияОтключена
				ИЛИ Состояние.НаПодключение.НужноОтправитьПовторноеЗаявление Тогда
				НадоПредупредить.Добавить(Организация);
			КонецЕсли;
			Если Состояние.НаПодключение.НужноОтправитьПовторноеЗаявление Тогда
				НадоПредупредитьПовторно.Добавить(Организация);
			КонецЕсли;
		КонецЦикла;
		
		Если НадоПредупредить.Количество() = 0 ИЛИ (БезНапоминания
			И НадоПредупредитьПовторно.Количество() = 0) Тогда
			
			Возврат Неопределено;
		Иначе
			
			Возврат Новый Структура("Организации, ОрганизацииПредупредитьПовторно", НадоПредупредить, НадоПредупредитьПовторно);
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция РеквизитыУчетнойЗаписиОрганизации(Организация) Экспорт
	
	Свойства = "ЭтоЭлектроннаяПодписьВМоделиСервиса, Отпечаток";
	Сертификат = Мультирежим.СертификатПользователя(Организация.УчетнаяЗаписьОбмена, Свойства);
	Если Сертификат.Найден Тогда
		
		ДополнительныеПараметры = Новый Структура(Свойства);
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, Сертификат);
		КонтекстМоделиХраненияКлюча(Организация.УчетнаяЗаписьОбмена, ДополнительныеПараметры);
		 
		Возврат ДополнительныеПараметры;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДвДанныеСертификатаПоОрганизации(Организация, ВыполняемоеОповещение) Экспорт
	
	РеквизитыУчетнойЗаписи = РеквизитыУчетнойЗаписиОрганизации(Организация);
	
	Если РеквизитыУчетнойЗаписи = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	
	Сертификат = Новый Структура();
	Сертификат.Вставить("Отпечаток", РеквизитыУчетнойЗаписи.Отпечаток);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Сертификат);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Отпечаток", РеквизитыУчетнойЗаписи.Отпечаток);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДвДанныеСертификатаПоОрганизации_ПослеПоискаСертификатаПоОтпечатку", 
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.НайтиСертификат(
		ОписаниеОповещения,
		Сертификат,
		Ложь,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвДанныеСертификатаПоОрганизации_ПослеПоискаСертификатаПоОтпечатку(Результат, ВходящийКонтекст) Экспорт
	
	Найден = Ложь;
	Если Результат.Выполнено И Результат.СертификатНайден Тогда
		
		Если ТипЗнч(Результат.СвойстваСертификата) = Тип("ФиксированнаяСтруктура") Тогда
			СвойстваСертификата = Новый Структура(Результат.СвойстваСертификата);
		Иначе
			СвойстваСертификата = Результат.СвойстваСертификата;
		КонецЕсли;
		
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СвойстваСертификата);
		ВходящийКонтекст.Вставить("СвойстваСертификата", СвойстваСертификата);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ДвДанныеСертификатаПоОрганизации_ПослеПолученияBase64", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(ОписаниеОповещения, СвойстваСертификата, Ложь);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Неопределено);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДвДанныеСертификатаПоОрганизации_ПослеПолученияBase64(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ДвДанныеСертификата = Base64Значение(Результат.СтрокаBase64);
		СвойстваСертификата = ВходящийКонтекст.СвойстваСертификата;
		СвойстваСертификата.Вставить("ДвДанныеСертификата", ДвДанныеСертификата);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СвойстваСертификата);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗаявленияПоЭлДокументооборотуСПФР(Заявление) Экспорт
	
	Вид = ПолучитьРеквизитНаСервере(Заявление, "Вид");
	Если Вид = ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.ПустаяСсылка") Тогда
		
		Текст = НСтр("ru = 'Для печати заявления заполните его вид';
					|en = 'Для печати заявления заполните его вид'");
		ПоказатьПредупреждение(, Текст);
		
	Иначе
		
		ПечатнаяФормаЗаявления = ТабличныйДокументЗаявленияПоЭлДокументооборотуСПФР(Заявление);
		НапечататьДокумент(ПечатнаяФормаЗаявления, Строка(Вид));
		
	КонецЕсли;
	
КонецПроцедуры

