	ПараметрыАвтозапроса.Вставить("НомерОтчета", 		КонтекстДлительнойОперации.НомерОтчета);
	ПараметрыАвтозапроса.Вставить("ДатаНачалаОтправки", КонтекстДлительнойОперации.ДатаНачалаОтправки);
	
	ДополнительныеПараметры = Новый Структура();
