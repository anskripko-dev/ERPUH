&НаСервереБезКонтекста
Функция ПечатнаяФормаПодключенияОблачнойПодписи(ПараметрыЦикла) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	МакетПечати = Обработки.ДокументооборотСКонтролирующимиОрганами.ПолучитьМакет("ПодключениеУчетнойЗаписиОблачнойПодписи");
	ТекстЗаголовка = НСтр("ru = 'Данные учетной записи электронной подписи для подключения к сервису и подтверждения операций.';
							|en = 'Данные учетной записи электронной подписи для подключения к сервису и подтверждения операций.'");
	
	МакетЗаголовка = МакетПечати.ПолучитьОбласть("Заголовок");
	МакетЗаголовка.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	ЗаполнитьЗначенияСвойств(МакетЗаголовка.Параметры, ПараметрыЦикла);
	Результат.Вывести(МакетЗаголовка);
	
	Если ПараметрыЦикла.Свойство("Пароль") Тогда
		МакетШапки = МакетПечати.ПолучитьОбласть("Логин");
		ЗаполнитьЗначенияСвойств(МакетШапки.Параметры, ПараметрыЦикла);
		Результат.Вывести(МакетШапки);
	КонецЕсли;
	
	Если ПараметрыЦикла.Свойство("ДанныеКлюча") Тогда
		МакетШапки = МакетПечати.ПолучитьОбласть("Ключ");
		КартинкаКода = МакетШапки.Рисунки.ВекторАутентификации;
		КартинкаКода.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		КартинкаКода.ЦветФона = Новый Цвет();
		КартинкаКода.Картинка = Новый Картинка(ПараметрыЦикла.ДанныеКлюча);
		Результат.Вывести(МакетШапки);
	КонецЕсли;
	
	Если ПараметрыЦикла.Свойство("Инструкция") Тогда
		МакетШапки = МакетПечати.ПолучитьОбласть("Инструкция");
		ЗаполнитьЗначенияСвойств(МакетШапки.Параметры, ПараметрыЦикла);
		Результат.Вывести(МакетШапки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодпись(АдресВоВременномХранилище, ДействиеОблачнойПодписи, ДополнительныеПараметры)
	
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	УчетнаяЗапись = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
	ДанныеОблачнойПодписи = СлужебныеДанныеОблачнойПодписи(АдресВоВременномХранилище, УчетнаяЗапись, ПараметрыРегистрацияПолучитьДанныеССервера.ОблачныйСертификат);
	Успешно = ДанныеОблачнойПодписи.Выполнено;
	ВсеДействия = СтрРазделить(ДействиеОблачнойПодписи, ",", Ложь);
	Если ВсеДействия.Количество() = 0 Тогда
		Успешно = Истина;
	КонецЕсли;
	
	ПараметрыЦикла = Новый Структура;
	ПараметрыЦикла.Вставить("АдресВоВременномХранилище", АдресВоВременномХранилище);
	ПараметрыЦикла.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если НЕ Успешно Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						НСтр("ru = 'Некорректный конфиденциальный блок';
							|en = 'Некорректный конфиденциальный блок'"));

	Иначе
		ВсеДействия = СтрРазделить(ДействиеОблачнойПодписи, ",", Ложь);
		
		ДействиеАктивироватьПароль = ВсеДействия.Найти("АктивироватьПароль") <> Неопределено;
		ДействиеАктивироватьКлючПриложения = ВсеДействия.Найти("АктивироватьКлючПриложенияИПолучитьКодАктивации") <> Неопределено;
		ДействиеПовторныйКлючПриложения = ВсеДействия.Найти("КлючПриложения") <> Неопределено;
		ДействиеОтправитьРасписку = ВсеДействия.Найти("ОтправитьРасписку") <> Неопределено И ЗначениеЗаполнено(ПараметрыФункции.ЗаявлениеПодключения);
		ДействиеПолучитьКодАктивации = ВсеДействия.Найти("ПолучитьКодАктивации") <> Неопределено;
		ДействиеОбновитьСертификаты = ВсеДействия.Найти("ОбновитьСписокСертификатов") <> Неопределено;
		
		ПараметрыЦикла.Вставить("ЗаявлениеПодключения", ПараметрыФункции.ЗаявлениеПодключения);
		ПараметрыЦикла.Вставить("ОблачныйСертификат", ПараметрыРегистрацияПолучитьДанныеССервера.ОблачныйСертификат);
		ПараметрыЦикла.Вставить("ОтпечатокСертификата", ДанныеОблачнойПодписи.ОтпечатокСертификата);
		ПараметрыЦикла.Вставить("УчетнаяЗапись", УчетнаяЗапись);
		ПараметрыЦикла.Вставить("Логин", ДанныеОблачнойПодписи.Логин);
		ПараметрыЦикла.Вставить("Сервер", ДанныеОблачнойПодписи.Владелец);
		ПараметрыЦикла.Вставить("Пароль", ДанныеОблачнойПодписи.Пароль);
		ПараметрыЦикла.Вставить("ДанныеКлюча", ДанныеОблачнойПодписи.КлючПриложения);
		ПараметрыЦикла.Вставить("ПодписьПриложения", ДанныеОблачнойПодписи.ПодписьПриложения);
		ПараметрыЦикла.Вставить("ПодписьПароля", ДанныеОблачнойПодписи.ПодписьПароля);
		ПараметрыЦикла.Вставить("ПодписьКодаАктивации", ДанныеОблачнойПодписи.ПодписьКодаАктивации);
		ПараметрыЦикла.Вставить("ИдентификаторСубъекта", ДанныеОблачнойПодписи.ИдентификаторСубъекта);
		ПараметрыЦикла.Вставить("ДействиеАктивироватьПароль", ДействиеАктивироватьПароль);
		ПараметрыЦикла.Вставить("ДействиеАктивироватьКлючПриложения", ДействиеАктивироватьКлючПриложения);
		ПараметрыЦикла.Вставить("ДействиеПовторныйКлючПриложения", ДействиеПовторныйКлючПриложения);
		ПараметрыЦикла.Вставить("ДействиеПолучитьКодАктивации", ДействиеПолучитьКодАктивации);
		ПараметрыЦикла.Вставить("ДействиеОтправитьРасписку", ДействиеОтправитьРасписку);
		ПараметрыЦикла.Вставить("ДействиеОбновитьСертификаты", ДействиеОбновитьСертификаты);
		ПараметрыЦикла.Вставить("АдресРасписки", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
		ПараметрыЦикла.Вставить("ИдентификаторАбонента", ПараметрыФункции.ИдентификаторАбонента);
		ПараметрыЦикла.Вставить("ОтправитьЭПРасписки", Ложь);
		ПараметрыЦикла.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
		ПараметрыЦикла.Вставить("ВнутреннийИдентификатор", ДанныеОблачнойПодписи.ВнутреннийИдентификатор);
		ПараметрыЦикла.Вставить("ВыводитьСообщения", ВыводитьСообщения);
		
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПодтверждения", ЭтотОбъект, ПараметрыЦикла);
		ФормаПечатногоДокумента = Неопределено;
		ЗаголовокПодтверждения = "";
		ОписаниеДействия = "";
		ПараметрыОперации = Новый Структура;
							
		Если ПараметрыЦикла.ДействиеАктивироватьПароль И ПараметрыЦикла.ДействиеАктивироватьКлючПриложения Тогда
			ПараметрыДляПечати = Новый Структура("Сервер, Логин, Пароль, ДанныеКлюча, Инструкция");
			ЗаполнитьЗначенияСвойств(ПараметрыДляПечати, ПараметрыЦикла);
			ПараметрыДляПечати.Инструкция = НСтр("ru = 'Необходимо завершить настройки для подключения электронной подписи в программе и мобильного приложения';
												|en = 'Необходимо завершить настройки для подключения электронной подписи в программе и мобильного приложения'") + ":" + Символы.ПС 
								+ НСтр("ru = ' - сохраните полученный пароль для подключения';
										|en = ' - сохраните полученный пароль для подключения'") + Символы.ПС
								+ НСтр("ru = ' - отсканируйте в мобильном приложении полученный QR-код';
										|en = ' - отсканируйте в мобильном приложении полученный QR-код'") + Символы.ПС
								+ НСтр("ru = ' - подтвердите получение пароля и QR-кода';
										|en = ' - подтвердите получение пароля и QR-кода'") + Символы.ПС
								+ НСтр("ru = ' - введите в мобильном приложении высланный в SMS код активации';
										|en = ' - введите в мобильном приложении высланный в SMS код активации'") + Символы.ПС
								+ НСтр("ru = ' - подключитесь к электронной подписи в программе с новым паролем';
										|en = ' - подключитесь к электронной подписи в программе с новым паролем'") + Символы.ПС
								+ НСтр("ru = ' - с помощью мобильного приложения выполните операцию контрольной подписи';
										|en = ' - с помощью мобильного приложения выполните операцию контрольной подписи'");
			ФормаПечатногоДокумента = ПечатнаяФормаПодключенияОблачнойПодписи(ПараметрыДляПечати);
			ЗаголовокПодтверждения = НСтр("ru = 'Подтверждаю получение пароля и QR-кода';
											|en = 'Подтверждаю получение пароля и QR-кода'");
			ПараметрыОперации.Вставить("ПовторнаяОтправкаКода", Истина);
			ПараметрыОперации.Вставить("ИдентификаторСубъекта", ПараметрыЦикла.ИдентификаторСубъекта);
			ПараметрыОперации.Вставить("ПодписьКодаАктивации", ПараметрыЦикла.ПодписьКодаАктивации);
			
		ИначеЕсли ПараметрыЦикла.ДействиеАктивироватьПароль Тогда
			ПараметрыДляПечати = Новый Структура("Сервер, Логин, Пароль, Инструкция");
			ЗаполнитьЗначенияСвойств(ПараметрыДляПечати, ПараметрыЦикла);
			ПараметрыДляПечати.Инструкция = НСтр("ru = 'Необходимо завершить настройки для подключения к электронной подписи';
												|en = 'Необходимо завершить настройки для подключения к электронной подписи'") + ":" + Символы.ПС 
								+ НСтр("ru = ' - сохраните полученный пароль для подключения';
										|en = ' - сохраните полученный пароль для подключения'") + Символы.ПС
								+ НСтр("ru = ' - подтвердите получение пароля';
										|en = ' - подтвердите получение пароля'") + Символы.ПС
								+ НСтр("ru = ' - с помощью мобильного приложения выполните операцию контрольной подписи';
										|en = ' - с помощью мобильного приложения выполните операцию контрольной подписи'") + Символы.ПС
								+ НСтр("ru = ' - подключитесь к электронной подписи в программе с новым паролем';
										|en = ' - подключитесь к электронной подписи в программе с новым паролем'");
			ФормаПечатногоДокумента = ПечатнаяФормаПодключенияОблачнойПодписи(ПараметрыДляПечати);
			ЗаголовокПодтверждения = НСтр("ru = 'Подтверждаю получение пароля';
											|en = 'Подтверждаю получение пароля'");
			
		ИначеЕсли ПараметрыЦикла.ДействиеАктивироватьКлючПриложения Тогда
			ПараметрыДляПечати = Новый Структура("Сервер, Логин, ДанныеКлюча, Инструкция");
			ЗаполнитьЗначенияСвойств(ПараметрыДляПечати, ПараметрыЦикла);
			ПараметрыДляПечати.Инструкция = НСтр("ru = 'Необходимо завершить настройки для подключения мобильного приложения';
												|en = 'Необходимо завершить настройки для подключения мобильного приложения'") + ":" + Символы.ПС 
								+ НСтр("ru = ' - отсканируйте в мобильном приложении полученный QR-код';
										|en = ' - отсканируйте в мобильном приложении полученный QR-код'") + Символы.ПС
								+ НСтр("ru = ' - подтвердите получение QR-кода';
										|en = ' - подтвердите получение QR-кода'") + Символы.ПС
								+ НСтр("ru = ' - введите в мобильном приложении высланный в SMS код активации, 
								|   который придет после продолжения';
								|en = ' - введите в мобильном приложении высланный в SMS код активации, 
								|   который придет после продолжения'");
			ФормаПечатногоДокумента = ПечатнаяФормаПодключенияОблачнойПодписи(ПараметрыДляПечати);
			ЗаголовокПодтверждения = НСтр("ru = 'Подтверждаю получение QR-кода';
											|en = 'Подтверждаю получение QR-кода'");
			ПараметрыОперации.Вставить("ПовторнаяОтправкаКода", Истина);
			ПараметрыОперации.Вставить("ИдентификаторСубъекта", ПараметрыЦикла.ИдентификаторСубъекта);
			ПараметрыОперации.Вставить("ПодписьКодаАктивации", ПараметрыЦикла.ПодписьКодаАктивации);
			
		ИначеЕсли ПараметрыЦикла.ДействиеПовторныйКлючПриложения Тогда
			ПараметрыДляПечати = Новый Структура("Сервер, Логин, ДанныеКлюча, Инструкция");
			ЗаполнитьЗначенияСвойств(ПараметрыДляПечати, ПараметрыЦикла);
			ПараметрыДляПечати.Инструкция = НСтр("ru = 'Необходимо повторно настроить подключение мобильного приложения';
												|en = 'Необходимо повторно настроить подключение мобильного приложения'") + ":" + Символы.ПС 
								+ НСтр("ru = ' - отсканируйте в мобильном приложении полученный QR-код';
										|en = ' - отсканируйте в мобильном приложении полученный QR-код'") + Символы.ПС
								+ НСтр("ru = ' - подтвердите получение QR-кода';
										|en = ' - подтвердите получение QR-кода'") + Символы.ПС
								+ НСтр("ru = ' - введите в мобильном приложении высланный ранее в SMS код активации';
										|en = ' - введите в мобильном приложении высланный ранее в SMS код активации'");
			ФормаПечатногоДокумента = ПечатнаяФормаПодключенияОблачнойПодписи(ПараметрыДляПечати);
			ЗаголовокПодтверждения = НСтр("ru = 'Подтверждаю получение QR-кода';
											|en = 'Подтверждаю получение QR-кода'");
			ПараметрыОперации.Вставить("ПовторнаяОтправкаКода", Истина);
			ПараметрыОперации.Вставить("ИдентификаторСубъекта", ПараметрыЦикла.ИдентификаторСубъекта);
			ПараметрыОперации.Вставить("ПодписьКодаАктивации", ПараметрыЦикла.ПодписьКодаАктивации);
								
		КонецЕсли;
		
		Если ФормаПечатногоДокумента <> Неопределено Тогда
			ПолучитьПодтверждениеПользователя(ОписаниеСледующее,
						НСтр("ru = 'Параметры подключения к электронной подписи';
							|en = 'Параметры подключения к электронной подписи'"),
						"",
						ФормаПечатногоДокумента, 
						ЗаголовокПодтверждения,
						ПараметрыОперации);
		Иначе
			ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПодтверждения(КодВозвратаДиалога.ОК, ПараметрыЦикла);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПодтверждения(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	Если РезультатВыполнения = КодВозвратаДиалога.ОК Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьАктивироватьКод", ЭтотОбъект, ПараметрыЦикла);
		
		Если ПараметрыЦикла.ДействиеАктивироватьКлючПриложения Тогда
			ДлительнаяОперация = АктивироватьКлючПриложенияУчетнойЗаписиОблачнойПодписиНаСервере(ПараметрыЦикла.ПодписьПриложения, ПараметрыЦикла.ИдентификаторСубъекта);
		
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
			
			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		Иначе
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Новый Структура("Выполнено", Истина));
		КонецЕсли;
		
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						НСтр("ru = 'Отказ от получения нового ключа в мобильном приложении.';
							|en = 'Отказ от получения нового ключа в мобильном приложении.'"));
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьАктивироватьКод(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	Успешно = Ложь;
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Статус", "") = "Выполнено" Тогда
		РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Успешно = РезультатВыполнения.Выполнено И РезультатВыполнения.Результат;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Выполнено", Ложь) = Истина Тогда
		Успешно = Истина;
	КонецЕсли;
	
	Если Успешно Тогда
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьАктивироватьПароль", ЭтотОбъект, ПараметрыЦикла);
		Если ПараметрыЦикла.ДействиеПолучитьКодАктивации Тогда
			ДлительнаяОперация = ОбменССерверомОтправитьКодАктивацииКлючаОблачнойПодписиНаСервере(ПараметрыЦикла.ПодписьКодаАктивации, ПараметрыЦикла.ИдентификаторСубъекта);
								
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;

			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеСледующее, ПараметрыОжидания);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеСледующее, Новый Структура("Выполнено", Истина));
		КонецЕсли;
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						НСтр("ru = 'Ошибка при активации нового ключа мобильного приложения';
							|en = 'Ошибка при активации нового ключа мобильного приложения'"));
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьАктивироватьПароль(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	ВыводитьСообщения = ПараметрыЦикла.ВыводитьСообщения;
	Успешно = Ложь;
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Статус", "") = "Выполнено" Тогда
		РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Успешно = РезультатВыполнения.Выполнено;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Выполнено", Ложь) = Истина Тогда
		Успешно = Истина;
	КонецЕсли;
	
	Если Успешно Тогда

		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПодписи", ЭтотОбъект, ПараметрыЦикла);
		
		Если ПараметрыЦикла.ДействиеАктивироватьПароль Тогда
			СвойстваСертификата = Новый Структура("Отпечаток", ПараметрыЦикла.ОтпечатокСертификата);
			
			МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
			МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
			
			ДанныеДляПодписи = ПолучитьДвоичныеДанныеИзСтроки(ПараметрыЦикла.ПодписьПароля);
			СвойстваПодписи = МодульСервисКриптографииDSSКлиентСервер.ПолучитьСвойствоПодписиCMS(Истина, Ложь);
			МодульСервисКриптографииDSSКлиентСервер.ПолучитьИнформациюДокументаДляПодписи(СвойстваПодписи, НСтр("ru = 'Контрольная подпись';
																												|en = 'Контрольная подпись'"), "txt");
			
			ПараметрыОперации = Новый Структура;
			ПараметрыОперации.Вставить("ПодтверждатьПринудительно", Истина);
			ПараметрыОперации.Вставить("ОбработкаОшибок", ВыводитьСообщения);

			МодульСервисКриптографииDSSКлиент.Подписать(ОписаниеСледующее, ПараметрыЦикла.УчетнаяЗапись, ДанныеДляПодписи, СвойстваПодписи, СвойстваСертификата, ПараметрыОперации);
			
		Иначе
			ОбработатьОбновлениеАктивироватьОблачнуюПодписьУстановитьСертификат(Новый Структура("Выполнено, Ошибка", Истина, ""), ПараметрыЦикла);
		КонецЕсли;
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						НСтр("ru = 'Ошибка отправки кода авторизации';
							|en = 'Ошибка отправки кода авторизации'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПодписи(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	ВыводитьСообщения = ПараметрыЦикла.ВыводитьСообщения;
	Если РезультатВыполнения.Выполнено Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПодтвержениеПароля", ЭтотОбъект, ПараметрыЦикла);
		ДлительнаяОперация = АктивироватьУчетнуюЗаписьОблачнойПодписиНаСервере(
					РезультатВыполнения.Результат, 
					ПараметрыЦикла.ПодписьПароля,
					ПараметрыЦикла.ИдентификаторСубъекта);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
							
	Иначе
		ТекстОшибки = НСтр("ru = 'Ошибка при формировании контрольной подписи';
							|en = 'Ошибка при формировании контрольной подписи'");
		Если ВыводитьСообщения Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС
						+ РезультатВыполнения.Ошибка;
		КонецЕсли;
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла, Ложь, ТекстОшибки);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПередПодтвержениемПароля(УчетнаяЗаписьОблачнойПодписи)
	
	МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
	МодульСервисКриптографииDSSСлужебный = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSСлужебный");
	ИдентификаторУчетнойЗаписи = УчетнаяЗаписьОблачнойПодписи.УникальныйИдентификатор();
		
	НовоеЗначение = МодульСервисКриптографииDSSКлиентСервер.ОбъектПароля("", 3);
	МодульСервисКриптографииDSSСлужебный.СохранитьЗакрытыеДанные(СокрЛП(ИдентификаторУчетнойЗаписи), НовоеЗначение, "Пароль");

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПодтвержениеПароля(ОтветСервиса, ПараметрыЦикла) Экспорт
	
	УчетнаяЗаписьОблачнойПодписи = ПараметрыЦикла.УчетнаяЗапись;
	Успешно = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОтветСервиса, "Статус", "") = "Выполнено" Тогда
		РезультатВыполнения = ПолучитьИзВременногоХранилища(ОтветСервиса.АдресРезультата);
		Успешно = РезультатВыполнения.Выполнено И РезультатВыполнения.Результат;
	КонецЕсли;
	
	Если Успешно Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьПередПодтвержениемПароля(УчетнаяЗаписьОблачнойПодписи);
		МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
		МодульСервисКриптографииDSSСлужебныйВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSСлужебныйВызовСервера");
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПроверки", ЭтотОбъект, ПараметрыЦикла);
		ПараметрыОперации = Новый Структура();
		ПараметрыОперации.Вставить("Принудительно", Истина);
		ПараметрыОперации.Вставить("ОжидатьВыполнения", Истина);
		ПараметрыОперации.Вставить("ПояснениеОперации", НСтр("ru = 'Подключитесь к сервису электронной подписи в программе с помощью пароля, полученного ранее.';
															|en = 'Подключитесь к сервису электронной подписи в программе с помощью пароля, полученного ранее.'"));
		МодульСервисКриптографииDSSСлужебныйВызовСервера.СброситьПараметрыСеансаУчетнойЗаписи(УчетнаяЗаписьОблачнойПодписи);
		МодульСервисКриптографииDSSКлиент.ПроверкаАутентификацииПользователя(ОписаниеСледующее, УчетнаяЗаписьОблачнойПодписи, ПараметрыОперации);
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Успешно,
						НСтр("ru = 'Ошибка при активировании учетной записи';
							|en = 'Ошибка при активировании учетной записи'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПроверки(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	ВыводитьСообщения = ПараметрыЦикла.ВыводитьСообщения;
	
	Если РезультатВыполнения.Выполнено Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьУстановитьСертификат(РезультатВыполнения, ПараметрыЦикла);
	Иначе
		ТекстОшибки = НСтр("ru = 'Ошибка при проверке подключения';
							|en = 'Ошибка при проверке подключения'");
		Если ВыводитьСообщения Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС
						+ РезультатВыполнения.Ошибка;
		КонецЕсли;
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						РезультатВыполнения.Выполнено,
						ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьУстановитьСертификат(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	ОтпечатокСертификата = ПараметрыЦикла.ОтпечатокСертификата;
	УстанавливатьСертификат = ПараметрыЦикла.УстанавливатьСертификат;
	ВнутреннийИдентификатор = ПараметрыЦикла.ВнутреннийИдентификатор;
	
	Если РезультатВыполнения.Выполнено Тогда
		Если УстанавливатьСертификат И НЕ ЗначениеЗаполнено(ВнутреннийИдентификатор) Тогда
			ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПоискаСертификата", ЭтотОбъект, ПараметрыЦикла);
			МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
			МодульСервисКриптографииDSSКлиент.НайтиСертификат(ОписаниеСледующее, Новый Структура("Отпечаток", ОтпечатокСертификата)); 
		Иначе
			ОбработатьОбновлениеАктивироватьОблачнуюПодписьОтправитьРасписку(РезультатВыполнения, ПараметрыЦикла); 
		КонецЕсли;
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						РезультатВыполнения.Выполнено,
						НСтр("ru = 'Ошибка установки сертификата';
							|en = 'Ошибка установки сертификата'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеПоискаСертификата(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	УчетнаяЗаписьОблачнойПодписи = ПараметрыЦикла.УчетнаяЗапись;
	ОблачныйСертификат = Base64Значение(ПараметрыЦикла.ОблачныйСертификат);
	ОтпечатокСертификата = ПараметрыЦикла.ОтпечатокСертификата;
	
	Если НЕ РезультатВыполнения.Выполнено Тогда
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьОтправитьРасписку", ЭтотОбъект, ПараметрыЦикла);
		МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
		МодульСервисКриптографииDSSКлиент.УстановитьСертификат(ОписаниеСледующее, УчетнаяЗаписьОблачнойПодписи, ОблачныйСертификат); 
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьОтправитьРасписку(РезультатВыполнения, ПараметрыЦикла); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьОтправитьРасписку(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	Если РезультатВыполнения.Выполнено 
		И ПараметрыЦикла.ДействиеОтправитьРасписку
		И ЗначениеЗаполнено(ПараметрыЦикла.ЗаявлениеПодключения) Тогда
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПередОтправкойРасписки", ЭтотОбъект, ПараметрыЦикла);
		
		СписокФайлов = Новый Массив;
		СписокФайлов.Добавить(Новый Структура("Идентификатор, Представление, АдресФайла", "Расписка", "Выбрать файл", ПараметрыЦикла.АдресРасписки));
		
		ПараметрыОперации = Новый Структура("ОтправкаЭП", Ложь);
		ПараметрыОперации.Вставить("СписокФайлов", СписокФайлов);
		
		ФормаПечатногоДокумента = ПечатнаяФормаРаспискиОблачнойПодписи(ПараметрыЦикла.ОблачныйСертификат);
		ОписаниеДействия = НСтр("ru = 'Необходимо отправить расписку в получении сертификата:';
								|en = 'Необходимо отправить расписку в получении сертификата:'") + Символы.ПС 
							+ НСтр("ru = ' 1. Распечатайте сертификат, подпишите вручную и отсканируйте его.';
									|en = ' 1. Распечатайте сертификат, подпишите вручную и отсканируйте его.'") + Символы.ПС
							+ НСтр("ru = ' 2. При отправке нужно будет приложить файл с отсканированной распиской: <Расписка>';
									|en = ' 2. При отправке нужно будет приложить файл с отсканированной распиской: <Расписка>'");
							
		Если ПараметрыОперации.ОтправкаЭП Тогда
			ОписаниеДействия = ОписаниеДействия + Символы.ПС + НСтр("ru = ' 3. Или отправьте ЭП для полученного сертификата.';
																	|en = ' 3. Или отправьте ЭП для полученного сертификата.'");
		КонецЕсли;					
		
		ПолучитьПодтверждениеРасписки(ОписаниеСледующее,
					НСтр("ru = 'Расписка при получении сертификата';
						|en = 'Расписка при получении сертификата'"),
					ОписаниеДействия,
					ФормаПечатногоДокумента, 
					"",
					ПараметрыОперации);
		
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						РезультатВыполнения.Выполнено,
						РезультатВыполнения.Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПередОтправкойРасписки(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
	ВыводитьСообщения = ПараметрыЦикла.ВыводитьСообщения;
	
	Если ТипЗнч(РезультатВыполнения) = Тип("Структура") Тогда
		КомандаВыбора = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Команда", "");
	Иначе
		КомандаВыбора = РезультатВыполнения;
	КонецЕсли;
	
	Если КомандаВыбора = "ОтправитьБумажнуюРасписку" Тогда
		РезультатВызова = Новый Структура();
		РезультатВызова.Вставить("ИмяФайла", РезультатВыполнения.СписокФайлов[0].Имя);
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьОбработкаРасписки(РезультатВызова, ПараметрыЦикла);
		
	ИначеЕсли КомандаВыбора = "ОтправитьЭПРасписки" Тогда
		ОписаниеСледующее = Новый ОписаниеОповещения("ОбработатьОбновлениеАктивироватьОблачнуюПодписьПолучениеФайлаРасписки", ЭтотОбъект, ПараметрыЦикла);
		ПараметрыЦикла.ОтправитьЭПРасписки = Истина;
		СвойстваСертификата = Новый Структура("Отпечаток", ПараметрыЦикла.ОтпечатокСертификата);
		
		МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
		
		ДанныеДляПодписи = Base64Значение(ПараметрыЦикла.ОблачныйСертификат);
		СвойстваПодписи = МодульСервисКриптографииDSSКлиентСервер.ПолучитьСвойствоПодписиCMS(Истина, Ложь);
		МодульСервисКриптографииDSSКлиентСервер.ПолучитьИнформациюДокументаДляПодписи(СвойстваПодписи, НСтр("ru = 'Подпись в получении сертификата';
																											|en = 'Подпись в получении сертификата'"), "bin");
		
		ПараметрыОперации = Новый Структура;
		ПараметрыОперации.Вставить("ПодтверждатьПринудительно", Истина);
		ПараметрыОперации.Вставить("ОбработкаОшибок", ВыводитьСообщения);

		МодульСервисКриптографииDSSКлиент.Подписать(ОписаниеСледующее, ПараметрыЦикла.УчетнаяЗапись, ДанныеДляПодписи, СвойстваПодписи, СвойстваСертификата, ПараметрыОперации);
		
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						НСтр("ru = 'Отказ от отправки расписки';
							|en = 'Отказ от отправки расписки'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПолучениеФайлаРасписки(РезультатВызова, ПараметрыЦикла) Экспорт
	
	Успешно = Ложь;
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВызова, "Статус", "") = "Выполнено" Тогда
		РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатВызова.АдресРезультата);
		Успешно = РезультатВыполнения.Выполнено;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВызова, "Выполнено", Ложь) = Истина Тогда
		РезультатВыполнения = РезультатВызова;
		Успешно = Истина;
	КонецЕсли;
	
	Если Успешно Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьОбработкаРасписки(РезультатВыполнения.Результат, ПараметрыЦикла);
	Иначе
		ТекстОшибки = НСтр("ru = 'Не указан файл расписки';
							|en = 'Не указан файл расписки'");
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьОбработкаРасписки(Результат, ПараметрыЦикла)
	
	ТекстОшибки = "";
	Если ПараметрыЦикла.ОтправитьЭПРасписки Тогда
		РезультатОтправки = ОтправитьРаспискуНаСервере(
						ПараметрыЦикла.ЗаявлениеПодключения,
						ПараметрыЦикла.ИдентификаторАбонента,
						ПоместитьВоВременноеХранилище(Base64Значение(ПараметрыЦикла.ОблачныйСертификат)),
						Base64Значение(ПараметрыЦикла.ОблачныйСертификат),
						Результат);
	Иначе
		РезультатОтправки = ОтправитьРаспискуНаСервере(
						ПараметрыЦикла.ЗаявлениеПодключения,
						ПараметрыЦикла.ИдентификаторАбонента,
						ПараметрыЦикла.АдресРасписки,
						Результат.ИмяФайла);
	КонецЕсли;
	
	Если НЕ РезультатОтправки.Выполнено Тогда
		ТекстОшибки = РезультатОтправки.ОписаниеОшибки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла,
						Ложь,
						ТекстОшибки);
	Иначе
		ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла, Истина);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьРезультат(ПараметрыЦикла, Результат, ОписаниеОшибки = "") Экспорт
	
	ВыводитьСообщения = ПараметрыЦикла.ВыводитьСообщения;
	
	РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище", Результат, ПараметрыЦикла.АдресВоВременномХранилище);
	Если НЕ Результат Тогда
		РезультатВыполнения.Вставить("ОшибкаАктивированияУчетнойЗаписиОблачнойПодписи", ОписаниеОшибки);
	КонецЕсли;
	
	ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеВыполнения(РезультатВыполнения, ПараметрыЦикла.ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьРаспискуНаСервере(ЗаявлениеПодключения, ИдентификаторАбонента, Расписка, ОблачныйСертификатИмяФайла = Неопределено, ПодписьРасписки = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ЗаявлениеПодключения) Тогда
		Возврат Новый Структура("Выполнено", Истина);
	КонецЕсли;
	
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("Автор", Неопределено);
	ПараметрыФайла.Вставить("ВладелецФайлов", ЗаявлениеПодключения);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Неопределено);
	Если ПодписьРасписки = Неопределено Тогда
		СвойстваФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ОблачныйСертификатИмяФайла);
		ПараметрыФайла.Вставить("ИмяБезРасширения", СвойстваФайла.ИмяБезРасширения);
		ПараметрыФайла.Вставить("РасширениеБезТочки", Сред(СвойстваФайла.Расширение, 2));
	Иначе
		ПараметрыФайла.Вставить("ИмяБезРасширения", "Расписка");
		ПараметрыФайла.Вставить("РасширениеБезТочки", "cer");
	КонецЕсли;
	
	ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Расписка);
	
	Если ПодписьРасписки <> Неопределено Тогда
		СвойстваПодписи = Новый Структура;
		СвойстваПодписи.Вставить("Подпись", ПодписьРасписки);
		СвойстваПодписи.Вставить("Сертификат", Base64Значение(ОблачныйСертификатИмяФайла));
		СвойстваПодписи.Вставить("ПодписьВерна", Истина);
		СвойстваПодписи.Вставить("ДатаПроверкиПодписи", ТекущаяДатаСеанса());
		СвойстваПодписи.Вставить("КомуВыданСертификат", "");
		
		РаботаСФайлами.ДобавитьПодписьКФайлу(ПрисоединенныйФайл, СвойстваПодписи);
	КонецЕсли;
	
	ДокументЗаявление = ЗаявлениеПодключения.ПолучитьОбъект();
	СтрокаТаблицы = Неопределено;
	Для Каждого ЭлектронныйДокумент Из ДокументЗаявление.ЭлектронныеДокументы Цикл
		Если ЭлектронныйДокумент.Документ = "Расписка" Тогда
			СтрокаТаблицы = ЭлектронныйДокумент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ДокументЗаявление.ЭлектронныеДокументы.Добавить();
	КонецЕсли;
	
	СтрокаТаблицы.Документ = "Расписка";
	СтрокаТаблицы.Файл = ПрисоединенныйФайл;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправитьРаспискуНаСервере(ДокументЗаявление, ИдентификаторАбонента);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеАктивироватьОблачнуюПодписьПослеВыполнения(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов И РезультатВыполнения.РезультатРасшифровки;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	
	РезультатРасшифровки = РезультатВыполнения.РезультатРасшифровки;
	АдресВоВременномХранилище = РезультатВыполнения.АдресВоВременномХранилище;
	
	ТрансляцияОшибокУстановкиСертификатов = ДополнительныеПараметры.ТрансляцияОшибокУстановкиСертификатов;
	ТрансляцияОшибокРасшифровки = РезультатВыполнения;
	
	ОбработатьОбновлениеПослеКриптографииЗавершение(
		АдресВоВременномХранилище, 
		ВременныйКаталог, 
		ВыводитьСообщения, 
		ВыполняемоеОповещение, 
		ПараметрыРегистрацияПолучитьДанныеССервера, 
		ПараметрыФункции, 
		Результат, 
		РезультатРасшифровки, 
		РезультатУстановкиСертификатов, 
		УстанавливатьСертификат, 
		ФайлИзКэша,
		ТрансляцияОшибокУстановкиСертификатов,
		ТрансляцияОшибокРасшифровки
	);
		
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьФормуПодтверждения(ПараметрыФормы, ОповещениеСледующее, РежимОткрытияОкна) Экспорт
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПодтверждениеПользователяОблачнойПодписи", ПараметрыФормы, , Новый УникальныйИдентификатор(), , , ОповещениеСледующее, РежимОткрытияОкна);
	
КонецПроцедуры

&НаКлиенте
// Формирует форму с текстом описания и получения подтверждения действия от пользователя
//
// Параметры:
//  ОповещениеОЗавершении 	- ОписаниеОповещения - указывает процедуру для получения результата
//     Результат 			- Произвольный - действие пользователя
//	Заголовок				- Строка - заголовок формы
//	ОписаниеПодтверждения	- Строка - заголовок "галочки", если пустая, то поле не отображается
//	ТекстВопроса			- Строка, ФорматированнаяСтрока - содержание описания
//	ПечДокумент				- ТабличныйДокумент - отображается табличный документ, вместо надписи
//	ПараметрыОперации		- Структура
//		* СписокКоманд		- СписокЗначений - список кнопок размещаемых на форме
//		* ТаймАут			- Число - время ожидания в секундах
//		* Редактирование	- Булево - имеет смысл, если передан табличный документ
//		* РежимОткрытияОкна - РежимОткрытияОкнаФормы - режим открытия формы
//	
Процедура ПолучитьПодтверждениеПользователя(
				ОповещениеОЗавершении,
				Заголовок,
				ТекстВопроса = "", 
				ПечДокумент = Неопределено,
				ОписаниеПодтверждения = "",
				ПараметрыОперации = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Заголовок", Заголовок);
	ПараметрыФормы.Вставить("ЗаголовокПодтверждения", ОписаниеПодтверждения);
	ПараметрыФормы.Вставить("ТекстВопроса", ТекстВопроса);
	
	Если ПечДокумент <> Неопределено Тогда
		ПараметрыФормы.Вставить("ТабДок", ПечДокумент);
		ПараметрыФормы.Вставить("Редактирование", Истина);
	КонецЕсли;
	
	СписокКоманд = Новый СписокЗначений;
	СписокКоманд.Добавить("КодВозвратаДиалога.ОК", НСтр("ru = 'Продолжить';
														|en = 'Продолжить'"), Истина);
	СписокКоманд.Добавить("КодВозвратаДиалога.Отмена", НСтр("ru = 'Отмена';
															|en = 'Отмена'"));
	
	ПараметрыФормы.Вставить("СписокКоманд", СписокКоманд);
	
	РежимОткрытияОкна = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОперации, "РежимОткрытияОкна", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыФормы, ПараметрыОперации, Истина);
	КонецЕсли;	

	ПараметрыЦикла = Новый Структура();
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ОповещениеСледующее = Новый ОписаниеОповещения("ПолучитьПодтверждениеПользователяЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	ПолучитьФормуПодтверждения(ПараметрыФормы, ОповещениеСледующее, РежимОткрытияОкна);
	
КонецПроцедуры

&НаКлиенте
// Формирует форму с текстом описания и получения подтверждения действия от пользователя
//
// Параметры:
//  ОповещениеОЗавершении 	- ОписаниеОповещения - указывает процедуру для получения результата
//     Результат 			- Произвольный - действие пользователя
//	Заголовок				- Строка - заголовок формы
//	ОписаниеПодтверждения	- Строка - заголовок "галочки", если пустая, то поле не отображается
//	ТекстВопроса			- Строка, ФорматированнаяСтрока - содержание описания
//	ПечДокумент				- ТабличныйДокумент - отображается табличный документ, вместо надписи
//	ПараметрыОперации		- Структура
//		* СписокКоманд		- СписокЗначений - список кнопок размещаемых на форме
//		* ТаймАут			- Число - время ожидания в секундах
//		* Редактирование	- Булево - имеет смысл, если передан табличный документ
//		* РежимОткрытияОкна - РежимОткрытияОкнаФормы - режим открытия формы
//	
Процедура ПолучитьПодтверждениеРасписки(
				ОповещениеОЗавершении,
				Заголовок,
				ТекстВопроса = "", 
				ПечДокумент = Неопределено,
				ОписаниеПодтверждения = "",
				ПараметрыОперации = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Заголовок", Заголовок);
	ПараметрыФормы.Вставить("ЗаголовокПодтверждения", ОписаниеПодтверждения);
	ПараметрыФормы.Вставить("ТекстВопроса", ТекстВопроса);
	ПараметрыФормы.Вставить("ШиринаТаблицы", 95);
	
	РежимОткрытияОкна = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОперации, "РежимОткрытияОкна", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОтправкаЭП = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОперации, "ОтправкаЭП", Ложь);
	
	Если ПечДокумент <> Неопределено Тогда
		ПараметрыФормы.Вставить("ТабДок", ПечДокумент);
		ПараметрыФормы.Вставить("Редактирование", Истина);
	КонецЕсли;
	
	СписокКоманд = Новый СписокЗначений;
	СписокКоманд.Добавить("ОтправитьБумажнуюРасписку", НСтр("ru = 'Отправить скан-копию расписки';
															|en = 'Отправить скан-копию расписки'"), Истина);
	Если ОтправкаЭП Тогда
		СписокКоманд.Добавить("ОтправитьЭПРасписки", НСтр("ru = 'Отправить с эл. подписью';
															|en = 'Отправить с эл. подписью'"));
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СписокКоманд", СписокКоманд);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыФормы, ПараметрыОперации, Истина);
	КонецЕсли;	

	ПараметрыЦикла = Новый Структура();
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ОповещениеСледующее = Новый ОписаниеОповещения("ПолучитьПодтверждениеПользователяЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	ПолучитьФормуПодтверждения(ПараметрыФормы, ОповещениеСледующее, РежимОткрытияОкна);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПодтверждениеПользователяЗавершение(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Результат = КодВозвратаДиалога.Отмена;
	Иначе
		Результат = РезультатВыбора;
	КонецЕсли;
	
	Если ПараметрыЦикла.ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыЦикла.ОповещениеОЗавершении, Результат);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодпись(ВходящийКонтекст)
	
	МестоХраненияКлюча = ВходящийКонтекст.МестоХраненияКлюча;
	УчетнаяЗаписьОблачнойПодписи = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
	
	Если ЗначениеЗаполнено(УчетнаяЗаписьОблачнойПодписи) Тогда
		ПараметрыОперации = Новый Структура;
		ПарольПользователя = КриптографияЭДКОКлиентСервер.ПараметрыМестаХраненияКлюча(МестоХраненияКлюча, "Пароль");
		Если ПарольПользователя <> Неопределено Тогда
			ПараметрыОперации.Вставить("ПарольПользователя", ПарольПользователя);
			ПараметрыОперации.Вставить("ПоказатьДиалог", Ложь);
		КонецЕсли;
		ОписаниеСледующее = Новый ОписаниеОповещения("РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодписьЗавершение", ЭтотОбъект, ВходящийКонтекст);
		МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
		МодульСервисКриптографииDSSКлиент.ОбновитьПолитикуПользователя(ОписаниеСледующее, УчетнаяЗаписьОблачнойПодписи, ПараметрыОперации);
	Иначе
		РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодписьЗавершение(Новый Структура("Выполнено", Истина), ВходящийКонтекст);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодписьЗавершение(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	МестоХраненияКлюча = ВходящийКонтекст.МестоХраненияКлюча;
	ДанныеДляРасшифровки = ВходящийКонтекст.ДанныеДляРасшифровки;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ВходящийКонтекст.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ПараметрыОперации = ВходящийКонтекст.ПараметрыОперации;
	
	МодульСервисКриптографииDSSASNКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSASNКлиентСервер");
	СвойстваЗашифрования = МодульСервисКриптографииDSSASNКлиентСервер.ПолучитьСертификатыШифрования(ДанныеДляРасшифровки);
	
	ТекущийСертификат = Неопределено;
	Если СвойстваЗашифрования.Количество() > 0 Тогда
		ТекущийСертификат = Новый Структура;
		ТекущийСертификат.Вставить("СерийныйНомер", СвойстваЗашифрования[0].СерийныйНомер);
		ТекущийСертификат.Вставить("Поставщик", СвойстваЗашифрования[0].ОбщееИмя);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ТекущийСертификат);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"РегистрацияРасшифроватьДанныеОблачнаяПодпись", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, , ТекущийСертификат, Ложь, , ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеОблачнаяПодпись(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ПараметрыОперации = ВходящийКонтекст.ПараметрыОперации;
	МестоХраненияКлюча = ВходящийКонтекст.МестоХраненияКлюча;
	МестоХраненияКлючаНастроек = ВходящийКонтекст.МестоХраненияКлючаНастроек;
	ЭтоОблачнаяПодпись = ЭтоОблачнаяПодпись(МестоХраненияКлюча);
	УчетнаяЗаписьОблачнойПодписи = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
	
	Если НЕ РезультатВыполнения.Выполнено И НЕ ЭтоОблачнаяПодпись И ЭтоОблачнаяПодпись(МестоХраненияКлючаНастроек) Тогда
		ВходящийКонтекст.МестоХраненияКлюча = МестоХраненияКлючаНастроек;
		РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодпись(ВходящийКонтекст);
	ИначеЕсли РезультатВыполнения.Выполнено ИЛИ НЕ ЭтоОблачнаяПодпись Тогда
		РегистрацияРасшифроватьДанныеПослеРасшифрования(РезультатВыполнения, ВходящийКонтекст);
	Иначе
		МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
		МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
		
		Если МодульСервисКриптографииDSSКлиентСервер.ЭтоОшибкаОтказа(РезультатВыполнения.ОписаниеОшибки) Тогда
			РегистрацияРасшифроватьДанныеПослеРасшифрования(РезультатВыполнения, ВходящийКонтекст);
		Иначе	
			ПараметрыОперации = Неопределено;
			ПарольПользователя = КриптографияЭДКОКлиентСервер.ПараметрыМестаХраненияКлюча(МестоХраненияКлюча, "Пароль");
			Если ПарольПользователя <> Неопределено Тогда
				ПараметрыОперации = Новый Структура;
				ПараметрыОперации.Вставить("ПарольПользователя", ПарольПользователя);
				ПараметрыОперации.Вставить("ПоказатьДиалог", Ложь);
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения(
				"РегистрацияРасшифроватьДанныеОблачнаяПодписьПослеОбновления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			МодульСервисКриптографииDSSКлиент.ОбновитьДанныеСертификатов(Оповещение, УчетнаяЗаписьОблачнойПодписи, ПараметрыОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеОблачнаяПодписьПослеОбновления(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ПараметрыОперации = ВходящийКонтекст.ПараметрыОперации;
	Сертификат = ВходящийКонтекст.Сертификат;
	ДанныеДляРасшифровки = ВходящийКонтекст.ДанныеДляРасшифровки;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ВходящийКонтекст.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	
	Если НЕ РезультатВыполнения.Выполнено Тогда
		Ответ = Новый Структура("Выполнено, ОписаниеОшибки", Ложь, РезультатВыполнения.Ошибка);
		РегистрацияРасшифроватьДанныеПослеРасшифрования(Ответ, ВходящийКонтекст);
	Иначе
		Оповещение = Новый ОписаниеОповещения(
			"РегистрацияРасшифроватьДанныеПослеРасшифрования", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ДанныеДляРасшифровки, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, Сертификат, Ложь, , ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификат(ДополнительныеПараметры)
	
	Если ПустаяСтрока(ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча) Тогда
		
		Если НЕ ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности Тогда 
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗаявлениеСформироватьЗакрытыйКлючПослеИнструкцииЗавершение", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			ПоказатьИнструкциюСозданияКонтейнера(ДополнительныеПараметры.ДокументЗаявление.ТипКриптопровайдера, ОписаниеОповещения);
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры)
	
	АлгоритмКонтейнераКлючей = ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДополнительныеПараметры.ДокументЗаявление);
	Если АлгоритмКонтейнераКлючей = Неопределено Тогда
		СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(ДополнительныеПараметры,
			НСтр("ru = 'Не удалось получить алгоритм генерации ключа.';
				|en = 'Не удалось получить алгоритм генерации ключа.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("АлгоритмКонтейнераКлючей", АлгоритмКонтейнераКлючей);
	ДополнительныеПараметры.Вставить("НапомнитьОбновитьКриптопровайдер",
		АлгоритмКонтейнераКлючей = "GOST R 34.10-2012-256" ИЛИ АлгоритмКонтейнераКлючей = "GOST R 34.10-2012-512");
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПолученияКриптопровайдеров", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НапомнитьОбновитьКриптопровайдер Тогда
		ДополнительныеПараметры.Вставить("НапомнитьОбновитьКриптопровайдер", Истина);
		
		КриптографияЭДКОКлиент.ПолучитьКриптопровайдеры(Оповещение, Ложь, Ложь);
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПолученияКриптопровайдеров(Результат, ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПредупрежденияОбОбновленииКриптопровайдера",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если Результат.Выполнено И ДополнительныеПараметры.НапомнитьОбновитьКриптопровайдер Тогда
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 	Оповещение);
		ДополнительныеПараметры.Вставить("Криптопровайдеры", 		Результат.Криптопровайдеры);
		ПоказатьПредупреждениеОбОбновленииКриптопровайдераПриНеобходимости(ДополнительныеПараметры);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеПредупрежденияОбОбновленииКриптопровайдера(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ВыводитьИнформациюОбОшибках", НЕ ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности);
	ДополнительныеПараметры.Вставить("УникальноеИмяКонтейнера", 	ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
	ДополнительныеПараметры.Вставить("МенеджерКриптографииДляЗапросаНаСертификат", 	Неопределено);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча) Тогда
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено", 				Истина);
		Результат.Вставить("Алгоритм", 					ДополнительныеПараметры.АлгоритмКонтейнераКлючей);
		Результат.Вставить("УникальноеИмяКонтейнера", 	ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
		
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера(Результат, ДополнительныеПараметры);
		
	Иначе
		
		ПутьКонтейнерЗакрытогоКлюча = КриптографияЭДКОКлиент.СгенерироватьИмяКонтейнера(ДополнительныеПараметры.ДокументЗаявление.КраткоеНаименование);
		
		Оповещение = Новый ОписаниеОповещения(
			"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияМенеджера", 
			ЭтотОбъект, 
			ДополнительныеПараметры,
			"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки", 
			ЭтотОбъект);
		
		ЭтоLinux = ОбщегоНазначенияЭДКОКлиент.ЭтоКриптопровайдерLinux();
		ПутьМодуляКриптографии = ?(ЭтоLinux,
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПутьМодуляКриптографии(), "");
		ПоддерживаемыеКриптопровайдеры = КриптографияЭДКОКлиентСервер.ПоддерживаемыеКриптопровайдеры(
			ДополнительныеПараметры.АлгоритмКонтейнераКлючей,
			ЭтоLinux,
			ДополнительныеПараметры.ДокументЗаявление.ТипКриптопровайдера,
			ПутьМодуляКриптографии);
		ПараметрыМодуляКриптографии = ?(ПоддерживаемыеКриптопровайдеры.Количество() >= 1,
			ПоддерживаемыеКриптопровайдеры[0], Неопределено);
		
		КриптографияЭДКОКлиент.СоздатьМенеджерКриптографии(Оповещение, Ложь, ПараметрыМодуляКриптографии, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияМенеджера(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ВходящийКонтекст.АлгоритмКонтейнераКлючей = Результат.Алгоритм;
		
		ПутьКонтейнерЗакрытогоКлюча = КриптографияЭДКОКлиент.СгенерироватьИмяКонтейнера(ВходящийКонтекст.ДокументЗаявление.КраткоеНаименование);
		ВходящийКонтекст.Вставить("МенеджерКриптографииДляЗапросаНаСертификат", Результат.МенеджерКриптографии);
		
		ЭкспортируемыйКлюч = НЕ ОбязателенТокен(ВходящийКонтекст);
		
		Если ВходящийКонтекст.ДокументЗаявление.ВключитьЛицензиюКриптоПро Тогда
			
			Оповещение = Новый ОписаниеОповещения("ЗаявлениеСоздатьКонтейнерИЗапросНаСертификатПослеЗавершения", ЭтотОбъект, ВходящийКонтекст);
			СтрокаПередачиДанных = ОбработкаЗаявленийАбонентаКлиент.ЗаявлениеСформироватьЗапросНаСертификатКвалифицированный(ВходящийКонтекст);
			
			КриптографияЭДКОКлиент.СоздатьКонтейнерИЗапросНаСертификат(
				Оповещение, 
				СтрокаПередачиДанных,
				ПутьКонтейнерЗакрытогоКлюча,
				ВходящийКонтекст.ВыводитьСообщения,
				Результат.МенеджерКриптографии,
				ВходящийКонтекст.АлгоритмКонтейнераКлючей,
				ЭкспортируемыйКлюч);
				
		Иначе
				
			ВходящийКонтекст.Вставить("МенеджерКриптографииДляЗапросаНаСертификат",  Результат.МенеджерКриптографии);
			
			Оповещение = Новый ОписаниеОповещения(
				"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера", 
				ЭтотОбъект, 
				ВходящийКонтекст,
				"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки", 
				ЭтотОбъект);
				
			КриптографияЭДКОКлиент.СоздатьКонтейнерКлючей(
				Оповещение, 
				ПутьКонтейнерЗакрытогоКлюча,
				НЕ ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности,
				Результат.МенеджерКриптографии,
				ВходящийКонтекст.АлгоритмКонтейнераКлючей,
				ЭкспортируемыйКлюч);
				
		КонецЕсли;
			
	Иначе
		СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(ВходящийКонтекст);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСоздатьКонтейнерИЗапросНаСертификатПослеЗавершения(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера(Результат, ВходящийКонтекст);
		
	Иначе
		
		СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(
			ВходящийКонтекст, 
			Результат.ОписаниеОшибки);
				
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОбработчикОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ПодробноеПредставление = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	
	СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(
		ВходящийКонтекст, 
		ПодробноеПредставление);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера_ОшибкаСозданияКлюча(
		ВходящийКонтекст,
		ТекстОшибкиПриСозданииКлюча = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстОшибки = ?(ТекстОшибкиПриСозданииКлюча = Неопределено,
		НСтр("ru = 'Криптографическая ошибка: не удалось создать контейнер закрытого ключа.';
			|en = 'Криптографическая ошибка: не удалось создать контейнер закрытого ключа.'"), ТекстОшибкиПриСозданииКлюча);
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
		ТекстОшибки, 
		ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
		ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
		
	Оповестить(НСтр("ru = 'Упрощенное заявление. Ошибка создание закрытого ключа';
					|en = 'Упрощенное заявление. Ошибка создание закрытого ключа'"), ТекстОшибки, ВходящийКонтекст.ДокументЗаявление);
		
	СтруктураРезультата = Новый Структура("ПродолжитьОтправкуЗаявления, ТекстОшибки, ПутьКонтейнерЗакрытогоКлюча", 
											Ложь, ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности, "");
											
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		СохраненКорректно = КонтейнерЗакрытогоКлючаСохраненКорректно(
			Результат.УникальноеИмяКонтейнера, 
			ВходящийКонтекст);
		
		Если СохраненКорректно Тогда
			
			АлгоритмКонтейнераКлючей = Результат.Алгоритм;
			
			ВходящийКонтекст.УникальноеИмяКонтейнера = Результат.УникальноеИмяКонтейнера;
			ВходящийКонтекст.АлгоритмКонтейнераКлючей = АлгоритмКонтейнераКлючей;
			
			ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(
				ВходящийКонтекст, 
				"БРО.КонтекстОтправкиЗаявления");
			
			Оповестить(НСтр("ru = 'Упрощенное заявление. Успешное создание закрытого ключа';
							|en = 'Упрощенное заявление. Успешное создание закрытого ключа'"), ,ВходящийКонтекст.ДокументЗаявление);
			
			// Чтобы в форме отправки крутился бублик
			ПодключитьОбработчикОжидания("Подключаемый_ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера", 0.1, Истина);
			
		Иначе
			
			Шаблон = НСтр("ru = 'При получении сертификата в %1 закрытый ключ должен быть сохранен на токен.';
							|en = 'При получении сертификата в %1 закрытый ключ должен быть сохранен на токен.'");
			Текст = СтрШаблон(Шаблон, Строка(ВходящийКонтекст.ДокументЗаявление.УдостоверяющийЦентр));

			СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(ВходящийКонтекст, Текст);
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(ВходящийКонтекст);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Процедура Подключаемый_ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияКонтейнера()
	
	ВходящийКонтекст     = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации("БРО.КонтекстОтправкиЗаявления");
	СтрокаПередачиДанных = ОбработкаЗаявленийАбонентаКлиент.ЗаявлениеСформироватьЗапросНаСертификатКвалифицированный(ВходящийКонтекст);
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияЗапросаНаСертификат", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	КриптографияЭДКОКлиент.СоздатьЗапросНаСертификат(
		Оповещение, 
		СтрокаПередачиДанных,
		ВходящийКонтекст.УникальноеИмяКонтейнера,
		ВходящийКонтекст.ВыводитьСообщения,
		ВходящийКонтекст.МенеджерКриптографииДляЗапросаНаСертификат,
		ВходящийКонтекст.АлгоритмКонтейнераКлючей);
		
	ВходящийКонтекст.Удалить("МенеджерКриптографииДляЗапросаНаСертификат");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПослеСозданияЗапросаНаСертификат(Результат, ВходящийКонтекст) Экспорт
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ПродолжитьОтправкуЗаявления", Результат.Выполнено);
	СтруктураРезультата.Вставить("ТекстОшибки",                 ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
	СтруктураРезультата.Вставить("ПутьКонтейнерЗакрытогоКлюча", ВходящийКонтекст.УникальноеИмяКонтейнера);
	
	Если Результат.Выполнено Тогда
		
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", Результат.ЗапросНаСертификат);
		СтруктураРезультата.Вставить("АлгоритмКонтейнераКлючей", ВходящийКонтекст.АлгоритмКонтейнераКлючей);
		
	Иначе
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Криптографическая ошибка: не удалось сформировать запрос на сертификат для контролирующих органов.';
				|en = 'Криптографическая ошибка: не удалось сформировать запрос на сертификат для контролирующих органов.'"), 
			ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
			ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
			
		СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", "");
		СтруктураРезультата.Вставить("ТекстОшибки", Результат.ОписаниеОшибки);
				
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючПослеИнструкцииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатПродолжение(ДополнительныеПараметры);
			
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкциюСозданияКонтейнера(ТипКриптопровайдера, ВыполняемоеОповещение = Неопределено) Экспорт
	
	Если ТипКриптопровайдера <> ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") 
		И ТипКриптопровайдера <> ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro") Тогда
	
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		
		Возврат;
	КонецЕсли;
	
	Если ТипКриптопровайдера = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") Тогда
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("МакетИнструкцииДляПоказа","ИнструкцияVipNetCSPСозданиеКонтейнера");
		ПараметрыФормы.Вставить("Заголовок", "Инструкция по созданию контейнера закрытого ключа для криптопровайдера ViPNet CSP");
		
	Иначе
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("МакетИнструкцииДляПоказа","ИнструкцияКриптоПроСозданиеКонтейнера");
		ПараметрыФормы.Вставить("Заголовок", "Инструкция по созданию контейнера закрытого ключа для криптопровайдера КриптоПро CSP");
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьИнструкциюСозданияКонтейнераЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.ФормаОтображенияИнструкцииHTML",
		ПараметрыФормы, 
		, 
		, 
		, 
		, 
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнструкциюСозданияКонтейнераЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Ложь);
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать(ДополнительныеПараметры)
	
	ДокументЗаявление = ДополнительныеПараметры.ДокументЗаявление;	
	МестоХраненияКлюча 	= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	// Проверяем, устрановлени ли сертификат оператора электронного документооборота в хранилище сертификатов
	ХранилищеСертификата 	= "AddressBook";
	Отпечаток 				= ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ДокументЗаявление.СпецоператорСвязи, "СертификатБезопасности_Отпечаток");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеПроверкиРегистрацииСертификата", ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(ОписаниеОповещения, Отпечаток, ХранилищеСертификата);
	Иначе
		Сертификат = Новый Структура();
		Сертификат.Вставить("Отпечаток", Отпечаток);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Сертификат);
		КриптографияЭДКОКлиент.НайтиСертификат(ОписаниеОповещения, Сертификат);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура НачатьОтправкуОблачногоЗаявленияВБазуЗаявок(ДокументЗаявление, АлгоритмКонтейнераКлючей)

	АдресЗаданияПоОтправкеОблачногоЗаявления = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Массив();
	ДополнительныеПараметры.Добавить(АдресЗаданияПоОтправкеОблачногоЗаявления);
	ДополнительныеПараметры.Добавить(ДокументЗаявление);
	ДополнительныеПараметры.Добавить(АлгоритмКонтейнераКлючей);
	
	ФоновыеЗадания.Выполнить("ЭлектронныйДокументооборотСКонтролирующимиОрганами.НачатьОтправкуОблачногоЗаявленияВБазуЗаявок", ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок()
	
	Если ЭтоАдресВременногоХранилища(АдресЗаданияПоОтправкеОблачногоЗаявления) Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресЗаданияПоОтправкеОблачногоЗаявления);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			ОтключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок");
			
			Если Результат.Выполнено Тогда
				
				ДанныеЗаявления = Результат.ДанныеЗаявления;
				
				// Копирование новых свойств в открытую форму заявления.
				ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(ОтправляемоеЗаявление, ДанныеЗаявления);
				
				Если ДанныеЗаявления.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
					ОбработкаЗаявленийАбонентаКлиент.ВключитьАвтоматическуюПроверкуСтатуса(ОтправляемоеЗаявление);
					ТекстОшибки = "";
				Иначе
					ТекстОшибки = НСтр("ru = 'При обработке заявления на сервере возникла ошибка. Сервис временно недоступен.';
										|en = 'При обработке заявления на сервере возникла ошибка. Сервис временно недоступен.'");
				КонецЕсли;
				
				Результат = Новый Структура("ТекстОшибки", ТекстОшибки);
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, Результат);
				
			Иначе
				
				Результат.Вставить("ТекстОшибки", Результат.ОписаниеОшибки);
				ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, Результат); // Результат содержит текст ошибки
				
			КонецЕсли;
			
		Иначе
			
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
			
		КонецЕсли;
		
	Иначе
		
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуДляСкачивания(Версия) Экспорт
	
	Если Версия = СтруктураСсылочныхДанных.Перечисления_ТипыКриптоПровайдеров_VipNet Тогда
		
		АдресСтраницы = "http://infotecs.ru/downloads/product_full.php?id_product=2096";
		
	Иначе
		
		АдресСтраницы = "http://cryptopro.ru/";
		
	КонецЕсли;
	
	ПерейтиПоНавигационнойСсылке(АдресСтраницы);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеКриптопровайдера(Элемент,ВыборКриптопровайдера)
	
	Возврат Элемент.СписокВыбора[ВыборКриптопровайдера-1].Представление;
	
КонецФункции

&НаКлиенте
Процедура ПолеВыбораКриптопровайдераПриИзменении(Элемент,ТаблицаЗначенийКС,КартинкаВидимость,ВыборКриптопровайдера,КриптопровайдерРекомендация, ВыполняемоеОповещение = Неопределено) Экспорт
	
	ПолеВыбораКриптопровайдера = ПолучитьПредставлениеКриптопровайдера(Элемент,ВыборКриптопровайдера);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	
	ТекстВипнет = "Перейти на сайт разработчика с которого можно бесплатно скачать и установить криптопровайдер ?
	|
	|Внимание! Если будет произведено скачивание и установка, рекомендуется перезагрузить компьютер и запустить мастер заново.";
	
	ТекстКриптоПро = "Перейти на сайт разработчика на котором можно ознакомиться с информацией о способах приобретения криптопровайдера ?
	|
	|Внимание! Если будет произведено приобретение и установка, рекомендуется перезагрузить компьютер и запустить мастер заново.";
	
	Для каждого Строка из ТаблицаЗначенийКС Цикл
		
		Если Строка.ОтображаемыйТекст = ПолеВыбораКриптопровайдера Тогда
			Если Строка.УстановленОС Тогда
				
			ИначеЕсли  Строка.Статус = "(требуется установка)" Тогда
				
				ДополнительныеПараметры = Новый Структура("ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение", ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПолеВыбораКриптопровайдераПриИзмененииВопросВипнетЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																												|en = '%1'"),ТекстВипнет), Режим, 0, КодВозвратаДиалога.Нет);
				Возврат;				
			Иначе
				
				ДополнительныеПараметры = Новый Структура("ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение", ТаблицаЗначенийКС, КриптопровайдерРекомендация, ВыборКриптопровайдера, КартинкаВидимость, ВыполняемоеОповещение);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПолеВыбораКриптопровайдераПриИзмененииВопросКриптоПроЗавершение", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																												|en = '%1'"),ТекстКриптоПро), Режим, 0, КодВозвратаДиалога.Нет);
				Возврат;				
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеВыбораКриптопровайдераПриИзмененииВопросВипнетЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТаблицаЗначенийКС = ДополнительныеПараметры.ТаблицаЗначенийКС;
	КриптопровайдерРекомендация = ДополнительныеПараметры.КриптопровайдерРекомендация;
	ВыборКриптопровайдера = ДополнительныеПараметры.ВыборКриптопровайдера;
	КартинкаВидимость = ДополнительныеПараметры.КартинкаВидимость;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьСтраницуДляСкачивания(СтруктураСсылочныхДанных.Перечисления_ТипыКриптоПровайдеров_VipNet);
	КонецЕсли;
	
	ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение);
		
КонецПроцедуры

&НаКлиенте
Процедура ПолеВыбораКриптопровайдераПриИзмененииВопросКриптоПроЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТаблицаЗначенийКС = ДополнительныеПараметры.ТаблицаЗначенийКС;
	КриптопровайдерРекомендация = ДополнительныеПараметры.КриптопровайдерРекомендация;
	ВыборКриптопровайдера = ДополнительныеПараметры.ВыборКриптопровайдера;
	КартинкаВидимость = ДополнительныеПараметры.КартинкаВидимость;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьСтраницуДляСкачивания(СтруктураСсылочныхДанных.Перечисления_ТипыКриптоПровайдеров_CryptoPro);
	КонецЕсли;
	
	ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИмяТипКриптопровайдера() Экспорт
	Возврат Новый Структура("Имя,Тип",Константы.ДокументооборотСКонтролирующимиОрганами_ИмяКриптопровайдера.Получить(), Константы.ДокументооборотСКонтролирующимиОрганами_ТипКриптопровайдера.Получить());
КонецФункции

&НаКлиенте
Процедура ВыработатьРекомендацииПоКриптопровайдеру(ТаблицаЗначенийКС,КриптопровайдерРекомендация,ВыборКриптопровайдера,КартинкаВидимость,ВыполняемоеОповещение = Неопределено) Экспорт
	
	Инфотекс  = ТаблицаЗначенийКС.Получить(0).УстановленОС;
	КриптоПро = ТаблицаЗначенийКС.Получить(1).УстановленОС;
	
	Если Инфотекс и КриптоПро Тогда
		
		КартинкаВидимость = Истина;
		
		КриптопровайдерРекомендация = "Установка криптопровайдера не требуется. В системе уже установлено два криптопровайдера.
		|
		|Внимание, возможны ошибки в работе, вызванные конфликтом криптопровайдеров. Типичное проявление - не расшифровываются входящие документы.
		|
		|При появлении ошибок рекомендуется обратиться к системному администратору, и оставить только один криптопровайдер (рекомендуется CryptoPro).";
		
	ИначеЕсли КриптоПро Тогда
		
		Если ВыборКриптопровайдера = 1 Тогда
			
			КартинкаВидимость = Ложь;
			
			КриптопровайдерРекомендация = "В системе уже установлен CryptoPro CSP. 
			|
			|Но для использования выбран Инфотекс ViPNet CSP.
			|
			|Измените выбор либо скачайте и установите Инфотекс ViPNet CSP.";
			
			КартинкаВидимость = Истина;
			
		Иначе
			
			КартинкаВидимость = Ложь;
			
			КриптопровайдерРекомендация = "Установка криптопровайдера не требуется. 
			|
			|В системе уже установлен криптопровайдер CryptoPro CSP.";
			
		КонецЕсли;
		
	ИначеЕсли Инфотекс Тогда
		
		Если ВыборКриптопровайдера = 1 Тогда
			
			КартинкаВидимость = Ложь;
			
			КриптопровайдерРекомендация = "Установка криптопровайдера не требуется. 
			|
			|В системе уже установлен криптопровайдер Инфотекс ViPNet CSP.";
		Иначе
			
			КриптопровайдерРекомендация = "В системе уже установлен Инфотекс ViPNet CSP.
			|
			|Но для использования выбран CryptoPro CSP.
			|
			|Измените выбор либо приобретите и установите CryptoPro CSP.";
			
			КартинкаВидимость = Истина;
			
		КонецЕсли;
	Иначе
		
		КартинкаВидимость = Истина;
		
		КриптопровайдерРекомендация = "Требуется скачивание и установка криптопровайдера.
		|
		|Рекомендован бесплатный Инфотекс ViPNet CSP.
		|
		|После скачивания и установки криптопровайдера рекомендуется перезагрузить компьютер и запустить мастер заново.";
		
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		СтруктураВозврата = Новый Структура("КартинкаВидимость, КриптопровайдерРекомендация", КартинкаВидимость, КриптопровайдерРекомендация);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураВозврата);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НовоеНаправление(Получатели, ТипПолучателя, КодПолучателя, КПП = "", Наименование = "") Экспорт
	
	Отбор = Новый Структура("ТипПолучателя, КодПолучателя, КПП",ТипПолучателя,КодПолучателя,КПП);
	
	Если Получатели.НайтиСтроки(Отбор).Количество() <> 0 Тогда 
		Возврат;
	КонецЕсли;
	
	НоваяСтрокаНаправления = Получатели.Добавить();
	НоваяСтрокаНаправления.ТипПолучателя = ТипПолучателя;
	НоваяСтрокаНаправления.КодПолучателя = КодПолучателя;
	
	Если ЗначениеЗаполнено(КПП) Тогда
		НоваяСтрокаНаправления.КПП = КПП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		НоваяСтрокаНаправления.Наименование = Наименование;
	КонецЕсли;
	
КонецПроцедуры

