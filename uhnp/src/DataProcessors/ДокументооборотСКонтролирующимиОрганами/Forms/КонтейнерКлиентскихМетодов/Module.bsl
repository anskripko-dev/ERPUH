					ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(СвПредст.СведФизЛ.ИННФЛ)), Истина);
					ФИОПредставителя = СвПредст.СведФизЛ.ФИО;
					УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Отчество)), 60), Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		УзелПодписант = ДобавитьУзелXML(УзелДокумент, "Подписант");
		
			ДобавитьУзелXML(УзелПодписант, "ПрПодп", Истина, ПараметрыПисьма.ПрПодп);
			УзелФИО = ДобавитьУзелXML(УзелПодписант, "ФИО");
			Если ПараметрыПисьма.ПрПодп = 1 Тогда
				Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
					ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(ПараметрыПисьма.ФИОРук);
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
				Иначе
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
				КонецЕсли;
			Иначе
				ФИОПодписанта = ДокументооборотСКОВызовСервера.УточнитьФИОПредставителя(
					ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ФИО,
					ПараметрыПисьма.Доверенность.ДанныеПредставителя);
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);

				Если ЭтоФормат5_07 Тогда
					УзелСвПред = ДобавитьУзелXML(УзелПодписант, "СвПред");
						НаимДок = ПараметрыПисьма.Доверенность.НаимДок;
						ДобавитьУзелXML(УзелСвПред, "НаимДок", Истина, Лев(XMLСтрока(СокрЛП(НаимДок)), 120));
				КонецЕсли;

			КонецЕсли;
		
		УзелЗапрИнфУсл = ДобавитьУзелXML(УзелДокумент, "ЗапрИнфУсл");
		
			ДобавитьУзелXML(УзелЗапрИнфУсл, "ИФНС", Истина, XMLСтрока(КодИФНСПолучателя));
			ДобавитьУзелXML(УзелЗапрИнфУсл, "КодЗапр", Истина, СоответствиеВидаУслугиКоду[Запрос.ВидУслуги]);
			ДобавитьУзелXML(УзелЗапрИнфУсл, "ФормОтв", Истина, СоответствиеФорматовОтветовИдентификатору[Запрос.ФорматОтвета]);
			
			ПериодОбязателен = ДокументооборотСКОКлиентСервер.ОбязателенПериодВЗапросеИОН(Запрос);
			
			Если ПериодОбязателен Тогда
				УзелПериод = ДобавитьУзелXML(УзелЗапрИнфУсл, "Период");
					ДобавитьУзелXML(УзелПериод, "ДатаНач", Истина, XMLСтрока(Формат(Запрос.ДатаНачалаПериода, "ДФ=dd.MM.yyyy")));
					ДобавитьУзелXML(УзелПериод, "ДатаКон", Истина, XMLСтрока(Формат(Запрос.ДатаОкончанияПериода, "ДФ=dd.MM.yyyy")));
			КонецЕсли;
			
			Если Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.СправкаОНаличииСальдо
				И (Запрос.ДеталСвед ИЛИ Запрос.ИнфПрНач ИЛИ Запрос.РасчСуммПени ИЛИ Запрос.ДеталНачСумм) Тогда
				
				УзелДеталСпр = ДобавитьУзелXML(УзелЗапрИнфУсл, "ДеталСпр");
					ДобавитьУзелXML(УзелДеталСпр, "ДеталСвед", Истина, ?(Запрос.ДеталСвед, "1","0"));
					ДобавитьУзелXML(УзелДеталСпр, "ИнфПрНач", Истина, ?(Запрос.ИнфПрНач, "1","0"));
					ДобавитьУзелXML(УзелДеталСпр, "РасчСуммПени", Истина, ?(Запрос.РасчСуммПени, "1","0"));
					
					УзелДеталНачСумм = ДобавитьУзелXML(УзелДеталСпр, "ДеталНачСумм", Истина, ?(Запрос.ДеталНачСумм, "1","0"));
					Если Запрос.ДеталНачСумм Тогда
						УзелСвДеталСум = ДобавитьУзелXML(УзелДеталСпр, "СвДеталСум");
						ДобавитьУзелXML(УзелСвДеталСум, "ПрПредДетал", Истина, Строка(Запрос.ПрПредДетал));
						ДобавитьУзелXML(УзелСвДеталСум, "Квартал", Истина, Строка(Квартал(Запрос.ДатаНачалаПериода)));
						ДобавитьУзелXML(УзелСвДеталСум, "Год", Истина, Формат(Год(Запрос.ДатаНачалаПериода), "ЧГ=0; ДФ=yyyy"));
					КонецЕсли;
				
			КонецЕсли;
			
			ЭтоАкт = Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПредставлениеАктовСверкиРасчетов;
			Если ЭтоАкт ИЛИ ЭтоПриложение2Или4 Тогда
				УзелЗапрКБК = ДобавитьУзелXML(УзелЗапрИнфУсл, "ЗапрКБК");
				
				Если Запрос.КоличествоНалогов = Перечисления.КоличествоЭлементовДляСверкиИОН.Все Тогда
					ДобавитьУзелXML(УзелЗапрКБК, "ПрКБК", Истина, "1");
				Иначе
					ДобавитьУзелXML(УзелЗапрКБК, "ПрКБК", Истина, "2");
					УзелПеречКБК = ДобавитьУзелXML(УзелЗапрКБК, "ПеречКБК");
					Для Каждого Стр Из Запрос.ЗапрашиваемыеНалоги Цикл
						ДобавитьУзелXML(УзелПеречКБК, "КБК", , XMLСтрока(Стр.КБК));
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ И (ЭтоАкт ИЛИ ЭтоПриложение2Или4) Тогда
				
				УзелЗапрКПП = ДобавитьУзелXML(УзелЗапрИнфУсл, "ЗапрКПП");
				
				Если Запрос.КоличествоКПП = Перечисления.КоличествоЭлементовДляСверкиИОН.Все Тогда
					ДобавитьУзелXML(УзелЗапрКПП, "ПрКПП", Истина, "1");
				Иначе
					ДобавитьУзелXML(УзелЗапрКПП, "ПрКПП", Истина, "2");
					УзелПеречКПП = ДобавитьУзелXML(УзелЗапрКПП, "ПеречКПП");
					Для Каждого Стр Из Запрос.ПереченьКПП Цикл
						ДобавитьУзелXML(УзелПеречКПП, "КПП", , XMLСтрока(Стр.КПП));
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЭтоПриложение2Или4 Тогда
				
				УзелЗапрОКТМО = ДобавитьУзелXML(УзелЗапрИнфУсл, "ЗапрОКТМО");
				
				Если Запрос.КоличествоОКТМО = Перечисления.КоличествоЭлементовДляСверкиИОН.Все Тогда
					ДобавитьУзелXML(УзелЗапрОКТМО, "ПрОКТМО", Истина, "1");
				Иначе
					ДобавитьУзелXML(УзелЗапрОКТМО, "ПрОКТМО", Истина, "2");
					УзелПеречОКТМО = ДобавитьУзелXML(УзелЗапрОКТМО, "ПеречОКТМО");
					Для Каждого Стр Из Запрос.ПереченьОКТМО Цикл
						ДобавитьУзелXML(УзелПеречОКТМО, "ОКТМО", , XMLСтрока(Стр.ОКТМО));
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
		
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	// записываем XML запроса во временный файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	Если НЕ ЗаписатьXMLВФайл(ТекстВыгрузкиXML, ВремФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось записать текст запроса во временный файл!';
															|en = 'Не удалось записать текст запроса во временный файл!'"));
		Возврат Ложь;
	КонецЕсли;
	
	// считываем двоичные данные файла запроса, после чего удаляем файл
	ДвоичныеДанныеФайлаЗапроса = Новый ДвоичныеДанные(ВремФайл);
	ДвоичныеДанныеФайлаЗапроса = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаЗапроса, УникальныйИдентификатор);
	УдалитьФайлы(ВремФайл);
	
	// формируем имя файла запроса
	ИмяФайлаЗапроса = ИмяФайлаБезРасширения + ".xml";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция Квартал(Дата) Экспорт
	
	Возврат Цел((Месяц(Дата) - 1) / 3) + 1;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеЗапроса535(ДокЗапрос, Параметры)
	
	СтатусПроверки = Истина;
	
	Если Параметры = Неопределено Тогда
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.Организация) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана организация!';
															|en = 'Не задана организация!'"));
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.Получатель)  Тогда 
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан получатель!';
															|en = 'Не задан получатель!'"));
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	// проверка сведений об отправителе
	Если Параметры.ПрПодп = 1 Тогда // отправитель - налогоплательщик
		Если Параметры.ЭтоПБОЮЛ Тогда
			Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН индивидуального предпринимателя!';
																	|en = 'Не задан ИНН индивидуального предпринимателя!'"));
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СвПредст = Параметры.Доверенность.СвУпПред.СвПред;
		Если НЕ СвПредст.Свойство("СвОрг") Тогда
			Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННФЛ = СвПредст.СведФизЛ.ИННФЛ;
			Иначе
				ИННФЛ = ?(Параметры.ЭтоПБОЮЛ, Параметры.ИННФЛ, Параметры.ИННЮЛ);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ИННФЛ) Тогда
				Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации ИЛИ Параметры.ЭтоПБОЮЛ Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН физлица-представителя!';
																		|en = 'Не задан ИНН физлица-представителя!'"));
				Иначе
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН организации физлица-представителя!';
																		|en = 'Не задан ИНН организации физлица-представителя!'"));
				КонецЕсли;
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Параметры.КодНО) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан налоговый орган!';
															|en = 'Не задан налоговый орган!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если СтрДлина(Параметры.КодНО) <> 4 ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Параметры.КодНО) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Код налогового органа должен состоять из четырех цифр!';
															|en = 'Код налогового органа должен состоять из четырех цифр!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	ЭтоСправка = ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.СправкаОНаличииСальдо;

	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ДатаНачалаПериода) И НЕ ЭтоСправка Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана дата начала периода!';
															|en = 'Не задана дата начала периода!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ДатаОкончанияПериода) И НЕ ЭтоСправка Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задана дата окончания периода!';
															|en = 'Не задана дата окончания периода!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если ДокЗапрос.ДатаНачалаПериода > ДокЗапрос.ДатаОкончанияПериода Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Дата начала периода не может быть больше даты окончания!';
															|en = 'Дата начала периода не может быть больше даты окончания!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокЗапрос.ФорматОтвета) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Выберите один из типов файла ответа!';
															|en = 'Выберите один из типов файла ответа!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Если Параметры.ЭтоПБОЮЛ Тогда
		Если ПустаяСтрока(Параметры.ИПФамилия) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить фамилию индивидуального предпринимателя!';
																|en = 'Не удалось определить фамилию индивидуального предпринимателя!'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
		Если ПустаяСтрока(Параметры.ИПИмя) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить имя индивидуального предпринимателя!';
																|en = 'Не удалось определить имя индивидуального предпринимателя!'"));
			СтатусПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДокЗапрос.ВидУслуги = Перечисления.ВидыУслугПриИОН.ПустаяСсылка() Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не указан вид сверки!';
															|en = 'Не указан вид сверки!'"));
		СтатусПроверки = Ложь;
	КонецЕсли;
	
	Возврат СтатусПроверки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ СОХРАНЕНИЯ ЗАПРОСА В ФАЙЛ НА ДИСК

&НаКлиенте
Процедура ВыгрузитьЗапросИОНВФайл(ДокЗапрос, УникальныйИдентификатор = Неопределено) Экспорт
	Перем Запрос, ИмяФайлаЗапроса;
	
	Если СформироватьФайлЗапросаИОН(ДокЗапрос, Запрос, ИмяФайлаЗапроса, УникальныйИдентификатор) Тогда
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(Новый Структура("Адрес, Имя", Запрос, ИмяФайлаЗапроса));
	КонецЕсли;
	
КонецПроцедуры

