&НаКлиенте
Процедура ПодтвердитьПовторнуюОтправку(Документ, КонтролирующийОрган, ОписаниеОповещения)

	ЭтоГрупповаяОтправка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ОписаниеОповещения);
	Если ЭтоГрупповаяОтправка Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("ПолучатьДаты, ПолучатьОшибкиОтправки", Ложь, Ложь);
	СостояниеОтправки 		= ТекущееСостояниеОтправки(Документ, КонтролирующийОрган, ДополнительныеПараметры);
	
	Если СостояниеОтправки <> Неопределено И СостояниеОтправки.ТекущийЭтапОтправки <> Неопределено Тогда
		СостояниеСдачиОтчетности = СостояниеОтправки.ТекущийЭтапОтправки.СостояниеСдачиОтчетности;
	Иначе
		СостояниеСдачиОтчетности = Неопределено;
	КонецЕсли;

	Если СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ДокументооборотНачат") Тогда
		ТекстВопроса = НСтр("ru = 'Отчет уже отправлен, результат отправки не получен.
								  |Вы действительно хотите отправить отчет повторно?';
								  |en = 'Отчет уже отправлен, результат отправки не получен.
								  |Вы действительно хотите отправить отчет повторно?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
	ИначеЕсли СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота") Тогда
		ТекстВопроса = НСтр("ru = 'Отчет уже отправлен и успешно сдан.
								  |Вы действительно хотите отправить отчет повторно?';
								  |en = 'Отчет уже отправлен и успешно сдан.
								  |Вы действительно хотите отправить отчет повторно?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;

КонецПроцедуры


#Область ОтправкаРегламентированногоОтчетаВФНС

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНС(Док, ВыполняемоеОповещение) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("Док",                   Док);
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки",
		ЭтотОбъект,
		Контекст);
	
	ПодтвердитьПовторнуюОтправку(Док, "ФНС", ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Результат = КодВозвратаДиалога.Да;
	Параметры_ВходящийКонтекст = ВходящийКонтекст;
	
	ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки(Параметры_Результат, Параметры_ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогиная процедура ОтправкаРегламентированногоОтчетаВФНС(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Док = ВходящийКонтекст.Док;
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ОтправкаОбъектаЗапрещена = ДокументооборотСКОВызовСервера.ОтправкаОбъектаЗапрещенаНаТарифеПромоЕНС(Док);
	Если ОтправкаОбъектаЗапрещена Тогда
		ДокументооборотСКОКлиент.СообщитьОНевозможностиОтправкиНаТарифе(Док);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;

	Если НЕ ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(КонтекстОтправки, Док, УникальныйИдентификатор) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаРегламентированногоОтчетаВФНСПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
				
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ОповещениеОЗавершении, Ложь); //+
			
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС

		КонецЕсли;
		
		Возврат;
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ОповещениеОЗавершении, Ложь); //+
		Возврат;
		
	КонецЕсли;
	
	// Выгрузка
	КоличествоФайловВКомплекте = КоличествоФайловВКомплекте(Док);
	
	Если КоличествоФайловВКомплекте > 1 
		И КонтекстОтправки.ВидОтправляемогоОтчета = "РегламентированныйОтчетУведомлениеОКонтролируемыхСделках" 
		И КонтекстОтправки.ТипОтправляемогоДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		
		КонтекстДлительнойОперации = Новый Структура;
		КонтекстДлительнойОперации.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		КонтекстДлительнойОперации.Вставить("КонтекстОтправки", 	 КонтекстОтправки);
		
		ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
		ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
		ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
		ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
		
		Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка эл. предст. отчета в ФНС
			Возврат;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплекте", 0.1, Истина);
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки", ЭтотОбъект, ВходящийКонтекст);
		
		ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
		// выгружаем отчет и доверенность, при необходимости
		ВыгрузитьРегламентированныйОтчетИДоверенностьДляОтправки(КонтекстОтправки, Оповещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	
	РезультатВыгрузки     = Результат.РезультатВыгрузки;
	КонтекстОтправки      = Результат.Контекст; // Обновленный по результатам выгрузки контекст.
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если РезультатВыгрузки = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
		
	ИначеЕсли НЕ РезультатВыгрузки Тогда
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", Док);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФНС
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВФНСПослеВыгрузки() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Док 				= КонтекстДлительнойОперации.Док;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи..."); // ФНС рег. отчет
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.КонтекстОтправки.Документ, ВходящийКонтекст.КонтекстОтправки.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// получаем свойства сертификатов абонента
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется проверка сертификатов..."); // ФНС рег. отчет

	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
	
	СформироватьПакетФНС_ПроверкиСертификатов(Оповещение, ВходящийКонтекст.КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		
		Возврат;
		
	КонецЕсли;
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	КонтекстОтправки      = ВходящийКонтекст.КонтекстОтправки;
	
	// отражаем изменения в базе
	Если НЕ ОтправкаРегламентированногоОтчетаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		
		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФНСПослеФормированияПакета", ЭтотОбъект, Контекст);
	
	ТекстСведений = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КонтекстОтправки, "ТекстСведений");
	ПараметрыОперации = Новый Структура("ТекстСведений", ТекстСведений);
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС", ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт 

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);

		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		
		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(ВходящийКонтекст.КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС

		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительноеСообщениеПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительноеСообщение",
			ВходящийКонтекст.КонтекстОтправки.ДополнительноеСообщениеПриУдачнойОтправке);
	КонецЕсли;
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительныеРеквизитыДляОтправкиПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеРеквизитыДляОтправки",
			ВходящийКонтекст.КонтекстОтправки.ДополнительныеРеквизитыДляОтправкиПриУдачнойОтправке);
	КонецЕсли;
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительныеВложенияДляОтправкиПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеВложенияДляОтправки",
			ВходящийКонтекст.КонтекстОтправки.ДополнительныеВложенияДляОтправкиПриУдачнойОтправке);
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФНС.
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(Контекст, Знач Документ, Знач УникальныйИдентификатор)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ТекстСообщения = "";
	Результат = КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВФНС_ПередВыгрузкойФайла(Контекст, Документ, УникальныйИдентификатор, ТекстСообщения);
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст);
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплекте() Экспорт
	
	ВходящийКонтекст = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МассивИменФайловКомплекта = ПолучитьИменаФайловЭлектронныхПредставленийВХранилище(КонтекстОтправки.Документ);
	
	ВходящийКонтекст.Вставить("МассивИменФайловКомплекта", МассивИменФайловКомплекта);
	ВходящийКонтекст.Вставить("ТекущиеИмяФайлаКомплекта", 0);
	
	ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплектеПоследовательно(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплектеПоследовательно(ВходящийКонтекст)
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если ВходящийКонтекст.ТекущиеИмяФайлаКомплекта < ВходящийКонтекст.МассивИменФайловКомплекта.Количество() Тогда
		ИмяФайла = ВходящийКонтекст.МассивИменФайловКомплекта[ВходящийКонтекст.ТекущиеИмяФайлаКомплекта];
		
		ФайлКомплекта = Новый Структура;
		ДлительнаяОтправкаКлиент.ВывестиСостояние("Получение документа из базы данных..."); // ФНС рег. отчет
		ФайлКомплекта.Вставить("ТекстВыгрузки", АдресХранилищаФайлаЭлектронногоПредставления(КонтекстОтправки.Документ, ИмяФайла));
		ФайлКомплекта.Вставить("ИмяФайлаВыгрузки", ИмяФайла);
		
		КонтекстОтправки.Вставить("ТекстВыгрузки", ФайлКомплекта.ТекстВыгрузки);
		КонтекстОтправки.Вставить("ИмяФайлаВыгрузки", ФайлКомплекта.ИмяФайлаВыгрузки);
		
		// выгружаем доверенность
		Если НЕ ВыгрузитьДоверенностьИНараститьСчетчикФайловПриНеобходимости(КонтекстОтправки) Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
			Возврат;
			
		КонецЕсли;
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		// отражаем изменения в базе
		Если НЕ ОтправкаРегламентированногоОтчетаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
			
			Возврат;
			
		КонецЕсли;
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплектеПоследовательноПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
		
		Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС");
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФНС.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплектеПоследовательноПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);

		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС

		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		
		Возврат;
		
	КонецЕсли;
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	УдалитьИзВременногоХранилища(КонтекстОтправки.ТекстВыгрузки);
	
	ВходящийКонтекст.ТекущиеИмяФайлаКомплекта = ВходящийКонтекст.ТекущиеИмяФайлаКомплекта + 1;
	ОтправкаРегламентированногоОтчетаВФНСОтправкаФайловВКомплектеПоследовательно(ВходящийКонтекст);
	
КонецПроцедуры

#КонецОбласти

#Область ПодписьXMLDSig

// конец блока

&НаКлиенте
Процедура ПодписатьФайлXMLDSig(
		СертификатПодписанта,
		ФайлДанных,
		ВыполняемоеОповещение,
		Знач ПодписанныйФайл = Неопределено,
		Кодировка = Неопределено,
		НастройкиПодписи = Неопределено) Экспорт
	
	СкорректированныйПодписанныйФайл = ПодписанныйФайл;
	Если СкорректированныйПодписанныйФайл <> Неопределено И СтрНайти(СкорректированныйПодписанныйФайл, "|") Тогда
		СоставляющиеПути = СтрРазделить(СкорректированныйПодписанныйФайл, "|");
		УникальныйИдентификаторВНижнемРегистре = НРег(Новый УникальныйИдентификатор);
		СкорректированныйПодписанныйФайл = СоставляющиеПути[0]
			+ СтрЗаменить(УникальныйИдентификаторВНижнемРегистре, "-", "") + СоставляющиеПути[1];
	КонецЕсли;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатПодписанта);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 					ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ФайлДанных", 								ФайлДанных);
	ДополнительныеПараметры.Вставить("ПодписанныйФайл", 						СкорректированныйПодписанныйФайл);
	ДополнительныеПараметры.Вставить("СертификатПодписанта", 					СертификатПодписанта);
	ДополнительныеПараметры.Вставить("Кодировка", 								Кодировка);
	ДополнительныеПараметры.Вставить("НастройкиПодписи", 						НастройкиПодписи);
	ДополнительныеПараметры.Вставить("СодержимоеФайлаXMLВBase64", 				Неопределено);
	ДополнительныеПараметры.Вставить("АдресСодержимогоПодготовленногоФайлаXML", Неопределено);
	ДополнительныеПараметры.Вставить("АдресДанныхДляПодписиФайлаXML", 			Неопределено);
	ДополнительныеПараметры.Вставить("ДанныеДляПодписиФайлаXML", 				Неопределено);
	ДополнительныеПараметры.Вставить("ИмяКанонизированногоФайлаКлючаXML", 		Неопределено);
	ДополнительныеПараметры.Вставить("ВключатьХэшСертификата", 					Неопределено);
	ДополнительныеПараметры.Вставить("ПодписьКлючаДляИзвлеченияХешаВBase64", 	Неопределено);
	ДополнительныеПараметры.Вставить("ИмяКанонизированногоФайлаXML", 			Неопределено);
	ДополнительныеПараметры.Вставить("ХешСтрокаВBase64Ключа", 					Неопределено);
	ДополнительныеПараметры.Вставить("ХешСтрокаВBase64", 						Неопределено);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	ДанныеОблачнойПодписи = СвойствоСтруктуры(НастройкиПодписи, "ДанныеОблачнойПодписи");
	Если ДанныеОблачнойПодписи = Неопределено Тогда
		ПодготовитьОблачнуюПодпись("Данные для подписи", ".xml", Истина, ДополнительныеПараметры);
	Иначе
		ДополнительныеПараметры.Вставить("ДанныеОблачнойПодписи", ДанныеОблачнойПодписи);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеОпределенияАлгоритма", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыОпределенияАлгоритма = Новый Структура("Сертификат", СертификатПодписанта);
	КриптографияЭДКОКлиент.ОпределитьАлгоритм(
		Оповещение,
		МестоХраненияКлюча,
		ПараметрыОпределенияАлгоритма,
		Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеОпределенияАлгоритма(Результат, ДополнительныеПараметры) Экспорт
	
	ФайлДанных = ДополнительныеПараметры.ФайлДанных;
	
	Алгоритм = ?(Результат.Выполнено И ЗначениеЗаполнено(Результат.Алгоритм), Результат.Алгоритм,
		КриптографияЭДКОКлиентСервер.АлгоритмПоУмолчанию());
	ДополнительныеПараметры.Вставить("Алгоритм", Алгоритм);
	ДополнительныеПараметры.Вставить("ТипКриптопровайдераВладельца",
		?(Результат.Выполнено, Результат.ТипКриптопровайдераВладельца, Неопределено));
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЧтенияФайлаXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ФайлДанных);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	ИначеЕсли ЭтоАдресВременногоХранилища(ФайлДанных) Тогда
		ФайлДанных64 = ПолучитьАдресСтрокой64(ФайлДанных);
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ФайлДанных64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ФайлДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЧтенияФайлаXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	НастройкиПодписи = ДополнительныеПараметры.НастройкиПодписи;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СодержимоеФайлаXMLВBase64 = Результат.СтрокаBase64;
	
	ИсключитьПовторноеПодписывание = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИсключитьПовторноеПодписывание", Ложь);
	Если ИсключитьПовторноеПодписывание Тогда
		Содержимое64 = ?(ЭтоАдресВременногоХранилища(СодержимоеФайлаXMLВBase64),
			ПолучитьАдресСтрокой64(СодержимоеФайлаXMLВBase64), СодержимоеФайлаXMLВBase64);
		ДанныеСодержимого = Base64Значение(Содержимое64);
		ТекстСодержимого = ПолучитьСтрокуИзДвоичныхДанных(ДанныеСодержимого, "utf-8");
		СодержимоеПодписано = СтрНайти(ТекстСодержимого, "<X509Certificate") <> 0;
		Если СодержимоеПодписано Тогда
			Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиПодписанногоФайлаXMLЗавершение",
				ЭтотОбъект, ДополнительныеПараметры);
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
				Истина, Неопределено, ДополнительныеПараметры.ФайлДанных);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НеВключатьИнформациюОСертификате = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("НеВключатьИнформациюОСертификате"),
		НастройкиПодписи.НеВключатьИнформациюОСертификате, Ложь);
	
	ДополнительныеПараметры.Вставить("СодержимоеФайлаXMLВBase64", СодержимоеФайлаXMLВBase64);
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЭкспортаСертификатаПолучателяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ НеВключатьИнформациюОСертификате Тогда
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатПодписанта);
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СтрокаBase64", Истина, Неопределено, "");
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЭкспортаСертификатаПолучателяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателяВBase64 = Результат.СтрокаBase64;
	ДополнительныеПараметры.Вставить("СертификатПолучателяВBase64", СертификатПолучателяВBase64);
	
	НастройкиПодписи = ДополнительныеПараметры.НастройкиПодписи;
	ДобавитьШтампВремени = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ДобавитьШтампВремени"),
		НастройкиПодписи.ДобавитьШтампВремени, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиФайлаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ДобавитьШтампВремени Тогда
		Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
			ДанныеСертификата = Base64Значение(СертификатПолучателяВBase64);
			АдресСертификата = ПоместитьВоВременноеХранилище(ДанныеСертификата, Новый УникальныйИдентификатор);
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, АдресСертификата);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СертификатПолучателяВBase64);
		КонецЕсли;
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиФайлаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСертификата = Результат.ИмяФайла;
	ДополнительныеПараметры.Вставить("ИмяФайлаСертификата", ИмяФайлаСертификата);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеХешированияСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ИмяФайлаСертификата = Неопределено Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, Хеш", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры),
			ИмяФайлаСертификата,,,,
			ДополнительныеПараметры.Алгоритм,
			Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеХешированияСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатПодписанта 				= ДополнительныеПараметры.СертификатПодписанта;
	НастройкиПодписи 					= ДополнительныеПараметры.НастройкиПодписи;
	ИмяФайлаСертификата 				= ДополнительныеПараметры.ИмяФайлаСертификата;
	
	Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) И ИмяФайлаСертификата <> Неопределено Тогда
		УдалитьИзВременногоХранилища(ИмяФайлаСертификата);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ХешСертификата = Результат.Хеш;
	Если ХешСертификата <> Неопределено Тогда
		ИсключитьИдентификаторСсылкиРодителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
			"ИсключитьИдентификаторСсылкиРодителя", Ложь);
		Если НастройкиПодписи.Свойство("ИдентификаторРодителя")
			И ЗначениеЗаполнено(НастройкиПодписи.ИдентификаторРодителя) Тогда
			
			ИдентификаторСсылкиРодителя = "";
			Если НЕ ИсключитьИдентификаторСсылкиРодителя Тогда
				УникальныйИдентификаторПодписи = Строка(Новый УникальныйИдентификатор);
				ИдентификаторСсылкиРодителя = СтрШаблон(
					"<referenceId>xmldsig-%1-ref0</referenceId>",
					УникальныйИдентификаторПодписи);
			КонецЕсли;
			
			ДополнениеОбъекта = СтрШаблон(
				"<authorities xmlns=""urn:ru:fss:integration:types:signature:v01"""
				+ " xmlns:ns2=""http://www.fss.ru/integration/types/common/v01"""
				+ " xmlns:ns3=""urn:ru:fss:integration:types:mchd:v01"">"
				  + "<authority>"
				    + "%1"
				    + "<ns3:powerOfAttorneyLink>"
				      + "<ns3:uuid>%2</ns3:uuid>"
				      + "</ns3:powerOfAttorneyLink>"
				  + "</authority>"
				+ "</authorities>",
				ИдентификаторСсылкиРодителя,
				НастройкиПодписи.ИдентификаторРодителя);
		Иначе
			ДополнениеОбъекта = Неопределено;
		КонецЕсли;
		
		НастройкиПодписи.Вставить("СертификатПодписанта", 			СертификатПодписанта);
		НастройкиПодписи.Вставить("ХешСертификата", 				ХешСертификата);
		НастройкиПодписи.Вставить("УникальныйИдентификаторПодписи", Новый УникальныйИдентификатор);
		НастройкиПодписи.Вставить("ДополнениеОбъекта", 				ДополнениеОбъекта);
	КонецЕсли;
	
	ПодстрокаУзлаДляИнформацииОПодписи = ?(НастройкиПодписи <> Неопределено
		И НастройкиПодписи.Свойство("ПодстрокаУзлаДляИнформацииОПодписи"),
		НастройкиПодписи.ПодстрокаУзлаДляИнформацииОПодписи, "");
	
	Если ЗначениеЗаполнено(ПодстрокаУзлаДляИнформацииОПодписи) Тогда
		НастройкиПодписи.Вставить("СертификатПодписанта", СертификатПодписанта);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПоискаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(ПодстрокаУзлаДляИнформацииОПодписи) И (НЕ СертификатПодписанта.Свойство("Владелец")
		ИЛИ НЕ СертификатПодписанта.Свойство("Поставщик") ИЛИ НЕ СертификатПодписанта.Свойство("ДействителенС")
		ИЛИ НЕ СертификатПодписанта.Свойство("ДействителенПо")) Тогда
		
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатПодписанта);
		Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатПодписанта.Отпечаток, "MY");
			
		Иначе
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				СвойстваСертификатаПодписанта =
					ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СертификатПодписанта.Отпечаток, "MY");
			Иначе
				СвойстваСертификатаПодписанта = ПолучитьСвойстваОблачногоСертификата(СертификатПодписанта.Отпечаток, "MY");
			КонецЕсли;
			РезультатВыполнения = Новый Структура("Выполнено, СертификатНайден, СвойстваСертификата",
				Истина, СвойстваСертификатаПодписанта <> Неопределено, СвойстваСертификатаПодписанта);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		КонецЕсли;
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, СертификатНайден, СвойстваСертификата",
			Истина, Истина, СертификатПодписанта);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеПоискаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	Кодировка 							= ДополнительныеПараметры.Кодировка;
	СодержимоеФайлаXMLВBase64 			= ДополнительныеПараметры.СодержимоеФайлаXMLВBase64;
	НастройкиПодписи 					= ДополнительныеПараметры.НастройкиПодписи;
	Алгоритм 							= ДополнительныеПараметры.Алгоритм;
	СертификатПолучателяВBase64 		= ДополнительныеПараметры.СертификатПолучателяВBase64;
	
	Если НЕ Результат.Выполнено ИЛИ НЕ Результат.СертификатНайден Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Трансформация1_1 = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("Трансформация1_1"),
		НастройкиПодписи.Трансформация1_1, Ложь);
	ВключатьХэшСертификата = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ВключатьХэшСертификата"),
		НастройкиПодписи.ВключатьХэшСертификата, Ложь);
	ДанныеВнутриПодписи = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ДанныеВнутриПодписи"),
		НастройкиПодписи.ДанныеВнутриПодписи, Ложь);
	ДобавляемыеАтрибуты = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ДобавляемыеАтрибуты"),
		НастройкиПодписи.ДобавляемыеАтрибуты, Ложь);
	ПодстрокаУзлаДляИнформацииОПодписи = ?(НастройкиПодписи <> Неопределено
		И НастройкиПодписи.Свойство("ПодстрокаУзлаДляИнформацииОПодписи"),
		НастройкиПодписи.ПодстрокаУзлаДляИнформацииОПодписи, "");
	
	Если ЗначениеЗаполнено(ПодстрокаУзлаДляИнформацииОПодписи) Тогда
		НастройкиПодписи.Вставить("СертификатПодписанта", Результат.СвойстваСертификата);
	КонецЕсли;
	
	ХэшВсегдаГОСТ2012 = Трансформация1_1 И ВключатьХэшСертификата;
	
	АдресСодержимогоПодготовленногоФайлаXML = Неопределено;
	АдресДанныхДляПодписиФайлаXML = АдресДанныхДляПодписиФайлаXMLНаСервере(
											СодержимоеФайлаXMLВBase64,
											АдресСодержимогоПодготовленногоФайлаXML,
											СертификатПолучателяВBase64,
											Кодировка,
											НастройкиПодписи,
											?(ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", Алгоритм));
	Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
		ДанныеДляПодписиФайлаXML = АдресДанныхДляПодписиФайлаXML;
	Иначе
		ДанныеДляПодписиФайлаXML = ПолучитьИзВременногоХранилища(АдресДанныхДляПодписиФайлаXML);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("АдресСодержимогоПодготовленногоФайлаXML", АдресСодержимогоПодготовленногоФайлаXML);
	ДополнительныеПараметры.Вставить("АдресДанныхДляПодписиФайлаXML", 			АдресДанныхДляПодписиФайлаXML);
	ДополнительныеПараметры.Вставить("ДанныеДляПодписиФайлаXML", 				ДанныеДляПодписиФайлаXML);
	ДополнительныеПараметры.Вставить("ВключатьХэшСертификата", 					ВключатьХэшСертификата);
	ДополнительныеПараметры.Вставить("ДанныеВнутриПодписи", 					ДанныеВнутриПодписи);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибуты);
	ДополнительныеПараметры.Вставить("ХэшВсегдаГОСТ2012", 						ХэшВсегдаГОСТ2012);
	
	Если ВключатьХэшСертификата Тогда
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаКлючаXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОКлючахXMLВBase64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОКлючахXMLВBase64);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПодписанияКанонизированногоФайлаКлючаXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаКлючаXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяКанонизированногоФайлаКлючаXML = Результат.ИмяФайла;
	
	// Из подписи извлечем DigestValue ключа
	ДополнительныеПараметры.Вставить("ИмяКанонизированногоФайлаКлючаXML", ИмяКанонизированногоФайлаКлючаXML);
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПодписанияКанонизированногоФайлаКлючаXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоПодписьСервиса(ДополнительныеПараметры) И НЕ ДополнительныеПараметры.ХэшВсегдаГОСТ2012 Тогда
		КриптографияЭДКОКлиент.ПодписатьPKCS7(Оповещение, СертификатПодписанта, ИмяКанонизированногоФайлаКлючаXML, Ложь,, Ложь);
		
	ИначеЕсли ЭтоОблачнаяПодпись(ДополнительныеПараметры) Тогда
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			КонтекстМоделиХраненияКлюча(ДополнительныеПараметры),
			ИмяКанонизированногоФайлаКлючаXML,,
			Ложь,,
			?(ДополнительныеПараметры.ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", ДополнительныеПараметры.Алгоритм));
	Иначе
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			КонтекстМоделиХраненияКлюча(ДополнительныеПараметры),
			ИмяКанонизированногоФайлаКлючаXML,,
			Ложь,,
			?(ДополнительныеПараметры.ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", СертификатПодписанта));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеПодписанияКанонизированногоФайлаКлючаXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДанныеДляПодписиФайлаXML = ДополнительныеПараметры.ДанныеДляПодписиФайлаXML;
	ВключатьХэшСертификата = ДополнительныеПараметры.ВключатьХэшСертификата;
	ДанныеВнутриПодписи = ДополнительныеПараметры.ДанныеВнутриПодписи;
	
	Если Результат <> Неопределено И НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПодписьКлючаДляИзвлеченияХешаВBase64 = Неопределено;
	Если Результат <> Неопределено Тогда
		ЭтоШестнадцатеричноеПредставлениеХеша = НЕ ЭтоПодписьСервиса(ДополнительныеПараметры)
			ИЛИ ДополнительныеПараметры.ХэшВсегдаГОСТ2012;
		
		ПодписьКлючаДляИзвлеченияХешаВBase64 = ?(НЕ ЭтоШестнадцатеричноеПредставлениеХеша, Результат.ФайлПодписи, Результат.Хеш);
	КонецЕсли;
	
	КанонизированныйОбъектXMLВBase64 = ?(ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи, 
											ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64, 
											ДанныеДляПодписиФайлаXML.КанонизированныйФайлXMLВBase64);
	
	ДополнительныеПараметры.Вставить("ПодписьКлючаДляИзвлеченияХешаВBase64", ПодписьКлючаДляИзвлеченияХешаВBase64);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, КанонизированныйОбъектXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, КанонизированныйОбъектXMLВBase64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяКанонизированногоФайлаXML = Результат.ИмяФайла;
	
	// Из подписи извлечем DigestValue
	
	ДополнительныеПараметры.Вставить("ИмяКанонизированногоФайлаXML", ИмяКанонизированногоФайлаXML);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПодписанияКанонизированногоXMLЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) И НЕ ДополнительныеПараметры.ХэшВсегдаГОСТ2012 Тогда
		ИмяФайлаПодписи = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
		КриптографияЭДКОКлиент.ПодписатьPKCS7(Оповещение, СертификатПодписанта, ИмяКанонизированногоФайлаXML, Ложь, ИмяФайлаПодписи, Ложь);
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			МестоХраненияКлюча,
			ИмяКанонизированногоФайлаXML,,
			Ложь,,
			?(ДополнительныеПараметры.ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", ДополнительныеПараметры.Алгоритм));
		
	Иначе
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			МестоХраненияКлюча,
			ИмяКанонизированногоФайлаXML,,
			Ложь,,
			?(ДополнительныеПараметры.ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", СертификатПодписанта));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеПодписанияКанонизированногоXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 					= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресДанныхДляПодписиФайлаXML 			= ДополнительныеПараметры.АдресДанныхДляПодписиФайлаXML;
	ДанныеДляПодписиФайлаXML 				= ДополнительныеПараметры.ДанныеДляПодписиФайлаXML;
	ПодписьКлючаДляИзвлеченияХешаВBase64 	= ДополнительныеПараметры.ПодписьКлючаДляИзвлеченияХешаВBase64;
	ДобавляемыеАтрибуты 					= ДополнительныеПараметры.ДобавляемыеАтрибуты;
	НастройкиПодписи 						= ДополнительныеПараметры.НастройкиПодписи;
	ПодписьСервиса 							= ЭтоПодписьСервиса(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЭтоШестнадцатеричноеПредставлениеХеша = НЕ ПодписьСервиса ИЛИ ДополнительныеПараметры.ХэшВсегдаГОСТ2012;
	
	ПодписьДляИзвлеченияХешаВBase64 = ?(НЕ ЭтоШестнадцатеричноеПредставлениеХеша, Результат.ФайлПодписи, Результат.Хеш);
	
	ДополнительныеПараметры.Вставить("ПодписьДляИзвлеченияХешаВBase64", ПодписьДляИзвлеченияХешаВBase64);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаПодписанныхСвойств",
		ЭтотОбъект, ДополнительныеПараметры);
	ДобавитьШтампВремени = ?(НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ДобавитьШтампВремени"),
		НастройкиПодписи.ДобавитьШтампВремени, Ложь);
	Если ДобавитьШтампВремени Тогда
		Если ПодписьСервиса Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
				Истина, Неопределено, ДанныеДляПодписиФайлаXML.КанонизированныйУзелПодписанныхСвойствВBase64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение,
				ДанныеДляПодписиФайлаXML.КанонизированныйУзелПодписанныхСвойствВBase64);
		КонецЕсли;
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

