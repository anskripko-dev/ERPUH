&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФСС(ВыполняемоеОповещение, ЗапросДляПолученияЭЛН) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		ЗапросДляПолученияЭЛН.Организация);
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеЭЛНИзФССПослеПодписиSOAP", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыгрузкаЗапросаОперацииСЭЛН = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ЗапросДляПолученияЭЛН);
	ВыгрузкаЗапросаОперацииСЭЛН.Вставить("ТекстЗапроса", ВыгрузкаЗапросаОперацииСЭЛН.ТекстXML);
	ВыгрузкаЗапросаОперацииСЭЛН.Удалить("ТекстXML");
	
	// Подписание запроса.
	АдресПодписанногоSOAPОперацииСЭЛНВФСС(
		Оповещение,
		ВыгрузкаЗапросаОперацииСЭЛН);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФССПослеПодписиSOAP(АдресЗашифрованногоЗапросаSOAP, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 		= ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если НЕ ЗначениеЗаполнено(АдресЗашифрованногоЗапросаSOAP) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Получение данных ЭЛН из ФСС...';
					|en = 'Получение данных ЭЛН из ФСС...'"));
	
	// Отправка запроса.
	РезультатОтправки = ОтправитьЗапросСервисуФССЭЛННаСервере(
		ОрганизацияСсылка,
		"getPrivateLNData",
		АдресЗашифрованногоЗапросаSOAP);
	Если РезультатОтправки.АдресЗашифрованногоОтветаSOAP = Неопределено Тогда
		Если СтрНайти(РезультатОтправки.ТекстОшибки, "зашифровано на ключе отличном от ключа уполномоченного лица") > 0 Тогда
			ИнструкцияСсылка = Новый ФорматированнаяСтрока(
				НСтр("ru = 'Инструкция по установке и настройке сертификатов обмена с ФСС.';
					|en = 'Инструкция по установке и настройке сертификатов обмена с ФСС.'"),,,,
				"https://its.1c.ru/bmk/elreps/fss_cert");
			ТекстСообщения = Новый ФорматированнаяСтрока(
				НСтр("ru = 'Ошибка расшифровки на сервере ФСС: выбран некорректный сертификата ФСС ЭЛН, ПОВЭД, СЭДО в настройках обмена с ФСС.';
					|en = 'Ошибка расшифровки на сервере ФСС: выбран некорректный сертификата ФСС ЭЛН, ПОВЭД, СЭДО в настройках обмена с ФСС.'") + "
							|
							|",
				ИнструкцияСсылка);
			ПоказатьПредупреждение(, ТекстСообщения);
			
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеЭЛНИзФССПослеПроверкиПодписиSOAP", ЭтотОбъект, ДополнительныеПараметры);
	ПроверитьПодписьSOAPОтветаЭЛНВФСС(
		Оповещение,
		ОрганизацияСсылка,
		РезультатОтправки.АдресЗашифрованногоОтветаSOAP);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЭЛНИзФССПослеПроверкиПодписиSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Выводим сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись ЭЛН недействительна.';
							|en = 'Подпись ЭЛН недействительна.'");
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных ЭЛН из ФСС';
				|en = 'Электронный документооборот с контролирующими органами. Получение данных ЭЛН из ФСС'"),
			"Предупреждение",
			ТекстОшибки,,
			Истина);
	КонецЕсли;
	Результат.Вставить("ОшибкаПроверкиПодписиЗаписана", НЕ Результат.ПодписьВалидна);
	Результат.ПодписьВалидна = Истина;
	
	Состояние(НСтр("ru = 'Получение данных ЭЛН из ФСС...';
					|en = 'Получение данных ЭЛН из ФСС...'"));
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
