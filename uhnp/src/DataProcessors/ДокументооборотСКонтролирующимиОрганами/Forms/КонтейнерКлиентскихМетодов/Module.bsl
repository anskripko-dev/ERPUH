&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокиМассиваСтруктур(Знач МассивСтруктур, КлючПоиска, ЗначениеПоиска) Экспорт
	
	МассивДляПоиска = СкопироватьМассив(МассивСтруктур);
	Счетчик = 0;
	КоличествоЭлементов = МассивДляПоиска.Количество();
	Пока Счетчик < КоличествоЭлементов Цикл
		Если МассивДляПоиска[Счетчик].Свойство(КлючПоиска)
			И МассивДляПоиска[Счетчик][КлючПоиска] = ЗначениеПоиска Тогда
			Счетчик = Счетчик + 1;
		Иначе
			МассивДляПоиска.Удалить(Счетчик);
			КоличествоЭлементов = КоличествоЭлементов - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат МассивДляПоиска;
	
КонецФункции

