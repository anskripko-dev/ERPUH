			Иначе
				// определяем документ в дереве описания
				СтрДокумент = КонтекстЭДОСервер.ОпределитьДокументВДеревеОписания(ДеревоДокументов, ВложениеДИВ.Тип, "xml", ВложениеДИВ.Идентификатор, Истина, Ложь, ВложениеДИВ.ИмяФайла, КороткоеИмяФайлаАрхива, ВложениеДИВ.Адрес);
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС Тогда
		
		// выгружаем в него все файлы сообщения
		ТипыСодержимого = Новый Массив;
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
		ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, ТипыСодержимого);
		ВложенияДИВ.Колонки.Добавить("Адрес");
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			Попытка
				ВложениеДИВ.Адрес = ПоместитьВоВременноеХранилище(ВложениеДИВ.Данные.Получить(), Контекст.УникальныйИдентификатор);
			Исключение
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				ТекстСообщения = НСтр("ru = 'Ошибка формирования пакета: не удалось сохранить файлы пакета во временный каталог.';
										|en = 'Ошибка формирования пакета: не удалось сохранить файлы пакета во временный каталог.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;
		КонецЦикла;
		
		// заполняем дерево описания сначала отчетами и описанием сведений
		Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
			
			Если ВложениеДИВ.Тип <> Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС Тогда
				Продолжить;
			КонецЕсли;
			
			// пакуем файл
			КороткоеИмяФайлаАрхива = КонтекстЭДОСервер.ЗаархивироватьФайлПакета(ВложениеДИВ, "file", Контекст.УникальныйИдентификатор);
			Если КороткоеИмяФайлаАрхива = Неопределено Тогда
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
				Возврат Ложь;
			КонецЕсли;
			
			// определяем документ в дереве описания
			СтрДокумент = КонтекстЭДОСервер.ОпределитьДокументВДеревеОписания(ДеревоДокументов, ВложениеДИВ.Тип, "xml", ВложениеДИВ.Идентификатор, Истина, Ложь, ВложениеДИВ.ИмяФайла, КороткоеИмяФайлаАрхива, ВложениеДИВ.Адрес);
		
		КонецЦикла;
		
	КонецЕсли;
	
	// дополняем дерево описания информацией об ЭЦП
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись Тогда
			ПодписанныйДокумент = ДеревоДокументов.Строки.Найти(ВложениеДИВ.ЭЦПИмяПодписанногоФайла, "ИмяФайлаДокумента");
			Если ПодписанныйДокумент <> Неопределено Тогда
				КонтекстЭДОСервер.ОпределитьДокументВДеревеОписания(ПодписанныйДокумент, , , , , , ВложениеДИВ.ИмяФайла, , ВложениеДИВ.Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МЧД = "";
	ДанныеДоверенности = Неопределено;
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС Тогда
		ПользовательМЧД = ?(Мультирежим.ЭтоМультиРежим(Контекст.УчетнаяЗапись),
			Пользователи.ТекущийПользователь(), Справочники.Пользователи.ПустаяСсылка());
		ТаблицаМЧД = ДокументооборотСКОВызовСервера.МЧДОбмена(Контекст.СсылкаОтправитель, "ФСГС", ПользовательМЧД);
		Если ТаблицаМЧД.Количество() <> 0 И ЗначениеЗаполнено(ТаблицаМЧД[0].Доверенность) Тогда
			ИмяТипаСправочникаМашиночитаемыеДоверенности = "МашиночитаемыеДоверенности";
			ПараметрыМЧДЕдиногоФормата = ДокументооборотСКОВызовСервера.ПараметрыМЧДЕдиногоФормата();
			ЭтоНомерДоверенности = (ТипЗнч(ТаблицаМЧД[0].Доверенность) = Тип("Строка"));
			ЕстьРеквизитНомерДоверенности = НЕ ЭтоНомерДоверенности
				И ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует()
				И Метаданные.Справочники[ИмяТипаСправочникаМашиночитаемыеДоверенности].Реквизиты.Найти(
				ПараметрыМЧДЕдиногоФормата.РеквизитНомерДоверенности) <> Неопределено;
			Если (ЕстьРеквизитНомерДоверенности ИЛИ ЭтоНомерДоверенности)
				И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.МЧД для Росстата", Истина) Тогда
				
				Если ЭтоНомерДоверенности Тогда
					Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Расш.МЧД для Росстата",
						'20250501') Тогда
						
						ТекстСообщения = НСтр("ru = 'Для отправки отчетности представителем требуется выбрать машиночитаемую доверенность для Росстата, поддержка указания только номера доверенности прекращена';
												|en = 'Для отправки отчетности представителем требуется выбрать машиночитаемую доверенность для Росстата, поддержка указания только номера доверенности прекращена'");
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						Возврат Ложь;
						
					Иначе
						МЧД = ТаблицаМЧД[0].Доверенность;
					КонецЕсли;
					
				Иначе
					РеквизитыМЧДЕдиногоФормата = ПараметрыМЧДЕдиногоФормата.РеквизитНомерДоверенности;
					ЕстьРеквизитДатаВыдачи = Метаданные.Справочники[ИмяТипаСправочникаМашиночитаемыеДоверенности].Реквизиты.Найти(
						ПараметрыМЧДЕдиногоФормата.РеквизитДатаВыдачи) <> Неопределено;
					Если ЕстьРеквизитДатаВыдачи Тогда
						РеквизитыМЧДЕдиногоФормата = РеквизитыМЧДЕдиногоФормата + ", " + ПараметрыМЧДЕдиногоФормата.РеквизитДатаВыдачи;
					КонецЕсли;
					ЕстьРеквизитДатаОкончания = Метаданные.Справочники[ИмяТипаСправочникаМашиночитаемыеДоверенности].Реквизиты.Найти(
						ПараметрыМЧДЕдиногоФормата.РеквизитДатаОкончания) <> Неопределено;
					Если ЕстьРеквизитДатаОкончания Тогда
						РеквизитыМЧДЕдиногоФормата = РеквизитыМЧДЕдиногоФормата + ", "
							+ ПараметрыМЧДЕдиногоФормата.РеквизитДатаОкончания;
					КонецЕсли;
					
					СвойстваМЧДЕдиногоФормата = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТаблицаМЧД[0].Доверенность,
						РеквизитыМЧДЕдиногоФормата);
					
					Если ЕстьРеквизитДатаВыдачи ИЛИ ЕстьРеквизитДатаОкончания Тогда
						ДатаСеанса = ТекущаяДатаСеанса();
						Если ЕстьРеквизитДатаОкончания
							И СвойстваМЧДЕдиногоФормата[ПараметрыМЧДЕдиногоФормата.РеквизитДатаОкончания] < ДатаСеанса Тогда
							
							ТекстСообщения = НСтр("ru = 'Истек срок действия доверенности';
													|en = 'Истек срок действия доверенности'");
							ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
							Возврат Ложь;
							
						ИначеЕсли ЕстьРеквизитДатаВыдачи
							И СвойстваМЧДЕдиногоФормата[ПараметрыМЧДЕдиногоФормата.РеквизитДатаВыдачи] > ДатаСеанса Тогда
							
							ТекстСообщения = НСтр("ru = 'Дата начала действия доверенности еще не наступила';
													|en = 'Дата начала действия доверенности еще не наступила'");
							ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
					
					ТехническийСтатус =
						ДокументооборотСКОВызовСервера.СвойстваМЧДЕдиногоФормата(ТаблицаМЧД[0].Доверенность).ТехническийСтатус;
					Если ТехническийСтатус <> Неопределено И ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Отменена") Тогда
						
						ТекстСообщения = НСтр("ru = 'Доверенность отозвана';
												|en = 'Доверенность отозвана'");
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						Возврат Ложь;
					КонецЕсли;
					
					МЧД = СвойстваМЧДЕдиногоФормата[ПараметрыМЧДЕдиногоФормата.РеквизитНомерДоверенности];
					
					Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Расш.МЧД для Росстата",
						'20250501') Тогда
						
						ДанныеДоверенности = Справочники.МашиночитаемыеДоверенностиРаспределенныйРеестр.ДанныеМЧДЕдиногоФормата(
							ТаблицаМЧД[0].Доверенность);
						Если ДанныеДоверенности = Неопределено Тогда
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			Если КриптографияЭДКОКлиентСервер.ТипСубъектаСертификата(Контекст.ОбъектСертификатРуководителя.Владелец,
				Контекст.СсылкаОтправитель) = "ФЛ" Тогда
				
				ТипОрганизации = ДокументооборотСКОВызовСервера.ТипОрганизации(Контекст.СсылкаОтправитель);
				
				Если ТипОрганизации.ЭтоИностраннаяОрганизация Тогда
					ЭтоОрганизацияОбязательнойМЧДРосстата =
						ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.МЧД ин.для Росстата", '20250801');
				ИначеЕсли ТипОрганизации.ЭтоИП Тогда
					ЭтоОрганизацияОбязательнойМЧДРосстата =
						ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.МЧД ИП для Росстата", '20250801');
				ИначеЕсли ТипОрганизации.ЭтоФилиал Тогда
					ЭтоОрганизацияОбязательнойМЧДРосстата =
						ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.МЧД фил.для Росстата", '20250501');
				Иначе
					ЭтоОрганизацияОбязательнойМЧДРосстата =
						ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.МЧД для Росстата", '20250601');
				КонецЕсли;
				
				Если ЭтоОрганизацияОбязательнойМЧДРосстата Тогда
					ТекстСообщения =
						НСтр("ru = 'В связи с вступившими в силу изменениями, для отправки отчета укажите машиночитаемую доверенность для Росстата в настройках обмена с контролирующими органами.';
							|en = 'В связи с вступившими в силу изменениями, для отправки отчета укажите машиночитаемую доверенность для Росстата в настройках обмена с контролирующими органами.'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					КонтекстОснования = Новый ФиксированнаяСтруктура("АдресСсылки", "НастройкиМЧДДляФСГС");
					ТекстСообщения = НСтр("ru = 'Настройка машиночитаемых доверенностей для Росстата';
											|en = 'Настройка машиночитаемых доверенностей для Росстата'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
						ТекстСообщения,,,,,
						КонтекстЭДОСервер.НовыйКонтекстОбработки(КонтекстОснования));
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// формируем файл описания пакета
	ФайлОписаниеПакета = СформироватьОписаниеПакетаФСГС(ДеревоДокументов,
														Контекст.UUIDПакета,
														Контекст.ТипДокументооборота,
														Контекст.ТипТранзакции,
														Контекст.КодОтправителя,
														Контекст.КодПолучателя,
														Контекст.КодСистемыОтправителя,
														Контекст.УникальныйИдентификатор,
														?(ДанныеДоверенности = Неопределено, МЧД, ДанныеДоверенности));
	Если ФайлОписаниеПакета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Контекст.Вставить("ОтложенныеКоманды", ОтложенныеКоманды);
	Контекст.Вставить("ДеревоДокументов", ПоместитьВоВременноеХранилище(ДеревоДокументов, Контекст.УникальныйИдентификатор));
	Контекст.Вставить("ФайлОписаниеПакета", ФайлОписаниеПакета);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПакетФСГС_ЗаключительныеДействияНаСервере(Контекст)
	
	// получаем дерево документов
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	// создаем каталог, в который будем помещать пакуемые файлы
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// создаем файл пакета
	КодИлиРегионПолучателя = РазделитьКодФСГС(Контекст.КодПолучателя).идентификаторСубъекта;
	КороткоеИмяФайлаПакета = Контекст.ПрефиксИмениФайлаКонтейнера + ?(ПустаяСтрока(Контекст.ПрефиксИмениФайлаКонтейнера), "", ".") + "STAT_" +
							ВРег(Контекст.КодОтправителя) + "_" +
							ВРег(КодИлиРегионПолучателя) + "_" +
							СгенерироватьUUID() + "_" + 
							Контекст.КодТипаДокументооборота + "_" +
							Контекст.КодТипаТранзакции + 
							".zip";

	ПолноеИмяФайлаПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаПакета;
	
	// создаем архив
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаПакета); // для ФСГС сжатие включено

	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// добавляем файла из дерева описания пакета
	Для Каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		ПолноеИмяДобавляемогоФайла = КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(
			КаталогФайловОтчетности, СтрДокумент);
		Если НЕ ЗначениеЗаполнено(ПолноеИмяДобавляемогоФайла) Тогда
			Возврат Ложь;
		КонецЕсли;
		ЗаписьZIP.Добавить(ПолноеИмяДобавляемогоФайла);
		Для Каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ПолноеИмяДобавляемогоФайла = КонтекстЭДОСервер.ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(
				КаталогФайловОтчетности, СтрДокумент2);
			Если НЕ ЗначениеЗаполнено(ПолноеИмяДобавляемогоФайла) Тогда
				Возврат Ложь;
			КонецЕсли;
			ЗаписьZIP.Добавить(ПолноеИмяДобавляемогоФайла);
		КонецЦикла;
	КонецЦикла;
	
	// добавляем само описание пакета
	ПолноеИмяФайлаОписанияПакета = КаталогФайловОтчетности + "packageDescription.xml";
	ПолучитьИзВременногоХранилища(Контекст.ФайлОписаниеПакета).Записать(ПолноеИмяФайлаОписанияПакета);
	ЗаписьZIP.Добавить(ПолноеИмяФайлаОписанияПакета);
	
	// записываем архив
	ЗаписьZIP.Записать();
	
	// добавляем архив в регистр
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаПакета, КороткоеИмяФайлаПакета);
	
	// удаляем временный каталог
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОКПОСтатОтчета(Сообщение)
	КодОтправителя = "";
	ИспользуетсяМеханизмНесколькихНаправлений = Ложь;
	Попытка
		РегламентированнаяОтчетностьПереопределяемый.ИспользуетсяОтправкаВРосстатПоРазнымНаправлениям(ИспользуетсяМеханизмНесколькихНаправлений);
		Если ИспользуетсяМеханизмНесколькихНаправлений Тогда 
			РеглОтчет = Сообщение.ЦиклОбмена.Предмет;
			ДанныеОтчета = РеглОтчет.ДанныеОтчета.Получить();
			Если ДанныеОтчета.Свойство("КодПодразделенияФСГС_8_14", КодОтправителя) Тогда 
				Если Не ЗначениеЗаполнено(СокрЛП(КодОтправителя)) Тогда
					КодОтправителя = ПолучитьКодОКПООрганизации(Сообщение);
				КонецЕсли;
				Возврат КодОтправителя;
			КонецЕсли;
			
			ОбособленноеПодразделение = ДанныеОтчета.ОбособленноеПодразделение;
			РегламентированнаяОтчетностьПереопределяемый.ПолучитьКодОКПОПодразделения(ОбособленноеПодразделение, КодОтправителя);
			Если Не ЗначениеЗаполнено(СокрЛП(КодОтправителя)) Тогда
				КодОтправителя = ПолучитьКодОКПООрганизации(Сообщение);
			КонецЕсли;
		Иначе
			КодОтправителя = ПолучитьКодОКПООрганизации(Сообщение);
		КонецЕсли;
	Исключение
		КодОтправителя = ПолучитьКодОКПООрганизации(Сообщение);
	КонецПопытки;
	
	Возврат КодОтправителя;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКодОКПООрганизации(Сообщение)
	ИмяРеквКодПоОКПО = "КодПоОКПО";
	Если Метаданные.Справочники.Организации.Реквизиты.Найти("КодОКПО") <> Неопределено Тогда
		ИмяРеквКодПоОКПО = "КодОКПО";
	КонецЕсли;
	Возврат СокрЛП(Сообщение.Отправитель[ИмяРеквКодПоОКПО]);
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПакетФСГС_ОбщиеПроверкиПередФормированием(Контекст)
	
	Сообщение = Контекст.ТранспортноеСообщение;
	
	// проверка на то, что сообщение исходящее
	СтатусТранспортногоСообщения = Сообщение.Статус;
	Если СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Сохраненное
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Исходящее
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Отправленное Тогда
		ТекстСообщения = НСтр("ru = 'Невозможно формирование пакета по входящему сообщению!';
								|en = 'Невозможно формирование пакета по входящему сообщению!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ПризнакОшибки = Ложь;
	
	ТипСообщения = Сообщение.Тип;
		
	СсылкаОтправитель = Сообщение.Отправитель;
	СсылкаПолучатель = ОпределитьПолучателяТранспортногоКонтейнера(Сообщение);
	УчетнаяЗапись = Сообщение.УчетнаяЗапись;
	ЦиклОбмена = Сообщение.ЦиклОбмена;
	СообщениеОснование = Сообщение.Основание;
	
	Если НЕ ЗначениеЗаполнено(ТипСообщения) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: тип транспортного сообщения не определен!';
								|en = 'Ошибка шифрования транспортного сообщения: тип транспортного сообщения не определен!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ПризнакОшибки = Истина;
	КонецЕсли;
				
	Если НЕ ЗначениеЗаполнено(СсылкаОтправитель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан отправитель!';
								|en = 'Ошибка шифрования транспортного сообщения: не задан отправитель!'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаПолучатель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан получатель!';
								|en = 'Ошибка шифрования транспортного сообщения: не задан получатель!'");
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						ПризнакОшибки = Истина;
					КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задана учетная запись!';
								|en = 'Ошибка шифрования транспортного сообщения: не задана учетная запись!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	ИначеЕсли НЕ УчетнаяЗапись.ПредназначенаДляДокументооборотаСФСГС Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: учетная запись не предназначена для электронного документооборота с Росстат!';
								|en = 'Ошибка шифрования транспортного сообщения: учетная запись не предназначена для электронного документооборота с Росстат!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
				КонецЕсли;
				
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: цикл обмена не задан!';
								|en = 'Ошибка шифрования транспортного сообщения: цикл обмена не задан!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
			
	// определяем сертификат получателя
	Если ТипЗнч(СсылкаПолучатель) <> Тип("СправочникСсылка.ОрганыФСГС") Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Получатель <%1> не является органом ФСГС.';
				|en = 'Получатель <%1> не является органом ФСГС.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);		
		Возврат Ложь;	
	КонецЕсли;
	
	СертификатПолучателя = ПолучитьСертификатСубъекта(СсылкаПолучатель);
	Если СертификатПолучателя.Количество() = 0 Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В свойствах территориального органа ФСГС %1 не задан ни один сертификат.';
				|en = 'В свойствах территориального органа ФСГС %1 не задан ни один сертификат.'"), СсылкаПолучатель);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// определяем сертификаты отправителя
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток");
	Если НЕ Сертификат.Найден Тогда
		ТекстСообщения = Сертификат.ТекстОшибки;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем и проверяем код отправителя
	КодОтправителя = ПолучитьОКПОСтатОтчета(Сообщение);
	Если ПустаяСтрока(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан код ОКПО организации-отправителя.';
								|en = 'Не задан код ОКПО организации-отправителя.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ КодОКПОСоответствуетТребованиям(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректно задан код ОКПО организации-отправителя.';
								|en = 'Некорректно задан код ОКПО организации-отправителя.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем и проверяем код получателя
	КодПолучателя = СокрЛП(СсылкаПолучатель.Код);
	Если ПустаяСтрока(СтрЗаменить(СокрЛП(КодПолучателя), "-", "")) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан код территориального органа ФСГС.';
								|en = 'Не задан код территориального органа ФСГС.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ КодОрганаФСГССоответствуетТребованиям(КодПолучателя) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректно задан код территориального органа ФСГС.';
								|en = 'Некорректно задан код территориального органа ФСГС.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
			КонецЕсли;
			
	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС Тогда
		ПрефиксИмениФайлаКонтейнера = "";
		ТипДокументооборота = "отчетСтат";
		КодТипаДокументооборота = "4";
		ТипТранзакции = "отчет";
		КодТипаТранзакции = "1";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС Тогда
		ПрефиксИмениФайлаКонтейнера = "";
		ТипДокументооборота = "отчетСтат";
		КодТипаДокументооборота = "4";
		ТипТранзакции = "подтверждениеКвитанция";
		КодТипаТранзакции = "6";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС Тогда
		ПрефиксИмениФайлаКонтейнера = "";
		ТипДокументооборота = "отчетСтат";
		КодТипаДокументооборота = "4";
		ТипТранзакции = "протоколИзвещение";
		КодТипаТранзакции = "4";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС Тогда
		ПрефиксИмениФайлаКонтейнера = "stat_unformal";
		ТипДокументооборота = "письмоРеспондент";
		КодТипаДокументооборота = "1";
		ТипТранзакции = "письмо";
		КодТипаТранзакции = "1";
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС Тогда
		ПрефиксИмениФайлаКонтейнера = "stat_unformal";
		ТипДокументооборота = "письмоОрганФСГС";
		КодТипаДокументооборота = "2";
		ТипТранзакции = "извещение";
		КодТипаТранзакции = "3";
		КонецЕсли;
		
	КодСистемыОтправителя = УчетнаяЗапись.ИдентификаторСистемыОтправителяФСГС;
	
	Если ПустаяСтрока(КодСистемыОтправителя) Тогда
		Если УчетнаяЗапись.СпецОператорСвязи = Перечисления.СпецоператорыСвязи.Такском Тогда
			КодСистемыОтправителя = "taxcom";
		ИначеЕсли УчетнаяЗапись.СпецОператорСвязи = Перечисления.СпецоператорыСвязи.КалугаАстрал Тогда
			КодСистемыОтправителя = "astralreport";
		ИначеЕсли УчетнаяЗапись.СпецОператорСвязи = Перечисления.СпецоператорыСвязи.Форус Тогда
			КодСистемыОтправителя = "astralreport";
		Иначе
			КодСистемыОтправителя = "1c";
		КонецЕсли;
	КонецЕсли;
	
	КодОтправителя = КодСистемыОтправителя + "." + КодОтправителя;

	UUIDПакета = СокрЛП(ЦиклОбмена.Идентификатор);
	
	// запоминаем в контексте
	Контекст.Вставить("ТипСообщения", ТипСообщения);
	Контекст.Вставить("СсылкаОтправитель", СсылкаОтправитель);
	Контекст.Вставить("СсылкаПолучатель", СсылкаПолучатель);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена);
	Контекст.Вставить("СертификатРуководителя", СокрЛП(Сертификат.Отпечаток)); //+
	Контекст.Вставить("СертификатОтветственногоЗаШифрование", СокрЛП(Сертификат.Отпечаток)); //+
	Контекст.Вставить("СертификатПолучателя", СертификатПолучателя);
	
	Контекст.Вставить("ТипДокументооборота", ТипДокументооборота);
	Контекст.Вставить("КодТипаДокументооборота", КодТипаДокументооборота);
	Контекст.Вставить("ТипТранзакции", ТипТранзакции);
	Контекст.Вставить("КодТипаТранзакции", КодТипаТранзакции);
	
	Контекст.Вставить("КодОтправителя", КодОтправителя);
	Контекст.Вставить("КодПолучателя", КодПолучателя);
	Контекст.Вставить("КодСистемыОтправителя", КодСистемыОтправителя);
	Контекст.Вставить("UUIDПакета", UUIDПакета);
	
	Контекст.Вставить("ПрефиксИмениФайлаКонтейнера", ПрефиксИмениФайлаКонтейнера);
	
	Контекст.Вставить("СообщениеОснование", СообщениеОснование);
	
	Возврат НЕ ПризнакОшибки;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазделитьКодФСГС(Знач КодФСГС)
	
	ЧистыйКодФСГС = СокрЛП(КодФСГС);
	Коды = Новый Структура("идентификаторСубъекта, идентификаторПодразделения");
	Если СтрДлина(ЧистыйКодФСГС) = 5 Тогда
		Коды.идентификаторСубъекта = ЧистыйКодФСГС;
		Коды.идентификаторПодразделения = "";
	Иначе
		Коды.идентификаторСубъекта = Лев(ЧистыйКодФСГС, 2);
		Коды.идентификаторПодразделения = Сред(ЧистыйКодФСГС, 4);
	КонецЕсли;
	
	Возврат Коды;
	
КонецФункции
	
&НаСервереБезКонтекста
Функция СформироватьОписаниеПакетаФСГС(
		ОписаниеДокументов,
		UUIDПакета = Неопределено,
		ТипДокументооборота = "отчетСтат",
		ТипТранзакции = "отчет",
		КодОтправителя = "",
		КодПолучателя = "",
		Знач КодСистемыОтправителя = Неопределено,
		ИдентификаторДляВременногоХранилища = Неопределено,
		МЧД = "") Экспорт
	
	Если UUIDПакета = Неопределено Тогда
		UUIDПакета = СгенерироватьUUID();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодСистемыОтправителя) Тогда
		КодСистемыОтправителя = "1C";
	КонецЕсли;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "пакет"
	УзелПакет = ДобавитьУзелXML(Дерево, "пакет");
	ДобавитьУзелXML(УзелПакет, "версияФормата",							Истина, "Стат:1.0");
	ДобавитьУзелXML(УзелПакет, "типДокументооборота",					Истина, ТипДокументооборота);
	ДобавитьУзелXML(УзелПакет, "идентификаторДокументооборота", 		Истина, UUIDПакета);
	ДобавитьУзелXML(УзелПакет, "типТранзакции",							Истина, ТипТранзакции);
	
	// добавляем узел "отправитель"
	УзелОтправитель = ДобавитьУзелXML(УзелПакет, "отправитель");
	ДобавитьУзелXML(УзелОтправитель, "идентификаторСубъекта",			Истина, СокрЛП(КодОтправителя));
	ДобавитьУзелXML(УзелОтправитель, "типСубъекта",						Истина, "респондент");
	
	// добавляем узел "системаОтправителя"
	УзелСистемаОтправителя = ДобавитьУзелXML(УзелПакет, "системаОтправителя");
	ДобавитьУзелXML(УзелСистемаОтправителя, "идентификаторСубъекта",	Истина, СокрЛП(КодСистемыОтправителя));
	ДобавитьУзелXML(УзелСистемаОтправителя, "типСубъекта",				Истина, "оператор");
	
	// для новых необходимо выделение подразделения отдельным кодом
	КодыСубъектаПодразделения = РазделитьКодФСГС(КодПолучателя);
	
	// добавляем узел "Получатель"
	УзелПолучатель = ДобавитьУзелXML(УзелПакет, "получатель");
	ДобавитьУзелXML(УзелПолучатель, "идентификаторСубъекта",			Истина, КодыСубъектаПодразделения.идентификаторСубъекта);
	Если ЗначениеЗаполнено(КодыСубъектаПодразделения.идентификаторПодразделения) Тогда
		ДобавитьУзелXML(УзелПолучатель, "идентификаторПодразделения",			Истина, КодыСубъектаПодразделения.идентификаторПодразделения);
	КонецЕсли;
	ДобавитьУзелXML(УзелПолучатель, "типСубъекта",						Истина, "органФСГС");
	
	Если ЗначениеЗаполнено(МЧД) Тогда
		ДанныеДоверенности = ?(ТипЗнч(МЧД) = Тип("Структура") ИЛИ ТипЗнч(МЧД) = Тип("ФиксированнаяСтруктура"),
			МЧД, Неопределено);
		РегистрационныйНомерДоверенности = ?(ДанныеДоверенности = Неопределено,
			МЧД, ДанныеДоверенности.РегистрационныйНомерДоверенности);
		ИННДоверителя = ?(ДанныеДоверенности = Неопределено, "", ?(ЗначениеЗаполнено(ДанныеДоверенности.ДоверительЮЛ_ИНН),
			ДанныеДоверенности.ДоверительЮЛ_ИНН, ДанныеДоверенности.ДоверительФЛ_ИНН));
		ИННПредставителя = ?(ДанныеДоверенности = Неопределено, "", ?(ЗначениеЗаполнено(ДанныеДоверенности.ПредставительФЛ_ИНН),
			ДанныеДоверенности.ПредставительФЛ_ИНН, ДанныеДоверенности.ПредставительЮЛ_ИНН));
		РегистрационныйНомерРНД = ?(ДанныеДоверенности = Неопределено, "", ДанныеДоверенности.РегистрационныйНомерРНД);
		
		УзелРасширения = ДобавитьУзелXML(УзелПакет, "расширения");
		УзелДоверенность = ДобавитьУзелXML(УзелРасширения, "доверенность");
		ДобавитьУзелXML(УзелДоверенность, "идентификаторМЧД", Истина, РегистрационныйНомерДоверенности);
		Если ДанныеДоверенности <> Неопределено Тогда
			ДобавитьУзелXML(УзелДоверенность, "ИННдоверителя", Истина, ИННДоверителя);
			ДобавитьУзелXML(УзелДоверенность, "ИННпредставителя", Истина, ИННПредставителя);
			Если ЗначениеЗаполнено(РегистрационныйНомерРНД) Тогда
				ДобавитьУзелXML(УзелДоверенность, "идентификаторМЧДНотариус", Истина, РегистрационныйНомерРНД);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Создадим контекст ЭДО один раз до начала цикла обхода, чтобы не тратить время на каждом шаге.
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// добавляем узлы "Документ"
	Для Каждого СтрДокумент Из ОписаниеДокументов.Строки Цикл
		
		// добавляем очередной узел "Документ"
		УзелДокумент = ДобавитьУзелXML(УзелПакет, "документ");
		ДобавитьУзелXML(УзелДокумент, "типДокумента",					Истина, КонтекстЭДОСервер.ИдентификаторПоТипуДокументаПакета(СтрДокумент.ТипДокумента));
		ДобавитьУзелXML(УзелДокумент, "типСодержимого",					Истина, СтрДокумент.ТипСодержимого);
		ДобавитьУзелXML(УзелДокумент, "сжат",							Истина, XMLСтрока(СтрДокумент.Сжат = Истина));
		ДобавитьУзелXML(УзелДокумент, "зашифрован",						Истина, XMLСтрока(СтрДокумент.Зашифрован = Истина));
		ДобавитьУзелXML(УзелДокумент, "идентификаторДокумента",			Истина, СтрДокумент.ИдентификаторДокумента);
		
		// добавляем атрибут "ИсходноеИмяФайла"
		Если ЗначениеЗаполнено(СтрДокумент.ИмяФайлаДокумента) Тогда
			ДобавитьУзелXML(УзелДокумент, "исходноеИмяФайла",			Истина, СтрДокумент.ИмяФайлаДокумента);
		КонецЕсли;
			
		// добавляем узел "Содержимое"
		Если ЗначениеЗаполнено(СтрДокумент.ИмяФайлаАрхива) Тогда
			УзелСодержимое = ДобавитьУзелXML(УзелДокумент, "содержимое");
			ДобавитьУзелXML(УзелСодержимое, "имяФайла",					Истина, СтрДокумент.ИмяФайлаАрхива);
		КонецЕсли;
		
		// добавляем подписи под документом
		Для Каждого СтрПодпись Из СтрДокумент.Строки Цикл
			
			// добавляем очередной узел "Подпись"
			УзелПодпись = ДобавитьУзелXML(УзелДокумент, "подпись");
			ДобавитьУзелXML(УзелПодпись, "имяФайла",					Истина, СтрПодпись.ИмяФайлаДокумента);
			ДобавитьУзелXML(УзелПодпись, "роль",						Истина, "респондент");
			
		КонецЦикла;
		
	КонецЦикла;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево);
	
	// записываем дерево в файл
	ПолноеИмяФайла = ПолучитьИмяВременногоФайла();
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайла);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// записываем двоичные данные файла во временное хранилище
	АдресВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), ИдентификаторДляВременногоХранилища);
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаСервереБезКонтекста
Функция КодОрганаФСГССоответствуетТребованиям(КодОрганаФСГС) Экспорт
	
	ЧистыйКодОрганаФСГС = СокрЛП(КодОрганаФСГС);
	КодНСИ = Лев(ЧистыйКодОрганаФСГС, 3);
	Возврат (СтрДлина(ЧистыйКодОрганаФСГС) >= 4) И (СтрокаСоответствуетШаблону(КодНСИ, "№№-"));
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьОписаниеПисьмаДляСообщенияФСГС(Контекст)
	
	Сообщение = Контекст.ТранспортноеСообщение;
	
	ТипыВложений = Новый Массив;
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоФСГС);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПриложениеПисьмаФСГС);
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьмаФСГС);
	Вложения = ПолучитьВложенияТранспортногоСообщения(Сообщение, , ТипыВложений);
	
	// проверяем, не сформировано ли ранее описание письма
	Если Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьмаФСГС, "Тип") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	// получаем строки вложений ЭЦП с данными
	ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	ВложенияЭЦП = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	
	// добавляем строки описания ЭЦП к ранее полученным строкам описаний
	Вложения.Колонки.Добавить("Данные");
	Для Каждого СтрВложениеЭЦП Из ВложенияЭЦП Цикл
		НовСтр = Вложения.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрВложениеЭЦП);
	КонецЦикла;
	
	// генерируем файл
	КороткоеИмяФайла = Неопределено;
	ФайлОписаниеПисьма = СформироватьОписаниеПисьмаФСГС(Сообщение, Вложения, КороткоеИмяФайла);
	Если ФайлОписаниеПисьма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл в содержимое
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
		Сообщение,
		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьмаФСГС,
		ФайлОписаниеПисьма,
		КороткоеИмяФайла,,,,,,,
		СгенерироватьUUID(),
		Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьОписаниеПисьмаФСГС(Сообщение, Вложения, КороткоеИмяФайла = Неопределено)
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	// добавляем узел "тема"
	УзелТема = ДобавитьУзелXML(Дерево, "тема", , XMLСтрока(СокрЛП(Сообщение.ЦиклОбмена.Предмет.Наименование)));
	
	// добавляем узел "ответНа"
	ИдентификаторОснования = Сообщение.ЦиклОбмена.Предмет.ИдентификаторОснования;
	Если ЗначениеЗаполнено(ИдентификаторОснования) Тогда
		УзелОтветНаПисьмо = ДобавитьУзелXML(Дерево, "ответНа", , XMLСтрока(ИдентификаторОснования));
	КонецЕсли;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описание");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьИзвещениеОПолученииФСГС(ТранспортноеСообщение)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьИзвещениеОПолученииФСГС(ТранспортноеСообщение);
	
КонецФункции
 
&НаСервереБезКонтекста
Функция КодОКПОСоответствуетТребованиям(КодОКПО)
	
	ВремКодОКПО = СокрЛП(КодОКПО);
	Если СтрДлина(ВремКодОКПО) = 14 Тогда
		Если НЕ СтрокаСоответствуетШаблону(ВремКодОКПО, "№№№№№№№№№№№№№№") Тогда 
			Возврат Ложь;
		КонецЕсли;
		ВремКодОКПО = Лев(ВремКодОКПО, 8);
	КонецЕсли;
	СтрКодОКПО = Прав("00000" + ВремКодОКПО, ?(СтрДлина(ВремКодОКПО) <= 8, 8, 10));
	
	Если НЕ СтрокаСоответствуетШаблону(СтрКодОКПО, "№№№№№№№№") И НЕ СтрокаСоответствуетШаблону(СтрКодОКПО, "№№№№№№№№№№") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтрольнаяЦифра = Число(Прав(СтрКодОКПО, 1));
	ДлинаКодаРасчет = СтрДлина(СтрКодОКПО) - 1;
	СтрКодОКПОРасчет = Лев(СтрКодОКПО, ДлинаКодаРасчет);
	
	СдвигВесов = 0; КонтрольноеЧисло = 0;
	Для НомРасч = 1 По 2 Цикл
		СуммаПроизведений = 0;
		Для НомПоз = 1 По ДлинаКодаРасчет Цикл
			ВесРазряда = (НомПоз + СдвигВесов) % 10;
			Если ВесРазряда = 0 Тогда
				ВесРазряда = 10;
			КонецЕсли;
			ЦифраКодаОКПО = Число(Сред(СтрКодОКПОРасчет, НомПоз, 1));
			СуммаПроизведений = СуммаПроизведений + ЦифраКодаОКПО * ВесРазряда;
		КонецЦикла; 
		КонтрольноеЧисло = СуммаПроизведений % 11;
		Если КонтрольноеЧисло = 10 Тогда
			Если НомРасч = 1 Тогда
				СдвигВесов = 2;
				Продолжить;
			Иначе
				КонтрольноеЧисло = 0;
			КонецЕсли;	
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Возврат Истина; //проверка отключена (КонтрольнаяЦифра = КонтрольноеЧисло);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьОрганФСГСОрганизации(Организация) Экспорт
	
	КодОрганаФСГС = СокрЛП(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "КодОрганаФСГС").КодОрганаФСГС);
	Если НЕ ЗначениеЗаполнено(КодОрганаФСГС) Тогда
		Возврат Неопределено;
	Иначе
		Возврат Справочники.ОрганыФСГС.НайтиПоКоду(КодОрганаФСГС);
	КонецЕсли;
	
КонецФункции

#Область ОтправкаРегламентированногоОтчетаВФСГС

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГС(Док, ВыполняемоеОповещение) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("Док",                   Док);
	Контекст.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФСГСПослеПодтвержденияПовторнойОтправки",
		ЭтотОбъект,
		Контекст);
	
	ПодтвердитьПовторнуюОтправку(Док, "ФСГС", ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГСПослеПодтвержденияПовторнойОтправки(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	// готовимся к выгрузке
	Если НЕ ОтправкаРегламентированногоОтчетаВФСГС_ПередВыгрузкойФайла(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Ложь); //+
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Ложь); //+
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	// выгружаем отчет и доверенность, при необходимости
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФСГСПослеВыгрузки",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ВыгрузитьРегламентированныйОтчетФСГС(КонтекстОтправки, ОписаниеОповещения)// клиент
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГСПослеВыгрузки(Результат, ВходящийКонтекст) Экспорт
	
	Документ = ВходящийКонтекст.КонтекстОтправки.Документ;
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();

	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	РезультатВыгрузки     = Результат.РезультатВыгрузки;
	КонтекстОтправки      = Результат.Контекст;
	
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Если НЕ РезультатВыгрузки Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаРегламентированногоОтчетаВФСГСПослеАвтонастройкиУчетнойЗаписи", 
		ЭтотОбъект, 
		ВходящийКонтекст);

	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("Документ", 			Документ);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Документ;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 6;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда //отправка отчета в Росстат
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВФСГСПослеВыгрузки",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВФСГСПослеВыгрузки() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Документ = КонтекстДлительнойОперации.Документ;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи..."); // ФСГС

	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Документ, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФСГС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.КонтекстОтправки.Документ, ВходящийКонтекст.КонтекстОтправки.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	КонтекстОтправки      = ВходящийКонтекст.КонтекстОтправки;
	
	// отражаем изменения в базе
	Если НЕ ОтправкаРегламентированногоОтчетаВФСГС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 	ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВФСГСПослеФормированияПакета", ЭтотОбъект, Контекст);
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФСГС");

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетФСГС(Контекст, ВыполняемоеОповещение)
	
	Результат = Новый Массив;
	
	Отчет = Контекст.Документ;
	ИмяМетаданныхДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ИмяМетаданныхДокумента = "РегламентированныйОтчет" Тогда
		
		// выгружаем отчет
		ТекстВыгрузки = "";
		ИмяФайлаВыгрузки = "";
		КодировкаФайлаВыгрузки = Неопределено;
		РезультатВыгрузки = СдачаОтчетностиЧерезСервисСпецоператораКлиент.ВыгрузитьРегламентированныйОтчет(Отчет, Ложь, ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайлаВыгрузки, , , Контекст.УникальныйИдентификатор);
		Если НЕ РезультатВыгрузки Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1Отправка отчета прервана.';
					|en = '%1Отправка отчета прервана.'"), ИнформацияОбОшибке().Описание + Символы.ПС);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			
			РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
			Возврат;
		КонецЕсли;
		
		// формируем имя файла выгрузки
		ОбъектФайл = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаВыгрузки);
		Если Нрег(ОбъектФайл.Расширение) = ".xml" И (СтрНайти(ОбъектФайл.Имя, "NO_BUH") = 0 ИЛИ СтрНайти(ОбъектФайл.Имя, "NO_BOUPR") = 0 ИЛИ СтрНайти(ОбъектФайл.Имя, "NO_BOUCH") = 0) Тогда
			ИмяФайлаВыгрузки = ОбъектФайл.ИмяБезРасширения + "_" + СгенерироватьUUID() + ОбъектФайл.Расширение;
		Иначе
			ИмяФайлаВыгрузки = ОбъектФайл.Имя;
		КонецЕсли; 
		

		// пишем файл во временное хранилище
		КодировкаФайла = "utf-8";
		Если КодировкаФайлаВыгрузки <> Неопределено Тогда
			КодировкаФайла = КодировкаФайлаВыгрузки;
		КонецЕсли;
		АдресВоВременномХранилище = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла, Контекст.УникальныйИдентификатор);
		
		// заполняем результат
		ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес", Отчет, Неопределено, ИмяФайлаВыгрузки, АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
		
	Иначе
		
		// выгружаем
		ТекстВыгрузки = "";
		ИмяФайлаВыгрузки = "";
		КодировкаФайла = "utf-8";
		Если НЕ ИзвлечьЭлектронноеПредставлениеФСГСИзХранилища(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла) Тогда
			РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
			Возврат;
		КонецЕсли;
	
		// пишем файл во временное хранилище		
		АдресВоВременномХранилище = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла, Контекст.УникальныйИдентификатор);
		
		// заполняем результат
		ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес", Отчет, Неопределено, ИмяФайлаВыгрузки, АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
		
	КонецЕсли;
	
	Контекст.Вставить("РезультатВыгрузки", Результат);
	РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВФСГСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт 

	Документ = ВходящийКонтекст.КонтекстОтправки.Документ;
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС

		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(ВходящийКонтекст.КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСГС.
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОрганФСГСПоРеглОтчету(ДокОснование)
	
	Если ТипЗнч(ДокОснование) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		ОрганФСГС = ДокОснование.Получатель;
		
	Иначе
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснование, "Организация");
		ОрганФСГС   = ОпределитьОрганФСГСОрганизации(Организация);
		ИспользуетсяМеханизмНесколькихНаправлений = Ложь;
		Попытка
			РегламентированнаяОтчетностьПереопределяемый.ИспользуетсяОтправкаВРосстатПоРазнымНаправлениям(ИспользуетсяМеханизмНесколькихНаправлений);
			Если ИспользуетсяМеханизмНесколькихНаправлений Тогда 
				КодФСГС = РегламентированнаяОтчетность.ПолучитьКодОрганаФСГССтатотчета(ДокОснование);
				Если ЗначениеЗаполнено(КодФСГС) Тогда
					ОрганФСГС = Справочники.ОрганыФСГС.НайтиПоКоду(КодФСГС);
				КонецЕсли;
			КонецЕсли;
		Исключение
			КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
			ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Определение кода органа ФСГС';
					|en = 'Электронный документооборот с контролирующими органами. Определение кода органа ФСГС'", КодОсновногоЯзыка),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ИнформацияОбОшибке);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ОрганФСГС;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВФСГС_ПередВыгрузкойФайла(Контекст)
	
	Если ТипЗнч(Контекст.Документ) = Тип("Массив") Тогда
		ОсновнойДок = Контекст.Документ[0];
	Иначе
		ОсновнойДок = Контекст.Документ;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОсновнойДок) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки.';
								|en = 'Не выбран документ для отправки.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнойДок, "Организация");
	Если Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с Росстатом
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФСГС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	ТипЗнчДок = ТипЗнч(ОсновнойДок);
	МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчДок);
	Если МетаданныеОтчета = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Неизвестный тип отчета.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ИмяМетаданныхОтчета = МетаданныеОтчета.Имя;
	Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойДок, "ДатаНачала, ДатаОкончания, ИсточникОтчета");
		ДатаНачалаПериодаОтчета = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ЗначенияРеквизитов.ДатаОкончания;
		ВидРегламентированногоОтчетаСтр = ЗначенияРеквизитов.ИсточникОтчета;
	Иначе //электронное представление
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойДок, "ДатаНачала, ДатаОкончания, ВидОтчета");
		ДатаНачалаПериодаОтчета = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ЗначенияРеквизитов.ДатаОкончания;
		Если ТипЗнч(ЗначенияРеквизитов.ВидОтчета) = Тип("СправочникСсылка.РегламентированныеОтчеты") Тогда
			ВидРегламентированногоОтчетаСтр = ЗначенияРеквизитов.ВидОтчета.ИсточникОтчета;
		Иначе
			ВидРегламентированногоОтчетаСтр = ЗначенияРеквизитов.ВидОтчета.Источник;
		КонецЕсли;
	КонецЕсли;
	
	ОрганФСГС = ПолучитьОрганФСГСПоРеглОтчету(ОсновнойДок);
	Если ОрганФСГС = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'В свойствах организации не задан код территориального органа ФСГС.';
								|en = 'В свойствах организации не задан код территориального органа ФСГС.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(ОрганФСГС) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти в справочнике ""Органы ФСГС"" получателя отчетности.';
								|en = 'Не удалось найти в справочнике ""Органы ФСГС"" получателя отчетности.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС;
	ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС;
	ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС;
	
	Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
		ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", ВидРегламентированногоОтчетаСтр);
		Если ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка()
			И СтрНачинаетсяС(ВидРегламентированногоОтчетаСтр, "EF_") Тогда
			ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ОтчетФСГСДляВыпускаПатчей;
		КонецЕсли;
		Если ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден отчет вида %1!';
				|en = 'В справочнике ""Виды отправляемых документов"" не найден отчет вида %1!'"), ВидРегламентированногоОтчетаСтр);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ВидОтправляемогоОтчета = ЗначенияРеквизитов.ВидОтчета;
	КонецЕсли;
	
	Контекст.Вставить("Организация",                  Организация);
	Контекст.Вставить("ДатаНачалаПериодаОтчета",      ДатаНачалаПериодаОтчета);
	Контекст.Вставить("ДатаОкончанияПериодаОтчета",   ДатаОкончанияПериодаОтчета);
	Контекст.Вставить("ТипОтправляемогоДокумента",    ИмяМетаданныхОтчета);
	Контекст.Вставить("ТипЦиклаОбмена",               ТипЦиклаОбмена);
	Контекст.Вставить("ТипТранспортногоСообщения",    ТипТранспортногоСообщения);
	Контекст.Вставить("ТипСодержимогоКонтейнера",     ТипСодержимогоКонтейнера);
	Контекст.Вставить("УчетнаяЗапись",                УчетнаяЗапись);
	Контекст.Вставить("ОрганФСГС",                    ОрганФСГС);
	Контекст.Вставить("ВидРегламентированногоОтчета", ВидОтправляемогоОтчета);
	Контекст.Вставить("ИсточникОтчета",               ВидРегламентированногоОтчетаСтр);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВФСГС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Отчет = Контекст.Документ;
	Организация = Контекст.Организация;
	ТипЦиклаОбмена = Контекст.ТипЦиклаОбмена;
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ОрганФСГС = Контекст.ОрганФСГС;
	ТипТранспортногоСообщения = Контекст.ТипТранспортногоСообщения;
	ВидРегламентированногоОтчета = Контекст.ВидРегламентированногоОтчета;
	РезультатВыгрузкиОтчетности = Контекст.РезультатВыгрузки;
	
	// формируем массив предметов
	МассивПредметов = Новый Массив;
	Для Инд = 0 По РезультатВыгрузкиОтчетности.Количество() - 1 Цикл
		МассивПредметов.Добавить(РезультатВыгрузкиОтчетности[Инд].Документ);
	КонецЦикла;
	Если МассивПредметов.Найти(Отчет) = Неопределено Тогда
		МассивПредметов.Вставить(0, Отчет);
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФСГС;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.ВидОтчета = ВидРегламентированногоОтчета;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
	ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	ЦиклОбмена.ВнешняяОрганизация = ОрганФСГС;
	ЦиклОбмена.Тип = ТипЦиклаОбмена;
	
	ЦиклОбмена.Предмет = МассивПредметов[0];
	Для Инд = 1 По МассивПредметов.Количество() - 1 Цикл
		НовСтр = ЦиклОбмена.ДополнительныеПредметы.Добавить();
		НовСтр.Предмет = МассивПредметов[Инд];
	КонецЦикла;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = ТипТранспортногоСообщения;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = ОрганФСГС;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Отправка прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
		
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Отправка прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем ДИВы
	Для Каждого СтрРезультатВыгрузкиОтчетности Из РезультатВыгрузкиОтчетности Цикл
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка,
														Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС,
														СтрРезультатВыгрузкиОтчетности.Адрес,
														СтрРезультатВыгрузкиОтчетности.Имя,
														,
														,
														,
														,
														,
														СтрРезультатВыгрузкиОтчетности.Тип,
														СгенерироватьUUID(),
														Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
									|en = 'Отправка отчета прервана.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// пишем цикл обмена только (!) после записи ДИВ, потому что при записи цикла
	// используется информация из связанных ДИВ
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Отправка отчета прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеПодтвержденияДатыОтправкиФСГС(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	// пытаемся разобрать уведомление
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияДатыОтправкиФСГС(ЦиклОбмена, Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		
		Макет = ПолучитьМакетОбработки("ФСГСПодтверждениеДатыОтправки");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ФСГСПодтверждение");
		ОбластьМакета.Параметры.ДатаВремяОтправления = СвойстваИзПодтверждения.ДатаВремяОтправки;
		ОбластьМакета.Параметры.ИмяФайла = СвойстваИзПодтверждения.ИменаФайлов;
		ОбластьМакета.Параметры.СпецОператорСвязи = СвойстваИзПодтверждения.ПодтвердившаяОрганизация;
		ОбластьМакета.Параметры.НаименованиеОтправителя = СвойстваИзПодтверждения.НазваниеОтправителя;
		ОбластьМакета.Параметры.ТипОтправителя = СвойстваИзПодтверждения.ТипОтправителя;
		ОбластьМакета.Параметры.КодОтправителя = СвойстваИзПодтверждения.ОКПООтправителя;
		ОбластьМакета.Параметры.НаименованиеПолучателя = СвойстваИзПодтверждения.НазваниеПолучателя;
		ОбластьМакета.Параметры.ТипПолучателя = СвойстваИзПодтверждения.ТипПолучателя;
		ОбластьМакета.Параметры.КодПолучателя = СвойстваИзПодтверждения.КодПолучателя;
		
		ТабДокумент.Вывести(ОбластьМакета); // ФСГСПодтверждение
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция ВывестиОтчетОСостоянииФСГС(ЦиклОбмена)
	
	ТипЦиклаОбмена = ЦиклОбмена.Тип;
	
	СоответствиеТипаСообщенияКраткомуПредставлению = ИнициализироватьСоответствиеТСКП();
	
	ПредусмотренныеТипыСообщений = Новый ТаблицаЗначений;
	ПредусмотренныеТипыСообщений.Колонки.Добавить("ТипСообщения");
	ПредусмотренныеТипыСообщений.Колонки.Добавить("ТипЦиклаОбмена");
	
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС, Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС);
	
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС, Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС, Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС, Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоИсходящееФСГС, Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС);
	
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС, Перечисления.ТипыЦикловОбмена.ИндивидуальноеИнформированиеФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС, Перечисления.ТипыЦикловОбмена.ИндивидуальноеИнформированиеФСГС);
	
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.РассылкаФСГС, Перечисления.ТипыЦикловОбмена.РассылкаФСГС);
	ДобавитьСтрокуВТаблицуТиповСообщений(ПредусмотренныеТипыСообщений, Перечисления.ТипыТранспортныхСообщений.РассылкаШаблоновФСГС, Перечисления.ТипыЦикловОбмена.РассылкаШаблоновФСГС);
	
	// получаем шаблон бланка
	ШаблонМакета = ПолучитьМакетОбработки("БланкПечатиОтчетаОСостоянииФСГС");
	
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	ТаблДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ЗаполнитьЗначенияСвойств(ТаблДок.НижнийКолонтитул, ШаблонМакета.НижнийКолонтитул);
	ЗаполнитьЗначенияСвойств(ТаблДок.ВерхнийКолонтитул, ШаблонМакета.ВерхнийКолонтитул);
	// устанавливать колонтитулы
	
	// получаем области-строки
	ОблШапка = ШаблонМакета.ПолучитьОбласть("Шапка");
	ОблСтрока = ШаблонМакета.ПолучитьОбласть("Строка");
	ОблПодвалСообщения = ШаблонМакета.ПолучитьОбласть("ПодвалСообщения");
	ОблШапкаКритическиеОшибки = ШаблонМакета.ПолучитьОбласть("ШапкаУведомленияОбОшибках");
	ОблСтрокаКритическаяОшибка = ШаблонМакета.ПолучитьОбласть("СтрокаУведомлениеОбОшибке");
	ОблКритическиеОшибкиОтсутствуют = ШаблонМакета.ПолучитьОбласть("УведомленияОбОшибкахОтсутствуют");
	ОблПодвал = ШаблонМакета.ПолучитьОбласть("Подвал");
	
	// инициализируем значения шапки
	ОблШапка.Области.Идентификатор.Текст = ЦиклОбмена.Идентификатор;
	ОблШапка.Области.Организация.Текст = ЦиклОбмена.Организация;
	ОблШапка.Области.ВнешняяОрганизация.Текст = ЦиклОбмена.ВнешняяОрганизация;
	
	// формируем строку с предметом
	СтрПредмет = "";
	ПредметыПереписки = ПолучитьПредметыЦиклаОбмена(ЦиклОбмена);
	Для Каждого ПредметПереписки Из ПредметыПереписки Цикл
		Если ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС Тогда
			Если ЗначениеЗаполнено(ПредметПереписки) Тогда
				СтрПредмет = СтрПредмет + Символы.ПС + ПредставлениеОтчетаФСГС(ПредметПереписки);
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ПредметПереписки) Тогда
				СтрПредмет = СтрПредмет + Символы.ПС + ПредставлениеПредметаФСГС(ПредметПереписки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если СтрПредмет = "" Тогда
		СтрПредмет = "<Отсутствует>";
	Иначе
		СтрПредмет = СокрЛП(СтрПредмет);
	КонецЕсли;
	
	// присваиваем текстовое представление предмета
	ОблШапка.Области.ПредметПереписки.Текст = СтрПредмет;
	
	ОблШапка.Области.Создан.Текст = Формат(ЦиклОбмена.ДатаСоздания, "ДЛФ=DDT");
	ОблШапка.Области.Завершен.Текст = ?(НЕ ЗначениеЗаполнено(ЦиклОбмена.ДатаЗакрытия) ИЛИ ЦиклОбмена.ДатаЗакрытия = ПолучитьПустуюДатуЗавершенияЦиклаОбмена(), "<не завершен>", Формат(ЦиклОбмена.ДатаЗакрытия, "ДЛФ=DDT"));
	ОблШапка.Области.ПоследнееСообщение.Текст = Формат(ЦиклОбмена.ДатаПоследнегоСообщения, "ДЛФ=DDT");
	
	ТаблДок.Вывести(ОблШапка);
	
	// выбираем информацию по сообщениям цикла обмена
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	ТранспортныеСообщения.Тип КАК Тип,
						  |	ТранспортныеСообщения.ДатаТранспорта,
						  |	ТранспортныеСообщения.Статус КАК СтатусСообщения,
						  |	ТранспортныеСообщения.ПометкаУдаления,
						  |	ТранспортныеСообщения.ПротоколСОшибкой КАК ПротоколСОшибкой,
						  |	ТранспортныеСообщения.Ссылка КАК Ссылка,
						  |	ТранспортныеСообщения.Тема КАК Тема,
						  |	НерасшифрованныеВложения.КоличествоСообщений КАК КоличествоНерасшифрованных,
						  |	РасшифрованныеВложения.КоличествоСообщений КАК КоличествоРасшифрованных,
						  |	ТранспортныеСообщения.Дата КАК Дата
						  |ИЗ
						  |	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
						  |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |			ТранспортныеКонтейнеры.ТранспортноеСообщение КАК ТранспортноеСообщение,
						  |			КОЛИЧЕСТВО(ИСТИНА) КАК КоличествоСообщений
						  |		ИЗ
						  |			РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
						  |		ГДЕ
						  |			ТранспортныеКонтейнеры.ТранспортноеСообщение.ЦиклОбмена = &ЦиклОбмена
						  |		
						  |		СГРУППИРОВАТЬ ПО
						  |			ТранспортныеКонтейнеры.ТранспортноеСообщение) КАК НерасшифрованныеВложения
						  |		ПО ТранспортныеСообщения.Ссылка = НерасшифрованныеВложения.ТранспортноеСообщение
						  |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |			СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение КАК ТранспортноеСообщение,
						  |			КОЛИЧЕСТВО(ИСТИНА) КАК КоличествоСообщений
						  |		ИЗ
						  |			РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
						  |		ГДЕ
						  |			СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.ЦиклОбмена В(&ЦиклОбмена)
						  |		
						  |		СГРУППИРОВАТЬ ПО
						  |			СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение) КАК РасшифрованныеВложения
						  |		ПО ТранспортныеСообщения.Ссылка = РасшифрованныеВложения.ТранспортноеСообщение
						  |ГДЕ
						  |	ТранспортныеСообщения.ЦиклОбмена = &ЦиклОбмена
						  |
						  |УПОРЯДОЧИТЬ ПО
						  |	ТранспортныеСообщения.ЦиклОбмена,
						  |	ТранспортныеСообщения.Тип.Порядок,
						  |	Дата");
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклОбмена);
	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	
	ПоследнийТипСообщения = Неопределено;
	
	Для ИндТипСообщения = 1 По ПредусмотренныеТипыСообщений.Количество() Цикл
		
		ТекСтр = ПредусмотренныеТипыСообщений[ИндТипСообщения - 1];
		Если ТекСтр.ТипЦиклаОбмена <> ТипЦиклаОбмена Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТипСообщения = ТекСтр.ТипСообщения;
		СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", ТекТипСообщения));
		
		Если СообщенияТекТипа.Количество() = 0 Тогда
			
			ОблСтрока.Области.ТипСообщения.Текст = СоответствиеТипаСообщенияКраткомуПредставлению[ТекТипСообщения];
			ОблСтрока.Области.СтатусСообщения.Текст = "Отсутствует";
			ОблСтрока.Области.СтатусСообщения.Шрифт = Новый Шрифт(ОблСтрока.Области.СтатусСообщения.Шрифт, , , , , , Ложь);
			
			ТаблДок.Вывести(ОблСтрока);
			
		Иначе
			
			Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
				
				ТипСообщения = СтрСообщение.Тип;
				ДатаТранспортаСообщения = СтрСообщение.ДатаТранспорта;
				СтатусСтрСообщения = СтрСообщение.СтатусСообщения;
				ПометкаУдаленияСообщения = СтрСообщение.ПометкаУдаления;
				ЭтоПротоколСОшибкой = СтрСообщение.ПротоколСОшибкой;
				Сообщение = СтрСообщение.Ссылка;
				ЧислоКонтейнеровСообщения = СтрСообщение.КоличествоНерасшифрованных;
				ЧислоЭлементовСодержимого = СтрСообщение.КоличествоРасшифрованных;
				ДатаСообщения = СтрСообщение.Дата;
				
				ПредставлениеТипа = СоответствиеТипаСообщенияКраткомуПредставлению[ТипСообщения];
				Если ПредставлениеТипа = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				// заполняем ТипСообщения
				Если ПоследнийТипСообщения <> ТипСообщения Тогда
					ОблСтрока.Области.ТипСообщения.Текст = ПредставлениеТипа;
				Иначе
					ОблСтрока.Области.ТипСообщения.Текст = "";
				КонецЕсли;
				ПоследнийТипСообщения = ТипСообщения;
				
				// заполняем строку статуса
				Если СтатусСтрСообщения = Перечисления.СтатусыПисем.Полученное Тогда
					ТекстСтатуса = "От " + Формат(ДатаСообщения, "ДЛФ=DDT") + ". Принято " + Формат(ДатаТранспортаСообщения, "ДЛФ=DDT") + ".";
					Если ЧислоЭлементовСодержимого = 0 Тогда
						ТекстСтатуса = ТекстСтатуса + " Не расшифровано.";
					КонецЕсли;
				ИначеЕсли СтатусСтрСообщения = Перечисления.СтатусыПисем.Исходящее Тогда
					ТекстСтатуса = "Создано " + Формат(ДатаСообщения, "ДЛФ=DDT") + ". Не отправлено.";
				ИначеЕсли СтатусСтрСообщения = Перечисления.СтатусыПисем.Отправленное Тогда
					ТекстСтатуса = "Создано " + Формат(ДатаСообщения, "ДЛФ=DDT") + ". Отправлено " + Формат(ДатаТранспортаСообщения, "ДЛФ=DDT") + ".";
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ЭтоПротоколСОшибкой Тогда
					ТекстСтатуса = ТекстСтатуса + Символы.ПС + "Содержит сведения об ошибках!";
				КонецЕсли;
				
				ОблСтрока.Области.СтатусСообщения.Текст = ТекстСтатуса;
				ОблСтрока.Области.СтатусСообщения.Шрифт = Новый Шрифт(ОблСтрока.Области.СтатусСообщения.Шрифт, , , , , , ПометкаУдаленияСообщения);
				
				ТаблДок.Вывести(ОблСтрока);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблДок.Вывести(ОблПодвалСообщения);
	
	// вывод информации об ошибках
	ТипыОшибок = Новый Массив;
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС);
	ТипыОшибок.Добавить(Перечисления.ТипыТранспортныхСообщений.КритическаяОшибка);
	Для Каждого ТипОшибки Из ТипыОшибок Цикл
		СообщенияОшибки = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", ТипОшибки));
		Если СообщенияОшибки.Количество() > 0 Тогда
			ТаблДок.Вывести(ОблШапкаКритическиеОшибки);
			Для Каждого СообщениеОшибка Из СообщенияОшибки Цикл
				ОблСтрокаКритическаяОшибка.Области.УведомлениеОбОшибке.Текст = СокрЛП(СообщениеОшибка.Тема);
				ОблСтрокаКритическаяОшибка.Области.УведомлениеОбОшибкеДата.Текст = Формат(СообщениеОшибка.ДатаТранспорта, "ДЛФ=DDT");
				ТаблДок.Вывести(ОблСтрокаКритическаяОшибка);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ТаблДок.Вывести(ОблПодвал);
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеПредметаФСГС(Предмет)
	
	Если Предмет.Статус = Перечисления.СтатусыПисем.Полученное Тогда
		Возврат "Входящее письмо от Росстата""" + СокрЛП(Предмет.Наименование) + """ от " + Формат(Предмет.ДатаОтправки, "ДЛФ=DDT");
	Иначе
		Возврат "Исходящее письмо респондента""" + СокрЛП(Предмет.Наименование) + """ от " + Формат(Предмет.ДатаСообщения, "ДЛФ=DDT");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеОтчетаФСГС(ОтчетФСГС)
	
	Если ТипЗнч(ОтчетФСГС) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		Возврат РегламентированнаяОтчетностьКлиентСервер.ПредставлениеДокументаРеглОтч(ОтчетФСГС);
	Иначе
		Возврат "" + ОтчетФСГС;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОсновныеСвойстваИзПодтвержденияДатыОтправкиФСГС(ЦиклОбмена, СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// считываем подтверждение из файла в дерево XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(, СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка чтения XML подтверждения даты отправки:%1';
																						|en = 'Ошибка чтения XML подтверждения даты отправки:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелПодтверждениеОператора = ДеревоXML.Строки.Найти("подтверждениеОператора", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелПодтверждениеОператора) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""ПодтверждениеОператора"".';
								|en = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""ПодтверждениеОператора"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелПосылка = УзелПодтверждениеОператора.Строки.Найти("посылка", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелПосылка) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Посылка"".';
								|en = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Посылка"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелОтправитель = УзелПосылка.Строки.Найти("отправитель", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелОтправитель) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Отправитель"".';
								|en = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Отправитель"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокументы = УзелПосылка.Строки.Найти("документы", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокументы) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Документы"".';
								|en = 'Некорректная структура XML подтверждения даты отправки: не обнаружен узел ""Документы"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// получаем сведения о дате и времени поступившего файла
	УзелДатаВремяОтправки = УзелПодтверждениеОператора.Строки.Найти("датаВремяОтправки", "Имя");
	Если ЗначениеЗаполнено(УзелДатаВремяОтправки) Тогда
		ДатаВремяОтправки = СокрЛП(XMLЗначение(Тип("Дата"), УзелДатаВремяОтправки.Значение));
		ДатаОтправки = СокрЛП(ДатаВремяОтправки);
	КонецЕсли;
	
	//ищем данные отправителя
	УзелПосылка = УзелПодтверждениеОператора.Строки.Найти("посылка", "Имя");
	УзелОтправитель = УзелПосылка.Строки.Найти("отправитель", "Имя");
	
	// сведения о подтвердившей организации
	УзелИдентификаторОтправителя = УзелОтправитель.Строки.Найти("идентификатор", "Имя");
	Если ЗначениеЗаполнено(УзелИдентификаторОтправителя) Тогда
		ИдентификаторОтправителя = СокрЛП(УзелИдентификаторОтправителя.Значение);
	Иначе
		ИдентификаторОтправителя = "";
	КонецЕсли;
	ИдентификаторСпецоператора = Лев(ИдентификаторОтправителя, СтрНайти(ИдентификаторОтправителя, ".") - 1);
	ОрганизацияСтр = "Оператор электронного документооборота" + ?(ПустаяСтрока(ИдентификаторСпецоператора), "", " (" + ИдентификаторСпецоператора + ")");
	
	УзелТипОтправителя = УзелОтправитель.Строки.Найти("тип", "Имя");
	Если ЗначениеЗаполнено(УзелТипОтправителя) Тогда
		ТипОтправителя = СокрЛП(УзелТипОтправителя.Значение);
	КонецЕсли;
	
	УзелНазваниеОтправителя = УзелОтправитель.Строки.Найти("название", "Имя");
	Если ЗначениеЗаполнено(УзелНазваниеОтправителя) Тогда
		НазваниеОтправителя = СокрЛП(УзелНазваниеОтправителя.Значение);
	КонецЕсли;
	
	УзелОКПООтправителя = УзелОтправитель.Строки.Найти("натуральныйИдентификатор", "Имя");
	Если ЗначениеЗаполнено(УзелОКПООтправителя) Тогда
		ОКПООтправителя = СокрЛП(УзелОКПООтправителя.Значение);
	КонецЕсли;
	
	//данные получателя
	УзелПолучатель = УзелПосылка.Строки.Найти("получатель", "Имя");
	
	УзелТипПолучателя = УзелПолучатель.Строки.Найти("тип", "Имя");
	Если ЗначениеЗаполнено(УзелТипПолучателя) Тогда
		ТипПолучателя = СокрЛП(УзелТипПолучателя.Значение);
	КонецЕсли;
	
	УзелНазваниеПолучателя = УзелПолучатель.Строки.Найти("название", "Имя");
	Если ЗначениеЗаполнено(УзелНазваниеПолучателя) Тогда
		НазваниеПолучателя = СокрЛП(УзелНазваниеПолучателя.Значение);
	КонецЕсли;
	
	УзелКодПолучателя = УзелПолучатель.Строки.Найти("натуральныйИдентификатор", "Имя");
	Если ЗначениеЗаполнено(УзелКодПолучателя) Тогда
		КодПолучателя = СокрЛП(УзелКодПолучателя.Значение);
	КонецЕсли;
	
	// извлекаем имена поступивших файлов
	ИмяПоступившегоФайла = "";
	УзелИмяФайла = УзелПосылка.Строки.Найти("исходноеИмяФайла", "Имя");
	Если ЗначениеЗаполнено(УзелИмяФайла) Тогда
		ИмяПоступившегоФайла = СокрЛП(УзелИмяФайла.Значение);
	КонецЕсли;
	
	Возврат Новый Структура("ПодтвердившаяОрганизация, ДатаВремяОтправки, ИменаФайлов, ТипОтправителя, НазваниеОтправителя, ОКПООтправителя, ТипПолучателя, НазваниеПолучателя, КодПолучателя", ОрганизацияСтр, ДатаОтправки, ИмяПоступившегоФайла, ТипОтправителя, НазваниеОтправителя, ОКПООтправителя, ТипПолучателя, НазваниеПолучателя, КодПолучателя);
	
КонецФункции

#Область ОтправкаНеформализованногоДокументаВФСГС

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГС(Док, Организация, ВыполняемоеОповещение, ОтобразитьРезультат = Истина) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", 						Док);
	КонтекстДлительнойОперации.Вставить("Организация", 				Организация);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	КонтекстДлительнойОперации.Вставить("ОтобразитьРезультат", 		ОтобразитьРезультат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФСГС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	Док = ВходящийКонтекст.Док;

	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка письма в ФСГС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаНеформализованногоДокументаВФСГС",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаНеформализованногоДокументаВФСГС() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();


	
	Док = КонтекстДлительнойОперации.Док;
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(КонтекстДлительнойОперации);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФСГСПослеАвтонастройкиУчетнойЗаписи", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	Параметры_ОтобразитьРезультат	= ВходящийКонтекст.ОтобразитьРезультат;
	
	ОтправкаНеформализованногоДокументаВФСГС(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение, Параметры_ОтобразитьРезультат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФСГС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Док, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ОтобразитьРезультат = ВходящийКонтекст.ОтобразитьРезультат;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// отражаем изменения в базе
	Если НЕ ОтправкаНеформализованногоДокументаВФСГС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаНеформализованногоДокументаВФСГС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОтобразитьРезультат", ОтобразитьРезультат);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФСГСПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФСГС");

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФСГСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСГС
		Возврат;
	КонецЕсли;
	
	Если ВходящийКонтекст.ОтобразитьРезультат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСГС
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, КонтекстОтправки.Документ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаНеформализованногоДокументаВФСГС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Не выбран документ для отправки'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с Росстатом
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФСГС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель письма.';
								|en = 'Не задан получатель письма.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Приложения = ПолучитьВложенияНеформализованногоДокумента(Док, , Истина);
	
	// получаем содержание письма
	ТекстСодержания = Док.Содержание;
	
	// проверяем, не пустое ли письмо
	Если НЕ ЗначениеЗаполнено(ТекстСодержания) И Приложения.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'В письме не задано содержание и отсутствуют вложения.';
								|en = 'В письме не задано содержание и отсутствуют вложения.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ИмяФайлаСодержимого = ВыгрузитьТекстВФайл(ТекстСодержания);
	КороткоеИмяФайлаСодержимого = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФСГС;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = Док.Идентификатор;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = Док.Получатель;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = Док.Получатель;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем письмо
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоФСГС, ИмяФайлаСодержимого, КороткоеИмяФайлаСодержимого, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.Текст1251) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка письма прервана.';
								|en = 'Отправка письма прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к письму
	Для Каждого СтрПриложение Из Приложения Цикл
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПриложениеПисьмаФСГС, СтрПриложение.Данные, СтрПриложение.ИмяФайла, СтрПриложение.Размер, , , , , , СгенерироватьUUID(), ТипСодержимогоПоИмениФайла(СтрПриложение.ИмяФайла, Истина)) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ТипТранспортногоСообщения", ТранспортноеСообщение.Тип);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьСвойстваОтделенийФСГСИзИБ(КодыОтделенийФСГС)
	
	СведенияОбОтделениях = Новый Массив;
	
	// получаем из ИБ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОрганыФСГС.Код,
	                      |	ОрганыФСГС.Наименование,
	                      |	ОрганыФСГС.Сертификаты.(
	                      |		Сертификат
	                      |	)
	                      |ИЗ
	                      |	Справочник.ОрганыФСГС КАК ОрганыФСГС
	                      |ГДЕ
	                      |	ОрганыФСГС.Код В(&Код)");
	Запрос.УстановитьПараметр("Код", КодыОтделенийФСГС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// формируем результат
	Пока Выборка.Следующий() Цикл
		
		СертификатыОрганаФСГС = Новый Массив;
		ВыборкаСертификаты = Выборка.Сертификаты.Выбрать();
		Пока ВыборкаСертификаты.Следующий() Цикл
			СертификатыОрганаФСГС.Добавить(СокрЛП(ВыборкаСертификаты.Сертификат));
		КонецЦикла;
		СведенияОбОтделениях.Добавить(Новый Структура("Код, Наименование, Сертификаты",
														СокрЛП(Выборка.Код), СокрЛП(Выборка.Наименование), СертификатыОрганаФСГС));
	КонецЦикла;
	
	Возврат СведенияОбОтделениях;
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатыПриемаДекларацийБезПрикрепленныхПодписей(ЦиклыОбмена)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.РезультатыПриемаДекларацийБезПрикрепленныхПодписей(ЦиклыОбмена);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПрикрепленныеПодписиИВыгрузитьПакетыПоФНС(ЦиклОбмена) Экспорт
		
	СообщенияДляРасшифровки = РезультатыПриемаДекларацийБезПрикрепленныхПодписей(ЦиклОбмена);
	КоличествоСообщений = СообщенияДляРасшифровки.Количество();

	Если КоличествоСообщений = 0 Тогда
		ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНС(ЦиклОбмена);
		Возврат;
	КонецЕсли; 

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НПП", 0);
	ДополнительныеПараметры.Вставить("КоличествоСообщений", КоличествоСообщений);
	ДополнительныеПараметры.Вставить("ЦиклОбмена", ЦиклОбмена);
	ДополнительныеПараметры.Вставить("СообщенияДляРасшифровки", СообщенияДляРасшифровки);
	
	РасшифроватьСообщенияБезПодписей(Истина, ДополнительныеПараметры); 

КонецПроцедуры 

&НаКлиенте
Процедура РасшифроватьСообщенияБезПодписей(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Истина Тогда
		Возврат;	
	КонецЕсли; 
	
	НПП = ДополнительныеПараметры.НПП;
	КоличествоСообщений = ДополнительныеПараметры.КоличествоСообщений;
	ЦиклОбмена = ДополнительныеПараметры.ЦиклОбмена;
	СообщенияДляРасшифровки = ДополнительныеПараметры.СообщенияДляРасшифровки;
	
	Если НПП = КоличествоСообщений Тогда
		ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНС(ЦиклОбмена);
		Возврат;
	КонецЕсли;
	
	СообщениеДляРасшифровки = СообщенияДляРасшифровки[НПП];
	ДополнительныеПараметры.НПП = НПП + 1;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РасшифроватьСообщенияБезПодписей", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыОперации = Новый Структура("РасшифровкаОдного", Истина);
	РасшифроватьТранспортноеСообщение(СообщениеДляРасшифровки, ОписаниеОповещения, , ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНС(ВыгружаемыеЦиклыОбмена, Путь = Неопределено, ДополнятьПуть = Истина) Экспорт
	
	Если ТипЗнч(ВыгружаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ВыгружаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ВыгружаемыеЦиклыОбмена;
	КонецЕсли;
	
	// заданы ли циклы обмена
	Если НЕ ЗначениеЗаполнено(ЦиклыОбмена) Тогда
		ПоказатьПредупреждение(, "Не выбраны циклы обмена для выгрузки!");
		Возврат;
	КонецЕсли;
	
	ОбщееКоличествоФайлов = ПолучитьОбщееКоличествоВыгружаемыхПакетовПоДокументооборотамСдачиОтчетностиВФНС(ЦиклыОбмена);
	Если ОбщееКоличествоФайлов = 0 Тогда
		ПоказатьПредупреждение(, "Нет информации для выгрузки!");
		Возврат;
	КонецЕсли;
	
	ВсегоОбъектов = 0;
	ВсегоВАрхиве = 0;
	ВсегоОшибок = 0;
	
	СтатистикаПоЦиклам = ПолучитьВыгружаемыеПакетыПоДокументооборотамСдачиОтчетностиВФНС(ЦиклыОбмена, УникальныйИдентификатор, Истина);
	Для Каждого ЦО Из ЦиклыОбмена Цикл
		РезультатЦО = СтатистикаПоЦиклам.Получить(ЦО);
		
		Если ТипЗнч(РезультатЦО) = Тип("Строка") Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(РезультатЦО);
			ВсегоОшибок = ВсегоОшибок + 1;
			Продолжить;
		КонецЕсли;
			
		ВсегоОбъектов = ВсегоОбъектов + РезультатЦО.Всего;
		ВсегоВАрхиве = ВсегоВАрхиве + РезультатЦО.ВАрхиве;
	КонецЦикла;	
	Если ВсегоВАрхиве > 0 Тогда
		ПоказатьПредупреждение(, "Часть файлов перемещена в архив. Не могу продолжить выгрузку!");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ЦиклыОбмена, Путь, ДополнятьПуть, ОбщееКоличествоФайлов", ЦиклыОбмена, Путь, ДополнятьПуть, ОбщееКоличествоФайлов);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ТекстСообщения = ОперацииСФайламиЭДКОКлиент.ТекстСообщенияДляНеобязательнойУстановкиРасширенияРаботыСФайлами();
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения, ТекстСообщения, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершение(ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами", ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами);
	
	Путь = ДополнительныеПараметры.Путь;
	
	// заполнен ли путь
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		
		Если НЕ ЗначениеЗаполнено(Путь) Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершениеПослеПолученияКаталога", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
			Диалог.Заголовок = "Укажите каталог";
			Диалог.ПроверятьСуществованиеФайла = Истина;
			Диалог.Показать(ОписаниеОповещения);
		Иначе
			ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершениеПослеПолученияКаталога(Неопределено, ДополнительныеПараметры);
		КонецЕсли;
		
	Иначе
		
		ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершениеПослеПолученияКаталога(Неопределено, ДополнительныеПараметры)

	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОбщееКоличествоВыгружаемыхПакетовПоДокументооборотамСдачиОтчетностиВФНС(ЦиклыОбмена)
	
	Возврат ЦиклыОбмена.Количество();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВыгружаемыеПакетыПоДокументооборотамСдачиОтчетностиВФНС(ЦиклыОбмена, УникальныйИдентификатор, ТолькоОценка = Ложь)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьВыгружаемыеПакетыПоДокументооборотамСдачиОтчетностиВФНС(ЦиклыОбмена, УникальныйИдентификатор, ТолькоОценка);
	
КонецФункции

&НаКлиенте
Функция ПолучитьКодПодразделенияФССПоУмолчанию(КодПодчиненности,ДопРегНомерФСС,РегНомерФСС) Экспорт
	
	КодФСС = "";
	
	Если ПроверитьЦифровойКодЗаданнойДлины(КодПодчиненности, 5) Тогда
		КодФСС = КодПодчиненности;
	ИначеЕсли ПроверитьЦифровойКодЗаданнойДлины(ДопРегНомерФСС, 10) Тогда
		КодФСС = ДопРегНомерФСС;
	ИначеЕсли ПроверитьЦифровойКодЗаданнойДлины(РегНомерФСС, 10)Тогда
		КодФСС = РегНомерФСС;
	КонецЕсли;
	
	Возврат Лев(КодФСС,4);
КонецФункции

&НаКлиенте
Функция КодОрганаФСГССоответствуетТребованиямКлиент(КодОрганаФСГС) Экспорт 
	
	Возврат СтрокаСоответствуетШаблону(СокрЛП(КодОрганаФСГС), "№№-№№");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТаблицуОшибокОписиВходящихДокументов()
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("КодОшибки");
	ТаблицаОшибок.Колонки.Добавить("ТекстОшибки");
	
	НоваяСтрока = ТаблицаОшибок.Добавить();
	НоваяСтрока.КодОшибки = "0300100001";
	НоваяСтрока.ТекстОшибки = "Формат файла не определен";
	
	Возврат ТаблицаОшибок;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеПараметровПриОтправкеПредставления(Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтатусПроверки = Истина;
	// проверяем сведения об организации
	Если НЕ Параметры.ЭтоПБОЮЛ Тогда
	
		Если НЕ ЗначениеЗаполнено(Параметры.НаимЮЛПол) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано полное наименование организации.';
									|en = 'Не задано полное наименование организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИННЮЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН организации.';
									|en = 'Не задан ИНН организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(Параметры.ИННЮЛ, Ложь) Тогда
			ТекстСообщения = НСтр("ru = 'Некорректно задан ИНН организации.';
									|en = 'Некорректно задан ИНН организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.КППЮЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан КПП организации.';
									|en = 'Не задан КПП организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли СтрДлина(Параметры.КППЮЛ) <> 9 Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан КПП организации.';
									|en = 'Неверно задан КПП организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН индивидуального предпринимателя.';
									|en = 'Не задан ИНН индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(Параметры.ИННФЛ, Истина) Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан ИНН индивидуального предпринимателя.';
									|en = 'Неверно задан ИНН индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИПФамилия) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана фамилия индивидуального предпринимателя.';
									|en = 'Не задана фамилия индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИПИмя) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано имя индивидуального предпринимателя.';
									|en = 'Не задано имя индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// если представитель объявлен, то проверяем сведения о нем
	Если Параметры.ПрПодп = 2 Тогда
		
		СведенияДоверенности = Параметры.Доверенность;
		СведФизЛ = СведенияДоверенности.СвУпПред.СвПред.СведФизЛ;
		ФИОПодписанта = ДокументооборотСКОВызовСервера.УточнитьФИОПредставителя(
			СведФизЛ.ФИО,
			СведенияДоверенности.ДанныеПредставителя);
		Если НЕ ЗначениеЗаполнено(ФИОПодписанта) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задано ФИО уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задано ФИО уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Фамилия) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задана фамилия уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задана фамилия уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Имя) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задано имя уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задано имя уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		
		ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(Параметры.ФИОРук);
		Если НЕ ЗначениеЗаполнено(ФИОПодписанта.Фамилия) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана фамилия руководителя организации.';
									|en = 'Не задана фамилия руководителя организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Имя) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано имя руководителя организации.';
									|en = 'Не задано имя руководителя организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтатусПроверки;
	
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеОписиИсходящихДокументовВФНС(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ОписьСсылка = Контекст.Документ;
	ЭтоПакетСДопДокументами  = ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка);

	ТЧПредставляемыеДокументы = ОписьСсылка.ПредставляемыеДокументы;
	
	Справочники.ШаблоныПоясненийДляФНС.УстановитьТекстВФорматированныйДокумент(
		ОписьСсылка, 
		ТекстовоеПояснение, 
		"ТекстовоеПояснение");
		
	ЕстьПояснение = Справочники.ШаблоныПоясненийДляФНС.ЗаполненТекстФорматированногоДокумента(ТекстовоеПояснение);
		
	// проверяем заполненность табличной части ПредставляемыеДокументы
	Если ТЧПредставляемыеДокументы.Количество() = 0 И НЕ ЕстьПояснение Тогда
		ТекстСообщения = НСтр("ru = 'Не выбраны документы для отправки.';
								|en = 'Не выбраны документы для отправки.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ОшибокНет = Истина;
	
	ТипСкан = Тип("СправочникСсылка.СканированныеДокументыДляПередачиВЭлектронномВиде");
	
	Для каждого СтрокаТЧ Из ТЧПредставляемыеДокументы Цикл
		
		Если ТипЗнч(СтрокаТЧ.СсылкаНаОбъект) <> ТипСкан Тогда
			Продолжить;
		КонецЕсли;
			
		Если ЭтоПакетСДопДокументами Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.СсылкаНаОбъект.КВД) Тогда
			
				ПредставлениеДокумента = Строка(СтрокаТЧ.СсылкаНаОбъект);
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'У документа %1 не заполнен вид документа';
						|en = 'У документа %1 не заполнен вид документа'"), Символ(34) + ПредставлениеДокумента + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОшибокНет = Ложь;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.СсылкаНаОбъект.СведенияДокумента) Тогда
			
				ПредставлениеДокумента = Строка(СтрокаТЧ.СсылкаНаОбъект);
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'У документа %1 не заполнено наименование';
						|en = 'У документа %1 не заполнено наименование'"), Символ(34) + ПредставлениеДокумента + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОшибокНет = Ложь;
				
			КонецЕсли;
				
		КонецЕсли;
		
		Результат = Справочники.СканированныеДокументыДляПередачиВЭлектронномВиде.ПроверитьPDFВЗаписанномСканированномДокументе(
			СтрокаТЧ.СсылкаНаОбъект);
		Если НЕ Результат Тогда
			ОшибокНет = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	МаксКолвоФайлов = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.МаксимальнойКоличествоФайловОписи();
	ДопустимоеКоличествоФайлов = 
		МаксКолвоФайлов 
		- КонтекстЭДОСервер.КоличествоФайловОписиИсходящихДокументовПриОтправке(ОписьСсылка)
		- ?(ЕстьПояснение, 1, 0);
	
	Если ДопустимоеКоличествоФайлов < 0 Тогда
		
		ТекстСообщения = "Допустимое количество файлов превышено на " +(-ДопустимоеКоличествоФайлов) + ". Разделите опись на несколько частей перед отправкой";
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОшибокНет = Ложь;
		
	КонецЕсли; 
	
	РазмерПояснения = Справочники.ШаблоныПоясненийДляФНС.РазмерТекстовогоПоясненияПоСсылке(
		ОписьСсылка,
		ТекстовоеПояснение, 
		"ТекстовоеПояснение");
	
	//проверка на размер в мегабайтах (не более 72)
	Размер = 
		КонтекстЭДОСервер.ОриентировочныйРазмерОписиИсходящихДокументовПриОтправке(ОписьСсылка) 
		+ ?(ЕстьПояснение, РазмерПояснения, 0);
		
	РазмерВМегабайтах = Окр(Размер/ 1024 / 1024, 2, РежимОкругления.Окр15как20);
	
	ДопустимоеКоличествоМегабайт = 72 - РазмерВМегабайтах;	
	
	Если ДопустимоеКоличествоМегабайт < 0 Тогда
		
		ТекстСообщения = "Допустимый размер описи превышен на " +(-ДопустимоеКоличествоМегабайт) + " Мб. Разделите опись на несколько частей перед отправкой";
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОшибокНет = Ложь;
		
	КонецЕсли;
	
	Возврат ОшибокНет;
	
КонецФункции

#Область ОтправкаОписиИсходящихДокументовВФНС

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС(
		ОписьСсылка,
		Организация,
		УникальныйИдентификаторФормы,
		ВыполняемоеОповещение,
		ВыполнятьАвтонастройку = Истина) Экспорт
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("ОписьСсылка",                  ОписьСсылка);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение",        ВыполняемоеОповещение);
	КонтекстДлительнойОперации.Вставить("УникальныйИдентификаторФормы", УникальныйИдентификаторФормы);
	КонтекстДлительнойОперации.Вставить("Организация",                  Организация);
	КонтекстДлительнойОперации.Вставить("ВыполнятьАвтонастройку",       ВыполнятьАвтонастройку);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОписиИсходящихДокументовВФНС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОписьСсылка, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	ОписьСсылка = ВходящийКонтекст.ОписьСсылка;
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОписьСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка ответа на требование документов
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаОписиИсходящихДокументовВФНС",  0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаОписиИсходящихДокументовВФНС() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ОписьСсылка 			= КонтекстДлительнойОперации.ОписьСсылка;
	ВыполнятьАвтонастройку 	= КонтекстДлительнойОперации.ВыполнятьАвтонастройку;
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(КонтекстДлительнойОперации);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОписиИсходящихДокументовВФНСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	Если ВыполнятьАвтонастройку Тогда
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОписьСсылка,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложение(ВыполняемоеОповещение, Контекст)
	
	ТребующиеПодписания = Контекст.ТребующиеПодписания;
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ТранспортноеСообщение = Контекст.ТранспортноеСообщение;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Контекст);
	
	Отпечаток = ПолучитьОтпечаток(УчетнаяЗапись, "Руководитель",);
	
	Сертификат = Новый Структура(
		"Отпечаток, КлючевойКонтейнер",
		Отпечаток, РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота);
		
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Сертификат);
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) И ТребующиеПодписания.Количество() > 1 И ВключитьПакетнуюПодпись Тогда
		ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПакетно(ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, Сертификат);
	Иначе	
		НомерФайлаТребующегоПодписания = 0;
		ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, Сертификат);
	КонецЕсли;	
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		НомерФайлаТребующегоПодписания,
		СертификатРуководителя,
		МенеджерКриптографии = Неопределено,
		Алгоритм = Неопределено)
		
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатРуководителя);
	
	Если НомерФайлаТребующегоПодписания <= ТребующиеПодписания.ВГраница() Тогда
		
		ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
		
		АлгоритмПодписи = Алгоритм;
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
			ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ОписьИсходящихДокументовВФНС", ТранспортноеСообщение); 
			ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
			АлгоритмПодписи = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, СертификатРуководителя", 
			ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, СертификатРуководителя);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			ОписаниеОповещения,
			СертификатРуководителя,
			ДанныеФайла.АдресВременногоХранилища,
			Ложь,,,
			МенеджерКриптографии,,
			АлгоритмПодписи);
		
	Иначе
		
		//Все подписи добавлены
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
	КонецЕсли;
	
	ТранспортноеСообщение 			= ДополнительныеПараметры.ТранспортноеСообщение;
	ТребующиеПодписания 			= ДополнительныеПараметры.ТребующиеПодписания;
	НомерФайлаТребующегоПодписания 	= ДополнительныеПараметры.НомерФайлаТребующегоПодписания;
	Сертификат			 			= ДополнительныеПараметры.СертификатРуководителя;
	МестоХраненияКлюча				= КонтекстМоделиХраненияКлюча(Сертификат);
	
	ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
	
	КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
	
	// добавляем подпись как приложение
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
			ТранспортноеСообщение, 
			СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, 
			Результат.ФайлПодписи, 
			КороткоеИмяФайлаПодписи, 
			,
			,
			,
			,
			,
			,
			СгенерироватьUUID(), 
			ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
		
	КонецЕсли;

	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
	
		МенеджерКриптографии = Неопределено;
		
	Иначе
			
		МенеджерКриптографии = Результат.МенеджерКриптографии;
		
	КонецЕсли;
	
	Алгоритм = ?(МенеджерКриптографии <> Неопределено, Результат.Алгоритм, Неопределено);
	
	ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		НомерФайлаТребующегоПодписания + 1,
		Сертификат,
		МенеджерКриптографии,
		Алгоритм);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОтправкаОписиИсходящихДокументовВФНС(
		ВходящийКонтекст.ОписьСсылка,
		ВходящийКонтекст.Организация,
		ВходящийКонтекст.УникальныйИдентификаторФормы,
		ВходящийКонтекст.ВыполняемоеОповещение,
		Ложь);
		
КонецПроцедуры
		
&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОписиИсходящихДокументовВФНС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ОписьСсылка, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	ОписьСсылка = ВходящийКонтекст.ОписьСсылка;
	УникальныйИдентификаторФормы = ВходящийКонтекст.УникальныйИдентификаторФормы;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаОбъектаЗапрещена = ДокументооборотСКОВызовСервера.ОтправкаОбъектаЗапрещенаНаТарифеПромоЕНС(ОписьСсылка);
	Если ОтправкаОбъектаЗапрещена Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНевозможностиОтправкиНаТарифе(ОписьСсылка);
		Возврат;
	КонецЕсли;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", ОписьСсылка);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// отражаем изменения в базе
	Если НЕ ОтправкаОписиИсходящихДокументовВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаОписиИсходящихДокументовВФНС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОписьСсылка, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОписьСсылка, ВыполняемоеОповещение, Ложь);//+
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ДокументооборотСКОВызовСервера.ОрганизацияПодключенаКИнспекции(ОписьСсылка)
		ИЛИ НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ОписьСсылка) Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОписьСсылка, ВыполняемоеОповещение, Ложь); //+
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Добавление подписей...");
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаОписиИсходящихДокументовВФНСПослеДобавлениеПодписейКакПриложение", ЭтотОбъект, Контекст);
		
	// добавляем подписи для каждого из документов из массива ТребующиеПодписания	
	ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложение(Оповещение, КонтекстОтправки)
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНСПослеДобавлениеПодписейКакПриложение(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Формирование пакета...");
	
	// формируем пакет
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаОписиИсходящихДокументовВФНСПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура("ТребуетПодтверждениОперации", КонтекстОтправки.ТребующиеПодписания.Количество() = 0);
	КонецЕсли;
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС", ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 	  Ложь);
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	ПеренестиТекстовоеПояснениеВДеревоДокументовПослеОтправки(КонтекстОтправки.Документ);
	
	Оповестить("Запись_ОписиИсходящихДокументовВНалоговыеОрганы", , КонтекстОтправки.Документ);
	
	ДополнительныеПараметры.Вставить("РезультатОтправки", Истина);
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФНС
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ТекстОшибкиОтправкиОписи(ОписьСсылка)
	
	ЭтоПакетСДопДокументами = ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка);
	Если ЭтоПакетСДопДокументами Тогда
		ТекстСообщения = НСтр("ru = 'Отправка %1 прервана.';
								|en = 'Отправка %1 прервана.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ДокументооборотСКОКлиентСервер.ПредставлениеПакетаСДопДокументамиВРодительномПадеже(Истина));
	Иначе
		ТекстСообщения = НСтр("ru = 'Отправка ответа на требование прервана.';
								|en = 'Отправка ответа на требование прервана.'");
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Функция ОтправкаОписиИсходящихДокументовВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	// проверяем заполненность табличной части ПредставляемыеДокументы
	Если НЕ ОтправкаОписиИсходящихДокументовВФНС_Проверки(Контекст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписьСсылка    = Контекст.Документ;
	Организация    = ОписьСсылка.Организация;
	УчетнаяЗапись  = УчетнаяЗаписьОрганизации(Организация);
	НалоговыйОрган = ОписьСсылка.НалоговыйОрган;
	
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	КодНалоговогоОргана = СокрЛП(НалоговыйОрган.Код);
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		
		// формируем файл доверенности
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
			ЭлРегистрацияВИФНС,
			КороткоеИмяФайлаДоверенности,
			Организация,,,
			Истина);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось выгрузить файл доверенности.';
									|en = 'Не удалось выгрузить файл доверенности.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
		
		//подменять имя файла при отправке через уполномоченного представителя не требуется
		
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ЭтоФормат_ON_DOCNPNO_1_886_00_05_02 = ТребованияФНСКлиентСервер.ЭтоФормат_ON_DOCNPNO_1_886_00_05_02();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = ОписьСсылка;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	РезультатВыгрузкиОписи = Неопределено;
	Если НЕ ВыгрузитьОписьИсходящихДокументов(Контекст, ТранспортноеСообщение.Ссылка, РезультатВыгрузкиОписи) Тогда
		ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли; 
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	//добавляем файл Представление
	ДанныеФайлаПредставление = РезультатВыгрузкиОписи.ДанныеФайлаПредставление;
	ИмяФайлаПредставления = ДанныеФайлаПредставление.ИмяФайла;
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайлаПредставление.АдресВременногоХранилища);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление, ДвоичныеДанныеФайла, ИмяФайлаПредставления, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ТребующиеПодписания = Новый Массив;
	
	// добавляем файлы выгрузки
	Для Каждого ТекущийЭД Из РезультатВыгрузкиОписи.ТаблицаДокФорм Цикл
		
		МассивЭлементовЭД = Новый Массив;
		
		//заполнение массива МассивЭлементовЭД (возможное количество количество элементов: 1, 2, 4)
		СвойстваЭлементаЭД = Новый Структура("ИмяФайла, АдресВременногоХранилища, ТипСодержимого");
		СвойстваЭлементаЭД.ИмяФайла 				= ТекущийЭД.ИмяФайлаДанных;
		СвойстваЭлементаЭД.АдресВременногоХранилища = ТекущийЭД.АдресФайлаДанных;
		СвойстваЭлементаЭД.ТипСодержимого 			= Перечисления.ТипыСодержимогоФайлов.xml;
		
		МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
		
		Если ЗначениеЗаполнено(ТекущийЭД.ИмяФайлаПодписи) И ЗначениеЗаполнено(ТекущийЭД.АдресФайлаПодписи) Тогда
			
			ИмяФайла = ИсправленнноеИмяФайлаЭПФайлаОписиИсходящихДокументов(
				ТекущийЭД.ИмяФайлаПодписи, 
				ТекущийЭД.ИмяФайлаДанных);
			
			СвойстваЭлементаЭД = Новый Структура("ИмяФайла, АдресВременногоХранилища, ТипСодержимого");
			СвойстваЭлементаЭД.ИмяФайла 				= ИмяФайла;
			СвойстваЭлементаЭД.АдресВременногоХранилища = ТекущийЭД.АдресФайлаПодписи;
			СвойстваЭлементаЭД.ТипСодержимого 			= Перечисления.ТипыСодержимогоФайлов.sgn;
			
			МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
		Иначе
			// Ветка для отправки книг и журнала учета СФ.
			ДанныеФайла = Новый Структура;
			ДанныеФайла.Вставить("ИмяФайла", 	ТекущийЭД.ИмяФайлаДанных);
			ДанныеФайла.Вставить("ИдФайлЭП",  	ТекущийЭД.ИмяФайлаПодписи);
			ДанныеФайла.Вставить("АдресВременногоХранилища", ТекущийЭД.АдресФайлаДанных);
			
			ТребующиеПодписания.Добавить(ДанныеФайла);
		КонецЕсли;

		Если ЗначениеЗаполнено(ТекущийЭД.ПодтверждениеИмяФайлаДанных) Тогда
			
			СвойстваЭлементаЭД = Новый Структура("ИмяФайла, АдресВременногоХранилища, ТипСодержимого");
			СвойстваЭлементаЭД.ИмяФайла 				= ТекущийЭД.ПодтверждениеИмяФайлаДанных;
			СвойстваЭлементаЭД.АдресВременногоХранилища = ТекущийЭД.ПодтверждениеАдресФайлаДанных;
			СвойстваЭлементаЭД.ТипСодержимого 			= Перечисления.ТипыСодержимогоФайлов.xml;
			
			МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
			
			ИмяФайла = ИсправленнноеИмяФайлаЭПФайлаОписиИсходящихДокументов(
				ТекущийЭД.ПодтверждениеИмяФайлаПодписи, 
				ТекущийЭД.ПодтверждениеИмяФайлаДанных);
			
			СвойстваЭлементаЭД = Новый Структура("ИмяФайла, АдресВременногоХранилища, ТипСодержимого");
			СвойстваЭлементаЭД.ИмяФайла 				= ИмяФайла;
			СвойстваЭлементаЭД.АдресВременногоХранилища = ТекущийЭД.ПодтверждениеАдресФайлаПодписи;
			СвойстваЭлементаЭД.ТипСодержимого 			= Перечисления.ТипыСодержимогоФайлов.sgn;
			
			МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
		КонецЕсли;
		
		//разбор МассивЭлементовЭД 
		Для каждого СвойстваЭлементаЭД Из МассивЭлементовЭД Цикл
			
			ИмяФайла 		= СвойстваЭлементаЭД.ИмяФайла;
			АдресФайла 		= СвойстваЭлементаЭД.АдресВременногоХранилища;
			ТипСодержимого	= СвойстваЭлементаЭД.ТипСодержимого;
			
			Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
				ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
			Иначе
				ТекстСообщения = НСтр("ru = 'Не удалось получить файл %1 документа %2. 
                                       |Замените или удалите поврежденный документ и повторите отправку';
                                       |en = 'Не удалось получить файл %1 документа %2. 
                                       |Замените или удалите поврежденный документ и повторите отправку'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, СвойстваЭлементаЭД.ИмяФайла, ТекущийЭД.ПредставлениеДокумента);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, ДвоичныеДанныеФайла, ИмяФайла, , , , , , , СгенерироватьUUID(), ТипСодержимого) Тогда
				ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;	
		КонецЦикла;

	КонецЦикла;
	
	// добавляем файлы сканов документов и ЭП
	Для Каждого ТекущийСкан Из РезультатВыгрузкиОписи.ТаблицаНеДокФорм Цикл
		
		Для каждого ДанныеФайла Из ТекущийСкан.МассивФайлов Цикл
			
			//добавляем файл 
			ИмяФайла = ДанныеФайла.ИмяФайла;
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.АдресВременногоХранилища);
			
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, ДвоичныеДанныеФайла, ИмяФайла, , , , , , , СгенерироватьUUID(), ТипСодержимогоПоИмениФайла(ИмяФайла)) Тогда
				ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийСкан.ИдФайлЭП) 
				И НЕ ЗначениеЗаполнено(ТекущийСкан.АдресЭП) Тогда
				
				ФайлНаПодписание = Новый Структура;
				ФайлНаПодписание.Вставить("ИмяФайла", 	ИмяФайла);
				ФайлНаПодписание.Вставить("ИдФайлЭП",  	ТекущийСкан.ИдФайлЭП);
				ФайлНаПодписание.Вставить("АдресВременногоХранилища", ДанныеФайла.АдресВременногоХранилища);
				
				ТребующиеПодписания.Добавить(ФайлНаПодписание);
				
			КонецЕсли;

			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекущийСкан.ИдФайлЭП) И ЗначениеЗаполнено(ТекущийСкан.АдресЭП) Тогда
			
			//добавляем файл 
			ИмяФайла = ТекущийСкан.ИдФайлЭП;
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ТекущийСкан.АдресЭП);
			
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, ДвоичныеДанныеФайла, ИмяФайла, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.sgn) Тогда
				ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(ОписьСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОтправкаОписиИсходящихДокументовВФНС_Проверки(Контекст)
	
	ОписьСсылка = Контекст.Документ;
	
	// проверяем заполненность табличной части ПредставляемыеДокументы
	Если НЕ ПроверитьЗаполнениеОписиИсходящихДокументовВФНС(Контекст) Тогда
		ТекстСообщения = ТекстОшибкиОтправкиОписи(ОписьСсылка);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли механизм обмена с ФНС для организации, указанной в описи
	Организация = ОписьСсылка.Организация;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, указан ли получатель
	НалоговыйОрган = ОписьСсылка.НалоговыйОрган;
	Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан получатель - налоговый орган.';
								|en = 'Не указан получатель - налоговый орган.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПакетно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		СертификатРуководителя)
		
	ПараметрыЦикла = НовыЙ Структура();
	ПараметрыЦикла.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ПараметрыЦикла.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	ПараметрыЦикла.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения", ЭтотОбъект, ПараметрыЦикла);
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатРуководителя);
	
	МассивДокументов = Новый Массив;
	Для Счетчик = 0 По ТребующиеПодписания.ВГраница() Цикл
		ДанныеФайла = ТребующиеПодписания[Счетчик];
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
		НовыйДокументПакетнойПодписи(
			МассивДокументов,
			ДанныеФайла.АдресВременногоХранилища,
			ОписаниеФайла.Имя,
			ОписаниеФайла.Расширение,
			Счетчик);
	КонецЦикла;

	ПакетнаяПодписьОблачнойПодписи(ОписаниеОповещения, МестоХраненияКлюча, МассивДокументов, СертификатРуководителя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОписиИсходящихДокументовВФНС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения(
		РезультатВыполнения, ВходящийКонтекст) Экспорт
		
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ТребующиеПодписания = ВходящийКонтекст.ТребующиеПодписания;
	ТранспортноеСообщение = ВходящийКонтекст.ТранспортноеСообщение;
	Результат = РезультатВыполнения.Выполнено;
		
	Если Результат Тогда
		
		Для Счетчик = 0 По РезультатВыполнения.Результат.ВГраница() Цикл
			Подпись = РезультатВыполнения.Результат[Счетчик];
			ДанныеФайла = ТребующиеПодписания[Счетчик];
			КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
			
			// добавляем подпись как приложение
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
					ТранспортноеСообщение, 
					СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, 
					Подпись, 
					КороткоеИмяФайлаПодписи, 
					,
					,
					,
					,
					,
					,
					СгенерироватьUUID(), 
					ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				
				Результат = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Результат);
	
КонецПроцедуры

#КонецОбласти

#Область ОтправкаЖурналаСчетовФактур

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	ОтправкаЖурналаСчетовФактурВФНС(
		ВходящийКонтекст.ДокументСсылка,
		ВходящийКонтекст.Организация,
		ВходящийКонтекст.УникальныйИдентификаторФормы,
		ВходящийКонтекст.ВыполняемоеОповещение);
		
КонецПроцедуры
		
&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС(
		ДокументСсылка,
		Организация,
		УникальныйИдентификаторФормы,
		ВыполняемоеОповещение) Экспорт
		
	ВыполнятьАвтонастройку = Истина;

	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", ДокументСсылка);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	
	ОтправкаОбъектаЗапрещена = ДокументооборотСКОВызовСервера.ОтправкаОбъектаЗапрещенаНаТарифеПромоЕНС(ДокументСсылка);
	Если ОтправкаОбъектаЗапрещена Тогда
		ДокументооборотСКОКлиент.СообщитьОНевозможностиОтправкиНаТарифе(ДокументСсылка);
		Возврат;
	КонецЕсли;
	
	// отражаем изменения в базе
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	Если НЕ ОтправкаЖурналаСчетовФактурВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ДокументСсылка", 					ДокументСсылка);
			ДополнительныеПараметры.Вставить("Организация",			 			Организация);
			ДополнительныеПараметры.Вставить("УникальныйИдентификаторФормы", 	УникальныйИдентификаторФормы);
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаЖурналаСчетовФактурВФНС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ДокументСсылка, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь);//+
		Иначе
		
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);

			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Журнал
			
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ДокументСсылка) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь);//+
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДокументСсылка",               ДокументСсылка);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении",        ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("УникальныйИдентификаторФормы", УникальныйИдентификаторФормы);
	ДополнительныеПараметры.Вставить("Организация",                  Организация);
	ДополнительныеПараметры.Вставить("КонтекстОтправки",             КонтекстОтправки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЖурналаСчетовФактурВФНСПослеАвтонастройкиУчетнойЗаписи", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 		ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("ДокументСсылка", 			ДокументСсылка);
	КонтекстДлительнойОперации.Вставить("ВыполнятьАвтонастройку", 	ВыполнятьАвтонастройку);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ДокументСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка журнала в ФНС
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаЖурналаСчетовФактурВФНС",  0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаЖурналаСчетовФактурВФНС() Экспорт
		
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ДокументСсылка 			= КонтекстДлительнойОперации.ДокументСсылка;
	ОписаниеОповещения 		= КонтекстДлительнойОперации.ОписаниеОповещения;
	ВыполнятьАвтонастройку 	= КонтекстДлительнойОперации.ВыполнятьАвтонастройку;
	
	Если ВыполнятьАвтонастройку Тогда
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ДокументСсылка,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаЖурналаСчетовФактурВФНС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ДокументСсылка, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаЖурналаСчетовФактурВФНСПослеДобавлениеПодписейКакПриложение", ЭтотОбъект, ВходящийКонтекст);
		
	// добавляем подписи для каждого из документов из массива ТребующиеПодписания	
	ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложение(Оповещение, ВходящийКонтекст.КонтекстОтправки)
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаЖурналаСчетовФактурВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	ДокументСсылка 	= Контекст.Документ;
	
	// проверяем, включен ли механизм обмена с ФНС для организации, указанной в журнале
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	//требуется сформировать файл доверенности 
	//и определить налоговый орган (для записи в реквизит цикла обмена)
	//для этого определяем ИФНС через переопределяемый модуль
	КодНалоговогоОргана = СведенияПоОтправляемымОбъектам(ДокументСсылка).КодКонтролирующегоОргана;
	Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
			|en = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.'"), Символ(34) + КодНалоговогоОргана + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	//теперь формируем файл доверенности
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
			ЭлРегистрацияВИФНС,
			КороткоеИмяФайлаДоверенности,
			Организация,,,
			Истина);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось выгрузить файл доверенности.';
									|en = 'Не удалось выгрузить файл доверенности.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
		
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = ДокументСсылка;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление;
	ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ЖурналУчетаСчетовФактур;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	РезультатВыгрузкиЖурнала = Неопределено;
	Если НЕ ВыгрузитьЖурналСчетовФактурДляОтправкиВФНС(Контекст, РезультатВыгрузкиЖурнала, ЭлРегистрацияВИФНС) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка журнала прервана.';
								|en = 'Отправка журнала прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли; 
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	//добавляем файл Представление
	ДанныеФайлаПредставление = РезультатВыгрузкиЖурнала.ДанныеФайлаПредставление;
	ИмяФайлаПредставления = ДанныеФайлаПредставление.ИмяФайла;
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайлаПредставление.АдресВременногоХранилища);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление, ДвоичныеДанныеФайла, ИмяФайлаПредставления, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка журнала прервана.';
								|en = 'Отправка журнала прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ИдФайл 				= РезультатВыгрузкиЖурнала.ИдФайл;
	ИдФайлЭП 			= РезультатВыгрузкиЖурнала.ИдФайлЭП;
	АдресФайлаДанных 	= РезультатВыгрузкиЖурнала.АдресВременногоХранилища;
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаДанных);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, ДвоичныеДанныеФайла, ИдФайл, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка журнала прервана.';
								|en = 'Отправка журнала прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ТребующиеПодписания = Новый Массив;
	
	ДанныеФайла = Новый Структура;
	ДанныеФайла.Вставить("ИмяФайла", 					ИдФайл);
	ДанныеФайла.Вставить("ИдФайлЭП", 					ИдФайлЭП);
	ДанныеФайла.Вставить("АдресВременногоХранилища", 	АдресФайлаДанных);
	
	ТребующиеПодписания.Добавить(ДанныеФайла);
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(ДокументСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложение(ВыполняемоеОповещение, Контекст)
	
	ТребующиеПодписания     = Контекст.ТребующиеПодписания;
	УчетнаяЗапись           = Контекст.УчетнаяЗапись;
	ТранспортноеСообщение   = Контекст.ТранспортноеСообщение;
	РеквизитыУчетнойЗаписи  = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись);
	МестоХраненияКлюча		= КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	Отпечаток               = ПолучитьОтпечаток(УчетнаяЗапись, "Руководитель",);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Контекст);

	Сертификат = Новый Структура();
	Сертификат.Вставить("Отпечаток",         Отпечаток);
	Сертификат.Вставить("КлючевойКонтейнер", РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, Сертификат);
	
	НомерФайлаТребующегоПодписания = 0;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) И ТребующиеПодписания.Количество() > 1 И ВключитьПакетнуюПодпись Тогда
		ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПакетно(
			ВыполняемоеОповещение,
			ТранспортноеСообщение,
			ТребующиеПодписания,
			Сертификат);
	Иначе	
		ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(
			ВыполняемоеОповещение,
			ТранспортноеСообщение,
			ТребующиеПодписания,
			НомерФайлаТребующегоПодписания,
			Сертификат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(
	ВыполняемоеОповещение,
	ТранспортноеСообщение,
	ТребующиеПодписания,
	НомерФайлаТребующегоПодписания,
	Сертификат,
	МенеджерКриптографии = Неопределено,
	Алгоритм = Неопределено)
	
	Если НомерФайлаТребующегоПодписания <= ТребующиеПодписания.ВГраница() Тогда
		
		ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",          ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ТранспортноеСообщение",          ТранспортноеСообщение);
		ДополнительныеПараметры.Вставить("ТребующиеПодписания",            ТребующиеПодписания);
		ДополнительныеПараметры.Вставить("НомерФайлаТребующегоПодписания", НомерФайлаТребующегоПодписания);
		ДополнительныеПараметры.Вставить("СертификатРуководителя",         Сертификат);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
		АлгоритмПодписи = Алгоритм;
		
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
			ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
			ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЖурналСчетовФактурВФНС", ТранспортноеСообщение); 
			АлгоритмПодписи = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
		КонецЕсли;
		
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			ОписаниеОповещения,
			Сертификат,
			ДанныеФайла.АдресВременногоХранилища,
			Ложь,,,
			МенеджерКриптографии,,
			АлгоритмПодписи);
		
	Иначе
		
		//Все подписи добавлены
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
	КонецЕсли;
	
	ТранспортноеСообщение 			= ДополнительныеПараметры.ТранспортноеСообщение;
	ТребующиеПодписания 			= ДополнительныеПараметры.ТребующиеПодписания;
	НомерФайлаТребующегоПодписания 	= ДополнительныеПараметры.НомерФайлаТребующегоПодписания;
	Сертификат 						= ДополнительныеПараметры.СертификатРуководителя;
	МестоХраненияКлюча				= КонтекстМоделиХраненияКлюча(Сертификат);
	
	ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
	
	КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
	
	// добавляем подпись как приложение
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, Результат.ФайлПодписи, КороткоеИмяФайлаПодписи, , , , , , , СгенерироватьUUID(), ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
		
	КонецЕсли;

	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
	
		МенеджерКриптографии = Неопределено;
		
	Иначе
			
		МенеджерКриптографии = Результат.МенеджерКриптографии;
		
	КонецЕсли;
	
	Алгоритм = ?(МенеджерКриптографии <> Неопределено, Результат.Алгоритм, Неопределено);
	
	ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПоследовательно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		НомерФайлаТребующегоПодписания + 1,
		Сертификат,
		МенеджерКриптографии,
		Алгоритм);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНСПослеДобавлениеПодписейКакПриложение(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Журнал
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаЖурналаСчетовФактурВФНСПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура("ТребуетПодтверждениОперации", Ложь);
	КонецЕсли;	
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС", ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Журнал
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Журнал;

		Возврат;
	КонецЕсли;
	
	Оповестить("Запись_ЖурналУчетаСчетовФактурДляПередачиВЭлектронномВиде", КонтекстОтправки.Документ);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Журнал.
	
КонецПроцедуры	

//используется для независимой (от требования о представлении документов) отправки журнала СФ
&НаСервереБезКонтекста
Функция ВыгрузитьЖурналСчетовФактурДляОтправкиВФНС(Контекст, ДанныеФайловВыгрузки, ЭлРегистрацияВИФНС)
	
	УникальныйИдентификаторФормы = Контекст.УникальныйИдентификатор;
	ДокументСсылка = Контекст.Документ;
	
	ДанныеФайловВыгрузки = ПолучитьДанныеФайлаВыгрузкиЖурналаСчетовФактур(ДокументСсылка, УникальныйИдентификаторФормы);	
	Если ДанныеФайловВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось получить файл выгрузки журнала.';
								|en = 'Не удалось получить файл выгрузки журнала.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;	
	
	Организация 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	КодНалоговогоОргана 	= ЭлРегистрацияВИФНС.Код;
	ПараметрыОписи 			= СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана);
	
	Если НЕ ПроверитьЗаполнениеПараметровПриОтправкеПредставления(ПараметрыОписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	ПараметрыОписи.Вставить("Журнал", "ЖУРНАЛ");
	
	ПараметрыОписи.Вставить("ЭтоЖурналСФ", Истина);
	
	// формируем XML представления и имя файла представления
	ИмяФайлаПредставления = Неопределено;
	КолФайл = 2;
	ТекстПредставления = СформироватьXMLПредставления(
		Организация, 
		ДанныеФайловВыгрузки, 
		ПараметрыОписи, 
		ИмяФайлаПредставления, 
		КолФайл);
		
	Если НЕ ЗначениеЗаполнено(ТекстПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать XML файл описи исходящих документов.';
								|en = 'Не удалось сформировать XML файл описи исходящих документов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем XML во временный файл в кодировке windows-1251
	ФайлПредставления = ВыгрузитьТекстВФайл(ТекстПредставления, ПолучитьИмяВременногоФайла());
	Если НЕ ЗначениеЗаполнено(ФайлПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось записать содержимое описи исходящих документов в файл.';
								|en = 'Не удалось записать содержимое описи исходящих документов в файл.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	                                                                             
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлПредставления);
	СсылкаНаДвоичныеДанныеФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификаторФормы);
	
	ДанныеФайлаПредставление = Новый Структура;
	ДанныеФайлаПредставление.Вставить("ИмяФайла", ИмяФайлаПредставления);
	ДанныеФайлаПредставление.Вставить("АдресВременногоХранилища", СсылкаНаДвоичныеДанныеФайла);
	
	
	ДанныеФайловВыгрузки.Вставить("ДанныеФайлаПредставление", ДанныеФайлаПредставление);
	
	Возврат Истина;

КонецФункции

//используется для независимой (от требования о представлении документов) отправки журнала СФ
&НаСервереБезКонтекста
Функция ПолучитьДанныеФайлаВыгрузкиЖурналаСчетовФактур(ДокументСсылка, УникальныйИдентификаторФормы)
	
	// инициализируем структуру-результат
	Результат = Новый Структура;
	Если ТипЗнч(ДокументСсылка) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда

		ВсеФайлы = ИзвлечьЭлектронныеПредставленияИзХранилища(ДокументСсылка, 1);
		
		Если ВсеФайлы <> Неопределено И ВсеФайлы.Количество() > 0 Тогда
			Выборка = ВсеФайлы[0];			
			Если Выборка.ВАрхиве Тогда
				ДанныеПредставления = Base64Значение("");
			Иначе
				ДанныеПредставления = Выборка.Данные;
			КонецЕсли;			
		Иначе
			Выборка = Новый Структура("ИмяФайла", "");
			ДанныеПредставления = Неопределено;
		КонецЕсли;
		
		Результат.Вставить("ИдФайл", Выборка.ИмяФайла);
		Результат.Вставить("АдресВременногоХранилища", ПоместитьВоВременноеХранилище(ДанныеПредставления, Новый УникальныйИдентификатор));

	Иначе
		МассивНДС 	= Новый Массив;
		МассивНДС.Добавить(ДокументСсылка);
		СоответствиеНДС 	= ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьФайлыВыгрузкиНДС(МассивНДС, Новый УникальныйИдентификатор);
		МассивФайлов = СоответствиеНДС.Получить(ДокументСсылка);
		
		Если НЕ ЗначениеЗаполнено(МассивФайлов) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДанныеФайла = МассивФайлов[0];
		
		Результат.Вставить("ИдФайл", 					ДанныеФайла.ИмяФайла);
		Результат.Вставить("АдресВременногоХранилища", 	ДанныеФайла.АдресВременногоХранилища);
	КонецЕсли;	
	
	ИдФайлЭП = ИмяФайлаЭПФайлаОписиИсходящихДокументов(Результат.ИдФайл);
	Результат.Вставить("ИдФайлЭП", ИдФайлЭП);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПакетно(
	ВыполняемоеОповещение,
	ТранспортноеСообщение,
	ТребующиеПодписания,
	Сертификат,
	Алгоритм = Неопределено)
	
	ПараметрыЦикла = НовыЙ Структура();
	ПараметрыЦикла.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ПараметрыЦикла.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	ПараметрыЦикла.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения", ЭтотОбъект, ПараметрыЦикла);
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
	
	МассивДокументов = Новый Массив;
	Для Счетчик = 0 По ТребующиеПодписания.ВГраница() Цикл
		ДанныеФайла = ТребующиеПодписания[Счетчик];
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
		НовыйДокументПакетнойПодписи(
			МассивДокументов,
			ДанныеФайла.АдресВременногоХранилища,
			ОписаниеФайла.Имя,
			ОписаниеФайла.Расширение,
			Счетчик);
	КонецЦикла;

	ПакетнаяПодписьОблачнойПодписи(ОписаниеОповещения, МестоХраненияКлюча, МассивДокументов, Сертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЖурналаСчетовФактурВФНС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ТребующиеПодписания = ВходящийКонтекст.ТребующиеПодписания;
	ТранспортноеСообщение = ВходящийКонтекст.ТранспортноеСообщение;
	
	Результат = РезультатВыполнения.Выполнено;
	
	Если Результат Тогда
		
		Для Счетчик = 0 По РезультатВыполнения.Результат.ВГраница() Цикл
			ДанныеФайла = ТребующиеПодписания[Счетчик];
			Подпись = РезультатВыполнения.Результат[Счетчик];
			КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
			
			// добавляем подпись как приложение
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, Подпись, КороткоеИмяФайлаПодписи, , , , , , , СгенерироватьUUID(), ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				
				Результат = Ложь;
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Результат);	
	
КонецПроцедуры

#КонецОбласти


