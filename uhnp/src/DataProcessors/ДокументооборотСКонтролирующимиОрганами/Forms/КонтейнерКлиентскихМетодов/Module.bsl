КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВРПН(ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность) Экспорт

	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСРПНКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТекстФайлаВыгрузки 	= "";
	ИмяФайлаВыгрузки 	= "";
	Приложения = Новый Массив;
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	Кодировка 			= "utf-8"; // кодировка, в которую нужно сконвертировать текст выгрузки перед подписью
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;
		
		Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ТекстФайлаВыгрузки) = Тип("Массив") Тогда
			АдресОсновногоФайлаВыгрузки = Неопределено;
			Для каждого ЭлементВыгрузки Из ТекстФайлаВыгрузки Цикл
				Если ТипЗнч(ЭлементВыгрузки) = Тип("Структура")
					И ЭлементВыгрузки.Свойство("АдресФайлаВыгрузки")
					И ЭлементВыгрузки.Свойство("ИмяФайлаВыгрузки") Тогда
					
					РасширениеВыгрузки = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
						ЭлементВыгрузки.ИмяФайлаВыгрузки).Расширение;
					Если нрег(РасширениеВыгрузки) = ".xml" И АдресОсновногоФайлаВыгрузки = Неопределено Тогда
						АдресОсновногоФайлаВыгрузки = ЭлементВыгрузки.АдресФайлаВыгрузки;
						ИмяФайлаВыгрузки = ЭлементВыгрузки.ИмяФайлаВыгрузки;
						
					Иначе
						Приложения.Добавить(ЭлементВыгрузки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если АдресОсновногоФайлаВыгрузки = Неопределено И ТекстФайлаВыгрузки.Количество() > 0
				И ТипЗнч(ТекстФайлаВыгрузки[0]) = Тип("Структура")
				И ТекстФайлаВыгрузки[0].Свойство("АдресФайлаВыгрузки")
				И ТекстФайлаВыгрузки[0].Свойство("ИмяФайлаВыгрузки") Тогда
				
				АдресОсновногоФайлаВыгрузки = ТекстФайлаВыгрузки[0].АдресФайлаВыгрузки;
				ИмяФайлаВыгрузки = ТекстФайлаВыгрузки[0].ИмяФайлаВыгрузки;
				Приложения.Удалить(0);
			КонецЕсли;
			Если АдресОсновногоФайлаВыгрузки <> Неопределено Тогда
				ТекстФайлаВыгрузки = ПрочитатьТекстИзФайла(АдресОсновногоФайлаВыгрузки, "utf-8");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
		МассивВыгруженныхУведомлений = Неопределено;
		Если НЕ ВыгрузитьУведомлениеФНС(ОтчетСсылка, МассивВыгруженныхУведомлений) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		ТекстФайлаВыгрузки = ПрочитатьТекстИзФайла(МассивВыгруженныхУведомлений[0].АдресФайлаВыгрузки, "utf-8");
		ИмяФайлаВыгрузки = МассивВыгруженныхУведомлений[0].ИмяФайлаВыгрузки;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,,
			"utf-8");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("Кодировка", 			Кодировка);
	
	Возврат ДополнительныеПараметры;

КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВФСРАР(
	ОтчетСсылка,
	Форма,
	ЭтоОтправкаИзФормыОтчетность,
	АдресГотовыхДанных = Неопределено,
	ИмяФайлаГотовыхДанных = Неопределено) Экспорт
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТекстФайлаВыгрузки 	= "";
	ИмяФайлаВыгрузки 	= ""; 
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
		
		Если АдресГотовыхДанных <> Неопределено Тогда
			ПривестиКСтроке = (РегламентированнаяОтчетностьКлиент.ВебБраузер() = "MSIE");
			ТекстФайлаВыгрузки = ПолучитьИзВременногоХранилищаЕслиСтрока(АдресГотовыхДанных, ПривестиКСтроке);
			ИмяФайлаВыгрузки = ИмяФайлаГотовыхДанных;
			
		Иначе
			Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда 
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
			Иначе
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
			КонецЕсли;
			
			Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(ОтчетСсылка, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	
	Возврат ДополнительныеПараметры;

КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВФТС(ОтчетСсылка, Форма, ЭтоОтправкаИзФормыОтчетность) Экспорт

	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТекстФайлаВыгрузки 	= "";
	ИмяФайлаВыгрузки 	= ""; 
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
		
		РезультатВыгрузкиИзЗаявленияОВвозеТоваров = ПопытатьсяВыгрузитьСтатформуИзЗаявленияОВвозеТоваров(
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,
			ОтчетСсылка);

		Если РезультатВыгрузкиИзЗаявленияОВвозеТоваров = Неопределено Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		
		Если НЕ РезультатВыгрузкиИзЗаявленияОВвозеТоваров Тогда
			Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
			Иначе
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
			КонецЕсли;
			
			Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,,
			"utf-8");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	
	Возврат ДополнительныеПараметры;

КонецФункции

&НаКлиенте
Процедура Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ОписаниеОповещения 					= КонтекстДлительнойОперации.ОписаниеОповещения;
	ОрганизацияОтчета 					= КонтекстДлительнойОперации.ОрганизацияОтчета;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(КонтекстДлительнойОперации);

	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеИнициализации(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеИнициализации(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОрганизацияСсылка 				= ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка 					= ДополнительныеПараметры.ОтчетСсылка;
	Форма 							= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 	= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОповещениеОЗавершении 			= ДополнительныеПараметры.ОповещениеОЗавершении;
	ТипОтправляемогоДокумента 		= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 		= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	Если ОтчетСсылка = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияСсылка = ДокументооборотСФССКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	УчетнаяЗапись 						= РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор 						= РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	ВыполняемоеОповещение = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеВыгрузкиПакетаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	// запрашиваем параметры формирования пакета
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Идентификатор",         Идентификатор);
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВФССПослеПолученияСертификатовЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	ПолучатьСертификатФССЭЛН = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	ПолучитьСертификатыИзНастроекОрганизацииДляФСС(
		МестоХраненияКлюча,
		ОрганизацияСсылка,
		Оповещение,
		ПолучатьСертификатФССЭЛН);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеВыгрузкиПакетаЗавершение(РезультатВыгрузки, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеВыгрузкиПакетаЗавершение(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОрганизацияСсылка 					= ДополнительныеПараметры.ОрганизацияОтчета;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	МЧД 								= ?(ДополнительныеПараметры.Свойство("МЧД"), ДополнительныеПараметры.МЧД, "");
	
	Если НЕ ЗначениеЗаполнено(РезультатВыгрузки) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоПодписьИШифрованиеSOAP Тогда
		
		СтрокаBase64ФайлаПакета = РезультатВыгрузки.ИмяФайлаЗашифрованногоПакета;
		КороткоеИмяФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(РезультатВыгрузки.ИмяФайлаВыгрузки).Имя;
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено",      Истина);
		Результат.Вставить("ДвоичныеДанные", Неопределено);
		Результат.Вставить("СтрокаBase64",   СтрокаBase64ФайлаПакета);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета", 				КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 					ОрганизацияСсылка);
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 				ПоляДляЗаписиОтправки);
		ДополнительныеПараметры.Вставить("Форма", 								Форма);
		ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
		ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", 					РезультатВыгрузки.ПодписанныйSOAP64);
		ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеЧтенияФайлаВыгрузкиПакетаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
	
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
	Иначе
		
		КороткоеИмяФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(РезультатВыгрузки).Имя;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета", 				КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 					ОрганизацияСсылка);
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 				ПоляДляЗаписиОтправки);
		ДополнительныеПараметры.Вставить("Форма", 								Форма);
		ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
		ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", 					Неопределено);
		ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеЧтенияФайлаВыгрузкиПакетаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, РезультатВыгрузки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеЧтенияФайлаВыгрузкиПакетаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеВыгрузкиПакетаЗавершение(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КороткоеИмяФайлаПакета 				= ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	ОрганизацияСсылка 					= ДополнительныеПараметры.ОрганизацияСсылка;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	ПодписанныйSOAP64 					= ДополнительныеПараметры.ПодписанныйSOAP64;
	МЧД 								= ДополнительныеПараметры.МЧД;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаПакета = Результат.СтрокаBase64;
	
	ИнформацияДляОтправкиВФСС = СформироватьФайлОтправкиВФССНаСервере(
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча),
		Форма.УникальныйИдентификатор,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента);
	СтрокаBase64ФайлаПакета 	= ИнформацияДляОтправкиВФСС.СтрокаBase64ФайлаПакета;
	СтрокаBase64ФайлаОтправки 	= ИнформацияДляОтправкиВФСС.СтрокаBase64ФайлаОтправки;
	
	Если СтрокаBase64ФайлаОтправки = Неопределено Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось сформировать файл отправки.';
				|en = 'Не удалось сформировать файл отправки.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	// определим адрес сервера ФСС
	
	АдресСервера = СерверПриемаОтчетностиФСС(
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		ОрганизацияСсылка);
	
	Если АдресСервера = Неопределено Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Не удалось определить тип документа.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	// отправляем
	
	НастройкиОтправки = Новый Структура;
	НастройкиОтправки.Вставить("ОрганизацияСсылка", 			ОрганизацияСсылка);
	НастройкиОтправки.Вставить("ОтчетСсылка", 					ОтчетСсылка);
	НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 		ПоляДляЗаписиОтправки);
	НастройкиОтправки.Вставить("Форма", 						Форма);
	НастройкиОтправки.Вставить("ЭтоОтправкаИзФормыОтчетность", 	ЭтоОтправкаИзФормыОтчетность);
	НастройкиОтправки.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
	НастройкиОтправки.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
	НастройкиОтправки.Вставить("ПодписанныйSOAP64", 			ПодписанныйSOAP64);
	НастройкиОтправки.Вставить("МЧД", 							МЧД);
	НастройкиОтправки.Вставить("ОповещениеОЗавершении", 		ОповещениеОЗавершении);
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССОтправкаВЦикле(
		МестоХраненияКлюча,
		АдресСервера,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		НастройкиОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервере(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		ЭтоВызовИзСписка)
	
	ПодписанныйПакетДляАвторизации = "";
	АвторизацияПодготовлена = Истина;
	
	Если НЕ АвторизацияПроизведена Тогда
		
		СлучайныйКлюч                      = "";
		Данные64CAPTCHA                    = "";
		ПараметрыСоединения.ЗначениеCookie = "";
		
		ПодписанныйПакетДляАвторизацииТребуется = (СхемаСдачиОтчетности <> ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ТиповойРегиональныйИФедеральныйСерверы") 
			ИЛИ ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале);
		
		Если ПодписанныйПакетДляАвторизацииТребуется Тогда
			
			ПодписываемыеДанные = ПолучитьПодписываемыеДанныеФСРАРНаСервере(
				ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
				СлучайныйКлюч,
				Данные64CAPTCHA,
				ОтправкаСсылка,
				ЭтоРегламентированныйОтчет,
				ПараметрыОтправки,
				ПараметрыСоединения,
				,
				ЭтоВызовИзСписка);
			
			ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
				
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПодписываемыеДанные) Тогда
			
			Если СхемаСдачиОтчетности <> ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ТиповойРегиональныйИФедеральныйСерверы") ИЛИ ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале Тогда
				ЗначениеCAPTCHA = "";
				Если Данные64CAPTCHA <> "" Тогда
					
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("Форма",                                                              Форма);
					ДополнительныеПараметры.Вставить("ОтправкаСсылка",                                                     ОтправкаСсылка);
					ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                                              ВыполняемоеОповещение);
					ДополнительныеПараметры.Вставить("ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал",   ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал);
					ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",                                            ФормаДлительнаяОперация);
					ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",                                        СертификатыИПараметрыОбмена);
					ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",                                               СхемаСдачиОтчетности);
					ДополнительныеПараметры.Вставить("ПодписанныйПакетДляАвторизации",                                     ПодписанныйПакетДляАвторизации);
					ДополнительныеПараметры.Вставить("Крипт",                                                              Крипт);
					ДополнительныеПараметры.Вставить("ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64",   ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64);
					ДополнительныеПараметры.Вставить("ПараметрыСоединения",                                                ПараметрыСоединения);
					ДополнительныеПараметры.Вставить("ПараметрыОтправки",                                                  ПараметрыОтправки);
					ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",                                        ПараметрыФормированияПакета);
					ДополнительныеПараметры.Вставить("УчетнаяЗапись",                                                      УчетнаяЗапись);
					ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",                                         ЭтоРегламентированныйОтчет);
					ДополнительныеПараметры.Вставить("ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале", ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале);
					ДополнительныеПараметры.Вставить("СлучайныйКлюч",                                                      СлучайныйКлюч);
					ДополнительныеПараметры.Вставить("ПодписываемыеДанные",                                                ПодписываемыеДанные);
					ДополнительныеПараметры.Вставить("АвторизацияПроизведена",                                             АвторизацияПроизведена);
					ДополнительныеПараметры.Вставить("АвторизацияПодготовлена",                                            АвторизацияПодготовлена);
					ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",                                                   ЭтоВызовИзСписка);
					ДополнительныеПараметры.Вставить("ПодписанныйПакетДляАвторизацииТребуется",                            ПодписанныйПакетДляАвторизацииТребуется);
					ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
					
					ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервереЗавершение", ЭтотОбъект, ДополнительныеПараметры); 
					
					ВызватьФормуВводаCAPTCHA(Данные64CAPTCHA, , ОписаниеОповещения);
					Возврат;
				КонецЕсли;
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("Форма",                                                              Форма);
				ДополнительныеПараметры.Вставить("ОтправкаСсылка",                                                     ОтправкаСсылка);
				ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                                              ВыполняемоеОповещение);
				ДополнительныеПараметры.Вставить("ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал",   ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал);
				ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",                                            ФормаДлительнаяОперация);
				ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",                                        СертификатыИПараметрыОбмена);
				ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",                                               СхемаСдачиОтчетности);
				ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);

				ДополнительныеПараметры.Вставить("Крипт",                                                              Крипт);
				ДополнительныеПараметры.Вставить("ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64",   ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64);
				ДополнительныеПараметры.Вставить("ПараметрыСоединения",                                                ПараметрыСоединения);
				ДополнительныеПараметры.Вставить("ПараметрыОтправки",                                                  ПараметрыОтправки);
				ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",                                        ПараметрыФормированияПакета);
				ДополнительныеПараметры.Вставить("УчетнаяЗапись",                                                      УчетнаяЗапись);
				ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",                                         ЭтоРегламентированныйОтчет);
				ДополнительныеПараметры.Вставить("ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале", ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале);
				ДополнительныеПараметры.Вставить("АвторизацияПроизведена",                                             АвторизацияПроизведена);
				ДополнительныеПараметры.Вставить("АвторизацияПодготовлена",                                            АвторизацияПодготовлена);
				ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",                                                   ЭтоВызовИзСписка);
				ДополнительныеПараметры.Вставить("ПодписанныйПакетДляАвторизацииТребуется",                            ПодписанныйПакетДляАвторизацииТребуется);
				
				Оповещение = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервереПослеФормированияПодписанногоПакетаДляПортала", ЭтотОбъект, ДополнительныеПараметры);
				
				СформироватьПодписанныйПакетДляПорталаФСРАР(
					МестоХраненияКлюча,
					УчетнаяЗапись,
					ПодписываемыеДанные,
					ПараметрыФормированияПакета.СертификатАбонента,
					Оповещение,
					Крипт,
					СлучайныйКлюч,
					ЗначениеCAPTCHA);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПодписанныйПакетДляАвторизацииТребуется И НЕ ЗначениеЗаполнено(ПодписанныйПакетДляАвторизации) Тогда
			АвторизацияПодготовлена = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПодготовкиАвторизации(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		ПодписанныйПакетДляАвторизации,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		АвторизацияПодготовлена,
		ЭтоВызовИзСписка);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССОтправкаВЦикле(
		МестоХраненияКлюча,
		АдресСервера,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		НастройкиОтправки,
		НомерПопытки = 1)
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеВыгрузкиПакетаЗавершение(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОрганизацияСсылка 				= НастройкиОтправки.ОрганизацияСсылка;
	ОтчетСсылка 					= НастройкиОтправки.ОтчетСсылка;
	ПоляДляЗаписиОтправки 			= НастройкиОтправки.ПоляДляЗаписиОтправки;
	Форма 							= НастройкиОтправки.Форма;
	ЭтоОтправкаИзФормыОтчетность 	= НастройкиОтправки.ЭтоОтправкаИзФормыОтчетность;
	ТипОтправляемогоДокумента 		= НастройкиОтправки.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 		= НастройкиОтправки.ВидОтправляемогоДокумента;
	ПодписанныйSOAP64 				= НастройкиОтправки.ПодписанныйSOAP64;
	МЧД 							= НастройкиОтправки.МЧД;
	ОповещениеОЗавершении 			= НастройкиОтправки.ОповещениеОЗавершении;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	ПовторятьСоединение = Истина;
	ПараметрыОтправкиНаСервере = Новый Структура;
	ПараметрыОтправкиНаСервере.Вставить("АдресСервера", 				АдресСервера);
	ПараметрыОтправкиНаСервере.Вставить("РазделениеВключено", 			Неопределено);
	ПараметрыОтправкиНаСервере.Вставить("ПоляДляЗаписиОтправки", 		ПоляДляЗаписиОтправки);
	ПараметрыОтправкиНаСервере.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
	ПараметрыОтправкиНаСервере.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
	ПараметрыОтправкиНаСервере.Вставить("ПодписанныйSOAP64", 			ПодписанныйSOAP64);
	ПараметрыОтправкиНаСервере.Вставить("МЧД", 							МЧД);
	НоваяОтправкаСсылка = ОтправитьВФССНаСервере(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		ОтчетСсылка,
		ПовторятьСоединение,
		ПараметрыОтправкиНаСервере);
	
	Если ЗначениеЗаполнено(НоваяОтправкаСсылка) Тогда
		Если ЭтоПодписьИШифрованиеSOAP Тогда
			АдресЗашифрованногоОтветаSOAP = НоваяОтправкаСсылка;
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("АдресСервера", 						ПараметрыОтправкиНаСервере.АдресСервера);
			ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета", 				КороткоеИмяФайлаПакета);
			ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки", 			СтрокаBase64ФайлаОтправки);
			ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета", 			СтрокаBase64ФайлаПакета);
			ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 					ОрганизацияСсылка);
			ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
			ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 				ПараметрыОтправкиНаСервере.ПоляДляЗаписиОтправки);
			ДополнительныеПараметры.Вставить("Форма", 								Форма);
			ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
			ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
			ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
			ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", 					ПодписанныйSOAP64);
			ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("НомерПопытки", 						НомерПопытки);
			ДополнительныеПараметры.Вставить("АдресЗашифрованногоОтветаSOAP", 		АдресЗашифрованногоОтветаSOAP);
			КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеОтправкиSOAP",
				ЭтотОбъект, ДополнительныеПараметры);
			
			ЗаписыватьОшибкиВЖурналРегистрации 	= Истина;

			ПроверитьПодписьSOAPОтветаЭЛНВФСС(
				ОписаниеОповещения,
				ОрганизацияСсылка,
				АдресЗашифрованногоОтветаSOAP,,
				ЗаписыватьОшибкиВЖурналРегистрации,
				?(ЭтоПодтверждениеВидаДеятельности, "ПодтверждениеВидаДеятельности",
					?(ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
					"РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам", "")));
			
		Иначе
			ПараметрыАвтозапроса = Новый Структура();
			ПараметрыАвтозапроса.Вставить("Ключ", НоваяОтправкаСсылка);
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
		
			ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСС.
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли ПовторятьСоединение Тогда
		
		// не получено файла результата при отправке пакета. Возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("АдресСервера", 						ПараметрыОтправкиНаСервере.АдресСервера);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета", 				КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки", 			СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета", 			СтрокаBase64ФайлаПакета);
		ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 					ОрганизацияСсылка);
		ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 				ПараметрыОтправкиНаСервере.ПоляДляЗаписиОтправки);
		ДополнительныеПараметры.Вставить("Форма", 								Форма);
		ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
		ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
		ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", 					ПодписанныйSOAP64);
		ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("НомерПопытки", 						НомерПопытки);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПоказаОшибкиДоступаВИнтернет",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		Если ПараметрыОтправкиНаСервере.РазделениеВключено Тогда
			ПовторитьПопытку = (НомерПопытки < 5);
			Если НЕ ПовторитьПопытку Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1). Возможно, сервер перегружен. Попробуйте повторить отправку через некоторое время.';
						|en = 'Не удалось обратиться к серверу ФСС РФ (http://%1). Возможно, сервер перегружен. Попробуйте повторить отправку через некоторое время.'"),
					ПараметрыОтправкиНаСервере.АдресСервера);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			КонецЕсли;
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ПовторитьПопытку);
			
		Иначе
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1)';
					|en = 'Не удалось обратиться к серверу ФСС РФ (http://%1)'"),
				ПараметрыОтправкиНаСервере.АдресСервера);
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(ТекстСообщения, ОписаниеОповещения);
		КонецЕсли;
		Возврат;
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСС. Нет доступа в Интернет.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеОтправкиSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	КороткоеИмяФайлаПакета 				= ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	СтрокаBase64ФайлаПакета 			= ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	ОрганизацияСсылка 					= ДополнительныеПараметры.ОрганизацияСсылка;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	ПодписанныйSOAP64 					= ДополнительныеПараметры.ПодписанныйSOAP64;
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	АдресЗашифрованногоОтветаSOAP 		= ДополнительныеПараметры.АдресЗашифрованногоОтветаSOAP;
	
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ошибка при расшифровке результата отправки в ФСС.';
							|en = 'Ошибка при расшифровке результата отправки в ФСС.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();// ФCC.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Записываем сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись результатов отправки недействительна.';
							|en = 'Подпись результатов отправки недействительна.'");
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами.';
				|en = 'Электронный документооборот с контролирующими органами.'") + " " + ?(ЭтоПодтверждениеВидаДеятельности,
				НСтр("ru = 'Подтверждение вида деятельности ФСС';
					|en = 'Подтверждение вида деятельности ФСС'"), ?(ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
				НСтр("ru = 'Реестр стимулирующих выплат медицинским и социальным работникам';
					|en = 'Реестр стимулирующих выплат медицинским и социальным работникам'"), НСтр("ru = 'Реестр ЭЛН';
																									|en = 'Реестр ЭЛН'"))),
			"Ошибка",
			ТекстОшибки,,
			Истина);
	КонецЕсли;
	
	ПараметрыРезультата = Новый Структура;
	ПараметрыРезультата.Вставить("АдресРасшифрованногоОтветаSOAP", 			Результат.АдресРасшифрованногоОтветаSOAP);
	ПараметрыРезультата.Вставить("АдресЗашифрованногоОтветаSOAP", 			АдресЗашифрованногоОтветаSOAP);
	ПараметрыРезультата.Вставить("ПоляДляЗаписиОтправки", 					ПоляДляЗаписиОтправки);
	ПараметрыРезультата.Вставить("СохранятьАдресРасшифрованногоОтветаSOAP", ОповещениеОЗавершении <> Неопределено);
	ПараметрыРезультата.Вставить("ПодписанныйSOAP64", 						ПодписанныйSOAP64);
	
	Если ЭтоПодтверждениеВидаДеятельности Тогда
		РезультатОтправки = ОбработатьРезультатОтправкиПриОперацииСОКВЭДНаСервере(
			ОтчетСсылка,
			ОрганизацияСсылка,
			МестоХраненияКлюча,
			КороткоеИмяФайлаПакета,
			СтрокаBase64ФайлаПакета,
			ПараметрыРезультата);
			
	ИначеЕсли ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		РезультатОтправки = ОбработатьРезультатОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникамНаСервере(
			ОтчетСсылка,
			ОрганизацияСсылка,
			МестоХраненияКлюча,
			КороткоеИмяФайлаПакета,
			СтрокаBase64ФайлаПакета,
			ПараметрыРезультата);
		
	Иначе
		РезультатОтправки = ОбработатьРезультатОтправкиРеестраЭЛННаСервере(
			ОтчетСсылка,
			ОрганизацияСсылка,
			МестоХраненияКлюча,
			КороткоеИмяФайлаПакета,
			СтрокаBase64ФайлаПакета,
			ПараметрыРезультата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатОтправки.НоваяОтправкаСсылка) Тогда
		Если ЭтоПодтверждениеВидаДеятельности И РезультатОтправки.СтатусОтправки =
			ПредопределенноеЗначение("Перечисление.СтатусыОтправки.Отправлен") Тогда
			
			ПараметрыАвтозапроса = Новый Структура();
			ПараметрыАвтозапроса.Вставить("Ключ", РезультатОтправки.НоваяОтправкаСсылка);
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
			ДополнительныеПараметры.Вставить("ЭтоПромежуточныйПротокол", Истина);
			
			ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСС.
			
		Иначе
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий(); // ФСС.
			
			// Отобразить появление новой записи в журнале обмена
			ПараметрыОповещения = Новый Структура();
			ПараметрыОповещения.Вставить("Ссылка", 		ОтчетСсылка);
			ПараметрыОповещения.Вставить("Организация", ОрганизацияСсылка);
			
			Оповестить("Запись_ОтправкиФСС", ПараметрыОповещения, РезультатОтправки.НоваяОтправкаСсылка);
			
			Если Форма <> Неопределено И НЕ ЭтоОтправкаИзФормыОтчетность Тогда
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ОбновитьПанельСостоянияОтправкиВРегламентированномОтчете(
					Форма,
					"ФСС");
			КонецЕсли;
			
			Если ЭтоПодтверждениеВидаДеятельности ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам
				ИЛИ ТипЗнч(ОтчетСсылка) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
				
				ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(РезультатОтправки.НоваяОтправкаСсылка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПоказаОшибкиДоступаВИнтернет(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	АдресСервера 						= ДополнительныеПараметры.АдресСервера;
	КороткоеИмяФайлаПакета 				= ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	СтрокаBase64ФайлаОтправки 			= ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	СтрокаBase64ФайлаПакета 			= ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	ОрганизацияСсылка 					= ДополнительныеПараметры.ОрганизацияСсылка;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	ПодписанныйSOAP64 					= ДополнительныеПараметры.ПодписанныйSOAP64;
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	МЧД 								= ДополнительныеПараметры.МЧД;
	НомерПопытки 						= ДополнительныеПараметры.НомерПопытки;
	
	ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	Если ПовторятьСоединение Тогда
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("ОрганизацияСсылка", 			ОрганизацияСсылка);
		НастройкиОтправки.Вставить("ОтчетСсылка", 					ОтчетСсылка);
		НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 		ПоляДляЗаписиОтправки);
		НастройкиОтправки.Вставить("Форма", 						Форма);
		НастройкиОтправки.Вставить("ЭтоОтправкаИзФормыОтчетность", 	ЭтоОтправкаИзФормыОтчетность);
		НастройкиОтправки.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
		НастройкиОтправки.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
		НастройкиОтправки.Вставить("ПодписанныйSOAP64", 			ПодписанныйSOAP64);
		НастройкиОтправки.Вставить("МЧД", 							МЧД);
		НастройкиОтправки.Вставить("ОповещениеОЗавершении", 		ОповещениеОЗавершении);
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССОтправкаВЦикле(
			МестоХраненияКлюча,
			АдресСервера,
			КороткоеИмяФайлаПакета,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаПакета,
			НастройкиОтправки,
			НомерПопытки + 1);
		
	Иначе
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСС. Нет доступа в Интернет.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколОбработкиПоСсылкеИсточника(КонтролирующийОрган, ИсточникСсылка) Экспорт
	
	Если КонтролирующийОрган = "ФСС" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС") Тогда
		ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "ФСРАР" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСРАР") Тогда
		ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСРАР(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "РПН" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН") Тогда
		ПоказатьПротоколОбработкиПоСсылкеИсточникаДляРПН(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "ФТС" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФТС") Тогда
		ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФТС(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "УдалитьБанкРоссии" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.УдалитьБанкРоссии") Тогда
		МодульУдалитьДокументооборотСБанкомРоссииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УдалитьДокументооборотСБанкомРоссииКлиент");
		МодульУдалитьДокументооборотСБанкомРоссииКлиент.ПоказатьПротокол(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "Минобороны" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.Минобороны") Тогда
		МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
		МодульДокументооборотСМинобороныКлиент.ПоказатьПротокол(ИсточникСсылка);
		
	ИначеЕсли КонтролирующийОрган = "РЭЦ" ИЛИ КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РЭЦ") Тогда
		МодульДокументооборотСРЭЦКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСРЭЦКлиент");
		МодульДокументооборотСРЭЦКлиент.ПоказатьПротокол(ИсточникСсылка);
		
	Иначе
		ПоказатьДокументыЦикловОбмена(ИсточникСсылка, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(ИсточникСсылка, ПечатьВозможна = Истина) Экспорт
	
	ВАрхиве = ОбъектВАрхиве(ИсточникСсылка, "Протокол");
	Если ВАрхиве Тогда 
		ПоказатьУведомлениеАрхивныхФайлов(, 16, 0, Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ИсточникСсылка",      ИсточникСсылка);
	ПараметрыФормы.Вставить("ПечатьВозможна",      ПечатьВозможна);
