&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетПФР(Контекст, ВыполняемоеОповещение)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Отчет = Контекст.Документ;
	ИмяМетаданныхДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ИмяМетаданныхДокумента = "РегламентированныйОтчет" Тогда
		
		Результат = Новый Массив;
		
		ЭтоКомплектыРСВ1 = (Контекст.ИсточникОтчета = "РегламентированныйОтчетРСВ1" И ТипЗнч(Контекст.ДатаНачалаПериодаОтчета) = Тип("Дата") И Контекст.ДатаНачалаПериодаОтчета >= '20140101000000');
		
		// особая обработка для РСВ-1 - форма должна отправляться из АДВ-6-2
		Если Контекст.ИсточникОтчета = "РегламентированныйОтчетРСВ1" И ЭтоПервичныйОтчет(Отчет) И НЕ ЭтоКомплектыРСВ1 Тогда
			ТекстВопроса = "В соответствии с требованиями Пенсионного фонда Российской Федерации представление файлов отчетности
				|в электронной форме по страховым взносам и персонифицированному учету с 1 апреля 2011 года,
				|включая отчетность за первый квартал 2011 года, в обязательном порядке осуществляется одновременно и
				|одним отправлением.
				|
				|Используйте форму документа ""Опись сведений АДВ-6-2"" для совместной отправки.
				|
				|Продолжить действие БЕЗ ПРИВЯЗКИ к отчетности по персонифицированному учету (не рекомендуется)?";
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Контекст", Контекст);
			ДополнительныеПараметры.Вставить("Отчет", Отчет);
			ДополнительныеПараметры.Вставить("Результат", Результат);
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("ЭтоКомплектыРСВ1", ЭтоКомплектыРСВ1);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПродолжитьВыгрузкуРеглОтчетаПФРЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Внимание!");
		Иначе
			ВыгрузитьРегламентированныйОтчетПФРПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение, ЭтоКомплектыРСВ1)
		КонецЕсли;
		
	
	ИначеЕсли ИмяМетаданныхДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		
		Результат = ВыгрузитьРегламентированныйОтчетПФРИзВнешнихЭлектронныхПредставлений(Контекст);
		ВсегоВАрхиве = 0;
		Для Каждого Запись Из Результат Цикл
			Если Запись.ВАрхиве Тогда
				ВсегоВАрхиве = ВсегоВАрхиве + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсегоВАрхиве > 0 Тогда //Данные одного или более файлов отсутствуют
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Контекст", Контекст);
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПродолжитьВыгрузкуРеглОтчетаПФРНеудача", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьУведомлениеАрхивныхФайлов(ОписаниеОповещения, 24, 2, Истина);			
			
			Возврат;
			
		КонецЕсли;
	
		Контекст.Вставить("РезультатВыгрузки", Результат);
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
		
	ИначеЕсли ИмяМетаданныхДокумента = "ЗаявленияПоЭлДокументооборотуСПФР" Тогда
		
		Контекст.Вставить("РезультатВыгрузки", ВыгрузитьЗаявленияПоЭлДокументооборотуСПФР(Отчет));
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
		
	ИначеЕсли ИмяМетаданныхДокумента = "УведомлениеОПредоставленииПолномочийПредставителю" Тогда
		
		Контекст.Вставить("РезультатВыгрузки", ВыгрузитьУведомлениеОПредоставленииПолномочийПредставителю(Отчет));
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		Если НЕ Контекст.РезультатВыгрузки = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
		КонецЕсли;
		
	ИначеЕсли ИмяМетаданныхДокумента = "УведомлениеОПрекращенииПолномочийПредставителя" Тогда
		
		Контекст.Вставить("РезультатВыгрузки", ВыгрузитьУведомлениеОПрекращенииПолномочийПредставителя(Отчет));
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
		
	Иначе
		
		Результат = Новый Массив;
		
		СвойстваФайлаВыгрузки = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ВыгрузитьДокументСервер(
			Отчет,
			Контекст.УникальныйИдентификатор);
		Если НЕ ЗначениеЗаполнено(СвойстваФайлаВыгрузки) Тогда
			РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
			
			Возврат;
			
		КонецЕсли;
		
		// заполняем результат
		Если ТипЗнч(СвойстваФайлаВыгрузки) = Тип("Структура") Тогда
			ТекстВыгрузки = СвойстваФайлаВыгрузки.АдресФайлаВыгрузки;
			ИмяФайлаВыгрузки = СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки;
			ТипФайлаОтчетности = СвойстваФайлаВыгрузки.ТипФайлаВыгрузки;
			ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес", Отчет, ТипПоИдентификаторуТипаФайлаВыгрузки(ТипФайлаОтчетности), СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки, СвойстваФайлаВыгрузки.АдресФайлаВыгрузки);
			Результат.Добавить(ОписательОтчета);
		Иначе
			Для Инд = 0 По СвойстваФайлаВыгрузки.Количество() - 1 Цикл
				Результат.Добавить(Новый Структура("Документ, Тип, Имя, Адрес", СвойстваФайлаВыгрузки[Инд].Ссылка,
																					ТипПоИдентификаторуТипаФайлаВыгрузки(СвойстваФайлаВыгрузки[Инд].ТипФайлаВыгрузки),
																					СвойстваФайлаВыгрузки[Инд].ИмяФайлаВыгрузки,
																					СвойстваФайлаВыгрузки[Инд].АдресФайлаВыгрузки));
			КонецЦикла;
		КонецЕсли;
		
		Контекст.Вставить("РезультатВыгрузки", Результат);
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПродолжитьВыгрузкуРеглОтчетаПФРНеудача(Выбор, ДопПараметры) Экспорт
	
	РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", ДопПараметры.Контекст, Ложь);
	ВыполнитьОбработкуОповещения(ДопПараметры.ВыполняемоеОповещение, РезультатВыгрузки);
			
КонецПроцедуры

&НаКлиенте
Процедура ВопросПродолжитьВыгрузкуРеглОтчетаПФРЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Контекст = ДополнительныеПараметры.Контекст;
	Отчет = ДополнительныеПараметры.Отчет;
	Результат = ДополнительныеПараметры.Результат;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЭтоКомплектыРСВ1 = ДополнительныеПараметры.ЭтоКомплектыРСВ1;
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
	Иначе
		ВыгрузитьРегламентированныйОтчетПФРПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение, ЭтоКомплектыРСВ1)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетПФРПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение, ЭтоКомплектыРСВ1)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// выгружаем отчет
	ТекстВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	КодировкаФайлаВыгрузки = Неопределено;
	ЭлементыВыгрузки = Неопределено;
	РезультатВыгрузки = СдачаОтчетностиЧерезСервисСпецоператораКлиент.ВыгрузитьРегламентированныйОтчет(Отчет, Ложь, ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайлаВыгрузки, , ЭлементыВыгрузки, Контекст.УникальныйИдентификатор, ЭтоКомплектыРСВ1);
	Если НЕ РезультатВыгрузки Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1Отправка отчета прервана.';
				|en = '%1Отправка отчета прервана.'"), ИнформацияОбОшибке().Описание + Символы.ПС);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыгрузкиПФР = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузкиПФР);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстВыгрузки) И ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") И ИмяФайлаВыгрузки.Количество() = 1
		И ТипЗнч(ЭлементыВыгрузки) = Тип("Массив") И ЭлементыВыгрузки.Количество() > 0 И ТипЗнч(ЭлементыВыгрузки[0]) = Тип("Структура") Тогда
		
		АдресВоВременномХранилище = ЭлементыВыгрузки[0].АдресФайлаВыгрузки;
		
		ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес", Отчет, СтруктураСсылочныхДанных.Перечисления_ТипыФайловОтчетностиПФР_ПачкаРСВ, ИмяФайлаВыгрузки[0], АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
		
	ИначеЕсли ЭтоКомплектыРСВ1 Тогда
		
		МассивТекстовВыгрузки = ?(ЗначениеЗаполнено(ТекстВыгрузки), ТекстВыгрузки, ЭлементыВыгрузки);
		МассивИменФайловВыгрузки = ИмяФайлаВыгрузки;
		
		Для ИндексВыгрузки = 0 По МассивТекстовВыгрузки.ВГраница() Цикл
			ТекстВыгрузки = МассивТекстовВыгрузки[ИндексВыгрузки];
			ИмяФайлаВыгрузки = МассивИменФайловВыгрузки[ИндексВыгрузки];
			
			// пишем файл во временное хранилище
			КодировкаФайла = "windows-1251";
			АдресВоВременномХранилище = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла, Контекст.УникальныйИдентификатор);
			
			// заполняем результат
			ОпределитьТипПоСодержимому = (ИндексВыгрузки <> 0);
			ТипыФайловОтчетностиПФР = ?(НЕ ОпределитьТипПоСодержимому, СтруктураСсылочныхДанных.Перечисления_ТипыФайловОтчетностиПФР_ПачкаРСВ, Неопределено);
			ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес, ОпределитьТипПоСодержимому", Отчет, ТипыФайловОтчетностиПФР, ИмяФайлаВыгрузки, АдресВоВременномХранилище, ОпределитьТипПоСодержимому);
			Результат.Добавить(ОписательОтчета);
		КонецЦикла;
		
	Иначе
		
		// пишем файл во временное хранилище
		КодировкаФайла = "windows-1251";
		АдресВоВременномХранилище = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла, Контекст.УникальныйИдентификатор);
		
		// заполняем результат
		ОписательОтчета = Новый Структура("Документ, Тип, Имя, Адрес", Отчет, СтруктураСсылочныхДанных.Перечисления_ТипыФайловОтчетностиПФР_ПачкаРСВ, ИмяФайлаВыгрузки, АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
		
	КонецЕсли;
	
	Контекст.Вставить("РезультатВыгрузки", Результат);
	РезультатВыгрузкиПФР = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузкиПФР);
	
	
КонецПроцедуры

&НаКлиенте
Процедура Отправка_СформироватьПакет(ОповещениеОЗавершении, ТранспортноеСообщение, КонтролирующийОрган, ПараметрыОперации = Неопределено)
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется формирование пакета для отправки..."); // ФНС, ПФР, ФСГС, СОС, ЦБ
	
	// готовим пакет
	Если КонтролирующийОрган = "ФНС" Тогда
		СформироватьПакетФНС(ОповещениеОЗавершении, ТранспортноеСообщение,, ПараметрыОперации);
	ИначеЕсли КонтролирующийОрган = "ПФР" Тогда
		СформироватьПакетПФР(ОповещениеОЗавершении, ТранспортноеСообщение,, ПараметрыОперации);
	ИначеЕсли КонтролирующийОрган = "ФСГС" Тогда
		СформироватьПакетФСГС(ОповещениеОЗавершении, ТранспортноеСообщение,, ПараметрыОперации);
	ИначеЕсли КонтролирующийОрган = "СОС" Тогда
		СформироватьПакетСОС(ОповещениеОЗавершении, ТранспортноеСообщение,, ПараметрыОперации);
	ИначеЕсли КонтролирующийОрган = "ЦБ" Тогда
		СформироватьПакетЦБ(ОповещениеОЗавершении, ТранспортноеСообщение,, ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

#Область ОтправкаРегламентированногоОтчетаВПФР

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФР(Док, ВыполняемоеОповещение) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Док",                   Док);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФРПослеПодтвержденияПовторнойОтправки",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПодтвердитьПовторнуюОтправку(Док, "ПФР", ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФРПослеПодтвержденияПовторнойОтправки(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	
	// готовимся к выгрузке
	Если НЕ ОтправкаРегламентированногоОтчетаВПФР_ПередВыгрузкойФайла(КонтекстОтправки, Док, УникальныйИдентификатор) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаРегламентированногоОтчетаВПФР_ПослеПроверкиЗаявления",
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Ложь); //+
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР

		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Ложь); //+
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	// выгружаем отчет и доверенность, при необходимости
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаРегламентированногоОтчетаВПФРПослеВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
	ВыгрузитьРегламентированныйОтчетПФР(КонтекстОтправки, ОписаниеОповещения)// клиент
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФРПослеВыгрузки(Результат, ВходящийКонтекст) Экспорт
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
			
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	РезультатВыгрузки     = Результат.РезультатВыгрузки;
	КонтекстОтправки      = Результат.Контекст; // Обновленный по результатам выгрузки контекст.
	
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Если НЕ РезультатВыгрузки Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;

	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФРПослеПроверкиСоответствияОрганизации",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	РезультатВыгрузкиОтчетности = КонтекстОтправки.РезультатВыгрузки;
	
	Если КонтекстОтправки.ТипОтправляемогоДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов"
		И РезультатВыгрузкиОтчетности.Количество() > 0 Тогда
		
		РегНомерСФРИлиПФРФайла = ДокументооборотСКОКлиентСервер.ИзвлечьРегистрационныйНомерСФРИлиПФРИзИмениФайла(
			РезультатВыгрузкиОтчетности[0].Имя);
		РегНомерСФР = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КонтекстОтправки, "РегНомерСФР");
		Если РегНомерСФРИлиПФРФайла <> Неопределено И РегНомерСФРИлиПФРФайла <> КонтекстОтправки.РегНомерПФР
			И РегНомерСФРИлиПФРФайла <> РегНомерСФР Тогда
			
			Если СтрДлина(СокрЛП(РегНомерСФРИлиПФРФайла)) = 10 И (ЗначениеЗаполнено(РегНомерСФР)
				ИЛИ НЕ ЗначениеЗаполнено(КонтекстОтправки.РегНомерПФР)) Тогда
				
				ТекстВопроса = НСтр("ru = 'Регистрационный номер СФР в имени файла отчета ""%1"" отличается
										  |от регистрационного номера СФР в свойствах организации ""%2"".';
										  |en = 'Регистрационный номер СФР в имени файла отчета ""%1"" отличается
										  |от регистрационного номера СФР в свойствах организации ""%2"".'");
				ТекстВопроса = СтрШаблон(ТекстВопроса, РегНомерСФРИлиПФРФайла, РегНомерСФР);
				
			Иначе
				ТекстВопроса = НСтр("ru = 'Регистрационный номер ПФР в имени файла отчета ""%1"" отличается
										  |от регистрационного номера ПФР в свойствах организации ""%2"".';
										  |en = 'Регистрационный номер ПФР в имени файла отчета ""%1"" отличается
										  |от регистрационного номера ПФР в свойствах организации ""%2"".'");
				
				ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
					КонтекстОтправки.Документ,,, ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ПФР"));
				ТекстВопроса = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстВопроса, Истина,, НЕ ЭтоОтправкаВСФР);
				ТекстВопроса = СтрШаблон(ТекстВопроса, РегНомерСФРИлиПФРФайла, КонтекстОтправки.РегНомерПФР);
			КонецЕсли;
			
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(, Истина) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ТекстВопроса);
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Нет);
				Возврат;
			Иначе
				
				ТекстВопроса = ТекстВопроса + Символы.ПС + НСтр("ru = 'Продолжить отправку?';
																|en = 'Продолжить отправку?'");
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
				Возврат;
		КонецЕсли;
	КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФРПослеПроверкиСоответствияОрганизации(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	КонтекстОтправки      = ВходящийКонтекст.КонтекстОтправки;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФРПослеПодтвержденияДляПеречня",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	// проверяем наличие перечня льготных профессий
	ПрефиксИмениФайлаПеречняЛьготныхПрофессий = "PERECH-";
	ДлинаПрефиксаИмениФайлаПеречняЛьготныхПрофессий = СтрДлина(ПрефиксИмениФайлаПеречняЛьготныхПрофессий);
	РезультатВыгрузкиОтчетности = КонтекстОтправки.РезультатВыгрузки;
	
	Для каждого СтрРезультатВыгрузкиОтчетности Из РезультатВыгрузкиОтчетности Цикл
		ПрефиксИмениОтчета = Лев(СтрРезультатВыгрузкиОтчетности.Имя, ДлинаПрефиксаИмениФайлаПеречняЛьготныхПрофессий);
		
		Если ВРег(ПрефиксИмениОтчета) = ПрефиксИмениФайлаПеречняЛьготныхПрофессий
			И (СтрРезультатВыгрузкиОтчетности.Тип <>
			ПредопределенноеЗначение("Перечисление.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР")
			ИЛИ РезультатВыгрузкиОтчетности.Количество() = 1) Тогда
			
			ТекстВопроса = НСтр("ru = 'Не рекомендуется отправка перечня льготных профессий в качестве основного документа.
									  |Выполнить отправку перечня льготных профессий можно в разделе ""Письма"" 1С-Отчетности, приложив файл к письму в ПФР.
									  |
									  |Продолжить отправку (отчет может быть не принят ПФР)?';
									  |en = 'Не рекомендуется отправка перечня льготных профессий в качестве основного документа.
									  |Выполнить отправку перечня льготных профессий можно в разделе ""Письма"" 1С-Отчетности, приложив файл к письму в ПФР.
									  |
									  |Продолжить отправку (отчет может быть не принят ПФР)?'");
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФРПослеПодтвержденияДляПеречня(Результат, ВходящийКонтекст) Экспорт
	
	Документ = ВходящийКонтекст.КонтекстОтправки.Документ;
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФР_ПослеПроверкиЗаключенногоСоглашенияСПФР", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	Организация = ВходящийКонтекст.КонтекстОтправки.Организация;
	ПроверитьЧтоЗаключеноСоглашениеСПФР(Документ, Организация, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФР_ПослеПроверкиЗаключенногоСоглашенияСПФР(Результат, ВходящийКонтекст) Экспорт
	
	Документ = ВходящийКонтекст.КонтекстОтправки.Документ;
	
	Если Результат <> Истина Тогда
		
		ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФРПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ВходящийКонтекст);
		
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Документ", Документ);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Документ;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;	
		
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ПФР
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВПФРПослеВыгрузки",  0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВПФРПослеВыгрузки() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
