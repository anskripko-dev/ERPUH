				Если ЗначениеЗаполнено(ФорматПротоколаНаименееУспешнойПроверки) Тогда
					НовСтрТаблицыРезультатовПоДокументам.ТипПротокола = ФорматПротоколаНаименееУспешнойПроверки;
				КонецЕсли;
				Если ЗначениеЗаполнено(ПризнакУпаковкиПротоколаНаименееУспешнойПроверки) Тогда
					НовСтрТаблицыРезультатовПоДокументам.ПризнакУпаковкиПротокола = ПризнакУпаковкиПротоколаНаименееУспешнойПроверки;
				КонецЕсли;
				НовСтрТаблицыРезультатовПоДокументам.РезультатПроверки = РезультатНаименееУспешнойПроверки;
				НовСтрТаблицыРезультатовПоДокументам.РезультатПроверкиСтр = РезультатНаименееУспешнойПроверкиСтр;
				НовСтрТаблицыРезультатовПоДокументам.КодПрограммыПроверки = КодПрограммыНаименееУспешнойПроверки;
				НовСтрТаблицыРезультатовПоДокументам.ПрограммаПроверки = ПрограммаНаименееУспешнойПроверки;
				
			КонецЦикла;
			
			РезультатыПоДокументам = ПоместитьВоВременноеХранилище(ТаблицаРезультатовПоДокументам, Контекст.УникальныйИдентификатор);
			
			Результат.Вставить("РезультатыПоДокументам", РезультатыПоДокументам);
			
		КонецЕсли;
		
		// добавляем имеющиеся протоколы в результат
		УзлыПротокол = УзелОтвет.Строки.НайтиСтроки(Новый Структура("Имя", "Протокол"));
		
		КоличествоПротоколов = УзлыПротокол.Количество();
		Результат.Вставить("КоличествоПротоколов", КоличествоПротоколов);
		
		Для ИндексПротокола = 0 По КоличествоПротоколов - 1 Цикл
			УзелПротокол = УзлыПротокол[ИндексПротокола];
			НомерПротоколаСтр = Формат(ИндексПротокола + 1, "ЧН=0; ЧГ=");
			
			ПротоколBase64 = XMLЗначениеВнутр(Тип("Строка"), УзелПротокол.Значение);
			Результат.Вставить("Протокол" + НомерПротоколаСтр, ПротоколBase64);
			
			АтрибутыУзлаПротокол = ПолучитьАтрибутыУзла(УзелПротокол);
			ИмяФайлаПротокола = АтрибутыУзлаПротокол.ИмяФайлаПротоколаПроверки;
			Результат.Вставить("ИмяФайлаПротокола" + НомерПротоколаСтр, ИмяФайлаПротокола);
			
			Результат.Вставить("ПризнакУпаковкиПротокола" + НомерПротоколаСтр, ПризнакиУпаковкиПротоколов[нрег(СокрЛП(ИмяФайлаПротокола))]);
		КонецЦикла;
		
	КонецЕсли;
	
	// инициализируем структуру-результат
	Результат.Вставить("Результат", ПризнакУспешнойПроверки);
	Результат.Вставить("КодРезультата", КодЗавершения);
	Результат.Вставить("ПредставлениеРезультата", ПредставлениеРезультата);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоместитьВоВременноеХранилищеЕслиСуществует(ИмяФайла, Адрес, ПоместитьКакДвоичныеДанные = Ложь)
	
	ОбъектФайл = Новый Файл(ИмяФайла);
	Если НЕ ОбъектФайл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеФайла = ИмяФайла;
	Если ПоместитьКакДвоичныеДанные Тогда
		ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, Адрес);
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьРезультатОтСервераОнлайнПроверки_РаспаковатьРасшифрованныйРезультатНаСервере(Контекст)
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		
		// сохраняем протокол во временный файл
		ФайлАрхиваСПротоколом64 = Контекст.ФайлАрхиваСПротоколом64;
		ДвоичныеДанныеФайлаАрхиваСПротоколом = ДвоичныеДанныеИзСтроки64НаСервере(ФайлАрхиваСПротоколом64);
		ИмяФайлаАрхиваСПротоколом = ПолучитьИмяВременногоФайла("zip");
		ДвоичныеДанныеФайлаАрхиваСПротоколом.Записать(ИмяФайлаАрхиваСПротоколом);
		
		// 
		КаталогПротоколов = Разархивировать(ИмяФайлаАрхиваСПротоколом);
		ФайлыПротоколов = ФайлыКаталога(КаталогПротоколов);
		Если НЕ ЗначениеЗаполнено(ФайлыПротоколов) Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.';
									|en = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		
		// разбор результатов при универсальном формате
		
		ФайлыПротоколов = Новый Массив();
		Для ИндексПротокола = 0 ПО Контекст.Результат.КоличествоПротоколов - 1 Цикл
			НомерПротокола = Формат(ИндексПротокола + 1, "ЧН=0; ЧГ=");
			
			ФайлАрхиваСПротоколом64 = Неопределено;
			Если НЕ Контекст.Свойство("ФайлBase64АрхиваСПротоколом" + НомерПротокола, ФайлАрхиваСПротоколом64) Тогда
				ТекстСообщения = НСтр("ru = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.';
										|en = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			
			ИмяФайлаПротокола = Неопределено;
			Контекст.Результат.Свойство("ИмяФайлаПротокола" + НомерПротокола, ИмяФайлаПротокола);
			
			ПризнакУпаковкиПротокола = Неопределено;
			Контекст.Результат.Свойство("ПризнакУпаковкиПротокола" + НомерПротокола, ПризнакУпаковкиПротокола);
			
			Если ЗначениеЗаполнено(ФайлАрхиваСПротоколом64) Тогда
				Если ПризнакУпаковкиПротокола = Истина Тогда
					// сохраняем протокол во временный файл
					ДвоичныеДанныеФайлаАрхиваСПротоколом = ДвоичныеДанныеИзСтроки64НаСервере(ФайлАрхиваСПротоколом64);
					ИмяФайлаАрхиваСПротоколом = ПолучитьИмяВременногоФайла("zip");
					ДвоичныеДанныеФайлаАрхиваСПротоколом.Записать(ИмяФайлаАрхиваСПротоколом);
					
					//
					КаталогПротоколов = Разархивировать(ИмяФайлаАрхиваСПротоколом);
					ФайлыПротокола = ФайлыКаталога(КаталогПротоколов);
					Если НЕ ЗначениеЗаполнено(ФайлыПротокола) Тогда
						ТекстСообщения = НСтр("ru = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.';
												|en = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности.'");
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						Возврат Ложь;
					КонецЕсли;
					
					Для Каждого ФайлПротокола Из ФайлыПротокола Цикл
						ФайлыПротоколов.Добавить(ФайлПротокола);
					КонецЦикла;
					
				Иначе
					КаталогРазмещения = ПолучитьИмяВременногоФайла();
					КаталогРазмещения = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогРазмещения);
					
					СоздатьКаталог(КаталогРазмещения);
					
					ДвоичныеДанныеФайлаАрхиваСПротоколом = ДвоичныеДанныеИзСтроки64НаСервере(ФайлАрхиваСПротоколом64);
					ДвоичныеДанныеФайлаАрхиваСПротоколом.Записать(КаталогРазмещения + ИмяФайлаПротокола);
					
					ФайлПротокола = Новый Файл(КаталогРазмещения + ИмяФайлаПротокола);
					ФайлыПротоколов.Добавить(ФайлПротокола);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// если протокол один, то определяем свойства протокола в структуре результата
	// для совместимости с ранней реализацией
	Если ФайлыПротоколов.Количество() = 1 Тогда
		
		ФайлПротокола = ФайлыПротоколов[0];
		АдресФайлаПротокола = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлПротокола.ПолноеИмя), Контекст.УникальныйИдентификатор);
		
		// определяем короткое имя файла протокола
		Контекст.Результат.Вставить("ИмяФайлаПротокола", ФайлПротокола.Имя);
		
		// добавляем протокол в результат
		Контекст.Результат.Вставить("Протокол", АдресФайлаПротокола);
		
	КонецЕсли;
	
	// формируем полные пути к файлам протоколов в соотв. колонке таблицы РезультатыПоДокументам
	АдресТаблицыДокументов = Неопределено;
	Если Контекст.Результат.Свойство("РезультатыПоДокументам", АдресТаблицыДокументов) Тогда
		КоличествоПроверокДляУниверсальногоФормата = 0;
		КоличествоПротоколовДляУниверсальногоФормата = 0;
		
		ТаблицаДокументов = ПолучитьИзВременногоХранилища(АдресТаблицыДокументов);
		
		Для Каждого СтрРезультат Из ТаблицаДокументов Цикл
			Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
				
				Если ЗначениеЗаполнено(СтрРезультат.ИмяФайлаПротокола) Тогда
					СтрРезультат.ИмяФайлаПротокола = ПоместитьВоВременноеХранилищеЕслиСуществует(КаталогПротоколов + СтрРезультат.ИмяФайлаПротокола, Контекст.УникальныйИдентификатор, Истина);
				КонецЕсли;
				
			Иначе
				
				// разбор результатов при универсальном формате
				
				ИмяФайлаОсновногоПротокола = Строка(СтрРезультат.ИмяФайлаПротокола);
				ФайлПротоколаНайден = Ложь;
				Если ЗначениеЗаполнено(СтрРезультат.ИмяФайлаПротокола) Тогда
					Для Каждого ФайлПротокола Из ФайлыПротоколов Цикл
						Если СокрЛП(ВРег(ФайлПротокола.Имя)) = СокрЛП(ВРег(СтрРезультат.ИмяФайлаПротокола)) Тогда
							СтрРезультат.ИмяФайлаПротокола = ПоместитьВоВременноеХранилищеЕслиСуществует(ФайлПротокола.ПолноеИмя, Контекст.УникальныйИдентификатор, Истина);
							КоличествоПроверокДляУниверсальногоФормата = КоличествоПроверокДляУниверсальногоФормата + 1;
							КоличествоПротоколовДляУниверсальногоФормата = КоличествоПротоколовДляУниверсальногоФормата + 1;
							ФайлПротоколаНайден = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ ФайлПротоколаНайден Тогда
						СтрРезультат.ИмяФайлаПротокола = Неопределено;
					КонецЕсли;
				КонецЕсли;
				
				ТаблицаРезультатовПроверок = Неопределено;
				Если СтрРезультат.РезультатыПроверок <> Неопределено Тогда
					ТаблицаРезультатовПроверок = ПолучитьИзВременногоХранилища(СтрРезультат.РезультатыПроверок);
					
					Для Каждого РезультатПроверки Из ТаблицаРезультатовПроверок Цикл
						
						Если ЗначениеЗаполнено(РезультатПроверки.ИмяФайлаПротокола) Тогда
							Если СокрЛП(ВРег(РезультатПроверки.ИмяФайлаПротокола)) = СокрЛП(ВРег(ИмяФайлаОсновногоПротокола)) Тогда
								РезультатПроверки.ИмяФайлаПротокола = СтрРезультат.ИмяФайлаПротокола;
							Иначе
								ФайлПротоколаНайден = Ложь;
								Для Каждого ФайлПротокола Из ФайлыПротоколов Цикл
									Если СокрЛП(ВРег(ФайлПротокола.Имя)) = СокрЛП(ВРег(РезультатПроверки.ИмяФайлаПротокола)) Тогда
										РезультатПроверки.ИмяФайлаПротокола = ПоместитьВоВременноеХранилищеЕслиСуществует(ФайлПротокола.ПолноеИмя, Контекст.УникальныйИдентификатор, Истина);
										КоличествоПротоколовДляУниверсальногоФормата = КоличествоПротоколовДляУниверсальногоФормата + 1;
										ФайлПротоколаНайден = Истина;
										Прервать;
									КонецЕсли;
								КонецЦикла;
								Если НЕ ФайлПротоколаНайден Тогда
									РезультатПроверки.ИмяФайлаПротокола = Неопределено;
								КонецЕсли;
								КоличествоПроверокДляУниверсальногоФормата = КоличествоПроверокДляУниверсальногоФормата + ТаблицаРезультатовПроверок.Количество();
							КонецЕсли;
						Иначе
							КоличествоПроверокДляУниверсальногоФормата = КоличествоПроверокДляУниверсальногоФормата + ТаблицаРезультатовПроверок.Количество();
						КонецЕсли;
						
					КонецЦикла;
					
					ПоместитьВоВременноеХранилище(ТаблицаРезультатовПроверок, СтрРезультат.РезультатыПроверок);
				КонецЕсли;
				
				// информация для диалога показа результатов по одиночному отчету
				Если ТаблицаДокументов.Количество() = 1 И КоличествоПротоколовДляУниверсальногоФормата >= 1 Тогда
					Контекст.Результат.Вставить("ИмяФайлаПротокола", СтрРезультат.ИсходноеИмяФайлаПротокола);
					Контекст.Результат.Вставить("Протокол", СтрРезультат.ИмяФайлаПротокола);
					Контекст.Результат.Вставить("ПрограммаПроверки", СтрРезультат.ПрограммаПроверки);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		ПоместитьВоВременноеХранилище(ТаблицаДокументов, АдресТаблицыДокументов);
		
		Контекст.Результат.Вставить("КоличествоПроверокДляУниверсальногоФормата", КоличествоПроверокДляУниверсальногоФормата);
		Контекст.Результат.Вставить("КоличествоПротоколовДляУниверсальногоФормата", КоличествоПротоколовДляУниверсальногоФормата);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиенте(Контекст, ВыполняемоеОповещение)
	
	Результат = Контекст.Результат;
	КодЗавершения = Результат.КодРезультата;
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(Контекст.УчетнаяЗапись);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		
		// получаем протокол
		ПротоколBase64 = Неопределено;
		Если (КодЗавершения = 0 ИЛИ КодЗавершения = 4 ИЛИ КодЗавершения = 6)
			И Результат.Свойство("Protocol", ПротоколBase64) Тогда // получаем строку Base64 зашифрованного протокола
			
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст", ВыполняемоеОповещение, Контекст);
			КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
			Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЗаписиВФайлПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
				ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				ПротоколBase64Адрес = ПоместитьВоВременноеХранилище(ПротоколBase64, ЭтотОбъект.УникальныйИдентификатор);
				ДополнительныеПараметры.Вставить("ПротоколBase64Адрес", ПротоколBase64Адрес);
				
				ПротоколДДАдрес = ДеКодироватьИзBase64СодержимоеНаСервере(ПротоколBase64Адрес, ЭтотОбъект.УникальныйИдентификатор);
				ДополнительныеПараметры.Вставить("ПротоколДДАдрес", ПротоколДДАдрес);
				
				РезультатВыполнения = Новый Структура("Выполнено, ИмяФайла", Истина, ПротоколДДАдрес);
				ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
					Возврат;
				КонецЕсли;
				
				ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПротоколBase64, , Ложь);
			
		ИначеЕсли КодЗавершения = 1 ИЛИ КодЗавершения = 5 Тогда
			
			// получаем строку Base64 сертификата
			СертификатBase64 = Неопределено;
			Если НЕ Результат.Свойство("Certificate", СертификатBase64) Тогда
				Если КодЗавершения = 1 Тогда
					РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
					ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
					Возврат;
				ИначеЕсли КодЗавершения = 5 Тогда
					ТекстСообщения = НСтр("ru = 'Некорректный формат ответа сервера онлайн-проверки: в ответе на запрос о сертификате сервера отсутствуют данные сертификата.';
											|en = 'Некорректный формат ответа сервера онлайн-проверки: в ответе на запрос о сертификате сервера отсутствуют данные сертификата.'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
					ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			// пишем файл сертификата на клиент
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст", ВыполняемоеОповещение, Контекст);
			Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЗаписиФайлаСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
				ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				ИмяФайлаСертификата = ПоместитьВоВременноеХранилищеДанныеСКлиента(СертификатBase64, Контекст.УникальныйИдентификатор);
				РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ИмяФайлаСертификата);
				ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
				Возврат;
			Иначе
				ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СертификатBase64, , Ложь);
			КонецЕсли;
			
		Иначе
			РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		КонецЕсли;
		
	Иначе
		
		// разбор результатов при универсальном формате
		
		КоличествоПротоколов = 0;
		Если НЕ (Результат.Свойство("КоличествоПротоколов", КоличествоПротоколов) И КоличествоПротоколов > 0) Тогда
			РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
			Возврат;
		КонецЕсли;
		
		// преобразовываем протокол в двоичные данные
		СвойстваСертификатаОтправителя = Неопределено;
		РежимСервисаИнициализацияВыполнена = Ложь;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("Контекст", Контекст);
		ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
		ДополнительныеПараметры.Вставить("РежимСервисаИнициализацияВыполнена", РежимСервисаИнициализацияВыполнена);
		ДополнительныеПараметры.Вставить("СвойстваСертификатаОтправителя", СвойстваСертификатаОтправителя);
		ДополнительныеПараметры.Вставить("КоличествоПротоколов", КоличествоПротоколов);
		ДополнительныеПараметры.Вставить("НомерПротокола", 1);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЗаписиВФайлПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКонтейнераПротокола = Результат.ИмяФайла;
	
	// расшифровываем
	//ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст, ИмяФайлаКонтейнераПротокола", ВыполняемоеОповещение, Контекст, ИмяФайлаКонтейнераПротокола);
	
	ДополнительныеПараметры.Вставить("ИмяФайлаКонтейнераПротокола", ИмяФайлаКонтейнераПротокола);
	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеРасшифрованияПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	СертификатРасшифрования = Новый Структура("Отпечаток", Контекст.СертификатОтправителя);
	КонтекстМоделиХраненияКлюча(ДополнительныеПараметры, СертификатРасшифрования);
	
	КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ИмяФайлаКонтейнераПротокола, , СертификатРасшифрования, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеРасшифрованияПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	ИмяФайлаКонтейнераПротокола = ДополнительныеПараметры.ИмяФайлаКонтейнераПротокола;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	// если не удалось распаковать, то прерываемся
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности: не удалось расшифровать протокол.';
								|en = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности: не удалось расшифровать протокол.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаАрхиваСПротоколом = Результат.РасшифрованныйФайл;
	
	// удаляем файл контейнера
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ИмяФайлаКонтейнераПротокола);
	
	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЧтенияФайлаПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ФайлАрхиваСПротоколом64Адрес = КодироватьВBase64СодержимоеНаСервере(Результат.РасшифрованныйФайл, ЭтотОбъект.УникальныйИдентификатор);
		ФайлАрхиваСПротоколом64 = ПолучитьИзВременногоХранилища(ФайлАрхиваСПротоколом64Адрес);
		
		РезультатВыполнения = Новый Структура("Выполнено, СтрокаBase64", Истина, ФайлАрхиваСПротоколом64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ИмяФайлаАрхиваСПротоколом);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЧтенияФайлаПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	
	Если НЕ Результат.Выполнено Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ФайлАрхиваСПротоколом64 = Результат.СтрокаBase64;
	
	Контекст.Вставить("ФайлАрхиваСПротоколом64", ФайлАрхиваСПротоколом64);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст", ВыполняемоеОповещение, Контекст);
	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеПолученияПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеПолученияПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	
	// распаковываем на сервере
	Если НЕ РазобратьРезультатОтСервераОнлайнПроверки_РаспаковатьРасшифрованныйРезультатНаСервере(Контекст) Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеПослеЗаписиФайлаСертификатаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
	КонецЕсли;
	
	ИмяФайлаСертификата = ?(Результат.Выполнено, Результат.ИмяФайла, Неопределено);
	
	// добавляем сертификат в результат
	Контекст.Результат.Вставить("Сертификат", ИмяФайлаСертификата);
	
	РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеЗавершение(РезультатВЦикле, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	РежимСервисаИнициализацияВыполнена = ДополнительныеПараметры.РежимСервисаИнициализацияВыполнена;
	СвойстваСертификатаОтправителя = ДополнительныеПараметры.СвойстваСертификатаОтправителя;
	КоличествоПротоколов = ДополнительныеПараметры.КоличествоПротоколов;
	НомерПротокола = ДополнительныеПараметры.НомерПротокола;
	
	Результат = Контекст.Результат;
	
	Пока НомерПротокола <= КоличествоПротоколов Цикл
		НомерПротоколаСтр = Формат(НомерПротокола, "ЧН=0; ЧГ=");
		НомерПротокола = НомерПротокола + 1;
		
		ПротоколBase64 = Неопределено;
		
		Если НЕ Результат.Свойство("Протокол" + НомерПротоколаСтр, ПротоколBase64) Тогда
			РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПротоколBase64) Тогда
			ФайлАрхиваСПротоколом64 = ПротоколBase64;
			
			Контекст.Вставить("ФайлBase64АрхиваСПротоколом" + НомерПротоколаСтр, ФайлАрхиваСПротоколом64);
			
		Иначе
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("Контекст", Контекст);
			ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
			ДополнительныеПараметры.Вставить("РежимСервисаИнициализацияВыполнена", РежимСервисаИнициализацияВыполнена);
			ДополнительныеПараметры.Вставить("СвойстваСертификатаОтправителя", СвойстваСертификатаОтправителя);
			ДополнительныеПараметры.Вставить("КоличествоПротоколов", КоличествоПротоколов);
			ДополнительныеПараметры.Вставить("НомерПротоколаСтр", НомерПротоколаСтр);
			ДополнительныеПараметры.Вставить("НомерПротокола", НомерПротокола);
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
			
			Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеЗаписиВФайлПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
				
				АдресКонтейнераПротокола = ЗагрузитьДанныеНаСервер(ПротоколBase64, Контекст.УникальныйИдентификатор,, Истина,, Истина); //Входящий Base64 извлечем преобразуем в ДД
				Результат = Новый Структура("Выполнено, ИмяФайла", Истина, АдресКонтейнераПротокола);
				ВыполнитьОбработкуОповещения(Оповещение, Результат);
				
			Иначе
				ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПротоколBase64, , Ложь);
			КонецЕсли;
			Возврат;
			//КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// распаковываем на сервере
	Если НЕ РазобратьРезультатОтСервераОнлайнПроверки_РаспаковатьРасшифрованныйРезультатНаСервере(Контекст) Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Истина, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеЗаписиВФайлПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	РежимСервисаИнициализацияВыполнена = ДополнительныеПараметры.РежимСервисаИнициализацияВыполнена;
	СвойстваСертификатаОтправителя = ДополнительныеПараметры.СвойстваСертификатаОтправителя;
	КоличествоПротоколов = ДополнительныеПараметры.КоличествоПротоколов;
	НомерПротоколаСтр = ДополнительныеПараметры.НомерПротоколаСтр;
	НомерПротокола = ДополнительныеПараметры.НомерПротокола;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКонтейнераПротокола = Результат.ИмяФайла;
	
	// расшифровываем
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("РежимСервисаИнициализацияВыполнена", РежимСервисаИнициализацияВыполнена);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаОтправителя", СвойстваСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("КоличествоПротоколов", КоличествоПротоколов);
	ДополнительныеПараметры.Вставить("НомерПротоколаСтр", НомерПротоколаСтр);
	ДополнительныеПараметры.Вставить("НомерПротокола", НомерПротокола);
	ДополнительныеПараметры.Вставить("ИмяФайлаКонтейнераПротокола", ИмяФайлаКонтейнераПротокола);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеРасшифрованияПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	СертификатРасшифрования = Новый Структура("Отпечаток", Контекст.СертификатОтправителя);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатРасшифрования);
	КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ИмяФайлаКонтейнераПротокола, , СертификатРасшифрования, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеРасшифрованияПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	РежимСервисаИнициализацияВыполнена = ДополнительныеПараметры.РежимСервисаИнициализацияВыполнена;
	СвойстваСертификатаОтправителя = ДополнительныеПараметры.СвойстваСертификатаОтправителя;
	КоличествоПротоколов = ДополнительныеПараметры.КоличествоПротоколов;
	НомерПротоколаСтр = ДополнительныеПараметры.НомерПротоколаСтр;
	НомерПротокола = ДополнительныеПараметры.НомерПротокола;
	ИмяФайлаКонтейнераПротокола = ДополнительныеПараметры.ИмяФайлаКонтейнераПротокола;
	
	// если не удалось распаковать, то прерываемся
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности: не удалось расшифровать протокол.';
								|en = 'Ошибка разбора ответа от сервера онлайн-проверки отчетности: не удалось расшифровать протокол.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаАрхиваСПротоколом = Результат.РасшифрованныйФайл;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ИмяФайлаКонтейнераПротокола);
		ИмяФайлаКонтейнераПротокола = "";
	Иначе
	// удаляем файл контейнера
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ИмяФайлаКонтейнераПротокола);
	КонецЕсли;
	
	// сохраняем в Контекст в Base64
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("РежимСервисаИнициализацияВыполнена", РежимСервисаИнициализацияВыполнена);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаОтправителя", СвойстваСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("КоличествоПротоколов", КоличествоПротоколов);
	ДополнительныеПараметры.Вставить("НомерПротоколаСтр", НомерПротоколаСтр);
	ДополнительныеПараметры.Вставить("НомерПротокола", НомерПротокола);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);

	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеЧтенияФайлаПротоколаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ЗакодироватьВBase64ЗначениеВременногоХранилища(ИмяФайлаАрхиваСПротоколом, Ложь);		
		СтрокаBase64 = ПолучитьИзВременногоХранилища(ИмяФайлаАрхиваСПротоколом);
		УдалитьИзВременногоХранилища(ИмяФайлаАрхиваСПротоколом);
		Результат = Новый Структура("Выполнено, СтрокаBase64", Истина, СтрокаBase64);
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ИмяФайлаАрхиваСПротоколом);
	
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеПослеЧтенияФайлаПротоколаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	РежимСервисаИнициализацияВыполнена = ДополнительныеПараметры.РежимСервисаИнициализацияВыполнена;
	СвойстваСертификатаОтправителя = ДополнительныеПараметры.СвойстваСертификатаОтправителя;
	КоличествоПротоколов = ДополнительныеПараметры.КоличествоПротоколов;
	НомерПротоколаСтр = ДополнительныеПараметры.НомерПротоколаСтр;
	НомерПротокола = ДополнительныеПараметры.НомерПротокола;
	
	Если НЕ Результат.Выполнено Тогда
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ФайлАрхиваСПротоколом64 = Результат.СтрокаBase64;
	
	Контекст.Вставить("ФайлBase64АрхиваСПротоколом" + НомерПротоколаСтр, ФайлАрхиваСПротоколом64);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ДополнительныеПараметры.Вставить("ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	ДополнительныеПараметры.Вставить("РежимСервисаИнициализацияВыполнена", РежимСервисаИнициализацияВыполнена);
	ДополнительныеПараметры.Вставить("СвойстваСертификатаОтправителя", СвойстваСертификатаОтправителя);
	ДополнительныеПараметры.Вставить("КоличествоПротоколов", КоличествоПротоколов);
	ДополнительныеПараметры.Вставить("НомерПротокола", НомерПротокола);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("РазобратьРезультатОтСервераОнлайнПроверки_НаКлиентеВЦиклеВУниверсальномФорматеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_РазобратьРезультатОтСервераОнлайнПроверки(Контекст, ВыполняемоеОповещение)
	
	Результат = РазобратьРезультатОтСервераОнлайнПроверки_НаСервере(Контекст); // сервер
	Если Результат = Неопределено Тогда

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии();
		КонецЕсли;

		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Контекст.Вставить("Результат", Результат);
	
	РазобратьРезультатОтСервераОнлайнПроверки_НаКлиенте(Контекст, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФайлыКаталога(Каталог)
	
	Возврат НайтиФайлы(Каталог, ПолучитьМаскуВсеФайлы());
	
КонецФункции

&НаСервереБезКонтекста
Функция Разархивировать(ИмяФайлаАрхива)
	
	// создаем каталог распаковки
	КаталогРаспаковки = ПолучитьИмяВременногоФайла();
	КаталогРаспаковки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогРаспаковки);
	
	СоздатьКаталог(КаталогРаспаковки);
	
	// распаковываем все содержимое
	Попытка
		ОбъектЧтение = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
		ОбъектЧтение.ИзвлечьВсе(КаталогРаспаковки);
		ОбъектЧтение.Закрыть();
		Возврат КаталогРаспаковки;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка распаковки пакета:%1';
				|en = 'Ошибка распаковки пакета:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьЗапросКСерверуОнлайнПроверки(УчетнаяЗапись, ДанныеСертификата = Неопределено, ИмяФайлаЗашифрованногоКонтейнера = Неопределено)
	
	АдресОтправителя = СокрЛП(УчетнаяЗапись.АдресЭлектроннойПочты);
	Если НЕ ЗначениеЗаполнено(АдресОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'В свойствах учетной записи не указан адрес электронной почты.';
								|en = 'В свойствах учетной записи не указан адрес электронной почты.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// инициализируем объект для записи XML
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("windows-1251", , Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	
	// выводим корневой элемент Request
	ОбъектЗапись.ЗаписатьНачалоЭлемента("Request");
	
	// выводим элемент ClientInfo
	ОбъектЗапись.ЗаписатьНачалоЭлемента("ClientInfo");
	ОбъектЗапись.ЗаписатьАтрибут("email", АдресОтправителя);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	Если ДанныеСертификата <> Неопределено Тогда
		
		ДанныеСертификатаБезПереводовСтрок = СтрЗаменить(ДанныеСертификата, Символы.ВК, "");
		ДанныеСертификатаБезПереводовСтрок = СтрЗаменить(ДанныеСертификатаБезПереводовСтрок, Символы.ПС, "");
		
		// выводим элемент Certificate
		ОбъектЗапись.ЗаписатьНачалоЭлемента("Certificate");
		ОбъектЗапись.ЗаписатьТекст(ДанныеСертификатаБезПереводовСтрок);
		ОбъектЗапись.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	Если ИмяФайлаЗашифрованногоКонтейнера <> Неопределено Тогда
		
		Если ЭтоАдресВременногоХранилища(ИмяФайлаЗашифрованногоКонтейнера) Тогда
			ИмяФайлаДляЧтения = ПолучитьИмяВременногоФайла();
			ПолучитьИзВременногоХранилища(ИмяФайлаЗашифрованногоКонтейнера).Записать(ИмяФайлаДляЧтения);
		Иначе
			ИмяФайлаДляЧтения = ИмяФайлаЗашифрованногоКонтейнера;
		КонецЕсли;
		
		// кодируем в Base64 зашифрованный контейнер
		ФайлЗашифрованногоКонтейнераBase64 = ПрочитатьBase64ИзФайла(ИмяФайлаДляЧтения);
		
		// выводим элемент Data
		ОбъектЗапись.ЗаписатьНачалоЭлемента("Data");
		ОбъектЗапись.ЗаписатьТекст(ФайлЗашифрованногоКонтейнераBase64);
		ОбъектЗапись.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	// записываем конец для корневого элемента
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.Закрыть();
	
	Возврат ИмяФайлаЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьЗапросКСерверуОнлайнПроверкиВУниверсальномФормате(УчетнаяЗапись, Документ, КонтролирующийОрган, ДанныеСертификата, ИменаФайловВыгрузки, ИменаФайловЗашифрованныхКонтейнеров)
	
	// инициализируем объект для записи XML
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("windows-1251", , Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	
	// выводим корневой элемент Запрос
	ОбъектЗапись.ЗаписатьНачалоЭлемента("Запрос");
	ОбъектЗапись.ЗаписатьАтрибут("ВерсФорм", "1.0");
	ОбъектЗапись.ЗаписатьАтрибут("ДатаВремяФормирования", XMLСтрока(ТекущаяДатаСеанса()));
	ОбъектЗапись.ЗаписатьАтрибут("ВерсПрог", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы());
	
	// выводим элемент УчетнаяЗапись
	ИдентификаторАбонента = нрег(Сред(УчетнаяЗапись.ИдентификаторАбонента, СтрДлина(УчетнаяЗапись.ИдентификаторСпецоператора) + 1));
	ОбъектЗапись.ЗаписатьНачалоЭлемента("УчетнаяЗапись");
	ОбъектЗапись.ЗаписатьТекст(ИдентификаторАбонента);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	// выводим элемент ТипПолучателя
	ОбъектЗапись.ЗаписатьНачалоЭлемента("ТипПолучателя");
	ОбъектЗапись.ЗаписатьТекст(КонтролирующийОрган);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	// выводим элемент Сертификат
	ОбъектЗапись.ЗаписатьНачалоЭлемента("Сертификат");
	ОбъектЗапись.ЗаписатьТекст(ДанныеСертификата);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	Для ИндексФайла = 0 По ИменаФайловЗашифрованныхКонтейнеров.Количество() - 1 Цикл
		
		Если ТипЗнч(Документ) = Тип("Массив") Тогда
			Отчет = Документ[ИндексФайла];
		Иначе
			Отчет = Документ;
		КонецЕсли;
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Отчет));
		ИсточникОтчета = "";
		Если МетаданныеОбъекта <> Неопределено Тогда
			ИмяТипаОтчета = МетаданныеОбъекта.Имя;
			Если ИмяТипаОтчета = "РегламентированныйОтчет" Тогда
				ИсточникОтчета = Отчет.ИсточникОтчета;
			Иначе
				ИсточникОтчета = ИмяТипаОтчета;
			КонецЕсли;
		КонецЕсли;
		
		// выводим элемент Документ
		ОбъектЗапись.ЗаписатьНачалоЭлемента("Документ");
		ОбъектЗапись.ЗаписатьАтрибут("ИмяФайлаВыгрузки", ИменаФайловВыгрузки[ИндексФайла]);
		Если ЗначениеЗаполнено(ИсточникОтчета) Тогда
			ОбъектЗапись.ЗаписатьАтрибут("ТипДокумента", ИсточникОтчета);
		КонецЕсли;
		ОбъектЗапись.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	Для ИндексФайла = 0 По ИменаФайловЗашифрованныхКонтейнеров.Количество() - 1 Цикл
		
		ИмяФайлаЗашифрованногоКонтейнера = ИменаФайловЗашифрованныхКонтейнеров[ИндексФайла];
		Если ЭтоАдресВременногоХранилища(ИмяФайлаЗашифрованногоКонтейнера) Тогда
			ИмяФайлаДляЧтения = ПолучитьИмяВременногоФайла();
			ПолучитьИзВременногоХранилища(ИмяФайлаЗашифрованногоКонтейнера).Записать(ИмяФайлаДляЧтения);
		Иначе
			ИмяФайлаДляЧтения = ИмяФайлаЗашифрованногоКонтейнера;
		КонецЕсли;
		
		// кодируем в Base64 зашифрованный контейнер
		ФайлЗашифрованногоКонтейнераBase64 = ПрочитатьBase64ИзФайла(ИмяФайлаДляЧтения);
		
		// выводим элемент Данные
		ОбъектЗапись.ЗаписатьНачалоЭлемента("Данные");
		ОбъектЗапись.ЗаписатьАтрибут("ИмяФайлаВыгрузки", ИменаФайловВыгрузки[ИндексФайла]);
		ОбъектЗапись.ЗаписатьТекст(ФайлЗашифрованногоКонтейнераBase64);
		ОбъектЗапись.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	// записываем конец для корневого элемента
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.Закрыть();
	
	Возврат ИмяФайлаЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаархивироватьФайл(ИмяИсходногоФайла, ИмяФайлаАрхива = Неопределено)
	
	Если ТипЗнч(ИмяИсходногоФайла) = Тип("Массив") Тогда
		МассивФайлов = ИмяИсходногоФайла;
	Иначе
		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить(ИмяИсходногоФайла);
	КонецЕсли;
	
	Попытка
		ОбъектЗапись = Новый ЗаписьZipФайла(ИмяФайлаАрхива, , , , УровеньСжатияZIP.Максимальный);
		Для Каждого ЭлФайл Из МассивФайлов Цикл
			ОбъектЗапись.Добавить(ЭлФайл);
		КонецЦикла;
		ОбъектЗапись.Записать();
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка записи архива:%1';
				|en = 'Ошибка записи архива:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	Конецпопытки;
	
	Возврат Истина;
	
КонецФункции

