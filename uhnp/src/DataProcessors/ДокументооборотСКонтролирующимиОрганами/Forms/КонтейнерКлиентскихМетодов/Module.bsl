				ТекстСообщения = НСтр("ru = 'Не удалось выгрузить отчет!';
										|en = 'Не удалось выгрузить отчет!'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Если ЭтоГрупповаяПроверка Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстСообщения);
				КонецЕсли;
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
				Возврат;
			Иначе
				
			Для Каждого ДанныеФайла Из ДанныеФайлаРеестраНДС Цикл
				
				ТекстВыгрузкиИлиАдрес.Добавить(ДанныеФайла.Адрес);
				ИмяФайлаВыгрузки.Добавить(ДанныеФайла.Имя);
				КодировкаФайла.Добавить(ДанныеФайла.Кодировка);
				ТипФайлаВыгрузки.Добавить(Контекст.ТипОтправляемогоДокумента);
				ДокументыВыгрузки.Добавить(Отчет);
				
			КонецЦикла;
			
			КонецЕсли;
			
		ИначеЕсли ДокументооборотСКОВызовСервера.ЭтоРегламентированныйОтчетРеестрАкцизы(Отчет) Тогда
			
			ДанныеФайлаРеестраАкцизов = ПолучитьДанныеФайлаРеестраНДС(Отчет, Форма);
			
			ТекстВыгрузкиИлиАдрес = Новый Массив;
			ИмяФайлаВыгрузки = Новый Массив;
			КодировкаФайла = Новый Массив;
			ТипФайлаВыгрузки = Новый Массив;
			ДокументыВыгрузки = Новый Массив;
			
			Если ДанныеФайлаРеестраАкцизов.Количество() = 0 Тогда
				ТекстСообщения = НСтр("ru = 'Не удалось выгрузить отчет!';
										|en = 'Не удалось выгрузить отчет!'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Если ЭтоГрупповаяПроверка Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстСообщения);
				КонецЕсли;
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
				Возврат;
			Иначе
			
			Для Каждого ДанныеФайла Из ДанныеФайлаРеестраАкцизов Цикл
				
				ТекстВыгрузкиИлиАдрес.Добавить(ДанныеФайла.Адрес);
				ИмяФайлаВыгрузки.Добавить(ДанныеФайла.Имя);
				КодировкаФайла.Добавить(ДанныеФайла.Кодировка);
				ТипФайлаВыгрузки.Добавить(Контекст.ТипОтправляемогоДокумента);
				ДокументыВыгрузки.Добавить(Отчет);
				
			КонецЦикла;
			
			КонецЕсли;
			
		Иначе
			
			ВозвращатьИменаИТекстыФайловВыгрузкиВВидеМассивов = (ТипЗнч(Отчет) = Тип("ДокументСсылка.РегламентированныйОтчет")
				И ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(Отчет, "ИсточникОтчета") = "РегламентированныйОтчетРСВ1");
			
			// выгружаем
			РезультатВыгрузки = СдачаОтчетностиЧерезСервисСпецоператораКлиент.ВыгрузитьРегламентированныйОтчет(
				Отчет, 
				Ложь, 
				ТекстВыгрузкиИлиАдрес, 
				ИмяФайлаВыгрузки, 
				КодировкаФайла, 
				ТипФайлаВыгрузки, 
				ДокументыВыгрузки, 
				Контекст.УникальныйИдентификатор,
				ВозвращатьИменаИТекстыФайловВыгрузкиВВидеМассивов);

				
			Если НЕ РезультатВыгрузки Тогда
				ТекстСообщения = НСтр("ru = 'Не удалось выгрузить отчет!';
										|en = 'Не удалось выгрузить отчет!'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Если ЭтоГрупповаяПроверка Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстСообщения);
				КонецЕсли;
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
				Возврат;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекстВыгрузкиИлиАдрес) И ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") И ИмяФайлаВыгрузки.Количество() = 1
				И ТипЗнч(ДокументыВыгрузки) = Тип("Массив") И ДокументыВыгрузки.Количество() > 0 И ТипЗнч(ДокументыВыгрузки[0]) = Тип("Структура") Тогда
				ТекстВыгрузкиИлиАдрес = ДокументыВыгрузки[0].АдресФайлаВыгрузки;
				ИмяФайлаВыгрузки = ИмяФайлаВыгрузки[0];
				ТипФайлаВыгрузки = ДокументыВыгрузки[0].ТипФайлаВыгрузки;
				ДокументыВыгрузки = Отчет;
			ИначеЕсли НЕ ЗначениеЗаполнено(ТекстВыгрузкиИлиАдрес) И ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") И ТипЗнч(ДокументыВыгрузки) = Тип("Массив")
				И ТипЗнч(ДокументыВыгрузки[0]) = Тип("Строка") Тогда
				ТекстВыгрузкиИлиАдрес = Новый Массив;
				Для ИндексДокументаВыгрузки = 0 По ДокументыВыгрузки.Количество() - 1 Цикл
					АдресФайлаВыгрузки = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ДокументыВыгрузки[ИндексДокументаВыгрузки], ИмяФайлаВыгрузки[ИндексДокументаВыгрузки],
						КодировкаФайла, Контекст.УникальныйИдентификатор);
					ТекстВыгрузкиИлиАдрес.Добавить(АдресФайлаВыгрузки);
					ДокументыВыгрузки[ИндексДокументаВыгрузки] = Отчет;
				КонецЦикла;
			КонецЕсли;
			
			Если (ТипЗнч(ТекстВыгрузкиИлиАдрес) = Тип("Массив") ИЛИ ТипЗнч(ТекстВыгрузкиИлиАдрес) = Тип("ФиксированныйМассив"))
				И (ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") ИЛИ ТипЗнч(ИмяФайлаВыгрузки) = Тип("ФиксированныйМассив"))
				И (ТипЗнч(КодировкаФайла) = Тип("Массив") ИЛИ ТипЗнч(КодировкаФайла) = Тип("ФиксированныйМассив"))
				И (ТипЗнч(ТипФайлаВыгрузки) = Тип("Массив") ИЛИ ТипЗнч(ТипФайлаВыгрузки) = Тип("ФиксированныйМассив"))
				И (ТипЗнч(ДокументыВыгрузки) = Тип("Массив") ИЛИ ТипЗнч(ДокументыВыгрузки) = Тип("ФиксированныйМассив")) Тогда
				
				Для каждого ТипФайлаВыгрузкиОтчета Из ТипФайлаВыгрузки Цикл
					Если ТипФайлаВыгрузкиОтчета = "ДокументацияПоКонтролируемымСделкам" Тогда
						ТекстВыгрузкиИлиАдрес = ТекстВыгрузкиИлиАдрес[0];
						ИмяФайлаВыгрузки = ИмяФайлаВыгрузки[0];
						КодировкаФайла = КодировкаФайла[0];
						ТипФайлаВыгрузки = ТипФайлаВыгрузки[0];
						ДокументыВыгрузки = ДокументыВыгрузки[0];
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстВыгрузкиИлиАдрес) = Тип("Строка") Тогда
		Если НЕ ЭтоАдресВременногоХранилища(ТекстВыгрузкиИлиАдрес) Тогда
			АдресФайлаВыгрузки = ЗаписатьФайлВыгрузкиВоВременноеХранилище(ТекстВыгрузкиИлиАдрес, ИмяФайлаВыгрузки, КодировкаФайла, Контекст.УникальныйИдентификатор);
		Иначе
			АдресФайлаВыгрузки = ТекстВыгрузкиИлиАдрес;
		КонецЕсли;
	Иначе
		АдресФайлаВыгрузки = ТекстВыгрузкиИлиАдрес;
	КонецЕсли;
	
	Контекст.Вставить("АдресФайлаВыгрузки", АдресФайлаВыгрузки);
	Контекст.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	Контекст.Вставить("КодировкаФайла", 	КодировкаФайла);
	Контекст.Вставить("ТипФайлаВыгрузки", 	ТипФайлаВыгрузки);
	Контекст.Вставить("Документы", 			ДокументыВыгрузки);
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ВыгрузитьОтчетПослеПоискаСертификатаДляШифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении 	= ДополнительныеПараметры.ОповещениеОЗавершении;
	Контекст 				= ДополнительныеПараметры.Контекст;
	Форма 					= ДополнительныеПараметры.Форма;
	
	ВладелецСертификатаОтветственногоЗаШифрование = ?(Результат.Выполнено И Результат.СертификатНайден,
		Результат.СвойстваСертификата.Владелец, Неопределено);
	ДополнительныеДанные = Новый Структура("ВладелецСертификатаОтветственногоЗаШифрование", ВладелецСертификатаОтветственногоЗаШифрование);
	
	ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ВыгрузитьОтчет(ОповещениеОЗавершении, Контекст, Форма, ДополнительныеДанные);
	
КонецПроцедуры

&НаКлиенте
Функция ШаблонИнформацииОСервереОнлайнПроверки() Экспорт
	
	ИнформацияОСервереОнлайнПроверки = Новый Структура();
	ИнформацияОСервереОнлайнПроверки.Вставить("Наименование",  "");
	ИнформацияОСервереОнлайнПроверки.Вставить("ТипРеализации", "");
	ИнформацияОСервереОнлайнПроверки.Вставить("Ресурс",        Неопределено);
	ИнформацияОСервереОнлайнПроверки.Вставить("Отпечаток",     "");
	
	Возврат ИнформацияОСервереОнлайнПроверки;
	
КонецФункции

&НаКлиенте
Функция РезультатАвтонастройкиИзКэша(Организация) Экспорт
	
	ФормаГрупповойПроверки = ДлительнаяОтправкаКлиент.ФормаГрупповойОтправкиИзОткрытых();
	
	РезультатАвтонастройки = Неопределено;
	
	Если ФормаГрупповойПроверки <> Неопределено Тогда
		РезультатыАвтонастройкиОрганизации = ФормаГрупповойПроверки.РезультатыАвтонастройки.Получить(Организация);
		Если РезультатыАвтонастройкиОрганизации <> Неопределено Тогда
			РезультатАвтонастройки  = РезультатыАвтонастройкиОрганизации.РезультатАвтонастройки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатАвтонастройки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_Проверка(
		Контекст,
		Форма,
		ВыполняемоеОповещение)
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина Тогда
		
		Контекст.ИнформацияОСервереОнлайнПроверки = ШаблонИнформацииОСервереОнлайнПроверки();
		
		ОсновнойОтчет = Контекст.Документ;
		Если ТипЗнч(Контекст.Документ) = Тип("Массив") Тогда
			ОсновнойОтчет = Контекст.Документ[0];
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("Контекст",              Контекст);
		
		РезультатАвтонастройки = РезультатАвтонастройкиИзКэша(Контекст.Организация);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПроверкаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		Если РезультатАвтонастройки = Неопределено Тогда
			
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(
			ОсновнойОтчет,
			ОписаниеОповещения,
			Контекст.ИнформацияОСервереОнлайнПроверки);
		
	Иначе
		
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатАвтонастройки);

		КонецЕсли;

	Иначе
		
		РезультатПроверки 		= Неопределено;
		ПовторениеНеобходимо 	= Истина;
		КоличествоПовторений 	= 0;
		
		ВыполнитьОнлайнПроверкуОтчета(ВыполняемоеОповещение, Контекст, КоличествоПовторений);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПроверкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	
	Если ЗначениеЗаполнено(Результат)
		И Результат.Свойство("СтруктураДляИнформацииОСервереОнлайнПроверки") Тогда
		
		Контекст.ИнформацияОСервереОнлайнПроверки = Результат.СтруктураДляИнформацииОСервереОнлайнПроверки;
		
		РезультатПроверки = Неопределено;
		ПовторениеНеобходимо = Истина;
		КоличествоПовторений = 0;
		
		ВыполнитьОнлайнПроверкуОтчета(ВыполняемоеОповещение, Контекст, КоличествоПовторений);
	
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Учетная запись документооборота не поддерживает проверку в интернете';
									|en = 'Учетная запись документооборота не поддерживает проверку в интернете'");
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
		Иначе
			ПоказатьПредупреждение(, ТекстПредупреждения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОнлайнПроверкуОтчета(ВыполняемоеОповещение, Контекст, КоличествоПовторений)
	
	// вызываем онлайн-проверку
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, КоличествоПовторений", ВыполняемоеОповещение, КоличествоПовторений);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОнлайнПроверкуОтчета_ОнлайнПроверкаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОнлайнПроверкаОтчета(Контекст, ОписаниеОповещения); // клиент
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОнлайнПроверкуОтчета_ОнлайнПроверкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КоличествоПовторений  = ДополнительныеПараметры.КоличествоПовторений;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст              = Результат.Контекст;
	РезультатПроверки     = Результат.РезультатПроверки;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОнлайнПроверкуОтчетаЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
	Если НЕ РезультатПроверки Тогда
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии();
		Иначе
			ПоказатьПредупреждение(ОписаниеОповещения, НСтр("ru = 'Не удалось проверить отчет!';
															|en = 'Не удалось проверить отчет!'"));
		КонецЕсли;
	Иначе
		
		РезультатПроверки = Контекст.Результат;
		КоличествоПроверокДляУниверсальногоФормата = ?(РезультатПроверки.Свойство("КоличествоПроверокДляУниверсальногоФормата"), РезультатПроверки.КоличествоПроверокДляУниверсальногоФормата, 0);
		КоличествоПротоколовДляУниверсальногоФормата = ?(РезультатПроверки.Свойство("КоличествоПротоколовДляУниверсальногоФормата"), РезультатПроверки.КоличествоПротоколовДляУниверсальногоФормата, 0);
		
		// анализируем код результата, для универсального формата возможно получение протокола и при успешном результате проверки
		КодРезультатаПроверки = РезультатПроверки.КодРезультата;
		Если КодРезультатаПроверки = 0 И КоличествоПротоколовДляУниверсальногоФормата = 0 И КоличествоПроверокДляУниверсальногоФормата <= 1 Тогда
			
			Если РезультатПроверки.Свойство("Протокол") И ЗначениеЗаполнено(РезультатПроверки.Протокол) Тогда
				ПоказатьПротоколОнлайнПроверки(
					Контекст.Документ,
					Контекст.ИмяФайлаВыгрузки,
					Контекст.АдресФайлаВыгрузки,
					?(РезультатПроверки.Свойство("Протокол"), РезультатПроверки.Протокол, ""),
					?(РезультатПроверки.Свойство("ИмяФайлаПротокола"), РезультатПроверки.ИмяФайлаПротокола, ""),
					КодРезультатаПроверки,
					?(РезультатПроверки.Свойство("ПрограммаПроверки"), РезультатПроверки.ПрограммаПроверки, ""),
					Истина,
					ВыполняемоеОповещение); // клиент
				
			Иначе
				ПерваяПрограммаПроверки = ?(РезультатПроверки.Свойство("ПерваяПрограммаПроверки"), РезультатПроверки.ПерваяПрограммаПроверки, "");
				
				ПоказатьПротоколОнлайнПроверки(
					Контекст.Документ,
					"",
					"",
					"",
					"",
					0,
					ПерваяПрограммаПроверки,
					Истина,
					ВыполняемоеОповещение); // клиент
			КонецЕсли;
			
		ИначеЕсли КодРезультатаПроверки = 1 И КоличествоПротоколовДляУниверсальногоФормата = 0 Тогда
			ДанныеСертификата = Неопределено;
			Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина ИЛИ НЕ РезультатПроверки.Свойство("Сертификат", ДанныеСертификата) ИЛИ КоличествоПовторений > 1 Тогда

				ТекстПредупреждения = НСтр("ru = 'Не удалось проверить отчетность на сервере!';
											|en = 'Не удалось проверить отчетность на сервере!'") + "
					|
					|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ответ сервера: %1';
																						|en = 'Ответ сервера: %1'"), РезультатПроверки.ПредставлениеРезультата);

				Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
				Иначе
					ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
				КонецЕсли;
			Иначе
				КоличествоПовторений = КоличествоПовторений + 1;
				ДополнительныеПараметры.Вставить("КоличествоПовторений", 	КоличествоПовторений);
				ДополнительныеПараметры.Вставить("Контекст", 				Контекст);
				МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Контекст.УчетнаяЗапись);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ВыполнитьОнлайнПроверкуОтчета_ПослеРегистрацииСертификата", 
					ЭтотОбъект, 
					ДополнительныеПараметры);
				
				ЗарегистрироватьСертификатСервераОнлайнПроверки(
					МестоХраненияКлюча,
					ДанныеСертификата,
					ОписаниеОповещения);
				
			КонецЕсли;
			
		ИначеЕсли (КодРезультатаПроверки = 6 И Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина)
			ИЛИ (Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина И (ТипЗнч(Контекст.ИмяФайлаВыгрузки) = Тип("Массив") ИЛИ КоличествоПроверокДляУниверсальногоФормата > 1)) Тогда
			Если ЗначениеЗаполнено(РезультатПроверки.РезультатыПоДокументам) Тогда
				ДополнитьРезультатыГрупповойОнлайнПроверки(Контекст, РезультатПроверки);
				
				ПоказатьРезультатыГрупповойОнлайнПроверки(
					РезультатПроверки.РезультатыПоДокументам,
					Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате,
					ТипЗнч(Контекст.ИмяФайлаВыгрузки) <> Тип("Массив"),
					ВыполняемоеОповещение);
				
			Иначе
				ТекстПредупреждения = НСтр("ru = 'Отчетность не прошла проверку! К сожалению, детальные результаты недоступны.';
											|en = 'Отчетность не прошла проверку! К сожалению, детальные результаты недоступны.'");
				Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
				Иначе
					ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли (КодРезультатаПроверки <> 4 И Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина)
			ИЛИ (КодРезультатаПроверки <> 3 И КодРезультатаПроверки <> 4 И Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина И КоличествоПротоколовДляУниверсальногоФормата = 0) Тогда
			Если ЗначениеЗаполнено(РезультатПроверки.ПредставлениеРезультата) Тогда

				ТекстПредупреждения = НСтр("ru = 'Не удалось проверить отчетность на сервере!';
											|en = 'Не удалось проверить отчетность на сервере!'") + "
					|
					|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ответ сервера: %1';
																						|en = 'Ответ сервера: %1'"), РезультатПроверки.ПредставлениеРезультата);
				Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
				Иначе
					ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
				КонецЕсли;
			Иначе
				ТекстПредупреждения = НСтр("ru = 'Во время проверки файла выгрузки на сервере произошла неизвестная ошибка!';
											|en = 'Во время проверки файла выгрузки на сервере произошла неизвестная ошибка!'");
				Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
			Иначе
					ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			Если (РезультатПроверки.Свойство("Протокол") И ЗначениеЗаполнено(РезультатПроверки.Протокол)) ИЛИ КоличествоПротоколовДляУниверсальногоФормата > 0 Тогда
				ПоказатьПротоколОнлайнПроверки(Контекст.Документ, Контекст.ИмяФайлаВыгрузки, Контекст.АдресФайлаВыгрузки, ?(РезультатПроверки.Свойство("Протокол"), РезультатПроверки.Протокол, ""), ?(РезультатПроверки.Свойство("ИмяФайлаПротокола"), РезультатПроверки.ИмяФайлаПротокола, ""),
					?(Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина, КодРезультатаПроверки, Неопределено),
					?(РезультатПроверки.Свойство("ПрограммаПроверки"), РезультатПроверки.ПрограммаПроверки, ""), Истина, ВыполняемоеОповещение); // клиент
			Иначе
				ТекстПредупреждения = НСтр("ru = 'Отчет не прошел проверку! К сожалению, расширенный протокол недоступен.';
											|en = 'Отчет не прошел проверку! К сожалению, расширенный протокол недоступен.'");
				Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
					ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
				Иначе
					ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОнлайнПроверкуОтчета_ПослеРегистрацииСертификата(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если Результат.Выполнено Тогда
		
		КоличествоПовторений 	= ВходящийКонтекст.КоличествоПовторений;
		Контекст 				= ВходящийКонтекст.Контекст;
		
		ВыполнитьОнлайнПроверкуОтчета(ВыполняемоеОповещение, Контекст, КоличествоПовторений);
	Иначе
		ПоказатьПредупреждение(ВыполняемоеОповещение, НСтр("ru = 'Не удалось зарегистрировать новый сертификат сервера онлайн-проверки!
			|Продолжение невозможно.';
			|en = 'Не удалось зарегистрировать новый сертификат сервера онлайн-проверки!
			|Продолжение невозможно.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОнлайнПроверкуОтчетаЗавершение(ВыполняемоеОповещение) Экспорт
	
	// Используем переходник, так как в ОписанииОповещения у ПоказатьПредупреждение 1 параметр, 
	// а в переданном ВыполняемоеОповещение два параметра.
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки(ВходящийКонтекст);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("СсылкаНаОтчет") Тогда
		СсылкаНаОтчет = ДополнительныеПараметры.СсылкаНаОтчет;
	Иначе
		СсылкаНаОтчет = ДополнительныеПараметры.Ссылка;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(СсылкаНаОтчет, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПослеНастройкиЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("СсылкаНаОтчет") Тогда
		СсылкаНаОтчет = ДополнительныеПараметры.СсылкаНаОтчет;
	Иначе
		СсылкаНаОтчет = ДополнительныеПараметры.Ссылка;
	КонецЕсли;
		
	КонтролирующийОрган 			= ДополнительныеПараметры.КонтролирующийОрган;
	Форма 							= ДополнительныеПараметры.Форма;
	СледуетОбновлятьПанельОтправки 	= ДополнительныеПараметры.СледуетОбновлятьПанельОтправки;	
	
	Контекст = Новый Структура;
	Контекст.Вставить("Документ", 				 СсылкаНаОтчет);
	Контекст.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	Контекст.Вставить("КонтролирующийОрган", 	 КонтролирующийОрган);
	Контекст.Вставить("СледуетОбновитьПанельОтправки", Ложь);
	
	Если ДополнительныеПараметры.Свойство("АдресГотовыхДанных") Тогда 
		АдресГотовыхДанных 	  = ДополнительныеПараметры.АдресГотовыхДанных;
		ИмяФайлаГотовыхДанных = ДополнительныеПараметры.ИмяФайлаГотовыхДанных;
	Иначе
		АдресГотовыхДанных 		= Неопределено;
		ИмяФайлаГотовыхДанных 	= Неопределено;
	КонецЕсли;
	
	Контекст.Вставить("АдресГотовыхДанных", 	АдресГотовыхДанных);
	Контекст.Вставить("ИмяФайлаГотовыхДанных", 	ИмяФайлаГотовыхДанных);
	
	// заполняем реквизиты контекста
	Если НЕ ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПодготовкаИПроверкаНаСервере(Контекст) Тогда

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ТекстПредупреждения = НСтр("ru = 'Проверка в Интернете недоступна для этого документа';
										|en = 'Проверка в Интернете недоступна для этого документа'");
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
		КонецЕсли;

		Возврат;

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Контекст.УчетнаяЗапись) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПослеПроверкиЗаявления", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(СсылкаНаОтчет, ОписаниеОповещения); 
		
		Возврат;
		
	КонецЕсли;
	
	ЭтоГрупповаяПроверка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки();

	// получаем разрешение на отправку персонральных данных
	Если ЭтоГрупповаяПроверка Тогда

		ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправку(
			Контекст, 
			Форма, 
			КонтролирующийОрган, 
			СледуетОбновлятьПанельОтправки);

	ИначеЕсли Контекст.ОтправкаПерсональныхДанныхРазрешена = Неопределено 
		ИЛИ НЕ Контекст.ОтправкаПерсональныхДанныхРазрешена Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Контекст", 						Контекст);
		ДополнительныеПараметры.Вставить("Форма", 							Форма);
		ДополнительныеПараметры.Вставить("КонтролирующийОрган", 			КонтролирующийОрган);
		ДополнительныеПараметры.Вставить("СледуетОбновлятьПанельОтправки", 	СледуетОбновлятьПанельОтправки);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредупреждениеОбОтправкеПерсональныхДанных",,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца) ;
		
	Иначе
		ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправку(Контекст, Форма, КонтролирующийОрган, СледуетОбновлятьПанельОтправки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиЗавершение(ОтправкаПерсональныхДанныхРазрешена, ДополнительныеПараметры) Экспорт
	
	Контекст 							= ДополнительныеПараметры.Контекст;
	Форма 								= ДополнительныеПараметры.Форма;
	КонтролирующийОрган 				= ДополнительныеПараметры.КонтролирующийОрган;
	СледуетОбновлятьПанельОтправки		= ДополнительныеПараметры.СледуетОбновлятьПанельОтправки;	
	
	Если ОтправкаПерсональныхДанныхРазрешена = КодВозвратаДиалога.ОК Тогда
		
		ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправку(
			Контекст, 
			Форма, 
			КонтролирующийОрган, 
			СледуетОбновлятьПанельОтправки);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправку(Контекст, Форма, КонтролирующийОрган, СледуетОбновлятьПанельОтправки)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 							Форма);
	ДополнительныеПараметры.Вставить("КонтролирующийОрган", 			КонтролирующийОрган);
	ДополнительныеПараметры.Вставить("СледуетОбновлятьПанельОтправки", 	СледуетОбновлятьПанельОтправки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеВыгрузкиОтчета",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	// выгружаем отчет
	ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ВыгрузитьОтчет(ОписаниеОповещения, Контекст, Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеВыгрузкиОтчета(Контекст, ДополнительныеПараметры) Экспорт
	
	Форма 							= ДополнительныеПараметры.Форма;
	КонтролирующийОрган 			= ДополнительныеПараметры.КонтролирующийОрган;
	СледуетОбновлятьПанельОтправки 	= ДополнительныеПараметры.СледуетОбновлятьПанельОтправки;
	
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНДССПриложениями = Ложь;
	Если Контекст.ЭтоНДС Тогда
		Если ТипЗнч(Контекст.Документ) = Тип("ДокументСсылка.РегламентированныйОтчет")
			И ТипЗнч(Контекст.Документы) = Тип("Массив") И Контекст.Документы.Количество() >= 1 Тогда
			
			ЭтоНДССПриложениями = Истина;
			
		ИначеЕсли ТипЗнч(Контекст.Документ) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов")
			И ТипЗнч(Контекст.ИмяФайлаВыгрузки) = Тип("Массив") Тогда
			
			Для каждого ИмяФайлаВыгрузки Из Контекст.ИмяФайлаВыгрузки Цикл
				Если СтрНайти(ИмяФайлаВыгрузки, "NO_NDS_") <> 1 Тогда
					ЭтоНДССПриложениями = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоГрупповаяПроверка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки();
	
	ДополнительныеПараметры = Новый Структура(); 
	ДополнительныеПараметры.Вставить("Форма", 							Форма);
	ДополнительныеПараметры.Вставить("КонтролирующийОрган", 			КонтролирующийОрган);
	ДополнительныеПараметры.Вставить("СледуетОбновлятьПанельОтправки", 	СледуетОбновлятьПанельОтправки);
	ДополнительныеПараметры.Вставить("Контекст", 						Контекст);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеПредупрежденияНДС",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ЭтоГрупповаяПроверка Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	ИначеЕсли ЭтоНДССПриложениями И НЕ Контекст.БольшеНеПоказыватьПредупреждениеПриложенияНДСНаПроверкуНеОтправляются Тогда
		ТекстПредупреждения = ?(ТипЗнч(Контекст.Документ) = Тип("ДокументСсылка.РегламентированныйОтчет"),
			НСтр("ru = 'Обратите внимание, информация по счетам-фактурам проверяется отдельно, при нажатии кнопки ""Заполнить"".';
				|en = 'Обратите внимание, информация по счетам-фактурам проверяется отдельно, при нажатии кнопки ""Заполнить"".'"),
			НСтр("ru = 'Обратите внимание, информация по счетам-фактурам на проверку не отправляется.';
				|en = 'Обратите внимание, информация по счетам-фактурам на проверку не отправляется.'"));
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ТекстПредупреждения", 		ТекстПредупреждения);
		СтруктураПараметров.Вставить("ЗаголовокФормы", 				НСтр("ru = 'Предупреждение';
																			|en = 'Предупреждение'"));
		СтруктураПараметров.Вставить("ОднаКнопка", 					Истина);
		
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредупреждениеСФлагомБольшеНеПоказывать",
			СтруктураПараметров,
			Форма,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеПредупрежденияНДС(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 		= ДополнительныеПараметры.Форма;
	Контекст 	= ДополнительныеПараметры.Контекст;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		СохранитьБольшеНеПоказыватьПредупреждениеНДС(Контекст.Документ, Результат.БольшеНеПоказывать);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправкуЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_Проверка(
		Контекст,
		Форма,
		ОписаниеОповещения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьБольшеНеПоказыватьПредупреждениеНДС(Отчет, БольшеНеПоказывать)
	
	КлючОбъектаПредупрежденияНДС = ?(ТипЗнч(Отчет) = Тип("ДокументСсылка.РегламентированныйОтчет"),
		"ПредупреждениеПриложенияНДСНаПроверкуНеОтправляются",
		"ПредупреждениеПриложенияНДСНаПроверкуНеОтправляютсяДляЭлектронныхПредставлений");
	КлючНастроекПредупрежденияНДС = "БольшеНеПоказывать";
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		КлючОбъектаПредупрежденияНДС,
		КлючНастроекПредупрежденияНДС,
		БольшеНеПоказывать);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверкиПослеРазрешенияНаОтправкуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	КонтролирующийОрган = ДополнительныеПараметры.КонтролирующийОрган;
	СледуетОбновлятьПанельОтправки = ДополнительныеПараметры.СледуетОбновлятьПанельОтправки;
	Контекст = ДополнительныеПараметры.Контекст;
	// перерисовываем панель отправки, если необходимо
	Если СледуетОбновлятьПанельОтправки И Контекст.СледуетОбновитьПанельОтправки Тогда
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ОбновитьПанельСостоянияОтправкиВРегламентированномОтчете(Форма, КонтролирующийОрган);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ХранилищеПоПредставлению(Знач Хранилище)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ХранилищеПоПредставлению(Хранилище);
	
КонецФункции
	
&НаСервереБезКонтекста
Функция ЗарегистрироватьСертификатВСистемеНаСервере(АдресДанныхСертификата, Хранилище, ОтпечатокСертификата = Неопределено)
	
	ЛогическоеХранилище = ХранилищеПоПредставлению(Хранилище);
	ДвоичныеДанныеСертификата = ПолучитьИзВременногоХранилища(АдресДанныхСертификата);
	
	ХранилищеСертификатов.Добавить(ДвоичныеДанныеСертификата, ЛогическоеХранилище);
	СвойстваСертификата = СервисКриптографии.ПолучитьСвойстваСертификата(ДвоичныеДанныеСертификата);
	
	ОтпечатокСертификата = ?(СвойстваСертификата <> Неопределено, СвойстваСертификата.Отпечаток, Неопределено);
	Возврат (СвойстваСертификата <> Неопределено);
	
КонецФункции

&НаКлиенте
Функция ЗарегистрироватьСертификатСервераОнлайнПроверки(
		МестоХраненияКлюча,
		ИмяФайлаСертификата,
		ВыполняемоеОповещение,
		ОтпечатокСертификата = Неопределено)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяФайлаСертификата", 				ИмяФайлаСертификата);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата", 				ОтпечатокСертификата);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча);
	
	// регистрируем сертификат в хранилище AddressBook
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗарегистрироватьСертификатСервераОнлайнПроверкиПослеРегистрации", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		ОтпечатокСертификата = Неопределено;

		РезультатРегистрации = ЗарегистрироватьСертификатВСистемеНаСервере(ИмяФайлаСертификата, "AddressBook", ОтпечатокСертификата);
		
		СвойстваСертификата = Новый Структура("Отпечаток", ОтпечатокСертификата);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("Выполнено", РезультатРегистрации);
		РезультатВыполнения.Вставить("СвойстваСертификата", СвойстваСертификата);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатВыполнения);
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ОтпечатокСертификата = Неопределено;

		РезультатРегистрации = ЗарегистрироватьСертификатВХранилищеПолучателей(ИмяФайлаСертификата, "AddressBook", ОтпечатокСертификата);
		
		СвойстваСертификата = Новый Структура("Отпечаток", ОтпечатокСертификата);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("Выполнено", РезультатРегистрации);
		РезультатВыполнения.Вставить("СвойстваСертификата", СвойстваСертификата);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатВыполнения);
		
	Иначе
		
		КриптографияЭДКОКлиент.ИмпортироватьСертификат(ОписаниеОповещения, ИмяФайлаСертификата, "AddressBook");
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьСертификатСервераОнлайнПроверкиПослеРегистрации(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ВходящийКонтекст.Вставить("Отпечаток", Результат.СвойстваСертификата.Отпечаток);
		ИмяФайлаСертификата = ВходящийКонтекст.ИмяФайлаСертификата;
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗарегистрироватьСертификатСервераОнлайнПроверкиПолучениняДанныхСертификата", 
			ЭтотОбъект, 
			ВходящийКонтекст); 
	
		// запоминаем
		Если НЕ ЭтоЛокальнаяПодпись(ВходящийКонтекст) Тогда
			
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Выполнено", 		Истина);
			РезультатВыполнения.Вставить("СтрокаBase64", 	ИмяФайлаСертификата);
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатВыполнения);
			
		Иначе
				
				ОперацииСФайламиЭДКОКлиент.ФайлВBase64(ОписаниеОповещения, ИмяФайлаСертификата);
				
		КонецЕсли;
		
	Иначе
		
		ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
		
		ТекстСообщения = НСтр("ru = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в системном хранилище сертификатов.';
								|en = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в системном хранилище сертификатов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("Выполнено", Ложь);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатСервераОнлайнПроверкиПолучениняДанныхСертификата(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если Результат.Выполнено Тогда
		
		ОтпечатокСертификата 	= ВходящийКонтекст.Отпечаток;
		ДанныеСертификата 		= Результат.СтрокаBase64;
					
		Если ЗапомнитьСведенияОСертификатеОнлайнПроверкиВКонстантах(ОтпечатокСертификата, ДанныеСертификата) Тогда
			
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Выполнено", Истина);
			РезультатВыполнения.Вставить("Отпечаток", ОтпечатокСертификата);
		
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Иначе
			
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Выполнено", Ложь);
			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
			
	КонецЕсли;
	
	Иначе
	
		ТекстСообщения = НСтр("ru = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в системном хранилище сертификатов.';
								|en = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в системном хранилище сертификатов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("Выполнено", Ложь);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапомнитьСведенияОСертификатеОнлайнПроверкиВКонстантах(ОтпечатокСертификата, ДанныеСертификата)
	
	ТипЗнчДанныеСертификата = ТипЗнч(ДанныеСертификата);
	Если ТипЗнчДанныеСертификата = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(ДанныеСертификата) Тогда
			ДанныеСертификата = ПолучитьИзВременногоХранилища(ДанныеСертификата);
		Иначе // строка Base64
			ДанныеСертификата = ДвоичныеДанныеИзСтроки64НаСервере(ДанныеСертификата);
		КонецЕсли;
		ДанныеХранилище = Новый ХранилищеЗначения(ДанныеСертификата);
	ИначеЕсли ТипЗнчДанныеСертификата = Тип("ДвоичныеДанные") Тогда
		ДанныеХранилище = Новый ХранилищеЗначения(ДанныеСертификата);
	Иначе
		ДанныеХранилище = ДанныеСертификата;
	КонецЕсли;
	
	КонстантыНабор = Константы.СоздатьНабор("ДокументооборотСКонтролирующимиОрганами_ОтпечатокСертификатаОнлайнПроверки, ДокументооборотСКонтролирующимиОрганами_СертификатСервераОнлайнПроверки");
	КонстантыНабор.ДокументооборотСКонтролирующимиОрганами_ОтпечатокСертификатаОнлайнПроверки = ОтпечатокСертификата;
	КонстантыНабор.ДокументооборотСКонтролирующимиОрганами_СертификатСервераОнлайнПроверки = ДанныеХранилище;
	Попытка
		КонстантыНабор.Записать();
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в информационной базе:%1';
				|en = 'Не удалось зарегистрировать сертификат сервера онлайн-проверки в информационной базе:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзИБСертификатСервераОнлайнПроверки() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	Константы.ДокументооборотСКонтролирующимиОрганами_ОтпечатокСертификатаОнлайнПроверки КАК Отпечаток,
						  |	Константы.ДокументооборотСКонтролирующимиОрганами_СертификатСервераОнлайнПроверки КАК Сертификат
						  |ИЗ
						  |	Константы КАК Константы");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отпечаток = Выборка.Отпечаток;
		Сертификат = Выборка.Сертификат;
		Если ЗначениеЗаполнено(Отпечаток) И ЗначениеЗаполнено(Сертификат) Тогда
			Возврат Новый Структура("Отпечаток, Сертификат", Отпечаток, Сертификат);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьЗапросДляОбработкиНаСерверОнлайнПроверки(ИмяФайлаЗапроса, ПолучитьСертификат = Ложь)
	
	АдресСервераОнлайнПроверки = "https://onlinefc.taxcom.ru";
	РесурсНаСервере = "/online_fc/online_fc.dll" + ?(ПолучитьСертификат, "?IncludeCertificate", "");
	
	// устанавливаем соединение с сервером
	ОписаниеОшибки = "";
	Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(АдресСервераОнлайнПроверки, ОписаниеОшибки);
	Если Соединение = Неопределено Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось установить соединение с сервером онлайн-проверки:
                  |%1';
                  |en = 'Не удалось установить соединение с сервером онлайн-проверки:
                  |%1'"), ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// посылаем запрос
	ФайлРезультата = ПолучитьИмяВременногоФайла();
	Попытка
		Соединение.ОтправитьДляОбработки(ИмяФайлаЗапроса, РесурсНаСервере, ФайлРезультата);
		Соединение = Неопределено;
		ПовторятьСоединение = Ложь;
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ФайлРезультата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьЗапросДляОбработкиНаСерверОнлайнПроверкиВУниверсальномФормате(ИмяФайлаЗапроса, ПараметрыРесурса, ПовторятьСоединение)
	
	Сервис = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбменССерверомСоздатьСервис( , , , ПараметрыРесурса, Ложь);
	Если Сервис = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаBase64 = ПрочитатьBase64ИзФайла(ИмяФайлаЗапроса);
	
	Попытка
		XDTOРезультат = Сервис.Test(СтрокаBase64);
	Исключение
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = ДокументооборотСКОВызовСервера.ДобавитьТекстОшибкиСертификатаКА(ТекстОшибки);
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка в интернете';
				|en = 'Электронный документооборот с контролирующими органами. Проверка в интернете'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
	ПовторятьСоединение = Ложь;
	
	ФайлРезультата = ПолучитьИмяВременногоФайла();
	Текст = Новый ЗаписьТекста(ФайлРезультата, "windows-1251");
	Текст.ЗаписатьСтроку(XDTOРезультат);
	Текст.Закрыть();
	
	Возврат ФайлРезультата;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьИОтправитьЗапросДляПолученияСертификатаНаСерверОнлайнПроверки(Контекст)
	
	// формируем запрос
	ИмяФайлаЗапроса = СформироватьЗапросКСерверуОнлайнПроверки(Контекст.УчетнаяЗапись);
	Если ИмяФайлаЗапроса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// отправляем запрос на сервер
	ИмяФайлаРезультата = ОтправитьЗапросДляОбработкиНаСерверОнлайнПроверки(ИмяФайлаЗапроса, Истина);
	Если ИмяФайлаРезультата = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// помещаем результат во временное хранилище
	АдресФайлаРезультатаПроверки = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаРезультата), Контекст.УникальныйИдентификатор);
	Контекст.Вставить("АдресФайлаРезультатаПроверки", АдресФайлаРезультатаПроверки);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверки(Контекст, ВыполняемоеОповещение)
	
	УчетнаяЗаписьОрганизации = Контекст.УчетнаяЗапись;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(УчетнаяЗаписьОрганизации);
	
	// инициализируем "константы"
	АдресСервераОнлайнПроверки = "https://onlinefc.taxcom.ru";
	РесурсНаСервере = "/online_fc/online_fc.dll?IncludeCertificate";
	
	// 
	Если НЕ СформироватьИОтправитьЗапросДляПолученияСертификатаНаСерверОнлайнПроверки(Контекст) Тогда // сервер
		РезультатВыполнения = Новый Структура("СвойстваСертификатаПолучателя, Контекст", Неопределено, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	// разбираем полученный результат
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение", ВыполняемоеОповещение);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеРазбораРезультатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОнлайнПроверкаОтчета_РазобратьРезультатОтСервераОнлайнПроверки(Контекст, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеРазбораРезультатаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	Контекст                            = Результат.Контекст;
	
	Если НЕ Результат.РезультатПроверки Тогда
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("СвойстваСертификатаПолучателя", Неопределено);
		РезультатВыполнения.Вставить("Контекст",                      Контекст);

		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
		
	КонецЕсли;
	
	РезультатОтСервера = Контекст.Результат;
	Если РезультатОтСервера = Неопределено Тогда
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("СвойстваСертификатаПолучателя", Неопределено);
		РезультатВыполнения.Вставить("Контекст",                      Контекст);

		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	ИначеЕсли РезультатОтСервера.КодРезультата <> 5 Тогда
		
		ПредставлениеРезультата = РезультатОтСервера.ПредставлениеРезультата;
		Если ПредставлениеРезультата <> Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось получить сертификат сервера онлайн-проверки: %1';
					|en = 'Не удалось получить сертификат сервера онлайн-проверки: %1'"), ПредставлениеРезультата);
		Иначе
			ТекстСообщения = НСтр("ru = 'Не удалось получить сертификат сервера онлайн-проверки.';
									|en = 'Не удалось получить сертификат сервера онлайн-проверки.'");
		КонецЕсли;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("СвойстваСертификатаПолучателя", Неопределено);
		РезультатВыполнения.Вставить("Контекст",                      Контекст);

		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	ИначеЕсли НЕ РезультатОтСервера.Свойство("КодРезультата") ИЛИ НЕ РезультатОтСервера.Свойство("Сертификат") Тогда
		
		ТекстСообщения = НСтр("ru = 'Не удалось получить сертификат сервера онлайн-проверки: некорректный ответ сервера.';
								|en = 'Не удалось получить сертификат сервера онлайн-проверки: некорректный ответ сервера.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("СвойстваСертификатаПолучателя", Неопределено);
		РезультатВыполнения.Вставить("Контекст",                      Контекст);

		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
		
	КонецЕсли;
	
	// регистрируем в ИБ и системе
	ДополнительныеПараметры.Вставить("Контекст", Контекст);
	ОтпечатокСертификата = Неопределено;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеРегистрацииСертификата",
		ЭтотОбъект, 
		ДополнительныеПараметры); 
		
	ЗарегистрироватьСертификатСервераОнлайнПроверки(
		МестоХраненияКлюча,
		РезультатОтСервера.Сертификат,
		ОписаниеОповещения,
		ОтпечатокСертификата);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеРегистрацииСертификата(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Контекст = ВходящийКонтекст.Контекст;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка регистрации в системном хранилище сертификата сервера онлайн-проверки.';
								|en = 'Ошибка регистрации в системном хранилище сертификата сервера онлайн-проверки.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("СвойстваСертификатаПолучателя, Контекст", Неопределено, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ОтпечатокСертификата = Результат.Отпечаток;
	
	// получаем свойства зарегистрированного в системе сертификата, проверяем сертификат получателя
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст, ОтпечатокСертификата", ВыполняемоеОповещение, Контекст, ОтпечатокСертификата);
	Оповещение = Новый ОписаниеОповещения("ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеПоискаСертификата", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СвойстваСертификатаПолучателя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечатокСертификата, "AddressBook");
		Иначе
			СвойстваСертификатаПолучателя = ПолучитьСвойстваОблачногоСертификата(ОтпечатокСертификата, "AddressBook", Истина);
		КонецЕсли;
		Если СвойстваСертификатаПолучателя <> Неопределено Тогда
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СвойстваСертификатаПолучателя);
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				РезультатПроверки = ПроверитьСертификатНаСервере(СвойстваСертификатаПолучателя, МестоХраненияКлюча);
			Иначе
				РезультатПроверки = СвойстваСертификатаПолучателя.Валиден;
			КонецЕсли;
			СвойстваСертификатаПолучателя.Вставить("Валиден", РезультатПроверки = Истина);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата", Истина, Неопределено, СвойстваСертификатаПолучателя <> Неопределено, СвойстваСертификатаПолучателя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечатокСертификата, "AddressBook", Истина, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИзИнтернетЗарегистрироватьИПроверитьСертификатСервераОнлайнПроверкиПослеПоискаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	
	Если НЕ Результат.Выполнено ИЛИ НЕ Результат.СертификатНайден Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка регистрации в системном хранилище сертификата сервера онлайн-проверки.';
								|en = 'Ошибка регистрации в системном хранилище сертификата сервера онлайн-проверки.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("СвойстваСертификатаПолучателя, Контекст", Неопределено, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
		
	ИначеЕсли НЕ Результат.СвойстваСертификата.Валиден Тогда
		РезультатВыполнения = Новый Структура("СвойстваСертификатаПолучателя, Контекст", Неопределено, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	СвойстваСертификатаПолучателя = Результат.СвойстваСертификата;
	
	Контекст.Вставить("СертификатСервераОнлайнПроверки", ОтпечатокСертификата);
	Контекст.Вставить("СвойстваСертификатаСервераОнлайнПроверки", СвойстваСертификатаПолучателя);
	
	РезультатВыполнения = Новый Структура("СвойстваСертификатаПолучателя, Контекст", СвойстваСертификатаПолучателя, Контекст);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОнлайнПроверкаОтчета_ПодготовкаНаСервере(Контекст)
	
	// различные проверки свойств учетной записи
	УчетнаяЗаписьОрганизации = Контекст.УчетнаяЗапись;
	Если УчетнаяЗаписьОрганизации.ОбменНапрямую Тогда
		ТекстСообщения = НСтр("ru = 'В настройках учетной записи отключен признак обмена через оператора электронного документооборота!
									|Возможность проверки в Интернете доступна только абонентам операторов электронного документооборота ""Калуга Астрал"" и ""Такском"".';
									|en = 'В настройках учетной записи отключен признак обмена через оператора электронного документооборота!
									|Возможность проверки в Интернете доступна только абонентам операторов электронного документооборота ""Калуга Астрал"" и ""Такском"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ УчетнаяЗаписьОрганизации.ИспользоватьСервисОнлайнПроверкиОтчетов Тогда
		ТекстСообщения = НСтр("ru = 'В свойствах учетной записи организации отключена возможность использования сервиса онлайн-проверки отчетности!';
								|en = 'В свойствах учетной записи организации отключена возможность использования сервиса онлайн-проверки отчетности!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем сертификат отправителя
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗаписьОрганизации, "Отпечаток");
	Если НЕ ЗначениеЗаполнено(Сертификат.Отпечаток) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Сертификат.ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем сертификат сервера онлайн-проверки
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Истина Тогда
		Если НЕ ЗначениеЗаполнено(Контекст.ИнформацияОСервереОнлайнПроверки.Отпечаток) Тогда
			ТекстСообщения = НСтр("ru = 'Сертификат сервера онлайн-проверки не получен.';
									|en = 'Сертификат сервера онлайн-проверки не получен.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		ИначеЕсли Контекст.ИнформацияОСервереОнлайнПроверки.ТипРеализации <> "SOAP" ИЛИ Контекст.ИнформацияОСервереОнлайнПроверки.Ресурс = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Контекст.ИнформацияОСервереОнлайнПроверки.Ресурс.Определение) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес сервера онлайн-проверки не получен.';
									|en = 'Адрес сервера онлайн-проверки не получен.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		СертификатСервераОнлайнПроверки = Новый Структура("Отпечаток, Сертификат", Контекст.ИнформацияОСервереОнлайнПроверки.Отпечаток, "");
		
	Иначе
		СертификатСервераОнлайнПроверки = ПолучитьИзИБСертификатСервераОнлайнПроверки();
	КонецЕсли;
	
	// создаем временный каталог, куда поместим файл выгрузки
	ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	Если ТипЗнч(Контекст.ИмяФайлаВыгрузки) = Тип("Строка") Тогда
		
		ИмяВременногоФайлаВыгрузки = ВременныйКаталог + Контекст.ИмяФайлаВыгрузки;
		
		// выгружаем файл выгрузки во временный каталог
		ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(Контекст.АдресФайлаВыгрузки);
		
		Если ДвоичныеДанныеФайлаВыгрузки = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось получить данные отчета.';
									|en = 'Не удалось получить данные отчета.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		Иначе
		ДвоичныеДанныеФайлаВыгрузки.Записать(ИмяВременногоФайлаВыгрузки);
		КонецЕсли;
		
	Иначе
		
		ИменаВременныхФайловВыгрузки = Новый Массив;
		Инд = 0;
		Пока Инд < Контекст.ИмяФайлаВыгрузки.Количество() Цикл
			
			ИмяФайлаВыгрузки = Контекст.ИмяФайлаВыгрузки[Инд];
			
			Если ТипЗнч(Контекст.Документ) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов")
				И Контекст.Документ.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НДС
				И СтрНайти(ИмяФайлаВыгрузки, "NO_NDS_") <> 1 Тогда
				
				Контекст.ИмяФайлаВыгрузки.Удалить(Инд);
				
				Если ТипЗнч(Контекст.АдресФайлаВыгрузки) = Тип("Массив") Тогда
					УдалитьИзВременногоХранилища(Контекст.АдресФайлаВыгрузки[Инд]);
					Контекст.АдресФайлаВыгрузки.Удалить(Инд);
				КонецЕсли;
				
				Если ТипЗнч(Контекст.Документы) = Тип("Массив") Тогда
					ДанныеДокумента = Контекст.Документы[Инд];
					Если ТипЗнч(ДанныеДокумента) = Тип("Структура")
						И ЭтоАдресВременногоХранилища(ДанныеДокумента.АдресФайлаВыгрузки) Тогда
						
						УдалитьИзВременногоХранилища(ДанныеДокумента.АдресФайлаВыгрузки);
					КонецЕсли;
					Контекст.Документы.Удалить(Инд);
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			ИмяВременногоФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
			
			// выгружаем файл выгрузки во временный каталог
			Если ТипЗнч(Контекст.АдресФайлаВыгрузки) = Тип("Массив") Тогда
				АдресФайлаВыгрузки = Контекст.АдресФайлаВыгрузки[Инд];
				ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(АдресФайлаВыгрузки);
				ДвоичныеДанныеФайлаВыгрузки.Записать(ИмяВременногоФайлаВыгрузки);
			ИначеЕсли ТипЗнч(Контекст.Документы) = Тип("Массив") Тогда
				
				ДанныеДокумента = Контекст.Документы[Инд];
				Если ТипЗнч(ДанныеДокумента) = Тип("Структура") Тогда
					АдресФайлаВыгрузки = ДанныеДокумента.АдресФайлаВыгрузки;
					
					Если ЭтоАдресВременногоХранилища(АдресФайлаВыгрузки) Тогда
						ДвДанные = ПолучитьИзВременногоХранилища(АдресФайлаВыгрузки);
						ДвДанные.Записать(ИмяВременногоФайлаВыгрузки);
					Иначе
						ТекстСообщения = НСтр("ru = 'Файл выгрузки не найден.';
												|en = 'Файл выгрузки не найден.'");
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						Возврат Ложь;
					КонецЕсли;
					
				Иначе
					ТекстВыгрузки = Контекст.Документы[Инд];
					
					ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайлаВыгрузки, Контекст.КодировкаФайла);
					ОбъектЗаписьТекста.Записать(ТекстВыгрузки);
					ОбъектЗаписьТекста.Закрыть();
				КонецЕсли;
				
			КонецЕсли;
			
			ИменаВременныхФайловВыгрузки.Добавить(ИмяВременногоФайлаВыгрузки);
			Инд = Инд + 1;
			
		КонецЦикла;
		
		ИмяВременногоФайлаВыгрузки = ИменаВременныхФайловВыгрузки;
		
	КонецЕсли;
	
	Если Контекст.ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате <> Истина Тогда
		
		// архивируем файл выгрузки
		ИмяФайлаАрхива = ПолучитьИмяВременногоФайла();
		РезультатАрхивирования = ЗаархивироватьФайл(ИмяВременногоФайлаВыгрузки, ИмяФайлаАрхива);
		МассивОписанийИДанных = ОбщегоНазначенияЭДКО.МассивОписанийИДанныхZipФайла(ИмяФайлаАрхива);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаАрхива);
		ИмяФайлаАрхива = ПолучитьИмяВременногоФайла();
		ОбщегоНазначенияЭДКО.СформироватьZip(МассивОписанийИДанных, ИмяФайлаАрхива, "cp866");
		
		Если РезультатАрхивирования Тогда
			// сохраняем во временное хранилище
			АдресАрхиваФайлаВыгрузки = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаАрхива), Контекст.УникальныйИдентификатор);
		КонецЕсли;
		
	Иначе
		
		Если ТипЗнч(ИмяВременногоФайлаВыгрузки) = Тип("Строка") Тогда
			ИменаВременныхФайловВыгрузки = Новый Массив;
			ИменаВременныхФайловВыгрузки.Добавить(ИмяВременногоФайлаВыгрузки);
		Иначе
			ИменаВременныхФайловВыгрузки = ИмяВременногоФайлаВыгрузки;
		КонецЕсли;
		
		РезультатАрхивирования = Истина;
		АдресаАрхивовФайловВыгрузки = Новый Массив;
		
		Для Каждого ИмяВременногоФайлаВыгрузки Из ИменаВременныхФайловВыгрузки Цикл
			// архивируем файл выгрузки
			ИмяФайлаАрхива = ПолучитьИмяВременногоФайла();
			РезультатАрхивирования = ЗаархивироватьФайл(ИмяВременногоФайлаВыгрузки, ИмяФайлаАрхива);
			Если НЕ РезультатАрхивирования Тогда
				Прервать;
			КонецЕсли;
			
			// сохраняем во временное хранилище
			АдресАрхиваФайлаВыгрузки = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаАрхива), Контекст.УникальныйИдентификатор);
			АдресаАрхивовФайловВыгрузки.Добавить(АдресАрхиваФайлаВыгрузки);
		КонецЦикла;
		
		АдресАрхиваФайлаВыгрузки = АдресаАрхивовФайловВыгрузки;
		
	КонецЕсли;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
	Если НЕ РезультатАрхивирования Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//
	Контекст.Вставить("СертификатОтправителя", Сертификат.Отпечаток);
	Контекст.Вставить("СертификатСервераОнлайнПроверки", СертификатСервераОнлайнПроверки);
	Контекст.Вставить("АдресАрхиваФайлаВыгрузки", АдресАрхиваФайлаВыгрузки);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрование(Контекст, ВыполняемоеОповещение)
	
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	СертификатОтправителя = Контекст.СертификатОтправителя;
	СертификатПолучателя = Контекст.СертификатСервераОнлайнПроверки;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	///////////////////////////////////////////////////////////////////////////////
	// РАБОТА С СЕРТИФИКАТОМ ОТПРАВИТЕЛЯ
	
	// получаем свойства сертификата
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст, УчетнаяЗапись, СертификатПолучателя, ИдентификаторДокументооборота", ВыполняемоеОповещение, Контекст, УчетнаяЗапись, СертификатПолучателя, ИдентификаторДокументооборота);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	Оповещение = Новый ОписаниеОповещения("ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПоискаСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	НовыйСертификат = Новый Структура("Отпечаток", СертификатОтправителя);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
	КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, НовыйСертификат, Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеПоискаСертификатаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	
	Если НЕ Результат.Выполнено ИЛИ НЕ Результат.СертификатНайден Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось получить свойства сертификата учетной записи %1 для шифрования.
						|Вероятно, сертификат не зарегистрирован в системном хранилище.';
						|en = 'Не удалось получить свойства сертификата учетной записи %1 для шифрования.
						|Вероятно, сертификат не зарегистрирован в системном хранилище.'"), Символ(34) + УчетнаяЗапись + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	ИначеЕсли НЕ Результат.СвойстваСертификата.Валиден Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Сертификат для шифрования учетной записи %1 не прошел проверку валидности.';
				|en = 'Сертификат для шифрования учетной записи %1 не прошел проверку валидности.'"),
			Символ(34) + УчетнаяЗапись + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		РезультатВыполнения = Новый Структура("РезультатПроверки, Контекст", Ложь, Контекст);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	СвойстваСертификатаОтправителя = Результат.СвойстваСертификата;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СвойстваСертификатаОтправителя);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, Контекст, УчетнаяЗапись, СертификатПолучателя, ИдентификаторДокументооборота", ВыполняемоеОповещение, Контекст, УчетнаяЗапись, СертификатПолучателя, ИдентификаторДокументооборота);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеЭкспортаСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СвойстваСертификатаОтправителя, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОнлайнПроверкаОтчета_УстановкаИПроверкаСертификатовИШифрованиеПослеЭкспортаСертификатаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	Контекст = ДополнительныеПараметры.Контекст;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	СертификатПолучателя = ДополнительныеПараметры.СертификатПолучателя;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИдентификаторДокументооборота = ДополнительныеПараметры.ИдентификаторДокументооборота;
	
	Если НЕ Результат.Выполнено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось экспортировать в файл сертификат отправителя для шифрования!';
								|en = 'Не удалось экспортировать в файл сертификат отправителя для шифрования!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
