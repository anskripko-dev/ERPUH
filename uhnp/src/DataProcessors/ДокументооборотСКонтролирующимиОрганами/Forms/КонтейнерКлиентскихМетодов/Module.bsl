&НаСервереБезКонтекста
Функция ПолучитьСвойстваОтделенийПФРИзИБ(КодыОтделенийПФР)
	
	// создаем массив-результат
	СведенияОбОтделениях = Новый Массив;
	
	// получаем из ИБ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОрганыПФР.Код,
	                      |	ОрганыПФР.Наименование,
	                      |	ОрганыПФР.Сертификаты.(
	                      |		Сертификат
	                      |	),
	                      |	ОрганыПФР.СертификатыЭДОК.(
	                      |		Сертификат
	                      |	),
	                      |	ОрганыПФР.СертификатыЕЦП.(
	                      |		Сертификат
	                      |	)
	                      |ИЗ
	                      |	Справочник.ОрганыПФР КАК ОрганыПФР
	                      |ГДЕ
	                      |	ОрганыПФР.Код В(&Код)");
	Запрос.УстановитьПараметр("Код", КодыОтделенийПФР);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// формируем результат
	Пока Выборка.Следующий() Цикл
		
		СертификатыОрганаПФР = Новый Массив;
		ВыборкаСертификаты = Выборка.Сертификаты.Выбрать();
		Пока ВыборкаСертификаты.Следующий() Цикл
			СертификатыОрганаПФР.Добавить(СокрЛП(ВыборкаСертификаты.Сертификат));
		КонецЦикла;
		СертификатыОрганаПФРЭДОК = Новый Массив;
		ВыборкаСертификатыЭДОК = Выборка.СертификатыЭДОК.Выбрать();
		Пока ВыборкаСертификатыЭДОК.Следующий() Цикл
			СертификатыОрганаПФРЭДОК.Добавить(СокрЛП(ВыборкаСертификатыЭДОК.Сертификат));
		КонецЦикла;
		СертификатыОрганаПФРЕЦП = Новый Массив;
		ВыборкаСертификатыЕЦП = Выборка.СертификатыЕЦП.Выбрать();
		Пока ВыборкаСертификатыЕЦП.Следующий() Цикл
			СертификатыОрганаПФРЕЦП.Добавить(СокрЛП(ВыборкаСертификатыЕЦП.Сертификат));
		КонецЦикла;
		СведенияОбОтделениях.Добавить(Новый Структура("Код, Наименование, Сертификаты, СертификатыЭДОК, СертификатыЕЦП",
			СокрЛП(Выборка.Код), СокрЛП(Выборка.Наименование), СертификатыОрганаПФР, СертификатыОрганаПФРЭДОК,
			СертификатыОрганаПФРЕЦП));
	КонецЦикла;
	
	Возврат СведенияОбОтделениях;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправлений(НастройкиИБ, НастройкиРОКИ, ВыполняемоеОповещение)
	
	Исправления = Новый Массив;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСФНС <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСФНС Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСФНС", НастройкиИБ.ПредназначенаДляДокументооборотаСФНС, НастройкиРОКИ.ПредназначенаДляДокументооборотаСФНС, "Изменен признак возможности документооборота с ФНС по учетной записи");
	КонецЕсли;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСПФР <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСПФР Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСПФР", НастройкиИБ.ПредназначенаДляДокументооборотаСПФР, НастройкиРОКИ.ПредназначенаДляДокументооборотаСПФР, "Изменен признак возможности документооборота с СФР (бывш. ПФР) по учетной записи");
	КонецЕсли;
	
	Если НастройкиИБ.ПредназначенаДляДокументооборотаСФСГС <> НастройкиРОКИ.ПредназначенаДляДокументооборотаСФСГС Тогда
		ОпределитьИзменение(Исправления, "ИзменитьПризнакДокументооборотаСФСГС", НастройкиИБ.ПредназначенаДляДокументооборотаСФСГС, НастройкиРОКИ.ПредназначенаДляДокументооборотаСФСГС, "Изменен признак возможности документооборота с Росстатом по учетной записи");
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИспользуетсяЕЦППФР") Тогда
		Если нрег(НастройкиИБ.ИспользуетсяЕЦППФР) <> нрег(НастройкиРОКИ.ИспользуетсяЕЦППФР) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИспользуетсяЕЦППФР", НастройкиИБ.ИспользуетсяЕЦППФР, НастройкиРОКИ.ИспользуетсяЕЦППФР, "В настройках учетной записи изменен признак возможности отправки в ЕЦП СФР (бывш. ПФР)");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ТипыДокументовЕЦППФР") Тогда
		Если нрег(НастройкиИБ.ТипыДокументовЕЦППФР) <> нрег(НастройкиРОКИ.ТипыДокументовЕЦППФР) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьТипыДокументовЕЦППФР", НастройкиИБ.ТипыДокументовЕЦППФР, НастройкиРОКИ.ТипыДокументовЕЦППФР, "В настройках учетной записи изменены типы документов, отправляемых в ЕЦП СФР (бывш. ПФР)");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ОператорРегНомерПФР") Тогда
		Если нрег(НастройкиИБ.ОператорРегНомерПФР) <> нрег(НастройкиРОКИ.ОператорРегНомерПФР) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОператорРегНомерПФР", НастройкиИБ.ОператорРегНомерПФР, НастройкиРОКИ.ОператорРегНомерПФР, "В настройках учетной записи изменен регистрационный номер СФР (бывш. ПФР) оператора");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ОператорНаименованиеПолное") Тогда
		Если нрег(НастройкиИБ.ОператорНаименованиеПолное) <> нрег(НастройкиРОКИ.ОператорНаименованиеПолное) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОператорНаименованиеПолное", НастройкиИБ.ОператорНаименованиеПолное, НастройкиРОКИ.ОператорНаименованиеПолное, "В настройках учетной записи изменено полное наименование оператора");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ОператорНаименованиеКраткое") Тогда
		Если нрег(НастройкиИБ.ОператорНаименованиеКраткое) <> нрег(НастройкиРОКИ.ОператорНаименованиеКраткое) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОператорНаименованиеКраткое", НастройкиИБ.ОператорНаименованиеКраткое, НастройкиРОКИ.ОператорНаименованиеКраткое, "В настройках учетной записи изменено краткое наименование оператора");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ОператорИНН") Тогда
		Если нрег(НастройкиИБ.ОператорИНН) <> нрег(НастройкиРОКИ.ОператорИНН) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОператорИНН", НастройкиИБ.ОператорИНН, НастройкиРОКИ.ОператорИНН, "В настройках учетной записи изменен ИНН оператора");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ОператорКПП") Тогда
		Если нрег(НастройкиИБ.ОператорКПП) <> нрег(НастройкиРОКИ.ОператорКПП) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОператорКПП", НастройкиИБ.ОператорКПП, НастройкиРОКИ.ОператорКПП, "В настройках учетной записи изменен КПП оператора");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресЭлектроннойПочты") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочты) <> нрег(НастройкиРОКИ.АдресЭлектроннойПочты) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресЭлектроннойПочты", НастройкиИБ.АдресЭлектроннойПочты, НастройкиРОКИ.АдресЭлектроннойПочты, "В настройках учетной записи изменен адрес электронной почты");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИдентификаторАбонента") Тогда
		Если СокрЛП(НастройкиИБ.ИдентификаторАбонента) <> СокрЛП(НастройкиРОКИ.ИдентификаторАбонента) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИдентификаторАбонента", НастройкиИБ.ИдентификаторАбонента, НастройкиРОКИ.ИдентификаторАбонента, "В настройках учетной записи изменен идентификатор абонента");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИдентификаторСпецоператора") Тогда
		Если СокрЛП(НастройкиИБ.ИдентификаторСпецоператора) <> СокрЛП(НастройкиРОКИ.ИдентификаторСпецоператора) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИдентификаторСпецоператора", НастройкиИБ.ИдентификаторСпецоператора, НастройкиРОКИ.ИдентификаторСпецоператора, "В настройках учетной записи изменен идентификатор оператора электронного документооборота");
		КонецЕсли;
	КонецЕсли;
	
	// свойства сервера документооборота
	Если НастройкиРОКИ.Свойство("АдресСпецоператора") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервера) <> нрег(НастройкиРОКИ.АдресСпецоператора) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервера", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервера, НастройкиРОКИ.АдресСпецоператора, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с ФНС");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресСпецоператораПФР") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераПФР) <> нрег(НастройкиРОКИ.АдресСпецоператораПФР) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервераПФР", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераПФР, НастройкиРОКИ.АдресСпецоператораПФР, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с СФР (бывш. ПФР)");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("АдресСпецоператораФСГС") Тогда
		Если нрег(НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераФСГС) <> нрег(НастройкиРОКИ.АдресСпецоператораФСГС) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьАдресПочтовогоСервераФСГС", НастройкиИБ.АдресЭлектроннойПочтыПочтовогоСервераФСГС, НастройкиРОКИ.АдресСпецоператораФСГС, "В настройках сервера документооборота изменен адрес электронной почты для документооборота с Росстатом");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("СертификатСОС") Тогда
		Если нрег(НастройкиИБ.СертификатПочтовогоСервера) <> нрег(НастройкиРОКИ.СертификатСОС.Отпечаток) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСертификатПочтовогоСервера", нрег(НастройкиИБ.СертификатПочтовогоСервера), НастройкиРОКИ.СертификатСОС, "В настройках сервера документооборота изменен сертификат");
		КонецЕсли;
	КонецЕсли;
	
	// настройки доступа по POP3
	Если НастройкиРОКИ.Свойство("СерверPOP3") Тогда
		Если нрег(НастройкиИБ.СерверPOP3) <> нрег(НастройкиРОКИ.СерверPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСерверPOP3", НастройкиИБ.СерверPOP3, НастройкиРОКИ.СерверPOP3, "В настройках учетной записи изменен адрес сервера POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПортPOP3") Тогда
		Если нрег(НастройкиИБ.ПортPOP3) <> нрег(НастройкиРОКИ.ПортPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПортPOP3", НастройкиИБ.ПортPOP3, НастройкиРОКИ.ПортPOP3, "В настройках учетной записи изменен порт сервера POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ИмяПользователяPOP3") Тогда
		Если нрег(НастройкиИБ.ИмяПользователяPOP3) <> нрег(НастройкиРОКИ.ИмяПользователяPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьИмяПользователяPOP3", НастройкиИБ.ИмяПользователяPOP3, НастройкиРОКИ.ИмяПользователяPOP3, "В настройках учетной записи изменено имя пользователя POP3");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПарольPOP3") Тогда
		Если нрег(НастройкиИБ.ПарольPOP3) <> нрег(НастройкиРОКИ.ПарольPOP3) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПарольPOP3", НастройкиИБ.ПарольPOP3, НастройкиРОКИ.ПарольPOP3, "В настройках учетной записи изменен пароль POP3");
		КонецЕсли;
	КонецЕсли;
	
	// настройки доступа по SMTP
	Если НастройкиРОКИ.Свойство("СерверSMTP") Тогда
		Если нрег(НастройкиИБ.СерверSMTP) <> нрег(НастройкиРОКИ.СерверSMTP) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьСерверSMTP", НастройкиИБ.СерверSMTP, НастройкиРОКИ.СерверSMTP, "В настройках учетной записи изменен адрес сервера SMTP");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиРОКИ.Свойство("ПортSMTP") Тогда
		Если нрег(НастройкиИБ.ПортSMTP) <> нрег(НастройкиРОКИ.ПортSMTP) Тогда
			ОпределитьИзменение(Исправления, "ИзменитьПортSMTP", НастройкиИБ.ПортSMTP, НастройкиРОКИ.ПортSMTP, "В настройках учетной записи изменен порт сервера SMTP");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиИБ.ТребуетсяSMTPАутентификация Тогда // считается, что аутентификация на сервере SMTP не требуется никогда
		ОпределитьИзменение(Исправления, "ИзменитьФлагТребуетсяSMTPАутентификация", Истина, Ложь, "В настройках учетной записи изменен признак необходимости аутентификации на сервере SMTP");
	КонецЕсли;
	
	// проверяем необходимость обновления информации о сертификатах ответственных лиц организации
	Если НастройкиРОКИ.Свойство("Сертификаты") И ТипЗнч(НастройкиРОКИ.Сертификаты) = Тип("Массив") Тогда
		
		АбонентскиеСертификаты = НастройкиРОКИ.Сертификаты;
		
		// проверяем сертификат руководителя
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатРуководителя) Тогда //+
			
			// сначала ищем сертификат руководителя
			СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 1);
			
			// если не найден - сертификат ответственного за шифрование
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			
			// если сертификат ответственного не найден, то ищем сертификат главного бухгалтера
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			КонецЕсли;
			
			// если и сертификат главного бухгалтера не найден, то берем первый в списке
			Если СертификатыРуководителя.Количество() = 0 Тогда
				Если АбонентскиеСертификаты.Количество() > 0 Тогда
					СертификатыРуководителя = Новый Массив;
					СертификатыРуководителя.Добавить(АбонентскиеСертификаты[0]);
				КонецЕсли;
			КонецЕсли;
			
			Если СертификатыРуководителя.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления,
									"ИзменитьСертификатРуководителя",
									нрег(НастройкиИБ.СертификатРуководителя),//+
									СертификатыРуководителя[0], 
									"В настройках учетной записи изменен сертификат руководителя");
			КонецЕсли;
			
		Иначе
			СертификатИБВСписке = Ложь;
			
			// сначала ищем сертификат руководителя
			СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 1);
			
			// если не найден - сертификат ответственного за шифрование
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			
			// если сертификат ответственного не найден, то ищем сертификат главного бухгалтера
			Если СертификатыРуководителя.Количество() = 0 Тогда
				СертификатыРуководителя = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			КонецЕсли;
			
			// если и сертификат главного бухгалтера не найден, то берем первый в списке
			Если СертификатыРуководителя.Количество() = 0 Тогда
				Если АбонентскиеСертификаты.Количество() > 0 Тогда
					СертификатыРуководителя = Новый Массив;
					СертификатыРуководителя.Добавить(АбонентскиеСертификаты[0]);
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого Сертификат Из СертификатыРуководителя Цикл
				Если нрег(Сертификат.Отпечаток) = нрег(НастройкиИБ.СертификатРуководителя) Тогда //+
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				Если СертификатыРуководителя.Количество() = 0 Тогда
					НовоеЗначение = Новый Структура("Отпечаток");
				Иначе
					НовоеЗначение = СертификатыРуководителя[0];
				КонецЕсли;
				ОпределитьИзменение(Исправления, "ИзменитьСертификатРуководителя", нрег(НастройкиИБ.СертификатРуководителя), НовоеЗначение, "В настройках учетной записи изменен сертификат руководителя"); //+
			КонецЕсли;
			
		КонецЕсли;
		
		// проверяем сертификат главного бухгалтера
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатГлавногоБухгалтера) Тогда
			СертификатыБухгалтера = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			Если СертификатыБухгалтера.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления,
									"ИзменитьСертификатГлавногоБухгалтера",
									нрег(НастройкиИБ.СертификатГлавногоБухгалтера),
									СертификатыБухгалтера[0],
									"В настройках учетной записи изменен сертификат главного бухгалтера");
			КонецЕсли;
		Иначе
			СертификатИБВСписке = Ложь;
			СертификатыБухгалтера = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 2);
			Для Каждого СертификатБухгалтера Из СертификатыБухгалтера Цикл
				Если нрег(СертификатБухгалтера.Отпечаток) = нрег(НастройкиИБ.СертификатГлавногоБухгалтера) Тогда
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				Если СертификатыБухгалтера.Количество() = 0 Тогда
					НовоеЗначение = Новый Структура("Отпечаток");
				Иначе
					НовоеЗначение = СертификатыБухгалтера[0];
				КонецЕсли;
				ОпределитьИзменение(Исправления, "ИзменитьСертификатГлавногоБухгалтера", нрег(НастройкиИБ.СертификатГлавногоБухгалтера), НовоеЗначение, "В настройках учетной записи изменен сертификат главного бухгалтера");
			КонецЕсли;
		КонецЕсли;
		
		// проверяем сертификат ответственного за шифрование
		Если НЕ ЗначениеЗаполнено(НастройкиИБ.СертификатДляШифрования) Тогда
			СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ПризнакШифрования", Истина);
			Если СертификатыДляШифрования.Количество() = 0 Тогда
				СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			Если СертификатыДляШифрования.Количество() > 0 Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатДляШифрования", нрег(НастройкиИБ.СертификатДляШифрования), СертификатыДляШифрования[0], "В настройках учетной записи изменен сертификат для шифрования");
			КонецЕсли;
		Иначе
			СертификатИБВСписке = Ложь;
			СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ПризнакШифрования", Истина);
			Если СертификатыДляШифрования.Количество() = 0 Тогда
				СертификатыДляШифрования = НайтиСтрокиМассиваСтруктур(АбонентскиеСертификаты, "ТипПодписи", 3);
			КонецЕсли;
			Для Каждого СертификатДляШифрования Из СертификатыДляШифрования Цикл
				Если нрег(СертификатДляШифрования.Отпечаток) = нрег(НастройкиИБ.СертификатДляШифрования) Тогда
					СертификатИБВСписке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ СертификатИБВСписке Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатДляШифрования", нрег(НастройкиИБ.СертификатДляШифрования), СертификатыДляШифрования[0], "В настройках учетной записи изменен сертификат для шифрования");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка ИФНС
	ПроверкаИФНС = НастройкиРОКИ.Свойство("ИФНСы") И ТипЗнч(НастройкиРОКИ.ИФНСы) = Тип("Массив");
	Если ПроверкаИФНС Тогда
		
		// проверка основной ИФНС
		ИФНСы = НастройкиРОКИ.ИФНСы;
		Если ИФНСы.Количество() = 1 Тогда
			ОсновнаяИФНС = ИФНСы[0];
		Иначе
			ОсновнаяИФНС = НайтиСтрокуВМассивеСтруктурКлиент(ИФНСы, Истина,"ИФНСПоУмолчанию");
		КонецЕсли;
		Если НастройкиИБ.КодНалоговогоОргана <> ОсновнаяИФНС.Код Тогда
			ОпределитьИзменение(Исправления, "ИзменитьОсновнуюИФНС", нрег(НастройкиИБ.КодНалоговогоОргана), ОсновнаяИФНС, "В настройках учетной записи изменен налоговый орган");
		КонецЕсли;
		
		// формируем массив кодов ИФНС, задействованных по данным РОКИ
		МассивКодовИФНС = ВыгрузитьКолонкуИзМассиваСтруктур(ИФНСы, "Код");
		
		// получаем из базы информацию об этих отделениях ПФР
		СведенияИзИБ = ПолучитьСвойстваИФНСИзИБ(МассивКодовИФНС);
		
		// создание кэша зарегистрированных в хранилище сертификатов
		
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ);
		Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовAddressBookЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ДополнительныеПараметрыМетода = Новый Структура;
		ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
		ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
		
		КриптографияЭДКОКлиент.ПолучитьСертификаты(
			Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "AddressBook", Истина), ДополнительныеПараметрыМетода);
		Возврат;
		
	КонецЕсли;
	
	Результат = Новый Структура("Выполнено, МенеджерКриптографии", Ложь, Неопределено);
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook, МассивСертификатовCA", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, Неопределено, Неопределено);
	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовAddressBookЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиИБ = ДополнительныеПараметры.НастройкиИБ;
	НастройкиРОКИ = ДополнительныеПараметры.НастройкиРОКИ;
	Исправления = ДополнительныеПараметры.Исправления;
	ПроверкаИФНС = ДополнительныеПараметры.ПроверкаИФНС;
	ИФНСы = ДополнительныеПараметры.ИФНСы;
	ОсновнаяИФНС = ДополнительныеПараметры.ОсновнаяИФНС;
	СведенияИзИБ = ДополнительныеПараметры.СведенияИзИБ;
	
	МассивСертификатовAddressBook = Новый Массив;
	Если Результат.Выполнено Тогда
		Для каждого СертификатХранилища Из Результат.Сертификаты Цикл
			МассивСертификатовAddressBook.Добавить(нрег(СокрЛП(СертификатХранилища.Отпечаток)));
		КонецЦикла;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook", ВыполняемоеОповещение, НастройкиИБ, НастройкиРОКИ, Исправления, ПроверкаИФНС, ИФНСы, ОсновнаяИФНС, СведенияИзИБ, МассивСертификатовAddressBook);
	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовCAЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(
		Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "CA", Истина), ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовCAЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
