	Возврат КонтекстЭДО.АдресSOAPЗапросОперацииСЭДОФССПоПодписи(
		РегистрационныйНомерФСС,
		ВыгрузкаЗапроса,
		ПодписьЗапросаЭЛН64,
		СертификатПолучателя64,
		НастройкиОперации);
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресПодписанногоSOAPОперацииСЭДОФССИнициализацияНаСервере(
		Знач ОрганизацияСсылка,
		Знач ВыгрузкаЗапросаОперацииСЭЛН,
		Знач ДобавляемыеАтрибутыЗапроса,
		Знач РегистрационныйНомерФСС,
		Знач ПолучитьСертификатФССЭЛН = Ложь,
		Знач СвойстваОбменаПоСЭДОЧерезОператора = Неопределено,
		Знач Настройки = Неопределено)
	
	ЗапросОперацииСЭДО64 = ЗапросОперацииСЭДОФССДляПодписиSOAP64(
		ВыгрузкаЗапросаОперацииСЭЛН);
	
	Если ЗапросОперацииСЭДО64 = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Данные операции СЭДО не заполнены';
													|en = 'Данные операции СЭДО не заполнены'"));
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МЧДОтпечатокРуководителя = ДокументооборотСКОВызовСервера.ЗапоминаниеОшибок(,, Истина, "МЧДОтпечатокРуководителя");
	Если ЗначениеЗаполнено(МЧДОтпечатокРуководителя) Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Ложь);
	Иначе
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	КонецЕсли;
	УчетнаяЗапись = РеквизитыУчетнойЗаписи.Ссылка;
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ДвоичныеДанныеЗапросаОперацииСЭЛН = Base64Значение(ЗапросОперацииСЭДО64);
		ЗапросОперацииСЭДО64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗапросаОперацииСЭЛН, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
	Если ОтпечаткиСертификатов = Неопределено
		ИЛИ (НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток)
			И (Настройки = Неопределено ИЛИ НЕ Настройки.Свойство("СодержимоеПодписанногоЗапросаSOAP"))) Тогда
		
		ТекстСообщения = НСтр("ru = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности';
								|en = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности'");
		ТекстСообщения = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстСообщения, Истина);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПолучитьСертификатФССЭЛН Тогда
		Если СвойстваОбменаПоСЭДОЧерезОператора <> Неопределено
			И НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			
			СвойстваОрганизацииИУчетнойЗаписи = СвойстваОбменаПоСЭДОЧерезОператора.СвойстваОрганизацииИУчетнойЗаписи;
			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток = ?(СвойстваОрганизацииИУчетнойЗаписи <> Неопределено
				И ЗначениеЗаполнено(СвойстваОрганизацииИУчетнойЗаписи.СерверДокументооборота),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СвойстваОрганизацииИУчетнойЗаписи.СерверДокументооборота, "Сертификат"),
				"");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток)
			И ДокументооборотСКОВызовСервера.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") <> Истина Тогда
			
			Если СвойстваОбменаПоСЭДОЧерезОператора = Неопределено
				ИЛИ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
				ТекстСообщения = НСтр("ru = 'Не выбран сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО в настройках обмена с ФСС для 1С-Отчетности';
										|en = 'Не выбран сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО в настройках обмена с ФСС для 1С-Отчетности'");
				ТекстСообщения = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстСообщения, Истина);
			Иначе
				ТекстСообщения = НСтр("ru = 'Не указан сертификат сервера документооборота в свойствах учетной записи 1С-Отчетности';
										|en = 'Не указан сертификат сервера документооборота в свойствах учетной записи 1С-Отчетности'");
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СертификатСтрахователя = Неопределено;
	СертификатФСССЭДО = Неопределено;
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Если Настройки = Неопределено ИЛИ НЕ Настройки.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(
					ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
			Иначе
				СертификатСтрахователя = ПолучитьСвойстваОблачногоСертификата(
					ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY");
			КонецЕсли;
			Если СертификатСтрахователя = Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найден сертификат страхователя';
															|en = 'Не найден сертификат страхователя'"));
				Возврат Неопределено;
			КонецЕсли;
			
			СертификатСтрахователя.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
		КонецЕсли;
		
		Если ПолучитьСертификатФССЭЛН Тогда
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				СертификатФСССЭДО = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
			Иначе
				СертификатФСССЭДО = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
			КонецЕсли;
			Если СертификатФСССЭДО = Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найден сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО';
															|en = 'Не найден сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО'"));
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЗапросОперацииСЭДО64", 					ЗапросОперацииСЭДО64);
	Результат.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	Результат.Вставить("СертификатСтрахователяОтпечаток", 		ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
	Результат.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	Результат.Вставить("СертификатФСССЭДООтпечаток", 			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
	Результат.Вставить("СертификатФСССЭДО", 					СертификатФСССЭДО);
	Результат.Вставить("ТестовыйСерверФСССЭДО", 				ОтпечаткиСертификатов.ТестовыйСерверФССЭЛН);
	Результат.Вставить("МЧД", 									ОтпечаткиСертификатов.МЧД);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция АдресПодписанногоSOAPОперацииСЭЛНВФССИнициализацияНаСервере(
		Знач ОрганизацияСсылка,
		Знач ВыгрузкаЗапросаОперацииСЭЛН,
		Знач ДобавляемыеАтрибутыЗапроса,
		Знач РегистрационныйНомерФСС,
		Знач ПолучитьСертификатФССЭЛН = Ложь)
	
	ЗапросОперацииСЭЛН64 = ЗапросОперацииСЭЛНДляПодписиSOAP64НаСервере(
		ВыгрузкаЗапросаОперацииСЭЛН,
		ДобавляемыеАтрибутыЗапроса,
		РегистрационныйНомерФСС);
	Если ЗапросОперацииСЭЛН64 = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Больничный лист не заполнен';
													|en = 'Больничный лист не заполнен'"));
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	УчетнаяЗапись = РеквизитыУчетнойЗаписи.Ссылка;
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
		ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		ДвоичныеДанныеЗапросаОперацииСЭЛН = Base64Значение(ЗапросОперацииСЭЛН64);
		ЗапросОперацииСЭЛН64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗапросаОперацииСЭЛН, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
	Если ОтпечаткиСертификатов = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности';
				|en = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности'"));
		Возврат Неопределено;
	КонецЕсли;
	Если ПолучитьСертификатФССЭЛН И НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не выбран сертификат ФСС ЭЛН в настройках обмена с ФСС для 1С-Отчетности';
				|en = 'Не выбран сертификат ФСС ЭЛН в настройках обмена с ФСС для 1С-Отчетности'"));
		Возврат Неопределено;
	КонецЕсли;
	
	СертификатСтрахователя = Неопределено;
	СертификатФССЭЛН = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
		ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		Иначе
			СертификатСтрахователя = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY");
		КонецЕсли;
		Если СертификатСтрахователя = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найден сертификат страхователя';
														|en = 'Не найден сертификат страхователя'"));
			Возврат Неопределено;
		КонецЕсли;
		
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
		СертификатСтрахователя.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
		
		Если ПолучитьСертификатФССЭЛН Тогда
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				СертификатФССЭЛН = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
			Иначе
				СертификатФССЭЛН = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
			КонецЕсли;
			Если СертификатФССЭЛН = Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найден сертификат ФСС ЭЛН';
															|en = 'Не найден сертификат ФСС ЭЛН'"));
				Возврат Неопределено;
			КонецЕсли;
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатФССЭЛН);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЗапросОперацииСЭЛН64", 					ЗапросОперацииСЭЛН64);
	Результат.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	Результат.Вставить("СертификатСтрахователяОтпечаток", 		ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
	Результат.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	Результат.Вставить("СертификатФССЭЛНОтпечаток", 			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
	Результат.Вставить("СертификатФССЭЛН", 						СертификатФССЭЛН);
	Результат.Вставить("ТестовыйСерверФССЭЛН", 					ОтпечаткиСертификатов.ТестовыйСерверФССЭЛН);
	Результат.Вставить("МЧД", 									ОтпечаткиСертификатов.МЧД);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, Результат);
	
	Возврат Результат;
	
КонецФункции

#Область АдресПодписанногоSOAPОперацииСЭЛНВФСС

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФСС(
		ВыполняемоеОповещение,
		ВыгрузкаЗапросаОперацииСЭЛН,
		ЗашифроватьSOAP = Истина) Экспорт
	
	ОрганизацияИспользуетОбменСФСС 						= Ложь;
	ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи 	= Ложь;
	НастроенОбменВУниверсальномФормате 					= Ложь;
	УчетнаяЗаписьДокументооборота 						= Неопределено;
	
	ПараметрыФорматов = Новый Структура("ПараметрыФорматаЭЛН", Неопределено);
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		ВыгрузкаЗапросаОперацииСЭЛН.Организация,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи,
		УчетнаяЗаписьДокументооборота,
		ПараметрыФорматов);
	
	Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
		ПоказатьОшибкуЕслиОрганизацияНеИспользуетОбменСФСС(ВыгрузкаЗапросаОперацииСЭЛН.Организация, ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ВыполнятьАвтонастройку = 
		НастроенОбменВУниверсальномФормате 
		И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапросаОперацииСЭЛН", ВыгрузкаЗапросаОперацииСЭЛН);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 			ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("ПараметрыФормата", 			ПараметрыФорматов.ПараметрыФорматаЭЛН);
	ДополнительныеПараметры.Вставить("ВыполнятьАвтонастройку", 		ВыполнятьАвтонастройку);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ВыполнятьАвтонастройку Тогда
		АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗаписьДокументооборота, , Оповещение, , , Истина);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПроверкиЛицензииИСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	Если ВходящийКонтекст.ВыполнятьАвтонастройку Тогда
		
		Организация = ВходящийКонтекст.ВыгрузкаЗапросаОперацииСЭЛН.Организация;
		
		ПроверитьСертификатИЛицензию(
			ОписаниеОповещения, 
			Неопределено, 
			Организация, 
			"ФСС");
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПроверкиЛицензииИСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыгрузкаЗапросаОперацииСЭЛН = ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭЛН;
	ЗашифроватьSOAP 			= ДополнительныеПараметры.ЗашифроватьSOAP;
	ПараметрыФормата 			= ДополнительныеПараметры.ПараметрыФормата;
	
	ЭтоВерсия1X = Лев(ПараметрыФормата.Версия, 2) = "1.";
	
	ПространствоИменЗапроса = ?(ЭтоВерсия1X, "http://ru/ibs/fss/ln/ws/FileOperationsLn.wsdl",
		"http://www.fss.ru/integration/types/eln/ins/v01");
	ДобавляемыеАтрибутыЗапроса = "xmlns:ds=""http://www.w3.org/2000/09/xmldsig#"""
		+ " xmlns:fil=""" + ПространствоИменЗапроса + """"
		+ " xmlns:sch=""http://gost34.ibs.ru/WrapperService/Schema"""
		+ " xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
		+ " xmlns:wsse=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"""
		+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""";
	ДобавляемыеАтрибутыПодписи = "xmlns=""http://www.w3.org/2000/09/xmldsig#""";
	
	СкорректированнаяВыгрузкаЗапроса = СкорректироватьВыгрузкуЗапросаОперацииДляSOAP(
		ВыгрузкаЗапросаОперацииСЭЛН.ТекстЗапроса,
		ПространствоИменЗапроса);
	
	РезультатИнициализации = АдресПодписанногоSOAPОперацииСЭЛНВФССИнициализацияНаСервере(
		ВыгрузкаЗапросаОперацииСЭЛН.Организация,
		СкорректированнаяВыгрузкаЗапроса,
		ДобавляемыеАтрибутыЗапроса,
		ВыгрузкаЗапросаОперацииСЭЛН.РегистрационныйНомерФСС,
		ЗашифроватьSOAP);
	
	Если РезультатИнициализации = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗапроса", 			ДобавляемыеАтрибутыЗапроса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 			ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("СкорректированнаяВыгрузкаЗапроса", 	СкорректированнаяВыгрузкаЗапроса);
	ДополнительныеПараметры.Вставить("РезультатИнициализации", 				РезультатИнициализации);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПредупрежденияПриТестовомРежиме",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если РезультатИнициализации.ТестовыйСерверФССЭЛН Тогда
		ТекстВопроса = НСтр("ru = 'Внимание! Включен режим тестирования ЭЛН!
			|
			|В режиме тестирования обмен выполняется через тестовый СФР (бывш. ФСС).
			|Данные не соответствуют действительности и не засчитываются СФР.
			|
			|Продолжить обмен?';
			|en = 'Внимание! Включен режим тестирования ЭЛН!
			|
			|В режиме тестирования обмен выполняется через тестовый СФР (бывш. ФСС).
			|Данные не соответствуют действительности и не засчитываются СФР.
			|
			|Продолжить обмен?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПредупрежденияПриТестовомРежиме(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыгрузкаЗапросаОперацииСЭЛН 		= ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭЛН;
	ЗашифроватьSOAP 					= ДополнительныеПараметры.ЗашифроватьSOAP;
	ДобавляемыеАтрибутыЗапроса 			= ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СкорректированнаяВыгрузкаЗапроса 	= ДополнительныеПараметры.СкорректированнаяВыгрузкаЗапроса;
	РезультатИнициализации 				= ДополнительныеПараметры.РезультатИнициализации;
	ПараметрыФормата 					= ДополнительныеПараметры.ПараметрыФормата;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗапросОперацииСЭЛН64 = РезультатИнициализации.ЗапросОперацииСЭЛН64;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РезультатИнициализации);
	УчетнаяЗапись = РезультатИнициализации.УчетнаяЗапись;
	
	СертификатСтрахователяОтпечаток = РезультатИнициализации.СертификатСтрахователяОтпечаток;
	СертификатСтрахователя 			= РезультатИнициализации.СертификатСтрахователя;
	СертификатФССЭЛНОтпечаток 		= РезультатИнициализации.СертификатФССЭЛНОтпечаток;
	СертификатФССЭЛН 				= РезультатИнициализации.СертификатФССЭЛН;
	МЧД 							= РезультатИнициализации.МЧД;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", 			ВыгрузкаЗапросаОперацииСЭЛН.РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапроса", 					СкорректированнаяВыгрузкаЗапроса);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛНОтпечаток", 			СертификатФССЭЛНОтпечаток);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", 					СертификатФССЭЛН);
	ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 					ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗапроса", 			ДобавляемыеАтрибутыЗапроса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 			ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("ЗапросОперацииСЭЛН64", 				ЗапросОперацииСЭЛН64);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("ПараметрыФормата", 					ПараметрыФормата);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПоискаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Истина, СертификатСтрахователя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатСтрахователяОтпечаток, "MY");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПоискаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатФССЭЛНОтпечаток = ДополнительныеПараметры.СертификатФССЭЛНОтпечаток;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", СертификатСтрахователя);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПоискаСертификатаФСС",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, ЗашифроватьSOAP, СертификатФССЭЛН);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатФССЭЛНОтпечаток, "AddressBook");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПоискаСертификатаФСС(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатФССЭЛН = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, НСтр("ru = 'Сертификат страхователя';
															|en = 'Сертификат страхователя'"));
	Если ЗашифроватьSOAP Тогда
		СертификатыОбмена.Добавить(СертификатФССЭЛН, НСтр("ru = 'Сертификат ФСС ЭЛН';
															|en = 'Сертификат ФСС ЭЛН'"));
	КонецЕсли;
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", СертификатФССЭЛН);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЭкспортаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатСтрахователя);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЭкспортаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ЗапросОперацииСЭЛН64 = ДополнительныеПараметры.ЗапросОперацииСЭЛН64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателя64 = Результат.СтрокаBase64;
	
	ДополнительныеПараметры.Вставить("СертификатПолучателя64", СертификатПолучателя64);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЗаписиФайла",
		ЭтотОбъект, ДополнительныеПараметры);
		
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ЗапросОперацииСЭЛН64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗапросОперацииСЭЛН64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗапроса = ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлЗапросаОперацииСЭЛН = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлЗапросаОперацииСЭЛН", ФайлЗапросаОперацииСЭЛН);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПодписания", ЭтотОбъект, ДополнительныеПараметры);
	
	ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи
		+ ?(ДобавляемыеАтрибутыПодписи <> "" И ДобавляемыеАтрибутыЗапроса <> "", " ", "")
		+ ДобавляемыеАтрибутыЗапроса;
	ИдентификаторПодписываемыхДанных = "REGNO_" + РегистрационныйНомерФСС;
	
	НастройкиПодписи = Новый Структура;
	НастройкиПодписи.Вставить("Трансформация1_1", 						Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 				Ложь);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 				Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 						Неопределено);
	НастройкиПодписи.Вставить("НормализацияОтключена", 					Истина);
	НастройкиПодписи.Вставить("ДанныеВнутриПодписи", 					Истина);
	НастройкиПодписи.Вставить("ИдентификаторПодписываемыхДанных", 		ИдентификаторПодписываемыхДанных);
	НастройкиПодписи.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибутыПодписиИЗаписи);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОСертификате", 		Истина);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОбОбъекте", 			Истина);
	НастройкиПодписи.Вставить("ДополнительныеТрансформации", 			Неопределено);
	НастройкиПодписи.Вставить("ДополнительныеОбратныеТрансформации", 	Неопределено);
	НастройкиПодписи.Вставить("Применение", 							"ОтправкиФСС");
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ОперацииСЭЛН", УчетнаяЗапись); 
		ПодготовитьОблачнуюПодпись("Реестр ЭЛН", ".xml", ТребуетПодтверждениеОперации, НастройкиПодписи);
	КонецЕсли;
	
	ПодписатьФайлXMLDSig(
		СертификатСтрахователя,
		ФайлЗапросаОперацииСЭЛН,
		Оповещение,,,
		НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеПодписания(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ФайлЗапросаОперацииСЭЛН = ДополнительныеПараметры.ФайлЗапросаОперацииСЭЛН;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ФайлЗапросаОперацииСЭЛН);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлЗапросаОперацииСЭЛН);
	КонецЕсли;
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось подписать файл запроса ЭЛН!';
														|en = 'Не удалось подписать файл запроса ЭЛН!'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлПодписиЗапросаОперацииСЭЛН", ПолноеИмяПодписанногоФайла);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЧтенияФайла",
		ЭтотОбъект, ДополнительныеПараметры);
		
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЧтенияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЗапроса = ДополнительныеПараметры.ВыгрузкаЗапроса;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗапроса = ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	ФайлПодписиЗапросаОперацииСЭЛН = ДополнительныеПараметры.ФайлПодписиЗапросаОперацииСЭЛН;
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписиЗапросаОперацииСЭЛН);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписиЗапросаОперацииСЭЛН64 = Результат.СтрокаBase64;
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыЗапроса", 	ДобавляемыеАтрибутыЗапроса);
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыПодписи", 	ДобавляемыеАтрибутыПодписи);
	НастройкиОперации.Вставить("ВозвращатьТекстВBase64", 		ЗашифроватьSOAP);
	НастройкиОперации.Вставить("МЧД", 							ДополнительныеПараметры.МЧД);
	РезультатОперации = АдресSOAPЗапросОперацииСЭЛНВФССПоПодписиНаСервере(
		РегистрационныйНомерФСС,
		ВыгрузкаЗапроса,
		ФайлПодписиЗапросаОперацииСЭЛН64,
		СертификатПолучателя64,
		НастройкиОперации);
	
	Если НЕ ЗашифроватьSOAP Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЗаписиФайлаПодписанногоSOAP",
			ЭтотОбъект, ДополнительныеПараметры);
		
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, РезультатОперации);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭЛНВФССПослеЗаписиФайлаПодписанногоSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФормата = ДополнительныеПараметры.ПараметрыФормата;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписанногоSOAP = Результат.ИмяФайла;
	
	ЭтоВерсия1X = Лев(ПараметрыФормата.Версия, 2) = "1.";
	
	ШаблонЗапросаSOAP =
		"<SOAP-ENV:Envelope xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"">
		|	<SOAP-ENV:Header/>
		|	<SOAP-ENV:Body>
		|%1
		|	</SOAP-ENV:Body>
		|</SOAP-ENV:Envelope>";
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ШаблонЗапросаSOAP", ШаблонЗапросаSOAP);
	НастройкиОперации.Вставить("Применение", 		"ОтправкиФСС");
	Если НЕ ЭтоВерсия1X Тогда
		НастройкиОперации.Вставить("ПоместитьВУзелX509CertificateСертификатПолучателя", Истина);
	КонецЕсли;
	НастройкиОперации.Вставить("СценарийФСС", Истина);
	
	ЗашифроватьФайлXML(
		СертификатФССЭЛН,
		СертификатСтрахователя,
		ФайлПодписанногоSOAP,
		ВыполняемоеОповещение,,
		Истина,
		НастройкиОперации);
	
КонецПроцедуры

// необходима для формирования пакетной режима подписи DSS
&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССОблачнаяПодпись(ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССОблачнаяПодписьЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
		
	ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи
		+ ?(ДобавляемыеАтрибутыПодписи <> "" И ДобавляемыеАтрибутыЗаписи <> "", " ", "")
		+ ДобавляемыеАтрибутыЗаписи;
		
	ИдентификаторыПодписываемыхДанных = Новый Массив;
	Для Счетчик = 0 По МассивНомеровЛистковНетрудоспособности.Количество() - 1 Цикл
		ИдентификаторыПодписываемыхДанных.Добавить("ELN_" + МассивНомеровЛистковНетрудоспособности[Счетчик]);
	КонецЦикла;
	
	ДополнительныеТрансформации = Новый Массив;
	ДополнительныеОбратныеТрансформации = Новый Массив;
	
	// прямые и обратные замены
	ДополнительныеТрансформации.Добавить("<eln:");
	ДополнительныеТрансформации.Добавить("<");
	ДополнительныеОбратныеТрансформации.Добавить("<eln:/");
	ДополнительныеОбратныеТрансформации.Добавить("</eln:");
	
	ДополнительныеТрансформации.Добавить("</eln:");
	ДополнительныеТрансформации.Добавить("</");
	ДополнительныеОбратныеТрансформации.Добавить("<");
	ДополнительныеОбратныеТрансформации.Добавить("<eln:");
	
	НастройкиПодписи = Новый Структура;
	НастройкиПодписи.Вставить("Трансформация1_1", 						Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 				Ложь);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 				Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 						Неопределено);
	НастройкиПодписи.Вставить("НормализацияОтключена", 					Истина);
	НастройкиПодписи.Вставить("ДанныеВнутриПодписи", 					Истина);
	НастройкиПодписи.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибутыПодписиИЗаписи);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОСертификате", 		Истина);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОбОбъекте", 			Истина);
	НастройкиПодписи.Вставить("ИдентификаторыПодписываемыхДанных", 		ИдентификаторыПодписываемыхДанных);
	НастройкиПодписи.Вставить("ДополнительныеТрансформации", 			ДополнительныеТрансформации);
	НастройкиПодписи.Вставить("ДополнительныеОбратныеТрансформации", 	ДополнительныеОбратныеТрансформации);
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЗагрузкаЭЛН", ОрганизацияСсылка); 
		ПодготовитьОблачнуюПодпись("Реестр ЭЛН", ".xml", ТребуетПодтверждениеОперации, НастройкиПодписи);
	КонецЕсли;
	
	ПодписатьФайлыXMLDSig(
		СертификатСтрахователя,
		МассивЗаписейЭЛН64,
		Оповещение,,
		НастройкиПодписи);
		
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССОблачнаяПодписьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = Результат;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыЗаписи", 	ДобавляемыеАтрибутыЗаписи);
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыПодписи", 	ДобавляемыеАтрибутыПодписи);
	НастройкиОперации.Вставить("ВозвращатьТекстВBase64", 		ЗашифроватьSOAP);
	НастройкиОперации.Вставить("МЧД", 							ДополнительныеПараметры.МЧД);
	НастройкиОперации.Вставить("ОблачнаяПодпись", 				Истина);
	
	РезультатОперации = АдресSOAPЗагрузкиЭЛНВФССПоМассивуПодписейНаСервере(
		РегистрационныйНомерФСС,
		ВыгрузкаЭЛН,
		МассивПодписейЭЛН64,
		МассивНомеровЛистковНетрудоспособности,
		СертификатПолучателя64,
		НастройкиОперации);
	
	Если НЕ ЗашифроватьSOAP Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		
	Иначе
		ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", РезультатОперации);
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЗаписиФайлаПодписанногоSOAP",
			ЭтотОбъект, ДополнительныеПараметры);
			
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, РезультатОперации);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ЗапросОперацииСЭЛНДляПодписиSOAP64НаСервере(
		Знач ВыгрузкаЗапросаОперацииСЭЛН,
		Знач ДобавляемыеАтрибутыЗапроса,
		Знач РегистрационныйНомерФСС)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ЗапросОперацииСЭЛНДляПодписиSOAP64(
		ВыгрузкаЗапросаОперацииСЭЛН,
		ДобавляемыеАтрибутыЗапроса,
		РегистрационныйНомерФСС);
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресSOAPЗапросОперацииСЭЛНВФССПоПодписиНаСервере(
		Знач РегистрационныйНомерФСС,
		Знач ВыгрузкаЗапроса,
		Знач ПодписьЗапросаЭЛН64,
		Знач СертификатПолучателя64,
		Знач НастройкиОперации = Неопределено) Экспорт
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.АдресSOAPЗапросОперацииСЭЛНВФССПоПодписи(
		РегистрационныйНомерФСС,
		ВыгрузкаЗапроса,
		ПодписьЗапросаЭЛН64,
		СертификатПолучателя64,
		НастройкиОперации);
	
КонецФункции

#Область ПроверитьПодписьSOAPОтветаЭЛНВФСС

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФСС(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		АдресПодписанногоОтветаSOAP,
		РасшифроватьSOAP = Истина,
		ЗаписыватьОшибкиВЖурналРегистрации = Ложь,
		ТипОперацииОбработки = "",
		ЭтоОперацияСЭДОФСС = Ложь,
		Настройки = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ПодписьВалидна", Ложь);
	Результат.Вставить("АдресРасшифрованногоОтветаSOAP", "");
	
	ЭтоОперацияСОКВЭД = ЗначениеЗаполнено(ТипОперацииОбработки);
	
	ЗаписыватьОшибкиВЖурналРегистрации = ЭтоОперацияСОКВЭД ИЛИ ЭтоОперацияСЭДОФСС;
	РезультатИнициализации = ПроверитьПодписьSOAPОтветаЭЛНВФССИнициализацияНаСервере(
		ОрганизацияСсылка,
		АдресПодписанногоОтветаSOAP,
		НЕ РасшифроватьSOAP,
		ЗаписыватьОшибкиВЖурналРегистрации,
		ТипОперацииОбработки,
		ЭтоОперацияСЭДОФСС,
		Настройки);
	
	Если РезультатИнициализации = Неопределено Тогда
		Результат.ОписаниеОшибки = НСтр("ru = 'Ошибка инициализации подсистемы криптографии.';
										|en = 'Ошибка инициализации подсистемы криптографии.'");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ПодписанныйОтветSOAP64 = РезультатИнициализации.ПодписанныйОтветSOAP64;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РезультатИнициализации);
	УчетнаяЗапись = РезультатИнициализации.УчетнаяЗапись;
	
	СертификатСтрахователяОтпечаток = РезультатИнициализации.СертификатСтрахователяОтпечаток;
	СертификатСтрахователя = РезультатИнициализации.СертификатСтрахователя;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПодписанныйОтветSOAP64", 				ПодписанныйОтветSOAP64);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("РасшифроватьSOAP", 					РасшифроватьSOAP);
	ДополнительныеПараметры.Вставить("ЗаписыватьОшибкиВЖурналРегистрации", 	ЗаписыватьОшибкиВЖурналРегистрации);
	ДополнительныеПараметры.Вставить("ТипОперацииОбработки", 				ТипОперацииОбработки);
	ДополнительныеПараметры.Вставить("ЭтоОперацияСОКВЭД", 					ЭтоОперацияСОКВЭД);
	ДополнительныеПараметры.Вставить("ЭтоОперацияСЭДОФСС", 					ЭтоОперацияСЭДОФСС);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("Результат", 							Результат);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПоискаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Истина, СертификатСтрахователя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатСтрахователяОтпечаток, "MY");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПодписьSOAPОтветаЭЛНВФССИнициализацияНаСервере(
		Знач ОрганизацияСсылка,
		Знач АдресПодписанногоОтветаSOAP,
		Знач ВозвращатьТекстВBase64 = Ложь,
		Знач ЗаписыватьОшибкиВЖурналРегистрации = Ложь,
		Знач ТипОперацииОбработки = "",
		Знач ЭтоОперацияСЭДОФСС = Ложь,
		Знач Настройки = Неопределено)
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	УчетнаяЗапись = РеквизитыУчетнойЗаписи.Ссылка;
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если ВозвращатьТекстВBase64 И НЕ (НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) И ЭтоОперацияСЭДОФСС) Тогда
		СохранитьАдресОтветаSOAP = ЗаписыватьОшибкиВЖурналРегистрации;
		
		ТекстПодписанногоОтветаSOAP = ПолучитьИзВременногоХранилища(АдресПодписанногоОтветаSOAP);
		Если НЕ СохранитьАдресОтветаSOAP Тогда
			УдалитьИзВременногоХранилища(АдресПодписанногоОтветаSOAP);
		КонецЕсли;
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		ЗаписьТекстаОтвета = Новый ЗаписьТекста(ИмяФайлаОтвета, "utf-8");
		ЗаписьТекстаОтвета.Записать(ТекстПодписанногоОтветаSOAP);
		ЗаписьТекстаОтвета.Закрыть();
		
		ДвоичныеДанныеОтвета = Новый ДвоичныеДанные(ИмяФайлаОтвета);
		ПодписанныйОтветSOAP64 = Base64Строка(ДвоичныеДанныеОтвета);
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
	Иначе
		ПодписанныйОтветSOAP64 = АдресПодписанногоОтветаSOAP;
	КонецЕсли;
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
	Если ОтпечаткиСертификатов = Неопределено
		ИЛИ (НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток)
			И (Настройки = Неопределено ИЛИ НЕ Настройки.Свойство("СодержимоеПодписанногоЗапросаSOAP"))) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности';
							|en = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности'");
		Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами.';
					|en = 'Электронный документооборот с контролирующими органами.'") + " "
					+ ?(ЗначениеЗаполнено(ТипОперацииОбработки),
						?(ТипОперацииОбработки = "ПодтверждениеВидаДеятельности", НСтр("ru = 'Проверка подписи ПОВЭД';
																						|en = 'Проверка подписи ПОВЭД'"),
							?(ТипОперацииОбработки = "РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам",
							НСтр("ru = 'Проверка подписи реестра стимулирующих выплат медицинским и социальным работникам';
								|en = 'Проверка подписи реестра стимулирующих выплат медицинским и социальным работникам'"),
							НСтр("ru = 'Проверка подписи ФСС';
								|en = 'Проверка подписи ФСС'"))),
						НСтр("ru = 'Проверка подписи реестра ЭЛН';
							|en = 'Проверка подписи реестра ЭЛН'")),
				УровеньЖурналаРегистрации.Ошибка,,,
				ТекстОшибки);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		Если НЕ ВозвращатьТекстВBase64 Тогда
			УдалитьИзВременногоХранилища(АдресПодписанногоОтветаSOAP);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	СертификатСтрахователя = Неопределено;
	Если (ЭтоОблачнаяПодпись(МестоХраненияКлюча)
			ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча))
		И (Настройки = Неопределено ИЛИ НЕ Настройки.Свойство("СодержимоеПодписанногоЗапросаSOAP")) Тогда
		
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		Иначе
			СертификатСтрахователя = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY");
		КонецЕсли;
		Если СертификатСтрахователя = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Не найден сертификат страхователя';
								|en = 'Не найден сертификат страхователя'");
			Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами.';
						|en = 'Электронный документооборот с контролирующими органами.'") + " "
						+ ?(ЗначениеЗаполнено(ТипОперацииОбработки),
							?(ТипОперацииОбработки = "ПодтверждениеВидаДеятельности", НСтр("ru = 'Проверка подписи ПОВЭД';
																							|en = 'Проверка подписи ПОВЭД'"),
								?(ТипОперацииОбработки = "РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам",
								НСтр("ru = 'Проверка подписи реестра стимулирующих выплат медицинским и социальным работникам';
									|en = 'Проверка подписи реестра стимулирующих выплат медицинским и социальным работникам'"),
								НСтр("ru = 'Проверка подписи ФСС';
									|en = 'Проверка подписи ФСС'"))),
							НСтр("ru = 'Проверка подписи реестра ЭЛН';
								|en = 'Проверка подписи реестра ЭЛН'")),
					УровеньЖурналаРегистрации.Ошибка,,,
					ТекстОшибки);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			Если НЕ ВозвращатьТекстВBase64 Тогда
				УдалитьИзВременногоХранилища(АдресПодписанногоОтветаSOAP);
			КонецЕсли;
			Возврат Неопределено;
		КонецЕсли;
		
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
		СертификатСтрахователя.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ПодписанныйОтветSOAP64", 				ПодписанныйОтветSOAP64);
	Результат.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	Результат.Вставить("СертификатСтрахователяОтпечаток", 		ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
	Результат.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПоискаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	ПодписанныйОтветSOAP64 = ДополнительныеПараметры.ПодписанныйОтветSOAP64;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РасшифроватьSOAP = ДополнительныеПараметры.РасшифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	РезультатОперации = ДополнительныеПараметры.Результат;
	ЭтоОперацияСЭДОФСС = ДополнительныеПараметры.ЭтоОперацияСЭДОФСС;
	
	Если НЕ Результат.Выполнено Тогда
		Если РасшифроватьSOAP Тогда
			УдалитьИзВременногоХранилища(ПодписанныйОтветSOAP64);
		КонецЕсли;
		Если ЭтоОперацияСЭДОФСС Тогда
			РезультатОперации.ОписаниеОшибки = НСтр("ru = 'Ошибка поиска сертификата.';
													|en = 'Ошибка поиска сертификата.'");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		Иначе
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", СертификатСтрахователя);
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПослеЗаписиФайлаПодписанногоОтветаSOAP",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ РасшифроватьSOAP Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ПодписанныйОтветSOAP64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПодписанныйОтветSOAP64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПослеЗаписиФайлаПодписанногоОтветаSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	ПодписанныйОтветSOAP64 = ДополнительныеПараметры.ПодписанныйОтветSOAP64;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РасшифроватьSOAP = ДополнительныеПараметры.РасшифроватьSOAP;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	РезультатОперации = ДополнительныеПараметры.Результат;
	ЭтоОперацияСЭДОФСС = ДополнительныеПараметры.ЭтоОперацияСЭДОФСС;
	
	Если НЕ Результат.Выполнено Тогда
		Если РасшифроватьSOAP Тогда
			УдалитьИзВременногоХранилища(ПодписанныйОтветSOAP64);
		КонецЕсли;
		Если ЭтоОперацияСЭДОФСС Тогда
			РезультатОперации.ОписаниеОшибки = НСтр("ru = 'Файловая ошибка при записи файла с подписью ФСС.';
													|en = 'Файловая ошибка при записи файла с подписью ФСС.'");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		Иначе
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПодписанныйОтветSOAP = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ПодписанныйОтветSOAP", ПодписанныйОтветSOAP);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПослеРасшифровки",
		ЭтотОбъект, ДополнительныеПараметры);
	Если РасшифроватьSOAP Тогда
		МассивРодительскихУзловЗашифрованныхДанных = Новый Массив;
		МассивРодительскихУзловЗашифрованныхДанных.Добавить("Envelope");
		МассивРодительскихУзловЗашифрованныхДанных.Добавить("Body");
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("Применение", "ОтправкиФСС");
		НастройкиОперации.Вставить("СценарийФСС", Истина);
		РасшифроватьФайлXML(
			СертификатСтрахователя,
			ПодписанныйОтветSOAP,
			Оповещение,
			Истина,,
			МассивРодительскихУзловЗашифрованныхДанных,
			НастройкиОперации);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, ПодписанныйОтветSOAP);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПослеРасшифровки(РасшифрованныйФайл, ДополнительныеПараметры) Экспорт
	
	ПодписанныйОтветSOAP64 				= ДополнительныеПараметры.ПодписанныйОтветSOAP64;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	РасшифроватьSOAP 					= ДополнительныеПараметры.РасшифроватьSOAP;
	ЗаписыватьОшибкиВЖурналРегистрации 	= ДополнительныеПараметры.ЗаписыватьОшибкиВЖурналРегистрации;
	ЭтоОперацияСОКВЭД 					= ДополнительныеПараметры.ЭтоОперацияСОКВЭД;
	ЭтоОперацияСЭДОФСС					= ДополнительныеПараметры.ЭтоОперацияСЭДОФСС;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	ПодписанныйОтветSOAP 				= ДополнительныеПараметры.ПодписанныйОтветSOAP;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	
	СохранитьАдресОтветаSOAP = ЗаписыватьОшибкиВЖурналРегистрации;
	
	Если РасшифроватьSOAP Тогда
		Если НЕ СохранитьАдресОтветаSOAP Тогда
			УдалитьИзВременногоХранилища(ПодписанныйОтветSOAP64);
		КонецЕсли;
	ИначеЕсли ЭтоЛокальнаяПодпись(МестоХраненияКлюча) И РасшифрованныйФайл <> ПодписанныйОтветSOAP Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ПодписанныйОтветSOAP);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РасшифрованныйФайл) Тогда
		Если ЭтоОперацияСЭДОФСС Тогда
			РезультатОперации.ОписаниеОшибки = НСтр("ru = 'Ошибка расшифровки ответа ФСС.';
													|en = 'Ошибка расшифровки ответа ФСС.'");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		Иначе
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("РасшифрованныйОтветSOAP", РасшифрованныйФайл);
	ДополнительныеПараметры.Вставить("Результат", РезультатОперации);
	ДополнительныеПараметры.Вставить("ЭтоОперацияСЭДОФСС", ЭтоОперацияСЭДОФСС);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПроверкиПодписи",
		ЭтотОбъект, ДополнительныеПараметры);
		
	ЗаписыватьОшибкиВЖурналРегистрации = Истина;
	УдалятьЛишниеАтрибуты = ЭтоОперацияСОКВЭД;
	
	ИспользоватьПреобразованиеККаноническомуXML = Ложь;
	Если ЭтоОперацияСЭДОФСС Тогда
		ИспользоватьПреобразованиеККаноническомуXML = Истина;
	КонецЕсли;
	
	Событие = "Проверять подпись СЭДО";
	ПроверятьПодпись = НЕ ЭтоОперацияСЭДОФСС
		ИЛИ (ЭтоОперацияСЭДОФСС И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило(Событие));
	Если НЕ ПроверятьПодпись Тогда
		ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПроверкиПодписи(Истина, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ПроверитьПодписьФайлаXMLDSig(
		СертификатСтрахователя,
		РасшифрованныйФайл,
		Оповещение,
		ЗаписыватьОшибкиВЖурналРегистрации,
		УдалятьЛишниеАтрибуты,
		ИспользоватьПреобразованиеККаноническомуXML);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФССПослеПроверкиПодписи(ПодписьВалидна, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	РасшифрованныйОтветSOAP = ДополнительныеПараметры.РасшифрованныйОтветSOAP;
	
	ДополнительныеПараметры.Вставить("ПодписьВалидна", ПодписьВалидна <> Ложь);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьSOAPОтветаЭЛНВФССПослеЧтенияФайлаРасшифрованногоОтветаSOAP",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, РасшифрованныйОтветSOAP);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, РасшифрованныйОтветSOAP);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьSOAPОтветаЭЛНВФССПослеЧтенияФайлаРасшифрованногоОтветаSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	РасшифрованныйОтветSOAP = ДополнительныеПараметры.РасшифрованныйОтветSOAP;
	ПодписьВалидна = ДополнительныеПараметры.ПодписьВалидна;
	РезультатОперации = ДополнительныеПараметры.Результат;
	ЭтоОперацияСЭДОФСС = ДополнительныеПараметры.ЭтоОперацияСЭДОФСС;
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, РасшифрованныйОтветSOAP);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		Если ЭтоОперацияСЭДОФСС Тогда
			РезультатОперации.ОписаниеОшибки = НСтр("ru = 'Файловая ошибка чтения расшифрованного ответа ФСС.';
													|en = 'Файловая ошибка чтения расшифрованного ответа ФСС.'");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		Иначе
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	РасшифрованныйОтветSOAP64 = Результат.СтрокаBase64;
	
	АдресРасшифрованногоОтветаSOAP = ПоместитьВоВременноеХранилищеТекстСКлиента(
		РасшифрованныйОтветSOAP64,
		НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча),
		?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча), РасшифрованныйОтветSOAP64, Новый УникальныйИдентификатор()));
		
	РезультатОперации.Выполнено = Истина;
	РезультатОперации.ПодписьВалидна = ПодписьВалидна;
	РезультатОперации.АдресРасшифрованногоОтветаSOAP = АдресРасшифрованногоОтветаSOAP;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПоместитьВоВременноеХранилищеТекстСКлиента(Знач Строка64, ЭтоАдресДвоичныхДанныхВоВременномХранилище = Ложь, АдресВоВременномХранилище)
	
	ИмяФайлаТекста = ПолучитьИмяВременногоФайла();
	Если ЭтоАдресДвоичныхДанныхВоВременномХранилище Тогда
		ДвоичныеДанныеТекста = ПолучитьИзВременногоХранилища(Строка64);
	Иначе
		ДвоичныеДанныеТекста = Base64Значение(Строка64);
	КонецЕсли;
	ДвоичныеДанныеТекста.Записать(ИмяФайлаТекста);
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайлаТекста, "utf-8");
	ТекстСКлиента = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаТекста);
	
	Возврат ПоместитьВоВременноеХранилище(ТекстСКлиента, АдресВоВременномХранилище);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьУЦСертификатаСтрахователя(
		Оповещение,
		// замена на перечисление МодельРаботыСКлючам
		МестоХраненияКлюча,
		ВыбранныйСертификатСтрахователя) Экспорт
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) И ВыбранныйСертификатСтрахователя.Свойство("ПоставщикСтруктура")
		И ВыбранныйСертификатСтрахователя.ПоставщикСтруктура.Свойство("O")
		И ВыбранныйСертификатСтрахователя.Свойство("Отпечаток") Тогда
		
		ЭтоАвторизованныйУЦ = Ложь;
		ОрганизацияСертификатаСтрахователя = ВыбранныйСертификатСтрахователя.ПоставщикСтруктура.O;
		
		АвторизованныеУЦ = КриптографияЭДКОСлужебныйКлиентСервер.АвторизованныеУдостоверяющиеЦентры();
		Для каждого АвторизованныйУЦ Из АвторизованныеУЦ Цикл
			Если АвторизованныйУЦ.Идентификаторы.Найти(ОрганизацияСертификатаСтрахователя) <> Неопределено Тогда
				ЭтоАвторизованныйУЦ = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЭтоАвторизованныйУЦ Тогда
			ПодписиВJSON = КриптографияЭДКОСлужебныйКлиент.ПодписиСертификатовДокументооборотаВJSON(
				ВыбранныйСертификатСтрахователя);
			Если ЗначениеЗаполнено(ПодписиВJSON) Тогда
				ЭтоАвторизованныйУЦ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЭтоАвторизованныйУЦ Тогда
			ТекстСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'статье';
															|en = 'статье'"),,,,
				"https://its.1c.ru/bmk/elreps/fss_cert");
			ТекстВопроса = Новый ФорматированнаяСтрока(
				НСтр("ru = 'Обратите внимание, для выбранного сертификата не найдено подключение к 1С-Отчетности.
				|Подробнее о настройках подключения читайте в';
				|en = 'Обратите внимание, для выбранного сертификата не найдено подключение к 1С-Отчетности.
				|Подробнее о настройках подключения читайте в'") + " ",
				ТекстСсылки,
				".
				|
				|" + НСтр("ru = 'Выбрать сертификат?';
							|en = 'Выбрать сертификат?'"));
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьЗадаваемыеСертификатыФСС(
		ОповещениеОЗавершении,
		СертификатСтрахователя,
		СертификатФССОтпечаток,
		СертификатФССЭЛНОтпечаток,
		МестоХраненияКлюча) Экспорт
		
	ЛокальнаяПодпись = ЭтоЛокальнаяПодпись(МестоХраненияКлюча);
	
	Если ОбщегоНазначенияКлиент.ДатаСеанса() >= '20191008' ИЛИ НЕ ЛокальнаяПодпись Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИнформацияОСертификатахФСС = ИнформацияОСертификатахФССНаСервере(НЕ ЛокальнаяПодпись);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	ДополнительныеПараметры.Вставить("СертификатФССОтпечаток", 				СертификатФССОтпечаток);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛНОтпечаток", 			СертификатФССЭЛНОтпечаток);
	ДополнительныеПараметры.Вставить("ИнформацияОСертификатахФСС", 			ИнформацияОСертификатахФСС);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ОпределитьЗадаваемыеСертификатыФССПослеОпределенияАлгоритма",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ИнформацияОСертификатахФСС = Неопределено ИЛИ (ЗначениеЗаполнено(СертификатФССОтпечаток)
		И СертификатФССОтпечаток <> ИнформацияОСертификатахФСС.ФСССертификатОтпечаток
		И СертификатФССОтпечаток <> ИнформацияОСертификатахФСС.ФСССертификатГОСТ2012Отпечаток
		И ЗначениеЗаполнено(СертификатФССЭЛНОтпечаток)
		И СертификатФССЭЛНОтпечаток <> ИнформацияОСертификатахФСС.ФССЭЛНСертификатОтпечаток
		И СертификатФССЭЛНОтпечаток <> ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток) Тогда
		
		РезультатВыполнения = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ПараметрыОпределенияАлгоритма = Новый Структура("Сертификат", СертификатСтрахователя);
		
		КриптографияЭДКОКлиент.ОпределитьАлгоритм(
			Оповещение,
			МестоХраненияКлюча,
			ПараметрыОпределенияАлгоритма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьЗадаваемыеСертификатыФССПослеОпределенияАлгоритма(Результат, ВходящийКонтекст) Экспорт
	
	ЗадатьСертификатыФСС = Результат.Выполнено И (Результат.Алгоритм = "GOST R 34.10-2012-256"
		ИЛИ Результат.Алгоритм = "GOST R 34.10-2001");
	
	Если ЗадатьСертификатыФСС Тогда
		
		ИнформацияОСертификатахФСС = ВходящийКонтекст.ИнформацияОСертификатахФСС;
		
		СертификатКорневогоУЦ = Новый Структура;
		СертификатУЦ = Новый Структура;
		СертификатФСС = Новый Структура;
		СертификатФССЭЛН = Новый Структура;
		
		Если Результат.Алгоритм = "GOST R 34.10-2012-256" Тогда
			СертификатКорневогоУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.КорневойСертификатУЦГОСТ2012Отпечаток);
			СертификатКорневогоУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.КорневойСертификатУЦГОСТ2012Данные);
			
			СертификатУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФСССертификатУЦГОСТ2012Отпечаток);
			СертификатУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.ФСССертификатУЦГОСТ2012Данные);
			
			СертификатФСС.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФСССертификатГОСТ2012Отпечаток);
			СертификатФСС.Вставить("Данные", ИнформацияОСертификатахФСС.ФСССертификатГОСТ2012Данные);
			
			СертификатФССЭЛН.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток);
			СертификатФССЭЛН.Вставить("Данные", ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Данные);
			
			ОтпечатокСертификатаФССДругогоАлгоритма = ИнформацияОСертификатахФСС.ФСССертификатОтпечаток;
			ОтпечатокСертификатаФССЭЛНДругогоАлгоритма = ИнформацияОСертификатахФСС.ФССЭЛНСертификатОтпечаток;
			
		Иначе // "GOST R 34.10-2001"
			Если ОбщегоНазначенияКлиент.ДатаСеанса() >= '20190816' Тогда
				Возврат;
			КонецЕсли;
			
			СертификатКорневогоУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.КорневойСертификатУЦОтпечаток);
			СертификатКорневогоУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.КорневойСертификатУЦДанные);
			
			СертификатУЦ.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФСССертификатУЦОтпечаток);
			СертификатУЦ.Вставить("Данные", ИнформацияОСертификатахФСС.ФСССертификатУЦДанные);
			
			СертификатФСС.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФСССертификатОтпечаток);
			СертификатФСС.Вставить("Данные", ИнформацияОСертификатахФСС.ФСССертификатДанные);
			
			СертификатФССЭЛН.Вставить("Отпечаток", ИнформацияОСертификатахФСС.ФССЭЛНСертификатОтпечаток);
			СертификатФССЭЛН.Вставить("Данные", ИнформацияОСертификатахФСС.ФССЭЛНСертификатДанные);
			
			ОтпечатокСертификатаФССДругогоАлгоритма = ИнформацияОСертификатахФСС.ФСССертификатГОСТ2012Отпечаток;
			ОтпечатокСертификатаФССЭЛНДругогоАлгоритма = ИнформацияОСертификатахФСС.ФССЭЛНСертификатГОСТ2012Отпечаток;
		КонецЕсли;
		
		ЗадатьСертификатФСС = (НЕ ЗначениеЗаполнено(ВходящийКонтекст.СертификатФССОтпечаток)
			ИЛИ ВходящийКонтекст.СертификатФССОтпечаток = ОтпечатокСертификатаФССДругогоАлгоритма)
			И ЗначениеЗаполнено(СертификатФСС.Отпечаток);
		ЗадатьСертификатФССЭЛН = (НЕ ЗначениеЗаполнено(ВходящийКонтекст.СертификатФССЭЛНОтпечаток)
			ИЛИ ВходящийКонтекст.СертификатФССЭЛНОтпечаток = ОтпечатокСертификатаФССЭЛНДругогоАлгоритма)
			И ЗначениеЗаполнено(СертификатФССЭЛН.Отпечаток);
		ЗадатьСертификатыФСС = ЗадатьСертификатФСС ИЛИ ЗадатьСертификатФССЭЛН;
		
		Если ЗадатьСертификатыФСС Тогда
			УстанавливаемыеСертификаты = Новый Массив;
			
			СертификатКорневогоУЦ.Вставить("Хранилище", "ROOT");
			УстанавливаемыеСертификаты.Добавить(СертификатКорневогоУЦ);
			
			СертификатУЦ.Вставить("Хранилище", "CA");
			УстанавливаемыеСертификаты.Добавить(СертификатУЦ);
			
			Если ЗадатьСертификатФСС Тогда
				СертификатФСС.Вставить("Хранилище", "AddressBook");
				УстанавливаемыеСертификаты.Добавить(СертификатФСС);
			КонецЕсли;
			
			Если ЗадатьСертификатФССЭЛН Тогда
				СертификатФССЭЛН.Вставить("Хранилище", "AddressBook");
				УстанавливаемыеСертификаты.Добавить(СертификатФССЭЛН);
			КонецЕсли;
			
			ВходящийКонтекст.Вставить("СертификатФССОтпечаток", 	?(ЗадатьСертификатФСС, СертификатФСС.Отпечаток, ""));
			ВходящийКонтекст.Вставить("СертификатФССЭЛНОтпечаток", 	?(ЗадатьСертификатФССЭЛН, СертификатФССЭЛН.Отпечаток, ""));
		КонецЕсли;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОпределитьЗадаваемыеСертификатыФССПослеУстановкиСертификатов",
		ЭтотОбъект, ВходящийКонтекст);
	
	Если ЗадатьСертификатыФСС Тогда
		УстановитьСертификаты(
			Оповещение,
			УстанавливаемыеСертификаты,
			КонтекстМоделиХраненияКлюча(ВходящийКонтекст));
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьЗадаваемыеСертификатыФССПослеУстановкиСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		Если НЕ ЭтоЛокальнаяПодпись(ВходящийКонтекст) Тогда
			МассивАдресовДанныхСертификатов = Новый Массив;
			Для каждого ИнформацияОСертификатеФСС Из ВходящийКонтекст.ИнформацияОСертификатахФСС Цикл
				Если Прав(ИнформацияОСертификатеФСС.Ключ, 6) = "Данные" И ИнформацияОСертификатеФСС.Значение <> Неопределено Тогда
					МассивАдресовДанныхСертификатов.Добавить(ИнформацияОСертификатеФСС.Значение);
				КонецЕсли;
			КонецЦикла;
			УдалитьАдресаИзВременногоХранилища(МассивАдресовДанныхСертификатов);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Неопределено);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("СертификатФССОтпечаток", 		ВходящийКонтекст.СертификатФССОтпечаток);
	РезультатВыполнения.Вставить("СертификатФССЭЛНОтпечаток", 	ВходящийКонтекст.СертификатФССЭЛНОтпечаток);
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
	
КонецПроцедуры

&НаСервере
Функция ИнформацияОСертификатахФССНаСервере(ВозвращатьАдреса = Ложь, ВозвращатьТестовые = Ложь)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Если КонтекстЭДОСервер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	ИменаМакетовСертификатов = Новый Массив;
	ИменаМакетовСертификатов.Добавить("ФСССертификат");
	ИменаМакетовСертификатов.Добавить("ФСССертификатГОСТ2012");
	ИменаМакетовСертификатов.Добавить("ФССЭЛНСертификат");
	ИменаМакетовСертификатов.Добавить("ФССЭЛНСертификатГОСТ2012");
	Если ВозвращатьТестовые Тогда
		ИменаМакетовСертификатов.Добавить("ФССЭЛНТестовыйСертификат");
		ИменаМакетовСертификатов.Добавить("ФССЭЛНТестовыйСертификатГОСТ2012");
	КонецЕсли;
	ИменаМакетовСертификатов.Добавить("ФСССертификатУЦ");
	ИменаМакетовСертификатов.Добавить("ФСССертификатУЦГОСТ2012");
	ИменаМакетовСертификатов.Добавить("КорневойСертификатУЦ");
	ИменаМакетовСертификатов.Добавить("КорневойСертификатУЦГОСТ2012");
	
	МетаданныеМакетовОбработки = КонтекстЭДОСервер.Метаданные().Макеты;
	Для каждого ИмяМакетаСертификата Из ИменаМакетовСертификатов Цикл
		ОтпечатокСертификата = "";
		ДанныеСертификата = Неопределено;
		
		ОбъектМетаданныхМакет = МетаданныеМакетовОбработки.Найти(ИмяМакетаСертификата);
		Если ОбъектМетаданныхМакет <> Неопределено Тогда
			КомментарийМакета = ОбъектМетаданныхМакет.Комментарий;
			ВхождениеДвоеточия = СтрНайти(КомментарийМакета, ":");
			ОтпечатокСертификата = Сред(КомментарийМакета, ВхождениеДвоеточия + 1);
			ОтпечатокСертификата = СокрЛП(ОтпечатокСертификата);
			ОтпечатокСертификата = нрег(ОтпечатокСертификата);
			
			ДанныеСертификата = КонтекстЭДОСервер.ПолучитьМакет(ИмяМакетаСертификата);
		КонецЕсли;
		
		Результат.Вставить(ИмяМакетаСертификата + "Отпечаток", ОтпечатокСертификата);
		ДанныеСертификата = ?(ДанныеСертификата = Неопределено, Неопределено,
			?(ВозвращатьАдреса, ПоместитьВоВременноеХранилище(ДанныеСертификата, Новый УникальныйИдентификатор),
			Base64Строка(ДанныеСертификата)));
		Результат.Вставить(ИмяМакетаСертификата + "Данные", ДанныеСертификата);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСертификаты(
		ОповещениеОЗавершении,
		УстанавливаемыеСертификаты,
		МестоХраненияКлюча)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("УстанавливаемыеСертификаты", 			УстанавливаемыеСертификаты);
	ДополнительныеПараметры.Вставить("ИндексСертификата", 					0);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыВЦикле", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатыВЦикле(Результат, ВходящийКонтекст) Экспорт
	
	Если ВходящийКонтекст.ИндексСертификата >= ВходящийКонтекст.УстанавливаемыеСертификаты.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыПослеПоискаСертификата", ЭтотОбъект, ВходящийКонтекст);
	
	ОтпечатокСертификата = ВходящийКонтекст.УстанавливаемыеСертификаты[ВходящийКонтекст.ИндексСертификата].Отпечаток;
	ХранилищеСертификата = ВходящийКонтекст.УстанавливаемыеСертификаты[ВходящийКонтекст.ИндексСертификата].Хранилище;
	
	Если НЕ ЭтоЛокальнаяПодпись(ВходящийКонтекст) Тогда
		Если ЭтоПодписьСервиса(ВходящийКонтекст) Тогда
			СвойстваСертификата = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечатокСертификата, ХранилищеСертификата);
		Иначе
			СвойстваСертификата = ПолучитьСвойстваОблачногоСертификата(ОтпечатокСертификата, ХранилищеСертификата);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("Выполнено, СертификатНайден", Истина, СвойстваСертификата <> Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечатокСертификата, ХранилищеСертификата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатыПослеПоискаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.СертификатНайден Тогда
		ВходящийКонтекст.ИндексСертификата = ВходящийКонтекст.ИндексСертификата + 1;
		Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыВЦикле", ЭтотОбъект, ВходящийКонтекст);
		
		ВыполнитьОбработкуОповещения(Оповещение);
		
	Иначе
		ДанныеСертификата64 = ВходящийКонтекст.УстанавливаемыеСертификаты[ВходящийКонтекст.ИндексСертификата].Данные;
		
		Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыПослеЗаписиФайлаСертификата",
			ЭтотОбъект, ВходящийКонтекст);
			
		Если НЕ ЭтоЛокальнаяПодпись(ВходящийКонтекст) Тогда
			ДанныеСертификата = Base64Значение(ДанныеСертификата64);
			АдресСертификата = ПоместитьВоВременноеХранилище(ДанныеСертификата, Новый УникальныйИдентификатор);
			РезультатВыполнения = Новый Структура("Выполнено, ИмяФайла", Истина, АдресСертификата);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ДанныеСертификата64);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатыПослеЗаписиФайлаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСертификата = Результат.ИмяФайла;
	ХранилищеСертификата = ВходящийКонтекст.УстанавливаемыеСертификаты[ВходящийКонтекст.ИндексСертификата].Хранилище;
	
	ВходящийКонтекст.Вставить("ИмяФайлаСертификата", ИмяФайлаСертификата);
	Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыПослеИмпортаСертификата", ЭтотОбъект, ВходящийКонтекст);
	
	Если ЭтоПодписьСервиса(ВходящийКонтекст) Тогда
		РезультатРегистрации = ЗарегистрироватьСертификатВСистемеНаСервере(ИмяФайлаСертификата, ХранилищеСертификата);
		РезультатВыполнения = Новый Структура("Выполнено", РезультатРегистрации);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	ИначеЕсли ЭтоОблачнаяПодпись(ВходящийКонтекст) Тогда
		РезультатРегистрации = ЗарегистрироватьСертификатВХранилищеПолучателей(ИмяФайлаСертификата, ХранилищеСертификата);
		РезультатВыполнения = Новый Структура("Выполнено", РезультатРегистрации);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		КриптографияЭДКОКлиент.ИмпортироватьСертификат(Оповещение, ИмяФайлаСертификата, ХранилищеСертификата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатыПослеИмпортаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если ЭтоЛокальнаяПодпись(ВходящийКонтекст) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ВходящийКонтекст.ИмяФайлаСертификата);
	Иначе
		УдалитьИзВременногоХранилища(ВходящийКонтекст.ИмяФайлаСертификата);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ВходящийКонтекст.ИндексСертификата = ВходящийКонтекст.ИндексСертификата + 1;
	Оповещение = Новый ОписаниеОповещения("УстановитьСертификатыВЦикле", ЭтотОбъект, ВходящийКонтекст);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область ШифрованиеSOAP

&НаКлиенте
Процедура ЗашифроватьФайлXML(
		СертификатПолучателя,
		СертификатШифрованияОтвета,
		ФайлДанных,
		ВыполняемоеОповещение,
		ЗашифрованныйФайл = Неопределено,
		ВозвращатьАдрес = Ложь,
		НастройкиОперации = Неопределено) Экспорт
		
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатШифрованияОтвета);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СертификатПолучателя", 				СертификатПолучателя);
	ДополнительныеПараметры.Вставить("СертификатШифрованияОтвета", 			СертификатШифрованияОтвета);
	ДополнительныеПараметры.Вставить("ФайлДанных", 							ФайлДанных);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗашифрованныйФайл", 					ЗашифрованныйФайл);
	ДополнительныеПараметры.Вставить("ВозвращатьАдрес", 					ВозвращатьАдрес);
	ДополнительныеПараметры.Вставить("НастройкиОперации", 					НастройкиОперации);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеСозданияКаталога", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(Оповещение);
	Иначе
		РезультатОперацииСФайлами = Новый Структура("Выполнено, ДвоичныеДанные, ИмяКаталога", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатОперацииСФайлами);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеСозданияКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	КаталогРезультатовШифрования = Результат.ИмяКаталога;
	
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		КаталогРезультатовШифрования = Новый Структура;
		КаталогРезультатовШифрования.Вставить("ЗашифрованныйФайл", 			Новый УникальныйИдентификатор);
		КаталогРезультатовШифрования.Вставить("ПубличныйКлючОтправителя", 	Новый УникальныйИдентификатор);
		КаталогРезультатовШифрования.Вставить("СессионныйКлюч", 			Новый УникальныйИдентификатор);
		КаталогРезультатовШифрования.Вставить("ИнициализационныйВектор", 	Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("КаталогРезультатовШифрования", КаталогРезультатовШифрования);
	
	Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЗаданияФайловКаталога",
		ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЗаданияФайловКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	НастройкиОперации = ДополнительныеПараметры.НастройкиОперации;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура;
		Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиОперации, "СценарийФСС", Истина) Тогда
			ПараметрыОперации.Вставить("ПараметрыШифрования", Новый Структура("UseFssScenario", "tr"));
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЗашифрованияОблачнойПодписью", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ЗашифроватьXML(
			Оповещение,
			МестоХраненияКлюча,
			ДополнительныеПараметры.ФайлДанных,
			ДополнительныеПараметры.СертификатПолучателя,
			ДополнительныеПараметры.КаталогРезультатовШифрования,
			, ПараметрыОперации);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЗашифрования", ЭтотОбъект, ДополнительныеПараметры);
		ПараметрыКриптографии = Новый Структура("АлгоритмШифрования, АлгоритмКлюча, Режим", 0, 26142, 1);
		КриптографияЭДКОКлиент.Зашифровать(
			Оповещение,,
			ДополнительныеПараметры.ФайлДанных,
			ДополнительныеПараметры.СертификатПолучателя,
			ПараметрыКриптографии,
			ДополнительныеПараметры.КаталогРезультатовШифрования,
			Ложь);
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЗашифрования(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиОперации 					= ДополнительныеПараметры.НастройкиОперации;
	КаталогРезультатовШифрования 		= ДополнительныеПараметры.КаталогРезультатовШифрования;
	
	Если НЕ Результат.Выполнено Тогда
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеВопросаПриОшибкеЗашифрования",
			ЭтотОбъект, ДополнительныеПараметры);
			
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ НастройкиОперации = Неопределено
			ИЛИ НЕ НастройкиОперации.Свойство("Применение") ИЛИ НастройкиОперации.Применение <> "ОтправкиФСС" Тогда
			
			Если Результат.Свойство("КаталогРезультатаИлиАдреса") Тогда
				ДополнительныеПараметры.Вставить("КаталогРезультатаИлиАдресаВМоделиСервиса", Результат.КаталогРезультатаИлиАдреса);
			КонецЕсли;
			
			ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
			
		Иначе
			ПоказатьВопросПриОшибкеКриптооперации(
				Оповещение,
				"Зашифровать",
				Результат.ОписаниеОшибки);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("Алгоритм") Тогда
		Алгоритм = Результат.Алгоритм;
		
	ИначеЕсли ДополнительныеПараметры.СертификатПолучателя.Свойство("Сертификат") Тогда
		Сертификат64 = Base64Строка(ДополнительныеПараметры.СертификатПолучателя.Сертификат);
		Алгоритм = АлгоритмСертификата(Сертификат64, МестоХраненияКлюча);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("Алгоритм", Алгоритм);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		КаталогРезультатовШифрования = Результат.КаталогРезультатаИлиАдреса;
		ДополнительныеПараметры.Вставить("СимметричныйКлючВBase64", 		КаталогРезультатовШифрования.СессионныйКлюч);
		ДополнительныеПараметры.Вставить("ПубличныйКлючВBase64", 			КаталогРезультатовШифрования.ПубличныйКлючОтправителя);
		ДополнительныеПараметры.Вставить("ИнициализационныйВекторВBase64", 	КаталогРезультатовШифрования.ИнициализационныйВектор);
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЧтенияЗашифрованныхДанных",
			ЭтотОбъект, ДополнительныеПараметры);
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, КаталогРезультатовШифрования.ЗашифрованныйФайл);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЧтенияСимметричногоКлюча",
			ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, КаталогРезультатовШифрования + "_skey.bin");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеВопросаПриОшибкеЗашифрования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Повторить Тогда
		Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЗаданияФайловКаталога",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
		
	Иначе
		Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
			КаталогРезультатовШифрования = ?(ДополнительныеПараметры.Свойство("КаталогРезультатаИлиАдресаВМоделиСервиса"),
				ДополнительныеПараметры.КаталогРезультатаИлиАдресаВМоделиСервиса, Неопределено);
			Если КаталогРезультатовШифрования <> Неопределено Тогда
				УдалитьАдресаИзВременногоХранилища(
					КаталогРезультатовШифрования.ЗашифрованныйФайл,
					КаталогРезультатовШифрования.ПубличныйКлючОтправителя,
					КаталогРезультатовШифрования.СессионныйКлюч,
					КаталогРезультатовШифрования.ИнициализационныйВектор);
			КонецЕсли;
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ДополнительныеПараметры.КаталогРезультатовШифрования);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗашифроватьФайлXMLПослеЧтенияСимметричногоКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	КаталогРезультатовШифрования = ДополнительныеПараметры.КаталогРезультатовШифрования;
	
	Если НЕ Результат.Выполнено Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,КаталогРезультатовШифрования);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СимметричныйКлючВBase64 = Результат.СтрокаBase64;
	
	ДополнительныеПараметры.Вставить("СимметричныйКлючВBase64", СимметричныйКлючВBase64);
	Оповещение = Новый ОписаниеОповещения("ЗашифроватьФайлXMLПослеЧтенияПубличногоКлюча",
		ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, КаталогРезультатовШифрования + "_pubkey.bin");
	
КонецПроцедуры

