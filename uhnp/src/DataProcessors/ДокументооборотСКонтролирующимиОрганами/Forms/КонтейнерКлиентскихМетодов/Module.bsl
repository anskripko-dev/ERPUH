		ОписаниеОповещения = Новый ОписаниеОповещения("ПоказатьПредупреждениеЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
		ПоказатьПредупреждение(ОписаниеОповещения,Результат.Предупреждение);
