		ДобавитьУзелXML(УзелЮЛ, "КПП", 		Истина, РеквизитыПолучателя.КПП);
		
    ИначеЕсли ЗначениеЗаполнено(РеквизитыПолучателя.ИННФЛ)
	И ЗначениеЗаполнено(РеквизитыПолучателя.Фамилия) 
	И ЗначениеЗаполнено(РеквизитыПолучателя.Имя) Тогда
    	//ФЛ
		УзелФЛ = ДобавитьУзелXML(УзелСвПолДок, "ОтпрФЛ");
		ДобавитьУзелXML(УзелФЛ, "ИННФЛ", 	Истина, РеквизитыПолучателя.ИННФЛ);
		УзелФИО = ДобавитьУзелXML(УзелФЛ, "ФИО");
		ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, РеквизитыПолучателя.Фамилия);
		ДобавитьУзелXML(УзелФИО, "Имя", Истина, РеквизитыПолучателя.Имя);
