&НаКлиенте
Функция ПредставлениеДополнительныхНастроекОблачнойПодписи(РеквизитыЗаявления) Экспорт
	
	Результат = "";
	МассивСтрок = Новый Массив;
	
	Если РеквизитыЗаявления.СменитьПароль Тогда
		МассивСтрок.Добавить(НСтр("ru = 'Смена пароля';
									|en = 'Смена пароля'"));
	КонецЕсли;
	
	Если РеквизитыЗаявления.СменитьКлючМобильногоПриложения
		ИЛИ РеквизитыЗаявления.СменитьКлючМобильногоПриложенияАвтоматически Тогда
		МассивСтрок.Добавить(НСтр("ru = 'Смена ключа мобильного приложения';
									|en = 'Смена ключа мобильного приложения'"));
	КонецЕсли;
	
	Если РеквизитыЗаявления.ОтправкаКодаАктивации Тогда
		МассивСтрок.Добавить(НСтр("ru = 'Повторная отправка кода активации';
									|en = 'Повторная отправка кода активации'"));
	КонецЕсли;
	
	Если РеквизитыЗаявления.ОтправкаКлючаМобильногоПриложения Тогда
		МассивСтрок.Добавить(НСтр("ru = 'Повторная отправка QR-кода';
									|en = 'Повторная отправка QR-кода'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыЗаявления.Телефон)
		ИЛИ ЗначениеЗаполнено(РеквизитыЗаявления.ЭлектроннаяПочта) Тогда
		МассивСтрок.Добавить(НСтр("ru = 'Отдельные контакты';
									|en = 'Отдельные контакты'"));
	КонецЕсли;
	
	ЗаголовокНастроек = НСтр("ru = 'Дополнительные настройки электронной подписи';
							|en = 'Дополнительные настройки электронной подписи'");
	
	Если МассивСтрок.Количество() = 0 Тогда
		ЗаголовокНастроек = "Для электронной подписи не заданы настройки";
		МассивСтрок.Добавить(НСтр("ru = 'Настроить';
									|en = 'Настроить'"));
	КонецЕсли;
	
	Результат = "<span>" + ЗаголовокНастроек + "</span>" + Символы.ПС;
	ЕстьЗапятая = Ложь;
	Для Каждого СтрокаМассива Из МассивСтрок Цикл
		Результат = Результат + ?(ЕстьЗапятая, ", ", "") + "<a href=""Ссылка"">" + СтрокаМассива + "</a>";
		ЕстьЗапятая = Истина;
	КонецЦикла;
	
	Возврат СтроковыеФункцииКлиент.ФорматированнаяСтрока(Результат);
	
КонецФункции

&НаКлиенте
Процедура ДополнительныеНастройкиОблачнойЗаписиВЗаявлении(ОповещениеОЗавершении, КонтекстФормы, ЭтоПроверка = Ложь) Экспорт
	
	ЭтоЗаявлениеНаПодключение = ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоФормаПервичногоЗаявления(КонтекстФормы);
	
	ПараметрыЦикла = Новый Структура;
	ПараметрыЦикла.Вставить("КонтекстФормы", КонтекстФормы);
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ОповещениеСледующее = Новый ОписаниеОповещения("ДополнительныеНастройкиОблачнойЗаписиВЗаявленииЗавершении", ЭтотОбъект, ПараметрыЦикла);
	
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаКлиентСервер.СведенияОблачнойПодписиЗаявления();
	ЗаполнитьЗначенияСвойств(РеквизитыЗаявления, КонтекстФормы.СвойствоОблачнойПодписи);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЭтоЗаявлениеНаПодключение", ЭтоЗаявлениеНаПодключение);
	ПараметрыФормы.Вставить("ПереизданиеСертификата", (ЭтоЗаявлениеНаПодключение ИЛИ КонтекстФормы.ПереиздатьСертификат <> 0)
								И ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(КонтекстФормы));
	ПараметрыФормы.Вставить("УчетнаяЗапись", РеквизитыЗаявления.УчетнаяЗапись);
	ПараметрыФормы.Вставить("Телефон", РеквизитыЗаявления.Телефон);
	ПараметрыФормы.Вставить("ЭлектроннаяПочта", РеквизитыЗаявления.ЭлектроннаяПочта);
	ПараметрыФормы.Вставить("Логин", РеквизитыЗаявления.НовыйЛогин);
	ПараметрыФормы.Вставить("СменаКлючаМобильногоПриложения", РеквизитыЗаявления.СменитьКлючМобильногоПриложения);
	ПараметрыФормы.Вставить("СменаКлючаМобильногоПриложенияАвтоматически", РеквизитыЗаявления.СменитьКлючМобильногоПриложенияАвтоматически);
	ПараметрыФормы.Вставить("СменаПароля", РеквизитыЗаявления.СменитьПароль);
	ПараметрыФормы.Вставить("ПовторнаяОтправкаКодаАктивации", РеквизитыЗаявления.ОтправкаКодаАктивации);
	ПараметрыФормы.Вставить("ПовторнаяОтправкаКлючМобильногоПриложения", РеквизитыЗаявления.ОтправкаКлючаМобильногоПриложения);
	ПараметрыФормы.Вставить("ЭтоПроверка", ЭтоПроверка);
	
	Если ЭтоЗаявлениеНаПодключение И НЕ ЗначениеЗаполнено(ПараметрыФормы.Телефон) Тогда
		ПараметрыФормы.Телефон = КриптографияЭДКОКлиентСервер.ТелефонПодтвержденияОпераций(КонтекстФормы.ТелефонМобильный);
	КонецЕсли;
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкиОблачнойПодписиВЗаявлении", ПараметрыФормы, , , , , ОповещениеСледующее);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеНастройкиОблачнойЗаписиВЗаявленииЗавершении(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	Результат = Новый Структура("Выполнено, Состояние", Ложь, "");
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	ОповещениеОЗавершении = ПараметрыЦикла.ОповещениеОЗавершении;
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		РеквизитыЗаявления = ОбработкаЗаявленийАбонентаКлиентСервер.СведенияОблачнойПодписиЗаявления();
		ЗаполнитьЗначенияСвойств(РеквизитыЗаявления, КонтекстФормы.СвойствоОблачнойПодписи);
		
		РеквизитыЗаявления.ЭлектроннаяПочта = РезультатВыбора.ЭлектроннаяПочта;
		РеквизитыЗаявления.Телефон = РезультатВыбора.Телефон;
		РеквизитыЗаявления.СменитьКлючМобильногоПриложения = РезультатВыбора.СменаКлючаМобильногоПриложения;
		РеквизитыЗаявления.СменитьПароль = РезультатВыбора.СменаПароля;
		РеквизитыЗаявления.ОтправкаКодаАктивации = РезультатВыбора.ПовторнаяОтправкаКодаАктивации;
		РеквизитыЗаявления.ОтправкаКлючаМобильногоПриложения = РезультатВыбора.ПовторнаяОтправкаКлючМобильногоПриложения;
		
		ЗаполнитьЗначенияСвойств(КонтекстФормы.СвойствоОблачнойПодписи, РеквизитыЗаявления);
		
		Результат.Выполнено = Истина;
		Результат.Состояние = ПредставлениеДополнительныхНастроекОблачнойПодписи(РеквизитыЗаявления);
		
	КонецЕсли;
	
	Если ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнформациюОбОблачнойПодписи(ФормаВладелец, ОбработкаОповещения = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ИнформацияОбОблачнойПодписи", 
				ПараметрыФормы, 
				ФормаВладелец, 
				Новый УникальныйИдентификатор(), , , 
				ОбработкаОповещения,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокУчетыхЗаписейОблачнойПодписи(ОтборЗаписей = Неопределено)
	
	ВсеЗаписи = Новый ТаблицаЗначений;
	
	Если КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно() Тогда
		МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
		ВсеЗаписи = МодульСервисКриптографииDSS.ПолучитьВсеУчетныеЗаписи();
	КонецЕсли;
	
	ВсеЗаписи.Колонки.Добавить("ПризнакОтбора", Новый ОписаниеТипов("Булево"));
	ВсеЗаписи = ОбщегоНазначения.ТаблицаЗначенийВМассив(ВсеЗаписи);
	
	Если ОтборЗаписей <> Неопределено Тогда
		
		ОтборПоставляемых = СвойствоСтруктуры(ОтборЗаписей, "ПоставляемыйСервер");
		ОтборНаименования = СвойствоСтруктуры(ОтборЗаписей, "Наименование");
		
		Счетчик = ВсеЗаписи.Количество() - 1;
		Пока Счетчик >= 0 Цикл
			ТекущаяЗапись = ВсеЗаписи[Счетчик];
			Если ОтборНаименования <> Неопределено И СтрНайти(ТекущаяЗапись.Наименование, ОтборНаименования) > 0 Тогда
				ТекущаяЗапись.ПризнакОтбора = Истина;
			КонецЕсли;
			
			Если ОтборПоставляемых <> Неопределено И НЕ ЗначениеЗаполнено(ТекущаяЗапись.ВнутреннийИдентификатор) = ОтборПоставляемых Тогда
				ВсеЗаписи.Удалить(Счетчик);
			КонецЕсли;
			
			Счетчик = Счетчик - 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ВсеЗаписи;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьУчетнуюЗаписьОблачнойПодписи(ОповещениеОЗавершении, ФормаВладелец, ПараметрыОперации = Неопределено, ОтборЗаписей = Неопределено) Экспорт
	
	ПараметрыЦикла = Новый Структура;
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ПараметрыЦикла.Вставить("Сообщение", Ложь);
	
	ИмяОтбора = СвойствоСтруктуры(ПараметрыОперации, "ПредставлениеОтбора", "");
	ТекущаяЗапись = СвойствоСтруктуры(ПараметрыОперации, "ТекущаяЗапись", ТекущаяЗапись);
	
	ОповещениеСледующее = Новый ОписаниеОповещения("ВыбратьУчетнуюЗаписьОблачнойПодписиЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	ВсеЗаписи = СписокУчетыхЗаписейОблачнойПодписи(ОтборЗаписей);
	Если ВсеЗаписи.Количество() = 0 Тогда
		ПараметрыЦикла.Вставить("Сообщение", Истина);
		МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
		МодульСервисКриптографииDSSКлиент.ВывестиИнформацию(ОповещениеСледующее,
			НСтр("ru = 'Не обнаружены учетные записи для выбора';
				|en = 'Не обнаружены учетные записи для выбора'"));
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПредставлениеОтбора", ИмяОтбора);
		ПараметрыФормы.Вставить("ТаблицаВыбора", ВсеЗаписи);
		ПараметрыФормы.Вставить("ТекущаяЗапись", ТекущаяЗапись);
		ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_ВыборУчетнойЗаписиDSS", 
					ПараметрыФормы, 
					ФормаВладелец, Новый УникальныйИдентификатор(), , , 
					ОповещениеСледующее,
					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУчетнуюЗаписьОблачнойПодписиЗавершение(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	ОповещениеОЗавершении = ПараметрыЦикла.ОповещениеОЗавершении;
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Результат", Неопределено);
	
	Если НЕ ПараметрыЦикла.Сообщение Тогда
		Результат.Вставить("Выполнено", ЗначениеЗаполнено(РезультатВыбора));
		Результат.Вставить("Результат", РезультатВыбора);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	
КонецПроцедуры

#Область ПроверкиУникальностиЛогинаОблачнойПодписи

&НаКлиенте
Процедура ПроверитьУникальностьЛогинаОблачнойПодписи(ОповещениеОЗавершении, ИдентификаторСервера, НовыйЛогин) Экспорт
	
	ПараметрыЦикла = Новый Структура;
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ОповещениеСледущее = Новый ОписаниеОповещения("ПроверитьУникальностьЛогинаЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Проверка дублирования логина в сервисе электронной подписи';
											|en = 'Проверка дублирования логина в сервисе электронной подписи'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	
	ОписаниеОперации = СервисПроверкиЛогинаОблачнойПодписи(ИдентификаторСервера, НовыйЛогин);
	Если ЗначениеЗаполнено(ОписаниеОперации.УчетнаяЗапись) Тогда
		Результат = Новый Структура;
		Результат.Вставить("Статус", "Найден");
		Результат.Вставить("УчетнаяЗапись", ОписаниеОперации.УчетнаяЗапись);
		ВыполнитьОбработкуОповещения(ОповещениеСледущее, Результат);
	Иначе	
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ОписаниеОперации.ФоноваяЗадача, ОповещениеСледущее, ПараметрыОжидания);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУникальностьЛогинаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении = ДополнительныеПараметры.ОповещениеОЗавершении;
	Статус = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыполнения, "Статус", "Неопределено");
	Варианты = "";
	УчетнаяЗапись = Неопределено;
	
	Если Статус = "Найден" Тогда
		УчетнаяЗапись = РезультатВыполнения.УчетнаяЗапись;
		
	ИначеЕсли Статус = "Выполнено" Тогда
		ОтветСервиса = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		
		Если ОтветСервиса.Пройден = Неопределено Тогда
			Статус = "Неопределено";
			
		ИначеЕсли НЕ ОтветСервиса.Пройден Тогда
			Статус = "Дублирование";
			Варианты = ОтветСервиса.Варианты;
			
		Иначе
			Статус = "Успех";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Варианты", Варианты);
	Результат.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	
КонецПроцедуры

&НаСервере
Функция СервисПроверкиЛогинаОблачнойПодписи(ИдентификаторСервера, НовыйЛогин)
	
	Результат = Новый Структура;
	Результат.Вставить("ФоноваяЗадача", Неопределено);
	Результат.Вставить("УчетнаяЗапись", Неопределено);
	
	ФильтрПоиска = Новый Соответствие;
	ФильтрПоиска.Вставить("Владелец.ВнутреннийИдентификатор", ИдентификаторСервера);
	ФильтрПоиска.Вставить("Логин", НовыйЛогин);
	
	МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
	НашлиУчетнуюЗапись = МодульСервисКриптографииDSS.НайтиУчетнуюЗапись(ФильтрПоиска);
	
	Если НЕ ЗначениеЗаполнено(НашлиУчетнуюЗапись) Тогда
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Вызов API Калуги-Астрал';
																|en = 'Вызов API Калуги-Астрал'");
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
		
		ПараметрыВызова = Новый Структура();
		ПараметрыВызова.Вставить("Логин", НовыйЛогин);
		ПараметрыВызова.Вставить("ВнутреннийИдентификатор", ИдентификаторСервера);
		
		Результат.Вставить("ФоноваяЗадача", ДлительныеОперации.ВыполнитьВФоне(
						"Обработки.ДокументооборотСКонтролирующимиОрганами.ОбменССерверомПроверитьЛогинФоновое", 
						ПараметрыВызова, 
						ПараметрыВыполнения));
	Иначе
		Результат.Вставить("УчетнаяЗапись", НашлиУчетнуюЗапись);
	КонецЕсли;					
					
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

&НаКлиенте
Процедура СформироватьЗакрытыйКлючИЗапросНаСертификат_ОшибкаСозданияКлюча(
		ВходящийКонтекст,
		ТекстОшибкиПриСозданииКлюча = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТекстОшибкиПриСозданииКлюча = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Криптографическая ошибка: не удалось создать контейнер закрытого ключа.';
							|en = 'Криптографическая ошибка: не удалось создать контейнер закрытого ключа.'");
	Иначе 
		ТекстОшибки = ТекстОшибкиПриСозданииКлюча;
	КонецЕсли;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
		ТекстОшибки, 
		ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
		ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
		
	ИмяСобытия = НСтр("ru = 'Упрощенное заявление. Ошибка создание закрытого ключа';
						|en = 'Упрощенное заявление. Ошибка создание закрытого ключа'");
	Оповестить(ИмяСобытия, ТекстОшибки, ВходящийКонтекст.ДокументЗаявление);
		
	СтруктураРезультата = Новый Структура("ПродолжитьОтправкуЗаявления, ТекстОшибки, ПутьКонтейнерЗакрытогоКлюча", 
											Ложь, ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности, "");
											
	ВыполнитьОбработкуОповещения(
		ВходящийКонтекст.ВыполняемоеОповещение, 
		СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Функция КонтейнерЗакрытогоКлючаСохраненКорректно(ИмяКонтейнера, ВходящийКонтекст)
	
	ОбязателенТокен = ОбязателенТокен(ВходящийКонтекст);
	
	КонтейнераСохраненНаТокен = СтрНайти(ВРег(ИмяКонтейнера), "SCARD") > 0;
	
	Если ОбязателенТокен Тогда
		Корректно = КонтейнераСохраненНаТокен;
	Иначе
		Корректно = Истина;
	КонецЕсли;
	
	Возврат Корректно;

КонецФункции

&НаКлиенте
Функция ОбязателенТокен(ВходящийКонтекст)
	
	ДокументЗаявление        = ВходящийКонтекст.ДокументЗаявление;
	ЭтоТестирование          = ДокументооборотСКОКлиент.ИспользуетсяРежимТестирования();
	ЭтоРуководитель          = ОбработкаЗаявленийАбонентаВызовСервера.ЭтоРуководитель(ДокументЗаявление);
	ЭтоБюджетополучатель     = ДокументЗаявление.ЭтоБюджетополучатель;
	ИспользоватьСуществующий = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(ДокументЗаявление);
	ЭтоФНС                   = ДокументЗаявление.УдостоверяющийЦентр = ПредопределенноеЗначение("Перечисление.УдостоверяющиеЦентрыБРО.УЦФНС");
	ЭтоАЦУЦ                  = ДокументЗаявление.УдостоверяющийЦентр = ПредопределенноеЗначение("Перечисление.УдостоверяющиеЦентрыБРО.УЦАналитическийЦентр");
	
	ОбязателенТокен = 
		НЕ ЭтоБюджетополучатель 
		И ЭтоРуководитель
		И НЕ ИспользоватьСуществующий
		И НЕ ЭтоТестирование
		И (ЭтоФНС ИЛИ ЭтоАЦУЦ);
	
	Возврат ОбязателенТокен;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяФайлаТребованияИзОписания(Требование)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	Опись 		= ДокументооборотСКОВызовСервера.ПолучитьОписьВходящихДокументовПоТребованию(Требование);
	ЦиклОбмена 	= ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Опись);
	Сообщения	= КонтекстЭДОСервер.ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь,Истина);
	
	СтрДокументНО = Сообщения.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДокументНО));
	Если СтрДокументНО.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли; 
	ТранспортноеСообщение = СтрДокументНО[0].Ссылка;
	Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ);

	Если Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	Вложения[0].Данные.Получить().Записать(ВремФайл);
	
	ДеревоОписания = КонтекстЭДОСервер.ЗагрузитьXMLВДеревоЗначений(ВремФайл);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВремФайл);
	Если ДеревоОписания = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДокНапрИзНО = ДеревоОписания.Строки.Найти("ДокНапрИзНО", "Имя", Истина);
	Если ДокНапрИзНО = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиИнфСообДок = ДокНапрИзНО.Строки;
	
	Для каждого СтрокаИнфСообДок Из СтрокиИнфСообДок Цикл
		
		Строки = СтрокаИнфСообДок.Строки;
		НомФайлДок = Строки.Найти("НомФайлДок", "Имя", Истина);
		Если НомФайлДок = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если Врег(СокрЛП(НомФайлДок.Значение)) = Врег(СокрЛП(Требование.НомерДокумента)) Тогда
			
			ИмяФайл = Строки.Найти("ИмяФайл", "Имя", Истина);
			Если ИмяФайл = Неопределено Тогда
				Возврат "";
			КонецЕсли;
			Возврат ИмяФайл.Значение;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдФайлЗаяв(Требование) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	Опись 		= ДокументооборотСКОВызовСервера.ПолучитьОписьВходящихДокументовПоТребованию(Требование);
	ЦиклОбмена 	= ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Опись);
	Сообщения	= КонтекстЭДОСервер.ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь,Истина);
	
	СтрДокументНО = Сообщения.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДокументНО));
	Если СтрДокументНО.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли; 
	ТранспортноеСообщение = СтрДокументНО[0].Ссылка;
	Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ);

	Если Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	Вложения[0].Данные.Получить().Записать(ВремФайл);
	
	ДеревоОписания = КонтекстЭДОСервер.ЗагрузитьXMLВДеревоЗначений(ВремФайл);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВремФайл);
	Если ДеревоОписания = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДокНапрИзНО = ДеревоОписания.Строки.Найти("ДокНапрИзНО", "Имя", Истина);
	Если ДокНапрИзНО = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	УзелИдФайлЗаяв = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДокНапрИзНО,,, "ИдФайлЗаяв", "А");
	Если УзелИдФайлЗаяв = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат УзелИдФайлЗаяв.Значение;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСертификатыВРПриНеобходимости(ОповещениеОЗавершении) Экспорт
	
	Если НЕ ОбщегоНазначенияКлиент.ИнформационнаяБазаФайловая() Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"ПослеПоискаКорневогоСертификатаВР", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	Хранилище_Сертификатов  = Новый Структура;
	Хранилище_Сертификатов.Вставить("Хранилище", "ROOT");
	Хранилище_Сертификатов.Вставить("ЭтоЛокальноеХранилище", Истина);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(Оповещение, Хранилище_Сертификатов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПоискаКорневогоСертификатаВР(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ДвДанные  = ДвДанныеКорневогоСертификатаВР();
	Отпечаток = ОтпечатокСертификатаВР(ДвДанные);
	Сертификат = Неопределено;
	
	Для каждого ТекущийСертификат Из Результат.Сертификаты Цикл
		Если ТекущийСертификат.Отпечаток = Отпечаток Тогда
			Сертификат = ТекущийСертификат;
		КонецЕсли;
	КонецЦикла;
	
	Если Сертификат <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеЗаписиКорневогоСертификатаВРВФайл",
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	ДвДанные     = ДвДанныеКорневогоСертификатаВР();
	Сертификат64 = Base64Строка(ДвДанные);
	
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(ОписаниеОповещения, Сертификат64);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеЗаписиКорневогоСертификатаВРВФайл(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСертификата = Результат.ИмяФайла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеУстановкиКорневогоСертификатаВРВФайл",
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	КриптографияЭДКОКлиент.ИмпортироватьСертификат(
		ОписаниеОповещения, 
		ИмяФайлаСертификата, 
		"ROOT");
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеУстановкиКорневогоСертификатаВРВФайл(Результат, ВходящийКонтекст) Экспорт
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецПроцедуры

&НаСервере
Функция ДвДанныеКорневогоСертификатаВР()
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ДвДанные = КонтекстЭДОСервер.ПолучитьМакет("КорневойСертификатВР");
	
	Возврат ДвДанные;
	
КонецФункции

&НаСервере
Функция ОтпечатокСертификатаВР(ДвДанные)
	
	Сертификат = Новый СертификатКриптографии(ДвДанные);
	Отпечаток = Нрег(ПолучитьHexСтрокуИзДвоичныхДанных(Сертификат.Отпечаток));
	
	Возврат Отпечаток;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуИзмененияТипаВходящегоПисьмаПФР(МассивПисем, РежимИзменения) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокПисем", МассивПисем);
	ПараметрыФормы.Вставить("РежимИзменения", РежимИзменения);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ИзменитьТипВходящегоПисьмаПФР", ПараметрыФормы, Новый УникальныйИдентификатор,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#Область ТребованияОбработкаОтветов

&НаКлиенте
Функция ФормаДокументооборотаОткрыта(ИмяФормыПоиска)
	
	Окна = ПолучитьОкна();
	
	Если Окна = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	                  
	// Для формы, открытой в режиме "РежимОткрытияОкнаФормы.БлокироватьОкноВладельца",
	// не выполняется поиск по уникальному идентификатору, поэтому приходится искать самим.
	Для Каждого ОткрытоеОкно Из Окна Цикл
		Если ТипЗнч(ОткрытоеОкно) = Тип("ОкноКлиентскогоПриложения") 
			И ОткрытоеОкно.Содержимое.Количество() = 1
			И ОткрытоеОкно.Содержимое[0].ИмяФормы  = ИмяФормыПоиска Тогда
			
			Возврат ОткрытоеОкно.Содержимое[0].Открыта();
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьИнформациюПоТребованиямКлиент(Повторять = Ложь) Экспорт
	
	ИмяФормыТребования = ПутьКОбъекту + ".Форма.ИнформацияПоТребованиям";
	Если ФормаДокументооборотаОткрыта(ИмяФормыТребования) = Ложь Тогда
		
		Если Повторять Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПоказатьИнформациюПоТребованиямКлиент_Повторить", 
				ЭтотОбъект);
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения();
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Сейчас", ТекущаяДата());
		 
		ОткрытьФорму(ИмяФормыТребования,ДополнительныеПараметры,,Истина,,,ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнформациюПоТребованиямКлиент_Повторить(Повторять, ВходящийКонтекст) Экспорт
	
	Если Повторять = Ложь Тогда
		ДокументооборотСКОКлиент.ПодключениеОбработчикаОжиданияИнформацияПоТребованиям(Ложь);
	Иначе
		ДокументооборотСКОКлиент.ПодключениеОбработчикаОжиданияИнформацияПоТребованиям(Истина, 30 * 60);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ПолучитьУведомленияРПН(ВыполняемоеОповещение, Организация)
	
	РезультатПолучения = ПолучитьУведомленияРПННаСервере(Организация);
	
	Если НЕ РезультатПолучения.Выполнено И РезультатПолучения.ПовторятьСоединение Тогда
		СерверПриемаОтчетности = СерверПриемаОтчетностиРПН();
		СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(СерверПриемаОтчетности.Определение);
		ИмяСервера = ?(СтрНайти(СтруктураURI.ИмяСервера, ":") = 0 И нрег(СтруктураURI.Схема) = "https",
			СтруктураURI.Хост + ":443", СтруктураURI.ИмяСервера);
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось обратиться к серверу ""%1"" для получения уведомлений Росприроднадзора';
				|en = 'Не удалось обратиться к серверу ""%1"" для получения уведомлений Росприроднадзора'"),
			ИмяСервера);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("Организация", 			Организация);
		ДополнительныеПараметры.Вставить("ИмяСервера", 				ИмяСервера);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьУведомленияРПНПослеПолучения",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			ТекстОшибки,
			ОписаниеОповещения);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатПолучения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьУведомленияРПНПослеПолучения(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	Организация 			= ДополнительныеПараметры.Организация;
	ИмяСервера 				= ДополнительныеПараметры.ИмяСервера;
	
	Если РезультатДиалогаОбОшибкеДоступа = Истина Тогда
		ПолучитьУведомленияРПН(ВыполняемоеОповещение, Организация);
		
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось получить уведомления Росприроднадзора с сервера ""%1""';
				|en = 'Не удалось получить уведомления Росприроднадзора с сервера ""%1""'"),
			ИмяСервера);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУведомленияРПННаСервере(ОрганизацияИлиУчетнаяЗапись, ВыводитьСообщения = Истина) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьУведомленияРПН(ОрганизацияИлиУчетнаяЗапись, ВыводитьСообщения);
	
КонецФункции

#Область ОтправкаРегламентированногоОтчетаВЦБ

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБ(Док, ВыполняемоеОповещение) Экспорт
	
	Если НЕ ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		ТекстСообщения = НСтр("ru = 'Отправка отчетности в Банк России не поддерживается.';
								|en = 'Отправка отчетности в Банк России не поддерживается.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура();
	Контекст.Вставить("Док", 					Док);
	Контекст.Вставить("ОповещениеОЗавершении", 	ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВЦБПослеПодтвержденияПовторнойОтправки",
		ЭтотОбъект,
		Контекст);
	
	ПодтвердитьПовторнуюОтправку(Док, "ЦБ", ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Результат = КодВозвратаДиалога.Да;
	Параметры_ВходящийКонтекст = ВходящийКонтекст;
	
	ОтправкаРегламентированногоОтчетаВЦБПослеПодтвержденияПовторнойОтправки(Параметры_Результат, Параметры_ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеПодтвержденияПовторнойОтправки(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	
	Если НЕ ОтправкаРегламентированногоОтчетаВЦБ_ПередВыгрузкойФайла(КонтекстОтправки, Док, УникальныйИдентификатор) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаРегламентированногоОтчетаВЦБПослеПодтвержденияПовторнойОтправки_ПослеПроверкиЗаявления",
				ЭтотОбъект,
				ВходящийКонтекст);
				
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ОповещениеОЗавершении, Ложь); //+
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
			
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ОповещениеОЗавершении, Ложь); //+
		Возврат;

	КонецЕсли;
	
	// Выгрузка
	Оповещение = Новый ОписаниеОповещения("ОтправкаРегламентированногоОтчетаВЦБПослеВыгрузки", ЭтотОбъект, ВходящийКонтекст);
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	// выгружаем отчет и доверенность, при необходимости
	ВыгрузитьРегламентированныйОтчетЦБ(КонтекстОтправки, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеВыгрузки(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	
	РезультатВыгрузки     = Результат.РезультатВыгрузки;
	КонтекстОтправки      = Результат.Контекст; // Обновленный по результатам выгрузки контекст.
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если НЕ РезультатВыгрузки Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
		Возврат;
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВЦБПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", Док);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 7;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ЦБ
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРегламентированногоОтчетаВЦБПослеВыгрузки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРегламентированногоОтчетаВЦБПослеВыгрузки() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Док 				= КонтекстДлительнойОперации.Док;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи..."); // ЦБ рег. отчет
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВЦБ_ПослеПроверкиСертификатаИЛицензии",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.КонтекстОтправки.Документ, ВходящийКонтекст.КонтекстОтправки.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБ_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	// получаем свойства сертификатов абонента
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется проверка сертификатов..."); // ЦБ рег. отчет
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВЦБПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
	
	СформироватьПакетЦБ_ПроверкиСертификатов(Оповещение, ВходящийКонтекст.КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
		
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении 	= ВходящийКонтекст.ОповещениеОЗавершении;
	КонтекстОтправки 		= ВходящийКонтекст.КонтекстОтправки;
	
	// отражаем изменения в базе
	Если НЕ ОтправкаРегламентированногоОтчетаВЦБ_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВЦБПослеФормированияПакета", ЭтотОбъект, Контекст);
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ЦБ");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВЦБПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт 
	
	Если НЕ Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
		
		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(ВходящийКонтекст.КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ЦБ
		
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительноеСообщениеПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительноеСообщение",
			ВходящийКонтекст.КонтекстОтправки.ДополнительноеСообщениеПриУдачнойОтправке);
	КонецЕсли;
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительныеРеквизитыДляОтправкиПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеРеквизитыДляОтправки",
			ВходящийКонтекст.КонтекстОтправки.ДополнительныеРеквизитыДляОтправкиПриУдачнойОтправке);
	КонецЕсли;
	Если ВходящийКонтекст.КонтекстОтправки.Свойство("ДополнительныеВложенияДляОтправкиПриУдачнойОтправке") Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеВложенияДляОтправки",
			ВходящийКонтекст.КонтекстОтправки.ДополнительныеВложенияДляОтправкиПриУдачнойОтправке);
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ЦБ.
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетЦБ(Контекст, ВыполняемоеОповещение)

	Отчет = Контекст.Документ;
	ИмяМетаданныхДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ИмяМетаданныхДокумента = "РегламентированныйОтчет" Тогда
		Результат = Новый Массив;
		
		ВыгрузитьРегламентированныйОтчетЦБПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение);
		
	ИначеЕсли ИмяМетаданныхДокумента = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		Результат = ВыгрузитьРегламентированныйОтчетЦБИзВнешнихЭлектронныхПредставлений(Контекст);
		ВсегоВАрхиве = 0;
		Для каждого Запись Из Результат Цикл
			Если Запись.ВАрхиве Тогда
				ВсегоВАрхиве = ВсегоВАрхиве + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсегоВАрхиве > 0 Тогда //Данные одного или более файлов отсутствуют
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Контекст", Контекст);
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		
			ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПродолжитьВыгрузкуРеглОтчетаЦБНеудача", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьУведомлениеАрхивныхФайлов(ОписаниеОповещения, 24, 2, Истина);			
			
			Возврат;
		КонецЕсли;
		
		Контекст.Вставить("РезультатВыгрузки", Результат);
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
		
	Иначе
		Результат = Новый Массив;
		
		СвойстваФайлаВыгрузки = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ВыгрузитьДокумент(Отчет, Контекст.УникальныйИдентификатор);
		Если НЕ ЗначениеЗаполнено(СвойстваФайлаВыгрузки) Тогда
			РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
			
			Возврат;
			
		КонецЕсли;
		
		// заполняем результат
		Если ТипЗнч(СвойстваФайлаВыгрузки) = Тип("Структура") Тогда
			ОписательОтчета = Новый Структура;
			ОписательОтчета.Вставить("Документ", 	Отчет);
			ОписательОтчета.Вставить("Тип", 		СвойстваФайлаВыгрузки.ТипФайлаВыгрузки);
			ОписательОтчета.Вставить("Имя", 		СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки);
			ОписательОтчета.Вставить("Адрес", 		СвойстваФайлаВыгрузки.АдресФайлаВыгрузки);
			Результат.Добавить(ОписательОтчета);
			
		Иначе
			Для Инд = 0 По СвойстваФайлаВыгрузки.Количество() - 1 Цикл
				ОписательОтчета = Новый Структура;
				ОписательОтчета.Вставить("Документ", 	СвойстваФайлаВыгрузки[Инд].Ссылка);
				ОписательОтчета.Вставить("Тип", 		СвойстваФайлаВыгрузки[Инд].ТипФайлаВыгрузки);
				ОписательОтчета.Вставить("Имя", 		СвойстваФайлаВыгрузки[Инд].ИмяФайлаВыгрузки);
				ОписательОтчета.Вставить("Адрес", 		СвойстваФайлаВыгрузки[Инд].АдресФайлаВыгрузки);
				Результат.Добавить(ОписательОтчета);
			КонецЦикла;
		КонецЕсли;
		
		Контекст.Вставить("РезультатВыгрузки", Результат);
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПродолжитьВыгрузкуРеглОтчетаЦБНеудача(Выбор, ДопПараметры) Экспорт
	
	РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", ДопПараметры.Контекст, Ложь);
	ВыполнитьОбработкуОповещения(ДопПараметры.ВыполняемоеОповещение, РезультатВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПродолжитьВыгрузкуРеглОтчетаЦБЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Контекст = ДополнительныеПараметры.Контекст;
	Отчет = ДополнительныеПараметры.Отчет;
	Результат = ДополнительныеПараметры.Результат;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		РезультатВыгрузки = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузки);
	Иначе
		ВыгрузитьРегламентированныйОтчетЦБПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРегламентированныйОтчетЦБПродолжение(Контекст, Отчет, Результат, ВыполняемоеОповещение)
	
	ТекстВыгрузки 			= "";
	ИмяФайлаВыгрузки 		= "";
	КодировкаФайлаВыгрузки 	= Неопределено;
	ТипФайлаВыгрузки 		= "";
	ЭлементыВыгрузки 		= Неопределено;
	РезультатВыгрузки = СдачаОтчетностиЧерезСервисСпецоператораКлиент.ВыгрузитьРегламентированныйОтчет(
		Отчет,
		Ложь,
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		КодировкаФайлаВыгрузки,
		ТипФайлаВыгрузки,
		ЭлементыВыгрузки,
		Контекст.УникальныйИдентификатор);
	
	Если НЕ РезультатВыгрузки Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = '%1Отправка отчета прервана.';
				|en = '%1Отправка отчета прервана.'"),
			ИнформацияОбОшибке().Описание + Символы.ПС);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		РезультатВыгрузкиОтчета = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Ложь);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузкиОтчета);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстВыгрузки) И ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") И ИмяФайлаВыгрузки.Количество() = 1
		И ТипЗнч(ЭлементыВыгрузки) = Тип("Массив") И ЭлементыВыгрузки.Количество() > 0 И ТипЗнч(ЭлементыВыгрузки[0]) = Тип("Структура") Тогда
		
		АдресВоВременномХранилище = ЭлементыВыгрузки[0].АдресФайлаВыгрузки;
		
		ОписательОтчета = Новый Структура;
		ОписательОтчета.Вставить("Документ", 	Отчет);
		ОписательОтчета.Вставить("Тип", 		ЭлементыВыгрузки[0].ТипФайлаВыгрузки);
		ОписательОтчета.Вставить("Имя", 		ИмяФайлаВыгрузки[0]);
		ОписательОтчета.Вставить("Адрес", 		АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
		
	Иначе
		// пишем файл во временное хранилище
		КодировкаФайла = КодировкаФайлаВыгрузки;
		АдресВоВременномХранилище = ЗаписатьФайлВыгрузкиВоВременноеХранилище(
			ТекстВыгрузки,
			ИмяФайлаВыгрузки,
			КодировкаФайла,
			Контекст.УникальныйИдентификатор,
			Истина);
		
		// заполняем результат
		ОписательОтчета = Новый Структура;
		ОписательОтчета.Вставить("Документ", 	Отчет);
		ОписательОтчета.Вставить("Тип", 		"");
		ОписательОтчета.Вставить("Имя", 		ИмяФайлаВыгрузки);
		ОписательОтчета.Вставить("Адрес", 		АдресВоВременномХранилище);
		Результат.Добавить(ОписательОтчета);
	КонецЕсли;
	
	Контекст.Вставить("РезультатВыгрузки", Результат);
	РезультатВыгрузкиОтчета = Новый Структура("Контекст, РезультатВыгрузки", Контекст, Истина);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыгрузкиОтчета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВЦБ_ПередВыгрузкойФайла(Контекст, Знач Документ, Знач УникальныйИдентификатор)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ТекстСообщения = "";
	Результат = КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВЦБ_ПередВыгрузкойФайла(Контекст, Документ, УникальныйИдентификатор, ТекстСообщения);
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВЦБ_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВЦБ_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст);
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьРегламентированныйОтчетЦБИзВнешнихЭлектронныхПредставлений(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ВыгрузитьРегламентированныйОтчетЦБИзВнешнихЭлектронныхПредставлений(Контекст);
	
КонецФункции

#КонецОбласти

#Область СформироватьПакетЦБ
 
&НаКлиенте
Процедура СформироватьПакетЦБ(
		ОповещениеОЗавершении,
		ТранспортноеСообщение,
		Оповещать = Ложь,
		ПараметрыОперации = Неопределено) Экспорт
	
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Оповещать);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;
	
	// общие проверки
	Если НЕ СформироватьПакетЦБ_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда // сервер
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// получение и проверки сертификатов
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетЦБПослеПроверкиИПолученияСертификатовПолучателя", ЭтотОбъект, Контекст);
	
	СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателя(Оповещение, КонтекстОтправки); // клиент
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетЦБПослеПроверкиИПолученияСертификатовПолучателя(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Результат Тогда
		Если НЕ СформироватьПакетЦБ_ПроверкиНаСервере(КонтекстОтправки) Тогда // универсальная
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		// проверки на клиенте (сертификаты)
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетЦБПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
			
		СформироватьПакетЦБ_ПроверкиСертификатов(Оповещение, КонтекстОтправки);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетЦБПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	// подписываем ЭЦП руководителя и главного бухгалтера
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетЦБПослеПодписания", ЭтотОбъект, Контекст);
	СформироватьПакетЦБ_Подписание(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетЦБПослеПодписания(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// формируем дерево описания документов пакета (сервер)
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется формирование описания пакета с документами..."); // ЦБ Универсальная
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетЦБ_СформироватьДеревоОписанияДокументовПакета(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	РежимПодтвержденияОблачнойПодписи("СформироватьПакетЦБ", КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки, Ложь);
	
	// отрабатываем отложенные команды на клиенте (шифрование)
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетЦБПослеВыполненияОтложенныхКомандНаКлиенте", ЭтотОбъект, ВходящийКонтекст);
	СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетЦБПослеВыполненияОтложенныхКомандНаКлиенте(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// формируем файл описания пакета, создаем архив и помещаем в ИБ
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетЦБ_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.Оповещать Тогда
		Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
														КонтекстОтправки.ТранспортноеСообщение,
														КонтекстОтправки.ЦиклОбмена));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПакетЦБ_ОбщиеПроверкиПередФормированием(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПакетЦБ_ОбщиеПроверкиПередФормированием(Контекст);
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателя(ОповещениеОЗавершении, КонтекстОтправки)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись);
	
	Если ТипЗнч(КонтекстОтправки.СертификатПолучателя) <> Тип("Массив") Тогда
		Отпечатки = Новый Массив;
		Отпечатки.Добавить(КонтекстОтправки.СертификатПолучателя);
	Иначе
		Отпечатки = КонтекстОтправки.СертификатПолучателя;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстОтправки.СертификатСервераДокументооборота)
		И Отпечатки.Найти(КонтекстОтправки.СертификатСервераДокументооборота) = Неопределено Тогда
		
		Отпечатки = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(Отпечатки);
		Отпечатки.Добавить(КонтекстОтправки.СертификатСервераДокументооборота);
	КонецЕсли;
	
	СертификатыДляПоиска = Новый Массив;
	Для каждого Отпечаток Из Отпечатки Цикл
		НовыйСертификат = Новый Структура("Отпечаток", Отпечаток);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЦикла;
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("Отпечатки", Отпечатки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов", ЭтотОбъект, Контекст);
		
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах = Неопределено)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах);
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	НайденныеСертификаты 				= ?(Результат.Свойство("Сертификаты"), Результат.Сертификаты, Неопределено);
	НенайденныеСертификаты 				= ?(Результат.Свойство("НенайденныеСертификаты"), Результат.НенайденныеСертификаты, Неопределено);
	СсылкаПолучатель 					= ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель;
	СертификатПолучателя 				= ВходящийКонтекст.КонтекстОтправки.СертификатПолучателя;
	СертификатСервераДокументооборота 	= ВходящийКонтекст.КонтекстОтправки.СертификатСервераДокументооборота;
	СсылкаСерверДокументооборота 		= ВходящийКонтекст.КонтекстОтправки.СсылкаСерверДокументооборота;
	
	ИнформацияОПолучателяхИСертификатах = Новый Структура;
	ИнформацияОПолучателяхИСертификатах.Вставить("СертификатСервераДокументооборота", 	СертификатСервераДокументооборота);
	ИнформацияОПолучателяхИСертификатах.Вставить("СсылкаСерверДокументооборота", 		СсылкаСерверДокументооборота);
	ИнформацияОПолучателяхИСертификатах.Вставить("СертификатПолучателя", 				СертификатПолучателя);
	РезультатПроверки = СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Результат.Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах);
	Если РезультатПроверки = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить(
		"ОбъектСертификатПолучателя", РезультатПроверки.НайденныеСертификатыПолучателя);
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить(
		"ОбъектСертификатСервераДокументооборота", РезультатПроверки.НайденныйСертификатСервераДокументооборота);
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

