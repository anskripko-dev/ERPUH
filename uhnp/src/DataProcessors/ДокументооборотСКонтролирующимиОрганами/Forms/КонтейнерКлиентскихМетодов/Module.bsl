&НаСервереБезКонтекста
Функция ДанныеТребованияСФР(Требование)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Требование, "Организация, ИдентификаторСообщения");
	
КонецФункции
	
&НаКлиенте
Процедура СоздатьРезультатПриемаВходящейОписиИнтерактивноПоДокументуОписи(
		ДокументОписи, 
		ПоложительныйРезультат, 
		ДействиеПослеПодтвержденияПриема, 
		ТихийРежим = Ложь) Экспорт
		
	Если ТипЗнч(ДокументОписи) = Тип("ДокументСсылка.ВходящийДокументСЭДОФСС") Тогда
		Данные = ДанныеТребованияСФР(ДокументОписи);
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Требование", 			ДокументОписи);
		ДополнительныеПараметры.Вставить("ДействиеПослеПодтвержденияПриема", ДействиеПослеПодтвержденияПриема);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СоздатьРезультатПриемаВходящейОписиИнтерактивно_ПослеПодтвержденияСЭДО", ЭтотОбъект, ДополнительныеПараметры);
		ЭлектронныйДокументооборотСФССКлиент.ОтправитьПодтверждениеОПолученииСообщенийСЭДО(
			ОписаниеОповещения, Данные.Организация, Данные.ИдентификаторСообщения, Ложь);
		Возврат;
	КонецЕсли;
			
	//Определяем ссылку на опись входящих сообщений
	ОписьВходящихДокументов = ДокументооборотСКОВызовСервера.ПолучитьОписьВходящихДокументовПоТребованию(ДокументОписи);
	
	//Проверяем наличие уже созданного результата приема
	РезультатПриема  = ПолучитьРезультатПриемаВходящейОписи(ОписьВходящихДокументов);
	НужноПересоздать = НужноСформироватьСвежуюКвитанциюОПриеме(РезультатПриема);
	
	Если РезультатПриема = Неопределено ИЛИ НужноПересоздать Тогда
		//Результат приема еще не создавали
		
		//Подготовим описание оповещения для последующего диалога
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОписьВходящихДокументов", 			ОписьВходящихДокументов);
		ДополнительныеПараметры.Вставить("ПоложительныйРезультат", 				ПоложительныйРезультат);
		ДополнительныеПараметры.Вставить("ДействиеПослеПодтвержденияПриема", 	ДействиеПослеПодтвержденияПриема);
		ДополнительныеПараметры.Вставить("НужноПересоздать", 					НужноПересоздать);
		ДополнительныеПараметры.Вставить("ТихийРежим", 							ТихийРежим);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьРезультатПриемаВходящейОписиИнтерактивно_ПослеПодтверждения", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ТихийРежим Тогда
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
			
		Иначе
		
			//Определяем количество требований в описи входящих сообщений
			КоличествоДокументов = ПолучитьКоличествоДокументовПоОписиВходящихДокументов(ОписьВходящихДокументов);
			МассивТребований = ТребованияФНСВызовСервера.ТребованияВОписи(ОписьВходящихДокументов);
			Если КоличествоДокументов < 2 Тогда
				//Задаем вопрос, ответ передаем в СоздатьРезультатПриемаВходящейОписиИнтерактивно_ПослеПодтверждения
				Если ПоложительныйРезультат Тогда
					ТекстВопроса = "Подтвердить прием """ + ДокументОписи + """ (подтверждение будет отправлено в ФНС)?";
		            ТекстКнопки = "Подтвердить прием";
				Иначе
					ТекстВопроса = "Отказать в приеме """ + ДокументОписи + """ (отказ будет отправлен в ФНС)?";	
					ТекстКнопки = "Отказать в приеме";
				КонецЕсли;
				
				СписокКнопок = Новый СписокЗначений;
				СписокКнопок.Добавить(КодВозвратаДиалога.Да, ТекстКнопки);
				СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
				
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Да);
			Иначе
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ОписьВходящихДокументов", ОписьВходящихДокументов);
				ПараметрыФормы.Вставить("ПоложительныйРезультатПриема", ПоложительныйРезультат);
				
				ОткрытьФорму("Справочник.ДокументыРеализацииПолномочийНалоговыхОрганов.Форма.ФормаОтправкиРезультатаПриема", ПараметрыФормы, , , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		//Результат приема уже создавали
		//Откроем его
		Статус = ПолучитьРеквизит(РезультатПриема, "Статус");
		Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыПисем.Отправленное") Тогда
			
			Если ТихийРежим Тогда
				//Результат приема уже создавали
				ВыполнитьОбработкуОповещения(ДействиеПослеПодтвержденияПриема, Истина);
			Иначе
				ПоказатьЗначение(, РезультатПриема);
			КонецЕсли;
		Иначе
			
			ДополнительныеПараметры = Новый Структура("ДействиеПослеПодтвержденияПриема", ДействиеПослеПодтвержденияПриема);
			
			СоздатьРезультатПриемаВходящейОписиИнтерактивно_СформироватьПакетФНС(
				РезультатПриема, 
				ДополнительныеПараметры);
					
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НужноСформироватьСвежуюКвитанциюОПриеме(ТранспортноеСообщение)
	
	Если НЕ ЗначениеЗаполнено(ТранспортноеСообщение)
		ИЛИ НЕ ЗначениеЗаполнено(ТранспортноеСообщение.ЦиклОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ТранспортноеСообщение.ЦиклОбмена.Предмет) <> Тип("СправочникСсылка.ОписиВходящихДокументовИзНалоговыхОрганов") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяКвитанции = ИмяВложенияТранспортногоСообщения(
		ТранспортноеСообщение, 
		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент);
		
	Если ИмяКвитанции = "" Тогда
		Возврат Истина;
	КонецЕсли;

	ЧастиИмени    = СтрРазделить(ИмяКвитанции, "_");
	ДатаСтрокой   = ЧастиИмени[5];
	ДатаКвитанции = ОбщегоНазначенияКлиентСервер.СтрокаВДату(ДатаСтрокой);
	
	НужноСформироватьСвежую = НачалоДня(ДатаКвитанции) <> НачалоДня(ТекущаяДатаСеанса());
	
	Возврат НужноСформироватьСвежую;

КонецФункции

&НаСервереБезКонтекста
Функция УдалитьВложенияРезультатаПриема(ТранспортноеСообщение)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ИмяКвитанции = ИмяВложенияТранспортногоСообщения(
		ТранспортноеСообщение, 
		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент);
		
	Если ИмяКвитанции <> "" Тогда
		КонтекстЭДОСервер.УдалитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, ИмяКвитанции);;
	КонецЕсли;

	// Удаляем подпись
	ИмяПодписи = ИмяВложенияТранспортногоСообщения(
		ТранспортноеСообщение, 
		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
		
	Если ИмяПодписи <> "" Тогда	
		КонтекстЭДОСервер.УдалитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, ИмяПодписи);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СоздатьРезультатПриемаВходящейОписиИнтерактивно_ПослеПодтверждения(РезультатВопроса, ВходящийКонтекст) Экспорт
	 
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		//Было выбрано создать результат приема
		
		ПоложительныйРезультат = ВходящийКонтекст.ПоложительныйРезультат;
		ОписьВходящихДокументов = ВходящийКонтекст.ОписьВходящихДокументов;
		
	    ДокументНО = ПолучитьСообщениеДокументНОПоОписиВходящихДокументов(ОписьВходящихДокументов);
		Если ДокументНО <> Неопределено Тогда
			
			ВходящийКонтекст.Вставить("ЭтоОтправкаПодтвержденияИзПанелиОтправки", Истина);
			//создаем и подписываем сообщение
			Оповещение = Новый ОписаниеОповещения(
				"СоздатьРезультатПриемаВходящейОписиИнтерактивно_СформироватьПакетФНС", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			СоздатьРезультатПриемаНаКлиентеСУчетомВопроса(
				Оповещение, 
				ДокументНО, 
				ПоложительныйРезультат, 
				ВходящийКонтекст.ТихийРежим,
				,
				ВходящийКонтекст.НужноПересоздать);
				
		КонецЕсли;
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРезультатПриемаВходящейОписиИнтерактивно_СформироватьПакетФНС(РезультатПриема, ВходящийКонтекст) Экспорт
	
	ВозниклаОшибка = 
		РезультатПриема = Неопределено 
		ИЛИ РезультатПриема = Ложь 
		ИЛИ ТипЗнч(РезультатПриема) = Тип("Структура");
		
	Если ВозниклаОшибка Тогда
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ДействиеПослеПодтвержденияПриема, РезультатПриема);
		
	Иначе
		
		ВходящийКонтекст.Вставить("РезультатПриема", РезультатПриема);
		Оповещение = Новый ОписаниеОповещения(
			"СоздатьРезультатПриемаВходящейОписиИнтерактивноПоДокументуОписиЗавершениеПослеФормированияПакетаФНС", ЭтотОбъект, ВходящийКонтекст);
		СформироватьПакетФНС(Оповещение, РезультатПриема);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРезультатПриемаВходящейОписиИнтерактивноПоДокументуОписиЗавершениеПослеФормированияПакетаФНС(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Ложь Тогда
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ДействиеПослеПодтвержденияПриема, Ложь);
	Иначе
		
		//отправляем сообщение
		РезультатОтправки = ОтправитьТранспортноеСообщение(ВходящийКонтекст.РезультатПриема);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ДействиеПослеПодтвержденияПриема, РезультатОтправки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СохранитьДатуПодтвержденияТребованияСФР(Требование)
	
	ТребованиеОбъект = Требование.ПолучитьОбъект();
	ТребованиеОбъект.ДатаОтправкиПодтверждения = ТекущаяДатаНаСервере();
	ТребованиеОбъект.Записать();
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура СоздатьРезультатПриемаВходящейОписиИнтерактивно_ПослеПодтвержденияСЭДО(Результат, ДополнительныеПараметры) Экспорт
	
	ДействиеПослеПодтвержденияПриема = ДополнительныеПараметры.ДействиеПослеПодтвержденияПриема;
	Если Результат.Выполнено Тогда
		СохранитьДатуПодтвержденияТребованияСФР(ДополнительныеПараметры.Требование);
		ВыполнитьОбработкуОповещения(ДействиеПослеПодтвержденияПриема, Истина);
	Иначе
		ВыполнитьОбработкуОповещения(ДействиеПослеПодтвержденияПриема, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСообщениеДокументНОПоОписиВходящихДокументов(ОписьВходящихДокументов)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// Получим список сообщений
	ПоследнийЦиклОбмена 		= ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(ОписьВходящихДокументов);
	СообщениеДокументНО			= КонтекстЭДОСервер.ПолучитьСообщениеЦиклаОбмена(ПоследнийЦиклОбмена, Перечисления.ТипыТранспортныхСообщений.ДокументНО);
	Если СообщениеДокументНО 	= Документы.ТранспортноеСообщение.ПустаяСсылка() Тогда
		Возврат Неопределено;
	Иначе
		Возврат СообщениеДокументНО;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура НажатиеНаКнопкуПоказатьОтветыПоТребованию(ТребованиеСсылка, ВключаяНевозможностьПредоставленияДокументов = Истина) Экспорт
	
	Если ТипЗнч(ТребованиеСсылка) = Тип("ДокументСсылка.ВходящийДокументСЭДОФСС") Тогда
		
		ОтветыНаТребованиеСФР = ОтветыНаТребованиеФСС(ТребованиеСсылка);
		КоличествоОтветов = ОтветыНаТребованиеСФР.Количество();
		
		Если КоличествоОтветов = 0 Тогда
			
			ТекстСообщения = НСтр("ru = 'Ответы на требование СФР отсутствуют';
									|en = 'Ответы на требование СФР отсутствуют'");
			ПоказатьПредупреждение(, ТекстСообщения);
			Возврат;
			
		КонецЕсли;
		
		Если КоличествоОтветов > 1 Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("Основание", ТребованиеСсылка);
			
			ОткрытьФорму(
				"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ОтветыНаТребованияФСС",
				ДополнительныеПараметры,,
				Новый УникальныйИдентификатор);
			
		Иначе
			
			ПоказатьЗначение(, ОтветыНаТребованиеСФР[0]);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТребованиеСсылка) = Тип("ДокументСсылка.ОбращениеСФРКСтрахователю") Тогда
		
		Ответы = ОтветыНаОбращениеСФРКСтрахователю(ТребованиеСсылка);
		Если Ответы.Количество() = 0 Тогда
			
			СфомироватьОтветНаОбращениеСФРКСтрахователю(ТребованиеСсылка);
			
		Иначе
			
			ПоказатьОтветыНаОбращениеСФРКСтрахователю(ТребованиеСсылка);
			
		КонецЕсли;
		
	Иначе
		МассивОтветов = ОтветыНаТребование(ТребованиеСсылка, ВключаяНевозможностьПредоставленияДокументов);
		
		Если МассивОтветов.Количество() = 0 Тогда
			
			// Создание ответа
			СоздатьОтветНаТребованиеФНС(ТребованиеСсылка);
			
		Иначе
			
			ПоказатьОтветыНаТребованияФНС(МассивОтветов);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НажатиеНаКнопкуПоказатьОтветыПоТребованиюФСС(ТребованиеСсылка) Экспорт
	
	МассивОтветов = ОтветыНаТребованиеФСС(ТребованиеСсылка);
	
	Если МассивОтветов.Количество() > 0 Тогда
	
		ПоказатьОтветыНаТребованияФСС(МассивОтветов);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНеотправленныеИзвещенияОПриеме(ОтчетСсылка, Организация, КонтролирующийОрган, ВыполняемоеОповещение) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолучатьОшибкиОтправки", Истина);
	
	НеотправленныеИзвещения = ТекущееСостояниеОтправки(ОтчетСсылка, КонтролирующийОрган, ДополнительныеПараметры).НеотправленныеИзвещения;

	Контекст = Новый Структура;
	Контекст.Вставить("ОтчетСсылка", ОтчетСсылка);
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("КонтролирующийОрган", КонтролирующийОрган);
	Контекст.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	Оповещение = Новый ОписаниеОповещения(
		"СоздатьПодтверждениеПриНеобходимостиПослеВыполнения", ЭтотОбъект, Контекст);
		
	// Если есть сообщения, не имеющие подтверждения, то создаем соотвествующие подтверждения
	Если НеотправленныеИзвещения.МассивСообщенийНеИмеющихПодтверждений.Количество() > 0 Тогда
		
		Контекст = Новый Структура;
		Контекст.Вставить("МассивСообщенийНеИмеющихПодтверждений", НеотправленныеИзвещения.МассивСообщенийНеИмеющихПодтверждений);
		Контекст.Вставить("ОповещениеОЗавершении", 	Оповещение);
		Контекст.Вставить("ТекущееСообщение", 		0);
		Контекст.Вставить("ЭтоОтправкаПодтвержденияИзПанелиОтправки", Истина);
		
		СоздатьПодтверждениеПриНеобходимостиПоследовательно(Контекст);
		Возврат;
	КонецЕсли;
	
	СоздатьПодтверждениеПриНеобходимостиПослеВыполнения(Истина, Контекст);	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждениеПриНеобходимостиПоследовательно(ВходящийКонтекст)
	
	Если ВходящийКонтекст.ТекущееСообщение < ВходящийКонтекст.МассивСообщенийНеИмеющихПодтверждений.Количество() Тогда
		
		Оповещение = Новый ОписаниеОповещения(
			"СоздатьПодтверждениеПриНеобходимостиПоследовательноПослеВыполнения", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		Сообщение = ВходящийКонтекст.МассивСообщенийНеИмеющихПодтверждений[ВходящийКонтекст.ТекущееСообщение];
		
		СоздатьПодтверждениеПриНеобходимости(Оповещение, Сообщение, Истина);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждениеПриНеобходимостиПоследовательноПослеВыполнения(Результат, ВходящийКонтекст) Экспорт
	
	ВходящийКонтекст.ТекущееСообщение = ВходящийКонтекст.ТекущееСообщение + 1;
	СоздатьПодтверждениеПриНеобходимостиПоследовательно(ВходящийКонтекст);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждениеПриНеобходимостиПослеВыполнения(Результат, ВходящийКонтекст) Экспорт
	
	// Теперь у нас должны остаться только неотправленные сообщения
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолучатьОшибкиОтправки", Истина);
	
	НеотправленныеИзвещения = ТекущееСостояниеОтправки(ВходящийКонтекст.ОтчетСсылка, ВходящийКонтекст.КонтролирующийОрган, ДополнительныеПараметры).НеотправленныеИзвещения;
	МассивНеотправленныхПодтверждений = НеотправленныеИзвещения.МассивНеотправленныхПодтверждений;

	Если МассивНеотправленныхПодтверждений.Количество() > 0 Тогда
		
		УчетнаяЗапись = УчетнаяЗаписьОрганизации(ВходящийКонтекст.Организация); 
		ДополнительныеПараметры = Новый Структура("МассивНеотправленныхПодтверждений, ВыполняемоеОповещение, УчетнаяЗапись, Организация", 
			МассивНеотправленныхПодтверждений, ВходящийКонтекст.ВыполняемоеОповещение, УчетнаяЗапись, ВходящийКонтекст.Организация);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьНеотправленныеИзвещенияОПриемеПослеАвтонастройкиУчетнойЗаписи", ЭтотОбъект, ДополнительныеПараметры);
		АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗапись, ВходящийКонтекст.Организация, ОписаниеОповещения);
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНеотправленныеИзвещенияОПриемеПослеАвтонастройкиУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	МассивНеотправленныхПодтверждений = ДополнительныеПараметры.МассивНеотправленныхПодтверждений;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;

	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Оповещение = Новый ОписаниеОповещения(
		"ОтправитьНеотправленныеИзвещенияОПриемеПослеОтправки", ЭтотОбъект, Контекст);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", Оповещение);
	Контекст.Вставить("КоличествоОтправленных", 0);
	Контекст.Вставить("КоличествоНеОтправленных", 0);
	Контекст.Вставить("МассивНеотправленныхПодтверждений", МассивНеотправленныхПодтверждений);
	Контекст.Вставить("ТекущееПодтверждение", 0);
	
	ОтправитьНеотправленныеИзвещенияПоследовательно(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНеотправленныеИзвещенияПоследовательно(ВходящийКонтекст)
	
	Если ВходящийКонтекст.ТекущееПодтверждение < ВходящийКонтекст.МассивНеотправленныхПодтверждений.Количество() Тогда
		Сообщение = ВходящийКонтекст.МассивНеотправленныхПодтверждений[ВходящийКонтекст.ТекущееПодтверждение];
		
		// формируем пакет, если не сформирован
		Если НЕ СообщениеЗашифровано(Сообщение) Тогда
			Оповещение = Новый ОписаниеОповещения(
				"ОтправитьНеотправленныеИзвещенияПоследовательноПослеВыполнения", ЭтотОбъект, ВходящийКонтекст);
			СформироватьПакет(Оповещение, Сообщение, Истина);
			Возврат;
		КонецЕсли;
		ОтправитьНеотправленныеИзвещенияПоследовательноПослеВыполнения(Истина, ВходящийКонтекст);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);	
	КонецЕсли;
	
