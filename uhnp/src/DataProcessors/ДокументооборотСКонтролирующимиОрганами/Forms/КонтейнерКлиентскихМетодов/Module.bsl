&НаСервереБезКонтекста
Функция ОтправитьЗапросСервисуСЭДОФССНаСервере(
		ЗНАЧ Организация,
		ЗНАЧ Операция,
		ЗНАЧ АдресЗашифрованногоЗапросаSOAP,
		ЗНАЧ ОбменПоСЭДОНапрямую = Неопределено)
		
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ОтправитьЗапросСервисуСЭДОФСС(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP,
		ОбменПоСЭДОНапрямую);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеНеобязательногоСвойства(Данные,
		ИмяСвойства,
		ПривестиКТипу = "",
		ЗначениеПоУмолчанию = Неопределено)
	
	Если ЕстьСвойство(Данные, ИмяСвойства) Тогда
		Если НЕ ПустаяСтрока(ПривестиКТипу) Тогда
			Возврат XMLЗначение(Тип(ПривестиКТипу), Данные[ИмяСвойства]);
		Иначе
			Возврат Данные[ИмяСвойства];
		КонецЕсли;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьСвойство(Данные, Имя) Экспорт
	
	Если НЕ ТипЗнч(Данные) = Тип("ОбъектXDTO") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НЕ Данные.Свойства().Получить(Имя) = Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеВКоллекцию(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Массив")
		И ТипЗнч(Значение) <> Тип("ТаблицаЗначений")
		И ТипЗнч(Значение) <> Тип("СписокXDTO") Тогда
		
		Коллекция = Новый Массив;
		Коллекция.Добавить(Значение);
		Возврат Коллекция;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
