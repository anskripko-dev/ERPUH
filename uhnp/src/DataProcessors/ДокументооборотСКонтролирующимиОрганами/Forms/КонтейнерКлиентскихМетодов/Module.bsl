	ПредупредитьОПереходеВКоробкуИОбратно(ОписаниеОповещения);
	
КонецПроцедуры

#Область ПредупреждениеОПереходе

&НаКлиенте
Процедура ПредупредитьОПереходеВКоробкуИОбратно(ВыполняемоеОповещение)
	
	РезультатПроверки = РезультатПроверкиНеобходимостиПредупрежденияОПереходе();
	
	Если РезультатПроверки.НеобходимоПредупредить Тогда
		
		ОткрытьФорму(
			РезультатПроверки.ИмяФормыПредупреждения,
			РезультатПроверки,
			,
			,
			,
			,
			ВыполняемоеОповещение);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РезультатПроверкиНеобходимостиПредупрежденияОПереходе()
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ИсправитьРегистрационныеНомераМЧДФНС502();
	
	КонтекстЭДОСервер  			= ДокументооборотСКО.ПолучитьОбработкуЭДО();
	БылВыполненПереход 			= КонтекстЭДОСервер.БылВыполненПререходВДругуюМодельХраненияКлючей();
	ЕстьАктивныеУчетныеЗаписи 	= КонтекстЭДОСервер.ЭлектронныйДокументооборотИспользуется();
	
	Если НЕ БылВыполненПереход ИЛИ НЕ ЕстьАктивныеУчетныеЗаписи Тогда
		Возврат Новый Структура("НеобходимоПредупредить", Ложь);
	КонецЕсли;
	
	ТекущаяМодель 			= КонтекстЭДОСервер.ТекущаяМодельРаботыСКлючами();
	ТолькоЛокальныеКлючи 	= Перечисления.МодельРаботыСКлючами.ТолькоЛокальныеКлючи; 
	ЭтоПереходВКоробку 		= ТекущаяМодель = ТолькоЛокальныеКлючи;
	
	ИмяФормыПредупреждения 	= ПутьКОбъекту + ".Форма.ПредупреждениеОПереходе";
	
	ТаблицаУчетныхЗаписей  = КонтекстЭДОСервер.ТаблицаОрганизацийТребующихНапоминанияОПереходе();
	АдресТаблицы 		   = ПоместитьВоВременноеХранилище(ТаблицаУчетныхЗаписей, Новый УникальныйИдентификатор);
	
	НеобходимоПредупредить = ТаблицаУчетныхЗаписей.Количество() > 0;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НеобходимоПредупредить", 	НеобходимоПредупредить);
	ДополнительныеПараметры.Вставить("ИмяФормыПредупреждения", 	ИмяФормыПредупреждения);
	ДополнительныеПараметры.Вставить("ЭтоПереходВКоробку", 		ЭтоПереходВКоробку);
	ДополнительныеПараметры.Вставить("АдресТаблицы", 			АдресТаблицы);
	 
	Возврат ДополнительныеПараметры;
	
КонецФункции

#КонецОбласти

#Область ПредупредитьОбОшибкахРасшифровкиЭДОК

&НаКлиенте
Процедура ПредупредитьОбОшибкахРасшифровкиЭДОК(Результат, ВходящийКонтекст) Экспорт
	
	// После предупреждения об ошибках расшифровки ЭДОК показываем предупреждение об УЦ АО "Калуга-Астрал"
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПредупредитьОбУЦКалугаАстралКлиент",
		ЭтотОбъект);
	
	АдресОтчетов = АдресОтчетовЭДОКСОшибкамиРасшифровки();
	
	Если АдресОтчетов <> Неопределено Тогда
		ПараметрыОткрытияФормы = Новый Структура("АдресОтчетов", АдресОтчетов);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ПредупреждениеОбОшибкеРасшифровкиЭДОК",
			ПараметрыОткрытияФормы,,,,,
			ОписаниеОповещения);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АдресОтчетовЭДОКСОшибкамиРасшифровки() Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.АдресОтчетовЭДОКСОшибкамиРасшифровки();
	
КонецФункции

#КонецОбласти

#Область ПредупредитьОбУЦКалугаАстрал

&НаКлиенте
Процедура ПредупредитьОбУЦКалугаАстралКлиент(Результат, ВходящийКонтекст) Экспорт
	
	// После предупреждения об УЦ "Калуга Астрал" можем показать предупреждение о сертификатах-лицензиях-реквизитах
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ПредупредитьОГОСТ34122018ДляФНС",
		ЭтотОбъект);
	
	Если НЕ НапомнитьПроУЦКалугаАстрал() Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения("ПредупредитьОбУЦКалугаАстралПослеПолученияСертификатов",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ХранилищаСертификатов = Новый Массив;
	ХранилищаСертификатов.Добавить(Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "MY", Истина));
	ХранилищаСертификатов.Добавить(Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "MY", Ложь));
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(Оповещение, ХранилищаСертификатов, ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаСервере
Функция НапомнитьПроУЦКалугаАстрал() Экспорт
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	ДатаКогдаНапомнить = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_УЦКалугаАстрал");
	
	Если ДатаКогдаНапомнить = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОтложеноНаНикогда = ДатаКогдаНапомнить = '00010101000000';
	
	Возврат ДатаСеанса >= ДатаКогдаНапомнить И НЕ ОтложеноНаНикогда;
	
КонецФункции

&НаКлиенте
Процедура ПредупредитьОбУЦКалугаАстралПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("ПолучитьСертификатыРезультат", Результат);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
		Возврат;
	КонецЕсли;

	Организации = ОрганизацииИспользующиеСертификатУЦКалугаАстрал(Результат.Сертификаты);
	Количество  = Организации.Количество();

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организации", Организации);
	
	Если Количество = 0 Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("ПолучитьСертификатыРезультат", Результат);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Если РегламентированнаяОтчетностьВызовСервера.ИспользуетсяОднаОрганизация() Тогда
		
		Организация = ДополнительныеПараметры.Организации[0].Организация;
		
		КонтекстОткрытияЗаявления = Новый Структура;
		КонтекстОткрытияЗаявления.Вставить("Организация", 			Организация);
		КонтекстОткрытияЗаявления.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПредупредитьОбУЦКалугаАстралПослеПолученияСертификатов_ОткрытьЗаявление",
			ЭтотОбъект,
			КонтекстОткрытияЗаявления);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ОтправьтеЗаявлениеУЦКалугаАстралПоОрганизации",
			ДополнительныеПараметры,,,,,
			ОписаниеОповещения);
		
	Иначе
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ОтправьтеЗаявлениеУЦКалугаАстралПоОрганизациям",
			ДополнительныеПараметры,,,,,
			ВходящийКонтекст.ОповещениеОЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбУЦКалугаАстралПослеПолученияСертификатов_ОткрытьЗаявление(
		Результат,
		ВходящийКонтекст) Экспорт
	
	Если Результат = НСтр("ru = 'ПодготовитьЗаявление';
							|en = 'ПодготовитьЗаявление'") Тогда
		
		ОткрытьНовоеЗаявлениеУЦКалугаАстрал(
			Неопределено,
			ВходящийКонтекст.Организация,
			ВходящийКонтекст.ОповещениеОЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОрганизацииИспользующиеСертификатУЦКалугаАстрал(ВсеСертификаты) Экспорт
	
	ТекДата = ТекущаяДатаСеанса();
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ОтпечаткиУчеткиОрганизации = КонтекстЭДОСервер.ДанныеУчетныхЗаписейПользователяСОрганизациями(Ложь);
	ОтпечаткиОрганизаций = ОтпечаткиОрганизаций(ОтпечаткиУчеткиОрганизации);
	
	Организации = Новый Массив;
	УЦКалугаАстралАккредитован = Неопределено;
	Для каждого Сертификат Из ВсеСертификаты Цикл
		
		ОтпечатокУчеткаОрганизация = ОтпечаткиУчеткиОрганизации.Найти(Сертификат.Отпечаток);
		Если ОтпечатокУчеткаОрганизация = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ КонтекстЭДОСервер.СертификатНедействителен(Сертификат.Поставщик, Сертификат.ДействителенС,
			УЦКалугаАстралАккредитован) Тогда
			Продолжить;
		КонецЕсли;
		
		// было ли отправлено заявление течение 10 последних дней
		БылоСоздано = КонтекстЭДОСервер.ЗаявлениеАбонентаДляЗаменыСертификатаБылоСоздано(Сертификат.Отпечаток, ТекДата);
		Если БылоСоздано Тогда
			Продолжить;
		КонецЕсли;
		
		Организация = ОтпечатокУчеткаОрганизация.Организация;
		
		Результат = Новый Структура();
		Результат.Вставить("Организация", Организация);
		Результат.Вставить("Отпечаток",   Сертификат.Отпечаток);
		
		Организации.Добавить(Результат);
		
	КонецЦикла;
	
	Возврат Организации;
	
КонецФункции

&НаКлиенте
Процедура ОтложитьПоказПредупрежденияУЦКалугаАстрал(Форма) Экспорт
	
	СохранитьДатуНапоминанияУЦКалугаАстрал(Форма.НапомнитьЧерез);
	
	Если Форма.НапомнитьЧерез = "-1" Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтложитьПоказПредупрежденияУЦКалугаАстрал_Завершение", 
			ЭтотОбъект,
			Форма);
			
		Текст = НСтр("ru = 'Вы всегда можете отправить заявление на переиздание сертификата из раздела ""Настройки"" формы ""1С-Отчетность"".';
					|en = 'Вы всегда можете отправить заявление на переиздание сертификата из раздела ""Настройки"" формы ""1С-Отчетность"".'");
		ПоказатьПредупреждение(ОписаниеОповещения, Текст);
		
	Иначе
		Форма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДатуНапоминанияУЦКалугаАстрал(НапомнитьЧерез) 
	
	// Определяем, когда в следующий раз нужно напоминать пользователю
	ДатаНапоминания = НачалоДня(ТекущаяДатаСеанса());
	Если НапомнитьЧерез = "1" Тогда
		ДатаНапоминания = ДатаНапоминания + 24 * 60 * 60 * 7;
	ИначеЕсли НапомнитьЧерез = "2" Тогда
		ДатаНапоминания = ДобавитьМесяц(ДатаНапоминания, 1);
	ИначеЕсли НапомнитьЧерез = "-1" Тогда
		ДатаНапоминания = '00010101000000';
	Иначе
		ДатаНапоминания = ДатаНапоминания + 24 * 60 * 60;
	КонецЕсли;
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_УЦКалугаАстрал", , ДатаНапоминания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложитьПоказПредупрежденияУЦКалугаАстрал_Завершение(Форма) Экспорт
	
	Форма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаявлениеНаПереизданиеСертификатаУЦКалугаАстрал(Форма, ТекущиеДанные) Экспорт
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Заявление) Тогда 
		
		Заявление = ТекущиеДанные.Заявление;
		ПоказатьЗначение(, Заявление);
		
	Иначе
		
		Организация = ТекущиеДанные.Организация;
		ОткрытьНовоеЗаявлениеУЦКалугаАстрал(Форма, Организация);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНовоеЗаявлениеУЦКалугаАстрал(Форма, Организация, ОповещениеОЗавершении = Неопределено)
	
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ПриОткрытииЗапрошеноПродлениеСертификата", Истина);
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ОткрытьФормуМастераЗаявленияНаПодключение(
		Организация,
		Форма,,
		ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение"),
		ПараметрыОткрытияФормы,
		ОповещениеОЗавершении);
	
КонецПроцедуры

#КонецОбласти

#Область ПредупредитьОбАстралМ

&НаКлиенте
Процедура ПредупредитьОбАстралМКлиент() Экспорт
	
	Если НЕ НапомнитьПроАстралМ() Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ПредупредитьОбАстралМПослеПолученияСертификатов", ЭтотОбъект);
	
	ХранилищаСертификатов = Новый Массив;
	ХранилищаСертификатов.Добавить(Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "MY", Истина));
	ХранилищаСертификатов.Добавить(Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "MY", Ложь));
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(Оповещение, ХранилищаСертификатов, ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаСервере
Функция НапомнитьПроАстралМ() Экспорт
	
	ДатаСеанса = ТекущаяДатаСеанса();
	Это2021    = Год(ДатаСеанса) = 2021;
	Если НЕ Это2021 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаКогдаНапомнить = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_АстралМ");
	
	Если ДатаКогдаНапомнить = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОтложеноНаНикогда = ДатаКогдаНапомнить = '00010101000000';
	
	Возврат ДатаСеанса >= ДатаКогдаНапомнить И НЕ ОтложеноНаНикогда;

КонецФункции

&НаКлиенте
Процедура ПредупредитьОбАстралМПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		Возврат;
	КонецЕсли;

	Организации = ОрганизацииИспользующиеСертификатАстралМ(Результат.Сертификаты);
	Количество  = Организации.Количество();

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организации", Организации);
	
	Если Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если РегламентированнаяОтчетностьВызовСервера.ИспользуетсяОднаОрганизация() Тогда
		
		Организация = Организации[0].Организация;
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПредупредитьОбАстралМПослеПолученияСертификатов_ОткрытьЗаявление",
			ЭтотОбъект, 
			Организация);
			
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ОтправьтеЗаявлениеАстралМПоОрганизации",
			ДополнительныеПараметры,
			,
			,
			,
			,
			ОписаниеОповещения);
		
	Иначе
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ОтправьтеЗаявлениеАстралМПоОрганизациям",
			ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

