&НаСервереБезКонтекста
Функция ИзвлечьЭлектронноеПредставлениеИзХранилищаИНараститьСчетчикПриНеобходимости(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки)
	
	// готовим массив возможных типов файлов
	ВозможныеТипыФайлов = Новый Массив;
	ВозможныеТипыФайлов.Добавить(Неопределено);
	ВозможныеТипыФайлов.Добавить(Перечисления.ТипыФайловБухОтчетности.ОсновнойФайлОтчетности);
	ВозможныеТипыФайлов.Добавить(Перечисления.ТипыФайловБухОтчетности.ПустаяСсылка());
	
	// получаем электронное представление
	ХранилищеВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	ИзвлечьЭлектронноеПредставлениеИзХранилища(Контекст.Документ, ИмяФайлаВыгрузки, ХранилищеВыгрузки, ВозможныеТипыФайлов);
	Если ИмяФайлаВыгрузки = "" ИЛИ ХранилищеВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не обнаружена информация для отправки!';
								|en = 'Не обнаружена информация для отправки!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем электронное представление в файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	ХранилищеВыгрузки.Получить().Записать(ВремФайл);
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, ?(нрег(Прав(ИмяФайлаВыгрузки, 4)) = ".xml", "windows-1251", "cp866"));
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	// наращиваем счетчики в имени файла выгрузки и в содержимом
	НараститьСчетчикДокументовПриНеобходимости(ТекстВыгрузки, ИмяФайлаВыгрузки, Контекст.Организация, Контекст.ДатаОкончанияПериодаОтчета);
	НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(ИмяФайлаВыгрузки, Контекст.Организация, Контекст.Документ.ДатаОкончания, Контекст.КодНалоговогоОргана);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьЭлектронноеПредставлениеФСГСИзХранилища(Контекст, ТекстВыгрузки, ИмяФайлаВыгрузки, КодировкаФайла = Неопределено)
	
	// получаем электронное представление
	ХранилищеВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	ИзвлечьЭлектронноеПредставлениеИзХранилища(Контекст.Документ, ИмяФайлаВыгрузки, ХранилищеВыгрузки);
	Если ИмяФайлаВыгрузки = "" ИЛИ ХранилищеВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не обнаружена информация для отправки!';
								|en = 'Не обнаружена информация для отправки!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем электронное представление в файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	ДанныеПредставления = ХранилищеВыгрузки.Получить();
	ДанныеПредставления.Записать(ВремФайл);
	
	Если СтрНайти(ИмяФайлаВыгрузки, "NO_BUH") = 1 ИЛИ СтрНайти(ИмяФайлаВыгрузки, "NO_BOUPR") = 1 ИЛИ СтрНайти(ИмяФайлаВыгрузки, "NO_BOUCH") = 1 Тогда
		КодировкаФайла = "windows-1251";
	Иначе
		КодировкаФайла = ОпределитьКодировку(ДанныеПредставления);
	КонецЕсли;
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, КодировкаФайла);
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура НараститьСчетчикДокументовПриНеобходимости(ТекстВыгрузки, ИмяФайла, Организация, ДатаОкончанияПериода)
	
	РасширениеСТочкой = нрег(Прав(ИмяФайла, 4));
	Если РасширениеСТочкой = ".xml" Тогда
		Возврат;
	КонецЕсли;
	
	КлючеваяФраза = Символы.ПС + "ИдДок:";
	Для Стр = 1 По СтрЧислоСтрок(ТекстВыгрузки) Цикл
		ТекСтр = СтрПолучитьСтроку(ТекстВыгрузки, Стр);
		Если Лев(ТекСтр, 6) <> "ИдДок:" Тогда
			Продолжить;
		КонецЕсли;
		СчетчикДокументов = РегламентированнаяОтчетность.ПолучитьСчетчикВыгруженныхДокументов(Организация, ДатаОкончанияПериода) + 1;
		ЭтоАлко = (СтрНайти(ТекстВыгрузки, Символы.ПС + "ТипИнф:11520") <> 0);
		Если ЭтоАлко Тогда
			НовСтр = Лев(ТекСтр,СтрДлина(ТекСтр) - 4) + Прав(Формат(СчетчикДокументов, "ЧДЦ=0; ЧВН=; ЧГ=0"), 2) + Прав(ТекСтр, 2);
		Иначе
			НовСтр = Лев(ТекСтр,СтрДлина(ТекСтр) - 8) + Формат(СчетчикДокументов, "ЧЦ=8; ЧВН=; ЧГ=0");
		КонецЕсли;
		ТекстВыгрузки = СтрЗаменить(ТекстВыгрузки, Символы.ПС + ТекСтр, Символы.ПС + НовСтр);
		РегламентированнаяОтчетность.УстановитьСчетчикВыгруженныхДокументов(Организация, СчетчикДокументов, ДатаОкончанияПериода);
		Прервать;
	КонецЦикла;
		
КонецПроцедуры

