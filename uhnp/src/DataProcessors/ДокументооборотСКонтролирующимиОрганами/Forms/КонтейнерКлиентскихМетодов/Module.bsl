&НаСервереБезКонтекста
Функция РазобратьУзелСДаннымиСообщенияСЭДО(УзелДанныеСообщения, ДанныеСообщения, ДатаСообщения, ИдентификаторЗапроса = "")

	ДанныеСообщения.Идентификатор = УзелДанныеСообщения.uuid;
	ДанныеСообщения.Тип = УзелДанныеСообщения.messageType;
	ЭлектронныйДокументооборотСФСС.ЗаполнитьОписаниеТипаВДанныхСообщенияСЭДО(ДанныеСообщения);
	
	Если УзелДанныеСообщения.Свойства().Получить("recipientId") = Неопределено
		И УзелДанныеСообщения.Свойства().Получить("org") <> Неопределено Тогда
		Если УзелДанныеСообщения.org.Свойства().Получить("ogrnip") = Неопределено Тогда
			ДанныеСообщения.Получатель = ?(УзелДанныеСообщения.org.Свойства().Получить("ogrn") = Неопределено,
				"", УзелДанныеСообщения.org.ogrn);
		Иначе
			ДанныеСообщения.Получатель = УзелДанныеСообщения.org.ogrnip;
		КонецЕсли;
		ДанныеСообщения.ИНН = УзелДанныеСообщения.org.inn;
		Если УзелДанныеСообщения.org.Свойства().Получить("kpp") <> Неопределено Тогда
			ДанныеСообщения.КПП = УзелДанныеСообщения.org.kpp;
		КонецЕсли;
		Если УзелДанныеСообщения.org.Свойства().Получить("snils") <> Неопределено Тогда
			ДанныеСообщения.СНИЛС = ?(ТипЗнч(УзелДанныеСообщения.org.snils) = Тип("ОбъектXDTO"),
				"", УзелДанныеСообщения.org.snils);
		КонецЕсли;
	ИначеЕсли УзелДанныеСообщения.Свойства().Получить("recipientId") <> Неопределено Тогда
		ДанныеСообщения.Получатель = УзелДанныеСообщения.recipientId;
	КонецЕсли;
	Если ЕстьСвойство(УзелДанныеСообщения, "regNumSfr") Тогда
		ДанныеСообщения.РегистрационныйНомерСФР = УзелДанныеСообщения.regNumSfr;
	КонецЕсли;
	ДанныеСообщения.ТребуетсяПодтверждение = ЗначениеНеобязательногоСвойства(УзелДанныеСообщения, "needConfirm", "Булево", Ложь);
	Если ЕстьСвойство(УзелДанныеСообщения, "expiryDate") Тогда
		ДанныеСообщения.СрокДействия = XMLЗначение(Тип("Дата"), УзелДанныеСообщения.expiryDate);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаСообщения) Тогда
		ДанныеСообщения.Дата = ДатаСообщения;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ИдентификаторЗапроса) Тогда
		ДанныеСообщения.ИдентификаторЗапроса = ИдентификаторЗапроса;
	КонецЕсли;
	
	СообщениеBase64 = УзелДанныеСообщения.message;
	Данные = Base64Значение(СообщениеBase64);
	
	Чтение = Новый ЧтениеДанных(Данные);
	ТекстСообщения = Чтение.ПрочитатьСимволы();
	Чтение.Закрыть();
	
	// В некоторых случаях текст сообщения приходит без кодирования в Base64.
	Если ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = СообщениеBase64;
	КонецЕсли;
	
	ДанныеСообщения.ТекстСообщения = ТекстСообщения;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьТелоОтветаИзКонтейнераСЭДО(СодержимоеОтвета)
	
	Открытие = "<soap:Body";
	Закрытие = "</soap:Body>";
	ТелоОтвета = "";
	Если СтрНайти(СодержимоеОтвета, Открытие) > 0 Тогда
		Начало = СтрНайти(СодержимоеОтвета, Открытие);
		Окончание = СтрНайти(СодержимоеОтвета, Закрытие) + СтрДлина(Закрытие);
		Длина = Окончание - Начало;
		ТелоОтвета = Сред(СодержимоеОтвета, Начало, Длина);
	Иначе
		ТелоОтвета = СодержимоеОтвета;
	КонецЕсли;
	
	Возврат ТелоОтвета;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьОтветВходящиеСообщенияСЭДОФСС(СодержимоеОтвета, ДатаСообщений, СвойстваОбменаПоСЭДОЧерезОператора = Неопределено)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.РазобратьОтветВходящиеСообщенияСЭДОФСС(СодержимоеОтвета, ДатаСообщений, , СвойстваОбменаПоСЭДОЧерезОператора);
	
КонецФункции

