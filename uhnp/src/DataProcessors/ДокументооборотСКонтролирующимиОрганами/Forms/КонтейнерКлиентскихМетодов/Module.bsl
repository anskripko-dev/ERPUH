&НаКлиенте
Функция НаправлениеОтправкиСообщенияПодключено(ОповещениеОЗавершении, ТранспортноеСообщение, ТихийРежим = Ложь) Экспорт

	Свойства = ЗначенияРеквизитовОбъекта(ТранспортноеСообщение, "Тип, ЦиклОбмена");
	Если Свойства.Тип = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ДокументНО") Тогда
		
		ЦиклОбмена = ЗначенияРеквизитовОбъекта(Свойства.ЦиклОбмена, "ВнешняяОрганизация.Код, Организация, Предмет");
		
		Подключена = 
			ОрганизацияПодключенаКИнспекцииПоКодуИФНС(
				ЦиклОбмена.Организация, 
				ЦиклОбмена.ВнешняяОрганизацияКод);
				
		ЕстьПраво = МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ЦиклОбмена.Предмет);
				
		Если НЕ Подключена ИЛИ НЕ ЕстьПраво Тогда
			
			Если ТихийРежим Тогда
				
				ИФНС = СведенияПоОтправляемымОбъектам(ТранспортноеСообщение).КодКонтролирующегоОргана;
				
				Результат = РезультатПодтверждения();
				Результат.ТекстОшибки = НСтр("ru = 'Не подключена ИФНС ';
											|en = 'Не подключена ИФНС '") + Строка(ИФНС);
				
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
				Возврат Ложь;
			КонецЕсли;
			
			ЭтоОтправкаИзПанели = Ложь;
			ПроверитьЧтоЭтоОтправкаИзПанелиРекурсивно(ОповещениеОЗавершении, ЭтоОтправкаИзПанели);
			
			Если ЭтоОтправкаИзПанели Тогда
			
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("СсылкаНаОбъект", ТранспортноеСообщение);
				
				СообщитьОНеподключенномНаправлении(ДополнительныеПараметры);//+
				Возврат Ложь;
				
			Иначе
				
				// Ничего не делаем.
				// Ошибка будет выдана методом ИФНСВходящейОписиПодключено(СообщениеОснование, Объект)
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

&НаКлиенте
Процедура ПроверитьЧтоЭтоОтправкаИзПанелиРекурсивно(Значение, Результат) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда
		
		ПроверитьЧтоЭтоОтправкаИзПанелиРекурсивно(Значение.ДополнительныеПараметры, Результат);
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		
		Если Значение.Свойство("ЭтоОтправкаПодтвержденияИзПанелиОтправки") Тогда
			Результат = Истина;
			Возврат;
		КонецЕсли;
		
		Для каждого ЭлементСтруктуры Из Значение Цикл
			
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Структура") Тогда
			
				ПроверитьЧтоЭтоОтправкаИзПанелиРекурсивно(ЭлементСтруктуры.Значение, Результат);
				Возврат;
				
			КонецЕсли;
			
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ОписаниеОповещения") Тогда
			
				ПроверитьЧтоЭтоОтправкаИзПанелиРекурсивно(ЭлементСтруктуры.Значение, Результат);
				Возврат;
				
			КонецЕсли;
		
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждение(ОповещениеОЗавершении, Основание) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// создаем на сервере
	НужноСоздать = НужноСоздатьИЗаполнитьОтветноеСообщение(Основание);
	
	ОтветноеСообщениеНайдено = Ложь;
	
	Если НужноСоздать Тогда
		
		Подключено = НаправлениеОтправкиСообщенияПодключено(ОповещениеОЗавершении, Основание);
		Если НЕ Подключено Тогда
			Возврат;
		КонецЕсли;
		
		ОтветноеСообщение = СоздатьИЗаполнитьОтветноеСообщение(Основание);
		Если ОтветноеСообщение = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			Возврат;
		ИначеЕсли ОтветноеСообщение.УжеСуществует Тогда
			ОтветноеСообщение        = ОтветноеСообщение.СуществующееСообщение;
			ОтветноеСообщениеНайдено = Истина;
		КонецЕсли;
	КонецЕсли;
		
	Если НЕ НужноСоздать ИЛИ ОтветноеСообщениеНайдено Тогда
		
		Если НЕ ОтветноеСообщениеНайдено ИЛИ ОтветноеСообщение = Неопределено Тогда
			ОтветноеСообщение = ОтветноеСообщениеПоСообщениюОснованию(Основание);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ОтветноеСообщение);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = Новый Структура("Подтверждение", ОтветноеСообщение.Ссылка);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("Подтверждение", ОтветноеСообщение.Ссылка);
	Оповещение = Новый ОписаниеОповещения(
