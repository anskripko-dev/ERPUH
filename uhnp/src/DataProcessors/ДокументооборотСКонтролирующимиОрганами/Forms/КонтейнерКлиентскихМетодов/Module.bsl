&НаКлиенте
Процедура ПоказатьОтветыНаТребованияФСС(Ответы) Экспорт
	
	Если Ответы.Количество() > 1 Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Ответы", Ответы);

		ОткрытьФорму(ПутьКОбъекту + ".Форма.ОтветыНаТребованияФСС", ДополнительныеПараметры,, Новый УникальныйИдентификатор);
		
	ИначеЕсли Ответы.Количество() = 1 Тогда
		
		ПоказатьЗначение(, Ответы[0]);
		
	Иначе
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Ответы отсутствуют';
															|en = 'Ответы отсутствуют'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьСтруктуруПараметровПолученияСообщений(СтруктураСвойств, ДополнительныеПараметры, ОтправкаСсылка)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ТипСообщенияОтвета = Неопределено;
	Иначе
		ДополнительныеПараметрыОповещения = ДополнительныеПараметры.ВыполняемоеОповещение.ДополнительныеПараметры;
		
		ТипСообщенияОтвета = ?(ДополнительныеПараметрыОповещения.Свойство("ТипСообщенияОтвета"),
			ДополнительныеПараметрыОповещения.ТипСообщенияОтвета, Неопределено);
	КонецЕсли;
	
	СтруктураСвойств.Вставить("ТипСообщенияОтвета", ТипСообщенияОтвета);
	
КонецПроцедуры

