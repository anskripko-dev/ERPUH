				Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
					Секция_Тело.Области.Тело.Текст = ПолеОбщихСведений.Имя + ": " + СокрЛП(ЗначениеПоля);
					ТаблДок.Вывести(Секция_Тело);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблДок.Вывести(Секция_Разделитель);
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);
	
	// инициализируем текст нижнего колонтитула
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииОтметки(СтрСообщение)
	
	Если НЕ ЗначениеЗаполнено(СтрСообщение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Описание");

	ОбщиеСведения = Новый Структура;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрСообщение, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML файла:%1';
																						|en = 'Ошибка разбора XML файла:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелСведений Из УзелФайл.Строки Цикл
		ИмяУзла = УзелСведений.Имя;
		Если ИмяУзла = "ИдФайл" ИЛИ ИмяУзла = "ВерсПрог" ИЛИ ИмяУзла = "ВерсФорм" Тогда
			ОбщиеСведения.Вставить(УзелСведений.Имя, СокрЛП(УзелСведений.Значение));
		КонецЕсли;
	КонецЦикла;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелОбщСвед Из УзелДокумент.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;

	УзелСвУведом = УзелДокумент.Строки.Найти("СвУведом", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвУведом) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""СвУведом"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""СвУведом"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	Для Каждого УзелОбщСвед Из УзелСвУведом.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	// анализируем сведения о несоответствиях
	УзлыСвНесоотв = УзелСвУведом.Строки.НайтиСтроки(Новый Структура("Имя", "СвНесоотв"));
	Для Каждого УзелСвНесоотв Из УзлыСвНесоотв Цикл
		НовСтр = ТаблицаОшибок.Добавить();
		НовСтр.Описание = СокрЛП(УзелСвНесоотв.Значение);
	КонецЦикла;
	
	// анализируем сведения о непредставленных документах
	УзлыСвНепредст = УзелСвУведом.Строки.НайтиСтроки(Новый Структура("Имя", "СвНепредст"));
	Для Каждого УзелСвНепредст Из УзлыСвНепредст Цикл
		НовСтр = ТаблицаОшибок.Добавить();
		НовСтр.Описание = СокрЛП(УзелСвНепредст.Значение);
	КонецЦикла;
	
	// дополняем узел с общими сведениями
	УзелСвНовЗаяв = УзелСвУведом.Строки.Найти("СвНовЗаяв", "Имя");
	Если ЗначениеЗаполнено(УзелСвНовЗаяв) Тогда
		Для Каждого УзелОбщСвед Из УзелСвНовЗаяв.Строки Цикл
			ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Структура("Ошибки, ОбщиеСведения", ТаблицаОшибок, ОбщиеСведения);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзУведомленияОбОтказеВПриемеНалоговойДекларацииЗаявление(СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ошибки = Новый ТаблицаЗначений;
	Ошибки.Колонки.Добавить("КодОшибки");
	Ошибки.Колонки.Добавить("Описание");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML файла:%1';
																						|en = 'Ошибка разбора XML файла:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""Файл"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""Документ"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСведУведОтказ = УзелДокумент.Строки.Найти("СведУведОтказ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСведУведОтказ) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""СведУведОтказ"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""СведУведОтказ"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелОбщСвУвед = УзелСведУведОтказ.Строки.Найти("ОбщСвУвед", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелОбщСвУвед) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML файла: не обнаружен узел ""ОбщСвУвед"".';
								|en = 'Некорректная структура XML файла: не обнаружен узел ""ОбщСвУвед"".'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем общий перечень нарушений
	УзлыПеречВыявНар = УзелСведУведОтказ.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
	Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
		УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
		УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
		Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш) Тогда
			
			КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "");
			ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "");
			
			НовСтр = Ошибки.Добавить();
			НовСтр.КодОшибки = КодОшибки;
			НовСтр.Описание = ТекстОшибки;
			
		КонецЕсли;
	КонецЦикла;
	
	// разбираем узел с перечнем выявленных нарушений
	Если УзлыПеречВыявНар.Количество() = 0 Тогда
		УзлыВыявлНарФайл = УзелСведУведОтказ.Строки.НайтиСтроки(Новый Структура("Имя", "ВыявлНарФайл"));
		Для Каждого УзелВыявНарФайл Из УзлыВыявлНарФайл Цикл
			УзлыПеречВыявНар = УзелВыявНарФайл.Строки.НайтиСтроки(Новый Структура("Имя", "ПеречВыявНар"));
			Для Каждого УзелПеречВыявНар Из УзлыПеречВыявНар Цикл
				УзелКодОш = УзелПеречВыявНар.Строки.Найти("КодОш", "Имя");
				УзелТекстОш = УзелПеречВыявНар.Строки.Найти("ТекстОш", "Имя");
				Если ЗначениеЗаполнено(УзелКодОш) ИЛИ ЗначениеЗаполнено(УзелТекстОш) Тогда
					
					КодОшибки = ?(ЗначениеЗаполнено(УзелКодОш), СокрЛП(УзелКодОш.Значение), "");
					ТекстОшибки = ?(ЗначениеЗаполнено(УзелТекстОш), СокрЛП(УзелТекстОш.Значение), "");
					
					НовСтр = Ошибки.Добавить();
					НовСтр.КодОшибки = КодОшибки;
					НовСтр.Описание = ТекстОшибки;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	УзелОбщСвУвед = УзелСведУведОтказ.Строки.Найти("ОбщСвУвед", "Имя");
	Для Каждого УзелСведение Из УзелОбщСвУвед.Строки Цикл
		ОбщиеСведения.Вставить(УзелСведение.Имя, СокрЛП(УзелСведение.Значение));
	КонецЦикла;
	
	Если ОбщиеСведения.Свойство("ДатаНапр") И ОбщиеСведения.Свойство("ВремНапр") Тогда
		ОбщиеСведения.Вставить("ДатаВремяНапр", ОбщиеСведения.ДатаНапр + " " + ОбщиеСведения.ВремНапр);
	КонецЕсли;
	
	Возврат Новый Структура("Ошибки, ОбщиеСведения", Ошибки, ОбщиеСведения);
	
КонецФункции

// Проверяет наличие ограничений у пользователя на обмен 1С-Отчетности
//
// Параметры:
//	ВыбранныеОрганизации - Массив
//
// Возвращаемое значение:
//	Структура с полями
//	* Состояние 	- Число - возможные значения 1 (доступен), 2 (запрещен), 3 (требует оповещения)
//
&НаСервере
Функция СостояниеВозможностиОбмена(ВыбранныеОрганизации) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Состояние", 1);
	
	КонтекстСервера = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ВсеОрганизации = КонтекстСервера.ОрганизацииСОграничениемПрав();
	НастроенныеОрганизации = КонтекстСервера.ВыбранныеОрганизацииДляОбмена();
	
	НашлиСтроки = ВсеОрганизации.НайтиСтроки(Новый Структура("НетОграничения", Ложь));
	Если (НашлиСтроки.Количество() = ВсеОрганизации.Количество()
		И ВсеОрганизации.Количество() > 0)
		ИЛИ НастроенныеОрганизации.Количество() = 0 Тогда
		Результат.Состояние = 3;
	КонецЕсли;	
	
	Если Результат.Состояние <> 3 Тогда
		ПраваНаОбмен = ЕстьВозможностьОбмена(ВыбранныеОрганизации, Ложь);
		Если ПраваНаОбмен Тогда
			Результат.Состояние = 1;
		Иначе
			Результат.Состояние = 2;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЕстьВозможностьОбмена(Организации, ЭтоОбменИзЖурналаОбмена) Экспорт
	
	ОбменВозможен = Ложь;
	
	ЕстьПравоНаДокументооборот 	= Ложь;
	ЕстьХотяБыОднаУчетнаяЗапись = Ложь;
	ЕстьЭДОСПрочимиОрганами 	= Ложь;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	Для каждого Организация Из Организации Цикл
		
		// Учетная запись.
		УчетнаяЗапись = КонтекстЭДОСервер.УчетнаяЗаписьОрганизации(Организация);
		
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			
			ЕстьХотяБыОднаУчетнаяЗапись = Истина;
			
			ОбменПоДаннойУчетнойЗаписиВозможен = КонтекстЭДОСервер.ПользователюРазрешеноВыполнятьОбменПоУчетнойЗаписи(УчетнаяЗапись);
		
			Если ОбменПоДаннойУчетнойЗаписиВозможен Тогда
				ЕстьПравоНаДокументооборот 	= Истина;
				ОбменВозможен 				= Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЭтоОбменИзЖурналаОбмена Тогда
		
			// ФСС.
			ЕстьОбменСФСС = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФСС(Организация);
				
			Если ЕстьОбменСФСС Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// ФСРАР.
			ЕстьОбменСФСРАР = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФСРАР(Организация);
				
			Если ЕстьОбменСФСРАР Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// РПН.
			ЕстьОбменСРПН = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСРПН(Организация);
				
			Если ЕстьОбменСРПН Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// ФТС.
			ЕстьОбменСФТС = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСФТС(Организация);
				
			Если ЕстьОбменСФТС Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
			// Банк России
			ЕстьОбменСБанкомРоссии = КонтекстЭДОСервер.ОрганизацияИспользуетОбменСБанкомРоссии(Организация);
				
			Если ЕстьОбменСБанкомРоссии Тогда
				ЕстьЭДОСПрочимиОрганами = Истина;
				ОбменВозможен = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ОбменВозможен Тогда
		
		ТекстНедостаточноПрав = НСтр("ru = 'Недостаточно прав для проведения обновления. 
			|Убедитесь, что ваш пользователь указан в списке пользователей учетной записи документооборота организации.';
			|en = 'Недостаточно прав для проведения обновления. 
			|Убедитесь, что ваш пользователь указан в списке пользователей учетной записи документооборота организации.'");
		
		Если ЭтоОбменИзЖурналаОбмена Тогда
			
			Если НЕ ЕстьХотяБыОднаУчетнаяЗапись Тогда
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'Для организации не настроена возможность отправки в контролирующие органы';
						|en = 'Для организации не настроена возможность отправки в контролирующие органы'"));
			ИначеЕсли НЕ ЕстьПравоНаДокументооборот Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстНедостаточноПрав);
			КонецЕсли;
				
		Иначе
			
			Если НЕ ЕстьПравоНаДокументооборот Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстНедостаточноПрав);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбменВозможен;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзВременногоХранилищаЕслиСтрока(Адрес, ПривестиКСтроке = Ложь)
	
	ДанныеВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДанныеВременногоХранилища) = Тип("Строка") Тогда
		Возврат ДанныеВременногоХранилища;
		
	ИначеЕсли ПривестиКСтроке И ТипЗнч(ДанныеВременногоХранилища) = Тип("ДвоичныеДанные") Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ДанныеВременногоХранилища.Записать(ИмяВременногоФайла);
		
		ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, "windows-1251");
		ТекстФайла = ОбъектЧтениеТекста.Прочитать();
		ОбъектЧтениеТекста.Закрыть();
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		
		Возврат ТекстФайла;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция СгенерироватьUUIDКлиент() Экспорт
	
	Возврат НРег(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
	
КонецФункции

&НаКлиенте
Функция СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент(РасширениеФайла = ".bin")
	
	Возврат СгенерироватьUUIDКлиент() + РасширениеФайла;
	
КонецФункции

//Конвертация текста в ДД в base64 с приведением типа к ДД
&НаСервереБезКонтекста
Процедура ЗакодироватьВBase64ЗначениеВременногоХранилища(АдресВоВременномХранилище, ПривестиКДД = Истина)
	
	ДД = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	РаботаемСДД = ТипЗнч(ДД) = Тип("ДвоичныеДанные");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("bin");
	
	Если РаботаемСДД Тогда 
		Б64 = Base64Строка(ДД);
	Иначе
		ТекстовыйДок = Новый ТекстовыйДокумент();
		ТекстовыйДок.УстановитьТекст(ДД);
		ТекстовыйДок.Записать(ВременныйФайл, "windows-1251", "");
		
		ДД = Новый ДвоичныеДанные(ВременныйФайл);
		Б64 = Base64Строка(ДД);
	КонецЕсли;	
	
	Если ПривестиКДД Тогда
		ТекстовыйДок = Новый ТекстовыйДокумент();
		ТекстовыйДок.УстановитьТекст(Б64);
		ТекстовыйДок.Записать(ВременныйФайл, "windows-1251", "");
		
		ДД = Новый ДвоичныеДанные(ВременныйФайл);
	Иначе
		ДД = Б64;
	КонецЕсли;

	ПоместитьВоВременноеХранилище(ДД, АдресВоВременномХранилище);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьДанныеНаСервер(Знач ТекстФайлаВыгрузки, УникальныйИдентификатор, ПолноеИмяФайлаНаСервере = Неопределено, ПреобразоватьВДвоичныеДанные = Ложь, КодироватьВBase64 = Ложь, ДекодироватьИзBase64 = Ложь, ИгнорироватьКодировку = Ложь)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();

	Адрес = КонтекстЭДО.ЗагрузитьДанныеНаСервер(
				ТекстФайлаВыгрузки,
				УникальныйИдентификатор,
				ПолноеИмяФайлаНаСервере,
				ПреобразоватьВДвоичныеДанные,
				КодироватьВBase64,
				ДекодироватьИзBase64,
				ИгнорироватьКодировку);
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАРПослеАвторизации(Результат, ВхПараметры) Экспорт
	СформироватьПодписанныйПакетДляПорталаФСРАР(
