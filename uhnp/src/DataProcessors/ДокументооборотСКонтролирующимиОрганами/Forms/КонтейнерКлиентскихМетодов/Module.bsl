Функция ШаблонТаблицыНеДокФорм()
				
	// определяем таблицу с информацией о файлах сканов
	ТаблицаНеДокФорм = Новый ТаблицаЗначений;
	ТаблицаНеДокФорм.Колонки.Добавить("Документ");
	ТаблицаНеДокФорм.Колонки.Добавить("ПорНом");
	ТаблицаНеДокФорм.Колонки.Добавить("МассивФайлов", Новый ОписаниеТипов("Массив"));
	ТаблицаНеДокФорм.Колонки.Добавить("ИдФайлЭП");
	ТаблицаНеДокФорм.Колонки.Добавить("АдресЭП");
	ТаблицаНеДокФорм.Колонки.Добавить("КодДок");
	ТаблицаНеДокФорм.Колонки.Добавить("ЭтоПакетСДопДокументами");

	Возврат ТаблицаНеДокФорм;
			
КонецФункции

&НаСервере
Функция ДобавитьСтрокуТаблицыНеДокФорм(
			ИдентификаторОтправителяПолучателя, 
			ИДФормы,
			СтрокаПредставляемыйДокумент,
			ТаблицаНеДокФорм,
			ОписьСсылка)
			
	ЭтоФормат_ON_DOCNPNO_1_886_00_05_02 = ТребованияФНСКлиентСервер.ЭтоФормат_ON_DOCNPNO_1_886_00_05_02();
			
	СсылкаСканированныйДокумент = СтрокаПредставляемыйДокумент.СсылкаНаОбъект;
	
	// формируем GUID файла, одинаковый для всех файлов документа
	N1 = Строка(Новый УникальныйИдентификатор);

	// сохраняем вложения в каталог выгрузки
	ВложенияСДанными = ПолучитьТаблицуПрисоединенныхФайловСканДокумента(СсылкаСканированныйДокумент);
	
	ПорНом = ?(СтрокаПредставляемыйДокумент.ЯвляетсяИнформацией, "2.", "1.") 
		+ Формат(СтрокаПредставляемыйДокумент.ПорядковыйНомер, "ЧЦ=2; ЧН=; ЧВН=");

	КодДок = КодДокДляДокСкана(ОписьСсылка, СсылкаСканированныйДокумент);
	
	ЗначениеЗаполнения = Новый Структура();
	ЗначениеЗаполнения.Вставить("Документ", СсылкаСканированныйДокумент);
	ЗначениеЗаполнения.Вставить("ПорНом", ПорНом);
	ЗначениеЗаполнения.Вставить("КодДок", КодДок);
	ЗначениеЗаполнения.Вставить("ЭтоПакетСДопДокументами", ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка));
	
	НовСтр = ТаблицаНеДокФорм.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр, ЗначениеЗаполнения);
	
	ДобавитьПодпись = 
		ЭтоФормат_ON_DOCNPNO_1_886_00_05_02 
		ИЛИ НЕ ЭтоФормат_ON_DOCNPNO_1_886_00_05_02 И ВложенияСДанными.Количество() = 1;
	
	МассивФайлов = Новый Массив;
	Для Каждого СтрВложение Из ВложенияСДанными Цикл
		
		ИмяФайла = ИмяФайлаВложенияНеДокФорм(
			ИдентификаторОтправителяПолучателя, 
			СтрВложение.ИмяФайла,
			КодДок,
			N1);
		
		// ЭП
		ПрисоединенныйФайл = СтрВложение.Ссылка;
		
		ЭП = ИдФайлИАдрес_ЭПНеДокФорм(ПрисоединенныйФайл, ИмяФайла, ДобавитьПодпись);
		ИдФайлЭП = ЭП.ИдФайлЭП;
		АдресЭП  = ЭП.АдресЭП;
		
		Если НЕ ЗначениеЗаполнено(АдресЭП) 
			И НЕ ПрисоединенныйФайл.ЕстьВстроеннаяПодпись
			И ПрисоединенныйФайл.ВидPDF = ПредопределенноеЗначение("Перечисление.ВидыPDF.ДокPDF")
			И ДобавитьПодпись Тогда
			
			ИдФайлЭП = ИмяФайлаЭПФайлаОписиИсходящихДокументов(ИмяФайла);
			
		КонецЕсли;
		
		ЭлементВыгрузки = Новый Структура;
		ЭлементВыгрузки.Вставить("ИмяФайла", ИмяФайла);
		ЭлементВыгрузки.Вставить("АдресВременногоХранилища", ПоместитьВоВременноеХранилище(СтрВложение.Данные, ИДФормы));
		ЭлементВыгрузки.Вставить("ЕстьВстроеннаяПодпись",    ПрисоединенныйФайл.ЕстьВстроеннаяПодпись);
		ЭлементВыгрузки.Вставить("ВидPDF", 					 ПрисоединенныйФайл.ВидPDF);
		ЭлементВыгрузки.Вставить("Расширение", 				 ПрисоединенныйФайл.Расширение);
		
		ЭтоПоследний = ВложенияСДанными.Индекс(СтрВложение) = ВложенияСДанными.Количество() - 1;
		
		РазбитьСтрокиНеДокФормПоЭлПодписи(
			ТаблицаНеДокФорм,
			ЗначениеЗаполнения,
			МассивФайлов,
			ЭлементВыгрузки,
			НовСтр,
			АдресЭП,
			ИдФайлЭП,
			НЕ ЭтоПоследний);
		
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура ДобавитьТекстовоеПояснение(
			ИдентификаторОтправителяПолучателя, 
			ИДФормы,
			ТаблицаНеДокФорм,
			ОписьСсылка)
			
	ДвДанные = Справочники.ШаблоныПоясненийДляФНС.ДвДанныеТекстовогоПоясненияПоСсылке(
		ОписьСсылка,
		ТекстовоеПояснение, 
		"ТекстовоеПояснение");
		
	ЕстьТекст = Справочники.ШаблоныПоясненийДляФНС.ЗаполненТекстФорматированногоДокумента(
		ТекстовоеПояснение);
	
	Если НЕ ЕстьТекст Тогда
		Возврат;
	КонецЕсли;
	
	// формируем GUID файла, одинаковый для всех файлов документа
	N1 = Строка(Новый УникальныйИдентификатор);

	ЭтоПакетСДопДокументами = ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка);
	
	КодДок = "8888"; // Ответ на требование о представлении пояснений
	
	ИмяФайла = ИмяФайлаВложенияНеДокФорм(
			ИдентификаторОтправителяПолучателя, 
			"*.pdf", // Отсюда берется расширение
			КодДок,
			N1);
		
	ЭлементВыгрузки = Новый Структура;
	ЭлементВыгрузки.Вставить("ИмяФайла", ИмяФайла);
	ЭлементВыгрузки.Вставить("АдресВременногоХранилища", ПоместитьВоВременноеХранилище(ДвДанные, ИДФормы));
	ЭлементВыгрузки.Вставить("ЕстьВстроеннаяПодпись",    Ложь);
	ЭлементВыгрузки.Вставить("ВидPDF", 					 Перечисления.ВидыPDF.ДокPDF);
	ЭлементВыгрузки.Вставить("Расширение", 				 "PDF");
	
	ПорНом = "2.00"; // Информация, не документ

	ЗначениеЗаполнения = Новый Структура();
	ЗначениеЗаполнения.Вставить("Документ", Неопределено);
	ЗначениеЗаполнения.Вставить("ПорНом", ПорНом);
	ЗначениеЗаполнения.Вставить("КодДок", КодДок);
	ЗначениеЗаполнения.Вставить("ЭтоПакетСДопДокументами", ЭтоПакетСДопДокументами);
	
	НовСтр = ТаблицаНеДокФорм.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр, ЗначениеЗаполнения);
	
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(ЭлементВыгрузки);
	
	НовСтр.МассивФайлов = МассивФайлов;
	НовСтр.ИдФайлЭП = ИмяФайлаЭПФайлаОписиИсходящихДокументов(ИмяФайла);
	НовСтр.АдресЭП = "";
	
КонецПроцедуры

