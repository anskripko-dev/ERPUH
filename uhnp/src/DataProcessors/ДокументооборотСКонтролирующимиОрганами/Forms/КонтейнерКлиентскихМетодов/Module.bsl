&НаКлиенте
Функция СодержимоеСообщенияПодпискиСтрахователяНаОповещенияОбИзмененииСтатусаЭЛНВМО(РегистрационныйНомерФСС) Экспорт
	
	Шаблон = 
	"<subscribeInsRequest xmlns=""http://www.fss.ru/integration/types/eln/event/v01"">
	|	<event>CHANGE_STATE_MO</event>
	|	<regNum>%1</regNum>
	|</subscribeInsRequest>";
	
	Результат = СтрШаблон(Шаблон, РегистрационныйНомерФСС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СодержимоеСообщенияПодпискиРаботниковНаУведомлениеСтрахователяОбИзмененииСтатусаЭЛНВМО(
		РегистрационныйНомерФСС,
		СписокСНИЛС,
		ТипСобытия) Экспорт
	
	Шаблон =
	"<subscribeRecipientRequest xmlns=""http://www.fss.ru/integration/types/eln/event/v01"">
	|	<regNum>%1</regNum>
	|	<agreementReceived>true</agreementReceived>
	|	<commitExclude>true</commitExclude>
	|	<event>%2</event>
	|	<snilsList>";
	Результат = СтрШаблон(Шаблон, РегистрационныйНомерФСС, ТипСобытия);
	
	Шаблон = "
		|		<snils force=""%1"">%2</snils>";
	Для каждого Элемент Из СписокСНИЛС Цикл
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			"СодержимоеСообщенияПодпискиРаботниковНаУведомлениеСтрахователяОбИзмененииСтатусаЭЛНВМО",
			"ЭлементСпискаСНИЛС",
			Элемент,
			Тип("Структура"));
		СНИЛС = ОставитьТолькоЦифрыВСНИЛС(Элемент.СНИЛС);
		Результат = Результат + СтрШаблон(Шаблон, XMLБулево(Элемент.ПринудительноОткрепить), СНИЛС);
	КонецЦикла; 
	
	Результат = Результат + "	</snilsList>
	|</subscribeRecipientRequest>";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СодержимоеСообщенияОтпискиРаботниковНаУведомлениеСтрахователяОбИзмененииСтатусаЭЛНВМО(
		РегистрационныйНомерФСС,
		СписокСнилс,
		ТипСобытия) Экспорт
	
	Шаблон =
	"<unsubscribeRecipientRequest xmlns=""http://www.fss.ru/integration/types/eln/event/v01"">
	|	<regNum>%1</regNum>
	|	<agreementReceived>true</agreementReceived>
	|	<commitExclude>true</commitExclude>
	|	<event>%2</event>
	|	<snilsList>";
	Результат = СтрШаблон(Шаблон, РегистрационныйНомерФСС, ТипСобытия);
	
	Шаблон = "
		|		<snils>%1</snils>";
	Для каждого СНИЛС Из СписокСнилс Цикл
		ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
			"СодержимоеСообщенияПодпискиРаботниковНаУведомлениеСтрахователяОбИзмененииСтатусаЭЛНВМО",
			"ЭлементСпискаСНИЛС",
			СНИЛС,
			Тип("Строка"));
		СНИЛС = ОставитьТолькоЦифрыВСНИЛС(СНИЛС);
		Результат = Результат + СтрШаблон(Шаблон, СНИЛС);
	КонецЦикла; 
	
	Результат = Результат + "	</snilsList>
	|</unsubscribeRecipientRequest>";
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ДвоичныеДанныеИзТекстаНаСервере(Текст, Кодировка = Неопределено)
	
	Поток = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(Поток, Кодировка);
	ЗаписьДанных.ЗаписатьСимволы(Текст);
	ЗаписьДанных.Закрыть();
	Данные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Возврат Данные;
	
КонецФункции

&НаКлиенте
Функция ТекстЗапросаПолученияСообщенияСЭДОФСС(
		РегистрационныйНомерФСС,
		ИдентификаторСообщения,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	
	Если НастройкиВызова.ТипВзаимодействия = Неопределено Тогда
		НастройкиВызова.ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	ИнформацияОПрограмме = ИнформацияОПрограмме();
	
	ТекстПараметровТипаВзаимодействия = ДокументооборотСФССКлиентСервер.ТекстПараметровТипаВзаимодействияСЭДО(
		РегистрационныйНомерФСС, НастройкиВызова);
	
	Если НастройкиВызова.ОбменПоСЭДОНапрямую Тогда
		Шаблон = "
			|   <soapenv:Body xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
			+ " xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01"""
			+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"""
			+ " wsu:Id=""REGNO_%2"">
			|      <v01:getMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%4</software>
			|            <softwareVersion>%5</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>
			|         <uuid>%3</uuid>%6
			|      </v01:getMessageRequest>
			|   </soapenv:Body>";
		
	Иначе
		Шаблон = "
			|   <soapenv:Body xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
			+ " xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01"""
			+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"""
			+ " wsu:Id=""REGNO_%2"">
			|      <v01:getMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%4</software>
			|            <softwareVersion>%5</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>
			|         <uuidList>
			|            <uuid>%3</uuid>
			|         </uuidList>%6
			|      </v01:getMessageRequest>
			|   </soapenv:Body>";
	КонецЕсли;
	
	Текст = СтрШаблон(Шаблон,
		НастройкиВызова.ТипВзаимодействия,
		РегистрационныйНомерФСС,
		ИдентификаторСообщения,
		ИнформацияОПрограмме.ИДКонфигурации,
		ИнформацияОПрограмме.ВерсияКонфигурации,
		ТекстПараметровТипаВзаимодействия);
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Функция ТекстЗапросаОтправкиСообщенияСЭДОФСС(
		РегистрационныйНомерФСС,
		ТипСообщения,
		ТекстСообщения = Неопределено,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	
	Если НастройкиВызова.ТипВзаимодействия = Неопределено Тогда
		НастройкиВызова.ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(ТипСообщения);
	КонецЕсли;
	ИнформацияОПрограмме = ИнформацияОПрограмме();
	
	Если ТекстСообщения = Неопределено Тогда
		СообщениеBase64 = "%Message%";
	Иначе
		Данные = ДвоичныеДанныеИзТекстаНаСервере(ТекстСообщения);
		СообщениеBase64 = Base64Строка(Данные);
		Если СтрДлина(СообщениеBase64) <= 1 Тогда
			ТекстОшибки = НСтр("ru = 'Ошибка при кодирование текста сообщения СЭДО.';
								|en = 'Ошибка при кодирование текста сообщения СЭДО.'");
			Шаблон = ТекстОшибки + " " + НСтр("ru = 'Результат кодирования: %1. Текст сообщения:';
												|en = 'Результат кодирования: %1. Текст сообщения:'")
				+ Символы.ПС + "%2";
			ТекстОшибкиЖурнал = СтрШаблон(Шаблон, СообщениеBase64, ТекстСообщения);
			ЗаписатьСобытиеСЭДОВЖурнал("Ошибка", ТекстОшибкиЖурнал);
			ТекстОшибки = ТекстОшибки + " " + НСтр("ru = 'См. подробности в журнале регистрации.';
													|en = 'См. подробности в журнале регистрации.'");
			ВызватьИсключение(ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	ТекстПараметровТипаВзаимодействия = ДокументооборотСФССКлиентСервер.ТекстПараметровТипаВзаимодействияСЭДО(
		РегистрационныйНомерФСС, НастройкиВызова);
	
	Если НастройкиВызова.ОбменПоСЭДОНапрямую Тогда
		Шаблон = "
			|   <soapenv:Body xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/""
			|      xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01""
			|      xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""
			|      wsu:Id=""REGNO_%4"">
			|      <v01:putMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%5</software>
			|            <softwareVersion>%6</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>%7
			|         <messageType>%3</messageType>
			|         <message>%2</message>
			|      </v01:putMessageRequest>
			|   </soapenv:Body>";
		
		Текст = СтрШаблон(Шаблон,
			НастройкиВызова.ТипВзаимодействия,
			СообщениеBase64,
			ТипСообщения,
			РегистрационныйНомерФСС,
			ИнформацияОПрограмме.ИДКонфигурации,
			ИнформацияОПрограмме.ВерсияКонфигурации,
			ТекстПараметровТипаВзаимодействия);
		
	Иначе
		Шаблон = "
			|   <soapenv:Body xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/""
			|      xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01""
			|      xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""
			|      wsu:Id=""REGNO_%4"">
			|      <v01:putMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%5</software>
			|            <softwareVersion>%6</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>%7
			|         <messageType>%3</messageType>
			|         <messagePackageList>
			|            <messagePackage>
			|               <uuid>%8</uuid>
			|               <message>%2</message>
			|            </messagePackage>
			|         </messagePackageList>
			|      </v01:putMessageRequest>
			|   </soapenv:Body>";
		
		Текст = СтрШаблон(Шаблон,
			НастройкиВызова.ТипВзаимодействия,
			СообщениеBase64,
			ТипСообщения,
			РегистрационныйНомерФСС,
			ИнформацияОПрограмме.ИДКонфигурации,
			ИнформацияОПрограмме.ВерсияКонфигурации,
			ТекстПараметровТипаВзаимодействия,
			НастройкиВызова.ИдентификаторСообщенияСЭДО);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
			РегистрационныйНомерФСС,
			ДатаСообщений = Неопределено,
			Настройки = Неопределено) Экспорт
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
		РегистрационныйНомерФСС,
		ДатаСообщений,
		Настройки);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаИзДанныхПоАдресу(Адрес)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Чтение = Новый ЧтениеДанных(Данные);
		Результат = Чтение.ПрочитатьСимволы();
		Чтение.Закрыть();
	Иначе
		Результат = Данные;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция)
	
	Результат = ЭлектронныйДокументооборотСФССКлиентСервер.ПараметрыСохраненияЗапросаСЭДОФСС(
			Организация, Операция);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьДанныеЗапросаСЭДОФСС(ПараметрыСохранения)
	
	ЭлектронныйДокументооборотСФСС.СохранитьДанныеЗапросаСЭДО(ПараметрыСохранения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РегистрационныйНомерФССОрганизации(Организация)
	
	СвойстваОрганизацииДляОбмена = СвойстваОрганизацииДляОбмена(Организация);
	Возврат СвойстваОрганизацииДляОбмена.РегистрационныйНомерФСС;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыПакетногоПолученияИзСЭДО()
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьПакетноеПолучение", Ложь);
	Результат.Вставить("КоличествоСообщенийВПакете", 1);
	
	ДанныеСобытия = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступилоРасширенная(
		"Пакетное получение СЭДО");
	Если ДанныеСобытия.СобытиеНаступило Тогда
		Результат.ИспользоватьПакетноеПолучение = Истина;
		ГодОкончания = Год(ДанныеСобытия.ДатаОкончания);
		Год3000 = 3000;
		Если ГодОкончания > Год3000 Тогда
			Результат.КоличествоСообщенийВПакете = ГодОкончания - Год3000;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоСообщенийВПакетномЗапросеСЭДО()
	
	ПараметрыПолучения = ПараметрыПакетногоПолученияИзСЭДО();
	Если ПараметрыПолучения.ИспользоватьПакетноеПолучение Тогда
		Возврат ПараметрыПолучения.КоличествоСообщенийВПакете;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область АдресПодписанногоSOAPОперацииСЭДОФСС

&НаКлиенте
Асинх Процедура АдресПодписанногоSOAPОперацииСЭДОФСС(
		ВыполняемоеОповещение,
		ВыгрузкаЗапросаОперацииСЭДО,
		ЗашифроватьSOAP = Истина,
		ВозвращатьАдресПодписанногоЗапроса = Ложь,
		ЗадаватьВопросОТестовомСервере = Истина,
		СвойстваОбменаПоСЭДОЧерезОператора = Неопределено) Экспорт
	
	Организация = ВыгрузкаЗапросаОперацииСЭДО.Организация;
	
	ОрганизацияИспользуетОбменСФСС 						= Ложь;
	ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи 	= Ложь;
	НастроенОбменВУниверсальномФормате 					= Ложь;
	УчетнаяЗаписьДокументооборота 						= Неопределено;
	
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		Организация,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи,
		УчетнаяЗаписьДокументооборота);
		
	Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
		ТекстПредупреждения = НСтр("ru = 'По организации %1 не включена возможность электронного документооборота с ФСС.';
									|en = 'По организации %1 не включена возможность электронного документооборота с ФСС.'");
		ТекстПредупреждения = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстПредупреждения, Истина);
		ТекстПредупреждения = СтрШаблон(ТекстПредупреждения, Организация);
		Если НЕ НастроенОбменВУниверсальномФормате Тогда
			ПараметрыОбменаСФСС = ПараметрыОбменаСФСС(Организация);
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
				ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(ПараметрыОбменаСФСС);
		Иначе
			Ждать ПредупреждениеАсинх(ТекстПредупреждения);
		КонецЕсли;
		Результат = РезультатПолучитьДанныеСЭДОФССПослеПодписиSOAP();
		Результат.ОписаниеОшибки = ТекстПредупреждения;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ВыполнятьАвтонастройку = НастроенОбменВУниверсальномФормате И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапросаОперацииСЭДО", 		ВыгрузкаЗапросаОперацииСЭДО);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 					ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("ВозвращатьАдресПодписанногоЗапроса", 	ВозвращатьАдресПодписанногоЗапроса);
	ДополнительныеПараметры.Вставить("АдресПодписанногоЗапросаSOAP", 		Неопределено);
	ДополнительныеПараметры.Вставить("ЗадаватьВопросОТестовомСервере", 		ЗадаватьВопросОТестовомСервере);
	ДополнительныеПараметры.Вставить("ВыполнятьАвтонастройку", 				ВыполнятьАвтонастройку);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора",	СвойстваОбменаПоСЭДОЧерезОператора);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ВыполнятьАвтонастройку Тогда
		АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗаписьДокументооборота, , Оповещение, , , Истина);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"АдресПодписанногоSOAPОперацииСЭДОФССПослеПроверкиЛицензииИСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	Если ВходящийКонтекст.ВыполнятьАвтонастройку Тогда
		
		Организация = ВходящийКонтекст.ВыгрузкаЗапросаОперацииСЭДО.Организация;
		
		ПроверитьСертификатИЛицензию(
			ОписаниеОповещения, 
			Неопределено, 
			Организация, 
			"ФСС");
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПроверкиЛицензииИСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВыгрузкаЗапросаОперацииСЭДО 	= ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭДО;
	ЗашифроватьSOAP 				= ДополнительныеПараметры.ЗашифроватьSOAP;
	ЗадаватьВопросОТестовомСервере 	= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	
	ПространствоИменЗапроса = "http://www.fss.ru/integration/types/sedo/v01";
	ДобавляемыеАтрибутыЗапроса = "xmlns:ds=""http://www.w3.org/2000/09/xmldsig#"""
		+ " xmlns:v01=""" + ПространствоИменЗапроса + """"
		+ " xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
		+ " xmlns:wsse=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"""
		+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""";
	ДобавляемыеАтрибутыПодписи = "xmlns=""http://www.w3.org/2000/09/xmldsig#""";
	
	СкорректированнаяВыгрузкаЗапроса = СкорректироватьВыгрузкуЗапросаОперацииДляSOAPСЭДОФСС(
		ВыгрузкаЗапросаОперацииСЭДО.ТекстЗапроса,
		ПространствоИменЗапроса);
	
	Если ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора = Неопределено Тогда
		ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора =
			СвойстваОбменаПоСЭДОЧерезОператора(ВыгрузкаЗапросаОперацииСЭДО.Организация);
	КонецЕсли;
	
	НастройкиВызова = Новый Структура;
	Если ВыгрузкаЗапросаОперацииСЭДО.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		НастройкиВызова.Вставить("СодержимоеПодписанногоЗапросаSOAP",
			ВыгрузкаЗапросаОперацииСЭДО.СодержимоеПодписанногоЗапросаSOAP);
	КонецЕсли;
	РезультатИнициализации = АдресПодписанногоSOAPОперацииСЭДОФССИнициализацияНаСервере(
		ВыгрузкаЗапросаОперацииСЭДО.Организация,
		СкорректированнаяВыгрузкаЗапроса,
		ДобавляемыеАтрибутыЗапроса,
		ВыгрузкаЗапросаОперацииСЭДО.РегистрационныйНомерФСС,
		ЗашифроватьSOAP,
		ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора,
		НастройкиВызова);
	
	Если РезультатИнициализации = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗапроса", 			ДобавляемыеАтрибутыЗапроса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 			ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("СкорректированнаяВыгрузкаЗапроса", 	СкорректированнаяВыгрузкаЗапроса);
	ДополнительныеПараметры.Вставить("РезультатИнициализации", 				РезультатИнициализации);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеПредупрежденияПриТестовомРежиме",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если РезультатИнициализации.ТестовыйСерверФСССЭДО И ЗадаватьВопросОТестовомСервере Тогда
		ТекстВопроса = НСтр("ru = 'Внимание! Включен режим тестирования СЭДО!
			|
			|В режиме тестирования обмен выполняется через тестовый шлюз СЭДО ФСС.
			|Данные не соответствуют действительности и не засчитываются ФСС.
			|
			|Продолжить обмен?';
			|en = 'Внимание! Включен режим тестирования СЭДО!
			|
			|В режиме тестирования обмен выполняется через тестовый шлюз СЭДО ФСС.
			|Данные не соответствуют действительности и не засчитываются ФСС.
			|
			|Продолжить обмен?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПредупрежденияПриТестовомРежиме(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыгрузкаЗапросаОперацииСЭДО 		= ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭДО;
	ЗашифроватьSOAP 					= ДополнительныеПараметры.ЗашифроватьSOAP;
	ДобавляемыеАтрибутыЗапроса 			= ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СкорректированнаяВыгрузкаЗапроса 	= ДополнительныеПараметры.СкорректированнаяВыгрузкаЗапроса;
	РезультатИнициализации 				= ДополнительныеПараметры.РезультатИнициализации;
	ВозвращатьАдресПодписанногоЗапроса 	= ДополнительныеПараметры.ВозвращатьАдресПодписанногоЗапроса;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		РезультатДляВозврата = Новый Структура;
		РезультатДляВозврата.Вставить("ОтмененоПользователем", Истина);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатДляВозврата);
		Возврат;
	КонецЕсли;
	
	ЗапросОперацииСЭДО64 = РезультатИнициализации.ЗапросОперацииСЭДО64;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РезультатИнициализации);
	УчетнаяЗапись = РезультатИнициализации.УчетнаяЗапись;
	
	СертификатСтрахователяОтпечаток = РезультатИнициализации.СертификатСтрахователяОтпечаток;
	СертификатСтрахователя 			= РезультатИнициализации.СертификатСтрахователя;
	СертификатФСССЭДООтпечаток 		= РезультатИнициализации.СертификатФСССЭДООтпечаток;
	СертификатФСССЭДО 				= РезультатИнициализации.СертификатФСССЭДО;
	МЧД 							= РезультатИнициализации.МЧД;
	ОбменПоСЭДОНапрямую 			= СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	ИдентификаторАбонентаСЭДО 		= СвойстваОбменаПоСЭДОЧерезОператора.ИдентификаторАбонентаСЭДО;
	
	Если ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭДО.Свойство("ОтпечатокСертификатаПодписанта") Тогда
		СертификатСтрахователяОтпечаток = ДополнительныеПараметры.ВыгрузкаЗапросаОперацииСЭДО.ОтпечатокСертификатаПодписанта;
		СертификатСтрахователя = Неопределено;
	КонецЕсли;
	
	СодержимоеСообщения = ?(ВыгрузкаЗапросаОперацииСЭДО.Свойство("СодержимоеСообщения"),
		ВыгрузкаЗапросаОперацииСЭДО.СодержимоеСообщения, Неопределено);
	ИдентификаторРодителя = ?(ВыгрузкаЗапросаОперацииСЭДО.Свойство("ИдентификаторРодителя"),
		ВыгрузкаЗапросаОперацииСЭДО.ИдентификаторРодителя, Неопределено);
	
	// Заново создаем структуру параметров.
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", 			ВыгрузкаЗапросаОперацииСЭДО.РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ВыгрузкаЗапроса", 					СкорректированнаяВыгрузкаЗапроса);
	ДополнительныеПараметры.Вставить("СертификатФСССЭДООтпечаток", 			СертификатФСССЭДООтпечаток);
	ДополнительныеПараметры.Вставить("СертификатФСССЭДО", 					СертификатФСССЭДО);
	ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
	ДополнительныеПараметры.Вставить("ОбменПоСЭДОНапрямую", 				ОбменПоСЭДОНапрямую);
	ДополнительныеПараметры.Вставить("ИдентификаторАбонентаСЭДО", 			ИдентификаторАбонентаСЭДО);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 					ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗапроса", 			ДобавляемыеАтрибутыЗапроса);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 			ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("ЗапросОперацииСЭДО64", 				ЗапросОперацииСЭДО64);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", 						УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("АдресПодписанногоЗапросаSOAP", 		Неопределено);
	ДополнительныеПараметры.Вставить("ВозвращатьАдресПодписанногоЗапроса", 	ВозвращатьАдресПодписанногоЗапроса);
	ДополнительныеПараметры.Вставить("СодержимоеСообщения", 				СодержимоеСообщения);
	ДополнительныеПараметры.Вставить("ИдентификаторРодителя", 				ИдентификаторРодителя);
	Если ВыгрузкаЗапросаОперацииСЭДО.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		ДополнительныеПараметры.Вставить("СодержимоеПодписанногоЗапросаSOAP",
			ВыгрузкаЗапросаОперацииСЭДО.СодержимоеПодписанногоЗапросаSOAP);
	КонецЕсли;
	Если ВыгрузкаЗапросаОперацииСЭДО.Свойство("ОтпечатокСертификатаПодписанта") Тогда
		ДополнительныеПараметры.Вставить("ОтпечатокСертификатаПодписанта",
			ВыгрузкаЗапросаОперацииСЭДО.ОтпечатокСертификатаПодписанта);
	КонецЕсли;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеПоискаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ДополнительныеПараметры.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Ложь, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	ИначеЕсли НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) И СертификатСтрахователя <> Неопределено Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Истина, СертификатСтрахователя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатСтрахователяОтпечаток, "MY");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПоискаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатФСССЭДООтпечаток = ДополнительныеПараметры.СертификатФСССЭДООтпечаток;
	СертификатФСССЭДО = ДополнительныеПараметры.СертификатФСССЭДО;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХранененияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", СертификатСтрахователя);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеПоискаСертификатаФСС",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХранененияКлюча) Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("Выполнено", Истина);
		РезультатВыполнения.Вставить("МенеджерКриптографии", Неопределено);
		РезультатВыполнения.Вставить("СертификатНайден", ЗашифроватьSOAP);
		РезультатВыполнения.Вставить("СвойстваСертификата", СертификатФСССЭДО);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатФСССЭДООтпечаток, "AddressBook");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПоискаСертификатаФСС(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 	= ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP 		= ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча 		= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	УчетнаяЗапись 			= ДополнительныеПараметры.УчетнаяЗапись;
	ОбменПоСЭДОНапрямую 	= ДополнительныеПараметры.ОбменПоСЭДОНапрямую;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатФСССЭДО = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	СертификатыОбмена = Новый СписокЗначений();
	Если НЕ ДополнительныеПараметры.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		СертификатыОбмена.Добавить(СертификатСтрахователя, НСтр("ru = 'Сертификат страхователя';
																|en = 'Сертификат страхователя'"));
	КонецЕсли;
	Если ЗашифроватьSOAP И ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") <> Истина Тогда
		Если ОбменПоСЭДОНапрямую Тогда
			СертификатыОбмена.Добавить(СертификатФСССЭДО, НСтр("ru = 'Сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО';
																|en = 'Сертификат шифрования ЭЛН, ПОВЭД, ССВ, СЭДО'"));
		Иначе
			СертификатыОбмена.Добавить(СертификатФСССЭДО, НСтр("ru = 'Сертификат сервера документооборота учетной записи';
																|en = 'Сертификат сервера документооборота учетной записи'"));
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СертификатФСССЭДО", СертификатФСССЭДО);
	
	Если ДополнительныеПараметры.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		// подписание уже выполнено
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
		
		СодержимоеПодписанногоЗапросаSOAP = ДополнительныеПараметры.СодержимоеПодписанногоЗапросаSOAP;
		
		ПодписанноеСообщение64 = "";
		ПрефиксСодержимого = "<message>";
		ПозицияСодержимого = СтрНайти(СодержимоеПодписанногоЗапросаSOAP, ПрефиксСодержимого);
		Если ПозицияСодержимого <> 0 Тогда
			ПозицияСодержимого = ПозицияСодержимого + СтрДлина(ПрефиксСодержимого);
			ПодписанноеСообщение64 = Сред(СодержимоеПодписанногоЗапросаSOAP, ПозицияСодержимого);
			ПозицияЗавершения = СтрНайти(ПодписанноеСообщение64, "</message>");
			Если ПозицияЗавершения <> 0 Тогда
				ПодписанноеСообщение64 = Лев(ПодписанноеСообщение64, ПозицияЗавершения - 1);
			КонецЕсли;
			ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ПС, "");
			ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ВК, "");
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ПодписанноеСообщение64", ПодписанноеСообщение64);
		
		ДанныеПодписанногоЗапросаSOAP = ПолучитьДвоичныеДанныеИзСтроки(СодержимоеПодписанногоЗапросаSOAP, "utf-8");
		
		Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			СодержимоеПодписанногоЗапросаSOAP64 = Base64Строка(ДанныеПодписанногоЗапросаSOAP);
			СодержимоеПодписанногоЗапросаSOAP64 = СтрЗаменить(СодержимоеПодписанногоЗапросаSOAP64, Символы.ПС, "");
			СодержимоеПодписанногоЗапросаSOAP64 = СтрЗаменить(СодержимоеПодписанногоЗапросаSOAP64, Символы.ВК, "");
			РезультатОперации = СодержимоеПодписанногоЗапросаSOAP64;
		Иначе
			РезультатОперации = ПоместитьВоВременноеХранилище(ДанныеПодписанногоЗапросаSOAP, Новый УникальныйИдентификатор);
		КонецЕсли;
		
		АдресПодписанногоSOAPОперацииСЭДОФССПослеПолученияАдресаЗапроса(РезультатОперации, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЭкспортаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатСтрахователя);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЭкспортаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча 		= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ЗапросОперацииСЭДО64 	= ДополнительныеПараметры.ЗапросОперацииСЭДО64;
	СодержимоеСообщения 	= ДополнительныеПараметры.СодержимоеСообщения;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателя64 = Результат.СтрокаBase64;
	
	ДополнительныеПараметры.Вставить("СертификатПолучателя64", СертификатПолучателя64);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайлаСообщения",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если СодержимоеСообщения <> Неопределено Тогда
		ДанныеСообщения = ПолучитьДвоичныеДанныеИзСтроки(СодержимоеСообщения, "utf-8");
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			АдресСообщения = ПоместитьВоВременноеХранилище(ДанныеСообщения, Новый УникальныйИдентификатор);
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, АдресСообщения);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Иначе
			СодержимоеСообщенияВBase64 = Base64Строка(ДанныеСообщения);
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СодержимоеСообщенияВBase64);
		КонецЕсли;
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайлаСообщения(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 	= ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	СодержимоеСообщения 	= ДополнительныеПараметры.СодержимоеСообщения;
	ИдентификаторРодителя 	= ДополнительныеПараметры.ИдентификаторРодителя;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлСообщения = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлСообщения", ФайлСообщения);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеПодписиСообщения",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если СодержимоеСообщения <> Неопределено Тогда
		НастройкиПодписи = Новый Структура;
		НастройкиПодписи.Вставить("ЭтоИсключающаяКанонизация", 						Истина);
		НастройкиПодписи.Вставить("ДополнитьПространстваИменУзлаПодписи", 			Истина);
		НастройкиПодписи.Вставить("ТипКаноническогоXML", 							"КаноническийXML1_1");
		НастройкиПодписи.Вставить("ИспользоватьПреобразованиеККаноническомуXML", 	Истина);
		НастройкиПодписи.Вставить("КанонизацияБезКомментариев", 					Истина);
		НастройкиПодписи.Вставить("ПрефиксПодписи", 								"ds");
		НастройкиПодписи.Вставить("ДополнительноеПространствоИмен", 				"http://www.fss.ru/integration/types/common/v01");
		НастройкиПодписи.Вставить("ДобавитьШтампВремени", 							Истина);
		НастройкиПодписи.Вставить("ИдентификаторРодителя", 							ИдентификаторРодителя);
		ПодписатьФайлXMLDSig(
			СертификатСтрахователя,
			ФайлСообщения,
			Оповещение,,,
			НастройкиПодписи);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПодписиСообщения(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча 		= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СодержимоеСообщения 	= ДополнительныеПараметры.СодержимоеСообщения;
	ФайлСообщения 			= ДополнительныеПараметры.ФайлСообщения;
	ЛокальнаяПодпись 		= ЭтоЛокальнаяПодпись(МестоХраненияКлюча);
	
	Если ЗначениеЗаполнено(ФайлСообщения) Тогда
		Если НЕ ЛокальнаяПодпись Тогда
			УдалитьИзВременногоХранилища(ФайлСообщения);
		Иначе
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если ПолноеИмяПодписанногоФайла = Неопределено И СодержимоеСообщения <> Неопределено Тогда
		ОписаниеОшибки = НСтр("ru = 'Не удалось подписать файл СЭДО.';
								|en = 'Не удалось подписать файл СЭДО.'");
		ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ОписаниеОшибки, ПараметрыВывода);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлПодписанногоСообщения", ПолноеИмяПодписанногоФайла);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЧтенияФайлаСообщения",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если СодержимоеСообщения = Неопределено Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	ИначеЕсли НЕ ЛокальнаяПодпись Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЧтенияФайлаСообщения(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча 			= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ЗапросОперацииСЭДО64 		= ДополнительныеПараметры.ЗапросОперацииСЭДО64;
	СодержимоеСообщения 		= ДополнительныеПараметры.СодержимоеСообщения;
	ФайлПодписанногоСообщения 	= ДополнительныеПараметры.ФайлПодписанногоСообщения;
	ЛокальнаяПодпись 			= ЭтоЛокальнаяПодпись(МестоХраненияКлюча);
	
	Если ЛокальнаяПодпись Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписанногоСообщения);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПодписанноеСообщение64 = Результат.СтрокаBase64;
	
	Если СодержимоеСообщения <> Неопределено Тогда
		Если НЕ ЛокальнаяПодпись Тогда
			ПодставитьСообщениеВТекстЗапросаОперацииСЭДОФСС(
				ЗапросОперацииСЭДО64,
				ДополнительныеПараметры.ВыгрузкаЗапроса,
				ПодписанноеСообщение64);
			
		Иначе
			ДанныеЗапросаОперации = Base64Значение(ЗапросОперацииСЭДО64);
			ТекстЗапросаОперации = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЗапросаОперации, "utf-8");
			
			ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ВК, "");
			ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ПС, "");
			ТекстЗапросаОперации = СтрЗаменить(ТекстЗапросаОперации, "%Message%", ПодписанноеСообщение64);
			ДополнительныеПараметры.ВыгрузкаЗапроса = СтрЗаменить(ДополнительныеПараметры.ВыгрузкаЗапроса,
				"%Message%", ПодписанноеСообщение64);
			
			ДанныеЗапросаОперации = ПолучитьДвоичныеДанныеИзСтроки(ТекстЗапросаОперации, "utf-8");
			ЗапросОперацииСЭДО64 = Base64Строка(ДанныеЗапросаОперации);
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПодписанноеСообщение64",
		?(СодержимоеСообщения = Неопределено, "", ПодписанноеСообщение64));
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайла",
		ЭтотОбъект, ДополнительныеПараметры);
		
	Если НЕ ЛокальнаяПодпись Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ЗапросОперацииСЭДО64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗапросОперацииСЭДО64);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодставитьСообщениеВТекстЗапросаОперацииСЭДОФСС(
		АдресЗапросаОперации,
		ВыгрузкаЗапроса,
		ПодписанноеСообщение64)
	
	ДанныеЗапросаОперации = ПолучитьИзВременногоХранилища(АдресЗапросаОперации);
	УдалитьИзВременногоХранилища(АдресЗапросаОперации);
	ТекстЗапросаОперации = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЗапросаОперации, "utf-8");
	
	ДанныеПодписанногоСообщения = ПолучитьИзВременногоХранилища(ПодписанноеСообщение64);
	УдалитьИзВременногоХранилища(ПодписанноеСообщение64);
	ПодписанноеСообщение64 = Base64Строка(ДанныеПодписанногоСообщения);
	ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ВК, "");
	ПодписанноеСообщение64 = СтрЗаменить(ПодписанноеСообщение64, Символы.ПС, "");
	ТекстЗапросаОперации = СтрЗаменить(ТекстЗапросаОперации, "%Message%", ПодписанноеСообщение64);
	ВыгрузкаЗапроса = СтрЗаменить(ВыгрузкаЗапроса, "%Message%", ПодписанноеСообщение64);
	
	ДанныеЗапросаОперации = ПолучитьДвоичныеДанныеИзСтроки(ТекстЗапросаОперации, "utf-8");
	АдресЗапросаОперации = ПоместитьВоВременноеХранилище(ДанныеЗапросаОперации, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗапроса = ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлЗапросаОперацииСЭДО = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлЗапросаОперацииСЭДО", ФайлЗапросаОперацииСЭДО);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеПодписания", ЭтотОбъект, ДополнительныеПараметры);
	
	ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи
		+ ?(ДобавляемыеАтрибутыПодписи <> "" И ДобавляемыеАтрибутыЗапроса <> "", " ", "")
		+ ДобавляемыеАтрибутыЗапроса;
	ИдентификаторПодписываемыхДанных = "REGNO_" + РегистрационныйНомерФСС;
	
	НастройкиПодписи = Новый Структура;
	НастройкиПодписи.Вставить("Трансформация1_1", 						Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 				Ложь);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 				Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 						Неопределено);
	НастройкиПодписи.Вставить("НормализацияОтключена", 					Истина);
	НастройкиПодписи.Вставить("ДанныеВнутриПодписи", 					Истина);
	НастройкиПодписи.Вставить("ИдентификаторПодписываемыхДанных", 		ИдентификаторПодписываемыхДанных);
	НастройкиПодписи.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибутыПодписиИЗаписи);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОСертификате", 		Ложь);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОбОбъекте", 			Истина);
	НастройкиПодписи.Вставить("ДополнительныеТрансформации", 			Неопределено);
	НастройкиПодписи.Вставить("ДополнительныеОбратныеТрансформации", 	Неопределено);
	НастройкиПодписи.Вставить("ЭтоИсключающаяКанонизация",				Истина);
	НастройкиПодписи.Вставить("ИспользуетсяУзелТрансформации",			Истина);
	НастройкиПодписи.Вставить("ТипКаноническогоXML",					?(ДополнительныеПараметры.ОбменПоСЭДОНапрямую,
																			"ИсключающийКаноническийXMLСКомментариями",
																			"ИсключающийКаноническийXML"));
	НастройкиПодписи.Вставить("ИспользоватьПреобразованиеККаноническомуXML",			Истина);
	
	ПодписатьФайлXMLDSig(
		СертификатСтрахователя,
		ФайлЗапросаОперацииСЭДО,
		Оповещение,,,
		НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПодписания(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ФайлЗапросаОперацииСЭДО = ДополнительныеПараметры.ФайлЗапросаОперацииСЭДО;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ФайлЗапросаОперацииСЭДО);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлЗапросаОперацииСЭДО);
	КонецЕсли;
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ОписаниеОшибки = НСтр("ru = 'Не удалось подписать файл запроса СЭДО.';
								|en = 'Не удалось подписать файл запроса СЭДО.'");
		ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ОписаниеОшибки, ПараметрыВывода);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлПодписиЗапросаОперацииСЭДО", ПолноеИмяПодписанногоФайла);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЧтенияФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЧтенияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЗапроса = ДополнительныеПараметры.ВыгрузкаЗапроса;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗапроса = ДополнительныеПараметры.ДобавляемыеАтрибутыЗапроса;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	ФайлПодписиЗапросаОперацииСЭДО = ДополнительныеПараметры.ФайлПодписиЗапросаОперацииСЭДО;
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписиЗапросаОперацииСЭДО);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписиЗапросаОперацииСЭДО64 = Результат.СтрокаBase64;
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыЗапроса", 	ДобавляемыеАтрибутыЗапроса);
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыПодписи", 	ДобавляемыеАтрибутыПодписи);
	НастройкиОперации.Вставить("ВозвращатьТекстВBase64", 		ЗашифроватьSOAP);
	НастройкиОперации.Вставить("МЧД", 							ДополнительныеПараметры.МЧД);
	НастройкиОперации.Вставить("ОбменПоСЭДОНапрямую", 			ДополнительныеПараметры.ОбменПоСЭДОНапрямую);
	НастройкиОперации.Вставить("ИдентификаторАбонентаСЭДО", 	ДополнительныеПараметры.ИдентификаторАбонентаСЭДО);
	РезультатОперации = АдресSOAPЗапросОперацииСЭДОФССПоПодписиНаСервере(
		РегистрационныйНомерФСС,
		ВыгрузкаЗапроса,
		ФайлПодписиЗапросаОперацииСЭДО64,
		СертификатПолучателя64,
		НастройкиОперации);
	
	АдресПодписанногоSOAPОперацииСЭДОФССПослеПолученияАдресаЗапроса(РезультатОперации, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайлаПодписанногоSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФСССЭДО 					= ДополнительныеПараметры.СертификатФСССЭДО;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресПодписанногоЗапросаSOAP 		= ДополнительныеПараметры.АдресПодписанногоЗапросаSOAP;
	ВозвращатьАдресПодписанногоЗапроса 	= ДополнительныеПараметры.ВозвращатьАдресПодписанногоЗапроса;
	ПодписанноеСообщение64 				= ДополнительныеПараметры.ПодписанноеСообщение64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлПодписанногоSOAP = Результат.ИмяФайла;
	
	ШаблонЗапросаSOAP =
		"<SOAP-ENV:Envelope xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"">
		|	<SOAP-ENV:Header/>
		|	<SOAP-ENV:Body>
		|%1
		|	</SOAP-ENV:Body>
		|</SOAP-ENV:Envelope>";
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ШаблонЗапросаSOAP", 								ШаблонЗапросаSOAP);
	НастройкиОперации.Вставить("ПоместитьВУзелX509CertificateСертификатПолучателя", Истина);
	НастройкиОперации.Вставить("АдресПодписанногоЗапросаSOAP", 						АдресПодписанногоЗапросаSOAP);
	НастройкиОперации.Вставить("ВозвращатьАдресПодписанногоЗапроса", 				ВозвращатьАдресПодписанногоЗапроса);
	НастройкиОперации.Вставить("СценарийФСС", 										Истина);
	НастройкиОперации.Вставить("ПодписанноеСообщение64", 							ПодписанноеСообщение64);
	
	Если ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") = Истина Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("АдресЗашифрованногоЗапросаSOAP", 	Неопределено);
		РезультатВыполнения.Вставить("АдресПодписаногоЗапросаSOAP", 	АдресПодписанногоЗапросаSOAP);
		РезультатВыполнения.Вставить("ПодписанноеСообщение64", 			ПодписанноеСообщение64);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		
	Иначе
		Если ДополнительныеПараметры.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
			СертификатСтрахователя = СертификатФСССЭДО;
		КонецЕсли;
		ЗашифроватьФайлXML(
			СертификатФСССЭДО,
			СертификатСтрахователя,
			ФайлПодписанногоSOAP,
			ВыполняемоеОповещение,,
			Истина,
			НастройкиОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPОперацииСЭДОФССПослеПолученияАдресаЗапроса(РезультатОперации, ДополнительныеПараметры)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если ЭтоАдресВременногоХранилища(РезультатОперации) Тогда
		ДополнительныеПараметры.АдресПодписанногоЗапросаSOAP = РезультатОперации;
	Иначе
		ДополнительныеПараметры.АдресПодписанногоЗапросаSOAP =
			ПоместитьВоВременноеХранилище(Base64Значение(РезультатОперации),
				Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если НЕ ДополнительныеПараметры.ЗашифроватьSOAP Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, РезультатОперации);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPОперацииСЭДОФССПослеЗаписиФайлаПодписанногоSOAP",
			ЭтотОбъект, ДополнительныеПараметры);
		
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
				Истина, Неопределено, РезультатОперации);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПолучитьДанныеСЭДОФСС

&НаКлиенте
Функция РезультатПолучитьДанныеСЭДОФССПослеПодписиSOAP()
	
	Результат = Новый Структура;
	Результат.Вставить("АдресПодписаногоЗапросаSOAP", "");
	Результат.Вставить("АдресЗашифрованногоЗапросаSOAP", "");
	Результат.Вставить("ПодписанноеСообщение64", "");
	Результат.Вставить("ОписаниеОшибки", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыЗапросаПолучитьДанныеСЭДОФСС()
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Операция", "");
	Результат.Вставить("ТекстЗапроса", "");
	Результат.Вставить("ИдентификаторыСообщений", Новый Массив);
	Результат.Вставить("РезультатФоновойЗагрузки", Неопределено);
	Результат.Вставить("ТипыСообщений", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьДанныеСЭДОФСС(
		ВыполняемоеОповещение,
		ЗапросПолученияДанных,
		ЗадаватьВопросОТестовомСервере = Истина,
		ТипВзаимодействия = Неопределено,
		ОтображатьСостояние = Истина,
		СвойстваОбменаПоСЭДОЧерезОператора = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат = РезультатПолучитьДанныеСЭДОФСС();
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	Операция = ЗапросПолученияДанных.Операция;
	Организация = ЗапросПолученияДанных.Организация;
	РегистрационныйНомерФСС = РегистрационныйНомерФССОрганизации(Организация);
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Результат.ОписаниеОшибки = НСтр("ru = 'Не указана организация.';
										|en = 'Не указана организация.'");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(РегистрационныйНомерФСС) Тогда
		Шаблон = НСтр("ru = 'Не указан регистрационный номер ФСС организации %1.';
						|en = 'Не указан регистрационный номер ФСС организации %1.'");
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, Организация);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	РезультатПроверкиРегистрационногоНомераФСС = ПроверитьДлинуРегистрационныйНомерФСС(
		Результат,
		ТипВзаимодействия,
		Организация);
	Если НЕ РезультатПроверкиРегистрационногоНомераФСС Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		Организация);
	ДополнительныеПараметры.Вставить("Операция", 				Операция);
	ДополнительныеПараметры.Вставить("Результат", 				Результат);
	ДополнительныеПараметры.Вставить("ОшибкаОтправкиНаСервер", 	Ложь);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 		ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("ПодписанноеСообщение64", 	"");
	ДополнительныеПараметры.Вставить("РезультатФоновойЗагрузки", Неопределено);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние", 	ОтображатьСостояние);
	ДополнительныеПараметры.Вставить("ИдентификаторыСообщений", ЗапросПолученияДанных.ИдентификаторыСообщений);
	
	Если ТипЗнч(ВыполняемоеОповещение.ДополнительныеПараметры) = Тип("Структура")
		И ВыполняемоеОповещение.ДополнительныеПараметры.Свойство("ТипСообщенияОтвета") Тогда
		ДополнительныеПараметры.Вставить("ТипСообщенияОтвета",
			ВыполняемоеОповещение.ДополнительныеПараметры.ТипСообщенияОтвета);
	КонецЕсли;
	
	Если СвойстваОбменаПоСЭДОЧерезОператора = Неопределено Тогда
		СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора", СвойстваОбменаПоСЭДОЧерезОператора);
	
	РезультатФоновойЗагрузки = Неопределено;
	Если ЗапросПолученияДанных.Свойство("РезультатФоновойЗагрузки", РезультатФоновойЗагрузки)
		И ЗначениеЗаполнено(РезультатФоновойЗагрузки) Тогда
		// Данные были получены в фоновом задании, требуется расшифровка.
		ДополнительныеПараметры.РезультатФоновойЗагрузки = РезультатФоновойЗагрузки;
		АдресЗашифрованногоОтветаSOAP = РезультатФоновойЗагрузки.АдресЗашифрованногоОтветаSOAP;
		РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(Организация);
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
		
		ТекстОтвета = ПолучитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			ДанныеОтвета = ПолучитьДвоичныеДанныеИзСтроки(ТекстОтвета, "windows-1251");
			АдресЗашифрованногоОтветаSOAP = ПоместитьВоВременноеХранилище(ДанныеОтвета, Новый УникальныйИдентификатор);;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат, РезультатФоновойЗагрузки);
		Результат.АдресПодписаногоЗапросаSOAP = РезультатФоновойЗагрузки.АдресПодписаногоЗапросаSOAP;
		Результат.ОтветПолученФоновымЗаданием = Истина;
		Расшифровать =  Найти(ТекстОтвета, "<xenc:EncryptedData") > 0;
		Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеСЭДОФССПослеПроверкиПодписиSOAP",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПроверитьПодписьSOAPОтветаЭЛНВФСС(
			Оповещение,
			Организация,
			АдресЗашифрованногоОтветаSOAP,
			Расшифровать, , ,
			Истина);
		Возврат;
	КонецЕсли;
	
	ПодписатьSOAP = Истина;
	ЗашифроватьSOAP = Истина;
	
	Если Операция = ОперацияПолученияСпискаВходящихСЭДОФСС() Тогда
		ПодписатьSOAP = Ложь;
		ЗашифроватьSOAP = Ложь;
	КонецЕсли;
	
	ВыгрузкаЗапросаОперацииСЭДО = ОбщегоНазначенияКлиентСервер.
		СкопироватьСтруктуру(ЗапросПолученияДанных);
	ВыгрузкаЗапросаОперацииСЭДО.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	Если ВыгрузкаЗапросаОперацииСЭДО.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		ДополнительныеПараметры.Вставить("СодержимоеПодписанногоЗапросаSOAP",
			ВыгрузкаЗапросаОперацииСЭДО.СодержимоеПодписанногоЗапросаSOAP);
	КонецЕсли;
	
	ДополнительныеПараметрыОповещения = ВыполняемоеОповещение.ДополнительныеПараметры;
	Если ТипЗнч(ДополнительныеПараметрыОповещения) = Тип("Структура")
		И ДополнительныеПараметрыОповещения.Свойство("ОтображатьСостояние") Тогда
		
		ОтображатьСостояние = ДополнительныеПараметрыОповещения.ОтображатьСостояние;
		
	КонецЕсли;
	
	Если ОтображатьСостояние Тогда
		Состояние(НСтр("ru = 'СЭДО СФР';
						|en = 'СЭДО СФР'"), , НСтр("ru = 'Формирование запроса для сервера...';
													|en = 'Формирование запроса для сервера...'"));
	КонецЕсли;
	
	Если ПодписатьSOAP Тогда
		
		// Подписание запроса.
		Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеСЭДОФССПослеПодписиSOAP",
			ЭтотОбъект,
			ДополнительныеПараметры);
		АдресПодписанногоSOAPОперацииСЭДОФСС(
			Оповещение,
			ВыгрузкаЗапросаОперацииСЭДО,
			ЗашифроватьSOAP,
			Истина,
			ЗадаватьВопросОТестовомСервере,
			СвойстваОбменаПоСЭДОЧерезОператора);
		Возврат;
		
	Иначе
		
		АдресПодписаного = ПоместитьВоВременноеХранилище(
			ВыгрузкаЗапросаОперацииСЭДО.ТекстЗапроса,
			Новый УникальныйИдентификатор);
			
		Результат = РезультатПолучитьДанныеСЭДОФССПослеПодписиSOAP();
		Результат.АдресПодписаногоЗапросаSOAP = АдресПодписаного;
		Результат.АдресЗашифрованногоЗапросаSOAP = АдресПодписаного;
		ПолучитьДанныеСЭДОФССПослеПодписиSOAP(Результат, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеСЭДОФССПослеПодписиSOAP(
	РезультатПодписиШифрования,
	ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 					= ДополнительныеПараметры.ОрганизацияСсылка;
	Операция 							= ДополнительныеПараметры.Операция;
	Результат 							= ДополнительныеПараметры.Результат;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	ИдентификаторыСообщений 			= ДополнительныеПараметры.ИдентификаторыСообщений;
	
	Если ДополнительныеПараметры.Свойство("ОтображатьСостояние") Тогда
		ОтображатьСостояние		= ДополнительныеПараметры.ОтображатьСостояние;
	Иначе
		ОтображатьСостояние		= Истина;
	КонецЕсли;
	
	ОписаниеОшибки = "";
	Если ЗначениеЗаполнено(РезультатПодписиШифрования)
		И РезультатПодписиШифрования.Свойство("ОписаниеОшибки") Тогда
		ОписаниеОшибки = РезультатПодписиШифрования.ОписаниеОшибки;
	КонецЕсли;
	
	ОтмененоПользователем = ЗначениеЗаполнено(РезультатПодписиШифрования)
		И РезультатПодписиШифрования.Свойство("ОтмененоПользователем")
		И РезультатПодписиШифрования.ОтмененоПользователем;
	
	Если НЕ ЗначениеЗаполнено(РезультатПодписиШифрования)
		ИЛИ ОтмененоПользователем
		ИЛИ НЕ ПустаяСтрока(ОписаниеОшибки) Тогда
			Если ОтмененоПользователем Тогда
				Результат.ОписаниеОшибки = НСтр("ru = 'Операция была отменена пользователем.';
												|en = 'Операция была отменена пользователем.'");
				Результат.ОтмененоПользователем = Истина;
			ИначеЕсли НЕ ПустаяСтрока(ОписаниеОшибки) Тогда
				Результат.ОписаниеОшибки = ОписаниеОшибки;
			Иначе
				Результат.ОписаниеОшибки =
					НСтр("ru = 'Произошла ошибка при выполнении криптоопераций над запросом к серверу СЭДО. Подробности см. в журнале регистрации.';
						|en = 'Произошла ошибка при выполнении криптоопераций над запросом к серверу СЭДО. Подробности см. в журнале регистрации.'");
			КонецЕсли;
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
	КонецЕсли;
	
	ПодписанноеСообщение64 = ?(РезультатПодписиШифрования.Свойство("ПодписанноеСообщение64"),
		РезультатПодписиШифрования.ПодписанноеСообщение64, "");
	ДополнительныеПараметры.Вставить("ПодписанноеСообщение64", ПодписанноеСообщение64);
	
	Если ОтображатьСостояние Тогда
		Состояние(НСтр("ru = 'СЭДО СФР';
						|en = 'СЭДО СФР'"), , НСтр("ru = 'Получение данных с сервера...';
													|en = 'Получение данных с сервера...'"));
	КонецЕсли;
	
	// Отправка запроса.
	МЧДТолькоПодписание = (ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") = Истина);
	Если МЧДТолькоПодписание Тогда
		РезультатОтправки = Новый Структура;
		РезультатОтправки.Вставить("АдресЗашифрованногоОтветаSOAP", 				Неопределено);
		РезультатОтправки.Вставить("АдресЗашифрованногоОтветаSOAPДвоичныеДанные", 	Неопределено);
		РезультатОтправки.Вставить("АдресРесурса", 									"");
		РезультатОтправки.Вставить("АдресСервера", 									"");
		РезультатОтправки.Вставить("КодСостояния", 									0);
		РезультатОтправки.Вставить("ОшибкаСоединения", 								Ложь);
		РезультатОтправки.Вставить("Выполнено", 									Истина);
		РезультатОтправки.Вставить("ТребуетсяРасшифровкаОтвета", 					Ложь);
		
	Иначе
		РезультатОтправки = ОтправитьЗапросСервисуСЭДОФССНаСервере(
			ОрганизацияСсылка,
			Операция,
			РезультатПодписиШифрования.АдресЗашифрованногоЗапросаSOAP,
			СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
	КонецЕсли;
	
	АдресПодписаногоЗапросаSOAP = РезультатПодписиШифрования.АдресПодписаногоЗапросаSOAP;
	АдресЗашифрованногоОтветаSOAP = РезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	АдресЗашифрованногоОтветаSOAPДвоичныеДанные = РезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные;
	
	Результат.АдресПодписаногоЗапросаSOAP = АдресПодписаногоЗапросаSOAP;
	Результат.АдресРасшифрованногоОтветаSOAP = АдресЗашифрованногоОтветаSOAP;
	Результат.АдресРесурса = РезультатОтправки.АдресРесурса;
	Результат.АдресСервера = РезультатОтправки.АдресСервера;
	Результат.КодСостояния = РезультатОтправки.КодСостояния;
	Результат.АдресЗашифрованногоЗапросаSOAP = РезультатПодписиШифрования.АдресЗашифрованногоЗапросаSOAP;
	Результат.ОшибкаСоединения = РезультатОтправки.ОшибкаСоединения;
	
	Если НЕ РезультатОтправки.Выполнено Тогда
		
		Если РезультатОтправки.ТребуетсяРасшифровкаОтвета Тогда
			
			// Необходимо расшифровать ответ сервера.
			ДополнительныеПараметры.ОшибкаОтправкиНаСервер = Истина;
			
		Иначе
			
			Если НЕ РезультатОтправки.ОшибкаСоединения Тогда
				
				// Разбираем текст ошибки.
				РезультатРазбора = РазобратьОшибкуСервераСЭДОФСС(
					ПолучитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP));
				Если РезультатРазбора.Выполнено Тогда
					ОписаниеОшибки = РезультатРазбора.ОписаниеОшибки;
				Иначе
					ОписаниеОшибки = РезультатОтправки.ОписаниеОшибки;
				КонецЕсли;
				
				УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAPДвоичныеДанные);
				
			Иначе
				
				ОписаниеОшибки = РезультатОтправки.ОписаниеОшибки;
				
			КонецЕсли;
			
			// Сохраняем данные запроса в случае ошибки.
			ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(ОрганизацияСсылка, Операция);
			ПараметрыЗапроса.ОписаниеОшибки 		= ОписаниеОшибки;
			ПараметрыЗапроса.АдресЗапросаSOAP 		= АдресПодписаногоЗапросаSOAP;
			Если НЕ РезультатОтправки.ОшибкаСоединения
				ИЛИ ЭтоАдресВременногоХранилища(АдресЗашифрованногоОтветаSOAP) Тогда
				ПараметрыЗапроса.АдресОтветаSOAP = АдресЗашифрованногоОтветаSOAP;
			КонецЕсли;
			ПараметрыЗапроса.АдресРесурса 			= Результат.АдресРесурса;
			ПараметрыЗапроса.АдресСервера 			= Результат.АдресСервера;
			ПараметрыЗапроса.КодСостояния 			= Результат.КодСостояния;
			ПараметрыЗапроса.ТипВзаимодействияСЭДО 	= ТипВзаимодействия;
			ПараметрыЗапроса.УдалятьИзХранилища 	= Ложь;
			ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
			ПараметрыЗапроса.ОбменЧерезОператора 	= ОбменЧерезОператора;
			Если Операция = ОперацияПолученияСообщенияСЭДОФСС() Тогда
				ПараметрыЗапроса.ИдентификаторФСС = ИдентификаторыСообщений[0];
			КонецЕсли;
			
			Если НЕ Операция = ОперацияОтправкиСообщенияСЭДОФСС() Тогда
				// Данные запроса сохраняются в другом методе.
				СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
			КонецЕсли;
			
			Результат.ОписаниеОшибки = ОписаниеОшибки;
			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		АдресЗашифрованногоОтветаSOAP = РезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные;
	Иначе
		АдресЗашифрованногоОтветаSOAP = РезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	КонецЕсли;
	
	Расшифровать = Истина;
	Если НЕ РезультатОтправки.ТребуетсяРасшифровкаОтвета Тогда
		Если Операция = ОперацияОтправкиСообщенияСЭДОФСС()
			ИЛИ Операция = ОперацияПолученияСпискаВходящихСЭДОФСС() Тогда
				Расшифровать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьДанныеСЭДОФССПослеПроверкиПодписиSOAP",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если МЧДТолькоПодписание Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("ПодписьВалидна", 					Истина);
		РезультатВыполнения.Вставить("АдресРасшифрованногоОтветаSOAP", 	Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		НастройкиВызова = Новый Структура;
		Если ДополнительныеПараметры.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
			НастройкиВызова.Вставить("СодержимоеПодписанногоЗапросаSOAP",
				ДополнительныеПараметры.СодержимоеПодписанногоЗапросаSOAP);
		КонецЕсли;
		
		ПроверитьПодписьSOAPОтветаЭЛНВФСС(
			Оповещение,
			ОрганизацияСсылка,
			АдресЗашифрованногоОтветаSOAP,
			Расшифровать,,,
			Истина,
			НастройкиВызова);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеСЭДОФССПослеПроверкиПодписиSOAP(РезультатПроверкиПодписи, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	Результат 					= ДополнительныеПараметры.Результат;
	ОшибкаОтправкиНаСервер 		= ДополнительныеПараметры.ОшибкаОтправкиНаСервер;
	ОрганизацияСсылка 			= ДополнительныеПараметры.ОрганизацияСсылка;
	Операция 					= ДополнительныеПараметры.Операция;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	РезультатФоновойЗагрузки 	= ДополнительныеПараметры.РезультатФоновойЗагрузки;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	Если НЕ ЗначениеЗаполнено(РезультатПроверкиПодписи)
		ИЛИ (ТипЗнч(РезультатПроверкиПодписи) = Тип("Структура")
			И РезультатПроверкиПодписи.Свойство("Выполнено")
			И НЕ РезультатПроверкиПодписи.Выполнено) Тогда
			
		Если ЗначениеЗаполнено(РезультатПроверкиПодписи)
			И РезультатПроверкиПодписи.Свойство("ОписаниеОшибки") Тогда
			Результат.ОписаниеОшибки = РезультатПроверкиПодписи.ОписаниеОшибки;
		Иначе
			Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось проверить подпись ответа сервера СЭДО.';
											|en = 'Не удалось проверить подпись ответа сервера СЭДО.'");
		КонецЕсли;
		
		// Удаляем из регистра фоновой загрузки данные о сообщении при возникновении ошибки с криптографией.
		Если ЗначениеЗаполнено(РезультатФоновойЗагрузки) Тогда
			УбратьЗапросИзОчередиФоновогоЗадания(РезультатФоновойЗагрузки);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
		
	КонецЕсли;
	
	Если НЕ РезультатПроверкиПодписи.ПодписьВалидна Тогда
		// Выводим сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись СЭДО СФР недействительна.';
							|en = 'Подпись СЭДО СФР недействительна.'");
		Если РезультатПроверкиПодписи.Свойство("ОписаниеОшибки") Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + РезультатПроверкиПодписи.ОписаниеОшибки;
		КонецЕсли;
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО СФР';
				|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО СФР'"),
			"Предупреждение",
			ТекстОшибки,,
			Истина);
		Результат.ОшибкаПроверкиПодписиЗаписана = Истина;
	КонецЕсли;
	
	Результат.АдресРасшифрованногоОтветаSOAP = РезультатПроверкиПодписи.АдресРасшифрованногоОтветаSOAP;
	
	Если ОшибкаОтправкиНаСервер Тогда
		
		// Ранее возникла ошибка при отправке на сервер.
		РезультатРазбора = РазобратьОшибкуСервераСЭДОФСС(
			ПолучитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP));
		Если РезультатРазбора.Выполнено Тогда
			ОписаниеОшибки = РезультатРазбора.ОписаниеОшибки;
		Иначе
			ОписаниеОшибки = НСтр("ru = 'Ошибка отправки запроса на сервер СЭДО.';
									|en = 'Ошибка отправки запроса на сервер СЭДО.'");
		КонецЕсли;
		
		// Сохраняем данные запроса в случае ошибки.
		ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(ОрганизацияСсылка, Операция);
		ПараметрыЗапроса.АдресЗапросаSOAP 		= Результат.АдресПодписаногоЗапросаSOAP;
		ПараметрыЗапроса.АдресОтветаSOAP 		= Результат.АдресРасшифрованногоОтветаSOAP;
		ПараметрыЗапроса.АдресРесурса 			= Результат.АдресРесурса;
		ПараметрыЗапроса.АдресСервера 			= Результат.АдресСервера;
		ПараметрыЗапроса.КодСостояния 			= Результат.КодСостояния;
		ПараметрыЗапроса.ОписаниеОшибки 		= ОписаниеОшибки;
		ПараметрыЗапроса.ТипВзаимодействияСЭДО 	= ТипВзаимодействия;
		ПараметрыЗапроса.УдалятьИзХранилища 	= Ложь;
		ПараметрыЗапроса.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		
		Результат.ОписаниеОшибки = ОписаниеОшибки;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
		
	КонецЕсли;
	
	Результат.Вставить("ПодписанноеСообщение64", ДополнительныеПараметры.ПодписанноеСообщение64);
	
	Результат.ПодписьВалидна = РезультатПроверкиПодписи.ПодписьВалидна;
	Результат.Выполнено = Истина;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Функция РезультатПолучитьДанныеСЭДОФСС()
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("АдресРасшифрованногоОтветаSOAP", Неопределено);
	Результат.Вставить("АдресПодписаногоЗапросаSOAP", Неопределено);
	Результат.Вставить("ОшибкаПроверкиПодписиЗаписана", Ложь);
	Результат.Вставить("ПодписьВалидна", Неопределено);
	Результат.Вставить("АдресРесурса", "");
	Результат.Вставить("АдресСервера", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ОтмененоПользователем", Ложь);
	Результат.Вставить("АдресЗашифрованногоЗапросаSOAP", "");
	Результат.Вставить("ОшибкаСоединения", Ложь);
	Результат.Вставить("ОтветПолученФоновымЗаданием", Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтправитьСообщениеСЭДОФСС

&НаКлиенте
Процедура ОтправитьСообщениеСЭДОФСС(
	ПараметрыСообщения,
	ЗадаватьВопросОТестовомСервере = Истина,
	ОтображатьСостояние = Истина,
	ВыводитьДиалогСостоянияОтправки = Истина,
	СвойстваОбменаПоСЭДОЧерезОператора = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", 			Ложь);
	Результат.Вставить("ОписаниеОшибки", 		"");
	Результат.Вставить("ИдентификаторЗапроса", 	Неопределено);
	Результат.Вставить("ИдентификаторПакета", 	Неопределено);
	Результат.Вставить("ОбменЧерезОператора", 	Неопределено);
	
	ПараметрыСообщения.ТипСообщения = ЭлектронныйДокументооборотСФССКлиентСервер.ТипСообщенияСЭДОВСтроку(
		ПараметрыСообщения.ТипСообщения);
	
	Организация = ПараметрыСообщения.Организация;
	Операция = ОперацияОтправкиСообщенияСЭДОФСС();
	НастройкиВызова = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	ЭтоПользовательскийЗапрос = ПараметрыСообщения.ЭтоПользовательскийЗапрос;
	
	Если ПараметрыСообщения.Свойство("РегистрационныйНомерФСС") И ПараметрыСообщения.РегистрационныйНомерФСС <> "" Тогда
		РегистрационныйНомерФСС = Строка(ПараметрыСообщения.РегистрационныйНомерФСС);
		ЗаполнитьЗначенияСвойств(НастройкиВызова, ПараметрыСообщения);
		Если ПараметрыСообщения.Свойство("СвойстваДляОбмена") И ПараметрыСообщения.СвойстваДляОбмена <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НастройкиВызова, ПараметрыСообщения.СвойстваДляОбмена);
		КонецЕсли;
		
	Иначе
		НастройкиВызова.ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(
			ПараметрыСообщения.ТипСообщения);
		ЭтоТипВзаимодействияОрганизацияСЭДО = (НастройкиВызова.ТипВзаимодействия =
			ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
		ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
		ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
		СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
			Организация,,
			ПолучитьОГРН,,
			ПолучитьИННКППиСНИЛС);
		РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
		РезультатПроверкиРегистрационногоНомераФСС = ПроверитьДлинуРегистрационныйНомерФСС(
			Результат,
			НастройкиВызова.ТипВзаимодействия,
			Организация);
		Если НЕ РезультатПроверкиРегистрационногоНомераФСС Тогда
			ВыполнитьОбработкуОповещения(ПараметрыСообщения.ОповещениеОбратногоВызова, Результат);
			Возврат;
		КонецЕсли;
		Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
			ЗаполнитьЗначенияСвойств(НастройкиВызова, СвойстваОрганизации);
		КонецЕсли;
	КонецЕсли;
	
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	ЭтоПодписываемаяВыгрузка = (ПараметрыСообщения.ТипСообщения =
			ТипыСообщений.ТипСообщенияСозданиеМашиночитаемойДоверенностиФСС
		ИЛИ ПараметрыСообщения.ТипСообщения = ТипыСообщений.ТипСообщенияОтзывМашиночитаемойДоверенностиФСС
		ИЛИ ПараметрыСообщения.ТипСообщения = ТипыСообщений.ТипСообщенияЗапросСпискаМашиночитаемыхДоверенностейФСС
		ИЛИ ПараметрыСообщения.ТипСообщения = ТипыСообщений.ТипСообщенияЗапросМашиночитаемойДоверенностиФСС
		ИЛИ ПараметрыСообщения.ТипСообщения =
			ТипыСообщений.ТипСообщенияЗапросПолномочийУполномоченногоМашиночитаемойДоверенностиФСС);
	
	Если СвойстваОбменаПоСЭДОЧерезОператора = Неопределено Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
		СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	КонецЕсли;
	ИдентификаторСообщенияСЭДО = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую, "",
		Строка(Новый УникальныйИдентификатор));
	НастройкиВызова.ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	НастройкиВызова.ИдентификаторСообщенияСЭДО = ИдентификаторСообщенияСЭДО;
	Результат.ОбменЧерезОператора = НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	
	ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
	ЗапросДляПолученияДанных.Организация = Организация;
	ЗапросДляПолученияДанных.Операция = Операция;
	ЗапросДляПолученияДанных.ТекстЗапроса =
		ТекстЗапросаОтправкиСообщенияСЭДОФСС(
			РегистрационныйНомерФСС,
			ПараметрыСообщения.ТипСообщения,
			?(ЭтоПодписываемаяВыгрузка, Неопределено, ПараметрыСообщения.СодержимоеСообщения),
			НастройкиВызова);
	Если ЭтоПодписываемаяВыгрузка Тогда
		ЗапросДляПолученияДанных.Вставить("СодержимоеСообщения", ПараметрыСообщения.СодержимоеСообщения);
		ИдентификаторРодителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыСообщения,
			"ИдентификаторРодителя", "");
		ЗапросДляПолученияДанных.Вставить("ИдентификаторРодителя", ИдентификаторРодителя);
	КонецЕсли;
	ЗапросДляПолученияДанных.ИдентификаторыСообщений = ЗначениеВКоллекцию(ИдентификаторСообщенияСЭДО);
	ЗапросДляПолученияДанных.ТипыСообщений = ЗначениеВКоллекцию(ПараметрыСообщения.ТипСообщения);
	Если ПараметрыСообщения.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
		ЗапросДляПолученияДанных.Вставить("СодержимоеПодписанногоЗапросаSOAP",
			ПараметрыСообщения.СодержимоеПодписанногоЗапросаSOAP);
	КонецЕсли;
	Если ПараметрыСообщения.Свойство("ОтпечатокСертификатаПодписанта") Тогда
		ЗапросДляПолученияДанных.Вставить("ОтпечатокСертификатаПодписанта",
			ПараметрыСообщения.ОтпечатокСертификатаПодписанта);
	КонецЕсли;
		
	НастройкиЗаписиОтправки = ?(ПараметрыСообщения.Свойство("НастройкиЗаписиОтправки"),
		ПараметрыСообщения.НастройкиЗаписиОтправки, Неопределено);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 	ПараметрыСообщения.ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 					Результат);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", 				ПараметрыСообщения.ОписаниеОшибки);
	ДополнительныеПараметры.Вставить("Операция", 					Операция);
	ДополнительныеПараметры.Вставить("Организация", 				Организация);
	ДополнительныеПараметры.Вставить("ТипСообщения", 				ПараметрыСообщения.ТипСообщения);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 			НастройкиВызова.ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("НастройкиЗаписиОтправки", 	НастройкиЗаписиОтправки);
	ДополнительныеПараметры.Вставить("РезультатОтправкиЗапроса", 				Неопределено);
	ДополнительныеПараметры.Вставить("АдресЗашифрованногоЗапросаSOAP", 			"");
	ДополнительныеПараметры.Вставить("АдресПодписаногоЗапросаSOAP",				"");
	ДополнительныеПараметры.Вставить("ВыводитьДиалогСостоянияОтправки", 		ВыводитьДиалогСостоянияОтправки);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации",					Неопределено);
	ДополнительныеПараметры.Вставить("МаксимальноеКоличестовоПопытокОтправки", 	10);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора", 		СвойстваОбменаПоСЭДОЧерезОператора);
	ДополнительныеПараметры.Вставить("ИдентификаторСообщенияСЭДО", 				ИдентификаторСообщенияСЭДО);
	ДополнительныеПараметры.Вставить("ЭтоПользовательскийЗапрос",				ЭтоПользовательскийЗапрос);
	
	Если ВыводитьДиалогСостоянияОтправки Тогда
		ПараметрыОжидания = Новый Структура();
		ПараметрыОжидания.Вставить("РежимДиалогаПовторить", Ложь);
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ОтправкаСообщенияСЭДО",
			ПараметрыОжидания, , , , , ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьСообщениеСЭДОФССПослеЗапроса", ЭтотОбъект, ДополнительныеПараметры);
	ПолучитьДанныеСЭДОФСС(
		Оповещение,
		ЗапросДляПолученияДанных,
		ЗадаватьВопросОТестовомСервере,
		НастройкиВызова.ТипВзаимодействия,
		ОтображатьСостояние,
		СвойстваОбменаПоСЭДОЧерезОператора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеСЭДОФССПослеЗапроса(РезультатОтправки, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	ШаблонОписанияОшибки 				= ДополнительныеПараметры.ОписаниеОшибки;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	ТипСообщения 						= ДополнительныеПараметры.ТипСообщения;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	НастройкиЗаписиОтправки 			= ДополнительныеПараметры.НастройкиЗаписиОтправки;
	ВыводитьДиалогСостоянияОтправки 	= ДополнительныеПараметры.ВыводитьДиалогСостоянияОтправки;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	ИдентификаторСообщенияСЭДО 			= ДополнительныеПараметры.ИдентификаторСообщенияСЭДО;
	ЭтоПользовательскийЗапрос			= ДополнительныеПараметры.ЭтоПользовательскийЗапрос;
	
	ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
	ПараметрыЗапроса.АдресЗапросаSOAP 			= РезультатОтправки.АдресПодписаногоЗапросаSOAP;
	ПараметрыЗапроса.АдресОтветаSOAP 			= РезультатОтправки.АдресРасшифрованногоОтветаSOAP;
	ПараметрыЗапроса.АдресРесурса 				= РезультатОтправки.АдресРесурса;
	ПараметрыЗапроса.АдресСервера 				= РезультатОтправки.АдресСервера;
	ПараметрыЗапроса.КодСостояния 				= РезультатОтправки.КодСостояния;
	ПараметрыЗапроса.ТипСообщенияСЭДО 			= ТипСообщения;
	ПараметрыЗапроса.ТипВзаимодействияСЭДО 		= ТипВзаимодействия;
	ПараметрыЗапроса.УдалятьИзХранилища 		= Истина;
	ПараметрыЗапроса.ОбменЧерезОператора 		= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	ПараметрыЗапроса.ЭтоПользовательскийЗапрос	= ЭтоПользовательскийЗапрос;
	
	ПодписанныйЗапросSOAP64 = "";
	Если РезультатОтправки.Выполнено Тогда
		МЧДТолькоПодписание = (ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") = Истина);
		
		// Отправка была выполнена успешно.
		АдресРезультата = РезультатОтправки.АдресРасшифрованногоОтветаSOAP;
		Если МЧДТолькоПодписание Тогда
			ИдентификаторОтвета = Строка(Новый УникальныйИдентификатор);
			РезультатРазбора = Новый Структура;
			РезультатРазбора.Вставить("Выполнено", Истина);
			РезультатРазбора.Вставить("Идентификатор", ИдентификаторОтвета);
			
		Иначе
			ТекстОтвета = ПолучитьИзВременногоХранилища(АдресРезультата);
			РезультатРазбора = РазобратьОтветСЭДОФСССИдентификатором(ТекстОтвета);
		КонецЕсли;
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			// Ошибка разбора ответа.
			Шаблон = НСтр("ru = 'При отправке сообщения в СЭДО произошла ошибка:
			|%1';
			|en = 'При отправке сообщения в СЭДО произошла ошибка:
			|%1'");
			ОписаниеОшибки = СтрШаблон(Шаблон, РезультатРазбора.ОписаниеОшибки);
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Отправка данных в СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Отправка данных в СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
				
			ПараметрыЗапроса.ОписаниеОшибки = ОписаниеОшибки;
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
		Иначе
			// Ответ успешно разобран.
			Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
				ПараметрыЗапроса.ИдентификаторПакетаФСС = РезультатРазбора.Идентификатор;
				РезультатРазбора.Идентификатор = ИдентификаторСообщенияСЭДО;
			КонецЕсли;
			РезультатОперации.ИдентификаторЗапроса = РезультатРазбора.Идентификатор;
			РезультатОперации.ИдентификаторПакета = ПараметрыЗапроса.ИдентификаторПакетаФСС;
			ПараметрыЗапроса.ИдентификаторФСС = РезультатРазбора.Идентификатор;
		КонецЕсли;
		
		Если РезультатРазбора.Выполнено И НастройкиЗаписиОтправки <> Неопределено И НЕ МЧДТолькоПодписание Тогда
			КороткоеИмяФайлаПакета = НастройкиЗаписиОтправки.КороткоеИмяФайлаПакета;
			Если СтрНайти(КороткоеИмяФайлаПакета, "%1") <> 0 Тогда
				КороткоеИмяФайлаПакета = СтрШаблон(
					КороткоеИмяФайлаПакета,
					РезультатОперации.ИдентификаторЗапроса);
			КонецЕсли;
			
			ЭтоАдресВременногоХранилища = Истина;
			ОтправкаСсылка = ДобавитьОтправкуФССНаСервере(
				ЭтоАдресВременногоХранилища,
				КороткоеИмяФайлаПакета,
				ПараметрыЗапроса.АдресЗапросаSOAP,
				РезультатОперации.ИдентификаторЗапроса,
				НастройкиЗаписиОтправки);
			РезультатОперации.Вставить("ОтправкаСсылка", ОтправкаСсылка);
			
		ИначеЕсли РезультатРазбора.Выполнено И МЧДТолькоПодписание Тогда
			ДанныеПодписаногоЗапросаSOAP = ПолучитьИзВременногоХранилища(РезультатОтправки.АдресПодписаногоЗапросаSOAP);
			ПодписанныйЗапросSOAP64 = Base64Строка(ДанныеПодписаногоЗапросаSOAP);
		КонецЕсли;
		
		// Сохраняем данные запроса в журнал запросов.
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
			Возврат;
		КонецЕсли;
		
	Иначе
		
		// При отправке возникла ошибка.
		ПараметрыЗапроса.ОписаниеОшибки = РезультатОтправки.ОписаниеОшибки;
		ПараметрыЗапроса.УдалятьИзХранилища = Ложь;
		// Сохраняем данные запроса в журнал запросов.
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		
		Если ПриВыполненииЗапросаВозниклаОшибкиСоединения(ПараметрыЗапроса)
			И ВыводитьДиалогСостоянияОтправки
			И СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// Возникала ошибка соединения с сервером СЭДО.
			ДополнительныеПараметры.АдресЗашифрованногоЗапросаSOAP = РезультатОтправки.АдресЗашифрованногоЗапросаSOAP;
			ДополнительныеПараметры.АдресПодписаногоЗапросаSOAP = РезультатОтправки.АдресПодписаногоЗапросаSOAP;
			ДополнительныеПараметры.РезультатОтправкиЗапроса = РезультатОтправки;
			ОтправитьСообщениеСЭДОВФоне(ДополнительныеПараметры);
			Возврат;
		КонецЕсли;
		
		// Закрываем диалог отправки.
		Если ВыводитьДиалогСостоянияОтправки Тогда
			ЗакрытьФормуДлительнойОперации(ДополнительныеПараметры.ФормаДлительнойОперации);
		КонецЕсли;
		
		ОписаниеОшибки = СтрШаблон(ШаблонОписанияОшибки, РезультатОтправки.ОписаниеОшибки);
		РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
		Возврат;
		
	КонецЕсли;
	
	// Отправка была выполнена успешно.
	Если ВыводитьДиалогСостоянияОтправки Тогда
		ЗакрытьФормуДлительнойОперации(ДополнительныеПараметры.ФормаДлительнойОперации);
	КонецЕсли;
	
	ПодписанноеСообщение64 = ?(РезультатОтправки.Свойство("ПодписанноеСообщение64"), РезультатОтправки.ПодписанноеСообщение64, "");
	РезультатОперации.Вставить("ПодписанноеСообщение64", 			ПодписанноеСообщение64);
	РезультатОперации.Вставить("ПодписанныйЗапросSOAP64", 			ПодписанныйЗапросSOAP64);
	
	РезультатОперации.Выполнено = Истина;
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
	
КонецПроцедуры

#КонецОбласти

#Область ОтправитьСообщениеСЭДОВФоне

&НаКлиенте
Процедура ОтправитьСообщениеСЭДОВФоне(ДополнительныеПараметры)
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	АдресЗашифрованногоЗапросаSOAP 		= ДополнительныеПараметры.АдресЗашифрованногоЗапросаSOAP;
	АдресПодписаногоЗапросаSOAP			= ДополнительныеПараметры.АдресПодписаногоЗапросаSOAP;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ТипСообщения 						= ДополнительныеПараметры.ТипСообщения;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	МаксимальноеКоличестовоПопытокОтправки = ДополнительныеПараметры.МаксимальноеКоличестовоПопытокОтправки;
	
	Если НЕ ДополнительныеПараметры.Свойство("НомерПопытки")
		ИЛИ (ДополнительныеПараметры.Свойство("НомерПопытки")
			И ДополнительныеПараметры.НомерПопытки = 0) Тогда
			
		Если НЕ ДополнительныеПараметры.Свойство("НомерПопытки") Тогда
			ДополнительныеПараметры.Вставить("НомерПопытки", 1);
			ДополнительныеПараметры.Вставить("ВсегоПопыток", 1);
		Иначе
			ПараметрыОжидания = Новый Структура();
			ПараметрыОжидания.Вставить("РежимДиалогаПовторить", Ложь);
			ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
				"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ОтправкаСообщенияСЭДО",
				ПараметрыОжидания, , , , , ,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'Скорее всего, сервер СФР перегружен.';
								|en = 'Скорее всего, сервер СФР перегружен.'");
		Шаблон = НСтр("ru = 'Попытка отправки %1 из %2...';
						|en = 'Попытка отправки %1 из %2...'");
		ТекстПопытка = СтрШаблон(Шаблон, 2, МаксимальноеКоличестовоПопытокОтправки);
		ТекстСообщения = СтроковыеФункцииКлиент.ФорматированнаяСтрока("<b>" + ТекстПопытка + "</b>" + Символы.ПС + ТекстСообщения);
		ЭлементДекорации = ДополнительныеПараметры.ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации;
		ЭлементДекорации.Заголовок = ТекстСообщения;
		ДополнительныеПараметры.ФормаДлительнойОперации.Элементы.ФормаЗакрыть.Видимость = Истина;
		
	КонецЕсли;
	
	ДополнительныеПараметры.НомерПопытки = ДополнительныеПараметры.НомерПопытки + 1;
	ДополнительныеПараметры.ВсегоПопыток = ДополнительныеПараметры.ВсегоПопыток + 1;
	
	НомерПопытки = ДополнительныеПараметры.НомерПопытки;
	ВсегоПопыток = ДополнительныеПараметры.ВсегоПопыток;
	
	ТекстСообщения = НСтр("ru = 'Скорее всего, сервер СФР перегружен.';
							|en = 'Скорее всего, сервер СФР перегружен.'");
	Шаблон = НСтр("ru = 'Попытка отправки %1 из %2...';
					|en = 'Попытка отправки %1 из %2...'");
	ТекстПопытка = СтрШаблон(Шаблон, НомерПопытки, МаксимальноеКоличестовоПопытокОтправки);
	ТекстСообщения = СтроковыеФункцииКлиент.ФорматированнаяСтрока("<b>" + ТекстПопытка + "</b>" + Символы.ПС + ТекстСообщения);
	ЭлементДекорации = ДополнительныеПараметры.ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации;
	ЭлементДекорации.Заголовок = ТекстСообщения;
	ДополнительныеПараметры.ФормаДлительнойОперации.ОбновитьОтображениеДанных();
	
	ДлительнаяОперация = ДлительнаяОперацияОтправкиЗапросаСЭДО(Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP,
		СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		
	Оповещение = Новый ОписаниеОповещения("ОтправитьСообщениеСЭДОВФонеПослеОтправкиЗапроса", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеСЭДОВФонеПослеОтправкиЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	АдресЗашифрованногоЗапросаSOAP 		= ДополнительныеПараметры.АдресЗашифрованногоЗапросаSOAP;
	АдресПодписаногоЗапросаSOAP			= ДополнительныеПараметры.АдресПодписаногоЗапросаSOAP;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ТипСообщения 						= ДополнительныеПараметры.ТипСообщения;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	НомерПопытки 						= ДополнительныеПараметры.НомерПопытки;
	ВсегоПопыток 						= ДополнительныеПараметры.ВсегоПопыток;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	МаксимальноеКоличестовоПопытокОтправки = ДополнительныеПараметры.МаксимальноеКоличестовоПопытокОтправки;
	
	Если Результат.Статус = "Выполнено" Тогда
		НовыйРезультатОтправки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		Если НЕ ПустаяСтрока(НовыйРезультатОтправки.ТекстЗашифрованногоОтветаSOAP) Тогда
			Адрес = ПоместитьВоВременноеХранилище(НовыйРезультатОтправки.ТекстЗашифрованногоОтветаSOAP,
				Новый УникальныйИдентификатор);
		Иначе
			Адрес = "";
		КонецЕсли;
		НовыйРезультатОтправки.АдресЗашифрованногоОтветаSOAP = Адрес;
		Если ЗначениеЗаполнено(НовыйРезультатОтправки.ДвоичныеДанныеЗашифрованногоОтветаSOAP) Тогда
			Адрес = ПоместитьВоВременноеХранилище(НовыйРезультатОтправки.ДвоичныеДанныеЗашифрованногоОтветаSOAP,
				Новый УникальныйИдентификатор);
		Иначе
			Адрес = "";
		КонецЕсли;
		НовыйРезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные = Адрес;
	Иначе
		ЗакрытьФормуДлительнойОперации(ДополнительныеПараметры.ФормаДлительнойОперации);
		РезультатОперации.ОписаниеОшибки = НСтр("ru = 'Ошибка выполнения фоновой отправки на сервер СЭДО СФР.';
												|en = 'Ошибка выполнения фоновой отправки на сервер СЭДО СФР.'");;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
		Возврат;
	КонецЕсли;

	ФормаОткрыта = ТипЗнч(ДополнительныеПараметры.ФормаДлительнойОперации) = ТипФормыКлиентскогоПриложения()
		И ДополнительныеПараметры.ФормаДлительнойОперации.Открыта();
	Если НЕ ФормаОткрыта Тогда
		// Форма закрыта, пользователь нажал отмену.
		РезультатОперации.ОписаниеОшибки = НовыйРезультатОтправки.ОписаниеОшибки;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
		Возврат;
	КонецЕсли;
		
	ДополнительныеПараметры.РезультатОтправкиЗапроса = НовыйРезультатОтправки;
	
	ДополнительныеПараметры.ФормаДлительнойОперации.ОбновитьОтображениеДанных();
	
	// Сохраняем данные запроса.
	ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
	ПараметрыЗапроса.АдресЗапросаSOAP 		= АдресПодписаногоЗапросаSOAP;
	ПараметрыЗапроса.АдресОтветаSOAP 		= НовыйРезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	ПараметрыЗапроса.АдресРесурса 			= НовыйРезультатОтправки.АдресРесурса;
	ПараметрыЗапроса.АдресСервера 			= НовыйРезультатОтправки.АдресСервера;
	ПараметрыЗапроса.КодСостояния 			= НовыйРезультатОтправки.КодСостояния;
	ПараметрыЗапроса.ТипСообщенияСЭДО 		= ТипСообщения;
	ПараметрыЗапроса.ТипВзаимодействияСЭДО 	= ТипВзаимодействия;
	ПараметрыЗапроса.УдалятьИзХранилища 	= Ложь;
	ПараметрыЗапроса.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	ПараметрыЗапроса.ОписаниеОшибки 		= НовыйРезультатОтправки.ОписаниеОшибки;
	
	Если ПриВыполненииЗапросаВозниклаОшибкиСоединения(НовыйРезультатОтправки)
		И МаксимальноеКоличестовоПопытокОтправки > НомерПопытки Тогда
		// Возникла ошибка соединения, но максимальное количество попыток не превышено.
		ДополнительныеПараметры.РезультатОтправкиЗапроса = НовыйРезультатОтправки;
		ОтправитьСообщениеСЭДОВФоне(ДополнительныеПараметры);
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		Возврат;
	КонецЕсли;
	
	Если НовыйРезультатОтправки.Выполнено Тогда
		
		// Был получен ответ сервера СЭДО, запускаем расшифровку ответа.
		ЗакрытьФормуДлительнойОперации(ДополнительныеПараметры.ФормаДлительнойОперации);
		
		РезультатФоновойЗагрузки = РезультатПолучитьДанныеСЭДОФСС();
		РезультатФоновойЗагрузки.АдресЗашифрованногоЗапросаSOAP = АдресЗашифрованногоЗапросаSOAP;
		АдресЗашифрованногоОтветаSOAP = НовыйРезультатОтправки.АдресЗашифрованногоОтветаSOAP; 
		ЗаполнитьЗначенияСвойств(РезультатФоновойЗагрузки, НовыйРезультатОтправки);
		РезультатФоновойЗагрузки.Вставить("АдресЗашифрованногоОтветаSOAP", АдресЗашифрованногоОтветаSOAP);
		РезультатФоновойЗагрузки.АдресПодписаногоЗапросаSOAP = АдресПодписаногоЗапросаSOAP;
		
		ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
		ЗапросДляПолученияДанных.Организация = Организация;
		ЗапросДляПолученияДанных.Операция = Операция;
		ЗапросДляПолученияДанных.РезультатФоновойЗагрузки = РезультатФоновойЗагрузки;
		
		Оповещение = Новый ОписаниеОповещения("ОтправитьСообщениеСЭДОФССПослеЗапроса", ЭтотОбъект, ДополнительныеПараметры);
		ПолучитьДанныеСЭДОФСС(
			Оповещение,
			ЗапросДляПолученияДанных,
			Ложь,
			ТипВзаимодействия,
			Истина,
			СвойстваОбменаПоСЭДОЧерезОператора);
		Возврат;
		
	КонецЕсли;
	
	// Не удалось отпавить сообщение после максимального количества попыток.
	СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
	ЗакрытьФормуДлительнойОперации(ДополнительныеПараметры.ФормаДлительнойОперации);
	
	// Открывается новая форма с кнопкой повтора отправки.
	ПараметрыОжидания = Новый Структура();
	ТекстСообщенияЖирным = НСтр("ru = 'К сожалению, не удалось отправить документ из-за недоступности сервера СФР.';
								|en = 'К сожалению, не удалось отправить документ из-за недоступности сервера СФР.'");
	ТекстСообщения = НСтр("ru = 'Вы можете повторить отправку сейчас или вернуться к ней позже.';
							|en = 'Вы можете повторить отправку сейчас или вернуться к ней позже.'")
		+ Символы.ПС + НСтр("ru = 'Как правило, сервер СФР менее загружен с 20:00 по 08:00 (МСК).';
							|en = 'Как правило, сервер СФР менее загружен с 20:00 по 08:00 (МСК).'");
	ТекстСообщения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		"<b>" + ТекстСообщенияЖирным + "</b>" + Символы.ПС
		+ Символы.ПС + ТекстСообщения);
	ПараметрыОжидания.Вставить("ТекстСообщения", ТекстСообщения);
	ПараметрыОжидания.Вставить("РежимДиалогаПовторить", Истина);
	Оповещение = Новый ОписаниеОповещения("ОтправитьСообщениеСЭДОВФонеПослеДиалогаПовторить", ЭтотОбъект, ДополнительныеПараметры);
	ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
		"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ОтправкаСообщенияСЭДО",
		ПараметрыОжидания, , , , ,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ЭлементДекорации = ДополнительныеПараметры.ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации;
	ЭлементДекорации.Заголовок = ТекстСообщения;
	ДополнительныеПараметры.ФормаДлительнойОперации.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеСЭДОВФонеПослеДиалогаПовторить(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 		= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОтправки 				= ДополнительныеПараметры.РезультатОтправкиЗапроса;
	РезультатОперации 				= ДополнительныеПараметры.Результат;
	
	Если Результат = НСтр("ru = 'Повторить';
							|en = 'Повторить'") Тогда
		ДополнительныеПараметры.НомерПопытки = 0;
		ОтправитьСообщениеСЭДОВФоне(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;

	РезультатОперации.ОписаниеОшибки = РезультатОтправки.ОписаниеОшибки;
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДлительнаяОперацияОтправкиЗапросаСЭДО(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP,
		ОбменПоСЭДОНапрямую = Неопределено)
	
	ТекстЗашифрованногоЗапросаSOAP = ПолучитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
	
	ПараметрыПроцедуры 	= Новый Структура;
	ПараметрыПроцедуры.Вставить("Организация", 						Организация);
	ПараметрыПроцедуры.Вставить("Операция", 						Операция);
	ПараметрыПроцедуры.Вставить("ТекстЗашифрованногоЗапросаSOAP", 	ТекстЗашифрованногоЗапросаSOAP);
	ПараметрыПроцедуры.Вставить("ОбменПоСЭДОНапрямую", 				ОбменПоСЭДОНапрямую);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Отправка запроса к серверу СЭДО';
															|en = 'Отправка запроса к серверу СЭДО'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ДокументооборотСКонтролирующимиОрганами.ОтправитьЗапросСервисуСЭДОФССФоновое",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

#КонецОбласти

#Область ПолучитьВходящиеСообщенияСЭДОФСС

&НаКлиенте
Процедура ПолучитьВходящиеСообщенияСЭДОФСС(
		ОповещениеОбратногоВызова,
		Организации,
		ЗадаватьВопросОТестовомСервере = Истина,
		ПоказыватьДлительнуюОперацию = Истина,
		ТипВзаимодействия = Неопределено,
		ТипСообщенияОтвета = Неопределено,
		ОтображатьСостояние = Истина) Экспорт
		
	Если НЕ ТипЗнч(Организации) = Тип("Массив") Тогда
		Организации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организации);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщенийПоОрганизациям", Новый Соответствие);
	Результат.Вставить("БылиОшибки", Ложь);
	Результат.Вставить("ОшибкиПоОрганизациям", Новый Соответствие);
	Результат.Вставить("РезультатыПоОрганизациям", Новый Соответствие);
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 		ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 						Результат);
	ДополнительныеПараметры.Вставить("Организации", 					Организации);
	ДополнительныеПараметры.Вставить("ИндексОрганизации", 				0);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации", 		Неопределено);
	ДополнительныеПараметры.Вставить("ЗадаватьВопросОТестовомСервере", 	ЗадаватьВопросОТестовомСервере);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 				ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("ТипСообщенияОтвета",				ТипСообщенияОтвета);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние",				ОтображатьСостояние);
	
	Если ПоказыватьДлительнуюОперацию Тогда
		ПараметрыОжидания = Новый Структура();
		ПараметрыОжидания.Вставить("ТекстСообщения",
			НСтр("ru = 'Получение входящих сообщений СЭДО СФР';
				|en = 'Получение входящих сообщений СЭДО СФР'"));
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"ОбщаяФорма.ДлительнаяОперация", ПараметрыОжидания);
	КонецЕсли;
	
	СброситьБезПолучения = Истина;
	СвойстваОбменаПоСЭДОЧерезОператора(Организации, СброситьБезПолучения);
	
	ПолучитьВходящиеСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВходящиеСообщенияСЭДОФССЦикл(ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 			= ДополнительныеПараметры.Результат;
	ИндексОрганизации 			= ДополнительныеПараметры.ИндексОрганизации;
	Организации 				= ДополнительныеПараметры.Организации;
	Результат 					= ДополнительныеПараметры.Результат;
	ФормаДлительнойОперации 	= ДополнительныеПараметры.ФормаДлительнойОперации;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	
	Если ИндексОрганизации >= Организации.Количество() Тогда
		// Закроем окно заставки длительной операции, если она была открыта.
		ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		// Анализ ошибок и вывод диалога о повторном автоматическом получении в случае необходимости.
		АнализОшибокПолученияСообщений(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Организация = Организации[ИндексОрганизации];
	
	Если НЕ ФормаДлительнойОперации = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Получение входящих сообщений СЭДО по организации: ';
								|en = 'Получение входящих сообщений СЭДО по организации: '") + Организация
			+ Символы.ПС + НСтр("ru = 'Пожалуйста, подождите...';
								|en = 'Пожалуйста, подождите...'");
		ЭлементДекорации = ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации;
		ЭлементДекорации.Заголовок = ТекстСообщения;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьВходящиеСообщенияСЭДОФССЦиклПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	РезультатОперацииПроверки = Новый Структура;
	РезультатОперацииПроверки.Вставить("Выполнено", Ложь);
	РезультатОперацииПроверки.Вставить("ОписаниеОшибки", "");
	РезультатОперацииПроверки.Вставить("ИдентификаторЗапроса", Неопределено);
	
	РезультатПроверкиРегистрационногоНомераФСС = ПроверитьДлинуРегистрационныйНомерФСС(
			РезультатОперацииПроверки,
			ТипВзаимодействия,
			Организация);
	Если НЕ РезультатПроверкиРегистрационногоНомераФСС Тогда
		Результат.БылиОшибки = Истина;
		Ошибки = Новый Массив;
		Ошибки.Добавить(РезультатОперацииПроверки.ОписаниеОшибки);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(РезультатОперацииПроверки.ОписаниеОшибки);
		Результат.ОшибкиПоОрганизациям.Вставить(Организация, Ошибки);
		ДополнительныеПараметры.ИндексОрганизации = ИндексОрганизации + 1;
		ПолучитьВходящиеСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = Ложь;
	
	Если ОповещениеОбратногоВызова.ИмяПроцедуры = "ОбновитьРезультатКонкретнойОтправкиФССПослеОбменаСЭДО" Тогда
		МетаданныеВходящихСообщенийСЭДОФСС(
			Оповещение,
			Организация,,,
			ТипВзаимодействия,
			СброситьСвойстваОбменаПоСЭДОЧерезОператора);
	Иначе
		МетаданныеВходящихСообщенийСЭДОФССЗаПериод(
			Оповещение,
			Организация,,
			ТипВзаимодействия,
			СброситьСвойстваОбменаПоСЭДОЧерезОператора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВходящиеСообщенияСЭДОФССЦиклПослеЗапроса(
	РезультатВходящие,
	ДополнительныеПараметры) Экспорт
	
	Результат 						= ДополнительныеПараметры.Результат;
	ОповещениеОбратногоВызова 		= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексОрганизации 				= ДополнительныеПараметры.ИндексОрганизации;
	Организации 					= ДополнительныеПараметры.Организации;
	ФормаДлительнойОперации 		= ДополнительныеПараметры.ФормаДлительнойОперации;
	ЗадаватьВопросОТестовомСервере 	= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТипВзаимодействия 				= ДополнительныеПараметры.ТипВзаимодействия;
	
	Организация = Организации[ИндексОрганизации];
	
	Если НЕ РезультатВходящие.Выполнено Тогда
		Результат.БылиОшибки = Истина;
		Ошибки = Новый Массив;
		Ошибки.Добавить(РезультатВходящие.ОписаниеОшибки);
		Результат.ОшибкиПоОрганизациям.Вставить(Организация, Ошибки);
	КонецЕсли;
	
	НовыеСообщения = НовыеСообщенияСЭДОФСС(Организация,, ТипВзаимодействия);
	Идентификаторы = Новый Массив;
	ТипыВзаимодействий = Новый Массив;
	ТипСообщенияОтвета = Неопределено;
	Если ДополнительныеПараметры.Свойство("ТипСообщенияОтвета") Тогда
		ТипСообщенияОтвета = ДополнительныеПараметры.ТипСообщенияОтвета;
	КонецЕсли;
	Для каждого Сообщение Из НовыеСообщения Цикл
		Если ТипСообщенияОтвета = Неопределено Тогда
			Идентификаторы.Добавить(Сообщение.Идентификатор);
			ТипыВзаимодействий.Добавить(Сообщение.ТипВзаимодействия);
		Иначе
			Если ТипСообщенияОтвета = Сообщение.Тип Тогда
				Идентификаторы.Добавить(Сообщение.Идентификатор);
				ТипыВзаимодействий.Добавить(Сообщение.ТипВзаимодействия);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НовыеСообщения.Количество() > 0 Тогда
		ФормаДлительнойОтправкиОткрыта = ДлительнаяОтправкаКлиент.ФормаДлительнойОтправкиЕстьСредиОткрытых(Истина);
		Если ФормаДлительнойОтправкиОткрыта Тогда
			АктивнаяФорма = ФормаДлительноеДействиеИзОткрытых();
			Если НЕ АктивнаяФорма = Неопределено И НЕ АктивнаяФорма.ЭтоРасшифровка Тогда
				// Вызываем смену этапа если это не расшифровка входящих.
				// При смене этапа во время расшифровки сбивается счетчик процентов.
				ДополнительныеПараметрыОповещения = Новый Структура();
				ДополнительныеПараметрыОповещения.Вставить("ИмяСобытия", 	"ПолучитьВходящиеСообщенияСЭДОФССЦиклПослеЗапроса");
				ДополнительныеПараметрыОповещения.Вставить("Орган", 		ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС"));
				ДополнительныеПараметрыОповещения.Вставить("Отправка", 		ПредопределенноеЗначение("Справочник.ОтправкиФСС.ПустаяСсылка"));
				ДополнительныеПараметрыОповещения.Вставить("УчетнаяЗапись", Организация);
				ДополнительныеПараметрыОповещения.Вставить("ЕстьНовыеФСС",	Истина);
				Оповестить("Смена этапа обмена", ДополнительныеПараметрыОповещения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = Ложь;
	
	// Получаем содержимое входящих сообщений по организации.
	Оповещение = Новый ОписаниеОповещения("ПолучитьВходящиеСообщенияСЭДОФССЦиклПослеПолученияСообщений",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьСообщенияСЭДОФСС(
		Оповещение,
		Организация,
		Идентификаторы,
		Ложь,
		ЗадаватьВопросОТестовомСервере,
		ТипыВзаимодействий,
		СброситьСвойстваОбменаПоСЭДОЧерезОператора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВходящиеСообщенияСЭДОФССЦиклПослеПолученияСообщений(
	РезультатПолучитьСообщения,
	ДополнительныеПараметры) Экспорт
	
	Результат						= ДополнительныеПараметры.Результат;
	ОповещениеОбратногоВызова		= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексОрганизации				= ДополнительныеПараметры.ИндексОрганизации;
	Организации						= ДополнительныеПараметры.Организации;
	ДанныеСообщенийПоОрганизациям	= Результат.ДанныеСообщенийПоОрганизациям;
	ФормаДлительнойОперации			= ДополнительныеПараметры.ФормаДлительнойОперации;
	РезультатыПоОрганизациям		= Результат.РезультатыПоОрганизациям;
	
	Организация = Организации[ИндексОрганизации];
	
	Если РезультатПолучитьСообщения.БылиОшибки Тогда
		Результат.БылиОшибки = Истина;
		Результат.ОшибкиПоОрганизациям.Вставить(Организация, РезультатПолучитьСообщения.Ошибки);
		Для каждого Ошибка из РезультатПолучитьСообщения.Ошибки Цикл
			ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(Ошибка);
		КонецЦикла;
	КонецЕсли;
	
	РезультатыПоОрганизациям.Вставить(Организация, РезультатПолучитьСообщения.РезультатыПолучения);
	ДанныеСообщенийПоОрганизациям.Вставить(Организация, РезультатПолучитьСообщения.ДанныеСообщений);
	
	Если НЕ РезультатПолучитьСообщения.ПолучитьПовторно Тогда
		ИндексОрганизации = ИндексОрганизации + 1;
	КонецЕсли;
	
	ДополнительныеПараметры.ИндексОрганизации = ИндексОрганизации;
	
	ПолучитьВходящиеСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВходящиеСообщенияСЭДОФССПоОрганизациямПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	Организация					= ДополнительныеПараметры.Организация;
	КоличествоНеРасшифрованных	= ДополнительныеПараметры.КоличествоНеРасшифрованных;
	КоличествоРасшифрованных	= ДополнительныеПараметры.КоличествоРасшифрованных;
	
	КоличествоРасшифрованныхСЭДО = 0;
	КоличествоНеРасшифрованныхСЭДО = 0;
	Для каждого КлючЗначение Из Результат.ДанныеСообщенийПоОрганизациям Цикл
		КоличествоРасшифрованныхСЭДО = КоличествоРасшифрованныхСЭДО + КлючЗначение.Значение.Количество();
	КонецЦикла;
	
	ДополнительныеПараметры.КоличествоРасшифрованных = КоличествоРасшифрованных + КоличествоРасшифрованныхСЭДО - 1;
	
	Если Результат.БылиОшибки Тогда
		КоличествоЗагружаемых = 0;
		Для каждого КлючЗначение Из Результат.РезультатыПоОрганизациям Цикл
			Для каждого Запрос Из КлючЗначение.Значение Цикл
				КоличествоЗагружаемых = КоличествоЗагружаемых + Запрос.Идентификаторы.Количество();
			КонецЦикла;
		КонецЦикла;
		КоличествоНеРасшифрованныхСЭДО = КоличествоЗагружаемых - КоличествоРасшифрованныхСЭДО;
		ДополнительныеПараметры.КоличествоНеРасшифрованных = КоличествоНеРасшифрованных
			+ КоличествоНеРасшифрованныхСЭДО;
		
		Для каждого КлючЗначение Из Результат.ОшибкиПоОрганизациям Цикл
			Для каждого Ошибка из КлючЗначение.Значение Цикл
				ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(Ошибка);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Отбор = Новый Структура("Организация", Организация);
	РезультатОтбора = ТаблицаРасшифровкиПоОрганизациям.НайтиСтроки(Отбор);
	Если НЕ РезультатОтбора.Количество() = 0 Тогда 
		РезультатОтбора[0].КоличествоРасшифрованных = РезультатОтбора[0].КоличествоРасшифрованных
			+ КоличествоРасшифрованныхСЭДО - 1;
		РезультатОтбора[0].КоличествоНеРасшифрованных = РезультатОтбора[0].КоличествоНеРасшифрованных
			+ КоличествоНеРасшифрованныхСЭДО;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"РасшифроватьТребующиеРасшифровкуЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Функция ФормаДлительноеДействиеИзОткрытых() Экспорт
	
	Окна = ПолучитьОкна();
	
	Если Окна = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Для Каждого ОткрытоеОкно Из Окна Цикл
		
		Если ТипЗнч(ОткрытоеОкно) <> Тип("ОкноКлиентскогоПриложения") Тогда
			Продолжить;
		КонецЕсли;
		
		ОткрытыеФормы = ОткрытоеОкно.Содержимое;
		
		Если ОткрытыеФормы.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ОткрытаяФорма = ОткрытыеФормы[0];
		ИмяОткрытойФормы      = ОткрытаяФорма.ИмяФормы;
		Открыта       = ОткрытаяФорма.Открыта();
		КраткоеИмя    = ДлительнаяОтправкаКлиентСервер.ИмяФормыПоПолномуИмени(ИмяОткрытойФормы);
		
		ЭтоФормаДлительноеДействие = КраткоеИмя = "ДлительноеДействие";
		
		Если ЭтоФормаДлительноеДействие И Открыта Тогда
			
			Возврат ОткрытаяФорма;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторыДляПовторнойЗагрузкиИзСЭДО()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапросыДляПовторнойОтправкиСЭДО.Идентификатор КАК Идентификатор
	               |ИЗ
	               |	РегистрСведений.ЗапросыДляПовторнойОтправкиСЭДО КАК ЗапросыДляПовторнойОтправкиСЭДО";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Идентификаторы = Новый Массив;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Идентификаторы = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Идентификатор");
	КонецЕсли;
	
	Возврат Идентификаторы;
	
КонецФункции

&НаКлиенте
Функция АнализОшибокПолученияСообщений(ОповещениеОбратногоВызова, РезультатПолучения)
	
	// Вызов переопределяемого метода.
	ЭлектронныйДокументооборотСФССКлиентПереопределяемый.ПослеПолученияСообщенийСЭДО(
			РезультатПолучения);
	
	Если НЕ РезультатПолучения.БылиОшибки Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения);
		Возврат Истина;
	КонецЕсли;
	
	ИдентификаторыДляПовторнойЗагрузки = ИдентификаторыДляПовторнойЗагрузкиИзСЭДО();
	
	ЗапросыСОшибкойОтправки = Новый Массив;
	БылиОшибкиПриПолучении = Ложь;
	СчетчикВсего = 0;
	СчетчикОшибок = 0;
	КоличествоНовыхИдентификаторов = 0;
	Для каждого КлючИЗначение Из РезультатПолучения.РезультатыПоОрганизациям Цикл
		Организация = КлючИЗначение.Ключ;
		СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// Для операторной схемы механизм фоновой загрузки не используется.
			Продолжить;
		КонецЕсли;
		Для каждого Результат Из КлючИЗначение.Значение Цикл 
			ДанныеЗапроса = Неопределено;
			Если НЕ Результат.Свойство("ДанныеЗапроса", ДанныеЗапроса) Тогда
				Продолжить;
			КонецЕсли;
			Если ПриВыполненииЗапросаВозниклаОшибкиСоединения(ДанныеЗапроса) Тогда
				БылиОшибкиПриПолучении = Истина;
				Для каждого Идентификатор Из ДанныеЗапроса.ИдентификаторыСообщений Цикл
					Если ИдентификаторыДляПовторнойЗагрузки.Найти(Идентификатор) = Неопределено Тогда
						КоличествоНовыхИдентификаторов = КоличествоНовыхИдентификаторов + 1;
					КонецЕсли;
				КонецЦикла;
				ЗапросыСОшибкойОтправки.Добавить(Результат.ДанныеЗапроса);
				СчетчикОшибок = СчетчикОшибок + 1;
			КонецЕсли;
			СчетчикВсего = СчетчикВсего + 1;
		КонецЦикла;
	КонецЦикла;
	
	Если БылиОшибкиПриПолучении Тогда

		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Запросы", ЗапросыСОшибкойОтправки);
		ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", ОповещениеОбратногоВызова);
		ДополнительныеПараметры.Вставить("РезультатПолучения", РезультатПолучения);
		ДополнительныеПараметры.Вставить("БылВыведенДиалогВключенияЗадания", Ложь);
		
		Если НЕ ВключеноЗаданиеФоновогоОбменаСЭДО()
			ИЛИ КоличествоНовыхИдентификаторов > 0 Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"АнализОшибокПолученияСообщенийПослеВопроса",
				ЭтотОбъект,
				ДополнительныеПараметры);
				
			ДополнительныеПараметры.БылВыведенДиалогВключенияЗадания = Истина;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СчетчикВсего", СчетчикВсего);
			ПараметрыФормы.Вставить("СчетчикОшибок", СчетчикОшибок);
			ОткрытьФорму(
				"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ПодключениеЗаданияПолученияСообщенийСЭДО",
				ПараметрыФормы, , , , ,
				ОписаниеОповещения,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Возврат Истина;
			
		Иначе
			
			АнализОшибокПолученияСообщенийПослеВопроса(Истина, ДополнительныеПараметры); 
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения);

КонецФункции

&НаСервереБезКонтекста
Функция ВключеноЗаданиеФоновогоОбменаСЭДО()
	
	Возврат ЭлектронныйДокументооборотСФСС.ВключеноЗаданиеФоновогоОбменаСЭДО();
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьДляДанныеФоновогоЗаданияЗагрузкиИзСЭДО(ЗапросыСОшибкойВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Счетчик = 0;
	Для каждого Запрос Из ЗапросыСОшибкойВыполнения Цикл
		Запись = РегистрыСведений.ЗапросыДляПовторнойОтправкиСЭДО.СоздатьМенеджерЗаписи();
		Запись.Организация = Запрос.Организация;
		Идентификатор = Запрос.ИдентификаторыСообщений[0];
		Запись.Идентификатор = Идентификатор;
		Запись.Прочитать();
		ЗаполнитьЗначенияСвойств(Запись, Запрос);
		Если НЕ ЗначениеЗаполнено(Запись.Идентификатор) Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
		Запись.Идентификатор = Идентификатор;
		Если НЕ ЭтоАдресВременногоХранилища(Запрос.АдресЗашифрованногоЗапросаSOAP) Тогда
			Шаблон = НСтр("ru = 'Не заполнен адрес зашифрованного запроса. Код ошибки %1, текст ошибки: %2';
							|en = 'Не заполнен адрес зашифрованного запроса. Код ошибки %1, текст ошибки: %2'");
			ТекстОшибки = СтрШаблон(Шаблон, Запрос.КодСостояния, Запрос.ТекстОшибки);
			ЗаписатьСобытиеСЭДОВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
			Продолжить;
		КонецЕсли;
		ТекстЗапроса = ПолучитьИзВременногоХранилища(Запрос.АдресЗашифрованногоЗапросаSOAP);
		Запись.ДанныеЗапроса = Новый ХранилищеЗначения(ТекстЗапроса, Новый СжатиеДанных(9));
		ТекстЗапроса = СтрокаИзДанныхПоАдресу(Запрос.АдресПодписаногоЗапросаSOAP);
		Запись.ДанныеПодписаногоЗапроса = Новый ХранилищеЗначения(ТекстЗапроса, Новый СжатиеДанных(9));
		Если НЕ ЗначениеЗаполнено(Запись.Дата) Тогда
			Запись.Дата = ТекущаяДатаНаСервере();
		КонецЕсли;
		Запись.ДатаПопыткиПодключения = ТекущаяДатаНаСервере();
		Запись.ОписаниеОшибки = Запрос.ТекстОшибки;
		Попытка
			Запись.Записать();
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Шаблон = НСтр("ru = 'При записи данных регистра ЗапросыДляПовторнойОтправкиСЭДО возникла ошибка:';
							|en = 'При записи данных регистра ЗапросыДляПовторнойОтправкиСЭДО возникла ошибка:'")
				+ Символы.ПС + "%1";
			ТекстОшибки = СтрШаблон(Шаблон, ТекстОшибки);
			ЗаписатьСобытиеСЭДОВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
			Результат.ОписаниеОшибки = НСтр("ru = 'При добавлении записи в регистр ""Запросы для повторной отправки в СЭДО"" возникла ошибка.';
											|en = 'При добавлении записи в регистр ""Запросы для повторной отправки в СЭДО"" возникла ошибка.'");
			Возврат Результат;
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЭлектронныйДокументооборотСФСС.ВключитьФоновыйОбменСЭДО();
	
	ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
	ВыведенСчетчик = Ложь;
	Если Счетчик > 0 Тогда 
		ТекстКоличестваСообщений = ПолучитьСклоненияСтрокиПоЧислу("сообщение", Счетчик, "",
			"ЧС=Количественное", "ПД=Именительный");
		Шаблон = НСтр("ru = 'К очереди фоновой загрузки СЭДО добавлено %1.';
						|en = 'К очереди фоновой загрузки СЭДО добавлено %1.'");
		ТекстСообщения = СтрШаблон(Шаблон, ТекстКоличестваСообщений[0]);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстСообщения, ПараметрыВывода);
		ВыведенСчетчик = Истина;
	КонецЕсли;
	
	Статистика = ЭлектронныйДокументооборотСФСС.КоличествоЗапросовВОчередиАвтоматическойЗагрузки();
	Если Статистика.КоличествоЗапросов > 0
		И НЕ Статистика.КоличествоЗапросов = Счетчик Тогда
		ОбщееКоличество = ПолучитьСклоненияСтрокиПоЧислу("сообщение", Статистика.КоличествоЗапросов, "",
			"ЧС=Количественное", "ПД=Именительный");
		Если ВыведенСчетчик Тогда
			Шаблон = НСтр("ru = 'Всего в очереди фоновой загрузки %1.';
							|en = 'Всего в очереди фоновой загрузки %1.'");
		Иначе
			Шаблон = НСтр("ru = 'Включена фоновая загрузка с сервера СЭДО, в очереди %1.';
							|en = 'Включена фоновая загрузка с сервера СЭДО, в очереди %1.'");
		КонецЕсли;
		ТекстСообщения = СтрШаблон(Шаблон, ОбщееКоличество[0]);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстСообщения, ПараметрыВывода);
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСобытиеСЭДОВЖурнал(Знач Уровень, ТекстСобытия, Данные = Неопределено)
	
	Если ТипЗнч(Уровень) = Тип("Строка") Тогда
		Уровень = УровеньСобытияПоПредставлению(Уровень);
	КонецЕсли;
	
	КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Событие = НСтр("ru = 'Обмен с СЭДО СФР';
					|en = 'Обмен с СЭДО СФР'", КодОсновногоЯзыка);
	ЗаписьЖурналаРегистрации(Событие, Уровень, , Данные, ТекстСобытия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УровеньСобытияПоПредставлению(ПредставлениеУровня)
	
	Если ПредставлениеУровня = "Информация" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли ПредставлениеУровня = "Ошибка" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли ПредставлениеУровня = "Предупреждение" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение; 
	ИначеЕсли ПредставлениеУровня = "Примечание" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	Иначе
		Возврат УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция НовыйЗапросКСерверуСЭДО()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторыСообщений", Новый Массив);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("АдресЗашифрованногоЗапросаSOAP", "");
	Результат.Вставить("АдресПодписаногоЗапросаSOAP", "");
	Результат.Вставить("АдресРасшифрованногоОтветаSOAP", "");
	Результат.Вставить("Операция", "");
	Результат.Вставить("ТипВзаимодействия", 0);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("АдресСервера", "");
	Результат.Вставить("АдресРесурса", "");
	Результат.Вставить("ОшибкаСоединения", Ложь); 
	Результат.Вставить("ТипСообщения", 0); 
	
	Возврат Результат;
	
КонецФункции

