&НаСервереБезКонтекста
Функция ЭтоФорматПриказ534(ЦиклОбмена) Экспорт
	
	Возврат ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьДокументыЦикловОбмена(
		ПечатаемыеЦиклыОбмена, 
		ЭтоПечатьБезВыбораВидаПротоколов = Ложь, 
		ПечатаемыеТранспортныеСообщения = Неопределено, 
		РезультатНастройки = Неопределено) Экспорт
	
	Если ТипЗнч(ПечатаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ПечатаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ПечатаемыеЦиклыОбмена;
	КонецЕсли;
	Если ЦиклыОбмена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбраны циклы обмена для печати!");
		Возврат;
	КонецЕсли;
	
	Если ЭтоПечатьБезВыбораВидаПротоколов Тогда
		
		// Печатаем без выбора вида протоколов
		Если ТипЗнч(ПечатаемыеТранспортныеСообщения) <> Тип("Массив") И ПечатаемыеТранспортныеСообщения <> Неопределено Тогда
			ТранспортныеСообщения = Новый Массив;
			ТранспортныеСообщения.Добавить(ПечатаемыеТранспортныеСообщения);
		Иначе
			ТранспортныеСообщения = ПечатаемыеТранспортныеСообщения;
		КонецЕсли;
		
		Если РезультатНастройки = Неопределено Тогда 
			РезультатНастройки = ПротоколыДляПечати(ЦиклыОбмена, ТранспортныеСообщения);
		КонецЕсли;
		 
	 	// Определяем, есть ли протоколы для печати
		ЕстьПротоколыДляПечати = Ложь; 
		Для каждого ВыбранныйПротокол Из РезультатНастройки Цикл
			Если ВыбранныйПротокол.Значение = Истина Тогда
				ЕстьПротоколыДляПечати = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьПротоколыДляПечати Тогда
			ПредупредитьОбОтсутствииПротокола();
			Возврат;
		КонецЕсли;
		
		Если ТранспортныеСообщения <> Неопределено 
			И ТипЗнч(ТранспортныеСообщения) = Тип("Массив")
			И ТранспортныеСообщения.Количество() = 1 Тогда
			РезультатНастройки.Вставить("ТранспортноеСообщение", ТранспортныеСообщения[0]);
		КонецЕсли;

		СформироватьИПоказатьПротоколы(РезультатНастройки, ЦиклыОбмена);
		 
	Иначе
		// Печатаем с выбором вида протокола
		
		// анализируем формат документооборота
		// для ФНС 534 вызываем отдельную форму настройки
		Если ЭтоФорматПриказ534(ЦиклыОбмена[0]) Тогда 
			
			Оповещение = Новый ОписаниеОповещения("СформироватьИПоказатьПротоколы", ЭтотОбъект, ЦиклыОбмена);
			
			СтруктураПараметров = Новый Структура("ЦиклыОбмена", ЦиклыОбмена);
			ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкиГрупповойПечати534", СтруктураПараметров,  ,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
				
			Оповещение = Новый ОписаниеОповещения("СформироватьИПоказатьПротоколы", ЭтотОбъект, ЦиклыОбмена);
			
			СтруктураПараметров = Новый Структура("ЦиклыОбмена", ЦиклыОбмена);
			ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкиГрупповойПечати", СтруктураПараметров, ,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбОтсутствииПротокола() Экспорт
	
	ТекстПредупреждения = НСтр("ru = 'Просмотр протоколов возможен только после отправки
					|и получения ответа от контролирующих органов';
					|en = 'Просмотр протоколов возможен только после отправки
					|и получения ответа от контролирующих органов'");
	ПоказатьПредупреждение(,ТекстПредупреждения);
	
КонецПроцедуры


&НаСервере
Функция ПротоколыДляПечати(ЦиклыОбмена = Неопределено, ТранспортныеСообщения = Неопределено) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПротоколыДляПечати(ЦиклыОбмена, ТранспортныеСообщения);

КонецФункции

&НаКлиенте
Процедура СформироватьИПоказатьПротоколы(РезультатНастройки, ЦиклыОбмена) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоФорматПриказ534(ЦиклыОбмена[0]) Тогда
		РезультатНастройки.Вставить("ФорматДокументооборота", СтруктураСсылочныхДанных["Перечисления_ФорматыДокументооборотаСФНС_Приказ534"]);
	КонецЕсли;
	
	Для Инд = 1 По ЦиклыОбмена.Количество() Цикл
		СформироватьИПоказатьПечатныеДокументы(ЦиклыОбмена[Инд - 1], РезультатНастройки);
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчетыОСостоянииЦикловОбмена(ПечатаемыеЦиклыОбмена) Экспорт
	
	Если ТипЗнч(ПечатаемыеЦиклыОбмена) <> Тип("Массив") Тогда
		ЦиклыОбмена = Новый Массив;
		ЦиклыОбмена.Добавить(ПечатаемыеЦиклыОбмена);
	Иначе
		ЦиклыОбмена = ПечатаемыеЦиклыОбмена;
	КонецЕсли;
	
	Для Инд = 1 По ЦиклыОбмена.Количество() Цикл
		СформироватьИПоказатьПечатныеДокументы(ЦиклыОбмена[Инд - 1], Новый Структура("ПечататьСостояние", Истина));
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИПоказатьПечатныеДокументы(ЦиклОбмена, Настройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЦиклОбмена", ЦиклОбмена);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьИПоказатьПечатныеДокументыПослеПолученияПечатныхДокументов",
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	// Настройки дополняем недостающими свойствами
	ДополнитьНастройкиПечати(Настройки);
	
	СформироватьПечатныеДокументы(ЦиклОбмена, Настройки, ОписаниеОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьНастройкиПечати(Настройки) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДополнитьНастройкиПечати(Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИПоказатьПечатныеДокументыПослеПолученияПечатныхДокументов(ПечатныеДокументы, ВходящийКонтекст) Экспорт
	
	Если ПечатныеДокументы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		ЭтоВебКлиент = Истина;
	#Иначе
		ЭтоВебКлиент = Ложь;
	#КонецЕсли
	
	ЦиклОбмена = ВходящийКонтекст.ЦиклОбмена;
	
	НачальноеЗначениеВыбора = Новый Структура("ЦиклОбмена, ПечатныеДокументы, ЭтоВебКлиент", 
		ЦиклОбмена, ПечатныеДокументы, ЭтоВебКлиент);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредварительныйПросмотрПечатныхФорм", НачальноеЗначениеВыбора,,Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитНаСервере(ОбъектДляЧтения, ИмяРеквизита) Экспорт
	МетаданныеОбъекта = ОбъектДляЧтения.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда 
		Возврат ОбъектДляЧтения[ИмяРеквизита];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ПоместитьПодписиВТаблицу()

	// помещаем подписи абонента в результирующую таблицу
	Если ЗначениеЗаполнено(ПодписиАбонента) Тогда
		Для Каждого ПодписьАбонента Из ПодписиАбонента Цикл
			
			Если ТаблицаПодписей.НайтиСтроки(Новый Структура("Файл", ПодписьАбонента.Файл)).Количество() = 0 Тогда
				
				НовСтр = ТаблицаПодписей.Добавить();
				НовСтр.ИмяФайла = ПодписьАбонента.ИмяФайла;
				НовСтр.Файл     = ПодписьАбонента.Файл;
				НовСтр.ТранспортноеСообщение = ПодписьАбонента.ТранспортноеСообщение;
				НовСтр.ЭЦПЭтоПодписьАбонента = Истина;
				
				Отправитель = ПолучитьРеквизит(ПодписьАбонента.ТранспортноеСообщение, "Отправитель");
				ОтправительЭтоАбонент = ТипЗнч(Отправитель) = Тип("СправочникСсылка.Организации");
				
				Если ОтправительЭтоАбонент Тогда
					НовСтр.Порядок = 1;
				Иначе
					НовСтр.Порядок = 2;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// помещаем подписи контрагента в результирующую таблицу
	Если ЗначениеЗаполнено(ПодписиКонтрагента) Тогда
			
		Для Каждого ПодписьКонтрагента Из ПодписиКонтрагента Цикл
			Если ТаблицаПодписей.НайтиСтроки(Новый Структура("Файл", ПодписьКонтрагента.Файл)).Количество() = 0 Тогда
				
				НовСтр = ТаблицаПодписей.Добавить();
				НовСтр.ИмяФайла = ПодписьКонтрагента.ИмяФайла;
				НовСтр.Файл     = ПодписьКонтрагента.Файл;
				НовСтр.ТранспортноеСообщение = ПодписьКонтрагента.ТранспортноеСообщение;
				НовСтр.ЭЦПЭтоПодписьАбонента = Ложь;
				
				Отправитель = ПолучитьРеквизит(ПодписьКонтрагента.ТранспортноеСообщение, "Отправитель");
				ОтправительЭтоНеАбонент = ТипЗнч(Отправитель) <> Тип("СправочникСсылка.Организации");
				
				Если ОтправительЭтоНеАбонент Тогда
					НовСтр.Порядок = 1;
				Иначе
					НовСтр.Порядок = 2;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаПодписей.Сортировать("ТранспортноеСообщение, Порядок");

КонецПроцедуры
               
