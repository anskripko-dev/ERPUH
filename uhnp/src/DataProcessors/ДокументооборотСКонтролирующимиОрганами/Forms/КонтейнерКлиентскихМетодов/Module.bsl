	Иначе
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("ВидНастроек", ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСРАР"));
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаНастроекДокументооборотаОрганизаций", ПараметрыОткрытия,,Новый УникальныйИдентификатор,Окно);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиЭДОсРПН(Организация, ФормаВладелец = Неопределено, Окно = Неопределено) Экспорт 
	
