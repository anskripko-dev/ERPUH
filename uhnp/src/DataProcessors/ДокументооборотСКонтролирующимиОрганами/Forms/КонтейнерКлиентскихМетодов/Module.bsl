Функция ТекущаяПлатформаСоответствуетУзлу(УзелПлатформа, ВерсияТекущейПлатформы)
	
	РезультатПоискаАтрибута = УзелПлатформа.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "Верс", "А"));
	Если РезультатПоискаАтрибута.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		ШаблонВерсии = СокрЛП(РезультатПоискаАтрибута[0].Значение);
		Возврат ВерсияТекущейПлатформыСоответствуетШаблону(ВерсияТекущейПлатформы, ШаблонВерсии);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВерсияТекущейПлатформыСоответствуетШаблону(ВерсияТекущейПлатформы, ШаблонВерсии)
	
	МассивЧастейШаблона = РегламентированнаяОтчетностьКлиентСервер.РазобратьСтрокуВМассивПоРазделителю(ШаблонВерсии);
	МассивЧастейТекущейВерсии = РегламентированнаяОтчетностьКлиентСервер.РазобратьСтрокуВМассивПоРазделителю(ВерсияТекущейПлатформы);
	
	Для Инд = 0 По МассивЧастейШаблона.Количество() - 1 Цикл
		Если МассивЧастейТекущейВерсии.Количество() <= Инд Тогда
			Прервать;
		КонецЕсли;
		ТекущаяЧастьШаблона = МассивЧастейШаблона[Инд];
		ТекущаяЧастьТекущейВерсии = МассивЧастейТекущейВерсии[Инд];
		Если НЕ ЧастьВерсииСоответствуетЧастиШаблонаВерсии(ТекущаяЧастьТекущейВерсии, ТекущаяЧастьШаблона) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧастьВерсииСоответствуетЧастиШаблонаВерсии(Знач ЧастьТекущейВерсии, Знач ЧастьШаблона)
	
	ЧастьТекущейВерсии = СокрЛП(ЧастьТекущейВерсии);
	ЧастьШаблона = СокрЛП(ЧастьШаблона);
	
	Если Лев(ЧастьШаблона, 1) <> "[" ИЛИ Прав(ЧастьШаблона, 1) <> "]" Тогда
		Возврат (ЧастьШаблона = ЧастьТекущейВерсии);
	КонецЕсли;
	
	ЧастьШаблона = СокрЛП(Сред(ЧастьШаблона, 2, СтрДлина(ЧастьШаблона) - 2));
	СоставляющиеЧастиШаблона = РегламентированнаяОтчетностьКлиентСервер.РазобратьСтрокуВМассивПоРазделителю(ЧастьШаблона, ",");
	Если СоставляющиеЧастиШаблона.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИДПеременной = "X";
	Для Каждого Составляющее Из СоставляющиеЧастиШаблона Цикл
		Если ЗначениеЗаполнено(Составляющее) Тогда
			ТекстСоставляющего = СтрЗаменить(Составляющее, ИДПеременной, ЧастьТекущейВерсии);
			РезультатВычисления = Неопределено;
			Попытка
				РезультатВычисления = ОбщегоНазначения.ВычислитьВБезопасномРежиме(ТекстСоставляющего);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Свойства внешнего модуля';
						|en = 'Электронный документооборот с контролирующими органами. Свойства внешнего модуля'"),
					УровеньЖурналаРегистрации.Ошибка,,,
					ТекстОшибки);
			КонецПопытки;
			
			Если ТипЗнч(РезультатВычисления) <> Тип("Булево") ИЛИ НЕ РезультатВычисления Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭлектронныйДокументооборотИспользуетсяКлиент(УчитыватьФССФСРАРРПНиФТС = Ложь)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	КОЛИЧЕСТВО(Организации.Ссылка) КАК Ссылка
						  |ИЗ
						  |	Справочник.Организации КАК Организации
						  |ГДЕ
						  |	Организации.ВидОбменаСКонтролирующимиОрганами = &ВидОбменаСКонтролирующимиОрганами
						  |	И Организации.УчетнаяЗаписьОбмена <> &ПустаяУчетнаяЗаписьОбмена
						  |	И Организации.ПометкаУдаления = &ПометкаУдаления
						  |	И Организации.УчетнаяЗаписьОбмена.ПометкаУдаления = &ПометкаУдаления");
	Запрос.УстановитьПараметр("ВидОбменаСКонтролирующимиОрганами", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	Запрос.УстановитьПараметр("ПустаяУчетнаяЗаписьОбмена", Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
	
	Результат = Неопределено;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Если Выборка.Следующий() Тогда
			Результат = ЗначениеЗаполнено(Выборка.Получить(0));
			
		Иначе
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Результат И УчитыватьФССФСРАРРПНиФТС Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
							  |	КОЛИЧЕСТВО(НастройкиОбменаФСС.ИспользоватьОбмен) КАК ИспользоватьОбмен
							  |ИЗ
							  |	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
							  |ГДЕ
							  |	НастройкиОбменаФСС.ИспользоватьОбмен = &ИспользоватьОбмен
							  |	И НастройкиОбменаФСС.Организация <> &ПустаяОрганизация
							  |	И НастройкиОбменаФСС.Организация.ПометкаУдаления = &ПометкаУдаления
							  |	И (НастройкиОбменаФСС.Пользователь ЕСТЬ NULL
							  |	ИЛИ НастройкиОбменаФСС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))");
		Запрос.УстановитьПараметр("ИспользоватьОбмен", Истина);
		Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());
		Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
		
		Результат = Неопределено;
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Результат = Ложь;
		КонецПопытки;
		
		Если Результат = Неопределено Тогда
			Если Выборка.Следующий() Тогда
				Результат = ЗначениеЗаполнено(Выборка.Получить(0));
				
			Иначе
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ Результат Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
								  |	КОЛИЧЕСТВО(НастройкиОбменаФСРАР.ИспользоватьОбмен) КАК ИспользоватьОбмен
								  |ИЗ
								  |	РегистрСведений.НастройкиОбменаФСРАР КАК НастройкиОбменаФСРАР
								  |ГДЕ
								  |	НастройкиОбменаФСРАР.ИспользоватьОбмен = &ИспользоватьОбмен
								  |	И НастройкиОбменаФСРАР.Организация <> &ПустаяОрганизация
								  |	И НастройкиОбменаФСРАР.Организация.ПометкаУдаления = &ПометкаУдаления
								  |	И (НастройкиОбменаФСРАР.Пользователь ЕСТЬ NULL
								  |	ИЛИ НастройкиОбменаФСРАР.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))");
			Запрос.УстановитьПараметр("ИспользоватьОбмен", Истина);
			Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());
			Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
			
			Результат = Неопределено;
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				Результат = Ложь;
			КонецПопытки;
			
			Если Результат = Неопределено Тогда
				Если Выборка.Следующий() Тогда
					Результат = ЗначениеЗаполнено(Выборка.Получить(0));
					
				Иначе
					Результат = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ Результат Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
									  |	КОЛИЧЕСТВО(НастройкиОбменаРПН.ИспользоватьОбмен) КАК ИспользоватьОбмен
									  |ИЗ
									  |	РегистрСведений.НастройкиОбменаРПН КАК НастройкиОбменаРПН
									  |ГДЕ
									  |	НастройкиОбменаРПН.ИспользоватьОбмен = &ИспользоватьОбмен
									  |	И НастройкиОбменаРПН.Организация <> &ПустаяОрганизация
									  |	И НастройкиОбменаРПН.Организация.ПометкаУдаления = &ПометкаУдаления
									  |	И (НастройкиОбменаРПН.Пользователь ЕСТЬ NULL
									  |	ИЛИ НастройкиОбменаРПН.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))");
				Запрос.УстановитьПараметр("ИспользоватьОбмен", Истина);
				Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());
				Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
				
				Результат = Неопределено;
				Попытка
					Выборка = Запрос.Выполнить().Выбрать();
				Исключение
					Результат = Ложь;
				КонецПопытки;
				
				Если Результат = Неопределено Тогда
					Если Выборка.Следующий() Тогда
						Результат = ЗначениеЗаполнено(Выборка.Получить(0));
						
					Иначе
						Результат = Ложь;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ Результат Тогда
					Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
										  |	КОЛИЧЕСТВО(НастройкиОбменаФТС.ИспользоватьОбмен) КАК ИспользоватьОбмен
										  |ИЗ
										  |	РегистрСведений.НастройкиОбменаФТС КАК НастройкиОбменаФТС
										  |ГДЕ
										  |	НастройкиОбменаФТС.ИспользоватьОбмен = &ИспользоватьОбмен
										  |	И НастройкиОбменаФТС.Организация <> &ПустаяОрганизация
										  |	И НастройкиОбменаФТС.Организация.ПометкаУдаления = &ПометкаУдаления
										  |	И (НастройкиОбменаФТС.Пользователь ЕСТЬ NULL
										  |	ИЛИ НастройкиОбменаФТС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))");
					Запрос.УстановитьПараметр("ИспользоватьОбмен", Истина);
					Запрос.УстановитьПараметр("ПустаяОрганизация", Справочники.Организации.ПустаяСсылка());
					Запрос.УстановитьПараметр("ПометкаУдаления", Ложь);
					
					Результат = Неопределено;
					Попытка
						Выборка = Запрос.Выполнить().Выбрать();
					Исключение
						Результат = Ложь;
					КонецПопытки;
					
					Если Результат = Неопределено Тогда
						Если Выборка.Следующий() Тогда
							Результат = ЗначениеЗаполнено(Выборка.Получить(0));
							
						Иначе
							Результат = Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
