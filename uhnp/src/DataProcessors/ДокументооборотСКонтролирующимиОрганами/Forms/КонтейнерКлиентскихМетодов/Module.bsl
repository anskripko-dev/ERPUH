		КонецЕсли;
	
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Процедура ПоказатьОтветыНаОбращениеСФРКСтрахователю(Обращение) Экспорт
	
	Ответы = ОтветыНаОбращениеСФРКСтрахователю(Обращение);
	
	Если Ответы.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Ответы отсутствуют';
								|en = 'Ответы отсутствуют'");
		ПоказатьПредупреждение(, ТекстСообщения);;
		Возврат;
		
	КонецЕсли;
		
	Если Ответы.Количество() = 1 Тогда
		
		ПоказатьЗначение(, Ответы[0])
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Ответы", Ответы);
	
		ОткрытьФорму(
			"Обработка.ДокументооборотСКонтролирующимиОрганами.Форма.ОтветыНаОбращенияСФР",
			ДополнительныеПараметры,,
			Новый УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

