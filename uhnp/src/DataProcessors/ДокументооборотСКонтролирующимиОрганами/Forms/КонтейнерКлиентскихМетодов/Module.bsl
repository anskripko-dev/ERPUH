&НаКлиенте
Процедура ОткрытьСписокДоверенностейИлиИнструкцию(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка, Организация) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "доверенность" Тогда
		
		ОткрытьФорму("Справочник.ДоверенностиНалогоплательщика.ФормаСписка",,Организация);

	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "МЧД" Тогда
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Раздел", ПредопределенноеЗначение("Перечисление.СтраницыЖурналаОтчетность.Уведомления"));
		ПараметрыОткрытия.Вставить("Организация", Организация);
		
		ОткрытьФорму("ОбщаяФорма.РегламентированнаяОтчетность", ПараметрыОткрытия);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "регистрации" Тогда
		
		ЗначениеОтбора = Новый Структура("Владелец", Организация);
		ПараметрыВыбора = Новый Структура("Отбор", ЗначениеОтбора);

		ОткрытьФорму("Справочник.РегистрацииВНалоговомОргане.ФормаСписка", ПараметрыВыбора);
		
	Иначе
		ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта("https://its.1c.ru/bmk/elreps/authorised_representative_pers");
	КонецЕсли;
	
КонецПроцедуры

#Область ОповещениеОбОдобренииИлиОтклоненииЗаявления

#Область ОбвновлениеЗаявленийЧерезФормуОповещения

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_Контейнер(Результат, ВходящийКонтекст) Экспорт
	
	ЕстьОтправленныеЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов(,,,,Истина).Количество() > 0;
	
	Если ЕстьОтправленныеЗаявления Тогда
		
		Заявление = ОбработкаЗаявленийАбонентаВызовСервера.СледующееЗаявлениеТребующееРеакцииПользователя();
		
		Если ЗначениеЗаполнено(Заявление) Тогда
			
			Если ОбработкаЗаявленийАбонентаКлиент.ФормаОповещенияИлиМастераУжеОткрыта() Тогда
				
				// Проверим позже
				ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
				
			Иначе
				
				РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
				ЭтоЗаявлениеНаПодключение = РеквизитыЗаявления.ЭтоУпрощенноеЗаявление;
				
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("Заявление", 				Заявление);
				ДополнительныеПараметры.Вставить("РеквизитыЗаявления",  	РеквизитыЗаявления);
				ДополнительныеПараметры.Вставить("ЭтоЗаявлениеНаПодключение",  ЭтоЗаявлениеНаПодключение);
				 
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"СообщитьОбОдобренныхЗаявленияхАбонента_ПослеЗакрытияФормыОповещения", 
					ЭтотОбъект,
					ДополнительныеПараметры);
				
				Если ТребуетсяНастройкаЭДО(РеквизитыЗаявления) Тогда
						
					ОткрытьФормуОтправкиДанныхОператоруЭДО(Заявление, ОписаниеОповещения, Истина); // При входе в программу
						
				Иначе
					
					Ответ = ПолучитьОтветСервераНаЗаявлениеАбонента(Заявление);
	
					РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
					РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
					
					Если РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета") Тогда
						СообщитьОбОтсутствииИнтернета(ВходящийКонтекст, РезультатОтветаСервера);
						Возврат;
					КонецЕсли;
					
					ВходящийКонтекст = Новый Структура;
					ВходящийКонтекст.Вставить("РеквизитыДокумента", РеквизитыДокумента);
					
					ЗаявлениеТребуетНастройки = НЕ РеквизитыДокумента.НастройкаЗавершена
						И (РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
						ИЛИ РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"));
						
					// Открываем форму настройки только если настройка требуется
					СтатусИзменился = РезультатОтветаСервера.СтатусИзменился ИЛИ ЗаявлениеТребуетНастройки;
						
					Если СтатусИзменился Тогда
						
						ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
						
						ОткрытьФормуЗавершенияНастройкиМастера(
							Заявление, 
							ВходящийКонтекст, 
							ОписаниеОповещения);
							
					Иначе
						ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			// Отключения обработчика не делаем,
			// так как заявление может изменить статус, а обработчик будет отключен.
			// Отключим только если нет ни одного отправленного.
			
			// Проверим позже
			ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
		
		КонецЕсли;
	
	Иначе
		
		// Отключаем только в случае, если нет отправленных.
		ОбработкаЗаявленийАбонентаКлиент.ОтключитьОбработчикПроверкиЗаявлений();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_ПослеЗакрытияФормыОповещения(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		
		// Проверим следующее заявление
		ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
			
	Иначе
		
		// Обработчик ожидания подключается позже в процедуре СообщитьОбОдобренныхЗаявленияхАбонента_Завершение
		
		// После настройки проверяем следующее заявление (если есть)
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СообщитьОбОдобренныхЗаявленияхАбонента_Завершение", 
			ЭтотОбъект);
		
		Если ТипЗнч(Результат) = Тип("Структура")
			И Результат.Свойство("СоздатьНовоеЗаявление") Тогда
			// Заявление было отклонено, поэтому вместо завершения настройки созданием новое копированием
			
			Результат.Вставить("ВыполняемоеОповещение", ОписаниеОповещения);
			ОткрытьФормуЗаявления(Результат);
			
		ИначеЕсли ВходящийКонтекст.ЭтоЗаявлениеНаПодключение Тогда
			
			// Завершение настройки выполняется внутри той же формы, а не в отдельной
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе
			
			ОткрытьФормуЗавершенияНастройкиМастера(
				ВходящийКонтекст.Заявление, 
				Результат, 
				ОписаниеОповещения);
				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОдобренныхЗаявленияхАбонента_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ОбработкаЗаявленийАбонентаКлиент.ПодключитьОбработчикПроверкиЗаявлений();
	
КонецПроцедуры

#КонецОбласти

#Область ОбвновлениеЗаявленийИзФормыСпискаИДокумента

&НаКлиенте
Процедура ОбновитьСтатусЗаявленияАбонента_ИзПанелиОтправки(ОписаниеОповещения, Форма, ДокументЗаявление) Экспорт

	Корректно = ЭтоЗаявлениеТекущегоПользователя(ДокументЗаявление, Истина);
	
	Если НЕ Корректно Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	
	Если РеквизитыЗаявления.ПометкаУдаления Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заявление помечено на удаление. Обновление состояния невозможно';
														|en = 'Заявление помечено на удаление. Обновление состояния невозможно'"));
		Возврат;
	КонецЕсли;
	
	// Обновляем состояние заявление
	// Статус не проверяем, так как при ненужном статусе не будет кнопки "Обновить" статус.
	ОбновитьСтатусыЗаявленийАбонентов_ИзФормыСписка(ДокументЗаявление, Форма.УникальныйИдентификатор, ОписаниеОповещения);
	
КонецПроцедуры
		
&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ИзФормыСписка(
		ДокументЗаявление 			= Неопределено,
		ИдентификаторФормыВладельца = "", 
		ВыполняемоеОповещение 		= Неопределено,
		ОрганизацияЗаявлений 		= Неопределено) Экспорт
	
	ЗаявленияАбонентов = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов(
		ДокументЗаявление, ОрганизацияЗаявлений,,,Истина);
		
	Если ЗаявленияАбонентов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отсутствуют отправленные заявления';
														|en = 'Отсутствуют отправленные заявления'"));
	КонецЕсли;
	
	НомерЗаявления = 0;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НомерЗаявления", 				НомерЗаявления);
	ДополнительныеПараметры.Вставить("ЗаявленияАбонентов", 			ЗаявленияАбонентов);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
	// Для того, чтобы сообщение "Статус заявления не изменился" получила нужная форма, а не бублик
	ДополнительныеПараметры.Вставить("ИдентификаторФормыВладельца", ИдентификаторФормыВладельца);
	
	ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры)
	
	// Относятся к предыдущему заявлению
	ДополнительныеПараметры.Удалить("РезультатОтветаСервера");
	ДополнительныеПараметры.Удалить("РеквизитыДокумента");
	
	НомерЗаявления 			= ДополнительныеПараметры.НомерЗаявления;
	ЗаявленияАбонентов 		= ДополнительныеПараметры.ЗаявленияАбонентов;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;

	Если НомерЗаявления + 1 > ЗаявленияАбонентов.Количество() Тогда
			
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		
	Иначе
		
		ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление(Истина, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяНастройкаЭДО(РеквизитыДокумента)
	
	ТребуетсяНастройкаЭДО = 
		РеквизитыДокумента.НастройкаЗавершена 
		И РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено")
		И НЕ РеквизитыДокумента.НастройкаЭДОЗавершена 
		И ЗначениеЗаполнено(РеквизитыДокумента.НастройкиЭДО)
		И (РеквизитыДокумента.ПодключитьЭДО ИЛИ РеквизитыДокумента.ПереиздатьСертификатЭДО);
		
	Возврат ТребуетсяНастройкаЭДО;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВходящийКонтекст) <> Тип("Структура") 
		ИЛИ НЕ ВходящийКонтекст.Свойство("НомерЗаявления") Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗаявления		= ВходящийКонтекст.НомерЗаявления;
	ЗаявленияАбонентов 	= ВходящийКонтекст.ЗаявленияАбонентов;
	ДокументЗаявление	= ЗаявленияАбонентов[НомерЗаявления];
	
	Корректно = ЭтоЗаявлениеТекущегоПользователя(ДокументЗаявление, Ложь);
	Если НЕ Корректно Тогда
		ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ВходящийКонтекст);
		Возврат;
	КонецЕсли;
	
	Ответ = ПолучитьОтветСервераНаЗаявлениеАбонента(ДокументЗаявление);
	
	РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
	РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
	
	ВходящийКонтекст.Вставить("РеквизитыДокумента", РеквизитыДокумента);
	
	Если РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета") Тогда
		СообщитьОбОтсутствииИнтернета(ВходящийКонтекст, РезультатОтветаСервера);
		Возврат;
	КонецЕсли;
	
	Если РезультатОтветаСервера.Свойство("Выполнено") И НЕ РезультатОтветаСервера.Выполнено Тогда
		ТекстОшибки = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление).СтатусКомментарий;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ВходящийКонтекст);
		Возврат;
	КонецЕсли;
	
	ТребуетсяНастройкаЭДО = ТребуетсяНастройкаЭДО(РеквизитыДокумента);
	
	ЗаявлениеТребуетНастройки = НЕ РеквизитыДокумента.НастройкаЗавершена
		И (РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
		ИЛИ РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено"));
		
	// Открываем форму настройки только если настройка требуется
	СтатусИзменился = РезультатОтветаСервера.СтатусИзменился ИЛИ ЗаявлениеТребуетНастройки;
		
	ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);

	ВыполняемоеОповещение = Новый ОписаниеОповещения(
		"ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению", 
		ЭтотОбъект, 
		ВходящийКонтекст);	
	
	Если ТребуетсяНастройкаЭДО Тогда
		
		ОткрытьФормуОтправкиДанныхОператоруЭДО(ДокументЗаявление, ВыполняемоеОповещение, Истина); // Из списка и панели отправке
		
	ИначеЕсли СтатусИзменился Тогда
		
		ОткрытьФормуЗавершенияНастройкиМастера(
			ДокументЗаявление, 
			ВходящийКонтекст, 
			ВыполняемоеОповещение);

	Иначе
			
		СообщитьОбОтсутствииИзмененияВСтатусе(ВходящийКонтекст);
		ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ВходящийКонтекст);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыЗаявленийАбонентов_ПерейтиКСледующемуЗаявлению(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыПодключаемогоОбработчикаЗаявления = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ДополнительныеПараметры);
	
	// Обход ошибок платформы, исправленных в 8.3.11
	// {#10172430#}: Дочерняя форма исчезает при переключении в другое окно, родительская форма остается заблокированной
	// {#10177195#}: Блокируется форма "1С:Отчетность"
	// Ошибка воспроизводится в случае, если форма открывается и быстро закрывается программно, 
	// хотя фактически не успела закрыться.
	ПодключитьОбработчикОжидания("Подключаемый_ПерейтиКСледующемуЗаявлению", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПерейтиКСледующемуЗаявлению()
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыПодключаемогоОбработчикаЗаявления);
	ПараметрыПодключаемогоОбработчикаЗаявления = Неопределено;
	
	ДополнительныеПараметры.НомерЗаявления = ДополнительныеПараметры.НомерЗаявления + 1;
	ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветВЦикле(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОтсутствииИзмененияВСтатусе(ДополнительныеПараметры)
	
	ИдентификаторФормыВладельца = ДополнительныеПараметры.ИдентификаторФормыВладельца;
	РеквизитыДокумента 			= ДополнительныеПараметры.РеквизитыДокумента;
	
	ШаблонСообщения = НСтр("ru = 'Статус заявления %1 от %2 не изменился';
							|en = 'Статус заявления %1 от %2 не изменился'");
	НомерЗаявления  = РеквизитыДокумента.Номер;
	ДатаЗаявления   = Формат(РеквизитыДокумента.Дата,"ДФ=dd.MM.yyyy");
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		НомерЗаявления,
		ДатаЗаявления);
			
	ДокументооборотСКОКлиентСервер.СообщитьПользователю(ТекстСообщения, ИдентификаторФормыВладельца);

КонецПроцедуры

&НаКлиенте
Функция ЭтоЗаявлениеТекущегоПользователя(Заявление, ЭтоЕдиничноеЗаявление) Экспорт
	
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(Заявление);
	
	Корректно =
		НЕ РеквизитыЗаявления.ЭтоМультиРежим
		ИЛИ РеквизитыЗаявления.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено")
		ИЛИ РеквизитыЗаявления.ЭтоМультиРежим И РеквизитыЗаявления.Ответственный = ПользователиКлиент.ТекущийПользователь();
	
	Если НЕ Корректно Тогда
		
		ТекстОшибки = НСтр("ru = 'Статус %1 может быть обновлен только пользователем %2, поскольку оно подано от лица %3.';
							|en = 'Статус %1 может быть обновлен только пользователем %2, поскольку оно подано от лица %3.'");
		
		Если ЭтоЕдиничноеЗаявление Тогда
			Представление = НСтр("ru = 'данного заявления';
								|en = 'данного заявления'");
		Иначе
			Представление = НСтр("ru = 'заявления %1 от %2';
								|en = 'заявления %1 от %2'");
			Представление = СтрШаблон(Представление, РеквизитыЗаявления.Номер, РеквизитыЗаявления.Дата);
		КонецЕсли;
			
		ТекстОшибки = СтрШаблон(ТекстОшибки,
			Представление,
			РеквизитыЗаявления.Ответственный, 
			РеквизитыЗаявления.ВладелецЭЦП);
		
		Если ЭтоЕдиничноеЗаявление Тогда
			РеквизитыЗаявления.Вставить("ИмяНовогоПользователя", ИмяПользователяИБ(РеквизитыЗаявления.Ответственный));
			МультирежимКлиент.ПредупредитьОНеобходимостиСменитьПользователя(Заявление, РеквизитыЗаявления, ТекстОшибки);
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
			
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ИмяПользователяИБ(Пользователь) Экспорт
	
	Возврат Мультирежим.ИмяПользователяИБ(Пользователь);
	
КонецФункции

#КонецОбласти

#Область ОповещениеОбОдобренииИлиОтклоненииЗаявления_СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодключитьсяК1СЭДО(Результат, ВыполняемоеОповещение)
	
	// Есть возвращаемый результат - требуется выполнить подключение ЭДО
	ПодключитьЭДО 					= Результат.ПодключитьЭДО; 
	ПереиздатьСертификатЭДО			= Результат.ПереиздатьСертификатЭДО; 
	
	Если ПодключитьЭДО ИЛИ ПереиздатьСертификатЭДО Тогда
		ОткрытьФормуОтправкиДанныхОператоруЭДО(Результат.ДокументЗаявление, ВыполняемоеОповещение); // из настройки заявления
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьПравоНастройкиЭДО()
	
	ЕстьПравоНастройкиЭДО = Истина;
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ЕстьПравоНастройкиЭДО(ЕстьПравоНастройкиЭДО);
	
	Возврат ЕстьПравоНастройкиЭДО;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО(ДокументЗаявление, ВыполняемоеОповещение, ПоказатьПредварительнуюФорму = Ложь)
	
	Если ПоказатьПредварительнуюФорму Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ДокументЗаявление",     ДокументЗаявление);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПоказаПредварительнойФормы", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ДокументЗаявление", ДокументЗаявление);
			
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.Мастер_НастройкаЭДО",
			ДополнительныеПараметры,
			,
			,
			,
			,
			ОписаниеОповещения, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
	
		НачатьОтправкиДанныхОператоруЭДО(ДокументЗаявление, ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОтправкиДанныхОператоруЭДО(ДокументЗаявление, ВыполняемоеОповещение)
	
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДокументЗаявление",     ДокументЗаявление);
	ДополнительныеПараметры.Вставить("РеквизитыЗаявления",    РеквизитыЗаявления);

	Если ЕстьПравоНастройкиЭДО() Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПолученияСертификата", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		ПолучитьДанныеЛокальногоСертификатаОрганизации(РеквизитыЗаявления.Организация, ОписаниеОповещения);
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПредупреждения", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		ПоказатьПредупреждение(ОписаниеОповещения, НСтр("ru = 'У пользователя недостаточно прав для настройки 1С-ЭДО';
														|en = 'У пользователя недостаточно прав для настройки 1С-ЭДО'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПредупреждения(ВходящийКонтекст) Экспорт
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПоказаПредварительнойФормы(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		Возврат;
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПодключенияКомпоненты", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения, Ложь,, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПодключенияКомпоненты(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		НачатьОтправкиДанныхОператоруЭДО(ВходящийКонтекст.ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
		
	Иначе
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось создать менеджер компоненты криптографии';
														|en = 'Не удалось создать менеджер компоненты криптографии'"));
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеПолученияСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось найти сертификат 1С-Отчетности на компьютере';
														|en = 'Не удалось найти сертификат 1С-Отчетности на компьютере'"));
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		Возврат;
	Иначе
		ДвДанныеЛокальногоСертификата = Base64Значение(Результат);
	КонецЕсли;
	
	ВходящийКонтекст.Вставить("ДвДанныеЛокальногоСертификата", ДвДанныеЛокальногоСертификата);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеУстановкиРасширенияДляКриптографии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Истина, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеУстановкиРасширенияДляКриптографии(Подключено, ВходящийКонтекст) Экспорт
	
	Если НЕ Подключено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось установить расширение для работы с электронной подписью и шифрованием';
														|en = 'Не удалось установить расширение для работы с электронной подписью и шифрованием'"));
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ДвДанныеЛокальногоСертификата = ВходящийКонтекст.ДвДанныеЛокальногоСертификата;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеИнициализацииСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	Сертификат = Новый СертификатКриптографии();
	Сертификат.НачатьИнициализацию(ОписаниеОповещения, ДвДанныеЛокальногоСертификата);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеИнициализацииСертификата(Сертификат, ВходящийКонтекст) Экспорт	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеЗакрытия", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	РеквизитыЗаявления = ВходящийКонтекст.РеквизитыЗаявления;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентПереопределяемый.ОткрытьФормуОтправкиДанныхОператоруЭДО(
		РеквизитыЗаявления.НастройкиЭДО, 
		Сертификат, 
		ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьФормуОтправкиДанныхОператоруЭДО_ПослеЗакрытия(Результат, ВходящийКонтекст) Экспорт
	
	ДокументЗаявление     = ВходящийКонтекст.ДокументЗаявление;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	Выполнено = Результат.Выполнено;
	Настройки = Результат.Настройки;
	
	Если Выполнено Тогда
		
		ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(
			ДокументЗаявление, 
			Новый Структура("НастройкаЭДОЗавершена", Истина));
	Иначе
		
		ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(
			ДокументЗаявление, 
			Новый Структура("НастройкиЭДО, НастройкаЭДОЗавершена", Настройки, Ложь));
		
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	
КонецПроцедуры

// Возващает СтрокаBase64 сертификата организации
// Преобразуются в ДвДанные так:
// ДвДанные = Base64Значение(СтрокаBase64);
// Возвращается строка для того, чтобы была сериализуема
//
&НаКлиенте
Процедура ПолучитьДанныеЛокальногоСертификатаОрганизации(Организация, ВыполняемоеОповещение) Экспорт
	
	НастройкиУчетнойЗаписи = НастройкиУчетнойЗаписиОрганизации(Организация);
	
	Если НастройкиУчетнойЗаписи = Неопределено Тогда
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьДанныеЛокальногоСертификатаОрганизации_ПослеПоискаСертификатаПоОтпечатку", 
		ЭтотОбъект,
		ВыполняемоеОповещение);
		
	// Асинхронно получаем ДвДанныеЛокальногоСертификата
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(ОписаниеОповещения, НастройкиУчетнойЗаписи.СертификатРуководителя, "MY",, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЛокальногоСертификатаОрганизации_ПослеПоискаСертификатаПоОтпечатку(Результат, ВыполняемоеОповещение) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьДанныеЛокальногоСертификатаОрганизации_ПослеПолученияBase64", 
		ЭтотОбъект,
		ВыполняемоеОповещение);
	
	Если Результат.Выполнено И Результат.СертификатНайден Тогда
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(ОписаниеОповещения, Результат.СвойстваСертификата, Ложь);
	Иначе
		Результат = Новый Структура();
		Результат.Вставить("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеЛокальногоСертификатаОрганизации_ПослеПолученияBase64(Результат, ВыполняемоеОповещение) Экспорт
	
	Если Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат.СтрокаBase64);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИмяФормыНастройкиЗаявления(ДокументЗаявление)

	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	ТекущееИмяФормы = ПутьКОбъекту + ".Форма.МастерФормированияЗаявкиНаПодключениеНастройкаПрограммыУпрощенный";
	
	Возврат ТекущееИмяФормы;

КонецФункции

&НаКлиенте
Функция ПолучитьОтветСервераНаЗаявлениеАбонента(ДокументЗаявление) Экспорт
	
	РезультатОтветаСервера = Новый Структура;
	РезультатОтветаСервера.Вставить("СтатусИзменился", Ложь);
	
	РеквизитыДокумента	= ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыДокумента);
	
	Ответ = Новый Структура;
	Ответ.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
	Ответ.Вставить("РеквизитыДокумента", 	 РеквизитыДокумента);
	
	// Для заявления с ЭП в модели сервиса обязательно нужно сначала получить идентификатор ключевого контейнера.
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		
		ЗаявлениеОбработано = ОбработкаЗаявленийАбонентаВызовСервера.ОбработатьИзменениеСтатусаЗаявленияАбонентаВМоделиСервиса(ДокументЗаявление);
		
		Если ЗаявлениеОбработано Тогда
			
			// Обновляем структуру реквизитов в доп. параметрах после обращения к серверу.
			РеквизитыДокумента	= ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
			
		Иначе
			
			Возврат Ответ;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// Получаем ответ от сервера.
	Если ЭтоПодписьСервиса(МестоХраненияКлюча)
		И РеквизитыДокумента.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") Тогда
		
		РезультатОтветаСервера = ОбработкаЗаявленийАбонентаВызовСервера.ШаблонРезультатаПоЗаявлению(ДокументЗаявление);
		РезультатОтветаСервера.Вставить("СтатусИзменился",	Истина);
		РезультатОтветаСервера.Вставить("Выполнено", 		Истина);
		
	Иначе
		
		РезультатОтветаСервера = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьИРазобратьОтветНаЗаявление(ДокументЗаявление,,Истина);
		
		ПолученОтветНаЗаявление = РезультатОтветаСервера.Выполнено;
		ПовторятьСоединение 	= РезультатОтветаСервера.ПовторятьСоединение;
		
		Если НЕ ПолученОтветНаЗаявление И ПовторятьСоединение Тогда
			РезультатОтветаСервера.Вставить("СообщитьОбОтсутствииИнтернета", Истина);
		Иначе
			// Обновляем структуру реквизитов в доп. параметрах после обращения к серверу.
			РеквизитыДокумента = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьСтруктуруРеквизитовЗаявления(ДокументЗаявление);
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
	Ответ.Вставить("РеквизитыДокумента", 	 РеквизитыДокумента);
	
	Оповестить(ОбработкаЗаявленийАбонентаКлиент.ИмяСобытияУспешнойОбработкиЗаявленияНаПодключение(), Ответ, ДокументЗаявление);
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура СообщитьОбОтсутствииИнтернета(ДополнительныеПараметры, РезультатОтветаСервера)
	
	ОписаниеОшибки = НСтр("ru = 'Не удалось обратиться к серверу оператора ""Калуга Астрал""';
							|en = 'Не удалось обратиться к серверу оператора ""Калуга Астрал""'");
	ОписаниеОшибки = Новый ФорматированнаяСтрока(ОписаниеОшибки, Символы.ПС, РезультатОтветаСервера.СтатусКомментарий);
	ОписаниеОшибки = ДокументооборотСКОВызовСервера.ДобавитьТекстОшибкиСертификатаКА(ОписаниеОшибки);
	
	ОписаниеОповещения 	= Новый ОписаниеОповещения("ОбновитьСтатусыЗаявленийАбонентов_ПолучитьОтветНаСледующееЗаявление", ЭтотОбъект, ДополнительныеПараметры);
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(ОписаниеОшибки, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗавершенияНастройкиМастера(
		ДокументЗаявление, 
		ВходящийКонтекст, 
		ВыполняемоеОповещение) Экспорт
	
	РезультатОтветаСервера 	= ВходящийКонтекст.РезультатОтветаСервера;
	
	Если НЕ РезультатОтветаСервера.Свойство("ИдентификаторАбонента")
		ИЛИ НЕ РезультатОтветаСервера.Свойство("Статус")
		ИЛИ НЕ РезультатОтветаСервера.Свойство("ОтпечатокСертификатаИзОтвета") Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуЗавершенияНастройкиМастераНепосредственно(
		ДокументЗаявление, 
		РезультатОтветаСервера, 
		ВыполняемоеОповещение);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьФормуЗавершенияНастройкиМастераНепосредственно(
		ДокументЗаявление, 
		РезультатОтветаСервера, 
		ВыполняемоеОповещение)
		
	СтруктураПараметров = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(РезультатОтветаСервера);
	СтруктураПараметров.Вставить("Ключ",							ДокументЗаявление);
	СтруктураПараметров.Вставить("СтруктураРеквизитовДокумента", 	ДокументЗаявление); 
	СтруктураПараметров.Вставить("ИдентификаторАбонента", 			РезультатОтветаСервера.ИдентификаторАбонента);
	СтруктураПараметров.Вставить("НовыйСтатусДокумента", 			РезультатОтветаСервера.Статус);
	СтруктураПараметров.Вставить("ОтпечатокСертификатаИзОтвета", 	РезультатОтветаСервера.ОтпечатокСертификатаИзОтвета);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуЗавершенияНастройкиЭДО_ПослеЗакрытияФормы", 
		ЭтотОбъект, 
		ВыполняемоеОповещение);
	
	ИмяФормыНастройки = ИмяФормыНастройкиЗаявления(ДокументЗаявление);
	
	ОткрытьФорму(
		ИмяФормыНастройки,
		СтруктураПараметров,,,,,
		ОписаниеОповещения, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗавершенияНастройкиЭДО_ПослеЗакрытияФормы(Результат, ВыполняемоеОповещение) Экспорт
	
	Если ЗначениеЗаполнено(Результат) 
		И ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если Результат.Свойство("ПодключитьЭДО") ИЛИ Результат.Свойство("ПереиздатьСертификатЭДО") Тогда
			// После закрытия мастера завершаем подключение к ЭДО
			ПодключитьсяК1СЭДО(Результат, ВыполняемоеОповещение);
		Иначе
			// После закрытия мастера требуется создать заявление копированием, так как на это получили отказ.
			Результат.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
			ОткрытьФормуЗаявления(Результат);
		КонецЕсли;
			
	Иначе
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии(СертификатДляПодписания, ВыполняемоеОповещение, Криптопровайдер = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СертификатДляПодписания", СертификатДляПодписания);
	ДополнительныеПараметры.Вставить("Криптопровайдер", Криптопровайдер);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьМенеджерИСертификатКриптографии_ПослеПопыткиУстановкиРасширенияРаботыСКриптографией", 
		ЭтотОбъект,
		ДополнительныеПараметры,
		"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
		ЭтотОбъект);
		
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Ложь, ОписаниеОповещения);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеПопыткиУстановкиРасширенияРаботыСКриптографией(РасширениеУстановлено, ВходящийКонтекст) Экспорт
	
	Если РасширениеУстановлено = Истина Тогда
		
		Криптопровайдер = ВходящийКонтекст.Криптопровайдер;
		Если Криптопровайдер = Неопределено Тогда
		
			// Извлекаем криптопровайдер из сертификата
			МассивИзОдного = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВходящийКонтекст.СертификатДляПодписания);
			ИнформацияОСертификате = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьИнформациюОКриптопровайдереПоСертификату(
				МассивИзОдного,
				Истина);
				
			Если ИнформацияОСертификате.Количество() > 0 Тогда
				
				СвойстваКриптопровайдера = ИнформацияОСертификате[0].Криптопровайдер;
				
				Если СвойстваКриптопровайдера = Неопределено Тогда
					
					ОписаниеОповещения = Новый ОписаниеОповещения(
						"ПолучитьМенеджерИСертификатКриптографии_ЗаполнитьСписокКриптопровайдеровЗавершение", 
						ЭтотОбъект, 
						ВходящийКонтекст);
						
					ПроверитьНаличиеКриптопровайдера(ОписаниеОповещения, Истина);
					
				Иначе
					
					СвойстваКриптопровайдера = ИнформацияОСертификате[0].Криптопровайдер;
					ПолучитьМенеджерИСертификатКриптографии_НачатьИнициализацию(СвойстваКриптопровайдера, ВходящийКонтекст);
						
				КонецЕсли;
				
			Иначе
				ОписаниеОшибки = НСтр("ru = 'Не удалось определить вид криптопровайдера из сертификата';
										|en = 'Не удалось определить вид криптопровайдера из сертификата'");
				ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
			КонецЕсли;
			
		Иначе
			
			Если Криптопровайдер = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro") Тогда
				СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.КриптопровайдерCryptoPro();
			ИначеЕсли Криптопровайдер = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet") Тогда
				СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.КриптопровайдерViPNet();
			Иначе
				ОписаниеОшибки = НСтр("ru = 'Криптопровайдер, отличный от ViPNet CSP и CryptoPro CSP, не поддерживается. 
                                       |Ваш криптопровайдер - %1';
                                       |en = 'Криптопровайдер, отличный от ViPNet CSP и CryptoPro CSP, не поддерживается. 
                                       |Ваш криптопровайдер - %1'");
				ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Строка(Криптопровайдер));
				ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
				Возврат;
			КонецЕсли;
			
			ПолучитьМенеджерИСертификатКриптографии_НачатьИнициализацию(СвойстваКриптопровайдера, ВходящийКонтекст);
			
		КонецЕсли;
		
	Иначе
		
		ОписаниеОшибки = НСтр("ru = 'Не удалось установить расширение, необходимое для работы с криптографией';
								|en = 'Не удалось установить расширение, необходимое для работы с криптографией'");
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ЗаполнитьСписокКриптопровайдеровЗавершение(Результат, ВходящийКонтекст) Экспорт
	
	CryptoProCSPУстановлен	= Результат.CryptoProCSPУстановлен;
	ViPNetCSPУстановлен 	= Результат.ViPNetCSPУстановлен;
	
	Если CryptoProCSPУстановлен Тогда
		Криптопровайдер = КриптографияЭДКОКлиентСервер.КриптопровайдерCryptoPro();
	ИначеЕсли ViPNetCSPУстановлен Тогда
		Криптопровайдер = КриптографияЭДКОКлиентСервер.КриптопровайдерViPNet();
	КонецЕсли;
	
	ПолучитьМенеджерИСертификатКриптографии_НачатьИнициализацию(Криптопровайдер, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_НачатьИнициализацию(СвойстваКриптопровайдера, ВходящийКонтекст)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииМенеджераКриптографии", 
		ЭтотОбъект,
		ВходящийКонтекст,
		"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
		ЭтотОбъект);
	
	МенеджерКриптографии = Новый МенеджерКриптографии();
	Если ОбщегоНазначенияКлиент.ЭтоMacOSКлиент() Тогда
		МенеджерКриптографии.НачатьИнициализацию(
			ОписаниеОповещения,
			СвойстваКриптопровайдера.Имя,
			СвойстваКриптопровайдера.Путь,
			СвойстваКриптопровайдера.Тип);
	Иначе
		МенеджерКриптографии.НачатьИнициализацию(
			ОписаниеОповещения,
			СвойстваКриптопровайдера.Имя,
			СвойстваКриптопровайдера.Путь,
			СвойстваКриптопровайдера.Тип,
			Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.Использовать"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата(ИнформацияОбОшибке, СтандартнаяОбработка, ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииМенеджераКриптографии(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		
		ВходящийКонтекст.Вставить("МенеджерКриптографии", Неопределено);
		ОписаниеОшибки = НСтр("ru = 'Не удалось получить менеджер для работы с криптографией';
								|en = 'Не удалось получить менеджер для работы с криптографией'");
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
		
	Иначе
		
		ВходящийКонтекст.Вставить("МенеджерКриптографии", Результат);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучитьМенеджерИСертификатКриптографии_ПослеЭкспортаСертификатаВФайл",
			ЭтотОбъект,
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВФайл(
			ОписаниеОповещения, 
			ВходящийКонтекст.СертификатДляПодписания, 
			, 
			Ложь);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеЭкспортаСертификатаВФайл(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииСертификата", 
			ЭтотОбъект,
			ВходящийКонтекст,
			"ПолучитьМенеджерИСертификатКриптографии_ОбработчикОшибкиСертификата",
			ЭтотОбъект);
			
		СертификатКриптографии = Новый СертификатКриптографии;
		СертификатКриптографии.НачатьИнициализацию(ОписаниеОповещения, Результат.ИмяФайлаСертификата); 
		
	Иначе
		ОписаниеОшибки = НСтр("ru = 'Не удалось сохранить сертификат';
								|en = 'Не удалось сохранить сертификат'");
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_ПослеИнициализацииСертификата(РезультатИнициализации, ВходящийКонтекст) Экспорт
	
	Если РезультатИнициализации <> Неопределено Тогда
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено", Истина);
		Результат.Вставить("СертификатКриптографии", 	РезультатИнициализации);
		Результат.Вставить("МенеджерКриптографии", 		ВходящийКонтекст.МенеджерКриптографии);
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	Иначе
		ОписаниеОшибки = НСтр("ru = 'Не удалось инициализировать сертификат';
								|en = 'Не удалось инициализировать сертификат'");
		ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМенеджерИСертификатКриптографии_СообщитьОНеготовностиМенеджераКриптографии(ОписаниеОшибки, ВходящийКонтекст)
	
	//   РасширениеУстановлено
	//       * Истина - Пользователь подтвердил установку, после установки расширение было успешно подключено.
	//       * Ложь   - Пользователь подтвердил установку, однако после установки расширение не удалось подключить.
	//       * Неопределено - Пользователь отказался от установки.

	Результат = Новый Структура();
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАдрес(НовыйАдрес, ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо) Экспорт
	
	Форма = ВыполняемоеОповещение.Модуль;
	СпроситьПроАвтозаполнениеАдреса = Ложь;
	
	Если НовыйАдрес.Модифицированность Тогда
		
		Если ВидАдреса = "АдресЮридический" Тогда
			ДругойАдрес = "АдресФактический";
		Иначе
			ДругойАдрес = "АдресЮридический";
		КонецЕсли;
		
		АдресЗначение       = ВидАдреса + "Значение";
		ДругойАдресЗначение = ДругойАдрес + "Значение";
			
		НовыйАдресЗаполнен    = ЗначениеЗаполнено(НовыйАдрес.АдресПредставление);
		АдресаРаньшеСовпадали = Форма[АдресЗначение] = Форма[ДругойАдресЗначение];
			
		АдресИзменился        = Форма[АдресЗначение] <> НовыйАдрес.Адрес;
		ДругойАдресПустой     = НЕ ЗначениеЗаполнено(Форма[ДругойАдресЗначение]);
		
		Форма[ВидАдреса + "Значение"] 		= НовыйАдрес.Адрес;
		Форма[ВидАдреса + "Представление"]  = НовыйАдрес.АдресПредставление;
		
		СпроситьПроАвтозаполнениеАдреса = НовыйАдресЗаполнен
			И АдресИзменился И (АдресаРаньшеСовпадали ИЛИ ДругойАдресПустой);
		
	КонецЕсли;
	
	Если СпроситьПроАвтозаполнениеАдреса Тогда
		ПредложитьАвтозаполнениеАдреса(ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьАвтозаполнениеАдреса(ВидАдреса, ВыполняемоеОповещение, ЭтоЮридическоеЛицо)
	
	Если ЭтоЮридическоеЛицо Тогда
		Если ВидАдреса = "АдресЮридический" Тогда
			ТекстВопроса = НСтр("ru = 'Заполнить фактический адрес по юридическому?';
								|en = 'Заполнить фактический адрес по юридическому?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Заполнить юридический адрес по фактическому?';
								|en = 'Заполнить юридический адрес по фактическому?'");
		КонецЕсли;
	Иначе
		Если ВидАдреса = "АдресЮридический" Тогда
			ТекстВопроса = НСтр("ru = 'Заполнить фактический адрес проживания по адресу регистрации?
                                 |Адрес регистрации также отправляется в составе заявления и доступен для изменения в форме расширенных настроек.';
                                 |en = 'Заполнить фактический адрес проживания по адресу регистрации?
                                 |Адрес регистрации также отправляется в составе заявления и доступен для изменения в форме расширенных настроек.'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Заполнить адрес регистрации по фактическому адресу проживания?';
								|en = 'Заполнить адрес регистрации по фактическому адресу проживания?'");
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидАдреса", ВидАдреса);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбновитьАдресПослеВопросаОКопированииАдреса", 
		ЭтотОбъект, 
		ДополнительныеПараметры); 
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьАдресПослеВопросаОКопированииАдреса(ОтветПользователя, ВходящийКонтекст) Экспорт
	
	Форма = ВходящийКонтекст.ВыполняемоеОповещение.Модуль;
	
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда
		Если ВходящийКонтекст.ВидАдреса = "АдресЮридический" Тогда
			Форма["АдресФактическийЗначение"]      = Форма["АдресЮридическийЗначение"];
			Форма["АдресФактическийПредставление"] = Форма["АдресЮридическийПредставление"];
		Иначе
			Форма["АдресЮридическийЗначение"]      = Форма["АдресФактическийЗначение"];
			Форма["АдресЮридическийПредставление"] = Форма["АдресФактическийПредставление"];
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Функция БесконечнаяДатаИстеченияЛицензииКриптоПро() Экспорт
	
	Возврат Дата(1899,12,30);
	
КонецФункции

&НаКлиенте
Функция ДатаИстеченияЛицензииКриптоПро() Экспорт
	
	#Если ВебКлиент Тогда
		ЛицензиюНельзяВычислить = Истина;
	#Иначе
		ЛицензиюНельзяВычислить = СтрНайти(ЭтотОбъект.ИмяФормы, "ВнешняяОбработка") > 0;
	#КонецЕсли
	
	Если ЛицензиюНельзяВычислить Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат ОбработкаЗаявленийАбонентаКлиентПовтИсп.ДатаИстеченияЛицензииКриптоПро();
	
КонецФункции

#КонецОбласти

#Область НастройкиОбмена

// Выполняет поиск сертификатов в хранилище по их серийному номеру и издателю сертификата или по отпечатку.
//
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения - описание процедуры, принимающей результат.
//    Результат - Структура:
//      * ПоискСертификатовВыполнен                - Булево.
