&НаСервереБезКонтекста
Функция ПоказатьПредупреждениеОбОтправкеНаТестовыйСерверФССПослеАвтонастройки(
		ОрганизацияОтчета,
		ЭтоДанныеЭЛН,
		ЭтоПодтверждениеВидаДеятельности)
	
	Если ЭтоПодтверждениеВидаДеятельности
		И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ПОВЭД через СЭДО", Истина) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ?(ЭтоДанныеЭЛН, ИспользоватьТестовыйСерверФССЭЛН(ОрганизацияОтчета),
		ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования())
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьОтчетДляОтправкиВФССИнициализацияНаСервере(
	ТипОтправляемогоДокумента,
	ВидОтправляемогоДокумента,
	ИмяФайлаВыгрузки = Неопределено,
	ТекстФайлаВыгрузки = Неопределено,
	ОрганизацияОтчета = Неопределено)
	
	ЭтоРеестрСтимулирующихВыплат2023 = (ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам")
		И ЗначениеЗаполнено(ТекстФайлаВыгрузки) И СтрНайти(ТекстФайлаВыгрузки, "<submit2023WorkerRegistrRequest ") > 0);
	ЭтоРеестрСтимулирующихВыплатГосслужащим = (ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам")
		И ЗначениеЗаполнено(ТекстФайлаВыгрузки) И СтрНайти(ТекстФайлаВыгрузки, "<PaymentsFederalCivilServantsRequest ") > 0);
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("ЭтоРеестрСтимулирующихВыплат2023", 		ЭтоРеестрСтимулирующихВыплат2023);
	НастройкиВызова.Вставить("ЭтоРеестрСтимулирующихВыплатГосслужащим", ЭтоРеестрСтимулирующихВыплатГосслужащим);
	
	ОтправкаЧерезСЭДО = ДокументооборотСФССКлиентСервер.ПараметрыОтправкиВидаДокументаЧерезСЭДО(
		ВидОтправляемогоДокумента,,,,
		НастройкиВызова).ОтправкаЧерезСЭДО;
	
	РасширениеФайла = ПолучитьРасширениеФайлаФССПоТипуОтправляемогоДокумента(
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		ОтправкаЧерезСЭДО);
	
	ЭтоПодтверждениеВидаДеятельности =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	
	ТекстОшибки = "";
	ДанныеФайлаВыгрузки = ТекстФайлаВыгрузки;
	Если ТекстФайлаВыгрузки <> Неопределено И ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС") Тогда
		
		ДанныеФайлаВыгрузки = ДанныеРеестраЭЛННаСервере(ТекстФайлаВыгрузки);
		
	ИначеЕсли ТипОтправляемогоДокумента =
	ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.РеестрСведенийФСС") Тогда
		
		Если СтрНайти(ИмяФайлаВыгрузки, "\") <> 0 ИЛИ СтрНайти(ИмяФайлаВыгрузки, "/") <> 0 Тогда
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Некорректное имя файла выгрузки ""%1"", проверьте языковые настройки системы.';
					|en = 'Некорректное имя файла выгрузки ""%1"", проверьте языковые настройки системы.'"),
				ИмяФайлаВыгрузки);
			
		Иначе
			СвойстваОрганизации = СвойстваОрганизацииДляОбмена(ОрганизацияОтчета, Истина, Ложь);
			Пока Истина Цикл
				Если СтрНайти(ИмяФайлаВыгрузки, "_" + СвойстваОрганизации.РегистрационныйНомерФСС + "_") <> 0
					И (СтрДлина(СвойстваОрганизации.РегистрационныйНомерФСС) <> 10
					ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СвойстваОрганизации.РегистрационныйНомерФСС)) Тогда
					
					ТекстОшибки = СтрШаблон(?(СвойстваОрганизации.ЭтоДополнительныйКодФСС,
						НСтр("ru = 'Дополнительный код ФСС в свойствах организации должен состоять из 10 цифр, текущее значение ""%1"".';
							|en = 'Дополнительный код ФСС в свойствах организации должен состоять из 10 цифр, текущее значение ""%1"".'"),
						НСтр("ru = 'Регистрационный номер ФСС в свойствах организации должен состоять из 10 цифр, текущее значение ""%1"".';
							|en = 'Регистрационный номер ФСС в свойствах организации должен состоять из 10 цифр, текущее значение ""%1"".'")),
						СвойстваОрганизации.РегистрационныйНомерФСС);
					Прервать;
				КонецЕсли;
				
				Если СвойстваОрганизации.РегистрационныйНомерФСС = СокрЛП(СвойстваОрганизации.РегистрационныйНомерФСС) Тогда
					Прервать;
				КонецЕсли;
				СвойстваОрганизации.РегистрационныйНомерФСС = СокрЛП(СвойстваОрганизации.РегистрационныйНомерФСС);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЭтоПодтверждениеВидаДеятельности Тогда
		ПозицияПрефикса = СтрНайти(ТекстФайлаВыгрузки, "<OKVEDConfirmationRequest ");
		Если ПозицияПрефикса > 0 Тогда
			ТекстФайлаВыгрузки = Сред(ТекстФайлаВыгрузки, ПозицияПрефикса);
			ТекстПостфикса = "</OKVEDConfirmationRequest>";
			ПозицияПостфикса = СтрНайти(ТекстФайлаВыгрузки, ТекстПостфикса);
			Если ПозицияПостфикса > 0 Тогда
				ДлинаПостфикса = СтрДлина(ТекстПостфикса);
				ТекстФайлаВыгрузки = Лев(ТекстФайлаВыгрузки, ПозицияПостфикса + ДлинаПостфикса - 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОтправкаЧерезСЭДО Тогда
		ДанныеФайлаВыгрузки = ДокументооборотСФССКлиентСервер.ПараметрыОтправкиВидаДокументаЧерезСЭДО(
			ВидОтправляемогоДокумента, Ложь, Ложь, ТекстФайлаВыгрузки).ТекстВыгрузки;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("РасширениеФайла", 		РасширениеФайла);
	Результат.Вставить("ТекстФайлаВыгрузки", 	ДанныеФайлаВыгрузки);
	Результат.Вставить("ТекстОшибки", 			ТекстОшибки);
	Результат.Вставить("ОтправкаЧерезСЭДО", 	ОтправкаЧерезСЭДО);
	Возврат Результат;
	
КонецФункции

