&НаСервереБезКонтекста
Функция ПолучитьПодписываемыеДанныеФСРАРНаСервере(
	Знач ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
	СлучайныйКлюч,
	Данные64CAPTCHA,
	Знач ОтправкаСсылка,
	Знач ЭтоРегламентированныйОтчет,
	Знач ПараметрыОтправки,
	ПараметрыСоединения,
	ДляРегистрации = Ложь,
	ЭтоВызовИзСписка = Ложь)
	
	ВызовИзОтправки = (ОтправкаСсылка = Неопределено); // при отправке декларации ссылки на отправку в ИБ еще нет
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	Если ПараметрыОтправки.СхемаСдачиОтчетности <> Перечисления.СхемыСдачиОтчетностиФСРАР.ТиповойРегиональныйИФедеральныйСерверы ИЛИ ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале Тогда
		Результат = КонтекстЭДО.ПолучитьПодписываемыеДанныеПорталаФСРАРССервера(СлучайныйКлюч, Данные64CAPTCHA, ПараметрыОтправки, ПараметрыСоединения, ВызовИзОтправки, ДляРегистрации);
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Результат = Неопределено И ПараметрыСоединения.ОписаниеОшибкиСервером <> НСтр("ru = 'Выполнение операции не поддерживается';
																						|en = 'Выполнение операции не поддерживается'") Тогда
		
		Если ВызовИзОтправки Тогда
			ТекстСообщения = НСтр("ru = 'Зашифрованный пакет не удалось отправить на сервер Росалкогольтабакконтроля.';
									|en = 'Зашифрованный пакет не удалось отправить на сервер Росалкогольтабакконтроля.'") + " " + ?(ЭтоРегламентированныйОтчет,
				НСтр("ru = 'Для выгрузки отчета в файл используйте меню ""Выгрузка"" - ""Выгрузить для портала ФСРАР"".';
					|en = 'Для выгрузки отчета в файл используйте меню ""Выгрузка"" - ""Выгрузить для портала ФСРАР"".'"), НСтр("ru = 'Для выгрузки отчета в файл используйте меню ""Еще"" - ""Выгрузить"".';
																																|en = 'Для выгрузки отчета в файл используйте меню ""Еще"" - ""Выгрузить"".'"))
				+ " " + НСтр("ru = 'С информацией о порядке представления отчета ознакомьтесь на сайте http://service.fsrar.ru';
							|en = 'С информацией о порядке представления отчета ознакомьтесь на сайте http://service.fsrar.ru'");
			
		Иначе
			ТекстСообщения = НСтр("ru = 'Не удалось получить результаты отправки с сервера Росалкогольтабакконтроля.';
									|en = 'Не удалось получить результаты отправки с сервера Росалкогольтабакконтроля.'");
			
			Если ЭтоВызовИзСписка Тогда
				ПредставлениеОтчетаОтправки = КонтекстЭДО.ПредставлениеОтчета(ОтправкаСсылка.ОтчетСсылка);
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = '%1 Возможно, сервер перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.';
						|en = '%1 Возможно, сервер перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.'"),
					ТекстСообщения,
					ПредставлениеОтчетаОтправки);
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыСоединения.СообщенияПользователю <> Неопределено Тогда
			ПараметрыСоединения.СообщенияПользователю.Добавить(ТекстСообщения);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

