&НаСервереБезКонтекста
Функция ПроверитьНаличиеОтветаВРегистреФоновыхЗапросов(Идентификатор)
	
	Результат = Новый Структура;
	Результат.Вставить("БылПолученОтветСервера", Ложь);
	// Поля являются подмножеством полей РезультатПолучитьДанныеСЭДОФСС().
	Результат.Вставить("АдресЗашифрованногоОтветаSOAP", "");
	Результат.Вставить("АдресРесурса", "");
	Результат.Вставить("АдресСервера", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("АдресПодписаногоЗапросаSOAP", "");
	Результат.Вставить("Операция", "");
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("ИдентификаторыСообщений", Новый Массив);
	Результат.Вставить("Организация", Неопределено);
	Результат.ИдентификаторыСообщений.Добавить(Идентификатор);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапросыДляПовторнойОтправкиСЭДО.Идентификатор КАК Идентификатор,
	               |	ЗапросыДляПовторнойОтправкиСЭДО.Организация КАК Организация,
	               |	ЗапросыДляПовторнойОтправкиСЭДО.АдресРесурса КАК АдресРесурса,
	               |	ЗапросыДляПовторнойОтправкиСЭДО.АдресСервера КАК АдресСервера,
	               |	ЗапросыДляПовторнойОтправкиСЭДО.КодСостояния КАК КодСостояния,
	               |	ЗапросыДляПовторнойОтправкиСЭДО.Операция КАК Операция
	               |ИЗ
	               |	РегистрСведений.ЗапросыДляПовторнойОтправкиСЭДО КАК ЗапросыДляПовторнойОтправкиСЭДО
	               |ГДЕ
	               |	ЗапросыДляПовторнойОтправкиСЭДО.БылПолученОтветСервера
	               |	И ЗапросыДляПовторнойОтправкиСЭДО.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Запись = РегистрыСведений.ЗапросыДляПовторнойОтправкиСЭДО.СоздатьМенеджерЗаписи();
	Запись.Организация = Выборка.Организация;
	Запись.Идентификатор = Выборка.Идентификатор;
	Запись.Прочитать(); 
	
	Результат.БылПолученОтветСервера = Истина;
	ТекстОтвета = Запись.ДанныеОтвета.Получить();
	Результат.АдресЗашифрованногоОтветаSOAP = ПоместитьВоВременноеХранилище(ТекстОтвета, Новый УникальныйИдентификатор);
	ТекстЗапроса = Запись.ДанныеПодписаногоЗапроса.Получить();
	Результат.АдресПодписаногоЗапросаSOAP = ПоместитьВоВременноеХранилище(ТекстЗапроса, Новый УникальныйИдентификатор);
	
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АнализОшибокПолученияСообщенийПослеВопроса(ВключитьЗадание, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатПолучения 					= ДополнительныеПараметры.РезультатПолучения;
	БылВыведенДиалогВключенияЗадания 	= ДополнительныеПараметры.БылВыведенДиалогВключенияЗадания;
	
	Если НЕ ВключитьЗадание = Неопределено И ВключитьЗадание Тогда
		
		Запросы = ДополнительныеПараметры.Запросы;
		Результат = ДобавитьДляДанныеФоновогоЗаданияЗагрузкиИзСЭДО(Запросы);
		Если НЕ Результат.Выполнено Тогда
			ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		КонецЕсли;
		
	КонецЕсли; 
	
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения);
	
КонецПроцедуры

#КонецОбласти

#Область ПолучитьСообщенияСЭДОФСС

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОФСС(
		ОповещениеОбратногоВызова,
		Организация,
		Идентификаторы,
		ОткрыватьФормуДлительнойОперации = Истина,
		ЗадаватьВопросОТестовомСервере = Истина,
		ТипыВзаимодействий = Неопределено,
		СброситьСвойстваОбменаПоСЭДОЧерезОператора = Истина,
		ФормаДлительнойОперации = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщений", Новый Массив);
	Результат.Вставить("БылиОшибки", Ложь);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("РезультатыПолучения", Новый Массив);
	Результат.Вставить("ОперацияБылаОтмененаПользователем", Ложь);
	// Повторное получение вызывается в случае если будет получено сообщение 332 типа.
	Результат.Вставить("ПолучитьПовторно", Ложь);
	
	ДополнительныеПараметры = ОповещениеОбратногоВызова.ДополнительныеПараметры;
	
	ОтображатьСостояние = ?(НЕ ДополнительныеПараметры = Неопределено И ДополнительныеПараметры.Свойство("ОтображатьСостояние"),
		ДополнительныеПараметры.ОтображатьСостояние, Истина);
	КоличествоСообщенийВПакетномЗапросе = ПолучитьКоличествоСообщенийВПакетномЗапросеСЭДО();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Результат", 							Результат);
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 			ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Идентификаторы", 						Идентификаторы);
	ДополнительныеПараметры.Вставить("ИндексСообщения", 					0);
	ДополнительныеПараметры.Вставить("Организация", 						Организация);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации", 			ФормаДлительнойОперации);
	ДополнительныеПараметры.Вставить("ЗадаватьВопросОТестовомСервере", 		ЗадаватьВопросОТестовомСервере);
	ДополнительныеПараметры.Вставить("ТипыВзаимодействий", 					ТипыВзаимодействий);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние", 				ОтображатьСостояние);
	ДополнительныеПараметры.Вставить("СведенияОДатахПолученияСообщений", 	Неопределено);
	ДополнительныеПараметры.Вставить("КоличествоСообщенийВПакетномЗапросе", КоличествоСообщенийВПакетномЗапросе);
	
	// Открываем форму длительной операции.
	ПараметрыОжидания = Новый Структура();
	ПараметрыОжидания.Вставить("ТекстСообщения", НСтр("ru = 'Получение входящих сообщений СЭДО СФР.';
														|en = 'Получение входящих сообщений СЭДО СФР.'"));
	Если ОткрыватьФормуДлительнойОперации Тогда
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"ОбщаяФорма.ДлительнаяОперация", ПараметрыОжидания);
	КонецЕсли;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
	КонецЕсли;
	
	ПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 		= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексСообщения 				= ДополнительныеПараметры.ИндексСообщения;
	Организация 					= ДополнительныеПараметры.Организация;
	Результат 						= ДополнительныеПараметры.Результат;
	Идентификаторы 					= ДополнительныеПараметры.Идентификаторы;
	ФормаДлительнойОперации 		= ДополнительныеПараметры.ФормаДлительнойОперации;
	ЗадаватьВопросОТестовомСервере 	= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТипыВзаимодействий 				= ДополнительныеПараметры.ТипыВзаимодействий;
	
	Если НЕ ФормаДлительнойОперацииОткрыта(ФормаДлительнойОперации) Тогда
		// Пользователь нажал Отмена в форме загрузки.
		Результат.ОперацияБылаОтмененаПользователем = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Если ИндексСообщения % 10 = 0 Тогда
		// для предотвращения переполнения стека
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
			"БРО.ВходящийКонтекстПолучитьСообщенияСЭДОФСС");
		ПодключитьОбработчикОжидания("Подключаемый_СбросСтекаПолучитьСообщенияСЭДОФССЦикл", 3, Истина);
	Иначе
		СбросСтекаПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СбросСтекаПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры)
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексСообщения 					= ДополнительныеПараметры.ИндексСообщения;
	Организация 						= ДополнительныеПараметры.Организация;
	Результат 							= ДополнительныеПараметры.Результат;
	Идентификаторы 						= ДополнительныеПараметры.Идентификаторы;
	ФормаДлительнойОперации 			= ДополнительныеПараметры.ФормаДлительнойОперации;
	ЗадаватьВопросОТестовомСервере 		= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТипыВзаимодействий 					= ДополнительныеПараметры.ТипыВзаимодействий;
	КоличествоСообщенийВПакетномЗапросе = ДополнительныеПараметры.КоличествоСообщенийВПакетномЗапросе;
	
	Если ИндексСообщения >= Идентификаторы.Количество() Тогда
		// Закроем окно заставки длительной операции, если она была открыта.
		ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		// Оповещение для форм.
		ИмяСобытия = ЭлектронныйДокументооборотСФССКлиент.ИмяСобытияОповещенияЗавершенияПолученияСообщенийИзСЭДО();
		Оповестить(Имясобытия, Результат);
		Возврат;
	КонецЕсли;
	
	ТипВзаимодействия = ?(ЗначениеЗаполнено(ТипыВзаимодействий) И ИндексСообщения < ТипыВзаимодействий.Количество(),
		ТипыВзаимодействий[ИндексСообщения], Неопределено);
	
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = Ложь;
	
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	
	Если КоличествоСообщенийВПакетномЗапросе <= 1
		ИЛИ ОбменПоСЭДОНапрямую
		ИЛИ Идентификаторы.Количество() = 1 Тогда
		// Получение единичного сообщения.
		Идентификатор = Идентификаторы[ИндексСообщения];
		Оповещение = Новый ОписаниеОповещения("ПолучитьСообщенияСЭДОФССЦиклПослеПолученияСообщения",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПолучитьСообщениеСЭДОФСС(
			Оповещение,
			Организация,
			Идентификатор,
			ЗадаватьВопросОТестовомСервере,
			ТипВзаимодействия,
			СброситьСвойстваОбменаПоСЭДОЧерезОператора);
	Иначе
		// Пакетное получение сообщений.
		ИдентификаторыДляПакетногоЗапроса = Новый Массив;
		КоличествоСообщений = 1;
		Для Индекс = ИндексСообщения По Идентификаторы.ВГраница() Цикл
			ИдентификаторыДляПакетногоЗапроса.Добавить(Идентификаторы[Индекс]);
			Если КоличествоСообщений >= КоличествоСообщенийВПакетномЗапросе Тогда
				Прервать;
			КонецЕсли;
			КоличествоСообщений = КоличествоСообщений + 1;
		КонецЦикла;
		Оповещение = Новый ОписаниеОповещения("ПолучитьСообщенияСЭДОФССПакетноЦиклПослеПолученияСообщений",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПараметрыПолучения = НовыеПараметрыПолучитьСообщенияСЭДОПакетно();
		ПараметрыПолучения.ЗадаватьВопросОТестовомСервере = ЗадаватьВопросОТестовомСервере;
		ПараметрыПолучения.ТипВзаимодействия = ТипВзаимодействия;
		ПараметрыПолучения.СброситьСвойстваОбменаПоСЭДОЧерезОператора = СброситьСвойстваОбменаПоСЭДОЧерезОператора;
		ПолучитьСообщенияСЭДОПакетно(
			Оповещение,
			Организация,
			ИдентификаторыДляПакетногоЗапроса,
			ПараметрыПолучения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СбросСтекаПолучитьСообщенияСЭДОФССЦикл() Экспорт
	
	ВходящийКонтекст = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ВходящийКонтекстПолучитьСообщенияСЭДОФСС");
	
	СбросСтекаПолучитьСообщенияСЭДОФССЦикл(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОФССЦиклПослеПолученияСообщения(РезультатПолученияСообщения, ДополнительныеПараметры) Экспорт
	
	Результат 					= ДополнительныеПараметры.Результат;
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексСообщения 			= ДополнительныеПараметры.ИндексСообщения;
	ФормаДлительнойОперации 	= ДополнительныеПараметры.ФормаДлительнойОперации;
	Идентификаторы 				= ДополнительныеПараметры.Идентификаторы;
	Организация 				= ДополнительныеПараметры.Организация;
	Идентификатор				= Идентификаторы[ИндексСообщения];
	
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	
	Если НЕ РезультатПолученияСообщения.Выполнено Тогда
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
			И ДополнительныеПараметры.СведенияОДатахПолученияСообщений = Неопределено Тогда
			
			ДополнительныеПараметры.СведенияОДатахПолученияСообщений = ПолучитьДатыПолученияСообщений(
				Организация,,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		КонецЕсли;
		СведенияОДатахПолученияСообщений = ДополнительныеПараметры.СведенияОДатахПолученияСообщений;
		СообщенияДоСЭДОЧерезОператораПолучены = СведенияОДатахПолученияСообщений <> Неопределено
			И СведенияОДатахПолученияСообщений.ОбменЧерезОператора = Истина;
		
		Если СообщенияДоСЭДОЧерезОператораПолучены ИЛИ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			Результат.БылиОшибки = Истина;
			Результат.Ошибки.Добавить(РезультатПолученияСообщения.ОписаниеОшибки);
		КонецЕсли;
		
		ЭтоКритическаяОшибкаОбменаЧерезОператора = ЭтоКритическаяОшибкаОбменаЧерезОператора(
			СвойстваОбменаПоСЭДОЧерезОператора, РезультатПолученияСообщения);
		ЭтоОшибкаСоединенияОбменаЧерезОператора = РезультатПолученияСообщения.ОшибкаСоединения
			И НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
		Если РезультатПолученияСообщения.ОтмененоПользователем
			ИЛИ ЭтоОшибкаСоединенияОбменаЧерезОператора
			ИЛИ ЭтоКритическаяОшибкаОбменаЧерезОператора Тогда
			// Прерываем получение сообщений если пользователь отменил операцию
			// или в случае ошибки обмена через оператора.
			ИндексСообщения = Идентификаторы.Количество();
		КонецЕсли;
		
	Иначе
		Тип332 = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина).ТипСообщенияОтветНаЗапросИсторическихДанных;
		Для каждого Сообщение Из РезультатПолученияСообщения.ДанныеСообщений Цикл
			Результат.ДанныеСообщений.Добавить(Сообщение);
			Если Строка(Сообщение.Тип) = Тип332
				И НЕ Результат.ПолучитьПовторно Тогда
				Результат.ПолучитьПовторно = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.РезультатыПолучения.Добавить(РезультатПолученияСообщения);
	
	ИндексСообщения = ИндексСообщения + 1;
	ДополнительныеПараметры.ИндексСообщения = ИндексСообщения;
	
	// После получения первого сообщения для последующих вопрос не задаем.
	ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере = Ложь;
	
	ПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоКритическаяОшибкаОбменаЧерезОператора(СвойстваОбменаПоСЭДОЧерезОператора, РезультатПолученияСообщения)
	
	КодыСостояния = Новый Массив;
	КодыСостояния.Добавить(400);
	КодыСостояния.Добавить(503);
	КодыСостояния.Добавить(504);
	Результат = НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
		И РезультатПолученияСообщения.Свойство("ДанныеЗапроса")
		И НЕ КодыСостояния.Найти(РезультатПолученияСообщения.ДанныеЗапроса.КодСостояния) = Неопределено;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПолучитьСообщенияСЭДОПакетно

&НаКлиенте
Функция НовыеПараметрыПолучитьСообщенияСЭДОПакетно()
	
	Результат = Новый Структура;
	Результат.Вставить("ЗадаватьВопросОТестовомСервере", Ложь);
	Результат.Вставить("ТипВзаимодействия", Неопределено);
	Результат.Вставить("СброситьСвойстваОбменаПоСЭДОЧерезОператора", Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОПакетно(
		ОповещениеОбратногоВызова,
		Организация,
		Идентификаторы,
		ПараметрыПолучения) Экспорт
		
	ЗадаватьВопросОТестовомСервере = ПараметрыПолучения.ЗадаватьВопросОТестовомСервере;
	ТипВзаимодействия = ПараметрыПолучения.ТипВзаимодействия;
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = ПараметрыПолучения.СброситьСвойстваОбменаПоСЭДОЧерезОператора;
	
	Результат = НовыйРезультатПолученияСообщенийСЭДО();
	
	Если Идентификаторы.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = НСтр("ru = 'Не заполнен список идентификаторов сообщений СЭДО.';
										|en = 'Не заполнен список идентификаторов сообщений СЭДО.'");
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	Операция = ОперацияПолученияСообщенияСЭДОФСС();
	
	ОтображатьСостояние = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ОтображатьСостояние") Тогда
		ОтображатьСостояние = ОповещениеОбратногоВызова.ДополнительныеПараметры.ОтображатьСостояние;
	КонецЕсли;
	
	Настройки = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Настройки.ТипВзаимодействия = ТипВзаимодействия;
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		ЗаполнитьЗначенияСвойств(Настройки, СвойстваОрганизации);
	КонецЕсли;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
	КонецЕсли;
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	
	Настройки.ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	
	ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
	ЗапросДляПолученияДанных.Организация = Организация;
	ЗапросДляПолученияДанных.Операция = Операция;
	ЗапросДляПолученияДанных.ТекстЗапроса =
		ТекстЗапросаПолученияСообщенийПакетноСЭДОФСС(
			РегистрационныйНомерФСС,
			Идентификаторы,
			Настройки);
	ЗапросДляПолученияДанных.РезультатФоновойЗагрузки = Новый Массив;
	ЗапросДляПолученияДанных.ИдентификаторыСообщений = Идентификаторы;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 	ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 					Результат);
	ДополнительныеПараметры.Вставить("Организация", 				Организация);
	ДополнительныеПараметры.Вставить("Операция", 					Операция);
	ДополнительныеПараметры.Вставить("ИдентификаторыСообщений", 	Идентификаторы);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 			ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("ДанныеБылиПолученыВФоне", 	Ложь);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние", 		ОтображатьСостояние);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора",
		СвойстваОбменаПоСЭДОЧерезОператора);
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьСообщенияСЭДОПакетноПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьДанныеСЭДОФСС(
		Оповещение,
		ЗапросДляПолученияДанных,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия,
		ОтображатьСостояние)
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОПакетноПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	ИдентификаторыСообщений				= ДополнительныеПараметры.ИдентификаторыСообщений;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ДанныеЗапроса 						= РезультатОперации.ДанныеЗапроса;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	// Данные запроса для повтора в случае ошибки.
	Для каждого Идентификатор из ИдентификаторыСообщений Цикл
		ДанныеЗапроса.ИдентификаторыСообщений.Добавить(Идентификатор);
	КонецЦикла;
	ДанныеЗапроса.ТипВзаимодействия 				= ТипВзаимодействия;
	ДанныеЗапроса.Операция 							= Операция;
	ДанныеЗапроса.Организация 						= Организация;
	ДанныеЗапроса.АдресСервера 						= Результат.АдресСервера;
	ДанныеЗапроса.АдресРесурса 						= Результат.АдресРесурса;
	ДанныеЗапроса.КодСостояния 						= Результат.КодСостояния;
	ДанныеЗапроса.ТекстОшибки 						= Результат.ОписаниеОшибки;
	ДанныеЗапроса.АдресЗашифрованногоЗапросаSOAP 	= Результат.АдресЗашифрованногоЗапросаSOAP;
	ДанныеЗапроса.ОшибкаСоединения 					= Результат.ОшибкаСоединения;
	ДанныеЗапроса.АдресПодписаногоЗапросаSOAP 		= Результат.АдресПодписаногоЗапросаSOAP;
	ДанныеЗапроса.АдресРасшифрованногоОтветаSOAP 	= Результат.АдресРасшифрованногоОтветаSOAP;
	
	// Данные запроса для сохранения в регистр журнала запросов.
	ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
	ПараметрыЗапроса.АдресЗапросаSOAP 			= Результат.АдресПодписаногоЗапросаSOAP;
	ПараметрыЗапроса.АдресОтветаSOAP 			= Результат.АдресРасшифрованногоОтветаSOAP;
	ПараметрыЗапроса.АдресРесурса 				= Результат.АдресРесурса;
	ПараметрыЗапроса.АдресСервера 				= Результат.АдресСервера;
	ПараметрыЗапроса.КодСостояния 				= Результат.КодСостояния;
	ПараметрыЗапроса.ТипВзаимодействияСЭДО 		= ТипВзаимодействия;
	ПараметрыЗапроса.УдалятьИзХранилища 		= Истина;
	ПараметрыЗапроса.ОбменЧерезОператора 		= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	ПараметрыЗапроса.ПакетныйЗапросСообщений 	= Истина;
	
	РезультатОперации.ОшибкаСоединения = Результат.ОшибкаСоединения;
	
	Если Результат.Выполнено Тогда
		АдресРезультата = Результат.АдресРасшифрованногоОтветаSOAP;
		ТекстОтвета = ПолучитьИзВременногоХранилища(АдресРезультата);
		
		// Разбор ответа.
		Попытка
			РезультатРазбора = РазобратьОтветПолучитьСообщенияСЭДОПакетно(ТекстОтвета, , ПараметрыЗапроса.Идентификатор);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Шаблон = НСтр("ru = 'При разборе данных сообщений возникла ошибка:';
							|en = 'При разборе данных сообщений возникла ошибка:'") + Символы.ПС
				+ "%1";
			РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон, КраткоеПредставлениеОшибки);
			Шаблон = НСтр("ru = 'При разборе данных сообщений возникла ошибка. Текст сообщения:';
							|en = 'При разборе данных сообщений возникла ошибка. Текст сообщения:'") + Символы.ПС
				+ "%1" + Символы.ПС + "%2";
			ТекстОшибки = СтрШаблон(Шаблон,
				ТекстОтвета, ПодробноеПредставлениеОшибки);
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО ФСС'"),
				"Ошибка",
				ТекстОшибки, ,
				Истина);
			Если ИдентификаторыСообщений.Количество() > 0 Тогда
				ПараметрыЗапроса.ИдентификаторФСС = ИдентификаторыСообщений[0];
			КонецЕсли;
			ПараметрыЗапроса.ЭтоПользовательскийЗапрос = Истина;
			ПараметрыЗапроса.ОписаниеОшибки = РезультатОперации.ОписаниеОшибки;
			ПараметрыЗапроса.ДанныеПолученныхПакетноСообщений =
				ДанныеПолученныхПакетноСообщенийСЭДО(
					Организация,
					РезультатРазбора,
					РезультатОперации);
			СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
			Возврат;
		КонецПопытки;
		
		ИдентификаторыНеНайденных = РезультатРазбора.ИдентификаторыНеНайденных;
		РезультатОперации.СообщенияНеНайдены = ИдентификаторыНеНайденных.Количество() > 0;
		РезультатОперации.ИдентификаторыНеНайденных = ИдентификаторыНеНайденных;
		РезультатОперации.ОшибкиПоИдентификаторам = РезультатРазбора.ОшибкиПоИдентификаторам;
		
		Если РезультатРазбора.ДанныеСообщений.Количество() > 0 Тогда
			ДанныеСообщения = РезультатРазбора.ДанныеСообщений[0];
			ПараметрыЗапроса.ИдентификаторФСС = ДанныеСообщения.Идентификатор;
			ТипыСообщений = Новый Массив;
			Для каждого ДанныеСообщения из РезультатРазбора.ДанныеСообщений Цикл
				ТипыСообщений.Добавить(ДанныеСообщения.Тип);
			КонецЦикла;
			ПараметрыЗапроса.ТипСообщенияСЭДО = СтрСоединить(ТипыСообщений, ",");
		КонецЕсли;
		
		ПараметрыЗапроса.ДанныеПолученныхПакетноСообщений =
			ДанныеПолученныхПакетноСообщенийСЭДО(
				Организация,
				РезультатРазбора,
				РезультатОперации);
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			
			// Получен список ошибок.
			Если ЗначениеЗаполнено(ИдентификаторыСообщений)
				И ИдентификаторыСообщений.Количество() > 0 Тогда
				Шаблон = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
					НСтр("ru = 'При получении сообщений с сервера СЭДО ФСС произошли ошибки';
						|en = 'При получении сообщений с сервера СЭДО ФСС произошли ошибки'"),
					НСтр("ru = 'При получении сообщений с сервера оператора СЭДО ФСС произошли ошибки';
						|en = 'При получении сообщений с сервера оператора СЭДО ФСС произошли ошибки'"));
			КонецЕсли;
			Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
			Шаблон = Шаблон + ":
				|%1";
			ОписаниеОшибки = СтрСоединить(РезультатРазбора.Ошибки, Символы.ПС);
			ОписаниеОшибки = СтрШаблон(Шаблон, ОписаниеОшибки);
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
			// Записываем ошибку в журнал регистрации.
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
			ПараметрыЗапроса.ЭтоПользовательскийЗапрос = Истина;
			ПараметрыЗапроса.ОписаниеОшибки = ОписаниеОшибки;
		Иначе
			// Сообщение было успешно разобрано.
			ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
			РезультатОперации.Вставить("ДанныеСообщений", РезультатРазбора.ДанныеСообщений);
			РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
				Организация,
				ДанныеСообщений,
				ТипВзаимодействия,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			
			Если РезультатСохранения.БылиОшибкиОбработки Тогда
				// Сохраняем данные запроса в журнал запросов.
				СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
				// Удаляем запрос по сообщению из очереди фонового получения.
				УбратьЗапросИзОчередиФоновогоЗадания(ДанныеЗапроса);
				РезультатОперации.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
				ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
				Возврат;
			КонецЕсли;
			РезультатОперации.Выполнено = Истина;
		КонецЕсли;
		
		// Сохраняем данные запроса в журнал запросов.
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		
	Иначе
		Шаблон = НСтр("ru = 'Не удалось получить сообщения СЭДО СФР.
			|%1';
			|en = 'Не удалось получить сообщения СЭДО СФР.
			|%1'");
		РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон, Результат.ОписаниеОшибки);
		РезультатОперации.ОтмененоПользователем = Результат.ОтмененоПользователем;
	КонецЕсли;
	
	Если НЕ ПриВыполненииЗапросаВозниклаОшибкиСоединения(Результат) Тогда
		// Удаляем запрос по сообщению из очереди фонового получения.
		УбратьЗапросИзОчередиФоновогоЗадания(ДанныеЗапроса);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОФССПакетноЦиклПослеПолученияСообщений(
	РезультатПолученияСообщений,
	ДополнительныеПараметры) Экспорт
	
	Результат 					= ДополнительныеПараметры.Результат;
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексСообщения 			= ДополнительныеПараметры.ИндексСообщения;
	ФормаДлительнойОперации 	= ДополнительныеПараметры.ФормаДлительнойОперации;
	Идентификаторы 				= ДополнительныеПараметры.Идентификаторы;
	Организация 				= ДополнительныеПараметры.Организация;
	Идентификатор				= Идентификаторы[ИндексСообщения];
	
	КоличествоСообщенийВПакетномЗапросе = ДополнительныеПараметры.КоличествоСообщенийВПакетномЗапросе;
	
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	
	Если НЕ РезультатПолученияСообщений.Выполнено Тогда
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
			И ДополнительныеПараметры.СведенияОДатахПолученияСообщений = Неопределено Тогда
			
			ДополнительныеПараметры.СведенияОДатахПолученияСообщений = ПолучитьДатыПолученияСообщений(
				Организация,,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		КонецЕсли;
		СведенияОДатахПолученияСообщений = ДополнительныеПараметры.СведенияОДатахПолученияСообщений;
		СообщенияДоСЭДОЧерезОператораПолучены = СведенияОДатахПолученияСообщений <> Неопределено
			И СведенияОДатахПолученияСообщений.ОбменЧерезОператора = Истина;
		
		Если СообщенияДоСЭДОЧерезОператораПолучены ИЛИ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			Результат.БылиОшибки = Истина;
			Результат.Ошибки.Добавить(РезультатПолученияСообщений.ОписаниеОшибки);
		КонецЕсли;
		
		ЭтоКритическаяОшибкаОбменаЧерезОператора = ЭтоКритическаяОшибкаОбменаЧерезОператора(
			СвойстваОбменаПоСЭДОЧерезОператора, РезультатПолученияСообщений);
		ЭтоОшибкаСоединенияОбменаЧерезОператора = РезультатПолученияСообщений.ОшибкаСоединения
			И НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
		Если РезультатПолученияСообщений.ОтмененоПользователем
			ИЛИ ЭтоОшибкаСоединенияОбменаЧерезОператора
			ИЛИ ЭтоКритическаяОшибкаОбменаЧерезОператора Тогда
			// Прерываем получение сообщений если пользователь отменил операцию
			// или в случае ошибки обмена через оператора.
			ИндексСообщения = Идентификаторы.Количество();
		КонецЕсли;
		
	Иначе
		Тип332 = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина).ТипСообщенияОтветНаЗапросИсторическихДанных;
		Для каждого ДанныеСообщения из РезультатПолученияСообщений.ДанныеСообщений Цикл
			Результат.ДанныеСообщений.Добавить(ДанныеСообщения);
			Если Строка(ДанныеСообщения.Тип) = Тип332
				И НЕ Результат.ПолучитьПовторно Тогда
				Результат.ПолучитьПовторно = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.РезультатыПолучения.Добавить(РезультатПолученияСообщений);
	
	КоличествоСообщенийВОтвете = РезультатПолученияСообщений.ДанныеСообщений.Количество()
		+ РезультатПолученияСообщений.ОшибкиПоИдентификаторам.Количество();
	Если КоличествоСообщенийВОтвете > 0 Тогда
		ИндексСообщения = ИндексСообщения + КоличествоСообщенийВОтвете;
	Иначе
		ИндексСообщения = ИндексСообщения + КоличествоСообщенийВПакетномЗапросе;
	КонецЕсли;

	ДополнительныеПараметры.ИндексСообщения = ИндексСообщения;
	
	// После получения первого сообщения для последующих вопрос не задаем.
	ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере = Ложь;
	
	ПаузаМеждуЗапросами = 0;
	// Пауза перед следующим запросом.
	Если ИндексСообщения < Идентификаторы.ВГраница() Тогда
		Если КоличествоСообщенийВПакетномЗапросе < 10 Тогда
			ПаузаМеждуЗапросами = 0.1;
		Иначе
			ПаузаМеждуЗапросами = 1;
		КонецЕсли;
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
			"БРО.ПолучитьСообщенияСЭДОПакетно");
		ПодключитьОбработчикОжидания("Подключаемый_ПолучитьСообщенияСЭДОПакетно", ПаузаМеждуЗапросами, Истина);
	Иначе
		ПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолучитьСообщенияСЭДОПакетно()

	ДополнительныеПараметры = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ПолучитьСообщенияСЭДОПакетно");
	ПолучитьСообщенияСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция ТекстЗапросаПолученияСообщенийПакетноСЭДОФСС(
		РегистрационныйНомерФСС,
		ИдентификаторыСообщений,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	
	Если НастройкиВызова.ТипВзаимодействия = Неопределено Тогда
		НастройкиВызова.ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	ИнформацияОПрограмме = ИнформацияОПрограмме();
	
	ТекстПараметровТипаВзаимодействия = ДокументооборотСФССКлиентСервер.ТекстПараметровТипаВзаимодействияСЭДО(
		РегистрационныйНомерФСС, НастройкиВызова);
		
	УзелИдентификаторыСообщений = "";
	
	Для каждого Идентификатор из ИдентификаторыСообщений Цикл
		Шаблон = "
			|            <uuid>%1</uuid>";
		УзелИдентификаторыСообщений = УзелИдентификаторыСообщений + СтрШаблон(Шаблон, Идентификатор);
	КонецЦикла;
	
	Шаблон = "
		|   <soapenv:Body xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
		+ " xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01"""
		+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"""
		+ " wsu:Id=""REGNO_%2"">
		|      <v01:getMessageRequest>
		|         <systemInfo>
		|            <specVersion>1.0</specVersion>
		|            <software>%4</software>
		|            <softwareVersion>%5</softwareVersion>
		|         </systemInfo>
		|         <interactionType>%1</interactionType>
		|         <uuidList>%3
		|         </uuidList>%6
		|      </v01:getMessageRequest>
		|   </soapenv:Body>";
	
	Текст = СтрШаблон(Шаблон,
		НастройкиВызова.ТипВзаимодействия,
		РегистрационныйНомерФСС,
		УзелИдентификаторыСообщений,
		ИнформацияОПрограмме.ИДКонфигурации,
		ИнформацияОПрограмме.ВерсияКонфигурации,
		ТекстПараметровТипаВзаимодействия);
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Функция НовыйРезультатПолученияСообщенийСЭДО()
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификаторы", Новый Массив);
	Результат.Вставить("ДанныеСообщений", Новый Массив);
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ОтмененоПользователем", Ложь);
	Запрос = НовыйЗапросКСерверуСЭДО();
	Результат.Вставить("ДанныеЗапроса", Запрос);
	Результат.Вставить("ОшибкаСоединения", Ложь);
	Результат.Вставить("СообщенияНеНайдены", Ложь);
	Результат.Вставить("ИдентификаторыНеНайденных", Новый Массив);
	Результат.Вставить("ОшибкиПоИдентификаторам", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьОтветПолучитьСообщенияСЭДОПакетно(СодержимоеОтвета, ДатаСообщений = Неопределено, ИдентификаторЗапроса = "")
	
	ДанныеСообщений = Новый Массив;
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("КонвертSOAP", СодержимоеОтвета);
	Результат.Вставить("КодыОшибок", Новый Массив);
	Результат.Вставить("ИдентификаторыНеНайденных", Новый Массив);
	Результат.Вставить("ОшибкиПоИдентификаторам", Новый Соответствие);
	Результат.Вставить("ДанныеСообщений", ДанныеСообщений);
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		Чтение.Закрыть();
		ОписаниеОшибки = НСтр("ru = 'Ошибка разбора ответа сервера с данными сообщения СЭДО.';
								|en = 'Ошибка разбора ответа сервера с данными сообщения СЭДО.'");
		Результат.Ошибки.Добавить(ОписаниеОшибки);
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = НСтр("ru = 'Ошибка разбора ответа сервера СЭДО:';
							|en = 'Ошибка разбора ответа сервера СЭДО:'") 
			+ Символы.ПС + ПодробноеПредставлениеОшибки
			+ Символы.ПС + НСтр("ru = 'Содержимое ответа:';
								|en = 'Содержимое ответа:'") + Символы.ПС + СодержимоеОтвета;
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО СФР';
							|en = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО СФР'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		Возврат Результат;
	КонецПопытки;
	Чтение.Закрыть();
	
	// Пример ответа сервера оператора (ответ всегда пакетный, даже при обычном запросе).
	//	<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
	//	<soap:Body xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
	//		<v01:sedoMessageResponse xmlns:v01="http://www.fss.ru/integration/types/sedo/v01">
	//			<packageResult>
	//				<sedoMessageList>
	//					<sedoMessage>
	//						<uuid>1882a16b-e21b-4817-8aef-446bee0ab92e</uuid>
	//						<messageType>111</messageType>
	//						<recipientId>3101011870</recipientId>
	//						<needConfirm>false</needConfirm>
	//						<expiryDate>2099-01-01</expiryDate>
	//						<message>PD94bWwgdmVyc..</message>
	//					</sedoMessage>
	//				</sedoMessageList>
	//				<errorList/>
	//			</packageResult>
	//		</v01:sedoMessageResponse>
	//	</soap:Body>
	//</soap:Envelope>
	// 
	// Сообщение с ошибкой от оператора (ответ всегда пакетный, даже при обычном запросе)
	// <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
	//	<soap:Body xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
	//		<v01:sedoMessageResponse xmlns:v01="http://www.fss.ru/integration/types/sedo/v01">
	//			<packageResult>
	//				<sedoMessageList/>
	//				<errorList>
	//					<errorPackage>
	//						<uuid>1976dea6-790c-458d-8658-7b338bd8ecfd</uuid>
	//						<error>
	//							<com:code xmlns:com="http://www.fss.ru/integration/types/common/v01">E_SEDO_3010</com:code>
	//							<com:message xmlns:com="http://www.fss.ru/integration/types/common/v01">Указанное сообщение не найдено</com:message>
	//						</error>
	//					</errorPackage>
	//				</errorList>
	//			</packageResult>
	//		</v01:sedoMessageResponse>
	//	</soap:Body>
	//</soap:Envelope>
	
	Ошибка = НСтр("ru = 'Не удалось разобрать ответ сервера СЭДО с данными сообщения. Подробности см. в журнале регистрации.';
					|en = 'Не удалось разобрать ответ сервера СЭДО с данными сообщения. Подробности см. в журнале регистрации.'");
	ЕстьУзелСообщения = ЕстьСвойство(ДанныеОтвета.Body, "sedoMessageResponse");
	Если НЕ ЕстьУзелСообщения Тогда
		// Определяем тело сообщения для записи в журнал.
		ТелоОтвета = ИзвлечьТелоОтветаИзКонтейнераСЭДО(СодержимоеОтвета);
		ТекстОшибки = НСтр("ru = 'С сервера СЭДО СФР получен ответ с ошибками:';
							|en = 'С сервера СЭДО СФР получен ответ с ошибками:'") + Символы.ПС + ТелоОтвета;
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО СФР';
							|en = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО СФР'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		Ошибка = ИзвлечьТекстОшибкиИзТелаОтветаСЭДО(ДанныеОтвета.Body);
		Результат.Ошибки.Добавить(Ошибка);
		Возврат Результат;
	КонецЕсли;
	
	УзелДанных = ДанныеОтвета.Body.sedoMessageResponse;
	УзлыОшибокИлиОшибокПакета = Неопределено;
	Если УзелДанных.Свойства().Получить("errorList") = Неопределено Тогда
		Если УзелДанных.Свойства().Получить("packageResult") <> Неопределено Тогда
			УзелПакета = УзелДанных.packageResult;
			Если УзелПакета.Свойства().Получить("errorList") <> Неопределено Тогда
				УзелОшибок = УзелПакета.errorList;
				Если УзелОшибок.Свойства().Получить("errorPackage") <> Неопределено Тогда
					УзлыОшибокИлиОшибокПакета = УзелОшибок.errorPackage;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		УзлыОшибокИлиОшибокПакета = УзелДанных.errorList;
	КонецЕсли;
	
	КодОшибкиСообщениеНеНайдено = "E_SEDO_3010";
	Если УзлыОшибокИлиОшибокПакета <> Неопределено Тогда
		
		// Возвращен список ошибок.
		Для каждого УзелОшибокИлиОшибокПакета Из ЗначениеВКоллекцию(УзлыОшибокИлиОшибокПакета) Цикл
			ИдентификаторСообщения = "";
			ОшибкиВУзле = Новый Массив;
			Если НЕ УзелОшибокИлиОшибокПакета.Свойства().Получить("uuid") = Неопределено Тогда
				ИдентификаторСообщения = УзелОшибокИлиОшибокПакета.uuid;
			КонецЕсли;
			
			Если УзелОшибокИлиОшибокПакета.Свойства().Получить("error") = Неопределено Тогда
				УзелОшибок = УзелОшибокИлиОшибокПакета;
			Иначе
				УзелОшибок = УзелОшибокИлиОшибокПакета.error;
			КонецЕсли;
			
			Если УзелОшибок.Свойства().Получить("message") <> Неопределено Тогда
				Для каждого Ошибка Из ЗначениеВКоллекцию(УзелОшибок.message) Цикл
					Результат.Ошибки.Добавить(Ошибка);
					ОшибкиВУзле.Добавить(Ошибка);
				КонецЦикла;
			КонецЕсли;
			Если ЕстьСвойство(УзелОшибок, "code") Тогда
				Для каждого Код Из ЗначениеВКоллекцию(УзелОшибок.code) Цикл
					Результат.КодыОшибок.Добавить(Код);
					Если Код = КодОшибкиСообщениеНеНайдено Тогда
						Результат.ИдентификаторыНеНайденных.Добавить(ИдентификаторСообщения);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
				ТекстОшибки = СтрСоединить(ОшибкиВУзле, Символы.ПС);
				Результат.ОшибкиПоИдентификаторам.Вставить(ИдентификаторСообщения, ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
		
		ТелоОтвета = ИзвлечьТелоОтветаИзКонтейнераСЭДО(СодержимоеОтвета);
		ТекстОшибки = НСтр("ru = 'С сервера СЭДО СФР получен ответ с ошибками:';
							|en = 'С сервера СЭДО СФР получен ответ с ошибками:'") + Символы.ПС + ТелоОтвета;
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО СФР';
							|en = 'Электронный документооборот с контролирующими органами. Получение сообщений СЭДО СФР'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
	КонецЕсли;
	
	Если НЕ ЕстьСвойство(УзелДанных, "result") Тогда
		Если ЕстьСвойство(УзелДанных, "packageResult")
			И ЕстьСвойство(УзелДанных.packageResult, "sedoMessageList") Тогда
			УзелДанныхСообщений = УзелДанных.packageResult.sedoMessageList.sedoMessage;
			ПакетноеПолучение = Истина;
		Иначе
			Возврат Результат;
		КонецЕсли;
	Иначе
		УзелДанныхСообщений = УзелДанных.result;
	КонецЕсли;
	
	Для каждого УзелДанныеСообщения из ЗначениеВКоллекцию(УзелДанныхСообщений) Цикл
		
		ДанныеСообщения = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеДанныеСообщенияСЭДО();
		РазобратьУзелСДаннымиСообщенияСЭДО(УзелДанныеСообщения, ДанныеСообщения, ДатаСообщений, ИдентификаторЗапроса);
		ДанныеСообщений.Добавить(ДанныеСообщения);
		
	КонецЦикла;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПолученныхПакетноСообщенийСЭДО(
	Организация,
	РезультатРазбора,
	РезультатОперации)
	
	ТаблицаПакетныхСообщений = Новый ТаблицаЗначений;
	ТаблицаПакетныхСообщений.Колонки.Добавить("УникальныйИдентификатор");
	ТаблицаПакетныхСообщений.Колонки.Добавить("ОписаниеОшибкиСообщения");
	ТаблицаПакетныхСообщений.Колонки.Добавить("ТипСообщения");
	
	Для каждого ДанныеСообщения Из РезультатРазбора.ДанныеСообщений Цикл
		НоваяСтрока = ТаблицаПакетныхСообщений.Добавить();
		НоваяСтрока.УникальныйИдентификатор = ДанныеСообщения.Идентификатор;
		НоваяСтрока.ТипСообщения = ДанныеСообщения.Тип;
	КонецЦикла;
	
	Для каждого КлючЗначение Из РезультатРазбора.ОшибкиПоИдентификаторам Цикл
		ИдентификаторСообщения = КлючЗначение.Ключ;
		НоваяСтрока = ТаблицаПакетныхСообщений.Добавить();
		НоваяСтрока.УникальныйИдентификатор = ИдентификаторСообщения;
		НоваяСтрока.ОписаниеОшибкиСообщения = КлючЗначение.Значение;
	КонецЦикла;
	
	Для каждого ИдентификаторСообщения Из РезультатРазбора.ИдентификаторыНеНайденных Цикл
		ОбработатьОшибкуСообщениеСЭДОНеНайдено(Организация, ИдентификаторСообщения);
	КонецЦикла;
	
	ДанныеПолученныхПакетноСообщений = Новый ХранилищеЗначения(ТаблицаПакетныхСообщений);
	
	Возврат ДанныеПолученныхПакетноСообщений;
	
КонецФункции

#КонецОбласти

#Область ПолучитьСообщениеСЭДОФСС

&НаКлиенте
Процедура ПолучитьСообщениеСЭДОФСС(
		ОповещениеОбратногоВызова,
		Организация,
		ИдентификаторСообщения,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия = Неопределено,
		СброситьСвойстваОбменаПоСЭДОЧерезОператора = Истина) Экспорт
		
	Результат = НовыйРезультатПолученияСообщенийСЭДО();
	ИдентификаторыСообщений = ЗначениеВКоллекцию(ИдентификаторСообщения);
	Результат.Идентификаторы = ИдентификаторыСообщений;
	
	Если ПустаяСтрока(ИдентификаторСообщения) Тогда
		Результат.ОписаниеОшибки = НСтр("ru = 'Не заполнен идентификатор сообщения СЭДО.';
										|en = 'Не заполнен идентификатор сообщения СЭДО.'");
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	Операция = ОперацияПолученияСообщенияСЭДОФСС();
	
	ОтображатьСостояние = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ОтображатьСостояние") Тогда
		ОтображатьСостояние = ОповещениеОбратногоВызова.ДополнительныеПараметры.ОтображатьСостояние;
	КонецЕсли;
	
	Настройки = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Настройки.ТипВзаимодействия = ТипВзаимодействия;
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		ЗаполнитьЗначенияСвойств(Настройки, СвойстваОрганизации);
	КонецЕсли;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
	КонецЕсли;
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	
	Настройки.ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	
	ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
	ЗапросДляПолученияДанных.Организация = Организация;
	ЗапросДляПолученияДанных.Операция = Операция;
	ЗапросДляПолученияДанных.ТекстЗапроса =
		ТекстЗапросаПолученияСообщенияСЭДОФСС(
			РегистрационныйНомерФСС,
			ИдентификаторСообщения,
			Настройки);
	ЗапросДляПолученияДанных.РезультатФоновойЗагрузки = Неопределено;
	ЗапросДляПолученияДанных.ИдентификаторыСообщений = ИдентификаторыСообщений;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 	ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 					Результат);
	ДополнительныеПараметры.Вставить("Организация", 				Организация);
	ДополнительныеПараметры.Вставить("Операция", 					Операция);
	ДополнительныеПараметры.Вставить("ИдентификаторСообщения", 		ИдентификаторСообщения);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 			ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("ДанныеБылиПолученыВФоне", 	Ложь);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние", 		ОтображатьСостояние);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора",
		СвойстваОбменаПоСЭДОЧерезОператора);
	
	РезультатФоновойЗагрузки = ПроверитьНаличиеОтветаВРегистреФоновыхЗапросов(ИдентификаторСообщения);
	Если РезультатФоновойЗагрузки.БылПолученОтветСервера Тогда
		ЗапросДляПолученияДанных.РезультатФоновойЗагрузки = РезультатФоновойЗагрузки;
		ДополнительныеПараметры.ДанныеБылиПолученыВФоне = Истина;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьСообщениеСЭДОФССПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьДанныеСЭДОФСС(
		Оповещение,
		ЗапросДляПолученияДанных,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия,
		ОтображатьСостояние)

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщениеСЭДОФССПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 			= ДополнительныеПараметры.Результат;
	Организация 				= ДополнительныеПараметры.Организация;
	Операция 					= ДополнительныеПараметры.Операция;
	ИдентификаторСообщения 		= ДополнительныеПараметры.ИдентификаторСообщения;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	ДанныеЗапроса 				= РезультатОперации.ДанныеЗапроса;
	СвойстваОбменаПоСЭДОЧерезОператора = ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	// Данные запроса для повтора в случае ошибки.
	ДанныеЗапроса.ИдентификаторыСообщений.Добавить(ИдентификаторСообщения);
	ДанныеЗапроса.ТипВзаимодействия 				= ТипВзаимодействия;
	ДанныеЗапроса.Операция 							= Операция;
	ДанныеЗапроса.Организация 						= Организация;
	ДанныеЗапроса.АдресСервера 						= Результат.АдресСервера;
	ДанныеЗапроса.АдресРесурса 						= Результат.АдресРесурса;
	ДанныеЗапроса.КодСостояния 						= Результат.КодСостояния;
	ДанныеЗапроса.ТекстОшибки 						= Результат.ОписаниеОшибки;
	ДанныеЗапроса.АдресЗашифрованногоЗапросаSOAP 	= Результат.АдресЗашифрованногоЗапросаSOAP;
	ДанныеЗапроса.ОшибкаСоединения 					= Результат.ОшибкаСоединения;
	ДанныеЗапроса.АдресПодписаногоЗапросаSOAP 		= Результат.АдресПодписаногоЗапросаSOAP;
	ДанныеЗапроса.АдресРасшифрованногоОтветаSOAP 	= Результат.АдресРасшифрованногоОтветаSOAP;
	
	// Данные запроса для сохранения в регистр журнала запросов.
	ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
	ПараметрыЗапроса.АдресЗапросаSOAP 		= Результат.АдресПодписаногоЗапросаSOAP;
	ПараметрыЗапроса.АдресОтветаSOAP 		= Результат.АдресРасшифрованногоОтветаSOAP;
	ПараметрыЗапроса.АдресРесурса 			= Результат.АдресРесурса;
	ПараметрыЗапроса.АдресСервера 			= Результат.АдресСервера;
	ПараметрыЗапроса.КодСостояния 			= Результат.КодСостояния;
	ПараметрыЗапроса.ТипВзаимодействияСЭДО 	= ТипВзаимодействия;
	ПараметрыЗапроса.УдалятьИзХранилища 	= Истина;
	ПараметрыЗапроса.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	
	РезультатОперации.ОшибкаСоединения = Результат.ОшибкаСоединения;
	
	Если Результат.Выполнено Тогда
		АдресРезультата = Результат.АдресРасшифрованногоОтветаSOAP;
		ТекстОтвета = ПолучитьИзВременногоХранилища(АдресРезультата);
		
		// Разбор ответа.
		Попытка
			РезультатРазбора = РазобратьОтветПолучитьСообщениеСЭДОФСС(ТекстОтвета, , ПараметрыЗапроса.Идентификатор);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Шаблон = НСтр("ru = 'При разборе данных сообщения %1 возникла ошибка:';
							|en = 'При разборе данных сообщения %1 возникла ошибка:'") + Символы.ПС
				+ "%2";
			РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон,
				ИдентификаторСообщения, КраткоеПредставлениеОшибки);
			Шаблон = НСтр("ru = 'При разборе данных сообщения %1 возникла ошибка. Текст сообщения:';
							|en = 'При разборе данных сообщения %1 возникла ошибка. Текст сообщения:'") + Символы.ПС
				+ "%2" + Символы.ПС + "%3"; 
			ОписаниеОшибки = СтрШаблон(Шаблон,
				ИдентификаторСообщения, ТекстОтвета, ПодробноеПредставлениеОшибки);
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки, ,
				Истина);
			ПараметрыЗапроса.ОписаниеОшибки = РезультатОперации.ОписаниеОшибки;
			ПараметрыЗапроса.ИдентификаторФСС = ИдентификаторСообщения;
			СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
			Возврат;
		КонецПопытки;
		
		ПараметрыЗапроса.ТипСообщенияСЭДО = РезультатРазбора.ДанныеСообщения.Тип;
		Если ЗначениеЗаполнено(РезультатРазбора.ДанныеСообщения.Идентификатор) Тогда
			ПараметрыЗапроса.ИдентификаторФСС = РезультатРазбора.ДанныеСообщения.Идентификатор;
		Иначе
			ПараметрыЗапроса.ИдентификаторФСС = ИдентификаторСообщения;
		КонецЕсли;
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			Если РезультатРазбора.СообщениеНеНайдено Тогда
				ОбработатьОшибкуСообщениеСЭДОНеНайдено(Организация, ИдентификаторСообщения);
				РезультатОперации.СообщенияНеНайдены = Истина;
				РезультатОперации.ИдентификаторыНеНайденных.Добавить(ИдентификаторСообщения);
			КонецЕсли;
			
			ТекстОшибки = СтрСоединить(РезультатРазбора.Ошибки, Символы.ПС);
			РезультатОперации.ОшибкиПоИдентификаторам.Вставить(ИдентификаторСообщения, ТекстОшибки);
			
			// Получен список ошибок.
			Шаблон = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
				НСтр("ru = 'В тексте сообщения с идентификатором %1 с сервера СЭДО ФСС получена ошибка';
					|en = 'В тексте сообщения с идентификатором %1 с сервера СЭДО ФСС получена ошибка'"),
				НСтр("ru = 'В тексте сообщения с идентификатором %1 с сервера оператора СЭДО ФСС получена ошибка';
					|en = 'В тексте сообщения с идентификатором %1 с сервера оператора СЭДО ФСС получена ошибка'"));
			Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
			Шаблон = Шаблон + ":
				|%2";
			ОписаниеОшибки = СтрШаблон(Шаблон, ИдентификаторСообщения, ТекстОшибки);
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
			// Записываем ошибку в журнал регистрации.
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение сообщения СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
			ПараметрыЗапроса.ОписаниеОшибки = ОписаниеОшибки;
		Иначе
			// Сообщение было успешно разобрано.
			ДанныеСообщения = РезультатРазбора.ДанныеСообщения;
			ДанныеСообщения.ИдентификаторЗапроса = ПараметрыЗапроса.Идентификатор;
			РезультатОперации.ДанныеСообщений = ЗначениеВКоллекцию(ДанныеСообщения);
			РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
				Организация,
				ДанныеСообщения,
				ТипВзаимодействия,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
				
			Если РезультатСохранения.БылиОшибкиОбработки Тогда
				// Сохраняем данные запроса в журнал запросов.
				СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
				// Удаляем запрос по сообщению из очереди фонового получения.
				УбратьЗапросИзОчередиФоновогоЗадания(ДанныеЗапроса);
				РезультатОперации.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
				ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
				Возврат;
			КонецЕсли;
			РезультатОперации.Выполнено = Истина;
		КонецЕсли;
		
		// Сохраняем данные запроса в журнал запросов.
		СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
		
	Иначе
		Шаблон = НСтр("ru = 'Не удалось получить сообщение СЭДО СФР.
			|%1';
			|en = 'Не удалось получить сообщение СЭДО СФР.
			|%1'");
		РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон, Результат.ОписаниеОшибки);
		РезультатОперации.ОтмененоПользователем = Результат.ОтмененоПользователем;
	КонецЕсли;
	
	Если НЕ ПриВыполненииЗапросаВозниклаОшибкиСоединения(Результат) Тогда
		// Удаляем запрос по сообщению из очереди фонового получения.
		УбратьЗапросИзОчередиФоновогоЗадания(ДанныеЗапроса);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьОшибкуСообщениеСЭДОНеНайдено(Организация, ИдентификаторСообщения)
	
	ТипСтрока = НЕ ЭлектронныйДокументооборотСФСС.ТипСообщенияЧислоВРегистреВходящихСообщенийСЭДО();
	Типы = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(ТипСтрока);
	
	Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Идентификатор = ИдентификаторСообщения;
	Запись.Прочитать();
	Тип332 = Типы.ТипСообщенияОтветНаЗапросИсторическихДанных;
	Если Запись.Тип = Тип332 Тогда
		// Снимает отметку Новое для сообщений 332 типа, так как они удаляются
		// с сервера через неделю после создания.
		Запись.Новое = Ложь;
		Попытка
			Запись.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Шаблон = НСтр("ru = 'При записи данных регистра ВходящиеСообщенияСЭДОФСС по сообщению %1 возникла ошибка :';
							|en = 'При записи данных регистра ВходящиеСообщенияСЭДОФСС по сообщению %1 возникла ошибка :'")
				+ Символы.ПС + "%2";
			ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСообщения, ТекстОшибки);
			ЗаписатьСобытиеСЭДОВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УбратьЗапросИзОчередиФоновогоЗадания(ДанныеЗапроса)
	
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ЗапросыДляПовторнойОтправкиСЭДО.СоздатьМенеджерЗаписи();
	Запись.Организация = ДанныеЗапроса.Организация;
	Запись.Идентификатор = ДанныеЗапроса.ИдентификаторыСообщений[0];
	Запись.Прочитать();
	Если ЗначениеЗаполнено(Запись.Идентификатор) Тогда
		Попытка
			Запись.Удалить();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Шаблон = НСтр("ru = 'При записи данных регистра ""Запросы для повторной отправки СЭДО"" возникла ошибка:';
							|en = 'При записи данных регистра ""Запросы для повторной отправки СЭДО"" возникла ошибка:'")
				+ Символы.ПС + "%1";
			ТекстОшибки = СтрШаблон(Шаблон, ТекстОшибки);
			ЗаписатьСобытиеСЭДОВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
			ТекстОшибки = НСтр("ru = 'При удалении записи регистра ""Запросы для повторной отправки СЭДО"" возникла ошибка.';
								|en = 'При удалении записи регистра ""Запросы для повторной отправки СЭДО"" возникла ошибка.'");
			ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
			ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстОшибки, ПараметрыВывода);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПолучитьСообщенияСЭДОЗаПериод

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериод(ОповещениеОбратногоВызова,
		Организации,
		ДатаНачала,
		ДатаОкончания,
		ПараметрыПолучения) Экспорт
		
	РезультатПолучения = Новый Структура;
	РезультатПолучения.Вставить("ДанныеСообщений", 						Новый Массив);
	РезультатПолучения.Вставить("БылиОшибки", 							Ложь);
	РезультатПолучения.Вставить("Ошибки", 								Новый Массив);
	РезультатПолучения.Вставить("РезультатыПолучения", 					Новый Массив);
	РезультатПолучения.Вставить("ОперацияБылаОтмененаПользователем", 	Ложь);
	РезультатПолучения.Вставить("ОшибкиПоОрганизациям", Новый Соответствие);
	
	// Формируем даты периода.
	ДатыПериода = Новый Массив;
	ТекущаяДата = НачалоДня(ДатаНачала);
	Если ДатаНачала > ДатаОкончания Тогда
		РезультатПолучения.БылиОшибки = Истина;
		ТекстОшибки = НСтр("ru = 'Дата начала периода больше чем дата окончания периода получения сообщений.';
							|en = 'Дата начала периода больше чем дата окончания периода получения сообщений.'");
		РезультатПолучения.Ошибки.Добавить(ТекстОшибки);
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения);
		Возврат;
	КонецЕсли;
	ВремяНачалоДня = Дата(1, 1, 1, 0, 0, 0);
	ВремяКонцаДня = Дата(1, 1, 1, 23, 59, 59);
	Сутки = 3600 * 24;
	ДатаОкончанияКонецДня = КонецДня(ДатаОкончания);
	Пока ТекущаяДата < ДатаОкончанияКонецДня Цикл
		ДатаПериода = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре(
			ТекущаяДата, ВремяНачалоДня, ВремяКонцаДня);
		ДатыПериода.Добавить(ДатаПериода);
		ТекущаяДата = ТекущаяДата + Сутки;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 			ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Организации", 						Организации);
	ДополнительныеПараметры.Вставить("ДатаНачала", 							ДатаНачала);
	ДополнительныеПараметры.Вставить("ДатаОкончания", 						ДатаОкончания);
	ДополнительныеПараметры.Вставить("ОткрыватьФормуДлительнойОперации", 	ПараметрыПолучения.ОткрыватьФормуДлительнойОперации);
	ДополнительныеПараметры.Вставить("ЗадаватьВопросОТестовомСервере", 		ПараметрыПолучения.ЗадаватьВопросОТестовомСервере);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 					ПараметрыПолучения.ТипВзаимодействия);
		ДополнительныеПараметры.Вставить("ПринудительноПовторноПолучитьСообщения",
		ПараметрыПолучения.ПринудительноПовторноПолучитьСообщения);
	ДополнительныеПараметры.Вставить("РезультатПолучения", 					РезультатПолучения);
	ДополнительныеПараметры.Вставить("СброситьСвойстваОбменаПоСЭДОЧерезОператора",
		ПараметрыПолучения.СброситьСвойстваОбменаПоСЭДОЧерезОператора);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации", 			Неопределено);
	ДополнительныеПараметры.Вставить("ДатыПериода", 						ДатыПериода);
	ДополнительныеПараметры.Вставить("ИндексТекущейОрганизации",			0);
	ДополнительныеПараметры.Вставить("ТекущаяОрганизация",					Неопределено);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоОрганизациям",		Новый Соответствие);
	ДополнительныеПараметры.Вставить("ДанныеСообщений332",	Новый Массив);
	ДополнительныеПараметры.Вставить("ИндексТекущегоСообщения", 			0);
	ДополнительныеПараметры.Вставить("ИдентификаторыЗагруженныхСообщений332",Новый Массив);
	ДополнительныеПараметры.Вставить("ИдентификаторыВходящихПоОрганизациям", Новый Соответствие);
	ДополнительныеПараметры.Вставить("ИнтервалОжиданияСообщения332", 		5);
	ДополнительныеПараметры.Вставить("ДатаНачалаОжидания", 					Неопределено);
	ДополнительныеПараметры.Вставить("ПериодОбработчикаОжидания", 			5);
	
	// Открываем форму длительной операции.
	ПараметрыОжидания = Новый Структура();
	ПараметрыОжидания.Вставить("ТекстСообщения", НСтр("ru = 'Получение сообщений СЭДО за период.';
														|en = 'Получение сообщений СЭДО за период.'"));
	Если ПараметрыПолучения.ОткрыватьФормуДлительнойОперации Тогда
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"ОбщаяФорма.ДлительнаяОперация", ПараметрыОжидания);
	КонецЕсли;
	
	ПолучитьСообщенияСЭДОЗаПериодЗапросИдентификторовЦикл(ДополнительныеПараметры);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗапросИдентификторовЦикл(ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	Организации = ДополнительныеПараметры.Организации;
	ДатыПериода = ДополнительныеПараметры.ДатыПериода;
	ЗадаватьВопросОТестовомСервере = ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = ДополнительныеПараметры.СброситьСвойстваОбменаПоСЭДОЧерезОператора;
	СвойстваОбменаПоОрганизациям = ДополнительныеПараметры.СвойстваОбменаПоОрганизациям;
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации;
	ДанныеСообщений332 = ДополнительныеПараметры.ДанныеСообщений332;
	
	Если ИндексТекущейОрганизации > Организации.Количество() - 1 Тогда
		Если ДанныеСообщений332.Количество() = 0 Тогда
			РезультатПолучения.БылиОшибки = Истина;
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения); 
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		Иначе
			ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332(ДополнительныеПараметры);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ФормаДлительнойОперацииОткрыта(ФормаДлительнойОперации) Тогда
		// Пользователь нажал Отмена в форме загрузки.
		РезультатПолучения.ОперацияБылаОтмененаПользователем = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения); 
		Возврат;
	КонецЕсли;
	
	Организация = Организации[ИндексТекущейОрганизации];
	ДополнительныеПараметры.ТекущаяОрганизация = Организация;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, Истина);
	КонецЕсли;
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	СвойстваОбменаПоОрганизациям[Организация] = СвойстваОбменаПоСЭДОЧерезОператора;
	
	Результат = РезультатМетаданныеВходящихСообщенийСЭДОФСС();
	
	ПараметрыПолучения = ПараметрыМетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(Организация, ДатыПериода);
	ПараметрыПолучения.ЗадаватьВопросОТестовомСервере = ЗадаватьВопросОТестовомСервере;
	ПараметрыПолучения.Результат = Результат;
	ПараметрыПолучения.СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора;
	Оповещение = Новый ОписаниеОповещения(
		"ПолучитьСообщенияСЭДОЗаПериодЗапросИдентификаторовЦиклПослеОтправки330", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыПолучения.ОповещениеОбратногоВызова = Оповещение;
	ПараметрыПолучения.ЭтоПользовательскийЗапрос = Истина;
	
	МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(ПараметрыПолучения);
	// Отключаем вопрос о тестовом сервере.
	ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере = Ложь;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗапросИдентификаторовЦиклПослеОтправки330(Результат, ДополнительныеПараметры) Экспорт
	
	СвойстваОбменаПоОрганизациям = ДополнительныеПараметры.СвойстваОбменаПоОрганизациям;
	ОшибкиПоОрганизациям = ДополнительныеПараметры.РезультатПолучения.ОшибкиПоОрганизациям;
	ТекущаяОрганизация = ДополнительныеПараметры.ТекущаяОрганизация;
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	ДанныеСообщений332 = ДополнительныеПараметры.ДанныеСообщений332;
	ИдентификаторыЗагруженныхСообщений332 = ДополнительныеПараметры.ИдентификаторыЗагруженныхСообщений332;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	ПринудительноПовторноПолучитьСообщения = ДополнительныеПараметры.ПринудительноПовторноПолучитьСообщения;
	ИдентификаторыВходящихПоОрганизациям = ДополнительныеПараметры.ИдентификаторыВходящихПоОрганизациям;
	
	Если НЕ Результат.Выполнено Тогда
		Ошибки = ОшибкиПоОрганизациям[ТекущаяОрганизация];
		Если Ошибки = Неопределено Тогда
			Ошибки = Новый Массив;
		КонецЕсли;
		Ошибки.Добавить(Результат.ОписаниеОшибки);
		ОшибкиПоОрганизациям[ТекущаяОрганизация] = Ошибки;
		РезультатПолучения.Ошибки.Добавить(Результат.ОписаниеОшибки);
		РезультатПолучения.БылиОшибки = Истина;
	Иначе
		СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоОрганизациям[ТекущаяОрганизация];
		Сообщение = Новый Структура();
		Сообщение.Вставить("Организация", ТекущаяОрганизация);
		Сообщение.Вставить("ИдентификаторСообщения", Результат.ИдентификаторСообщения);
		ДанныеСообщений332.Добавить(Сообщение);
		Если СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// При прямом обмене сообщение 332 обычно загружается сразу.
			Если НЕ Результат.Сообщение332НеНайдено Тогда
				ИдентификаторыЗагруженныхСообщений332.Добавить(Результат.ИдентификаторСообщения);
				Если ПринудительноПовторноПолучитьСообщения Тогда
					ИдентификаторыВходящихПоОрганизациям[ТекущаяОрганизация] = Результат.ИдентификаторыСообщенийИз332;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры.ИндексТекущейОрганизации = ИндексТекущейОрганизации + 1;
	ПолучитьСообщенияСЭДОЗаПериодЗапросИдентификторовЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332(ДополнительныеПараметры) Экспорт
	
	ИнтервалОжиданияСообщения332 = ДополнительныеПараметры.ИнтервалОжиданияСообщения332;
	СвойстваОбменаПоОрганизациям = ДополнительныеПараметры.СвойстваОбменаПоОрганизациям;
	ПериодОбработчикаОжидания = ДополнительныеПараметры.ПериодОбработчикаОжидания;
	
	ЕстьОбменЧерезОператора = Ложь;
	Для каждого КлючЗначение Из СвойстваОбменаПоОрганизациям Цикл
		СвойстваОбменаПоСЭДОЧерезОператора = КлючЗначение.Значение;
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			ЕстьОбменЧерезОператора = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Делаем паузу перед следующей попыткой скачать 332 сообщения (список сообщений в ответ на тип 330).
	ДополнительныеПараметры.ДатаНачалаОжидания = ТекущаяДата();
	ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
		"БРО.ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений");
	ПодключитьОбработчикОжидания("Подключаемый_ПолучитьСообщенияСЭДОЗаПериод", ПериодОбработчикаОжидания, Истина);
	
	ТекстСообщения = НСтр("ru = 'СЭДО СФР';
							|en = 'СЭДО СФР'");
	Шаблон = НСтр("ru = 'Пауза %1 секунд перед скачиванием списка сообщений.';
					|en = 'Пауза %1 секунд перед скачиванием списка сообщений.'");
	Пояснение = СтрШаблон(Шаблон, ИнтервалОжиданияСообщения332);
	Пояснение = Пояснение + " " + НСтр("ru = 'Загрузку можно прервать, данные будут загружены позднее автоматически...';
										|en = 'Загрузку можно прервать, данные будут загружены позднее автоматически...'");
	Состояние(ТекстСообщения, , Пояснение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332Цикл(ДополнительныеПараметры) Экспорт
	
	Сообщения332 = ДополнительныеПараметры.ДанныеСообщений332;
	ИндексТекущегоСообщения = ДополнительныеПараметры.ИндексТекущегоСообщения;
	ЗадаватьВопросОТестовомСервере = ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТипВзаимодействия = ДополнительныеПараметры.ТипВзаимодействия;
	ИдентификаторыЗагруженныхСообщений332 = ДополнительныеПараметры.ИдентификаторыЗагруженныхСообщений332;
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	
	Если ИндексТекущегоСообщения > Сообщения332.Количество() - 1 Тогда
		Если ИдентификаторыЗагруженныхСообщений332.Количество() = Сообщения332.Количество() Тогда
			// Были загружены все сообщения 332.
			ДополнительныеПараметры.ИндексТекущейОрганизации = 0;
			ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦикл(ДополнительныеПараметры);
		Иначе
			// Включаем обработчик ожидания и делаем следующую попытку загружить сообщения 332.
			ДополнительныеПараметры.ИндексТекущегоСообщения = 0;
			ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332(ДополнительныеПараметры);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ФормаДлительнойОперацииОткрыта(ФормаДлительнойОперации) Тогда
		// Пользователь нажал Отмена в форме загрузки.
		РезультатПолучения.ОперацияБылаОтмененаПользователем = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения); 
		Возврат;
	КонецЕсли;
	
	Сообщение = Сообщения332[ИндексТекущегоСообщения];
	ДополнительныеПараметры.ТекущаяОрганизация = Сообщение.Организация;
	Если НЕ ИдентификаторыЗагруженныхСообщений332.Найти(Сообщение.ИдентификаторСообщения) = Неопределено Тогда
		// Сообщение 332 уже было загружено.
		ДополнительныеПараметры.ИндексТекущегоСообщения = ИндексТекущегоСообщения + 1;
		ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332Цикл(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332ПослеЗапроса", ЭтотОбъект, ДополнительныеПараметры);
	ПолучитьСообщениеСЭДОФСС(Оповещение,
		Сообщение.Организация,
		Сообщение.ИдентификаторСообщения,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332ПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ИдентификаторыЗагруженныхСообщений332 = ДополнительныеПараметры.ИдентификаторыЗагруженныхСообщений332;
	ИндексТекущегоСообщения = ДополнительныеПараметры.ИндексТекущегоСообщения;
	Сообщения332 = ДополнительныеПараметры.ДанныеСообщений332;
	ОшибкиПоОрганизациям = ДополнительныеПараметры.РезультатПолучения.ОшибкиПоОрганизациям;
	ТекущаяОрганизация = ДополнительныеПараметры.ТекущаяОрганизация;
	ПринудительноПовторноПолучитьСообщения = ДополнительныеПараметры.ПринудительноПовторноПолучитьСообщения;
	ИдентификаторыВходящихПоОрганизациям = ДополнительныеПараметры.ИдентификаторыВходящихПоОрганизациям;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	СвойстваОбменаПоОрганизациям = ДополнительныеПараметры.СвойстваОбменаПоОрганизациям;
	ИнтервалОжиданияСообщения332 = ДополнительныеПараметры.ИнтервалОжиданияСообщения332;
	
	СвойстваОбменаПоОрганизации = СвойстваОбменаПоОрганизациям[ТекущаяОрганизация];
	Если НЕ Результат.Выполнено Тогда
		Ошибки = ОшибкиПоОрганизациям[ТекущаяОрганизация];
		Если Ошибки = Неопределено Тогда
			Ошибки = Новый Массив;
		КонецЕсли;
		Если СвойстваОбменаПоОрганизации.ОбменПоСЭДОНапрямую Тогда
			ТекстОшибки = НСтр("ru = 'Не был загружен ответ сервера СЭДО со списком сообщений. Через %1 секунд будет выполнена ещё одна попытка загрузки...';
								|en = 'Не был загружен ответ сервера СЭДО со списком сообщений. Через %1 секунд будет выполнена ещё одна попытка загрузки...'");
		Иначе
			ТекстОшибки = НСтр("ru = 'Не был загружен ответ оператора со списком сообщений, возможно сообщения ещё не подготовлены. Через %1 секунд будет выполнена ещё одна попытка загрузки...';
								|en = 'Не был загружен ответ оператора со списком сообщений, возможно сообщения ещё не подготовлены. Через %1 секунд будет выполнена ещё одна попытка загрузки...'");
		КонецЕсли;
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИнтервалОжиданияСообщения332);
		
		РезультатПолучения.Ошибки.Добавить(ТекстОшибки);
		Ошибки.Добавить(Результат.ОписаниеОшибки);
		ОшибкиПоОрганизациям[ТекущаяОрганизация] = Ошибки;
	Иначе
		Сообщение = Сообщения332[ИндексТекущегоСообщения];
		ИдентификаторыЗагруженныхСообщений332.Добавить(Сообщение.ИдентификаторСообщения);
		Если ПринудительноПовторноПолучитьСообщения Тогда
			РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(
				Результат.ДанныеСообщений[0].ТекстСообщения, Неопределено, СвойстваОбменаПоОрганизации);
			ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
			Идентификаторы = Новый Массив;
			Для каждого Данные Из ДанныеСообщений Цикл
				Идентификаторы.Добавить(Данные.Идентификатор);
			КонецЦикла;
			ИдентификаторыВходящихПоОрганизациям[ТекущаяОрганизация] = Идентификаторы;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры.ИндексТекущегоСообщения = ИндексТекущегоСообщения + 1;
	ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332Цикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦикл(ДополнительныеПараметры) Экспорт
	
	// Загрузка сообщений.
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	Организации = ДополнительныеПараметры.Организации;
	ЗадаватьВопросОТестовомСервере = ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = ДополнительныеПараметры.СброситьСвойстваОбменаПоСЭДОЧерезОператора;
	СвойстваОбменаПоОрганизациям = ДополнительныеПараметры.СвойстваОбменаПоОрганизациям; 
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации; 
	ТипВзаимодействия = ДополнительныеПараметры.ТипВзаимодействия;
	ПринудительноПовторноПолучитьСообщения = ДополнительныеПараметры.ПринудительноПовторноПолучитьСообщения;
	ИдентификаторыВходящихПоОрганизациям = ДополнительныеПараметры.ИдентификаторыВходящихПоОрганизациям;
	ДатаНачала = НачалоДня(ДополнительныеПараметры.ДатаНачала);
	
	Если ИндексТекущейОрганизации > Организации.Количество() - 1 Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения); 
		ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		Возврат;
	КонецЕсли;
	
	Организация = Организации[ИндексТекущейОрганизации];
	ДополнительныеПараметры.ТекущаяОрганизация = Организация;
	
	ТипыВзаимодействий = Неопределено;
	Если ПринудительноПовторноПолучитьСообщения Тогда
		// Загружаемс все сообщения, которые пришли в 332.
		Идентификаторы = ИдентификаторыВходящихПоОрганизациям[Организация];
	Иначе
		НовыеСообщения = НовыеСообщенияСЭДОФСС(Организация, , ТипВзаимодействия, ДатаНачала);
		Если НовыеСообщения.Количество() = 0 Тогда
			ДополнительныеПараметры.ИндексТекущейОрганизации = ИндексТекущейОрганизации + 1;
			ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦикл(ДополнительныеПараметры);
			Возврат;
		КонецЕсли;
		
		Идентификаторы = Новый Массив;
		ТипыВзаимодействий = Новый Массив;
		
		Для каждого Сообщение Из НовыеСообщения Цикл
			Идентификаторы.Добавить(Сообщение.Идентификатор);
			ТипыВзаимодействий.Добавить(Сообщение.ТипВзаимодействия);
		КонецЦикла;
	КонецЕсли;
	
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = Ложь;
	
	// Получаем содержимое входящих сообщений по организации.
	Оповещение = Новый ОписаниеОповещения("ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦиклПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьСообщенияСЭДОФСС(
		Оповещение,
		Организация,
		Идентификаторы,
		Ложь,
		ЗадаватьВопросОТестовомСервере,
		ТипыВзаимодействий,
		СброситьСвойстваОбменаПоСЭДОЧерезОператора,
		ФормаДлительнойОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦиклПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОшибкиПоОрганизациям = ДополнительныеПараметры.РезультатПолучения.ОшибкиПоОрганизациям;
	ТекущаяОрганизация = ДополнительныеПараметры.ТекущаяОрганизация;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	
	Если Результат.БылиОшибки Тогда
		РезультатПолучения.БылиОшибки = Истина;
		Ошибки = ОшибкиПоОрганизациям[ТекущаяОрганизация];
		Если Ошибки = Неопределено Тогда
			Ошибки = Новый Массив;
		КонецЕсли;
		Для каждого Ошибка Из Результат.Ошибки Цикл
			Ошибки.Добавить(Ошибка);
			РезультатПолучения.Ошибки.Добавить(Ошибка);
		КонецЦикла;
		ОшибкиПоОрганизациям[ТекущаяОрганизация] = Ошибки;
	КонецЕсли;
	
	// Извлекаем результаты.
	Для каждого Данные Из Результат.ДанныеСообщений Цикл
		РезультатПолучения.ДанныеСообщений.Добавить(Данные);
	КонецЦикла;
	Для каждого ДанныеРезультата Из Результат.РезультатыПолучения Цикл
		РезультатПолучения.РезультатыПолучения.Добавить(ДанныеРезультата);
	КонецЦикла;
	
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	
	ДополнительныеПараметры.ИндексТекущейОрганизации = ИндексТекущейОрганизации + 1;
	ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщенийЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолучитьСообщенияСЭДОЗаПериод()

	ДополнительныеПараметры = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений");
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации;
	ДатаНачалаОжидания = ДополнительныеПараметры.ДатаНачалаОжидания;
	ПериодОбработчикаОжидания = ДополнительныеПараметры.ПериодОбработчикаОжидания;
	ИнтервалОжиданияСообщения332 = ДополнительныеПараметры.ИнтервалОжиданияСообщения332;
	РезультатПолучения = ДополнительныеПараметры.РезультатПолучения;
	
	Если НЕ ФормаДлительнойОперацииОткрыта(ФормаДлительнойОперации) Тогда
		// Пользователь нажал Отмена в форме загрузки.
		РезультатПолучения.ОперацияБылаОтмененаПользователем = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатПолучения);
		Возврат;
	КонецЕсли;
	
	Если ТекущаяДата() - ДатаНачалаОжидания >= ИнтервалОжиданияСообщения332 Тогда
		// Заданный интервал закончился.
		МаксимальныйИнтервалОжидания = 60;
		ИнтервалОжиданияСообщения332 = ИнтервалОжиданияСообщения332 * 2;
		Если ИнтервалОжиданияСообщения332 > МаксимальныйИнтервалОжидания Тогда
			ИнтервалОжиданияСообщения332 = МаксимальныйИнтервалОжидания;
		КонецЕсли;
		ДополнительныеПараметры.ИнтервалОжиданияСообщения332 = ИнтервалОжиданияСообщения332;
		// Продолжаем получение.
		ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений332Цикл(ДополнительныеПараметры);
	Иначе
		// Продолжаем ожидание.
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
			"БРО.ПолучитьСообщенияСЭДОЗаПериодЗагрузкаСообщений");
		ПодключитьОбработчикОжидания("Подключаемый_ПолучитьСообщенияСЭДОЗаПериод", ПериодОбработчикаОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РезультатМетаданныеВходящихСообщенийСЭДОФСС()
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщений", Новый Массив);
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("АдресЗашифрованногоЗапросаSOAP", "");
	Результат.Вставить("ИдентификаторСообщения", "");
	Результат.Вставить("ИдентификаторыСообщенийИз332", Новый Массив);
	Результат.Вставить("Сообщение332НеНайдено", Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область МетаданныеВходящихСообщенийОрганизацийСЭДОФСС

&НаКлиенте
Процедура МетаданныеВходящихСообщенийОрганизацийСЭДОФСС(ОповещениеОбратногоВызова,
		Организации,
		СообщенияСДаты = Неопределено,
		СообщенияПоДату = Неопределено,
		ТипВзаимодействия = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщенийПоОрганизациям", Новый Соответствие);
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 	ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 					Результат);
	ДополнительныеПараметры.Вставить("Организации", 				Организации);
	ДополнительныеПараметры.Вставить("ИндексОрганизации", 			0);
	ДополнительныеПараметры.Вставить("СообщенияСДаты", 				СообщенияСДаты);
	ДополнительныеПараметры.Вставить("СообщенияПоДату", 			Неопределено);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 			ТипВзаимодействия);
	
	МетаданныеВходящихСообщенийОрганизацийСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийОрганизацийСЭДОФССЦикл(ДополнительныеПараметры)
	
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 			= ДополнительныеПараметры.Результат;
	ИндексОрганизации 			= ДополнительныеПараметры.ИндексОрганизации;
	Организации 				= ДополнительныеПараметры.Организации;
	Результат 					= ДополнительныеПараметры.Результат;
	СообщенияСДаты 				= ДополнительныеПараметры.СообщенияСДаты;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	
	Если ИндексОрганизации >= Организации.Количество() Тогда
		Результат.Выполнено = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Организация = Организации[ИндексОрганизации];
	
	Оповещение = Новый ОписаниеОповещения("МетаданныеВходящихСообщенийОрганизацийСЭДОФССЦиклПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	МетаданныеВходящихСообщенийСЭДОФСС(
		Оповещение,
		Организация,
		СообщенияСДаты,,
		ТипВзаимодействия);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийОрганизацийСЭДОФССЦиклПослеЗапроса(РезультатПолучитьДанныеСообщений, ДополнительныеПараметры) Экспорт
	
	Результат = ДополнительныеПараметры.Результат;
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексОрганизации = ДополнительныеПараметры.ИндексОрганизации;
	Организации = ДополнительныеПараметры.Организации;
	ДанныеСообщенийПоОрганизациям = Результат.ДанныеСообщенийПоОрганизациям;
	
	Если НЕ РезультатПолучитьДанныеСообщений.Выполнено Тогда
		Результат.ОписаниеОшибки = РезультатПолучитьДанныеСообщений.ОписаниеОшибки;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Организация = Организации[ИндексОрганизации];
	ДанныеСообщенийПоОрганизациям.Вставить(Организация, РезультатПолучитьДанныеСообщений.ДанныеСообщений);
	
	ИндексОрганизации = ИндексОрганизации + 1;
	ДополнительныеПараметры.ИндексОрганизации = ИндексОрганизации;
	
	МетаданныеВходящихСообщенийОрганизацийСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область МетаданныеВходящихСообщенийСЭДОФСС

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФСС(
		ОповещениеОбратногоВызова,
		Организация,
		ДатаСообщений = Неопределено,
		НеПроверятьПодписьФСС = Ложь,
		ТипВзаимодействия = Неопределено,
		СброситьСвойстваОбменаПоСЭДОЧерезОператора = Истина) Экспорт
	
	Результат = РезультатМетаданныеВходящихСообщенийСЭДОФСС();
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ОтображатьСостояние = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ОтображатьСостояние") Тогда
		ОтображатьСостояние = ОповещениеОбратногоВызова.ДополнительныеПараметры.ОтображатьСостояние;
	КонецЕсли;
	
	ЗадаватьВопросОТестовомСервере = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ЗадаватьВопросОТестовомСервере") Тогда
		ЗадаватьВопросОТестовомСервере = 
			ОповещениеОбратногоВызова.ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	КонецЕсли;
	
	Настройки = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Настройки.ТипВзаимодействия = ТипВзаимодействия;
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		ЗаполнитьЗначенияСвойств(Настройки, СвойстваОрганизации);
	КонецЕсли;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
	КонецЕсли;
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	Настройки.ОбменПоСЭДОНапрямую 		= СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	Настройки.ИдентификаторАбонентаСЭДО = СвойстваОбменаПоСЭДОЧерезОператора.ИдентификаторАбонентаСЭДО;
	
	ТекстЗапроса = ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
		РегистрационныйНомерФСС,
		ДатаСообщений,
		Настройки);
	
	Операция = ОперацияПолученияСпискаВходящихСЭДОФСС();
	ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
	ЗапросДляПолученияДанных.Организация =Организация;
	ЗапросДляПолученияДанных.Операция = Операция;
	ЗапросДляПолученияДанных.ТекстЗапроса = ТекстЗапроса;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", 	ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Результат", 					Результат);
	ДополнительныеПараметры.Вставить("Организация", 				Организация);
	ДополнительныеПараметры.Вставить("Операция", 					Операция);
	ДополнительныеПараметры.Вставить("ТекстЗапроса", 				ТекстЗапроса);
	ДополнительныеПараметры.Вставить("ДатаСообщений", 				ДатаСообщений);
	ДополнительныеПараметры.Вставить("ТипВзаимодействия", 			ТипВзаимодействия);
	ДополнительныеПараметры.Вставить("ОтображатьСостояние", 		ОтображатьСостояние);
	ДополнительныеПараметры.Вставить("СвойстваОбменаПоСЭДОЧерезОператора", СвойстваОбменаПоСЭДОЧерезОператора);
	
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ТипСообщенияОтвета") Тогда
		ДополнительныеПараметры.Вставить("ТипСообщенияОтвета",
			ОповещениеОбратногоВызова.ДополнительныеПараметры.ТипСообщенияОтвета);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("МетаданныеВходящихСообщенийСЭДОФССПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьДанныеСЭДОФСС(
		Оповещение,
		ЗапросДляПолученияДанных,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия,
		ОтображатьСостояние,
		СвойстваОбменаПоСЭДОЧерезОператора);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 			= ДополнительныеПараметры.Результат;
	Организация 				= ДополнительныеПараметры.Организация;
	Операция 					= ДополнительныеПараметры.Операция;
	ТекстЗапроса 				= ДополнительныеПараметры.ТекстЗапроса;
	ДатаСообщений 				= ДополнительныеПараметры.ДатаСообщений;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	СвойстваОбменаПоСЭДОЧерезОператора = ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	Если Результат.Выполнено Тогда
		
		// Сообщения были успешно получены.
		ТекстОтвета = ПолучитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP);
		
		// Разбор ответа сервера.
		РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(ТекстОтвета, ДатаСообщений, СвойстваОбменаПоСЭДОЧерезОператора);
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			
			Шаблон = НСтр("ru = 'При получении данных сообщений ФСС произошла ошибка:
			|%1';
			|en = 'При получении данных сообщений ФСС произошла ошибка:
			|%1'");
			ОписаниеОшибки = СтрШаблон(Шаблон, РезультатРазбора.ОписаниеОшибки);
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
				
			// В случае ошибки разбора сохраняем запрос в журнал запросов.
			ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
			ПараметрыЗапроса.ОписаниеОшибки = ОписаниеОшибки;
			ПараметрыЗапроса.АдресЗапросаSOAP = Результат.АдресПодписаногоЗапросаSOAP;
			ПараметрыЗапроса.АдресОтветаSOAP = Результат.АдресРасшифрованногоОтветаSOAP;
			ПараметрыЗапроса.АдресРесурса = Результат.АдресРесурса;
			ПараметрыЗапроса.АдресСервера = Результат.АдресСервера;
			ПараметрыЗапроса.КодСостояния = Результат.КодСостояния;
			ПараметрыЗапроса.ТипВзаимодействияСЭДО = ТипВзаимодействия;
			ПараметрыЗапроса.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
			СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
			
		Иначе
			
			ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
			РезультатОперации.ДанныеСообщений = ДанныеСообщений;
			// Сохранение данных о сообщениях в БД.
			РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
				Организация,
				ДанныеСообщений,
				ТипВзаимодействия,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			Если РезультатСохранения.БылиОшибкиОбработки Тогда
				РезультатОперации.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
				ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
				Возврат;
			КонецЕсли;
			
			ДанныеШироковещательныхСообщений = РезультатРазбора.ДанныеШироковещательныхСообщений;
			СохранитьДанныеРассылокСЭДОФСС(
				Организация,
				ДанныеШироковещательныхСообщений,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			
			РезультатОперации.Выполнено = Истина;
			
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(Результат.АдресПодписаногоЗапросаSOAP) Тогда
			УдалитьИзВременногоХранилища(Результат.АдресПодписаногоЗапросаSOAP);
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP) Тогда
			УдалитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP);
		КонецЕсли;
		
	Иначе
		
		Если ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// Для прямого обмена выполняем дополнительную обработку результата получения.
			ОбработатьОшибкуПриПолученииМетаданныхВходящихСЭДО(Результат, РезультатОперации, ДополнительныеПараметры);
		Иначе
			РезультатОперации.ОписаниеОшибки = Результат.ОписаниеОшибки;
		КонецЕсли;
	
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция МетаданныеВходящихСообщенийСЭДОАктуальны(Организация, ОбменПоСЭДОНапрямую = Неопределено)
	
	ДатаПоследнегоСеансаОбмена = ДатаПоследнегоСеансаОбменаСЭДО(Организация, ОбменПоСЭДОНапрямую);
	ТекущееВремяПоМоскве = ЭлектронныйДокументооборотСФСС.МосковскоеВремя();
	ПериодАктуальностиСпискаВходящих = 24 * 3600;
	
	Возврат ТекущееВремяПоМоскве - ДатаПоследнегоСеансаОбмена < ПериодАктуальностиСпискаВходящих;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДатаПоследнегоСеансаОбменаСЭДО(Организация, ОбменПоСЭДОНапрямую = Неопределено)
	
	ОбменЧерезОператора = Неопределено;
	Если НЕ ОбменПоСЭДОНапрямую = Неопределено Тогда
		ОбменЧерезОператора = НЕ ОбменПоСЭДОНапрямую;
	КонецЕсли; 
	
	Возврат ЭлектронныйДокументооборотСФСС.ДатаСобытияСЭДО(
		Организация, Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщений, ОбменЧерезОператора);
	
КонецФункции

&НаКлиенте
Функция ОбработатьОшибкуПриПолученииМетаданныхВходящихСЭДО(РезультатОтправкиЗапроса, РезультатПолученияВходящих, ДополнительныеПараметры)
	
	Организация 						= ДополнительныеПараметры.Организация;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	БылаОшибкаСоединения = ПриВыполненииЗапросаВозниклаОшибкиСоединения(РезультатОтправкиЗапроса);
	Если НЕ БылаОшибкаСоединения
		ИЛИ (БылаОшибкаСоединения
			И НЕ МетаданныеВходящихСообщенийСЭДОАктуальны(Организация, СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую))Тогда
		// Список входящих не получался дольше, чем заданный период.
		Если БылаОшибкаСоединения Тогда
			Шаблон = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
				НСтр("ru = 'Похоже, сервер СЭДО ФСС перегружен. Попробуйте повторить получение сообщений через некоторое время.';
					|en = 'Похоже, сервер СЭДО ФСС перегружен. Попробуйте повторить получение сообщений через некоторое время.'"),
				НСтр("ru = 'Похоже, сервер оператора СЭДО ФСС перегружен. Попробуйте повторить получение сообщений через некоторое время.';
					|en = 'Похоже, сервер оператора СЭДО ФСС перегружен. Попробуйте повторить получение сообщений через некоторое время.'"));
			Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
			Шаблон = Шаблон + Символы.ПС + НСтр("ru = 'Подробнее:';
												|en = 'Подробнее:'") + Символы.ПС
			+ "Не удалось получить список входящих сообщений СЭДО." + Символы.ПС
			+ "%1" + Символы.ПС
			+ "Список входящих также будет загружаться в фоновом режиме, после получения будет предложено их расшифровать.";
		Иначе
			Шаблон = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
				НСтр("ru = 'Не удалось получить список входящих сообщений СЭДО СФР.';
					|en = 'Не удалось получить список входящих сообщений СЭДО СФР.'"),
				НСтр("ru = 'Не удалось получить список входящих сообщений оператора СЭДО СФР.';
					|en = 'Не удалось получить список входящих сообщений оператора СЭДО СФР.'"))
			+ НСтр("ru = 'Подробнее:';
					|en = 'Подробнее:'") + Символы.ПС
			+ "%1" + Символы.ПС
			+ НСтр("ru = 'Список входящих также будет загружаться в фоновом режиме, после получения будет предложено их расшифровать.';
					|en = 'Список входящих также будет загружаться в фоновом режиме, после получения будет предложено их расшифровать.'");
		КонецЕсли;
		РезультатПолученияВходящих.ОписаниеОшибки = СтрШаблон(Шаблон, РезультатОтправкиЗапроса.ОписаниеОшибки);
		Если РезультатПолученияВходящих.Свойство("АдресЗашифрованногоЗапросаSOAP") Тогда
			РезультатПолученияВходящих.АдресЗашифрованногоЗапросаSOAP = РезультатОтправкиЗапроса.АдресЗашифрованногоЗапросаSOAP;
		КонецЕсли;
	Иначе
		РезультатПолученияВходящих.Выполнено = Истина;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

#Область МетаданныеВходящихСообщенийСЭДОФССЗаПериод

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗаПериод(
	ОповещениеОбратногоВызова,
	Организация,
	НеПроверятьПодписьФСС = Ложь,
	ТипВзаимодействия = Неопределено,
	СброситьСвойстваОбменаПоСЭДОЧерезОператора = Истина) Экспорт
	
	Результат = РезультатМетаданныеВходящихСообщенийСЭДОФСС();
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	Если СброситьСвойстваОбменаПоСЭДОЧерезОператора Тогда
		СброситьБезПолучения = Истина;
		СвойстваОбменаПоСЭДОЧерезОператора(Организация, СброситьБезПолучения);
	КонецЕсли;
	СвойстваОбменаПоСЭДОЧерезОператора = СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	
	НуженАнализВходящих = Ложь;
	Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
		КоличествоЗапросовИсторическихСообщений = ПолучитьКоличествоЗапросовИсторическихСообщений(
			Организация, Ложь);
		НуженАнализВходящих = КоличествоЗапросовИсторическихСообщений = 0;
	КонецЕсли;
	
	ТекущаяДата = Неопределено;
	СведенияОДатахПолученияСообщений = ПолучитьДатыПолученияСообщений(
		Организация,
		ТекущаяДата,
		СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
		НуженАнализВходящих);
	ДатыПолученияСообщений = СведенияОДатахПолученияСообщений.МассивДат;
	
	Если ДатыПолученияСообщений.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	ОтображатьСостояние = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ОтображатьСостояние") Тогда
		ОтображатьСостояние = ОповещениеОбратногоВызова.ДополнительныеПараметры.ОтображатьСостояние;
	КонецЕсли;
	
	ЗадаватьВопросОТестовомСервере = Истина;
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ЗадаватьВопросОТестовомСервере") Тогда
		ЗадаватьВопросОТестовомСервере = 
			ОповещениеОбратногоВызова.ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	КонецЕсли;
	
	ДополнительныеПараметры = ПараметрыМетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(Организация, ДатыПолученияСообщений);
	ДополнительныеПараметры.ОповещениеОбратногоВызова 			= ОповещениеОбратногоВызова;
	ДополнительныеПараметры.Результат 							= Результат;
	ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере 		= ЗадаватьВопросОТестовомСервере;
	ДополнительныеПараметры.ТипВзаимодействия 					= ТипВзаимодействия;
	ДополнительныеПараметры.ТекущаяДата 						= Дата(1, 1, 1);
	ДополнительныеПараметры.ОтображатьСостояние 				= ОтображатьСостояние;
	ДополнительныеПараметры.ОшибкаПриЗапросеМетаданных 			= Ложь;
	ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора 	= СвойстваОбменаПоСЭДОЧерезОператора;
	
	ПолучениеАктуальныхСообщений = ?(
		ДатыПолученияСообщений.Количество() > 0 И НЕ ЗначениеЗаполнено(ДатыПолученияСообщений[0].Дата),
		Истина,
		Ложь);
	ДополнительныеПараметры.ПредварительноПолучитьАктуальные = ПолучениеАктуальныхСообщений;
	
	СообщенияДоСЭДОЧерезОператораПолучены = (СведенияОДатахПолученияСообщений.ОбменЧерезОператора = Истина);
	ДополнительныеПараметры.СообщенияДоСЭДОЧерезОператораПолучены = СообщенияДоСЭДОЧерезОператораПолучены;
	
	Если СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
		ИЛИ СообщенияДоСЭДОЧерезОператораПолучены Тогда
			
		МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(ДополнительныеПараметры);
		
	Иначе
		Если КоличествоЗапросовИсторическихСообщений = 0 Тогда
			Если НЕ СведенияОДатахПолученияСообщений.Найдено Тогда
				// оператор не может прислать старые сообщения до подписки страхователя при первой отправке,
				// кроме как в результате явного запроса исторических сообщений
				КоличествоДнейЗагрузкиИсторииЧерезОператора = 14;
				МассивДат = Новый Массив;
				ДатаПолученияСообщения = ТекущаяДата - КоличествоДнейЗагрузкиИсторииЧерезОператора * 24 * 60 * 60;
				Для НомерДня = 0 По КоличествоДнейЗагрузкиИсторииЧерезОператора Цикл
					ВремяНачала = ?(НомерДня = 0, ДатаПолученияСообщения, НачалоДня(ДатаПолученияСообщения));
					ВремяКонца = ?(НомерДня = КоличествоДнейЗагрузкиИсторииЧерезОператора,
						ДатаПолученияСообщения, КонецДня(ДатаПолученияСообщения));
					СтрокаДат = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре(
						ДатаПолученияСообщения, ВремяНачала, ВремяКонца);
					МассивДат.Добавить(СтрокаДат);
					ДатаПолученияСообщения = ДатаПолученияСообщения + 24 * 60 * 60;
				КонецЦикла;
				ДополнительныеПараметры.ДатыПолученияСообщений = МассивДат;
			КонецЕсли;
			МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(ДополнительныеПараметры);
			
		Иначе
			
			// Сообщение на подписку страхователя к оператору было отправлено.
 			РезультатПолучения = МетаданныеВходящихСообщенийСЭДОЗаПериодБезКриптографии(
				Организация, ДатыПолученияСообщений, Истина, СвойстваОбменаПоСЭДОЧерезОператора);
			ЗаполнитьЗначенияСвойств(Результат, РезультатПолучения);
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗаПериодЦикл(ДополнительныеПараметры)
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	Организация 						= ДополнительныеПараметры.Организация;
	Результат 							= ДополнительныеПараметры.Результат;
	ДатыПолученияСообщений				= ДополнительныеПараметры.ДатыПолученияСообщений;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ЗадаватьВопросОТестовомСервере		= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТекущаяДата							= ДополнительныеПараметры.ТекущаяДата;
	ОшибкаПриЗапросеМетаданных			= ДополнительныеПараметры.ОшибкаПриЗапросеМетаданных;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	НеСохранятьДатуЗагрузкиИдентификаторов = ДополнительныеПараметры.НеСохранятьДатуЗагрузкиИдентификаторов;
	
	ОтображатьСостояние = ?(ДополнительныеПараметры.Свойство("ОтображатьСостояние"),
		ДополнительныеПараметры.ОтображатьСостояние,
		Истина);
	
	Если ОшибкаПриЗапросеМетаданных ИЛИ ДатыПолученияСообщений.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекущаяДата)
			И НЕ НеСохранятьДатуЗагрузкиИдентификаторов Тогда
			СохранитьДатуСеансаОбменаСЭДОФСС(
				Организация,
				ТекущаяДата,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		КонецЕсли;
		
		Если СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			Результат.Выполнено = Истина;
		Иначе
			Результат.Выполнено = НЕ ОшибкаПриЗапросеМетаданных;
		КонецЕсли;
		
		Если ТипЗнч(ОповещениеОбратногоВызова.ДополнительныеПараметры) = Тип("Структура") Тогда
			ОповещениеОбратногоВызова.ДополнительныеПараметры.Вставить("ТекущаяДата", ТекущаяДата);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	ДатаСообщения = Неопределено;
	Если ДатыПолученияСообщений.Количество() > 0 Тогда
		ДатаСообщения = ДатыПолученияСообщений[0];
		ДатыПолученияСообщений.Удалить(0);
		Если НЕ ЗначениеЗаполнено(ДатаСообщения.Дата) Тогда
			ДатаСообщения = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ДатаПолученияСообщений = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьДатуПолученияСообщений(
		ДатаСообщения);
	
	Настройки = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Настройки.ТипВзаимодействия = ТипВзаимодействия;
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		ЗаполнитьЗначенияСвойств(Настройки, СвойстваОрганизации);
	КонецЕсли;
	
	Настройки.ОбменПоСЭДОНапрямую 		= СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	Настройки.ИдентификаторАбонентаСЭДО = СвойстваОбменаПоСЭДОЧерезОператора.ИдентификаторАбонентаСЭДО;
	
	ТекстЗапроса = ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
		РегистрационныйНомерФСС,
		ДатаСообщения,
		Настройки);
	
	Операция = ОперацияПолученияСпискаВходящихСЭДОФСС();
	ЗапросДляПолученияДанных = ПараметрыЗапросаПолучитьДанныеСЭДОФСС();
	ЗапросДляПолученияДанных.Организация = Организация;
	ЗапросДляПолученияДанных.Операция = Операция;
	ЗапросДляПолученияДанных.ТекстЗапроса = ТекстЗапроса;
	
	ДополнительныеПараметры.Операция = Операция;
	ДополнительныеПараметры.ТекстЗапроса = ТекстЗапроса;
	ДополнительныеПараметры.ДатаСообщений = ДатаПолученияСообщений;
	
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ТипСообщенияОтвета") Тогда
		ДополнительныеПараметры.Вставить("ТипСообщенияОтвета",
			ОповещениеОбратногоВызова.ДополнительныеПараметры.ТипСообщенияОтвета);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("МетаданныеВходящихСообщенийСЭДОФССЗаПериодПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПолучитьДанныеСЭДОФСС(
		Оповещение,
		ЗапросДляПолученияДанных,
		ЗадаватьВопросОТестовомСервере,
		ТипВзаимодействия,
		ОтображатьСостояние,
		СвойстваОбменаПоСЭДОЧерезОператора);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗаПериодПослеЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 	= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 			= ДополнительныеПараметры.Результат;
	Организация 				= ДополнительныеПараметры.Организация;
	Операция 					= ДополнительныеПараметры.Операция;
	ТекстЗапроса 				= ДополнительныеПараметры.ТекстЗапроса;
	ДатыПолученияСообщений		= ДополнительныеПараметры.ДатыПолученияСообщений;
	ДатаСообщений				= ДополнительныеПараметры.ДатаСообщений;
	ТипВзаимодействия 			= ДополнительныеПараметры.ТипВзаимодействия;
	СвойстваОбменаПоСЭДОЧерезОператора = ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	
	Если Результат.Выполнено Тогда
		
		// Сообщения были успешно получены.
		ТекстОтвета = ПолучитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP);
		
		// Разбор ответа сервера.
		РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(ТекстОтвета, ДатаСообщений, СвойстваОбменаПоСЭДОЧерезОператора);
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			
			Шаблон = НСтр("ru = 'При получении данных сообщений ФСС произошла ошибка:
			|%1';
			|en = 'При получении данных сообщений ФСС произошла ошибка:
			|%1'");
			ОписаниеОшибки = СтрШаблон(Шаблон, РезультатРазбора.ОписаниеОшибки);
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
				
			// В случае ошибки разбора сохраняем запрос в журнал запросов.
			ПараметрыЗапроса = ПараметрыСохраненияЗапросаСЭДОФСС(Организация, Операция);
			ПараметрыЗапроса.ОписаниеОшибки = ОписаниеОшибки;
			ПараметрыЗапроса.АдресЗапросаSOAP = Результат.АдресПодписаногоЗапросаSOAP;
			ПараметрыЗапроса.АдресОтветаSOAP = Результат.АдресРасшифрованногоОтветаSOAP;
			ПараметрыЗапроса.АдресРесурса = Результат.АдресРесурса;
			ПараметрыЗапроса.АдресСервера = Результат.АдресСервера;
			ПараметрыЗапроса.КодСостояния = Результат.КодСостояния;
			ПараметрыЗапроса.ТипВзаимодействияСЭДО = ТипВзаимодействия;
			ПараметрыЗапроса.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
			СохранитьДанныеЗапросаСЭДОФСС(ПараметрыЗапроса);
			
		Иначе
			
			ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
			Для каждого ЭлементДанных из ДанныеСообщений Цикл
				РезультатОперации.ДанныеСообщений.Добавить(ЭлементДанных);
			КонецЦикла;
			// Сохранение данных о сообщениях в БД.
			РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
				Организация,
				ДанныеСообщений,
				ТипВзаимодействия,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			Если РезультатСохранения.БылиОшибкиОбработки Тогда
				РезультатОперации.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
				ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
				Возврат;
			КонецЕсли;
			
			ДанныеШироковещательныхСообщений = РезультатРазбора.ДанныеШироковещательныхСообщений;
			СохранитьДанныеРассылокСЭДОФСС(
				Организация,
				ДанныеШироковещательныхСообщений,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			
			РезультатОперации.Выполнено = Истина;
			
		КонецЕсли;
		
		ДополнительныеПараметры.ТекущаяДата = ДатаСообщений;
		
		Если ЭтоАдресВременногоХранилища(Результат.АдресПодписаногоЗапросаSOAP) Тогда
			УдалитьИзВременногоХранилища(Результат.АдресПодписаногоЗапросаSOAP);
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP) Тогда
			УдалитьИзВременногоХранилища(Результат.АдресРасшифрованногоОтветаSOAP);
		КонецЕсли;
		
	Иначе
		
		// При получении возникла ошибка.
		Если ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// Для прямого обмена выполняем дополнительную обработку результата получения.
			ОбработатьОшибкуПриПолученииМетаданныхВходящихСЭДО(Результат, РезультатОперации, ДополнительныеПараметры);
		Иначе
			РезультатОперации.ОписаниеОшибки = Результат.ОписаниеОшибки;
		КонецЕсли;
		
		Если НЕ РезультатОперации.Выполнено Тогда
			ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(РезультатОперации.ОписаниеОшибки);
		КонецЕсли;
		
		ДополнительныеПараметры.ОшибкаПриЗапросеМетаданных = Истина;
		
	КонецЕсли;
	
	МетаданныеВходящихСообщенийСЭДОФССЗаПериодЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений

&НаКлиенте
Функция ПараметрыМетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(Организация, ДатыПолученияСообщений)
	
	Результат = Новый Структура;
	
	ПустаяДата = Дата(1, 1, 1);
	РезультатПолучения = РезультатМетаданныеВходящихСообщенийСЭДОФСС();
	
	Результат.Вставить("ОповещениеОбратногоВызова",				Неопределено);
	Результат.Вставить("Результат", 							РезультатПолучения);
	Результат.Вставить("Организация", 							Организация);
	Результат.Вставить("ДатыПолученияСообщений", 				ДатыПолученияСообщений);
	Результат.Вставить("ДатаСообщений",							ПустаяДата);
	Результат.Вставить("ЗадаватьВопросОТестовомСервере",		Ложь);
	Результат.Вставить("ТипВзаимодействия", 					2);
	Результат.Вставить("ТекущаяДата", 							ПустаяДата);
	Результат.Вставить("ОтображатьСостояние", 					Ложь);
	Результат.Вставить("ОшибкаПриЗапросеМетаданных",			Ложь);
	Результат.Вставить("СвойстваОбменаПоСЭДОЧерезОператора",	Неопределено);
	Результат.Вставить("ЭтоПользовательскийЗапрос",				Ложь);
	Результат.Вставить("ТипСообщенияОтвета", 					"");
	Результат.Вставить("ПредварительноПолучитьАктуальные", 		Ложь);
	Результат.Вставить("СообщенияДоСЭДОЧерезОператораПолучены", Ложь);
	Результат.Вставить("Операция", 								"");
	Результат.Вставить("ТекстЗапроса", 							"");
	Результат.Вставить("НеСохранятьДатуЗагрузкиИдентификаторов", Ложь);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(
	ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	Организация 						= ДополнительныеПараметры.Организация;
	Результат 							= ДополнительныеПараметры.Результат;
	ДатыПолученияСообщений				= ДополнительныеПараметры.ДатыПолученияСообщений;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ЗадаватьВопросОТестовомСервере 		= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	ТекущаяДата 						= ДополнительныеПараметры.ТекущаяДата;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	ЭтоПользовательскийЗапрос = Ложь;
	Если ДополнительныеПараметры.Свойство("ЭтоПользовательскийЗапрос") Тогда
		ЭтоПользовательскийЗапрос		= ДополнительныеПараметры.ЭтоПользовательскийЗапрос;
	КонецЕсли;
	
	ОтображатьСостояние = ?(ДополнительныеПараметры.Свойство("ОтображатьСостояние"),
		ДополнительныеПараметры.ОтображатьСостояние,
		Истина);
		
	Если ДополнительныеПараметры.ПредварительноПолучитьАктуальные Тогда
		
		// Создаем копию полей.
		ДополнительныеПараметры.Вставить("ДатыПолученияСообщенийКопия",
			ДатыПолученияСообщений);
		ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызоваКопия",
			ОповещениеОбратногоВызова);
			
		// Создаем новый массив дат с пустой датой.
		ДатыПолученияСообщенийНовый = Новый Массив;
		ДатаИВремя = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре(
			Неопределено);
		ДатыПолученияСообщенийНовый.Добавить(ДатаИВремя);
		ДополнительныеПараметры.Вставить("ДатыПолученияСообщений",
			ДатыПолученияСообщенийНовый);
			
		// Новое оповещение.
		ОповещениеОбратногоВызоваНовое = Новый ОписаниеОповещения(
			"МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеПолученияАктуальных",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ДополнительныеПараметры.ОповещениеОбратногоВызова = ОповещениеОбратногоВызоваНовое;
		
		// Получаем актуальные сообщения.
		МетаданныеВходящихСообщенийСЭДОФССЗаПериодЦикл(ДополнительныеПараметры);
		Возврат;
		
	КонецЕсли;
	
	ДатаСообщения = Неопределено;
	Если ДатыПолученияСообщений.Количество() > 0 Тогда
		ДатаСообщения = ДатыПолученияСообщений[ДатыПолученияСообщений.Количество() - 1];
		Если НЕ ЗначениеЗаполнено(ДатаСообщения.Дата) Тогда
			ДатаСообщения = Неопределено;
		КонецЕсли;
	Иначе
		Если ТипЗнч(ОповещениеОбратногоВызова.ДополнительныеПараметры) = Тип("Структура") Тогда
			ОповещениеОбратногоВызова.ДополнительныеПараметры.Вставить("ТекущаяДата", ТекущаяДата);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	// Если обмен через оператора и дней немного, то запрашиваем идентификаторы по дням.
	КоличествоДатКоторыеПолучаемЗапросамиПоДням = 2;
	Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
		И ДатыПолученияСообщений.Количество() <= КоличествоДатКоторыеПолучаемЗапросамиПоДням Тогда
		РезультатПолучения = МетаданныеВходящихСообщенийСЭДОЗаПериодБезКриптографии(
			Организация, ДатыПолученияСообщений, Ложь, СвойстваОбменаПоСЭДОЧерезОператора);
		ЗаполнитьЗначенияСвойств(Результат, РезультатПолучения);
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправкаСообщения = ПараметрыОтправитьСообщениеСЭДОФСС();
	ПараметрыОтправкаСообщения.ЭтоПользовательскийЗапрос = ЭтоПользовательскийЗапрос;
	ПараметрыОтправкаСообщения.Вставить("РегистрационныйНомерФСС",	"");
	ПараметрыОтправкаСообщения.Вставить("Организация",				Организация);
	ПараметрыОтправкаСообщения.Вставить("ТипВзаимодействия", 		Неопределено);
	ПараметрыОтправкаСообщения.Вставить("СвойстваДляОбмена", 		Неопределено);
	ПараметрыОтправкаСообщения.Вставить("НастройкиЗаписиОтправки", 	Неопределено);
	ПараметрыОтправкаСообщения.Вставить("ДатыСообщений", 			ДатыПолученияСообщений);
	
	ЗаполнитьПараметрыОтправкиПоОрганизации(
		ПараметрыОтправкаСообщения,
		Организация);
	Если ПараметрыОтправкаСообщения.СодержимоеСообщения = "" Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправкаСообщения.ОписаниеОшибки =
		НСтр("ru = 'Не удалось получить список архивных сообщений.';
			|en = 'Не удалось получить список архивных сообщений.'")
		+ Символы.ПС + "%1";
		
	Операция = "GetMessage";
	ДополнительныеПараметры.Вставить("Операция", 							Операция);
	ДополнительныеПараметры.Вставить("ТекстЗапроса", 						"");
	ДополнительныеПараметры.ДатаСообщений =
		?(ТипЗнч(ДатаСообщения) = Тип("Структура"), ДатаСообщения.Дата, Неопределено);
	
	Если ОповещениеОбратногоВызова.ДополнительныеПараметры.Свойство("ТипСообщенияОтвета") Тогда
		ДополнительныеПараметры.Вставить("ТипСообщенияОтвета",
			ОповещениеОбратногоВызова.ДополнительныеПараметры.ТипСообщенияОтвета);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПараметрыОтправкаСообщения.ОповещениеОбратногоВызова = Оповещение;
	ОтправитьСообщениеСЭДОФСС(
		ПараметрыОтправкаСообщения,
		ЗадаватьВопросОТестовомСервере,
		ОтображатьСостояние,
		Ложь,
		СвойстваОбменаПоСЭДОЧерезОператора);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеЗапроса(
	Результат,
	ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	ТекстЗапроса 						= ДополнительныеПараметры.ТекстЗапроса;
	ДатыПолученияСообщений				= ДополнительныеПараметры.ДатыПолученияСообщений;
	ТекущаяДата 						= ДополнительныеПараметры.ТекущаяДата;
	ДатаСообщений						= ДополнительныеПараметры.ДатаСообщений;
	ТипВзаимодействия 					= ДополнительныеПараметры.ТипВзаимодействия;
	ЗадаватьВопросОТестовомСервере		= ДополнительныеПараметры.ЗадаватьВопросОТестовомСервере;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	ЭтоПользовательскийЗапрос			= ДополнительныеПараметры.ЭтоПользовательскийЗапрос;
	
	ДатыПолученияСообщений.Очистить();
	
	Если Результат.Выполнено Тогда
		// Запоминаем идентификатор 332 сообщения, которое в дальнейшем будет загружаться.
		ИдентификаторСообщения = Результат.ИдентификаторЗапроса;
		РезультатОперации.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			// Для операторной схемы ответное сообщение приходит с задержкой.
			РезультатОперации.Выполнено = Истина;
			Если ТипЗнч(ОповещениеОбратногоВызова.ДополнительныеПараметры) = Тип("Структура") Тогда
				ОповещениеОбратногоВызова.ДополнительныеПараметры.Вставить("ТекущаяДата", ТекущаяДата);
			КонецЕсли;
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
			Возврат;
		КонецЕсли;
		
		// Загрузка ответного сообщения 332.
		Оповещение = Новый ОписаниеОповещения(
			"МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеПолучения",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПолучитьСообщениеСЭДОФСС(Оповещение,
			Организация,
			ИдентификаторСообщения,
			Ложь);
	Иначе
		// При отправке сообщения 330 возникла ошибка.
		Если НЕ МетаданныеВходящихСообщенийСЭДОАктуальны(Организация, СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую)
			ИЛИ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую
			И НЕ ЭтоПользовательскийЗапрос Тогда
			Шаблон = НСтр("ru = 'Не удалось отправить запрос исторических сообщений СЭДО СФР.
				|%1
				|Возможно, сервер перегружен. Попробуйте повторить получение сообщений через некоторое время.';
				|en = 'Не удалось отправить запрос исторических сообщений СЭДО СФР.
				|%1
				|Возможно, сервер перегружен. Попробуйте повторить получение сообщений через некоторое время.'");
			РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон, Результат.ОписаниеОшибки);
			ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		Иначе
			РезультатОперации.ОписаниеОшибки = Результат.ОписаниеОшибки;
		КонецЕсли;
		// Отключаем сохранение даты получения списка входящих сообщений.
		ДополнительныеПараметры.ТекущаяДата = Дата(1, 1, 1);
		МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеПолучения(
	Результат,
	ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова 			= ДополнительныеПараметры.ОповещениеОбратногоВызова;
	РезультатОперации 					= ДополнительныеПараметры.Результат;
	Организация 						= ДополнительныеПараметры.Организация;
	Операция 							= ДополнительныеПараметры.Операция;
	ТекстЗапроса 						= ДополнительныеПараметры.ТекстЗапроса;
	СвойстваОбменаПоСЭДОЧерезОператора 	= ДополнительныеПараметры.СвойстваОбменаПоСЭДОЧерезОператора;
	ЭтоПользовательскийЗапрос			= ДополнительныеПараметры.ЭтоПользовательскийЗапрос;
	
	Если Результат.Выполнено Тогда
		
		// Разбор содержимого сообщения 332.
		СодержимоеСообщенияОтвета = Результат.ДанныеСообщений[0].ТекстСообщения;
		РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(СодержимоеСообщенияОтвета, Неопределено, СвойстваОбменаПоСЭДОЧерезОператора);
		
		Если НЕ РезультатРазбора.Выполнено Тогда
			
			Шаблон = НСтр("ru = 'При получении данных сообщений из СЭДО произошла ошибка:
				|%1';
				|en = 'При получении данных сообщений из СЭДО произошла ошибка:
				|%1'");
			ОписаниеОшибки = СтрШаблон(Шаблон, РезультатРазбора.ОписаниеОшибки);
			РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
					|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС'"),
				"Ошибка",
				ОписаниеОшибки,,
				Истина);
				
		Иначе
			
			ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
			РезультатОперации.ДанныеСообщений = ДанныеСообщений;
			// Сохранение данных о сообщениях в БД.
			РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
				Организация,
				ДанныеСообщений, ,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
			Если РезультатСохранения.БылиОшибкиОбработки Тогда
				РезультатОперации.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
				ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, РезультатОперации);
				Возврат;
			КонецЕсли;
			Если НЕ РезультатОперации.Свойство("ИдентификаторыСообщенийИз332") Тогда
				РезультатОперации.Вставить("ИдентификаторыСообщенийИз332", Новый Массив);
			КонецЕсли;
			Для каждого Сообщение Из ДанныеСообщений Цикл
				РезультатОперации.ИдентификаторыСообщенийИз332.Добавить(Сообщение.Идентификатор);
			КонецЦикла;
			РезультатОперации.Выполнено = Истина;
			
		КонецЕсли;
		
	Иначе
		
		// При получении возникла ошибка.
		Если НЕ МетаданныеВходящихСообщенийСЭДОАктуальны(Организация, СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую)
			И НЕ ЭтоПользовательскийЗапрос Тогда
			Шаблон = ?(СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую,
				НСтр("ru = 'Не удалось получить список входящих сообщений СЭДО СФР.
				|%1
				|Возможно, сервер перегружен. Попробуйте повторить получение сообщений через некоторое время.';
				|en = 'Не удалось получить список входящих сообщений СЭДО СФР.
				|%1
				|Возможно, сервер перегружен. Попробуйте повторить получение сообщений через некоторое время.'"),
				НСтр("ru = 'Не удалось получить список входящих сообщений СЭДО СФР.
				|%1
				|Возможно, сервер оператора перегружен. Попробуйте повторить получение сообщений через некоторое время.';
				|en = 'Не удалось получить список входящих сообщений СЭДО СФР.
				|%1
				|Возможно, сервер оператора перегружен. Попробуйте повторить получение сообщений через некоторое время.'"));
			РезультатОперации.ОписаниеОшибки = СтрШаблон(Шаблон, Результат.ОписаниеОшибки);
		Иначе
			РезультатОперации.ОписаниеОшибки = Результат.ОписаниеОшибки;
		КонецЕсли;
		// Отключаем сохранение даты получения списка входящих сообщений.
		ДополнительныеПараметры.ТекущаяДата = Дата(1, 1, 1);
		
		Если Результат.СообщенияНеНайдены Тогда
			// Ситуация возникает если сообщение 332 не успело сформироваться на стороне сервера.
			РезультатОперации.Сообщение332НеНайдено = Истина;
			РезультатОперации.Выполнено = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщенийПослеПолученияАктуальных(
		Результат, ДополнительныеПараметры) Экспорт
		
	ДополнительныеПараметры.ДатыПолученияСообщений = ДополнительныеПараметры.ДатыПолученияСообщенийКопия;
	ДополнительныеПараметры.ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызоваКопия;
	ДополнительныеПараметры.ПредварительноПолучитьАктуальные = Ложь;
	МетаданныеВходящихСообщенийСЭДОФССЗапросИсторическихСообщений(ДополнительныеПараметры);
			
КонецПроцедуры

#КонецОбласти

#Область ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФСС

&НаКлиенте
Процедура ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФСС(
		ОповещениеОбратногоВызова,
		СотрудникиОрганизаций,
		Операция,
		ОткрыватьФормуДлительнойОперации = Истина) Экспорт
		
	Организации = Новый Массив;
	Для каждого КлючЗначение Из СотрудникиОрганизаций Цикл
		Организации.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("БылиОшибки", Ложь);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("РезультатыОперации", Новый Соответствие);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СотрудникиОрганизаций", СотрудникиОрганизаций);
	ДополнительныеПараметры.Вставить("Организации", Организации);
	ДополнительныеПараметры.Вставить("ИндексТекущейОрганизации", 0);
	ДополнительныеПараметры.Вставить("Результат", Результат);
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Операция", Операция);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации", Неопределено);
	
	Если Операция = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
			ВидОперацииСЭДОФССПодписать() Тогда
		ОписаниеОперации = НСтр("ru = 'Подписка сотрудников на уведомления по ЭЛН.';
								|en = 'Подписка сотрудников на уведомления по ЭЛН.'");
	ИначеЕсли Операция = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
			ВидОперацииСЭДОФССОтписать() Тогда
		ОписаниеОперации = НСтр("ru = 'Отключение подписки сотрудников от уведомлений по ЭЛН.';
								|en = 'Отключение подписки сотрудников от уведомлений по ЭЛН.'");
	Иначе
		Шаблон = НСтр("ru = 'Изменение подписки сотрудников на уведомление по ЭЛН. Неизвестная операция %1.';
						|en = 'Изменение подписки сотрудников на уведомление по ЭЛН. Неизвестная операция %1.'");
		ВызватьИсключение СтрШаблон(Шаблон, Операция);
	КонецЕсли;
	
	// Открываем форму длительной операции.
	ПараметрыОжидания = Новый Структура();
	ПараметрыОжидания.Вставить("ТекстСообщения", ОписаниеОперации);
	Если ОткрыватьФормуДлительнойОперации Тогда
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"ОбщаяФорма.ДлительнаяОперация", ПараметрыОжидания);
	КонецЕсли;
	
	ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФССЦикл(
		ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	Организации = ДополнительныеПараметры.Организации;
	Результат = ДополнительныеПараметры.Результат;
	СотрудникиОрганизаций = ДополнительныеПараметры.СотрудникиОрганизаций;
	Операция = ДополнительныеПараметры.Операция;
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации;
	
	Если ИндексТекущейОрганизации >= Организации.Количество() Тогда
		ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФССПослеЗапроса",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	Организация = Организации[ИндексТекущейОрганизации];
	СписокСНИЛС = СотрудникиОрганизаций.Получить(Организация);
	
	ТипСобытия = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
		ТипСобытияСЭДОФССИзменениеСостоянияЭЛН();
	
	Если Операция = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
			ВидОперацииСЭДОФССПодписать() Тогда
		ПодписатьСписокСНИЛССЭДОФСС(Оповещение, Организация, СписокСНИЛС, ТипСобытия);
	ИначеЕсли Операция = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.
			ВидОперацииСЭДОФССОтписать() Тогда
		ОтписатьСписокСНИЛССЭДОФСС(Оповещение, Организация, СписокСНИЛС, ТипСобытия);
	Иначе
		Шаблон = НСтр("ru = 'Изменение подписки сотрудников на уведомление по ЭЛН. Неизвестная операция %1.';
						|en = 'Изменение подписки сотрудников на уведомление по ЭЛН. Неизвестная операция %1.'");
		ВызватьИсключение СтрШаблон(Шаблон, Операция);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФССПослеЗапроса(
		РезультатОперации,
		ДополнительныеПараметры) Экспорт
		
	ИндексТекущейОрганизации = ДополнительныеПараметры.ИндексТекущейОрганизации;
	Организации = ДополнительныеПараметры.Организации;
	Результат = ДополнительныеПараметры.Результат;
		
	Если НЕ РезультатОперации.Выполнено Тогда
		Результат.БылиОшибки = Истина;
		Результат.Ошибки.Добавить(РезультатОперации.ОписаниеОшибки);
	КонецЕсли;
	
	Организация = Организации[ИндексТекущейОрганизации];
		
	Результат.РезультатыОперации.Вставить(Организация, РезультатОперации);
	ДополнительныеПараметры.ИндексТекущейОрганизации = ИндексТекущейОрганизации + 1;
	
	ПодписатьОтписатьСотрудниковОрганизацийНаУведомленияЭЛНСЭДОФССЦикл(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область ПодписатьСписокСНИЛССЭДОФСС

&НаКлиенте
Процедура ПодписатьСписокСНИЛССЭДОФСС(ОповещениеОбратногоВызова,
		Организация,
		СписокСНИЛС,
		ТипСобытия) Экспорт
		
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ПодписатьСписокСНИЛССЭДОФСС",
		"СписокСНИЛС",
		СписокСНИЛС,
		Тип("Массив"));
		
	РегистрационныйНомерФСС = РегистрационныйНомерФССОрганизации(Организация);
	
	ПараметрыСообщения = ПараметрыОтправитьСообщениеСЭДОФСС();
	ПараметрыСообщения.ТипСообщения = 3;
	ПараметрыСообщения.СодержимоеСообщения =
		СодержимоеСообщенияПодпискиРаботниковНаУведомлениеСтрахователяОбИзмененииСтатусаЭЛНВМО(
			РегистрационныйНомерФСС,
			СписокСНИЛС,
			ТипСобытия);
	ПараметрыСообщения.Организация = Организация;
	ПараметрыСообщения.ОповещениеОбратногоВызова = ОповещениеОбратногоВызова;
	ПараметрыСообщения.ОписаниеОшибки =
		НСтр("ru='Не удалось подписать организацию на уведомления ФСС об изменении состояния ЭЛН для "
		+ ПросклонятьКоличествоЭлементовВСписке(СписокСНИЛС, "сотрудник") + ".
		|%1'");
		
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыСообщения", ПараметрыСообщения);
	
	СтраховательПодписан = СтраховательПодписанНаУведомленияПоЭЛН(Организация);
	Если НЕ СтраховательПодписан Тогда
		Оповещение = Новый ОписаниеОповещения(
			"ПодписатьСписокСНИЛССЭДОФССПослеПодпискиСтрахователя",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПодписатьСтрахователяНаУведомленияПоЭЛН(Оповещение, Организация);
		Возврат;
	КонецЕсли;
	
	РезультатПодписки = РезультатОтправитьСообщениеСЭДОФСС();
	РезультатПодписки.Выполнено = Истина;
	ПодписатьСписокСНИЛССЭДОФССПослеПодпискиСтрахователя(РезультатПодписки, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСписокСНИЛССЭДОФССПослеПодпискиСтрахователя(РезультатПодпискиСтрахователя, ДополнительныеПараметры) Экспорт
	
	ПараметрыСообщения = ДополнительныеПараметры.ПараметрыСообщения;
	ОповещениеОбратногоВызова = ПараметрыСообщения.ОповещениеОбратногоВызова;
	Организация = ПараметрыСообщения.Организация;
	
	Если НЕ РезультатПодпискиСтрахователя.Выполнено Тогда
		Результат = РезультатОтправитьСообщениеСЭДОФСС();
		Результат.ОписаниеОшибки = РезультатПодпискиСтрахователя.ОписаниеОшибки;
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	ОтправитьСообщениеСЭДОФСС(ПараметрыСообщения);
	
КонецПроцедуры

#КонецОбласти

