&НаСервереБезКонтекста
Функция ОтветыНаОбращениеСФРКСтрахователю(СсылкаНаОбращение)
	
	Возврат ЭлектронныйДокументооборотСФСС.ОтветыНаОбращениеСФРКСтрахователю(СсылкаНаОбращение);
	
КонецФункции

&НаСервереБезКонтекста
Функция СфомироватьОтветНаОбращениеСФРНаСервере(Ссылка)
	
	Возврат ЭлектронныйДокументооборотСФСС.СфомироватьОтветНаОбращениеСФРКСтрахователю(Ссылка);
	
КонецФункции

&НаКлиенте
Асинх Процедура СфомироватьОтветНаОбращениеСФРКСтрахователю(Ссылка) Экспорт
	
	Ответы = ОтветыНаОбращениеСФРКСтрахователю(Ссылка);
	
	// ищем существующий ответ
	Если Ответы.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'На данное обращение уже создан ответ. Вы уверены, что хотите создать новый?';
							|en = 'На данное обращение уже создан ответ. Вы уверены, что хотите создать новый?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СформированныйОтвет = СфомироватьОтветНаОбращениеСФРНаСервере(Ссылка);
	
	ПустаяСсылкаНаОтвет = ПредопределенноеЗначение("Документ.ОтветСтрахователяНаОбращениеСФР.ПустаяСсылка");
	Если СформированныйОтвет = ПустаяСсылкаНаОтвет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", СформированныйОтвет);
	ОткрытьФорму(
		"Документ.ОтветСтрахователяНаОбращениеСФР.Форма.ФормаДокумента",
		ПараметрыФормы);
	
КонецПроцедуры
	
