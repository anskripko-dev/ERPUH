	ПодписанныйПакетДляАвторизацииТребуется                            = ДополнительныеПараметры.ПодписанныйПакетДляАвторизацииТребуется;
	
	Оповещение = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервереПослеФормированияПодписанногоПакетаДляПорталаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	СформироватьПодписанныйПакетДляПорталаФСРАР(
		МестоХраненияКлюча,
		УчетнаяЗапись,
		ПодписываемыеДанные,
		ПараметрыФормированияПакета.СертификатАбонента,
		Оповещение,
		Крипт,
		СлучайныйКлюч,
		ЗначениеCAPTCHA);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервереПослеФормированияПодписанногоПакетаДляПорталаЗавершение(ПодписанныйПакетДляАвторизации, ДополнительныеПараметры) Экспорт
	
	Форма                                                              = ДополнительныеПараметры.Форма;
	ОтправкаСсылка                                                     = ДополнительныеПараметры.ОтправкаСсылка;
	ВыполняемоеОповещение                                              = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал   = ДополнительныеПараметры.ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал;
	МестоХраненияКлюча												   = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ФормаДлительнаяОперация                                            = ДополнительныеПараметры.ФормаДлительнаяОперация;
	СертификатыИПараметрыОбмена                                        = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	СхемаСдачиОтчетности                                               = ДополнительныеПараметры.СхемаСдачиОтчетности;
	Крипт                                                              = ДополнительныеПараметры.Крипт;
	ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64   = ДополнительныеПараметры.ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64;
	ПараметрыСоединения                                                = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                                                  = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыФормированияПакета                                        = ДополнительныеПараметры.ПараметрыФормированияПакета;
	УчетнаяЗапись                                                      = ДополнительныеПараметры.УчетнаяЗапись;
	ЭтоРегламентированныйОтчет                                         = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале = ДополнительныеПараметры.ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале;
	АвторизацияПроизведена                                             = ДополнительныеПараметры.АвторизацияПроизведена;
	АвторизацияПодготовлена                                            = ДополнительныеПараметры.АвторизацияПодготовлена;
	ЭтоВызовИзСписка                                                   = ДополнительныеПараметры.ЭтоВызовИзСписка;
	ПодписанныйПакетДляАвторизацииТребуется                            = ДополнительныеПараметры.ПодписанныйПакетДляАвторизацииТребуется;
	
	Если ПодписанныйПакетДляАвторизацииТребуется И НЕ ЗначениеЗаполнено(ПодписанныйПакетДляАвторизации) Тогда
		АвторизацияПодготовлена = Ложь;
	КонецЕсли;
	
	ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПодготовкиАвторизации(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		ПодписанныйПакетДляАвторизации,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		АвторизацияПодготовлена,
		ЭтоВызовИзСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПодготовкиАвторизации(
	Форма,
	ОтправкаСсылка,
	ВыполняемоеОповещение,
	ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
	МестоХраненияКлюча,
	ФормаДлительнаяОперация,
	СертификатыИПараметрыОбмена,
	СхемаСдачиОтчетности,
	ПодписанныйПакетДляАвторизации,
	Крипт,
	ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ПараметрыФормированияПакета,
	УчетнаяЗапись,
	ЭтоРегламентированныйОтчет,
	ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
	АвторизацияПроизведена,
	АвторизацияПодготовлена,
	ЭтоВызовИзСписка)
	
	Если АвторизацияПодготовлена Тогда
		
		ПерваяПопыткаАвторизации = Истина;
		ОперацияУспешна = Ложь;
		ПараметрыСоединения.ПовторятьЗапросПароля = Истина;
		
		ОбновитьРезультатКонкретнойОтправкиФСРАРВводПароля(
			ОперацияУспешна,
			ПерваяПопыткаАвторизации,
			Форма,
			ОтправкаСсылка,
			ВыполняемоеОповещение,
			ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
			МестоХраненияКлюча,
			ФормаДлительнаяОперация,
			СертификатыИПараметрыОбмена,
			СхемаСдачиОтчетности,
			Крипт,
			ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ПараметрыФормированияПакета,
			УчетнаяЗапись,
			ЭтоРегламентированныйОтчет,
			ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
			ПодписанныйПакетДляАвторизации,
			АвторизацияПроизведена,
			ЭтоВызовИзСписка);
		Возврат;
		
	КонецЕсли;
	
	ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПослеВводаПароля(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		ЭтоВызовИзСписка);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРВводПароля(
	ОперацияУспешна,
	ПерваяПопыткаАвторизации,
	Форма,
	ОтправкаСсылка,
	ВыполняемоеОповещение,
	ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
	МестоХраненияКлюча,
	ФормаДлительнаяОперация,
	СертификатыИПараметрыОбмена,
	СхемаСдачиОтчетности,
	Крипт,
	ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ПараметрыФормированияПакета,
	УчетнаяЗапись,
	ЭтоРегламентированныйОтчет,
	ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
	ПодписанныйПакетДляАвторизации,
	АвторизацияПроизведена,
	ЭтоВызовИзСписка);
	
	// при успешном обращении на сервер ФСРАР отправка обновится в ИБ
	ОперацияУспешна = ОбновитьРезультатКонкретнойОтправкиФСРАРСНаСервере(
		ОтправкаСсылка,
		Истина,
		ПодписанныйПакетДляАвторизации,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ЭтоВызовИзСписка);
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);

	ПерваяПопыткаАвторизации = Ложь;
	
	Если НЕ ОперацияУспешна И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
		
		ОбновитьРезультатКонкретнойОтправкиФСРАРВводПароля(
			ОперацияУспешна,
			ПерваяПопыткаАвторизации,
			Форма,
			ОтправкаСсылка,
			ВыполняемоеОповещение,
			ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
			МестоХраненияКлюча,
			ФормаДлительнаяОперация,
			СертификатыИПараметрыОбмена,
			СхемаСдачиОтчетности,
			Крипт,
			ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ПараметрыФормированияПакета,
			УчетнаяЗапись,
			ЭтоРегламентированныйОтчет,
			ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
			ПодписанныйПакетДляАвторизации,
			АвторизацияПроизведена,
			ЭтоВызовИзСписка);
		Возврат;
		
	КонецЕсли;
	
	ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПослеВводаПароля(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		ЭтоВызовИзСписка);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПослеВводаПароля(
		Форма,
		ОтправкаСсылка,
		ВыполняемоеОповещение,
		ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
		МестоХраненияКлюча,
		ФормаДлительнаяОперация,
		СертификатыИПараметрыОбмена,
		СхемаСдачиОтчетности,
		Крипт,
		ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
		ПараметрыСоединения,
		ПараметрыОтправки,
		ПараметрыФормированияПакета,
		УчетнаяЗапись,
		ЭтоРегламентированныйОтчет,
		ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
		АвторизацияПроизведена,
		ЭтоВызовИзСписка)

	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма",                                                              Форма);
		ДополнительныеПараметры.Вставить("ОтправкаСсылка",                                                     ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                                              ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал",   ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",                                            ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",                                        СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",                                               СхемаСдачиОтчетности);
		ДополнительныеПараметры.Вставить("Крипт",                                                              Крипт);
		ДополнительныеПараметры.Вставить("ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64",   ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                                                ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                                                  ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",                                        ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись",                                                      УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",                                         ЭтоРегламентированныйОтчет);
		ДополнительныеПараметры.Вставить("ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале", ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале);
		ДополнительныеПараметры.Вставить("АвторизацияПроизведена",                                             АвторизацияПроизведена);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",                                                   ЭтоВызовИзСписка);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПослеВводаПароляЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекстСообщения = НСтр("ru = 'Не удалось обратиться к серверу Росалкогольтабакконтроля';
								|en = 'Не удалось обратиться к серверу Росалкогольтабакконтроля'");
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			ТекстСообщения,
			ОписаниеОповещения);
			
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСРАРПослеПослеВводаПароляЗавершение(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	Форма                                                              = ДополнительныеПараметры.Форма;
	ОтправкаСсылка                                                     = ДополнительныеПараметры.ОтправкаСсылка;
	ВыполняемоеОповещение                                              = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал   = ДополнительныеПараметры.ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал;
	МестоХраненияКлюча												   = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ФормаДлительнаяОперация                                            = ДополнительныеПараметры.ФормаДлительнаяОперация;
	СертификатыИПараметрыОбмена                                        = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	СхемаСдачиОтчетности                                               = ДополнительныеПараметры.СхемаСдачиОтчетности;
	Крипт                                                              = ДополнительныеПараметры.Крипт;
	ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64   = ДополнительныеПараметры.ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64;
	ПараметрыСоединения                                                = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                                                  = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыФормированияПакета                                        = ДополнительныеПараметры.ПараметрыФормированияПакета;
	УчетнаяЗапись                                                      = ДополнительныеПараметры.УчетнаяЗапись;
	ЭтоРегламентированныйОтчет                                         = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале = ДополнительныеПараметры.ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале;
	АвторизацияПроизведена                                             = ДополнительныеПараметры.АвторизацияПроизведена;
	ЭтоВызовИзСписка                                                   = ДополнительныеПараметры.ЭтоВызовИзСписка;
	
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// Рекурсивный вызов по условию (замена цикла)	
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ОбновитьРезультатКонкретнойОтправкиФСРАРПодписаниеНаРегиональномСервере(
			Форма,
			ОтправкаСсылка,
			ВыполняемоеОповещение,
			ПолученыРезультатыРегиональногоПередОтправкойНаФедеральныйПортал,
			МестоХраненияКлюча,
			ФормаДлительнаяОперация,
			СертификатыИПараметрыОбмена,
			СхемаСдачиОтчетности,
			Крипт,
			ПодписанныйРегиональнымДляОтправкиНаФедеральныйСерверПакетBase64,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ПараметрыФормированияПакета,
			УчетнаяЗапись,
			ЭтоРегламентированныйОтчет,
			ПолучениеРезультатовОтправкиПослеРегиональногоНаФедеральномПортале,
			АвторизацияПроизведена,
			ЭтоВызовИзСписка);
			
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	КонецЕсли;
																	
КонецПроцедуры
// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ОткрытьПротоколОтправкиФСРАР(Форма) Экспорт
	
	ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСРАР(ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФСРАР(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		ФедеральныйПортал,
		КодРегиона,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ПолучитьИнформациюОРегионе = Ложь,
		ОтправкаСсылка = Неопределено,
		ОтчетСсылка = Неопределено,
		ОпределитьНастроенностьОбменаВУниверсальномФормате = Ложь)
	
	РезультатВыполнения = Новый Структура();
	РезультатВыполнения.Вставить("ПараметрыФормированияПакета",        Неопределено);
	РезультатВыполнения.Вставить("ИнформацияОРегионе",                 Неопределено);
	РезультатВыполнения.Вставить("СхемаСдачиОтчетности",               Неопределено);
	РезультатВыполнения.Вставить("ОрганизацияИзОтправки",              Неопределено);
	РезультатВыполнения.Вставить("СвойстваОтправки",                   Неопределено);
	РезультатВыполнения.Вставить("Крипт",                              Неопределено);
	РезультатВыполнения.Вставить("НастроенОбменВУниверсальномФормате", Неопределено);
	РезультатВыполнения.Вставить("ПравоИзмененияУчетнойЗаписи",        Неопределено);
	РезультатВыполнения.Вставить("ЭтоРегламентированныйОтчет",         Неопределено);
	
	СвойстваОбмена = СвойстваОбменаОрганизацииНаСервере(
		ОрганизацияСсылка,
		ФедеральныйПортал = Неопределено,
		ОпределитьНастроенностьОбменаВУниверсальномФормате,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ПолучитьИнформациюОРегионе,
		ОтправкаСсылка,
		ОтчетСсылка);
		
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СвойстваОбмена);
	Если СвойстваОбмена.ОтправкаЧерезФедеральныйПортал <> Неопределено Тогда
		ФедеральныйПортал = СвойстваОбмена.ОтправкаЧерезФедеральныйПортал;
		ВыполняемоеОповещение.ДополнительныеПараметры.Вставить("ФедеральныйПортал", ФедеральныйПортал);
	КонецЕсли;
	
	РезультатВыполнения.ИнформацияОРегионе                 = СвойстваОбмена.ИнформацияОРегионе;
	РезультатВыполнения.ОрганизацияИзОтправки              = СвойстваОбмена.ОрганизацияИзОтправки;
	РезультатВыполнения.СвойстваОтправки                   = СвойстваОбмена.СвойстваОтправки;
	РезультатВыполнения.НастроенОбменВУниверсальномФормате = СвойстваОбмена.НастроенОбменВУниверсальномФормате;
	РезультатВыполнения.ПравоИзмененияУчетнойЗаписи        = СвойстваОбмена.ПравоИзмененияУчетнойЗаписи;
	РезультатВыполнения.ЭтоРегламентированныйОтчет         = СвойстваОбмена.ЭтоРегламентированныйОтчет;

	РезультатВыполнения.ПараметрыФормированияПакета = Новый Структура();
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИспользоватьОбмен",         Ложь);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("СертификатАбонента",        Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("СертификатСубъектаРФ",      Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("СертификатФСРАР",           Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("КодРегиона",                "");
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИспользоватьАвтонастройку", Ложь);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ПарольПорталаСубъектаРФ",   "");
	
	Если СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьОбмен = СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен;
		РезультатВыполнения.ПараметрыФормированияПакета.КодРегиона = ?(ЗначениеЗаполнено(КодРегиона), КодРегиона, СвойстваОбмена.НастройкиОбмена.КодРегиона);
		РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьАвтонастройку = СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку;
		РезультатВыполнения.ПараметрыФормированияПакета.ПарольПорталаСубъектаРФ = СвойстваОбмена.НастройкиОбмена.ПарольПорталаСубъектаРФ;
	КонецЕсли;
	
	РезультатВыполнения.СхемаСдачиОтчетности = СхемаСдачиОтчетностиФСРАР(
		ФедеральныйПортал,
		СвойстваОбмена.ИнформацияОРегионе.ТипПортала,
		РезультатВыполнения.ПараметрыФормированияПакета.КодРегиона);
	
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток);
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатСубъектаРФ = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатСубъектаРФОтпечаток);
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатФСРАР = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатФСРАРОтпечаток);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ПолучитьСвойстваОблачногоСертификата(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток, "MY");
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатСубъектаРФ = ПолучитьСвойстваОблачногоСертификата(СвойстваОбмена.НастройкиОбмена.СертификатСубъектаРФОтпечаток);
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатФСРАР = ПолучитьСвойстваОблачногоСертификата(СвойстваОбмена.НастройкиОбмена.СертификатФСРАРОтпечаток);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, РезультатВыполнения.ПараметрыФормированияПакета.СертификатСубъектаРФ);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, РезультатВыполнения.ПараметрыФормированияПакета.СертификатФСРАР);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		
	Иначе
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("СвойстваОбмена",       СвойстваОбмена);
		ДополнительныеПараметры.Вставить("РезультатВыполнения",  РезультатВыполнения);
		
		Оповещение = Новый ОписаниеОповещения(
			"СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаАбонентаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(
			Оповещение,
			СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток,
			"MY",
			,
			Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаАбонентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СвойстваОбмена = ДополнительныеПараметры.СвойстваОбмена;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, СвойстваОбмена, РезультатВыполнения", ВыполняемоеОповещение, СвойстваОбмена, РезультатВыполнения);
	Оповещение = Новый ОписаниеОповещения("СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаСубъектаРФЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СвойстваОбмена.НастройкиОбмена.СертификатСубъектаРФОтпечаток, "AddressBook", , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаСубъектаРФЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СвойстваОбмена = ДополнительныеПараметры.СвойстваОбмена;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатСубъектаРФ = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, РезультатВыполнения", ВыполняемоеОповещение, РезультатВыполнения);
	Оповещение = Новый ОписаниеОповещения("СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаФСРАРЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СвойстваОбмена.НастройкиОбмена.СертификатФСРАРОтпечаток, "AddressBook", , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФСРАРПослеПолученияСвойствСертификатаФСРАРЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатФСРАР = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СертификатыГодятсяДляПодписанияОтчетностиФСРАР(Сертификаты)
	
	ТекДата = ТекущаяДатаНаСервере();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		Серт	= Сертификат.Значение;
		Предст	= Сертификат.Представление;
		Если Серт = Неопределено Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в Росалкогольтабакконтроль!';
																														|en = '%1: сертификат не выбран в настройках сдачи отчетности в Росалкогольтабакконтроль!'"), Предст));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < Серт.ДействителенС Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: период действия сертификата еще не наступил (%2)!';
																														|en = '%1: период действия сертификата еще не наступил (%2)!'"), Предст, Строка(Серт.ДействителенС)));
		КонецЕсли;
		
		Если ТекДата > Серт.ДействителенПо Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: период действия сертификата истек (%2)!';
																														|en = '%1: период действия сертификата истек (%2)!'"), Предст, Строка(Серт.ДействителенПо)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАР(
		Форма,
		ВыполняемоеОповещение,
		ФедеральныйПортал = Ложь,
		ТекстФайлаВыгрузки = Неопределено,
		ИмяФайлаВыгрузки = Неопределено,
		КодРегионаВФормеПриОтправке = Неопределено,
		СертификатыИПараметрыОбмена = Неопределено,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияСсылка = Неопределено,
		Знач АдресГотовыхДанных = Неопределено,
		Знач ИмяФайлаГотовыхДанных = Неопределено) Экспорт
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	Если ОтчетСсылка = Неопределено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Если ТекстФайлаВыгрузки = Неопределено И ИмяФайлаВыгрузки = Неопределено Тогда
		РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФСРАР(
			ОтчетСсылка,
			Форма,
			ЭтоОтправкаИзФормыОтчетность,
			АдресГотовыхДанных,
			ИмяФайлаГотовыхДанных);
		
		Если РезультатВыгрузки = Неопределено Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Не удалось выгрузить отчет.';
					|en = 'Не удалось выгрузить отчет.'"));
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
		
		ТекстФайлаВыгрузки = РезультатВыгрузки.ТекстФайлаВыгрузки;
		ИмяФайлаВыгрузки   = РезультатВыгрузки.ИмяФайлаВыгрузки;
	КонецЕсли;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияСсылка = ДокументооборотСФСРАРКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи              = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	УчетнаяЗапись                       = РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор                       = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",               ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Идентификатор",                       Идентификатор);
	ДополнительныеПараметры.Вставить("КодРегионаВФормеПриОтправке",         КодРегионаВФормеПриОтправке);
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка",                   ОрганизацияСсылка);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет",                 ТипЗнчСсылкаНаОтчет);
	ДополнительныеПараметры.Вставить("ФедеральныйПортал",                   ФедеральныйПортал);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность",        ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки",        			ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки",        			ИмяФайлаВыгрузки);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Если АдресГотовыхДанных <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("АдресГотовыхДанных", 				АдресГотовыхДанных);
		ДополнительныеПараметры.Вставить("ИмяФайлаГотовыхДанных", 			ИмяФайлаГотовыхДанных);
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеИнициализации", ЭтотОбъект, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеИнициализации(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение       = ДополнительныеПараметры.ВыполняемоеОповещение;
	КодРегионаВФормеПриОтправке = ДополнительныеПараметры.КодРегионаВФормеПриОтправке;
	ОрганизацияСсылка           = ДополнительныеПараметры.ОрганизацияСсылка;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал           = ДополнительныеПараметры.ФедеральныйПортал;
	
	Если НЕ Результат Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	Иначе
		ВызовИзОтправки = (КодРегионаВФормеПриОтправке <> Неопределено);
		
		ДополнительныеПараметры.Вставить("ВызовИзОтправки", ВызовИзОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"ВыгрузитьПакетДляОтправкиВФСРАРПослеПолученияСертификатовИПараметровОбмена",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		СертификатыИПараметрыОбменаОрганизацииДляФСРАР(
			Оповещение,
			ОрганизацияСсылка,
			ФедеральныйПортал,
			Неопределено,
			Ложь,
			НЕ ФедеральныйПортал И ВызовИзОтправки,
			,
			,
			НЕ ВызовИзОтправки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеПолученияСертификатовИПараметровОбмена(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	ВызовИзОтправки = ДополнительныеПараметры.ВызовИзОтправки;
	ОтчетСсылка 	= ДополнительныеПараметры.ОтчетСсылка;
	
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВФСРАРПослеНастройкиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если НЕ ВызовИзОтправки 
		И СертификатыИПараметрыОбмена.НастроенОбменВУниверсальномФормате 
		И СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьАвтонастройку 
		И СертификатыИПараметрыОбмена.ПравоИзмененияУчетнойЗаписи Тогда
		
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка,ОписаниеОповещения);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВызовИзОтправки                     = ДополнительныеПараметры.ВызовИзОтправки;
	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	Идентификатор                       = ДополнительныеПараметры.Идентификатор;
	КодРегионаВФормеПриОтправке         = ДополнительныеПараметры.КодРегионаВФормеПриОтправке;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ТипЗнчСсылкаНаОтчет                 = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	ФедеральныйПортал                   = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                               = ДополнительныеПараметры.Форма;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТекстФайлаВыгрузки        			= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки        			= ДополнительныеПараметры.ИмяФайлаВыгрузки;
	
	Если СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента = Неопределено ИЛИ
		СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатСубъектаРФ = Неопределено ИЛИ 
		СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатФСРАР = Неопределено Тогда
		
		Ошибка = НСтр("ru = 'Использование документооборота с Росалкогольтабакконтролем не включено для организации!';
						|en = 'Использование документооборота с Росалкогольтабакконтролем не включено для организации!'");
		
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// запрашиваем параметры формирования пакета и параметры обмена при вызове из отправки
	Если НЕ СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		
		Ошибка = НСтр("ru = 'Использование документооборота с Росалкогольтабакконтролем не включено для организации!';
						|en = 'Использование документооборота с Росалкогольтабакконтролем не включено для организации!'");
		
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ФедеральныйПортал И ВызовИзОтправки Тогда
		
		Если НЕ ЗначениеЗаполнено(СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.КодРегиона) Тогда
			
			Ошибка = НСтр("ru = 'В параметрах отправки отчетности в Росалкогольтабакконтроль не задан код региона';
							|en = 'В параметрах отправки отчетности в Росалкогольтабакконтроль не задан код региона'");
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
			Иначе
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
				Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если СертификатыИПараметрыОбмена.СхемаСдачиОтчетности <> ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ОбщийРегиональныйИФедеральныйСервер")
			И СертификатыИПараметрыОбмена.СхемаСдачиОтчетности <> ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ТиповойРегиональныйИФедеральныйСерверы")
			И СертификатыИПараметрыОбмена.СхемаСдачиОтчетности <> ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.МосковскийРегиональныйИФедеральныйСерверы") Тогда
			
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
				Ошибка = НСтр("ru = 'Программа не поддерживает автоматическую отправку отчета в вашем регионе.';
								|en = 'Программа не поддерживает автоматическую отправку отчета в вашем регионе.'");
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
			Иначе
				ОткрытьФорму(ПутьКОбъекту + ".Форма.ОтправкаВручнуюВФСРАР",,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодРегионаВФормеПриОтправке) И КодРегионаВФормеПриОтправке <> СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.КодРегиона Тогда
			
			Ошибка = НСтр("ru = 'Код региона в отчете отличается от кода региона в параметрах отправки отчетности в Росалкогольтабакконтроль';
							|en = 'Код региона в отчете отличается от кода региона в параметрах отправки отчетности в Росалкогольтабакконтроль'");
			Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
				ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
			Иначе
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
				Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СертификатАбонента   = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента;
	СертификатСубъектаРФ = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатСубъектаРФ;
	СертификатФСРАР      = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатФСРАР;
	
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатАбонента);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСубъектаРФ);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатФСРАР);
	
	// В том числе, портал ФСРАР принимает сертификаты физических лиц без ОГРНИП в качестве сертификатов ИП по ИНН
	ЭтоФизическоеЛицо = (КриптографияЭДКОКлиентСервер.ТипСубъектаСертификата(
		СертификатАбонента.Владелец, ДополнительныеПараметры.ОрганизацияСсылка) = "ФЛ");
	ЭтоВыгрузкаВXML = ЭтоФизическоеЛицо И НЕ ВызовИзОтправки
		И НЕ ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры);
	
	//проверяем сертификаты
	Если НЕ ЭтоВыгрузкаВXML Тогда
		СертификатыОбмена = Новый СписокЗначений();
		СертификатыОбмена.Добавить(СертификатАбонента, НСтр("ru = 'Сертификат абонента';
															|en = 'Сертификат абонента'"));
		Если НЕ ЭтоФизическоеЛицо Тогда
			Если НЕ ФедеральныйПортал Тогда
				СертификатыОбмена.Добавить(СертификатСубъектаРФ, НСтр("ru = 'Сертификат субъекта РФ';
																		|en = 'Сертификат субъекта РФ'"));
			КонецЕсли;
			СертификатыОбмена.Добавить(СертификатФСРАР, НСтр("ru = 'Сертификат ФСРАР';
															|en = 'Сертификат ФСРАР'"));
		КонецЕсли;
		
		Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСРАР(СертификатыОбмена) Тогда
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки)
			И ДополнительныеПараметры.Свойство("АдресГотовыхДанных") И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
		
		// для среднего размера деклараций в хранилище, если передан адрес, содержится текст, а не двоичные данные
		Если НЕ ЭтоКрупнаяДекларация Тогда
			
			Если ДополнительныеПараметры.Свойство("АдресГотовыхДанных") И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено Тогда
				УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресГотовыхДанных);
			КонецЕсли;
			
			//Текст > Двоичные Данные > Подписывание > Кодирование в Base64 > Упаковка в zip > Шифрование 
			ПолноеИмяФайлаНаСервере = "";
			Адрес = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, Форма.УникальныйИдентификатор, ПолноеИмяФайлаНаСервере, Истина, Ложь);
			ТекстФайлаВыгрузки = "";
			ДополнительныеПараметры.Вставить("АдресГотовыхДанных", Адрес);
			ДополнительныеПараметры.Вставить("ПолноеИмяФайлаНаСервере", ПолноеИмяФайлаНаСервере);
			
		КонецЕсли;
	
		ДополнительныеПараметры.Вставить("ВременныйКаталог", "");
		ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
	КонецЕсли;
	
	Если ЭтоВыгрузкаВXML Тогда
		ДополнительныеПараметры.Вставить("МестоХраненияКлюча", МестоХраненияКлюча);
		ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", ТекстФайлаВыгрузки);
		
		СсылкаНаМашиночитаемуюДоверенность = Новый ФорматированнаяСтрока(
			НСтр("ru = 'машиночитаемая доверенность (единый формат)';
				|en = 'машиночитаемая доверенность (единый формат)'"),,,,
			"https://fsrar.gov.ru/egais/mchd");
		СсылкаНаИнструкцию = Новый ФорматированнаяСтрока(НСтр("ru = 'ЕГАИС УТМ';
																|en = 'ЕГАИС УТМ'"),,,, "https://its.1c.ru/db/egais");
		ТекстСообщения = Новый ФорматированнаяСтрока(
			НСтр("ru = 'В случае использования сертификата физического лица выгрузка для портала ФСРАР не используется. Алкогольные декларации подаются только через ЕГАИС в формате выгрузки с расширением "".XML"".';
				|en = 'В случае использования сертификата физического лица выгрузка для портала ФСРАР не используется. Алкогольные декларации подаются только через ЕГАИС в формате выгрузки с расширением "".XML"".'") + "
					   |
					   |" + НСтр("ru = 'В';
								|en = 'В'") + " ",
			СсылкаНаИнструкцию,
			" " + НСтр("ru = 'должна быть загружена';
						|en = 'должна быть загружена'") + " ",
			СсылкаНаМашиночитаемуюДоверенность,
			" " + НСтр("ru = 'на представителя с сертификатом физического лица.';
						|en = 'на представителя с сертификатом физического лица.'"));
		КнопкиВопроса = Новый СписокЗначений;
		КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Выгрузить в формате XML';
															|en = 'Выгрузить в формате XML'"));
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена);
		Оповещение = Новый ОписаниеОповещения(
			"ВыгрузитьПакетДляОтправкиВФСРАРПослеВопросаОФорматеXML",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПоказатьВопрос(
			Оповещение,
			ТекстСообщения,
			КнопкиВопроса,,
			КодВозвратаДиалога.ОК);
		Возврат;
	КонецЕсли;
	
	Если ЭтоФизическоеЛицо Тогда
		ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки)
			И ДополнительныеПараметры.Свойство("АдресГотовыхДанных")
			И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("ФедеральныйПортал", ФедеральныйПортал);
		НастройкиОтправки.Вставить("КодРегиона", 		КодРегионаВФормеПриОтправке);
		
		ОтправитьВЕГАИС(
			ВыполняемоеОповещение,
			ОтчетСсылка,
			ДополнительныеПараметры.ОрганизацияСсылка,
			ИмяФайлаВыгрузки,
			?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоКрупнаяДекларация, ДополнительныеПараметры.АдресГотовыхДанных,
				Неопределено),
			?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоКрупнаяДекларация, "", ТекстФайлаВыгрузки),
			НастройкиОтправки);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("СертификатАбонента", СертификатАбонента);
	ДополнительныеПараметры.Вставить("СертификатСубъектаРФ", СертификатСубъектаРФ);
	ДополнительныеПараметры.Вставить("СертификатФСРАР", СертификатФСРАР);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("ФедеральныйПортал", ФедеральныйПортал);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);

	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено", Истина));		
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеПолученияВременногоКаталогаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеВопросаОФорматеXML(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ДополнительныеПараметры.ТекстФайлаВыгрузки)
			И ДополнительныеПараметры.Свойство("АдресГотовыхДанных")
			И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
		
		Если ЭтоЛокальнаяПодпись(ДополнительныеПараметры.МестоХраненияКлюча) И НЕ ЭтоКрупнаяДекларация Тогда
			ДанныеФайлаВыгрузки = ПолучитьДвоичныеДанныеИзСтроки(ДополнительныеПараметры.ТекстФайлаВыгрузки, "windows-1251");
			АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(ДанныеФайлаВыгрузки, УникальныйИдентификатор);
		Иначе
			АдресФайлаВыгрузки = ДополнительныеПараметры.АдресГотовыхДанных;
		КонецЕсли;
		
		СохраняемыйФайл = Новый Структура("Имя, Адрес", ДополнительныеПараметры.ИмяФайлаВыгрузки, АдресФайлаВыгрузки);
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(СохраняемыйФайл);
	КонецЕсли;
	
	Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена",
		Неопределено, ДополнительныеПараметры.СертификатыИПараметрыОбмена);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеПолученияВременногоКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатСубъектаРФ = ДополнительныеПараметры.СертификатСубъектаРФ;
	СертификатФСРАР = ДополнительныеПараметры.СертификатФСРАР;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал = ДополнительныеПараметры.ФедеральныйПортал;
	
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ПолноеИмяФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
	
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ПолноеИмяФайлаВыгрузки);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки)
		И ДополнительныеПараметры.Свойство("АдресГотовыхДанных") И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
	
	Если ЭтоКрупнаяДекларация Тогда
		
		РезультатВыполнения = Новый Структура("Выполнено", Истина);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстФайлаВыгрузки, ПолноеИмяФайлаВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатСубъектаРФ = ДополнительныеПараметры.СертификатСубъектаРФ;
	СертификатФСРАР = ДополнительныеПараметры.СертификатФСРАР;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал = ДополнительныеПараметры.ФедеральныйПортал;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// подписываем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание файла выгрузки ...';
													|en = 'Подписание файла выгрузки ...'")); // ФСРАР
	
	Если СертификатАбонента = Неопределено Тогда
		Ошибка = НСтр("ru = 'Не удалось определить сертификат.';
						|en = 'Не удалось определить сертификат.'");
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеПодписанияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки)
		И ДополнительныеПараметры.Свойство("АдресГотовыхДанных") И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайлаВыгрузки);
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ПакетДляОтправкиВФСРАРЗавершение", ОрганизацияСсылка); 
		ПараметрыОперации = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
	КонецЕсли;
	
	КриптографияЭДКОКлиент.ПодписатьPKCS7(
		Оповещение,
		СертификатАбонента,
		?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоКрупнаяДекларация, ДополнительныеПараметры.АдресГотовыхДанных, ПолноеИмяФайлаВыгрузки),
		Истина,
		?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоКрупнаяДекларация, Неопределено, ПолноеИмяФайлаВыгрузки + ".sig"),
		Ложь, , , ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеПодписанияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатСубъектаРФ = ДополнительныеПараметры.СертификатСубъектаРФ;
	СертификатФСРАР = ДополнительныеПараметры.СертификатФСРАР;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал = ДополнительныеПараметры.ФедеральныйПортал;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		Ошибка = НСтр("ru = 'Не удалось подписать файл выгрузки!';
						|en = 'Не удалось подписать файл выгрузки!'");
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// упаковываем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Упаковка файла выгрузки ...';
													|en = 'Упаковка файла выгрузки ...'")); // ФСРАР
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЧтенияПодписанногоФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ЭтоКрупнаяДекларация = НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки)
		И ДополнительныеПараметры.Свойство("АдресГотовыхДанных") И ДополнительныеПараметры.АдресГотовыхДанных <> Неопределено;
		
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоКрупнаяДекларация Тогда
		
		Если Результат.ФайлПодписи <> ДополнительныеПараметры.АдресГотовыхДанных Тогда
			УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресГотовыхДанных);
			ДополнительныеПараметры.АдресГотовыхДанных = Результат.ФайлПодписи;
		КонецЕсли;
		
		РезультатВыполнения = Новый Структура("Выполнено, СтрокаBase64", Истина, ДополнительныеПараметры.АдресГотовыхДанных);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяФайлаВыгрузки + ".sig");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеЧтенияПодписанногоФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатСубъектаРФ = ДополнительныеПараметры.СертификатСубъектаРФ;
	СертификатФСРАР = ДополнительныеПараметры.СертификатФСРАР;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал = ДополнительныеПараметры.ФедеральныйПортал;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ПодписаннойВыгрузки = Результат.СтрокаBase64;
	
	АдресАрхиваВыгрузки = ЗаписатьZipФайлПакетаНаСервере(СтрокаBase64ПодписаннойВыгрузки, ИмяФайлаВыгрузки + ".sig");
	Если АдресАрхиваВыгрузки = Неопределено Тогда
		Ошибка = НСтр("ru = 'Не удалось упаковать файл выгрузки!';
						|en = 'Не удалось упаковать файл выгрузки!'");
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("АдресАрхиваВыгрузки", АдресАрхиваВыгрузки);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
						
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиZipФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		РезультатВыполнения = Новый Структура("Выполнено", Истина);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
				
		Возврат;
	КонецЕсли;
	
	ДанныеАрхиваВыгрузки = ПолучитьИзВременногоХранилища(АдресАрхиваВыгрузки);
	СтрокаBase64АрхиваВыгрузки = Base64Строка(ДанныеАрхиваВыгрузки);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиZipФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СтрокаBase64АрхиваВыгрузки, ПолноеИмяФайлаВыгрузки + ".sig.zip");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеЗаписиZipФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	СертификатСубъектаРФ = ДополнительныеПараметры.СертификатСубъектаРФ;
	СертификатФСРАР = ДополнительныеПараметры.СертификатФСРАР;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ФедеральныйПортал = ДополнительныеПараметры.ФедеральныйПортал;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	АдресАрхиваВыгрузки = ДополнительныеПараметры.АдресАрхиваВыгрузки;
		
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// шифруем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Шифрование файла выгрузки ...';
													|en = 'Шифрование файла выгрузки ...'"));
	ИмяФайлаЗашифрованногоПакета = ПолноеИмяФайлаВыгрузки + ".sig.zip.enc";
	
	ДополнительныеПараметры.Вставить("ИмяФайлаЗашифрованногоПакета", ИмяФайлаЗашифрованногоПакета);
	
	СертификатыЗашифрования = Новый Массив;
	Если НЕ ФедеральныйПортал Тогда
		СертификатыЗашифрования.Добавить(СертификатСубъектаРФ);
	КонецЕсли;
	СертификатыЗашифрования.Добавить(СертификатФСРАР);
	
	ИмяДляШифрования = ПолноеИмяФайлаВыгрузки + ".sig.zip";
	//ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ИмяФайлаЗашифрованногоПакета, СертификатыИПараметрыОбмена", ВыполняемоеОповещение, ИмяФайлаЗашифрованногоПакета, СертификатыИПараметрыОбмена);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФСРАРПослеЗашифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ИмяДляШифрования = АдресАрхиваВыгрузки;
		ИмяФайлаЗашифрованногоПакета = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	КонецЕсли;
	
	КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
		Оповещение,
		ИмяДляШифрования,
		СертификатыЗашифрования,
		ИмяФайлаЗашифрованногоПакета,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФСРАРПослеЗашифрованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаЗашифрованногоПакета = ДополнительныеПараметры.ИмяФайлаЗашифрованногоПакета;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		Ошибка = НСтр("ru = 'Не удалось зашифровать файл выгрузки!';
						|en = 'Не удалось зашифровать файл выгрузки!'");
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ИмяФайлаЗашифрованногоПакета = Новый Структура;
		ИмяФайлаЗашифрованногоПакета.Вставить("ИмяФайлаЗашифрованногоПакета", Результат.ЗашифрованныйФайл);
		ИмяФайлаЗашифрованногоПакета.Вставить("ИмяФайлаВыгрузки", ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки);
	КонецЕсли;	
	
	Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", ИмяФайлаЗашифрованногоПакета, СертификатыИПараметрыОбмена);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

#Область ОбменСЕГАИС

&НаКлиенте
Процедура ОтправитьВЕГАИС(
		ВыполняемоеОповещение,
		ОтчетСсылка,
		ОрганизацияСсылка,
		ИмяФайлаВыгрузки,
		АдресГотовыхДанных,
		ТекстФайлаВыгрузки,
		НастройкиОтправки)
	
	СвойстваФайлаВыгрузки = Новый Структура;
	СвойстваФайлаВыгрузки.Вставить("ИмяФайлаВыгрузки", 		ИмяФайлаВыгрузки);
	СвойстваФайлаВыгрузки.Вставить("АдресГотовыхДанных", 	АдресГотовыхДанных);
	СвойстваФайлаВыгрузки.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 			ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		ОрганизацияСсылка);
	ДополнительныеПараметры.Вставить("СвойстваФайлаВыгрузки", 	СвойстваФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("НастройкиОтправки", 		НастройкиОтправки);
	ДополнительныеПараметры.Вставить("ТекстОшибки", 			"");
	ДополнительныеПараметры.Вставить("НастройкиОбмена", 		Неопределено);
	
	НастройкиОбмена = НастройкиОбменаФСРАРЕГАИС(ОрганизацияСсылка);
	Если ЗначениеЗаполнено(НастройкиОбмена.АдресУТМ) ИЛИ ЗначениеЗаполнено(НастройкиОбмена.ПортУТМ)
		ИЛИ ЗначениеЗаполнено(НастройкиОбмена.Таймаут) ИЛИ НастройкиОбмена.ОбменНаСервере = Истина Тогда
		
		Оповещение = Новый ОписаниеОповещения("ОтправитьВЕГАИСПослеНастройки", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, НастройкиОбмена);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("ОтправитьВЕГАИСВызовНастройки", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиОбменаФСРАРЕГАИС(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресУТМ", 			"");
	Результат.Вставить("ПортУТМ", 			0);
	Результат.Вставить("Таймаут", 			0);
	Результат.Вставить("ОбменНаСервере", 	Ложь);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСРАР.АдресУТМ КАК АдресУТМ,
		|	НастройкиОбменаФСРАР.ПортУТМ КАК ПортУТМ,
		|	НастройкиОбменаФСРАР.ТаймаутУТМ КАК ТаймаутУТМ,
		|	НастройкиОбменаФСРАР.ОбменСУТМНаСервере КАК ОбменСУТМНаСервере
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСРАР КАК НастройкиОбменаФСРАР
		|ГДЕ
		|	НастройкиОбменаФСРАР.Организация = &ОрганизацияСсылка
		|	И (НастройкиОбменаФСРАР.Пользователь ЕСТЬ NULL
		|	ИЛИ НастройкиОбменаФСРАР.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))");
	
	Запрос.УстановитьПараметр("ОрганизацияСсылка", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.АдресУТМ 			= Выборка.АдресУТМ;
		Результат.ПортУТМ 			= Выборка.ПортУТМ;
		Результат.Таймаут 			= Выборка.ТаймаутУТМ;
		Результат.ОбменНаСервере 	= Выборка.ОбменСУТМНаСервере;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьВЕГАИСВызовНастройки(Результат, ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("ОтправитьВЕГАИСПослеНастройки", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОрганизацияСсылка", 	ДополнительныеПараметры.ОрганизацияСсылка);
	ПараметрыФормы.Вставить("ТекстОшибки", 			ДополнительныеПараметры.ТекстОшибки);
	ПараметрыФормы.Вставить("НастройкиОбмена", 		ДополнительныеПараметры.НастройкиОбмена);
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.НастройкиОбменаЕГАИС",
		ПараметрыФормы,,,,,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВЕГАИСПослеНастройки(НастройкиОбменаИлиРезультатДиалогаОбОшибкеДоступа,
		ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(НастройкиОбменаИлиРезультатДиалогаОбОшибкеДоступа) = Тип("Булево") Тогда
		РезультатДиалогаОбОшибкеДоступа = НастройкиОбменаИлиРезультатДиалогаОбОшибкеДоступа;
		НастройкиОбмена = ДополнительныеПараметры.НастройкиОбмена;
	Иначе
		РезультатДиалогаОбОшибкеДоступа = Истина;
		НастройкиОбмена = НастройкиОбменаИлиРезультатДиалогаОбОшибкеДоступа;
		ДополнительныеПараметры.Вставить("НастройкиОбмена", НастройкиОбмена);
	КонецЕсли;
	
	Если НастройкиОбмена = Неопределено ИЛИ НЕ РезультатДиалогаОбОшибкеДоступа Тогда
		НастройкиОтправки = ДополнительныеПараметры.НастройкиОтправки;
		
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("РезультатВыгрузки", 	Неопределено);
		РезультатВыполнения.Вставить("ОтправленоВЕГАИС", 	Ложь);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Если НастройкиОбмена.ОбменНаСервере Тогда
		СвойстваОтвета = ОтправитьВЕГАИСОтправкаНаСервере(
			ДополнительныеПараметры.ОтчетСсылка,
			ДополнительныеПараметры.ОрганизацияСсылка,
			НастройкиОбмена,
			ДополнительныеПараметры.СвойстваФайлаВыгрузки);
		
	Иначе
		СвойстваОтвета = ОтправитьВЕГАИСОтправкаНаКлиенте(
			ДополнительныеПараметры.ОтчетСсылка,
			ДополнительныеПараметры.ОрганизацияСсылка,
			НастройкиОбмена,
			ДополнительныеПараметры.СвойстваФайлаВыгрузки);
	КонецЕсли;
	
	Если СвойстваОтвета.КодСостояния = 200 И НЕ ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки) Тогда
		НастройкиОтправки = ДополнительныеПараметры.НастройкиОтправки;
		
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("РезультатВыгрузки", 	Неопределено);
		РезультатВыполнения.Вставить("ОтправленоВЕГАИС", 	Истина);
		РезультатВыполнения.Вставить("НоваяОтправкаСсылка", СвойстваОтвета.ОтправкаСсылка);
		РезультатВыполнения.Вставить("ФедеральныйПортал", 	НастройкиОтправки.ФедеральныйПортал);
		РезультатВыполнения.Вставить("КодРегиона", 			НастройкиОтправки.КодРегиона);
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки) И СвойстваОтвета.КодСостояния = "ПовторитьНастройкуОбмена" Тогда
		ДополнительныеПараметры.Вставить("ТекстОшибки", СвойстваОтвета.ТекстОшибки);
		Оповещение = Новый ОписаниеОповещения("ОтправитьВЕГАИСВызовНастройки", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение);
		Возврат;
	КонецЕсли;
	
	ПовторятьСоединение = ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки)
		И СвойстваОтвета.КодСостояния <> "ВывестиТекстОшибки";
	
	Если ПовторятьСоединение Тогда
		ПортУТМСтрокой = Формат(НастройкиОбмена.ПортУТМ, "ЧДЦ=; ЧН=; ЧГ=");
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось обратиться к серверу ЕГАИС (%1)';
				|en = 'Не удалось обратиться к серверу ЕГАИС (%1)'"),
			НастройкиОбмена.АдресУТМ + ":" + ПортУТМСтрокой);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьВЕГАИСПослеНастройки", ЭтотОбъект, ДополнительныеПараметры);
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			ТекстСообщения,
			ОписаниеОповещения);
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(?(СвойстваОтвета.КодСостояния = "ВывестиТекстОшибки",
			СвойстваОтвета.ТекстОшибки, НСтр("ru = 'Не удалось отправить отчет в ЕГАИС';
											|en = 'Не удалось отправить отчет в ЕГАИС'")));
		
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("РезультатВыгрузки", 	Неопределено);
		РезультатВыполнения.Вставить("ОтправленоВЕГАИС", 	Ложь);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьВЕГАИСПодгтовкаЗапроса(
		ТипОперации,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки = Неопределено)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправитьВЕГАИСПодгтовкаЗапроса(
		ТипОперации,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьВЕГАИСОбработкаОтвета(
		ТипОперации,
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки = Неопределено,
		ТекстОтвета = "")
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправитьВЕГАИСОбработкаОтвета(
		ТипОперации,
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки,
		ТекстОтвета);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьВЕГАИСОтправкаНаСервере(
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки)
	
	СвойстваЗапроса = ОтправитьВЕГАИСПодгтовкаЗапроса(
		"СлужебнаяИнформацияОбОрганизации",
		ОрганизацияСсылка,
		НастройкиОбмена);
	
	СвойстваОтвета = ДокументооборотСКОКлиентСервер.ОтправитьHTTPЗапрос(
		СвойстваЗапроса.ТранспортныйМодуль,
		СвойстваЗапроса.ПараметрыВызова);
	
	РезультатИлиСвойстваЗапроса = ОтправитьВЕГАИСОбработкаИЗапрос(
		СвойстваОтвета,
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки);
	
	Если НЕ РезультатИлиСвойстваЗапроса.Свойство("СвойстваЗапроса") Тогда
		Возврат РезультатИлиСвойстваЗапроса;
	КонецЕсли;
		
	СвойстваЗапроса = РезультатИлиСвойстваЗапроса.СвойстваЗапроса;
	
	СвойстваОтвета = ДокументооборотСКОКлиентСервер.ОтправитьHTTPЗапрос(
		СвойстваЗапроса.ТранспортныйМодуль,
		СвойстваЗапроса.ПараметрыВызова);
	
	ОтправкаСсылка = Неопределено;
	Если СвойстваОтвета.КодСостояния = 200 И НЕ ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки) Тогда
		ОтправкаСсылка = ОтправитьВЕГАИСОбработкаОтвета(
			"ОтправкаДекларации",
			ОтчетСсылка,
			ОрганизацияСсылка,
			НастройкиОбмена,
			СвойстваФайлаВыгрузки);
	КонецЕсли;
	СвойстваОтвета.Вставить("ОтправкаСсылка", ОтправкаСсылка);
	
	Возврат СвойстваОтвета;
	
КонецФункции

&НаКлиенте
Функция ОтправитьВЕГАИСОтправкаНаКлиенте(
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки)
	
	#Если ВебКлиент Тогда
		Возврат Новый Структура("КодСостояния, ТекстОшибки, ОтправкаСсылка", "ВывестиТекстОшибки",
			НСтр("ru = 'Обмен с ЕГАИС из веб-клиента недоступен. Используйте тонкий клиент';
				|en = 'Обмен с ЕГАИС из веб-клиента недоступен. Используйте тонкий клиент'"), Неопределено);
	#Иначе
		СвойстваЗапроса = ОтправитьВЕГАИСПодгтовкаЗапроса(
			"СлужебнаяИнформацияОбОрганизации",
			ОрганизацияСсылка,
			НастройкиОбмена);
		
		СвойстваОтвета = ДокументооборотСКОКлиентСервер.ОтправитьHTTPЗапрос(
			СвойстваЗапроса.ТранспортныйМодуль,
			СвойстваЗапроса.ПараметрыВызова);
		
		РезультатИлиСвойстваЗапроса = ОтправитьВЕГАИСОбработкаИЗапрос(
			СвойстваОтвета,
			ОтчетСсылка,
			ОрганизацияСсылка,
			НастройкиОбмена,
			СвойстваФайлаВыгрузки);
		
		Если НЕ РезультатИлиСвойстваЗапроса.Свойство("СвойстваЗапроса") Тогда
			Возврат РезультатИлиСвойстваЗапроса;
		КонецЕсли;
		
		СвойстваЗапроса = РезультатИлиСвойстваЗапроса.СвойстваЗапроса;
		
		СвойстваОтвета = ДокументооборотСКОКлиентСервер.ОтправитьHTTPЗапрос(
			СвойстваЗапроса.ТранспортныйМодуль,
			СвойстваЗапроса.ПараметрыВызова);
		
		ОтправкаСсылка = Неопределено;
		Если СвойстваОтвета.КодСостояния = 200 И НЕ ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки) Тогда
			ОтправкаСсылка = ОтправитьВЕГАИСОбработкаОтвета(
				"ОтправкаДекларации",
				ОтчетСсылка,
				ОрганизацияСсылка,
				НастройкиОбмена,
				СвойстваФайлаВыгрузки);
		КонецЕсли;
		СвойстваОтвета.Вставить("ОтправкаСсылка", ОтправкаСсылка);
		
		Возврат СвойстваОтвета;
	#КонецЕсли
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьВЕГАИСОбработкаИЗапрос(
		СвойстваОтвета,
		ОтчетСсылка,
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки)
	
	Если СвойстваОтвета.КодСостояния = 200 И НЕ ЗначениеЗаполнено(СвойстваОтвета.ТекстОшибки) Тогда
		ТекстОшибки = ОтправитьВЕГАИСОбработкаОтвета(
			"СлужебнаяИнформацияОбОрганизации",
			ОтчетСсылка,
			ОрганизацияСсылка,
			НастройкиОбмена,,
			СвойстваОтвета.ТекстОтвета);
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат Новый Структура("КодСостояния, ТекстОшибки, ОтправкаСсылка", "ПовторитьНастройкуОбмена",
				ТекстОшибки, Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	СвойстваЗапроса = ОтправитьВЕГАИСПодгтовкаЗапроса(
		"ОтправкаДекларации",
		ОрганизацияСсылка,
		НастройкиОбмена,
		СвойстваФайлаВыгрузки);
	
	Возврат Новый Структура("СвойстваЗапроса", СвойстваЗапроса);
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
		
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР(
		ВходящийКонтекст.Форма, 
		ВходящийКонтекст.КодРегионаВФорме,
		ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность, 
		ВходящийКонтекст.ОтчетСсылка, 
		ВходящийКонтекст.ОрганизацияОтчета, 
		ВходящийКонтекст.АдресГотовыхДанных, 
		ВходящийКонтекст.ИмяФайлаГотовыхДанных);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР(
		Форма, 
		КодРегионаВФорме = Неопределено,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь, 
		Знач ОтчетСсылка = Неопределено, 
		Знач ОрганизацияОтчета = Неопределено, 
		Знач АдресГотовыхДанных = Неопределено, 
		Знач ИмяФайлаГотовыхДанных = Неопределено) Экспорт
		
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияОтчета 	= ДокументооборотСФСРАРКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
		ОтчетСсылка 		= ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 						 Форма);
	ДополнительныеПараметры.Вставить("КодРегионаВФорме", 			 КодРегионаВФорме);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 				 ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 			 ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("АдресГотовыхДанных", 			 АдресГотовыхДанных);
	ДополнительныеПараметры.Вставить("ИмяФайлаГотовыхДанных", 		 ИмяФайлаГотовыхДанных);
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеСохранения(Истина, ДополнительныеПараметры);
		Иначе
			// отправляем только из записанной формы
			Если Форма.Модифицированность Тогда
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеСохранения",
					ЭтотОбъект,
					ДополнительныеПараметры);
				
				Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			Иначе
				ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеСохранения(Истина, ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
	Иначе // электронное представление
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			Если Форма.Модифицированность Тогда
				ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
											|en = 'Необходимо записать отчет перед отправкой.'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено 
			ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат;
		КонецЕсли;
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеСохранения(Истина, ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеСохранения(Результат, ДополнительныеПараметры) Экспорт
	
	Форма              = ДополнительныеПараметры.Форма;
	ОтчетСсылка        = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета  = ДополнительныеПараметры.ОрганизацияОтчета;
	
	Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
		ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
		ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
	КонецЕсли;
	
	СвойстваОбмена                      = СвойстваОбменаОрганизацииНаСервере(ОрганизацияОтчета, Ложь, Истина, Ложь);
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(СвойстваОбмена);
	УчетнаяЗапись                       = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияОтчета);
	
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		Если НЕ СвойстваОбмена.НастроенОбменВУниверсальномФормате Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАР_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, ОписаниеОповещения); //+
			
		Иначе
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка); //+
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СвойстваОбмена.НастроенОбменВУниверсальномФормате 
		И НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ОтчетСсылка) Тогда
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка); //+
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет",                 ТипЗнч(ОтчетСсылка));

	ДополнительныеПараметры.Вставить("УчетнаяЗапись",                       УчетнаяЗапись);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеНастройкиУчетнойПолитикиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если СвойстваОбмена.НастроенОбменВУниверсальномФормате 
		И СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку 
		И СвойстваОбмена.ПравоИзмененияУчетнойЗаписи Тогда
		
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка,ОписаниеОповещения);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеНастройкиУчетнойПолитикиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма                               = ДополнительныеПараметры.Форма;
	КодРегионаВФорме                    = ДополнительныеПараметры.КодРегионаВФорме;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ТипЗнчСсылкаНаОтчет                 = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	АдресГотовыхДанных                  = ДополнительныеПараметры.АдресГотовыхДанных;
	ИмяФайлаГотовыхДанных               = ДополнительныеПараметры.ИмяФайлаГотовыхДанных;
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			
			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРРегламентированныйОтчет(
				КодРегионаВФорме,
				ОрганизацияОтчета,
				ОтчетСсылка,
				УчетнаяЗапись,
				Форма,
				ЭтоОтправкаИзФормыОтчетность,
				ЭтоРегламентированныйОтчет,
				МестоХраненияКлюча,
				АдресГотовыхДанных,
				ИмяФайлаГотовыхДанных);
				
		Иначе
			// отправляем только из записанной формы
			Если Форма.Модифицированность Тогда
				
				ДополнительныеПараметры.Вставить("УчетнаяЗапись",              УчетнаяЗапись);
				ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет", ЭтоРегламентированныйОтчет);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРЗавершение",
					ЭтотОбъект,
					ДополнительныеПараметры);
				
				Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
				
			Иначе
				
				ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРРегламентированныйОтчет(
					КодРегионаВФорме,
					ОрганизацияОтчета,
					ОтчетСсылка,
					УчетнаяЗапись,
					Форма,
					ЭтоОтправкаИзФормыОтчетность,
					ЭтоРегламентированныйОтчет,
					МестоХраненияКлюча,
					АдресГотовыхДанных,
					ИмяФайлаГотовыхДанных);
				
			КонецЕсли;
		КонецЕсли;
	Иначе // электронное представление
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			Если Форма.Модифицированность Тогда
				ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
											|en = 'Необходимо записать отчет перед отправкой.'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено 
			ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки 	= ПоляДляЗаписиОтправкиВФСРАРНаСервере(ОтчетСсылка);
		ФедеральныйПортал 		= ПоляДляЗаписиОтправки.ФедеральныйПортал;
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения(
			КодРегионаВФорме,
			ОрганизацияОтчета,
			ОтчетСсылка,
			ПоляДляЗаписиОтправки,
			УчетнаяЗапись,
			ФедеральныйПортал,
			Форма,
			ЭтоОтправкаИзФормыОтчетность,
			ЭтоРегламентированныйОтчет,
			МестоХраненияКлюча,
			АдресГотовыхДанных,
			ИмяФайлаГотовыхДанных);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КодРегионаВФорме                    = ДополнительныеПараметры.КодРегионаВФорме;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ЭтоРегламентированныйОтчет          = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	АдресГотовыхДанных = ДополнительныеПараметры.АдресГотовыхДанных;
	ИмяФайлаГотовыхДанных = ДополнительныеПараметры.ИмяФайлаГотовыхДанных;
	
	// если отчет не был записан ранее, то получим ссылку на записанный отчет
	Если ОтчетСсылка = Неопределено Тогда
		ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРРегламентированныйОтчет(
		КодРегионаВФорме,
		ОрганизацияОтчета,
		ОтчетСсылка,
		УчетнаяЗапись,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ЭтоРегламентированныйОтчет,
		МестоХраненияКлюча,
		АдресГотовыхДанных,
		ИмяФайлаГотовыхДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРРегламентированныйОтчет(
	КодРегионаВФорме,
	ОрганизацияОтчета,
	ОтчетСсылка,
	УчетнаяЗапись,
	Форма,
	ЭтоОтправкаИзФормыОтчетность,
	ЭтоРегламентированныйОтчет,
	МестоХраненияКлюча,
	АдресГотовыхДанных = Неопределено,
	ИмяФайлаГотовыхДанных = Неопределено)
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ФедеральныйПортал = ОтчетПодаетсяЧерезФедеральныйПорталНаСервере(ОтчетСсылка);
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид, ДанныеОтчета");
		
		ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия, ФедеральныйПортал",
			НачалоДня(ЗначенияРеквизитов.ДатаНачала),
			КонецДня(ЗначенияРеквизитов.ДатаОкончания),
			ЗначенияРеквизитов.Вид,
			ФедеральныйПортал);
			
	Иначе
			
		ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия, ФедеральныйПортал",
			Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,
			Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета,
			Форма.СтруктураРеквизитовФормы.ВидДокумента * Форма.НомерКорректировки,
			ФедеральныйПортал);
		
	КонецЕсли;
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДанныеОтчета");
		КодРегионаВФорме = КодРегионаВФорме(ЗначенияРеквизитов);
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения(
		КодРегионаВФорме,
		ОрганизацияОтчета,
		ОтчетСсылка,
		ПоляДляЗаписиОтправки,
		УчетнаяЗапись,
		ФедеральныйПортал,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ЭтоРегламентированныйОтчет,
		МестоХраненияКлюча,
		АдресГотовыхДанных,
		ИмяФайлаГотовыхДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения(
	КодРегионаВФорме,
	ОрганизацияОтчета,
	ОтчетСсылка,
	ПоляДляЗаписиОтправки,
	УчетнаяЗапись,
	ФедеральныйПортал,
	Форма,
	ЭтоОтправкаИзФормыОтчетность,
	ЭтоРегламентированныйОтчет,
	МестоХраненияКлюча,
	АдресГотовыхДанных = Неопределено,
	ИмяФайлаГотовыхДанных = Неопределено)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КодРегионаВФорме",                    КодРегионаВФорме);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета",                   ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки",               ПоляДляЗаписиОтправки);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись",                       УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("ФедеральныйПортал",                   ФедеральныйПортал);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность",        ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",          ЭтоРегламентированныйОтчет);
	ДополнительныеПараметры.Вставить("АдресГотовыхДанных",                  АдресГотовыхДанных);
	ДополнительныеПараметры.Вставить("ИмяФайлаГотовыхДанных",               ИмяФайлаГотовыхДанных);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОтчетСсылка, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ОтчетСсылка, ВходящийКонтекст.ОрганизацияОтчета, "ФСРАР");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеСохранения_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;	
	
	Форма 		= ВходящийКонтекст.Форма;
	ОтчетСсылка = ВходящийКонтекст.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтверждения",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	ПодтверждениеОтправкиОтчета(
		Форма, 
		ОписаниеОповещения,
		ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтверждения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	// проверяем, отправлялся ли отчет
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтвержденияЗавершение",
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ПодтвердитьПовторнуюОтправку(ОтчетСсылка, "ФСРАР", ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтвержденияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КодРегионаВФорме             = ДополнительныеПараметры.КодРегионаВФорме;
	ОрганизацияОтчета            = ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	ФедеральныйПортал            = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                        = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	АдресГотовыхДанных           = ДополнительныеПараметры.АдресГотовыхДанных;
	ИмяФайлаГотовыхДанных        = ДополнительныеПараметры.ИмяФайлаГотовыхДанных;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФСРАР(
		ОтчетСсылка,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		АдресГотовыхДанных,
		ИмяФайлаГотовыхДанных);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если РезультатВыгрузки = Неопределено Тогда
		
		Ошибка = НСтр("ru = 'Не удалось выгрузить отчет.';
						|en = 'Не удалось выгрузить отчет.'");

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СертификатыИПараметрыОбмена = Неопределено;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПроверкиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("Форма", 						Форма);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 			ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("РезультатВыгрузки", 			РезультатВыгрузки);
	КонтекстДлительнойОперации.Вставить("ФедеральныйПортал", 			ФедеральныйПортал);
	КонтекстДлительнойОперации.Вставить("КодРегионаВФорме", 			КодРегионаВФорме);
	КонтекстДлительнойОперации.Вставить("СертификатыИПараметрыОбмена", 	СертификатыИПараметрыОбмена);
	КонтекстДлительнойОперации.Вставить("ЭтоОтправкаИзФормыОтчетность", ЭтоОтправкаИзФормыОтчетность);
	КонтекстДлительнойОперации.Вставить("ОтчетСсылка", 					ОтчетСсылка);
	КонтекстДлительнойОперации.Вставить("ОрганизацияОтчета", 			ОрганизацияОтчета);
	КонтекстДлительнойОперации.Вставить("АдресГотовыхДанных", 			АдресГотовыхДанных);
	КонтекстДлительнойОперации.Вставить("ИмяФайлаГотовыхДанных", 		ИмяФайлаГотовыхДанных);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСРАР
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтвержденияЗавершение",  0.1, Истина);
	
КонецПроцедуры
	
&НаКлиенте
Процедура Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПодтвержденияЗавершение() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Форма 							= КонтекстДлительнойОперации.Форма;
	ОписаниеОповещения 				= КонтекстДлительнойОперации.ОписаниеОповещения;
	РезультатВыгрузки 				= КонтекстДлительнойОперации.РезультатВыгрузки;
	ФедеральныйПортал 				= КонтекстДлительнойОперации.ФедеральныйПортал;
	КодРегионаВФорме 				= КонтекстДлительнойОперации.КодРегионаВФорме;
	СертификатыИПараметрыОбмена 	= КонтекстДлительнойОперации.СертификатыИПараметрыОбмена;
	ЭтоОтправкаИзФормыОтчетность 	= КонтекстДлительнойОперации.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка 					= КонтекстДлительнойОперации.ОтчетСсылка;
	ОрганизацияОтчета 				= КонтекстДлительнойОперации.ОрганизацияОтчета;
	АдресГотовыхДанных 				= КонтекстДлительнойОперации.АдресГотовыхДанных;
	ИмяФайлаГотовыхДанных 			= КонтекстДлительнойОперации.ИмяФайлаГотовыхДанных;
	
	ВыгрузитьПакетДляОтправкиВФСРАР(
		Форма,
		ОписаниеОповещения,
		ФедеральныйПортал,
		РезультатВыгрузки.ТекстФайлаВыгрузки,
		РезультатВыгрузки.ИмяФайлаВыгрузки,
		Строка(КодРегионаВФорме),
		СертификатыИПараметрыОбмена,
		ЭтоОтправкаИзФормыОтчетность,
		ОтчетСсылка,
		ОрганизацияОтчета,
		АдресГотовыхДанных,
		ИмяФайлаГотовыхДанных);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеПроверкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	
	Если НЕ ЗначениеЗаполнено(Результат.РезультатВыгрузки) Тогда
		Если Результат.Свойство("ОтправленоВЕГАИС") И Результат.ОтправленоВЕГАИС Тогда
			ПараметрыАвтозапроса = Новый Структура();
			ПараметрыАвтозапроса.Вставить("Ключ", 				Результат.НоваяОтправкаСсылка);
			ПараметрыАвтозапроса.Вставить("ФедеральныйПортал", 	Результат.ФедеральныйПортал);
			ПараметрыАвтозапроса.Вставить("КодРегиона", 		Результат.КодРегиона);
			ПараметрыАвтозапроса.Вставить("ЗначениеCookie", 	"");
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
			
			ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСРАР.
			
		Иначе
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", Результат.СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("РезультатВыгрузки", 			Результат.РезультатВыгрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеИнициализацииЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеИнициализацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КодРегионаВФорме                    = ДополнительныеПараметры.КодРегионаВФорме;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки               = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	ФедеральныйПортал                   = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ЭтоРегламентированныйОтчет          = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	РезультатВыгрузки                   = ДополнительныеПараметры.РезультатВыгрузки;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		Возврат;
	КонецЕсли;
	
	ПараметрыФормированияПакета = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета;
	ИнформацияОРегионе          = СертификатыИПараметрыОбмена.ИнформацияОРегионе;
	СхемаСдачиОтчетности        = СертификатыИПараметрыОбмена.СхемаСдачиОтчетности;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		СтрокаBase64ФайлаПакета = РезультатВыгрузки.ИмяФайлаЗашифрованногоПакета;
		КороткоеИмяФайлаПакета = РезультатВыгрузки.ИмяФайлаВыгрузки + ".sig.zip.enc";
		
		Результат = Новый Структура();
		Результат.Вставить("Выполнено",      Истина);
		Результат.Вставить("ДвоичныеДанные", Неопределено);
		Результат.Вставить("СтрокаBase64",   СтрокаBase64ФайлаПакета);
		
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета", ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("ИнформацияОРегионе",          ИнформацияОРегионе);
		ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",        СхемаСдачиОтчетности);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",      КороткоеИмяФайлаПакета);
		
		Оповещение = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеЧтенияФайлаВыгрузкиПакетаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
	Иначе
		КороткоеИмяФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(РезультатВыгрузки).Имя;
		
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета", ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("ИнформацияОРегионе",          ИнформацияОРегионе);
		ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",        СхемаСдачиОтчетности);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",      КороткоеИмяФайлаПакета);
		
		Оповещение = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеЧтенияФайлаВыгрузкиПакетаЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, РезультатВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеЧтенияФайлаВыгрузкиПакетаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КодРегионаВФорме                    = ДополнительныеПараметры.КодРегионаВФорме;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки               = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	ФедеральныйПортал                   = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ЭтоРегламентированныйОтчет          = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	РезультатВыгрузки                   = ДополнительныеПараметры.РезультатВыгрузки;
	ПараметрыФормированияПакета         = ДополнительныеПараметры.ПараметрыФормированияПакета;
	ИнформацияОРегионе                  = ДополнительныеПараметры.ИнформацияОРегионе;
	СхемаСдачиОтчетности                = ДополнительныеПараметры.СхемаСдачиОтчетности;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаПакета = Результат.СтрокаBase64;
	
	СтрокаBase64ФайлаОтправки = СформироватьФайлОтправкиВФСРАРНаСервере(
		КороткоеИмяФайлаПакета,
		СхемаСдачиОтчетности,
		СтрокаBase64ФайлаПакета,
		// замена на перечисление МодельРаботыСКлючам
		НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча),
		Форма.УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Отправка отчета ...';
													|en = 'Отправка отчета ...'")); // ФСРАР
	
	Крипт = СертификатыИПараметрыОбмена.Крипт;
	КодИНаименованиеРегиона = ПараметрыФормированияПакета.КодРегиона + ?(ЗначениеЗаполнено(ИнформацияОРегионе.НаименованиеРегиона), " - ", "") + ИнформацияОРегионе.НаименованиеРегиона;
	ФормаДлительнаяОперация = Неопределено;
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("Организация",                  ОрганизацияОтчета);
	ПараметрыОтправки.Вставить("ИНН",                          Неопределено);
	ПараметрыОтправки.Вставить("ФедеральныйПортал",            ФедеральныйПортал);
	ПараметрыОтправки.Вставить("КодРегиона",                   ПараметрыФормированияПакета.КодРегиона);
	ПараметрыОтправки.Вставить("КодИНаименованиеРегиона",      КодИНаименованиеРегиона);
	ПараметрыОтправки.Вставить("СсылкаНаПорталОнлайнПроверки", ИнформацияОРегионе.СсылкаНаПортал);
	ПараметрыОтправки.Вставить("СхемаСдачиОтчетности",         СхемаСдачиОтчетности);
	ПараметрыОтправки.Вставить("ПоляДляЗаписиОтправки",        ПоляДляЗаписиОтправки);
	
	ПараметрыСоединения = Новый Структура();
	ПараметрыСоединения.Вставить("Пароль",                         ПараметрыФормированияПакета.ПарольПорталаСубъектаРФ);
	ПараметрыСоединения.Вставить("СохранитьПароль",                ЗначениеЗаполнено(ПараметрыФормированияПакета.ПарольПорталаСубъектаРФ));
	ПараметрыСоединения.Вставить("СохраненныйПароль",              ПараметрыФормированияПакета.ПарольПорталаСубъектаРФ);
	ПараметрыСоединения.Вставить("СоединениеHTTP",                 Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie",                 "");
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиНаСервере", "");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером",         "");
	ПараметрыСоединения.Вставить("ПовторятьСоединение",            Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля",          Истина);
	ПараметрыСоединения.Вставить("ТребуетсяРегистрация",           Ложь);
