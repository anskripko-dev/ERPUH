#КонецОбласти

&НаКлиенте
Процедура ПоказатьОтветНаЗапросИОСЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СписокВыбора = ДополнительныеПараметры.СписокВыбора;
	Запрос = ДополнительныеПараметры.Запрос;
	
	Если РезультатВыбора = Неопределено Тогда
		
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		КонецЕсли;
		
	Иначе
		
		// удаляем не помеченные строки из таблицы ответов
		Для Каждого СтрСписокВыбора Из СписокВыбора Цикл
			Если СтрСписокВыбора.Значение <> РезультатВыбора.Значение Тогда
				СтрОтветНаЗапросИОС = ОтветыНаЗапросыИОС.НайтиСтроки(Новый Структура("ИмяФайла", СтрСписокВыбора.Значение));
				ОтветыНаЗапросыИОС.Удалить(СтрОтветНаЗапросИОС[0]);
			КонецЕсли;
		КонецЦикла;
		
		ПоказатьОтветНаЗапросИОСНаКлиенте(Запрос, ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеКвитанцииЦБ(
		Заголовок,
		ИмяФайла,
		Тело,
		ЦиклОбмена,
		ТранспортноеСообщение = Неопределено,
		ТелоПриложения = Неопределено)
	
	СвойстваИзКвитанции = ПолучитьОсновныеСвойстваИзКвитанцииЦБ(Тело, ЦиклОбмена, ТранспортноеСообщение, ТелоПриложения);
	
	ТабДокумент = Новый ТабличныйДокумент;
	Если ЗначениеЗаполнено(СвойстваИзКвитанции) Тогда
		Макет = ПолучитьМакетОбработки("ЦБКвитанция");
		
		ОбластьМакета = Макет.ПолучитьОбласть("КвитанцияШапка");
		ОбластьМакета.Параметры.ТипКвитанции =
			?(нрег(СвойстваИзКвитанции.ОбщиеСведения.СтатусРезультатаОбработки) = "delivered",
				НСтр("ru = 'Подтверждение загрузки Банком России';
					|en = 'Подтверждение загрузки Банком России'"),
			?(нрег(СвойстваИзКвитанции.ОбщиеСведения.СтатусРезультатаОбработки) = "processing",
				НСтр("ru = 'Квитанция о приеме в обработку Банком России';
					|en = 'Квитанция о приеме в обработку Банком России'"),
			?(нрег(СвойстваИзКвитанции.ОбщиеСведения.СтатусРезультатаОбработки) = "error",
				НСтр("ru = 'Уведомление об отказе от обработки Банком России';
					|en = 'Уведомление об отказе от обработки Банком России'"),
				НСтр("ru = 'Квитанция Банка России';
					|en = 'Квитанция Банка России'"))));
		ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
		
		ОбластьМакета.Параметры.ДатаСоздания = ?(ЗначениеЗаполнено(СвойстваИзКвитанции.ОбщиеСведения.ДатаСоздания),
			Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаСоздания, "ДЛФ=ДДВ"),
			Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки, "ДЛФ=ДДВ"));
		ОбластьМакета.Параметры.ДатаОтправки = Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаОтправки, "ДЛФ=ДДВ");
		
		ОбластьМакета.Параметры.РезультатТранспортнойОперации = СвойстваИзКвитанции.ОбщиеСведения.РезультатОперации;
		
		ОбластьМакета.Параметры.КодТипаКвитанции = СвойстваИзКвитанции.ОбщиеСведения.ТипКвитанции;
		ОбластьМакета.Параметры.ИдентификаторСообщения = СвойстваИзКвитанции.ОбщиеСведения.ИдентификаторСообщения;
		ОбластьМакета.Параметры.ИдентификаторИсходногоСообщения =
			СвойстваИзКвитанции.ОбщиеСведения.ИдентификаторИсходногоСообщения;
		ОбластьМакета.Параметры.ТипСообщения = СвойстваИзКвитанции.ОбщиеСведения.ТипСообщения;
		ОбластьМакета.Параметры.ПриоритетСообщения = СвойстваИзКвитанции.ОбщиеСведения.ПриоритетСообщения;
		ТабДокумент.Вывести(ОбластьМакета); // Подвал
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(ОбластьМакета); // Подвал
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеРезультатаОбработкиЦБ(
		Заголовок,
		ИмяФайла,
		Тело,
		ЦиклОбмена,
		ТранспортноеСообщение = Неопределено)
	
	СвойстваИзКвитанции = ПолучитьОсновныеСвойстваИзКвитанцииЦБ(Тело, ЦиклОбмена, ТранспортноеСообщение);
	ДатыСообщений = ПолучитьОсновныеСвойстваЦБИзЦиклаОбмена(ЦиклОбмена);
	
	ТабДокумент = Новый ТабличныйДокумент;
	Если ЗначениеЗаполнено(СвойстваИзКвитанции) Тогда
		Макет = ПолучитьМакетОбработки("ЦБРезультатОбработки");
		
		ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиШапка");
		ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
		
		ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзКвитанции.ОбщиеСведения.РегистрационныйНомер;
		
		ОбластьМакета.Параметры.ДатаОтправки = ДатыСообщений.ДатаОтправки;
		ОбластьМакета.Параметры.ДатаЗагрузки = ?(ЗначениеЗаполнено(ДатыСообщений.ДатаЗагрузкиЗначение)
			И ЗначениеЗаполнено(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки)
			И ДатыСообщений.ДатаЗагрузкиЗначение > СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки,
			Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки, "ДЛФ=ДДВ"), ДатыСообщений.ДатаЗагрузки);
		ОбластьМакета.Параметры.ДатаПриема = ?(ЗначениеЗаполнено(ДатыСообщений.ДатаПриемаЗначение)
			И ЗначениеЗаполнено(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки)
			И ДатыСообщений.ДатаПриемаЗначение > СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки,
			Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки, "ДЛФ=ДДВ"), ДатыСообщений.ДатаПриема);
		ОбластьМакета.Параметры.ДатаРезультатаОбработки =
			?(ЗначениеЗаполнено(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки),
			Формат(СвойстваИзКвитанции.ОбщиеСведения.ДатаВремяРезультатаОбработки, "ДЛФ=ДДВ"), ДатыСообщений.ДатаОбработки);
		ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиШапка
		
		ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиОтчеты");
		ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиОтчеты
		
		Для каждого ЭлементФайл Из СвойстваИзКвитанции.ИмяФайла Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиИмяОтчетов");
			ОбластьМакета.Параметры.ИмяФайла = ЭлементФайл.ИмяФайла;
			ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиИмяОтчетов
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиРезультат");
		ОбластьМакета.Параметры.РешениеЦБ = СвойстваИзКвитанции.ОбщиеСведения.НазваниеСтатуса;
		ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиРезультат
		
		ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиПротоколШапка");
		ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиПротоколШапка
		
		Для каждого ЭлементВложение Из СвойстваИзКвитанции.Вложения Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("РезультатОбработкиПротокол");
			ОбластьМакета.Параметры.ИмяПриложения = ЭлементВложение.ИмяВложения;
			ТабДокумент.Вывести(ОбластьМакета); // РезультатОбработкиПротокол
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(ОбластьМакета); // Подвал
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция ПолучитьОсновныеСвойстваИзКвитанцииЦБ(
		СтрПротокол,
		ЦиклОбмена = Неопределено,
		ТранспортноеСообщение = Неопределено,
		ТелоПриложения = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(СтрПротокол) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(, СтрПротокол, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML квитанции Банка России:
					   |%1';
					   |en = 'Ошибка разбора XML квитанции Банка России:
					   |%1'"),
			ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбщиеСведения = Новый Структура;
	
	ТаблицаИменФайлов = Новый ТаблицаЗначений;
	ТаблицаИменФайлов.Колонки.Добавить("ИмяФайла");
	
	ТаблицаИменВложений = Новый ТаблицаЗначений;
	ТаблицаИменВложений.Колонки.Добавить("ИмяВложения");
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	УзелРегистрационныйНомер = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "regNum", "Э");
	РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегистрационныйНомер), СокрЛП(УзелРегистрационныйНомер.Значение), "");
	ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
	
	УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "dateTime", "Э");
	ДатаВремяРезультатаОбработки = ?(ЗначениеЗаполнено(УзелДатаВремя) И ЗначениеЗаполнено(УзелДатаВремя.Значение),
		ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелДатаВремя.Значение), Неопределено);
	ДатаВремяРезультатаОбработки = ?(ЗначениеЗаполнено(ДатаВремяРезультатаОбработки),
		МестноеВремя(ДатаВремяРезультатаОбработки), ДатаВремяРезультатаОбработки);
	ОбщиеСведения.Вставить("ДатаВремяРезультатаОбработки", ДатаВремяРезультатаОбработки);
	
	УзелСтатус = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "status", "Э");
	СтатусРезультатаОбработки = ?(ЗначениеЗаполнено(УзелСтатус), СокрЛП(УзелСтатус.Значение), "");
	ОбщиеСведения.Вставить("СтатусРезультатаОбработки", СтатусРезультатаОбработки);
	НазваниеСтатуса = ?(нрег(СтатусРезультатаОбработки) = "draft", НСтр("ru = 'Заготовка';
																		|en = 'Заготовка'"),
		?(нрег(СтатусРезультатаОбработки) = "sent" ИЛИ нрег(СтатусРезультатаОбработки) = "send", НСтр("ru = 'Отправлено';
																										|en = 'Отправлено'"),
		?(нрег(СтатусРезультатаОбработки) = "delivered", НСтр("ru = 'Загружено';
																|en = 'Загружено'"),
		?(нрег(СтатусРезультатаОбработки) = "processing", НСтр("ru = 'Принято в обработку';
																|en = 'Принято в обработку'"),
		?(нрег(СтатусРезультатаОбработки) = "error", НСтр("ru = 'Ошибка';
															|en = 'Ошибка'"),
		?(нрег(СтатусРезультатаОбработки) = "registered", НСтр("ru = 'Зарегистрировано';
																|en = 'Зарегистрировано'"),
		?(нрег(СтатусРезультатаОбработки) = "rejected", НСтр("ru = 'Отклонено';
															|en = 'Отклонено'"),
		СтатусРезультатаОбработки)))))));
	ОбщиеСведения.Вставить("НазваниеСтатуса", НазваниеСтатуса);
	
	УзелОписание = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "description", "Э");
	ОписаниеРезультатаОбработки = ?(ЗначениеЗаполнено(УзелОписание), СокрЛП(УзелОписание.Значение), "");
	ОбщиеСведения.Вставить("ОписаниеРезультатаОбработки", ОписаниеРезультатаОбработки);
	
	УзелЦвет = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "color", "Э");
	ЦветСтатуса = ?(ЗначениеЗаполнено(УзелЦвет), СокрЛП(УзелЦвет.Значение), "");
	ОбщиеСведения.Вставить("ЦветСтатуса", ЦветСтатуса);
	
	Если ТелоПриложения = Неопределено Тогда
		ПервичныеСообщения = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,
			Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ);
		Если ПервичныеСообщения.Количество() > 0 Тогда
			ФайлыОтчетности = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ПервичныеСообщения[0].Ссылка, Ложь,
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиЦБ);
			
			Для каждого ФайлОтчетности Из ФайлыОтчетности Цикл
				НовСтр = ТаблицаИменФайлов.Добавить();
				НовСтр.ИмяФайла = ФайлОтчетности.ИмяФайла;
				Если нрег(Прав(НовСтр.ИмяФайла, 4)) = ".enc" Тогда
					НовСтр.ИмяФайла = Лев(НовСтр.ИмяФайла, СтрДлина(НовСтр.ИмяФайла) - 4);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТранспортноеСообщение) Тогда
			Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Ложь,
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеЦБ);
			
			Для каждого Вложение Из Вложения Цикл
				НовСтр = ТаблицаИменВложений.Добавить();
				НовСтр.ИмяВложения = Вложение.ИмяФайла;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		Если ЗначениеЗаполнено(ТелоПриложения) Тогда
			ДеревоXML = ЗагрузитьXMLВДеревоЗначений(, ТелоПриложения, ОписаниеОшибки);
			
			Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Ошибка разбора XML приложения к квитанции Банка России:
							   |%1';
							   |en = 'Ошибка разбора XML приложения к квитанции Банка России:
							   |%1'"),
					ИнформацияОбОшибке().Описание);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			ДеревоXML = СоздатьДеревоСтруктурыXML();
		КонецЕсли;

		УзелТипКвитанции = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "AcknowledgementType", "Э");
		ТипКвитанции = ?(ЗначениеЗаполнено(УзелТипКвитанции), СокрЛП(УзелТипКвитанции.Значение), "");
		ОбщиеСведения.Вставить("ТипКвитанции", ТипКвитанции);
		
		УзелКодРезультата = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ResultCode", "Э");
		КодРезультата = ?(ЗначениеЗаполнено(УзелКодРезультата), СокрЛП(УзелКодРезультата.Значение), "");
		ОбщиеСведения.Вставить("КодРезультата", КодРезультата);
		
		УзелТекстРезультата = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ResultText", "Э");
		ТекстРезультата = ?(ЗначениеЗаполнено(УзелТекстРезультата),
			СокрЛП(УзелТекстРезультата.Значение), ОбщиеСведения.ОписаниеРезультатаОбработки);
		ОбщиеСведения.Вставить("ТекстРезультата", ТекстРезультата);
		
		ЭтоОтрицательнаяКвитанция = (нрег(СтатусРезультатаОбработки) = "error"
			ИЛИ нрег(СтатусРезультатаОбработки) = "rejected");
		РезультатОперации = ТекстПоКодуРезультатаЦБ(КодРезультата) + ?(ЗначениеЗаполнено(КодРезультата)
			И (КодРезультата <> "0000" И ЗначениеЗаполнено(ТекстРезультата) ИЛИ ЭтоОтрицательнаяКвитанция), ".
			|", "") + ?(КодРезультата <> "0000" ИЛИ ЭтоОтрицательнаяКвитанция, 
			?((НЕ ЗначениеЗаполнено(КодРезультата) ИЛИ КодРезультата = "0000") И ЭтоОтрицательнаяКвитанция,
			НСтр("ru = 'Обработка завершилась ошибкой';
				|en = 'Обработка завершилась ошибкой'") + ?(ЗначениеЗаполнено(ТекстРезультата), ". ", ""), "")
			+ ТекстРезультата, "");
		ОбщиеСведения.Вставить("РезультатОперации", РезультатОперации);
		
		УзелИдентификаторСообщения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "MessageID", "Э");
		ИдентификаторСообщения = ?(ЗначениеЗаполнено(УзелИдентификаторСообщения),
			СокрЛП(УзелИдентификаторСообщения.Значение), "");
		ОбщиеСведения.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
		
		УзелИдентификаторИсходногоСообщения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(
			ДеревоXML,,, "CorrelationMessageID", "Э");
		ИдентификаторИсходногоСообщения = ?(ЗначениеЗаполнено(УзелИдентификаторИсходногоСообщения),
			СокрЛП(УзелИдентификаторИсходногоСообщения.Значение), "");
		ОбщиеСведения.Вставить("ИдентификаторИсходногоСообщения", ИдентификаторИсходногоСообщения);
		
		УзелТипСообщения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "MessageType", "Э");
		ТипСообщения = ?(ЗначениеЗаполнено(УзелТипСообщения), СокрЛП(УзелТипСообщения.Значение), "");
		ОбщиеСведения.Вставить("ТипСообщения", ТипСообщения);
		
		УзелПриоритетСообщения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "Priority", "Э");
		ПриоритетСообщения = ?(ЗначениеЗаполнено(УзелПриоритетСообщения), СокрЛП(УзелПриоритетСообщения.Значение), "");
		ОбщиеСведения.Вставить("ПриоритетСообщения", ПриоритетСообщения);
		
		УзелДатаСоздания = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "CreateTime", "Э");
		ДатаСоздания = ?(ЗначениеЗаполнено(УзелДатаСоздания) И ЗначениеЗаполнено(УзелДатаСоздания.Значение),
			ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелДатаСоздания.Значение), Неопределено);
		ОбщиеСведения.Вставить("ДатаСоздания", ДатаСоздания);
		
		УзелДатаОтправки = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ReceiveTime", "Э");
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаОтправки) И ЗначениеЗаполнено(УзелДатаОтправки.Значение),
			ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелДатаОтправки.Значение), Неопределено);
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
	КонецЕсли;
	
	Возврат Новый Структура("ИмяФайла, ОбщиеСведения, Вложения", ТаблицаИменФайлов, ОбщиеСведения, ТаблицаИменВложений);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстПоКодуРезультатаЦБ(КодРезультата, ДобавитьКод = Истина)
	
	Если КодРезультата = "0000" Тогда
		Результат = НСтр("ru = 'Сообщение успешно обработано';
						|en = 'Сообщение успешно обработано'");
	ИначеЕсли КодРезультата = "1001" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку не соответствует требуемой структуре';
						|en = 'Сообщение не будет обработано, поскольку не соответствует требуемой структуре'");
	ИначеЕсли КодРезультата = "1002" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку транспортные заголовки заполнены некорректно';
						|en = 'Сообщение не будет обработано, поскольку транспортные заголовки заполнены некорректно'");
	ИначеЕсли КодРезультата = "1003" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку его формат не поддерживается Транспортным шлюзом ЕПВВ';
						|en = 'Сообщение не будет обработано, поскольку его формат не поддерживается Транспортным шлюзом ЕПВВ'");
	ИначеЕсли КодРезультата = "1004" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку его формат не поддерживается данным сервисом Транспортного шлюза ЕПВВ';
						|en = 'Сообщение не будет обработано, поскольку его формат не поддерживается данным сервисом Транспортного шлюза ЕПВВ'");
	ИначеЕсли КодРезультата = "1005" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку архив сформирован неверно';
						|en = 'Сообщение не будет обработано, поскольку архив сформирован неверно'");
	ИначеЕсли КодРезультата = "1006" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку служебный конверт не соответствует требуемой структуре';
						|en = 'Сообщение не будет обработано, поскольку служебный конверт не соответствует требуемой структуре'");
	ИначеЕсли КодРезультата = "1007" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку служебный конверт заполнен некорректно';
						|en = 'Сообщение не будет обработано, поскольку служебный конверт заполнен некорректно'");
	ИначеЕсли КодРезультата = "1008" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку не может быть распаковано из транспортной кодировки';
						|en = 'Сообщение не будет обработано, поскольку не может быть распаковано из транспортной кодировки'");
	ИначеЕсли КодРезультата = "1009" Тогда
		Результат = НСтр("ru = 'Почтовое сообщение не может содержать несколько вложений с одинаковыми именами';
						|en = 'Почтовое сообщение не может содержать несколько вложений с одинаковыми именами'");
	ИначеЕсли КодРезультата = "2001" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку истек интервал ожидания предыдущего сообщения';
						|en = 'Сообщение не будет обработано, поскольку истек интервал ожидания предыдущего сообщения'");
	ИначеЕсли КодРезультата = "2002" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку сообщение с данным порядковым номером уже было обработано';
						|en = 'Сообщение не будет обработано, поскольку сообщение с данным порядковым номером уже было обработано'");
	ИначеЕсли КодРезультата = "2003" Тогда
		Результат = НСтр("ru = 'Сообщение не будет обработано, поскольку сообщение с данным порядковым номером уже было принято и находится в очереди восстановления последовательности';
