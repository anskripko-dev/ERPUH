	Оповещение = Новый ОписаниеОповещения("ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ДополнительныеПараметрыМетода = Новый Структура;
	ДополнительныеПараметрыМетода.Вставить("ПредлагатьУстановкуВнешнейКомпоненты", Ложь);
	ДополнительныеПараметрыМетода.Вставить("ВыводитьСообщения", Ложь);
	
	КриптографияЭДКОКлиент.ПолучитьСертификаты(
		Оповещение, Новый Структура("Хранилище,ЭтоЛокальноеХранилище", "ROOT", Истина), ДополнительныеПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНеобходимыхИсправленийПослеПолученияСертификатовROOTЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	НастройкиИБ = ДополнительныеПараметры.НастройкиИБ;
	НастройкиРОКИ = ДополнительныеПараметры.НастройкиРОКИ;
	Исправления = ДополнительныеПараметры.Исправления;
	ПроверкаИФНС = ДополнительныеПараметры.ПроверкаИФНС;
	ИФНСы = ДополнительныеПараметры.ИФНСы;
	ОсновнаяИФНС = ДополнительныеПараметры.ОсновнаяИФНС;
	СведенияИзИБ = ДополнительныеПараметры.СведенияИзИБ;
	МассивСертификатовAddressBook = ДополнительныеПараметры.МассивСертификатовAddressBook;
	МассивСертификатовCA = ДополнительныеПараметры.МассивСертификатовCA;
	
	Если ПроверкаИФНС Тогда
		
		МассивСертификатовROOT = Новый Массив;
		Если Результат.Выполнено Тогда
			Для каждого СертификатХранилища Из Результат.Сертификаты Цикл
				МассивСертификатовROOT.Добавить(нрег(СокрЛП(СертификатХранилища.Отпечаток)));
			КонецЦикла;
		КонецЕсли;
		
		// проверка всех ИФНС
		Для Каждого СтрИФНС Из ИФНСы Цикл
		
			// ищем ИФНС по коду
			КодИФНС = СокрЛП(СтрИФНС.Код);
			ЗаписьИФНС = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодИФНС, "Код");
			Если ЗаписьИФНС = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьИФНС", , КодИФНС, "Налоговый орган с кодом " + КодИФНС + " не определен в информационной базе", СтрИФНС.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов инспекции ФНС в ИБ
			СертификатыИФНСсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрИФНС.Сертификаты, "Отпечаток");
			СертификатыИФНСИзИБ = ?(ЗаписьИФНС = Неопределено, Неопределено, ЗаписьИФНС.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыИФНСсРОКИ, СертификатыИФНСИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатИФНС", СертификатыИФНСИзИБ, СтрИФНС.Сертификаты, "Сертификат налогового органа с кодом " + КодИФНС + " изменен", КодИФНС);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов ИФНС в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатИФНС Из СтрИФНС.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатИФНС.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатНалоговогоОргана", , СтрСертификатИФНС, "Сертификат налогового органа с кодом " + КодИФНС + " не зарегистрирован в системе", КодИФНС);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	// проверка отделений ПФР
	ОтделенияПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("ОтделенияПФР", ОтделенияПФР) Тогда
		
		// формируем массив кодов отделений ПФР, задействованных по данным РОКИ
		МассивКодовОтделенийПФР = ВыгрузитьКолонкуИзМассиваСтруктур(ОтделенияПФР, "Код");
		
		// получаем из базы информацию об этих отделениях ПФР
		СведенияИзИБ = ПолучитьСвойстваОтделенийПФРИзИБ(МассивКодовОтделенийПФР);
		
		// перебираем отделения ПФР с РОКИ и определяем необходимость создания записи в справочнике отделений ПФР,
		// обновления списка сертификатов и регистрации их в системе
		Для Каждого СтрОтделениеПФР Из ОтделенияПФР Цикл
			
			// ищем отделение ПФР по коду
			КодОрганаПФР = СокрЛП(СтрОтделениеПФР.Код);
			ЗаписьОрганПФР = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодОрганаПФР, "Код");
			Если ЗаписьОрганПФР = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьОрганПФР", , КодОрганаПФР, "Орган СФР (бывш. ПФР) с кодом " + КодОрганаПФР + " не определен в информационной базе", СтрОтделениеПФР.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов органа ПФР в ИБ
			СертификатыОрганаПФРсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеПФР.Сертификаты, "Отпечаток");
			СертификатыОрганаПФРИзИБ = ?(ЗаписьОрганПФР = Неопределено, Неопределено, ЗаписьОрганПФР.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаПФРсРОКИ, СертификатыОрганаПФРИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатОрганаПФР", СертификатыОрганаПФРИзИБ, СтрОтделениеПФР.Сертификаты, "Сертификат органа СФР (бывш. ПФР) с кодом " + КодОрганаПФР + " изменен", КодОрганаПФР);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов ПФР для ЭДОК в ИБ
			СертификатыОрганаПФРЭДОКсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеПФР.СертификатыЭДОК, "Отпечаток");
			СертификатыОрганаПФРЭДОКИзИБ = ?(ЗаписьОрганПФР = Неопределено, Неопределено, ЗаписьОрганПФР.СертификатыЭДОК);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаПФРЭДОКсРОКИ, СертификатыОрганаПФРЭДОКИзИБ) Тогда
				ОпределитьИзменение(
					Исправления,
					"ИзменитьСертификатОрганаПФРЭДОК",
					СертификатыОрганаПФРЭДОКИзИБ,
					СтрОтделениеПФР.СертификатыЭДОК,
					НСтр("ru = 'Сертификат СФР (бывш. ПФР) для ЭДОК изменен';
						|en = 'Сертификат СФР (бывш. ПФР) для ЭДОК изменен'"),
					КодОрганаПФР);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов ПФР для ЕЦП в ИБ
			СертификатыОрганаПФРЕЦПсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеПФР.СертификатыЕЦП, "Отпечаток");
			СертификатыОрганаПФРЕЦПИзИБ = ?(ЗаписьОрганПФР = Неопределено, Неопределено, ЗаписьОрганПФР.СертификатыЕЦП);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаПФРЕЦПсРОКИ, СертификатыОрганаПФРЕЦПИзИБ) Тогда
				ОпределитьИзменение(
					Исправления,
					"ИзменитьСертификатОрганаПФРЕЦП",
					СертификатыОрганаПФРЕЦПИзИБ,
					СтрОтделениеПФР.СертификатыЕЦП,
					НСтр("ru = 'Сертификат СФР (бывш. ПФР) для ЕЦП изменен';
						|en = 'Сертификат СФР (бывш. ПФР) для ЕЦП изменен'"),
					КодОрганаПФР);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов отделения ПФР в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатОтделения Из СтрОтделениеПФР.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатОрганаПФР", , СтрСертификатОтделения, "Сертификат органа СФР (бывш. ПФР) с кодом " + КодОрганаПФР + " не зарегистрирован в системе", КодОрганаПФР);
				КонецЕсли;
				
			КонецЦикла;
			
			// проверяем на необходимость добавления сертификатов ПФР для ЭДОК в список в ИБ и регистрации в системе
			Для каждого СтрСертификатОтделения Из СтрОтделениеПФР.СертификатыЭДОК Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook",
					МассивСертификатовAddressBook) Тогда
					
					ОпределитьИзменение(
						Исправления,
						"ЗарегистрироватьСертификатОрганаПФРЭДОК",,
						СтрСертификатОтделения,
						НСтр("ru = 'Сертификат СФР (бывш. ПФР) для ЭДОК не зарегистрирован в системе';
							|en = 'Сертификат СФР (бывш. ПФР) для ЭДОК не зарегистрирован в системе'"),
						КодОрганаПФР);
				КонецЕсли;
				
			КонецЦикла;
			
			// проверяем на необходимость добавления сертификатов ПФР для ЕЦП в список в ИБ и регистрации в системе
			Для каждого СтрСертификатОтделения Из СтрОтделениеПФР.СертификатыЕЦП Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook",
					МассивСертификатовAddressBook) Тогда
					
					ОпределитьИзменение(
						Исправления,
						"ЗарегистрироватьСертификатОрганаПФРЕЦП",,
						СтрСертификатОтделения,
						НСтр("ru = 'Сертификат СФР (бывш. ПФР) для ЕЦП не зарегистрирован в системе';
							|en = 'Сертификат СФР (бывш. ПФР) для ЕЦП не зарегистрирован в системе'"),
						КодОрганаПФР);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// проверка отделений ФСГС
	ОтделенияФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("ОтделенияФСГС", ОтделенияФСГС) Тогда
		
		// формируем массив кодов отделений ФСГС, задействованных по данным РОКИ
		МассивКодовОтделенийФСГС = ВыгрузитьКолонкуИзМассиваСтруктур(ОтделенияФСГС, "Код");
		
		// получаем из базы информацию об этих отделениях ФСГС
		СведенияИзИБ = ПолучитьСвойстваОтделенийФСГСИзИБ(МассивКодовОтделенийФСГС);
		
		// перебираем отделения ФСГС с РОКИ и определяем необходимость создания записи в справочнике отделений ФСГС,
		// обновления списка сертификатов и регистрации их в системе
		Для Каждого СтрОтделениеФСГС Из ОтделенияФСГС Цикл
			
			// ищем отделение ФСГС по коду
			КодОрганаФСГС = СокрЛП(СтрОтделениеФСГС.Код);
			ЗаписьОрганФСГС = НайтиСтрокуВМассивеСтруктурКлиент(СведенияИзИБ, КодОрганаФСГС, "Код");
			Если ЗаписьОрганФСГС = Неопределено Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьОрганФСГС", , КодОрганаФСГС, "Орган ФСГС с кодом " + КодОрганаФСГС + " не определен в информационной базе", СтрОтделениеФСГС.Наименование);
			КонецЕсли;
			
			// проверяем на необходимость изменения списка сертификатов органа ФСГС в ИБ
			СертификатыОрганаФСГСсРОКИ = ВыгрузитьКолонкуИзМассиваСтруктур(СтрОтделениеФСГС.Сертификаты, "Отпечаток");
			СертификатыОрганаФСГСИзИБ = ?(ЗаписьОрганФСГС = Неопределено, Неопределено, ЗаписьОрганФСГС.Сертификаты);
			Если НЕ СравнитьМассивыБезУчетаПорядкаЭлементов(СертификатыОрганаФСГСсРОКИ, СертификатыОрганаФСГСИзИБ) Тогда
				ОпределитьИзменение(Исправления, "ИзменитьСертификатОрганаФСГС", СертификатыОрганаФСГСИзИБ, СтрОтделениеФСГС.Сертификаты, "Сертификат органа ФСГС с кодом " + КодОрганаФСГС + " изменен", КодОрганаФСГС);
			КонецЕсли;
			
			// проверяем на необходимость добавления сертификатов отделения ФСГС в список в ИБ и регистрации в системе
			Для Каждого СтрСертификатОтделения Из СтрОтделениеФСГС.Сертификаты Цикл
				
				// проверяем на необходимость регистрации в системе
				Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатОтделения.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
					ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатОрганаФСГС", , СтрСертификатОтделения, "Сертификат органа ФСГС с кодом " + КодОрганаФСГС + " не зарегистрирован в системе", КодОрганаФСГС);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// уточнение организации для настроек ФСС, ФСРАР, РПН, ФТС
	НастройкиИБОрганизация = НастройкиИБ.Организация;
	Если (НастройкиРОКИ.Свойство("ФССИспользуется") И НастройкиРОКИ.ФССИспользуется
		ИЛИ НастройкиРОКИ.Свойство("ФСРАРИспользуется") И НастройкиРОКИ.ФСРАРИспользуется
		ИЛИ НастройкиРОКИ.Свойство("РПНИспользуется") И НастройкиРОКИ.РПНИспользуется
		ИЛИ НастройкиРОКИ.Свойство("ФТСИспользуется") И НастройкиРОКИ.ФТСИспользуется) Тогда
		
		Если ТипЗнч(НастройкиИБОрганизация) = Тип("Структура") И НастройкиИБОрганизация.Свойство("ИНН")
			И НастройкиИБОрганизация.Свойство("КПП") Тогда
			
			НастройкиИБОрганизация = ОпределитьОрганизациюПоИННиКППНаСервере(НастройкиИБОрганизация.ИНН,
				НастройкиИБОрганизация.КПП, Истина);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкиИБОрганизация) И ЗначениеЗаполнено(НастройкиИБ.УчетнаяЗапись) Тогда
			НастройкиИБОрганизация = ОпределитьОрганизациюПоУчетнойЗаписи(НастройкиИБ.УчетнаяЗапись);
		КонецЕсли;
	КонецЕсли;
	
	// проверка настроек ФСС
	Если НастройкиРОКИ.Свойство("ФССИспользуется") И НастройкиРОКИ.ФССИспользуется
		И ЗначениеЗаполнено(НастройкиИБОрганизация) Тогда
		
		// получаем из базы информацию настройках обмена с ФСС
		СведенияИзИБ = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(НастройкиИБОрганизация);
		СертификатФССИзИБ = ?(СведенияИзИБ = Неопределено, Неопределено, СведенияИзИБ.СертификатФССОтпечаток);
		СертификатФССЭЛНИзИБ = ?(СведенияИзИБ = Неопределено, Неопределено, СведенияИзИБ.СертификатФССЭЛНОтпечаток);
		ТестовыйСерверФССЭЛНИзИБ = ?(СведенияИзИБ = Неопределено, Неопределено, СведенияИзИБ.ТестовыйСерверФССЭЛН);
		СертификатФССсРОКИ = ?(НастройкиРОКИ.Свойство("СертификатФСС"), НастройкиРОКИ.СертификатФСС, Неопределено);
		СертификатФССЭЛНсРОКИ = ?(НастройкиРОКИ.Свойство("СертификатФССЭЛН"), НастройкиРОКИ.СертификатФССЭЛН, Неопределено);
		
		Если СведенияИзИБ = Неопределено Тогда
			ОпределитьИзменение(
				Исправления,
				"ЗарегистрироватьНаправлениеФСС",,,
				НСтр("ru = 'Обмен с СФР (бывш. ФСС) не включен в информационной базе';
					|en = 'Обмен с СФР (бывш. ФСС) не включен в информационной базе'"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СертификатФССсРОКИ) И СертификатФССсРОКИ <> СертификатФССИзИБ Тогда
			ОпределитьИзменение(
				Исправления,
				"ИзменитьСертификатФСС",
				СертификатФССИзИБ,
				СертификатФССсРОКИ,
				НСтр("ru = 'Сертификат СФР (бывш. ФСС) изменен';
					|en = 'Сертификат СФР (бывш. ФСС) изменен'"));
			
			Если НЕ СертификатЗарегистрированВХранилище(СертификатФССсРОКИ.Отпечаток, "AddressBook",
				МассивСертификатовAddressBook) Тогда
				
				ОпределитьИзменение(
					Исправления,
					"ЗарегистрироватьСертификатФСС",,
					СертификатФССсРОКИ,
					НСтр("ru = 'Сертификат СФР (бывш. ФСС) не зарегистрирован в системе';
						|en = 'Сертификат СФР (бывш. ФСС) не зарегистрирован в системе'"));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СертификатФССЭЛНсРОКИ) И СертификатФССЭЛНсРОКИ <> СертификатФССЭЛНИзИБ
			И (ТестовыйСерверФССЭЛНИзИБ <> Истина ИЛИ НЕ ЗначениеЗаполнено(СертификатФССЭЛНИзИБ)) Тогда
			ОпределитьИзменение(
				Исправления,
				"ИзменитьСертификатФССЭЛН",
				СертификатФССЭЛНИзИБ,
				СертификатФССЭЛНсРОКИ,
				НСтр("ru = 'Сертификат СФР (бывш. ФСС) ЭЛН, ПОВЭД, ССВ, СЭДО изменен';
					|en = 'Сертификат СФР (бывш. ФСС) ЭЛН, ПОВЭД, ССВ, СЭДО изменен'"));
			
			Если НЕ СертификатЗарегистрированВХранилище(СертификатФССЭЛНсРОКИ.Отпечаток, "AddressBook",
				МассивСертификатовAddressBook) Тогда
				
				ОпределитьИзменение(
					Исправления,
					"ЗарегистрироватьСертификатФССЭЛН",,
					СертификатФССЭЛНсРОКИ,
					НСтр("ru = 'Сертификат СФР (бывш. ФСС) ЭЛН, ПОВЭД, ССВ, СЭДО не зарегистрирован в системе';
						|en = 'Сертификат СФР (бывш. ФСС) ЭЛН, ПОВЭД, ССВ, СЭДО не зарегистрирован в системе'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка настроек ФСРАР
	Если НастройкиРОКИ.Свойство("ФСРАРИспользуется") И НастройкиРОКИ.ФСРАРИспользуется
		И ЗначениеЗаполнено(НастройкиИБОрганизация) Тогда
		
		// получаем из базы информацию настройках обмена с ФСРАР
		СведенияИзИБ = НастройкиФСРАРНаСервере(НастройкиИБОрганизация);
		КодРегионаФСРАРИзИБ = ?(СведенияИзИБ.ИспользоватьОбмен, СведенияИзИБ.КодРегиона, Неопределено);
		СертификатФСРАРИзИБ = ?(СведенияИзИБ.ИспользоватьОбмен, СведенияИзИБ.СертификатФСРАРОтпечаток, Неопределено);
		СертификатФСРАРСубъектаРФИзИБ = ?(СведенияИзИБ.ИспользоватьОбмен, СведенияИзИБ.СертификатСубъектаРФОтпечаток, Неопределено);
		КодРегионаФСРАРсРОКИ = ?(НастройкиРОКИ.Свойство("КодРегионаФСРАР"), НастройкиРОКИ.КодРегионаФСРАР, Неопределено);
		СертификатФСРАРсРОКИ = ?(НастройкиРОКИ.Свойство("СертификатФСРАР"), НастройкиРОКИ.СертификатФСРАР, Неопределено);
		СертификатФСРАРСубъектаРФсРОКИ = ?(НастройкиРОКИ.Свойство("СертификатФСРАРСубъектаРФ"), НастройкиРОКИ.СертификатФСРАРСубъектаРФ, Неопределено);
		
		Если НЕ СведенияИзИБ.ИспользоватьОбмен Тогда
			ОпределитьИзменение(
				Исправления,
				"ЗарегистрироватьНаправлениеФСРАР",,,
				НСтр("ru = 'Обмен с Росалкогольтабакконтролем не включен в информационной базе';
					|en = 'Обмен с Росалкогольтабакконтролем не включен в информационной базе'"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодРегионаФСРАРсРОКИ) И КодРегионаФСРАРсРОКИ <> КодРегионаФСРАРИзИБ Тогда
			ОпределитьИзменение(
				Исправления,
				"ИзменитьКодРегионаФСРАР",
				КодРегионаФСРАРИзИБ,
				КодРегионаФСРАРсРОКИ,
				НСтр("ru = 'Код региона Росалкогольтабакконтроля изменен';
					|en = 'Код региона Росалкогольтабакконтроля изменен'"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СертификатФСРАРсРОКИ) И СертификатФСРАРсРОКИ <> СертификатФСРАРИзИБ Тогда
			ОпределитьИзменение(
				Исправления,
				"ИзменитьСертификатФСРАР",
				СертификатФСРАРИзИБ,
				СертификатФСРАРсРОКИ,
				НСтр("ru = 'Сертификат Росалкогольтабакконтроля изменен';
					|en = 'Сертификат Росалкогольтабакконтроля изменен'"));
			
			Если НЕ СертификатЗарегистрированВХранилище(СертификатФСРАРсРОКИ.Отпечаток, "AddressBook",
				МассивСертификатовAddressBook) Тогда
				
				ОпределитьИзменение(
					Исправления,
					"ЗарегистрироватьСертификатФСРАР",,
					СертификатФСРАРсРОКИ,
					НСтр("ru = 'Сертификат Росалкогольтабакконтроля не зарегистрирован в системе';
						|en = 'Сертификат Росалкогольтабакконтроля не зарегистрирован в системе'"));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СертификатФСРАРСубъектаРФсРОКИ)
			И СертификатФСРАРСубъектаРФсРОКИ <> СертификатФСРАРСубъектаРФИзИБ Тогда
			
			ОпределитьИзменение(
				Исправления,
				"ИзменитьСертификатФСРАРСубъектаРФ",
				СертификатФСРАРСубъектаРФИзИБ,
				СертификатФСРАРСубъектаРФсРОКИ,
				НСтр("ru = 'Сертификат субъекта РФ Росалкогольтабакконтроля изменен';
					|en = 'Сертификат субъекта РФ Росалкогольтабакконтроля изменен'"));
			
			Если НЕ СертификатЗарегистрированВХранилище(СертификатФСРАРСубъектаРФсРОКИ.Отпечаток, "AddressBook",
				МассивСертификатовAddressBook) Тогда
				
				ОпределитьИзменение(
					Исправления,
					"ЗарегистрироватьСертификатФСРАРСубъектаРФ",,
					СертификатФСРАРСубъектаРФсРОКИ,
					НСтр("ru = 'Сертификат субъекта РФ Росалкогольтабакконтроля не зарегистрирован в системе';
						|en = 'Сертификат субъекта РФ Росалкогольтабакконтроля не зарегистрирован в системе'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка настроек РПН
	Если НастройкиРОКИ.Свойство("РПНИспользуется") И НастройкиРОКИ.РПНИспользуется
		И ЗначениеЗаполнено(НастройкиИБОрганизация) Тогда
		
		// получаем из базы информацию настройках обмена с РПН
		СведенияИзИБ = НастройкиРПННаСервере(НастройкиИБОрганизация);
		СертификатРПНИзИБ = ?(СведенияИзИБ.ИспользоватьОбмен, СведенияИзИБ.СертификатРПНОтпечаток, Неопределено);
		СертификатРПНсРОКИ = ?(НастройкиРОКИ.Свойство("СертификатРПН"), НастройкиРОКИ.СертификатРПН, Неопределено);
		
		Если НЕ СведенияИзИБ.ИспользоватьОбмен Тогда
			ОпределитьИзменение(
				Исправления,
				"ЗарегистрироватьНаправлениеРПН",,,
				НСтр("ru = 'Обмен с Росприроднадзором не включен в информационной базе';
					|en = 'Обмен с Росприроднадзором не включен в информационной базе'"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СертификатРПНсРОКИ) И СертификатРПНсРОКИ <> СертификатРПНИзИБ Тогда
			ОпределитьИзменение(
				Исправления,
				"ИзменитьСертификатРПН",
				СертификатРПНИзИБ,
				СертификатРПНсРОКИ,
				НСтр("ru = 'Сертификат Росприроднадзора изменен';
					|en = 'Сертификат Росприроднадзора изменен'"));
			
			Если НЕ СертификатЗарегистрированВХранилище(СертификатРПНсРОКИ.Отпечаток, "AddressBook",
				МассивСертификатовAddressBook) Тогда
				
				ОпределитьИзменение(
					Исправления,
					"ЗарегистрироватьСертификатРПН",,
					СертификатРПНсРОКИ,
					НСтр("ru = 'Сертификат Росприроднадзора не зарегистрирован в системе';
						|en = 'Сертификат Росприроднадзора не зарегистрирован в системе'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка настроек ФТС
	Если НастройкиРОКИ.Свойство("ФТСИспользуется") И НастройкиРОКИ.ФТСИспользуется
		И ЗначениеЗаполнено(НастройкиИБОрганизация) Тогда
		
		// получаем из базы информацию настройках обмена с ФТС
		СведенияИзИБ = НастройкиФТСНаСервере(НастройкиИБОрганизация);
		
		Если НЕ СведенияИзИБ.ИспользоватьОбмен Тогда
			ОпределитьИзменение(
				Исправления,
				"ЗарегистрироватьНаправлениеФТС",,,
				НСтр("ru = 'Обмен с ФТС не включен в информационной базе';
					|en = 'Обмен с ФТС не включен в информационной базе'"));
		КонецЕсли;
		
	КонецЕсли;
	
	// проверка на необходимость регистрации сертификата СОС
	Если НастройкиРОКИ.Свойство("СертификатСОС") И НЕ СертификатЗарегистрированВХранилище(НастройкиРОКИ.СертификатСОС.Отпечаток, "AddressBook", МассивСертификатовAddressBook) Тогда
		ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатСОС", , НастройкиРОКИ.СертификатСОС, "Сертификат оператора электронного документооборота не зарегистрирован в системе");
	КонецЕсли;
	
	// проверка на необходимость регистрации корневых сертификатов ГНИВЦ
	СертификатыКорневыеГНИВЦ = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеГНИВЦ", СертификатыКорневыеГНИВЦ) Тогда
		Для каждого СтрСертификатКорневойГНИВЦ Из СертификатыКорневыеГНИВЦ Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКорневойГНИВЦ.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойГНИВЦ", , СтрСертификатКорневойГНИВЦ, "Корневой сертификат ГНИВЦ не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка на необходимость регистрации корневых сертификатов Такском
	СертификатыКорневыеТакском = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеТакском", СертификатыКорневыеТакском) Тогда
		Для каждого СтрСертификатКорневойТакском Из СертификатыКорневыеТакском Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКорневойТакском.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойТакском", , СтрСертификатКорневойТакском, "Корневой сертификат оператора электронного документооборота не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка на необходимость регистрации кросс-сертификатов Такском
	СертификатыКРОСС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОСС", СертификатыКРОСС) Тогда
		Для каждого СтрСертификатКРОСС Из СертификатыКРОСС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрСертификатКРОСС.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКроссГНИВЦ", , СтрСертификатКРОСС, "Кросс-сертификат электронного документооборота не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации корневых сертификатов ПФР
	СертификатыКорневыеПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеПФР", СертификатыКорневыеПФР) Тогда
		Для Каждого СтрКорневойСертификатПФР Из СертификатыКорневыеПФР Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКорневойСертификатПФР.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойПФР", , СтрКорневойСертификатПФР, "Корневой сертификат, используемый при обмене с СФР (бывш. ПФР), не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации кросс-сертификатов ПФР
	СертификатыКроссПФР = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОССПФР", СертификатыКроссПФР) Тогда
		Для Каждого СтрКроссСертификатПФР Из СертификатыКроссПФР Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКроссСертификатПФР.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКРОССПФР", , СтрКроссСертификатПФР, "Кросс-сертификат, используемый при обмене с СФР (бывш. ПФР), не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// проверка не необходимость регистрации корневых сертификатов ФСГС
	СертификатыКорневыеФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКорневыеФСГС", СертификатыКорневыеФСГС) Тогда
		Для Каждого СтрКорневойСертификатФСГС Из СертификатыКорневыеФСГС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКорневойСертификатФСГС.Отпечаток, "ROOT", МассивСертификатовROOT) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКорневойФСГС", , СтрКорневойСертификатФСГС, "Корневой сертификат, используемый при обмене с Росстатом, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверка не необходимость регистрации кросс-сертификатов ФСГС
	СертификатыКроссФСГС = Неопределено;
	Если НастройкиРОКИ.Свойство("СертификатыКРОССФСГС", СертификатыКроссФСГС) Тогда
		Для Каждого СтрКроссСертификатФСГС Из СертификатыКроссФСГС Цикл
			Если НЕ СертификатЗарегистрированВХранилище(СтрКроссСертификатФСГС.Отпечаток, "CA", МассивСертификатовCA) Тогда
				ОпределитьИзменение(Исправления, "ЗарегистрироватьСертификатКРОССФСГС", , СтрКроссСертификатФСГС, "Кросс-сертификат, используемый при обмене с Росстатом, не зарегистрирован в системе");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// возвращаем таблицу-результат
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Исправления);
	
КонецПроцедуры

&НаСервере
Функция СформироватьСписокНастроекРОКИПоДеревуНастроекXML(ДеревоНастроекАдрес, Сообщения)
	
	ДеревоНастроек = ПолучитьИзВременногоХранилища(ДеревоНастроекАдрес);
	Результат = Новый Структура;
	
	// позиционируемся на сведениях об абоненте
	УзелRegistrationFile = НайтиПодчиненныйУзел(ДеревоНастроек, "RegistrationFile");
	Если УзелRegistrationFile = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Некорректная структура файла настроек!'"));
		Возврат Результат;
	КонецЕсли;
	
	УзелRegistration = НайтиПодчиненныйУзел(УзелRegistrationFile, "Registration");
	Если УзелRegistration = Неопределено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректная структура файла настроек!';
											|en = 'Некорректная структура файла настроек!'"));
		Возврат Результат;
	КонецЕсли;
	
	УзелOperator = НайтиПодчиненныйУзел(УзелRegistration, "Operator");
	Если УзелOperator <> Неопределено Тогда
