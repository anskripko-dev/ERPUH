&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSig(
		СертификатАбонента,
		ПодписанныйФайл,
		ВыполняемоеОповещение,
		ЗаписыватьОшибкиВЖурналРегистрации = Ложь,
		УдалятьЛишниеАтрибуты = Ложь,
		ИспользоватьПреобразованиеККаноническомуXML = Ложь) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатАбонента);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СертификатАбонента", 					СертификатАбонента);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗаписыватьОшибкиВЖурналРегистрации", 	ЗаписыватьОшибкиВЖурналРегистрации);
	ДополнительныеПараметры.Вставить("УдалятьЛишниеАтрибуты", 				УдалятьЛишниеАтрибуты);
	ДополнительныеПараметры.Вставить("ИспользоватьПреобразованиеККаноническомуXML", ИспользоватьПреобразованиеККаноническомуXML);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЧтенияПодписанногоФайла",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ПодписанныйФайл);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПодписанныйФайл);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЧтенияПодписанногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗаписыватьОшибкиВЖурналРегистрации 	= ДополнительныеПараметры.ЗаписыватьОшибкиВЖурналРегистрации;
	УдалятьЛишниеАтрибуты 				= ДополнительныеПараметры.УдалятьЛишниеАтрибуты;
	ИспользоватьПреобразованиеККаноническомуXML =
		ДополнительныеПараметры.ИспользоватьПреобразованиеККаноническомуXML;

	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	XMLDSigВBase64 = Результат.СтрокаBase64;
	
	// разобрать XMLDSig
	
	ИнформацияXMLDSig = РазобратьXMLDSigНаСервере(
		XMLDSigВBase64,
		ЗаписыватьОшибкиВЖурналРегистрации,
		УдалятьЛишниеАтрибуты,
		ИспользоватьПреобразованиеККаноническомуXML);
		
	Если ИнформацияXMLDSig = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ИнформацияXMLDSig", ИнформацияXMLDSig);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойИнформацииОбОбъекте",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64, ".xml");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойИнформацииОбОбъекте(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКанонизированнойИнформацииОбОбъекте = Результат.ИмяФайла;
	
	// проверить хеш
	
	ИспользоватьСертификатАбонентаДляВычисленияХеша = Ложь;
	ДополнительныеПараметры.Вставить("ИспользоватьСертификатАбонентаДляВычисленияХеша",
		ИспользоватьСертификатАбонентаДляВычисленияХеша);
	ДополнительныеПараметры.Вставить("ИмяФайлаКанонизированнойИнформацииОбОбъекте",
		ИмяФайлаКанонизированнойИнформацииОбОбъекте);
	
	Оповещение = Новый ОписаниеОповещения(
		"ПроверитьПодписьФайлаXMLDSigПослеПодписанияКанонизированнойИнформацииОбОбъекте",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) И ИспользоватьСертификатАбонентаДляВычисленияХеша Тогда
		ИмяФайлаПодписиДляИзвлеченияХеша = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			Оповещение,
			СертификатАбонента,
			ИмяФайлаКанонизированнойИнформацииОбОбъекте,
			Ложь,
			ИмяФайлаПодписиДляИзвлеченияХеша,,,,
			"*");
		
	Иначе
		СертификатПодписанта = Новый Структура("Сертификат", ИнформацияXMLDSig.СертификатПодписантаВBase64);
		
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			МестоХраненияКлюча,
			ИмяФайлаКанонизированнойИнформацииОбОбъекте,,
			Ложь,,
			СертификатПодписанта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеПодписанияКанонизированнойИнформацииОбОбъекте(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ЛокальнаяПодпись = ЭтоЛокальнаяПодпись(МестоХраненияКлюча);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	ИмяФайлаКанонизированнойИнформацииОбОбъекте = ДополнительныеПараметры.ИмяФайлаКанонизированнойИнформацииОбОбъекте;
	ИспользоватьСертификатАбонентаДляВычисленияХеша =
		ДополнительныеПараметры.ИспользоватьСертификатАбонентаДляВычисленияХеша;
		
	Если ЛокальнаяПодпись Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаКанонизированнойИнформацииОбОбъекте);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЛокальнаяПодпись Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("Алгоритм") И ЗначениеЗаполнено(Результат.Алгоритм) Тогда
		Алгоритм = Результат.Алгоритм;
		
	Иначе
		Алгоритм = АлгоритмСертификата(ИнформацияXMLDSig.СертификатПодписантаВBase64, МестоХраненияКлюча, ЛокальнаяПодпись);
	КонецЕсли;
	ДополнительныеПараметры.Вставить("Алгоритм", Алгоритм);
	
	ЭтоШестнадцатеричноеПредставлениеХеша = ЛокальнаяПодпись ИЛИ НЕ ИспользоватьСертификатАбонентаДляВычисленияХеша;
	
	ПодписьДляИзвлеченияХешаВBase64 = ?(НЕ ЭтоШестнадцатеричноеПредставлениеХеша, Результат.ФайлПодписи, Результат.Хеш);
	
	Если НЕ ЭтоШестнадцатеричноеПредставлениеХеша Тогда
		ХешСтрокаВBase64 = ХешСтрокаВBase64КанонизированногоФайлаXMLИзПодписиНаСервере(
			Неопределено,
			ПодписьДляИзвлеченияХешаВBase64,
			ИнформацияXMLDSig,
			Истина,
			ДополнительныеПараметры.Алгоритм).ХешСтрокаВBase64;
			
	Иначе
		ХешСтрокаВBase64 = СтрокаВШестнадцатеричномПредставленииВBase64НаСервере(ПодписьДляИзвлеченияХешаВBase64);
		
	КонецЕсли;
	
	Если ХешСтрокаВBase64 <> ИнформацияXMLDSig.ХешВBase64 Тогда
		Если НЕ ЛокальнаяПодпись Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЛокальнаяПодпись Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.СертификатПодписантаВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.СертификатПодписантаВBase64, ".cer");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаСертификатаПодписанта = Результат.ИмяФайла;
	
	// зарегистрировать сертификат подписанта
	
	ДополнительныеПараметры.Вставить("ИмяФайлаСертификатаПодписанта", ИмяФайлаСертификатаПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеИмпортаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	ЗарегистрироватьСертификатВСистемеНачало(Оповещение, МестоХраненияКлюча, ИмяФайлаСертификатаПодписанта, "AddressBook");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеИмпортаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	ИмяФайлаСертификатаПодписанта = ДополнительныеПараметры.ИмяФайлаСертификатаПодписанта;
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаСертификатаПодписанта);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.СертификатПодписантаВBase64,
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ОтпечатокСертификатаПодписанта = Результат.Отпечаток;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ИнформацияXMLDSig.СертификатПодписантаВBase64);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ОтпечатокСертификатаПодписанта", ОтпечатокСертификатаПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеПоискаСертификатаПодписанта",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СвойстваСертификатаПодписанта = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечатокСертификатаПодписанта, "AddressBook");
		Иначе
			СвойстваСертификатаПодписанта = ПолучитьСвойстваОблачногоСертификата(ОтпечатокСертификатаПодписанта, "AddressBook", Истина);
		КонецЕсли;
		Если СвойстваСертификатаПодписанта <> Неопределено Тогда
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СвойстваСертификатаПодписанта);
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				РезультатПроверки = ПроверитьСертификатНаСервере(СвойстваСертификатаПодписанта, МестоХраненияКлюча);
			Иначе
				РезультатПроверки = СвойстваСертификатаПодписанта.Валиден;
			КонецЕсли;
			СвойстваСертификатаПодписанта.Вставить("Валиден", РезультатПроверки = Истина);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, СвойстваСертификатаПодписанта <> Неопределено, СвойстваСертификатаПодписанта);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечатокСертификатаПодписанта, "AddressBook", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеПоискаСертификатаПодписанта(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗаписыватьОшибкиВЖурналРегистрации 	= ДополнительныеПараметры.ЗаписыватьОшибкиВЖурналРегистрации;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig 					= ДополнительныеПараметры.ИнформацияXMLDSig;
	ОтпечатокСертификатаПодписанта 		= ДополнительныеПараметры.ОтпечатокСертификатаПодписанта;
	
	Если НЕ Результат.Выполнено ИЛИ НЕ Результат.СертификатНайден ИЛИ НЕ Результат.СвойстваСертификата.Валиден Тогда
		Если Результат.Выполнено И НЕ Результат.СертификатНайден Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось найти сертификат подписанта с отпечатком %1 для проверкии валидности электронной подписи.';
								|en = 'Не удалось найти сертификат подписанта с отпечатком %1 для проверкии валидности электронной подписи.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, ОтпечатокСертификатаПодписанта);
			Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
				ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig';
						|en = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig'"),
					"Ошибка",
					ТекстОшибки,,
					Истина);
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
		ИначеЕсли Результат.Выполнено И НЕ Результат.СвойстваСертификата.Валиден Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось проверить подпись по причине невалидности сертификата ""%1"".';
								|en = 'Не удалось проверить подпись по причине невалидности сертификата ""%1"".'");
			ПредставлениеСертификатаПодписанта = ПредставлениеСертификатаПоСвойствам(Результат.СвойстваСертификата);
			ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеСертификатаПодписанта);
			Если ЗаписыватьОшибкиВЖурналРегистрации Тогда
				ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig';
						|en = 'Электронный документооборот с контролирующими органами. Проверка подписи XMLDSig'"),
					"Ошибка",
					ТекстОшибки,,
					Истина);
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПодписанта = Результат.СвойстваСертификата;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатПодписанта);
	
	ДополнительныеПараметры.Вставить("СертификатПодписанта", СертификатПодписанта);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойПодписываемойИнформации",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаКанонизированнойПодписываемойИнформации(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча	= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКанонизированнойПодписываемойИнформации = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ИмяФайлаКанонизированнойПодписываемойИнформации", ИмяФайлаКанонизированнойПодписываемойИнформации);
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаПодписи", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ИнформацияXMLDSig.ПодписьВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ИнформацияXMLDSig.ПодписьВBase64);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеЗаписиФайлаПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	ИмяФайлаКанонизированнойПодписываемойИнформации = ДополнительныеПараметры.ИмяФайлаКанонизированнойПодписываемойИнформации;
	
	Если НЕ Результат.Выполнено Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			УдалитьАдресаИзВременногоХранилища(
				ИнформацияXMLDSig.ПодписьВBase64,
				ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
		Иначе
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаКанонизированнойПодписываемойИнформации);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаПодписи = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьПодписьФайлаXMLDSigПослеПроверкиПодписи", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ПроверитьПодпись(
		Оповещение,
		СертификатПодписанта,
		ИмяФайлаПодписи,
		ИмяФайлаКанонизированнойПодписываемойИнформации,,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписьФайлаXMLDSigПослеПроверкиПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИнформацияXMLDSig = ДополнительныеПараметры.ИнформацияXMLDSig;
	ИмяФайлаКанонизированнойПодписываемойИнформации = ДополнительныеПараметры.ИмяФайлаКанонизированнойПодписываемойИнформации;
	ИмяФайлаПодписи = ДополнительныеПараметры.ИмяФайлаПодписи;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьАдресаИзВременногоХранилища(
			ИнформацияXMLDSig.ПодписьВBase64,
			ИнформацияXMLDSig.КанонизированныйУзелПодписываемаяИнформацияXMLВBase64);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаКанонизированнойПодписываемойИнформации);
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаПодписи);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПодписьВалидна = Результат.ПодписьВалидна;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РазобратьXMLDSigНаСервере(XMLDSigВBase64,
		ЗаписыватьОшибкиВЖурналРегистрации = Ложь,
		УдалятьЛишниеАтрибуты = Ложь,
		ИспользоватьПреобразованиеККаноническомуXML = Ложь)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.РазобратьXMLDSig(
		XMLDSigВBase64,
		ЗаписыватьОшибкиВЖурналРегистрации,
		УдалятьЛишниеАтрибуты,
		ИспользоватьПреобразованиеККаноническомуXML);
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьАдресаИзВременногоХранилища(
		Адрес1ИлиМассив,
		Адрес2 = Неопределено,
		Адрес3 = Неопределено,
		Адрес4 = Неопределено,
		Адрес5 = Неопределено,
		Адрес6 = Неопределено,
		Адрес7 = Неопределено,
		Адрес8 = Неопределено,
		Адрес9 = Неопределено,
		Адрес10 = Неопределено)
	
	Если ЗначениеЗаполнено(Адрес1ИлиМассив) И ТипЗнч(Адрес1ИлиМассив) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес1ИлиМассив);
		
	ИначеЕсли ЗначениеЗаполнено(Адрес1ИлиМассив) И (ТипЗнч(Адрес1ИлиМассив) = Тип("Массив")
		ИЛИ ТипЗнч(Адрес1ИлиМассив) = Тип("ФиксированныйМассив")) Тогда
		
		Для каждого ЭлементМассиваАдресов Из Адрес1ИлиМассив Цикл
			УдалитьИзВременногоХранилища(ЭлементМассиваАдресов);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес2) И ТипЗнч(Адрес2) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес2);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес3) И ТипЗнч(Адрес3) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес3);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес4) И ТипЗнч(Адрес4) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес4);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес5) И ТипЗнч(Адрес5) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес5);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес6) И ТипЗнч(Адрес6) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес6);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес7) И ТипЗнч(Адрес7) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес7);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес8) И ТипЗнч(Адрес8) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес8);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес9) И ТипЗнч(Адрес9) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес9);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Адрес10) И ТипЗнч(Адрес10) = Тип("Строка") Тогда
		УдалитьИзВременногоХранилища(Адрес10);
	КонецЕсли;
	
КонецПроцедуры

// Блок для пакетной обработки файлов для подписи
// На вход поступает готовый файл для подписи
// 
// Результат массив адресов из временного хранилища с подписанных файлов
//
// готовить файл для подписи (подстановки и трансформация
// Параметры:
//	ФайлыДанных - массив адресов временного хранилища
//

&НаКлиенте
Процедура ПодписатьФайлыXMLDSig(
		СертификатПодписанта,
		ФайлыДанных,
		ВыполняемоеОповещение,
		Кодировка = Неопределено,
		НастройкиПодписи = Неопределено) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СертификатПодписанта);
	ДанныеДляПодписи = Новый Массив;
	
	Для Каждого СтрокаМассива Из ФайлыДанных Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("ХешЗначениеКлюча", Неопределено);
		НоваяСтрока.Вставить("ХешЗначениеСодержимого", Неопределено);
		НоваяСтрока.Вставить("Подпись", Неопределено);
		НоваяСтрока.Вставить("Результат", Неопределено);
		НоваяСтрока.Вставить("КанонизированныйУзелИнформацияОбОбъектеXML", Неопределено);
		НоваяСтрока.Вставить("КанонизированныйУзелПодпись", Неопределено);
		НоваяСтрока.Вставить("КанонизированныйФайлXML", Неопределено);
		НоваяСтрока.Вставить("КанонизированныйКлюч", Неопределено);
		НоваяСтрока.Вставить("СодержимогоПодготовленногоФайлаXML", Неопределено);
		НоваяСтрока.Вставить("КанонизированныеДанные", Неопределено);
		НоваяСтрока.Вставить("ВозвращатьАдресВоВременномХранилище", Ложь);
		
		Если ЭтоАдресВременногоХранилища(СтрокаМассива) Тогда
			НоваяСтрока.Вставить("ВозвращатьАдресВоВременномХранилище", Истина);
			НоваяСтрока.Вставить("АдресДанных", СтрокаМассива);
		Иначе
			ДанныеФайла = Base64Значение(СтрокаМассива);
			НоваяСтрока.Вставить("АдресДанных", ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор));
		КонецЕсли;
		
		ДанныеДляПодписи.Добавить(НоваяСтрока);
	КонецЦикла;	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ФайлыДанных", ДанныеДляПодписи);
	ДополнительныеПараметры.Вставить("СертификатПодписанта", СертификатПодписанта);
	ДополнительныеПараметры.Вставить("Кодировка", Кодировка);
	ДополнительныеПараметры.Вставить("НастройкиПодписи", НастройкиПодписи);
	ДополнительныеПараметры.Вставить("ВсегоФайлов",	ФайлыДанных.Количество());
	ДополнительныеПараметры.Вставить("ИндексФайл", 0);
	ДополнительныеПараметры.Вставить("Трансформация1_1", СвойствоСтруктуры(НастройкиПодписи, "Трансформация1_1", Ложь));
	ДополнительныеПараметры.Вставить("ВключатьХэшСертификата", СвойствоСтруктуры(НастройкиПодписи, "ВключатьХэшСертификата", Ложь));
	ДополнительныеПараметры.Вставить("ДанныеВнутриПодписи", СвойствоСтруктуры(НастройкиПодписи, "ДанныеВнутриПодписи", Ложь));
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибуты", СвойствоСтруктуры(НастройкиПодписи, "ДобавляемыеАтрибуты", Ложь));
	ДополнительныеПараметры.Вставить("НеВключатьИнформациюОСертификате", СвойствоСтруктуры(НастройкиПодписи, "НеВключатьИнформациюОСертификате", Ложь));
	ДополнительныеПараметры.Вставить("Алгоритм", СвойствоСтруктуры(НастройкиПодписи, "Алгоритм", ""));
	ДополнительныеПараметры.Вставить("ИдентификаторыПодписываемыхДанных", СвойствоСтруктуры(НастройкиПодписи, "ИдентификаторыПодписываемыхДанных", Новый Массив));
	ДанныеОблачнойПодписи = СвойствоСтруктуры(НастройкиПодписи, "ДанныеОблачнойПодписи", Новый Структура);
	Если ДанныеОблачнойПодписи = Неопределено Тогда
		ПодготовитьОблачнуюПодпись("Список файлов", ".xml", Истина, ДополнительныеПараметры);
	Иначе
		ДополнительныеПараметры.Вставить("ДанныеОблачнойПодписи", ДанныеОблачнойПодписи);
	КонецЕсли;
		
	ХэшВсегдаГОСТ2012 = ДополнительныеПараметры.Трансформация1_1 И ДополнительныеПараметры.ВключатьХэшСертификата;
	ДополнительныеПараметры.Вставить("ХэшВсегдаГОСТ2012", ХэшВсегдаГОСТ2012);
	ДополнительныеПараметры.Вставить("СертификатПолучателяВBase64", "");
	ДополнительныеПараметры.Вставить("ИдентификаторНайденногоАлгоритма", Неопределено);
	ДополнительныеПараметры.Вставить("ПакетнаяПодпись", ЭтоОблачнаяПодпись(МестоХраненияКлюча));
	
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigПослеОпределенияАлгоритма", ЭтотОбъект, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДополнительныеПараметры.Алгоритм) Тогда
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения(Истина, "Алгоритм", ДополнительныеПараметры.Алгоритм));
		
	Иначе	
		ПараметрыОпределенияАлгоритма = Новый Структура("Сертификат", СертификатПодписанта);
		КриптографияЭДКОКлиент.ОпределитьАлгоритм(
			Оповещение,
			МестоХраненияКлюча,
			ПараметрыОпределенияАлгоритма,
			Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigПослеОпределенияАлгоритма(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	НеВключатьИнформациюОСертификате = ДополнительныеПараметры.НеВключатьИнформациюОСертификате;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	Алгоритм = ?(Результат.Выполнено И ЗначениеЗаполнено(Результат.Алгоритм), Результат.Алгоритм,
		КриптографияЭДКОКлиентСервер.АлгоритмПоУмолчанию());
	ДополнительныеПараметры.Алгоритм = Алгоритм;
	
	ИдентификаторНайденногоАлгоритма = КриптографияЭДКОКлиентСервер.СвойстваАлгоритма(Алгоритм).АлгоритмХеширования;
	ДополнительныеПараметры.ИдентификаторНайденногоАлгоритма = ИдентификаторНайденногоАлгоритма;
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigПослеЭкспортаСертификатаПолучателяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ НеВключатьИнформациюОСертификате Тогда
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатПодписанта);
	Иначе
		РезультатВыполнения = РезультатВыполнения(Истина, "СтрокаBase64", "");
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigПослеЭкспортаСертификатаПолучателяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Кодировка 							= ДополнительныеПараметры.Кодировка;
	НастройкиПодписи 					= ДополнительныеПараметры.НастройкиПодписи;
	ХэшВсегдаГОСТ2012					= ДополнительныеПараметры.ХэшВсегдаГОСТ2012;
	Алгоритм							= ДополнительныеПараметры.Алгоритм;
	ВключатьХэшСертификата				= ДополнительныеПараметры.ВключатьХэшСертификата;
	ИдентификаторыПодписываемыхДанных 	= ДополнительныеПараметры.ИдентификаторыПодписываемыхДанных;
	
	ДополнительныеПараметры.СертификатПолучателяВBase64 = Результат.СтрокаBase64;
	
	ДанныеФайловДляПодписиВПакете(Результат.СтрокаBase64, 
								ДополнительныеПараметры.ФайлыДанных, 
								НастройкиПодписи, 
								?(ХэшВсегдаГОСТ2012, "GOST R 34.10-2001", Алгоритм),
								Кодировка,
								ИдентификаторыПодписываемыхДанных);
								
	Если ВключатьХэшСертификата Тогда
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклХешЗначенияКлюча", ЭтотОбъект, ДополнительныеПараметры);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклХешЗначенияСодержимого", ЭтотОбъект, ДополнительныеПараметры);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения(Истина));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigЦиклХешЗначенияКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	ИндексФайл = ДополнительныеПараметры.ИндексФайл;
	
	Если ИндексФайл <> 0 Тогда
		ТекущийФайл = ДополнительныеПараметры.ФайлыДанных[ИндексФайл - 1];
		ТекущийФайл.ХешЗначениеКлюча = Результат.Хеш;
	КонецЕсли;
	
	ИндексФайл = ИндексФайл + 1;
	ДополнительныеПараметры.ИндексФайл = ИндексФайл;
	
	Если ИндексФайл <= ДополнительныеПараметры.ВсегоФайлов Тогда
		ТекущийФайл = ДополнительныеПараметры.ФайлыДанных[ИндексФайл - 1];
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклХешЗначенияКлюча", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			КонтекстМоделиХраненияКлюча(ДополнительныеПараметры),
			ТекущийФайл.КанонизированныйКлюч,,
			Ложь,,
			ДополнительныеПараметры.Алгоритм);
	Иначе
		ДополнительныеПараметры.ИндексФайл = 0;
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклХешЗначенияСодержимого", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения(Истина));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigЦиклХешЗначенияСодержимого(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	ИндексФайл = ДополнительныеПараметры.ИндексФайл;
	ВключатьХэшСертификата = ДополнительныеПараметры.ВключатьХэшСертификата;
	ДанныеВнутриПодписи = ДополнительныеПараметры.ДанныеВнутриПодписи;
	
	Если ИндексФайл <> 0 Тогда
		ТекущийФайл = ДополнительныеПараметры.ФайлыДанных[ИндексФайл - 1];
		ТекущийФайл.ХешЗначениеСодержимого = Результат.Хеш;
	КонецЕсли;
	
	ИндексФайл = ИндексФайл + 1;
	ДополнительныеПараметры.ИндексФайл = ИндексФайл;
	
	Если ИндексФайл <= ДополнительныеПараметры.ВсегоФайлов Тогда
		ТекущийФайл = ДополнительныеПараметры.ФайлыДанных[ИндексФайл - 1];
		КанонизированныйОбъектXML = ?(ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи, 
												ТекущийФайл.КанонизированныйУзелИнформацияОбОбъектеXML, 
												ТекущийФайл.КанонизированныйФайлXML);
		
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклХешЗначенияСодержимого", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			КонтекстМоделиХраненияКлюча(ДополнительныеПараметры),
			КанонизированныйОбъектXML,,
			Ложь,,
			ДополнительныеПараметры.Алгоритм);
	Иначе
		ДополнительныеПараметры.ИндексФайл = 0;
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклПодпись", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения(Истина));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigЦиклПодпись(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИндексФайл = ДополнительныеПараметры.ИндексФайл;
	ВсегоФайлов = ДополнительныеПараметры.ВсегоФайлов;
	Алгоритм = ДополнительныеПараметры.Алгоритм;
	НастройкиПодписи = ДополнительныеПараметры.НастройкиПодписи;
	ПакетнаяПодпись = ДополнительныеПараметры.ПакетнаяПодпись;
	ДобавляемыеАтрибуты = ДополнительныеПараметры.ДобавляемыеАтрибуты;
	ДанныеОблачнойПодписи = ДополнительныеПараметры.ДанныеОблачнойПодписи;
	ВключатьХэшСертификата = ДополнительныеПараметры.ВключатьХэшСертификата;
	
	ПодготовитьДанныеДляПодписиВПакете(ДополнительныеПараметры.ФайлыДанных, ДобавляемыеАтрибуты);
	
	ФайлыДанных = ДополнительныеПараметры.ФайлыДанных;
	
	Если ПакетнаяПодпись И ВключитьПакетнуюПодпись Тогда
		ИмяФайла = СвойствоСтруктуры(НастройкиПодписи, "ИмяФайла", "Данные для подписи");
		ОписаниеСледующее = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклПослеОблачнойПодписи", ЭтотОбъект, ДополнительныеПараметры);

		МассивДокументов = Новый Массив;
		Для Счетчик = 0 По ФайлыДанных.ВГраница() Цикл
			СтрокаМассива = ФайлыДанных[Счетчик];
			НовыйДокументПакетнойПодписи(
				МассивДокументов,
				СтрокаМассива.КанонизированныеДанные,
				ИмяФайла,
				"xml",
				Счетчик);
		КонецЦикла;

		ПараметрыОперации = Новый Структура("ПодтверждатьОперацию", СвойствоСтруктуры(ДанныеОблачнойПодписи, "ПодтверждатьПринудительно", Ложь));
		ПакетнаяПодписьОблачнойПодписи(ОписаниеСледующее, МестоХраненияКлюча, МассивДокументов, СертификатПодписанта, ПараметрыОперации);
		
	Иначе
		Если ИндексФайл <> 0 Тогда
			ТекущийФайл = ФайлыДанных[ИндексФайл - 1];
			ТекущийФайл.Подпись = Результат.ИмяФайлаПодписи;
		КонецЕсли;
		
		ИндексФайл = ИндексФайл + 1;
		ДополнительныеПараметры.ИндексФайл = ИндексФайл;
		
		Если ИндексФайл <= ВсегоФайлов Тогда
			ТекущийФайл = ДополнительныеПараметры.ФайлыДанных[ИндексФайл - 1];
			
			ИдентификаторНайденногоАлгоритма = КриптографияЭДКОКлиентСервер.СвойстваАлгоритма(Алгоритм).АлгоритмХеширования;
			ПараметрыКриптографии = Новый Структура("АлгоритмХеширования", ИдентификаторНайденногоАлгоритма);

			Оповещение = Новый ОписаниеОповещения("ПодписатьФайлыXMLDSigЦиклПодпись", ЭтотОбъект, ДополнительныеПараметры);
			
			ПараметрыОперации = Неопределено;
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
				ИмяФайла = ДанныеОблачнойПодписи.ИмяФайла;
				ИмяФайла = ИмяФайла + " - " + ИндексФайл;
				ПараметрыОперации = ПодготовитьОблачнуюПодпись(ИмяФайла, "xml", ДанныеОблачнойПодписи.ПодтверждатьПринудительно);
			КонецЕсли;
			
			КриптографияЭДКОКлиент.Подписать(Оповещение, СертификатПодписанта, ТекущийФайл.КанонизированныеДанные, ПараметрыКриптографии,
				?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча), Неопределено, ".bin"), Ложь, Неопределено, ПараметрыОперации);
		Иначе
			РезультатыПодписи = ПодготовитьРезультатПодписиВПакете(ФайлыДанных, ВключатьХэшСертификата);
			
			Для Счетчик = 0 По ВсегоФайлов - 1 Цикл
				ФайлыДанных[Счетчик].Результат = РезультатыПодписи[Счетчик];
			КонецЦикла;	
			
			ДополнительныеПараметры.ФайлыДанных = ФайлыДанных;
			
			ПодписатьФайлыXMLDSigЗавершение(РезультатВыполнения(Истина), ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigЦиклПослеОблачнойПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВключатьХэшСертификата = ДополнительныеПараметры.ВключатьХэшСертификата;
	ВсегоФайлов = ДополнительныеПараметры.ВсегоФайлов;
	ФайлыДанных = ДополнительныеПараметры.ФайлыДанных;
	
	ВсеПодписи = Результат.Результат;
	
	Для Счетчик = 0 По ВсегоФайлов - 1 Цикл
		ФайлыДанных[Счетчик].Подпись = ВсеПодписи[Счетчик];
	КонецЦикла;	
	
	РезультатыПодписи = ПодготовитьРезультатПодписиВПакете(ФайлыДанных, ВключатьХэшСертификата);
	
	Для Счетчик = 0 По ВсегоФайлов - 1 Цикл
		ФайлыДанных[Счетчик].Результат = РезультатыПодписи[Счетчик];
	КонецЦикла;	
	
	ДополнительныеПараметры.ФайлыДанных = ФайлыДанных;
	
	ПодписатьФайлыXMLDSigЗавершение(РезультатВыполнения(Истина), ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлыXMLDSigЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВсегоФайлов = ДополнительныеПараметры.ВсегоФайлов;
	ФайлыДанных = ДополнительныеПараметры.ФайлыДанных;
	
	Результат = Новый Массив;
	Для Счетчик = 0 По ВсегоФайлов - 1 Цикл
		Результат.Добавить(ФайлыДанных[Счетчик].Результат);
	КонецЦикла;	
	
	ИсключитьПоля = СтрРазделить("АдресДанных,Результат", ",", Ложь);
	// очистить временное хранилище
	Для Каждого СтрокаМассива Из ФайлыДанных Цикл
		Для Каждого СтрокаКлюча Из СтрокаМассива Цикл
			Если ИсключитьПоля.Найти(СтрокаКлюча.Ключ) <> Неопределено Тогда
				Продолжить;	
			ИначеЕсли ЗначениеЗаполнено(СтрокаКлюча.Значение)
				И ЭтоАдресВременногоХранилища(СтрокаКлюча.Значение) Тогда
				УдалитьИзВременногоХранилища(СтрокаКлюча.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Функция РезультатВыполнения(Выполнено = Истина, ИмяКлюча = Неопределено, ЗначениеКлюча = "")
	
	Результат = Новый Структура("Выполнено", Выполнено);
	Если ЗначениеЗаполнено(ИмяКлюча) Тогда
		Результат.Вставить(ИмяКлюча, ЗначениеКлюча);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДанныеФайловДляПодписиВПакете(СертификатПолучателяВBase64, ФайлыДанных, НастройкиПодписи, Алгоритм, Кодировка, ИдентификаторыПодписываемыхДанных)
	
	ВсеНастройки = ОбщегоНазначения.СкопироватьРекурсивно(НастройкиПодписи);
	Для Счетчик = 0 По ФайлыДанных.Количество() - 1 Цикл
		СтрокаМассива = ФайлыДанных[Счетчик];
		АлгоритмЦикла = Алгоритм;
		КодировкаЦикла = Кодировка;
		АдресСодержимогоПодготовленногоФайлаXML = Неопределено;
		Если ИдентификаторыПодписываемыхДанных.Количество() > Счетчик Тогда
			ВсеНастройки.Вставить("ИдентификаторПодписываемыхДанных", ИдентификаторыПодписываемыхДанных[Счетчик]);
		Иначе
			ВсеНастройки.Вставить("ИдентификаторПодписываемыхДанных", Неопределено);
		КонецЕсли;	
		ДанныеДляПодписиФайлаXML = АдресДанныхДляПодписиФайлаXMLНаСервере(
												СтрокаМассива.АдресДанных,
												АдресСодержимогоПодготовленногоФайлаXML,
												СертификатПолучателяВBase64,
												КодировкаЦикла,
												ВсеНастройки,
												АлгоритмЦикла);
		СтрокаМассива.КанонизированныйУзелИнформацияОбОбъектеXML = СвойствоСтруктуры(ДанныеДляПодписиФайлаXML, "КанонизированныйУзелИнформацияОбОбъектеXMLВBase64");
		СтрокаМассива.КанонизированныйУзелПодпись = СвойствоСтруктуры(ДанныеДляПодписиФайлаXML, "КанонизированныйУзелПодписьВBase64");
		СтрокаМассива.КанонизированныйФайлXML = СвойствоСтруктуры(ДанныеДляПодписиФайлаXML, "КанонизированныйФайлXMLВBase64");
		СтрокаМассива.СодержимогоПодготовленногоФайлаXML = АдресСодержимогоПодготовленногоФайлаXML;
		СтрокаМассива.КанонизированныйКлюч = СвойствоСтруктуры(ДанныеДляПодписиФайлаXML, "КанонизированныйУзелИнформацияОКлючахXMLВBase64");
	КонецЦикла;
											
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьРезультатПодписиВПакете(ФайлыДанных, ВключатьХэшСертификата)
	
	Результат = НовыЙ Массив;
	
	Для Каждого СтрокаМассива Из ФайлыДанных Цикл
		СодержимоеПодписанногоФайлаXMLВBase64 = ПодписанныйФайлXMLВBase64НаСервере(
			СтрокаМассива.СодержимогоПодготовленногоФайлаXML,
			СтрокаМассива.ХешЗначениеКлюча,
			СтрокаМассива.ХешЗначениеСодержимого,
			?(ТипЗнч(СтрокаМассива.Подпись) = Тип("ДвоичныеДанные"), ПоместитьВоВременноеХранилище(СтрокаМассива.Подпись), СтрокаМассива.Подпись),
			СтрокаМассива.ВозвращатьАдресВоВременномХранилище,
			ВключатьХэшСертификата);
		Результат.Добавить(СодержимоеПодписанногоФайлаXMLВBase64);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьДанныеДляПодписиВПакете(ФайлыДанных, ДобавляемыеАтрибуты)
	
	Результат = НовыЙ Массив;
	
	Для Каждого СтрокаМассива Из ФайлыДанных Цикл
		СтрокаНаПодпись = КанонизированныйУзелПодписьВBase64СПодставленнымХешНаСервере(
			СтрокаМассива.КанонизированныйУзелПодпись,
			СтрокаМассива.ХешЗначениеКлюча,
			СтрокаМассива.ХешЗначениеСодержимого,
			Истина,
			ДобавляемыеАтрибуты);
			
		СтрокаМассива.КанонизированныеДанные = СтрокаНаПодпись;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодписьSOAP

&НаКлиенте
Функция ПараметрыОбменаСФСС(Организация) Экспорт
	
	ИспользуетсяОбменСФСС 	= Ложь;
	ВключенаАвтонастройка 	= Ложь;
	ВУниверсальномФормате	= Ложь;
	УчетнаяЗапись       	= Неопределено;
	
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		Организация,
		ВУниверсальномФормате,
		ИспользуетсяОбменСФСС,
		ВключенаАвтонастройка,
		УчетнаяЗапись);
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("ИспользуетсяОбменСФСС", ИспользуетсяОбменСФСС);
	ДополнительныеПараметры.Вставить("ВключенаАвтонастройка", ВключенаАвтонастройка);
	ДополнительныеПараметры.Вставить("ВУниверсальномФормате", ВУниверсальномФормате);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	
	Возврат ДополнительныеПараметры;
		
КонецФункции

&НаКлиенте
Процедура ПоказатьОшибкуЕслиОрганизацияНеИспользуетОбменСФСС(Организация, ВыполняемоеОповещение) Экспорт
	
	ПараметрыОбменаСФСС = ПараметрыОбменаСФСС(Организация);
	
	Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ВыполняемоеОповещение) Тогда
		ТекстСообщения = ДлительнаяОтправкаКлиентСервер.Сообщение1СОтчетностьНеПодключено();
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ТекстСообщения);
	Иначе
		Если НЕ ПараметрыОбменаСФСС.ВУниверсальномФормате Тогда
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение(ПараметрыОбменаСФСС.Организация);
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'По организации отчета не включена возможность электронного документооборота с ФСС!';
											|en = 'По организации отчета не включена возможность электронного документооборота с ФСС!'"));
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФСС(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		РегистрационныйНомерФСС,
		ВыгрузкаЭЛН,
		ЗашифроватьSOAP = Истина,
		НастройкиОперации = Неопределено) Экспорт
	
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("ПроверкиИАвтонастройкаВыполнены", 	Ложь);
	НастройкиВызова.Вставить("СертификатСтрахователя", 				Неопределено);
	НастройкиВызова.Вставить("СертификатФСС", 						Неопределено);
	НастройкиВызова.Вставить("МЧД", 								"");
	НастройкиВызова.Вставить("ПараметрыФорматаЭЛН", 				Неопределено);
	Если НастройкиОперации <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, НастройкиОперации);
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(НастройкиОперации);
	Иначе
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Ложь);
	КонецЕсли;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НастройкиВызова);
	
	Если НЕ НастройкиВызова.ПроверкиИАвтонастройкаВыполнены Тогда
		ОрганизацияИспользуетОбменСФСС 						= Ложь;
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи 	= Ложь;
		НастроенОбменВУниверсальномФормате 					= Ложь;
		УчетнаяЗаписьДокументооборота 						= Неопределено;
		
		ПараметрыФорматов = ?(НастройкиВызова.ПараметрыФорматаЭЛН = Неопределено,
			Новый Структура("ПараметрыФорматаЭЛН", Неопределено), Неопределено);
		ПолучитьСвойстваОрганизацииДляФССНаСервере(
			ОрганизацияСсылка,
			НастроенОбменВУниверсальномФормате,
			ОрганизацияИспользуетОбменСФСС,
			ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи,
			УчетнаяЗаписьДокументооборота,
			ПараметрыФорматов);
		НастройкиВызова.ПараметрыФорматаЭЛН = ?(НастройкиВызова.ПараметрыФорматаЭЛН = Неопределено,
			ПараметрыФорматов.ПараметрыФорматаЭЛН, НастройкиВызова.ПараметрыФорматаЭЛН);
		
		Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
			ПоказатьОшибкуЕслиОрганизацияНеИспользуетОбменСФСС(ОрганизацияСсылка, ВыполняемоеОповещение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыполнятьАвтонастройку = 
		НЕ НастройкиВызова.ПроверкиИАвтонастройкаВыполнены 
		И НастроенОбменВУниверсальномФормате
		И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи;
		
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 		ОрганизацияСсылка);
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ВыгрузкаЭЛН", 			ВыгрузкаЭЛН);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 		ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("НастройкиВызова", 		НастройкиВызова);
	ДополнительныеПараметры.Вставить("ВыполнятьАвтонастройку", 	ВыполнятьАвтонастройку);
	
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если ВыполнятьАвтонастройку Тогда
		
		АвтоматическаяНастройкаУчетнойЗаписи(
			УчетнаяЗаписьДокументооборота,,
			Оповещение,,,
			Истина);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПроверкиЛицензииИСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	Если ВходящийКонтекст.ВыполнятьАвтонастройку Тогда
		
		Организация = ВходящийКонтекст.ОрганизацияСсылка;
		
		ПроверитьСертификатИЛицензию(
			ОписаниеОповещения, 
			Неопределено, 
			Организация, 
			"ФСС");
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПроверкиЛицензииИСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 		= ДополнительныеПараметры.ОрганизацияСсылка;
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН 			= ДополнительныеПараметры.ВыгрузкаЭЛН;
	ЗашифроватьSOAP 		= ДополнительныеПараметры.ЗашифроватьSOAP;
	НастройкиВызова 		= ДополнительныеПараметры.НастройкиВызова;
	
	ПараметрыФорматаЭЛН = ?(НастройкиВызова.ПараметрыФорматаЭЛН = Неопределено,
		ПараметрыФорматаЭЛННаСервере(), НастройкиВызова.ПараметрыФорматаЭЛН);
	ДополнительныеПараметры.НастройкиВызова.ПараметрыФорматаЭЛН = ПараметрыФорматаЭЛН;
	ЭтоВерсия1X = Лев(ПараметрыФорматаЭЛН.Версия, 2) = "1.";
	
	ПространствоИменЗапроса = ?(ЭтоВерсия1X, "http://ru/ibs/fss/ln/ws/FileOperationsLn.wsdl",
		"http://www.fss.ru/integration/types/eln/ins/v01");
	ПространствоИменАтрибутов = ?(ЭтоВерсия1X, Неопределено, "http://www.fss.ru/integration/types/eln/v01");
	ДобавляемыеАтрибутыЗаписи = "xmlns:ds=""http://www.w3.org/2000/09/xmldsig#"""
		+ " xmlns:eln=""" + ПространствоИменЗапроса + """"
		+ " xmlns:sch=""http://gost34.ibs.ru/WrapperService/Schema"""
		+ " xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"""
		+ ?(ЗначениеЗаполнено(ПространствоИменАтрибутов), " xmlns:v011=""http://www.fss.ru/integration/types/eln/v01""", "")
		+ " xmlns:wsse=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"""
		+ " xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd""";
	ДобавляемыеАтрибутыПодписи = "xmlns=""http://www.w3.org/2000/09/xmldsig#""";
	
	СкорректированнаяВыгрузкаЭЛН = СкорректироватьВыгрузкуЗапросаОперацииДляSOAP(
		ВыгрузкаЭЛН,
		ПространствоИменЗапроса,
		ПространствоИменАтрибутов);
	
	СкорректированнаяВыгрузкаЗапросаЭЛН = Новый Структура;
	СкорректированнаяВыгрузкаЗапросаЭЛН.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	СкорректированнаяВыгрузкаЗапросаЭЛН.Вставить("ВыгрузкаЭЛН", 			СкорректированнаяВыгрузкаЭЛН);
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	РезультатИнициализации = АдресПодписанногоSOAPЗагрузкиЭЛНВФССИнициализацияНаСервере(
		ОрганизацияСсылка,
		СкорректированнаяВыгрузкаЗапросаЭЛН,
		ДобавляемыеАтрибутыЗаписи,
		ЗашифроватьSOAP,
		КонтекстМоделиХраненияКлюча(НастройкиВызова),
		НЕ СертификатыИзвестны);
	
	Если РезультатИнициализации = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.РегистрационныйНомерФСС = РезультатИнициализации.РегистрационныйНомерФСС;
	
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗаписи", 		ДобавляемыеАтрибутыЗаписи);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 		ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("СкорректированнаяВыгрузкаЭЛН", 	СкорректированнаяВыгрузкаЭЛН);
	ДополнительныеПараметры.Вставить("РезультатИнициализации", 			РезультатИнициализации);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПредупрежденияПриТестовомРежиме",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ НастройкиВызова.ПроверкиИАвтонастройкаВыполнены И НЕ СертификатыИзвестны
		И РезультатИнициализации.ТестовыйСерверФССЭЛН Тогда
		
		ТекстВопроса = НСтр("ru = 'Внимание! Включен режим тестирования ЭЛН!
			|
			|В режиме тестирования отчетность отправляется через тестовый шлюз СФР (бывш. ФСС).
			|Сдача отчетности засчитана не будет.
			|
			|Продолжить отправку?';
			|en = 'Внимание! Включен режим тестирования ЭЛН!
			|
			|В режиме тестирования отчетность отправляется через тестовый шлюз СФР (бывш. ФСС).
			|Сдача отчетности засчитана не будет.
			|
			|Продолжить отправку?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПредупрежденияПриТестовомРежиме(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОрганизацияСсылка 				= ДополнительныеПараметры.ОрганизацияСсылка;
	РегистрационныйНомерФСС 		= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН 					= ДополнительныеПараметры.ВыгрузкаЭЛН;
	ЗашифроватьSOAP 				= ДополнительныеПараметры.ЗашифроватьSOAP;
	НастройкиВызова 				= ДополнительныеПараметры.НастройкиВызова;
	ДобавляемыеАтрибутыЗаписи 		= ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи 		= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	СкорректированнаяВыгрузкаЭЛН 	= ДополнительныеПараметры.СкорректированнаяВыгрузкаЭЛН;
	РезультатИнициализации 			= ДополнительныеПараметры.РезультатИнициализации;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	НомерЗаписиЭЛН = 1;
	МассивЗаписейЭЛН64 = РезультатИнициализации.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = РезультатИнициализации.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = Новый Массив;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РезультатИнициализации);
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	Если СертификатыИзвестны Тогда
		СертификатСтрахователя 		= НастройкиВызова.СертификатСтрахователя;
		СертификатФССЭЛНОтпечаток 	= Неопределено;
		СертификатФССЭЛН 			= НастройкиВызова.СертификатФСС;
		МЧД 						= НастройкиВызова.МЧД;
		
	Иначе
		СертификатСтрахователяОтпечаток = РезультатИнициализации.СертификатСтрахователяОтпечаток;
		СертификатСтрахователя 			= РезультатИнициализации.СертификатСтрахователя;
		СертификатФССЭЛНОтпечаток 		= РезультатИнициализации.СертификатФССЭЛНОтпечаток;
		СертификатФССЭЛН 				= РезультатИнициализации.СертификатФССЭЛН;
		МЧД 							= РезультатИнициализации.МЧД;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", 				РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ВыгрузкаЭЛН", 							СкорректированнаяВыгрузкаЭЛН);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛНОтпечаток", 				СертификатФССЭЛНОтпечаток);
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", 						СертификатФССЭЛН);
	ДополнительныеПараметры.Вставить("МЧД", 									МЧД);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 					ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ЗашифроватьSOAP", 						ЗашифроватьSOAP);
	ДополнительныеПараметры.Вставить("НастройкиВызова", 						НастройкиВызова);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыЗаписи", 				ДобавляемыеАтрибутыЗаписи);
	ДополнительныеПараметры.Вставить("ДобавляемыеАтрибутыПодписи", 				ДобавляемыеАтрибутыПодписи);
	ДополнительныеПараметры.Вставить("НомерЗаписиЭЛН", 							НомерЗаписиЭЛН);
	ДополнительныеПараметры.Вставить("МассивЗаписейЭЛН64", 						МассивЗаписейЭЛН64);
	ДополнительныеПараметры.Вставить("МассивНомеровЛистковНетрудоспособности", 	МассивНомеровЛистковНетрудоспособности);
	ДополнительныеПараметры.Вставить("МассивПодписейЭЛН64", 					МассивПодписейЭЛН64);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка", 						ОрганизацияСсылка);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПоискаСертификатаСтрахователя",
		ЭтотОбъект, ДополнительныеПараметры);
	Если СертификатыИзвестны ИЛИ НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, Истина, СертификатСтрахователя);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатСтрахователяОтпечаток, "MY");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СкорректироватьВыгрузкуЗапросаОперацииДляSOAP(
		ВыгрузкаЗапросаОперации,
		ПространствоИменЗапроса,
		ПространствоИменАтрибутов = Неопределено)
	
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(ВыгрузкаЗапросаОперации,
		" xmlns=""" + ПространствоИменЗапроса + """", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
		" xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
		" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
	
	ПространствоИменЗамены = ПространствоИменЗапроса;
	Для НомерПространстваИмен = 1 По 2 Цикл
		Пока Истина Цикл
			ПозицияПространстваИмен = СтрНайти(СкорректированнаяВыгрузкаЗапроса, "=""" + ПространствоИменЗамены + """");
			Если ПозицияПространстваИмен = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозицияПрефикса = ПозицияПространстваИмен - 1;
			Пока ПозицияПрефикса > 1 Цикл
				Если Сред(СкорректированнаяВыгрузкаЗапроса, ПозицияПрефикса - 1, 1) = ":" Тогда
					ПрефиксПространстваИмен = Сред(СкорректированнаяВыгрузкаЗапроса,
						ПозицияПрефикса, ПозицияПространстваИмен - ПозицияПрефикса);
					СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
						" xmlns:" + ПрефиксПространстваИмен + "=""" + ПространствоИменЗамены + """", "");
					СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
						" " + ПрефиксПространстваИмен + ":", " ");
					СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
						"<" + ПрефиксПространстваИмен + ":", "<");
					СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса,
						"</" + ПрефиксПространстваИмен + ":", "</");
					Прервать;
				КонецЕсли;
				ПозицияПрефикса = ПозицияПрефикса - 1;
			КонецЦикла;
		КонецЦикла;
		
		Если ПространствоИменАтрибутов = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ПространствоИменЗамены = ПространствоИменАтрибутов;
	КонецЦикла;
	
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:type=""xs:string""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:type=""xs:dateTime""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:type=""xs:boolean""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:type=""xs:double""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:type=""xs:int""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, " xsi:nil=""true""", "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, "/>", " xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xsi:nil=""true""/>");
	
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, Символы.Таб, "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, Символы.ВК, "");
	СкорректированнаяВыгрузкаЗапроса = СтрЗаменить(СкорректированнаяВыгрузкаЗапроса, Символы.ПС, "");
	
	Возврат СкорректированнаяВыгрузкаЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресПодписанногоSOAPЗагрузкиЭЛНВФССИнициализацияНаСервере(
		Знач ОрганизацияСсылка,
		Знач ВыгрузкаЗапросаЭЛН,
		Знач ДобавляемыеАтрибутыЗаписи,
		Знач ПолучитьСертификатФССЭЛН = Ложь,
		Знач МестоХраненияКлюча = Неопределено,
		Знач ВозвращатьСертификаты = Истина)
	
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		ОрганизацияСсылка,
		НЕ ЗначениеЗаполнено(ВыгрузкаЗапросаЭЛН.РегистрационныйНомерФСС),
		Ложь);
	
	Результат = Новый Структура;
	Результат.Вставить("РегистрационныйНомерФСС", Неопределено);
	
	Результат.РегистрационныйНомерФСС = ?(СвойстваОрганизации.Свойство("РегистрационныйНомерФСС"),
		СвойстваОрганизации.РегистрационныйНомерФСС, ВыгрузкаЗапросаЭЛН.РегистрационныйНомерФСС);
	
	МассивНомеровЛистковНетрудоспособности = Неопределено;
	МассивЗаписейЭЛН64 = ЗаписиЭЛНДляПодписиSOAP64НаСервере(
		ВыгрузкаЗапросаЭЛН.ВыгрузкаЭЛН,
		ДобавляемыеАтрибутыЗаписи,
		МассивНомеровЛистковНетрудоспособности);
	Если МассивЗаписейЭЛН64 = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'ЭЛН не заполнен';
							|en = 'ЭЛН не заполнен'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Если МассивЗаписейЭЛН64.Количество() > 30 Тогда
		ТекстОшибки = НСтр("ru = 'Допустимо не более 30 листков нетрудоспособности, разделите реестр ЭЛН на несколько';
							|en = 'Допустимо не более 30 листков нетрудоспособности, разделите реестр ЭЛН на несколько'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Если МестоХраненияКлюча = Неопределено ИЛИ ВозвращатьСертификаты Тогда
		РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияСсылка, "ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена");
		Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
			И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена) Тогда
			МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
		ИначеЕсли МестоХраненияКлюча = Неопределено Тогда
			МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Ложь);
		КонецЕсли;
	КонецЕсли;	
	
	Если ВозвращатьСертификаты Тогда
		ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	КонецЕсли;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Для ИндексЗаписиЭЛН = 0 По МассивЗаписейЭЛН64.Количество() - 1 Цикл
			ДвоичныеДанныеЗаписиЭЛН = Base64Значение(МассивЗаписейЭЛН64[ИндексЗаписиЭЛН]);
			МассивЗаписейЭЛН64[ИндексЗаписиЭЛН] = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗаписиЭЛН, Новый УникальныйИдентификатор);
		КонецЦикла;
	КонецЕсли;
	
	Если ВозвращатьСертификаты Тогда
		ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
		Если ОтпечаткиСертификатов = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток) Тогда
			ТекстОшибки = НСтр("ru = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности';
								|en = 'Не выбран сертификат страхователя в настройках обмена с ФСС для 1С-Отчетности'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		Если ПолучитьСертификатФССЭЛН И НЕ ЗначениеЗаполнено(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток) Тогда
			ТекстОшибки = НСтр("ru = 'Не выбран сертификат ФСС ЭЛН в настройках обмена с ФСС для 1С-Отчетности';
								|en = 'Не выбран сертификат ФСС ЭЛН в настройках обмена с ФСС для 1С-Отчетности'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		СертификатСтрахователя = Неопределено;
		СертификатФССЭЛН = Неопределено;
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
			Иначе
				СертификатСтрахователя = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY");
			КонецЕсли;
			Если СертификатСтрахователя = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'Не найден сертификат страхователя';
									|en = 'Не найден сертификат страхователя'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
				Возврат Неопределено;
			КонецЕсли;
			
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
			СертификатСтрахователя.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
			
			Если ПолучитьСертификатФССЭЛН Тогда
				Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
					СертификатФССЭЛН = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
				Иначе
					СертификатФССЭЛН = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
				КонецЕсли;
				Если СертификатФССЭЛН = Неопределено Тогда
					ТекстОшибки = НСтр("ru = 'Не найден сертификат ФСС ЭЛН';
										|en = 'Не найден сертификат ФСС ЭЛН'");
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
					Возврат Неопределено;
				КонецЕсли;
				ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатФССЭЛН);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("МассивЗаписейЭЛН64", 						МассивЗаписейЭЛН64);
	Результат.Вставить("МассивНомеровЛистковНетрудоспособности", 	МассивНомеровЛистковНетрудоспособности);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Результат);
	
	Если ВозвращатьСертификаты Тогда
		Результат.Вставить("СертификатСтрахователяОтпечаток", 	ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		Результат.Вставить("СертификатСтрахователя", 			СертификатСтрахователя);
		Результат.Вставить("СертификатФССЭЛНОтпечаток", 		ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток);
		Результат.Вставить("СертификатФССЭЛН", 					СертификатФССЭЛН);
		Результат.Вставить("ТестовыйСерверФССЭЛН", 				ОтпечаткиСертификатов.ТестовыйСерверФССЭЛН);
		Результат.Вставить("МЧД", 								ОтпечаткиСертификатов.МЧД);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПоискаСертификатаСтрахователя(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС 				= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН 							= ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатФССЭЛНОтпечаток 				= ДополнительныеПараметры.СертификатФССЭЛНОтпечаток;
	СертификатФССЭЛН 						= ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение 					= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP 						= ДополнительныеПараметры.ЗашифроватьSOAP;
	НастройкиВызова 						= ДополнительныеПараметры.НастройкиВызова;
	МестоХраненияКлюча 						= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи 				= ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи 				= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН 							= ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 						= ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности 	= ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 					= ДополнительныеПараметры.МассивПодписейЭЛН64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", СертификатСтрахователя);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПоискаСертификатаФСС",
		ЭтотОбъект, ДополнительныеПараметры);
	Если СертификатыИзвестны ИЛИ НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата",
			Истина, Неопределено, ЗашифроватьSOAP, СертификатФССЭЛН);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СертификатФССЭЛНОтпечаток, "AddressBook");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПоискаСертификатаФСС(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС 				= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН 							= ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя 					= ДополнительныеПараметры.СертификатСтрахователя;
	ВыполняемоеОповещение 					= ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP 						= ДополнительныеПараметры.ЗашифроватьSOAP;
	НастройкиВызова 						= ДополнительныеПараметры.НастройкиВызова;
	ДобавляемыеАтрибутыЗаписи 				= ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи 				= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН 							= ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 						= ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности 	= ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 					= ДополнительныеПараметры.МассивПодписейЭЛН64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатыИзвестны = НастройкиВызова.СертификатСтрахователя <> Неопределено
		ИЛИ НастройкиВызова.СертификатФСС <> Неопределено;
	
	СертификатФССЭЛН = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, НСтр("ru = 'Сертификат страхователя';
															|en = 'Сертификат страхователя'"));
	Если ЗашифроватьSOAP Тогда
		СертификатыОбмена.Добавить(СертификатФССЭЛН, НСтр("ru = 'Сертификат ФСС ЭЛН';
															|en = 'Сертификат ФСС ЭЛН'"));
	КонецЕсли;
	
	Если НЕ СертификатыИзвестны И НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("СертификатФССЭЛН", СертификатФССЭЛН);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЭкспортаСертификата",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, СертификатСтрахователя);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЭкспортаСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатПолучателя64 = Результат.СтрокаBase64;
	
	ДополнительныеПараметры.Вставить("СертификатПолучателя64", СертификатПолучателя64);
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		АдресПодписанногоSOAPЗагрузкиЭЛНВФССОблачнаяПодпись(ДополнительныеПараметры);
	Иначе
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССВЦикле",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССВЦикле(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗашифроватьSOAP = ДополнительныеПараметры.ЗашифроватьSOAP;
	МестоХроаненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	
	Если НомерЗаписиЭЛН <= МассивЗаписейЭЛН64.Количество() Тогда
		ЗаписьЭЛН64 = МассивЗаписейЭЛН64[НомерЗаписиЭЛН - 1];
		
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЗаписиФайла",
			ЭтотОбъект, ДополнительныеПараметры);
			
		Если НЕ ЭтоЛокальнаяПодпись(МестоХроаненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ЗаписьЭЛН64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ЗаписьЭЛН64);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыЗаписи", 	ДобавляемыеАтрибутыЗаписи);
	НастройкиОперации.Вставить("ДобавляемыеАтрибутыПодписи", 	ДобавляемыеАтрибутыПодписи);
	НастройкиОперации.Вставить("ВозвращатьТекстВBase64", 		ЗашифроватьSOAP);
	НастройкиОперации.Вставить("МЧД", 							ДополнительныеПараметры.МЧД);
	РезультатОперации = АдресSOAPЗагрузкиЭЛНВФССПоМассивуПодписейНаСервере(
		РегистрационныйНомерФСС,
		ВыгрузкаЭЛН,
		МассивПодписейЭЛН64,
		МассивНомеровЛистковНетрудоспособности,
		СертификатПолучателя64,
		НастройкиОперации);
	
	Если НЕ ЗашифроватьSOAP Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОперации);
		
	Иначе
		ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", РезультатОперации);
		Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЗаписиФайлаПодписанногоSOAP",
			ЭтотОбъект, ДополнительныеПараметры);
			
		Если НЕ ЭтоЛокальнаяПодпись(МестоХроаненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, РезультатОперации);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, РезультатОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивНомеровЛистковНетрудоспособности = ДополнительныеПараметры.МассивНомеровЛистковНетрудоспособности;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлЗаписиЭЛН = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ФайлЗаписиЭЛН", ФайлЗаписиЭЛН);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПодписания",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ДобавляемыеАтрибутыПодписиИЗаписи = ДобавляемыеАтрибутыПодписи
		+ ?(ДобавляемыеАтрибутыПодписи <> "" И ДобавляемыеАтрибутыЗаписи <> "", " ", "")
		+ ДобавляемыеАтрибутыЗаписи;
	НомерЗаписиЭЛНСтрокой = "ELN_" + МассивНомеровЛистковНетрудоспособности[НомерЗаписиЭЛН - 1];
	
	ДополнительныеТрансформации = Новый Массив;
	ДополнительныеОбратныеТрансформации = Новый Массив;
	
	// прямые и обратные замены
	ДополнительныеТрансформации.Добавить("<eln:");
	ДополнительныеТрансформации.Добавить("<");
	ДополнительныеОбратныеТрансформации.Добавить("<eln:/");
	ДополнительныеОбратныеТрансформации.Добавить("</eln:");
	
	ДополнительныеТрансформации.Добавить("</eln:");
	ДополнительныеТрансформации.Добавить("</");
	ДополнительныеОбратныеТрансформации.Добавить("<");
	ДополнительныеОбратныеТрансформации.Добавить("<eln:");
	
	НастройкиПодписи = Новый Структура;
	НастройкиПодписи.Вставить("Трансформация1_1", 						Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 				Ложь);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 				Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 						Неопределено);
	НастройкиПодписи.Вставить("НормализацияОтключена", 					Истина);
	НастройкиПодписи.Вставить("ДанныеВнутриПодписи", 					Истина);
	НастройкиПодписи.Вставить("ИдентификаторПодписываемыхДанных", 		НомерЗаписиЭЛНСтрокой);
	НастройкиПодписи.Вставить("ДобавляемыеАтрибуты", 					ДобавляемыеАтрибутыПодписиИЗаписи);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОСертификате", 		Истина);
	НастройкиПодписи.Вставить("НеВключатьИнформациюОбОбъекте", 			Истина);
	НастройкиПодписи.Вставить("ДополнительныеТрансформации", 			ДополнительныеТрансформации);
	НастройкиПодписи.Вставить("ДополнительныеОбратныеТрансформации", 	ДополнительныеОбратныеТрансформации);
	НастройкиПодписи.Вставить("Применение", 							"ОтправкиФСС");
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЗагрузкаЭЛН", ОрганизацияСсылка); 
		ПодготовитьОблачнуюПодпись("Реестр ЭЛН", ".xml", ТребуетПодтверждениеОперации, НастройкиПодписи);
	КонецЕсли;
	
	ПодписатьФайлXMLDSig(
		СертификатСтрахователя,
		ФайлЗаписиЭЛН,
		Оповещение,,,
		НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеПодписания(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	ФайлЗаписиЭЛН = ДополнительныеПараметры.ФайлЗаписиЭЛН;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ФайлЗаписиЭЛН);
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлЗаписиЭЛН);
	КонецЕсли;
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось подписать файл выгрузки ЭЛН!';
							|en = 'Не удалось подписать файл выгрузки ЭЛН!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлПодписиЭЛН", ПолноеИмяПодписанногоФайла);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЧтенияФайла",
		ЭтотОбъект, ДополнительныеПараметры);
		
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64",
			Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЧтенияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС = ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН = ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН = ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ДобавляемыеАтрибутыЗаписи = ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи = ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН = ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 = ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивПодписейЭЛН64 = ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 = ДополнительныеПараметры.СертификатПолучателя64;
	ФайлПодписиЭЛН = ДополнительныеПараметры.ФайлПодписиЭЛН;
	
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписиЭЛН);
	КонецЕсли;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	МассивПодписейЭЛН64.Добавить(Результат.СтрокаBase64);
	
	НомерЗаписиЭЛН = НомерЗаписиЭЛН + 1;
	
	ДополнительныеПараметры.Вставить("НомерЗаписиЭЛН", НомерЗаписиЭЛН);
	ДополнительныеПараметры.Вставить("МассивПодписейЭЛН64", МассивПодписейЭЛН64);
	Оповещение = Новый ОписаниеОповещения("АдресПодписанногоSOAPЗагрузкиЭЛНВФССВЦикле",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресПодписанногоSOAPЗагрузкиЭЛНВФССПослеЗаписиФайлаПодписанногоSOAP(Результат, ДополнительныеПараметры) Экспорт
	
	РегистрационныйНомерФСС 			= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ВыгрузкаЭЛН 						= ДополнительныеПараметры.ВыгрузкаЭЛН;
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФССЭЛН 					= ДополнительныеПараметры.СертификатФССЭЛН;
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ДобавляемыеАтрибутыЗаписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыЗаписи;
	ДобавляемыеАтрибутыПодписи 			= ДополнительныеПараметры.ДобавляемыеАтрибутыПодписи;
	НомерЗаписиЭЛН 						= ДополнительныеПараметры.НомерЗаписиЭЛН;
	МассивЗаписейЭЛН64 					= ДополнительныеПараметры.МассивЗаписейЭЛН64;
	МассивПодписейЭЛН64 				= ДополнительныеПараметры.МассивПодписейЭЛН64;
	СертификатПолучателя64 				= ДополнительныеПараметры.СертификатПолучателя64;
	ПодписанныйSOAP64 					= ДополнительныеПараметры.ПодписанныйSOAP64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыполняемоеОповещение.ДополнительныеПараметры) = Тип("Структура") Тогда
		ВыполняемоеОповещение.ДополнительныеПараметры.Вставить("ПодписанныйSOAP64", ПодписанныйSOAP64);
	КонецЕсли;
	
	ФайлПодписанногоSOAP = Результат.ИмяФайла;
	
	ЭтоВерсия1X = ?(ДополнительныеПараметры.НастройкиВызова.ПараметрыФорматаЭЛН = Неопределено, Истина,
		Лев(ДополнительныеПараметры.НастройкиВызова.ПараметрыФорматаЭЛН.Версия, 2) = "1.");
	
	ШаблонЗапросаSOAP =
		"<SOAP-ENV:Envelope xmlns:SOAP-ENV=""http://schemas.xmlsoap.org/soap/envelope/"">
		|	<SOAP-ENV:Header/>
		|	<SOAP-ENV:Body>
		|%1
		|	</SOAP-ENV:Body>
		|</SOAP-ENV:Envelope>";
	НастройкиОперации = Новый Структура;
	НастройкиОперации.Вставить("ШаблонЗапросаSOAP", ШаблонЗапросаSOAP);
	НастройкиОперации.Вставить("Применение", 		"ОтправкиФСС");
	Если НЕ ЭтоВерсия1X Тогда
		НастройкиОперации.Вставить("ПоместитьВУзелX509CertificateСертификатПолучателя", Истина);
	КонецЕсли;
	НастройкиОперации.Вставить("СценарийФСС", Истина);
	
	ЗашифроватьФайлXML(
		СертификатФССЭЛН,
		СертификатСтрахователя,
		ФайлПодписанногоSOAP,
		ВыполняемоеОповещение,,
		Истина,
		НастройкиОперации);
	
КонецПроцедуры

