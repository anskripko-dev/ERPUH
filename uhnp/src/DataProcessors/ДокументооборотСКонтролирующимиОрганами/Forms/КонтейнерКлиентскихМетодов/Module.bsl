	ПараметрыСообщения.ОписаниеОшибки =
		НСтр("ru='Не удалось отключить подписку организации на уведомления ФСС об изменении состояний ЭЛН для "
			+ ПросклонятьКоличествоЭлементовВСписке(СписокСНИЛС, "сотрудник") + ".
			|%1'");
