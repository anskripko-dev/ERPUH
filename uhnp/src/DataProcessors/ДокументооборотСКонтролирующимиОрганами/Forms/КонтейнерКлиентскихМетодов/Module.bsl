#Область ТаможенноеДекларирование

// ОтправкаСсылка ссылается на загруженный объект
&НаКлиенте
Процедура ПолучитьПроцедурыДекларированияФТС(
		ВыполняемоеОповещение,
		Организация,
		РежимПолучения = "ВыпущенныеДТ",
		Отборы = Неопределено,
		РежимыРаботы = Неопределено) Экспорт
	
	РежимыРаботыВызова = Новый Структура;
	РежимыРаботыВызова.Вставить("ТолькоПолучитьНастройки", 						Ложь);
	РежимыРаботыВызова.Вставить("ПовторятьЗапросПароляПриОшибке", 				Истина);
	РежимыРаботыВызова.Вставить("ПоказыватьДиалогПриОшибкеДоступаВИнтернет", 	Истина);
	Если РежимыРаботы <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(РежимыРаботыВызова, РежимыРаботы);
	КонецЕсли;
	
	ПерваяПопыткаАвторизации 	= Истина;
	АвторизацияПроизведена 		= Ложь;
	ИнформацияОСервереФТС 		= СерверПриемаОтчетностиФТС();
	НастройкиФТС 				= НастройкиФТСНаСервере(Организация);
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Организация", 					Организация);
	ПараметрыОтправки.Вставить("АдресСервера", 					ИнформацияОСервереФТС.АдресСервера);
	ПараметрыОтправки.Вставить("ВерсияФормированияВыгрузки", 	ИнформацияОСервереФТС.ВерсияФормированияВыгрузки);
	ПараметрыОтправки.Вставить("ВерсияОтправкиПортала", 		ИнформацияОСервереФТС.ВерсияОтправкиПортала);
	ПараметрыОтправки.Вставить("РежимПолучения", 				РежимПолучения);
	ПараметрыОтправки.Вставить("Отборы", 						Отборы);
	
	ПараметрыСоединения = Новый Структура;
	ПараметрыСоединения.Вставить("Логин", 					НастройкиФТС.Логин);
	ПараметрыСоединения.Вставить("Пароль", 					НастройкиФТС.Пароль);
	ПараметрыСоединения.Вставить("СохранитьПароль", 		ЗначениеЗаполнено(НастройкиФТС.Пароль));
	ПараметрыСоединения.Вставить("СохраненныйЛогин", 		НастройкиФТС.Логин);
	ПараметрыСоединения.Вставить("СохраненныйПароль", 		НастройкиФТС.Пароль);
	ПараметрыСоединения.Вставить("СоединениеHTTP", 			Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie", 			"");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером", 	"");
	ПараметрыСоединения.Вставить("ОписаниеОшибокПроверки", 	"");
	ПараметрыСоединения.Вставить("ПовторятьСоединение", 	Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля", 	Истина);
	ПараметрыСоединения.Вставить("СообщенияПользователю", 	Новый Массив);
	ПараметрыСоединения.Вставить("ТекущийАдресСервера", 	ИнформацияОСервереФТС.АдресСервера);
	ПараметрыСоединения.Вставить("ВерсияПортала", 			ИнформацияОСервереФТС.ВерсияПортала);
	ПараметрыСоединения.Вставить("ТекстОтветаАвторизации", 	"");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ПараметрыСоединения", 			ПараметрыСоединения);
	ДополнительныеПараметры.Вставить("ПараметрыОтправки", 				ПараметрыОтправки);
	ДополнительныеПараметры.Вставить("АвторизацияПроизведена", 			АвторизацияПроизведена);
	ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации", 		ПерваяПопыткаАвторизации);
	ДополнительныеПараметры.Вставить("РежимыРаботы", 					РежимыРаботыВызова);
	ДополнительныеПараметры.Вставить("ОповещениеОПолученииНастроек", 	Неопределено);
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьПроцедурыДекларированияФТСПослеПолученияНастроек",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(Оповещение, Истина);
	
КонецПроцедуры

// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (Цикл)
&НаКлиенте
Процедура ПолучитьПроцедурыДекларированияФТСПослеПолученияНастроек(РезультатДиалогаОбОшибкеДоступа,
		ДополнительныеПараметры) Экспорт
	
	Если РезультатДиалогаОбОшибкеДоступа <> Истина Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДополнительныеПараметры.ПараметрыСоединения.Логин)
		ИЛИ НЕ ЗначениеЗаполнено(ДополнительныеПараметры.ПараметрыСоединения.Пароль)
		ИЛИ НЕ ДополнительныеПараметры.ПерваяПопыткаАвторизации Тогда
		
		ДополнительныеПараметры.ПерваяПопыткаАвторизации = Истина;
		
		Оповещение = Новый ОписаниеОповещения("ПолучитьПроцедурыДекларированияФТСПослеВводаПароля",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ВызватьФормуВводаПароляПорталаФТС(
			"https://" + ДополнительныеПараметры.ПараметрыОтправки.АдресСервера + "/",
			ДополнительныеПараметры.ПараметрыСоединения.Логин,
			ДополнительныеПараметры.ПараметрыСоединения.Пароль,
			ДополнительныеПараметры.ПараметрыСоединения.СохранитьПароль,
			Оповещение);
		
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.РежимыРаботы.ТолькоПолучитьНастройки Тогда
		ВыполняемоеОповещение = ?(ДополнительныеПараметры.ОповещениеОПолученииНастроек = Неопределено,
			ДополнительныеПараметры.ВыполняемоеОповещение, ДополнительныеПараметры.ОповещениеОПолученииНастроек);
		ДополнительныеПараметры.ВыполняемоеОповещение 			= Неопределено;
		ДополнительныеПараметры.ОповещениеОПолученииНастроек 	= Неопределено;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	// при успешном обращении на сервер ФТС отправка обновится в ИБ
	ПроцедурыДекларирования = ПолучитьПроцедурыДекларированияФТСНаСервере(ДополнительныеПараметры.ПараметрыОтправки,
		ДополнительныеПараметры.ПараметрыСоединения);
	
	ОбработатьРезультатыПолученияПроцедурДекларированияФТС(
		ДополнительныеПараметры.ВыполняемоеОповещение,
		ПроцедурыДекларирования,
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатыПолученияПроцедурДекларированияФТС(
		ВыполняемоеОповещение,
		ПроцедурыДекларирования,
		ДополнительныеПараметрыПолучения,
		ОповещениеОПолученииНастроек = Неопределено) Экспорт
	
	ДополнительныеПараметрыПолучения.ВыполняемоеОповещение 			= ВыполняемоеОповещение;
	ДополнительныеПараметрыПолучения.ОповещениеОПолученииНастроек 	= ОповещениеОПолученииНастроек;
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(
		ДополнительныеПараметрыПолучения.ПараметрыСоединения.СообщенияПользователю);
	
	ДополнительныеПараметрыПолучения.ПерваяПопыткаАвторизации = Ложь;
	
	// рекурсивный вызов - замена цикла
	Если ПроцедурыДекларирования = Неопределено
		И ДополнительныеПараметрыПолучения.ПараметрыСоединения.ПовторятьЗапросПароля Тогда
		
		Если ДополнительныеПараметрыПолучения.РежимыРаботы.ПовторятьЗапросПароляПриОшибке Тогда
			Оповещение = Новый ОписаниеОповещения("ПолучитьПроцедурыДекларированияФТСПослеПолученияНастроек",
				ЭтотОбъект, ДополнительныеПараметрыПолучения);
			
			ВыполнитьОбработкуОповещения(Оповещение, Истина);
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметрыПолучения.ПараметрыСоединения.ПовторятьСоединение Тогда
		// возможно, проблемы с доступом в интернет
		Если НЕ ДополнительныеПараметрыПолучения.АвторизацияПроизведена Тогда
			ДополнительныеПараметрыПолучения.ПараметрыСоединения.ЗначениеCookie = "";
		КонецЕсли;
		
		Если ДополнительныеПараметрыПолучения.РежимыРаботы.ПоказыватьДиалогПриОшибкеДоступаВИнтернет Тогда
			Оповещение = Новый ОписаниеОповещения("ПолучитьПроцедурыДекларированияФТСПослеПолученияНастроек",
				ЭтотОбъект, ДополнительныеПараметрыПолучения);
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
				НСтр("ru = 'Не удалось обратиться к серверу Федеральной таможенной службы';
					|en = 'Не удалось обратиться к серверу Федеральной таможенной службы'"),
				Оповещение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметрыПолучения.ВыполняемоеОповещение, ПроцедурыДекларирования);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПроцедурыДекларированияФТСПослеВводаПароля(РезультатВводаПароля, ДополнительныеПараметры) Экспорт
	
	Если РезультатВводаПароля = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		
	Иначе
		ДополнительныеПараметры.ПараметрыСоединения.Логин 			= РезультатВводаПароля.Логин;
		ДополнительныеПараметры.ПараметрыСоединения.Пароль 			= РезультатВводаПароля.Пароль;
		ДополнительныеПараметры.ПараметрыСоединения.СохранитьПароль = РезультатВводаПароля.СохранитьПароль;
		
		Оповещение = Новый ОписаниеОповещения("ПолучитьПроцедурыДекларированияФТСПослеПолученияНастроек",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
	КонецЕсли;
	
КонецПроцедуры
