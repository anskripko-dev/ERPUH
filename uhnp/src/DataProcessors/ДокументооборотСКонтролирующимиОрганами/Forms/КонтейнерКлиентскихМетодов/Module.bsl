#Область РазборОтветов

&НаСервереБезКонтекста
Функция РазобратьОшибкуСервераСЭДОФСС(СодержимоеОтвета)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("Код", "");
	Результат.Вставить("Описание", "");
	Результат.Вставить("ДеталиКод", "");
	Результат.Вставить("ДеталиОписание", "");
	
	// Пример ответа сервера:
	//<soap:Body wsu:Id="OGRN_1027739443236">
	//	<soap:Fault>
	//		<faultcode>soap:Server</faultcode>
	//		<faultstring>Найдены ошибки при проверке реквизитов организации</faultstring>
	//		<detail>
	//			<ns3:internalFault xmlns:ns2="http://www.fss.ru/integration/types/common/v01" xmlns:ns3="http://www.fss.ru/integration/types/fault/v01" xmlns:ns4="http://www.fss.ru/integration/types/sedo/v01">
	//				<ns3:uuid>ccd9c84e-91cb-4dc6-97ba-043d31c2ab1b</ns3:uuid>
	//				<ns3:code>E_SEDO_1025 </ns3:code>
	//				<ns3:message>Пара рег.номер из запроса и ОГРН из сертификата не найдены в справочнике страхователей</ns3:message>
	//			</ns3:internalFault>
	//		</detail>
	//	</soap:Fault>
	//</soap:Body>
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СодержимоеОтвета);
	ОшибкаЧтения = Ложь;
	Попытка
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		ОшибкаЧтения = Истина;
	КонецПопытки;
	
	Если ОшибкаЧтения ИЛИ ДанныеОтвета = Неопределено Тогда
		Шаблон = НСтр("ru = 'Не удалось разобрать ответ сервера ФСС с ошибкой: ""%1""';
						|en = 'Не удалось разобрать ответ сервера ФСС с ошибкой: ""%1""'");
		ТекстДляЖурнала = СтрШаблон(Шаблон, СодержимоеОтвета);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
				|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстДляЖурнала);
		Результат.ОписаниеОшибки = НСтр("ru = 'С сервера СЭДО получена неизвестная ошибка';
										|en = 'С сервера СЭДО получена неизвестная ошибка'");
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЕстьСвойство(ДанныеОтвета.Body, "Fault") Тогда
		Шаблон = НСтр("ru = 'Не удалось разобрать ответ сервера ФСС с ошибкой (отсутствует узел Fault): ""%1""';
						|en = 'Не удалось разобрать ответ сервера ФСС с ошибкой (отсутствует узел Fault): ""%1""'");
		ТекстДляЖурнала = СтрШаблон(Шаблон, СодержимоеОтвета);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
				|en = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстДляЖурнала);
		Результат.ОписаниеОшибки = НСтр("ru = 'С сервера СЭДО получена неизвестная ошибка';
										|en = 'С сервера СЭДО получена неизвестная ошибка'");
		Возврат Результат;
	КонецЕсли;
	
	УзелДанных = ДанныеОтвета.Body.Fault;
	ОписаниеОшибки = УзелДанных.faultstring;
	Результат.Код = УзелДанных.faultcode;
	
	Если УзелДанных.Свойства().Получить("detail") <> Неопределено Тогда
		Детали = УзелДанных.detail;
		Подробности = Неопределено;
		Если Детали.Свойства().Получить("internalFault") <> Неопределено Тогда
			Подробности = Детали.internalFault;
		ИначеЕсли Детали.Свойства().Получить("digitalSignFault") <> Неопределено Тогда
			Подробности = Детали.digitalSignFault;
		ИначеЕсли Детали.Свойства().Получить("decryptFault") <> Неопределено Тогда
			Подробности = Детали.decryptFault;
		ИначеЕсли Детали.Свойства().Получить("tmsFault") <> Неопределено Тогда
			Подробности = Детали.tmsFault;
		КонецЕсли;
		Если Подробности <> Неопределено Тогда
			Если Подробности.Свойства().Получить("code") <> Неопределено Тогда
				Результат.ДеталиКод = Подробности.code;
			КонецЕсли;
			Если Подробности.Свойства().Получить("message") <> Неопределено Тогда
				Результат.ДеталиОписание = Подробности.message;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(Результат.ДеталиОписание) ИЛИ ОписаниеОшибки = Результат.ДеталиОписание Тогда
		Шаблон = НСтр("ru = 'Ответ СЭДО: ""%1""';
						|en = 'Ответ СЭДО: ""%1""'");
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, ОписаниеОшибки);
	Иначе
		Шаблон = НСтр("ru = 'Ответ СЭДО: ""%1: %2""';
						|en = 'Ответ СЭДО: ""%1: %2""'");
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, ОписаниеОшибки, Результат.ДеталиОписание);
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьОтветСЭДОФСССИдентификатором(СодержимоеОтвета)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("Идентификатор", Неопределено);
	
	// Пример ответа сервера:
	//<soap:Body wsu:Id="OGRN_1027739443236">
	//    <ns2:sedoUuidResponse xmlns:ns2="http://www.fss.ru/integration/types/sedo/v01"
	//        xmlns:ns3="http://www.fss.ru/integration/types/fault/v01">
	//        <result>
	//            <uuid>40a1a9d6-529e-45c8-ad04-c802fb3e1e97</uuid>
	//        </result>
	//    </ns2:sedoUuidResponse>
	//</soap:Body>
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		Результат.ОписаниеОшибки = НСтр("ru = 'Ошибка разбора ответа сервера СЭДО.';
										|en = 'Ошибка разбора ответа сервера СЭДО.'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = НСтр("ru = 'Ошибка разбора ответа сервера СЭДО:';
							|en = 'Ошибка разбора ответа сервера СЭДО:'") 
			+ Символы.ПС + ПодробноеПредставлениеОшибки
			+ Символы.ПС + НСтр("ru = 'Содержимое ответа:';
								|en = 'Содержимое ответа:'") + Символы.ПС + СодержимоеОтвета;
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Отправка сообщения СЭДО СФР';
							|en = 'Электронный документооборот с контролирующими органами. Отправка сообщения СЭДО СФР'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		Возврат Результат;
	КонецПопытки;
	
	УзелДанных = ДанныеОтвета.Body.sedoUuidResponse;
	
	Если УзелДанных.Свойства().Получить("errorList") <> Неопределено Тогда
		Ошибки = Новый Массив;
		Для каждого Ошибка Из ЗначениеВКоллекцию(УзелДанных.errorList.message) Цикл
			Ошибки.Добавить(Ошибка);
		КонецЦикла;
		Результат.ОписаниеОшибки = СтрСоединить(Ошибки, Символы.ПС);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Идентификатор = УзелДанных.result.uuid;
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
