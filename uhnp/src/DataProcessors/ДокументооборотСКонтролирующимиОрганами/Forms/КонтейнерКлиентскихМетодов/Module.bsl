		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеОтображениемОрганизации(Форма, Организация) Экспорт
	
	Если Форма.Элементы.Найти("Организация") <> Неопределено Тогда
		Форма.Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(Организация);
	КонецЕсли;
	
	// Определяем надпись для организации 
	Если Форма.Элементы.Найти("НадписьОрганизация") <> Неопределено Тогда
		Если ЗначениеЗаполнено(Организация) Тогда
			Форма.Элементы.НадписьОрганизация.Заголовок = НСтр("ru = 'Организация: ';
																|en = 'Организация: '") + КраткоеНаименованиеОрганизации(Организация);
			Форма.Элементы.НадписьОрганизация.Ширина = 0;
		Иначе
			Форма.Элементы.НадписьОрганизация.Заголовок = НСтр("ru = 'Организация:';
																|en = 'Организация:'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КраткоеНаименованиеОрганизации(Организация)
	
	Если Метаданные.Справочники.Организации.Реквизиты.Найти("НаименованиеСокращенное") = Неопределено Тогда
		КраткоеНаименование = СокрЛП(Организация.Наименование);
	Иначе
		КраткоеНаименование = СокрЛП(Организация.НаименованиеСокращенное);
	КонецЕсли;
		
	Возврат КраткоеНаименование;
	
КонецФункции

&НаСервере
Функция ПолучитьСтатусОтправкиОбъекта(Док) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьСтатусОтправкиОбъекта(Док);

КонецФункции

&НаКлиенте
Процедура СоздатьПисьмоОтвет(Ссылка) Экспорт
	
	// ищем существующий ответ
	Если ОтветНаПисьмоСуществует(Ссылка) Тогда
		ТекстВопроса = НСтр("ru = 'На данное письмо уже создан ответ. Вы уверены, что хотите создать новый?';
							|en = 'На данное письмо уже создан ответ. Вы уверены, что хотите создать новый?'");
		
		ОбработчикВопроса = Новый ОписаниеОповещения("СоздатьПисьмоОтветВопросЗавершение", ЭтотОбъект, Ссылка);
		ПоказатьВопрос(ОбработчикВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СоздатьПисьмоОтветВопросЗавершение(Неопределено, Ссылка);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПисьмоОтветВопросЗавершение(Ответ, Ссылка) Экспорт
	
	Если Ответ <> Неопределено И Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// если это ретроконверсия, то обработка особая
	ЭтоРетроконверсия = ПолучитьРеквизит(Ссылка, "Ретроконверсия");
	Если ЭтоРетроконверсия Тогда
		// показываем форму параметров ответа на ретроконверсию
		СтруктураПараметров = Новый Структура("Основание");
		СтруктураПараметров.Основание = Ссылка;
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьПисьмоОтветВопросЗавершениеРетроконверсияЗавершение", ЭтотОбъект, Ссылка); 
		ОткрытьФорму(ПутьКОбъекту + ".Форма.Ретроконверсия", СтруктураПараметров,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат;
		
	Иначе
		ОтветНаПисьмо = СоздатьОтветНаПисьмо(Ссылка);		
	КонецЕсли;
	
	Если ОтветНаПисьмо <> Неопределено Тогда
		СтруктураПараметров = Новый Структура("Ключ", ОтветНаПисьмо);
		ОткрытьФорму("Справочник.ПерепискаСКонтролирующимиОрганами.ФормаОбъекта", СтруктураПараметров);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПисьмоОтветВопросЗавершениеРетроконверсияЗавершение(НастройкиОтвета, Ссылка) Экспорт
	
	Если НастройкиОтвета = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ОтветНаПисьмо = СоздатьОтветНаПисьмо(Ссылка, НастройкиОтвета);
	
	Если ОтветНаПисьмо <> Неопределено Тогда
		СтруктураПараметров = Новый Структура("Ключ", ОтветНаПисьмо);
		ОткрытьФорму("Справочник.ПерепискаСКонтролирующимиОрганами.ФормаОбъекта", СтруктураПараметров);
	КонецЕсли;
		
КонецПроцедуры

// Печать электронного представления

&НаСервереБезКонтекста
Функция ПечатьИзЭлектронногоПредставленияНеПоддерживается(ЭлектронноеПредставление, ВидОтчета, ЭтоВебКлиент, ВыводЧерезВебСервис, АдресПараметровПроксиВоВременномХранилище, СвойстваОтчета)
	
	РеквизитыЭлектронногоПредставления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлектронноеПредставление, "ВидОтчета, ТипПолучателя, Получатель");
	ВидОтчета = РеквизитыЭлектронногоПредставления.ВидОтчета;
	ТипПолучателя = РеквизитыЭлектронногоПредставления.ТипПолучателя;
	Получатель = РеквизитыЭлектронногоПредставления.Получатель;
	ВыводЧерезВебСервис = Ложь;
	АдресПараметровПроксиВоВременномХранилище = "";
	НаименованиеОтчета = "";
	НаименованиеИФНС = Неопределено;
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ПечатьНеПоддерживается = КонтекстЭДО.ПечатьИзЭлектронногоПредставленияНеПоддерживается(ВидОтчета);
	
	Если НЕ ПечатьНеПоддерживается И ЗначениеЗаполнено(ВидОтчета) Тогда
		ВыводЧерезВебСервис = РегламентированнаяОтчетностьВызовСервера.ПроверитьВозможностьВыводаМашиночитаемойФормыЧерезВебСервис(АдресПараметровПроксиВоВременномХранилище, , ЭтоВебКлиент);
		
		Если ВыводЧерезВебСервис Тогда
			НаименованиеОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтчета, "Источник");
			НаименованиеОтчета = ?(ЗначениеЗаполнено(НаименованиеОтчета), НаименованиеОтчета, "РегламентированныйОтчет" + Строка(ВидОтчета));
			Если Метаданные.Отчеты.Найти(НаименованиеОтчета) = Неопределено Тогда
				ВыводЧерезВебСервис = Ложь;
				НаименованиеОтчета = "";
				
			Иначе
				НаименованиеОтчета = "Отчет." + НаименованиеОтчета + ".Форма.ОсновнаяФорма";
				
				Если ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС И ЗначениеЗаполнено(Получатель) И ТипЗнч(Получатель) = Тип("СправочникСсылка.НалоговыеОрганы") Тогда
					НаименованиеИФНС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель, "Наименование");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СвойстваОтчета = Новый Структура("ТипПолучателя, НаименованиеОтчета, НаименованиеИФНС", ТипПолучателя, НаименованиеОтчета, НаименованиеИФНС);
	
	Возврат ПечатьНеПоддерживается;
	
КонецФункции

&НаКлиенте
Процедура ПечатьЭлектронногоПредставления(ЭлектронноеПредставление, АдресДанных = Неопределено, 
		Знач ПользовательскоеНаименованиеОтчета = Неопределено, ИмяФайла = "") Экспорт
		
	ЭтоВебКлиент = ЭтоВебКлиент();
	ВидОтчета = Неопределено;
	ВыводЧерезВебСервис = Ложь;
	АдресПараметровПроксиВоВременномХранилище = "";
	СвойстваОтчета = Неопределено;
	
	ПечатьНеПоддерживается = ПечатьИзЭлектронногоПредставленияНеПоддерживается(ЭлектронноеПредставление, ВидОтчета, ЭтоВебКлиент, ВыводЧерезВебСервис, АдресПараметровПроксиВоВременномХранилище, СвойстваОтчета);
	Если ПечатьНеПоддерживается Тогда
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("ОК");
		СписокКнопок.Добавить("Подробнее", НСтр("ru = 'Подробнее...';
												|en = 'Подробнее...'"));
		
		ТекстВопроса = НСтр("ru = 'Для ""%1"" возможность печати не предусмотрена';
							|en = 'Для ""%1"" возможность печати не предусмотрена'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ВидОтчета);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПечатьЭлектронногоПредставленияПослеВыбораОтветаНаВопрос", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок);
		Возврат;
	КонецЕсли;
	
	Если Не ВыводЧерезВебСервис И НЕ БраузерПоддерживаетРаботуСКомпонентойПечатиМашиночитаемыхБланков() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресДанных) ИЛИ (ВыводЧерезВебСервис И НЕ ЗначениеЗаполнено(ИмяФайла)) Тогда
		АдресДанных = АдресДанныхЭлектронногоПредставления(ЭлектронноеПредставление, ИмяФайла);
	КонецЕсли;
	
	Если АдресДанных = Неопределено Тогда
		ПоказатьПредупреждение(, "Электронное представление не определено!");
		Возврат;
	КонецЕсли;
	
	Если ВыводЧерезВебСервис Тогда
		Если ВРег(Прав(ИмяФайла, 4)) <> ".TXT" Тогда
			КодировкаТекстаВыгрузки = "windows-1251";
			Если (СвойстваОтчета.ТипПолучателя = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСГС") И (НЕ ВРег(Лев(ИмяФайла, 6)) = "NO_BUH") И (НЕ ВРег(Лев(ИмяФайла, 6)) = "NO_BOU"))
			ИЛИ СвойстваОтчета.ТипПолучателя = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РПН") ИЛИ СвойстваОтчета.ТипПолучателя = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФТС") Тогда
				КодировкаТекстаВыгрузки = "utf-8";
			КонецЕсли;
		Иначе
			КодировкаТекстаВыгрузки = "cp866";
		КонецЕсли;
		
		ФайлВыгрузкиВоВременномХранилище = Новый Структура;
		ФайлВыгрузкиВоВременномХранилище.Вставить("АдресФайлаВыгрузкиВоВременномХранилище", АдресДанных);
		ФайлВыгрузкиВоВременномХранилище.Вставить("ИмяФайлаВыгрузки", ИмяФайла);
		ФайлВыгрузкиВоВременномХранилище.Вставить("КодировкаФайлаВыгрузки", КодировкаТекстаВыгрузки);
		
		ПараметрыСформированногоОтчета = Новый Структура;
		Если РегламентированнаяОтчетностьВызовСервера.ВывестиМашиночитаемуюФормуЧерезВебСервис(СвойстваОтчета.НаименованиеОтчета, СвойстваОтчета.НаименованиеИФНС, ФайлВыгрузкиВоВременномХранилище, ПараметрыСформированногоОтчета, АдресПараметровПроксиВоВременномХранилище) Тогда
			РасширениеФайлаОтчета = "pdf";
			ИмяФайлаВыгрузки = Неопределено;
			Если ФайлВыгрузкиВоВременномХранилище.Свойство("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки) И ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
				ПозицияТочки = СтрНайти(ИмяФайлаВыгрузки, ".");
				ИмяФайлаОтчета = ?(ПозицияТочки = 0, ИмяФайлаВыгрузки, Лев(ИмяФайлаВыгрузки, ПозицияТочки - 1)) + "." + РасширениеФайлаОтчета;
			Иначе
				ИмяФайлаОтчета = "" + Новый УникальныйИдентификатор() + "." + РасширениеФайлаОтчета;
			КонецЕсли;
			
			// Дополним список параметров для получения отчета
			ПараметрыСформированногоОтчета.Вставить("АдресПараметровПроксиВоВременномХранилище", АдресПараметровПроксиВоВременномХранилище);
			
			// Откроем специальную форму длительной операции. Из нее с возрастающим периодом
			// производится вызов серверной процедуры для проверки готовности отчета на веб-сервисе.
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ПараметрыВызоваЭкспортнойПроцедуры", ПараметрыСформированногоОтчета);
			ПараметрыФормы.Вставить("ИмяФайлаОтчета", ИмяФайлаОтчета);
			
			РегламентированнаяОтчетностьКлиент.ПолучитьОбщуюФормуПоИмени("ДлительнаяОперацияПриПолученииМЧБ", ПараметрыФормы, ЭтаФорма).Открыть();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Сохранение в файл.
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЭлектронноеПредставление",	ЭлектронноеПредставление);
	ДополнительныеПараметры.Вставить("ВидОтчета", 					ВидОтчета);
	ДополнительныеПараметры.Вставить("АдресДанных", 				АдресДанных);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПечатьЭлектронногоПредставленияПослеСохраненияВФайл", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ОперацииСФайламиЭДКОКлиент.ДанныеССервераВФайл(ОписаниеОповещения, АдресДанных, ".bin");
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭлектронногоПредставленияПослеВыбораОтветаНаВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = "Подробнее" Тогда
		ОткрытьФорму("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.Форма.СписокОтчетовПоддерживающихПечать")	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭлектронногоПредставленияПослеУстановкиКомпоненты(ТаксДокПринт, ВремКаталог, ВремФайл)
	
	Если ТаксДокПринт <> Неопределено Тогда
		Попытка
			ТаксДокПринт.PrintTiffFolder = ВремКаталог;
			ТаксДокПринт.PreviewFile1C(ВремФайл, 0);
			Результат = Истина;
		Исключение
			ОбработатьОшибкуМодуляПечати();
			ТаксДокПринт = Неопределено;
			Результат = Ложь;
		КонецПопытки;
		
	Иначе
		
		#Если ВебКлиент Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПечатьЭлектронногоПредставленияПослеУстановкиКомпонентыЗавершение", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Формирование бланка формы прервано. Не удалось подключить вспомогательную
								 |компоненту для формирования бланков форм с двухмерным штрихкодом PDF417.
								 |Возможно, браузер не настроен в соответствии с особенностями настройки веб-браузера.
								 |Открыть справочную информацию с описанием особенностей настроек веб-браузера?';
								 |en = 'Формирование бланка формы прервано. Не удалось подключить вспомогательную
								 |компоненту для формирования бланков форм с двухмерным штрихкодом PDF417.
								 |Возможно, браузер не настроен в соответствии с особенностями настройки веб-браузера.
								 |Открыть справочную информацию с описанием особенностей настроек веб-браузера?'"), РежимДиалогаВопрос.ДаНет);
								
		#КонецЕсли
		
	КонецЕсли;
	
	ТаксДокПринт = Неопределено;
	
	// чистим временные каталоги.
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ВремФайл);

КонецПроцедуры

#Если ВебКлиент Тогда
	
&НаКлиенте	
Процедура ПечатьЭлектронногоПредставленияПослеУстановкиКомпонентыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ОткрытьСправку("v8help://1cv8/FeatureIE");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли

&НаКлиенте
Процедура ПечатьЭлектронногоПредставленияВопросУстановитьКомпонентуЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТаксДокПринт = ДополнительныеПараметры.ТаксДокПринт;
	ВремКаталог = ДополнительныеПараметры.ВремКаталог;
	ВремФайл = ДополнительныеПараметры.ВремФайл;
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Результат = Ложь;
	Иначе
		// если не удалось создать объект и пользователь не против, то запускаем установку компоненты
		Если НЕ РегламентированнаяОтчетностьКлиент.УстановитьКомпонентуПечатиМашиночитаемыхФорм(Истина, ДистрибутивКомпонентыПечатиМашиночитаемыхФорм, ВремКаталог) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Формирование машиночитаемой формы прервано: в системе не установлена вспомогательная компонента.';
										|en = 'Формирование машиночитаемой формы прервано: в системе не установлена вспомогательная компонента.'"));
			Результат = Ложь;
		Иначе
			ТаксДокПринт = РегламентированнаяОтчетностьКлиент.СоздатьОбъектДляФормированияМашиночитаемойФормы();
			КомпонентаУжеУстанавливалась = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ПечатьЭлектронногоПредставленияПослеУстановкиКомпоненты(ТаксДокПринт, ВремКаталог, ВремФайл);
	
КонецПроцедуры

&НаСервере
Функция СформироватьСтруктуруПараметровФайлаВыгрузки(АдресДанных)
	
	ФайлВыгрузки = ПолучитьИмяВременногоФайла();
	ПолучитьИзВременногоХранилища(АдресДанных).Записать(ФайлВыгрузки);
	
	ПоказателиВыгрузки = Новый Соответствие;
	ОбъектЧтениеXML = Новый ЧтениеXML;
	Попытка
		ОбъектЧтениеXML.ОткрытьФайл(ФайлВыгрузки);
		ОбъектЧтениеXML.ИгнорироватьПробелы = Ложь;
		Пока ОбъектЧтениеXML.Прочитать() Цикл
			Если ОбъектЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ОбъектЧтениеXML.Имя <> "СодПерСвед" Тогда
				Пока ОбъектЧтениеXML.ПрочитатьАтрибут() Цикл
					ПоказателиВыгрузки.Вставить(ОбъектЧтениеXML.Имя, ОбъектЧтениеXML.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	
		ОбъектЧтениеXML.Закрыть();
		ПоказателиВыгрузки.Вставить("ЭтоXML", Истина);
	Исключение
		ОбъектЧтениеXML.Закрыть();
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ФайлВыгрузки, "cp866");
		ТекСтр = Текст.ПрочитатьСтроку();
		Пока ТекСтр <> Неопределено Цикл
			ТекСтр = СокрЛП(ТекСтр);
			ВхождениеДвоеточия = СтрНайти(ТекСтр, ":");
			Если ВхождениеДвоеточия <> 0 Тогда
				ПоказателиВыгрузки.Вставить(СокрЛП(Лев(ТекСтр, ВхождениеДвоеточия - 1)), СокрЛП(Сред(ТекСтр, ВхождениеДвоеточия + 1)));
			КонецЕсли;
			ТекСтр = Текст.ПрочитатьСтроку();
		КонецЦикла;
		Текст.Закрыть();
		Текст = Неопределено;
		ПоказателиВыгрузки.Вставить("ЭтоXML", Ложь);
	КонецПопытки;
	
	УдалитьФайлы(ФайлВыгрузки);
	
	Возврат ПоказателиВыгрузки;

КонецФункции

&НаСервереБезКонтекста
Функция АдресДанныхЭлектронногоПредставления(Ссылка, ИмяФайла = "")
	
	АдресДанных = Неопределено;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	СвойстваФайлов = КонтекстЭДОСервер.ИзвлечьЭлектронныеПредставленияВХранилище(Ссылка, Неопределено);
	Если СвойстваФайлов <> Неопределено Тогда 
		Если Ссылка.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НДС Тогда
			Для каждого СвойствоФайла Из СвойстваФайлов Цикл
				Если СтрНайти(СвойствоФайла.ИмяФайла, "NO_NDS_") Тогда	
					АдресДанных = СвойствоФайла.Данные;
					ИмяФайла = СвойствоФайла.ИмяФайла;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если СвойстваФайлов.Количество() > 0 Тогда
				АдресДанных = СвойстваФайлов[0].Данные;
				ИмяФайла = СвойстваФайлов[0].ИмяФайла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(АдресДанных, Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура СоздатьОтчетЗаданногоВида(Объект, СтруктураПараметров, ИспользоватьКомпоненту, ВозниклаОшибка = Ложь);
	
	ТаблицаШаблонов.Очистить();
	
	ИсточникОтчета = ?(ТипЗнч(Объект.ВидОтчета) = Тип("СправочникСсылка.ВидыОтправляемыхДокументов"), Объект.ВидОтчета.Источник, Объект.ВидОтчета.ИсточникОтчета);
	Если ИсточникОтчета <> Неопределено Тогда
		ОбъектОтчет = РеглОтчеты(ИсточникОтчета, Истина);
	КонецЕсли;
	
	КаталогВремФайлов = КаталогВременныхФайлов();
	КаталогВремФайлов = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВремФайлов);
	ВремКаталог = КаталогВремФайлов + Строка(Новый УникальныйИдентификатор);
	ВремКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВремКаталог);
	СоздатьКаталог(ВремКаталог);
	
	ВерсияФорматаВыгрузки = ?(СтруктураПараметров["ЭтоXML"], СтруктураПараметров["ВерсФорм"], СтруктураПараметров["ВерФОтч"]);
	
	// выгружаем во временный каталог шаблоны печати, соответствующие сформированному файлу выгрузки
	ВыгрузкаУспешна = ВыгрузитьШаблоныПечатиВКаталог(
		ОбъектОтчет, 
		ВремКаталог, 
		СтруктураПараметров["КНД"], 
		ВерсияФорматаВыгрузки, 
		ДистрибутивКомпонентыПечатиМашиночитаемыхФорм);
	
	Если НЕ ВыгрузкаУспешна Тогда
		ВозниклаОшибка = Истина;
		Возврат;
	КонецЕсли;
	
	// поместить файлы шаблонов печати в хранилище
	ФайлыВыгрузки = НайтиФайлы(ВремКаталог, "*");
	Для Каждого ФайлВыгрузки Из ФайлыВыгрузки Цикл
		НоваяСтрока = ТаблицаШаблонов.Добавить();
		НоваяСтрока.Имя = ФайлВыгрузки.Имя;
		ПолноеИмяФайла = ФайлВыгрузки.ПолноеИмя;
		Если ИспользоватьКомпоненту Тогда 
			ФайлОбработкиBase64 = Base64Строка(Новый ДвоичныеДанные(ПолноеИмяФайла));
			СтрокаЗамены = Символ(13) + Символ(10);
			ФайлОбработкиBase64 = СтрЗаменить(ФайлОбработкиBase64, СтрокаЗамены, "");
			
			ГУИД = Новый УникальныйИдентификатор;
			НоваяСтрока.АдресСодержимого = ПоместитьВоВременноеХранилище(ФайлОбработкиBase64, ГУИД);
		Иначе 
			ГУИД = Новый УникальныйИдентификатор;
			НоваяСтрока.АдресСодержимого = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	// обязательно удалить временный каталог
	УдалитьФайлы(ВремКаталог);
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьШаблоныПечатиВКаталог(
		Объект,
		ВремКаталог,
		Знач КНД,
		Знач ВерсияФорматаВыгрузки,
		ДистрибутивКомпонентыПечатиМашиночитаемыхФорм)
	
	ТочныеПараметрыШаблонаЗаданы = (ЗначениеЗаполнено(КНД) И ЗначениеЗаполнено(ВерсияФорматаВыгрузки));
	
	// если точные параметры заданы, то сначала пытаемся извлечь внутренний шаблон
	КоличествоВыгруженныхШаблонов = 0;
	Если ТочныеПараметрыШаблонаЗаданы Тогда
		ИспользуемыйШаблон = Неопределено;
		Пока СтрДлина(ВерсияФорматаВыгрузки) < 7 Цикл
			ВерсияФорматаВыгрузки = ВерсияФорматаВыгрузки + "0";
		КонецЦикла;
		ПрефиксИмениШаблона = СокрЛП(КНД + "_" + ВерсияФорматаВыгрузки);
		ПрефиксИмениМакетаШаблона = "МБ_" + СтрЗаменить(ПрефиксИмениШаблона, ".", "_");
	Иначе
		ПрефиксИмениМакетаШаблона = "МБ_";
	КонецЕсли;
	
	ШаблоныМашиночитаемыхФорм = ПолучитьШаблоныМашиночитаемыхФорм(Объект, ПрефиксИмениМакетаШаблона, КоличествоВыгруженныхШаблонов, ТочныеПараметрыШаблонаЗаданы, ПрефиксИмениШаблона, ДистрибутивКомпонентыПечатиМашиночитаемыхФорм);//ДистрибутивКомпонентыПечатиМашиночитаемыхФорм);
	
	Если ШаблоныМашиночитаемыхФорм.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти необходимый шаблон машиночитаемой формы';
								|en = 'Не удалось найти необходимый шаблон машиночитаемой формы'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	Иначе
		Для Каждого Элемент Из ШаблоныМашиночитаемыхФорм Цикл
			
			Попытка
				
				Элемент.Значение.Записать(ВремКаталог + Элемент.Представление);
				
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось выгрузить шаблон машиночитаемой формы ""%1"" во временный каталог!%2';
																								|en = 'Не удалось выгрузить шаблон машиночитаемой формы ""%1"" во временный каталог!%2'"), Элемент.Представление, Символы.ПС + ОписаниеОшибки());
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
				
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОшибкуМодуляПечати()
	
	ОписаниеОшибки = СокрЛП(ОписаниеОшибки());
	КодОшибки = Сред(ОписаниеОшибки, СтрНайти(ОписаниеОшибки, "0x"), 10);
	
	ТекстПредупреждения = "";
	Если КодОшибки = "0x80040004" ИЛИ КодОшибки = "0x80040005" Тогда
		ТекстПредупреждения = "Не удалось установить параметр печати!";
	ИначеЕсли КодОшибки = "0x80040001" Тогда
		ТекстПредупреждения = "При попытке печати в компоненте печати возникла неизвестная ошибка!";
	ИначеЕсли КодОшибки = "0x80040032" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось найти файл выгрузки отчета!";
	ИначеЕсли КодОшибки = "0x80040033" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось получить доступ к файлу выгрузки отчета!";
	ИначеЕсли КодОшибки = "0x8004000A" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось распознать формат файла выгрузки!";
	ИначеЕсли КодОшибки = "0x8004000B" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось распознать формат файла выгрузки!";
	ИначеЕсли КодОшибки = "0x8004000F" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось распознать версию формата выгрузки из текста выгрузки!";
	ИначеЕсли КодОшибки = "0x80040010" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось распознать форму по КНД в файле выгрузки!";
	ИначеЕсли КодОшибки = "0x80040014" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось сформировать машиночитаемую форму по причине некорректного файла выгрузки!";
	ИначеЕсли КодОшибки = "0x8004003C" Тогда
		ТекстПредупреждения = "Отсутствует шаблон для формирования машиночитаемой формы!";
	ИначеЕсли КодОшибки = "0x80040046" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось найти каталог с шаблонами для печати!";
	ИначеЕсли КодОшибки = "0x80050035" Тогда
		ТекстПредупреждения = "Не найдена одна из вспомогательных библиотек, используемых компонентой печати (GNIVCPDOC.dll)!";
	ИначеЕсли КодОшибки = "0x800501C5" Тогда
		ТекстПредупреждения = "Одна из вспомогательных библиотек, используемых компонентой печати (GNIVCPDOC.dll), подменена или устарела!";
	ИначеЕсли КодОшибки = "0x80050030" Тогда
		ТекстПредупреждения = "Одна из вспомогательных библиотек, используемых компонентой печати (GNIVCPDOC.dll), повреждена!";
	ИначеЕсли КодОшибки = "0x80040064" Тогда // печать прервана
		Возврат;
	ИначеЕсли КодОшибки = "0x80040001" Тогда
		ТекстПредупреждения = "Компоненте печати не удалось найти каталог с шаблонами для печати!";
	Иначе
		ТекстПредупреждения = ОписаниеОшибки;
	КонецЕсли;

	Если ТекстПредупреждения = "" Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'При формировании машиночитаемой формы возникла неизвестная ошибка';
									|en = 'При формировании машиночитаемой формы возникла неизвестная ошибка'"));
	Иначе
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РеглОтчеты(Наим, НеЗапоминатьВКэше = Ложь) Экспорт
		
	Перем ВременныйФайл;
	Перем ПараметрыОтчета;
	
	НайденныйЭлемент = Справочники.РегламентированныеОтчеты.НайтиПоРеквизиту("ИсточникОтчета", Наим);
	Если НайденныйЭлемент = Справочники.РегламентированныеОтчеты.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Метаданные.Документы.Найти(Наим) <> Неопределено Тогда
		
		Возврат Документы[Наим];
		
	ИначеЕсли Метаданные.Отчеты.Найти(Наим) <> Неопределено Тогда
		
		Возврат Отчеты[Наим];
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Возврат Неопределено;
			
КонецФункции

&НаСервере
Функция ПолучитьШаблоныМашиночитаемыхФорм(Знач ИмяОтчета, ПрефиксИмениМакетаШаблона, КоличествоВыгруженныхШаблонов, ТочныеПараметрыШаблонаЗаданы, ПрефиксИмениШаблона, ДистрибутивКомпонентыПечатиМашиночитаемыхФорм) Экспорт
	
	ШаблоныМашиночитаемыхФорм = Новый СписокЗначений;
	
	Если СтрНайти(ИмяОтчета, "ОтчетМенеджер") > 0 Тогда
		ИмяОтчета = Сред(ИмяОтчета, СтрДлина("ОтчетМенеджер.") + 1);
	Иначе
		ИмяОтчета = Сред(Лев(ИмяОтчета, СтрНайти(ИмяОтчета, ".Форма.") - 1), 7);
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.Отчеты.Найти(ИмяОтчета);
	
	Если ОбъектМетаданных <> Неопределено Тогда
		Попытка
			МакетыОтчета = ОбъектМетаданных.Макеты;
		
			Для Каждого МакетОтчета Из МакетыОтчета Цикл
				Если МакетОтчета.ТипМакета = Метаданные.СвойстваОбъектов.ТипМакета.ДвоичныеДанные
				И Лев(нрег(МакетОтчета.Имя), СтрДлина(ПрефиксИмениМакетаШаблона)) = нрег(ПрефиксИмениМакетаШаблона) Тогда
					СинонимМакета = СокрЛП(МакетОтчета.Синоним);
					ВхождениеПробела = СтрНайти(СинонимМакета, " ");
					ИмяФайлаШаблона = ?(ВхождениеПробела = 0, СинонимМакета, Лев(СинонимМакета, СтрДлина(ВхождениеПробела - 1)));
					Попытка
						ШаблоныМашиночитаемыхФорм.Добавить(Отчеты[ОбъектМетаданных.Имя].Создать().ПолучитьМакет(МакетОтчета.Имя), ИмяФайлаШаблона);
						КоличествоВыгруженныхШаблонов = КоличествоВыгруженныхШаблонов + 1;
					Исключение
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось получить шаблон машиночитаемой формы ""%1""!%2';
																										|en = 'Не удалось получить шаблон машиночитаемой формы ""%1""!%2'"), ИмяФайлаШаблона, Символы.ПС + ОписаниеОшибки());
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
		Исключение
		КонецПопытки;
	КонецЕсли;
	// выгружаем внешние шаблоны
	Если ТочныеПараметрыШаблонаЗаданы Тогда
		РезультатЗапроса = ВыполнитьЗапросКРегиструШаблоновПечатиМашиночитаемыхФорм(ПрефиксИмениШаблона + "%");
		Если КоличествоВыгруженныхШаблонов = 0 И РезультатЗапроса.Пустой() Тогда
			РезультатЗапроса = ВыполнитьЗапросКРегиструШаблоновПечатиМашиночитаемыхФорм();
		КонецЕсли;
	Иначе
		РезультатЗапроса = ВыполнитьЗапросКРегиструШаблоновПечатиМашиночитаемыхФорм();
	КонецЕсли;
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Если КоличествоВыгруженныхШаблонов = 0 Тогда
			ТекстСообщения  = НСтр("ru = 'В регистре сведений ""Шаблоны печати машиночитаемых форм"" отсутствует необходимый шаблон.
	                                |Скачайте необходимые шаблоны с сайта http://www.gnivc.ru/ или любого другого сайта и загрузите их в регистр сведений ""Шаблоны печати машиночитаемых форм""';
	                                |en = 'В регистре сведений ""Шаблоны печати машиночитаемых форм"" отсутствует необходимый шаблон.
	                                |Скачайте необходимые шаблоны с сайта http://www.gnivc.ru/ или любого другого сайта и загрузите их в регистр сведений ""Шаблоны печати машиночитаемых форм""'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				ШаблоныМашиночитаемыхФорм.Добавить(Выборка.Шаблон.Получить(), Выборка.ИмяФайлаШаблона);
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось получить шаблон машиночитаемой формы ""%1""!%2';
																								|en = 'Не удалось получить шаблон машиночитаемой формы ""%1""!%2'"), Выборка.ИмяФайлаШаблона, Символы.ПС + ОписаниеОшибки());
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
		
	РегламентированнаяОтчетностьВызовСервера.ПолучитьДистрибутивКомпонентыПечатиМашиночитаемыхФорм(ДистрибутивКомпонентыПечатиМашиночитаемыхФорм);
	
	Возврат ШаблоныМашиночитаемыхФорм;
	
КонецФункции // ПолучитьШаблоныМашиночитаемыхФорм()

&НаСервере
Функция ВыполнитьЗапросКРегиструШаблоновПечатиМашиночитаемыхФорм(ИмяФайлаШаблона = Неопределено)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ШаблоныПечатиМашиночитаемыхФорм.ИмяФайлаШаблона,
	                      |	ШаблоныПечатиМашиночитаемыхФорм.Шаблон
	                      |ИЗ
	                      |	РегистрСведений.ШаблоныПечатиМашиночитаемыхФорм КАК ШаблоныПечатиМашиночитаемыхФорм");
	Если ИмяФайлаШаблона <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
						  |ГДЕ
						  |	ШаблоныПечатиМашиночитаемыхФорм.ИмяФайлаШаблона ПОДОБНО &ИмяФайлаШаблона
						  |УПОРЯДОЧИТЬ ПО
						  |	ШаблоныПечатиМашиночитаемыхФорм.ИмяФайлаШаблона УБЫВ";
		Запрос.УстановитьПараметр("ИмяФайлаШаблона", ИмяФайлаШаблона);
	КонецЕсли;
	Возврат Запрос.Выполнить();
	
КонецФункции

&НаКлиенте
Процедура ВыгрузкаЭлектронногоПредставления(ЭлектронноеПредставление) Экспорт
	
	Если ЗначениеЗаполнено(ЭлектронноеПредставление) Тогда
		
		КонтекстПредставления = Новый Структура("Документ", ЭлектронноеПредставление);
		КонтекстПредставления.Вставить("УникальныйИдентификатор", ЭтотОбъект.УникальныйИдентификатор);
		Результат = ВыгрузитьРегламентированныйОтчетПФРИзВнешнихЭлектронныхПредставлений(КонтекстПредставления);
		ВсегоВАрхиве = 0;
		Для Каждого Запись Из Результат Цикл
			Если Запись.ВАрхиве Тогда
				ВсегоВАрхиве = ВсегоВАрхиве + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсегоВАрхиве > 0 Тогда //Данные одного или более файлов отсутствуют
			ПоказатьУведомлениеАрхивныхФайлов(, 24, 0, Истина);			
			Возврат;
		КонецЕсли;
		
		Если НЕ ПолучитьДанныеЭлектронногоПредставленияНаСервере(ЭлектронноеПредставление) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Данные для выгрузки отсутствуют';
																|en = 'Данные для выгрузки отсутствуют'"));
			Возврат;
		КонецЕсли;
		
		Если ВыборкаСодержимого.Количество() = 0 Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Данные для выгрузки отсутствуют';
																|en = 'Данные для выгрузки отсутствуют'"));
			Возврат;
		КонецЕсли;
		
		МассивИменФайлов = Новый Массив;
		МассивОписанийПолучаемыеФайлы = Новый Массив;
		Для Каждого Контейнер Из ВыборкаСодержимого Цикл 
			МассивИменФайлов.Добавить(Контейнер.КороткоеИмяФайла);
			ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(Контейнер.КороткоеИмяФайла, Контейнер.АдресСодержимого); 
			МассивОписанийПолучаемыеФайлы.Добавить(ОписаниеФайла);
		КонецЦикла;
		
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(МассивОписанийПолучаемыеФайлы);
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите файлы, которые следует сохранить на диск, и повторите попытку';
										|en = 'Выберите файлы, которые следует сохранить на диск, и повторите попытку'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеЭлектронногоПредставленияНаСервере(ЭлектронноеПредставление)
	
	ОчиститьТаблицуИХранилище();
	
	НаборЗаписей = РегистрыСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронноеПредставление.Установить(ЭлектронноеПредставление);
	НаборЗаписей.Прочитать();

	Для каждого Запись Из НаборЗаписей Цикл
	
		НоваяСтрока 					= ВыборкаСодержимого.Добавить();
		ГУИД 							= Новый УникальныйИдентификатор;
		НоваяСтрока.КороткоеИмяФайла 	= Запись.ИмяФайла;
	    НоваяСтрока.АдресСодержимого 	= ПоместитьВоВременноеХранилище(Запись.Данные.Получить(), ГУИД);
	
	КонецЦикла; 
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОчиститьТаблицуИХранилище()
	
	Если ВыборкаСодержимого.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Выборка Из ВыборкаСодержимого Цикл 
		УдалитьИзВременногоХранилища(Выборка.АдресСодержимого);
	КонецЦикла;
	
	ВыборкаСодержимого.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПротоколОтправкиФСС(ПоследняяОтправка) Экспорт
	
	ИдентификаторОтправкиНаСервере = "";
	Адрес = ПолучитьАдресФайлаПротоколаФСС(ПоследняяОтправка, ИдентификаторОтправкиНаСервере);
	ПолучитьФайл(Адрес, НСтр("ru = 'Протокол';
							|en = 'Протокол'") + "_" + ИдентификаторОтправкиНаСервере + ".html");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАдресФайлаПротоколаФСС(ОтправкаСсылка, ИдентификаторОтправкиНаСервере)
	
	
	ИдентификаторОтправкиНаСервере = ОтправкаСсылка.ИдентификаторОтправкиНаСервере;
	
	СтрПротокол = ОтправкаСсылка.Протокол.Получить();
	ВременныйФайл = ПолучитьИмяВременногоФайла();
	Текст = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	Текст.Записать(СтрПротокол);
	Текст.Закрыть();
	
	Возврат ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВременныйФайл));
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоследнююОтправкуОтчетаВФСС(Ссылка) Экспорт
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ПолучитьПоследнююОтправкуОтчетаВФСС(Ссылка);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоследнююОтправкуОтчетаВФСРАР(Ссылка) Экспорт
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ПолучитьПоследнююОтправкуОтчетаВФСРАР(Ссылка);

КонецФункции

&НаКлиенте
Процедура ПолучитьПротоколОтправкиФСРАР(ПоследняяОтправка) Экспорт
	
	ИмяФайлаПакетаДоТочки = "";
	Адрес = ПолучитьАдресФайлаПротоколаФСРАР(ПоследняяОтправка, ИмяФайлаПакетаДоТочки);
	
	ПозицияТочки = СтрНайти(ИмяФайлаПакетаДоТочки, ".");
