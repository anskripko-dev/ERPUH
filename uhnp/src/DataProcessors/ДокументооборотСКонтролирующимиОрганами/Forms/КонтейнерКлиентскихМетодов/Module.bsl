&НаСервере
Функция ПолучитьДанныеПоФайламВыгрузкиОписиИсходящихДокументов(ОписьСсылка, ИдентификаторОтправителяПолучателя, УникальныйИдентификаторФормы)
	
	ТаблицаНеДокФорм = ШаблонТаблицыНеДокФорм();
	ТаблицаДокФорм 	 = ШаблонТаблицыДокФорм();

	ТипСкан = Тип("СправочникСсылка.СканированныеДокументыДляПередачиВЭлектронномВиде");
	
	// СоответствиеФайлыПринадлежащиеОписи: ключ - имя файла, значение - адрес во временном хранилище
	СоответствиеФайлыПринадлежащиеОписи	= ПолучитьФайлыПринадлежащиеОписи(ОписьСсылка, УникальныйИдентификаторФормы);
	
	Для каждого СтрокаПредставляемыйДокумент Из ОписьСсылка.ПредставляемыеДокументы Цикл
	
		Если ТипЗнч(СтрокаПредставляемыйДокумент.СсылкаНаОбъект) = ТипСкан Тогда
	
			ДобавитьСтрокуТаблицыНеДокФорм(
				ИдентификаторОтправителяПолучателя, 
				УникальныйИдентификаторФормы,
				СтрокаПредставляемыйДокумент,
				ТаблицаНеДокФорм,
				ОписьСсылка);

		Иначе

			ДобавитьСтрокуТаблицыДокФорм(
				СтрокаПредставляемыйДокумент,
				СоответствиеФайлыПринадлежащиеОписи,
				ТаблицаДокФорм,
				ОписьСсылка);
	
		КонецЕсли;
	
	КонецЦикла;

	ДобавитьТекстовоеПояснение(
		ИдентификаторОтправителяПолучателя, 
		УникальныйИдентификаторФормы,
		ТаблицаНеДокФорм,
		ОписьСсылка);

	Результат = Новый Структура;
	Результат.Вставить("ТаблицаНеДокФорм", 	ТаблицаНеДокФорм);
	Результат.Вставить("ТаблицаДокФорм", 	ТаблицаДокФорм);

	Возврат Результат;
		
КонецФункции

&НаСервереБезКонтекста
Функция ШаблонТаблицыДокФорм()
			
	ТаблицаДокФорм = Новый ТаблицаЗначений;
	ТаблицаДокФорм.Колонки.Добавить("ПорНом");
	ТаблицаДокФорм.Колонки.Добавить("ВидДокумента");

	// Сведения по документу 
	ТаблицаДокФорм.Колонки.Добавить("КНД");
			
	ТаблицаДокФорм.Колонки.Добавить("ИмяФайлаДанных");
	ТаблицаДокФорм.Колонки.Добавить("АдресФайлаДанных");

	ТаблицаДокФорм.Колонки.Добавить("ИмяФайлаПодписи");
	ТаблицаДокФорм.Колонки.Добавить("АдресФайлаПодписи");
			
	// Сведения по документу-основанию
	ТаблицаДокФорм.Колонки.Добавить("СведенияДокументаОснования");

	ТаблицаДокФорм.Колонки.Добавить("ПодтверждениеКНД");
				
	// Сведения по документу-подтвержению
	ТаблицаДокФорм.Колонки.Добавить("ПодтверждениеИмяФайлаДанных");
	ТаблицаДокФорм.Колонки.Добавить("ПодтверждениеАдресФайлаДанных");
				
	ТаблицаДокФорм.Колонки.Добавить("ПодтверждениеИмяФайлаПодписи");
	ТаблицаДокФорм.Колонки.Добавить("ПодтверждениеАдресФайлаПодписи");
				
	ТаблицаДокФорм.Колонки.Добавить("ПредставлениеДокумента");
				
	ТаблицаДокФорм.Колонки.Добавить("ЭтоПакетСДопДокументами");
				
	Возврат ТаблицаДокФорм;
				
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьСтрокуТаблицыДокФорм(
	СтрокаПредставляемыйДокумент,
	СоответствиеФайлыПринадлежащиеОписи,
	ТаблицаДокФорм,
	ОписьСсылка)
	
НовСтр = ТаблицаДокФорм.Добавить();  
	
	НовСтр.ПорНом = ?(СтрокаПредставляемыйДокумент.ЯвляетсяИнформацией, "2.", "1.") 
	+ Формат(СтрокаПредставляемыйДокумент.ПорядковыйНомер, "ЧЦ=2; ЧН=; ЧВН=");
	
	НовСтр.ВидДокумента = СтрокаПредставляемыйДокумент.ВидДокумента;
	
	НовСтр.КНД = СтрокаПредставляемыйДокумент.КНД;
	
	СведенияДокументаОснования 	= СтрокаПредставляемыйДокумент.СведенияДокументаОснования;
	НомерДокументаОснования 	= СтрокаПредставляемыйДокумент.НомерДокументаОснования;
	ДатаДокументаОснования 		= СтрокаПредставляемыйДокумент.ДатаДокументаОснования;
	
	Если ЗначениеЗаполнено(СведенияДокументаОснования) Тогда
		НовСтр.СведенияДокументаОснования = СведенияДокументаОснования;
	ИначеЕсли ЗначениеЗаполнено(НомерДокументаОснования) ИЛИ ЗначениеЗаполнено(ДатаДокументаОснования) Тогда
		НовСтр.СведенияДокументаОснования = НомерДокументаОснования + " от " + Формат(ДатаДокументаОснования, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	НовСтр.ИмяФайлаДанных 	= СтрокаПредставляемыйДокумент.ИмяФайлаДанных;
	НовСтр.АдресФайлаДанных = СоответствиеФайлыПринадлежащиеОписи[СтрокаПредставляемыйДокумент.ИмяФайлаДанных];
	
	Если ЗначениеЗаполнено(СтрокаПредставляемыйДокумент.ИмяФайлаПодписи) Тогда
		
		НовСтр.ИмяФайлаПодписи 		= ИсправленнноеИмяФайлаЭПФайлаОписиИсходящихДокументов(
			СтрокаПредставляемыйДокумент.ИмяФайлаПодписи,
			СтрокаПредставляемыйДокумент.ИмяФайлаДанных);
			
		НовСтр.АдресФайлаПодписи	= СоответствиеФайлыПринадлежащиеОписи[СтрокаПредставляемыйДокумент.ИмяФайлаПодписи];
		
	Иначе
		// При отправке журнал учета СФ и книг не имеют файла подписи.
		// Адрес с данными подписи будет сформирован позже.
		НовСтр.ИмяФайлаПодписи 		= ИмяФайлаЭПФайлаОписиИсходящихДокументов(СтрокаПредставляемыйДокумент.ИмяФайлаДанных);
	КонецЕсли;
	
	НовСтр.ПодтверждениеКНД = СтрокаПредставляемыйДокумент.ПодтверждениеКНД; 
	
	Если ЗначениеЗаполнено(СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаДанных) Тогда
		НовСтр.ПодтверждениеИмяФайлаДанных 		= СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаДанных;
		НовСтр.ПодтверждениеАдресФайлаДанных 	= СоответствиеФайлыПринадлежащиеОписи[СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаДанных];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаПодписи) Тогда
		
		НовСтр.ПодтверждениеИмяФайлаПодписи 	= ИсправленнноеИмяФайлаЭПФайлаОписиИсходящихДокументов(
			СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаПодписи,
			СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаДанных);
		НовСтр.ПодтверждениеАдресФайлаПодписи	= СоответствиеФайлыПринадлежащиеОписи[СтрокаПредставляемыйДокумент.ПодтверждениеИмяФайлаПодписи];
		
	КонецЕсли;
	
	// Представление нужно для вывода текста предупреждений
	Если ЗначениеЗаполнено(СтрокаПредставляемыйДокумент.СсылкаНаОбъект) Тогда
		НовСтр.ПредставлениеДокумента	= Строка(СтрокаПредставляемыйДокумент.СсылкаНаОбъект);
	Иначе
		НовСтр.ПредставлениеДокумента	= Строка(СтрокаПредставляемыйДокумент.ВидДокумента);
	КонецЕсли;
	
	НовСтр.ЭтоПакетСДопДокументами = ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция КодДокДляДокСкана(ОписьСсылка, ДокСкан)
	
	ЭтоПакетСДопДокументами = ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка);
	
	Если НЕ ЭтоПакетСДопДокументами Тогда
		// Для ответа на требование документов задан жестко
		КодДок = "9998";
	ИначеЕсли ЗначениеЗаполнено(ДокСкан.КВД) Тогда
		КодДок = ДокСкан.КВД;
	Иначе
		// Иной документ
		// Из ПРИКАЗа от 27 октября 2016 г. N ММВ-7-6/583@
		КодДок = "9999";
	КонецЕсли;
	
	Возврат КодДок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбщееКоличествоОтправляемыхФайловОписиИсходящихДокументов(ДанныеФайловВыгрузки)
	
	КоличествоФайлов = 0;
	
	ТаблицаНеДокФорм = ДанныеФайловВыгрузки.ТаблицаНеДокФорм;
	Для каждого СтрокаТаблицыДокСканов Из ТаблицаНеДокФорм Цикл
		
		КоличествоФайлов = КоличествоФайлов + СтрокаТаблицыДокСканов.МассивФайлов.Количество();
		
		ЕстьФайлЭП = ЗначениеЗаполнено(СтрокаТаблицыДокСканов.ИдФайлЭП);
		Если ЕстьФайлЭП Тогда
			КоличествоФайлов = КоличествоФайлов + 1;
		КонецЕсли;
		
	КонецЦикла; 
	
	ТаблицаДокФорм = ДанныеФайловВыгрузки.ТаблицаДокФорм;
	Для каждого СтрокаТаблицыДокФорм Из ТаблицаДокФорм Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицыДокФорм.ПодтверждениеИмяФайлаДанных) Тогда
			КоличествоФайлов = КоличествоФайлов + 4;
		Иначе
			КоличествоФайлов = КоличествоФайлов + 2;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоФайлов;
	
КонецФункции

&НаСервере
Функция ВыгрузитьОписьИсходящихДокументов(Контекст, ТранспортноеСообщение, ДанныеФайловВыгрузки)
	
	УникальныйИдентификаторФормы = Контекст.УникальныйИдентификатор;
	ОписьСсылка = Контекст.Документ;
	
	ИдентификаторОтправителяПолучателя = СформироватьИдентификаторОтправителяПолучателя(ТранспортноеСообщение);
	
	ДанныеФайловВыгрузки = ПолучитьДанныеПоФайламВыгрузкиОписиИсходящихДокументов(ОписьСсылка, ИдентификаторОтправителяПолучателя, УникальныйИдентификаторФормы);	
	Если ДанныеФайловВыгрузки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Организация 		= ОписьСсылка.Организация;
	КодНалоговогоОргана = СокрЛП(ОписьСсылка.НалоговыйОрган.Код);
	ЭлРегистрацияВИФНС 	= РегистрацияВИФНСПоОрганизацииИКодуНО(ОписьСсылка.Организация, КодНалоговогоОргана);
	
	ПараметрыОписи = СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана);
	
	Если НЕ ПроверитьЗаполнениеПараметровПриОтправкеПредставления(ПараметрыОписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(ОписьСсылка) Тогда 
		
		ИмяФайла = ИмяФайлаПервичногоСообщения(ОписьСсылка.Основание);
		
		Если ИмяФайла = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить имя файла документа, для которого отправляется %1';
									|en = 'Не удалось определить имя файла документа, для которого отправляется %1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ДокументооборотСКОКлиентСервер.ПредставлениеПакетаСДопДокументами(Истина));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ИдФайлОсн = ИмяФайлаБезРасширения(ИмяФайла);
		
	Иначе
		
		ВложенияСДанными = ПолучитьФайлыДокументовРеализацииПолномочийНалоговыхОрганов(ОписьСсылка.Основание);
		Если ВложенияСДанными.Количество() = 0 Тогда
			ИдФайлОсн = ИмяФайлаТребованияИзОписания(ОписьСсылка.Основание);
		Иначе
			ИдФайлОсн = ИмяФайлаБезРасширения(ВложенияСДанными[0].ИмяФайла);
		КонецЕсли;
		
		Если ИдФайлОсн = "" Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить имя файла требования. Возможно у требования отсутствуют вложения';
									|en = 'Не удалось определить имя файла требования. Возможно у требования отсутствуют вложения'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыОписи.Вставить("ИдФайлОсн", ИдФайлОсн);
	
	ПараметрыОписи.Вставить("ЭтоОтветНаТребованиеДокументов", Истина);
	
	// формируем имя файла представления
	ИмяФайлаПредставления = Неопределено;
	
	//при подсчете количества вложений не учитываем 6 служебных файла и служебные подписи вложений (делим пополам)
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КолФайл = ПолучитьОбщееКоличествоОтправляемыхФайловОписиИсходящихДокументов(ДанныеФайловВыгрузки); 
	
	// формируем XML представления
	ТекстПредставления = СформироватьXMLПредставления(Организация, ДанныеФайловВыгрузки, ПараметрыОписи, ИмяФайлаПредставления, КолФайл);
	Если НЕ ЗначениеЗаполнено(ТекстПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать XML файл описи исходящих документов.';
								|en = 'Не удалось сформировать XML файл описи исходящих документов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем XML во временный файл в кодировке windows-1251
	ФайлПредставления = ВыгрузитьТекстВФайл(ТекстПредставления, ПолучитьИмяВременногоФайла());
	Если НЕ ЗначениеЗаполнено(ФайлПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось записать содержимое описи исходящих документов в файл.';
								|en = 'Не удалось записать содержимое описи исходящих документов в файл.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	                                                                             
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлПредставления);
	СсылкаНаДвоичныеДанныеФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификаторФормы);
	
	ДанныеФайлаПредставление = Новый Структура;
	ДанныеФайлаПредставление.Вставить("ИмяФайла", ИмяФайлаПредставления);
	ДанныеФайлаПредставление.Вставить("АдресВременногоХранилища", СсылкаНаДвоичныеДанныеФайла);
	
	ДанныеФайловВыгрузки.Вставить("ДанныеФайлаПредставление", ДанныеФайлаПредставление);
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяФайлаПервичногоСообщения(Ссылка)
	
	ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Ссылка);
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	СообщенияЦикла = КонтекстЭДОСервер.ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь,Истина);
	
	Если СообщенияЦикла.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПервичноеСообщение = Неопределено;
	
	ТипыПервичныхСообщений = ДокументооборотСКОВызовСервера.ТипПервичныхСообщений();
	Для каждого Сообщение Из СообщенияЦикла Цикл
		Для каждого ТипПервичныхСообщений Из ТипыПервичныхСообщений Цикл
			Если Сообщение.Тип = ТипПервичныхСообщений Тогда
				ПервичноеСообщение = Сообщение;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла; 

	Если ПервичноеСообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ФильтрПоТипу = ДокументооборотСКОВызовСервера.ТипыСодержимогоТранспортногоКонтейнераПервичныхСообщений();
	
	ТаблицаСРезультатом = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(
		ПервичноеСообщение,
		Истина, 
		ФильтрПоТипу,
		,
		Истина);
		
	ИмяФайла = Неопределено;
	
	Для Каждого СтрокаРезультата Из ТаблицаСРезультатом Цикл
		
		Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДокументыРеализацииПолномочийНалоговыхОрганов") Тогда
			
			ИмяФайла = ПолучитьИмяВременногоФайла();
			Данные   = СтрокаРезультата.Данные.Получить();
			Данные.Записать(ИмяФайла);
			
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			Свойства = КонтекстЭДОСервер.ПолучитьСвойстваОписиВходящихДокументов(ПервичноеСообщение.Ссылка, ИмяФайла);
			
			Если Свойства.ТаблицаДокументов.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			НайденДокумент = Ложь;
			
			// Для требований и уведомлений ищем название файла ровно для этого требования, а не для всей описи
			Для каждого Документ Из Свойства.ТаблицаДокументов Цикл
				
				Если Ссылка.ДатаДокумента = Документ.РеквизитыДокумента.ДатаДокумента
					И Ссылка.НомерДокумента = Документ.РеквизитыДокумента.НомерДокумента Тогда
					
					Для каждого Вложение Из Документ.СписокИменФайловВложений Цикл
						ИмяФайла = Вложение.Значение;
						НайденДокумент = Истина;
						Прервать;
					КонецЦикла; 
					
				КонецЕсли;
				
				Если НайденДокумент Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ НайденДокумент Тогда
				ИмяФайла = СтрокаРезультата.ИмяФайла;
			КонецЕсли;
			
		Иначе
			ИмяФайла = СтрокаРезультата.ИмяФайла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИмяФайла;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФайлыПринадлежащиеОписи(ОписьСсылка, УникальныйИдентификаторФормы, СписокИменФайлов = Неопределено) Экспорт

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьФайлыПринадлежащиеОписи(ОписьСсылка, УникальныйИдентификаторФормы, СписокИменФайлов);
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLПредставления(
		Организация,
		ДанныеФайловВыгрузки, 
		ПараметрыОписи, 
		ИмяФайлаПредставления, 
		КолФайл)
	
	// создаем XML-дерево
	ДеревоXML = СоздатьДеревоXML();
	
	СформироватьXMLПредставления_ИдФайл(ДеревоXML, ПараметрыОписи, ИмяФайлаПредставления, Организация);
	
	ДобавитьУзелXML(ДеревоXML, "ВерсПрог", Истина, Лев(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы(), 40));
	ДобавитьУзелXML(ДеревоXML, "ВерсФорм", Истина, "5.03");
	
	// создаем узел Документ
	УзелДокумент = ДобавитьУзелXML(ДеревоXML, "Документ");
	ДобавитьУзелXML(УзелДокумент, "КНД", Истина, "1184002");
	ДобавитьУзелXML(УзелДокумент, "ДатаДок", Истина, XMLСтрока(Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy")));

	СформироватьXMLПредставления_СвОтпрДок(УзелДокумент, ПараметрыОписи);
	СформироватьXMLПредставления_СвПолДок(УзелДокумент, ПараметрыОписи);
	СформироватьXMLПредставления_СвНП(УзелДокумент, ПараметрыОписи);
	СформироватьXMLПредставления_Подписант(УзелДокумент, ПараметрыОписи);
	
	Если НЕ СформироватьXMLПредставления_ДокПредстНО(УзелДокумент, ПараметрыОписи, ДанныеФайловВыгрузки, КолФайл) Тогда
		Возврат "";
	КонецЕсли;
	
	// формируем XML-строку на основе дерева
	ТекстXML = ВыгрузитьДеревоВXML_ПФР(ДеревоXML, "Файл");
	
	Возврат ТекстXML;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLПредставления_ИдФайл(ДеревоXML, ПараметрыОписи, ИмяФайлаПредставления, Организация)
	
	// формируем идентификатор отправителя
	Если ПараметрыОписи.ПрПодп = 2 Тогда
		СвПред = ПараметрыОписи.Доверенность.СвУпПред.СвПред;
		Если СвПред.Свойство("СвОрг") Тогда
			ИННКПП = СокрЛП(СвПред.СвОрг.ИННЮЛ) + СокрЛП(СвПред.СвОрг.КПП);
		Иначе
			Если НЕ ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННКПП = СокрЛП(СвПред.СведФизЛ.ИННФЛ);
			ИначеЕсли ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации
				И ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
				И ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
				И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица") Тогда
				ИННКПП = ?(ПараметрыОписи.Доверенность.СвПредст.ЯвляетсяФЛ, СокрЛП(ПараметрыОписи.Доверенность.СвПредст.ИННФЛ),
					СокрЛП(ПараметрыОписи.Доверенность.СвПредст.ИННЮЛ) + СокрЛП(ПараметрыОписи.КППЮЛ));
			Иначе
				ИННКПП = ?(ПараметрыОписи.ЭтоПБОЮЛ, СокрЛП(ПараметрыОписи.ИННФЛ), СокрЛП(ПараметрыОписи.ИННЮЛ) + СокрЛП(ПараметрыОписи.КППЮЛ));
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИННКПП = ?(ПараметрыОписи.ЭтоПБОЮЛ, СокрЛП(ПараметрыОписи.ИННФЛ), СокрЛП(ПараметрыОписи.ИННЮЛ) + СокрЛП(ПараметрыОписи.КППЮЛ));
	КонецЕсли;
	
	ЭтоКрупнейший    = ДокументооборотСКО.ЭтоКрупнейший(Организация);
	КодНОКрупнейшего = ДокументооборотСКО.КодНОКрупнейшего(Организация);
	
	ИмяФайлаБезРасширения = "ON_DOCNPNO_"
							 + ?(ЭтоКрупнейший И ЗначениеЗаполнено(КодНОКрупнейшего), СокрЛП(КодНОКрупнейшего), ПараметрыОписи.КодНО)
							 + "_"
							 + ПараметрыОписи.КодНО
							 + "_"
							 + ИННКПП
							 + "_"
							 + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd")
							 + "_"
							 + Строка(Новый УникальныйИдентификатор);

	ИмяФайлаБезРасширения = ВРЕГ(ИмяФайлаБезРасширения);
	
	ИмяФайлаПредставления = ИмяФайлаБезРасширения + ".xml";
	
	// иниицализируем атрибуты корневого элемента
	ДобавитьУзелXML(ДеревоXML, "ИдФайл", Истина, ИмяФайлаБезРасширения);
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLПредставления_ДокПредстНО(УзелДокумент, ПараметрыОписи, ДанныеФайловВыгрузки, КолФайл)
	
	 // формируем основную часть файла
	Если ПараметрыОписи.Свойство("ЭтоОтветНаТребованиеДокументов") Тогда
		
		Если НЕ ДобавитьВДеревоДокументыРеализацииПолномочий(УзелДокумент, ДанныеФайловВыгрузки, ПараметрыОписи, КолФайл) Тогда
			Возврат Ложь;
		Конецесли;
		
	ИначеЕсли ПараметрыОписи.Свойство("ЭтоОтветНаТребованиеПоНДС") Тогда
		
		ИдФайлОсн 	= ПараметрыОписи.ИмяФайлТребПояс;
		ИдФайл 		= ДанныеФайловВыгрузки.ИдФайл;
		ИдФайлЭП	= ДанныеФайловВыгрузки.ИдФайлЭП;
		
		ДобавитьУзелДокФорм_ДокПредстНО(УзелДокумент, "1160200", ИдФайлОсн, КолФайл, ИдФайл, ИдФайлЭП);
		
	ИначеЕсли ПараметрыОписи.Свойство("ЭтоЖурналСФ") Тогда
		
		ИдФайлОсн 	= "ЖУРНАЛ";
		ИдФайл 		= ДанныеФайловВыгрузки.ИдФайл;
		ИдФайлЭП 	= ДанныеФайловВыгрузки.ИдФайлЭП;
		
		ДобавитьУзелДокФорм_ДокПредстНО(УзелДокумент, "1115104", ИдФайлОсн, КолФайл, ИдФайл, ИдФайлЭП);
		
	Иначе
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить содержимое описи.';
				|en = 'Не удалось определить содержимое описи.'"),);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLПредставления_Подписант(УзелДокумент, ПараметрыОписи)
			
	УзелПодписант = ДобавитьУзелXML(УзелДокумент, "Подписант");
	
	ЭтоИП = ПараметрыОписи.ЭтоПБОЮЛ;
	Если ЭтоИП Тогда
		ПрПодп = ПараметрыОписи.ПрПодп;
	Иначе
		ПрПодп = ПараметрыОписи.ПрПодп + 2;
	КонецЕсли;
	ДобавитьУзелXML(УзелПодписант, "ПрПодп", Истина, ПрПодп);
		
	УзелФИО = ДобавитьУзелXML(УзелПодписант, "ФИО");
	Если ПараметрыОписи.ПрПодп = 1 Тогда
		Если НЕ ПараметрыОписи.ЭтоПБОЮЛ Тогда
			ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(ПараметрыОписи.ФИОРук);
			ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
			ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
			ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
