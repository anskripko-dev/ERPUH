	СтрРезультатыПриема = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатПриема"));
	Для Каждого СтрРезультатПриема Из СтрРезультатыПриема Цикл 
		Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрРезультатПриема.Файл, "windows-1251");
		ПолучитьЭЦП(Файлы.Индекс(СтрРезультатПриема));
		
		Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрРезультатПриема.ТранспортноеСообщение);
		КНД           = КНДФайла(Тело);
		
		Если СтрРезультатПриема.Тип = ПредопределенноеЗначение("Перечисление.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказе")
			ИЛИ СтрРезультатПриема.Тип = ПредопределенноеЗначение("Перечисление.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент") Тогда 
			
			Если КНД = "1167003" Тогда
				
				ТаблДок = СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриеме(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
							
			ИначеЕсли КНД = "1166006" Тогда
					
				ТаблДок = СформироватьТабличныйДокументНаОсновеУведомленияОбОтказеВПриемеНалоговойДекларации(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
					
			Иначе
					
				ТаблДок = СформироватьТабличныйДокументНаОсновеБланка(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
					
			КонецЕсли;
					
		Иначе
			
			Если КНД = "1167001" Тогда
				
				ТаблДок = СформироватьТабличныйДокументНаОсновеКвитанцииОПриеме(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
					
			ИначеЕсли КНД = "1166002" Тогда
			
				ТаблДок = СформироватьТабличныйДокументНаОсновеКвитанцииОПриемеНалоговойДекларации(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
					
			Иначе
					
				ТаблДок = СформироватьТабличныйДокументНаОсновеБланка(
					Представление, 
					СтрРезультатПриема.ИмяФайла, 
					Тело, 
					НижнийКолонтитул);
					
			КонецЕсли;
				
		КонецЕсли;
				
		ПараметрыПечати = КонструкторПечатиПротокола();
		ПараметрыПечати.ТабДок   = ТаблДок;
		ПараметрыПечати.Отправка = СтрРезультатПриема.ТранспортноеСообщение;
		
		Результат.Добавить(ПараметрыПечати, Представление);

	КонецЦикла;
	
