&НаКлиенте
Процедура ПоказатьПриложениеПФР(ТранспортноеСообщение, СтрВложение, ВыполняемоеОповещение = Неопределено) Экспорт
	
	Если СтрВложение.ВАрхиве Тогда
		
		ПоказатьУведомлениеАрхивныхФайлов(, 27, 3);
		
		Если ВыполняемоеОповещение <> Неопределено Тогда 
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ЭтоPDF = ЭтоPDFФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
	
	Если ТребуетсяОсобыйСпособОтображения(СтрВложение.ИмяФайла, СтрВложение.ТипСодержимогоФайла) И НЕ ЭтоPDF Тогда
		
		СсылкаНаОтчет = ПредметТранспортногоСообщения(ТранспортноеСообщение);
		ПоказатьКакТабличныйДокумент(СсылкаНаОтчет, СтрВложение.ИмяФайла, СтрВложение.Адрес);

	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_html
		ИЛИ (СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml
		И НЕ ЭтоВебКлиент() 
		И НЕ ОбщегоНазначенияКлиент.ЭтоLinuxКлиент() 
		И НЕ ОбщегоНазначенияКлиент.ЭтоMacOSКлиент() 
		И НЕ ЭтоPDF) Тогда
		
		ПоказатьHTML(СтрВложение.ИмяФайла, СтрВложение.Данные, , СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_xml);
		
	ИначеЕсли ЭтоВебКлиент() ИЛИ ОбщегоНазначенияКлиент.ЭтоLinuxКлиент() ИЛИ ОбщегоНазначенияКлиент.ЭтоMacOSКлиент() Тогда
		
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, СтрВложение.ИмяФайла);
		
	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст1251 Тогда
		
		ПоказатьТекстИзСтроки(СтрВложение.Данные, СтрВложение.ИмяФайла, "windows-1251");
		
	ИначеЕсли СтрВложение.ТипСодержимогоФайла = СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоФайлов_Текст866 Тогда
		
		ПоказатьТекстИзСтроки(СтрВложение.Данные, СтрВложение.ИмяФайла, "cp866");
		
	Иначе
		
		ИмяФайлаВложения = ?(нрег(Прав(СтрВложение.ИмяФайла, 4)) = ".enc",
			Лев(СтрВложение.ИмяФайла, СтрДлина(СтрВложение.ИмяФайла) - 4), СтрВложение.ИмяФайла);
		
		ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(СтрВложение.Адрес, ИмяФайлаВложения);
		
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда 
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекстИзСтроки(СтрокаСодержимого, ИсходноеИмяФайла, КодировкаТекста = Неопределено, ПечатьРазрешена = Истина) Экспорт
	
	Если ПечатьРазрешена Тогда
		СтруктураПараметров = Новый Структура("ИмяФайла, Содержимое, Кодировка", ИсходноеИмяФайла, СтрокаСодержимого, КодировкаТекста);
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрТекст", СтруктураПараметров,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(СтрокаСодержимого);
		Текст.ТолькоПросмотр = Истина;
		Текст.Показать(ИсходноеИмяФайла + " - просмотр", ИсходноеИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// Просмотр XML в веб-клиенте и на Linux не работает
&НаКлиенте
Процедура ПоказатьHTML(ИмяФайла, Содержимое, ОткрытьМодально = Истина, ЭтоXML = Ложь) Экспорт
	
	ЗначениеСодержимое = Содержимое;
	
	#Если НЕ ВебКлиент Тогда
		Если ЭтоXML И НЕ ОбщегоНазначенияКлиент.ЭтоLinuxКлиент() И НЕ ОбщегоНазначенияКлиент.ЭтоMacOSКлиент() Тогда
			Если ТипЗнч(ЗначениеСодержимое) = Тип("Строка") И ЭтоАдресВременногоХранилища(ЗначениеСодержимое) Тогда
				ЗначениеСодержимое = ПолучитьИзВременногоХранилища(ЗначениеСодержимое);
			КонецЕсли;
			
			Если ТипЗнч(ЗначениеСодержимое) = Тип("ДвоичныеДанные") Тогда
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
				ЗначениеСодержимое.Записать(ИмяВременногоФайла);
				ЗначениеСодержимое = ИмяВременногоФайла;
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
	
	СтруктураПараметров = Новый Структура("ИмяФайла, Содержимое", ИмяФайла, ЗначениеСодержимое);
	
	Если ОткрытьМодально Тогда
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрHTML", СтруктураПараметров,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрHTML", СтруктураПараметров);
	КонецЕсли;
	
КонецПроцедуры

