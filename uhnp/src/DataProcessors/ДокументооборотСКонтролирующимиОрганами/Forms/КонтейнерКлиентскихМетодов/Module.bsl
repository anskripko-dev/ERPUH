		ПоказатьПриложениеПФР(Сообщение ,Результат, ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеЗавершение(ВыполняемоеОповещение) Экспорт
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокуВложенияНаСервере(СообщениеПротокол, ИмяФайлаДокумента) Экспорт
	
	Результат = Новый Структура;
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(СообщениеПротокол, Истина, , ИмяФайлаДокумента, Истина);
	Если Вложения.Количество() = 0 Тогда
		Результат.Вставить("Предупреждение", "Приложение не найдено.");
		Возврат Результат;
	КонецЕсли;
	
	Вложение = Вложения[0];
	Для Каждого Колонка Из Вложения.Колонки Цикл
		Если ТипЗнч(Вложение[Колонка.Имя]) = Тип("ХранилищеЗначения") Тогда 
			Результат.Вставить(Колонка.Имя, Вложение[Колонка.Имя].Получить());
		Иначе
			Результат.Вставить(Колонка.Имя, Вложение[Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.html Тогда 
		Результат.Вставить("ЭтоHTML", Истина);
	ИначеЕсли Результат.ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Текст1251 Тогда 
		Результат.Вставить("ЭтоTXT", Истина);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПоказатьПротоколВложениеФСГС(Сообщение, ИмяФайлаДокумента, ВыполняемоеОповещение)
	
	Результат = ПолучитьСтрокуВложенияНаСервере(Сообщение, ИмяФайлаДокумента);
	Если Результат.Свойство("Предупреждение") Тогда 
