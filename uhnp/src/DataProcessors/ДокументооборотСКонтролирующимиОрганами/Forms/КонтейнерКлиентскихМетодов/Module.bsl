&НаСервере
Функция СформироватьТабличныйДокументПодтверждениеПолученияФСГС(Тело, ЦиклОбмена)
	
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияПолученияФСГС(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		
		Макет = ПолучитьМакетОбработки("ПодтвержденияПолученияФСГС");
		
		ОбластьМакета = Макет.ПолучитьОбласть("ФСГСПодтверждение");
		ОбластьМакета.Параметры.Заполнить(СвойстваИзПодтверждения);
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзПодтвержденияПолученияФСГС(Тело)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// загружаем XML из строки в дерево
	ДеревоXML = КонтекстЭДОСервер.ЗагрузитьСтрокуXMLВДеревоЗначений(Тело);
	Если ДеревоXML = Неопределено Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	УзелИзвещение = ДеревоXML.Строки.Найти("извещение", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелИзвещение) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Извещение"".';
								|en = 'Некорректная структура XML извещения: не обнаружен узел ""Извещение"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		Возврат  Неопределено;
	КонецЕсли;
	
	УзелОтправитель = УзелИзвещение.Строки.Найти("отправитель", "Имя", Истина);
	Если ЗначениеЗаполнено(УзелОтправитель) Тогда
		ИдентификаторОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "идентификатор");
		НатуральныйИдентификаторОтправителя  = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "натуральныйИдентификатор");
		ТипОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "тип");
		НазваниеОтправителя = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелОтправитель, "название");
	Иначе
		ИдентификаторОтправителя = "";
		НатуральныйИдентификаторОтправителя  = "";
		ТипОтправителя = "";
		НазваниеОтправителя = "";
	КонецЕсли;
	
	УзелПолучатель = УзелИзвещение.Строки.Найти("получатель", "Имя", Истина);
	Если ЗначениеЗаполнено(УзелПолучатель) Тогда
		ИдентификаторПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "идентификатор");
		НатуральныйИдентификаторПолучатель  = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "натуральныйИдентификатор");
		ТипПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "тип");
		НазваниеПолучатель = ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелПолучатель, "название");
	Иначе
		ИдентификаторПолучатель = "";
		НатуральныйИдентификаторПолучатель  = "";
		ТипПолучатель = "";
		НазваниеПолучатель = "";
	КонецЕсли;	

	УзелДокументы = УзелИзвещение.Строки.Найти("документы", "Имя", Истина);
	Если НЕ ЗначениеЗаполнено(УзелДокументы) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Документы"".';
								|en = 'Некорректная структура XML извещения: не обнаружен узел ""Документы"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	// получаем идентификаторы поступивших файлов
	ИдентификаторыДокументов = "";
	Для каждого УзелДокумент Из УзелДокументы.Строки Цикл
		ИдентификаторДокумента = УзелДокумент.Строки.Найти("идентификаторДокумента", "Имя");
		Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			ИдентификаторыДокументов = ИдентификаторыДокументов + ?(ПустаяСтрока(ИдентификаторыДокументов), "", ",") + СокрЛП(ИдентификаторДокумента.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИдентификаторыДокументов", 	ИдентификаторыДокументов);
	ДополнительныеПараметры.Вставить("ИдентификаторОтправителя", 	ИдентификаторОтправителя);
	ДополнительныеПараметры.Вставить("НатуральныйИдентификаторОтправителя", НатуральныйИдентификаторОтправителя);
	ДополнительныеПараметры.Вставить("ТипОтправителя", 				ТипОтправителя);
	ДополнительныеПараметры.Вставить("НазваниеОтправителя", 		НазваниеОтправителя);
	ДополнительныеПараметры.Вставить("ИдентификаторПолучатель", 	ИдентификаторПолучатель);
	ДополнительныеПараметры.Вставить("НатуральныйИдентификаторПолучатель", НатуральныйИдентификаторПолучатель);
	ДополнительныеПараметры.Вставить("ТипПолучатель", 				ТипПолучатель);
	ДополнительныеПараметры.Вставить("НазваниеПолучатель", 			НазваниеПолучатель);

	Возврат ДополнительныеПараметры;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениУзлаИзПодтвержденияПолученияФСГС(УзелРодитель, ИмяДочернегоУзла)
	
	Строка = УзелРодитель.Строки.Найти(ИмяДочернегоУзла, "Имя");
	Если Строка = Неопределено Тогда
		Результат = "";
	Иначе
		Результат = Строка.Значение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПечатьВозможнаДляЦиклаОбмена(Тип) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПечатьВозможнаДляЦиклаОбмена(Тип); 
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияУзла(УзелРодитель, ИмяУзла, ОбщиеСведения)
	
	УзелСвОтметка = УзелРодитель.Строки.Найти(ИмяУзла, "Имя", Истина);
	Если НЕ ЗначениеЗаполнено(УзелСвОтметка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ДополнительныеПараметры = Новый Структура();
	  
	Для Каждого УзелОбщСвед Из УзелСвОтметка.Строки Цикл
		ДополнительныеПараметры.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	ОбщиеСведения.Вставить(ИмяУзла, ДополнительныеПараметры);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(ИсходноеЗначение, ЗначениеДляОтправки = Неопределено) Экспорт
	
	Возврат ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(ИсходноеЗначение, ЗначениеДляОтправки, Неопределено);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеУстановкиКорневогоСертификатаВР(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыФункции      = ДополнительныеПараметры.ПараметрыФункции;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ВыводитьСообщения                          = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПовторятьСоединение                        = ДополнительныеПараметры.ПовторятьСоединение;
	
	ТихийРежим = Неопределено;
	ИнформацияОСервереОнлайнПроверки = Неопределено;
	ДополнительныеПараметры.ПараметрыФункции.Свойство("ТихийРежим", ТихийРежим);
	ДополнительныеПараметры.ПараметрыФункции.Свойство("СтруктураДляИнформацииОСервереОнлайнПроверки", ИнформацияОСервереОнлайнПроверки);
	
	ТихийРежим = ?(ТихийРежим = Неопределено, Ложь, ТихийРежим);
	
	ОбновленыПодписиСертификатовДокументооборота = Ложь;
	Результат = РегистрацияПолучитьДанныеССервера(
		ПараметрыРегистрацияПолучитьДанныеССервера,
		ПовторятьСоединение,
		ОбновленыПодписиСертификатовДокументооборота);
		
	Если ОбновленыПодписиСертификатовДокументооборота Тогда
		ПараметрыПриложения.Вставить("КриптографияЭДКО.ПодписиСертификатовДокументооборота", Неопределено);
	КонецЕсли;
	Если НЕ Результат И ТихийРежим И ИнформацияОСервереОнлайнПроверки = Неопределено Тогда //Не работать при отправке на онлайн проверку
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
		Возврат;
		
	ИначеЕсли НЕ Результат И ПовторятьСоединение Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбработатьОбновлениеВЦикле",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу оператора ""Калуга Астрал""';
				|en = 'Не удалось обратиться к серверу оператора ""Калуга Астрал""'"),
			ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыАвторизации = Новый Структура;
	Если ЗначениеЗаполнено(ПараметрыФункции.УчетнаяЗапись) Тогда
		ПараметрыАвторизации.Вставить("УчетнаяЗапись", ПараметрыФункции.УчетнаяЗапись);
	Иначе
		ПараметрыАвторизации.Вставить("ИдентификаторДокументооборота", ПараметрыФункции.ИдентификаторДокументооборота);
		ПараметрыАвторизации.Вставить("ТелефонМобильныйДляАвторизации", ПараметрыФункции.ТелефонМобильныйДляАвторизации);
	КонецЕсли;
	
	// служебные переменные
	ЭтоНоваяУчетнаяЗапись = Истина;
	
	СтруктураАвтонастройкиФСС = Неопределено;
	СтруктураАвтонастройкиРПН = Неопределено;
	СтруктураАвтонастройкиФТС = Неопределено;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияПолучитьДанныеССервера);
	
	ФайлИзКэша = ПараметрыРегистрацияПолучитьДанныеССервера.ФайлИзКэша;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
		
	// если не получилось, то прерываемся
	Если НЕ Результат Тогда
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		Возврат;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	СерийныйНомер = СерийныйНомерЛичногоСертификата();
	
	ПодписьСервиса  = ЭтоСообщениеЗашифрованоНаОблачныйСертификат(ДанныеУзлаКонфиденциальнаяИнформацияАдрес, СерийныйНомер);
	ОблачнаяПодпись = КриптографияЭДКОСлужебныйВызовСервера.ЭтоСообщениеЗашифрованоОблачнойПодписью(
		ДанныеУзлаКонфиденциальнаяИнформацияАдрес,
		СерийныйНомер);
	
	Если ПодписьСервиса <> Неопределено И ПодписьСервиса Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Истина);
	ИначеЕсли ОблачнаяПодпись <> Неопределено Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ОблачнаяПодпись);
	ИначеЕсли НЕ ФайлИзКэша Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Ложь);
	КонецЕсли;
	
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ПараметрыФункции);

	// создаем на клиенте временный каталог, который необходим для хранения промежуточных файлов
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                      ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес",  ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ВыводитьСообщения",                          ВыводитьСообщения);
	ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
	ДополнительныеПараметры.Вставить("ПараметрыФункции",                           ПараметрыФункции);
	ДополнительныеПараметры.Вставить("Результат",                                  Результат);
	ДополнительныеПараметры.Вставить("ПараметрыАвторизации",                       ПараметрыАвторизации);
	ДополнительныеПараметры.Вставить("ФайлИзКэша",                                 ФайлИзКэша);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеПолученияВременногоКаталогаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(Оповещение);
	Иначе
		РезультатОперацииСФайлами = Новый Структура("Выполнено, ДвоичныеДанные, ИмяКаталога", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатОперацииСФайлами);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоОтчетностиЦБ(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление отчета
	Если Настройки.ПечататьДокумент Тогда
		ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ФайлОтчетностиЦБ"));
		Для каждого ФайлОтчетности Из ФайлыОтчетности Цикл
			Если нрег(ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ФайлОтчетности.ИмяФайла).Расширение) = ".xml" Тогда
				Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(ФайлОтчетности.Файл,, Истина);
				ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
				
				Представление = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
				ПараметрыПечати = КонструкторПечатиПротокола();
				ПараметрыПечати.ТабДок = СформироватьТабличныйДокументНаОсновеБланка(
					НСтр("ru = 'Электронное представление';
						|en = 'Электронное представление'"),
					ФайлОтчетности.ИмяФайла,
					Тело,
					НижнийКолонтитул);
				ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
				
				Результат.Добавить(ПараметрыПечати, Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// выводим результат загрузки
	Если Настройки.ПечататьПодтверждениеОтправки Тогда
		РезультатыЗагрузки = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатЗагрузкиЦБ"));
		РезультатыЗагрузкиПриложения = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатЗагрузкиПриложениеЦБ"));
		Для каждого РезультатЗагрузки Из РезультатыЗагрузки Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(РезультатЗагрузки.Файл,, Истина);
			ТелоПриложения = "";
			Для каждого РезультатЗагрузкиПриложение Из РезультатыЗагрузкиПриложения Цикл
				Если РезультатЗагрузкиПриложение.ТранспортноеСообщение = РезультатЗагрузки.ТранспортноеСообщение Тогда
					ТелоПриложения = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(РезультатЗагрузкиПриложение.Файл,, Истина);
				КонецЕсли;
			КонецЦикла;
			ПолучитьЭЦП(Файлы.Индекс(РезультатЗагрузки));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(РезультатЗагрузки.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок = СформироватьТабличныйДокументНаОсновеКвитанцииЦБ(
				НСтр("ru = 'Результат загрузки';
					|en = 'Результат загрузки'"),
				РезультатЗагрузки.ИмяФайла,
				Тело,
				ЦиклОбмена,
				РезультатЗагрузки.ТранспортноеСообщение,
				ТелоПриложения);
			ПараметрыПечати.Отправка = РезультатЗагрузки.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
		КонецЦикла;
	КонецЕсли;
	
	// выводим результат приема
	Если Настройки.ПечататьРезультатПриема Тогда
		РезультатыПриема = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатПриемаДокументЦБ"));
		РезультатыПриемаПриложения = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатПриемаПриложениеЦБ"));
		Для каждого РезультатПриема Из РезультатыПриема Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(РезультатПриема.Файл,, Истина);
			ТелоПриложения = "";
			Для каждого РезультатПриемаПриложения Из РезультатыПриемаПриложения Цикл
				Если РезультатПриемаПриложения.ТранспортноеСообщение = РезультатПриема.ТранспортноеСообщение Тогда
					ТелоПриложения = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(РезультатПриемаПриложения.Файл,, Истина);
				КонецЕсли;
			КонецЦикла;
			ПолучитьЭЦП(Файлы.Индекс(РезультатПриема));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(РезультатПриема.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок = СформироватьТабличныйДокументНаОсновеКвитанцииЦБ(
				НСтр("ru = 'Результат приема';
					|en = 'Результат приема'"),
				РезультатПриема.ИмяФайла,
				Тело,
				ЦиклОбмена,
				РезультатПриема.ТранспортноеСообщение,
				ТелоПриложения);
			ПараметрыПечати.Отправка = РезультатПриема.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
		КонецЦикла;
	КонецЕсли;
	
	// выводим результат обработки
	Если Настройки.ПечататьПротокол Тогда
		Протоколы = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "РезультатОбработкиДокументЦБ"));
		Для каждого СтрПротокол Из Протоколы Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрПротокол.Файл,, Истина);
			ПолучитьЭЦП(Файлы.Индекс(СтрПротокол));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрПротокол.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок = СформироватьТабличныйДокументНаОсновеРезультатаОбработкиЦБ(
				НСтр("ru = 'Результат обработки';
					|en = 'Результат обработки'"),
				СтрПротокол.ИмяФайла,
				Тело,
				ЦиклОбмена,
				СтрПротокол.ТранспортноеСообщение);
			ПараметрыПечати.Отправка = СтрПротокол.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
		КонецЦикла;
	КонецЕсли;
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, НСтр("ru = 'Отчет о состоянии';
											|en = 'Отчет о состоянии'"));
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

Функция ЭтоPDFФайл(АдресФайла, ИмяФайла)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяВременногоФайла);
	
	Текст = НовыйЧтениеТекстаНаСервере(ИмяВременногоФайла);
	Строка = Текст.ПрочитатьСтроку();
	Текст.Закрыть();
	
	ЭтоPDF = СтрНайти(ВРег(Строка), "PDF") > 0;
	
	Если ЭтоPDF Тогда
		
		Части = СтрРазделить(ИмяФайла, ".");
		Части[Части.Количество() - 1] = "pdf";
		
		ИмяФайла = СтрСоединить(Части, ".");
		
	КонецЕсли;
	
	Возврат ЭтоPDF;
	
КонецФункции

