&НаКлиенте
Процедура ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписи(
		ВыполняемоеОповещение,
		Знач УчетнаяЗапись,
		Почта = Неопределено,
		ТихийРежим = Ложь,
		РасшифровыватьПринудительно = Ложь,
		ТребуетсяПроверкаУчетнойЗаписи = Истина,
		ТребуетсяАвтонастройка = Истина,
		СписокПолученныхТС = Неопределено) Экспорт
	
	// проверяем учетную запись
	Если ТребуетсяПроверкаУчетнойЗаписи И НЕ УчетнаяЗаписьНастроенаВерно(УчетнаяЗапись) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	// проверяем, задана ли учетная запись
	Если УчетнаяЗапись = Неопределено Тогда
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru = 'Не задана учетная запись для получения сообщений!';
									|en = 'Не задана учетная запись для получения сообщений!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	// проверяем, включена ли возможность документооборота
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		
		ссылкаУчетнаяЗапись = УчетнаяЗаписьОрганизации(УчетнаяЗапись);
		Если НЕ ЗначениеЗаполнено(ссылкаУчетнаяЗапись) Тогда
			Если НЕ ТихийРежим Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для организации %1 не предусмотрена возможность информационного взаимодействия с ФНС, ПФР и Росстатом по каналам связи.';
						|en = 'Для организации %1 не предусмотрена возможность информационного взаимодействия с ФНС, ПФР и Росстатом по каналам связи.'"),
					Символ(34) + УчетнаяЗапись + Символ(34));
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			КонецЕсли;
			ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
			Возврат;
		КонецЕсли;
		
		Организация = УчетнаяЗапись;
		УчетнаяЗапись = ссылкаУчетнаяЗапись;
		
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("УчетнаяЗапись",               УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("Почта",                       Почта);
	ДополнительныеПараметры.Вставить("ТихийРежим",                  ТихийРежим);
	ДополнительныеПараметры.Вставить("ТребуетсяАвтонастройка",      ТребуетсяАвтонастройка);
	ДополнительныеПараметры.Вставить("РасшифровыватьПринудительно", РасшифровыватьПринудительно);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",       ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СписокПолученныхТС",          СписокПолученныхТС);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеАвтонастройкиУчетнойЗаписиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	// вызываем автонастройку при необходимости
	Если ТребуетсяАвтонастройка Тогда
		АвтоматическаяНастройкаУчетнойЗаписи(
			УчетнаяЗапись,
			Организация,
			ОписаниеОповещения,
			,
			,
			ТихийРежим);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗаданиеЗаменыКодовФСГС()
	
	ПараметрыЗапуска = Новый Массив;
	ПараметрыЗапуска.Добавить(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ЭтотОбъект.УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Замена кодов ТОГС";
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ЭлектронныйДокументооборотСКонтролирующимиОрганами.ФоноваяЗаменаВОрганизацияхИПодразделенияхКодОрганаФСГС",
		ПараметрыЗапуска,
		ПараметрыВыполнения);
	
КонецФункции
	
&НаКлиенте
Процедура ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеАвтонастройкиУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперация = ЗапуститьЗаданиеЗаменыКодовФСГС();
	ДополнительныеПараметры.Вставить("РезультатАвтонастройки", Результат);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеЗаменыКодовФСГС",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Интервал = 1;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеЗаменыКодовФСГС(Результат, ДополнительныеПараметры) Экспорт
	
	Результат = ДополнительныеПараметры.РезультатАвтонастройки;
	ДополнительныеПараметры.Удалить("РезультатАвтонастройки");
	
	ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеАвтонастройкиУчетнойЗаписиПродолжение(Результат, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеАвтонастройкиУчетнойЗаписиПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	УчетнаяЗапись               = ДополнительныеПараметры.УчетнаяЗапись;
	Почта                       = ДополнительныеПараметры.Почта;
	ТихийРежим                  = ДополнительныеПараметры.ТихийРежим;
	ТребуетсяАвтонастройка      = ДополнительныеПараметры.ТребуетсяАвтонастройка;
	РасшифровыватьПринудительно = ДополнительныеПараметры.РасшифровыватьПринудительно;
	ВыполняемоеОповещение       = ДополнительныеПараметры.ВыполняемоеОповещение;
	СписокПолученныхТС          = ДополнительныеПараметры.СписокПолученныхТС;
	
	ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
		"ПолучитьСообщенияПоУчетнойЗаписи", 
		, 
		, 
		УчетнаяЗапись);
		
	// получаем сообщения с сервера
	ВходящиеСообщения = Новый Массив;
	Если НЕ ПолучитьСообщенияПоУчетнойЗаписи(УчетнаяЗапись, ТихийРежим, ВходящиеСообщения) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ДополнитьСписокПолученныхТранспортныхСообщений(ВходящиеСообщения, СписокПолученныхТС);
	
	ОбращениеККлючуРазрешено = РасшифровыватьПринудительно ИЛИ НЕ ТихийРежим;
		
	ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаОбмена(
		"РасшифроватьСообщенияПоУчетнойЗаписи", 
		, 
		, 
		УчетнаяЗапись);
		
	// расшифровываем сообщения по учетной записи
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВходящиеСообщения",     ВходящиеСообщения);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеРасшифровкиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	РасшифроватьСообщенияПоУчетнойЗаписи(
		УчетнаяЗапись,
		ТихийРежим,
		ОбращениеККлючуРазрешено,
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИРасшифроватьСообщенияПоУчетнойЗаписиПослеРасшифровкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьСписокПолученныхТранспортныхСообщений(ВходящиеСообщения, СписокПолученныхТС)
	
	Если СписокПолученныхТС <> Неопределено Тогда
	
		Для Каждого ВходящееСообщение Из ВходящиеСообщения Цикл
			
			Если СписокПолученныхТС.НайтиПоЗначению(ВходящееСообщение) = Неопределено Тогда 
				
				СписокПолученныхТС.Добавить(ВходящееСообщение);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьТипСообщения(Сообщение, ВложенияЕсть = Истина) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОпределитьТипСообщения(Сообщение, ВложенияЕсть);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьНалоговыйОрганПоАдресуЭлектроннойПочты(АдресЭлектроннойПочты, ОпределитьСерверДокументооборотаПриНеобходимости = Истина) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	НалоговыеОрганы.Ссылка
	                      |ИЗ
	                      |	Справочник.НалоговыеОрганы КАК НалоговыеОрганы
	                      |ГДЕ
	                      |	НалоговыеОрганы.АдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками = &АдресЭлектроннойПочты");
	Запрос.УстановитьПараметр("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если ОпределитьСерверДокументооборотаПриНеобходимости Тогда
		Возврат ОпределитьСерверДокументооборотаПоАдресуЭлектроннойПочты(АдресЭлектроннойПочты, Ложь);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьСерверДокументооборотаПоАдресуЭлектроннойПочты(АдресЭлектроннойПочты, ОпределитьНалоговыйОрганПриНеобходимости = Истина) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	СерверыДокументооборота.Ссылка
	                      |ИЗ
	                      |	Справочник.СерверыДокументооборота КАК СерверыДокументооборота
	                      |ГДЕ
	                      |	СерверыДокументооборота.АдресЭлектроннойПочтыФНС = &АдресЭлектроннойПочты
	                      |	ИЛИ СерверыДокументооборота.АдресЭлектроннойПочтыПФР = &АдресЭлектроннойПочты
	                      |	ИЛИ СерверыДокументооборота.АдресЭлектроннойПочтыФСГС = &АдресЭлектроннойПочты");
	Запрос.УстановитьПараметр("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если ОпределитьНалоговыйОрганПриНеобходимости Тогда
		Возврат ОпределитьНалоговыйОрганПоАдресуЭлектроннойПочты(АдресЭлектроннойПочты, Ложь);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
 
&НаСервереБезКонтекста
Процедура РаспознатьТранспортноеСообщение(парамОбъект, Записывать = Истина) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.РаспознатьТранспортноеСообщение(парамОбъект, Записывать);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТранспортноеСообщениеОбрабатывается(ТранспортноеСообщение) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ТранспортноеСообщениеОбрабатывается(ТранспортноеСообщение);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСообщенияПоУчетнойЗаписи(Знач УчетнаяЗапись, ТихийРежим = Ложь, СообщенияРезультат = Неопределено)

	ДокументооборотСКО.НачатьСеансДокументооборотаСКО(Перечисления.ИнициаторыСеансовСвязиСКонтролирующимиОрганами.Пользователь, УчетнаяЗапись);
	
	Попытка
		СообщенияРезультат = ДокументооборотСКО.ПолучитьСообщения(УчетнаяЗапись);
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДокументооборотСКО.ЗакончитьСеансДокументооборотаСКО(УчетнаяЗапись, Истина);
		Возврат Ложь;
	КонецПопытки;
		   
	ДокументооборотСКО.ЗакончитьСеансДокументооборотаСКО(УчетнаяЗапись, Истина);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьТребующиеРасшифровкиСообщения(Знач УчетнаяЗапись)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТранспортноеСообщение.Ссылка КАК Ссылка,
		|	ТранспортноеСообщение.Тип КАК Тип,
		|	ТранспортноеСообщение.УчетнаяЗапись КАК УчетнаяЗапись,
		|	ТранспортноеСообщение.Отправитель КАК Отправитель,
		|	ТранспортноеСообщение.Получатель КАК Получатель
		|ПОМЕСТИТЬ Сообщения
		|ИЗ
		|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
		|ГДЕ
		|	НЕ ТранспортноеСообщение.ПометкаУдаления
		|	И ТранспортноеСообщение.УчетнаяЗапись = &УчетнаяЗапись
		|	И ТранспортноеСообщение.ДатаТранспорта > &ТриМесяцаНазад
		|	И НЕ ТранспортноеСообщение.ЦиклОбмена.ПометкаУдаления
		|	И ТранспортноеСообщение.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПисем.Полученное)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦиклыОбмена.Ссылка КАК Ссылка,
		|	ЦиклыОбмена.ДатаСоздания КАК ДатаСоздания,
		|	ЦиклыОбмена.Вид КАК Вид
		|ПОМЕСТИТЬ Циклы
		|ИЗ
		|	Справочник.ЦиклыОбмена КАК ЦиклыОбмена
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сообщения КАК Сообщения
		|		ПО (Сообщения.Ссылка.ЦиклОбмена = ЦиклыОбмена.Ссылка)
		|ГДЕ
		|	НЕ ЦиклыОбмена.ПометкаУдаления
		|	И ЦиклыОбмена.УчетнаяЗапись = &УчетнаяЗапись
		|	И ЦиклыОбмена.ДатаСоздания > &ТриМесяцаНазад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение КАК ТранспортноеСообщение
		|ПОМЕСТИТЬ Исключенные
		|ИЗ
		|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сообщения КАК Сообщения
		|		ПО (Сообщения.Ссылка = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсключенныеСообщения.ТранспортноеСообщение
		|ИЗ
		|	РегистрСведений.ИсключенныеИзОбработкиТранспортныеСообщения КАК ИсключенныеСообщения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сообщения КАК Сообщения
		|		ПО (Сообщения.Ссылка = ИсключенныеСообщения.ТранспортноеСообщение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сообщения.Ссылка КАК ТранспортноеСообщение,
		|	Сообщения.Тип КАК Тип,
		|	Циклы.ДатаСоздания КАК ДатаСоздания,
		|	ЛОЖЬ КАК Удалить,
		|	УчетныеЗаписи.ЭтоМультиРежим КАК ЭтоМультиРежим,
		|	УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Сообщения.Отправитель) = ТИП(Справочник.НалоговыеОрганы)
		|				ИЛИ ТИПЗНАЧЕНИЯ(Сообщения.Получатель) = ТИП(Справочник.НалоговыеОрганы)
		|				ИЛИ Циклы.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСФНС)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
		|		КОГДА ТИПЗНАЧЕНИЯ(Сообщения.Отправитель) = ТИП(Справочник.ОрганыФСГС)
		|				ИЛИ ТИПЗНАЧЕНИЯ(Сообщения.Получатель) = ТИП(Справочник.ОрганыФСГС)
		|				ИЛИ Циклы.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСФСГС)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
		|		КОГДА ТИПЗНАЧЕНИЯ(Сообщения.Отправитель) = ТИП(Справочник.ОрганыПФР)
		|				ИЛИ ТИПЗНАЧЕНИЯ(Сообщения.Получатель) = ТИП(Справочник.ОрганыПФР)
		|				ИЛИ Циклы.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСПФР)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПФР)
		|		КОГДА Сообщения.Тип В (&ТипыТранспортныхСообщенийЦБ)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ЦБ)
		|	КОНЕЦ КАК Направление,
		|	УчетныеЗаписи.ЭтоМультиРежим
		|		И Сообщения.Тип В (&ТипыСообщенийИнициированныхФНС) КАК ТолькоДляШифровальщика
		|ИЗ
		|	РегистрСведений.ТранспортныеКонтейнеры КАК ТранспортныеКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сообщения КАК Сообщения
		|		ПО (Сообщения.Ссылка = ТранспортныеКонтейнеры.ТранспортноеСообщение)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Циклы КАК Циклы
		|		ПО (Сообщения.Ссылка.ЦиклОбмена = Циклы.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписи
		|		ПО (Сообщения.УчетнаяЗапись = УчетныеЗаписи.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВладельцыОбъектов1СОтчетности КАК ВладельцыОбъектов1СОтчетности
		|		ПО (Циклы.Ссылка = ВладельцыОбъектов1СОтчетности.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВладельцыОбъектов1СОтчетности КАК ВладельцыОбъектов1СОтчетностиТС
		|		ПО (Сообщения.Ссылка = ВладельцыОбъектов1СОтчетностиТС.Объект
		|			И ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL)
		|ГДЕ
		|	УчетныеЗаписи.Ссылка = &УчетнаяЗапись
		|	И НЕ ТранспортныеКонтейнеры.ТранспортноеСообщение В
		|				(ВЫБРАТЬ
		|					Исключенные.ТранспортноеСообщение
		|				ИЗ
		|					Исключенные)
		|	И (НЕ УчетныеЗаписи.ЭтоМультиРежим
		|	ИЛИ (ВладельцыОбъектов1СОтчетности.Владелец = &ТекущийПользователь
		|			ИЛИ ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL)
		|		И (ВладельцыОбъектов1СОтчетностиТС.Владелец = &ТекущийПользователь
		|			ИЛИ ВладельцыОбъектов1СОтчетностиТС.Владелец ЕСТЬ NULL))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.Ссылка,
		|	Циклы.ДатаСоздания,
		|	Сообщения.Тип.Порядок");
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	УчетнаяЗапись = ?(
		ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации"),
		УчетнаяЗаписьОрганизации(УчетнаяЗапись), 
		УчетнаяЗапись);
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", 					УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТриМесяцаНазад", 				ТекущаяДатаСеанса() - 90*24*60*60);
	Запрос.УстановитьПараметр("ТипыТранспортныхСообщенийЦБ", 	КонтекстЭДОСервер.ТипыТранспортныхСообщенийЦБ());
	Запрос.УстановитьПараметр("ТипыСообщенийИнициированныхФНС", КонтекстЭДОСервер.ТипыСообщенийИнициированныхФНС());
	Запрос.УстановитьПараметр("УчетнаяЗапись", 					УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТекущийПользователь", 			ТекущийПользователь);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из Таблица Цикл
	
		ИсключитьТранспортноеСообщениеИзСпискаСообщенийПолученныхАвтообменом(Строка.ТранспортноеСообщение);
		
		Если Не ТранспортноеСообщениеОбрабатывается(Строка.ТранспортноеСообщение) Тогда
			Строка.Удалить = Истина;
			Продолжить;
		КонецЕсли;
	
	КонецЦикла;
	
	Мультирежим.СообщенияДляРасшифровки_ПроверитьПраваНаУчетнуюЗапись(Таблица, УчетнаяЗапись, Ложь);
	КонтекстЭДОСервер.СообщенияДляРасшифровки_УдалитьЛишниеСтроки(Таблица);
	
	Результат = Новый Массив;
	Для каждого Строка Из Таблица Цикл
		
		Результат.Добавить(Новый Структура("ТранспортноеСообщение, Тип", Строка.ТранспортноеСообщение, Строка.Тип));
		
	КонецЦикла;
	
	Мультирежим.ЗаписатьДатуПросмотраНерасшифрованных(УчетнаяЗапись);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИсключитьТранспортноеСообщениеИзСпискаСообщенийПолученныхАвтообменом(ТранспортноеСообщение)

	НачатьТранзакцию();
	Попытка
		НовыйНабор = РегистрыСведений.СвойстваТранспортныхСообщений.СоздатьНаборЗаписей();
		НовыйНабор.Отбор.ТранспортноеСообщение.Установить(ТранспортноеСообщение);
		НовыйНабор.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьСообщенияПоУчетнойЗаписи(Знач УчетнаяЗапись, ТихийРежим = Ложь, ОбращениеККлючуРазрешено = Истина, ВыполняемоеОповещение = Неопределено)
	
	ТребующиеРасшифровкиСообщения = ПолучитьТребующиеРасшифровкиСообщения(УчетнаяЗапись); // сервер
	Если ТребующиеРасшифровкиСообщения.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки = Новый Массив;
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки.Добавить(СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_КритическаяОшибка);
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки.Добавить(СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_УведомлениеОбОшибкеПФР);
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки.Добавить(СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_УведомлениеОбОшибкеФНС);
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки.Добавить(СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_УведомлениеОбОшибкеФСГС);
	
	КоличествоРасшифрованных = 0;
	КоличествоНеРасшифрованных = 0;
	НомерОбъекта = 0;
	
	РасшифроватьТребующиеРасшифровкиСообщения(ВыполняемоеОповещение, КоличествоНеРасшифрованных, КоличествоРасшифрованных, НомерОбъекта, ОбращениеККлючуРазрешено, ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки, ТихийРежим, ТребующиеРасшифровкиСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТребующиеРасшифровкиСообщения(
	ВыполняемоеОповещение,
	КоличествоНеРасшифрованных,
	КоличествоРасшифрованных,
	НомерОбъекта,
	ОбращениеККлючуРазрешено,
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки,
	ТихийРежим,
	ТребующиеРасшифровкиСообщения)
	
	Если НомерОбъекта + 1 > ТребующиеРасшифровкиСообщения.Количество() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	Иначе
		ВходящийКонтекст = Новый Структура;
		ВходящийКонтекст.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
		ВходящийКонтекст.Вставить("КоличествоНеРасшифрованных", 	КоличествоНеРасшифрованных);
		ВходящийКонтекст.Вставить("КоличествоРасшифрованных", 		КоличествоРасшифрованных);
		ВходящийКонтекст.Вставить("НомерОбъекта", 					НомерОбъекта);
		ВходящийКонтекст.Вставить("ОбращениеККлючуРазрешено", 		ОбращениеККлючуРазрешено);
		ВходящийКонтекст.Вставить("ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки",
			ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки);
		ВходящийКонтекст.Вставить("ТихийРежим", 					ТихийРежим);
		ВходящийКонтекст.Вставить("ТребующиеРасшифровкиСообщения", 	ТребующиеРасшифровкиСообщения);
		
		Если НомерОбъекта % 10 = 0 Тогда
			// для предотвращения переполнения стека
			ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ВходящийКонтекст,
				"БРО.ВходящийКонтекстасшифроватьТребующееРасшифровкиСообщение");
			ПодключитьОбработчикОжидания("Подключаемый_РасшифроватьТребующееРасшифровкиСообщение", 0.1, Истина);
		Иначе
			РасшифроватьТребующееРасшифровкиСообщение(ВходящийКонтекст);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТребующееРасшифровкиСообщение(ВходящийКонтекст)
	
	ВыполняемоеОповещение 			= ВходящийКонтекст.ВыполняемоеОповещение;
	КоличествоНеРасшифрованных 		= ВходящийКонтекст.КоличествоНеРасшифрованных;
	КоличествоРасшифрованных 		= ВходящийКонтекст.КоличествоРасшифрованных;
	НомерОбъекта 					= ВходящийКонтекст.НомерОбъекта;
	ОбращениеККлючуРазрешено 		= ВходящийКонтекст.ОбращениеККлючуРазрешено;
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки =
		ВходящийКонтекст.ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки;
	ТихийРежим 						= ВходящийКонтекст.ТихийРежим;
	ТребующиеРасшифровкиСообщения 	= ВходящийКонтекст.ТребующиеРасшифровкиСообщения;
	
	ТребующееРасшифровкиСообщение = ТребующиеРасшифровкиСообщения[НомерОбъекта];
	// если обращение к ключу запрещено, то распаковываем только незашифрованные контейнеры
	Если НЕ ОбращениеККлючуРазрешено
		И ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки.Найти(ТребующееРасшифровкиСообщение.Тип) = Неопределено Тогда
		
		РасшифроватьТребующиеРасшифровкиСообщения(
			ВыполняемоеОповещение, 
			КоличествоНеРасшифрованных, 
			КоличествоРасшифрованных, 
			НомерОбъекта + 1, 
			ОбращениеККлючуРазрешено, 
			ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки, 
			ТихийРежим, 
			ТребующиеРасшифровкиСообщения);
			
		Возврат;
	КонецЕсли;
	
	// фиксируем успех или неудачу
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                                ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("КоличествоНеРасшифрованных",                           КоличествоНеРасшифрованных);
	ДополнительныеПараметры.Вставить("КоличествоРасшифрованных",                             КоличествоРасшифрованных);
	ДополнительныеПараметры.Вставить("НомерОбъекта",                                         НомерОбъекта);
	ДополнительныеПараметры.Вставить("ОбращениеККлючуРазрешено",                             ОбращениеККлючуРазрешено);
	ДополнительныеПараметры.Вставить("ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки", ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки);
	ДополнительныеПараметры.Вставить("ТихийРежим",                                           ТихийРежим);
	ДополнительныеПараметры.Вставить("ТребующиеРасшифровкиСообщения",                        ТребующиеРасшифровкиСообщения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РасшифроватьТребующиеРасшифровкиСообщенияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	РасшифроватьТранспортноеСообщение(ТребующееРасшифровкиСообщение.ТранспортноеСообщение, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РасшифроватьТребующееРасшифровкиСообщение() Экспорт
	
	ВходящийКонтекст = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ВходящийКонтекстасшифроватьТребующееРасшифровкиСообщение");
	
	РасшифроватьТребующееРасшифровкиСообщение(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТребующиеРасшифровкиСообщенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	КоличествоНеРасшифрованных = ДополнительныеПараметры.КоличествоНеРасшифрованных;
	КоличествоРасшифрованных = ДополнительныеПараметры.КоличествоРасшифрованных;
	НомерОбъекта = ДополнительныеПараметры.НомерОбъекта;
	ОбращениеККлючуРазрешено = ДополнительныеПараметры.ОбращениеККлючуРазрешено;
	ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки = ДополнительныеПараметры.ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки;
	ТихийРежим = ДополнительныеПараметры.ТихийРежим;
	ТребующиеРасшифровкиСообщения = ДополнительныеПараметры.ТребующиеРасшифровкиСообщения;
	
	Если Результат Тогда
		КоличествоРасшифрованных = КоличествоРасшифрованных + 1;
	Иначе
		КоличествоНеРасшифрованных = КоличествоНеРасшифрованных + 1;
	КонецЕсли;
	
	РасшифроватьТребующиеРасшифровкиСообщения(ВыполняемоеОповещение, КоличествоНеРасшифрованных, КоличествоРасшифрованных, НомерОбъекта + 1, ОбращениеККлючуРазрешено, ТипыСообщенийНеТребующихОбращенияККлючуДляРаспаковки, ТихийРежим, ТребующиеРасшифровкиСообщения);
	
КонецПроцедуры


#Область ОтправкаНеформализованногоДокументаВФНС

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНС(Док, Организация, ВыполняемоеОповещение, ОтобразитьРезультат = Истина) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура("Док, Организация, ВыполняемоеОповещение", Док, Организация, ВыполняемоеОповещение);
	Контекст.Вставить("ОтобразитьРезультат", ОтобразитьРезультат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФНСПослеАвтонастройкиУчетнойЗаписи", 
		ЭтотОбъект, 
		Контекст);
		
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", Док);
	КонтекстДлительнойОперации.Вставить("Организация", Организация);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", ОписаниеОповещения);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка письма в ФНС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаНеформализованногоДокументаВФНС",  0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаНеформализованногоДокументаВФНС() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Док = КонтекстДлительнойОперации.Док;
	ОписаниеОповещения = КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Док,ОписаниеОповещения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаНеформализованногоДокументаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Не выбран документ для отправки'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель письма.';
								|en = 'Не задан получатель письма.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем на макс. объем вложений 100Мб
	Приложения = ПолучитьВложенияНеформализованногоДокумента(Док, , Истина);
	ОбщиеРазмер = Приложения.Итог("Размер");
	Если ОбщиеРазмер > 100 *1024*1024 Тогда // общий размер не может превышать 100Мб
		ТекстСообщения = НСтр("ru = 'Общий размер вложений отправляемого сообщения превышает 100 Мб.
				|К сожалению, форматом запрещена отправка сообщений с вложениями общим размером более 100 Мб.';
				|en = 'Общий размер вложений отправляемого сообщения превышает 100 Мб.
				|К сожалению, форматом запрещена отправка сообщений с вложениями общим размером более 100 Мб.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ДвоичныеДанныеФайлаПисьма = Неопределено;
	ИмяФайлаПисьма = Неопределено;
	РезультатФормированияФайлаПисьма = СформироватьФайлПисьма(Док, ДвоичныеДанныеФайлаПисьма, ИмяФайлаПисьма);
	Если НЕ РезультатФормированияФайлаПисьма Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КороткоеИмяФайлаПисьма = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	КодНалоговогоОргана = СокрЛП(Док.Получатель.Код);
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		
		// формируем файл доверенности
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(ЭлРегистрацияВИФНС, КороткоеИмяФайлаДоверенности, Организация);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
		
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = Док.Идентификатор;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = Док.Получатель;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.ОбращениеНП;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ОбращениеНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = Док.Получатель;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем письмо
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение, ДвоичныеДанныеФайлаПисьма, ИмяФайлаПисьма, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка письма прервана.';
								|en = 'Отправка письма прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к письму
	Для Каждого СтрПриложение Из Приложения Цикл
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, СтрПриложение.Данные, СтрПриложение.ИмяФайла, СтрПриложение.Размер, , , , , , СгенерироватьUUID(), ТипСодержимогоПоИмениФайла(СтрПриложение.ИмяФайла)) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, ФайлДоверенности, КороткоеИмяФайлаДоверенности, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	Параметры_ОтобразитьРезультат 	= ВходящийКонтекст.ОтобразитьРезультат;
	
	ОтправкаНеформализованногоДокументаВФНС(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение, Параметры_ОтобразитьРезультат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ОтобразитьРезультат = ВходящийКонтекст.ОтобразитьРезультат;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись изменений...");
	
	// отражаем изменения в базе
	Если НЕ ОтправкаНеформализованногоДокументаВФНС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаНеформализованногоДокументаВФНС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
			
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);

			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС

		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ДокументооборотСКОВызовСервера.ОрганизацияПодключенаКИнспекции(Док)
		ИЛИ НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 	ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	Контекст.Вставить("ОтобразитьРезультат", 	ОтобразитьРезультат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФНС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		Контекст);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФНС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(
		ОписаниеОповещения, 
		ВходящийКонтекст.КонтекстОтправки.Документ, 
		ВходящийКонтекст.КонтекстОтправки.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВФНСПослеФормированияПакета", 
		ЭтотОбъект,
		ВходящийКонтекст);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	Отправка_СформироватьПакет(Оповещение, ВходящийКонтекст.КонтекстОтправки.ТранспортноеСообщение, "ФНС");

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВФНСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС
		Возврат;
	КонецЕсли;
	
	Если ВходящийКонтекст.ОтобразитьРезультат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Письмо в ФНС
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, КонтекстОтправки.Документ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ЗаписатьУзелДереваВXML(СтрокаДерева, ПотокXML)
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Тогда
		ПотокXML.ЗаписатьНачалоЭлемента("К_2_180_06_001_001");
		ПотокXML.ЗаписатьАтрибут("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance");
		ПотокXML.ЗаписатьАтрибут("xsi:noNamespaceSchemaLocation", "NP_NO_2_180_06_001_001.xsd");
		Для каждого Стр Из СтрокаДерева.Строки Цикл
			ЗаписатьУзелДереваВXML(Стр, ПотокXML);
		КонецЦикла;
		ПотокXML.ЗаписатьКонецЭлемента();
	Иначе
		Если СтрокаДерева.Тип = "А" ИЛИ СтрокаДерева.Тип = "A" Тогда 
			ПотокXML.ЗаписатьАтрибут(СтрокаДерева.Код, Строка(СтрокаДерева.Значение));
		Иначе
			ПотокXML.ЗаписатьНачалоЭлемента(СтрокаДерева.Код);
			Для каждого Лист из СтрокаДерева.Строки Цикл
				ЗаписатьУзелДереваВXML(Лист, ПотокXML);
			КонецЦикла;
			ПотокXML.ЗаписатьТекст(Строка(СтрокаДерева.Значение));
			ПотокXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьДеревоВXML(Дерево);
	
	ПотокXML = РегламентированнаяОтчетность.СоздатьНовыйПотокXML();
	
	Для Каждого Стр Из Дерево.Строки Цикл
		ЗаписатьУзелДереваВXML(Стр, ПотокXML);
	КонецЦикла;
	
	ТекстДляЗаписи = ПотокXML.Закрыть();
	ТекстДляЗаписи = "<?xml version=""1.0"" encoding=""windows-1251""?>" + Сред(ТекстДляЗаписи, СтрНайти(ТекстДляЗаписи, Символы.ПС));
	Возврат ТекстДляЗаписи;
	
КонецФункции
      
&НаСервереБезКонтекста
Функция СформироватьПараметрыПисьма(Письмо)
	
	СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Письмо.Организация);
	
	ЭтоПБОЮЛ = НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Письмо.Организация);
	СведенияОбОрганизации.Вставить("ЭтоПБОЮЛ", ЭтоПБОЮЛ);
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	КодНалоговогоОргана = СокрЛП(Письмо.Получатель.Код);
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(
		Письмо.Организация,
		КодНалоговогоОргана,,
		НЕ ЭтоПБОЮЛ,
		СведенияОбОрганизации);
		
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
		
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		ДоверенностьПредставителя = Доверенность;
		// признак подписания представителем
		СведенияОбОрганизации.Вставить("ПрПодп", 2);
		СведенияДоверенности = ПолучитьСведенияДоверенности(ЭлРегистрацияВИФНС, Письмо.Организация);
		Если СведенияДоверенности = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		СведенияОбОрганизации.Вставить("Доверенность", СведенияДоверенности);
	Иначе
		// признак подписания налогоплательщиком
		СведенияОбОрганизации.Вставить("ПрПодп", 1);
	КонецЕсли;
	
	Если ЭтоПБОЮЛ Тогда
		ФИОИП = ФИОИндивидуальногоПредпринимателя(Письмо.Организация, СведенияОбОрганизации);
		Если ФИОИП = Неопределено Тогда
			СведенияОбОрганизации.Вставить("ИПФамилия", "");
			СведенияОбОрганизации.Вставить("ИПИмя", "");
			СведенияОбОрганизации.Вставить("ИПОтчество", "");
		Иначе
			СведенияОбОрганизации.Вставить("ИПФамилия", ФИОИП.Фамилия);
			СведенияОбОрганизации.Вставить("ИПИмя", ФИОИП.Имя);
			СведенияОбОрганизации.Вставить("ИПОтчество", ФИОИП.Отчество);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
			СведенияОбОрганизации.Вставить("КППЮЛ", СокрЛП(ЭлРегистрацияВИФНС.КПП));
		Иначе
			СведенияОбОрганизации.Вставить("КППЮЛ", СокрЛП(СведенияОбОрганизации.КППЮЛ));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СведенияОбОрганизации;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьЗаполнениеПисьма(Письмо, Параметры)
	
	СтатусПроверки = Истина;
	
	Если Параметры = Неопределено Тогда
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Письмо.Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не задана организация!';
								|en = 'Не задана организация!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	ИначеЕсли НЕ ЗначениеЗаполнено(Письмо.Получатель) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель!';
								|en = 'Не задан получатель!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		СтатусПроверки = Ложь;
		Возврат СтатусПроверки;
	КонецЕсли;
	
	// проверка сведений об отправителе
	Если Параметры.ПрПодп = 1 Тогда // отправитель - налогоплательщик
		Если Параметры.ЭтоПБОЮЛ Тогда
			Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН индивидуального предпринимателя!';
																	|en = 'Не задан ИНН индивидуального предпринимателя!'"));
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СвПредст = Параметры.Доверенность.СвУпПред.СвПред;
		Если НЕ СвПредст.Свойство("СвОрг") Тогда
			Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННФЛ = СвПредст.СведФизЛ.ИННФЛ;
			Иначе
				ИННФЛ = ?(Параметры.ЭтоПБОЮЛ, Параметры.ИННФЛ, Параметры.ИННЮЛ);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ИННФЛ) Тогда
				Если НЕ СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации ИЛИ Параметры.ЭтоПБОЮЛ Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН физлица-представителя!';
																		|en = 'Не задан ИНН физлица-представителя!'"));
				Иначе
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не задан ИНН организации физлица-представителя!';
																		|en = 'Не задан ИНН организации физлица-представителя!'"));
				КонецЕсли;
				СтатусПроверки = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// проверяем сведения об организации
	Если НЕ Параметры.ЭтоПБОЮЛ Тогда
	
		Если ПустаяСтрока(Параметры.АдрЮр) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан адрес организации (индивидуального предпринимателя)!';
									|en = 'Не задан адрес организации (индивидуального предпринимателя)!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ОргРайон) И НЕ ЗначениеЗаполнено(Параметры.ОргГород) И НЕ ЗначениеЗаполнено(Параметры.ОргНПункт)
			И НЕ ЗначениеЗаполнено(Параметры.ОргУлица) И НЕ ЗначениеЗаполнено(Параметры.ОргДом) И НЕ ЗначениеЗаполнено(Параметры.ОргКорпус)
			И НЕ ЗначениеЗаполнено(Параметры.ОргКвартира) И СтрЧислоВхождений(Параметры.АдрЮР, ",") <> 9 И СтрЧислоВхождений(Параметры.АдрЮР, ",") <> 12 Тогда
			ТекстСообщения = НСтр("ru = 'Адрес организации (индивидуального предпринимателя) должен содержать в себе 9 или 12 запятых!';
									|en = 'Адрес организации (индивидуального предпринимателя) должен содержать в себе 9 или 12 запятых!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если Параметры.ОргКодСубъект = "" Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить код региона, указанного в адресе организации (индивидуального предпринимателя).
										|Проверьте правильность указания региона!';
										|en = 'Не удалось определить код региона, указанного в адресе организации (индивидуального предпринимателя).
										|Проверьте правильность указания региона!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.НаимЮЛПол) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано полное наименование организации.';
									|en = 'Не задано полное наименование организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИННЮЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН организации.';
									|en = 'Не задан ИНН организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(Параметры.ИННЮЛ, Ложь) Тогда
			ТекстСообщения = НСтр("ru = 'Некорректно задан ИНН организации.';
									|en = 'Некорректно задан ИНН организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.КППЮЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан КПП организации.';
									|en = 'Не задан КПП организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли СтрДлина(Параметры.КППЮЛ) <> 9 Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан КПП организации.';
									|en = 'Неверно задан КПП организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		
		Если ПустаяСтрока(Параметры.АдрМЖ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан адрес места жительства индивидуального предпринимателя!';
									|en = 'Не задан адрес места жительства индивидуального предпринимателя!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.РайонМЖ) И НЕ ЗначениеЗаполнено(Параметры.ГородМЖ) И НЕ ЗначениеЗаполнено(Параметры.НПунктМЖ)
			И НЕ ЗначениеЗаполнено(Параметры.УлицаМЖ) И НЕ ЗначениеЗаполнено(Параметры.ДомМЖ) И НЕ ЗначениеЗаполнено(Параметры.КорпусМЖ)
			И НЕ ЗначениеЗаполнено(Параметры.КвартираМЖ) И СтрЧислоВхождений(Параметры.АдрМЖ, ",") <> 9 И СтрЧислоВхождений(Параметры.АдрМЖ, ",") <> 12 Тогда
			ТекстСообщения = НСтр("ru = 'Адрес места жительства индивидуального предпринимателя должен содержать в себе 9 или 12 запятых!';
									|en = 'Адрес места жительства индивидуального предпринимателя должен содержать в себе 9 или 12 запятых!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если Параметры.ОргКодСубъект = "" Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить код региона, указанного в адресе места жительства индивидуального предпринимателя.
										|Проверьте правильность указания региона!';
										|en = 'Не удалось определить код региона, указанного в адресе места жительства индивидуального предпринимателя.
										|Проверьте правильность указания региона!'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИННФЛ) Тогда
			ТекстСообщения = НСтр("ru = 'Не задан ИНН индивидуального предпринимателя.';
									|en = 'Не задан ИНН индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(Параметры.ИННФЛ, Истина) Тогда
			ТекстСообщения = НСтр("ru = 'Неверно задан ИНН индивидуального предпринимателя.';
									|en = 'Неверно задан ИНН индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИПФамилия) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана фамилия индивидуального предпринимателя.';
									|en = 'Не задана фамилия индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Параметры.ИПИмя) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано имя индивидуального предпринимателя.';
									|en = 'Не задано имя индивидуального предпринимателя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// если представитель объявлен, то проверяем сведения о нем
	Если Параметры.ПрПодп = 2 Тогда
		
		СведенияДоверенности = Параметры.Доверенность;
		СведФизЛ = СведенияДоверенности.СвУпПред.СвПред.СведФизЛ;
		ФИОПодписанта = ДокументооборотСКОВызовСервера.УточнитьФИОПредставителя(
			СведФизЛ.ФИО,
			СведенияДоверенности.ДанныеПредставителя);
		Если НЕ ЗначениеЗаполнено(ФИОПодписанта) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задано ФИО уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задано ФИО уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Фамилия) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задана фамилия уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задана фамилия уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Имя) Тогда
			ТекстСообщения = НСтр("ru = 'В сведениях о доверенности не задано имя уполномоченного лица представителя.';
									|en = 'В сведениях о доверенности не задано имя уполномоченного лица представителя.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	Иначе
		
		ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(Параметры.ФИОРук);
		Если НЕ ЗначениеЗаполнено(ФИОПодписанта.Фамилия) Тогда
			ТекстСообщения = НСтр("ru = 'Не задана фамилия руководителя организации.';
									|en = 'Не задана фамилия руководителя организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		ИначеЕсли НЕ ЗначениеЗаполнено(ФИОПодписанта.Имя) Тогда
			ТекстСообщения = НСтр("ru = 'Не задано имя руководителя организации.';
									|en = 'Не задано имя руководителя организации.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			СтатусПроверки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Возврат СтатусПроверки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьФайлПисьма(Письмо, ДвоичныеДанныеФайлаПисьма, ИмяФайлаПисьма)
	
	// собираем параметры письма
	ПараметрыПисьма = СформироватьПараметрыПисьма(Письмо);
	Если НЕ ПроверитьЗаполнениеПисьма(Письмо, ПараметрыПисьма) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать пакет с письмом!';
								|en = 'Не удалось сформировать пакет с письмом!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем идентификатор отправителя
	Если ПараметрыПисьма.ПрПодп = 2 Тогда
		СвПред = ПараметрыПисьма.Доверенность.СвУпПред.СвПред;
		Если СвПред.Свойство("СвОрг") Тогда
			ИННКПП = СокрЛП(СвПред.СвОрг.ИННЮЛ) + СокрЛП(СвПред.СвОрг.КПП);
		Иначе
			Если НЕ ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННКПП = СокрЛП(СвПред.СведФизЛ.ИННФЛ);
			ИначеЕсли ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации
				И ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
				И ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
				И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица") Тогда
				ИННКПП = ?(ПараметрыПисьма.Доверенность.СвПредст.ЯвляетсяФЛ, СокрЛП(ПараметрыПисьма.Доверенность.СвПредст.ИННФЛ),
					СокрЛП(ПараметрыПисьма.Доверенность.СвПредст.ИННЮЛ) + СокрЛП(ПараметрыПисьма.КППЮЛ));
			Иначе
				ИННКПП = ?(ПараметрыПисьма.ЭтоПБОЮЛ, СокрЛП(ПараметрыПисьма.ИННФЛ), СокрЛП(ПараметрыПисьма.ИННЮЛ) + СокрЛП(ПараметрыПисьма.КППЮЛ));
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИННКПП = ?(ПараметрыПисьма.ЭтоПБОЮЛ, СокрЛП(ПараметрыПисьма.ИННФЛ), СокрЛП(ПараметрыПисьма.ИННЮЛ) + СокрЛП(ПараметрыПисьма.КППЮЛ));
	КонецЕсли;
	
	ЭтоКрупнейший    = ДокументооборотСКО.ЭтоКрупнейший(Письмо.Организация);
	КодНОКрупнейшего = ДокументооборотСКО.КодНОКрупнейшего(Письмо.Организация);

	ИмяФайлаБезРасширения = "IU_OBRNP_"
							 + ?(ЭтоКрупнейший И ЗначениеЗаполнено(КодНОКрупнейшего), СокрЛП(КодНОКрупнейшего), СокрЛП(Письмо.Получатель.Код))
							 + "_"
							 + СокрЛП(Письмо.Получатель.Код)
							 + "_"
							 + ИННКПП
							 + "_"
							 + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd")
							 + "_"
							 + Строка(Новый УникальныйИдентификатор);
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	УзелФайл = ДобавитьУзелXML(Дерево, "Файл");
	ДобавитьУзелXML(УзелФайл, "ИдФайл", Истина, XMLСтрока(ИмяФайлаБезРасширения));
	ДобавитьУзелXML(УзелФайл, "ВерсПрог", Истина, Лев(XMLСтрока(РегламентированнаяОтчетность.НазваниеИВерсияПрограммы()), 40));
	ДобавитьУзелXML(УзелФайл, "ВерсФорм", Истина, XMLСтрока("5.04"));
	УзелДокумент = ДобавитьУзелXML(УзелФайл, "Документ");
	
		ДобавитьУзелXML(УзелДокумент, "КНД", Истина, XMLСтрока("1166102"));
		ДобавитьУзелXML(УзелДокумент, "ДатаДок", Истина, XMLСтрока(Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy")));
		
		УзелСвНП = ДобавитьУзелXML(УзелДокумент, "СвНП");
		Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
			
			УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "НПЮЛ");
			
				ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(ПараметрыПисьма.НаимЮЛПол), 1000));
				ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(ПараметрыПисьма.ИННЮЛ));
				ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(ПараметрыПисьма.КППЮЛ));
				
		Иначе
			
			УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "НПФЛ");
			
				ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
				УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
				
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
					
		КонецЕсли;
		
		УзелСвНП = ДобавитьУзелXML(УзелДокумент, "СвОтпр");
		Если ПараметрыПисьма.ПрПодп = 1 Тогда // отправитель - налогоплательщик
			Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
				УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
					ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(ПараметрыПисьма.НаимЮЛПол), 1000));
					ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(ПараметрыПисьма.ИННЮЛ));
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(ПараметрыПисьма.КППЮЛ));
			Иначе
				УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
					ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
					УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
						ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
						ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
						ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
			КонецЕсли;
		Иначе
			СвДоверенность = ПараметрыПисьма.Доверенность;
			СвПредст = СвДоверенность.СвУпПред.СвПред;
			Если СвПредст.Свойство("СвОрг") Тогда // представитель - ЮЛ
				УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
					ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(СокрЛП(СвПредст.СвОрг.НаимОрг)), 1000));
					ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(СвПредст.СвОрг.ИННЮЛ));
					ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(СвПредст.СвОрг.КПП));
			Иначе
				
				Если СвПредст.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
					Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
						УзелНПЮЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрЮЛ");
						ДобавитьУзелXML(УзелНПЮЛ, "НаимОрг", Истина, Лев(XMLСтрока(ПараметрыПисьма.НаимЮЛПол), 1000));
						ДобавитьУзелXML(УзелНПЮЛ, "ИННЮЛ", Истина, XMLСтрока(ПараметрыПисьма.ИННЮЛ));
						ДобавитьУзелXML(УзелНПЮЛ, "КПП", Истина, XMLСтрока(ПараметрыПисьма.КППЮЛ));	
					Иначе
						УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
						ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(ПараметрыПисьма.ИННФЛ)), Истина);
						УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
						ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
						ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
						ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
					КонецЕсли;
				Иначе	
					УзелНПФЛ = ДобавитьУзелXML(УзелСвНП, "СвОтпрФЛ");
					ДобавитьУзелXML(УзелНПФЛ, "ИННФЛ", Истина, XMLСтрока(СокрЛП(СвПредст.СведФизЛ.ИННФЛ)), Истина);
					ФИОПредставителя = СвПредст.СведФизЛ.ФИО;
					УзелФИО = ДобавитьУзелXML(УзелНПФЛ, "ФИО");
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПредставителя.Отчество)), 60), Истина);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
		
		УзелПодписант = ДобавитьУзелXML(УзелДокумент, "Подписант");
			ДобавитьУзелXML(УзелПодписант, "ПрПодп", Истина, ПараметрыПисьма.ПрПодп);
			УзелФИО = ДобавитьУзелXML(УзелПодписант, "ФИО");
			Если ПараметрыПисьма.ПрПодп = 1 Тогда
				Если НЕ ПараметрыПисьма.ЭтоПБОЮЛ Тогда
					ФИОПодписанта = РегламентированнаяОтчетность.РазложитьФИО(ПараметрыПисьма.ФИОРук);
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
				Иначе
					ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПФамилия)), 60));
					ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПИмя)), 60));
					ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ПараметрыПисьма.ИПОтчество)), 60), Истина);
				КонецЕсли;
			Иначе
				ФИОПодписанта = ДокументооборотСКОВызовСервера.УточнитьФИОПредставителя(
					ПараметрыПисьма.Доверенность.СвУпПред.СвПред.СведФизЛ.ФИО,
					ПараметрыПисьма.Доверенность.ДанныеПредставителя);
				ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Фамилия)), 60));
				ДобавитьУзелXML(УзелФИО, "Имя", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Имя)), 60));
				ДобавитьУзелXML(УзелФИО, "Отчество", Истина, Лев(XMLСтрока(СокрЛП(ФИОПодписанта.Отчество)), 60), Истина);
			КонецЕсли;
		
		УзелОбращИнф = ДобавитьУзелXML(УзелДокумент, "ОбращИнф");
		
			ДобавитьУзелXML(УзелОбращИнф, "ИФНС", Истина, XMLСтрока(СокрЛП(Письмо.Получатель.Код)));
			ДобавитьУзелXML(УзелОбращИнф, "ОбращТекст", , СокрЛП(Письмо.Содержание), , Истина);
			УзелПрил = ДобавитьУзелXML(УзелОбращИнф, "Прил");
			
				Вложения = ПолучитьВложенияНеформализованногоДокумента(Письмо);
				ДобавитьУзелXML(УзелПрил, "КолФайл", Истина, XMLСтрока(Вложения.Количество()));
				Для Каждого Вложение Из Вложения Цикл
					ДобавитьУзелXML(УзелПрил, "НаимПрил", , XMLСтрока(СокрЛП(Вложение.ИмяФайла)));
				КонецЦикла;
		
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ВремФайл, "windows-1251");
	ЗаписьТекста.Записать(ТекстВыгрузкиXML);
	ЗаписьТекста.Закрыть();
	
	ДвоичныеДанныеФайлаПисьма = Новый ДвоичныеДанные(ВремФайл);
	УдалитьФайлы(ВремФайл);
	
	ИмяФайлаПисьма = ИмяФайлаБезРасширения + ".xml";
	
	Возврат Истина;
	
КонецФункции

#Область ОтправкаНеформализованногоДокументаВПФР

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФР(Док, Организация, ВыполняемоеОповещение, ОтобразитьРезультат = Истина) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Док) Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("Док", Док);
	КонтекстДлительнойОперации.Вставить("Организация", Организация);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	КонтекстДлительнойОперации.Вставить("ОтобразитьРезультат", ОтобразитьРезультат);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиЗаключенногоСоглашенияСПФР", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ПроверитьЧтоЗаключеноСоглашениеСПФР(Док, Организация, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиЗаключенногоСоглашенияСПФР(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> Истина Тогда
		
		ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВПФР_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Док, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФР_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Док = ВходящийКонтекст.Док;
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Док;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 5;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка письма в ПФР
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаНеформализованногоДокументаВПФР",  0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаНеформализованногоДокументаВПФР() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();

	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВПФРПослеАвтонастройкиУчетнойЗаписи", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(КонтекстДлительнойОперации.Док, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	Параметры_ОтобразитьРезультат	= ВходящийКонтекст.ОтобразитьРезультат;
	
	ОтправкаНеформализованногоДокументаВПФР(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение, Параметры_ОтобразитьРезультат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФРПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Док, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	Док = ВходящийКонтекст.Док;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ОтобразитьРезультат = ВходящийКонтекст.ОтобразитьРезультат;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", Док);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// отражаем изменения в базе
	Если НЕ ОтправкаНеформализованногоДокументаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаНеформализованногоДокументаВПФР_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
				
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(Док, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Док);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		КонецЕсли;
	
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(Док) Тогда
		
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(Док, ВыполняемоеОповещение, Док); //+
		
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Формирование пакета...");
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОтобразитьРезультат", ОтобразитьРезультат);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаНеформализованногоДокументаВПФРПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ПФР");

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНеформализованногоДокументаВПФРПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР
		Возврат;
	КонецЕсли;
	
	Если ВходящийКонтекст.ОтобразитьРезультат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Письмо в ПФР
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, КонтекстОтправки.Документ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаНеформализованногоДокументаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Док = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Не выбран документ для отправки'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ПФР
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСПФР") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Док.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель письма.';
								|en = 'Не задан получатель письма.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Приложения = ПолучитьВложенияНеформализованногоДокумента(Док, , Истина);
	
	// получаем содержание письма
	ТекстСодержания = Док.Содержание;
	
	// проверяем, не пустое ли письмо
	Если НЕ ЗначениеЗаполнено(ТекстСодержания) И Приложения.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'В письме не задано содержание и отсутствуют вложения.';
								|en = 'В письме не задано содержание и отсутствуют вложения.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ИмяФайлаСодержимого = ВыгрузитьТекстВФайл(ТекстСодержания);
	КороткоеИмяФайлаСодержимого = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР;
	ЦиклОбмена.Предмет = Док;
	ЦиклОбмена.Идентификатор = Док.Идентификатор;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = Док.Получатель;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = Док.Получатель;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем письмо
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо, ИмяФайлаСодержимого, КороткоеИмяФайлаСодержимого, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.Текст1251) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка письма прервана.';
								|en = 'Отправка письма прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к письму
	Для Каждого СтрПриложение Из Приложения Цикл
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение, СтрПриложение.Данные, СтрПриложение.ИмяФайла, СтрПриложение.Размер, , , , , , СгенерироватьUUID(), ТипСодержимогоПоИмениФайла(СтрПриложение.ИмяФайла, Истина)) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Док, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ТипТранспортногоСообщения", ТранспортноеСообщение.Тип);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПоказатьПротоколОнлайнПроверки(
		Отчет, 
		ИмяФайлаВыгрузки, 
		ТекстВыгрузки, 
		ПротоколПроверки, 
		ИмяФайлаПротокола, 
		РезультатПроверкиВУниверсальномФормате = Неопределено, 
		ПрограммаПроверки = "", 
		ПоказФормаУспешнойПроверкиРазрешен = Ложь, 
		ВыполняемоеОповещение = Неопределено) Экспорт
	
	СтруктураПараметров = Новый Структура("Отчет, ИмяФайлаВыгрузки, ТекстВыгрузки, Протокол, ИмяФайлаПротокола, ПрограммаПроверки");
	СтруктураПараметров.Отчет = Отчет;
	Если ТипЗнч(ИмяФайлаВыгрузки) = Тип("Массив") Тогда
		СтруктураПараметров.ИмяФайлаВыгрузки = ?(ИмяФайлаВыгрузки.Количество() > 0, ИмяФайлаВыгрузки[0], "");
	Иначе
		СтруктураПараметров.ИмяФайлаВыгрузки = ИмяФайлаВыгрузки;
	КонецЕсли;
	Если ТипЗнч(ТекстВыгрузки) = Тип("Массив") Тогда
		СтруктураПараметров.ТекстВыгрузки = ?(ТекстВыгрузки.Количество() > 0, ТекстВыгрузки[0], "");
	Иначе
		СтруктураПараметров.ТекстВыгрузки = ТекстВыгрузки;
	КонецЕсли;
	СтруктураПараметров.Протокол = ПротоколПроверки;
	СтруктураПараметров.ИмяФайлаПротокола = ИмяФайлаПротокола;
	СтруктураПараметров.ПрограммаПроверки = ПрограммаПроверки;
	
	Если (РезультатПроверкиВУниверсальномФормате <> 0 И РезультатПроверкиВУниверсальномФормате <> "0") ИЛИ НЕ ПоказФормаУспешнойПроверкиРазрешен Тогда

		СтруктураПараметров.Вставить("РезультатПроверкиВУниверсальномФормате", Строка(РезультатПроверкиВУниверсальномФормате));

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОРезультатеПроверкиВИнтернете(Ложь, СтруктураПараметров);
		Иначе
			ПоказатьРезультатОнлайнПроверкиПоПараметрам(СтруктураПараметров, ВыполняемоеОповещение);
		КонецЕсли;
	Иначе

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОРезультатеПроверкиВИнтернете(Истина, СтруктураПараметров);
		Иначе
			ПоказатьРезультатУспешнойОнлайнПроверкиПоПараметрам(СтруктураПараметров, ВыполняемоеОповещение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатУспешнойОнлайнПроверкиПоПараметрам(СтруктураПараметров, ВыполняемоеОповещение = Неопределено) Экспорт
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.РезультатУспешнойОнлайнПроверки", 
		СтруктураПараметров,
		,
		,
		,
		,
		ВыполняемоеОповещение, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатОнлайнПроверкиПоПараметрам(СтруктураПараметров, ВыполняемоеОповещение = Неопределено) Экспорт
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.РезультатОнлайнПроверки", 
		СтруктураПараметров,
		,
		,
		,
		,
		ВыполняемоеОповещение, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

