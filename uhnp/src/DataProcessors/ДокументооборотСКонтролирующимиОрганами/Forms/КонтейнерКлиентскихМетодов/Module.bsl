&НаСервереБезКонтекста
Функция ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ПодготовкаИПроверкаНаСервере(Контекст)
	
	Если ТипЗнч(Контекст.Документ) = Тип("Массив") Тогда
		ОсновнойОтчет = Контекст.Документ[0];
	Иначе
		ОсновнойОтчет = Контекст.Документ;
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(ОсновнойОтчет));
	Если МетаданныеОбъекта = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Неизвестный тип документа!';
								|en = 'Неизвестный тип документа!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	ИмяТипаОтчета = МетаданныеОбъекта.Имя;
	
	Если ИмяТипаОтчета = "РегламентированныйОтчет" Тогда
		ИсточникОтчета = ОсновнойОтчет.ИсточникОтчета;
	КонецЕсли;
	
	ОрганизацияОтчета = ОрганизацияОтчетаДляОнлайнПроверки(Контекст.Документ);
	УчетнаяЗаписьОрганизации = УчетнаяЗаписьОрганизации(ОрганизацияОтчета);
	
	ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Неопределено;
	Если УчетнаяЗаписьОрганизации <> Неопределено И УчетнаяЗаписьОрганизации <> Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка() Тогда
		ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(УчетнаяЗаписьОрганизации.СпецоператорСвязи, "ОнлайнПроверкаПризнак");
		Если ЗначениеЗаполнено(ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате) Тогда
			ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате = Булево(ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате);
		КонецЕсли;
	КонецЕсли;
	
	ОтправкаПерсональныхДанныхРазрешена = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_ОтправкаПерсональныхДанныхРазрешена");
	
	ЭтоНДС = (ТипЗнч(ОсновнойОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет") И ИсточникОтчета = "РегламентированныйОтчетНДС"
		ИЛИ ТипЗнч(ОсновнойОтчет) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") И ОсновнойОтчет.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НДС);
	
	БольшеНеПоказыватьПредупреждениеПриложенияНДСНаПроверкуНеОтправляются = Ложь;
	Если ЭтоНДС Тогда
		КлючОбъектаПредупрежденияНДС = ?(ТипЗнч(ОсновнойОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет"),
			"ПредупреждениеПриложенияНДСНаПроверкуНеОтправляются",
			"ПредупреждениеПриложенияНДСНаПроверкуНеОтправляютсяДляЭлектронныхПредставлений");
		КлючНастроекПредупрежденияНДС = "БольшеНеПоказывать";
		
		БольшеНеПоказыватьПредупреждениеПриложенияНДСНаПроверкуНеОтправляются = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			КлючОбъектаПредупрежденияНДС,
			КлючНастроекПредупрежденияНДС,
			Ложь);
	КонецЕсли;
	
	Контекст.Вставить("Организация", ОрганизацияОтчета);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗаписьОрганизации);
	Контекст.Вставить("ТипОтправляемогоДокумента", ИмяТипаОтчета);
	Контекст.Вставить("ИсточникОтчета", ИсточникОтчета);
	Контекст.Вставить("ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате", ПоддержкаСервисаОнлайнПроверкиВУниверсальномФормате);
	Контекст.Вставить("ИнформацияОСервереОнлайнПроверки", Неопределено);
	Контекст.Вставить("ОтправкаПерсональныхДанныхРазрешена", ОтправкаПерсональныхДанныхРазрешена);
	Контекст.Вставить("ЭтоНДС", ЭтоНДС);
	Контекст.Вставить("БольшеНеПоказыватьПредупреждениеПриложенияНДСНаПроверкуНеОтправляются", БольшеНеПоказыватьПредупреждениеПриложенияНДСНаПроверкуНеОтправляются);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоместитьВнешнееЭлектронноеПредставлениеВоВременноеХранилище(Контекст, ДляОнлайнПроверки = Ложь)
	
	ЭлПредставления = ИзвлечьЭлектронныеПредставленияИзХранилища(Контекст.Документ);
	Если ЭлПредставления = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДляОнлайнПроверки Тогда
		ИндексЭлПредставления = ЭлПредставления.Количество() - 1;
		Пока ИндексЭлПредставления >= 0 Цикл
			Если ЭлПредставления[ИндексЭлПредставления].ТипФайлаОтчетности = Перечисления.ТипыФайловБухОтчетности.АудиторскоеЗаключение
			ИЛИ ЭлПредставления[ИндексЭлПредставления].ТипФайлаОтчетности = Перечисления.ТипыФайловБухОтчетности.ЗаявлениеСоюзаСельхозПроизводителей
			ИЛИ ЭлПредставления[ИндексЭлПредставления].ТипФайлаОтчетности = Перечисления.ТипыФайловБухОтчетности.ПояснительнаяЗаписка 
			ИЛИ ЭлПредставления[ИндексЭлПредставления].ТипФайлаОтчетности = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР Тогда
				ЭлПредставления.Удалить(ИндексЭлПредставления);
			КонецЕсли;
			ИндексЭлПредставления = ИндексЭлПредставления - 1;
		КонецЦикла;
	КонецЕсли;
	
	ВсегоВАрхиве = 0;
	Для Каждого ЗагруженныйОтчет Из ЭлПредставления Цикл
		Если ЗагруженныйОтчет.ВАрхиве Тогда
			ВсегоВАрхиве = ВсегоВАрхиве + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсегоВАрхиве > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Файл загруженного отчета был ранее перемещен в архив. Извлечение содержимого невозможно!';
								|en = 'Файл загруженного отчета был ранее перемещен в архив. Извлечение содержимого невозможно!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭлПредставления.Количество() = 1 Тогда
		
		ЭлПредставление = ЭлПредставления[0];
		ИмяФайлаВыгрузки = ЭлПредставление.ИмяФайла;
		ДанныеВыгрузки = ЭлПредставление.Данные;
		
		АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(ДанныеВыгрузки, Контекст.УникальныйИдентификатор);
		
		Контекст.Вставить("АдресФайлаВыгрузки", АдресФайлаВыгрузки);
		Контекст.Вставить("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
		
	Иначе
		
		АдресФайлаВыгрузки = Новый Массив;
		ИмяФайлаВыгрузки = Новый Массив;
		КодировкаФайла = Новый Массив;
		ТипФайлаВыгрузки = Новый Массив;
		ДокументыМассив = Новый Массив;
		
		Для Каждого ЭлПредставление Из ЭлПредставления Цикл
			
			АдресФайлаВыгрузки.Добавить(ПоместитьВоВременноеХранилище(ЭлПредставление.Данные, Контекст.УникальныйИдентификатор));
			ИмяФайлаВыгрузки.Добавить(ЭлПредставление.ИмяФайла);
			КодировкаФайла.Добавить("windows-1251");
			ТипФайлаВыгрузки.Добавить(ЭлПредставление.ТипФайлаОтчетности);
			ДокументыМассив.Добавить(Контекст.Документ);
			
		КонецЦикла;
		
		Контекст.Вставить("АдресФайлаВыгрузки", АдресФайлаВыгрузки);
		Контекст.Вставить("ИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
		Контекст.Вставить("КодировкаФайла", КодировкаФайла);
		Контекст.Вставить("ТипФайлаВыгрузки", ТипФайлаВыгрузки);
		Контекст.Вставить("Документы", ДокументыМассив);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьОтчетСИспользованиемСервисаОнлайнПроверки_ВыгрузитьОтчет(
	ОповещениеОЗавершении,
	Контекст,
	Форма = Неопределено,
	ДополнительныеДанные = Неопределено)
	
	ЭтоГрупповаяПроверка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки();

	ТекстВыгрузкиИлиАдрес = "";
	ИмяФайлаВыгрузки = "";
	КодировкаФайла = Неопределено;
	ТипФайлаВыгрузки = "";
	ДокументыВыгрузки = Неопределено;
	
	Отчет = Контекст.Документ;
	ТипПараметра = ТипЗнч(Отчет);
	
	Если Контекст.КонтролирующийОрган = "ФСС" Тогда
		
		ЭтоРеестрСведений = ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(Отчет);
		ЭтоРеестрЭЛН = ДокументооборотСФССКлиентСервер.ЭтоРеестрДанныхЭЛНЗаполняемыхРаботодателем(Отчет);
		ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
			ДокументооборотСФССКлиентСервер.ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(Отчет);
		
