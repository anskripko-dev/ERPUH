&НаСервереБезКонтекста
Функция СформироватьСписокПредставленнойОтчетности(ЗапросИОН, АдресФайла) Экспорт
	
	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	ЭтоВерсия5_04 = ВерсияФормата(АдресФайла) = "5.04";
	
	Документ  = Справка.Документ;
	Подписант = Документ.Подписант;
	КодНО     = Подписант.КодНО;
	
	Если НЕ ЭтоВерсия5_04 Тогда
		НаимНО = Подписант.НаимНО;
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если ЭтоВерсия5_04 Тогда
		МакетСправки = ПолучитьМакетОбработки("СписокПредставленнойОтчетности5_04");
		ПеречНБО = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Документ.ПеречНБО);
	Иначе
		МакетСправки = ПолучитьМакетОбработки("СписокПредставленнойОтчетности5_03");
		ПеречНБО = СписокИзXDTO(Документ, "ПеречНБО");
	КонецЕсли;
	
	Количество = ПеречНБО.Количество();
	Счетчик    = 0;
	Для каждого СтрокаПеречНБО Из ПеречНБО Цикл
		
		Счетчик = Счетчик + 1;
		
		ОбластьШапка = МакетСправки.ПолучитьОбласть("Шапка");
		
		Если ЭтоВерсия5_04 Тогда
			ОбластьШапка.Параметры.Заполнить(Документ);
			ОбластьШапка.Параметры.КодНО = КодНО;
			СвНП = Документ.СвНП;
		Иначе
			ОбластьШапка.Параметры.Заполнить(СтрокаПеречНБО);
			ОбластьШапка.Параметры.НаимНО = НаимНО;
			СвНП = СтрокаПеречНБО.СвНП;
		КонецЕсли;
		
		ДобавитьВСверкуПолучателя(ОбластьШапка, СвНП);
		
		Если НЕ ЭтоВерсия5_04 Тогда
			ОбластьШапка.Параметры.Адрес = ПредставлениеАдрРФСтрокой(СвНП.АдрРФ);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ДокумНБО = СписокИзXDTO(СтрокаПеречНБО, "ДокумНБО");
		
		Если ДокумНБО = Неопределено Тогда
			
			ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
			ТабличныйДокумент.Вывести(ОбластьТЧ);
			
		Иначе
			
			Для каждого СтрДокумНБО Из ДокумНБО Цикл
				ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
				ОбластьТЧ.Параметры.Заполнить(СтрДокумНБО);
				
				// Чтобы формат выводился корректно
				СумДеклар = СвойствоXDTO(СтрДокумНБО, "СумДеклар");
				Если СумДеклар <> "" Тогда
					ОбластьТЧ.Параметры.СумДеклар = Число(СумДеклар);
				КонецЕсли;
				
				СумКРБ = СвойствоXDTO(СтрДокумНБО, "СумКРБ");
				Если СумКРБ <> "" Тогда
					ОбластьТЧ.Параметры.СумКРБ = Число(СумКРБ);
				КонецЕсли;
				
				ОбластьТЧ.Параметры.Отчет = НазваниеОтчетаПоКНД(СтрДокумНБО.КНД);
				
				Если ЭтоВерсия5_04 Тогда
					Если СтрДокумНБО.СпособПредДок = "0" Тогда
						ОбластьТЧ.Параметры.СпособПредДок = НСтр("ru = 'документ не направляется/не представляется';
																|en = 'документ не направляется/не представляется'");
					ИначеЕсли СтрДокумНБО.СпособПредДок = "1" Тогда
						ОбластьТЧ.Параметры.СпособПредДок = НСтр("ru = 'документ представляется';
																|en = 'документ представляется'");
					ИначеЕсли СтрДокумНБО.СпособПредДок = "2" Тогда
						ОбластьТЧ.Параметры.СпособПредДок = НСтр("ru = 'документ направляется';
																|en = 'документ направляется'");
					ИначеЕсли СтрДокумНБО.СпособПредДок = "3" Тогда
						ОбластьТЧ.Параметры.СпособПредДок = НСтр("ru = 'возможно, как направление, так и представление документа';
																|en = 'возможно, как направление, так и представление документа'");
					КонецЕсли;
					
					Если СтрДокумНБО.СостоянДок = "1" Тогда
						ОбластьТЧ.Параметры.СостоянДок = НСтр("ru = 'зарегистрирован';
																|en = 'зарегистрирован'");
					ИначеЕсли СтрДокумНБО.СостоянДок = "2" Тогда
						ОбластьТЧ.Параметры.СостоянДок = НСтр("ru = 'введен в БД АИС';
																|en = 'введен в БД АИС'");
					ИначеЕсли СтрДокумНБО.СостоянДок = "3" Тогда
						ОбластьТЧ.Параметры.СостоянДок = НСтр("ru = 'проведено начисление в карточку «Расчеты с бюджетом» по сведениям налогоплательщика';
																|en = 'проведено начисление в карточку «Расчеты с бюджетом» по сведениям налогоплательщика'");
					КонецЕсли;
					
				Иначе
					ДобавитьОКАТО_ОКТМО(ОбластьТЧ, СтрДокумНБО);
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьТЧ);
			КонецЦикла;
			
			ОбластьПодпись = МакетСправки.ПолучитьОбласть("Подвал");
			
			Если НЕ ЭтоВерсия5_04 Тогда
				ОбластьПодпись.Параметры.НаименованиеКодФНС = НаимНО + ", " +КодНО;
				СформироватьСписокПредставленнойОтчетности_ДобавитьНижнююТаблицу(ОбластьПодпись, СтрокаПеречНБО);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьПодпись);
			
		КонецЕсли;
		
		Если НЕ ЭтоВерсия5_04 И Счетчик <> Количество Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 3, Ложь);
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "[&НомерСтраницы]";
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция НазваниеОтчетаПоКНД(КНД) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	МакетКНД = КонтекстЭДОСервер.ПолучитьМакет("ОписаниеФормДляИмпорта");
	ИдентификаторОтчета = "";
	Для Инд = 1 По МакетКНД.ВысотаТаблицы Цикл
		_КНД = СокрЛП(МакетКНД.Область(Инд, 1, Инд, 1).Текст);
		
		Если _КНД = КНД Тогда
			ИдентификаторОтчета = СокрЛП(МакетКНД.Область(Инд, 2, Инд, 2).Текст);
		КонецЕсли;
			
	КонецЦикла;
	
	Если ИдентификаторОтчета = "" Тогда
		Возврат КНД;
	Иначе
		МакетСписокДокументов = Справочники.ВидыОтправляемыхДокументов.ПолучитьМакет("ОписаниеВидовОтправляемыхДокументов");
		Для Ном = 1 По МакетСписокДокументов.ВысотаТаблицы Цикл
			_ИдентификаторОтчета = СокрЛП(МакетСписокДокументов.Область(Ном, 1, Ном, 1).Текст);
			
			Если _ИдентификаторОтчета = ИдентификаторОтчета Тогда
				НаименованиеОтчета = СокрЛП(МакетСписокДокументов.Область(Ном, 2, Ном, 2).Текст);
				Возврат НаименованиеОтчета;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат КНД;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСправкуОСостоянииРасчетовСФНС(ЗапросИОН, АдресФайла) Экспорт
	
	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	КНД = Справка.Документ.КНД;
	ЭтоКНД1160082 = КНД = "1160082";
	
	Документ  = Справка.Документ;
	Подписант = Документ.Подписант;
	
	// Только в КНД 1160082
	ЕстьКодНОСпр = Подписант.Свойства().Получить("КодНОСпр") <> Неопределено;
	Если ЕстьКодНОСпр Тогда
		КодНО = Подписант.КодНОСпр;
	Иначе
		КодНО = Подписант.КодНО;
	КонецЕсли;
		
	НаимНО = Подписант.НаимНО;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если ЭтоКНД1160082 Тогда
		МакетСправки = ПолучитьМакетОбработки("СправкаОСостоянииРасчетовКНД1160082");
	Иначе
		МакетСправки = ПолучитьМакетОбработки("СправкаОСостоянииРасчетов");
	КонецЕсли;
	
	СвРасч = СписокИзXDTO(Документ, "СвРасч");
	
	Количество = СвРасч.Количество();
	Счетчик    = 0;
	Для каждого СтрокаСвРасч Из СвРасч Цикл
		Счетчик = Счетчик + 1;
		
		ОбластьШапка = МакетСправки.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(СтрокаСвРасч);
		
		СвНП = СтрокаСвРасч.СвНП;
		
		ДобавитьВСверкуПолучателя(ОбластьШапка, СвНП);
		
		// В КНД 1160082 отсутствует
		Если НЕ ЭтоКНД1160082 Тогда
			ОбластьШапка.Параметры.Адрес = ПредставлениеАдрРФСтрокой(СвНП.АдрРФ);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		СвРасчВид = СписокИзXDTO(СтрокаСвРасч, "СвРасчВид");
		
		Если СвРасчВид = Неопределено Тогда
			
			ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
			ТабличныйДокумент.Вывести(ОбластьТЧ);
			
		Иначе
			
			Для каждого СтрСвРасчВид Из СвРасчВид Цикл
				ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
				ОбластьТЧ.Параметры.Заполнить(СтрСвРасчВид);
				
				// Только в КНД 1160082
				ЕстьКодНО = СтрСвРасчВид.СостСум.Свойства().Получить("КодНО") <> Неопределено;
				Если ЕстьКодНО Тогда
					ОбластьТЧ.Параметры.Заполнить(СтрСвРасчВид.СостСум);
				КонецЕсли;
				
				ДобавитьОКАТО_ОКТМО(ОбластьТЧ, СтрСвРасчВид.КодОбр);
				
				ОбластьТЧ.Параметры.Заполнить(СтрСвРасчВид.СостСум.СостРасч);
				
				ТабличныйДокумент.Вывести(ОбластьТЧ);
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьПодпись = МакетСправки.ПолучитьОбласть("Подвал");
		ОбластьПодпись.Параметры.НаименованиеКодФНС = НаимНО + ", " +КодНО;
		ТабличныйДокумент.Вывести(ОбластьПодпись);
		
		Если Счетчик <> Количество Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 3, Ложь);
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "[&НомерСтраницы]";
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьВыпискуОпераций(ЗапросИОН, АдресФайла) Экспорт

	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Документ  = Справка.Документ;
	Подписант = Документ.Подписант;
	КодНО     = Подписант.КодНО;
	НаимНО    = Подписант.НаимНО;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	МакетСправки = ПолучитьМакетОбработки("ВыпискаОпераций");
	
	ВыпОперРСБ = СписокИзXDTO(Документ, "ВыпОперРСБ");
	
	Количество = ВыпОперРСБ.Количество();
	Счетчик    = 0;
	Для каждого СтрокаВыпОперРСБ Из ВыпОперРСБ Цикл
		
		Счетчик = Счетчик + 1;
		
		ОбластьШапка = МакетСправки.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(СтрокаВыпОперРСБ);
		ОбластьШапка.Параметры.НаимНО = НаимНО;
		
		СвНП = СтрокаВыпОперРСБ.СвНП;
		
		ДобавитьВСверкуПолучателя(ОбластьШапка, СвНП);
		
		СтатусНП = СвойствоXDTO(СвНП, "СтатусНП");
		Если СтатусНП = "01" Тогда
			СтатусНП = НСтр("ru = 'Юридическое лицо';
							|en = 'Юридическое лицо'");
		ИначеЕсли СтатусНП = "02" Тогда
			СтатусНП = НСтр("ru = 'Налоговый агент';
							|en = 'Налоговый агент'");
		ИначеЕсли СтатусНП = "09" Тогда
			СтатусНП = НСтр("ru = 'Индивидуальный предприниматель';
							|en = 'Индивидуальный предприниматель'");
		ИначеЕсли СтатусНП = "10" Тогда
			СтатусНП = НСтр("ru = 'Частный нотариус';
							|en = 'Частный нотариус'");
		ИначеЕсли СтатусНП = "11" Тогда
			СтатусНП = НСтр("ru = 'Адвокат, учредивший адвокатский кабинет';
							|en = 'Адвокат, учредивший адвокатский кабинет'");
		ИначеЕсли СтатусНП = "12" Тогда
			СтатусНП = НСтр("ru = 'Глава крестьянского (фермерского) хозяйства';
							|en = 'Глава крестьянского (фермерского) хозяйства'");
		ИначеЕсли СтатусНП = "13" Тогда
			СтатусНП = НСтр("ru = 'Иное физическое лицо';
							|en = 'Иное физическое лицо'");
		ИначеЕсли СтатусНП = "14" Тогда
			СтатусНП = НСтр("ru = 'Налогоплательщик, производящий выплаты физическим лицам (пп. 1 п. 1 ст. 235 НК РФ)';
							|en = 'Налогоплательщик, производящий выплаты физическим лицам (пп. 1 п. 1 ст. 235 НК РФ)'");
		КонецЕсли;
		
		ОбластьШапка.Параметры.СтатусНП = СтатусНП;
		
		ДобавитьОКАТО_ОКТМО(ОбластьШапка, СтрокаВыпОперРСБ);
			
		ОбластьШапка.Параметры.Адрес = ПредставлениеАдрРФСтрокой(СвНП.АдрРФ);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ЗапОперРСБ = СписокИзXDTO(СтрокаВыпОперРСБ, "ЗапОперРСБ");
		Если ЗапОперРСБ = Неопределено Тогда
			ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
			ТабличныйДокумент.Вывести(ОбластьТЧ);
		Иначе
			
			Для каждого СтрокаЗапОперРСБ Из ЗапОперРСБ Цикл
				
				ОбластьТЧ = МакетСправки.ПолучитьОбласть("ТЧ");
				ОбластьТЧ.Параметры.Заполнить(СтрокаЗапОперРСБ);
				
				ДокОтч = СвойствоXDTO(СтрокаЗапОперРСБ, "ДокОтч"); 
				Если ДокОтч <> "" Тогда
					ОбластьТЧ.Параметры.Заполнить(ДокОтч);
				КонецЕсли;
				
				Сумма = СвойствоXDTO(СтрокаЗапОперРСБ, "Сумма"); 
				Если Сумма <> "" Тогда
					ОбластьТЧ.Параметры.Заполнить(Сумма);
				КонецЕсли;
				
				ПНЗ = СвойствоXDTO(СтрокаЗапОперРСБ, "ПНЗ"); 
				Если ПНЗ <> "" Тогда
					ОбластьТЧ.Параметры.Заполнить(ПНЗ);
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьТЧ);
				
			КонецЦикла;
			
			ОбластьКонецТЧ = МакетСправки.ПолучитьОбласть("КонецТЧ");
			ТабличныйДокумент.Вывести(ОбластьКонецТЧ);
			
		КонецЕсли;
		
		ОбластьПодпись = МакетСправки.ПолучитьОбласть("Подпись");
		ОбластьПодпись.Параметры.НаименованиеКодФНС = НаимНО + ", " +КодНО;
		ТабличныйДокумент.Вывести(ОбластьПодпись);
		
		Если Счетчик <> Количество Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 3, Ложь);
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = "[&НомерСтраницы]";
	ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьОКАТО_ОКТМО(Шапка, Узел)
	
	// ОКАТО, ОКТМО
	ОКАТО = СвойствоXDTO(Узел, "ОКАТО");
	ОКТМО = СвойствоXDTO(Узел, "ОКТМО");
	
	Если ЗначениеЗаполнено(ОКАТО) Тогда
		Шапка.Параметры.ОКАТО_ОКТМО = ОКАТО;
	Иначе
		Шапка.Параметры.ОКАТО_ОКТМО = ОКТМО;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВСверкуПолучателя(Шапка, Узел)
	
	ДобавитьВСверкуПолучателя_ЮЛ(Шапка, Узел);
	ДобавитьВСверкуПолучателя_ИП_ФЛ(Шапка, Узел);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВСверкуПолучателя_ИП_ФЛ(Шапка, Узел)
	
	ПолеИП = "НПИП";
	ПолеФЛ = "НПФЛ";
	
	ЕстьПолеИП = Узел.Свойства().Получить(ПолеИП) <> Неопределено;
	ЕстьПолеФЛ = Узел.Свойства().Получить(ПолеФЛ) <> Неопределено;
	
	Если ЕстьПолеИП ИЛИ ЕстьПолеФЛ Тогда
		
		Если ЕстьПолеИП Тогда
			НПФЛ = Узел[ПолеИП];
		ИначеЕсли ЕстьПолеФЛ Тогда
			НПФЛ = Узел[ПолеФЛ];
		КонецЕсли;
		
		Шапка.Параметры.ИНН = НПФЛ.ИННФЛ;
		Шапка.Параметры.НаименованиеОрганизации = ФИОИзТега(НПФЛ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВСверкуПолучателя_ЮЛ(Шапка, Узел)
	
	// ИНН, КПП, Наименование организации
	ПолеЮЛ = "НПЮЛ"; 
	
	ЕстьПолеЮЛ = Узел.Свойства().Получить(ПолеЮЛ) <> Неопределено;
	Если ЕстьПолеЮЛ Тогда
		
		НПЮЛ = Узел[ПолеЮЛ];
		
		Шапка.Параметры.ИНН = НПЮЛ.ИННЮЛ;
		Шапка.Параметры.КПП = НПЮЛ.КПП;
		Шапка.Параметры.НаименованиеОрганизации = НПЮЛ.НаимОрг;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФИОИзТега(Узел) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ФИОИзТега(Узел);
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокИзXDTO(Узел, Поле) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СписокИзXDTO(Узел, Поле); 
	
КонецФункции

&НаСервереБезКонтекста
Функция СвойствоXDTO(Узел, Поле) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СвойствоXDTO(Узел, Поле);
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСправкуОбИсполненииНалогоплательщикомОбязанностиПоУплатеНалогов(ЗапросИОН, АдресФайла)
	
	// Получаем файл xml
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяФайла);
	
	// Дессериализуем в XDTO
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);	
	Справка = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	// Получаем параметры из файла	
	ПараметрыЗаполнения = Новый Структура;

	Если Справка.Свойства().Получить("Документ") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Справка.Документ.Свойства().Получить("СвНП") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Справка.Документ.Свойства().Получить("СвПолуч") <> Неопределено Тогда
		СвПолуч = Справка.Документ.СвПолуч;
		Если СвПолуч.Свойства().Получить("ПолучЮЛ") <> Неопределено Тогда
			ПараметрыЗаполнения.Вставить("КПП", СвПолуч.ПолучЮЛ.КПП);
		Иначе
			ПараметрыЗаполнения.Вставить("КПП", "");
		КонецЕсли;
	КонецЕсли;
	
	ФИОИнспектора = "";
	Если Справка.Документ.Свойства().Получить("Подписант") <> Неопределено Тогда
		Подписант = Справка.Документ.Подписант;
		Если Подписант.Свойства().Получить("ФИО") <> Неопределено Тогда
			
			ФИО = Подписант.ФИО;
			
			ФИОСтруктура = Новый Структура();
			Если ФИО.Свойства().Получить("Фамилия") <> Неопределено Тогда
				ФИОСтруктура.Вставить("Фамилия", ФИО.Фамилия);
			Иначе
				ФИОСтруктура.Вставить("Фамилия", "");
			КонецЕсли;
			
			Если ФИО.Свойства().Получить("Имя") <> Неопределено Тогда
				ФИОСтруктура.Вставить("Имя", ФИО.Фамилия);
			Иначе
				ФИОСтруктура.Вставить("Имя", "");
			КонецЕсли;
			
			Если ФИО.Свойства().Получить("Отчество") <> Неопределено Тогда
				ФИОСтруктура.Вставить("Отчество", ФИО.Отчество);
			Иначе
				ФИОСтруктура.Вставить("Отчество", "");
			КонецЕсли;
			
			ФИОИнспектора = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИОСтруктура);
			
		КонецЕсли;
	КонецЕсли;
	ПараметрыЗаполнения.Вставить("ФИОИнспектора", ФИОИнспектора);
	
	Налогоплательщик = Справка.Документ.СвНП;
	Если Налогоплательщик.Свойства().Получить("НПЮЛ") <> Неопределено Тогда
		ПараметрыЗаполнения.Вставить("ИНН", Налогоплательщик.НПЮЛ.ИННЮЛ);
		ПараметрыЗаполнения.Вставить("Налогоплательщик", Налогоплательщик.НПЮЛ.НаимОрг);	
	Иначе
		ПараметрыЗаполнения.Вставить("ИНН", Налогоплательщик.НПФЛ.ИННФЛ);
		ФИО = Налогоплательщик.НПФЛ.ФИО.Фамилия + " " + Налогоплательщик.НПФЛ.ФИО.Имя;
		Если Налогоплательщик.НПФЛ.ФИО.Свойства().Получить("Отчество") <> Неопределено Тогда
			ФИО = ФИО + " " + Налогоплательщик.НПФЛ.ФИО.Отчество;
		КонецЕсли;
		ПараметрыЗаполнения.Вставить("Налогоплательщик", ФИО);
	КонецЕсли;
	
	Если Налогоплательщик.Свойства().Получить("АдрРФ") <> Неопределено Тогда
		ПараметрыЗаполнения.Вставить("Адрес", ПредставлениеАдрРФСтрокой(Налогоплательщик.АдрРФ));
	КонецЕсли;
	Подписант = Справка.Документ.Подписант;
	ПараметрыЗаполнения.Вставить("НалоговыйОрган", Подписант.НаимНО + ", " + Подписант.КодНО);

	Обязанности = Справка.Документ.СпрИспОбяз;
	
	ПараметрыЗаполнения.Вставить("НомерСправки", Обязанности.НомСпр);
	ПараметрыЗаполнения.Вставить("ПоСостояниюНа", Дата(Прав(Обязанности.ДатаСостСв, 4), Сред(Обязанности.ДатаСостСв, 4, 2), Лев(Обязанности.ДатаСостСв, 2)));
	ПараметрыЗаполнения.Вставить("НаличиеОбязанностей", Булево(Число(Обязанности.ПрНеиспОбяз)));
	
	ПараметрыЗаполнения.Вставить("СписокИФНС", Новый Массив);
	Если Обязанности.Свойства().Получить("ПерНО") <> Неопределено Тогда
		Если ТипЗнч(Обязанности.ПерНО.КодИФНС) = Тип("СписокXDTO") Тогда
			Для Каждого КодИФНС Из Обязанности.ПерНО.КодИФНС Цикл
				ПараметрыЗаполнения.СписокИФНС.Добавить(КодИФНС);
			КонецЦикла;
		Иначе
			ПараметрыЗаполнения.СписокИФНС.Добавить(Обязанности.ПерНО.КодИФНС);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.НаличиеОбязанностей И ПараметрыЗаполнения.СписокИФНС.Количество() > 0 Тогда
		ПараметрыЗаполнения.Вставить("Приложение", "Приложение: на 1 листах.***");
	КонецЕсли;
	
	
	// Формируем табличный документ
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	МакетСправки = ПолучитьМакетОбработки("СправкаОбИсполненииНалогоплательщикомОбязанностиПоУплатеНалогов");
	
	// Основная часть справки
	СправкаОбласть = МакетСправки.ПолучитьОбласть("Справка");

	СправкаОбласть.Параметры.Заполнить(ПараметрыЗаполнения);
	СправкаОбласть.Параметры.ПоСостояниюНа = Формат(ПараметрыЗаполнения.ПоСостояниюНа, "ДФ='dd MMMM yyyy ""г.""'");
	СправкаОбласть.Параметры.НаличиеОбязанностей = Формат(ПараметрыЗаполнения.НаличиеОбязанностей, "БЛ='НЕ ИМЕЕТ'; БИ=ИМЕЕТ");
	
	ТабличныйДокумент.Вывести(СправкаОбласть);
	
	СноскаОбласть = МакетСправки.ПолучитьОбласть("Сноска");
	ТабличныйДокумент.Вывести(СноскаОбласть);
	
	// Приложение к справке
	Если ПараметрыЗаполнения.НаличиеОбязанностей И ПараметрыЗаполнения.СписокИФНС.Количество() > 0 Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОбластьШапкаПриложения = МакетСправки.ПолучитьОбласть("ШапкаПриложения");
		ОбластьШапкаПриложения.Параметры.Заполнить(ПараметрыЗаполнения);
		ТабличныйДокумент.Вывести(ОбластьШапкаПриложения);
		
		ОбластьСтрокаПриложения = МакетСправки.ПолучитьОбласть("СтрокаПриложения");
		ОбластьПустаяСтрокаПриложения = МакетСправки.ПолучитьОбласть("СтрокаПриложенияПустая");
		ОбластьПодвалПриложения = МакетСправки.ПолучитьОбласть("ПодвалПриложения");
		
		ПорядковыйНомер = 1;
		Для Каждого КодИФНС Из ПараметрыЗаполнения.СписокИФНС Цикл
			ОбластьСтрокаПриложения.Параметры.НомерПоПорядку = Строка(ПорядковыйНомер)
				+ ?(ПорядковыйНомер = ПараметрыЗаполнения.СписокИФНС.Количество(), "**", "") + ".";
			ОбластьСтрокаПриложения.Параметры.Испекция = КодИФНС;
			Если ПорядковыйНомер = ПараметрыЗаполнения.СписокИФНС.Количество() Тогда
				ОбластьСтрокаПриложения.Параметры.ПереносСтроки = ".";
			Иначе
				ОбластьСтрокаПриложения.Параметры.ПереносСтроки = ";";
			КонецЕсли;
			Если ПорядковыйНомер = 1 Тогда
				ОбластьСтрокаПриложения.Параметры.ПереносСтроки = ОбластьСтрокаПриложения.Параметры.ПереносСтроки + "*";
			КонецЕсли;
			
			ПорядковыйНомер = ПорядковыйНомер + 1;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаПриложения);
		КонецЦикла;
		Для Индекс = ПорядковыйНомер По 24 Цикл
			ТабличныйДокумент.Вывести(ОбластьПустаяСтрокаПриложения);			
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьПодвалПриложения);
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабличныйДокумент, 2, Истина);
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеАдрРФСтрокой(Знач Адрес)
    
    АдресСтрокой = "";
    АдресМассив = Новый Массив;
    Если Адрес.Свойства().Получить("Индекс") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Индекс);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("КодРегион") <> Неопределено Тогда
        Регион = "";
        МакетРегионы = ПолучитьМакетОбработки("КодыРегионов353приказ");	
        Для Инд = 1 По МакетРегионы.ВысотаТаблицы Цикл
            ТекРегион = МакетРегионы.Область(Инд, 1, Инд, 1).Текст;		
            Если ТекРегион = Адрес.КодРегион Тогда
                Регион = СокрЛП(МакетРегионы.Область(Инд, 2, Инд, 2).Текст);
            КонецЕсли;	
		КонецЦикла;
		АдресМассив.Добавить(Регион);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Район") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Район);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Город") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Город);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("НаселПункт") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.НаселПункт);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Улица") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Улица);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Дом") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Дом);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Корпус") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Корпус);
    КонецЕсли;
    
    Если Адрес.Свойства().Получить("Кварт") <> Неопределено Тогда
        АдресМассив.Добавить(Адрес.Кварт);
	КонецЕсли;
	
	Возврат СтрСоединить(АдресМассив, ", ");

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоДокументовПоОписиВходящихДокументов(ОписьВходящихДокументовСсылка) Экспорт
	
	МассивТребований = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	Количество(ОписиВходящихДокументовИзНалоговыхОргановВходящиеДокументы.СсылкаНаОбъект) КАК КоличествоДокументов
		|ИЗ
		|	Справочник.ОписиВходящихДокументовИзНалоговыхОрганов.ВходящиеДокументы КАК ОписиВходящихДокументовИзНалоговыхОргановВходящиеДокументы
		|ГДЕ
		|	ОписиВходящихДокументовИзНалоговыхОргановВходящиеДокументы.Ссылка = &ОписьВходящихДокументовСсылка";

	Запрос.УстановитьПараметр("ОписьВходящихДокументовСсылка", ОписьВходящихДокументовСсылка);
	
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.КоличествоДокументов;	
		
	Иначе
		
		Возврат 0;	
	
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция НоваяОписьВходящихДокументовИзНалоговыхОрганов(
		СвойстваОписиВходящихДокументов,
		ВложенияПриложение,
		ТранспортноеСообщение) Экспорт

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.НоваяОписьВходящихДокументовИзНалоговыхОрганов(
		СвойстваОписиВходящихДокументов,
		ВложенияПриложение,
		ТранспортноеСообщение);
			
КонецФункции

#Область ОтправкаОтветаНаТребованиеКДекларацииНДС

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС(
		ДокументСсылка,
		Организация,
		УникальныйИдентификаторФормы,
		ВыполняемоеОповещение) Экспорт
		
	КонтекстДлительнойОперации = Новый Структура();
	КонтекстДлительнойОперации.Вставить("ДокументСсылка",               ДокументСсылка);
	КонтекстДлительнойОперации.Вставить("ВыполняемоеОповещение",        ВыполняемоеОповещение);
	КонтекстДлительнойОперации.Вставить("УникальныйИдентификаторФормы", УникальныйИдентификаторФормы);
	КонтекстДлительнойОперации.Вставить("Организация",                  Организация);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		КонтекстДлительнойОперации);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ДокументСсылка, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	ДокументСсылка = ВходящийКонтекст.ДокументСсылка;	
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ДокументСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 6;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ВходящийКонтекст;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка ответа на требование НДС
		Возврат;
	КонецЕсли;
		
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС",  0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС() Экспорт
		
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	ДокументСсылка = КонтекстДлительнойОперации.ДокументСсылка;
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(КонтекстДлительнойОперации);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи...");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ДокументСсылка,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
		
	ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС(
		ВходящийКонтекст.ДокументСсылка,
		ВходящийКонтекст.Организация,
		ВходящийКонтекст.УникальныйИдентификаторФормы,
		ВходящийКонтекст.ВыполняемоеОповещение);

КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ДокументСсылка, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	ДокументСсылка 				 = ВходящийКонтекст.ДокументСсылка;
	УникальныйИдентификаторФормы = ВходящийКонтекст.УникальныйИдентификаторФормы;
	ВыполняемоеОповещение 		 = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаОбъектаЗапрещена = ДокументооборотСКОВызовСервера.ОтправкаОбъектаЗапрещенаНаТарифеПромоЕНС(ДокументСсылка);
	Если ОтправкаОбъектаЗапрещена Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНевозможностиОтправкиНаТарифе(ДокументСсылка);
		Возврат;
	КонецЕсли;	
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", ДокументСсылка);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификаторФормы);
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// отражаем изменения в базе
	Если НЕ ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ДокументСсылка, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь);//+
			
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС, ответ на требование
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ДокументооборотСКОВызовСервера.ОрганизацияПодключенаКИнспекции(ДокументСсылка)
		ИЛИ НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ДокументСсылка) Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь);//+
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 	ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеДобавлениеПодписейКакПриложение", ЭтотОбъект, Контекст);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
		
	// добавляем подписи для каждого из документов из массива ТребующиеПодписания	
	ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложение(Оповещение, КонтекстОтправки)
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	ДокументСсылка 	= Контекст.Документ;
	
	// проверяем, включен ли механизм обмена с ФНС для организации, указанной в ответе на требование
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	//требуется сформировать файл доверенности 
	//и определить налоговый орган (для записи в реквизит цикла обмена)
	//для этого определяем ИФНС (там содержатся данные по доверенности)

	// проверяем, указан ли получатель
	НалоговыйОрган = ДокументСсылка.НалоговыйОрган;
	Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан получатель - налоговый орган.';
								|en = 'Не указан получатель - налоговый орган.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	КодНалоговогоОргана = СокрЛП(НалоговыйОрган.Код);
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	//теперь формируем файл доверенности
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(Доверенность) Тогда
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
			ЭлРегистрацияВИФНС,
			КороткоеИмяФайлаДоверенности,
			Организация,,,
			Истина);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось выгрузить файл доверенности.';
									|en = 'Не удалось выгрузить файл доверенности.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
		
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет = ДокументСсылка;
	ЦиклОбмена.Идентификатор = СгенерироватьUUID();
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = НалоговыйОрган;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	РезультатВыгрузкиОбъектаОтправки = Неопределено;
	Если НЕ ВыгрузитьПоясненияКДекларацииПоНДС(Контекст, РезультатВыгрузкиОбъектаОтправки, ЭлРегистрацияВИФНС) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Отправка прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли; 
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
 	//добавляем файл Представление
	ДанныеФайлаПредставление = РезультатВыгрузкиОбъектаОтправки.ДанныеФайлаПредставление;
	ИмяФайлаПредставления = ДанныеФайлаПредставление.ИмяФайла;
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайлаПредставление.АдресВременногоХранилища);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление, ДвоичныеДанныеФайла, ИмяФайлаПредставления, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Отправка прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ТребующиеПодписания = Новый Массив;
	
	ДанныеФайлаВыгрузкиОбъектаОтправки = РезультатВыгрузкиОбъектаОтправки.ДанныеФайлаВыгрузкиОбъектаОтправки;
	
	ИдФайл		 		= ДанныеФайлаВыгрузкиОбъектаОтправки.ИдФайл;
	ИдФайлЭП			= ДанныеФайлаВыгрузкиОбъектаОтправки.ИдФайлЭП;
	АдресФайлаДанных 	= ДанныеФайлаВыгрузкиОбъектаОтправки.АдресВременногоХранилища;
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаДанных);
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
			ТранспортноеСообщение.Ссылка, 
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение, 
			ДвоичныеДанныеФайла, ИдФайл, 
			, , , , , , 
			СгенерироватьUUID(), 
			Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Отправка прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеФайла = Новый Структура;
	ДанныеФайла.Вставить("ИмяФайла", 				 ИдФайл);
	ДанныеФайла.Вставить("ИдФайлЭП", 				 ИдФайлЭП);
	ДанныеФайла.Вставить("АдресВременногоХранилища", АдресФайлаДанных);
	
	ТребующиеПодписания.Добавить(ДанныеФайла);
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
				ТранспортноеСообщение.Ссылка, 
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, 
				ФайлДоверенности, 
				КороткоеИмяФайлаДоверенности, 
				, , , , , , 
				СгенерироватьUUID(), 
				Перечисления.ТипыСодержимогоФайлов.xml) Тогда
				
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(ДокументСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложение(ВыполняемоеОповещение, Контекст)
	
	ТребующиеПодписания = Контекст.ТребующиеПодписания;
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ТранспортноеСообщение = Контекст.ТранспортноеСообщение;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗапись);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Контекст);
	
	ОтпечатокСертификатаРуководителя = ПолучитьОтпечаток(УчетнаяЗапись, "Руководитель",);
	СертификатРуководителя = Новый Структура("Отпечаток, КлючевойКонтейнер",
	ОтпечатокСертификатаРуководителя, РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, СертификатРуководителя);
	
	НомерФайлаТребующегоПодписания = 0;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) И ТребующиеПодписания.Количество() > 1 И ВключитьПакетнуюПодпись Тогда
		ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПакетно(ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, СертификатРуководителя);
	Иначе	
		ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПоследовательно(ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, СертификатРуководителя);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПоследовательно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		НомерФайлаТребующегоПодписания,
		Сертификат,
		МенеджерКриптографии = Неопределено,
		Алгоритм = Неопределено)
		
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
	
	Если НомерФайлаТребующегоПодписания <= ТребующиеПодписания.ВГраница() Тогда
		
		ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
		
		ДополнительныеПараметры = Новый Структура(
			"ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, СертификатРуководителя", 
			ВыполняемоеОповещение, ТранспортноеСообщение, ТребующиеПодписания, НомерФайлаТребующегоПодписания, Сертификат);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла", ЭтотОбъект, ДополнительныеПараметры);
		
		АлгоритмПодписи = Алгоритм;
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
			ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
			ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ОтветНаТребованиеПоясненийКДекларацииНДС", ТранспортноеСообщение); 
			АлгоритмПодписи = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
		КонецЕсли;

		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			ОписаниеОповещения,
			Сертификат,
			ДанныеФайла.АдресВременногоХранилища,
			Ложь,,,
			МенеджерКриптографии,,
			АлгоритмПодписи);
		
	Иначе
		
		//Все подписи добавлены
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПоследовательноПослеПодписанияФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
	КонецЕсли;
	
	ТранспортноеСообщение 			= ДополнительныеПараметры.ТранспортноеСообщение;
	ТребующиеПодписания 			= ДополнительныеПараметры.ТребующиеПодписания;
	НомерФайлаТребующегоПодписания 	= ДополнительныеПараметры.НомерФайлаТребующегоПодписания;
	Сертификат			 			= ДополнительныеПараметры.СертификатРуководителя;
	
	ДанныеФайла = ТребующиеПодписания[НомерФайлаТребующегоПодписания];
	
	КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
	
	// добавляем подпись как приложение
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, Результат.ФайлПодписи, КороткоеИмяФайлаПодписи, , , , , , , СгенерироватьUUID(), ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Ложь);	
		Возврат;
		
	КонецЕсли;

	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
	
		МенеджерКриптографии = Неопределено;
		
	Иначе
			
		МенеджерКриптографии = Результат.МенеджерКриптографии;
		
	КонецЕсли;
	
	Алгоритм = ?(МенеджерКриптографии <> Неопределено, Результат.Алгоритм, Неопределено);
	
	ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПоследовательно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		НомерФайлаТребующегоПодписания + 1,
		Сертификат,
		МенеджерКриптографии,
		Алгоритм);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеДобавлениеПодписейКакПриложение(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС, ответ на требование
		
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Запись данных...");
	
	// формируем пакет
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеФормированияПакета", ЭтотОбъект, ВходящийКонтекст);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура("ТребуетПодтверждениОперации", Ложь);
	КонецЕсли;	
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС", ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
	Если Не Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС, ответ на требование
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Отправка...");
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФНС, ответ на требование
		Возврат;
	КонецЕсли;
	
	ОчиститьПустыеСтрокиПоясненияКДекларацииПоНДС(КонтекстОтправки.Документ);
	
	Оповестить("Запись_ПоясненияКДекларацииПоНДС", , КонтекстОтправки.Документ);
	
	ДополнительныеПараметры.Вставить("РезультатОтправки", Истина);
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФНС, ответ на требование
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьПустыеСтрокиПоясненияКДекларацииПоНДС(Пояснение)
	
	Документы.ПоясненияКДекларацииПоНДС.ОчиститьПустыеСтроки(Пояснение);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыгрузитьПоясненияКДекларацииПоНДС(Контекст, РезультатВыгрузкиОбъектаОтправки, ЭлРегистрацияВИФНС)
	
	РезультатВыгрузкиОбъектаОтправки = Новый Структура;
	
	УникальныйИдентификаторФормы = Контекст.УникальныйИдентификатор;
	ДокументСсылка = Контекст.Документ;
	
	ДанныеФайлаВыгрузкиОбъектаОтправки = ПолучитьФайлВыгрузкиОтветаНаТребованиеПояснений(ДокументСсылка, УникальныйИдентификаторФормы);	
	Если ДанныеФайлаВыгрузкиОбъектаОтправки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось получить файл выгрузки пояснений.';
								|en = 'Не удалось получить файл выгрузки пояснений.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;	
	
	РезультатВыгрузкиОбъектаОтправки.Вставить("ДанныеФайлаВыгрузкиОбъектаОтправки", ДанныеФайлаВыгрузкиОбъектаОтправки);
	
	Организация 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	КодНалоговогоОргана 	= ЭлРегистрацияВИФНС.Код;
	ПараметрыОписи 			= СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана);
	
	Если НЕ ПроверитьЗаполнениеПараметровПриОтправкеПредставления(ПараметрыОписи) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// определяем ИмяФайлТребПояс
	ИмяФайлаТребованияПояснений = ПолучитьИмяФайлаТребованияПояснений(ДокументСсылка.Требование);
	Если НЕ ЗначениеЗаполнено(ИмяФайлаТребованияПояснений) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось получить имя файла требования пояснений.';
								|en = 'Не удалось получить имя файла требования пояснений.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;	
	ПараметрыОписи.Вставить("ИмяФайлТребПояс", ИмяФайлаБезРасширения(ИмяФайлаТребованияПояснений));
	
	ПараметрыОписи.Вставить("ЭтоОтветНаТребованиеПоНДС", Истина);
	
	// определяем ИдФайлНалОтч
	ИмяФайлаДекларацииНДС = ПолучитьИмяФайлаДекларацииНДС(ДокументСсылка);
	Если НЕ ЗначениеЗаполнено(ИмяФайлаДекларацииНДС) Тогда
		ТекстСообщения = НСтр("ru = 'Не указана декларация по НДС, для которой отправляется пояснение.';
								|en = 'Не указана декларация по НДС, для которой отправляется пояснение.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	ПараметрыОписи.Вставить("ИдФайлНалОтч", ИмяФайлаБезРасширения(ИмяФайлаДекларацииНДС));

	// формируем XML представления и имя файла представления
	ИмяФайлаПредставления = Неопределено;
	КолФайл = 2;
	ТекстПредставления = СформироватьXMLПредставления(
		Организация, 
		ДанныеФайлаВыгрузкиОбъектаОтправки, 
		ПараметрыОписи, 
		ИмяФайлаПредставления, 
		КолФайл);
		
	Если НЕ ЗначениеЗаполнено(ТекстПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать XML файл описи исходящих документов.';
								|en = 'Не удалось сформировать XML файл описи исходящих документов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// пишем XML во временный файл в кодировке windows-1251
	ФайлПредставления = ВыгрузитьТекстВФайл(ТекстПредставления, ПолучитьИмяВременногоФайла());
	Если НЕ ЗначениеЗаполнено(ФайлПредставления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось записать содержимое описи исходящих документов в файл.';
								|en = 'Не удалось записать содержимое описи исходящих документов в файл.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	                                                                             
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлПредставления);
	СсылкаНаДвоичныеДанныеФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификаторФормы);
	
	ДанныеФайлаПредставление = Новый Структура;
	ДанныеФайлаПредставление.Вставить("ИмяФайла", ИмяФайлаПредставления);
	ДанныеФайлаПредставление.Вставить("АдресВременногоХранилища", СсылкаНаДвоичныеДанныеФайла);
	
	
	РезультатВыгрузкиОбъектаОтправки.Вставить("ДанныеФайлаПредставление", ДанныеФайлаПредставление);
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФайлВыгрузкиОтветаНаТребованиеПояснений(ДокументСсылка, УникальныйИдентификаторФормы)
	
	Возврат Документы.ПоясненияКДекларацииПоНДС.ПолучитьФайлВыгрузки(ДокументСсылка, УникальныйИдентификаторФормы);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИмяФайлаТребованияПояснений(Требование)

	КонтекстЭДОСервер 		= ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ПриложенияТребования 	= КонтекстЭДОСервер.ПолучитьФайлыДокументовРеализацииПолномочийНалоговыхОрганов(Требование);
	
	// Первая попытка - ищем pdf-файл
	// Среди всех приложений требования ищем pdf-файл.
	Для каждого ПриложениеТребования Из ПриложенияТребования Цикл
		
		СвойстваФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПриложениеТребования.ИмяФайла);
		
		Если ВРЕГ(СвойстваФайла.Расширение) <> ВРЕГ(".xml") Тогда
			Возврат СвойстваФайла.Имя;
		КонецЕсли;
	
	КонецЦикла;
	
	// Вторая попытка - ищем xml-файл
	Для каждого ПриложениеТребования Из ПриложенияТребования Цикл
		
		Если ЛЕВ(ПриложениеТребования.ИмяФайла, 8) = "1165050_" Тогда
			Возврат СвойстваФайла.Имя;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьИмяФайлаДекларацииНДС(Пояснение)

	Декларация = Пояснение.Декларация;
	
	Если ЗначениеЗаполнено(Декларация)
		И ТипЗнч(Декларация) = Тип("Строка") Тогда
		
		Возврат Декларация;
		
	Иначе
		
		КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
		Если ЗначениеЗаполнено(Декларация) Тогда
			Возврат КонтекстЭДОСервер.ИдФайлаДекларацииНДС(Декларация);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
			
	КонецЕсли;

КонецФункции 

&НаКлиенте
Процедура ПоказатьФормуВыбораТребованияФНС(
		ОписаниеОповещения, 
		Организация = Неопределено, 
		Знач ВидДокумента = Неопределено,
		Требования = Неопределено) Экспорт
	
	ВидыДокумента = Новый Массив;
	Если ВидДокумента = Неопределено Тогда  
		ВидыДокумента.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНалоговыхДокументов.ТребованиеОПредставленииДокументов"));
		ВидыДокумента.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНалоговыхДокументов.ТребованиеОПредставленииПоясненийКДекларацииНДС"));
	Иначе
		ВидыДокумента.Добавить(ВидДокумента);
	Конецесли;	
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидыДокумента", 	ВидыДокумента);
	ДополнительныеПараметры.Вставить("Организация", 	Организация);
	ДополнительныеПараметры.Вставить("Требования", 		Требования);
	
	ОткрытьФорму("Справочник.ДокументыРеализацииПолномочийНалоговыхОрганов.Форма.ФормаВыбораТребования", 
		ДополнительныеПараметры,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьОтветНаТребованиеСВыборомТребования(
		ОписьВходящихДокументов = Неопределено, // Если указано, то список требований берется из описи
		Организация 			= Неопределено, // Если указана, то в список фильтруется по ней
		ВходящийКонтекст 		= Неопределено) Экспорт
	
	// Если требование одно, то форму выбора не показываем
	Если ОписьВходящихДокументов = Неопределено Тогда
		Требования = Неопределено;
	Иначе
		Требования = ТребованияФНСВызовСервера.ТребованияВОписи(ОписьВходящихДокументов);
		Если Требования.Количество() = 1 Тогда
			СоздатьОтветНаТребованиеФНС(Требования[0], ВходящийКонтекст);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СоздатьОтветНаТребованиеФНС", 
		ЭтотОбъект,
		ВходящийКонтекст);
	
	ПоказатьФормуВыбораТребованияФНС(ОписаниеОповещения, Организация, , Требования);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьОтветНаТребованиеФНС(Требование, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	ВидТребования = Неопределено;
	Если Требование <> Неопределено Тогда
		
		ВидТребования = ЗначенияРеквизитовОбъекта(Требование, "ВидДокумента")["ВидДокумента"];
		
		Если ВидТребования = ПредопределенноеЗначение("Перечисление.ВидыНалоговыхДокументов.ТребованиеОПредставленииДокументов") Тогда
			
			СоздатьОтветНаТребованиеДокументовСВыборомВидаОтвета(Требование);
			
		ИначеЕсли ВидТребования = ПредопределенноеЗначение("Перечисление.ВидыНалоговыхДокументов.ТребованиеОПредставленииПоясненийКДекларацииНДС") Тогда
			// Создание ответа в виде
			// - Пояснения к декларации по НДС (для НДС)
			// - Письма (для других отчетов)
			СоздатьПоясненийКДекларацииНДССВыборомВидаПояснения(Требование, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ВыполняемоеОповещение")
		И ДополнительныеПараметры.ВыполняемоеОповещение <> Неопределено Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, ВидТребования);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция СоздатьПоясненийКДекларацииНДССВыборомВидаПояснения(Требование, ВходящийКонтекст = Неопределено) Экспорт
	
	ВТребованииЕстьXMLФайл = ЕстьТребованияКРазделам8_12(Требование);
	
	ЕстьРеестрИмущество  = ДокументооборотСКОВызовСервера.ЕстьУведомление("РеестрЛьготИмущество");
	ЕстьРеестрНДС        = ДокументооборотСКОВызовСервера.ЕстьУведомление("РеестрДокументовПодтверждающихЛьготы");

	СписокВыбора  = Новый СписокЗначений;
	СписокВыбора.Добавить(1, "Пояснение к декларации по НДС");
	СписокВыбора.Добавить(3, ОтветПакетом());
	
	Если ЕстьРеестрНДС Тогда
		СписокВыбора.Добавить(7, "Реестр документов, подтверждающих льготы по НДС");
	КонецЕсли;
	
	Если НЕ ВТребованииЕстьXMLФайл И ЕстьРеестрИмущество Тогда
		СписокВыбора.Добавить(8, "Реестр документов, подтверждающих льготы по налогу на имущество");
	КонецЕсли;
	
	ВыбратьВидОтвета(СписокВыбора, Требование);
			
КонецФункции

&НаКлиенте
Процедура СоздатьПоясненияКДекларацииПоНДС(Требование) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	
	ЭлементыОтбора = Новый Структура;
	ЭлементыОтбора.Вставить("ОснованиеСсылка", Требование);
	
	ДополнительныеПараметры.Вставить("ЗначенияЗаполнения", ЭлементыОтбора);
	
	ОткрытьФорму("Документ.ПоясненияКДекларацииПоНДС.ФормаОбъекта", ДополнительныеПараметры, , Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ЕстьТребованияКРазделам8_12(ДокументыРеализацииПолномочий)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЕстьТребованияКРазделам8_12(ДокументыРеализацииПолномочий);
	
КонецФункции

&НаКлиенте
Процедура СоздатьОтветНаДокументРеализацииПолномочий(ДокументыРеализацииПолномочийСсылка, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЭтоТребованиеФНС = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоТребованиеФНС(ДокументыРеализацииПолномочийСсылка);
	Если ЭтоТребованиеФНС Тогда		
		// Создание ответа на
		// - требование документов
		// - требование по Декларации по НДС
		СоздатьОтветНаТребованиеФНС(ДокументыРеализацииПолномочийСсылка, ДополнительныеПараметры);
	Иначе
		// Создание письма на 
		// - уведомления
		СоздатьПисьмоВОтветНаДокументРеализацииПолномочийСВыборомВарианта(ДокументыРеализацииПолномочийСсылка);

	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПисьмоВОтветНаДокументРеализацииПолномочий(Требование) Экспорт
	
	Значения = ЗначенияРеквизитовОбъекта(Требование, "НомерДокумента, ДатаДокумента");
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ОснованиеСсылка", Требование);
	ЗначенияЗаполнения.Вставить("Дата",  Значения.ДатаДокумента);
	ЗначенияЗаполнения.Вставить("Номер", Значения.НомерДокумента);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
	ОткрытьФорму("Справочник.ПерепискаСКонтролирующимиОрганами.ФормаОбъекта", ДополнительныеПараметры,,Новый УникальныйИдентификатор);
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтветыНаТребованияФНС(Ответы) Экспорт
	
	Если Ответы.Количество() > 1 Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Ответы", Ответы);

		ОткрытьФорму(ПутьКОбъекту + ".Форма.ОтветыНаТребованияФНС", ДополнительныеПараметры,, Новый УникальныйИдентификатор);
		
	ИначеЕсли Ответы.Количество() = 1 Тогда
		
		ПоказатьЗначение(, Ответы[0]);
		
	Иначе
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Ответы отсутствуют';
															|en = 'Ответы отсутствуют'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтправленныеОтветыНаТребованияФНС(Требование) Экспорт
	
	ПоказатьОтветыНаТребованияФНС(ОтправленныеОтветыНаТребованияФНС(Требование));
	
КонецПроцедуры

&НаСервере
Функция ОтправленныеОтветыНаТребованияФНС(Требование) Экспорт
	
	Возврат Справочники.ДокументыРеализацииПолномочийНалоговыхОрганов.ОтправленныеОтветыНаТребованиеПоясненийКДекларацииНДС(Требование);
	
КонецФункции

&НаСервере
Функция ОтветыНаТребование(ТребованиеСсылка, ВключаяНевозможностьПредоставленияДокументов = Истина) Экспорт
	
	Возврат ТребованияФНС.ОтветыНаТребование(ТребованиеСсылка, , ВключаяНевозможностьПредоставленияДокументов);
	
КонецФункции

&НаСервере
Функция ОтветыНаТребованиеФСС(ТребованиеСсылка) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтветыНаТребованиеФСС(ТребованиеСсылка);
	
КонецФункции

&НаКлиенте
Процедура ПодготовитьКорректирующуюДекларациюПоНДСИзПояснения(Пояснение) Экспорт
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Раздел", ПредопределенноеЗначение("Перечисление.СтраницыЖурналаОтчетность.Отчеты"));
	
	ОткрытьФорму("ОбщаяФорма.РегламентированнаяОтчетность", ПараметрыОткрытия, , "1С-Отчетность", );
	
	Оповестить("Открытие формы 1С-Отчетность", ПараметрыОткрытия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыНалогоплательщикаИзВходящегоТребования(ТранспортноеСообщениеВходящегоТребования)
	
	// извлекаем вложения расшифрованного входящего сообщения
	Вложения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщениеВходящегоТребования.Ссылка, Истина);
	ВложенияДокумент = Вложения.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ));
	Если ВложенияДокумент.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВложениеДокумент = ВложенияДокумент[0];
	
	// считываем документ
	ВремФайлДокумент = ПолучитьИмяВременногоФайла();
	ВложениеДокумент.Данные.Получить().Записать(ВремФайлДокумент);
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ВремФайлДокумент);
	
	УзлыСвНП = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя", "СвНП"), Истина);
	Если УзлыСвНП.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвНП = УзлыСвНП[0];
	
	Результат = Новый Структура();
	Результат.Вставить("НаимОрг", 	ИзвлечьДанное(УзелСвНП, "НаимОрг"));
	Результат.Вставить("ИННЮЛ", 	ИзвлечьДанное(УзелСвНП, "ИННЮЛ"));
	Результат.Вставить("КПП", 		ИзвлечьДанное(УзелСвНП, "КПП"));
	Результат.Вставить("ИННФЛ", 	ИзвлечьДанное(УзелСвНП, "ИННФЛ"));
	Результат.Вставить("Фамилия", 	ИзвлечьДанное(УзелСвНП, "Фамилия"));
	Результат.Вставить("Имя", 		ИзвлечьДанное(УзелСвНП, "Имя"));
	Результат.Вставить("Отчество",	ИзвлечьДанное(УзелСвНП, "Отчество"));
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВремФайлДокумент);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыПолучателяИзВходящегоТребования(ТранспортноеСообщениеВходящегоТребования)
	
	// извлекаем вложения расшифрованного входящего сообщения
	Вложения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщениеВходящегоТребования.Ссылка, Истина);
	ВложенияДокумент = Вложения.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ));
	Если ВложенияДокумент.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВложениеДокумент = ВложенияДокумент[0];
	
	// считываем документ
	ВремФайлДокумент = ПолучитьИмяВременногоФайла();
	ВложениеДокумент.Данные.Получить().Записать(ВремФайлДокумент);
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ВремФайлДокумент);
	
	КНДТребования = ИзвлечьДанное(ДеревоXML, "КНД");
	
	УзлыСвНП = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя", "СвПолДок"), Истина);
	
	Если УзлыСвНП.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвНП = УзлыСвНП[0];
	
	Результат = Новый Структура();
	Результат.Вставить("НаимОрг", 	ИзвлечьДанное(УзелСвНП, "НаимОрг"));
	Результат.Вставить("ИННЮЛ", 	ИзвлечьДанное(УзелСвНП, "ИННЮЛ"));
	Результат.Вставить("КПП", 		ИзвлечьДанное(УзелСвНП, "КПП"));
	Результат.Вставить("ИННФЛ", 	ИзвлечьДанное(УзелСвНП, "ИННФЛ"));
	Результат.Вставить("Фамилия", 	ИзвлечьДанное(УзелСвНП, "Фамилия"));
	Результат.Вставить("Имя", 		ИзвлечьДанное(УзелСвНП, "Имя"));
	Результат.Вставить("Отчество",	ИзвлечьДанное(УзелСвНП, "Отчество"));
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВремФайлДокумент);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СоздатьОтветНаТребованиеДокументовСВыборомВидаОтвета(Требование, ВходящийКонтекст = Неопределено) Экспорт
	
	// Предлагаем меню с выбором из 2х вариантов
	СписокВыбора  = Новый СписокЗначений;
	СписокВыбора.Добавить(4, "Ответ на требование документов (информации)");
	СписокВыбора.Добавить(5, "Уведомление о невозможности ответить в срок");
	
	ВыбратьВидОтвета(СписокВыбора, Требование);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПисьмоОтветСВыборомВидаОтвета(Ссылка, ВходящийКонтекст = Неопределено) Экспорт
	
	// Предлагаем меню с выбором из 2х вариантов
	СписокВыбора  = Новый СписокЗначений;
	СписокВыбора.Добавить(6, "Письмо");
	СписокВыбора.Добавить(3, "Отправка истребуемых документов");
	
	ВыбратьВидОтвета(СписокВыбора, Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПакетСДопДокуменами(ОснованиеПакета) Экспорт
	
	Организация = СведенияПоОтправляемымОбъектам(ОснованиеПакета).Организация;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация", Организация);
	
	Если ОснованиеПакета <> Неопределено Тогда
		
		Если НЕ ОснованиеПакетаВыбраноКорректно(ОснованиеПакета) Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы.Вставить("ОснованиеПакета", ОснованиеПакета);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ОписиИсходящихДокументовВНалоговыеОрганы.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОтветНаТребованиеДокументов(Требование) Экспорт
	
	ЭлементыОтбора = Новый Структура;
	ЭлементыОтбора.Вставить("ОснованиеСсылка", Требование);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
	ОткрытьФорму("Справочник.ОписиИсходящихДокументовВНалоговыеОрганы.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораВидаОтветаНаТребование(ВидОтвета, ДополнительныеПараметры) Экспорт
	
	Если ВидОтвета <> Неопределено Тогда
		
		Ссылка = ДополнительныеПараметры.Ссылка;
	
		Если ВидОтвета.Значение = 1 Тогда
			СоздатьПоясненияКДекларацииПоНДС(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 2 Тогда
			СоздатьПисьмоВОтветНаДокументРеализацииПолномочий(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 3 Тогда
			СоздатьПакетСДопДокуменами(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 4 Тогда
			СоздатьОтветНаТребованиеДокументов(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 5 Тогда
			ПодготвоитьУведомлениеОНевозможностиОтветитьВСрок(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 6 Тогда
			СоздатьПисьмоОтвет(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 7 Тогда
			ПодготовитьРеестрДокументов(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 8 Тогда
			ПодготовитьРеестрДокументовИмущество(Ссылка);
		ИначеЕсли ВидОтвета.Значение = 9 Тогда
			ПодготвоитьУведомлениеПоТребованию(Ссылка, "СогласиеСМотивированнымМнением");
		ИначеЕсли ВидОтвета.Значение = 10 Тогда
			ПодготвоитьУведомлениеПоТребованию(Ссылка, "РазногласиеСМотивированнымМнением");
		ИначеЕсли ВидОтвета.Значение = 11 Тогда
			ПодготвоитьУведомлениеПоТребованию(Ссылка, "ВзаимосогласительнаяПроцедура");
		ИначеЕсли ВидОтвета.Значение = 12 Тогда
			
			УведомлениеОСпецрежимахНалогообложенияКлиент.СоздатьПояснениеКИзвещениюОбИсчисленныхНалогах(
				ЭтотОбъект, 
				Ссылка);
			
		ИначеЕсли ВидОтвета.Значение = 13 Тогда
			ПодготвоитьУведомлениеПоТребованию(Ссылка, "НевозможностьПредоставленияИнформации");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЭтоРешениеПоЖалобе(Требование)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоРешениеПоЖалобе(Требование);

КонецФункции

&НаСервере
Функция ЭтоМотивированноеМнение(Требование)

	Возврат Требование.ВидДокумента = Перечисления.ВидыНалоговыхДокументов.МотивированноеМнение;

КонецФункции

&НаСервере
Функция ЭтоИсчислениеНалога(Требование)

	Виды = Перечисления.ВидыНалоговыхДокументов;
	
	Возврат Требование.ВидДокумента = Виды.СообщениеОбИсчисленнойСуммеТранспортногоНалога
		ИЛИ Требование.ВидДокумента = Виды.СообщениеОбИсчисленнойСуммеТранспортногоИмущественногоЗемельногоНалогов
		ИЛИ Требование.ВидДокумента = Виды.СообщениеОбИсчисленнойСуммеЗемельногоНалога;

КонецФункции

&НаСервере
Функция ЭтоЗапросОПредставленииДокументовИнформации(Требование)
	
	Возврат Требование.ВидДокумента = Перечисления.ВидыНалоговыхДокументов.ЗапросОПредставленииДокументовИнформации;
	
КонецФункции

&НаКлиенте
Функция ОтветПакетом()

	Возврат НСтр("ru = 'Пакет с текстовым пояснением и доп. документами';
				|en = 'Пакет с текстовым пояснением и доп. документами'");

КонецФункции

&НаКлиенте
Функция ОтветПисьмом()

	Возврат НСтр("ru = 'Письмо (не рекомендуется)';
				|en = 'Письмо (не рекомендуется)'");

КонецФункции

&НаКлиенте
Процедура СоздатьПисьмоВОтветНаДокументРеализацииПолномочийСВыборомВарианта(Требование) Экспорт
	
	Пакет  = ОтветПакетом();
	Письмо = ОтветПисьмом();
	
	Если ТребуетсяОтправкаПакетаСДопДокументами(Требование) Тогда 
		
		СписокВыбора  = Новый СписокЗначений;
		СписокВыбора.Добавить(3, Пакет);
		СписокВыбора.Добавить(2, Письмо);
		
		ВыбратьВидОтвета(СписокВыбора, Требование);
		
	ИначеЕсли ЭтоРешениеПоЖалобе(Требование) Тогда

		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ОснованиеСсылка", Требование);

		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

		ОткрытьФорму("Справочник.ПерепискаСКонтролирующимиОрганами.ФормаОбъекта", ДополнительныеПараметры,,Новый УникальныйИдентификатор);
		
	ИначеЕсли ЭтоМотивированноеМнение(Требование) Тогда
		
		СписокВыбора  = Новый СписокЗначений;
		
		ЕстьУведомление = ДокументооборотСКОВызовСервера.ЕстьУведомление("СогласиеСМотивированнымМнением");
		Если ЕстьУведомление Тогда
			СписокВыбора.Добавить(9,  "Согласие с мотивированным мнением налогового органа");
		КонецЕсли;
		
		ЕстьУведомление = ДокументооборотСКОВызовСервера.ЕстьУведомление("РазногласиеСМотивированнымМнением");
		Если ЕстьУведомление Тогда
			СписокВыбора.Добавить(10, "Разногласия на мотивированное мнение налогового органа");
		КонецЕсли;
			
		ЕстьУведомление = ДокументооборотСКОВызовСервера.ЕстьУведомление("ВзаимосогласительнаяПроцедура");
		Если ЕстьУведомление Тогда
			СписокВыбора.Добавить(11, "Уведомление о согласии (несогласии) с мотивированным мнением налогового органа по результатам взаимосогласительной процедуры");
		КонецЕсли;
		
		СписокВыбора.Добавить(3, Пакет);
		СписокВыбора.Добавить(2, Письмо);
		
		ВыбратьВидОтвета(СписокВыбора, Требование);
		
	ИначеЕсли ЭтоИсчислениеНалога(Требование) Тогда
		
		СписокВыбора  = Новый СписокЗначений;
		СписокВыбора.Добавить(12, "Пояснение в связи с сообщением об исчисленных суммах налога");
		СписокВыбора.Добавить(3, Пакет);
		
		ВыбратьВидОтвета(СписокВыбора, Требование);
		
	ИначеЕсли ЭтоЗапросОПредставленииДокументовИнформации(Требование) Тогда
		
		СписокВыбора  = Новый СписокЗначений;
		СписокВыбора.Добавить(3, Пакет);
		СписокВыбора.Добавить(13, "Уведомление о невозможности представления документов (информации) в электронной форме");
		
		ВыбратьВидОтвета(СписокВыбора, Требование);
		
	Иначе
		
		СоздатьОтветНаТребованиеДокументов(Требование);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидОтвета(СписокВыбора, Ссылка) Экспорт
	
	ДополнительныеПараметры = Новый Структура("Ссылка", Ссылка);
	
	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораВидаОтветаНаТребование", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите вид ответа';
														|en = 'Выберите вид ответа'"));
		
КонецПроцедуры

&НаКлиенте
Процедура ПодготвоитьУведомлениеОНевозможностиОтветитьВСрок(Требование) Экспорт
	
	ПодготвоитьУведомлениеПоТребованию(Требование, "НевозможностьПредоставленияДокументов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготвоитьУведомлениеПоТребованию(Требование, ИмяВида) Экспорт
	
	ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения." + ИмяВида);
	Организация = СведенияПоОтправляемымОбъектам(Требование).Организация;
	
	ПараметрыУведомления = Новый Структура;
	ПараметрыУведомления.Вставить("Организация", 	Организация);
	ПараметрыУведомления.Вставить("ВидУведомления", ВидУведомления);
	ПараметрыУведомления.Вставить("Данные", 		Требование);
	
	ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.ФормаОбъекта",  ПараметрыУведомления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьРеестрДокументов(Требование) Экспорт
	
	Организация = СведенияПоОтправляемымОбъектам(Требование).Организация;
	
	ПараметрыУведомления = Новый Структура;
	ПараметрыУведомления.Вставить("Организация", 	Организация);
	ПараметрыУведомления.Вставить("ВидУведомления", ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.РеестрДокументовПодтверждающихЛьготы"));
	ПараметрыУведомления.Вставить("Данные", 		Требование);
	
	ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.ФормаОбъекта",  ПараметрыУведомления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьРеестрДокументовИмущество(Требование) Экспорт
	
	Организация = СведенияПоОтправляемымОбъектам(Требование).Организация;
	
	ПараметрыУведомления = Новый Структура;
	ПараметрыУведомления.Вставить("Организация", 	Организация);
	ПараметрыУведомления.Вставить("ВидУведомления", ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.РеестрЛьготИмущество"));
	ПараметрыУведомления.Вставить("Данные", 		Требование);
	
	ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.ФормаОбъекта",  ПараметрыУведомления);
	
КонецПроцедуры

&НаСервере
Функция ТребуетсяОтправкаПакетаСДопДокументами(Ссылка) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ТребуетсяОтправкаПакетаСДопДокументами(Ссылка);
	
КонецФункции

&НаКлиенте
Процедура СоздатьИсходящуюОписьПоОснованию(ОснованиеСсылка) Экспорт
	
	ЭлементыОтбора = Новый Структура;
	ЭлементыОтбора.Вставить("ОснованиеСсылка", ОснованиеСсылка);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
	ОткрытьФорму("Справочник.ОписиИсходящихДокументовВНалоговыеОрганы.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоясненийКДекларацииНДССВыборомВидаПоясненияПослеВыбора(ВидОтвета, ДополнительныеПараметры) Экспорт
	
	Если ВидОтвета <> Неопределено Тогда
	
		Если ВидОтвета.Значение = 1 Тогда
			СоздатьПоясненияКДекларацииПоНДС(ДополнительныеПараметры.ДокументРеализацииПолномочий);
		ИначеЕсли ВидОтвета.Значение = 2 Тогда
			СоздатьПисьмоВОтветНаДокументРеализацииПолномочий(ДополнительныеПараметры.ДокументРеализацииПолномочий);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПакетно(
		ВыполняемоеОповещение,
		ТранспортноеСообщение,
		ТребующиеПодписания,
		Сертификат,
		МенеджерКриптографии = Неопределено)
		
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Сертификат);
	
	ПараметрыЦикла = НовыЙ Структура();
	ПараметрыЦикла.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ПараметрыЦикла.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	ПараметрыЦикла.Вставить("ТребующиеПодписания", ТребующиеПодписания);
	ПараметрыЦикла.Вставить("СертификатРуководителя", Сертификат);
	ПараметрыЦикла.Вставить("МенеджерКриптографии", МенеджерКриптографии);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения", ЭтотОбъект, ПараметрыЦикла);
	
	МассивДокументов = Новый Массив;
	Для Счетчик = 0 По ТребующиеПодписания.ВГраница() Цикл
		ДанныеФайла = ТребующиеПодписания[Счетчик];
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла);
		НовыйДокументПакетнойПодписи(
			МассивДокументов,
			ДанныеФайла.АдресВременногоХранилища,
			ОписаниеФайла.Имя,
			ОписаниеФайла.Расширение,
			Счетчик);
	КонецЦикла;

	ПакетнаяПодписьОблачнойПодписи(ОписаниеОповещения, МестоХраненияКлюча, МассивДокументов, Сертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаОтветаНаТребованиеПоясненийКДекларацииНДС_ДобавлениеПодписейКакПриложениеПакетноПослеВыполнения(
		РезультатВыполнения, 
		ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ТранспортноеСообщение = ВходящийКонтекст.ТранспортноеСообщение;
	ТребующиеПодписания = ВходящийКонтекст.ТребующиеПодписания;
	Результат = РезультатВыполнения.Выполнено;
	
	Если Результат Тогда
		
		Для Счетчик = 0 По РезультатВыполнения.Результат.ВГраница() Цикл
			Подпись = РезультатВыполнения.Результат[Счетчик];
			ДанныеФайла = ТребующиеПодписания[Счетчик];
			КороткоеИмяФайлаПодписи = ДанныеФайла.ИдФайлЭП;
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение, 
					СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение, 
					Подпись, 
					КороткоеИмяФайлаПодписи, , , , , , , 
					СгенерироватьUUID(), 
					ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn")) Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка создания подписи для документа %1'."), ДанныеФайла.ИмяФайла);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				
				Результат = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение,	Результат);
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция НовыйЧтениеТекстаНаСервере(ИмяФайла, Кодировка = Неопределено) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.НовыйЧтениеТекстаНаСервере(ИмяФайла, Кодировка);
	
КонецФункции

#Область ОбменСФТС

////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТООБОРОТ С ФТС

// ОтправкаСсылка ссылается на загруженный объект
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТС(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки = Неопределено, ЭтоВызовИзСписка = Ложь) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Форма",                Форма);
	ДополнительныеПараметры.Вставить("ОтправкаСсылка",       ОтправкаСсылка);
	ДополнительныеПараметры.Вставить("ЗначениеCookie",       ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.ЗначениеCookie, ""));
	ДополнительныеПараметры.Вставить("Логин",                ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.Логин, ""));
	ДополнительныеПараметры.Вставить("Пароль",               ?(ПараметрыОбновленияОтправки <> Неопределено, ПараметрыОбновленияОтправки.Пароль, ""));
	ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",     ЭтоВызовИзСписка);
	Оповещение = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФТСПослеПолученияСертификатовИПараметровОбмена", ЭтотОбъект, ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляФТС(
		Оповещение,
		Неопределено,
		Истина,
		ОтправкаСсылка,
		Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТСПослеПолученияСертификатовИПараметровОбмена(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	Форма 					= ДополнительныеПараметры.Форма;
	ОтправкаСсылка 			= ДополнительныеПараметры.ОтправкаСсылка;
	ЗначениеCookie 			= ДополнительныеПараметры.ЗначениеCookie;
	Логин 					= ДополнительныеПараметры.Логин;
	Пароль 					= ДополнительныеПараметры.Пароль;
	ЭтоВызовИзСписка 		= ДополнительныеПараметры.ЭтоВызовИзСписка;
	
	Крипт = Неопределено;
	ОрганизацияСсылка = СертификатыИПараметрыОбмена.ОрганизацияИзОтправки;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	ИдентификаторДокументооборота = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	ТелефонМобильныйДляАвторизации = РеквизитыУчетнойЗаписи.ТелефонМобильныйДляАвторизации;
	
	УчетнаяЗапись = Новый Структура("ТелефонМобильныйДляАвторизации, ИдентификаторДокументооборота", ТелефонМобильныйДляАвторизации, ИдентификаторДокументооборота);
	
	ПараметрыФормированияПакета = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета;
	ЭтоРегламентированныйОтчет = СертификатыИПараметрыОбмена.ЭтоРегламентированныйОтчет;
	
	Если НЕ ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Использование документооборота с Федеральной таможенной службой не включено для организации!';
														|en = 'Использование документооборота с Федеральной таможенной службой не включено для организации!'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	ФормаДлительнаяОперация = Неопределено;
	
	ПараметрЛогин = ?(ЗначениеЗаполнено(Логин), Логин, ПараметрыФормированияПакета.Логин);
	ПараметрПароль = ?(ЗначениеЗаполнено(Пароль), Пароль, ПараметрыФормированияПакета.Пароль);
	
	АвторизацияПроизведена = ЗначениеЗаполнено(ЗначениеCookie);
	ИнформацияОСервереФТС = СерверПриемаОтчетностиФТС();
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Организация", 								ОрганизацияСсылка);
	ПараметрыОтправки.Вставить("АдресСервера", 								ИнформацияОСервереФТС.АдресСервера);
	ПараметрыОтправки.Вставить("ВерсияФормированияВыгрузки", 				ИнформацияОСервереФТС.ВерсияФормированияВыгрузки);
	ПараметрыОтправки.Вставить("ВерсияОтправкиПортала", 					ИнформацияОСервереФТС.ВерсияОтправкиПортала);
	ПараметрыОтправки.Вставить("ПоляДляЗаписиОтправки", 					Неопределено);
	ПараметрыОтправки.Вставить("ИдентификаторПредыдущейОтправкиНаСервере", 	"");
	
	ПараметрыСоединения = Новый Структура;
	ПараметрыСоединения.Вставить("Логин", 										ПараметрЛогин);
	ПараметрыСоединения.Вставить("Пароль", 										ПараметрПароль);
	ПараметрыСоединения.Вставить("СохранитьПароль", 							ЗначениеЗаполнено(ПараметрыФормированияПакета.Пароль));
	ПараметрыСоединения.Вставить("СохраненныйЛогин", 							ПараметрыФормированияПакета.Логин);
	ПараметрыСоединения.Вставить("СохраненныйПароль", 							ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СоединениеHTTP", 								Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie", 								"");
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиНаСервере", 				"");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером", 						"");
	ПараметрыСоединения.Вставить("ОписаниеОшибокПроверки", 						"");
	ПараметрыСоединения.Вставить("ПовторятьСоединение", 						Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля", 						Истина);
	ПараметрыСоединения.Вставить("ОрганизацияПодтверждена", 					Неопределено);
	ПараметрыСоединения.Вставить("ОтправленЗапросНаПодтверждениеОрганизации", 	Ложь);
	ПараметрыСоединения.Вставить("СообщенияПользователю", 						Новый Массив);
	ПараметрыСоединения.Вставить("ИдентификаторВыполненияОтправки", 			"");
	ПараметрыСоединения.Вставить("ПодписываемоеСодержимоеВыгрузки64", 			"");
	ПараметрыСоединения.Вставить("ПодписываемыйЗапрос64", 						"");
	ПараметрыСоединения.Вставить("ТекущийАдресСервера", 						ИнформацияОСервереФТС.АдресСервера);
	ПараметрыСоединения.Вставить("ВерсияПортала", 								ИнформацияОСервереФТС.ВерсияПортала);
	ПараметрыСоединения.Вставить("ТекстОтветаАвторизации", 						"");
	
	ПараметрыСоединения.ЗначениеCookie = "";
	
	ПерваяПопыткаАвторизации = Истина;
	ОперацияУспешна = Ложь;
	ПараметрыСоединения.ПовторятьЗапросПароля = Истина;
	
	ОбновитьРезультатКонкретнойОтправкиФТСВводПароля(
		ВыполняемоеОповещение, 
		ПараметрыСоединения, 
		ПараметрыОтправки, 
		ФормаДлительнаяОперация,
		АвторизацияПроизведена,
		ОтправкаСсылка, 
		ПерваяПопыткаАвторизации,
		ЭтоВызовИзСписка);
	
КонецПроцедуры

// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (Цикл)
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТСВводПароля(
	ВыполняемоеОповещение,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ФормаДлительнаяОперация,
	АвторизацияПроизведена,
	ОтправкаСсылка,
	ПерваяПопыткаАвторизации,
	ЭтоВызовИзСписка)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.Логин) 
		ИЛИ НЕ ЗначениеЗаполнено(ПараметрыСоединения.Пароль) 
		ИЛИ НЕ ПерваяПопыткаАвторизации Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",    ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",      ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",        ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",  ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("АвторизацияПроизведена",   АвторизацияПроизведена);
		ДополнительныеПараметры.Вставить("ОтправкаСсылка",           ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации", ПерваяПопыткаАвторизации);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",         ЭтоВызовИзСписка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФТСВводПароляЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ВызватьФормуВводаПароляПорталаФТС(
			"https://" + ПараметрыОтправки.АдресСервера + "/",
			ПараметрыСоединения.Логин,
			ПараметрыСоединения.Пароль,
			ПараметрыСоединения.СохранитьПароль,
			ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	// при успешном обращении на сервер ФТС отправка обновится в ИБ
	ОперацияУспешна = ОбновитьРезультатКонкретнойОтправкиФТСНаСервере(
		ОтправкаСсылка,
		Истина,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ЭтоВызовИзСписка);
		
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ПерваяПопыткаАвторизации = Ложь;
	
	// рекурсивный вызов - замена цикла
	Если НЕ ОперацияУспешна И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
		
		ОбновитьРезультатКонкретнойОтправкиФТСВводПароля(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			ЭтоВызовИзСписка);
		
	Иначе
		
		ОбновитьРезультатКонкретнойОтправкиФТСПослеОтправки(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			ЭтоВызовИзСписка);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТСВводПароляЗавершение(РезультатВводаПароля, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение    = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыСоединения      = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки        = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация  = ДополнительныеПараметры.ФормаДлительнаяОперация;
	АвторизацияПроизведена   = ДополнительныеПараметры.АвторизацияПроизведена;
	ОтправкаСсылка           = ДополнительныеПараметры.ОтправкаСсылка;
	ПерваяПопыткаАвторизации = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	ЭтоВызовИзСписка         = ДополнительныеПараметры.ЭтоВызовИзСписка;
	
	Если РезультатВводаПароля = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	Иначе
		
		ПараметрыСоединения.Логин           = РезультатВводаПароля.Логин;
		ПараметрыСоединения.Пароль          = РезультатВводаПароля.Пароль;
		ПараметрыСоединения.СохранитьПароль = РезультатВводаПароля.СохранитьПароль;
		
		// при успешном обращении на сервер ФТС отправка обновится в ИБ
		ОперацияУспешна = ОбновитьРезультатКонкретнойОтправкиФТСНаСервере(
			ОтправкаСсылка,
			Истина,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ЭтоВызовИзСписка);
		
		ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
		
		ПерваяПопыткаАвторизации = Ложь;
		
		// рекурсивный вызов - замена цикла
		Если НЕ ОперацияУспешна И ПараметрыСоединения.ПовторятьЗапросПароля Тогда
			
			ОбновитьРезультатКонкретнойОтправкиФТСВводПароля(
				ВыполняемоеОповещение,
				ПараметрыСоединения,
				ПараметрыОтправки,
				ФормаДлительнаяОперация,
				АвторизацияПроизведена,
				ОтправкаСсылка,
				ПерваяПопыткаАвторизации,
				ЭтоВызовИзСписка);
			
		Иначе
			
			ОбновитьРезультатКонкретнойОтправкиФТСПослеОтправки(
				ВыполняемоеОповещение,
				ПараметрыСоединения,
				ПараметрыОтправки,
				ФормаДлительнаяОперация,
				АвторизацияПроизведена,
				ОтправкаСсылка,
				ПерваяПопыткаАвторизации,
				ЭтоВызовИзСписка);
				
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТСПослеОтправки(
	ВыполняемоеОповещение,
	ПараметрыСоединения,
	ПараметрыОтправки,
	ФормаДлительнаяОперация,
	АвторизацияПроизведена,
	ОтправкаСсылка,
	ПерваяПопыткаАвторизации,
	ЭтоВызовИзСписка)
	
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// возможно, проблемы с доступом в интернет
		Если НЕ АвторизацияПроизведена Тогда
			ПараметрыСоединения.ЗначениеCookie = "";
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",    ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",      ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",        ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",  ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("АвторизацияПроизведена",   АвторизацияПроизведена);
		ДополнительныеПараметры.Вставить("ОтправкаСсылка",           ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации", ПерваяПопыткаАвторизации);
		ДополнительныеПараметры.Вставить("ЭтоВызовИзСписка",         ЭтоВызовИзСписка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбновитьРезультатКонкретнойОтправкиФТСПослеОтправкиЗавершение", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Федеральной таможенной службы';
				|en = 'Не удалось обратиться к серверу Федеральной таможенной службы'"), 
			ОписаниеОповещения);
			
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФТСПослеОтправкиЗавершение(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение                   = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыСоединения                     = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                       = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация                 = ДополнительныеПараметры.ФормаДлительнаяОперация;
	АвторизацияПроизведена                  = ДополнительныеПараметры.АвторизацияПроизведена;
	ОтправкаСсылка                          = ДополнительныеПараметры.ОтправкаСсылка;
	ПерваяПопыткаАвторизации                = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	ЭтоВызовИзСписка                           = ДополнительныеПараметры.ЭтоВызовИзСписка;
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// рекурсивный вызов - замена цикла
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ОбновитьРезультатКонкретнойОтправкиФТСВводПароля(
			ВыполняемоеОповещение,
			ПараметрыСоединения,
			ПараметрыОтправки,
			ФормаДлительнаяОперация,
			АвторизацияПроизведена,
			ОтправкаСсылка,
			ПерваяПопыткаАвторизации,
			ЭтоВызовИзСписка);
		
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОНевозможностиОбновитьСтатусОтчета();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);	
		
	КонецЕсли;	
	
КонецПроцедуры
// Цикла Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ОткрытьПротоколОтправкиФТС(Форма) Экспорт
	
	ОтчетСсылка = ДокументооборотСФТСКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФТС(ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФТС(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ОтправкаСсылка = Неопределено,
		ОтчетСсылка = Неопределено,
		ОпределитьНастроенностьОбменаВУниверсальномФормате = Ложь)
	
	РезультатВыполнения = Новый Структура("ПараметрыФормированияПакета, ОрганизацияИзОтправки, СвойстваОтправки, Крипт, НастроенОбменВУниверсальномФормате, ПравоИзмененияУчетнойЗаписи, ЭтоРегламентированныйОтчет", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
	
	СвойстваОбмена = СвойстваОбменаОрганизацииДляФТСНаСервере(ОрганизацияСсылка, ОпределитьНастроенностьОбменаВУниверсальномФормате, ПолучитьОсновныеСвойстваПоследнейОтправки, ОтправкаСсылка, ОтчетСсылка);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(СвойстваОбмена);
	
	РезультатВыполнения.ОрганизацияИзОтправки = СвойстваОбмена.ОрганизацияИзОтправки;
	
	РезультатВыполнения.СвойстваОтправки = СвойстваОбмена.СвойстваОтправки;
	
	РезультатВыполнения.НастроенОбменВУниверсальномФормате = СвойстваОбмена.НастроенОбменВУниверсальномФормате;
	РезультатВыполнения.ПравоИзмененияУчетнойЗаписи = СвойстваОбмена.ПравоИзмененияУчетнойЗаписи;
	РезультатВыполнения.ЭтоРегламентированныйОтчет = СвойстваОбмена.ЭтоРегламентированныйОтчет;
	
	РезультатВыполнения.ПараметрыФормированияПакета = Новый Структура;
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИспользоватьОбмен", 			Ложь);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("СертификатАбонента", 			Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("МЧД", 						Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИННДоверителя", 				"");
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("Логин", 						Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("Пароль", 						Неопределено);
	РезультатВыполнения.ПараметрыФормированияПакета.Вставить("ИспользоватьАвтонастройку", 	Ложь);
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьОбмен = СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен;
	РезультатВыполнения.ПараметрыФормированияПакета.МЧД = СвойстваОбмена.НастройкиОбмена.МЧД;
	РезультатВыполнения.ПараметрыФормированияПакета.ИННДоверителя = СвойстваОбмена.НастройкиОбмена.ИННДоверителя;
	РезультатВыполнения.ПараметрыФормированияПакета.Логин = СвойстваОбмена.НастройкиОбмена.Логин;
	РезультатВыполнения.ПараметрыФормированияПакета.Пароль = СвойстваОбмена.НастройкиОбмена.Пароль;
	РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьАвтонастройку = СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СвойстваСертификата = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток);
		Иначе
			СвойстваСертификата = ПолучитьСвойстваОблачногоСертификата(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток, "MY");
		КонецЕсли;
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СвойстваСертификата);
		РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = СвойстваСертификата;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, СвойстваОбмена, РезультатВыполнения", ВыполняемоеОповещение, СвойстваОбмена, РезультатВыполнения);
	Оповещение = Новый ОписаниеОповещения("СертификатыИПараметрыОбменаОрганизацииДляФТСПослеПолученияСвойствСертификатаАбонентаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток) Тогда
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток, "MY", , Ложь);
	Иначе
		РезультатПоиска = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден", Истина, Неопределено, Ложь);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатПоиска);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляФТСПослеПолученияСвойствСертификатаАбонентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СвойстваОбмена = ДополнительныеПараметры.СвойстваОбмена;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ?(Результат.Выполнено И Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СертификатыГодятсяДляПодписанияОтчетностиФТС(Сертификаты)
	
	ТекДата = ТекущаяДатаНаСервере();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		Серт	= Сертификат.Значение;
		Предст	= Сертификат.Представление;
		Если Серт = Неопределено Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтрШаблон(НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в Федеральную таможенную службу!';
																		|en = '%1: сертификат не выбран в настройках сдачи отчетности в Федеральную таможенную службу!'"), Предст));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < Серт.ДействителенС Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтрШаблон(НСтр("ru = '%1: период действия сертификата еще не наступил (%2)!';
																		|en = '%1: период действия сертификата еще не наступил (%2)!'"), Предст, Строка(Серт.ДействителенС)));
		КонецЕсли;
		
		Если ТекДата > Серт.ДействителенПо Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтрШаблон(НСтр("ru = '%1: период действия сертификата истек (%2)!';
																		|en = '%1: период действия сертификата истек (%2)!'"), Предст, Строка(Серт.ДействителенПо)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьДляОтправкиВФТС(
		Форма,
		ВыполняемоеОповещение,
		ТекстФайлаВыгрузки,
		ИмяФайлаВыгрузки,
		СертификатыИПараметрыОбмена = Неопределено,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияСсылка = Неопределено)
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФТСКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	Если ОтчетСсылка = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияСсылка = ДокументооборотСФТСКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи              = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	УчетнаяЗапись                       = РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор                       = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",               ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("Идентификатор",                       Идентификатор);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность",        ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки",        			ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки",        			ИмяФайлаВыгрузки);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);

	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьДляОтправкиВФТСПослеПолученияСертификатовИПараметровОбменаЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляФТС(
		Оповещение,
		ОрганизацияСсылка,
		Ложь,
		Неопределено,
		ОтчетСсылка,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДляОтправкиВФТСПослеПолученияСертификатовИПараметровОбменаЗавершение(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	Форма                               = ДополнительныеПараметры.Форма;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	Идентификатор                       = ДополнительныеПараметры.Идентификатор;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТекстФайлаВыгрузки                  = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки                    = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	
	// запрашиваем параметры формирования пакета и параметры обмена при вызове из отправки
	Если НЕ СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с Федеральной таможенной службой не включено для организации!';
															|en = 'Использование документооборота с Федеральной таможенной службой не включено для организации!'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатАбонента = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента;
	Если СертификатАбонента <> Неопределено И НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		СертификатАбонента.Вставить("КлючевойКонтейнер", Идентификатор);
	КонецЕсли;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатАбонента);
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатАбонента, НСтр("ru = 'Сертификат абонента';
														|en = 'Сертификат абонента'"));
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФТС(СертификатыОбмена) Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	// формируем файл выгрузки

	КодировкаФайла = Неопределено;
	ТекстФайлаВыгрузки = "";
	ИмяФайлаВыгрузки = "";
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет")
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено") Тогда
		
		РезультатВыгрузкиИзЗаявленияОВвозеТоваров = ПопытатьсяВыгрузитьСтатформуИзЗаявленияОВвозеТоваров(
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,
			ОтчетСсылка);

		Если РезультатВыгрузкиИзЗаявленияОВвозеТоваров = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
		Если НЕ РезультатВыгрузкиИзЗаявленияОВвозеТоваров Тогда
			Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
			Иначе
				ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
			КонецЕсли;
			
			Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, Ложь, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
	Иначе // электронное представление
		Если ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
		ОпределеннаяКодировка = Неопределено;
		
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,
			ОпределеннаяКодировка,
			"utf-8");
		
		Если ОпределеннаяКодировка <> Неопределено Тогда
			//КодировкаФайла = ОпределеннаяКодировка;
		КонецЕсли;
	КонецЕсли;
	
	ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, Символы.ВК + Символы.ПС, " "); // обход ошибки платформы при канонизации XML
	ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, Символы.ПС, " "); // обход ошибки платформы при канонизации XML
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда

		Адрес = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, Форма.УникальныйИдентификатор,, Истина, Ложь,, Истина);
		
		СтруктураВозвратаЭтоЭлектроннаяПодпись = Новый Структура("РезультатВыгрузки, ИмяФайлаВыгрузки", Адрес, ИмяФайлаВыгрузки);
			//ЗакодироватьВBase64ЗначениеВременногоХранилища(Адрес);
			
		Если СтруктураВозвратаЭтоЭлектроннаяПодпись <> Неопределено Тогда
			СтруктураВозвратаЭтоЭлектроннаяПодпись.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураВозвратаЭтоЭлектроннаяПодпись);
		Возврат;
		
	КонецЕсли;
	
	// получим имя временного файла
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ИмяФайлаВыгрузки, ТекстФайлаВыгрузки, СертификатыИПараметрыОбмена", ВыполняемоеОповещение, ИмяФайлаВыгрузки, ТекстФайлаВыгрузки, СертификатыИПараметрыОбмена);
	ДополнительныеПараметры.Вставить("КодировкаФайла", КодировкаФайла);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьДляОтправкиВФТСПослеПолученияВременногоКаталога", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПопытатьсяПолучитьЗаявлениеОВвозеТоваровИзСтатформы(ОтчетСсылка, ДокументЗаявлениеОВвозеТоваров = Неопределено, ИмяДокументаЗаявлениеОВвозеТоваров = Неопределено) Экспорт
	
	РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ВыбраннаяФорма, ДанныеОтчета");
	Если РеквизитыОтчета.ВыбраннаяФорма <> "ФормаОтчетаПоЗаявлениюОВвозеТоваров" Тогда
		ДокументЗаявлениеОВвозеТоваров = Неопределено;
		ИмяДокументаЗаявлениеОВвозеТоваров = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
	ИмяДокументаЗаявлениеОВвозеТоваров = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных("ЗаявлениеОВвозеТоваров");
	Если ИмяДокументаЗаявлениеОВвозеТоваров = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Заявление о ввозе товаров не поддерживается в этой конфигурации, выгрузка статистической формы учета перемещения товаров по заявлению невозможна!';
															|en = 'Заявление о ввозе товаров не поддерживается в этой конфигурации, выгрузка статистической формы учета перемещения товаров по заявлению невозможна!'"));
		ДокументЗаявлениеОВвозеТоваров = Неопределено;
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументЗаявлениеОВвозеТоваров = РеквизитыОтчета.ДанныеОтчета.Получить().ЗаявлениеОВвозеТоваров;
	Если НЕ ЗначениеЗаполнено(ДокументЗаявлениеОВвозеТоваров) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Заявление о ввозе товаров не выбрано, выгрузка статистической формы учета перемещения товаров по заявлению невозможна!';
															|en = 'Заявление о ввозе товаров не выбрано, выгрузка статистической формы учета перемещения товаров по заявлению невозможна!'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПопытатьсяВыгрузитьСтатформуИзЗаявленияОВвозеТоваров(
		ТекстФайлаВыгрузки,
		ИмяФайлаВыгрузки,
		ОтчетСсылка = Неопределено,
		ВернутьАдрес = Ложь,
		ТолькоПроверка = Ложь,
		ДокументЗаявлениеОВвозеТоваров = Неопределено,
		ИмяДокументаЗаявлениеОВвозеТоваров = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументЗаявлениеОВвозеТоваров) Тогда
		
		РезультатПолученияЗаявленияОВвозеТоваров = ПопытатьсяПолучитьЗаявлениеОВвозеТоваровИзСтатформы(
			ОтчетСсылка,
			ДокументЗаявлениеОВвозеТоваров,
			ИмяДокументаЗаявлениеОВвозеТоваров);
		
		Если РезультатПолученияЗаявленияОВвозеТоваров <> Истина Тогда
			ТекстФайлаВыгрузки = Неопределено;
			ИмяФайлаВыгрузки = Неопределено;
			Возврат РезультатПолученияЗаявленияОВвозеТоваров;
		КонецЕсли;
	КонецЕсли;
	
	РезультатВыгрузки = Документы[ИмяДокументаЗаявлениеОВвозеТоваров].ВыгрузитьУчетПеремещенияТоваров(Новый УникальныйИдентификатор(), ДокументЗаявлениеОВвозеТоваров, ТолькоПроверка);
	Если РезультатВыгрузки = Неопределено ИЛИ РезультатВыгрузки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ТолькоПроверка Тогда
		Если НЕ ВернутьАдрес Тогда
			ИмяВременногоФайлаВыгрузки = ПолучитьИмяВременногоФайла();
			ДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(РезультатВыгрузки[0].АдресФайлаВыгрузки);
			ДанныеФайлаВыгрузки.Записать(ИмяВременногоФайлаВыгрузки);
			ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайлаВыгрузки, "utf-8");
			ТекстФайлаВыгрузки = ОбъектЧтениеТекста.Прочитать();
			ОбъектЧтениеТекста.Закрыть();
			
		Иначе
			ТекстФайлаВыгрузки = РезультатВыгрузки[0].АдресФайлаВыгрузки;
		КонецЕсли;
		
	Иначе
		ТекстФайлаВыгрузки = Неопределено;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = РезультатВыгрузки[0].ИмяФайлаВыгрузки;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьДляОтправкиВФТСПослеПолученияВременногоКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ТекстФайлаВыгрузки = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ПолноеИмяФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПолноеИмяФайлаВыгрузки, СертификатыИПараметрыОбмена", ВыполняемоеОповещение, ПолноеИмяФайлаВыгрузки, СертификатыИПараметрыОбмена);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьДляОтправкиВФТСПослеЗаписиФайлаВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстФайлаВыгрузки, ПолноеИмяФайлаВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДляОтправкиВФТСПослеЗаписиФайлаВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВозвращаемаяСтруктура = Новый Структура;
	ВозвращаемаяСтруктура.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	ВозвращаемаяСтруктура.Вставить("РезультатВыгрузки", ПолноеИмяФайлаВыгрузки);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ВозвращаемаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
		
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС(
		ВходящийКонтекст.Форма,
		ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность,
		ВходящийКонтекст.ОтчетСсылка,
		ВходящийКонтекст.ОрганизацияОтчета);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС(
		Форма, 
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь, 
		Знач ОтчетСсылка = Неопределено, 
		Знач ОрганизацияОтчета = Неопределено) Экспорт
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияОтчета 	= ДокументооборотСФТСКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
		ОтчетСсылка 		= ДокументооборотСФТСКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 						 Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 				 ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 			 ОрганизацияОтчета);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		// отправляем только из записанной формы
		Если Форма.Модифицированность Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС_ПослеСохранения", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			Возврат;
		КонецЕсли;
		
	Иначе // электронное представление
		
		Если Форма.Модифицированность Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
										|en = 'Необходимо записать отчет перед отправкой.'"));
			Возврат;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС_ПослеСохранения(Истина, ДополнительныеПараметры);
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС_ПослеСохранения(Результат, ДополнительныеПараметры) Экспорт
	
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность        = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета                   = ДополнительныеПараметры.ОрганизацияОтчета;
	
	Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
		ОтчетСсылка = ДокументооборотСФСРАРКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
		ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
	КонецЕсли;
	
	СвойстваОбмена = СвойстваОбменаОрганизацииДляФТСНаСервере(
		ОрганизацияОтчета, 
		Истина, 
		Ложь, 
		,
		ОтчетСсылка);
	
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		Если НЕ СвойстваОбмена.НастроенОбменВУниверсальномФормате Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, ОписаниеОповещения);
			
		Иначе
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СвойстваОбмена.НастроенОбменВУниверсальномФормате 
		И НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ОтчетСсылка) Тогда
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);//+
		Возврат;
	КонецЕсли;
	
	МестоХраненияКлюча  = КонтекстМоделиХраненияКлюча(СвойстваОбмена);
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если СвойстваОбмена.НастроенОбменВУниверсальномФормате 
		И СвойстваОбмена.НастройкиОбмена.ИспользоватьАвтонастройку 
		И СвойстваОбмена.ПравоИзмененияУчетнойЗаписи Тогда

		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", 				ТипЗнчСсылкаНаОтчет);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСАвтонастройкаУчетнойЗаписиЗавершение", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка,ОписаниеОповещения);
		
		Возврат;
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеАвтонастройкиУчетнойЗаписи(
		Форма, 
		ОтчетСсылка, 
		МестоХраненияКлюча, 
		ТипЗнчСсылкаНаОтчет, 
		ОрганизацияОтчета, 
		ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСАвтонастройкаУчетнойЗаписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ТипЗнчСсылкаНаОтчет = ДополнительныеПараметры.ТипЗнчСсылкаНаОтчет;
	ОрганизацияОтчета = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеАвтонастройкиУчетнойЗаписи(Форма, ОтчетСсылка, МестоХраненияКлюча, ТипЗнчСсылкаНаОтчет, ОрганизацияОтчета, ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеАвтонастройкиУчетнойЗаписи(Форма, ОтчетСсылка, МестоХраненияКлюча, ТипЗнчСсылкаНаОтчет, 
	ОрганизацияОтчета, Знач ЭтоОтправкаИзФормыОтчетность = Ложь)
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		// отправляем только из записанной формы
		Если Форма.Модифицированность Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Форма", Форма);
			ДополнительныеПараметры.Вставить("ОтчетСсылка", ОтчетСсылка);
			ДополнительныеПараметры.Вставить("ОрганизацияОтчета", ОрганизацияОтчета);
			ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", ЭтоОтправкаИзФормыОтчетность);
			КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеАвтонастройкиУчетнойЗаписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);
			Возврат;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ЭтоОтправкаИзФормыОтчетность Тогда
			
			ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид");
		
			ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
				НачалоДня(ЗначенияРеквизитов.ДатаНачала),
				КонецДня(ЗначенияРеквизитов.ДатаОкончания),
				ЗначенияРеквизитов.Вид);
				
		Иначе
		
			ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
				Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,
				Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета,
				Форма.СтруктураРеквизитовФормы.ВидДокумента * Форма.НомерКорректировки);
				
		КонецЕсли;
		
	Иначе // электронное представление
		
		Если Форма.Модифицированность Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Необходимо записать отчет перед отправкой.';
										|en = 'Необходимо записать отчет перед отправкой.'"));
			Возврат;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки = ПоляДляЗаписиОтправкиВФТСНаСервере(ОтчетСсылка);
		
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения(
		Форма, 
		ОтчетСсылка, 
		МестоХраненияКлюча, 
		ПоляДляЗаписиОтправки, 
		ОрганизацияОтчета, 
		ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеАвтонастройкиУчетнойЗаписиЗавершение(Результат, ВходящийКонтекст) Экспорт

	Форма 								= ВходящийКонтекст.Форма;
	ОтчетСсылка 						= ВходящийКонтекст.ОтчетСсылка;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	ОрганизацияОтчета 					= ВходящийКонтекст.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность 		= ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность;
	
	// если не удалось сохранить - возврат
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	// если отчет не был записан ранее, то получим ссылку на записанный отчет
	Если ОтчетСсылка = Неопределено Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ОтчетСсылка = ДокументооборотСФТСКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
			ВходящийКонтекст.ОтчетСсылка = ОтчетСсылка;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид");
		
		ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			НачалоДня(ЗначенияРеквизитов.ДатаНачала),
			КонецДня(ЗначенияРеквизитов.ДатаОкончания),
			ЗначенияРеквизитов.Вид);
		
	Иначе
		
		ПоляДляЗаписиОтправки = Новый Структура("ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			Форма.СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,
			Форма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета,
			Форма.СтруктураРеквизитовФормы.ВидДокумента * Форма.НомерКорректировки);
			
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения(
		Форма, 
		ОтчетСсылка, 
		МестоХраненияКлюча, 
		ПоляДляЗаписиОтправки, 
		ОрганизацияОтчета, 
		ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения(
		Форма, 
		ОтчетСсылка, 
		МестоХраненияКлюча, 
		ПоляДляЗаписиОтправки, 
		ОрганизацияОтчета,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь)
	
	// запрашиваем подтверждение
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", 								Форма);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 				ПоляДляЗаписиОтправки);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОтчетСсылка, ОписаниеОповещения);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ОтчетСсылка, ВходящийКонтекст.ОрганизацияОтчета, "ФТС");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохранения_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	Форма 		= ВходящийКонтекст.Форма;
	ОтчетСсылка = ВходящийКонтекст.ОтчетСсылка;
	
	ПараметрыФормы = Новый Структура("СсылкаНаОтчет", ОтчетСсылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохраненияЗавершение", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	ПодтверждениеОтправкиОтчета(
		Форма, 
		ОписаниеОповещения, 
		ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеСохраненияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПоляДляЗаписиОтправки = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	ОрганизацияОтчета = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодтверждения(Форма, ОтчетСсылка, МестоХраненияКлюча, ПоляДляЗаписиОтправки, ОрганизацияОтчета, ЭтоОтправкаИзФормыОтчетность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодтверждения(Форма, ОтчетСсылка, МестоХраненияКлюча, ПоляДляЗаписиОтправки, ОрганизацияОтчета,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь)
	
	// проверяем, отправлялся ли отчет
	РезультатПроверки = ПроверитьПередОтправкойВФТСНаСервере(ОтчетСсылка);
	ИдентификаторНеПринятойОтправкиНаСервере = "";
	Если НЕ РезультатПроверки.ОтправкаРазрешена Тогда
		Если ЗначениеЗаполнено(РезультатПроверки.ТекстВопроса) Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Форма",                                    Форма);
			ДополнительныеПараметры.Вставить("ОтчетСсылка",                              ОтчетСсылка);
			ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки",                    ПоляДляЗаписиОтправки);
			ДополнительныеПараметры.Вставить("ОрганизацияОтчета",                        ОрганизацияОтчета);
			ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность",             ЭтоОтправкаИзФормыОтчетность);
			ДополнительныеПараметры.Вставить("ИдентификаторНеПринятойОтправкиНаСервере", РезультатПроверки.ИдентификаторНеПринятойОтправкиНаСервере);
			ДополнительныеПараметры.Вставить("ВозможноАннулированиеСОтправкойНового",    РезультатПроверки.КнопкиВопроса <> Неопределено);
			КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодтвержденияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			Если РезультатПроверки.КнопкиВопроса <> Неопределено Тогда
				Для каждого КнопкаВопроса Из РезультатПроверки.КнопкиВопроса Цикл
					КнопкаВопроса.Значение = ?(КнопкаВопроса.Значение = "Да", 	КодВозвратаДиалога.Да,
											 ?(КнопкаВопроса.Значение = "Нет", 	КодВозвратаДиалога.Нет, КнопкаВопроса.Значение));
				КонецЦикла;
			КонецЕсли;
			ПоказатьВопрос(
				ОписаниеОповещения,
				РезультатПроверки.ТекстВопроса,
				?(РезультатПроверки.КнопкиВопроса = Неопределено, РежимДиалогаВопрос.ДаНет, РезультатПроверки.КнопкиВопроса),,
				КодВозвратаДиалога.Нет);
		КонецЕсли;
		
	Иначе
		РежимыОтправки = Новый Структура;
		РежимыОтправки.Вставить("ИдентификаторНеПринятойОтправкиНаСервере", ИдентификаторНеПринятойОтправкиНаСервере);
		РежимыОтправки.Вставить("ЭтоАннулированиеСОтправкойНового", 		Ложь);
		РежимыОтправки.Вставить("ТекстПричиныАннулирования", 				"");
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки(
			Форма,
			ОтчетСсылка,
			МестоХраненияКлюча,
			ПоляДляЗаписиОтправки,
			ОрганизацияОтчета,
			ЭтоОтправкаИзФормыОтчетность,
			РежимыОтправки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодтвержденияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Форма                                    = ДополнительныеПараметры.Форма;
	ОтчетСсылка                              = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча						 = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПоляДляЗаписиОтправки                    = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	ОрганизацияОтчета                        = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность             = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ИдентификаторНеПринятойОтправкиНаСервере = ДополнительныеПараметры.ИдентификаторНеПринятойОтправкиНаСервере;
	ВозможноАннулированиеСОтправкойНового    = ДополнительныеПараметры.ВозможноАннулированиеСОтправкойНового;
	
	ЭтоАннулированиеСОтправкойНового = (Ответ = "АннулироватьОтправитьНовый");
	
	Если Ответ <> КодВозвратаДиалога.Да И НЕ ЭтоАннулированиеСОтправкойНового Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоАннулированиеСОтправкойНового Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеВводаЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВводСтроки(
			ОписаниеОповещения,,
			НСтр("ru = 'Введите причину аннулирования';
				|en = 'Введите причину аннулирования'"),
			1500,
			Истина);
		Возврат;
		
	ИначеЕсли ВозможноАннулированиеСОтправкойНового Тогда
		ИдентификаторНеПринятойОтправкиНаСервере = ""; // отправка отдельного отчета, без аннулирования
	КонецЕсли;
	
	РежимыОтправки = Новый Структура;
	РежимыОтправки.Вставить("ИдентификаторНеПринятойОтправкиНаСервере", ИдентификаторНеПринятойОтправкиНаСервере);
	РежимыОтправки.Вставить("ЭтоАннулированиеСОтправкойНового", 		Ложь);
	РежимыОтправки.Вставить("ТекстПричиныАннулирования", 				"");
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки(
		Форма,
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПоляДляЗаписиОтправки,
		ОрганизацияОтчета,
		ЭтоОтправкаИзФормыОтчетность,
		РежимыОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеВводаЗавершение(ТекстОтвета, ДополнительныеПараметры) Экспорт
	
	Форма                                    = ДополнительныеПараметры.Форма;
	ОтчетСсылка                              = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча						 = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПоляДляЗаписиОтправки                    = ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	ОрганизацияОтчета                        = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность             = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ИдентификаторНеПринятойОтправкиНаСервере = ДополнительныеПараметры.ИдентификаторНеПринятойОтправкиНаСервере;
	ВозможноАннулированиеСОтправкойНового    = ДополнительныеПараметры.ВозможноАннулированиеСОтправкойНового;
	
	Если ТекстОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстОтвета) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодтвержденияЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, "АннулироватьОтправитьНовый");
		Возврат;
	КонецЕсли;
	
	РежимыОтправки = Новый Структура;
	РежимыОтправки.Вставить("ИдентификаторНеПринятойОтправкиНаСервере", ИдентификаторНеПринятойОтправкиНаСервере);
	РежимыОтправки.Вставить("ЭтоАннулированиеСОтправкойНового", 		Истина);
	РежимыОтправки.Вставить("ТекстПричиныАннулирования", 				ТекстОтвета);
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки(
		Форма,
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПоляДляЗаписиОтправки,
		ОрганизацияОтчета,
		ЭтоОтправкаИзФормыОтчетность,
		РежимыОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки(
	Форма,
	ОтчетСсылка,
	МестоХраненияКлюча,
	ПоляДляЗаписиОтправки,
	ОрганизацияОтчета,
	ЭтоОтправкаИзФормыОтчетность,
	РежимыОтправки)
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФТС(
		ОтчетСсылка, 
		Форма, 
		ЭтоОтправкаИзФормыОтчетность);
		
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
		
	Если РезультатВыгрузки = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось выгрузить отчет.';
				|en = 'Не удалось выгрузить отчет.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 									Форма);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 							ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", 					ПоляДляЗаписиОтправки);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 						ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 			ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("РежимыОтправки", 							РежимыОтправки);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 						РезультатВыгрузки.ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 						РезультатВыгрузки.ИмяФайлаВыгрузки);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеИнициализации", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 					ОписаниеОповещения);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, КонтекстДлительнойОперации);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФТС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПроверки() Экспорт
	
	КонтекстДлительнойОперации 	= ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	ОписаниеОповещения 			= КонтекстДлительнойОперации.ОписаниеОповещения;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеИнициализации(Результат, ДополнительныеПараметры) Экспорт
	
	Форма                        = ДополнительныеПараметры.Форма;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета            = ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоОтправкаИзФормыОтчетность = ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ТекстФайлаВыгрузки           = ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки             = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	СертификатыИПараметрыОбмена = Неопределено;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеВыгрузкиПакета",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Формирование файлов для отправки..."); // ФТС
		
	ВыгрузитьДляОтправкиВФТС(
		Форма,
		ОписаниеОповещения,
		ТекстФайлаВыгрузки,
		ИмяФайлаВыгрузки,
		СертификатыИПараметрыОбмена,
		ЭтоОтправкаИзФормыОтчетность,
		ОтчетСсылка,
		ОрганизацияОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеВыгрузкиПакета(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	СертификатыИПараметрыОбмена = Результат.СертификатыИПараметрыОбмена;

	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПараметрыФормированияПакета = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета;
	
	ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета", ПараметрыФормированияПакета);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		СтрокаBase64ФайлаВыгрузки = Результат.РезультатВыгрузки;

		КороткоеИмяФайлаВыгрузки = Результат.ИмяФайлаВыгрузки;
		
		Результат = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, СтрокаBase64ФайлаВыгрузки);
		
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки", КороткоеИмяФайлаВыгрузки);
		
		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЧтенияФайлаВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
	Иначе
		Крипт = СертификатыИПараметрыОбмена.Крипт;
		КороткоеИмяФайлаВыгрузки = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Результат.РезультатВыгрузки).Имя;
		
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки", КороткоеИмяФайлаВыгрузки);

		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЧтенияФайлаВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, Результат.РезультатВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЧтенияФайлаВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	СертификатыИПараметрыОбмена 		= ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ПараметрыФормированияПакета 		= ДополнительныеПараметры.ПараметрыФормированияПакета;
	КороткоеИмяФайлаВыгрузки 			= ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	Форма 								= ДополнительныеПараметры.Форма;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	РежимыОтправки 						= ДополнительныеПараметры.РежимыОтправки;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаВыгрузки = Результат.СтрокаBase64;
	
	ФормаДлительнаяОперация = Неопределено;
	ИнформацияОСервереФТС = СерверПриемаОтчетностиФТС();
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("Организация", 					ОрганизацияОтчета);
	ПараметрыОтправки.Вставить("АдресСервера", 					ИнформацияОСервереФТС.АдресСервера);
	ПараметрыОтправки.Вставить("ВерсияФормированияВыгрузки", 	ИнформацияОСервереФТС.ВерсияФормированияВыгрузки);
	ПараметрыОтправки.Вставить("ВерсияОтправкиПортала", 		ИнформацияОСервереФТС.ВерсияОтправкиПортала);
	ПараметрыОтправки.Вставить("ПоляДляЗаписиОтправки", 		ПоляДляЗаписиОтправки);
	ПараметрыОтправки.Вставить("РежимыОтправки", 				РежимыОтправки);
	
	ПараметрыСоединения = Новый Структура();
	ПараметрыСоединения.Вставить("Логин", 										ПараметрыФормированияПакета.Логин);
	ПараметрыСоединения.Вставить("Пароль", 										ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СохранитьПароль", 							ЗначениеЗаполнено(ПараметрыФормированияПакета.Пароль));
	ПараметрыСоединения.Вставить("СохраненныйЛогин", 							ПараметрыФормированияПакета.Логин);
	ПараметрыСоединения.Вставить("СохраненныйПароль", 							ПараметрыФормированияПакета.Пароль);
	ПараметрыСоединения.Вставить("СоединениеHTTP", 								Неопределено);
	ПараметрыСоединения.Вставить("ЗначениеCookie", 								"");
	ПараметрыСоединения.Вставить("ИдентификаторОтправкиНаСервере", 				"");
	ПараметрыСоединения.Вставить("ОписаниеОшибкиСервером", 						"");
	ПараметрыСоединения.Вставить("ОписаниеОшибокПроверки", 						"");
	ПараметрыСоединения.Вставить("ПовторятьСоединение", 						Истина);
	ПараметрыСоединения.Вставить("ПовторятьЗапросПароля", 						Истина);
	ПараметрыСоединения.Вставить("ОрганизацияПодтверждена", 					Неопределено);
	ПараметрыСоединения.Вставить("ОтправленЗапросНаПодтверждениеОрганизации", 	Ложь);
	ПараметрыСоединения.Вставить("СообщенияПользователю", 						Новый Массив);
	ПараметрыСоединения.Вставить("ИдентификаторВыполненияОтправки", 			"");
	ПараметрыСоединения.Вставить("ПодписываемоеСодержимоеВыгрузки64", 			"");
	ПараметрыСоединения.Вставить("ПодписываемыйЗапрос64", 						"");
	ПараметрыСоединения.Вставить("ТекущийАдресСервера", 						ИнформацияОСервереФТС.АдресСервера);
	ПараметрыСоединения.Вставить("ВерсияПортала", 								ИнформацияОСервереФТС.ВерсияПортала);
	ПараметрыСоединения.Вставить("ТекстОтветаАвторизации", 						"");
	ПараметрыСоединения.Вставить("СертификатАбонента", 							ПараметрыФормированияПакета.СертификатАбонента);
	
	КонвертироватьВКодировку = "utf-8";
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Передача файлов на сервер..."); // ФТС
	
	СтрокаBase64ФайлаОтправки = СформироватьФайлОтправкиВФТСНаСервере(
		КороткоеИмяФайлаВыгрузки, 
		СтрокаBase64ФайлаВыгрузки, 
		НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча), 
		Форма.УникальныйИдентификатор, 
		КонвертироватьВКодировку, 
		ПараметрыОтправки);
		
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаВЦикле(
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаВыгрузки,
		КороткоеИмяФайлаВыгрузки,
		Форма,
		СертификатыИПараметрыОбмена);
	
КонецПроцедуры

// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (Цикл) 
&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаВЦикле(
	ОтчетСсылка,
	МестоХраненияКлюча,
	ПараметрыОтправки,
	ПараметрыСоединения,
	ФормаДлительнаяОперация,
	СтрокаBase64ФайлаОтправки,
	СтрокаBase64ФайлаВыгрузки,
	КороткоеИмяФайлаВыгрузки,
	Форма,
	СертификатыИПараметрыОбмена)
	
	РезультатОтправки                         = Неопределено;
	ПараметрыСоединения.ЗначениеCookie        = "";
	ПерваяПопыткаАвторизации                  = Истина;
	ПараметрыСоединения.ПовторятьЗапросПароля = Истина;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСВводПароля(
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаВыгрузки,
		КороткоеИмяФайлаВыгрузки,
		РезультатОтправки,
		ПерваяПопыткаАвторизации,
		Форма,
		СертификатыИПараметрыОбмена);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСВводПароля(
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаВыгрузки,
		КороткоеИмяФайлаВыгрузки,
		РезультатОтправки,
		ПерваяПопыткаАвторизации,
		Форма,
		СертификатыИПараметрыОбмена)
		
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
	ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
	ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
	ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
	ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаВыгрузки",           СтрокаBase64ФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки",            КороткоеИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РезультатОтправки",                   РезультатОтправки);
	ДополнительныеПараметры.Вставить("ПерваяПопыткаАвторизации",            ПерваяПопыткаАвторизации);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСВводПароляЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.Логин) 
		ИЛИ НЕ ЗначениеЗаполнено(ПараметрыСоединения.Пароль) 
		ИЛИ НЕ ПерваяПопыткаАвторизации Тогда
		
		ВызватьФормуВводаПароляПорталаФТС(
			"https://" + ПараметрыОтправки.АдресСервера + "/",
			ПараметрыСоединения.Логин,
			ПараметрыСоединения.Пароль,
			ПараметрыСоединения.СохранитьПароль,
			ОписаниеОповещения);
		
	Иначе
		
		РезультатВводаПароля = Новый Структура();
		РезультатВводаПароля.Вставить("Логин",           ПараметрыСоединения.Логин);
		РезультатВводаПароля.Вставить("Пароль",          ПараметрыСоединения.Пароль);
		РезультатВводаПароля.Вставить("СохранитьПароль", ПараметрыСоединения.СохранитьПароль);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатВводаПароля);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСВводПароляЗавершение(РезультатВводаПароля, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	СтрокаBase64ФайлаВыгрузки           = ДополнительныеПараметры.СтрокаBase64ФайлаВыгрузки;
	КороткоеИмяФайлаВыгрузки            = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	РезультатОтправки                   = ДополнительныеПараметры.РезультатОтправки;
	ПерваяПопыткаАвторизации            = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	Форма                               = ДополнительныеПараметры.Форма;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	Если РезультатВводаПароля = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	ПараметрыСоединения.Логин           = РезультатВводаПароля.Логин;
	ПараметрыСоединения.Пароль          = РезультатВводаПароля.Пароль;
	ПараметрыСоединения.СохранитьПароль = РезультатВводаПароля.СохранитьПароль;
	
	РезультатОтправки = ОтправитьВФТСНаСервере(
		МестоХраненияКлюча,
		СтрокаBase64ФайлаОтправки,
		КороткоеИмяФайлаВыгрузки,
		ОтчетСсылка,
		ПараметрыОтправки,
		ПараметрыСоединения);
	
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ПерваяПопыткаАвторизации = Ложь;
	
	// рекурсивный вызов - замена цикла
	
	ОтправитьЗапросНаПодтверждениеОрганизации = (НЕ РезультатОтправки И ПараметрыСоединения.ОрганизацияПодтверждена <> Неопределено
		И НЕ ПараметрыСоединения.ОтправленЗапросНаПодтверждениеОрганизации);
	Если ОтправитьЗапросНаПодтверждениеОрганизации Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка", ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки", ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения", ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация", ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаВыгрузки", СтрокаBase64ФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки", КороткоеИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", СертификатыИПараметрыОбмена);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЗаписиПодписываемогоЗапроса", ЭтотОбъект, ДополнительныеПараметры);
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ПараметрыСоединения.ПодписываемыйЗапрос64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПараметрыСоединения.ПодписываемыйЗапрос64);
		КонецЕсли;
		
		Если ПараметрыСоединения.ОрганизацияПодтверждена = Ложь Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатОтправки Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаВыгрузки",           СтрокаBase64ФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки",            КороткоеИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЗаписиПодписываемойВыгрузкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			
			РезультатВыполнения = Новый Структура();
			РезультатВыполнения.Вставить("Выполнено",      Истина);
			РезультатВыполнения.Вставить("ДвоичныеДанные", Неопределено);
			РезультатВыполнения.Вставить("ИмяФайла",       ПараметрыСоединения.ПодписываемоеСодержимоеВыгрузки64);
			
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПараметрыСоединения.ПодписываемоеСодержимоеВыгрузки64);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибокПроверки) Тогда
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ИмяФайла",              "");
		СтруктураПараметров.Вставить("Содержимое",            ПараметрыСоединения.ОписаниеОшибокПроверки);
		СтруктураПараметров.Вставить("Кодировка",             Неопределено);
		СтруктураПараметров.Вставить("ПереноситьПоСловам",    Истина);
		СтруктураПараметров.Вставить("ТекстЗаголовка",        НСтр("ru = 'Протокол ошибок';
																	|en = 'Протокол ошибок'"));
		СтруктураПараметров.Вставить("ПечатьРазрешена",       Истина);
		СтруктураПараметров.Вставить("ВысотаФормы",           15);
		СтруктураПараметров.Вставить("КлючУникальностиФормы", "ОписаниеОшибокПроверкиФТС");
		
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий(); // ФТС.
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрТекст", СтруктураПараметров);
		
		
	ИначеЕсли ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// не получено файла результата при отправке пакета. Возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаВыгрузки",           СтрокаBase64ФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки",            КороткоеИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВФТСПослеПоказаОшибкиДоступаВИнтернет", ЭтотОбъект, ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Федеральной таможенной службы';
				|en = 'Не удалось обратиться к серверу Федеральной таможенной службы'"), 
			ОписаниеОповещения);
			
	ИначеЕсли НЕ ОтправитьЗапросНаПодтверждениеОрганизации Тогда
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЗаписиПодписываемогоЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ИмяФайлаВыгрузки = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	ОрганизацияОтчета = ДополнительныеПараметры.ПараметрыОтправки.Организация;
	
	ИмяФайлаПодписываемогоЗапроса = Результат.ИмяФайла;
	
	НастройкиПодписи = Новый Структура();
	НастройкиПодписи.Вставить("Трансформация1_1", 			Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 	Истина);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 	Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 			Неопределено);
	НастройкиПодписи.Вставить("СсылкаНаМЧД", 				СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.МЧД);
	НастройкиПодписи.Вставить("ИННДоверителя", 				СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИННДоверителя);
	Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодписанияФайлаЗапросаXMLDSig", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаВыгрузки);
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ОтправкаВФТС", ОрганизацияОтчета); 
		ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации, НастройкиПодписи);
	КонецЕсли;
	
	ПодписатьФайлXMLDSig(СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента, ИмяФайлаПодписываемогоЗапроса, Оповещение, , , НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодписанияФайлаЗапросаXMLDSig(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл запроса подтверждения организации!';
															|en = 'Не удалось подписать файл запроса подтверждения организации!'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСЧтенияФайлаПодписиЗапроса", ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ПолноеИмяПодписанногоФайла);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСЧтенияФайлаПодписиЗапроса(Результат, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПараметрыОтправки = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыСоединения = ДополнительныеПараметры.ПараметрыСоединения;
	ФормаДлительнаяОперация = ДополнительныеПараметры.ФормаДлительнаяОперация;
	Форма = ДополнительныеПараметры.Форма;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	ВыводитьОшибки = (ПараметрыСоединения.ОрганизацияПодтверждена = Ложь)
		ИЛИ (НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибокПроверки) И НЕ ПараметрыСоединения.ПовторятьСоединение);
	
	СтрокаBase64ФайлаПодписанногоЗапроса = Результат.СтрокаBase64;
	
	РезультатОтправки = ОтправитьПодписанныйЗапросВФТСНаСервере(
		МестоХраненияКлюча,
		СтрокаBase64ФайлаПодписанногоЗапроса,
		ОтчетСсылка,
		ПараметрыОтправки,
		ПараметрыСоединения);
		
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	Если РезультатОтправки Тогда
		Если ПараметрыСоединения.ОрганизацияПодтверждена = Истина Тогда
			ТекстСообщения = НСтр("ru = 'Отправлен запрос обновления сведений об ЭП организации на портале ФТС, обработка запроса обычно происходит в течение 10 минут.';
									|en = 'Отправлен запрос обновления сведений об ЭП организации на портале ФТС, обработка запроса обычно происходит в течение 10 минут.'") + ?(ВыводитьОшибки, "
										|" + НСтр("ru = 'Отчет не отправлен, повторите попытку отправки позже.';
													|en = 'Отчет не отправлен, повторите попытку отправки позже.'"), "");
		Иначе
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Внимание! Отправлен запрос на подтверждение ЭП организации (проверка в ЕСИА), обработка запроса обычно происходит в течение 10 минут.
						   |Отчет не отправлен, повторите попытку отправки позже, после подтверждения организации порталом ФТС.
						   |Если вы ожидаете подтверждения организации более 2 часов и отправка не удается, обратитесь в техническую поддержку на портале ФТС %1';
						   |en = 'Внимание! Отправлен запрос на подтверждение ЭП организации (проверка в ЕСИА), обработка запроса обычно происходит в течение 10 минут.
						   |Отчет не отправлен, повторите попытку отправки позже, после подтверждения организации порталом ФТС.
						   |Если вы ожидаете подтверждения организации более 2 часов и отправка не удается, обратитесь в техническую поддержку на портале ФТС %1'"),
				"https://" + ПараметрыОтправки.АдресСервера);
		КонецЕсли;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
	ИначеЕсли ВыводитьОшибки И ПараметрыСоединения.ОрганизацияПодтверждена = Истина
		И СтрНайти(ПараметрыСоединения.ОписаниеОшибкиСервером, "Запрос на добавление организации уже создан, ожидайте решения") = 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Ошибка отправки запроса обновления сведений о сертификате ЭП организации на портале ФТС.';
								|en = 'Ошибка отправки запроса обновления сведений о сертификате ЭП организации на портале ФТС.'")
			+ ?(ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером), " " + ПараметрыСоединения.ОписаниеОшибкиСервером, "");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
	Если ВыводитьОшибки Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьПодписанныйЗапросВФТСНаСервере(МестоХраненияКлюча, Знач СтрокаBase64ФайлаПодписанногоЗапроса, Знач ОтчетСсылка, Знач ПараметрыОтправки, ПараметрыСоединения)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ОтправитьПодписанныйЗапросВФТСССервера(МестоХраненияКлюча, СтрокаBase64ФайлаПодписанногоЗапроса, ОтчетСсылка, ПараметрыОтправки, ПараметрыСоединения);
	
КонецФункции

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВФТСПослеПоказаОшибкиДоступаВИнтернет(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	СтрокаBase64ФайлаВыгрузки           = ДополнительныеПараметры.СтрокаBase64ФайлаВыгрузки;
	КороткоеИмяФайлаВыгрузки            = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	Форма                               = ДополнительныеПараметры.Форма;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// рекурсивный вызов - замена цикла
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаВЦикле(
			ОтчетСсылка,
			МестоХраненияКлюча,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ФормаДлительнаяОперация,
			СтрокаBase64ФайлаОтправки,
			СтрокаBase64ФайлаВыгрузки,
			КороткоеИмяФайлаВыгрузки,
			Форма,
			СертификатыИПараметрыОбмена);
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФТС. Нет доступа в Интернет.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЗаписиПодписываемойВыгрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	СертификатыИПараметрыОбмена = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ИмяФайлаВыгрузки = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОрганизацияОтчета = ДополнительныеПараметры.ПараметрыОтправки.Организация;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		Возврат;
	КонецЕсли;
	
	ИмяФайлаПодписываемойВыгрузки = Результат.ИмяФайла;
	
	НастройкиПодписи = Новый Структура();
	НастройкиПодписи.Вставить("Трансформация1_1", 			Истина);
	НастройкиПодписи.Вставить("ВключатьХэшСертификата", 	Истина);
	НастройкиПодписи.Вставить("НеВключатьЗаголовокXML", 	Истина);
	НастройкиПодписи.Вставить("ЗаменаУзлаОбъекта", 			Неопределено);
	НастройкиПодписи.Вставить("ПереданХешВместоОбъекта", 	Истина);
	НастройкиПодписи.Вставить("СсылкаНаМЧД", 				СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.МЧД);
	НастройкиПодписи.Вставить("ИННДоверителя", 				СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИННДоверителя);
	
	Оповещение = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодписанияФайлаXMLDSigЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаВыгрузки);
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ОтправкаВФТС", ОрганизацияОтчета); 
		ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, Истина, НастройкиПодписи);
	КонецЕсли;
	
	ПодписатьФайлXMLDSig(
		СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента,
		ИмяФайлаПодписываемойВыгрузки,
		Оповещение,
		,
		,
		НастройкиПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПодписанияФайлаXMLDSigЗавершение(ПолноеИмяПодписанногоФайла, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если ПолноеИмяПодписанногоФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл выгрузки!';
															|en = 'Не удалось подписать файл выгрузки!'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС. 
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСЧтенияФайлаПодписиЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		РезультатВыполнения = Новый Структура();
		РезультатВыполнения.Вставить("Выполнено",      Истина);
		РезультатВыполнения.Вставить("ДвоичныеДанные", Неопределено);
		РезультатВыполнения.Вставить("СтрокаBase64",   ПолноеИмяПодписанногоФайла);

		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ПолноеИмяПодписанногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСЧтенияФайлаПодписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	КороткоеИмяФайлаВыгрузки            = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	Форма                               = ДополнительныеПараметры.Форма;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС. 
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ФайлаПодписи = Результат.СтрокаBase64;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаПодписиВЦикле(
		ОтчетСсылка,
		МестоХраненияКлюча,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ФормаДлительнаяОперация,
		СтрокаBase64ФайлаПодписи,
		КороткоеИмяФайлаВыгрузки,
		Форма,
		СертификатыИПараметрыОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаПодписиВЦикле(
	ОтчетСсылка,
	МестоХраненияКлюча,
	ПараметрыОтправки,
	ПараметрыСоединения,
	ФормаДлительнаяОперация,
	СтрокаBase64ФайлаПодписи,
	КороткоеИмяФайлаВыгрузки,
	Форма,
	СертификатыИПараметрыОбмена)

	РезультатОтправки = ОтправитьПодписьВФТСНаСервере(
		МестоХраненияКлюча,
		СтрокаBase64ФайлаПодписи,
		КороткоеИмяФайлаВыгрузки,
		ОтчетСсылка,
		ПараметрыОтправки,
		ПараметрыСоединения);
		
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);
	
	ОтправитьЗапросНаПодтверждениеОрганизации = (РезультатОтправки = Неопределено И ПараметрыСоединения.ОрганизацияПодтверждена <> Неопределено
		И НЕ ПараметрыСоединения.ОтправленЗапросНаПодтверждениеОрганизации);
	Если ОтправитьЗапросНаПодтверждениеОрганизации Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки", 					ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения", 				ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация", 			ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПодписи", 			СтрокаBase64ФайлаПодписи);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки", 			КороткоеИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Форма", 								Форма);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена", 		СертификатыИПараметрыОбмена);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		Оповещение = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеЗаписиПодписываемогоЗапроса", ЭтотОбъект, ДополнительныеПараметры);
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, ПараметрыСоединения.ПодписываемыйЗапрос64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПараметрыСоединения.ПодписываемыйЗапрос64);
		КонецЕсли;
		
		Если ПараметрыСоединения.ОрганизацияПодтверждена = Ложь Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатОтправки <> Неопределено Тогда
		
		ПараметрыАвтозапроса = Новый Структура();
		ПараметрыАвтозапроса.Вставить("Ключ",           РезультатОтправки);
		ПараметрыАвтозапроса.Вставить("ЗначениеCookie", ПараметрыСоединения.ЗначениеCookie);
		ПараметрыАвтозапроса.Вставить("Логин",          ПараметрыСоединения.Логин);
		ПараметрыАвтозапроса.Вставить("Пароль",         ПараметрыСоединения.Пароль);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
		
		ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФТС.
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибокПроверки) Тогда
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ИмяФайла",              "");
		СтруктураПараметров.Вставить("Содержимое",            ПараметрыСоединения.ОписаниеОшибокПроверки);
		СтруктураПараметров.Вставить("Кодировка",             Неопределено);
		СтруктураПараметров.Вставить("ПереноситьПоСловам",    Истина);
		СтруктураПараметров.Вставить("ТекстЗаголовка",        НСтр("ru = 'Протокол ошибок';
																	|en = 'Протокол ошибок'"));
		СтруктураПараметров.Вставить("ПечатьРазрешена",       Истина);
		СтруктураПараметров.Вставить("ВысотаФормы",           15);
		СтруктураПараметров.Вставить("КлючУникальностиФормы", "ОписаниеОшибокПроверкиФТС");
		
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий(); // ФТС.
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрТекст", СтруктураПараметров);
		
	ИначеЕсли ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// не получено файла результата при отправке пакета. Возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПодписи",            СтрокаBase64ФайлаПодписи);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаВыгрузки",            КороткоеИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПоказаОшибкиДоступаВИнтернет", ЭтотОбъект, ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Федеральной таможенной службы';
				|en = 'Не удалось обратиться к серверу Федеральной таможенной службы'"),
			ОписаниеОповещения);
			
	ИначеЕсли НЕ ОтправитьЗапросНаПодтверждениеОрганизации Тогда
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(); // ФТС.
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСПослеПоказаОшибкиДоступаВИнтернет(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	СтрокаBase64ФайлаПодписи            = ДополнительныеПараметры.СтрокаBase64ФайлаПодписи;
	КороткоеИмяФайлаВыгрузки            = ДополнительныеПараметры.КороткоеИмяФайлаВыгрузки;
	Форма                               = ДополнительныеПараметры.Форма;
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// рекурсивный вызов - замена цикла
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФТСОтправкаПодписиВЦикле(
			ОтчетСсылка,
			МестоХраненияКлюча,
			ПараметрыОтправки,
			ПараметрыСоединения,
			ФормаДлительнаяОперация,
			СтрокаBase64ФайлаПодписи,
			КороткоеИмяФайлаВыгрузки,
			Форма,
			СертификатыИПараметрыОбмена);
			
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФТС. Нет доступа в Интернет.	
		
	КонецЕсли;
	
КонецПроцедуры
// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаКлиенте
Процедура ВызватьФормуВводаПароляПорталаФТС(Портал, Логин, Пароль, СохранитьПароль, ВыполняемоеОповещение = Неопределено)
	
	Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(, Истина)
		И ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина) = 0 Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(НСтр("ru = 'Не указаны параметры доступа к порталу Федеральной таможенной службы';
																	|en = 'Не указаны параметры доступа к порталу Федеральной таможенной службы'"));
	Иначе
		ПараметрыФормы = Новый Структура("Портал, Логин, Пароль, СохранитьПароль", Портал, Логин, Пароль, СохранитьПароль);
		ОписаниеОповещения = Новый ОписаниеОповещения("ВызватьФормуВводаПароляПорталаФТСЗавершение", ЭтотОбъект, ВыполняемоеОповещение);
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ВводПароляФТС", ПараметрыФормы,,,,, ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьФормуВводаПароляПорталаФТСЗавершение(РезультатФормы, ВыполняемоеОповещение) Экспорт
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФТС(ИсточникСсылка, ПечатьВозможна = Истина) Экспорт
	
	ВАрхиве = ОбъектВАрхиве(ИсточникСсылка, "Протокол");
	Если ВАрхиве Тогда 
		ПоказатьУведомлениеАрхивныхФайлов(, 16, 0, Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ИсточникСсылка",      ИсточникСсылка);
	ПараметрыФормы.Вставить("ПечатьВозможна",      ПечатьВозможна);
	ПараметрыФормы.Вставить("КонтролирующийОрган", ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФТС"));
		
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПротоколОбработкиHTML", ПараметрыФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьРегистрыСведенийНастройкиОбменаФТС(
		Организация,
		ОтпечатокСертификата,
		ВыводитьСообщения,
		Логин,
		Пароль,
		МЧД = Неопределено)
	
	Попытка
	
		ОбменФТС = Мультирежим.МенеджерЗаписиНастроекОбмена(
			Организация,
			ОтпечатокСертификата,
			"ФТС",
			"НастройкиОбменаФТС",
			"СертификатАбонентаОтпечаток");
		
		ОбменФТС.ИспользоватьАвтонастройку 	= Истина;
		ОбменФТС.Доверенность 				= МЧД;
		ОбменФТС.Логин 						= Логин;
		ОбменФТС.Пароль 					= Пароль;
		ОбменФТС.Записать();
		Если ВыводитьСообщения Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Обновлены параметры отправки отчетности в Федеральную таможенную службу.';
					|en = 'Обновлены параметры отправки отчетности в Федеральную таможенную службу.'"));
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось обновить параметры отправки отчетности в Федеральную таможенную службу по причине:
                  |%1';
                  |en = 'Не удалось обновить параметры отправки отчетности в Федеральную таможенную службу по причине:
                  |%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
