	КонтекстДлительнойОперации.Вставить("НомерОтчета", 			ДополнительныеПараметры.НомерДоверенности);
	КонтекстДлительнойОперации.Вставить("ДатаНачалаОтправки", 	ДополнительныеПараметры.ДатаНачалаОтправки);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Неопределено;
