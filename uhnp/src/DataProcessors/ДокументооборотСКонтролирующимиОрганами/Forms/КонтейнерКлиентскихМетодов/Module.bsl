#КонецОбласти

#Область СПАРК

&НаКлиенте
Процедура ПодтверждениеОтправкиОтчета(Форма, ОписаниеОповещения, Ссылка, ПоказатьПринудительно = Ложь) Экспорт
	
	НужноПодтверждение = Ложь;
	Если Форма = Неопределено ИЛИ ПоказатьПринудительно Тогда
		НужноПодтверждение =
			ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДСкрытьДлительнуюОтправку") <> Истина;
		
	Иначе
		
		КраткоеИмяФормы = ДлительнаяОтправкаКлиентСервер.ИмяФормыПоПолномуИмени(Форма.ИмяФормы);
		
		Это1СОтчетность = ДлительнаяОтправкаКлиент.ЭтоФормаОтправкиОтчетности(КраткоеИмяФормы, Форма.ИмяФормы);
		ЭтоФормаНастройки    = КраткоеИмяФормы = "МастерФормированияЗаявкиНаПодключениеНастройкаПрограммыУпрощенный";
		ЭтоВторичныйМастер   = КраткоеИмяФормы = "МастерФормированияЗаявкиНаИзменениеПараметровПодключения";
		ЭтоГрупповаяОтправка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(Форма, Истина);
		// отправка списка уведомлений прослеживаемости товаров
		ЭтоОтправкаБезПодтверждения =
			(ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации("БРО.ПодтверждатьОтправку") = Ложь);
		
		НужноПодтверждение = 
			НЕ (Это1СОтчетность
			ИЛИ ЭтоФормаНастройки
			ИЛИ ЭтоВторичныйМастер
			ИЛИ ЭтоГрупповаяОтправка
			ИЛИ ЭтоОтправкаБезПодтверждения);
			
		Если НужноПодтверждение Тогда
			ЭтоГрупповаяОтправка = ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(, Истина);
			Если ЭтоГрупповаяОтправка Тогда
				 НужноПодтверждение = Ложь;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
		
	Если НужноПодтверждение Тогда
		
		Если ЭтоНужныйВидОтчетаСПАРК(Ссылка) Тогда
		
			ОтправкаОтчетностиВИнтерфакс = "РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОтправкаОтчетностиВИнтерфакс";
			Если ОбщегоНазначенияКлиент.ПодсистемаСуществует(ОтправкаОтчетностиВИнтерфакс) Тогда
				МодульОтправкаРегОтчетовВСПАРККлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОтправкаРегОтчетовВСПАРККлиент");
				МодульОтправкаРегОтчетовВСПАРККлиент.ОткрытьФормуПодтверждениеОтправкиОтчетаСПАРК(Ссылка, ОписаниеОповещения);
			КонецЕсли;
		Иначе
			ПараметрыФормы = Новый Структура("СсылкаНаОтчет", Ссылка);
			
			ОткрытьФорму(
				ПутьКОбъекту + ".Форма.ПодтверждениеОтправкиОтчета", 
				ПараметрыФормы,
				,
				,
				,
				,
				ОписаниеОповещения, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.ОК);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЭтоНужныйВидОтчетаСПАРК(СсылканаОтчет) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоНужныйВидОтчетаСПАРК(СсылканаОтчет);
	
КонецФункции

#КонецОбласти

#Область ПредупреждениеОСертификатах


#КонецОбласти

#Область ПроверкаИмениФайлаНаСимволы

&НаКлиенте
Функция ПерекодироватьСтроку(КонвертируемаяСтрока, КодировкаКонвертации) Экспорт
	
	ДанныеСтроки = ПолучитьДвоичныеДанныеИзСтроки(КонвертируемаяСтрока, КодировкаКонвертации);
	Результат = ПолучитьСтрокуИзДвоичныхДанных(ДанныеСтроки, КодировкаКонвертации);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьНеДопустимыеСимволыИмениФайла(ПроверяемаяСтрока, КодировкаПроверки = "UTF-8") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Пройдена", Истина);
	Результат.Вставить("НовоеИмя", "");
	
	СтрокаАнализа = ПроверяемаяСтрока;
	
	Если КодировкаПроверки <> "UTF-8" Тогда
		СтрокаАнализа = ПерекодироватьСтроку(СтрокаАнализа, КодировкаПроверки);
	КонецЕсли;	
	
	СимволыЗапрещенные = "\|/:*?""<>+";
	СимволыОкончания = " .";
	ДлинаСтроки = СтрДлина(СтрокаАнализа);
	
	Для Счетчик = 1 По ДлинаСтроки Цикл
		ТекущийСимвол = Сред(СтрокаАнализа, Счетчик, 1);
		Если Счетчик = ДлинаСтроки И СтрНайти(СимволыОкончания, ТекущийСимвол) > 0 Тогда
			ТекущийСимвол = "_";
			Результат.Пройдена = Ложь;
		ИначеЕсли СтрНайти(СимволыЗапрещенные, ТекущийСимвол) > 0 Тогда
			ТекущийСимвол = "_";
			Результат.Пройдена = Ложь;
 		КонецЕсли;
		Результат.НовоеИмя = Результат.НовоеИмя + ТекущийСимвол;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтказОтЭДО

&НаКлиенте
Процедура Подключаемый_СпроситьПроЭДОПередЗакрытием(Форма) Экспорт
	
	ДокументЗаявление  = Форма.ДокументЗаявление;
	
	Если ТипЗнч(ДокументЗаявление) = Тип("ДанныеФормыСтруктура") Тогда
		ДокументЗаявление = ДокументЗаявление.Ссылка;
	КонецЕсли;
		
	РеквизитыЗаявления = ЗначенияРеквизитовОбъекта(ДокументЗаявление, "ПодключитьЭДО, ПереиздатьСертификатЭДО");
	
	Если РеквизитыЗаявления.ПодключитьЭДО Тогда
		ТекстПредупреждения = НСтр("ru = 'Закрыть мастер без подключения к сервису 1С-ЭДО?';
									|en = 'Закрыть мастер без подключения к сервису 1С-ЭДО?'");
	ИначеЕсли РеквизитыЗаявления.ПереиздатьСертификатЭДО Тогда
		ТекстПредупреждения = НСтр("ru = 'Закрыть мастер без обновления сертификата 1С-ЭДО?';
									|en = 'Закрыть мастер без обновления сертификата 1С-ЭДО?'");
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеПолученияОтветаПроЭДО", 
		ЭтотОбъект,
		Форма);
		
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(НСтр("ru = 'Да и предложить позже';
						|en = 'Да и предложить позже'"));
	Кнопки.Добавить(НСтр("ru = 'Да и больше не предлагать';
						|en = 'Да и больше не предлагать'"));
	Кнопки.Добавить(НСтр("ru = 'Нет';
						|en = 'Нет'"));
	
	КнопкаПоУмолчанию = НСтр("ru = 'Да и предложить позже';
							|en = 'Да и предложить позже'");
	
	ПоказатьВопрос(
		ОписаниеОповещения,
		ТекстПредупреждения,
		Кнопки);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеПолученияОтветаПроЭДО(Ответ, Форма) Экспорт  
	
	Если Ответ = НСтр("ru = 'Да и предложить позже';
						|en = 'Да и предложить позже'") Тогда
		Форма.ПрограммноеЗакрытие = Истина;
		Форма.Закрыть();
	ИначеЕсли Ответ = НСтр("ru = 'Да и больше не предлагать';
							|en = 'Да и больше не предлагать'") Тогда
		Форма.ПрограммноеЗакрытие = Истина;
		СохранитьОтказОтЭДО(Форма.ДокументЗаявление);
		ОповеститьОбИзменении(Форма.ДокументЗаявление);
		Оповестить("ОтказОтЭДО", Форма.ДокументЗаявление);
		Форма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьОтказОтЭДО(ДокументЗаявление)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НастройкаЗавершена", Истина);
	ДополнительныеПараметры.Вставить("НастройкаЭДОЗавершена", Истина);
	ДополнительныеПараметры.Вставить("ПодключитьЭДО", Ложь);
	ДополнительныеПараметры.Вставить("ПереиздатьСертификатЭДО", Ложь);
	
	ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(
		ДокументЗаявление, 
		ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область СУЦ

&НаКлиенте
Процедура ВыполнитьДействиеСФайлом(Форма, ОповещениеОЗавершении, Элемент, Действие, СтандартнаяОбработка) Экспорт
	
	ВидДокумента      = Сред(Элемент.Имя, 7);
	СвойстваДокумента = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма)[ВидДокумента];
		
	СтандартнаяОбработка = Ложь;
	
	ПриложитьМЧДИлиСкан = ОбработкаЗаявленийАбонентаКлиентСервер.ОткрытьФормуДобавленияМЧДИлиСкана(Форма, СвойстваДокумента.Представление);
	Если ПриложитьМЧДИлиСкан Тогда
		
		ОткрытьФормуДобавленияДоверенности(Форма, ОповещениеОЗавершении);
		
	ИначеЕсли Действие = "выберите" Тогда
		
		Если СвойстваДокумента.ОдинФайл Тогда
			ВыбратьОдинФайлДокумента(Форма, ОповещениеОЗавершении, ВидДокумента);
		Иначе
			ДобавитьФайлыСПредпросмотром(Форма, ОповещениеОЗавершении, ВидДокумента);
		КонецЕсли;
		
	ИначеЕсли Действие = "Файл" Тогда
		
		Если СвойстваДокумента.ОдинФайл Тогда
			ОткрытьФайлДанногоВида(Форма, ВидДокумента);
		Иначе
			ДобавитьФайлыСПредпросмотром(Форма, ОповещениеОЗавершении, ВидДокумента);
		КонецЕсли;
		
	ИначеЕсли Действие = "Отсканируйте" Тогда
		
		СканироватьФайл(Форма, ОповещениеОЗавершении, ВидДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоверенностьОбработкаНавигационнойСсылки(Форма, Элемент, Действие, СтандартнаяОбработка, ОповещениеОЗавершении = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ОсобаяОбработка  = ОбработкаЗаявленийАбонентаКлиентСервер.ОткрытьФормуДобавленияМЧДИлиСкана(Форма, НСтр("ru = 'Доверенность';
																											|en = 'Доверенность'"));
	ТолькоСкан       = НЕ ОсобаяОбработка;
	ЕстьДоверенность = ОбработкаЗаявленийАбонентаКлиентСервер.ЕстьДоверенностьСредиФайлов(Форма);
	ИспользоватьСуществующий = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(Форма);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Действие", Действие);
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	НадоПредупредить = 
		ТолькоСкан 
		И ИспользоватьСуществующий 
		И НЕ ЕстьДоверенность;
	
	Если НадоПредупредить Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыборДоверенности_ПослеПредупреждения", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		Текст = НСтр("ru = 'Поскольку вы планируете использовать сертификат сотрудника, содержащий реквизиты организации, в соответствии с ФЗ от 27.12.2019 N 476-ФЗ, для подтверждения полномочий необходимо приложить скан-копию доверенности';
					|en = 'Поскольку вы планируете использовать сертификат сотрудника, содержащий реквизиты организации, в соответствии с ФЗ от 27.12.2019 N 476-ФЗ, для подтверждения полномочий необходимо приложить скан-копию доверенности'");
		ПоказатьПредупреждение(ОписаниеОповещения, Текст);
		
	Иначе
		
		ВыборДоверенности_ПослеПредупреждения(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ВыборДоверенности_ПослеПредупреждения(ВходящийКонтекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ВыполнитьДействиеСФайлом(
		ВходящийКонтекст.Форма, 
		ВходящийКонтекст.ОповещениеОЗавершении, 
		ВходящийКонтекст.Элемент, 
		ВходящийКонтекст.Действие, 
		СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДобавленияДоверенности(Форма, ОповещениеОЗавершении) Экспорт
	
	ПараметрыФормы = 
		"ФайлыДокументов,
		|Организация,
		|ЗапретитьИзменение,
		|КрасныйЦвет,
		|СканированиеДоступно,
		|МаксимальныйРазмерФайла,
		|ДопустимыеТипыФайлов,
		|ВладелецЭЦПЭтоФизЛицо,
		|ВладелецЭЦП,
		|ВладелецЭЦПИНН,
		|ВладелецЭЦПСНИЛС,
		|ВладелецЭЦПТип,
		|ВладелецЭЦПФамилия,
		|ВладелецЭЦПИмя,
		|ВладелецЭЦПОтчество,
		|ЭтоОткрытиеСВыбраннойЭЦП,
		|СпособПолученияСертификата,
		|ЭтоЮридическоеЛицо,
		|ЭтоБыстрыйСтарт,
		|ЕстьПредыдущиеУчетныеЗаписи,
		|ВключаемыйСертификат,
		|ЗПЭД";
	
	ПараметрыФормы = ПараметрыФормы + "," + МультирежимКлиентСервер.ФлагиНаправлений();
	
	ДополнительныеПараметры = Новый Структура(ПараметрыФормы);
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, Форма, ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	ЭтоПолучениеНового = ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоПолучениеНовогоСертификата(Форма);
	ДополнительныеПараметры.Вставить("ЭтоПолучениеНовогоСертификата", ЭтоПолучениеНового);
	
	Используется = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользуетсяСертификатФЛ(Форма);
	ДополнительныеПараметры.Вставить("ИспользуетсяСертификатФЛ", Используется);
	
	ЕстьВыборМеждуМЧДиСканом = ОбработкаЗаявленийАбонентаКлиентСервер.ЕстьВыборМеждуМЧДиСканом(Форма);
	ДополнительныеПараметры.Вставить("ЕстьВыборМеждуМЧДиСканом", ЕстьВыборМеждуМЧДиСканом);
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ПараметрыОповещения.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавлениеДоверенности_ПослеВыбораДоверенности", 
		ЭтотОбъект,
		ПараметрыОповещения);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_Доверенности", ДополнительныеПараметры,,,,,ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДобавлениеДоверенности_ПослеВыбораДоверенности(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ВходящийКонтекст.Форма;
	
	ПараметрыФормы = Результат.ПараметрыФормы;
	ЗаполнитьЗначенияСвойств(Форма, Результат, ПараметрыФормы, "ПараметрыФормы");
	
	Если Результат.Модифицированность Тогда
		ОбработкаЗаявленийАбонентаКлиентСервер.ИзменитьОформлениеДокументов(Форма);
	Конецесли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОдинФайлДокумента(Форма, ОповещениеОЗавершении, ВидДокумента)
	
	ДополнительныеПараметры = ПараметрыПроцедурыВыбораФайлов(Форма, ВидДокумента);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыбратьОдинФайлДокумента_ПослеПомещения", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	НачатьПомещениеФайла(ОписаниеОповещения,,, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлДанногоВида(Форма, ВидДокумента)

	ФайлыСканов = Новый Массив;
	Для каждого ФайлДокумента Из Форма.ФайлыДокументов Цикл
	
		ФайлДокумента = ФайлДокумента.Значение;
		Если ФайлДокумента.Документ = ВидДокумента Тогда
			ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(ФайлДокумента.Адрес, ФайлДокумента.ИсходноеИмя);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПараметрыПроцедурыВыбораФайлов(Форма, ВидДокумента = "", ЗаголовокФормыПредпросмотра = "") Экспорт
	
	Требования = ОбработкаЗаявленийАбонентаКлиентСервер.ТребованияВложениямЗаявления();
	
	ПараметрыФункции = ОперацииСФайламиЭДКОКлиент.ПараметрыМетодаДобавитьФайлыСПредпросмотром();
	ПараметрыФункции.Вставить("ВидДокумента",        ВидДокумента);
	ПараметрыФункции.Вставить("ФайлыСканов",         ФайлыДляПредпросмотра(Форма, ВидДокумента));
	ПараметрыФункции.Вставить("Требования",          Требования);
	ПараметрыФункции.Вставить("РежимТолькоПросмотр", Форма.ЗапретитьИзменение);
	ПараметрыФункции.Вставить("Документ",            ЗаголовокФормыПредпросмотра);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыФункции, Требования, Истина);
	
	Возврат ПараметрыФункции;
	
КонецФункции

&НаКлиенте
Функция ФайлыДляПредпросмотра(Форма, ВидДокумента)

	ФайлыСканов = Новый Массив;
	Для каждого ФайлДокумента Из Форма.ФайлыДокументов Цикл
		
		ФайлДокумента = ФайлДокумента.Значение;
		Если ФайлДокумента.Документ = ВидДокумента Тогда
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("Адрес", 		ФайлДокумента.Адрес);
			ПараметрыФайла.Вставить("ИсходноеИмя", 	ФайлДокумента.ИсходноеИмя);
			ФайлыСканов.Добавить(ПараметрыФайла);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ФайлыСканов;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьОдинФайлДокумента_ПослеПомещения(Результат, Адрес, ВыбранноеИмяФайла, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ОписаниеФайла = Новый Структура();
	ОписаниеФайла.Вставить("Имя",    ВыбранноеИмяФайла);
	ОписаниеФайла.Вставить("Адрес",  Адрес);
	ОписаниеФайла.Вставить("Размер", 0);
	
	ОписаниеФайлов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеФайла);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыбратьОдинФайлДокумента_ПослеОбработки", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	Требования = ОбработкаЗаявленийАбонентаКлиентСервер.ТребованияВложениямЗаявления();
	
	ОперацииСФайламиЭДКОКлиент.ОбработатьКартинки(
		ОписаниеОповещения, 
		ОписаниеФайлов, 
		Требования, 
		ВходящийКонтекст.Форма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьОдинФайлДокумента_ПослеОбработки(Результат, ВходящийКонтекст) Экспорт	
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	Форма = ВходящийКонтекст.Форма;
	ВидДокумента = ВходящийКонтекст.ВидДокумента;
	
	Для каждого ОписаниеФайла Из Результат.ОписанияФайлов Цикл
	    Имя   = ОписаниеФайла.Имя;
		Адрес = ОписаниеФайла.Адрес;
	КонецЦикла;
	
	ФайлыДокумента = ОбработкаЗаявленийАбонентаКлиентСервер.ОписаниеФайла(Имя, Адрес);
	ТекстОшибки    = ОперацииСФайламиЭДКОСлужебныйКлиент.ТекстОшибкиДобавленияОдногоФайла(
		ФайлыДокумента, 
		Форма.МаксимальныйРазмерФайла, 
		Форма.ДопустимыеТипыФайлов);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(,ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОбработкаЗаявленийАбонентаКлиентСервер.ПослеДобавленияСкана(Форма, ВидДокумента, ФайлыДокумента);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыСПредпросмотром(Форма, ОповещениеОЗавершении, ВидДокумента)

	Описание         = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма)[ВидДокумента];
	ПараметрыФункции = ПараметрыПроцедурыВыбораФайлов(Форма, ВидДокумента, Описание.Представление);
	
	ФайлыСканов = Новый Массив;
	Для каждого ФайлДокумента Из Форма.ФайлыДокументов Цикл
		
		ФайлДокумента = ФайлДокумента.Значение;
		Если ФайлДокумента.Документ = ВидДокумента Тогда
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("Адрес", 		ФайлДокумента.Адрес);
			ПараметрыФайла.Вставить("ИсходноеИмя", 	ФайлДокумента.ИсходноеИмя);
			ФайлыСканов.Добавить(ПараметрыФайла);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыФункции.Вставить("Файлы", ФайлыСканов);
	
	ПредставлениеРазмераФайла = ОбщегоНазначенияЭДКОКлиентСервер.ТекстовоеПредставлениеРазмераФайла(Форма.МаксимальныйРазмерФайла);
	Размер = СтрШаблон("Не более %1", ПредставлениеРазмераФайла);
	
	Требования = Новый Структура;
	Требования.Вставить("Формат", 		СтрСоединить(СтрРазделить(ВРег(Форма.ДопустимыеТипыФайлов), ";"), ", "));
	Требования.Вставить("Разрешение", 	"150-400 dpi");
	Требования.Вставить("Цветность", 	"Цветное изображение, глубина цвета 16-24 бит");
	Требования.Вставить("Размер", 		Размер);
	
	ПараметрыФункции.Требования.Вставить("Требования",     Требования);
	ПараметрыФункции.Требования.Вставить("КлючТребований", "Заявление на подключение к 1С-Отчетности");
	ПараметрыФункции.Вставить("РежимТолькоПросмотр", Форма.ЗапретитьИзменение);
	ПараметрыФункции.Вставить("Документ", Описание.Представление);
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыФункции);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"ДобавитьФайлыСПредпросмотромПослеВыполнения", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	ОперацииСФайламиЭДКОКлиент.ДобавитьФайлыСПредпросмотром(
		Оповещение, 
		УникальныйИдентификатор, 
		СтрШаблон(НСтр("ru = 'Выберите файлы документа <%1> ';
						|en = 'Выберите файлы документа <%1> '"), Описание.Представление), 
		ПараметрыФункции);
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыСПредпросмотромПослеВыполнения(Результат, ВходящийКонтекст) Экспорт
	
	Форма = ВходящийКонтекст.Форма;
	ВидДокумента = ВходящийКонтекст.ВидДокумента;
	
	Если Форма.ЗапретитьИзменение Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	Если Результат.Выполнено Тогда
		ОбработкаЗаявленийАбонентаКлиентСервер.ПослеДобавленияСкана(Форма, ВидДокумента, Результат.Файлы);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура СканироватьФайл(Форма, ОповещениеОЗавершении, ВидДокумента)
	
	Если Форма.СканированиеДоступно Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("ВидДокумента", ВидДокумента);
		ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		
		Форма.СохранитьЗаявление();
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СканироватьФайл_Завершение", 
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		РаботаСФайламиКлиент.ДобавитьФайл(
			ОписаниеОповещения,
			Форма.ДокументЗаявление.Ссылка,
			ЭтотОбъект,
			3,
			Истина);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СканироватьФайл_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат <> Неопределено И Результат.ФайлДобавлен Тогда
		ДобавитьОтсканированныеФайлы(Результат.ФайлСсылка, ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеФайла(ПрисоединенныйФайл)
	
	ДополнительныеПараметры = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ДополнительныеПараметры.ИдентификаторФормы 				= УникальныйИдентификатор;
	ДополнительныеПараметры.ПолучатьСсылкуНаДвоичныеДанные 	= Истина;
	
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ДополнительныеПараметры);
	Возврат ДанныеФайла;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьОтсканированныеФайлы(ПрисоединенныйФайл, ВходящийКонтекст)
	
	ДанныеФайла = ДанныеФайла(ПрисоединенныйФайл);
	
	ОписаниеФайла = Новый Структура();
	ОписаниеФайла.Вставить("Имя",    ДанныеФайла.ИмяФайла);
	ОписаниеФайла.Вставить("Адрес",  ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	ОписаниеФайла.Вставить("Размер", 0);
	
	ОписаниеФайлов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеФайла);	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавитьОтсканированныеФайлы_ПослеОбработки", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	Требования = ОбработкаЗаявленийАбонентаКлиентСервер.ТребованияВложениямЗаявления();
	
	ОперацииСФайламиЭДКОКлиент.ОбработатьКартинки(
		ОписаниеОповещения, 
		ОписаниеФайлов, 
		Требования,
		ВходящийКонтекст.Форма.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОтсканированныеФайлы_ПослеОбработки(Результат, ВходящийКонтекст) Экспорт
	
	Форма = ВходящийКонтекст.Форма;
	ВидДокумента = ВходящийКонтекст.ВидДокумента;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	Для каждого ОписаниеФайла Из Результат.ОписанияФайлов Цикл
		Адрес = ОписаниеФайла.Адрес;
		Имя   = ОписаниеФайла.Имя;
	КонецЦикла;
	
	Расширение = ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(Имя);
	
	НовоеИмя = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма)[ВидДокумента].Представление + "." + Расширение;
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("Адрес", 		Адрес);
	ОписаниеФайла.Вставить("ИсходноеИмя", 	НовоеИмя);
	ОписаниеФайла.Вставить("Имя", 			НовоеИмя);
	
	ОписанияФайлов = Новый Массив;
	ОписанияФайлов.Добавить(ОписаниеФайла);
	
	ОписанияФайлов = ОперацииСФайламиЭДКОСлужебныйВызовСервера.ДополнитьОписанияРазмерамиФайлов(ОписанияФайлов);
	
	ОбработкаЗаявленийАбонентаКлиентСервер.УдалитьТекущийВидДокументов(Форма, ВидДокумента);
	ОбработкаЗаявленийАбонентаКлиентСервер.ДополнитьФайлыВидомДокумента(ОписанияФайлов, ВидДокумента, Форма);
	ОбработкаЗаявленийАбонентаКлиентСервер.ИзменитьОформлениеДокументов(Форма);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСканНажатие(Форма, Элемент) Экспорт
	
	ВидДокумента = Сред(Элемент.Имя, 15);
	ОбработкаЗаявленийАбонентаКлиентСервер.ОчиститьФайл(Форма, ВидДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеОбработкаНавигационнойСсылки(Форма, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка  = Ложь;
	
	ЗаголовокВыбораФайлов = НСтр("ru = 'Выберите скан-копии в заявление по 1С-Отчетности';
								|en = 'Выберите скан-копии в заявление по 1С-Отчетности'");
	ДопПараметры          = ПараметрыПроцедурыВыбораФайлов(Форма);
	ОписаниеОповещения    = Новый ОписаниеОповещения(
		"ВыбратьВсеОбработкаНавигационнойСсылки_ПослеВыбораФайлов", 
		ЭтотОбъект,
		Форма);
		
	ОперацииСФайламиЭДКОКлиент.ДобавитьФайлы(ОписаниеОповещения, Форма.УникальныйИдентификатор, ЗаголовокВыбораФайлов, ДопПараметры, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеОбработкаНавигационнойСсылки_ПослеВыбораФайлов(Результат, Форма) Экспорт 
 
	Если Результат.Выполнено И Результат.ОписанияФайлов.Количество() > 0 Тогда
		
		ВидыДокументов = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма);
		Сканы = Результат.ОписанияФайлов;
		
		Если Форма.ВладелецЭЦПЭтоФизЛицо Тогда
			МЧД = ОбработкаЗаявленийАбонентаКлиентСервер.ИзвлечьМЧДИзФайлов(Форма);
			ВидыДокументов.Удалить("Доверенность");
		КонецЕсли;
		
		Для каждого ФайлыДокумента Из Форма.ФайлыДокументов Цикл
			
			Значение = ФайлыДокумента.Значение;
			
			Скан = Новый Структура;
			Скан.Вставить("Размер", 	Значение.Размер);
			Скан.Вставить("Адрес", 		Значение.Адрес);
			Скан.Вставить("Имя", 		Значение.ИсходноеИмя);
			Скан.Вставить("Документ", 	ВидыДокументов[Значение.Документ].Представление);
			
			Сканы.Добавить(Скан);
		
		КонецЦикла; 
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("Форма", Форма);
		ПараметрыОповещения.Вставить("МЧД", МЧД);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыбратьВсеОбработкаНавигационнойСсылки_ПослеУказанияВидаДокументов", 
			ЭтотОбъект,
			ПараметрыОповещения);
			
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Сканы", Результат.ОписанияФайлов);
		ПараметрыОткрытия.Вставить("ВидыДокументов", ВидыДокументов);
			
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаГрупповогоДобавленияСкановВЗаявление", ПараметрыОткрытия,,,,,ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеОбработкаНавигационнойСсылки_ПослеУказанияВидаДокументов(Результат, ВходящийКонтекст) Экспорт
	
	Форма = ВходящийКонтекст.Форма;
	
	Если Форма.ЗапретитьИзменение Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
		
		ОбработкаЗаявленийАбонентаКлиентСервер.УстановитьМодифицированность(Форма);
		
		Форма.ФайлыДокументов.Очистить();
		Для каждого Скан Из Результат Цикл
			Форма.ФайлыДокументов.Добавить(Скан, Скан.Документ);
		КонецЦикла;
		
		Если Форма.ВладелецЭЦПЭтоФизЛицо Тогда
			
			ОбработкаЗаявленийАбонентаКлиентСервер.ВернутьМЧДВФайлы(
				Форма, 
				ВходящийКонтекст.МЧД);
				
		КонецЕсли;
		
		ОбработкаЗаявленийАбонентаКлиентСервер.ИзменитьОформлениеДокументов(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСканыДокументов(Форма, МастерДалее, ТихийРежим = Ложь) Экспорт
	
	Для Каждого ТекущийВидДокумента Из ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма) Цикл
		
		Описание = ТекущийВидДокумента.Значение;
		
		// Для ИП подтверждения полномочий не существует
		Если НЕ Описание.Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		ВидДокумента = ТекущийВидДокумента.Ключ;
		ПроверитьСканДокумента(Форма, МастерДалее, Описание, ВидДокумента, ТихийРежим);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСканДокумента(Форма, МастерДалее, Описание, ВидДокумента, ТихийРежим = Ложь) Экспорт
	
	ЕстьФайлы = Ложь;
	
	Для Каждого ЭлементСписка Из Форма.ФайлыДокументов Цикл
		ТекущийДокумент = ЭлементСписка.Значение.Документ;
		Если ТекущийДокумент = ВидДокумента Тогда
			ЕстьФайлы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьФайлы Тогда
		
		Если НЕ ТихийРежим Тогда
			
			Если Форма.ВладелецЭЦПЭтоФизЛицо И ВидДокумента = НСтр("ru = 'Доверенность';
																	|en = 'Доверенность'") Тогда
				ТекстОшибки = НСтр("ru = 'Выберите машиночитаемую доверенность';
									|en = 'Выберите машиночитаемую доверенность'");
			Иначе
				ТекстОшибки = НСтр("ru = 'Приложите скан-копию документ ""%1""';
									|en = 'Приложите скан-копию документ ""%1""'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, Описание.Представление);
			КонецЕсли;
			
			Поле = "Указатель" + ВидДокумента;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,Поле);
		КонецЕсли;
			
		МастерДалее = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура НапечататьЗаявлениеНаПодключение(Заявление) Экспорт
	
	ТабДок = ТабличныйДокументЗаявленияНаПодключение(Заявление);
	
	ЗаголовокТабДок = "Заявление на подключение и согласие на обработку ПДн";
	
	НапечататьДокумент(ТабДок, ЗаголовокТабДок);

КонецПроцедуры

&НаСервере
Функция ТабличныйДокументЗаявленияНаПодключение(Заявление) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьЗаявка";
	
	КонтекстЭДОСервер  = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ЭтоЮридическоеЛицо = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоЮрЛицо(Заявление.Организация);
	
	Если Заявление.ВладелецЭЦПЭтоФизЛицо Тогда
		Макет = ПолучитьМакетОбработки("ЗаявлениеФЛ");
	ИначеЕсли ЭтоЮридическоеЛицо Тогда
		Макет = ПолучитьМакетОбработки("ЗаявлениеЮЛ");
	Иначе
		Макет = ПолучитьМакетОбработки("ЗаявлениеИП");
	КонецЕсли;
		
	Область = Макет.ПолучитьОбласть("Заявление");
	Область.Параметры.Заполнить(Заявление);
	
	Если Заявление.ВладелецЭЦПЭтоФизЛицо Тогда
		
		ДобавитьДанныеВладельцаЗаявление(Заявление, Область);
		ДобавитьАдресВладельцаВЗаявление(Заявление, Область);
		
		Если ЗначениеЗаполнено(Заявление.РегламентУЦ) Тогда
			СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Заявление.РегламентУЦ);
			// <схема>://<логин>:<пароль>@<хост>:<порт>/
			Область.Параметры.АдресРегламента = СтруктураURI.Схема + "://" + СтруктураURI.Хост + "/";
		Иначе
			Область.Параметры.АдресРегламента = "https://astral.ru";
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		МакетСогласиеПД = ПолучитьМакетОбработки("СогласиеПД");
		Область = МакетСогласиеПД.ПолучитьОбласть("Согласие");
		
		Область.Параметры.Заполнить(Заявление);
		ДобавитьДанныеВладельцаЗаявление(Заявление, Область);
		ДобавитьАдресВладельцаВЗаявление(Заявление, Область);
		
	ИначеЕсли ЭтоЮридическоеЛицо Тогда
		
		ДобавитьЧастиАдресаВЗаявление(Заявление, Область);
		ДобавитьДанныеРуководителяВЗаявление(Заявление, Область);
		
	Иначе
		
		ДобавитьЧастиАдресаВЗаявление(Заявление, Область);
		ДобавитьДанныеВладельцаЗаявление(Заявление, Область);
		ДобавитьАдресРегистрацииВЗаявление(Заявление, Область);
		
	КонецЕсли;
	
	КонтекстЭДОСервер.РазместитьНаОдномЛисте(ТабДокумент);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
		
КонецФункции

&НаСервере
Процедура ДобавитьАдресВладельцаВЗаявление(Заявление, Область) Экспорт

	Данные = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДанныеИсполнителя(
		Заявление.ВладелецЭЦП, 
		Заявление.Организация);
		
	Если Данные.Свойство("АдресПоПрописке_JSON") Тогда
		Адрес = Данные.АдресПоПрописке_JSON;
	ИначеЕсли Данные.Свойство("АдресМестаПроживания_JSON") Тогда
		Адрес = Данные.АдресМестаПроживания_JSON;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Адрес) Тогда
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Область.Параметры, "АдресРегистрации") Тогда
			Область.Параметры.АдресРегистрации = РаботаСАдресами.СведенияОбАдресе(Адрес).МуниципальноеПредставление;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Область.Параметры, "НаселенныйПункт") Тогда
			Область.Параметры.НаселенныйПункт = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_7(Адрес);
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Область.Параметры, "Улица") Тогда
			Область.Параметры.Улица = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_9(Адрес);
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Область.Параметры, "Область") Тогда
			Область.Параметры.Область = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_8(Адрес);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЧастиАдресаВЗаявление(Заявление, Область) Экспорт
	
	АдресЮридическийЗначение = Заявление.АдресЮридический;
	
	Адрес_Область = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_8(АдресЮридическийЗначение);
	Адрес_Город   = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_7(АдресЮридическийЗначение);
	Адрес_Улица   = ОбработкаЗаявленийАбонента.ПолеСертификата_2_5_4_9(АдресЮридическийЗначение);
	
	Область.Параметры.Область = Адрес_Область;
	Область.Параметры.Город   = Адрес_Город;
	Область.Параметры.Улица   = Адрес_Улица;
	
	ДобавитьАдресУЦВЗаявление(Заявление, Область);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьАдресУЦВЗаявление(Заявление, Область)
	
	Если ЗначениеЗаполнено(Заявление.АдресУЦ) Тогда
		
		ЮрАдресУЦ = НСтр("ru = '(юридический адрес: %1) ';
						|en = '(юридический адрес: %1) '");
		ЮрАдресУЦ = СтрШаблон(ЮрАдресУЦ, Заявление.АдресУЦ);
		
		Область.Параметры.ЮрАдресУЦ = ЮрАдресУЦ;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьАдресРегистрацииВЗаявление(Заявление, Область) Экспорт
	
	Представление = ОбработкаЗаявленийАбонента.ПредставлениеКонтактнойИнформации(Заявление.АдресЮридический);
	
	Область.Параметры.АдресРегистрации = Представление;
			
КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеВладельцаЗаявление(Заявление, Область) Экспорт
	
	ВладелецЭЦПФИО = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ФИОФизЛица(Заявление.ВладелецЭЦП);
	ВладелецЭЦПФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВладелецЭЦПФИО);
	Область.Параметры.ВладелецЭЦПФИО = ВладелецЭЦПФИО;
			
КонецПроцедуры

&НаСервере
Процедура ДобавитьДанныеРуководителяВЗаявление(Заявление, Область) Экспорт
	
	// Руководитель
	Руководитель = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.Руководитель(Заявление.Организация);
	Если ЗначениеЗаполнено(Руководитель) Тогда
		
		ДанныеРуководителя = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДанныеИсполнителя(
			Руководитель, 
			Заявление.Организация);
			
		Если ДанныеРуководителя.Свойство("Должность") Тогда
			ДолжностьРуководителя = ДанныеРуководителя.Должность;
		КонецЕсли;
		
		ФИОРуководителя = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ФИОФизЛица(Руководитель);
		ФамилияИнициалыРуководителя = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИОРуководителя);
		Область.Параметры.ФИОРуководителя = ФамилияИнициалыРуководителя;
		
		ЕстьРеквизит = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Область.Параметры, "РуководительФамилия");
		Если ЕстьРеквизит Тогда
			Область.Параметры.РуководительФамилия = ДанныеРуководителя.ФИО.Фамилия;
			Область.Параметры.РуководительИмя = ДанныеРуководителя.ФИО.Имя;
			Область.Параметры.РуководительОтчество = ДанныеРуководителя.ФИО.Отчество;
		КонецЕсли;

		Область.Параметры.ДолжностьРуководителя = ДолжностьРуководителя;
			
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЗаявлениеПо1СОтчетности(Знач Заявление) Экспорт
	
	Если НЕ ПечатьЗаявленияТребуется(Заявление) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолучитьРеквизит(Заявление, "ЭтоУдаленноеПереизданиеСертификата") Тогда
		
		Адрес = ОбработкаЗаявленийАбонентаВызовСервера.ДанныеЭлДокументаЗаявления(
			Заявление, "ЗаявлениеНаИзготовлениеСертификата");
			
		Если ЭтоАдресВременногоХранилища(Адрес) Тогда
			ОперацииСФайламиЭДКОКлиент.ОткрытьФайл(Адрес, "ЗаявлениеНаИзготовлениеСертификата.pdf");	
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Бланк заявления еще не получен, поскольку запрашивается с сервера АО ""Калуга Астрал"" перед отправкой заявления.';
															|en = 'Бланк заявления еще не получен, поскольку запрашивается с сервера АО ""Калуга Астрал"" перед отправкой заявления.'"));
		КонецЕсли;
		
	Иначе
		НапечататьЗаявлениеНаПодключение(Заявление);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПечатьЗаявленияТребуется(Знач Заявление) Экспорт
	
	Требуется = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Заявление.СпецоператорСвязи) тогда
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не выбран Удостоверяющий центр в документе %1.';
				|en = 'Не выбран Удостоверяющий центр в документе %1.'"), Строка(Заявление));
		
	ИначеЕсли ОбработкаЗаявленийАбонентаВызовСервера.ЭтоРуководитель(Заявление) 
			И НЕ Заявление.ЭтоУдаленноеПереизданиеСертификата Тогда
		
		Текст = НСтр("ru = 'Печать заявления для руководителей не требуется. Заявление оформит специалист при идентификации личности владельца';
					|en = 'Печать заявления для руководителей не требуется. Заявление оформит специалист при идентификации личности владельца'");
		
	ИначеЕсли ОбработкаЗаявленийАбонентаВызовСервера.ЭтоБюджетополучатель(Заявление) Тогда
		
		Текст = НСтр("ru = 'Печать заявления для бюджетополучателей не требуется. Заявление оформляется в Удостоверяющем центре Федеральном казначействе';
					|en = 'Печать заявления для бюджетополучателей не требуется. Заявление оформляется в Удостоверяющем центре Федеральном казначействе'");
		
	ИначеЕсли НЕ ЗаявлениеСвязаноСПолучениемСертификата(Заявление) Тогда
		
		Текст = НСтр("ru = 'Печать заявления не требуется поскольку не было выпуска нового сертификата';
					|en = 'Печать заявления не требуется поскольку не было выпуска нового сертификата'");
		
	Иначе
		
		Требуется = Истина;
		
	КонецЕсли;
	
	Если НЕ Требуется Тогда
		ОбщегоНазначения.СообщитьПользователю(Текст); 
	КонецЕсли;
	
	Возврат Требуется;
	
КонецФункции

&НаСервере
Функция ЗаявлениеСвязаноСПолучениемСертификата(Заявление)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЗаявлениеСвязаноСПолучениемСертификата(Заявление);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьФормуПредупрежденияОбИзменившихсяНастройкахПодключения_ПослеПолученияСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		ДвДанныеСертификата = Неопределено;
	Иначе
		ДвДанныеСертификата = Base64Значение(Результат);
	КонецЕсли;
	
	Организация    = ВходящийКонтекст.Организация;
	ФормаВладельца = ВходящийКонтекст.ФормаВладельца;
	
	СтруктураПараметровОткрытияФормы = Новый Структура();
	СтруктураПараметровОткрытияФормы.Вставить("Организация", Организация);
	СтруктураПараметровОткрытияФормы.Вставить("ДвДанныеСертификата", ДвДанныеСертификата);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьФормуПредупрежденияОбИзменившихсяНастройкахПодключенияЗавершение", 
		ЭтотОбъект, 
		СтруктураПараметровОткрытияФормы);
	
	ВладелецПредупреждения = Неопределено;
	Если ТипЗнч(ФормаВладельца) = Тип("ФормаКлиентскогоПриложения") Тогда
		ВладелецПредупреждения = ФормаВладельца.ВладелецФормы;
	КонецЕсли;
		
	// Вызов окна предупреждения
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.ФормаПредупрежденияОСменеЗначенияПараметраПодключения", 
		СтруктураПараметровОткрытияФормы, 
		ВладелецПредупреждения, 
		Организация,
		,
		,
		ОписаниеОповещения);
	
КонецПроцедуры

#Область ПредупреждениеОНекорректныхСтатусахОтправкиПФР

&НаКлиенте
Процедура ПредупредитьОбОшибкеВСтатусахОтправкиПФР() Экспорт
	
	РезультатАнализа = ТребуетсяПредупредитьОбОшибкеВСтатусахОтправкиПФР();
	
	Если РезультатАнализа.ТребуетсяПредупредить Тогда
		ПоказатьПредупреждениеОНекорректныхСтатусахОтправкиПФР(РезультатАнализа.АдресОтчетов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеОНекорректныхСтатусахОтправкиПФР(Адрес) Экспорт
	
	ПараметрыОткрытияФормы = Новый Структура("Адрес", Адрес);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредупреждениеОНекорректныхСтатусахОтправкиПФР", ПараметрыОткрытияФормы);
	
КонецПроцедуры

&НаСервере
Функция ТребуетсяПредупредитьОбОшибкеВСтатусахОтправкиПФР() Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ТребуетсяПредупредитьОбОшибкеВСтатусахОтправкиПФР();
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПоказатьФормуВыбораТелефонаИПочтыВОблаке(Форма, ВыполняемоеОповещение) Экспорт
	
	ПараметрыФормы = 
		"ЭлектроннаяПочтаДляПаролей,
		|ТелефонМобильныйДляПаролей,
		|ТелефонМобильный,
		|ЭтоПереходВОблако,
		|ЭтоУчетнаяЗаписьВМоделиСервиса,
		|ПолучатьСМСУведомления,
		|ПроверкаТелефонДляПаролей,
		|ПроверкаЭлектроннаяПочтаДляПаролей";
	
	ДополнительныеПараметры = Новый Структура(ПараметрыФормы);
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, Форма, ПараметрыФормы);
	
	ДополнительныеПараметры.Вставить("ПараметрыФормы", ПараметрыФормы);
	
	ПараметрыВызова = Новый Структура();
	ПараметрыВызова.Вставить("Форма", Форма);
	ПараметрыВызова.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПоказатьФормуВыбораТелефонаИПочтыВОблаке_Завершение", 
		ЭтотОбъект,
		ПараметрыВызова);
	
	ОткрытьФорму(
		ПутьКОбъекту + ".Форма.Мастер_НастройкаПолученияВременныхПаролей",
		ДополнительныеПараметры,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПоказатьФормуВыбораТелефонаИПочтыВОблаке_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	Форма = ВходящийКонтекст.Форма;
	
	Если Результат = "Телефон недоступен" ИЛИ Результат = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат); 
		Возврат;
	КонецЕсли;
	
	ОбработкаЗаявленийАбонентаКлиентСервер.УстановитьМодифицированность(Форма);
	
	Если Результат.Свойство("ПроверкаТелефонДляПаролей") 
		И ЗначениеЗаполнено(Результат.ПроверкаТелефонДляПаролей.ИдентификаторПроверки) Тогда
		
		ЗаполнитьЗначенияСвойств(Форма.ПроверкаТелефонДляПаролей, Результат.ПроверкаТелефонДляПаролей);
		Форма.ТелефонМобильныйДляПаролей = Результат.ТелефонМобильныйДляПаролей;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТелефонМобильныйДляПаролейИзменился") Тогда
			Форма.ТелефонМобильныйДляПаролейИзменился = Истина;
		КонецЕсли;
		
		Если Форма.ЭтоПереходВОблако Тогда
		
			Форма.ТелефонМобильный = Результат.ТелефонМобильныйДляПаролей;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТелефонМобильныйИзменился") Тогда
				Форма.ТелефонМобильныйИзменился = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Свойство("ПроверкаЭлектроннаяПочтаДляПаролей") 
		И ЗначениеЗаполнено(Результат.ПроверкаЭлектроннаяПочтаДляПаролей.ИдентификаторПроверки) Тогда
		
		ЗаполнитьЗначенияСвойств(Форма.ПроверкаЭлектроннаяПочтаДляПаролей, Результат.ПроверкаЭлектроннаяПочтаДляПаролей);
		
		Форма.ЭлектроннаяПочтаДляПаролей = Результат.ЭлектроннаяПочтаДляПаролей;
		Форма.ЭлектроннаяПочта = Результат.ЭлектроннаяПочтаДляПаролей;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ЭлектроннаяПочтаДляПаролейИзменилась") Тогда
			Форма.ЭлектроннаяПочтаДляПаролейИзменилась = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Форма.ПолучатьСМСУведомления = Результат.ПолучатьСМСУведомления;
	
	Если ЗначениеЗаполнено(Результат.ТелефонМобильный) И НЕ Форма.ЭтоПереходВОблако Тогда
		
		Телефон = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(Результат.ТелефонМобильный);
		Форма.ТелефонМобильный = СтрШаблон(
			"+7 %1 %2-%3-%4", 
			Сред(Телефон, 2, 3), 
			Сред(Телефон, 5, 3), 
			Сред(Телефон, 8, 2), 
			Сред(Телефон, 10, 2));
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТелефонМобильныйИзменился") Тогда
			ТелефонМобильныйБезРазделителей         = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(Форма.ТелефонМобильный);
			ТелефонМобильныйИсходныйБезРазделителей = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(Форма.ТелефонМобильныйИсходный);
			Форма.ТелефонМобильныйИзменился = ТелефонМобильныйБезРазделителей <> ТелефонМобильныйИсходныйБезРазделителей;
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокВключаемыхСертификатовОблачнойПодписи(МестоХраненияКлюча, ОповещениеОЗавершении)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("МестоХраненияКлюча", МестоХраненияКлюча);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьСписокВключаемыхСертификатовОблачнойПодписи_ПослеВыбора", 
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПараметрыОперации = НовыЙ Структура("ПолноеОписаниеСертификата", Истина);
	МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
	МодульСервисКриптографииDSSКлиент.ВыборСертификата(ОписаниеОповещения, КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча), ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Функция СвойстваВыбранногоОблачногоСертификата(ВыбранныйСертификат)
	
	ДополненныйСертификат = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.ПодготовитьСертификатОблачнойПодписи(ВыбранныйСертификат);
	
	СвойствоВладельца = Новый Соответствие;
	СвойствоВладельца.Вставить("OID2_5_4_3", "ОбщееИмя");
	СвойствоВладельца.Вставить("OID2_5_4_4", "Фамилия");
	СвойствоВладельца.Вставить("OID2_5_4_42", "Имя");
	СвойствоВладельца.Вставить("OID1_2_643_100_3", "СНИЛС");
	СвойствоВладельца.Вставить("OID1_2_643_100_4", "ИННЮЛ");
	СвойствоВладельца.Вставить("OID1_2_643_3_131_1_1", "ИНН");
	СвойствоВладельца.Вставить("OID2_5_4_8", "КодРегиона");
	СвойствоВладельца.Вставить("OID1_2_643_100_5", "ОГРН");
	СвойствоВладельца.Вставить("OID1_2_643_100_1", "ОГРН");
	СвойствоВладельца.Вставить("OID2_5_4_12", "Должность");
	
	СертификатОблака = Новый Структура;
	СертификатОблака.Вставить("Отпечаток", ДополненныйСертификат.Отпечаток);
	СертификатОблака.Вставить("СерийныйНомер", ДополненныйСертификат.СерийныйНомер);
	СертификатОблака.Вставить("Издатель", ДополненныйСертификат.Издатель);
	СертификатОблака.Вставить("ДействителенС", ДополненныйСертификат.ДатаНачала);
	СертификатОблака.Вставить("ДействителенПо", ДополненныйСертификат.ДатаОкончания);
	СертификатОблака.Вставить("Base64", Base64Строка(ВыбранныйСертификат.Сертификат));
	СертификатОблака.Вставить("ПоставщикСтруктура", ДополненныйСертификат.Издатель);
	СертификатОблака.Вставить("Субъект", ДополненныйСертификат.Субъект);
	СертификатОблака.Вставить("Наименование", ДополненныйСертификат.Наименование);
	
	СертификатОблака.Вставить("ФИО", "");
	СертификатОблака.Вставить("Должность", "");
	СертификатОблака.Вставить("ИНН", "");
	СертификатОблака.Вставить("ОГРН", "");
	СертификатОблака.Вставить("КодРегиона", "");
	СертификатОблака.Вставить("СНИЛС", "");

	Для Каждого СтрокаКлюча Из СвойствоВладельца Цикл
		
		ТекущееЗначение = ?(ВыбранныйСертификат.Субъект.Свойство(СтрокаКлюча.Ключ), ВыбранныйСертификат.Субъект[СтрокаКлюча.Ключ], Неопределено);
		
		Если НЕ ЗначениеЗаполнено(ТекущееЗначение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаКлюча.Значение = "Имя" Тогда
			СертификатОблака.ФИО = СертификатОблака.ФИО + " " + ТекущееЗначение;
		ИначеЕсли СтрокаКлюча.Значение = "Фамилия" Тогда
			СертификатОблака.ФИО = ТекущееЗначение + СертификатОблака.ФИО;
		ИначеЕсли СтрокаКлюча.Значение = "ИННЮЛ" Тогда
			СертификатОблака.ИНН = ТекущееЗначение;
		ИначеЕсли СтрокаКлюча.Значение = "ИНН" И НЕ ЗначениеЗаполнено(СертификатОблака.ИНН) Тогда
			СертификатОблака.ИНН = ТекущееЗначение;
		Иначе
			СертификатОблака.Вставить(СтрокаКлюча.Значение, ТекущееЗначение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СертификатОблака;
			
КонецФункции

&НаКлиенте
Процедура ОткрытьСписокВключаемыхСертификатовОблачнойПодписи_ПослеВыбора(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	ОповещениеОЗавершении = ПараметрыЦикла.ОповещениеОЗавершении;
	МестоХраненияКлюча = ПараметрыЦикла.МестоХраненияКлюча;
	Результат = Неопределено;
	
	Если РезультатВыбора.Выполнено Тогда
		ВключаемыйСертификат = СвойстваВыбранногоОблачногоСертификата(РезультатВыбора.Результат.ДанныеСертификата);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ВключаемыйСертификат);
		Результат = Новый Структура();
		Результат.Вставить("ВключаемыйСертификат", ВключаемыйСертификат);
		Результат.Вставить("ВключаемыйСертификатОблачный", Ложь);
		Результат.Вставить("ЭтоСертификатДругогоУЦ", НЕ ЭтоСертификатКалуги(Результат.ВключаемыйСертификат));
		Результат.Вставить("МестоХраненияКлюча", МестоХраненияКлюча);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	
КонецПроцедуры

