	КонецЕсли;
	
	ОбработатьОбновлениеНастройкаФТС(
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
		ЭтоНоваяУчетнаяЗапись, 
		ОбъектНоваяУчетнаяЗапись, 
		ВременныйКаталог, 
		ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФТС(
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
		ЭтоНоваяУчетнаяЗапись, 
		НоваяУчетнаяЗапись, 
		ВременныйКаталог, 
		ВыполняемоеОповещение)
	
	// производим настройку параметров ФТС
	Если СтруктураАвтонастройкиФТС <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
		
		ФлагАвтозаполнения = СтруктураАвтонастройкиФТС.ФлагАвтозаполнения;
		Если СтруктураАвтонастройкиФТС.ФлагСообщения И ВыводитьСообщения Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = СтрШаблон(НСтр("ru = 'Произвести автоматическую настройку параметров отправки в ФТС для организации %1?';
									|en = 'Произвести автоматическую настройку параметров отправки в ФТС для организации %1?'"), ПараметрыФункции.Организация);
			
			ДополнительныеПараметры = Новый Структура("ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись", ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОбновлениеНастройкаФТСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0, КодВозвратаДиалога.Нет, "Предупреждение");
			
		Иначе
			
			Если ФлагАвтозаполнения Тогда
				ОбновитьРегистрыСведенийНастройкиОбменаФТС(
					ПараметрыФункции.Организация,
					СтруктураАвтонастройкиФТС.ОтпечатокСертификата,
					ВыводитьСообщения,
					СтруктураАвтонастройкиФТС.Логин,
					СтруктураАвтонастройкиФТС.Пароль,
					СтруктураАвтонастройкиФТС.МЧД);
			КонецЕсли;
			
			ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФТСЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ОбъектНоваяУчетнаяЗапись = ДополнительныеПараметры.НоваяУчетнаяЗапись;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ФлагАвтозаполнения = СтруктураАвтонастройкиФТС.ФлагАвтозаполнения;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ФлагАвтозаполнения = Ложь;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаФТС(
			ПараметрыФункции.Организация,
			СтруктураАвтонастройкиФТС.ОтпечатокСертификата,
			ВыводитьСообщения,
			СтруктураАвтонастройкиФТС.Логин,
			СтруктураАвтонастройкиФТС.Пароль,
			СтруктураАвтонастройкиФТС.МЧД);
	КонецЕсли;
	
	ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, ОбъектНоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВернутьРезультат(ЭтоНоваяУчетнаяЗапись, ПараметрыФункции, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение)
	
	// при необходимости, показываем форму установки прав доступа для учетной записи
	Если ЭтоНоваяУчетнаяЗапись 
		И (ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча <> Неопределено ИЛИ ПараметрыФункции.ВызовИзМастераАвтонастройки) 
		И НЕ ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности Тогда
		
		ПараметрыФормы = Новый Структура("НоваяУчетнаяЗапись, Организация");
		ПараметрыФормы.НоваяУчетнаяЗапись 	= НоваяУчетнаяЗапись;
		ПараметрыФормы.Организация 			= ПараметрыФункции.Организация;
		
		ДополнительныеПараметры = Новый Структура(
			"ВременныйКаталог, ПараметрыФункции, ВыполняемоеОповещение", 
			ВременныйКаталог, 
			ПараметрыФункции, 
			ВыполняемоеОповещение);
			
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбработатьОбновлениеВернутьРезультатЗавершение", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ФормаУстановкиПравДоступа", 
			ПараметрыФормы,
			,
			,
			,
			,
			ОписаниеОповещения,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	Иначе
		
		Результат = Истина;
		
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура(
			"ПараметрыФункции, РезультатОбновления", 
			ПараметрыФункции, 
			Результат);
			
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВернутьРезультатЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
	
	РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Истина);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
	
КонецПроцедуры

&НаКлиенте
Функция РегистрацияПолучитьДанныеССервераКлиент(
		ПараметрыФункции,
		ПовторятьСоединение = Ложь,
		ОбновленыПодписиСертификатовДокументооборота = Ложь) Экспорт
	
	Возврат РегистрацияПолучитьДанныеССервера(
		ПараметрыФункции,
		ПовторятьСоединение,
		ОбновленыПодписиСертификатовДокументооборота);
	
КонецФункции

&НаСервере
Функция РегистрацияПолучитьДанныеССервера(
		ПараметрыФункции,
		ПовторятьСоединение = Ложь,
		ОбновленыПодписиСертификатовДокументооборота = Ложь)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.РегистрацияПолучитьДанныеССервера(
		ПараметрыФункции,
		ПовторятьСоединение,
		Сертификаты,
		ОбновленыПодписиСертификатовДокументооборота);
	
КонецФункции

&НаСервере
Функция РегистрацияОбновитьСправочники(ПараметрыФункции)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ПараметрыФункции.НоваяУчетнаяЗапись = НоваяУчетнаяЗапись;
	
	Результат = КонтекстЭДОСервер.РегистрацияОбновитьСправочники(ПараметрыФункции);
		
	Если Результат Тогда
		Если ЗначениеЗаполнено(ПараметрыФункции.НоваяУчетнаяЗапись) Тогда
			НоваяУчетнаяЗапись = ПараметрыФункции.НоваяУчетнаяЗапись;
		КонецЕсли;
		
		ДокументDOM = РегФайлКА.ДокументDOMПоАдресу(ПараметрыФункции.ВременныйФайлОбновленийАдрес);
		КонтекстЭДОСервер.ОбновитьВсеСертификатыВУчетнойЗаписиДО(ДокументDOM, Сертификаты, ПараметрыФункции);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РегистрацияУстановитьСертификаты(ПараметрыФункции, ВыполняемоеОповещение)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		
		РезультатВыполнения = РегистрацияУстановитьСертификатыНаСервере(ПараметрыФункции.ОтпечатокСертификата);
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", РезультатВыполнения, ПараметрыФункции);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		
		УстановитьСертификатыПолучателей(ПараметрыФункции, ВыполняемоеОповещение);
		
	Иначе
		ПараметрыЦикла = Новый Структура;
		ПараметрыЦикла.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ПараметрыЦикла.Вставить("ПараметрыФункции", ПараметрыФункции);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьСертификатыЛокально", ЭтотОбъект, ПараметрыЦикла);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыПослеПоискаСертификатовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	
	Если НЕ Результат.Выполнено Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаПоискаСертификатовПередУстановкой", ИзвлечьОписаниеПричиныОшибки(Результат));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	МассивСертификатов = Результат.Сертификаты;
	
	ВременныйКаталог = ПараметрыФункции.ВременныйКаталог;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, 0);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатЗаписиСертификатаВФайл = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатЗаписиСертификатаВФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение(РезультатЗаписиСертификатаВФайл, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	МассивСертификатов = ДополнительныеПараметры.МассивСертификатов;
	НомерСертификата = ДополнительныеПараметры.НомерСертификата;
	
	Если НЕ РезультатЗаписиСертификатаВФайл.Выполнено Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаЗаписиСертификатаВФайл", ИзвлечьОписаниеПричиныОшибки(РезультатЗаписиСертификатаВФайл));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Пока НомерСертификата < Сертификаты.Количество() Цикл
		
		Сертификат = Сертификаты[НомерСертификата];
		НомерСертификата = НомерСертификата + 1;
		
		Если Сертификат.ЭтоЧужойСертификат Тогда
			Продолжить;
		КонецЕсли;
		
		СертификатНайден = Ложь;
		Для каждого НайденныйСертификат Из МассивСертификатов Цикл
			Если нрег(СокрЛП(НайденныйСертификат.Отпечаток)) = нрег(СокрЛП(Сертификат.Отпечаток)) Тогда
				СертификатНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		Если НЕ СертификатНайден Тогда
			Сертификат.ТребуетсяУстановить = Истина;
			ПутьКФайлуСерта = ВременныйКаталог + Сертификат.Отпечаток + ".cer";
			ТелоСертификата = Сертификат.Тело;
			Если СтрНайти(ТелоСертификата, "BEGIN CERTIFICATE") = 0 Тогда
				ТелоСертификата = "-----BEGIN CERTIFICATE-----" + символы.ПС
								+ ТелоСертификата + символы.ПС
								+ "-----END CERTIFICATE-----";
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, МассивСертификатов, НомерСертификата);
			Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыЗаписьСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТелоСертификата, ПутьКФайлуСерта);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыводитьСообщения = ПараметрыФункции.РежимАвтонастройки И НЕ ПараметрыФункции.ТихийРежим;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, 0);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатУстановкиСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Истина, Неопределено);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатУстановкиСертификата);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение(РезультатУстановкиСертификата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции      = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог      = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения     = ДополнительныеПараметры.ВыводитьСообщения;
	НомерСертификата      = ДополнительныеПараметры.НомерСертификата;
	
	УстановкаСертификатСАвтоопределениемКриптопровайдера =
		?(ДополнительныеПараметры.Свойство("УстановкаСертификатСАвтоопределениемКриптопровайдера"),
		ДополнительныеПараметры.УстановкаСертификатСАвтоопределениемКриптопровайдера, Ложь);
	ДополнительныеПараметры.Удалить("УстановкаСертификатСАвтоопределениемКриптопровайдера");
	
	Если НЕ РезультатУстановкиСертификата.Выполнено Тогда
		
		Текст = НСтр("ru = 'Не удалось установить личный сертификат (%1)!';
					|en = 'Не удалось установить личный сертификат (%1)!'");
		Текст = СтрШаблон(Текст, ДополнительныеПараметры.Сертификат.Комментарий);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			Текст,
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
			ВыводитьСообщения);
		
		Если УстановкаСертификатСАвтоопределениемКриптопровайдера Тогда
			
			Результат = Новый Структура();
			Результат.Вставить("РезультатВыполнения",               Ложь);
			Результат.Вставить("ПараметрыФункции",                  ПараметрыФункции);
			Результат.Вставить("ОшибкаУстановкиЛичногоСертификата", ИзвлечьОписаниеПричиныОшибки(РезультатУстановкиСертификата));
			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
			
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"УстановитьСертификатВКонтейнерИХранилище_ПослеСозданияМенеджераКриптографии",
				ЭтотОбъект,
				ДополнительныеПараметры);
			РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии", Ложь, Неопределено);
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатВыполнения);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Пока НомерСертификата < Сертификаты.Количество() Цикл
		
		Сертификат       = Сертификаты[НомерСертификата];
		НомерСертификата = НомерСертификата + 1;
		
		Если Сертификат.ТребуетсяУстановить Тогда
		
			Если Сертификат.Хранилище = "MY" Тогда
				Если ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча <> Неопределено И Сертификат.ТипПолучателя = "" Тогда
					
					Если ЗначениеЗаполнено(ПараметрыФункции.ПутьКонтейнерЗакрытогоКлюча) Тогда
						
						ДополнительныеПараметры = Новый Структура();
						ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
						ДополнительныеПараметры.Вставить("ПараметрыФункции",      ПараметрыФункции);
						ДополнительныеПараметры.Вставить("ВременныйКаталог",      ВременныйКаталог);
						ДополнительныеПараметры.Вставить("ВыводитьСообщения",     ВыводитьСообщения);
						ДополнительныеПараметры.Вставить("НомерСертификата",      НомерСертификата);
						ДополнительныеПараметры.Вставить("Сертификат",            Сертификат);

						УстановитьСертификатВКонтейнерИХранилище(ДополнительныеПараметры);
							
						Возврат;
						
					ИначеЕсли ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило(
						"Ош.настр.пустой контейнер") Тогда
						
						ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
							НСтр("ru = 'Не удалось определить путь к контейнеру закрытого ключа!';
								|en = 'Не удалось определить путь к контейнеру закрытого ключа!'"),
							ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
							ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
							ВыводитьСообщения);
							
						Результат = Новый Структура();
						Результат.Вставить("РезультатВыполнения", Ложь);
						Результат.Вставить("ПараметрыФункции",   ПараметрыФункции);
						Результат.Вставить("ОшибкаОпределенияПутиКонтейнера");
						
						ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
						Возврат;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
				ДополнительныеПараметры.Вставить("ПараметрыФункции",      ПараметрыФункции);
				ДополнительныеПараметры.Вставить("ВременныйКаталог",      ВременныйКаталог);
				ДополнительныеПараметры.Вставить("ВыводитьСообщения",     ВыводитьСообщения);
				ДополнительныеПараметры.Вставить("НомерСертификата",      НомерСертификата);
				ДополнительныеПараметры.Вставить("Сертификат",            Сертификат);
				ДополнительныеПараметры.Вставить("СчетчикСертификата",    1);

				Оповещение = Новый ОписаниеОповещения(
					"РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение", 
					ЭтотОбъект, 
					ДополнительныеПараметры);
					
				РезультатИмпортаСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Ложь, РезультатУстановкиСертификата.МенеджерКриптографии);
				
				ВыполнитьОбработкуОповещения(Оповещение, РезультатИмпортаСертификата);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФункции.Вставить("МенеджерКриптографии", РезультатУстановкиСертификата.МенеджерКриптографии);
	Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Истина, ПараметрыФункции);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение(РезультатИмпортаСертификата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	НомерСертификата = ДополнительныеПараметры.НомерСертификата;
	
	Если НЕ ДополнительныеПараметры.Свойство("Сертификат") Тогда
		
		ТекстОшибки = НСтр("ru = 'При автонастройке учетной записи произошла ошибка. Попробуйте повторить операцию. Подробнее в журнале регистраций';
							|en = 'При автонастройке учетной записи произошла ошибка. Попробуйте повторить операцию. Подробнее в журнале регистраций'");
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(ТекстОшибки,
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
			ВыводитьСообщения);
					
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиСертификатаВХранилище", ТекстОшибки);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Сертификат = ДополнительныеПараметры.Сертификат;
	СчетчикСертификата = ДополнительныеПараметры.СчетчикСертификата;
	
	РезультатВыполнения = РезультатИмпортаСертификата.Выполнено;
	Пока СчетчикСертификата < 10 Цикл
		Если РезультатВыполнения Тогда
			Сертификат.Отпечаток = РезультатИмпортаСертификата.СвойстваСертификата.Отпечаток;
			Прервать;
		КонецЕсли;
		
		СчетчикСертификата = СчетчикСертификата + 1;
		
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата, Сертификат, СчетчикСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата, Сертификат, СчетчикСертификата);
		Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыИмпортСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ИмпортироватьСертификат(
			Оповещение,
			ВременныйКаталог + Сертификат.Отпечаток + ".cer",
			Сертификат.Хранилище,
			Ложь,
			?(РезультатВыполнения, РезультатИмпортаСертификата.МенеджерКриптографии, Неопределено));
		Возврат;
	КонецЦикла;
	
	Если ВыводитьСообщения Тогда
		Если НЕ РезультатВыполнения Тогда
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось установить сертификат с отпечатком %1 в хранилище %2';
																																										|en = 'Не удалось установить сертификат с отпечатком %1 в хранилище %2'"), Сертификат.Отпечаток, Сертификат.Хранилище),
					ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности,
					ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности,
					ВыводитьСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РезультатВыполнения Тогда
		Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", Ложь, ПараметрыФункции);
		Результат.Вставить("ОшибкаУстановкиСертификатаВХранилище", ИзвлечьОписаниеПричиныОшибки(РезультатИмпортаСертификата));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата", ВыполняемоеОповещение, ПараметрыФункции, ВременныйКаталог, ВыводитьСообщения, НомерСертификата);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыУстановкаСертификатовВЦиклеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РезультатУстановкиСертификата = Новый Структура("Выполнено, МенеджерКриптографии", Истина, РезультатИмпортаСертификата.МенеджерКриптографии);
	ВыполнитьОбработкуОповещения(Оповещение, РезультатУстановкиСертификата);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанные(
		МестоХраненияКлюча,
		МестоХраненияКлючаНастроек,
		ОтпечатокСертификата,
		ИдентификаторДокументооборота,
		ДанныеУзлаКонфиденциальнаяИнформацияАдрес,
		ВыводитьСообщения,
		ВыполняемоеОповещение)
	
	ПараметрыОперации = Новый Структура;
	
	Сертификат = Новый Структура("Отпечаток", ОтпечатокСертификата);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Сертификат);
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		Сертификат.Вставить("КлючевойКонтейнер", ИдентификаторДокументооборота);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",                     ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес", ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ДанныеДляРасшифровки", 					  ПолучитьИзВременногоХранилища(ДанныеУзлаКонфиденциальнаяИнформацияАдрес));
	ДополнительныеПараметры.Вставить("ВыводитьСообщения",                         ВыводитьСообщения);
	ДополнительныеПараметры.Вставить("ПараметрыОперации",						  ПараметрыОперации);
	ДополнительныеПараметры.Вставить("Сертификат",					  			  Сертификат);
	ДополнительныеПараметры.Вставить("МестоХраненияКлюча",			  			  МестоХраненияКлюча);
	ДополнительныеПараметры.Вставить("МестоХраненияКлючаНастроек",	  			  МестоХраненияКлючаНастроек);

	Если НЕ ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		Оповещение = Новый ОписаниеОповещения(
			"РегистрацияРасшифроватьДанныеОблачнаяПодпись", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, , Сертификат, НЕ ЭтоОблачнаяПодпись(МестоХраненияКлючаНастроек));
	Иначе
		РегистрацияРасшифроватьДанныеПроверитьОблачнуюПодпись(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияРасшифроватьДанныеПослеРасшифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	АдресВоВременномХранилище = ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	Если Результат.Выполнено Тогда
		Если ТипЗнч(Результат.РасшифрованныйФайл) = Тип("ДвоичныеДанные") Тогда
			АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат.РасшифрованныйФайл, Новый УникальныйИдентификатор);
		Иначе
			АдресВоВременномХранилище = Результат.РасшифрованныйФайл;
		КонецЕсли;
	Иначе
		Если ВыводитьСообщения Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка криптографии. Невозможно расшифровать файл обновлений:
                      |%1';
                      |en = 'Ошибка криптографии. Невозможно расшифровать файл обновлений:
                      |%1'"), 
				Результат.ОписаниеОшибки);
					  
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище, МестоХраненияКлюча", Ложь, Неопределено, МестоХраненияКлюча);
		РезультатВыполнения.Вставить("ОписаниеОшибки", Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище, МестоХраненияКлюча", Истина, АдресВоВременномХранилище, МестоХраненияКлюча);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрСпецоператораКлиент(Знач Спецоператор, ПараметрыСтруктура, Макет = Неопределено) Экспорт
	
	КонтекстЭДОСервер      = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ПараметрыСпецоператора = КонтекстЭДОСервер.ПолучитьПараметрыОператораСвязи(Спецоператор);
	ЗаполнитьЗначенияСвойств(ПараметрыСтруктура, ПараметрыСпецоператора);
	Возврат ПараметрыСтруктура;
	
КонецФункции

#Область ОтправкаЗаявлениеНаПодключение

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПоказатьСообщениеОНевозможностиБезбумажногоПродления(ОповещениеОЗавершении, ОписаниеОшибки) Экспорт
	
	Контекст = Новый Структура("ОписаниеОповещения", ОповещениеОЗавершении);
	Оповещение = Новый ОписаниеОповещения("СформироватьИОтправитьПослеОтветаНаВопросОНеобходимостиОбычногоПродления", ЭтотОбъект, Контекст);
	ТекстВопроса = НСтр("ru = 'Продление с использованием электронной подписи невозможно по причине:
                         |%1
                         |
                         |Отправить заявление без подписания?';
                         |en = 'Продление с использованием электронной подписи невозможно по причине:
                         |%1
                         |
                         |Отправить заявление без подписания?'");
	ТекстВопроса = СтрШаблон(ТекстВопроса, ОписаниеОшибки); 
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьПослеОтветаНаВопросОНеобходимостиОбычногоПродления(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИзменитьПризнакБезбумажногоПродления(ВходящийКонтекст.ОписаниеОповещения.ДополнительныеПараметры.ДокументЗаявление.Ссылка);
		ВходящийКонтекст.ОписаниеОповещения.ДополнительныеПараметры.Вставить("ПодписатьМетодомБРО", Ложь);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОписаниеОповещения, Истина);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОписаниеОповещения, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеОтветаНаВопросЭПВОблаке(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		СформироватьИОтправитьЗаявлениеВМоделиСервисов(
			ВходящийКонтекст.ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
	Иначе
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПериодДействияСертификатаКорректный(ДокументЗаявление, ИмяПоляСертификата) Экспорт
	
	Сертификат  = СертификатИзЗаявления(ДокументЗаявление, ИмяПоляСертификата);
	ТекущаяДата = ТекущаяДата();
	
	Даты          = ДатыСертификата(Сертификат);
	МестнаяДатаС  = Даты.ДатаС;
	МестнаяДатаПо = Даты.ДатаПо;
	
	Если МестнаяДатаПо = Неопределено
		ИЛИ МестнаяДатаС = Неопределено Тогда
		
		Возврат Ложь;
		
	ИначеЕсли ТекущаяДата > МестнаяДатаПо Тогда
		
		Возврат Ложь;
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СравнитьРеквизитыСертификатов(Форма, ИмяПоляСертификата, ОбработчикЗавершения) Экспорт
	
	// Сначала проверка периода, потом реквизитов
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОбработчикЗавершения", ОбработчикЗавершения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СравнитьРеквизитыСертификатов_ПослеПолученияОтвета", 
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ДокументЗаявление = Форма.ДокументЗаявление;
	Если НЕ ПериодДействияСертификатаКорректный(ДокументЗаявление, ИмяПоляСертификата) Тогда
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Вернуться к заявлению для исправления", НСтр("ru = 'ОК';
																		|en = 'ОК'"));
		
		ТекстВопроса = НСтр("ru = 'Подписание заявления выбранным сертификатом невозможно по причине:
                             |Срок действия сертификата истек.
                             |
                             |Вернуться к заявлению для исправления?';
                             |en = 'Подписание заявления выбранным сертификатом невозможно по причине:
                             |Срок действия сертификата истек.
                             |
                             |Вернуться к заявлению для исправления?'");
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуСравненияРеквизитов(Форма, ИмяПоляСертификата);
		
	Если ЕстьРазличающиесяРеквизиты(Форма) Тогда
		
		АдресТаблицыСравненияРеквизитов = Форма.АдресТаблицыСравненияРеквизитов();
		СертификатДляПодписания         = СертификатИзЗаявления(ДокументЗаявление, ИмяПоляСертификата);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СертификатДляПодписания",          СертификатДляПодписания);
		ДополнительныеПараметры.Вставить("СпособПолученияСертификата",       ДокументЗаявление.СпособПолученияСертификата);
		ДополнительныеПараметры.Вставить("АдресТаблицыСравненияРеквизитов",  АдресТаблицыСравненияРеквизитов);
		ДополнительныеПараметры.Вставить("ЭтоУдаленноеПереизданиеСертификата", ДокументЗаявление.ЭтоУдаленноеПереизданиеСертификата);
		
		ДополнительныеПараметры.Вставить("ТипЗаявления", ДокументЗаявление.ТипЗаявления);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.Мастер_СравнениеРеквизитовСертификата", 
			ДополнительныеПараметры,
			,
			,
			,
			,
			ОписаниеОповещения);
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Выполнено", Истина);
		
		ВыполнитьОбработкуОповещения(ОбработчикЗавершения, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьРазличающиесяРеквизиты(Форма)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Различается", Истина);
	 
	Возврат Форма.ТаблицаСравненияРеквизитов.НайтиСтроки(Отбор).Количество() > 0;
	
КонецФункции

&НаСервере
Функция СертификатИзЗаявления(ДокументЗаявление, ИмяПоляСертификата)
	
	Возврат ДокументЗаявление.Ссылка[ИмяПоляСертификата].Получить();
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьТаблицуСравненияРеквизитов(Форма, ИмяПоляСертификата)
	
	ДокументЗаявление        = Форма.ДокументЗаявление;
	ЭтоВторичное             = ДокументЗаявление.ТипЗаявления = ПредопределенноеЗначение("Перечисление.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение");
	ИспользоватьСуществующий = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(ДокументЗаявление);
	ЭтоСертификатДругогоУЦ   = ДокументЗаявление.ЭтоСертификатДругогоУЦ;
	ЭтоЮридическоеЛицо       = ДокументЗаявление.ТипОрганизации;
	
	ЭтоСертификатФизЛица = Форма.ВладелецЭЦПЭтоФизЛицо 
		ИЛИ ИспользоватьСуществующий И ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоСертификатФизЛица(Форма.ВключаемыйСертификат);
	
	СравниватьРеквизитыОрганизации = НЕ ЭтоСертификатФизЛица;
	
	// Сертификат, который только планируем издать
	РеквизитыЗаявления = ОбработкаЗаявленийАбонентаКлиент.ПараметрыНовогоСертификата(ДокументЗаявление);
	// Сертификат, которым будем подписывать
	СертификатДляПодписания = СертификатИзЗаявления(ДокументЗаявление, ИмяПоляСертификата);
	
	Таблица = Форма.ТаблицаСравненияРеквизитов;
	Таблица.Очистить();
	
	// Заголовок
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.СтороннийСертификат = НСтр("ru = 'В сертификате';
											|en = 'В сертификате'");
	НоваяСтрока.НовыйСертификат 	= НСтр("ru = 'В заявлении';
											|en = 'В заявлении'");
	НоваяСтрока.ЭтоЗаголовок		= Истина;
	
	// ИНН
	ВладелецВСертификатеДляПодписания = ДокументооборотСКОКлиентСервер.ВладелецСертификат(СертификатДляПодписания);
	
	ИННыИзНовогоСертификата       = ДокументооборотСКОКлиентСервер.ИННыИзСертификата(РеквизитыЗаявления);
	ИННыИзСертификатДляПодписания = ДокументооборотСКОКлиентСервер.ИННыИзСертификата(ВладелецВСертификатеДляПодписания);
	
	Если ЭтоЮридическоеЛицо И СравниватьРеквизитыОрганизации Тогда
		ДобавитьСтрокуВТаблицуСравненияПоЗначениям(
			Таблица,
			НСтр("ru = 'ИНН';
				|en = 'ИНН'"),
			ИННыИзНовогоСертификата.ЮЛ,
			ИННыИзСертификатДляПодписания.ЮЛ);
	КонецЕсли;

	// ОГРН
	Если СравниватьРеквизитыОрганизации
		И НЕ Форма.ЭтоНотариусАдвокатИлиГКФХ Тогда 
		
		Если ЭтоЮридическоеЛицо Тогда
			Представление = НСтр("ru = 'ОГРН';
								|en = 'ОГРН'");
			Имя1 = "1.2.643.100.1";
			Имя2 = "OGRN";
		Иначе
			Представление = НСтр("ru = 'ОГРНИП';
								|en = 'ОГРНИП'");
			Имя1 = "1.2.643.100.5";
			Имя2 = "OGRNIP";
		КонецЕсли;
		
		ДобавитьСтрокуВТаблицуСравнения(
			Таблица,
			Представление,
			РеквизитыЗаявления,
			Имя1,
			СертификатДляПодписания,
			Имя2);

	КонецЕсли;
	
	// Адрес
	СравниватьАдрес = 
		НЕ ЭтоСертификатДругогоУЦ 
		И НЕ Форма.ВладелецЭЦПЭтоФизЛицо;
		
	Если СравниватьАдрес Тогда
		
		ДобавитьСтрокуВТаблицуСравнения(
			Таблица,
			НСтр("ru = 'Страна';
				|en = 'Страна'"),
			РеквизитыЗаявления,
			"2.5.4.6",
			СертификатДляПодписания,
			"C");

	КонецЕсли;
	
	// При удаленном переиздании адрес раздрешено менять
	СравниватьРегион = СравниватьАдрес И ЭтоЮридическоеЛицо И НЕ (ЭтоВторичное И Форма.ЭтоУдаленноеПереизданиеСертификата);
	Если СравниватьРегион Тогда
		
		ДобавитьСтрокуВТаблицуСравнения(
			Таблица,
			НСтр("ru = 'Регион';
				|en = 'Регион'"),
			РеквизитыЗаявления,
			"2.5.4.8",
			СертификатДляПодписания,
			"ST");
			
	КонецЕсли;
	
	// Фамилия
	ДобавитьСтрокуВТаблицуСравнения(
		Таблица,
		НСтр("ru = 'Фамилия владелеца';
			|en = 'Фамилия владелеца'"),
		РеквизитыЗаявления,
		"2.5.4.4",
		СертификатДляПодписания,
		"SN");
		
	// Имя Отчество
	ДобавитьСтрокуВТаблицуСравнения(
		Таблица,
		НСтр("ru = 'Имя Отчество';
			|en = 'Имя Отчество'"),
		РеквизитыЗаявления,
		"2.5.4.42",
		СертификатДляПодписания,
		"GN");
		
	// ИНН Владельца
	Если ЗначениеЗаполнено(ИННыИзСертификатДляПодписания.ФЛ) Тогда
		ДобавитьСтрокуВТаблицуСравненияПоЗначениям(
			Таблица,
			НСтр("ru = 'ИНН владельца сертификата';
				|en = 'ИНН владельца сертификата'"),
			ИННыИзНовогоСертификата.ФЛ,
			ИННыИзСертификатДляПодписания.ФЛ);
	КонецЕсли;
	
	// СНИЛС
	ДобавитьСтрокуВТаблицуСравнения(
		Таблица,
		НСтр("ru = 'СНИЛС';
			|en = 'СНИЛС'"),
		РеквизитыЗаявления,
		"1.2.643.100.3",
		СертификатДляПодписания,
		"SNILS");
	
КонецФункции

&НаКлиенте
Функция РеквизитСертификата(Сертификат, Реквизит)
	
	Если Сертификат.Свойство(Реквизит) Тогда
		Значение = Сертификат[Реквизит];
	Иначе
		Значение = "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Процедура СравнитьРеквизитыСертификатов_ПослеПолученияОтвета(Результат, ВходящийКонтекст) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Выполнено", Ложь);
	ДополнительныеПараметры.Вставить("Действие",  Результат);
		
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОбработчикЗавершения, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродление(ОповещениеОЗавершении, ВладелецСертификата) Экспорт
	
	Отпечаток = НРег(СтрЗаменить(ВладелецСертификата.Сертификат.Отпечаток, " ", ""));
	Контекст = Новый Структура("ВладелецСертификата, ОповещениеОЗавершении", ВладелецСертификата, ОповещениеОЗавершении);
	Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеПоискаСертификатовВОблачномХранилище", ЭтотОбъект, Контекст);
	НовыйСертификат = Новый Структура("Отпечаток", Отпечаток);
	КонтекстМоделиХраненияКлюча(Истина, НовыйСертификат);
	КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, НовыйСертификат, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПоискаСертификатовВОблачномХранилище(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		Если Результат.СертификатНайден Тогда
			ВходящийКонтекст.Вставить("Сертификат", Результат.СвойстваСертификата.Сертификат);
			ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	Отпечаток = НРег(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.Сертификат.Отпечаток, " ", ""));
	Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеПоискаСертификатов", ЭтотОбъект, ВходящийКонтекст);
	НовыйСертификат = Новый Структура("Отпечаток", Отпечаток);
	КонтекстМоделиХраненияКлюча(Ложь, НовыйСертификат);
	КриптографияЭДКОКлиент.НайтиСертификат(Оповещение, НовыйСертификат, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПоискаСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		Если Результат.СертификатНайден Тогда
			ВходящийКонтекст.Вставить("Сертификат", Результат.СвойстваСертификата);
			Оповещение = Новый ОписаниеОповещения("ВозможноБезбумажноеПродлениеПослеЭкспортаСертификата", ЭтотОбъект, ВходящийКонтекст);
			КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(Оповещение, ВходящийКонтекст.ВладелецСертификата.Сертификат);
		Иначе
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Новый Структура("Выполнено,ОписаниеОшибки", Ложь, "Сертификат не найден"));
		КонецЕсли;
	Иначе 
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Результат); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеЭкспортаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		ВходящийКонтекст.Вставить("Сертификат", Base64Значение(Результат.СтрокаBase64));
		ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозможноБезбумажноеПродлениеПослеПолученияСертификата(ВходящийКонтекст)
	
	БезбумажноеПродлениеВозможно = Истина;
	Причины = Новый Массив;
	СвойстваСертификата = ПолучитьСвойстваСертификатаДляПроверкиБезбумажногоПродленияНаСервере(ВходящийКонтекст.Сертификат);
	
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	Если СвойстваСертификата.ДатаОкончания < ТекущаяДата Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		Причины.Добавить(НСтр("ru = 'Срок действия сертификата истек';
								|en = 'Срок действия сертификата истек'"));
	КонецЕсли;
	
	СНИЛС = СтрЗаменить(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.СНИЛС, " ", ""), "-", "");
	Если СНИЛС <> СвойстваСертификата.СНИЛС Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'СНИЛС владельца сертификата отличается от значения указанного в сертификате';
								|en = 'СНИЛС владельца сертификата отличается от значения указанного в сертификате'"));
	КонецЕсли;
	
	Если ВходящийКонтекст.ВладелецСертификата.ИНН <> СвойстваСертификата.ИНН Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'ИНН отличается от значения указанного в сертификате';
								|en = 'ИНН отличается от значения указанного в сертификате'"));
	КонецЕсли;
	
	ФИО = ВРег(СтрЗаменить(СтрЗаменить(СтрЗаменить(ВходящийКонтекст.ВладелецСертификата.ФИО, "-", ""), " ", ""), "_", ""));
	ФИОИсходный = ВРег(СтрЗаменить(СтрЗаменить(СтрЗаменить(СвойстваСертификата.ФИО, "-", ""), " ", ""), "_", ""));
	Если ФИО <> ФИОИсходный Тогда
		БезбумажноеПродлениеВозможно = Ложь;
		
		Причины.Добавить(НСтр("ru = 'ФИО владельца сертификата отличается от ФИО указанного в сертификате';
								|en = 'ФИО владельца сертификата отличается от ФИО указанного в сертификате'"));
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("Выполнено", Истина);
	РезультатВыполнения.Вставить("БезбумажноеПродлениеВозможно", БезбумажноеПродлениеВозможно);
	Если Не БезбумажноеПродлениеВозможно Тогда
		РезультатВыполнения.Вставить("Причина", СтрСоединить(Причины, Символы.ПС));	
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСертификатаДляПроверкиБезбумажногоПродленияНаСервере(ФайлСертификата) Экспорт
	
	Сертификат = Новый СертификатКриптографии(ФайлСертификата);
	
	Субъект = Сертификат.Субъект;
	ИНН     = ДокументооборотСКОКлиентСервер.ИННИзСертификата(Субъект);
	
	Свойства = Новый Структура;	
	Если НЕ Субъект.Свойство("OID2_5_4_4") // Фамилия
		ИЛИ НЕ Субъект.Свойство("OID2_5_4_42") // Имя[ Отчетство]
		ИЛИ НЕ Субъект.Свойство("OID1_2_643_100_3") // СНИЛС	
		ИЛИ ИНН = "" Тогда
		Возврат Свойства;	
	КонецЕсли;
	
	ФИО = СокрЛП(Субъект["OID2_5_4_4"]) + " " + СокрЛП(Субъект["OID2_5_4_42"]);
	
	Свойства.Вставить("ФИО", ФИО);
	Свойства.Вставить("СНИЛС", Субъект["OID1_2_643_100_3"]);
	Свойства.Вставить("ИНН", ИНН);
	Свойства.Вставить("ДатаНачала", Сертификат.ДатаНачала);
	Свойства.Вставить("ДатаОкончания", Сертификат.ДатаОкончания);
	Свойства.Вставить("Издатель", Сертификат.Издатель.O);
	
	Возврат Свойства;
	
КонецФункции

&НаКлиенте
Функция ПараметрыПроцедурыСформироватьИОтправитьЗаявление() Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ДокументЗаявление", 							Неопределено);
	Контекст.Вставить("ИдентификаторАбонента", 						"");
	Контекст.Вставить("ВызовИзМастераПодключенияК1СОтчетности", 	Ложь);
	Контекст.Вставить("ВыполняемоеОповещение", 						Неопределено);
	Контекст.Вставить("ФормироватьЗакрытыйКлючИЗапросНаСертификат", Истина);
	
	// Следующие параметры определяются внутри процедуры СформироватьИОтправитьЗаявление
	
	Контекст.Вставить("ПодписатьМетодомБРО",				Ложь);
	Контекст.Вставить("ПодписатьПлатформой", 				Ложь);
	Контекст.Вставить("ЭтоЗаявлениеНаИзменение", 			Ложь);
	Контекст.Вставить("ЭтоРучноеЗаявление", 				Ложь);
	Контекст.Вставить("СтороннийСертификат", 				Неопределено);
	Контекст.Вставить("ЭтоЗаявлениеНаПодключение", 			Ложь);
	Контекст.Вставить("АдресТекстаОтправленногоЗаявления", 	Неопределено);
	Контекст.Вставить("ПрисоединенныйФайлЗаявления", 		Неопределено);
	Контекст.Вставить("ФормаВладелец", 						Неопределено);
	Контекст.Вставить("OIDЛицензииКриптоПро", 				"");
	
	// Будут вычеслены в ходе отправки
	Контекст.Вставить("АдресПодписиПодЗаявлением", 	Неопределено);
	Контекст.Вставить("СканыКЗаявлению", 			Новый Массив);
	Контекст.Вставить("ЭтоНулевка", 				Ложь);
	
	Возврат Контекст;
	
КонецФункции

// Описание параметров находится в процедуре ПараметрыПроцедурыСформироватьИОтправитьЗаявление
&НаКлиенте
Процедура СформироватьИОтправитьЗаявление(Контекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьИОтправитьЗаявлениеПослеУстановкиКорневогоСертификатаВР",
		ЭтотОбъект, 
		Контекст);
		
	УстановитьСертификатыВРПриНеобходимости(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВыполняемоеОповещение)
	
	// Реквизиты формы, чтобы потом работать с ними в подключаемой процедуре
	ОписаниеОповещенияПослеОтправкиЗаявления = ВыполняемоеОповещение;
	ОтправляемоеЗаявление 					 = ДокументЗаявление.Ссылка;
	
	АлгоритмКонтейнераКлючей = ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДокументЗаявление);
	Если АлгоритмКонтейнераКлючей = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'При получении алгоритма генерации ключей возникла ошибка. Сервис временно недоступен.';
							|en = 'При получении алгоритма генерации ключей возникла ошибка. Сервис временно недоступен.'");
		РезультатВыполнения = Новый Структура("ТекстОшибки", ТекстОшибки);
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияПослеОтправкиЗаявления, РезультатВыполнения);
		Возврат;
	КонецЕсли;
	
	НачатьОтправкуОблачногоЗаявленияВБазуЗаявок(ДокументЗаявление.Ссылка, АлгоритмКонтейнераКлючей);
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьСостояниеОтправкиОблачногоЗаявленияВБазуЗаявок", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеПолученияВременногоКаталога(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
	
		ВременныйКаталог = Результат.ИмяКаталога;
		ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьИОтправитьЗаявление_ПослеФормированияКлюча", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ДополнительныеПараметры.ФормироватьЗакрытыйКлючИЗапросНаСертификат Тогда
			
			// Подменяем оповещение, чтобы не сразу вернуться в заявление, а обработать результат
			ВходящийКонтекст = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ДополнительныеПараметры);
			ВходящийКонтекст.ВыполняемоеОповещение = ОписаниеОповещения;
			
			Если ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
				ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификат(ВходящийКонтекст);
			Иначе
				ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодпись(ВходящийКонтекст);
			КонецЕсли;	
				
		Иначе
			
			ДополнительныеПараметры.Вставить("ТекстЗапросаНаСертификат", 	"");
			ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", Истина);
			ДополнительныеПараметры.Вставить("ТекстОшибки", 				"");
			ДополнительныеПараметры.Вставить("ПутьКонтейнерЗакрытогоКлюча", ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча);
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ДополнительныеПараметры);
		КонецЕсли;
	Иначе
		Результат = Новый Структура("ТекстОшибки", Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеФормированияКлюча(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.ПродолжитьОтправкуЗаявления Тогда
		
		ДокументЗаявление 			= ДополнительныеПараметры.ДокументЗаявление;
		ИдентификаторАбонента 		= ДополнительныеПараметры.ИдентификаторАбонента;
		ТекстЗапросаНаСертификат 	= Результат.ТекстЗапросаНаСертификат;
		АлгоритмКонтейнераКлючей 	= Результат.АлгоритмКонтейнераКлючей;
		
		ТекстЗаявления = ОбработкаЗаявленийАбонентаВызовСервера.АдресЗаявленияПо1СОтчетности(
			ДокументЗаявление, 
			ТекстЗапросаНаСертификат,
			ИдентификаторАбонента,
			АлгоритмКонтейнераКлючей);
			
		АдресЗаявления = ТекстЗаявления.АдресЗаявления;
			
		ДополнительныеПараметры.Вставить("ПрисоединенныйФайлЗаявления", ТекстЗаявления.ПрисоединенныйФайл);
			
		УпакованныеФайлы = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("Адрес,Имя", АдресЗаявления, "file")), 
			УникальныйИдентификатор);

		ДополнительныеПараметры.Вставить("АдресАрхивированногоЗаявленияНаРегистрацию", 	УпакованныеФайлы);
		ДополнительныеПараметры.Вставить("АдресТекстаОтправленногоЗаявления", 			АдресЗаявления);
		
		// Копируем из результата
		ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", 					Результат.ПродолжитьОтправкуЗаявления);
		ДополнительныеПараметры.Вставить("ПутьКонтейнерЗакрытогоКлюча", 					Результат.ПутьКонтейнерЗакрытогоКлюча);
		ДополнительныеПараметры.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", 	Результат.ТекстОшибки);
		
		СформироватьИОтправить_ПодписатьЗаявление(ДополнительныеПараметры);
		
	Иначе
		
		ДополнительныеПараметры.Вставить("ПродолжитьОтправкуЗаявления", 					Ложь);
		ДополнительныеПараметры.Вставить("АдресТекстаОтправленногоЗаявления", 				"");
		ДополнительныеПараметры.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", 	Результат.ТекстОшибки);
		
		Результат = Новый Структура("Выполнено", Истина);
		
		СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаявлениеСформироватьИОтправитьПакет(ПараметрыФункции)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	ПараметрыФункции.Вставить("ИмяФайлаЗаявлениеНаРегистрацию", 	СгенерироватьИмяФайлаДокументаВСоставеПакета());
	ПараметрыФункции.Вставить("ИмяФайлаПодписьПодЗаявлением", 		СгенерироватьИмяФайлаДокументаВСоставеПакета());
	ПараметрыФункции.Вставить("ИмяФайлаОписаниеПакета", 			"packageDescription.xml");
	ПараметрыФункции.Вставить("ИдентификаторАбонента", 				Сред(ПараметрыФункции.ДокументЗаявление.УчетнаяЗапись.ИдентификаторАбонента, 4));
	ПараметрыФункции.Вставить("ВременныйКаталог", 					ВременныйКаталог);
	ПараметрыФункции.Вставить("ИдентификаторДокументооборота",  	ПараметрыФункции.ДокументЗаявление.ИдентификаторДокументооборота);
	ПараметрыФункции.Вставить("СпецОператорСвязиДокументооборота", 	ПараметрыФункции.ДокументЗаявление.СпецОператорСвязи);
	
	ЗаявлениеСформироватьОписаниеПакета(ПараметрыФункции);
	
	ФайлыПакета = Новый Массив;
	
	// Заявление
	ОписанияФайлаЗаявления = Новый Структура();
	ОписанияФайлаЗаявления.Вставить("Адрес", ПараметрыФункции.АдресАрхивированногоЗаявленияНаРегистрацию);
	ОписанияФайлаЗаявления.Вставить("Имя", 	 ПараметрыФункции.ИмяФайлаЗаявлениеНаРегистрацию);
	ФайлыПакета.Добавить(ОписанияФайлаЗаявления);
	
	Если ПараметрыФункции.Свойство("АдресПодписиПодЗаявлением") И ЭтоАдресВременногоХранилища(ПараметрыФункции.АдресПодписиПодЗаявлением) Тогда
		
		// Подпись заявления
		ОписанияФайлаПодписиЗаявления = Новый Структура();
		ОписанияФайлаПодписиЗаявления.Вставить("Адрес", ПараметрыФункции.АдресПодписиПодЗаявлением);
		ОписанияФайлаПодписиЗаявления.Вставить("Имя", 	ПараметрыФункции.ИмяФайлаПодписьПодЗаявлением);
		
		ФайлыПакета.Добавить(ОписанияФайлаПодписиЗаявления);
		
	КонецЕсли;
	
	Если ПараметрыФункции.Свойство("СканыКЗаявлению") Тогда
		
		СканыКЗаявлению = ПараметрыФункции.СканыКЗаявлению;
		Для каждого Скан Из СканыКЗаявлению Цикл
			
			// Скан
			ОписанияСкана = Новый Структура();
			ОписанияСкана.Вставить("Адрес", Скан.АдресДанных);
			ОписанияСкана.Вставить("Имя", 	Скан.ИмяФайлаДанных);
			
			ФайлыПакета.Добавить(ОписанияСкана);
			
			Если ЗначениеЗаполнено(Скан.АдресПодписи) И ЭтоАдресВременногоХранилища(Скан.АдресПодписи) Тогда
				
				// Подпись скана
				ОписанияПодписиСкана = Новый Структура();
				ОписанияПодписиСкана.Вставить("Адрес",  Скан.АдресПодписи);
				ОписанияПодписиСкана.Вставить("Имя", 	Скан.ИмяФайлаПодписи);

				ФайлыПакета.Добавить(ОписанияПодписиСкана);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПутьКФайлуОписания 		= ПараметрыФункции.ВременныйКаталог + ПараметрыФункции.ИмяФайлаОписаниеПакета;
	ДвДанныеФайлаОписания 	= Новый ДвоичныеДанные(ПутьКФайлуОписания);
	АдресФайлаОписания 		= ПоместитьВоВременноеХранилище(ДвДанныеФайлаОписания);
	
	// Описание архива
	ОписанияФайлаОписания = Новый Структура();
	ОписанияФайлаОписания.Вставить("Адрес", АдресФайлаОписания);
	ОписанияФайлаОписания.Вставить("Имя", 	ПараметрыФункции.ИмяФайлаОписаниеПакета);
		
	ФайлыПакета.Добавить(ОписанияФайлаОписания);
	
	Пакет = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(ФайлыПакета);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
	
	ПрисоединитьФайлЗаявления(ПараметрыФункции.ДокументЗаявление, Пакет, "Пакет_с_заявлением", "zip");
	
	ОбменССерверомОтправитьЗаявление(
		Пакет, 
		ПараметрыФункции.ДокументЗаявление,
		ПараметрыФункции.Статус, 
		ПараметрыФункции.ДатаОтправки, 
		ПараметрыФункции.СтатусКомментарий,
		ПараметрыФункции.СостояниеОтправкиСообщения,
		ПараметрыФункции.ВызовИзМастераПодключения, 
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности, 
		ПараметрыФункции.ПовторятьСоединение);
		
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция ЗаявлениеСформироватьОписаниеПакета(ПараметрыФункции)
	
	ДокументОписания = Новый ЗаписьXML;
	ДокументОписания.ОткрытьФайл(ПараметрыФункции.ВременныйКаталог + ПараметрыФункции.ИмяФайлаОписаниеПакета, "windows-1251");
	ДокументОписания.ЗаписатьОбъявлениеXML();
	
	ДокументОписания.ЗаписатьНачалоЭлемента("пакет");
	
	Если ПараметрыФункции.ПодписатьПлатформой Тогда
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.2");
	ИначеЕсли ПараметрыФункции.ЭтоЗаявлениеНаИзменение Тогда
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.1");
	Иначе
		ДокументОписания.ЗаписатьАтрибут("версияФормата", "1С:1.0");
	КонецЕсли;
	
	ДокументОписания.ЗаписатьАтрибут("версПрог", РегламентированнаяОтчетность.ВерсияПрограммы());
	ДокументОписания.ЗаписатьАтрибут("типДокументооборота", "РегистрацияАбонента");
	ДокументОписания.ЗаписатьАтрибут("типТранзакции", "Регистрация");
	ДокументОписания.ЗаписатьАтрибут("идентификаторДокументооборота", ПараметрыФункции.ИдентификаторДокументооборота);
	
	ДокументОписания.ЗаписатьНачалоЭлемента("отправитель");
	ДокументОписания.ЗаписатьАтрибут("типСубъекта", "абонент");
	Если ПараметрыФункции.ЭтоЗаявлениеНаИзменение Тогда
		ДокументОписания.ЗаписатьАтрибут("идентификаторСубъекта", ПараметрыФункции.ИдентификаторАбонента);
	КонецЕсли;
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ДокументОписания.ЗаписатьНачалоЭлемента("получатель");
	СпецОператорСвязи = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ПараметрыФункции.СпецОператорСвязиДокументооборота,"ВебСервисИдентификаторСубъекта");
	ДокументОписания.ЗаписатьАтрибут("идентификаторСубъекта", СпецОператорСвязи);
	ДокументОписания.ЗаписатьАтрибут("типСубъекта", "спецоператор");
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	// документ-заявление
	ДокументОписания.ЗаписатьНачалоЭлемента("документ");
	ДокументОписания.ЗаписатьАтрибут("идентификаторДокумента", ОбщегоНазначенияЭДКОКлиентСервер.НовыйИдентификатор());
	ДокументОписания.ЗаписатьАтрибут("типДокумента", "Заявление");
	ДокументОписания.ЗаписатьАтрибут("типСодержимого", "xml");
	ДокументОписания.ЗаписатьАтрибут("сжат", "true");
	ДокументОписания.ЗаписатьАтрибут("зашифрован", "true");
	
	ДокументОписания.ЗаписатьНачалоЭлемента("содержимое");
	ДокументОписания.ЗаписатьАтрибут("имяФайла", ПараметрыФункции.ИмяФайлаЗаявлениеНаРегистрацию);
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	Если ПараметрыФункции.ПодписатьМетодомБРО ИЛИ ПараметрыФункции.ПодписатьПлатформой Тогда
		ДокументОписания.ЗаписатьНачалоЭлемента("подпись");
		ДокументОписания.ЗаписатьАтрибут("имяФайла", ПараметрыФункции.ИмяФайлаПодписьПодЗаявлением);
		ДокументОписания.ЗаписатьКонецЭлемента();	
	КонецЕсли;
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ЗаявлениеСформироватьОписаниеПакета_ДобавитьСканы(ДокументОписания, ПараметрыФункции);
	
	// пакет
	ДокументОписания.ЗаписатьКонецЭлемента();
	
	ДокументОписания.Закрыть();
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаявлениеСформироватьОписаниеПакета_ДобавитьСканы(ДокументОписания, ПараметрыФункции)
	
	Если ПараметрыФункции.Свойство("СканыКЗаявлению") 
		И (ПараметрыФункции.ЭтоЗаявлениеНаИзменение ИЛИ ПараметрыФункции.ЭтоЗаявлениеНаПодключение) Тогда
		
		СканыКЗаявлению = ПараметрыФункции.СканыКЗаявлению;
		Для каждого Скан Из СканыКЗаявлению Цикл
			
			ДокументОписания.ЗаписатьНачалоЭлемента("документ");
			ДокументОписания.ЗаписатьАтрибут("идентификаторДокумента", Скан.идентификаторДокумента);
			
			ДокументОписания.ЗаписатьАтрибут("типДокумента", Скан.ВидДокумента);
			
			Если Скан.Свойство("идентификаторДокументаРодителя")
				И ЗначениеЗаполнено(Скан.идентификаторДокументаРодителя) Тогда
				ДокументОписания.ЗаписатьАтрибут("идентификаторМЧД", Скан.идентификаторДокументаРодителя);
			КонецЕсли;
			
			Файл = Новый Файл(Скан.ИмяФайлаДанных);
			ДокументОписания.ЗаписатьАтрибут("типСодержимого", Нрег(Скан.Расширение));
			
			ДокументОписания.ЗаписатьАтрибут("сжат", "true");
			ДокументОписания.ЗаписатьАтрибут("зашифрован", "true");
			
			ДокументОписания.ЗаписатьНачалоЭлемента("содержимое");
			ДокументОписания.ЗаписатьАтрибут("имяФайла", Скан.ИмяФайлаДанных);
			ДокументОписания.ЗаписатьКонецЭлемента();
			
			Если ЗначениеЗаполнено(Скан.АдресПодписи) И ЭтоАдресВременногоХранилища(Скан.АдресПодписи) Тогда
				ДокументОписания.ЗаписатьНачалоЭлемента("подпись");
				ДокументОписания.ЗаписатьАтрибут("имяФайла", Скан.ИмяФайлаПодписи);
				ДокументОписания.ЗаписатьКонецЭлемента();
			КонецЕсли;
			
			ДокументОписания.ЗаписатьКонецЭлемента();
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбменССерверомОтправитьЗаявление(
		Знач Файл, 
		ДокументЗаявление, 
		Статус, 
		ДатаОтправки, 
		СтатусКомментарий,
		СостояниеОтправкиСообщения,
		ВызовИзМастераПодключенияК1СОтчетности, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности, 
		ПовторятьСоединение = Ложь)
		
	СпецоператорСвязи = ДокументЗаявление.СпецоператорСвязи;
	
	Сервис = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбменССерверомСоздатьСервис(
		СпецоператорСвязи, 
		ВызовИзМастераПодключенияК1СОтчетности, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности, , 
		Ложь);
	
	Если Сервис = Неопределено Тогда
		СостояниеОтправкиСообщения = "Не удалось отправить сообщение";
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(Файл) Тогда
		СтрокаBase64 = Base64Строка(ПолучитьИзВременногоХранилища(Файл));
	Иначе	
		СтрокаBase64 = Base64Строка(Новый ДвоичныеДанные(Файл));
	КонецЕсли;
	
	ЭтоВторичноеЗаявление = ОбработкаЗаявленийАбонентаКлиентСервер.ЭтоЗаявлениеНаИзменение(ДокументЗаявление);
	
	Если НЕ ЗначениеЗаполнено(ДокументЗаявление.НомерОсновнойПоставки1с) Тогда
		
		ТикетАутентификации = ТикетАутентификацииНаПорталеПоддержки();
		Тикет = ТикетАутентификации.Тикет;
		
		Если НЕ ЗначениеЗаполнено(Тикет)
			И НЕ ЭтоВторичноеЗаявление Тогда
			
			ТекстОшибки = НСтр("ru = 'ТикетАутентификацииНаПорталеПоддержки.КодОшибки:';
								|en = 'ТикетАутентификацииНаПорталеПоддержки.КодОшибки:'") + ТикетАутентификации.КодОшибки;
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
				ТекстОшибки, 
				ВызовИзМастераПодключенияК1СОтчетности, 
				ТекстОшибокДляМастераПодключенияК1СОтчетности, 
				НЕ ВызовИзМастераПодключенияК1СОтчетности);
				
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		Если ЗначениеЗаполнено(Тикет) Тогда  
			XDTOРезультат = Сервис.SendPacketWithTicket(СтрокаBase64, Тикет);
		Иначе
			XDTOРезультат = Сервис.SendPacket(СтрокаBase64);
		КонецЕсли;
	Исключение
		
		ТекстОшибки = НСтр("ru = 'Не удалось обратиться к серверу оператора ""Калуга Астрал"". ';
							|en = 'Не удалось обратиться к серверу оператора ""Калуга Астрал"". '") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СостояниеОтправкиСообщения = ДокументооборотСКОВызовСервера.ДобавитьТекстОшибкиСертификатаКА(ТекстОшибки);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			СостояниеОтправкиСообщения, 
			ВызовИзМастераПодключенияК1СОтчетности, 
			ТекстОшибокДляМастераПодключенияК1СОтчетности, 
			НЕ ВызовИзМастераПодключенияК1СОтчетности);
			
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Не удалось обратиться к серверу оператора ""Калуга Астрал"" при отправке заявления.';
				|en = 'Электронный документооборот с контролирующими органами. Не удалось обратиться к серверу оператора ""Калуга Астрал"" при отправке заявления.'", КодОсновногоЯзыка),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке);
			
		// Пробуем запасным способом проверить статус заявления, чтобы заявления не задублировались на сервере КА
		КонтрольСостояния = ОбработкаЗаявленийАбонентаВызовСервера.ОбменССерверомПолучитьОтвет(
			ДокументЗаявление, 
			ВызовИзМастераПодключенияК1СОтчетности);
			
		Если КонтрольСостояния.Выполнено Тогда
			СостояниеОтправкиСообщения = "Заявление отправлено в обработку на сервер";
			Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
			СтатусКомментарий = КонтрольСостояния.СтатусКомментарий;
		КонецЕсли;
			
		Возврат;
		
	КонецПопытки;
	
	ПовторятьСоединение = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(XDTOРезультат);
	ПостроительДОМ = Новый ПостроительDOM();
	ДОМ = ПостроительДОМ.Прочитать(ЧтениеXML);
	УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("code");
	кодРезультата = УзелDOM[0].ТекстовоеСодержимое;
	ДатаОтправки = ТекущаяДатаСеанса();
	
	Если КодРезультата = "0" Тогда
		СостояниеОтправкиСообщения = "Заявление отправлено в обработку на сервер";
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		СтатусКомментарий = "";
	ИначеЕсли КодРезультата = "1000" Тогда
		СостояниеОтправкиСообщения = "Заявление отправлено в автоматическую обработку";
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		СтатусКомментарий = "";
	Иначе
		
		СообщениеОшибки = "";
		
		УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("errorMessage");
		
		Если УзелDOM.Количество() > 0 Тогда
			СообщениеОшибки = УзелDOM[0].ТекстовоеСодержимое;
			СостояниеОтправкиСообщения = "При обработке заявления на сервере возникла ошибка:
			|"+ Символы.пс + сообщениеОшибки;
		КонецЕсли;
		
		СтатусКомментарий = сообщениеОшибки;
		Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено;
	КонецЕсли;
	ЧтениеXML.Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТикетАутентификацииНаПорталеПоддержки() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВладелецТикета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ВладелецТикета();
	
	МодульИнтернетПоддержкаПользователей = ЭлектронныйДокументооборотСКонтролирующимиОрганами.МодульИнтернетПоддержкаПользователей();
	
	Если МодульИнтернетПоддержкаПользователей = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		
		РезультатПолученияТикета = МодульИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки(ВладелецТикета);
		
		Возврат РезультатПолученияТикета;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ТекстДляПревышеноКоличествоПопытокПолученияТикета() Экспорт

	Текст = Новый ФорматированнаяСтрока(
		Символы.ПС,
		НСтр("ru = 'Что делать?';
			|en = 'Что делать?'"), Символы.ПС,
		НСтр("ru = '1. Повторите попытку позже.';
			|en = '1. Повторите попытку позже.'"), Символы.ПС,
		НСтр("ru = '2. При необходимости ';
			|en = '2. При необходимости '"),
		Новый ФорматированнаяСтрока(НСтр("ru = 'восстановите';
										|en = 'восстановите'"),,,, "восстановить пароль Портала ИТС"),
		НСтр("ru = ' пароль и ';
			|en = ' пароль и '"),
		Новый ФорматированнаяСтрока(НСтр("ru = 'повторите';
										|en = 'повторите'"),,,, "задать логин и пароль от ИТС"),
		НСтр("ru = ' попытку авторизации.';
			|en = ' попытку авторизации.'"));

	Возврат Текст;

КонецФункции

&НаКлиенте
Процедура ОбработкаНавигационнойСсылкиИТС(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "задать логин и пароль от ИТС" Тогда
		 УказатьЛогинИПарольИТС();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "перейти на Портал ИТС" Тогда
		 ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПерейтиНаПортал();
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "восстановить пароль Портала ИТС" Тогда
		МодульИнтернетПоддержкаПользователейКлиент = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.МодульИнтернетПоддержкаПользователейКлиент();
		МодульИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуВосстановленияПароля();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьЛогинИПарольИТС() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(); 
	
	МодульИнтернетПоддержкаПользователейКлиент = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.МодульИнтернетПоддержкаПользователейКлиент();
	МодульИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(
		ОписаниеОповещения,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстОшибки 				= ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	СостояниеОтправкиСообщения 	= "";

	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Выполнено = Истина Тогда
		
		ДокументЗаявление = ДополнительныеПараметры.ДокументЗаявление;
		
		Если ДополнительныеПараметры.ПродолжитьОтправкуЗаявления Тогда
			
			ПараметрыОтправки = ПараметрыЗаявлениеСформироватьИОтправитьПакет(ДополнительныеПараметры);
			ЗаявлениеСформироватьИОтправитьПакет(ПараметрыОтправки);
			
			КопируемыеСвойства = "Статус, ДатаОтправки, СтатусКомментарий";
			ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, ПараметрыОтправки, КопируемыеСвойства);
			
			Если ПараметрыОтправки.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
				
				ПовторятьСоединение 		= ПараметрыОтправки.ПовторятьСоединение;
				СостояниеОтправкиСообщения 	= ПараметрыОтправки.СостояниеОтправкиСообщения;
				ТекстОшибки					= ПараметрыОтправки.ТекстОшибокДляМастераПодключенияК1СОтчетности;
				
				СообщитьОбОшибкеОтправкиЗаявления(
					СостояниеОтправкиСообщения, 
					ПовторятьСоединение,
					ТекстОшибки,
					ДополнительныеПараметры);
					
			КонецЕсли;
			
		КонецЕсли;
		
		ОбновитьДанныеЗаявленияПослеОтправки(ДополнительныеПараметры);
			
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ДополнительныеПараметры.ВременныйКаталог);
		
		Если ДокументЗаявление.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено") Тогда
			ОбработкаЗаявленийАбонентаКлиент.ВключитьАвтоматическуюПроверкуСтатуса(ДокументЗаявление.Ссылка);
		ИначеЕсли ДокументЗаявление.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено") Тогда
			ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(
				ДокументЗаявление.Ссылка, 
				Новый Структура("НастройкаЗавершена", Истина));
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		
		СтруктураРезультата = Новый Структура();
		СтруктураРезультата.Вставить("ТекстОшибки", 		ТекстОшибки);
		СтруктураРезультата.Вставить("СостояниеОтправки", 	СостояниеОтправкиСообщения);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, СтруктураРезультата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗаявлениеСформироватьИОтправитьПакет(ДополнительныеПараметры)
	
	ПараметрыОтправки 	= ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ДополнительныеПараметры);
	ПараметрыОтправки.Вставить("ВызовИзМастераПодключения", ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности);
	
	// Удаляем те свойства, которые нельзя передавать на сервер
	ПараметрыОтправки.Удалить("ВыполняемоеОповещение");
	ПараметрыОтправки.Удалить("ФормаВладелец");
	
	ПараметрыОтправки.Вставить("СостояниеОтправкиСообщения", 	"");
	ПараметрыОтправки.Вставить("ПовторятьСоединение", 			Истина);

	Возврат ПараметрыОтправки;
	
КонецФункции

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеПолученияСвойствСертификатаОператораСвязи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено И Результат.СертификатНайден Тогда
		
		ДополнительныеПараметры.Вставить("СвойстваСертификатаОператораСвязи", Результат.СвойстваСертификата);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеШифрованияФайлаЗаявления", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыОперации = Новый Структура;
		ПараметрыОперации.Вставить("ОбработкаОшибок", Ложь);
		
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
			ОписаниеОповещения, 
			ДополнительныеПараметры.АдресАрхивированногоЗаявленияНаРегистрацию, 
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат.СвойстваСертификата),,
			ДополнительныеПараметры.ВыводитьСообщения,,, 
			ПараметрыОперации);

	ИначеЕсли Результат.Выполнено И НЕ Результат.СертификатНайден Тогда
		Результат.Вставить("ТекстОшибки", НСтр("ru = 'Не удалось получить свойства сертификата оператора связи';
												|en = 'Не удалось получить свойства сертификата оператора связи'"));
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
		
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьЗаявление(ПараметрыФункции)
	
	ДокументЗаявление = ПараметрыФункции.ДокументЗаявление;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	ОрганизацияСсылка = ДокументЗаявление.Организация;
	
	Если ПараметрыФункции.ПодписатьПлатформой Тогда
		
		ПодписатьЗаявлениеСтороннимСертификатом(ПараметрыФункции);
		
	ИначеЕсли ПараметрыФункции.ПодписатьМетодомБРО Тогда
		
		Сертификат = ПолучитьСертификатИзЗаявленияНаСервере(ДокументЗаявление.Ссылка);
		МестоХраненияСертификата = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Сертификат);
		
		ПараметрыОперации = Неопределено;
		Если ЭтоОблачнаяПодпись(МестоХраненияСертификата) Тогда
			ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЗаявлениеНаПодключение", ОрганизацияСсылка); 
			ПараметрыОперации = ПодготовитьОблачнуюПодпись("Заявление на подключение к 1С-Отчетности", "xml", ТребуетПодтверждениеОперации);
		КонецЕсли;
	
		ПараметрыФункции.Вставить("Сертификат", Сертификат);
			
		// Нельзя объединять оповещения, так как параметры оповещения различные
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьИОтправить_ПослеПодписанияЗаявления", 
			ЭтотОбъект, 
			ПараметрыФункции);
			
		АдресЗаявления  = ПараметрыФункции.АдресТекстаОтправленногоЗаявления;
		АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
		
		КриптографияЭДКОКлиент.ПодписатьPKCS7(
			Оповещение, 
			ПараметрыФункции.Сертификат, 
			АдресЗаявления, 
			Ложь, 
			АдресРезультата,,, 
			Истина, 
			ПараметрыОперации);
			
	Иначе
		
		// Подписания не будет, но сканы все равно надо приложить
		СканыКЗаявлению = СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ПараметрыФункции);
		Если СканыКЗаявлению.Количество() > 0 Тогда
			ПараметрыФункции.Вставить("СканыКЗаявлению", СканыКЗаявлению);
		КонецЕсли;
		
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ПараметрыФункции.ВыполняемоеОповещение);
		Иначе
			ЗаявлениеЗашифровать(ПараметрыФункции);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьЗаявлениеСтороннимСертификатом(ПараметрыФункции)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПодписатьЗаявлениеСтороннимСертификатом_Завершение", 
		ЭтотОбъект, 
		ПараметрыФункции);
		
	ДокументЗаявление = ПараметрыФункции.ДокументЗаявление;
		
	АдресЗаявления          = ПараметрыФункции.АдресТекстаОтправленногоЗаявления;
	ДвДанныеДляПодписания   = ПолучитьИзВременногоХранилища(АдресЗаявления);
	ТипКриптопровайдера     = ДокументЗаявление.ТипКриптопровайдера;
	СертификатДляПодписания = ОбработкаЗаявленийАбонентаВызовСервера.СертификатИзЗаявления(ДокументЗаявление);
	
	ОбработкаЗаявленийАбонентаКлиент.ПодписатьЗаявлениеСтороннимСертификатом(
		ЭтотОбъект, 
		ОписаниеОповещения, 
		ДвДанныеДляПодписания, 
		СертификатДляПодписания,
		ТипКриптопровайдера);
		
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодписьКФайлуЗаявления(АдресПодписи, ИмяФайлаИлиПрисоединенныйФайл, ДокументЗаявление)
	
	Если ТипЗнч(ИмяФайлаИлиПрисоединенныйФайл) = Тип("Строка") Тогда
		
		Для Каждого СтрокаТаблицы Из ДокументЗаявление.ЭлектронныеДокументы Цикл
			Если СтрокаТаблицы.Документ = ИмяФайлаИлиПрисоединенныйФайл Тогда
				ПрисоединенныйФайл = СтрокаТаблицы.Файл;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПрисоединенныйФайл = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ПрисоединенныйФайл = ИмяФайлаИлиПрисоединенныйФайл;
		
	КонецЕсли;
	
	Если ДокументЗаявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное Тогда
		ДанныеСертификата = ДокументЗаявление.РеквизитыСертификата.Получить();
	Иначе
		ДанныеСертификата = ДокументЗаявление.Сертификат.Получить();
	КонецЕсли;
	
	СвойстваПодписи = Новый Структура;
	СвойстваПодписи.Вставить("Подпись", 	 ПолучитьИзВременногоХранилища(АдресПодписи));
	СвойстваПодписи.Вставить("Сертификат", 	 ДанныеСертификата.Сертификат);
	СвойстваПодписи.Вставить("ПодписьВерна", Истина);
	СвойстваПодписи.Вставить("ДатаПроверкиПодписи", ТекущаяДата());
	СвойстваПодписи.Вставить("КомуВыданСертификат", "");
	
	РаботаСФайлами.ДобавитьПодписьКФайлу(ПрисоединенныйФайл, СвойстваПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПослеПодписанияЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Если ВходящийКонтекст.ПодписатьПлатформой Тогда
		МестоХраненияСертификата = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Ложь);
	Иначе
		Сертификат = ВходящийКонтекст.Сертификат;
		МестоХраненияСертификата = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Сертификат);
	КонецЕсли;
		
	// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
	Если ЭтоОблачнаяПодпись(МестоХраненияСертификата) Тогда
		Выполнено = Результат.Выполнено;
	Иначе
		Выполнено = ВыполненоПодписаниеФайлаЗаявления(Результат, ВходящийКонтекст);
	КонецЕсли;
	
	Если Выполнено Тогда
		
		ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
		Адрес = АдресФайлаПодписиФайлаЗаявления(Результат, ВходящийКонтекст);
		ВходящийКонтекст.Вставить("АдресПодписиПодЗаявлением", Адрес);
		
		ДобавитьПодписьКФайлуЗаявления(
			Адрес, 
			ВходящийКонтекст.ПрисоединенныйФайлЗаявления, 
			ДокументЗаявление.Ссылка);
		
		СканыКЗаявлению = СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ВходящийКонтекст);
		ВходящийКонтекст.Вставить("СканыКЗаявлению", 		СканыКЗаявлению);
		ВходящийКонтекст.Вставить("ИндексТекущегоСкана",	0);
		
		Если ЭтоОблачнаяПодпись(МестоХраненияСертификата) И СканыКЗаявлению.Количество() > 1 И ВключитьПакетнуюПодпись Тогда
			СформироватьИОтправить_ПодписатьСканыКЗаявлениюПакетно(ВходящийКонтекст);
		Иначе	
			СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		КонецЕсли;
		   
	Иначе
		
		СообщитьОбОшибкеПриПодписанииЗаявления(ВходящийКонтекст, Результат.ОписаниеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибкеПриПодписанииЗаявления(ВходящийКонтекст, ОписаниеОшибки)
	
	ИспользоватьСуществующий = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(ВходящийКонтекст.ДокументЗаявление);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	
	ТолькоПодписание = Ложь;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
		И НЕ ВходящийКонтекст.ЭтоЗаявлениеНаПодключение
		И ВходящийКонтекст.ПодписатьМетодомБРО Тогда
		СвойствоОблачнойПодписи = ОбработкаЗаявленийАбонентаКлиентСервер.СведенияОблачнойПодписиЗаявления(ВходящийКонтекст.ДокументЗаявление);
		ТолькоПодписание = СвойствоОблачнойПодписи.ТребуетИзменения;
	КонецЕсли;
	
	// Вывод ошибки
	Если ВходящийКонтекст.ПодписатьМетодомБРО И ВходящийКонтекст.ЭтоЗаявлениеНаИзменение И НЕ ТолькоПодписание Тогда
		// Заявление на изменение
		Оповещение = Новый ОписаниеОповещения("СформироватьИОтправитьЗаявлениеПослеОтветаНаВопрос", ЭтотОбъект, ВходящийКонтекст);
		СформироватьИОтправитьЗаявлениеПоказатьСообщениеОНевозможностиБезбумажногоПродления(Оповещение, ОписаниеОшибки);
	Иначе
		// Первичное заявление
		СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ВходящийКонтекст, ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(ВходящийКонтекст, ТекстОшибки = "") Экспорт
	
	Если ВходящийКонтекст.СтороннийСертификат = Неопределено Тогда 
		ПредставлениеСертификата = "";
	Иначе
		ПредставлениеСертификата = Символы.ПС + ВходящийКонтекст.СтороннийСертификат.ПредставлениеСертификата;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Не удалось выполнить подписание сертификатом';
						|en = 'Не удалось выполнить подписание сертификатом'") 
					+ ПредставлениеСертификата
					+ НСтр("ru = ' по причине:';
							|en = ' по причине:'")
					+ Символы.Таб + ТекстОшибки;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстОшибки", ТекстОшибки);
	 
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст) Экспорт
	
	ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
	СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;
	ДокументЗаявление	= ВходящийКонтекст.ДокументЗаявление;
	МестоХраненияКлюча	= КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	ОрганизацияСсылка   = ДокументЗаявление.Организация;
	
	Если ИндексТекущегоСкана = СканыКЗаявлению.Количество() Тогда
		
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
		Иначе
			ЗаявлениеЗашифровать(ВходящийКонтекст);
		КонецЕсли;
	
	Иначе
		
		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		
		Если ВходящийКонтекст.ПодписатьМетодомБРО Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"СформироватьИОтправить_ПослеПодписанияСледующегоСкана", 
				ЭтотОбъект, 
				ВходящийКонтекст); 
				
			АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
				
			ПараметрыОперации = Неопределено;
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
				ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЗаявлениеНаПодключениеСканы", ОрганизацияСсылка); 
				ПараметрыОперации = ПодготовитьОблачнуюПодпись(ТекущийСкан.Наименование, ТекущийСкан.Расширение, ТребуетПодтверждениеОперации);
			КонецЕсли;
			
			КриптографияЭДКОКлиент.ПодписатьPKCS7(
				ОписаниеОповещения, 
				ВходящийКонтекст.Сертификат, 
				ТекущийСкан.АдресДанных, 
				ДокументЗаявление.ЭтоУдаленноеПереизданиеСертификата, 
				АдресРезультата,
				Ложь,
				,
				ВходящийКонтекст.ПодписатьПлатформой,
				ПараметрыОперации);
				
		Иначе

			ПодписатьСканыСтороннимСертификатом(ВходящийКонтекст);
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПослеПодписанияСледующегоСкана(Результат, ВходящийКонтекст) Экспорт

	Выполнено = ВыполненоПодписаниеФайлаЗаявления(Результат, ВходящийКонтекст);
	
	Если Выполнено Тогда
		
		ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
		СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;

		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		ТекущийСкан.АдресПодписи = АдресФайлаПодписиФайлаЗаявления(Результат, ВходящийКонтекст);
		
		ДобавитьПодписьКФайлуЗаявления(
			ТекущийСкан.АдресПодписи, 
			ТекущийСкан.ПрисоединенныйФайл, 
			ВходящийКонтекст.ДокументЗаявление.Ссылка);
		
		ВходящийКонтекст.ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана + 1;
		
		СформироватьИОтправить_ПодписатьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеОтветаНаВопрос(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Истина Тогда
		
		ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
		
		ИзменитьПризнакБезбумажногоПродления(ДокументЗаявление.Ссылка);
		
		Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
			СформироватьИОтправитьЗаявлениеВМоделиСервисов(ДокументЗаявление, ВходящийКонтекст.ВыполняемоеОповещение);
		Иначе
			ВходящийКонтекст.Вставить("ПодписатьМетодомБРО", Ложь);
			ЗаявлениеЗашифровать(ВходящийКонтекст);
		КонецЕсли;
		
	Иначе
		
		Если ВходящийКонтекст.Свойство("ВыполняемоеОповещение") Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("Выполнено",   Ложь);
			ДополнительныеПараметры.Вставить("ТекстОшибки", НСтр("ru = 'Пользователь отказался от продления без использования электронной подписи';
																|en = 'Пользователь отказался от продления без использования электронной подписи'"));
			 
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьПризнакБезбумажногоПродления(ДокументЗаявление)
	
	ДокументОбъект = ДокументЗаявление.ПолучитьОбъект();
	ДокументОбъект.ПодписатьЭП = Ложь;
	ДокументОбъект.ТребуетсяВстречаСПартнером = Истина;
	ДокументОбъект.Записать();
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьИОтправить_ПолучитьПрисоединенныеФайлы(ВходящийКонтекст)
	
	ФайлыЗаявления = Новый Массив;
	
	ДокументЗаявление 	= ВходящийКонтекст.ДокументЗаявление;
	ВидыДокументов 		= ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоВходящемуКонтексту(ВходящийКонтекст);
	
	ИдентификаторыМЧД = ОбработкаЗаявленийАбонентаКлиентСервер.СоответствиеИДиМЧД(ДокументЗаявление);
	
	Для Каждого ЭлектронныйДокумент Из ДокументЗаявление.ЭлектронныеДокументы Цикл
		
		ЕстьОшибка = 
			НЕ (ЗначениеЗаполнено(ЭлектронныйДокумент.Документ)
			И ВидыДокументов.Свойство(ЭлектронныйДокумент.Документ))
			И НЕ ЭтоДокументыДляДЛУЦ(ДокументЗаявление, ЭлектронныйДокумент.Документ);
		
		Если ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеФайла = РаботаСФайламиКлиент.ДанныеФайла(ЭлектронныйДокумент.Файл, УникальныйИдентификатор, Истина);
		
		ВидДокумента = ОбработкаЗаявленийАбонентаКлиентСервер.ВидДокументаЗаявленияСкорректированный(ЭлектронныйДокумент);
		
		НовыйСкан = ШаблонФайлаЗаявления(ДокументЗаявление.ПодписатьЭП);
		НовыйСкан.Вставить("ВидДокумента", 		 ВидДокумента);
		НовыйСкан.Вставить("Наименование", 		 ДанныеФайла.Наименование);
		НовыйСкан.Вставить("АдресДанных", 		 ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		НовыйСкан.Вставить("Расширение", 		 ДанныеФайла.Расширение);
		НовыйСкан.Вставить("ПрисоединенныйФайл", ЭлектронныйДокумент.Файл);
		
		СформироватьИОтправить_ДополнитьДаннымиМЧД(
			НовыйСкан, 
			ЭлектронныйДокумент, 
			ИдентификаторыМЧД);
		
		ФайлыЗаявления.Добавить(НовыйСкан);
		
	КонецЦикла;
	
	Возврат ФайлыЗаявления;
	
КонецФункции

&НаКлиенте
Функция ЭтоДокументыДляДЛУЦ(ДокументЗаявление, Документ)
	
	Возврат ДокументЗаявление.ЭтоУдаленноеПереизданиеСертификата
		И (Документ = "ЗаявлениеНаИзготовлениеСертификата" ИЛИ Документ = "ЗаявлениеНаОтзывСертификата");
	
КонецФункции

&НаКлиенте
Процедура СформироватьИОтправить_ДополнитьДаннымиМЧД(
		НовыйСкан, 
		ЭлектронныйДокумент,
		ИдентификаторыМЧД)
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент.МЧД) Тогда
		
		ИД_МЧД = ИдентификаторыМЧД.Получить(ЭлектронныйДокумент.МЧД);
		
		Если ЭлектронныйДокумент.ЭтоМЧД Тогда
			НовыйСкан.Вставить("идентификаторДокумента", ИД_МЧД);
		КонецЕсли;
		
		Если ЭлектронныйДокумент.ЭтоПодписьКМЧД Тогда
			НовыйСкан.Вставить("идентификаторДокументаРодителя", ИД_МЧД);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ШаблонФайлаЗаявления(ПодписатьЭП)
	
	Файл = Новый Структура;
	Файл.Вставить("ВидДокумента", 		 "");
	Файл.Вставить("Наименование", 		 "");
	Файл.Вставить("АдресДанных", 		 "");
	Файл.Вставить("ИмяФайлаДанных", 	 СгенерироватьИмяФайлаДокументаВСоставеПакета());
	Файл.Вставить("Расширение", 		 "");
	Файл.Вставить("ПрисоединенныйФайл",  Неопределено);
	Файл.Вставить("идентификаторДокумента", ОбщегоНазначенияЭДКОКлиентСервер.НовыйИдентификатор());
	Файл.Вставить("идентификаторДокументаРодителя", "");
	
	Файл.Вставить("АдресПодписи", "");
	Если ПодписатьЭП Тогда
		Файл.Вставить("ИмяФайлаПодписи", СгенерироватьИмяФайлаДокументаВСоставеПакета());
	Иначе
		Файл.Вставить("ИмяФайлаПодписи", "");
	КонецЕсли;
		
	Возврат Файл;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСертификатИзЗаявленияНаСервере(ДокументЗаявление)
	
	Если ДокументЗаявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное Тогда
		Возврат ДокументЗаявление.РеквизитыСертификата.Получить();
	Иначе
		Возврат ДокументЗаявление.Сертификат.Получить();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПрисоединитьФайлЗаявления(Заявление, АдресФайлаВоВременномХранилище, ИмяДокумента, РасширениеБезТочки = "xml")
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПрисоединитьФайлЗаявления(Заявление, АдресФайлаВоВременномХранилище, ИмяДокумента, РасширениеБезТочки);

КонецФункции

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеШифрованияФайлаЗаявления(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	Если Результат.Выполнено Тогда
		
		Если ДополнительныеПараметры.Свойство("СканыКЗаявлению")
			И (ДополнительныеПараметры.ЭтоЗаявлениеНаИзменение ИЛИ ДополнительныеПараметры.ЭтоЗаявлениеНаПодключение) Тогда
			
			ДополнительныеПараметры.Вставить("ИндексТекущегоСкана", 0);
			ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ДополнительныеПараметры);
				
		Иначе
			СформироватьИОтправитьФайлыЗаявления(Результат, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		НастройкиПользователя = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
		Если ТипЗнч(НастройкиПользователя) <> Тип("Структура") Тогда
			Результат = Новый Структура("ТекстОшибки", НСтр("ru = 'Не удалось определить параметры для шифрования.';
															|en = 'Не удалось определить параметры для шифрования.'"));
		КонецЕсли;	
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
		
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ВходящийКонтекст) Экспорт
	
	ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана;
	СканыКЗаявлению 	= ВходящийКонтекст.СканыКЗаявлению;
	
	Если ИндексТекущегоСкана = СканыКЗаявлению.Количество() Тогда
		
		Результат = Новый Структура("Выполнено", Истина);
		СформироватьИОтправитьФайлыЗаявления(Результат, ВходящийКонтекст);
	
	Иначе
		
		ТекущийСкан = СканыКЗаявлению[ИндексТекущегоСкана];
		
		АдресРезультата = ПоместитьВоВременноеХранилище(, Новый УникальныйИдентификатор);
			
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифровать_ПослеШифрованияСледующегоСкана", ЭтотОбъект, ВходящийКонтекст);
		
		ОписаниеСкана    = Новый Структура("Адрес,Имя", ТекущийСкан.АдресДанных, "file");
		ЗначениеВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеСкана);
		
		ТекущийСкан.АдресДанных = ОперацииСФайламиЭДКОВызовСервера.УпаковатьФайлы(
			ЗначениеВМассиве, 
			ТекущийСкан.АдресДанных);
			
		МассивСертификатов = Новый Массив;
		МассивСертификатов.Добавить(ВходящийКонтекст.СвойстваСертификатаОператораСвязи);

		// Шифруем файл заявления.
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
			ОписаниеОповещения, 
			ТекущийСкан.АдресДанных, 
			МассивСертификатов,
			ТекущийСкан.АдресДанных,
			ВходящийКонтекст.ВыводитьСообщения);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифровать_ПослеШифрованияСледующегоСкана(Результат, ВходящийКонтекст) Экспорт

	Если Результат.Выполнено Тогда
		
		ВходящийКонтекст.ИндексТекущегоСкана = ВходящийКонтекст.ИндексТекущегоСкана + 1;
		ЗаявлениеЗашифровать_ЗашифроватьСканыКЗаявлениюВЦикле(ВходящийКонтекст);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РеквизитСертификатаДляПодписания(Сертификат2, КлючСертификатаДляПодписания)
	
	ВладелецСертификат = ДокументооборотСКОКлиентСервер.ВладелецСертификат(Сертификат2);
	Возврат РеквизитСертификата(ВладелецСертификат, КлючСертификатаДляПодписания);
	
КонецФункции

&НаКлиенте
Функция РеквизитНовогоСертификата(Сертификат1, КлючНовогоСертификат)
	
	Если Сертификат1.НайтиПоЗначению(КлючНовогоСертификат) <> Неопределено Тогда
		Возврат Сертификат1.НайтиПоЗначению(КлючНовогоСертификат).Представление;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ДобавитьСтрокуВТаблицуСравнения(
		Таблица,
		Представление,
		Сертификат1,
		Имя1,
		Сертификат2,
		Имя2)
		
	Значение1 = РеквизитНовогоСертификата(Сертификат1, Имя1);
	Значение2 = РеквизитСертификатаДляПодписания(Сертификат2, Имя2);
		
	НоваяСтрока = ДобавитьСтрокуВТаблицуСравненияПоЗначениям(
		Таблица,
		Представление,
		Значение1,
		Значение2);
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
Функция ДобавитьСтрокуВТаблицуСравненияПоЗначениям(
		Таблица,
		Представление,
		Значение1,
		Значение2)
	
	НоваяСтрока = Таблица.Добавить();
	
	НоваяСтрока.Наименование        = Представление;
	НоваяСтрока.НовыйСертификат     = Значение1;
	НоваяСтрока.СтороннийСертификат = Значение2;
	
	Совпадают = ДокументооборотСКОКлиентСервер.ЗначенияСовпадают(
		НоваяСтрока.НовыйСертификат, 
		НоваяСтрока.СтороннийСертификат);
	
	НоваяСтрока.Различается = НЕ Совпадают;
	
	Возврат НоваяСтрока;
	
КонецФункции

&НаКлиенте
Процедура СформироватьИОтправитьЗаявление_ПослеПолученияНастроекШифрования(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	МодельХраненияКлюча = КриптографияЭДКОКлиентСервер.МодельХраненияЗакрытогоКлюча(МестоХраненияКлюча);
	НастройкиПользователя = ПодготовитьДанныеСервераШифрования(РезультатВыполнения, 
							ОбработкаЗаявленийАбонентаКлиентСервер.ПолучитьПараметрПодключения(ДокументЗаявление, "ИдентификаторСервера"));
	
	Если НастройкиПользователя <> Неопределено Тогда
		МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.СвойстваМестаХраненияКлюча(МодельХраненияКлюча, НастройкиПользователя);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ВходящийКонтекст);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявление_ПослеПолученияВременногоКаталога", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(ОписаниеОповещения);
	Иначе
		Результат = Новый Структура("ТекстОшибки", НСтр("ru = 'Не удалось определить параметры для шифрования.';
														|en = 'Не удалось определить параметры для шифрования.'"));
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Результат);
	КонецЕсли;	

КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПодготовитьДанныеСервераШифрования(РезультатВыполнения, ОблачнаяПодписьИдентификаторСервера)
	
	Результат = Неопределено;
	
	Если НЕ КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЛогинШифрования = "UserEncryption"; // значение по-умолчанию
	ПарольШифрования = "password"; // значение по-умолчанию

	ИщемИдентификатор = ОблачнаяПодписьИдентификаторСервера;
	МассивСерверов = Неопределено;
	НашлиСервер = Неопределено;
	
	Если РезультатВыполнения = Неопределено Тогда
		ПараметрыФункции = Новый Структура();
		ПараметрыФункции.Вставить("СпецоператорСвязи", Перечисления.СпецоператорыСвязи.КалугаАстрал); 
		ПараметрыФункции.Вставить("ВнутреннийИдентификатор", ИщемИдентификатор); 
		МассивСерверов = ДокументооборотСКО.ПолучитьОбработкуЭДО().ОбменССерверомСписокСерверовОблачнойПодписи(ПараметрыФункции);
	ИначеЕсли РезультатВыполнения.Статус = "Выполнено" Тогда
		МассивСерверов = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
	КонецЕсли;
	
	Если МассивСерверов <> Неопределено Тогда
		Для Каждого СтрокаМассива Из МассивСерверов Цикл
			Если СтрокаМассива.ВнутреннийИдентификатор = ИщемИдентификатор Тогда
				Если ЗначениеЗаполнено(СтрокаМассива.Ссылка) Тогда
					НашлиСервер = СтрокаМассива.Ссылка;
				Иначе
					НашлиСервер = СтрокаМассива;
					ЛогинШифрования = НашлиСервер.ПользовательШифрования;
					ПарольШифрования = НашлиСервер.ПарольПользовательШифрования;
					Прервать;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НашлиСервер <> Неопределено Тогда
		НастройкиПользователя = Неопределено;
		
		МодульСервисКриптографииDSSПодтверждениеСервер = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSПодтверждениеСервер");
		МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
		ИмяПеречисления = "СпособыАвторизацииDSS";
		СпособыАвторизацииDSS = Перечисления[ИмяПеречисления];
		
		МодульСервисКриптографииDSSПодтверждениеСервер.ДополнитьНастройкиПользователя(НастройкиПользователя, НашлиСервер, ЛогинШифрования);
		НастройкиПользователя.Пароль = МодульСервисКриптографииDSSКлиентСервер.ОбъектПароля(ПарольШифрования);
		НастройкиПользователя.ПервичнаяАутентификация = СпособыАвторизацииDSS.Первичный_УчетныеДанные;
		
		Результат = НастройкиПользователя;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьСканыКЗаявлениюПакетно(ВходящийКонтекст) Экспорт
	
	Сертификат = ВходящийКонтекст.Сертификат;
	СканыКЗаявлению = ВходящийКонтекст.СканыКЗаявлению;
	ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	МестоХраненияКлюча	= КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	
	ПараметрыЦикла = НовыЙ Структура();
	ПараметрыЦикла.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ПараметрыЦикла.Вставить("ДокументЗаявление", ДокументЗаявление);
	ПараметрыЦикла.Вставить("СканыКЗаявлению", СканыКЗаявлению);
	ПараметрыЦикла.Вставить("ПараметрыФункции", ВходящийКонтекст);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправить_ПодписатьСканыКЗаявлениюПакетноПослеВыполнения", ЭтотОбъект, ПараметрыЦикла);
	
	МассивДокументов = Новый Массив;
	Для Счетчик = 0 По СканыКЗаявлению.ВГраница() Цикл
		ТекущийСкан = СканыКЗаявлению[Счетчик];
		НовыйДокументПакетнойПодписи(
			МассивДокументов,
			ТекущийСкан.АдресДанных,
			ТекущийСкан.Наименование,
			ТекущийСкан.Расширение,
			Счетчик);
	КонецЦикла;

	ПараметрыОперации = Новый Структура("ПодтверждатьОперацию", Ложь);
	ПакетнаяПодписьОблачнойПодписи(ОписаниеОповещения, МестоХраненияКлюча, МассивДокументов, Сертификат, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИОтправить_ПодписатьСканыКЗаявлениюПакетноПослеВыполнения(РезультатВыполнения, ВходящийКонтекст) Экспорт

	СканыКЗаявлению = ВходящийКонтекст.СканыКЗаявлению;
	ДокументЗаявление = ВходящийКонтекст.ДокументЗаявление;
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ПараметрыФункции = ВходящийКонтекст.ПараметрыФункции;
	
	Если РезультатВыполнения.Выполнено Тогда
		Для Счетчик = 0 По РезультатВыполнения.Результат.ВГраница() Цикл
			ТекущийСкан = СканыКЗаявлению[Счетчик];
			Подпись = РезультатВыполнения.Результат[Счетчик];
			ДобавитьПодписьКФайлуЗаявления(Подпись, ТекущийСкан.ПрисоединенныйФайл, ВходящийКонтекст.ДокументЗаявление.Ссылка);
		КонецЦикла;
		
		ЗаявлениеЗашифровать(ПараметрыФункции);
		
	Иначе
		ОтрицательныйОтвет = Новый Структура;
		ОтрицательныйОтвет.Вставить("Выполнено", Ложь);
		ОтрицательныйОтвет.Вставить("ОписаниеОшибки", РезультатВыполнения.Ошибка);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ОтрицательныйОтвет);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПодписатьЗаявлениеСтороннимСертификатом_Завершение(Результат, ПараметрыФункции) Экспорт
	
	Если Результат.Выполнено Тогда
		
		СформироватьИОтправить_ПослеПодписанияЗаявления(
			Результат.ПодписанноеСообщение, 
			ПараметрыФункции);
			
	Иначе
		
		СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(
			ПараметрыФункции, 
			Результат.ТекстОшибки);
			
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Функция ВыполненоПодписаниеФайлаЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
	ВыполненоПодписаниеПлатформой  = ВходящийКонтекст.ПодписатьПлатформой;
	ВыполненоПодписаниеМетодомБРО = ВходящийКонтекст.ПодписатьМетодомБРО И Результат.Выполнено;
	
	Выполнено = ВыполненоПодписаниеПлатформой ИЛИ ВыполненоПодписаниеМетодомБРО;
	
	Возврат Выполнено;
	
КонецФункции

&НаКлиенте
Функция АдресФайлаПодписиФайлаЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	
	// Из-за того, что подписание выполняется методом компоненты или платформы, то результат возвращается разный
	Если ВходящийКонтекст.ПодписатьМетодомБРО Тогда
		Адрес = Результат.ФайлПодписи;
	Иначе
		Адрес = ПоместитьВоВременноеХранилище(Результат, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ПодписатьСканыСтороннимСертификатом(ПараметрыФункции)
		
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПодписатьСканыСтороннимСертификатом_Завершение", 
		ЭтотОбъект, 
		ПараметрыФункции);
		
	ТекущийСкан = ПараметрыФункции.СканыКЗаявлению[ПараметрыФункции.ИндексТекущегоСкана];
				
	ДокументЗаявление       = ПараметрыФункции.ДокументЗаявление;
	ДвДанныеДляПодписания   = ПолучитьИзВременногоХранилища(ТекущийСкан.АдресДанных);
	ТипКриптопровайдера     = ДокументЗаявление.ТипКриптопровайдера;
	СертификатДляПодписания = ОбработкаЗаявленийАбонентаВызовСервера.СертификатИзЗаявления(ДокументЗаявление);
			
	ОбработкаЗаявленийАбонентаКлиент.ПодписатьЗаявлениеСтороннимСертификатом(
		ЭтотОбъект, 
		ОписаниеОповещения, 
		ДвДанныеДляПодписания, 
		СертификатДляПодписания,
		ТипКриптопровайдера);
		
КонецПроцедуры

