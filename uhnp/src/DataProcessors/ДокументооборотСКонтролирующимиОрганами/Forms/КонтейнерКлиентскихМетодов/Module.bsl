				КонецЕсли;
				
				ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
				
			КонецЕсли;
			
		Иначе
			
			ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, НоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Результат);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаФССЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ОбъектНоваяУчетнаяЗапись = ДополнительныеПараметры.НоваяУчетнаяЗапись;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	СтруктураАвтонастройкиРПН = ДополнительныеПараметры.СтруктураАвтонастройкиРПН;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	СтруктураАвтонастройкиФСС = ДополнительныеПараметры.СтруктураАвтонастройкиФСС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ФлагАвтозаполнения = СтруктураАвтонастройкиФСС.ФлагАвтозаполнения;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ФлагАвтозаполнения = Ложь;
	КонецЕсли;
	
	Если ФлагАвтозаполнения Тогда
		ОбновитьРегистрыСведенийНастройкиОбменаФСС(
			ПараметрыФункции.Организация,
			СтруктураАвтонастройкиФСС.ОтпечатокСертификата,
			СтруктураАвтонастройкиФСС.СертификатФССОтпечаток,
			СтруктураАвтонастройкиФСС.СертификатФССЭЛНОтпечаток,
			ВыводитьСообщения);
	КонецЕсли;
	
	ОбработатьОбновлениеНастройкаРПН(СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ПараметрыФункции, ВыводитьСообщения, ЭтоНоваяУчетнаяЗапись, ОбъектНоваяУчетнаяЗапись, ВременныйКаталог, ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаРПН(
		СтруктураАвтонастройкиРПН, 
		СтруктураАвтонастройкиФТС, 
		ПараметрыФункции, 
		ВыводитьСообщения, 
