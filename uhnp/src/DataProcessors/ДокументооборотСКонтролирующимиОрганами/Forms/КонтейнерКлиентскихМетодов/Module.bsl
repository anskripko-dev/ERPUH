&НаКлиенте
Процедура ПечатьСоглашенияобОказанииУслуг(Знач Документ) Экспорт
	
	СпецоператорСвязи = ПолучитьРеквизит(Документ, "СпецоператорСвязи");
	Если НЕ ЗначениеЗаполнено(СпецоператорСвязи) тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не выбран Удостоверяющий центр в документе %1.';
				|en = 'Не выбран Удостоверяющий центр в документе %1.'"), Строка(Документ));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	иначе
		
		ТабДок = ТабДокСоглашения(Документ);
		НапечататьДокумент(ТабДок, "Соглашение об оказании услуг");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПодменитьДанныеУЦ(Заявление, ПараметрыСпецОператора)
	
	ДанныеУЦ = ДанныеУЦ(Заявление);
	
	Если ПараметрыСпецОператора.Свойство("НаименованиеУЦ") Тогда
		ПараметрыСпецОператора.НаименованиеУЦ = ДанныеУЦ.НаименованиеУЦ;
	КонецЕсли;
	
	Если ПараметрыСпецОператора.Свойство("АдресРегламентУЦ") Тогда
		ПараметрыСпецОператора.АдресРегламентУЦ = ДанныеУЦ.РегламентУЦ;
	КонецЕсли;
	
	Если ПараметрыСпецОператора.Свойство("ЗаявлениеПолучатель") Тогда
		ПараметрыСпецОператора.ЗаявлениеПолучатель = ДанныеУЦ.ПолучательЗаявленияВУЦ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТабДокСоглашения(Знач Заявление) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ПараметрыСпецОператора = КонтекстЭДОСервер.ПолучитьПараметрыОператораСвязи(Заявление.СпецоператорСвязи);
	
	ПодменитьДанныеУЦ(Заявление, ПараметрыСпецОператора);
	
	Возврат ПодготовитьМакет(Заявление, ПараметрыСпецОператора, "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьСоглашение","ПечатьСоглашение");
	
КонецФункции

&НаКлиенте
Функция HTMLДокСоглашения(Заявление) Экспорт
	
	СтруктураДанныхСпецоператорыСвязи = Новый Структура;
	ЗаполнитьДанныеСпецоператораСвязи(СтруктураДанныхСпецоператорыСвязи);
	
	ТекстДляЗамены = Строка(СтруктураДанныхСпецоператорыСвязи.ТекстМакетаСоглашение); // ПечатьСоглашениеHTML
	
	СтруктураПараметра = Новый Структура("НаименованиеУЦ,АдресРегламентУЦ,СетьДоверенныхУЦ,СуммаОтветственностиУЦ,НаименованиеПОРаспространяемогоУЦ");
	
	СпецоператорСвязи = ЗначенияРеквизитовОбъекта(Заявление, "СпецоператорСвязи").СпецоператорСвязи;
	
	ПараметрыСпецоператора = ПолучитьПараметрСпецоператораКлиент(
		СпецоператорСвязи,
		СтруктураПараметра,
		СтруктураДанныхСпецоператорыСвязи.Макет);
		
	ПодменитьДанныеУЦ(Заявление, ПараметрыСпецОператора);
	
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#НаименованиеУЦ#",ПараметрыСпецоператора.НаименованиеУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#АдресРегламентУЦ#",ПараметрыСпецоператора.АдресРегламентУЦ);
	ТекстДляЗамены = СтрЗаменить(ТекстДляЗамены,"#НаименованиеПОРаспространяемогоУЦ#",ПараметрыСпецоператора.НаименованиеПОРаспространяемогоУЦ);
	
	Возврат ТекстДляЗамены;
	
КонецФункции

&НаКлиенте
Процедура ПечатьЛицензииОбИспользованииПО(Знач Заявление) Экспорт
	
	ТабДок = ТабДокЛицензии(Заявление);
	ЗаголовокФормы = "Лицензия";
		
	НапечататьДокумент(ТабДок, ЗаголовокФормы);
	
КонецПроцедуры

&НаСервере
Функция ТабДокЛицензии(Заявление) Экспорт
	
	Спецоператор   = Заявление.СпецоператорСвязи;
	НаименованиеПО = ДокументооборотСКОПовтИсп.ПолучитьПараметрСпецоператора(Спецоператор, "НаименованиеПОРаспространяемогоУЦ");
	
	Макет  = ПолучитьМакетОбработки("ПечатьЛицензия");
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьЛицензия";

	ОбластьМакета = Макет.ПолучитьОбласть("Лицензия");
	
	Если Заявление.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено Тогда
		// По просьбе Калуги-Астрал
		ОбластьМакета.Параметры.Фирма = "";
	Иначе
		ОбластьМакета.Параметры.Фирма = Заявление.КраткоеНаименование;
	КонецЕсли;
	
	ОбластьМакета.Параметры.НаименованиеПОРаспространяемогоУЦ = НаименованиеПО;
	
	УчетнаяЗапись = Заявление.УчетнаяЗапись;
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		ОбластьМакета.Параметры.ДатаВыдачи = Формат(УчетнаяЗапись.ЛицензияДатаНачала, "ДЛФ=D");
		
		Число = РазницаДатВМесяцах(УчетнаяЗапись.ЛицензияДатаОкончания, УчетнаяЗапись.ЛицензияДатаНачала);
		ОбластьМакета.Параметры.Число = Число;
		
	Иначе
		ОбластьМакета.Параметры.Число = 12;
	КонецЕсли;
		
	ТабДок.Вывести(ОбластьМакета);
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция РазницаДатВМесяцах(ДатаБольшая, ДатаМеньшая) Экспорт
	
	Годы    = Год(ДатаБольшая) - Год(ДатаМеньшая);
	Месяцы  = Месяц(ДатаБольшая) - Месяц(ДатаМеньшая);
	
	Разность = Месяцы + Годы * 12;
	
	Возврат Разность;
	
КонецФункции 

&НаКлиенте
Процедура ПечатьСертификатаПользователя(Знач Документ) Экспорт
	
	Если ОбработкаЗаявленийАбонентаВызовСервера.ЭтоРуководитель(Документ) Тогда
		
		Текст = НСтр("ru = 'Печать сертификата для руководителей не требуется';
					|en = 'Печать сертификата для руководителей не требуется'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
		Возврат;
		
	ИначеЕсли ОбработкаЗаявленийАбонентаВызовСервера.ЭтоБюджетополучатель(Документ) Тогда
		
		Текст = НСтр("ru = 'Печать сертификата для бюджетополучателей не требуется';
					|en = 'Печать сертификата для бюджетополучателей не требуется'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
	
	УчетнаяЗапись = ПолучитьУчетнуюЗапись(Документ);
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(УчетнаяЗапись);
		
	Если ПолучитьРеквизит(Документ, "Статус")<> СтруктураСсылочныхДанных.Перечисления_СтатусыЗаявленияАбонентаСпецоператораСвязи_Одобрено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Сертификат можно распечатать только после создания учетной записи.';
				|en = 'Сертификат можно распечатать только после создания учетной записи.'"));
		Возврат;
	КонецЕсли;
	
	Сертификат = МультирежимВызовСервера.СертификатПользователя(УчетнаяЗапись);
	Если НЕ Сертификат.Найден Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Сертификат.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, Сертификат);
	
	СертификатыПользователя = Новый Массив;
	СертификатыПользователя.Добавить(Сертификат);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Документ", 		Документ);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", 	УчетнаяЗапись);
	ДополнительныеПараметры.Вставить("Сертификат", 		Сертификат);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПечатьСертификатаПослеПолученияСвойствСертификата", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.НайтиСертификаты(ОписаниеОповещения, СертификатыПользователя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСертификатаПослеПолученияСвойствСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено И Результат.Сертификаты.Количество() > 0 Тогда
	
		ВходящийКонтекст.Вставить("ДанныеСертификата", Результат.Сертификаты[0]);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПечатьСертификатаПослеПолученияТекстаСертификата", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(
			ОписаниеОповещения, 
			ВходящийКонтекст.Сертификат);
			
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Сертификат не найден';
										|en = 'Сертификат не найден'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСертификатаПослеПолученияТекстаСертификата(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ТекстСертификата 	= Результат.СтрокаBase64;
		ДанныеСертификата 	= ВходящийКонтекст.ДанныеСертификата;
		Документ			= ВходящийКонтекст.Документ;
		
		СтруктураПараметров = Новый Структура("Сертификат, ТекстСертификата, Заголовок", ДанныеСертификата, ТекстСертификата, "Сведения о сертификате");
		
		Макет = ПодготовитьМакет(Документ, СтруктураПараметров, "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьСертификат","ПечатьСертификат");
		НапечататьДокумент(Макет, "Сертификат пользователя");
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПечатьПакетаДокументов(Знач Документ, ВыполняемоеОповещение = Неопределено) Экспорт
	
	СпецоператорСвязи = ПолучитьРеквизит(Документ, "СпецоператорСвязи");	
	Если НЕ ЗначениеЗаполнено(СпецоператорСвязи) тогда
		Если ВыполняемоеОповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		КонецЕсли;
	Иначе
		
		СтруктураДокумента = ПолучитьКлючУникальности(Документ);          
		
		ПараметрыФормы = Новый Структура("СтруктураДокумента", СтруктураДокумента);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Документ",              Документ);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПечатьПакетаДокументовЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ОткрытьФорму(
			ПутьКОбъекту + ".Форма.ФормаПечатьПакетаДокументовДляПодключения", 
			ПараметрыФормы, 
			,
			, 
			, 
			, 
			ОписаниеОповещения, 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПакетаДокументовЗавершение(СписокПечати, ДополнительныеПараметры) Экспорт
	
	Документ = ДополнительныеПараметры.Документ;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если СписокПечати <> Неопределено Тогда
		НапечататьПакетДокументов(Документ, СписокПечати);
	КонецЕсли;
	Если ВыполняемоеОповещение <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Функция ПолучитьКлючУникальности(Документ)
	
	Возврат Новый Структура("Статус,УчетнаяЗапись,Организация",Документ.Статус,Документ.УчетнаяЗапись,Документ.Организация );
	
КонецФункции	

&НаКлиенте
Процедура НапечататьПакетДокументов(Объект,СписокДокументов)
	
	Если СписокДокументов.ПечататьЗаявление Тогда
		НапечататьЗаявлениеПо1СОтчетности(Объект);
	КонецЕсли;
	
	Если СписокДокументов.ПечататьСоглашение Тогда
		ПечатьСоглашенияобОказанииУслуг(Объект);
	КонецЕсли;
	
	Если СписокДокументов.ПечататьЛицензия Тогда
		ПечатьЛицензииОбИспользованииПО(Объект);
	КонецЕсли;
	
	Если СписокДокументов.ПечататьСертификат Тогда
		ПечатьСертификатаПользователя(Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКодПолучателяКонтролирующегоОргана(ДанныеОрганизации, ТипПолучателя) Экспорт

	КодПолучателя = ""; 
	
	Если ТипПолучателя = СтруктураСсылочныхДанных.Перечисления_ТипыКонтролирующихОрганов_ПФР Тогда
		
		Если ПустаяСтрока(ДанныеОрганизации.КодОрганаПФР) ИЛИ СтрДлина(ДанныеОрганизации.КодОрганаПФР) < 7 Тогда
			КодПолучателя = Лев(ДанныеОрганизации.РегНомПФР,7);
		Иначе
			КодПолучателя = ДанныеОрганизации.КодОрганаПФР;
		КонецЕсли;
		
	Иначе
		
		КодПодчФСС = "";
		Если ДанныеОрганизации.Свойство("КодПодчиненностиФСС",КодПодчФСС) Тогда
			КодПодчФСС = ДанныеОрганизации.КодПодчиненностиФСС;
		КонецЕсли;
		
		КодПолучателя = ПолучитьКодПодразделенияФССПоУмолчанию(КодПодчФСС,ДанныеОрганизации.ОбъектДополнительныйКодФСС,ДанныеОрганизации.РегистрационныйНомерФСС);
		
	КонецЕсли;
	
	Возврат КодПолучателя;	

КонецФункции

&НаКлиенте
Функция ПолучитьКодТОГСа(КодРегиона, Спецоператор, КодТОГСа = "") Экспорт

	Отделения = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ОтделенияРосстатаРегиона(
		КодРегиона,
		Спецоператор);
	
	Если Отделения.Количество() > 0 Тогда
		Возврат Отделения[0].КодТОГС;
	Иначе
		Возврат КодТОГСа;
		КонецЕсли;
			
КонецФункции	

