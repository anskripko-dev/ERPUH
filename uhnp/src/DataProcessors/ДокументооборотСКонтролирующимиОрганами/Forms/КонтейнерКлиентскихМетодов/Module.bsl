Функция СформироватьВложениеУведомлениеОбОтказеДокумент(ТранспортноеСообщение) Экспорт
	
	// проверяем, не сформировано ли уже уведомление об отказе
	ИмеющиесяУведомления = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Ложь, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент);
	Если ИмеющиесяУведомления.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипыДИВ = Новый Массив;
	ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ);
	ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
	
	ДИВы = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение.Основание, Ложь, ТипыДИВ);
	
	Если ДИВы.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось создать уведомление об отказе: отсутствует исходный документ в сообщении-основании.';
								|en = 'Не удалось создать уведомление об отказе: отсутствует исходный документ в сообщении-основании.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	ДИВы.Колонки.Добавить("ПодписьBase64");
	
	// формируем имя файла уведомления
	UUIDУведомления = СгенерироватьUUID();
	ИмяФайлаУведомления = СформироватьИмяФайлаУведомленияОбОтказеДокумент(ТранспортноеСообщение, ДИВы, UUIDУведомления);
	Если НЕ ЗначениеЗаполнено(ИмяФайлаУведомления) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось создать уведомление об отказе: не удалось сформировать имя файла уведомления.';
								|en = 'Не удалось создать уведомление об отказе: не удалось сформировать имя файла уведомления.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаОшибок = ПолучитьТаблицуОшибокОписиВходящихДокументов();
	Если ТаблицаОшибок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// формируем XML уведомления о приеме документа
	ТекстУведомления = СформироватьXMLУведомленияОбОтказеДокумента(ТранспортноеСообщение, ДИВы, ИмяФайлаУведомления, ТаблицаОшибок);
	Если НЕ ЗначениеЗаполнено(ТекстУведомления) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// пишем XML во временный файл в кодировке windows-1251
	ФайлУведомления = ВыгрузитьТекстВФайл(ТекстУведомления);
	Если НЕ ЗначениеЗаполнено(ФайлУведомления) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// загружаем файл извещения в ИБ
	ТипСодержимогоТранспортногоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент;
	
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
		ТранспортноеСообщение,
		ТипСодержимогоТранспортногоКонтейнера,
		ФайлУведомления,
		ИмяФайлаУведомления,,,,,,,
		UUIDУведомления,
		Перечисления.ТипыСодержимогоФайлов.xml) Тогда
		
		Возврат Ложь;
	КонецЕсли;
	
	// удаляем временный файл с уведомлением
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлУведомления);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьИмяФайлаКвитанции(ТранспортноеСообщение, ДИВы, UUID)
	
	Префикс = "KV";	
	
	// выделяем префикс из имени основного ДИВ основания
	ОсновнойДИВ = ДИВы.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ))[0];
	ИмяФайлаДИВ = ОсновнойДИВ.ИмяФайла;
	
	ПрефиксОснования = ВыделитьПрефиксИзИмениФайлаОснования(ИмяФайлаДИВ);
	Если НЕ ЗначениеЗаполнено(ПрефиксОснования) Тогда
		// если префикс выделить не удалось, то пишем хоть какой-нибудь (это лучше, чем не отправлять извещение вообще)
		ПрефиксОснования = "NO_PREF";
	КонецЕсли;
	
	ИдентификаторыПолучателя = ПолучитьИдентификаторыПолучателя(ТранспортноеСообщение.ЦиклОбмена);
	Если ИдентификаторыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторПолучателя 		 = ИдентификаторыПолучателя.ПромежуточныйНалоговыйОрган;
	ИдентификаторКонечногоПолучателя = ИдентификаторыПолучателя.КонечныйНалоговыйОрган;
	
	// формируем идентификатор отправителя
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателяИзВходящегоТребования(ТранспортноеСообщение.Основание);
	Если РеквизитыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(РеквизитыПолучателя.ИННЮЛ) 
	И ЗначениеЗаполнено(РеквизитыПолучателя.КПП) Тогда
		//налогоплательщик ЮЛ
		ИдентификаторОтправителя = РеквизитыПолучателя.ИННЮЛ + РеквизитыПолучателя.КПП;
    ИначеЕсли ЗначениеЗаполнено(РеквизитыПолучателя.ИННФЛ) Тогда
    	//налогоплательщик ФЛ
		ИдентификаторОтправителя = РеквизитыПолучателя.ИННФЛ;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	// формируем строку с текущей датой
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	
	// 
	ИдентификаторФайла = UUID;
	
	//
	РасширениеФайла = "xml";
	
	// собираем имя файла квитанции из составляющих
	ИмяФайлаквитанции = Префикс + "_" + ПрефиксОснования + "_" + ИдентификаторПолучателя + "_" + ИдентификаторКонечногоПолучателя + "_" + ИдентификаторОтправителя + "_" + GGGGMMDD + "_" + ИдентификаторФайла + "." + РасширениеФайла;
	Возврат ИмяФайлаКвитанции;
	
КонецФункции

