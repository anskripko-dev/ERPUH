&НаКлиенте
Процедура РасшифроватьТранспортноеСообщение(
		Объект,
		ВыполняемоеОповещение = Неопределено,
		ПараметрыПоказа = Неопределено,
		ПараметрыОперации = Неопределено) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(Объект);
	
	ТипСообщения = Неопределено;
	ФорматДокументооборота = Неопределено;
	
	СсылкаНаОбъект = ?(ТипЗнч(Объект) = Тип("ДокументСсылка.ТранспортноеСообщение"), Объект, Объект.Ссылка);
			
	// Получаем Контейнер, распаковываем файлы, разбираем XML
	// возвращает "Булево" или "тип сообщения"
	ПеремещенВАрхив = Ложь;
	Результат = ОбработатьСодержимоеТранспортногоКонтейнера(СсылкаНаОбъект, ПеремещенВАрхив);
	
	ЕстьПраво = МультирежимВызовСервера.ЕстьПравоНаТранспортноеСообщение(СсылкаНаОбъект);
	Если НЕ ЕстьПраво Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	АлгоритмШифрованияОбязателен = Ложь;
	Если ТипЗнч(Результат) = Тип("Булево") Тогда 
		Если ПеремещенВАрхив = Истина И ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОперации, "РасшифровкаОдного") = Истина Тогда
			ПолучениеПеремещенныхФайлов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект), Неопределено, "Расшифровка", Неопределено);
		Иначе
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		КонецЕсли;
		Возврат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда 
		Если НЕ Результат.Свойство("ТипСообщения", ТипСообщения) Тогда 
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
			Возврат;
		КонецЕсли;
		Результат.Свойство("ФорматДокументооборота", ФорматДокументооборота);
		Результат.Свойство("АлгоритмШифрованияОбязателен", АлгоритмШифрованияОбязателен);
	КонецЕсли;
	
	Если ДокументыПакета.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	Если ТипСообщения = "ЦБ" Тогда
		ФайлОписанияСведений = Новый Массив;
		ИмяФайлаСтатуса = ВРЕГ("status.xml");
		ИмяФайлаИнформацииСтатуса = ВРЕГ("StatusInfo.xml");
		Для каждого СтрокаРаспакованныхФайлов Из ТаблицаРаспакованныхФайлов Цикл
			ИмяРаспакованногоФайла = ВРЕГ(СтрокаРаспакованныхФайлов.Имя);
			Если ИмяФайлаСтатуса = ИмяРаспакованногоФайла ИЛИ ИмяФайлаИнформацииСтатуса = ИмяРаспакованногоФайла Тогда
				ФайлОписанияСведений.Добавить(СтрокаРаспакованныхФайлов);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ФайлОписанияСведений = ТаблицаРаспакованныхФайлов.НайтиСтроки(Новый Структура("Имя", "packageDescription.xml"));
	КонецЕсли;
	
	Если ФайлОписанияСведений.Количество() = 0 Тогда
		Если ТипСообщения = "ПФР" Тогда
			Для каждого РаспакованныйФайл Из ТаблицаРаспакованныхФайлов Цикл
				СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(РаспакованныйФайл.Имя);
				ИмяФайлаВРег = СокрЛП(СтруктураИмениФайла.ИмяБезРасширения);
				ИмяФайлаВРег = ВРег(ИмяФайлаВРег);
				РасширениеФайла = СокрЛП(СтруктураИмениФайла.Расширение);
				Если (Лев(ИмяФайлаВРег, 4) = "ПФР_" ИЛИ Лев(ИмяФайлаВРег, 4) = "СФР_")
					И СтрНайти(ИмяФайлаВРег, "_ОСП_") > 0 И нрег(РасширениеФайла) = ".xml" Тогда
					
					ФайлОписанияСведений.Добавить(РаспакованныйФайл);
					ФорматДокументооборота = ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ФайлОписанияСведений.Количество() = 0 Тогда
			ТекстСообщения = ?(ТипСообщения = "ПФР",
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания пакета (ПФР_*_ОСП_*.xml или packageDescription.xml).';
					|en = 'Ошибка распаковки пакета: не найден файл описания пакета (ПФР_*_ОСП_*.xml или packageDescription.xml).'"),
				?(ТипСообщения = "ЦБ",
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания сведений (status.xml или StatusInfo.xml).';
					|en = 'Ошибка распаковки пакета: не найден файл описания сведений (status.xml или StatusInfo.xml).'"),
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания пакета (packageDescription.xml).';
					|en = 'Ошибка распаковки пакета: не найден файл описания пакета (packageDescription.xml).'")));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// расшифровываем содержимое
	// из свойств транспортного сообщения получим учетную запись, оттуда получим отпечаток сертификата получателя, которым зашифрован пакет
	СертификатПолучателя = ПолучитьОтпечатокСертификатаПолучателя(СсылкаНаОбъект);
	
	КонтекстРасшифровки = Новый Структура;
	КонтекстРасшифровки.Вставить("СертификатПолучателя", СертификатПолучателя);
	КонтекстРасшифровки.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
	КонтекстРасшифровки.Вставить("ТипСообщения", ТипСообщения);
	КонтекстРасшифровки.Вставить("ФорматДокументооборота", ФорматДокументооборота);
	КонтекстРасшифровки.Вставить("ТекущийДокумент", 0);
	КонтекстРасшифровки.Вставить("ОповещениеОЗавершении", ВыполняемоеОповещение);
	КонтекстРасшифровки.Вставить("ПараметрыПоказа", ПараметрыПоказа);
	КонтекстРасшифровки.Вставить("АлгоритмШифрованияОбязателен", АлгоритмШифрованияОбязателен);
	
	Если ЭтоОблачнаяПодпись(СертификатПолучателя) 
		ИЛИ ЭтоПодписьСервиса(СертификатПолучателя) Тогда
	// обходим ограничения платформы на размер стека рекурсивного вызова оповещений
		КонтекстОтложеннойОперации = КонтекстРасшифровки;
		ПодключитьОбработчикОжидания("ВыполнитьРасшифровкуСообщенийПоследовательноОтложенно", 0.1, Истина);
	Иначе
		ВыполнитьРасшифровкуСообщенийПоследовательно(КонтекстРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьСообщенияСЭДО(
	ОписаниеОповещения,
	Организация,
	НомерОбъекта,
	ДополнительныеПараметры)
	
	КоличествоРасшифрованных 	= ДополнительныеПараметры.КоличествоРасшифрованных;
	КоличествоНеРасшифрованных 	= ДополнительныеПараметры.КоличествоНеРасшифрованных;
	ВсегоСообщений				= ДополнительныеПараметры.ВсегоСообщений;
	
	Для ИндексСообщения = НомерОбъекта + 1 По СообщенияТребующиеРасшифровки.Количество() - 1 Цикл
		Сообщение = СообщенияТребующиеРасшифровки[ИндексСообщения];
		Если ЗначениеЗаполнено(Сообщение.ТранспортноеСообщение)
			ИЛИ НЕ Организация = Сообщение.Организация Тогда
			Прервать;
		КонецЕсли;
		НомерОбъекта = НомерОбъекта + 1;
	КонецЦикла;
	ДополнительныеПараметры.НомерОбъекта = НомерОбъекта;
	
	ТекущиеУчетныеЗаписиСтрахователяФСС = ПолучитьТекущиеУчетныеЗаписиСтрахователяФСС();
	Если НЕ ТекущиеУчетныеЗаписиСтрахователяФСС.Найти(Организация) = Неопределено Тогда
		
		ДополнительныеПараметрыЭтапаРасшифровки = Новый Структура();
		ДополнительныеПараметрыЭтапаРасшифровки.Вставить("КоличествоПройденныхЭтапов", 	КоличествоРасшифрованных + КоличествоНеРасшифрованных);
		ДополнительныеПараметрыЭтапаРасшифровки.Вставить("ОбщееКоличествоЭтапов", 		ВсегоСообщений);
		ДополнительныеПараметрыЭтапаРасшифровки.Вставить("ТекущаяОрганизация", 			Организация);
		
		ДлительнаяОтправкаКлиент.ОповеститьОСменеЭтапаРасшифровки(ДополнительныеПараметрыЭтапаРасшифровки);
		
		// Получаем содержимое входящих сообщений по организации.
		Оповещение = Новый ОписаниеОповещения("ПолучитьВходящиеСообщенияСЭДОФССПоОрганизациямПослеЗапроса",
			ЭтотОбъект,
			ДополнительныеПараметры);
			Организации = ЗначениеВКоллекцию(Организация);
		
		ПолучитьВходящиеСообщенияСЭДОФСС(Оповещение, Организации, Ложь, Ложь);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьИсходныеИменаФайлов(Объект)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();	
	КонтекстЭДОСервер.ВосстановитьИсходныеИменаФайлов(Объект, ДокументыПакета);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(ОбъектСсылка, ПроанализироватьРассылкиПриАвтоподтверждении = Ложь)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();	
	Возврат КонтекстЭДОСервер.ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(ОбъектСсылка, ПроанализироватьРассылкиПриАвтоподтверждении);
	
КонецФункции

&НаКлиенте
Процедура СоздатьПодтверждениеПриНеобходимости(ОповещениеОЗавершении, СсылкаНаОбъект, Вручную = Ложь)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Результат = ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(СсылкаНаОбъект, Истина);
	
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ЗапрещеноАвтоподтверждение = НЕ Результат.Автоподтверждение;
	
	Если ЗапрещеноАвтоподтверждение И НЕ Вручную Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	ТипСообщения = Результат.Тип;
	
	// формируем подтверждение на расшифрованное сообщение при необходимости
	Если Результат.ТребуетсяПодтверждение Тогда
	 
 		Контекст = Новый Структура;
		Контекст.Вставить("ОповещениеОЗавершении", 	ОповещениеОЗавершении);
		Контекст.Вставить("СсылкаНаОбъект", 		СсылкаНаОбъект);

		Оповещение = Новый ОписаниеОповещения(
			"СоздатьПодтверждениеПриНеобходимостиПослеСоздания",
			ЭтотОбъект,
			Контекст);
			
		ЭтоОтправкаПодтвержденияИзПанелиОтправки = 
			ТипЗнч(ОповещениеОЗавершении.ДополнительныеПараметры) = Тип("Структура")
			И ОповещениеОЗавершении.ДополнительныеПараметры.Свойство("ЭтоОтправкаПодтвержденияИзПанелиОтправки");
			
		Если ЭтоОтправкаПодтвержденияИзПанелиОтправки Тогда

			Если СообщениеРасшифровано(СсылкаНаОбъект) Тогда
				СоздатьПодтверждение(Оповещение, СсылкаНаОбъект);
			Иначе
				
				ДополнительныеПараметры = Новый Структура();
				ДополнительныеПараметры.Вставить("Оповещение", 		Оповещение);
				ДополнительныеПараметры.Вставить("СсылкаНаОбъект", 	СсылкаНаОбъект);
				ДополнительныеПараметры.Вставить("ЭтоОтправкаПодтвержденияИзПанелиОтправки", Истина);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"СоздатьПодтверждениеПослеРасшифровки", 
					ЭтотОбъект, 
					ДополнительныеПараметры);
					
				РасшифроватьТранспортноеСообщение(СсылкаНаОбъект, ОписаниеОповещения);
				
			КонецЕсли;
			
		Иначе
			СоздатьПодтверждение(Оповещение, СсылкаНаОбъект);
		КонецЕсли;
		
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПодтверждениеПослеРасшифровки(Результат, ВходящийКонтекст) Экспорт
	
	Оповещение 		= ВходящийКонтекст.Оповещение;
	СсылкаНаОбъект 	= ВходящийКонтекст.СсылкаНаОбъект;
	
	Если Результат = Истина // Может быть Неопределено 
		И СообщениеРасшифровано(СсылкаНаОбъект) Тогда
		
		СоздатьПодтверждение(Оповещение, СсылкаНаОбъект);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(Оповещение.ДополнительныеПараметры.ОповещениеОЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры

