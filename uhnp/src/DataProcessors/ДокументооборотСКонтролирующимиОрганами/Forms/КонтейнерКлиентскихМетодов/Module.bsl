	ПодписанныйПакетДляАвторизации      = ДополнительныеПараметры.ПодписанныйПакетДляАвторизации;
	РезультатОтправки                   = ДополнительныеПараметры.РезультатОтправки;
	ПерваяПопыткаАвторизации            = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	
	Если РезультатФормы = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		Возврат;
	КонецЕсли;
	
	EMail = РезультатФормы.EMail;
	
	Оповещение = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРОтправкаПослеФормированияПодписанногоПакетаДляПортала",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	СформироватьПодписанныйПакетДляПорталаФСРАР(
		МестоХраненияКлюча,
		УчетнаяЗапись,
		ПодписываемыеДанные,
		ПараметрыФормированияПакета.СертификатАбонента,
		Оповещение,
		Крипт,
		СлучайныйКлюч,
		"",
		Истина,
		EMail);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРОтправкаПослеФормированияПодписанногоПакетаДляПортала(ПодписанныйПакетДляРегистрации, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	ФедеральныйПортал                   = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоРегламентированныйОтчет          = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	РезультатВыгрузки                   = ДополнительныеПараметры.РезультатВыгрузки;
	ПараметрыФормированияПакета         = ДополнительныеПараметры.ПараметрыФормированияПакета;
	ИнформацияОРегионе                  = ДополнительныеПараметры.ИнформацияОРегионе;
	СхемаСдачиОтчетности                = ДополнительныеПараметры.СхемаСдачиОтчетности;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	Крипт                               = ДополнительныеПараметры.Крипт;
	СтрокаBase64ФайлаПакета             = ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	КодИНаименованиеРегиона             = ДополнительныеПараметры.КодИНаименованиеРегиона;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
	ПодписанныйПакетДляАвторизации      = ДополнительныеПараметры.ПодписанныйПакетДляАвторизации;
	РезультатОтправки                   = ДополнительныеПараметры.РезультатОтправки;
	ПерваяПопыткаАвторизации            = ДополнительныеПараметры.ПерваяПопыткаАвторизации;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
		
	РезультатРегистрации = ЗарегистрироватьсяВФСРАРНаСервере(
		ПодписанныйПакетДляРегистрации,
		ПараметрыОтправки,
		ПараметрыСоединения,
		ЭтоРегламентированныйОтчет);
		
	ДлительнаяОтправкаКлиент.ВывестиСообщенияССервераНаКлиенте(ПараметрыСоединения.СообщенияПользователю);

	Если РезультатРегистрации Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПолучитьПодписанныйПакетДляАвторизации(
			ОтчетСсылка,
			УчетнаяЗапись,
			ФедеральныйПортал,
			Форма,
			ЭтоРегламентированныйОтчет,
			МестоХраненияКлюча,
			СертификатыИПараметрыОбмена,
			ПараметрыСоединения,
			РезультатВыгрузки,
			ПараметрыФормированияПакета,
			ИнформацияОРегионе,
			СхемаСдачиОтчетности,
			КороткоеИмяФайлаПакета,
			Крипт,
			СтрокаBase64ФайлаПакета,
			СтрокаBase64ФайлаОтправки,
			КодИНаименованиеРегиона,
			ФормаДлительнаяОперация,
			ПараметрыОтправки);
			
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеОтправки(
			ОтчетСсылка,
			УчетнаяЗапись,
			ФедеральныйПортал,
			Форма,
			ЭтоРегламентированныйОтчет,
			МестоХраненияКлюча,
			СертификатыИПараметрыОбмена,
			ПараметрыСоединения,
			РезультатВыгрузки,
			ПараметрыФормированияПакета,
			ИнформацияОРегионе,
			СхемаСдачиОтчетности,
			КороткоеИмяФайлаПакета,
			Крипт,
			СтрокаBase64ФайлаПакета,
			СтрокаBase64ФайлаОтправки,
			КодИНаименованиеРегиона,
			ФормаДлительнаяОперация,
			ПараметрыОтправки,
			ПодписанныйПакетДляАвторизации,
			РезультатОтправки);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПослеОтправки(
	ОтчетСсылка,
	УчетнаяЗапись,
	ФедеральныйПортал,
	Форма,
	ЭтоРегламентированныйОтчет,
	МестоХраненияКлюча,
	СертификатыИПараметрыОбмена,
	ПараметрыСоединения,
	РезультатВыгрузки,
	ПараметрыФормированияПакета,
	ИнформацияОРегионе,
	СхемаСдачиОтчетности,
	КороткоеИмяФайлаПакета,
	Крипт,
	СтрокаBase64ФайлаПакета,
	СтрокаBase64ФайлаОтправки,
	КодИНаименованиеРегиона,
	ФормаДлительнаяОперация,
	ПараметрыОтправки,
	ПодписанныйПакетДляАвторизации,
	РезультатОтправки)

	Если РезультатОтправки <> Неопределено Тогда
		Если РезультатОтправки.УспешноОбработана = Ложь Тогда
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
			
		Иначе
			
			ПараметрыАвтозапроса = Новый Структура();
			ПараметрыАвтозапроса.Вставить("Ключ",              РезультатОтправки.НоваяОтправкаСсылка);
			ПараметрыАвтозапроса.Вставить("ФедеральныйПортал", ПараметрыОтправки.ФедеральныйПортал);
			ПараметрыАвтозапроса.Вставить("КодРегиона",        ПараметрыОтправки.КодРегиона);
			ПараметрыАвтозапроса.Вставить("ЗначениеCookie",    ПараметрыСоединения.ЗначениеCookie);
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", ПараметрыАвтозапроса);
			
			ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСРАР.
			
		КонецЕсли;
		
	ИначеЕсли ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// не получено файла результата при отправке пакета. Возможно, проблемы с доступом в интернет
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись",                       УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("ФедеральныйПортал",                   ФедеральныйПортал);
		ДополнительныеПараметры.Вставить("Форма",                               Форма);
		ДополнительныеПараметры.Вставить("ЭтоРегламентированныйОтчет",          ЭтоРегламентированныйОтчет);
		ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         СертификатыИПараметрыОбмена);
		ДополнительныеПараметры.Вставить("ПараметрыСоединения",                 ПараметрыСоединения);
		ДополнительныеПараметры.Вставить("РезультатВыгрузки",                   РезультатВыгрузки);
		ДополнительныеПараметры.Вставить("ПараметрыФормированияПакета",         ПараметрыФормированияПакета);
		ДополнительныеПараметры.Вставить("ИнформацияОРегионе",                  ИнформацияОРегионе);
		ДополнительныеПараметры.Вставить("СхемаСдачиОтчетности",                СхемаСдачиОтчетности);
		ДополнительныеПараметры.Вставить("КороткоеИмяФайлаПакета",              КороткоеИмяФайлаПакета);
		ДополнительныеПараметры.Вставить("Крипт",                               Крипт);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаПакета",             СтрокаBase64ФайлаПакета);
		ДополнительныеПараметры.Вставить("СтрокаBase64ФайлаОтправки",           СтрокаBase64ФайлаОтправки);
		ДополнительныеПараметры.Вставить("КодИНаименованиеРегиона",             КодИНаименованиеРегиона);
		ДополнительныеПараметры.Вставить("ФормаДлительнаяОперация",             ФормаДлительнаяОперация);
		ДополнительныеПараметры.Вставить("ПараметрыОтправки",                   ПараметрыОтправки);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаКнопкуОтправкиВФСРАРПослеПоказаОшибкиДоступаВИнтернет", ЭтотОбъект, ДополнительныеПараметры);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
			НСтр("ru = 'Не удалось обратиться к серверу Росалкогольтабакконтроля';
				|en = 'Не удалось обратиться к серверу Росалкогольтабакконтроля'"),
			ОписаниеОповещения);
			
		Возврат;
		
	Иначе
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСРАР.
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВФСРАРПослеПоказаОшибкиДоступаВИнтернет(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка                         = ДополнительныеПараметры.ОтчетСсылка;
	УчетнаяЗапись                       = ДополнительныеПараметры.УчетнаяЗапись;
	ФедеральныйПортал                   = ДополнительныеПараметры.ФедеральныйПортал;
	Форма                               = ДополнительныеПараметры.Форма;
	ЭтоРегламентированныйОтчет          = ДополнительныеПараметры.ЭтоРегламентированныйОтчет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатыИПараметрыОбмена         = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	ПараметрыСоединения                 = ДополнительныеПараметры.ПараметрыСоединения;
	РезультатВыгрузки                   = ДополнительныеПараметры.РезультатВыгрузки;
	ПараметрыФормированияПакета         = ДополнительныеПараметры.ПараметрыФормированияПакета;
	ИнформацияОРегионе                  = ДополнительныеПараметры.ИнформацияОРегионе;
	СхемаСдачиОтчетности                = ДополнительныеПараметры.СхемаСдачиОтчетности;
	КороткоеИмяФайлаПакета              = ДополнительныеПараметры.КороткоеИмяФайлаПакета;
	Крипт                               = ДополнительныеПараметры.Крипт;
	СтрокаBase64ФайлаПакета             = ДополнительныеПараметры.СтрокаBase64ФайлаПакета;
	СтрокаBase64ФайлаОтправки           = ДополнительныеПараметры.СтрокаBase64ФайлаОтправки;
	КодИНаименованиеРегиона             = ДополнительныеПараметры.КодИНаименованиеРегиона;
	ФормаДлительнаяОперация             = ДополнительныеПараметры.ФормаДлительнаяОперация;
	ПараметрыОтправки                   = ДополнительныеПараметры.ПараметрыОтправки;
															
    ПараметрыСоединения.ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	// Рекурсивный вызов по условию (замена цикла)
	Если ПараметрыСоединения.ПовторятьСоединение Тогда
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСРАРПолучитьПодписанныйПакетДляАвторизации(
			ОтчетСсылка,
			УчетнаяЗапись,
			ФедеральныйПортал,
			Форма,
			ЭтоРегламентированныйОтчет,
			МестоХраненияКлюча,
			СертификатыИПараметрыОбмена,
			ПараметрыСоединения,
			РезультатВыгрузки,
			ПараметрыФормированияПакета,
			ИнформацияОРегионе,
			СхемаСдачиОтчетности,
			КороткоеИмяФайлаПакета,
			Крипт,
			СтрокаBase64ФайлаПакета,
			СтрокаBase64ФайлаОтправки,
			КодИНаименованиеРегиона,
			ФормаДлительнаяОперация,
			ПараметрыОтправки);
			
	Иначе
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСРАР. Нет доступа в Интернет.
		
	КонецЕсли;
	
КонецПроцедуры
// Цикл Пока ПараметрыСоединения.ПовторятьСоединение (КонецЦикла)

&НаСервере
Функция ЗначенияРеквизитовОбъекта(Ссылка, Знач Реквизиты) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
	
КонецФункции

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАР(МестоХраненияКлюча, УчетнаяЗапись, ПодписываемыеДанные, СертификатАбонента, ВыполняемоеОповещение, Крипт = Неопределено, СлучайныйКлюч = "", ЗначениеCAPTCHA = "", ДляРегистрации = Ложь, Email = "")
	
	Если СертификатАбонента = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось определить сертификат!';
														|en = 'Не удалось определить сертификат!'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
			
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ДополнительныеПараметры.Вставить("ПодписываемыеДанные", ПодписываемыеДанные);
	ДополнительныеПараметры.Вставить("СертификатАбонента", СертификатАбонента);
	ДополнительныеПараметры.Вставить("Крипт", Крипт);
	ДополнительныеПараметры.Вставить("СлучайныйКлюч", СлучайныйКлюч);
	ДополнительныеПараметры.Вставить("ЗначениеCAPTCHA", ЗначениеCAPTCHA);
	ДополнительныеПараметры.Вставить("ДляРегистрации", ДляРегистрации);
	ДополнительныеПараметры.Вставить("Email", Email);
	ДополнительныеПараметры.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		ПодписываемыеДанныеАдрес = ПоместитьВоВременноеХранилище(ПодписываемыеДанные, ЭтотОбъект.УникальныйИдентификатор);
		ДополнительныеПараметры.Вставить("ПодписываемыеДанныеАдрес", ПодписываемыеДанныеАдрес);
		
		ПодписываемыеДанныеВUnicodeBase64Адрес = ПреобразоватьПодписываемыеДанныеФСРАРНаСервере(ПодписываемыеДанныеАдрес, ЭтотОбъект.УникальныйИдентификатор);
		ДополнительныеПараметры.Вставить("ПодписываемыеДанныеВUnicodeBase64Адрес", ПодписываемыеДанныеВUnicodeBase64Адрес);
		
		ДополнительныеПараметры.Вставить("ВременныйКаталог", "");
		ДополнительныеПараметры.Вставить("ИмяФайлаПодписываемыхДанныхВUnicode", "");
	
		Оповещение = Новый ОписаниеОповещения("СформироватьПодписанныйПакетДляПорталаФСРАРПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено", Истина));
		Возврат;
		
	КонецЕсли;
	
	ПодписываемыеДанныеВUnicodeBase64 = СтрокаСимволовПервойПоловиныASCIIВUnicodeBase64НаСервере(ПодписываемыеДанные);
	ДополнительныеПараметры.Вставить("ПодписываемыеДанныеВUnicodeBase64", ПодписываемыеДанныеВUnicodeBase64);
	
	Оповещение = Новый ОписаниеОповещения("СформироватьПодписанныйПакетДляПорталаФСРАРПослеПолученияВременногоКаталогаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
			
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАРПослеПолученияВременногоКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПодписываемыеДанныеВUnicodeBase64 = ДополнительныеПараметры.ПодписываемыеДанныеВUnicodeBase64;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	ИмяФайлаПодписываемыхДанныхВUnicode = ВременныйКаталог + Строка(Новый УникальныйИдентификатор) + ".dat";
	
	ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписываемыхДанныхВUnicode", ИмяФайлаПодписываемыхДанныхВUnicode);

	Оповещение = Новый ОписаниеОповещения("СформироватьПодписанныйПакетДляПорталаФСРАРПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, ПодписываемыеДанныеВUnicodeBase64, ИмяФайлаПодписываемыхДанныхВUnicode);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАРПослеЗаписиФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог 					= ДополнительныеПараметры.ВременныйКаталог;
	Крипт 								= ДополнительныеПараметры.Крипт;
	ИмяФайлаПодписываемыхДанныхВUnicode = ДополнительныеПараметры.ИмяФайлаПодписываемыхДанныхВUnicode;
	СертификатАбонента					= ДополнительныеПараметры.СертификатАбонента;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	УчетнаяЗапись						= ДополнительныеПараметры.УчетнаяЗапись;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаПодписи = ВременныйКаталог + Строка(Новый УникальныйИдентификатор) + ".sig";
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);

	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ИмяФайлаПодписи = ПоместитьВоВременноеХранилище(Неопределено, ЭтотОбъект.УникальныйИдентификатор);
		ИмяФайлаПодписываемыхДанныхВUnicode = ДополнительныеПараметры.ПодписываемыеДанныеВUnicodeBase64Адрес;
		
		ДополнительныеПараметры.Вставить("ИмяФайлаПодписиАдрес", ИмяФайлаПодписи);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатАбонента);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СформироватьПодписанныйПакетДляПорталаФСРАРПослеПодписанияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаПодписываемыхДанныхВUnicode);
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ПакетДляОтправкиВФСРАР", УчетнаяЗапись); 
		ПараметрыОперации = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
	КонецЕсли;
	
	КриптографияЭДКОКлиент.ПодписатьPKCS7(Оповещение, СертификатАбонента, ИмяФайлаПодписываемыхДанныхВUnicode, Истина, ИмяФайлаПодписи, Ложь, , , ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАРПослеПодписанияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось подписать информацию для авторизации:
				|%1';
				|en = 'Не удалось подписать информацию для авторизации:
				|%1'"), ИнформацияОбОшибке().Описание);

		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ДополнительныеПараметры) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Ошибка);
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ИмяФайлаПодписи = ДополнительныеПараметры.ИмяФайлаПодписи;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	Оповещение = Новый ОписаниеОповещения("СформироватьПодписанныйПакетДляПорталаФСРАРПослеПолученияЗакодированнойПодписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		ИмяФайлаПодписиBase64Адрес = КодироватьВBase64СодержимоеНаСервере(ДополнительныеПараметры.ИмяФайлаПодписиАдрес, ЭтотОбъект.УникальныйИдентификатор);
		ДополнительныеПараметры.Вставить("ИмяФайлаПодписиBase64Адрес", ИмяФайлаПодписиBase64Адрес);
		СтрокаBase64 = ПолучитьИзВременногоХранилища(ИмяФайлаПодписиBase64Адрес);		
		ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено, СтрокаBase64", Истина, СтрокаBase64));
		Возврат;
		
	КонецЕсли;
	
	ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ИмяФайлаПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПодписанныйПакетДляПорталаФСРАРПослеПолученияЗакодированнойПодписиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПодписываемыеДанные = ДополнительныеПараметры.ПодписываемыеДанные;
	СертификатАбонента = ДополнительныеПараметры.СертификатАбонента;
	Крипт = ДополнительныеПараметры.Крипт;
	СлучайныйКлюч = ДополнительныеПараметры.СлучайныйКлюч;
	ЗначениеCAPTCHA = ДополнительныеПараметры.ЗначениеCAPTCHA;
	ДляРегистрации = ДополнительныеПараметры.ДляРегистрации;
	Email = ДополнительныеПараметры.Email;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ЗакодированнаяПодпись = Результат.СтрокаBase64;
	
	ЗакодированнаяПодписьДляСсылки = ЗакодированныйUTF8ПараметрСсылки(ЗакодированнаяПодпись, "BASE64");
	
	ВладелецДляСсылки = "";
	EmailДляСсылки = "";
	Если ДляРегистрации Тогда
		СвойстваВладельца = РазобратьСтрокуСубъекта(СертификатАбонента.Владелец);
		Для каждого СвойствоВладельца Из СвойстваВладельца Цикл
			ИмяСвойства = СвойствоВладельца.Ключ;
			ЗначениеСвойства = СвойствоВладельца.Значение;
			Если СтрНайти(ЗначениеСвойства, """") > 0 Тогда
				ЗначениеСвойства = """" + СтрЗаменить(ЗначениеСвойства, """", """""") + """";
			КонецЕсли;
			ЗначениеСвойства = СтрЗаменить(ЗначениеСвойства, "\", "\\");
			ЗначениеСвойства = СтрЗаменить(ЗначениеСвойства, """", "\""");
			ВладелецДляСсылки = ВладелецДляСсылки + ?(ВладелецДляСсылки <> "", ",", "") + """" + ИмяСвойства + """:""" + ЗначениеСвойства + """";
		КонецЦикла;
		ВладелецДляСсылки = ЗакодированныйUTF8ПараметрСсылки("{" + ВладелецДляСсылки + "}");
		
		EmailДляСсылки = ЗакодированныйUTF8ПараметрСсылки(Email);
	КонецЕсли;
	
	Результат = "user_sign=" + ЗакодированнаяПодписьДляСсылки + ?(НЕ ДляРегистрации, "&user_type=user", "") + "&thumbprint=" + ВРег(СертификатАбонента.Отпечаток)
		+ ?(НЕ ДляРегистрации, "", "&subject=" + ВладелецДляСсылки) + "&csrf=" + СлучайныйКлюч + ?(НЕ ДляРегистрации, "", "&email=" + EmailДляСсылки)
		+ ?(ЗначениеCAPTCHA <> "", "&captcha_code=" + ЗначениеCAPTCHA, "");
	
	ВыполняемоеОповещение.ДополнительныеПараметры.Вставить("Крипт", Крипт);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьФормуРегистрацииНаПорталеФСРАР(EMail, Портал, ВыполняемоеОповещение)
	
	ПараметрыФормы = Новый Структура("EMail, Портал", EMail, Портал);
	ОткрытьФорму(ПутьКОбъекту + ".Форма.РегистрацияНаПорталеФСРАР", ПараметрыФормы,,,,, ВыполняемоеОповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьФормуВводаCAPTCHA(Данные64CAPTCHA, ПричинаЗапросаКода = "", ВыполняемоеОповещение = Неопределено)
	
	ПараметрыФормы = Новый Структура("Данные64КартинкиСКодом, ПричинаЗапросаКода", Данные64CAPTCHA, ПричинаЗапросаКода);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВызватьФормуВводаCAPTCHAЗавершение", ЭтотОбъект, ВыполняемоеОповещение);	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ВводCAPTCHA", ПараметрыФормы,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьФормуВводаCAPTCHAЗавершение(РезультатФормы, ВыполняемоеОповещение) Экспорт
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Строка(РезультатФормы));
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСРАР(ИсточникСсылка, ПечатьВозможна = Истина) Экспорт
	
	ВАрхиве = ОбъектВАрхиве(ИсточникСсылка, "Протокол");
	Если ВАрхиве Тогда 
		ПоказатьУведомлениеАрхивныхФайлов(, 16, 0, Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ИсточникСсылка",      ИсточникСсылка);
	ПараметрыФормы.Вставить("ПечатьВозможна",      ПечатьВозможна);
	ПараметрыФормы.Вставить("КонтролирующийОрган", ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСРАР"));
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПротоколОбработкиHTML", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиенте(ИмяВременногоФайла, ВыполняемоеОповещение) Экспорт
	
	Если ИмяВременногоФайла = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		Если ТипЗнч(ИмяВременногоФайла) = Тип("Структура") Тогда // ЭП в облаке
			ПолучитьФайл(ИмяВременногоФайла.ИмяФайлаЗашифрованногоПакета, ИмяВременногоФайла.ИмяФайлаВыгрузки, Истина);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
		Иначе
			ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ИмяВременногоФайла", ВыполняемоеОповещение, ИмяВременногоФайла);
			ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьФайлНаКлиентеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ТекстСообщения = ОперацииСФайламиЭДКОКлиент.ТекстСообщенияДляНеобязательнойУстановкиРасширенияРаботыСФайлами();
			ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения, ТекстСообщения, Истина); 
		КонецЕсли;
		
	#Иначе
		СохранитьФайлНаКлиентеНеВеб(ИмяВременногоФайла, ВыполняемоеОповещение);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиентеНеВеб(ИмяВременногоФайла, ВыполняемоеОповещение) Экспорт
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Укажите каталог';
							|en = 'Укажите каталог'");
	Диалог.ПроверятьСуществованиеФайла = Истина;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяВременногоФайла", ИмяВременногоФайла);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СохранитьФайлНаКлиентеНеВебПослеВыбораКаталога", 
		ЭтотОбъект, 
		ДополнительныеПараметры); 
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиентеНеВебПослеВыбораКаталога(ВыбранныеФайлы, ВходящийКонтекст) Экспорт

	ИмяВременногоФайла		= ВходящийКонтекст.ИмяВременногоФайла;
	ВыполняемоеОповещение	= ВходящийКонтекст.ВыполняемоеОповещение;
	
	Если ВыбранныеФайлы = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
		Возврат;
	КонецЕсли;
	
	Путь = ВыбранныеФайлы[0];
	Путь = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(Путь);
	
	Если ТипЗнч(ИмяВременногоФайла) = Тип("Структура") Тогда // ЭП в облаке
		ИмяФайлаВыгрузки = ИмяВременногоФайла.ИмяФайлаВыгрузки;
		ПолучитьИзВременногоХранилища(ИмяВременногоФайла.ИмяФайлаЗашифрованногоПакета).Записать(Путь + ИмяФайлаВыгрузки);// Двоичные данные, лежащие во временном хранилище
		ПоказатьПредупреждение(, НСтр("ru = 'Выгрузка завершена.';
										|en = 'Выгрузка завершена.'"));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СохранитьФайлНаКлиентеНеВебПослеПеремещенияФайла", 
			ЭтотОбъект, 
			ВходящийКонтекст);
		
		ПолноеИмяКонечногоФайла = Путь + ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяВременногоФайла).Имя;
		НачатьПеремещениеФайла(ОписаниеОповещения, ИмяВременногоФайла, ПолноеИмяКонечногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиентеНеВебПослеПеремещенияФайла(ПеремещаемыйФайл, ВходящийКонтекст) Экспорт

	ПоказатьПредупреждение(, НСтр("ru = 'Выгрузка завершена.';
									|en = 'Выгрузка завершена.'"));
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиентеЗавершение(ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяВременногоФайла = ДополнительныеПараметры.ИмяВременногоФайла;
	
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ИмяВременногоФайла", ВыполняемоеОповещение, ИмяВременногоФайла);
		Оповещение = Новый ОписаниеОповещения("СохранитьФайлНаКлиентеПослеЧтенияФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ИмяВременногоФайла);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиентеПослеЧтенияФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяВременногоФайла = ДополнительныеПараметры.ИмяВременногоФайла;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Ложь);
		Возврат;
	КонецЕсли;
	
	СтрокаBase64ВременногоФайла = Результат.СтрокаBase64;
	
	ПолучитьФайл(ПоместитьФайлВоВременноеХранилищеНаСервере(СтрокаBase64ВременногоФайла),
		ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяВременногоФайла).Имя, Истина);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Функция ЗакодированныйUTF8ПараметрСсылки(ПараметрСсылки, ФорматДанных = "")
	
	Если ВРег(ФорматДанных) = "BASE64" Тогда
		
		Результат = СтрЗаменить(ПараметрСсылки, "+", "%2B");
		Результат = СтрЗаменить(Результат, "/", "%2F");
		Результат = СтрЗаменить(Результат, "=", "%3D");
		Результат = СтрЗаменить(Результат, Символы.ВК, "%0D");
		Результат = СтрЗаменить(Результат, Символы.ПС, "%0A");
		Возврат Результат;
		
	КонецЕсли;
	
	ТаблицаШестнадцатеричныхПредставлений
		= "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F"
		+ "202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F"
		+ "404142434445464748494A4B4C4D4E4F505152535455565758595A5B5C5D5E5F"
		+ "606162636465666768696A6B6C6D6E6F707172737475767778797A7B7C7D7E7F"
		+ "808182838485868788898A8B8C8D8E8F909192939495969798999A9B9C9D9E9F"
		+ "A0A1A2A3A4A5A6A7A8A9AAABACADAEAFB0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF"
		+ "C0C1C2C3C4C5C6C7C8C9CACBCCCDCECFD0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF"
		+ "E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEFF0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF";
	
	Результат = "";
	
	Для ИндексСимвола = 1 По СтрДлина(ПараметрСсылки) Цикл
		
		СимволПараметраСсылки = Сред(ПараметрСсылки, ИндексСимвола, 1);
		КодСимволаПараметраСсылки = КодСимвола(СимволПараметраСсылки);
		Если (КодСимволаПараметраСсылки >= КодСимвола("0") И КодСимволаПараметраСсылки <= КодСимвола("9"))
			ИЛИ (КодСимволаПараметраСсылки >= КодСимвола("A") И КодСимволаПараметраСсылки <= КодСимвола("Z"))
			ИЛИ (КодСимволаПараметраСсылки >= КодСимвола("a") И КодСимволаПараметраСсылки <= КодСимвола("z"))
			ИЛИ СимволПараметраСсылки = "_" ИЛИ СимволПараметраСсылки = "*" ИЛИ СимволПараметраСсылки = "-"
			ИЛИ СимволПараметраСсылки = "." Тогда
			
			Результат = Результат + СимволПараметраСсылки
			
		ИначеЕсли СимволПараметраСсылки = " " Тогда
			
			Результат = Результат + "+"
			
		Иначе
			
			Код = КодСимвола(Сред(ПараметрСсылки, ИндексСимвола, 1));
			
			// представить в формате UTF8
			Если Код <= 255 Тогда
				
				Результат = Результат + "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, Код * 2 + 1, 2);
				
			ИначеЕсли Код <= 2047 Тогда
				
				МладшаяЧастьКода = Код % 64;
				СтаршаяЧастьКода = (Код - МладшаяЧастьКода) / 64;
				МладшаяЧастьКода = 128 + МладшаяЧастьКода;
				СтаршаяЧастьКода = 192 + СтаршаяЧастьКода;
				Результат = Результат + "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, СтаршаяЧастьКода * 2 + 1, 2)
					+ "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, МладшаяЧастьКода * 2 + 1, 2);
				
			Иначе
				
				МладшаяЧастьКода = Код % 64;
				СтаршаяЧастьКода = (Код - МладшаяЧастьКода) / 64;
				СредняяЧастьКода = СтаршаяЧастьКода % 64;
				СтаршаяЧастьКода = (СтаршаяЧастьКода - СредняяЧастьКода) / 64;
				МладшаяЧастьКода = 128 + МладшаяЧастьКода;
				СредняяЧастьКода = 128 + СредняяЧастьКода;
				СтаршаяЧастьКода = 224 + СтаршаяЧастьКода;
				Результат = Результат + "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, СтаршаяЧастьКода * 2 + 1, 2)
					+ "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, СредняяЧастьКода * 2 + 1, 2)
					+ "%" + Сред(ТаблицаШестнадцатеричныхПредставлений, МладшаяЧастьКода * 2 + 1, 2);
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции

