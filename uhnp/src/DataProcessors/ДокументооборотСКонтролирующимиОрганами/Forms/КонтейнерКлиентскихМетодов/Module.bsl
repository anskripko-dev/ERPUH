			ДобавитьУзелXML(УзелФИО, "Отчество", Истина, РеквизитыПолучателя.Отчество);
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	// добавляем сведения о квитанции
	УзелСвКвит = ДобавитьУзелXML(УзелДокумент, "СвКвит");
	ЗаполнитьУзелСведениямиОКвитанции(УзелСвКвит, ТранспортноеСообщение, ДИВы);
	
	// добавляем сведения о промежуточном НО
	ИдентификаторыПолучателя = ПолучитьИдентификаторыПолучателя(ТранспортноеСообщение.ЦиклОбмена);
	Если ИдентификаторыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;

	// получаем сведения об отправителе
	КодНО	= ИдентификаторыПолучателя.КонечныйНалоговыйОрган;
	ОтпрНО 	= Справочники.НалоговыеОрганы.НайтиПоКоду(КодНО);
	Если НЕ ЗначениеЗаполнено(ОтпрНО) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	СведенияОбОтправителе = СформироватьСведенияОбУчастникеДокументооборота(ОтпрНО, ТранспортноеСообщение);
	Если НЕ ЗначениеЗаполнено(СведенияОбОтправителе) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// добавляем сведения об отправителе
	УзелСвОтпрДок = ДобавитьУзелXML(УзелДокумент, "СвОтпрДок");
	ЗаполнитьУзелСведениямиОбУчастникеЭДОДокумент(УзелСвОтпрДок, СведенияОбОтправителе);
	
	КодНОПром = ИдентификаторыПолучателя.ПромежуточныйНалоговыйОрган;
