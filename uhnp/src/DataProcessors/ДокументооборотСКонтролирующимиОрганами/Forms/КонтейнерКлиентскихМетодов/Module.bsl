	// производим настройку параметров РПН
	Если СтруктураАвтонастройкиРПН <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
		
		ФлагАвтозаполнения = СтруктураАвтонастройкиРПН.ФлагАвтозаполнения;
		Если СтруктураАвтонастройкиРПН.ФлагСообщения И ВыводитьСообщения Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Произвести автоматическую настройку параметров отправки в Росприроднадзора для организации %1?';
																				|en = 'Произвести автоматическую настройку параметров отправки в Росприроднадзора для организации %1?'"), ПараметрыФункции.Организация);
			
			ДополнительныеПараметры = Новый Структура("ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись", ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, НоваяУчетнаяЗапись, ПараметрыФункции, СтруктураАвтонастройкиРПН, СтруктураАвтонастройкиФТС, ЭтоНоваяУчетнаяЗапись);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОбновлениеНастройкаРПНЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0, КодВозвратаДиалога.Нет, "Предупреждение");
			
		Иначе
			
			Если ФлагАвтозаполнения Тогда
				ОбновитьРегистрыСведенийНастройкиОбменаРПН(
					ПараметрыФункции.Организация, 
					СтруктураАвтонастройкиРПН.ОтпечатокСертификата,
					СтруктураАвтонастройкиРПН.СертификатРПНОтпечаток, 
					ВыводитьСообщения, 
					СтруктураАвтонастройкиРПН.EMail, 
					СтруктураАвтонастройкиРПН.Пароль);
			КонецЕсли;
			
			ОбработатьОбновлениеНастройкаФТС(
				СтруктураАвтонастройкиФТС, 
				ПараметрыФункции, 
				ВыводитьСообщения, 
				ЭтоНоваяУчетнаяЗапись, 
				НоваяУчетнаяЗапись, 
				ВременныйКаталог, 
				ВыполняемоеОповещение);
			
		КонецЕсли;
		
	Иначе
		
		ОбработатьОбновлениеНастройкаФТС(
			СтруктураАвтонастройкиФТС, 
			ПараметрыФункции, 
			ВыводитьСообщения, 
			ЭтоНоваяУчетнаяЗапись, 
			НоваяУчетнаяЗапись, 
			ВременныйКаталог, 
			ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеНастройкаРПНЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
