////////////////////////////////////////////////////////////////////////////////
// АВТОМАТИЧЕСКАЯ НАСТРОЙКА ПАРАМЕТРОВ УЧЕТНОЙ ЗАПИСИ (ПОДДЕРЖКА РОКИ)
//

&НаКлиенте
Процедура ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(
		ОбъектСсылка,
		ВыполняемоеОповещение,
		СтруктураДляИнформацииОСервереОнлайнПроверки = Неопределено) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	УчетнаяЗапись = УчетнаяЗаписьПоОбъектуОтправки(ОбъектСсылка);
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		АвтоматическаяНастройкаУчетнойЗаписи(УчетнаяЗапись, ,ВыполняемоеОповещение, , , Истина, , , , СтруктураДляИнформацииОСервереОнлайнПроверки);
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбновлятьАвтонастройкуПоВремени(УчетнаяЗапись)
	
	Если СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Неопределено Тогда
		СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Новый Соответствие;
	КонецЕсли;
	ДатаВремяПоследнегоОбновления = СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи[УчетнаяЗапись];
	
	ТекДата = ТекущаяДатаНаСервере();
	
	Если ДатаВремяПоследнегоОбновления <> Неопределено И ТекДата < (ДатаВремяПоследнегоОбновления + 10*60) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьВСсылкуНаУчетнуюЗапись(ОбъектДоПреобразования)
	
	ТипОбъекта = ТипЗнч(ОбъектДоПреобразования);
	Если ТипОбъекта = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота")  Тогда
		Возврат ОбъектДоПреобразования; 
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.УчетныеЗаписиДокументооборота")  Тогда
		Возврат ОбъектДоПреобразования.Ссылка;
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Организации")  Тогда
		Возврат УчетнаяЗаписьОрганизации(ОбъектДоПреобразования);	
	КонецЕсли;	
	
КонецФункции 

&НаСервереБезКонтекста
Функция УчетнаяЗаписьПоОбъектуОтправки(Знач ОбъектСсылка)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.УчетнаяЗаписьПоОбъектуОтправки(ОбъектСсылка);
	
КонецФункции 

&НаКлиенте
Процедура АвтоматическаяНастройкаУчетнойЗаписи(Знач УчетнаяЗапись,
											Организация = Неопределено,
											ВыполняемоеОповещение = Неопределено,
											УведомлятьТолькоОбОшибках = Ложь,
											ИгнорироватьРежимАвтонастройки = Ложь,
											ТихийРежим = Ложь,
											ЗапрашиватьПараметрыОрганизацииПриНеобходимости = Ложь,
											ВызовИзМастераПодключенияК1СОтчетности = Ложь, 
											ТекстОшибокДляМастераПодключенияК1СОтчетности = "",
											СтруктураДляИнформацииОСервереОнлайнПроверки = Неопределено,
											ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки = Истина) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
											
	Если ТипЗнч(УчетнаяЗапись) <> Тип("СправочникСсылка.УчетныеЗаписиДокументооборота")  Тогда
		УчетнаяЗаписьСсылка = ПреобразоватьВСсылкуНаУчетнуюЗапись(УчетнаяЗапись);
	Иначе
		УчетнаяЗаписьСсылка = УчетнаяЗапись;
	КонецЕсли;
	
	ВызовДляПолученияИнформации = (СтруктураДляИнформацииОСервереОнлайнПроверки <> Неопределено);
	ОбращениеКСерверуОтключено = Ложь;
	СохранениеВИБОтключено = Ложь;
	
	Если НЕ ИгнорироватьРежимАвтонастройки И НЕ ОбновлятьАвтонастройкуПоВремени(УчетнаяЗаписьСсылка) Тогда
		
		Если ВызовДляПолученияИнформации Тогда
			ОбращениеКСерверуОтключено = Истина;
		Иначе
			Если ВыполняемоеОповещение <> Неопределено Тогда
				РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
				РезультатНастройки.Вставить("ОписаниеРезультата", "Не заполнена информация о сервере онлайн-проверки");
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
	// если настройки недоступны или учетка для обмена напрямую, то прервемся
	Если НастройкиУчетнойЗаписи = Неопределено ИЛИ НастройкиУчетнойЗаписи.ОбменНапрямую Тогда
		Если ВыполняемоеОповещение <> Неопределено Тогда
			РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
			Если НастройкиУчетнойЗаписи = Неопределено Тогда
				РезультатНастройки.Вставить("ОписаниеРезультата", "В ИБ отсутствуют настройки учетной записи");
			ИначеЕсли НастройкиУчетнойЗаписи.ОбменНапрямую Тогда
				РезультатНастройки.Вставить("ОписаниеРезультата", "В настройках учетной записи включен обмен напрямую");
			КонецЕсли;			
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НастройкиУчетнойЗаписи.СпецОператорСвязи = СтруктураСсылочныхДанных.Перечисления_СпецоператорыСвязи_Прочие Тогда
		
		Если ВыполняемоеОповещение <> Неопределено Тогда
			РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Автонастройка не выполняется для прочих спецоператоров связи");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НастройкиУчетнойЗаписи.СпецОператорСвязи = СтруктураСсылочныхДанных.Перечисления_СпецоператорыСвязи_Такском Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 							ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", 	ТекстОшибокДляМастераПодключенияК1СОтчетности);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись", 									УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("УведомлятьТолькоОбОшибках", 						УведомлятьТолькоОбОшибках);
		ДополнительныеПараметры.Вставить("УчетнаяЗаписьСсылка", 							УчетнаяЗаписьСсылка);
		ДополнительныеПараметры.Вставить("Организация", 									Организация);
		ОписаниеОповещения = Новый ОписаниеОповещения("АвтоматическаяНастройкаУчетнойЗаписиЗавершение",
			ЭтотОбъект, ДополнительныеПараметры); 

		ПолучитьНастройкиУчетнойЗаписиССервера(УчетнаяЗапись,
			Организация,
			УведомлятьТолькоОбОшибках,
			ИгнорироватьРежимАвтонастройки,
			ТихийРежим,
			ЗапрашиватьПараметрыОрганизацииПриНеобходимости,
			ОписаниеОповещения);
			
	Иначе
		
		ОбновленияПризнак = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(НастройкиУчетнойЗаписи.СпецОператорСвязи, "ОбновленияПризнак");
		
		Если НЕ ИгнорироватьРежимАвтонастройки Тогда
			Если НастройкиУчетнойЗаписи.РежимАвтонастройки = СтруктураСсылочныхДанных.Перечисления_РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика_Отключена
				ИЛИ НастройкиУчетнойЗаписи.РежимАвтонастройки = СтруктураСсылочныхДанных.Перечисления_РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика_ПустаяСсылка Тогда
					
					Если ВызовДляПолученияИнформации Тогда
						СохранениеВИБОтключено = Истина;
					Иначе
						Если ВыполняемоеОповещение <> Неопределено Тогда
							РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
							РезультатНастройки.Вставить("ОписаниеРезультата", "Не заполнена информация о сервере онлайн-проверки");
							ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
						КонецЕсли;
						Возврат;
					КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;
		
		Если ОбновленияПризнак <> Неопределено И (ОбновленияПризнак = "Истина" ИЛИ ОбновленияПризнак = Истина) Тогда
			
			ИдентификаторАбонента      = НастройкиУчетнойЗаписи.ИдентификаторАбонента;
			ИдентификаторСпецоператора = НастройкиУчетнойЗаписи.ИдентификаторСпецоператора;
			ИдентификаторАбонента      = Нрег(Сред(ИдентификаторАбонента, СтрДлина(ИдентификаторСпецоператора)+1));
			
			ПараметрыОбработатьОбновление = ПараметрыОбработатьОбновление();
			ПараметрыОбработатьОбновление.ИдентификаторДокументооборота 							= НастройкиУчетнойЗаписи.ИдентификаторДокументооборота;
			ПараметрыОбработатьОбновление.ТелефонМобильныйДляАвторизации 							= НастройкиУчетнойЗаписи.ТелефонМобильныйДляАвторизации;
			ПараметрыОбработатьОбновление.ИдентификаторАбонента 									= ИдентификаторАбонента;
			ПараметрыОбработатьОбновление.СпецОператорСвязи 										= НастройкиУчетнойЗаписи.СпецОператорСвязи;
			ПараметрыОбработатьОбновление.УчетнаяЗапись 											= УчетнаяЗапись;
			ПараметрыОбработатьОбновление.ТихийРежим 												= ТихийРежим;
			ПараметрыОбработатьОбновление.РежимАвтонастройки 										= Истина;
			ПараметрыОбработатьОбновление.ВызовИзМастераПодключенияК1СОтчетности 					= ВызовИзМастераПодключенияК1СОтчетности;
			ПараметрыОбработатьОбновление.ТекстОшибокДляМастераПодключенияК1СОтчетности 			= ТекстОшибокДляМастераПодключенияК1СОтчетности;
			ПараметрыОбработатьОбновление.ОбращениеКСерверуОтключено 								= ОбращениеКСерверуОтключено;
			ПараметрыОбработатьОбновление.СохранениеВИБОтключено 									= СохранениеВИБОтключено;
			ПараметрыОбработатьОбновление.СтруктураДляИнформацииОСервереОнлайнПроверки 				= СтруктураДляИнформацииОСервереОнлайнПроверки;
			ПараметрыОбработатьОбновление.ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки 	= ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки;
			ПараметрыОбработатьОбновление.ИгнорироватьРежимАвтонастройки						 	= ИгнорироватьРежимАвтонастройки;
			
			МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(НастройкиУчетнойЗаписи);
			ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ПараметрыОбработатьОбновление);
			
			ПовторятьСоединениеДляПолученияАктуальногоОбновления = (ИгнорироватьРежимАвтонастройки
				ИЛИ ВызовИзМастераПодключенияК1СОтчетности ИЛИ СтруктураДляИнформацииОСервереОнлайнПроверки <> Неопределено);
			
			ДополнительныеПараметры = Новый Структура("УчетнаяЗаписьСсылка, ВыполняемоеОповещение", УчетнаяЗаписьСсылка, ВыполняемоеОповещение);
			ОписаниеОповещения = Новый ОписаниеОповещения("АвтоматическаяНастройкаУчетнойЗаписиПослеОбработкиОбновленияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ОбработатьОбновление(ПараметрыОбработатьОбновление, ОписаниеОповещения, ПовторятьСоединениеДляПолученияАктуальногоОбновления);
		Иначе
			Если ВыполняемоеОповещение <> Неопределено Тогда
				РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
				Если ОбновленияПризнак = Неопределено Тогда
					РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось найти ""признак обновления"" в параметрах спецоператора");
				ИначеЕсли ОбновленияПризнак = "Ложь" Или ОбновленияПризнак = Ложь Тогда
					РезультатНастройки.Вставить("ОписаниеРезультата", "Параметр спецоператора ""признак обновления"" установлен в ""ложь""");
				КонецЕсли;
				
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическаяНастройкаУчетнойЗаписиПослеОбработкиОбновленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	РезультатОбновления = Результат.РезультатОбновления;
	ПараметрыОбработатьОбновление = Результат.ПараметрыФункции;
	УчетнаяЗаписьСсылка = ДополнительныеПараметры.УчетнаяЗаписьСсылка;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ТекстОшибокДляМастераПодключенияК1СОтчетности = ПараметрыОбработатьОбновление.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	СтруктураДляИнформацииОСервереОнлайнПроверки  = ПараметрыОбработатьОбновление.СтруктураДляИнформацииОСервереОнлайнПроверки;
	
	Если РезультатОбновления = Истина Тогда
		Если СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Неопределено Тогда
			СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Новый Соответствие;
		КонецЕсли;
		СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи.Вставить(УчетнаяЗаписьСсылка, ТекущаяДатаНаСервере());
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок, СтруктураДляИнформацииОСервереОнлайнПроверки", РезультатОбновления, ТекстОшибокДляМастераПодключенияК1СОтчетности, СтруктураДляИнформацииОСервереОнлайнПроверки);
		ОписаниеИсходнойОшибки = Неопределено;
		
		Если Результат.Свойство("ОшибкаПолученияДанныхССервера", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось получить настройки с сервера спецоператора" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаСозданияКаталога", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось создать временный каталог для сохранения настройки с сервера спецоператора" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаПоискаСертификатовПередУстановкой", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось выполнить поиск сертификатов перед установкой в системное хранилище для завершения автонастройки" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаЗаписиСертификатаВФайл", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось записать сертификат в файл перед установкой" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаУстановкиЛичногоСертификата", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось установить личный сертификат" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаОпределенияПутиКонтейнера", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось определить путь к контейнеру закрытого ключа" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаУстановкиСертификатаВХранилище", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось установить сертификат в системное хранилище" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаПропущенаРасшифровка", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не выполнялась расшифровка зашифрованной части файла автонастройки" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаВыполненияРасшифровки", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось выполнить расшифровку зашифрованной части файла автонастройки" + Подробнее);
			
		ИначеЕсли Результат.Свойство("ОшибкаАктивированияУчетнойЗаписиОблачнойПодписи", ОписаниеИсходнойОшибки) Тогда
			Подробнее = ?(ОписаниеИсходнойОшибки = Неопределено, "", ". " + ОписаниеИсходнойОшибки);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось активировать учетную запись электронной подписи" + Подробнее);
			
		ИначеЕсли РезультатОбновления <> Истина Тогда
			РезультатНастройки.Вставить("ОписаниеРезультата", "Не удалось выявить причину ошибки выполнения автонастройки");
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическаяНастройкаУчетнойЗаписиЗавершение(ТаблицаИсправлений, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ТекстОшибокДляМастераПодключенияК1СОтчетности = ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	УчетнаяЗапись = ДополнительныеПараметры.УчетнаяЗапись;
	УведомлятьТолькоОбОшибках = ДополнительныеПараметры.УведомлятьТолькоОбОшибках;
	УчетнаяЗаписьСсылка = ДополнительныеПараметры.УчетнаяЗаписьСсылка;
	Организация = ДополнительныеПараметры.Организация;
	
	Если ТаблицаИсправлений = Неопределено ИЛИ ТаблицаИсправлений.Количество() = 0 Тогда
		Если ВыполняемоеОповещение <> Неопределено Тогда
			РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок", Неопределено, ТекстОшибокДляМастераПодключенияК1СОтчетности);
			РезультатНастройки.Вставить("ОписаниеРезультата", "Нет изменений настроек учетной записи");
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, УчетнаяЗаписьСсылка, ТекстОшибокДляМастераПодключенияК1СОтчетности", ВыполняемоеОповещение, УчетнаяЗаписьСсылка, ТекстОшибокДляМастераПодключенияК1СОтчетности);
	ОписаниеОповещения = Новый ОписаниеОповещения("АвтоматическаяНастройкаУчетнойЗаписиПослеПримененияИзмененийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПрименитьИзмененныеНастройки(
		УчетнаяЗапись,
		ТаблицаИсправлений,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		Организация);
		
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическаяНастройкаУчетнойЗаписиПослеПримененияИзмененийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	УчетнаяЗаписьСсылка = ДополнительныеПараметры.УчетнаяЗаписьСсылка;
	ТекстОшибокДляМастераПодключенияК1СОтчетности = ДополнительныеПараметры.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	
	ТаблицаИсправлений = Результат.ТаблицаИсправлений;
	РезультатПрименения = Результат.РезультатПрименения;
	
	Если РезультатПрименения = Истина Тогда
		Если СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Неопределено Тогда
			СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи = Новый Соответствие;
		КонецЕсли;
		СоответствиеДатаВремяАвтонастройкиПоУчетнойЗаписи.Вставить(УчетнаяЗаписьСсылка, ТекущаяДатаНаСервере());
	КонецЕсли;
	
	Если ВыполняемоеОповещение <> Неопределено Тогда
		РезультатНастройки = Новый Структура("РезультатНастройки, ТекстОшибок", РезультатПрименения, ТекстОшибокДляМастераПодключенияК1СОтчетности);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатНастройки);
	КонецЕсли;
		
	
КонецПроцедуры

//&НаСервереБезКонтекста
&НаКлиенте
Процедура ПолучитьНастройкиУчетнойЗаписиССервера(Знач УчетнаяЗапись,
											Знач Организация,
											УведомлятьТолькоОбОшибках,
											ИгнорироватьРежимАвтонастройки,
											ТихийРежим,
											ЗапрашиватьПараметрыОрганизацииПриНеобходимости,
											ВыполняемоеОповещение)
	
	// проверяем, включена ли автонастройка
	Если НЕ ИгнорироватьРежимАвтонастройки Тогда
		
		// учетной записью может оказаться организация
		Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
			Если УчетнаяЗапись.ВидОбменаСКонтролирующимиОрганами <> СтруктураСсылочныхДанных.Перечисления_ВидыОбменаСКонтролирующимиОрганами_ОбменВУниверсальномФормате Тогда
				ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
				Возврат;
			КонецЕсли;
			ссылкаУчетнаяЗапись = Организация.УчетнаяЗаписьОбмена;
		Иначе
			ссылкаУчетнаяЗапись = УчетнаяЗапись;
		КонецЕсли;
		
		// получаем настройки учетной записи
		// если настройки недоступны или учетка для обмена напрямую, то прервемся
		НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(ссылкаУчетнаяЗапись);
		Если НастройкиУчетнойЗаписи = Неопределено ИЛИ НастройкиУчетнойЗаписи.ОбменНапрямую Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
		// если включено принудительное игнорирование режима автонастройки
		// или отключена автонастройка в свойствах учетной записи, то прервемся
		Если НастройкиУчетнойЗаписи.РежимАвтонастройки = СтруктураСсылочныхДанных.Перечисления_РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика_Отключена
		ИЛИ НастройкиУчетнойЗаписи.РежимАвтонастройки = СтруктураСсылочныхДанных.Перечисления_РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика_ПустаяСсылка Тогда
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// получаем файл настроек с сервера или из кэша
	ПараметрыФайлаНастроек = ПолучитьФайлНастроекУчетнойЗаписиССервераРОКИСУчетомКэша(УчетнаяЗапись, Организация, УведомлятьТолькоОбОшибках, ИгнорироватьРежимАвтонастройки, ТихийРежим, ЗапрашиватьПараметрыОрганизацииПриНеобходимости, УникальныйИдентификатор);
	Если НЕ ЗначениеЗаполнено(ПараметрыФайлаНастроек) Тогда // если Неопределено, то файл недоступен
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ФайлНастроек = ПараметрыФайлаНастроек.Файл;
	
	ДатаОбновленияФайлаНастроекНаСервере = ПараметрыФайлаНастроек.Дата;
	ФайлНастроекРасшифрован = ПараметрыФайлаНастроек.Расшифрован;
	ИмяРесурсаСНастройками = ПараметрыФайлаНастроек.ИмяРесурса;
	
	// если файл настроек зашифрован, то расшифровываем
	Если НЕ ФайлНастроекРасшифрован Тогда
		
		// объявляем вспомогательные переменные
		Сообщения = СоздатьТаблицуСообщений(Истина);
		
		ПризнакОшибкиВФайлеНастроек = Ложь;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 					ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("УчетнаяЗапись", 							УчетнаяЗапись);
		ДополнительныеПараметры.Вставить("ФайлНастроекРасшифрован", 				ФайлНастроекРасшифрован);
		ДополнительныеПараметры.Вставить("ИмяРесурсаСНастройками", 					ИмяРесурсаСНастройками);
		ДополнительныеПараметры.Вставить("ФайлНастроек", 							ФайлНастроек);
		ДополнительныеПараметры.Вставить("ДатаОбновленияФайлаНастроекНаСервере", 	ДатаОбновленияФайлаНастроекНаСервере);
		ДополнительныеПараметры.Вставить("Сообщения", 								Сообщения);
		ДополнительныеПараметры.Вставить("УведомлятьТолькоОбОшибках", 				УведомлятьТолькоОбОшибках);
		ДополнительныеПараметры.Вставить("Организация", 							Организация);
		Оповещение = Новый ОписаниеОповещения(
			"ПолучитьНастройкиУчетнойЗаписиССервераПослеРасшифрованияТранспортногоКонтейнераРОКИЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		Сертификат = Новый Структура;
		КонтекстМоделиХраненияКлюча(Ложь, Сертификат);
		КриптографияЭДКОКлиент.РасшифроватьPKCS7(Оповещение, ФайлНастроек, , Сертификат, Ложь);
		Возврат;
		
	КонецЕсли;
	
	// формируем таблицу исправлений на основе расшифрованного файла настроек на диске
	СформироватьТаблицуИсправленийНаОсновеФайлаНастроек(
		ФайлНастроек,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		УчетнаяЗапись,
		Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиУчетнойЗаписиССервераПослеРасшифрованияТранспортногоКонтейнераРОКИЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 					= ДополнительныеПараметры.ВыполняемоеОповещение;
	УчетнаяЗапись 							= ДополнительныеПараметры.УчетнаяЗапись;
	ФайлНастроекРасшифрован 				= ДополнительныеПараметры.ФайлНастроекРасшифрован;
	ИмяРесурсаСНастройками 					= ДополнительныеПараметры.ИмяРесурсаСНастройками;
	ФайлНастроек 							= ДополнительныеПараметры.ФайлНастроек;
	ДатаОбновленияФайлаНастроекНаСервере 	= ДополнительныеПараметры.ДатаОбновленияФайлаНастроекНаСервере;
	Сообщения 								= ДополнительныеПараметры.Сообщения;
	УведомлятьТолькоОбОшибках 				= ДополнительныеПараметры.УведомлятьТолькоОбОшибках;
	Организация 							= ДополнительныеПараметры.Организация;
	
	Если НЕ Результат.Выполнено Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Не удалось расшифровать контейнер с настройками!';
											|en = 'Не удалось расшифровать контейнер с настройками!'"));
	КонецЕсли;
	
	ПризнакОшибкиВФайлеНастроек = НЕ Результат.Выполнено;
	РасшифрованныйФайлНастроек = ?(Результат.Выполнено, Результат.РасшифрованныйФайл, Неопределено);
	
	Если НЕ ФайлНастроекРасшифрован Тогда
		
		Если РасшифрованныйФайлНастроек = Неопределено Тогда
			// кэшируем файл настроек, если в нем при расшфровке не была обнаружена ошибка
			Если НЕ ПризнакОшибкиВФайлеНастроек Тогда
				СохранитьВКэшеФайлНастроек(УчетнаяЗапись, ИмяРесурсаСНастройками, РасшифрованныйФайлНастроек, Истина, ДатаОбновленияФайлаНастроекНаСервере);
			КонецЕсли;
			ВывестиСообщения(УчетнаяЗапись, Сообщения, УведомлятьТолькоОбОшибках);
			ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
			Возврат;
		Иначе
			ФайлНастроек = РасшифрованныйФайлНастроек;
			СохранитьВКэшеФайлНастроек(УчетнаяЗапись, ИмяРесурсаСНастройками, ФайлНастроек, Истина, ДатаОбновленияФайлаНастроекНаСервере);
		КонецЕсли;
		
	КонецЕсли;
	
	// формируем таблицу исправлений на основе расшифрованного файла настроек на диске
	СформироватьТаблицуИсправленийНаОсновеФайлаНастроек(
		ФайлНастроек,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		УчетнаяЗапись,
		Организация);
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьОрганизациюПоУчетнойЗаписиКлиент(УчетнаяЗапись) Экспорт
	
	Возврат ОпределитьОрганизациюПоУчетнойЗаписи(УчетнаяЗапись);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьОрганизациюПоУчетнойЗаписи(УчетнаяЗапись)
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.Организации") Тогда
		Возврат УчетнаяЗапись;
	КонецЕсли;
	
	УчетнаяЗаписьСсылка = ПреобразоватьВСсылкуНаУчетнуюЗапись(УчетнаяЗапись);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						  |	Организации.Ссылка
						  |ИЗ
						  |	Справочник.Организации КАК Организации
						  |ГДЕ
						  |	Организации.УчетнаяЗаписьОбмена = &УчетнаяЗаписьОбмена
						  |	И Организации.ВидОбменаСКонтролирующимиОрганами = &ВидОбменаСКонтролирующимиОрганами
						  |	И Организации.ГоловнаяОрганизация = &ПустаяГоловнаяОрганизация
						  |
						  |ОБЪЕДИНИТЬ ВСЕ
						  |
						  |ВЫБРАТЬ ПЕРВЫЕ 1
						  |	Организации.Ссылка
						  |ИЗ
						  |	Справочник.Организации КАК Организации
						  |ГДЕ
						  |	Организации.УчетнаяЗаписьОбмена = &УчетнаяЗаписьОбмена
						  |	И Организации.ВидОбменаСКонтролирующимиОрганами = &ВидОбменаСКонтролирующимиОрганами
						  |	И Организации.ГоловнаяОрганизация <> &ПустаяГоловнаяОрганизация");
	Запрос.УстановитьПараметр("УчетнаяЗаписьОбмена", УчетнаяЗаписьСсылка);
	Запрос.УстановитьПараметр("ВидОбменаСКонтролирующимиОрганами", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	Запрос.УстановитьПараметр("ПустаяГоловнаяОрганизация", Справочники.Организации.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьОрганизациюПоИННиКППНаСервере(ИНН, КПП, НаходитьПомеченныеНаУдаление = Ложь)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОпределитьОрганизациюПоИННиКПП(ИНН, КПП, НаходитьПомеченныеНаУдаление);
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьПараметрыСоединенияССервером(
		УчетнаяЗапись,
		Организация,
		ЗапрашиватьПараметрыОрганизацииПриНеобходимости,
		Сообщения)
	
	Если УчетнаяЗапись = Неопределено ИЛИ НЕ УчетнаяЗапись.ЯвляетсяУчетнойЗаписьюУполномоченногоПредставителя Тогда
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота") Тогда
				Организация = ОпределитьОрганизациюПоУчетнойЗаписи(УчетнаяЗапись);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Организация) Тогда
				Если НЕ ЗапрашиватьПараметрыОрганизацииПриНеобходимости Тогда
					ДобавитьСообщение(Сообщения, НСтр("ru = 'Не удалось определить ИНН\КПП налогоплательщика!';
														|en = 'Не удалось определить ИНН\КПП налогоплательщика!'"));
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
			Если НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация) Тогда
				Сведения = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "ИННФЛ");
				ИНН = СокрЛП(Сведения.ИННФЛ);
				КПП = "";
			Иначе
				Сведения = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "ИННЮЛ, КППЮЛ");
				ИНН = СокрЛП(Сведения.ИННЮЛ);
				КПП = СокрЛП(Сведения.КППЮЛ);
			КонецЕсли;
		Иначе
			ИНН = Организация["ИНН"];
			КПП = Организация["КПП"];
		КонецЕсли;
		ПредставлениеОрганизация = ?(ТипЗнч(Организация) = Тип("СправочникСсылка.Организации"), "" + Организация, "");
	Иначе
		ИНН = СокрЛП(УчетнаяЗапись.ИННУполномоченногоПредставителя);
		КПП = СокрЛП(УчетнаяЗапись.КППУполномоченногоПредставителя);
		ПредставлениеОрганизация = СокрЛП(УчетнаяЗапись.ПолноеНаименованиеУполномоченногоПредставителя);
	КонецЕсли;
		
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректно задан ИНН организации ';
											|en = 'Некорректно задан ИНН организации '") + ПредставлениеОрганизация + "!");
		Возврат Неопределено;
	ИначеЕсли СтрДлина(ИНН) = 10 И СтрДлина(КПП) <> 9 Тогда
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Некорректно задан КПП организации ';
											|en = 'Некорректно задан КПП организации '") + ПредставлениеОрганизация + "!");
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрДлина(ИНН) = 12 Тогда
		ИННКПП = ИНН;
	Иначе
		ИННКПП = ИНН + КПП;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяСервераРОКИ", "cert01.taxcom.ru");
	Результат.Вставить("ИмяРесурсаДТ", "/config/sprinter/" + ИННКПП + "/dt.txt");
	Результат.Вставить("ИмяРесурсаСНастройками", "/config/sprinter/" + ИННКПП + "/config.xml.enc");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкиУчетнойЗаписиИзИБ(Знач УчетнаяЗапись)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
КонецФункции

&НаКлиенте
Процедура ПрименитьИзмененныеНастройки(
		УчетнаяЗапись,
		ТаблицаИсправлений,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		Организация = Неопределено) Экспорт
	
	Сообщения = СоздатьТаблицуСообщений(Истина);
	
	СледуетНастроить = Истина;
	ПрименитьИзмененныеНастройки_Настройка(
		СледуетНастроить,
		ТаблицаИсправлений,
		УчетнаяЗапись,
		Сообщения,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзмененныеНастройки_Настройка(
		СледуетНастроить,
		ТаблицаИсправлений,
		УчетнаяЗапись,
		Сообщения,
		УведомлятьТолькоОбОшибках,
		ВыполняемоеОповещение,
		Организация = Неопределено)
	
	Если СледуетНастроить <> Истина Тогда
		Результат = Новый Структура("РезультатПрименения, ТаблицаИсправлений, УчетнаяЗапись", Ложь, ТаблицаИсправлений, УчетнаяЗапись);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// настраиваем
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("УведомлятьТолькоОбОшибках", УведомлятьТолькоОбОшибках);
	ДополнительныеПараметры.Вставить("ТаблицаИсправлений", ТаблицаИсправлений);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрименитьИзмененныеНастройки_НастройкаПослеНастройкиПоРОКИ", ЭтотОбъект, ДополнительныеПараметры);
	НастроитьПоРОКИ(ОписаниеОповещения, УчетнаяЗапись, ТаблицаИсправлений, Сообщения, Организация);
		
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзмененныеНастройки_НастройкаПослеНастройкиПоРОКИ(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	УведомлятьТолькоОбОшибках 	= ДополнительныеПараметры.УведомлятьТолькоОбОшибках;
	ТаблицаИсправлений          = ДополнительныеПараметры.ТаблицаИсправлений;
	
	УчетнаяЗапись               = Результат.УчетнаяЗапись;
	
	Если НЕ Результат.Выполнено Тогда
		ВывестиСообщения(УчетнаяЗапись, Результат.Сообщения, УведомлятьТолькоОбОшибках);
		РезультатСтруктура = Новый Структура("РезультатПрименения, ТаблицаИсправлений, УчетнаяЗапись", Ложь, ТаблицаИсправлений, УчетнаяЗапись);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатСтруктура);
		Возврат;
	КонецЕсли;
	
	ВывестиСообщения(УчетнаяЗапись, Результат.Сообщения, УведомлятьТолькоОбОшибках);
	РезультатСтруктура = Новый Структура("РезультатПрименения, ТаблицаИсправлений, УчетнаяЗапись", Истина, ТаблицаИсправлений, УчетнаяЗапись);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатСтруктура);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьНастройкиПоРОКИ(
		УчетнаяЗапись,
		ТаблицаНеобходимыхИзменений,
		Сообщения,
		СоответствиеКомандРегистрацииСертификатовХранилищам,
		СоответствиеКомандРегистрацииСертификатовПредставлениям,
		СоответствиеИдентификаторовХранилищПредставлениям,
		Организация = Неопределено)
	
	НачатьТранзакцию();
	ТранзакцияПустая = Истина;
	
	// получаем объект - учетную запись
	Если УчетнаяЗапись = Неопределено Тогда
	    УчетнаяЗаписьОбъект = Справочники.УчетныеЗаписиДокументооборота.СоздатьЭлемент();
		УчетнаяЗаписьОбъект.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.Такском;
		УчетнаяЗаписьОбъект.ОбменНапрямую = Ложь;
		УчетнаяЗаписьОбъект.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.ВключенаВТихомРежиме;
		УчетнаяЗаписьОбъект.ИспользоватьСервисОнлайнПроверкиОтчетов = Истина;
		УчетнаяЗаписьОбъект.ЗаписатьПользователяПоУмолчанию = Истина;
		УчетнаяЗаписьОбъект.НеФормироватьПодтвержденияАвтоматически = Ложь;
		УчетнаяЗаписьОбъект.ИдентификаторСистемыОтправителяПФР = "taxcom";
		УчетнаяЗаписьОбъект.ЭтоЗаписьНового = Истина;
		УчетнаяЗаписьОбъект.ДатаПодключения = ТекущаяДатаСеанса();
	ИначеЕсли ТипЗнч(УчетнаяЗапись) = Тип("СправочникОбъект.УчетныеЗаписиДокументооборота") Тогда
		УчетнаяЗаписьОбъект = УчетнаяЗапись;
	Иначе
		УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	// Настройка сервера документооборота
	
	Если ЗначениеЗаполнено(УчетнаяЗаписьОбъект.СерверДокументооборота) 
		И УчетнаяЗаписьОбъект.СерверДокументооборота.ПолучитьОбъект() <> Неопределено Тогда
		СерверДокументооборотаОбъект = УчетнаяЗаписьОбъект.СерверДокументооборота.ПолучитьОбъект();
	Иначе
		СерверДокументооборотаОбъект = Справочники.СерверыДокументооборота.СоздатьЭлемент();
	КонецЕсли;
	
	// изменяем адреса сервера документооборота
	КомандаИзменитьАдресПочтовогоСервераФНС  = НайтиСтрокуВМассивеСтруктур(ТаблицаНеобходимыхИзменений, "ИзменитьАдресПочтовогоСервера", "Настройка");
	КомандаИзменитьАдресПочтовогоСервераПФР  = НайтиСтрокуВМассивеСтруктур(ТаблицаНеобходимыхИзменений, "ИзменитьАдресПочтовогоСервераПФР", "Настройка");
	КомандаИзменитьАдресПочтовогоСервераФСГС = НайтиСтрокуВМассивеСтруктур(ТаблицаНеобходимыхИзменений, "ИзменитьАдресПочтовогоСервераФСГС", "Настройка");
	
	Если КомандаИзменитьАдресПочтовогоСервераФНС <> Неопределено ИЛИ КомандаИзменитьАдресПочтовогоСервераПФР <> Неопределено ИЛИ КомандаИзменитьАдресПочтовогоСервераФСГС <> Неопределено Тогда
		
		// меняем адрес для обмена с ФНС при необходимости
		Если КомандаИзменитьАдресПочтовогоСервераФНС <> Неопределено Тогда
			СерверДокументооборотаОбъект.АдресЭлектроннойПочтыФНС = нрег(КомандаИзменитьАдресПочтовогоСервераФНС.НовоеЗначение);
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен адрес электронной почты сервера документооборота для обмена с ФНС.';
												|en = 'Изменен адрес электронной почты сервера документооборота для обмена с ФНС.'"), Ложь);
		КонецЕсли;
		
		// меняем адрес для обмена с ПФР при необходимости
		Если КомандаИзменитьАдресПочтовогоСервераПФР <> Неопределено Тогда
			СерверДокументооборотаОбъект.АдресЭлектроннойПочтыПФР = нрег(КомандаИзменитьАдресПочтовогоСервераПФР.НовоеЗначение);
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен адрес электронной почты сервера документооборота для обмена с СФР (бывш. ПФР).';
												|en = 'Изменен адрес электронной почты сервера документооборота для обмена с СФР (бывш. ПФР).'"), Ложь);
		КонецЕсли;
		
		// меняем адрес для обмена с Росстатом при необходимости
		Если КомандаИзменитьАдресПочтовогоСервераФСГС <> Неопределено Тогда
			СерверДокументооборотаОбъект.АдресЭлектроннойПочтыФСГС = нрег(КомандаИзменитьАдресПочтовогоСервераФСГС.НовоеЗначение);
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен адрес электронной почты сервера документооборота для обмена с ФСГС.';
												|en = 'Изменен адрес электронной почты сервера документооборота для обмена с ФСГС.'"), Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	// изменяем сертификат сервера документооборота
	КомандаИзменитьСертификатПочтовогоСервера = НайтиСтрокуВМассивеСтруктур(ТаблицаНеобходимыхИзменений, "ИзменитьСертификатПочтовогоСервера", "Настройка");
	Если КомандаИзменитьСертификатПочтовогоСервера <> Неопределено Тогда
		СерверДокументооборотаОбъект.Сертификат = нрег(КомандаИзменитьСертификатПочтовогоСервера.НовоеЗначение.Отпечаток);
		ДобавитьСообщение(Сообщения, НСтр("ru = 'Изменен сертификат сервера документооборота.';
											|en = 'Изменен сертификат сервера документооборота.'"), Ложь);
	КонецЕсли;
	
	// записываем изменения в свойствах сервера документооборота
	Если СерверДокументооборотаОбъект.Модифицированность() Тогда
		Попытка
			СерверДокументооборотаОбъект.Записать();
			ТранзакцияПустая = Ложь;
		Исключение
			ОтменитьТранзакцию();
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
			ДобавитьСообщение(Сообщения, НСтр("ru = 'Ошибка обновления настроек учетной записи:';
												|en = 'Ошибка обновления настроек учетной записи:'") + Символы.ПС + ИнформацияОбОшибке().Описание);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// при необходимости, изменяем ссылку на сервер документооборота у учетной записи
	Если УчетнаяЗаписьОбъект.СерверДокументооборота <> СерверДокументооборотаОбъект.Ссылка Тогда
		УчетнаяЗаписьОбъект.СерверДокументооборота = СерверДокументооборотаОбъект.Ссылка;
		ДобавитьСообщение(Сообщения, НСтр("ru = 'В свойствах учетной записи сервер документооборота изменен на вновь созданный.';
											|en = 'В свойствах учетной записи сервер документооборота изменен на вновь созданный.'"), Ложь);
	КонецЕсли;
	
	// Настройка сервера документооборота
	///////////////////////////////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////////////////////////////
	// Настройка налоговых органов
	
	// регистрируем налоговые органы
	КомандыЗарегистрироватьИФНС = НайтиСтрокиМассиваСтруктур(ТаблицаНеобходимыхИзменений, "Настройка", "ЗарегистрироватьИФНС");
	Для Каждого СтрКоманда Из КомандыЗарегистрироватьИФНС Цикл
		
		// параметры команды
		КодИФНС = СокрЛП(СтрКоманда.НовоеЗначение);
		НаименованиеИФНС = СтрКоманда.ДопПараметр;
		
		// создаем новый элемент справочника, присваиваем код и наименование, записываем
		НалоговыйОрганОбъект = Справочники.НалоговыеОрганы.СоздатьЭлемент();
		НалоговыйОрганОбъект.Код = КодИФНС;
		НалоговыйОрганОбъект.Наименование = НаименованиеИФНС;
		НалоговыйОрганОбъект.Записать();
		
		ТранзакцияПустая = Ложь;
		
		// генерируем сообщение
		ДобавитьСообщение(Сообщения,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Создан новый элемент справочника ""Налоговые органы"" с кодом ""%1"" и наименованием ""%2"".';
																		|en = 'Создан новый элемент справочника ""Налоговые органы"" с кодом ""%1"" и наименованием ""%2"".'"),
			КодИФНС,
			НаименованиеИФНС),
			Ложь);
	КонецЦикла;
	
	// меняем сертификаты
	КомандыИзменитьСертификатИФНС = НайтиСтрокиМассиваСтруктур(ТаблицаНеобходимыхИзменений, "Настройка", "ИзменитьСертификатИФНС");
	Для Каждого СтрКоманда Из КомандыИзменитьСертификатИФНС Цикл
		
		// параметры команды
		СертификатыИФНС = СтрКоманда.НовоеЗначение;
		КодИФНС = СокрЛП(СтрКоманда.ДопПараметр);
		
