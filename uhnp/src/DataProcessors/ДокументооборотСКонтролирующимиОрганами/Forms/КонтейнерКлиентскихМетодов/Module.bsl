#Область СформироватьПакетФНС
 
// Формирует пакет в формате приказа ФНС 534.
//
&НаКлиенте
Процедура СформироватьПакетФНС(ОповещениеОЗавершении, ТранспортноеСообщение, Оповещать = Ложь, ПараметрыОперации = Неопределено) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Оповещать);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;	
	
	// общие проверки
	Если НЕ СформироватьПакетФНС_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда // сервер
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
		
	// получение и проверки сертификатов
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФНСПослеПроверкиИПолученияСертификатовПолучателя", ЭтотОбъект, Контекст);
		
	СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателя(Оповещение, КонтекстОтправки); // клиент
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФНСПослеПроверкиИПолученияСертификатовПолучателя(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Результат Тогда
		Если НЕ СформироватьПакетФНС_ПроверкиНаСервере(КонтекстОтправки) Тогда // универсальная
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		// проверки на клиенте (сертификаты)
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетФНСПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
			
		СформироватьПакетФНС_ПроверкиСертификатов(Оповещение, КонтекстОтправки);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФНСПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ДекларацияНП
		ИЛИ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ЗаявлениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_Форма2НДФЛНП
		ИЛИ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ОбращениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ПредставлениеНП
		ИЛИ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_ЗапросНП Тогда
		
		РезультатФормирования = СформироватьОписаниеСведенийДляСообщенияФНС(КонтекстОтправки); // сервер
		Если НЕ РезультатФормирования Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
	Иначе
		Если НЕ КонтекстОтправки.ТипСообщения = СтруктураСсылочныхДанных.Перечисления_ТипыТранспортныхСообщений_РезультатПриемаДокументНП Тогда
			РезультатФормирования = СформироватьИзвещениеОПолученииДляСообщенияФНС_НаСервере(КонтекстОтправки); // сервер
			
			Если НЕ РезультатФормирования Тогда
				ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

	// подписываем ЭЦП руководителя и главного бухгалтера
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФНСПослеПодписания", ЭтотОбъект, Контекст);
	СформироватьПакетФНС_Подписание(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФНСПослеПодписания(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;

	// формируем дерево описания документов пакета (сервер)
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется формирование описания пакета с документами..."); // ФНС Универсальная
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетФНС_СформироватьДеревоОписанияДокументовПакета(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	РежимПодтвержденияОблачнойПодписи("СформироватьПакетФНС", КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки, Ложь);
	
	// отрабатываем отложенные команды на клиенте (шифрование)
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФНСПослеВыполненияОтложенныхКомандНаКлиенте", ЭтотОбъект, ВходящийКонтекст);
	СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФНСПослеВыполненияОтложенныхКомандНаКлиенте(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура СформироватьПакетФНСПослеВыполненияОтложенныхКоманд(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// формируем файл описания пакета, создаем архив и помещаем в ИБ
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	СведенияОШифровании = ПараметрыПриложения["КриптографияЭДКО.СведенияОШифровании"];
	Если СведенияОШифровании <> Неопределено Тогда
		КонтекстОтправки.Вставить("СведенияОШифровании", СведенияОШифровании);
		ПараметрыПриложения["КриптографияЭДКО.СведенияОШифровании"] = Неопределено;
	КонецЕсли;
	Если НЕ СформироватьПакетФНС_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.Оповещать Тогда
		Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
														КонтекстОтправки.ТранспортноеСообщение,
														КонтекстОтправки.ЦиклОбмена));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

