Функция СрокЛицензииКриптоПроКонечный() Экспорт
	
	ДатаИстеченияЛицензии = ДатаИстеченияЛицензииКриптоПро();
	Если ДатаИстеченияЛицензии = Неопределено Тогда
		ЭтоБесконечнаяЛицензия = Истина;
	Иначе
		ЭтоБесконечнаяЛицензия = ДатаИстеченияЛицензии = БесконечнаяДатаИстеченияЛицензииКриптоПро();
	КонецЕсли;
	
	Возврат НЕ ЭтоБесконечнаяЛицензия;
	
КонецФункции

&НаКлиенте
Функция ЗапретитьВыводОшибокКриптоПро(ДокументЗаявление, НовыйСтатусДокумента) Экспорт
	
	#Если ВебКлиент Тогда
		Возврат Ложь;
		
	#Иначе
		
		Если НЕ ДокументЗаявление.ВключитьЛицензиюКриптоПро
			ИЛИ НовыйСтатусДокумента <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено") Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// В вебе нет этого метода
		ИмяФайла = ПолучитьИмяВременногоФайла(".q");
		
		WshShell = Неопределено;
		#Если НЕ МобильныйКлиент Тогда
			Попытка
				WshShell = Новый COMОбъект("WScript.Shell");
			Исключение
			КонецПопытки;
		#КонецЕсли
		
		Если WshShell = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Попытка
			WshShell.Run("cmd.exe /c whoami /user >""" + ИмяФайла+"""", 0, true);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяФайла, "cp866");
		ПоследняяСтрока = Текст.ПолучитьСтроку(Текст.КоличествоСтрок());
		УдалитьФайлы(ИмяФайла);

		Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоследняяСтрока, " ", Истина, Истина);
		
		Если Подстроки.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		SID = Подстроки[1];

		ПутьРазрядности = "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment\PROCESSOR_ARCHITECTURE";
		
		Попытка
			Значение = WshShell.RegRead(ПутьРазрядности);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
		Если Значение = "AMD64" Тогда 
			// 64х битная
			Путь = "HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Crypto Pro\Settings\USERS\" + SID +"\KeyDevices\LicErrorLevel";
		Иначе
			// 32х битная
			Путь = "HKEY_LOCAL_MACHINE\SOFTWARE\Crypto Pro\Settings\USERS\" + SID +"\KeyDevices\LicErrorLevel";
		КонецЕсли;
		
		Попытка
			WshShell.RegWrite(Путь, 2);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
	#КонецЕсли
	
КонецФункции

