Функция ПредставлениеСообщения(Сообщение) Экспорт
	
	Тема = ?(ПустаяСтрока(Сообщение.Тема), "<тема не указана>", """" + Сообщение.Тема + """");
	Если ЗначениеЗаполнено(Сообщение.Дата) Тогда
		Возврат Тема + " от " + Сообщение.Дата;
	Иначе
		Возврат Тема;
	КонецЕсли;
	
