#КонецОбласти

#Область ПодтверждениеПрочтенияСообщенийСЭДОФСС

&НаКлиенте
Процедура ПодтверждениеПрочтенияСообщенийСЭДОФСС(ОповещениеОбратногоВызова,
		Организация,
		ИдентификаторыСообщений,
		ПослеОтправкиПолучитьВходящие,
		ОткрыватьФормуДлительнойОперации = Истина) Экспорт
		
	Для каждого Идентификатор Из ИдентификаторыСообщений Цикл
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			Результат = РезультатОтправитьСообщениеСЭДОФСС();
			Результат.ОписаниеОшибки = НСтр("ru = 'Не указан идентификатор исходного сообщения.';
											|en = 'Не указан идентификатор исходного сообщения.'");
			ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	РегистрационныйНомерФСС = РегистрационныйНомерФССОрганизации(Организация);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОбратногоВызова", ОповещениеОбратногоВызова);
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("ИдентификаторыСообщений", ИдентификаторыСообщений);
	ДополнительныеПараметры.Вставить("ФормаДлительнойОперации", Неопределено);
	ДополнительныеПараметры.Вставить("ПослеОтправкиПолучитьВходящие", ПослеОтправкиПолучитьВходящие);
	
	ПараметрыСообщения = ПараметрыОтправитьСообщениеСЭДОФСС();
	ПараметрыСообщения.ТипСообщения = 6;
	ПараметрыСообщения.СодержимоеСообщения =
		СодержимоеСообщенияПодтверждениеПрочтенияСообщений(ИдентификаторыСообщений);
	ПараметрыСообщения.Организация = Организация;
	ПараметрыСообщения.ОписаниеОшибки =
		НСтр("ru = 'Не удалось отправить подтверждение о получении сообщения в СЭДО СФР.
		|%1';
		|en = 'Не удалось отправить подтверждение о получении сообщения в СЭДО СФР.
		|%1'");
	
	Оповещение = Новый ОписаниеОповещения(
		"ПодтверждениеПрочтенияСообщенияПослеОтправки",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПараметрыСообщения.ОповещениеОбратногоВызова = Оповещение;
	
	// Открываем форму длительной операции.
	ПараметрыОжидания = Новый Структура();
	ПараметрыОжидания.Вставить("ТекстСообщения", НСтр("ru = 'Отправка подтверждений о получении сообщений СЭДО СФР.';
														|en = 'Отправка подтверждений о получении сообщений СЭДО СФР.'"));
	Если ОткрыватьФормуДлительнойОперации Тогда
		ДополнительныеПараметры.ФормаДлительнойОперации = ОткрытьФорму(
			"ОбщаяФорма.ДлительнаяОперация", ПараметрыОжидания);
	КонецЕсли;
	
	ОтправитьСообщениеСЭДОФСС(ПараметрыСообщения, , , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПрочтенияСообщенияПослеОтправки(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	Организация = ДополнительныеПараметры.Организация;
	ИдентификаторыСообщений = ДополнительныеПараметры.ИдентификаторыСообщений;
	ФормаДлительнойОперации = ДополнительныеПараметры.ФормаДлительнойОперации;
	ПослеОтправкиПолучитьВходящие = ДополнительныеПараметры.ПослеОтправкиПолучитьВходящие;
	
	// Закроем окно заставки длительной операции, если она была открыта.
	ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
		Возврат;
	КонецЕсли;
	
	СохранитьДатуОтправкиПодтвержденияОПрочтении(Организация, ИдентификаторыСообщений);
	
	Если ПослеОтправкиПолучитьВходящие Тогда
		Оповещение = Новый ОписаниеОповещения(
			"ПодтверждениеПрочтенияСообщенияПослеПолученияВходящих",
			ЭтотОбъект,
			ДополнительныеПараметры);
 		ПолучитьВходящиеСообщенияСЭДОФСС(
			Оповещение,
			Организация);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеПрочтенияСообщенияПослеПолученияВходящих(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОбратногоВызова = ДополнительныеПараметры.ОповещениеОбратногоВызова;
	
	ВыполнитьОбработкуОповещения(ОповещениеОбратногоВызова, Результат);
	
КонецПроцедуры

