#Область ОтправкаРеестраНДС

#КонецОбласти

#Область ОтправкаРеестраНДС

// используется также для отправки реестров по акцизам
&НаКлиенте
Процедура ОтправкаРеестраНДС(ВыполняемоеОповещение) Экспорт
	
	ДополнительныеПараметры = ВыполняемоеОповещение.ДополнительныеПараметры;
	ДокументСсылка 	 		= ДополнительныеПараметры.СсылкаНаОтчет;
	Идентификатор 			= ДополнительныеПараметры.Форма.УникальныйИдентификатор;
	Организация             = ДополнительныеПараметры.ОрганизацияОтчета;
	
	// Копируем только нужные параметры и дополняем своими.
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("УникальныйИдентификатор", 	Идентификатор);
	КонтекстОтправки.Вставить("Документ", 				 	ДокументСсылка);
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	ДанныеФайловВыгрузки = ПолучитьДанныеФайлаРеестраНДС(ДокументСсылка, ДополнительныеПараметры.Форма);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если ДанныеФайловВыгрузки.Количество() <> 2
		И (ДанныеФайловВыгрузки.Количество() <> 1 ИЛИ Лев(ДанныеФайловВыгрузки[0].Имя, 9) <> "ON_REESTR") Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Реестр.

		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ДанныеФайловВыгрузки", 	ДанныеФайловВыгрузки);
	ДополнительныеПараметры.Вставить("Организация", 	        Организация);
	ДополнительныеПараметры.Вставить("ДокументСсылка", 	        ДокументСсылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРеестраНДСПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ДокументСсылка", 		ДокументСсылка);
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);

	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ДокументСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка реестра в ФНС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаРеестраНДС",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаРеестраНДС() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ДокументСсылка 		= КонтекстДлительнойОперации.ДокументСсылка;
	ОписаниеОповещения 	= КонтекстДлительнойОперации.ОписаниеОповещения;
		
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ДокументСсылка, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРеестраНДС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ОтправкаРеестраНДС(ВходящийКонтекст.ВыполняемоеОповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРеестраНДСПослеАвтонастройкиУчетнойЗаписи(Результат, Знач ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаРеестраНДС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.ДокументСсылка, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРеестраНДС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	ВыполняемоеОповещение	= ВходящийКонтекст.ВыполняемоеОповещение;
	ДополнительныеПараметры = ВыполняемоеОповещение.ДополнительныеПараметры;
	ДокументСсылка 	 		= ДополнительныеПараметры.СсылкаНаОтчет;
	Идентификатор 			= ДополнительныеПараметры.Форма.УникальныйИдентификатор;
	ДанныеФайловВыгрузки	= ВходящийКонтекст.ДанныеФайловВыгрузки;
	
	ОтправкаОбъектаЗапрещена = ДокументооборотСКОВызовСервера.ОтправкаОбъектаЗапрещенаНаТарифеПромоЕНС(ДокументСсылка);
	Если ОтправкаОбъектаЗапрещена Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНевозможностиОтправкиНаТарифе(ДокументСсылка);
		Возврат;
	КонецЕсли;
	
	// Копируем только нужные параметры и дополняем своими.
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("УникальныйИдентификатор", 	Идентификатор);
	КонтекстОтправки.Вставить("Документ", 				 	ДокументСсылка);
	
	// отражаем изменения в базе
	Если НЕ ОтправкаРеестраНДС_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки, ДанныеФайловВыгрузки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаРеестраНДС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст); 
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ДокументСсылка, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь); //+
			
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Реестр.
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ДокументСсылка) Тогда
			
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ДокументСсылка, ВыполняемоеОповещение, Ложь); //+
		Возврат;
			
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 	ВыполняемоеОповещение);
	Контекст.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	
	// формируем пакет
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРеестраНДСПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ФНС");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаРеестраНДС_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст, ДанныеФайловВыгрузки)
	
	ДокументСсылка = Контекст.Документ;
	
	// проверяем, включен ли механизм обмена с ФНС для организации, указанной в журнале
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСФНС") <> Истина Тогда
		
	    // Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	//требуется сформировать файл доверенности 
	//и определить налоговый орган (для записи в реквизит цикла обмена)
	//для этого определяем ИФНС через переопределяемый модуль
	КодНалоговогоОргана = СведенияПоОтправляемымОбъектам(ДокументСсылка).КодКонтролирующегоОргана;
	Если НЕ ЗначениеЗаполнено(КодНалоговогоОргана) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить налоговый орган, в который представляется отчетность!';
								|en = 'Не удалось определить налоговый орган, в который представляется отчетность!'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	НалоговыйОрган = Справочники.НалоговыеОрганы.НайтиПоКоду(КодНалоговогоОргана);
	Если НЕ ЗначениеЗаполнено(НалоговыйОрган) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.';
			|en = 'Не найден налоговый орган с кодом %1  в справочнике налоговых органов""!.'"), Символ(34) + КодНалоговогоОргана + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	//теперь формируем файл доверенности
	ФайлДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
			ЭлРегистрацияВИФНС,
			КороткоеИмяФайлаДоверенности,
			Организация,,,
			Истина);
		Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось выгрузить файл доверенности.';
									|en = 'Не удалось выгрузить файл доверенности.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
			ФайлДоверенности = Неопределено;
		КонецЕсли;
	ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
		
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка 				= Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид 					= Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС;
	ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСФНС.Приказ534;
	ЦиклОбмена.Предмет 				= ДокументСсылка;
	ЦиклОбмена.Идентификатор 		= СгенерироватьUUID();
	ЦиклОбмена.Организация 			= Организация;
	ЦиклОбмена.УчетнаяЗапись 		= УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация 	= НалоговыйОрган;
	ЦиклОбмена.Тип 					= Перечисления.ТипыЦикловОбмена.Представление;
	ЦиклОбмена.ВидОтчета 			= ЭлектронныйДокументооборотСКонтролирующимиОрганами.ВидОтправляемогоДокументаРеестраНДСПоСсылке(ДокументСсылка);
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена 	= ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип 			= Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
	ТранспортноеСообщение.Отправитель 	= Организация;
	ТранспортноеСообщение.Получатель 	= НалоговыйОрган;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус 		= Перечисления.СтатусыПисем.Исходящее;
	
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ФНС) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
		
	Для каждого ФайлВыгрузки Из ДанныеФайловВыгрузки Цикл
		
		Если Найти(ФайлВыгрузки.Имя, ".2_") > 0 Тогда
			ТипСодержимого = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение;
		Иначе
			ТипСодержимого = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление;
		КонецЕсли;
	
		//добавляем файл Представление
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
				ТранспортноеСообщение.Ссылка, 
				ТипСодержимого, 
				ФайлВыгрузки.Адрес, 
				ФайлВыгрузки.Имя, 
				, 
				, 
				, 
				, 
				, 
				, 
				СгенерироватьUUID(), 
				Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			
			ТекстСообщения = НСтр("ru = 'Отправка реестра прервана.';
									|en = 'Отправка реестра прервана.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ОтменитьТранзакцию();
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// добавляем доверенность, если она есть
	Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
				ТранспортноеСообщение.Ссылка, 
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление, 
				ФайлДоверенности, 
				КороткоеИмяФайлаДоверенности, 
				, 
				,
				,
				,
				, 
				, 
				СгенерироватьUUID(), 
				Перечисления.ТипыСодержимогоФайлов.xml) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
		
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(ДокументСсылка, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаРеестраНДСПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки 	= ВходящийКонтекст.КонтекстОтправки;
	Документ 			= КонтекстОтправки.Документ;
	
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Реестр.
		
		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Реестр.

		Возврат;
	КонецЕсли;
	
	Оповестить("Запись_РегламентированныйОтчетРеестрНДСПриложение", КонтекстОтправки.Документ);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Реестр.
	
КонецПроцедуры

// используется для независимой (от требования о представлении документов) отправки журнала СФ,
// используется также для получения данных реестров акцизов
&НаКлиенте
Функция ПолучитьДанныеФайлаРеестраНДС(ДокументСсылка, Форма)
	
	// инициализируем структуру-результат
	МассивВыгруженныхФайлов = Новый Массив;
	Если ТипЗнч(ДокументСсылка) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		МассивВыгруженныхФайлов = ПолучитьДанныеФайлаЭлектронногоПредставленияРеестраНДС(ДокументСсылка, Форма.УникальныйИдентификатор);
		
	Иначе
		
		// выгружаем отчет
		МассивДанныхВыгрузки		= "";
		МассивИменФайловВыгрузки 	= "";
		КодировкаФайлаВыгрузки 		= Неопределено;
		
		Если Форма <> Неопределено
			И ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения")
			И (СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрНДСПриложение") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрНДСДекларации") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрНДС_КНД") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрАкцизыПриложение") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрАкцизыВычетыДенатурированныйЭтиловыйСпирт") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрАкцизыВычетыВиноматериалыВиногрИФруктСусло") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрАкцизыВычетыВиноград") > 0
			ИЛИ СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетРеестрАкцизы_КНД") > 0) Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента",,Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;
		
		РезультатВыгрузки = ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(
			ДокументСсылка, 
			Ложь, 
			, 
			МассивДанныхВыгрузки, 
			МассивИменФайловВыгрузки, 
			КодировкаФайлаВыгрузки, 
			Истина);
			
		Если НЕ РезультатВыгрузки Тогда
			Возврат МассивВыгруженныхФайлов;
		КонецЕсли;
		
		МодульДокументооборотСРЭЦВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСРЭЦВызовСервера");
		МодульДокументооборотСРЭЦВызовСервера.ОбработатьМассивДанныхВыгрузки(ДокументСсылка, МассивДанныхВыгрузки);
		
		Для каждого ДанныеВыгрузки Из МассивДанныхВыгрузки Цикл
		
			ДанныеФайла = Новый Структура;
			ДанныеФайла.Вставить("Имя", 		ДанныеВыгрузки.ИмяФайлаВыгрузки);
			ДанныеФайла.Вставить("Адрес", 		ДанныеВыгрузки.АдресФайлаВыгрузки);
			ДанныеФайла.Вставить("Кодировка", 	КодировкаФайлаВыгрузки);
			
			МассивВыгруженныхФайлов.Добавить(ДанныеФайла);
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивВыгруженныхФайлов;
	
КонецФункции

// используется также для получения данных электиронных представлений реестров по акцизам
&НаСервереБезКонтекста
Функция ПолучитьДанныеФайлаЭлектронногоПредставленияРеестраНДС(ДокументСсылка, УникальныйИдентификаторФормы)
	
	МассивВыгруженныхФайлов = Новый Массив;
	
	Таб = ИзвлечьЭлектронныеПредставленияИзХранилища(ДокументСсылка, 2);
	
	Для Каждого Выборка Из Таб Цикл
		
		Если Выборка.ВАрхиве Тогда
			ДанныеПредставления = Base64Значение("");
		Иначе
			ДанныеПредставления = Выборка.Данные;
		КонецЕсли;
		
		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("Имя", 	Выборка.ИмяФайла);		
		ДанныеФайла.Вставить("Адрес", 	ПоместитьВоВременноеХранилище(ДанныеПредставления, Новый УникальныйИдентификатор));
		
		МассивВыгруженныхФайлов.Добавить(ДанныеФайла);
		
	КонецЦикла;
	
	Возврат МассивВыгруженныхФайлов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВДеревоДокументыРеализацииПолномочий(УзелДокумент, ДанныеФайловВыгрузки, ПараметрыОписи, КолФайл)
	
	УзелДокНапрНО 	= ДобавитьУзелXML(УзелДокумент, "ДокПредстНО");
	
	ДобавитьУзелXML(УзелДокНапрНО, "КолФайл", Истина, Формат(КолФайл, "ЧГ=0"));
	ДобавитьУзелXML(УзелДокНапрНО, "ИдФайлОсн", Ложь, ПараметрыОписи.ИдФайлОсн);
	
	Если НЕ ДобавитьВФайлВыгрузкиДокФорм(УзелДокНапрНО, ДанныеФайловВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ДобавитьФайлВыгрузкиНеДокФорм(УзелДокНапрНО, ДанныеФайловВыгрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
		
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВФайлВыгрузкиДокФорм(УзелДокНапрНО, ДанныеФайловВыгрузки)
			
	КНДПоВидуДокумента = ПолучитьСоответствиеКНДПоВидуДокумента();
			
	Для каждого СведенияЭлектронногоДокумента Из ДанныеФайловВыгрузки.ТаблицаДокФорм Цикл
			
		ОбщиеСвойстваЭД   = Новый Структура();
		МассивЭлементовЭД = Новый Массив;
		
		ОбщиеСвойстваЭД.Вставить("ПорНомДок", СведенияЭлектронногоДокумента.ПорНом);
		
		ОбщиеСвойстваЭД.Вставить("ЭтоПакетСДопДокументами", СведенияЭлектронногоДокумента.ЭтоПакетСДопДокументами);
	
		ДокФорм_ОпределитьСведенияДокумента(СведенияЭлектронногоДокумента, МассивЭлементовЭД, КНДПоВидуДокумента);
		
		Если НЕ ДокФорм_ОпределитьСведенияДокументаПодтверждения(СведенияЭлектронногоДокумента, МассивЭлементовЭД) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если НЕ ДокФорм_ОпределитьСведенияДокументаОснования(СведенияЭлектронногоДокумента, ОбщиеСвойстваЭД) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ДокФорм_ДобавитьВсеСведенияВОпись(УзелДокНапрНО, МассивЭлементовЭД, ОбщиеСвойстваЭД);
		
	КонецЦикла;
		
	Возврат Истина;
		
КонецФункции

&НаСервереБезКонтекста
Функция ДокФорм_ДобавитьВсеСведенияВОпись(УзелДокНапрНО, МассивЭлементовЭД, ОбщиеСвойстваЭД)

	//заполнение файла xml на основе ОбщиеСвойстваЭД и МассивЭлементовЭД 
	Для каждого СвойстваЭлементаЭД Из МассивЭлементовЭД Цикл
		
		УзелДокФорм	= ДобавитьУзелXML(УзелДокНапрНО, "ДокФорм");

		Если НЕ ОбщиеСвойстваЭД.ЭтоПакетСДопДокументами Тогда 
			ДобавитьУзелXML(УзелДокФорм, "ПорНомДок", 	Истина, ОбщиеСвойстваЭД.ПорНомДок);
		КонецЕсли;
		
		Если ТребованияФНСКлиентСервер.ЭтоФормат_ON_DOCNPNO_1_886_00_05_02() Тогда
			Если СвойстваЭлементаЭД.Свойство("ТипФайл") Тогда
				ДобавитьУзелXML(УзелДокФорм, "ТипФайл", Истина, СвойстваЭлементаЭД.ТипФайл);
			Иначе
				ДобавитьУзелXML(УзелДокФорм, "ТипФайл", Истина, 1);
			КонецЕсли;
		КонецЕсли;
		
		ДобавитьУзелXML(УзелДокФорм, "ИдФайл", 		Истина, СвойстваЭлементаЭД.ИдФайл);

		Если ОбщиеСвойстваЭД.Свойство("СвДокОсн") И ЗначениеЗаполнено(ОбщиеСвойстваЭД.СвДокОсн) Тогда
			ДобавитьУзелXML(УзелДокФорм, "СвДокОсн", Ложь, ОбщиеСвойстваЭД.СвДокОсн);
		Конецесли;

		ДобавитьУзелXML(УзелДокФорм, "ИдФайлЭП", 	Ложь, СвойстваЭлементаЭД.ИдФайлЭП);
		ДобавитьУзелXML(УзелДокФорм, "КНД_Док", 	Ложь, СвойстваЭлементаЭД.КНД_Док);

	КонецЦикла;
			
КонецФункции

&НаСервереБезКонтекста
Функция ДокФорм_ОпределитьСведенияДокумента(СведенияЭлектронногоДокумента, МассивЭлементовЭД, КНДПоВидуДокумента)

	//заполнение массива МассивЭлементовЭД
	СвойстваЭлементаЭД = Новый Структура("КНД_Док, ИдФайл, ИдФайлЭП, ТипФайл");
				
	ИдФайл = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СведенияЭлектронногоДокумента.ИмяФайлаДанных).ИмяБезРасширения;
				
	СвойстваЭлементаЭД.ИдФайл		= ИдФайл;
	СвойстваЭлементаЭД.ИдФайлЭП 	= СведенияЭлектронногоДокумента.ИмяФайлаПодписи;
	
	Если ЗначениеЗаполнено(СведенияЭлектронногоДокумента.КНД) Тогда
		СвойстваЭлементаЭД.КНД_Док = СведенияЭлектронногоДокумента.КНД;
	Иначе
		СвойстваЭлементаЭД.КНД_Док = КНДПоВидуДокумента[СведенияЭлектронногоДокумента.ВидДокумента];
	КонецЕсли;
	
	ДокФорм_ОпределитьТипФайл(СведенияЭлектронногоДокумента.ИмяФайлаДанных, СвойстваЭлементаЭД);
				
	МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
				
КонецФункции

&НаСервереБезКонтекста
Функция ДокФорм_ОпределитьСведенияДокументаОснования(СведенияЭлектронногоДокумента, ОбщиеСвойстваЭД)
				
	Если СведенияЭлектронногоДокумента.ВидДокумента = Перечисления.ВидыПредставляемыхДокументов.АктПриемкиСдачиРабот Тогда
				
		Если ЗначениеЗаполнено(СведенияЭлектронногоДокумента.СведенияДокументаОснования) Тогда
			ОбщиеСвойстваЭД.Вставить("СвДокОсн", СведенияЭлектронногоДокумента.СведенияДокументаОснования);
		КонецЕсли;
				
	КонецЕсли;
			
	Возврат Истина;
		
КонецФункции

&НаСервереБезКонтекста
Функция ДокФорм_ОпределитьСведенияДокументаПодтверждения(СведенияЭлектронногоДокумента, МассивЭлементовЭД)
		
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Виды = КонтекстЭДОСервер.ВидыДокументовЭДОСПодтверждением();
	
	Если ЗначениеЗаполнено(СведенияЭлектронногоДокумента.ПодтверждениеИмяФайлаДанных) Тогда

		СвойстваЭлементаЭД = Новый Структура("КНД_Док, ИдФайл, ИдФайлЭП");
		ИмяФайлаВыгрузки = Сред(СведенияЭлектронногоДокумента.ПодтверждениеИмяФайлаДанных, 1, СтрДлина(СведенияЭлектронногоДокумента.ПодтверждениеИмяФайлаДанных) - 4); //без расширения и точки
		СвойстваЭлементаЭД.ИдФайл		= ИмяФайлаВыгрузки;
		СвойстваЭлементаЭД.ИдФайлЭП 	= СведенияЭлектронногоДокумента.ПодтверждениеИмяФайлаПодписи;
		
		ДокФорм_ОпределитьТипФайл(СведенияЭлектронногоДокумента.ПодтверждениеИмяФайлаДанных, СвойстваЭлементаЭД);
		
		Если ЗначениеЗаполнено(СведенияЭлектронногоДокумента.ПодтверждениеКНД) Тогда
			СвойстваЭлементаЭД.КНД_Док = СведенияЭлектронногоДокумента.ПодтверждениеКНД;
			МассивЭлементовЭД.Добавить(СвойстваЭлементаЭД);
		Иначе
			ТекстСообщения = НСтр("ru = 'Отсутствует КНД электронного документа-подтверждения для ';
									|en = 'Отсутствует КНД электронного документа-подтверждения для '") + СведенияЭлектронногоДокумента.ПредставлениеДокумента;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;

	ИначеЕсли Виды.Найти(СведенияЭлектронногоДокумента.ВидДокумента) <> Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Отсутствует электронный документ-подтверждение у ';
								|en = 'Отсутствует электронный документ-подтверждение у '") + СведенияЭлектронногоДокумента.ПредставлениеДокумента;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьУзелДокФорм_ДокПредстНО(УзелДокумент, КНД_Док, ИдФайлОсн, КолФайл, Знач ИдФайл, Знач ИдФайлЭП)
	
	УзелДокНапрНО 	= ДобавитьУзелXML(УзелДокумент, "ДокПредстНО");
	
	ДобавитьУзелXML(УзелДокНапрНО, "КолФайл", Истина, КолФайл);
	
	Если ИдФайлОсн 	= "ЖУРНАЛ" Тогда
		ДобавитьУзелXML(УзелДокНапрНО, "Журнал", Ложь, ИдФайлОсн);
	Иначе
		ДобавитьУзелXML(УзелДокНапрНО, "ИдФайлОсн", Ложь, ИдФайлОсн);
	КонецЕсли;
	
	УзелДокФорм	= ДобавитьУзелXML(УзелДокНапрНО, "ДокФорм");
	
	ДобавитьУзелXML(УзелДокФорм, "ТипФайл", Истина, 1);
	
	ИдФайл = Сред(ИдФайл, 1, СтрДлина(ИдФайл) - 4); //без расширения и точки
	ДобавитьУзелXML(УзелДокФорм, "ИдФайл", Истина, ИдФайл);
	ДобавитьУзелXML(УзелДокФорм, "ИдФайлЭП", Ложь, ИдФайлЭП);
	ДобавитьУзелXML(УзелДокФорм, "КНД_Док", Ложь, КНД_Док);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДокФорм_ОпределитьТипФайл(ИмяФайлаДанных, СвойстваЭлементаЭД)

	Расширение = РасширениеФайла(ИмяФайлаДанных);
	Если ВРег(Расширение) = "XML" Тогда
		СвойстваЭлементаЭД.Вставить("ТипФайл", 1);
	Иначе
		// 2 - PDF (стандарт PDF/A-3)
		СвойстваЭлементаЭД.Вставить("ТипФайл", 2);
	КонецЕсли;
				
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьФайлВыгрузкиНеДокФорм(УзелДокНапрНО, ДанныеФайловВыгрузки)
	
	// Пишем ДокСкан
	Для каждого Строка Из ДанныеФайловВыгрузки.ТаблицаНеДокФорм Цикл
		
		Результат = ДобавитьВыгрузкуДокСкан(УзелДокНапрНО, Строка);
		
		Если Не Результат Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;
	
	// Пишем ДокPDF
	Для каждого Строка Из ДанныеФайловВыгрузки.ТаблицаНеДокФорм Цикл
		
		Результат = ДобавитьВыгрузкуДокPDF(УзелДокНапрНО, Строка);
		
		Если Не Результат Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Пишем ДокТабл
	Для Каждого Строка Из ДанныеФайловВыгрузки.ТаблицаНеДокФорм Цикл
		
		Результат = ДобавитьВыгрузкуДокТабл(УзелДокНапрНО, Строка);
		
		Если Не Результат Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВыгрузкуДокСкан(УзелДокНапрНО, Строка)
	
	Результат = ПодготовитьМассивФайловНеДокФорм(УзелДокНапрНО, Строка, Ложь);
	Если НЕ Результат.Выполнено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Результат.МассивФайлов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Узел = ДобавитьУзелXML(УзелДокНапрНО, "ДокСкан");
	ДобавитьВыгрузкуНеДокФорм(Узел, Строка, Ложь);
	
	Для каждого ДанныеФайла Из Результат.МассивФайлов Цикл
		ДобавитьУзелXML(Узел, "ИмяФайл", Ложь, ДанныеФайла.ИмяФайла);
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьМассивФайловНеДокФорм(УзелДокНапрНО, Строка, ЭтоДобавлениеДокPDF = Ложь, ЭтоДобавлениеДокТабл = Ложь)
	
	Если Строка.МассивФайлов.Количество() = 0 Тогда
	
		ТекстСообщения = СтрШаблон(НСтр("ru = 'У сканированного документа %1 отсутствуют прикрепленные файлы!';
										|en = 'У сканированного документа %1 отсутствуют прикрепленные файлы!'"),
			Строка.Документ);
			
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат ДокументооборотСКОКлиентСервер.НеВыполнено();
	
	КонецЕсли;
	
	ДокPDF = Перечисления.ВидыPDF.ДокPDF;
	
	МассивФайлов = Новый Массив;
	
	Для Каждого Файл Из Строка.МассивФайлов Цикл
		
		ЭтоДокPDF  = Файл.ВидPDF = ДокPDF;
		ЭтоДокТабл = ВРег(Файл.Расширение) = "ODS";
		
		// Тип "ДокСкан" для файлов в форматах "JPG, TIF, PNG" или для файлов в формате "PNG" с видом "Скан-копия в формате PDF" (ДокСкан)
		// Тип "ДокPDF" для файлов в формате "PNG" с видом "Неотсканированные PDF-файлы" (ДокPDF)
		// Тип "ДокТабл" для файлов в формате "ODS"
		Если ЭтоДобавлениеДокPDF Тогда
			
			Если ЭтоДокPDF Тогда
				МассивФайлов.Добавить(Файл);
			КонецЕсли;
			
		ИначеЕсли ЭтоДобавлениеДокТабл Тогда
			
			Если ЭтоДокТабл Тогда
				МассивФайлов.Добавить(Файл);
			КонецЕсли;
					
		ИначеЕсли Не ЭтоДокPDF
			И Не ЭтоДокТабл Тогда
			
			МассивФайлов.Добавить(Файл);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Результат = ДокументооборотСКОКлиентСервер.Выполнено();
	Результат.Вставить("МассивФайлов", МассивФайлов);
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВыгрузкуДокPDF(УзелДокНапрНО, Строка)
	
	Результат = ПодготовитьМассивФайловНеДокФорм(УзелДокНапрНО, Строка, Истина);
	Если НЕ Результат.Выполнено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Результат.МассивФайлов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для каждого ДанныеФайла Из Результат.МассивФайлов Цикл
		
		ТипЭП = ?(ДанныеФайла.ЕстьВстроеннаяПодпись, "2", "1");
		
		Узел = ДобавитьУзелXML(УзелДокНапрНО, "ДокPDF");
		ДобавитьВыгрузкуНеДокФорм(Узел, Строка, Истина, ТипЭП);
		ДобавитьУзелXML(Узел, "ИмяФайл", Ложь, ДанныеФайла.ИмяФайла);
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВыгрузкуНеДокФорм(Узел, Строка, ЭтоДобавлениеДокPDF, ТипЭП = "1")
	
	ЗапрашиваемыеРеквизиты = "Наименование, ВидДокумента, НомерОснования, ДатаОснования, СведенияДокумента, СведенияДокументаОснования";
	
	Если ЗначениеЗаполнено(Строка.Документ) Тогда
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Документ, ЗапрашиваемыеРеквизиты);
	Иначе
		РеквизитыДокумента = Новый Структура(ЗапрашиваемыеРеквизиты);
		РеквизитыДокумента.Наименование = НСтр("ru = 'Пояснение';
												|en = 'Пояснение'");
	КонецЕсли;
			
	ДобавитьУзелXML(Узел, "КодДок", Истина, Строка.КодДок);
			
	Если НЕ Строка.ЭтоПакетСДопДокументами Тогда
		ДобавитьУзелXML(Узел, "ПорНомДок", Истина, Строка.ПорНом);
	КонецЕсли;
			
	НаимДок = "";
	Если ЗначениеЗаполнено(РеквизитыДокумента.СведенияДокумента) Тогда
		НаимДок = РеквизитыДокумента.СведенияДокумента;
	Иначе
		// Для обратной совместимости при добавлении сканов по старому формату 
		НаимДок = РеквизитыДокумента.Наименование;
	КонецЕсли;
	
	ДобавитьУзелXML(Узел, "НаимДок", Истина, НаимДок);
	
	Если ЭтоДобавлениеДокPDF Тогда
		ДобавитьУзелXML(Узел, "ТипЭП", Истина, ТипЭП);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Строка.ИдФайлЭП) Тогда
		ДобавитьУзелXML(Узел, "ИдФайлЭП", Истина, Строка.ИдФайлЭП);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.СведенияДокументаОснования) Тогда
		СвДокОсн = РеквизитыДокумента.СведенияДокументаОснования;
		ДобавитьУзелXML(Узел, "СвДокОсн", Ложь, СвДокОсн);
	ИначеЕсли ЗначениеЗаполнено(РеквизитыДокумента.НомерОснования) Тогда
		// Для обратной совместимости при добавлении сканов по старому формату
		СвДокОсн = РеквизитыДокумента.НомерОснования + " от " + Формат(РеквизитыДокумента.ДатаОснования, "ДФ=dd.MM.yyyy");
		ДобавитьУзелXML(Узел, "СвДокОсн", Ложь, СвДокОсн);
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьВыгрузкуДокТабл(УзелДокНапрНО, Строка)
	
	Результат = ПодготовитьМассивФайловНеДокФорм(УзелДокНапрНО, Строка, Ложь, Истина);
	
	Если Не Результат.Выполнено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ДанныеФайла Из Результат.МассивФайлов Цикл
		
		Узел = ДобавитьУзелXML(УзелДокНапрНО, "ДокТабл");
		
		ДобавитьВыгрузкуНеДокФорм(Узел, Строка, Ложь);
		
		ДобавитьУзелXML(Узел, "ИмяФайл", Ложь, ДанныеФайла.ИмяФайла);
		
	КонецЦикла;
	
	Возврат Истина;
			
КонецФункции

#КонецОбласти

#Область ОтправкаМакетовПенсионныхДел

&НаСервереБезКонтекста
Функция СформироватьПакетМакетаПенсионногоДелаИЗаявления(КонтекстОтправки)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПакетМакетаПенсионногоДелаИЗаявления(КонтекстОтправки);
	
КонецФункции

&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДелаИЗаявления(Документ, Организация, ОповещениеОЗавершении) Экспорт
	
	Если НЕ ОбъектЗаполненКорректно(Документ) Тогда
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ОповещениеОЗавершении) Тогда
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Контекст = Новый Структура();
	Контекст.Вставить("Документ",              Документ);
	Контекст.Вставить("Организация",           Организация);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаМакетаПенсионногоДела_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		Контекст);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(Документ, ОписаниеОповещения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДела_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Документ = ВходящийКонтекст.Документ;
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаМакетаПенсионногоДелаПослеАвтонастройкиУчетнойЗаписи",
		ЭтотОбъект,
		ВходящийКонтекст);
		
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("Документ", 	Документ);
	КонтекстДлительнойОперации.Вставить("Оповещение", 	Оповещение);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Документ;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка макета в ПФР 
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтправкаМакетаПенсионногоДела",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправкаМакетаПенсионногоДела() Экспорт
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется настройка учетной записи..."); // ПФР
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	Документ 	= КонтекстДлительнойОперации.Документ;
	Оповещение 	= КонтекстДлительнойОперации.Оповещение;
	
	ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(Документ, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДела_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Документ;
	Параметры_Организация 			= ВходящийКонтекст.Организация;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ОповещениеОЗавершении;
	
	ОтправкаМакетаПенсионногоДелаИЗаявления(Параметры_Док, Параметры_Организация, Параметры_ВыполняемоеОповещение);

КонецПроцедуры	
	
&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДелаПослеАвтонастройкиУчетнойЗаписи(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОтправкаМакетаПенсионногоДела_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПроверитьСертификатИЛицензию(ОписаниеОповещения, ВходящийКонтекст.Документ, ВходящийКонтекст.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДела_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	// инициализируем контекст отправки
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("Документ", ВходящийКонтекст.Документ);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	// отражаем изменения в базе
	Если НЕ ОтправкаМакетаПенсионногоДела_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		Если КонтекстОтправки.Свойство("ОтсутствуетУчетнаяЗапись") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОтправкаМакетаПенсионногоДела_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ВходящийКонтекст);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ВходящийКонтекст.Документ, ОписаниеОповещения);
			
		ИначеЕсли КонтекстОтправки.Свойство("НаправлениеНеПодключено") Тогда
			
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ВходящийКонтекст.Документ, ВходящийКонтекст.ОповещениеОЗавершении, ВходящийКонтекст.Документ);//+
			
		Иначе
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
			ДополнительныеПараметры.Вставить("РезультатОтправки", 		ВходящийКонтекст.Документ);
			
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Макеты пенсионных дел.
		КонецЕсли;

		Возврат;
		
	ИначеЕсли НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ВходящийКонтекст.Документ) Тогда
			
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ВходящийКонтекст.Документ, ВходящийКонтекст.ОповещениеОЗавершении, ВходящийКонтекст.Документ);//+
		Возврат;

	КонецЕсли;

	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаМакетаПенсионногоДелаПослеФормированияПакета", ЭтотОбъект, Контекст);
		
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется формирование пакета для отправки..."); // ПФР
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ПФР");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВложенияЗаявленияОНазначенииПенсии(Документ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявлениеОНазначенииПенсииЭлектронныеДокументы.Ссылка КАК Ссылка,
	|	ЗаявлениеОНазначенииПенсииЭлектронныеДокументы.Документ КАК Документ,
	|	ЗаявлениеОНазначенииПенсииЭлектронныеДокументы.Файл КАК Файл
	|ИЗ
	|	Справочник.ЗаявлениеОНазначенииПенсии.ЭлектронныеДокументы КАК ЗаявлениеОНазначенииПенсииЭлектронныеДокументы
	|ГДЕ
	|	ЗаявлениеОНазначенииПенсииЭлектронныеДокументы.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Размер", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Тип");
	Таблица.Колонки.Добавить("Данные");
	
	Пока Выборка.Следующий() Цикл
		
		ДополнительныеПараметры = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.Файл, ДополнительныеПараметры);
		НоваяСтрока = Таблица.Добавить();
		ИмяФайла    = СтрШаблон("%1.%2", ДанныеФайла.Наименование, ДанныеФайла.Расширение);
		НоваяСтрока.ИмяФайла = СтрЗаменить(НРег(ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(ИмяФайла)), " ", "_");
		НоваяСтрока.Размер = ДанныеФайла.Размер;
		НоваяСтрока.Данные = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВложенияМакетаПенсионногоДела(Документ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МакетыПенсионныхДелЭлектронныеДокументы.Документ,
	|	МакетыПенсионныхДелЭлектронныеДокументы.Страница1,
	|	МакетыПенсионныхДелЭлектронныеДокументы.Страница2,
	|	МакетыПенсионныхДелЭлектронныеДокументы.Размер,
	|	МакетыПенсионныхДелЭлектронныеДокументы.Файл,
	|	МакетыПенсионныхДелЭлектронныеДокументы.Файл.Расширение КАК ФайлРасширение
	|ИЗ
	|	Справочник.МакетыПенсионныхДел.ЭлектронныеДокументы КАК МакетыПенсионныхДелЭлектронныеДокументы
	|ГДЕ
	|	МакетыПенсионныхДелЭлектронныеДокументы.Ссылка = &Ссылка";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Размер", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Тип");
	Таблица.Колонки.Добавить("Данные");
	
	Пока Выборка.Следующий() Цикл
		ДополнительныеПараметры = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.Файл, ДополнительныеПараметры);
		
		НоваяСтрока = Таблица.Добавить();
		Если ЗначениеЗаполнено(Выборка.Страница1) И ЗначениеЗаполнено(Выборка.Страница2) Тогда
			ИмяФайла = СтрШаблон("%1_страница_%3-%4.%2", Выборка.Документ, ДанныеФайла.Расширение, Выборка.Страница1, Выборка.Страница2);
		ИначеЕсли ЗначениеЗаполнено(Выборка.Страница1) ИЛИ ЗначениеЗаполнено(Выборка.Страница2) Тогда
			Страница = ?(ЗначениеЗаполнено(Выборка.Страница1), Выборка.Страница1, Выборка.Страница2);
			ИмяФайла = СтрШаблон("%1_страница_%3.%2", Выборка.Документ, ДанныеФайла.Расширение, Страница);
		Иначе
			ИмяФайла = СтрШаблон("%1.%2", Выборка.Документ, ДанныеФайла.Расширение);
		КонецЕсли;
		
		НоваяСтрока.ИмяФайла = СтрЗаменить(НРег(ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(ИмяФайла)), " ", "_");
		НоваяСтрока.Размер = ДанныеФайла.Размер;
		НоваяСтрока.Данные = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаМакетаПенсионногоДела_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	Документ = Контекст.Документ;
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки';
								|en = 'Не выбран документ для отправки'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Организация");
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана организация-отправитель.';
								|en = 'Не выбрана организация-отправитель.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ПФР
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);
		Возврат Ложь;
		
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСПФР") <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, указан ли получатель
	ПолучательДокумента = Документ.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательДокумента) Тогда
		ТекстСообщения = НСтр("ru = 'Не задан получатель письма.';
								|en = 'Не задан получатель письма.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
		
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		Приложения = ПолучитьВложенияЗаявленияОНазначенииПенсии(Документ);
	Иначе
		Приложения = ПолучитьВложенияМакетаПенсионногоДела(Документ);
	КонецЕсли;
	
	// получаем содержание письма
	ТекстСодержания = Документ.Содержание;
	
	// проверяем, не пустое ли письмо
	Если НЕ ЗначениеЗаполнено(ТекстСодержания) И Приложения.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'В письме не задано содержание и отсутствуют вложения.';
								|en = 'В письме не задано содержание и отсутствуют вложения.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем файл с содержимым
	ИмяФайлаСодержимого = ВыгрузитьТекстВФайл(ТекстСодержания);
	КороткоеИмяФайлаСодержимого = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР;
	ЦиклОбмена.Предмет = Документ;
	ЦиклОбмена.Идентификатор = Документ.Идентификатор;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = Документ.Получатель;
	ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = Документ.Получатель;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
		
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// добавляем письмо
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Письмо, ИмяФайлаСодержимого, КороткоеИмяФайлаСодержимого, , , , , , , СгенерироватьUUID(), Перечисления.ТипыСодержимогоФайлов.Текст1251) Тогда
		ТекстСообщения = НСтр("ru = 'Отправка письма прервана.';
								|en = 'Отправка письма прервана.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	// добавляем приложения к письму
	Для Каждого СтрПриложение Из Приложения Цикл
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоПриложение, СтрПриложение.Данные, СтрПриложение.ИмяФайла, СтрПриложение.Размер, , , , , , СгенерироватьUUID(), ТипСодержимогоПоИмениФайла(СтрПриложение.ИмяФайла, Истина)) Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// записываем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	// изменяем статус отправки
	ЗаписатьСтатусОтправкиОбъекта(Документ, Перечисления.СтатусыОтправки.ВКонверте);
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ТипТранспортногоСообщения", ТранспортноеСообщение.Тип);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаМакетаПенсионногоДелаПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Макеты пенсионных дел.

		Возврат;
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // Макеты пенсионных дел.
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		КонтекстОтправки.Документ);
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // Макеты пенсионных дел.
	
КонецПроцедуры
	 	
