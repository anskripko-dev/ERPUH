			ИндексСертификата = УзлыCert_RPN.Количество() - НомерСертификатаСКонца;
			Если (ДатаСеанса < СертификатыРПН[ИндексСертификата].ДействителенС
				ИЛИ ДатаСеанса > СертификатыРПН[ИндексСертификата].ДействителенПо)
				И СертификатыРПН.Количество() > 1 Тогда
				СертификатыРПН.Удалить(ИндексСертификата);
			КонецЕсли;
		КонецЦикла;
		
		Если СертификатыРПН.Количество() > 0 Тогда
			Результат.Вставить("СертификатРПН", СертификатыРПН[0]);
		КонецЕсли;
		
	КонецЕсли;
	
	// заполняем сведения о настройках ФТС
	УзелFTS = НайтиПодчиненныйУзел(УзелAbsos, "FTS");
	Результат.Вставить("ФТСИспользуется", ЗначениеЗаполнено(УзелFTS));
	
	// заполняем родительские сертификаты
	УзелCert_CA = НайтиПодчиненныйУзел(УзелRegistration, "Cert_CA");
	Если УзелCert_CA <> Неопределено Тогда
		
		// узлы с корневыми сертификатами ГНИВЦ
		СертификатыКорневыеГНИВЦ = Новый Массив;
		УзлыCert_ROOT_GNIVC = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_ROOT_GNIVC");
		Для Каждого УзелCert_ROOT_GNIVC Из УзлыCert_ROOT_GNIVC Цикл
			НовыйСертификатКорневойГНИВЦ = СвойстваСертификатаПоУзлу(УзелCert_ROOT_GNIVC);
			СертификатыКорневыеГНИВЦ.Добавить(НовыйСертификатКорневойГНИВЦ);
		КонецЦикла;
		Результат.Вставить("СертификатыКорневыеГНИВЦ", СертификатыКорневыеГНИВЦ);
		
		// узлы с корневыми сертификатами СОС
		СертификатыКорневыеТакском = Новый Массив;
		УзлыCert_ROOT_SOS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_ROOT_SOS");
		Для Каждого УзелCert_ROOT_SOS Из УзлыCert_ROOT_SOS Цикл
			НовыйСертификатКорневойТакском = СвойстваСертификатаПоУзлу(УзелCert_ROOT_SOS);
			СертификатыКорневыеТакском.Добавить(НовыйСертификатКорневойТакском);
		КонецЦикла;
		Результат.Вставить("СертификатыКорневыеТакском", СертификатыКорневыеТакском);
		
		// узлы с сертификатами СОС
		УзлыCert_SOS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_SOS");
		Для Каждого УзелCert_SOS Из УзлыCert_SOS Цикл
			Результат.Вставить("СертификатСОС", СвойстваСертификатаПоУзлу(УзелCert_SOS));
		КонецЦикла;
		
		// узлы с кросс-сертификатами
		СертификатыКРОСС = Новый Массив;
		УзлыCert_CROSS = НайтиПодчиненныеУзлы(УзелCert_CA, "Cert_CROSS");
		Для Каждого УзелCert_CROSS Из УзлыCert_CROSS Цикл
			НовыйСертификатКРОСС = СвойстваСертификатаПоУзлу(УзелCert_CROSS);
			СертификатыКРОСС.Добавить(НовыйСертификатКРОСС);
		КонецЦикла;
		Результат.Вставить("СертификатыКРОСС", СертификатыКРОСС);
		
	КонецЕсли;
	
	
	// заполняем сертификаты ПФР (их может не быть, если обмен с ПФР не задействован по учетной записи)
	УзелCertPFR = НайтиПодчиненныйУзел(УзелRegistration, "Cert_PFR");
	Если УзелCertPFR <> Неопределено Тогда
		
		// заполняем таблицу корневых сертификатов ПФР
		КорневыеСертификатыПФР = Новый Массив;
		УзелRoot = НайтиПодчиненныйУзел(УзелCertPFR, "Root");
		Если УзелRoot <> Неопределено Тогда
			УзлыCertificate_PFR = НайтиПодчиненныеУзлы(УзелRoot, "Certificate_PFR");
			Для Каждого УзелCertificate_PFR Из УзлыCertificate_PFR Цикл
				КорневыеСертификатыПФР.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_PFR));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКорневыеПФР", КорневыеСертификатыПФР);
		
		// заполняем таблицу кросс-сертификатов ПФР
		КроссСертификатыПФР = Новый Массив;
		УзелCROSS = НайтиПодчиненныйУзел(УзелCertPFR, "CROSS");
		Если УзелCROSS <> Неопределено Тогда
			УзлыCertificate_PFR = НайтиПодчиненныеУзлы(УзелCROSS, "Certificate_PFR");
			Для Каждого УзелCertificate_PFR Из УзлыCertificate_PFR Цикл
				КроссСертификатыПФР.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_PFR));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКРОССПФР", КроссСертификатыПФР);
		
	КонецЕсли;
	
	// заполняем сертификаты ФСГС (их может не быть, если обмен с ФСГС не задействован по учетной записи)
	УзелCertFSGS = НайтиПодчиненныйУзел(УзелRegistration, "Cert_FSGS");
	Если УзелCertFSGS <> Неопределено Тогда
		
		// заполняем таблицу корневых сертификатов ФСГС
		КорневыеСертификатыФСГС = Новый Массив;
		УзелRoot = НайтиПодчиненныйУзел(УзелCertFSGS, "Root");
		Если УзелRoot <> Неопределено Тогда
			УзлыCertificate_FSGS = НайтиПодчиненныеУзлы(УзелRoot, "Certificate_FSGS");
			Для Каждого УзелCertificate_FSGS Из УзлыCertificate_FSGS Цикл
				КорневыеСертификатыФСГС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_FSGS));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКорневыеФСГС", КорневыеСертификатыФСГС);
		
		// заполняем таблицу кросс-сертификатов ФСГС
		КроссСертификатыФСГС = Новый Массив;
		УзелCROSS = НайтиПодчиненныйУзел(УзелCertFSGS, "CROSS");
		Если УзелCROSS <> Неопределено Тогда
			УзлыCertificate_FSGS = НайтиПодчиненныеУзлы(УзелCROSS, "Certificate_FSGS");
			Для Каждого УзелCertificate_FSGS Из УзлыCertificate_FSGS Цикл
				КроссСертификатыФСГС.Добавить(СвойстваСертификатаПоУзлу(УзелCertificate_FSGS));
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить("СертификатыКРОССФСГС", КроссСертификатыФСГС);
		
	КонецЕсли;
	
	// инициализируем признаки обмена с ФНС, ПФР и Росстат
	Результат.Вставить("ПредназначенаДляДокументооборотаСФНС", УзлыIFNS.Количество() > 0);
	Результат.Вставить("ПредназначенаДляДокументооборотаСПФР", ЗначениеЗаполнено(УзелPFR) ИЛИ ЗначениеЗаполнено(УзелPFREDOK) ИЛИ ЗначениеЗаполнено(УзелPFRETSP));
	Результат.Вставить("ПредназначенаДляДокументооборотаСФСГС", ЗначениеЗаполнено(УзелFSGS));
	
	// возвращаем результат
	Возврат Результат;
	
КонецФункции

