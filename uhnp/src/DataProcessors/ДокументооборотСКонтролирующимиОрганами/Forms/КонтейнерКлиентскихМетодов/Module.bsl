Функция ТребованияСФР(Организация) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокументСЭДОФСС.Ссылка КАК Требование
		|ИЗ
		|	Документ.ВходящийДокументСЭДОФСС КАК ВходящийДокументСЭДОФСС
		|ГДЕ
		|	ВходящийДокументСЭДОФСС.Организация = &Организация
		|	И (ВходящийДокументСЭДОФСС.ТипСообщения = ""303""
		|			ИЛИ ВходящийДокументСЭДОФСС.ТипСообщения = ""308"")";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокументСЭДОФСС.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВходящийДокументСЭДОФСС КАК ВходящийДокументСЭДОФСС
		|ГДЕ
		|	(ВходящийДокументСЭДОФСС.ТипСообщения = ""303""
		|			ИЛИ ВходящийДокументСЭДОФСС.ТипСообщения = ""308"")";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Требования = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Требование");
	
	Возврат Требования;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьФормуВыбораТребованияСФР(
		ОписаниеОповещения, 
		Организация = Неопределено, 
		Знач ВидДокумента = Неопределено,
		Требования = Неопределено) Экспорт
	
	ВидыДокумента = Новый Массив;
	Если ВидДокумента = Неопределено Тогда
		ВидыДокумента.Добавить("303");
		ВидыДокумента.Добавить("308");
	Иначе
		ВидыДокумента.Добавить(ВидДокумента);
	Конецесли;	
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидыДокумента", 	ВидыДокумента);
	ДополнительныеПараметры.Вставить("Организация", 	Организация);
	ДополнительныеПараметры.Вставить("Требования", 		Требования);
	
	ОткрытьФорму("Документ.ВходящийДокументСЭДОФСС.Форма.ФормаВыбораТребования", 
		ДополнительныеПараметры,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьОтветНаТребованиеСФРСВыборомТребования(
		СписокВходящихДокументов = Неопределено, // Если указано, то список требований берется из описи
		Организация 			= Неопределено, // Если указана, то в список фильтруется по ней
		ВходящийКонтекст 		= Неопределено) Экспорт
	
	// Если требование одно, то форму выбора не показываем
	Если СписокВходящихДокументов = Неопределено Тогда
		Требования = Неопределено;
	Иначе
		Требования = ТребованияСФР(Организация);
		Если Требования.Количество() = 1 Тогда
			СоздатьОтветНаТребованиеСФР(Требования[0], ВходящийКонтекст);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СоздатьОтветНаТребованиеСФР",
		ЭтотОбъект,
		ВходящийКонтекст);
	
	ПоказатьФормуВыбораТребованияСФР(ОписаниеОповещения, Организация, , Требования);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьОтветНаТребованиеСФР(Требование, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	ВидТребования = Неопределено;
	Если Требование <> Неопределено Тогда
		
		СоздатьОтветНаТребованиеДокументовСФР(Требование);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ВыполняемоеОповещение")
		И ДополнительныеПараметры.ВыполняемоеОповещение <> Неопределено Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, ВидТребования);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОтветНаТребованиеДокументовСФР(Требование)
	
	СформированныйОтвет = СфомироватьОтветНаСервере(Требование);
	
	Если СформированныйОтвет =
			ПредопределенноеЗначение("Документ.ОтветСтрахователяНаТребованиеПроверкиФСС.ПустаяСсылка")
			ИЛИ СформированныйОтвет = Неопределено Тогда
			
			Возврат;
	КонецЕсли;
		
	ПараметрыФормы = Новый Структура("Ключ", СформированныйОтвет);
	ОткрытьФорму(
		"Документ.ОтветСтрахователяНаТребованиеПроверкиФСС.Форма.ФормаДокумента",
		ПараметрыФормы);
		
	Оповестить("Создан ответ страхователя СФР");
	
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция СфомироватьОтветНаСервере(Требование)
	
	Результат = Неопределено;
	
	Попытка
		Ответ = Документы.ОтветСтрахователяНаТребованиеПроверкиФСС.СоздатьДокумент();
		
		Ответ.Дата 		= ТекущаяДатаСеанса();
		Ответ.Основание	= Требование;
		
		Ответ.УстановитьВремя();
		Ответ.УстановитьНовыйНомер();
		
		Ответ.Заполнить(Требование);
		
		Ответ.Записать();
		
		Результат = Ответ.Ссылка;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Невозможно сформировать ответ.';
													|en = 'Невозможно сформировать ответ.'"));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверитьДлинуРегистрационныйНомерФСС(Результат, ТипВзаимодействия, Организация)
	
	ЭтоТипВзаимодействияОрганизацияСЭДО = (ТипВзаимодействия =
		ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации		= СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	РезультатПроверкиРегистрационногоНомераФСС = 
		ЭлектронныйДокументооборотСФССКлиентСервер.ПроверитьДлинуРегистрационныйНомерФСС(
			СвойстваОрганизации,
			РегистрационныйНомерФСС,
			Ложь,
			Результат);
			
	Возврат РезультатПроверкиРегистрационногоНомераФСС;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыОтправкиПоОрганизации(ПараметрыОтправкаСообщения, ОрганизацияСсылка)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Если КонтекстЭДОСервер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатыСообщений = ПараметрыОтправкаСообщения.ДатыСообщений;

	ПараметрыОтправкаСообщения.ТипСообщения = "330";
	ПараметрыОтправкаСообщения.Организация = ОрганизацияСсылка;
	ПараметрыОтправкаСообщения.СодержимоеСообщения =
		КонтекстЭДОСервер.СформироватьЗапросИсторическихСообщенийЗаДатуАбонентом(
			ОрганизацияСсылка,
			ДатыСообщений);
	
КонецПроцедуры

#КонецОбласти

#Область СодержимоеСообщений

&НаКлиенте
Функция СодержимоеСообщенияПодтверждениеПрочтенияСообщений(ИдентификаторыСообщений) Экспорт

	Шаблон = "<ns4:confirmMessageReadRequest xmlns:ns4=""http://www.fss.ru/integration/types/sedo/arm/v01""
		|xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""
		|xmlns:ns=""http://www.fss.ru/integration/types/common/v01""
		|xmlns:ns1=""http://www.fss.ru/integration/types/sedo/v01""
		|xmlns:ns2=""http://www.fss.ru/integration/types/organization/v01""
		|xmlns:ns3=""http://www.fss.ru/integration/types/dic/errors/v01"">
		|	<!--(uuid*)-->
		|	<uuids>
		|%1
		|	</uuids>
		|</ns4:confirmMessageReadRequest>";

	Строки = Новый Массив;
	Для каждого Идентификатор Из ИдентификаторыСообщений Цикл
		ШаблонИД = "		<uuid>%1</uuid>";
		ЭлементИД = СтрШаблон(ШаблонИД, Идентификатор);
		Строки.Добавить(ЭлементИД);
	КонецЦикла;
	Идентификаторы = СтрСоединить(Строки, Символы.ПС);
	
	Результат = СтрШаблон(Шаблон, Идентификаторы);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СодержимоеСообщенияОтписыванияСтрахователяОтОповещенийОбИзмененииСтатусаЭЛНВМО(РегистрационныйНомерФСС) Экспорт
	
	Шаблон = 
	"<unsubscribeInsRequest xmlns=""http://www.fss.ru/integration/types/eln/event/v01"">
	|	<event>CHANGE_STATE_MO</event>
	|	<regNum>%1</regNum>
	|</unsubscribeInsRequest>";
	
