&НаКлиенте
Процедура СоздатьЗаявлениеВПФРИзМеню(Организация, Основание = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("Основание", Основание);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СоздатьЗаявлениеВПФРИзМеню_ПослеВыбораВида", 
		ЭтотОбъект);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПомощникСозданияЗаявленияПФР", ДополнительныеПараметры,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявлениеВПФРИзМеню_ПослеВыбораВида(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Заявление = СоздатьЗаявлениеВПФР(
		Результат.Вид, 
		Результат.Организация, 
		, 
		Результат.Основание);
		
	ПоказатьЗначение(,Заявление);
			
КонецПроцедуры

&НаСервере
Функция СоздатьЗаявлениеВПФР(
		Вид, 
		Организация, 
		СостояниеЭДОсПФР = Неопределено, 
		Основание = Неопределено) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СоздатьЗаявлениеВПФР(
		Вид, 
		Организация, 
		СостояниеЭДОсПФР, 
		Основание);
	
КонецФункции

&НаКлиенте
Процедура НайтиЗаявлениеПФРВФорме1СОтчетность(Ссылка, Организация) Экспорт
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Раздел", ПредопределенноеЗначение("Перечисление.СтраницыЖурналаОтчетность.Уведомления"));
	
	ОткрытьФорму("ОбщаяФорма.РегламентированнаяОтчетность", ПараметрыОткрытия);
	
	Оповестить("Открытие формы 1С-Отчетность", ПараметрыОткрытия);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПараметрыОповещения = Новый Структура(); 
		ПараметрыОповещения.Вставить("Ссылка", Ссылка);
		ПараметрыОповещения.Вставить("Организация", Организация);
		Оповестить("Позиционирование", ПараметрыОповещения, Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСертификатОтправляемыйВПФР(Форма, СтандартнаяОбработка) Экспорт
		
	СтандартнаяОбработка = Ложь;
	
	ДвДанныеСертификата = Форма.СостояниеЭДОсПФР.НаСертификат.ДвДанныеСертификата;
	Адрес = ПоместитьВоВременноеХранилище(ДвДанныеСертификата);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Адрес", Адрес);

	КриптографияЭДКОКлиент.ПоказатьСертификат(ДополнительныеПараметры, Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеВПФР_СсылкаНаЗаявлениеОбработкаНавигационнойСсылки(
		Элемент, 
		НавигационнаяСсылкаФорматированнойСтроки, 
