&НаКлиенте
Процедура ОткрытьФормуНастройкиЭДОсФНСиПФРиРосстатомиЦБ(
		Организация,
		ФормаВладелец = Неопределено,
		Окно = Неопределено,
		ОткрытьСвойстваУчетойЗаписиЕслиИспользуется = Ложь,
		ТипКонтролирующегоОргана = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Организация) Тогда 
		
		ПолучаемыеРеквизитыОрганизации = Новый Структура();
		ПолучаемыеРеквизитыОрганизации.Вставить("ВидОбменаСКонтролирующимиОрганами");
		ПолучаемыеРеквизитыОрганизации.Вставить("УчетнаяЗаписьОбмена");
		
		РеквизитыОрганизации = ЗначенияРеквизитовОбъекта(Организация, ПолучаемыеРеквизитыОрганизации);
		
		Если ОткрытьСвойстваУчетойЗаписиЕслиИспользуется И РеквизитыОрганизации.ВидОбменаСКонтролирующимиОрганами =
			ПредопределенноеЗначение("Перечисление.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате")
			И ЗначениеЗаполнено(РеквизитыОрганизации.УчетнаяЗаписьОбмена) Тогда
			
			ПоказатьЗначение(, РеквизитыОрганизации.УчетнаяЗаписьОбмена);
			
		Иначе
			ЗначенияЗаполнения	= Новый Структура(
				"Организация, ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена",
				Организация, РеквизитыОрганизации.ВидОбменаСКонтролирующимиОрганами, РеквизитыОрганизации.УчетнаяЗаписьОбмена);
			
			// Форма элемента
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", 		ЗначенияЗаполнения);
			ПараметрыОткрытия.Вставить("ТипКонтролирующегоОргана", 	ТипКонтролирующегоОргана);
			ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаНастройкиДокументооборотаОрганизации", ПараметрыОткрытия, ФормаВладелец);
		КонецЕсли;
		
	Иначе
		
		// Форма списка
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("ВидНастроек", Неопределено);
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ФормаНастроекДокументооборотаОрганизаций", ПараметрыОткрытия,,Новый УникальныйИдентификатор,Окно);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьСписокПредставленнойОтчетности_ДобавитьНижнююТаблицу(ОбластьПодпись, СтрокаПеречНБО)
	
	ОбластьПодпись.Параметры.ВсегоДок = СтрокаПеречНБО.ОбобщДок.ВсегоДок;
	
	Всего_1    = 0;
	Всего_1_ЭК = 0;
	Всего_1_1  = 0;
	Всего_1_2  = 0;
	Всего_2    = 0;
	Всего_2_1  = 0;
	Всего_2_2  = 0;
	
	ВидПредДок = СписокИзXDTO(СтрокаПеречНБО.ОбобщДок, "ВидПредДок");
	Если ВидПредДок <> Неопределено Тогда
		Для каждого СтрВидПредДок Из ВидПредДок Цикл
			Код = СтрВидПредДок.КодПредДок;
			
			Если Код = "03" ИЛИ Код = "08" Тогда
				Всего_1_ЭК = Всего_1_ЭК + Число(СтрВидПредДок.КолПредДок);
			КонецЕсли;
			
			Если Код = "02" ИЛИ Код = "03" ИЛИ Код = "09" Тогда
				Всего_1_1 = Всего_1_1 + Число(СтрВидПредДок.КолПредДок);
			КонецЕсли;
			
			Если Код = "01" ИЛИ Код = "08" ИЛИ Код = "10" Тогда
				Всего_1_2 = Всего_1_2 + Число(СтрВидПредДок.КолПредДок);
			КонецЕсли;
			
			Если Код = "04" Тогда
				Всего_2_1 = Всего_2_1 + Число(СтрВидПредДок.КолПредДок);
			КонецЕсли;
			
			Если Код = "06" ИЛИ Код = "07" Тогда
				Всего_2_2 = Всего_2_2 + Число(СтрВидПредДок.КолПредДок);
			КонецЕсли;
			
		КонецЦикла;
		
		Всего_1 = Всего_1_1 + Всего_1_2;
		Всего_2 = Всего_2_1 + Всего_2_2;
		
	КонецЕсли;
	
	ОбластьПодпись.Параметры.Всего_1    = Всего_1;
	ОбластьПодпись.Параметры.Всего_1_ЭК = Всего_1_ЭК;
	ОбластьПодпись.Параметры.Всего_1_1  = Всего_1_1;
	ОбластьПодпись.Параметры.Всего_1_2  = Всего_1_2;
	ОбластьПодпись.Параметры.Всего_2    = Всего_2;
	ОбластьПодпись.Параметры.Всего_2_1  = Всего_2_1;
	ОбластьПодпись.Параметры.Всего_2_2  = Всего_2_2;
	
КонецФункции

