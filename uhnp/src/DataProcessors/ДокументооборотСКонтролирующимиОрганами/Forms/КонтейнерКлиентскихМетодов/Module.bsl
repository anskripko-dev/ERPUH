&НаСервере
Функция СформироватьТабличныйДокументИзвещенияОПолучении(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	СвойстваИзУведомления = ПолучитьОсновныеСвойстваИзИзвещенияОПолучении(Тело);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Если ЗначениеЗаполнено(СвойстваИзУведомления) Тогда
		
		КНД = КНДФайла(Тело);
		Если КНД = "1166008" Тогда
			Бланк = ПолучитьМакетОбработки("ИзвещениеОПолучении_КНД_1166008");
		Иначе
			Бланк = ПолучитьМакетОбработки("ИзвещениеОПолучении_КНД_1167004");
		КонецЕсли;
		
		ТабДокумент.АвтоМасштаб = Истина;
		ОсновнаяЧастьБланка = Бланк.ПолучитьОбласть("ИзвещениеОПолучении");
		ЗаполнитьЗначенияСвойств(ОсновнаяЧастьБланка.Параметры, СвойстваИзУведомления);
		ТабДокумент.Вывести(ОсновнаяЧастьБланка);
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Бланк, ТаблицаПодписей);
		
	Иначе
		// если разобрать не удалось - выводим его в виде текста
		ТабДокумент = СформироватьТабличныйДокументНаОсновеБланка(Заголовок, ИмяФайла, Тело, НижнийКолонтитул);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзИзвещенияОПолучении(СтрУведомление)
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// считываем подтверждение из файла в дерево XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(, СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка чтения XML извещения о вводе:%1';
																						|en = 'Ошибка чтения XML извещения о вводе:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Файл"".';
				|en = 'Некорректная структура XML извещения: не обнаружен узел ""Файл"".'"));
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""Документ"".';
				|en = 'Некорректная структура XML извещения: не обнаружен узел ""Документ"".'"));
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвИзвещП = УзелДокумент.Строки.Найти("СвИзвещП", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвИзвещП) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Некорректная структура XML извещения: не обнаружен узел ""СвИзвещП"".';
				|en = 'Некорректная структура XML извещения: не обнаружен узел ""СвИзвещП"".'"));
		Возврат Неопределено;
	КонецЕсли;
	
	// получаем сведения о дате и времени поступившего файла
	ДатаПол = УзелСвИзвещП.Строки.Найти("ДатаПол", "Имя").Значение;
	ВремяПол = УзелСвИзвещП.Строки.Найти("ВремяПол", "Имя").Значение;
	
	Файлы = Новый Массив;
	// получаем сведения о полученных файлах
	УзлыСведПолФайл = УзелСвИзвещП.Строки.НайтиСтроки(Новый Структура("Имя", "СведПолФайл"));
	Для Каждого УзелСведПолФайл Из УзлыСведПолФайл Цикл
		УзелИмяПостФайла = УзелСведПолФайл.Строки.Найти("ИмяПостФайла", "Имя");
		Если ЗначениеЗаполнено(УзелИмяПостФайла) Тогда
			Файлы.Добавить(СокрЛП(УзелИмяПостФайла.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Результат     = СубьектИПочтаИзИзвещенияОПолучении(УзелДокумент, "ПодтвДок");
	ПодтвПол      = Результат.Субьект;
	ПодтвПолПочта = Результат.Почта;
	
	Результат     = СубьектИПочтаИзИзвещенияОПолучении(УзелДокумент, "ОтпрДок");
	ОтпрДок       = Результат.Субьект;
	ОтпрДокПочта  = Результат.Почта;
	
	Результат     = СубьектИПочтаИзИзвещенияОПолучении(УзелДокумент, "ПолДок");
	ПолДок        = Результат.Субьект;
	ПолДокПочта   = Результат.Почта;
	
	ИмяПринятФайлов = СтрСоединить(Файлы, Символы.ПС);
	
	Возврат Новый Структура("ПодтвПол, ПодтвПолПочта, ИмяПринятФайлов, ОтпрДок, ОтпрДокПочта, ПолДок, ДатаПол, ВремяПол, ПолДокПочта", 
		ПодтвПол, ПодтвПолПочта, ИмяПринятФайлов, ОтпрДок, ОтпрДокПочта, ПолДок, ДатаПол, ВремяПол, ПолДокПочта);
	
КонецФункции
	
&НаСервереБезКонтекста
Функция СубьектИПочтаИзИзвещенияОПолучении(УзелДокумент, ИмяУзла)
	
	ПодтвПол = ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, ИмяУзла);
	
	УзелПодтвДок = УзелДокумент.Строки.НайтиСтроки(Новый Структура("Имя", ИмяУзла));
	Если ЗначениеЗаполнено(УзелПодтвДок) Тогда
		
		Для Каждого Узел ИЗ УзелПодтвДок Цикл
			УзелПодтвДокПочта = Узел.Строки.НайтиСтроки(Новый Структура("Имя", "E-mail"));
			Если ЗначениеЗаполнено(УзелПодтвДокПочта) Тогда
				ПодтвПолПочта = УзелПодтвДокПочта[0].Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Субьект", ПодтвПол);
	ДополнительныеПараметры.Вставить("Почта",   ПодтвПолПочта);
	
	Возврат ДополнительныеПараметры;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеНалоговогоОрганаИзXML(УзелСведенияНО)
	
	ПредставлениеНО = "";
		
	УзелКодНО = ПолучитьУзел(УзелСведенияНО, "КодНО");
	Если НЕ ЗначениеЗаполнено(УзелКодНО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелНаимНО = ПолучитьУзел(УзелСведенияНО, "НаимНО");
	
	Если ЗначениеЗаполнено(УзелНаимНО) Тогда
		ПредставлениеНО = НСтр("ru = 'ИФНС %1 (%2)';
								|en = 'ИФНС %1 (%2)'");
		ПредставлениеНО = СтрШаблон(ПредставлениеНО, УзелКодНО.Значение, УзелНаимНО.Значение);
	Иначе
		ПредставлениеНО = НСтр("ru = 'ИФНС %1';
								|en = 'ИФНС %1'");
		ПредставлениеНО = СтрШаблон(ПредставлениеНО, УзелКодНО.Значение);
	КонецЕсли;
	
	Возврат ПредставлениеНО;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеОператораСвязиИзXML(Узел)
	
	ПредставлениеОператора = "";
		
	УзелНаимОрг = ПолучитьУзел(Узел, "НаимОрг");
	Если НЕ ЗначениеЗаполнено(УзелНаимОрг) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелИденСОС = ПолучитьУзел(Узел, "ИденСОС");
	Если НЕ ЗначениеЗаполнено(УзелИденСОС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПредставлениеОператора = НСтр("ru = '%1 (%2)';
									|en = '%1 (%2)'");
	ПредставлениеОператора = СтрШаблон(ПредставлениеОператора, УзелНаимОрг.Значение, УзелИденСОС.Значение);
	
	Возврат ПредставлениеОператора;
	
КонецФункции

&НаКлиенте
Функция ОснованиеПакетаВыбраноКорректно(Основание) Экспорт

	ТекстОшибки = ТекстОшибкиПроверкиВыбранногоОснованияПакета(Основание);
	Если ТекстОшибки = "" Тогда
		Возврат Истина;
	Иначе
		ПоказатьПредупреждение(,ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиПроверкиВыбранногоОснованияПакета(Основание)

	ТекстОшибки = "";
	
	ПредставлениеВИменительномПадеже = ДокументооборотСКОКлиентСервер.ПредставлениеПакетаСДопДокументами();
	ПредставлениеВРодительномПадеже  = ДокументооборотСКОКлиентСервер.ПредставлениеПакетаСДопДокументамиВРодительномПадеже(Истина);
	ПредставлениеОснованияВРодительномПадеже = ДлительнаяОтправкаКлиентСервер.НазваниеОбъектаВРодительномПадеже(Основание);
	
	Если ДокументооборотСКОВызовСервера.ЭтоПакетСДопДокументами(Основание) Тогда
		
		ТекстОшибки = НСтр("ru = '%1 не может быть выбран основанием у %2';
							|en = '%1 не может быть выбран основанием у %2'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеВИменительномПадеже, ПредставлениеВРодительномПадеже);
		
	Иначе
		
		Сведения = СведенияПоОтправляемымОбъектам(Основание);
		
		Если Сведения.ВидКонтролирующегоОргана <> ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФНС") Тогда
			
			ТекстОшибки = НСтр("ru = 'Отправка %1 возможна только для ФНС';
								|en = 'Отправка %1 возможна только для ФНС'");
			ТекстОшибки = СтрШаблон(ТекстОшибки);
				
		КонецЕсли;
		
		ОтправляетсяВКонтролирующийОрган = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбъектОтправляетсяВКонтролирующиеОрганы(Основание);
		
		ТекущееСостояние       = ТекущееСостояниеОтправки(Основание, Сведения.ВидКонтролирующегоОргана);
		ДокументооборотНеНачат = ТекущееСостояние = Неопределено 
			ИЛИ ТекущееСостояние.ТекущийЭтапОтправки.СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ДокументооборотНеНачат");
			
		Если ТекущееСостояние = Неопределено ИЛИ НЕ ОтправляетсяВКонтролирующийОрган ИЛИ ДокументооборотНеНачат Тогда
			
			ТекстОшибки  = НСтр("ru = 'Отправка %1 возможна только для отправленного %2';
								|en = 'Отправка %1 возможна только для отправленного %2'");
			ТекстОшибки  = СтрШаблон(ТекстОшибки, ПредставлениеВРодительномПадеже, ПредставлениеОснованияВРодительномПадеже);
				
		КонецЕсли;
		
		Если ТекущееСостояние <> Неопределено И ТекстОшибки = "" Тогда
			
			ТекстСтатуса = ТекущееСостояние.ТекущийЭтапОтправки.ТекстСтатуса;
			
			Доставлено        = НСтр("ru = 'Доставлено';
									|en = 'Доставлено'");
			ПринятоВОбработку = НСтр("ru = 'Принято в обработку';
									|en = 'Принято в обработку'");
			Готово            = НСтр("ru = 'Готово';
									|en = 'Готово'");
			Принято           = НСтр("ru = 'Принято';
									|en = 'Принято'");
			Сдано             = НСтр("ru = 'Сдано';
									|en = 'Сдано'");
			ТребуетУточнения  = ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения();
			ОтправленоВСПАРК  = НСтр("ru = 'Сдано в ФНС, копия передана в СПАРК';
									|en = 'Сдано в ФНС, копия передана в СПАРК'");
			
			ЭтоВходящие	 = Сведения.СтраницаЖурнала = Перечисления.СтраницыЖурналаОтчетность.Входящие;
			ЭтоПисьмо    = ТипЗнч(Основание) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами");
			ЭтоЗапросИОН = ТипЗнч(Основание) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика");
			ЭтоИсхОпись  = ТипЗнч(Основание) = Тип("СправочникСсылка.ОписиИсходящихДокументовВНалоговыеОрганы");
			ЭтоПояснение = ТипЗнч(Основание) = Тип("ДокументСсылка.ПоясненияКДекларацииПоНДС");
				
			Если ЭтоПисьмо И Основание.Статус <> Перечисления.СтатусыПисем.Полученное И ТекстОшибки = "" Тогда
				
				Если ТекстСтатуса <> Доставлено Тогда
				
					ТекстОшибки = НСтр("ru = 'Отправка %1 возможна только для писем со статусом ""%2""';
										|en = 'Отправка %1 возможна только для писем со статусом ""%2""'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеВРодительномПадеже, Доставлено);
					
				КонецЕсли;
				
			КонецЕсли;
					
			Если ЭтоЗапросИОН И ТекстОшибки = "" Тогда
				
				Если ТекстСтатуса <> ПринятоВОбработку И ТекстСтатуса <> Готово Тогда
				
					ТекстОшибки = НСтр("ru = 'Отправка %1 возможна только для запросов на сверку со статусами ""%2"" или ""%3""';
										|en = 'Отправка %1 возможна только для запросов на сверку со статусами ""%2"" или ""%3""'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеВРодительномПадеже, ПринятоВОбработку, Готово);
					
				КонецЕсли;
				
			КонецЕсли;
				
			Если (ЭтоИсхОпись ИЛИ ЭтоПояснение) И ТекстОшибки = "" Тогда
				
				Если ТекстСтатуса <> Принято Тогда
				
					ТекстОшибки = НСтр("ru = 'Отправка %1 возможна только для ответов на требование со статусом ""%2""';
										|en = 'Отправка %1 возможна только для ответов на требование со статусом ""%2""'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеВРодительномПадеже, Принято);
					
				КонецЕсли;
				
			КонецЕсли;
					
			Если НЕ ЭтоВходящие И НЕ ЭтоПисьмо И НЕ ЭтоЗапросИОН И НЕ ЭтоИсхОпись И НЕ ЭтоПояснение И ТекстОшибки = "" Тогда
				
				Если ТекстСтатуса <> ПринятоВОбработку
					И ТекстСтатуса <> Сдано
					И ТекстСтатуса <> ТребуетУточнения
					И ТекстСтатуса <> ОтправленоВСПАРК Тогда
				
					ТекстОшибки = НСтр("ru = 'Отправка %1 возможна только для отчетов со статусами ""%2"", ""%3"", ""%4""';
										|en = 'Отправка %1 возможна только для отчетов со статусами ""%2"", ""%3"", ""%4""'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, ПредставлениеВРодительномПадеже, ПринятоВОбработку, Сдано, ТребуетУточнения);
					
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ТекстОшибки;
	
КонецФункции

#Область ОбработкаКартинок

// Отображение универсальной формы требования к сканам
//
// Параметры:
//  СтруктураТребований	 - Структура - см. ОперацииСФайламиЭДКОКлиент.ТребованияКСканам 
//
&НаКлиенте
Процедура ПоказатьТребованияКИзображениямУниверсальная(СтруктураТребований) Экспорт
	
	Требования = Новый Структура;
	Требования.Вставить("Формат", ДопустимыеФорматы(СтруктураТребований));
	
	// Цветность
	Если СтруктураТребований.ПреобразоватьВОттенкиСерого Тогда
		Цветность = НСтр("ru = 'Оттенки серого';
						|en = 'Оттенки серого'");
	Иначе	
		Цветность = НСтр("ru = 'Цветное изображение';
						|en = 'Цветное изображение'");
	КонецЕсли;
	
	Если СтруктураТребований.ГлубинаЦвета <> Неопределено Тогда
		Бит = СтрЗаменить(СтруктураТребований.ГлубинаЦвета, "БитНаПиксел", "");
		Если Бит = "1" ИЛИ Бит = "8" Тогда
			Бит = Бит + НСтр("ru = ' бит';
							|en = ' бит'");
		Иначе
			Бит = Бит + НСтр("ru = ' бита';
							|en = ' бита'");
		КонецЕсли;
		
		Цветность = Цветность + ", глубина цвета " +  Бит;
		
	КонецЕсли;
	
	Требования.Вставить("Цветность", Цветность);
	
	// Разрешение
	Разрешение = "";
	
	Если СтруктураТребований.МинимальнаяПлотность <> 0 И СтруктураТребований.МаксимальнаяПлотность = 0 Тогда
		Разрешение = Строка(СтруктураТребований.МинимальнаяПлотность) + " dpi";
	ИначеЕсли СтруктураТребований.МинимальнаяПлотность = 0 И СтруктураТребований.МаксимальнаяПлотность <> 0 Тогда
		Разрешение = Строка(СтруктураТребований.МаксимальнаяПлотность) + " dpi";
	ИначеЕсли СтруктураТребований.МинимальнаяПлотность <> 0 И СтруктураТребований.МаксимальнаяПлотность <> 0 Тогда
		Разрешение = Строка(СтруктураТребований.МинимальнаяПлотность) + "-" + Строка(СтруктураТребований.МаксимальнаяПлотность) + " dpi";
	КонецЕсли;
	
	Если Разрешение <> "" Тогда
		Требования.Вставить("Разрешение", Разрешение);
	КонецЕсли;
	
	Если СтруктураТребований.МаксимальныйРазмерФайла <> 0 Тогда
		Размер = ОбщегоНазначенияЭДКОКлиентСервер.ТекстовоеПредставлениеРазмераФайла(СтруктураТребований.МаксимальныйРазмерФайла);
		Требования.Вставить("Размер", Размер);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Требования",     Требования);
	ДополнительныеПараметры.Вставить("Пояснение",      СтруктураТребований.Пояснение);
	ДополнительныеПараметры.Вставить("КлючТребований", "Требования к файлам");
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ТребованияКИзображениямУниверсальная", ДополнительныеПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция ДопустимыеФорматы(СтруктураТребований)
	
	Расширения = ОперацииСФайламиЭДКО.ПолучитьДопустимыеРасширенияФайлов(СтруктураТребований);
	Расширения = СтрСоединить(Расширения,", ");
	Возврат Расширения;
	
КонецФункции

#КонецОбласти

#Область ОбменСМинобороныРФ

&НаКлиенте
Функция РезультатЗагрузкиОтветаМОРФВСлучаеОшибки()
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("РезультатЗагрузки", Неопределено);
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВыгруженныеФайлыМинобороны(ОтчетСсылка) Экспорт
	
	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтправкиМинобороны.ИмяФайлаПакета КАК ИмяФайлаПакета
	               |ИЗ
	               |	Справочник.ОтправкиМинобороны КАК ОтправкиМинобороны
	               |ГДЕ
	               |	ОтправкиМинобороны.ОтчетСсылка = &ОтчетСсылка
	               |	И ОтправкиМинобороны.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОтправкиМинобороны.ДатаОтправки УБЫВ";
	
	Запрос.УстановитьПараметр("ОтчетСсылка", ОтчетСсылка);
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой).ВыгрузитьКолонку("ИмяФайлаПакета");
	
	Возврат Результат;

	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьОтветыИзМинобороны(
	ОрганизацияСсылка,
	ВыполняемоеОповещение,
	ОтчетСсылка=Неопределено,
	Форма=Неопределено,
	ОтправкаСсылка=Неопределено) Экспорт
	
	ЗагрузкаНесколькихФайлов = ОтчетСсылка = Неопределено;
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	
	Если Форма = Неопределено Тогда
		Форма = МодульДокументооборотСМинобороныКлиент.ПолучитьФормуОтчетаПоСсылке(ОтчетСсылка);
	КонецЕсли;
	
	Если ОрганизацияСсылка = Неопределено Тогда
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;

	Если ЗагрузкаНесколькихФайлов Тогда
		Отправка = Неопределено;
	Иначе
		Если ОтправкаСсылка = Неопределено Тогда
			Отправка = МодульДокументооборотСМинобороныКлиент.ПолучитьПоследнююОтправкуОтчета(ОтчетСсылка);
		Иначе
			Отправка = ОтправкаСсылка;
		КонецЕсли; 
	КонецЕсли; 
	
	ВыгруженныеФайлы = ПолучитьВыгруженныеФайлыМинобороны(ОтчетСсылка);
	
	Если ВыгруженныеФайлы.Количество() = 0 Тогда
		// отправок не было
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ДлительнаяОтправкаКлиентСервер.ВывестиПредупреждение(НСтр("ru = 'Данные в Минобороны не отправлялись.';
																	|en = 'Данные в Минобороны не отправлялись.'", "ru") );
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли; 
	
	Сведения = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(ОрганизацияСсылка, , "ИННЮЛ");
	ИНН = СокрЛП(Сведения.ИННЮЛ);
	
	Префикс = "";
	Суффикс = "_r";
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",               ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка",                   ОрганизацияСсылка);
	ДополнительныеПараметры.Вставить("ИНН",                                 ИНН);
	ДополнительныеПараметры.Вставить("ВыгруженныеФайлы",                    ВыгруженныеФайлы);
	ДополнительныеПараметры.Вставить("Префикс",                             Префикс);
	ДополнительныеПараметры.Вставить("Суффикс",                             Суффикс);
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ЗагрузкаНесколькихФайлов",            ЗагрузкаНесколькихФайлов);
	ДополнительныеПараметры.Вставить("Отправка",                            Отправка);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтветНаПоследнююВыгрузку",         Ложь);
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеУстановкиРасширения",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	// установка расширения работы с файлами и расширения для работы с криптографией
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Истина, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеУстановкиРасширения(Подключено, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение     = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Подключено Тогда
		// расширение не подключено
		ТекстОшибки = НСтр("ru = 'Расширение для работы с файлами не подключено.';
							|en = 'Расширение для работы с файлами не подключено.'");
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
				|en = 'Обмен с Минобороны. Загрузка ответа.'") , 
			"Ошибка", 
			ТекстОшибки ,, 
			Истина);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	РезультатЗагрузки = МодульДокументооборотСМинобороныВызовСервера.ЗагрузитьСертификатыМинобороны();
	
	Если ПустаяСтрока(РезультатЗагрузки.ОписаниеОшибки) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьОтветИзМинобороныПослеУстановкиСертификатов", ЭтотОбъект, ДополнительныеПараметры);
		
		МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
		МодульДокументооборотСМинобороныКлиент.УстановитьСертификатыГоловныхПромежуточныхЦентров(Оповещение, РезультатЗагрузки.Сертификаты);
	Иначе
		ЗагрузитьОтветИзМинобороныПослеУстановкиСертификатов(Ложь, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеУстановкиСертификатов(Результат, ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеПодключенияРасширенияДляРаботыСФайлами",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение     =    ДополнительныеПараметры.ВыполняемоеОповещение;
	ИНН                       =                      ДополнительныеПараметры.ИНН;
	Префикс                   =                  ДополнительныеПараметры.Префикс;
	Суффикс                   =                  ДополнительныеПараметры.Суффикс;
	ЗагрузкаНесколькихФайлов  = ДополнительныеПараметры.ЗагрузкаНесколькихФайлов;

	
	Если ВыбранныеФайлы = Неопределено Тогда 
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Если ЗагрузкаНесколькихФайлов Тогда
		КаталогЗагрузки = ВыбранныеФайлы[0];
		Расширение			= ".zip";
		МаскаПоиска			= Префикс + ИНН + "*" + Суффикс + Расширение;
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗагрузитьОтветИзМинобороныПослеПоискаФайлов",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		НачатьПоискФайлов(ОписаниеОповещения, КаталогЗагрузки, МаскаПоиска, Ложь);
	Иначе
		Файл = Новый Файл(ВыбранныеФайлы[0]);
		МассивНайденныхФайлов = Новый Массив;
		МассивНайденныхФайлов.Добавить(Файл);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗагрузитьОтветИзМинобороныПослеПоискаФайлов",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, МассивНайденныхФайлов);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеПоискаФайлов(МассивНайденныхФайлов, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение     = ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыгруженныеФайлы          = ДополнительныеПараметры.ВыгруженныеФайлы;
	Префикс                   = ДополнительныеПараметры.Префикс;
	Суффикс                   = ДополнительныеПараметры.Суффикс;
	ЗагрузкаНесколькихФайлов  = ДополнительныеПараметры.ЗагрузкаНесколькихФайлов;
	
	КоличествоНайденныхФайлов = МассивНайденныхФайлов.Количество();
	Если КоличествоНайденныхФайлов = 0 Тогда
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// проверяем содержат ли названия файлов имя исходного пакета
	Ответы = Новый Массив;
	Для каждого НайденныйФайл Из МассивНайденныхФайлов Цикл
		ИмяПакета = СтрЗаменить(СтрЗаменить(НайденныйФайл.Имя, Префикс, ""), Суффикс, "");
		НайденнаяСтрока = ВыгруженныеФайлы.Найти(ИмяПакета);
		Если НайденнаяСтрока <> Неопределено Тогда
			 Ответы.Добавить(НайденныйФайл);
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры.ЭтоОтветНаПоследнююВыгрузку = ИмяПакета = ВыгруженныеФайлы[0];
	
	Если Ответы.Количество() = 0 Тогда
		Если ЗагрузкаНесколькихФайлов Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'В именах выбранных файлов не обнаружено протоколов о сдаче отчетности.';
											|en = 'В именах выбранных файлов не обнаружено протоколов о сдаче отчетности.'"));
		Иначе
			Шаблон = НСтр("ru = 'Выбранный файл %1 не является ответом Минобороны РФ на пакет с текущим отчетом.';
							|en = 'Выбранный файл %1 не является ответом Минобороны РФ на пакет с текущим отчетом.'");
			ТекстПредупреждения = СтрШаблон(Шаблон, НайденныйФайл.Имя);
			ПоказатьПредупреждение(, ТекстПредупреждения);
		КонецЕсли;
		
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
		
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеПомещенияФайлов",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПомещаемыеФайлы = Новый Массив;
	Для каждого Ответ Из Ответы Цикл
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла;
		ОписаниеФайла.Имя = Ответ.ПолноеИмя;
		ПомещаемыеФайлы.Добавить(ОписаниеФайла);
	КонецЦикла;
	НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы, Ложь, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Ответы = Новый Массив;
	Для каждого Файл Из ПомещенныеФайлы Цикл
		Ответ = Новый Структура("ОписаниеФайла, Адрес");
		Ответ.ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Файл.ПолноеИмя);
		Ответ.Адрес = Файл.Хранение;
		Ответы.Добавить(Ответ);
	КонецЦикла; 
	
	ДополнительныеПараметры.Вставить("Ответы", Ответы);
	ДополнительныеПараметры.Вставить("ДанныеОтветов", Новый Массив);
	ДополнительныеПараметры.Вставить("БылиОшибки", Ложь);
	ДополнительныеПараметры.Вставить("ТекстОшибки", "");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныЗагрузитьОтветыЦикл",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныЗагрузитьОтветыЦикл(Результат, ДополнительныеПараметры) Экспорт
	
 	Ответы                       = ДополнительныеПараметры.Ответы;
	Префикс                      = ДополнительныеПараметры.Префикс;
	Суффикс                      = ДополнительныеПараметры.Суффикс;
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗагрузкаНесколькихФайлов     = ДополнительныеПараметры.ЗагрузкаНесколькихФайлов;
	БылиОшибки                   = ДополнительныеПараметры.БылиОшибки;
	Форма                        = ДополнительныеПараметры.Форма;
	ЭтоОтветНаПоследнююВыгрузку  = ДополнительныеПараметры.ЭтоОтветНаПоследнююВыгрузку;
	ВыгруженныеФайлы             = ДополнительныеПараметры.ВыгруженныеФайлы;
	
	Если Ответы.Количество() > 0 Тогда
		ФайлОтвета = Ответы[0].ОписаниеФайла;
		Адрес = Ответы[0].Адрес;
		Ответы.Удалить(0);
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
		
		МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
		РезультатРаспаковки = МодульДокументооборотСМинобороныВызовСервера.ПрочитатьАрхивОтвета(Адрес);
		
		ИсходныеДанные = РезультатРаспаковки.ИсходныеДанные;
		Подпись = РезультатРаспаковки.Подпись;
		
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("ДанныеОтвета", ИсходныеДанные);
		ДанныеОтвета.Вставить("Подпись", Подпись);
		ДанныеОтвета.Вставить("Файл", ФайлОтвета);
		ДанныеОтвета.Вставить("ПодписьВалидна", Ложь);
		ДанныеОтвета.Вставить("СертификатВалиден", Ложь);
		ДанныеОтвета.Вставить("Сертификат", Неопределено);
		ДанныеОтвета.Вставить("Архив", ДанныеФайла);
		ДанныеОтвета.Вставить("АдресАрхива", Адрес);
		ДанныеОтвета.Вставить("Статус", Неопределено);
		ДанныеОтвета.Вставить("ОтправкаСсылка", Неопределено);
		Идентификатор = СтрЗаменить(СтрЗаменить(ФайлОтвета.ИмяБезРасширения, Префикс, ""), Суффикс, "");
		ДанныеОтвета.Вставить("Идентификатор", Идентификатор);

		ДополнительныеПараметры.ДанныеОтветов.Добавить(ДанныеОтвета);
		
		// проверяем есть ли данные и подпись
		Если ИсходныеДанные = Неопределено ИЛИ
			Подпись = Неопределено Тогда
			// ошибка распаковки файла ответа
			ИмяФайла = ФайлОтвета.Имя;
			ТекстОшибки = СтрШаблон("ru = 'Ошибка распаковки файла с ответной квитанцией %1.';
									|en = 'Ошибка распаковки файла с ответной квитанцией %1.'", ИмяФайла);
			ТекстОшибки = НСтр(ТекстОшибки);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			Если ИсходныеДанные = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'В пакете отсутствует файл с протоколом.';
									|en = 'В пакете отсутствует файл с протоколом.'");
			Иначе
				ТекстОшибки = НСтр("ru = 'В пакете отсутствует файл с подписью или подпись не в формате BASE-64.';
									|en = 'В пакете отсутствует файл с подписью или подпись не в формате BASE-64.'");
			КонецЕсли;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			// записи в журнал
			Шаблон = НСтр("ru = 'Ошибка распаковки файла ответа %1.';
							|en = 'Ошибка распаковки файла ответа %1.'");
			ТекстОшибкиРаспаковки = СтрШаблон(Шаблон, ИмяФайла);
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
					|en = 'Обмен с Минобороны. Загрузка ответа.'"),
				"Ошибка",
				ТекстОшибкиРаспаковки , ,
				Истина);
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
					|en = 'Обмен с Минобороны. Загрузка ответа.'") ,
				"Ошибка",
				ТекстОшибки , ,
				Истина);
			// завершаем обработку если нет протокола
			Если ИсходныеДанные = Неопределено Тогда
				ДополнительныеПараметры.БылиОшибки = Истина;
				ОписаниеОповещения = Новый ОписаниеОповещения(
						"ЗагрузитьОтветИзМинобороныЗагрузитьОтветыЦикл",
						ЭтотОбъект,
						ДополнительныеПараметры);
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗагрузкаНесколькихФайлов И Форма <> Неопределено Тогда
			АдресДанныхФайлаОтвета = ПоместитьВоВременноеХранилище(
					ИсходныеДанные,
					Новый УникальныйИдентификатор);
			// помещаем адрес данных ответа в реквизиты формы для отображения протокола
			Форма.СтруктураРеквизитовФормы.Вставить(
				"АдресВоВременномХранилищеОтветноеСообщение",
				АдресДанныхФайлаОтвета);
		КонецЕсли;
		
		Если Подпись <> Неопределено Тогда
			// подпись присутствует, делаем её проверку
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗагрузитьОтветИзМинобороныПослеПроверкиПодписиЦикл",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
			МодульДокументооборотСМинобороныКлиент.ПроверитьПодпись(ОписаниеОповещения, ИсходныеДанные, Подпись);
			Возврат;
		Иначе
			// если отсутствует подпись предлагаем пользователю продолжить загрузку
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаСертификатаЦикл",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			ТекстВопроса = "Подпись отсутствует или ее содержимое некорректно. Продолжить загрузку протокола?";
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	Иначе
		// завершение загрузки
		Если ЗагрузкаНесколькихФайлов Тогда
			Если БылиОшибки Тогда
				ПоказатьПредупреждение(, НСтр("ru = 'Загрузка протоколов о сдаче завершена. При загрузке возникали ошибки.';
												|en = 'Загрузка протоколов о сдаче завершена. При загрузке возникали ошибки.'"));
			КонецЕсли;
		Иначе
			// загрузка одного файла
			Если БылиОшибки Тогда
				ПоказатьПредупреждение(, НСтр("ru = 'При загрузке протокола о сдаче возникли ошибки.';
												|en = 'При загрузке протокола о сдаче возникли ошибки.'"));
			Иначе
				ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[0];
				// если загружаемый файл не является ответом на последний выгруженный отчет
				Если НЕ ЭтоОтветНаПоследнююВыгрузку Тогда
					Файл = Новый Файл(ВыгруженныеФайлы[0]);
					ИдентификаторПоследнейВыгрузки = Файл.ИмяБезРасширения;
					ИмяЗагруженногоФайла = ДанныеОтвета.Файл.Имя;
					ТекстСообщения = СтрШаблон("ru = 'Загружены данные из файла %1.
							|Загруженный протокол не является протоколом сдачи последнего выгруженного отчета,
							|поэтому информация о текущем статусе отчета изменена не будет.
							|
							|Идентификатор последнего выгруженного отчета %2.
							|Ответ на последнюю выгрузку должен находиться в файле с именем %2%3.zip.';
							|en = 'Загружены данные из файла %1.
							|Загруженный протокол не является протоколом сдачи последнего выгруженного отчета,
							|поэтому информация о текущем статусе отчета изменена не будет.
							|
							|Идентификатор последнего выгруженного отчета %2.
							|Ответ на последнюю выгрузку должен находиться в файле с именем %2%3.zip.'",
						ИмяЗагруженногоФайла,
						ИдентификаторПоследнейВыгрузки,
						Суффикс);
					ТекстСообщения = НСтр(ТекстСообщения);
					ПоказатьПредупреждение(,ТекстСообщения);
				Иначе
					// успешная загрузка одного файла
					Если ДанныеОтвета.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтправки.НеПринят") ИЛИ
						ДанныеОтвета.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтправки.ПринятЕстьОшибки") Тогда
						
						Если ДанныеОтвета.Статус = ПредопределенноеЗначение("Перечисление.СтатусыОтправки.НеПринят") Тогда
							ТекстВопроса = НСтр("ru = 'Отчет не принят, протокол содержит описание ошибок. Открыть протокол?';
												|en = 'Отчет не принят, протокол содержит описание ошибок. Открыть протокол?'");
						Иначе
							ТекстВопроса = НСтр("ru = 'Отчет принят, но протокол содержит описание некритичных ошибок. Открыть протокол?';
												|en = 'Отчет принят, но протокол содержит описание некритичных ошибок. Открыть протокол?'");
						КонецЕсли;
						
						СписокКнопок = Новый СписокЗначений;
						СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Показать протокол");
						СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
						Оповещение = Новый ОписаниеОповещения("ЗагрузитьОтветИзМинобороныПослеВопросаПоказатьПротоколЦикл",
							ЭтотОбъект,
							ДополнительныеПараметры);
						ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Да);
					Иначе
						ТекстСообщения = НСтр("ru = 'Протокол успешно загружен, отчет принят. Статус отчета обновлен.';
												|en = 'Протокол успешно загружен, отчет принят. Статус отчета обновлен.'");
						ПоказатьПредупреждение(, ТекстСообщения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// формируем результат
		Результат = Новый Структура;
		Если НЕ ЗагрузкаНесколькихФайлов И БылиОшибки Тогда
			Результат.Вставить("Выполнено", Ложь);
		Иначе 
			Результат.Вставить("Выполнено", Истина);
		КонецЕсли;
		Результат.Вставить("РезультатЗагрузки", ДополнительныеПараметры.ДанныеОтветов);
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеВопросаПоказатьПротоколЦикл(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[0];
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	Если Результат = КодВозвратаДиалога.Да Тогда
		МодульДокументооборотСМинобороныКлиент.ПоказатьПротокол(ДанныеОтвета.ОтправкаСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеПроверкиПодписиЦикл(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[ДополнительныеПараметры.ДанныеОтветов.Количество() - 1];
	
	Если НЕ Результат.Выполнено Тогда
		ИмяФайла = ДанныеОтвета.Файл.Имя;
		Идентификатор = ДанныеОтвета.Идентификатор;
		ТекстОшибки = НСтр("ru = 'Ошибка проверки подписи в файле %1. Описание ошибки: %2.';
							|en = 'Ошибка проверки подписи в файле %1. Описание ошибки: %2.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяФайла, Результат.ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
				|en = 'Обмен с Минобороны. Загрузка ответа.'", "ru") , 
			"Ошибка", 
			НСтр(СтрШаблон("ru='Ошибка проверка подписи ответа для отправки с идентификатором %1' в файле %2", Идентификатор, ИмяФайла), "ru") ,, 
			Истина);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаПодписиЦикл",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ПоказатьВопрос(
			ОписаниеОповещения,
			НСтр("ru = 'При проверке подписи протокола произошла ошибка, продолжить загрузку?';
				|en = 'При проверке подписи протокола произошла ошибка, продолжить загрузку?'"),
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет
			);
		Возврат;
	КонецЕсли; 
	
	Сертификат = Результат.Сертификат;
	ДанныеОтвета.ПодписьВалидна = Истина;
	ДанныеОтвета.Сертификат = Сертификат;
	
	ДополнительныеПараметры.Вставить("Сертификат", Сертификат);
	
	ОписаниеОповещение = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеПроверкиСертификатаЦикл",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныКлиент.ПроверитьСертификат(ОписаниеОповещение, Сертификат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаПодписиЦикл(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[ДополнительныеПараметры.ДанныеОтветов.Количество() - 1];
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ДополнительныеПараметры.БылиОшибки = Истина;
		УдалитьИзВременногоХранилища(ДанныеОтвета.АдресАрхива);
		ОписаниеОповещения = Новый ОписаниеОповещения(
				"ЗагрузитьОтветИзМинобороныЗагрузитьОтветыЦикл",
				ЭтотОбъект,
				ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		Возврат;
	КонецЕсли;
	
	// пропускаем проверку сертификата
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаСертификатаЦикл",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеПроверкиСертификатаЦикл(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[ДополнительныеПараметры.ДанныеОтветов.Количество() - 1];
	
	ОписаниеОповещенияВопрос = Новый ОписаниеОповещения(
		"ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаСертификатаЦикл",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		
		ИмяФайла = ДанныеОтвета.Файл.Имя;
		Идентификатор = ДанныеОтвета.Идентификатор;
		// выводим ошибки
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр(СтрШаблон("ru = 'Ошибка проверки сертификата в файле %1.';
																	|en = 'Ошибка проверки сертификата в файле %1.'", ИмяФайла), "ru") );
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
				|en = 'Обмен с Минобороны. Загрузка ответа.'", "ru") , 
			"Ошибка", 
			НСтр(СтрШаблон("ru='Ошибка проверка сертификата ответа для отправки с идентификатором %1' в файле %2", Идентификатор, ИмяФайла), "ru") ,, 
			Истина);
			
		ПоказатьВопрос(ОписаниеОповещенияВопрос,
			НСтр("ru = 'При проверке сертификата произошла ошибка.
				 |Продолжить загрузку протокола?';
				 |en = 'При проверке сертификата произошла ошибка.
				 |Продолжить загрузку протокола?'", "ru"),
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет);
			
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.Валиден Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр(СтрШаблон("ru = 'Сертификат подписи в файле %1 не валиден.';
																	|en = 'Сертификат подписи в файле %1 не валиден.'", ИмяФайла), "ru") );
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Обмен с Минобороны. Загрузка ответа.';
				|en = 'Обмен с Минобороны. Загрузка ответа.'", "ru") , 
			"Ошибка", 
			НСтр(СтрШаблон("ru='Сертификат подписи ответа не валиден для отправки с идентификатором %1' в файле %2.", Идентификатор, ИмяФайла), "ru") ,, 
			Истина);
			
		ПоказатьВопрос(ОписаниеОповещенияВопрос,
			НСтр("ru = 'Сертификат подписи протокола не валиден.
				|Продолжить загрузку протокола?';
				|en = 'Сертификат подписи протокола не валиден.
				|Продолжить загрузку протокола?'", "ru"),
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет);
			
		Возврат;
	КонецЕсли;
	
	ДанныеОтвета.СертификатВалиден = Истина;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещенияВопрос, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеВопросаПроверкаСертификатаЦикл(Результат, ДополнительныеПараметры) Экспорт
	
	ДанныеОтвета = ДополнительныеПараметры.ДанныеОтветов[ДополнительныеПараметры.ДанныеОтветов.Количество() - 1];
	Форма = ДополнительныеПараметры.Форма;
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗагрузитьОтветИзМинобороныЗагрузитьОтветыЦикл",
			ЭтотОбъект,
			ДополнительныеПараметры);
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ДополнительныеПараметры.БылиОшибки = Истина;
		УдалитьИзВременногоХранилища(ДанныеОтвета.АдресАрхива);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		Возврат;
	КонецЕсли;
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ДанныеОтвета");
	ПараметрыЗагрузки.Вставить("ИмяФайла", ДанныеОтвета.Файл.Имя);
	ПараметрыЗагрузки.Вставить("Идентификатор");
	ПараметрыЗагрузки.Вставить("АдресАрхива");
	ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, ДанныеОтвета);
	
	// сохраняем отправку
	РезультатСохранения = МодульДокументооборотСМинобороныВызовСервера.СохранитьОтвет(ПараметрыЗагрузки);
	
	УдалитьИзВременногоХранилища(ДанныеОтвета.АдресАрхива);
	
	Если НЕ РезультатСохранения.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(РезультатСохранения.ОписаниеОшибки);
		ДополнительныеПараметры.БылиОшибки = Истина;
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		Возврат;
	КонецЕсли;
	
	// получаем состояние протокола
	ОтправкаСсылка = РезультатСохранения.ОтправкаСсылка;
	АдресДереваПротокола = МодульДокументооборотСМинобороныКлиент.ПолучитьАдресДереваПротоколаСдачи(
		ОтправкаСсылка);
	Форма.СтруктураРеквизитовФормы.Вставить("АдресВоВременномХранилищеОтветноеСообщение", АдресДереваПротокола);
	СостояниеПротокола = Неопределено;
	ВыводитьСообщенияОбОшибках = Ложь;
	СообщенияОбОшибкахВыведены = Неопределено;
	Форма.ОбработатьПротоколСдачиОтчета(СостояниеПротокола, ВыводитьСообщенияОбОшибках, СообщенияОбОшибкахВыведены);
	ОшибкаСтатуса = Ложь;
	Если СостояниеПротокола <> Неопределено Тогда
		// преобразуем состояние в статус
		Статус = МодульДокументооборотСМинобороныКлиент.ПолучитьСтатусОтправкиИзСостоянияПротокола(СостояниеПротокола);
		Если Статус = Неопределено Тогда
			// неверный формат протокола
			ТекстОшибки = НСтр("ru = 'Протокол сдачи отчета имеет неверный формат.';
								|en = 'Протокол сдачи отчета имеет неверный формат.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			ДополнительныеПараметры.БылиОшибки = Истина;
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
			Возврат;
		КонецЕсли;
		СтатусСохранен = МодульДокументооборотСМинобороныКлиент.СохранитьСтатусОтправки(ОтправкаСсылка, Статус);
		Если НЕ СтатусСохранен Тогда
			ОшибкаСтатуса = Истина;
		КонецЕсли;
	Иначе
		ОшибкаСтатуса = Истина;
	КонецЕсли;
	
	Если ОшибкаСтатуса Тогда
		ДополнительныеПараметры.БылиОшибки = Истина;
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		Возврат;
	КонецЕсли;
	
	ДанныеОтвета.Статус = Статус;
	ДанныеОтвета.ОтправкаСсылка = ОтправкаСсылка;
	
	// сохраняем статус отчета в журнал
	МодульДокументооборотСМинобороныКлиент.ЗаписьОбъектовРегламентированнойОтчетности(РезультатСохранения.ОтчетСсылка, Ложь);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМинобороны(
	Форма,
	ВыполняемоеОповещение) Экспорт
	
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	
	ОтчетСсылка = МодульДокументооборотСМинобороныКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВМОРФ(
		ОтчетСсылка,
		Форма);
	
	Если РезультатВыгрузки = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось выгрузить данные отчета в файл на диске, возможно нужно проверить выгрузку.';
				|en = 'Не удалось выгрузить данные отчета в файл на диске, возможно нужно проверить выгрузку.'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
		
	АдресФайлаВыгрузки 		= РезультатВыгрузки.АдресФайлаВыгрузки;
	ИмяФайлаВыгрузки   		= РезультатВыгрузки.ИмяФайлаВыгрузки;
	ДатаФормированияОтчета 	= РезультатВыгрузки.ДатаФормированияОтчета;
	ДатаОтчета				= РезультатВыгрузки.ДатаОтчета;
	ТипФайлаВыгрузки 		= РезультатВыгрузки.ТипФайлаВыгрузки;
	ИдентификаторФайла 		= РезультатВыгрузки.ИдентификаторФайла;
	Type 					= РезультатВыгрузки.Type;
	КПП 					= РезультатВыгрузки.КПП;	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ОрганизацияСсылка = МодульДокументооборотСМинобороныКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
	
	РеквизитыУчетнойЗаписи              = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	УчетнаяЗапись                       = РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор                       = РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(ОрганизацияСсылка) Тогда
		Сведения = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(ОрганизацияСсылка, , "ИННЮЛ");
		ИНН = СокрЛП(Сведения.ИННЮЛ);
	Иначе
		Сведения = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(ОрганизацияСсылка, , "ИННФЛ");
		ИНН = СокрЛП(Сведения.ИННФЛ);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение",               ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("Идентификатор",                       Идентификатор);
	ДополнительныеПараметры.Вставить("ОтчетСсылка",                         ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка",                   ОрганизацияСсылка);
	ДополнительныеПараметры.Вставить("ИНН",                                 ИНН);
	ДополнительныеПараметры.Вставить("СертификатыИПараметрыОбмена",         Неопределено);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет",                 ТипЗнчСсылкаНаОтчет);
	ДополнительныеПараметры.Вставить("Форма",                               Форма);
	ДополнительныеПараметры.Вставить("АдресФайлаВыгрузки",                  АдресФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки",                    ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ДатаФормированияОтчета",              ДатаФормированияОтчета);
	ДополнительныеПараметры.Вставить("ДатаОтчета",                          ДатаОтчета);
	ДополнительныеПараметры.Вставить("ТипФайлаВыгрузки",                    ТипФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИдентификаторФайла",                  ИдентификаторФайла);
	ДополнительныеПараметры.Вставить("Type",                                Type);
	ДополнительныеПараметры.Вставить("КПП",                                 КПП);
	ДополнительныеПараметры.Вставить("СтрокаДанныхПодписи",                 "");
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписи",                     "message.sign");
	ДополнительныеПараметры.Вставить("КаталогВыгрузки",                     "");
	ДополнительныеПараметры.Вставить("Пароль",                              "");
	ДополнительныеПараметры.Вставить("СертификатАбонента",                  Неопределено);
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляКриптографии",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	// установка расширения работы с криптографией
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Истина, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляКриптографии(Подключено, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	
	Если НЕ Подключено Тогда
		Результат = Новый Структура("РезультатВыгрузки, СертификатыИПараметрыОбмена", Неопределено, СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеПодключенияРасширенияДляРаботыСФайлами",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПодключенияРасширенияДляРаботыСФайлами(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Подключено Тогда
		Оповещение = Новый ОписаниеОповещения(
			"ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляРаботыСФайламиОбщая",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
	Иначе
		Оповещение = Новый ОписаниеОповещения(
			"ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляРаботыСФайлами",
			ЭтотОбъект,
			ДополнительныеПараметры);
		НачатьУстановкуРасширенияРаботыСФайлами(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляРаботыСФайлами(ДополнительныеПараметры) Экспорт
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляРаботыСФайламиОбщая",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеУстановкиРасширенияДляРаботыСФайламиОбщая(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещенияПродолжения = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСвойствПрограммыДляМенеджераКриптографии",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	// проверяем установленные криптопровайдеры
	МодульДокументооборотСМинобороныСлужебныйКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныСлужебныйКлиент");
	МодульДокументооборотСМинобороныСлужебныйКлиент.ПолучитьСвойстваПрограммыМенеджераКриптографии(ОписаниеОповещенияПродолжения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСвойствПрограммыДляМенеджераКриптографии(РезультатПолученияСвойств, ДополнительныеПараметры) Экспорт
	
	Если РезультатПолученияСвойств.Свойства = Неопределено Тогда
		Шаблон = НСтр("ru = 'Формирование пакета прервано по причине: %1';
						|en = 'Формирование пакета прервано по причине: %1'");
		ОписаниеОшибки = СтрШаблон(Шаблон, РезультатПолученияСвойств.ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ОписаниеОшибки);
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация", ОрганизацияСсылка);
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеВводаПараметровВыгрузки",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ВыгрузкаПакетаДляМинобороны", 
		ПараметрыФормы,
		ДополнительныеПараметры.Форма,
		,
		,
		,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеВводаПараметровВыгрузки(ПараметрыВыгрузки, ДополнительныеПараметры) Экспорт
	
	ОрганизацияСсылка            = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если ПараметрыВыгрузки = Неопределено Тогда
		// нажата кнопка Отмена
		Возврат;
	КонецЕсли;
		
	ДополнительныеПараметры.Вставить("КаталогВыгрузки", ПараметрыВыгрузки.КаталогВыгрузки);
	ДополнительныеПараметры.Вставить("Пароль", ПараметрыВыгрузки.Пароль);
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСертификатовИПараметровОбмена",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	СертификатыИПараметрыОбменаОрганизацииДляМОРФ(
		Оповещение,
		ОрганизацияСсылка,
		Ложь,
		Неопределено,
		);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияСертификатовИПараметровОбмена(СертификатыИПараметрыОбмена, ДополнительныеПараметры) Экспорт

	ВыполняемоеОповещение               = ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресФайлаВыгрузки                  = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ИмяФайлаВыгрузки                    = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	ПарольКонтейнера                    = ДополнительныеПараметры.Пароль;
	
	ДополнительныеПараметры.СертификатыИПараметрыОбмена = СертификатыИПараметрыОбмена;
	
	Если СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с министерством обороны РФ не включено для организации!';
															|en = 'Использование документооборота с министерством обороны РФ не включено для организации!'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	// запрашиваем параметры формирования пакета и параметры обмена при вызове из отправки
	Если НЕ СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.ИспользоватьОбмен Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Использование документооборота с министерством обороны РФ не включено для организации!';
															|en = 'Использование документооборота с министерством обороны РФ не включено для организации!'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
		
	СертификатАбонента = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.СертификатАбонента;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатАбонента, НСтр("ru = 'Сертификат подписи';
														|en = 'Сертификат подписи'"));
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиМОРФ(СертификатыОбмена) Тогда
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(Неопределено);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ИмяФайлаВыгрузки = ИмяФайлаВыгрузки;
	ДополнительныеПараметры.АдресФайлаВыгрузки = АдресФайлаВыгрузки;
	ДополнительныеПараметры.СертификатАбонента = СертификатАбонента;
	
	ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(АдресФайлаВыгрузки);
	
	// Подписываем выгрузку отчета.
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание файла выгрузки ...';
													|en = 'Подписание файла выгрузки ...'"));
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	
	ПараметрыПодписи = Новый Структура;
	ПараметрыПодписи.Вставить("Сертификат", СертификатАбонента);
	ПараметрыПодписи.Вставить("Данные", ДвоичныеДанныеФайлаВыгрузки);
	ПараметрыПодписи.Вставить("Сертификат", СертификатАбонента);
	ПараметрыПодписи.Вставить("ПарольДоступаКЗакрытомуКлючу", Строка(ПарольКонтейнера));
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеПодписания", 
							ЭтотОбъект, 
							ДополнительныеПараметры);
							
	МодульДокументооборотСМинобороныКлиент.ПодписатьCadesBes(
		Оповещение,
		ПараметрыПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПодписания(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	ИмяФайлаВыгрузки             = ДополнительныеПараметры.ИмяФайлаВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	СертификатАбонента           = ДополнительныеПараметры.СертификатАбонента;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	Организация                  = ДополнительныеПараметры.ОрганизацияСсылка;
	ИНН                          = ДополнительныеПараметры.ИНН;
	ДатаОтправки                 = ДополнительныеПараметры.ДатаФормированияОтчета;
	ДатаОтчета                   = ДополнительныеПараметры.ДатаОтчета;
	ТипФайлаВыгрузки             = ДополнительныеПараметры.ТипФайлаВыгрузки;
	ИдентификаторФайла           = ДополнительныеПараметры.ИдентификаторФайла;
	
	Если НЕ Результат.ПодписьВыполнена Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл данных. Описание ошибки: " + Результат.ОписаниеОшибки + "'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	Если Результат.ПодписанныеДанные = Неопределено Тогда // такое может быть в веб-клиенте если пользователь не подтвердил действие расширения криптографии
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Подпись данных не создана.';
															|en = 'Подпись данных не создана.'"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли; 
	
	// создание архива
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Создание архива с данными ...';
													|en = 'Создание архива с данными ...'"));
	
	ПодписьСтрокой = Base64Строка(Результат.ПодписанныеДанные);
	
	ДополнительныеПараметры.Вставить("СтрокаДанныхПодписи", ПодписьСтрокой);
	
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	ПараметрыАрхивации = МодульДокументооборотСМинобороныКлиентСервер.НовыеПараметрыАрхивации();
	ЗаполнитьЗначенияСвойств(ПараметрыАрхивации, ДополнительныеПараметры);
	Если МодульДокументооборотСМинобороныКлиентСервер.ЭтоСертификатФизическогоЛица(СертификатАбонента) Тогда
		ПараметрыАрхивации.Доверенность = СертификатыИПараметрыОбмена.ПараметрыФормированияПакета.Доверенность;
	КонецЕсли;
	
	// создаем архрив пакета на сервере
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	РезультатФормированияАрхива = МодульДокументооборотСМинобороныВызовСервера.СформироватьАрхивПакета(ПараметрыАрхивации);
	
	Если НЕ РезультатФормированияАрхива.Выполнено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось сформировать файл пакета по причине: " + РезультатФормированияАрхива.ОписаниеОшибки + "'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("АдресДанныхПакета", РезультатФормированияАрхива.АдресАрхива);
	ДополнительныеПараметры.Вставить("ДатаОтправки", ДатаОтправки);
	АдресДанныхПакета = РезультатФормированияАрхива.АдресАрхива;
	ДатаСоставления = РезультатФормированияАрхива.ДатаСоставления;
	
	КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
	
	// формируем имя файла пакета
	КоличествоОтправок = МодульДокументооборотСМинобороныВызовСервера.ПолучитьКоличествоОтправокМинобороныНаДату(
		Организация,
		ДатаОтправки);
	ДанныеДляФормированияИмениПакета = Новый Структура;
	ДанныеДляФормированияИмениПакета.Вставить("ИНН", ИНН);
	ДанныеДляФормированияИмениПакета.Вставить("ДатаОтправки", ДатаОтправки);
	ДанныеДляФормированияИмениПакета.Вставить("ДатаСоставления", ДатаСоставления);
	ДанныеДляФормированияИмениПакета.Вставить("ДатаОтчета", ДатаОтчета);
	ДанныеДляФормированияИмениПакета.Вставить("НомерФайла", КоличествоОтправок + 1);
	ДанныеДляФормированияИмениПакета.Вставить("ТипФайлаВыгрузки", ТипФайлаВыгрузки);
	ДанныеДляФормированияИмениПакета.Вставить("ИдентификаторФайла", ИдентификаторФайла);
	ДанныеДляФормированияИмениПакета.Вставить("Type", ДополнительныеПараметры.Type);
	ДанныеДляФормированияИмениПакета.Вставить("КПП", ДополнительныеПараметры.КПП);
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	ИмяФайлаПакета = МодульДокументооборотСМинобороныКлиентСервер.СформироватьИмяФайлаПакета(ДанныеДляФормированияИмениПакета);
		
	ДополнительныеПараметры.Вставить("ИмяФайлаПакета", ИмяФайлаПакета);
	
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла;
	ОписаниеФайла.Имя = ИмяФайлаПакета;
	ОписаниеФайла.Хранение = АдресДанныхПакета;
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(ОписаниеФайла);

	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Получение файла пакета...';
													|en = 'Получение файла пакета...'"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияФайлов",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	НачатьПолучениеФайлов(ОписаниеОповещения, ПолучаемыеФайлы, КаталогВыгрузки, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеПолученияФайлов(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ОтчетСсылка                  = ДополнительныеПараметры.ОтчетСсылка;
	АдресДанныхПакета            = ДополнительныеПараметры.АдресДанныхПакета;
	
	Если ПолученныеФайлы = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Ошибка получения файлов!"));
		Результат = РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	РазделительПутиОС = ПолучитьРазделительПути();
	ПолноеИмяФайлаАрхива = СтрЗаменить(ПолученныеФайлы[0].ПолноеИмя, "/", РазделительПутиОС);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаАрхива", ПолноеИмяФайлаАрхива);
	
	ПараметрыСохранения = Новый Структура("
		|ОтчетСсылка,
		|ИмяФайлаПакета,
		|ОрганизацияСсылка,
		|КаталогВыгрузки,
		|АдресДанныхПакета,
		|ДатаОтправки");
	ЗаполнитьЗначенияСвойств(ПараметрыСохранения, ДополнительныеПараметры);
	
	// сохраняем отправку
	МодульДокументооборотСМинобороныВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныВызовСервера");
	МодульДокументооборотСМинобороныВызовСервера.СохранитьПакет(ПараметрыСохранения);
	
	УдалитьИзВременногоХранилища(АдресДанныхПакета);
	УдалитьИзВременногоХранилища(АдресФайлаВыгрузки);
	
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныКлиент.ЗаписьОбъектовРегламентированнойОтчетности(ОтчетСсылка, Ложь);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеВопросаОткрытьПапкуВыгрузкиЗавершение", 
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещения, "Выгрузка завершена. Открыть каталог с выгруженным пакетом?",РежимДиалогаВопрос.ДаНет, 60);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВМОРФПослеВопросаОткрытьПапкуВыгрузкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ПолноеИмяФайлаАрхива         = ДополнительныеПараметры.ПолноеИмяФайлаАрхива;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВМОРФПослеОткрытияКаталогаЗавершение", 
			ЭтотОбъект,
			ДополнительныеПараметры);

		НачатьЗапускПриложения(ОписаниеОповещения, КаталогВыгрузки);
		Возврат;
	КонецЕсли; 
	
	Результат = Новый Структура("РезультатВыгрузки,
		|СертификатыИПараметрыОбмена, 
		|КаталогВыгрузки",
		ПолноеИмяФайлаАрхива,
		СертификатыИПараметрыОбмена,
		КаталогВыгрузки);
									
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Функция ВыгрузитьПакетДляОтправкиВМОРФПослеОткрытияКаталогаЗавершение(КодВозврата, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение        = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатыИПараметрыОбмена  = ДополнительныеПараметры.СертификатыИПараметрыОбмена;
	КаталогВыгрузки              = ДополнительныеПараметры.КаталогВыгрузки;
	АдресФайлаВыгрузки           = ДополнительныеПараметры.АдресФайлаВыгрузки;
	ПолноеИмяФайлаАрхива         = ДополнительныеПараметры.ПолноеИмяФайлаАрхива;

	
	Результат = Новый Структура("РезультатВыгрузки,
		|СертификатыИПараметрыОбмена, 
		|КаталогВыгрузки",
		ПолноеИмяФайлаАрхива,
		СертификатыИПараметрыОбмена,
		КаталогВыгрузки);
		
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);

КонецФункции

&НаКлиенте
Функция РезультатВыгрузкиПакетаМОРФВСлучаеОшибки(СертификатыИПараметрыОбмена)
	
		Результат = Новый Структура("РезультатВыгрузки, 
									|РезультатПодписи, 
									|СертификатыИПараметрыОбмена", 
							Неопределено,
							Неопределено,
							СертификатыИПараметрыОбмена);	
		Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция ТипФайлаВыгрузкиИсполнениеКонтрактовГОЗ()
	
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	Возврат МодульДокументооборотСМинобороныКлиентСервер.ТипФайлаВыгрузкиИсполнениеКонтрактовГОЗ();
	
КонецФункции

&НаКлиенте
Функция ТипФайлаВыгрузкиКассовыйПланГОЗ()
	
	МодульДокументооборотСМинобороныКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиентСервер");
	Возврат МодульДокументооборотСМинобороныКлиентСервер.ТипФайлаВыгрузкиКассовыйПланГОЗ();
	
КонецФункции

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВМОРФ(
	ОтчетСсылка,
	Форма
	) Экспорт
	
	ДанныеВыгрузки = "";
	РезультатВыгрузки = Форма.УниверсальнаяВыгрузка(ДанныеВыгрузки);
	Если НЕ РезультатВыгрузки Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДанныеВыгрузки = ДанныеВыгрузки[0];
	
	Если ДанныеВыгрузки.ТипФайлаВыгрузки <> ТипФайлаВыгрузкиКассовыйПланГОЗ()
		И ДанныеВыгрузки.ТипФайлаВыгрузки <> ТипФайлаВыгрузкиИсполнениеКонтрактовГОЗ()
		И ДанныеВыгрузки.ТипФайлаВыгрузки <> ТипФайлаВыгрузкиЦенаПродукцииГОЗ() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Результат = Новый Структура();
	Результат.Вставить("АдресФайлаВыгрузки", 		ДанныеВыгрузки.АдресФайлаВыгрузки);
	Результат.Вставить("ИмяФайлаВыгрузки", 			ДанныеВыгрузки.ИмяФайлаВыгрузки);
	Результат.Вставить("ДатаФормированияОтчета", 	ДанныеВыгрузки.ДатаФормированияОтчета);
	Результат.Вставить("ТипФайлаВыгрузки", 			ДанныеВыгрузки.ТипФайлаВыгрузки);
	Результат.Вставить("ДатаОтчета", 				ДанныеВыгрузки.ДатаСоставленияОтчета);
	ИдентификаторФайла = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеВыгрузки, "UID");
	Результат.Вставить("ИдентификаторФайла", 		ИдентификаторФайла);
	Результат.Вставить("ИНН", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеВыгрузки, "ИНН", ""));
	Результат.Вставить("КПП", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеВыгрузки, "КПП", ""));
	Результат.Вставить("Type", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеВыгрузки, "Type", ""));
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляМОРФ(
		ВыполняемоеОповещение,
		ОрганизацияСсылка,
		ПолучитьОсновныеСвойстваПоследнейОтправки,
		ОтправкаСсылка = Неопределено,
		ОтчетСсылка = Неопределено)
	
	РезультатВыполнения = Новый Структура();
	РезультатВыполнения.Вставить("ПараметрыФормированияПакета",        Неопределено);
	РезультатВыполнения.Вставить("Крипт",                              Неопределено);
	РезультатВыполнения.Вставить("НастроенОбменВУниверсальномФормате", Неопределено);
	РезультатВыполнения.Вставить("ПравоИзмененияУчетнойЗаписи",        Неопределено);
	РезультатВыполнения.Вставить("ЭтоРегламентированныйОтчет",         Неопределено);
	
	СвойстваОбмена = СвойстваОбменаОрганизацииСМОРФНаСервере(
		ОрганизацияСсылка,
		ОтчетСсылка);
		
	РезультатВыполнения.ПравоИзмененияУчетнойЗаписи        = СвойстваОбмена.ПравоИзмененияУчетнойЗаписи;
	РезультатВыполнения.ЭтоРегламентированныйОтчет         = СвойстваОбмена.ЭтоРегламентированныйОтчет;

	ПараметрыФормированияПакета = Новый Структура();
	ПараметрыФормированияПакета.Вставить("ИспользоватьОбмен",         Ложь);
	ПараметрыФормированияПакета.Вставить("СертификатАбонента",        Неопределено);
	ПараметрыФормированияПакета.Вставить("Доверенность",              СвойстваОбмена.НастройкиОбмена.Доверенность);
	РезультатВыполнения.ПараметрыФормированияПакета = ПараметрыФормированияПакета;
	
	Если СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		РезультатВыполнения.ПараметрыФормированияПакета.ИспользоватьОбмен = СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен;
	КонецЕсли;
		
	Если НЕ СвойстваОбмена.НастройкиОбмена.ИспользоватьОбмен Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
		Возврат;
	КонецЕсли;
			
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("СвойстваОбмена",       СвойстваОбмена);
	ДополнительныеПараметры.Вставить("РезультатВыполнения",  РезультатВыполнения);
	
	Оповещение = Новый ОписаниеОповещения(
		"СертификатыИПараметрыОбменаОрганизацииДляМОРФПослеПолученияСвойствСертификатаАбонентаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
	МодульДокументооборотСМинобороныКлиент.НайтиСертификатПоОтпечатку(
		Оповещение,
		СвойстваОбмена.НастройкиОбмена.СертификатАбонентаОтпечаток
		);
	
КонецПроцедуры
 
&НаКлиенте
Процедура СертификатыИПараметрыОбменаОрганизацииДляМОРФПослеПолученияСвойствСертификатаАбонентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	РезультатВыполнения = ДополнительныеПараметры.РезультатВыполнения;
	
	РезультатВыполнения.ПараметрыФормированияПакета.СертификатАбонента = ?(Результат.СертификатНайден, Результат.Сертификат, Неопределено);	
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Функция СертификатыГодятсяДляПодписанияОтчетностиМОРФ(Сертификаты)
	
	ТекДата = ТекущаяДатаНаСервере();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		СертификатКриптографии	= Сертификат.Значение;
		ПредставлениеСертификата	= Сертификат.Представление;
		Если СертификатКриптографии = Неопределено Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					 НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в МО РФ.';
							|en = '%1: сертификат не выбран в настройках сдачи отчетности в МО РФ.'"), ПредставлениеСертификата));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < СертификатКриптографии.ДатаНачала Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1: период действия сертификата еще не наступил (%2).';
						|en = '%1: период действия сертификата еще не наступил (%2).'"), 
						ПредставлениеСертификата, Строка(СертификатКриптографии.ДатаНачала)));
		КонецЕсли;
		
		Если ТекДата > СертификатКриптографии.ДатаОкончания Тогда
			ПризнакОшибки = Истина;
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1: период действия сертификата истек (%2).';
						|en = '%1: период действия сертификата истек (%2).'"), 
						ПредставлениеСертификата,
						Строка(СертификатКриптографии.ДатаОкончания)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиЭДОсМинобороны(Организация, ФормаВладелец = Неопределено, Окно = Неопределено) Экспорт 
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.СдачаОтчетностиВМинобороны") Тогда
		
		МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
		МодульДокументооборотСМинобороныКлиент.ОткрытьФормуНастройкиСМинобороны(Организация, ФормаВладелец, Окно);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваОбменаОрганизацииСМОРФНаСервере(Знач ОрганизацияСсылка, 
												ОтчетСсылка = Неопределено) Экспорт
												
	МодульМодульДокументооборотСМинобороны = ОбщегоНазначения.ОбщийМодуль("ДокументооборотСМинобороны");
	Возврат МодульМодульДокументооборотСМинобороны.СвойстваОбменаОрганизации(ОрганизацияСсылка, ОтчетСсылка);
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьОтветИзМинобороныПослеПодключенияРасширенияДляРаботыСФайлами(РезультатПодключения, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение     = ДополнительныеПараметры.ВыполняемоеОповещение;
	ЗагрузкаНесколькихФайлов  = ДополнительныеПараметры.ЗагрузкаНесколькихФайлов;
	Отправка                  = ДополнительныеПараметры.Отправка;
	Суффикс                   = ДополнительныеПараметры.Суффикс;
	Префикс                   = ДополнительныеПараметры.Префикс;
	ВыгруженныеФайлы          = ДополнительныеПараметры.ВыгруженныеФайлы;
	ИНН                       = ДополнительныеПараметры.ИНН;
	Отправка                  = ДополнительныеПараметры.Отправка;

	Если РезультатПодключения Тогда
		Каталог = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("СдачаОтчетностиВМинобороны","ПутьВыгрузки");
		Каталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(Каталог);
		Если ЗагрузкаНесколькихФайлов Тогда
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
			Диалог.Заголовок = НСтр("ru = 'Укажите каталог с протоколами о сдаче отчетности в Минобороны';
									|en = 'Укажите каталог с протоколами о сдаче отчетности в Минобороны'");
		Иначе
			// формируем фильтр на основе суффикса
			МодульДокументооборотСМинобороныКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДокументооборотСМинобороныКлиент");
			Идентификатор = МодульДокументооборотСМинобороныКлиент.ПолучитьРеквизитыПоСсылке(Отправка, "Идентификатор").Идентификатор;
			ИмяБезРасширения = Идентификатор;
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
			Диалог.Заголовок = НСтр("ru = 'Укажите файл с протоколом о сдаче отчета в Минобороны';
									|en = 'Укажите файл с протоколом о сдаче отчета в Минобороны'");
			Диалог.Фильтр = СтрШаблон("Файлы ответов от Минобороны РФ (%1_*%2.zip)|%1_*%2.zip|
										|Zip-архивы (*.zip)|*.zip|
										|Все файлы (*.*)|*.*", ИНН, Суффикс);
			Диалог.ПолноеИмяФайла = СтрШаблон("%1%2.zip", ИмяБезРасширения, Суффикс);
		КонецЕсли;
		Диалог.ПроверятьСуществованиеФайла = Истина;
		Диалог.Каталог = Каталог;
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ЗагрузитьОтветИзМинобороныПослеВыбораКаталога",
			ЭтотОбъект,
			ДополнительныеПараметры); 

		Диалог.Показать(ОписаниеОповещения);
	Иначе
		Результат = РезультатЗагрузкиОтветаМОРФВСлучаеОшибки();
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

