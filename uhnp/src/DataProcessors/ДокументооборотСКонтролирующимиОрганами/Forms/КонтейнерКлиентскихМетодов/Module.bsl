&НаСервереБезКонтекста
Функция СформироватьПодтверждениеПолученияЗапросаПФРДляСообщения(Сообщение)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПодтверждениеПолученияЗапросаПФРДляСообщения(Сообщение);
	
КонецФункции

&НаСервере
Процедура СформироватьТаблицуОтветовНаЗапросИОС(Запрос)
	
	ТаблицаОтветовНаЗапросИОC = ПолучитьОтветыНаЗапросИОС(Запрос, Истина);
	ТаблицаОтветовНаЗапросИОC.Колонки.Добавить("Адрес");
	Для Каждого СтрокаОтвета Из ТаблицаОтветовНаЗапросИОC Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Данные) Тогда 
			ГУИД = Новый УникальныйИдентификатор;
			СтрокаОтвета.Адрес = ПоместитьВоВременноеХранилище(СтрокаОтвета.Данные.Получить(), ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	ОтветыНаЗапросыИОС.Загрузить(ТаблицаОтветовНаЗапросИОC);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьФайлЗапросаИОС(Запрос, ДвоичныеДанныеФайлаЗапроса, ИмяФайлаЗапроса, УникальныйИдентификатор = Неопределено)
	
	// собираем параметры письма
	ПараметрыЗапроса = СформироватьПараметрыОтправкиВПФР(Запрос.Организация);
	Если НЕ ПроверитьЗаполнениеЗапросаИОС(Запрос, ПараметрыЗапроса) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось сформировать запрос на информационное обслуживание!';
															|en = 'Не удалось сформировать запрос на информационное обслуживание!'"));
		Возврат Ложь;
	КонецЕсли;
	
	// инициализируем служебные соответствия
	СоответствиеВидаУслугиКоду = Новый Соответствие;
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОС.СправкаОСостоянииРасчетов, "1");
	СоответствиеВидаУслугиКоду.Вставить(Перечисления.ВидыУслугПриИОС.СверкаФИОиСНИЛС, "2");
	
	ИмяФайлаБезРасширения = "PFR-REQ-ORG-" + СокрЛП(ПараметрыЗапроса.РегНомПФР) + "-" + СгенерироватьUUID();
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	УзелЗапрос = ДобавитьУзелXML(Дерево, "запрос");
	
	Если Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОС.СправкаОСостоянииРасчетов Тогда
		
		ДобавитьУзелXML(УзелЗапрос, "версияФормата", Истина, XMLСтрока("01"));
		
		ДобавитьУзелXML(УзелЗапрос, "кодУПФР", , СокрЛП(ПараметрыЗапроса.КодОрганаПФР));
		ДобавитьУзелXML(УзелЗапрос, "регистрационныйНомерПлательщика", , СокрЛП(ПараметрыЗапроса.РегНомПФР));
		ДобавитьУзелXML(УзелЗапрос, "кодОтвета", , "1");
		ДобавитьУзелXML(УзелЗапрос, "наДату", , Формат(Запрос.НаДату, "ДФ=yyyy-MM-dd"));
		
	ИначеЕсли Запрос.ВидУслуги = Перечисления.ВидыУслугПриИОС.СверкаФИОиСНИЛС Тогда
		
		ДобавитьУзелXML(УзелЗапрос, "кодУПФР", , СокрЛП(ПараметрыЗапроса.КодОрганаПФР));
		ДобавитьУзелXML(УзелЗапрос, "регистрационныйНомерПлательщика", , СокрЛП(ПараметрыЗапроса.РегНомПФР));
		ДобавитьУзелXML(УзелЗапрос, "кодОтвета", , "2");
		
		УзелСписокЗастрахованныхЛиц = ДобавитьУзелXML(УзелЗапрос, "списокЗастрахованныхЛиц");
		
		Для Каждого Стр Из Запрос.ЗастрахованныеЛица Цикл
			
			УзелЗастрахованноеЛицо = ДобавитьУзелXML(УзелСписокЗастрахованныхЛиц, "застрахованноеЛицо");
			
			УзелФИО = ДобавитьУзелXML(УзелЗастрахованноеЛицо, "ФИО");
			ДобавитьУзелXML(УзелФИО, "Фамилия", , ВРЕГ(СокрЛП(Стр.Фамилия)));
			ДобавитьУзелXML(УзелФИО, "Имя", , ВРЕГ(СокрЛП(Стр.Имя)));
			ДобавитьУзелXML(УзелФИО, "Отчество", , ВРЕГ(СокрЛП(Стр.Отчество)));
			
			ДобавитьУзелXML(УзелЗастрахованноеЛицо, "страховойНомер", , СокрЛП(Стр.СтраховойНомер));
			
		КонецЦикла;
		
	КонецЕсли;
	
	// сохранение дерева XML в файл и двоичные данные
	ТекстВыгрузкиXML = ЗаписатьДеревоВXML(Дерево);
	
	// записываем XML запроса во временный файл
	ВремФайл = ПолучитьИмяВременногоФайла();
	Если НЕ ЗаписатьXMLВФайл(ТекстВыгрузкиXML, ВремФайл) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось записать текст запроса во временный файл!';
															|en = 'Не удалось записать текст запроса во временный файл!'"));
		Возврат Ложь;
	КонецЕсли;
	
	// считываем двоичные данные файла запроса, после чего удаляем файл
	ДвоичныеДанныеФайлаЗапроса = Новый ДвоичныеДанные(ВремФайл);
	ДвоичныеДанныеФайлаЗапроса = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаЗапроса, УникальныйИдентификатор);
	УдалитьФайлы(ВремФайл);
	
	// формируем имя файла запроса
	ИмяФайлаЗапроса = ИмяФайлаБезРасширения + ".xml";
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзПодтвержденияОПолученииПФР(СтрПодтверждение)
	
	Если НЕ ЗначениеЗаполнено(СтрПодтверждение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаИменФайлов = Новый ТаблицаЗначений;
	ТаблицаИменФайлов.Колонки.Добавить("ИмяФайла");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрПодтверждение, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML подтверждения о получении:%1';
																						|en = 'Ошибка разбора XML подтверждения о получении:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("подтверждениеПолучения", "Имя");
	УзелУОД = Неопределено;
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		УзелФайл = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ЭДПФР", "Э");
		Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
			УзелФайл = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ЭДСФР", "Э");
		КонецЕсли;
		Если ЗначениеЗаполнено(УзелФайл) Тогда
			УзелУОД = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "УОД", "Э");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(УзелУОД) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку("Некорректная структура XML протокола: не обнаружен узел ""УОД"" или ""подтверждениеПолучения"".");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ОбщиеСведения = Новый Структура;
	
	Если ЗначениеЗаполнено(УзелУОД) Тогда
		ОбщиеСведения.Вставить("ЭтоУОД", Истина);
		
		УзелОператор = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОД,,, "Оператор", "Э");
		УзелНаименованиеКраткоеОператора = Неопределено;
		УзелРегНомерОператора = Неопределено;
		Если ЗначениеЗаполнено(УзелОператор) Тогда
			УзелНаименованиеКраткоеОператора = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелОператор,,,
				"НаименованиеКраткое", "Э");
			УзелРегНомерОператора = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелОператор,,, "РегНомер", "Э");
		КонецЕсли;
		
		НаименованиеОператора = ?(ЗначениеЗаполнено(УзелНаименованиеКраткоеОператора),
			СокрЛП(УзелНаименованиеКраткоеОператора.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеОператора", НаименованиеОператора);
		
		РегистрационныйНомерОператора = ?(ЗначениеЗаполнено(УзелРегНомерОператора),
			СокрЛП(УзелРегНомерОператора.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомерОператора", РегистрационныйНомерОператора);
		
		УзелСтрахователь = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОД,,, "Страхователь", "Э");
		УзелНаименованиеКраткое = Неопределено;
		УзелФамилия = Неопределено;
		УзелИмя = Неопределено;
		УзелОтчество = Неопределено;
		УзелРегНомер = Неопределено;
		УзелИНН = Неопределено;
		УзелКПП = Неопределено;
		Если ЗначениеЗаполнено(УзелСтрахователь) Тогда
			УзелНаименованиеКраткое = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(
				УзелСтрахователь,,, "НаименованиеКраткое", "Э");
			УзелФИО = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "ФИО", "Э");
			Если УзелФИО <> Неопределено Тогда
				УзелФамилия = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Фамилия", "Э");
				УзелИмя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Имя", "Э");
				УзелОтчество = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Отчество", "Э");
			КонецЕсли;
			УзелРегНомер = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "РегНомер", "Э");
			УзелИНН = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "ИНН", "Э");
			УзелКПП = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "КПП", "Э");
		КонецЕсли;
		
		НаименованиеОрганизации = ?(ЗначениеЗаполнено(УзелНаименованиеКраткое),
			СокрЛП(УзелНаименованиеКраткое.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		
		Фамилия = ?(ЗначениеЗаполнено(УзелФамилия), СокрЛП(УзелФамилия.Значение), "");
		ОбщиеСведения.Вставить("Фамилия", Фамилия);
		
		Имя = ?(ЗначениеЗаполнено(УзелИмя), СокрЛП(УзелИмя.Значение), "");
		ОбщиеСведения.Вставить("Имя", Имя);
		
		Отчество = ?(ЗначениеЗаполнено(УзелОтчество), СокрЛП(УзелОтчество.Значение), "");
		ОбщиеСведения.Вставить("Отчество", Отчество);
		
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		ИНН = ?(ЗначениеЗаполнено(УзелИНН), СокрЛП(УзелИНН.Значение), "");
		ОбщиеСведения.Вставить("ИНН", ИНН);
		
		КПП = ?(ЗначениеЗаполнено(УзелКПП), СокрЛП(УзелКПП.Значение), "");
		ОбщиеСведения.Вставить("КПП", КПП);
		
		УзелДоставленныйПакет = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОД,,, "ДоставленныйПакет", "Э");
		УзелИдентификатор = Неопределено;
		УзелДатаВремя = Неопределено;
		УзелКанал = Неопределено;
		Если ЗначениеЗаполнено(УзелДоставленныйПакет) Тогда
			УзелИдентификатор = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДоставленныйПакет,,, "Идентификатор", "Э");
			УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДоставленныйПакет,,, "ДатаВремя", "Э");
			УзелКанал = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДоставленныйПакет,,, "Канал", "Э");
		КонецЕсли;
		
		ИдентификаторДоставленногоПакета = ?(ЗначениеЗаполнено(УзелИдентификатор), СокрЛП(УзелИдентификатор.Значение), "");
		ОбщиеСведения.Вставить("ИдентификаторДоставленногоПакета", ИдентификаторДоставленногоПакета);
		
		ДатаВремяДоставкиПакета = ?(ЗначениеЗаполнено(УзелДатаВремя),
			XMLЗначение(Тип("Дата"), УзелДатаВремя.Значение), Неопределено);
		ОбщиеСведения.Вставить("ДатаВремяДоставкиПакета", ДатаВремяДоставкиПакета);
		ДатаВремяДоставкиПакетаСтрокой = Формат(ДатаВремяДоставкиПакета, "ДЛФ=ДДВ");
		ОбщиеСведения.Вставить("ДатаВремяДоставкиПакетаСтрокой", ДатаВремяДоставкиПакетаСтрокой);
		
		КаналПередачи = ?(ЗначениеЗаполнено(УзелКанал), СокрЛП(УзелКанал.Значение), "");
		ОбщиеСведения.Вставить("КаналПередачи", КаналПередачи);
		КаналПередачиСтрокой = ?(ВРег(КаналПередачи) = "EDOK", НСтр("ru = 'Электронный документооборот';
																	|en = 'Электронный документооборот'"),
			?(ВРег(КаналПередачи) = "ES.KS", НСтр("ru = 'Кабинет страхователя';
													|en = 'Кабинет страхователя'"),
			?(ВРег(КаналПередачи) = "POST", НСтр("ru = 'Бумажная почта';
												|en = 'Бумажная почта'"),
			?(ВРег(КаналПередачи) = "PERS", НСтр("ru = 'Лично';
												|en = 'Лично'"), СокрЛП(КаналПередачи)))));
		ОбщиеСведения.Вставить("КаналПередачиСтрокой", КаналПередачиСтрокой);
		
		УзелСлужебнаяИнформация = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "СлужебнаяИнформация", "Э");
		УзелGUID = Неопределено;
		УзелДатаВремя = Неопределено;
		Если ЗначениеЗаполнено(УзелСлужебнаяИнформация) Тогда
			УзелGUID = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "GUID", "Э");
			УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "ДатаВремя", "Э");
		КонецЕсли;
		
		ИдентификаторКвитанции = ?(ЗначениеЗаполнено(УзелGUID), СокрЛП(УзелGUID.Значение), "");
		ОбщиеСведения.Вставить("ИдентификаторКвитанции", ИдентификаторКвитанции);
		
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаВремя), XMLЗначение(Тип("Дата"), УзелДатаВремя.Значение), "");
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
		ДатаОтправкиСтрокой = Формат(ДатаОтправки, "ДЛФ=ДДВ");
		ОбщиеСведения.Вставить("ДатаОтправкиСтрокой", ДатаОтправкиСтрокой);
		
	Иначе
		УзелРегНомер = УзелФайл.Строки.Найти("регистрационныйНомерОрганизации", "Имя");
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		УзелДатаПолучения = УзелФайл.Строки.Найти("датаВремяПолучения", "Имя");
		ДатаПолучения = ?(ЗначениеЗаполнено(УзелДатаПолучения),
			XMLЗначение(Тип("Дата"), УзелДатаПолучения.Значение), Неопределено);
		ДатаПолученияСтрокой = Формат(ДатаПолучения, "ДЛФ=DDT");
		ОбщиеСведения.Вставить("ДатаПолучения", ДатаПолученияСтрокой);
		ОбщиеСведения.Вставить("ДатаВремяДоставкиПакета", ДатаПолучения);
		ДатаВремяДоставкиПакетаСтрокой = Формат(ДатаПолучения, "ДЛФ=ДДВ");
		ОбщиеСведения.Вставить("ДатаВремяДоставкиПакетаСтрокой", ДатаВремяДоставкиПакетаСтрокой);
		
		УзлыОписаниеПачек = УзелФайл.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПачек"));
		Для Каждого УзелОписаниеПачек Из УзлыОписаниеПачек Цикл
			УзлыИменФайлов = УзелОписаниеПачек.Строки.НайтиСтроки(Новый Структура("Имя", "пачка"));
			Для Каждого УзлыИмен Из УзлыИменФайлов Цикл
				
				УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
				ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
				НовСтр = ТаблицаИменФайлов.Добавить();
				НовСтр.ИмяФайла = ИмяФайла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Структура("ИмяФайла, ОбщиеСведения", ТаблицаИменФайлов, ОбщиеСведения);
	
КонецФункции

&НаСервере
Функция ПолучитьОсновныеСвойстваИзПротоколаПФР(
		СтрПротокол,
		ЦиклОбмена = Неопределено,
		ТранспортноеСообщение = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(СтрПротокол) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаИменФайлов = Новый ТаблицаЗначений;
	ТаблицаИменФайлов.Колонки.Добавить("ИмяФайла");
	
	ТаблицаИменВложений = Новый ТаблицаЗначений;
	ТаблицаИменВложений.Колонки.Добавить("ИмяВложения");
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрПротокол, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML подтверждения о получении:%1';
																						|en = 'Ошибка разбора XML подтверждения о получении:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("протокол", "Имя");
	УзелУОРР = Неопределено;
	УзелУОНД = Неопределено;
	УзелАДИ_РЕГ = Неопределено;
	УзелАДИ_8 = Неопределено;
	УзелАВП_ПУ = Неопределено;
	УзелРПОП_ПУ = Неопределено;
	УзелРОПОП_ПУ = Неопределено;
	УзелТУФС_ПУ = Неопределено;
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		УзелФайл = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ЭДПФР", "Э");
		Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
			УзелФайл = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(ДеревоXML,,, "ЭДСФР", "Э");
		КонецЕсли;
		Если ЗначениеЗаполнено(УзелФайл) Тогда
			УзелУППО = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "УПП", "Э"); // УППО, УУОН-ПУ
			Если НЕ ЗначениеЗаполнено(УзелУППО) Тогда
				УзелУОРР = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "УОРР", "Э");
				Если НЕ ЗначениеЗаполнено(УзелУОРР) Тогда
					УзелУОНД = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "УОНД", "Э");
					Если НЕ ЗначениеЗаполнено(УзелУОНД) Тогда
						УзелАДИ_РЕГ = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "АДИ-РЕГ", "Э");
						Если НЕ ЗначениеЗаполнено(УзелАДИ_РЕГ) Тогда
							УзелАДИ_8 = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "АДИ-8", "Э");
							Если НЕ ЗначениеЗаполнено(УзелАДИ_8) Тогда
								УзелАВП_ПУ = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "АВП-ПУ", "Э");
								Если НЕ ЗначениеЗаполнено(УзелАВП_ПУ) Тогда
									УзелРПОП_ПУ = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "РПОП-ПУ", "Э");
									Если НЕ ЗначениеЗаполнено(УзелРПОП_ПУ) Тогда
										УзелРОПОП_ПУ = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "РОПОП-ПУ", "Э");
										Если НЕ ЗначениеЗаполнено(УзелРОПОП_ПУ) Тогда
											УзелТУФС_ПУ = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "ТУФС-ПУ", "Э");
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УзелУППО) И НЕ ЗначениеЗаполнено(УзелУОРР) И НЕ ЗначениеЗаполнено(УзелУОНД)
			И НЕ ЗначениеЗаполнено(УзелАДИ_РЕГ) И НЕ ЗначениеЗаполнено(УзелАДИ_8) И НЕ ЗначениеЗаполнено(УзелАВП_ПУ)
			И НЕ ЗначениеЗаполнено(УзелРПОП_ПУ) И НЕ ЗначениеЗаполнено(УзелРОПОП_ПУ) И НЕ ЗначениеЗаполнено(УзелТУФС_ПУ) Тогда
			
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку("Некорректная структура XML протокола: не обнаружен узел ""УПП"", ""УОРР"", ""УОНД"", ""АДИ-РЕГ"", ""АДИ-8"" или ""протокол"".");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ОбщиеСведения = Новый Структура;
	
	Если ЗначениеЗаполнено(УзелУППО) ИЛИ ЗначениеЗаполнено(УзелАДИ_РЕГ) ИЛИ ЗначениеЗаполнено(УзелАДИ_8)
		ИЛИ ЗначениеЗаполнено(УзелАВП_ПУ) ИЛИ ЗначениеЗаполнено(УзелРПОП_ПУ) ИЛИ ЗначениеЗаполнено(УзелРОПОП_ПУ)
		ИЛИ ЗначениеЗаполнено(УзелТУФС_ПУ) Тогда
		
		УзелСлужебнаяИнформация = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "СлужебнаяИнформация", "Э");
		УзелДатаВремя = Неопределено;
		Если ЗначениеЗаполнено(УзелСлужебнаяИнформация) Тогда
			УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "ДатаВремя", "Э");
		КонецЕсли;
		
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаВремя), XMLЗначение(Тип("Дата"), УзелДатаВремя.Значение), "");
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
		
		ДатаОтправкиСтрокой = Формат(ДатаОтправки, "ДЛФ=ДДВ");
		ОбщиеСведения.Вставить("ДатаОтправкиСтрокой", ДатаОтправкиСтрокой);
		
		УзелКонтрагент = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "Контрагент", "Э");
		УзелРегНомер = Неопределено;
		Если ЗначениеЗаполнено(УзелКонтрагент) Тогда
			УзелРегНомер = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелКонтрагент,,, "РегистрационныйНомер", "Э");
		КонецЕсли;
		
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		Если НЕ ЗначениеЗаполнено(РегистрационныйНомер) И ЗначениеЗаполнено(ЦиклОбмена) Тогда
			ОрганизацияСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦиклОбмена, "Организация");
			Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
				РегистрационныйНомер = КонтекстЭДОСервер.СформироватьПараметрыОтправкиВПФР(ОрганизацияСсылка).РегНомПФР;
			КонецЕсли;
		КонецЕсли;
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		Если ЗначениеЗаполнено(УзелУППО) Тогда
			УзелПроверяемыйДокумент = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУППО,,, "ПроверяемыйДокумент", "Э");
			Если ЗначениеЗаполнено(УзелПроверяемыйДокумент) Тогда
				УзлыФайл = Новый Массив;
				КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелПроверяемыйДокумент,, УзлыФайл, "Файл", "Э");
				
				Для каждого УзелФайл Из УзлыФайл Цикл
					УзлыИмяФайла = УзелФайл.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "ИмяФайла", "А"));
					Если УзлыИмяФайла.Количество() <> 0 Тогда
						НовСтр = ТаблицаИменФайлов.Добавить();
						НовСтр.ИмяФайла = УзлыИмяФайла[0].Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТранспортноеСообщение) Тогда
			Вложения = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Ложь,
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР);
			
			Для каждого Вложение Из Вложения Цикл
				НовСтр = ТаблицаИменВложений.Добавить();
				НовСтр.ИмяВложения = Вложение.ИмяФайла;
			КонецЦикла;
		КонецЕсли;
		
		ОбщиеСведения.Вставить("ЯвляетсяПоложительным", Истина);
		ОбщиеСведения.Вставить("СданЧастично", Ложь);
		Если ЗначениеЗаполнено(УзелУППО) Тогда
			УзлыУППКодРезультата = Новый Массив;
			КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУППО,, УзлыУППКодРезультата, "КодРезультата", "Э");
			Для каждого УзелУППКодРезультата Из УзлыУППКодРезультата Цикл
				ЗначениеКодаРезультата = СокрЛП(УзелУППКодРезультата.Значение);
				Если ЗначениеКодаРезультата = "30" ИЛИ ЗначениеКодаРезультата = "40" Тогда
					ОбщиеСведения.СданЧастично = Истина;
				ИначеЕсли ЗначениеКодаРезультата = "50" Тогда
					ОбщиеСведения.СданЧастично = Ложь;
					ОбщиеСведения.ЯвляетсяПоложительным = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли НЕ ЗначениеЗаполнено(УзелАДИ_РЕГ) Тогда
			ОбщиеСведения.ЯвляетсяПоложительным = Ложь;
		КонецЕсли;
		
		ДатаВремяДоставкиПакета = Неопределено;
		ДатаВремяДоставкиПакетаСтрокой = "";
		Если ЗначениеЗаполнено(ЦиклОбмена) Тогда
			УведомленияОДоставке = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,
				Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР);
			Если УведомленияОДоставке.Количество() > 0 Тогда
				ВложенияУведомленияОДоставке = КонтекстЭДОСервер.ПолучитьВложенияТранспортногоСообщения(УведомленияОДоставке[0],
					Истина, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияОтчетностиПФР,, Истина);
				Для каждого ВложениеУведомленияОДоставке Из ВложенияУведомленияОДоставке Цикл
					ДвоичныеДанныеВложения = ВложениеУведомленияОДоставке.Данные.Получить();
					Если ДвоичныеДанныеВложения <> Неопределено Тогда
						ТекстXMLВложения = ПрочитатьТекстИзФайла(ВложениеУведомленияОДоставке.Адрес,, Истина);
						СвойстваУведомленияОДоставке = ПолучитьОсновныеСвойстваИзПодтвержденияОПолученииПФР(ТекстXMLВложения);
						Если СвойстваУведомленияОДоставке <> Неопределено И (ДатаВремяДоставкиПакета = Неопределено
							ИЛИ СвойстваУведомленияОДоставке.ОбщиеСведения.ДатаВремяДоставкиПакетаСтрокой < ДатаВремяДоставкиПакета) Тогда
							
							ДатаВремяДоставкиПакета = СвойстваУведомленияОДоставке.ОбщиеСведения.ДатаВремяДоставкиПакетаСтрокой;
							ДатаВремяДоставкиПакетаСтрокой = СвойстваУведомленияОДоставке.ОбщиеСведения.ДатаВремяДоставкиПакетаСтрокой;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ОбщиеСведения.Вставить("ДатаПолучения", ДатаВремяДоставкиПакетаСтрокой);
		
	ИначеЕсли ЗначениеЗаполнено(УзелУОРР) Тогда
		ОбщиеСведения.Вставить("ЭтоУОРР", Истина);
		
		УзелСтрахователь = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОРР,,, "Страхователь", "Э");
		УзелНаименованиеКраткое = Неопределено;
		УзелРегНомер = Неопределено;
		Если ЗначениеЗаполнено(УзелСтрахователь) Тогда
			УзелНаименованиеКраткое = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,,
				"НаименованиеКраткое", "Э");
			УзелРегНомер = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "РегНомер", "Э");
		КонецЕсли;
		
		НаименованиеОрганизации = ?(ЗначениеЗаполнено(УзелНаименованиеКраткое),
			СокрЛП(УзелНаименованиеКраткое.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		
		НачалоНаименования = НаименованиеОрганизации;
		ОкончаниеНаименования = "";
		МаксимальнаяДлинаНачала = 60;
		Если СтрДлина(НаименованиеОрганизации) > МаксимальнаяДлинаНачала Тогда
			Для ИндексСКонца = 0 По МаксимальнаяДлинаНачала - 14 Цикл
				ПозицияСНачала = МаксимальнаяДлинаНачала + 1 - ИндексСКонца;
				Если Сред(НачалоНаименования, ПозицияСНачала, 1) = " " Тогда
					НачалоНаименования = Лев(НаименованиеОрганизации, ПозицияСНачала - 1);
					НачалоНаименования = СокрП(НачалоНаименования);
					ОкончаниеНаименования = Сред(НаименованиеОрганизации, ПозицияСНачала + 1);
					ОкончаниеНаименования = СокрЛ(ОкончаниеНаименования);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ОбщиеСведения.Вставить("НачалоНаименования", НачалоНаименования);
		ОбщиеСведения.Вставить("ОкончаниеНаименования", ОкончаниеНаименования);
		
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		УзелДокумент = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОРР,,, "Документ", "Э");
		УзелНаименованиеДокумента = Неопределено;
		УзелРегистрационныйНомерОбращения = Неопределено;
		УзелДатаРегистрацииОбращения = Неопределено;
		Если ЗначениеЗаполнено(УзелДокумент) Тогда
			УзелНаименованиеДокумента = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,,
				"НаименованиеДокумента", "Э");
			УзелРегистрационныйНомерОбращения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,,
				"РегистрационныйНомерОбращения", "Э");
			УзелДатаРегистрацииОбращения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,,
				"ДатаРегистрацииОбращения", "Э");
		КонецЕсли;
		
		НаименованиеДокумента = ?(ЗначениеЗаполнено(УзелНаименованиеДокумента),
			СокрЛП(УзелНаименованиеДокумента.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеДокумента", НаименованиеДокумента);
		
		РегистрационныйНомерОбращения = ?(ЗначениеЗаполнено(УзелРегистрационныйНомерОбращения),
			СокрЛП(УзелРегистрационныйНомерОбращения.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомерОбращения", РегистрационныйНомерОбращения);
		
		ДатаРегистрацииОбращения = ?(ЗначениеЗаполнено(УзелДатаРегистрацииОбращения),
			XMLЗначение(Тип("Дата"), УзелДатаРегистрацииОбращения.Значение), Неопределено);
		ОбщиеСведения.Вставить("ДатаРегистрацииОбращения", ДатаРегистрацииОбращения);
		ДатаРегистрацииОбращенияСтрокой = Формат(ДатаРегистрацииОбращения, "ДЛФ=ДД");
		ОбщиеСведения.Вставить("ДатаРегистрацииОбращенияСтрокой", ДатаРегистрацииОбращенияСтрокой);
		ДеньРегистрацииОбращенияСтрокой = Формат(ДатаРегистрацииОбращения, "ДФ=д");
		ОбщиеСведения.Вставить("ДеньРегистрацииОбращенияСтрокой", ДеньРегистрацииОбращенияСтрокой);
		МесяцРегистрацииОбращенияСтрокой = МесяцДатыСтрокой(ДатаРегистрацииОбращения);
		ОбщиеСведения.Вставить("МесяцРегистрацииОбращенияСтрокой", МесяцРегистрацииОбращенияСтрокой);
		ГодРегистрацииОбращенияСтрокой = Формат(ДатаРегистрацииОбращения, "ДФ=гггг");
		ОбщиеСведения.Вставить("ГодРегистрацииОбращенияСтрокой", ГодРегистрацииОбращенияСтрокой);
		
		УзелСведенияОРезультатеРассмотрения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелУОРР,,,
			"СведенияОРезультатеРассмотрения", "Э");
		УзелРезультатРассмотрения = Неопределено;
		УзелКодПричиныОтказа = Неопределено;
		УзелПричинаОтказа = Неопределено;
		Если ЗначениеЗаполнено(УзелСведенияОРезультатеРассмотрения) Тогда
			УзелРезультатРассмотрения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСведенияОРезультатеРассмотрения,,,
				"РезультатРассмотрения", "Э");
			УзелКодПричиныОтказа = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСведенияОРезультатеРассмотрения,,,
				"КодПричиныОтказа", "Э");
			УзелПричинаОтказа = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСведенияОРезультатеРассмотрения,,,
				"ПричинаОтказа", "Э");
		КонецЕсли;
		
		РезультатРассмотрения = ?(ЗначениеЗаполнено(УзелРезультатРассмотрения),
			XMLЗначение(Тип("Число"), УзелРезультатРассмотрения.Значение), "");
		ОбщиеСведения.Вставить("РезультатРассмотрения", РезультатРассмотрения);
		
		КодПричиныОтказа = ?(ЗначениеЗаполнено(УзелКодПричиныОтказа), СокрЛП(УзелКодПричиныОтказа.Значение), "");
		ОбщиеСведения.Вставить("КодПричиныОтказа", КодПричиныОтказа);
		
		ПричинаОтказа = ?(ЗначениеЗаполнено(УзелПричинаОтказа), СокрЛП(УзелПричинаОтказа.Значение), "");
		ОбщиеСведения.Вставить("ПричинаОтказа", ПричинаОтказа);
		
		УзелСлужебнаяИнформация = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "СлужебнаяИнформация", "Э");
		УзелGUID = Неопределено;
		УзелДатаВремя = Неопределено;
		Если ЗначениеЗаполнено(УзелСлужебнаяИнформация) Тогда
			УзелGUID = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "GUID", "Э");
			УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "ДатаВремя", "Э");
		КонецЕсли;
		
		ИдентификаторКвитанции = ?(ЗначениеЗаполнено(УзелGUID), СокрЛП(УзелGUID.Значение), "");
		ОбщиеСведения.Вставить("ИдентификаторКвитанции", ИдентификаторКвитанции);
		
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаВремя), XMLЗначение(Тип("Дата"), УзелДатаВремя.Значение), "");
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
		
		ДеньОтправкиСтрокой = Формат(ДатаОтправки, "ДФ=д");
		ОбщиеСведения.Вставить("ДеньОтправкиСтрокой", ДеньОтправкиСтрокой);
		МесяцОтправкиСтрокой = МесяцДатыСтрокой(ДатаОтправки);
		ОбщиеСведения.Вставить("МесяцОтправкиСтрокой", МесяцОтправкиСтрокой);
		ГодОтправкиСтрокой = Формат(ДатаОтправки, "ДФ=гггг");
		ОбщиеСведения.Вставить("ГодОтправкиСтрокой", ГодОтправкиСтрокой);
		
	ИначеЕсли ЗначениеЗаполнено(УзелУОНД) Тогда
		ОбщиеСведения.Вставить("ЭтоУОНД", Истина);
		
		УзелСлужебнаяИнформация = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "СлужебнаяИнформация", "Э");
		УзелДатаВремя = Неопределено;
		Если ЗначениеЗаполнено(УзелСлужебнаяИнформация) Тогда
			УзелДатаВремя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСлужебнаяИнформация,,, "ДатаВремя", "Э");
		КонецЕсли;
		
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаВремя), XMLЗначение(Тип("Дата"), УзелДатаВремя.Значение), "");
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
		
		ДатаОтправкиСтрокой = Формат(ДатаОтправки, "ДЛФ=ДДВ");
		ОбщиеСведения.Вставить("ДатаОтправкиСтрокой", ДатаОтправкиСтрокой);
		
		ДеньОтправкиСтрокой = Формат(ДатаОтправки, "ДФ=д");
		ОбщиеСведения.Вставить("ДеньОтправкиСтрокой", ДеньОтправкиСтрокой);
		МесяцОтправкиСтрокой = МесяцДатыСтрокой(ДатаОтправки);
		ОбщиеСведения.Вставить("МесяцОтправкиСтрокой", МесяцОтправкиСтрокой);
		ГодОтправкиСтрокой = Формат(ДатаОтправки, "ДФ=гггг");
		ОбщиеСведения.Вставить("ГодОтправкиСтрокой", ГодОтправкиСтрокой);
		
		УзелСтрахователь = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "Страхователь", "Э");
		УзелНаименованиеКраткое = Неопределено;
		УзелФИО = Неопределено;
		УзелРегНомер = Неопределено;
		Если ЗначениеЗаполнено(УзелСтрахователь) Тогда
			УзелНаименованиеКраткое = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,,
				"НаименованиеКраткое", "Э");
			УзелФИО = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "ФИО", "Э");
			УзелРегНомер = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелСтрахователь,,, "РегНомер", "Э");
		КонецЕсли;
		
		НаименованиеОрганизации = ?(ЗначениеЗаполнено(УзелНаименованиеКраткое),
			СокрЛП(УзелНаименованиеКраткое.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		УзелФамилия = Неопределено;
		УзелИмя = Неопределено;
		УзелОтчество = Неопределено;
		Если ЗначениеЗаполнено(УзелФИО) Тогда
			УзелФамилия = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Фамилия", "Э");
			УзелИмя = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Имя", "Э");
			УзелОтчество = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФИО,,, "Отчество", "Э");
		КонецЕсли;
		
		ФамилияСтрахователя = ?(ЗначениеЗаполнено(УзелФамилия), СокрЛП(УзелФамилия.Значение), "");
		ОбщиеСведения.Вставить("Фамилия", ФамилияСтрахователя);
		ИмяСтрахователя = ?(ЗначениеЗаполнено(УзелИмя), СокрЛП(УзелИмя.Значение), "");
		ОбщиеСведения.Вставить("Имя", ИмяСтрахователя);
		ОтчествоСтрахователя = ?(ЗначениеЗаполнено(УзелОтчество), СокрЛП(УзелОтчество.Значение), "");
		ОбщиеСведения.Вставить("Отчество", ОтчествоСтрахователя);
		
		ФИОСтрахователя = ФамилияСтрахователя + ?(ЗначениеЗаполнено(ФамилияСтрахователя)
			И ЗначениеЗаполнено(ИмяСтрахователя), " ", "") + ИмяСтрахователя + ?((ЗначениеЗаполнено(ФамилияСтрахователя)
			ИЛИ ЗначениеЗаполнено(ИмяСтрахователя)) И ЗначениеЗаполнено(ОтчествоСтрахователя), " ", "") + ОтчествоСтрахователя;
		НаименованиеОрганизацииИлиФИОСтрахователя = ?(ЗначениеЗаполнено(УзелНаименованиеКраткое), НаименованиеОрганизации,
			ФИОСтрахователя);
		
		НачалоНаименования = НаименованиеОрганизацииИлиФИОСтрахователя;
		ОкончаниеНаименования = "";
		МаксимальнаяДлинаНачала = 60;
		Если СтрДлина(НаименованиеОрганизацииИлиФИОСтрахователя) > МаксимальнаяДлинаНачала Тогда
			Для ИндексСКонца = 0 По МаксимальнаяДлинаНачала - 14 Цикл
				ПозицияСНачала = МаксимальнаяДлинаНачала + 1 - ИндексСКонца;
				Если Сред(НачалоНаименования, ПозицияСНачала, 1) = " " Тогда
					НачалоНаименования = Лев(НаименованиеОрганизацииИлиФИОСтрахователя, ПозицияСНачала - 1);
					НачалоНаименования = СокрП(НачалоНаименования);
					ОкончаниеНаименования = Сред(НаименованиеОрганизацииИлиФИОСтрахователя, ПозицияСНачала + 1);
					ОкончаниеНаименования = СокрЛ(ОкончаниеНаименования);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ОбщиеСведения.Вставить("НачалоНаименования", НачалоНаименования);
		ОбщиеСведения.Вставить("ОкончаниеНаименования", ОкончаниеНаименования);
		
		УзелДокумент = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "Документ", "Э");
		УзелНаименованиеДокумента = Неопределено;
		УзелКодДокумента = Неопределено;
		УзелРегистрационныйНомерОбращения = Неопределено;
		УзелВОтветНа = Неопределено;
		Если ЗначениеЗаполнено(УзелСтрахователь) Тогда
			УзелНаименованиеДокумента = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,,
				"Наименование", "Э");
			УзелКодДокумента = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,, "Код", "Э");
			УзелРегистрационныйНомерОбращения = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,,
				"РегНомерОбращ", "Э");
			УзелВОтветНа = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелДокумент,,, "ВОтветНа", "Э");
		КонецЕсли;
		
		НаименованиеДокумента = ?(ЗначениеЗаполнено(УзелНаименованиеДокумента),
			СокрЛП(УзелНаименованиеДокумента.Значение), "");
		ОбщиеСведения.Вставить("НаименованиеДокумента", НаименованиеДокумента);
		
		КодДокумента = ?(ЗначениеЗаполнено(УзелКодДокумента), СокрЛП(УзелКодДокумента.Значение), "");
		ОбщиеСведения.Вставить("КодДокумента", КодДокумента);
		
		РегистрационныйНомерОбращения = ?(ЗначениеЗаполнено(УзелРегистрационныйНомерОбращения),
			СокрЛП(УзелРегистрационныйНомерОбращения.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомерОбращения", РегистрационныйНомерОбращения);
		
		ВОтветНа = ?(ЗначениеЗаполнено(УзелВОтветНа), СокрЛП(УзелВОтветНа.Значение), "");
		ОбщиеСведения.Вставить("ВОтветНа", ВОтветНа);
		
		УзелПричина = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "Причина", "Э");
		Причина = ?(ЗначениеЗаполнено(УзелПричина), СокрЛП(УзелПричина.Значение), "");
		ОбщиеСведения.Вставить("Причина", Причина);
		
		УзелКомментарий = КонтекстЭДОСервер.НайтиСтрокиДереваЗначений(УзелФайл,,, "Комментарий", "Э");
		Комментарий = ?(ЗначениеЗаполнено(УзелКомментарий), СокрЛП(УзелКомментарий.Значение), "");
		ОбщиеСведения.Вставить("Комментарий", Комментарий);
		
	Иначе
		УзелЯвляетсяПоложительным = УзелФайл.Строки.Найти("являетсяПоложительным", "Имя");
		ЯвляетсяПоложительным = ?(ЗначениеЗаполнено(УзелЯвляетсяПоложительным),
			XMLЗначение(Тип("Булево"),УзелЯвляетсяПоложительным.Значение), "");
		ОбщиеСведения.Вставить("ЯвляетсяПоложительным", ЯвляетсяПоложительным);
		
		УзелДатаОтправки = УзелФайл.Строки.Найти("датаВремяОтправки", "Имя");
		ДатаОтправки = ?(ЗначениеЗаполнено(УзелДатаОтправки),
			Формат(XMLЗначение(Тип("Дата"), УзелДатаОтправки.Значение), "ДЛФ=ДДВ"), "");
		ОбщиеСведения.Вставить("ДатаОтправки", ДатаОтправки);
		
		УзелПодтверждение = УзелФайл.Строки.Найти("подтверждениеПолучения", "Имя");
		
		УзелРегНомер = УзелПодтверждение.Строки.Найти("регистрационныйНомерОрганизации", "Имя");
		РегистрационныйНомер = ?(ЗначениеЗаполнено(УзелРегНомер), СокрЛП(УзелРегНомер.Значение), "");
		ОбщиеСведения.Вставить("РегистрационныйНомер", РегистрационныйНомер);
		
		УзелДатаПолучения = УзелПодтверждение.Строки.Найти("датаВремяПолучения", "Имя");
		ДатаПолучения = ?(ЗначениеЗаполнено(УзелДатаПолучения),
			Формат(XMLЗначение(Тип("Дата"), УзелДатаПолучения.Значение), "ДЛФ=ДДВ"), "");
		ОбщиеСведения.Вставить("ДатаПолучения", ДатаПолучения);	
		
		УзлыОписаниеПачек = УзелПодтверждение.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПачек"));
		Для Каждого УзелОписаниеПачек Из УзлыОписаниеПачек Цикл
			УзлыИменФайлов = УзелОписаниеПачек.Строки.НайтиСтроки(Новый Структура("Имя", "пачка"));
			Для Каждого УзлыИмен Из УзлыИменФайлов Цикл
				
				УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
				ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
				НовСтр = ТаблицаИменФайлов.Добавить();
				НовСтр.ИмяФайла = ИмяФайла;
			КонецЦикла;
		КонецЦикла;
		
		УзлыОписаниеПриложений = УзелФайл.Строки.НайтиСтроки(Новый Структура("Имя", "описаниеПриложений"));
		Для Каждого УзелОписаниеПриложений Из УзлыОписаниеПриложений Цикл
			УзлыИменПриложений = УзелОписаниеПриложений.Строки.НайтиСтроки(Новый Структура("Имя", "приложение"));
			Для Каждого УзлыИмен Из УзлыИменПриложений Цикл
				УзелИмяФайла = УзлыИмен.Строки.Найти("имяФайла", "Имя");
				ИмяФайла = ?(ЗначениеЗаполнено(УзелИмяФайла), СокрЛП(УзелИмяФайла.Значение), "");
				НовСтр = ТаблицаИменВложений.Добавить();
				НовСтр.ИмяВложения = ИмяФайла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Структура("ИмяФайла, ОбщиеСведения, Вложения", ТаблицаИменФайлов, ОбщиеСведения, ТаблицаИменВложений);
	
КонецФункции

&НаСервереБезКонтекста
Функция МесяцДатыСтрокой(МесяцИлиДата)
	
	Если НЕ ЗначениеЗаполнено(МесяцИлиДата) Тогда
		Возврат "";
	КонецЕсли;
	
	МесяцЧислом = ?(ТипЗнч(МесяцИлиДата) = Тип("Дата"), Месяц(МесяцИлиДата), МесяцИлиДата);
	
	Если МесяцЧислом = 1 Тогда
		Возврат НСтр("ru = 'января';
					|en = 'января'");
	ИначеЕсли МесяцЧислом = 2 Тогда
		Возврат НСтр("ru = 'февраля';
					|en = 'февраля'");
	ИначеЕсли МесяцЧислом = 3 Тогда
		Возврат НСтр("ru = 'марта';
					|en = 'марта'");
	ИначеЕсли МесяцЧислом = 4 Тогда
		Возврат НСтр("ru = 'апреля';
					|en = 'апреля'");
	ИначеЕсли МесяцЧислом = 5 Тогда
		Возврат НСтр("ru = 'мая';
					|en = 'мая'");
	ИначеЕсли МесяцЧислом = 6 Тогда
		Возврат НСтр("ru = 'июня';
					|en = 'июня'");
	ИначеЕсли МесяцЧислом = 7 Тогда
		Возврат НСтр("ru = 'июля';
					|en = 'июля'");
	ИначеЕсли МесяцЧислом = 8 Тогда
		Возврат НСтр("ru = 'августа';
					|en = 'августа'");
	ИначеЕсли МесяцЧислом = 9 Тогда
		Возврат НСтр("ru = 'сентября';
					|en = 'сентября'");
	ИначеЕсли МесяцЧислом = 10 Тогда
		Возврат НСтр("ru = 'октября';
					|en = 'октября'");
	ИначеЕсли МесяцЧислом = 11 Тогда
		Возврат НСтр("ru = 'ноября';
					|en = 'ноября'");
	ИначеЕсли МесяцЧислом = 12 Тогда
		Возврат НСтр("ru = 'декабря';
					|en = 'декабря'");
	Иначе
		Возврат ""
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена)
	
	ДатыСообщений = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	ТранспортныеСообщения.Тип КАК Тип,
						  |	ТранспортныеСообщения.ДатаТранспорта,
						  |	ТранспортныеСообщения.Дата КАК Дата
						  |ИЗ
						  |	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
						  |ГДЕ
						  |	ТранспортныеСообщения.ЦиклОбмена = &ЦиклОбмена
						  |");
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклОбмена);
	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР));
	ДатаОтправленоСтрахователем = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаОтправленоСтрахователем = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаОтправленоСтрахователем", ДатаОтправленоСтрахователем);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР));
	ДатаПодтверждения = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаПодтверждения = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаПодтверждения", ДатаПодтверждения);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПротоколПФР));
	ДатаПротокола = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаПротокола = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=DDT");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаПротокола", ДатаПротокола);
	
	возврат ДатыСообщений;
КонецФункции

// - Формирование печатной формы протокола Росстат
&НаСервере
Функция СформироватьТабличныйДокументНаОсновеПротоколаФСГС(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	ТекстПротокола = Тело;
	
	// загружаем XML из строки в дерево
	ДеревоXML = ЗагрузитьСтрокуXMLВДеревоЗначений(Тело);
	
	Если ДеревоXML <> Неопределено Тогда
		
		УзелПротокол = ДеревоXML.Строки.Найти("protocol", "Имя");
		
		Если УзелПротокол <> Неопределено Тогда
			
			УзелСтатусПротокола = УзелПротокол.Строки.Найти("status", "Имя");
			СтатусПротокола = "";
			Если УзелСтатусПротокола <> Неопределено Тогда
				СтатусПротокола = XMLЗначение(Тип("Строка"), УзелСтатусПротокола.Значение);
			КонецЕсли;
			УзелСообщениеПротокола = УзелПротокол.Строки.Найти("msg", "Имя");
			СообщениеПротокола = "";
			Если УзелСообщениеПротокола <> Неопределено Тогда
				СообщениеПротокола = XMLЗначение(Тип("Строка"), УзелСообщениеПротокола.Значение);
			КонецЕсли;
			
			УзелТитульный = УзелПротокол.Строки.Найти("title", "Имя");
			Если УзелТитульный <> Неопределено Тогда
				
				ЗначенияЭлементов = Новый Соответствие;
				УзлыЭлементы = УзелТитульный.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "item", "Э"));
				Для каждого УзелЭлемент Из УзлыЭлементы Цикл
					УзелИмяЭлемента = УзелЭлемент.Строки.Найти("name", "Имя");
					Если УзелИмяЭлемента <> Неопределено И ЗначениеЗаполнено(УзелИмяЭлемента.Значение) Тогда
						УзелЗначениеЭлемента = УзелЭлемент.Строки.Найти("value", "Имя");
						ЗначенияЭлементов.Вставить(УзелИмяЭлемента.Значение, ?(УзелЗначениеЭлемента <> Неопределено, XMLЗначение(Тип("Строка"), УзелЗначениеЭлемента.Значение), Неопределено));
					КонецЕсли;
				КонецЦикла;
				
				ЗначенияУведомлений = Новый Массив;
				УзелГруппа = УзелПротокол.Строки.Найти("group", "Имя");
				ЗаголовокГруппы = "";
				Если УзелГруппа <> Неопределено Тогда
					Для каждого УзелУведомление Из УзелГруппа.Строки Цикл
						СообщениеЭлемента = СокрЛП(XMLЗначение(Тип("Строка"), УзелУведомление.Значение));
						Если УзелУведомление.Тип <> "Э" Тогда
							Если УзелУведомление.Имя = "msg" Тогда
								ЗаголовокГруппы = СообщениеЭлемента;
							КонецЕсли;
							Продолжить;
						КонецЕсли;
						УзелСообщение = УзелУведомление.Строки.Найти("msg", "Имя");
						Если УзелСообщение <> Неопределено И ЗначениеЗаполнено(УзелСообщение.Значение) Тогда
							СообщениеЭлемента = " - " + СокрЛП(XMLЗначение(Тип("Строка"), УзелСообщение.Значение));
						КонецЕсли;
						ЗначенияУведомлений.Добавить(СообщениеЭлемента);
					КонецЦикла;
				КонецЕсли;
				
				КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
				ОтчетСдан = КонтекстЭДОСервер.ПротоколФСГСОтчетСданПоТексту(СтатусПротокола, СообщениеПротокола);
				
				// формируем текст протокола
				Если ОтчетСдан И НРег(СтатусПротокола) = "ok" Тогда
					ТекстПротокола = "ОТЧЕТ ПРИНЯТ УСПЕШНО." + Символы.ПС + Символы.ПС + "Уведомление о при~ме в обработку." + Символы.ПС + Символы.ПС;
				ИначеЕсли ОтчетСдан Тогда
					ТекстПротокола = "ОТЧЕТ ПРИНЯТ УСПЕШНО." + Символы.ПС + Символы.ПС + СообщениеПротокола + Символы.ПС + Символы.ПС;
				Иначе
					ТекстПротокола = СообщениеПротокола + Символы.ПС + Символы.ПС;
				КонецЕсли;
				
				Если ЗначенияЭлементов["dt_load"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Дата при~ма отч~та: " + СокрЛП(ЗначенияЭлементов["dt_load"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["obj"] <> Неопределено Тогда
					Если СокрЛП(ЗначенияЭлементов["ko"]) = СокрЛП(ЗначенияЭлементов["obj"]) Тогда
						ИдентификаторРеспондента = СокрЛП(ЗначенияЭлементов["obj"]);
					Иначе
						ИдентификаторРеспондента = СокрЛП(Строка(ЗначенияЭлементов["ko"]) + " " + ЗначенияЭлементов["obj"]);
					КонецЕсли;
					ТекстПротокола = ТекстПротокола + "Идентификатор респондента: " + ИдентификаторРеспондента + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["file"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Имя файла с отч~том: " + СокрЛП(ЗначенияЭлементов["file"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["dt_send"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Дата передачи файла: " + СокрЛП(ЗначенияЭлементов["dt_send"]) + Символы.ПС;
				КонецЕсли;
				
				ТекстПротокола = ТекстПротокола + Символы.ПС;
				
				Если ЗначенияЭлементов["form_name"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Форма отч~та: " + СокрЛП(ЗначенияЭлементов["form_name"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["form_code"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Код формы отч~та: " + СокрЛП(ЗначенияЭлементов["form_code"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["year"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Год отч~та: " + СокрЛП(ЗначенияЭлементов["year"]) + Символы.ПС;
				КонецЕсли;
				Если ЗначенияЭлементов["period"] <> Неопределено Тогда
					ТекстПротокола = ТекстПротокола + "Код периода отч~та: " + СокрЛП(ЗначенияЭлементов["period"]) + Символы.ПС;
				КонецЕсли;
				
				// выводим уведомления, для разъяснения причины отказа
				Если ЗначенияУведомлений.Количество() > 0 Тогда
					ТекстПротокола = ТекстПротокола + Символы.ПС + ЗаголовокГруппы + ":" + Символы.ПС;
					Для каждого Уведомление Из ЗначенияУведомлений Цикл
						ТекстПротокола = ТекстПротокола + Уведомление + Символы.ПС;
					КонецЦикла;
				КонецЕсли;
				
				ТекстПротокола = СтрЗаменить(СтрЗаменить(ТекстПротокола, "~", Символ(1105)), "&quot;", """");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакетОбработки("ФСГСПротокол");
	
	ОбластьМакета = Макет.ПолучитьОбласть("ПротоколШапка");
	ТабДокумент.Вывести(ОбластьМакета); // ПротоколШапка
	
	Для Инд = 1 По СтрЧислоСтрок(ТекстПротокола) Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ТекстПротокола");
		ОбластьМакета.Параметры.ТекстПротокола = СтрПолучитьСтроку(ТекстПротокола, Инд);
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
	
	Возврат ТабДокумент;
	
КонецФункции

// - Формирование печатной формы ПФР подтверждения о получении
&НаСервере
Функция СформироватьТабличныйДокументПФРНаОсновеПодтвержденияОПолучении(Заголовок, ИмяФайла, Тело, ЦиклОбмена)
	
	СвойстваИзПодтверждения = ПолучитьОсновныеСвойстваИзПодтвержденияОПолученииПФР(Тело);
	ДатыСообщений = ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПодтверждения) Тогда
		Если СвойстваИзПодтверждения.ОбщиеСведения.Свойство("ЭтоУОД") И СвойстваИзПодтверждения.ОбщиеСведения.ЭтоУОД Тогда
			Макет = ПолучитьМакетОбработки("ПФРУведомлениеОДоставке");
			
			ОбластьМакета = Макет.ПолучитьОбласть("УведомлениеОДоставке");
			ОбластьМакета.Параметры.РегистрационныйНомерОператора =
				СвойстваИзПодтверждения.ОбщиеСведения.РегистрационныйНомерОператора;
			ОбластьМакета.Параметры.НаименованиеОператора = СвойстваИзПодтверждения.ОбщиеСведения.НаименованиеОператора;
			ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПодтверждения.ОбщиеСведения.РегистрационныйНомер;
			ОбластьМакета.Параметры.Наименование =
				?(ЗначениеЗаполнено(СвойстваИзПодтверждения.ОбщиеСведения.НаименованиеОрганизации),
				СвойстваИзПодтверждения.ОбщиеСведения.НаименованиеОрганизации,
				СокрЛП(СвойстваИзПодтверждения.ОбщиеСведения.Фамилия + " " + СвойстваИзПодтверждения.ОбщиеСведения.Имя
				+ " " + СвойстваИзПодтверждения.ОбщиеСведения.Отчество));
			ОбластьМакета.Параметры.ИНН = СвойстваИзПодтверждения.ОбщиеСведения.ИНН;
			ОбластьМакета.Параметры.КПП = СвойстваИзПодтверждения.ОбщиеСведения.КПП;
			ОбластьМакета.Параметры.ИдентификаторДоставленногоПакета =
				СвойстваИзПодтверждения.ОбщиеСведения.ИдентификаторДоставленногоПакета;
			ОбластьМакета.Параметры.ДатаВремяДоставкиПакета =
				СвойстваИзПодтверждения.ОбщиеСведения.ДатаВремяДоставкиПакетаСтрокой;
			ОбластьМакета.Параметры.КаналПередачи = СвойстваИзПодтверждения.ОбщиеСведения.КаналПередачиСтрокой;
			
			ТабДокумент.Вывести(ОбластьМакета); // УведомлениеОДоставке
			
			ТипыСообщений = Новый Массив;
			ТипыСообщений.Добавить(Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР);
			
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			КонтекстЭДОСервер.ДобавитьШтампПодписиПодДокументом(
				ЦиклОбмена.Предмет,
				ТипыСообщений,
				ТабДокумент,
				2,
				Ложь);
			
		Иначе
			Макет = ПолучитьМакетОбработки("ПФРКвитанция");
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПодтверждениеШапка");
			ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПодтверждения.ОбщиеСведения.РегистрационныйНомер;
			ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
			ОбластьМакета.Параметры.ДатаОтправки = ДатыСообщений.ДатаОтправленоСтрахователем;
			ОбластьМакета.Параметры.ДатаПолучения = СвойстваИзПодтверждения.ОбщиеСведения.ДатаПолучения;
			ОбластьМакета.Параметры.ДатаПодтверждения = ДатыСообщений.ДатаПодтверждения;
			ОбластьМакета.Параметры.ОрганПФР = ЦиклОбмена.ВнешняяОрганизация;
			
			ТабДокумент.Вывести(ОбластьМакета); // ПодтверждениеШапка
			
			Для Каждого СтрокаИмяФайла Из СвойстваИзПодтверждения.ИмяФайла Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ПодтверждениеИмяФайла");
				ОбластьМакета.Параметры.ИмяФайла = СтрокаИмяФайла.ИмяФайла;
				ТабДокумент.Вывести(ОбластьМакета); //ПодтверждениеИмяФайла  
				
			КонецЦикла;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ТабДокумент.Вывести(ОбластьМакета); // ПодтверждениеПодвал
			
			СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
			
		КонецЕсли;
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

// - Формирование печатной формы ПФР протокол

&НаСервере
Функция СформироватьТабличныйДокументПФРНаОсновеПротокола(
		Заголовок,
		ИмяФайла,
		Тело,
		ЦиклОбмена,
		ТранспортноеСообщение = Неопределено)
	
	СвойстваИзПротокола = ПолучитьОсновныеСвойстваИзПротоколаПФР(Тело, ЦиклОбмена, ТранспортноеСообщение);
	ДатыСообщений = ПолучитьОсновныеСвойстваПФРИзЦиклаОбмена(ЦиклОбмена);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Если ЗначениеЗаполнено(СвойстваИзПротокола) Тогда
		Если СвойстваИзПротокола.ОбщиеСведения.Свойство("ЭтоУОРР") И СвойстваИзПротокола.ОбщиеСведения.ЭтоУОРР Тогда
			Макет = ПолучитьМакетОбработки("ПФРУведомлениеОРезультатеРассмотрения");
			
			ОбластьМакета = Макет.ПолучитьОбласть("УведомлениеОРезультатеРассмотрения");
			ОбластьМакета.Параметры.Наименование = СвойстваИзПротокола.ОбщиеСведения.НачалоНаименования;
			ОбластьМакета.Параметры.ОкончаниеНаименования = СвойстваИзПротокола.ОбщиеСведения.ОкончаниеНаименования;
			ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомер;
			ОбластьМакета.Параметры.НаименованиеДокумента = СвойстваИзПротокола.ОбщиеСведения.НаименованиеДокумента;
			ОбластьМакета.Параметры.РегистрационныйНомерОбращения =
				СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомерОбращения;
			ДатаРегистрацииОбращенияБезБуквыГода = Строка(СвойстваИзПротокола.ОбщиеСведения.ДеньРегистрацииОбращенияСтрокой)
				+ " " + Строка(СвойстваИзПротокола.ОбщиеСведения.МесяцРегистрацииОбращенияСтрокой)
				+ " " + Строка(СвойстваИзПротокола.ОбщиеСведения.ГодРегистрацииОбращенияСтрокой);
			ОбластьМакета.Параметры.ДатаРегистрацииОбращения = СокрЛП(ДатаРегистрацииОбращенияБезБуквыГода);
			ОбластьМакета.Параметры.РезультатРассмотренияУдовлетворено =
				?(СвойстваИзПротокола.ОбщиеСведения.РезультатРассмотрения = 1, "V", "");
			ОбластьМакета.Параметры.РезультатРассмотренияОтказВУдовлетворении = 
				?(СвойстваИзПротокола.ОбщиеСведения.РезультатРассмотрения = 2, "V", "");
			ОбластьМакета.Параметры.КодПричиныОтказа = СвойстваИзПротокола.ОбщиеСведения.КодПричиныОтказа;
			ОбластьМакета.Параметры.ПричинаОтказа = СвойстваИзПротокола.ОбщиеСведения.ПричинаОтказа;
			ОбластьМакета.Параметры.ДеньДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.ДеньОтправкиСтрокой;
			ОбластьМакета.Параметры.МесяцДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.МесяцОтправкиСтрокой;
			ОбластьМакета.Параметры.ГодДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.ГодОтправкиСтрокой;
			
			ТабДокумент.Вывести(ОбластьМакета); // УведомлениеОРезультатеРассмотрения
			
			ТипыСообщений = Новый Массив;
			ТипыСообщений.Добавить(Перечисления.ТипыТранспортныхСообщений.ПротоколПФР);
			
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			КонтекстЭДОСервер.ДобавитьШтампПодписиПодДокументом(
				ЦиклОбмена.Предмет,
				ТипыСообщений,
				ТабДокумент,
				2,
				Ложь);
			
		ИначеЕсли СвойстваИзПротокола.ОбщиеСведения.Свойство("ЭтоУОНД") И СвойстваИзПротокола.ОбщиеСведения.ЭтоУОНД Тогда
			Макет = ПолучитьМакетОбработки("ПФРУведомлениеОНевозможностиДоставки");
			
			ОбластьМакета = Макет.ПолучитьОбласть("УведомлениеОНевозможностиДоставки");
			ОбластьМакета.Параметры.Наименование = СвойстваИзПротокола.ОбщиеСведения.НачалоНаименования;
			ОбластьМакета.Параметры.ОкончаниеНаименования = СвойстваИзПротокола.ОбщиеСведения.ОкончаниеНаименования;
			ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомер;
			ОбластьМакета.Параметры.НаименованиеДокумента = СвойстваИзПротокола.ОбщиеСведения.НаименованиеДокумента;
			ОбластьМакета.Параметры.КодДокумента = СвойстваИзПротокола.ОбщиеСведения.КодДокумента;
			ОбластьМакета.Параметры.ВОтветНа = СвойстваИзПротокола.ОбщиеСведения.ВОтветНа;
			ОбластьМакета.Параметры.РегистрационныйНомерОбращения =
				СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомерОбращения;
			ОбластьМакета.Параметры.Причина = СвойстваИзПротокола.ОбщиеСведения.Причина;
			ОбластьМакета.Параметры.Комментарий = СвойстваИзПротокола.ОбщиеСведения.Комментарий;
			ОбластьМакета.Параметры.ДеньДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.ДеньОтправкиСтрокой;
			ОбластьМакета.Параметры.МесяцДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.МесяцОтправкиСтрокой;
			ОбластьМакета.Параметры.ГодДатыИВремени = СвойстваИзПротокола.ОбщиеСведения.ГодОтправкиСтрокой;
			
			ТабДокумент.Вывести(ОбластьМакета); // УведомлениеОНевозможностиДоставки
			
			ТипыСообщений = Новый Массив;
			ТипыСообщений.Добавить(Перечисления.ТипыТранспортныхСообщений.ПротоколПФР);
			
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			КонтекстЭДОСервер.ДобавитьШтампПодписиПодДокументом(
				ЦиклОбмена.Предмет,
				ТипыСообщений,
				ТабДокумент,
				2,
				Ложь);
			
		Иначе
			ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
				ЦиклОбмена.Предмет,,
				ЦиклОбмена.ДатаСоздания,
				ЦиклОбмена.Вид,
				ЦиклОбмена.Тип);
			
			Если ЭтоОтправкаВСФР Тогда
				Макет = ПолучитьМакетОбработки("СФРПротокол");
			Иначе
				Макет = ПолучитьМакетОбработки("ПФРПротокол");
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПротоколШапка");
			ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзПротокола.ОбщиеСведения.РегистрационныйНомер;
			ОбластьМакета.Параметры.Наименование = ЦиклОбмена.Организация;
			ОбластьМакета.Параметры.ДатаОтправки = ДатыСообщений.ДатаОтправленоСтрахователем;
			ОбластьМакета.Параметры.ДатаПолучения = СвойстваИзПротокола.ОбщиеСведения.ДатаПолучения;
			ОбластьМакета.Параметры.ДатаПодтверждения = ДатыСообщений.ДатаПодтверждения;
			ОбластьМакета.Параметры.ДатаПротокола = ДатыСообщений.ДатаПротокола;
			
			ОбластьМакета.Параметры.ОрганПФР = ЦиклОбмена.ВнешняяОрганизация;
			
			ТабДокумент.Вывести(ОбластьМакета); // ПротоколШапка
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПротоколПачки");
			ТабДокумент.Вывести(ОбластьМакета); // ПротоколПачки
			
			Для Каждого СтрокаИмяФайла Из СвойстваИзПротокола.ИмяФайла Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ПротоколИмяПачек");
				ОбластьМакета.Параметры.ИмяФайла = СтрокаИмяФайла.ИмяФайла;
				ТабДокумент.Вывести(ОбластьМакета); //ПротоколИмяПачек
				
			КонецЦикла;
			
			ОбластьМакета = Макет.ПолучитьОбласть("ПротоколРезультат");
			Если СвойстваИзПротокола.ОбщиеСведения.ЯвляетсяПоложительным Тогда
				Если СвойстваИзПротокола.ОбщиеСведения.Свойство("СданЧастично") И СвойстваИзПротокола.ОбщиеСведения.СданЧастично Тогда
					РешениеПФР = "ПРИНЯТО К ОБРАБОТКЕ ЧАСТИЧНО";
				Иначе
					РешениеПФР = "ПРИНЯТО К ОБРАБОТКЕ";
				КонецЕсли;
			Иначе 
				РешениеПФР = "НЕ ПРИНЯТО К ОБРАБОТКЕ";
			КонецЕсли;
			ОбластьМакета.Параметры.РешениеПФР = РешениеПФР;
			ТабДокумент.Вывести(ОбластьМакета); // ПротоколРезультат
			
			Для Каждого СтрокаИмяФайла Из СвойстваИзПротокола.Вложения Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть("ПротоколПриложения");
				ОбластьМакета.Параметры.ИмяПриложения = СтрокаИмяФайла.ИмяВложения;
				ТабДокумент.Вывести(ОбластьМакета); //ПротоколПриложения
				
			КонецЦикла;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ТабДокумент.Вывести(ОбластьМакета); // ПротоколПодвал
			
			СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
			
			ТипыСообщений = Новый Массив;
			ТипыСообщений.Добавить(Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР);
			ТипыСообщений.Добавить(Перечисления.ТипыТранспортныхСообщений.ПротоколПФР);
			
			КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
			КонтекстЭДОСервер.ДобавитьШтампПодписиПодДокументом(
				ЦиклОбмена.Предмет,
				ТипыСообщений,
				ТабДокумент,
				2,
				Ложь);
		КонецЕсли;
		
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДокумент.АвтоМасштаб = Истина;
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТООБОРОТ С ФСС

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправки(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки = Неопределено) Экспорт
	
	Если ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФСС") Тогда
		ОбновитьРезультатКонкретнойОтправкиФСС(ОтправкаСсылка, Истина, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФСРАР") Тогда
		ОбновитьРезультатКонкретнойОтправкиФСРАР(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиРПН") Тогда
		ОбновитьРезультатКонкретнойОтправкиРПН(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.ОтправкиФТС") Тогда
		Если ПараметрыОбновленияОтправки.Свойство("ЭтоДоверенностьФТС")
			И ПараметрыОбновленияОтправки.ЭтоДоверенностьФТС Тогда
			
			ОбновитьМашиночитаемуюДоверенностьФТС(
				ВыполняемоеОповещение,
				ПараметрыОбновленияОтправки.Организация,,,
				ОтправкаСсылка);
			
		Иначе
			ОбновитьРезультатКонкретнойОтправкиФТС(Форма, ОтправкаСсылка, ВыполняемоеОповещение, ПараметрыОбновленияОтправки);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОтправкаСсылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр") Тогда
		ДокументооборотСКОКлиент.ОбновитьСостояниеМЧДРР(ВыполняемоеОповещение, ОтправкаСсылка);
		
	ИначеЕсли ТипЗнч(ПараметрыОбновленияОтправки) = Тип("Структура") И ПараметрыОбновленияОтправки.Свойство("ЭтоСЭДО")
		И ПараметрыОбновленияОтправки.ЭтоСЭДО Тогда
		
		Организации = ?(ПараметрыОбновленияОтправки.Свойство("Организация")
			И ЗначениеЗаполнено(ПараметрыОбновленияОтправки.Организация),
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОбновленияОтправки.Организация),
			Неопределено);
		ТипВзаимодействия = ?(ПараметрыОбновленияОтправки.Свойство("ТипВзаимодействия"),
			ПараметрыОбновленияОтправки.ТипВзаимодействия, Неопределено);
		ПолучитьВходящиеСообщенияСЭДОФСС(
			ВыполняемоеОповещение,
			Организации,,,
			ТипВзаимодействия);
		
	ИначеЕсли ТипЗнч(ПараметрыОбновленияОтправки) = Тип("Структура") И ПараметрыОбновленияОтправки.Свойство("ЭтоЗагрузкаДоверенности")
		И ПараметрыОбновленияОтправки.ЭтоЗагрузкаДоверенности Тогда
		
		ДокументооборотСКОКлиент.ПолучитьДанныеМЧДРРПолучениеПолныхДанных(ПараметрыОбновленияОтправки.Ключ);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФСС(
		ОтправкаСсылка,
		ТихийРежим,
		ВыполняемоеОповещение,
		ИспользоватьКеширование = Ложь,
		НомерОбъекта = Неопределено) Экспорт
	
	ИнформацияПоОтправке = ИнформацияПоОтправкеФСС(ОтправкаСсылка);
	
	ВыполнитьОбменСЭДО = ОбменСЭДОФССВремяИстекло(
		ИнформацияПоОтправке.ОрганизацияСсылка,
		ИнформацияПоОтправке.ОтправкаЧерезСЭДО,
		ИспользоватьКеширование,,
		ИнформацияПоОтправке.ТипВзаимодействия);
	
	Если ИнформацияПоОтправке.ОтправкаЧерезСЭДО И ЗначениеЗаполнено(ИнформацияПоОтправке.ОрганизацияСсылка) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОтправкаСсылка", 			ОтправкаСсылка);
		ДополнительныеПараметры.Вставить("ТихийРежим", 				ТихийРежим);
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ИспользоватьКеширование", ИспользоватьКеширование);
		ДополнительныеПараметры.Вставить("ИнформацияПоОтправке", 	ИнформацияПоОтправке);
		
		ДополнитьСтруктуруПараметровПолученияСообщений(
			ДополнительныеПараметры,
			ВыполняемоеОповещение.ДополнительныеПараметры,
			ОтправкаСсылка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ОбновитьРезультатКонкретнойОтправкиФССПослеОбменаСЭДО",
			ЭтотОбъект,
			ДополнительныеПараметры);
		Если ВыполнитьОбменСЭДО Тогда
			МассивОрганизаций = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИнформацияПоОтправке.ОрганизацияСсылка);
			
			ПолучитьВходящиеСообщенияСЭДОФСС(
				ОписаниеОповещения,
				МассивОрганизаций,
				ТихийРежим,
				Ложь,
				ИнформацияПоОтправке.ТипВзаимодействия,
				ДополнительныеПараметры.ТипСообщенияОтвета);
			
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ТихийРежим Тогда
		Если ДокументооборотСКОКлиент.ИспользуетсяРежимТестирования() Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ОтправкаСсылка", 			ОтправкаСсылка);
			ДополнительныеПараметры.Вставить("ИнформацияПоОтправке", 	ИнформацияПоОтправке);
			ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВыполняемоеОповещение);
			ДополнительныеПараметры.Вставить("НомерОбъекта", 			НомерОбъекта);
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьРезультатКонкретнойОтправкиФССЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПродолжитьОтправкуНаТестовыйСерверФСС(ОписаниеОповещения)
		Иначе
			ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(
				ОтправкаСсылка,
				ИнформацияПоОтправке,
				ВыполняемоеОповещение,
				НомерОбъекта);
		КонецЕсли;
	Иначе
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение,
			НомерОбъекта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОбменСЭДОФССВремяИстекло(
		ОрганизацияСсылка,
		ОтправкаЧерезСЭДО,
		ИспользоватьКеширование = Ложь,
		ПринудительноОбновитьКеш = Ложь,
		ТипВзаимодействия = Неопределено)
	
	Результат = Истина;
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	СтрокаТипаВзаимодействия = Формат(ТипВзаимодействия, "ЧДЦ=; ЧН=; ЧГ=");
	
	Если НЕ ИспользоватьКеширование И ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		ДатыПолученияВходящихСообщенийСЭДОФСС = ПараметрыПриложения["БРО.ДатыПолученияВходящихСообщенийСЭДОФСС"
			+ СтрокаТипаВзаимодействия];
		Если ДатыПолученияВходящихСообщенийСЭДОФСС = Неопределено Тогда
			ДатыПолученияВходящихСообщенийСЭДОФСС = Новый Соответствие;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатыПолученияВходящихСообщенийСЭДОФСС[ОрганизацияСсылка]) Тогда
			ДатыПолученияВходящихСообщенийСЭДОФСС.Вставить(ОрганизацияСсылка, Неопределено);
			ПараметрыПриложения["БРО.ДатыПолученияВходящихСообщенийСЭДОФСС" + СтрокаТипаВзаимодействия] =
				ДатыПолученияВходящихСообщенийСЭДОФСС;
		КонецЕсли;
	КонецЕсли;
	
	Если ОтправкаЧерезСЭДО И ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		ДатыПолученияВходящихСообщенийСЭДОФСС = ПараметрыПриложения["БРО.ДатыПолученияВходящихСообщенийСЭДОФСС"
			+ СтрокаТипаВзаимодействия];
		Если ДатыПолученияВходящихСообщенийСЭДОФСС = Неопределено Тогда
			ДатыПолученияВходящихСообщенийСЭДОФСС = Новый Соответствие;
		КонецЕсли;
		ДатаПолучения = ДатыПолученияВходящихСообщенийСЭДОФСС[ОрганизацияСсылка];
		ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
		
		Если ЗначениеЗаполнено(ДатаПолучения) И ДатаСеанса < ДатаПолучения + 10 * 60 И ДатаСеанса >= ДатаПолучения Тогда
			Результат = Ложь;
		КонецЕсли;
		
		Если Результат ИЛИ ПринудительноОбновитьКеш Тогда
			ДатыПолученияВходящихСообщенийСЭДОФСС.Вставить(ОрганизацияСсылка, ДатаСеанса);
			ПараметрыПриложения["БРО.ДатыПолученияВходящихСообщенийСЭДОФСС" + СтрокаТипаВзаимодействия] =
				ДатыПолученияВходящихСообщенийСЭДОФСС;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССПослеОбменаСЭДО(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.Свойство("ОшибкиПоОрганизациям") Тогда
		Для каждого ОшибкиПоОрганизации Из Результат.ОшибкиПоОрганизациям Цикл
			Если ЗначениеЗаполнено(ОшибкиПоОрганизации.Значение) Тогда
				ТекстОшибки = Строка(ОшибкиПоОрганизации.Ключ) + ": "
					+ СтрСоединить(ОшибкиПоОрганизации.Значение, Символы.ВК + Символы.ПС);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОтправкаСсылка 			= ДополнительныеПараметры.ОтправкаСсылка;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ИнформацияПоОтправке 	= ДополнительныеПараметры.ИнформацияПоОтправке;
	
	ПараметрыПротокола = Новый Структура;
	ПараметрыПротокола.Вставить("ТолькоПолучитьОтправкуСЭДО", Истина);
	РезультатСохранения = СохранитьПротоколПриОперацииСОКВЭДИлиПолучитьОтправкуСЭДОНаСервере(
		ОтправкаСсылка,
		Неопределено,
		Неопределено,
		ПараметрыПротокола);
	
	ПринудительноОбновитьКеш = Истина;
	ОбменСЭДОФССВремяИстекло(
		ИнформацияПоОтправке.ОрганизацияСсылка,
		Истина,
		Истина,
		ПринудительноОбновитьКеш,
		ИнформацияПоОтправке.ТипВзаимодействия);
	
	Результат = Неопределено;
	Если РезультатСохранения <> Неопределено И РезультатСохранения.Рассматривается Тогда
		Результат = Новый Структура("Рассматривается", Истина);
	КонецЕсли;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОтправкаСсылка 			= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 	= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	НомерОбъекта 			= ДополнительныеПараметры.НомерОбъекта;
	Если Результат Тогда
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение,
			НомерОбъекта);
		
	Иначе
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиенте(
		ОтправкаСсылка,
		ИнформацияПоОтправке,
		ВыполняемоеОповещение,
		НомерОбъекта = Неопределено)
	
	ПолученРезультатОтСервераФСС = Ложь;
	ПовторятьСоединение = Истина;
	
	ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
		ПовторятьСоединение,
		ПолученРезультатОтСервераФСС,
		ОтправкаСсылка,
		ИнформацияПоОтправке,
		ВыполняемоеОповещение,,
		НомерОбъекта);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнформацияПоОтправкеФСС(ОтправкаСсылка, ИспользоватьКеширование = Ложь)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.ИнформацияПоОтправкеФСС(ОтправкаСсылка, ИспользоватьКеширование);
	
КонецФункции

// Процедура с рекурсивным вызовом заменяет цикл (+ завершение из настройки доступа к интернету)
&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
		ПовторятьСоединение,
		ПолученРезультатОтСервераФСС,
		ОтправкаСсылка,
		ИнформацияПоОтправке,
		ВыполняемоеОповещение,
		НомерПопытки = 1,
		НомерОбъекта = Неопределено)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПовторятьСоединение", 			ПовторятьСоединение);
	ДополнительныеПараметры.Вставить("ПолученРезультатОтСервераФСС", 	ПолученРезультатОтСервераФСС);
	ДополнительныеПараметры.Вставить("ОтправкаСсылка", 					ОтправкаСсылка);
	ДополнительныеПараметры.Вставить("ИнформацияПоОтправке", 			ИнформацияПоОтправке);
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 			ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("НомерПопытки", 					НомерПопытки);
	ДополнительныеПараметры.Вставить("НомерОбъекта", 					НомерОбъекта);
	
	Если НомерОбъекта <> Неопределено И НомерПопытки = 1 И НомерОбъекта % 10 = 0
		ИЛИ НомерПопытки % 10 = 0 Тогда
		
		// для предотвращения переполнения стека
		ДлительнаяОтправкаКлиент.ЗапомнитьКонтекстДлительнойОперации(ДополнительныеПараметры,
			"БРО.ВходящийКонтекстОбновитьРезультатКонкретнойОтправкиФСС");
		ПодключитьОбработчикОжидания("Подключаемый_СбросСтекаОбновитьРезультатКонкретнойОтправкиФССВЦикле", 0.1, Истина);
	Иначе
		СбросСтекаОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СбросСтекаОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(ДополнительныеПараметры)
	
	ПовторятьСоединение 			= ДополнительныеПараметры.ПовторятьСоединение;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеПодписанияИЗашифрования",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ЭтоДанныеЭЛН = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	
	Если ЭтоДанныеЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		Возврат;
	КонецЕсли;
	
	Если ПовторятьСоединение И ЭтоПодтверждениеВидаДеятельности Тогда
		// значение загружено только для подтверждения вида деятельности
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ИнформацияПоОтправке);
		
		ИнформацияДляЗапроса = ИнформацияДляЗапросаОперацииСОКВЭДВФСС(ИнформацияПоОтправке.ИдентификаторОтправкиНаСервере);
		ТекстЗапросаРезультатов = СтрШаблон(
			"<getResultByIdRequest xmlns=""http://ws.fss.ru/services/okvedconfirm"""
			+ " xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
				+ "<systemInfo xmlns="""">"
					+ "<specVersion>1.0</specVersion>"
					+ "<software>%1</software>"
					+ "<softwareVersion>%2</softwareVersion>"
				+ "</systemInfo>"
				+ "<requestId xmlns="""">%3</requestId>"
			+ "</getResultByIdRequest>",
			ИнформацияДляЗапроса.НазваниеПрограммыВHTML,
			ИнформацияДляЗапроса.ВерсияПрограммыВHTML,
			ИнформацияДляЗапроса.ИдентификаторОтправкиВHTML);
		
		ВыгрузкаЗапросаОперации = Новый Структура;
		ВыгрузкаЗапросаОперации.Вставить("Организация", 			ИнформацияПоОтправке.ОрганизацияСсылка);
		ВыгрузкаЗапросаОперации.Вставить("РегистрационныйНомерФСС", Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ОГРН", 					Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ТекстЗапроса", 			ТекстЗапросаРезультатов);
		
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("ПроверкиИАвтонастройкаВыполнены", 		Ложь);
		НастройкиОперации.Вставить("СертификатСтрахователя", 				Неопределено);
		НастройкиОперации.Вставить("СертификатФСС", 						Неопределено);
		НастройкиОперации.Вставить("МЧД", 									"");
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НастройкиОперации);
		
		АдресПодписанногоSOAPОперацииСОКВЭДВФСС(
			ОписаниеОповещения,
			ВыгрузкаЗапросаОперации,
			НастройкиОперации);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СбросСтекаОбновитьРезультатКонкретнойОтправкиФССВЦикле() Экспорт
	
	ВходящийКонтекст = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации(
		"БРО.ВходящийКонтекстОбновитьРезультатКонкретнойОтправкиФСС");
	
	СбросСтекаОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеПодписанияИЗашифрования(
		АдресЗашифрованногоЗапросаSOAP,
		ДополнительныеПараметры) Экспорт
	
	ПовторятьСоединение 			= ДополнительныеПараметры.ПовторятьСоединение;
	ПолученРезультатОтСервераФСС 	= ДополнительныеПараметры.ПолученРезультатОтСервераФСС;
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	НомерПопытки 					= ДополнительныеПараметры.НомерПопытки;
	
	ЭтоДанныеЭЛН = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ИнформацияПоОтправке.ТипДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ИнформацияПоОтправке.ВидОтчета =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	
	Если ПовторятьСоединение И ЭтоПодтверждениеВидаДеятельности И АдресЗашифрованногоЗапросаSOAP = Неопределено
		ИЛИ ЭтоДанныеЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		
		Если НЕ ЭтоДанныеЭЛН И НЕ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось зашифровать запрос результатов';
																|en = 'Не удалось зашифровать запрос результатов'"));
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	НастройкиССервера = Неопределено;
	Если ПовторятьСоединение Тогда
		
		//при успешном обращении на сервер ФСС отправка обновится в ИБ
		АдресЗашифрованногоОтветаSOAP = Неопределено;
		ОбновитьРезультатКонкретнойОтправкиФСССНаСервере(
			ОтправкаСсылка,
			ПолученРезультатОтСервераФСС,
			НастройкиССервера,
			АдресЗашифрованногоЗапросаSOAP,
			АдресЗашифрованногоОтветаSOAP);
		
		Если НЕ ПолученРезультатОтСервераФСС И НастройкиССервера <> Неопределено Тогда
			// возможно, проблемы с доступом в интернет
			ДополнительныеПараметры.ПолученРезультатОтСервераФСС = ПолученРезультатОтСервераФСС;
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеЗавершение",
				ЭтотОбъект,
				ДополнительныеПараметры);
			
			Если НастройкиССервера.РазделениеВключено Тогда
				ПовторитьПопытку = (НомерПопытки < 5);
				Если НЕ ПовторитьПопытку Тогда
					ТекстСообщения = СтрШаблон(
						НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1). Возможно, сервер перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.';
							|en = 'Не удалось обратиться к серверу ФСС РФ (http://%1). Возможно, сервер перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.'"),
						НастройкиССервера.АдресСервера,
						НастройкиССервера.ПредставлениеОтчетаОшибки);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				КонецЕсли;
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, ПовторитьПопытку);
				
			Иначе
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось обратиться к серверу ФСС РФ (http://%1)';
						|en = 'Не удалось обратиться к серверу ФСС РФ (http://%1)'"),
					НастройкиССервера.АдресСервера);
					
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПоказатьДиалогОшибкиДоступаВИнтернет(
					ТекстСообщения,
					ОписаниеОповещения);
			КонецЕсли;
			Возврат;
			
		Иначе
			ПовторятьСоединение = Ложь;
			
			Если ЭтоПодтверждениеВидаДеятельности И АдресЗашифрованногоОтветаSOAP <> Неопределено Тогда
				ДополнительныеПараметры.Вставить("АдресЗашифрованногоОтветаSOAP", АдресЗашифрованногоОтветаSOAP);
				
				ОписаниеОповещения = Новый ОписаниеОповещения(
					"ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеРасшифрованияИПроверкиПодписи",
					ЭтотОбъект, ДополнительныеПараметры);
				
				ЗаписыватьОшибкиВЖурналРегистрации 	= Истина;
				ПроверитьПодписьSOAPОтветаЭЛНВФСС(
					ОписаниеОповещения,
					ИнформацияПоОтправке.ОрганизацияСсылка,
					АдресЗашифрованногоОтветаSOAP,,
					ЗаписыватьОшибкиВЖурналРегистрации,
					?(ЭтоПодтверждениеВидаДеятельности, "ПодтверждениеВидаДеятельности", ""));
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
			ПовторятьСоединение,
			ПолученРезультатОтСервераФСС,
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнформацияДляЗапросаОперацииСОКВЭДВФСС(ИдентификаторОтправки)
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияПрограммыВHTML", 			"");
	Результат.Вставить("НазваниеПрограммыВHTML", 		"");
	Результат.Вставить("ИдентификаторОтправкиВHTML", 	"");
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	Результат.ВерсияПрограммыВHTML 			= РегламентированнаяОтчетность.ВерсияПрограммы();
	Результат.ВерсияПрограммыВHTML 			= Лев(Результат.ВерсияПрограммыВHTML, 20);
	Результат.ВерсияПрограммыВHTML 			= КонтекстЭДО.ТекстВHTML(Результат.ВерсияПрограммыВHTML);
	Результат.НазваниеПрограммыВHTML 		= РегламентированнаяОтчетность.НазваниеПрограммы();
	Результат.НазваниеПрограммыВHTML 		= Лев(Результат.НазваниеПрограммыВHTML, 50);
	Результат.НазваниеПрограммыВHTML 		= КонтекстЭДО.ТекстВHTML(Результат.НазваниеПрограммыВHTML);
	Результат.ИдентификаторОтправкиВHTML 	= КонтекстЭДО.ТекстВHTML(ИдентификаторОтправки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеПослеРасшифрованияИПроверкиПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресЗашифрованногоОтветаSOAP 	= ДополнительныеПараметры.АдресЗашифрованногоОтветаSOAP;
	
	Если Результат = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Ошибка при расшифровке протокола ФСС.';
							|en = 'Ошибка при расшифровке протокола ФСС.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение);
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.ПодписьВалидна Тогда
		// Записываем сообщение, но продолжаем обмен (данные-то мы получили).
		ТекстОшибки = НСтр("ru = 'Подпись протокола недействительна.';
							|en = 'Подпись протокола недействительна.'");
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Подтверждение вида деятельности ФСС';
				|en = 'Электронный документооборот с контролирующими органами. Подтверждение вида деятельности ФСС'"),
			"Ошибка",
			ТекстОшибки,,
			Истина);
	КонецЕсли;
	
	ПараметрыПротокола = Новый Структура;
	ПараметрыПротокола.Вставить("АдресРасшифрованногоОтветаSOAP", 	Результат.АдресРасшифрованногоОтветаSOAP);
	ПараметрыПротокола.Вставить("АдресЗашифрованногоОтветаSOAP", 	АдресЗашифрованногоОтветаSOAP);
	ПараметрыПротокола.Вставить("ИдентификаторОтправкиНаСервере", 	ИнформацияПоОтправке.ИдентификаторОтправкиНаСервере);
	РезультатСохранения = СохранитьПротоколПриОперацииСОКВЭДИлиПолучитьОтправкуСЭДОНаСервере(
		ОтправкаСсылка,
		ИнформацияПоОтправке.ОтчетСсылка,
		ИнформацияПоОтправке.ОрганизацияСсылка,
		ПараметрыПротокола);
	
	Результат = Неопределено;
	Если РезультатСохранения.Рассматривается Тогда
		Результат = Новый Структура("Рассматривается", Истина);
	КонецЕсли;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦиклеЗавершение(РезультатДиалогаОбОшибкеДоступа, ДополнительныеПараметры) Экспорт
	
	ПолученРезультатОтСервераФСС 	= ДополнительныеПараметры.ПолученРезультатОтСервераФСС;
	ОтправкаСсылка 					= ДополнительныеПараметры.ОтправкаСсылка;
	ИнформацияПоОтправке 			= ДополнительныеПараметры.ИнформацияПоОтправке;
	ВыполняемоеОповещение 			= ДополнительныеПараметры.ВыполняемоеОповещение;
	НомерПопытки 					= ДополнительныеПараметры.НомерПопытки;
	
	ПовторятьСоединение = (РезультатДиалогаОбОшибкеДоступа = Истина);
	
	Если ПовторятьСоединение Тогда
		ОбновитьРезультатКонкретнойОтправкиФССНаКлиентеОтправкаВЦикле(
			ПовторятьСоединение,
			ПолученРезультатОтСервераФСС,
			ОтправкаСсылка,
			ИнформацияПоОтправке,
			ВыполняемоеОповещение,
			НомерПопытки + 1);
	Иначе
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НетДоступаВИнтернет", Истина);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ФСС. Нет доступа в Интернет.
		
	КонецЕсли;
			
КонецПроцедуры
// Процедура с рекурсивным вызовом заменяет цикл (+ завершение из настройки доступа к интернету)

&НаКлиенте
Процедура ОткрытьПротоколОтправкиФСС(Форма) Экспорт
	
	ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	
	Если ОтчетСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФСС(
		МестоХраненияКлюча,
		ОрганизацияСсылка,
		ВыполняемоеОповещение,
		ПолучатьСертификатФССЭЛН = Ложь)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФССНаСервере(ОрганизацияСсылка);
	
	Если ОтпечаткиСертификатов = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
		СертификатФСС = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(?(ПолучатьСертификатФССЭЛН,
			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток, ОтпечаткиСертификатов.СертификатФССОтпечаток));
		Результат = Новый Структура("СертификатСтрахователя, СертификатФСС, МЧД",
			СертификатСтрахователя, СертификатФСС, ОтпечаткиСертификатов.МЧД);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		СертификатСтрахователя = ПолучитьСвойстваОблачногоСертификата(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY");
		СертификатФСС = ПолучитьСвойстваОблачногоСертификата(?(ПолучатьСертификатФССЭЛН,
			ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток, ОтпечаткиСертификатов.СертификатФССОтпечаток));
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатФСС);
		Результат = Новый Структура("СертификатСтрахователя, СертификатФСС, МЧД",
			СертификатСтрахователя, СертификатФСС, ОтпечаткиСертификатов.МЧД);
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	Иначе
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 		ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ОтпечаткиСертификатов", 		ОтпечаткиСертификатов);
		ДополнительныеПараметры.Вставить("ПолучатьСертификатФССЭЛН", 	ПолучатьСертификатФССЭЛН);
		Оповещение = Новый ОписаниеОповещения("ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаСтрахователяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток, "MY", , Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаСтрахователяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 		= ДополнительныеПараметры.ВыполняемоеОповещение;
	ОтпечаткиСертификатов 		= ДополнительныеПараметры.ОтпечаткиСертификатов;
	ПолучатьСертификатФССЭЛН 	= ДополнительныеПараметры.ПолучатьСертификатФССЭЛН;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, СертификатСтрахователя, МЧД",
		ВыполняемоеОповещение, СертификатСтрахователя, ОтпечаткиСертификатов.МЧД);
	Оповещение = Новый ОписаниеОповещения("ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаФССЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(
		Оповещение,
		?(ПолучатьСертификатФССЭЛН, ОтпечаткиСертификатов.СертификатФССЭЛНОтпечаток, ОтпечаткиСертификатов.СертификатФССОтпечаток),
		"AddressBook",,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФССПослеПоискаСертификатаФССЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатСтрахователя = ДополнительныеПараметры.СертификатСтрахователя;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	СертификатФСС = ?(Результат.СертификатНайден, Результат.СвойстваСертификата, Неопределено);
	
	Результат = Новый Структура("СертификатСтрахователя, СертификатФСС, МЧД",
		СертификатСтрахователя, СертификатФСС, ДополнительныеПараметры.МЧД);
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СертификатыГодятсяДляПодписанияОтчетностиФСС(Сертификаты)
	
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДО.СертификатыГодятсяДляПодписанияОтчетностиФСС(Сертификаты);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияСертификатовЗавершение(ПараметрыФормированияПакета, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	Идентификатор 						= ДополнительныеПараметры.Идентификатор;
	ТекстФайлаВыгрузки 					= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки 					= ДополнительныеПараметры.ИмяФайлаВыгрузки;
	РасширениеСТочкой 					= ДополнительныеПараметры.РасширениеСТочкой;
	РегистрационныйНомерФСС 			= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	
	Если ПараметрыФормированияПакета = Неопределено Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя 	= ПараметрыФормированияПакета.СертификатСтрахователя;
	СертификатФСС 			= ПараметрыФормированияПакета.СертификатФСС;
	МЧД 					= ПараметрыФормированияПакета.МЧД;
	Если ВыполняемоеОповещение <> Неопределено
		И ТипЗнч(ВыполняемоеОповещение.ДополнительныеПараметры) = Тип("Структура") Тогда
		
		ВыполняемоеОповещение.ДополнительныеПараметры.Вставить("МЧД", МЧД);
	КонецЕсли;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, "Сертификат страхователя");
	СертификатыОбмена.Добавить(СертификатФСС, "Сертификат ФСС");
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Сертификаты не подходят для подписания.';
				|en = 'Сертификаты не подходят для подписания.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СертификатСтрахователя = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить сертификат.';
				|en = 'Не удалось определить сертификат.'"));
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатСтрахователя);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 					ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 					ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 					РасширениеСТочкой);
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", 			РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	ДополнительныеПараметры.Вставить("СертификатФСС", 						СертификатФСС);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("АдресДанныхВыгрузки", 				Неопределено);
	ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоПодписьИШифрованиеSOAP Тогда

		ДополнительныеПараметры.Вставить("ВременныйКаталог", "");
		ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
		
		Если НЕ ЭтоПодписьИШифрованиеSOAP Тогда
			Адрес = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, Форма.УникальныйИдентификатор,, Истина);
			ДополнительныеПараметры.Вставить("АдресДанныхВыгрузки", Адрес);
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено", Истина));
		Возврат;
	КонецЕсли;
	
	//Получим имя временного файла
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузитьПакетДляОтправкиВФССПослеПолученияВременногоКаталогаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ОперацииСФайламиЭДКОКлиент.КаталогВременныхФайловНаКлиенте(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияВременногоКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 	= ДополнительныеПараметры.ВыполняемоеОповещение;
	ТекстФайлаВыгрузки 		= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки 		= ДополнительныеПараметры.ИмяФайлаВыгрузки;
	РасширениеСТочкой 		= ДополнительныеПараметры.РасширениеСТочкой;
	СертификатСтрахователя 	= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФСС 			= ДополнительныеПараметры.СертификатФСС;
	ОповещениеОЗавершении 	= ДополнительныеПараметры.ОповещениеОЗавершении;
	
	Если НЕ Результат.Выполнено Тогда
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ПолноеИмяФайлаВыгрузки = ВременныйКаталог + ИмяФайлаВыгрузки;
	
	ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", ПолноеИмяФайлаВыгрузки);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ОперацииСФайламиЭДКОКлиент.ТекстВФайл(Оповещение, ТекстФайлаВыгрузки, ПолноеИмяФайлаВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ТекстФайлаВыгрузки 					= ДополнительныеПараметры.ТекстФайлаВыгрузки;
	ВременныйКаталог 					= ДополнительныеПараметры.ВременныйКаталог;
	ПолноеИмяФайлаВыгрузки 				= ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	РасширениеСТочкой 					= ДополнительныеПараметры.РасширениеСТочкой;
	РегистрационныйНомерФСС 			= ДополнительныеПараметры.РегистрационныйНомерФСС;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	СертификатСтрахователя 				= ДополнительныеПараметры.СертификатСтрахователя;
	СертификатФСС 						= ДополнительныеПараметры.СертификатФСС;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	АдресДанныхВыгрузки 				= ДополнительныеПараметры.АдресДанныхВыгрузки;
	МЧД 								= ДополнительныеПараметры.МЧД;
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	
	ПараметрыФорматаЭЛН = ?(ДополнительныеПараметры.Свойство("ПараметрыФорматаЭЛН"),
		ДополнительныеПараметры.ПараметрыФорматаЭЛН, Неопределено);
	
	Если НЕ Результат.Выполнено Тогда
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	
	// подписываем и шифруем
	ДлительнаяОтправкаКлиент.ВывестиСостояние(НСтр("ru = 'Подписание и шифрование файла выгрузки ...';
													|en = 'Подписание и шифрование файла выгрузки ...'")); // ФСС
	КороткоеИмяЗашифрованногоПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
		ПолноеИмяФайлаВыгрузки).ИмяБезРасширения
		+ ?((ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам)
		И нрег(РасширениеСТочкой) = ".xml",
		"_" + Строка(Новый УникальныйИдентификатор), "") + РасширениеСТочкой;
	ЗашифрованныйПакет = ВременныйКаталог + КороткоеИмяЗашифрованногоПакета;
	
	СертификатыЗашифрования = Новый Массив;
	СертификатыЗашифрования.Добавить(СертификатФСС);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 				ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 			ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 			ВидОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("ЗашифрованныйПакет", 					ЗашифрованныйПакет);
	ДополнительныеПараметры.Вставить("СертификатыЗашифрования", 			СертификатыЗашифрования);
	ДополнительныеПараметры.Вставить("ФайлПодписи", 						"");
	ДополнительныеПараметры.Вставить("ПолноеИмяФайлаВыгрузки", 				ПолноеИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
	ДополнительныеПараметры.Вставить("АдресДанныхВыгрузки", 				АдресДанныхВыгрузки);
	ДополнительныеПараметры.Вставить("ОрганизацияСсылка",	 				ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("МЧД", 								МЧД);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Если ЭтоДанныеЭЛН Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("ПроверкиИАвтонастройкаВыполнены", 		Истина);
		НастройкиОперации.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
		НастройкиОперации.Вставить("СертификатФСС", 						СертификатФСС);
		НастройкиОперации.Вставить("МЧД", 									ДополнительныеПараметры.МЧД);
		НастройкиОперации.Вставить("ПараметрыФорматаЭЛН", 					ПараметрыФорматаЭЛН);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НастройкиОперации);
		
		АдресПодписанногоSOAPЗагрузкиЭЛНВФСС(
			Оповещение,
			ОрганизацияОтчета,
			РегистрационныйНомерФСС,
			ТекстФайлаВыгрузки,,
			НастройкиОперации);
		
	ИначеЕсли ЭтоПодтверждениеВидаДеятельности ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		
		ВыгрузкаЗапросаОперации = Новый Структура;
		ВыгрузкаЗапросаОперации.Вставить("Организация", 			ОрганизацияОтчета);
		ВыгрузкаЗапросаОперации.Вставить("РегистрационныйНомерФСС", Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ОГРН", 					Неопределено);
		ВыгрузкаЗапросаОперации.Вставить("ТекстЗапроса", 			ТекстФайлаВыгрузки);
		
		НастройкиОперации = Новый Структура;
		НастройкиОперации.Вставить("ПрефиксИдентификатораОГРН", 			"");
		НастройкиОперации.Вставить("ПроверкиИАвтонастройкаВыполнены", 		Истина);
		НастройкиОперации.Вставить("СертификатСтрахователя", 				СертификатСтрахователя);
		НастройкиОперации.Вставить("СертификатФСС", 						СертификатФСС);
		НастройкиОперации.Вставить("МЧД", 									ДополнительныеПараметры.МЧД);
		НастройкиОперации.Вставить("СертификатШифрованияОтветаВПодписи", 	Ложь);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НастройкиОперации);
		
		Если ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			НастройкиОперации.ПрефиксИдентификатораОГРН 			= "http://eln.fss.ru/actor/recipient/";
			НастройкиОперации.СертификатШифрованияОтветаВПодписи 	= Истина;
		КонецЕсли;
		
		АдресПодписанногоSOAPОперацииСОКВЭДВФСС(
			Оповещение,
			ВыгрузкаЗапросаОперации,
			НастройкиОперации);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПолученияИмениФайлаПакета",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено)

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияИмениФайлаПакета(Результат, ДополнительныеПараметры) Экспорт
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ТипОтправляемогоДокумента = ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ПолноеИмяФайлаВыгрузки = ДополнительныеПараметры.ПолноеИмяФайлаВыгрузки;
	ОрганизацияСсылка = ДополнительныеПараметры.ОрганизацияСсылка;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ПакетДляОтправкиВФСС", ОрганизацияСсылка); 
		ПараметрыОперации = ПодготовитьОблачнуюПодпись(ПолноеИмяФайлаВыгрузки, "xml", ТребуетПодтверждениеОперации);
	Иначе
		ПараметрыОперации = "*";
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ПодписатьPKCS7(
		Оповещение,
		ДополнительныеПараметры.СертификатСтрахователя,
		?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча), ДополнительныеПараметры.АдресДанныхВыгрузки,
			ПолноеИмяФайлаВыгрузки),
		Истина,,
		Ложь,,,
		ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПодписанияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ЗашифрованныйПакет 					= ДополнительныеПараметры.ЗашифрованныйПакет;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	СертификатыЗашифрования 			= ДополнительныеПараметры.СертификатыЗашифрования;
	
	Если НЕ Результат.Выполнено Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеВопросаПриОшибкеПодписи",
			ЭтотОбъект, ДополнительныеПараметры);
		
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
			
		Иначе
			ТипКриптопровайдераВладельца = ?(Результат.Свойство("ТипКриптопровайдераВладельца"),
				Результат.ТипКриптопровайдераВладельца, Неопределено);
			ПоказатьВопросПриОшибкеКриптооперации(
				Оповещение,
				"ПодписатьPKCS7",
				Результат.ОписаниеОшибки,
				ТипКриптопровайдераВладельца);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ФайлПодписи = Результат.ФайлПодписи;
	
	ДополнительныеПараметры.Вставить("ФайлПодписи", ФайлПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
		Оповещение,
		ФайлПодписи,
		СертификатыЗашифрования,
		?(НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча), Неопределено, ЗашифрованныйПакет));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеВопросаПриОшибкеПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Повторить Тогда
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьПакетДляОтправкиВФССПослеПолученияИмениФайлаПакета",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
		
	Иначе
		Если Результат = КодВозвратаДиалога.ОК Тогда
			// после показа подробной информации об ошибке подписи
			ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий(); //ФСС.
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось подписать файл выгрузки!';
																|en = 'Не удалось подписать файл выгрузки!'"));
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		КонецЕсли;
		
		Если ДополнительныеПараметры.ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОЗавершении);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПакетДляОтправкиВФССПослеПодписанияИЗашифрованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	ЗашифрованныйПакет 					= ДополнительныеПараметры.ЗашифрованныйПакет;
	ФайлПодписи 						= ДополнительныеПараметры.ФайлПодписи;
	
	ПодписанныйSOAP64 = ?(ДополнительныеПараметры.Свойство("ПодписанныйSOAP64"),
		ДополнительныеПараметры.ПодписанныйSOAP64, Неопределено);
	
	Если ЗначениеЗаполнено(ФайлПодписи) Тогда
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			Если ФайлПодписи <> ПодписанныйSOAP64 И (ТипЗнч(Результат) <> Тип("Структура")
				ИЛИ НЕ Результат.Свойство("ЗашифрованныйФайл") ИЛИ ФайлПодписи <> Результат.ЗашифрованныйФайл) Тогда
				УдалитьИзВременногоХранилища(ФайлПодписи);
			КонецЕсли;
		Иначе
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ФайлПодписи);
		КонецЕсли;
	КонецЕсли;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	ОперацияВыполнена = ?(ЭтоПодписьИШифрованиеSOAP, ЗначениеЗаполнено(Результат), Результат.Выполнено);
	Если НЕ ОперацияВыполнена Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось зашифровать файл выгрузки или не настроена возможность электронного документооборота с ФСС!';
															|en = 'Не удалось зашифровать файл выгрузки или не настроена возможность электронного документооборота с ФСС!'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();//ФСС.
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) ИЛИ ЭтоПодписьИШифрованиеSOAP Тогда

		ИмяФайлаЗашифрованногоПакета = ?(ЭтоПодписьИШифрованиеSOAP, Результат, Результат.ЗашифрованныйФайл);
		
		ИмяФайлаВыгрузки = ЗашифрованныйПакет;
		
		ЗашифрованныйПакет = Новый Структура;
		ЗашифрованныйПакет.Вставить("ИмяФайлаВыгрузки", 			ИмяФайлаВыгрузки);
		ЗашифрованныйПакет.Вставить("ИмяФайлаЗашифрованногоПакета", ИмяФайлаЗашифрованногоПакета);
		ЗашифрованныйПакет.Вставить("ПодписанныйSOAP64", 			ПодписанныйSOAP64);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ЗашифрованныйПакет);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодПодчиненности(ХранилищеДанныхОтчета)
	
	Код = "";
	ДанныеОтчета = ХранилищеДанныхОтчета.Получить();
	Если ДанныеОтчета.ПоказателиОтчета.Свойство("ПолеТабличногоДокументаТитульный") Тогда
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный;
	Иначе
		ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаПриложение1;
	КонецЕсли;
	Если ТитульныйЛист.Свойство("КодПодчиненности") Тогда
		Код = ТитульныйЛист.КодПодчиненности;
	ИначеЕсли ТитульныйЛист.Свойство("КодПодчиненности_1") Тогда
		Код = ТитульныйЛист.КодПодчиненности_1
			+ ТитульныйЛист.КодПодчиненности_2
			+ ТитульныйЛист.КодПодчиненности_3
			+ ТитульныйЛист.КодПодчиненности_4
			+ ТитульныйЛист.КодПодчиненности_5;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

&НаСервереБезКонтекста
Функция КодРегионаВФорме(ХранилищеДанныхОтчета)
	
	Код = Неопределено;
	ДанныеОтчета = ХранилищеДанныхОтчета.ДанныеОтчета.Получить();
	ТитульныйЛист = ДанныеОтчета.ПоказателиОтчета.ПолеТабличногоДокументаТитульный;
	Если ТитульныйЛист.Свойство("КодРегионаВФорме") Тогда
		Код = ТитульныйЛист.КодРегионаВФорме;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт

	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС(
		ВходящийКонтекст.Форма,
		ВходящийКонтекст.ЭтоОтправкаИзФормыОтчетность,
		ВходящийКонтекст.ОтчетСсылка,
		ВходящийКонтекст.ОрганизацияОтчета,
		ВходящийКонтекст.РезультатВыгрузки,
		ВходящийКонтекст.ОповещениеОЗавершении);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС(
		Форма = Неопределено,
		Знач ЭтоОтправкаИзФормыОтчетность = Ложь,
		Знач ОтчетСсылка = Неопределено,
		Знач ОрганизацияОтчета = Неопределено,
		Знач РезультатВыгрузки = Неопределено,
		Знач ОповещениеОЗавершении = Неопределено) Экспорт
		
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОрганизацияОтчета 	= ДокументооборотСФССКлиентСервер.ПолучитьОрганизациюПоФорме(Форма);
		ОтчетСсылка 		= ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ИнформацияДляОтправки = ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПодготовкаНаСервере(ОрганизацияОтчета,
		ОтчетСсылка);
	ОбъектПоУмолчаниюРеестрЭЛНСуществует = ИнформацияДляОтправки.ОбъектПоУмолчаниюРеестрЭЛНСуществует;
	ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует =
		ИнформацияДляОтправки.ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует;
	
	МЧДОтпечатокРуководителя = ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДОтпечатокРуководителя");
	Если ЗначениеЗаполнено(МЧДОтпечатокРуководителя) Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(Ложь);
	Иначе
		РеквизитыУчетнойЗаписи = ИнформацияДляОтправки.РеквизитыУчетнойЗаписи;
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РеквизитыУчетнойЗаписи);
	КонецЕсли;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ЭтоРегламентированныйОтчет 	= (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") 
		ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРеестрСведений 			= ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ЭтоРеестрЭЛН 				= ДокументооборотСФССКлиентСервер.ЭтоРеестрДанныхЭЛНЗаполняемыхРаботодателем(ОтчетСсылка,
		ОбъектПоУмолчаниюРеестрЭЛНСуществует);
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
		ДокументооборотСФССКлиентСервер.ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(ОтчетСсылка,
		ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует);
	ЭтоЭлектронноеПредставление = (ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"));
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", 								Форма);
	ДополнительныеПараметры.Вставить("ЭтоОтправкаИзФормыОтчетность", 		ЭтоОтправкаИзФормыОтчетность);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 						ОтчетСсылка);
	ДополнительныеПараметры.Вставить("ОрганизацияОтчета", 					ОрганизацияОтчета);
	ДополнительныеПараметры.Вставить("РезультатВыгрузки", 					РезультатВыгрузки);
	ДополнительныеПараметры.Вставить("ЭтоДанныеЭЛН", 						ЭтоРеестрЭЛН);
	ДополнительныеПараметры.Вставить("ЭтоПодтверждениеВидаДеятельности", 	Ложь);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 				ОповещениеОЗавершении);
	КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, ДополнительныеПараметры);
	
	Если ЭтоРегламентированныйОтчет Тогда
		
		// отправляем только из записанной формы
		Если НЕ ЭтоОтправкаИзФормыОтчетность И Форма.Модифицированность Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияРегОтчета",
				ЭтотОбъект,
				ДополнительныеПараметры);
				
			Форма.СохранитьНаКлиенте(, ОписаниеОповещения);

		Иначе

			ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры);
			
		КонецЕсли;
		
	ИначеЕсли ЭтоРеестрСведений ИЛИ ЭтоРеестрЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		
		Если НЕ ЗначениеЗаполнено(ОтчетСсылка) Тогда
			ПоказатьПредупреждение(, "Перед отправкой реестр сведений требуется записать.");
			Если ОповещениеОЗавершении <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		КодОрганаФСС = Лев(ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьКодПодчиненностиРеестраСведенийНаВыплатуПособийФСС(ОтчетСсылка), 4);
		ДатыПериода = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(ОтчетСсылка);
		
		ПоляДляЗаписиОтправки = Новый Структура();
		ПоляДляЗаписиОтправки.Вставить("КодОрганаФСС",         КодОрганаФСС);
		ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода",    ДатыПериода.ДатаНачала);
		ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", ДатыПериода.ДатаОкончания);
		ПоляДляЗаписиОтправки.Вставить("Версия",               0);
		
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
		
		
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС") Тогда
		
		ЗначенияРеквизитов = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначенияРеквизитовОбъекта(ОтчетСсылка,
			"ДоверительФЛ_РегистрационныйНомерФСС, ДатаВыдачи, ДатаОкончания");
		
		КодОрганаФСС = Лев(ЗначенияРеквизитов.ДоверительФЛ_РегистрационныйНомерФСС, 4);
		
		ПоляДляЗаписиОтправки = Новый Структура();
		ПоляДляЗаписиОтправки.Вставить("КодОрганаФСС", 			КодОрганаФСС);
		ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода", 	ЗначенияРеквизитов.ДатаВыдачи);
		ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", 	ЗначенияРеквизитов.ДатаОкончания);
		ПоляДляЗаписиОтправки.Вставить("Версия", 				0);
		
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
		
	ИначеЕсли ЭтоЭлектронноеПредставление Тогда
		
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			Если Форма.Модифицированность Тогда
				ПоказатьПредупреждение(, НСтр("ru = 'Необходимо записать отчет перед отправкой.';
												|en = 'Необходимо записать отчет перед отправкой.'"));
				Если ОповещениеОЗавершении <> Неопределено Тогда
					ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
				КонецЕсли;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтчетСсылка = Неопределено 
			ИЛИ ОтчетСсылка = ПредопределенноеЗначение("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ПустаяСсылка") Тогда
			
			Если ОповещениеОЗавершении <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки = ПоляНаСервереДляЗаписиОтправкиВФССНаСервере(ОтчетСсылка);
		
		ДополнительныеПараметры.ЭтоДанныеЭЛН = (ПоляДляЗаписиОтправки.ТипДокумента =
			ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
		ДополнительныеПараметры.ЭтоПодтверждениеВидаДеятельности = ПоляДляЗаписиОтправки.ТипДокумента =
			ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
			И ПоляДляЗаписиОтправки.ВидОтчета =
			ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности");
		ПоляДляЗаписиОтправки.Удалить("ВидОтчета");
		ПоляДляЗаписиОтправки.Удалить("ТипДокумента");
		
		ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Не удалось определить тип документа.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПодготовкаНаСервере(ОрганизацияОтчета, ОтчетСсылка)
	
	Если НЕ ЗначениеЗаполнено(ОрганизацияОтчета)
		И ТипЗнч(ОтчетСсылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС") Тогда
		
		ОрганизацияОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетСсылка, "Организация");
	КонецЕсли;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияОтчета);
	ОбъектПоУмолчаниюРеестрЭЛНСуществует =
		Метаданные.Документы.Найти("РеестрДанныхЭЛНЗаполняемыхРаботодателем") <> Неопределено;
	ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует =
		Метаданные.Документы.Найти("РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам") <> Неопределено;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Результат = Новый Структура;
	Результат.Вставить("РеквизитыУчетнойЗаписи", РеквизитыУчетнойЗаписи);
	Результат.Вставить("ОбъектПоУмолчаниюРеестрЭЛНСуществует", ОбъектПоУмолчаниюРеестрЭЛНСуществует);
	Результат.Вставить("ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует",
		ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры) Экспорт
	
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	ЭтоДанныеЭЛН 						= ДополнительныеПараметры.ЭтоДанныеЭЛН;
	ПоляДляЗаписиОтправки 				= ДополнительныеПараметры.ПоляДляЗаписиОтправки;
	
	ОрганизацияИспользуетОбменСФСС                    = Ложь;
	ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи = Ложь;
	НастроенОбменВУниверсальномФормате                = Ложь;	
	
	ПараметрыФорматов = ?(ЭтоДанныеЭЛН, Новый Структура("ПараметрыФорматаЭЛН", Неопределено), Неопределено);
	ПолучитьСвойстваОрганизацииДляФССНаСервере(
		ОрганизацияОтчета,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи,,
		ПараметрыФорматов);
	ДополнительныеПараметры.Вставить("ПараметрыФорматаЭЛН", ?(ПараметрыФорматов = Неопределено, Неопределено,
		ПараметрыФорматов.ПараметрыФорматаЭЛН));
	
	Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
		Если НастроенОбменВУниверсальномФормате Тогда
			
			ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);//+
			Если ОповещениеОЗавершении <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			КонецЕсли;
			
		Иначе
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, ОписаниеОповещения);

		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если НастроенОбменВУниверсальномФормате 
		И НЕ МультирежимВызовСервера.ЕстьПравоНаОтправкуОбъекта(ОтчетСсылка) Тогда
		
		ДокументооборотСКОКлиент.СообщитьОНеподключенномНаправлении(ОтчетСсылка);//+
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;			
		Возврат;
	КонецЕсли;
	
	Если НастроенОбменВУниверсальномФормате И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка,ОписаниеОповещения);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки(Истина, ДополнительныеПараметры);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеАвтонастройки(Результат, ДополнительныеПараметры) Экспорт
	
	ОрганизацияОтчета 	= ДополнительныеПараметры.ОрганизацияОтчета;
	ЭтоДанныеЭЛН 		= ДополнительныеПараметры.ЭтоДанныеЭЛН;
	ЭтоПодтверждениеВидаДеятельности 	= ДополнительныеПараметры.ЭтоПодтверждениеВидаДеятельности;
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ДополнительныеПараметры.ОтчетСсылка);
	
	ПоказатьПредупреждениеОбОтправкеНаТестовыйСерверФСС =
		ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(ТипЗнчСсылкаНаОтчет, -1) = -1
		И ПоказатьПредупреждениеОбОтправкеНаТестовыйСерверФССПослеАвтонастройки(
		ОрганизацияОтчета,
		ЭтоДанныеЭЛН,
		ЭтоПодтверждениеВидаДеятельности);
		
	Если ПоказатьПредупреждениеОбОтправкеНаТестовыйСерверФСС Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеВопросаОТестовомРежиме",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		ПродолжитьОтправкуНаТестовыйСерверФСС(ОписаниеОповещения, Истина);
		
	Иначе
		
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеВопросаОТестовомРежиме(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияРегОтчета(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 		= ДополнительныеПараметры.Форма;
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	// если отчет не был записан ранее, то получим ссылку на записанный отчет
	Если ОтчетСсылка = Неопределено Тогда
		
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
		ДополнительныеПараметры.ОтчетСсылка = ОтчетСсылка;
		
	КонецЕсли;
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(ДополнительныеПараметры)
	
	Форма 								= ДополнительныеПараметры.Форма;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	
	Если ОтчетСсылка = Неопределено Тогда
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ЭтоОтправкаИзФормыОтчетность Тогда
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка,
			"ДатаНачала, ДатаОкончания, Вид, ДанныеОтчета, ИсточникОтчета");
		
		КодПодчиненности = КодПодчиненности(ЗначенияРеквизитов.ДанныеОтчета);
		
		ПоляДляЗаписиОтправки = Новый Структура("КодОрганаФСС, ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			Лев(КодПодчиненности, 4),
			НачалоДня(ЗначенияРеквизитов.ДатаНачала),
			КонецДня(ЗначенияРеквизитов.ДатаОкончания),
			ЗначенияРеквизитов.Вид);
		
		Если ЗначенияРеквизитов.ИсточникОтчета = "РегламентированныйОтчетПодтверждениеВидаДеятельности" Тогда
			ДополнительныеПараметры.ЭтоПодтверждениеВидаДеятельности = Истина;
		КонецЕсли;
		
	Иначе
		СтруктураРеквизитовФормы = Форма.СтруктураРеквизитовФормы;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(СтруктураРеквизитовФормы, "мВариант") Тогда
			Версия = СтруктураРеквизитовФормы.мВариант;
		Иначе
			Версия = 0;
		КонецЕсли;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(Форма, "СтруктураДанныхТитульный") Тогда
			ДанныеТитульный = Форма.СтруктураДанныхТитульный;
		Иначе
			ДанныеТитульный = Форма.СтруктураДанныхПриложение1;
		КонецЕсли;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности") Тогда
			КодОрганаФСС = Лев(ДанныеТитульный.КодПодчиненности, 4);
		ИначеЕсли РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_1") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_2") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_3") 
				И РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(ДанныеТитульный, "КодПодчиненности_4") Тогда
			
			КодОрганаФСС = ДанныеТитульный.КодПодчиненности_1  
				+ ДанныеТитульный.КодПодчиненности_2  
				+ ДанныеТитульный.КодПодчиненности_3  
				+ ДанныеТитульный.КодПодчиненности_4; 
		Иначе
			ПоказатьПредупреждение(, "Не удалось определить код органа ФСС при отправке!");
			Если ОповещениеОЗавершении <> Неопределено Тогда
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		ПоляДляЗаписиОтправки = Новый Структура("КодОрганаФСС, ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
			КодОрганаФСС,
			СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета,
			СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета,
			Версия);
		
		Если СтрНайти(Форма.ИмяФормы, "РегламентированныйОтчетПодтверждениеВидаДеятельности") <> 0 Тогда
			ДополнительныеПараметры.ЭтоПодтверждениеВидаДеятельности = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
	
	ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеСохраненияИПроверок(ДополнительныеПараметры)
	
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеНастройкиЗаявления", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ЗавершитьНастройкуЗаявленияНаИзменение(ОтчетСсылка, ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеНастройкиЗаявления(Результат, ВходящийКонтекст) Экспорт	
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиСертификатаИЛицензии", 
		ЭтотОбъект, 
		ВходящийКонтекст);

	ПроверитьСертификатИЛицензию(
		ОписаниеОповещения, 
		ВходящийКонтекст.ОтчетСсылка, 
		ВходящийКонтекст.ОрганизацияОтчета, 
		"ФСС");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Форма 		= ВходящийКонтекст.Форма;
	ОтчетСсылка = ВходящийКонтекст.ОтчетСсылка;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтверждения", 
		ЭтотОбъект, 
		ВходящийКонтекст);
	
	ПодтверждениеОтправкиОтчета(
		Форма, 
		ОписаниеОповещения, 
		ОтчетСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ОтчетСсылка = ДополнительныеПараметры.ОтчетСсылка;
	
	ПодтвердитьПовторнуюОтправку(ОтчетСсылка, "ФСС", ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОтправкаРегламентированногоОтчетаВФССПослеПодтвержденияЗавершение(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Форма 							= ДополнительныеПараметры.Форма;
	ОтчетСсылка 					= ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность 	= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОповещениеОЗавершении 			= ДополнительныеПараметры.ОповещениеОЗавершении;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
		ОтчетСсылка = ДокументооборотСФССКлиентСервер.СсылкаНаОтчетПоФорме(Форма);
	КонецЕсли;
	
	ИнформацияОбОтправляемомДокументе = ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОтчетСсылка,
		Истина);
	Если ИнформацияОбОтправляемомДокументе = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить вид отправляемого документа.';
				|en = 'Не удалось определить вид отправляемого документа.'"));
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ТипОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ВидОтправляемогоДокумента;
	
	ДополнительныеПараметры.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
	ДополнительныеПараметры.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
	
	ЭтоПодтверждениеВидаДеятельности = ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияПриложений",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	Если ЭтоПодтверждениеВидаДеятельности
		И ТипЗнч(ОтчетСсылка) <> Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ОписаниеОповещения) Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
		Иначе
			ТекстВопроса = НСтр("ru = 'Прием приложения 3 в электронном виде не поддерживается ФСС.
									  |Будут отправлены приложения 1 и 2.
									  |
									  |Продолжить?';
									  |en = 'Прием приложения 3 в электронном виде не поддерживается ФСС.
									  |Будут отправлены приложения 1 и 2.
									  |
									  |Продолжить?'");
			ПоказатьВопрос(
				ОписаниеОповещения,
				ТекстВопроса,
				РежимДиалогаВопрос.ДаНет,,
				КодВозвратаДиалога.Да);
		КонецЕсли;
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияПриложений(Результат, ДополнительныеПараметры) Экспорт
	
	Форма 								= ДополнительныеПараметры.Форма;
	ОтчетСсылка 						= ДополнительныеПараметры.ОтчетСсылка;
	ЭтоОтправкаИзФормыОтчетность 		= ДополнительныеПараметры.ЭтоОтправкаИзФормыОтчетность;
	ОрганизацияОтчета 					= ДополнительныеПараметры.ОрганизацияОтчета;
	МестоХраненияКлюча					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	ОповещениеОЗавершении 				= ДополнительныеПараметры.ОповещениеОЗавершении;
	РезультатВыгрузки 					= ДополнительныеПараметры.РезультатВыгрузки;
	ТипОтправляемогоДокумента 			= ДополнительныеПараметры.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 			= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДлительнаяОтправкаКлиент.ЗапретитьВыводСостояния();
	
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФСС(
		ОтчетСсылка,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		РезультатВыгрузки,
		ОрганизацияОтчета);
	
	ДлительнаяОтправкаКлиент.СброситьЗапретВыводаСостояния();
	
	Если РезультатВыгрузки = Неопределено Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось выгрузить отчет.';
				|en = 'Не удалось выгрузить отчет.'"));
		Возврат;
		
	КонецЕсли;
	
	Если РезультатВыгрузки.ОтправкаЧерезСЭДО Тогда
		ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	РезультатВыгрузки.ИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	РезультатВыгрузки.ТекстФайлаВыгрузки);
		ПараметрыСообщения = ПараметрыОтправитьСообщениеСЭДОФСС();
		ПараметрыСообщения.СодержимоеСообщения = РезультатВыгрузки.ТекстФайлаВыгрузки;
		ПараметрыСообщения.Вставить("ИдентификаторРодителя", РезультатВыгрузки.ИдентификаторРодителя);
		ПараметрыСообщения.Организация = ОрганизацияОтчета;
		
		ПараметрыОтправкиВидаДокумента =
			ДокументооборотСФССКлиентСервер.ПараметрыОтправкиВидаДокументаЧерезСЭДО(ВидОтправляемогоДокумента, Ложь, Ложь);
		ПараметрыСообщения.ТипСообщения = ПараметрыОтправкиВидаДокумента.ТипСообщения;
		ПараметрыСообщения.ОписаниеОшибки = ПараметрыОтправкиВидаДокумента.ОписаниеОшибки;
		Если РезультатВыгрузки.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
			ПараметрыСообщения.Вставить("СодержимоеПодписанногоЗапросаSOAP",
				РезультатВыгрузки.СодержимоеПодписанногоЗапросаSOAP);
		КонецЕсли;
		Если РезультатВыгрузки.Свойство("ОтпечатокСертификатаПодписанта") Тогда
			ПараметрыСообщения.Вставить("ОтпечатокСертификатаПодписанта", РезультатВыгрузки.ОтпечатокСертификатаПодписанта);
		КонецЕсли;
		
		ПараметрыСообщения.ОповещениеОбратногоВызова = Новый ОписаниеОповещения(
			"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеОтправкиЧерезСЭДО",
			ЭтотОбъект,
			ДополнительныеПараметры);
		
		МЧДСкрытьДлительнуюОтправку =
			(ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДСкрытьДлительнуюОтправку") = Истина);
		ОтправитьСообщениеСЭДОФСС(ПараметрыСообщения,,, НЕ МЧДСкрытьДлительнуюОтправку);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 		РезультатВыгрузки.ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 		РезультатВыгрузки.РасширениеСТочкой);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 		РезультатВыгрузки.ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ТипЗнчСсылкаНаОтчет", 	ТипЗнч(ОтчетСсылка));
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", РезультатВыгрузки.РегистрационныйНомерФСС); // реестры ЭЛН
	
	Если ЗначениеЗаполнено(РезультатВыгрузки.РегистрационныйНомерФСС)
		И НЕ ЗначениеЗаполнено(ДополнительныеПараметры.ПоляДляЗаписиОтправки.КодОрганаФСС) Тогда
		
		ДополнительныеПараметры.ПоляДляЗаписиОтправки.КодОрганаФСС = Лев(РезультатВыгрузки.РегистрационныйНомерФСС, 4);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеИнициализации",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("ОписаниеОповещения", 	ОписаниеОповещения);
	КонтекстДлительнойОперации.Вставить("ОрганизацияОтчета", 	ОрганизацияОтчета);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, КонтекстДлительнойОперации);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;

	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение",  0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеОтправкиЧерезСЭДО(Результат, ДополнительныеПараметры) Экспорт
	
	ОтчетСсылка 				= ДополнительныеПараметры.ОтчетСсылка;
	ОповещениеОЗавершении 		= ДополнительныеПараметры.ОповещениеОЗавершении;
	ВидОтправляемогоДокумента 	= ДополнительныеПараметры.ВидОтправляемогоДокумента;
	МестоХраненияКлюча 			= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(Результат.ОписаниеОшибки);
		
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПодписанныйПакет = ?(Результат.Свойство("ПодписанноеСообщение64")
		И ЗначениеЗаполнено(Результат.ПодписанноеСообщение64), Результат.ПодписанноеСообщение64, Неопределено);
	Если ЗначениеЗаполнено(ПодписанныйПакет) И
		НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		ДанныеПодписанногоСообщения = Base64Значение(ПодписанныйПакет);
		ПодписанныйПакет = ПоместитьВоВременноеХранилище(ДанныеПодписанногоСообщения, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора(
		ДополнительныеПараметры.ОрганизацияОтчета).ОбменПоСЭДОНапрямую;
	
	Если ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") = Истина Тогда
		ПодписанныйЗапросSOAP64 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ПодписанныйЗапросSOAP64");
		ЗаписатьПодписьМЧДФСС(
			ДополнительныеПараметры.ОтчетСсылка,
			ПодписанныйЗапросSOAP64);
		НоваяОтправкаСсылка = Неопределено;
		
	Иначе
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("ОтчетСсылка", 				ДополнительныеПараметры.ОтчетСсылка);
		НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 	ДополнительныеПараметры.ПоляДляЗаписиОтправки);
		НастройкиОтправки.Вставить("ЭтоТекстФайлаПакета", 		Истина);
		НастройкиОтправки.Вставить("ПодписанныйПакет", 			ПодписанныйПакет);
		НастройкиОтправки.Вставить("ОбменЧерезОператора", 		НЕ ОбменПоСЭДОНапрямую);
		НоваяОтправкаСсылка = ДобавитьОтправкуФССНаСервере(
			НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча),
			ДополнительныеПараметры.ИмяФайлаВыгрузки,
			ДополнительныеПараметры.ТекстФайлаВыгрузки,
			Результат.ИдентификаторЗапроса,
			НастройкиОтправки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодписанныйПакет) И
		НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		
		УдалитьИзВременногоХранилища(ПодписанныйПакет);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяОтправкаСсылка) Тогда
		ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
		ПараметрыДлительнойОтправки.ОтчетСсылка 				= ОтчетСсылка;
		ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 1;
		ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= ДополнительныеПараметры;
		
		Если ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСС
			ПараметрыАвтозапроса = Новый Структура();
			ПараметрыАвтозапроса.Вставить("Ключ", НоваяОтправкаСсылка);
			
			ЭтоПромежуточныйПротокол = (ВидОтправляемогоДокумента =
				ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыАвтозапроса", 		ПараметрыАвтозапроса);
			ДополнительныеПараметры.Вставить("ЭтоПромежуточныйПротокол", 	ЭтоПромежуточныйПротокол);
			
			ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ФСС.
		КонецЕсли;
	КонецЕсли;
	
	Если ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВыгрузитьОтчетДляОтправкиВФСС(
		ОтчетСсылка,
		Форма,
		ЭтоОтправкаИзФормыОтчетность,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		РезультатВыгрузки = Неопределено,
		ОрганизацияОтчета = Неопределено)
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ТекстФайлаВыгрузки		= "";
	ИмяФайлаВыгрузки		= "";
	ИдентификаторРодителя 	= "";
	РегистрационныйНомерФСС = Неопределено;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС"));
	ЭтоПодтверждениеВидаДеятельности = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ТипОтправляемогоДокумента =
		ПредопределенноеЗначение("Перечисление.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС")
		И ВидОтправляемогоДокумента =
		ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРеестрСведений = ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ЭтоЭлектронноеПредставление = (ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"));
	
	Если ЭтоРегламентированныйОтчет  Тогда
		Если НЕ ЭтоОтправкаИзФормыОтчетность Тогда
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента", , Форма);
		Иначе
			ФормаВыгрузкиРеглОтчета = ПолучитьФорму("Документ.ВыгрузкаРегламентированныхОтчетов.Форма.ФормаДокумента");
		КонецЕсли;

		Если НЕ ФормаВыгрузкиРеглОтчета.ВыгрузитьОтчет(ОтчетСсылка, Ложь, , ТекстФайлаВыгрузки, ИмяФайлаВыгрузки) Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Не удалось выгрузить отчет.';
					|en = 'Не удалось выгрузить отчет.'"));
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ЭтоЭлектронноеПредставление Тогда
		
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
			ОтчетСсылка,
			ТекстФайлаВыгрузки,
			ИмяФайлаВыгрузки,,
			?(ЭтоПодтверждениеВидаДеятельности ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам ИЛИ ЭтоДанныеЭЛН,
				"utf-8", Неопределено));
		Если ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			НачалоТекстаВыгрузки = Лев(ТекстФайлаВыгрузки, 100);
			НачалоТекстаВыгрузки = нрег(НачалоТекстаВыгрузки);
			Если СтрНайти(НачалоТекстаВыгрузки, "encoding=""windows-1251""") > 0 Тогда
				ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодироватьНаСервере(
					ОтчетСсылка,
					ТекстФайлаВыгрузки,
					ИмяФайлаВыгрузки,,
					"windows-1251");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЭтоРеестрСведений ИЛИ ЭтоДанныеЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		
		Если РезультатВыгрузки <> Неопределено Тогда
			ТекстФайлаВыгрузки 		= РезультатВыгрузки.ТекстXML;
			ИмяФайлаВыгрузки 		= РезультатВыгрузки.ИмяБезРасширения + ".xml";
			СвойстваФайлаВыгрузки 	= Новый Структура("РегистрационныйНомерФСС", РезультатВыгрузки.РегистрационныйНомерФСС);
			
		Иначе
			СвойстваФайлаВыгрузки = Неопределено;
			ПолучитьСвойстваФайлаВыгрузкиНаСервере(
				ОтчетСсылка,
				ТекстФайлаВыгрузки,
				ИмяФайлаВыгрузки,,
				СвойстваФайлаВыгрузки);
		КонецЕсли;
		
		Если ЭтоДанныеЭЛН И СвойстваФайлаВыгрузки <> Неопределено
			И СвойстваФайлаВыгрузки.Свойство("РегистрационныйНомерФСС") Тогда
			
			РегистрационныйНомерФСС = СвойстваФайлаВыгрузки.РегистрационныйНомерФСС;
		КонецЕсли;
		
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС") Тогда
		ПараметрыВозврата = Новый Структура;
		ПараметрыВозврата.Вставить("ВозвращатьИмяФайлаСРасширением", Истина);
		РезультатВыгрузки = ДокументооборотСКОВызовСервера.ВыгрузитьМЧДФСС(
			ОтчетСсылка,,
			Ложь,
			ПараметрыВозврата);
		ТекстФайлаВыгрузки 		= РезультатВыгрузки.Содержимое;
		ИмяФайлаВыгрузки 		= РезультатВыгрузки.ИмяФайла;
		ИдентификаторРодителя 	= РезультатВыгрузки.ИдентификаторРодителя;
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Не удалось определить тип документа.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
		Возврат Неопределено;
	КонецЕсли;
	
	// замена символов, приводящих к ошибки проверки подписи на сервере ФСС
	Если ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам
		ИЛИ ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(ВидОтправляемогоДокумента, -1) <> -1 Тогда
		
		ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, Символ(61630), Символ(8211)); // замена длинного дефиса
		ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, Символ(8194), " "); // замена короткого пробела
	КонецЕсли;
	
	РезультатИнициализации = ВыгрузитьОтчетДляОтправкиВФССИнициализацияНаСервере(
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		ИмяФайлаВыгрузки,
		ТекстФайлаВыгрузки,
		ОрганизацияОтчета);
	
	Если ЗначениеЗаполнено(РезультатИнициализации.ТекстОшибки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(РезультатИнициализации.ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	РасширениеФайла = РезультатИнициализации.РасширениеФайла;
	Если РезультатИнициализации.ТекстФайлаВыгрузки <> Неопределено Тогда
		ТекстФайлаВыгрузки = РезультатИнициализации.ТекстФайлаВыгрузки;
	КонецЕсли;
	
	Если ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам И НЕ РезультатИнициализации.ОтправкаЧерезСЭДО Тогда
		ТекстПрефикса = "<submitCovidWorkerRegistrRequest ";
		ТекстПостфикса = "</submitCovidWorkerRegistrRequest>";
		ТекстПрефикса2023 = "<submit2023WorkerRegistrRequest ";
		ТекстПостфикса2023 = "</submit2023WorkerRegistrRequest>";
		ТекстПрефиксаГосслужащим = "<PaymentsFederalCivilServantsRequest ";
		ТекстПостфиксаГосслужащим = "</PaymentsFederalCivilServantsRequest>";
		
		Для НомерРеестра = 1 По 2 Цикл
			ПозицияПрефикса = СтрНайти(ТекстФайлаВыгрузки, ТекстПрефикса);
			Если ПозицияПрефикса > 0 Тогда
				ТекстФайлаВыгрузки = Сред(ТекстФайлаВыгрузки, ПозицияПрефикса);
				ПозицияПостфикса = СтрНайти(ТекстФайлаВыгрузки, ТекстПостфикса);
				Если ПозицияПостфикса > 0 Тогда
					ДлинаПостфикса = СтрДлина(ТекстПостфикса);
					ТекстФайлаВыгрузки = Лев(ТекстФайлаВыгрузки, ПозицияПостфикса + ДлинаПостфикса - 1);
				КонецЕсли;
				
				Прервать;
				
			ИначеЕсли НомерРеестра = 1 Тогда
				Если СтрНайти(ТекстФайлаВыгрузки, ТекстПрефиксаГосслужащим) = 0 Тогда
					ТекстПрефикса = ТекстПрефикса2023;
					ТекстПостфикса = ТекстПостфикса2023;
				Иначе
					ТекстПрефикса = ТекстПрефиксаГосслужащим;
					ТекстПостфикса = ТекстПостфиксаГосслужащим;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, ТекстПрефикса + " ", ТекстПрефикса);
		
		ПространствоИменОтчета = "xmlns=""http://www.fss.ru/integration/types/pvso/quarantine/covidworkerregistr/v01""";
		Если СтрНайти(ТекстФайлаВыгрузки, ПространствоИменОтчета) = 0 Тогда
			ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, ТекстПрефикса, ТекстПрефикса + ПространствоИменОтчета + " ");
		КонецЕсли;
	КонецЕсли;
	
	РасширениеСТочкой = "";
	Если РасширениеФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Не удалось определить тип документа.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
		Возврат Неопределено;
	Иначе
		РасширениеСТочкой = "." + РасширениеФайла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось сформировать файл выгрузки.';
				|en = 'Не удалось сформировать файл выгрузки.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не определено имя файла выгрузки.';
				|en = 'Не определено имя файла выгрузки.'"));
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке();
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 		ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 		ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 		РасширениеСТочкой);
	ДополнительныеПараметры.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	ДополнительныеПараметры.Вставить("ОтправкаЧерезСЭДО",		РезультатИнициализации.ОтправкаЧерезСЭДО);
	ДополнительныеПараметры.Вставить("ИдентификаторРодителя",	ИдентификаторРодителя);
	Если ТипЗнч(РезультатВыгрузки) = Тип("Структура") Тогда
		Если РезультатВыгрузки.Свойство("СодержимоеПодписанногоЗапросаSOAP") Тогда
			ДополнительныеПараметры.Вставить("СодержимоеПодписанногоЗапросаSOAP",
				РезультатВыгрузки.СодержимоеПодписанногоЗапросаSOAP);
		КонецЕсли;
		Если РезультатВыгрузки.Свойство("ОтпечатокСертификатаПодписанта") Тогда
			ДополнительныеПараметры.Вставить("ОтпечатокСертификатаПодписанта",
				РезультатВыгрузки.ОтпечатокСертификатаПодписанта);
		КонецЕсли;
	КонецЕсли;
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура ОтозватьМашиночитаемуюДоверенностьФСС(
		ОповещениеОЗавершении = Неопределено,
		ОтчетСсылка = Неопределено,
		Организация = Неопределено,
		НомерДоверенности = "") Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 	ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("ОтчетСсылка", 			ОтчетСсылка);
	ДополнительныеПараметры.Вставить("Организация", 			Организация);
	ДополнительныеПараметры.Вставить("НомерДоверенности", 		НомерДоверенности);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтозватьМашиночитаемуюДоверенностьФССПослеВвода",
		ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму(
		"Справочник.МашиночитаемыеДоверенностиФСС.Форма.ФормаОтзыва",,
		ЭтаФорма,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьМашиночитаемуюДоверенностьФССПослеВвода(СтруктураДанных, ДополнительныеПараметры) Экспорт
	
	Если СтруктураДанных = Неопределено Тогда
		Если ДополнительныеПараметры.ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОЗавершении, Ложь);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПараметрыСообщенияОтзыва = ДокументооборотСКОВызовСервера.ПараметрыОтзываМашиночитаемойДоверенностиФСС(
		ДополнительныеПараметры.ОтчетСсылка,
		ДополнительныеПараметры.Организация,
		ДополнительныеПараметры.НомерДоверенности,
		СтруктураДанных.Причина,
		СтруктураДанных.ОтозватьЦепочку);
	
	ДополнительныеПараметры.Вставить("ДатаНачалаОтправки", ПараметрыСообщенияОтзыва.ДатаСеансаНаСервере);
	
	ПараметрыСообщенияОтзыва.Удалить("ДатаСеансаНаСервере");
	
	ПараметрыСообщения = ПараметрыОтправитьСообщениеСЭДОФСС();
	ЗаполнитьЗначенияСвойств(ПараметрыСообщения, ПараметрыСообщенияОтзыва);
	ПараметрыСообщения.СодержимоеСообщения = ПараметрыСообщенияОтзыва.СодержимоеИлиАдресСообщения;
	ПараметрыСообщения.ОповещениеОбратногоВызова = Новый ОписаниеОповещения(
		"ОтозватьМашиночитаемуюДоверенностьФССПослеОтправки", ЭтотОбъект, ДополнительныеПараметры);
	
	ОтправитьСообщениеСЭДОФСС(ПараметрыСообщения, , , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьМашиночитаемуюДоверенностьФССПослеОтправки(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении = ДополнительныеПараметры.ОповещениеОЗавершении;
	
	Если НЕ Результат.Выполнено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ОписаниеОшибки);
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СведенияОбОтчете = Новый Структура;
	СведенияОбОтчете.Вставить("ВидКонтролирующегоОргана",
		ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС"));
	СведенияОбОтчете.Вставить("Наименование", НСтр("ru = 'Отзыв машиночитаемой доверенности (ФСС)';
													|en = 'Отзыв машиночитаемой доверенности (ФСС)'"));
	СведенияОбОтчете.Вставить("Организация", ДополнительныеПараметры.Организация);
	
	КонтекстДлительнойОперации = Новый Структура;
	КонтекстДлительнойОперации.Вставить("Организация", 				ДополнительныеПараметры.Организация);
	КонтекстДлительнойОперации.Вставить("СсылкаНаОтчет", 			ДополнительныеПараметры.ОтчетСсылка);
	КонтекстДлительнойОперации.Вставить("НомерОтчета", 				ДополнительныеПараметры.НомерДоверенности);
	КонтекстДлительнойОперации.Вставить("ДатаНачалаОтправки", 		ДополнительныеПараметры.ДатаНачалаОтправки);
	КонтекстДлительнойОперации.Вставить("ОповещениеОЗавершении", 	ДополнительныеПараметры.ОповещениеОЗавершении);
	
	ПараметрыДлительнойОтправки = ДлительнаяОтправкаКлиент.ПараметрыДлительнойОтправки();
	ПараметрыДлительнойОтправки.ОтчетСсылка 				= Неопределено;
	ПараметрыДлительнойОтправки.ОбщееКоличествоЭтапов 		= 3;
	ПараметрыДлительнойОтправки.КонтекстДлительнойОперации 	= КонтекстДлительнойОперации;
	ПараметрыДлительнойОтправки.Вставить("СведенияОбОтчете", СведенияОбОтчете);
	
	Если НЕ ДлительнаяОтправкаКлиент.ПоказатьФормуДлительнойОтправки(ПараметрыДлительнойОтправки) Тогда // отправка отчета в ФСС
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОтозватьМашиночитаемуюДоверенностьФССПослеОтправки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтозватьМашиночитаемуюДоверенностьФССПослеОтправки() Экспорт
	
	КонтекстДлительнойОперации = ДлительнаяОтправкаКлиент.КонтекстДлительнойОперации();
	
	ВидОтчета = ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ОтзывМашиночитаемойДоверенностиФСС");
	ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(ВидОтчета);
	
	ПараметрыАвтозапроса = Новый Структура();
