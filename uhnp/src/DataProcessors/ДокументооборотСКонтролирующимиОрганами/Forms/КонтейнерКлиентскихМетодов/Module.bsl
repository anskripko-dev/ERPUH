Функция ПолучитьОсновныеСвойстваЦБИзЦиклаОбмена(ЦиклОбмена)
	
	ДатыСообщений = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
						  |	ТранспортныеСообщения.Тип КАК Тип,
						  |	ТранспортныеСообщения.ДатаТранспорта,
						  |	ТранспортныеСообщения.Дата КАК Дата
						  |ИЗ
						  |	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
						  |ГДЕ
						  |	ТранспортныеСообщения.ЦиклОбмена = &ЦиклОбмена
						  |");
	Запрос.УстановитьПараметр("ЦиклОбмена", ЦиклОбмена);
	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ));
	ДатаОтправкиЗначение = Неопределено;
	ДатаОтправки = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаОтправкиЗначение = СтрСообщение.ДатаТранспорта;
			ДатаОтправки = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=ДДВ");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаОтправкиЗначение", ДатаОтправкиЗначение);
	ДатыСообщений.Вставить("ДатаОтправки", ДатаОтправки);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатЗагрузкиЦБ));
	ДатаЗагрузкиЗначение = Неопределено;
	ДатаЗагрузки = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаЗагрузкиЗначение = СтрСообщение.ДатаТранспорта;
			ДатаЗагрузки = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=ДДВ");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаЗагрузкиЗначение", ДатаЗагрузкиЗначение);
	ДатыСообщений.Вставить("ДатаЗагрузки", ДатаЗагрузки);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументЦБ));
	ДатаПриемаЗначение = Неопределено;
	ДатаПриема = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаПриемаЗначение = СтрСообщение.ДатаТранспорта;
			ДатаПриема = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=ДДВ");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаПриемаЗначение", ДатаПриемаЗначение);
	ДатыСообщений.Вставить("ДатаПриема", ДатаПриема);
	
	СообщенияТекТипа = ТаблицаСообщений.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДокументЦБ));
	ДатаОбработкиЗначение = Неопределено;
	ДатаОбработки = "";
	Если СообщенияТекТипа.Количество() <> 0 Тогда
		Для Каждого СтрСообщение Из СообщенияТекТипа Цикл
			ДатаОбработкиЗначение = СтрСообщение.ДатаТранспорта;
			ДатаОбработки = Формат(СтрСообщение.ДатаТранспорта, "ДЛФ=ДДВ");
		КонецЦикла;
	КонецЕсли;
	ДатыСообщений.Вставить("ДатаОбработкиЗначение", ДатаОбработкиЗначение);
	ДатыСообщений.Вставить("ДатаОбработки", ДатаОбработки);
	
	Возврат ДатыСообщений;
	
