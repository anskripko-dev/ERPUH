&НаСервереБезКонтекста
Функция ПолучитьОсновныеСвойстваИзОтветаНаЗапросИОС(Тело)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	// загружаем XML из строки в дерево
	ДеревоXML = КонтекстЭДОСервер.ЗагрузитьСтрокуXMLВДеревоЗначений(Тело);
	Если ДеревоXML = Неопределено Тогда
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем дату-время получения
	УзлыДатаВремяОтправки = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "датаВремяОтправки", "Э"), Истина);
	Если УзлыДатаВремяОтправки.Количество() = 0 Тогда
		ДатаВремяОтправки = "";
	Иначе
		ДатаВремяОтправки = Формат(ДатаВремяИзСтрокиXML(УзлыДатаВремяОтправки[0].Значение), "ДЛФ=DDT; ДП=-");
	КонецЕсли;
	
	// получаем признак того, что протокол положительный
	УзлыЗапросОбработанУспешно = ДеревоXML.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "запросОбработанУспешно", "Э"), Истина);
	Если УзлыЗапросОбработанУспешно.Количество() = 0 Тогда
		ЯвляетсяПоложительным = "";
	Иначе
		ЗначениеСтр = УзлыЗапросОбработанУспешно[0].Значение;
		ЗначениеБулево = XMLЗначение(Тип("Булево"), ЗначениеСтр);
		ЯвляетсяПоложительным = ?(ЗначениеБулево, "Да", "Нет");
	КонецЕсли;
	
	// находим узел "протокол"
	Приложения = Новый Массив;
	УзелОтвет  = ДеревоXML.Строки.Найти("ответ", "Имя");
	Если УзелОтвет <> Неопределено Тогда
	
		// находим информацию о приложениях в XML
		УзлыСписокПриложений = УзелОтвет.Строки.НайтиСтроки(Новый Структура("Имя, Тип", "списокПриложений", "Э"));
		Если УзлыСписокПриложений.Количество() > 0 Тогда
			
			УзелСписокПриложений = УзлыСписокПриложений[0];
			
			// перебираем приложения
			УзлыПриложение = УзелСписокПриложений.Строки.НайтиСтроки(Новый Структура("Имя", "приложение"));
			Если УзлыПриложение.Количество() > 0 Тогда
				
				Для Каждого УзелПриложение Из УзлыПриложение Цикл
					
					// находим подчиненный узел имяФайла
					УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла");
					Если УзелИмяФайла <> Неопределено Тогда
						Приложения.Добавить(УзелИмяФайла.Значение);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("ЯвляетсяПоложительным, Приложения, ДатаВремяОтправки", ЯвляетсяПоложительным, Приложения, ДатаВремяОтправки);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДатаВремяИзСтрокиXML(ЗначениеСтр)
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), ЗначениеСтр);
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура СформироватьПечатныеДокументыИОС(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	Если Настройки.ПечататьОтветНаЗапросИОС Тогда
		ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ОтветНаЗапросИОС"));
		Для Каждого ФайлОтчетности Из ФайлыОтчетности Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(ФайлОтчетности.Файл);
			
			ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументОтветНаЗапросИОС(Тело, ЦиклОбмена);
			ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;
	
	Если Настройки.ПечататьПодтвержденияПолученияЗапросаПФР Тогда
		ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ПодтверждениеПолученияЗапросаПФР"));
		Для Каждого ФайлОтчетности Из ФайлыОтчетности Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(ФайлОтчетности.Файл);
			
			ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументПодтверждениеПолученияЗапросаПФР(Тело, ЦиклОбмена);
			ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;
		
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
КонецПроцедуры

