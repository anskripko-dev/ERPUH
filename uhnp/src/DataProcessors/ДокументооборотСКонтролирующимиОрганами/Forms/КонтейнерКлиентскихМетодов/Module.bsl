	И ЗначениеЗаполнено(РеквизитыНалогоплательщика.Фамилия) 
	И ЗначениеЗаполнено(РеквизитыНалогоплательщика.Имя) Тогда
    	//налогоплательщик ФЛ
		УзелФЛ = ДобавитьУзелXML(УзелСвАдр, "ФЛ");
		ДобавитьУзелXML(УзелФЛ, "ИННФЛ", 	Истина, РеквизитыНалогоплательщика.ИННФЛ);
		УзелФИО = ДобавитьУзелXML(УзелФЛ, "ФИО");
		ДобавитьУзелXML(УзелФИО, "Фамилия", Истина, РеквизитыНалогоплательщика.Фамилия);
		ДобавитьУзелXML(УзелФИО, "Имя", Истина, РеквизитыНалогоплательщика.Имя);
		Если ЗначениеЗаполнено(РеквизитыНалогоплательщика.Отчество) Тогда
			ДобавитьУзелXML(УзелФИО, "Отчество", Истина, РеквизитыНалогоплательщика.Отчество);
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты налогоплательщика из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты налогоплательщика из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	// добавляем узел ФИОДолж
	ФИОДолж = ПолучитьФИОДолж(ТранспортноеСообщение);
	УзелФИОДолж = ДобавитьУзелXML(УзелДокумент, "ФИОДолж");
	ДобавитьУзелXML(УзелФИОДолж, "Фамилия", Истина, ФИОДолж.Фамилия);
