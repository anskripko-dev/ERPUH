		ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСС"));
	СведенияОбОтчете.Вставить("Наименование", НСтр("ru = 'Запрос машиночитаемой доверенности (ФСС)';
													|en = 'Запрос машиночитаемой доверенности (ФСС)'"));
	СведенияОбОтчете.Вставить("Организация", ДополнительныеПараметры.Организация);
	
