&НаСервере
Функция ОтчетОтправляетсяПоЭДОК(Отчет) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтчетОтправляетсяПоЭДОК(Отчет);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЧтоЗаключеноСоглашениеСПФР(Отчет, Организация, ОписаниеЗавершения) Экспорт
	
	Состояние = СостояниеЭДОсПФР(Организация);
	
	НужноПредупредить = 
		ОтчетОтправляетсяПоЭДОК(Отчет)
		И НужноОткрытьФормуПредложенияОтправитьЗаявлениеВПФР(Состояние, Истина)
		И НЕ ТипЗнч(Отчет) = Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР");
		
	Если НужноПредупредить Тогда
		
		Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки(ОписаниеЗавершения)
			И ДокументооборотСКОКлиент.ЗапоминаниеОшибок(,, Истина) = 0 Тогда
			
			Ошибка = ДлительнаяОтправкаКлиентСервер.СообщениеНеПодключенаКЭДОПФР();
			ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(Ошибка);
			
		Иначе
			ОткрытьФормуПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиОтправки(
				Состояние, 
				Организация,
				ОписаниеЗавершения,
				Отчет);
		КонецЕсли;
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеЗавершения, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФР_ПослеПроверкиСертификатаИЛицензии(Результат, ВходящийКонтекст) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура,
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если НЕ Результат Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	КонтекстОтправки      = ВходящийКонтекст.КонтекстОтправки;
	
	// отражаем изменения в базе
	Если НЕ ОтправкаРегламентированногоОтчетаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(КонтекстОтправки) Тогда // сервер
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР

		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", 	ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", 		КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОтправкаРегламентированногоОтчетаВПФРПослеФормированияПакета", ЭтотОбъект, Контекст);
	
	Отправка_СформироватьПакет(Оповещение, КонтекстОтправки.ТранспортноеСообщение, "ПФР");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправкаРегламентированногоОтчетаВПФР_ПередВыгрузкойФайла(Контекст, Документ, УникальныйИдентификатор)
	
	ВыводитьСообщения = Ложь;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ТекстСообщения = "";
	Результат = КонтекстЭДОСервер.ОтправкаРегламентированногоОтчетаВПФР_ПередВыгрузкойФайла(Контекст, Документ, УникальныйИдентификатор, ТекстСообщения);
	
	Если ЗначениеЗаполнено(ТекстСообщения) И ВыводитьСообщения Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФР_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	Параметры_Док 					= ВходящийКонтекст.Док;
	Параметры_ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	
	ОтправкаРегламентированногоОтчетаВПФР(Параметры_Док, Параметры_ВыполняемоеОповещение);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоНалоговойИлиБухгалтерскойОтчетности(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	Если Настройки.Свойство("ФорматДокументооборота") Тогда
		ФорматДокументооборота = Настройки.ФорматДокументооборота;
	КонецЕсли;
	
	ВсеВАрхиве = Неопределено;
	Если ФорматДокументооборота = СтруктураСсылочныхДанных["Перечисления_ФорматыДокументооборотаСФНС_Приказ534"] Тогда 
		ПолучитьФайлыЦиклаОбмена534(ЦиклОбмена, Настройки, ВсеВАрхиве);
	Иначе
		ПолучитьФайлыЦиклаОбмена(ЦиклОбмена, Настройки, ВсеВАрхиве);
	КонецЕсли;
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление отчета (141 и 534)
	Если Настройки.ПечататьДокумент Тогда
		НастройкаПечататьДокумент(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// 534
	
	// выводим подтверждение даты отправки
	Если Настройки.ПечататьПодтверждениеДатыОтправки Тогда		
		ПечатныеДокументы_ПечататьПодтверждениеДатыОтправки_НалогБухОтчетность(Результат, НижнийКолонтитул);			
	КонецЕсли;
	
	// выводим результат приема
	Если Настройки.ПечататьРезультатПриема Тогда		
		ПечатныеДокументы_ПечататьРезультатПриема_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим результат обработки
	Если Настройки.ПечататьРезультатОбработки Тогда		
		ПечатныеДокументы_ПечататьРезультатОбработки_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим извещения о получении
	Если Настройки.ПечататьИзвещенияОПолучении Тогда
		ПечатныеДокументы_ПечататьИзвещенияОПолучении(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// 141
	
	// выводим подтверждение отправки
	Если Настройки.ПечататьПодтверждениеОтправки Тогда		
		ПечатныеДокументы_ПечататьПодтверждениеОтправки_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим протокол
	Если Настройки.ПечататьПротокол Тогда		
		ПечатныеДокументы_ПечататьПротокол_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим уведомление об уточнении
	Если Настройки.ПечататьУведомлениеОбУточнении Тогда		
		ПечатныеДокументы_ПечататьУведомлениеОбУточнении_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим протокол приема 2-НДФЛ
	Если Настройки.ПечататьПротоколПриема2НДФЛ Тогда		
		ПечатныеДокументы_ПечататьПротоколПриема2НДФЛ_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим реестр сведений 2-НДФЛ
	Если Настройки.ПечататьРеестрСведений2НДФЛ Тогда		
		ПечатныеДокументы_ПечататьРеестрСведений2НДФЛ_НалогБухОтчетность(Результат, НижнийКолонтитул);		
	КонецЕсли;
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда		
		ПечатныеДокументы_ПечататьСостояние_НалогБухОтчетность(Результат, ЦиклОбмена)		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоЗаявлениям(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена534(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление отчета
	Если Настройки.ПечататьДокумент Тогда
		ПечатныеДокументы_ПечататьДокумент_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим подтверждение даты отправки
	Если Настройки.ПечататьПодтверждениеДатыОтправки Тогда
		ПечатныеДокументы_ПечататьПодтверждениеДатыОтправки_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим результат приема
	Если Настройки.ПечататьРезультатПриема Тогда
		ПечатныеДокументы_ПечататьРезультатПриема_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим результат обработки
	Если Настройки.ПечататьРезультатОбработки Тогда
		ПечатныеДокументы_ПечататьРезультатОбработки_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим сообщение об отзыве
	Если Настройки.ПечататьСообщениеОбОтзыве Тогда
		ПечатныеДокументы_ПечататьСообщениеОбОтзыве_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;

	// выводим сообщение о несоответствиях
	Если Настройки.ПечататьСообщениеОНесоответствиях Тогда
		ПечатныеДокументы_ПечататьСообщениеОНесоответствиях_ПоЗаявлениям(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, "Отчет о состоянии");
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);

КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоФорме2НДФЛ(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена534(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление 2-НДФЛ
	Если Настройки.ПечататьДокумент Тогда
		ПечатныеДокументы_ПечататьДокумент_2НДФЛ(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим подтверждение даты отправки
	Если Настройки.ПечататьПодтверждениеДатыОтправки Тогда
		ПечатныеДокументы_ПечататьПодтверждениеДатыОтправки_2НДФЛ(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим результат приема
	Если Настройки.ПечататьРезультатПриема Тогда
		ПечатныеДокументы_ПечататьРезультатПриема_2НДФЛ(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	Если Настройки.ПечататьИзвещенияОПолучении Тогда
		ПечатныеДокументы_ПечататьИзвещенияОПолучении(Результат, НижнийКолонтитул);
	КонецЕсли;
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, "Отчет о состоянии");
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоОтчетностиПФР(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление отчета
	Если Настройки.ПечататьДокумент Тогда
		ПечатныеДокументы_ПечататьДокумент_ОтчетПФР(Результат, НижнийКолонтитул, ЦиклОбмена);
	КонецЕсли;
	
	// выводим подтверждение получения
	Если Настройки.ПечататьИзвещениеОбОтказеПФР Тогда
		ПечатныеДокументы_ПечататьИзвещениеОбОтказеПФР_ОтчетПФР(Результат, НижнийКолонтитул, ЦиклОбмена);
	КонецЕсли;
	
	// выводим протокол
	Если Настройки.ПечататьПротокол Тогда
		ПечатныеДокументы_ПечататьПротокол_ОтчетПФР(Результат, НижнийКолонтитул, ЦиклОбмена);
	КонецЕсли;
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, "Отчет о состоянии");
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатныеДокументыПоОтчетностиФСГС(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
	
	ВсеВАрхиве = Неопределено;
	ПолучитьФайлыЦиклаОбмена(ЦиклОбмена, Настройки, ВсеВАрхиве);
	
	Если ВсеВАрхиве Тогда
		ПоказатьУведомлениеАрхивныхФайлов(, 17, 3, Истина);
		Возврат;
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	// выводим электронное представление отчета
	Если Настройки.ПечататьДокумент Тогда
		ФайлыОтчетности = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ФайлОтчетностиФСГС"));
		Для Каждого ФайлОтчетности Из ФайлыОтчетности Цикл
			//Кодировка = ?(НРег(Прав(ФайлОтчетности.ИмяФайла, 4)) = ".xml", ?(ВРег(Лев(ФайлОтчетности.ИмяФайла, 6)) = "NO_BUH" ИЛИ ВРег(Лев(ФайлОтчетности.ИмяФайла, 6)) = "NO_BOU", "windows-1251", "utf-8"), "cp866");
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(ФайлОтчетности.Файл,, Истина);	// Определение по имени заменено на авто
			ПолучитьЭЦП(Файлы.Индекс(ФайлОтчетности));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(ФайлОтчетности.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументНаОсновеБланка("Электронное представление", ФайлОтчетности.ИмяФайла, Тело, НижнийКолонтитул);
			ПараметрыПечати.Отправка = ФайлОтчетности.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;
	
	// выводим подтверждение даты отправки
	Если Настройки.ПечататьПодтверждениеОтправки Тогда
		ПодтвержденияДатыОтправки = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ПодтверждениеДатыОтправкиФСГС"));
		Для Каждого ПодтверждениеДатыОтправки Из ПодтвержденияДатыОтправки Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(ПодтверждениеДатыОтправки.Файл,, Истина);	// Фиксированная "windows-1251" заменена на авто
			ПолучитьЭЦП(Файлы.Индекс(ПодтверждениеДатыОтправки));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(ПодтверждениеДатыОтправки.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументНаОсновеПодтвержденияДатыОтправкиФСГС("Подтверждение даты отправки", ПодтверждениеДатыОтправки.ИмяФайла, Тело, ЦиклОбмена);
			ПараметрыПечати.Отправка = ПодтверждениеДатыОтправки.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;
	
	// выводим протокол
	Если Настройки.ПечататьПротокол Тогда
		Протоколы = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ПротоколФСГС"));
		Для Каждого СтрПротокол Из Протоколы Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрПротокол.Файл,, Истина);
			ПолучитьЭЦП(Файлы.Индекс(СтрПротокол));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрПротокол.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументНаОсновеПротоколаФСГС("Протокол входного контроля", СтрПротокол.ИмяФайла, Тело, ЦиклОбмена);
			ПараметрыПечати.Отправка = СтрПротокол.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;
	
	// выводим подтверждение получения (ФСГС)
	Если Настройки.ПросмотрПодтвержденияПолученияФСГС Тогда
		Протоколы = Файлы.НайтиСтроки(Новый Структура("ИдТипа", "ПодтверждениеПолученияФСГС"));
		Для Каждого СтрПротокол Из Протоколы Цикл
			Тело = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрПротокол.Файл,, Истина);
			ПолучитьЭЦП(Файлы.Индекс(СтрПротокол));
			
			Представление = ПредставлениеТранспортногоСообщнияПоТипу(СтрПротокол.ТранспортноеСообщение);
			ПараметрыПечати = КонструкторПечатиПротокола();
			ПараметрыПечати.ТабДок   = СформироватьТабличныйДокументПодтверждениеПолученияФСГС(Тело, ЦиклОбмена);
			ПараметрыПечати.Отправка = СтрПротокол.ТранспортноеСообщение;
			
			Результат.Добавить(ПараметрыПечати, Представление);
			
		КонецЦикла;
	КонецЕсли;	
	
	// выводим отчет о состоянии
	Если Настройки.ПечататьСостояние Тогда
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, "Отчет о состоянии");
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
КонецПроцедуры

// Эта и следущие процедуры и ф-ции Перенесены из Модуля
// для использования формой "Предварительный просмотр печатных форм"
&НаКлиенте
Процедура СформироватьПечатныеДокументы(ЦиклОбмена, Настройки, ВыполняемоеОповещение) Экспорт
	
	Результат = Новый СписокЗначений;
	
	ТипЦиклаОбмена = ПолучитьРеквизитНаСервере(ЦиклОбмена, "Тип");
	Если ТипЦиклаОбмена.Пустая() Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		Возврат;
	КонецЕсли;
	
	НижнийКолонтитул = печатьПредставлениеЦиклаОбмена(ЦиклОбмена);
	
	Если Настройки.ПечататьСостояние Тогда
		
		ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
		Если ТаблДок <> Неопределено Тогда
			Результат.Добавить(ТаблДок, "Отчет о состоянии");
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_Заявление"] Тогда
		
		СформироватьПечатныеДокументыПоЗаявлениям(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_Форма2НДФЛ"] Тогда 
		
		СформироватьПечатныеДокументыПоФорме2НДФЛ(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_ОтчетностьПФР"] Тогда 
		
		 СформироватьПечатныеДокументыПоОтчетностиПФР(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		 
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_ИОС"] Тогда
		 
		СформироватьПечатныеДокументыИОС(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_НеформализованнаяПерепискаПФРИсходящие"]
		ИЛИ ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_НеформализованнаяПерепискаПФРВходящие"] Тогда
		
		СформироватьПечатныеДокументыПисьмаПФР(ЦиклОбмена, Настройки, ВыполняемоеОповещение)
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_ОтчетностьФСГС"]
		ИЛИ ТипЦиклаОбмена = ПредопределенноеЗначение("Перечисление.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС") Тогда
		 
		СформироватьПечатныеДокументыПоОтчетностиФСГС(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли ТипЦиклаОбмена = СтруктураСсылочныхДанных["Перечисления_ТипыЦикловОбмена_ОтчетностьЦБ"] Тогда
		 
		СформироватьПечатныеДокументыПоОтчетностиЦБ(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли ПечатьВозможнаДляЦиклаОбмена(ТипЦиклаОбмена) Тогда
		
		СформироватьПечатныеДокументыПоНалоговойИлиБухгалтерскойОтчетности(ЦиклОбмена, Настройки, ВыполняемоеОповещение);
		
	ИначеЕсли НЕ ПечатьВозможнаДляЦиклаОбмена(ТипЦиклаОбмена) Тогда
		
		// выводим отчет о состоянии
		Если Настройки.ПечататьСостояние Тогда
			ТаблДок = ВывестиОтчетОСостоянии(ЦиклОбмена);
			Если ТаблДок <> Неопределено Тогда
				Результат.Добавить(ТаблДок, "Отчет о состоянии");
			КонецЕсли;
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция печатьПредставлениеЦиклаОбмена(ЦиклОбмена, ДляКолонтитула = Истина) Экспорт
	
	ТипЦиклаОбмена = ЦиклОбмена.Тип;
	Если ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность Тогда
		Результат = ?(ЦиклОбмена.ВидДокумента = 0, "Первичный", "Корректирующий (корр. №" + ЦиклОбмена.ВидДокумента + ")") + " отчет вида """ + ЦиклОбмена.ВидОтчета + """"
					+ ?(ДляКолонтитула, Символы.ПС, " ")
					+ "по организации """ + ЦиклОбмена.Организация
					+ """ за " + ПредставлениеПериода(НачалоДня(ЦиклОбмена.ДатаНачалаПериода), КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина")
					+ " в ИФНС " + ЦиклОбмена.ВнешняяОрганизация;
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ Тогда
		Результат = "2-НДФЛ"
					+ ?(ДляКолонтитула, Символы.ПС, " ")
					+ "по организации """ + ЦиклОбмена.Организация
					+ """ за " + ПредставлениеПериода(НачалоДня(ЦиклОбмена.ДатаНачалаПериода), КонецДня(ЦиклОбмена.ДатаОкончанияПериода), "ФП=Истина");
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалоговогоОргана Тогда
		Результат = "Неформализованный документ налогового органа";
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.НеформализованныеДокументыНалогоплательщика Тогда
		Предмет = ЦиклОбмена.Предмет;
		СвойстваДокумента = ПолучитьСвойстваНеформализованногоДокумента(Предмет);
		Если СвойстваДокумента <> Неопределено Тогда
			Результат = Строка(СвойстваДокумента.Тип);
		Иначе
			Результат = "Документ";
		КонецЕсли;
		Результат = Результат + " """ + СвойстваДокумента.ИмяФайла
					+ """ от организации """ + ЦиклОбмена.Организация
					+ """ в ИФНС " + ЦиклОбмена.ВнешняяОрганизация;
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ЗапросыНаИнформационноеОбслуживание Тогда
		Результат = "Запрос """ + ЦиклОбмена.ВидУслуги
					+ """ по организации """ + ЦиклОбмена.Организация
					+ """ за " + Формат(ЦиклОбмена.ДатаНачалаПериода, "ДФ='dd.MM.yyyy'") + " - " + Формат(ЦиклОбмена.ДатаОкончанияПериода, "ДФ='dd.MM.yyyy'");
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ИОН Тогда
		Результат = "Запрос """ + ЦиклОбмена.ВидУслуги
					+ """ по организации """ + ЦиклОбмена.Организация
					+ """ за " + Формат(ЦиклОбмена.ДатаНачалаПериода, "ДФ='dd.MM.yyyy'") + " - " + Формат(ЦиклОбмена.ДатаОкончанияПериода, "ДФ='dd.MM.yyyy'");
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ПисьмоНО Тогда
		Результат = "Вход. письмо от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.Рассылка Тогда
		Результат = "Вход. рассылка от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	ИначеЕсли ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.РассылкаГрупповая Тогда
		Результат = "Вход. групповая рассылка от НО " + ЦиклОбмена.ВнешняяОрганизация + " от " + ЦиклОбмена.ДатаСоздания;
	Иначе
		Результат = ПредставлениеЦиклаОбмена(ЦиклОбмена);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПолучитьФайлыЦиклаОбмена534(ЦиклОбмена, Настройки, ВсеВАрхиве = Ложь)
	
	ВсеВАрхиве = Ложь;
	Файлы.Очистить();
	
	// выполняем запрос, сохраняем файлы во временный каталог и формируем таблицу файлов
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ТаблицаЗапроса = КонтекстЭДОСервер.ПолучитьТаблицуФайловЦиклаОбмена534(ЦиклОбмена, Настройки);
	
	ТранспортныеСообщенияСПрисоединеннымиФайлами = Новый Массив;
	Для каждого СтрокаТаблицыЗапроса Из ТаблицаЗапроса Цикл
		Если ТранспортныеСообщенияСПрисоединеннымиФайлами.Найти(СтрокаТаблицыЗапроса.ТранспортноеСообщение) = Неопределено
			И СтрокаТаблицыЗапроса.Данные.Получить() = Неопределено Тогда
			
			ТранспортныеСообщенияСПрисоединеннымиФайлами.Добавить(СтрокаТаблицыЗапроса.ТранспортноеСообщение);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаФайлов = Неопределено;
	Если ТранспортныеСообщенияСПрисоединеннымиФайлами.Количество() > 0 Тогда
		ТаблицаФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортныеСообщенияСПрисоединеннымиФайлами,
			"ТранспортноеСообщениеПрисоединенныеФайлы",
			,
			"ВладелецФайла, ИсходноеИмяФайла");
		
		Для каждого СтрокаТаблицы Из ТаблицаФайлов Цикл
			СтрокаТаблицы.ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицы.ИсходноеИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
	ВсегоВАрхиве = 0;
	Для каждого СтрокаТаблицыЗапроса Из ТаблицаЗапроса Цикл
		Если СтрокаТаблицыЗапроса.ВАрхиве Тогда
			ВсегоВАрхиве = ВсегоВАрхиве + 1;
			Продолжить;
		КонецЕсли;
		ДвоичныеДанныеФайла = СтрокаТаблицыЗапроса.Данные.Получить();
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицыЗапроса.ИмяФайла);
			
			ПараметрыОтбора = Новый Структура("ВладелецФайла, ИсходноеИмяФайла",
				СтрокаТаблицыЗапроса.ТранспортноеСообщение, ИсходноеИмяФайла);
			СтрокиТаблицы = ТаблицаФайлов.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиТаблицы.Количество() > 0 Тогда
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокиТаблицы[0].Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Если ДвоичныеДанныеФайла <> Неопределено Тогда
			ВременныйФайл = Base64Строка(ДвоичныеДанныеФайла);
			Если ВременныйФайл <> Неопределено Тогда
				НовСтр = Файлы.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СтрокаТаблицыЗапроса);
				НовСтр.Файл = ВременныйФайл;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если (ВсегоВАрхиве > 0) И (Файлы.Количество() = 0) Тогда
		ВсеВАрхиве = Истина;
	КонецЕсли;
	
КонецПроцедуры

