			ПараметрыФункции);
			
	Иначе
		
		СформироватьИОтправитьЗаявление_СообщитьОНевозможностиЭлектронногоПодписания(
			ПараметрыФункции, 
			Результат.ТекстОшибки);
			
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура СформироватьИОтправитьЗаявлениеПослеУстановкиКорневогоСертификатаВР(Результат, Контекст) Экспорт
	
	ДокументЗаявление 		  = Контекст.ДокументЗаявление;
	ЭтоЗаявлениеНаПодключение = ДокументЗаявление.ЭтоУпрощенноеЗаявление;
	ЭтоЗаявлениеНаИзменение   = НЕ ЭтоЗаявлениеНаПодключение;
	ИспользоватьСуществующий  = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(ДокументЗаявление);
	
	УчетнаяЗапись = ОбработкаЗаявленийАбонентаКлиентСервер.ПолучитьПараметрПодключения(
		ДокументЗаявление, 
		"УчетнаяЗапись");
		
	МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.ОпределитьМестоХраненияКлюча(
		ДокументЗаявление.МодельХраненияЗакрытогоКлюча,
		УчетнаяЗапись);
	
	СертификатДляПодписания = ОбработкаЗаявленийАбонентаВызовСервера.СертификатИзЗаявления(ДокументЗаявление);
	
	ПодписатьПлатформой = 
		ДокументЗаявление.ПодписатьЭП 
		И ЭтоЛокальнаяПодпись(СертификатДляПодписания)
		И ИспользоватьСуществующий
		И ДокументЗаявление.ЭтоСертификатДругогоУЦ;
	
	ПодписатьМетодомБРО = 
		ДокументЗаявление.ПодписатьЭП
		И НЕ ПодписатьПлатформой;
		
	Контекст.Вставить("ПодписатьМетодомБРО", 			ПодписатьМетодомБРО);
	Контекст.Вставить("ПодписатьПлатформой", 			ПодписатьПлатформой);
	Контекст.Вставить("АлгоритмКонтейнераКлючей", 		Неопределено);
	Контекст.Вставить("ЭтоЗаявлениеНаПодключение", 		ЭтоЗаявлениеНаПодключение);
	Контекст.Вставить("ЭтоЗаявлениеНаИзменение", 		ЭтоЗаявлениеНаИзменение);
	Контекст.Вставить("ВыводитьСообщения", 				Ложь);
	Контекст.Вставить("Статус", 						ДокументЗаявление.Статус);
	Контекст.Вставить("ДатаОтправки", 					ДокументЗаявление.ДатаОтправкиЗаявления);
	Контекст.Вставить("СтатусКомментарий", 				ДокументЗаявление.СтатусКомментарий);
	Контекст.Вставить("ПутьКонтейнерЗакрытогоКлюча",	ДокументЗаявление.ПутьКонтейнерЗакрытогоКлюча);
	Контекст.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности",  "");
	Контекст.Вставить("ТекстЗапросаНаСертификат", 		"");
	Контекст.Вставить("ИспользоватьСуществующий", 		ИспользоватьСуществующий);
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Контекст);

	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		СформироватьИОтправить_ПодписатьЗаявление(Контекст);
		
	ИначеЕсли ЭтоОблачнаяПодпись(Контекст) 
		И ОбработкаЗаявленийАбонентаКлиентСервер.ПолучитьПараметрПодключения(ДокументЗаявление, "СоздатьНовуюУчетнуюЗапись") Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявление_ПослеПолученияНастроекШифрования", 
			ЭтотОбъект, 
			Контекст);
			
		ОткрытьНастройкиОблачнойПодписиФоновымЗаданием(ОписаниеОповещения, Контекст);

	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьИОтправитьЗаявление_ПослеПолученияВременногоКаталога", 
			ЭтотОбъект, 
			Контекст);
			
		ОперацииСФайламиЭДКОКлиент.СоздатьКаталогНаКлиенте(ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаявлениеОпределитьАлгоритмДляСозданияКонтейнераКлючей(ДанныеОрганизации) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Возврат КриптографияЭДКОКлиентСервер.АлгоритмПоУмолчанию();
	
КонецФункции

&НаСервере
Функция ДатыСертификата(Сертификат)

	// На клиенте их надо привести к местному времени
	
	ДатаС  = Дата(1,1,1);
	ДатаПо = Дата(1,1,1);
	
	Если Сертификат.Свойство("ДействителенС") Тогда
		// Получено нашей компонентой
		ДатаС = Сертификат.ДействителенС;
	ИначеЕсли Сертификат.Свойство("ДатаНачала") Тогда
		// Получено компонентой платформы
		ДатаС = Сертификат.ДатаНачала;
	КонецЕсли;
		
	Если Сертификат.Свойство("ДействителенПо") Тогда
		// Получено нашей компонентой
		ДатаПо = Сертификат.ДействителенПо;
	ИначеЕсли Сертификат.Свойство("ДатаОкончания") Тогда
		// Получено компонентой платформы
		ДатаПо = Сертификат.ДатаОкончания;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДатаС",  ДатаС);
	ДополнительныеПараметры.Вставить("ДатаПо", ДатаПо);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

