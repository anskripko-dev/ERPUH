Функция ПолучитьОсновныеСвойстваИзКвитанцииОПриеме(СтрКвитанция)
	
	Если НЕ ЗначениеЗаполнено(СтрКвитанция) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СвПолДок       = "";
	ДатаПрин       = "";
	НаимВидДок     = "";
	ИмяПринятФайла = "";
	ДатаНапр       = "";
	ВремНапр       = "";
	СвОтпрДок      = "";
	НОПром         = "";
	СвАдр          = "";
	ДатаПост       = "";
	РегНом         = "";
	ФИОДолж        = "";

	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрКвитанция, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка разбора XML квитанции о приеме:%1';
				|en = 'Ошибка разбора XML квитанции о приеме:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ПолучитьУзел(ДеревоXML,"Файл");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = ПолучитьУзел(УзелФайл, "Документ");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СведенияИзТэгаСвКвит = ПолучитьСведенияИзТэгаСвКвитКвитанцииОПриеме(УзелДокумент);
	Если СведенияИзТэгаСвКвит = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		ДатаПрин       = СведенияИзТэгаСвКвит.ДатаПрин;
		НаимВидДок     = СведенияИзТэгаСвКвит.НаимВидДок;
		ДатаНапр       = СведенияИзТэгаСвКвит.ДатаНапр;
		ВремНапр       = СведенияИзТэгаСвКвит.ВремНапр;
		ДатаПост       = СведенияИзТэгаСвКвит.ДатаПост;
		РегНом         = СведенияИзТэгаСвКвит.РегНом;
		ИмяПринятФайла = СведенияИзТэгаСвКвит.ИмяПринятФайла;
	КонецЕсли;
	
	СвПолДок 	= ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, "СвПолДок");
	СвОтпрДок 	= ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, "СвОтпрДок");
	СвАдр 		= ПолучитьОтправителяИзТэгаСвОтпрДокИлиСвАдр(УзелДокумент, "СвАдр");
	ФИОДолж 	= ПолучитьФИОДолжИзТэгаФИОДолж(УзелДокумент);
		
	СвойстваКвитанции = Новый Структура();
	СвойстваКвитанции.Вставить("СвПолДок", СвПолДок);
	СвойстваКвитанции.Вставить("ДатаПрин", ДатаПрин);
	СвойстваКвитанции.Вставить("НаимВидДок", НаимВидДок);
	СвойстваКвитанции.Вставить("ДатаНапр", ДатаНапр);
	СвойстваКвитанции.Вставить("ВремНапр", ВремНапр);
	СвойстваКвитанции.Вставить("ДатаПост", ДатаПост);
	СвойстваКвитанции.Вставить("РегНом", РегНом);
	СвойстваКвитанции.Вставить("ИмяПринятФайла", ИмяПринятФайла);
	СвойстваКвитанции.Вставить("СвОтпрДок", СвОтпрДок);
	СвойстваКвитанции.Вставить("СвАдр", СвАдр);
	СвойстваКвитанции.Вставить("ФИОДолж", ФИОДолж);
	
	Возврат СвойстваКвитанции;
	
