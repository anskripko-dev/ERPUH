&НаКлиенте
Функция ПроверитьНомерОрганаПФР(Знач Номер)
	Результат = Ложь;
	Номер = СокрЛП(Номер);
	Если СтрДлина(Номер)= 7 тогда
		Результат =  ПроверитьЦифровойКодЗаданнойДлины(Лев(Номер,3),3) И
		ПроверитьЦифровойКодЗаданнойДлины(Прав(Номер,3),3) И
		Сред(Номер,4,1)="-";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВосстановитьНаправленияПоУмолчанию(Получатели, ДанныеОрганизации) Экспорт 
	
	ВосстановитьНаправленияПоУмолчаниюПФР(Получатели, ДанныеОрганизации);
	ВосстановитьНаправленияПоУмолчаниюФСС(Получатели, ДанныеОрганизации);
	ВосстановитьНаправленияПоУмолчаниюФСГС(Получатели, ДанныеОрганизации);
	ВосстановитьНаправленияПоУмолчаниюФНС(Получатели, ДанныеОрганизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНаправленияПоУмолчаниюФНС(Получатели, ДанныеОрганизации) Экспорт 
	
	КодПолучателяФНС 	= ДанныеОрганизации.КодНО;
	ЭтоЮрЛицо 			= ДанныеОрганизации.ТипОрганизации;
	
	Если СтрДлина(СокрЛП(КодПолучателяФНС)) = 4 
		И (ЭтоЮрЛицо И СтрДлина(ДанныеОрганизации.КППЮЛ) <> 0 ИЛИ НЕ ЭтоЮрЛицо) 
		И НЕ Прав(СокрЛП(КодПолучателяФНС),2) = "00" Тогда
		
		НовоеНаправление(
			Получатели,
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФНС"),
			КодПолучателяФНС,
			ДанныеОрганизации.КППЮЛ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНаправленияПоУмолчаниюФСГС(Получатели, ДанныеОрганизации, Спецоператор = Неопределено, Знач КодРегиона = Неопределено) Экспорт
	
	// ФСГС
	Если НЕ ПустаяСтрока(ДанныеОрганизации.КодОрганаФСГС) 
		И КодОрганаФСГССоответствуетТребованиямКлиент(ДанныеОрганизации.КодОрганаФСГС) Тогда
		
		НовоеНаправление(
			Получатели,
			ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСГС"),
			ДанныеОрганизации.КодОрганаФСГС);
			
	Иначе
		
		// Определяем направление по региону.
		Если НЕ ЗначениеЗаполнено(КодРегиона) Тогда
			Если ДанныеОрганизации.ТипОрганизации Тогда
				АдресЮридический = ДанныеОрганизации.АдрЮР;
			Иначе
				АдресЮридический = ДанныеОрганизации.АдрМЖ;
			КонецЕсли;
			
			АдресЮридический = РегламентированнаяОтчетностьВызовСервера.ЗаменитьТекстРегионаНаКодРегиона(АдресЮридический);
			
			КодРегиона = РегламентированнаяОтчетностьКлиентСервер.РазложитьАдрес(АдресЮридический).Регион;
		КонецЕсли;
		
		ТОГС = ТОГСПоРегиону(КодРегиона, Спецоператор);
		
		Если ЗначениеЗаполнено(ТОГС) Тогда
			
			НовоеНаправление(
				Получатели,
				ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФСГС"),
				ТОГС);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТОГСПоРегиону(КодРегиона, Спецоператор)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ТОГСПоРегиону(КодРегиона, Спецоператор);
			
КонецФункции

