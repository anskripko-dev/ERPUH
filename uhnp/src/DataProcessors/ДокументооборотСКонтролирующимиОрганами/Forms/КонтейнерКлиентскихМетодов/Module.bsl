&НаСервереБезКонтекста
Функция ИмяФайлаВложенияНеДокФорм(
			ИдентификаторОтправителяПолучателя, 
			ИмяФайла,
			КодДок,
			N1)
		
	// формируем GUID файла, уникальный для каждого файла
	N2 = Строка(Новый УникальныйИдентификатор);
	
	//извлекаем расширение из оригинального имени файла вложения
	РасширениеФайла = РасширениеФайла(ИмяФайла);
	
	// составляем новое короткое имя файла вложения
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	
	ИмяФайла = ВРЕГ(КодДок + "_" + ИдентификаторОтправителяПолучателя + "_" + N1 + "_" + GGGGMMDD + "_" + N2) + "." + РасширениеФайла;
	
	Возврат ИмяФайла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдФайлИАдрес_ЭПНеДокФорм(ПрисоединенныйФайл, ИмяФайла, ДобавитьПодпись)
	
	// ЭП
	ИдФайлЭП = "";
	АдресЭП  = "";

	Если ДобавитьПодпись Тогда
		
		ЭПДокСкана = ЭПДокСкана(ПрисоединенныйФайл);
		
		Если ЗначениеЗаполнено(ЭПДокСкана.АдресДанных) И ЗначениеЗаполнено(ЭПДокСкана.ИмяФайла) Тогда
			
			// Имя подписи образуется от имени файла и не зависит от первоначального имени файла подписи
			ИмяФайлаЭППоФормату = ИмяФайлаЭПФайлаОписиИсходящихДокументов(ИмяФайла);
			
			ИдФайлЭП 	= ИмяФайлаЭППоФормату;
			АдресЭП  	= ЭПДокСкана.АдресДанных;
			
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ИдФайлЭП", ИдФайлЭП);
	Результат.Вставить("АдресЭП", АдресЭП);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция РазбитьСтрокиНеДокФормПоЭлПодписи(
		ТаблицаНеДокФорм,
		ЗначениеЗаполнения,
		МассивФайлов,
		ЭлементВыгрузки,
		НовСтр,
		АдресЭП,
		ИдФайлЭП,
		ДобавитьПустышку)
		
	ЭтоФормат_ON_DOCNPNO_1_886_00_05_02 = ТребованияФНСКлиентСервер.ЭтоФормат_ON_DOCNPNO_1_886_00_05_02();
		
	ВынестиВОтдельныйУзел = ЭтоФормат_ON_DOCNPNO_1_886_00_05_02
		И (ЗначениеЗаполнено(АдресЭП) ИЛИ ЭлементВыгрузки.ВидPDF = Перечисления.ВидыPDF.ДокPDF);
			
	Если ВынестиВОтдельныйУзел
		И МассивФайлов.Количество() > 0 Тогда
		
		// Финализируем старый блок
		// файлы с подписью добавляем в новый блок
		НовСтр = ТаблицаНеДокФорм.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ЗначениеЗаполнения);

		МассивФайлов = Новый Массив;
		
	КонецЕсли;
	
	МассивФайлов.Добавить(ЭлементВыгрузки);
	
	НовСтр.МассивФайлов = МассивФайлов;
	НовСтр.ИдФайлЭП 	= ИдФайлЭП;
	НовСтр.АдресЭП 		= АдресЭП;
	
	Если ВынестиВОтдельныйУзел И ДобавитьПустышку Тогда
		
		// следующие файлы будем добавлять в новый блок
		НовСтр = ТаблицаНеДокФорм.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ЗначениеЗаполнения);

		МассивФайлов = Новый Массив;
		
		ИдФайлЭП = "";
		АдресЭП  = "";
		
	КонецЕсли;
		
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьПодписьМЧДФСС(ОтчетСсылка, ПодписанныйЗапросSOAP64)
	
	Если ТипЗнч(ПодписанныйЗапросSOAP64) = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(ПодписанныйЗапросSOAP64) Тогда
			ДанныеПодписанногоЗапросаSOAP = ПолучитьИзВременногоХранилища(ПодписанныйЗапросSOAP64);
		Иначе
			ДанныеПодписанногоЗапросаSOAP = Base64Значение(ПодписанныйЗапросSOAP64);
		КонецЕсли;
	Иначе
		ДанныеПодписанногоЗапросаSOAP = ПодписанныйЗапросSOAP64;
	КонецЕсли;
	
	ОбъектМЧДФСС = ОтчетСсылка.ПолучитьОбъект();
	ОбъектМЧДФСС.ИмяФайлаВыгрузки 	= "P_" + СокрЛП(ОбъектМЧДФСС.НомерДоверенности) + ".xml";
	ОбъектМЧДФСС.ОтпечатокСертификата =
		ДокументооборотСКОВызовСервера.ЗапоминаниеОшибок(,, Истина, "МЧДОтпечатокРуководителя");
	ОбъектМЧДФСС.ЭлектроннаяПодпись = Новый ХранилищеЗначения(ДанныеПодписанногоЗапросаSOAP);
	ОбъектМЧДФСС.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Подписано;
	ОбъектМЧДФСС.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьУПУППослеОбмена(ОписаниеОповещения = Неопределено) Экспорт
	
	Если ЕстьУПУПыКОтправкеПослеОдобренияЗПЭД() Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОтправитьУПУППослеОбмена", 15, Истина);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОтправитьУПУППослеОбмена() Экспорт
	
	// Если бублик обмена открыт, то при попытке отправки УПУП возникает ошибка 
	// "Отправка не может быть начата. Дождитесь завершения предыдущей операции.".
	// Поэтому надо дождаться закрытия бублика и только после этого предлагать отправить УПУП.
	БубликОткрыт = ДлительнаяОтправкаКлиент.ФормаДлительнойОтправкиЕстьСредиОткрытых(Истина);
	
	Если БубликОткрыт Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОтправитьУПУППослеОбмена", 15, Истина);
	Иначе
		ОткрытьФорму(ПутьКОбъекту + ".Форма.ОтправкаУПУППослеОдобренияЗПЭД");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УПУПыКОтправкеПослеОдобренияЗПЭД() Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.УПУПыКОтправкеПослеОдобренияЗПЭД();
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьУПУПыКОтправкеПослеОдобренияЗПЭД() Экспорт
	
	Возврат УПУПыКОтправкеПослеОдобренияЗПЭД().Количество() > 0;
	
КонецФункции

#Область МетаданныеВходящихСообщенийСЭДОЗаПериодБезКриптографии

// Вызывается только для обмена через оператора, при вызове напрямую может возникать ошика 403.
&НаСервереБезКонтекста
Функция МетаданныеВходящихСообщенийСЭДОЗаПериодБезКриптографии(Организация,
		ДатыПолученияСообщений, ЭтоПодпискаНаОператора, СвойстваОбменаПоСЭДОЧерезОператора)
		
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	
	ПустаяДата = Дата(1, 1, 1);
	БылиОшибки = Ложь;
	ДатаУспешнойЗагрузкиИдентификаторов = ПустаяДата;
	ДатаПолучениеСпискаСообщенийПодпискаНаОператора = ЭлектронныйДокументооборотСФСС.ДатаСобытияСЭДО(
		Организация, Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщенийПодпискаНаОператора);
	Для каждого ДанныеТекущаяДата Из ДатыПолученияСообщений Цикл
		ТекущаяДата = ДанныеТекущаяДата.Дата;
		Если ЭтоПодпискаНаОператора
			И Текущаядата < ДатаПолучениеСпискаСообщенийПодпискаНаОператора Тогда
			Продолжить;
		КонецЕсли;
		РезультатПолучения = КонтекстЭДОСервер.МетаданныеВходящихСообщенийСЭДОФСС(Организация,
			ТекущаяДата, ,
			СвойстваОбменаПоСЭДОЧерезОператора);
		Если НЕ РезультатПолучения.Выполнено Тогда
			Шаблон = НСтр("ru='При получении списка входящих сообщений из СЭДО ФСС по организации "
				+ "%1 за дату %2 произошла ошибка: %3.'");
			Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
			ОписаниеОшибки = СтрШаблон(Шаблон, Организация, ТекущаяДата, РезультатПолучения.ОписаниеОшибки);
			ЗаписатьСобытиеСЭДОВЖурнал("Ошибка", ОписаниеОшибки);
			Результат.ОписаниеОшибки = РезультатПолучения.ОписаниеОшибки;
			БылиОшибки = Истина;
			Прервать;
		КонецЕсли;
		ДатаУспешнойЗагрузкиИдентификаторов = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьДатуПолученияСообщений(
				ДанныеТекущаяДата);
	КонецЦикла;
	
	Если НЕ ДатаУспешнойЗагрузкиИдентификаторов = ПустаяДата Тогда
		Если ЭтоПодпискаНаОператора Тогда
			// Сохраняется дата получения сообщений при подписке на оператора.
			ДанныеСобытия = ЭлектронныйДокументооборотСФСС.НовыеДанныеСобытияСЭДО();
			ДанныеСобытия.Событие 						= Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщенийПодпискаНаОператора;
			ДанныеСобытия.Организация 					= Организация;
			ДанныеСобытия.ОбменЧерезОператора 			= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
			ДанныеСобытия.СохранятьЕслиДатаМаксимальная = Истина;
			ДанныеСобытия.ДатаСобытия 					= НачалоДня(ДатаУспешнойЗагрузкиИдентификаторов);
			ЭлектронныйДокументооборотСФСС.СохранитьДанныеСобытияСЭДО(ДанныеСобытия);
		Иначе
			СохранитьДатуСеансаОбменаСЭДОФСС(
				Организация,
				ДатаУспешнойЗагрузкиИдентификаторов,
				СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ БылиОшибки Тогда
		Результат.Выполнено = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура СформироватьПакетПФР_ПослеУстановкиСертификатаЕЦП(Результат, ВходящийКонтекст) Экспорт
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов",
		ЭтотОбъект, ВходящийКонтекст);
	
	СертификатыДляПоиска = Новый Массив;
	Для Каждого Отпечаток Из ВходящийКонтекст.Отпечатки Цикл
		НовыйСертификат = Новый Структура("Отпечаток", Отпечаток);
		КонтекстМоделиХраненияКлюча(ВходящийКонтекст.МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЦикла;
	
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска, Истина);
	
КонецПроцедуры
