			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Отказ = Истина;
			Возврат Неопределено;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("Отметка, ОбщиеСведения", Отметка, ОбщиеСведения);
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьУчетнуюЗаписьОрганизации(Организация,УчетнаяЗапись) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
		Объект 									 = Организация.ПолучитьОбъект();
		Объект.УчетнаяЗаписьОбмена 				 = УчетнаяЗапись;
		Объект.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате;
		
		Объект.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновление(ПараметрыФункции, ВыполняемоеОповещение, ПовторятьСоединение = Истина) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	
	//в клиент-серверном режиме необходимы промежуточные переменные
	ВыводитьСообщения = НЕ (ПараметрыФункции.ТихийРежим 
		ИЛИ ПараметрыФункции.РежимАвтонастройки И НЕ ПараметрыФункции.ИгнорироватьРежимАвтонастройки
		ИЛИ ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности);
	
	// получаем и разбираем данные с сервера СОС
	ПараметрыРегистрацияПолучитьДанныеССервера = ПараметрыРегистрацияПолучитьДанныеССервера();
	ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции);
	ПараметрыРегистрацияПолучитьДанныеССервера.ФайлИзКэша = Ложь;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВыводитьСообщения = ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес = ЭтаФорма.УникальныйИдентификатор;
	ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ЭтаФорма.УникальныйИдентификатор;
	ПараметрыРегистрацияПолучитьДанныеССервера.СсылкаНаЗаявление = ПараметрыФункции.СсылкаНаЗаявление;
	
	ДополнительныеПараметры = Новый Структура("ПараметрыФункции, ВыполняемоеОповещение, ВыводитьСообщения, ПараметрыРегистрацияПолучитьДанныеССервера, ПовторятьСоединение", ПараметрыФункции, ВыполняемоеОповещение, ВыводитьСообщения, ПараметрыРегистрацияПолучитьДанныеССервера, ПовторятьСоединение);
	ОбработатьОбновлениеВЦикле(Истина, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСообщениеЗашифрованоНаОблачныйСертификат(Адрес, СерийныйНомерТекущегоПользователя = "")
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ЭтоСообщениеЗашифрованоНаОблачныйСертификат(Адрес, СерийныйНомерТекущегоПользователя);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеВЦикле(Результат, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ПараметрыФункции      = ДополнительныеПараметры.ПараметрыФункции;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если Результат <> Истина Тогда
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаПолученияДанныхССервера");
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбработатьОбновлениеВЦиклеПослеУстановкиКорневогоСертификатаВР",
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	УстановитьСертификатыВРПриНеобходимости(ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьОписаниеПричиныОшибки(Результат)
	
	Перем ОписаниеОшибки;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ОписаниеОшибки", ОписаниеОшибки) Тогда
			Возврат ОписаниеОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеПолученияВременногоКаталогаЗавершение(РезультатОперацииСФайлами, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	ПараметрыАвторизации = ДополнительныеПараметры.ПараметрыАвторизации;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	
	Если НЕ РезультатОперацииСФайлами.Выполнено Тогда
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Ложь);
		РезультатОбновления.Вставить("ОшибкаСозданияКаталога", ИзвлечьОписаниеПричиныОшибки(РезультатОперацииСФайлами));
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
		Возврат;
	КонецЕсли;
	
	ВременныйКаталог = РезультатОперацииСФайлами.ИмяКаталога;
	
		// Среди пришедших в рег файле отпечатков ищем тот, который пришел в ответе.
	// Если отпечатки совпадают, то устанавливаем сертификат, иначе пропускаем установку сертифката

	ЭтоВторичноеЗаявление = ПараметрыФункции.ЭтоВторичноеЗаявление;
	ОтпечатокИзОтвета     = ПараметрыФункции.ОтпечатокСертификатаИзОтвета;
	
	Если ЗначениеЗаполнено(ОтпечатокИзОтвета) 
		И ЭтоВторичноеЗаявление Тогда
		
		УстанавливатьСертификат = ДокументооборотСКОКлиентСервер.УстанавливатьСертификат(
			ОтпечатокИзОтвета, 
			Сертификаты);
		
	Иначе
		УстанавливатьСертификат = Истина;
	КонецЕсли;
	
	// устанавливаем сертификаты
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата", ОтпечатокИзОтвета);
	ДополнительныеПараметры.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес", ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
	ДополнительныеПараметры.Вставить("ВыводитьСообщения", ВыводитьСообщения);
	ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
	ДополнительныеПараметры.Вставить("ПараметрыФункции", ПараметрыФункции);
	ДополнительныеПараметры.Вставить("Результат", Результат);
	ДополнительныеПараметры.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
	ДополнительныеПараметры.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ДополнительныеПараметры.Вставить("ФайлИзКэша", ФайлИзКэша);
	
	Оповещение = Новый ОписаниеОповещения(
		"ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовПроверка", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
	
	Если УстанавливатьСертификат Тогда
		
		ПараметрыУстановки = ПараметрыРегистрацияУстановитьСертификаты();
		ЗаполнитьЗначенияСвойств(ПараметрыУстановки, ПараметрыФункции);
		ПараметрыУстановки.ВременныйКаталог = ВременныйКаталог;

		РегистрацияУстановитьСертификаты(ПараметрыУстановки, Оповещение);
		
	Иначе
		РезультатРегистрацияУстановитьСертификаты = Новый Структура("РезультатВыполнения, ПараметрыФункции", Истина, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатРегистрацияУстановитьСертификаты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовПроверка(РезультатРегистрацияУстановитьСертификаты, ДополнительныеПараметры) Экспорт
	
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	МестоХраненияКлючаНастроек = КонтекстМоделиХраненияКлюча(ПараметрыРегистрацияПолучитьДанныеССервера);
	
	РезультатУстановкиСертификатов = РезультатРегистрацияУстановитьСертификаты.РезультатВыполнения;
	ПараметрыРегистрацияУстановитьСертификаты = РезультатРегистрацияУстановитьСертификаты.ПараметрыФункции;
	
	// попытка установки сертификатов сервиса DSS, в случае неудачной попытки в локальном варианте
	Если НЕ РезультатУстановкиСертификатов И УстанавливатьСертификат
		И ЭтоЛокальнаяПодпись(МестоХраненияКлюча)
		И ЭтоОблачнаяПодпись(МестоХраненияКлючаНастроек) Тогда
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлючаНастроек, ПараметрыФункции);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлючаНастроек, ПараметрыРегистрацияУстановитьСертификаты);
		Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		РегистрацияУстановитьСертификаты(ПараметрыРегистрацияУстановитьСертификаты, Оповещение);
	Иначе
		ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовЗавершение(РезультатРегистрацияУстановитьСертификаты, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеУстановкиСертификатовЗавершение(РезультатРегистрацияУстановитьСертификаты, ДополнительныеПараметры) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура ОбработатьОбновление(), которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ПараметрыАвторизации = ДополнительныеПараметры.ПараметрыАвторизации;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	МестоХраненияКлючаНастроек = КонтекстМоделиХраненияКлюча(ПараметрыРегистрацияПолучитьДанныеССервера);
	
	РезультатУстановкиСертификатов = РезультатРегистрацияУстановитьСертификаты.РезультатВыполнения;
	ПараметрыРегистрацияУстановитьСертификаты = РезультатРегистрацияУстановитьСертификаты.ПараметрыФункции;
	
	Если ПараметрыРегистрацияУстановитьСертификаты <> Неопределено 
		И ПараметрыРегистрацияУстановитьСертификаты.Свойство("МенеджерКриптографии") Тогда
		ПараметрыФункции.Вставить("МенеджерКриптографии", ПараметрыРегистрацияУстановитьСертификаты.МенеджерКриптографии);	
	КонецЕсли;
	
	Если УстанавливатьСертификат Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияУстановитьСертификаты);
		ОтпечатокСертификата = ПараметрыРегистрацияУстановитьСертификаты.ОтпечатокСертификата;
	КонецЕсли;
	
	Если СтрНайти(ПараметрыРегистрацияПолучитьДанныеССервера.ДействиеОблачнойПодписи, "АктивироватьПароль") > 0 Тогда
		МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
		ПарольПоУмолчанию = МодульСервисКриптографииDSSКлиентСервер.ОбъектПароля("", 4);
		КриптографияЭДКОКлиентСервер.ПараметрыМестаХраненияКлюча(МестоХраненияКлюча, "Пароль", ПарольПоУмолчанию);
	КонецЕсли;	
	
	// Расшифровка данных, хранящихся в зашифрованной области рег. файла
	РезультатРасшифровки 		= Истина;
	АдресВоВременномХранилище 	= Неопределено;
	
	Если РезультатУстановкиСертификатов И Не ФайлИзКэша Тогда
		
		ВыполнятьРасшифровку = ПараметрыФункции.ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки;
		
		// Расшифровка
		ДополнительныеПараметры = Новый Структура("ОтпечатокСертификата, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша", ОтпечатокСертификата, ДанныеУзлаКонфиденциальнаяИнформацияАдрес, АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, ВыполняемоеОповещение, ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша);
		ДополнительныеПараметры.Вставить("ТрансляцияОшибокУстановкиСертификатов", РезультатРегистрацияУстановитьСертификаты);
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеВЦиклеПослеРасшифрованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если ВыполнятьРасшифровку Тогда
			
			Если НЕ ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
				
				Если ПараметрыФункции.Свойство("СсылкаНаЗаявление") 
					И ЗначениеЗаполнено(ПараметрыФункции.СсылкаНаЗаявление) Тогда
					
					ОтпечатокСертификата = ОтпечатокСертификатаИзЗаявления(ПараметрыФункции.СсылкаНаЗаявление);
					
				КонецЕсли;
					
			КонецЕсли;
			
			РегистрацияРасшифроватьДанные(
				МестоХраненияКлюча,
				МестоХраненияКлючаНастроек,
				ОтпечатокСертификата,
				ПараметрыФункции.ИдентификаторДокументооборота,
				ДанныеУзлаКонфиденциальнаяИнформацияАдрес,
				ВыводитьСообщения,
				Оповещение);
		Иначе
			РезультатВыполнения = Новый Структура("РезультатРасшифровки, АдресВоВременномХранилище, МестоХраненияКлюча", Ложь, АдресВоВременномХранилище, МестоХраненияКлюча);
			РезультатВыполнения.Вставить("ОшибкаПропущенаРасшифровка");
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		КонецЕсли;
		
	Иначе
		ОбработатьОбновлениеПослеКриптографииЗавершение(
			АдресВоВременномХранилище, 
			ВременныйКаталог, 
			ВыводитьСообщения, 
			ВыполняемоеОповещение, 
			ПараметрыРегистрацияПолучитьДанныеССервера, 
			ПараметрыФункции, 
			Результат, 
			РезультатРасшифровки, 
			РезультатУстановкиСертификатов, 
			УстанавливатьСертификат, 
			ФайлИзКэша,
			РезультатРегистрацияУстановитьСертификаты,
			Новый Структура
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтпечатокСертификатаИзЗаявления(СсылкаНаЗаявление)
	
	ОтпечатокСертификата = "";
	
	ИспользуетсяСуществующий = СсылкаНаЗаявление.СпособПолученияСертификата = Перечисления.СпособПолученияСертификата.ИспользоватьСуществующий;
	
	Если ИспользуетсяСуществующий Тогда

		Сертификат = ОбработкаЗаявленийАбонентаВызовСервера.СертификатИзЗаявления(СсылкаНаЗаявление);
		ОтпечатокСертификата = Сертификат.Отпечаток;
		
	КонецЕсли;
	
	Если ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда
		ОтпечатокСертификата = СтрЗаменить(Строка(ОтпечатокСертификата), " ", "");
	КонецЕсли;
		
	
	Возврат ОтпечатокСертификата;
					
КонецФункции

&НаКлиенте
Процедура ОбработатьОбновлениеВЦиклеПослеРасшифрованияЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ОтпечатокСертификата = ДополнительныеПараметры.ОтпечатокСертификата;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ДополнительныеПараметры.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ФайлИзКэша = ДополнительныеПараметры.ФайлИзКэша;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	
	РезультатРасшифровки = РезультатВыполнения.РезультатРасшифровки;
	АдресВоВременномХранилище = РезультатВыполнения.АдресВоВременномХранилище;
	Если РезультатРасшифровки = Истина Тогда
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(РезультатВыполнения);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ПараметрыФункции);
	КонецЕсли;
	
	ТрансляцияОшибокУстановкиСертификатов = ДополнительныеПараметры.ТрансляцияОшибокУстановкиСертификатов;
	ТрансляцияОшибокРасшифровки = РезультатВыполнения;
				
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) 
		И РезультатРасшифровки 
		И (ЗначениеЗаполнено(ПараметрыРегистрацияПолучитьДанныеССервера.ДействиеОблачнойПодписи) 
		ИЛИ УстанавливатьСертификат) Тогда
		ОбработатьОбновлениеАктивироватьОблачнуюПодпись(АдресВоВременномХранилище, ПараметрыРегистрацияПолучитьДанныеССервера.ДействиеОблачнойПодписи, ДополнительныеПараметры);  
		
	Иначе	
		ОбработатьОбновлениеПослеКриптографииЗавершение(
			АдресВоВременномХранилище, 
			ВременныйКаталог, 
			ВыводитьСообщения, 
			ВыполняемоеОповещение, 
			ПараметрыРегистрацияПолучитьДанныеССервера, 
			ПараметрыФункции, 
			Результат, 
			РезультатРасшифровки, 
			РезультатУстановкиСертификатов, 
			УстанавливатьСертификат, 
			ФайлИзКэша,
			ТрансляцияОшибокУстановкиСертификатов,
			ТрансляцияОшибокРасшифровки
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеПослеКриптографииЗавершение(
		АдресВоВременномХранилище, 
		ВременныйКаталог, 
		ВыводитьСообщения, 
		ВыполняемоеОповещение,  
		ПараметрыРегистрацияПолучитьДанныеССервера, 
		ПараметрыФункции, 
		Результат, 
		РезультатРасшифровки, 
		РезультатУстановкиСертификатов, 
		УстанавливатьСертификат, 
		ФайлИзКэша,
		ТрансляцияОшибокУстановкиСертификатов = Неопределено,
		ТрансляцияОшибокРасшифровки = Неопределено)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// Обновление информации в справочниках
	Если РезультатУстановкиСертификатов И РезультатРасшифровки Тогда
		
		ПараметрыОбновления = ПараметрыРегистрацияОбновитьСправочники();
		ЗаполнитьЗначенияСвойств(ПараметрыОбновления, ПараметрыФункции);
		
		ПараметрыОбновления.ВременныйФайлОбновленийАдрес 	= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		ПараметрыОбновления.АдресВоВременномХранилище 		= АдресВоВременномХранилище;
		ПараметрыОбновления.ФайлИзКэша 						= ФайлИзКэша;
		
		РезультатОбновленияСправочников = РегистрацияОбновитьСправочники(ПараметрыОбновления);
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыОбновления);
		
		ЭтоНоваяУчетнаяЗапись     = ПараметрыОбновления.ЭтоНоваяУчетнаяЗапись;
		СтруктураАвтонастройкиФСС = ПараметрыОбновления.СтруктураАвтонастройкиФСС;
		СтруктураАвтонастройкиРПН = ПараметрыОбновления.СтруктураАвтонастройкиРПН;
		СтруктураАвтонастройкиФТС = ПараметрыОбновления.СтруктураАвтонастройкиФТС;
		
	КонецЕсли;
	
	// Сохранение дополнительных сведений по учетной записи в регистр
	ПараметрыСертификата = Неопределено;
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		
		ПараметрыУчетнойЗаписи = ?(ПараметрыФункции.УчетнаяЗапись = Неопределено, НоваяУчетнаяЗапись, ПараметрыФункции.УчетнаяЗапись);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", ВыполняемоеОповещение);
		ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
		ДополнительныеПараметры.Вставить("ВыводитьСообщения", ВыводитьСообщения);
		ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
		ДополнительныеПараметры.Вставить("ПараметрыФункции", ПараметрыФункции);
		ДополнительныеПараметры.Вставить("Результат", Результат);
		ДополнительныеПараметры.Вставить("РезультатРасшифровки", РезультатРасшифровки);
		ДополнительныеПараметры.Вставить("РезультатУстановкиСертификатов", РезультатУстановкиСертификатов);
		ДополнительныеПараметры.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
		ДополнительныеПараметры.Вставить("ПараметрыУчетнойЗаписи", ПараметрыУчетнойЗаписи);
		ДополнительныеПараметры.Вставить("РезультатОбновленияСправочников", РезультатОбновленияСправочников);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФСС", СтруктураАвтонастройкиФСС);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиРПН", СтруктураАвтонастройкиРПН);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФТС", СтруктураАвтонастройкиФТС);
		ДополнительныеПараметры.Вставить("ЭтоНоваяУчетнаяЗапись", ЭтоНоваяУчетнаяЗапись);
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьОбновлениеПослеПоискаСертификатаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Попытка
			
			Сертификат = МультирежимВызовСервера.СертификатПользователя(ПараметрыУчетнойЗаписи);
			Если Сертификат.Найден Тогда
				
				Если ЭтоПодписьСервиса(Сертификат.МестоХраненияКлюча) Тогда
					ПараметрыСертификата = ПолучитьСвойстваСертификатаСубъектаНаСервере(Сертификат.Отпечаток);
					ЗаполнитьМестоХраненияКлюча(Сертификат.МестоХраненияКлюча, ПараметрыСертификата);
				ИначеЕсли ЭтоОблачнаяПодпись(Сертификат.МестоХраненияКлюча) Тогда
					ПараметрыСертификата = ПолучитьСвойстваОблачногоСертификата(Сертификат.Отпечаток, "MY");
					ЗаполнитьМестоХраненияКлюча(Сертификат.МестоХраненияКлюча, ПараметрыСертификата);
				Иначе
					
					МенеджерКриптографии = ?(
						ПараметрыФункции.Свойство("МенеджерКриптографии"), 
						ПараметрыФункции.МенеджерКриптографии, 
						Неопределено);
						
					КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(Оповещение, Сертификат.Отпечаток, "MY", , Ложь, МенеджерКриптографии);
					Возврат;
					
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			ПараметрыСертификата = Неопределено;
		КонецПопытки;
		
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата", Истина, Неопределено, ПараметрыСертификата <> Неопределено, ПараметрыСертификата);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(,ВременныйКаталог);
		
		РезультатОбновления = Новый Структура("ПараметрыФункции, РезультатОбновления", ПараметрыФункции, Результат);
		Если РезультатУстановкиСертификатов = Ложь И ТипЗнч(ТрансляцияОшибокУстановкиСертификатов) = Тип("Структура") Тогда
			Для Каждого Свойство Из ТрансляцияОшибокУстановкиСертификатов Цикл
				Если Лев(Свойство.Ключ, 6) = "Ошибка" Тогда
					РезультатОбновления.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если РезультатРасшифровки = Ложь И ТипЗнч(ТрансляцияОшибокРасшифровки) = Тип("Структура") Тогда
			Для Каждого Свойство Из ТрансляцияОшибокРасшифровки Цикл
				Если Лев(Свойство.Ключ, 6) = "Ошибка" Тогда
					РезультатОбновления.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЕсли;
			КонецЦикла;
			Если ТрансляцияОшибокРасшифровки.Количество() = 0 Тогда
				РезультатОбновления.Вставить("ОшибкаПропущенаРасшифровка");
			КонецЕсли;
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатОбновления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеПослеПоискаСертификатаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ВременныйКаталог = ДополнительныеПараметры.ВременныйКаталог;
	ВыводитьСообщения = ДополнительныеПараметры.ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	Результат = ДополнительныеПараметры.Результат;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ПараметрыУчетнойЗаписи = ДополнительныеПараметры.ПараметрыУчетнойЗаписи;
	РезультатОбновленияСправочников = ДополнительныеПараметры.РезультатОбновленияСправочников;
	СтруктураАвтонастройкиФСС = ДополнительныеПараметры.СтруктураАвтонастройкиФСС;
	СтруктураАвтонастройкиРПН = ДополнительныеПараметры.СтруктураАвтонастройкиРПН;
	СтруктураАвтонастройкиФТС = ДополнительныеПараметры.СтруктураАвтонастройкиФТС;
	ЭтоНоваяУчетнаяЗапись = ДополнительныеПараметры.ЭтоНоваяУчетнаяЗапись;
	
	ПараметрыСертификата = ?(РезультатВыполнения.Выполнено И РезультатВыполнения.СертификатНайден, РезультатВыполнения.СвойстваСертификата, Неопределено);
	
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		
		ПараметрыСохранения 								= ДокументооборотСКОКлиентСервер.ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи();
		ПараметрыСохранения.ВременныйФайлОбновленийАдрес 	= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		ПараметрыСохранения.УчетнаяЗаписьОрганизации 		= ПараметрыУчетнойЗаписи;
		ПараметрыСохранения.ПараметрыСертификата 			= ПараметрыСертификата;
		
		ЗаполнитьЗначенияСвойств(ПараметрыСохранения, ПараметрыФункции);
		
		СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыСохранения);
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности = ПараметрыСохранения.ТекстОшибокДляМастераПодключенияК1СОтчетности;
	КонецЕсли;
	
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) И РезультатРасшифровки И РезультатОбновленияСправочников Тогда
		
		// производим настройку параметров ФСС
		Если СтруктураАвтонастройкиФСС <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
			
			ФлагАвтозаполнения = СтруктураАвтонастройкиФСС.ФлагАвтозаполнения;
			Если СтруктураАвтонастройкиФСС.ФлагСообщения И ВыводитьСообщения Тогда
				Режим = РежимДиалогаВопрос.ДаНет;
