Функция СформироватьИмяФайлаУведомленияОбОтказеДокумент(ТранспортноеСообщение, ДИВы, UUID)
	
	Префикс = "UO";	
	
	// выделяем префикс из имени основного ДИВ основания
	ОсновнойДИВ = ДИВы.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ))[0];
	ИмяФайлаДИВ = ОсновнойДИВ.ИмяФайла;
	
	ПрефиксОснования = ВыделитьПрефиксИзИмениФайлаОснования(ИмяФайлаДИВ);
	Если НЕ ЗначениеЗаполнено(ПрефиксОснования) Тогда
		// если префикс выделить не удалось, то пишем хоть какой-нибудь (это лучше, чем не отправлять извещение вообще)
		ПрефиксОснования = "NO_PREF";
	КонецЕсли;
	
	ИдентификаторыПолучателя = ПолучитьИдентификаторыПолучателя(ТранспортноеСообщение.ЦиклОбмена);
	Если ИдентификаторыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторПолучателя 		 = ИдентификаторыПолучателя.ПромежуточныйНалоговыйОрган;
	ИдентификаторКонечногоПолучателя = ИдентификаторыПолучателя.КонечныйНалоговыйОрган;
	
	// формируем идентификатор отправителя
	РеквизитыПолучателя = ПолучитьРеквизитыПолучателяИзВходящегоТребования(ТранспортноеСообщение.Основание);
	Если РеквизитыПолучателя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(РеквизитыПолучателя.ИННЮЛ) 
	И ЗначениеЗаполнено(РеквизитыПолучателя.КПП) Тогда
		//налогоплательщик ЮЛ
		ИдентификаторОтправителя = РеквизитыПолучателя.ИННЮЛ + РеквизитыПолучателя.КПП;
    ИначеЕсли ЗначениеЗаполнено(РеквизитыПолучателя.ИННФЛ) Тогда
    	//налогоплательщик ФЛ
		ИдентификаторОтправителя = РеквизитыПолучателя.ИННФЛ;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа';
								|en = 'Не удалось извлечь реквизиты получателя из входящего документа налогового органа'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	    Возврат Неопределено;
	КонецЕсли;
	
	// формируем строку с текущей датой
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	
	// 
	ИдентификаторФайла = UUID;
	
	//
	РасширениеФайла = "xml";
	
	// собираем имя файла уведомления из составляющих
	ИмяФайлаУведомления = Префикс + "_" + ПрефиксОснования + "_" + ИдентификаторПолучателя + "_" + ИдентификаторКонечногоПолучателя + "_" + ИдентификаторОтправителя + "_" + GGGGMMDD + "_" + ИдентификаторФайла + "." + РасширениеФайла;
	Возврат ИмяФайлаУведомления;
	
КонецФункции
       
&НаСервереБезКонтекста
Функция ПолучитьФИОДолж(ТранспортноеСообщение)
	
	Организация = ТранспортноеСообщение.Отправитель;
	флПБОЮЛ = НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация);
	КодНО = ТранспортноеСообщение.Основание.Отправитель.Код;
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНО);
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		// получим ФИО уполномоченного представителя из доверенности
		
		Возврат ПолучитьФИОДоверенности(Доверенность, Перечисления.СубъектыДоверенностиНалогоплательщика.ПредставительФЛ);
	Иначе
		// получим ФИО руководителя организации / индивидуального предпринимателя
		Если флПБОЮЛ Тогда
			Возврат РегламентированнаяОтчетность.РазложитьФИО(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "ФИО").ФИО);
		Иначе
			Возврат РегламентированнаяОтчетность.РазложитьФИО(РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация, , "ФИОРук").ФИОРук);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции 

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеКвитанцииОПриемеЗаявление(Заголовок, ИмяФайла, Тело, НижнийКолонтитул)
	
	// формируем таблицу с объявлениями полей узла с общими сведениями
	ПоляОбщихСведений = Новый ТаблицаЗначений;
	ПоляОбщихСведений.Колонки.Добавить("Код");
	ПоляОбщихСведений.Колонки.Добавить("Имя");
	
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ИдФайл", "Идентификатор файла");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаВремяНапр", "Дата и время направления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "КНД", "Код формы по КНД");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НаимВидДок", "Наименование вида документа");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "НомерДокНП", "Номер заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаДокНП", "Дата заявления");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаПост", "Дата поступления отчета");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаПрин", "Дата принятия отчета");
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "РегНом", "Рег. номер заявления в налоговом органе");
	
	ДобавитьСтрокуВТаблицуПолейОбщихСведений(ПоляОбщихСведений, "ДатаРег", "Дата регистрации заявления");
	
	// получаем бланк отчета из макета
	Бланк = ПолучитьМакетОбработки("БланкПечатиДИВ");
	
	// инициализируем итоговый табличный документ
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	
	// выводим секцию заголовка
	Секция_Заголовок = Бланк.ПолучитьОбласть("Секция_Заголовок");
	Секция_Заголовок.Области.Заголовок.Текст = Заголовок;
	Секция_Заголовок.Области.Файл.Текст = ИмяФайла;
	ТаблДок.Вывести(Секция_Заголовок);
	
	// выводим разделитель
	Секция_Разделитель = Бланк.ПолучитьОбласть("Секция_Разделитель");
	ТаблДок.Вывести(Секция_Разделитель);
	
	// пытаемся разобрать уведомление
	СвойстваИзКвитанции = ПолучитьОсновныеСвойстваИзКвитанцииОПриемеЗаявление(Тело);
	
	// если разобрать не удалось - выводим его в виде текста
	Если НЕ ЗначениеЗаполнено(СвойстваИзКвитанции) Тогда
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		ВывестиТекстПострочно(ТаблДок, Секция_Тело, Тело);
		
		// если текст уведомления разобрать удалось, то выводим основную инфорфмацию из него
	Иначе
		
		Секция_Тело = Бланк.ПолучитьОбласть("Секция_Тело");
		
		Если СвойстваИзКвитанции.Ошибки.Количество() > 0 Тогда
			
			// выводим "шапку" таблицы ошибок
			Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
			Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Ошибки:";
			ТаблДок.Вывести(Секция_ЗаголовокГруппы);
			
			// получаем область для вывода единицы информации уведомления
			Для Каждого Ошибка Из СвойстваИзКвитанции.Ошибки Цикл
				ВывестиТекстПострочно(ТаблДок, Секция_Тело, "Ошибка " + Ошибка.КодОшибки + ": " + Ошибка.Описание);
			КонецЦикла;
			
			// выводим пустую строку - разделитель
			Секция_Тело.Области.Тело.Текст = "";
			ТаблДок.Вывести(Секция_Тело);
			
		КонецЕсли;
		
		// выводим "шапку" общих сведений
		Секция_ЗаголовокГруппы = Бланк.ПолучитьОбласть("Секция_ЗаголовокГруппы");
		Секция_ЗаголовокГруппы.Области.ЗаголовокГруппы.Текст = "Общие сведения:";
		ТаблДок.Вывести(Секция_ЗаголовокГруппы);
		
		// выводим общие сведения поэлементно
		ОбщиеСведенияСообщения = СвойстваИзКвитанции.ОбщиеСведения;
		Для Каждого ПолеОбщихСведений Из ПоляОбщихСведений Цикл
			Если ОбщиеСведенияСообщения.Свойство(ПолеОбщихСведений.Код) Тогда
				ЗначениеПоля = ОбщиеСведенияСообщения[ПолеОбщихСведений.Код];
				Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
					Секция_Тело.Области.Тело.Текст = ПолеОбщихСведений.Имя + ": " + СокрЛП(ЗначениеПоля);
					ТаблДок.Вывести(Секция_Тело);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблДок.Вывести(Секция_Разделитель);
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);
	
	// инициализируем текст нижнего колонтитула
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	Возврат ТаблДок;
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаОсновеСообщенияОПростОтметки(Заголовок, ИмяФайла, Тело, НижнийКолонтитул) Экспорт

	// получаем бланк отчета из макета
	Бланк = ПолучитьМакетОбработки("СообщениеОПроставленииОтметкиНалоговогоОргана");
	
	// инициализируем итоговый табличный документ
	ТаблДок = Новый ТабличныйДокумент;
	ТаблДок.АвтоМасштаб = Истина;
	
	СвойстваИзКвитанции = ПолучитьОсновныеСвойстваИзСообщенияОПростОтметки(Тело);
	ОбщиеСведения = СвойстваИзКвитанции.ОбщиеСведения;
	
	// выводим секцию заголовка
	Секция_Тело = Бланк.ПолучитьОбласть("СообщениеОПроставленииОтметки");
	Секция_Тело.Параметры.Заполнить(ОбщиеСведения.СвОтметка);
	
	Секция_Тело.Параметры.ОтправительЗаявления = ОбщиеСведения.ОтпрНО.НаимНО + ", " + ОбщиеСведения.ОтпрНО.КодНО;
	Если ОбщиеСведения.Свойство("НОПром") Тогда
		Секция_Тело.Параметры.НалоговыйОрган = ОбщиеСведения.НОПром.НаимНО + ", " + ОбщиеСведения.НОПром.КодНО;
	Иначе
		Секция_Тело.Параметры.НалоговыйОрган = ОбщиеСведения.ОтпрНО.НаимНО + ", " + ОбщиеСведения.ОтпрНО.КодНО;
	КонецЕсли;
	
	ДолжНО = ОбщиеСведения.ДолжНО;
	Секция_Тело.Параметры.ДолжностьЧин = 
		?(ДолжНО.Свойство("Долж"), ДолжНО.Долж, "") + " " 
		+ ?(ДолжНО.Свойство("Чин"), ДолжНО.Чин, "");
	Секция_Тело.Параметры.ДолжностьЧин = СокрЛП(Секция_Тело.Параметры.ДолжностьЧин);
	
	ФИОДолж = ОбщиеСведения.ФИОДолж;
	Секция_Тело.Параметры.ФИО = 
		СокрЛП(ФИОДолж.Фамилия + " "
		+ ФИОДолж.Имя + " "
		+ ?(ФИОДолж.Свойство("Отчество"), ФИОДолж.Отчество, ""));
		
	Секция_Тело.Параметры.Заполнить(ОбщиеСведения.ДолжНО); // Тлф, если есть
		
	// ИП и ЮЛ
	Если ОбщиеСведения.Свойство("ФЛ") Тогда
		
		ФЛ  = ОбщиеСведения.ФЛ;
		ФИО = ОбщиеСведения.ФИО;
		
		Секция_Тело.Параметры.Налогоплательщик = 
			СокрЛП(ФИО.Фамилия + " "
			+ ФИО.Имя + " "
			+ ?(ФИО.Свойство("Отчество"), ФИО.Отчество, "")) + ", "
			+ ФЛ.ИННФЛ;

	Иначе
		
		ЮЛ  = ОбщиеСведения.ЮЛ;
		
		Секция_Тело.Параметры.Налогоплательщик =
			?(ЮЛ.Свойство("НаимОрг"), ЮЛ.НаимОрг + ", ", "")
			+ ЮЛ.ИННЮЛ
			+ ?(ЮЛ.Свойство("КПП"), "/" + ЮЛ.КПП, "");
		
	КонецЕсли;
	
	ТаблДок.Вывести(Секция_Тело);
	СформироватьТабличныйДокументСекцияПодписи(ТаблДок, Бланк, ТаблицаПодписей);
	
	// инициализируем текст нижнего колонтитула
	ТаблДок.НижнийКолонтитул.ТекстСлева = НижнийКолонтитул;
	
	Возврат ТаблДок;
	
КонецФункции

