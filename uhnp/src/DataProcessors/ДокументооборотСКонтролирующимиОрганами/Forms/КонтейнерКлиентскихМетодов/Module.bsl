&НаСервереБезКонтекста
Функция ЗаписатьФайлВыгрузкиВоВременноеХранилище(
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		КодировкаФайла,
		УникальныйИдентификатор,
		УдалитьBOM = Ложь)
	
	// сохраняем выгрузку во временный файл
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
	ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяВремФайла, КодировкаФайла);
	ОбъектЗаписьТекста.Записать(ТекстВыгрузки);
	ОбъектЗаписьТекста.Закрыть();
	
	ДанныеВыгрузки = Новый ДвоичныеДанные(ИмяВремФайла);
	// удалим из файла в кодировке "UTF-8" сигнатуру BOM
	Если нрег(КодировкаФайла) = "utf-8" И УдалитьBOM Тогда
		ТекстВыгрузки64 = Base64Строка(ДанныеВыгрузки);
		ТекстВыгрузки64 = Сред(ТекстВыгрузки64, 5);
		ДанныеВыгрузки = Base64Значение(ТекстВыгрузки64);
	КонецЕсли;
	
	// помещаем файл во временное хранилище
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДанныеВыгрузки, УникальныйИдентификатор);
	
	// удаляем временный файл
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВремФайла);
	
	//
	Возврат АдресВоВременномХранилище;
	
КонецФункции

