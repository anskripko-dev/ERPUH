			?(ЭтоПодписьСервиса(МестоХраненияКлюча) ИЛИ ЭтоОблачнаяПодпись(МестоХраненияКлюча),
				ДополнительныеПараметры.Алгоритм, СертификатПодписанта),
			Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеХешированияКанонизированногоФайлаПодписанныхСвойств(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 					= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресДанныхДляПодписиФайлаXML 			= ДополнительныеПараметры.АдресДанныхДляПодписиФайлаXML;
	ДанныеДляПодписиФайлаXML 				= ДополнительныеПараметры.ДанныеДляПодписиФайлаXML;
	ПодписьКлючаДляИзвлеченияХешаВBase64 	= ДополнительныеПараметры.ПодписьКлючаДляИзвлеченияХешаВBase64;
	ДобавляемыеАтрибуты 					= ДополнительныеПараметры.ДобавляемыеАтрибуты;
	НастройкиПодписи 						= ДополнительныеПараметры.НастройкиПодписи;
	ПодписьДляИзвлеченияХешаВBase64 		= ДополнительныеПараметры.ПодписьДляИзвлеченияХешаВBase64;
	ПодписьСервиса 							= ЭтоПодписьСервиса(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ХешСтрокаПодписанныхСвойств = Результат.Хеш;
	Если ЗначениеЗаполнено(ХешСтрокаПодписанныхСвойств) Тогда
		ДанныеХешСтрокиПодписанныхСвойств = ПолучитьДвоичныеДанныеИзHexСтроки(ХешСтрокаПодписанныхСвойств);
		ХешСтрокаПодписанныхСвойствВBase64 = ПолучитьBase64СтрокуИзДвоичныхДанных(ДанныеХешСтрокиПодписанныхСвойств);
		ХешСтрокаПодписанныхСвойствВBase64 = СтрЗаменить(ХешСтрокаПодписанныхСвойствВBase64, Символы.ВК, "");
		ХешСтрокаПодписанныхСвойствВBase64 = СтрЗаменить(ХешСтрокаПодписанныхСвойствВBase64, Символы.ПС, "");
	Иначе
		ХешСтрокаПодписанныхСвойствВBase64 = Неопределено;
	КонецЕсли;
	НастройкиПодписи.Вставить("ХешСтрокаПодписанныхСвойствВBase64", ХешСтрокаПодписанныхСвойствВBase64);
	
	ЭтоШестнадцатеричноеПредставлениеХеша = НЕ ПодписьСервиса ИЛИ ДополнительныеПараметры.ХэшВсегдаГОСТ2012;
	
	Если НЕ ЭтоШестнадцатеричноеПредставлениеХеша Тогда
		РезультатХэширования = ХешСтрокаВBase64КанонизированногоФайлаXMLИзПодписиНаСервере(
			ПодписьКлючаДляИзвлеченияХешаВBase64,
			ПодписьДляИзвлеченияХешаВBase64,
			АдресДанныхДляПодписиФайлаXML,
			Истина,
			ДополнительныеПараметры.Алгоритм);
		
		ХешСтрокаВBase64Ключа = ?(РезультатХэширования.Свойство("ХешСтрокаВBase64Ключа"), РезультатХэширования.ХешСтрокаВBase64Ключа, Неопределено);
		ХешСтрокаВBase64 = РезультатХэширования.ХешСтрокаВBase64;
		
	Иначе
		ХешСтрокаВBase64Ключа = ПодписьКлючаДляИзвлеченияХешаВBase64;
		ХешСтрокаВBase64 = ПодписьДляИзвлеченияХешаВBase64;
	КонецЕсли;
	
	// Вставим сформированную хеш-строку в канонизированный подписываемый узел
	СконвертироватьИзШестнадцатеричногоПредставленияХеша = ЭтоШестнадцатеричноеПредставлениеХеша;
	СтрокаНаПодписьBase64 = КанонизированныйУзелПодписьВBase64СПодставленнымХешНаСервере(
		ДанныеДляПодписиФайлаXML.КанонизированныйУзелПодписьВBase64,
		ХешСтрокаВBase64Ключа,
		ХешСтрокаВBase64,
		СконвертироватьИзШестнадцатеричногоПредставленияХеша,
		ДобавляемыеАтрибуты,
		НастройкиПодписи);
	
	Если СтрокаНаПодписьBase64 = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ХешСтрокаВBase64Ключа", ХешСтрокаВBase64Ключа);
	ДополнительныеПараметры.Вставить("ХешСтрокаВBase64", ХешСтрокаВBase64);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
		
	Если ПодписьСервиса ИЛИ ЭтоАдресВременногоХранилища(СтрокаНаПодписьBase64) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, СтрокаНаПодписьBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СтрокаНаПодписьBase64, ".xml");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	ВключатьХэшСертификата = ДополнительныеПараметры.ВключатьХэшСертификата;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	НастройкиПодписи					= ДополнительныеПараметры.НастройкиПодписи;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяФайлаКанонизированногоУзлаXML = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ИмяФайлаКанонизированногоУзлаXML", ИмяФайлаКанонизированногоУзлаXML);
	
	Если ВключатьХэшСертификата Тогда
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПодписанияФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
			
		ПараметрыПодписи = Неопределено;
		Если ЭтоОблачнаяПодпись(ДополнительныеПараметры) Тогда
			ПараметрыПодписи = ДополнительныеПараметры.ДанныеОблачнойПодписи;
		КонецЕсли;
		
		КриптографияЭДКОКлиент.ПодписатьPKCS7(Оповещение, СертификатПодписанта, ИмяФайлаКанонизированногоУзлаXML, Ложь,
			?(НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры), Неопределено, ".p7s"), Ложь, , , ПараметрыПодписи);
			
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеПолученияАлгоритмовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		Если НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры) Тогда
			РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, Алгоритмы", Истина, Неопределено, Неопределено);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			КриптографияЭДКОКлиент.ПолучитьАлгоритмы(
				Оповещение,
				Ложь,,
				СертификатПодписанта);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеПолученияАлгоритмовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	Алгоритм 							= ДополнительныеПараметры.Алгоритм;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	Крипт = Результат.МенеджерКриптографии;
	Алгоритмы = Результат.Алгоритмы;
	
	// Находим нужный алгоритм хеширования
	ПодстрокаАлгоритмаХеширования = ?(Алгоритм = "GOST R 34.10-2012-256", "2012 256",
									?(Алгоритм = "GOST R 34.10-2012-512", "2012 512",
												 "94"));
	Если Алгоритмы <> Неопределено Тогда
		ИдентификаторНайденногоАлгоритма = 0;
		Для каждого Алгоритм Из Алгоритмы Цикл
			Если ИдентификаторНайденногоАлгоритма = 0 И СтрНайти(Алгоритм.Имя, "34.11") > 0
				И СтрНайти(Алгоритм.Имя, ПодстрокаАлгоритмаХеширования) > 0
				И СтрНайти(Алгоритм.Имя, "MAC") = 0 Тогда
				
				ИдентификаторНайденногоАлгоритма = Алгоритм.Идентификатор;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИдентификаторНайденногоАлгоритма = КриптографияЭДКОКлиентСервер.СвойстваАлгоритма(Алгоритм).АлгоритмХеширования;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Крипт", 								Крипт);
	ДополнительныеПараметры.Вставить("ИдентификаторНайденногоАлгоритма", 	ИдентификаторНайденногоАлгоритма);
	
	ПараметрыПодписи = Неопределено;
	Если ЭтоОблачнаяПодпись(ДополнительныеПараметры) Тогда
		ПараметрыПодписи = ДополнительныеПараметры.ДанныеОблачнойПодписи;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ПараметрыПодписи", 	ПараметрыПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеОпределенияИдентификатораАлгоритма",
		ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеОпределенияИдентификатораАлгоритма(Результат, ДополнительныеПараметры) Экспорт
	
	// Подписываем канонизированный узел "SignedInfo" файла XML, содержащий хеш-строку
	Оповещение = Новый ОписаниеОповещения(
		"ПодписатьФайлXMLDSigПослеПодписанияФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыКриптографии = Новый Структура("АлгоритмХеширования",
		ДополнительныеПараметры.ИдентификаторНайденногоАлгоритма);
		
	ПараметрыПодписи = Неопределено;
	Если ЭтоОблачнаяПодпись(ДополнительныеПараметры) Тогда
		ПараметрыПодписи = ДополнительныеПараметры.ДанныеОблачнойПодписи;
	КонецЕсли;
	
	КриптографияЭДКОКлиент.Подписать(
		Оповещение,
		ДополнительныеПараметры.СертификатПодписанта,
		ДополнительныеПараметры.ИмяФайлаКанонизированногоУзлаXML,
		ПараметрыКриптографии,
		?(НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры), Неопределено, ".bin"),
		Ложь,
		ДополнительныеПараметры.Крипт, 
		ПараметрыПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеПодписанияФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 				= ДополнительныеПараметры.ВыполняемоеОповещение;
	ВключатьХэшСертификата 				= ДополнительныеПараметры.ВключатьХэшСертификата;
	НастройкиПодписи 					= ДополнительныеПараметры.НастройкиПодписи;
	МестоХраненияКлюча 					= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеВопросаПриОшибкеПодписи",
			ЭтотОбъект, ДополнительныеПараметры);
		
		Если ЭтоПодписьСервиса(ДополнительныеПараметры) ИЛИ НастройкиПодписи = Неопределено
			ИЛИ НЕ НастройкиПодписи.Свойство("Применение") ИЛИ НастройкиПодписи.Применение <> "ОтправкиФСС"
			ИЛИ ДополнительныеПараметры.ВключатьХэшСертификата Тогда
			
			ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Отмена);
			
		Иначе
			ПоказатьВопросПриОшибкеКриптооперации(
				Оповещение,
				"Подписать",
				Результат.ОписаниеОшибки,
				ДополнительныеПараметры.ТипКриптопровайдераВладельца);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Крипт") Тогда
		ДополнительныеПараметры.Удалить("Крипт");
	КонецЕсли;
	
	ИмяФайлаПодписи = ?(ВключатьХэшСертификата, Результат.ФайлПодписи, Результат.ИмяФайлаПодписи);
	
	ДополнительныеПараметры.Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЧтенияПодписанногоФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЭтоПодписьСервиса(ДополнительныеПараметры) ИЛИ ЭтоАдресВременногоХранилища(ИмяФайлаПодписи) Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, СтрокаBase64", Истина, Неопределено, ИмяФайлаПодписи);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	Иначе
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, ИмяФайлаПодписи);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеВопросаПриОшибкеПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Повторить Тогда
		Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеОпределенияИдентификатораАлгоритма",
			ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещение, Неопределено);
		
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЧтенияПодписанногоФайлаКанонизированногоУзлаXMLСПодставленнымХэшЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 						= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресСодержимогоПодготовленногоФайлаXML 	= ДополнительныеПараметры.АдресСодержимогоПодготовленногоФайлаXML;
	ДанныеДляПодписиФайлаXML 					= ДополнительныеПараметры.ДанныеДляПодписиФайлаXML;
	ИмяКанонизированногоФайлаКлючаXML 			= ДополнительныеПараметры.ИмяКанонизированногоФайлаКлючаXML;
	ИмяКанонизированногоФайлаXML 				= ДополнительныеПараметры.ИмяКанонизированногоФайлаXML;
	ИмяКанонизированногоФайлаПодписанныхСвойств = ДополнительныеПараметры.ИмяКанонизированногоФайлаПодписанныхСвойств;
	ХешСтрокаВBase64Ключа 						= ДополнительныеПараметры.ХешСтрокаВBase64Ключа;
	ХешСтрокаВBase64 							= ДополнительныеПараметры.ХешСтрокаВBase64;
	ИмяФайлаКанонизированногоУзлаXML 			= ДополнительныеПараметры.ИмяФайлаКанонизированногоУзлаXML;
	ИмяФайлаПодписи 							= ДополнительныеПараметры.ИмяФайлаПодписи;
	ПодписанныйФайл 							= ДополнительныеПараметры.ПодписанныйФайл;
	ВключатьХэшСертификата 						= ДополнительныеПараметры.ВключатьХэшСертификата;
	НастройкиПодписи 							= ДополнительныеПараметры.НастройкиПодписи;
	ЛокальнаяПодпись 							= ЭтоЛокальнаяПодпись(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПодписанныеДанныеВBase64 = Результат.СтрокаBase64;
	
	Если НЕ ЭтоПодписьСервиса(ДополнительныеПараметры) Тогда
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяКанонизированногоФайлаXML);
		Если ВключатьХэшСертификата Тогда
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяКанонизированногоФайлаКлючаXML);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяКанонизированногоФайлаПодписанныхСвойств) Тогда
			ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяКанонизированногоФайлаПодписанныхСвойств);
		КонецЕсли;
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаКанонизированногоУзлаXML);
		ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ИмяФайлаПодписи);
	КонецЕсли;
	
	КанонизированныйУзелЗначенияПодписиВBase64 =
		?(ДанныеДляПодписиФайлаXML.Свойство("КанонизированныйУзелЗначенияПодписиВBase64"),
		ДанныеДляПодписиФайлаXML.КанонизированныйУзелЗначенияПодписиВBase64, Неопределено);
	НастройкиПодписи.Вставить("КанонизированныйУзелЗначенияПодписиВBase64", КанонизированныйУзелЗначенияПодписиВBase64);
	СодержимоеПодписанногоФайлаXMLВBase64 = ПодписанныйФайлXMLВBase64НаСервере(
		АдресСодержимогоПодготовленногоФайлаXML,
		ХешСтрокаВBase64Ключа,
		ХешСтрокаВBase64,
		ПодписанныеДанныеВBase64,
		НЕ ЛокальнаяПодпись,
		ВключатьХэшСертификата,
		НастройкиПодписи);
	
	ДополнительныеПараметры.Вставить("СодержимоеПодписанногоФайлаXMLВBase64", СодержимоеПодписанногоФайлаXMLВBase64);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаЗначенияПодписи",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64) Тогда
		Если НЕ ЛокальнаяПодпись Тогда
			РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
				Истина, Неопределено, НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64);
			ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
			
		Иначе
			ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение,
				НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64);
		КонецЕсли;
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиКанонизированногоФайлаЗначенияПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	СертификатПодписанта = ДополнительныеПараметры.СертификатПодписанта;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ИмяКанонизированногоФайлаЗначенияПодписи = Результат.ИмяФайла;
	
	ДополнительныеПараметры.Вставить("ИмяКанонизированногоФайлаЗначенияПодписи",
		ИмяКанонизированногоФайлаЗначенияПодписи);
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеХешированияКанонизированногоФайлаЗначенияПодписи",
		ЭтотОбъект, ДополнительныеПараметры);
	Если ИмяКанонизированногоФайлаЗначенияПодписи = Неопределено Тогда
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, Хеш", Истина, Неопределено, Неопределено);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		КриптографияЭДКОКлиент.ХешироватьДанные(
			Оповещение,
			НЕ ЭтоЛокальнаяПодпись(ДополнительныеПараметры),
			ИмяКанонизированногоФайлаЗначенияПодписи,,
			Ложь,,
			?(ЭтоПодписьСервиса(МестоХраненияКлюча) ИЛИ ЭтоОблачнаяПодпись(МестоХраненияКлюча),
				ДополнительныеПараметры.Алгоритм, СертификатПодписанта),
			Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеХешированияКанонизированногоФайлаЗначенияПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение 						= ДополнительныеПараметры.ВыполняемоеОповещение;
	АдресСодержимогоПодготовленногоФайлаXML 	= ДополнительныеПараметры.АдресСодержимогоПодготовленногоФайлаXML;
	ДанныеДляПодписиФайлаXML 					= ДополнительныеПараметры.ДанныеДляПодписиФайлаXML;
	ИмяФайлаКанонизированногоУзлаXML 			= ДополнительныеПараметры.ИмяФайлаКанонизированногоУзлаXML;
	ИмяФайлаПодписи 							= ДополнительныеПараметры.ИмяФайлаПодписи;
	ПодписанныйФайл 							= ДополнительныеПараметры.ПодписанныйФайл;
	ВключатьХэшСертификата 						= ДополнительныеПараметры.ВключатьХэшСертификата;
	НастройкиПодписи 							= ДополнительныеПараметры.НастройкиПодписи;
	СодержимоеПодписанногоФайлаXMLВBase64 		= ДополнительныеПараметры.СодержимоеПодписанногоФайлаXMLВBase64;
	ЛокальнаяПодпись 							= ЭтоЛокальнаяПодпись(ДополнительныеПараметры);
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ХешСтрокаЗначенияПодписи = Результат.Хеш;
	
	ТолькоСвойстваБезШтампаВремени = ?(НастройкиПодписи <> Неопределено
		И НастройкиПодписи.Свойство("ТолькоСвойстваБезШтампаВремени"),
		НастройкиПодписи.ТолькоСвойстваБезШтампаВремени, Ложь);
	Если ЗначениеЗаполнено(ХешСтрокаЗначенияПодписи) И НЕ ТолькоСвойстваБезШтампаВремени Тогда
		СодержимоеПодписанногоФайлаXMLВBase64 = ПолучитьШтампВремениИПодставитьВПодписанныйФайлXMLВBase64НаСервере(
			СодержимоеПодписанногоФайлаXMLВBase64,
			ХешСтрокаЗначенияПодписи,
			НЕ ЛокальнаяПодпись);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьФайлXMLDSigПослеЗаписиПодписанногоФайлаXMLЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	Если НЕ ЛокальнаяПодпись Тогда
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, СодержимоеПодписанногоФайлаXMLВBase64);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	ИначеЕсли ЭтоАдресВременногоХранилища(ДополнительныеПараметры.ФайлДанных) Тогда
		АдресПодписанногоФайлаXML = ПоместитьВоВременноеХранилищеДанныеСКлиента(СодержимоеПодписанногоФайлаXMLВBase64,
			?(ПодписанныйФайл = Неопределено, Новый УникальныйИдентификатор, ПодписанныйФайл));
		РезультатВыполнения = Новый Структура("Выполнено, ДвоичныеДанные, ИмяФайла",
			Истина, Неопределено, АдресПодписанногоФайлаXML);
		ВыполнитьОбработкуОповещения(Оповещение, РезультатВыполнения);
		
	Иначе
		Если ПодписанныйФайл = Неопределено Тогда
			ПодписанныйФайл = ".xml";
		КонецЕсли;
		ОперацииСФайламиЭДКОКлиент.Base64ВФайл(Оповещение, СодержимоеПодписанногоФайлаXMLВBase64, ПодписанныйФайл);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФайлXMLDSigПослеЗаписиПодписанногоФайлаXMLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	
	Если НЕ Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПодписанныйФайл = Результат.ИмяФайла;
	
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, ПодписанныйФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросПриОшибкеКриптооперации(
		ОповещениеОЗавершении = Неопределено,
		ТипОперации = "Подписать",
		ОписаниеОшибки = "",
		ТипКриптопровайдераВладельца = Неопределено) Экспорт
	
	ЭтоПредупреждение = Ложь;
	МассивСообщений = Новый Массив;
	ТекстПереводСтроки = "
		|";
	СсылкаАвторизованныеУЦ = Новый ФорматированнаяСтрока(НСтр("ru = 'ссылке';
																|en = 'ссылке'"),,,,
		"https://v8.1c.ru/buhv8/1s-otchetnost/");
	ТекстПриКритическойОшибке = НСтр("ru = 'Проверьте, что криптопровайдер зарегистрирован, лицензия не истекла.';
									|en = 'Проверьте, что криптопровайдер зарегистрирован, лицензия не истекла.'")
		+ " " + НСтр("ru = 'При продолжении ошибки переустановите криптопровайдер и перезагрузите компьютер.';
					|en = 'При продолжении ошибки переустановите криптопровайдер и перезагрузите компьютер.'");
	РекомендуемаяМинимальнаяВерсияКриптоПроCSP = "5.0.11635";
	СсылкаНаКриптоПроCSP = Новый ФорматированнаяСтрока(НСтр("ru = 'КриптоПро CSP';
															|en = 'КриптоПро CSP'"),,,, "https://cryptopro.ru/");
	ТекстВерсииОбновленияКриптоПроCSP = СтрШаблон(
		НСтр("ru = 'до версии %1 или выше';
			|en = 'до версии %1 или выше'"),
		РекомендуемаяМинимальнаяВерсияКриптоПроCSP);
	ТекстРекомендацииОбновитьКриптопровайдер = НСтр("ru = 'Рекомендуется обновить криптопровайдер';
													|en = 'Рекомендуется обновить криптопровайдер'");
	ТекстТехническиеПодробности = НСтр("ru = 'Технические подробности ошибки записаны в журнал регистрации.';
										|en = 'Технические подробности ошибки записаны в журнал регистрации.'");
	СсылкаНаСтатьюФСС = Новый ФорматированнаяСтрока(НСтр("ru = 'статье';
														|en = 'статье'"),,,,
		"https://its.1c.ru/bmk/elreps/fss_cert");
	СсылкаНаИнструкциюФСС = Новый ФорматированнаяСтрока(НСтр("ru = 'инструкцией';
															|en = 'инструкцией'"),,,,
		"https://its.1c.ru/bmk/elreps/fss_cert");
	СсылкаНаВопросыОтветыФСС = Новый ФорматированнаяСтрока(НСтр("ru = 'вопросами и ответами';
																|en = 'вопросами и ответами'"),,,,
		"https://its.1c.ru/bmk/elreps/eln");
	ТекстНастройкиОбменаСФСС = Новый ФорматированнаяСтрока(
		НСтр("ru = 'Ознакомьтесь с';
			|en = 'Ознакомьтесь с'") + " ",
		СсылкаНаИнструкциюФСС,
		" " + НСтр("ru = 'по установке и настройке сертификатов обмена с ФСС';
					|en = 'по установке и настройке сертификатов обмена с ФСС'") + ", ",
		СсылкаНаВопросыОтветыФСС,
		".");
	
	Если ТипОперации = "ПодписатьPKCS7" И КриптографияЭДКОКлиентСервер.ЭтоОшибкаНеавторизованногоУЦ(ОписаниеОшибки) Тогда
		ЭтоПредупреждение = Истина;
		
		ОписаниеОшибкиСкорректированное = СтрЗаменить(ОписаниеОшибки, "'", """");
		МассивСообщений.Добавить(ОписаниеОшибкиСкорректированное);
		МассивСообщений.Добавить(ТекстПереводСтроки);
		МассивСообщений.Добавить(НСтр("ru = 'Подробнее о настройках подключения читайте в';
										|en = 'Подробнее о настройках подключения читайте в'") + " ");
		МассивСообщений.Добавить(СсылкаНаСтатьюФСС);
		МассивСообщений.Добавить(".");
		
	ИначеЕсли ТипОперации = "Подписать" ИЛИ ТипОперации = "ПодписатьPKCS7" Тогда
		ТекстСообщения = Новый ФорматированнаяСтрока(
			ОписаниеОшибки,,
			ЦветЭлементаСтиля("ЦветОшибкиВПротоколеБРО"));
		МассивСообщений.Добавить(ТекстСообщения);
		МассивСообщений.Добавить(ТекстПереводСтроки + ТекстПереводСтроки);
		МассивСообщений.Добавить(НСтр("ru = 'Попробуйте выполнить следующие действия.';
										|en = 'Попробуйте выполнить следующие действия.'"));
		
		Если КриптографияЭДКОКлиентСервер.ЭтоКритическаяОшибкаКриптопровайдера(ОписаниеОшибки) Тогда
			МассивСообщений.Добавить(ТекстПереводСтроки + ТекстПереводСтроки);
			МассивСообщений.Добавить(ТекстПриКритическойОшибке);
			
		Иначе
			НомерСообщения = 1;
			НомерСообщенияСтрокой = Формат(НомерСообщения, "ЧДЦ=; ЧН=; ЧГ=");
			МассивСообщений.Добавить(ТекстПереводСтроки + ТекстПереводСтроки);
			МассивСообщений.Добавить(НомерСообщенияСтрокой + ". "
				+ НСтр("ru = 'Вставьте токен (флешку) в USB-порт или удостоверьтесь, что есть доступ к закрытому ключу, и повторите попытку.';
						|en = 'Вставьте токен (флешку) в USB-порт или удостоверьтесь, что есть доступ к закрытому ключу, и повторите попытку.'"));
			
			Если ТипКриптопровайдераВладельца <> Неопределено Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'При использовании программы на нескольких компьютерах повторите попытку на том, где настроен %1.';
						|en = 'При использовании программы на нескольких компьютерах повторите попытку на том, где настроен %1.'"),
					?(ТипКриптопровайдераВладельца = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet"),
						НСтр("ru = 'ViPNet CSP';
							|en = 'ViPNet CSP'"),
						?(ТипКриптопровайдераВладельца = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro"),
						НСтр("ru = 'КриптоПро CSP';
							|en = 'КриптоПро CSP'"), Строка(ТипКриптопровайдераВладельца))));
					
				НомерСообщения = НомерСообщения + 1;
				НомерСообщенияСтрокой = Формат(НомерСообщения, "ЧДЦ=; ЧН=; ЧГ=");
				МассивСообщений.Добавить(ТекстПереводСтроки + ТекстПереводСтроки);
				МассивСообщений.Добавить(НомерСообщенияСтрокой + ". " + ТекстСообщения);
			КонецЕсли;
			
			НомерСообщения = НомерСообщения + 1;
			НомерСообщенияСтрокой = Формат(НомерСообщения, "ЧДЦ=; ЧН=; ЧГ=");
			ТекстСообщения = НомерСообщенияСтрокой + ". " + НСтр("ru = 'Перенесите закрытый ключ с другого компьютера.';
																|en = 'Перенесите закрытый ключ с другого компьютера.'");
			СсылкаНаИнструкциюViPNetCSP = "https://its.1c.ru/bmk/elreps/key_trans_vipnet";
			СсылкаНаИнструкциюКриптоПроCSP = "https://its.1c.ru/bmk/elreps/key_trans_cryptopro";
			
			Если ТипКриптопровайдераВладельца <>
				ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet")
				И ТипКриптопровайдераВладельца <>
				ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.CryptoPro") Тогда
				
				СсылкаНаИнструкциюViPNetCSP = Новый ФорматированнаяСтрока(НСтр("ru = 'ViPNet CSP';
																				|en = 'ViPNet CSP'"),,,,
					СсылкаНаИнструкциюViPNetCSP);
				СсылкаНаИнструкциюКриптоПроCSP = Новый ФорматированнаяСтрока(НСтр("ru = 'КриптоПро CSP';
																					|en = 'КриптоПро CSP'"),,,,
					СсылкаНаИнструкциюКриптоПроCSP);
				ТекстСообщения = Новый ФорматированнаяСтрока(
					ТекстСообщения,
					" ",
					НСтр("ru = 'Инструкция по переносу для';
						|en = 'Инструкция по переносу для'") + " ",
					СсылкаНаИнструкциюViPNetCSP,
					" " + НСтр("ru = 'и';
								|en = 'и'") + " ",
					СсылкаНаИнструкциюКриптоПроCSP,
					".");
				
			Иначе
				СсылкаНаИнструкцию = Новый ФорматированнаяСтрока(НСтр("ru = 'Инструкция по переносу';
																		|en = 'Инструкция по переносу'"),,,,
					?(ТипКриптопровайдераВладельца = ПредопределенноеЗначение("Перечисление.ТипыКриптоПровайдеров.VipNet"),
					СсылкаНаИнструкциюViPNetCSP, СсылкаНаИнструкциюКриптоПроCSP));
				ТекстСообщения = Новый ФорматированнаяСтрока(
					ТекстСообщения,
					" ",
					СсылкаНаИнструкцию,
					".");
			КонецЕсли;
			
