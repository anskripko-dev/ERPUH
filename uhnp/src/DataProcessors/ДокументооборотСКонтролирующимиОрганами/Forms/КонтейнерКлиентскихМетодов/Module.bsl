&НаСервере
Функция СостояниеЭДОсПФР(Организация) Экспорт
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СостояниеЭДОсПФР(Организация);
	
КонецФункции

&НаКлиенте
Функция ПараметрыОткрытияФормыПредложенияОтправитьЗаявлениеВПФР() Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация", Неопределено); // Обязательное
	ДополнительныеПараметры.Вставить("ИзначальныйВидЗаявленияПФР", ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаПодключение")); // Обязательное
	ДополнительныеПараметры.Вставить("ЭтоПредупреждениеИзНастроек", Ложь);
	ДополнительныеПараметры.Вставить("ЭтоПредупреждениеИзОтправки", Ложь);
	ДополнительныеПараметры.Вставить("ЭтоПредупреждениеИзМастера", Ложь);
	ДополнительныеПараметры.Вставить("ЭтоПредупреждениеИзПанели", Ложь);
	ДополнительныеПараметры.Вставить("Отчет", Неопределено); // Обязательное только при отправке для определния текста надписей
	ДополнительныеПараметры.Вставить("ЗаголовокКнопкиПоЗавершению", НСтр("ru = 'Сохранить и закрыть';
																		|en = 'Сохранить и закрыть'")); // Обязательное
	ДополнительныеПараметры.Вставить("СостояниеЭДОсПФР", Неопределено); // Обязательное
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", Неопределено);
	ДополнительныеПараметры.Вставить("ТекущееЗаявлениеПо1Сотчетности", Неопределено);

	Возврат ДополнительныеПараметры; 
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуПредложенияОтправитьЗаявлениеВПФР(Параметры, ОповещениеОЗавершении = Неопределено) Экспорт
	
	ДопПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(Параметры);
	ДопПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьФормуПредложенияОтправитьЗаявлениеВПФР_Завершение", 
		ЭтотОбъект,
		ДопПараметры);
		
	// Для предотвращения ошибки 
	// Ошибка передачи данных между клиентом и сервером. Значение недопустимого типа.
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПредложениеОтправитьЗаявлениеВПФР", Параметры,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПредложенияОтправитьЗаявлениеВПФР_Завершение(Результат, ВходящийКонтекст) Экспорт
	
	Если ВходящийКонтекст.ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиОтправки(Состояние, Организация, ОповещениеОЗавершении = Неопределено, Отчет = Неопределено) Экспорт
	
	ЭтоОтправкаОтчета = ЗначениеЗаполнено(Отчет);
	ПараметрыОткрытия = ПараметрыОткрытияПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиПриОтправке(Состояние, ЭтоОтправкаОтчета);
 
	ИзначальныйВидЗаявленияПФР = ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаПодключение");
	
	ПараметрыФормы = ПараметрыОткрытияФормыПредложенияОтправитьЗаявлениеВПФР();
	ПараметрыФормы.Организация = Организация;
	ПараметрыФормы.ИзначальныйВидЗаявленияПФР = ИзначальныйВидЗаявленияПФР;
	ПараметрыФормы.СостояниеЭДОсПФР = Состояние;
	
	Если Отчет = Неопределено Тогда
		ПараметрыФормы.ЭтоПредупреждениеИзНастроек = Истина;
	Иначе
		
		ПараметрыФормы.ЭтоПредупреждениеИзОтправки = Истина;
		ПараметрыФормы.Отчет = Отчет;
		
	КонецЕсли;
	
	ОткрытьФормуПредложенияОтправитьЗаявлениеВПФР(ПараметрыФормы, ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыОткрытияПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиПриОтправке(Состояние, ЭтоОтправкаОтчета) // Из настроек или при отправке
	
	ЭтоОткрытиеИзНастроек = НЕ ЭтоОтправкаОтчета;
	НаправлениеПодключено = Состояние.НаправлениеПодключено;
	ОрганизацияОтключена  = ЭтоОтправкаОтчета И Состояние.НаОтключение.ОрганизацияОтключена;
	
	// Отправить заявление на подключение
	НужноОтправитьЗаявлениеПриОтправке = 
		НаправлениеПодключено 
		И ЭтоОтправкаОтчета 
		И (Состояние.НаПодключение.НужноОтправитьЗаявление ИЛИ ОрганизацияОтключена);
		
	НужноОтправитьЗаявлениеИзНастроек = 
		НаправлениеПодключено 
		И ЭтоОткрытиеИзНастроек 
		И Состояние.НаПодключение.НужноОтправитьЗаявление;
	
	НужноОтправитьЗаявление = 
		НужноОтправитьЗаявлениеПриОтправке 
		ИЛИ НужноОтправитьЗаявлениеИзНастроек;
		
	// Предупредить о неодобренном
	ПредупредитьОНеодобренномПриОтправке = 
		Состояние.Неодобренное.Предупредить И ЭтоОтправкаОтчета 
		И НЕ Состояние.Неодобренное.Вид = ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаОтключение");
		
	ПредупредитьОНеодобренномИзНастроек = 
		Состояние.Неодобренное.Предупредить 
		И ЭтоОткрытиеИзНастроек;
	
	ПредупредитьОНеодобренном = 
		ПредупредитьОНеодобренномПриОтправке 
		ИЛИ ПредупредитьОНеодобренномИзНастроек;
		
	// Собираем все вместе
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НужноОтправитьЗаявление", НужноОтправитьЗаявление);
	ДополнительныеПараметры.Вставить("НужноОтправитьСертификат", Ложь);
	ДополнительныеПараметры.Вставить("ПредупредитьОНеодобренном", ПредупредитьОНеодобренном);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Функция НужноОткрытьФормуПредложенияОтправитьЗаявлениеВПФР(Состояние, ЭтоОтправкаОтчета) // Из настроек или при отправке
	
	ПараметрыОткрытия = ПараметрыОткрытияПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиПриОтправке(Состояние, ЭтоОтправкаОтчета);
	
	Возврат ПараметрыОткрытия.НужноОтправитьЗаявление
		ИЛИ ПараметрыОткрытия.ПредупредитьОНеодобренном;
	
КонецФункции

&НаКлиенте
Функция УстановитьЗаголовокОбменаСПФР(Форма, Состояние, ЦветУспеха = Неопределено, ЦветОшибки = Неопределено) Экспорт // В настройках
	
	ПараметрыОткрытия = ПараметрыОткрытияПредложенияОтправитьЗаявлениеВПФРИзНастроекИлиПриОтправке(Состояние, Ложь);

	Подсказка = "";
	Если Состояние.НаОтключение.ОрганизацияОтключена Тогда
		
		Оранжевый = Новый Цвет(255, 128, 0);
		ЗаголовокСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'Подключено (ЭТК откл.)';
															|en = 'Подключено (ЭТК откл.)'"),,Оранжевый,,"ПФР");
		Подсказка = НСтр("ru = 'Использование электронных трудовых книжек отключено.';
						|en = 'Использование электронных трудовых книжек отключено.'");
		
	ИначеЕсли ПараметрыОткрытия.НужноОтправитьЗаявление Тогда
			
		Красный = ?(ЦветОшибки = Неопределено, Новый Цвет(225, 40, 40), ЦветОшибки);
		ЗаголовокСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'Не отправлено заявление в СФР';
															|en = 'Не отправлено заявление в СФР'"),,Красный,,"ПФР");
		Подсказка = ДокументооборотСКОКлиентСервер.ПодсказкаКЗаявлениюНаПодключениеПФР();
		
	ИначеЕсли ПараметрыОткрытия.ПредупредитьОНеодобренном Тогда
		
		Вид       = Состояние.Неодобренное.Вид;
		Оранжевый = Новый Цвет(255, 128, 0);
		
		Если Вид = ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаПодключение") Тогда
			ЗаголовокСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'Рассматривается заявление на подключение';
																|en = 'Рассматривается заявление на подключение'"),,Оранжевый,,"ПФР");
			Подсказка = ДокументооборотСКОКлиентСервер.ПодсказкаКЗаявлениюНаПодключениеПФР();
		ИначеЕсли Вид = ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаОтключение") Тогда
			ЗаголовокСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'Рассматривается заявление на отключение';
																|en = 'Рассматривается заявление на отключение'"),,Оранжевый,,"ПФР");
			Подсказка = ДокументооборотСКОКлиентСервер.ПодсказкаКЗаявлениюНаОтключениеПФР();
		КонецЕсли;
		
	Иначе
		
		Зеленый = ?(ЦветУспеха = Неопределено, Новый Цвет(100, 176, 16), ЦветУспеха);
		ЗаголовокСсылки = Новый ФорматированнаяСтрока(НСтр("ru = 'Подключено';
															|en = 'Подключено'"),,Зеленый,,"ПФР");
		
	КонецЕсли;
	
	ЭлементыФормы = Форма.Элементы;
	ЭлементыФормы.ОбменСПФР.Заголовок = ЗаголовокСсылки;
	
	Если Подсказка = "" Тогда
		ЭлементыФормы.ОбменСПФР.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Иначе
		ЭлементыФормы.ОбменСПФР.РасширеннаяПодсказка.Заголовок = Подсказка;
		ЭлементыФормы.ОбменСПФР.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОповеститьОбОтправкеЗаявленияВПФР(Ссылка, Организация) Экспорт
	
	// Перерисовка статуса отправки в форме Отчетность
	ПараметрыОповещения = Новый Структура(); 
	ПараметрыОповещения.Вставить("Ссылка", Ссылка);
	ПараметрыОповещения.Вставить("Организация", Организация);
	
	Оповестить(РегламентированнаяОтчетностьКлиент.ИмяСобытияЗавершениеОтправки(), ПараметрыОповещения, Ссылка);
	
	ОповеститьОбИзменении(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СпроситьПроСохранениеЗаявленияПФР(Форма) Экспорт
	
	Если Форма.Элементы.ЗаявленияВПФР_ОтправитьЗаявление.Заголовок = Форма.ЗаголовокКнопкиПоЗавершению Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?';
							|en = 'Данные были изменены. Сохранить изменения?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(НСтр("ru = 'Сохранить';
							|en = 'Сохранить'"));
		Кнопки.Добавить(НСтр("ru = 'Закрыть без сохранения';
							|en = 'Закрыть без сохранения'"));
		
		КнопкаПоУмолчанию = НСтр("ru = 'Сохранить';
								|en = 'Сохранить'");
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СпроситьПроСохранениеЗаявленияПФР_Завершение", 
		ЭтотОбъект,
		Форма); 
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки,,КнопкаПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура СпроситьПроСохранениеЗаявленияПФР_Завершение(Ответ, Форма) Экспорт
	
	Если Ответ = НСтр("ru = 'Сохранить';
						|en = 'Сохранить'") Тогда
		
		Форма.СохранитьНастройкиСостоянияЭДОСПФР();
		Форма.ПередЗакрытием_Завершение();
		
	ИначеЕсли Ответ = НСтр("ru = 'Закрыть без сохранения';
							|en = 'Закрыть без сохранения'") 
		ИЛИ Ответ = НСтр("ru = 'Не отправлять';
						|en = 'Не отправлять'") Тогда
		
		Форма.ПередЗакрытием_Завершение();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЭДОсПФРПриЗаписиТранспортногоСообщения(Ссылка,
		ОбновляемоеТранспортноеСообщение = Неопределено)
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	КонтекстЭДОСервер.ОбновитьСостояниеЭДОсПФРПриЗаписиТранспортногоСообщения(Ссылка, ОбновляемоеТранспортноеСообщение);
	
КонецПроцедуры

