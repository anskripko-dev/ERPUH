&НаКлиенте
Функция ПодготовитьОблачнуюПодпись(ИмяФайла = Неопределено, ТипФайла = "txt", ТребуетПодтверждениеОперации = Ложь, ДополнитьСтруктуру = Неопределено)
	
	Результат = Новый Структура;
	
	Если Лев(ТипФайла, 1) = "." Тогда
		Результат.Вставить("ТипФайла", Сред(ТипФайла, 2));
	Иначе	
		Результат.Вставить("ТипФайла", ТипФайла);
	КонецЕсли;	
	
	Если ИмяФайла = Неопределено Тогда
		Результат.Вставить("ИмяФайла", "Данные для подписи");
	Иначе
		Результат.Вставить("ИмяФайла", ИмяФайла);
	КонецЕсли;
	
	Если ТипЗнч(ТребуетПодтверждениеОперации) = Тип("Структура") Тогда
		Результат.Вставить("ПодтверждатьПринудительно", СвойствоСтруктуры(ТребуетПодтверждениеОперации, "ТребуетПодтверждениеОперации", Ложь));
	Иначе
		Результат.Вставить("ПодтверждатьПринудительно", ТребуетПодтверждениеОперации);
	КонецЕсли;
	
	Если ДополнитьСтруктуру <> Неопределено Тогда
		ДополнитьСтруктуру.Вставить("ДанныеОблачнойПодписи", Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет подписание пакета документов, поддерживаемый сервисом облачной подписи
//
// Параметры:
//	ОписаниеОповещения	- ОписаниеОповещения
//	МестоХраненияКлюча	- Структура
//	МассивДокументов	- Массив Из Структура
//	СертификатПодписи	- Структура
//	ПараметрыОперации	- Структура
//		* ПодтверждатьОперацию - Булево
//
&НаКлиенте
Процедура ПакетнаяПодписьОблачнойПодписи(
		ОписаниеОповещения,
		МестоХраненияКлюча,
		МассивДокументов,
		СертификатПодписи,
		ПараметрыОперации = Неопределено)
		
	УчетнаяЗапись = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
	КриптографияЭДКОКлиент.ПакетнаяПодписьОблачнойПодписи(ОписаниеОповещения, УчетнаяЗапись, МассивДокументов, СертификатПодписи, ПараметрыОперации);

КонецПроцедуры

&НаКлиенте
Процедура НовыйДокументПакетнойПодписи(
		МассивДокументов,
		ДанныеДокумента,
		ИмяФайла,
		Расширение,
		Счетчик = 0,
		ИсходноеСодержание = "")
		
	Если Лев(Расширение, 1) = "." Тогда
		ТипДокумента = Сред(Расширение, 2);
	Иначе	
		ТипДокумента = Расширение;
	КонецЕсли;	
	
	ИмяДокумента = ИмяФайла;
	Если ЗначениеЗаполнено(Счетчик) Тогда
		ИмяДокумента = ИмяДокумента + " - " + СокрЛП(Счетчик);
	КонецЕсли;	
	
	НоваяСтрока = Новый Структура; 
	НоваяСтрока.Вставить("Содержание", ДанныеДокумента);
	НоваяСтрока.Вставить("ИмяДокумента", ИмяДокумента);
	НоваяСтрока.Вставить("ТипДокумента", ТипДокумента);
	НоваяСтрока.Вставить("ИсходноеСодержание", ИсходноеСодержание);
	
	МассивДокументов.Добавить(НоваяСтрока);

КонецПроцедуры

&НаКлиенте
Функция РежимПодтвержденияОблачнойПодписи(ВидОперации, УчетнаяЗаписьКО, КонтекстОперации = Неопределено, ЗначениеПоУмолчанию = Неопределено)
	
	// 1 - По умолчанию, определяется в коде программе
	// 2 - Все отключено
	// 3 - Все подтверждать (режим тестирования)
	// 4 - Выборочный режим
	
	Если ЗначениеПоУмолчанию = Неопределено Тогда
		Результат = Истина;
	Иначе	
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ТекущиеНастройки = ПрочитатьПараметрыПодтвержденияОблачнойПодписи(УчетнаяЗаписьКО);
	
	Если (ТекущиеНастройки.РежимПодтверждения = 1
		ИЛИ ТекущиеНастройки.РежимПодтверждения = 4) 
		И ЗначениеПоУмолчанию = Неопределено Тогда
		ТекущийРежим = ТекущиеНастройки.СписокОпераций[ВидОперации];
		Если ТекущийРежим <> Неопределено Тогда
			Результат = ТекущийРежим;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	ИначеЕсли ТекущиеНастройки.РежимПодтверждения = 2 Тогда
		Результат = Ложь;
	ИначеЕсли ТекущиеНастройки.РежимПодтверждения = 3 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если КонтекстОперации <> Неопределено Тогда
		КонтекстОперации.Вставить("ТребуетПодтверждениеОперации", Результат);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьПараметрыПодтвержденияОблачнойПодписи(УчетнаяЗаписьКО) Экспорт
	
	ТекущиеНастройки = Неопределено;
	
	Если ПараметрыПодтвержденияОблачнойПодписи = Неопределено Тогда
		ПараметрыПодтвержденияОблачнойПодписи = Новый Соответствие;
	КонецЕсли;
	
	СсылкаСправочника = Неопределено;
	
	Если ТипЗнч(УчетнаяЗаписьКО) = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота") Тогда
		СсылкаСправочника = УчетнаяЗаписьКО;
	ИначеЕсли ТипЗнч(УчетнаяЗаписьКО) = Тип("СправочникСсылка.Организации") Тогда
		СсылкаСправочника = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(УчетнаяЗаписьКО, "УчетнаяЗаписьОбмена");
	ИначеЕсли ТипЗнч(УчетнаяЗаписьКО) = Тип("СправочникСсылка.ЦиклыОбмена") Тогда
		СсылкаСправочника = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(УчетнаяЗаписьКО, "УчетнаяЗапись");
	ИначеЕсли ТипЗнч(УчетнаяЗаписьКО) = Тип("ДокументСсылка.ТранспортноеСообщение") Тогда
		СсылкаСправочника = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(УчетнаяЗаписьКО, "УчетнаяЗапись");
	КонецЕсли;
	
	ТекущиеНастройки = ПараметрыПодтвержденияОблачнойПодписи[СсылкаСправочника];
	Если ТекущиеНастройки = Неопределено Тогда
		ТекущиеНастройки = ПолучитьПараметрыПодтвержденияОблачнойПодписи(УчетнаяЗаписьКО);
		ПараметрыПодтвержденияОблачнойПодписи.Вставить(СсылкаСправочника, ТекущиеНастройки);
	КонецЕсли;
	
	Возврат ТекущиеНастройки;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьПараметрыПодвержденияОблачнойПодписи(СсылкаСправочника, ТекущиеНастройки) Экспорт
	
	Если ПараметрыПодтвержденияОблачнойПодписи = Неопределено Тогда
		ПараметрыПодтвержденияОблачнойПодписи = Новый Соответствие;
	КонецЕсли;
	
	НовыеНастройки = ЗаписатьПараметрыПодвержденияОблачнойПодписиНаСервере(СсылкаСправочника, ТекущиеНастройки);
	ПараметрыПодтвержденияОблачнойПодписи.Вставить(СсылкаСправочника, НовыеНастройки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатьПараметрыПодвержденияОблачнойПодписиНаСервере(СсылкаСправочника, ТекущиеНастройки)
	
	СохраняемыеНастройки = ПолучитьПараметрыПодтвержденияОблачнойПодписи(ТекущиеНастройки, Истина);
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(СсылкаСправочника, СохраняемыеНастройки, "ПодтверждениеОперацийОблачнойПодписи");
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СохраняемыеНастройки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыПодтвержденияОблачнойПодписи(СсылкаСправочника, ЗаполнитьПринудительно = Ложь)
	
	ВнешнийМодуль = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Результат = ВнешнийМодуль.ПолучитьПараметрыПодтвержденияОблачнойПодписи(СсылкаСправочника, ЗаполнитьПринудительно);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьНастройкиПодтвержденияОблачнойПодписи(ОповещениеОЗавершении, УчетнаяЗаписьДокументооборота) Экспорт
	
	Если КриптографияЭДКОСлужебныйКлиент.ИспользованиеОблачнойПодписиВозможно() Тогда
		ПараметрыЦикла = Новый Структура;
		ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		ПараметрыЦикла.Вставить("УчетнаяЗаписьДокументооборота", УчетнаяЗаписьДокументооборота);
		
		ДанныеУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(УчетнаяЗаписьДокументооборота);
		Если ЭтоОблачнаяПодпись(ДанныеУчетнойЗаписи.МодельХраненияЗакрытогоКлюча) Тогда
			ОповещениеСледующее = Новый ОписаниеОповещения("ИзменитьНастройкиПодтвержденияОблачнойПодписиПослеАвторизации", ЭтотОбъект, ПараметрыЦикла);
			МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
			МодульСервисКриптографииDSSКлиент.ПроверкаАутентификацииПользователя(ОповещениеСледующее, ДанныеУчетнойЗаписи.УчетнаяЗаписьОблачнойПодписи);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкиПодтвержденияОблачнойПодписиПослеАвторизации(РезультатВыполнения, ВходящийКонтекст) Экспорт

	Если РезультатВыполнения.Выполнено Тогда
		СтруктураПараметров = Новый Структура("УчетнаяЗаписьДокументооборота", ВходящийКонтекст.УчетнаяЗаписьДокументооборота);
		ОповещениеСледующее = Новый ОписаниеОповещения("ИзменитьНастройкиПодтвержденияОблачнойПодписиЗавершение", ЭтотОбъект, ВходящийКонтекст);
		ОткрытьФорму(ПутьКОбъекту + ".Форма.НастройкаПодтвержденияОблачнойПодписи", СтруктураПараметров,,,,, ОповещениеСледующее, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкиПодтвержденияОблачнойПодписиЗавершение(РезультатВыполнения, ВходящийКонтекст) Экспорт

	Если ЗначениеЗаполнено(ВходящийКонтекст.ОповещениеОЗавершении) Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗарегистрироватьСертификатВХранилищеПолучателей(АдресДанныхСертификата, Хранилище, ОтпечатокСертификата = Неопределено)
	
	Если ТипЗнч(АдресДанныхСертификата) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанныеСертификата = АдресДанныхСертификата;
	Иначе	
		ДвоичныеДанныеСертификата = ПолучитьИзВременногоХранилища(АдресДанныхСертификата);
	КонецЕсли;
	
	КриптографияЭДКО.ДобавитьСертификатПолучателя(ДвоичныеДанныеСертификата, Хранилище);
	СвойстваСертификата = КриптографияЭДКО.ПолучитьСвойстваСертификатаПолучателя(ДвоичныеДанныеСертификата);
	
	ОтпечатокСертификата = ?(СвойстваСертификата <> Неопределено, СвойстваСертификата.Отпечаток, Неопределено);
	Возврат (СвойстваСертификата <> Неопределено);
	
КонецФункции

&НаКлиенте
Процедура УстановитьСертификатыПолучателей(ПараметрыФункции, ВыполняемоеОповещение, ТолькоПолучатели = Ложь)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ПараметрыФункции);
	МассивНовыхСертификатов = Новый Массив;
	РезультатВыполнения = РегистрацияУстановитьСертификатыОблачнойПодписиНаСервере(ПараметрыФункции.ОтпечатокСертификата, МассивНовыхСертификатов, МестоХраненияКлюча);
	Результат = Новый Структура("РезультатВыполнения, ПараметрыФункции", РезультатВыполнения, ПараметрыФункции);
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, Результат);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификатыЛокально(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ВыполняемоеОповещение = ВходящийКонтекст.ВыполняемоеОповещение;
	ПараметрыФункции = ВходящийКонтекст.ПараметрыФункции;
	
	РегистрируемыеСертификаты = Новый Массив;
	Для каждого Сертификат Из Сертификаты Цикл
		РегистрируемыйСертификат = Новый Структура("Отпечаток", Сертификат.Отпечаток);
		РегистрируемыеСертификаты.Добавить(РегистрируемыйСертификат);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение, ПараметрыФункции", ВыполняемоеОповещение, ПараметрыФункции);
	Оповещение = Новый ОписаниеОповещения("РегистрацияУстановитьСертификатыПослеПоискаСертификатовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, РегистрируемыеСертификаты, , Ложь);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеДляЗапросаНаСертификат(УчетнаяЗаписьОблачнойПодписи, ПоляЗаявления)
	
	Результат = Новый Структура();
	Результат.Вставить("Выполнено", Ложь);
	
	МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
	СводныеДанные = МодульСервисКриптографииDSS.ПолучитьИнформациюУдостоверяющихЦентров(УчетнаяЗаписьОблачнойПодписи);
	Если СводныеДанные.Заполнено Тогда
		
		ТекущийКриптоПровайдер = Неопределено;
		ТекущийШаблон = Неопределено;
		УдостоверяющийЦентр = Неопределено;
		ПоляАтрибутов = Неопределено;
		ИмяСертификата = "";
		
		Для Каждого СтрокаМассива Из СводныеДанные.Криптопровайдеры Цикл
			ТекущийКриптоПровайдер = СтрокаМассива.Идентификатор;
			Если СтрНайти(СтрокаМассива.Описание, "2012") Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		
		Для Каждого СтрокаМассива Из СводныеДанные.УдостоверяющиеЦентры Цикл
			ПоляУЦ = МодульСервисКриптографииDSS.ПолучитьРеестрПолейУдостоверяющегоЦентра(СтрокаМассива);
			НовыеПоля = Новый Соответствие;
			ВсеОбязательные = 0;
			ИмяСертификата = "";
			Для Каждого СтрокаПоля Из ПоляУЦ Цикл
				ВсеОбязательные = ВсеОбязательные + ?(СтрокаПоля.Обязательно, 1, 0);
				ЗначениеПоля = ПоляЗаявления[СтрокаПоля.OID];
				
				Если СтрокаПоля.Обязательно Тогда
					ИмяСертификата = ИмяСертификата + ?(ПустаяСтрока(ИмяСертификата), "", ",") + СтрокаПоля.Имя + "=" + ЗначениеПоля;
				КонецЕсли;	
				
				Если ЗначениеПоля <> Неопределено Тогда
					НовыеПоля.Вставить(СтрокаПоля.OID, ЗначениеПоля);
					ВсеОбязательные = ВсеОбязательные - ?(СтрокаПоля.Обязательно, 1, 0);
				КонецЕсли;
				
			КонецЦикла;
			
			Если НовыеПоля.Количество() >= ПоляЗаявления.Количество() 
				И ВсеОбязательные = 0 Тогда
				УдостоверяющийЦентр = СтрокаМассива;
				ПоляАтрибутов = НовыеПоля;
				Прервать;
			КонецЕсли;	

		КонецЦикла;
		
		Если УдостоверяющийЦентр <> Неопределено Тогда 
			ШаблоныУЦ = МодульСервисКриптографииDSS.ПолучитьРеестрШаблоновУдостоверяющегоЦентра(УдостоверяющийЦентр);
			Для Каждого СтрокаШаблона Из ШаблоныУЦ Цикл
				ТекущийШаблон = СтрокаШаблона.Шаблон;
				Если СтрНайти(СтрокаШаблона.Наименование, "2012") > 0 Тогда
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущийКриптоПровайдер) Тогда
			Результат.Вставить("КриптоПровайдер", ТекущийКриптоПровайдер);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущийШаблон) Тогда
			Результат.Вставить("ШаблонСертификата", ТекущийШаблон);
		КонецЕсли;
		
		Если УдостоверяющийЦентр <> Неопределено Тогда 
			Результат.Вставить("УдостоверяющийЦентр", УдостоверяющийЦентр.Идентификатор);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяСертификата) Тогда
			ИмяСертификата = СтрЗаменить(ИмяСертификата, """", "");
			Результат.Вставить("ИмяСертификата", ИмяСертификата);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляАтрибутов) Тогда
			Результат.Вставить("ПоляАтрибутов", ПоляАтрибутов);
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Результат.Количество() = 6 Тогда
		Результат.Выполнено = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФормироватьЗапросНаСертификатОблачнойПодписиСервер(МестоХраненияКлюча)
	
	Результат = Ложь;
	
	Если КриптографияЭДКОКлиентСервер.ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		УчетнаяЗаписьОблачнойПодписи = КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
		Если ЗначениеЗаполнено(УчетнаяЗаписьОблачнойПодписи) Тогда
			Результат = НЕ ОбработкаЗаявленийАбонентаВызовСервера.ЭтоПоставляемыйСерверОблачнойПодписи(УчетнаяЗаписьОблачнойПодписи);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ФормироватьЗапросНаСертификатОблачнойПодписи(МестоХраненияКлюча) Экспорт
	
	Результат = ФормироватьЗапросНаСертификатОблачнойПодписиСервер(МестоХраненияКлюча);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодпись(ВходящийКонтекст)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
	ОповещениеСледующее = Новый ОписаниеОповещения("ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодписьПродолжение", ЭтотОбъект, ВходящийКонтекст);
	ПараметрыОперации = Новый Структура("ПояснениеОперации", "Подключение к электронной подписи в программе для создания закрытого ключа");
	
	МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
	МодульСервисКриптографииDSSКлиент.ПроверкаАутентификацииПользователя(
			ОповещениеСледующее, 
			КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча),
			ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаявлениеСформироватьЗапросНаСертификатКвалифицированныйОП(ВходящийКонтекст)
	
	ДокументЗаявление    = ВходящийКонтекст.ДокументЗаявление;
	ПараметрыНовогоСертификата = ОбработкаЗаявленийАбонентаКлиент.ПараметрыНовогоСертификата(ДокументЗаявление);
	
	Результат = Новый Соответствие;
	
	Для Счетчик = 0 По ПараметрыНовогоСертификата.Количество()-1 Цикл 
		
		Если ПараметрыНовогоСертификата[Счетчик].Значение = "РегНомерФСС" Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = ПараметрыНовогоСертификата[Счетчик].Значение;
		Представление = СокрЛП(Строка(ПараметрыНовогоСертификата[Счетчик].Представление));
		
		Если ПустаяСтрока(Представление) Тогда
			Представление = "0";
		КонецЕсли;
		
		Результат.Вставить(Значение, Представление);
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодписьПродолжение(РезультатВызова, ВходящийКонтекст) Экспорт
	
	Удачно = Ложь;
	
	Если РезультатВызова.Выполнено Тогда
		МестоХраненияКлюча 		= КонтекстМоделиХраненияКлюча(ВходящийКонтекст);
		ОблачнаяУчетнаяЗапись	= КриптографияЭДКОКлиентСервер.ПолучитьУчетнуюЗаписьПодписи(МестоХраненияКлюча);
		ПоляЗаявления 			= ЗаявлениеСформироватьЗапросНаСертификатКвалифицированныйОП(ВходящийКонтекст);
		ДанныеЗапроса 			= ПолучитьДанныеДляЗапросаНаСертификат(ОблачнаяУчетнаяЗапись, ПоляЗаявления);
		
		Если ДанныеЗапроса.Выполнено Тогда
		
			ПоляЗапроса = Новый Структура();
			ПоляЗапроса.Вставить("ПоляАтрибутов", ДанныеЗапроса.ПоляАтрибутов);
			ПоляЗапроса.Вставить("ШаблонСертификата", ДанныеЗапроса.ШаблонСертификата);
			ПоляЗапроса.Вставить("КриптоПровайдер", ДанныеЗапроса.КриптоПровайдер);
			ПоляЗапроса.Вставить("УдостоверяющийЦентр", ДанныеЗапроса.УдостоверяющийЦентр);
			ПоляЗапроса.Вставить("ИмяСертификата", ДанныеЗапроса.ИмяСертификата);
			
			ПараметрыОперации = Новый Структура();
			ПараметрыОперации.Вставить("ГотовыйЗапрос", Истина);
			ПараметрыОперации.Вставить("ПоляЗапроса", ПоляЗапроса);
			ПараметрыОперации.Вставить("ПояснениеОперации", "Создание закрытого ключа и запроса на сертификат");
			ПараметрыОперации.Вставить("ПодтверждатьПринудительно", Истина);
			
			ОповещениеСледующее = Новый ОписаниеОповещения("ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодписьПослеВыполнения", ЭтотОбъект, ВходящийКонтекст);
			
			МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
			МодульСервисКриптографииDSSКлиент.СоздатьЗапросНаСертификат(ОповещениеСледующее, ОблачнаяУчетнаяЗапись, ПараметрыОперации);
			
			Удачно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Удачно Тогда
		ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнойПодписи_Ошибка(ВходящийКонтекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнаяПодписьПослеВыполнения(РезультатВызова, ВходящийКонтекст) Экспорт
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("ПродолжитьОтправкуЗаявления", РезультатВызова.Выполнено);
	СтруктураРезультата.Вставить("ПутьКонтейнерЗакрытогоКлюча", "");
	СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", "");
	СтруктураРезультата.Вставить("АлгоритмКонтейнераКлючей", "");
	СтруктураРезультата.Вставить("ТекстОшибки", "");
	
	Удачно = Ложь;
	ТекстОшибки = "";
	
	Если РезультатВызова.Выполнено Тогда
		СвойстваЗапроса = РезультатВызова.Результат;
		Если СвойстваЗапроса.Статус <> "Отклонен" Тогда
			ДанныеЗапроса = Base64Строка(СвойстваЗапроса.Содержание);
			ДанныеЗапроса = СтрЗаменить(ДанныеЗапроса, Символы.ВК, "");
			ДанныеЗапроса = СтрЗаменить(ДанныеЗапроса, Символы.ПС, "");
			ДанныеЗапроса = "-----BEGIN NEW CERTIFICATE REQUEST-----" + Символы.ПС
							+ СтрЗаменить(ДанныеЗапроса, Символы.ВК, "") + Символы.ПС
							+ "-----END NEW CERTIFICATE REQUEST-----";
			СтруктураРезультата.Вставить("ТекстЗапросаНаСертификат", ДанныеЗапроса);
			Удачно = Истина;
		Иначе
			ТекстОшибки = "Запрос на сертификат был отклонен.";
		КонецЕсли;	
	Иначе
		ТекстОшибки = РезультатВызова.Ошибка;
	КонецЕсли;
	
	Если НЕ Удачно Тогда
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			НСтр("ru = 'Криптографическая ошибка электронной подписи в программе: не удалось сформировать запрос на сертификат для контролирующих органов.';
				|en = 'Криптографическая ошибка электронной подписи в программе: не удалось сформировать запрос на сертификат для контролирующих органов.'"), 
			ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
			ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
				
		СтруктураРезультата.Вставить("ТекстОшибки", ТекстОшибки);
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеСформироватьЗакрытыйКлючИЗапросНаСертификатОблачнойПодписи_Ошибка(
		ВходящийКонтекст,
		ТекстОшибкиПриСозданииКлюча = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстОшибки = ?(ТекстОшибкиПриСозданииКлюча = Неопределено,
		НСтр("ru = 'Криптографическая ошибка электронной подписи в программе: не удалось создать контейнер закрытого ключа.';
			|en = 'Криптографическая ошибка электронной подписи в программе: не удалось создать контейнер закрытого ключа.'"), ТекстОшибкиПриСозданииКлюча);
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
		ТекстОшибки, 
		ВходящийКонтекст.ВызовИзМастераПодключенияК1СОтчетности, 
		ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности);
		
	Оповестить(НСтр("ru = 'Упрощенное заявление. Ошибка создание закрытого ключа';
					|en = 'Упрощенное заявление. Ошибка создание закрытого ключа'"), ТекстОшибки, ВходящийКонтекст.ДокументЗаявление);
		
	СтруктураРезультата = Новый Структура("ПродолжитьОтправкуЗаявления, ТекстОшибки, ПутьКонтейнерЗакрытогоКлюча", 
											Ложь, ВходящийКонтекст.ТекстОшибокДляМастераПодключенияК1СОтчетности, "");
											
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, СтруктураРезультата);
	
КонецПроцедуры

&НаСервере
Функция РегистрацияУстановитьСертификатыОблачнойПодписиНаСервере(ОтпечатокСертификата, СписокНовыхСертификатов, МестоХраненияКлюча)
	
	СписокНовыхСертификатов = Новый Массив;
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.РегистрацияУстановитьСертификатыОблачнойПодписи(ОтпечатокСертификата, СписокНовыхСертификатов, Сертификаты, МестоХраненияКлюча);
	
КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьСертификатВСистемеОблачнаяПодпись(РезультатВызова, ДополнительныеПараметры) Экспорт
	
	Если РезультатВызова <> Неопределено Тогда
		РезультатРегистрации = ЗарегистрироватьСертификатВХранилищеПолучателей(
				РезультатВызова, 
				ДополнительныеПараметры.Хранилище, 
				ДополнительныеПараметры.ОтпечатокСертификата);
		Результат = Новый Структура("Выполнено, Отпечаток", РезультатРегистрации, ДополнительныеПараметры.ОтпечатокСертификата);
	Иначе
		Результат = Новый Структура("Выполнено, ТекстОшибки", Ложь, "Ошибка импорта сертификата оператора.");
	КонецЕсли;	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
			
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОблачнойПодписи(ОповещениеОЗавершении, 
				УчетнаяЗаписьОблачнойПодписи, 
				Логин, 
				СерверОблачнойПодписи, 
				Организация, 
				ПервичноеЗаявление = Ложь,
				ТолькоПросмотр = Ложь,
				ПараметрыОперации = Неопределено) Экспорт
				
	ИдентификаторФормы = СвойствоСтруктуры(ПараметрыОперации, "ИдентификаторФормы");
	ИНН = СвойствоСтруктуры(ПараметрыОперации, "ИНН", "");
	
	ПараметрыДлительнойОперации = ДлительнаяОтправкаКлиент.ПараметрыЗапускаУниверсальногоДлительногоДействия();
	ПараметрыДлительнойОперации.Надпись = НСтр("ru = 'Получение реестра сервисов электронной подписи...';
												|en = 'Получение реестра сервисов электронной подписи...'");
	ПараметрыДлительнойОперации.Заголовок = НСтр("ru = 'Ожидание';
												|en = 'Ожидание'");
	ПараметрыДлительнойОперации.ВыводитьПроценты = Истина;
	ПараметрыДлительнойОперации.Вставить("КонтекстДлительнойОперации", Неопределено);

	ПараметрыЦикла = Новый Структура();
	ПараметрыЦикла.Вставить("УчетнаяЗаписьОблачнойПодписи", УчетнаяЗаписьОблачнойПодписи);
	ПараметрыЦикла.Вставить("Логин", Логин);
	ПараметрыЦикла.Вставить("СерверОблачнойПодписи", СерверОблачнойПодписи);
	ПараметрыЦикла.Вставить("Организация", Организация);
	ПараметрыЦикла.Вставить("ПервичноеЗаявление", ПервичноеЗаявление);
	ПараметрыЦикла.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ПараметрыЦикла.Вставить("ИдентификаторФормы", ИдентификаторФормы);
	ПараметрыЦикла.Вставить("ЗакрытьФормуОжидания", ДлительнаяОтправкаКлиент.ПоказатьУниверсальнуюФормуДлительногоДействия(ПараметрыДлительнойОперации));
	ПараметрыЦикла.Вставить("ИНН", ИНН);
	
	ОповещениеСледущее = Новый ОписаниеОповещения("ОткрытьНастройкиОблачнойПодписиЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	ОткрытьНастройкиОблачнойПодписиФоновымЗаданием(ОповещениеСледущее, ПараметрыЦикла, ИдентификаторФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОблачнойПодписиФоновымЗаданием(ОповещениеСледущее, ПараметрыЦикла, ИдентификаторФормы = Неопределено) Экспорт
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Получение списка сервисов электронной подписи';
											|en = 'Получение списка сервисов электронной подписи'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(СервисПолученияСпискаСервисовОблачнойПодписи(), ОповещениеСледущее, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОблачнойПодписиЗавершение(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	УчетнаяЗаписьОблачнойПодписи = ВходящийКонтекст.УчетнаяЗаписьОблачнойПодписи;
	Логин = ВходящийКонтекст.Логин;
	Организация = ВходящийКонтекст.Организация;
	СерверОблачнойПодписи = ВходящийКонтекст.СерверОблачнойПодписи;
	ПервичноеЗаявление = ВходящийКонтекст.ПервичноеЗаявление;
	ТолькоПросмотр = ВходящийКонтекст.ТолькоПросмотр;
	ИдентификаторФормы = ВходящийКонтекст.ИдентификаторФормы;
	ЗакрытьФормуОжидания = ВходящийКонтекст.ЗакрытьФормуОжидания;
	ИНН = ВходящийКонтекст.ИНН;
	
	Если ЗакрытьФормуОжидания Тогда
		ДлительнаяОтправкаКлиент.ЗакрытьФормуДлительнойОтправкиБезДальнейшихДействий();
	КонецЕсли;
	
	ПараметрыВызова = Новый Структура();
	ПараметрыВызова.Вставить("УчетнаяЗапись", УчетнаяЗаписьОблачнойПодписи);
	ПараметрыВызова.Вставить("Логин", Логин);
	ПараметрыВызова.Вставить("Организация", Организация);
	ПараметрыВызова.Вставить("СерверОблачнойПодписи", СерверОблачнойПодписи);
	ПараметрыВызова.Вставить("ПервичноеЗаявление", ПервичноеЗаявление);
	ПараметрыВызова.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	ПараметрыВызова.Вставить("СписокСерверов", ПолучитьСписокСерверовОблачнойПодписи(РезультатВыполнения));
	ПараметрыВызова.Вставить("ИНН", ИНН);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_НастройкиОблачнойПодписи", ПараметрыВызова, , ИдентификаторФормы, , , ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВосстановлениеОблачнойПодписи(
		ОповещениеОЗавершении, 
		СписокСерверов, 
		Логин = "", 
		СерверОблачнойПодписи = "", 
		ПервичноеЗаявление = Ложь,
		ЭтоБыстрыйСтарт = Ложь) Экспорт
	
	ПараметрыЦикла = Новый Структура();
	ПараметрыЦикла.Вставить("СерверОблачнойПодписи", СерверОблачнойПодписи);
	ПараметрыЦикла.Вставить("Логин", Логин);
	ПараметрыЦикла.Вставить("СписокСерверов", СписокСерверов);
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ПараметрыЦикла.Вставить("ОткрытьСразу", СписокСерверов <> Неопределено);
	ПараметрыЦикла.Вставить("ПервичноеЗаявление", ПервичноеЗаявление);
	ПараметрыЦикла.Вставить("ЭтоБыстрыйСтарт", ЭтоБыстрыйСтарт);
	
	ОповещениеСледущее = Новый ОписаниеОповещения("ОткрытьВосстановлениеОблачнойПодписиЗавершение", ЭтотОбъект, ПараметрыЦикла);
	
	Если НЕ ПараметрыЦикла.ОткрытьСразу Тогда
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Получение списка сервисов электронной подписи';
												|en = 'Получение списка сервисов электронной подписи'");
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(СервисПолученияСпискаСервисовОблачнойПодписи(), ОповещениеСледущее, ПараметрыОжидания);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеСледущее, Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВосстановлениеОблачнойПодписиЗавершение(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	ОповещениеОЗавершении = ВходящийКонтекст.ОповещениеОЗавершении;
	ОткрытьСразу = ВходящийКонтекст.ОткрытьСразу;
	СерверОблачнойПодписи = ВходящийКонтекст.СерверОблачнойПодписи;
	Логин = ВходящийКонтекст.Логин;
	СписокСерверов = ВходящийКонтекст.СписокСерверов;
	ПервичноеЗаявление = ВходящийКонтекст.ПервичноеЗаявление;
	
	ПараметрыВызова = Новый Структура();
	ПараметрыВызова.Вставить("СерверОблачнойПодписи", СерверОблачнойПодписи);
	ПараметрыВызова.Вставить("Логин", Логин);
	Если ОткрытьСразу Тогда
		ПараметрыВызова.Вставить("СписокСерверов", СписокСерверов);
	Иначе
		ПараметрыВызова.Вставить("СписокСерверов", ПолучитьСписокСерверовОблачнойПодписи(РезультатВыполнения));
	КонецЕсли;	
	ПараметрыВызова.Вставить("ПервичноеЗаявление", ПервичноеЗаявление);
	ПараметрыВызова.Вставить("ЭтоБыстрыйСтарт", ВходящийКонтекст.ЭтоБыстрыйСтарт);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.Мастер_ВосстановитьОблачнуюПодпись", ПараметрыВызова, , , , , ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявления(КонтекстФормы, МастерДалее, ПервичноеЗаявление = Ложь, ОповещениеОЗавершении = Неопределено) Экспорт
	
	МестоХраненияКлюча = КонтекстФормы.МестоХраненияКлюча;
	
	Если НЕ МастерДалее ИЛИ НЕ КриптографияЭДКОКлиентСервер.ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЦикла = Новый Структура();
	ПараметрыЦикла.Вставить("КонтекстФормы", КонтекстФормы);
	ПараметрыЦикла.Вставить("ПервичноеЗаявление", ПервичноеЗаявление);
	ПараметрыЦикла.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла, МастерДалее);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла, МастерДалее = Ложь)
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	ПервичноеЗаявление = ПараметрыЦикла.ПервичноеЗаявление;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	
	ОповещениеСледующее = Новый ОписаниеОповещения("ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПродолжение", ЭтотОбъект, ПараметрыЦикла);
	МодульСервисКриптографииDSSКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СервисКриптографииDSSКлиент");
	
	Если СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись И НЕ ЗначениеЗаполнено(СвойствоОблачнойПодписи.НовыйЛогин) Тогда
		МастерДалее = Ложь;
		ТекстСообщения = НСтр("ru = 'Не указаны настройки новой учетной записи электронной подписи.';
								|en = 'Не указаны настройки новой учетной записи электронной подписи.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СвойствоОблачнойПодписи.Телефон) И СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись И НЕ ПервичноеЗаявление Тогда
		МастерДалее = Ложь;
		ТекстВопроса = НСтр("ru = 'Необходимо указать номер мобильного телефона для регистрации мобильного приложения.';
							|en = 'Необходимо указать номер мобильного телефона для регистрации мобильного приложения.'");
		
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить("Контакты", НСтр("ru = 'Ввести номер телефона';
												|en = 'Ввести номер телефона'"));
		СписокОтветов.Добавить("Отмена", НСтр("ru = 'Отмена';
												|en = 'Отмена'"));
		
		МодульСервисКриптографииDSSКлиент.ВывестиВопрос(ОповещениеСледующее, ТекстВопроса, СписокОтветов);
		
	ИначеЕсли СвойствоОблачнойПодписи.УчетнаяЗаписьДляВосстановления = СвойствоОблачнойПодписи.НовыйЛогин И СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись Тогда
		МастерДалее = Ложь;
		ТекстВопроса = НСтр("ru = 'Учетная запись с логином <b>%1</b> существует на сервере 1C:DSS.';
							|en = 'Учетная запись с логином <b>%1</b> существует на сервере 1C:DSS.'") 
						+ " " + НСтр("ru = 'Необходимо восстановить учетную запись электронной подписи с этим логином.';
									|en = 'Необходимо восстановить учетную запись электронной подписи с этим логином.'");
		ТекстВопроса = СтрШаблон(ТекстВопроса, СвойствоОблачнойПодписи.НовыйЛогин);
		ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(ТекстВопроса);
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить("Восстановить", НСтр("ru = 'Восстановить учетную запись';
													|en = 'Восстановить учетную запись'"));
		СписокОтветов.Добавить("Другой", НСтр("ru = 'Указать другую учетную запись';
												|en = 'Указать другую учетную запись'"));
		СписокОтветов.Добавить("Отмена", НСтр("ru = 'Отмена';
												|en = 'Отмена'"));
		
		МодульСервисКриптографииDSSКлиент.ВывестиВопрос(ОповещениеСледующее, ТекстВопроса, СписокОтветов);
		
	ИначеЕсли СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись И НЕ ЗначениеЗаполнено(СвойствоОблачнойПодписи.ИдентификаторСервера) Тогда
		
		МастерДалее = Ложь;
		ТекстВопроса = НСтр("ru = 'Не выбран сервис электронной подписи, на котором будет создана новая учетная запись.';
							|en = 'Не выбран сервис электронной подписи, на котором будет создана новая учетная запись.'");
		
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить("Другой", НСтр("ru = 'Настроить';
												|en = 'Настроить'"));
		СписокОтветов.Добавить("Отмена", НСтр("ru = 'Отмена';
												|en = 'Отмена'"));
		
		МодульСервисКриптографииDSSКлиент.ВывестиВопрос(ОповещениеСледующее, ТекстВопроса, СписокОтветов);
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СвойствоОблачнойПодписи.УчетнаяЗапись) И НЕ СвойствоОблачнойПодписи.НовыйЛогинПроверен Тогда
		ОповещениеСледующее = Новый ОписаниеОповещения("ПроверитьНастройкиОблачнойПодписиПриОтправке_ПоискДублей", ЭтотОбъект, ПараметрыЦикла);
		МастерДалее = Ложь;
		ПроверитьУникальностьЛогинаОблачнойПодписи(ОповещениеСледующее, СвойствоОблачнойПодписи.ИдентификаторСервера, СвойствоОблачнойПодписи.НовыйЛогин);		
		
	ИначеЕсли НЕ МастерДалее Тогда
		ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявлениЗавершение(ПараметрыЦикла);
		
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправке_ПоискДублей(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	Статус = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатВыбора, "Статус", "");
	
	Если Статус = "Найден" Тогда
		ТекстСообщения = НСтр("ru = 'Учетная запись с логином %1 существует в справочнике учетных записей.';
								|en = 'Учетная запись с логином %1 существует в справочнике учетных записей.'") 
						+ " " + НСтр("ru = 'Выберите нужную учетную запись.';
									|en = 'Выберите нужную учетную запись.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СвойствоОблачнойПодписи.НовыйЛогин);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	ИначеЕсли Статус = "Дублирование" Тогда
		ТекстСообщения = НСтр("ru = 'Учетная запись с логином %1 обнаружена в сервисе электронной подписи.';
								|en = 'Учетная запись с логином %1 обнаружена в сервисе электронной подписи.'") 
						+ " " + НСтр("ru = 'Необходимо восстановить учетную запись электронной подписи с этим логином.';
									|en = 'Необходимо восстановить учетную запись электронной подписи с этим логином.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СвойствоОблачнойПодписи.НовыйЛогин);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	Иначе
		КонтекстФормы.СвойствоОблачнойПодписи.НовыйЛогинПроверен = Истина;
		ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПродолжение(РезультатВыбора, ПараметрыЦикла) Экспорт
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	Организация = КонтекстФормы.Организация;
	ПервичноеЗаявление = ПараметрыЦикла.ПервичноеЗаявление;
	
	РезультатВыполнения = ?(РезультатВыбора.Выполнено, РезультатВыбора.Результат, "");
	
	Если РезультатВыполнения = "Восстановить" Тогда
		
		ОповещениеСледующее = Новый ОписаниеОповещения("ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВосстановления", ЭтотОбъект, ПараметрыЦикла);
		ОткрытьВосстановлениеОблачнойПодписи(ОповещениеСледующее, Неопределено, СвойствоОблачнойПодписи.НовыйЛогин, , ПервичноеЗаявление);
		
	ИначеЕсли РезультатВыполнения = "Другой" Тогда
		ОповещениеСледующее = Новый ОписаниеОповещения("ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВыбора", ЭтотОбъект, ПараметрыЦикла);
		ОткрытьНастройкиОблачнойПодписи(
					ОповещениеСледующее, 
					СвойствоОблачнойПодписи.УчетнаяЗапись, 
					СвойствоОблачнойПодписи.НовыйЛогин, 
					СвойствоОблачнойПодписи.ИдентификаторСервера, 
					Организация, 
					ПервичноеЗаявление);
		
	ИначеЕсли РезультатВыполнения = "Контакты" Тогда
		
		ОповещениеСледующее = Новый ОписаниеОповещения(
			"ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВводаКонтактов", 
			ЭтотОбъект, 
			ПараметрыЦикла);
			
		ДополнительныеНастройкиОблачнойЗаписиВЗаявлении(ОповещениеСледующее, КонтекстФормы, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВосстановления(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	
	Если ЗначениеЗаполнено(РезультатВыполнения) Тогда
		СвойствоОблачнойПодписи.УчетнаяЗапись = РезультатВыполнения;
		СвойствоОблачнойПодписи.УчетнаяЗаписьДляВосстановления = Ложь;
		СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись = Ложь;
		ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВводаКонтактов(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	
	Если РезультатВыполнения.Выполнено Тогда
		ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияПослеВыбора(РезультатВыполнения, ПараметрыЦикла) Экспорт
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	СвойствоОблачнойПодписи = КонтекстФормы.СвойствоОблачнойПодписи;
	
	Если ТипЗнч(РезультатВыполнения) = Тип("Структура") Тогда
		СвойствоОблачнойПодписи.УчетнаяЗапись = РезультатВыполнения.УчетнаяЗаписьОблачнойПодписи;
		СвойствоОблачнойПодписи.ИдентификаторСервера = РезультатВыполнения.СерверОблачнойПодписи;
		СвойствоОблачнойПодписи.СоздатьУчетнуюЗапись = НЕ ЗначениеЗаполнено(СвойствоОблачнойПодписи.УчетнаяЗапись);
		СвойствоОблачнойПодписи.НовыйЛогин = РезультатВыполнения.Логин;
		ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявленияНачало(ПараметрыЦикла);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкиОблачнойПодписиПриОтправкеЗаявлениЗавершение(ПараметрыЦикла)
	
	КонтекстФормы = ПараметрыЦикла.КонтекстФормы;
	ОповещениеОЗавершении = ПараметрыЦикла.ОповещениеОЗавершении;
	
	Если ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьУчетнуюЗаписьОблачнойПодписи(ОблачнаяПодписьУчетнаяЗапись, ВладелецЭЦПСНИЛС, ИНН) Экспорт
	
	Результат = ПроверитьУчетнуюЗаписьОблачнойПодписиНаСервере(ОблачнаяПодписьУчетнаяЗапись, ВладелецЭЦПСНИЛС, ИНН);
	
	Возврат Результат;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПроверитьУчетнуюЗаписьОблачнойПодписиНаСервере(ОблачнаяПодписьУчетнаяЗапись, ВладелецЭЦПСНИЛС, ИНН)
	
	Результат = Ложь;
	ВсеНастройки = КриптографияЭДКО.ДополнительныеНастройкиОблачнойПодписи(ОблачнаяПодписьУчетнаяЗапись);
	
	Если НЕ ВсеНастройки.Существует Тогда
		ПараметрыФункции = Новый Структура;
		ПараметрыФункции.Вставить("Сервер", ОблачнаяПодписьУчетнаяЗапись.Владелец.ВнутреннийИдентификатор);
		ПараметрыФункции.Вставить("Логин", ОблачнаяПодписьУчетнаяЗапись.Логин);
		ВнешнийМодуль = ДокументооборотСКО.ПолучитьОбработкуЭДО();
		ВсеНастройки = ВнешнийМодуль.ОбменССерверомСвойстваУчетнойЗаписиОблачнойПодписи(ПараметрыФункции);
	КонецЕсли;	
	
	Если ВсеНастройки.Существует Тогда
		Результат = ВРег(ВсеНастройки.СНИЛС) = ВРег(ВладелецЭЦПСНИЛС) И ВРег(ВсеНастройки.ИНН) = ВРег(ИНН);
	Иначе
		Результат = Истина;
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции	

&НаСервереБезКонтекста
Функция СервисПолученияСпискаСервисовОблачнойПодписи(Знач ИдентификаторФормы = Неопределено)
	
	ИдентификаторФормы = ?(ИдентификаторФормы = Неопределено, Новый УникальныйИдентификатор, ИдентификаторФормы);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Вызов API Калуги-Астрал';
															|en = 'Вызов API Калуги-Астрал'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	
	ПараметрыВызова = Новый Структура();
	ПараметрыВызова.Вставить("СпецоператорСвязи", Перечисления.СпецоператорыСвязи.КалугаАстрал);
	
	Результат = ДлительныеОперации.ВыполнитьВФоне(
					"Обработки.ДокументооборотСКонтролирующимиОрганами.ОбменССерверомСписокСерверовОблачнойПодписиФоновое", 
					ПараметрыВызова, 
					ПараметрыВыполнения);
					
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокСерверовОблачнойПодписи(РезультатВыполнения = Неопределено, ДобавлятьВсеСервера = Ложь) Экспорт
	
	Результат = Новый Массив;
	ВсеИД = Новый Массив;
	
	МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
	СервисыБазы = МодульСервисКриптографииDSS.ПолучитьВсеСерверы();
	
	МассивСерверов = Новый Массив;
	Если РезультатВыполнения = Неопределено Тогда
		ПараметрыФункции = Новый Структура;
		ПараметрыФункции.Вставить("СпецоператорСвязи", Перечисления.СпецоператорыСвязи.КалугаАстрал);
		МодульСервера = ДокументооборотСКО.ПолучитьОбработкуЭДО();
		МассивСерверов = МодульСервера.ОбменССерверомСписокСерверовОблачнойПодписи(ПараметрыФункции);
	Иначе
		Если РезультатВыполнения.Статус = "Выполнено" Тогда
			МассивСерверов = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого СтрокаМассива Из МассивСерверов Цикл
		Если ВсеИД.Найти(СтрокаМассива.ВнутреннийИдентификатор) = Неопределено Тогда
			НоваяСтрока = Новый Структура();
			НоваяСтрока.Вставить("Ссылка", Неопределено);
			НоваяСтрока.Вставить("Представление", СтрокаМассива.Наименование);
			НоваяСтрока.Вставить("ВнутреннийИдентификатор", СтрокаМассива.ВнутреннийИдентификатор);
			НоваяСтрока.Вставить("ДанныеСервиса", СтрокаМассива);
			НашлиСтроки = СервисыБазы.НайтиСтроки(Новый Структура("ВнутреннийИдентификатор", СтрокаМассива.ВнутреннийИдентификатор));
			Если НашлиСтроки.Количество() > 0 Тогда
				НоваяСтрока.Вставить("Ссылка", НашлиСтроки[0].Ссылка);
			КонецЕсли;	
			Результат.Добавить(НоваяСтрока);
			ВсеИД.Добавить(СтрокаМассива.ВнутреннийИдентификатор)
		КонецЕсли;
	КонецЦикла;
		
	Если ДобавлятьВсеСервера Тогда
		Для Каждого СтрокаМассива Из СервисыБазы Цикл
			Если ЗначениеЗаполнено(СтрокаМассива.ВнутреннийИдентификатор) 
				И ВсеИД.Найти(СтрокаМассива.ВнутреннийИдентификатор) = Неопределено Тогда
				НоваяСтрока = Новый Структура();
				НоваяСтрока.Вставить("Ссылка", СтрокаМассива.Ссылка);
				НоваяСтрока.Вставить("Представление", СтрокаМассива.Наименование);
				НоваяСтрока.Вставить("ВнутреннийИдентификатор", СтрокаМассива.ВнутреннийИдентификатор);
				НоваяСтрока.Вставить("ДанныеСервиса", Неопределено);
				Результат.Добавить(НоваяСтрока);
				ВсеИД.Добавить(СтрокаМассива.ВнутреннийИдентификатор)
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

