&НаСервереБезКонтекста
Функция СтрокаСимволовПервойПоловиныASCIIВUnicodeBase64НаСервере(СтрокаСимволовПервойПоловиныASCII)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, "windows-1251");
	Для ПозицияСимвола = 1 По СтрДлина(СтрокаСимволовПервойПоловиныASCII) Цикл
		ЗаписьТекста.Записать(Сред(СтрокаСимволовПервойПоловиныASCII, ПозицияСимвола, 1));
		ЗаписьТекста.Записать(Символ(0));
	КонецЦикла;
	ЗаписьТекста.Закрыть();
		
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Результат = Base64Строка(ДвоичныеДанныеФайла);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьПодписываемыеДанныеФСРАРНаСервере(ПодписываемыеДанныеАдрес, УникальныйИдентификаторФормы); 
	
	Значение = ПолучитьИзВременногоХранилища(ПодписываемыеДанныеАдрес);
	Результат = СтрокаСимволовПервойПоловиныASCIIВUnicodeBase64НаСервере(Значение);	
	Результат = Base64Значение(Результат);
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификаторФормы);
	
КонецФункции

&НаСервереБезКонтекста
Функция КодироватьВBase64СодержимоеНаСервере(АдресДанных, УникальныйИдентификаторФормы)
	
	ДД = ПолучитьИзВременногоХранилища(АдресДанных);
	Результат = Base64Строка(ДД);
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификаторФормы);	
	
КонецФункции

&НаСервереБезКонтекста
Функция ДеКодироватьИзBase64СодержимоеНаСервере(АдресДанных, УникальныйИдентификаторФормы)
	
	Б64 = ПолучитьИзВременногоХранилища(АдресДанных);
	ДД = Base64Значение(Б64);
	
	Возврат ПоместитьВоВременноеХранилище(ДД, УникальныйИдентификаторФормы);	
	
КонецФункции

