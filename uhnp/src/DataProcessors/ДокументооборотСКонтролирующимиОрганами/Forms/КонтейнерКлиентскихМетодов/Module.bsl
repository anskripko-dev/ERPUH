&НаКлиенте
Процедура ПоказатьВложениеТранспортногоСообщенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВложенияТранспортногоСообщения = ДополнительныеПараметры.ВложенияТранспортногоСообщения;
	НомерОбъекта = ДополнительныеПараметры.НомерОбъекта;
	Протокол = ДополнительныеПараметры.Протокол;
	ПоследнийЦиклОбмена = ДополнительныеПараметры.ПоследнийЦиклОбмена;
	СоответствиеТиповСодержимого = ДополнительныеПараметры.СоответствиеТиповСодержимого;
	ПечатьВозможнаДляЦиклаОбмена = ДополнительныеПараметры.ПечатьВозможнаДляЦиклаОбмена;
	
	ПоказатьВложениеТранспортногоСообщения(ВложенияТранспортногоСообщения, НомерОбъекта + 1, Протокол, ПоследнийЦиклОбмена, СоответствиеТиповСодержимого, ПечатьВозможнаДляЦиклаОбмена);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОрганизацияОтчетаДляОнлайнПроверки(Документ)
	
	Если ТипЗнч(Документ) = Тип("Массив") Тогда
		ОсновнойОтчет = Документ[0];
	Иначе
		ОсновнойОтчет = Документ;
	КонецЕсли;
	
	Возврат ДокументооборотСКОВызовСервера.ОрганизацияПоОбъектуОтправки(ОсновнойОтчет);
	
КонецФункции

#Область ЗагрузкаЭлектронныхПредставлений

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаНачало(Адрес, ФайлыДляИмпорта = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура();
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФайлыДляИмпорта", ФайлыДляИмпорта);
	ДополнительныеПараметры.Вставить("Адрес", 			Адрес);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучениеФайловДляИмпортаПослеПолученияКонтекста", ЭтотОбъект, ДополнительныеПараметры);
	ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаПослеПолученияКонтекста(Результат, ДополнительныеПараметры) Экспорт

	КонтекстЭДОКлиент = Результат.КонтекстЭДО;
	
	ДополнительныеПараметры.Вставить("КонтекстЭДОКлиент", КонтекстЭДОКлиент);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучениеФайловДляИмпортаПоддерживаетсяРасширениеРаботыСФайламиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ТекстСообщения = ОперацииСФайламиЭДКОКлиент.ТекстСообщенияДляНеобязательнойУстановкиРасширенияРаботыСФайлами();
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения, ТекстСообщения, Истина); 
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПодготовленныйДиалогВыбораФайла()
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = НСтр("ru = 'Выберите файл(ы) для импорта';
									|en = 'Выберите файл(ы) для импорта'");
	ДиалогВыбора.МножественныйВыбор = Истина;
	ДиалогВыбора.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбора.Фильтр = "Все файлы (*.*)|*.*";
	
	Возврат ДиалогВыбора;
	
КонецФункции

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаПоддерживаетсяРасширениеРаботыСФайламиЗавершение(ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами", ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами);
	
	ФайлыБылиВыбраны = Ложь;
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		
		Если НЕ ДополнительныеПараметры.Свойство("ФайлыДляИмпорта") 
			ИЛИ НЕ ЗначениеЗаполнено(ДополнительныеПараметры.ФайлыДляИмпорта) Тогда
			
			ДиалогВыбора = ПолучитьПодготовленныйДиалогВыбораФайла();
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПолучениеФайловДляИмпортаПослеВыбораФайлов", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДиалогВыбора.Показать(ОписаниеОповещения);
			
		Иначе
			ФайлыБылиВыбраны = Истина;
			ПолучениеФайловДляИмпортаПослеВыбораФайлов(ДополнительныеПараметры.ФайлыДляИмпорта, ДополнительныеПараметры)
		КонецЕсли;
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолучениеФайловДляИмпортаПослеПомещенияФайла", ЭтотОбъект, ДополнительныеПараметры);		
		НачатьПомещениеФайла(ОписаниеОповещения,,, Истина, ДополнительныеПараметры.Адрес);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаПослеПомещенияФайла(ФайлыБылиВыбраны, АдресДанных, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами = ДополнительныеПараметры.ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами;
	ФайлыДляИмпорта = ДополнительныеПараметры.ФайлыДляИмпорта;
	
	Если ФайлыБылиВыбраны Тогда
		
		ОсновнойФайл = Неопределено;
		
		Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
			Если Не ЗначениеЗаполнено(ФайлыДляИмпорта) Тогда
				ВыбранныеФайлы = ДополнительныеПараметры.ВыбранныеФайлы;
			Иначе
				ВыбранныеФайлы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлыДляИмпорта, Символы.ПС);
			КонецЕсли;
			Если ВыбранныеФайлы.Количество() > 0 Тогда
				ОсновнойФайл = ВыбранныеФайлы[0];
			КонецЕсли;
		Иначе
			ВыбранныеФайлы = Новый Массив;
			ВыбранныеФайлы.Добавить(ВыбранноеИмяФайла);
			ОсновнойФайл = ВыбранноеИмяФайла;
		КонецЕсли;
		
		Если ОсновнойФайл = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ВыбранныеФайлы", 	ВыбранныеФайлы);
		ДополнительныеПараметры.Вставить("ОсновнойФайл", 	ОсновнойФайл);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучениеФайловДляИмпортаПослеОпределенияСвойствОсновногоФайла", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
			ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ОсновнойФайл);
		Иначе
			СвойстваФайла = СвойстваФайла(АдресДанных, ВыбранноеИмяФайла);
			Результат = Новый Структура();
			Результат.Вставить("Выполнено", 	Истина);
			Результат.Вставить("СвойстваФайла", СвойстваФайла);
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаЗавершение(ФайлПолучен, ВходящийКонтекст) Экспорт
	
	Если ФайлПолучен Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ФайлыДляИмпорта", 									ВходящийКонтекст.ФайлыДляИмпорта);
		ДополнительныеПараметры.Вставить("ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках", 	ВходящийКонтекст.ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках);
		ДополнительныеПараметры.Вставить("ВыполнитьРазделениеФайла", 							ВходящийКонтекст.ВыполнитьРазделениеФайла);
		ДополнительныеПараметры.Вставить("ВыполнятьПроверкуКомплектаУведомлений", 				ВходящийКонтекст.ВыполнятьПроверкуКомплектаУведомлений);

		Если ВходящийКонтекст.Свойство("ВыполняемоеОповещение") Тогда
			
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ВыполняемоеОповещение, ДополнительныеПараметры);
			
		Иначе
			// Открыть форму электронного представления
			ОткрытьФорму("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.Форма.ФормаЭлемента", ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОнлайнПроверка

&НаКлиенте
Процедура ПредупредитьОбОграничениях(ЭтоОтчет, Наименование, Знач ТекстПредупреждения)
	
	// Переводим первый символ в нижний регистр
	ТекстПредупреждения = НРег(Лев(ТекстПредупреждения, 1)) + Сред(ТекстПредупреждения, 2);
	
	ТекстПредупреждения = НСтр("ru = 'Для %1 ""%2"" ';
								|en = 'Для %1 ""%2"" '") + ТекстПредупреждения;
	
	ВидОбъекта = "";
	Если ЭтоОтчет Тогда
		ВидОбъекта = НСтр("ru = 'отчета';
							|en = 'отчета'");
	Иначе
		ВидОбъекта = НСтр("ru = 'уведомления';
							|en = 'уведомления'"); 
	КонецЕсли;
	
	ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%1", ВидОбъекта);
	ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%2", Наименование);
	
	Если ДлительнаяОтправкаКлиентСервер.ЭтоФормаГрупповойОтправки() Тогда
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачномДействии(ТекстПредупреждения);
	Иначе
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыДляОнлайнПроверки(ВидКонтролирующегоОргана, ПроверяемыйОбъект)
	
	КонтролирующийОрган = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИмяПеречисления(ВидКонтролирующегоОргана);
	НеОтправляетсяВКонтролирующийОрган = Не ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбъектОтправляетсяВКонтролирующиеОрганы(ПроверяемыйОбъект);

	Возврат Новый Структура("КонтролирующийОрган, НеОтправляетсяВКонтролирующийОрган", КонтролирующийОрган, НеОтправляетсяВКонтролирующийОрган);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьВИнтернетеНачало_ПослеПроверкиЗаявления(Результат, ВходящийКонтекст) Экспорт
	
	ПроверитьВИнтернетеНачало(
		ВходящийКонтекст.ПроверяемыйОбъект, 
		ВходящийКонтекст.Представление, 
		ВходящийКонтекст.ЭтоОтчет, 
		ВходящийКонтекст.Организация, 
		ВходящийКонтекст.ВидКонтролирующегоОргана, 
		ВходящийКонтекст.АдресГотовыхДанных, 
		ВходящийКонтекст.ИмяФайлаГотовыхДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВИнтернетеНачало(
		ПроверяемыйОбъект, 
		Представление, 
		ЭтоОтчет, 
		Организация, 
		ВидКонтролирующегоОргана, 
		АдресГотовыхДанных = Неопределено, 
		ИмяФайлаГотовыхДанных = Неопределено) Экспорт
	
	// Переопределяем проверку в Интернете
	ВыполнитьСтандартнуюПроверкуВИнтернете = Истина;
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПроверитьВИнтернетеПереопределяемый(ПроверяемыйОбъект, ВыполнитьСтандартнуюПроверкуВИнтернете);
	
	// Если проверка была выполнена в переопределяемой процедуре, то стандартную проверку не выполняем
	Если ВыполнитьСтандартнуюПроверкуВИнтернете Тогда
		
		ПараметрыДляОнлайнПроверки = ПолучитьПараметрыДляОнлайнПроверки(ВидКонтролирующегоОргана, ПроверяемыйОбъект);
		
		Если ПараметрыДляОнлайнПроверки.НеОтправляетсяВКонтролирующийОрган Тогда
			
			ПредупредитьОбОграничениях(ЭтоОтчет, Представление, НСтр("ru = 'Проверка в интернете не предусмотрена';
																	|en = 'Проверка в интернете не предусмотрена'"));
			
		ИначеЕсли НЕ ЗначениеЗаполнено(УчетнаяЗаписьОрганизации(Организация)) Тогда
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПроверяемыйОбъект", 		 ПроверяемыйОбъект);
			ДополнительныеПараметры.Вставить("Представление", 			 Представление);
			ДополнительныеПараметры.Вставить("ЭтоОтчет", 				 ЭтоОтчет);
			ДополнительныеПараметры.Вставить("Организация", 			 Организация);
			ДополнительныеПараметры.Вставить("ВидКонтролирующегоОргана", ВидКонтролирующегоОргана);
			ДополнительныеПараметры.Вставить("АдресГотовыхДанных", 		 АдресГотовыхДанных);
			ДополнительныеПараметры.Вставить("ИмяФайлаГотовыхДанных", 	 ИмяФайлаГотовыхДанных);
			  
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПроверитьВИнтернетеНачало_ПослеПроверкиЗаявления", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			ДокументооборотСКОКлиент.ПроверитьСтатусПодключенияПередОтправкой(ПроверяемыйОбъект, ОписаниеОповещения);
			
		ИначеЕсли НЕ ОнлайнПроверкаДоступна(Организация, ПараметрыДляОнлайнПроверки.КонтролирующийОрган) Тогда
			ПредупредитьОбОграничениях(ЭтоОтчет, Представление, НСтр("ru = 'Проверка в интернете не предусмотрена';
																	|en = 'Проверка в интернете не предусмотрена'"));
		Иначе
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("КонтролирующийОрган",		ПараметрыДляОнлайнПроверки.КонтролирующийОрган);
			ДополнительныеПараметры.Вставить("ПроверяемыйОбъект", 		ПроверяемыйОбъект);
			ДополнительныеПараметры.Вставить("АдресГотовыхДанных", 		АдресГотовыхДанных);
			ДополнительныеПараметры.Вставить("ИмяФайлаГотовыхДанных", 	ИмяФайлаГотовыхДанных);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ПроверитьВИнтернетеЗавершение", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
			
			Если ТипЗнч(ПроверяемыйОбъект) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
				
				РегламентированнаяОтчетностьКлиент.ПередВыгрузкойРегламентированногоОтчета(ОписаниеОповещения, ПроверяемыйОбъект);
				Возврат;
				
			Иначе
				
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВИнтернетеЗавершение(Отказ, ДополнительныеПараметры) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АдресГотовыхДанных = Неопределено;
	ИмяФайлаГотовыхДанных = Неопределено;
	Если ДополнительныеПараметры.Свойство("АдресГотовыхДанных") Тогда
		АдресГотовыхДанных = ДополнительныеПараметры.АдресГотовыхДанных;
		ИмяФайлаГотовыхДанных = ДополнительныеПараметры.ИмяФайлаГотовыхДанных;
	КонецЕсли;
		
	РегламентированнаяОтчетностьКлиент.ПроверитьВИнтернетеПоСсылке(ДополнительныеПараметры.ПроверяемыйОбъект, ДополнительныеПараметры.КонтролирующийОрган, АдресГотовыхДанных, ИмяФайлаГотовыхДанных);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОнлайнПроверкаДоступна(Организация, КонтролирующийОрган)
	
	Если КонтролирующийОрган = "ФСС" Тогда
		ПараметрыПрорисовкиКнопокОтправки = ДокументооборотСФССКлиентСервер.ПараметрыПрорисовкиКнопокОтправки(Организация);
	ИначеЕсли КонтролирующийОрган = "ФСРАР" Тогда
		ПараметрыПрорисовкиКнопокОтправки = ДокументооборотСФСРАРКлиентСервер.ПараметрыПрорисовкиКнопокОтправки(Организация);
	ИначеЕсли КонтролирующийОрган = "РПН" Тогда
		ПараметрыПрорисовкиКнопокОтправки = ДокументооборотСРПНКлиентСервер.ПараметрыПрорисовкиКнопокОтправки(Организация);
	ИначеЕсли КонтролирующийОрган = "ФТС" Тогда
		ПараметрыПрорисовкиКнопокОтправки = ДокументооборотСФТСКлиентСервер.ПараметрыПрорисовкиКнопокОтправки(Организация);
	Иначе
		ПараметрыПрорисовкиКнопокОтправки = ДокументооборотСКОВызовСервера.ПараметрыПрорисовкиКнопокОтправки(Организация, КонтролирующийОрган);
	КонецЕсли;
	
	Если ПараметрыПрорисовкиКнопокОтправки.Свойство("ПроверитьВИнтернете") Тогда
		Возврат ПараметрыПрорисовкиКнопокОтправки.ПроверитьВИнтернете;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция КнопкаОбновленияВЗаявленииНаПодключениеДоступна(Ссылка) Экспорт

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.КнопкаОбновленияВЗаявленииНаПодключениеДоступна(Ссылка);
	
КонецФункции

&НаКлиенте
Функция ОбновлениеМодуляДокументооборотаНаИсправительныйДоступно(ВерсияМодуляДокументооборотаСИсправлениемОшибки, СвойстваМодуляДляТекущегоРелиза = Неопределено) Экспорт
	
	// Если не известен номер модуля с исправлением, то не понятно, на что нужно обновлять
	Если НЕ ЗначениеЗаполнено(ВерсияМодуляДокументооборотаСИсправлениемОшибки) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	КаталогФайловНаСервере = Неопределено;

	ПараметрыСервераИнтернета = ПолучитьПараметрыИнтернета();
	
	// Если в Интернете нет более свежей версии, чем сейчас в базе, то принудительно обновлять модуль не имеет смысла
	Если ПолучитьСохранитьОбновление(ПараметрыСервераИнтернета, СвойстваМодуляДляТекущегоРелиза) = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СвойстваМодуляДляТекущегоРелиза.Дата = ДатаПоСтроке(СвойстваМодуляДляТекущегоРелиза.Дата);
	
	ВерсияТекущегоМодуляВИнтернете = ЧислоИзСтроки(СвойстваМодуляДляТекущегоРелиза.Версия);
	Если ВерсияТекущегоМодуляВИнтернете = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВерсияМодуляСИсправлениемОшибки = ЧислоИзСтроки(ВерсияМодуляДокументооборотаСИсправлениемОшибки);
	Если ВерсияМодуляСИсправлениемОшибки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	// Если модуль, выложенный в интернете не содержит исправление ошибки, из-за которой возникала блокировка отправки отчета, 
	// то принудительно обновлять модуль не имеет смысла
	Если ВерсияТекущегоМодуляВИнтернете < ВерсияМодуляСИсправлениемОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Можно обновлять модуль если
	// 1. В Интернете выложен модуль более свежий чем в базе
	// 2. Этот модуль содержит исправление ошибки, из-за которой возникала блокировка отправки отчета
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ЧислоИзСтроки(Знач Текст)
	
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	
	Попытка
		Число = Число(Текст);
	Исключение
		Число = Неопределено;
	КонецПопытки;
	
	Возврат Число;

КонецФункции

&НаКлиенте
Процедура СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателя(ОповещениеОЗавершении, КонтекстОтправки)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись);
	
	Если ТипЗнч(КонтекстОтправки.СертификатПолучателя) <> Тип("Массив") Тогда
		Отпечатки = Новый Массив;
		Отпечатки.Добавить(КонтекстОтправки.СертификатПолучателя);
	Иначе
		Отпечатки = КонтекстОтправки.СертификатПолучателя;
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("Отпечатки", Отпечатки);
	Контекст.Вставить("МестоХраненияКлюча", МестоХраненияКлюча);
	
	Оповещение = Новый ОписаниеОповещения("СформироватьПакетПФР_ПослеУстановкиСертификатаЕЦП", ЭтотОбъект, Контекст);
	Если КонтекстОтправки.ЭтоЕЦП И КонтекстОтправки.СертификатШифрованияЕЦП <> Неопределено Тогда
		УстанавливаемыеСертификаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КонтекстОтправки.СертификатШифрованияЕЦП);
		УстановитьСертификаты(
			Оповещение,
			УстанавливаемыеСертификаты,
			МестоХраненияКлюча);
		
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(Выполнено, НайденныеСертификаты, НенайденныеСертификаты, СсылкаПолучатель)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Выполнено, НайденныеСертификаты, НенайденныеСертификаты, СсылкаПолучатель);
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	НайденныеСертификаты   = ?(Результат.Свойство("Сертификаты"), Результат.Сертификаты, Неопределено);
	НенайденныеСертификаты = ?(Результат.Свойство("НенайденныеСертификаты"), Результат.НенайденныеСертификаты, Неопределено);
	СсылкаПолучатель       = ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель;
	
	Если Не СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(Результат.Выполнено, НайденныеСертификаты, НенайденныеСертификаты, СсылкаПолучатель) Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить("ОбъектСертификатПолучателя", НайденныеСертификаты);
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПакетПФР_ПодготовитьСертификатыДляПоиска(Знач УчетнаяЗапись, Знач Сертификат, Знач СертификатОтветственногоЗаШифрование)

 	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
 	Возврат КонтекстЭДОСервер.СформироватьПакетПФР_ПодготовитьСертификатыДляПоиска(
 		УчетнаяЗапись,
 		Сертификат,
 		СертификатОтветственногоЗаШифрование);

КонецФункции

&НаКлиенте
Процедура СформироватьПакетПФР_ПроверкиСертификатов(ОповещениеОЗавершении, КонтекстОтправки)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если КонтекстОтправки.Свойство("ОбъектСертификатОтветственногоЗаШифрование") Тогда // возможна ситуация, когда сертификаты уже получены и проверены
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Истина);
		Возврат;
	КонецЕсли;
	
	СертификатыДляПоиска = СформироватьПакетПФР_ПодготовитьСертификатыДляПоиска(
		КонтекстОтправки.УчетнаяЗапись,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если СертификатыДляПоиска = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
			
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("ВыполнятьПроверку", Истина);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатов", ЭтотОбъект, Контекст);
		
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	ОбъектыСертификатов = СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		Результат.Сертификаты,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
		
	Если ОбъектыСертификатов = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
		
	///////////////////////////////////////////////////////////////////////////////
	КонтекстОтправки = ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки;
	Для каждого ОбъектСертификат Из ОбъектыСертификатов Цикл
		КонтекстОтправки.Вставить(ОбъектСертификат.Ключ, ОбъектСертификат.Значение);
	КонецЦикла;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(Знач Сертификаты, Знач СертификатРуководителя, Знач СертификатОтветственногоЗаШифрование)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.СформироватьПакетПФР_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		Сертификаты, СертификатРуководителя, СертификатОтветственногоЗаШифрование);

КонецФункции

&НаКлиенте
Процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(ОповещениеОЗавершении, КонтекстОтправки)

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКоманды(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись, КонтекстОтправки);
	
	СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательно(ОповещениеОЗавершении, КонтекстОтправки, КонтекстОтправки.ОтложенныеКоманды, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательно(ОповещениеОЗавершении, КонтекстОтправки, ОтложенныеКоманды, ТекущаяКоманда)

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКомандыПоследовательно(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	Если ТекущаяКоманда < ОтложенныеКоманды.Количество() Тогда
		Контекст = Новый Структура;
		Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		Контекст.Вставить("ОтложенныеКоманды", ОтложенныеКоманды);
		Контекст.Вставить("ТекущаяКоманда", ТекущаяКоманда);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательноПослеВыполненияКоманды", ЭтотОбъект, Контекст);
		Если ОтложенныеКоманды[ТекущаяКоманда].Представление = "Зашифровать" Тогда
			ПараметрыОперации = Неопределено;
			Если КонтекстОтправки.Свойство("АлгоритмШифрования") И ЗначениеЗаполнено(КонтекстОтправки.АлгоритмШифрования) Тогда
				ПараметрыОперации = Новый Структура;
				ПараметрыОперации.Вставить("АлгоритмШифрования", КонтекстОтправки.АлгоритмШифрования);
				ПараметрыОперации.Вставить("АлгоритмШифрованияОбязателен",
					КонтекстОтправки.Свойство("АлгоритмШифрованияОбязателен") И КонтекстОтправки.АлгоритмШифрованияОбязателен);
				ПараметрыОперации.Вставить("СобиратьСведенияОШифровании",
					КонтекстОтправки.Свойство("СобиратьСведенияОШифровании") И КонтекстОтправки.СобиратьСведенияОШифровании);
			КонецЕсли;
			
			ОбъектСертификат = КонтекстОтправки.ОбъектСертификатПолучателя;
			
			Если КонтекстОтправки.Свойство("ОбъектСертификатСервераДокументооборота")
				И ЗначениеЗаполнено(КонтекстОтправки.ОбъектСертификатСервераДокументооборота)
				И КонтекстОтправки.Свойство("СвойстваОтложенныхКоманд") Тогда
				
				ИдентификаторОтложеннойКоманды = ОтложенныеКоманды[ТекущаяКоманда].ПолучитьИдентификатор();
				СвойстваОтложеннойКоманды = КонтекстОтправки.СвойстваОтложенныхКоманд[ИдентификаторОтложеннойКоманды];
				Если СвойстваОтложеннойКоманды <> Неопределено И СвойстваОтложеннойКоманды.ДляСервераДокументооборота Тогда
					СформироватьПакет_ЗашифроватьНаСертификатахПолучателей(
						Оповещение,
						КонтекстОтправки.ОбъектСертификатПолучателя,
						КонтекстОтправки.ОбъектСертификатСервераДокументооборота,
						ОтложенныеКоманды,
						ТекущаяКоманда,
						МестоХраненияКлюча,
						ПараметрыОперации);
					Возврат;
					
				ИначеЕсли СвойстваОтложеннойКоманды <> Неопределено И ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
					СвойстваОтложеннойКоманды, "ТолькоДляСервераДокументооборота", Истина) Тогда
					
					ОбъектСертификат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
						КонтекстОтправки.ОбъектСертификатСервераДокументооборота);
				КонецЕсли;
			КонецЕсли;
			
			КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
				Оповещение,
				ОтложенныеКоманды[ТекущаяКоманда].Значение,
				ОбъектСертификат,,,,
				МестоХраненияКлюча,,
				ПараметрыОперации);
			
		ИначеЕсли ОтложенныеКоманды[ТекущаяКоманда].Представление = "ПодписатьФайлОписанияПакета" Тогда
			Если КонтекстОтправки.Свойство("ФорматДокументооборота") И КонтекстОтправки.ФорматДокументооборота =
				ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
				
				НастройкиПодписи = Новый Структура;
				НастройкиПодписи.Вставить("ДополнитьПространстваИменУзлаПодписи", 	Истина);
				НастройкиПодписи.Вставить("ПодстрокаУзлаДляИнформацииОПодписи", 	"ЭДСФР");
				НастройкиПодписи.Вставить("ИмяСобытияДляИнформацииОПодписи", 		"ЕЦП добавлять SignInfo");
				
				Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
					ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи("ЗаявлениеВПФР", КонтекстОтправки.УчетнаяЗапись); 
					ПодготовитьОблачнуюПодпись("Сведения ПФР", "xml", ТребуетПодтверждениеОперации, НастройкиПодписи);
				КонецЕсли;
				
				ПодписатьФайлXMLDSig(
					КонтекстОтправки.ОбъектСертификатРуководителя,
					ОтложенныеКоманды[ТекущаяКоманда].Значение,
					Оповещение,,,
					НастройкиПодписи);
				
			Иначе
				ДанныеДляПодписи = ОтложенныеКоманды[ТекущаяКоманда].Значение;
				ПараметрыОперации = Неопределено;
				Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
					ТребуетПодтверждениеОперации = СвойствоСтруктуры(КонтекстОтправки, "ТребуетПодтверждениеОперации", Неопределено);
					ТребуетПодтверждениеОперации = РежимПодтвержденияОблачнойПодписи(КонтекстОтправки.ТипСообщения, КонтекстОтправки.УчетнаяЗапись, КонтекстОтправки, ТребуетПодтверждениеОперации);
					Если ЭтоАдресВременногоХранилища(ДанныеДляПодписи) Тогда
						ПараметрыОперации = ПодготовитьОблачнуюПодпись(Неопределено, , ТребуетПодтверждениеОперации);
					ИначеЕсли ТипЗнч(ДанныеДляПодписи) = Тип("Строка") Тогда
						ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеДляПодписи);
						ПараметрыОперации = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
					Иначе
						ПараметрыОперации = ПодготовитьОблачнуюПодпись(Неопределено, , ТребуетПодтверждениеОперации);
					КонецЕсли;
					ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, КонтекстОтправки.ОбъектСертификатРуководителя);
				КонецЕсли;
				
				КриптографияЭДКОКлиент.ПодписатьPKCS7(
					Оповещение, КонтекстОтправки.ОбъектСертификатРуководителя, ДанныеДляПодписи, Ложь,
					ПоместитьВоВременноеХранилище(Неопределено, КонтекстОтправки.УникальныйИдентификатор), , , , ПараметрыОперации);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ВыполнитьОбработкуОповещения(
			ОповещениеОЗавершении, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакет_ЗашифроватьНаСертификатахПолучателей(
		ОповещениеОЗавершении,
		ОбъектСертификатПолучателя,
		ОбъектСертификатСервераДокументооборота,
		ОтложенныеКоманды,
		ТекущаяКоманда,
		МодельРаботыСКлючами = Неопределено,
		ПараметрыОперации = Неопределено)
	
	АдресКопии = СкопироватьВоВременномХранилище(ОтложенныеКоманды[ТекущаяКоманда].Значение, Новый УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", 					ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("ОбъектСертификатСервераДокументооборота", ОбъектСертификатСервераДокументооборота);
	ДополнительныеПараметры.Вставить("ОтложенныеКоманды", 						ОтложенныеКоманды);
	ДополнительныеПараметры.Вставить("ТекущаяКоманда", 							ТекущаяКоманда);
	ДополнительныеПараметры.Вставить("АдресКопии", 								АдресКопии);
	ДополнительныеПараметры.Вставить("МодельРаботыСКлючами", 					МодельРаботыСКлючами);
	ДополнительныеПараметры.Вставить("ПараметрыОперации", 						ПараметрыОперации);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакет_ЗашифроватьНаСертификатахПолучателейПослеЗашифрования", ЭтотОбъект, ДополнительныеПараметры);
	
	КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
		Оповещение,
		ОтложенныеКоманды[ТекущаяКоманда].Значение,
		ОбъектСертификатПолучателя,,,,
		МодельРаботыСКлючами,,
		ДополнительныеПараметры.ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакет_ЗашифроватьНаСертификатахПолучателейПослеЗашифрования(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении 					= ДополнительныеПараметры.ОповещениеОЗавершении;
	ОбъектСертификатСервераДокументооборота = ДополнительныеПараметры.ОбъектСертификатСервераДокументооборота;
	АдресКопии 								= ДополнительныеПараметры.АдресКопии;
	МодельРаботыСКлючами					= ДополнительныеПараметры.МодельРаботыСКлючами;
	
	Если Результат.Выполнено Тогда
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакет_ЗашифроватьНаСертификатахПолучателейПослеЗашифрованияКопии", ЭтотОбъект, ДополнительныеПараметры);
		
		МассивОбъектовСертификатСервераДокументооборота = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
			ОбъектСертификатСервераДокументооборота);
		КриптографияЭДКОКлиент.ЗашифроватьPKCS7(
			Оповещение,
			АдресКопии,
			МассивОбъектовСертификатСервераДокументооборота,,,,
			МодельРаботыСКлючами,,
			ДополнительныеПараметры.ПараметрыОперации);
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ОписаниеОшибки", Ложь, Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакет_ЗашифроватьНаСертификатахПолучателейПослеЗашифрованияКопии(Результат, ДополнительныеПараметры) Экспорт
	
	ОповещениеОЗавершении 	= ДополнительныеПараметры.ОповещениеОЗавершении;
	ОтложенныеКоманды 		= ДополнительныеПараметры.ОтложенныеКоманды;
	ТекущаяКоманда 			= ДополнительныеПараметры.ТекущаяКоманда;
	АдресКопии 				= ДополнительныеПараметры.АдресКопии;
	
	Если Результат.Выполнено Тогда
		СкопироватьВоВременномХранилище(
			ОтложенныеКоманды[ТекущаяКоманда].Значение,
			ОтложенныеКоманды[ТекущаяКоманда].Значение,
			"FD2WshXWT3yZW18vlRZXnA==",
			АдресКопии);
		
		РезультатВыполнения = Новый Структура("Выполнено, ЗашифрованныйФайл", Истина, ОтложенныеКоманды[ТекущаяКоманда].Значение);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатВыполнения);
		
	Иначе
		РезультатВыполнения = Новый Структура("Выполнено, ОписаниеОшибки", Ложь, Результат.ОписаниеОшибки);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СкопироватьВоВременномХранилище(
		АдресДанных,
		АдресРезультата = Неопределено,
		Разделитель64 = Неопределено,
		АдресДобавляемыхДанных = Неопределено)
	
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если НЕ ЗначениеЗаполнено(АдресДобавляемыхДанных) Тогда
		Возврат ПоместитьВоВременноеХранилище(Данные, АдресРезультата);
	КонецЕсли;
	
	МассивИменФайлов = Новый Массив;
	
	ФайлДанных = ПолучитьИмяВременногоФайла();
	Данные.Записать(ФайлДанных);
	МассивИменФайлов.Добавить(ФайлДанных);
	
	Если ЗначениеЗаполнено(Разделитель64) Тогда
		ФайлРазделителя = ПолучитьИмяВременногоФайла();
		ДанныеРазделителя = Base64Значение(Разделитель64);
		ДанныеРазделителя.Записать(ФайлРазделителя);
		МассивИменФайлов.Добавить(ФайлРазделителя);
	КонецЕсли;
	
	ФайлДобавляемыхДанных = ПолучитьИмяВременногоФайла();
	ДобавляемыеДанные = ПолучитьИзВременногоХранилища(АдресДобавляемыхДанных);
	ДобавляемыеДанные.Записать(ФайлДобавляемыхДанных);
	МассивИменФайлов.Добавить(ФайлДобавляемыхДанных);
	
	УдалитьИзВременногоХранилища(АдресДобавляемыхДанных);
	
	ФайлРезультата = ПолучитьИмяВременногоФайла();
	ОбъединитьФайлы(МассивИменФайлов, ФайлРезультата);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДанных);
	Если ЗначениеЗаполнено(Разделитель64) Тогда
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРазделителя);
	КонецЕсли;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДобавляемыхДанных);
	
	ДанныеРезультата = Новый ДвоичныеДанные(ФайлРезультата);
	Результат = ПоместитьВоВременноеХранилище(ДанныеРезультата, АдресРезультата);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультата);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательноПослеВыполненияКоманды(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	Если ВходящийКонтекст.ОтложенныеКоманды[ВходящийКонтекст.ТекущаяКоманда].Представление = "ПодписатьФайлОписанияПакета"
		И КонтекстОтправки.Свойство("ФорматДокументооборота") И КонтекстОтправки.ФорматДокументооборота =
		ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
		
		Результат = Новый Структура("Выполнено, ФайлПодписи, ОписаниеОшибки", Результат <> Неопределено, Результат,
			?(Результат = Неопределено, НСтр("ru = 'Не удалось подписать в формате XMLDSig';
											|en = 'Не удалось подписать в формате XMLDSig'"), ""));
	КонецЕсли;
	
	Если Результат.Выполнено Тогда
		Если ВходящийКонтекст.ОтложенныеКоманды[ВходящийКонтекст.ТекущаяКоманда].Представление = "ПодписатьФайлОписанияПакета" Тогда	
			ВходящийКонтекст.КонтекстОтправки.Вставить("ФайлПодписиПодФайломОписанияПакета", Результат.ФайлПодписи);
		КонецЕсли;
		СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательно(
			ВходящийКонтекст.ОповещениеОЗавершении, ВходящийКонтекст.КонтекстОтправки, ВходящийКонтекст.ОтложенныеКоманды, ВходящийКонтекст.ТекущаяКоманда + 1);
	Иначе
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

#Область СформироватьПакетПФР

&НаКлиенте
Процедура СформироватьПакетПФР(ОповещениеОЗавершении, ТранспортноеСообщение, Оповещать = Ложь, ПараметрыОперации = Неопределено) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	 
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Оповещать);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;	
	
	// общие проверки
	Если НЕ СформироватьПакетПФР_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда // сервер
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ОповещениеОЗавершении.ДополнительныеПараметры) = Тип("Структура")
		И ОповещениеОЗавершении.ДополнительныеПараметры.Свойство("КонтекстОтправки")
		И ТипЗнч(ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки) = Тип("Структура") Тогда
		ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить("ЭтоЕЦП", КонтекстОтправки.ЭтоЕЦП);
	КонецЕсли;
	
	// получение и проверки сертификатов
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФРПослеПроверкиИПолученияСертификатовПолучателя", ЭтотОбъект, Контекст);
		
	СформироватьПакетПФР_ПолучитьИПроверитьСертификатыПолучателя(Оповещение, КонтекстОтправки); // клиент
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФРПослеПроверкиИПолученияСертификатовПолучателя(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Результат Тогда
		// проверки на клиенте (сертификаты)
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетПФРПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
			
		СформироватьПакетПФР_ПроверкиСертификатов(Оповещение, КонтекстОтправки);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФРПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт	

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
			
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	// формируем файл описания сведений, если это первичное сообщение с отчетностью
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР")
		ИЛИ КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР") Тогда
		
		Если НЕ СформироватьОписаниеСведенийДляСообщения(КонтекстОтправки) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Формирование пакета прервано.';
									|en = 'Формирование пакета прервано.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СообщениеОбОшибке);
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоМакетПД = ЭтоМакетПД(КонтекстОтправки.ЦиклОбмена);
	ЭтоЗаявление = ЭтоЗаявлениеОНазначенииПенсии(КонтекстОтправки.ЦиклОбмена);
	Если ЭтоМакетПД ИЛИ ЭтоЗаявление Тогда
		
		Настройки = ПолучитьПараметрыОтправкиМакетовПенсионныхДелИЗаявления(КонтекстОтправки.ЦиклОбмена);
		
		Если Настройки = Неопределено Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		КонтекстОтправки.Вставить("Настройки", Настройки);
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
	Контекст.Вставить("ПервыйВызов", Истина);
	Контекст.Вставить("СформироватьПакетМакетаПДИЗаявление", ЭтоМакетПД ИЛИ ЭтоЗаявление);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФРПослеПодписания", ЭтотОбъект, Контекст);
	СформироватьПакетПФР_Подписание(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФРПослеПодписания(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
		
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
			
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура("ТребуетПодтверждениОперации", Ложь);
	КонецЕсли;
			
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР")
		И ВходящийКонтекст.ПервыйВызов Тогда
		
		Если ВходящийКонтекст.СформироватьПакетМакетаПДИЗаявление Тогда
			Если КонтекстОтправки.Настройки.Вложение.ТребуетсяАрхивирование 
				И НЕ СформироватьПакетМакетаПенсионногоДелаИЗаявления(КонтекстОтправки) Тогда
				ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			КонецЕсли;
			
			ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
			ВходящийКонтекст.Вставить("ПервыйВызов", ВходящийКонтекст.ПервыйВызов);
			ВходящийКонтекст.Вставить("СформироватьПакетМакетаПДИЗаявление", Ложь);
			
			Оповещение = Новый ОписаниеОповещения(
				"СформироватьПакетПФРПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
			СформироватьПакетПФР_Подписание(Оповещение, ВходящийКонтекст.КонтекстОтправки, ПараметрыОперации);
			Возврат;
		КонецЕсли;
		
		// формируем файл описания письма, если его нет
		Если НЕ СформироватьОписаниеПисьмаДляСообщения(КонтекстОтправки) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		ВходящийКонтекст.Вставить("ПервыйВызов", Ложь);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьТранспортнуюИнформациюДляСообщенияПослеВыполнения", ЭтотОбъект, ВходящийКонтекст);
		// формируем файл с транспортной информацией, если его нет
		СформироватьТранспортнуюИнформациюДляСообщения(Оповещение, КонтекстОтправки);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР")
		И ВходящийКонтекст.ПервыйВызов Тогда
		// формируем подтверждение получения
		Если НЕ СформироватьПодтверждениеПолученияДляСообщения(КонтекстОтправки) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		ВходящийКонтекст.Вставить("ПервыйВызов", Ложь);
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетПФРПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
		СформироватьПакетПФР_Подписание(Оповещение, ВходящийКонтекст.КонтекстОтправки, ПараметрыОперации);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ОтветНаЗапросКвитанцияПФР")
		И ВходящийКонтекст.ПервыйВызов Тогда
		// формируем подтверждение получения
		Если НЕ СформироватьПодтверждениеПолученияЗапросаПФРДляСообщения(КонтекстОтправки.ТранспортноеСообщение) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		ВходящийКонтекст.Вставить("ПервыйВызов", Ложь);
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетПФРПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
		СформироватьПакетПФР_Подписание(Оповещение, ВходящийКонтекст.КонтекстОтправки, ПараметрыОперации);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"СформироватьПакетПФРПослеВыгрузкиСертификата", 
		ЭтотОбъект, 
		ВходящийКонтекст);
		
	СертификатШифрования = КонтекстОтправки.ОбъектСертификатРуководителя;
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатШифрования);
	
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(ОписаниеОповещения, СертификатШифрования, Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФРПослеВыгрузкиСертификата(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	ИндексСертификатаПолучателя = ?(КонтекстОтправки.Свойство("ИндексСертификатаПолучателя"),
		КонтекстОтправки.ИндексСертификатаПолучателя, -1) + 1;
	ДвДанныеСертификатаПолучателя = ?(КонтекстОтправки.Свойство("ДвДанныеСертификатаПолучателя"),
		КонтекстОтправки.ДвДанныеСертификатаПолучателя, Новый Массив);
	
	ДвДанныеСертификата = Неопределено;
	Если Результат.Выполнено Тогда
		ДвДанныеСертификата = Base64Значение(Результат.СтрокаBase64);
		
		Если ИндексСертификатаПолучателя = 0 Тогда
			КонтекстОтправки.Вставить("ДвДанныеСертификатаРуководителя", ДвДанныеСертификата);
			ДвДанныеСертификатаПолучателя.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Если ИндексСертификатаПолучателя <> 0 Тогда
		ДвДанныеСертификатаПолучателя.Добавить(ДвДанныеСертификата);
	КонецЕсли;
	
	Если КонтекстОтправки.Свойство("ФорматДокументооборота")
		И КонтекстОтправки.ФорматДокументооборота = ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК")
		И ИндексСертификатаПолучателя < КонтекстОтправки.ОбъектСертификатПолучателя.Количество() Тогда
		
		КонтекстОтправки.Вставить("ИндексСертификатаПолучателя", 	ИндексСертификатаПолучателя);
		КонтекстОтправки.Вставить("ДвДанныеСертификатаПолучателя", 	ДвДанныеСертификатаПолучателя);
		
		СертификатШифрования = КонтекстОтправки.ОбъектСертификатПолучателя[ИндексСертификатаПолучателя];
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, СертификатШифрования);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"СформироватьПакетПФРПослеВыгрузкиСертификата",
			ЭтотОбъект,
			ВходящийКонтекст);
		
		КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(
			ОписаниеОповещения, СертификатШифрования, Ложь);
		Возврат;
		
	ИначеЕсли ИндексСертификатаПолучателя > 0 Тогда
		КонтекстОтправки.Удалить("ИндексСертификатаПолучателя");
	КонецЕсли;
	
	// формируем дерево описания документов пакета (сервер)
	Если НЕ СформироватьПакетПФР_СформироватьОписаниеДокументовПакета(КонтекстОтправки) Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	РежимПодтвержденияОблачнойПодписи("СформироватьПакетПФР", КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки);

	// отрабатываем отложенные команды на клиенте (шифрование)
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФРПослеВыполненияОтложенныхКомандНаКлиенте", ЭтотОбъект, ВходящийКонтекст);
	СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(Оповещение, КонтекстОтправки);
		
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ЗарегистрироватьСертификатВСистемеНачало(ОбработкаОповещения, МестоХраненияКлюча, ФайлСертификата, 
		Хранилище, ОтпечатокСертификата = Неопределено) Экспорт
		
	ДополнительныеПараметры = Новый Структура("ВыполняемоеОповещение", ОбработкаОповещения);
	
	Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		РезультатРегистрации = ЗарегистрироватьСертификатВСистемеНаСервере(ФайлСертификата, Хранилище, ОтпечатокСертификата);
		Результат = Новый Структура("Выполнено, Отпечаток", РезультатРегистрации, ОтпечатокСертификата);
		ВыполнитьОбработкуОповещения(ОбработкаОповещения, Результат);
		
	ИначеЕсли ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		Если ЭтоАдресВременногоХранилища(ФайлСертификата) 
			ИЛИ ТипЗнч(ФайлСертификата) = Тип("ДвоичныеДанные") Тогда
			ДанныеСертификата = ФайлСертификата;
		Иначе
			ДанныеСертификата = СтрЗаменить(ФайлСертификата, "-----BEGIN CERTIFICATE-----" + Символы.ПС, "");
			ДанныеСертификата = СтрЗаменить(ДанныеСертификата, "-----END CERTIFICATE-----" + Символы.ПС, "");
			ДанныеСертификата = Base64Значение(ДанныеСертификата);
		КонецЕсли;	
		РезультатРегистрации = ЗарегистрироватьСертификатВХранилищеПолучателей(ДанныеСертификата, Хранилище, ОтпечатокСертификата);
		Результат = Новый Структура("Выполнено, Отпечаток", РезультатРегистрации, ОтпечатокСертификата);
		ВыполнитьОбработкуОповещения(ОбработкаОповещения, Результат);
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗарегистрироватьСертификатВСистемеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		КриптографияЭДКОКлиент.ИмпортироватьСертификат(ОписаниеОповещения, ФайлСертификата, Хранилище);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатВСистемеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		РезультатРегистрации = Новый Структура("Выполнено, Отпечаток", Истина, Результат.СвойстваСертификата.Отпечаток);
	Иначе
		РезультатРегистрации = Новый Структура("Выполнено, Отпечаток", Ложь, Неопределено);
	КонецЕсли;
	
	ВыполняемоеОповещение = ДополнительныеПараметры.ВыполняемоеОповещение;
	ВыполнитьОбработкуОповещения(ВыполняемоеОповещение, РезультатРегистрации);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибкеОтправкиЗаявления(
	СостояниеОтправкиСообщения, 
	ПовторятьСоединение,
	ТекстОшибки,
	ДополнительныеПараметры)
	
	Если НЕ ПустаяСтрока(СостояниеОтправкиСообщения) И ПовторятьСоединение Тогда
		
		Результат = Новый Структура("ТекстОшибки", ТекстОшибки);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
			
	ИначеЕсли НЕ ПустаяСтрока(СостояниеОтправкиСообщения) Тогда
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
			СостояниеОтправкиСообщения, 
			ДополнительныеПараметры.ВызовИзМастераПодключенияК1СОтчетности, 
			ТекстОшибки);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеЗаявленияПослеОтправки(ДополнительныеПараметры)
	
	ДокументЗаявление 	= ДополнительныеПараметры.ДокументЗаявление;
	Статус 				= ДополнительныеПараметры.Статус;
	ДатаОтправки 		= ДополнительныеПараметры.ДатаОтправки;
	СтатусКомментарий 	= ДополнительныеПараметры.СтатусКомментарий;
	
	ПутьКонтейнерЗакрытогоКлюча = ДополнительныеПараметры.ПутьКонтейнерЗакрытогоКлюча;
	
	Если ПутьКонтейнерЗакрытогоКлюча <> ДокументЗаявление.ПутьКонтейнерЗакрытогоКлюча
		ИЛИ	Статус <> ДокументЗаявление.Статус
		ИЛИ СтатусКомментарий <> ДокументЗаявление.СтатусКомментарий Тогда
		
		ДокументЗаявление.ПутьКонтейнерЗакрытогоКлюча 	= ПутьКонтейнерЗакрытогоКлюча;
		ДокументЗаявление.Статус 					  	= Статус;
		ДокументЗаявление.ДатаОтправкиЗаявления 	  	= ДатаОтправки;
		ДокументЗаявление.СтатусКомментарий 		  	= СтатусКомментарий;
		
		Если ДополнительныеПараметры.Свойство("АдресТекстаОтправленногоЗаявления")
			И ЭтоАдресВременногоХранилища(ДополнительныеПараметры.АдресТекстаОтправленногоЗаявления) Тогда
			АдресЗаявления = ДополнительныеПараметры.АдресТекстаОтправленногоЗаявления;
		Иначе
			АдресЗаявления = Неопределено;
		КонецЕсли;
		
		РеквизитыДокументаДляЗаписи = Новый Структура;
		РеквизитыДокументаДляЗаписи.Вставить("ПутьКонтейнерЗакрытогоКлюча", ПутьКонтейнерЗакрытогоКлюча);
		РеквизитыДокументаДляЗаписи.Вставить("Статус",						Статус);
		РеквизитыДокументаДляЗаписи.Вставить("ДатаОтправкиЗаявления",		ДатаОтправки);
		РеквизитыДокументаДляЗаписи.Вставить("СтатусКомментарий", 			СтатусКомментарий);
		РеквизитыДокументаДляЗаписи.Вставить("АдресЗаявления", 				АдресЗаявления);
		
		ОбработкаЗаявленийАбонентаВызовСервера.ОбновитьРеквизитыЗаявления(ДокументЗаявление.Ссылка, РеквизитыДокументаДляЗаписи);
	
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеПроверкиРегистрацииСертификата(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ХранилищеСертификата = "AddressBook";
		ОтпечатокСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ДополнительныеПараметры.ДокументЗаявление.СпецоператорСвязи, "СертификатБезопасности_Отпечаток");
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
		
		Если НЕ Результат.СертификатНайден Тогда
			
			ТекстСертификата = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ДополнительныеПараметры.ДокументЗаявление.СпецоператорСвязи, "СертификатБезопасности");
			
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
				ХранилищеСертификата 	= "AddressBook";
				ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеРегистрацииСертификата", ЭтотОбъект, ДополнительныеПараметры);
				ЗарегистрироватьСертификатВСистемеНачало(ОписаниеОповещения, МестоХраненияКлюча, ТекстСертификата, ХранилищеСертификата, ОтпечатокСертификата);
			Иначе
				ОписаниеОповещения 		= Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеСохраненияСертификатаВФайл", ЭтотОбъект, ДополнительныеПараметры);
				ПутьКФайлуСертификата 	= ДополнительныеПараметры.ВременныйКаталог + ОтпечатокСертификата + ".cer";
				ОперацииСФайламиЭДКОКлиент.ТекстВФайл(ОписаниеОповещения, ТекстСертификата, ПутьКФайлуСертификата);
			КонецЕсли;
		Иначе
			ОписаниеОповещения 		= Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеРегистрацииСертификата", ЭтотОбъект, ДополнительныеПараметры);
			РезультатРегистрации 	= Новый Структура("Выполнено, Отпечаток", Истина, Результат.СвойстваСертификата.Отпечаток);
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, РезультатРегистрации);
		КонецЕсли;
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьИОтправитьФайлыЗаявления", ЭтотОбъект, ДополнительныеПараметры);
		Результат = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеСохраненияСертификатаВФайл(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		// Если сертификат оператора электронного документооборота не зарегистрирован, то регистрируем его
		ХранилищеСертификата 	= "AddressBook";
		ОтпечатокСертификата 	= ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(ДополнительныеПараметры.ДокументЗаявление.СпецоператорСвязи, "СертификатБезопасности_Отпечаток");
		ПутьКФайлуСертификата 	= ДополнительныеПараметры.ВременныйКаталог + ОтпечатокСертификата + ".cer";
		МестоХраненияКлюча		= КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеРегистрацииСертификата", ЭтотОбъект, ДополнительныеПараметры);
		ЗарегистрироватьСертификатВСистемеНачало(ОписаниеОповещения, МестоХраненияКлюча, ПутьКФайлуСертификата, ХранилищеСертификата, ОтпечатокСертификата);
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьИОтправитьФайлыЗаявления", ЭтотОбъект, ДополнительныеПараметры);
		Результат = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявлениеЗашифроватьПослеРегистрацииСертификата(Результат, ДополнительныеПараметры) Экспорт
	// Действия после регистрации сертификата оператора связи
	Если Результат.Выполнено Тогда
		
		ХранилищеСертификата 	= "AddressBook";
		ДокументЗаявление 		= ДополнительныеПараметры.ДокументЗаявление;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаявлениеЗашифроватьПослеПолученияСвойствСертификатаОператораСвязи", ЭтотОбъект, ДополнительныеПараметры);
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ДополнительныеПараметры);
		Если НЕ ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			
			// В модели сервиса получаем сертификат синхронно
			Если ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
				РезультатаПолученияСертификата = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(Результат.Отпечаток, ХранилищеСертификата);
			Иначе
				РезультатаПолученияСертификата = ПолучитьСвойстваОблачногоСертификата(Результат.Отпечаток, ХранилищеСертификата);
			КонецЕсли;
			ПараметрыПродолженияРаботы = Новый Структура;
			Если РезультатаПолученияСертификата = Неопределено Тогда
				ПараметрыПродолженияРаботы.Вставить("Выполнено", Ложь);
			Иначе
				ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, РезультатаПолученияСертификата);
				ПараметрыПродолженияРаботы.Вставить("Выполнено", Истина);
				ПараметрыПродолженияРаботы.Вставить("СертификатНайден", Истина);
				ПараметрыПродолженияРаботы.Вставить("СвойстваСертификата", РезультатаПолученияСертификата);
			КонецЕсли;
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ПараметрыПродолженияРаботы);
			
		Иначе
			КриптографияЭДКОКлиент.НайтиСертификатПоОтпечатку(ОписаниеОповещения, Результат.Отпечаток, ХранилищеСертификата);
		КонецЕсли;

	Иначе
		Результат = Новый Структура("Выполнено", Ложь);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ВыполняемоеОповещение, Результат);
	КонецЕсли;
	
КонецПроцедуры


#Область СформироватьПакетСОС

&НаКлиенте
Процедура СформироватьПакетСОС(ОповещениеОЗавершении, ТранспортноеСообщение, Оповещать = Ложь, ПараметрыОперации = Неопределено) Экспорт
	
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Оповещать);
	
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;	
	
	// общие проверки
	Если НЕ СформироватьПакетФНС_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда // сервер
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// получение и проверки сертификатов
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетСОСПослеПроверкиИПолученияСертификатовПолучателя", ЭтотОбъект, Контекст);
		
	СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателя(Оповещение, КонтекстОтправки); // клиент
	
КонецПроцедуры 

&НаКлиенте
Процедура СформироватьПакетСОСПослеПроверкиИПолученияСертификатовПолучателя(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Результат Тогда
		Если НЕ СформироватьПакетФНС_ПроверкиНаСервере(КонтекстОтправки) Тогда // универсальная
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		// формируем дерево описания документов пакета (сервер)
		Если НЕ СформироватьПакетФНС_СформироватьДеревоОписанияДокументовПакета(КонтекстОтправки) Тогда // универсальная
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;

		РежимПодтвержденияОблачнойПодписи("ПакетСОС", КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки);
	
		// отрабатываем отложенные команды на клиенте (шифрование)
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетСОСПослеВыполненияОтложенныхКомандНаКлиенте", ЭтотОбъект, ВходящийКонтекст);
		СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(Оповещение, КонтекстОтправки);

	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетСОСПослеВыполненияОтложенныхКомандНаКлиенте(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);	
		Возврат;
	КонецЕсли;
	
	// формируем файл описания пакета, создаем архив и помещаем в ИБ
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетСОС_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.Оповещать Тогда
		Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
														КонтекстОтправки.ТранспортноеСообщение,
														КонтекстОтправки.ЦиклОбмена));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыПодписатьСообщение(Знач КонтролирующийОрган, 
                                               МестоХраненияКлюча,
                                               Знач Сообщение,
                                               Знач ТипСообщения,
                                               Знач СертификатПодписанта, 
                                               Знач УчетнаяЗапись,
                                               Знач СообщениеОснование)

	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПодготовитьПараметрыПодписатьСообщение(
				КонтролирующийОрган,
				МестоХраненияКлюча,
				Сообщение,
				ТипСообщения,
				СертификатПодписанта,
				УчетнаяЗапись,
				СообщениеОснование);

КонецФункции

&НаКлиенте
Процедура ПодписатьСообщение(
		КонтролирующийОрган,
		ОповещениеОЗавершении,
		КонтекстОтправки,
		Сообщение,
		ТипСообщения,
		СертификатПодписанта = Неопределено,
		ИмяСгенерированногоФайлаЭЦП = Неопределено,
		УчетнаяЗапись = Неопределено,
		СообщениеОснование = Неопределено) Экспорт
	
	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(УчетнаяЗапись, КонтекстОтправки);
	
	ЦиклОбмена = ?(КонтекстОтправки.Свойство("ЦиклОбмена"), КонтекстОтправки.ЦиклОбмена, Неопределено);
	
	ФорматДокументооборота = ?(КонтекстОтправки.Свойство("ФорматДокументооборота"),
		КонтекстОтправки.ФорматДокументооборота, Неопределено);
	СообщениеОснованиеИПараметры = Новый Структура;
	СообщениеОснованиеИПараметры.Вставить("СообщениеОснование", 			СообщениеОснование);
	СообщениеОснованиеИПараметры.Вставить("ЦиклОбмена", 					ЦиклОбмена);
	СообщениеОснованиеИПараметры.Вставить("ФорматДокументооборота", 		ФорматДокументооборота);
	СообщениеОснованиеИПараметры.Вставить("ПолучитьФорматДокументооборота", КонтролирующийОрган = "ПФР");
	
	ПараметрыФункции = ПодготовитьПараметрыПодписатьСообщение(
		КонтролирующийОрган,
		МестоХраненияКлюча,
		Сообщение,
		ТипСообщения,
		СертификатПодписанта,
		УчетнаяЗапись,
		СообщениеОснованиеИПараметры);
	
	Если СообщениеОснованиеИПараметры.ПолучитьФорматДокументооборота Тогда
		КонтекстОтправки.Вставить("ФорматДокументооборота", ПараметрыФункции.ФорматДокументооборота);
	КонецЕсли;
	
	ТребуетПодтверждениеОперации = СвойствоСтруктуры(КонтекстОтправки, "ТребуетПодтверждениОперации", Неопределено);
	РежимПодтвержденияОблачнойПодписи(ТипСообщения, Сообщение, КонтекстОтправки, ТребуетПодтверждениеОперации);
	
	ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, КонтекстОтправки);
	ПараметрыФункции.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Оповещение = Новый ОписаниеОповещения("ПодписатьСообщениеПослеВыполнения", ЭтотОбъект, Контекст);	
	
	ПодписатьСообщениеНаКлиенте(Оповещение, ПараметрыФункции);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьДокументыДляПодписания(СообщениеДокументыКоторогоПодписываются, Сообщение, СертификатыПодписантов, ТипыДИВ, ВременныйКаталог = "")
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	Возврат КонтекстЭДОСервер.ПодготовитьДокументыДляПодписания(
		СообщениеДокументыКоторогоПодписываются,
		Сообщение,
		СертификатыПодписантов,
		ТипыДИВ,
		ВременныйКаталог);
	
КонецФункции

&НаКлиенте
Процедура ПодписатьСообщениеПослеСозданияКаталога(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ПараметрыФункции = ВходящийКонтекст.ПараметрыФункции;
	ВременныйКаталог = Результат.ИмяКаталога;
	
	ДокументыДляПодписания = ПодготовитьДокументыДляПодписания(
		ПараметрыФункции.СообщениеДокументыКоторогоПодписываются,
		ПараметрыФункции.Сообщение,
		ПараметрыФункции.СертификатыПодписантов,
		ПараметрыФункции.ТипыДИВ,
		ВременныйКаталог);
		
	КонтекстОтправки = ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	ПакетнаяПодпись = Ложь;
	
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
		И ПараметрыФункции.СертификатыПодписантов.Количество() = 1
		И ДокументыДляПодписания.Количество() > 1 Тогда
		ЭДОК = СвойствоСтруктуры(КонтекстОтправки, "ФорматДокументооборота") = ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК");
		ВсеТипы = Новый Соответствие;
		ВсеСертификаты = Новый Соответствие;
		Для Каждого СтрокаМассива Из ДокументыДляПодписания Цикл
			РасширениеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СтрокаМассива.ИмяФайла).Расширение;
			ВсеТипы.Вставить(НРег(РасширениеФайла), Истина);
		КонецЦикла;
		
		ПакетнаяПодпись = НЕ (ВсеТипы[".xml"] <> Неопределено И ЭДОК);
		
	КонецЕсли;
	
	Если ПакетнаяПодпись И ВключитьПакетнуюПодпись Тогда
		ВходящийКонтекст.Вставить("ДокументыДляПодписывания", ДокументыДляПодписания);
		
		Оповещение = Новый ОписаниеОповещения("ПодписатьСообщенияПакетноПослеВыполнения", ЭтотОбъект, ВходящийКонтекст);
		МассивДокументов = Новый Массив;
		Для Счетчик = 0 По ДокументыДляПодписания.ВГраница() Цикл
			СтрокаМассива = ДокументыДляПодписания[Счетчик];
			ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СтрокаМассива.ИмяФайла);
			НовыйДокументПакетнойПодписи(
				МассивДокументов,
				СтрокаМассива.Данные,
				ОписаниеФайла.Имя,
				ОписаниеФайла.Расширение,
				Счетчик);
		КонецЦикла;

		ПараметрыОперации = Новый Структура("ПодтверждатьОперацию", КонтекстОтправки.ТребуетПодтверждениеОперации);
		ПакетнаяПодписьОблачнойПодписи(Оповещение, МестоХраненияКлюча, МассивДокументов, ПараметрыФункции.СертификатыПодписантов[0], ПараметрыОперации);
		
	Иначе	
		ПодписатьСообщенияПоследовательно(ВходящийКонтекст, ДокументыДляПодписания, 0, ВременныйКаталог);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСообщенияПоследовательно(ВходящийКонтекст, ДокументыДляПодписывания, ТекущийДокумент, ВременныйКаталог)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если ТекущийДокумент <= ДокументыДляПодписывания.ВГраница() Тогда
		
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки);
		
		ЭтоОписьИходящихДокументов = ЭтоПодписаниеОписи(ВходящийКонтекст);
		
		ДокументДляПодписывания = ДокументыДляПодписывания[ТекущийДокумент];

		Контекст = ВходящийКонтекст;
		Контекст.Вставить("ДокументыДляПодписывания", ДокументыДляПодписывания);
		Контекст.Вставить("ТекущийДокумент", ТекущийДокумент);
		Контекст.Вставить("ВременныйКаталог", ВременныйКаталог);
		Если Не Контекст.Свойство("МенеджерКриптографии") Тогда
			Контекст.Вставить("МенеджерКриптографии", Неопределено);
		КонецЕсли;
		Если Не Контекст.Свойство("ДвоичныеДанные") Тогда
			Контекст.Вставить("ДвоичныеДанные", Неопределено);
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения(
			"ПодписатьСообщенияПоследовательноПослеСохраненияДанныхВФайл", ЭтотОбъект, Контекст);
		
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
			ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча)
			ИЛИ ЭтоОписьИходящихДокументов Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено, ДвоичныеДанные", Истина, Неопределено));
		Иначе		
			ОперацииСФайламиЭДКОКлиент.ДанныеССервераВФайл(
				Оповещение, ДокументДляПодписывания.Данные, ДокументДляПодписывания.ПолноеИмяФайла, Истина, Контекст.ДвоичныеДанные);
		КонецЕсли
	Иначе
		Если ВременныйКаталог <> "" Тогда //Не ЭП в облаке
		    ОперацииСФайламиЭДКОКлиент.УдалитьФайлыНаКлиенте(, ВременныйКаталог);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении,
			Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСообщенияПоследовательноПослеСохраненияДанныхВФайл(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		
		ПараметрыФункции = ВходящийКонтекст.ПараметрыФункции;
		КонтекстОтправки = ПараметрыФункции.КонтекстОтправки;
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
		ЭтоОписьИходящихДокументов = ЭтоПодписаниеОписи(ВходящийКонтекст);
		
		ДокументДляПодписывания = ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент];
		
		ВходящийКонтекст.Вставить("ДвоичныеДанные", Результат.ДвоичныеДанные);
		Если КонтекстОтправки.Свойство("ФорматДокументооборота") И КонтекстОтправки.ФорматДокументооборота =
			ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
			
			РасширениеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла).Расширение;
			ЭтоПодписьXMLDSig = (нрег(РасширениеФайла) = ".xml");
		Иначе
			ЭтоПодписьXMLDSig = Ложь;
		КонецЕсли;
		ВходящийКонтекст.Вставить("ЭтоПодписьXMLDSig", ЭтоПодписьXMLDSig);
		
		Оповещение = Новый ОписаниеОповещения(
			"ПодписатьСообщенияПоследовательноПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
		
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
			ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча)
			ИЛИ ЭтоОписьИходящихДокументов Тогда
			Данные = ДокументДляПодписывания.Данные;
			Подпись = Неопределено;
		Иначе
			Данные = Результат.ИмяФайла;
			Подпись = ВходящийКонтекст.ВременныйКаталог
				+ ?(КонтекстОтправки.Свойство("ФорматДокументооборота") И КонтекстОтправки.ФорматДокументооборота =
				ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК"),
				".|.sig", "|.bin");
		КонецЕсли;
		
		ТребуетПодтверждениеОперации = СвойствоСтруктуры(КонтекстОтправки, "ТребуетПодтверждениеОперации", Ложь);
		
		Если ЭтоПодписьXMLDSig Тогда
			Кодировка = Неопределено; // не требуется перекодировать, отчет уже в "utf-8"
			Если КонтекстОтправки.Свойство("ТипДокументооборота") И КонтекстОтправки.ТипДокументооборота = "СведенияПФР" Тогда
				
				ПрефиксИмениФайла = Лев(ДокументДляПодписывания.ИмяФайла, 4);
				ПрефиксИмениФайла = ВРег(ПрефиксИмениФайла);
				
				Если ПрефиксИмениФайла = "PFR-" Тогда
					Кодировка = "windows-1251";
				КонецЕсли; // иначе ПрефиксИмениФайла = "ПФР_"
			КонецЕсли;
			
			НастройкиПодписи = Новый Структура;
			НастройкиПодписи.Вставить("ДополнитьПространстваИменУзлаПодписи", 	Истина);
			НастройкиПодписи.Вставить("ПодстрокаУзлаДляИнформацииОПодписи", 	"ЭДСФР");
			НастройкиПодписи.Вставить("ИмяСобытияДляИнформацииОПодписи", 		"ЕЦП добавлять SignInfo");
			
			Если ЗначениеЗаполнено(ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.МЧД) Тогда
				НастройкиПодписи.Вставить("ЭтоИсключающаяКанонизация", 						Истина);
				НастройкиПодписи.Вставить("ТипКаноническогоXML", 							"КаноническийXML1_1");
				НастройкиПодписи.Вставить("ИспользоватьПреобразованиеККаноническомуXML", 	Истина);
				НастройкиПодписи.Вставить("КанонизацияБезКомментариев", 					Истина);
				НастройкиПодписи.Вставить("ПрефиксПодписи", 								"ds");
				НастройкиПодписи.Вставить("ДополнительноеПространствоИмен", 				"http://www.fss.ru/integration/types/common/v01");
				НастройкиПодписи.Вставить("ДобавитьШтампВремени", 							Истина);
				НастройкиПодписи.Вставить("ТолькоСвойстваБезШтампаВремени", 				Истина);
				НастройкиПодписи.Вставить("ИдентификаторРодителя", 							ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.МЧД);
				НастройкиПодписи.Вставить("ИсключитьИдентификаторСсылкиРодителя", 			Истина);
			КонецЕсли;
			
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
				ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла);
				ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации, НастройкиПодписи);
			КонецЕсли;
			
			ПодписатьФайлXMLDSig(
				ДокументДляПодписывания.Сертификат,
				Данные,
				Оповещение,
				Подпись,
				Кодировка,
				НастройкиПодписи);
				
		Иначе
			ПараметрыОперации = Неопределено;
			Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
				ОписаниеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла);
				ПараметрыОперации = ПодготовитьОблачнуюПодпись(ОписаниеФайла.Имя, ОписаниеФайла.Расширение, ТребуетПодтверждениеОперации);
			КонецЕсли;	
			
			КриптографияЭДКОКлиент.ПодписатьPKCS7(
				Оповещение, ДокументДляПодписывания.Сертификат, Данные, 
				Ложь, Подпись, Истина, ВходящийКонтекст.МенеджерКриптографии, , ПараметрыОперации);
				
		КонецЕсли;
		
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка выгрузки документа
                 |%1
                 |во временный файл для подписания.';
                 |en = 'Ошибка выгрузки документа
                 |%1
                 |во временный файл для подписания.'"), ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент].ИмяФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСообщенияПоследовательноПослеПодписания(Результат, ВходящийКонтекст) Экспорт
	
	Если ВходящийКонтекст.ЭтоПодписьXMLDSig Тогда
		Результат = Новый Структура("Выполнено, ФайлПодписи, ОписаниеОшибки", Результат <> Неопределено, Результат,
			?(Результат = Неопределено, НСтр("ru = 'Не удалось подписать в формате XMLDSig';
											|en = 'Не удалось подписать в формате XMLDSig'"), ""));
	КонецЕсли;
	
	Если Результат.Выполнено Тогда
		
		КонтекстОтправки = ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки;
		МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
		ЭтоОписьИходящихДокументов = ЭтоПодписаниеОписи(ВходящийКонтекст);
		ЭтоОтчетностьЦБ = ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.Свойство("ТипСообщения")
			И ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.ТипСообщения =
			ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ");
		
		Оповещение = Новый ОписаниеОповещения(
			"ПодписатьСообщенияПоследовательноПослеЧтенияДанныхИзФайла", ЭтотОбъект, ВходящийКонтекст);
		
		Если ЭтоОтчетностьЦБ Тогда
			ИмяФайлаПодписи = ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент].ИмяФайла;
			ИмяФайлаПодписи = ?(нрег(Прав(ИмяФайлаПодписи, 4)) = ".enc", Лев(ИмяФайлаПодписи, СтрДлина(ИмяФайлаПодписи) - 4),
				ИмяФайлаПодписи) + ".2.sig";
			
		Иначе
			ИмяФайлаПодписи = Результат.ФайлПодписи;
		КонецЕсли;
		ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент].Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);
		
		Если ЭтоОблачнаяПодпись(МестоХраненияКлюча)
			ИЛИ ЭтоПодписьСервиса(МестоХраненияКлюча)
			ИЛИ ЭтоОписьИходящихДокументов Тогда
			Если КонтекстОтправки.Свойство("ФорматДокументооборота") И КонтекстОтправки.ФорматДокументооборота =
				ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
				ИмяФайлаПодписи = "." + СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент(".sig");
			Иначе
				ИмяФайлаПодписи = СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент();
			КонецЕсли;
			ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент].ИмяФайлаПодписи = ИмяФайлаПодписи;
					
			ДД = ПолучитьИзВременногоХранилища(Результат.ФайлПодписи);
			СтрокаBase64 = Base64Строка(ДД);
			ВыполнитьОбработкуОповещения(Оповещение, Новый Структура("Выполнено, СтрокаBase64", Истина, СтрокаBase64));
		Иначе			
		ОперацииСФайламиЭДКОКлиент.ФайлВBase64(Оповещение, Результат.ФайлПодписи, Истина, ВходящийКонтекст.ДвоичныеДанные);
		КонецЕсли;
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка подписания документа: %1.
					   |По причине: %2';
					   |en = 'Ошибка подписания документа: %1.
					   |По причине: %2'"), 
			ПредставлениеТранспортногоСообщения(ВходящийКонтекст.ПараметрыФункции.Сообщение), 
			Результат.ОписаниеОшибки);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении, Ложь);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоПодписаниеОписи(ВходящийКонтекст)
	
	Если ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.Свойство("ТипСообщения") Тогда
		ЭтоОписьИходящихДокументов = ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПредставлениеНП");
	Иначе
		ЭтоОписьИходящихДокументов = Ложь;
	КонецЕсли;
	
	Возврат ЭтоОписьИходящихДокументов;
	
КонецФункции

&НаКлиенте
Процедура ПодписатьСообщенияПоследовательноПослеЧтенияДанныхИзФайла(Результат, ВходящийКонтекст) Экспорт
	
	ДокументДляПодписывания = ВходящийКонтекст.ДокументыДляПодписывания[ВходящийКонтекст.ТекущийДокумент];
	Если Результат.Выполнено Тогда
		// сохраняем в регистр
		Если ВходящийКонтекст.ЭтоПодписьXMLDSig Тогда
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ВходящийКонтекст.ПараметрыФункции.Сообщение,
				СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_ФайлОтчетностиПФР,
				Новый Структура("Строка64", Результат.СтрокаBase64),
				ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла).Имя,,,,,,
				ПредопределенноеЗначение("Перечисление.ТипыФайловОтчетностиПФР.ПачкаИС"),
				СгенерироватьUUID(),
				ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.xml")) Тогда
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Ошибка добавления содержимого транспортного контейнера ""%1"".';
						|en = 'Ошибка добавления содержимого транспортного контейнера ""%1"".'"),
					ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла).Имя);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ВыполнитьОбработкуОповещения(
					ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			КонецЕсли;
			
		Иначе
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ВходящийКонтекст.ПараметрыФункции.Сообщение,
				СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_ЭлектронноЦифроваяПодпись,
				Новый Структура("Строка64", Результат.СтрокаBase64),
				ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайлаПодписи).Имя,
				,
				ДокументДляПодписывания.ИмяФайла,
				ДокументДляПодписывания.Сертификат.Отпечаток,
				СтруктураСсылочныхДанных.Перечисления_СтатусыПроверкиЭЦП_Валидна,
				Истина) Тогда
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Ошибка добавления содержимого транспортного контейнера ""%1"".';
						|en = 'Ошибка добавления содержимого транспортного контейнера ""%1"".'"),
					ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайлаПодписи).Имя);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ВыполнитьОбработкуОповещения(
					ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			КонецЕсли;
			
			Если Лев(ДокументДляПодписывания.ИмяФайла, 9) = "ON_DOVEL_" Тогда
				СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДокументДляПодписывания.ИмяФайла);
				РасширениеДокументаДляПодписывания = СтруктураИмениФайла.Расширение;
				Если нрег(РасширениеДокументаДляПодписывания) = ".xml" Тогда
					ЕстьПриложениеСПодписью = Ложь;
					Для каждого ЭлементИзДокументовДляПодписывания Из ВходящийКонтекст.ДокументыДляПодписывания Цикл
						РасширениеЭлементаИзДокументовДляПодписывания = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
							ЭлементИзДокументовДляПодписывания.ИмяФайла).Расширение;
						Если нрег(РасширениеЭлементаИзДокументовДляПодписывания) = ".sgn" Тогда
							ЕстьПриложениеСПодписью = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ ЕстьПриложениеСПодписью Тогда
						ТипСодержимогоФайлаПриложения = ПредопределенноеЗначение("Перечисление.ТипыСодержимогоФайлов.sgn");
						ИмяФайлаПриложения = СтруктураИмениФайла.ИмяБезРасширения + "_SGN_"
							+ нрег(Строка(Новый УникальныйИдентификатор())) + ".sgn";
						Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
							ВходящийКонтекст.ПараметрыФункции.Сообщение,
							СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_Приложение,
							Новый Структура("Строка64", Результат.СтрокаBase64),
							ИмяФайлаПриложения,,,,,,,
							СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент(""),
							ТипСодержимогоФайлаПриложения) Тогда
							
							ТекстСообщения = СтрШаблон(
								НСтр("ru = 'Ошибка добавления содержимого транспортного контейнера ""%1"".';
									|en = 'Ошибка добавления содержимого транспортного контейнера ""%1"".'"),
								ИмяФайлаПриложения);
							ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
							ВыполнитьОбработкуОповещения(
								ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
							Возврат;
						КонецЕсли;
						ПриложениеДляПодписания = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ДокументДляПодписывания);
						ДанныеПриложения = Base64Значение(Результат.СтрокаBase64);
						ПриложениеДляПодписания.Данные = ПоместитьВоВременноеХранилище(ДанныеПриложения, Новый УникальныйИдентификатор);
						ПриложениеДляПодписания.ИмяФайла = ИмяФайлаПриложения;
						ПриложениеДляПодписания.ИмяФайлаПодписи = СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент();
						ПриложениеДляПодписания.ПолноеИмяФайла = ВходящийКонтекст.ВременныйКаталог + ИмяФайлаПриложения;
						ВходящийКонтекст.ДокументыДляПодписывания.Добавить(ПриложениеДляПодписания);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПодписатьСообщенияПоследовательно(ВходящийКонтекст, ВходящийКонтекст.ДокументыДляПодписывания, ВходящийКонтекст.ТекущийДокумент + 1, ВходящийКонтекст.ВременныйКаталог);
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка подписания документа
                  |%1.';
                  |en = 'Ошибка подписания документа
                  |%1.'"), ДокументДляПодписывания.ИмяФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении, Ложь);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТранспортнуюИнформациюДляСообщения(ОповещениеОЗавершении, КонтекстОтправки)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если ТипЗнч(КонтекстОтправки.ОбъектСертификатПолучателя) = Тип("Массив") Тогда
		СвойстваСертификатаПолучателя = КонтекстОтправки.ОбъектСертификатПолучателя[0];
	Иначе
		СвойстваСертификатаПолучателя = КонтекстОтправки.ОбъектСертификатПолучателя;
	КонецЕсли;
	Если ТипЗнч(СвойстваСертификатаПолучателя) = Тип("ФиксированнаяСтруктура") Тогда
		СвойстваСертификатаПолучателя = Новый Структура(СвойстваСертификатаПолучателя);
	КонецЕсли;
	
	КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись, СвойстваСертификатаПолучателя);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьТранспортнуюИнформациюДляСообщенияПослеЭкспортаСертификатаВBase64", ЭтотОбъект, Контекст);
	КриптографияЭДКОКлиент.ЭкспортироватьСертификатВBase64(
		Оповещение, СвойстваСертификатаПолучателя);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТранспортнуюИнформациюДляСообщенияПослеЭкспортаСертификатаВBase64(Результат, ВходящийКонтекст) Экспорт
	
	Если Результат.Выполнено Тогда
		СформироватьТранспортнуюИнформациюИСохранитьВИБ(ВходящийКонтекст.КонтекстОтправки.ТранспортноеСообщение, Результат.СтрокаBase64);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФРПослеВыполненияОтложенныхКомандНаКлиенте(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть аналогичная процедура СформироватьПакетПФРПослеВыполненияОтложенныхКоманд(),
	// которая используется при отправке отчетов из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// формируем файл описания пакета, создаем архив и помещаем в ИБ
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется запись состояния отправки в базу данных..."); // ПФР
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетПФР_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.Оповещать Тогда
		Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
														КонтекстОтправки.ТранспортноеСообщение,
														КонтекстОтправки.ЦиклОбмена));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПоследовательноОтложенно()
	ВыполнитьРасшифровкуСообщенийПоследовательно(КонтекстОтложеннойОперации);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПоследовательно(ВходящийКонтекст)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
		
	Если ВходящийКонтекст.ТекущийДокумент < ДокументыПакета.Количество() Тогда
		ЭлементПакета = ДокументыПакета[ВходящийКонтекст.ТекущийДокумент];
		
		Оповещение = Новый ОписаниеОповещения(
			"ВыполнитьРасшифровкуСообщенийПоследовательноПослеРасшифровки", ЭтотОбъект, ВходящийКонтекст);
		Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда 
			АдресФайла = ?(ЗначениеЗаполнено(ЭлементПакета.АдресФайла), ЭлементПакета.АдресФайла, ЭлементПакета.АдресФайлаПодписи);
			АлгоритмФайла = ?(ЗначениеЗаполнено(ЭлементПакета.АдресФайла), ЭлементПакета.АлгоритмФайла, ЭлементПакета.АлгоритмФайлаПодписи);
		Иначе
			АдресФайла = ЭлементПакета.АдресФайла;
			АлгоритмФайла = ЭлементПакета.АлгоритмФайла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресФайла) Тогда
			Если ЭлементПакета.ДокументЗашифрован Тогда
				ПараметрыОперации = Новый Структура("АлгоритмШифрованияОбязателен", ВходящийКонтекст.АлгоритмШифрованияОбязателен);
				КриптографияЭДКОКлиент.РасшифроватьPKCS7(
					Оповещение,
					АдресФайла,,
					ВходящийКонтекст.СертификатПолучателя,,,
					АлгоритмФайла,
					ПараметрыОперации);
				Возврат;
			КонецЕсли;
		Иначе
			ВходящийКонтекст.ТекущийДокумент = ВходящийКонтекст.ТекущийДокумент + 1;
			ВыполнитьРасшифровкуСообщенийПоследовательно(ВходящийКонтекст);
			Возврат;
		КонецЕсли;
		
		ВыполнитьРасшифровкуСообщенийПоследовательноПослеРасшифровки(Новый Структура("Выполнено", Истина), ВходящийКонтекст);
		
	Иначе
		Если ВходящийКонтекст.ТипСообщения = "ПФР" И (НЕ ВходящийКонтекст.Свойство("ФорматДокументооборота")
			ИЛИ ВходящийКонтекст.ФорматДокументооборота <> ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК")) Тогда
			// разбираем дополнительные описания с целью восстановить исходные имена файлов
			ВосстановитьИсходныеИменаФайлов(ВходящийКонтекст.СсылкаНаОбъект);
		КонецЕсли;
		
		// помещаем файлы в регистр содержимого, повторно распознаем получателя после расшифровки содержимого
		Если НЕ ПоместитьФайлыВРегистрСодержимого(ВходящийКонтекст.СсылкаНаОбъект) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		ЗафиксироватьПопыткуРасшифровки(ВходящийКонтекст.СсылкаНаОбъект, Истина);
		СвойстваОбъекта = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначенияРеквизитовОбъекта(
			ВходящийКонтекст.СсылкаНаОбъект, "ЦиклОбмена.Предмет, ЦиклОбмена.Организация");
		ОбновитьСостояниеЭДОсПФРПриЗаписиТранспортногоСообщения(СвойстваОбъекта.ЦиклОбменаПредмет,
			?(ВходящийКонтекст.ТипСообщения = "ПФР", ВходящийКонтекст.СсылкаНаОбъект, Неопределено));
		
		// особая обработка в случае неформализованных документов налогового органа, документов реализации своих полномочий
		// уведомлений об уточнении и протоколов приема 2-НДФЛ
		РезультатОбработки = ОбработатьНеформализованныеДокументы(ВходящийКонтекст.СсылкаНаОбъект);
		ВходящийКонтекст.Вставить("РезультатОбработкиНеформализованныхДокументов", РезультатОбработки);
		Если НЕ РезультатОбработки.Выполнено Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		Если РезультатОбработки.ИзменилсяСтатусМЧДФНС = Истина Тогда
			ПараметрыПриложения["ДокументооборотСКОКлиент.ИзменилсяСтатусМЧДФНС"] = Истина;
		КонецЕсли;
		
		ОтправкаОтчетностиВИнтерфакс = "РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОтправкаОтчетностиВИнтерфакс";
		Если ОбщегоНазначенияКлиент.ПодсистемаСуществует(ОтправкаОтчетностиВИнтерфакс) Тогда
			МодульОтправкаРегОтчетовВСПАРККлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОтправкаРегОтчетовВСПАРККлиент");
			МодульОтправкаРегОтчетовВСПАРККлиент.ОтправитьОтчетВСПАРКПриНеобходимостиПоТранспортномуСообщению(ВходящийКонтекст.СсылкаНаОбъект);
		КонецЕсли;
		
		Попытка
			Источник = Новый Структура();
			Источник.Вставить("Ссылка", СвойстваОбъекта.ЦиклОбменаПредмет);
			Источник.Вставить("Организация", СвойстваОбъекта.ЦиклОбменаОрганизация);
			Источник.Вставить("МетодВызова", "РасшифроватьТранспортноеСообщение");
			Оповестить("Запись_РегламентированныйОтчет", Источник);
		Исключение
		КонецПопытки;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьУПУППослеМЧДФНС",
			ЭтотОбъект, ВходящийКонтекст);
			
		Если (ТипЗнч(СвойстваОбъекта.ЦиклОбменаПредмет) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
			ИЛИ ТипЗнч(СвойстваОбъекта.ЦиклОбменаПредмет) = Тип("СправочникСсылка.ЗаявленияОбОтзывеМЧДФНС"))
			И НЕ ЭтоОбменИзСтарогоЖурналаОбмена(ВходящийКонтекст) Тогда
			
			ДокументооборотСКОКлиент.НастроитьМЧДФНС(ОписаниеОповещения);
			
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьУПУППослеМЧДФНС(Результат, ВходящийКонтекст) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДействияПослеОбмена",
		ЭтотОбъект, ВходящийКонтекст);
			
	Если НЕ ЭтоОбменИзСтарогоЖурналаОбмена(ВходящийКонтекст)
		И ВходящийКонтекст.РезультатОбработкиНеформализованныхДокументов.ИзменилсяСтатусЗПЭД Тогда
		
		ОтправитьУПУППослеОбмена(ОписаниеОповещения);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоОбменИзСтарогоЖурналаОбмена(ВходящийКонтекст)
	
	Возврат ДокументооборотСКОКЛиент.ЕстьИменаПроцедурВОповещенияхОЗавершении(
		"ОсуществитьОбменПоУчетнойЗаписи", 
		ВходящийКонтекст.ОповещениеОЗавершении);
	
КонецФункции

&НаКлиенте
Процедура ДействияПослеОбмена(Результат, ВходящийКонтекст) Экспорт
	
	// Если при создании подтверждения из панели отправки отчета или формы этапов отправки
	// оказалось, что сообщение, на которое создается подтверждение, не расшифровано,
	// то мы пытаемся расшифровать его принудительно и теперь нужно попытаться повторно создать на него подтверждение
	// в процедуре СоздатьПодтверждениеПослеРасшифровки.
	// Если оно было расшифровано, то создаем на него подтверждение.
	
	ДополнительныеПараметры = ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры;
	ЭтоОтправкаПодтвержденияИзПанелиОтправки = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ЭтоОтправкаПодтвержденияИзПанелиОтправки");
	
	Если ЭтоОтправкаПодтвержденияИзПанелиОтправки Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения(
			"ВыполнитьРасшифровкуСообщенийПослеСозданияПодтверждения", ЭтотОбъект, ВходящийКонтекст);
			
		СоздатьПодтверждениеПриНеобходимости(Оповещение, ВходящийКонтекст.СсылкаНаОбъект)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПоследовательноПослеНастройкиМЧДФНС(Результат, ВходящийКонтекст) Экспорт
	
	// Если при создании подтверждения из панели отправки отчета или формы этапов отправки
	// оказалось, что сообщение, на которое создается подтверждение, не расшифровано,
	// то мы пытаемся расшифровать его принудительно и теперь нужно попытаться повторно создать на него подтверждение
	// в процедуре СоздатьПодтверждениеПослеРасшифровки.
	// Если оно было расшифровано, то создаем на него подтверждение.
	
	ДополнительныеПараметры = ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры;
	ЭтоОтправкаПодтвержденияИзПанелиОтправки = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ЭтоОтправкаПодтвержденияИзПанелиОтправки");
	
	Если ЭтоОтправкаПодтвержденияИзПанелиОтправки Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения(
			"ВыполнитьРасшифровкуСообщенийПослеСозданияПодтверждения", ЭтотОбъект, ВходящийКонтекст);
			
		СоздатьПодтверждениеПриНеобходимости(Оповещение, ВходящийКонтекст.СсылкаНаОбъект)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПослеСозданияПодтверждения(Результат, ВходящийКонтекст) Экспорт
	
	ВходящийКонтекст.Вставить("Подтверждение", Результат);
	Оповещение = Новый ОписаниеОповещения(
			"ВыполнитьРасшифровкуСообщенийПослеСозданияРезультатПриема", ЭтотОбъект, ВходящийКонтекст);
			
	СоздатьРезультатПриемаНаКлиентеСУчетомВопроса(Оповещение, ВходящийКонтекст.СсылкаНаОбъект, Истина, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПослеСозданияРезультатПриема(Результат, ВходящийКонтекст) Экспорт
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПоследовательноПослеРасшифровки(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиент.ПослеЗавершенияРасшифровки(Результат, ВходящийКонтекст);
	
	Если Результат.Выполнено Тогда
		ЭлементПакета = ДокументыПакета[ВходящийКонтекст.ТекущийДокумент];
		Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда 
			АдресФайла = ?(ЗначениеЗаполнено(ЭлементПакета.АдресФайла), ЭлементПакета.АдресФайла, ЭлементПакета.АдресФайлаПодписи);
		Иначе
			АдресФайла = ЭлементПакета.АдресФайла;
		КонецЕсли;
		Если ЭлементПакета.ДокументСжат Тогда		
			Если Не ЗначениеЗаполнено(АдресФайла) Тогда
				ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			Иначе
				ЭтоФайлПодписи = ВходящийКонтекст.ТипСообщения = "ФНС_534" И НЕ ЗначениеЗаполнено(ЭлементПакета.АдресФайла);
				ТипАрхива = ?(ВходящийКонтекст.ТипСообщения = "ПФР",
					?(ЗначениеЗаполнено(ВходящийКонтекст.ФорматДокументооборота),
					?(ВходящийКонтекст.ФорматДокументооборота = 
					ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК"), "gzip", "zip"),
					Неопределено), "zip");
				АдресФайла = РазархивироватьФайлИзВременногоХранилища(АдресФайла, НЕ ЭтоФайлПодписи, ТипАрхива);
				Если ВходящийКонтекст.ТипСообщения = "ПФР" И ТипАрхива = "gzip"
					И НЕ ЗначениеЗаполнено(ВходящийКонтекст.ФорматДокументооборота) Тогда
					
					ВходящийКонтекст.ФорматДокументооборота =
						ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК");
				КонецЕсли;
				
				Если АдресФайла <> Неопределено ИЛИ НЕ ЭтоФайлПодписи Тогда
					ЭлементПакета.АдресФайла = АдресФайла;
					Если ВходящийКонтекст.ТипСообщения = "ФНС_534" Тогда
						Если ЗначениеЗаполнено(ЭлементПакета.АдресФайла) Тогда
							ЭлементПакета.АдресФайла = АдресФайла;
						Иначе
							ЭлементПакета.АдресФайлаПодписи = АдресФайла;
						КонецЕсли;
					Иначе
						ЭлементПакета.АдресФайла = АдресФайла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ВходящийКонтекст.ТипСообщения = "ФСГС" Тогда 
			Если ЭлементПакета.ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыСодержимогоТранспортногоКонтейнера.ШаблонФСГС") Тогда
				Попытка
					ПараметрыШаблона = Новый Структура("АдресФайла, ИмяФайла", ЭлементПакета.АдресФайла, ЭлементПакета.ИмяФайла);
					ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПриПолученииНовогоШаблонаФСГС(ПараметрыШаблона);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭлементПакета.АдресФайлаПодписи) ИЛИ ВходящийКонтекст.ТипСообщения = "ПФР"
			И ВходящийКонтекст.ФорматДокументооборота =
			ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
			
			МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(ВходящийКонтекст.СертификатПолучателя);
			
			Оповещение = Новый ОписаниеОповещения(
				"ВыполнитьРасшифровкуСообщенийПоследовательноПослеПроверкиПодписи", ЭтотОбъект, ВходящийКонтекст);
			Если ЗначениеЗаполнено(ЭлементПакета.АдресФайла) Тогда
				Если ВходящийКонтекст.ТипСообщения = "ПФР" И ВходящийКонтекст.ФорматДокументооборота =
					ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК") Тогда
					
					Результат = Новый Структура("Выполнено, ПодписьВалидна, Подписанты", Истина, Неопределено, Неопределено);
					ВыполнитьОбработкуОповещения(Оповещение, Результат);
					
				Иначе
					КриптографияЭДКОКлиент.ПроверитьПодписьPKCS7(
						Оповещение,
						МестоХраненияКлюча,
						ЭлементПакета.АдресФайлаПодписи,
						ЭлементПакета.АдресФайла,,
						Ложь,,
						ЭлементПакета.АлгоритмФайлаПодписи);
				КонецЕсли;
			Иначе
				Результат = Новый Структура("Выполнено, ПодписьВалидна, Подписанты", Истина, Неопределено, Неопределено);
				ВыполнитьОбработкуОповещения(Оповещение, Результат);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	Иначе
		
		Если ВходящийКонтекст.ПараметрыПоказа <> Неопределено И ВходящийКонтекст.ПараметрыПоказа.ПоказДляДругихПользователей
			ИЛИ ТранспортноеСообщениеЗашифрованоДляТекущегоПользователя(ВходящийКонтекст.СсылкаНаОбъект) Тогда
			
			ТекстСообщения = НСтр("ru = 'Ошибка расшифровки файла документа при распаковке пакета.';
									|en = 'Ошибка расшифровки файла документа при распаковке пакета.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				ТекстСообщения,,,,,
				НовыйКонтекстРасшифровки(ВходящийКонтекст.СсылкаНаОбъект, ВходящийКонтекст.ПараметрыПоказа));
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ВходящийКонтекст.ТекущийДокумент = ВходящийКонтекст.ТекущийДокумент + 1;
	ВыполнитьРасшифровкуСообщенийПоследовательно(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасшифровкуСообщенийПоследовательноПослеПроверкиПодписи(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если НЕ Результат.Выполнено ИЛИ Результат.ПодписьВалидна = Ложь Тогда
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Проверка подписи';
							|en = 'Электронный документооборот с контролирующими органами. Проверка подписи'");
		ТекстСообщения = НСтр("ru = 'Ошибка проверки подписи файла документа при распаковке пакета ""%1"" (тип сообщения: ""%2"", "
			+ "тип документа: ""%3"", имя файла: ""%4"", идентификатор: ""%5"", в модели сервиса: %6). %7'");
		
		Если Результат.Свойство("ОписаниеОшибки") Тогда
			ТекстОшибки = Результат.ОписаниеОшибки;
		Иначе
			ТекстОшибки = НСтр("ru = 'Подпись невалидна.';
								|en = 'Подпись невалидна.'");
		КонецЕсли;
		
		Если Результат.Свойство("Подписанты") И Результат.Подписанты <> Неопределено И Результат.Подписанты.Количество() > 0 Тогда
			ТекстИнформацииОСертификате = НСтр("ru = 'Проверка сертификатом поставщика ""%1"" с серийным номером ""%2"".';
												|en = 'Проверка сертификатом поставщика ""%1"" с серийным номером ""%2"".'");
			ТекстОшибки = ТекстОшибки + " " + СтрШаблон(
				ТекстИнформацииОСертификате,
				Результат.Подписанты[0].Поставщик,
				Результат.Подписанты[0].СерийныйНомер);
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(
			ТекстСообщения,
			Строка(ВходящийКонтекст.СсылкаНаОбъект),
			ВходящийКонтекст.ТипСообщения,
			Строка(ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].ТипДокумента),
			ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].ИмяФайла,
			ДокументыПакета[ВходящийКонтекст.ТекущийДокумент].Идентификатор,
			Строка(НЕ ЭтоЛокальнаяПодпись(ВходящийКонтекст.СертификатПолучателя)),
			ТекстОшибки);
		
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, "Предупреждение", ТекстСообщения,, Истина);
	КонецЕсли;
	
	ЭлементПакета = ДокументыПакета[ВходящийКонтекст.ТекущийДокумент];
	ЭлементПакета.СтатусПроверкиПодписи = ?(Результат.Выполнено И Результат.ПодписьВалидна = Неопределено,
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.ПустаяСсылка"),
		?(Результат.Выполнено И Результат.ПодписьВалидна,
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.Валидна"),
		ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.НеВалидна")));
	Если Результат.Свойство("Подписанты") И Результат.Подписанты <> Неопределено
		И Результат.Подписанты.Количество() > 0 И Результат.Подписанты[0].Свойство("Отпечаток") Тогда
		ЭлементПакета.ОтпечатокСертификатаПодписи = Результат.Подписанты[0].Отпечаток;
	Иначе
		ЭлементПакета.ОтпечатокСертификатаПодписи = "";
	КонецЕсли;
	
	ВходящийКонтекст.ТекущийДокумент = ВходящийКонтекст.ТекущийДокумент + 1;
	ВыполнитьРасшифровкуСообщенийПоследовательно(ВходящийКонтекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаРегламентированногоОтчетаВПФРПослеФормированияПакета(Результат, ВходящийКонтекст) Экспорт 

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.

	Документ = ВходящийКонтекст.КонтекстОтправки.Документ;
	Если Не Результат Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);

		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР.
		
		Возврат;
		
	КонецЕсли;
	
	// формируем пакет
	Если НЕ ОтправитьТранспортноеСообщениеИЗаписатьСтатусОтправки(ВходящийКонтекст.КонтекстОтправки) Тогда // сервер

		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
		ДополнительныеПараметры.Вставить("РезультатОтправки", 		Ложь);
		
		ДлительнаяОтправкаКлиент.ОповеститьОНеудачнойОтправке(ДополнительныеПараметры); // ПФР.
		
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыполняемоеОповещение", 	ВходящийКонтекст.ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("РезультатОтправки", 		Истина);
	
	ДлительнаяОтправкаКлиент.ОповеститьОбУдачнойОтправке(ДополнительныеПараметры); // ПФР.
		
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаСРасширениемРаботыСФайлами(ДополнительныеПараметры) Экспорт
	
	Путь = ДополнительныеПараметры.Путь;
	
	// Выбор каталога для сохранения файлов цикла обмена
	Если ЗначениеЗаполнено(Путь) Тогда
		
		ВыбранныеФайлы = Новый Массив;
		ВыбранныеФайлы.Вставить(Путь);
		
		ВыгрузитьЦиклыОбменаПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры);
		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыгрузитьЦиклыОбменаПослеВыбораКаталога", 
			ЭтотОбъект, 
			ДополнительныеПараметры); 
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Диалог.Заголовок = "Укажите каталог";
		Диалог.ПроверятьСуществованиеФайла = Истина;
		Диалог.Показать(ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	Иначе
		Путь = ВыбранныеФайлы[0];
		ДополнительныеПараметры.Вставить("Путь", Путь);
	КонецЕсли;
	
	ЦиклыОбмена 				= ДополнительныеПараметры.ЦиклыОбмена;
	ОбщееЧислоЦикловОбмена 		= ЦиклыОбмена.Количество();
	ПредставленияЦикловОбмена 	= ПолучитьПредставленияЦикловОбмена(ЦиклыОбмена);
	
	ДополнительныеПараметры.Вставить("СоответствиеСообщенияКаталогу", 	Новый Соответствие);
	ДополнительныеПараметры.Вставить("СоответствиеТипаСообщенияКраткомуПредставлению", 	ИнициализироватьСоответствиеТСКП());
	ДополнительныеПараметры.Вставить("ОбщееЧислоЦикловОбмена", 			ОбщееЧислоЦикловОбмена);
	ДополнительныеПараметры.Вставить("ПредставленияЦикловОбмена", 		ПредставленияЦикловОбмена);
	ДополнительныеПараметры.Вставить("ЧислоВыгруженныхЦикловОбмена", 	0);
	ДополнительныеПараметры.Вставить("ЧислоВыгруженныхФайлов", 			0);
	ДополнительныеПараметры.Вставить("МассивОписанийПолучаемыеФайлы", 	Новый Массив);
	
	ВыгрузитьЦиклыОбменаПоКаждомуЦиклуОбмена(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаПоКаждомуЦиклуОбмена(ДополнительныеПараметры)
	
	ОбщееЧислоЦикловОбмена			= ДополнительныеПараметры.ОбщееЧислоЦикловОбмена;
	ЦиклыОбмена 					= ДополнительныеПараметры.ЦиклыОбмена;
	Путь 							= ДополнительныеПараметры.Путь;
	ОбщееКоличествоФайлов 			= ДополнительныеПараметры.ОбщееКоличествоФайлов;
	ЧислоВыгруженныхЦикловОбмена	= ДополнительныеПараметры.ЧислоВыгруженныхЦикловОбмена; 
	МассивОписанийПолучаемыеФайлы	= ДополнительныеПараметры.МассивОписанийПолучаемыеФайлы;
	
	Если ЧислоВыгруженныхЦикловОбмена < ОбщееЧислоЦикловОбмена Тогда
		
		// формируем текущую порцию циклов обмена
		ПорцияЦиклов = Новый Массив;
		РазмерПорции = 10;
		Для Инд = ЧислоВыгруженныхЦикловОбмена + 1 По Мин(ЧислоВыгруженныхЦикловОбмена + РазмерПорции, ОбщееЧислоЦикловОбмена) Цикл
			ПорцияЦиклов.Добавить(ЦиклыОбмена[Инд - 1]);
		КонецЦикла;
		ЧислоВыгруженныхЦикловОбмена = ЧислоВыгруженныхЦикловОбмена + РазмерПорции;
		ДополнительныеПараметры.Вставить("ЧислоВыгруженныхЦикловОбмена", ЧислоВыгруженныхЦикловОбмена);
		
		// получаем выгружаемые файлы
		ВыгружатьКонтейнеры 	= ДополнительныеПараметры.ВыгружатьКонтейнеры;
		ВыгружатьСодержимое 	= ДополнительныеПараметры.ВыгружатьСодержимое;

		ТранспортныеСообщения = ПолучитьВыгружаемыеФайлы(ПорцияЦиклов, ВыгружатьКонтейнеры, ВыгружатьСодержимое);
		
		ОбщееЧислоТранспортныхСообщений = ТранспортныеСообщения.Количество();
		
		// для каждого из выгружаемых файлов...
		ДополнительныеПараметры.Вставить("МассивОписанийПолучаемыеФайлы", 			Новый Массив);
		ДополнительныеПараметры.Вставить("ЧислоВыгруженныхТранспортныхСообщений", 	0);
		ДополнительныеПараметры.Вставить("ОбщееЧислоТранспортныхСообщений", 		ОбщееЧислоТранспортныхСообщений);
		ДополнительныеПараметры.Вставить("ТранспортныеСообщения", 					ТранспортныеСообщения);
			
		ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбмена(ДополнительныеПараметры);
		
	Иначе
		
		ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(МассивОписанийПолучаемыеФайлы);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбмена(ДополнительныеПараметры)
		
	Путь 											= ДополнительныеПараметры.Путь;
	СоответствиеСообщенияКаталогу					= ДополнительныеПараметры.СоответствиеСообщенияКаталогу;
	СоответствиеТипаСообщенияКраткомуПредставлению	= ДополнительныеПараметры.СоответствиеТипаСообщенияКраткомуПредставлению;
	ЧислоВыгруженныхЦикловОбмена					= ДополнительныеПараметры.ЧислоВыгруженныхЦикловОбмена;
	МассивОписанийПолучаемыеФайлы					= ДополнительныеПараметры.МассивОписанийПолучаемыеФайлы;
	ОбщееЧислоТранспортныхСообщений					= ДополнительныеПараметры.ОбщееЧислоТранспортныхСообщений;
	ЧислоВыгруженныхТранспортныхСообщений			= ДополнительныеПараметры.ЧислоВыгруженныхТранспортныхСообщений;
	ПредставленияЦикловОбмена 						= ДополнительныеПараметры.ПредставленияЦикловОбмена;
	ТранспортныеСообщения 							= ДополнительныеПараметры.ТранспортныеСообщения;
	
	Если ЧислоВыгруженныхТранспортныхСообщений <= ОбщееЧислоТранспортныхСообщений - 1 Тогда
		
		ОбработкаПрерыванияПользователя();
		
		СодержимоеТранспортногоСообщения = ТранспортныеСообщения[ЧислоВыгруженныхТранспортныхСообщений];
		ДополнительныеПараметры.Вставить("СодержимоеТранспортногоСообщения", СодержимоеТранспортногоСообщения);
		
		ЦиклОбмена 			= СодержимоеТранспортногоСообщения.ТранспортноеСообщениеЦиклОбмена;
		Сообщение 			= СодержимоеТранспортногоСообщения.ТранспортноеСообщение;
		ТипСообщения 		= СодержимоеТранспортногоСообщения.ТранспортноеСообщениеТип;
		
		ПредставлениеЦиклаОбмена 			= ПредставленияЦикловОбмена[ЦиклОбмена];
		КраткоеПредставлениеТипаСообщения 	= СоответствиеТипаСообщенияКраткомуПредставлению[ТипСообщения];
		ДополнительныеПараметры.Вставить("КраткоеПредставлениеТипаСообщения",	КраткоеПредставлениеТипаСообщения);
		ДополнительныеПараметры.Вставить("ПредставлениеЦиклаОбмена", 			ПредставлениеЦиклаОбмена);
		
		Если НЕ ЗначениеЗаполнено(КраткоеПредставлениеТипаСообщения) Тогда
			КраткоеПредставлениеТипаСообщения = ТипСообщения;
		КонецЕсли;
		
		// если сообщение уже выгружалось, то используем каталог предыдущей выгрузки
		КаталогВыгрузки = СоответствиеСообщенияКаталогу[Сообщение];
		Если КаталогВыгрузки = Неопределено Тогда
			
			КаталогВыгрузки = Путь;
			КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
			
			// дополняем путь каталогом цикла обмена
			ДополнятьПуть = ДополнительныеПараметры.ДополнятьПуть;
			Если ДополнятьПуть Тогда
				КаталогВыгрузки = КаталогВыгрузки + СокрЛП(СформироватьИмяФайла(ПредставлениеЦиклаОбмена));
				КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
			КонецЕсли;
			
			ПолныйКаталогВыгрузки = КаталогВыгрузки + КраткоеПредставлениеТипаСообщения;
			ПолныйКаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолныйКаталогВыгрузки);
			
			// дополняем путь каталогом типа сообщения
			ДополнительныеПараметры.Вставить("НомерКаталога", 			1);
			ДополнительныеПараметры.Вставить("КаталогВыгрузки", 		КаталогВыгрузки);
			ДополнительныеПараметры.Вставить("ПолныйКаталогВыгрузки", 	ПолныйКаталогВыгрузки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПроверкиСуществованияКаталогаВыгрузки", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ПолныйКаталогВыгрузки);
			
		Иначе
			
			ДополнительныеПараметры.Вставить("КаталогВыгрузки", КаталогВыгрузки);
			ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПодбораИмениКаталогаВыгрузки(ДополнительныеПараметры);
			
		КонецЕсли;
		
	Иначе
		
		ВыгрузитьЦиклыОбменаПоКаждомуЦиклуОбмена(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПроверкиСуществованияКаталогаВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		Если Результат.СвойстваФайла.Существует Тогда
			
			// Если каталог уже существует, то пытаемся создать новый каталог путем прибавления 1 к счетчику: (1)
			НомерКаталога 						= ДополнительныеПараметры.НомерКаталога;
			ПолныйКаталогВыгрузки 				= ДополнительныеПараметры.ПолныйКаталогВыгрузки;
			КаталогВыгрузки 					= ДополнительныеПараметры.КаталогВыгрузки;
			КраткоеПредставлениеТипаСообщения 	= ДополнительныеПараметры.КраткоеПредставлениеТипаСообщения;
			
			НомерКаталога 		  = НомерКаталога + 1;
			ПолныйКаталогВыгрузки = КаталогВыгрузки + КраткоеПредставлениеТипаСообщения + " (" + Формат(НомерКаталога, "ЧГ=") + ")\";
			
			ДополнительныеПараметры.Вставить("НомерКаталога", 			НомерКаталога);
			ДополнительныеПараметры.Вставить("ПолныйКаталогВыгрузки", 	ПолныйКаталогВыгрузки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПроверкиСуществованияКаталогаВыгрузки", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ПолныйКаталогВыгрузки);
			
		Иначе
			
			КаталогВыгрузки = ДополнительныеПараметры.ПолныйКаталогВыгрузки;
			ДополнительныеПараметры.КаталогВыгрузки = КаталогВыгрузки;
			
			// запоминаем путь сообщения
			СодержимоеТранспортногоСообщения 	= ДополнительныеПараметры.СодержимоеТранспортногоСообщения;
			Сообщение 							= СодержимоеТранспортногоСообщения.ТранспортноеСообщение;
			СоответствиеСообщенияКаталогу		= ДополнительныеПараметры.СоответствиеСообщенияКаталогу;
			
			СоответствиеСообщенияКаталогу.Вставить(Сообщение, КаталогВыгрузки);
			ДополнительныеПараметры.Вставить("СоответствиеСообщенияКаталогу", СоответствиеСообщенияКаталогу);
			
			ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПодбораИмениКаталогаВыгрузки(ДополнительныеПараметры);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПодбораИмениКаталогаВыгрузки(ДополнительныеПараметры)
	
	ОбщееЧислоТранспортныхСообщений			= ДополнительныеПараметры.ОбщееЧислоТранспортныхСообщений;
	ЧислоВыгруженныхТранспортныхСообщений	= ДополнительныеПараметры.ЧислоВыгруженныхТранспортныхСообщений;
	СоответствиеСообщенияКаталогу			= ДополнительныеПараметры.СоответствиеСообщенияКаталогу;
	СодержимоеТранспортногоСообщения		= ДополнительныеПараметры.СодержимоеТранспортногоСообщения;
	КаталогВыгрузки 						= ДополнительныеПараметры.КаталогВыгрузки;
	КраткоеПредставлениеТипаСообщения		= ДополнительныеПараметры.КраткоеПредставлениеТипаСообщения;
	ПредставлениеЦиклаОбмена				= ДополнительныеПараметры.ПредставлениеЦиклаОбмена;
		
	// Содержимое выгружаем в подкаталог "Содержимое" каталога сообщения
	Если СодержимоеТранспортногоСообщения.Свойство("ИДСодержимое") И СодержимоеТранспортногоСообщения.ИДСодержимое = "Содержимое" 
		ИЛИ СодержимоеТранспортногоСообщения.Свойство("ИДКонтейнеры") И СодержимоеТранспортногоСообщения.ИДКонтейнеры = "Контейнеры" Тогда
		КаталогВыгрузки = КаталогВыгрузки + "Содержимое\";
	КонецЕсли;
	
	// прорисовываем состояние в форме прогресса
	// используем состояние
	ЧислоВыгруженныхТранспортныхСообщений = ЧислоВыгруженныхТранспортныхСообщений + 1;
	Состояние(ПредставлениеЦиклаОбмена, ЧислоВыгруженныхТранспортныхСообщений / ОбщееЧислоТранспортныхСообщений * 100, КраткоеПредставлениеТипаСообщения);
	
	ДополнительныеПараметры.Вставить("ЧислоВыгруженныхТранспортныхСообщений", 	ЧислоВыгруженныхТранспортныхСообщений);
	ДополнительныеПараметры.Вставить("КаталогВыгрузки", 						КаталогВыгрузки);
	
	// Проверяем существование каталога. Если не существует - то создаем.
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПроверкиСуществованияКаталога", 
		ЭтотОбъект, 
		ДополнительныеПараметры);
		
	ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, КаталогВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеПроверкиСуществованияКаталога(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат.Выполнено Тогда 
		
		КаталогВыгрузки = ДополнительныеПараметры.КаталогВыгрузки;
		Если Результат.СвойстваФайла.Существует Тогда
			
			ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеСозданияКаталога(КаталогВыгрузки, ДополнительныеПараметры);
		
		Иначе
			
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеСозданияКаталога", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			// если каталог выгрузки не существует, то пытаемся создать
			НачатьСозданиеКаталога(ОписаниеОповещения, КаталогВыгрузки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбменаПослеСозданияКаталога(КаталогВыгрузки, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		
		Если Прав(КаталогВыгрузки, 1) <> ПолучитьРазделительПути() Тогда
			КаталогВыгрузки = КаталогВыгрузки + ПолучитьРазделительПути();
		КонецЕсли;
		
		СодержимоеТранспортногоСообщения = ДополнительныеПараметры.СодержимоеТранспортногоСообщения;
		ДополнительныеПараметры.Вставить("КаталогВыгрузки", КаталогВыгрузки);
			
		// если в каталоге выгрузки уже присутствует файл с тем же именем,
		// то добавляем в конце имени выгружаемого файла счетчик
		Инд = 1;
		ПолноеИмяФайлаБезПрефикса = КаталогВыгрузки + СформироватьИмяФайла(СодержимоеТранспортногоСообщения.ИмяФайла);
		ПолноеИмяФайла = ПолноеИмяФайлаБезПрефикса;
		
		// определяем вхождение последней точки
		ПоследнееВхожденияТочки = 0;
		ДлинаПолногоИмениФайла = СтрДлина(ПолноеИмяФайлаБезПрефикса);
		Для Инд = 1 По ДлинаПолногоИмениФайла Цикл
			ТекИнд = ДлинаПолногоИмениФайла - Инд + 1;
			Если Сред(ПолноеИмяФайлаБезПрефикса, ТекИнд, 1) = "." Тогда
				ПоследнееВхожденияТочки = ТекИнд;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ДополнительныеПараметры.Вставить("ПолноеИмяФайла", 				ПолноеИмяФайла);
		ДополнительныеПараметры.Вставить("ПолноеИмяФайлаБезПрефикса", 	ПолноеИмяФайлаБезПрефикса);
		ДополнительныеПараметры.Вставить("ПоследнееВхожденияТочки", 	ПоследнееВхожденияТочки);
		ДополнительныеПараметры.Вставить("Инд", 						1);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыгрузитьТранспортноеСообщениеПослеПроверкиСуществованияПутиКФайлу", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
			
		ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ПолноеИмяФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТранспортноеСообщениеПослеПроверкиСуществованияПутиКФайлу(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Выполнено Тогда
		
		МассивОписанийПолучаемыеФайлы			= ДополнительныеПараметры.МассивОписанийПолучаемыеФайлы;
		ОбщееЧислоТранспортныхСообщений			= ДополнительныеПараметры.ОбщееЧислоТранспортныхСообщений;
		ЧислоВыгруженныхТранспортныхСообщений	= ДополнительныеПараметры.ЧислоВыгруженныхТранспортныхСообщений;
		ТранспортныеСообщения 					= ДополнительныеПараметры.ТранспортныеСообщения;
		ПолноеИмяФайлаБезПрефикса 				= ДополнительныеПараметры.ПолноеИмяФайлаБезПрефикса;
		ПолноеИмяФайла 							= ДополнительныеПараметры.ПолноеИмяФайла;
		ПоследнееВхожденияТочки 				= ДополнительныеПараметры.ПоследнееВхожденияТочки;
		СодержимоеТранспортногоСообщения 		= ДополнительныеПараметры.СодержимоеТранспортногоСообщения;
		Инд 									= ДополнительныеПараметры.Инд;
		
		Если Результат.СвойстваФайла.Существует Тогда
		
			Инд = Инд + 1;
			Если ПоследнееВхожденияТочки = 0 Тогда
				ПолноеИмяФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1 (%2)';
						|en = '%1 (%2)'"), 
					ПолноеИмяФайлаБезПрефикса,
					Формат(Инд, "ЧГ="));
			Иначе
				ПолноеИмяФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1 (%2) %3';
						|en = '%1 (%2) %3'"), 	
					Лев(ПолноеИмяФайлаБезПрефикса, ПоследнееВхожденияТочки - 1),
					Формат(Инд, "ЧГ="),
					Сред(ПолноеИмяФайлаБезПрефикса, ПоследнееВхожденияТочки)); 
			КонецЕсли;
			
			ДополнительныеПараметры.Инд 			= Инд;
			ДополнительныеПараметры.ПолноеИмяФайла 	= ПолноеИмяФайла;
			
			// Проверяем существование заново
			ОписаниеОповещения = Новый ОписаниеОповещения(
				"ВыгрузитьТранспортноеСообщениеПослеПроверкиСуществованияПутиКФайлу", 
				ЭтотОбъект, 
				ДополнительныеПараметры);
				
			ОперацииСФайламиЭДКОКлиент.ПолучитьСвойстваФайла(ОписаниеОповещения, ПолноеИмяФайла);
		
		Иначе
		
			// Адрес данных и сформированное имя файла помещается в массив описаний
			
			АдресВоВременномХранилище 	= СодержимоеТранспортногоСообщения.Адрес;
			ОписаниеФайла 				= Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресВоВременномХранилище); 
			
			МассивОписанийПолучаемыеФайлы.Добавить(ОписаниеФайла);
			ДополнительныеПараметры.Вставить("МассивОписанийПолучаемыеФайлы", МассивОписанийПолучаемыеФайлы);
			
			ВыгрузитьТранспортноеСообщениеПоКаждомуЦиклуОбмена(ДополнительныеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЦиклыОбменаБезРасширенияРаботыСФайлами(ДополнительныеПараметры) Экспорт
	
	ЦиклыОбмена 			= ДополнительныеПараметры.ЦиклыОбмена;
	ВыгружатьКонтейнеры 	= ДополнительныеПараметры.ВыгружатьКонтейнеры;
	ВыгружатьСодержимое 	= ДополнительныеПараметры.ВыгружатьСодержимое;
	
	// количество циклов обмена, по которым за один раз считывается информация из ИБ
	РазмерПорции = 10;
	
	// формируем представления циклов обмена
	ПредставленияЦикловОбмена = ПолучитьПредставленияЦикловОбмена(ЦиклыОбмена);
	
	ЧислоВыгруженныхФайлов = 0;
	ЧислоВыгруженныхЦикловОбмена = 0;
	
	МассивОписанийПолучаемыеФайлы = Новый Массив;
	
	ОбщееЧислоЦикловОбмена = ЦиклыОбмена.Количество();
	Пока ЧислоВыгруженныхЦикловОбмена < ОбщееЧислоЦикловОбмена Цикл
		
		// формируем текущую порцию циклов обмена
		ПорцияЦиклов = Новый Массив;
		Для Инд = ЧислоВыгруженныхЦикловОбмена + 1 По Мин(ЧислоВыгруженныхЦикловОбмена + РазмерПорции, ОбщееЧислоЦикловОбмена) Цикл
			ПорцияЦиклов.Добавить(ЦиклыОбмена[Инд - 1]);
		КонецЦикла;
		ЧислоВыгруженныхЦикловОбмена = ЧислоВыгруженныхЦикловОбмена + РазмерПорции;
		
		// получаем выгружаемые файлы
		ВыборкаМассив 	= ПолучитьВыгружаемыеФайлы(ПорцияЦиклов, ВыгружатьКонтейнеры, ВыгружатьСодержимое);
		ОбщееЧисло 		= ВыборкаМассив.Количество();
		
		Для СчетчикЦикла = 0 По ОбщееЧисло - 1 Цикл 
			
			ОбработкаПрерыванияПользователя();
			Выборка 		= ВыборкаМассив[СчетчикЦикла];
			ПолноеИмяФайла 	= СформироватьИмяФайла(Выборка.ИмяФайла);
			
			//заполняем МассивОписанийПолучаемыеФайлы
			АдресВоВременномХранилище = Выборка.Адрес;
			ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресВоВременномХранилище); 
			МассивОписанийПолучаемыеФайлы.Добавить(ОписаниеФайла);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПолучитьФайлыБезРасширенияРаботыСФайлами(МассивОписанийПолучаемыеФайлы);
	ПоказатьПредупреждение(, "Выгрузка завершена.");
	
КонецПроцедуры

#Область СформироватьПакетФСГС

&НаКлиенте
Процедура СформироватьПакетФСГС(ОповещениеОЗавершении, ТранспортноеСообщение, Оповещать = Ложь, ПараметрыОперации = Неопределено) Экспорт
	
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Оповещать);
	
	// общие проверки
	Если НЕ СформироватьПакетФСГС_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда // сервер
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись, КонтекстОтправки);
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;	
	
	// получение и проверки сертификатов
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФСГСПослеПроверкиИПолученияСертификатовПолучателя", ЭтотОбъект, Контекст);
		
	СформироватьПакетФСГС_ПолучитьИПроверитьСертификатыПолучателя(Оповещение, КонтекстОтправки); // клиент

КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГС_ПолучитьИПроверитьСертификатыПолучателя(ОповещениеОЗавершении, КонтекстОтправки)
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	Если ТипЗнч(КонтекстОтправки.СертификатПолучателя) <> Тип("Массив") Тогда
		Отпечатки = Новый Массив;
		Отпечатки.Добавить(КонтекстОтправки.СертификатПолучателя);
	Иначе
		Отпечатки = КонтекстОтправки.СертификатПолучателя;
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("Отпечатки", Отпечатки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФСГС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов", ЭтотОбъект, Контекст);
		
	СертификатыДляПоиска = Новый Массив;
	Для Каждого Отпечаток Из Отпечатки Цикл
		НовыйСертификат = Новый Структура("Отпечаток", Отпечаток);
		КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);	
	КонецЦикла;
	
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГС_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат.Выполнено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!'"), ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Результат.НенайденныеСертификаты.Количество() > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!'"), ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
		КонецЕсли;
	
	Если ТипЗнч(ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель) = Тип("СправочникСсылка.ОрганыФСГС") Тогда
		Для Каждого ОбъектСертификатОрганаФСГС Из Результат.Сертификаты Цикл				
			РезультатПроверкиСертификатаОрганаФСГС = ПроверитьСертификатПоПериоду(ОбъектСертификатОрганаФСГС);
			Если РезультатПроверкиСертификатаОрганаФСГС <> Истина Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка проверки сертификата органа ФСГС %1 с отпечатком %2.';
						|en = 'Ошибка проверки сертификата органа ФСГС %1 с отпечатком %2.'"),
					ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель, 
					ОбъектСертификатОрганаФСГС.Отпечаток);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
	КонецЕсли;
		КонецЦикла;
	
			// проверяем на наличие хотя бы одного сертификата
		Если Результат.Сертификаты.Количество() = 0 Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В свойствах органа ФСГС %1 не задан ни один сертификат.';
					|en = 'В свойствах органа ФСГС %1 не задан ни один сертификат.'"), ВходящийКонтекст.КонтекстОтправки.СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить("ОбъектСертификатПолучателя", Результат.Сертификаты);
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГСПослеПроверкиИПолученияСертификатовПолучателя(Результат, ВходящийКонтекст) Экспорт
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Результат Тогда
		// проверки на клиенте (сертификаты)
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетФСГСПослеПроверкиСертификатов", ЭтотОбъект, ВходящийКонтекст);
			
		СформироватьПакетФСГС_ПроверкиСертификатов(Оповещение, КонтекстОтправки);
	Иначе
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГС_ПроверкиСертификатов(ОповещениеОЗавершении, КонтекстОтправки)
	
	Если КонтекстОтправки.Свойство("ОбъектСертификатОтветственногоЗаШифрование") Тогда // возможна ситуация, когда сертификаты уже получены и проверены
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Истина);
		Возврат;
	КонецЕсли;
	
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	СертификатыДляПоиска = Новый Массив;
	
	ОтпечатокСертификатРуководителя = СокрЛП(КонтекстОтправки.СертификатРуководителя);
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатРуководителя) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат руководителя.';
				|en = 'В настройках учетной записи %1 не задан сертификат руководителя.'"), КонтекстОтправки.УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	Иначе
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатРуководителя);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатОтветственногоЗаШифрование) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат ответственного за шифрование.';
				|en = 'В настройках учетной записи %1 не задан сертификат ответственного за шифрование.'"), КонтекстОтправки.УчетнаяЗапись);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ложь);
		Возврат;
	ИначеЕсли ОтпечатокСертификатОтветственногоЗаШифрование <> ОтпечатокСертификатРуководителя Тогда
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатОтветственногоЗаШифрование);
		ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
			
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("ВыполнятьПроверку", Истина);
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФСГС_ПроверкиСертификатовПослеПолученияСертификатов", ЭтотОбъект, Контекст);
		
	КриптографияЭДКОКлиент.НайтиСертификаты(Оповещение, СертификатыДляПоиска, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГС_ПроверкиСертификатовПослеПолученияСертификатов(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат.Выполнено Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	ОтпечатокСертификатРуководителя = СокрЛП(КонтекстОтправки.СертификатРуководителя);
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	ОбъектСертификатРуководителя = Неопределено;
	ОбъектСертификатОтветственногоЗаШифрование = Неопределено;
	
	Для Каждого НайденныйСертификат Из Результат.Сертификаты Цикл
		Если ОтпечатокСертификатРуководителя = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатРуководителя = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатОтветственногоЗаШифрование = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатОтветственногоЗаШифрование = НайденныйСертификат;
	КонецЕсли;
	КонецЦикла;
	
	Если ОбъектСертификатРуководителя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат руководителя в системном хранилище сертификатов.';
								|en = 'Не удалось найти сертификат руководителя в системном хранилище сертификатов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Не ОбъектСертификатРуководителя.Валиден Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если ОтпечатокСертификатОтветственногоЗаШифрование = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат ответственного за шифрование в системном хранилище сертификатов.';
								|en = 'Не удалось найти сертификат ответственного за шифрование в системном хранилище сертификатов.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если Не ОбъектСертификатОтветственногоЗаШифрование.Валиден Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить("ОбъектСертификатРуководителя", ОбъектСертификатРуководителя);
	ВходящийКонтекст.ОповещениеОЗавершении.ДополнительныеПараметры.КонтекстОтправки.Вставить("ОбъектСертификатОтветственногоЗаШифрование", ОбъектСертификатОтветственногоЗаШифрование);
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СформироватьПакетФСГСПослеПроверкиСертификатов(Результат, ВходящийКонтекст) Экспорт	
			
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	
	// формируем файл описания сведений, если это первичное сообщение с отчетностью
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС") Тогда
		Если НЕ СформироватьОписаниеСведенийДляСообщенияФСГС(КонтекстОтправки) Тогда
			ТекстСообщения = НСтр("ru = 'Формирование пакета прервано.';
									|en = 'Формирование пакета прервано.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	Контекст.Вставить("ОповещениеОЗавершении", ВходящийКонтекст.ОповещениеОЗавершении);
	Контекст.Вставить("ПервыйВызов", Истина);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФСГСПослеПодписания", ЭтотОбъект, Контекст);
	СформироватьПакетФСГС_Подписание(Оповещение, КонтекстОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГС_Подписание(ОповещениеОЗавершении, КонтекстОтправки)
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется подписание пакета с документами..."); // ФСГС
		
	// генерируем подписи
	ПодписатьСообщение("ФСГС", ОповещениеОЗавершении, КонтекстОтправки,
		КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки.ТипСообщения,
		,, КонтекстОтправки.УчетнаяЗапись, КонтекстОтправки.СообщениеОснование);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГСПослеПодписания(Результат, ВходящийКонтекст) Экспорт
		
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;

	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС") Тогда
	
		// формируем файл описания письма, если его нет
		Если НЕ СформироватьОписаниеПисьмаДляСообщенияФСГС(КонтекстОтправки) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если КонтекстОтправки.ТипСообщения = ПредопределенноеЗначение("Перечисление.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС")
		И ВходящийКонтекст.ПервыйВызов Тогда
		// формируем подтверждение получения
		Если НЕ СформироватьИзвещениеОПолученииФСГС(КонтекстОтправки.ТранспортноеСообщение) Тогда
			ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
			Возврат;
		КонецЕсли;
		
		ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
		ВходящийКонтекст.Вставить("ПервыйВызов", Ложь);
		Оповещение = Новый ОписаниеОповещения(
			"СформироватьПакетФСГСПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
		СформироватьПакетФСГС_Подписание(Оповещение, ВходящийКонтекст.КонтекстОтправки);
	КонецЕсли;
	
	// формируем дерево описания документов пакета (сервер)
	Если НЕ СформироватьПакетФСГС_СформироватьОписаниеДокументовПакета(КонтекстОтправки) Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	РежимПодтвержденияОблачнойПодписи("СформироватьПакетФСГС", КонтекстОтправки.ТранспортноеСообщение, КонтекстОтправки);
	
	// отрабатываем отложенные команды на клиенте (шифрование)
	ВходящийКонтекст.Вставить("КонтекстОтправки", КонтекстОтправки);
	
	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетФСГСПослеВыполненияОтложенныхКомандНаКлиенте", ЭтотОбъект, ВходящийКонтекст);
	СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(Оповещение, КонтекстОтправки);
		
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетФСГСПослеВыполненияОтложенныхКомандНаКлиенте(Результат, ВходящийКонтекст) Экспорт
	
	Если Не Результат Тогда
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	// формируем файл описания пакета, создаем архив и помещаем в ИБ
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется запись состояния отправки в базу данных..."); // ФСГС
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	Если НЕ СформироватьПакетФСГС_ЗаключительныеДействияНаСервере(КонтекстОтправки) Тогда // универсальная
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	Если КонтекстОтправки.Оповещать Тогда
		Оповестить("Изменение сообщения", Новый Структура("Сообщение, ЦиклОбмена, Предмет",
														КонтекстОтправки.ТранспортноеСообщение,
														КонтекстОтправки.ЦиклОбмена));
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Истина);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ВыгрузитьПакетыПоДокументооборотамСдачиОтчетностиВФНСЗавершениеПослеПолученияКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами = ДополнительныеПараметры.ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами;
	Путь = ДополнительныеПараметры.Путь;
	
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами 
		И НЕ ЗначениеЗаполнено(Путь)
		И ВыбранныеФайлы = Неопределено Тогда
		
		// Путь сохранения не выбран
		Возврат;
		
	ИначеЕсли ВыбранныеФайлы <> Неопределено Тогда
		
		Путь = ВыбранныеФайлы[0] + 
			?(Прав(ВыбранныеФайлы[0], 1) = ПолучитьРазделительПути(), "", ПолучитьРазделительПути());
		ДополнительныеПараметры.Вставить("Путь", Путь);
		
	КонецЕсли;
	
	ЦиклыОбмена 			= ДополнительныеПараметры.ЦиклыОбмена;
	ОбщееКоличествоФайлов 	= ДополнительныеПараметры.ОбщееКоличествоФайлов;
	
	// количество циклов обмена, по которым за один раз считывается информация из ИБ
	РазмерПорции = 10;
	СоответствиеСообщенияКаталогу = Новый Соответствие;
	СоответствиеТипаСообщенияКраткомуПредставлению = ИнициализироватьСоответствиеТСКП();
	
	// формируем представления циклов обмена
	ПредставленияЦикловОбмена = ПолучитьПредставленияЦикловОбмена(ЦиклыОбмена);
	
	ЧислоВыгруженныхФайлов = 0;
	ЧислоВыгруженныхЦикловОбмена = 0;
	
	МассивОписанийПолучаемыеФайлы = Новый Массив;
	
	ОбщееЧислоЦикловОбмена = ЦиклыОбмена.Количество();
	Пока ЧислоВыгруженныхЦикловОбмена < ОбщееЧислоЦикловОбмена Цикл
		
		// формируем текущую порцию циклов обмена
		ПорцияЦиклов = Новый Массив;
		Для Инд = ЧислоВыгруженныхЦикловОбмена + 1 По Мин(ЧислоВыгруженныхЦикловОбмена + РазмерПорции, ОбщееЧислоЦикловОбмена) Цикл
			ПорцияЦиклов.Добавить(ЦиклыОбмена[Инд - 1]);
		КонецЦикла;
		ЧислоВыгруженныхЦикловОбмена = ЧислоВыгруженныхЦикловОбмена + РазмерПорции;
		
		// получаем выгружаемые файлы
		
		Пакеты = ПолучитьВыгружаемыеПакетыПоДокументооборотамСдачиОтчетностиВФНС(ПорцияЦиклов, УникальныйИдентификатор);
		
		// для каждого из выгружаемых файлов...
		Для Каждого СтрПакет Из Пакеты Цикл
			
			ОбработкаПрерыванияПользователя();
			
			СвойстваПакета = СтрПакет.Значение;
			Если ТипЗнч(СвойстваПакета) = Тип("Строка") Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СвойстваПакета);
				Продолжить;
			КонецЕсли;
			
			ИмяФайлаПакета = СвойстваПакета.ИмяФайла;
			АдресВоВременномХранилище = СвойстваПакета.Адрес;
			
			ЦиклОбмена = СтрПакет.Ключ;
			ПредставлениеЦиклаОбмена = ПредставленияЦикловОбмена[ЦиклОбмена];
			
			Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
				
				КаталогВыгрузки = Путь;
				КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
				КаталогВыгрузки = КаталогВыгрузки + СокрЛП(СформироватьИмяФайла(ПредставлениеЦиклаОбмена));
				КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
				
				// прорисовываем состояние в форме прогресса
				ЧислоВыгруженныхФайлов = ЧислоВыгруженныхФайлов + 1;
				Состояние(ПредставлениеЦиклаОбмена, ЧислоВыгруженныхФайлов / ОбщееКоличествоФайлов * 100);
								
				//заполняем МассивОписанийПолучаемыеФайлы
				ПолноеИмяФайла = КаталогВыгрузки + ИмяФайлаПакета;
			Иначе
				ПолноеИмяФайла = ИмяФайлаПакета;
			КонецЕсли;
			
			ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресВоВременномХранилище);
			МассивОписанийПолучаемыеФайлы.Добавить(ОписаниеФайла);
		
		КонецЦикла;
		
	КонецЦикла;
	
	ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(МассивОписанийПолучаемыеФайлы);
	
КонецПроцедуры

&НаКлиенте
Функция БраузерПоддерживаетРаботуСКомпонентойПечатиМашиночитаемыхБланков() Экспорт

	#Если ВебКлиент Тогда
		
		ВебБраузер = РегламентированнаяОтчетностьКлиент.ВебБраузер();
		
		Если ЗначениеЗаполнено(ВебБраузер)
		   И НЕ ВебБраузер = "MSIE" Тогда
		   
		    ПоказатьПредупреждение(, НСтр("ru = 'Внимание! Данная функция в Веб-клиенте поддерживается только в браузере Internet Explorer.';
											|en = 'Внимание! Данная функция в Веб-клиенте поддерживается только в браузере Internet Explorer.'"));
			Возврат Ложь;
			
		КонецЕсли;
		
	#КонецЕсли
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьФайлыБезРасширенияРаботыСФайлами(МассивОписаний) Экспорт
	
	Если МассивОписаний <> Неопределено Тогда
		Для каждого ОписаниеПолучаемогоФайла Из МассивОписаний Цикл
			ПолучитьФайл(ОписаниеПолучаемогоФайла.Хранение, ОписаниеПолучаемогоФайла.Имя, Истина);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭлектронногоПредставленияПослеСохраненияВФайл(Результат, ВходящийКонтекст) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		ПоказатьПредупреждение(,"Не удалось выгрузить электронное представление отчета во временный файл!" + Символы.ПС + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецЕсли;
	
	ВремФайл = Результат.ИмяФайла;
	
	СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВремФайл);
	ВремКаталог 		= СтруктураИмениФайла.Путь;
	
	ЭлектронноеПредставление 	= ВходящийКонтекст.ЭлектронноеПредставление;
	ВидОтчета 					= ВходящийКонтекст.ВидОтчета;
	АдресДанных					= ВходящийКонтекст.АдресДанных;
		
	// извлекаем параметры сформированного файла выгрузки
	СтруктураПараметров = СформироватьСтруктуруПараметровФайлаВыгрузки(АдресДанных);
	
	// пытаемся создать отчет заданного вида
	Если ЗначениеЗаполнено(ВидОтчета) Тогда
		#Если ВебКлиент Тогда 
			ИспользоватьКомпоненту = Истина;
		#Иначе
			ИспользоватьКомпоненту = Ложь;
		#КонецЕсли
		ВозниклаОшибка 	= Ложь;
		СоздатьОтчетЗаданногоВида(ЭлектронноеПредставление, СтруктураПараметров, ИспользоватьКомпоненту, ВозниклаОшибка);
		Если ВозниклаОшибка Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекущийНомерШаблона", 	0);
	ДополнительныеПараметры.Вставить("ВремКаталог", 			ВремКаталог);
	ДополнительныеПараметры.Вставить("ВремФайл", 				ВремФайл);
	 
	ПечатьЭлектронногоПредставленияСохранениеШаблоновОтчета(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭлектронногоПредставленияСохранениеШаблоновОтчета(Результат, ВходящийКонтекст) Экспорт
	
	ТекущийНомерШаблона 	= ВходящийКонтекст.ТекущийНомерШаблона;
	ВремКаталог 			= ВходящийКонтекст.ВремКаталог;
	ВремФайл 				= ВходящийКонтекст.ВремФайл;
	
	Если ТекущийНомерШаблона > ТаблицаШаблонов.Количество() - 1 Тогда
		
		// пытаемся создать объект для формирования машиночитаемой формы
		ТаксДокПринт = Неопределено;
		ТаксДокПринт = РегламентированнаяОтчетностьКлиент.СоздатьОбъектДляФормированияМашиночитаемойФормы();
		// если не удалось создать объект, то спрашиваем у пользователя, хочет ли он установить компоненту
		Если ТаксДокПринт = Неопределено Тогда
			
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Установить';
																|en = 'Установить'"));
			СписокКнопок.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена';
																|en = 'Отмена'"));
			
			ДополнительныеПараметры = Новый Структура("ТаксДокПринт, ВремКаталог, ВремФайл", ТаксДокПринт, ВремКаталог, ВремФайл);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПечатьЭлектронногоПредставленияВопросУстановитьКомпонентуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для формирования машиночитаемой формы необходимо установить%1библиотечный модуль печати двухмерного штрихкода PDF417.';
																											|en = 'Для формирования машиночитаемой формы необходимо установить%1библиотечный модуль печати двухмерного штрихкода PDF417.'"), Символы.ПС), СписокКнопок);
						
			Возврат;
			
		КонецЕсли;
		
		ПечатьЭлектронногоПредставленияПослеУстановкиКомпоненты(ТаксДокПринт, ВремКаталог, ВремФайл);
		
	Иначе
		
		ДанныеВыгрузки = ТаблицаШаблонов[ТекущийНомерШаблона];
		ПолноеИмяФайла = ВремКаталог + ДанныеВыгрузки.Имя;
		
		ТекущийНомерШаблона = ТекущийНомерШаблона + 1;
		ВходящийКонтекст.Вставить("ТекущийНомерШаблона", ТекущийНомерШаблона);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПечатьЭлектронногоПредставленияСохранениеШаблоновОтчета", 
			ЭтотОбъект, 
			ВходящийКонтекст);
			
		ОперацииСФайламиЭДКОКлиент.ДанныеССервераВФайл(ОписаниеОповещения, ДанныеВыгрузки.АдресСодержимого, ПолноеИмяФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаПослеВыбораФайлов(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ФайлыБылиВыбраны = Ложь;
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ФайлыБылиВыбраны = Истина;
		ДополнительныеПараметры.Вставить("ВыбранныеФайлы", ВыбранныеФайлы);
		ПолучениеФайловДляИмпортаПослеПомещенияФайла(ФайлыБылиВыбраны, "", "", ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловДляИмпортаПослеОпределенияСвойствОсновногоФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат.Выполнено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнойФайлНаДиске = Результат.СвойстваФайла;
	ДополнительныеПараметры.Вставить("ОсновнойФайлНаДиске", ОсновнойФайлНаДиске);
	
	ВыбранныеФайлы 		= ДополнительныеПараметры.ВыбранныеФайлы;
	КонтекстЭДОКлиент 	= ДополнительныеПараметры.КонтекстЭДОКлиент;
	
	ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках = КонтекстЭДОКлиент.ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках(ОсновнойФайлНаДиске.Имя);
	ДополнительныеПараметры.Вставить("ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках", ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках);
	
	Если ВыбранныеФайлы.Количество() = 1 Тогда
		
		МаксимальныйРазмер = МаксимальныйРазмерФайлаУведомленияОКонтролируемыхСделках();
		
		Если ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках
			И ОсновнойФайлНаДиске.Размер > МаксимальныйРазмер Тогда
			
			РазмерВМб = Цел(МаксимальныйРазмер/1024/1024);
			ТекстСообщения = НСтр("ru = 'Согласно требованиям ФНС файл формата 5.01 больше %2 Мб должен быть разбит на файлы формата 5.02.%1Загрузить файл с разбивкой?';
									|en = 'Согласно требованиям ФНС файл формата 5.01 больше %2 Мб должен быть разбит на файлы формата 5.02.%1Загрузить файл с разбивкой?'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", Символы.ПС);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2", Строка(РазмерВМб));
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Да", "Да");
			Кнопки.Добавить("Нет", "Нет");
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПолучениеФайловПослеВопросаОРазбиенииФайла", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, Кнопки);
		Иначе
			ПолучениеФайловПослеВопросаОРазбиенииФайла("Нет", ДополнительныеПараметры);
		КонецЕсли;
	Иначе
		ПолучениеФайловПослеВопросаОРазбиенииФайла("Нет", ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловПослеВопросаОРазбиенииФайла(Ответ, ДополнительныеПараметры) Экспорт
	
	КонтекстЭДОКлиент = ДополнительныеПараметры.КонтекстЭДОКлиент;
	
	Если Ответ = "Да" Тогда
		ДополнительныеПараметры.Вставить("ВыполнитьРазделениеФайла", 				Истина);
		ДополнительныеПараметры.Вставить("ВыполнятьПроверкуКомплектаУведомлений", 	Ложь);
	Иначе
		ДополнительныеПараметры.Вставить("ВыполнитьРазделениеФайла", 				Ложь);
		Если ДополнительныеПараметры.ЭтоФайлВыгрузкиУведомленияОКонтролируемыхСделках Тогда
			ДополнительныеПараметры.Вставить("ВыполнятьПроверкуКомплектаУведомлений", Истина);
		Иначе
			ДополнительныеПараметры.Вставить("ВыполнятьПроверкуКомплектаУведомлений", Ложь);
		КонецЕсли;
		РезультатИмпорта = Ложь;
	КонецЕсли;

	ОсновнойФайлНаДиске 									= ДополнительныеПараметры.ОсновнойФайлНаДиске;
	ВыбранныеФайлы 											= ДополнительныеПараметры.ВыбранныеФайлы;
	ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами 	= ДополнительныеПараметры.ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами;
	
	Если ВыбранныеФайлы = Неопределено Тогда
		ПолучениеФайловДляИмпортаЗавершение(Ложь, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;

	// составляем массив с объектами Файл
	Если ПоддерживаетсяИспользованиеРасширенияРаботыСФайлами Тогда
		МассивФайлов = Новый Массив;
		Для Каждого ЭлФайл Из ВыбранныеФайлы Цикл
			Файл = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ЭлФайл);
			МассивФайлов.Добавить(Новый Структура("Имя, ПолноеИмя, Расширение, АдресДанных", Файл.Имя, Файл.ПолноеИмя, Файл.Расширение));
		КонецЦикла;
		
		ПомещаемыеФайлы = Новый Массив;
		Для Каждого ЭлФайл Из МассивФайлов Цикл 
			ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ЭлФайл.ПолноеИмя); 
			ПомещаемыеФайлы.Добавить(ОписаниеФайла);
		КонецЦикла;
		
		ДополнительныеПараметры.Вставить("МассивФайлов", МассивФайлов);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПолучениеФайловПослеПомещенияФайлов", 
			ЭтотОбъект, 
			ДополнительныеПараметры);
		
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы, Ложь, Новый УникальныйИдентификатор);
		
	Иначе
		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить(Новый Структура("Имя, ПолноеИмя, Расширение, АдресДанных", 
			ОсновнойФайлНаДиске.Имя, ОсновнойФайлНаДиске.ПолноеИмя, ОсновнойФайлНаДиске.Расширение, ОсновнойФайлНаДиске.АдресДанных));
		РезультатИмпорта = Истина;
		
		ДополнительныеПараметры.Вставить("ФайлыДляИмпорта", МассивФайлов);
		ПолучениеФайловДляИмпортаЗавершение(РезультатИмпорта, ДополнительныеПараметры);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеФайловПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныеФайлы = Неопределено Тогда
		РезультатИмпорта = Ложь;
	Иначе
		
		МассивФайлов = ДополнительныеПараметры.МассивФайлов;
		
		Для каждого ЭлФайл Из МассивФайлов Цикл
			Для каждого ОписаниеПереданногоФайла Из ПомещенныеФайлы Цикл
				Если ОписаниеПереданногоФайла.ПолноеИмя = ЭлФайл.ПолноеИмя Тогда
					ЭлФайл.АдресДанных = ОписаниеПереданногоФайла.Хранение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		РезультатИмпорта = Истина;
	КонецЕсли;
		
	ДополнительныеПараметры.Вставить("ФайлыДляИмпорта", МассивФайлов);
	ПолучениеФайловДляИмпортаЗавершение(РезультатИмпорта, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПакетПФР_Подписание(ОповещениеОЗавершении, КонтекстОтправки, ПараметрыОперации = Неопределено)

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ДлительнаяОтправкаКлиент.ВывестиСостояние("Выполняется подписание пакета с документами..."); // ПФР
		
	Если ПараметрыОперации <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КонтекстОтправки, ПараметрыОперации, Истина);
	КонецЕсли;	
	
	// генерируем подписи
	ПодписатьСообщение(
		"ПФР", 
		ОповещениеОЗавершении, 
		КонтекстОтправки,
		КонтекстОтправки.ТранспортноеСообщение, 
		КонтекстОтправки.ТипСообщения,
		,
		,
		КонтекстОтправки.УчетнаяЗапись, 
		КонтекстОтправки.СообщениеОснование);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТранспортнуюИнформациюДляСообщенияПослеВыполнения(Результат, ВходящийКонтекст) Экспорт

	// Внимание!
	// ---------
	// В модуле объекта есть одноименная процедура, которая используется при отправке отчетов
	// из мобильной бухгалтерии без взаимодействия с клиентским контекстом.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если Не Результат Тогда
		ТекстСообщения = НСтр("ru = 'Формирование пакета прервано.';
								|en = 'Формирование пакета прервано.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	КонтекстОтправки = ВходящийКонтекст.КонтекстОтправки;
	МестоХраненияКлюча = КонтекстМоделиХраненияКлюча(КонтекстОтправки);
	
	ПараметрыОперации = Неопределено;
	Если ЭтоОблачнаяПодпись(МестоХраненияКлюча) Тогда
		ПараметрыОперации = Новый Структура("ТребуетПодтверждениОперации", Ложь);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"СформироватьПакетПФРПослеПодписания", ЭтотОбъект, ВходящийКонтекст);
	СформироватьПакетПФР_Подписание(Оповещение, КонтекстОтправки, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСообщенияПакетноПослеВыполнения(РезультатВыполнения, ВходящийКонтекст) Экспорт
	
	Если РезультатВыполнения.Выполнено Тогда
		
		КонтекстОтправки = ВходящийКонтекст.ПараметрыФункции.КонтекстОтправки;
		ЭДОК = СвойствоСтруктуры(КонтекстОтправки, "ФорматДокументооборота") = ПредопределенноеЗначение("Перечисление.ФорматыДокументооборотаСПФР.ЭДОК");

		Оповещение = Новый ОписаниеОповещения(
			"ПодписатьСообщенияПоследовательноПослеЧтенияДанныхИзФайла", ЭтотОбъект, ВходящийКонтекст);
		
		Для Счетчик = 0 По РезультатВыполнения.Результат.ВГраница() Цикл
			Подпись = РезультатВыполнения.Результат[Счетчик];
			Если ЭДОК Тогда
				ИмяФайлаПодписи = "." + СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент(".sig");
			Иначе
				ИмяФайлаПодписи = СгенерироватьИмяФайлаДокументаВСоставеПакетаКлиент();
			КонецЕсли;
			
			ДанныеПодписи = ПолучитьИзВременногоХранилища(Подпись);
			ДанныеПодписи = Base64Строка(ДанныеПодписи);
			ВходящийКонтекст.ДокументыДляПодписывания[Счетчик].Вставить("ИмяФайлаПодписи", ИмяФайлаПодписи);	
			ВходящийКонтекст.ДокументыДляПодписывания[Счетчик].Вставить("ДанныеПодписи", ДанныеПодписи);	
		КонецЦикла;	
		
		Для Каждого СтрокаМассива Из ВходящийКонтекст.ДокументыДляПодписывания Цикл
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
				ВходящийКонтекст.ПараметрыФункции.Сообщение,
				СтруктураСсылочныхДанных.Перечисления_ТипыСодержимогоТранспортногоКонтейнера_ЭлектронноЦифроваяПодпись,
				Новый Структура("Строка64", СтрокаМассива.ДанныеПодписи),
				ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СтрокаМассива.ИмяФайлаПодписи).Имя,,
				СтрокаМассива.ИмяФайла,
				СтрокаМассива.Сертификат.Отпечаток,
				СтруктураСсылочныхДанных.Перечисления_СтатусыПроверкиЭЦП_Валидна,
				Истина) Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка добавления содержимого транспортного контейнера ""%1""';
						|en = 'Ошибка добавления содержимого транспортного контейнера ""%1""'"),
					СтрокаМассива.ИмяФайла);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		ВыполнитьОбработкуОповещения(
			ВходящийКонтекст.ОповещениеОЗавершении,
			Истина);
		
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка подписания документа: %1.
					   |По причине: %2';
					   |en = 'Ошибка подписания документа: %1.
					   |По причине: %2'"), 
			ПредставлениеТранспортногоСообщения(ВходящийКонтекст.ПараметрыФункции.Сообщение), 
			РезультатВыполнения.Ошибка);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ВходящийКонтекст.ОповещениеОЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТранспортноеСообщениеЗашифрованоДляТекущегоПользователя(ТранспортноеСообщение)
	
	МассивВладельцев = Мультирежим.ВладельцыТранспортногоСообщения(ТранспортноеСообщение);
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Возврат МассивВладельцев.Количество() = 0 ИЛИ МассивВладельцев.Найти(ТекущийПользователь) <> Неопределено;
	
КонецФункции

