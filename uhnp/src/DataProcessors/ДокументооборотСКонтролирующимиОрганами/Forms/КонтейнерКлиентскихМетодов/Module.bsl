&НаКлиенте
Процедура ПодставитьВыборВСтроку(Шаблон, Знач Варианты, Знач ИдВарианта)
	
	ВсеВарианты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Варианты, "|");
	
	Части = Новый Массив;
	Вариант = ВсеВарианты.Получить(ИдВарианта);
	Вхождений = СтрЧислоВхождений(Вариант, "%");
	Если Вхождений = 0 Тогда 
		Части.Добавить(Вариант);
		Для Сч = 0 по 8 Цикл 
			Части.Добавить("");
		КонецЦикла;
	Иначе
		ЧастиВарианта = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Вариант, "%");
		Части.Добавить(ЧастиВарианта[0]);
		Для Сч = 0 по 8 Цикл 
			Части.Добавить(?(Вхождений > Сч, ЧастиВарианта[Сч + 1], ""));
		КонецЦикла;
	КонецЕсли;	
	
	Для Сч = 0 по Части.Количество()-1 Цикл 
		Шаблон = СтрЗаменить(Шаблон, "%" + Строка(Сч), Части[Сч]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьУведомлениеАрхивныхФайлов(Знач ОповещениеЗавершения = Неопределено, Знач ИдВарианта = 1, Знач ИдДействия = 0, Знач КонечноеСостояние = Истина, Знач Предварительное = Истина) Экспорт
	
	//Варианты добавлять только в конец
	Варианты = " выписки| квитанции| сверки| справки| подписи| извещения| уведомления| сообщения| подтверждения| вложения|"; //0-9
	Варианты = Варианты + " документа| скан-копии документа|ы скан-копий документа%и%ы| отчета| пакета|"; //10-14
	Варианты = Варианты + " зашифрованного пакета| протокола| объекта|ы некоторых вложений%и%ы|ы всех вложений%и%ы|"; //15-19
	Варианты = Варианты + " выгрузки| документа описи|ы некоторых документов описи%и%ы|ы всех документов описи%и%ы| загруженного отчета|"; //20-24
	Варианты = Варианты + " контейнера|ы контейнеров%и%ы| приложения|ы приложений%и%ы|"; //25-
	Варианты = Варианты + " подписанного отчета| зашифрованной квитанции";
	
	Часть0 = "Файл%0 был%1 ранее перемещен%2 в архив.";
	ПодставитьВыборВСтроку(Часть0, Варианты, ИдВарианта);
		
	Если КонечноеСостояние Тогда 
		ВариантыДействия = "Выгрузка%на|Копирование%но|Отправка%на|Просмотр%ен|Запись%на|Печать%на|Изменение%но|Удаление%но";
		Часть1 = Символы.ПС + "%0 содержимого невозмож%1.";
	Иначе
		Если Предварительное Тогда
			ВариантыДействия = "Выгрузить|Копировать|Отправить|Просмотреть|Записать|Печатать|Изменить|Удалить";
			Часть1 = Символы.ПС + "%0 только неархивированное содержимое?";
		Иначе
			ВариантыДействия = "Выгружено|Скопировано|Отправлено|Просмотрено|Записано|Напечатано|Изменено|Удалено";
			Часть1 = Символы.ПС + "%0 только неархивированное содержимое.";
		КонецЕсли;
	КонецЕсли;
	ПодставитьВыборВСтроку(Часть1, ВариантыДействия, ИдДействия);
	
	СтрокаСсылки = Новый ФорматированнаяСтрока("Подробнее об архивировании файлов",,,, "https://its.1c.ru/db/elreps#content:59:hdoc");
	Часть2 = Новый ФорматированнаяСтрока(Символы.ПС, Символы.ПС, СтрокаСсылки);

	ПолныйТекстУведомления = Новый ФорматированнаяСтрока(Часть0, Часть1, Часть2);
	
	ВхПараметры = Новый Структура("ОповещениеЗавершения", ОповещениеЗавершения);
		
	Если КонечноеСостояние Или Не Предварительное Тогда 
		Оповещение = Новый ОписаниеОповещения("ПоказатьУведомлениеАрхивныхФайловПослеПредупреждения", ЭтотОбъект, ВхПараметры);
		ПоказатьПредупреждение(Оповещение, ПолныйТекстУведомления);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПоказатьУведомлениеАрхивныхФайловПослеВопроса", ЭтотОбъект, ВхПараметры);
		ПоказатьВопрос(Оповещение, ПолныйТекстУведомления, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьУведомлениеАрхивныхФайловПослеПредупреждения(ВхПараметры) Экспорт

