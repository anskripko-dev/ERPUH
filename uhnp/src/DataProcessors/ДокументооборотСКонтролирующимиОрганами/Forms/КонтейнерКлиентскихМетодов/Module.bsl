&НаКлиенте
Процедура ПоказатьПодтверждениеПолученияФСГС(ЦиклОбмена, ТранспортноеСообщение, ИмяФайлаДокумента, ПечатьВозможна = Ложь) Экспорт
	
	Результат = ПолучитьАдресВложения(ТранспортноеСообщение, ИмяФайлаДокумента);
	Если Результат.Свойство("Предупреждение") Тогда 
		ПоказатьПредупреждение(,Результат.Предупреждение);
		Возврат;
	Иначе 
		Адрес = Результат.Адрес;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Если ЗначениеЗаполнено(ТранспортноеСообщение) Тогда 
		СтруктураПараметров.Вставить("Сообщение", ТранспортноеСообщение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяФайлаДокумента) Тогда 
		СтруктураПараметров.Вставить("ИмяФайла", ИмяФайлаДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) Тогда 
		СтруктураПараметров.Вставить("ПодтверждениеПолучения", Адрес);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЦиклОбмена", ЦиклОбмена);
	СтруктураПараметров.Вставить("ПечатьВозможна", Истина);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрПодтвержденияПолученияФСГС", СтруктураПараметров, );

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколФСГС(ЦиклОбмена, ТранспортноеСообщение, ИмяФайлаДокумента, ПечатьВозможна = Ложь) Экспорт
	
	Результат = ПолучитьАдресВложения(ТранспортноеСообщение, ИмяФайлаДокумента);
	Если Результат.Свойство("Предупреждение") Тогда
		ПоказатьПредупреждение(,Результат.Предупреждение);
		Возврат;
	Иначе 
		Адрес = Результат.Адрес;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	Если ЗначениеЗаполнено(ТранспортноеСообщение) Тогда
		СтруктураПараметров.Вставить("СообщениеПротокол", ТранспортноеСообщение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяФайлаДокумента) Тогда 
		СтруктураПараметров.Вставить("ИмяФайла", ИмяФайлаДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) Тогда 
		СтруктураПараметров.Вставить("Протокол", Адрес);
	КонецЕсли;
	СтруктураПараметров.Вставить("ЦиклОбмена", ЦиклОбмена);
	СтруктураПараметров.Вставить("ПечатьВозможна", ПечатьВозможна);
	
	ОткрытьФорму(ПутьКОбъекту + ".Форма.ПросмотрПротоколаФСГС", СтруктураПараметров, );
	
КонецПроцедуры

