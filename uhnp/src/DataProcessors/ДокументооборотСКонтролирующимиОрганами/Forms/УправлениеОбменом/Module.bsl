&НаКлиенте
Процедура ТаблицаОтправкиОтчетностьФССВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаОтправкиОтчетностьФССКолонка1" Тогда
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Поле.Имя = "ТаблицаОтправкиОтчетностьФССКолонка2" Тогда
		КонтекстЭДОКлиент.ПоказатьПротоколОбработкиПоСсылкеИсточникаДляФСС(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьОтчетностьФСС(Команда)
	
	ТаблицаФормыОбновить(Элементы.ТаблицаОтправкиОтчетностьФСС);
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельОтправкиНайтиОтчетФССВСписке(Команда)
	
	Если Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки.Количество() > 0 Тогда
		
		ОбъектФСС = ПолучитьСсылкуНаРеквизит(Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки[0], "ОтчетСсылка");
		
		ТипЗнчОбъектФСС = ТипЗнч(ОбъектФСС);
		Если ТипЗнчОбъектФСС = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			НачатьЗамерВремени();
			ОткрытьФорму("Обработка.ОбщиеОбъектыРеглОтчетности.Форма.УправлениеОтчетностью");
		ИначеЕсли ТипЗнчОбъектФСС = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
			СтруктураПараметров = Новый Структура("ТекущаяСтрока", ОбъектФСС);
			ОткрытьФорму("Справочник.ЭлектронныеПредставленияРегламентированныхОтчетов.ФормаСписка", СтруктураПараметров);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельОтправкиРегламентированныйОтчетФСС(Команда)
	
	Если Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки.Количество() > 0 Тогда
		ОбъектФСС = ПолучитьСсылкуНаРеквизит(Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки[0], "ОтчетСсылка");
		ПоказатьЗначение(, ОбъектФСС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СодержимоеОтправкиФССВоВременномХранилищеНаСервере(РежимВыгрузки, СсылкаНаОбъектОтправкиФСС)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресВоВременномХранилище", Неопределено);
	Результат.Вставить("ИмяФайлаДляКлиента", 		"");
	Результат.Вставить("ВидОтчета", 				СсылкаНаОбъектОтправкиФСС["ВидОтчета"]);
	
	Если РежимВыгрузки = 0 Тогда
		СсылкаНаСодержимое = СсылкаНаОбъектОтправкиФСС["ЗашифрованныйПакет"];
		Результат.ИмяФайлаДляКлиента = СсылкаНаОбъектОтправкиФСС["ИмяФайлаПакета"];
	ИначеЕсли РежимВыгрузки = 1 Тогда
		ЭтоПодтверждениеВидаДеятельности = (Результат.ВидОтчета =
			Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
		ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (Результат.ВидОтчета =
			Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам);
		СсылкаНаСодержимое = СсылкаНаОбъектОтправкиФСС["Квитанция"];
		Результат.ИмяФайлаДляКлиента = СсылкаНаОбъектОтправкиФСС["ИдентификаторОтправкиНаСервере"]
			+ ?(ЭтоПодтверждениеВидаДеятельности ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам, ".xml", ".p7e");
	ИначеЕсли РежимВыгрузки = 2 Тогда
		СсылкаНаСодержимое = СсылкаНаОбъектОтправкиФСС["Протокол"];
		Результат.ИмяФайлаДляКлиента = НСтр("ru = 'Протокол';
											|en = 'Протокол'")
			+ "_" + СсылкаНаОбъектОтправкиФСС["ИдентификаторОтправкиНаСервере"] + ".html";
	ИначеЕсли РежимВыгрузки = 3 Тогда
		СсылкаНаСодержимое = СсылкаНаОбъектОтправкиФСС["ПодписанныйПакет"];
		Результат.ИмяФайлаДляКлиента = СсылкаНаОбъектОтправкиФСС["ИмяФайлаПакета"];
	ИначеЕсли РежимВыгрузки = 4 Тогда
		СсылкаНаСодержимое = СсылкаНаОбъектОтправкиФСС["ПакетКвитанции"];
		Результат.ИмяФайлаДляКлиента = НСтр("ru = 'Зашифрованная_квитанция';
											|en = 'Зашифрованная_квитанция'")
			+ "_" + СсылкаНаОбъектОтправкиФСС["ИдентификаторОтправкиНаСервере"] + ".xml";;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Если СсылкаНаСодержимое = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Содержимое = СсылкаНаСодержимое.Получить();
	Если Содержимое = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если РежимВыгрузки = 2 Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ВременныйФайл = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
		ВременныйФайл.Записать(Содержимое);
		ВременныйФайл.Закрыть();
		Содержимое = Новый ДвоичныеДанные(ИмяВременногоФайла);
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Результат.АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Содержимое, Новый УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьСодержимоеОтправкиФСС(РежимВыгрузки)
	
	КоличествоВыделенныхСтрок = Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки.Количество();
	Если КоличествоВыделенныхСтрок <= 0 Тогда
		ТекстПредупреждения = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Не выбраны отправки ФСС!';
				|en = 'Не выбраны отправки ФСС!'"), Истина);
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	СодержимоеОтправки = СодержимоеОтправкиФССВоВременномХранилищеНаСервере(
		РежимВыгрузки,
		Элементы.ТаблицаОтправкиОтчетностьФСС.ВыделенныеСтроки[0]);
	АдресВоВременномХранилище 	= СодержимоеОтправки.АдресВоВременномХранилище;
	ИмяФайла 					= СодержимоеОтправки.ИмяФайлаДляКлиента;
	ВидОтчетаОтправки 			= СодержимоеОтправки.ВидОтчета;
	
	Если РежимВыгрузки = 0 Тогда
		
		Если АдресВоВременномХранилище = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Зашифрованный пакет отсутствует.';
											|en = 'Зашифрованный пакет отсутствует.'"));
			Возврат;
		КонецЕсли;
		ТекстЗаголовка = НСтр("ru = 'Выберите каталог для выгрузки отправленного пакета';
								|en = 'Выберите каталог для выгрузки отправленного пакета'");
		
	ИначеЕсли РежимВыгрузки = 1 Тогда
		
		Если АдресВоВременномХранилище = Неопределено Тогда
			ЭтоПодтверждениеВидаДеятельности = (ВидОтчетаОтправки =
				ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности"));
			ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ВидОтчетаОтправки =
				ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам"));
			ПоказатьПредупреждение(, ?(ЭтоПодтверждениеВидаДеятельности
				ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
				НСтр("ru = 'Квитанция отсутствует.';
					|en = 'Квитанция отсутствует.'"), НСтр("ru = 'Квитанция об успехе отсутствует.';
															|en = 'Квитанция об успехе отсутствует.'")));
			Возврат;
		КонецЕсли;
		ТекстЗаголовка = НСтр("ru = 'Выберите каталог для выгрузки полученной квитанции';
								|en = 'Выберите каталог для выгрузки полученной квитанции'");
		
	ИначеЕсли РежимВыгрузки = 2 Тогда
		
		Если АдресВоВременномХранилище = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Протокол обработки отсутствует.';
											|en = 'Протокол обработки отсутствует.'"));
			Возврат;
		КонецЕсли;
		ТекстЗаголовка = НСтр("ru = 'Выберите каталог для выгрузки полученного протокола обработки';
								|en = 'Выберите каталог для выгрузки полученного протокола обработки'");
		
	ИначеЕсли РежимВыгрузки = 3 Тогда
		
		Если АдресВоВременномХранилище = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Отчет с подписью отсутствует.';
											|en = 'Отчет с подписью отсутствует.'"));
			Возврат;
		КонецЕсли;
		ТекстЗаголовка = НСтр("ru = 'Выберите каталог для выгрузки отправленного отчета с подписью';
								|en = 'Выберите каталог для выгрузки отправленного отчета с подписью'");
		
	ИначеЕсли РежимВыгрузки = 4 Тогда
		
		Если АдресВоВременномХранилище = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Зашифрованная квитанция отсутствует.';
											|en = 'Зашифрованная квитанция отсутствует.'"));
			Возврат;
		КонецЕсли;
		ТекстЗаголовка = НСтр("ru = 'Выберите каталог для выгрузки полученной зашифрованной квитанции';
								|en = 'Выберите каталог для выгрузки полученной зашифрованной квитанции'");
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФайла = КонтекстЭДОКлиент.СформироватьИмяФайла(ИмяФайла);
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресВоВременномХранилище);
	МассивОписанийПолучаемыхФайлов = Новый Массив;
	МассивОписанийПолучаемыхФайлов.Добавить(ОписаниеФайла);
	
	ОперацииСФайламиЭДКОКлиент.СохранитьФайлы(МассивОписанийПолучаемыхФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаУведомленияПриАктивизацииСтроки(Элемент)
	
	Если Элемент.Видимость Тогда
		Если ЦиклыОбменаУведомления.Параметры.Элементы.Найти(Новый ПараметрКомпоновкиДанных("СсылкаДляОтбора")) <> Неопределено Тогда
			ЦиклыОбменаУведомления.Параметры.УстановитьЗначениеПараметра("СсылкаДляОтбора", Элементы.ТаблицаУведомления.ТекущаяСтрока);
		КонецЕсли;
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьУведомления(Команда)
	ТаблицаФормыОбновить(Элементы.ТаблицаУведомления);
	Если Элементы.ТаблицаЦиклыОбменаУведомления.Видимость Тогда 
		Элементы.ТаблицаЦиклыОбменаУведомления.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УведомленияОтображатьСписокЦикловОбмена(Команда)
	Элементы.ТаблицаУведомленияКнопкаОтображатьСписокЦикловОбмена.Пометка = НЕ Элементы.ТаблицаУведомленияКнопкаОтображатьСписокЦикловОбмена.Пометка;
	Элементы.ТаблицаЦиклыОбменаУведомления.Видимость = Элементы.ТаблицаУведомленияКнопкаОтображатьСписокЦикловОбмена.Пометка;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СуществуетРегламентированныйОтчетРозничныеЦеныНаТабак()
	Если Метаданные.Отчеты.Найти("РегламентированныйОтчетРозничныеЦеныНаТабак") <> Неопределено Тогда
		Возврат Истина;
	Иначе
