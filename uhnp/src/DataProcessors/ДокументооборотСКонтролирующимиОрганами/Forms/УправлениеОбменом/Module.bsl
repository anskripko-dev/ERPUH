	// Добавляем в запрос для динамического списка запрос по документу РегламентированныйОтчет
	// с источником РегламентированныйОтчетПрослеживаемыеТоварыПеремещение.
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыПеремещение()
		И Вид = "ПрослеживаемыеТоварыПеремещение" Тогда
		
		ТекстЗапроса = ТекстЗапроса + ТекстЗапросаДляОтчетовНаЗакладкеИсходящиеУведомления(
			"РегламентированныйОтчетПрослеживаемыеТоварыПеремещение");
		Уведомления.ОсновнаяТаблица = "Документ.РегламентированныйОтчет";
	КонецЕсли;
	
	// Добавляем в запрос для динамического списка запрос по документу РегламентированныйОтчет
	// с источником РегламентированныйОтчетПрослеживаемыеТоварыОстатки.
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыОстатки()
		И Вид = "ПрослеживаемыеТоварыОстатки" Тогда
		
		ТекстЗапроса = ТекстЗапроса + ТекстЗапросаДляОтчетовНаЗакладкеИсходящиеУведомления(
			"РегламентированныйОтчетПрослеживаемыеТоварыОстатки");
		Уведомления.ОсновнаяТаблица = "Документ.РегламентированныйОтчет";
	КонецЕсли;
	
	Уведомления.ТекстЗапроса = ТекстЗапроса;
	Уведомления.ДинамическоеСчитываниеДанных = Истина;
	
	// Установка параметров запроса динамического списка.
	Если Уведомления.Параметры.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ВидУведомления")) <> Неопределено Тогда
		МассивВидовУведомлений = ВидыПрочихОтправляемыхУведомлений(Истина);
		Уведомления.Параметры.УстановитьЗначениеПараметра("ВидУведомления", МассивВидовУведомлений);
	КонецЕсли;
	
	Если Вид = "Файлы" Тогда
		
		// Типы уведомлений.
		ТипыУведомлений = Новый Массив;
		ТипыУведомлений.Добавить(Перечисления.ТипыОтправляемыхДокументов.УведомлениеОКонтролируемыхСделках);
		ТипыУведомлений.Добавить(Перечисления.ТипыОтправляемыхДокументов.ИсходящееУведомлениеФНС);
		ТипыУведомлений.Добавить(Перечисления.ТипыОтправляемыхДокументов.УведомлениеОРозничныхЦенахНаТабак);
		
		Уведомления.Параметры.УстановитьЗначениеПараметра("ТипыУведомлений", ТипыУведомлений);
		
		// Виды уведомлений.
		ВидыУведомлений = ДокументооборотСКОКлиентСервер.ВидыОтправляемыхДокументовРеестровНДС();
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.РеестрНДСДокументыДляКомпенсацииНалога);
		ВидыУведомленийРеестровАкцизов = ДокументооборотСКОКлиентСервер.ВидыОтправляемыхДокументовРеестровАкцизов();
		Для каждого ВидУведомленияРеестраАкцизов Из ВидыУведомленийРеестровАкцизов Цикл
			ВидыУведомлений.Добавить(ВидУведомленияРеестраАкцизов);
		КонецЦикла;
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.СтрановойОтчет);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.УчастиеВМеждународнойГруппеКомпаний);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ДоходыОтДеятельностиМузеяТеатраБиблиотеки);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ДвижениеСредствПоСчетуВБанкеЗаПределамиРФ);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ДвижениеСредствНерезидентаЗаПределамиРФ);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ФинОтчетностьМГК);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ДеятельностьИнОргВРФ);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ПрослеживаемыеТоварыОтчетОбОперациях);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ПрослеживаемыеТоварыВвоз);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ПрослеживаемыеТоварыПеремещение);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ПрослеживаемыеТоварыОстатки);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.УведомлениеОбОстаткахПрослеживаемыхТоваров);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.УведомлениеОВвозеПрослеживаемыхТоваров);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.УведомлениеОПеремещенииПрослеживаемыхТоваров);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.СведенияОДоходахСотрудникаДляСоцВыплат);
		ВидыУведомлений.Добавить(Справочники.ВидыОтправляемыхДокументов.ДокументацияПоКонтролируемымСделкам);
		Уведомления.Параметры.УстановитьЗначениеПараметра("ВидыУведомлений", ВидыУведомлений);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаДляОтчетовНаЗакладкеИсходящиеУведомления(ИсточникОтчета)
	
	МассивИсточниковОтчетов = ?(ТипЗнч(ИсточникОтчета) = Тип("Массив")
		ИЛИ ТипЗнч(ИсточникОтчета) = Тип("ФиксированныйМассив"),
		ИсточникОтчета, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИсточникОтчета));
	
	КоличествоИсточниковОтчетов = МассивИсточниковОтчетов.Количество();
	ТекстОтбораПоИсточникамОтчетов = "";
	Для ИндексИсточникаОтчета = 0 По КоличествоИсточниковОтчетов - 1 Цикл
		ТекстОтбораПоИсточникамОтчетов = ТекстОтбораПоИсточникамОтчетов + ?(ЗначениеЗаполнено(ТекстОтбораПоИсточникамОтчетов), "
			|	ИЛИ ", "") + "РегламентированныйОтчет.ИсточникОтчета ПОДОБНО ""%_ИсточникОтчета"
			+ ?(ИндексИсточникаОтчета > 0, Формат(ИндексИсточникаОтчета + 1, "ЧДЦ=; ЧН=; ЧГ="), "") + "_%""";
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ
	                |	ВЫБОР
	                |		КОГДА РегламентированныйОтчет.ПометкаУдаления
	                |			ТОГДА ВЫБОР
	                |					КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Отправлен)
	                |						ТОГДА 10
	                |					ИНАЧЕ ВЫБОР
	                |							КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Доставлен)
	                |								ТОГДА 11
	                |							ИНАЧЕ ВЫБОР
	                |									КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.НеПринят)
	                |										ТОГДА 12
	                |									ИНАЧЕ ВЫБОР
	                |											КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Сдан)
	                |												ТОГДА 13
	                |										КОНЕЦ
	                |								КОНЕЦ
	                |						КОНЕЦ
	                |				КОНЕЦ
	                |		ИНАЧЕ ВЫБОР
	                |				КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Отправлен)
	                |					ТОГДА 3
	                |				ИНАЧЕ ВЫБОР
	                |						КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Доставлен)
	                |							ТОГДА 4
	                |						ИНАЧЕ ВЫБОР
	                |								КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.НеПринят)
	                |									ТОГДА 5
	                |								ИНАЧЕ ВЫБОР
	                |										КОГДА СтатусОтправки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправки.Сдан)
	                |											ТОГДА 6
	                |									КОНЕЦ
	                |							КОНЕЦ
	                |					КОНЕЦ
	                |			КОНЕЦ
	                |	КОНЕЦ КАК СтатусКартинка,
	                |	РегламентированныйОтчет.ДатаПодписи КАК ДатаСоздания,
	                |	ВЫРАЗИТЬ(РегламентированныйОтчет.Организация КАК Справочник.Организации) КАК Организация,
	                |	ВЫБОР
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетСтрановойОтчет""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетУчастиеВМеждународнойГруппеКомпаний""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетДоходыОтДеятельностиМузеяТеатраБиблиотеки""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетДвижениеСредствПоСчетуВБанкеЗаПределамиРФ""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетДвижениеСредствНерезидентаЗаПределамиРФ""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетФинОтчетностьМГК""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетДеятельностьИнОргВРФ""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетПрослеживаемыеТоварыОтчетОбОперациях""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетПрослеживаемыеТоварыВвоз""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетПрослеживаемыеТоварыПеремещение""
	                |			ИЛИ РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетПрослеживаемыеТоварыОстатки""
	                |			ТОГДА ГОД(РегламентированныйОтчет.ДатаНачала)
	                |		ИНАЧЕ 0
	                |	КОНЕЦ КАК ОтчетныйГод,
	                |	РегламентированныйОтчет.Ссылка,
	                |	РегламентированныйОтчет.КодНалоговогоОргана КАК НалоговыйОрган,
	                |	ВЫБОР
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРозничныеЦеныНаТабак""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.УведомлениеОРозничныхЦенахНаТабачныеИзделия)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСДокументыДляКомпенсацииНалога""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСДокументыДляКомпенсацииНалога)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСДекларацииИТаможенныеДекларации23""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСДекларацииИТаможенныеДекларации23)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСДекларацииНаЭкспрессГрузы""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСДекларацииНаЭкспрессГрузы)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСДекларацииНаТоварыВвозРеэкспорт""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСДекларацииНаТоварыВвозРеэкспорт)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСПриложение1""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСПриложение1)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСПриложение2""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСПриложение2)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСПриложение3""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСПриложение3)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСПриложение4""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСПриложение4)
	                |		КОГДА РегламентированныйОтчет.ИсточникОтчета = ""РегламентированныйОтчетРеестрНДСПриложение5""
	                |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.РеестрНДСПриложение5)
