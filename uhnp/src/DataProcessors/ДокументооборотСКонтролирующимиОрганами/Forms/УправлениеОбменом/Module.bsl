&НаКлиенте
Процедура КомандаУведомленияСоздать(Команда)
	
	// наполняем список выбора в зависимости от того, какие объекты в системе существуют
	СписокВариантовВыбора = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ИмяДокументаУведомлениеОКонтролируемыхСделках) Тогда
		СписокВариантовВыбора.Добавить("Документы", НСтр("ru = 'Уведомление о контролируемых сделках';
														|en = 'Уведомление о контролируемых сделках'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокументаДокументацияПоКонтролируемымСделкам) Тогда
		СписокВариантовВыбора.Добавить("ДокументацияПоКонтролируемымСделкам",
			НСтр("ru = 'Документация по контролируемым сделкам';
				|en = 'Документация по контролируемым сделкам'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетРозничныеЦеныНаТабак() Тогда
		СписокВариантовВыбора.Добавить("УведомленияОРозничныхЦенахНаТабак",
			НСтр("ru = 'Уведомление о розничных ценах на табак';
				|en = 'Уведомление о розничных ценах на табак'"));
	КонецЕсли;
	
	СписокВариантовВыбора.Добавить("УведомленияОПолучателеДокументов",
		НСтр("ru = 'Уведомление о получателе документов';
			|en = 'Уведомление о получателе документов'"));
	
	СписокВариантовВыбора.Добавить("МашиночитаемыеДоверенностиФНС",
		НСтр("ru = 'Машиночитаемая доверенность (ФНС)';
			|en = 'Машиночитаемая доверенность (ФНС)'"));
	
	СписокВариантовВыбора.Добавить("ЗаявленияОбОтзывеМЧДФНС",
		НСтр("ru = 'Заявление об отзыве машиночитаемой доверенности (ФНС)';
			|en = 'Заявление об отзыве машиночитаемой доверенности (ФНС)'"));
	
	СписокВариантовВыбора.Добавить("РеестрыФНС", НСтр("ru = 'Реестр по НДС';
														|en = 'Реестр по НДС'"));
	
	СписокВариантовВыбора.Добавить("РеестрыАкцизы", НСтр("ru = 'Реестр по акцизам';
														|en = 'Реестр по акцизам'"));
	
	Если ЗначениеЗаполнено(ИмяДокументаЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ) Тогда
		СписокВариантовВыбора.Добавить("АвансыНДФЛ",
			НСтр("ru = 'Заявление о подтверждении права на зачет авансов по НДФЛ';
				|en = 'Заявление о подтверждении права на зачет авансов по НДФЛ'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетСтрановойОтчет() Тогда
		СписокВариантовВыбора.Добавить("СтрановыеОтчеты", НСтр("ru = 'Страновый отчет';
																|en = 'Страновый отчет'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетУчастиеВМеждународнойГруппеКомпаний() Тогда
		СписокВариантовВыбора.Добавить("УведомленияОбУчастииВМеждународнойГруппеКомпаний",
			НСтр("ru = 'Уведомление об участии в международной группе компаний';
				|en = 'Уведомление об участии в международной группе компаний'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетДоходыОтДеятельностиМузеяТеатраБиблиотеки() Тогда
		СписокВариантовВыбора.Добавить("ДоходыОтДеятельностиМузеяТеатраБиблиотеки",
			НСтр("ru = 'Доходы от деятельности музея, театра, библиотеки';
				|en = 'Доходы от деятельности музея, театра, библиотеки'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетДвижениеСредствПоСчетуВБанкеЗаПределамиРФ() Тогда
		СписокВариантовВыбора.Добавить("ДвижениеСредствПоСчетуВБанкеЗаПределамиРФ",
			НСтр("ru = 'Движение средств по счету в банке за пределами РФ';
				|en = 'Движение средств по счету в банке за пределами РФ'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетДвижениеСредствНерезидентаЗаПределамиРФ() Тогда
		СписокВариантовВыбора.Добавить("ДвижениеСредствНерезидентаЗаПределамиРФ",
			НСтр("ru = 'Движение средств нерезидента за пределами РФ';
				|en = 'Движение средств нерезидента за пределами РФ'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетФинОтчетностьМГК() Тогда
		СписокВариантовВыбора.Добавить("ФинОтчетностьМГК",
			НСтр("ru = 'Консолидированная финансовая отчетность МГК';
				|en = 'Консолидированная финансовая отчетность МГК'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетДеятельностьИнОргВРФ() Тогда
		СписокВариантовВыбора.Добавить("ДеятельностьИнОргВРФ",
			НСтр("ru = 'Годовой отчет о деятельности иностранной организации в РФ';
				|en = 'Годовой отчет о деятельности иностранной организации в РФ'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыОтчетОбОперациях() Тогда
		СписокВариантовВыбора.Добавить("ПрослеживаемыеТоварыОтчетОбОперациях",
			НСтр("ru = 'Отчет об операциях с товарами, подлежащими прослеживаемости';
				|en = 'Отчет об операциях с товарами, подлежащими прослеживаемости'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыВвоз()
		И НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОВвозеПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("ПрослеживаемыеТоварыВвоз",
			НСтр("ru = 'Уведомление о ввозе товаров, подлежащих прослеживаемости';
				|en = 'Уведомление о ввозе товаров, подлежащих прослеживаемости'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыПеремещение()
		И НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОПеремещенииПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("ПрослеживаемыеТоварыПеремещение",
			НСтр("ru = 'Уведомление о перемещении товаров, подлежащих прослеживаемости';
				|en = 'Уведомление о перемещении товаров, подлежащих прослеживаемости'"));
	КонецЕсли;
	
	Если СуществуетРегламентированныйОтчетПрослеживаемыеТоварыОстатки()
		И НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОбОстаткахПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("ПрослеживаемыеТоварыОстатки",
			НСтр("ru = 'Уведомление об остатках товаров, подлежащих прослеживаемости';
				|en = 'Уведомление об остатках товаров, подлежащих прослеживаемости'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокументаУведомлениеОбОстаткахПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("УведомленияОбОстаткахПрослеживаемыхТоваров",
			НСтр("ru = 'Уведомление об остатках прослеживаемого товара';
				|en = 'Уведомление об остатках прослеживаемого товара'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокументаУведомлениеОВвозеПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("УведомленияОВвозеПрослеживаемыхТоваров",
			НСтр("ru = 'Уведомление о ввозе прослеживаемых товаров';
				|en = 'Уведомление о ввозе прослеживаемых товаров'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокументаУведомлениеОПеремещенииПрослеживаемыхТоваров) Тогда
		СписокВариантовВыбора.Добавить("УведомленияОПеремещенииПрослеживаемыхТоваров",
			НСтр("ru = 'Уведомление о перемещении прослеживаемых товаров';
				|en = 'Уведомление о перемещении прослеживаемых товаров'"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДокументаСведенияОДоходахСотрудникаДляСоцВыплат) Тогда
		СписокВариантовВыбора.Добавить("СведенияОДоходахСотрудникаДляСоцВыплат",
			НСтр("ru = 'Сведения о доходах физического лица, направляемые в целях назначения социальных выплат';
				|en = 'Сведения о доходах физического лица, направляемые в целях назначения социальных выплат'"));
	КонецЕсли;
	
	Если СписокВариантовВыбора.Количество() = 0 Тогда
		ПредставлениеУведомленийОСпецрежимах = НСтр("ru = 'Уведомления';
													|en = 'Уведомления'");
	Иначе
		ПредставлениеУведомленийОСпецрежимах = НСтр("ru = 'Прочие уведомления';
													|en = 'Прочие уведомления'");
	КонецЕсли;
	
	СписокВариантовВыбора.Добавить("ПрочиеУведомления", ПредставлениеУведомленийОСпецрежимах);
	
	СписокВариантовВыбора.Добавить("Файлы", НСтр("ru = 'Загрузить из файла';
												|en = 'Загрузить из файла'"));
	ОписаниеОповещения = Новый ОписаниеОповещения("КомандаУведомленияСоздатьЗавершение", ЭтотОбъект);
	СписокВариантовВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выбор действия");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУведомленияСоздатьПродолжитьЗагрузкуФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		КонтекстЭДОКлиент.ПолучениеФайловДляИмпортаНачало(УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУведомленияСоздатьЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> Неопределено Тогда
		
		// Определяем организацию, по которой нужно создать документ
		Организации = ВыбранныеУчетныеЗаписи(ЭтаФорма);
		Если Организации.Количество() = 1 Тогда
			Организация = Организации[0];
		Иначе
			Организация = Неопределено;
		КонецЕсли;
		
		// Открываем соответствующую форму
		Если РезультатВыбора.Значение = "Документы" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("Документы");
			ОткрытьФорму("Документ." + ИмяДокументаУведомлениеОКонтролируемыхСделках + ".ФормаОбъекта", Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "ДокументацияПоКонтролируемымСделкам" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("ДокументацияПоКонтролируемымСделкам");
			ОткрытьФорму("Документ." + ИмяДокументаДокументацияПоКонтролируемымСделкам + ".ФормаОбъекта",
				Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "УведомленияОРозничныхЦенахНаТабак" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("УведомленияОРозничныхЦенахНаТабак");
			
			ИсточникОтчета = "РегламентированныйОтчетРозничныеЦеныНаТабак";
			
			ОткрытьФорму("Отчет." + ИсточникОтчета + ".Форма.ОсновнаяФорма", Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "УведомленияОПолучателеДокументов" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("УведомленияОПолучателеДокументов");
			
			ОткрытьФорму("Документ.УведомлениеОПолучателеДокументов.Форма.ФормаДокумента", Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "МашиночитаемыеДоверенностиФНС" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("МашиночитаемыеДоверенностиФНС");
			
			ОткрытьФорму("Справочник.МашиночитаемыеДоверенностиФНС.ФормаОбъекта",
				Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "ЗаявленияОбОтзывеМЧДФНС" Тогда
			СменитьЗакладкуУведомленийПриНеобходимости("ЗаявленияОбОтзывеМЧДФНС");
			
			ОткрытьФорму("Справочник.ЗаявленияОбОтзывеМЧДФНС.ФормаОбъекта",
				Новый Структура("Организация", Организация));
			
		ИначеЕсли РезультатВыбора.Значение = "АвансыНДФЛ" Тогда
