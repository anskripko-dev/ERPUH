&НаСервере
Перем КонтекстЭДОСервер Экспорт;

&НаКлиенте
Перем КонтекстЭДОКлиент;

&НаКлиенте
Перем ВыбранныеОрганизации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаПФР.Заголовок = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Элементы.ГруппаПФР.Заголовок,
		Истина);
	Элементы.ГруппаФСС.Заголовок = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Элементы.ГруппаФСС.Заголовок,
		Истина);
	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ЗПЭД") Тогда
		Элементы.ТаблицаИсходящиеДокументыПФРКомандаИсходящиеДокументыПФРСоздатьЗаявлениеНаПодключениеКЭДОсПФР.Заголовок =
			НСтр("ru = 'Заявление на подключение к ЭДО СФР (не применяется с 04.04.2026)';
				|en = 'Заявление на подключение к ЭДО СФР (не применяется с 04.04.2026)'");
		Элементы.ТаблицаИсходящиеДокументыПФРКомандаИсходящиеДокументыПФРСоздатьЗаявлениеНаОтключениеОтЭДОсПФР.Заголовок =
			НСтр("ru = 'Заявление на отключение от ЭДО СФР (не применяется с 04.04.2026)';
				|en = 'Заявление на отключение от ЭДО СФР (не применяется с 04.04.2026)'");
	КонецЕсли;
	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.УПУП") Тогда
		Элементы.ТаблицаИсходящиеДокументыПФРКомандаИсходящиеДокументыПФРСоздатьУведомлениеОПредоставленииПолномочийПредставителю.Заголовок =
			НСтр("ru = 'Уведомление о предоставлении полномочий представителю (не применяется с 04.04.2026)';
				|en = 'Уведомление о предоставлении полномочий представителю (не применяется с 04.04.2026)'");
		Элементы.ТаблицаИсходящиеДокументыПФРКомандаИсходящиеДокументыПФРСоздатьУведомлениеОПрекращенииПолномочийПредставителя.Заголовок =
			НСтр("ru = 'Уведомление о прекращении полномочий представителя (не применяется с 04.04.2026)';
				|en = 'Уведомление о прекращении полномочий представителя (не применяется с 04.04.2026)'");
	КонецЕсли;
	
	СоответствиеСписокСтраница = ПолучитьСоответствиеСписокСтраница();
	ПараметрыДинамическихСписков = Новый Структура;
	Для Каждого ЭлементСписка Из СоответствиеСписокСтраница Цикл
		НастройкиДС = Новый Структура("ОсновнаяТаблица,ДинамическоеСчитываниеДанных,ТекстЗапроса");
		ЗаполнитьЗначенияСвойств(НастройкиДС, ЭтаФорма[ЭлементСписка.Ключ]);
		ПараметрыДинамическихСписков.Вставить(ЭлементСписка.Ключ, НастройкиДС);
	КонецЦикла;
	
	ИмяДокументаУведомлениеОКонтролируемыхСделках = 
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОКонтролируемыхСделках");
	ИмяДокументаДокументацияПоКонтролируемымСделкам =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"ДокументацияПоКонтролируемымСделкам");
	ИмяДокументаУведомлениеОСпецрежимахНалогообложения = "УведомлениеОСпецрежимахНалогообложения";
	ИмяДокументаЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"ЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ");
	ИмяДокументаУведомлениеОбОстаткахПрослеживаемыхТоваров =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОбОстаткахПрослеживаемыхТоваров");
	ИмяДокументаУведомлениеОВвозеПрослеживаемыхТоваров =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОВвозеПрослеживаемыхТоваров");
	ИмяДокументаУведомлениеОПеремещенииПрослеживаемыхТоваров =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"УведомлениеОПеремещенииПрослеживаемыхТоваров");
	ИмяДокументаСведенияОДоходахСотрудникаДляСоцВыплат =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСерверПереопределяемый.ИмяОбъектаМетаданных(
		"СведенияОДоходахСотрудникаДляСоцВыплат");
	
	ВидДокументаЗаявленияОВвозе = "Заявление";
	
	// заполняем список учетных записей
	ЗаполнитьУчетныеЗаписи();
	
	// восстанавливаем настройки, сохраненные при последнем закрытии формы
	ВосстановитьНастройки();
	
	ВыбранныеУчетныеЗаписи = ВыбранныеУчетныеЗаписи(ЭтаФорма, );

	сохрТекущаяСтраницаПанелиФормы = Неопределено;
	сохрТекущаяСтраницаПанелиФНС = Неопределено;
	сохрТекущаяСтраницаПанелиПФР = Неопределено;
	сохрТекущаяСтраницаПанелиФСГС = Неопределено;
	сохрТекущаяСтраницаПанелиРПН = Неопределено;
	
	ВосстановитьНастройкиСтраниц(
		сохрТекущаяСтраницаПанелиФормы,
		сохрТекущаяСтраницаПанелиФНС,
		сохрТекущаяСтраницаПанелиПФР,
		сохрТекущаяСтраницаПанелиФСГС,
		сохрТекущаяСтраницаПанелиРПН);
	
	// определяем ВидДокументаЗаявленияОВвозе, если он еще не определен
	Если ВидДокументаЗаявленияОВвозе = "" Тогда
		ВидДокументаЗаявленияОВвозе = "Заявление";
	КонецЕсли;
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		КартинкаЦБ = "ЦБ";
		Элементы.ГруппаЦБ.Картинка = БиблиотекаКартинок[КартинкаЦБ];
		Элементы.ГруппаЦБ.Видимость = Истина;
	КонецЕсли;
	
	УправлениеЗакладкойУведомлений();
	УправлениеЗакладкойОтветыНаТребования();
	
	УстановитьПараметрыПроизвольныхЗапросов(
		сохрТекущаяСтраницаПанелиФормы,
		сохрТекущаяСтраницаПанелиФНС,
		сохрТекущаяСтраницаПанелиПФР,
		сохрТекущаяСтраницаПанелиФСГС,
		сохрТекущаяСтраницаПанелиРПН);
	УправлениеЗакладкойЗаявлений();
	ВосстановитьНастройкиОтборов();
		
	// прорисовываем элементы управления
	УправлениеЭУ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если УчетныеЗаписи.Количество() = 0 Тогда
		ТекстВопроса = "Для работы с формой """ + СокрЛП(Заголовок) + """ Вы должны быть зарегистрированы
						|в информационной базе как пользователь хотя бы одной из активных учетных записей документооборота.
						|
						|Открыть справочник учетных записей документооборота?";
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПриОткрытииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		МассивПолученныхСообщений = Новый Массив;
		Оповестить("Заполнение списка полученных сообщений", МассивПолученныхСообщений);
		Если МассивПолученныхСообщений.Количество() > 0 Тогда 
			ПолученныеТранспортныеСообщения.ЗагрузитьЗначения(МассивПолученныхСообщений);
		КонецЕсли;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриОткрытииЗавершение", ЭтотОбъект);
		ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицФормы

&НаКлиенте
Процедура ТаблицаИсходящиеДокументыФНСПриАктивизацииСтроки(Элемент)

	Если Элемент.Видимость Тогда
		Если ЦиклыОбменаИсходящиеФНС.Параметры.Элементы.Найти(Новый ПараметрКомпоновкиДанных("СсылкаДляОтбора")) <> Неопределено Тогда
			ЦиклыОбменаИсходящиеФНС.Параметры.УстановитьЗначениеПараметра("СсылкаДляОтбора", Элементы.ТаблицаИсходящиеДокументыФНС.ТекущаяСтрока);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

