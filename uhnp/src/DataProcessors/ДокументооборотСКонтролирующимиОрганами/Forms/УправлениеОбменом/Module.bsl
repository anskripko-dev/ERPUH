		ЭлементОтбора = ТранспортноеСообщение.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("УчетнаяЗапись");
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.ПравоеЗначение   = УчетныеЗаписиПоСпискуОрганизаций(ВыбранныеУчетныеЗаписи);
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ТранспортноеСообщение.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = Строка(Новый УникальныйИдентификатор);
		
		Элементы.СтраницаПрочее.Видимость = Ложь;
		Элементы.ТранспортноеСообщение.Видимость = Истина;
		
	КонецЕсли;
	
	УстановитьОтборПоПредмету(ЭтаФорма);
	
	СкрытьНеактивныеСтраницы();
	
КонецПроцедуры

&НаСервере
Процедура СкрытьНеактивныеСтраницы()
		
	СоответствиеСписокСтраница = ПолучитьСоответствиеСписокСтраница();
	
	СоответствиеСписокЭлемент = Новый Соответствие;
	
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") И СоответствиеСписокСтраница.Получить(ЭлементФормы.ПутьКДанным) <> Неопределено Тогда
			СоответствиеСписокЭлемент.Вставить(ЭлементФормы.ПутьКДанным, ЭлементФормы.Имя);
		КонецЕсли;
	КонецЦикла;
	
	СписокКО = Новый Массив;
	СписокКО.Добавить("ФНС");
	СписокКО.Добавить("ПФР");
	СписокКО.Добавить("ФСГС");
	СписокКО.Добавить("ФСС");
	СписокКО.Добавить("ФСРАР");
	СписокКО.Добавить("РПН");
	СписокКО.Добавить("ФТС");
	СписокКО.Добавить("ЦБ");
	СписокКО.Добавить("Выписки");
	
	СоответствиеСтраницаНадпись = ПолучитьСоответствиеСтраницаНадпись();
	
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница <> Неопределено Тогда
		ТекущееИмя = СтрЗаменить(Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя, "Группа", "");
		Для Каждого ЭлементСоответствия Из СоответствиеСписокСтраница Цикл
			Если ТекущееИмя = "Прочее" ИЛИ ЭлементСоответствия.Значение <> Элементы["ГруппаСтраницы" + ТекущееИмя].ТекущаяСтраница.Имя Тогда
				СписокДС = ЭтаФорма[ЭлементСоответствия.Ключ];
				ЗаполнитьЗначенияСвойств(СписокДС, ПараметрыДинамическихСписков[ЭлементСоответствия.Ключ]);
				Элементы[СоответствиеСписокЭлемент[ЭлементСоответствия.Ключ]].Видимость = Ложь;
				
				Элементы[СоответствиеСтраницаНадпись[ЭлементСоответствия.Значение]].Видимость = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПринудительноПерестроитьФормуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЗакладкойУведомлений(Вид = Неопределено)
	// Параметр функции "Вид" может принимать следующие значения:
	// - "Все", чтобы показать все виды документов в одном списке
	// - "Файлы", чтобы показать только электронные представления
	// - "Документы", чтобы показать только Уведомления о контролируемых сделках
	// - "ПрочиеУведомления", чтобы показать только Уведомление о спецрежимах налогообложения
	// - Неопределено, если мы не знаем какие виды документов существуют в системе, но в списке будет располагаться только один вид документа
	
	// меняем внешний вид выпадающего меню
	Элементы.КомандаОткрытияМенюВыбораВидаДокумента.Видимость = Истина; // верхний пункт меню
	Элементы.ТаблицаУведомленияКомандаОткрытьДокументы.Видимость = Истина; // документы
	Элементы.ТаблицаУведомленияКомандаОткрытьДокументацияПоКонтролируемымСделкам.Видимость = Истина; // документация по контролируемым сделкам
	Элементы.ТаблицаУведомленияКомандаОткрытьФайлы.Видимость = Истина; // файлы
	Элементы.ТаблицаУведомленияКомандаОткрытьПрочиеУведомления.Видимость = Истина; // прочие уведомления
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОРозничныхЦенахНаТабак.Видимость = Истина; // уведомления о розничных ценах на табак (регламентированный отчет)
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОПолучателеДокументов.Видимость = Истина; // уведомления о получателе документов
	Элементы.ТаблицаУведомленияКомандаОткрытьМашиночитаемыеДоверенностиФНС.Видимость = Истина; // машиночитаемые доверенности ФНС
	Элементы.ТаблицаУведомленияКомандаОткрытьЗаявленияОбОтзывеМЧДФНС.Видимость 	= Истина; // заявления об отзыве машиночитаемых доверенностей
	Элементы.ТаблицаУведомленияКомандаОткрытьАвансыНДФЛ.Видимость = Истина; // заявление о подтверждении права на зачет авансов по НДФЛ
	Элементы.ТаблицаУведомленияКомандаОткрытьСтрановыеОтчеты.Видимость = Истина; // страновые отчеты (регламентированный отчет)
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОбУчастииВМеждународнойГруппеКомпаний.Видимость = Истина; // уведомления об участии в международной группе компаний (регламентированный отчет)
	Элементы.ТаблицаУведомленияКомандаОткрытьДоходыОтДеятельностиМузеяТеатраБиблиотеки.Видимость = Истина; // сведения о доле доходов от деятельности музея, театра, библиотеки
	Элементы.ТаблицаУведомленияКомандаОткрытьДвижениеСредствПоСчетуВБанкеЗаПределамиРФ.Видимость = Истина; // движение средств по счету в банке за пределами РФ
	Элементы.ТаблицаУведомленияКомандаОткрытьДвижениеСредствНерезидентаЗаПределамиРФ.Видимость = Истина; // движение средств нерезидента за пределами РФ
	Элементы.ТаблицаУведомленияКомандаОткрытьФинОтчетностьМГК.Видимость = Истина; // консолидированная финансовая отчетность МГК
	Элементы.ТаблицаУведомленияКомандаОткрытьДеятельностьИнОргВРФ.Видимость = Истина; // годовой отчет о деятельности иностранной организации в РФ
	Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыОтчетОбОперациях.Видимость = Истина; // отчет об операциях с товарами, подлежащими прослеживаемости
	Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыВвоз.Видимость = Истина; // уведомление о ввозе товаров, подлежащих прослеживаемости
	Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыПеремещение.Видимость = Истина; // уведомление о перемещении товаров, подлежащих прослеживаемости
	Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыОстатки.Видимость = Истина; // уведомление об остатках товаров, подлежащих прослеживаемости
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОбОстаткахПрослеживаемыхТоваров.Видимость = Истина; // уведомления об остатках прослеживаемого товара
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОВвозеПрослеживаемыхТоваров.Видимость = Истина; // уведомление о ввозе прослеживаемых товаров
	Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОПеремещенииПрослеживаемыхТоваров.Видимость = Истина; // уведомление о перемещении прослеживаемых товаров
	Элементы.ТаблицаУведомленияКомандаОткрытьСведенияОДоходахСотрудникаДляСоцВыплат.Видимость = Истина; // сведения о доходах физического лица, направляемые в целях назначения социальных выплат
	
	// документ Уведомление о контролируемых сделках
	Если НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОКонтролируемыхСделках) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДокументы.Видимость = Ложь;
	КонецЕсли;
	
	// документ Документация по контролируемым сделкам
	Если НЕ ЗначениеЗаполнено(ИмяДокументаДокументацияПоКонтролируемымСделкам) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДокументацияПоКонтролируемымСделкам.Видимость = Ложь;
	КонецЕсли;
	
	// уведомления о розничных ценах на табак (регламентированный отчет)
	Если НЕ СуществуетРегламентированныйОтчетРозничныеЦеныНаТабак() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОРозничныхЦенахНаТабак.Видимость = Ложь;
	КонецЕсли;
	
	// документ Заявление о подтверждении права на зачет авансов по НДФЛ
	Если НЕ ЗначениеЗаполнено(ИмяДокументаЗаявлениеОПодтвержденииПраваНаЗачетАвансовПоНДФЛ) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьАвансыНДФЛ.Видимость = Ложь;
	КонецЕсли;
	
	// страновые отчеты (регламентированный отчет)
	Если НЕ СуществуетРегламентированныйОтчетСтрановойОтчет() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьСтрановыеОтчеты.Видимость = Ложь;
	КонецЕсли;
	
	// уведомления об участии в международной группе компаний (регламентированный отчет)
	Если НЕ СуществуетРегламентированныйОтчетУчастиеВМеждународнойГруппеКомпаний() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОбУчастииВМеждународнойГруппеКомпаний.Видимость = Ложь;
	КонецЕсли;
	
	// сведения о доле доходов от деятельности музея, театра, библиотеки
	Если НЕ СуществуетРегламентированныйОтчетДоходыОтДеятельностиМузеяТеатраБиблиотеки() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДоходыОтДеятельностиМузеяТеатраБиблиотеки.Видимость = Ложь;
	КонецЕсли;
	
	// движение средств по счету в банке за пределами РФ
	Если НЕ СуществуетРегламентированныйОтчетДвижениеСредствПоСчетуВБанкеЗаПределамиРФ() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДвижениеСредствПоСчетуВБанкеЗаПределамиРФ.Видимость = Ложь;
	КонецЕсли;
	
	// движение средств нерезидента за пределами РФ
	Если НЕ СуществуетРегламентированныйОтчетДвижениеСредствНерезидентаЗаПределамиРФ() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДвижениеСредствНерезидентаЗаПределамиРФ.Видимость = Ложь;
	КонецЕсли;
	
	// консолидированная финансовая отчетность МГК
	Если НЕ СуществуетРегламентированныйОтчетФинОтчетностьМГК() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьФинОтчетностьМГК.Видимость = Ложь;
	КонецЕсли;
	
	// годовой отчет о деятельности иностранной организации в РФ
	Если НЕ СуществуетРегламентированныйОтчетДеятельностьИнОргВРФ() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьДеятельностьИнОргВРФ.Видимость = Ложь;
	КонецЕсли;
	
	// отчет об операциях с товарами, подлежащими прослеживаемости
	Если НЕ СуществуетРегламентированныйОтчетПрослеживаемыеТоварыОтчетОбОперациях() Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыОтчетОбОперациях.Видимость = Ложь;
	КонецЕсли;
	
	// уведомление о ввозе товаров, подлежащих прослеживаемости
	Если НЕ СуществуетРегламентированныйОтчетПрослеживаемыеТоварыВвоз()
		ИЛИ ЗначениеЗаполнено(ИмяДокументаУведомлениеОВвозеПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыВвоз.Видимость = Ложь;
	КонецЕсли;
	
	// уведомление о перемещении товаров, подлежащих прослеживаемости
	Если НЕ СуществуетРегламентированныйОтчетПрослеживаемыеТоварыПеремещение()
		ИЛИ ЗначениеЗаполнено(ИмяДокументаУведомлениеОПеремещенииПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыПеремещение.Видимость = Ложь;
	КонецЕсли;
	
	// уведомление об остатках товаров, подлежащих прослеживаемости
	Если НЕ СуществуетРегламентированныйОтчетПрослеживаемыеТоварыОстатки()
		ИЛИ ЗначениеЗаполнено(ИмяДокументаУведомлениеОбОстаткахПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьПрослеживаемыеТоварыОстатки.Видимость = Ложь;
	КонецЕсли;
	
	// документ Уведомление об остатках прослеживаемых товаров
	Если НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОбОстаткахПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОбОстаткахПрослеживаемыхТоваров.Видимость = Ложь;
	КонецЕсли;
	
	// документ Уведомление о ввозе прослеживаемых товаров
	Если НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОВвозеПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОВвозеПрослеживаемыхТоваров.Видимость = Ложь;
	КонецЕсли;
	
	// документ Уведомление о перемещении прослеживаемых товаров
	Если НЕ ЗначениеЗаполнено(ИмяДокументаУведомлениеОПеремещенииПрослеживаемыхТоваров) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьУведомленияОПеремещенииПрослеживаемыхТоваров.Видимость = Ложь;
	КонецЕсли;
	
	// документ Уведомление о перемещении прослеживаемых товаров
	Если НЕ ЗначениеЗаполнено(ИмяДокументаСведенияОДоходахСотрудникаДляСоцВыплат) Тогда
		Элементы.ТаблицаУведомленияКомандаОткрытьСведенияОДоходахСотрудникаДляСоцВыплат.Видимость = Ложь;
	КонецЕсли;
	
	// определяем Вид, если он еще не определен
	Если Вид = Неопределено Тогда
		Если ЗначениеЗаполнено(ИмяДокументаУведомлениеОКонтролируемыхСделках) Тогда
			Вид = "Документы";
		Иначе
			Вид = "ПрочиеУведомления";
		КонецЕсли;
	КонецЕсли;
	
	// устанавливаем "нажатость" пунктов меню и убираем видимость лишних колонок
	//
	Для каждого КомандаВРазделеУведомлений Из Элементы.КомандаОткрытияМенюВыбораВидаДокумента.ПодчиненныеЭлементы Цикл
		КомандаВРазделеУведомлений.Пометка = Ложь;
	КонецЦикла; 
	
	Элементы.ТаблицаУведомленияНалоговыйОрган.Видимость = Истина;
	Элементы.ТаблицаУведомленияОтчетныйГод.Видимость 	= Истина;
	
	Если Вид = "Документы" Тогда
		// документ Уведомление о контролируемых сделках
		Элементы.ТаблицаУведомленияКомандаОткрытьДокументы.Пометка = Истина; // нажатость подменю
		Элементы.ТаблицаУведомленияНалоговыйОрган.Видимость = Ложь;
	ИначеЕсли Вид = "ДокументацияПоКонтролируемымСделкам" Тогда
		// документ Документация по контролируемым сделкам
		Элементы.ТаблицаУведомленияКомандаОткрытьДокументацияПоКонтролируемымСделкам.Пометка = Истина; // нажатость подменю
		Элементы.ТаблицаУведомленияНалоговыйОрган.Видимость = Ложь;
	ИначеЕсли Вид = "ПрочиеУведомления" Тогда
		// документ Уведомление о спецрежимах налогообложения
		Элементы.ТаблицаУведомленияКомандаОткрытьПрочиеУведомления.Пометка = Истина; // нажатость подменю
		Элементы.ТаблицаУведомленияОтчетныйГод.Видимость = Ложь;
	ИначеЕсли Вид = "УведомленияОРозничныхЦенахНаТабак" Тогда
