			Результат.НаименованиеОператора = Метаданные.Перечисления.СпецоператорыСвязи.ЗначенияПеречисления[ИндексОператора].Синоним;
		КонецЕсли;
		
		Организация = СвойстваОрганизации.Организация;
		
		// информация об организации
		
		Если НастройкиВызова.ПолучитьРеквизитыКонтролирующихОргановОрганизации Тогда
			ЭтоЮрЛицо = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоЮрЛицо(Организация);
			Результат.Вставить("ТипОрганизации", ЭтоЮрЛицо);
			ИПИспользуетТрудНаемныхРаботников = НЕ ЭтоЮрЛицо И РегламентированнаяОтчетность.ИПИспользуетТрудНаемныхРаботников(Организация);
			
			ЗапрашиваемыеРеквизиты = "КодНО, КодОрганаФСГС" + ?(ЭтоЮрЛицо, ", КППЮЛ", "")
				+ ?(ЭтоЮрЛицо ИЛИ ИПИспользуетТрудНаемныхРаботников,
				", РегНомПФР, РегистрационныйНомерФСС", ", РегНомПФРЗаСебя, РегистрационныйНомерФССДобрСтрах");
			
			СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация,, ЗапрашиваемыеРеквизиты);
			Если НЕ ЭтоЮрЛицо Тогда
				Результат.Вставить("КППЮЛ", "");
			КонецЕсли;
			Если НЕ ЭтоЮрЛицо И НЕ ИПИспользуетТрудНаемныхРаботников Тогда
				СведенияОбОрганизации.Вставить("РегНомПФР", СведенияОбОрганизации.РегНомПФРЗаСебя);
				СведенияОбОрганизации.Удалить("РегНомПФРЗаСебя");
				СведенияОбОрганизации.Вставить("РегистрационныйНомерФСС", СведенияОбОрганизации.РегистрационныйНомерФССДобрСтрах);
				СведенияОбОрганизации.Удалить("РегистрационныйНомерФССДобрСтрах");
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, СведенияОбОрганизации, Истина);
		КонецЕсли;
		
		// информация об учетной записи документооборота
		
		Результат.Вставить("ПравоЧтенияУчетнойЗаписиОбмена", ПравоЧтенияУчетныхЗаписейОбмена);
		
		Для каждого ТипПолучателя Из Метаданные.Перечисления.ТипыКонтролирующихОрганов.ЗначенияПеречисления Цикл
			Результат.Вставить("СдаватьВ" + ТипПолучателя.Имя, Ложь);
		КонецЦикла;
		Результат.Вставить("КодыФНС", 	Новый Массив);
		Результат.Вставить("КодПФР", 	"");
		Результат.Вставить("КодыФСГС", 	Новый Массив);
		Результат.Вставить("КодФСС", 	"");
		
		СписокПользователей = СписокПользователейБазы.Скопировать();
		Результат.Вставить("СписокПользователей", СписокПользователей);
		
		Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
			И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена)
			И ПравоЧтенияУчетныхЗаписейОбмена Тогда
			
			УчетныеЗаписиОрганизаций.Добавить(СвойстваОрганизации.УчетнаяЗаписьОбмена);
			
			Результат.ПравоЧтенияУчетнойЗаписиОбмена = ЗначениеЗаполнено(СвойстваОрганизации.АдресЭлектроннойПочты) ИЛИ
				ЗначениеЗаполнено(СвойстваОрганизации.ИдентификаторАбонента) ИЛИ
				ЗначениеЗаполнено(СвойстваОрганизации.СпецоператорСвязи);
		КонецЕсли;
		
		Если Результат.ЭтоМультиРежим ИЛИ НЕ Результат.ПравоЧтенияУчетнойЗаписиОбмена
			И СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами =
				Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
			И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена)
			И Мультирежим.ЭтоМультиРежим(СвойстваОрганизации.УчетнаяЗаписьОбмена) Тогда
			
			Результат.СертификатРуководителя = Результат.СертификатТекущегоПользователя;
			
			Если НастройкиВызова.ОтборПоПользователю <> Справочники.Пользователи.ПустаяСсылка() Тогда
				Если ЗначениеЗаполнено(НастройкиВызова.ОтборПоПользователю) Тогда
					Результат.ПредназначенаДляДокументооборотаСФНС = Результат.СдаватьВФНСВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.ПредназначенаДляДокументооборотаСПФР = Результат.СдаватьВПФРВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.ПредназначенаДляДокументооборотаСФСГС = Результат.СдаватьВФСГСВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.ПредназначенаДляДокументооборотаСЦБ = Результат.СдаватьВЦБВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.НастройкиОбменаФСС_ИспользоватьОбмен = Результат.СдаватьВФССВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.НастройкиОбменаФСРАР_ИспользоватьОбмен = Результат.СдаватьВФСРАРВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.НастройкиОбменаРПН_ИспользоватьОбмен = Результат.СдаватьВРПНВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					Результат.НастройкиОбменаФТС_ИспользоватьОбмен = Результат.СдаватьВФТСВыбранногоПользователя
						И НЕ Результат.ПотенциальныйВыбранногоПользователя;
					
				Иначе
					Результат.ПредназначенаДляДокументооборотаСФНС = Результат.СдаватьВФНСТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.ПредназначенаДляДокументооборотаСПФР = Результат.СдаватьВПФРТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.ПредназначенаДляДокументооборотаСФСГС = Результат.СдаватьВФСГСТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.ПредназначенаДляДокументооборотаСЦБ = Результат.СдаватьВЦБТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.НастройкиОбменаФСС_ИспользоватьОбмен = Результат.СдаватьВФССТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.НастройкиОбменаФСРАР_ИспользоватьОбмен = Результат.СдаватьВФСРАРТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.НастройкиОбменаРПН_ИспользоватьОбмен = Результат.СдаватьВРПНТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
					Результат.НастройкиОбменаФТС_ИспользоватьОбмен = Результат.СдаватьВФТСТекущегоПользователя
						И НЕ Результат.ПотенциальныйТекущегоПользователя;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НастройкиВызова.НайтиСертификатыПрочихКонтролирующихОрганов
			И СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
			И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена)
			И НЕ Результат.ПравоЧтенияУчетнойЗаписиОбмена
			И (ЗначениеЗаполнено(Результат.НастройкиОбменаФСС_СертификатСтрахователяОтпечаток)
			ИЛИ ЗначениеЗаполнено(Результат.НастройкиОбменаФСРАР_СертификатАбонентаОтпечаток)
			ИЛИ ЗначениеЗаполнено(Результат.НастройкиОбменаРПН_СертификатАбонентаОтпечаток)
			ИЛИ ЗначениеЗаполнено(Результат.НастройкиОбменаФТС_СертификатАбонентаОтпечаток)
			ИЛИ ЗначениеЗаполнено(Результат.НастройкиОбменаБанкРоссии_СертификатАбонентаОтпечаток)
			ИЛИ ЗначениеЗаполнено(Результат.НастройкиОбменаМинобороны_СертификатАбонентаОтпечаток)) Тогда
			Результат.ЭлектроннаяПодписьВМоделиСервиса = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(
				СвойстваОрганизации.УчетнаяЗаписьОбмена).ЭлектроннаяПодписьВМоделиСервиса;
		КонецЕсли;
		Если Результат.ЭтоМультиРежим Тогда
			Результат.ЭлектроннаяПодписьВМоделиСервиса = Результат.ЭлектроннаяПодписьВМоделиСервисаТекущегоПользователя;
		КонецЕсли;
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(СвойстваОрганизации.УчетнаяЗаписьОбмена, Результат);
		
		Результат.Вставить("СпособПодтвержденияКриптоопераций", Перечисления.СпособыПодтвержденияКриптоопераций.СессионныйТокен);
		Если Результат.ЭлектроннаяПодписьВМоделиСервиса = Истина
			И ЗначениеЗаполнено(Результат.СертификатРуководителя) Тогда
			ОтпечатокСертификата 	= Новый Структура("Отпечаток", Результат.СертификатРуководителя);
			СвойствоСертификата 	= ЭлектроннаяПодписьВМоделиСервиса.СвойстваРасшифрованияПодписанияСертификата(ОтпечатокСертификата);
			Результат.СпособПодтвержденияКриптоопераций = СвойствоСертификата.СпособПодтвержденияКриптоопераций;
		КонецЕсли;
		
		// учет информации из первого одобренного заявления
		
		Если НЕ ЗначениеЗаполнено(Результат.ДатаПодключения)
			ИЛИ (ЗначениеЗаполнено(Результат.ЗаявлениеАбонентаСпецоператораСвязи_ДатаПолученияОтвета)
			И Результат.ЗаявлениеАбонентаСпецоператораСвязи_ДатаПолученияОтвета < Результат.ДатаПодключения) Тогда
			
			Результат.ДатаПодключения = Результат.ЗаявлениеАбонентаСпецоператораСвязи_ДатаПолученияОтвета;
		КонецЕсли;
		
		ПоддерживаемыеНаправленияДляОператора = ?(ЗначениеЗаполнено(СвойстваОрганизации.СпецоператорСвязи)
			И ПоддерживаемыеНаправленияДляОператоров <> Неопределено,
			ПоддерживаемыеНаправленияДляОператоров[СвойстваОрганизации.СпецоператорСвязи], Неопределено);
		ПоддерживаемыеНаправления = ПоддерживаемыеНаправленияОрганизации(Организация, ПоддерживаемыеНаправленияДляОператора);
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, ПоддерживаемыеНаправления, Истина);
		
		МассивРезультатов.Добавить(Результат);
	КонецЦикла;
	
	// получатели учетных записей
	
	Если УчетныеЗаписиОрганизаций.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.УчетнаяЗапись,
			|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.ТипПолучателя,
			|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КодПолучателя,
			|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КПП
			|ИЗ
			|	РегистрСведений.ДополнительныеРеквизитыУчетнойЗаписиПолучатели КАК ДополнительныеРеквизитыУчетнойЗаписиПолучатели
			|ГДЕ
			|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.УчетнаяЗапись В (&УчетныеЗаписи)";
		
		Запрос.УстановитьПараметр("УчетныеЗаписи", УчетныеЗаписиОрганизаций);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ТипПолучателя) Тогда
				МетаданныеТипаПолучателя = Выборка.ТипПолучателя.Метаданные();
				ИндексТипаПолучателя = Перечисления[МетаданныеТипаПолучателя.Имя].Индекс(Выборка.ТипПолучателя);
				ИмяТипаПолучателя = МетаданныеТипаПолучателя.ЗначенияПеречисления[ИндексТипаПолучателя].Имя;
				
				ПараметрыОтбора = Новый Структура("УчетнаяЗаписьОбмена", Выборка.УчетнаяЗапись);
				МассивСвойствОрганизаций = ТаблицаОрганизаций.НайтиСтроки(ПараметрыОтбора);
				Для каждого СвойстваОрганизации Из МассивСвойствОрганизаций Цикл
					Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами =
						Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
						
						Результат = МассивРезультатов[СвойстваОрганизации.ИндексОрганизации];
						
						Результат.Вставить("СдаватьВ" + ИмяТипаПолучателя, Истина);
						
						Если Выборка.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
							КодФНС = Новый Структура("Код, КПП", Выборка.КодПолучателя, Выборка.КПП);
							Результат.КодыФНС.Добавить(КодФНС);
						ИначеЕсли Выборка.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
							Результат.КодПФР = Выборка.КодПолучателя;
						ИначеЕсли Выборка.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
							Результат.КодыФСГС.Добавить(Выборка.КодПолучателя);
						КонецЕсли;
						
						МассивРезультатов[СвойстваОрганизации.ИндексОрганизации] = Результат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		// пользователи учетных записей
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись КАК УчетнаяЗапись,
			|	ПользователиУчетныхЗаписейДокументооборота.Пользователь КАК Пользователь
			|ИЗ
			|	РегистрСведений.ПользователиУчетныхЗаписейДокументооборота КАК ПользователиУчетныхЗаписейДокументооборота
			|ГДЕ
			|	ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись В (&УчетныеЗаписи)";
		
		Запрос.УстановитьПараметр("УчетныеЗаписи", УчетныеЗаписиОрганизаций);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПараметрыОтбора = Новый Структура("УчетнаяЗаписьОбмена", Выборка.УчетнаяЗапись);
			МассивСвойствОрганизаций = ТаблицаОрганизаций.НайтиСтроки(ПараметрыОтбора);
			Для каждого СвойстваОрганизации Из МассивСвойствОрганизаций Цикл
				Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами =
					Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
					
					Результат = МассивРезультатов[СвойстваОрганизации.ИндексОрганизации];
					
					ЭлементСпискаПользователей = Результат.СписокПользователей.НайтиПоЗначению(Выборка.Пользователь);
					Если ЭлементСпискаПользователей <> Неопределено Тогда
						ЭлементСпискаПользователей.Пометка = Истина;
					КонецЕсли;
					
					МассивРезультатов[СвойстваОрганизации.ИндексОрганизации] = Результат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого ЭлементРезультатов Из МассивРезультатов Цикл
		Состояние = СостояниеЭДОсПФР(ЭлементРезультатов.Организация);
		ЭлементРезультатов.Вставить("СостояниеЭДОсПФР", Состояние);
	КонецЦикла; 
	
	Результат = Новый Структура;
	Результат.Вставить("НастройкиОбмена", 									МассивРезультатов);
	Результат.Вставить("ТекущаяДатаНаСервере", 								ТекущаяДатаНаСервере);
	Результат.Вставить("ПоддерживаемыеНаправленияДляОператоров", 			ПоддерживаемыеНаправленияДляОператоров);
	Результат.Вставить("ПоддерживаетсяСдачаОтчетностиВЦБ", 					ПоддерживаетсяСдачаОтчетностиВЦБ);
	Результат.Вставить("ПоддерживаетсяСдачаОтчетностиВМинобороныРоссии", 	ПоддерживаетсяСдачаОтчетностиВМинобороныРоссии);
	Результат.Вставить("СписокПользователейБазы", 							СписокПользователейБазы);
	Возврат Результат;
	
КонецФункции

Функция ОрганизацииУчетнойЗаписи(УчетнаяЗапись) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ВидОбменаСКонтролирующимиОрганами = ЗНАЧЕНИЕ(Перечисление.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате)
		|	И Организации.УчетнаяЗаписьОбмена = &УчетнаяЗаписьОбмена
		|	И НЕ Организации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("УчетнаяЗаписьОбмена", УчетнаяЗапись);
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаЗапроса.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ЗаписатьПользователейУчетнойЗаписиДокументооборота(СписокПользователей, УчетнаяЗапись) Экспорт
	
	НаборЗаписей = РегистрыСведений.ПользователиУчетныхЗаписейДокументооборота.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись);
	
	Для каждого СтрокаСписка Из СписокПользователей Цикл
		Если СтрокаСписка.Пометка Тогда
			НоваяСтрока = НаборЗаписей.Добавить();
			НоваяСтрока.УчетнаяЗапись = УчетнаяЗапись;
			НоваяСтрока.Пользователь = СтрокаСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстИсключения = ИнформацияОбОшибке().Описание;
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось обновить список пользователей по учетной записи налогоплательщика ""%1"".';
				|en = 'Cannot update user list by the ""%1"" taxpayer account.'"),
			СокрЛП(УчетнаяЗапись));
		
		РегламентированнаяОтчетностьКлиентСервер.СообщитьОбОшибке(ТекстИсключения, Ложь, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Функция ПоддерживаемыеНаправленияОператоров() Экспорт
	
	Результат = Новый Соответствие;
	
	Операторы = ПолучитьСписокСпецоператоровСвязи();
	
	СвойстваОператора = Новый Структура();
	СвойстваОператора.Вставить("ФСРАРПризнак");
	СвойстваОператора.Вставить("РПНПризнак");
	СвойстваОператора.Вставить("ФТСПризнак");
	
	Для каждого ОператорЭДО Из Операторы Цикл
		ПараметрыОператора = ПолучитьПараметрыСпецоператора(ОператорЭДО, СвойстваОператора);
		
		ПоддерживаемыеНаправления = Новый Структура;
		ПоддерживаемыеНаправления.Вставить("ПризнакПоддержкиФСРАР",
			ПараметрыОператора.ФСРАРПризнак = Истина ИЛИ ПараметрыОператора.ФСРАРПризнак = "Истина");
		ПоддерживаемыеНаправления.Вставить("ПризнакПоддержкиРПН",
			ПараметрыОператора.РПНПризнак = Истина ИЛИ ПараметрыОператора.РПНПризнак = "Истина");
		ПоддерживаемыеНаправления.Вставить("ПризнакПоддержкиФТС",
			ПараметрыОператора.ФТСПризнак = Истина ИЛИ ПараметрыОператора.ФТСПризнак = "Истина");
		
		Результат[ОператорЭДО] = ПоддерживаемыеНаправления;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПоддерживаемыеНаправленияОрганизации(Организация, ПоддерживаемыеНаправленияДляОператора = Неопределено) Экспорт
	
	ПоддерживаемыеНаправленияВызова = Новый Структура;
	ПоддерживаемыеНаправленияВызова.Вставить("ПризнакПоддержкиФСРАР", 	Истина);
	ПоддерживаемыеНаправленияВызова.Вставить("ПризнакПоддержкиРПН", 	Истина);
	ПоддерживаемыеНаправленияВызова.Вставить("ПризнакПоддержкиФТС", 	Истина);
	Если ПоддерживаемыеНаправленияДляОператора <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПоддерживаемыеНаправленияВызова, ПоддерживаемыеНаправленияДляОператора);
	КонецЕсли;
	
	Направления = Новый Массив;
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФНС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ПФР);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСГС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	ПараметрыНаправления = Новый Структура;
	ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСС);
	ПараметрыНаправления.Вставить("Доступен", 	Истина);
	ПараметрыНаправления.Вставить("Подключить", Истина);
	Направления.Добавить(ПараметрыНаправления);
	
	Если ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиФСРАР Тогда
		ПараметрыНаправления = Новый Структура;
		ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФСРАР);
		ПараметрыНаправления.Вставить("Доступен", 	Истина);
		ПараметрыНаправления.Вставить("Подключить", Истина);
		Направления.Добавить(ПараметрыНаправления);
	КонецЕсли;
	
	Если ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиРПН Тогда
		ПараметрыНаправления = Новый Структура;
		ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.РПН);
		ПараметрыНаправления.Вставить("Доступен", 	Истина);
		ПараметрыНаправления.Вставить("Подключить", Истина);
		Направления.Добавить(ПараметрыНаправления);
	КонецЕсли;
	
	Если ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиФТС Тогда
		ПараметрыНаправления = Новый Структура;
		ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ФТС);
		ПараметрыНаправления.Вставить("Доступен", 	Истина);
		ПараметрыНаправления.Вставить("Подключить", Истина);
		Направления.Добавить(ПараметрыНаправления);
	КонецЕсли;
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		ПараметрыНаправления = Новый Структура;
		ПараметрыНаправления.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ЦБ);
		ПараметрыНаправления.Вставить("Доступен", 	Истина);
		ПараметрыНаправления.Вставить("Подключить", Истина);
		Направления.Добавить(ПараметрыНаправления);
	КонецЕсли;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ОпределитьПодключаемыеНаправленияСдачиОтчетности(Организация, Направления);
	
	Результат = Новый Структура;
	Результат.Вставить("ПризнакПоддержкиФНС", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиПФР", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиФСГС", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиФСС", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиФСРАР", Ложь);
	Результат.Вставить("ПризнакПоддержкиРПН", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиФТС", 	Ложь);
	Результат.Вставить("ПризнакПоддержкиЦБ", 	Ложь);
	
	Для каждого НаправлениеЭДО Из Направления Цикл
		Если НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
			Результат.ПризнакПоддержкиФНС = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
			Результат.ПризнакПоддержкиПФР = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
			Результат.ПризнакПоддержкиФСГС = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
			Результат.ПризнакПоддержкиФСС = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСРАР
			И ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиФСРАР Тогда
			
			Результат.ПризнакПоддержкиФСРАР = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.РПН
			И ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиРПН Тогда
			
			Результат.ПризнакПоддержкиРПН = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ФТС
			И ПоддерживаемыеНаправленияВызова.ПризнакПоддержкиФТС Тогда
			
			Результат.ПризнакПоддержкиФТС = НаправлениеЭДО.Доступен;
			
		ИначеЕсли НаправлениеЭДО.Орган = Перечисления.ТипыКонтролирующихОрганов.ЦБ Тогда
			Результат.ПризнакПоддержкиЦБ = НаправлениеЭДО.Доступен;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроверкаПервичногоЗаявления

Процедура ПроверитьСтатусПодключенияПередОтправкой(СсылкаНаОбъект, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	СведенияОбОбъекте 	= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	Организация 		= СведенияОбОбъекте.Организация;
	
	ЗаявленияАбонента = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов(
		,
		Организация,
		Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное);
		
	Если ЗаявленияАбонента.Количество() = 0 Тогда
		
		СообщениеОбОшибке = "ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение";
		
	Иначе
		
		ПоследнееЗаявлениеАбонента = ЗаявленияАбонента[0];
		
		Ответ = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьОтветСервераНаЗаявлениеАбонента(ПоследнееЗаявлениеАбонента);
		
		РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
		РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
		
		ЗаявлениеОтправлено = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		ЗаявлениеОтклонено  = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено;
		ЗаявлениеОдобрено   = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено;

		ОтсутствуетИнтернет = РезультатОтветаСервера.Свойство("СообщитьОбОтсутствииИнтернета");
		
		Если ОтсутствуетИнтернет Тогда
			
			СообщениеОбОшибке = "ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение";
			
		ИначеЕсли ЗаявлениеОтправлено Тогда
			
			СообщениеОбОшибке = "СообщениеОНеобработанномЗаявлении";
				
		ИначеЕсли ЗаявлениеОдобрено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			СообщениеОбОшибке = "СообщениеОбОдобренномЗаявлении";
			
		ИначеЕсли ЗаявлениеОтклонено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			СообщениеОбОшибке = "СообщениеОбОтклоненномЗаявлении";
			
		Иначе
			
			СообщениеОбОшибке = "ПоказатьФормуПредложениеОформитьЗаявлениеНаПодключение";
			
		КонецЕсли;
		 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НеподключенноеНаправление

Процедура СообщитьОНеподключенномНаправлении(СсылкаНаОбъект, СообщениеОбОшибке)
	
	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	СведенияОбОбъекте 			= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	ВидКонтролирующегоОргана 	= СведенияОбОбъекте.ВидКонтролирующегоОргана;
	Организация					= СведенияОбОбъекте.Организация;
	
	// Если не подключено направление, то проверяем наличие отправленного заявления на изменение.
	// Если такого нет, то отправка невозможна и показывам предложение отправить заявление.
	// Если есть, то пытаемся завершить настройку ненастроенного заявления.
	
	ВходящийКонтекст = Новый Структура;
	ВходящийКонтекст.Вставить("СсылкаНаОбъект",           СсылкаНаОбъект);
	ВходящийКонтекст.Вставить("Организация", 			  Организация);
	ВходящийКонтекст.Вставить("ВидКонтролирующегоОргана", СведенияОбОбъекте.ВидКонтролирующегоОргана);
	ВходящийКонтекст.Вставить("КодКонтролирующегоОргана", СведенияОбОбъекте.КодКонтролирующегоОргана);
	
	ЗаявленияАбонента = ОтправленныеЗаявленияАбонентов(
		Организация,
		Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение,
		ВидКонтролирующегоОргана);
		
	Если ЗаявленияАбонента.Количество() = 0 Тогда
		
		ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст, СообщениеОбОшибке);
		
	Иначе
		
		ПоследнееЗаявлениеАбонента = ЗаявленияАбонента[0];
		
		Ответ = ОбработкаЗаявленийАбонентаВызовСервера.ПолучитьОтветСервераНаЗаявлениеАбонента(ПоследнееЗаявлениеАбонента);
		
		РезультатОтветаСервера 	= Ответ.РезультатОтветаСервера;
		РеквизитыДокумента 		= Ответ.РеквизитыДокумента;
		
		ЗаявлениеОтправлено = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		ЗаявлениеОтклонено  = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено;
		ЗаявлениеОдобрено   = РеквизитыДокумента.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено;
		
		ВходящийКонтекст.Вставить("РеквизитыДокумента", 	РеквизитыДокумента);
		ВходящийКонтекст.Вставить("РезультатОтветаСервера", РезультатОтветаСервера);
		ВходящийКонтекст.Вставить("Заявление", 				ПоследнееЗаявлениеАбонента);
		
		Если ЗаявлениеОтправлено Тогда
			
			// Аналог сообщения в форме СообщениеОНеобработанномЗаявлении.
			СообщениеОбОшибке = "СообщениеОНеобработанномЗаявлении";
				
		ИначеЕсли ЗаявлениеОдобрено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			// Аналог сообщения в форме СообщениеОбОдобренномЗаявлении.
			СообщениеОбОшибке = "СообщениеОбОдобренномЗаявлении";
			
		ИначеЕсли ЗаявлениеОтклонено И НЕ РеквизитыДокумента.НастройкаЗавершена Тогда
			
			// Аналог сообщения в форме СообщениеОбОтклоненномЗаявлении.
			СообщениеОбОшибке = "СообщениеОбОтклоненномЗаявлении";
			
		Иначе
			
			ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст, СообщениеОбОшибке);
			
		КонецЕсли;
		 
	КонецЕсли;	
	 
КонецПроцедуры

Процедура ПоказатьОшибкуНеподключенногоНаправления(ВходящийКонтекст, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Организация 					= ВходящийКонтекст.Организация;
	УчетнаяЗапись 					= УчетнаяЗаписьОрганизации(Организация);
	МестоХраненияКлюча 				= КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(УчетнаяЗапись);
	
	Если КриптографияЭДКОКлиентСервер.ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда

		СообщениеОбОшибке = "СообщениеОНеподключенномНаправлении";
		
	Иначе
		// Для отправки требуется клиентский сертификат, который доступен только из клиентского контекста,
		// отправка на сервере без обращения к клиентскому контексту невозможна.
		СообщениеОбОшибке = "ЭтоНеЭлектроннаяПодписьВМоделиСервиса";
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоЗаявлениеНаПодключениеНаправления(ДокументЗаявление, ВидКонтролирующегоОргана) Экспорт

	ПроверяемыеРеквизиты = ИзмененныеРеквизитыПоВидуКонтролирующегоОргана(ВидКонтролирующегоОргана);
	
	// Если количество реквизитов после объединения с удалением неуникальных меньше общего количества
	// до объединения, то значит в заявлении есть реквизиты из проверяемого списка.
	
	ИзменившиесяРеквизитыЗаявления = ДокументЗаявление.ИзменившиесяРеквизитыВторичногоЗаявления.Выгрузить().ВыгрузитьКолонку("ИзмененныйРеквизит");
	
	КоличествоРеквизитовЗаявления 	= ИзменившиесяРеквизитыЗаявления.Количество();
	КоличествоПроверяемыеРеквизиты 	= ПроверяемыеРеквизиты.Количество();
	ОбщееКоличествоРеквизитов 		= КоличествоРеквизитовЗаявления + КоличествоПроверяемыеРеквизиты;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИзменившиесяРеквизитыЗаявления, ПроверяемыеРеквизиты, Истина);
	КоличествоРеквизитовПослеОбъединения = ИзменившиесяРеквизитыЗаявления.Количество();
	
	ЭтоПодключениеНаправления = КоличествоРеквизитовПослеОбъединения < ОбщееКоличествоРеквизитов;
	
	Возврат ЭтоПодключениеНаправления;
	
КонецФункции

Функция ОтправленныеЗаявленияАбонентов(Организация, ТипЗаявления, ВидКонтролирующегоОргана) Экспорт

	Если ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение Тогда
		ИзмененныеРеквизиты = ИзмененныеРеквизитыПоВидуКонтролирующегоОргана(ВидКонтролирующегоОргана);
	Иначе
		ИзмененныеРеквизиты = Неопределено;
	КонецЕсли;
	
	ЗаявленияАбонента = ОбработкаЗаявленийАбонентаВызовСервера.ОтправленныеЗаявленияАбонентов(
		,
		Организация,
		ТипЗаявления,
		ИзмененныеРеквизиты);

	Возврат ЗаявленияАбонента;

КонецФункции

Функция ИзмененныеРеквизитыПоВидуКонтролирующегоОргана(ВидКонтролирующегоОргана)
	
	ИзмененныеРеквизиты = Новый Массив;
	
	Если ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
		
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФНС);
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.КодыФНС);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВПФР);
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.КодПФР);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСС);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРосстат);
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.КодРосстата);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСРАР Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФСРАР);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.РПН Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВРПН);
		
	ИначеЕсли ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
			
		ИзмененныеРеквизиты.Добавить(Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВФТС);
		
	КонецЕсли;
	
	Возврат ИзмененныеРеквизиты;
	
КонецФункции

#КонецОбласти	

#Область АвтонастройкаУчетнойЗаписи

Процедура АвтоматическаяНастройкаУчетнойЗаписи(Знач УчетнаяЗапись, СообщениеОбОшибке) Экспорт

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.


	// Время предыдущего обращения к автонастройке при отправке на сервере не запоминается,
	// поэтому обновление автонастройки по времени на стороне сервера не проверяется.
	
	НастройкиУчетнойЗаписи = ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
	// Если настройки недоступны или учетка для обмена напрямую, то прервемся.
	Если НастройкиУчетнойЗаписи = Неопределено ИЛИ НастройкиУчетнойЗаписи.ОбменНапрямую Тогда
		Возврат;
	КонецЕсли;
	
	ОбновленияПризнак = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(НастройкиУчетнойЗаписи.СпецОператорСвязи, "ОбновленияПризнак");
	
	Если НастройкиУчетнойЗаписи.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.Отключена
		ИЛИ НастройкиУчетнойЗаписи.РежимАвтонастройки = Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.ПустаяСсылка() Тогда
			
		Возврат;
			
	КонецЕсли;
	
	// В настоящее время автонастройка учетной записи при отправке на стороне сервера
	// доступна только для спецоператора "Калуга Астрал".
	
	Если ОбновленияПризнак <> Неопределено И ОбновленияПризнак Тогда
		
		ИдентификаторАбонента = НастройкиУчетнойЗаписи.ИдентификаторАбонента;
		ИдентификаторСпецоператора = НастройкиУчетнойЗаписи.ИдентификаторСпецоператора;
		ИдентификаторАбонента = Нрег(Сред(ИдентификаторАбонента, СтрДлина(ИдентификаторСпецоператора)+1));
		
		ПараметрыОбработатьОбновление = ПараметрыОбработатьОбновление();
		ПараметрыОбработатьОбновление.ИдентификаторДокументооборота 				= НастройкиУчетнойЗаписи.ИдентификаторДокументооборота;
		ПараметрыОбработатьОбновление.ТелефонМобильныйДляАвторизации 				= НастройкиУчетнойЗаписи.ТелефонМобильныйДляАвторизации;
		ПараметрыОбработатьОбновление.ИдентификаторАбонента                         = ИдентификаторАбонента;
		ПараметрыОбработатьОбновление.СпецоператорСвязи                             = НастройкиУчетнойЗаписи.СпецОператорСвязи;
		ПараметрыОбработатьОбновление.УчетнаяЗапись                                 = УчетнаяЗапись;
		ПараметрыОбработатьОбновление.ТихийРежим                                    = Истина;
		ПараметрыОбработатьОбновление.РежимАвтонастройки                            = Истина;
		ПараметрыОбработатьОбновление.ВызовИзМастераПодключенияК1СОтчетности 		= Ложь;
		ПараметрыОбработатьОбновление.ТекстОшибокДляМастераПодключенияК1СОтчетности = "";
		ПараметрыОбработатьОбновление.ОбращениеКСерверуОтключено 					= Ложь;		
		ПараметрыОбработатьОбновление.СохранениеВИБОтключено 						= Ложь;		
		ПараметрыОбработатьОбновление.СтруктураДляИнформацииОСервереОнлайнПроверки  = Неопределено;		
		ПараметрыОбработатьОбновление.ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки = Истина;
		ПараметрыОбработатьОбновление.ИгнорироватьРежимАвтонастройки				= Ложь;		
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(НастройкиУчетнойЗаписи, ПараметрыОбработатьОбновление);
		
		ОбработатьОбновление(ПараметрыОбработатьОбновление, СообщениеОбОшибке);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОбновление(ПараметрыФункции, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ВыводитьСообщения = Истина; // Сообщения выводим для перехвата и отправки вызывающему сервису.

	ПараметрыРегистрацияПолучитьДанныеССервера = ПараметрыРегистрацияПолучитьДанныеССервера();
	ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции);
	ПараметрыРегистрацияПолучитьДанныеССервера.ФайлИзКэша = Ложь;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВыводитьСообщения = ВыводитьСообщения;
	ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес = Новый УникальныйИдентификатор();
	ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес = Новый УникальныйИдентификатор();
	
	Сертификаты = Неопределено; // Будет инициализирована после загрузки сертификатов.
	
	Результат = РегистрацияПолучитьДанныеССервера(ПараметрыРегистрацияПолучитьДанныеССервера, Ложь, Сертификаты);
	Если НЕ Результат Тогда
		// Обновление настроек учетной записи не является обязательным для отправки отчета.
		// Если оно по каким-то причинам не выполнено, то попробуем отправить отчет с существующими настройками.
		// Если в ходе отправки возникут ошибки (например, истек срок действия сертификата), то об этом будет выдано отдельное сообщение.
		// Текущую проблему регистрируем в журнале, но не прерываем дальнейшую отправку.
		
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Предупреждение, НСтр("ru = 'Не удалось обратиться к серверу обновлений';
																				|en = 'Cannot contact the update server'"));
		Возврат;
	КонецЕсли;
		
	ПараметрыАвторизации = Новый Структура;
	Если ЗначениеЗаполнено(ПараметрыФункции.УчетнаяЗапись) Тогда
		ПараметрыАвторизации.Вставить("УчетнаяЗапись", ПараметрыФункции.УчетнаяЗапись);
	Иначе
		ПараметрыАвторизации.Вставить("ИдентификаторДокументооборота", ПараметрыФункции.ИдентификаторДокументооборота);
		ПараметрыАвторизации.Вставить("ТелефонМобильныйДляАвторизации", ПараметрыФункции.ТелефонМобильныйДляАвторизации);
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияПолучитьДанныеССервера);
	ФайлИзКэша = ПараметрыРегистрацияПолучитьДанныеССервера.ФайлИзКэша;
	ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ПараметрыРегистрацияПолучитьДанныеССервера.ДанныеУзлаКонфиденциальнаяИнформацияАдрес;
	
	СвойствоКриптосообщения = ЭтоСообщениеЗашифрованоНаОблачныйСертификат(ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	Если СвойствоКриптосообщения <> Неопределено Тогда
		МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(СвойствоКриптосообщения);
	Иначе
		МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Ложь);
	КонецЕсли;
	КриптографияЭДКОКлиентСервер.ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ПараметрыФункции);
	
	Если НЕ	КриптографияЭДКОКлиентСервер.ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		// Если не используется электронная подпись в модели сервиса, то автоматическая отправка на стороне сервера не поддерживается.
		СообщениеОбОшибке = "ЭтоНеЭлектроннаяПодписьВМоделиСервиса";
		Возврат;
	КонецЕсли;

	// Установка сертификатов
	// Среди пришедших в рег файле отпечатков ищем тот, который пришел в ответе.
	// Если отпечатки совпадают, то устанавливаем сертификат, иначе пропускаем установку сертифката
	УстанавливатьСертификат = Истина;
	ЭтоВторичноеЗаявление = ПараметрыФункции.ЭтоВторичноеЗаявление;
	ОтпечатокИзОтвета = ПараметрыФункции.ОтпечатокСертификатаИзОтвета;
	Если ЭтоВторичноеЗаявление Тогда
		УстанавливатьСертификат = ДокументооборотСКОКлиентСервер.УстанавливатьСертификат(ОтпечатокИзОтвета, Сертификаты);
	Иначе
		УстанавливатьСертификат = Истина;
	КонецЕсли;
	
	// Установка сертификатов
	Если УстанавливатьСертификат Тогда
		ПараметрыРегистрацияУстановитьСертификаты = ПараметрыРегистрацияУстановитьСертификаты();
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияУстановитьСертификаты, ПараметрыФункции);
	
		ОтпечатокСертификата = Неопределено; // Будет загружен в процессе установки сертификатов.
		РезультатУстановкиСертификатов = РегистрацияУстановитьСертификаты(ОтпечатокСертификата, Сертификаты);		
	Иначе
		ОтпечатокСертификата = ОтпечатокИзОтвета;
		РезультатУстановкиСертификатов = Ложь;
	КонецЕсли;

	// Расшифровка данных, хранящихся в зашифрованной области рег. файла
	РезультатРасшифровки 		= Истина;
	АдресВоВременномХранилище 	= ДанныеУзлаКонфиденциальнаяИнформацияАдрес; // Расшифрованные данные помещаются по тому же адресу, где были до расшифровки.
	
	Если РезультатУстановкиСертификатов И Не ФайлИзКэша Тогда

		ВыполнятьРасшифровку = ПараметрыФункции.ВыполнятьРасшифровкуЗашифрованнойЧастиФайлаАвтонастроки;
		
		// Расшифровка
		Если ВыполнятьРасшифровку Тогда
			// Расшифровка на стороне сервера возможна только в случае электронной подписи в модели сервиса.
			// При этом сертификат используется из хранилища сертификатов.
			СообщениеОбОшибкеРасшифровки = "";
			РасшифроватьPKCS7(ДанныеУзлаКонфиденциальнаяИнформацияАдрес, СообщениеОбОшибкеРасшифровки);
			Если ЗначениеЗаполнено(СообщениеОбОшибкеРасшифровки) Тогда
				// Если в случае ошибки расшифровка не выполнена, то зарегистрируем ее, но не прерываемся, а передаем результат расшифровки в последующие процедуры.
				СообщениеОбОшибкеРасшифровки = СтрШаблон("Ошибка при расшифровке рег.данных в процессе автонастройки учетной записи: %1", СообщениеОбОшибкеРасшифровки);
				ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Предупреждение, СообщениеОбОшибкеРасшифровки);
				РезультатРасшифровки = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

	Если УстанавливатьСертификат Тогда
		РезультатРегистрацияУстановитьСертификаты = Новый Структура("РезультатВыполнения, ПараметрыФункции", РезультатУстановкиСертификатов, ПараметрыРегистрацияУстановитьСертификаты);
	Иначе
		РезультатРегистрацияУстановитьСертификаты = Новый Структура("РезультатВыполнения, ПараметрыФункции", Истина, Неопределено);
	КонецЕсли;
		
	ОбработатьОбновлениеПослеКриптографииЗавершение(
		АдресВоВременномХранилище, 
		Неопределено, 
		ВыводитьСообщения, 
		ПараметрыРегистрацияПолучитьДанныеССервера, 
		ПараметрыФункции, 
		Результат, 
		РезультатРасшифровки, 
		РезультатУстановкиСертификатов, 
		УстанавливатьСертификат, 
		ФайлИзКэша,
		РезультатРегистрацияУстановитьСертификаты,
		Новый Структура);
	
КонецПроцедуры

Процедура ОбработатьОбновлениеПослеКриптографииЗавершение(АдресВоВременномХранилище, ВременныйКаталог, ВыводитьСообщения, 
	ПараметрыРегистрацияПолучитьДанныеССервера, ПараметрыФункции, Результат, РезультатРасшифровки, РезультатУстановкиСертификатов, УстанавливатьСертификат, ФайлИзКэша,
	ТрансляцияОшибокУстановкиСертификатов = Неопределено,
	ТрансляцияОшибокРасшифровки = Неопределено)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	// Обновление информации в справочниках
	Если РезультатУстановкиСертификатов И РезультатРасшифровки Тогда
		
		ПараметрыРегистрацияОбновитьСправочники = ПараметрыРегистрацияОбновитьСправочники();
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрацияОбновитьСправочники, ПараметрыФункции);
		
		ПараметрыРегистрацияОбновитьСправочники.ВременныйФайлОбновленийАдрес 	= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		ПараметрыРегистрацияОбновитьСправочники.АдресВоВременномХранилище 		= АдресВоВременномХранилище;
		ПараметрыРегистрацияОбновитьСправочники.ФайлИзКэша 						= ФайлИзКэша;
		
		РезультатОбновленияСправочников = РегистрацияОбновитьСправочники(ПараметрыРегистрацияОбновитьСправочники);
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, ПараметрыРегистрацияОбновитьСправочники);
		
		ЭтоНоваяУчетнаяЗапись = ПараметрыРегистрацияОбновитьСправочники.ЭтоНоваяУчетнаяЗапись;
		СтруктураАвтонастройкиФСС = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиФСС;
		СтруктураАвтонастройкиРПН = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиРПН;
		СтруктураАвтонастройкиФТС = ПараметрыРегистрацияОбновитьСправочники.СтруктураАвтонастройкиФТС;
		
	КонецЕсли;
	
	// Сохранение дополнительных сведений по учетной записи в регистр
	ПараметрыСертификата = Неопределено;
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		ПараметрыУчетнойЗаписи = ПараметрыФункции.УчетнаяЗапись;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВременныйКаталог", ВременныйКаталог);
		ДополнительныеПараметры.Вставить("ВыводитьСообщения", ВыводитьСообщения);
		ДополнительныеПараметры.Вставить("ПараметрыРегистрацияПолучитьДанныеССервера", ПараметрыРегистрацияПолучитьДанныеССервера);
		ДополнительныеПараметры.Вставить("ПараметрыФункции", ПараметрыФункции);
		ДополнительныеПараметры.Вставить("Результат", Результат);
		ДополнительныеПараметры.Вставить("РезультатРасшифровки", РезультатРасшифровки);
		ДополнительныеПараметры.Вставить("РезультатУстановкиСертификатов", РезультатУстановкиСертификатов);
		ДополнительныеПараметры.Вставить("УстанавливатьСертификат", УстанавливатьСертификат);
		ДополнительныеПараметры.Вставить("ПараметрыУчетнойЗаписи", ПараметрыУчетнойЗаписи);
		ДополнительныеПараметры.Вставить("РезультатОбновленияСправочников", РезультатОбновленияСправочников);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФСС", СтруктураАвтонастройкиФСС);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиРПН", СтруктураАвтонастройкиРПН);
		ДополнительныеПараметры.Вставить("СтруктураАвтонастройкиФТС", СтруктураАвтонастройкиФТС);
		ДополнительныеПараметры.Вставить("ЭтоНоваяУчетнаяЗапись", ЭтоНоваяУчетнаяЗапись);
		
		Попытка
			ОтпечатокСертификатаУчетнойЗаписи = ПолучитьОтпечаток(ПараметрыУчетнойЗаписи, "Руководитель", Неопределено);
			Если ЗначениеЗаполнено(ОтпечатокСертификатаУчетнойЗаписи) Тогда
				// Автонастройка сертификатов на стороне сервера возможна только в случае электронной подписи в модели сервиса.
				ПараметрыСертификата = ПолучитьСвойстваСертификатаСубъектаНаСервере(ОтпечатокСертификатаУчетнойЗаписи);
			КонецЕсли;
		Исключение
			ПараметрыСертификата = Неопределено;
		КонецПопытки;
		РезультатВыполнения = Новый Структура("Выполнено, МенеджерКриптографии, СертификатНайден, СвойстваСертификата", Истина, Неопределено, ПараметрыСертификата <> Неопределено, ПараметрыСертификата);
		ОбработатьОбновлениеПослеПоискаСертификатаЗавершение(РезультатВыполнения, ДополнительныеПараметры);
		
	КонецЕсли;
	
	// В настоящее время автонастройка учетной записи при вызове из серверного контекста поддерживается только для направления ФНС, ПФР и ФСС.
	// Для них дополнительных действий больше не требуется, этап автонастройки завершен.
	// Возникающие в процессе автонастройки сообщения о проблемах не являются блокирующими для последующей отправки.
	// В интерактивном режиме работы они выводятся пользователю.
	// В случае вызова автонастройки из серверного контекста они просто игнорируются.
	Если СтруктураАвтонастройкиРПН <> Неопределено
		ИЛИ СтруктураАвтонастройкиФТС <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'ОбработатьОбновлениеПослеКриптографииЗавершение(): автонастройка учетной записи поддерживается только для ФНС, СФР (бывш. ПФР и ФСС)';
								|en = 'ОбработатьОбновлениеПослеКриптографииЗавершение(): account can be set up automatically only for FTS and Social Insurance Fund of Russia (former PF and SSF)'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОбновлениеПослеПоискаСертификатаЗавершение(РезультатВыполнения, ДополнительныеПараметры)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ПараметрыРегистрацияПолучитьДанныеССервера = ДополнительныеПараметры.ПараметрыРегистрацияПолучитьДанныеССервера;
	ПараметрыФункции = ДополнительныеПараметры.ПараметрыФункции;
	РезультатУстановкиСертификатов = ДополнительныеПараметры.РезультатУстановкиСертификатов;
	УстанавливатьСертификат = ДополнительныеПараметры.УстанавливатьСертификат;
	ПараметрыУчетнойЗаписи = ДополнительныеПараметры.ПараметрыУчетнойЗаписи;
	СтруктураАвтонастройкиФСС = ДополнительныеПараметры.СтруктураАвтонастройкиФСС;
	РезультатОбновленияСправочников = ДополнительныеПараметры.РезультатОбновленияСправочников;
	РезультатРасшифровки = ДополнительныеПараметры.РезультатРасшифровки;
	
	ПараметрыСертификата = ?(РезультатВыполнения.Выполнено И РезультатВыполнения.СертификатНайден, РезультатВыполнения.СвойстваСертификата, Неопределено);
	
	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) Тогда
		
		ПараметрыМетода 								= ДокументооборотСКОКлиентСервер.ПараметрыСохранитьДополнительныеРеквизитыУчетнойЗаписи();
		ПараметрыМетода.УчетнаяЗаписьОрганизации 		= ПараметрыУчетнойЗаписи;
		ПараметрыМетода.ПараметрыСертификата 			= ПараметрыСертификата;
		ПараметрыМетода.ВременныйФайлОбновленийАдрес 	= ПараметрыРегистрацияПолучитьДанныеССервера.ВременныйФайлОбновленийАдрес;
		
		ЗаполнитьЗначенияСвойств(ПараметрыМетода, ПараметрыФункции);
		
		СохранитьДополнительныеРеквизитыУчетнойЗаписи(ПараметрыМетода);
		
		ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности = ПараметрыМетода.ТекстОшибокДляМастераПодключенияК1СОтчетности;
		
	КонецЕсли;

	Если (РезультатУстановкиСертификатов ИЛИ НЕ УстанавливатьСертификат) И РезультатРасшифровки И РезультатОбновленияСправочников Тогда
		// производим настройку параметров ФСС
		Если СтруктураАвтонастройкиФСС <> Неопределено И ПараметрыФункции.Организация <> Неопределено Тогда
			ФлагАвтозаполнения = СтруктураАвтонастройкиФСС.ФлагАвтозаполнения;
			Если ФлагАвтозаполнения Тогда
				ОбновитьРегистрыСведенийНастройкиОбменаФСС(
						ПараметрыФункции.Организация,
						СтруктураАвтонастройкиФСС.ОтпечатокСертификата,
						СтруктураАвтонастройкиФСС.СертификатФССОтпечаток,
						СтруктураАвтонастройкиФСС.СертификатФССЭЛНОтпечаток,
						Ложь);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыОбработатьОбновление()

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ПараметрыФункции = ДокументооборотСКОКлиентСервер.ПараметрыОбработатьОбновление();
	
	КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Неопределено, ПараметрыФункции);
	
	Возврат ПараметрыФункции;
	
КонецФункции

Функция ПараметрыРегистрацияПолучитьДанныеССервера() Экспорт

	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("ИдентификаторАбонента");
	ПараметрыФункции.Вставить("СпецоператорСвязи");
	ПараметрыФункции.Вставить("ВременныйФайлОбновленийАдрес");
	ПараметрыФункции.Вставить("УчетнаяЗапись");
	ПараметрыФункции.Вставить("ФайлИзКэша");
	ПараметрыФункции.Вставить("ДанныеУзлаКонфиденциальнаяИнформацияАдрес");
	ПараметрыФункции.Вставить("ВыводитьСообщения", Истина);
	ПараметрыФункции.Вставить("ВызовИзМастераПодключенияК1СОтчетности", Ложь);
	ПараметрыФункции.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", "");
	ПараметрыФункции.Вставить("СсылкаНаЗаявление", Неопределено);
	
	ПараметрыФункции.Вставить("ОбращениеКСерверуОтключено", Ложь);
	
	// требуется для новой учетной записи облачной подписи
	ПараметрыФункции.Вставить("ДействиеОблачнойПодписи", "");
	ПараметрыФункции.Вставить("ОблачныйСертификат", Неопределено);
	ПараметрыФункции.Вставить("СерверОблачнойПодписи", "");
	
	Возврат ПараметрыФункции;
	
КонецФункции

Функция ЭтоУчеткаУП(ДокументDOM, ПараметрыФункции) Экспорт
	
	Если ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности Тогда
		
		ЭтоУП = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(
			ДокументDOM, 
			"ПризнакУполномоченногоПредставителя", 
			Ложь,
			,
			,
			Тип("Булево"));
		
		ЭтоКлиентУП = ПолучитьЗначениеУзлаXML(ДокументDOM, "УполномоченныйПредставитель") <> "";
		Если ЭтоУП ИЛИ ЭтоКлиентУП Тогда
			
			Ошибка = НСтр("ru = 'Использование учётной записи сервиса 1С:Уполномоченный представитель невозможно. Для продолжения работы отправьте заявление на подключение 1С-Отчетности.';
							|en = 'You cannot use the account of 1C:Authorized Representative service. To continue, send an application to connect to 1C Reporting.'");
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
				Ошибка, 
				ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности, 
				ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности, 
				ПараметрыФункции.ВыводитьСообщения);
			
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РегистрацияПолучитьДанныеССервера(
		ПараметрыФункции,
		ПовторятьСоединение = Ложь,
		Сертификаты = Неопределено,
		ОбновленыПодписиСертификатовДокументооборота = Ложь) Экспорт
	
	ВременныйКаталогНаСервере = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	ИмяВременногоФайлаАрхива 		= ВременныйКаталогНаСервере + ПараметрыФункции.ИдентификаторАбонента + ".zip"; 
	ИмяВременногоФайлаОбновлений 	= ВременныйКаталогНаСервере + ПараметрыФункции.ИдентификаторАбонента + ".xml";
	
	Результат = Ложь;
	
	ДатаОбновленияФайлаНаСервере = Дата('00010101');
	
	Если ПараметрыФункции.УчетнаяЗапись <> Неопределено Тогда
		
		ПараметрыФункции.ФайлИзКэша = ПолучитьЗакэшированныйФайлНастроекСпецоператора(
			ИмяВременногоФайлаОбновлений, 
			ПараметрыФункции.УчетнаяЗапись, 
			ДатаОбновленияФайлаНаСервере, 
			ПараметрыФункции.ВыводитьСообщения,
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности, 
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности);
			
	КонецЕсли;
	
	ОбновленоТестовымСервером = Ложь;
	
	ОбновлениеСкачано = Ложь;
	Если НЕ ПараметрыФункции.ОбращениеКСерверуОтключено Тогда
		
		ОбновлениеСкачано = ОбменССерверомСкачатьОбновление(
			ПараметрыФункции.СпецоператорСвязи, 
			ПараметрыФункции.ИдентификаторАбонента, 
			ИмяВременногоФайлаАрхива, 
			ДатаОбновленияФайлаНаСервере, 
			ПараметрыФункции.ВыводитьСообщения, 
			ПараметрыФункции.ВызовИзМастераПодключенияК1СОтчетности, 
			ПараметрыФункции.ТекстОшибокДляМастераПодключенияК1СОтчетности, 
			ПовторятьСоединение);
			
		Если НЕ ОбновлениеСкачано И ПовторятьСоединение Тогда
			ОбновленоТестовымСервером = ЗаменитьФайлАвтонастроекТестовыми(ИмяВременногоФайлаОбновлений);
			Если ОбновленоТестовымСервером <> Истина Тогда
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
	
	Если ОбновлениеСкачано И РазархивироватьФайл(ИмяВременногоФайлаАрхива, ИмяВременногоФайлаОбновлений) <> Неопределено Тогда
		ПараметрыФункции.ФайлИзКэша = Ложь;
		
		ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайлаОбновлений, "windows-1251");
		ТекстФайлаОбновлений = ОбъектЧтениеТекста.Прочитать();
		ОбъектЧтениеТекста.Закрыть();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Автонастройка';
				|en = 'Electronic data interchange with regulatory authorities. Auto configuration.'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Информация,,,
			ПараметрыФункции.ИдентификаторАбонента + ": " + Лев(ТекстФайлаОбновлений, 960));
		
	ИначеЕсли ПараметрыФункции.ФайлИзКэша Тогда
		
	Иначе
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбновленоТестовымСервером <> Истина Тогда
		ЗаменитьФайлАвтонастроекТестовыми(ИмяВременногоФайлаОбновлений);
	КонецЕсли;
	
	ДокументDOM = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗагрузитьФайлXML(ИмяВременногоФайлаОбновлений);

	Если ЭтоУчеткаУП(ДокументDOM, ПараметрыФункции) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Разрешено = Мультирежим.ПользователюРазрешеноВыполнятьАвтонастройку(ДокументDOM, ПараметрыФункции);
	Если НЕ Разрешено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыФункции.ДанныеУзлаКонфиденциальнаяИнформацияАдрес = ПоместитьВоВременноеХранилище(
		Base64Значение(ДокументDOM.ПолучитьЭлементыПоИмени("КонфиденциальнаяИнформация")[0].Текстовоесодержимое),
		ПараметрыФункции.ДанныеУзлаКонфиденциальнаяИнформацияАдрес);
	
	ПараметрыФункции.ВременныйФайлОбновленийАдрес = ПоместитьВоВременноеХранилище(
		Новый ДвоичныеДанные(ИмяВременногоФайлаОбновлений), 
		ПараметрыФункции.ВременныйФайлОбновленийАдрес);
		
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталогНаСервере);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Успешно = ОбновитьПодписиСертификатовДокументооборота(
		ДокументDOM, 
		ПредопределенноеЗначение("Перечисление.СпецоператорыСвязи.КалугаАстрал"));
		
	Если Успешно Тогда
		ОбновленыПодписиСертификатовДокументооборота = Истина;
	КонецЕсли;
	
	ОбновитьВсеСертификатыВУчетнойЗаписиДО(ДокументDOM, Сертификаты, ПараметрыФункции);
	
	Возврат Истина;
	
КонецФункции

// Подключение к эмулятору проверяется этим запросом на эмулятор.
// Если не подключен - вернется код 404 и файл не будет подменен.
//
Функция ЗаменитьФайлАвтонастроекТестовыми(ИмяВременногоФайлаОбновлений)
	
	Попытка
		Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
			URLСервера = "http://ego712.tc7app.com:80";
			СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(URLСервера);
			Если СоединениеHTTP <> Неопределено Тогда
				ЗапросHTTP = Новый HTTPЗапрос("/ego/hs/Agents/AutoSettings/Kaluga/Change");
				ИдентификаторИнформационнойБазы = СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
				НомерОбласти = РаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
				ЗапросHTTP.Заголовки.Вставить("BaseID", ИдентификаторИнформационнойБазы + ?(НомерОбласти = 0, "", "_" + Строка(НомерОбласти)));
				ЗапросHTTP.УстановитьИмяФайлаТела(ИмяВременногоФайлаОбновлений);
				ИмяВременногоФайлаОбновлений_Новый = СтрЗаменить(ИмяВременногоФайлаОбновлений, ".xml", "_test.xml");
				ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP, ИмяВременногоФайлаОбновлений_Новый);
				Если ОтветHTTP.КодСостояния = 200 Тогда
					ИмяВременногоФайлаОбновлений = ИмяВременногоФайлаОбновлений_Новый;
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Ложь;

КонецФункции

Функция ОбменССерверомСкачатьОбновление(СпецоператорСвязи, ИдентификаторАбонента, ИмяВременногоФайлаАрхива, ДатаОбновленияФайлаНаСервере, ВыводитьСообщения, ВызовИзМастераПодключенияК1СОтчетности = ложь, ТекстОшибокДляМастераПодключенияК1СОтчетности = "", ПовторятьСоединение = Ложь)
	
	Сервис = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОбменССерверомСоздатьСервис(
		СпецоператорСвязи, 
		ВызовИзМастераПодключенияК1СОтчетности, 
		ТекстОшибокДляМастераПодключенияК1СОтчетности, , 
		НЕ ПовторятьСоединение);
		
	Если Сервис = Неопределено Тогда
		Если НЕ ПовторятьСоединение Тогда
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(НСтр("ru = 'Не удалось соединиться с сервером обновлений.';
																												|en = 'Cannot connect to the update server.'"),
							ВызовИзМастераПодключенияК1СОтчетности,
							ТекстОшибокДляМастераПодключенияК1СОтчетности,
							ВыводитьСообщения);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	сообщениеОшибки = "";
	
	Попытка
		XDTOРезультат = Сервис.ReceiveUpdatedPacket(Строка(ИдентификаторАбонента),ДатаОбновленияФайлаНаСервере);
	Исключение
		Если НЕ ПовторятьСоединение Тогда
			
			Текст = НСтр("ru = 'Не удалось соединиться с сервером обновлений. ';
						|en = 'Cannot connect to the update server.'") + ИнформацияОбОшибке().Описание;
			Текст = ДокументооборотСКОВызовСервера.ДобавитьТекстОшибкиСертификатаКА(Текст);
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
				Текст,
				ВызовИзМастераПодключенияК1СОтчетности,
				ТекстОшибокДляМастераПодключенияК1СОтчетности,
				ВыводитьСообщения);
				
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	ПовторятьСоединение = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML; 
	ЧтениеXML.УстановитьСтроку(XDTOРезультат);
	ПостроительДОМ = Новый ПостроительDOM();
	ДОМ = ПостроительДОМ.Прочитать(ЧтениеXML);
	УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("code");
	кодРезультата = УзелDOM[0].ТекстовоеСодержимое;
	Результат = Ложь;
	
	Если КодРезультата = "0" Тогда
		УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("packet");
		
		Если УзелDOM.Количество() > 0 Тогда
			ДвоичныеДанные = Base64Значение(УзелDOM[0].ТекстовоеСодержимое);
			ДвоичныеДанные.Записать(ИмяВременногоФайлаАрхива);
			ЧтениеXML.Закрыть();
			Результат = Истина;
			
		Иначе
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(НСтр("ru = 'При получении обновлений возникла ошибка, файл обновлений нечитаем.';
																												|en = 'An error occurred while receiving updates, update file cannot be read.'"),
							ВызовИзМастераПодключенияК1СОтчетности,
							ТекстОшибокДляМастераПодключенияК1СОтчетности,
							ВыводитьСообщения);
		КонецЕсли;
		
	ИначеЕсли КодРезультата = "1" Тогда
		сообщениеОшибки = "На сервере " + """" + СпецоператорСвязи + """" + " не найдена информация о настройках учетной записи (отсутствует файл /" + идентификаторАбонента + ".zip) !";
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																																									|en = '%1'"),сообщениеОшибки),
						ВызовИзМастераПодключенияК1СОтчетности,
						ТекстОшибокДляМастераПодключенияК1СОтчетности,
						ВыводитьСообщения);		
	ИначеЕсли кодРезультата = "11" Тогда
		//версия файла на сервер и в  кэше клиент совпала, скачивать не требуется
	Иначе
		
		УзелDOM = ДОМ.ПолучитьЭлементыПоИмени("errorMessage");
		
		Если УзелDOM.Количество() > 0 Тогда
			сообщениеОшибки = УзелDOM[0].ТекстовоеСодержимое;
			сообщениеОшибки = "При получении обновлений возникла ошибка: " + сообщениеОшибки;
		Иначе
			сообщениеОшибки = "При получении обновлений возникла ошибка: " + кодРезультата;
		КонецЕсли;
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																																									|en = '%1'"),сообщениеОшибки),
				ВызовИзМастераПодключенияК1СОтчетности,
				ТекстОшибокДляМастераПодключенияК1СОтчетности,
				ВыводитьСообщения);	
	КонецЕсли;
	
	ЧтениеXML.Закрыть();
	Возврат Результат;
	
КонецФункции

Процедура РегистрацияСформироватьТаблицуСертификатов(ДокументDOM, Сертификаты, ЛичныеСертификаты = Неопределено);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторАбонента = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПолучитьЗначениеУзлаXML(ДокументDOM, "ИдентификаторАбонента");
	УчетнаяЗапись = УчетнаяЗаписьПоИдентификатору(ИдентификаторАбонента);
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ЭтоМультиРежимИсходный = УчетнаяЗапись.ЭтоМультиРежим;
	Иначе
		ЭтоМультиРежимИсходный = Ложь;
	КонецЕсли;
	
	ЭтоМультиРежим = Мультирежим.ЭтоМультиРежимИзРегФайла(ДокументDOM);
	
	Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП");
	ОтпечаткиПользователей = Мультирежим.СоответствиеПользователейОтпечаткам(ДокументDOM, Узел, Ложь, ЭтоМультиРежим);
	
	Узел = ДокументDOM.ПолучитьЭлементыПоИмени("ПредыдущийСертификат");
	ПредыдущиеСертификаты = Мультирежим.СоответствиеПользователейОтпечаткам(ДокументDOM, Узел,  Истина, Ложь);
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();

	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТипПользователи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("СправочникСсылка.Пользователи"));
	ТипПользователи = Новый ОписаниеТипов(ТипПользователи);

 	ЛичныеСертификаты = Новый ТаблицаЗначений;
	ЛичныеСертификаты.Колонки.Добавить("Отпечаток",    ТипСтрока);
	ЛичныеСертификаты.Колонки.Добавить("Данные");
	ЛичныеСертификаты.Колонки.Добавить("Текущий");
	ЛичныеСертификаты.Колонки.Добавить("Пользователь", ТипПользователи);
		
	Если Сертификаты = Неопределено Тогда
		Сертификаты = Новый ТаблицаЗначений;
		Сертификаты.Колонки.Добавить("Отпечаток",    ТипСтрока);
		Сертификаты.Колонки.Добавить("СерийныйНомер",ТипСтрока);
		Сертификаты.Колонки.Добавить("Хранилище",    ТипСтрока);
		Сертификаты.Колонки.Добавить("Тело",         ТипСтрока);
		Сертификаты.Колонки.Добавить("Комментарий",  ТипСтрока);
		Сертификаты.Колонки.Добавить("ТребуетсяУстановить", ТипБулево);
		Сертификаты.Колонки.Добавить("ЭтоЧужойСертификат", ТипБулево);
		Сертификаты.Колонки.Добавить("ТипПолучателя", ТипСтрока);
		Сертификаты.Колонки.Добавить("Пользователь");
	Иначе
		Сертификаты.Очистить();
	КонецЕсли;
	
	УзелDOM = ДокументDOM.ПолучитьЭлементыПоИмени("ПредыдущийСертификат");
	
	Для Счетчик = 0 по УзелDOM.Количество()-1 Цикл
		
		Узел = УзелDOM[Счетчик];
		
		Отпечаток = Нрег(Узел.Атрибуты.ПолучитьИменованныйЭлемент("Отпечаток").Текстовоесодержимое);
		Хранилище = ВРег(Узел.Атрибуты.ПолучитьИменованныйЭлемент("Хранилище").Текстовоесодержимое);
		Тело =	   Узел.ТекстовоеСодержимое;
		
		Если Хранилище = "MY" Тогда 
			ЛичныйСертификат = ЛичныеСертификаты.Добавить();
			ЛичныйСертификат.Отпечаток = Отпечаток;
			ЛичныйСертификат.Данные = Base64Значение(Тело);
			ЛичныйСертификат.Текущий = Ложь;

			Пользователь = ПредыдущиеСертификаты.Получить(НРег(Отпечаток));
			ЛичныйСертификат.Пользователь = Пользователь;
		КонецЕсли;
		
	КонецЦикла;
	
	УзелDOM = ДокументDOM.ПолучитьЭлементыПоИмени("Сертификат");
	
	Для Счетчик = 0 по УзелDOM.Количество()-1 Цикл
		
		Узел = УзелDOM[Счетчик];
		
		Отпечаток = Нрег(Узел.Атрибуты.ПолучитьИменованныйЭлемент("Отпечаток").Текстовоесодержимое);
		Хранилище = ВРег(Узел.Атрибуты.ПолучитьИменованныйЭлемент("Хранилище").Текстовоесодержимое);
		
		Сертификат = Сертификаты.Добавить();
		Сертификат.Отпечаток = Отпечаток;
		Сертификат.Хранилище = Хранилище;
		Сертификат.Тело 	 = Узел.ТекстовоеСодержимое;
		Сертификат.ТребуетсяУстановить = Ложь;
		Если Узел.Атрибуты.ПолучитьИменованныйЭлемент("ТипПолучателя") <> Неопределено Тогда
			Сертификат.ТипПолучателя = Узел.Атрибуты.ПолучитьИменованныйЭлемент("ТипПолучателя").ТекстовоеСодержимое;
		Иначе
			Сертификат.ТипПолучателя = "";
		КонецЕсли;
		
		Комментарий = Узел.Атрибуты.ПолучитьИменованныйЭлемент("Комментарий");
		
		Если Комментарий = Неопределено Тогда
			Комментарий = "Отпечаток: " + Сертификат.Отпечаток + " для хранилища: " +  Хранилище;
		Иначе
			Комментарий = Комментарий.Текстовоесодержимое;
		КонецЕсли;
		
		Сертификат.Комментарий = Комментарий;
		
		Если Хранилище = "MY" Тогда
			
			Пользователь = ОтпечаткиПользователей.Получить(НРег(Отпечаток));
			
			ЛичныйСертификат =  ЛичныеСертификаты.Добавить();
			ЛичныйСертификат.Отпечаток = Сертификат.Отпечаток;
			ЛичныйСертификат.Данные = Base64Значение(Сертификат.Тело);
			ЛичныйСертификат.Текущий = Истина;
			ЛичныйСертификат.Пользователь = Пользователь;
			
			Сертификат.Пользователь = Пользователь;
			Сертификат.ЭтоЧужойСертификат = 
				ЭтоМультиРежим
				И ЗначениеЗаполнено(ЛичныйСертификат.Пользователь)
				И Пользователь <> ТекущийПользователь;
				
			ЭтоТекущийСертификатТекущегоПользователя = 
				ЗначениеЗаполнено(УчетнаяЗапись)
				И Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток").Отпечаток = Сертификат.Отпечаток;
				
			Если НЕ Сертификат.ЭтоЧужойСертификат И 
				(ЭтоМультиРежим 
				ИЛИ ЭтоМультиРежимИсходный 
				ИЛИ ЭтоТекущийСертификатТекущегоПользователя) Тогда
					
				Сертификат.СерийныйНомер = КриптографияЭДКОСлужебныйВызовСервера.СерийныйНомерСерификата(ЛичныйСертификат.Данные);
				
			КонецЕсли;
				
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗакэшированныйФайлНастроекСпецоператора(ИмяФайлаНастроек, УчетнаяЗапись, ДатаОбновленияФайлаНаСервере, ВыводитьСообщения,ВызовИзМастераПодключенияК1СОтчетности = ложь, ТекстОшибокДляМастераПодключенияК1СОтчетности = "")
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|ФайлыСведенийСпецоператоры.Данные,
	|ФайлыСведенийСпецоператоры.ДатаФайла
	|ИЗ
	|РегистрСведений.ФайлыСведенийСпецоператоры КАК ФайлыСведенийСпецоператоры
	|ГДЕ
	|ФайлыСведенийСпецоператоры.УчетнаяЗапись = &УчетнаяЗапись");
	
	Запрос.Текст = Запрос.Текст + "
	|УПОРЯДОЧИТЬ ПО
	|ФайлыСведенийСпецоператоры.ДатаФайла УБЫВ";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные = Выборка.Данные;
		Если ЗначениеЗаполнено(Данные) Тогда
			Если ИмяФайлаНастроек <> Неопределено Тогда
				Попытка
					
					Данные.Получить().Записать(ИмяФайлаНастроек);
					ДатаОбновленияФайлаНаСервере = Выборка.ДатаФайла;
					Возврат Истина;
				Исключение
					ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СообщитьИлиПередатьВМастерОшибку(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора файла с информацией о настройках учетной записи:"+Символы.ПС+" %1'"),ИнформацияОбОшибке().Описание),
						ВызовИзМастераПодключенияК1СОтчетности,
						ТекстОшибокДляМастераПодключенияК1СОтчетности,
						ВыводитьСообщения);
					Возврат Ложь;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоСообщениеЗашифрованоНаОблачныйСертификат(Адрес, СерийныйНомерТекущегоПользователя = "") Экспорт
	
	Если ЭлектроннаяПодписьВМоделиСервиса.ИспользованиеВозможно() Тогда
		ДанныеКриптосообщения = ПолучитьИзВременногоХранилища(Адрес);
		Если ДанныеКриптосообщения = Base64Значение("") Тогда 
			Возврат Неопределено;
		КонецЕсли;
		
		СвойстваСообщения = СервисКриптографии.ПолучитьСвойстваКриптосообщения(ДанныеКриптосообщения);
		Если СвойстваСообщения.Тип = "envelopedData" Тогда
			
			Для Каждого Получатель Из СвойстваСообщения.Получатели Цикл
				
				СерийныйНомерПолучателя = ПолучитьHexСтрокуИзДвоичныхДанных(Получатель.СерийныйНомер);
				
				Если Врег(СерийныйНомерТекущегоПользователя) = Врег(СерийныйНомерПолучателя)
					ИЛИ НЕ ЗначениеЗаполнено(СерийныйНомерТекущегоПользователя) Тогда
					
					Если Получатель.Свойство("Идентификатор") И ЗначениеЗаполнено(Получатель.Идентификатор) Тогда
						Возврат Истина;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ХранилищеПоПредставлению(Хранилище) Экспорт
	
	Хранилище = СокрЛП(ВРег(Хранилище));
	
	ЛогическиеХранилищаСертификатов = Новый Соответствие;
	ЛогическиеХранилищаСертификатов.Вставить("ROOT", Перечисления.ТипХранилищаСертификатов.КорневыеСертификаты);
	ЛогическиеХранилищаСертификатов.Вставить("MY", Перечисления.ТипХранилищаСертификатов.ПерсональныеСертификаты);
	ЛогическиеХранилищаСертификатов.Вставить("CA", Перечисления.ТипХранилищаСертификатов.СертификатыУдостоверяющихЦентров);
	ЛогическиеХранилищаСертификатов.Вставить("ADDRESSBOOK", Перечисления.ТипХранилищаСертификатов.СертификатыПолучателей);
	
	ТипХранилище = ЛогическиеХранилищаСертификатов.Получить(Хранилище);
	
	ЛогическиеХранилищаСертификатов.Очистить();
	
	Возврат ТипХранилище;
	
КонецФункции

Функция ПараметрыРегистрацияУстановитьСертификаты() Экспорт

	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("ОтпечатокСертификата");
	ПараметрыФункции.Вставить("ВременныйКаталог");
	ПараметрыФункции.Вставить("ПутьКонтейнерЗакрытогоКлюча", Неопределено);
	ПараметрыФункции.Вставить("ТихийРежим");
	ПараметрыФункции.Вставить("РежимАвтонастройки");
	ПараметрыФункции.Вставить("ВызовИзМастераПодключенияК1СОтчетности", Ложь);
	ПараметрыФункции.Вставить("ТекстОшибокДляМастераПодключенияК1СОтчетности", "");
	ПараметрыФункции.Вставить("ЭтоМультиРежим", Ложь);
	
	КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Неопределено, ПараметрыФункции);
	
	Возврат ПараметрыФункции;
	
КонецФункции

Функция ОбновитьСертификатыВУчетнойЗаписиДО(ПараметрыНастройки, ЛичныеСертификаты, ПрочиеСертификаты) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	УчетнаяЗаписьОбъект = УчетнаяЗаписьОбъектИзПараметров(ПараметрыНастройки);
	Если УчетнаяЗаписьОбъект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьИзменение = 0;
	
	СохранитьЛичныеСертификатыВУчетнуюЗапись(
		УчетнаяЗаписьОбъект, 
		ЛичныеСертификаты, 
		ЕстьИзменение);
	
	АктуализироватьТекущиеЛичныеСертификаты(
		УчетнаяЗаписьОбъект, 
		ЛичныеСертификаты, 
		ЕстьИзменение);
		
	ЗаполнитьКриптопровайдерЛичныхСертификатовУчетнойЗаписи(
		УчетнаяЗаписьОбъект, 
		ЕстьИзменение);
		
	СохранитьПрочиеСертификатыВУчетнуюЗапись(
		УчетнаяЗаписьОбъект, 
		ПрочиеСертификаты, 
		ЕстьИзменение);
	
	Если ЕстьИзменение Тогда 
		Попытка
			
			УчетнаяЗаписьОбъект.Записать();
			
			Если ПараметрыНастройки.Свойство("УчетнаяЗапись") Тогда
				ПараметрыНастройки.УчетнаяЗапись = УчетнаяЗаписьОбъект.Ссылка;
			КонецЕсли;
			
		Исключение
			Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстСообщения = СтрШаблон("Не удалось обновить сертификаты учетной записи документооборота. %1", Ошибка);
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами.Обновить сертификаты в учетной записи';
					|en = 'EDI with regulatory authorities.Update certificates in the account'"), 
				УровеньЖурналаРегистрации.Предупреждение,, УчетнаяЗаписьОбъект.Ссылка, ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции
	
Функция РегистрацияУстановитьСертификаты(ОтпечатокСертификата, Сертификаты) Экспорт

	// Устанавливаем сертификаты и обновляем настройки в ИБ.
	Для Каждого СтрокаТаблицы Из Сертификаты Цикл
		
		Если СтрокаТаблицы.ЭтоЧужойСертификат Тогда
			Продолжить;
		КонецЕсли;

		ЛогическоеХранилище = ХранилищеПоПредставлению(СтрокаТаблицы.Хранилище);
		
		Сертификат  = Новый Структура("Отпечаток", СтрокаТаблицы.Отпечаток);
		СвойстваСертификата = КриптографияЭДКО.НайтиСертификат(Сертификат);
		
		// Если свойства не получены, значит надо установить сертификат.
		Если СвойстваСертификата = Неопределено Тогда
			СертификатДвоичныеДанные = Base64Значение(СтрокаТаблицы.Тело);
			ЛогическоеХранилище = ХранилищеПоПредставлению(СтрокаТаблицы.Хранилище);
			ХранилищеСертификатов.Добавить(СертификатДвоичныеДанные, ЛогическоеХранилище);
			СвойстваСертификата = СервисКриптографии.ПолучитьСвойстваСертификата(СертификатДвоичныеДанные);
		КонецЕсли;
		Если ЛогическоеХранилище = Перечисления.ТипХранилищаСертификатов.ПерсональныеСертификаты Тогда //.MY
			ОтпечатокСертификата = СвойстваСертификата.Отпечаток;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// возвращает значение, если оно одно
Функция ПолучитьЭлементУзлаDOM(УзелВладелец, ИмяЭлемента, ТолькоОдин = Истина)
	
	Результат = Новый Массив;

	ДокументВладелец = УзелВладелец.ДокументВладелец;
	РазыменовательИмен = Новый РазыменовательПространствИменDOM(ДокументВладелец);
	НашлиЭлементы = ДокументВладелец.ВычислитьВыражениеXPath(ИмяЭлемента, УзелВладелец, РазыменовательИмен);
	
	ОчереднойЭлемент = НашлиЭлементы.ПолучитьСледующий();
	Пока ОчереднойЭлемент <> Неопределено Цикл
		Результат.Добавить(ОчереднойЭлемент);
		ОчереднойЭлемент = НашлиЭлементы.ПолучитьСледующий();
	КонецЦикла;	
	
	Если ТолькоОдин Тогда
		Если Результат.Количество() > 0 Тогда
			Результат = Результат[0];
		Иначе
			Результат = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначениеУзлаDOM(УзелВладелец, ИмяЭлемента)
	
	Результат = "";
	
	Если УзелВладелец.ИмяУзла = ИмяЭлемента Тогда
		НашлиЭлемент = УзелВладелец;
	Иначе
		НашлиЭлемент = ПолучитьЭлементУзлаDOM(УзелВладелец, ИмяЭлемента);
	КонецЕсли;
	
	Если НашлиЭлемент <> Неопределено Тогда
		Результат = НашлиЭлемент.ТекстовоеСодержимое;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбновитьДанныеОблачнойПодписиВУчетнойЗаписиДО(ПараметрыНастройки, ДокументDOM, ЛичныеСертификаты, ОбновлятьДанные = Истина)
	
	Результат = Неопределено;
	
	ЭтоМультиРежим = Мультирежим.ЭтоМультиРежимИзРегФайла(ДокументDOM);
	
	Если ЭтоМультиРежим 
		ИЛИ НЕ КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно() Тогда
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗаписьОблачнойПодписи = Неопределено;
	ОтпечатокТекущегоСертификата = "";
	СодержимоеТекущегоСертификата = Неопределено;
	НашлиСтроки = ЛичныеСертификаты.НайтиСтроки(Новый Структура("Текущий", Истина));
	Если НашлиСтроки.Количество() > 0 Тогда
		ОтпечатокТекущегоСертификата = НРег(НашлиСтроки[0].Отпечаток);
		СодержимоеТекущегоСертификата = НашлиСтроки[0].Данные;
	КонецЕсли;	
	
	ОбновитьСписокСертификатовDSS = Ложь;
	Если ЗначениеЗаполнено(ОтпечатокТекущегоСертификата) Тогда
		ОбновитьСписокСертификатовDSS = Истина;
		МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
		СертификатОблака = МодульСервисКриптографииDSS.НайтиСертификат(Новый Структура("Отпечаток", ОтпечатокТекущегоСертификата));
		Если СертификатОблака <> Неопределено И СертификатОблака.Выполнено Тогда
			ОбновитьСписокСертификатовDSS = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СоответствиеТипов = СпособыАвторизацииОблачнойПодписи();
	ИНН = ПолучитьЗначениеУзлаDOM(ДокументDOM, "ИНН");
	УзелDOM = ПолучитьЭлементУзлаDOM(ДокументDOM, "ВладельцыЭЦП/ВладелецЭЦП", Ложь);
	
	Для Счетчик = 0 по УзелDOM.Количество() - 1 Цикл
		
		Узел = УзелDOM[Счетчик];
		СНИЛС = ПолучитьЗначениеУзлаDOM(Узел, "СНИЛС");
		Отпечаток = Нрег(ПолучитьЗначениеУзлаDOM(Узел, "Отпечаток"));
		УзелDSS = ПолучитьЭлементУзлаDOM(Узел, "СведенияОПользователеDSS");
		
		Если Отпечаток <> ОтпечатокТекущегоСертификата ИЛИ УзелDSS = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СерверDSS = Неопределено;
		ДействиеОблачнойПодписи = "";
		
		СерверDSS = ПолучитьЭлементУзлаDOM(УзелDSS, "СерверDSS");
		Результат = Новый Структура;
		Результат.Вставить("Логин", ПолучитьАтрибутУзлаXML(УзелDSS, "ИмяПользователя", ""));
		Результат.Вставить("ТелефонМобильный", ПолучитьАтрибутУзлаXML(УзелDSS, "ТелефонМобильный", ""));
		Результат.Вставить("ЭлектроннаяПочта", ПолучитьАтрибутУзлаXML(УзелDSS, "ЭлектроннаяПочта", ""));
		Результат.Вставить("Отпечаток", Отпечаток);
		Результат.Вставить("ВнутреннийИдентификатор", ПолучитьАтрибутУзлаXML(УзелDSS, "ИдентификаторСервиса", ""));
		Результат.Вставить("РежимАутентификации", ПолучитьАтрибутУзлаXML(УзелDSS, "РежимАутентификации", ""));
		Результат.Вставить("СрокДействия", ПолучитьАтрибутУзлаXML(УзелDSS, "СрокДействияQRКода", '00010101'));
		
		УзелДействий = ПолучитьЭлементУзлаDOM(УзелDSS, "//ДействиеОблачнойПодписи", Ложь);
		ВсеДействия = Новый Массив;
		Для СчетчикДействий = 0 По УзелДействий.Количество() - 1 Цикл
			ТекущееДействие = ПолучитьЗначениеУзлаDOM(УзелДействий[СчетчикДействий], "ДействиеОблачнойПодписи");
			ВсеДействия.Добавить(ТекущееДействие);
		КонецЦикла;
		ДействиеОблачнойПодписи = СтрСоединить(ВсеДействия, ",");
		ВнутреннийИдентификатор = "";
		
		Если СерверDSS <> Неопределено Тогда
			
			ОписаниеСервиса = ПолучитьОписаниеСервисаОблачнойПодписи();
			
			АдресСервера = ПолучитьАтрибутУзлаXML(СерверDSS, "АдресDSS", "");
			НаименованиеСервера = АдресСервера;
			ВнутреннийИдентификатор = ПолучитьАтрибутУзлаXML(СерверDSS, "ИдентификаторDSS", "");
			Если ВнутреннийИдентификатор = "realsts" Тогда
				НаименованиеСервера = "1С:DSS";
			КонецЕсли;
			
			ОписаниеСервиса.Наименование = НаименованиеСервера;
			ОписаниеСервиса.АдресСервера = АдресСервера;
			ОписаниеСервиса.СервисПодписи = ПолучитьАтрибутУзлаXML(СерверDSS, "АдресСЭП", "");
			ОписаниеСервиса.СервисИдентификации = ПолучитьАтрибутУзлаXML(СерверDSS, "АдресЦентраИдентификации", "");
			ОписаниеСервиса.СервисПроверки = ПолучитьАтрибутУзлаXML(СерверDSS, "АдресСервисаПроверки", "");
			ОписаниеСервиса.ИдентификаторЦИ = ПолучитьАтрибутУзлаXML(СерверDSS, "ИдентификаторЦИ", "");
			ОписаниеСервиса.ИдентификаторСЭП = ПолучитьАтрибутУзлаXML(СерверDSS, "ИдентификаторСЭП", "");
			ОписаниеСервиса.ВнутреннийИдентификатор = ВнутреннийИдентификатор;
			
			ОписаниеСервиса.Используется = Истина;
			ОписаниеСервиса.ТаймАут = 120;
			ОписаниеСервиса.ВерсияАПИ = ПолучитьАтрибутУзлаXML(СерверDSS, "ВерсияАПИ", "2.0.2882");
			ОписаниеСервиса.АдресЛичногоКабинета = ПолучитьАтрибутУзлаXML(СерверDSS, "АдресЛичногоКабинета", "");
			
			ОграничениеАвторизации = Новый Массив;
			ОграничениеАвторизации.Добавить(СоответствиеТипов[0]); // всегда есть аутентификация по паролю
			
			Если Результат.РежимАутентификации = "ПарольМобильноеПриложение" И ОписаниеСервиса.ВерсияАПИ = "2.0.2882" Тогда
				ОграничениеАвторизации.Добавить(СоответствиеТипов[-2]);
				ОграничениеАвторизации.Добавить(СоответствиеТипов[9]);
			ИначеЕсли Результат.РежимАутентификации = "ПарольМобильноеПриложение" Тогда
				ОграничениеАвторизации.Добавить(СоответствиеТипов[-2]);
				ОграничениеАвторизации.Добавить(СоответствиеТипов[16]);
			КонецЕсли;
			
			ОписаниеСервиса.ОграничениеАвторизации = СтрСоединить(ОграничениеАвторизации, ",");
			
			Результат.Вставить("Сервер", ОписаниеСервиса);
			
		ИначеЕсли Результат <> Неопределено Тогда
			ПараметрыФункции = Новый Структура();
			ПараметрыФункции.Вставить("СпецоператорСвязи", Перечисления.СпецоператорыСвязи.КалугаАстрал); 
			ПараметрыФункции.Вставить("ВнутреннийИдентификатор", Результат.ВнутреннийИдентификатор); 
			МассивСерверов = ОбменССерверомСписокСерверовОблачнойПодписи(ПараметрыФункции);
			Если МассивСерверов.Количество() > 0 Тогда
				Результат.Вставить("Сервер", МассивСерверов[0]);
			Иначе
				Результат.Вставить("Сервер", "");
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если Результат <> Неопределено И ЗначениеЗаполнено(Результат.Сервер) Тогда
		Если СтрНайти(ДействиеОблачнойПодписи, "АктивироватьПароль") = 0 Тогда
			РежимАутентификации = СоответствиеТипов[0];
		Иначе
			РежимАутентификации = СоответствиеТипов[-2];
		КонецЕсли;
		
		УчетнаяЗаписьОблачнойПодписи = СоздатьУчетнуюЗаписьОблачнойПодписи(
					Результат.Сервер, 
					Результат.Логин,
					РежимАутентификации,
					ОбновлятьДанные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УчетнаяЗаписьОблачнойПодписи) И ПараметрыНастройки.Свойство("УчетнаяЗапись") Тогда
		ДатаФормирования = ПолучитьЗначениеУзлаDOM(ДокументDOM, "@ДатаВремяФормирования");
		Если ЗначениеЗаполнено(ДатаФормирования) Тогда
			ДатаФормирования = XMLЗначение(Тип("Дата"), ДатаФормирования);
		Иначе
			ДатаФормирования = ТекущаяДатаСеанса();
		КонецЕсли;
		
		ДанныеОбновления = Новый Структура;
		ДанныеОбновления.Вставить("ИНН", ИНН);
		ДанныеОбновления.Вставить("СНИЛС", СНИЛС);
		ДанныеОбновления.Вставить("Телефон", Результат.ТелефонМобильный);
		ДанныеОбновления.Вставить("ЭлектроннаяПочта", Результат.ЭлектроннаяПочта);
		ДанныеОбновления.Вставить("ОкончаниеДействияВектораАутентификации", Результат.СрокДействия);
		ДанныеОбновления.Вставить("ДатаФормирования", ДатаФормирования);
		ДанныеОбновления.Вставить("Организация", РегистрацияПолучитьОрганизацию(ПараметрыНастройки.УчетнаяЗапись));
		РегистрацияСвойствОблачнойПодписи(УчетнаяЗаписьОблачнойПодписи, ДанныеОбновления);
		
		Если ОбновитьСписокСертификатовDSS Тогда
			ДействиеОблачнойПодписи = ДействиеОблачнойПодписи + ?(ПустаяСтрока(ДействиеОблачнойПодписи), "", ",") + "ОбновитьСписокСертификатов";
		КонецЕсли;
		
		Результат.Вставить("УчетнаяЗаписьОблачнойПодписи", УчетнаяЗаписьОблачнойПодписи);
		МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(УчетнаяЗаписьОблачнойПодписи);
		КриптографияЭДКОКлиентСервер.ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, ПараметрыНастройки);
		ПараметрыНастройки.ДействиеОблачнойПодписи = ДействиеОблачнойПодписи;
		Если ЗначениеЗаполнено(СодержимоеТекущегоСертификата) Тогда
			ПараметрыНастройки.ОблачныйСертификат = Base64Строка(СодержимоеТекущегоСертификата);
		КонецЕсли;
		ПараметрыНастройки.СерверОблачнойПодписи = ВнутреннийИдентификатор;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СлужебныеДанныеОблачнойПодписи(АдресШифрованногоБлока, УчетнаяЗапись, ОблачныйСертификат) Экспорт
	
	Успешно = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресШифрованногоБлока) Тогда
		ДанныеБлока = ПолучитьИзВременногоХранилища(АдресШифрованногоБлока);
	Иначе
		ДанныеБлока = АдресШифрованногоБлока;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Пароль", Неопределено);
	Результат.Вставить("НовыйКлючПриложения", Неопределено);
	Результат.Вставить("КлючПриложения", Неопределено);
	Результат.Вставить("ПодписьПриложения", Неопределено);
	Результат.Вставить("ПодписьПароля", Неопределено);
	Результат.Вставить("ПодписьКодаАктивации", Неопределено);
	Результат.Вставить("Логин", "");
	Результат.Вставить("Владелец", Неопределено);
	Результат.Вставить("ИдентификаторСубъекта", "");
	Результат.Вставить("ОтпечатокСертификата", "");
	Результат.Вставить("ВнутреннийИдентификатор", "");
	
	Если НЕ КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно() Тогда
		Возврат Результат;
	КонецЕсли;
	
	МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
	МодульСервисКриптографииDSSASNКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSASNКлиентСервер");
	
	ВнутреннийИдентификатор = "";
	НашлиСтроки = МодульСервисКриптографииDSS.ПолучитьВсеУчетныеЗаписи(УчетнаяЗапись);
	Если НашлиСтроки.Количество() > 0 Тогда
		Результат.Владелец = НашлиСтроки[0].Владелец;
		Результат.Логин = НашлиСтроки[0].Логин;
		ВнутреннийИдентификатор = НашлиСтроки[0].ВнутреннийИдентификатор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОблачныйСертификат) Тогда
		СертификатПодписи = МодульСервисКриптографииDSSASNКлиентСервер.ПолучитьСвойстваСертификата(Base64Значение(ОблачныйСертификат));
		Результат.ИдентификаторСубъекта = СертификатПодписи.ИдентификаторСубъекта;
		Результат.ОтпечатокСертификата = СертификатПодписи.Отпечаток;
	КонецЕсли;
	
	Пароль = Неопределено;
	КлючПриложения = Неопределено;
	ПодписьПриложения = Неопределено;
	ПодписьПароля = Неопределено;
	ПодписьКодаАктивации = Неопределено;
	
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ДанныеБлока, "windows-1251");
		Текст = "<?xml version=""1.0"" encoding=""windows-1251""?>" + Символы.ПС +
		"<корневойЭлемент>" + Текст + "</корневойЭлемент>"; 
	
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Текст);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM  = ПостроительDOM.Прочитать(ЧтениеXML);
		
		УзелDOM = ПолучитьЭлементУзлаDOM(ДокументDOM.ЭлементДокумента, "//ОблачныйКлюч", Ложь);
		
		Для Счетчик = 0 По УзелDOM.Количество() - 1 Цикл
			
			Узел = УзелDOM[Счетчик];
			
			Сервер = ПолучитьАтрибутУзлаXML(Узел, "ИдентификаторСервиса", "");
			Логин = ПолучитьАтрибутУзлаXML(Узел, "ИмяПользователя", "");
			Пароль = ПолучитьАтрибутУзлаXML(Узел, "Пароль", "");
			ПодписьПароля = ПолучитьАтрибутУзлаXML(Узел, "ПроверочныйКодАктивацииПароля", "");
			ПодписьКодаАктивации = ПолучитьАтрибутУзлаXML(Узел, "ПроверочныйКодПолученияКодаАктивации", "");
			ПодписьПриложения = ПолучитьАтрибутУзлаXML(Узел, "ПроверочныйКодАктивацииКлючаИПолученияКодаАктивации", "");
			НовыйКлючПриложения = ПолучитьЗначениеУзлаDOM(Узел, "QRКодНовый");
			КлючПриложения = ПолучитьЗначениеУзлаDOM(Узел, "QRКод");
			
			Если ЗначениеЗаполнено(НовыйКлючПриложения) Тогда
				КлючПриложения = Base64Значение(НовыйКлючПриложения);
			ИначеЕсли ЗначениеЗаполнено(КлючПриложения) Тогда
				КлючПриложения = Base64Значение(КлючПриложения);
			КонецЕсли;
			
			Если ВнутреннийИдентификатор = Сервер И Результат.Логин = Логин Тогда
				Успешно = Истина;
			КонецЕсли;	
			
		КонецЦикла;
		
	Исключение
		Успешно = Ложь;
		
	КонецПопытки;
	
	Результат.Выполнено = Успешно;
	Результат.ВнутреннийИдентификатор = ВнутреннийИдентификатор;
	Если Успешно Тогда
		Результат.Пароль = Пароль;
		Результат.КлючПриложения = КлючПриложения;
		Результат.ПодписьПриложения = ПодписьПриложения;
		Результат.ПодписьПароля = ПодписьПароля;
		Результат.ПодписьКодаАктивации = ПодписьКодаАктивации;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РегистрацияСвойствОблачнойПодписи(УчетнаяЗаписьОблачнойПодписи, НовыеДанные) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьОблачнойПодписи = РегистрыСведений.НастройкиОбменаСервисаПодписи.СоздатьМенеджерЗаписи();
	ЗаписьОблачнойПодписи.УчетнаяЗапись = УчетнаяЗаписьОблачнойПодписи;
	ЗаписьОблачнойПодписи.Идентификатор = УчетнаяЗаписьОблачнойПодписи.УникальныйИдентификатор();
	ЗаписьОблачнойПодписи.Прочитать();
	
	ЗаполнитьЗначенияСвойств(ЗаписьОблачнойПодписи, НовыеДанные); 
	ЗаписьОблачнойПодписи.УчетнаяЗапись = УчетнаяЗаписьОблачнойПодписи;
	ЗаписьОблачнойПодписи.Идентификатор = УчетнаяЗаписьОблачнойПодписи.УникальныйИдентификатор();
	ЗаписьОблачнойПодписи.ОкончаниеДействияВектораАутентификации = XMLЗначение(Тип("Дата"), НовыеДанные.ОкончаниеДействияВектораАутентификации);
	
	ЗаписьОблачнойПодписи.Записать(Истина);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Функция РегистрацияУстановитьСертификатыОблачнойПодписи(ОтпечатокСертификата, СписокНовыхСертификатов, Сертификаты, МестоХраненияКлюч) Экспорт

	Если НЕ КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СписокНовыхСертификатов = Новый Массив;
	МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
	
	Результат = Истина;
	
	// Устанавливаем сертификаты и обновляем настройки в ИБ.
	Для Каждого СтрокаТаблицы Из Сертификаты Цикл

		Сертификат  = Новый Структура("Отпечаток", СтрокаТаблицы.Отпечаток);
		СвойстваСертификата = КриптографияЭДКО.НайтиСертификатПолучателя(Сертификат);
		
		Попытка
			// Если свойства не получены, значит надо установить сертификат.
			Если СвойстваСертификата = Неопределено И СтрокаТаблицы.Хранилище <> "MY" Тогда
				ПредставлениеСертификата = СтрЗаменить(СтрокаТаблицы.Тело, " ", "");
				СертификатДвоичныеДанные = Base64Значение(ПредставлениеСертификата);
				КриптографияЭДКО.ДобавитьСертификатПолучателя(СертификатДвоичныеДанные, СтрокаТаблицы.Хранилище);
				СвойстваСертификата = КриптографияЭДКО.ПолучитьСвойстваСертификатаПолучателя(СертификатДвоичныеДанные);
			КонецЕсли;
			
			Если СтрокаТаблицы.Хранилище = "MY" Тогда //.MY
				ОтпечатокСертификата = Сертификат.Отпечаток;
				ОписаниеСертификата = Новый Структура("Отпечаток", ОтпечатокСертификата);
				РезультатПоиска = МодульСервисКриптографииDSS.НайтиСертификат(ОписаниеСертификата);
				Если НЕ РезультатПоиска.Выполнено Тогда
					СписокНовыхСертификатов.Добавить(ОтпечатокСертификата);
				КонецЕсли;	
			КонецЕсли;
		Исключение
			Результат = Ложь;
			ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами.РегистрацияУстановитьСертификатОблачнойПодписи()';
						|en = 'EDI with regulatory authorities.РегистрацияУстановитьСертификатОблачнойПодписи()'"),
					УровеньЖурналаРегистрации.Ошибка,,, 
					НСтр("ru = 'Отпечаток';
						|en = 'Thumbprint'") + ": " + СтрокаТаблицы.Отпечаток + Символы.ПС 
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьВсеСертификатыВУчетнойЗаписиДО(ДокументDOM, Сертификаты, ПараметрыФункции) Экспорт
	
	ЛичныеСертификаты = Неопределено;
	РегистрацияСформироватьТаблицуСертификатов(
		ДокументDOM, 
		Сертификаты, 
		ЛичныеСертификаты);
	
	ОбновитьСертификатыВУчетнойЗаписиДО(ПараметрыФункции, ЛичныеСертификаты, Сертификаты);
	ОбновитьДанныеОблачнойПодписиВУчетнойЗаписиДО(ПараметрыФункции, ДокументDOM, ЛичныеСертификаты);
	
КонецПроцедуры 

Функция ПроигнорироватьСертификат(ДокументDOM, СсылкаНаЗаявление, Отпечаток, Хранилище) Экспорт
	
	ЭтоМультиРежим = Мультирежим.ЭтоМультиРежимИзРегФайла(ДокументDOM);
		
	Если ЭтоМультиРежим <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОтпечатокВладельца = РегФайлКА.ОтпечатокMyИзРегФайлаПоЗаявлению(ДокументDOM, СсылкаНаЗаявление);
	
	Проигнорировать = 
		Хранилище = "MY" 
		И ВРег(Отпечаток) <> ВРег(ОтпечатокВладельца);
		
	Возврат Проигнорировать;
	
КонецФункции

Функция УчетнаяЗаписьОбъектИзПараметров(ПараметрыНастройки)
	
	Перем УчетнаяЗапись;
	
	ПараметрыНастройки.Свойство("УчетнаяЗапись", УчетнаяЗапись);
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ПараметрыНастройки.Свойство("НоваяУчетнаяЗапись", УчетнаяЗапись);	
	КонецЕсли;
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота") Тогда 
		УчетнаяЗаписьОбъект = УчетнаяЗапись.ПолучитьОбъект();
	ИначеЕсли ТипЗнч(УчетнаяЗапись) = Тип("СправочникОбъект.УчетныеЗаписиДокументооборота") Тогда 
		УчетнаяЗаписьОбъект = УчетнаяЗапись;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	 Возврат УчетнаяЗаписьОбъект;
	
КонецФункции

Процедура СохранитьЛичныеСертификатыВУчетнуюЗапись(УчетнаяЗаписьОбъект, ЛичныеСертификаты, ЕстьИзменение)
	
	ПараметрыОтбора = Новый Структура;
	
	Для Каждого ЛичныйСертификат Из ЛичныеСертификаты Цикл 
		
		ПараметрыОтбора.Вставить("Отпечаток", ЛичныйСертификат.Отпечаток);
		
		НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыЛичные.НайтиСтроки(ПараметрыОтбора);
		
		// Случай, когда был переход с многопользовательского на однопользовательский режим
		// и поле Пользователь может не совпадать
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Для каждого Строка Из НайденныеСтроки Цикл
				
				Различается = 
					Строка.Пользователь <> ЛичныйСертификат.Пользователь
					ИЛИ Строка.Текущий <> ЛичныйСертификат.Текущий;
				
				Если Различается Тогда
					УчетнаяЗаписьОбъект.СертификатыЛичные.Удалить(Строка);
					ЕстьИзменение = ЕстьИзменение + 1;
				КонецЕсли;
				
			КонецЦикла;
			НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыЛичные.НайтиСтроки(ПараметрыОтбора);
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() = 0 Тогда 
			
			Попытка 
				СвойстваСертификата = Новый СертификатКриптографии(ЛичныйСертификат.Данные);			
			Исключение
				Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстСообщения = СтрШаблон("Не удалось создать СертификатКриптографии. %1", Ошибка);
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами.СохранитьЛичныеСертификатыВУчетнуюЗапись()';
						|en = 'EDI with regulatory authorities.СохранитьЛичныеСертификатыВУчетнуюЗапись()'"), 
					УровеньЖурналаРегистрации.Предупреждение,, УчетнаяЗаписьОбъект.Ссылка, ТекстСообщения);
				Продолжить;
			КонецПопытки;
			
			СертификатАбонента = УчетнаяЗаписьОбъект.СертификатыЛичные.Добавить();
			СертификатАбонента.СерийныйНомер = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(СвойстваСертификата.СерийныйНомер));
			СертификатАбонента.Отпечаток = ЛичныйСертификат.Отпечаток;
			СертификатАбонента.Содержимое = Новый ХранилищеЗначения(ЛичныйСертификат.Данные);
			СертификатАбонента.ПоставщикCN = ИзвлечьCNИздателя(СвойстваСертификата.Издатель);
			СертификатАбонента.ВладелецОГРН = ИзвлечьОГРНСубъекта(СвойстваСертификата.Субъект);
			СертификатАбонента.ВладелецИННЮЛ = ИзвлечьИННЮЛСубъекта(СвойстваСертификата.Субъект);
			СертификатАбонента.ВладелецИНН = ИзвлечьИННСубъекта(СвойстваСертификата.Субъект);
			СертификатАбонента.Пользователь = ЛичныйСертификат.Пользователь;
			СертификатАбонента.Текущий = ЛичныйСертификат.Текущий;
			
			ЕстьИзменение = ЕстьИзменение + 1;
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьПрочиеСертификатыВУчетнуюЗапись(УчетнаяЗаписьОбъект, ПрочиеСертификаты, ЕстьИзменение)
	
	ПараметрыОтбора = Новый Структура;

	Для Каждого ПрочийСертификат Из ПрочиеСертификаты Цикл 
		Если ПрочийСертификат.Хранилище = "MY" Тогда 
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора.Вставить("Отпечаток", ПрочийСертификат.Отпечаток);		
		НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыПрочие.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда 
			
			Попытка 
				ПрочийСертификат_Данные = Base64Значение(ПрочийСертификат.Тело);
				СвойстваСертификата = Новый СертификатКриптографии(ПрочийСертификат_Данные);
			Исключение
				Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстСообщения = СтрШаблон("Не удалось создать СертификатКриптографии. %1", Ошибка);
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами.СохранитьПрочиеСертификатыВУчетнуюЗапись()';
						|en = 'EDI with regulatory authorities.СохранитьПрочиеСертификатыВУчетнуюЗапись()'"), 
					УровеньЖурналаРегистрации.Предупреждение,, УчетнаяЗаписьОбъект.Ссылка, ТекстСообщения);
				Продолжить;
			КонецПопытки;
			
			СертификатАбонента = УчетнаяЗаписьОбъект.СертификатыПрочие.Добавить();
			СертификатАбонента.СерийныйНомер = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(СвойстваСертификата.СерийныйНомер));
			СертификатАбонента.Отпечаток = ПрочийСертификат.Отпечаток;
			СертификатАбонента.Содержимое = Новый ХранилищеЗначения(ПрочийСертификат_Данные);			
			СертификатАбонента.ПоставщикCN = ИзвлечьCNИздателя(СвойстваСертификата.Издатель);
			
			ЕстьИзменение = ЕстьИзменение + 1;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКриптопровайдерЛичныхСертификатовУчетнойЗаписи(УчетнаяЗаписьОбъект, ЕстьИзменение)
	
	ПараметрыОтбора = Новый Структура;
	
	Неизвестные = Новый Соответствие;
	ДляПоиска = Новый Массив;
	Для Каждого ЛичныйСертификат Из УчетнаяЗаписьОбъект.СертификатыЛичные Цикл
		Если ЗначениеЗаполнено(ЛичныйСертификат.Криптопровайдер) Тогда 
			Продолжить;
		КонецЕсли;
		ДляПоиска.Добавить(ЛичныйСертификат.Отпечаток);
		Неизвестные.Вставить(ЛичныйСертификат.Отпечаток, ЛичныйСертификат.Содержимое.Получить());
	КонецЦикла;
	
	СервисОпрошенУспешно = Ложь;
	РежимSaaS = КриптографияЭДКОСлужебныйВызовСервера.ИспользованиеКриптосервисаВозможно();
	Если Неизвестные.Количество() > 0 И РежимSaaS Тогда 		
		Результат = МенеджерСервисаКриптографии.ПоискСертификатаПоОтпечаткуИлиСерийномуНомеру(ДляПоиска,, Истина);
		Если Результат.Выполнено Тогда // Пометим найденную часть личных сертификатов как облачные
			ПараметрыОтбора.Очистить();
			СервисОпрошенУспешно = Истина;
			Для Каждого Найденный Из Результат.Сертификаты Цикл
				ПараметрыОтбора.Вставить("Отпечаток", Найденный.Thumbprint);
				НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыЛичные.НайтиСтроки(ПараметрыОтбора);
				Для Каждого Стр Из НайденныеСтроки Цикл 
					ЕстьИзменение = ЕстьИзменение + 1;
					Стр.Криптопровайдер = Перечисления.ТипыКриптоПровайдеров.CryptoProHSM;
				КонецЦикла;
				Неизвестные.Удалить(Найденный.Thumbprint);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОблачнаяПодписьОпрошенУспешно = Ложь;
	РежимОблачнаяПодпись = КриптографияЭДКО.ИспользованиеОблачнойПодписиВозможно();
	Если Неизвестные.Количество() > 0 И РежимОблачнаяПодпись Тогда 		
		МодульСервисКриптографииDSS = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSS");
		Для Каждого СтрокаМассива Из ДляПоиска Цикл
			СтрокаПоиска = Новый Структура("Отпечаток", СтрокаМассива);
			Результат = МодульСервисКриптографииDSS.НайтиСертификат(СтрокаПоиска);
			ОблачнаяПодписьОпрошенУспешно = Истина;
			Если Результат.Выполнено Тогда // Пометим найденную часть личных сертификатов как облачные
				ПараметрыОтбора.Очистить();
				ПараметрыОтбора.Вставить("Отпечаток", Результат.Отпечаток);
				НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыЛичные.НайтиСтроки(ПараметрыОтбора);
				Для Каждого Стр Из НайденныеСтроки Цикл 
					ЕстьИзменение = ЕстьИзменение + 1;
					Стр.Криптопровайдер = Перечисления.ТипыКриптоПровайдеров.CryptoProDSS;
				КонецЦикла;
				Неизвестные.Удалить(Результат.Отпечаток);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// проверим для какого криптопровайдера изданы оставшиеся нераспознанные сертификаты
	Если Неизвестные.Количество() > 0 
		И (Не РежимSaaS Или СервисОпрошенУспешно) 
		И (Не РежимОблачнаяПодпись Или ОблачнаяПодписьОпрошенУспешно) Тогда
		
		НеизвестныеСписком = Новый Массив;
		Для Каждого Неизвестный Из Неизвестные Цикл 
			НеизвестныеСписком.Добавить(Новый Структура("Сертификат", Неизвестный.Значение));
		КонецЦикла;
		ПараметрыОтбора.Очистить();
		Известные = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьИнформациюОКриптопровайдереПоСертификату(НеизвестныеСписком);
		Для Каждого Неизвестный Из Неизвестные Цикл 
			Если Известные.Количество() = 0 ИЛИ Известные[0].Криптопровайдер = Неопределено Тогда
				Прервать;
			КонецЕсли;
			ПараметрыОтбора.Вставить("Отпечаток", Неизвестный.Ключ);
			НайденныеСтроки = УчетнаяЗаписьОбъект.СертификатыЛичные.НайтиСтроки(ПараметрыОтбора);
			Для Каждого Стр Из НайденныеСтроки Цикл 
				ЕстьИзменение = ЕстьИзменение + 1;
				Стр.Криптопровайдер = Известные[0].Криптопровайдер.ТипКриптопровайдера;
			КонецЦикла;
			Известные.Удалить(0);
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого Строки Из УчетнаяЗаписьОбъект.СертификатыЛичные Цикл
		
		ЭтоCryptoProHSM = Строки.Криптопровайдер = Перечисления.ТипыКриптоПровайдеров.CryptoProHSM;
		
		Если Строки.ЭлектроннаяПодписьВМоделиСервиса <> ЭтоCryptoProHSM Тогда
			Строки.ЭлектроннаяПодписьВМоделиСервиса = ЭтоCryptoProHSM;
		КонецЕсли;

		МодельХранения = ОбработкаЗаявленийАбонентаКлиентСервер.ОпределитьМестоХраненияКлюча(Строки.Криптопровайдер).МодельХраненияЗакрытогоКлюча;
		Если Строки.МодельХраненияЗакрытогоКлюча <> МодельХранения Тогда
			Строки.МодельХраненияЗакрытогоКлюча = МодельХранения;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура АктуализироватьТекущиеЛичныеСертификаты(УчетнаяЗаписьОбъект, ЛичныеСертификаты, ЕстьИзменение)
	
	Для каждого СтрокаТЧ Из УчетнаяЗаписьОбъект.СертификатыЛичные Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Отпечаток", СтрокаТЧ.Отпечаток);
		
		НайденныеЛичныеСертификаты = ЛичныеСертификаты.НайтиСтроки(Отбор);
			
		Если НайденныеЛичныеСертификаты.Количество() > 0 Тогда
			
			Для каждого ЛичныйСертификат Из НайденныеЛичныеСертификаты Цикл
				
				Если ЛичныйСертификат.Текущий <> СтрокаТЧ.Текущий Тогда
					ЕстьИзменение = ЕстьИзменение + 1;
					СтрокаТЧ.Текущий = ЛичныйСертификат.Текущий;
				КонецЕсли;
		
			КонецЦикла;
			
		Иначе
			СтрокаТЧ.Текущий = Ложь;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СервисКриптографии

Процедура РасшифроватьPKCS7(ЗашифрованныйФайл, СообщениеОбОшибке) Экспорт

	// Внимание!
	// ---------
	// В общем модуле КриптографияЭДКОСлужебныйКлиент есть аналогичные процедуры
	// РасшифроватьPKCS7() и РасшифроватьPKCS7ПослеРасшифровкиСервисомКриптографии(),
	// которые используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если НЕ КриптографияЭДКОКлиентСервер.ЭтоАдресВоВременномХранилище(ЗашифрованныйФайл) Тогда
		
		СообщениеОбОшибке = НСтр("ru = 'РасшифроватьPKCS7(): Для электронной подписи в программе данные должны быть переданы как адрес в хранилище';
								|en = 'РасшифроватьPKCS7(): Data must be passed as storage address for the digital signature in the application'");

		Возврат;
	КонецЕсли;

	ПараметрыШифрования = Новый Структура();
	ПараметрыШифрования.Вставить("ИспользоватьДлительныйМаркерБезопасности", Истина); // Для расшифровки можно использовать длительный маркер безопасности.

	РасшифрованныеДанные = Неопределено;
	
	Попытка
		// Чтобы в конфигурациях со старыми версиями БТС не возникали ошибки компиляции,
		// обращаемся к общему модулю через функцию БСП.
		// Для возможности отправки отчетов на стороне сервера из таких конфигураций потребуется обновить БТС до 1.0.17.
		МодульСервисКриптографии = ОбщегоНазначения.ОбщийМодуль("СервисКриптографии");
		РасшифрованныеДанные = МодульСервисКриптографии.РасшифроватьПереборомСертификатов(ЗашифрованныйФайл, , ПараметрыШифрования);	
	Исключение
		СообщениеОбОшибке  = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, СообщениеОбОшибке);
	КонецПопытки;
	
	Если НЕ ПроверитьРезультатВызоваСервисаКриптографии(РасшифрованныеДанные, СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	ИсходныйФайл = ЗашифрованныйФайл;
	
	// Результат необходимо переложить по адресу исходного файла / пути нового файла.
	Если ЭтоАдресВременногоХранилища(РасшифрованныеДанные) Тогда 
		КриптографияЭДКОКлиентСервер.ПереместитьВоВременномХранилище(РасшифрованныеДанные, ИсходныйФайл);
	Иначе // Двоичные данные
		ПоместитьВоВременноеХранилище(РасшифрованныеДанные, ИсходныйФайл);
	КонецЕсли;
		
КонецПроцедуры

Функция ПодписатьИЗашифроватьPKCS7(СертификатПодписанта, ИмяФайлаДанных, СертификатыПолучателей, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В общем модуле КриптографияЭДКОСлужебныйКлиент есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	Если НЕ КриптографияЭДКОКлиентСервер.ЭтоАдресВоВременномХранилище(ИмяФайлаДанных) Тогда
		
		СообщениеОбОшибке = НСтр("ru = 'ПодписатьИЗашифроватьPKCS7(): Для электронной подписи в программе данные должны быть переданы как адрес в хранилище';
								|en = 'ПодписатьИЗашифроватьPKCS7(): Data must be passed as the storage address for the digital signature in the application'");

		Возврат Неопределено;
	КонецЕсли;

	ДанныеФайла = ПолучитьИзВременногоХранилища(ИмяФайлаДанных);

	ПараметрыПодписания = Новый Структура("ОтсоединеннаяПодпись", Ложь);
	
	Попытка
	
		ПодписанныеДанные = СервисКриптографии.Подписать(
			ДанныеФайла, 
			СертификатПодписанта,
			"CMS", 
			ПараметрыПодписания); 
		
	Исключение
		СообщениеОбОшибке  = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, СообщениеОбОшибке);
	КонецПопытки;

	Если НЕ ПроверитьРезультатВызоваСервисаКриптографии(ПодписанныеДанные, СообщениеОбОшибке) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Зашифровываем подписанные данные.
	Попытка

		ЗашифрованныеДанные = СервисКриптографии.Зашифровать(
			ПодписанныеДанные, 
			СертификатыПолучателей, 
			"CMS", Неопределено);
			
	Исключение
		СообщениеОбОшибке  = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, СообщениеОбОшибке);
	КонецПопытки;

	Если НЕ ПроверитьРезультатВызоваСервисаКриптографии(ЗашифрованныеДанные, СообщениеОбОшибке) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ЗашифрованныеДанные, Новый УникальныйИдентификатор);

КонецФункции

Функция ПроверитьРезультатВызоваСервисаКриптографии(Результат, СообщениеОбОшибке)

	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("КодВозврата") Тогда
		// Особая ошибка сервиса криптографии, прекращаем выполнение и передаем информацию о ней вызывающему методу.
		СообщениеОбОшибке = Результат.КодВозврата;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Подписание

Функция ПолучитьНаборДокументовНаПодписаниеФНС(Сообщение, ТипСообщения)
	
	ТипыДИВ = Неопределено;
	СообщениеДокументыКоторогоПодписываются = Неопределено;
	
	// определяем набор документов, которые должны быть подписаны
	Если ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП Тогда
		
		СообщениеДокументыКоторогоПодписываются = Сообщение;
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности);
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение);
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП Тогда
		
		СообщениеДокументыКоторогоПодписываются = Сообщение;
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление);
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП Тогда
		
		СообщениеДокументыКоторогоПодписываются = Новый Массив;
		СообщениеДокументыКоторогоПодписываются.Добавить(Сообщение);
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП Тогда
		
		СообщениеДокументыКоторогоПодписываются = Новый Массив;
		СообщениеДокументыКоторогоПодписываются.Добавить(Сообщение);
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
	ИначеЕсли ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП Тогда
		
		СообщениеДокументыКоторогоПодписываются = Новый Массив;
		СообщениеДокументыКоторогоПодписываются.Добавить(Сообщение);
		
		ТипыДИВ = Новый Массив;
		ТипыДИВ.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении);
		
