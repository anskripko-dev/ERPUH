Функция ХотяБыОднаОрганизацияИспользуетДокументооборот() Экспорт
	
	ОрганизацииСДокументооборотом = Новый Массив;
	
	// Есть учетные записи
	ЭлектронныйДокументооборотАктивен = ЭлектронныйДокументооборотИспользуется();
	Если ЭлектронныйДокументооборотАктивен Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Настроен ЭДО с ФСС
	СписокДопустимыхОрганизацийВОбъектахОбменаФСС = СписокДопустимыхОрганизацийВОбъектахОбменаФСС();
	Для каждого Организация Из СписокДопустимыхОрганизацийВОбъектахОбменаФСС Цикл
		Если Организация.ПометкаУдаления = Ложь Тогда
			Возврат Истина;
		Конецесли;
	КонецЦикла;
	
	// Настроен ЭДО с ФСРАР
	СписокДопустимыхОрганизацийВОбъектахОбменаФСРАР = СписокДопустимыхОрганизацийВОбъектахОбменаФСРАР();
	Для каждого Организация Из СписокДопустимыхОрганизацийВОбъектахОбменаФСРАР Цикл
		Если Организация.ПометкаУдаления = Ложь Тогда
			Возврат Истина;
		Конецесли;
	КонецЦикла;
	
	// Настроен ЭДО с РПН
	СписокДопустимыхОрганизацийВОбъектахОбменаРПН = СписокДопустимыхОрганизацийВОбъектахОбменаРПН();
	Для каждого Организация Из СписокДопустимыхОрганизацийВОбъектахОбменаРПН Цикл
		Если Организация.ПометкаУдаления = Ложь Тогда
			Возврат Истина;
		Конецесли;
	КонецЦикла;
	
	// Настроен ЭДО с ФТС
	СписокДопустимыхОрганизацийВОбъектахОбменаФТС = СписокДопустимыхОрганизацийВОбъектахОбменаФТС();
	Для каждого Организация Из СписокДопустимыхОрганизацийВОбъектахОбменаФТС Цикл
		Если Организация.ПометкаУдаления = Ложь Тогда
			Возврат Истина;
		Конецесли;
	КонецЦикла; 
	
	Возврат Ложь;
	
КонецФункции

Функция ТипКонтролирующегоОрганаДляОбъектаОтправки(Ссылка) 

	Результат = Перечисления.ТипыКонтролирующихОрганов.ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СвойстваОбъекта = СвойстваОбъектовФормы1СОтчетность(Ссылка);
	Если ТипЗнч(СвойстваОбъекта) = Тип("Структура")
		И СвойстваОбъекта.Свойство("ВидКонтролирующегоОргана") Тогда
		Результат = СвойстваОбъекта.ВидКонтролирующегоОргана;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ДополнитьНастройкиПечати(Настройки = Неопределено, ЗначениеПоУмолчанию = Ложь) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = Новый Структура;
	КонецЕсли;
	
	// Настройки дополняем недостающими свойствами
	Если НЕ Настройки.Свойство("ПечататьДокумент") Тогда
		Настройки.Вставить("ПечататьДокумент", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьПодтверждениеОтправки") Тогда
		Настройки.Вставить("ПечататьПодтверждениеОтправки", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьИзвещениеОбОтказеПФР") Тогда
		Настройки.Вставить("ПечататьИзвещениеОбОтказеПФР", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьПротокол") Тогда
		Настройки.Вставить("ПечататьПротокол", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьУведомлениеОбУточнении") Тогда
		Настройки.Вставить("ПечататьУведомлениеОбУточнении", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьПротоколПриема2НДФЛ") Тогда
		Настройки.Вставить("ПечататьПротоколПриема2НДФЛ", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьРеестрСведений2НДФЛ") Тогда
		Настройки.Вставить("ПечататьРеестрСведений2НДФЛ", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьСостояние") Тогда
		Настройки.Вставить("ПечататьСостояние", ЗначениеПоУмолчанию);
	КонецЕсли;	
	
	Если НЕ Настройки.Свойство("ПечататьПодтверждениеДатыОтправки") Тогда
		Настройки.Вставить("ПечататьПодтверждениеДатыОтправки", ЗначениеПоУмолчанию);
	КонецЕсли;	
	
	Если НЕ Настройки.Свойство("ПечататьРезультатПриема") Тогда
		Настройки.Вставить("ПечататьРезультатПриема", ЗначениеПоУмолчанию);
	КонецЕсли;

	Если НЕ Настройки.Свойство("ПечататьРезультатОбработки") Тогда
		Настройки.Вставить("ПечататьРезультатОбработки", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьСообщениеОбОтзыве") Тогда
		Настройки.Вставить("ПечататьСообщениеОбОтзыве", ЗначениеПоУмолчанию);
	КонецЕсли;

	Если НЕ Настройки.Свойство("ПечататьСообщениеОНесоответствиях") Тогда
		Настройки.Вставить("ПечататьСообщениеОНесоответствиях", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьИзвещенияОПолучении") Тогда
		Настройки.Вставить("ПечататьИзвещенияОПолучении", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьОтветНаЗапросИОС") Тогда
		Настройки.Вставить("ПечататьОтветНаЗапросИОС", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПечататьПодтвержденияПолученияЗапросаПФР") Тогда
		Настройки.Вставить("ПечататьПодтвержденияПолученияЗапросаПФР", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПодтверждениеПолученияПисьмаПФР") Тогда
		Настройки.Вставить("ПодтверждениеПолученияПисьмаПФР", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Если НЕ Настройки.Свойство("ПросмотрПодтвержденияПолученияФСГС") Тогда
		Настройки.Вставить("ПросмотрПодтвержденияПолученияФСГС", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучитьТаблицуФайловЦиклаОбмена534(ЦиклОбмена, Настройки, ТранспортныеСообщения = Неопределено) Экспорт
	
	Если ТранспортныеСообщения = Неопределено Тогда
		ТранспортныеСообщения = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена).ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТранспортныеСообщения", ТранспортныеСообщения);
	
	Подзапросы = Новый Массив;
	
	Если Настройки.ПечататьДокумент Тогда
		Подзапросы.Добавить("ВЫБРАТЬ
		                    |	""ПечататьДокумент"" КАК Настройка,
		                    |	""ФайлОтчетности"" КАК ИдТипа,
		                    |	СодержимоеТранспортныхКонтейнеров.Данные КАК Данные,
		                    |	СодержимоеТранспортныхКонтейнеров.Тип КАК Тип,
		                    |	СодержимоеТранспортныхКонтейнеров.ИмяФайла КАК ИмяФайла,
		                    |	"""" КАК ИмяПодписанногоФайла,
		                    |	"""" КАК Сертификат,
		                    |	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение КАК ТранспортноеСообщение,
		                    |	ВЫБОР
		                    |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL
		                    |			ТОГДА ЛОЖЬ
		                    |		КОГДА СостояниеОбъектов.Архивный = ЛОЖЬ
		                    |			ТОГДА ЛОЖЬ
		                    |		ИНАЧЕ ИСТИНА
		                    |	КОНЕЦ КАК ВАрхиве
		                    |ИЗ
		                    |	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
		                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
		                    |		ПО (СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
		                    |			И (СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
		                    |			И (СостояниеОбъектов.Владелец = ЗНАЧЕНИЕ(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
		                    |ГДЕ
		                    |	СодержимоеТранспортныхКонтейнеров.Тип В(&ТипСодержимогоФайлОтчетности)
		                    |	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Тип В(&ТипСообщенияПервичноеСообщениеСодержащееОтчетность)
		                    |	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение В (&ТранспортныеСообщения)
		                    |
		                    |ОБЪЕДИНИТЬ ВСЕ
		                    |
		                    |ВЫБРАТЬ
		                    |	""ПечататьДокумент"" КАК Настройка,
		                    |	""ФайлОтчетностиПодписьНалогоплательщика"",
		                    |	СодержимоеТранспортныхКонтейнеров.Данные,
		                    |	СодержимоеТранспортныхКонтейнеров.Тип,
		                    |	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
		                    |	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла,
		                    |	СодержимоеТранспортныхКонтейнеров.ЭЦПСертификат,
		                    |	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение,
		                    |	ВЫБОР
		                    |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL
		                    |			ТОГДА ЛОЖЬ
		                    |		КОГДА СостояниеОбъектов.Архивный = ЛОЖЬ
		                    |			ТОГДА ЛОЖЬ
		                    |		ИНАЧЕ ИСТИНА
		                    |	КОНЕЦ
		                    |ИЗ
		                    |	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
		                    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
		                    |		ПО (СостояниеОбъектов.Объект = СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение)
		                    |			И (СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
		                    |			И (СостояниеОбъектов.Владелец = ЗНАЧЕНИЕ(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
		                    |ГДЕ
		                    |	СодержимоеТранспортныхКонтейнеров.Тип = &ТипСодержимогоЭлектронноЦифроваяПодпись
		                    |	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Тип В(&ТипСообщенияПервичноеСообщениеСодержащееОтчетность)
		                    |	И СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение В (&ТранспортныеСообщения)
		                    |
		                    |ОБЪЕДИНИТЬ ВСЕ
		                    |
		                    |ВЫБРАТЬ
		                    |	""ПечататьДокумент"" КАК Настройка,
		                    |	""ФайлОтчетностиПодписьНалоговогоОргана"",
		                    |	СодержимоеТранспортныхКонтейнеров.Данные,
		                    |	СодержимоеТранспортныхКонтейнеров.Тип,
		                    |	СодержимоеТранспортныхКонтейнеров.ИмяФайла,
		                    |	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла,
		                    |	СодержимоеТранспортныхКонтейнеров.ЭЦПСертификат,
		                    |	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение,
		                    |	ВЫБОР
		                    |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL
		                    |			ТОГДА ЛОЖЬ
		                    |		КОГДА СостояниеОбъектов.Архивный = ЛОЖЬ
		                    |			ТОГДА ЛОЖЬ
		                    |		ИНАЧЕ ИСТИНА
		                    |	КОНЕЦ
