			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsStatFormEpExtWeb/Stat/List.aspx", 
																									"{FTS}/FtsStatFormEpExtWeb/Stat/List.aspx", 
																									ПараметрыСоединения.СоединениеHTTP);    
			// Создалим объект запроса по файлу
			ЗапросHTTP = Новый HTTPЗапрос();
			ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
			ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляПолученияИдентификатораОтправки, "windows-1251");
			///////////////////////////////////																					
			Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл       
				ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
				ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP, ИмяФайлаОтвета);
			// Обработка исключительных ситуаций ФТС
				Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, ЗапросHTTP.АдресРесурса) Тогда
					Продолжить;
				КонецЕсли;  
				Прервать;
			КонецЦикла;  
			////////////////////////////////////////
		Исключение
			
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			Возврат Ложь;
			
		КонецПопытки;
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
		ТекстОтвета = ФайлОтвета.Прочитать();
		ФайлОтвета.Закрыть();
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) = Ложь Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ИдентификаторРедактированияФормы = ТекстПослеПрефикса(ТекстОтвета, "result:{""id"":""", """");
		Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ИдентификаторВыполненияОтправки) Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = НСтр("ru = 'Ошибка отправки отчета на портале Федеральной таможенной службы.';
																|en = 'An error occurred while sending a report on the Federal Customs Service portal.'");
			Возврат Ложь;
		КонецЕсли;
		
		// получаем сообщения об ошибках
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsDocumentsMvc/PartEdit/Validate/", 
																							"{FTS}/FtsDocumentsMvc/PartEdit/Validate/", 
																							ПараметрыСоединения.СоединениеHTTP) + ИдентификаторРедактированияФормы;		
		ЗапросHTTP = Новый HTTPЗапрос(РесурсНаСервере, ЗаголовкиHTTP);
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		Попытка     
			Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл
				ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.Получить(ЗапросHTTP, ИмяФайлаОтвета);
			// Обработка исключительных ситуаций ФТС
				Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, РесурсНаСервере) Тогда
					Продолжить;
				КонецЕсли;  
				Прервать;
			КонецЦикла;  
			////////////////////////////////////////
		Исключение
			
			ПараметрыСоединения.СоединениеHTTP = Неопределено;
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			Возврат Неопределено;
			
		КонецПопытки; 
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
		ТекстОтвета = ФайлОтвета.Прочитать();
		ФайлОтвета.Закрыть();
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		ТекстыПредупреждений = "";
		ПозицияПослеПостфикса = Неопределено;
		
		МассивТеговОшибок = Новый Массив;
		МассивТеговОшибок.Добавить("validateError");
		МассивТеговОшибок.Добавить("validateWarning");
		Для Каждого ТегОшибки Из МассивТеговОшибок Цикл
			ТекстОтветаКопия = ТекстОтвета;
			Пока ЗначениеЗаполнено(ТекстОтветаКопия) Цикл
				ТекстУзлаПредупреждения = ТекстПослеПрефикса(ТекстОтветаКопия, "<" + ТегОшибки, "</" + ТегОшибки + ">", ПозицияПослеПостфикса);
				Если ТекстУзлаПредупреждения = Неопределено Тогда
					Прервать;
				КонецЕсли;
				
				ТекстПредупреждения = ТекстПослеПрефикса(ТекстУзлаПредупреждения, ">");
				ТекстПредупреждения = Строка(ТекстПредупреждения);
				ТекстПредупреждения = ТекстИзHTML(ТекстПредупреждения);
				
				Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
					ЭлементПредупреждения = ТекстПослеПрефикса(ТекстУзлаПредупреждения, " elname='", "'");
					ЭлементПредупреждения = Строка(ЭлементПредупреждения);
					ЭлементПредупреждения = ТекстИзHTML(ЭлементПредупреждения);
					Если ЗначениеЗаполнено(ЭлементПредупреждения) Тогда
						ТекстПредупреждения = ЭлементПредупреждения + ": " + ТекстПредупреждения;
					КонецЕсли;
					
					ПолеПредупреждения = ТекстПослеПрефикса(ТекстУзлаПредупреждения, " path='", "'");
					ПолеПредупреждения = Строка(ПолеПредупреждения);
					ПолеПредупреждения = ТекстИзHTML(ПолеПредупреждения);
					Если ЗначениеЗаполнено(ПолеПредупреждения) Тогда
						ТекстПредупреждения = ТекстПредупреждения + " (" + ПолеПредупреждения + ")";
					КонецЕсли;
					
					ТекстыПредупреждений = ТекстыПредупреждений + ?(ЗначениеЗаполнено(ТекстыПредупреждений), "
						|", "") + ТекстПредупреждения;
				КонецЕсли;
				
				ТекстОтветаКопия = Сред(ТекстОтветаКопия, ПозицияПослеПостфикса);
			КонецЦикла;
		КонецЦикла;
		
		ПараметрыСоединения.ОписаниеОшибкиСервером = СтрШаблон(
			НСтр("ru = 'При проверке есть предупреждения, в том числе возможна недостоверность заявленных сведений о товарах"
					+ " по средним ценам, весу (в конце в скобках указано поле ошибки с индексом строки товара):
					   |%1
					   |
					   |В большинстве случаев, замечания при поверке достоверности сведений о товарах означают ошибки или опечатки"
					+ " в сведениях о товаре (цене, весе), информацию об этих товарах стоит уточнить у поставщика.
					   |Отправка статистической формы с недостоверными сведениями может стать причиной постановки ее на контроль"
					+ " и последующего привлечения заявителя к административной ответственности (АП) в соответствии с КОАП РФ.
					   |
					   |Существует возможность отправить файл выгрузки отчета с предупреждениями на портале %2'"),
			ТекстыПредупреждений,
			"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List")
			+ " Для отображения полей с ошибками проведите проверку в web-форме статистической формы по кнопке ""Проверить""";
		Возврат Ложь;
	КонецЕсли;
	
	// вместо текста подписываемой выгрузки портал ФТС теперь возвращает его готовый хеш в Base64
	ИмяВременногоФайлаПодписываемойВыгрузки = ПолучитьИмяВременногоФайла();
	ДанныеПодписываемойВыгрузки = Base64Значение(ТекстПодписываемойВыгрузки);
	ДанныеПодписываемойВыгрузки.Записать(ИмяВременногоФайлаПодписываемойВыгрузки);
	ЧтениеФайлаПодписываемойВыгрузки = Новый ЧтениеТекста(ИмяВременногоФайлаПодписываемойВыгрузки, "windows-1251");
	ТекстПодписываемойВыгрузки = ЧтениеФайлаПодписываемойВыгрузки.Прочитать();
	ЧтениеФайлаПодписываемойВыгрузки.Закрыть();
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаПодписываемойВыгрузки);
	
	Если Лев(ТекстПодписываемойВыгрузки, 16) = "ObjectHashBase64" Тогда
		ТекстПодписываемойВыгрузки = Сред(ТекстПодписываемойВыгрузки, 17);
	КонецЕсли;
	ТекстПодписываемойВыгрузки = "<Object xmlns=""http://www.w3.org/2000/09/xmldsig#"" Id=""Object"">" + ТекстПодписываемойВыгрузки + "</Object>";
	
	ИмяВременногоФайлаПодписываемойВыгрузки = ПолучитьИмяВременногоФайла();
	ЗаписьФайлаПодписываемойВыгрузки = Новый ЗаписьТекста(ИмяВременногоФайлаПодписываемойВыгрузки, "windows-1251");
	ЗаписьФайлаПодписываемойВыгрузки.Записать(ТекстПодписываемойВыгрузки);
	ЗаписьФайлаПодписываемойВыгрузки.Закрыть();
	ДанныеПодписываемойВыгрузки = Новый ДвоичныеДанные(ИмяВременногоФайлаПодписываемойВыгрузки);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаПодписываемойВыгрузки);
	ПараметрыСоединения.ПодписываемоеСодержимоеВыгрузки64 = Base64Строка(ДанныеПодписываемойВыгрузки);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ПодписываемоеСодержимоеВыгрузки64) Тогда
		ПараметрыСоединения.ОписаниеОшибкиСервером = НСтр("ru = 'Ошибка отправки отчета на портале Федеральной таможенной службы.';
															|en = 'An error occurred while sending a report on the Federal Customs Service portal.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером);

	
КонецФункции

Функция ЗагрузитьОтчетНаПорталФТС2017(
		ИмяФайлаОтправки,
		КороткоеИмяФайлаВыгрузки,
		ПараметрыОтправки,
		ПараметрыСоединения)
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	РежимыОтправки = ПараметрыОтправки.РежимыОтправки;
	
	Если РежимыОтправки.ЭтоАннулированиеСОтправкойНового Тогда
		
		// посылаем запрос аннулирования с подачей
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=utf-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ПакетДляАннулированияСПодачей = СтрШаблон(
			"{""Item"":{""SoftVersion"":""%1"""
			+ ",""ModelName"":""Подача статистической формы"""
			+ ",""Id"":""%2"""
			+ ",""Icon"":""PageCancel"""
			+ ",""Name"":""Action_Зарегистрирована_Аннулировать_с_подачей"""
			+ ",""DisplayName"":""Аннулировать с подачей новой статформы"""
			+ ",""executing"":true"
			+ ",""Action"":null}}",
			ПараметрыОтправки.ВерсияФормированияВыгрузки + "/" + ПараметрыОтправки.ВерсияОтправкиПортала,
			РежимыОтправки.ИдентификаторНеПринятойОтправкиНаСервере);
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
		ЗаписываемыйФайл.Записать(ПакетДляАннулированияСПодачей);
		ЗаписываемыйФайл.Закрыть();
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		ДокументооборотСКО.ДобавитьЗаголовкиДляТестовогоСервера1С(ЗаголовкиHTTP, ПараметрыСоединения.СоединениеHTTP);
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsStatFormExtServiceWeb/NgActions/ExecuteAction", 
																								"{FTS}/FtsStatFormExtServiceWeb/NgActions/ExecuteAction", 
																								ПараметрыСоединения.СоединениеHTTP);
			// Создалим объект запроса по файлу
			ЗапросHTTP = Новый HTTPЗапрос();
			ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
			ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляАннулированияСПодачей, "utf-8");
			///////////////////////////////////																					
			Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл       
				ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
				ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP, ИмяФайлаОтвета); 
			// Обработка исключительных ситуаций ФТС
				Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, ЗапросHTTP.АдресРесурса) Тогда
					Продолжить;
				КонецЕсли;  
				Прервать;
			КонецЦикла;  
			////////////////////////////////////////
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПараметрыСоединения.СоединениеHTTP.Сервер + ?(ПараметрыСоединения.СоединениеHTTP.Порт <> 80,
				":" + Формат(ПараметрыСоединения.СоединениеHTTP.Порт, "ЧДЦ=; ЧН=; ЧГ="), "") + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Загрузить отчет в ФТС аннулирование';
					|en = 'EDI with regulatory authorities. Import report to FCS cancellation'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ТекстОшибки);
		КонецПопытки;      
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ОтветHTTP <> Неопределено Тогда
			ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
			ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		КонецЕсли;
		
		ОбъектФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		ТекстОтвета = "";
		Если ОбъектФайлОтвета.Существует() Тогда
			ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
			ТекстОтвета = ФайлОтвета.Прочитать();
			ФайлОтвета.Закрыть();
		КонецЕсли;
		
		ИдентификаторЗапросаАннулирования = ТекстПослеПрефикса(ТекстОтвета, """Action"":{""Id"":""", """");
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		// подтверждаем аннулирование
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=utf-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ПакетДляАннулированияСПодачей = СтрШаблон(
			"{""Item"":{""SoftVersion"":""%1"""
			+ ",""ModelName"":""Подача статистической формы"""
			+ ",""Id"":""%2"""
			+ ",""Icon"":""PageCancel"""
			+ ",""Name"":""Action_Зарегистрирована_Аннулировать_с_подачей"""
			+ ",""DisplayName"":""Аннулировать с подачей новой статформы"""
			+ ",""executing"":true"
			+ ",""Action"":"
				+ "{""Id"":""%3"""
				+ ",""Progress"":null,""Script"":null,""Function"":null,""DocumentForSign"":null,""DocumentForFillSave"":null"
				+ ",""DocumentForView"":null,""DocumentForViewSign"":null,""DocumentForPrint"":null,""DocumentEditor"":null"
				+ ",""DocumentInEditor"":null,""SelectChoice"":null,""SelectNotedChoice"":null,""SelectMultipleChoice"":null"
				+ ",""ConfirmBox"":null,""MessageBox"":null,""InfoBox"":"
					+ "{""Title"":""Аннулировать с подачей новой статформы"""
					+ ",""Message"":""При аннулировании СФ с подачей новой СФ взамен - обратите внимание на следующее:"
