						|ГДЕ
						|	СтатусыОтправки.Объект = &Объект");
	Запрос.УстановитьПараметр("Объект", Док);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Получить(0), Перечисления.СтатусыОтправки.ПустаяСсылка());
	
