Функция ЗаявленияПоЭлДокументооборотуСПФР_ИмяФайла(Заявление)
	
	//Структура имени файла, должна быть следующей:
	//ПФР_[рег.номер]_[код ТО ПФР]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код ТО ПФР] - код территориального органа ПФР, принимающего/направляющего сведения, содержащиеся в файле (указывается согласно классификатору территориальных органов ПФР);
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	//
	//Альтернативный вариант при регистрационном номере СФР из 10 цифр:
	//ПФР_[рег.номер]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	
	РегНомер = СокрЛП(Заявление.РегНомерПФР);
	КодТОПФР = СтрЗаменить(СокрЛП(Заявление.Получатель.Код), "-", "");
	Если Заявление.Вид = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение Тогда
		КодДокумента = "ЗПЭД"; // 3.1.3. Заявление на подключение к ЭДО ПФР (ЗПЭД)
	Иначе
		КодДокумента = "ЗОЭД"; // 3.1.4. Заявление на отключение от ЭДО ПФР (ЗОЭД)
	КонецЕсли;
	ДатаФормированияФайла = Формат(ТекущаяДатаСеанса(), "ДФ=ггггММдд");
	
	GUID = Заявление.УникальныйИдентификатор();
	
	ИмяФайла = "ПФР_%1%2_%3_%4_%5.xml";
	ИмяФайла = СтрШаблон(
		ИмяФайла,
		РегНомер,
		?(СтрДлина(РегНомер) = 10, "", "_" + КодТОПФР),
		КодДокумента,
		ДатаФормированияФайла,
		GUID);
	
	Возврат ИмяФайла;
	
КонецФункции

Процедура ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_Руководитель(ЗаписьXML, Заявление)
	
	Если ДействуетФорматАФ245д() Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("ПредставительСотрудник");
	Иначе
		ЗаписьXML.ЗаписатьНачалоЭлемента("Руководитель");
	КонецЕсли;
	
		ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_ФИО(ЗаписьXML, Заявление);
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:Должность", СокрЛП(Заявление.Должность));
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Руководитель

КонецПроцедуры

Процедура ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_ГрЮЛилиИП(ЗаписьXML, Заявление, ЭтоЮридическоеЛицо)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Страхователь");
	
	Если ЭтоЮридическоеЛицо Тогда
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
		Иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЭДО:ЮЛ");
		КонецЕсли;
		
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Заявление.РегНомерПФР));
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:Наименование", СокрЛП(Заявление.НаименованиеПолное));
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:НаименованиеКраткое", СокрЛП(Заявление.НаименованиеКраткое));
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Заявление.ИНН));
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:КПП", СокрЛП(Заявление.КПП));
			
	Иначе
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ИП");
		Иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЭДО:ИП");
		КонецЕсли;
		
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Заявление.РегНомерПФР));
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_ФИО(ЗаписьXML, Заявление);
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:СНИЛС", СокрЛП(Заявление.СНИЛС));
			ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Заявление.ИНН));
			
	КонецЕсли;
		
			Если НЕ ДействуетФорматАФ245д() Тогда
				ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_Адреса(ЗаписьXML, Заявление, ЭтоЮридическоеЛицо);
			КонецЕсли;
			
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Заявление);

		ЗаписьXML.ЗаписатьКонецЭлемента(); // ЭДО:ЮЛ или ЭДО:ИП
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Страхователь
	
КонецПроцедуры

Процедура ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьАтрибутыКорня_АФ241д(ЗаписьXML, Заявление)
	
	Если Заявление.Вид = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение Тогда
