			Объект.СуществующееСообщение = ОтветноеСообщение;
			

			Возврат;
		КонецЕсли;
		
		Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС;
		Объект.ЦиклОбмена = СообщениеОснование.ЦиклОбмена;
		Объект.Отправитель = СообщениеОснование.ЦиклОбмена.Организация;
		Объект.Получатель = СообщениеОснование.ЦиклОбмена.ВнешняяОрганизация;
		Объект.УчетнаяЗапись = СообщениеОснование.УчетнаяЗапись;
		Объект.Статус = Перечисления.СтатусыПисем.Исходящее;
		Объект.Основание = СообщениеОснование;
		Объект.Тема = "ReSign: Stat-Protocol";
		
		НачатьТранзакцию();
		
		// пишем текущее сообщение, чтобы было к чему добавлять вложения
		Попытка
			Объект.Записать();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка записи сообщения %1 цикла обмена %2!';
																							|en = 'An error occurred while writing message %1 of exchange cycle %2.'"),
																						Символ(34) + Объект.Тип + Символ(34),
																						Символ(34) + Объект.ЦиклОбмена + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Объект.ОшибкаЗаполнения = Истина;
			Возврат;
		КонецПопытки;
		
		Объект.ОшибкаЗаполнения = Ложь;
		ЗафиксироватьТранзакцию();
		
	ИначеЕсли СообщениеОснование.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС Тогда
		// формируем подтверждение на входящее неформализованное от ФСГС
		
		ОтветноеСообщение = ОтветноеСообщениеПоСообщениюОснованию(СообщениеОснование, Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС);
		Если ОтветноеСообщение <> Неопределено Тогда
			
			Объект.УжеСуществует = Истина;
			Объект.СуществующееСообщение = ОтветноеСообщение;
			
			Возврат;
		КонецЕсли;
		
		Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоВходящееФСГС;
		Объект.ЦиклОбмена = СообщениеОснование.ЦиклОбмена;
		Объект.Отправитель = СообщениеОснование.ЦиклОбмена.Организация;
		Объект.Получатель = СообщениеОснование.ЦиклОбмена.ВнешняяОрганизация;
		Объект.УчетнаяЗапись = СообщениеОснование.УчетнаяЗапись;
		Объект.Статус = Перечисления.СтатусыПисем.Исходящее;
		Объект.Основание = СообщениеОснование;
		Объект.Тема = "ReSign: Stat-Unformal";
		
		НачатьТранзакцию();
		
		// пишем текущее сообщение, чтобы было к чему добавлять вложения
		Попытка
			Объект.Записать();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка записи сообщения %1 цикла обмена %2!';
																							|en = 'An error occurred while writing message %1 of exchange cycle %2.'"),
																						Символ(34) + Объект.Тип + Символ(34),
																						Символ(34) + Объект.ЦиклОбмена + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Объект.ОшибкаЗаполнения = Истина;
			Возврат;
		КонецПопытки;
		
		Объект.ОшибкаЗаполнения = Ложь;
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьИЗаполнитьОтветноеСообщение(Основание) Экспорт
	
	ОтветноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();

	ОбработкаЗаполненияТранспортногоСообщения(ОтветноеСообщение, Основание);
	
	Если ОтветноеСообщение.ОшибкаЗаполнения = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УжеСуществует = ОтветноеСообщение.УжеСуществует = Истина;
	
	Если УжеСуществует И ОтветноеСообщение.СуществующееСообщение <> Неопределено Тогда
		Ссылка = ОтветноеСообщение.СуществующееСообщение;
	Иначе
		Ссылка = ОтветноеСообщение.Ссылка;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Ссылка",                Ссылка);
	Результат.Вставить("Тип",                   Ссылка.Тип);
	Результат.Вставить("УчетнаяЗапись",         Ссылка.УчетнаяЗапись);
	Результат.Вставить("УжеСуществует",         УжеСуществует);
	Результат.Вставить("СуществующееСообщение", ОтветноеСообщение.СуществующееСообщение);
	
	Возврат Результат;
	
КонецФункции

Функция НужноСоздатьИЗаполнитьОтветноеСообщение(Основание) Экспорт
	
	НужноСоздатьСообщение = Ложь;
	
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.ТранспортноеСообщение")
		ИЛИ НЕ СообщениеРасшифровано(Основание)
		ИЛИ НЕ ЗначениеЗаполнено(Основание.ЦиклОбмена) Тогда
		
		НужноСоздатьСообщение = Истина;
		
	Иначе
		
		ОтветноеСообщение = ОтветноеСообщениеПоСообщениюОснованию(Основание);
		НужноСоздатьСообщение = ОтветноеСообщение = Неопределено;
				
	КонецЕсли;
	
	Возврат НужноСоздатьСообщение;
	
КонецФункции

Функция ОтветноеСообщениеПоСообщениюОснованию(Основание, ТипСообщения = Неопределено) Экспорт
	
	Если ТипСообщения = Неопределено Тогда
		ТипыСообщений = ТипыСообщенийПоТипамОснований();
		ТипСообщения  = ТипыСообщений.Получить(Основание.Тип);
	КонецЕсли;
	
	Если ТипСообщения <> Неопределено Тогда
		// Если сообщение уже создано, то новое создавать не нужно, получем существующее.
		НовыеСообщения = ПолучитьСообщенияВведенныеНаОсновании(Основание, ТипСообщения);
		Если НовыеСообщения.Количество() > 0 Тогда
			ОтветноеСообщение = НовыеСообщения[0];
			Возврат ОтветноеСообщение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// перенесена в контейнер
Функция ОбработатьСодержаниеОснования(Содержание)
	
	Результат = "";
	Для Инд = 1 По СтрЧислоСтрок(Содержание) Цикл
		Результат = Результат + "> " + СтрПолучитьСтроку(Содержание, Инд);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

