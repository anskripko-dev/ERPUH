		ЗапросHTTP = Новый HTTPЗапрос();
		ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
		ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляОтправкиПодписанногоЗапроса, "utf-8");
		///////////////////////////////////																					
		Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл       
