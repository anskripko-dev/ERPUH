Процедура ПолучитьСвойстваОрганизацииДляФСС(
		Организация,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи,
		УчетнаяЗаписьДокументооборота = Неопределено,
		ПараметрыФорматов = Неопределено) Экспорт
	
	ОрганизацияИспользуетОбменСФСС = Ложь;
	НастроенОбменВУниверсальномФормате = Ложь;
	
	ОрганизацияИспользуетОбменСФСС = ОрганизацияИспользуетОбменСФСС(Организация, ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи);
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена");
	
	УчетнаяЗаписьДокументооборота = СвойстваОрганизации.УчетнаяЗаписьОбмена;
	
	Если СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
		И ЗначениеЗаполнено(УчетнаяЗаписьДокументооборота) Тогда
		НастроенОбменВУниверсальномФормате = Истина;
	КонецЕсли;
	
	Если ПараметрыФорматов <> Неопределено И ПараметрыФорматов.Свойство("ПараметрыФорматаЭЛН")
		И ПараметрыФорматов.ПараметрыФорматаЭЛН = Неопределено Тогда
		
		ПараметрыФорматов.ПараметрыФорматаЭЛН = ПараметрыФорматаЭЛН();
	КонецЕсли;
	
КонецПроцедуры

Функция ОтправкаЗашифрованногоПакетаНаСерверФСС(
		АдресСервера,
		ИмяФайлаОтправки,
		ТипОтправляемогоДокумента = Неопределено,
		ВидОтправляемогоДокумента = Неопределено,
		КороткоеИмяФайлаПакета = Неопределено,
		НастройкиОтправки = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", 			Неопределено);
	Результат.Вставить("ОписаниеОшибкиСервером", 	Неопределено);
	Результат.Вставить("ОтветПолучен", 				Ложь);
	Результат.Вставить("СкрытьПрефиксОшибки", 		Ложь);
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС);
	ЭтоПодтверждениеВидаДеятельности =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента =
		Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам);
	ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	Если ЭтоДанныеЭЛН
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.реестра ЭЛН") Тогда
		
		Результат.ОписаниеОшибкиСервером =
			НСтр("ru = 'Отправка страхователем реестров ЭЛН не предусмотрена законодательством РФ. Для оплаты ЭЛН необходимо предоставить ответ на запрос СФР (101 сообщение СЭДО) или предоставить сведения для назначения по 20-ФЗ';
				|en = 'An insurant cannot send an electronic sick leave record registry according to the legislation of the Russian Federation. To pay for the electronic sick leave records, submit a response to the Social Insurance Fund request or information records for assigning based on 20-FZ'");
		Результат.ОтветПолучен = Истина;
		Результат.СкрытьПрефиксОшибки = Истина;
		Возврат Результат;
	КонецЕсли;
		
	// устанавливаем соединение с сервером
	ОписаниеОшибкиУстановкиСоединения = "";
	ТаймаутСоединения = 300;
	Если ЭтоДанныеЭЛН И нрег(АдресСервера) = "eln.sfr.gov.ru"
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам
			И (нрег(АдресСервера) = "ecp.sfr.gov.ru" ИЛИ нрег(АдресСервера) = "ecp-test.sfr.gov.ru") Тогда
		
		ТаймаутИлиНастройки = Новый Структура;
		ТаймаутИлиНастройки.Вставить("Таймаут", 				ТаймаутСоединения);
		ТаймаутИлиНастройки.Вставить("ЗащищенноеСоединение", 	Новый ЗащищенноеСоединениеOpenSSL);
		
	Иначе
		ТаймаутИлиНастройки = ТаймаутСоединения;
	КонецЕсли;
	Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(
		?(ЭтоПодписьИШифрованиеSOAP, "https://", "") + АдресСервера,
		ОписаниеОшибкиУстановкиСоединения,
		ТаймаутИлиНастройки);
	Если Соединение = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сервером:
								 |%1';
								 |en = 'Cannot connect to server:
								 |%1'");
		Результат.ОписаниеОшибкиСервером = СтрШаблон(ТекстОшибки, ОписаниеОшибкиУстановкиСоединения);
		Результат.ОтветПолучен = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоДанныеЭЛН Тогда
		ПараметрыФормата = ПараметрыФорматаЭЛН();
		ЭтоВерсия1X = Лев(ПараметрыФормата.Версия, 2) = "1.";
		РесурсНаСервере = ?(ЭтоВерсия1X, "/ws-insurer-crypto-v11/FileOperationsLnPort",
			?(нрег(АдресСервера) = "eln.sfr.gov.ru", "/ws-insurer-crypto/FileOperationsLnService",
			"/ws-insurer-crypto-v20/FileOperationsLnService"));
		
	ИначеЕсли ЭтоПодтверждениеВидаДеятельности Тогда
		РесурсНаСервере = "/ws-gtw-okved-confirm/api/soap/v1/OkvedconfirmGatewayService";
		
	ИначеЕсли ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ССВ в ЕЦП", Истина) Тогда
			РесурсНаСервере = "/vnim/quarantine/QuarantineStatementServicePorts?wsdl";
		Иначе
			Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
				РесурсНаСервере = "/ws-quarantine-crypto/api/soap/QuarantineStatementServicePorts?wsdl";
			Иначе
				РесурсНаСервере = "/ws-quarantine/api/soap/QuarantineStatementServicePorts?wsdl";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
		И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС Тогда
		
		РесурсНаСервере = "/F4ExtService/ExtService.svc";
		ПространствоИменСервиса = "http://tempuri.org/";
		ИмяСервиса = "IExtService";
		
	Иначе
		РесурсНаСервере = "/ExtService/GatewayService.svc";
		ПространствоИменСервиса = "http://asystems.fss";
		ИмяСервиса = "IGatewayService";
	КонецЕсли;
	
	РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(РесурсНаСервере, "{FSS}" + РесурсНаСервере, Соединение);
	
	Если ЭтоПодписьИШифрованиеSOAP Тогда
		// формируем общие заголовки зашифрованного запроса SOAP
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "text/xml; charset=utf-8");
		Если ЭтоПодтверждениеВидаДеятельности Тогда
			ЗаголовкиHTTP.Вставить("SOAPAction", "http://gtw.ws.fss.ru/openservice/okvedconfirm/confirmOkved");
		ИначеЕсли ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			ДанныеПодписанногоSOAP = ?(ЗначениеЗаполнено(НастройкиОтправки.ПодписанныйSOAP64),
				?(ЭтоАдресВременногоХранилища(НастройкиОтправки.ПодписанныйSOAP64),
				ПолучитьИзВременногоХранилища(НастройкиОтправки.ПодписанныйSOAP64),
				Base64Значение(НастройкиОтправки.ПодписанныйSOAP64)), "");
			ЭтоРеестрСтимулирующихВыплат2023 = СтрНайти(ПолучитьСтрокуИзДвоичныхДанных(ДанныеПодписанногоSOAP, "windows-1251"),
				"<submit2023WorkerRegistrRequest ") <> 0;
			ЭтоРеестрСтимулирующихВыплатГосслужащим = СтрНайти(ПолучитьСтрокуИзДвоичныхДанных(ДанныеПодписанногоSOAP, "windows-1251"),
				"<PaymentsFederalCivilServantsRequest ") <> 0;
			ЗаголовкиHTTP.Вставить("SOAPAction",
				?(ЭтоРеестрСтимулирующихВыплат2023,
				"http://www.fss.ru/integration/ws/eln/quarantineStatement/Submit2023WorkerRegist/v01",
				?(ЭтоРеестрСтимулирующихВыплатГосслужащим,
				"http://www.fss.ru/integration/ws/eln/quarantineStatement/SubmitPaymentsFederalCivilServants/v01",
				"http://www.fss.ru/integration/ws/eln/quarantineStatement/SubmitCovidWorkerRegist/v01")));
		КонецЕсли;
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		
		ИмяФайлаSOAP = ИмяФайлаОтправки;
		
	Иначе
		ДвоичныеДанныеПакета = Новый ДвоичныеДанные(ИмяФайлаОтправки);
		ДанныеПакетаВBase64 = Base64Строка(ДвоичныеДанныеПакета);
		
		// формируем общие заголовки запроса SOAP
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/soap+xml; charset=utf-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		
		ДанныеПакетаВBase64БезПереводовСтрок = СтрЗаменить(ДанныеПакетаВBase64, Символы.ВК, "");
		ДанныеПакетаВBase64БезПереводовСтрок = СтрЗаменить(ДанныеПакетаВBase64БезПереводовСтрок, Символы.ПС, "");
		ТекстЗапросаSOAP =
			"<s:Envelope xmlns:s=""http://www.w3.org/2003/05/soap-envelope"" xmlns:a=""http://www.w3.org/2005/08/addressing"">
			|	<s:Header>
			|		<a:Action s:mustUnderstand=""1"">" + ПространствоИменСервиса + ?(Прав(ПространствоИменСервиса, 1) <> "/", "/", "")
						+ ИмяСервиса + "/SendFile</a:Action>
			|		<a:To s:mustUnderstand=""1"">http://" + АдресСервера + РесурсНаСервере + "</a:To>"
			+ ?(ЗначениеЗаполнено(НастройкиОтправки.МЧД), "
			|		<wsse:Security xmlns:ds=""http://www.w3.org/2000/09/xmldsig#"" "
							+ "xmlns:wsse=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"" "
							+ "xmlns:wsu=""http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"">
			|			<Signature xmlns=""http://www.w3.org/2000/09/xmldsig#"">
			|				<object>
			|					<urn:authorities xmlns:urn=""urn:ru:fss:integration:types:signature:v01"" "
										+ "xmlns:urn1=""urn:ru:fss:integration:types:mchd:v01"" "
										+ "xmlns:v01=""http://www.fss.ru/integration/types/common/v01"">
			|						<urn:authority>
			|							<urn1:powerOfAttorneyLink>
			|								<urn1:uuid>" + НастройкиОтправки.МЧД + "</urn1:uuid>
			|							</urn1:powerOfAttorneyLink>
			|						</urn:authority>
			|					</urn:authorities>
			|				</object>
			|			</Signature>
			|		</wsse:Security>", "") + "
			|	</s:Header>
			|	<s:Body>
			|		<SendFile xmlns=""" + ПространствоИменСервиса + """>
			|			<data>" + ДанныеПакетаВBase64БезПереводовСтрок + "</data>
			|			<fileName>" + КороткоеИмяФайлаПакета + "</fileName>
			|		</SendFile>
			|	</s:Body>
			|</s:Envelope>";
		
		ИмяФайлаSOAP = ПолучитьИмяВременногоФайла();
		ТекстовыйФайлSOAP = Новый ЗаписьТекста(ИмяФайлаSOAP, "utf-8");
		ТекстовыйФайлSOAP.Записать(ТекстЗапросаSOAP);
		ТекстовыйФайлSOAP.Закрыть();
	КонецЕсли;
	
	ДокументооборотСКО.ДобавитьЗаголовкиДляТестовогоСервера1С(ЗаголовкиHTTP, Соединение);
	
	// посылаем запрос
	Результат.ОтветПолучен = Истина;
	
	ФайлРезультата = ПолучитьИмяВременногоФайла();
	Попытка
		Соединение.ОтправитьДляОбработки(ИмяФайлаSOAP, РесурсНаСервере, ФайлРезультата, ЗаголовкиHTTP);
		Соединение = Неопределено;
	Исключение
		Если НЕ ЭтоПодписьИШифрованиеSOAP Тогда
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаSOAP);
		КонецЕсли;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ИнформацияОбОшибкеОсновная = ИнформацияОбОшибке;
		
		Для ИндексПричиныОшибки = 1 По 5 Цикл
			Если НЕ ЭтоПодписьИШифрованиеSOAP И СтрНайти(ИнформацияОбОшибке.Описание, "ExtServiceException") > 0 Тогда
				Если СтрНайти(ИнформацияОбОшибке.Описание, "Неверное имя файла") > 0 Тогда
					Результат.ОписаниеОшибкиСервером = НСтр("ru = 'Неверное имя файла.';
															|en = 'Incorrect file name.'");
				Иначе
					ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Сбой на сервере ФСС.';
							|en = 'SSF server failed.'"), Истина);
					Результат.ОписаниеОшибкиСервером = ТекстОшибки;
				КонецЕсли;
				Возврат Результат;
				
			ИначеЕсли ЭтоПодписьИШифрованиеSOAP
				И СтрНайти(ИнформацияОбОшибке.Описание, "http://schemas.xmlsoap.org/soap/envelope/") > 0
				И СтрНайти(ИнформацияОбОшибке.Описание, "<faultstring>") > 0 Тогда
				
				Результат.ОписаниеОшибкиСервером = ТекстПослеПрефикса(ИнформацияОбОшибке.Описание, "<faultstring>", "<");
				Результат.ОписаниеОшибкиСервером = ТекстИзHTML(Результат.ОписаниеОшибкиСервером);
				ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка сервера ФСС.';
						|en = 'SSF server error.'"), Истина);
				Результат.ОписаниеОшибкиСервером = ТекстОшибки + " "
					+ СокрЛ(Результат.ОписаниеОшибкиСервером);
				Результат.ОписаниеОшибкиСервером = СокрЛП(Результат.ОписаниеОшибкиСервером);
				Возврат Результат;
				
			ИначеЕсли ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
				И (СтрНайти(ИнформацияОбОшибке.Описание, "<ErrorMessage>") > 0
				ИЛИ СтрНайти(ИнформацияОбОшибке.Описание, "Fault>") > 0) Тогда
				
				ТекстОшибки = ТекстПослеПрефикса(ИнформацияОбОшибке.Описание,
					"<ErrorMessage>", "</");
				Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
					ТекстОшибки = ТекстПослеПрефикса(ИнформацияОбОшибке.Описание,
						"Text xml:lang=""ru-RU"">", "</");
				КонецЕсли;
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					Результат.ОписаниеОшибкиСервером = СокрЛП(ТекстОшибки);
					ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Ошибка сервера ФСС.';
							|en = 'SSF server error.'"), Истина);
					Результат.ОписаниеОшибкиСервером = ТекстОшибки + " "
						+ ТекстИзHTML(Результат.ОписаниеОшибкиСервером);
					Возврат Результат;
					
				КонецЕсли;
				
			ИначеЕсли ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
				И (СтрНайти(ИнформацияОбОшибке.Описание, "внутренняя ошибка сервера") > 0
				ИЛИ СтрНайти(ИнформацияОбОшибке.Описание, "(500)") > 0) Тогда
				
				ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка сервера ФСС. ';
						|en = 'SSF server error.'"), Истина);
				Результат.ОписаниеОшибкиСервером = ТекстОшибки + ИнформацияОбОшибке.Описание;
				Возврат Результат;
			КонецЕсли;
			
			Если ИнформацияОбОшибке.Причина = Неопределено Тогда
				Прервать;
			КонецЕсли;
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		
		Результат.ОтветПолучен = Ложь;
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Отправка в СФР';
				|en = 'EDI with regulatory authorities. Send to Social Insurance Fund of Russia'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибкеОсновная));
		Возврат Результат;
	КонецПопытки;
	
	ТекстовыйФайлРезультата = Новый ЧтениеТекста(ФайлРезультата, "utf-8");
	ТекстРезультата = ТекстовыйФайлРезультата.Прочитать();
	ТекстовыйФайлРезультата.Закрыть();
	Если НЕ ЭтоПодписьИШифрованиеSOAP Тогда
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаSOAP);
	КонецЕсли;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультата);
	
	Если НЕ ЗначениеЗаполнено(ТекстРезультата) Тогда
		ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Сбой на сервере ФСС.';
				|en = 'SSF server failed.'"), Истина);
		Результат.ОписаниеОшибкиСервером = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	РезультатИзвлечения = ИзвлечьРезультатSOAP(
		ТекстРезультата,
		?(ЭтоПодписьИШифрованиеSOAP, "", "SendFile"),
		ЭтоПодписьИШифрованиеSOAP);
	УзелРезультата 	= РезультатИзвлечения.УзелРезультата;
	ТекстОшибки 	= РезультатИзвлечения.ТекстОшибки;
	
	Если ЭтоПодписьИШифрованиеSOAP Тогда
		Результат.Идентификатор = ?(УзелРезультата <> Неопределено, ТекстРезультата, "");
		
	Иначе
		УзелExtID = НайтиУзел(УзелРезультата, "ExtID");
		
		Результат.Идентификатор = ?(УзелExtID <> Неопределено, СокрЛП(УзелExtID.Значение), Неопределено);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат.Идентификатор) Тогда
		ТекстОшибкиПредставление = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Ошибка формата ответа сервера ФСС!';
				|en = 'Error in SSF server response format.'"), Истина);
		Результат.ОписаниеОшибкиСервером = ?(ЗначениеЗаполнено(ТекстОшибки),
			ТекстОшибки, ТекстОшибкиПредставление);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьРезультатSOAP(ТекстРезультата, ИмяФункции, ЭтоПодписьИШифрованиеSOAP = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("УзелРезультата", 	Неопределено);
	Результат.Вставить("ТекстОшибки", 		"");
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(Неопределено, ТекстРезультата);
	Если ДеревоXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелEnvelope = НайтиУзел(ДеревоXML, "Envelope");
	Если УзелEnvelope = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелBody = НайтиУзел(УзелEnvelope, "Body");
	Если УзелBody = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоПодписьИШифрованиеSOAP Тогда
		УзелЗашифрованныхДанных = НайтиУзел(УзелBody, "EncryptedData");
		Если УзелЗашифрованныхДанных <> Неопределено Тогда
			
			Результат.УзелРезультата = УзелЗашифрованныхДанных;
			Возврат Результат;
			
		КонецЕсли;
		
	Иначе
		УзелОтветаФункции = НайтиУзел(УзелBody, ИмяФункции + "Response");
		Если УзелОтветаФункции <> Неопределено Тогда
			
			УзелРезультата = НайтиУзел(УзелОтветаФункции, ИмяФункции + "Result");
			Если УзелРезультата <> Неопределено Тогда
				
				Результат.УзелРезультата = УзелРезультата;
				Возврат Результат;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	УзелFault = НайтиУзел(УзелBody, "Fault");
	Если УзелFault = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелDetail = НайтиУзел(УзелFault, "Detail");
	Если УзелDetail = Неопределено Тогда
		УзелFaultString = НайтиУзел(УзелFault, "faultstring");
		Если УзелFaultString = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Результат.ТекстОшибки = XMLЗначение(Тип("Строка"), УзелFaultString.Значение);
		Возврат Результат;
	КонецЕсли;
	
	УзелGeneralFault = НайтиУзел(УзелDetail, "GeneralFault");
	Если УзелGeneralFault = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелErrorMessage = НайтиУзел(УзелGeneralFault, "ErrorMessage");
	Если УзелErrorMessage = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ТекстОшибки = XMLЗначение(Тип("Строка"), УзелErrorMessage.Значение);
	Возврат Результат;
	
КонецФункции

Функция НайтиУзел(ОбъектXML, Имя, ВернутьВсе = Ложь)
	
	Если ОбъектXML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ?(ВернутьВсе, Новый Массив, Неопределено);
	ДлинаИмени = СтрДлина(Имя);
	Для каждого СтрокаXML Из ОбъектXML.Строки Цикл
		// поиск без учета пространств имен
		Если СтрокаXML.Имя = Имя ИЛИ Прав(СтрокаXML.Имя, ДлинаИмени + 1) = ":" + Имя Тогда
			Если ВернутьВсе Тогда
				Результат.Добавить(СтрокаXML);
				
			Иначе
				Результат = СтрокаXML;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодировать(
		Владелец,
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		КодировкаИсходника = Неопределено,
		ПреобразоватьИзКодировки = Неопределено) Экспорт
	
	// получаем электронное представление
	ХранилищеВыгрузки = "";
	ИмяФайлаВыгрузки = "";

	ФайлВАрхиве = Ложь;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
						  |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла,
						  |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.Данные
						  |	, ВЫБОР
						  |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL ТОГДА Ложь
						  |		КОГДА СостояниеОбъектов.Архивный = Ложь ТОГДА Ложь
						  |	ИНАЧЕ
						  |		Истина
						  |	КОНЕЦ ВАрхиве
						  |ИЗ
						  |	РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов КАК ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
						  |
						  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
						  |			ПО 		(СостояниеОбъектов.Объект = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление)
						  |				И	(СостояниеОбъектов.ИмяФайла = ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ИмяФайла)
						  |				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов))
						  |
						  |ГДЕ
						  |	ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов.ЭлектронноеПредставление = &ЭлектронноеПредставление");
	
	Запрос.УстановитьПараметр("ЭлектронноеПредставление", Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.ВАрхиве Тогда
				ИмяФайлаВыгрузки = "";
				ХранилищеВыгрузки = Неопределено;
				ФайлВАрхиве = Истина;
			Иначе
				ИмяФайлаВыгрузки = СокрЛП(Выборка.ИмяФайла);
				ХранилищеВыгрузки = Выборка.Данные;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяФайлаВыгрузки = "" ИЛИ ХранилищеВыгрузки = Неопределено Тогда
		Если ФайлВАрхиве Тогда
			ТекстСообщения = НСтр("ru = 'Файл загруженного отчета был ранее перемещен в архив. Извлечение содержимого невозможно!';
									|en = 'Imported report file was previously transferred to the archive. Cannot extract the content.'");
		Иначе
			ТекстСообщения = НСтр("ru = 'Не обнаружена информация для отправки!';
									|en = 'Information for sending is not found.'");
		КонецЕсли;
		СообщитьПользователю(ТекстСообщения);
		ИмяФайлаВыгрузки = "";
		ТекстВыгрузки = "";
		Возврат;
	КонецЕсли;
	
	// пишем электронное представление в файл
	
	ЭтоXML = нрег(Прав(ИмяФайлаВыгрузки, 4)) = ".xml";
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	ХранилищеВыгрузки.Получить().Записать(ВремФайл);
	
	КодировкаПоУмолчанию = "windows-1251";
	КодировкаИсходника = КодировкаПоУмолчанию;
	
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, ?(ПреобразоватьИзКодировки <> Неопределено, ПреобразоватьИзКодировки,
		?(ЭтоXML, КодировкаПоУмолчанию, "cp866")));
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	
	УдалитьФайлы(ВремФайл);
	
КонецПроцедуры

Процедура ПолучитьСвойстваФайлаВыгрузки(
		ОбъектСсылка,
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		КодировкаФайлаВыгрузки = Неопределено,
		СвойстваФайлаВыгрузки = Неопределено) Экспорт
	
	СвойстваФайлаВыгрузки = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ВыгрузитьДокументСервер(
		ОбъектСсылка);
	Если СвойстваФайлаВыгрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки = КодировкаТекста.ANSI Тогда
		КодировкаФайлаВыгрузки = "windows-1251";
	ИначеЕсли СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки = КодировкаТекста.OEM Тогда
		КодировкаФайлаВыгрузки = "cp866";
	Иначе
		КодировкаФайлаВыгрузки = СвойстваФайлаВыгрузки.КодировкаФайлаВыгрузки;
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СвойстваФайлаВыгрузки.АдресФайлаВыгрузки);
	ДвоичныеДанныеФайла.Записать(ВремФайл);
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ВремФайл, КодировкаФайлаВыгрузки);
	
	ТекстВыгрузки = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	УдалитьФайлы(ВремФайл);
	
	ИмяФайлаВыгрузки = СвойстваФайлаВыгрузки.ИмяФайлаВыгрузки;
	
КонецПроцедуры

Функция ПоляНаСервереДляЗаписиОтправкиВФСС(ОбъектСсылка) Экспорт
	
	ВидОтправляемогоДокумента = ОбъектСсылка.ВидОтчета;
	ТипОтправляемогоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтправляемогоДокумента, "ТипДокумента");
	
	Результат = Новый Структура;
	Результат.Вставить("КодОрганаФСС", 			ОбъектСсылка.Получатель);
	Результат.Вставить("ДатаНачалаПериода", 	ОбъектСсылка.ДатаНачала);
	Результат.Вставить("ДатаОкончанияПериода", 	ОбъектСсылка.ДатаОкончания);
	Результат.Вставить("Версия", 				ОбъектСсылка.Версия);
	Результат.Вставить("ВидОтчета", 			ВидОтправляемогоДокумента);
	Результат.Вставить("ТипДокумента", 			ТипОтправляемогоДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОбъектСсылка,
		ПолучитьВидОтправляемогоДокумента = Ложь) Экспорт
	
	ТипЗнчОбъектСсылка = ТипЗнч(ОбъектСсылка);
	
	ВидОтправляемогоДокумента = Неопределено;
	
	ОбъектПоУмолчаниюРеестрЭЛНСуществует =
		Метаданные.Документы.Найти("РеестрДанныхЭЛНЗаполняемыхРаботодателем") <> Неопределено;
	ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует =
		Метаданные.Документы.Найти("РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам") <> Неопределено;
	
	Если ТипЗнчОбъектСсылка = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		
		// ищем отчет в справочнике "ВидыОтправляемыхДокументов"
		ИсточникОтчета = ОбъектСсылка.ИсточникОтчета;	
		РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", ИсточникОтчета);
		Если РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден элемент с именем объекта метаданных ""%1""!';
																														|en = 'The item with the ""%1"" metadata object name is not found in the ""Kinds of documents to be sent"" catalog.'"), ИсточникОтчета));
			ВидОтправляемогоДокумента = Неопределено;
		Иначе
			ВидОтправляемогоДокумента = РезультатПоиска; 
		КонецЕсли;
		
	ИначеЕсли ТипЗнчОбъектСсылка = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") 
		ИЛИ ТипЗнчОбъектСсылка = Тип("СправочникОбъект.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		ВидОтправляемогоДокумента = ОбъектСсылка.ВидОтчета;
		
	ИначеЕсли ТипЗнчОбъектСсылка = Тип("СправочникСсылка.ОтправкиФСС") Тогда
		
		ВидОтправляемогоДокумента = ОбъектСсылка.ВидОтчета;
		
	ИначеЕсли ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОбъектСсылка) Тогда
		
		ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.РеестрСведенийВФСС;
		
	ИначеЕсли ДокументооборотСФССКлиентСервер.ЭтоРеестрДанныхЭЛНЗаполняемыхРаботодателем(ОбъектСсылка,
		ОбъектПоУмолчаниюРеестрЭЛНСуществует) Тогда
		
		ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.РеестрДанныхЭЛНЗаполняемыхРаботодателем;
		
	ИначеЕсли ДокументооборотСФССКлиентСервер.ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(ОбъектСсылка,
		ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует) Тогда
		
		ВидОтправляемогоДокумента =
			Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
		
	Иначе
		МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчОбъектСсылка);
		Если МетаданныеОтчета <> Неопределено Тогда
			ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", МетаданныеОтчета.Имя);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ВидОтправляемогоДокумента) Тогда
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден элемент для отчета ""%1""!';
					|en = 'The ""%1"" report item is not found in the ""Kinds of documents being sent"" catalog.'"),
				Строка(ОбъектСсылка));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидОтправляемогоДокумента) Тогда
		
		Если ПолучитьВидОтправляемогоДокумента Тогда
			ТипОтправляемогоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтправляемогоДокумента, "ТипДокумента");
			
			Результат = Новый Структура();
			Результат.Вставить("ВидОтправляемогоДокумента", ВидОтправляемогоДокумента);
			Результат.Вставить("ТипОтправляемогоДокумента", ТипОтправляемогоДокумента);
			Возврат Результат;
			
		Иначе
			Возврат ВидОтправляемогоДокумента.ТипДокумента;
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ДанныеРеестраЭЛН(ВыгрузкаXML) Экспорт
	
	ПараметрыФормата = ПараметрыФорматаЭЛН();
	ЭтоВерсия1X = Лев(ПараметрыФормата.Версия, 2) = "1.";
	
	ИмяМетодаОтправки = ?(ЭтоВерсия1X, "prParseReestrFile", "prParseReestrFileRequest");
	Результат = ТекстПослеПрефикса(ВыгрузкаXML, ":" + ИмяМетодаОтправки);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ТекстПослеПрефикса(ВыгрузкаXML, "<" + ИмяМетодаОтправки);
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Возврат ВыгрузкаXML;
		КонецЕсли;
	КонецЕсли;
	
	ИмяУзлаКорняЗаписей = ?(ЭтоВерсия1X, "ROWSET", "rowset");
	ИмяУзлаЗаписей = ?(ЭтоВерсия1X, "ROW", "row");
	
	КореньУзлаЗаписейБезПрефикса = Ложь;
	НачалоНаименованияУзлаЗаписей = СтрНайти(Результат, ":" + ИмяУзлаКорняЗаписей);
	Если НачалоНаименованияУзлаЗаписей = 0 Тогда
		НачалоНаименованияУзлаЗаписей = СтрНайти(Результат, "<" + ИмяУзлаКорняЗаписей);
	КонецЕсли;
	Если НачалоНаименованияУзлаЗаписей = 0 Тогда
		КореньУзлаЗаписейБезПрефикса = Истина;
		НачалоНаименованияУзлаЗаписей = СтрНайти(Результат, ":" + ИмяУзлаЗаписей);
		Если НачалоНаименованияУзлаЗаписей = 0 Тогда
			НачалоНаименованияУзлаЗаписей = СтрНайти(Результат, "<" + ИмяУзлаЗаписей);
		КонецЕсли;
		Если НачалоНаименованияУзлаЗаписей = 0 Тогда
			Возврат ВыгрузкаXML;
		КонецЕсли;
	КонецЕсли;
	
	НачалоУзлаЗаписей = НачалоНаименованияУзлаЗаписей;
	Пока НачалоУзлаЗаписей > 1 Цикл
		НачалоУзлаЗаписей = НачалоУзлаЗаписей - 1;
		Если Сред(Результат, НачалоУзлаЗаписей, 1) = "<" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ПрефиксУзлаЗаписей = Сред(Результат, НачалоУзлаЗаписей + 1,
		НачалоНаименованияУзлаЗаписей - НачалоУзлаЗаписей - 1);
	
	ПространствоИменЭЛН = ?(ЭтоВерсия1X, "http://ru/ibs/fss/ln/ws/FileOperationsLn.wsdl",
		"http://www.fss.ru/integration/types/eln/ins/v01");
	ПространствоИменАтрибутов = ?(ЭтоВерсия1X, Неопределено, "http://www.fss.ru/integration/types/eln/v01");
	
	ПрефиксАтрибутовУзлаЗаписей = ПрефиксУзлаЗаписей;
	Если КореньУзлаЗаписейБезПрефикса Тогда
		ПрефиксАтрибутовУзлаЗаписей = ТекстПослеПрефикса(Результат, "xmlns:", "=""" + ПространствоИменЭЛН + """");
	КонецЕсли;
	
	ПрефиксАтрибутов = Неопределено;
	Если ПространствоИменАтрибутов <> Неопределено Тогда
		НачалоЗначенияПространстваИменАтрибутов = СтрНайти(ВыгрузкаXML, "=""" + ПространствоИменАтрибутов + """");
		
		Если НачалоЗначенияПространстваИменАтрибутов <> 0 Тогда
			НачалоПрефиксаАтрибутов = НачалоЗначенияПространстваИменАтрибутов;
			Пока НачалоПрефиксаАтрибутов > 1 Цикл
				Если Сред(ВыгрузкаXML, НачалоПрефиксаАтрибутов - 1, 1) = ":"
					ИЛИ Сред(ВыгрузкаXML, НачалоПрефиксаАтрибутов - 1, 1) = " " Тогда
					Прервать;
				КонецЕсли;
				НачалоПрефиксаАтрибутов = НачалоПрефиксаАтрибутов - 1;
			КонецЦикла;
			
			ПрефиксАтрибутов = Сред(ВыгрузкаXML, НачалоПрефиксаАтрибутов,
				НачалоЗначенияПространстваИменАтрибутов - НачалоПрефиксаАтрибутов);
		КонецЕсли;
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "<" + ПрефиксУзлаЗаписей + ":", "<");
	Результат = СтрЗаменить(Результат, "</" + ПрефиксУзлаЗаписей + ":", "</");
	Результат = СтрЗаменить(Результат, " xmlns:" + ПрефиксАтрибутовУзлаЗаписей + "=""" + ПространствоИменЭЛН + """", "");
	Если ПространствоИменАтрибутов <> Неопределено И ПрефиксАтрибутов <> Неопределено Тогда
		Результат = СтрЗаменить(Результат, " xmlns:" + ПрефиксАтрибутов + "=""" + ПространствоИменАтрибутов + """", "");
	КонецЕсли;
	Результат = СтрЗаменить(Результат, " xmlns:" + ПрефиксУзлаЗаписей
		+ "=""" + ПространствоИменЭЛН + """ xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
	Если ЗначениеЗаполнено(ПрефиксАтрибутов) Тогда
		Результат = СтрЗаменить(Результат, " " + ПрефиксАтрибутов + ":", " ");
	КонецЕсли;
	
	Пока Истина Цикл
		// убрать подстроки " wsu:Id=""ELN_123456789012"""
		НачалоУзлаЗаписи = СтрНайти(Результат, "<" + ИмяУзлаЗаписей + " ");
		Если НачалоУзлаЗаписи = 0 Тогда
			Прервать;
		КонецЕсли;
		
		УзелЗаписи = Сред(Результат, НачалоУзлаЗаписи);
		ДлинаУзлаЗаписи = СтрНайти(УзелЗаписи, ">");
		Если ДлинаУзлаЗаписи = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Результат = Лев(Результат, НачалоУзлаЗаписи - 1) + "<" + ИмяУзлаЗаписей + ">"
			+ Сред(Результат, НачалоУзлаЗаписи + ДлинаУзлаЗаписи);
	КонецЦикла;
	
	Результат = СтрЗаменить(Результат, " " + ПрефиксАтрибутовУзлаЗаписей + ":", " d1p1:");
	Результат = СтрЗаменить(Результат, "<" + ИмяУзлаКорняЗаписей, "<" + ИмяУзлаКорняЗаписей
		+ " xmlns=""" + ПространствоИменЭЛН + """"
		+ " xmlns:d1p1=""" + ПространствоИменЭЛН + """"
		+ " xmlns:xs=""http://www.w3.org/2001/XMLSchema"""
		+ " xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""");
	
	Результат = ТекстПослеПрефикса(Результат, "<" + ИмяУзлаКорняЗаписей + " ", "</" + ИмяУзлаКорняЗаписей + ">");
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат ВыгрузкаXML;
	КонецЕсли;
	Результат = "<" + ИмяУзлаКорняЗаписей + " " + Результат + "</" + ИмяУзлаКорняЗаписей + ">";
	
	Возврат Результат;
	
КонецФункции

Процедура ПриЗаписиНастройкиОбменаФСС(НаборЗаписей, Отказ)
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Все организации где подключен обмен с ФСС.
	Организации = СписокДопустимыхОрганизацийВОбъектахОбменаФСС();
	
	ИспользоватьОбмен = Ложь;
	Для каждого Запись из НаборЗаписей Цикл
		
		Организация = Запись.Организация;
		
		Индекс = Организации.Найти(Организация);
		Если Индекс <> Неопределено Тогда
			// Удаляем из массива организации из набора.
			Организации.Удалить(Индекс);
		КонецЕсли;
		
		ТекущаяОрганизацияВМассиве = Новый Массив;
		ТекущаяОрганизацияВМассиве.Добавить(Организация);
		
		Если Запись.ИспользоватьОбмен
			И (Запись.СтраховательПодписанНаУведомленияПоЭЛН
			ИЛИ ТребуетсяЗапускРегламентногоЗаданияОбменаСФСС(ТекущаяОрганизацияВМассиве)) Тогда
			// Включаем обмен по организациям где есть подписка на ЭЛН или требуется запуск РЗ для других типов документов.
			ИспользоватьОбмен = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если (Организации.Количество() > 0
			И ТребуетсяЗапускРегламентногоЗаданияОбменаСФСС(Организации))
		ИЛИ ИспользоватьОбмен Тогда
			ЭлектронныйДокументооборотСФСС.ВключитьОбменСФСС();
	Иначе
		ЭлектронныйДокументооборотСФСС.ОтключитьОбменСФСС();
	КонецЕсли;
	
КонецПроцедуры

Функция ОтветыНаТребованиеФСС(ТребованиеСсылка) Экспорт
	
	МассивОтветов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтветСтрахователяНаТребованиеПроверкиФСС КАК ОтветСтрахователяНаТребованиеПроверкиФСС
	|ГДЕ
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание = &ТребованиеСсылка";

	Запрос.УстановитьПараметр("ТребованиеСсылка", ТребованиеСсылка);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		МассивОтветов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат МассивОтветов;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////
// Получение требований и представление документов в налоговые органы

Функция ПолучитьКоличествоОтветовНаТребованияСФР(
		Ссылки,
		ТолькоОтправленные = Ложь) Экспорт
	
	Результат = Новый Соответствие;
	
	Требования = Новый Массив;
	Если ТипЗнч(Ссылки) = Тип("Массив") Тогда
		Требования = ОбщегоНазначения.СкопироватьРекурсивно(Ссылки);
	Иначе
		Требования.Добавить(Ссылки);
	КонецЕсли;
	
	Для каждого Требование Из Требования Цикл
	
		ДанныеОтветов = ОтветыНаТребованиеСФР(Требование, ТолькоОтправленные);
		
		Результат.Вставить(Требование, ДанныеОтветов);
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОтветыНаТребованиеСФР(ТребованиеСсылка, ТолькоОтправленные) Экспорт
	
	ДанныеОтветов = ЭлектронныйДокументооборотСФСС.НовыеДанныеОтветовНаТребованияСФР();
	
	Статусы = Новый Массив;
	СтатусОтправлен = "Отправлен";
	СтатусПодготовлен = "Подготовлен";
	Статусы.Добавить(СтатусОтправлен);
	Если НЕ ТолькоОтправленные Тогда
		Статусы.Добавить(СтатусПодготовлен);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Дата КАК Дата,
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка КАК Ссылка,
	               |	МАКСИМУМ(ОшибкиЛогическогоКонтроля.СодержимоеОшибки) КАК ЕстьКритическиеОшибкиОтправки,
	               |	ВЫБОР
	               |		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ДатаОтправкиВФСС > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА &СтатусОтправлен
	               |		ИНАЧЕ &СтатусПодготовлен
	               |	КОНЕЦ КАК Статус,
	               |	МАКСИМУМ(ВЫРАЗИТЬ(ОтветСтрахователяНаТребованиеПроверкиФСС.Комментарий КАК СТРОКА(250))) КАК Комментарий,
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание КАК Требование,
	               |	ВЫБОР
	               |		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ТипСообщенияОтвета = 313
	               |			ТОГДА ""Ответ страхователя на запрос документов по камеральной проверке""
	               |		ИНАЧЕ ""Ответ страхователя на запрос документов по выездной проверке""
	               |	КОНЕЦ КАК Наименование
	               |ПОМЕСТИТЬ ВТОтветы
	               |ИЗ
	               |	Документ.ОтветСтрахователяНаТребованиеПроверкиФСС КАК ОтветСтрахователяНаТребованиеПроверкиФСС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВходящийДокументСЭДОФСС.ОшибкиЛогическогоКонтроля КАК ОшибкиЛогическогоКонтроля
	               |		ПО ОтветСтрахователяНаТребованиеПроверкиФСС.Основание = ОшибкиЛогическогоКонтроля.Ссылка
	               |ГДЕ
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание = &Основание
	               |	И ОтветСтрахователяНаТребованиеПроверкиФСС.ПометкаУдаления = ЛОЖЬ
	               |	И ВЫБОР
	               |			КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ДатаОтправкиВФСС > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				ТОГДА &СтатусОтправлен
	               |			ИНАЧЕ &СтатусПодготовлен
	               |		КОНЕЦ В (&Статусы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Дата,
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ДатаОтправкиВФСС > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА &СтатусОтправлен
	               |		ИНАЧЕ &СтатусПодготовлен
	               |	КОНЕЦ,
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание,
	               |	ВЫБОР
	               |		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ТипСообщенияОтвета = 313
	               |			ТОГДА ""Ответ страхователя на запрос документов по камеральной проверке""
	               |		ИНАЧЕ ""Ответ страхователя на запрос документов по выездной проверке""
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТОтветы.Дата КАК Дата,
	               |	ВТОтветы.Ссылка КАК Ссылка,
	               |	ВТОтветы.ЕстьКритическиеОшибкиОтправки КАК ЕстьКритическиеОшибкиОтправки,
	               |	ВТОтветы.Статус КАК Статус,
	               |	ВТОтветы.Комментарий КАК Комментарий,
	               |	СУММА(ВЫБОР
	               |			КОГДА УведомленияОПриемеОтказе.Статус = 2
	               |				ТОГДА УведомленияОПриемеОтказе.КоличествоДокументовВоВложении
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Отказано,
	               |	СУММА(ВЫБОР
	               |			КОГДА УведомленияОПриемеОтказе.Статус = 1
	               |				ТОГДА УведомленияОПриемеОтказе.КоличествоДокументовВоВложении
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Принято,
	               |	ВТОтветы.Наименование КАК Наименование
	               |ПОМЕСТИТЬ ВТСтатус
	               |ИЗ
	               |	ВТОтветы КАК ВТОтветы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВходящийДокументСЭДОФСС.УведомленияОПриемеОтказе КАК УведомленияОПриемеОтказе
	               |		ПО ВТОтветы.Ссылка = УведомленияОПриемеОтказе.ОтветНаТребованиеФСС
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТОтветы.Дата,
	               |	ВТОтветы.Ссылка,
	               |	ВТОтветы.ЕстьКритическиеОшибкиОтправки,
	               |	ВТОтветы.Статус,
	               |	ВТОтветы.Комментарий,
	               |	ВТОтветы.Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТСтатус.Ссылка КАК Ссылка,
	               |	ВТСтатус.Статус КАК СтатусОтправки
	               |ИЗ
	               |	ВТСтатус КАК ВТСтатус
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТСтатус
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТОтветы";
	
	Запрос.УстановитьПараметр("Основание", ТребованиеСсылка);
	Запрос.УстановитьПараметр("СтатусПодготовлен", СтатусПодготовлен);
	Запрос.УстановитьПараметр("СтатусОтправлен", СтатусОтправлен);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Отправлен = Ложь;
	КоличествоОтправлено = 0;
	МассивОтветов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.СтатусОтправки = СтатусОтправлен Тогда
			Отправлен = Истина;
			КоличествоОтправлено = КоличествоОтправлено + 1;
		КонецЕсли;
		МассивОтветов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ДанныеОтветов.Ответы = МассивОтветов;
	ДанныеОтветов.Отправлен = Отправлен;
	ДанныеОтветов.КоличествоОтправлено = КоличествоОтправлено;
	
	Возврат ДанныеОтветов;
	
КонецФункции

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// Функции с использованием общих модулей и дублирующие функции для организации
// вызовов общих модулей при документообороте с ФСРАР

Функция СформироватьФайлОтправкиВФСРАРССервера(КороткоеИмяФайлаПакета, СхемаСдачиОтчетности, СтрокаBase64ФайлаПакета, ЭтоАдреса = Истина, Адрес = Неопределено, ЗначениеCAPTCHA = "") Экспорт
	
	Результат = Неопределено;
	
	//файл отправки получаем, объединяя файл пакета с файлами начала и окончания POST-запроса
	
	// файл 1
	ФедеральныйСервер = ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ФедеральныйСервер");
	ТиповойРегиональныйИФедеральныйСерверы = ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.ТиповойРегиональныйИФедеральныйСерверы");
	МосковскийРегиональныйИФедеральныйСерверы = ПредопределенноеЗначение("Перечисление.СхемыСдачиОтчетностиФСРАР.МосковскийРегиональныйИФедеральныйСерверы");
	
	// формируем POST-данные.
	СодержимоеФайла = "--My1cV8bNdr"
	+ ?(СхемаСдачиОтчетности = ТиповойРегиональныйИФедеральныйСерверы, "",
	Символы.ВК + Символы.ПС + "Content-Disposition: form-data; name=""" + ?(СхемаСдачиОтчетности = МосковскийРегиональныйИФедеральныйСерверы, "import", "format") + """"
	+ Символы.ВК + Символы.ПС
	+ Символы.ВК + Символы.ПС + ?(СхемаСдачиОтчетности = МосковскийРегиональныйИФедеральныйСерверы, "yes", "4.20" + ?(СхемаСдачиОтчетности = ФедеральныйСервер, "", ".region"))
	+ Символы.ВК + Символы.ПС + "--My1cV8bNdr")
	+ ?(НЕ ЗначениеЗаполнено(ЗначениеCAPTCHA), "",
	Символы.ВК + Символы.ПС + "Content-Disposition: form-data; name=""captcha_code"""
	+ Символы.ВК + Символы.ПС
	+ Символы.ВК + Символы.ПС + ЗначениеCAPTCHA
	+ Символы.ВК + Символы.ПС + "--My1cV8bNdr")
	+ Символы.ВК + Символы.ПС + "Content-Disposition: form-data; name=""" + ?(СхемаСдачиОтчетности = ТиповойРегиональныйИФедеральныйСерверы, "fileUpload",
	?(СхемаСдачиОтчетности = МосковскийРегиональныйИФедеральныйСерверы, "file", "file_")) + """; filename=""" + КороткоеИмяФайлаПакета + """"
	+ Символы.ВК + Символы.ПС + "Content-Type: application/octet-stream"
	+ Символы.ВК + Символы.ПС
	+ Символы.ВК + Символы.ПС;
	
	ИмяФайлаЗапросаНачало = ПолучитьИмяВременногоФайла();
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(СодержимоеФайла);
	ТекстовыйФайл.Записать(ИмяФайлаЗапросаНачало, "windows-1251", "");
	
	// файл 2
	ИмяФайлаПакета = ПолучитьИмяВременногоФайла();
	
	Если ЭтоАдреса Тогда
		ПолучитьИзВременногоХранилища(СтрокаBase64ФайлаПакета).Записать(ИмяФайлаПакета);
	Иначе
		ДвоичныеДанныеФайлаПакета = Base64Значение(СтрокаBase64ФайлаПакета);
		ДвоичныеДанныеФайлаПакета.Записать(ИмяФайлаПакета);
	КонецЕсли;
	
	// файл 3
	СодержимоеФайла = Символы.ВК + Символы.ПС + "--My1cV8bNdr--";
	
	ИмяФайлаЗапросаОкончание = ПолучитьИмяВременногоФайла();
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(СодержимоеФайла);
	ТекстовыйФайл.Записать(ИмяФайлаЗапросаОкончание, "windows-1251", "");
	
	// объединение
	МассивИмен = Новый Массив;
	МассивИмен.Добавить(ИмяФайлаЗапросаНачало);
	МассивИмен.Добавить(ИмяФайлаПакета);
	МассивИмен.Добавить(ИмяФайлаЗапросаОкончание);
	ИмяФайлаОтправки = ПолучитьИмяВременногоФайла();
	ОбъединитьФайлы(МассивИмен, ИмяФайлаОтправки);
	
	Если ЭтоАдреса Тогда
		Результат = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаОтправки), Адрес);
	Иначе
		ДвоичныеДанныеФайлаПакета = Новый ДвоичныеДанные(ИмяФайлаОтправки);
		Результат = Base64Строка(ДвоичныеДанныеФайлаПакета);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьСвойстваСертификатаПоОтпечаткуССервера(Отпечаток, ЛогическоеХранилище = Неопределено) Экспорт
	
	Сертификат  = Новый Структура("Отпечаток", Отпечаток);
	Возврат КриптографияЭДКО.НайтиСертификат(Сертификат, Ложь);
	
КонецФункции

Функция ПодставитьПараметрыВСтроку(Знач СтрокаПодстановки,
	Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено)
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаПодстановки,
		Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7, Параметр8, Параметр9);
		
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения, СообщенияПользователю = Неопределено)
	
	Если СообщенияПользователю <> Неопределено Тогда
		СообщенияПользователю.Добавить(ТекстСообщения);
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
	КонецЕсли;
	
