		И Состояние.НаСертификат.ЗаявлениеОтправлено
		И НЕ Состояние.НаСертификат.ПФРУведомленОСмене;
		
КонецФункции

Процедура СоздатьЗаявленияВПФРЕслиНеСозданы(Форма) Экспорт
	
	Если Форма.ПредупредитьЧтоЕщеНеОдобрено Тогда
		
		Если Форма.СостояниеЭДОсПФР.Неодобренное.Вид = Форма.НаПодключение Тогда
			Форма.ЗаявлениеВПФР = Форма.СостояниеЭДОсПФР.Неодобренное.Заявление;
		ИначеЕсли Форма.СостояниеЭДОсПФР.Неодобренное.Вид = Форма.НаСертификат Тогда
			Форма.СертификатВПФР = Форма.СостояниеЭДОсПФР.Неодобренное.Заявление;
		КонецЕсли;
		
	Иначе
		
		Если Форма.ЭтоИзначальноНаПодключениеИлиОтключение И НЕ ЗначениеЗаполнено(Форма.ЗаявлениеВПФР) Тогда
			
			Форма.ЗаявлениеВПФР = СоздатьЗаявлениеВПФР(
				Форма.ИзначальныйВидЗаявленияПФР,
				Форма.Организация, 
				Форма.СостояниеЭДОсПФР, 
				Форма.ТекущееЗаявлениеПо1СОтчетности);
				
		КонецЕсли;
		
		ЗаявлениеНаПодключениеИлиОтключениеУжеЕсть = НЕ Форма.ЭтоИзначальноНаПодключениеИлиОтключение 
			ИЛИ Форма.ЭтоИзначальноНаПодключениеИлиОтключение И Форма.ФлагЗаявлениеУжеПредоставленоВПФР;
			
		Если НЕ ЗначениеЗаполнено(Форма.СертификатВПФР) И ЗаявлениеНаПодключениеИлиОтключениеУжеЕсть Тогда
			
			Форма.СертификатВПФР = СоздатьЗаявлениеВПФР(
				Форма.НаСертификат,
				Форма.Организация, 
				Форма.СостояниеЭДОсПФР, 
				Форма.ТекущееЗаявлениеПо1СОтчетности);
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьЗаявлениеВПФР( 
		Вид, 
		Организация, 
		СостояниеЭДОсПФР = Неопределено, 
		Основание = Неопределено) Экспорт
		
	НаПодключение = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение;
	НаОтключение  = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение;
		
	Если ТипЗнч(Вид) = Тип("Строка") Тогда
		
		Если Вид = Строка(НаПодключение) Тогда
			Вид = НаПодключение;
		ИначеЕсли Вид = Строка(НаОтключение) Тогда
			Вид = НаОтключение;
		КонецЕсли;

	КонецЕсли;
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("Вид", Вид);
	
	ДокументОбъект = Документы.ЗаявленияПоЭлДокументооборотуСПФР.СоздатьДокумент();
	ДокументОбъект.Заполнить(ДополнительныеПараметры);
	Если ЗначениеЗаполнено(Основание) Тогда
		ДокументОбъект.Основание = Основание;
	КонецЕсли;

	ДокументОбъект.Записать();
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

Процедура СохранитьНастройкиСостоянияЭДОСПФР(Форма) Экспорт

	// Заявление
	Если Форма.ФлагЗаявлениеУжеПредоставленоВПФР Тогда
		
		Если Форма.ИзначальныйВидЗаявленияПФР = Форма.НаПодключение Тогда
			УстановитьСостояниеПодключенияКЭДОсПФР(Форма.Организация, Истина);
		ИначеЕсли Форма.ИзначальныйВидЗаявленияПФР = Форма.НаОтключение Тогда
			УстановитьСостояниеПодключенияКЭДОсПФР(Форма.Организация, , Истина);
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьВидыЗаявленийНаЭДОВПФР(Форма) Экспорт
	
	Форма.НаПодключение = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение;
	Форма.НаОтключение  = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение;
	Форма.НаСертификат  = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаСертификат;

КонецПроцедуры

Процедура ИнициализироватьПараметрыЭДОСПФР(Форма, ПолучатьСостояниеЭДОсПФР = Истина) Экспорт // Вызывается из всех кейсов ПФР
	
	Если ПолучатьСостояниеЭДОсПФР И Форма.СостояниеЭДОсПФР = Неопределено Тогда
		Форма.СостояниеЭДОсПФР = СостояниеЭДОсПФР(Форма.Организация);
	КонецЕсли;

	ИнициализироватьВидыЗаявленийНаЭДОВПФР(Форма);
	
	Форма.ЭтоИзначальноНаПодключениеИлиОтключение = 
		Форма.ИзначальныйВидЗаявленияПФР = Форма.НаПодключение
		ИЛИ Форма.ИзначальныйВидЗаявленияПФР = Форма.НаОтключение;
		
	ПредупредитьЧтоЕщеНеОдобреноИзНастроек = Форма.ЭтоПредупреждениеИзНастроек;
	ПредупредитьЧтоЕщеНеОдобреноИзОтправки = Форма.ЭтоПредупреждениеИзОтправки
		И Форма.СостояниеЭДОсПФР.Неодобренное.Предупредить
		И Форма.СостояниеЭДОсПФР.Неодобренное.Вид <> ПредопределенноеЗначение("Перечисление.ВидыЗаявленийНаЭДОВПФР.НаОтключение");
		
	Форма.ПредупредитьЧтоЕщеНеОдобрено = 
		Форма.СостояниеЭДОсПФР.Неодобренное.Предупредить
		И НЕ Форма.ЭтоПредупреждениеИзМастера
		И (ПредупредитьЧтоЕщеНеОдобреноИзНастроек ИЛИ ПредупредитьЧтоЕщеНеОдобреноИзОтправки);
		
	Если Форма.ЭтоПредупреждениеИзНастроек 
		ИЛИ Форма.ЭтоПредупреждениеИзМастера И Форма.ЭтоПредупреждениеИзПанели Тогда
		Форма.ЗаголовокКнопкиПоЗавершению = НСтр("ru = 'Сохранить и закрыть';
												|en = 'Save and close'");
	ИначеЕсли Форма.ЭтоПредупреждениеИзОтправки Тогда
		Название = ДлительнаяОтправкаКлиентСервер.НазваниеОбъектаВИменительномПадеже(Форма.Отчет);
		Форма.ЗаголовокКнопкиПоЗавершению = НСтр("ru = 'Продолжить отправку ';
												|en = 'Continue sending'") + Название;
	ИначеЕсли Форма.ЭтоПредупреждениеИзМастера Тогда
		Форма.ЗаголовокКнопкиПоЗавершению = НСтр("ru = 'Завершить настройку';
												|en = 'Finish setup'");
	КонецЕсли;
	
КонецПроцедуры
	
Функция ЗаявлениеВПФРЗаполненоКорректно(ОтправляемоеЗаявление) Экспорт
	
	Корректно = ОтправляемоеЗаявление.ПолучитьОбъект().ПроверитьЗаполнение();
	Если НЕ Корректно Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Зайдите в заявление по ссылке и исправьте найденные ошибки';
													|en = 'Go to the application following the link and correct the errors found'"), ОтправляемоеЗаявление);
	КонецЕсли;
	
	Возврат Корректно;
	
КонецФункции

Процедура ОпределитьОтправляемоеЗаявлениеВПФР(Форма) Экспорт
	
	Если Форма.ПредупредитьЧтоЕщеНеОдобрено Тогда
		Форма.ОтправляемоеЗаявлениеПФР = Форма.СостояниеЭДОсПФР.Неодобренное.Заявление;
	ИначеЕсли Форма.ЭтоИзначальноНаПодключениеИлиОтключение И НЕ Форма.ФлагЗаявлениеУжеПредоставленоВПФР Тогда
		Форма.ОтправляемоеЗаявлениеПФР = Форма.ЗаявлениеВПФР;
	Иначе
		Форма.ОтправляемоеЗаявлениеПФР = Форма.СертификатВПФР;
	КонецЕсли;
	
	Форма.ВидОтправляемогоЗаявления = Форма.ОтправляемоеЗаявлениеПФР.Вид;
	
КонецПроцедуры

