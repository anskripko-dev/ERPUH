	Результат.Колонки.Добавить("ОтпечатокСертификатаПодписи", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("ДокументЗашифрован",   Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ДокументСжат",         Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("АлгоритмФайла",        ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("АлгоритмФайлаПодписи", ОписаниеТипаСтрока);
	Результат.Колонки.Добавить("РезультатПроверкиПодписи", ОписаниеТипаСтрока);
	
	Возврат Результат;

