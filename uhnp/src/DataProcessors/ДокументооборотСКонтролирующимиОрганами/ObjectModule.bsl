Процедура ОтправкаРегламентированногоОтчетаВФСС(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ПараметрыОтчета.Вставить("ОтчетСсылка",             ПараметрыОтчета.СсылкаНаОтчет); // В процедурах отправки в ФСС имя ключа со ссылкой на отчет отличается.
	ПараметрыОтчета.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор); // Используется вместо уникального идентификатора формы при отправке отчетов на сервере.

	ОтправкаРегламентированногоОтчетаВФСС_ПолучениеСвойствРегОтчета(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	ОтправкаРегламентированногоОтчетаВФСС_ПроверкиПодключения(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	ОтправкаРегламентированногоОтчетаВФСС_ВыгрузитьОтчет(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	Если ПараметрыОтчета.ТолькоПроверкаБезОтправки Тогда
		// Следующие процедуры выполняют либо сохранение в базе данных об отправке либо могут вызывать сервис криптографии,
		// поэтому в режиме "Только проверка без отправки" их уже не выполняем.
		// Считаем, что текущий отчет может быть отправлен.
		Возврат;
	КонецЕсли;

	ОтправкаРегламентированногоОтчетаВФСС_ПослеИнициализации(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	ОтправкаРегламентированногоОтчетаВФСС_ПослеВыгрузкиПакетаЗавершение(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ОтправкаРегламентированногоОтчетаВФСС_ПолучениеСвойствРегОтчета(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПолучениеСвойствРегОтчета(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтчетСсылка = ПараметрыОтчета.ОтчетСсылка;

	ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(ОтчетСсылка, "ДатаНачала, ДатаОкончания, Вид, ДанныеОтчета");
	
	КодПодчиненности = КодПодчиненности(ЗначенияРеквизитов.ДанныеОтчета);
	
	ПоляДляЗаписиОтправки = Новый Структура("КодОрганаФСС, ДатаНачалаПериода, ДатаОкончанияПериода, Версия",
		Лев(КодПодчиненности, 4),
		НачалоДня(ЗначенияРеквизитов.ДатаНачала),
		КонецДня(ЗначенияРеквизитов.ДатаОкончания),
		ЗначенияРеквизитов.Вид);
	
	ПараметрыОтчета.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
	
КонецПроцедуры

Процедура ОтправкаРегламентированногоОтчетаВФСС_ПроверкиПодключения(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФСС_ПроверкиПодключения(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ОтчетСсылка       = ПараметрыОтчета.ОтчетСсылка;
	ОрганизацияОтчета = ПараметрыОтчета.ОрганизацияОтчета;
	
	ОрганизацияИспользуетОбменСФСС                    = Ложь;
	ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи = Ложь;
	НастроенОбменВУниверсальномФормате                = Ложь;	
	
	ПолучитьСвойстваОрганизацииДляФСС(
		ОрганизацияОтчета,
		НастроенОбменВУниверсальномФормате,
		ОрганизацияИспользуетОбменСФСС,
		ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи);
	
	Если НЕ ОрганизацияИспользуетОбменСФСС Тогда
		Если НЕ НастроенОбменВУниверсальномФормате Тогда
			
			ПроверитьСтатусПодключенияПередОтправкой(ОтчетСсылка, СообщениеОбОшибке);
			
		Иначе
			СообщитьОНеподключенномНаправлении(ОтчетСсылка, СообщениеОбОшибке);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НастроенОбменВУниверсальномФормате И ОрганизацияИспользуетАвтонастройкуПоУчетнойЗаписи Тогда

		Если ПараметрыОтчета.ТребуетсяАвтонастройкаУчетнойЗаписи Тогда
			// Выполняем автонастройку учетной записи, если это первый вызов отправки за сеанс.
			ВыполнитьАвтонастройкуУчетнойЗаписиПередОтправкойОбъекта(ОтчетСсылка, СообщениеОбОшибке);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОтправкаРегламентированногоОтчетаВФСС_ВыгрузитьОтчет(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеПодтвержденияЗавершение(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ОтчетСсылка = ПараметрыОтчета.ОтчетСсылка;
	
	РезультатВыгрузки = ВыгрузитьОтчетДляОтправкиВФСС(ПараметрыОтчета, СообщениеОбОшибке);
	
	Если РезультатВыгрузки = Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			СообщениеОбОшибке = ТекстСообщенийПользователю();
		КонецЕсли;
		Возврат;
		
	КонецЕсли;

	ПараметрыОтчета.Вставить("ТекстФайлаВыгрузки", 	РезультатВыгрузки.ТекстФайлаВыгрузки);
	ПараметрыОтчета.Вставить("РасширениеСТочкой", 	РезультатВыгрузки.РасширениеСТочкой);
	ПараметрыОтчета.Вставить("ИмяФайлаВыгрузки", 	РезультатВыгрузки.ИмяФайлаВыгрузки);
	ПараметрыОтчета.Вставить("ТипЗнчСсылкаНаОтчет", ТипЗнч(ОтчетСсылка));
	
КонецПроцедуры

Функция ВыгрузитьОтчетДляОтправкиВФСС(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтчетСсылка = ПараметрыОтчета.ОтчетСсылка;
	
	ИнформацияОбОтправляемомДокументе = ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОтчетСсылка,
		Истина);
	Если ИнформацияОбОтправляемомДокументе = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ВидОтправляемогоДокумента;
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС);
	ЭтоПодтверждениеВидаДеятельности = ТипОтправляемогоДокумента =
		Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента =
		Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности;
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = ТипОтправляемогоДокумента =
		Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента =
		Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	Если ЭтоДанныеЭЛН Тогда
		СообщениеОбОшибке = НСтр("ru = 'Отправка реестра ЭЛН не поддерживается в мобильном клиенте.';
								|en = 'Sending the ESLR registry is not supported on the mobile client.'");
		Возврат Неопределено;
		
	ИначеЕсли ЭтоПодтверждениеВидаДеятельности Тогда
		СообщениеОбОшибке = НСтр("ru = 'Отправка подтверждения вида деятельности не поддерживается в мобильном клиенте.';
								|en = 'Sending activity category confirmation is not supported in the mobile client.'");
		Возврат Неопределено;
		
	ИначеЕсли ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		СообщениеОбОшибке =
			НСтр("ru = 'Отправка реестра стимулирующих выплат медицинским и социальным работникам не поддерживается в мобильном клиенте.';
				|en = 'Sending an incentive payments registry to medical and social workers is not supported in the mobile client.'");
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстФайлаВыгрузки	= "";
	ИмяФайлаВыгрузки	= "";
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	ЭтоРегламентированныйОтчет = (ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнчСсылкаНаОтчет = Тип("Неопределено"));
	ЭтоРеестрСведений = ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ЭтоЭлектронноеПредставление = (ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"));
	
	Если ЭтоРегламентированныйОтчет  Тогда

		// Выгрузка на сервере в настоящее время поддерживается не для всех регламентированных отчетов.
		// Если отчет ее не поддерживает, то будет возвращено сообщение об ошибке.
		РезультатВыгрузки  = ИнтерфейсыВзаимодействияБРО.ВыгрузитьРегламентированныйОтчет(ОтчетСсылка);
		Если РезультатВыгрузки.РеглОтчетВыгружен Тогда
			ИмяФайлаВыгрузки   = РезультатВыгрузки.ИмяФайлаВыгрузки;
			ТекстФайлаВыгрузки = ТекстФайлаВыгрузки(РезультатВыгрузки);
		Иначе
			СообщениеОбОшибке = ОписаниеОшибокВыгрузки(РезультатВыгрузки, ОтчетСсылка);
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ЭтоЭлектронноеПредставление Тогда
		
		ИзвлечьЭлектронноеПредставлениеИзХранилищаИПерекодировать(ОтчетСсылка, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки);
		
	ИначеЕсли ЭтоРеестрСведений Тогда
		
		ПолучитьСвойстваФайлаВыгрузки(ОтчетСсылка, ТекстФайлаВыгрузки, ИмяФайлаВыгрузки);
		
	Иначе
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Cannot determine a document type.'"));
		Возврат Неопределено;
		
	КонецЕсли;
	
	РасширениеФайла = ПолучитьРасширениеФайлаФССПоТипуОтправляемогоДокумента(ТипОтправляемогоДокумента); 
	
	РасширениеСТочкой = "";
	Если РасширениеФайла = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось определить тип документа.';
				|en = 'Cannot determine a document type.'"));
		Возврат Неопределено;
	Иначе
		РасширениеСТочкой = "." + РасширениеФайла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не удалось сформировать файл выгрузки.';
				|en = 'Cannot generate an export file.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаВыгрузки) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Не определено имя файла выгрузки.';
				|en = 'Export file name is not determined.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекстФайлаВыгрузки", 	ТекстФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("ИмяФайлаВыгрузки", 	ИмяФайлаВыгрузки);
	ДополнительныеПараметры.Вставить("РасширениеСТочкой", 	РасширениеСТочкой);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеИнициализации(ПараметрыОтчета, СообщениеОбОшибке)
	
	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеИнициализации(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ОрганизацияСсылка = ПараметрыОтчета.ОрганизацияОтчета;
	
	РеквизитыУчетнойЗаписи = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.РеквизитыУчетнойЗаписи(ОрганизацияСсылка);
	
	МестоХраненияКлюча 	= КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(ОрганизацияСсылка);
	УчетнаяЗапись 		= РеквизитыУчетнойЗаписи.Ссылка;
	Идентификатор 		= РеквизитыУчетнойЗаписи.ИдентификаторДокументооборота;
	
	Если НЕ КриптографияЭДКОКлиентСервер.ЭтоПодписьСервиса(МестоХраненияКлюча) Тогда
		// Если не используется электронная подпись в модели сервиса, то автоматическая отправка на стороне сервера не поддерживается.
		СообщениеОбОшибке = "ЭтоНеЭлектроннаяПодписьВМоделиСервиса";
		Возврат;
	КонецЕсли;

	// запрашиваем параметры формирования пакета
	ПараметрыОтчета.Вставить("Идентификатор", Идентификатор);
	
	ПолучитьСертификатыИзНастроекОрганизацииДляФСС(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьПакетДляОтправкиВФССПослеПолученияСертификатовЗавершение(ПараметрыОтчета, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение(ПараметрыОтчета, СообщениеОбОшибке);
	
КонецПроцедуры

Процедура ПолучитьСертификатыИзНастроекОрганизацииДляФСС(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(ПараметрыОтчета.ОрганизацияОтчета);
	
	Если ОтпечаткиСертификатов = Неопределено Тогда
		СообщениеОбОшибке = "ОповеститьОНеудачнойОтправке";
		Возврат;
	КонецЕсли;
	
	СертификатСтрахователя = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток);
	СертификатФСС = ПолучитьСвойстваСертификатаПоОтпечаткуНаСервере(ОтпечаткиСертификатов.СертификатФССОтпечаток);
	
	ПараметрыОтчета.Вставить("СертификатСтрахователя", 	СертификатСтрахователя);
	ПараметрыОтчета.Вставить("СертификатФСС", 			СертификатФСС);
	ПараметрыОтчета.Вставить("МЧД", 					ОтпечаткиСертификатов.МЧД);
	
КонецПроцедуры

Функция СертификатыГодятсяДляПодписанияОтчетностиФСС(Сертификаты) Экспорт
	
	ТекДата = ТекущаяДатаСеанса();
	ПризнакОшибки = Ложь;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		
		Серт 	= Сертификат.Значение;
		Предст 	= Сертификат.Представление;
		Если Серт = Неопределено Тогда
			ПризнакОшибки = Истина;
			ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
				НСтр("ru = '%1: сертификат не выбран в настройках сдачи отчетности в ФСС!';
					|en = '%1: certificate is not selected in the settings of reporting submission to SSF.'"), Истина);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Предст));
			Продолжить;
		КонецЕсли;
		
		Если ТекДата < Серт.ДействителенС Тогда
			ПризнакОшибки = Истина;
			ТекстОшибки = НСтр("ru = '%1: период действия сертификата еще не наступил (%2)!';
								|en = '%1: certificate is not within its validity period yet (%2).'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Предст, Строка(Серт.ДействителенС)));
		КонецЕсли;
		
		Если ТекДата > Серт.ДействителенПо И НЕ ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
			ПризнакОшибки = Истина;
			ТекстОшибки = НСтр("ru = '%1: период действия сертификата истек (%2)!';
								|en = '%1: validity period of certificate is expired (%2).'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Предст, Строка(Серт.ДействителенПо)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат (НЕ ПризнакОшибки);
	
КонецФункции

Процедура ВыгрузитьПакетДляОтправкиВФССПослеПолученияСертификатовЗавершение(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ТекстФайлаВыгрузки					= ПараметрыОтчета.ТекстФайлаВыгрузки;
	ИмяФайлаВыгрузки					= ПараметрыОтчета.ИмяФайлаВыгрузки;
	РасширениеСТочкой					= ПараметрыОтчета.РасширениеСТочкой;
	
	СертификатСтрахователя = ПараметрыОтчета.СертификатСтрахователя;
	СертификатФСС = ПараметрыОтчета.СертификатФСС;
	
	//проверяем сертификаты
	СертификатыОбмена = Новый СписокЗначений();
	СертификатыОбмена.Добавить(СертификатСтрахователя, "Сертификат страхователя");
	СертификатыОбмена.Добавить(СертификатФСС, "Сертификат ФСС");
	
	Если НЕ СертификатыГодятсяДляПодписанияОтчетностиФСС(СертификатыОбмена) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Сертификаты не подходят для подписания.';
								|en = 'Certificates are not suitable for signing.'");
		Возврат;
	КонецЕсли;
	
	Если СертификатСтрахователя = Неопределено Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не удалось определить сертификат.';
								|en = 'Cannot determine a certificate.'");
		Возврат;
	КонецЕсли;
	
	КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Истина, СертификатСтрахователя);
	
	Адрес = ЗагрузитьДанныеНаСервер(ТекстФайлаВыгрузки, ПараметрыОтчета.УникальныйИдентификатор,, Истина);
	
	ПараметрыОтчета.Вставить("ВременныйКаталог", "");
	ПараметрыОтчета.Вставить("ПолноеИмяФайлаВыгрузки", ИмяФайлаВыгрузки);
	ПараметрыОтчета.Вставить("АдресДанныхВыгрузки",    Адрес);
	    	    
КонецПроцедуры

Процедура ВыгрузитьПакетДляОтправкиВФССПослеЗаписиФайлаЗавершение(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ВременныйКаталог = ПараметрыОтчета.ВременныйКаталог;
	ПолноеИмяФайлаВыгрузки = ПараметрыОтчета.ПолноеИмяФайлаВыгрузки;
	РасширениеСТочкой = ПараметрыОтчета.РасширениеСТочкой;
	СертификатСтрахователя = ПараметрыОтчета.СертификатСтрахователя;
	СертификатФСС = ПараметрыОтчета.СертификатФСС;
	АдресДанныхВыгрузки = ПараметрыОтчета.АдресДанныхВыгрузки;
	
	// подписываем и шифруем
	КороткоеИмяЗашифрованногоПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайлаВыгрузки).ИмяБезРасширения + РасширениеСТочкой;
	ИмяЗашифрованногоПакета = ВременныйКаталог + КороткоеИмяЗашифрованногоПакета;
	
	СертификатыЗашифрования = Новый Массив;
	СертификатыЗашифрования.Добавить(СертификатФСС);
	
	ЗашифрованныеДанные = ПодписатьИЗашифроватьPKCS7(СертификатСтрахователя, АдресДанныхВыгрузки, СертификатыЗашифрования, СообщениеОбОшибке);

	ЗашифрованныйПакет = Новый Структура;
	ЗашифрованныйПакет.Вставить("ИмяФайлаЗашифрованногоПакета", ЗашифрованныеДанные);
	ЗашифрованныйПакет.Вставить("ИмяФайлаВыгрузки", ИмяЗашифрованногоПакета);
							
	ПараметрыОтчета.Вставить("ЗашифрованныйПакет", ЗашифрованныйПакет);
	
	// Для совместимости с клиентским кодом сохраняем зашифрованные данные в нескольких ключах.
	ПараметрыОтчета.Вставить("АдресПодписанныхИЗашифрованныхДанных", ЗашифрованныеДанные);
	ПараметрыОтчета.Вставить("ИмяЗашифрованногоФайла",               ЗашифрованныеДанные);		
	
КонецПроцедуры

Процедура ОтправкаРегламентированногоОтчетаВФСС_ПослеВыгрузкиПакетаЗавершение(ПараметрыОтчета, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеВыгрузкиПакетаЗавершение(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	МестоХраненияКлюча 					= КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Истина);
	ОтчетСсылка 						= ПараметрыОтчета.ОтчетСсылка;
	ПоляДляЗаписиОтправки 				= ПараметрыОтчета.ПоляДляЗаписиОтправки;
	ЗашифрованныйПакет 					= ПараметрыОтчета.ЗашифрованныйПакет;
	МЧД 								= ПараметрыОтчета.МЧД;
	
	СтрокаBase64ФайлаПакета = ЗашифрованныйПакет.ИмяФайлаЗашифрованногоПакета;
	КороткоеИмяФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ЗашифрованныйПакет.ИмяФайлаВыгрузки).Имя;
	
	// Далее аналогично методу ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССПослеЧтенияФайлаВыгрузкиПакетаЗавершение() из Контейнера.
	
	ИнформацияОбОтправляемомДокументе = ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОтчетСсылка,
		Истина);
	Если ИнформацияОбОтправляемомДокументе = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ВидОтправляемогоДокумента;
	
	ИнформацияДляОтправкиВФСС = СформироватьФайлОтправкиВФССССервера(
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча),
		ПараметрыОтчета.УникальныйИдентификатор,
		ТипОтправляемогоДокумента);
	СтрокаBase64ФайлаПакета 	= ИнформацияДляОтправкиВФСС.СтрокаBase64ФайлаПакета;
	СтрокаBase64ФайлаОтправки 	= ИнформацияДляОтправкиВФСС.СтрокаBase64ФайлаОтправки;
	
	Если СтрокаBase64ФайлаОтправки = Неопределено Тогда
		
		СообщениеОбОшибке = НСтр("ru = 'Не удалось сформировать файл отправки.';
								|en = 'Cannot generate a sending file.'");
		Возврат;
		
	КонецЕсли;
	
	// определим адрес сервера ФСС
	
	АдресСервера = СерверПриемаОтчетностиФСС(ТипОтправляемогоДокумента);
	
	Если АдресСервера = Неопределено Тогда
		
		СообщениеОбОшибке =	НСтр("ru = 'Не удалось определить тип документа.';
									|en = 'Cannot determine a document type.'");
		Возврат;
		
	КонецЕсли;
	
	// отправляем 

	// Далее аналогично ПриНажатииНаКнопкуОтправкиВКонтролирующийОрганДляФССОтправкаВЦикле() из Контейнера.
	ПовторятьСоединение = Ложь; // На стороне сервера выполняем только одну попытку отправку.
	ПараметрыОтправкиНаСервере = Новый Структура;
	ПараметрыОтправкиНаСервере.Вставить("АдресСервера", 				АдресСервера);
	ПараметрыОтправкиНаСервере.Вставить("РазделениеВключено", 			Неопределено);
	ПараметрыОтправкиНаСервере.Вставить("ПоляДляЗаписиОтправки", 		ПоляДляЗаписиОтправки);
	ПараметрыОтправкиНаСервере.Вставить("ТипОтправляемогоДокумента", 	ТипОтправляемогоДокумента);
	ПараметрыОтправкиНаСервере.Вставить("ВидОтправляемогоДокумента", 	ВидОтправляемогоДокумента);
	ПараметрыОтправкиНаСервере.Вставить("МЧД", 							МЧД);
	НоваяОтправкаСсылка = ОтправитьВФССССервера(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаОтправки,
		СтрокаBase64ФайлаПакета,
		ОтчетСсылка,
		ПовторятьСоединение,
		ПараметрыОтправкиНаСервере);
	
	Если НЕ ЗначениеЗаполнено(НоваяОтправкаСсылка) Тогда
		
		СообщениеОбОшибке = "ОповеститьОНеудачнойОтправке";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПакетыТранспортныхСообщений

#Область ОбщиеПроцедурыИФункцииПакетовСообщений

Процедура СформироватьПакет(Сообщение, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	РеквизитыСообщения = Новый Структура();
	РеквизитыСообщения.Вставить("ВидЦиклаОбмена", "ЦиклОбмена.Вид");

	РеквизитыСообщения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сообщение, РеквизитыСообщения, Истина);
	ВидЦиклаОбмена = РеквизитыСообщения.ВидЦиклаОбмена;
	
	// В настоящий момент отправка рег.отчетов с сервера без взаимодействия с клиентским контекстом
	// поддерживается только для ФНС и ПФР.

	Если ВидЦиклаОбмена = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР Тогда
		СформироватьПакетПФР(Сообщение, Новый УникальныйИдентификатор, СообщениеОбОшибке);
	ИначеЕсли ВидЦиклаОбмена = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФНС Тогда
		СформироватьПакетФНС(Сообщение, Новый УникальныйИдентификатор, СообщениеОбОшибке);
	Иначе
		СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'СформироватьПакет(): Неподдерживаемый без взаимодействия с клиентским контекстом вид цикла обмена %1';
											|en = 'СформироватьПакет(): Not supported without interaction with client context exchange cycle kind %1'"), ВидЦиклаОбмена);
		ВызватьИсключение СообщениеОбОшибке;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСертификаты(Сертификаты, ВыполнятьПроверку)

	// Внимание!
	// ---------
	// В общем модуле КриптографияЭДКОСлужебныйКлиент есть одноименная процедура,
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	СертификатыВЗащищенномХранилищеНаСервере = Новый Массив;
	
	Для Каждого Сертификат Из Сертификаты Цикл
		Если КриптографияЭДКОКлиентСервер.СертификатВЗащищенномХранилищеНаСервере(Сертификат) Тогда
			СертификатыВЗащищенномХранилищеНаСервере.Добавить(Сертификат);
		КонецЕсли;
	КонецЦикла;
	
	РезультатПоиска = КриптографияЭДКОСлужебныйВызовСервера.НайтиСертификатыВЗащищенномХранилищеНаСервере(
		СертификатыВЗащищенномХранилищеНаСервере, ВыполнятьПроверку);

	Результат = КриптографияЭДКОКлиентСервер.ПодготовитьРезультат(Истина, "Сертификаты", РезультатПоиска.Сертификаты);
	Результат.Вставить("НенайденныеСертификаты", РезультатПоиска.НенайденныеСертификаты);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакет_ОтработатьОтложенныеКоманды(КонтекстОтправки, СообщениеОбОшибке)
	
	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиенте(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(КонтекстОтправки.УчетнаяЗапись, КонтекстОтправки);
	
	СформироватьПакет_ОтработатьОтложенныеКомандыПоследовательно(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Процедура СформироватьПакет_ОтработатьОтложенныеКомандыПоследовательно(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть аналогичная процедура СформироватьПакет_ОтработатьОтложенныеКомандыНаКлиентеПоследовательно(),
	// которая используется при отправке отчетов в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОтложенныеКоманды = КонтекстОтправки.ОтложенныеКоманды;

	Для ТекущаяКоманда = 0 По ОтложенныеКоманды.Количество() - 1 Цикл

		Данные = ИзвлечьДвоичныеДанныеПриНеобходимости(ОтложенныеКоманды[ТекущаяКоманда].Значение);
		
		Если ОтложенныеКоманды[ТекущаяКоманда].Представление = "Зашифровать" Тогда
			
			Если КонтекстОтправки.Свойство("ОбъектСертификатСервераДокументооборота")
				И ЗначениеЗаполнено(КонтекстОтправки.ОбъектСертификатСервераДокументооборота)
				И КонтекстОтправки.Свойство("СвойстваОтложенныхКоманд") Тогда
				
				ИдентификаторОтложеннойКоманды = ОтложенныеКоманды[ТекущаяКоманда].ПолучитьИдентификатор();
				СвойстваОтложеннойКоманды = КонтекстОтправки.СвойстваОтложенныхКоманд[ИдентификаторОтложеннойКоманды];
				Если СвойстваОтложеннойКоманды <> Неопределено И СвойстваОтложеннойКоманды.ДляСервераДокументооборота Тогда
					Попытка
						ЗашифрованныеДанные = СервисКриптографии.Зашифровать(
							Данные,
							КонтекстОтправки.ОбъектСертификатПолучателя);
						
						ЗашифрованныеДобавляемыеДанные = СервисКриптографии.Зашифровать(
							Данные,
							КонтекстОтправки.ОбъектСертификатСервераДокументооборота);
						
						МассивИменФайлов = Новый Массив;
						
						ФайлДанных = ПолучитьИмяВременногоФайла();
						ЗашифрованныеДанные.Записать(ФайлДанных);
						МассивИменФайлов.Добавить(ФайлДанных);
						
						ФайлРазделителя = ПолучитьИмяВременногоФайла();
						ДанныеРазделителя = Base64Значение("FD2WshXWT3yZW18vlRZXnA==");
						ДанныеРазделителя.Записать(ФайлРазделителя);
						МассивИменФайлов.Добавить(ФайлРазделителя);
						
						ФайлДобавляемыхДанных = ПолучитьИмяВременногоФайла();
						ЗашифрованныеДобавляемыеДанные.Записать(ФайлДобавляемыхДанных);
						МассивИменФайлов.Добавить(ФайлДобавляемыхДанных);
						
						ФайлРезультата = ПолучитьИмяВременногоФайла();
						ОбъединитьФайлы(МассивИменФайлов, ФайлРезультата);
						
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДанных);
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРазделителя);
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлДобавляемыхДанных);
						
						ДанныеРезультата = Новый ДвоичныеДанные(ФайлРезультата);
						ПоместитьВоВременноеХранилище(ДанныеРезультата, ОтложенныеКоманды[ТекущаяКоманда].Значение);
						
						ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультата);
					Исключение
						// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
						СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						Возврат;
					КонецПопытки;
					
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				ЗашифрованныеДанные = СервисКриптографии.Зашифровать(
					Данные,
					КонтекстОтправки.ОбъектСертификатПолучателя);
				
				// Заменяем сами данные на их зашифрованное значение.
				ПоместитьВоВременноеХранилище(ЗашифрованныеДанные, ОтложенныеКоманды[ТекущаяКоманда].Значение);
			Исключение
				// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат;
			КонецПопытки;

		ИначеЕсли ОтложенныеКоманды[ТекущаяКоманда].Представление = "ПодписатьФайлОписанияПакета" Тогда
			
			// Команда "ПодписатьФайлОписанияПакета" используется при подготовке отчетности в ПФР.
			Попытка

				ПараметрыПодписания = Новый Структура;
				ПараметрыПодписания.Вставить("ОтсоединеннаяПодпись", Истина);
				ПараметрыПодписания.Вставить("ИспользоватьДлительныйМаркерБезопасности", 
					МожноИспользоватьДлительныйМаркерБезопасностиДляСообщения(КонтекстОтправки.ТипСообщения));

				Подпись = СервисКриптографии.Подписать(
					Данные,
					КонтекстОтправки.ОбъектСертификатРуководителя,
					"CMS",
					ПараметрыПодписания);

				Если ТипЗнч(Подпись) = Тип("Структура") Тогда
					// Это структурированная ошибка при работе сервиса криптографии, передаем ее вызывающей процедуре.
					СообщениеОбОшибке = Подпись.КодВозврата;
					Возврат;
				КонецЕсли;

				// Запоминаем результат подписания.
				КонтекстОтправки.Вставить("ФайлПодписиПодФайломОписанияПакета", ПоместитьВоВременноеХранилище(Подпись, Новый УникальныйИдентификатор()));
			Исключение
				// Запись в журнал регистрации зарегистрирована исходным методом, повторно не регистрируем.
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат;
			КонецПопытки;
					
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КодПоТипуДокументаПакета(ТипДокумента, КодТипаДокументоооборота) Экспорт
	
	// отчетность ФНС
	Если ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Документ Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеДокумент Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Доверенность Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "04";
		Иначе
			Возврат "03";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправки Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "05";
		Иначе
			Возврат "04";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказе Тогда
		Если КодТипаДокументоооборота = "02" Тогда
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "06";
		Иначе
			Возврат "05";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриеме Тогда
		Если КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "05";
		Иначе
			Возврат "06";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеДокумент Тогда
		Возврат "06";
    ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеДокумент Тогда
		Возврат "05";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточнении Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОВводе Тогда
		Возврат "08";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолучении Тогда
		Если КодТипаДокументоооборота = "08" Тогда // документооборот по 2-НДФЛ
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "02" Тогда
			Возврат "06";
		ИначеЕсли КодТипаДокументоооборота = "03" Тогда // письмоНО
			Возврат "05";
		ИначеЕсли КодТипаДокументоооборота = "05" Тогда // рассылка групповая
			Возврат "05";
		ИначеЕсли КодТипаДокументоооборота = "10" Тогда // документ
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "08";
		ИначеЕсли КодТипаДокументоооборота = "09" Тогда // заявление
			Возврат "07";
		ИначеЕсли КодТипаДокументоооборота = "12" Тогда // представление
			Возврат "08";
		Иначе
			Возврат "09";
		КонецЕсли;
		
	//заявление
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Заявление Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗаявление Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеЗаявления Тогда
		Возврат "06";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПроверке Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОбОтзывеЗаявления Тогда
		Возврат "09";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОНесоответствиях Тогда
		Возврат "10";
		
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПростОтметки Тогда
		Возврат "08";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтметки Тогда
		Возврат "09";	
	
	// 2-НДФЛ
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ Тогда
		Возврат "05";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Реестр2НДФЛ Тогда
		Возврат "06";
	
	// обращение
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийОбращениеПисьмоРассылка Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение Тогда
		Если КодТипаДокументоооборота = "01" Тогда // ФНС
			Возврат "10";
		Иначе
			Возврат "03";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыПолучения Тогда
		Если КодТипаДокументоооборота = "06" Тогда // запрос
			Возврат "09";
		Иначе
			Возврат "08";
		КонецЕсли;
		
	// представление
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление Тогда
		Если КодТипаДокументоооборота = "01" ИЛИ КодТипаДокументоооборота = "06" ИЛИ КодТипаДокументоооборота = "08" ИЛИ КодТипаДокументоооборота = "09" Тогда
			Возврат "03";
		Иначе
			Возврат "04";
		КонецЕсли;
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПредставление Тогда
		Возврат "02";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправкиПредставление Тогда
		Если КодТипаДокументоооборота = "01" ИЛИ КодТипаДокументоооборота = "03" ИЛИ КодТипаДокументоооборота = "04" ИЛИ КодТипаДокументоооборота = "05"
			ИЛИ КодТипаДокументоооборота = "06" ИЛИ КодТипаДокументоооборота = "08" ИЛИ КодТипаДокументоооборота = "09" Тогда
			Возврат "04";
		Иначе
			Возврат "05";
		КонецЕсли;
		
	// запрос
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос Тогда
		Возврат "01";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Ответ Тогда
		Возврат "07";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗапрос Тогда
		Возврат "02";
		
	// запрос на выписку ЕГРЮЛ/ЕГРИП
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП Тогда
		Возврат "01";
	КонецЕсли;
	
КонецФункции

Функция ИдентификаторПоТипуДокументаПакета(ТипДокумента) Экспорт
	
	Если ТипЗнч(ТипДокумента) = Тип("Строка") Тогда
		Возврат СокрЛП(ТипДокумента);
		
	ИначеЕсли ТипДокумента = Перечисления.ТипыФайловОтчетностиПФР.ПачкаАДВ Тогда
