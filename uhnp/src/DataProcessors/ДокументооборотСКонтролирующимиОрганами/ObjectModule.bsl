Функция СформироватьФайлЗаявленияНаФормированиеСправкиОРасчетахСФР(ДокументСсылка) Экспорт
	
	// Пример:
	// <Application xmlns="http://www.fss.ru/integration/types/ls/v01">
	//  <CommonDataType>
	//    <kpsNum>00000</kpsNum>
	//    <dateStart>1957-08-13</dateStart>
	//    <idMessage>00000000-0000-0000-0000-000000000000</idMessage>
	//    <id>00000000-0000-0000-0000-000000000000</id>
	//   </CommonDataType>
	//  <SvedSostRaschPhysRequest>
	//    <regNum>0000000000</regNum>
	//    <regNumSFR>0000000000</regNumSFR>
	//    <firstNameCiv>String</firstNameCiv>
	//    <lastNameCiv>String</lastNameCiv>
	//    <middleNameCiv>String</middleNameCiv>
	//    <docDatCiv>1957-08-13</docDatCiv>
	//    <inn>0000000000</inn>
	//    <docTypeCiv>String</docTypeCiv>
	//    <docSeries>String</docSeries>
	//    <docNumber>String</docNumber>
	//  </SvedSostRaschPhysRequest>
	//  <SvedSostRaschJurRequest>
	//    <regNum>0</regNum>
	//    <fullName>a</fullName>
	//    <inn>0000000000</inn>
	//    <kpp>000000000</kpp>
	//  </SvedSostRaschJurRequest>
	// </Application>
	
	Результат = Новый Структура;
	Результат.Вставить("Содержимое", 			"");
	Результат.Вставить("ИмяФайла", 				"");
	
	ДанныеДокумента = ДанныеИзИнформационнойБазыЗаявленияНаФормированиеСправкиОРасчетах(ДокументСсылка);
	
	Если ДанныеДокумента = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось сформировать заявление на формирование справки о расчетах с СФР';
													|en = 'Cannot create an application to prepare a statement of payments to the Social Insurance Fund of Russia'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Результат.ИмяФайла = "Application_" + СокрЛП(ДанныеДокумента.ИдентификаторСообщения);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("utf-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Application");
	
	ЗаписьXML.ЗаписатьАтрибут("xmlns", "http://www.fss.ru/integration/types/ls/v01");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("CommonDataType");
	
	ЗаписатьУзелXML(ЗаписьXML, "kpsNum", ДанныеДокумента.КодПодчиненностиФСС);
	ЗаписатьУзелXML(ЗаписьXML, "dateStart", Формат(ДанныеДокумента.ДатаЗадолженности, "ДФ=yyyy-MM-dd"));
	ЗаписатьУзелXML(ЗаписьXML, "idMessage", ДанныеДокумента.ИдентификаторСообщения);
	ЗаписатьУзелXML(ЗаписьXML, "id", Новый УникальныйИдентификатор);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // CommonDataType
	
	Если ДанныеДокумента.Страхователь_ЮридическоеЛицо Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("SvedSostRaschJurRequest");
		
		Если НЕ ПустаяСтрока(ДанныеДокумента.РегистрационныйНомерСФР) Тогда
			ЗаписатьУзелXML(ЗаписьXML, "regNumSFR", ДанныеДокумента.РегистрационныйНомерСФР);
		Иначе
			ЗаписатьУзелXML(ЗаписьXML, "regNum", ДанныеДокумента.РегистрационныйНомерФСС);
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "fullName", ДанныеДокумента.СтраховательЮЛ_НаимОрг);
		ЗаписатьУзелXML(ЗаписьXML, "inn", ДанныеДокумента.СтраховательЮЛ_ИНН);
		ЗаписатьУзелXML(ЗаписьXML, "kpp", ДанныеДокумента.СтраховательЮЛ_КПП);
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // SvedSostRaschJurRequest
	Иначе
		ЗаписьXML.ЗаписатьНачалоЭлемента("SvedSostRaschPhysRequest");
		
		Если НЕ ПустаяСтрока(ДанныеДокумента.РегистрационныйНомерСФР) Тогда
			ЗаписатьУзелXML(ЗаписьXML, "regNumSFR", ДанныеДокумента.РегистрационныйНомерСФР);
		Иначе
			ЗаписатьУзелXML(ЗаписьXML, "regNum", ДанныеДокумента.РегистрационныйНомерФСС);
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "firstNameCiv", ДанныеДокумента.СтраховательФЛ_Имя, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "lastNameCiv", ДанныеДокумента.СтраховательФЛ_Фамилия, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "middleNameCiv", ДанныеДокумента.СтраховательФЛ_Отчество, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "docDatCiv", Формат(ДанныеДокумента.СтраховательФЛ_ДатаВыдачиДокумента, "ДФ=yyyy-MM-dd"), Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "inn", ДанныеДокумента.СтраховательФЛ_ИНН, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "docTypeCiv", ДанныеДокумента.СтраховательФЛ_ВидДокумента, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "docSeries", ДанныеДокумента.СтраховательФЛ_СерияДокумента, Ложь);
		ЗаписатьУзелXML(ЗаписьXML, "docNumber", ДанныеДокумента.СтраховательФЛ_НомерДокумента, Ложь);
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // SvedSostRaschPhysRequest
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Application
	
	Результат.Содержимое = ЗаписьXML.Закрыть();
	
	Результат.ИмяФайла = Результат.ИмяФайла + ".xml";
	
	Возврат Результат.Содержимое;
	
КонецФункции

