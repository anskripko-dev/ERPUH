Функция ЗаявлениеИСтатусПоОтпечатку(Отпечаток) Экспорт
	
	Заявление = ЗаявлениеАбонентаДляЗаменыСертификата(Отпечаток, ТекущаяДатаСеанса(), 1);
	Статус    = СтатусЗаявленияАстралМ(Заявление);
		
	Результат = Новый Структура();
	Результат.Вставить("Заявление", Заявление);
	Результат.Вставить("Статус",    Статус);
		
	Возврат Результат;
	
