Функция ВыгрузкаОтчетовПоМестуТребования_Отчеты_Отчет(ВходящийКонтекст) Экспорт
		
	ЦиклОбмена 		   = ВходящийКонтекст.ЦиклОбмена;
	ТолькоОценка	   = ВходящийКонтекст.ТолькоОценка;
	ВременныйКаталог   = ВходящийКонтекст.ВременныйКаталог;
	Представление      = ВходящийКонтекст.Представление;
	
	Если ЦиклОбмена.Тип <> Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность Тогда
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: функция поддерживается только для циклов обмена по бухгалтерской или налоговой отчетности (кроме форм 2-НДФЛ и ""Заявление о ввозе товаров"").";
	Иначе
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует файл отчетности.";
	КонецЕсли;
	
	// Отчет
	СтрОтчетность = СтрокаВыгрузки(
		ВходящийКонтекст,
		СтрСообщение, 
		ИдентификаторыВыгрузки().ИдентификаторОтчетность);
		
	Если СтрОтчетность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяФайлаОтчетности = СтрОтчетность.ИмяФайла;
	ВходящийКонтекст.Вставить("ИмяФайлаОтчетности", ИмяФайлаОтчетности);
	
	// Подпись налогоплательщика под отчетом
	СтрЭЦПНалогоплательщикаПодФайломОтчетности = СтрокаВыгрузки(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует подпись налогоплательщика под файлом отчетности.", 
		ИдентификаторыВыгрузки().ИдентификаторОтчетностьЭЦПНалогоплательщика, 
		ИмяФайлаОтчетности);
		
	Если СтрЭЦПНалогоплательщикаПодФайломОтчетности = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТолькоОценка Тогда 
		Возврат Истина;
	КонецЕсли;
	
	// выгружаем файлы
	Попытка
	
		СтрОтчетность.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности);
		СтрЭЦПНалогоплательщикаПодФайломОтчетности.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".p7s");
		
	Исключение
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
		ВходящийКонтекст.ТекстОшибки = СтрСообщение;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_ЗапросыНаСверку(ВходящийКонтекст) Экспорт
		
	ЦиклОбмена 		 = ВходящийКонтекст.ЦиклОбмена;
	ТолькоОценка	 = ВходящийКонтекст.ТолькоОценка;
	ВременныйКаталог = ВходящийКонтекст.ВременныйКаталог;
	Представление    = ВходящийКонтекст.Представление;
	
	// ищем результат сверки
	РезультатПоиска = РезультатПоискаФайлов(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует ответ на запрос сверки.",
		ИдентификаторыВыгрузки().ИдентификаторРезультатаСверки);
		
	Если РезультатПоиска = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрРезультатСверки = РезультатПоиска[0];
	ИмяРезультатаСверки = СтрРезультатСверки.ИмяФайла;
	
	ВходящийКонтекст.Вставить("ИмяФайлаОтчетности", ИмяРезультатаСверки);
	
	ИнкрементироватьОбъект(СтрРезультатСверки, ВходящийКонтекст);
	
	// ищем ЭЦП налогового органа под результатом сверки
	РезультатПоиска = РезультатПоискаФайлов(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует подпись налогового органа под ответом на запрос сверки.", 
		ИдентификаторыВыгрузки().ИдентификаторЭЦПНалоговогоОргана, 
		ИмяРезультатаСверки);
		
	Если РезультатПоиска = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрЭЦПНалоговогоОрганаПодРезультатомСверки = РезультатПоиска[0];
	ИнкрементироватьОбъект(СтрЭЦПНалоговогоОрганаПодРезультатомСверки, ВходящийКонтекст);
	
	Если ТолькоОценка Тогда 
		Возврат Истина;
	КонецЕсли;
	
	// выгружаем файлы
	Попытка
		СтрРезультатСверки.Данные.Получить().Записать(ВременныйКаталог + ИмяРезультатаСверки);
		СтрЭЦПНалоговогоОрганаПодРезультатомСверки.Данные.Получить().Записать(ВременныйКаталог + ИмяРезультатаСверки + ".FNS.p7s");
	Исключение
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
		ВходящийКонтекст.ТекстОшибки = СтрСообщение;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_СохранитьРезультат(ВходящийКонтекст, Результат) Экспорт
	
	// фиксируем результат выгрузки пакета по циклу обмена
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяФайла", ВходящийКонтекст.ИмяФайлаПакета);
	ДополнительныеПараметры.Вставить("Адрес",    ВходящийКонтекст.АдресВоВременномХранилище);
	ДополнительныеПараметры.Вставить("Всего",    ВходящийКонтекст.Объектов);
	ДополнительныеПараметры.Вставить("ВАрхиве",  ВходящийКонтекст.ОбъектовВАрхиве);
	
	Результат.Вставить(ВходящийКонтекст.ЦиклОбмена, ДополнительныеПараметры);
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_СформироватьАрхив(ВходящийКонтекст) Экспорт
		
	ЦиклОбмена       = ВходящийКонтекст.ЦиклОбмена;
	Представление    = ВходящийКонтекст.Представление;
	ВременныйКаталог = ВходящийКонтекст.ВременныйКаталог;
		
	// формируем zip-архив
	Попытка
	
		ИмяФайлаПакета = ИмяФайлаБезРасширения(ВходящийКонтекст.ИмяФайлаОтчетности) + ".zip";
		ПолноеИмяФайлаПакета = ПолучитьКаталогВременныхФайлов() + ИмяФайлаПакета;
		ОбъектЗапись = Новый ЗаписьZipФайла(ПолноеИмяФайлаПакета);
		ОбъектЗапись.Добавить(ВременныйКаталог + ПолучитьМаскуВсеФайлы());
		ОбъектЗапись.Записать();
		
	Исключение
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: не удалось сохранить файл пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
		ВходящийКонтекст.ТекстОшибки  = СтрСообщение;
		Возврат Ложь;
	КонецПопытки;
	
	// удаляем временный каталог
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
	
	// сохраняем во временном хранилище
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаПакета), ВходящийКонтекст.УникальныйИдентификатор);
	
	ВходящийКонтекст.Вставить("ИмяФайлаПакета", ИмяФайлаПакета);
	ВходящийКонтекст.Вставить("АдресВоВременномХранилище", АдресВоВременномХранилище);
	
	Возврат Истина;
	
КонецФункции

Функция ПрочитатьТекстИзФайлаСтрокойBase64(ИмяФайла, Знач ЗаданнаяКодировкаТекста = Неопределено, Знач АвтоопределениеКодировкиXML = Ложь) Экспорт 
	
	ДвДанные = Base64Значение(ИмяФайла);
	ИмяФайлаНаДиске = ПолучитьИмяВременногоФайла();
	ДвДанные.Записать(ИмяФайлаНаДиске);
	
	Если ЗаданнаяКодировкаТекста = Неопределено Тогда
		АвтоопределениеКодировкиXML = Истина;
	КонецЕсли;
			
	Если АвтоопределениеКодировкиXML Тогда
		Попытка
			КодировкаДанных = ОпределитьКодировку(ДвДанные);
		Исключение
			ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами.ПрочитатьТекстИзФайлаСтрокойBase64()';
					|en = 'Electronic data interchange with regulatory authorities.ПрочитатьТекстИзФайлаСтрокойBase64()'"), 
				УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон("%1: %2", "Определение кодировки не удалось", ИнформацияОбОшибке));
				
			КодировкаДанных = Неопределено;
		КонецПопытки;
	Иначе
		КодировкаДанных = ЗаданнаяКодировкаТекста;
	КонецЕсли;
	
	ОбъектЧтение = НовыйЧтениеТекстаНаСервере(ИмяФайлаНаДиске, КодировкаДанных);
	ТекстИзФайла = ОбъектЧтение.Прочитать();
	ОбъектЧтение.Закрыть();
	
	Возврат ТекстИзФайла;
	
КонецФункции

Функция ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрокаBase64, Знач ЗаданнаяКодировкаТекста = Неопределено, Знач АвтоопределениеКодировкиXML = Ложь) Экспорт
	
	Попытка
		ТекстИзФайла = ПрочитатьТекстИзФайлаСтрокойBase64(СтрокаBase64, ЗаданнаяКодировкаТекста, АвтоопределениеКодировкиXML);
	Исключение
		// Не требует специальной обработки.
		// Сделано для обхода ошибки, когда ФНС должно присылать квитанции в формате windows-1251, а присылают в формате Utf-8
		ТекстИзФайла = ПрочитатьТекстИзФайлаСтрокойBase64(СтрокаBase64, , Истина);	
	КонецПопытки; 
	
	Возврат ТекстИзФайла;
	
КонецФункции

Функция ТабДокументИзвещенияОВводе(СвойстваИзИзвещения, ТаблицаПодписей = Неопределено) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакетОбработки("ИзвещениеОВводе");
	ОбластьМакета = Макет.ПолучитьОбласть("ИзвещениеОВводе");
	ОбластьМакета.Параметры.КодНалоговогоОргана = СвойстваИзИзвещения.НалоговыйОрган;
	ОбластьМакета.Параметры.НаименованиеФайла = ВРег(СвойстваИзИзвещения.ОбщиеСведения.ИмяОбрабФайла);
	ОбластьМакета.Параметры.Отправитель = СвойстваИзИзвещения.ПредставлениеОтпр;
	ОбластьМакета.Параметры.Налогоплательщик = СвойстваИзИзвещения.ПредставлениеНП;
	
	НаименованиеНалоговогоОргана = "";
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	НалоговыеОрганы.Наименование
	                      |ИЗ
	                      |	Справочник.НалоговыеОрганы КАК НалоговыеОрганы
	                      |ГДЕ
	                      |	НалоговыеОрганы.Код = &КодНалоговогоОргана");
	Запрос.УстановитьПараметр("КодНалоговогоОргана", СвойстваИзИзвещения.НалоговыйОрган);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НаименованиеНалоговогоОргана = Выборка.Наименование;
	КонецЕсли;
	Если ЗначениеЗаполнено(НаименованиеНалоговогоОргана) Тогда
		ОбластьМакета.Параметры.НаименованиеИКодНалоговогоОргана = НаименованиеНалоговогоОргана + ", " + НСтр("ru = 'код';
																												|en = 'code'") + " " + СвойстваИзИзвещения.НалоговыйОрган;
	Иначе
		ОбластьМакета.Параметры.НаименованиеИКодНалоговогоОргана = НСтр("ru = 'ФНС';
																		|en = 'FTS'") + " " + СвойстваИзИзвещения.НалоговыйОрган;
	КонецЕсли;
	
	ОбластьМакета.Параметры.НаименованиеДекларации = СформироватьТекстовуюИнформациюОДекларации(СвойстваИзИзвещения.ОбщиеСведения);
	
	ТабДокумент.Вывести(ОбластьМакета); // ИзвещениеОВводе
	
	Если ТаблицаПодписей <> Неопределено Тогда
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ТабДокументКвитанцияОПриеме(СвойстваИзУведомления, ТаблицаПодписей = Неопределено) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакетОбработки("КвитанцияОПриемеДекларации");
	
	ОбластьМакета = Макет.ПолучитьОбласть("КвитанцияОПриемеДекларации");
	ОбластьМакета.Параметры.НалоговыйОрганПодтверждающий = СвойстваИзУведомления.НалоговыйОрганПодтверждающий;
	ОбластьМакета.Параметры.НалоговыйОрганПолучатель = СвойстваИзУведомления.НалоговыйОрганПолучатель;
	ОбластьМакета.Параметры.ИмяФайла = ВРег(СвойстваИзУведомления.ОбщиеСведения.ИмяОбрабФайла);
	ОбластьМакета.Параметры.Отправитель = СвойстваИзУведомления.ПредставлениеОтпр;
	ОбластьМакета.Параметры.Налогоплательщик = СвойстваИзУведомления.ПредставлениеНП;
	ОбластьМакета.Параметры.Дата = СвойстваИзУведомления.ОбщиеСведения.ДатаПредст;
	ОбластьМакета.Параметры.Время = СтрЗаменить(СвойстваИзУведомления.ОбщиеСведения.ВремПредст,".",":");
	ОбластьМакета.Параметры.ДатаПоступления = СвойстваИзУведомления.ОбщиеСведения.ДатаПост;
	ОбластьМакета.Параметры.ДатаПриема = СвойстваИзУведомления.ОбщиеСведения.ДатаПрин;
	
	ОбластьМакета.Параметры.НаименованиеДекларации = СформироватьТекстовуюИнформациюОДекларации(СвойстваИзУведомления.ОбщиеСведения);
	
	ОбластьМакета.Параметры.РегистрационныйНомер = СвойстваИзУведомления.ОбщиеСведения.РегНом+".";
	ТабДокумент.Вывести(ОбластьМакета); // КвитанцияОПриемеДекларации
	
	Если ТаблицаПодписей <> Неопределено Тогда
		СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, ТаблицаПодписей);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ТабДокументУведомлениеОПриемеОтказеФСС(СвойстваИзУведомления, ТаблицаПодписей = Неопределено) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакетОбработки("УведомлениеОПриемеОтказеФСС");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ВидПроверки = СвойстваИзУведомления.ВидПроверки;
	ОбластьМакета.Параметры.СвПолДок = СвойстваИзУведомления.СвПолДок;
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаблицы");
	Для каждого Элемент из СвойстваИзУведомления.СтатусыДокументов Цикл
		ОбластьМакета.Параметры.Заполнить(Элемент);
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Дата");
	ОбластьМакета.Параметры.ДатаУведомления = СвойстваИзУведомления.ДатаУведомления;
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.СвОргФСС = СвойстваИзУведомления.СвОргФСС;
	ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция СформироватьТабличныйДокументСекцияПодписи(ТабДокумент, Макет, Подписи) Экспорт
	
	Если Подписи <> Неопределено И Подписи.Количество() <> 0 Тогда
		
		КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
		
		ДвДанныеФайлаПодписи = Новый Массив;
		Для каждого Подпись Из Подписи Цикл
			
			Свойства = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СвойстваПодписиДляШтампа();
			Свойства.ДвДанные = Base64Значение(Подпись.Файл);
			КонтекстЭДОСервер.ЗаполнитьСвойстваПодписиДляШтампа(Подпись.ТранспортноеСообщение, Подпись.ЭЦПЭтоПодписьАбонента, Свойства); 
			
			ДвДанныеФайлаПодписи.Добавить(Свойства);
			
		КонецЦикла; 
		
		КонтекстЭДОСервер.ДобавитьШтампПодписи(ДвДанныеФайлаПодписи, ТабДокумент, 2, Ложь);
		
	КонецЕсли;
	
КонецФункции

Функция СформироватьТекстовуюИнформациюОДекларации(СведенияОДекларации) Экспорт
	
	Если СведенияОДекларации.Свойство("НомКорр") Тогда
		НомКорр = СведенияОДекларации.НомКорр;
	Иначе
		НомКорр = "";
	КонецЕсли;
	
	Если ПустаяСтрока(НомКорр) ИЛИ НомКорр = "0" Тогда
		ВидДокумента = "первичный";
	Иначе
		ВидДокумента = "корректирующий("+ НомКорр+"),";
	КонецЕсли;
	
	Если СведенияОДекларации.Свойство("Период") Тогда
		Период = ПолучитьНаименованиеНалоговогоПериодаПоКоду(СведенияОДекларации.Период);
	Иначе
		Период = "";
	КонецЕсли;
	
	МассивСведений = Новый Массив;
	Если СведенияОДекларации.Свойство("НаимОтч") Тогда
		МассивСведений.Добавить(СведенияОДекларации.НаимОтч);
	КонецЕсли;
	Если СведенияОДекларации.Свойство("КНД") Тогда
		МассивСведений.Добавить(СведенияОДекларации.КНД);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		МассивСведений.Добавить(ВидДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(Период) Тогда
		МассивСведений.Добавить(Период);
	КонецЕсли;
	Если СведенияОДекларации.Свойство("ОтчетГод") Тогда
		МассивСведений.Добавить(СведенияОДекларации.ОтчетГод + "г.");
	КонецЕсли;
	
	Если МассивСведений.Количество() > 0 Тогда
		Возврат СтрСоединить(МассивСведений, ",");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНаименованиеНалоговогоПериодаПоКоду(КодПериода) Экспорт
	
	Если ПустаяСтрока(КодПериода) Тогда
		КодПериода = "99";
	КонецЕсли;
	
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СокрЛП(КодПериода)) Тогда
		КодПериода = Формат(Число(КодПериода), "ЧЦ=2; ЧВН=");
	Иначе
		КодПериода = СокрЛП(КодПериода);
	КонецЕсли;
	
	МакетРегионы = ПолучитьМакетОбработки("КодыНалоговыхПериодов");
	
	Для Инд = 1 По МакетРегионы.ВысотаТаблицы Цикл
		ТекКод = МакетРегионы.Область(Инд, 1, Инд, 1).Текст;
		
		НаименованиеПериода = СокрЛП(МакетРегионы.Область(Инд, 2, Инд, 2).Текст);
		
		Если ТекКод = КодПериода Тогда
			Возврат НаименованиеПериода;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НаименованиеПериода;
	
КонецФункции

Функция ПолучитьОсновныеСвойстваИзИзвещенияОВводе(СтрУведомление) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтрУведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// считываем подтверждение из файла в дерево XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(, СтрУведомление, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка чтения XML извещения о вводе:%1';
																						|en = 'An error occurred while reading XML notice of input:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения о вводе: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML notification of input: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения о вводе: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML notice of input: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвИзвещВ = УзелДокумент.Строки.Найти("СвИзвещВ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвИзвещВ) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения о вводе: не обнаружен узел ""СвИзвещВ"".';
								|en = 'Incorrect structure of XML notice of input: the ""СвИзвещВ"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	Для Каждого УзелОбщСвед Из УзелСвИзвещВ.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	Если ОбщиеСведения.Свойство("Период") И ОбщиеСведения.Свойство("ПериодНаим") Тогда
		ОбщиеСведения.Вставить("ОтчетныйПериод", ОбщиеСведения.Период + " (" + ОбщиеСведения.ПериодНаим + ")");
	КонецЕсли;
	
	// разбираем сведения о налоговом органе
	УзелКодНоОтпр = УзелДокумент.Строки.Найти("КодНоОтпр", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелКодНоОтпр) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML извещения о вводе: не обнаружен узел ""КодНоОтпр"".';
								|en = 'Incorrect structure of XML notice of input: the ""КодНоОтпр"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	НалоговыйОрган = СокрЛП(УзелКодНоОтпр.Значение);
	
	// Сведения об отправителе отчетности
	ПредставлениеОтпр = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвПол", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("ОтпрЮЛ", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("ОтпрФЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	// Сведения о налогоплательщике
	ПредставлениеНП = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвНП", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("НПФЛ", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("НПЮЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	Возврат Новый Структура("НалоговыйОрган, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр", НалоговыйОрган, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр);
	
КонецФункции

Функция ПолучитьПредставлениеНП(ЮрФизЛицо,ДанныеНП) Экспорт
	
	Представление = "";
	
	Если ЮрФизЛицо Тогда
		Если ДанныеНП.Строки.Количество() > 0 Тогда
			
			ИННСтрока = "";
			КППСтрока = "";
			НаимСтрока = "";
			Для Каждого УзелОбщСведНП Из ДанныеНП.Строки Цикл
				ДанныеСтроки = СокрЛП(УзелОбщСведНП.Значение);
				Если Лев(УзелОбщСведНП.Имя,3) = "ИНН" Тогда
					ИННСтрока = ", "+ДанныеСтроки;
				ИначеЕсли УзелОбщСведНП.Имя = "КПП" Тогда
					КППСтрока = " / "+ДанныеСтроки;
				ИначеЕсли УзелОбщСведНП.Имя = "НаимОрг" Тогда
					НаимСтрока = ДанныеСтроки;
				КонецЕсли;
			КонецЦикла;
			
			Представление = НаимСтрока + ИННСтрока + КППСтрока;
			
		КонецЕсли;
	Иначе
		
		ФИОДанныеНП = ДанныеНП.Строки.Найти("ФИО", "Имя");
		
		Если НЕ ЗначениеЗаполнено(ФИОДанныеНП) Тогда
			ФИОДанныеНП = ДанныеНП.Родитель.Строки.Найти("ФИО", "Имя");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФИОДанныеНП) Тогда
			Для Каждого СтрокаФИО Из ФИОДанныеНП.Строки Цикл
				Представление = Представление+ " " +СтрокаФИО.Значение;
			КонецЦикла; 
		КонецЕсли;
		
		ИННДанныеНП = ДанныеНП.Строки.Найти("ИННФЛ", "Имя");
		
		Если ЗначениеЗаполнено(ИННДанныеНП) Тогда
			Представление = Представление + ", " + ИННДанныеНП.Значение;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

Функция РезультатыПриемаДекларацийБезПрикрепленныхПодписей(ЦиклыОбмена) Экспорт
	
	Результат = Новый Массив; 
	
	ТипСообщения = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО;
	Статус = Перечисления.СтатусыПисем.Полученное; 
	ТипПодписи = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТранспортноеСообщение.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Сообщения
	|ИЗ
	|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
	|ГДЕ
	|	ТранспортноеСообщение.ЦиклОбмена В(&ЦиклыОбмена)
	|	И ТранспортноеСообщение.ПометкаУдаления = ЛОЖЬ
	|	И ТранспортноеСообщение.Тип = &ТипСообщения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение КАК ТранспортноеСообщение,
	|	СодержимоеТранспортныхКонтейнеров.Тип КАК Тип,
	|	СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента КАК ЭЦПЭтоПодписьАбонента,
	|	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла КАК ЭЦПИмяПодписанногоФайла
	|ИЗ
	|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
	|ГДЕ
	|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение В
	|			(ВЫБРАТЬ
	|				ВТ_Сообщения.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТ_Сообщения КАК ВТ_Сообщения)
	|	И СодержимоеТранспортныхКонтейнеров.Тип = &ТипПодписи
	|	И СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента = ЛОЖЬ
	|	И СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла = &ИмяПодписанногоФайла";
	
	Запрос.УстановитьПараметр("ТипПодписи", ТипПодписи);
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	Запрос.УстановитьПараметр("ЦиклыОбмена", ЦиклыОбмена);
	Запрос.УстановитьПараметр("ИмяПодписанногоФайла", "");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Добавить(ВыборкаДетальныеЗаписи.ТранспортноеСообщение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

#КонецОбласти

Процедура ПолучитьИзображенияПрисоединенныхФайловИсточников(ФайлыИсточников, ИдентификаторФормыВладельца) Экспорт
	
	Для Каждого ФайлыИсточника Из ФайлыИсточников Цикл
		
		ИсточникСсылка = ФайлыИсточника.Ключ;
		
		МассивФайлов = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ИсточникСсылка, МассивФайлов);
		
		СвойстваФайлов = Новый Массив;
		
		Для Каждого ПрисоединенныйФайл Из МассивФайлов Цикл
			
			ДополнительныеПараметры = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
			ДополнительныеПараметры.ИдентификаторФормы = ИдентификаторФормыВладельца;
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл, ДополнительныеПараметры);
			
			РасширениеФайла = нрег(ДанныеФайла.Расширение);
			Если РасширениеФайла = "tif"
					Или РасширениеФайла = "jpg"
					Или РасширениеФайла = "jpeg"
					Или РасширениеФайла = "png"
					Или РасширениеФайла = "pdf" Тогда
				СвойстваФайла = Новый Структура();
				СвойстваФайла.Вставить("Имя", ДанныеФайла.ИмяФайла);
				СвойстваФайла.Вставить("Размер", ДанныеФайла.Размер);
				СвойстваФайла.Вставить("АдресДанных", ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
				
				СвойстваФайлов.Добавить(СвойстваФайла);
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			// ИнтеграцияС1СДокументооборотом
			Если СвойстваФайлов.Количество() = 0 И ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1СДокументооборотом") Тогда
				ВерсияБИД = ОбновлениеИнформационнойБазы.ВерсияИБ("БиблиотекаИнтеграцииС1СДокументооборотом");
				Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияБИД, "3.0.2.6") >= 0 Тогда
					МодульИнтеграцияС1СДокументооборотБазоваяФункциональность = ОбщегоНазначения.ОбщийМодуль(
						"ИнтеграцияС1СДокументооборотБазоваяФункциональность");
					ДанныеФайловОбъектаИС = МодульИнтеграцияС1СДокументооборотБазоваяФункциональность.ДанныеФайловОбъектаИС(
						ИсточникСсылка,
						ИдентификаторФормыВладельца,
						"tif,jpg,jpeg,png,pdf");
					Для Каждого ДанныеФайла Из ДанныеФайловОбъектаИС Цикл
						СвойстваФайла = Новый Структура();
						СвойстваФайла.Вставить("Имя", ДанныеФайла.ИмяФайла);
						СвойстваФайла.Вставить("Размер", ДанныеФайла.Размер);
						СвойстваФайла.Вставить("АдресДанных", ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
						
						СвойстваФайлов.Добавить(СвойстваФайла);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			// Конец ИнтеграцияС1СДокументооборотом
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение файлов из БИД (интеграции с 1С:ДО)';
					|en = 'Electronic data interchange with regulatory authorities. Receive files from LID (integration with 1C:Document Management)'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
		КонецПопытки;
			
		ФайлыИсточников.Вставить(ИсточникСсылка, СвойстваФайлов);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СписокВыбораТиповПервичныйДокументВОтветеНаТребование(МножественныйВыбор) Экспорт
	
	МассивТипов = Метаданные.ОпределяемыеТипы.ИсточникДокументаПоТребованиюФНСБРО.Тип.Типы();
	
	ТаблицаТипов = Новый ТаблицаЗначений;
	ТаблицаТипов.Колонки.Добавить("Тип");
	ТаблицаТипов.Колонки.Добавить("НаименованиеТипа");
	
	Для каждого ТипДокумента Из МассивТипов Цикл
		
		НоваяСтрока = ТаблицаТипов.Добавить();
		НоваяСтрока.Тип = ТипДокумента;
		НоваяСтрока.НаименованиеТипа = Строка(ТипДокумента);
		
	КонецЦикла;
	
	ТаблицаТипов.Сортировать("НаименованиеТипа");
	
	СписокЗначений = Новый СписокЗначений;
	Для каждого СтрокаТаблицыТипов Из ТаблицаТипов Цикл
		СписокЗначений.Добавить(СтрокаТаблицыТипов.Тип, Строка(СтрокаТаблицыТипов.Тип));
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция ЭлектронныеДокументыЭДО(ДокументИсточник) Экспорт
	
	ВидДокументаФНС         = Неопределено;
	ЕстьЭлектронныйДокумент = Ложь;
	Виды = ВидыДокументовЭДОСПодтверждением();
	
	Попытка
	
		ЭлектронныеДокументы = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьФайлыВыгрузкиЭД(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументИсточник), Новый УникальныйИдентификатор);
		
	Исключение
		
		// Не требует специальных обработок
		ЭлектронныеДокументы = Неопределено;
		
	КонецПопытки;
	
	Если ЭлектронныеДокументы <> Неопределено Тогда
		
		СписокДокументов = ЭлектронныеДокументы.Получить(ДокументИсточник);
		
		Если СписокДокументов <> Неопределено Тогда
			
			СвойстваВладельцевЭД = Новый Соответствие;
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ОпределитьСвойстваВладельцевЭлектронныхДокументов(
				СвойстваВладельцевЭД, ДокументИсточник);
				
			СвойстваИсточника = СвойстваВладельцевЭД[ДокументИсточник];
			СоответствиеВидов = ЭлектронныйДокументооборотСКонтролирующимиОрганами.СоответствиеВидовДокументовФНС();
			ВидДокументаФНС   = СоответствиеВидов[СвойстваИсточника];
			
			Если ВидДокументаФНС <> Неопределено Тогда
				
				// Проверка на наличие двух необходимых подписей
				
				Если Виды.Найти(ВидДокументаФНС) <> Неопределено Тогда
					
					// "ЭЦП", "ФайлВыгрузки", "ФайлПодтверждения", "ЭЦППодтверждения"
					Если ТипЗнч(СписокДокументов) = Тип("Массив") 
						И СписокДокументов.Количество() = 4 Тогда
						ЕстьЭлектронныйДокумент = Истина; 
					КонецЕсли;
					
				Иначе
					ЕстьЭлектронныйДокумент = Истина;
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидДокументаФНС",         ВидДокументаФНС);
	ДополнительныеПараметры.Вставить("ЕстьЭлектронныйДокумент", ЕстьЭлектронныйДокумент);
	
	Возврат ДополнительныеПараметры;
		
КонецФункции

Процедура ЗавершитьНастройкуЗаявлений() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявлениеАбонентаСпецоператораСвязи.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
		|ГДЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.НастройкаЗавершена = Ложь
		|	И ЗаявлениеАбонентаСпецоператораСвязи.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаявлениеОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ЗаявлениеОбъект.НастройкаЗавершена = Истина;
		ЗаявлениеОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСпособПолученияСертификата() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ЗаявлениеАбонентаСпецоператораСвязи
		|ГДЕ
		|	ЗаявлениеАбонентаСпецоператораСвязи.СпособПолученияСертификата = ЗНАЧЕНИЕ(Перечисление.СпособПолученияСертификата.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			ЗаявлениеСсылка = ВыборкаДетальныеЗаписи.Ссылка;
			ЗаявлениеОбъект = ЗаявлениеСсылка.ПолучитьОбъект();
			ЗаявлениеОбъект.СпособПолученияСертификата = Перечисления.СпособПолученияСертификата.ИздатьНовый;
			ЗаявлениеОбъект.Записать();
		Исключение
		КонецПопытки; 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТипСверкиИОН() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаИнформационноеОбслуживаниеНалогоплательщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика КАК ЗапросНаИнформационноеОбслуживаниеНалогоплательщика
		|ГДЕ
		|	ЗапросНаИнформационноеОбслуживаниеНалогоплательщика.ТипСверки = ЗНАЧЕНИЕ(Перечисление.ТипыСверокИОН.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗапросИОНСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		ЗапросИОНОбъект = ЗапросИОНСсылка.ПолучитьОбъект();
		
		Если ЗапросИОНСсылка.ВидУслуги = ПредопределенноеЗначение("Перечисление.ВидыУслугПриИОН.ПредставлениеСправкиОбИсполненииОбязанностейПоУплате") Тогда
			ТипСверки = Перечисления.ТипыСверокИОН.ВЦеломПоОрганизации;
		Иначе
			ТипСверки = Перечисления.ТипыСверокИОН.ПоОдномуКППВОднуФНС;
		КонецЕсли;
		
		ЗапросИОНОбъект.ТипСверки = ТипСверки;
		ЗапросИОНОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПериодЗапросовИОН() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналОтправокВКонтролирующиеОрганы.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы КАК ЖурналОтправокВКонтролирующиеОрганы
		|ГДЕ
		|	(ЖурналОтправокВКонтролирующиеОрганы.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ЖурналОтправокВКонтролирующиеОрганы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И ЖурналОтправокВКонтролирующиеОрганы.СтраницаЖурнала = ЗНАЧЕНИЕ(Перечисление.СтраницыЖурналаОтчетность.Сверки)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Свойства = СвойстваЗапросаНаИнформационноеОбслуживание(ВыборкаДетальныеЗаписи.Ссылка);
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИзменитьЗначениеВФорме1СОтчетность(
			ВыборкаДетальныеЗаписи.Ссылка, 
			"ДатаНачала", 
			Свойства.ДатаНачала);
			
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИзменитьЗначениеВФорме1СОтчетность(
			ВыборкаДетальныеЗаписи.Ссылка, 
			"ДатаОкончания", 
			Свойства.ДатаОкончания);
			
	КонецЦикла;
	
КонецПроцедуры

#Область ПечатьПояснения

Функция ТаблицаКонтрагентовПояснения(Пояснение) Экспорт
	
	Таблица = Пояснение.Контрагенты.Выгрузить(, "ИНН, КПП");

	// Дополняем таблицу с ИНН значениями, указанными в колонках табличных частей
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПокупок, "ПосредникИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПокупок, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПокупокДл, "ПосредникИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПокупокДл, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПродаж, "ПосредникИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПродаж, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПродажДл, "ПосредникИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.КнигаПродажДл, "ПосредникИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаВыставленныхСчетовФактур, "ПокупательИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаВыставленныхСчетовФактур, "ПокупательИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "ПродавецИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "ПродавецИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "СубкомиссионерИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.ЖурналУчетаПолученныхСчетовФактур, "СубкомиссионерИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.ВыставленныеСчетаФактурыНеплательщиковНДС, "ПокупательИНН");
	ДобавитьКонтрагентов(Таблица, Пояснение.ВыставленныеСчетаФактурыНеплательщиковНДС, "ПокупательИННРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.НетКнигаПрод, "ПокупательИНН", "ПокупательКПП");
	ДобавитьКонтрагентов(Таблица, Пояснение.НетКнигаПрод, "ПокупательИННРасхождение", "ПокупательКППРасхождение");
	ДобавитьКонтрагентов(Таблица, Пояснение.НетКнигаПрод, "ПосредникИНН", "ПосредникКПП");
	ДобавитьКонтрагентов(Таблица, Пояснение.НетКнигаПрод, "ПосредникИННРасхождение", "ПосредникКППРасхождение");
	
	ТаблицаКонтрагентов = Документы.ПоясненияКДекларацииПоНДС.КонтрагентыПоСпискуИННиКПП(Таблица);
	
	Возврат ТаблицаКонтрагентов;
	
КонецФункции
	
Функция СведенияОКонтрагентахПояснения(Пояснение, ТаблицаКонтрагентов) Экспорт	
	
	СведенияОКонтрагентах = Пояснение.Контрагенты.Выгрузить();
	СведенияОКонтрагентах.Индексы.Добавить("ИдентификаторЗначения");
	СведенияОКонтрагентах.Колонки.Добавить("Контрагенты", Новый ОписаниеТипов("СписокЗначений"));
	СведенияОКонтрагентах.Колонки.Добавить("ПредставлениеКонтрагента", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СведениеОКонтрагенте ИЗ СведенияОКонтрагентах Цикл
		
		СведениеОКонтрагенте.Контрагенты = Новый СписокЗначений();
		
		ПредставленияКонтрагента = Новый Массив;
		Если ТаблицаКонтрагентов <> Неопределено Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("ИНН", СведениеОКонтрагенте.ИНН);
			
			Если ЗначениеЗаполнено(СведениеОКонтрагенте.КПП) Тогда
				Отбор.Вставить("КПП", СведениеОКонтрагенте.КПП);
			КонецЕсли;
			
			СтрокиКонтрагента = ТаблицаКонтрагентов.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаКонтрагента Из СтрокиКонтрагента Цикл
				СведениеОКонтрагенте.Контрагенты.Добавить(СтрокаКонтрагента.Контрагент);
				ПредставленияКонтрагента.Добавить(СтрокаКонтрагента.КонтрагентПредставление);
			КонецЦикла;
		КонецЕсли;
		
		СведениеОКонтрагенте.ПредставлениеКонтрагента = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеКонтрагента(
					СведениеОКонтрагенте, СтрСоединить(ПредставленияКонтрагента, ";"));
	КонецЦикла;
				
	Возврат СведенияОКонтрагентах;
				
КонецФункции

Процедура ДобавитьКонтрагентов(Таблица, ТаблицаДанных, ПолеИНН, ПолеКПП = "")
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицыДанных[ПолеИНН]) Тогда
			
			Строка = Таблица.Добавить();
			Если СтрНайти(СтрокаТаблицыДанных[ПолеИНН], "/") Тогда
				
				Части = СтрРазделить(СтрокаТаблицыДанных[ПолеИНН], "/");
				Строка.ИНН = Части[0];
				Строка.КПП = Части[1];
				
			Иначе
				
				Строка.ИНН = СтрокаТаблицыДанных[ПолеИНН];
				
				Если ЗначениеЗаполнено(ПолеКПП) Тогда
					Строка.КПП = СтрокаТаблицыДанных[ПолеКПП];
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
				
Процедура ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокаПосредническойДеятельности, ТабДокумент)
	
	СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
	СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
	СтрокаТабДока.Параметры.Заполнить(СтрокаПосредническойДеятельности);
	ТабДокумент.Вывести(СтрокаТабДока);
	
КонецПроцедуры

Процедура ВывестиСтрокуЖурналаРасхождение(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, НомерСтрокиРасхождение, СтрокиПосредническойДеятельности, ТабДокумент)
	
	СтрокаПосредническойДеятельностиРасхождение = СтрокиПосредническойДеятельностиРасхождение[НомерСтрокиРасхождение];
	
	СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
	СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
	СтрокаТабДока.Параметры.Заполнить(СтрокаПосредническойДеятельностиРасхождение);
	
	Колонки = Новый Массив;
	Колонки.Добавить("ДатаСчетаФактуры");
	Колонки.Добавить("КодВалюты");
	Колонки.Добавить("НомерСчетаФактуры");
	Колонки.Добавить("ПродавецИНН");
	Колонки.Добавить("РазницаСтоимостиУвеличение");
	Колонки.Добавить("РазницаСтоимостиУменьшение");
	Колонки.Добавить("РазницаСуммыНДСУвеличение");
	Колонки.Добавить("РазницаСуммыНДСУменьшение");
	Колонки.Добавить("Стоимость");
	Колонки.Добавить("СуммаНДС");
	
	ЕстьСовпадение = Ложь;
	Для НомерСтроки = 0 По СтрокиПосредническойДеятельности.Количество() - 1 Цикл
		
		ВсеКолонкиСовпадают = Истина;
		Для каждого Колонка Из Колонки Цикл
			Если СтрокаПосредническойДеятельностиРасхождение[Колонка] <> СтрокиПосредническойДеятельности[НомерСтроки][Колонка] Тогда 
				ВсеКолонкиСовпадают = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		
		Если ВсеКолонкиСовпадают И НомерСтрокиРасхождение = НомерСтроки Тогда
			ЕстьСовпадение = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьСовпадение Тогда
		СтрокаТабДока.Области[ИмяОбласти + "__ПосредническаяДеятельность"].Шрифт = Новый Шрифт(,,Истина);
	КонецЕсли;
	
	ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти);
	
	ТабДокумент.Вывести(СтрокаТабДока);
	
КонецПроцедуры

Процедура ВывестиСтрокиПосредническойДеятельностиРасхождение(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк)
	
	Если СтрокиПосредническойДеятельностиРасхождение.Количество() = 1 Тогда
		// Одна строка расхожений
		ВывестиСтрокуЖурналаРасхождение(Бланк, "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Один", СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, 0, СтрокиПосредническойДеятельности, ТабДокумент);
	Иначе
		// Много строк расхожений
		Для Номер = 0 По СтрокиПосредническойДеятельностиРасхождение.Количество() - 1 Цикл
		
			Если Номер = 0 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Начало";
			ИначеЕсли Номер = СтрокиПосредническойДеятельностиРасхождение.Количество() - 1 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Конец";
			Иначе
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_Расхождения_Много_Середина";
			КонецЕсли;
			
			ВывестиСтрокуЖурналаРасхождение(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельностиРасхождение, Номер, СтрокиПосредническойДеятельности, ТабДокумент);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокиПосредническойДеятельности(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк)
	
	Если СтрокиПосредническойДеятельности.Количество() = 1 Тогда
		
		Если СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
			ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Один_Расхождения_Начало";
		Иначе
			ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_1_0";
		КонецЕсли;
		
		ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельности[0], ТабДокумент);
		
	Иначе
		Для Номер = 0 По СтрокиПосредническойДеятельности.Количество() - 1 Цикл
			
			Если Номер = 0 Тогда
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Начало";
			ИначеЕсли Номер = СтрокиПосредническойДеятельности.Количество() - 1 Тогда
				Если СтрокаТЧ.РезультатПроверки = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения Тогда
					ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Расхождения_Конец";
				Иначе
					ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Конец";
				КонецЕсли;
			Иначе
				ИмяОбласти = "СтрокаЖурналУчетаВыставленныхСчетовФактур_ФНС_Много_Середина";
			КонецЕсли;
			
			ВывестиСтрокуЖурнала(Бланк, ИмяОбласти, СтрокаТЧ, СтрокиПосредническойДеятельности[Номер], ТабДокумент);
			
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Функция ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТаблицы, ПолеИНН, ТаблицаКонтрагентов, ПолеКПП = "")
	
	СведенияОКонтрагенте = Новый Структура("ИНН, КПП");
	СведенияОКонтрагенте.ИНН = СтрокаТаблицы[ПолеИНН];
	
	Если ЗначениеЗаполнено(ПолеКПП) Тогда
		
		СведенияОКонтрагенте.КПП = СтрокаТаблицы[ПолеКПП];
		
		Сведения = Документы.ПоясненияКДекларацииПоНДС.СведенияОКонтрагентеПоТаблицеКонтрагентов(
			СведенияОКонтрагенте.ИНН, 
			ТаблицаКонтрагентов, 
			СведенияОКонтрагенте.КПП);
		
		Контрагенты = Сведения.Контрагенты;
		
	Иначе
			
		Сведения = Документы.ПоясненияКДекларацииПоНДС.СведенияОКонтрагентеПоТаблицеКонтрагентов(
			СведенияОКонтрагенте.ИНН, 
			ТаблицаКонтрагентов);
			
		Контрагенты = Сведения.Контрагенты;
		
	КонецЕсли;
	
	Представление = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеПоСпискуСтрок(Контрагенты);
	Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеКонтрагента(СведенияОКонтрагенте, Представление);
	Возврат Представление;
	
КонецФункции

Процедура ДополнитьПояснениеПредставлениямиПолей(Пояснение, ВыбранныеСтроки)
	
	ВТребованииЕстьXMLФайл = ЕстьТребованияКРазделам8_12(Пояснение.Требование);
	ДанныеТребования       = Справочники.ДокументыРеализацииПолномочийНалоговыхОрганов.ДанныеТребованияОПредставленииПоясненийКДекларацииНДС(Пояснение.Требование);
	
	Если ВТребованииЕстьXMLФайл Тогда
		ВерсияФоматаТребования = ДанныеТребования.ВерсФорм;
	КонецЕсли;
	
	// Добавляем представление в документы оплаты
	ДокументыОплаты = Пояснение.ДокументыОплаты.Выгрузить();
	ДокументыОплаты.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Для каждого ДокументОплаты Из ДокументыОплаты Цикл
		ДокументОплаты.Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеДокументаОплаты(ДокументОплаты);
	КонецЦикла; 
	
	// Добавляем представление в даты принятия на учет
	ДатыПринятияНаУчет = Пояснение.ДатыПринятияНаУчет.Выгрузить();
	ДатыПринятияНаУчет.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Для каждого ДатаПринятияНаУчет Из ДатыПринятияНаУчет Цикл
		ДатаПринятияНаУчет.Представление = Документы.ПоясненияКДекларацииПоНДС.ПредставлениеДатыПринятияНаУчет(ДатаПринятияНаУчет);
	КонецЦикла;
	
	// СведенияОКонтрагентах
	ТаблицаКонтрагентов = ТаблицаКонтрагентовПояснения(Пояснение);
	СведенияОКонтрагентах = СведенияОКонтрагентахПояснения(Пояснение, ТаблицаКонтрагентов);
	СведенияОКонтрагентах.Колонки.ПредставлениеКонтрагента.Имя = "Представление";
		
	// Помещаем недостающие реквизиты в таблицу
	Для каждого ДанныеПоРазделу Из ВыбранныеСтроки Цикл
		
		Имя    = ДанныеПоРазделу.Ключ;
		Строки = ДанныеПоРазделу.Значение;
		
		Если Имя = "СведКС" ИЛИ Имя = "ПояснИнОсн" Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТЧ Из Строки Цикл
			
			
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела8(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПродавецПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.Продавец, СведенияОКонтрагентах));
				СтрокаТЧ.Вставить("ПродавецРасхождениеПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ПродавецРасхождение, СведенияОКонтрагентах));
				
				СтрокаТЧ.Вставить("ПосредникИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПосредникИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "КнигаПродаж" ИЛИ Имя = "КнигаПродажДл" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела9(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки, ВерсияФоматаТребования));
				
				СтрокаТЧ.Вставить("ПокупательПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.Покупатель, СведенияОКонтрагентах));
				СтрокаТЧ.Вставить("ПокупательРасхождениеПредставление", ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ПокупательРасхождение, СведенияОКонтрагентах));

				СтрокаТЧ.Вставить("ПосредникИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПосредникИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПосредникИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "ЖурналУчетаВыставленныхСчетовФактур" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела10(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПокупательИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПокупательИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИННРасхождение", ТаблицаКонтрагентов));

			КонецЕсли;

			Если Имя = "ЖурналУчетаПолученныхСчетовФактур" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела11(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПродавецИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПродавецИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПродавецИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПродавецИННРасхождение", ТаблицаКонтрагентов));
				
				СтрокаТЧ.Вставить("СубкомиссионерИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "СубкомиссионерИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("СубкомиссионерИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "СубкомиссионерИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя = "ВыставленныеСчетаФактурыНеплательщиковНДС" Тогда
				
				СтрокаТЧ.Вставить("ОшибкаПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеОшибкиРаздела12(СтрокаТЧ.КодОшибки, СтрокаТЧ.ГрафаОшибки));
				
				СтрокаТЧ.Вставить("ПокупательИННПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИНН", ТаблицаКонтрагентов));
				СтрокаТЧ.Вставить("ПокупательИННРасхождениеПредставление", ПредставлениеКонтрагентовПоясненияПоИННиКПП(СтрокаТЧ, "ПокупательИННРасхождение", ТаблицаКонтрагентов));
				
			КонецЕсли;

			Если Имя <> "НетКнигаПрод" Тогда
				СтрокаТЧ.Вставить("ПериодОтраженияЗаписиПредставление", Документы.ПоясненияКДекларацииПоНДС.ПредставлениеПериодаОтраженияЗаписи(СтрокаТЧ));
			КонецЕсли;
			
			// Представление СФ
			Если Имя <> "ВыставленныеСчетаФактурыНеплательщиковНДС" И Имя <> "НетКнигаПрод" Тогда
				
				РеквизитыСчетаФактуры = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеСчетаФактурыПояснения(СтрокаТЧ, "");
			    СтрокаТЧ.Вставить("РеквизитыСчетаФактуры", РеквизитыСчетаФактуры);
				
				РеквизитыСчетаФактурыРасхождение = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеСчетаФактурыПояснения(СтрокаТЧ, "Расхождение");
				СтрокаТЧ.Вставить("РеквизитыСчетаФактурыРасхождение", РеквизитыСчетаФактурыРасхождение);
				
			КонецЕсли;
			
			// Док. оплаты
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" ИЛИ Имя = "КнигаПродаж" ИЛИ Имя = "КнигаПродажДл" Тогда
				
				ДокументОплатыПредставление = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДокументОплаты, ДокументыОплаты);
				ДокументОплатыРасхождениеПредставление = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДокументОплатыРасхождение, ДокументыОплаты);
				
				СтрокаТЧ.Вставить("ДокументОплатыПредставление", ДокументОплатыПредставление);
				СтрокаТЧ.Вставить("ДокументОплатыРасхождениеПредставление", ДокументОплатыРасхождениеПредставление);
				
			КонецЕсли;
			
			// ДатаПринятияНаУчет
			Если Имя = "КнигаПокупок" ИЛИ Имя = "КнигаПокупокДл" Тогда
				ДатаПринятияНаУчет = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДатаПринятияНаУчет, ДатыПринятияНаУчет);
				ДатаПринятияНаУчетРасхождение = ПредставлениеМножественногоЗначенияПояснения(СтрокаТЧ.ДатаПринятияНаУчетРасхождение, ДатыПринятияНаУчет);
				
				СтрокаТЧ.Вставить("ДатаПринятияНаУчетДата", ДатаПринятияНаУчет);
				СтрокаТЧ.Вставить("ДатаПринятияНаУчетРасхождениеДата", ДатаПринятияНаУчетРасхождение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеМножественногоЗначенияПояснения(ИдентификаторЗначения, Таблица)
	
	Отбор = Новый Структура();
	Отбор.Вставить("ИдентификаторЗначения", ИдентификаторЗначения);
	СписокСтрок = Таблица.НайтиСтроки(Отбор);
	Представление = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ПредставлениеПоСпискуСтрок(СписокСтрок);
	
	Возврат Представление;
	
КонецФункции	

Функция ТабличныйДокументПояснения(Пояснение, ВыбранныеСтроки, ЭтоПечатьИзОткрытогоПояснения) Экспорт
	
	Если НЕ ЭтоПечатьИзОткрытогоПояснения Тогда
		ДополнитьПояснениеПредставлениямиПолей(Пояснение, ВыбранныеСтроки);
	КонецЕсли;
	
	КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ТабДокумент       = Новый ТабличныйДокумент;
	
	// Шапка
	Бланк = КонтекстЭДОСервер.ПолучитьМакет("ПояснениеПоНДС");
	Шапка = Бланк.ПолучитьОбласть("Шапка");
	Шапка.Параметры["Наименование"] = Строка(Пояснение);
	ТабДокумент.Вывести(Шапка);
	
	СведенияВерны       = Перечисления.РезультатПроверкиСтрокиДекларации.СведенияВерны;
	ВыявленыРасхождения = Перечисления.РезультатПроверкиСтрокиДекларации.ВыявленыРасхождения;
	
	Для каждого ДанныеПоРазделу Из ВыбранныеСтроки Цикл
		
		Имя = ДанныеПоРазделу.Ключ;
		
		Если Имя = "ПояснИнОсн" Тогда
			
			Если ЗначениеЗаполнено(Пояснение.ПояснИнОсн) Тогда
				ОбластьПояснИнОсн = Бланк.ПолучитьОбласть("ПояснИнОсн");
				ОбластьПояснИнОсн.Параметры.ПояснИнОсн = Пояснение.ПояснИнОсн;
				ТабДокумент.Вывести(ОбластьПояснИнОсн);
			КонецЕсли;
			
		Иначе
		
			Строки = ДанныеПоРазделу.Значение;
			
			Если Строки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Прав(Имя, 2) = "Дл" Тогда
				ИмяБезДл = Сред(Имя, 0, СтрДлина(Имя) - 2);
			Иначе
				ИмяБезДл = Имя;
			КонецЕсли;
			
			// Шапка ТЧ
			ЗаголовокТЧ = Бланк.ПолучитьОбласть("Заголовок" + Имя);
			ТабДокумент.Вывести(ЗаголовокТЧ);

			ШапкаТЧ = Бланк.ПолучитьОбласть("Шапка" + ИмяБезДл);
			
			ТабДокумент.Вывести(ШапкаТЧ);
			
			// Строка ТЧ
			Для каждого СтрокаТЧ Из Строки Цикл
				
				Если ИмяБезДл = "ЖурналУчетаВыставленныхСчетовФактур" Тогда
					
					Отбор = Новый Структура();
					Отбор.Вставить("ИдентификаторЗначения", СтрокаТЧ.ПосредническаяДеятельность);
					СтрокиПосредническойДеятельности = Пояснение.ПосредническаяДеятельность.НайтиСтроки(Отбор);
					
					Отбор = Новый Структура();
					Отбор.Вставить("ИдентификаторЗначения", СтрокаТЧ.ПосредническаяДеятельностьРасхождение);
					СтрокиПосредническойДеятельностиРасхождение = Пояснение.ПосредническаяДеятельность.НайтиСтроки(Отбор);
					
					ВывестиСтрокиПосредническойДеятельности(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк);
					
					Если СтрокаТЧ.РезультатПроверки = ВыявленыРасхождения Тогда
						ВывестиСтрокиПосредническойДеятельностиРасхождение(СтрокиПосредническойДеятельности, СтрокиПосредническойДеятельностиРасхождение, СтрокаТЧ, ТабДокумент, Бланк);
					КонецЕсли;
					
				Иначе
					
					
					Если ИмяБезДл <> "СведКС" И СтрокаТЧ.РезультатПроверки = ВыявленыРасхождения Тогда
						ИмяОбласти = "Строка" + ИмяБезДл + "СРасхождением";
					Иначе
						ИмяОбласти = "Строка" + ИмяБезДл;
					КонецЕсли;
					СтрокаТабДока = Бланк.ПолучитьОбласть(ИмяОбласти);
					
					СтрокаТабДока.Параметры.Заполнить(СтрокаТЧ);
					
					Если ИмяБезДл = "НетКнигаПрод" Тогда
						Если СтрокаТЧ.РезультатПроверки = СведенияВерны Тогда
							СтрокаТабДока.Параметры.РезультатПроверки = НСтр("ru = 'Не подтверждается';
																			|en = 'Is not confirmed'");
						ИначеЕсли СтрокаТЧ.РезультатПроверки = ВыявленыРасхождения Тогда
							СтрокаТабДока.Параметры.РезультатПроверки = НСтр("ru = 'Выявлены расхождения';
																			|en = 'Discrepancies are found'");
						КонецЕсли;
					КонецЕсли;
					
					ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти);
					
					ТабДокумент.Вывести(СтрокаТабДока);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ДобавитьШтампПодписиПодДокументом(Пояснение, Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП, ТабДокумент, 3);
	
	Возврат ТабДокумент; 
	
КонецФункции

Процедура ВыделитьРасхождениеВСтрокеПояснения(СтрокаТабДока, СтрокаТЧ, ИмяОбласти)
	
	Для каждого ОбластьТабДока Из СтрокаТабДока.Области Цикл
		
		Имя = ОбластьТабДока.Имя;
		Позиция = СтрНайти(Имя, "__");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПараметраРасхождения = Сред(ОбластьТабДока.Имя, Позиция + 2);
		ИмяПараметра = СтрЗаменить(ИмяПараметраРасхождения, "Расхождение", "");
		
		Попытка
			Если СтрокаТЧ[ИмяПараметра] <> СтрокаТЧ[ИмяПараметраРасхождения] Тогда
				СтрокаТабДока.Области[ИмяОбласти + "__" + ИмяПараметраРасхождения].Шрифт = Новый Шрифт(,,Истина);
			КонецЕсли;
		Исключение
			// Не нужна специальная обработка - нет такого параметра или области
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

#КонецОбласти

#Область ПечатьШтампаЭП

Процедура ДобавитьШтампПодписиВРезультатЗапросаИОН(ЗапросИОН, ТабДок, ПодписейВСтроке = 2, ВыводитьПустоеПространство = Истина) Экспорт
	
	ДобавитьШтампПодписиПодДокументом(
		ЗапросИОН,
		Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО,
		ТабДок,
		ПодписейВСтроке,
		ВыводитьПустоеПространство);
		
КонецПроцедуры
	
Процедура ДобавитьШтампПодписиПодДокументом(Ссылка, ТипСообщения, ТабДок, ПодписейВСтроке = 2, ВыводитьПустоеПространство = Истина) Экспорт

	Если ТипЗнч(ТипСообщения) <> Тип("Массив") Тогда
		ТипыСообщений = Новый Массив;
		ТипыСообщений.Добавить(ТипСообщения);
	Иначе
		ТипыСообщений = ТипСообщения;
	КонецЕсли;
	
	Подписи = ПодписиПодСообщениями(Ссылка, ТипСообщения);
	
	СвойстваПодписей = Новый Массив;
	
	Для каждого Подпись Из Подписи Цикл
	
		Свойства = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СвойстваПодписиДляШтампа();
		Если НЕ Подпись.ВАрхиве Тогда
			
			Если Подпись.Данные.Получить() = Неопределено Тогда
				
				МассивФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
					Подпись.ТранспортноеСообщение,
					"ТранспортноеСообщениеПрисоединенныеФайлы",
					Подпись.ИмяФайла);
					
				Если МассивФайлов.Количество() > 0 Тогда
					Свойства.ДвДанные = РаботаСФайлами.ДвоичныеДанныеФайла(МассивФайлов[0]);
				КонецЕсли;
				
			Иначе
				Свойства.ДвДанные = Подпись.Данные.Получить();
			КонецЕсли;
			
			СвойстваПодписей.Добавить(Свойства);
			
			ЗаполнитьСвойстваПодписиДляШтампа(
				Подпись.ТранспортноеСообщение, 
				Подпись.ЭЦПЭтоПодписьАбонента, 
				Свойства);
				
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьШтампПодписи(СвойстваПодписей, ТабДок, ПодписейВСтроке, ВыводитьПустоеПространство);
	
КонецПроцедуры

Функция ПодписиПодСообщениями(Ссылка, ТипСообщения) Экспорт

	Если ТипЗнч(ТипСообщения) <> Тип("Массив") Тогда
		ТипыСообщений = Новый Массив;
		ТипыСообщений.Добавить(ТипСообщения);
	Иначе
		ТипыСообщений = ТипСообщения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ

		|	ЦиклыОбмена.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ЦиклыПредмета
		|ИЗ
		|	Справочник.ЦиклыОбмена КАК ЦиклыОбмена
		|ГДЕ
		|	ЦиклыОбмена.Предмет = &Предмет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СодержимоеТранспортныхКонтейнеров.Данные КАК Данные,
		|	СодержимоеТранспортныхКонтейнеров.ИмяФайла КАК ИмяФайла,
		|	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла КАК ЭЦПИмяПодписанногоФайла,
		|	СодержимоеТранспортныхКонтейнеров.ЭЦПСертификат КАК ЭЦПСертификат,
		|	ТрСообщение.Ссылка КАК ТранспортноеСообщение,
		|	ВЫБОР
		|		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		КОГДА СостояниеОбъектов.Архивный = ЛОЖЬ
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ВАрхиве,
		|	ВЫБОР
		|		КОГДА ТрСообщение.ЦиклОбмена.ФорматДокументооборота = &ЭДОК
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.Отправитель) = ТИП(Справочник.Организации)
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		ИНАЧЕ СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента
		|	КОНЕЦ КАК ЭЦПЭтоПодписьАбонента
		|ИЗ
		|	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортноеСообщение КАК ТрСообщение
		|		ПО СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = ТрСообщение.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
		|		ПО (СостояниеОбъектов.Объект = ТрСообщение.Ссылка)
		|			И (СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
		|			И (СостояниеОбъектов.Владелец = ЗНАЧЕНИЕ(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
		|ГДЕ
		|	(СодержимоеТранспортныхКонтейнеров.Тип = &ЭЦП
		|				И ТрСообщение.ЦиклОбмена.ФорматДокументооборота <> &ЭДОК
		|			ИЛИ СодержимоеТранспортныхКонтейнеров.Тип <> &Сертификат
		|				И ТрСообщение.ЦиклОбмена.ФорматДокументооборота = &ЭДОК)
		|	И ТрСообщение.Тип В(&ТипыСообщений)
		|	И ТрСообщение.ЦиклОбмена В
		|			(ВЫБРАТЬ
		|				ЦиклыПредмета.Ссылка
		|			ИЗ
		|				ЦиклыПредмета)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение.ДатаТранспорта";

	
	Запрос.УстановитьПараметр("ЭЦП", 		        Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	Запрос.УстановитьПараметр("Сертификат", 		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Сертификат);
	Запрос.УстановитьПараметр("ТипыСообщений",      ТипыСообщений);
	Запрос.УстановитьПараметр("ЭДОК", 				Перечисления.ФорматыДокументооборотаСПФР.ЭДОК);
	Запрос.УстановитьПараметр("Предмет", 	        Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Подписи = РезультатЗапроса.Выгрузить();
	
	Возврат Подписи;
	
КонецФункции

Процедура ЗаполнитьСвойстваПодписиДляШтампа(ТранспортноеСообщение, ЭЦПЭтоПодписьАбонента, СвойстваПодписи) Экспорт 
	
	СвойстваПодписи.ТранспортноеСообщение = ТранспортноеСообщение;
	
	// Взято из процедуры ОформитьСтрокуСодержимого формы ФормаДокумента документа ТранспортноеСообщение
	Если ЭЦПЭтоПодписьАбонента Тогда
		СвойстваПодписи.ЭтоАбонент  = Истина;
	ИначеЕсли ТранспортноеСообщение.ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР Тогда
		СвойстваПодписи.ЭтоПФР = Истина;
	Иначе
		Если (ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДекларацияНО
		ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗаявлениеНО
		ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеОбращениеНО
		ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПредставлениеНО
		ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеФорма2НДФЛНО
		ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС)
		И НЕ ТранспортноеСообщение.УчетнаяЗапись.ОбменНапрямую Тогда
			СвойстваПодписи.ЭтоСерверДО = Истина;
		Иначе
			Если ТранспортноеСообщение.ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСФСГС
			 ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС
			 ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС
			 ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоИсходящееФСГС Тогда
				СвойстваПодписи.ЭтоФСГС = Истина;
			Иначе
				СвойстваПодписи.ЭтоФНС = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры

Функция ДатаПодписания(ДвДанныеПодписи) Экспорт
	
	ВремяПодписания = Неопределено;
	
	Попытка
		СвойстваПодписи = КриптографияЭДКОСлужебныйВызовСервера.ПолучитьСвойстваКриптосообщения(ДвДанныеПодписи);
	Исключение
		Возврат ВремяПодписания;
	КонецПопытки;
	
	Если СвойстваПодписи = Неопределено Тогда
		Возврат ВремяПодписания;
	КонецЕсли;
	
	Если НЕ СвойстваПодписи.Свойство("Подписанты") Тогда
		Возврат ВремяПодписания;
	КонецЕсли;
	
	Для каждого Подписант Из СвойстваПодписи.Подписанты Цикл
		
		Если НЕ Подписант.Сертификат.Свойство("Сертификат") Тогда
			Возврат ВремяПодписания;
		КонецЕсли;
		
		Если Подписант.Свойство("ПодписанныеАтрибуты") И Подписант.ПодписанныеАтрибуты.Свойство("ВремяПодписания") Тогда
			
			ВремяПодписания = Подписант.ПодписанныеАтрибуты.ВремяПодписания;
			ВремяПодписания = МестноеВремя(ВремяПодписания);
		
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат ВремяПодписания;
	
КонецФункции

// Процедура - Добавить штамп подписи
//
// Параметры:
//  Подписи						 - Массив - Массив двоичных данных файлов подписи
//  ТабДок						 - ТабличныйДокумент - табличный документ, в конец которого будут добавлены штампы ЭП.
//  ПодписейВСтроке				 - Число - Сколько штампов помещать на одной строке, после чего переносить на другую строку
//  ВыводитьПустоеПространство	 - Булево - Если Истина, то при отсуствии подписей выводит пустую область такого же размера
//
Процедура ДобавитьШтампПодписи(СвойстваПодписей, ТабДок, Знач ПодписейВСтроке = 2, ВыводитьПустоеПространство = Истина) Экспорт

	Штампы = Новый Массив;
	Сертификаты = Новый Массив;
	Для каждого СтрокаСвойстваПодписи Из СвойстваПодписей Цикл
		
		ОтправляетсяПоЭДОК = ОтчетОтправляетсяПоЭДОК(СтрокаСвойстваПодписи.ТранспортноеСообщение.ЦиклОбмена);
		
		Если ОтправляетсяПоЭДОК Тогда
			СвойстваПодписи = СвойстваПодписиСообщенияПоЭДОК(СтрокаСвойстваПодписи);
		Иначе
			Попытка
				СвойстваПодписи = КриптографияЭДКОСлужебныйВызовСервера.ПолучитьСвойстваКриптосообщения(СтрокаСвойстваПодписи.ДвДанные);
			Исключение
				СвойстваПодписи = Неопределено;
			КонецПопытки;
		КонецЕсли;
		
		Если СвойстваПодписи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ СвойстваПодписи.Свойство("Подписанты") Тогда
			Продолжить;
		КонецЕсли;
		
		Картинка = КартинкаШтампа(СтрокаСвойстваПодписи);
		
		Для каждого Подписант Из СвойстваПодписи.Подписанты Цикл
			
			Если НЕ Подписант.Сертификат.Свойство("Сертификат") Тогда
				Продолжить;
			КонецЕсли;
			
			ДвДанныеСертификат = Подписант.Сертификат.Сертификат; 
			Сертификат = Новый СертификатКриптографии(ДвДанныеСертификат);
			
			// Исключаем повторение сертификатов в печатной форме
			Если Сертификаты.Найти(Сертификат) = Неопределено Тогда
				Сертификаты.Добавить(Сертификат);
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если Подписант.Свойство("ПодписанныеАтрибуты") И Подписант.ПодписанныеАтрибуты.Свойство("ВремяПодписания") Тогда
				
				ВремяПодписания = Подписант.ПодписанныеАтрибуты.ВремяПодписания;
				
				Если СтрокаСвойстваПодписи.ЭтоСерверДО Тогда
					ВремяПодписания = МестноеВремя(ВремяПодписания, "GMT+3");
				Иначе
					ВремяПодписания = МестноеВремя(ВремяПодписания);
				КонецЕсли;
			
				Штамп = ШтампВизуализацииЭлектроннойПодписи(Сертификат,ВремяПодписания,,Картинка);
			Иначе
				Штамп = ШтампВизуализацииЭлектроннойПодписи(Сертификат,,,Картинка);
			КонецЕсли;
			Штампы.Добавить(Штамп);
		
		КонецЦикла; 
	
	КонецЦикла; 
	
	ПачкаШтампов = Новый Массив;
	КоличествоПодписей = Штампы.Количество();
	ПодписейВСтроке = Мин(ПодписейВСтроке,3);
	
	ШиринаПервойКолонки = ТабДок.Область(ТабДок.ВысотаСтраницы, 1, ТабДок.ВысотаСтраницы, 1).ШиринаКолонки;
	
	Если ВыводитьПустоеПространство И КоличествоПодписей = 0 Тогда
		
		ТабДокШтампов = ПолучитьМакетОбработки("ШтампыЭП");
		ТабДок.Вывести(ТабДокШтампов);
	Иначе
		
		Для НомерШтампа = 1 По КоличествоПодписей Цикл
		
			ПачкаШтампов.Добавить(Штампы[НомерШтампа - 1]);
			
			ЭтоПоследнийВСтроке = Цел(НомерШтампа/ПодписейВСтроке) = НомерШтампа/ПодписейВСтроке;
			ЭтоСамыйПоследний = НомерШтампа = КоличествоПодписей;
			
			// В строку выводим максимум столько подписей, сколько указано в параметре
			// Если подписей больше, выводим на следующей строке
			Если ЭтоПоследнийВСтроке ИЛИ ЭтоСамыйПоследний Тогда
				
				ТабДокШтампов = ПолучитьМакетОбработки("ШтампыЭП");
				ТабДокШтампов.Области.Отступ.ШиринаКолонки = ШиринаПервойКолонки;
				
				ЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент(ТабДокШтампов, ПачкаШтампов);
				ТабДок.Вывести(ТабДокШтампов);
				ПачкаШтампов = Новый Массив;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция КартинкаШтампа(СвойстваПодписи)
	
	Картинка = БиблиотекаКартинок.ЭлектроннаяПодписьСиняя;
	
	Если СвойстваПодписи.ЭтоАбонент ИЛИ СвойстваПодписи.ЭтоСерверДО Тогда
		Картинка  = БиблиотекаКартинок.ЭлектроннаяПодписьСиняя;
	ИначеЕсли СвойстваПодписи.ЭтоФНС Тогда
		Картинка  = БиблиотекаКартинок.ГербФНССиний;
	ИначеЕсли СвойстваПодписи.ЭтоПФР Тогда
		Картинка  = БиблиотекаКартинок.ГербПФРСиний;
	ИначеЕсли СвойстваПодписи.ЭтоФСГС Тогда
		Картинка  = БиблиотекаКартинок.ГербРосстатаСиний;
	КонецЕсли;
	
	Возврат Картинка;
	
КонецФункции

Функция ШтампВизуализацииЭлектроннойПодписи(Сертификат, ДатаПодписи = Неопределено, ТекстОтметки = "", ЛоготипОрганизации = Неопределено) Экспорт
	
	СертификатКриптографии = Сертификат;
	
	СвойстваСубъекта    = ЭлектроннаяПодпись.СвойстваСубъектаСертификата(СертификатКриптографии);
	СвойстваСертификата = ЭлектроннаяПодпись.СвойстваСертификата(СертификатКриптографии);
	ДатыСертификата     = ДатыСертификата(СертификатКриптографии);
	
	ПериодДействия = НСтр("ru = 'с %1 по %2';
							|en = 'from %1 to %2'");
	ПериодДействия = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПериодДействия,
		Формат(ДатыСертификата.ДатаНачала,    "ДЛФ=D"),
		Формат(ДатыСертификата.ДатаОкончания, "ДЛФ=D"));
	
	Штамп = ПолучитьМакетОбработки("Штамп");
	
	Штамп.Параметры.ДатаПодписи         = ДатаПодписи;
	Штамп.Параметры.НомерСертификата    = СертификатКриптографии.СерийныйНомер;
	Штамп.Параметры.ВладелецСертификата = СвойстваСертификата.КомуВыдан;
	Штамп.Параметры.СрокДействия        = ПериодДействия;
	Штамп.Параметры.ТекстОтметки        = ТекстОтметки;
	
	Если ЛоготипОрганизации <> Неопределено Тогда
		Штамп.Рисунки.Картинка.Картинка = ЛоготипОрганизации;
	КонецЕсли;
	
	Возврат Штамп;
	
КонецФункции

Функция ДатыСертификата(Сертификат) Экспорт
	
	ДобавкаВремени = ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата();
	
	ДатыСертификата = Новый Структура;
	ДатыСертификата.Вставить("ДатаНачала",    Сертификат.ДатаНачала    + ДобавкаВремени);
	ДатыСертификата.Вставить("ДатаОкончания", Сертификат.ДатаОкончания + ДобавкаВремени);
	
	Возврат ДатыСертификата;
	
КонецФункции

#КонецОбласти

#Область НоваяФормаРегламентированнойОтчетности

#Область ПолучениеТекущегоСостоянияОтправки

// Текущее состояние отправки
//
// Параметры:
//  Ссылка					 - ДокументСсылка, СправочникСсылка - ссылка на объект, отправляемый в контролирующие органы.
//  КонтролирующийОрган		 - Строка или Перечисление.ТипыКонтролирующихОрганов
//  ДополнительныеПараметры	 - Структура:
//		Если содержит поле "ПолучатьОшибкиОтправки", то в результате возращаются поля НеотправленныеИзвещения и ЕстьКритическиеОшибки.
//		Если содержит поле "ПоказыватьПомеченныеНаУдаление", то анализируеются даже помеченные на удаление отправки.
//		Если содержит поле "ПолучатьДаты", то возвращаются даты смены состояния, иначе возврадается пустая дата.
//		Если содержит поле "Отправка", то возвращается информация по этой отправке(циклу обмена или отправке), иначе по последней.
// 
// Возвращаемое значение:
//	Структура с полями:
//	ТекущийЭтапОтправки - структура с полями:
//		ТекстНадписи - Строка - текст, отображаемый в панели отправки объекта
//		ТекстСтатуса - Строка - текст, отображаемый в колонке Состояние таблиц формы Отчетность
//		Дата - Дата - Дата текущего этапа. Возращается, если ДополнительныеПараметры содержат поле "ПолучатьДаты".
//		КомментарийКСостоянию
//		НаименованиеПротокола
//		Протокол	 - Ссылка на транспортное сообщение или отправку или Неопределено.
//		СостояниеСдачиОтчетности - ПеречислениеСсылка.СостояниеСдачиОтчетности
//		ЭтапПройден - Булево
//	НеотправленныеИзвещения - Структура, поля перечислены ниже. 
//		Возращается, если ДополнительныеПараметры содержат поле "ПолучатьОшибкиОтправки".
//			МассивСообщенийНеИмеющихПодтверждений - Массив
//			МассивНеотправленныхПодтверждений - Массив
//			ЕстьНеотправленныеИзвещения - Булево
//	ЕстьКритическиеОшибки - Булево.
//		Возращается, если ДополнительныеПараметры содержат поле "ПолучатьОшибкиОтправки".
//В случае ошибки или отсуствия данных, возвращается значение Неопределено
Функция ТекущееСостояниеОтправки(Знач Ссылка, Знач КонтролирующийОрган = "ФНС", ДополнительныеПараметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ТекущееСостояние = Новый Структура;
		ТекущееСостояние.Вставить("ТекущийЭтапОтправки");
		ТекущееСостояние.Вставить("НеотправленныеИзвещения");
		ТекущееСостояние.Вставить("ЕстьКритическиеОшибки");
		ТекущееСостояние.Вставить("ТаблицаЭтаповОтправки");
		ТекущееСостояние.Вставить("КонтролирующийОрган", КонтролирующийОрган);
		
		// Преобразуем контролирующий орган к нужному виду
		КонтролирующийОрган = ТипКонтролирующегоОргана(КонтролирующийОрган);
		
		// Вся таблица этапов
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправки(Ссылка, КонтролирующийОрган, ДополнительныеПараметры);
		
		Если ТаблицаЭтаповОтправки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Текущий этап отправки (для прорисовки панели и определния статуса в списке отчетов)
		ТекущийЭтапОтправки = ТекущийЭтапОтправки(ТаблицаЭтаповОтправки);
		ТекущееСостояние.Вставить("ТекущийЭтапОтправки", ТекущийЭтапОтправки);
		
		ПолучатьОшибкиОтправки = ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
			И ДополнительныеПараметры.Свойство("ПолучатьОшибкиОтправки") 
			И ДополнительныеПараметры.ПолучатьОшибкиОтправки;
			
		Если ПолучатьОшибкиОтправки Тогда
			// Критические ошибки
			ТекущееСостояние.Вставить("ЕстьКритическиеОшибки", 
				ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЕстьКритическиеСообщения(Ссылка, ДополнительныеПараметры));
			
			// Неотправленные или несозданные подтверждения
			ТекущееСостояние.Вставить("НеотправленныеИзвещения", НеотправленныеИзвещения(Ссылка, КонтролирующийОрган, ДополнительныеПараметры));
		КонецЕсли;
		
		ВозвращатьТаблицуЭтаповОтправки = ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
			И ДополнительныеПараметры.Свойство("ВозвращатьТаблицуЭтаповОтправки") 
			И ДополнительныеПараметры.ВозвращатьТаблицуЭтаповОтправки;
			
		Если ВозвращатьТаблицуЭтаповОтправки Тогда
			ТекущееСостояние.Вставить("ТаблицаЭтаповОтправки", ТаблицаЭтаповОтправки);
		КонецЕсли;
		
		ВозвращатьДокументыРеализацииПолномочийНО = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ВозвращатьДокументыРеализацииПолномочийНО") 
			И ДополнительныеПараметры.ВозвращатьДокументыРеализацииПолномочийНО;
			
		Если ВозвращатьДокументыРеализацииПолномочийНО Тогда
			Если (КонтролирующийОрган = "ФНС" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФНС)
				И ТекущийЭтапОтправки <> Неопределено И ТекущийЭтапОтправки.Свойство("СостояниеСдачиОтчетности")
				И (ТекущийЭтапОтправки.СостояниеСдачиОтчетности =
				Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота
				ИЛИ ТекущийЭтапОтправки.СостояниеСдачиОтчетности =
				Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота) Тогда
			
				ДокументыРеализацииПолномочийНО = ИнтерфейсыВзаимодействияБРОВызовСервера.ДокументыРеализацииПолномочийНО(
					Ссылка, Истина);
			Иначе
				ДокументыРеализацииПолномочийНО = Новый Массив;
			КонецЕсли;
			ТекущееСостояние.Вставить("ДокументыРеализацииПолномочийНО", ДокументыРеализацииПолномочийНО);
		КонецЕсли;
		
		Если КонтролирующийОрган = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ФНС") Тогда
			ТаблицаЭтаповОтправкиРЭЦ = ТаблицаЭтаповОтправки(Ссылка, ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.РЭЦ"), ДополнительныеПараметры);	
			
			ТекущийЭтапОтправкиРЭЦ = ТекущийЭтапОтправки(ТаблицаЭтаповОтправкиРЭЦ);
			ТекущееСостояние.Вставить("ТекущийЭтапОтправкиРЭЦ", ТекущийЭтапОтправкиРЭЦ);
			
			Если ВозвращатьТаблицуЭтаповОтправки Тогда
				ТекущееСостояние.Вставить("ТаблицаЭтаповОтправкиРЭЦ", ТаблицаЭтаповОтправкиРЭЦ);
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
		ТекущееСостояние = Неопределено;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Получение текущего состояния отправки, критических ошибок и неотправленных извещений';
				|en = 'Receive the current sending state, critical errors and unsent notifications'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
	КонецПопытки;
		
	Возврат ТекущееСостояние;
		
КонецФункции

Функция ТекущийЭтапОтправки(ТаблицаЭтаповОтправки) Экспорт
	
	НомерЭтапа = ТаблицаЭтаповОтправки.Количество();
	
	// В таблице этапов определяем последний
	ТекущийЭтап = Неопределено;
	Пока НомерЭтапа >= 0 Цикл
		
		НомерЭтапа = НомерЭтапа - 1;
		
		ТекущийЭтап = ТаблицаЭтаповОтправки[НомерЭтапа];
		Если ТекущийЭтап.ЭтапПройден Тогда
			Прервать;
		Конецесли;
	
	КонецЦикла;
	
	// Строку таблицы значений последнего этапа преобразуем к структуре
	Если ТекущийЭтап <> Неопределено Тогда
		СтруктураТекущегоЭтапа = Новый Структура;
		Для каждого Колонка Из ТаблицаЭтаповОтправки.Колонки Цикл
			СтруктураТекущегоЭтапа.Вставить(Колонка.Имя, ТекущийЭтап[Колонка.Имя]);
		КонецЦикла;
		
		Возврат СтруктураТекущегоЭтапа;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция НеотправленныеИзвещения(Знач ОтчетСсылка, Знач КонтролирующийОрган, ДополнительныеПараметры = Неопределено)
	
	МассивСообщенийНеИмеющихПодтверждений = Новый Массив;
	МассивНеотправленныхПодтверждений = Новый Массив;
	
	Результат = Новый Структура;
	Результат.Вставить("МассивСообщенийНеИмеющихПодтверждений", МассивСообщенийНеИмеющихПодтверждений);
	Результат.Вставить("МассивНеотправленныхПодтверждений", 	МассивНеотправленныхПодтверждений);
	Результат.Вставить("ЕстьНеотправленныеИзвещения",			Ложь);
	
	Если НЕ (КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФНС
			ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ПФР
			ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФСГС) Тогда
			
		Возврат Результат;
			
	КонецЕсли;
	
	Если ОтчетСсылка <> Неопределено Тогда
		Ссылка = ОтчетСсылка.Ссылка;
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Результат;
		КонецЕсли;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(ОтчетСсылка);
	КонецЕсли;
	
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	Если ЗначениеЗаполнено(ЦиклОбмена) Тогда

		Сообщения = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление);
		
		// определяем соответствие между типами сообщений-оснований и сообщений-подтверждений на них
		ТипыОснованийИПодтверждений = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ТипыОснованийИПодтверждений(ЦиклОбмена);
		
		// перебираем соответствие подтверждений основаниям
		ОбменНапрямую = Неопределено;
		Для Каждого ТипОснованияИПодтверждения Из ТипыОснованийИПодтверждений Цикл
			
			ТипОснования = ТипОснованияИПодтверждения.Ключ;
			ТипПодтверждения = ТипОснованияИПодтверждения.Значение;
			
			// для каждого основания...
			СообщенияОснования = Сообщения.НайтиСтроки(Новый Структура("Тип", ТипОснования));
			Для Каждого СообщениеОснование Из СообщенияОснования Цикл
				
				// ... ищем подтверждение, и если не находим, то возвращаем Ложь
				СообщенияПодтверждения = Сообщения.НайтиСтроки(Новый Структура("Основание", СообщениеОснование.Ссылка));
				Если ТипОснования <> Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР И НЕ ЭтоРассылкаПФР(СообщениеОснование) Тогда
					Если СообщенияПодтверждения.Количество() = 0 Тогда
						МассивСообщенийНеИмеющихПодтверждений.Добавить(СообщениеОснование.Ссылка);
					Иначе
						// формируем массив неотправленных подтверждений
						Для каждого СообщениеПодтверждения Из СообщенияПодтверждения Цикл
							Если СообщениеПодтверждения.Статус <> Перечисления.СтатусыПисем.Отправленное 
								И СообщениеПодтверждения.Статус <> Перечисления.СтатусыПисем.Полученное Тогда
								МассивНеотправленныхПодтверждений.Добавить(СообщениеПодтверждения.Ссылка);
							КонецЕсли;
						КонецЦикла;  
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	Результат.Вставить("МассивСообщенийНеИмеющихПодтверждений", МассивСообщенийНеИмеющихПодтверждений);
	Результат.Вставить("МассивНеотправленныхПодтверждений", 	МассивНеотправленныхПодтверждений);
	Результат.Вставить("ЕстьНеотправленныеИзвещения", 			МассивСообщенийНеИмеющихПодтверждений.Количество() > 0 
																	ИЛИ МассивНеотправленныхПодтверждений.Количество() > 0);
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЭтаповОтправки(Знач Ссылка, Знач КонтролирующийОрган = "ФНС", ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяТипаСправочникаМашиночитаемыеДоверенности = "МашиночитаемыеДоверенности";
	
	// Преобразуем контролирующий орган к нужному виду
	ТипКонтролирующегоОргана = ТипКонтролирующегоОргана(КонтролирующийОрган);
	
	// Заявление абонента на подключение к 1С-Отчетности
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаявлениеАбонентаСпецоператораСвязи") Тогда
		
		 ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЗаявленияАбонентаСпецоператораСвязи(Ссылка);
	
	// Документ реализации полномочий
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДокументыРеализацииПолномочийНалоговыхОрганов") Тогда
		
		 ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиДокументаРеализацииПолномочийНалоговыхОрганов(Ссылка, ДополнительныеПараметры);
			
	// Переписка
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиПерепискиСКонтролирующимиОрганами(Ссылка, ДополнительныеПараметры);
				
	// Макеты ПД, Заявление о назначении пенсии
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.МакетыПенсионныхДел")
		ИЛИ ТипЗнч(Ссылка) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиМакетаПенсионногоДела(Ссылка, ДополнительныеПараметры);	
				
	// ЕГРЮЛ, ЕГРИП
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП(Ссылка, ДополнительныеПараметры);
				
	// Запрос ИОН
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЗапросаИОН(Ссылка, ДополнительныеПараметры);
		
	// Входящие описи
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ОписиВходящихДокументовИзНалоговыхОрганов") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиОписиВходящихДокументовВНалоговыеОрганы(Ссылка, ДополнительныеПараметры);
			
	// Ответы на требование
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ОписиИсходящихДокументовВНалоговыеОрганы")
		ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоясненияКДекларацииПоНДС") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиОтветовНаТребованияФНС(Ссылка, ДополнительныеПараметры);
			
	// Запрос ИОС
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеСтрахователя") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЗапросаНаИнформационноеОбслуживаниеСтрахователя(Ссылка, ДополнительныеПараметры);
		
	// Машиночитаемые доверенности (распределенный реестр)
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр") Тогда
		
		ТаблицаЭтаповОтправки =
			ТаблицаЭтаповОтправкиМашиночитаемойДоверенностиРаспределенногоРеестра(Ссылка, ДополнительныеПараметры);
		
	// Машиночитаемые доверенности (распределенный реестр)
	ИначеЕсли ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует()
		И ТипЗнч(Ссылка) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиМашиночитаемойДоверенности(Ссылка, ДополнительныеПараметры);
		
	// ФНС
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиФНС(Ссылка, ДополнительныеПараметры);
		
	// ПФР
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиПФР(Ссылка, ДополнительныеПараметры);
		
	// Росстат
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиРосстат(Ссылка, ДополнительныеПараметры);
		
	// Входящий документ СЭДО СФР (бывш. ФСС)
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ВходящийДокументСЭДОФСС") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиВходящийДокументСЭДОФСС(Ссылка, ДополнительныеПараметры);
			
	// Заявление на формирование справки о расчетах
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаявлениеНаФормированиеСправкиОРасчетах") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЗаявлениеНаФормированиеСправкиОРасчетах(Ссылка, ДополнительныеПараметры);
		
	// Ответ страхователя на требование о предоставлении документов в СФР (бывш. ФСС)
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтветСтрахователяНаТребованиеПроверкиФСС") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиОтветСтрахователяНаТребованиеПроверкиФСС(Ссылка, ДополнительныеПараметры);
		
	// Обращения СФР (типы сообщений 1000-1002 СЭДО).
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОбращениеСФРКСтрахователю")
		ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтветСтрахователяНаОбращениеСФР") Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиОбращенияСФР(Ссылка, ДополнительныеПараметры);
		
	// ФСС
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
	
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиФСС(Ссылка, ДополнительныеПараметры);

	// ФСРАР
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСРАР Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиФСРАР(Ссылка, ДополнительныеПараметры);
		
	// РПН
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.РПН Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиРПН(Ссылка, ДополнительныеПараметры);
		
	// ФТС
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиФТС(Ссылка, ДополнительныеПараметры);
		
	// Банк России
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.УдалитьБанкРоссии Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиБанкРоссии(Ссылка, ДополнительныеПараметры);
		
	// ЦБ РФ
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ЦБ Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиЦБ(Ссылка, ДополнительныеПараметры);
		
	// Минобороны
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.Минобороны Тогда
		
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиМинобороны(Ссылка, ДополнительныеПараметры);
		
	// РЭЦ
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.РЭЦ Тогда
	
		ТаблицаЭтаповОтправки = ТаблицаЭтаповОтправкиРЭЦ(Ссылка, ДополнительныеПараметры);
		
	// Регистрация ЮЛ
	ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ГосударственнаяРегистрацияВФНС")
		И (КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.РегистрацияЮЛФНС
		ИЛИ (ТипЗнч(Ссылка) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения")
		И ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЭтоУведомлениеОРегистрацииЮЛ(Ссылка.ВидУведомления))) Тогда
		
		МодульДокументооборотРегистрацияВФНС = ОбщегоНазначения.ОбщийМодуль("ДокументооборотРегистрацияВФНС");
		ТаблицаЭтаповОтправки = МодульДокументооборотРегистрацияВФНС.ТаблицаЭтаповОтправки(Ссылка, ДополнительныеПараметры);
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

#Область ФормированиеТаблицЭтаповОтправки

Функция ТаблицаЭтаповОтправкиЗаявленияАбонентаСпецоператораСвязи(Ссылка);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.Дата						= Ссылка.ДатаОтправкиЗаявления;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки';
													|en = 'Processing result is expected'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= Ссылка.Статус <> Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Подготовлено
												И ЗначениеЗаполнено(Ссылка.Статус);
												
	Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ПереиздатьСертификатЭДО, ПодключитьЭДО");

	ЕстьКомментарий = НЕ ПустаяСтрока(Ссылка.СтатусКомментарий);
	Если Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено Тогда
		
		Если Ссылка.СтатусКомментарий = "Просрочена отправка расписки" И Ссылка.НастройкаЗавершена Тогда
			Текст = НСтр("ru = 'Просрочена отправка расписки';
						|en = 'Notice of receipt sending is overdue'");
		ИначеЕсли Ссылка.НастройкаЗавершена Тогда
			Текст = НСтр("ru = 'Отклонено';
						|en = 'Rejected'");
		Иначе
			Текст = НСтр("ru = 'Отклонено, настройка не завершена';
						|en = 'Rejected, setting is not completed'");
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= Текст;
		СтрокаЭтапа.ТекстСтатуса				= Текст;
		СтрокаЭтапа.Дата						= Ссылка.ДатаПолученияОтвета;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и сформируйте заявление еще раз';
														|en = 'Correct errors and generate the application again'");
		СтрокаЭтапа.НаименованиеПротокола		= ?(ЕстьКомментарий, НСтр("ru = 'Протокол ошибок';
																			|en = 'Error log'"), "");
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли НЕ Ссылка.НастройкаЭДОЗавершена И ЗначениеЗаполнено(Ссылка.НастройкиЭДО)
		И Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено
		И Ссылка.НастройкаЗавершена
		И (Свойства.ПереиздатьСертификатЭДО ИЛИ Свойства.ПодключитьЭДО)Тогда
		
		Текст = НСтр("ru = 'Одобрено, настройка 1С-ЭДО не завершена';
					|en = 'Approved, 1C-EDI setup is not completed'");
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= Текст;
		СтрокаЭтапа.ТекстСтатуса				= Текст;
		СтрокаЭтапа.Дата						= Ссылка.ДатаПолученияОтвета;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = '       Для завершения настройки 1С-ЭДО нажмите кнопку ""Обновить""';
														|en = '       Click Refresh to complete the 1C-EDI configuration'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;

	Иначе
		
		ЭтапПройден = Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено;
		
		Если Ссылка.НастройкаЗавершена Тогда
			Текст = НСтр("ru = 'Одобрено';
						|en = 'Approved'");
		Иначе
			Текст = НСтр("ru = 'Одобрено, настройка не завершена';
						|en = 'Approved, setting is not completed'");
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= Текст;
		СтрокаЭтапа.ТекстСтатуса				= Текст;
		СтрокаЭтапа.Дата						= ?(ЭтапПройден, Ссылка.ДатаПолученияОтвета, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= ?(НЕ Ссылка.НастройкаЗавершена, НСтр("ru = '       Для завершения настройки нажмите кнопку ""Обновить""';
																						|en = '       Click ""Refresh"" button to complete the configuration'"), "");
		СтрокаЭтапа.НаименованиеПротокола		= ?(ЕстьКомментарий И Ссылка.НастройкаЗавершена, НСтр("ru = 'Протокол';
																										|en = 'Protocol'"), "");
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= ЭтапПройден;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;

КонецФункции

Функция ТаблицаЭтаповОтправкиОписиВходящихДокументовВНалоговыеОрганы(СсылкаНаОтчет, ДополнительныеПараметры)
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Получено';
													|en = 'Received'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Получено';
													|en = 'Received'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтправленоИзКонтролирующегоОргана;
	СтрокаЭтапа.ЭтапПройден					= Истина;

	Возврат ТаблицаЭтаповОтправки;

КонецФункции

Функция ТаблицаЭтаповОтправкиДокументаРеализацииПолномочийНалоговыхОрганов(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
		
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	// У описи не может быть пустого цикла обмена
	// получаем список сообщений
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	Опись = ДокументооборотСКОВызовСервера.ПолучитьОписьВходящихДокументовПоТребованию(СсылкаНаОтчет);
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрДокументНО 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДокументНО));
	СтрИзвещениеДокументНП 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип, Статус", Перечисления.ТипыТранспортныхСообщений.ИзвещениеДокументНП, Перечисления.СтатусыПисем.Отправленное));
	СтрРезультатПриемаДокументНП 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументНП));
	СтрИзвещениеРезультатПриемаНО 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНО));
	
	Если НеПолучатьДаты Тогда
		ДатаОтправкиИзФНС 	= Дата(1,1,1);
		ДатаОтказаВПриеме 	= Дата(1,1,1);
		ДатаПриемаОписиНами = Дата(1,1,1);
	Иначе
		Если ЗначениеЗаполнено(Опись) Тогда
			ДатаОтправкиИзФНС = Опись.ДатаОтправки;
		Иначе
			ДатаОтправкиИзФНС = СсылкаНаОтчет.ДатаДокумента;
		КонецЕсли;
		ДатаОтказаВПриеме 	= ?(СтрРезультатПриемаДокументНП.Количество() > 0, 	СтрРезультатПриемаДокументНП[0].ДатаТранспорта,	Дата(1,1,1));
		ДатаПриемаОписиНами = ?(СтрРезультатПриемаДокументНП.Количество() > 0, 	СтрРезультатПриемаДокументНП[0].Дата, 			Дата(1,1,1));
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено';
													|en = 'Sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено';
													|en = 'Sent'");
	СтрокаЭтапа.Дата						= ДатаОтправкиИзФНС;
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтправленоИзКонтролирующегоОргана;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	РезультатПриема = ТребованияФНС.РезультатПриема(СтрРезультатПриемаДокументНП);
	
	Если ЗначениеЗаполнено(РезультатПриема) Тогда

		Если РезультатПриема.Ссылка.ПротоколСОшибкой Тогда
	
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отказано в приеме';
															|en = 'Refused hiring'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отказано в приеме';
															|en = 'Refused hiring'");
			СтрокаЭтапа.Дата						= ДатаОтказаВПриеме;
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
															|en = 'Notification of refusal'");
			СтрокаЭтапа.КоличествоОтветов			= ТребованияФНС.КоличествоОтветовПредставление(СсылкаНаОтчет);
			СтрокаЭтапа.Протокол					= РезультатПриема.Ссылка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;

		Иначе
			
			ЭтоТребование = ТребованияФНСВызовСервера.ЭтоТребованиеФНС(СсылкаНаОтчет);
			
			Если ЭтоТребование Тогда
				ТекстНадписи = НСтр("ru = 'Прием подтвержден';
									|en = 'Receipt is confirmed'");
			Иначе
				ТекстНадписи = НСтр("ru = 'Получено';
									|en = 'Received'");
			КонецЕсли;
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ТекстНадписи;
			СтрокаЭтапа.ТекстСтатуса				= ТекстНадписи;
			СтрокаЭтапа.Дата						= ДатаПриемаОписиНами;
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о приеме';
															|en = 'Notice of acceptance'");
			СтрокаЭтапа.КоличествоОтветов			= ТребованияФНС.КоличествоОтветовПредставление(СсылкаНаОтчет);
			СтрокаЭтапа.Протокол					= РезультатПриема.Ссылка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПриемПодтвержден;
			СтрокаЭтапа.ЭтапПройден					= Истина;
			
		КонецЕсли;
	Иначе
		
		ЭДООбязателен    = ТребованияФНСВызовСервера.ЭДООбязателенПоСсылке(СсылкаНаОтчет);
		ОтветилиНаВопрос = ТребованияФНСВызовСервера.ОтветилиНаВопросПроЭДО(СсылкаНаОтчет);
		НеОпределена     = ТребованияФНСВызовСервера.ОбязательностьЭДОНеОпределена(СсылкаНаОтчет);
		
		Если ЭДООбязателен И ОтветилиНаВопрос Тогда
			ТекстНадписи = НСтр("ru = 'Подтверждение приема не требуется';
								|en = 'Receipt confirmation is not required'");
			ТекстСтатуса = НСтр("ru = 'Подтверждение не требуется';
								|en = 'Confirmation is not required'");
			СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ПодтверждениеНеТребуется;
		ИначеЕсли НеОпределена Тогда
			ТекстНадписи = НСтр("ru = 'Подтвердите прием при необходимости';
								|en = 'Confirm the receipt if necessary'");
			ТекстСтатуса = НСтр("ru = 'Подтвердите прием';
								|en = 'Confirm hiring'");
			СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ОбязанностьПодтвержденияНеОпределена;
		Иначе
			ТекстНадписи = НСтр("ru = 'Подтвердите прием';
								|en = 'Confirm hiring'");
			ТекстСтатуса = НСтр("ru = 'Подтвердите прием';
								|en = 'Confirm hiring'");
			СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ТребуетсяПодтверждениеПриема;
		КонецЕсли;
		
		// Случай, когда в Описи есть требования
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстНадписи;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= Дата(1,1,1);
		СтрокаЭтапа.КомментарийКСостоянию		= ТребованияФНС.КомментарийДляСостоянияТребуетсяПодтверждение(СсылкаНаОтчет);
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.КоличествоОтветов			= ТребованияФНС.КоличествоОтветовПредставление(СсылкаНаОтчет);
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= СостояниеСдачиОтчетности;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
		
КонецФункции

Функция ТаблицаЭтаповОтправкиЗапросаИОН(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	 
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;

	// получаем список сообщений
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;

	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрЗапросыНП 						= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ЗапросНП));
	СтрПодтвержденияЗапросНО 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗапросНО));
	СтрИзвещенияПодтверждениеНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
	СтрИзвещенияЗапросНО 				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗапросНО));
	СтрРезультатыПриемаЗапросНО 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗапросНО));
	СтрИзвещенияРезультатПриемаНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
	СтрРезультатыОбработкиЗапросНО 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО));
	СтрИзвещенияРезультатОбработкиНП 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП));
	
	// Если статус первичного - не отправлено, тогда выходим 
	Если СтрЗапросыНП.Количество() > 0 И СтрЗапросыНП[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.Дата						= ДатаОтправки(СтрЗапросыНП, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
													|en = 'Awaiting confirmation of sending date'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрЗапросыНП.Количество() > 0;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
													|en = 'Sent to FTS'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
													|en = 'Sent to FTS'");
	СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияЗапросНО, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием запроса в обработку';
													|en = 'Awaiting receipt of request for processing'");
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
													|en = 'Sending date confirmation'");
	СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияЗапросНО.Количество() > 0, СтрПодтвержденияЗапросНО[0].Ссылка, "");
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияЗапросНО.Количество() > 0;
	
	// определяем наиболее свежее сообщение с результатом приема
	ПоследнийРезультатПриема = Неопределено;
	Для Каждого СтрРезультатПриемаЗапросНО Из СтрРезультатыПриемаЗапросНО Цикл
		Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатПриемаЗапросНО.Дата > ПоследнийРезультатПриема.Дата Тогда
			ПоследнийРезультатПриема = СтрРезультатПриемаЗапросНО;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрРезультатыПриемаЗапросНО.Количество() > 0 И НЕ НеПолучатьДаты Тогда
		ТранспортноеСообщение = СтрРезультатыПриемаЗапросНО[0].Ссылка;
		ВремяРезультатаПриема = ВремяПодписанияТранспортногоСообщения(ТранспортноеСообщение);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВремяРезультатаПриема) Тогда 
		ВремяРезультатаПриема = ДатаИзОтвета(СтрРезультатыПриемаЗапросНО, НеПолучатьДаты);
	КонецЕсли;
	
	// если результат приема отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.Дата						= ВремяРезультатаПриема;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте новый запрос';
														|en = 'Correct errors and send a new request'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
														|en = 'Notification of refusal'");
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаЗапросНО.Количество() > 0, СтрРезультатыПриемаЗапросНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаЗапросНО.Количество() > 0;
		
	Иначе
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.Дата						= ВремяРезультатаПриема;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается ответ на запрос';
														|en = 'Awaiting the request response'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о приеме';
														|en = 'Notice of acceptance'");
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаЗапросНО.Количество() > 0, СтрРезультатыПриемаЗапросНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаЗапросНО.Количество() > 0;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыОбработкиЗапросНО, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= СсылкаНаОтчет.ВидУслуги;
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыОбработкиЗапросНО.Количество() > 0, СтрРезультатыОбработкиЗапросНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыОбработкиЗапросНО.Количество() > 0;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ВремяПодписанияТранспортногоСообщения(ТранспортноеСообщение) Экспорт
	
	ФильтрПоТипу = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись;
	Вложения     = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение, Истина, ФильтрПоТипу);
	
	Если Вложения.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		ДвДанныеПодписи = Вложения[0].Данные.Получить();
		Время = ДатаПодписания(ДвДанныеПодписи);
		Возврат Время;
	КонецЕсли;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ПолучатьДаты")
			И ДополнительныеПараметры.ПолучатьДаты);
			
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	// получаем список сообщений
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);

	// выделяем основные типы сообщений
	СтрЗапросЕГР 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП));
	СтрРезультатыОбработкиЗапросЕГР = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП));
	
	// Если статус первичного - не отправлено, тогда выходим 
	Если СтрЗапросЕГР.Количество() > 0 И СтрЗапросЕГР[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.Дата						= ДатаОтправки(СтрЗапросЕГР, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается ответ на запрос';
													|en = 'Awaiting the request response'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрЗапросЕГР.Количество() > 0;
	
	// определяем наиболее свежее сообщение с результатом приема
	ПоследнийРезультатПриема = Неопределено;
	Для Каждого СтрРезультатОбработкиЗапроса Из СтрРезультатыОбработкиЗапросЕГР Цикл
		Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатОбработкиЗапроса.Дата > СтрРезультатОбработкиЗапроса.Дата Тогда
			ПоследнийРезультатПриема = СтрРезультатОбработкиЗапроса;
		КонецЕсли;
	КонецЦикла;
	
	// если результат приема отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте новый запрос';
														|en = 'Correct errors and send a new request'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
														|en = 'Notification of refusal'");
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыОбработкиЗапросЕГР.Количество() > 0, СтрРезультатыОбработкиЗапросЕГР[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыОбработкиЗапросЕГР.Количество() > 0;

	Иначе
		
		ВАрхиве = Ложь;
		ЕстьОтвет = ЕстьОтветНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП(СсылкаНаОтчет, ВАрхиве);
		
		Если СтрРезультатыОбработкиЗапросЕГР.Количество() > 0 Тогда
			ТранспортноеСообщение = СтрРезультатыОбработкиЗапросЕГР[0].Ссылка;
			СообщениеРаспаковано  = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение).Количество() > 0;
		Иначе
			СообщениеРаспаковано = Ложь;
		КонецЕсли;
		
		Если СтрРезультатыОбработкиЗапросЕГР.Количество() > 0 И СообщениеРаспаковано И НЕ ЕстьОтвет Тогда
			
			Если СсылкаНаОтчет.ВидПараметраЗапроса	= Перечисления.ВидыПараметровЗапросаНаВыпискуИзЕГРЮЛ_ЕГРИП.ИНН Тогда
				Комментарий = НСтр("ru = 'По запрошенному ИНН информация в реестре не найдена';
									|en = 'Information on the requested TIN is not found in the registry'");
			Иначе
				Комментарий = НСтр("ru = 'По запрошенному ОГРН информация в реестре не найдена';
									|en = 'Information on the requested registration number is not found in the registry'");
			КонецЕсли;
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не найдено в реестре';
															|en = 'Not found in the registry'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не найдено в реестре';
															|en = 'Not found in the registry'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыОбработкиЗапросЕГР, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= Комментарий;
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;
			
		Иначе

			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Готово';
															|en = 'Finish'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Готово';
															|en = 'Finish'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыОбработкиЗапросЕГР, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Выписка';
															|en = 'Statement'");
			СтрокаЭтапа.Протокол					= ?(СтрРезультатыОбработкиЗапросЕГР.Количество() > 0, СтрРезультатыОбработкиЗапросЕГР[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрРезультатыОбработкиЗапросЕГР.Количество() > 0;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиЗапросаНаИнформационноеОбслуживаниеСтрахователя(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	// получаем список сообщений
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрПервичныеСообщенияСодержащееЗапросПФР 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР));
	СтрПодтвержденияПолученияЗапросаПФР 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияЗапросаПФР));
	СтрОтветыНаЗапросПФР 						= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР));
	СтрОтветыНаЗапросКвитанцияПФР 				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросКвитанцияПФР));
		
	// Если статус первичного - не отправлено, тогда выходим 
	Если СтрПервичныеСообщенияСодержащееЗапросПФР.Количество() > 0 И СтрПервичныеСообщенияСодержащееЗапросПФР[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
		СсылкаНаОтчет,,
		ЦиклОбмена.ДатаСоздания,
		ЦиклОбмена.Вид,
		ЦиклОбмена.Тип);
	
	ТекстОтправлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
		НСтр("ru = 'Отправлено в ПФР';
			|en = 'Sent to PF'"),,, НЕ ЭтоОтправкаВСФР);
	
	// Отправлено в ПФР
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= ТекстОтправлено;
	СтрокаЭтапа.ТекстСтатуса				= ТекстОтправлено;
	СтрокаЭтапа.Дата						= ДатаОтправки(СтрПервичныеСообщенияСодержащееЗапросПФР, НеПолучатьДаты);
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием запроса в обработку';
													|en = 'Awaiting receipt of request for processing'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщенияСодержащееЗапросПФР.Количество() > 0;

	// Принято в обработку
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияПолученияЗапросаПФР, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается ответ на запрос';
													|en = 'Awaiting the request response'");
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение получения';
													|en = 'Receipt confirmation'");
	СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияПолученияЗапросаПФР.Количество() > 0, СтрПодтвержденияПолученияЗапросаПФР[0].Ссылка, "");
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияПолученияЗапросаПФР.Количество() > 0;
			
	// определяем наиболее свежее сообщение с результатом приема
	ПоследнийОтветНаЗапрос = Неопределено;
	Для Каждого СтрОтветНаЗапросПФР Из СтрОтветыНаЗапросПФР Цикл
		Если ПоследнийОтветНаЗапрос = Неопределено ИЛИ СтрОтветНаЗапросПФР.Дата > ПоследнийОтветНаЗапрос.Дата Тогда
			ПоследнийОтветНаЗапрос = СтрОтветНаЗапросПФР;
		КонецЕсли;
	КонецЦикла;
	
	// если результат отрицательный, то выводим соответствующее сообщение
	Если ПоследнийОтветНаЗапрос <> Неопределено И ПоследнийОтветНаЗапрос.ПротоколСОшибкой Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отказано';
														|en = 'Declined'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрОтветыНаЗапросПФР, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте новый запрос';
														|en = 'Correct errors and send a new request'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
														|en = 'Notification of refusal'");
		СтрокаЭтапа.Протокол					= ?(СтрОтветыНаЗапросПФР.Количество() > 0, СтрОтветыНаЗапросПФР[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрОтветыНаЗапросПФР.Количество() > 0;
		
	Иначе
		
		Если СсылкаНаОтчет.ВидУслуги = Перечисления.ВидыУслугПриИОС.СправкаОСостоянииРасчетов Тогда
			НаименованиеПротокола = НСтр("ru = 'Справка о состоянии расчетов';
										|en = 'Statement of settlements'");
		Иначе
			НаименованиеПротокола = НСтр("ru = 'Сверка ФИО и СНИЛС';
										|en = 'Full name and SNILS reconciliation '");
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрОтветыНаЗапросПФР, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НаименованиеПротокола;
		СтрокаЭтапа.Протокол					= ?(СтрОтветыНаЗапросПФР.Количество() > 0, СтрОтветыНаЗапросПФР[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрОтветыНаЗапросПФР.Количество() > 0;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиМашиночитаемойДоверенностиРаспределенногоРеестра(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	СвойстваОтправки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОтчет,
		"Статус, ДатаОтправки, ДатаОбновленияСтатуса, ДатаОтправкиЗаявленияНаОтзыв, ДатаРегистрации, ДатаИзмененияСтатуса, "
		+ "ТекстОшибки, РежимыИспользования");
	ЭтоДоверенностьФТС = (СвойстваОтправки.РежимыИспользования = "ФТС");
	
	Если ЭтоДоверенностьФТС Тогда
		// определяем последнюю отправку
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("Отправка")
			И ЗначениеЗаполнено(ДополнительныеПараметры.Отправка) Тогда
			ОтправкаСсылка = ДополнительныеПараметры.Отправка;
		Иначе
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФТС(СсылкаНаОтчет);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваОтправки.ДатаИзмененияСтатуса)
		И (НЕ ЗначениеЗаполнено(СвойстваОтправки.ДатаОбновленияСтатуса)
		ИЛИ НачалоДня(СвойстваОтправки.ДатаИзмененияСтатуса) < НачалоДня(СвойстваОтправки.ДатаОбновленияСтатуса)) Тогда
		
		ДатаОбновленияСтатуса = СвойстваОтправки.ДатаИзмененияСтатуса;
		
	ИначеЕсли ЗначениеЗаполнено(СвойстваОтправки.ДатаОбновленияСтатуса) Тогда
		ДатаОбновленияСтатуса = СвойстваОтправки.ДатаОбновленияСтатуса;
		
	Иначе
		ДатаОбновленияСтатуса = СвойстваОтправки.ДатаРегистрации;
	КонецЕсли;
	
	ОтчетОтправлен = ЗначениеЗаполнено(СвойстваОтправки.Статус)
		И СвойстваОтправки.Статус <> Перечисления.СтатусыМашиночитаемойДоверенностиКО.ВРаботе;
	ОтчетОжидаетПодтверждения =
		(СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОжиданиеПодтверждения);
	ОтчетЗагруженВРаспределенныйРеестр = ОтчетОтправлен
		И СвойстваОтправки.Статус <> Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отправлено;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено в ФТС';
																			|en = 'Sent to FCS'"),
											  НСтр("ru = 'Отправлено в реестр';
													|en = 'Sent to the registry'"));
	СтрокаЭтапа.ТекстСтатуса 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено в ФТС';
																			|en = 'Sent to FCS'"),
											  НСтр("ru = 'Отправлено в реестр';
													|en = 'Sent to the registry'"));
	СтрокаЭтапа.Дата 						= СвойстваОтправки.ДатаОтправки;
	СтрокаЭтапа.КомментарийКСостоянию 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Ожидается результат обработки';
																			|en = 'Processing result is expected'"),
											  НСтр("ru = 'Ожидается регистрация в распределенном реестре';
													|en = 'Waiting for registration in the distributed registry'"));
	СтрокаЭтапа.НаименованиеПротокола 		= "";
	СтрокаЭтапа.Протокол 					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден 				= ОтчетОтправлен;
	
	Если СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОшибкаРегистрации Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Ошибка регистрации';
														|en = 'Registration error'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не зарегистрировано';
														|en = 'Not registered'");
		СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки и отправьте новую доверенность';
														|en = 'Correct the errors and send a new authorization letter'");
		СтрокаЭтапа.НаименованиеПротокола 		= "";
		СтрокаЭтапа.Протокол 					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= Истина;
		
	Иначе
		Если НЕ ЭтоДоверенностьФТС Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отправлено в ФНС';
															|en = 'Sent to the Federal Tax Service'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отправлено в ФНС';
															|en = 'Sent to the Federal Tax Service'");
			СтрокаЭтапа.Дата 						= ?(ОтчетОжидаетПодтверждения, ДатаОбновленияСтатуса, Дата(1,1,1));
			СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Ожидается регистрация в ФНС';
															|en = 'Waiting for registration in the Federal Tax Service'");
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден 				= ОтчетЗагруженВРаспределенныйРеестр;
		КонецЕсли;
		
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтказВРегистрации Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Не зарегистрировано';
																					|en = 'Not registered'"),
													  НСтр("ru = 'Отказ в регистрации в ФНС';
															|en = 'Registration in the Federal Tax Service is denied'"));
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не зарегистрировано';
															|en = 'Not registered'");
			СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= ?(ЭтоДоверенностьФТС,
													  НСтр("ru = 'Исправьте ошибки и отправьте доверенность еще раз';
															|en = 'Correct errors and send the authorization letter again'"),
													  ?(ЗначениеЗаполнено(СвойстваОтправки.ТекстОшибки), СвойстваОтправки.ТекстОшибки,
													  НСтр("ru = 'Проверьте реквизиты, включая паспортные данные, код налогового органа, исправьте ошибки и отправьте новую доверенность';
															|en = 'Check the information details including passport data and a tax authority code. Correct the errors and send a new authorization letter'")));
			СтрокаЭтапа.НаименованиеПротокола 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Протокол ошибок';
																					|en = 'Error log'"), "");
			СтрокаЭтапа.Протокол 					= ?(ЭтоДоверенностьФТС, ОтправкаСсылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
		ИначеЕсли СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ДатаНачалаДействияНеНаступила Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Зарегистрировано, срок действия не наступил';
															|en = 'The authorization letter is registered, it is not within its validity period'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Зарегистрировано, срок действия не наступил';
															|en = 'The authorization letter is registered, it is not within its validity period'");
			СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Дождитесь даты начала действия или отправьте новую доверенность';
															|en = 'Wait for the validity period start date or send a new authorization letter'");
			СтрокаЭтапа.НаименованиеПротокола 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Протокол о регистрации';
																					|en = 'Registration protocol'"), "");
			СтрокаЭтапа.Протокол 					= ?(ЭтоДоверенностьФТС, ОтправкаСсылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
		ИначеЕсли СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ИстекСрокДействия Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Истек срок действия';
															|en = 'Expired'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Истек срок действия';
															|en = 'Expired'");
			СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Для продления срока действия отправьте новую доверенность';
															|en = 'To renew the validity period, send a new authorization letter'");
			СтрокаЭтапа.НаименованиеПротокола 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Протокол о регистрации';
																					|en = 'Registration protocol'"), "");
			СтрокаЭтапа.Протокол 					= ?(ЭтоДоверенностьФТС, ОтправкаСсылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
		ИначеЕсли СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Зарегистрировано
			ИЛИ СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтправленоЗаявлениеНаОтзыв
			ИЛИ СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОжиданиеПодтвержденияОтзыва
			ИЛИ СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано
			ИЛИ СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОшибкаОтзыва
			ИЛИ СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтказВРегистрацииОтзыва Тогда
			
			ОтчетЗарегистрирован = (СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Зарегистрировано);
			ОтчетОтозван = (СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано);
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Зарегистрировано';
															|en = 'Registered'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Зарегистрировано';
															|en = 'Registered'");
			СтрокаЭтапа.Дата 						= ?(ОтчетЗарегистрирован, ДатаОбновленияСтатуса, Дата(1,1,1));
			СтрокаЭтапа.КомментарийКСостоянию 		= "";
			СтрокаЭтапа.НаименованиеПротокола 		= ?(ЭтоДоверенностьФТС И НЕ ОтчетОтозван, НСтр("ru = 'Протокол о регистрации';
																									|en = 'Registration protocol'"), "");
			СтрокаЭтапа.Протокол 					= ?(ЭтоДоверенностьФТС И НЕ ОтчетОтозван, ОтправкаСсылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
			Если СвойстваОтправки.Статус <> Перечисления.СтатусыМашиночитаемойДоверенностиКО.Зарегистрировано Тогда
				ОтчетОжидаетПодтвержденияОтзыва =
					(СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОжиданиеПодтвержденияОтзыва);
				ОтзывОтчетаЗагруженВРаспределенныйРеестр =
					СвойстваОтправки.Статус <> Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтправленоЗаявлениеНаОтзыв
					И СвойстваОтправки.Статус <> Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОшибкаОтзыва;
				
				Если СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОшибкаОтзыва Тогда
					СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
					СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Зарегистрировано, ошибка отзыва';
																	|en = 'Registered, revocation error'");
					СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Зарегистрировано, ошибка отзыва';
																	|en = 'Registered, revocation error'");
					СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
					СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки отзыва и отправьте новый';
																	|en = 'Correct the revocation errors and send a new revocation application'");
					СтрокаЭтапа.НаименованиеПротокола 		= "";
					СтрокаЭтапа.Протокол 					= "";
					СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
					СтрокаЭтапа.ЭтапПройден 				= Истина;
					
				ИначеЕсли НЕ ОтзывОтчетаЗагруженВРаспределенныйРеестр Тогда
					СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
					СтрокаЭтапа.ТекстНадписи 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено заявление на отзыв';
																							|en = 'Revocation application is sent'"),
															  НСтр("ru = 'Отправлено заявление на отзыв в реестр';
																	|en = 'The revocation application is sent to the registry'"));
					СтрокаЭтапа.ТекстСтатуса 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено заявление на отзыв';
																							|en = 'Revocation application is sent'"),
															  НСтр("ru = 'Отправлено заявление на отзыв в реестр';
																	|en = 'The revocation application is sent to the registry'"));
					СтрокаЭтапа.Дата 						= СвойстваОтправки.ДатаОтправкиЗаявленияНаОтзыв;
					СтрокаЭтапа.КомментарийКСостоянию 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Ожидается обработка отзыва';
																							|en = 'Pending revocation processing'"),
															  НСтр("ru = 'Ожидается обработка отзыва в распределенном реестре';
																	|en = 'Waiting for revocation processing in the distributed registry'"));
					СтрокаЭтапа.НаименованиеПротокола 		= "";
					СтрокаЭтапа.Протокол 					= "";
					СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
					СтрокаЭтапа.ЭтапПройден 				= Истина;
					
				Иначе
					Если СвойстваОтправки.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтказВРегистрацииОтзыва Тогда
						СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
						СтрокаЭтапа.ТекстНадписи 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Зарегистрировано, отказ в отзыве';
																								|en = 'Registered. Revocation is denied'"),
																  НСтр("ru = 'Зарегистрировано, отказ в отзыве в ФНС';
																		|en = 'Registered. Revocation is denied in the Federal Tax Service'"));
						СтрокаЭтапа.ТекстСтатуса 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Зарегистрировано, отказ в отзыве';
																								|en = 'Registered. Revocation is denied'"),
																  НСтр("ru = 'Зарегистрировано, отказ в отзыве в ФНС';
																		|en = 'Registered. Revocation is denied in the Federal Tax Service'"));
						СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
						СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки отзыва и отправьте новый';
																		|en = 'Correct the revocation errors and send a new revocation application'");
						СтрокаЭтапа.НаименованиеПротокола 		= "";
						СтрокаЭтапа.Протокол 					= "";
						СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
						СтрокаЭтапа.ЭтапПройден 				= Истина;
						
					ИначеЕсли НЕ ОтчетОтозван Тогда
						СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
						СтрокаЭтапа.ТекстНадписи 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено заявление на отзыв';
																								|en = 'Revocation application is sent'"),
																  НСтр("ru = 'Отправлено заявление на отзыв в ФНС';
																		|en = 'The revocation application is sent to the Federal Tax Service'"));
						СтрокаЭтапа.ТекстСтатуса 				= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Отправлено заявление на отзыв';
																								|en = 'Revocation application is sent'"),
																  НСтр("ru = 'Отправлено заявление на отзыв в ФНС';
																		|en = 'The revocation application is sent to the Federal Tax Service'"));
						СтрокаЭтапа.Дата 						= ?(ОтчетОжидаетПодтвержденияОтзыва, ДатаОбновленияСтатуса,
																  СвойстваОтправки.ДатаОтправкиЗаявленияНаОтзыв);
						СтрокаЭтапа.КомментарийКСостоянию 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Ожидается обработка отзыва';
																								|en = 'Pending revocation processing'"),
																  НСтр("ru = 'Ожидается обработка отзыва в ФНС';
																		|en = 'Waiting for revocation processing in the Federal Tax Service'"));
						СтрокаЭтапа.НаименованиеПротокола 		= "";
						СтрокаЭтапа.Протокол 					= "";
						СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
						СтрокаЭтапа.ЭтапПройден 				= ОтзывОтчетаЗагруженВРаспределенныйРеестр;
						
					Иначе
						СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
						СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отозвано';
																		|en = 'Revoked'");
						СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отозвано';
																		|en = 'Revoked'");
						СтрокаЭтапа.Дата 						= ДатаОбновленияСтатуса;
						СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Доверенность досрочно отозвана';
																		|en = 'Authorization letter is revoked early'");
						СтрокаЭтапа.НаименованиеПротокола 		= ?(ЭтоДоверенностьФТС, НСтр("ru = 'Протокол об отзыве';
																								|en = 'Revocation protocol'"), "");
						СтрокаЭтапа.Протокол 					= ?(ЭтоДоверенностьФТС, ОтправкаСсылка, "");
						СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
						СтрокаЭтапа.ЭтапПройден 				= ОтчетОтозван;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиМашиночитаемойДоверенности(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи 				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса 				= НачальныйСтатус;
	СтрокаЭтапа.Дата 						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию 		= "";
	СтрокаЭтапа.НаименованиеПротокола 		= "";
	СтрокаЭтапа.Протокол 					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден 				= Истина;
	
	СвойстваДоверенности = ДокументооборотСКОВызовСервера.СвойстваМЧДЕдиногоФормата(СсылкаНаОтчет);
	
	ОтчетОтправлен = ЗначениеЗаполнено(СвойстваДоверенности.ТехническийСтатус)
		И СвойстваДоверенности.ТехническийСтатус <>
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Создание")
		И СвойстваДоверенности.ТехническийСтатус <>
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Подписание")
		И СвойстваДоверенности.ТехническийСтатус <>
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Подписана")
		И СвойстваДоверенности.ТехническийСтатус <>
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Активна");
	ОтчетЗагруженВРаспределенныйРеестр = ОтчетОтправлен
		И СвойстваДоверенности.ТехническийСтатус <>
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Регистрация");
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка")
		И ЗначениеЗаполнено(ДополнительныеПараметры.Отправка)
		И ТипЗнч(ДополнительныеПараметры.Отправка) = Тип("СправочникСсылка.ОтправкиФТС") Тогда
		
		ОтправкаФТССсылка = ДополнительныеПараметры.Отправка;
		СвойстваОтправкиФТС = ?(ЗначениеЗаполнено(ОтправкаФТССсылка), ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ОтправкаФТССсылка, "СтатусОтправки, ДатаОтправки, ДатаПолученияРезультата"), Неопределено);
		СтатусОтправкиФТС = ?(СвойстваОтправкиФТС = Неопределено, Неопределено, СвойстваОтправкиФТС.СтатусОтправки);
		
	Иначе
		СвойстваОтправкиФТС = ПолучитьОсновныеСвойстваПоследнейОтправкиОтчетаВФТС(СсылкаНаОтчет);
		ОтправкаФТССсылка = ?(СвойстваОтправкиФТС = Неопределено, Неопределено, СвойстваОтправкиФТС.Ссылка);
		СтатусОтправкиФТС = ?(СвойстваОтправкиФТС = Неопределено, Неопределено, СвойстваОтправкиФТС.Статус);
	КонецЕсли;
	ОтчетОтправленВФТС = (СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Отправлен
		ИЛИ СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Доставлен
		ИЛИ СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан
		ИЛИ СтатусОтправкиФТС = Перечисления.СтатусыОтправки.НеПринят
		ИЛИ СтатусОтправкиФТС = Перечисления.СтатусыОтправки.ПринятЕстьОшибки);
	
	// сдача только в ФТС
	СтатусОтправкиВФТС 			= "";
	ДатаОтправкиВФТС 			= Дата(1,1,1);
	СтатусОбработкиВФТС 		= "";
	ДатаОбработкиВФТС 			= Дата(1,1,1);
	ЗарегистрированВФТС 		= Ложь;
	СтатусОтзываВФТС 			= "";
	ДатаОтзываВФТС 				= Дата(1,1,1);
	КомментарийКСостояниюВФТС 	= "";
	НаименованиеПротоколаВФТС 	= "";
	Если ОтчетОтправленВФТС Тогда
		СтатусОтправкиВФТС 			= НСтр("ru = 'Отправлено в ФТС';
												|en = 'Sent to FCS'");
		ДатаОтправкиВФТС 			= СвойстваОтправкиФТС.ДатаОтправки;
		КомментарийКСостояниюВФТС 	= НСтр("ru = 'Ожидается результат обработки в ФТС';
											|en = 'Pending the result of processing in the Federal Customs Service'");
		
		Если НЕ ОтчетОтправлен Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= СтатусОтправкиВФТС;
			СтрокаЭтапа.ТекстСтатуса 				= СтатусОтправкиВФТС;
			СтрокаЭтапа.Дата 						= ДатаОтправкиВФТС;
			СтрокаЭтапа.КомментарийКСостоянию 		= ?(СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Отправлен
													  ИЛИ СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Доставлен,
													  КомментарийКСостояниюВФТС, "");
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден 				= ОтчетОтправленВФТС;
		КонецЕсли;
		
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если СтатусОтправкиФТС = Перечисления.СтатусыОтправки.НеПринят Тогда
			СтатусОбработкиВФТС 		= НСтр("ru = 'Не зарегистрировано в ФТС';
												|en = 'Not registered in the Federal Customs Service'");
			ДатаОбработкиВФТС 			= СвойстваОтправкиФТС.ДатаПолученияРезультата;
			КомментарийКСостояниюВФТС 	= НСтр("ru = 'Исправьте ошибки и отправьте доверенность в ФТС еще раз';
												|en = 'Correct the errors and send the authorization letter to the Federal Customs Service again'");
			НаименованиеПротоколаВФТС 	= НСтр("ru = 'Протокол ошибок ФТС';
												|en = 'Error log of the Federal Customs Service'");
			
			Если НЕ ОтчетОтправлен Тогда
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи 				= СтатусОбработкиВФТС;
				СтрокаЭтапа.ТекстСтатуса 				= СтатусОбработкиВФТС;
				СтрокаЭтапа.Дата 						= ДатаОбработкиВФТС;
				СтрокаЭтапа.КомментарийКСостоянию 		= КомментарийКСостояниюВФТС;
				СтрокаЭтапа.НаименованиеПротокола 		= НаименованиеПротоколаВФТС;
				СтрокаЭтапа.Протокол 					= ОтправкаФТССсылка;
				СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден 				= Истина;
			КонецЕсли;
			
		Иначе
			ОтозванВФТС = (СтатусОтправкиФТС = Перечисления.СтатусыОтправки.ПринятЕстьОшибки);
			
			Если СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан ИЛИ ОтозванВФТС Тогда
				СтатусОбработкиВФТС 		= НСтр("ru = 'Зарегистрировано в ФТС';
													|en = 'Registered in the Federal Customs Service'");
				ДатаОбработкиВФТС 			= ?(СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан,
										  СвойстваОтправкиФТС.ДатаПолученияРезультата, Дата(1,1,1));
				ЗарегистрированВФТС 		= Истина;
				КомментарийКСостояниюВФТС 	= "";
				НаименованиеПротоколаВФТС 	= НСтр("ru = 'Протокол о регистрации в ФТС';
													|en = 'Protocol on registration in the Federal Customs Service'");
			КонецЕсли;
			
			Если НЕ ОтчетОтправлен Тогда
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи 				= СтатусОбработкиВФТС;
				СтрокаЭтапа.ТекстСтатуса 				= СтатусОбработкиВФТС;
				СтрокаЭтапа.Дата 						= ДатаОбработкиВФТС;
				СтрокаЭтапа.КомментарийКСостоянию 		= "";
				СтрокаЭтапа.НаименованиеПротокола 		= ?(СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан,
														  НаименованиеПротоколаВФТС, "");
				СтрокаЭтапа.Протокол 					= ?(СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан, ОтправкаФТССсылка, "");
				СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден 				= СтатусОтправкиФТС = Перечисления.СтатусыОтправки.Сдан ИЛИ ОтозванВФТС;
			КонецЕсли;
			
			Если ОтозванВФТС Тогда
				СтатусОтзываВФТС 			= НСтр("ru = 'Отменено в ФТС';
													|en = 'Canceled by the Federal Customs Service'");
				ДатаОтзываВФТС 				= СвойстваОтправкиФТС.ДатаПолученияРезультата;
				КомментарийКСостояниюВФТС 	= НСтр("ru = 'Доверенность досрочно отменена в ФТС';
													|en = 'The authorization letter was prematurely canceled by the Federal Customs Service'");
				НаименованиеПротоколаВФТС 	= НСтр("ru = 'Протокол ошибок ФТС';
													|en = 'Error log of the Federal Customs Service'");
				
				Если НЕ ОтчетОтправлен Тогда
					СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
					СтрокаЭтапа.ТекстНадписи 				= СтатусОтзываВФТС;
					СтрокаЭтапа.ТекстСтатуса 				= ДатаОтзываВФТС;
					СтрокаЭтапа.Дата 						= СвойстваОтправкиФТС.ДатаПолученияРезультата;
					СтрокаЭтапа.КомментарийКСостоянию 		= КомментарийКСостояниюВФТС;
					СтрокаЭтапа.НаименованиеПротокола 		= НаименованиеПротоколаВФТС;
					СтрокаЭтапа.Протокол 					= ОтправкаФТССсылка;
					СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
					СтрокаЭтапа.ЭтапПройден 				= Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ОтчетОтправлен Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
	КонецЕсли;
	
	КомментарийКСостоянию = ?(СвойстваДоверенности.ТехническийСтатус <> Неопределено
		И СвойстваДоверенности.ТехническийСтатус =
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Регистрация"),
			НСтр("ru = 'Ожидается регистрация в распределенном реестре';
				|en = 'Pending registration in the distributed ledger'"), "");
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отправлено в ЦПРР';
													|en = 'Sent to the digital distributed registry platform'");
	СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отправлено в ЦПРР';
													|en = 'Sent to the digital distributed registry platform'");
	СтрокаЭтапа.Дата 						= ?(ОтчетОтправлен, СвойстваДоверенности.ДатаТранзакции, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию 		= КомментарийКСостоянию;
	СтрокаЭтапа.НаименованиеПротокола 		= "";
	СтрокаЭтапа.Протокол 					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден 				= ОтчетОтправлен;
	
	Если СвойстваДоверенности.ТехническийСтатус <> Неопределено
		И СвойстваДоверенности.ТехническийСтатус =
			ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("ОшибкаРегистрации") Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Ошибка регистрации в ЦПРР';
														|en = 'Error registering in the digital distributed registry platform'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не зарегистрировано в ЦПРР';
														|en = 'Not registered in the digital distributed registry platform'");
		СтрокаЭтапа.Дата 						= СвойстваДоверенности.ДатаЗапросаСтатуса;
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки и отправьте новую доверенность
															 |в распределеннный реестр';
															 |en = 'Correct the errors and send a new authorization letter
															 |to the distributed registry'");
		СтрокаЭтапа.НаименованиеПротокола 		= "";
		СтрокаЭтапа.Протокол 					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= Истина;
		
	Иначе
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если СвойстваДоверенности.ТехническийСтатус <> Неопределено
			И СвойстваДоверенности.ТехническийСтатус =
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("ДатаНачалаДействияНеНаступила") Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Зарегистрировано в ЦПРР, срок действия не наступил';
															|en = 'Registered in the digital distributed registry platform, not within its validity period'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Зарегистрировано в ЦПРР, срок действия не наступил';
															|en = 'Registered in the digital distributed registry platform, not within its validity period'");
			СтрокаЭтапа.Дата 						= СвойстваДоверенности.ДатаЗапросаСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Дождитесь даты начала действия или отправьте новую доверенность
																 |в распределенный реестр';
																 |en = 'Wait for the effective date or send a new authorization letter
																 |to the distributed registry'");
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
		ИначеЕсли СвойстваДоверенности.ТехническийСтатус <> Неопределено
			И СвойстваДоверенности.ТехническийСтатус =
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Просрочена") Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Истек срок действия в ЦПРР';
															|en = 'The validity period in the digital distributed registry platform expired'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Истек срок действия в ЦПРР';
															|en = 'The validity period in the digital distributed registry platform expired'");
			СтрокаЭтапа.Дата 						= СвойстваДоверенности.ДатаЗапросаСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Для продления срока действия отправьте новую доверенность
																 |в распределенный реестр';
																 |en = 'To renew the validity period, send a new authorization letter
																 |to the distributed registry'");
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
			
		Иначе
			ОтчетЗарегистрированИлиОтзывается = СвойстваДоверенности.ТехническийСтатус <> Неопределено
				И (СвойстваДоверенности.ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Зарегистрирована")
					ИЛИ СвойстваДоверенности.ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("РегистрацияОтмены")
					ИЛИ СвойстваДоверенности.ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Отменена"));
			ОтчетЗарегистрирован = СвойстваДоверенности.ТехническийСтатус <> Неопределено
				И СвойстваДоверенности.ТехническийСтатус =
					ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Зарегистрирована");
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Зарегистрировано в ЦПРР';
															|en = 'Registered in the digital distributed registry platform'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Зарегистрировано в ЦПРР';
															|en = 'Registered in the digital distributed registry platform'");
			СтрокаЭтапа.Дата 						= ?(ОтчетЗарегистрирован, СвойстваДоверенности.ДатаЗапросаСтатуса, Дата(1,1,1));
			СтрокаЭтапа.КомментарийКСостоянию 		= "";
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= ОтчетЗарегистрированИлиОтзывается;
			
			Если ОтчетЗарегистрированИлиОтзывается И НЕ ОтчетЗарегистрирован Тогда
				ОтчетОжидаетПодтвержденияОтзыва = СвойстваДоверенности.ТехническийСтатус <> Неопределено
					И СвойстваДоверенности.ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("РегистрацияОтмены");
				ОтчетОтозван = СвойстваДоверенности.ТехническийСтатус <> Неопределено
					И СвойстваДоверенности.ТехническийСтатус =
						ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Отменена");
				
				Если НЕ ОтчетОтозван Тогда
					СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
					СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отправлено заявление на отмену в ЦПРР';
																	|en = 'An application for cancellation is sent to the digital distributed registry platform'");
					СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отправлено заявление на отмену в ЦПРР';
																	|en = 'An application for cancellation is sent to the digital distributed registry platform'");
					СтрокаЭтапа.Дата 						= ?(ОтчетОжидаетПодтвержденияОтзыва, СвойстваДоверенности.ДатаЗапросаСтатуса, Дата(1,1,1));
					СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Ожидается обработка отмены в распределенном реестре';
																	|en = 'Pending cancellation processing in the distributed registry'");
					СтрокаЭтапа.НаименованиеПротокола 		= "";
					СтрокаЭтапа.Протокол 					= "";
					СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
					СтрокаЭтапа.ЭтапПройден 				= Истина;
					
				Иначе
					СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
					СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отменено в ЦПРР';
																	|en = 'Cancelled in the digital distributed registry platform'");
					СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отменено в ЦПРР';
																	|en = 'Cancelled in the digital distributed registry platform'");
					СтрокаЭтапа.Дата 						= СвойстваДоверенности.ДатаЗапросаСтатуса;
					СтрокаЭтапа.КомментарийКСостоянию 		= ?(ОтчетОтозван,
															  НСтр("ru = 'Доверенность досрочно отменена в распределенном реестре';
																	|en = 'The authorization letter is prematurely canceled in the distributed registry'"), "");
					СтрокаЭтапа.НаименованиеПротокола 		= "";
					СтрокаЭтапа.Протокол 					= "";
					СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
					СтрокаЭтапа.ЭтапПройден 				= ОтчетОтозван;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// добавление информации о сдаче в ФТС
	КоличествоЭтаповОтправки = ТаблицаЭтаповОтправки.Количество();
	Пока КоличествоЭтаповОтправки >= 0 Цикл
		Если ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].ЭтапПройден Тогда
			Прервать;
		Иначе
			КоличествоЭтаповОтправки = КоличествоЭтаповОтправки - 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КомментарийКСостояниюВФТС) Тогда
		ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию =
			ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию
			+ ?(ЗначениеЗаполнено(ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию), "
			|", "") + КомментарийКСостояниюВФТС;
	КонецЕсли;
	
	Если КоличествоЭтаповОтправки >= 3 И ЗначениеЗаполнено(СтатусОтправкиВФТС)
		И НЕ ЗначениеЗаполнено(СтатусОбработкиВФТС) Тогда
		
		ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].СостояниеСдачиОтчетности =
			Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		
	ИначеЕсли КоличествоЭтаповОтправки = 3 И ТаблицаЭтаповОтправки[2].СостояниеСдачиОтчетности =
		Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота
		И (ЗначениеЗаполнено(СтатусОбработкиВФТС) И НЕ ЗарегистрированВФТС ИЛИ ЗначениеЗаполнено(СтатусОтзываВФТС)) Тогда
		
		ТаблицаЭтаповОтправки[2].СостояниеСдачиОтчетности =
			Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
	КонецЕсли;
	
	Если КоличествоЭтаповОтправки >= 4 И ЗначениеЗаполнено(СтатусОтзываВФТС) Тогда
		ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию =
			СтатусОтзываВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОтзываВФТС, " ")
			+ ?(ЗначениеЗаполнено(ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию), "
			|
			|", "") + ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].КомментарийКСостоянию;
	КонецЕсли;
	
	Если КоличествоЭтаповОтправки >= 3 И ЗначениеЗаполнено(СтатусОбработкиВФТС) Тогда
		ТаблицаЭтаповОтправки[2].КомментарийКСостоянию =
			СтатусОбработкиВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОбработкиВФТС, " ")
			+ ?(ЗначениеЗаполнено(СтатусОтзываВФТС) И КоличествоЭтаповОтправки = 3, "
			|", "") + СтатусОтзываВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОтзываВФТС, " ")
			+ ?(ЗначениеЗаполнено(ТаблицаЭтаповОтправки[2].КомментарийКСостоянию), "
			|
			|", "") + ТаблицаЭтаповОтправки[2].КомментарийКСостоянию;
	КонецЕсли;
	
	Если КоличествоЭтаповОтправки >= 2 И ЗначениеЗаполнено(СтатусОтправкиВФТС) Тогда
		ТаблицаЭтаповОтправки[1].КомментарийКСостоянию =
			СтатусОтправкиВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОтправкиВФТС, " ")
			+ ?(ЗначениеЗаполнено(СтатусОбработкиВФТС) И КоличествоЭтаповОтправки = 2, "
			|", "") + СтатусОбработкиВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОбработкиВФТС, " ")
			+ ?(ЗначениеЗаполнено(СтатусОтзываВФТС) И КоличествоЭтаповОтправки = 2, "
			|", "") + СтатусОтзываВФТС + ДокументооборотСКОКлиентСервер.ДатаСВременемЕслиЕсть(ДатаОтзываВФТС, " ")
			+ ?(ЗначениеЗаполнено(ТаблицаЭтаповОтправки[1].КомментарийКСостоянию), "
			|
			|", "") + ТаблицаЭтаповОтправки[1].КомментарийКСостоянию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтправкаФТССсылка) Тогда
		ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].НаименованиеПротокола 	= НаименованиеПротоколаВФТС;
		ТаблицаЭтаповОтправки[КоличествоЭтаповОтправки - 1].Протокол 				= ОтправкаФТССсылка;
	КонецЕсли;
	
	СтатусВФТС = ?(ЗначениеЗаполнено(СтатусОтзываВФТС), СтатусОтзываВФТС, ?(ЗначениеЗаполнено(СтатусОбработкиВФТС),
		СтатусОбработкиВФТС, ?(ЗначениеЗаполнено(СтатусОтправкиВФТС), СтатусОтправкиВФТС, "")));
