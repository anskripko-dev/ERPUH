Функция ФИОИзТега(Узел) Экспорт
	
	ФИО = СвойствоXDTO(Узел, "ФИО");
	Если ФИО = "" Тогда
		Возврат ФИО;
	Иначе
		
		Фамилия  = ФИО.Фамилия;
		Имя      = ФИО.Имя;
		Отчество = СвойствоXDTO(ФИО, "Отчество");
		
		ФИО = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
		
	КонецЕсли;
	
	Возврат ФИО;
	
КонецФункции

Функция СписокИзXDTO(Узел, Поле) Экспорт
	
	Если Узел.Свойства().Получить(Поле) = Неопределено Тогда
		Возврат Новый Массив;
	Иначе
		
		Список = Узел[Поле];
		Если ТипЗнч(Список) <> Тип("СписокXDTO") Тогда
			// Если элемент один, то он возвращается как элемент, а не как список
			Список = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Список);
		КонецЕсли;
		
		Возврат Список;
		
	КонецЕсли;
	
КонецФункции

Функция ЕстьСвойствоXDTO(Узел, Поле) Экспорт
	
	Возврат Узел.Свойства().Получить(Поле) <> Неопределено;
	
КонецФункции

Функция СвойствоXDTO(Узел, Поле) Экспорт
	
	Если Узел.Свойства().Получить(Поле) <> Неопределено Тогда
		Результат = Узел[Поле];
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьШапкуАктаСверки(Шапка, XDTO, АктСвер) Экспорт
	
	Документ = XDTO.Документ;
	
	Шапка.Параметры.НомерАкта = АктСвер.НомерАкт;
	Шапка.Параметры.ДатаАкта  = СвойствоXDTO(АктСвер, "ДатаСвер");
	
	ЗаполнитьОрганизацииВШапкеАктаСверки(Шапка, XDTO, АктСвер);
	
КонецПроцедуры

Процедура ЗаполнитьОрганизацииВШапкеАктаСверки(Шапка, XDTO, АктСвер) Экспорт
	
	Документ = XDTO.Документ;
	
	Шапка.Параметры.НаименованиеИФНС         = Документ.КодНО;
	
	СвНП = АктСвер.СвНП;
	Если ЕстьСвойствоXDTO(СвНП, "НПЮЛ") Тогда
		НПЮЛ = СвНП.НПЮЛ;
		Шапка.Параметры.НаименованиеОрганизации  = НПЮЛ.НаимОрг;
		Шапка.Параметры.ЗаголовокИНН = НСтр("ru = 'ИНН / КПП:';
											|en = 'TIN / KPP:'");
		Шапка.Параметры.ИННОрганизации = НПЮЛ.ИННЮЛ;
		Шапка.Параметры.КППОрганизации = НПЮЛ.КПП;
		
	Иначе
		
		Если ЕстьСвойствоXDTO(СвНП, "НПИП") Тогда
			НП = СвНП.НПИП;
		Иначе
			НП = СвНП.НПФЛ;
		КонецЕсли;
			
		Шапка.Параметры.НаименованиеОрганизации  = ФИОИзТега(НП);
		Шапка.Параметры.ЗаголовокИНН = НСтр("ru = 'ИНН:';
											|en = 'TIN:'");
		Шапка.Параметры.ИННОрганизации = СвойствоXDTO(НП, "ИННФЛ");
		
	КонецЕсли;
	
КонецПроцедуры

