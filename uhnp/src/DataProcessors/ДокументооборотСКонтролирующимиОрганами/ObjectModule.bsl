	ДлинаПрефиксаОтчетОтклоненАльтернативно = СтрДлина(ПрефиксОтчетОтклоненАльтернативно);
	ПрефиксОтчетНеПринят = "Отчет не принят";
	ДлинаПрефиксаОтчетНеПринят = СтрДлина(ПрефиксОтчетНеПринят);
	ПрефиксОтчетНеПринятАльтернативно = "Отчёт не принят";
	ДлинаПрефиксаОтчетНеПринятАльтернативно = СтрДлина(ПрефиксОтчетНеПринятАльтернативно);
	ПрефиксОтчетНеУтвержден = "Отчет не утвержд";
	ДлинаПрефиксаОтчетНеУтвержден = СтрДлина(ПрефиксОтчетНеУтвержден);
	ПрефиксОтчетНеУтвержденАльтернативно = "Отчёт не утвержд";
	ДлинаПрефиксаОтчетНеУтвержденАльтернативно = СтрДлина(ПрефиксОтчетНеУтвержденАльтернативно);
	ПрефиксОтчетОтменен = "Отчет отмен";
	ДлинаПрефиксаОтчетОтменен = СтрДлина(ПрефиксОтчетОтменен);
