	ДлинаПрефиксаОтчетОтмененАльтернативно = СтрДлина(ПрефиксОтчетОтмененАльтернативно);
	ПрефиксОтчетУдален = "Отчет удал";
	ДлинаПрефиксаОтчетУдален = СтрДлина(ПрефиксОтчетУдален);
	ПрефиксОтчетУдаленАльтернативно = "Отчёт удал";
	ДлинаПрефиксаОтчетУдаленАльтернативно = СтрДлина(ПрефиксОтчетУдаленАльтернативно);
	ПрефиксЗаявкаУстарела = "Заявка устарела";
	ДлинаПрефиксаЗаявкаУстарела = СтрДлина(ПрефиксЗаявкаУстарела);
	ПрефиксЗаявкаНеПрошла = "Заявка не прошла";
	ДлинаПрефиксаЗаявкаНеПрошла = СтрДлина(ПрефиксЗаявкаНеПрошла);
	ПрефиксУтвержден = "Утвержд";
	ДлинаПрефиксаУтвержден = СтрДлина(ПрефиксУтвержден);
	ПрефиксПринят = "Принят";
	ДлинаПрефиксаПринят = СтрДлина(ПрефиксПринят);
	ПрефиксСдан = "Сдан";
	ДлинаПрефиксаСдан = СтрДлина(ПрефиксСдан);
	ПрефиксОтчетУтвержден = "Отчет утвержд";
	ДлинаПрефиксаОтчетУтвержден = СтрДлина(ПрефиксОтчетУтвержден);
	ПрефиксОтчетУтвержденАльтернативно = "Отчёт утвержд";
	ДлинаПрефиксаОтчетУтвержденАльтернативно = СтрДлина(ПрефиксОтчетУтвержденАльтернативно);
	ПрефиксОтчетПринят = "Отчет принят";
	ДлинаПрефиксаОтчетПринят = СтрДлина(ПрефиксОтчетПринят);
	ПрефиксОтчетПринятАльтернативно = "Отчёт принят";
	ДлинаПрефиксаОтчетПринятАльтернативно = СтрДлина(ПрефиксОтчетПринятАльтернативно);
	ПрефиксОтчетСдан = "Отчет сдан";
	ДлинаПрефиксаОтчетСдан = СтрДлина(ПрефиксОтчетСдан);
	ПрефиксОтчетСданАльтернативно = "Отчёт сдан";
	ДлинаПрефиксаОтчетСданАльтернативно = СтрДлина(ПрефиксОтчетСданАльтернативно);
	ПрефиксОтчетЗагруженВоФГИС = "Отчет загружен во ФГИС";
	ДлинаПрефиксаОтчетЗагруженВоФГИС = СтрДлина(ПрефиксОтчетЗагруженВоФГИС);
	ПрефиксОтчетЗагруженВоФГИСАльтернативно = "Отчёт загружен во ФГИС";
	ДлинаПрефиксаОтчетЗагруженВоФГИСАльтернативно = СтрДлина(ПрефиксОтчетЗагруженВоФГИСАльтернативно);
	ПрефиксОтчетСЭПЗагруженВоФГИС = "Отчет с ЭП принят и загружен во ФГИС";
	ДлинаПрефиксаОтчетСЭПЗагруженВоФГИС = СтрДлина(ПрефиксОтчетСЭПЗагруженВоФГИС);
	ПрефиксОтчетСЭПЗагруженВоФГИСАльтернативно = "Отчёт с ЭП принят и загружен во ФГИС";
	ДлинаПрефиксаОтчетСЭПЗагруженВоФГИСАльтернативно = СтрДлина(ПрефиксОтчетСЭПЗагруженВоФГИСАльтернативно);
	ПрефиксЗаявкаУтверждена = "Заявка утвержд";
	ДлинаПрефиксаЗаявкаУтверждена = СтрДлина(ПрефиксЗаявкаУтверждена);
	ПрефиксЗаявкаПринята = "Заявка принят";
	ДлинаПрефиксаЗаявкаПринята = СтрДлина(ПрефиксЗаявкаПринята);
	ПрефиксЗаявкаЗагружена = "Заявка загружен";
	ДлинаПрефиксаЗаявкаЗагружена = СтрДлина(ПрефиксЗаявкаЗагружена);
	
	Если Лев(СтрокаСостояния, ДлинаПрефиксаОшибка) = ПрефиксОшибка
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтклонен) = ПрефиксОтклонен
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаНеПринят) = ПрефиксНеПринят
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаНеСдан) = ПрефиксНеСдан
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаНеУтвержден) = ПрефиксНеУтвержден
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаНекорректный) = ПрефиксНекорректный
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтменен) = ПрефиксОтменен
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаУдален) = ПрефиксУдален
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетОтклонен) = ПрефиксОтчетОтклонен
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетОтклоненАльтернативно) = ПрефиксОтчетОтклоненАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетНеПринят) = ПрефиксОтчетНеПринят
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетНеПринятАльтернативно) = ПрефиксОтчетНеПринятАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетНеУтвержден) = ПрефиксОтчетНеУтвержден
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетНеУтвержденАльтернативно) = ПрефиксОтчетНеУтвержденАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетОтменен) = ПрефиксОтчетОтменен
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетОтмененАльтернативно) = ПрефиксОтчетОтмененАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетУдален) = ПрефиксОтчетУдален
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетУдаленАльтернативно) = ПрефиксОтчетУдаленАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаЗаявкаУстарела) = ПрефиксЗаявкаУстарела
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаЗаявкаНеПрошла) = ПрефиксЗаявкаНеПрошла Тогда
		
		Если ПройденаПроверкаНаПортале <> Истина Тогда
			ПройденаПроверкаНаПортале = Ложь;
		КонецЕсли;
		Возврат Ложь;
		
	ИначеЕсли (Лев(СтрокаСостояния, ДлинаПрефиксаУтвержден) = ПрефиксУтвержден
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаПринят) = ПрефиксПринят
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаСдан) = ПрефиксСдан
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетУтвержден) = ПрефиксОтчетУтвержден
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетУтвержденАльтернативно) = ПрефиксОтчетУтвержденАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетПринят) = ПрефиксОтчетПринят
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетПринятАльтернативно) = ПрефиксОтчетПринятАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетСдан) = ПрефиксОтчетСдан
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетСданАльтернативно) = ПрефиксОтчетСданАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетЗагруженВоФГИС) = ПрефиксОтчетЗагруженВоФГИС
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетЗагруженВоФГИСАльтернативно) = ПрефиксОтчетЗагруженВоФГИСАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетСЭПЗагруженВоФГИС) = ПрефиксОтчетСЭПЗагруженВоФГИС
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаОтчетСЭПЗагруженВоФГИСАльтернативно) = ПрефиксОтчетСЭПЗагруженВоФГИСАльтернативно
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаЗаявкаУтверждена) = ПрефиксЗаявкаУтверждена
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаЗаявкаПринята) = ПрефиксЗаявкаПринята
		ИЛИ Лев(СтрокаСостояния, ДлинаПрефиксаЗаявкаЗагружена) = ПрефиксЗаявкаЗагружена) И ПройденаПроверкаНаПортале = Истина Тогда
		
		Возврат Истина;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ОчиститьФорматированиеHTML(ТекстСообщения)
	
	Результат = ТекстСообщения;
	Результат = СтрЗаменить(Результат, "<b>", "");
	Результат = СтрЗаменить(Результат, "</b>", "");
	Результат = СтрЗаменить(Результат, "<B>", "");
	Результат = СтрЗаменить(Результат, "</B>", "");
	Результат = СтрЗаменить(Результат, "<i>", "");
	Результат = СтрЗаменить(Результат, "</i>", "");
	Результат = СтрЗаменить(Результат, "<I>", "");
	Результат = СтрЗаменить(Результат, "</I>", "");
	Результат = СтрЗаменить(Результат, "<br>", Символы.ВК + Символы.ПС);
	Результат = СтрЗаменить(Результат, "<BR>", Символы.ВК + Символы.ПС);
	Возврат Результат;
	
КонецФункции

Функция ЕстьВозможностьАвтонастройкиВУниверсальномФормате(Организация, ВернутьСвойстваОрганизацииИУчетнойЗаписи = Ложь) Экспорт
	
	Результат 						= Ложь;
	ВозможностьАвтонастройкиПоРОКИ 	= Ложь;
	ВозможностьАвтонастройки 		= Ложь;
	СвойстваОрганизации 			= Неопределено;
	СвойстваУчетнойЗаписи 			= Неопределено;
	Если Организация <> Неопределено И Организация <> Справочники.Организации.ПустаяСсылка() Тогда
		СвойстваОрганизации = ЗначенияРеквизитовОбъекта(Организация, "ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена");
		Если СвойстваОрганизации <> Неопределено
			И СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами =
				Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате
			И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена) Тогда
			
			Попытка
				СвойстваУчетнойЗаписи = ЗначенияРеквизитовОбъекта(СвойстваОрганизации.УчетнаяЗаписьОбмена,
					"СпецоператорСвязи, РежимАвтонастройки, ИдентификаторАбонента, СерверДокументооборота, ЭтоМультиРежим");
				
				Результат = СвойстваУчетнойЗаписи.СпецоператорСвязи <> Перечисления.СпецоператорыСвязи.Такском
					И СвойстваУчетнойЗаписи.СпецоператорСвязи <> Перечисления.СпецоператорыСвязи.Прочие
					И СвойстваУчетнойЗаписи.РежимАвтонастройки <> Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.Отключена;
				ВозможностьАвтонастройкиПоРОКИ = СвойстваУчетнойЗаписи.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.Такском
					И СвойстваУчетнойЗаписи.РежимАвтонастройки <> Перечисления.РежимыАвтонастройкиУчетнойЗаписиНалогоплательщика.Отключена;
				ВозможностьАвтонастройки = Результат ИЛИ ВозможностьАвтонастройкиПоРОКИ;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если ВернутьСвойстваОрганизацииИУчетнойЗаписи Тогда
		СвойстваОрганизацииИУчетнойЗаписи = Новый Структура;
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ЕстьВозможностьАвтонастройкиВУниверсальномФормате", Результат);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ЕстьВозможностьАвтонастройкиПоРОКИ", 				ВозможностьАвтонастройкиПоРОКИ);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ЕстьВозможностьАвтонастройки", 						ВозможностьАвтонастройки);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ВидОбменаСКонтролирующимиОрганами", 				Неопределено);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("УчетнаяЗаписьОбмена", 								Неопределено);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("СпецоператорСвязи", 								Неопределено);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("РежимАвтонастройки", 								Неопределено);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ИдентификаторАбонента", 							"");
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("СерверДокументооборота", 							Неопределено);
		СвойстваОрганизацииИУчетнойЗаписи.Вставить("ЭтоМультиРежим", 									Неопределено);
		
		Если СвойстваОрганизации <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СвойстваОрганизацииИУчетнойЗаписи, СвойстваОрганизации);
		КонецЕсли;
		Если СвойстваУчетнойЗаписи <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СвойстваОрганизацииИУчетнойЗаписи, СвойстваУчетнойЗаписи);
		КонецЕсли;
		
		Возврат СвойстваОрганизацииИУчетнойЗаписи;
		
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПараметрыИнтернета() Экспорт
	
	ПараметрыСервераИнтернета = Новый Структура("URLСервера, КаталогФайловНаСервере, ИмяКлючевогоФайлаНаСервере");
	ПараметрыСервераИнтернета.URLСервера = "downloads.1c.ru";
	ПараметрыСервераИнтернета.КаталогФайловНаСервере = "/RO_OnlineServices/XCHG_FNS";
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		ПараметрыСервераИнтернета.КаталогФайловНаСервере = ПараметрыСервераИнтернета.КаталогФайловНаСервере + "/Test"; 
	КонецЕсли;
	ПараметрыСервераИнтернета.ИмяКлючевогоФайлаНаСервере = "/infomap.dat";
	Возврат ПараметрыСервераИнтернета;
	
КонецФункции

Функция КнопкаОбновленияВЗаявленииНаПодключениеДоступна(Ссылка) Экспорт

	Отправлено = ЗначениеЗаполнено(Ссылка.Статус)
		И Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отправлено;
		
	ОдобреноНастройкаНЕЗавершена = 
		Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено


		И НЕ Ссылка.НастройкаЗавершена;
		
	ОтклоненоНастройкаНЕЗавершена = 
		Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Отклонено
		И НЕ Ссылка.НастройкаЗавершена;
		
	ОдобреноНастройкиЭДОНЕЗавершена = 
		Ссылка.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено
		И Ссылка.НастройкаЗавершена 
		И НЕ Ссылка.НастройкаЭДОЗавершена 
		И ЗначениеЗаполнено(Ссылка.НастройкиЭДО);
	
	КнопкаДоступна = 
		Отправлено 
		ИЛИ ОдобреноНастройкаНЕЗавершена 
		ИЛИ ОтклоненоНастройкаНЕЗавершена 
		ИЛИ ОдобреноНастройкиЭДОНЕЗавершена;
	
	Возврат КнопкаДоступна;
	
КонецФункции

Функция ПолучитьКодВидаДокументаФизическогоЛицаПредопределенного(Ссылка) Экспорт
	
	ИмяПредопределенного = Справочники.ВидыДокументовФизическихЛиц.ПолучитьИмяПредопределенного(Ссылка);
	
	Если ИмяПредопределенного = "ПаспортРФ" Тогда
		Возврат "21";
	ИначеЕсли ИмяПредопределенного = "ВодительскоеУдостоверение" Тогда
		Возврат "91";
	ИначеЕсли ИмяПредопределенного = "ВоенныйБилет" Тогда
		Возврат "07";
	ИначеЕсли ИмяПредопределенного = "ВоенныйБилетОфицераЗапаса" Тогда
		Возврат "27";
	ИначеЕсли ИмяПредопределенного = "ДипломатическийПаспорт" Тогда
		Возврат "09";
	ИначеЕсли ИмяПредопределенного = "ЗагранпаспортРФ" Тогда
		Возврат "22";
	ИначеЕсли ИмяПредопределенного = "ЗагранпаспортСССР" Тогда
		Возврат "02";
	ИначеЕсли ИмяПредопределенного = "ПаспортСССР" Тогда
		Возврат "01";
	ИначеЕсли ИмяПредопределенного = "ПаспортМинморфлота" Тогда
		Возврат "06";
	ИначеЕсли ИмяПредопределенного = "ПаспортМоряка" Тогда
		Возврат "26";
	ИначеЕсли ИмяПредопределенного = "СвидетельствоОРождении" Тогда
		Возврат "03";
	ИначеЕсли ИмяПредопределенного = "УдостоверениеОфицера" Тогда
		Возврат "04";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКодВидаДокументаФизическогоЛица(Знач ДокументФизическогоЛица) Экспорт
	
	Если ДокументФизическогоЛица = Перечисления.ВидыУдостоверенийВладельцаЭП.ПаспортРФ Тогда
		Возврат "21";
	ИначеЕсли ДокументФизическогоЛица = Перечисления.ВидыУдостоверенийВладельцаЭП.ИностранныйПаспорт Тогда
		Возврат "10";
	ИначеЕсли ДокументФизическогоЛица = Перечисления.ВидыУдостоверенийВладельцаЭП.ПустаяСсылка()
		ИЛИ НЕ ЗначениеЗаполнено(ДокументФизическогоЛица) Тогда
		Возврат "91";
	Иначе
	
		Если ДокументФизическогоЛица.Предопределенный Тогда
			КодИМНС = ПолучитьКодВидаДокументаФизическогоЛицаПредопределенного(ДокументФизическогоЛица);
			Если НЕ ПустаяСтрока(КодИМНС) Тогда
				Возврат КодИМНС;
			КонецЕсли;
		КонецЕсли;
		
		Макет = ПолучитьМакетОбработки("ВидыИКодыДокументовФизическихЛиц");
		СтрДокументФизическогоЛица = СокрЛП(ДокументФизическогоЛица);
		
		Для Инд = 1 По Макет.ВысотаТаблицы Цикл
			ТекРегион = СокрЛП(Макет.Область(Инд, 2, Инд, 2).Текст);
			
			Если НРег(ТекРегион) = НРег(СтрДокументФизическогоЛица) Тогда
				Возврат СокрЛП(Макет.Область(Инд, 1, Инд, 1).Текст);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗнч(ДокументФизическогоЛица) = Тип("СправочникСсылка.ВидыДокументовФизическихЛиц")
		И Метаданные.Справочники.ВидыДокументовФизическихЛиц.Реквизиты.Найти("КодМВД") <> Неопределено Тогда
		
		КодМВД = ДокументФизическогоЛица["КодМВД"];
		Если ЗначениеЗаполнено(КодМВД) Тогда
			Возврат КодМВД;
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат "91";
	
КонецФункции

Функция ЗначениеЗаполненоШумом(Знач Значение) Экспорт
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	БезРазделителей = ЗначениеБезРазделителей(Значение);
	ЗначениеЗаполненоШумом = ЗначениеЗаполнено(Значение) И НЕ ЗначениеЗаполнено(БезРазделителей);
	 
	Возврат ЗначениеЗаполненоШумом;
		
КонецФункции

Функция ЗначениеБезРазделителей(Знач Значение)
	
	УдаляемыеСимволы = ",.0-_д";
	
	Для Счетчик = 1 По СтрДлина(УдаляемыеСимволы) Цикл
		Символ = Сред(УдаляемыеСимволы, Счетчик, 1);
		Значение = СтрЗаменить(Значение, Символ, "");
	КонецЦикла;

	Возврат СокрЛП(Значение);

КонецФункции

Функция ОрганизацияПодключенаКИнспекции(СсылкаНаОбъект) Экспорт
	
	СведенияОбОбъекте 	= СведенияПоОтправляемымОбъектам(СсылкаНаОбъект);
	Организация 		= СведенияОбОбъекте.Организация;
	КодПолучателя 		= СведенияОбОбъекте.КодКонтролирующегоОргана;
	
	Подключена = ОрганизацияПодключенаКИнспекцииПоКодуИФНС(
		Организация,
		КодПолучателя);
	
	Возврат Подключена;
	
КонецФункции

Функция КППИзpackageDescription(Опись) Экспорт
	
	ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Опись);
	
	Если ЦиклОбмена = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена);
	СтрДокументНО  = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДокументНО));
	
	Если СообщенияЦикла.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// выгружаем контейнер во временный файл
	ИмяФайлаКонтейнера = ПолучитьИмяВременногоФайла();
	Контейнер = ПолучитьТранспортныйКонтейнер(СтрДокументНО[0].Ссылка, Истина);
	Если НЕ ЗначениеЗаполнено(Контейнер) ИЛИ Контейнер.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеКонтейнера = Контейнер[0].Данные.Получить();
	Если ДанныеКонтейнера = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеКонтейнера.Записать(ИмяФайлаКонтейнера);
	
	// распаковываем файл описания сведений архива
	ИмяФайлаОписанияСведений = "packageDescription.xml";
	Попытка
		ЧтениеЗИП = Новый ЧтениеZipФайла(ИмяФайлаКонтейнера);
	Исключение
	    Возврат "";
	КонецПопытки;
	
	ЭлементОписаниеСведений = ЧтениеЗИП.Элементы.Найти(ИмяФайлаОписанияСведений);
	Если ЭлементОписаниеСведений = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	КаталогРаспаковки = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	ЧтениеЗИП.Извлечь(ЭлементОписаниеСведений, КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	
	// читаем XML
	ИмяФайла = КаталогРаспаковки + ИмяФайлаОписанияСведений;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	XML = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Попытка
		Если ЕстьСвойство(XML, "ДопСв") Тогда
			Если ЕстьСвойство(XML.ДопСв, "Sfo") Тогда
				Для каждого Атрибут Из XML.ДопСв.Sfo.Attribute Цикл
					Если Атрибут.Name = "КППНП" Тогда
						Возврат Атрибут.Value;
					КонецЕсли
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция ОрганизацияПодключенаКИнспекцииПоКодуИФНС(Организация, КодИФНС, КПП = "") Экспорт
	
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Истина; 
	КонецЕсли;
	
	Если УчетнаяЗапись.СпецоператорСвязи <> Перечисления.СпецоператорыСвязи.КалугаАстрал Тогда
		// У других операторов нет файлов автонастройки и не заполняется данный регистр.
		Возврат Истина; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.ТипПолучателя КАК ТипПолучателя,
		|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КодПолучателя КАК КодПолучателя,
		|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КПП КАК КПП
		|ИЗ
		|	РегистрСведений.ДополнительныеРеквизитыУчетнойЗаписиПолучатели КАК ДополнительныеРеквизитыУчетнойЗаписиПолучатели
		|ГДЕ
		|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.УчетнаяЗапись = &УчетнаяЗапись
		|	И ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КодПолучателя = &КодПолучателя
		|	И (ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КПП = &КПП
		|			ИЛИ НЕ &ПроверятьКПП)
		|	И ДополнительныеРеквизитыУчетнойЗаписиПолучатели.ТипПолучателя = ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("КодПолучателя", КодИФНС);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("ПроверятьКПП", КПП <> "");
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ИФНСВходящейОписиПодключено(СообщениеОснование, Объект)
	
	ЦиклОбмена = СообщениеОснование.ЦиклОбмена;
	ИФНС = ЦиклОбмена.ВнешняяОрганизация;
	
	Подключена = ОрганизацияПодключенаКИнспекцииПоКодуИФНС(
		СообщениеОснование.ЦиклОбмена.Организация, 
		ИФНС.Код);
		
	Если Подключена Тогда
		
		Возврат Истина;
		
	Иначе
		
		КПП  = КППИзpackageDescription(ЦиклОбмена.Предмет);
			
		ТекстСообщения = НСтр("ru = 'Для отправки извещения в ФНС %1 необходимо подключить направление 1С-Отчетности ФНС %1 КПП %2.
		                       |Для этого отправьте заявление на добавление направления и дождитесь его одобрения.';
		                       |en = 'To send a notification to the Federal Tax Service %1, connect the direction of 1C Reporting FTS %1 KPP %2.
		                       |To do this, send an application for adding the direction and wait for its approval.'");
	
		ТекстСообщения = СтрШаблон(ТекстСообщения, ИФНС.Код, КПП);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Объект.ОшибкаЗаполнения = Истина;
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

#Область ВыгрузкаПакетаПоТребованию

Функция ПолучитьВыгружаемыеПакетыПоДокументооборотамСдачиОтчетностиВФНС(
		ЦиклыОбмена, 
		УникальныйИдентификатор, 
		ТолькоОценка = Ложь,
		ВключитьДополнительныеСведения = Ложь) Экспорт
		
	ТаблицаФайлов 				= ВыгрузкаОтчетовПоМестуТребования_Выборка(ЦиклыОбмена, ВключитьДополнительныеСведения);
	ТранспортныеСообщения 		= ВыгрузкаОтчетовПоМестуТребования_ТранспортныеСообщения(ТаблицаФайлов);
	ТаблицаПрисоединенныхФайлов = ВыгрузкаОтчетовПоМестуТребования_ТаблицаПрисоединенныхФайлов(ТранспортныеСообщения);
	
	ВыгрузкаОтчетовПоМестуТребования_ИзвлечьДвДанныеФайлов(ТаблицаФайлов, ТаблицаПрисоединенныхФайлов);
	
	Результат = Новый Соответствие;
	
	БазовыйКонтекст = Новый Структура();
	БазовыйКонтекст.Вставить("ТаблицаФайлов", 	  ТаблицаФайлов);
	БазовыйКонтекст.Вставить("ТолькоОценка", 	  ТолькоОценка);
	БазовыйКонтекст.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	БазовыйКонтекст.Вставить("ВключитьДополнительныеСведения", ВключитьДополнительныеСведения);
	
	Для Каждого ЦиклОбмена Из ЦиклыОбмена Цикл
		
		ЭтоОтчет = ТипЗнч(ЦиклОбмена.Предмет) <> Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика");
		
		ВходящийКонтекст = ОбщегоНазначения.СкопироватьРекурсивно(БазовыйКонтекст);
		ВходящийКонтекст.Вставить("Объектов", 		  0);
		ВходящийКонтекст.Вставить("ОбъектовВАрхиве",  0);
		ВходящийКонтекст.Вставить("ЦиклОбмена", 	  ЦиклОбмена);
		ВходящийКонтекст.Вставить("ВременныйКаталог", ОперацииСФайламиЭДКО.СоздатьВременныйКаталог());
		ВходящийКонтекст.Вставить("Представление",	  ПредставлениеЦиклаОбмена(ЦиклОбмена));
		ВходящийКонтекст.Вставить("ТекстОшибки", 	  "");
		
		Если ЭтоОтчет Тогда
			Успешно = ВыгрузкаОтчетовПоМестуТребования_Отчеты(ВходящийКонтекст);
		Иначе
			Успешно = ВыгрузкаОтчетовПоМестуТребования_ЗапросыНаСверку(ВходящийКонтекст);
		КонецЕсли;
			
		Если НЕ Успешно Тогда
			Результат.Вставить(ЦиклОбмена, ВходящийКонтекст.ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		Если ТолькоОценка Тогда
			Результат.Вставить(ЦиклОбмена, Новый Структура("Всего, ВАрхиве", ВходящийКонтекст.Объектов, ВходящийКонтекст.ОбъектовВАрхиве));
			Продолжить;
		КонецЕсли;
			
		ВыгрузкаОтчетовПоМестуТребования_СформироватьАрхив(ВходящийКонтекст);
		ВыгрузкаОтчетовПоМестуТребования_СохранитьРезультат(ВходящийКонтекст, Результат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторыВыгрузки()
	
	Идентификаторы = Новый Структура;
	
	Идентификаторы.Вставить("ИдентификаторОтчетность", "ОТЧЕТНОСТЬ");
	Идентификаторы.Вставить("ИдентификаторОтчетностьЭЦПНалогоплательщика", "ОТЧЕТНОСТЬ_ЭЦПНАЛОГОПЛАТЕЛЬЩИКА");
	Идентификаторы.Вставить("ИдентификаторКвитанцияОПриеме", "КВИТАНЦИЯОПРИЕМЕ");
	Идентификаторы.Вставить("ИдентификаторЭЦПНалоговогоОргана", "ЭЦПНАЛОГОВОГООРГАНА");
	Идентификаторы.Вставить("ИдентификаторРезультатаСверки", "РЕЗУЛЬТАТСВЕРКИ");
	Идентификаторы.Вставить("ИдентификаторИзвещениеОВВоде", "ИЗВЕЩЕНИЕОВВОДЕ");
	
	Возврат Идентификаторы;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_Выборка(
		ЦиклыОбмена, 
		ВключитьДополнительныеСведения) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип В (&ЭлектронноЦифроваяПодпись)
	                      |				И (ТранспортныеСообщения.Тип В (&РезультатПриемаДекларацияНО, &РезультатОбработкиЗапросНО)
	                      |					ИЛИ ТранспортныеСообщения.Тип = &РезультатОбработкиДекларацияНО
	                      |						И &ВключитьДополнительныеСведения)
	                      |				И НЕ СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента
	                      |			ТОГДА &ИдентификаторЭЦПНалоговогоОргана
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип В (&ЭлектронноЦифроваяПодпись)
	                      |				И ТранспортныеСообщения.Тип В (&ДекларацияНП)
	                      |				И СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента
	                      |			ТОГДА &ИдентификаторОтчетностьЭЦПНалогоплательщика
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип В (&ОтветНаЗапросИОН)
	                      |			ТОГДА &ИдентификаторРезультатаСверки
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип В (&КвитанцияОПриеме)
	                      |			ТОГДА &ИдентификаторКвитанцияОПриеме
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип В (&ТипыСодержимогоОтчетность)
	                      |				И ТранспортныеСообщения.Тип В (&ДекларацияНП)
	                      |			ТОГДА &ИдентификаторОтчетность
	                      |		КОГДА СодержимоеТранспортныхКонтейнеров.Тип = &ИзвещениеОВводе
	                      |				И &ВключитьДополнительныеСведения
	                      |			ТОГДА &ИдентификаторИзвещениеОВВоде
	                      |	КОНЕЦ КАК ИдентификаторТипа,
	                      |	СодержимоеТранспортныхКонтейнеров.ИмяФайла КАК ИмяФайла,
	                      |	СодержимоеТранспортныхКонтейнеров.Данные КАК Данные,
	                      |	СодержимоеТранспортныхКонтейнеров.Размер КАК Размер,
	                      |	СодержимоеТранспортныхКонтейнеров.ЭЦПИмяПодписанногоФайла КАК ЭЦПИмяПодписанногоФайла,
	                      |	ТранспортныеСообщения.Ссылка КАК ТранспортноеСообщение,
	                      |	ТранспортныеСообщения.ЦиклОбмена КАК ЦиклОбмена,
	                      |	ТранспортныеСообщения.ЦиклОбмена.Тип КАК ТипЦиклаОбмена,
	                      |	ВЫБОР
	                      |		КОГДА СостояниеОбъектов.Архивный ЕСТЬ NULL
	                      |			ТОГДА 0
	                      |		КОГДА СостояниеОбъектов.Архивный = ЛОЖЬ
	                      |			ТОГДА 0
	                      |		ИНАЧЕ 1
	                      |	КОНЕЦ КАК ВАрхиве
	                      |ИЗ
	                      |	РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТранспортныхКонтейнеров
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
	                      |		ПО СодержимоеТранспортныхКонтейнеров.ТранспортноеСообщение = ТранспортныеСообщения.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	                      |		ПО (СостояниеОбъектов.Объект = ТранспортныеСообщения.Ссылка)
	                      |			И (СостояниеОбъектов.ИмяФайла = СодержимоеТранспортныхКонтейнеров.ИмяФайла)
	                      |			И (СостояниеОбъектов.Владелец = ЗНАЧЕНИЕ(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
	                      |ГДЕ
	                      |	ТранспортныеСообщения.ЦиклОбмена В(&ЦиклыОбмена)
	                      |	И НЕ ТранспортныеСообщения.ПометкаУдаления
	                      |	И (СодержимоеТранспортныхКонтейнеров.Тип В (&ТипыСодержимогоОтчетность)
	                      |				И ТранспортныеСообщения.Тип В (&ДекларацияНП)
	                      |			ИЛИ СодержимоеТранспортныхКонтейнеров.Тип В (&ЭлектронноЦифроваяПодпись)
	                      |				И ТранспортныеСообщения.Тип В (&ДекларацияНП)
	                      |				И СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента
	                      |			ИЛИ СодержимоеТранспортныхКонтейнеров.Тип В (&КвитанцияОПриеме, &ОтветНаЗапросИОН)
	                      |			ИЛИ СодержимоеТранспортныхКонтейнеров.Тип = &ИзвещениеОВводе
	                      |				И &ВключитьДополнительныеСведения
	                      |			ИЛИ СодержимоеТранспортныхКонтейнеров.Тип В (&ЭлектронноЦифроваяПодпись)
	                      |				И (ТранспортныеСообщения.Тип В (&РезультатПриемаДекларацияНО, &РезультатОбработкиЗапросНО)
	                      |					ИЛИ ТранспортныеСообщения.Тип = &РезультатОбработкиДекларацияНО
	                      |						И &ВключитьДополнительныеСведения)
	                      |				И НЕ СодержимоеТранспортныхКонтейнеров.ЭЦПЭтоПодписьАбонента)");
	
	
	ОтветНаЗапросИОН = Новый Массив;
	ОтветНаЗапросИОН.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросИОН);
	ОтветНаЗапросИОН.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Ответ);
	
	Для каждого Идентификатор Из ИдентификаторыВыгрузки() Цикл
		Запрос.Параметры.Вставить(Идентификатор.Ключ, Идентификатор.Значение);
	КонецЦикла;  
	
	Запрос.УстановитьПараметр("ЦиклыОбмена", 					ЦиклыОбмена);
	Запрос.УстановитьПараметр("ОтветНаЗапросИОН", 				ОтветНаЗапросИОН);
	Запрос.УстановитьПараметр("ВключитьДополнительныеСведения", ВключитьДополнительныеСведения);
	
	Запрос.УстановитьПараметр("ТипыСодержимогоОтчетность", 	Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетности);
	Запрос.УстановитьПараметр("ЭлектронноЦифроваяПодпись", 	Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	Запрос.УстановитьПараметр("КвитанцияОПриеме", 			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриеме);
	Запрос.УстановитьПараметр("ИзвещениеОВводе", 			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОВводе);
	
	Запрос.УстановитьПараметр("РезультатПриемаДекларацияНО", 	Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО);
	Запрос.УстановитьПараметр("РезультатОбработкиДекларацияНО", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО);
	Запрос.УстановитьПараметр("РезультатОбработкиЗапросНО",  	Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО);
	Запрос.УстановитьПараметр("ДекларацияНП", 				 	Перечисления.ТипыТранспортныхСообщений.ДекларацияНП);

	ТаблицаФайлов = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаФайлов;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_ТранспортныеСообщения(ТаблицаФайлов) Экспорт
	
	ТранспортныеСообщения = Новый Массив;
	Для каждого СтрокаТаблицыФайлов Из ТаблицаФайлов Цикл
		Если ТранспортныеСообщения.Найти(СтрокаТаблицыФайлов.ТранспортноеСообщение) = Неопределено
			И СтрокаТаблицыФайлов.Данные.Получить() = Неопределено Тогда
			
			ТранспортныеСообщения.Добавить(СтрокаТаблицыФайлов.ТранспортноеСообщение);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТранспортныеСообщения;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_ТаблицаПрисоединенныхФайлов(ТранспортныеСообщения) Экспорт
	
	ТаблицаПрисоединенныхФайлов = Неопределено;
	Если ТранспортныеСообщения.Количество() > 0 Тогда
		ТаблицаПрисоединенныхФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортныеСообщения,
			"ТранспортноеСообщениеПрисоединенныеФайлы",
			,
			"ВладелецФайла, ИсходноеИмяФайла");
		
		Для каждого СтрокаТаблицы Из ТаблицаПрисоединенныхФайлов Цикл
			СтрокаТаблицы.ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицы.ИсходноеИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаПрисоединенныхФайлов;
	
КонецФункции

Процедура ВыгрузкаОтчетовПоМестуТребования_ИзвлечьДвДанныеФайлов(ТаблицаФайлов, ТаблицаПрисоединенныхФайлов) Экспорт
	
	Для каждого СтрокаТаблицыФайлов Из ТаблицаФайлов Цикл
		ДвоичныеДанныеФайла = СтрокаТаблицыФайлов.Данные.Получить();
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ИсходноеИмяФайла = ВРЕГ(СтрокаТаблицыФайлов.ИмяФайла);
			
			ПараметрыОтбора = Новый Структура("ВладелецФайла, ИсходноеИмяФайла",
				СтрокаТаблицыФайлов.ТранспортноеСообщение, ИсходноеИмяФайла);
			СтрокиТаблицы = ТаблицаПрисоединенныхФайлов.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиТаблицы.Количество() > 0 Тогда
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокиТаблицы[0].Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Если ДвоичныеДанныеФайла <> Неопределено Тогда
			СтрокаТаблицыФайлов.Данные = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(0));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция РезультатПоискаФайлов(ВходящийКонтекст, ТекстОшики, ИдентификаторТипа = Неопределено, ЭЦПИмяПодписанногоФайла = Неопределено)
	
	Отбор = Новый Структура();
	Отбор.Вставить("ЦиклОбмена", ВходящийКонтекст.ЦиклОбмена);
	Если ИдентификаторТипа <> Неопределено Тогда
		Отбор.Вставить("ИдентификаторТипа", ИдентификаторТипа);
	КонецЕсли;
	
	Если ЭЦПИмяПодписанногоФайла <> Неопределено Тогда
		Отбор.Вставить("ЭЦПИмяПодписанногоФайла", ЭЦПИмяПодписанногоФайла);
	КонецЕсли;
	
	РезультатПоиска = ВходящийКонтекст.ТаблицаФайлов.НайтиСтроки(Отбор);
		
	Если РезультатПоиска.Количество() = 0 Тогда
		ВходящийКонтекст.ТекстОшибки = ТекстОшики;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатПоиска;
	
КонецФункции

Процедура ИнкрементироватьОбъект(Строка, ВходящийКонтекст)
	
	ВходящийКонтекст.Объектов = ВходящийКонтекст.Объектов + 1;
	Если Строка.ВАрхиве > 0 Тогда
		ВходящийКонтекст.ОбъектовВАрхиве = ВходящийКонтекст.ОбъектовВАрхиве + 1;
	КонецЕсли;
	
КонецПроцедуры

Функция СтрокаВыгрузки(ВходящийКонтекст, ТекстОшики, ИдентификаторТипа = Неопределено, ЭЦПИмяПодписанногоФайла = Неопределено)

	РезультатПоиска = РезультатПоискаФайлов(
		ВходящийКонтекст, 
		ТекстОшики,  
		ИдентификаторТипа,
		ЭЦПИмяПодписанногоФайла);
		
	Если РезультатПоиска = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрВыгрузки = РезультатПоиска[0];
	ИнкрементироватьОбъект(СтрВыгрузки, ВходящийКонтекст);
	
	Возврат СтрВыгрузки;

КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_Отчеты(ВходящийКонтекст) Экспорт
	
	ВыгруженОтчет = ВыгрузкаОтчетовПоМестуТребования_Отчеты_Отчет(ВходящийКонтекст);
	Если НЕ ВыгруженОтчет Тогда
		Возврат Ложь; 
	КонецЕсли;
	
	ВыгруженаЭП   		= ВыгрузкаОтчетовПоМестуТребования_Отчеты_ПодписьФНСПодОтчетом(ВходящийКонтекст);
	ВыгруженаКвитанция 	= ВыгрузкаОтчетовПоМестуТребования_Отчеты_КвитанцияОПриеме(ВходящийКонтекст);
	ВыгруженоИзвещение 	= ВыгрузкаОтчетовПоМестуТребования_Отчеты_ИзвещениеОВводе(ВходящийКонтекст);
	
	Выгружено = ВыгруженОтчет И ВыгруженаЭП И ВыгруженаКвитанция И ВыгруженоИзвещение;
	
	Возврат Выгружено;
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_Отчеты_ИзвещениеОВводе(ВходящийКонтекст) Экспорт
	
	ЦиклОбмена 		   = ВходящийКонтекст.ЦиклОбмена;
	ТолькоОценка	   = ВходящийКонтекст.ТолькоОценка;
	ВременныйКаталог   = ВходящийКонтекст.ВременныйКаталог;
	ИмяФайлаОтчетности = ВходящийКонтекст.ИмяФайлаОтчетности;
	Представление      = ВходящийКонтекст.Представление;
	
	Если НЕ ВходящийКонтекст.ВключитьДополнительныеСведения Тогда
		Возврат Истина;
	КонецЕсли;
		
	// Извещение о вводе
	СтрИзвещенияОВводе = СтрокаВыгрузки(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует извещение о вводе.", 
		ИдентификаторыВыгрузки().ИдентификаторИзвещениеОВВоде);
	
	Если СтрИзвещенияОВводе <> Неопределено Тогда
			
		ИмяИзвещенияОВводе = СтрИзвещенияОВводе.ИмяФайла;
		
		// Подпись ФНС под извещением о вводе
		СтрПодписьФНСПодИзвещениемОВводе = СтрокаВыгрузки(
			ВходящийКонтекст, 
			"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует подпись налогового органа под извещением о вводе.",
			ИдентификаторыВыгрузки().ИдентификаторЭЦПНалоговогоОргана, 
			ИмяИзвещенияОВводе);
			
		Если НЕ ТолькоОценка И СтрПодписьФНСПодИзвещениемОВводе <> Неопределено Тогда
			ВыгрузитьПечатнуюФормуИзвещенияОВводе(ВходящийКонтекст, СтрИзвещенияОВводе, СтрПодписьФНСПодИзвещениемОВводе);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТолькоОценка Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Если СтрИзвещенияОВводе = Неопределено ИЛИ СтрПодписьФНСПодИзвещениемОВводе = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// выгружаем файлы
	Попытка
	
		СтрИзвещенияОВводе.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".IV.xml");
		СтрПодписьФНСПодИзвещениемОВводе.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".IV.p7s");
		
	Исключение
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
		ВходящийКонтекст.ТекстОшибки = СтрСообщение;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Процедура ВыгрузитьПечатнуюФормуИзвещенияОВводе(ВходящийКонтекст, ДанныеФайла, ДанныеПодписи) Экспорт
	
	ВременныйКаталог   = ВходящийКонтекст.ВременныйКаталог;
	ИмяФайлаОтчетности = ВходящийКонтекст.ИмяФайлаОтчетности;
	Представление      = ВходящийКонтекст.Представление;
		
	ДвДанные            = ДанныеФайла.Данные.Получить();
	ДвДанныеПодписи     = ДанныеПодписи.Данные.Получить();
	СтрокаBase64        = Base64Строка(ДвДанные);
	Тело                = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрокаBase64, "windows-1251");
	Свойства            = ПолучитьОсновныеСвойстваИзИзвещенияОВводе(Тело);
	
	Если Свойства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент = ТабДокументИзвещенияОВводе(Свойства);
	
	ДобавитьПодпись(ДанныеФайла.ТранспортноеСообщение, ТабДокумент, ДвДанныеПодписи, Ложь);
	
	ТабДокумент.Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".IV.pdf" , ТипФайлаТабличногоДокумента.PDF);
	
КонецПроцедуры

Процедура ВыгрузитьПечатнуюФормуКвитанцииОПриеме(ВходящийКонтекст, ДанныеФайла, ДанныеПодписи) Экспорт
	
	ВременныйКаталог   = ВходящийКонтекст.ВременныйКаталог;
	ИмяФайлаОтчетности = ВходящийКонтекст.ИмяФайлаОтчетности;
	Представление      = ВходящийКонтекст.Представление;
		
	ДвДанные            = ДанныеФайла.Данные.Получить();
	ДвДанныеПодписи     = ДанныеПодписи.Данные.Получить();
	СтрокаBase64        = Base64Строка(ДвДанные);
	Тело                = ПрочитатьТекстИзФайлаСтрокойBase64Сервер(СтрокаBase64, "windows-1251");
	Свойства			= ПолучитьОсновныеСвойстваИзКвитанцииОПриемеНалоговойДекларации(Тело);
	
	Если Свойства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент = ТабДокументКвитанцияОПриеме(Свойства);
	
	ДобавитьПодпись(ДанныеФайла.ТранспортноеСообщение, ТабДокумент, ДвДанныеПодписи, Ложь);
	
	ТабДокумент.Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".KV.pdf" , ТипФайлаТабличногоДокумента.PDF);
	
КонецПроцедуры

Функция ПолучитьОсновныеСвойстваИзКвитанцииОПриемеНалоговойДекларации(СтрКвитанция) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтрКвитанция) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// создаем дерево на основе строки XML
	ОписаниеОшибки = "";
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений( , СтрКвитанция, ОписаниеОшибки);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка разбора XML квитанции о приеме:%1';
																						|en = 'An error occurred while parsing XML notice of acceptance:%1'"),
			Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелФайл = ДеревоXML.Строки.Найти("Файл", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелФайл) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""Файл"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""File"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелДокумент = УзелФайл.Строки.Найти("Документ", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""Документ"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""Document"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	УзелСвКвит = УзелДокумент.Строки.Найти("СвКвит", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвКвит) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции о приеме: не обнаружен узел ""СвКвит"".';
								|en = 'Incorrect structure of XML notice of acceptance: the ""СвКвит"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// разбираем узел с общими сведениями
	ОбщиеСведения = Новый Структура;
	Для Каждого УзелОбщСвед Из УзелСвКвит.Строки Цикл
		ОбщиеСведения.Вставить(УзелОбщСвед.Имя, СокрЛП(УзелОбщСвед.Значение));
	КонецЦикла;
	
	Если ОбщиеСведения.Свойство("ДатаПредст") И ОбщиеСведения.Свойство("ВремПредст") Тогда
		ОбщиеСведения.Вставить("ДатаВремяПредст", ОбщиеСведения.ДатаПредст + " " + ОбщиеСведения.ВремПредст);
	КонецЕсли;
	Если ОбщиеСведения.Свойство("Период") И ОбщиеСведения.Свойство("ПериодНаим") Тогда
		ОбщиеСведения.Вставить("ОтчетПериод", ОбщиеСведения.Период + " (" + ОбщиеСведения.ПериодНаим + ")");
	КонецЕсли;
	
	// разбираем сведения о налоговом органе который подтвердил получение отчетности
	НалОргПодт = СокрЛП(УзелДокумент.Строки.Найти("НаимНОПодт", "Имя").Значение);
	КодНалОргПодт = СокрЛП(УзелДокумент.Строки.Найти("КодНОПодт", "Имя").Значение);
	
	Если НалОргПодт <> КодНалОргПодт Тогда
		НалОргПодт = КодНалОргПодт + " (" + НалОргПодт + ")";
	КонецЕсли;
	
	// разбираем сведения о налоговом органе в который поступила отчетность
	УзелСвНалОргПост = УзелДокумент.Строки.Найти("СвНалОргПост", "Имя");
	Если НЕ ЗначениеЗаполнено(УзелСвНалОргПост) Тогда
		ТекстСообщения = НСтр("ru = 'Некорректная структура XML квитанции: не обнаружен узел ""СвНалОргПост"".';
								|en = 'Incorrect structure of XML receipt: the ""СвНалОргПост"" node is not found.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
	НалоговыйОрганПост = "";
	
	УзелКодНО = УзелСвНалОргПост.Строки.Найти("КодНО", "Имя");
	Если ЗначениеЗаполнено(УзелКодНО) Тогда
		НалоговыйОрганПост = СокрЛП(УзелКодНО.Значение);
	КонецЕсли;
	
	УзелНаимНО = УзелСвНалОргПост.Строки.Найти("НаимНО", "Имя");
	Если ЗначениеЗаполнено(УзелНаимНО) Тогда
		Если ЗначениеЗаполнено(НалоговыйОрганПост) Тогда
			НаименованиеНО = СокрЛП(УзелНаимНО.Значение);
			Если НалоговыйОрганПост <> НаименованиеНО Тогда
				НалоговыйОрганПост = НалоговыйОрганПост + " (" + НаименованиеНО + ")";
			КонецЕсли;
		Иначе
			НалоговыйОрганПост = СокрЛП(УзелНаимНО.Значение);
		КонецЕсли;
	КонецЕсли;
	
	// Сведения об отправителе отчетности
	ПредставлениеОтпр = "";
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвОтпр", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("ОтпрЮЛ", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("ОтпрФЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеОтпр = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	// Сведения о налогоплательщике
	ПредставлениеНП = ""; 	
	ДанныеОтправителя = УзелДокумент.Строки.Найти("СвНП", "Имя");
	ОтпрФЛ = ДанныеОтправителя.Строки.Найти("НПФЛ", "Имя");
	ОтпрЮЛ = ДанныеОтправителя.Строки.Найти("НПЮЛ", "Имя");
	
	Если ЗначениеЗаполнено(ОтпрФЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Ложь,ОтпрФЛ);
	ИначеЕсли ЗначениеЗаполнено(ОтпрЮЛ) Тогда
		ПредставлениеНП = ПолучитьПредставлениеНП(Истина,ОтпрЮЛ);
	КонецЕсли;
	
	Возврат Новый Структура("НалоговыйОрганПодтверждающий, НалоговыйОрганПолучатель, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр", НалОргПодт, НалоговыйОрганПост, ОбщиеСведения, ПредставлениеНП, ПредставлениеОтпр);
	
КонецФункции

Функция ДобавитьПодпись(ТранспортноеСообщение, ТабДокумент, ДвДанныеПодписи, ЭЦПЭтоПодписьАбонента)
	
	Свойства = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СвойстваПодписиДляШтампа();
	Свойства.ДвДанные = ДвДанныеПодписи;
	ЗаполнитьСвойстваПодписиДляШтампа(ТранспортноеСообщение, ЭЦПЭтоПодписьАбонента, Свойства); 
	
	ДвДанныеФайлаПодписи = Новый Массив;
	ДвДанныеФайлаПодписи.Добавить(Свойства);
		
	ДобавитьШтампПодписи(ДвДанныеФайлаПодписи, ТабДокумент, 2, Ложь);
	
КонецФункции

Функция ВыгрузкаОтчетовПоМестуТребования_Отчеты_КвитанцияОПриеме(ВходящийКонтекст) Экспорт
		
	ЦиклОбмена 		   = ВходящийКонтекст.ЦиклОбмена;
	ТолькоОценка	   = ВходящийКонтекст.ТолькоОценка;
	ВременныйКаталог   = ВходящийКонтекст.ВременныйКаталог;
	ИмяФайлаОтчетности = ВходящийКонтекст.ИмяФайлаОтчетности;
	Представление      = ВходящийКонтекст.Представление;
	
	// Квитанция о приеме
	СтрКвитанцияОПриеме = СтрокаВыгрузки(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует квитанция о приеме.", 
		ИдентификаторыВыгрузки().ИдентификаторКвитанцияОПриеме);
	
	Если СтрКвитанцияОПриеме = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяФайлаКвитанции = СтрКвитанцияОПриеме.ИмяФайла;
	
	// Подпись ФНС под квитанцией о приеме
	СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме = СтрокаВыгрузки(
		ВходящийКонтекст, 
		"Выгрузка пакета по циклу обмена """ + Представление + """ прервана: отсутствует подпись налогового органа под квитанцией о приеме.",
		ИдентификаторыВыгрузки().ИдентификаторЭЦПНалоговогоОргана, 
		ИмяФайлаКвитанции);
		
	Если НЕ ТолькоОценка И ВходящийКонтекст.ВключитьДополнительныеСведения Тогда
		ВыгрузитьПечатнуюФормуКвитанцииОПриеме(ВходящийКонтекст, СтрКвитанцияОПриеме, СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме);
	КонецЕсли;
		
	Если СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТолькоОценка Тогда 
		Возврат Истина;
	КонецЕсли;
	
	// выгружаем файлы
	Попытка
	
		СтрКвитанцияОПриеме.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".KV.xml");
		СтрЭЦПНалоговогоОрганаПодКвитанциейОПриеме.Данные.Получить().Записать(ВременныйКаталог + ИмяФайлаОтчетности + ".KV.p7s");
		
	Исключение
		СтрСообщение = "Выгрузка пакета по циклу обмена """ + Представление + """ прервана: не удалось сохранить файлы пакета во временный каталог (" + ИнформацияОбОшибке().Описание + ").";
		ВходящийКонтекст.ТекстОшибки = СтрСообщение;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

