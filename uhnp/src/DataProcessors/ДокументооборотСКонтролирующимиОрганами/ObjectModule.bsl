Процедура УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьУзелXML_Документ(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ДокументПодтверждающийПолномочия");
	
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Наименование", СокрЛП(Уведомление.НаименованиеДокумента));
	ЗаписатьУзелXML(ЗаписьXML, "Номер", СокрЛП(Уведомление.НомерДокумента));
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:КемВыдан", СокрЛП(Уведомление.КемВыдан));
	ЗаписатьУзелXML(ЗаписьXML, "ДатаНачалаДействия", СокрЛП(Уведомление.ДатаНачалаДействия), Истина);
	ЗаписатьУзелXML(ЗаписьXML, "ДатаОкончанияДействия", СокрЛП(Уведомление.ДатаОкончанияДействия), Истина);

	ЗаписьXML.ЗаписатьКонецЭлемента(); // ДокументПодтверждающийПолномочия
	
