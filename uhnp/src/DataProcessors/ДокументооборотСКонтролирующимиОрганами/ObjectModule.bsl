Функция ВыбраныВсеНаправления(Направления)
	
	Поддерживаемые = КоличествоВыбраныхОрганов(Направления, ,Истина);
	Подключенные   = КоличествоВыбраныхОрганов(Направления, Истина,);
	ПодключенныеИПоддерживаемые = КоличествоВыбраныхОрганов(Направления, Истина, Истина);
	
	Возврат Поддерживаемые = Подключенные И Подключенные = ПодключенныеИПоддерживаемые;
	
