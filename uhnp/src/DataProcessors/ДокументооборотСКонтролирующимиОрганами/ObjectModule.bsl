		СтрКому = ОбъектСообщение.Кому.Получить(0);
		АдресTo = ПочтовоеСообщение.Получатели.Добавить(СокрЛП(СтрКому.АдресЭлектроннойПочты));
		АдресTo.ОтображаемоеИмя = СокрЛП(СтрКому.Представление);
		
		// инициализируем адреса reply-to
		АдресReplyTo = ПочтовоеСообщение.ОбратныйАдрес.Добавить(СокрЛП(ОбъектСообщение.ОтКогоАдрес));
		АдресReplyTo.ОтображаемоеИмя = СокрЛП(ОбъектСообщение.ОтКогоПредставление);
		
		// инициализируем адреса from
