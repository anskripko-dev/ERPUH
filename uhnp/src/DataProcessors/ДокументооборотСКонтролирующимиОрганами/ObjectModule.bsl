Процедура НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(ИмяФайла, Организация, ДатаОкончанияПериода, КодНО) Экспорт
	
	РасширениеСТочкой = нрег(Прав(ИмяФайла, 4));
	
	Если РасширениеСТочкой = ".xml" Тогда
		Возврат;
	КонецЕсли;
	
	Если РасширениеСТочкой = ".txt" Тогда
		ВхождениеТочки = СтрНайти(ИмяФайла, ".");
		ВхождениеСчетчика = ВхождениеТочки - 8;
		Если ВхождениеТочки <> 0 Тогда
			СчетчикФайлов = РегламентированнаяОтчетность.ПолучитьСчетчикВыгруженныхФайлов(Организация, , ДатаОкончанияПериода, КодНО);
			ИмяФайла = Лев(ИмяФайла, ВхождениеСчетчика - 1) + Формат(СчетчикФайлов, "ЧЦ=8; ЧН=; ЧВН=; ЧГ=") + ".txt";
			РегламентированнаяОтчетностьВызовСервера.УстановитьСчетчикВыгруженныхФайлов(Организация, СчетчикФайлов, , ДатаОкончанияПериода, КодНО);
		КонецЕсли;
	Иначе
		ВхождениеТочки = СтрНайти(ИмяФайла, ".");
		Если ВхождениеТочки <> 0 Тогда
			ИмяФайла = Лев(ИмяФайла, ВхождениеТочки - 1);
		КонецЕсли;
		СчетчикФайлов = РегламентированнаяОтчетность.ПолучитьСчетчикВыгруженныхФайлов(Организация, , ДатаОкончанияПериода, КодНО);
		ИмяФайла = ИмяФайла + "." + Формат(СчетчикФайлов, "ЧЦ=3; ЧН=; ЧВН=; ЧГ=");
		РегламентированнаяОтчетностьВызовСервера.УстановитьСчетчикВыгруженныхФайлов(Организация, СчетчикФайлов, , ДатаОкончанияПериода, КодНО);
	КонецЕсли;
	
КонецПроцедуры

Функция ВыгрузитьДоверенностьИНараститьСчетчикФайловПриНеобходимости(Контекст) Экспорт
	
	АдресФайлаДоверенности = Неопределено;
	КороткоеИмяФайлаДоверенности = Неопределено;
	ИмяФайлаВыгрузкиБылоИзменено = Ложь;
	
	// определяем КПП по которому искать регистрацию в ИФНС
	Если Контекст.ТипОтправляемогоДокумента = "РегламентированныйОтчет" Тогда
		КППДляПоиска = КППРегламентированногоОтчета(Контекст.Документ);
		
	Иначе
		ИмяФайлаВыгрузки = ВРЕГ(Контекст.ИмяФайлаВыгрузки);
		КомпонентыИмени = Неопределено;
		Если Лев(ИмяФайлаВыгрузки, 9) = "NO_NDFL2_" ИЛИ Лев(ИмяФайлаВыгрузки, 12) = "SR_ZPRUMNAL_" Тогда
			КомпонентыИмени = РазложитьСтрокуВМассивПодстрок(ИмяФайлаВыгрузки, "_");
		КонецЕсли;
		
		Если КомпонентыИмени <> Неопределено И КомпонентыИмени.Количество() >= 5
			И СтрДлина(КомпонентыИмени[4]) = 19 Тогда
			КППДляПоиска = Сред(КомпонентыИмени[4], 11);
		Иначе
			КППДляПоиска = "";
		КонецЕсли;
	КонецЕсли;
	
	ПредусмотренаОтправкаПоДоверенности =
		Контекст.ВидОтправляемогоОтчета <> "МашиночитаемыеДоверенностиФНС";
	Если ПредусмотренаОтправкаПоДоверенности Тогда
		// ищем РегистрацияВИФНС по организации и коду налогового органа, а для регл. отчета еще по КПП
		ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(
			Контекст.Организация,
			Контекст.КодНалоговогоОргана,
			КППДляПоиска);
		Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
			
			// определяем доверенность
			ДанныеРегистрации = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС);
			ДоверенностьПредставителя = ДанныеРегистрации.Доверенность;
			Если ЗначениеЗаполнено(ДоверенностьПредставителя) Тогда
				
				ЭтоЗаявлениеОВвозеТоваров = (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 11)) = "ON_ZVLRPOK_");
				ЭтоАвансыНДФЛ = (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 12)) = "SR_ZPRUMNAL_");
				ЭтоСведенияОДоходахДляСоцВыплат = (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 12)) = "ON_SVDOXSOC_");
				ЭтоБалансФинОтчетности = (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 10)) = "NO_BOKRO1_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 10)) = "NO_BOKRO1_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 10)) = "NO_BOKRO2_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 10)) = "NO_BOKRO3_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 10)) = "NO_BOBUDG_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 11)) = "NO_BONKFO1_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 11)) = "NO_BONKFO2_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 11)) = "NO_BONKFO3_")
					ИЛИ (ВРег(Лев(Контекст.ИмяФайлаВыгрузки, 11)) = "NO_BONKFO4_");
				СвойстваФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Контекст.ИмяФайлаВыгрузки);
				ЭтоДокументБезНомераМЧД = ВРЕГ(СвойстваФайла.Расширение) = ВРЕГ(".txt");
				Если ЭтоЗаявлениеОВвозеТоваров ИЛИ ЭтоАвансыНДФЛ ИЛИ ЭтоСведенияОДоходахДляСоцВыплат
					ИЛИ ЭтоБалансФинОтчетности Тогда
					
					ТекстВыгрузки = "";
					Если Контекст.Свойство("ТекстВыгрузки") И ТипЗнч(Контекст.ТекстВыгрузки) = Тип("Строка") Тогда
						Если ЭтоАдресВременногоХранилища(Контекст.ТекстВыгрузки) Тогда
							ДанныеВыгрузки = ПолучитьИзВременногоХранилища(Контекст.ТекстВыгрузки);
							ТекстВыгрузки = ПолучитьСтрокуИзДвоичныхДанных(ДанныеВыгрузки, "windows-1251");
						Иначе
							ТекстВыгрузки = Контекст.ТекстВыгрузки;
						КонецЕсли;
					КонецЕсли;
					Если ЭтоЗаявлениеОВвозеТоваров Тогда
						ЭтоДокументБезНомераМЧД =
							(СтрНайти(ТекстВыгрузки, " НаимДов=""" + ДанныеРегистрации.ДокументПредставителя + """") = 0
							И СтрНайти(ТекстВыгрузки, " НомерДов=""" + ДанныеРегистрации.ДокументПредставителя + """") = 0)
							ИЛИ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.ИСоП для заяв.о вв.", Истина);
					ИначеЕсли ЭтоАвансыНДФЛ ИЛИ ЭтоСведенияОДоходахДляСоцВыплат ИЛИ ЭтоБалансФинОтчетности Тогда
						ЭтоДокументБезНомераМЧД =
							СтрНайти(ТекстВыгрузки, " НаимДок=""" + ДанныеРегистрации.ДокументПредставителя + """") = 0;
					КонецЕсли;
				КонецЕсли;
				
				// формируем файл доверенности
				ИгнорироватьПризнакКрупнейшегоНалогоплательщика = ИгнорироватьНалоговыйОрганПосредника(Контекст.ИмяФайлаВыгрузки);
				ФайлДоверенности = ВыгрузитьДоверенностьПредставление(
					ЭлРегистрацияВИФНС,
					КороткоеИмяФайлаДоверенности,
					Контекст.Организация,,
					ИгнорироватьПризнакКрупнейшегоНалогоплательщика,
					НЕ ЭтоДокументБезНомераМЧД);
				
				Если НЕ ЗначениеЗаполнено(ФайлДоверенности) Тогда
					Возврат Ложь;
				ИначеЕсли ФайлДоверенности = "ИсключеноПриложениеДоверенности" Тогда
					ФайлДоверенности = Неопределено;
				КонецЕсли;
				
				// помещаем файл доверенности во временное хранилище
				Если ЗначениеЗаполнено(ФайлДоверенности) Тогда
					АдресФайлаДоверенности = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлДоверенности),
						Контекст.УникальныйИдентификатор);
				КонецЕсли;
				
				// получаем реквизиты доверенности
				// если представитель ЮЛ или [ФЛ и не сотрудник организации], то подменяем имя файла
				ИмяТипаСправочникаМашиночитаемыеДоверенности = ?(ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует(),
					"МашиночитаемыеДоверенности", "");
				ЯвляетсяСотрудникомОрганизацииПоМЧД = Неопределено;
				Если ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
					ИЛИ ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
					ИЛИ ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности) И ТипЗнч(ДоверенностьПредставителя) =
						Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
					
					РеквизитыДоверенности = ДокументооборотСКОВызовСервера.ЗначенияРеквизитовМЧД(ДоверенностьПредставителя,
						"ДоверительЮЛ_ИНН, ДоверительЮЛ_КПП, ДоверительФЛ_ИНН, Представитель, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, "
						+ "ПредставительФЛ_ИНН, ПредставительФЛ_ОГРН, ФИО, ВерсияФормата, КоличествоПредставителей, Представители, "
						+ "ПредставительЯвляетсяСотрудником");
					Если РеквизитыДоверенности = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					ЭтоВерсия5_02 = ЗначениеЗаполнено(РеквизитыДоверенности.ВерсияФормата)
						И ОбщегоНазначенияКлиентСервер.СравнитьВерсии(РеквизитыДоверенности.ВерсияФормата + ".0.0", "5.02.0.0") >= 0;
					ПредставительЗаданСтрокойФИО = (ЗначениеЗаполнено(РеквизитыДоверенности.Представитель)
						И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
						И ТипЗнч(РеквизитыДоверенности.Представитель) = Тип("Строка"));
					Если ПредставительЗаданСтрокойФИО И НЕ ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности)
						ИЛИ ТипЗнч(ДоверенностьПредставителя) <>
						Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
						
						СтрокиФИО = РеквизитыДоверенности.ФИО.Выгрузить().НайтиСтроки(Новый Структура("Владелец",
							Перечисления.СубъектыДоверенностиНалогоплательщика.ПредставительФЛ));
						ПредставительЗаданСтрокойФИО = ?(СтрокиФИО.Количество() <> 0,
							РеквизитыДоверенности.Представитель = ДокументооборотСКОКлиентСервер.ПолучитьПредставлениеФИО(СтрокиФИО[0]),
							Ложь); // сотрудник ИП, если "ПредставительЯвляетсяСотрудником" не поддерживается
					КонецЕсли;
					
					ТекстСообщения = ДокументооборотСКОВызовСервера.УточнитьРеквизитыПредставителяМЧДФНС(РеквизитыДоверенности,
						ДоверенностьПредставителя, ДанныеРегистрации);
					Если ЗначениеЗаполнено(ТекстСообщения) Тогда
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
						Возврат Ложь;
					КонецЕсли;
					
					ЯвляетсяСотрудникомОрганизацииПоМЧД =
						?(ТипЗнч(ДоверенностьПредставителя) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
								ИЛИ ЭтоВерсия5_02, РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
								И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН), Ложь)
							ИЛИ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
								И ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_КПП)
								И РеквизитыДоверенности.ДоверительЮЛ_ИНН = РеквизитыДоверенности.ПредставительЮЛ_ИНН
								И РеквизитыДоверенности.ДоверительЮЛ_КПП = РеквизитыДоверенности.ПредставительЮЛ_КПП
							ИЛИ ПредставительЗаданСтрокойФИО;
					РеквизитыДоверенности = Новый Структура("ПредставительЯвляетсяЮЛ, ПредставительЯвляетсяСотрудником, "
						+ "ДоверительЮЛ_ИНН, ДоверительЮЛ_КПП, ДоверительФЛ_ИНН, "
						+ "ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, ПредставительФЛ_ИНН",
						ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН),
						ЯвляетсяСотрудникомОрганизацииПоМЧД
							ИЛИ НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН)
								И НЕ ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительФЛ_ОГРН),
						РеквизитыДоверенности.ДоверительЮЛ_ИНН,
						РеквизитыДоверенности.ДоверительЮЛ_КПП,
						РеквизитыДоверенности.ДоверительФЛ_ИНН,
						РеквизитыДоверенности.ПредставительЮЛ_ИНН,
						РеквизитыДоверенности.ПредставительЮЛ_КПП,
						РеквизитыДоверенности.ПредставительФЛ_ИНН);
					
				Иначе
					РеквизитыДоверенности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоверенностьПредставителя,
						"ПредставительЯвляетсяЮЛ, ПредставительЯвляетсяСотрудником, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, "
						+ "ПредставительФЛ_ИНН");
				КонецЕсли;
				
				Если РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
					ИЛИ (НЕ РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
						И (НЕ РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
							ИЛИ (ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
								И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица")))) Тогда
					
					ИспользоватьРеквизитыДоверителя = НЕ РеквизитыДоверенности.ПредставительЯвляетсяЮЛ
						И РеквизитыДоверенности.ПредставительЯвляетсяСотрудником
						И ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь;
					
					НастройкиВызова = Новый Структура;
					НастройкиВызова.Вставить("РеквизитыДоверенности", 			РеквизитыДоверенности);
					НастройкиВызова.Вставить("ДанныеРегистрации", 				ДанныеРегистрации);
					НастройкиВызова.Вставить("ИспользоватьРеквизитыДоверителя", ИспользоватьРеквизитыДоверителя);
					Если НЕ ИзменитьФайлВыгрузкиПриОтправкеЧерезУполномоченногоПредставителя(
						Контекст.ТекстВыгрузки,
						Контекст.ИмяФайлаВыгрузки,
						ДоверенностьПредставителя,
						Контекст.КодНалоговогоОргана,
						Контекст.ДатаОкончанияПериодаОтчета,
						Контекст.Организация,
						НастройкиВызова) Тогда
						Возврат Ложь;
					КонецЕсли;
					ИмяФайлаВыгрузкиБылоИзменено = Истина;
				КонецЕсли;
				
			ИначеЕсли РегистрацияВНОСервер.НетОбязательнойДоверенности(ЭлРегистрацияВИФНС) Тогда
		
				Возврат Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	// если имя файла выгрузки не было изменено в связи со сдачей от представителя
	// и при этом файл выгрузки - внешний (а значит, если он текстовый, то следует изменить счетчики)
	// то изменим счетчики в имени
	Если НЕ ИмяФайлаВыгрузкиБылоИзменено И Контекст.НеобходимоНараститьСчетчикФайлов Тогда
		НараститьСчетчикВИмениФайлаВыгрузкиПриНеобходимости(Контекст.ИмяФайлаВыгрузки, Контекст.Организация, Контекст.ДатаОкончанияПериодаОтчета, Контекст.КодНалоговогоОргана);
	КонецЕсли;
	
	Контекст.Вставить("ФайлДоверенности", 				АдресФайлаДоверенности);
	Контекст.Вставить("КороткоеИмяФайлаДоверенности", 	КороткоеИмяФайлаДоверенности);
	Контекст.Вставить("КППДляПоиска", 					КППДляПоиска);
	
	Возврат Истина;
	
КонецФункции

Функция ИзменитьФайлВыгрузкиПриОтправкеЧерезУполномоченногоПредставителя(
		ТекстВыгрузки,
		ИмяФайлаВыгрузки,
		Доверенность,
		КодНО,
		ДатаПериода = '00010101',
		Организация = Неопределено,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("РеквизитыДоверенности", 			Неопределено);
	НастройкиВызова.Вставить("ДанныеРегистрации", 				Неопределено);
	НастройкиВызова.Вставить("ИспользоватьРеквизитыДоверителя", Ложь);
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	РеквизитыДоверенности = НастройкиВызова.РеквизитыДоверенности;
	
	ИмяФайлаБезРасширения = Лев(ИмяФайлаВыгрузки, СтрДлина(ИмяФайлаВыгрузки) - 4);
	РасширениеФайла = Прав(ИмяФайлаВыгрузки, 4);
	Если нрег(РасширениеФайла) = ".xml" Тогда // формат xml - меняем ИдФайл и имя файла
		
		// разбираем имя файла на компоненты
		КомпонентыИмени = РазложитьСтрокуВМассивПодстрок(ИмяФайлаБезРасширения, "_");
		Если КомпонентыИмени.Количество() < 5 Тогда
			ТекстСообщения = НСтр("ru = 'Невозможно изменить реквизиты отправителя в имени файла отчета: некорректное исходное имя файла выгрузки.';
									|en = 'Cannot change sender details in the report file name: incorrect source export file name.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		// получаем рег. данные представителя
		Если НастройкиВызова.ИспользоватьРеквизитыДоверителя И РеквизитыДоверенности <> Неопределено Тогда
			Если ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН) Тогда
				СведенияОПредставителе = Новый Структура("ПредставительЯвляетсяЮЛ, ИНН, КПП",
					ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН), РеквизитыДоверенности.ДоверительЮЛ_ИНН,
					?(НастройкиВызова.ДанныеРегистрации = Неопределено, РеквизитыДоверенности.ДоверительЮЛ_КПП,
						НастройкиВызова.ДанныеРегистрации.КПП));
			Иначе
				СведенияОПредставителе = Новый  Структура("ПредставительЯвляетсяЮЛ, ИНН",
					ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН), РеквизитыДоверенности.ДоверительФЛ_ИНН);
			КонецЕсли;
		Иначе
			СведенияОПредставителе = ПолучитьИННКППУполномоченногоПредставителя(
				Доверенность,
				РеквизитыДоверенности,
				НастройкиВызова.ДанныеРегистрации);
			Если СведенияОПредставителе = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Если СведенияОПредставителе.ПредставительЯвляетсяЮЛ Тогда
			ИННКПП = СокрЛП(СведенияОПредставителе.ИНН) + СокрЛП(СведенияОПредставителе.КПП);
		Иначе
			ИННКПП = СокрЛП(СведенияОПредставителе.ИНН);
		КонецЕсли;
		
		// подменяем ИНН и КПП в компонентах имени файла
		Если КомпонентыИмени[0] = "ДОХОД" Тогда // 2-НДФЛ, старая форма
			КомпонентыИмени.Установить(3, ИННКПП);
		Иначе // прочие отчеты
			КомпонентыИмени.Установить(4, ИННКПП);
		КонецЕсли;
		
		// формируем новое имя файла
		НовоеИмяФайлаВыгрузкиБезРасширения = СтрСоединить(КомпонентыИмени, "_");
		
		// подменяем старое имя на новое в тексте выгрузки
		ТекстФайлаВыгрузки = ТекстВыгрузки;
		ПоместитьТекстВыгрузкиВХранилище = Ложь;
		Если ЭтоАдресВременногоХранилища(ТекстВыгрузки) Тогда
			ДвоичныеДанныеВыгрузки = ПолучитьИзВременногоХранилища(ТекстВыгрузки);
			Если ТипЗнч(ДвоичныеДанныеВыгрузки) = Тип("ДвоичныеДанные") Тогда
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
				ДвоичныеДанныеВыгрузки.Записать(ИмяВременногоФайла);
				
				ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, "windows-1251");
				ТекстФайлаВыгрузки = ОбъектЧтениеТекста.Прочитать();
				ОбъектЧтениеТекста.Закрыть();
				
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
				ПоместитьТекстВыгрузкиВХранилище = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ТекстФайлаВыгрузки = СтрЗаменить(ТекстФайлаВыгрузки, ИмяФайлаБезРасширения, НовоеИмяФайлаВыгрузкиБезРасширения);
		
		Если ПоместитьТекстВыгрузкиВХранилище Тогда
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			
			ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, "windows-1251");
			ОбъектЗаписьТекста.Записать(ТекстФайлаВыгрузки);
			ОбъектЗаписьТекста.Закрыть();
			
			ДвоичныеДанныеВыгрузки = Новый ДвоичныеДанные(ИмяВременногоФайла);
			ТекстВыгрузки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеВыгрузки, Новый УникальныйИдентификатор);
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		Иначе
			ТекстВыгрузки = ТекстФайлаВыгрузки;
		КонецЕсли;
		
		// присваиваем значение нового имени файла переменной со старым именем
		ИмяФайлаВыгрузки = НовоеИмяФайлаВыгрузкиБезРасширения + РасширениеФайла;
		
	Иначе // текстовый формат - меняем имя файла
		
		// разбираем имя файла на компоненты
		КомпонентыИмени = РазложитьСтрокуВМассивПодстрок(ИмяФайлаБезРасширения, "_");
		ЧислоКомпонентИмени = КомпонентыИмени.Количество();
		Если ЧислоКомпонентИмени <> 4 И ЧислоКомпонентИмени <> 5 Тогда // непонятный формат
			ТекстСообщения = НСтр("ru = 'Невозможно изменить реквизиты отправителя в имени файла отчета: некорректное исходное имя файла выгрузки.';
									|en = 'Cannot change sender details in the report file name: incorrect source export file name.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		// если файл от юрлица, то объединяем ИНН и КПП (первую и вторую составляющие) в одну компоненту
		Если СтрДлина(КомпонентыИмени[1]) = 9 Тогда // вторая компонента - КПП, а значит файл от юрлица
			КомпонентыИмени.Установить(0, КомпонентыИмени[0] + "_" + КомпонентыИмени[1]);
			КомпонентыИмени.Удалить(1);
		КонецЕсли;
		
		// формируем первую компоненту нового имени (с ИНН и КПП)
		Если НастройкиВызова.ИспользоватьРеквизитыДоверителя И РеквизитыДоверенности <> Неопределено Тогда
			Если ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН) Тогда
				СведенияОПредставителе = Новый Структура("ПредставительЯвляетсяЮЛ, ИНН, КПП",
					ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН), РеквизитыДоверенности.ДоверительЮЛ_ИНН,
					?(НастройкиВызова.ДанныеРегистрации = Неопределено, РеквизитыДоверенности.ДоверительЮЛ_КПП,
						НастройкиВызова.ДанныеРегистрации.КПП));
			Иначе
				СведенияОПредставителе = Новый Структура("ПредставительЯвляетсяЮЛ, ИНН",
					ЗначениеЗаполнено(РеквизитыДоверенности.ДоверительЮЛ_ИНН), РеквизитыДоверенности.ДоверительФЛ_ИНН);
			КонецЕсли;
		Иначе
			СведенияОПредставителе = ПолучитьИННКППУполномоченногоПредставителя(
				Доверенность,
				РеквизитыДоверенности,
				НастройкиВызова.ДанныеРегистрации);
			Если СведенияОПредставителе = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Если СведенияОПредставителе.ПредставительЯвляетсяЮЛ Тогда
			КомпонентыИмени.Установить(0, "O" + СведенияОПредставителе.ИНН + "_" + СведенияОПредставителе.КПП);
		Иначе
			КомпонентыИмени.Установить(0, "O" + СведенияОПредставителе.ИНН);
		КонецЕсли;
		
		// устанавливаем новый счетчик файлов
		Если Организация <> Неопределено Тогда
			СчетчикВыгруженныхФайлов = РегламентированнаяОтчетность.ПолучитьСчетчикВыгруженныхФайлов(
				Организация,
				Перечисления.ТипыСчетчиковВыгрузки.СчетчикФайлов,
				ДатаПериода,
				КодНО);
			КомпонентыИмени.Установить(3, Формат(СчетчикВыгруженныхФайлов, "ЧЦ=8; ЧН=00000000; ЧВН=; ЧГ="));
			РегламентированнаяОтчетностьВызовСервера.УстановитьСчетчикВыгруженныхФайлов(
				Организация,
				СчетчикВыгруженныхФайлов,
				Перечисления.ТипыСчетчиковВыгрузки.СчетчикФайлов,
				ДатаПериода,
				КодНО);
		КонецЕсли;
		
		// формируем новое имя файла
		ИмяФайлаВыгрузки = СтрСоединить(КомпонентыИмени, "_") + РасширениеФайла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Игнорировать признак крупнейшего налогоплательщика согласно письму ФНС России от 23.03.2016 № БС-4-11/4891@.
Функция ИгнорироватьНалоговыйОрганПосредника(СтрокаНачинающаясяСИмениФайлаВыгрузки)
	
	Результат = Ложь;
	
	ПрефиксыИмениФайлаИсключения = Новый Массив();
	ПрефиксыИмениФайлаИсключения.Добавить("NO_IMUD_");
	ПрефиксыИмениФайлаИсключения.Добавить("NO_IMUR_");
	// Разъясняющие письма ФНС России от 23 января 2017 № БС-4-11/993, от 10 января 2017 № БС-4/11-100.
	ПрефиксыИмениФайлаИсключения.Добавить("NO_RASCHSV_");
	
	Для каждого ПрефиксИмениФайлаИсключения Из ПрефиксыИмениФайлаИсключения Цикл
		Если Лев(СтрокаНачинающаясяСИмениФайлаВыгрузки, СтрДлина(ПрефиксИмениФайлаИсключения)) = ПрефиксИмениФайлаИсключения Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат Тогда
		Инспекции = ОпределитьИнспекцииПоИмениФайла(СтрокаНачинающаясяСИмениФайлаВыгрузки);
		Результат = (Инспекции <> Неопределено И Инспекции.КодИФНС1 = Инспекции.КодИФНС2);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИННКППУполномоченногоПредставителя(
		Доверенность,
		РеквизитыДоверенности = Неопределено,
		ДанныеРегистрации = Неопределено)
	
	ИмяТипаСправочникаМашиночитаемыеДоверенности = ?(ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует(),
		"МашиночитаемыеДоверенности", "");
	Если ТипЗнч(Доверенность) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
		ИЛИ ТипЗнч(Доверенность) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
		ИЛИ ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности)
			И ТипЗнч(Доверенность) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
		
		Если РеквизитыДоверенности = Неопределено Тогда
			Если ДанныеРегистрации = Неопределено Тогда
				РеквизитыДоверенности = ДокументооборотСКОВызовСервера.ЗначенияРеквизитовМЧД(Доверенность,
					"ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, ПредставительФЛ_ИНН");
				Если РеквизитыДоверенности = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
			Иначе
				РеквизитыДоверенности = ДокументооборотСКОВызовСервера.ЗначенияРеквизитовМЧД(Доверенность,
					"Представитель, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, ПредставительФЛ_ИНН, ПредставительФЛ_ОГРН, "
					+ "ВерсияФормата, КоличествоПредставителей, Представители, ПредставительЯвляетсяСотрудником");
				Если РеквизитыДоверенности = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
				ДокументооборотСКОВызовСервера.УточнитьРеквизитыПредставителяМЧДФНС(РеквизитыДоверенности,
					Доверенность, ДанныеРегистрации);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН) Тогда
			Возврат Новый Структура("ПредставительЯвляетсяЮЛ, ИНН, КПП",
				ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН), РеквизитыДоверенности.ПредставительЮЛ_ИНН,
				РеквизитыДоверенности.ПредставительЮЛ_КПП);
		Иначе
			Возврат Новый Структура("ПредставительЯвляетсяЮЛ, ИНН",
				ЗначениеЗаполнено(РеквизитыДоверенности.ПредставительЮЛ_ИНН), РеквизитыДоверенности.ПредставительФЛ_ИНН);
		КонецЕсли;
		
	Иначе
		Если РеквизитыДоверенности = Неопределено Тогда
			РеквизитыДоверенности = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Доверенность,
				"ПредставительЯвляетсяЮЛ, ПредставительЮЛ_ИНН, ПредставительЮЛ_КПП, ПредставительФЛ_ИНН");
		КонецЕсли;
		Если РеквизитыДоверенности.ПредставительЯвляетсяЮЛ Тогда
			Возврат Новый Структура("ПредставительЯвляетсяЮЛ, ИНН, КПП",
				РеквизитыДоверенности.ПредставительЯвляетсяЮЛ, РеквизитыДоверенности.ПредставительЮЛ_ИНН,
				РеквизитыДоверенности.ПредставительЮЛ_КПП);
		Иначе
			Возврат Новый Структура("ПредставительЯвляетсяЮЛ, ИНН",
				РеквизитыДоверенности.ПредставительЯвляетсяЮЛ, РеквизитыДоверенности.ПредставительФЛ_ИНН);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ДобавитьУзел(Узел, Имя)
	
	НовУзел = Узел.Строки.Добавить();
	НовУзел.Имя = Имя;
	НовУзел.Тип = "Э";
	
	Возврат НовУзел;
	
КонецФункции

Функция ДобавитьЗначениеВыгрузки(Узел, Имя, Тип, Значение, ОбрезатьДо = Неопределено, ТолькоЕслиЗаполнен = Ложь)
	
	Если ТолькоЕслиЗаполнен И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовУзел = Узел.Строки.Добавить();
	НовУзел.Имя = Имя;
	НовУзел.Тип = Тип;
	
	ЗначениеСтрока = СтроковоеПредставлениеЗначенияВыгрузки(Значение);
	ЗначениеУзла = ?(ОбрезатьДо = Неопределено, ЗначениеСтрока, СокрЛП(Лев(ЗначениеСтрока, ОбрезатьДо)));
	НовУзел.Значение = ЗначениеУзла;
	
	Возврат НовУзел;
	
КонецФункции

Функция ВыгрузитьДеревоДоверенностиВФайл(Узел, ПолноеИмяФайлаДоверенности, ОбъектЗапись = Неопределено)
	
	ЭтоВерхнийУровеньРекурсии = (ОбъектЗапись = Неопределено);
	Если ЭтоВерхнийУровеньРекурсии Тогда
		ОбъектЗапись = Новый ЗаписьXML;
		ОбъектЗапись.ОткрытьФайл(ПолноеИмяФайлаДоверенности, "windows-1251");
		ОбъектЗапись.ЗаписатьОбъявлениеXML();
	КонецЕсли;
	
	// выгружаем текущий элемент и подчиненные
	Если НЕ ЭтоВерхнийУровеньРекурсии Тогда
		Если Узел.Тип = "А" ИЛИ Узел.Тип = "A" Тогда 
			ОбъектЗапись.ЗаписатьАтрибут(Узел.Имя, Строка(Узел.Значение));
		Иначе
			ОбъектЗапись.ЗаписатьНачалоЭлемента(Узел.Имя);
			Для каждого Лист из Узел.Строки Цикл
				ВыгрузитьДеревоДоверенностиВФайл(Лист, ПолноеИмяФайлаДоверенности, ОбъектЗапись);
			КонецЦикла;
			ОбъектЗапись.ЗаписатьТекст(Строка(Узел.Значение));
			ОбъектЗапись.ЗаписатьКонецЭлемента();
		КонецЕсли;
	Иначе
		Для Каждого СтрУзел Из Узел.Строки Цикл
			ВыгрузитьДеревоДоверенностиВФайл(СтрУзел, ПолноеИмяФайлаДоверенности, ОбъектЗапись);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоВерхнийУровеньРекурсии Тогда
		ОбъектЗапись.Закрыть();
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция СтроковоеПредставлениеЗначенияВыгрузки(ЗначениеВыгрузки)
	
	ТипЗначенияВыгрузки = ТипЗнч(ЗначениеВыгрузки);
	Если ТипЗначенияВыгрузки = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗначенияВыгрузки = Тип("Дата") Тогда
		Возврат Формат(ЗначениеВыгрузки, "ДФ=dd.MM.yyyy; ДП=");
	ИначеЕсли ТипЗначенияВыгрузки = Тип("Число") Тогда
		Возврат Формат(ЗначениеВыгрузки, "ЧН=; ЧГ=");
	ИначеЕсли ТипЗначенияВыгрузки = Тип("Булево") Тогда
		Возврат ?(ЗначениеВыгрузки, "true", "false");
	Иначе
		Возврат ЗначениеВыгрузки;
	КонецЕсли;
	
КонецФункции

Функция СформироватьИдФайлДоверенности(РегистрацияВИФНС, СведенияДоверенности, Префикс = "", Организация = Неопределено,
	КодНалоговогоОрганаКонечногоПолучателя = Неопределено, ИгнорироватьПризнакКрупнейшегоНалогоплательщика = Ложь)
	
	Если Организация = Неопределено Тогда
		Организация = РегистрацияВИФНС.Владелец;
	КонецЕсли;
	
	// R_T
	Если ЗначениеЗаполнено(Префикс) Тогда
		//для документооборота Представление
		R_T = Префикс;
	Иначе
		R_T = "NO_DOVER";
	КонецЕсли;
	
	// A_K
	НОКонечныйПолучатель = СведенияДоверенности.КодНО;
	
	ЭтоКрупнейший    = ДокументооборотСКО.ЭтоКрупнейший(Организация);
	КодНОКрупнейшего = ДокументооборотСКО.КодНОКрупнейшего(Организация);
	
	НОПосредник = ?(ЭтоКрупнейший И НЕ ИгнорироватьПризнакКрупнейшегоНалогоплательщика,
		СокрЛП(КодНОКрупнейшего), "");
	A_K = ?(ЗначениеЗаполнено(НОПосредник), НОПосредник, НОКонечныйПолучатель) + "_"
		+ ?(ЗначениеЗаполнено(КодНалоговогоОрганаКонечногоПолучателя), КодНалоговогоОрганаКонечногоПолучателя, НОКонечныйПолучатель);
	
	Если СведенияДоверенности.СвУпПред.СвПред.Свойство("СвОрг") Тогда // представитель - юрлицо
		СвПредст = СведенияДоверенности.СвУпПред.СвПред.СвОрг;
		O = СокрЛП(СвПредст.ИННЮЛ) + СокрЛП(СвПредст.КПП);
	Иначе // представитель - физлицо
		Если СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
			УчСвПредст = СведенияДоверенности.СвПредст;
			Если НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация) Тогда
				O = СокрЛП(УчСвПредст.ИННФЛ);
			Иначе
				Если СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
					И СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
					И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица") Тогда
					O = СокрЛП(УчСвПредст.ИННЮЛ) + СокрЛП(РегистрацияВИФНС.КПП);
				Иначе
					O = СокрЛП(УчСвПредст.ИННЮЛ) + СокрЛП(УчСвПредст.КПП);
				КонецЕсли;
			КонецЕсли;
		Иначе
			СвПредст = СведенияДоверенности.СвУпПред.СвПред.СведФизЛ;
			O = СокрЛП(СвПредст.ИННФЛ);
		КонецЕсли;
	КонецЕсли;
	
	// GGGGMMDD
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	
	// N
	N = ВРЕГ(Строка(Новый УникальныйИдентификатор));
	
	Возврат R_T + "_" + A_K + "_" + O + "_" + GGGGMMDD + "_" + N;
	
КонецФункции

Функция СформироватьФайлВыгрузкиДоверенностиПредставление(РегистрацияВИФНС, СведенияДоверенности, КороткоеИмяФайлаДоверенности = Неопределено, Организация = Неопределено,
	КодНалоговогоОрганаКонечногоПолучателя = Неопределено, ИгнорироватьПризнакКрупнейшегоНалогоплательщика = Ложь)
	
	ДеревоВыгрузки = Новый ДеревоЗначений;
	ДеревоВыгрузки.Колонки.Добавить("Имя");
	ДеревоВыгрузки.Колонки.Добавить("Тип");
	ДеревоВыгрузки.Колонки.Добавить("Значение");
	
	ИдФайл = СформироватьИдФайлДоверенности(РегистрацияВИФНС, СведенияДоверенности, "ON_DOV", Организация,
		КодНалоговогоОрганаКонечногоПолучателя, ИгнорироватьПризнакКрупнейшегоНалогоплательщика);
	
	
	// узел Файл
	УзелФайл = ДобавитьУзел(ДеревоВыгрузки, "Файл");
	ДобавитьЗначениеВыгрузки(УзелФайл, "ИдФайл", "А", ИдФайл, 255);
	ДобавитьЗначениеВыгрузки(УзелФайл, "ВерсПрог", "А", РегламентированнаяОтчетность.НазваниеИВерсияПрограммы(), 40);
	ДобавитьЗначениеВыгрузки(УзелФайл, "ВерсФорм", "А", "5.02");
	
	
	// узел Документ
	УзелДокумент = ДобавитьУзел(УзелФайл, "Документ");
	ДобавитьЗначениеВыгрузки(УзелДокумент, "КНД", "А", "1167005");
	КодНО = ?(ЗначениеЗаполнено(КодНалоговогоОрганаКонечногоПолучателя), КодНалоговогоОрганаКонечногоПолучателя, СведенияДоверенности.КодНО);
	ДобавитьЗначениеВыгрузки(УзелДокумент, "КодНО", "А", КодНО, 4);
	
	
	// узел УчСвДов
	УзелУчСвДов = ДобавитьУзел(УзелДокумент, "УчСвДов");
	
	УчСвДов = СведенияДоверенности.УчСвДов;
	ДобавитьЗначениеВыгрузки(УзелУчСвДов, "НомДовер", "А", УчСвДов.Номер);
	ДобавитьЗначениеВыгрузки(УзелУчСвДов, "ДатаНач", "А", УчСвДов.Дата);
	Если ЗначениеЗаполнено(УчСвДов.ДатаОкончания) Тогда
		ДобавитьЗначениеВыгрузки(УзелУчСвДов, "ДатаОкон", "А", УчСвДов.ДатаОкончания, , Истина);
	КонецЕсли;
	
	
	// узел СвПредст
	УзелСвПредст = ДобавитьУзел(УзелДокумент, "СвПредст");
	
	УчСвПредст = СведенияДоверенности.СвПредст;
	Если УчСвПредст.ЯвляетсяФЛ Тогда
		
		// узел НПФЛ
		УзелНПФЛ = ДобавитьУзел(УзелСвПредст, "НПФЛ");
		ДобавитьЗначениеВыгрузки(УзелНПФЛ, "ИННФЛ", "А", УчСвПредст.ИННФЛ, 12, Истина);
		ДобавитьЗначениеВыгрузки(УзелНПФЛ, "ОГРНИП", "А", УчСвПредст.ОГРНИП, 15, Истина);
		ДобавитьЗначениеВыгрузки(УзелНПФЛ, "Гражданство", "А", УчСвПредст.Гражданство, 3, Истина);
		ДобавитьЗначениеВыгрузки(УзелНПФЛ, "ДатаРожд", "А", УчСвПредст.ДатаРожд, , Истина);
		
		// узел ФИО
		УчФИО = УчСвПредст.ФИО;
		УзелФИО = ДобавитьУзел(УзелНПФЛ, "ФИО");
		ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", УчФИО.Фамилия, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", УчФИО.Имя, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", УчФИО.Отчество, 60, Истина);
		
		// узел УдЛичн
		УчУдЛичн = УчСвПредст.УдЛичн;
		УзелУдЛичн = ДобавитьУзел(УзелНПФЛ, "УдЛичн");
		ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВидДок", "А", УчУдЛичн.ВидДок, 2);
		ДобавитьЗначениеВыгрузки(УзелУдЛичн, "СерНомДок", "А", УчУдЛичн.СерНомДок, 25);
		ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ДатаДок", "А", УчУдЛичн.ДатаДок, 10);
		ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ВыдДок", "А", УчУдЛичн.ВыдДок, 255);
		ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВыдДок", "А", УчУдЛичн.КодВыдДок, 7, Истина);
		
	Иначе
		
		// узел НПЮЛ
		УзелНПЮЛ = ДобавитьУзел(УзелСвПредст, "НПЮЛ");
		ДобавитьЗначениеВыгрузки(УзелНПЮЛ, "НаимОрг", "А", УчСвПредст.НаимОрг, 1000);
		ДобавитьЗначениеВыгрузки(УзелНПЮЛ, "ИННЮЛ", "А", УчСвПредст.ИННЮЛ, 10);
		ДобавитьЗначениеВыгрузки(УзелНПЮЛ, "КПП", "А", УчСвПредст.КПП, 9);
		ДобавитьЗначениеВыгрузки(УзелНПЮЛ, "ОГРН", "А", УчСвПредст.ОГРН, 13, Истина);
		
		// узел СвРукОрг
		УчСвРукОрг = УчСвПредст.СвРукОрг;
		УзелСвРукОрг = ДобавитьУзел(УзелНПЮЛ, "СвРукОрг");
		ДобавитьЗначениеВыгрузки(УзелСвРукОрг, "ИННФЛ", "А", УчСвРукОрг.ИННФЛ, 12, Истина);
		
		// узел ФИО
		УчСвРукОргФИО = УчСвРукОрг.ФИО;
		УзелФИО = ДобавитьУзел(УзелСвРукОрг, "ФИО");
		ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", УчСвРукОргФИО.Фамилия, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", УчСвРукОргФИО.Имя, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", УчСвРукОргФИО.Отчество, 60, Истина);
		
	КонецЕсли;
	
	
	// узел СвДовер
	УзелСвДовер = ДобавитьУзел(УзелДокумент, "СвДовер");
	
	УчСвДовер = СведенияДоверенности.СвДовер;
	ПризнакДоверителя = ?(ЗначениеЗаполнено(УчСвДовер.ПрДов), УчСвДовер.ПрДов, 1);
	ДобавитьЗначениеВыгрузки(УзелСвДовер, "ПрДов", "А", ПризнакДоверителя, 1);
	
	Если ПризнакДоверителя = 2 ИЛИ ПризнакДоверителя = 3 Тогда
		
		УзелСвЮЛФЛ = ДобавитьУзел(УзелСвДовер, "СвЮЛФЛ");
		
		// выгружаем сведения о доверителе-ЮЛ
		Если УчСвДовер.Свойство("СвЮЛ") Тогда
			
			УчСвЮЛ = УчСвДовер.СвЮЛ;
			
			// узел ЮЛ
			УзелЮЛ = ДобавитьУзел(УзелСвЮЛФЛ, "ЮЛ");
			ДобавитьЗначениеВыгрузки(УзелЮЛ, "НаимОрг", "А", УчСвЮЛ.НаимОрг, 1000);
			ДобавитьЗначениеВыгрузки(УзелЮЛ, "ИННЮЛ", "А", УчСвЮЛ.ИННЮЛ, 10);
			ДобавитьЗначениеВыгрузки(УзелЮЛ, "КПП", "А", УчСвЮЛ.КПП, 9);
			ДобавитьЗначениеВыгрузки(УзелЮЛ, "ОГРН", "А", УчСвЮЛ.ОГРН, 13, Истина);
			
			// узел СвРукОрг
			УчСвРукОрг = УчСвЮЛ.СвРукОрг;
			УзелСвРукОрг = ДобавитьУзел(УзелЮЛ, "СвРукОрг");
			ДобавитьЗначениеВыгрузки(УзелСвРукОрг, "ИННФЛ", "А", УчСвРукОрг.ИННФЛ, 12, Истина);
			
			// узел ФИО
			УчСвРукОргФИО = УчСвРукОрг.ФИО;
			УзелФИО = ДобавитьУзел(УзелСвРукОрг, "ФИО");
			ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", УчСвРукОргФИО.Фамилия, 60);
			ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", УчСвРукОргФИО.Имя, 60);
			ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", УчСвРукОргФИО.Отчество, 60, Истина);
			
		КонецЕсли;
		
		// выгружаем сведения о доверителе-ФЛ
		Если УчСвДовер.Свойство("СвФЛ") Тогда
			
			УчСвФЛ = УчСвДовер.СвФЛ;
			
			// узел ФЛ
			УзелФЛ = ДобавитьУзел(УзелСвЮЛФЛ, "ФЛ");
			ДобавитьЗначениеВыгрузки(УзелФЛ, "ИННФЛ", "А", УчСвФЛ.ИННФЛ, 12, Истина);
			ДобавитьЗначениеВыгрузки(УзелФЛ, "ОГРНИП", "А", УчСвФЛ.ОГРНИП, 15, Истина);
			ДобавитьЗначениеВыгрузки(УзелФЛ, "Гражданство", "А", УчСвФЛ.Гражданство, 3, Истина);
			ДобавитьЗначениеВыгрузки(УзелФЛ, "ДатаРожд", "А", УчСвФЛ.ДатаРожд, , Истина);
			
			// узел ФИО
			УчФИО = УчСвФЛ.ФИО;
			УзелФИО = ДобавитьУзел(УзелФЛ, "ФИО");
			ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", УчФИО.Фамилия, 60);
			ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", УчФИО.Имя, 60);
			ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", УчФИО.Отчество, 60, Истина);
			
			// узел УдЛичн
			УчУдЛичн = УчСвФЛ.УдЛичн;
			УзелУдЛичн = ДобавитьУзел(УзелФЛ, "УдЛичн");
			ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВидДок", "А", УчУдЛичн.ВидДок, 2);
			ДобавитьЗначениеВыгрузки(УзелУдЛичн, "СерНомДок", "А", УчУдЛичн.СерНомДок, 25);
			ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ДатаДок", "А", УчУдЛичн.ДатаДок, 10);
			ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ВыдДок", "А", УчУдЛичн.ВыдДок, 255);
			ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВыдДок", "А", УчУдЛичн.КодВыдДок, 7, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// узел СвУпПред
	УзелСвУпПред = ДобавитьУзел(УзелДокумент, "СвУпПред");
	СвУпПред = СведенияДоверенности.СвУпПред;
	
	// сведения о полномочиях
	Для Каждого СтрПолнДов Из СвУпПред.ПолнДов Цикл
		
		Для Каждого ЭлПрОблПолн Из СтрПолнДов.ПрОблПолн Цикл
			ДобавитьЗначениеВыгрузки(УзелСвУпПред, "ПрОблПолн", "Э", ЭлПрОблПолн);
		КонецЦикла;
		
	КонецЦикла;
	
	СвПред = СвУппред.СвПред;
	
	// сведения о представителе
	УзелСвПред = ДобавитьУзел(УзелСвУпПред, "СвПред");
	
	// сведения о представителе-ЮЛ
	Если СвПред.Свойство("СвОрг") Тогда
		
		СвОрг = СвПред.СвОрг;
		
		УзелСвОрг = ДобавитьУзел(УзелСвПред, "СвОрг");
		ДобавитьЗначениеВыгрузки(УзелСвОрг, "НаимОрг", "А", СвОрг.НаимОрг, 1000);
		ДобавитьЗначениеВыгрузки(УзелСвОрг, "ИННЮЛ", "А", СвОрг.ИННЮЛ, 10);
		ДобавитьЗначениеВыгрузки(УзелСвОрг, "КПП", "А", СвОрг.КПП, 9);
		ДобавитьЗначениеВыгрузки(УзелСвОрг, "ОГРН", "А", СвОрг.ОГРН, 13, Истина);
		
	// если представителем является физлицо - сотрудником представляемой организации,
	// то выгружаем в узел СвОрг сведения о представляемой организации
	ИначеЕсли СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации
		И ((НЕ СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
				ИЛИ СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД <> Ложь
			ИЛИ ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("СвойстваОрганизацииПредставителяДляФизическогоЛица"))) Тогда
		
		// выгружаем сведения об организации представителя
		Если НЕ УчСвПредст.ЯвляетсяФЛ Тогда
			
			// узел НПЮЛ
			УзелСвОрг = ДобавитьУзел(УзелСвПред, "СвОрг");
			ДобавитьЗначениеВыгрузки(УзелСвОрг, "НаимОрг", "А", УчСвПредст.НаимОрг, 1000);
			ДобавитьЗначениеВыгрузки(УзелСвОрг, "ИННЮЛ", "А", УчСвПредст.ИННЮЛ, 10);
			ДобавитьЗначениеВыгрузки(УзелСвОрг, "КПП", "А", УчСвПредст.КПП, 9);
			ДобавитьЗначениеВыгрузки(УзелСвОрг, "ОГРН", "А", УчСвПредст.ОГРН, 13, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	// сведения о представителе-ФЛ
	СведФизЛ = СвПред.СведФизЛ;
	
	// узел СведФизЛ
	УзелСведФизЛ = ДобавитьУзел(УзелСвПред, "СведФизЛ");
	ДобавитьЗначениеВыгрузки(УзелСведФизЛ, "ИННФЛ", "А", СведФизЛ.ИННФЛ, 12, Истина);
	ДобавитьЗначениеВыгрузки(УзелСведФизЛ, "ОГРНИП", "А", СведФизЛ.ОГРНИП, 15, Истина);
	ДобавитьЗначениеВыгрузки(УзелСведФизЛ, "Гражданство", "А", СведФизЛ.Гражданство, 3, Истина);
	ДобавитьЗначениеВыгрузки(УзелСведФизЛ, "ДатаРожд", "А", СведФизЛ.ДатаРожд, , Истина);
	
	// узел ФИО
	УчФИО = СведФизЛ.ФИО;
	УзелФИО = ДобавитьУзел(УзелСведФизЛ, "ФИО");
	ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", УчФИО.Фамилия, 60);
	ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", УчФИО.Имя, 60);
	ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", УчФИО.Отчество, 60, Истина);
	
	// узел УдЛичн
	УчУдЛичн = СведФизЛ.УдЛичн;
	УзелУдЛичн = ДобавитьУзел(УзелСведФизЛ, "УдЛичн");
	ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВидДок", "А", УчУдЛичн.ВидДок, 2);
	ДобавитьЗначениеВыгрузки(УзелУдЛичн, "СерНомДок", "А", УчУдЛичн.СерНомДок, 25);
	ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ДатаДок", "А", УчУдЛичн.ДатаДок, 10);
	ДобавитьЗначениеВыгрузки(УзелУдЛичн, "ВыдДок", "А", УчУдЛичн.ВыдДок, 255);
	ДобавитьЗначениеВыгрузки(УзелУдЛичн, "КодВыдДок", "А", УчУдЛичн.КодВыдДок, 7, Истина);
	
	// сведения о нотариусе
	Если СведенияДоверенности.Свойство("Нотариус") Тогда
		
		СвНотариус = СведенияДоверенности.Нотариус;
		УзелУдостов = ДобавитьУзел(УзелДокумент, "Удостов");
		
		// сведения о нотариусе-ЮЛ
		Если СвНотариус.Свойство("СвОрган") Тогда
			
			СвОрган = СвНотариус.СвОрган;
			
			УзелСвОрган = ДобавитьУзел(УзелУдостов, "СвОрган");
			ДобавитьЗначениеВыгрузки(УзелСвОрган, "НаимОрг", "А", СвОрган.НаимОрг, 1000);
			ДобавитьЗначениеВыгрузки(УзелСвОрган, "ИННЮЛ", "А", СвОрган.ИННЮЛ, 10);
			ДобавитьЗначениеВыгрузки(УзелСвОрган, "КПП", "А", СвОрган.КПП, 9);
			ДобавитьЗначениеВыгрузки(УзелСвОрган, "ОГРН", "А", СвОрган.ОГРН, 13, Истина);
			
		КонецЕсли;
		
		// сведения о нотариусе-ФЛ
		СвФизЛиц = СвНотариус.СвФизЛиц;
		
		УзелСвФизЛиц = ДобавитьУзел(УзелУдостов, "СвФизЛиц");
		ДобавитьЗначениеВыгрузки(УзелСвФизЛиц, "ИННФЛ", "А", СвФизЛиц.ИННФЛ, 12, Истина);
		
		СвФИО = СвФизЛиц.ФИО;
		УзелФИО = ДобавитьУзел(УзелСвФизЛиц, "ФИО");
		ДобавитьЗначениеВыгрузки(УзелФИО, "Фамилия", "А", СвФИО.Фамилия, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Имя", "А", СвФИО.Имя, 60);
		ДобавитьЗначениеВыгрузки(УзелФИО, "Отчество", "А", СвФИО.Отчество, 60, Истина);
		
	КонецЕсли;
	
	// выгружаем дерево в файл
	КороткоеИмяФайлаДоверенности = ИдФайл + ".xml";
	ПолноеИмяФайлаДоверенности = КаталогВременныхФайлов() + КороткоеИмяФайлаДоверенности;
	Если НЕ ВыгрузитьДеревоДоверенностиВФайл(ДеревоВыгрузки, ПолноеИмяФайлаДоверенности) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДоверенности;
	
КонецФункции

Функция ВыгрузитьДоверенностьПредставление(
		РегистрацияВИФНС,
		КороткоеИмяФайлаДоверенности = Неопределено,
		Организация = Неопределено,
		КодНалоговогоОрганаКонечногоПолучателя = Неопределено,
		ИгнорироватьПризнакКрупнейшегоНалогоплательщика = Ложь,
		ИсключеноПриложениеДоверенности = Ложь) Экспорт
	
	// получаем сведения доверенности из справочника
	СведенияДоверенности = ПолучитьСведенияДоверенности(
		РегистрацияВИФНС,
		Организация,
		Истина,
		ИсключеноПриложениеДоверенности);
	Если НЕ ЗначениеЗаполнено(СведенияДоверенности) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТипаСправочникаМашиночитаемыеДоверенности = ?(ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует(),
		"МашиночитаемыеДоверенности", "");
	Если ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности)
		И ТипЗнч(СведенияДоверенности.ДоверенностьСсылка) =
			Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности)
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.МЧД един.фор.для ФНС", Истина) Тогда
		
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Прием налоговой отчетности по машиночитаемой доверенности единого формата в настоящее время отключен на стороне ФНС';
				|en = 'Accepting tax reporting on a machine-readable letter of authority of a unified format is currently disabled by FTS'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если СведенияДоверенности.Свойство("ИсключеноПриложениеДоверенности")
		И СведенияДоверенности.ИсключеноПриложениеДоверенности Тогда
		
		Возврат "ИсключеноПриложениеДоверенности";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТипаСправочникаМашиночитаемыеДоверенности)
		И ТипЗнч(СведенияДоверенности.ДоверенностьСсылка) =
			Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности)
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.ИСоП для МЧД един.ф.") Тогда
		
		Если ИсключеноПриложениеДоверенности Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Прием налоговой отчетности по машиночитаемой доверенности единого формата доступен только при указанном едином регистрационном номере в свойствах регистрации налогового органа организации';
				|en = 'You can receive tax reports via a machine-readable authorization letter in a unified format only if a single registration number is specified in the registration properties of the company''s tax authority'"));
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
			НСтр("ru = 'Отправка доступна только при использовании ""Машиночитаемой доверенности (ФНС)"". Прием налоговой отчетности по машиночитаемой доверенности единого формата доступен только при возможности указания единого регистрационного номера в формате выгрузки и при указанном едином регистрационном номере в свойствах регистрации налогового органа организации';
				|en = 'You can send only ""Machine-readable letter of authority (FTS)"". You can receive tax reports via a machine-readable authorization letter in a unified format only if it is possible to specify a single registration number in the export format and if a single registration number is specified in the registration properties of the company''s tax authority'"));
		КонецЕсли;
		Возврат Неопределено;
		
	ИначеЕсли (ТипЗнч(СведенияДоверенности.ДоверенностьСсылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.ИСоП для МЧД ФНС")
		ИЛИ ТипЗнч(СведенияДоверенности.ДоверенностьСсылка) =
			Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
		И НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.ИСоП для МЧД ФНС РР"))
		И НЕ СведенияДоверенности.СвУпПред.СвПред.Свойство("СвОрг")
		И СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации
		И РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация)
		И СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
		И СведенияДоверенности.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь Тогда
		
		Если ТипЗнч(СведенияДоверенности.ДоверенностьСсылка) =
			Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр") Тогда
			
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Прием налоговой отчетности по машиночитаемой доверенности ФНС распределенного реестра доступен только при установленном флажке сотрудника организации доверителя в доверенности';
					|en = 'Receiving tax reporting under a machine-readable letter of authority from the Federal Tax Service''s distributed ledger is only available if the authorizing company employee checkbox is selected in the letter of authority'"));
		Иначе
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Прием налоговой отчетности по машиночитаемой доверенности ФНС доступен только при установленном флажке сотрудника организации доверителя в доверенности';
					|en = 'Receiving tax reporting under a machine-readable letter of authority from the Federal Tax Service is only available if the authorizing company employee checkbox is selected in the letter of authority'"));
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	// проверяем, возможна ли выгрузка
	Если НЕ ПроверитьВозможностьВыгрузкиДоверенности(СведенияДоверенности) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СформироватьФайлВыгрузкиДоверенностиПредставление(РегистрацияВИФНС, СведенияДоверенности, КороткоеИмяФайлаДоверенности, Организация,
		КодНалоговогоОрганаКонечногоПолучателя, ИгнорироватьПризнакКрупнейшегоНалогоплательщика);
	
КонецФункции

Функция ПроверитьВозможностьВыгрузкиДоверенности(СведенияДоверенности)
	
	ОшибкиПроверки = Новый Массив;
	ПризнакОшибки = Ложь;
	
	// код НО
	Если СтрДлина(СведенияДоверенности.КодНО) <> 4 Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код налогового органа!");
	КонецЕсли;
	
	// коды НО действия машиночитаемой доверенности
	Если СведенияДоверенности.Свойство("КодыНО") И СведенияДоверенности.КодыНО.Количество() <> 0 Тогда
		КодНОНайден = Ложь;
		Для каждого КодНОДействия Из СведенияДоверенности.КодыНО Цикл
			Если КодНОДействия.КодНО = СведенияДоверенности.КодНО Тогда
				КодНОНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ КодНОНайден Тогда
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Код налогового органа ""%1"" не входит в перечень налоговых органов, в отношении которых действует доверенность';
					|en = 'Code of the ""%1"" tax authority is not included in the list of tax authorities in which the authorization letter is valid'"),
				СведенияДоверенности.КодНО);
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	
	// учетные сведения доверенности
	УчСвДов = СведенияДоверенности.УчСвДов;
	
	// Заполненность УчСвДов.Номер не анализируется, при отсутствии номера проставляется "БН"
	
	Если НЕ ЗначениеЗаполнено(УчСвДов.Дата) Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана дата выдачи доверенности!");
		
	Иначе
		ДатаСеанса = ТекущаяДатаСеанса();
		Если НачалоДня(УчСвДов.Дата) > НачалоДня(ДатаСеанса) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Дата начала действия доверенности еще не наступила!");
			
		ИначеЕсли ЗначениеЗаполнено(УчСвДов.ДатаОкончания) И КонецДня(УчСвДов.ДатаОкончания) < КонецДня(ДатаСеанса) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Истек срок действия доверенности!");
		КонецЕсли;
	КонецЕсли;
	
	Если СведенияДоверенности.Свойство("Статус") Тогда
		Если СведенияДоверенности.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Доверенность отозвана!");
		ИначеЕсли СведенияДоверенности.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОшибкаРегистрации Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Ошибка регистрации доверенности!");
		ИначеЕсли СведенияДоверенности.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ИстекСрокДействия Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Истек срок действия доверенности!");
		КонецЕсли;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	
	// сведения о представляемом лице
	СвПредст = СведенияДоверенности.СвПредст;
	Если СвПредст.ЯвляетсяФЛ Тогда
		
		// общие сведения представителя - ФЛ
		Если ЗначениеЗаполнено(СвПредст.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвПредст.ИННФЛ, Истина) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН представляемого лица (" + СвПредст.ИННФЛ + ")!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвПредст.ОГРНИП) И СтрДлина(СвПредст.ОГРНИП) <> 15 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРНИП представляемого лица (" + СвПредст.ОГРНИП + ")!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвПредст.Гражданство) И СтрДлина(СвПредст.Гражданство) <> 3 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код страны гражданства представляемого лица (" + СвПредст.Гражданство + ")!");
		КонецЕсли;
		
		// ФИО
		ФИОПредстФЛ = СвПредст.ФИО;
		Если НЕ ЗначениеЗаполнено(ФИОПредстФЛ.Фамилия) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия представляемого лица!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ФИОПредстФЛ.Имя) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя представляемого лица!");
		КонецЕсли;
		
		// удостоверение личности
		УдЛичнПредстФЛ = СвПредст.УдЛичн;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ВидДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан код вида документа, удостоверяющего личность представляемого лица!");
		ИначеЕсли СтрДлина(УдЛичнПредстФЛ.ВидДок) <> 2 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код вида документа, удостоверяющего личность представляемого лица!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.СерНомДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указаны серия и номер документа, удостоверяющего личность представляемого лица!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ДатаДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана дата документа, удостоверяющего личность представляемого лица!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ВыдДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование органа, выдавшего документ, удостоверяющий личность представляемого лица!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УдЛичнПредстФЛ.КодВыдДок) И СтрДлина(УдЛичнПредстФЛ.КодВыдДок) <> 7 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код подразделения органа, выдавшего документ, удостоверяющий личность представляемого лица!");
		КонецЕсли;
		
	Иначе
		
		// общие сведения
		Если НЕ ЗначениеЗаполнено(СвПредст.НаимОрг) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование организации - представляемого лица!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СвПредст.ИННЮЛ) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан ИНН организации - представляемого лица!");
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвПредст.ИННЮЛ, Ложь) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН организации - представляемого лица (" + СвПредст.ИННЮЛ + ")!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СвПредст.КПП) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан КПП организации - представляемого лица!");
		ИначеЕсли СтрДлина(СвПредст.КПП) <> 9 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный КПП организации - представляемого лица (" + СвПредст.КПП + ")!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвПредст.ОГРН) И СтрДлина(СвПредст.ОГРН) <> 13 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРН организации - представляемого лица (" + СвПредст.ОГРН + ")!");
		КонецЕсли;
		
		// сведения о руководителе
		СвРукПредстЮЛ = СвПредст.СвРукОрг;
		
		Если ЗначениеЗаполнено(СвРукПредстЮЛ.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвРукПредстЮЛ.ИННФЛ, Истина) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН руководителя организации - представляемого лица!");
		КонецЕсли;
		
		ФИОРукПредстЮЛ = СвРукПредстЮЛ.ФИО;
		Если НЕ ЗначениеЗаполнено(ФИОРукПредстЮЛ.Фамилия) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия руководителя организации - представляемого лица!");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ФИОРукПредстЮЛ.Имя) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя руководителя организации - представляемого лица!");
		КонецЕсли;
		
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	
	// сведения о представительстве (доверителе)
	СвДовер = СведенияДоверенности.СвДовер;
	Если СвДовер.ПрДов = 2 ИЛИ СвДовер.ПрДов = 3 Тогда
		
		// сведения о юрлице
		Если СвДовер.Свойство("СвЮЛ") Тогда
			
			СвДоверЮЛ = СвДовер.СвЮЛ;
			
			// общие сведения
			Если НЕ ЗначениеЗаполнено(СвДоверЮЛ.НаимОрг) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование организации - доверителя!");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СвДоверЮЛ.ИННЮЛ) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан ИНН организации - доверителя!");
			ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвДоверЮЛ.ИННЮЛ, Ложь) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН организации - доверителя (" + СвДоверЮЛ.ИННЮЛ + ")!");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СвДоверЮЛ.КПП) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан КПП организации - доверителя!");
			ИначеЕсли СтрДлина(СвДоверЮЛ.КПП) <> 9 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный КПП организации - доверителя (" + СвДоверЮЛ.КПП + ")!");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СвДоверЮЛ.ОГРН) И СтрДлина(СвДоверЮЛ.ОГРН) <> 13 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРН организации - доверителя (" + СвДоверЮЛ.ОГРН + ")!");
			КонецЕсли;
			
			// сведения о руководителе
			СвРукДоверЮЛ = СвДоверЮЛ.СвРукОрг;
			
			Если ЗначениеЗаполнено(СвРукДоверЮЛ.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвРукДоверЮЛ.ИННФЛ, Истина) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН руководителя организации - доверителя!");
			КонецЕсли;
			
			ФИОРукДоверЮЛ = СвРукДоверЮЛ.ФИО;
			Если ЗначениеЗаполнено(ФИОРукДоверЮЛ) Тогда
				Если НЕ ЗначениеЗаполнено(ФИОРукДоверЮЛ.Фамилия) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия руководителя организации - доверителя!");
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ФИОРукДоверЮЛ.Имя) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя руководителя организации - доверителя!");
				КонецЕсли;
			Иначе
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано ФИО руководителя организации - доверителя!");
			КонецЕсли;
			
		КонецЕсли;
		
		// сведения о физлице
		Если СвДовер.Свойство("СвФЛ") Тогда
			
			СвДоверФЛ = СвДовер.СвФЛ;
			
			// общие сведения представителя - ФЛ
			Если ЗначениеЗаполнено(СвДоверФЛ.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвДоверФЛ.ИННФЛ, Истина) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН физического лица - доверителя (" + СвДоверФЛ.ИННФЛ + ")!");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СвДоверФЛ.ОГРНИП) И СтрДлина(СвДоверФЛ.ОГРНИП) <> 15 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРНИП физического лица - доверителя (" + СвДоверФЛ.ОГРНИП + ")!");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СвДоверФЛ.Гражданство) И СтрДлина(СвДоверФЛ.Гражданство) <> 3 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код страны гражданства физического лица - доверителя (" + СвДоверФЛ.Гражданство + ")!");
			КонецЕсли;
			
			// ФИО
			ФИОДоверФЛ = СвДоверФЛ.ФИО;
			Если ЗначениеЗаполнено(ФИОДоверФЛ) Тогда
				Если НЕ ЗначениеЗаполнено(ФИОДоверФЛ.Фамилия) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия физического лица - доверителя!");
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ФИОДоверФЛ.Имя) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя физического лица - доверителя!");
				КонецЕсли;
			Иначе
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано ФИО физического лица - доверителя!");
			КонецЕсли;
			
			// удостоверение личности
			УдЛичнДоверФЛ = СвДоверФЛ.УдЛичн;
			Если ЗначениеЗаполнено(УдЛичнДоверФЛ) Тогда
				
				Если НЕ ЗначениеЗаполнено(УдЛичнДоверФЛ.ВидДок) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан код вида документа, удостоверяющего личность физического лица - доверителя!");
				ИначеЕсли СтрДлина(УдЛичнДоверФЛ.ВидДок) <> 2 Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код вида документа, удостоверяющего личность физического лица - доверителя!");
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(УдЛичнДоверФЛ.СерНомДок) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указаны серия и номер документа, удостоверяющего личность физического лица - доверителя!");
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(УдЛичнДоверФЛ.ДатаДок) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана дата документа, удостоверяющего личность физического лица - доверителя!");
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(УдЛичнДоверФЛ.ВыдДок) Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование органа, выдавшего документ, удостоверяющий личность физического лица - доверителя!");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(УдЛичнДоверФЛ.КодВыдДок) И СтрДлина(УдЛичнДоверФЛ.КодВыдДок) <> 7 Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код подразделения органа, выдавшего документ, удостоверяющий личность физического лица - доверителя!");
				КонецЕсли;
				
			Иначе
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указаны сведения о документе, удостоверяющем личность физического лица - доверителя!");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	
	// сведения об уполномоченном представителе и его полномочиях
	СвУпПред = СведенияДоверенности.СвУпПред;
	
	СвПред = СвУпПред.СвПред;
	
	
	// сведения о представителе-ЮЛ
	Если СвПред.Свойство("СвОрг") Тогда
		
		СвОрг = СвПред.СвОрг;
		
		// общие сведения
		Если НЕ ЗначениеЗаполнено(СвОрг.НаимОрг) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование организации - представителя!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СвОрг.ИННЮЛ) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан ИНН организации - представителя!");
		ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвОрг.ИННЮЛ, Ложь) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН организации - представителя (" + СвОрг.ИННЮЛ + ")!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СвОрг.КПП) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан КПП организации - представителя!");
		ИначеЕсли СтрДлина(СвОрг.КПП) <> 9 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный КПП организации - представителя (" + СвОрг.КПП + ")!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвОрг.ОГРН) И СтрДлина(СвОрг.ОГРН) <> 13 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРН организации - представителя (" + СвОрг.ОГРН + ")!");
		КонецЕсли;
		
	КонецЕсли;
	
	
	// сведения о представителе-ФЛ
	СведПредстФЛ = СвПред.СведФизЛ;
	
	// общие сведения
	Если ЗначениеЗаполнено(СведПредстФЛ.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СведПредстФЛ.ИННФЛ, Истина) Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН физического лица - представителя (" + СведПредстФЛ.ИННФЛ + ")!");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведПредстФЛ.ОГРНИП) И СтрДлина(СведПредстФЛ.ОГРНИП) <> 15 Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРНИП физического лица - представителя (" + СведПредстФЛ.ОГРНИП + ")!");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведПредстФЛ.Гражданство) И СтрДлина(СведПредстФЛ.Гражданство) <> 3 Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код страны гражданства физического лица - представителя (" + СведПредстФЛ.Гражданство + ")!");
	КонецЕсли;
	
	// ФИО
	ФИОПредстФЛ = СведПредстФЛ.ФИО;
	Если ЗначениеЗаполнено(ФИОПредстФЛ) Тогда
		Если НЕ ЗначениеЗаполнено(ФИОПредстФЛ.Фамилия) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия физического лица - представителя!");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ФИОПредстФЛ.Имя) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя физического лица - представителя!");
		КонецЕсли;
	Иначе
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано ФИО физического лица - представителя!");
	КонецЕсли;
	
	// удостоверение личности
	УдЛичнПредстФЛ = СведПредстФЛ.УдЛичн;
	
	Если ЗначениеЗаполнено(УдЛичнПредстФЛ) Тогда
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ВидДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан код вида документа, удостоверяющего личность физического лица - представителя!");
		ИначеЕсли СтрДлина(УдЛичнПредстФЛ.ВидДок) <> 2 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код вида документа, удостоверяющего личность физического лица - представителя!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.СерНомДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указаны серия и номер документа, удостоверяющего личность физического лица - представителя!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ДатаДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана дата документа, удостоверяющего личность физического лица - представителя!");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(УдЛичнПредстФЛ.ВыдДок) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование органа, выдавшего документ, удостоверяющий личность физического лица - представителя!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УдЛичнПредстФЛ.КодВыдДок) И СтрДлина(УдЛичнПредстФЛ.КодВыдДок) <> 7 Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный код подразделения органа, выдавшего документ, удостоверяющий личность физического лица - представителя!");
		КонецЕсли;
		
	Иначе
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указаны сведения о документе, удостоверяющем личность физического лица - представителя!");
	КонецЕсли;
	
	// сведения о полномочиях представителя
	ПолнДов = СвУпПред.ПолнДов;
	Если НЕ ЗначениеЗаполнено(ПолнДов) Тогда
		ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не определены полномочия представителя!");
	Иначе
	
		НомПП = 0;
		Для Каждого ЭлПолнДов Из ПолнДов Цикл
			
			НомПП = НомПП + 1;
			
			ОбластиПолномочий = ЭлПолнДов.ПрОблПолн;
			ОргФЛ = ЭлПолнДов.ОргФЛ;
			ОКАТО = ЭлПолнДов.ОКАТО;
			
			Если ОбластиПолномочий.Количество() = 0 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не определены полномочия в строке " + НомПП + " таблицы полномочий!");
			КонецЕсли;
			
			Если НЕ ОргФЛ.Свойство("ФЛ") Тогда
				Если ЗначениеЗаполнено(ОргФЛ.КПП) И СтрДлина(ОргФЛ.КПП) <> 9 Тогда
					ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "В строке " + НомПП + " таблицы полномочий определен некорректный КПП!");
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОКАТО) И СтрДлина(ОКАТО) <> 11 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "В строке " + НомПП + " таблицы полномочий определен некорректный ОКАТО!");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	
	// сведения о нотариусе
	Если СведенияДоверенности.Свойство("Нотариус") Тогда
		
		СвНотариус = СведенияДоверенности.Нотариус;
		
		Если СвНотариус.Свойство("СвОрган") Тогда
			
			СвОрган = СвНотариус.СвОрган;
			
			// общие сведения
			Если НЕ ЗначениеЗаполнено(СвОрган.НаимОрг) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано наименование организации нотариуса!");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СвОрган.ИННЮЛ) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан ИНН организации нотариуса!");
			ИначеЕсли НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвОрган.ИННЮЛ, Ложь) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН организации нотариуса (" + СвОрган.ИННЮЛ + ")!");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СвОрган.КПП) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указан КПП организации нотариуса!");
			ИначеЕсли СтрДлина(СвОрган.КПП) <> 9 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный КПП организации нотариуса (" + СвОрган.КПП + ")!");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СвОрган.ОГРН) И СтрДлина(СвОрган.ОГРН) <> 13 Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ОГРН организации нотариуса (" + СвОрган.ОГРН + ")!");
			КонецЕсли;
			
		КонецЕсли;
		
		СвФизЛиц = СвНотариус.СвФизЛиц;
		Если ЗначениеЗаполнено(СвФизЛиц.ИННФЛ) И НЕ РегламентированнаяОтчетностьВызовСервера.ИННСоответствуетТребованиямНаСервере(СвФизЛиц.ИННФЛ, Истина) Тогда
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Указан некорректный ИНН нотариуса - физического лица (" + СвФизЛиц.ИННФЛ + ")!");
		КонецЕсли;
		
		ФИОНотариусаФЛ = СвФизЛиц.ФИО;
		Если ЗначениеЗаполнено(ФИОНотариусаФЛ) Тогда
			Если НЕ ЗначениеЗаполнено(ФИОНотариусаФЛ.Фамилия) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указана фамилия нотариуса - физического лица!");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ФИОНотариусаФЛ.Имя) Тогда
				ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано имя нотариуса - физического лица!");
			КонецЕсли;
		Иначе
			ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, "Не указано ФИО нотариуса - физического лица!");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОшибкиПроверки.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось выгрузить сведения о доверенности, выданной представителю:';
								|en = 'Cannot export information about a letter of authority issued to the representative:'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Для Каждого ТекстОшибки Из ОшибкиПроверки Цикл
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НЕ ПризнакОшибки;
	
КонецФункции

Функция ОпределитьИнспекцииПоИмениФайла(ИмяФайла) Экспорт
	
	Подстроки = РазложитьСтрокуВМассивПодстрок(ИмяФайла, "_");
	Если НЕ ЗначениеЗаполнено(Подстроки) ИЛИ Подстроки.Количество() < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если нрег(РасширениеФайла(ИмяФайла)) = "txt" Тогда // это текстовый формат ФНС (2.00, 2.01, 3.00)
		
		Если СтрДлина(Подстроки[0]) = 13 Тогда // если отчет по физлицу, то коды ИФНС во второй компоненте имени
			СтрКодыИФНС = Подстроки[1];
		Иначе // иначе - в третьей
			СтрКодыИФНС = Подстроки[2];
		КонецЕсли;
		
		Если СтрДлина(СтрКодыИФНС) = 8 Тогда
			Возврат Новый Структура("КодИФНС1, КодИФНС2", Лев(СтрКодыИФНС, 4), Прав(СтрКодыИФНС, 4));
		КонецЕсли;
		
	Иначе
		
		ПервыйКодИФНС = СокрЛП(Подстроки[2]); // третья по порядку подстрока - первый код ИФНС
		ВторойКодИФНС = СокрЛП(Подстроки[3]); // четвертая по порядку подстрока - второй код ИФНС
		
		Если СтрДлина(ПервыйКодИФНС) <> 4 Тогда // если первый код не четырехзначный - значит есть проблемы
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтрДлина(ВторойКодИФНС) <> 4 Тогда // если второй код отсутствует, то он равен первому (например, 2-НДФЛ)
			ВторойКодИФНС = ПервыйКодИФНС;
		КонецЕсли;
		
		Возврат Новый Структура("КодИФНС1, КодИФНС2", ПервыйКодИФНС, ВторойКодИФНС);
		
	КонецЕсли;
	
КонецФункции

Процедура ЗарегистрироватьОшибкуПроверки(ПризнакОшибки, ОшибкиПроверки, ТекстОшибки)
	
	ПризнакОшибки = Истина;
	ОшибкиПроверки.Добавить(ТекстОшибки);
	
КонецПроцедуры

Функция Отчет2НДФЛСданЧастично(Объект) Экспорт
	
	ТранспортноеСообщение = Объект.Ссылка;
	
	Если ЭтоПротокол2НДФЛ_КНД1110307(ТранспортноеСообщение) Тогда

		Сведения = СведенияИзПротокола2НДФЛ_1110307(ТранспортноеСообщение);
	    Возврат Сведения.Представленные <> Сведения.Принятые И Сведения.Принятые > 0;
		
	Иначе
	
		// ищем протокол 2-НДФЛ среди содержимого сообщения
		Протоколы2НДФЛ = ПолучитьВложенияТранспортногоСообщения(
			ТранспортноеСообщение, 
			Истина, 
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ);
			
		КоличествоПротоколов = Протоколы2НДФЛ.Количество();
		Если КоличествоПротоколов = 0 Тогда
			Возврат Ложь;
		Иначе
			Протокол2НДФЛ = Протоколы2НДФЛ[0];
		КонецЕсли;
		
		// загружаем протокол из файла в строку
		ТекстОшибки = "";
		ТекстПротокола = ТекстИзФайлаВСтроку(Протокол2НДФЛ, ТекстОшибки);
		Если НЕ ЗначениеЗаполнено(ТекстПротокола) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ТекстПротокола = ВРег(ТекстПротокола);
		
		ВидСведений = "КОЛИЧЕСТВО ОБРАБОТАННЫХ СВЕДЕНИЙ:";
		КоличествоОбработанныхСведений = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, ВидСведений);
		
		ВидСведений = "КОЛИЧЕСТВО ПРИНЯТЫХ СВЕДЕНИЙ:";
		КоличествоПринятыхСведений1 = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, ВидСведений);
		
		ВидСведений = "КОЛИЧЕСТВО СВЕДЕНИЙ, ГОТОВЫХ К ПРИЕМУ:"; // с 2019 г.
		КоличествоПринятыхСведений2 = КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, ВидСведений);
		
		КоличествоПринятыхСведений = Макс(КоличествоПринятыхСведений1, КоличествоПринятыхСведений2);
		
		ЕстьФайлНеПринят = СтрНайти(ТекстПротокола, "ФАЙЛ НЕ ПРИНЯТ") > 0;
		
		Возврат НЕ ЕстьФайлНеПринят
			И КоличествоОбработанныхСведений <> КоличествоПринятыхСведений;
			
	КонецЕсли;
	
КонецФункции
	
Функция КоличествоСведенийВПротоколе2НДФЛ(ТекстПротокола, КлючСтр)
	
	Для ИндСтр = 1 По СтрЧислоСтрок(ТекстПротокола) Цикл
		ТекСтр = СтрПолучитьСтроку(ТекстПротокола, ИндСтр);
		
		// ищем ключ в текущей строке
		ВхождениеКлюча = СтрНайти(ВРЕГ(ТекСтр), КлючСтр);
		Если ВхождениеКлюча <> 0 Тогда
			
			СтрокаБезПрефикса = СокрЛП(СтрЗаменить(ВРЕГ(ТекСтр), КлючСтр, ""));
			СтрокаБезПрефикса = СокрЛП(СтрЗаменить(ВРЕГ(СтрокаБезПрефикса), ":", ""));
			
			Если НЕ ЗначениеЗаполнено(СтрокаБезПрефикса) Тогда
				Возврат 0;
			КонецЕсли;
			
			Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаБезПрефикса) Тогда
				Количество = Число(СтрокаБезПрефикса);
				Если Количество > 0 Тогда
					Возврат Количество;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Процедура ЗаполнитьДанныеСпецоператораСвязи(СтруктураРеквизитов) Экспорт

	Макет = ПолучитьМакетОбработки("ПараметрыСпецоператоровСвязи");
	
	СтруктураРеквизитов.Вставить("СпецоператорыСвязи",					ПолучитьСпецоператоровСвязи());
	СтруктураРеквизитов.Вставить("ТекстМакетаСоглашение", 				ПросмотрМакета("ПечатьСоглашениеHTML"));
	СтруктураРеквизитов.Вставить("МакетПараметрыСпецоператоровСвязи", 	Макет);
	СтруктураРеквизитов.Вставить("Макет", 								Макет);
	СтруктураРеквизитов.Вставить("ЗначениеЗаполненияСпецоператораСвязи",Перечисления.СпецоператорыСвязи.КалугаАстрал);

КонецПроцедуры

// Определяет состояние сдачи отчета на основе приложения к протоколу ПФР.
Функция ОтчетПФРСданЧастично(
		Объект = Неопределено,
		ВложенияТранспортногоСообщения = Неопределено,
		ФорматДокументооборота = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьВложения", 		Ложь);
	Результат.Вставить("ЕстьПриложение", 	Ложь);
	Результат.Вставить("СданЧастично", 		Ложь);
	Результат.Вставить("НеСдан", 			Ложь);
	
	Если ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
		ТипыСодержимого = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР;
		
	ИначеЕсли ФорматДокументооборота = Неопределено Тогда
		ТипыСодержимого = Новый Массив;
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР);
		
	Иначе
		ТипыСодержимого = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР;
	КонецЕсли;
	
	// ищем приложения к протоколу / протоколы для ЭДОК среди содержимого сообщения
	Если ВложенияТранспортногоСообщения = Неопределено Тогда
		ВложенияТранспортногоСообщения = ПолучитьВложенияТранспортногоСообщения(Объект.Ссылка, Истина, ТипыСодержимого);
	КонецЕсли;
	
	Результат.ЕстьВложения = ВложенияТранспортногоСообщения.Количество() > 0;
	
	XMLПриложениеКПротоколуПФР = Неопределено;
	Для ИндексТипаСодержимого = 1 По 2 Цикл
		ТипСодержимого = ?(ИндексТипаСодержимого = 1, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР,
			Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР);
		АнализироватьТипСодержимого = ?(ТипЗнч(ТипыСодержимого) = Тип("Массив"),
			ТипыСодержимого.Найти(ТипСодержимого) <> Неопределено, ТипСодержимого = ТипыСодержимого);
		Если НЕ АнализироватьТипСодержимого Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ВложениеТранспортногоСообщения Из ВложенияТранспортногоСообщения Цикл
			Если ВложениеТранспортногоСообщения.Тип = ТипСодержимого Тогда
				СвойстваФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВложениеТранспортногоСообщения.ИмяФайла);
				Если ВРЕГ(СвойстваФайла.Расширение) = ВРЕГ(".xml") Тогда
					XMLПриложениеКПротоколуПФР = ВложениеТранспортногоСообщения;
					
					ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
					XMLПриложениеКПротоколуПФР.Данные.Получить().Записать(ИмяВременногоФайла);
					ДеревоXMLПриложенияКПротоколуПФР = ЗагрузитьXMLВДеревоЗначений(ИмяВременногоФайла);
					ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
					
					Если ДеревоXMLПриложенияКПротоколуПФР <> Неопределено Тогда
						УзелУОРР = Неопределено;
						УзелУОНД = Неопределено;
						УзелАДИ_РЕГ = Неопределено;
						УзелАДИ_8 = Неопределено;
						УзелАВП_ПУ = Неопределено;
						УзелРПОП_ПУ = Неопределено;
						УзелРОПОП_ПУ = Неопределено;
						УзелТУФС_ПУ = Неопределено;
						УзелУППО = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "УПП", "Э");
						Если НЕ ЗначениеЗаполнено(УзелУППО) Тогда
							УзелУОРР = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "УОРР", "Э");
							Если НЕ ЗначениеЗаполнено(УзелУОРР) Тогда
								УзелУОНД = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "УОНД", "Э");
								Если НЕ ЗначениеЗаполнено(УзелУОНД) Тогда
									УзелАДИ_РЕГ = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "АДИ-РЕГ", "Э");
									Если НЕ ЗначениеЗаполнено(УзелАДИ_РЕГ) Тогда
										УзелАДИ_8 = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "АДИ-8", "Э");
										Если НЕ ЗначениеЗаполнено(УзелАДИ_8) Тогда
											УзелАВП_ПУ = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "АВП-ПУ", "Э");
											Если НЕ ЗначениеЗаполнено(УзелАВП_ПУ) Тогда
												УзелРПОП_ПУ = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "РПОП-ПУ", "Э");
												Если НЕ ЗначениеЗаполнено(УзелРПОП_ПУ) Тогда
													УзелРОПОП_ПУ = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "РОПОП-ПУ", "Э");
													Если НЕ ЗначениеЗаполнено(УзелРОПОП_ПУ) Тогда
														УзелТУФС_ПУ = НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,,, "ТУФС-ПУ", "Э");
													КонецЕсли;
												КонецЕсли;
											КонецЕсли;
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(УзелУОНД) ИЛИ ЗначениеЗаполнено(УзелАДИ_8) ИЛИ ЗначениеЗаполнено(УзелАВП_ПУ)
							ИЛИ ЗначениеЗаполнено(УзелРПОП_ПУ) ИЛИ ЗначениеЗаполнено(УзелРОПОП_ПУ) ИЛИ ЗначениеЗаполнено(УзелТУФС_ПУ) Тогда
							
							Результат.ЕстьПриложение = Истина;
							Результат.НеСдан = Истина;
							
						ИначеЕсли ЗначениеЗаполнено(УзелАДИ_РЕГ) Тогда
							Результат.ЕстьПриложение = Истина;
							
						Иначе
							РезультатРассмотрения = Неопределено;
							Если ЗначениеЗаполнено(УзелУОРР) Тогда
								РезультатРассмотрения = НайтиСтрокиДереваЗначений(УзелУОРР,,, "РезультатРассмотрения", "Э");
								Если ЗначениеЗаполнено(РезультатРассмотрения) Тогда
									Результат.ЕстьПриложение = Истина;
									Если РезультатРассмотрения.Значение = "2" Тогда
										Результат.НеСдан = Истина;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							
							Если НЕ ЗначениеЗаполнено(РезультатРассмотрения) Тогда
								УзлыУППКодРезультата = Новый Массив;
								НайтиСтрокиДереваЗначений(ДеревоXMLПриложенияКПротоколуПФР,, УзлыУППКодРезультата, "КодРезультата", "Э");
								
								Для каждого УзелУППКодРезультата Из УзлыУППКодРезультата Цикл
									Результат.ЕстьПриложение = Истина;
									ЗначениеКодаРезультата = СокрЛП(УзелУППКодРезультата.Значение);
									Если ЗначениеКодаРезультата = "30" ИЛИ ЗначениеКодаРезультата = "40" Тогда
										Результат.СданЧастично = Истина;
									ИначеЕсли ЗначениеКодаРезультата = "50" Тогда
										Результат.СданЧастично = Ложь;
										Результат.НеСдан = Истина;
										Прервать;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					Если Результат.ЕстьПриложение Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСтрокиДереваЗначений(
		СтрокаДереваЗначений,
		ОкончаниеИмени = Неопределено,
		МассивНайденныхСтрок = Неопределено,
		ПолноеИмя = Неопределено,
		ТипЭлемента = Неопределено,
		ВключаяПодчиненные = Истина) Экспорт
	
	ЗначениеОкончанияИмени = ОкончаниеИмени;
	Если НЕ ЗначениеЗаполнено(ЗначениеОкончанияИмени) И ЗначениеЗаполнено(ПолноеИмя) Тогда
		ЗначениеОкончанияИмени = ":" + СокрЛП(ПолноеИмя);
	КонецЕсли;
	
	Если МассивНайденныхСтрок = Неопределено Тогда
		МассивНайденныхСтрок = Новый Массив;
	КонецЕсли;
	
	МассивСтрокПолногоИмени = Неопределено;
	Если ПолноеИмя <> Неопределено Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Имя", ПолноеИмя);
		Если ТипЭлемента <> Неопределено Тогда
			ПараметрыОтбора.Вставить("Тип", ТипЭлемента);
		КонецЕсли;
		
		МассивСтрокПолногоИмени = ?(СтрокаДереваЗначений = Неопределено, Новый Массив,
			СтрокаДереваЗначений.Строки.НайтиСтроки(ПараметрыОтбора, ВключаяПодчиненные));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивНайденныхСтрок, МассивСтрокПолногоИмени);
	КонецЕсли;
	
	Если ЗначениеОкончанияИмени <> Неопределено И (МассивСтрокПолногоИмени = Неопределено
		ИЛИ МассивСтрокПолногоИмени.Количество() = 0) Тогда
		
		ДлинаОкончанияИмени = СтрДлина(ЗначениеОкончанияИмени);
		Если СтрокаДереваЗначений <> Неопределено Тогда
			Для каждого СтрокаДерева Из СтрокаДереваЗначений.Строки Цикл
				Если Прав(СтрокаДерева.Имя, ДлинаОкончанияИмени) = ЗначениеОкончанияИмени
					И (ТипЭлемента = Неопределено ИЛИ СтрокаДерева.Тип = ТипЭлемента) Тогда
					
					МассивНайденныхСтрок.Добавить(СтрокаДерева);
				КонецЕсли;
				
				Если ВключаяПодчиненные Тогда
					НайтиСтрокиДереваЗначений(
						СтрокаДерева,
						ЗначениеОкончанияИмени,
						МассивНайденныхСтрок,,
						ТипЭлемента,
						ВключаяПодчиненные);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ?(МассивНайденныхСтрок.Количество() > 0, МассивНайденныхСтрок[0], Неопределено);
	
КонецФункции

Функция ПолучитьПоследнююОтправкуОтчета(КонтролирующийОрган, ОтчетСсылка) Экспорт
	
	Если КонтролирующийОрган = "ФСС" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
		Возврат ПолучитьПоследнююОтправкуОтчетаВФСС(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "ФСРАР" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФСРАР Тогда
		Возврат ПолучитьПоследнююОтправкуОтчетаВФСРАР(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "РПН" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.РПН Тогда
		Возврат ПолучитьПоследнююОтправкуОтчетаВРПН(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "ФТС" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
		Возврат ПолучитьПоследнююОтправкуОтчетаВФТС(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "УдалитьБанкРоссии"
		ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.УдалитьБанкРоссии Тогда
		
		Возврат ПолучитьПоследнююОтправкуОтчетаВБанкРоссии(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "Минобороны"
		ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.Минобороны Тогда
		
		Возврат ПолучитьПоследнююОтправкуОтчетаВМинобороны(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = "РЭЦ" ИЛИ КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.РЭЦ Тогда
		Возврат ПолучитьПоследнююОтправкуОтчетаВРЭЦ(ОтчетСсылка);
		
	ИначеЕсли КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов.РегистрацияЮЛФНС Тогда
		МодульДокументооборотРегистрацияВФНС = ОбщегоНазначения.ОбщийМодуль("ДокументооборотРегистрацияВФНС");
		Возврат МодульДокументооборотРегистрацияВФНС.ПоследняяОтправкаПоПредмету(ОтчетСсылка);
		
	Иначе
		Возврат ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(ОтчетСсылка);
	КонецЕсли;
	
КонецФункции

Функция ОрганизацияИспользуетОбменСБанкомРоссии(ОрганизацияСсылка) Экспорт
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаУдалитьЦБСуществует() Тогда
		МодульУдалитьДокументооборотСБанкомРоссии = ОбщегоНазначения.ОбщийМодуль("УдалитьДокументооборотСБанкомРоссии");
		НастройкиОбменаСБанком = МодульУдалитьДокументооборотСБанкомРоссии.ПолучитьНастройки(ОрганизацияСсылка);
		
		Возврат НастройкиОбменаСБанком.ИспользоватьОбмен;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

