Функция РаспаковатьПакет(ФайлПакета, ТипСообщения = Неопределено, СсылкаНаОбъект = Неопределено)
	
	КаталогРаспаковки = КаталогВременныхФайлов();
	КаталогРаспаковки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогРаспаковки);
	КаталогРаспаковки = КаталогРаспаковки + Строка(Новый УникальныйИдентификатор);
	КаталогРаспаковки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогРаспаковки);
	
	СоздатьКаталог(КаталогРаспаковки);
	
	Попытка
		ЧтениеЗИП = Новый ЧтениеZipФайла(ФайлПакета);
		Если ТипСообщения = "ПФР" Тогда
			ИмяФайлаОписанияСведений = "packageDescription.xml";
			ЭлементОписаниеСведений = ЧтениеЗИП.Элементы.Найти(ИмяФайлаОписанияСведений);
			Если ЭлементОписаниеСведений = Неопределено Тогда
				// обход ошибки платформы для архива zip с кодировкой имен файлов cp866, сформированного в Linux
				ЧтениеЗИП.Закрыть();
				МассивОписанийИДанных = ОбщегоНазначенияЭДКО.МассивОписанийИДанныхZipФайла(ФайлПакета);
				Если МассивОписанийИДанных <> Неопределено Тогда
					ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлПакета);
					ФайлПакета = ФайлПакета + ".zip";
					ОбщегоНазначенияЭДКО.СформироватьZip(МассивОписанийИДанных, ФайлПакета);
				КонецЕсли;
				ЧтениеЗИП = Новый ЧтениеZipФайла(ФайлПакета);
			КонецЕсли;
		КонецЕсли;
		ЧтениеЗИП.ИзвлечьВсе(КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		ЧтениеЗИП.Закрыть();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Распаковка пакета';
				|en = 'Electronic data interchange with regulatory authorities. Unpacking'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогРаспаковки);
		Если СсылкаНаОбъект <> Неопределено Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
				НСтр("ru = 'Повреждено содержимое транспортного контейнера сообщения';
					|en = 'The content of the message transport container is corrupted'"),,,,,
				НовыйКонтекстРасшифровки(СсылкаНаОбъект));
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат КаталогРаспаковки;
	
КонецФункции

// Добавляет перед расшифровкой отметку времени в регистр
// И удаляет её после успешного завершения расшифровки
Процедура ЗафиксироватьПопыткуРасшифровки(ТранспортноеСообщение, Очистить = Ложь) Экспорт
	НаборЗаписей = РегистрыСведений.ПоследняяПопыткаРасшифровкиТранспортногоСообщения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТранспортноеСообщение.Установить(ТранспортноеСообщение);	
	
	Если Не Очистить Тогда 
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДатаПопытки = ТекущаяДатаСеанса();
		НоваяЗапись.ТранспортноеСообщение = ТранспортноеСообщение;
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
КонецПроцедуры

Функция ОбработатьСодержимоеТранспортногоКонтейнера(Объект, ДокументыПакета, ТаблицаРаспакованныхФайлов, ПеремещенВАрхив = Ложь) Экспорт
	
	ДокументыПакета.Очистить();
	ТаблицаРаспакованныхФайлов.Очистить();
	
	Результат = Новый Структура;
	
	Если Не ТранспортноеСообщениеОбрабатывается(Объект.Ссылка) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьПопыткуРасшифровки(Объект.Ссылка);
	
	// получаем расшифровываемый контейнер
	ЗначениеДанныхПриОшибкеЧтения = "Исключение при получении присоединенного файла";
	ТранспортныеКонтейнеры = ПолучитьТранспортныйКонтейнер(Объект.Ссылка, Истина,, ЗначениеДанныхПриОшибкеЧтения);
	Если ТранспортныеКонтейнеры.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТранспортныйКонтейнер = ТранспортныеКонтейнеры[0];
	
	ПеремещенВАрхив = ТранспортныйКонтейнер.Перемещен;
	
	// выгружаем контейнер во временный файл
	ТекстСообщения = "";
	ВремФайл = ПолучитьИмяВременногоФайла();
	Попытка
		ТранспортныйКонтейнерДвДанные = ТранспортныйКонтейнер.Данные.Получить();
		Если ТипЗнч(ТранспортныйКонтейнерДвДанные) = Тип("Строка")
			И ТранспортныйКонтейнерДвДанные = ЗначениеДанныхПриОшибкеЧтения Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка при чтении присоединенного файла транспортного контейнера. Проверьте доступность томов на сетевом диске или в хранилище.';
									|en = 'An error occurred while reading the attached transport container file. Check the availability of volumes on a network drive or storage.'");
		ИначеЕсли ТранспортныйКонтейнерДвДанные = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Пустое содержимое транспортного контейнера. Возможно, повреждена база.';
									|en = 'Empty transport container contents. The infobase may be corrupt.'");
		Иначе
			ТранспортныйКонтейнерДвДанные.Записать(ВремФайл);
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка сохранения во временный файл:%1';
																						|en = 'An error occurred while saving to the temporary file:%1'"), Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Если ПеремещенВАрхив Тогда
		ОдинТК = 1;
		ВсеОшибки = ДлительнаяОтправкаКлиентСервер.ЗначениеПараметраДлительнойОтправки("Ошибки");
		Если ТипЗнч(ВсеОшибки) = Тип("ФиксированнаяСтруктура") Тогда
			РеестрОшибок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВсеОшибки, "ПриИзвлеченииАрхива");
			Если ТипЗнч(РеестрОшибок) = Тип("Массив") Тогда
				ОдинТК = РеестрОшибок.Количество();
			КонецЕсли;
		КонецЕсли;
		Если ОдинТК > 1 Тогда
			ТекстОшибки = 
				НСтр("ru = 'Не удалось расшифровать %1 сообщений, потому что файлы были перемещены в архив.';
					|en = 'Cannot decrypt %1 messages as the files were archived.'") + Символы.ПС
				+ НСтр("ru = 'Обратитесь в техническую поддержку.';
						|en = 'Contact technical support.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, ОдинТК);
		Иначе
			ТекстОшибки = НСтр("ru = 'Не удалось расшифровать сообщение, потому что файл был перемещен в архив.';
								|en = 'Cannot decrypt the message as the file was archived.'") + Символы.ПС
				+ НСтр("ru = 'Обратитесь в техническую поддержку.';
						|en = 'Contact technical support.'");
		КонецЕсли;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки,,,,, НовыйКонтекстПеремещенногоАрхива(Объект));
		Возврат Ложь;
		
	ИначеЕсли ЗначениеЗаполнено(ТекстСообщения) Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения,,,,, НовыйКонтекстРасшифровки(Объект));
		Возврат Ложь;
		
	КонецЕсли;
	
	// сообщения ПФР
	Если Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияЗапросаПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ОтветНаЗапросПФР
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР Тогда
		Результат.Вставить("ТипСообщения", "ПФР");
		
	// сообщения ФСГС
	ИначеЕсли Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаШаблоновФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоИсходящееФСГС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФСГС Тогда
		Результат.Вставить("ТипСообщения", "ФСГС");
		
	// сообщения ЦБ
	ИначеЕсли Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатЗагрузкиЦБ
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументЦБ
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДокументЦБ
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеЦБ Тогда
		Результат.Вставить("ТипСообщения", "ЦБ");
		
	// сообщения ФНС 534
	ИначеЕсли Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеДекларацияНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДекларацияНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеФорма2НДФЛНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеФорма2НДФЛНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаФорма2НДФЛНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбращениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаОбращениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеОбращениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФНС
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗапросНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗапросНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗапросНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПисьмоНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РассылкаНО 
	
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеПредставлениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПредставлениеНО
	
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗаявлениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗаявлениеНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО
	
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеНО
	
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеРФНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.СообщениеОбОтзывеЗаявлениеРФНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеТСНО
	
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ДокументНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНО
	ИЛИ Объект.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗапросаНаВыпискуЕРГЮЛ_ЕГРИП Тогда
		Результат.Вставить("ТипСообщения", "ФНС_534");
	//ФНС 141
	Иначе // тип "ФНС_141" больше не используется
		Если Объект.Тип = Перечисления.ТипыТранспортныхСообщений.Прочее Тогда
			Возврат Истина; // не требует расшифровки
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТипСообщения = Неопределено;
	Результат.Свойство("ТипСообщения", ТипСообщения);
	
	// распаковываем пакет
	КаталогФайловПакета = РаспаковатьПакет(ВремФайл, ТипСообщения, Объект.Ссылка);
	// помещаем распакованные файлы во временное хранилище
	МассивРаспакованныхФайлов = НайтиФайлы(КаталогФайловПакета, "*");
	Попытка
		Для Каждого ЭлементМассива Из МассивРаспакованныхФайлов Цикл
			ГУИД = Новый УникальныйИдентификатор;
			Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ЭлементМассива.ПолноеИмя), ГУИД);
			НоваяСтрока = ТаблицаРаспакованныхФайлов.Добавить();
			НоваяСтрока.Адрес = Адрес;
			НоваяСтрока.Имя = ЭлементМассива.Имя;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Чтение ZIP';
				|en = 'Electronic data interchange with regulatory authorities. Reading ZIP'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	ФорматДокументооборота = Неопределено;
	Если ТипСообщения = "ЦБ" Тогда
		ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "status.xml");
		Если ФайлОписанияСведений.Количество() = 0 Тогда
			ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "StatusInfo.xml");
		КонецЕсли;
		
	Иначе
		ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "packageDescription.xml");
	КонецЕсли;
	
	Если ФайлОписанияСведений.Количество() = 0 Тогда
		Если ТипСообщения = "ПФР" Тогда
			ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "ПФР_*_ОСП_*.xml");
			Если ФайлОписанияСведений.Количество() = 0 Тогда
				ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "СФР_*_ОСП_*.xml");
				Если ФайлОписанияСведений.Количество() = 0 Тогда
					ФайлОписанияСведений = НайтиФайлы(КаталогФайловПакета, "СФР_ОСП_*.xml");
				КонецЕсли;
			КонецЕсли;
			Если ФайлОписанияСведений.Количество() <> 0 Тогда
				ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
			КонецЕсли;
		КонецЕсли;
		
		Если ФайлОписанияСведений.Количество() = 0 Тогда
			ТекстСообщения = ?(ТипСообщения = "ПФР",
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания пакета (ПФР_*_ОСП_*.xml или packageDescription.xml).';
					|en = 'Package unpacking error: package description file was not found (PFR_*_ OSP_*.xml or packageDescription.xml).'"),
				?(ТипСообщения = "ЦБ",
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания сведений (status.xml или StatusInfo.xml).';
					|en = 'An error occurred when unpacking the package: the information description file (status.xml or StatusInfo.xml) is not found.'"),
				НСтр("ru = 'Ошибка распаковки пакета: не найден файл описания пакета (packageDescription.xml).';
					|en = 'An error occurred while unpacking the package: package description file is not found (packageDescription.xml).'")));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения,,,,, НовыйКонтекстРасшифровки(Объект));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайлаОписанияСведений = ФайлОписанияСведений[0].ПолноеИмя;
	КороткоеИмяФайлаОписанияСведений = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаОписанияСведений).Имя;
	
	// считываем файл описания пакета
	ТекстXML = Неопределено;
	ДеревоОписанияСведений = ЗагрузитьXMLВДеревоЗначений(ИмяФайлаОписанияСведений, ТекстXML);
	Если ДеревоОписанияСведений = Неопределено Тогда
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОписанияСведений);
		Возврат Ложь;
	КонецЕсли;
	
	УбратьСообщениеИзОбработки = Неопределено;
	
	Если ТипСообщения = "ПФР" И ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
		УзелОСП = НайтиСтрокиДереваЗначений(ДеревоОписанияСведений,,, "ОСП", "Э");
		Если НЕ ЗначениеЗаполнено(УзелОСП) Тогда
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОписанияСведений);
			Возврат Ложь;
		КонецЕсли;
		
		УзелЗашифровано = НайтиСтрокиДереваЗначений(УзелОСП,,, "Зашифровано", "Э", Ложь);
		ДокументыЗашифрованы = ?(ЗначениеЗаполнено(УзелЗашифровано), БулевоПоСтроке(УзелЗашифровано.Значение), Неопределено);
		
		УзлыДокумент = Новый Массив;
		НайтиСтрокиДереваЗначений(УзелОСП,, УзлыДокумент, "Документ", "Э", Ложь);
		УзелДополнительныеДокументы = НайтиСтрокиДереваЗначений(УзелОСП,,, "ДополнительныеДокументы", "Э", Ложь);
		УзлыДополнительныйДокумент = Неопределено;
		Если ЗначениеЗаполнено(УзелДополнительныеДокументы) Тогда
			УзлыДополнительныйДокумент = Новый Массив;
			НайтиСтрокиДереваЗначений(УзелДополнительныеДокументы,, УзлыДополнительныйДокумент, "Документ", "Э", Ложь);
		КонецЕсли;
		
		Для НомерУзловДокументов = 1 По ?(УзлыДополнительныйДокумент = Неопределено, 1, 2) Цикл
			ЭтоДополнительныйДокумент = (НомерУзловДокументов = 2);
			Если ЭтоДополнительныйДокумент Тогда
				УзлыДокумент = УзлыДополнительныйДокумент;
			КонецЕсли;
			
			Для каждого УзелДокумент Из УзлыДокумент Цикл
				УзелКод = НайтиСтрокиДереваЗначений(УзелДокумент,,, "Код", "Э", Ложь);
				КодДокумента = ?(ЗначениеЗаполнено(УзелКод), СокрЛП(УзелКод.Значение), "");
				
				УзелФайл = НайтиСтрокиДереваЗначений(УзелДокумент,,, "Файл", "Э", Ложь);
				ИмяФайлаДокумента = ?(ЗначениеЗаполнено(УзелФайл), СокрЛП(УзелФайл.Значение), "");
				Если (ВРег(КодДокумента) = "УОД" ИЛИ ВРег(КодДокумента) = "УОПП" ИЛИ ВРег(КодДокумента) = "УОНД")
					И НЕ ЗначениеЗаполнено(УзелЗашифровано) И (нрег(Прав(ИмяФайлаДокумента, 4)) = ".enc") Тогда // Обход ошибки ПФР
					ИмяФайлаДокумента = Лев(ИмяФайлаДокумента, СтрДлина(ИмяФайлаДокумента) - 4);
				КонецЕсли;
				
				УзелТипФайла = НайтиСтрокиДереваЗначений(УзелДокумент,,, "ТипФайла", "Э", Ложь);
				ТипФайлаДокумента = ?(ЗначениеЗаполнено(УзелТипФайла), СокрЛП(УзелТипФайла.Значение), "");
				Если ТипФайлаДокумента = "application/gzip" Тогда // Обход ошибки ПФР
					ТипФайлаДокумента = "application/xml";
				КонецЕсли;
				
				Если ДокументыЗашифрованы <> Неопределено Тогда
					ДокументЗашифрован = ДокументыЗашифрованы;
				Иначе
					РасширениеДокументаНРег = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаДокумента).Расширение;
					РасширениеДокументаНРег = нрег(РасширениеДокументаНРег);
					ДокументЗашифрован = (РасширениеДокументаНРег = ".enc"
						ИЛИ (РасширениеДокументаНРег <> ".gz" И РасширениеДокументаНРег <> ".der"
						И ТипСодержимогоПоИмениФайла(ИмяФайлаДокумента) = Перечисления.ТипыСодержимогоФайлов.Неизвестный));
				КонецЕсли;
				
				УзелСжатие = НайтиСтрокиДереваЗначений(УзелДокумент,,, "Сжатие", "Э", Ложь);
				ДокументСжатСтр = ?(ЗначениеЗаполнено(УзелСжатие), УзелСжатие.Значение, "");
				ДокументСжат = БулевоПоСтроке(ДокументСжатСтр);
				Если ДокументСжат = Неопределено Тогда
					ТекстСообщения = СтрШаблон(
						НСтр("ru = 'Ошибка при распаковке пакета: некорректная структура файла описания пакета (%1).';
							|en = 'An error occurred while unpacking a package: incorrect structure of package description file (%1).'"),
						КороткоеИмяФайлаОписанияСведений);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения,,,,, НовыйКонтекстРасшифровки(Объект));
					ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОписанияСведений);
					Возврат Ложь;
				КонецЕсли;
				
				УзелФайлЭП = НайтиСтрокиДереваЗначений(УзелДокумент,,, "ФайлЭП", "Э", Ложь);
				ИмяФайлаПодписи = ?(ЗначениеЗаполнено(УзелФайлЭП), СокрЛП(УзелФайлЭП.Значение), "");
				ЕстьОткрепленнаяПодпись = ЗначениеЗаполнено(ИмяФайлаПодписи);
				
				НайденныеСтроки = ТаблицаРаспакованныхФайлов.НайтиСтроки(Новый Структура("Имя", ИмяФайлаДокумента));
				АдресФайлаДокумента = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Адрес, Неопределено);
				
				Если ДокументЗашифрован Тогда
					ДополнитьТранспортноеСообщениеПолучателями(Объект, АдресФайлаДокумента);
					Если УбратьСообщениеИзОбработки = Неопределено Тогда
						УбратьСообщениеИзОбработки = НЕ ТранспортноеСообщениеОбрабатывается(Объект);
					КонецЕсли;
				КонецЕсли;
				
				НайденныеСтроки = ТаблицаРаспакованныхФайлов.НайтиСтроки(Новый Структура("Имя", ИмяФайлаПодписи));
				АдресФайлаПодписи = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0].Адрес, Неопределено);
				
