	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	// определяем последнюю отправку
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ОтправкаСсылка = ДополнительныеПараметры.Отправка;
	Иначе
		ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСС(СсылкаНаОтчет);
	КонецЕсли;	
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправлено();
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	ЭтоМашиночитаемаяДоверенностьФСС = (ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС"));
	
	Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		ОбъектПоУмолчаниюРеестрЭЛНСуществует =
			Метаданные.Документы.Найти("РеестрДанныхЭЛНЗаполняемыхРаботодателем") <> Неопределено;
		ЭтоРеестрЭЛН = ДокументооборотСФССКлиентСервер.ЭтоРеестрДанныхЭЛНЗаполняемыхРаботодателем(СсылкаНаОтчет,
			ОбъектПоУмолчаниюРеестрЭЛНСуществует);
		
		Если ЭтоРеестрЭЛН И (НачальныйСтатус = "Сдано" ИЛИ НачальныйСтатус = "Не сдано"
			ИЛИ НачальныйСтатус = "Сдан частично") Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
			СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
			СтрокаЭтапа.Дата						= Дата(1,1,1);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Информация об отправке не сохранена или статус изменен вручную';
															|en = 'Sending information is not saved or status has been changed manually'");
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
			СтрокаЭтапа.ЭтапПройден					= Истина;
			
		ИначеЕсли ЭтоМашиночитаемаяДоверенностьФСС Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОтчет, "Статус") =
				Перечисления.СтатусыМашиночитаемойДоверенностиКО.Подписано Тогда
				
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Подписано';
																|en = 'Signed'");
				СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Подписано';
																|en = 'Signed'");
				СтрокаЭтапа.Дата						= Дата(1,1,1);
				СтрокаЭтапа.КомментарийКСостоянию		= "";
				СтрокаЭтапа.НаименованиеПротокола		= "";
				СтрокаЭтапа.Протокол					= "";
				СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
				СтрокаЭтапа.ЭтапПройден					= Истина;
			КонецЕсли;
		КонецЕсли;
		
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	ОбменЧерезОператора = ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ОбменЧерезОператора, Ложь);
	
	ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
		СсылкаНаОтчет,,
		?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, ТекущаяДатаСеанса()),
		Перечисления.ТипыКонтролирующихОрганов.ФСС);
	
	ТекстОтправленоВСФР = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
		НСтр("ru = 'Отправлено в ФСС';
			|en = 'Sent to SSF'"),,, НЕ ЭтоОтправкаВСФР);
	
	КомментарийОтправленоОператору = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
		НСтр("ru = 'Ожидается подтверждение доставки в ФСС';
			|en = 'Waiting for confirmation of delivery to SSF'"),,, НЕ ЭтоОтправкаВСФР);
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																			|en = 'Sent to the provider'"), ТекстОтправленоВСФР);
	СтрокаЭтапа.ТекстСтатуса				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																			|en = 'Sent to the provider'"), ТекстОтправленоВСФР);
	СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию		= ?(ОбменЧерезОператора, КомментарийОтправленоОператору,
											  НСтр("ru = 'Ожидается результат обработки отчета';
													|en = 'Awaiting report processing result'"));
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено;
	
	Если ОбменЧерезОператора И ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстОтправленоВСФР;
		СтрокаЭтапа.ТекстСтатуса				= ТекстОтправленоВСФР;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.ДоставленоВСФР,
												  ?(ЗначениеЗаполнено(ОтправкаСсылка.ДатаЗакрытия)
												  И ОтправкаСсылка.ДатаЗакрытия < ОтправкаСсылка.ДатаДоставкиВСФР, ОтправкаСсылка.ДатаЗакрытия,
												  ОтправкаСсылка.ДатаДоставкиВСФР), Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки отчета';
														|en = 'Awaiting report processing result'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка.ДоставленоВСФР
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
	КонецЕсли;
	
	Если ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
		
		Отозвано = ?(ЭтоМашиночитаемаяДоверенностьФСС, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОтчет, "Статус") =
			Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано, Ложь);
		
		ТекстСтатуса = ?(ЭтоМашиночитаемаяДоверенностьФСС, ?(Отозвано,
			НСтр("ru = 'Отозвано';
				|en = 'Revoked'"), НСтр("ru = 'Не зарегистрировано';
											|en = 'Not registered'")), НСтр("ru = 'Не сдано';
																				|en = 'Not submitted'"));
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= ?(Отозвано, "", НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
																		|en = 'Correct errors and send the report again'"));
		СтрокаЭтапа.НаименованиеПротокола		= ?(Отозвано, НСтр("ru = 'Протокол';
																	|en = 'Protocol'"), НСтр("ru = 'Протокол ошибок';
																							|en = 'Error log'"));
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки Тогда
		
		ЭтоРеестрЭЛН = (ОтправкаСсылка.ВидОтчета =
			Справочники.ВидыОтправляемыхДокументов.РеестрДанныхЭЛНЗаполняемыхРаботодателем);
		ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам = (ОтправкаСсылка.ВидОтчета =
			Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам);
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ?(ЭтоРеестрЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
												  НСтр("ru = 'Сдан частично';
														|en = 'Submitted partially'"), ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения());
		СтрокаЭтапа.ТекстСтатуса				= ?(ЭтоРеестрЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
												  НСтр("ru = 'Сдан частично';
														|en = 'Submitted partially'"), ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения());
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= ?(ЭтоРеестрЭЛН,
												  НСтр("ru = 'При необходимости, исправьте ошибки в непринятых ЭЛН и отправьте отчет еще раз';
														|en = 'If necessary, correct errors in unaccepted ESLRs and send the report again'"),
												  ?(ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
												  НСтр("ru = 'При необходимости, исправьте ошибки и отправьте отчет еще раз';
														|en = 'Correct the errors, if required, and resend the report'"),
												  НСтр("ru = 'Подготовьте и отправьте корректирующий отчет';
														|en = 'Prepare and send adjusting report '")));
		СтрокаЭтапа.НаименованиеПротокола		= ?(ЭтоРеестрЭЛН ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам,
												  НСтр("ru = 'Протокол приема';
														|en = 'Acceptance protocol'"), НСтр("ru = 'Протокол ошибок';
																						|en = 'Error log'"));
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	Иначе
		
		ТекстСтатуса = ?(ЭтоМашиночитаемаяДоверенностьФСС, НСтр("ru = 'Зарегистрировано';
																|en = 'Registered'"), НСтр("ru = 'Сдано';
																								|en = 'Submitted'"));
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан, ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол о сдаче';
														|en = 'Delivery protocol'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиРосстат(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ОрганизацияСсылка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "Организация");
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	КомментарийКСостоянию = КомментарийКСостояниюНеОтправлено();
	Если НЕ ЗначениеЗаполнено(КомментарийКСостоянию) Тогда
		Если НЕ ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
			ОрганизацияСсылка = ?(ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет")
				ИЛИ ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОтчет, "Организация"), Неопределено);
		КонецЕсли;
		УчетнаяЗаписьСсылка = УчетнаяЗаписьОрганизации(ОрганизацияСсылка);
		Если ЗначениеЗаполнено(УчетнаяЗаписьСсылка)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗаписьСсылка, "ПредназначенаДляДокументооборотаСФСГС") = Истина
			И Мультирежим.ТипСубъектаСертификатаПользователя(УчетнаяЗаписьСсылка, ОрганизацияСсылка) = "ФЛ"
			И ДокументооборотСКОВызовСервера.МЧДОбмена(ОрганизацияСсылка, "ФСГС").Количество() = 0
			И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Обяз.МЧД фил.для Росстата", '20250501') Тогда
			
			ТекстУкажите = Новый ФорматированнаяСтрока(
				НСтр("ru = 'Внимание! С 1 июня 2025 года для отправки отчета представителями юридических лиц обязательно указание';
					|en = 'Important. Starting from June 1, 2025, legal entity representatives must specify a'") + " ",,
				ЦветаСтиля.ЦветПредупрежденияБРО);
			СсылкаНаМашиночитаемуюДоверенность = Новый ФорматированнаяСтрока(
				НСтр("ru = 'машиночитаемой доверенности';
					|en = 'machine-readable letter of authority to send a report'"),,,,
				"e1cib/command/ОбщаяКоманда.НастройкиМЧДДляФСГС");
			ТекстПередовериеВсе = Новый ФорматированнаяСтрока(
				". " + НСтр("ru = 'МЧД с передоверием пока не поддерживается Росстатом';
							|en = 'MR LOA with sub-delegation is not yet supported by Russian Federal State Statistics Service'") + ".
				|" + НСтр("ru = 'Обратите внимание, используемая МЧД должна содержать специальное полномочие предоставления статистической отчетности (код ""ROSSTAT_STAT_001"").';
							|en = 'Note that the used MR LOA must contain a special power for providing statistical reporting (code ""ROSSTAT_STAT_001"").'"),,
				ЦветаСтиля.ЦветПредупрежденияБРО);
			КомментарийКСостоянию = Новый ФорматированнаяСтрока(
				ТекстУкажите,
				СсылкаНаМашиночитаемуюДоверенность,
				ТекстПередовериеВсе);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостоянию;
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	// если у пользователя недостаточно прав для получения сведений об отправке, то скроем панель
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
		
	// получаем список всех не помеченных на удаление сообщений последнего цикла
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрПервичныеСообщения 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС));
	СтрПодтвержденияДатыОтправки 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС));
	СтрИзвещенияПодтвержденияДатыОтправки 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС));
	СтрИзвещенияОПриеме 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеОПолученииОтчетностиФСГС));
	СтрПротоколыВходногоКонтроля 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПротоколВходногоКонтроляОтчетностиФСГС));
	СтрИзвещенияПротоколыВходногоКонтроля 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПротоколВходногоКонтроляОтчетностиФСГС));
	СтрКритическиеОшибки 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.КритическаяОшибка));
	
	Если СтрПервичныеСообщения.Количество() > 0 И СтрПервичныеСообщения[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.Дата						= ДатаОтправки(СтрПервичныеСообщения, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
													|en = 'Awaiting confirmation of sending date'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщения.Количество() > 0;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в Росстат';
													|en = 'Sent to Russian Federal State Statistics Service'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в Росстат';
													|en = 'Sent to Russian Federal State Statistics Service'");
	СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияДатыОтправки, НеПолучатьДаты);;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки отчета';
													|en = 'Awaiting report processing result'");
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
													|en = 'Sending date confirmation'");
	СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияДатыОтправки.Количество() > 0, СтрПодтвержденияДатыОтправки[0].Ссылка, "");
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияДатыОтправки.Количество() > 0;

	ПоследнийПротокол = Неопределено;
	Для Каждого СтрПротокол Из СтрПротоколыВходногоКонтроля Цикл
		Если ПоследнийПротокол = Неопределено ИЛИ СтрПротокол.Дата > ПоследнийПротокол.Дата Тогда
			ПоследнийПротокол = СтрПротокол;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоследнийПротокол <> Неопределено И ПоследнийПротокол.ПротоколСОшибкой Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийПротокол, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
														|en = 'Correct errors and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола		= "Протокол ошибок";
		СтрокаЭтапа.Протокол					= ПоследнийПротокол.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли ЕстьУведомлениеОбУточненииОтчетаФСГС(ПоследнийПротокол) Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения();
		СтрокаЭтапа.ТекстСтатуса				= ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения();
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийПротокол, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
														|en = 'Correct errors and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола		= "Уведомление об уточнении";
		СтрокаЭтапа.Протокол					= ПоследнийПротокол.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	Иначе
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдано';
														|en = 'Submitted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПротоколыВходногоКонтроля, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол о сдаче';
														|en = 'Delivery protocol'");
		СтрокаЭтапа.Протокол					= ?(СтрПротоколыВходногоКонтроля.Количество() > 0, СтрПротоколыВходногоКонтроля[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрПротоколыВходногоКонтроля.Количество() > 0 И СообщениеРасшифровано(СтрПротоколыВходногоКонтроля[0].Ссылка);
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ЕстьУведомлениеОбУточненииОтчетаФСГС(ПротоколВходногоКонтроля)
	
	Если ПротоколВходногоКонтроля = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УведомленияОбУточнении = ПолучитьВложенияТранспортногоСообщения(
		ПротоколВходногоКонтроля.Ссылка,
		,
		Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточненииОтчетаФСГС);
		
	Возврат УведомленияОбУточнении.Количество() > 0;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиФНС(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	ЭтоУведомление = ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения");
	Если ЭтоУведомление Тогда
		КомментарийКСостояниюНеОтправлено = "";
	Иначе
		КомментарийКСостояниюНеОтправлено = КомментарийКСостояниюНеОтправлено();
	КонецЕсли;

	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправлено;
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	// если у пользователя недостаточно прав для получения сведений об отправке, то скроем панель
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		МЧДФНСПодписана = ?(ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС"),
			ДокументооборотСКОВызовСервера.МЧДПодписана(СсылкаНаОтчет), Ложь);
		
		Если МЧДФНСПодписана Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Подписано';
															|en = 'Подписано'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Подписано';
															|en = 'Signed'");
			СтрокаЭтапа.Дата 						= Дата(1,1,1);
			СтрокаЭтапа.КомментарийКСостоянию 		= "";
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
		КонецЕсли;
		
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	// получаем список всех не помеченных на удаление сообщений последнего цикла
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
		
	Если ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Заявление Тогда
		
		// выделяем основные типы сообщений
		СтрЗаявленияНП 							= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП));
		СтрПодтвержденияЗаявлениеНО				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеЗаявлениеНО));
		СтрИзвещенияПодтверждениеНП 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
		СтрИзвещенияЗаявлениеНО 				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗаявлениеНО));
		СтрРезультатыПриемаЗаявлениеНО 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗаявлениеНО));
		СтрИзвещенияРезультатПриемаНП 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
		
		СтрРезультатыОбработкиЗаявлениеНО		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеНО));
		СтрИзвещенияРезультатОбработкиНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП));
	
		СтрРезультатыОбработкиЗаявлениеРФНО		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиЗаявлениеРФНО));
		СтрИзвещенияРезультатОбработкиРФНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиРФНП));
		СтрСообщенияОбОтзывеЗаявлениеРФНО 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.СообщениеОбОтзывеЗаявлениеРФНО));
		СтрИзвещенияОбОтзывеЗаявлениеРФНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбОтзывеЗаявлениеРФНП));
