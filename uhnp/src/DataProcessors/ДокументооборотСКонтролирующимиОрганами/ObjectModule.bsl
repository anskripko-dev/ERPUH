	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.КвитанцияОПриемеЗаявления Тогда
		Возврат "квитанцияОПриеме";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПроверке Тогда
		Возврат "сообщениеОПроверке";	
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОбОтзывеЗаявления Тогда
		Возврат "сообщениеОбОтзывеЗаявления";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОНесоответствиях Тогда
		Возврат "сообщениеОНесоответствиях";
		
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СообщениеОПростОтметки Тогда
		Возврат "сообщениеОПростОтметки";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтметки Тогда
		Возврат "уведомлениеОбОтказеОтметки";
		
	//2НДФЛ		
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведений2НДФЛ Тогда
		Возврат "описание";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Форма2НДФЛ Тогда
		Возврат "форма2НДФЛ";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Протокол2НДФЛ Тогда
		Возврат "протоколПриема2НДФЛ";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Реестр2НДФЛ Тогда
		Возврат "реестрПринятыхДокументов";
		
	// обращение
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Обращение Тогда
		Возврат "обращение";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийОбращениеПисьмоРассылка Тогда
		Возврат "описание";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Приложение Тогда
		Возврат "приложение";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыПолучения Тогда
		Возврат "подтверждениеДатыПолучения";
		
	// представление
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление Тогда
		Возврат "представление";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьПредставление Тогда
		Возврат "доверенность";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПредставление Тогда
		Возврат "описание";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеДатыОтправкиПредставление Тогда
		Возврат "подтверждениеДатыОтправки";
		
	// запрос
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос Тогда
		Возврат "запрос";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Ответ Тогда
		Возврат "ответ";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеСведенийЗапрос Тогда
		Возврат "описание";
		
	// запрос на выписку ЕГРЮЛ/ЕГРИП
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП Тогда
		Возврат "запрос";
		
	// Росстат
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиФСГС Тогда
		Возврат "отчет";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеФайлаОтчетностиФСГС Тогда
		Возврат "описаниеОтчета";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ИзвещениеОПолученииДокументаФСГС Тогда
		Возврат "извещениеОПолучении";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПисьмоФСГС Тогда
		Возврат "письмо";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеПисьмаФСГС Тогда
		Возврат "описаниеПисьма";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПриложениеПисьмаФСГС Тогда
		Возврат "приложениеПисьма";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОПриемеВОбработкуОтчетаФСГС Тогда
		Возврат "уведомлениеОПриемеВОбработку";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОНесоответствииФорматуОтчетаФСГС Тогда
		Возврат "уведомлениеОНесоответствииФормату";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбУточненииОтчетаФСГС Тогда
		Возврат "уведомлениеОбУточнении";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтказеОтчетаФСГС Тогда
		Возврат "уведомлениеОбОтказе";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.УведомлениеОбОтклоненииОтчетаФСГС Тогда
		Возврат "уведомлениеОбОтклоненииОтчета";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.РассылкаФСГС Тогда
		Возврат "рассылка";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ШаблонФСГС Тогда
		Возврат "шаблон";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеРассылкиШаблоновФСГС Тогда
		Возврат "описаниеРассылкиШаблонов";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеОператораФСГС Тогда
		Возврат "подтверждениеОператора";
		
		
	// запросы ПФР
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЗапросИОС Тогда
		Возврат "запрос";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОписанияЗапросаПФР Тогда
		Возврат "описаниеЗапроса";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияЗапросПФР Тогда
		Возврат "подтверждениеПолучения";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветНаЗапросПФР Тогда
		Возврат "ответ";
	ИначеЕсли ТипДокумента = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОтветПриложениеНаЗапросПФР Тогда
		Возврат "ответПриложение";
		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент) Экспорт
	
	ИмяДобавляемогоФайла = ?(ЗначениеЗаполнено(СтрДокумент.ИмяФайлаАрхива), СтрДокумент.ИмяФайлаАрхива, СтрДокумент.ИмяФайлаДокумента);
	ПолноеИмяДобавляемогоФайла = КаталогФайловОтчетности + ИмяДобавляемогоФайла;
	ДвоичныеДанныеФайла = ?(ЗначениеЗаполнено(СтрДокумент.Адрес), ПолучитьИзВременногоХранилища(СтрДокумент.Адрес),
		Неопределено);
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеФайла) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Содержимое файла транспортного сообщения недоступно: %1';
				|en = 'Transport message file content is unavailable: %1'"),
			ИмяДобавляемогоФайла);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанныеФайла.Записать(ПолноеИмяДобавляемогоФайла);
	
	Возврат ПолноеИмяДобавляемогоФайла;
	
КонецФункции

Функция СоздатьДеревоОписанияДокументовПакета() Экспорт
	
	ДеревоОписанияДокументовПакета = Новый ДеревоЗначений;
	ДеревоОписанияДокументовПакета.Колонки.Добавить("ТипДокумента");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("ТипСодержимого");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("ИдентификаторДокумента");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("Сжат");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("Зашифрован");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("ИмяФайлаДокумента");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("ИмяФайлаАрхива");
	ДеревоОписанияДокументовПакета.Колонки.Добавить("Адрес");
	Возврат ДеревоОписанияДокументовПакета;
	
КонецФункции

Функция ЗаархивироватьФайлПакета(
		СтрВложение,
		ИмяФайлаАрхива = Неопределено,
		ИдентификаторДляВременногоХранилища = Неопределено,
		ТипАрхива = Неопределено) Экспорт
	
	// создаем временный каталог, в который помещаем пакуемый файл
	ВременныйКаталог = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// получаем двоичные данные файла из временного хранилища
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(СтрВложение.Адрес);
	
	// если имя файла архива не задано, то генерируем новое
	Если ИмяФайлаАрхива = Неопределено Тогда
		ИмяФайлаАрхива = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	КонецЕсли;
	
	// формируем имя временного файла
	ПолноеИмяАрхивируемогоФайла = ВременныйКаталог + ИмяФайлаАрхива;
	
	// выгружаем двоичные данные в файл
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеФайла) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Ошибка создания архивного файла: %1';
				|en = 'An error occurred when creating an archive file: %1'"),
			ИмяФайлаАрхива);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанныеФайла.Записать(ПолноеИмяАрхивируемогоФайла);
	
	// пишем архив
	КороткоеИмяФайлаАрхива = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаАрхива = ВременныйКаталог + КороткоеИмяФайлаАрхива;
	Если ТипАрхива = "gzip" Тогда
		КороткоеИмяФайлаАрхиваGzip = ИмяФайлаАрхива + ".gz.enc";
		ПолноеИмяФайлаАрхиваGzip = ВременныйКаталог + КороткоеИмяФайлаАрхиваGzip;
	КонецЕсли;
	Попытка
		ОбъектЗаписьЗИП = Новый ЗаписьZipФайла(ПолноеИмяФайлаАрхива,,,,
			?(ТипАрхива = "gzip", УровеньСжатияZIP.Оптимальный, УровеньСжатияZIP.Максимальный));
		ОбъектЗаписьЗИП.Добавить(ПолноеИмяАрхивируемогоФайла);
		ОбъектЗаписьЗИП.Записать();
		Если ТипАрхива = "gzip" Тогда
			МассивОписанийИДанных = ОбщегоНазначенияЭДКО.МассивОписанийИДанныхZipФайла(ПолноеИмяФайлаАрхива, Истина);
			Если МассивОписанийИДанных = Неопределено Тогда
				ОшибкаАрхивирования = НСтр("ru = 'Неверный формат архива';
											|en = 'Invalid archive format'");
			Иначе
				МассивОписанийИДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(МассивОписанийИДанных[0]);
				ОбщегоНазначенияЭДКО.СформироватьGzip(МассивОписанийИДанных, ПолноеИмяФайлаАрхиваGzip);
				ОшибкаАрхивирования = "";
			КонецЕсли;
		Иначе
			ОшибкаАрхивирования = "";
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОшибкаАрхивирования = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Если НЕ ЗначениеЗаполнено(ОшибкаАрхивирования) Тогда
			ОшибкаАрхивирования = НСтр("ru = 'Ошибка при добавлении файла в архив';
										|en = 'An error occurred while adding the file to the archive'");
		КонецЕсли;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Упаковка пакета';
				|en = 'Electronic data interchange with regulatory authorities. Packing'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
	КонецПопытки;
	Если ТипАрхива = "gzip" Тогда
		КороткоеИмяФайлаАрхива = КороткоеИмяФайлаАрхиваGzip;
		ПолноеИмяФайлаАрхива = ПолноеИмяФайлаАрхиваGzip;
	КонецЕсли;
	
	// уведомляем об ошибке, если она была
	Если ЗначениеЗаполнено(ОшибкаАрхивирования) Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Ошибка создания архива: %1';
				|en = 'An error occurred while creating archive: %1'"),
			ОшибкаАрхивирования);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		// удаляем временный каталог
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);

		Возврат Неопределено;
	КонецЕсли;
	
	// помещаем архив обратно во временное хранилище
	СтрВложение.Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаАрхива), ИдентификаторДляВременногоХранилища);
	
	// удаляем временный каталог
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйКаталог);
	
	Возврат КороткоеИмяФайлаАрхива;
	
КонецФункции

Функция ОпределитьДокументВДеревеОписания(ДеревоОписанияДокументовПакета, ТипДокумента = Неопределено, ТипСодержимого = Неопределено, ИдентификаторДокумента = Неопределено, Сжат = Неопределено, Зашифрован = Неопределено, ИмяФайлаДокумента = Неопределено, ИмяФайлаАрхива = Неопределено, Адрес = Неопределено) Экспорт
	
	НовСтр = ДеревоОписанияДокументовПакета.Строки.Добавить();
	НовСтр.ТипДокумента = ТипДокумента;
	НовСтр.ТипСодержимого = ТипСодержимого;
	НовСтр.ИдентификаторДокумента = ИдентификаторДокумента;
	НовСтр.Сжат = Сжат;
	НовСтр.Зашифрован = Зашифрован;
	НовСтр.ИмяФайлаДокумента = ИмяФайлаДокумента;
	НовСтр.ИмяФайлаАрхива = ИмяФайлаАрхива;
	НовСтр.Адрес = Адрес;
	
	Возврат НовСтр;
	
КонецФункции

Функция ТипСодержимогоПоОписаниюДИВ(ВложениеДИВ, ДляПФР = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ВложениеДИВ.ТипСодержимогоФайла) Тогда
		Возврат ПредставлениеПоТипуСодержимогоФайла(ВложениеДИВ.ТипСодержимогоФайла, ДляПФР);
	Иначе
		Возврат "xml";
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеПоТипуСодержимогоФайла(ТипСодержимогоФайла, ДляПФР)
	
	Если ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Текст1251 Тогда
		Возврат "plain1251";
	ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Текст866 Тогда
		Возврат "plain866";
	ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.xml Тогда
		Возврат "xml";
	ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.html Тогда
		Возврат "html";
	ИначеЕсли НЕ ДляПФР Тогда
		Если ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.pdf Тогда
			Возврат "pdf";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.rtf Тогда
			Возврат "rtf";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.tiff Тогда
			Возврат "tiff";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.jpeg Тогда
			Возврат "jpeg";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.png Тогда
			Возврат "png";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.ms_word Тогда
			Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Приказ ФНС ЕД-7-26/547@",
				'20240930') Тогда
				Возврат "doc";
			Иначе
				Возврат "ms-word";
			КонецЕсли;
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.ms_excel Тогда
			Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Приказ ФНС ЕД-7-26/547@",
				'20240930') Тогда
				Возврат "xls";
			Иначе
				Возврат "ms-excel";
			КонецЕсли;
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.odf_text Тогда
			Возврат "odf-text";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.odf_spreadsheet Тогда
			Возврат "odf-spreadsheet";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.oxml_word Тогда
			Возврат "oxml-word";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.oxml_spreadsheet Тогда
			Возврат "oxml-spreadsheet";
		ИначеЕсли ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.sgn Тогда
			Возврат "sgn";
		Иначе
			Возврат "unknown";
		КонецЕсли;
	Иначе
		Возврат "unknown";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СформироватьПакетФНС

Функция СформироватьПакетФНС_ПодготовитьСертификатыДляПоиска(
		УчетнаяЗапись, 
		СертификатРуководителя,  //+
		СертификатГлавногоБухгалтера,  //+
		СертификатОтветственногоЗаШифрование) Экспорт  //+

	МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(УчетнаяЗапись);
	
	СертификатыДляПоиска = Новый Массив;
	
	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя);  //+
	ОтпечатокСертификатГлавногоБухгалтера = СокрЛП(СертификатГлавногоБухгалтера);  //+
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование);  //+
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатРуководителя) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат руководителя.';
				|en = 'Manager certificate is not specified in settings of account %1.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатРуководителя);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтпечатокСертификатГлавногоБухгалтера) Тогда
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатГлавногоБухгалтера);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатОтветственногоЗаШифрование) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат ответственного за шифрование.';
				|en = 'Certificate of the person responsible for encryption is not specified in account %1 settings.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатОтветственногоЗаШифрование);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Возврат СертификатыДляПоиска;

КонецФункции

Процедура СформироватьПакетФНС_ПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	Если КонтекстОтправки.Свойство("ОбъектСертификатОтветственногоЗаШифрование") Тогда // Возможна ситуация, когда сертификаты уже получены и проверены.
		Возврат;
	КонецЕсли;
	
	СертификатыДляПоиска = СформироватьПакетФНС_ПодготовитьСертификатыДляПоиска(
		КонтекстОтправки.УчетнаяЗапись,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатГлавногоБухгалтера,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если СертификатыДляПоиска = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
	
	РезультатПоиска = НайтиСертификаты(СертификатыДляПоиска, Истина);
	
	СформироватьПакетФНС_ПроверкиСертификатовПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска);

КонецПроцедуры

Процедура СформироватьПакетФНС_ПроверкиСертификатовПослеПолученияСертификатов(КонтекстОтправки, СообщениеОбОшибке, РезультатПоиска)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	ОбъектыСертификатов = СформироватьПакетФНС_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		РезультатПоиска.Сертификаты,
		КонтекстОтправки.СертификатРуководителя,
		КонтекстОтправки.СертификатГлавногоБухгалтера,
		КонтекстОтправки.СертификатОтветственногоЗаШифрование);
	
	Если ОбъектыСертификатов = Неопределено Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Если НЕ ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Не удалось найти сертификаты ответственных лиц в системном хранилище сертификатов.';
									|en = 'Cannot find certificates of responsible persons in the system certificate storage.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
	///////////////////////////////////////////////////////////////////////////////
	Для каждого ОбъектСертификат Из ОбъектыСертификатов Цикл
		КонтекстОтправки.Вставить(ОбъектСертификат.Ключ, ОбъектСертификат.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьПакетФНС_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		Сертификаты, 
		СертификатРуководителя,  //+
		СертификатГлавногоБухгалтера,  //+
		СертификатОтветственногоЗаШифрование) Экспорт  //+
	
	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя);  //+
	ОтпечатокСертификатГлавногоБухгалтера = СокрЛП(СертификатГлавногоБухгалтера);  //+
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование);  //+
	
	ОбъектСертификатРуководителя = Неопределено;
	ОбъектСертификатГлавногоБухгалтера = Неопределено;
	ОбъектСертификатОтветственногоЗаШифрование = Неопределено;
	
	Для Каждого НайденныйСертификат Из Сертификаты Цикл
		Если ОтпечатокСертификатРуководителя = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатРуководителя = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатГлавногоБухгалтера = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатГлавногоБухгалтера = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатОтветственногоЗаШифрование = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатОтветственногоЗаШифрование = НайденныйСертификат;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектСертификатРуководителя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат руководителя в системном хранилище сертификатов.';
								|en = 'Cannot find a manager certificate in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;

	// Сертификат мог быть получен без проверки на валидность, тогда в его свойствах не будет такого поля.
	Если ОбъектСертификатРуководителя.Свойство("Валиден") И Не ОбъектСертификатРуководителя.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат руководителя не валиден.';
								|en = 'Manager certificate is not valid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтпечатокСертификатГлавногоБухгалтера) И ОбъектСертификатГлавногоБухгалтера = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат главного бухгалтера в системном хранилище сертификатов.';
								|en = 'Cannot find a certificate of the Chief Accountant in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСертификатГлавногоБухгалтера) 
		И ОбъектСертификатГлавногоБухгалтера.Свойство("Валиден") И Не ОбъектСертификатГлавногоБухгалтера.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат главного бухгалтера не валиден.';
								|en = 'Chief accountant certificate is not valid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОтпечатокСертификатОтветственногоЗаШифрование = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат ответственного за шифрование в системном хранилище сертификатов.';
								|en = 'Cannot find a certificate of the person responsible for encryption in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектСертификатОтветственногоЗаШифрование.Свойство("Валиден") И Не ОбъектСертификатОтветственногоЗаШифрование.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат ответственного за шифрование не валиден.';
								|en = 'Certificate of the person responsible for encryption is invalid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
		
	Результат = Новый Структура();
	Результат.Вставить("ОбъектСертификатРуководителя",               ОбъектСертификатРуководителя);
	Результат.Вставить("ОбъектСертификатГлавногоБухгалтера",         ОбъектСертификатГлавногоБухгалтера);
	Результат.Вставить("ОбъектСертификатОтветственногоЗаШифрование", ОбъектСертификатОтветственногоЗаШифрование);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакетФНС(ТранспортноеСообщение, УникальныйИдентификатор, СообщениеОбОшибке)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	КонтекстОтправки = Новый Структура;
	КонтекстОтправки.Вставить("ТранспортноеСообщение", ТранспортноеСообщение);
	КонтекстОтправки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	КонтекстОтправки.Вставить("Оповещать", Ложь);
	
	// общие проверки
	Если НЕ СформироватьПакетФНС_ОбщиеПроверкиПередФормированием(КонтекстОтправки) Тогда
		СообщениеОбОшибке = ТекстСообщенийПользователю();
		Возврат;
	КонецЕсли;
		
	// получение и проверки сертификатов
	СформироватьПакетФНС_ПолучитьИПроверитьСертификатыПолучателя(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетФНСПослеПроверкиИПолученияСертификатовПолучателя(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;

	СформироватьПакетФНСПослеПроверкиСертификатов(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетФНС_Подписание(КонтекстОтправки, СообщениеОбОшибке);
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПакетФНСПослеПодписания(КонтекстОтправки, СообщениеОбОшибке);
	
КонецПроцедуры

Функция СформироватьПакетФНС_ОбщиеПроверкиПередФормированием(Контекст) Экспорт
	
	Сообщение = Контекст.ТранспортноеСообщение;
	СообщениеТема = Сообщение.Тема;
	
	// проверка на то, что сообщение исходящее
	СтатусТранспортногоСообщения = Сообщение.Статус;
	Если СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Сохраненное
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Исходящее
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Отправленное Тогда
		ТекстСообщения = НСтр("ru = 'Невозможно формирование пакета по входящему сообщению!';
								|en = 'Cannot generate a package from the incoming message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ПризнакОшибки = Ложь;
	
	ТипСообщения = Сообщение.Тип;
	
	СсылкаОтправитель = Сообщение.Отправитель;
	СсылкаПолучатель = ОпределитьПолучателяТранспортногоКонтейнера(Сообщение);
	УчетнаяЗапись = Сообщение.УчетнаяЗапись;
	ЦиклОбмена = Сообщение.ЦиклОбмена;
	СообщениеОснование = Сообщение.Основание;
	
	Если НЕ ЗначениеЗаполнено(ТипСообщения) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: тип транспортного сообщения не определен!';
								|en = 'An error occurred while encrypting the transport message: the transport message type is not determined.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаОтправитель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан отправитель!';
								|en = 'An error occurred while encrypting the transport message: sender is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаПолучатель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан получатель!';
								|en = 'An error occurred while encrypting the transport message: recipient is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задана учетная запись!';
								|en = 'An error occurred while encrypting the transport message: account is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
