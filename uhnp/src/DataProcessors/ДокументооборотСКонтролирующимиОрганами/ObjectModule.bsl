	ТаблицаЭтаповОтправки.Колонки.Добавить("КоличествоОтветов", 		Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция КомментарийКСостояниюНеОтправлено() Экспорт
	
	Комментарий = "";
	
	ЭлектронныйДокументооборотДоступен = ХотяБыОднаОрганизацияИспользуетДокументооборот();
	 
	Если НЕ ЭлектронныйДокументооборотДоступен Тогда
		
		Комментарий = ПредложениеПодключить1СОтчетностьИзПанели();
		
	КонецЕсли;
		
	Возврат Комментарий;
	
КонецФункции

Функция ПредложениеПодключить1СОтчетностьИзПанели() Экспорт
	
	СсылкаНаПредложениеОформитьЗаявлениеНаПодключение = "e1cib/command/ОбщаяКоманда.ПредложениеОформитьЗаявлениеНаПодключение";
	
	СсылкаНаПрочиеСпособыСдачиОтчетности = "";
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ПолучитьСсылкуНаСтатьюСпособыСдачиОтчетности(СсылкаНаПрочиеСпособыСдачиОтчетности);
	
	ЭлементыСтроки = Новый Массив;
	ЭлементыСтроки.Добавить(НСтр("ru = 'Отправьте отчет через ';
								|en = 'Send the report via '"));
	ЭлементыСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '1С-Отчетность';
															|en = '1C Reporting'"),,,,СсылкаНаПредложениеОформитьЗаявлениеНаПодключение));
	ЭлементыСтроки.Добавить(НСтр("ru = ' - самый удобный способ сдачи отчетности. ';
								|en = ' - the most convenient method of reporting submission. '"));
	
	Если ЗначениеЗаполнено(СсылкаНаПрочиеСпособыСдачиОтчетности) Тогда
		ЭлементыСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Все способы';
																|en = 'All methods'"),,,, СсылкаНаПрочиеСпособыСдачиОтчетности));
	КонецЕсли;
	
	Комментарий = Новый ФорматированнаяСтрока(ЭлементыСтроки);
		
	Возврат Комментарий;
	
КонецФункции

Функция КомментарийКСостояниюНеОтправленоМинобороны()
	
