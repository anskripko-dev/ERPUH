Функция КоличествоВыбраныхОрганов(Направления, Подключить = Неопределено, ПризнакПоддержки = Неопределено)
	
	Отбор = Новый Структура();
	
	Если Подключить <> Неопределено Тогда
		Отбор.Вставить("Подключить", Подключить);
	КонецЕсли;
	
	Если ПризнакПоддержки <> Неопределено Тогда
		Отбор.Вставить("ПризнакПоддержки", ПризнакПоддержки);
	КонецЕсли;
	
	НайденныеСтроки = Направления.НайтиСтроки(Отбор);
	
	Возврат НайденныеСтроки.Количество();
	
КонецФункции

