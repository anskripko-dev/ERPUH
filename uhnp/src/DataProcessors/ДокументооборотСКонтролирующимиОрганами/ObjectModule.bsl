		Если СтрФормы2НДФЛНП.Количество() > 0 И СтрФормы2НДФЛНП[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.Дата						= ДатаОтправки(СтрФормы2НДФЛНП, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
														|en = 'Awaiting confirmation of sending date'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= ?(СтрФормы2НДФЛНП.Количество() > 0, СтрФормы2НДФЛНП[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрФормы2НДФЛНП.Количество() > 0;

		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияФорма2НДФЛНО, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием отчета в обработку';
														|en = 'Awaiting receipt of report for processing'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
														|en = 'Sending date confirmation'");
		СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияФорма2НДФЛНО.Количество() > 0, СтрПодтвержденияФорма2НДФЛНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияФорма2НДФЛНО.Количество() > 0;
		
		// определяем наиболее свежее сообщение с результатом приема
		ПоследнийРезультатПриема = Неопределено;
		Для Каждого СтрРезультатПриемаФорма2НДФЛНО Из СтрРезультатыПриемаФорма2НДФЛНО Цикл
			Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатПриемаФорма2НДФЛНО.Дата > ПоследнийРезультатПриема.Дата Тогда
				ПоследнийРезультатПриема = СтрРезультатПриемаФорма2НДФЛНО;
			КонецЕсли;
		КонецЦикла;
		
		ОтчетСданЧастично = ПоследнийРезультатПриема <> Неопределено И Отчет2НДФЛСданЧастично(ПоследнийРезультатПриема);
		ПротоколСОшибкой  = ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой;
		
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если ОтчетСданЧастично Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдан частично';
															|en = 'Submitted partially'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдан частично';
															|en = 'Submitted partially'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
															|en = 'Correct errors and send the report again'");
			СтрокаЭтапа.НаименованиеПротокола		= "Протокол приема";
			СтрокаЭтапа.Протокол					= ПоследнийРезультатПриема.Ссылка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;
	
		ИначеЕсли ПротоколСОшибкой Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не сдано';
															|en = 'Not submitted'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не сдано';
															|en = 'Not submitted'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
															|en = 'Correct errors and send the report again'");
			СтрокаЭтапа.НаименованиеПротокола		= "Протокол ошибок";
			СтрокаЭтапа.Протокол					= ПоследнийРезультатПриема.Ссылка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;
			
		Иначе
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдано';
															|en = 'Submitted:'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдано';
															|en = 'Submitted:'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыПриемаФорма2НДФЛНО, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= "Протокол приема";
			СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаФорма2НДФЛНО.Количество() > 0, СтрРезультатыПриемаФорма2НДФЛНО[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаФорма2НДФЛНО.Количество() > 0;
			
		КонецЕсли;
		
	ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление Тогда
		
		// выделяем основные типы сообщений
		СтрПредставленияНП					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП));
		СтрПодтвержденияПредставлениеНО		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПредставлениеНО));
		СтрИзвещенияПодтверждениеНП			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
		СтрИзвещенияПредставлениеНО			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПредставлениеНО));
		СтрРезультатыПриемаПредставлениеНО	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО));
		СтрИзвещенияРезультатПриемаНП		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
		
		СтрКритическиеОшибки = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФНС));
		
		// Если статус первичного - не отправлено, тогда выходим 
		Если СтрПредставленияНП.Количество() > 0 И СтрПредставленияНП[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.Дата						= ДатаОтправки(СтрПредставленияНП, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
														|en = 'Awaiting confirmation of sending date'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= ?(СтрПредставленияНП.Количество() > 0, СтрПредставленияНП[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрПредставленияНП.Количество() > 0;

		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияПредставлениеНО, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием уведомления в обработку';
														|en = 'Awaiting receipt of notification for processing'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
														|en = 'Sending date confirmation'");
		СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияПредставлениеНО.Количество() > 0, СтрПодтвержденияПредставлениеНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияПредставлениеНО.Количество() > 0;
		
		// определяем наиболее свежее сообщение с результатом приема
		ПоследнийРезультатПриема = Неопределено;
		Для Каждого СтрРезультатПриемаПредставлениеНО Из СтрРезультатыПриемаПредставлениеНО Цикл
			Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатПриемаПредставлениеНО.Дата > ПоследнийРезультатПриема.Дата Тогда
				ПоследнийРезультатПриема = СтрРезультатПриемаПредставлениеНО;
			КонецЕсли;
		КонецЦикла;
		
		ЭтоМашиночитаемаяДоверенностьФНС = (ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС"));
		ЭтоЗаявлениеОбОтзывеМЧДФНС = (ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.ЗаявленияОбОтзывеМЧДФНС"));
		
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
			
			ТекстСтатуса = ?(ЭтоМашиночитаемаяДоверенностьФНС ИЛИ ЭтоЗаявлениеОбОтзывеМЧДФНС,
				НСтр("ru = 'Не зарегистрировано';
					|en = 'Not registered'"), НСтр("ru = 'Не сдано';
														|en = 'Not submitted'"));
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
			СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
			СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте уведомление еще раз';
															|en = 'Correct errors and send the notification again'");
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол ошибок';
															|en = 'Error log'");
			СтрокаЭтапа.Протокол					= ПоследнийРезультатПриема.Ссылка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;
			
		Иначе
			
			РНПТ = ""; // регистрационный номер партии товара для целей прослеживаемости
			СтатусДОПП = ""; // статус документ о предстоящей поставке системы подтверждения ожидания товаров
			КодыОшибокНСП = Новый Массив; // ошибки системы прослеживаемости или подтверждения товаров
			Если СтрРезультатыПриемаПредставлениеНО.Количество() > 0 Тогда
				ТаблицаКвитанций = ИнтерфейсыВзаимодействияБРОВызовСервера.ДокументыРеализацииПолномочийНО(СсылкаНаОтчет);//
				Для каждого СтрокаТаблицыКвитанций Из ТаблицаКвитанций Цикл
					КодыОшибокНСП.Очистить();
					Для каждого ОшибкаНСП Из СтрокаТаблицыКвитанций.ОшибкиНСП Цикл
						КодыОшибокНСП.Добавить(ОшибкаНСП.КодОшибки);
					КонецЦикла;
					Если ЗначениеЗаполнено(СтрокаТаблицыКвитанций.РНПТ) Тогда
						РНПТ = СокрЛП(СтрокаТаблицыКвитанций.РНПТ);
						Прервать;
					КонецЕсли;
					Если ЗначениеЗаполнено(СтрокаТаблицыКвитанций.СтатусДОПП) Тогда
						СтатусДОПП = ИнтерфейсыВзаимодействияБРОВызовСервера.СтатусыДОПП(СтатусДОПП, СтрокаТаблицыКвитанций.СтатусДОПП);
					КонецЕсли;
				КонецЦикла;
				Если НЕ ЗначениеЗаполнено(РНПТ) Тогда
					Для каждого СтрокаТаблицыКвитанций Из ТаблицаКвитанций Цикл
						Если СтрокаТаблицыКвитанций.ОшибкиНСП.Количество() > 0 Тогда
							КодыОшибокНСП.Очистить();
							Для каждого ОшибкаНСП Из СтрокаТаблицыКвитанций.ОшибкиНСП Цикл
								КодыОшибокНСП.Добавить(ОшибкаНСП.КодОшибки);
							КонецЦикла;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			ПредставлениеОшибокНСП = "";
			Если КодыОшибокНСП.Количество() > 0 Тогда
				ПредставлениеОшибокНСП = СтрСоединить(КодыОшибокНСП, ", ");
				ПредставлениеОшибокНСП = СтрШаблон(
					?(КодыОшибокНСП.Количество() = 1, НСтр("ru = 'есть ошибка с кодом %1';
															|en = 'there is an error with code %1'"), НСтр("ru = 'есть ошибки с кодами: %1';
																									|en = 'there are errors with codes: %1'")),
					ПредставлениеОшибокНСП);
			КонецЕсли;
			КомментарийСРНПТИОшибками = ?(ЗначениеЗаполнено(РНПТ) ИЛИ ЗначениеЗаполнено(ПредставлениеОшибокНСП),
				НСтр("ru = 'По текущему документу';
					|en = 'По текущему документу'") + " " + ?(ЗначениеЗаполнено(РНПТ), СтрШаблон(
					НСтр("ru = 'получен РНПТ %1';
						|en = 'получен РНПТ %1'"),
					РНПТ), "")
				+ ?(ЗначениеЗаполнено(РНПТ) И ЗначениеЗаполнено(ПредставлениеОшибокНСП), ", ",
					?(ЗначениеЗаполнено(ПредставлениеОшибокНСП), НСтр("ru = 'получена квитанция';
																		|en = 'получена квитанция'") + ", ", ""))
				+ ПредставлениеОшибокНСП, "");
			ТекстСтатуса = ?(ЗначениеЗаполнено(СтатусДОПП), ИнтерфейсыВзаимодействияБРОВызовСервера.СтатусыДОПП(СтатусДОПП),
				?(ЗначениеЗаполнено(ПредставлениеОшибокНСП), НСтр("ru = 'Сдано, ошибки НСП';
																	|en = 'Submitted, sales tax errors'"),
				?(ЗначениеЗаполнено(РНПТ), НСтр("ru = 'Сдано, получен РНПТ';
												|en = 'Submitted, goods batch registration number received'"),
				?(ЭтоМашиночитаемаяДоверенностьФНС ИЛИ ЭтоЗаявлениеОбОтзывеМЧДФНС,
					НСтр("ru = 'Зарегистрировано';
						|en = 'Registered'"), НСтр("ru = 'Сдано';
															|en = 'Submitted:'")))));
			СтатусыДОПП = ИнтерфейсыВзаимодействияБРОВызовСервера.СтатусыДОПП();
			СостояниеСдачиОтчетности = ?(ЗначениеЗаполнено(РНПТ)
					ИЛИ (ЗначениеЗаполнено(СтатусДОПП) И СтатусДОПП <> СтатусыДОПП.НеПройденаПроверкаКО)
					ИЛИ НЕ ЗначениеЗаполнено(ПредставлениеОшибокНСП),
				Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота,
				Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота);
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
			СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыПриемаПредставлениеНО, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= КомментарийСРНПТИОшибками;
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол приема';
															|en = 'Acceptance protocol'");
			СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаПредставлениеНО.Количество() > 0, СтрРезультатыПриемаПредставлениеНО[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= СостояниеСдачиОтчетности;
			СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаПредставлениеНО.Количество() > 0;
			
		КонецЕсли;
		
		Если ЭтоМашиночитаемаяДоверенностьФНС Тогда
			
			РезультатПроверки = ПроверитьМЧДФНСНаОтзыв(СсылкаНаОтчет, Истина);
			
			Если РезультатПроверки.МЧДФНСОтозвана ИЛИ РезультатПроверки.МЧДФНСЧастичноОтозвана Тогда
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= ?(РезультатПроверки.МЧДФНСЧастичноОтозвана, "Частично отозвано", "Отозвано");
				СтрокаЭтапа.ТекстСтатуса				= ?(РезультатПроверки.МЧДФНСЧастичноОтозвана, "Частично отозвано", "Отозвано");
				СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыПриемаПредставлениеНО, НеПолучатьДаты);
				СтрокаЭтапа.КомментарийКСостоянию		= КомментарийСРНПТИОшибками;
				СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол приема';
																|en = 'Acceptance protocol'");
				СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаПредставлениеНО.Количество() > 0, СтрРезультатыПриемаПредставлениеНО[0].Ссылка, "");
				СтрокаЭтапа.СостояниеСдачиОтчетности	= СостояниеСдачиОтчетности;
				СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаПредставлениеНО.Количество() > 0;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		// выделяем основные типы сообщений
		СтрДекларацииНП 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ДекларацияНП));// Отправлено оператору
		СтрПодтвержденияДекларацияНО 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДекларацияНО));// Отправлено в ФНС
		СтрИзвещенияПодтверждениеНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
		СтрИзвещенияДекларацияНО 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеДекларацияНО));// Доставлено
		СтрРезультатыПриемаДекларацияНО 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДекларацияНО));// Не принято в обработку ИЛИ Принято в обработку
		СтрИзвещенияРезультатПриемаНП 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
		СтрРезультатыОбработкиДекларацияНО 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДекларацияНО));// Сдано, требует уточнения ИЛИ Сдано
		СтрИзвещенияРезультатОбработкиНП	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП));
		СтрКритическиеОшибки 				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеФНС));
		
		// Если статус первичного - не отправлено, тогда выходим 
		Если СтрДекларацииНП.Количество() > 0 И СтрДекларацииНП[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
														|en = 'Sent to the provider'");
		СтрокаЭтапа.Дата						= ДатаОтправки(СтрДекларацииНП, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
														|en = 'Awaiting confirmation of sending date'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.Отправка					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение					= СсылкаНаСообщение(СтрДекларацииНП); 
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрДекларацииНП.Количество() > 0;
		
		// Отправлено в ФНС
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
														|en = 'Sent to FTS'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияДекларацияНО, НеПолучатьДаты);;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием отчета в обработку';
														|en = 'Awaiting receipt of report for processing'");
		СтрокаЭтапа.НаименованиеПротокола		= "Подтверждение даты отправки";
		СтрокаЭтапа.Протокол					= СсылкаНаСообщение(СтрПодтвержденияДекларацияНО);
		СтрокаЭтапа.Отправка					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение					= СсылкаНаСообщение(СтрПодтвержденияДекларацияНО); 
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияДекларацияНО.Количество() > 0;
			
		// определяем наиболее свежее сообщение с результатом приема
		ПоследнийРезультатПриема = Неопределено;
		Для Каждого СтрРезультатПриемаДекларацияНО Из СтрРезультатыПриемаДекларацияНО Цикл
			Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатПриемаДекларацияНО.Дата > ПоследнийРезультатПриема.Дата Тогда
				ПоследнийРезультатПриема = СтрРезультатПриемаДекларацияНО;
			КонецЕсли;
		КонецЦикла;
		
		// если результат приема отрицательный, то выводим соответствующее сообщение
		Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не принято в обработку';
															|en = 'Not received for processing'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не принято в обработку';
															|en = 'Not received for processing'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
															|en = 'Correct errors and send the report again'");
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
															|en = 'Notification of refusal'");
			СтрокаЭтапа.Протокол					= ПоследнийРезультатПриема.Ссылка;
			СтрокаЭтапа.Отправка					= ЦиклОбмена;
			СтрокаЭтапа.Сообщение					= ПоследнийРезультатПриема.Ссылка; 
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаДекларацияНО.Количество() > 0;
			
		Иначе
			
			// Принято в обработку
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
															|en = 'Accepted for processing'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
															|en = 'Accepted for processing'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыПриемаДекларацияНО, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки отчета';
															|en = 'Awaiting report processing result'");
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о приеме';
															|en = 'Notice of acceptance'");
			СтрокаЭтапа.Протокол					= СсылкаНаСообщение(СтрРезультатыПриемаДекларацияНО);
			СтрокаЭтапа.Отправка					= ЦиклОбмена;
			СтрокаЭтапа.Сообщение					= СсылкаНаСообщение(СтрРезультатыПриемаДекларацияНО); 
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаДекларацияНО.Количество() > 0;
			
			// определяем наиболее свежее сообщение с результатом обработки
			ПоследнийРезультатОбработки = Неопределено;
			Для Каждого СтрРезультатОбработки Из СтрРезультатыОбработкиДекларацияНО Цикл
				Если ПоследнийРезультатОбработки = Неопределено ИЛИ СтрРезультатОбработки.Дата > ПоследнийРезультатОбработки.Дата Тогда
					ПоследнийРезультатОбработки = СтрРезультатОбработки;
				КонецЕсли;
			КонецЦикла;
			
			// если результат обработки отрицательный, то выводим соответствующее сообщение
			Если ПоследнийРезультатОбработки <> Неопределено И ПоследнийРезультатОбработки.ПротоколСОшибкой Тогда
				
				// Сдано, требует уточнения
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения();
				СтрокаЭтапа.ТекстСтатуса				= ДокументооборотСКОКлиентСервер.СтатусСданоТребуетУточнения();
				СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийРезультатОбработки, НеПолучатьДаты);
				СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Подготовьте и отправьте корректирующий отчет';
																|en = 'Prepare and send adjusting report '");
				СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об уточнении';
																|en = 'Notification of specification'");
				СтрокаЭтапа.Протокол					= ПоследнийРезультатОбработки.Ссылка;
				СтрокаЭтапа.Отправка					= ЦиклОбмена;
				СтрокаЭтапа.Сообщение					= ПоследнийРезультатОбработки.Ссылка;
				СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден					= СтрРезультатыОбработкиДекларацияНО.Количество() > 0;
				
			Иначе
				
				Текст = НСтр("ru = 'Сдано';
							|en = 'Submitted:'");
				
				Если ЭтоНужныйВидОтчетаСПАРК(СсылкаНаОтчет) Тогда
					СвойстваОтчета = СвойстваОтчетаСПАРК(СсылкаНаОтчет);
					ИмяПеречисленияСПАРК = "СтатусыОтправкиВСПАРК"; // Чтобы расширенная проверка не выдавала ошибку
					Если СвойстваОтчета <> Неопределено
						И СвойстваОтчета.СтатусОтправки = Перечисления[ИмяПеречисленияСПАРК].ОтправленУспешно Тогда
						
						Текст = НСтр("ru = 'Сдано в ФНС, копия передана в СПАРК';
									|en = 'Delivered to FTS, a copy sent to SPARK'");
						
					КонецЕсли;
					
				КонецЕсли;
				
				// Сдано
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= Текст;
				СтрокаЭтапа.ТекстСтатуса				= Текст;
				СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыОбработкиДекларацияНО, НеПолучатьДаты);
				СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = ''");
				СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Извещение о вводе';
																|en = 'Notice of input'");
				СтрокаЭтапа.Протокол					= СсылкаНаСообщение(СтрРезультатыОбработкиДекларацияНО);
				СтрокаЭтапа.Отправка					= ЦиклОбмена;
				СтрокаЭтапа.Сообщение					= СсылкаНаСообщение(СтрРезультатыОбработкиДекларацияНО);
				СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден					= СтрРезультатыОбработкиДекларацияНО.Количество() > 0;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиПФР(СсылкаНаОтчет, ДополнительныеПараметры)
	
	Если ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР") Тогда
		ПредставлениеВИмПадеже = НСтр("ru = 'заявление';
										|en = 'application'");
		ПредставлениеВРодПадеже = НСтр("ru = 'заявления';
										|en = 'application'");
	ИначеЕсли ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПредоставленииПолномочийПредставителю") 
		ИЛИ ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПрекращенииПолномочийПредставителя") Тогда
		ПредставлениеВИмПадеже = НСтр("ru = 'уведомление';
										|en = 'notification'");
		ПредставлениеВРодПадеже = НСтр("ru = 'уведомления';
										|en = 'notification'");
	Иначе
		ПредставлениеВИмПадеже = НСтр("ru = 'отчет';
										|en = 'report'");
		ПредставлениеВРодПадеже = НСтр("ru = 'отчета';
										|en = 'report'");
	КонецЕсли;
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ОрганизацияСсылка = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "Организация");
	ДатаСеанса = ТекущаяДатаСеанса();
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	КомментарийКСостоянию = КомментарийКСостояниюНеОтправленоПФР(СсылкаНаОтчет);
	Если НЕ ЗначениеЗаполнено(КомментарийКСостоянию) Тогда
		Если НЕ ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
			ОрганизацияСсылка = ?(ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет")
				ИЛИ ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОтчет, "Организация"), Неопределено);
		КонецЕсли;
		УчетнаяЗаписьСсылка = УчетнаяЗаписьОрганизации(ОрганизацияСсылка);
		Если ЗначениеЗаполнено(УчетнаяЗаписьСсылка)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗаписьСсылка, "ПредназначенаДляДокументооборотаСПФР") = Истина
			И Мультирежим.ТипСубъектаСертификатаПользователя(УчетнаяЗаписьСсылка, ОрганизацияСсылка) = "ФЛ"
			И ДокументооборотСКОВызовСервера.МЧДОбмена(ОрганизацияСсылка, "ПФР").Количество() = 0 Тогда
			
			СведенияОСобытии = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступилоРасширенная("Предупр.необх.МЧД для ЕЦП");
			
			Если НЕ СведенияОСобытии.СобытиеНеНайдено И НЕ СведенияОСобытии.ОшибкаПолученияДанных
				И ЗначениеЗаполнено(СведенияОСобытии.ДатаНачала) И СведенияОСобытии.ДатаНачала < '30000101'
				И (НЕ ЗначениеЗаполнено(СведенияОСобытии.ДатаОкончания) ИЛИ СведенияОСобытии.ДатаОкончания >= ДатаСеанса) Тогда
				
				ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ТекущаяОрганизацияПФР",,
					ОрганизацияСсылка);
				
				Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ЗПЭД,ЗОЭД в ЕЦП")
					ИЛИ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.люб.отчет СФР в ЕЦП") Тогда
					
					СтрокаУкажите = СтрШаблон(
						НСтр("ru = 'Внимание! С %1 для отправки отчета представителями обязательно указание';
							|en = 'Important. Starting from %1, to send a report, representatives must specify a'"),
						Формат(СведенияОСобытии.ДатаНачала, "ДФ=""д ММММ гггг 'года'"""));
					
				Иначе
					СтрокаУкажите = СтрШаблон(
						НСтр("ru = 'Внимание! С %1 для отправки ЕФС-1 представителями обязательно указание';
							|en = 'Important. Starting from %1, to send a Unified Information Form-1, representatives must specify a'"),
						Формат(СведенияОСобытии.ДатаНачала, "ДФ=""д ММММ гггг 'года'"""));
				КонецЕсли;
				
				ТекстУкажите = Новый ФорматированнаяСтрока(
					СтрокаУкажите + " ",,
					ЦветаСтиля.ЦветПредупрежденияБРО);
				СсылкаНаМашиночитаемуюДоверенность = Новый ФорматированнаяСтрока(
					НСтр("ru = 'машиночитаемой доверенности';
						|en = 'machine-readable letter of authority to send a report'"),,,,
					"e1cib/command/ОбщаяКоманда.НастройкиМЧДДляПФР");
				ТекстПередовериеВсе = Новый ФорматированнаяСтрока(
					" " + НСтр("ru = 'нового образца';
								|en = 'machine-readable letter of authority'") + ".
					|" + НСтр("ru = 'Обратите внимание, используемая МЧД должна содержать специальное полномочие для ведения индивидуального (персонифицированного) учета (код ""SFR_000001"") или одно из вышестоящих полномочий в дереве полномочий.';
								|en = 'Note that the used MR LOA must contain a special power for individual accounting (personal record-keeping) (code ""SFR_000001"") or one of the higher powers in the power tree.'")
					+ " " + НСтр("ru = 'Если вы ранее оформляли МЧД нового образца, убедитесь, что она указана в';
								|en = 'If you have previously issued a new type of MR LOA, make sure that it is specified in'") + " ",,
					ЦветаСтиля.ЦветПредупрежденияБРО);
				СсылкаНаНастройки = Новый ФорматированнаяСтрока(
					НСтр("ru = 'настройках';
						|en = 'the settings'"),,,,
					"e1cib/command/ОбщаяКоманда.НастройкиМЧДДляПФР");
				ТекстТочки = Новый ФорматированнаяСтрока(
					".",,
					ЦветаСтиля.ЦветПредупрежденияБРО);
				КомментарийКСостоянию = Новый ФорматированнаяСтрока(
					ТекстУкажите,
					СсылкаНаМашиночитаемуюДоверенность,
					ТекстПередовериеВсе,
					СсылкаНаНастройки,
					ТекстТочки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Не отправлено
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостоянию;
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	// если у пользователя недостаточно прав для получения сведений об отправке, то скроем панель
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		МЧДФНСПодписана = ?(ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР")
			ИЛИ ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПредоставленииПолномочийПредставителю")
			ИЛИ ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПрекращенииПолномочийПредставителя"),
			ДокументооборотСКОВызовСервера.МЧДПодписана(СсылкаНаОтчет), Ложь);
		
		Если МЧДФНСПодписана Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Подписано';
															|en = 'Signed'");
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Подписано';
															|en = 'Signed'");
			СтрокаЭтапа.Дата 						= Дата(1,1,1);
			СтрокаЭтапа.КомментарийКСостоянию 		= "";
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
		КонецЕсли;
		
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	// получаем список всех не помеченных на удаление сообщений последнего цикла
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрПервичныеСообщения 						= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР));
	СтрКвитанцииОПриеме 						= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПолученияОтчетностиПФР));
	СтрПротоколыВходногоКонтроля 				= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПротоколПФР));
	СтрПереподписанныеПротоколыВходногоКонтроля = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПротоколКвитанцияПФР));
	СтрКритическиеОшибки			 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.КритическаяОшибка));
	
	// Если статус первичного - не отправлено, тогда выходим 
	Если СтрПервичныеСообщения.Количество() > 0 И СтрПервичныеСообщения[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	ЭтоУПУП = (ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПредоставленииПолномочийПредставителю"));
	ЭтоУПРУП = (ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.УведомлениеОПрекращенииПолномочийПредставителя"));
	
	ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
		СсылкаНаОтчет,,
		ЦиклОбмена.ДатаСоздания,
		ЦиклОбмена.Вид,
		ЦиклОбмена.Тип);
	
	ТекстОтправлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
		НСтр("ru = 'Отправлено в ПФР';
			|en = 'Sent to PF'"),,, НЕ ЭтоОтправкаВСФР);
	
	// Отправлено в ПФР
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= ТекстОтправлено;
	СтрокаЭтапа.ТекстСтатуса				= ТекстОтправлено;
	СтрокаЭтапа.Дата						= ДатаОтправки(СтрПервичныеСообщения, НеПолучатьДаты);
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки ';
													|en = 'Processing result pending'") + ПредставлениеВРодПадеже;
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщения.Количество() > 0;
	
	// Принято в обработку
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
													|en = 'Accepted for processing'");
	СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрКвитанцииОПриеме, НеПолучатьДаты);
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки ';
													|en = 'Processing result pending'") + ПредставлениеВРодПадеже;
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о доставке';
													|en = 'Notice of delivery'");
	СтрокаЭтапа.Протокол					= ?(СтрКвитанцииОПриеме.Количество() > 0, СтрКвитанцииОПриеме[0].Ссылка, "");
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрКвитанцииОПриеме.Количество() > 0;
	
	
	ПоследнийПротокол = Неопределено;
	Для Каждого СтрПротокол Из СтрПротоколыВходногоКонтроля Цикл
		Если ПоследнийПротокол = Неопределено ИЛИ СтрПротокол.Дата > ПоследнийПротокол.Дата Тогда
			ПоследнийПротокол = СтрПротокол;
		КонецЕсли;
	КонецЦикла;
	
	АнализПриложенияПротокола = ?(ПоследнийПротокол <> Неопределено
		И (ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОЗастрахованныхЛицахСЗВ_М
		ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОСтраховомСтажеЗастрахованныхЛицСЗВ_СТАЖ
		ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ДанныеОКорректировкеСведенийЗастрахованныхЛицСЗВ_КОРР
		ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОЗаработкеСтажеЗастрахованныхЛицСЗВ_ИСХ
		ИЛИ ЦиклОбмена.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ОписьОДВ_1
		ИЛИ ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК),
		ОтчетПФРСданЧастично(ПоследнийПротокол,, ЦиклОбмена.ФорматДокументооборота), Неопределено);
	ПротоколСОшибкой = (ПоследнийПротокол <> Неопределено И ПоследнийПротокол.ПротоколСОшибкой); // ошибка - не сдан / сдан частично
	
	Если АнализПриложенияПротокола <> Неопределено И НЕ АнализПриложенияПротокола.ЕстьПриложение
		И (НЕ АнализПриложенияПротокола.ЕстьВложения
		ИЛИ ЦиклОбмена.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК) Тогда
		
		// Получен протокол: еще не расшифрован, но отчет поддерживает частичную сдачу, определяемую по приложению
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Получен протокол';
														|en = 'Protocol is received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийПротокол, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Для расшифровки, обновите состояние, откройте протокол';
														|en = 'To decrypt, update status and open protocol'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол приема';
														|en = 'Acceptance protocol'");
		СтрокаЭтапа.Протокол					= ПоследнийПротокол.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли АнализПриложенияПротокола <> Неопределено И АнализПриложенияПротокола.СданЧастично Тогда
		
		// Сдан частично
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдан частично';
														|en = 'Submitted partially'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдан частично';
														|en = 'Submitted partially'");
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийПротокол, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= СтрШаблон(НСтр("ru = 'Исправьте ошибки и отправьте %1 еще раз';
																	|en = 'Correct errors and send %1 again'"), ПредставлениеВИмПадеже);
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол приема';
														|en = 'Acceptance protocol'");
		СтрокаЭтапа.Протокол					= ПоследнийПротокол.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли ПротоколСОшибкой ИЛИ АнализПриложенияПротокола <> Неопределено И АнализПриложенияПротокола.НеСдан Тогда

		// Не сдано
		ТекстСтатуса = ?(ЭтоУПУП ИЛИ ЭтоУПРУП, НСтр("ru = 'Не зарегистрировано';
													|en = 'Not registered'"), НСтр("ru = 'Не сдано';
																						|en = 'Not submitted'"));
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ДатаИзОтвета(ПоследнийПротокол, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= СтрШаблон(НСтр("ru = 'Исправьте ошибки и отправьте %1 еще раз';
																	|en = 'Correct errors and send %1 again'"), ПредставлениеВИмПадеже);
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол					= ПоследнийПротокол.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	Иначе
		
		// сдано
		ТекстСтатуса = ?(ЭтоУПУП ИЛИ ЭтоУПРУП, НСтр("ru = 'Зарегистрировано';
													|en = 'Registered'"), НСтр("ru = 'Сдано';
																					|en = 'Submitted'"));
		НаименованиеПротокола = ?(ЭтоУПУП ИЛИ ЭтоУПРУП, НСтр("ru = 'Протокол о регистрации';
															|en = 'Registration protocol'"), НСтр("ru = 'Протокол о сдаче';
																									|en = 'Delivery protocol'"));
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПротоколыВходногоКонтроля, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НаименованиеПротокола;
		СтрокаЭтапа.Протокол					= ?(СтрПротоколыВходногоКонтроля.Количество() > 0, СтрПротоколыВходногоКонтроля[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрПротоколыВходногоКонтроля.Количество() > 0;
		
	КонецЕсли;
	
	Если ЭтоУПУП Тогда
		
		УПУПОтозвано = ПроверитьУПУПНаОтзыв(СсылкаНаОтчет);
		
		Если УПУПОтозвано Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= "Отозвано";
			СтрокаЭтапа.ТекстСтатуса				= "Отозвано";
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПротоколыВходногоКонтроля, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол приема';
															|en = 'Acceptance protocol'");
			СтрокаЭтапа.Протокол					= ?(СтрПротоколыВходногоКонтроля.Количество() > 0, СтрПротоколыВходногоКонтроля[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрПротоколыВходногоКонтроля.Количество() > 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиЦБ(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	КомментарийКСостояниюНеОтправлено = КомментарийКСостояниюНеОтправлено();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1, 1, 1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправлено;
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	ИмяТипаСправочникаМашиночитаемыеДоверенностиЦБ = "МашиночитаемыеДоверенностиЦБ";
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует()
		И ТипЗнч(СсылкаНаОтчет) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенностиЦБ) Тогда
		
		СвойстваОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОтчет, "Статус, ДатаОбновленияСтатуса");
		
		Если СвойстваОтчета.Статус = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Подписано Тогда
			ДатаОбновленияСтатусаСтрокой = Формат(СвойстваОтчета.ДатаОбновленияСтатуса, "ДФ=дд.ММ.гггг");
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Подписано';
															|en = 'Signed'") + " " + ДатаОбновленияСтатусаСтрокой;
			СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Подписано';
															|en = 'Signed'");
			СтрокаЭтапа.Дата 						= СвойстваОтчета.ДатаОбновленияСтатуса;
			СтрокаЭтапа.КомментарийКСостоянию 		= "";
			СтрокаЭтапа.НаименованиеПротокола 		= "";
			СтрокаЭтапа.Протокол 					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден 				= Истина;
		КонецЕсли;
		
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
		
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;
	
	// если у пользователя недостаточно прав для получения сведений об отправке, то скроем панель
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	// получаем список всех не помеченных на удаление сообщений последнего цикла
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,, ПоказыватьПомеченныеНаУдаление, Истина);
	
	ОтборПервичныеСообщения =
		Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ);
	ОтборПодтвержденияДатыОтправки =
		Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатЗагрузкиЦБ);
	ОтборКвитанцииОПриеме =
		Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументЦБ);
	ОтборРезультатыОбработки =
		Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДокументЦБ);
	ОтборКритическиеОшибки =
		Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеЦБ);
	
	// выделяем основные типы сообщений
	СтрПервичныеСообщения 			= СообщенияЦикла.НайтиСтроки(ОтборПервичныеСообщения); // Отправлено оператору
	СтрПодтвержденияДатыОтправки 	= СообщенияЦикла.НайтиСтроки(ОтборПодтвержденияДатыОтправки); // Отправлено в ЦБ
	СтрКвитанцииОПриеме 			= СообщенияЦикла.НайтиСтроки(ОтборКвитанцииОПриеме); // Принято в обработку
	СтрРезультатыОбработки 			= СообщенияЦикла.НайтиСтроки(ОтборРезультатыОбработки); // Сдано ИЛИ Не принято
	СтрКритическиеОшибки 			= СообщенияЦикла.НайтиСтроки(ОтборКритическиеОшибки);
	
	// Если статус первичного - не отправлено, тогда выходим
	Если СтрПервичныеСообщения.Количество() > 0
		И СтрПервичныеСообщения[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.Дата 						= ДатаОтправки(СтрПервичныеСообщения, НеПолучатьДаты);
	СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Ожидается подтверждение даты отправки.
														 |Протокол обычно приходит в течение 2-х часов после приема отчета в обработку.';
														 |en = 'Awaiting confirmation of the sending date.
														 |The protocol usually arrives within 2 hours after receiving the report for processing.'");
	СтрокаЭтапа.НаименованиеПротокола 		= "";
	СтрокаЭтапа.Протокол 					= "";
	СтрокаЭтапа.Отправка 					= ЦиклОбмена;
	СтрокаЭтапа.Сообщение 					= СсылкаНаСообщение(СтрПервичныеСообщения);
	СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден 				= СтрПервичныеСообщения.Количество() > 0;
	
	// определяем наиболее свежее сообщение с результатом загрузки
	ПоследнийРезультатЗагрузки = Неопределено;
	Для каждого СтрПодтверждениеДатыОтправки Из СтрПодтвержденияДатыОтправки Цикл
		Если ПоследнийРезультатЗагрузки = Неопределено
			ИЛИ СтрПодтверждениеДатыОтправки.Дата > ПоследнийРезультатЗагрузки.Дата Тогда
			ПоследнийРезультатЗагрузки = СтрПодтверждениеДатыОтправки;
		КонецЕсли;
	КонецЦикла;
	
	// если результат обработки отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатЗагрузки <> Неопределено И ПоследнийРезультатЗагрузки.ПротоколСОшибкой Тогда
		// Не сдано
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(ПоследнийРезультатЗагрузки, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки при загрузке и отправьте отчет еще раз';
														|en = 'Correct the errors and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол 					= ПоследнийРезультатЗагрузки.Ссылка;
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= ПоследнийРезультатЗагрузки.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= СтрПодтвержденияДатыОтправки.Количество() > 0;
		
	Иначе
		// Отправлено в ЦБ
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Отправлено в Банк России';
														|en = 'Sent to the Bank of Russia '");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Отправлено в Банк России';
														|en = 'Sent to the Bank of Russia '");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(СтрПодтвержденияДатыОтправки, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Ожидается прием отчета в обработку';
														|en = 'Awaiting receipt of report for processing'");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Подтверждение даты отправки';
														|en = 'Sending date confirmation'");
		СтрокаЭтапа.Протокол 					= СсылкаНаСообщение(СтрПодтвержденияДатыОтправки);
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= СсылкаНаСообщение(СтрПодтвержденияДатыОтправки);
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден 				= СтрПодтвержденияДатыОтправки.Количество() > 0;
	КонецЕсли;
	
	// определяем наиболее свежее сообщение с результатом приема
	ПоследнийРезультатПриема = Неопределено;
	Для каждого СтрКвитанцияОПриеме Из СтрКвитанцииОПриеме Цикл
		Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрКвитанцияОПриеме.Дата > ПоследнийРезультатПриема.Дата Тогда
			ПоследнийРезультатПриема = СтрКвитанцияОПриеме;
		КонецЕсли;
	КонецЦикла;
	
	// если результат обработки отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
		// Не сдано
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки при приеме и отправьте отчет еще раз';
														|en = 'Correct the errors upon receipt and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол 					= ПоследнийРезультатПриема.Ссылка;
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= ПоследнийРезультатПриема.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= СтрКвитанцииОПриеме.Количество() > 0;
		
	Иначе
		// Принято в обработку
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(СтрКвитанцииОПриеме, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Ожидается результат обработки отчета';
														|en = 'Awaiting report processing result'");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Квитанция о приеме';
														|en = 'Notice of acceptance'");
		СтрокаЭтапа.Протокол 					= СсылкаНаСообщение(СтрКвитанцииОПриеме);
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= СсылкаНаСообщение(СтрКвитанцииОПриеме);
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден 				= СтрКвитанцииОПриеме.Количество() > 0;
	КонецЕсли;
	
	// определяем наиболее свежее сообщение с результатом обработки
	ПоследнийРезультатОбработки = Неопределено;
	Для Каждого СтрРезультатОбработки Из СтрРезультатыОбработки Цикл
		Если ПоследнийРезультатОбработки = Неопределено ИЛИ СтрРезультатОбработки.Дата > ПоследнийРезультатОбработки.Дата Тогда
			ПоследнийРезультатОбработки = СтрРезультатОбработки;
		КонецЕсли;
	КонецЦикла;
	
	// если результат обработки отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатОбработки <> Неопределено И ПоследнийРезультатОбработки.ПротоколСОшибкой Тогда
		// Не сдано
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(ПоследнийРезультатОбработки, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
														|en = 'Correct errors and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол 					= ПоследнийРезультатОбработки.Ссылка;
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= ПоследнийРезультатОбработки.Ссылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= СтрРезультатыОбработки.Количество() > 0;
		
	Иначе
		// Сдано
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи 				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.ТекстСтатуса 				= НСтр("ru = 'Сдано';
														|en = 'Submitted'");
		СтрокаЭтапа.Дата 						= ДатаИзОтвета(СтрРезультатыОбработки, НеПолучатьДаты);
		СтрокаЭтапа.КомментарийКСостоянию 		= НСтр("ru = ''");
		СтрокаЭтапа.НаименованиеПротокола 		= НСтр("ru = 'Квитанция о вводе';
														|en = 'Notice of input'");
		СтрокаЭтапа.Протокол 					= СсылкаНаСообщение(СтрРезультатыОбработки);
		СтрокаЭтапа.Отправка 					= ЦиклОбмена;
		СтрокаЭтапа.Сообщение 					= СсылкаНаСообщение(СтрРезультатыОбработки);
		СтрокаЭтапа.СостояниеСдачиОтчетности 	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден 				= СтрРезультатыОбработки.Количество() > 0;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиПерепискиСКонтролирующимиОрганами(Объект, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Объект.Ссылка);
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);

	// если сообщение входящее, то выводим дату получения
	Если Объект.Статус = Перечисления.СтатусыПисем.Полученное Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено';
														|en = 'Sent'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено';
														|en = 'Sent'");
		СтрокаЭтапа.Дата						= Объект.ДатаОтправки;
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтправленоИзКонтролирующегоОргана;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Получено';
														|en = 'Received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Получено';
														|en = 'Received'");
		СтрокаЭтапа.Дата						= Объект.ДатаСообщения;
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПриемПодтвержден;
		СтрокаЭтапа.ЭтапПройден					= Истина;

	Иначе
		
		// Не отправлено
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
														|en = 'Not sent'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
														|en = 'Not sent'");
		СтрокаЭтапа.Дата						= Дата(1,1,1);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	
		Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
		
		Если Объект.Тип = Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСПФР Тогда
			
			// выделяем основные типы сообщений
			СтрПервичныеСообщения 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР));
			СтрКвитанции 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР));
			
			Если СтрПервичныеСообщения.Количество() > 0 И СтрПервичныеСообщения[0].Статус = Перечисления.СтатусыПисем.Исходящее Тогда
				Возврат ТаблицаЭтаповОтправки;
			КонецЕсли;
			
			Если НеПолучатьДаты Тогда
				ДатаОтправки 			= Дата(1,1,1);
				ДатаПолученияКвитанции 	= Дата(1,1,1);
			Иначе
				ДатаОтправки 			= ?(ЗначениеЗаполнено(Объект.ДатаСообщения) , " " + Формат(Объект.ДатаСообщения, "ДЛФ=DT"), Дата(1,1,1));
				ДатаПолученияКвитанции 	= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].ДатаТранспорта, Дата(1,1,1));
			КонецЕсли;
			
			ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
				Объект.Ссылка,,
				?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.ДатаСоздания, Неопределено),
				?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.Вид, Неопределено),
				?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.Тип, Неопределено));
			
			ТекстОтправлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
				НСтр("ru = 'Отправлено в ПФР';
					|en = 'Sent to PF'"),,, НЕ ЭтоОтправкаВСФР);
			ТекстОжидаетсяДоставка = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
				НСтр("ru = 'Ожидается доставка письма в ПФР';
					|en = 'Awaiting delivery of email to PF'"),,, НЕ ЭтоОтправкаВСФР);
			ТекстДоставлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
				НСтр("ru = 'Доставлено в ПФР';
					|en = 'Delivered to PF'"),,, НЕ ЭтоОтправкаВСФР);
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ТекстОтправлено;
			СтрокаЭтапа.ТекстСтатуса				= ТекстОтправлено;
			СтрокаЭтапа.Дата						= ДатаОтправки;
			СтрокаЭтапа.КомментарийКСостоянию		= ТекстОжидаетсяДоставка;
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщения.Количество() > 0;

			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ТекстДоставлено;
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Доставлено';
															|en = 'Delivered'");
			СтрокаЭтапа.Дата						= ДатаПолученияКвитанции;
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о получении';
															|en = 'Notice of receipt'");
			СтрокаЭтапа.Протокол					= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрКвитанции.Количество() > 0;
			
		// переписка с Росстатом
		ИначеЕсли Объект.Тип = Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСФСГС Тогда
			
			// выделяем основные типы сообщений
			СтрПервичныеСообщения 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС));
			СтрПодтвержденияДатыОтправки 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС));
			СтрИзвещенияПодтвержденияДатыОтправки 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеДатыОтправкиФСГС));
			СтрКвитанции 							= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоИсходящееФСГС));
			
			Если СтрПервичныеСообщения.Количество() > 0 И СтрПервичныеСообщения[0].Статус = Перечисления.СтатусыПисем.Исходящее Тогда
				Возврат ТаблицаЭтаповОтправки;
			КонецЕсли;
			
			Если НеПолучатьДаты Тогда
				ДатаОтправкиПервичного 			= Дата(1,1,1);
				ДатаПолученияКвитанции 			= Дата(1,1,1);
			Иначе
				ДатаОтправкиПервичного 			= ?(СтрПервичныеСообщения.Количество() > 0, СтрПервичныеСообщения[0].Дата, Дата(1,1,1));
				ДатаПолученияКвитанции 			= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].ДатаТранспорта, Дата(1,1,1));
			КонецЕсли;
						
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
															|en = 'Sent to the provider'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
															|en = 'Sent to the provider'");
			СтрокаЭтапа.Дата						= ДатаОтправкиПервичного;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
															|en = 'Awaiting confirmation of sending date'");
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщения.Количество() > 0;
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в Росстат';
															|en = 'Sent to Russian Federal State Statistics Service'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в Росстат';
															|en = 'Sent to Russian Federal State Statistics Service'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияДатыОтправки, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается доставка письма в Росстат';
															|en = 'Awaiting delivery of email to Russian Federal State Statistics Service'");
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
															|en = 'Sending date confirmation'");
			СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияДатыОтправки.Количество() > 0, СтрПодтвержденияДатыОтправки[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияДатыОтправки.Количество() > 0;
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Доставлено в Росстат';
															|en = 'Delivered to Russian Federal State Statistics Service'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Доставлено';
															|en = 'Delivered'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрКвитанции, НеПолучатьДаты);
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Извещение о получении';
															|en = 'Receipt notification'");
			СтрокаЭтапа.Протокол					= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].Ссылка, "");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= СтрКвитанции.Количество() > 0;
			
		Иначе // если переписка с ФНС
			
			// выделяем основные типы сообщений
			СтрОбращенияНП 					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ОбращениеНП));
			СтрПодтвержденияОбращениеНО 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеОбращениеНО));
			СтрИзвещенияПодтверждениеНП 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
			СтрИзвещенияОбращениеНО 		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбращениеНО));
			// эти статусы есть только в случае ошибки
			СтрРезультатыПриемаОбращениеНО 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаОбращениеНО));
			СтрИзвещенияРезультатПриемаНП 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
			
			Если СтрОбращенияНП.Количество() > 0 И СтрОбращенияНП[0].Статус = Перечисления.СтатусыПисем.Исходящее Тогда
				Возврат ТаблицаЭтаповОтправки;
			КонецЕсли;

			Если НеПолучатьДаты Тогда
				ДатаОтправкиПервичного 	= Дата(1,1,1);
			Иначе
				ДатаОтправкиПервичного 	= ?(СтрОбращенияНП.Количество() > 0, СтрОбращенияНП[0].ДатаТранспорта, Дата(1,1,1));
			КонецЕсли;
			
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
															|en = 'Sent to the provider'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
															|en = 'Sent to the provider'");
			СтрокаЭтапа.Дата						= ДатаОтправкиПервичного;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
															|en = 'Awaiting confirmation of sending date'");
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрОбращенияНП.Количество() > 0;
					
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
															|en = 'Sent to FTS'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
															|en = 'Sent to FTS'");
			СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрПодтвержденияОбращениеНО, НеПолучатьДаты);;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается доставка письма в ФНС';
															|en = 'Awaiting delivery of email to FTS'");
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
															|en = 'Sending date confirmation'");
			СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияОбращениеНО.Количество() > 0, СтрПодтвержденияОбращениеНО[0].Ссылка, Дата(1,1,1));
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияОбращениеНО.Количество() > 0;
			
			Если СтрРезультатыПриемаОбращениеНО.Количество() <> 0 Тогда
				
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не принято';
																|en = 'Not received'");
				СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не принято';
																|en = 'Not received'");
				СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрРезультатыПриемаОбращениеНО, НеПолучатьДаты);
				СтрокаЭтапа.КомментарийКСостоянию		= "";
				СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
																|en = 'Notification of refusal'");
				СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаОбращениеНО.Количество() > 0, СтрРезультатыПриемаОбращениеНО[0].Ссылка, Дата(1,1,1));
				СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаОбращениеНО.Количество() > 0;

			Иначе
				
				СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
				СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Доставлено в ФНС';
																|en = 'Delivered to FTS'");
				СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Доставлено';
																|en = 'Delivered'");
				СтрокаЭтапа.Дата						= ДатаИзОтвета(СтрИзвещенияОбращениеНО, НеПолучатьДаты);
				СтрокаЭтапа.КомментарийКСостоянию		= "";
				СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Извещение о получении';
																|en = 'Receipt notification'");
				СтрокаЭтапа.Протокол					= ?(СтрИзвещенияОбращениеНО.Количество() > 0, СтрИзвещенияОбращениеНО[0].Ссылка, Дата(1,1,1));
				СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
				СтрокаЭтапа.ЭтапПройден					= СтрИзвещенияОбращениеНО.Количество() > 0;
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиМакетаПенсионногоДела(Объект, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(Объект.Ссылка);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Объект.Ссылка);
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
		
	// Не отправлено
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;

	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	Если Объект.Тип = Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСПФР Тогда
		
		// выделяем основные типы сообщений
		СтрПервичныеСообщения 	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР));
		СтрКвитанции 			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР));
		
		Если СтрПервичныеСообщения.Количество() > 0 И СтрПервичныеСообщения[0].Статус = Перечисления.СтатусыПисем.Исходящее Тогда
			Возврат ТаблицаЭтаповОтправки;
		КонецЕсли;
		
		Если НеПолучатьДаты Тогда
			ДатаОтправки 			= Дата(1,1,1);
			ДатаПолученияКвитанции 	= Дата(1,1,1);
		Иначе
			ДатаОтправки 			= ?(ЗначениеЗаполнено(Объект.ДатаСоздания) , " " + Формат(Объект.ДатаСоздания, "ДЛФ=DT"), Дата(1,1,1));
			ДатаПолученияКвитанции 	= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].ДатаТранспорта, Дата(1,1,1));
		КонецЕсли;
		
		ЭтоОтправкаВСФР = ДокументооборотСКОКлиентСервер.ЭтоОтправкаВСФР(
			Объект.Ссылка,,
			?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.ДатаСоздания, Неопределено),
			?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.Вид, Неопределено),
			?(ЗначениеЗаполнено(ЦиклОбмена), ЦиклОбмена.Тип, Неопределено));
		
		ТекстОтправлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Отправлено в ПФР';
				|en = 'Sent to PF'"),,, НЕ ЭтоОтправкаВСФР);
		ТекстОжидаетсяДоставка = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Ожидается доставка письма в ПФР';
				|en = 'Awaiting delivery of email to PF'"),,, НЕ ЭтоОтправкаВСФР);
		ТекстДоставлено = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Доставлено в ПФР';
				|en = 'Delivered to PF'"),,, НЕ ЭтоОтправкаВСФР);
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстОтправлено;
		СтрокаЭтапа.ТекстСтатуса				= ТекстОтправлено;
		СтрокаЭтапа.Дата						= ДатаОтправки;
		СтрокаЭтапа.КомментарийКСостоянию		= ТекстОжидаетсяДоставка;
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СтрПервичныеСообщения.Количество() > 0;

		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстДоставлено;
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Доставлено';
														|en = 'Delivered'");
		СтрокаЭтапа.Дата						= ДатаПолученияКвитанции;
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о получении';
														|en = 'Notice of receipt'");
		СтрокаЭтапа.Протокол					= ?(СтрКвитанции.Количество() > 0, СтрКвитанции[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрКвитанции.Количество() > 0;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиОтветовНаТребованияФНС(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	// получаем список сообщений
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ЦиклОбмена = ДополнительныеПараметры.Отправка;
	Иначе
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(СсылкаНаОтчет);
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,ПоказыватьПомеченныеНаУдаление,Истина);
	
	// выделяем основные типы сообщений
	СтрПредставленияНП					= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП));
	СтрПодтвержденияПредставлениеНО		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ПодтверждениеПредставлениеНО));
	СтрИзвещенияПодтверждениеНП			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП));
	СтрИзвещенияПредставлениеНО			= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеПредставлениеНО));
	СтрРезультатыПриемаПредставлениеНО	= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.РезультатПриемаПредставлениеНО));
	СтрИзвещенияРезультатПриемаНП		= СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП));
	
	// Если статус первичного - не отправлено, тогда выходим 
	Если СтрПредставленияНП.Количество() > 0 И СтрПредставленияНП[0].Статус <> Перечисления.СтатусыПисем.Отправленное Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;

	// получаем свойства для анализа
	Если НеПолучатьДаты Тогда
		ДатаОтправкиПервичного 		= Дата(1,1,1);
		ДатаИзПодтверждения			= Дата(1,1,1);
		ДатаИзИзвещенияПолучения	= Дата(1,1,1);
	Иначе
		ДатаОтправкиПервичного 		= ?(СтрПредставленияНП.Количество() > 0, 				СтрПредставленияНП[0].ДатаТранспорта, 											Дата(1,1,1));
		ДатаИзПодтверждения			= ?(СтрПодтвержденияПредставлениеНО.Количество() > 0, 	ДатаИзОтветовКонтролирующихОрганов(СтрПодтвержденияПредставлениеНО[0].Ссылка), 	Дата(1,1,1));
		ДатаИзИзвещенияПолучения	= ?(СтрИзвещенияПредставлениеНО.Количество() > 0,		ДатаИзОтветовКонтролирующихОрганов(СтрИзвещенияПредставлениеНО[0].Ссылка), 		Дата(1,1,1));
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено оператору';
													|en = 'Sent to the provider'");
	СтрокаЭтапа.Дата						= ДатаОтправкиПервичного;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается подтверждение даты отправки';
													|en = 'Awaiting confirmation of sending date'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПредставленияНП.Количество() > 0;

	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в ФНС';
													|en = 'Sent to FTS'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в ФНС';
													|en = 'Sent to FTS'");
	СтрокаЭтапа.Дата						= ДатаИзПодтверждения;
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки';
													|en = 'Processing result is expected'");
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Подтверждение даты отправки';
													|en = 'Sending date confirmation'");
	СтрокаЭтапа.Протокол					= ?(СтрПодтвержденияПредставлениеНО.Количество() > 0, СтрПодтвержденияПредставлениеНО[0].Ссылка, "");
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= СтрПодтвержденияПредставлениеНО.Количество() > 0;
	
	// определяем наиболее свежее сообщение с результатом приема
	ПоследнийРезультатПриема = Неопределено;
	Для Каждого СтрРезультатПриемаПредставлениеНО Из СтрРезультатыПриемаПредставлениеНО Цикл
		Если ПоследнийРезультатПриема = Неопределено ИЛИ СтрРезультатПриемаПредставлениеНО.Дата > ПоследнийРезультатПриема.Дата Тогда
			ПоследнийРезультатПриема = СтрРезультатПриемаПредставлениеНО;
		КонецЕсли;
	КонецЦикла;
	
	// если результат приема отрицательный, то выводим соответствующее сообщение
	Если ПоследнийРезультатПриема <> Неопределено И ПоследнийРезультатПриема.ПротоколСОшибкой Тогда
		
		Если ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.ПоясненияКДекларацииПоНДС") Тогда
			КомментарийКСостоянию = НСтр("ru = 'Исправьте ошибки и отправьте новый ответ';
										|en = 'Correct errors and send a new response'");
		Иначе
			КомментарийКСостоянию = НСтр("ru = 'Исправьте ошибки и отправьте новую опись';
										|en = 'Correct errors and send a new list'");
		КонецЕсли;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.Дата						= Дата(1,1,1);
		СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостоянию;
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Уведомление об отказе';
														|en = 'Notification of refusal'");
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаПредставлениеНО.Количество() > 0, СтрРезультатыПриемаПредставлениеНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаПредставлениеНО.Количество() > 0;

	Иначе
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято';
														|en = 'Received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято';
														|en = 'Received'");
		СтрокаЭтапа.Дата						= Дата(1,1,1);
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Квитанция о приеме';
														|en = 'Notice of acceptance'");
		СтрокаЭтапа.Протокол					= ?(СтрРезультатыПриемаПредставлениеНО.Количество() > 0, СтрРезультатыПриемаПредставлениеНО[0].Ссылка, "");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СтрРезультатыПриемаПредставлениеНО.Количество() > 0;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиРЭЦ(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НачальныйСтатус = НСтр("ru = 'Подготовка документов';
							|en = 'Prepare documents'");//НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет, "РЭЦ");
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	ПоследняяОтправка = ПолучитьПоследнююОтправкуОтчетаВРЭЦ(СсылкаНаОтчет);
	
	// определяем последнюю отправку
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда		
		ОтправкаСсылка = ДополнительныеПараметры.Отправка;		
	Иначе		
		ОтправкаСсылка = ПоследняяОтправка;		
	КонецЕсли; 
	
	// Начальный статус
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;		

	// Отправлено
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено';
													|en = 'Sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено';
													|en = 'Sent'");
	СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ПоследняяОтправка), ПоследняяОтправка.ДатаОтправки, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	//СтрокаЭтапа.Протокол					= "ЗагрузитьОтветнуюКвитанцию";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= ПоследняяОтправка <> Неопределено;
	
	Если ПоследняяОтправка <> Неопределено Тогда
		Если ПоследняяОтправка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда		
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Проверка не пройдена';
															|en = 'Check failed'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не пройдено';
															|en = 'Failed'");
			СтрокаЭтапа.Дата						= ПоследняяОтправка.ДатаЗакрытия;
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол расхождений';
															|en = 'Discrepancy protocol'");
			СтрокаЭтапа.Протокол					= ПоследняяОтправка;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки';
															|en = 'Correct errors'");
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;	
		ИначеЕсли ПоследняяОтправка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда 		
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Проверка пройдена';
															|en = 'Check passed'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Пройдено';
															|en = 'Passed'");
			СтрокаЭтапа.Дата						= ПоследняяОтправка.ДатаЗакрытия;
			СтрокаЭтапа.Протокол					= ПоследняяОтправка;
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Истина;
		Иначе
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Результат проверки';
															|en = 'Check result'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Результат';
															|en = 'Result'");
			СтрокаЭтапа.Дата						= ПоследняяОтправка.ДатаЗакрытия;
			//СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
			СтрокаЭтапа.ЭтапПройден					= Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции  

Функция ПолучитьПоследнююОтправкуОтчетаВРЭЦ(ОтчетСсылка) Экспорт
	
	Отправка = Неопределено;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПроверкаВРЭЦ") Тогда
		МодульДокументооборотСРЭЦ = ОбщегоНазначения.ОбщийМодуль("ДокументооборотСРЭЦ");
		Возврат МодульДокументооборотСРЭЦ.ПолучитьПоследнююОтправкуОтчета(ОтчетСсылка);
	КонецЕсли;
	
	Возврат Отправка;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиЗаявлениеНаФормированиеСправкиОРасчетах(СсылкаНаДокумент, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	 
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если ЗначениеЗаполнено(СсылкаНаДокумент.ДатаОтправкиВФСС) Тогда
		ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСС(СсылкаНаДокумент);
		ОбменЧерезОператора = ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ОбменЧерезОператора, Ложь);
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																				|en = 'Sent to the provider'"),
												  НСтр("ru = 'Отправлено в СФР';
														|en = 'Sent to the Social Insurance Fund of Russia'"));
		СтрокаЭтапа.ТекстСтатуса				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																				|en = 'Sent to the provider'"),
												  НСтр("ru = 'Отправлено в СФР';
														|en = 'Sent to the Social Insurance Fund of Russia'"));
		СтрокаЭтапа.Дата						= СсылкаНаДокумент.ДатаОтправкиВФСС;
		СтрокаЭтапа.КомментарийКСостоянию		= ?(ОбменЧерезОператора, НСтр("ru = 'Ожидается подтверждение доставки в СФР';
																				|en = 'Waiting for confirmation of delivery to Social Insurance Fund of Russia'"),
												  НСтр("ru = 'Ожидается прием запроса в обработку';
														|en = 'Awaiting receipt of request for processing'"));
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= ЗначениеЗаполнено(СсылкаНаДокумент.ДатаОтправкиВФСС);
		
		Если ОбменЧерезОператора И ЗначениеЗаполнено(ОтправкаСсылка) Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в СФР';
															|en = 'Sent to the Social Insurance Fund of Russia'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в СФР';
															|en = 'Sent to the Social Insurance Fund of Russia'");
			СтрокаЭтапа.Дата						= ОтправкаСсылка.ДатаДоставкиВСФР;
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается прием запроса в обработку';
															|en = 'Awaiting receipt of request for processing'");
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка.ДоставленоВСФР;
		КонецЕсли;
	КонецЕсли;
	
	Если СсылкаНаДокумент.Статус = "Зарегистрировано" ИЛИ СсылкаНаДокумент.Статус = "Справка получена" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято в обработку';
														|en = 'Accepted for processing'");
		СтрокаЭтапа.Дата						= Формат(СсылкаНаДокумент.ДатаДоставкиВФСС, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается ответ на запрос';
														|en = 'Awaiting the request response'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= СсылкаНаДокумент.Статус = "Зарегистрировано" ИЛИ СсылкаНаДокумент.Статус = "Справка получена";
	КонецЕсли;
	
	Если СсылкаНаДокумент.Статус = "Справка получена" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Готово';
														|en = 'Finish'");
		СтрокаЭтапа.Дата						= Формат(СсылкаНаДокумент.ДатаПолученияСправки, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "Справка о расчетах";
		СтрокаЭтапа.Протокол					= СсылкаНаДокумент.ВходящийФайл;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= СсылкаНаДокумент.Статус = "Справка получена";
	КонецЕсли;
	
	Если СсылкаНаДокумент.Статус = "Не принято" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСС(СсылкаНаДокумент);
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.Дата						= Формат(ОтправкаСсылка.ДатаПолученияРезультата, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= СсылкаНаДокумент.ОшибкиКонтроля;
		СтрокаЭтапа.НаименованиеПротокола		= "Протокол";
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиОтветСтрахователяНаТребованиеПроверкиФСС(СсылкаНаДокумент, ДополнительныеПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Дата КАК Дата,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ОшибкиЛогическогоКонтроля.СодержимоеОшибки) КАК ЕстьКритическиеОшибкиОтправки,
	|	ВЫБОР
	|		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ДатаОтправкиВФСС > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ""Отправлено в СФР""
	|		ИНАЧЕ ""Не отправлено""
	|	КОНЕЦ КАК Статус,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ОтветСтрахователяНаТребованиеПроверкиФСС.Комментарий КАК СТРОКА(250))) КАК Комментарий,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание КАК Требование,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ТипСообщенияОтвета = 313
	|			ТОГДА ""Ответ страхователя на запрос документов по камеральной проверке""
	|		ИНАЧЕ ""Ответ страхователя на запрос документов по выездной проверке""
	|	КОНЕЦ КАК Наименование
	|ПОМЕСТИТЬ ВТОтветы
	|ИЗ
	|	Документ.ОтветСтрахователяНаТребованиеПроверкиФСС КАК ОтветСтрахователяНаТребованиеПроверкиФСС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВходящийДокументСЭДОФСС.ОшибкиЛогическогоКонтроля КАК ОшибкиЛогическогоКонтроля
	|		ПО ОтветСтрахователяНаТребованиеПроверкиФСС.Основание = ОшибкиЛогическогоКонтроля.Ссылка
	|ГДЕ
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Дата,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка,
	|	ВЫБОР
	|		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ДатаОтправкиВФСС > ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ""Отправлено в СФР""
	|		ИНАЧЕ ""Не отправлено""
	|	КОНЕЦ,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание,
	|	ОтветСтрахователяНаТребованиеПроверкиФСС.ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА ОтветСтрахователяНаТребованиеПроверкиФСС.ТипСообщенияОтвета = 313
	|			ТОГДА ""Ответ страхователя на запрос документов по камеральной проверке""
	|		ИНАЧЕ ""Ответ страхователя на запрос документов по выездной проверке""
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТОтветы.Дата КАК Дата,
	|	ВТОтветы.Ссылка КАК Ссылка,
	|	ВТОтветы.ЕстьКритическиеОшибкиОтправки КАК ЕстьКритическиеОшибкиОтправки,
	|	ВТОтветы.Статус КАК Статус,
	|	ВТОтветы.Комментарий КАК Комментарий,
	|	СУММА(ВЫБОР
	|			КОГДА УведомленияОПриемеОтказе.Статус = 2
	|				ТОГДА УведомленияОПриемеОтказе.КоличествоДокументовВоВложении
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Отказано,
	|	СУММА(ВЫБОР
	|			КОГДА УведомленияОПриемеОтказе.Статус = 1
	|				ТОГДА УведомленияОПриемеОтказе.КоличествоДокументовВоВложении
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Принято,
	|	ВТОтветы.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТОтветы.Наименование КАК Наименование,
	|	УведомленияОПриемеОтказе.ДатаПолученияПротокола КАК ДатаПолученияПротокола
	|ПОМЕСТИТЬ ВТСтатус
	|ИЗ
	|	ВТОтветы КАК ВТОтветы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВходящийДокументСЭДОФСС.УведомленияОПриемеОтказе КАК УведомленияОПриемеОтказе
	|		ПО ВТОтветы.Ссылка = УведомленияОПриемеОтказе.ОтветНаТребованиеФСС
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОтветы.Дата,
	|	ВТОтветы.Ссылка,
	|	ВТОтветы.ЕстьКритическиеОшибкиОтправки,
	|	ВТОтветы.Статус,
	|	ВТОтветы.Комментарий,
	|	ВТОтветы.ПометкаУдаления,
	|	ВТОтветы.Наименование,
	|	УведомленияОПриемеОтказе.ДатаПолученияПротокола
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтатус.Дата КАК Дата,
	|	ВТСтатус.Ссылка КАК Ссылка,
	|	ВТСтатус.ЕстьКритическиеОшибкиОтправки КАК ЕстьКритическиеОшибкиОтправки,
	|	ВЫБОР
	|		КОГДА ВТСтатус.Принято = 0
	|				И ВТСтатус.Отказано = 0
	|			ТОГДА ВТСтатус.Статус
	|		КОГДА ВТСтатус.Принято > 0
	|				И ВТСтатус.Отказано > 0
	|			ТОГДА ""Принято частично""
	|		КОГДА ВТСтатус.Принято = 0
	|				И ВТСтатус.Отказано > 0
	|			ТОГДА ""Не принято""
	|		КОГДА ВТСтатус.Принято > 0
	|				И ВТСтатус.Отказано = 0
	|			ТОГДА ""Принято""
	|	КОНЕЦ КАК СтатусОтправки,
	|	ВТСтатус.Комментарий КАК Комментарий,
	|	ВТСтатус.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТСтатус.Наименование КАК Наименование,
	|	ВТСтатус.ДатаПолученияПротокола КАК ДатаПолученияПротокола
	|ИЗ
	|	ВТСтатус КАК ВТСтатус
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСтатус
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОтветы";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Статус = "";
	Пока Выборка.Следующий() Цикл
		Статус = Выборка.СтатусОтправки;
		ДатаПолученияПротокола = Выборка.ДатаПолученияПротокола;
	КонецЦикла;
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не отправлено';
													|en = 'Not sent'");
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если Статус = "Отправлено в СФР" Тогда
		СвойстваПоследнихОтправок = СвойстваПоследнихОтправокОтчетаВФСС(СсылкаНаДокумент);
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ?(СвойстваПоследнихОтправок.ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																										|en = 'Sent to the provider'"),
												  НСтр("ru = 'Отправлено в СФР';
														|en = 'Sent to the Social Insurance Fund of Russia'"));
		СтрокаЭтапа.ТекстСтатуса				= ?(СвойстваПоследнихОтправок.ОбменЧерезОператора, НСтр("ru = 'Отправлено оператору';
																										|en = 'Sent to the provider'"),
												  НСтр("ru = 'Отправлено в СФР';
														|en = 'Sent to the Social Insurance Fund of Russia'"));
		СтрокаЭтапа.Дата						= Формат(ДатаПолученияПротокола, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= ?(СвойстваПоследнихОтправок.ОбменЧерезОператора,
												  НСтр("ru = 'Ожидается подтверждение доставки в СФР';
														|en = 'Waiting for confirmation of delivery to Social Insurance Fund of Russia'"),
												  НСтр("ru = 'Ожидается результат обработки ответа страхователя';
														|en = 'Waiting for the result of the insurant''s response processing'"));
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
		Если СвойстваПоследнихОтправок.ОбменЧерезОператора И СвойстваПоследнихОтправок.КоличествоЗаписей <> 0 Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в СФР';
															|en = 'Sent to the Social Insurance Fund of Russia'");
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в СФР';
															|en = 'Sent to the Social Insurance Fund of Russia'");
			СтрокаЭтапа.Дата						= Формат(СвойстваПоследнихОтправок.МаксимальнаяДатаДоставкиВСФР, "ДФ=dd.MM.yyyy");
			СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки ответа страхователя';
															|en = 'Waiting for the result of the insurant''s response processing'");
			СтрокаЭтапа.НаименованиеПротокола		= "";
			СтрокаЭтапа.Протокол					= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= (СвойстваПоследнихОтправок.КоличествоДоставленныхВСФР = 
													  СвойстваПоследнихОтправок.КоличествоЗаписей);
		КонецЕсли;
	КонецЕсли;
	
	Если Статус = "Не принято" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не принято';
														|en = 'Not received'");
		СтрокаЭтапа.Дата						= Формат(ДатаПолученияПротокола, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	КонецЕсли;
	
	Если Статус = "Принято частично" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято частично';
														|en = 'Partially accepted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято частично';
														|en = 'Partially accepted'");
		СтрокаЭтапа.Дата						= Формат(ДатаПолученияПротокола, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	КонецЕсли;
	
	Если Статус = "Принято" Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Принято';
														|en = 'Accepted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Принято';
														|en = 'Accepted'");
		СтрокаЭтапа.Дата						= Формат(ДатаПолученияПротокола, "ДФ=dd.MM.yyyy");
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиВходящийДокументСЭДОФСС(СсылкаНаДокумент, ДополнительныеПараметры)
	
	НеПолучатьДаты = НЕ (ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПолучатьДаты")
		И ДополнительныеПараметры.ПолучатьДаты);
		
	ПоказыватьПомеченныеНаУдаление = ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПоказыватьПомеченныеНаУдаление")
		И ДополнительныеПараметры.ПоказыватьПомеченныеНаУдаление;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	 
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Подтвердите прием';
													|en = 'Confirm hiring'");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Подтвердите прием';
													|en = 'Confirm hiring'");
	СтрокаЭтапа.Дата						= СсылкаНаДокумент.ВходящаяДата;
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	ТипСообщения = ТипСообщенияСЭДОВЧисло(СсылкаНаДокумент.ТипСообщения);
	ТребуетсяПодтверждение = ТребуетсяПодтверждениеТипаСообщенияДоходнойЧастиСЭДО(ТипСообщения);
	ЕстьПодтверждение = ЗначениеЗаполнено(СсылкаНаДокумент.ДатаОтправкиПодтверждения);
	Статус = "";
	Если ЕстьПодтверждение Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		Если НЕ ТребуетсяПодтверждение Тогда
			Статус = СтатусДокументаДоходнойЧастиСЭДОБезПодтверждения();
		Иначе
			Статус = НСтр("ru = 'Прием подтвержден';
							|en = 'Receipt is confirmed'");
		КонецЕсли;
		СтрокаЭтапа.ТекстНадписи				= Статус;
		СтрокаЭтапа.ТекстСтатуса				= Статус;
		СтрокаЭтапа.Дата						= СсылкаНаДокумент.ДатаОтправкиПодтверждения;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Требование или уведомление получено';
														|en = 'Request or notification is received'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= ЕстьПодтверждение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаДокумент.ДатаОтправкиОтветаНаЗапрос) Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		Статус = СсылкаНаДокумент.Статус;
		СтрокаЭтапа.ТекстНадписи				= Статус;
		СтрокаЭтапа.ТекстСтатуса				= Статус;
		СтрокаЭтапа.Дата						= СсылкаНаДокумент.ДатаОтправкиОтветаНаЗапрос;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Отправлен ответ на требование';
														|en = 'A response to the request is sent'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= Истина;
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиОбращенияСФР(СсылкаНаОтчет, ДополнительныеПараметры)
	
	ЭтоОтвет = Ложь;
	Если ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.ОбращениеСФРКСтрахователю") Тогда
		НачальныйСтатус = НСтр("ru = 'Получено';
								|en = 'Received'");
	ИначеЕсли ТипЗнч(СсылкаНаОтчет) = Тип("ДокументСсылка.ОтветСтрахователяНаОбращениеСФР") Тогда
		НачальныйСтатус = ЭлектронныйДокументооборотСФССКлиентСервер.СтатусДокументаОтветаНеОтправлено();
		ЭтоОтвет = Истина;
	Иначе
		НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	КонецЕсли;
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	// определяем последнюю отправку
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ОтправкаСсылка = ДополнительныеПараметры.Отправка;
	Иначе
		ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСС(СсылкаНаОтчет);
	КонецЕсли;	
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправлено();
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	ОбменЧерезОператора = ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ОбменЧерезОператора, Ложь);
	
	ЭтоОтправкаВСФР = Истина;
		
	Если ЭтоОтвет Тогда
		ТекстОтправленоВСФР = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Отправлен в ФСС';
				|en = 'Sent to SSF'"), , , НЕ ЭтоОтправкаВСФР);
	Иначе
		ТекстОтправленоВСФР = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
			НСтр("ru = 'Ответ отправлен в ФСС';
				|en = 'The response is sent to SSF'"), , , НЕ ЭтоОтправкаВСФР);
	КонецЕсли;
	
	КомментарийОтправленоОператору = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
		НСтр("ru = 'Ожидается подтверждение доставки в ФСС';
			|en = 'Waiting for confirmation of delivery to SSF'"),,, НЕ ЭтоОтправкаВСФР);
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлен оператору';
																			|en = 'Sent to provider'"), ТекстОтправленоВСФР);
	СтрокаЭтапа.ТекстСтатуса				= ?(ОбменЧерезОператора, НСтр("ru = 'Отправлен оператору';
																			|en = 'Sent to provider'"), ТекстОтправленоВСФР);
	СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию		= ?(ОбменЧерезОператора, КомментарийОтправленоОператору,
											  НСтр("ru = 'Ожидается результат обработки ответа';
													|en = 'Waiting for the result of the response processing'"));
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено;
	
	Если ОбменЧерезОператора И ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстОтправленоВСФР;
		СтрокаЭтапа.ТекстСтатуса				= ТекстОтправленоВСФР;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.ДоставленоВСФР,
												  ?(ЗначениеЗаполнено(ОтправкаСсылка.ДатаЗакрытия)
												  И ОтправкаСсылка.ДатаЗакрытия < ОтправкаСсылка.ДатаДоставкиВСФР, ОтправкаСсылка.ДатаЗакрытия,
												  ОтправкаСсылка.ДатаДоставкиВСФР), Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки ответа';
														|en = 'Waiting for the result of the response processing'");
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка.ДоставленоВСФР
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки
												  ИЛИ ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
	КонецЕсли;
	
	Если ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
		
		ТекстСтатуса = ?(ЭтоОтвет, НСтр("ru = 'Не принят';
										|en = 'Not accepted'"), НСтр("ru = 'Ответ не принят';
																	|en = 'The response is not accepted'"));
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	Иначе
		
		Если ЭтоОтвет Тогда
			Если ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда
				ТекстДоставленоВСФР = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Доставлен в ФСС';
						|en = 'Delivered to SSF'"), , , НЕ ЭтоОтправкаВСФР);
			Иначе
				ТекстДоставленоВСФР = ТекстОтправленоВСФР;
			КонецЕсли;
		Иначе
			Если ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда
				ТекстДоставленоВСФР = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ответ доставлен в ФСС';
						|en = 'The response is delivered to SSF'"), , , НЕ ЭтоОтправкаВСФР);
			Иначе
				ТекстДоставленоВСФР = ТекстОтправленоВСФР;
			КонецЕсли;
		КонецЕсли;
		ТекстСтатуса = ТекстДоставленоВСФР;
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ТекстСтатуса;
		СтрокаЭтапа.ТекстСтатуса				= ТекстСтатуса;
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан, ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол о сдаче';
														|en = 'Delivery protocol'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
		
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

#КонецОбласти

#Область РучнойВводСтатусовОтправки

Функция НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОбъект, КонтролирующийОрган = Неопределено)
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		
		Возврат НСтр("ru = 'Подготовлено';
					|en = 'Prepared'");
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.МакетыПенсионныхДел")
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		
		Возврат НСтр("ru = 'В работе';
					|en = 'In progress'");
		
	Иначе
		
		ТекСтатус = Неопределено;
		
		ИмяТипаСправочникаМашиночитаемыеДоверенностиЦБ = "МашиночитаемыеДоверенностиЦБ";
		ИмяТипаСправочникаМашиночитаемыеДоверенности = "МашиночитаемыеДоверенности";
		Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.УведомлениеОПолучателеДокументов")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФНС")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ЗаявленияОбОтзывеМЧДФНС")
			ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС")
			ИЛИ ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует()
				И ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенностиЦБ)
			ИЛИ ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует()
				И ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
			ВыборкаЖОКО = РегистрыСведений.ЖурналОтправокВКонтролирующиеОрганы.Выбрать(Новый Структура("Ссылка", СсылкаНаОбъект));
			Если ВыборкаЖОКО.Следующий() Тогда
				ТекСтатус = ВыборкаЖОКО.СтатусОтправки;
			КонецЕсли;
		Иначе
			ВыборкаЖОС = РегистрыСведений.ЖурналОтчетовСтатусы.Выбрать(Новый Структура("Ссылка", СсылкаНаОбъект));
			Если ВыборкаЖОС.Следующий() Тогда
				ТекСтатус = ВыборкаЖОС.Статус;
			КонецЕсли;
		КонецЕсли;
		
		Если ТекСтатус = Неопределено Тогда
			Возврат НСтр("ru = 'В работе';
						|en = 'In progress'");
		КонецЕсли;
		
		ТекСтатус = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1';
																				|en = '%1'"), ТекСтатус);
		
		СтатусыОбъектов =
			РегламентированнаяОтчетностьКлиентСервер.СтатусыОбъектовРеглОтчетностиПриРучномВводе(СсылкаНаОбъект);
		
		Если СтатусыОбъектов.Найти(ТекСтатус) = Неопределено И КонтролирующийОрган <> "Минобороны" Тогда
			Возврат НСтр("ru = 'В работе';
						|en = 'In progress'");
		КонецЕсли;
		
		Возврат ТекСтатус;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПолучениеДатПротоколов

Функция ДатаИзОтветовКонтролирующихОрганов(ТранспортноеСообщение)
	
	ДатаИзОтвета = ТранспортноеСообщение.ДатаТранспорта;
	
	ВложенияТранспортногоСообщения = ПолучитьВложенияТранспортногоСообщения(ТранспортноеСообщение);
	СоответствиеТиповСодержимого = ПолучитьСоответствиеТиповСодержимого();
	
	Для Каждого Вложение Из ВложенияТранспортногоСообщения Цикл
		
		ТипСодержимого 	= Вложение.Тип;
		ТипДокумента 	= СоответствиеТиповСодержимого.Получить(Вложение.Тип);
		
		// отчетность ПФР
		Если ТипДокумента = "ФайлОтчетностиПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеПолученияОтчетностиПФР" Тогда
			
			ИмяПоляДаты 	= "датаВремяПолучения";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "СведенияПриложениеПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПротоколПФР" Тогда
			
			ИмяПоляДаты 	= "датаВремяОтправки";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "ПротоколПриложениеПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ФайлОписанияСведенийПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ЭлектронноЦифроваяПодпись" Тогда
			// Дата отсутствует в файле.
			
		// неформализованные ПФР
		ИначеЕсли ТипДокумента = "Письмо" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПисьмоПриложение" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеПолученияПисьма" Тогда
			
			ИмяПоляДаты 	= "датаВремяПолучения";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "ОписаниеПисьма" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ТранспортнаяИнформация" Тогда
			// Дата отсутствует в файле.
		
		// запросы ПФР
		ИначеЕсли ТипДокумента = "ЗапросИОС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ФайлОписанияЗапросаПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОтветНаЗапросПФР" Тогда
			
			ИмяПоляДаты 	= "датаВремяОтправки";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "ОтветПриложениеНаЗапросПФР" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеПолученияЗапросПФР" Тогда
			
			ИмяПоляДаты 	= "датаВремяПолучения";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
		
		// отчетность ФНС
		ИначеЕсли ТипДокумента = "ФайлОтчетности" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "Форма2НДФЛ" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "Доверенность" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеСведений" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеСведений2НДФЛ" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеДатыОтправки" Тогда
			
			ИмяПоляДаты 	= "ДатаОтпр";
			ИмяПоляВремени	= "ВремяОтпр";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты, ИмяПоляВремени);
			
		ИначеЕсли ТипДокумента = "УведомлениеОбОтказе" Тогда

			Если ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗапросНО 
				ИЛИ ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаОбращениеНО Тогда
				
				ИмяПоляДаты 	= "ДатаПост";
				ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
				
			Иначе
				ИмяПоляДаты 	= "ДатаФормУвед";
				ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "КвитанцияОПриеме" Тогда
			
			Если ТранспортноеСообщение.Тип = Перечисления.ТипыТранспортныхСообщений.РезультатПриемаЗапросНО Тогда
				ИмяПоляДаты 	= "ДатаПрин";
				ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			Иначе
				ИмяПоляДаты 	= "ДатаПредст";
				ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "ИзвещениеОВводе" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "УведомлениеОбУточнении" Тогда
			
			ИмяПоляДаты 	= "ДатаФормУвед";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
				
		ИначеЕсли ТипДокумента = "ИзвещениеОПолучении" Тогда
			
			ИмяПоляДаты 	= "ДатаПол";
			ИмяПоляВремени	= "ВремяПол";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты, ИмяПоляВремени);
			
		//Заявление
		ИначеЕсли ТипДокумента = "КвитанцияОПриемеЗаявления" Тогда
			
			ИмяПоляДаты 	= "ДатаРег";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "СообщениеОПростОтметки" Тогда
			
			ИмяПоляДаты 	= "ДатаСообОтм";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "УведомлениеОбОтказеОтметки" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "СообщениеОПроверке" Тогда
			
			ИмяПоляДаты 	= "ДатаУведОткз";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "СообщениеОбОтзывеЗаявления" Тогда
			
			ИмяПоляДаты 	= "ДатаОснОтз";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "СообщениеОНесоответствиях" Тогда
			
			ИмяПоляДаты 	= "ДатаФЛК";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "Заявление" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеСведенийЗаявление" Тогда
			// Дата отсутствует в файле.
			
		//Документ
		ИначеЕсли ТипДокумента = "Документ" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеДокумент" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "УведомлениеОбОтказеДокумент" Тогда
			
			ИмяПоляДаты 	= "ДатаНапр";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		ИначеЕсли ТипДокумента = "КвитанцияОПриемеДокумент" Тогда
			
			ИмяПоляДаты 	= "ДатаПрин";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		// 2-НДФЛ
		ИначеЕсли ТипДокумента = "Протокол2НДФЛ" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "Реестр2НДФЛ" Тогда
			// Дата отсутствует в файле.
			
		// обращение
		ИначеЕсли ТипДокумента = "Обращение" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "Приложение" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеДатыПолучения" Тогда
			
			ИмяПоляДаты 	= "ДатаОтпр";
			ИмяПоляВремени	= "ВремяОтпр";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты, ИмяПоляВремени);
			
		ИначеЕсли ТипДокумента = "ОписаниеСведенийОбращениеПисьмоРассылка" Тогда
			// Дата отсутствует в файле.
			
		// представление
		ИначеЕсли ТипДокумента = "Представление" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ДоверенностьПредставление" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеПредставление" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеДатыОтправкиПредставление" Тогда
			
			ИмяПоляДаты 	= "ДатаОтпр";
			ИмяПоляВремени	= "ВремяОтпр";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты, ИмяПоляВремени);
			
		// входящие неформализованные
		ИначеЕсли ТипДокумента = "Рассылка" Тогда
			// Дата отсутствует в файле.
			
		// запросы
		ИначеЕсли ТипДокумента = "Запрос" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "Ответ" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеСведенийЗапрос" Тогда
			
			ИмяПоляДаты 	= "ДатаВремяФормирования";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты);
			
		// отчетность в Росстат
		ИначеЕсли ТипДокумента = "ФайлОтчетностиФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ИзвещениеОПолученииДокументаФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПодтверждениеОператораФСГС" Тогда
			
			ИмяПоляДаты 	= "ДатаОтпр";
			ИмяПоляВремени	= "ВремяОтпр";
			ДатаИзОтвета 	= ДатаИзXMLФайлаОтвета(ТранспортноеСообщение, Вложение.Тип, ИмяПоляДаты, ИмяПоляВремени);
			
		ИначеЕсли ТипДокумента = "УведомлениеОПриемеВОбработкуОтчетаФСГС" Тогда
			ДатаИзОтвета 	= ДатаИзПротоколаФСГС(ТранспортноеСообщение, Вложение.Тип);
		ИначеЕсли ТипДокумента = "УведомлениеОбУточненииОтчетаФСГС" Тогда
			ДатаИзОтвета 	= ДатаИзПротоколаФСГС(ТранспортноеСообщение, Вложение.Тип);
		ИначеЕсли ТипДокумента = "УведомлениеОНесоответствииФорматуОтчетаФСГС" Тогда
			ДатаИзОтвета 	= ДатаИзПротоколаФСГС(ТранспортноеСообщение, Вложение.Тип);
		ИначеЕсли ТипДокумента = "УведомлениеОбОтказеОтчетаФСГС" Тогда
			ДатаИзОтвета 	= ДатаИзПротоколаФСГС(ТранспортноеСообщение, Вложение.Тип);
		ИначеЕсли ТипДокумента = "УведомлениеОбОтклоненииОтчетаФСГС" Тогда
			ДатаИзОтвета 	= ДатаИзПротоколаФСГС(ТранспортноеСообщение, Вложение.Тип);
		ИначеЕсли ТипДокумента = "ОписаниеФайлаОтчетностиФСГС" Тогда
			// Дата отсутствует в файле.
			
		// переписка с Росстатом
		ИначеЕсли ТипДокумента = "ПисьмоФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "РассылкаФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "РассылкаШаблоновФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ПриложениеПисьмаФСГС" Тогда
			// Дата отсутствует в файле.
		ИначеЕсли ТипДокумента = "ОписаниеПисьмаФСГС" Тогда
			// Дата отсутствует в файле.
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДатаИзОтвета;

КонецФункции

Функция ДатаВремяИзСтрокиXML(ЗначениеСтр) Экспорт
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), ЗначениеСтр);
	Исключение
		Попытка
			Возврат ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ЗначениеСтр);
		Исключение
			Возврат '00010101';
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьРасширениеФайлаФССПоТипуОтправляемогоДокумента(
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента = Неопределено,
		ОтправкаЧерезСЭДО = Ложь) Экспорт
	
	Если ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4ФСС И НЕ ОтправкаЧерезСЭДО Тогда
		
		Возврат "ef4";
		
	ИначеЕсли ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
		И НЕ ОтправкаЧерезСЭДО Тогда
		
		Возврат "esl";
		
	ИначеЕсли ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС Тогда
		
		Возврат "e4a";
		
	ИначеЕсли ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС
		ИЛИ ОтправкаЧерезСЭДО Тогда
		
		Возврат "xml";
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции

Функция СведенияПоОтправляемымОбъектам(Знач Ссылка, ДобавлятьБывш = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ВидКонтролирующегоОргана");
	Результат.Вставить("КодКонтролирующегоОргана");
	Результат.Вставить("ПредставлениеКонтролирующегоОргана");
	Результат.Вставить("Организация");
	Результат.Вставить("Наименование");
	Результат.Вставить("ПредставлениеПериода");
	Результат.Вставить("Дата");
	Результат.Вставить("ВариантОтчета");
	Результат.Вставить("СтраницаЖурнала");
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ТранспортноеСообщение") Тогда
		Ссылка = Ссылка.ЦиклОбмена.Предмет;
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ОписиВходящихДокументовИзНалоговыхОрганов") Тогда
		Ссылка = Ссылка.ВходящиеДокументы[0].СсылкаНаОбъект;
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаявлениеАбонентаСпецоператораСвязи") Тогда
		
		Результат.Ссылка 								= Ссылка;
		Результат.ВидКонтролирующегоОргана 				= Неопределено;
		Результат.КодКонтролирующегоОргана 				= "";
		Результат.ПредставлениеКонтролирующегоОргана	= "";
		Результат.Организация							= Ссылка.Организация;
		Результат.Наименование 							= ?(Ссылка.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Изменение,
			НСтр("ru = 'Заявление на изменение подключения к 1С-Отчетности';
				|en = 'Application for change of connection to 1C Reporting'"), НСтр("ru = 'Заявление на подключение';
																					|en = 'Connection application'"));
		Результат.ПредставлениеПериода					= "";
		Результат.Дата									= Ссылка.Дата;
		Результат.ВариантОтчета							= "-";
		Результат.СтраницаЖурнала						= Неопределено;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаявлениеНаФормированиеСправкиОРасчетах") Тогда
		
		Результат.Ссылка 								= Ссылка;
		Результат.ВидКонтролирующегоОргана 				= Перечисления.ТипыКонтролирующихОрганов.ФСС;
		Результат.КодКонтролирующегоОргана 				= Ссылка.КодПодчиненностиФСС;
		Результат.ПредставлениеКонтролирующегоОргана	= "СФР " + Ссылка.КодПодчиненностиФСС;
		Результат.Организация							= Ссылка.Организация;
		Результат.Наименование 							= НСтр("ru = 'Справка о расчетах';
																	|en = 'Statement of payments'");
		Результат.ПредставлениеПериода					= "на " + Формат(Ссылка.ДатаЗадолженности, "ДФ=dd.MM.yyyy");
		Результат.Дата									= Ссылка.ДатаЗадолженности;
		Результат.ВариантОтчета							= "-";
		Результат.СтраницаЖурнала						= Неопределено;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОтветСтрахователяНаТребованиеПроверкиФСС") Тогда
		
		СвойстваОрганизации = ДокументооборотСКОВызовСервера.ПолучитьСвойстваОрганизации(Ссылка.Организация);
		
		КодПодчиненностиФСС = ДокументооборотСКОВызовСервера.ПолучитьРеквизит(
			Ссылка.Организация,
			"КодПодчиненностиФСС");
		Если КодПодчиненностиФСС = "" Тогда
			РегистрационныйНомерФСС = ДокументооборотСКОВызовСервера.ПолучитьРеквизит(
				Ссылка.Организация,
				"РегистрационныйНомерФСС");
			КодПодчиненностиФСС = Лев(РегистрационныйНомерФСС, 5);
		КонецЕсли;
		
		Результат.Ссылка 								= Ссылка;
		Результат.Организация							= Ссылка.Организация;
		Результат.ВидКонтролирующегоОргана 				= Перечисления.ТипыКонтролирующихОрганов.ФСС;
		Результат.КодКонтролирующегоОргана 				= КодПодчиненностиФСС;
		Результат.ПредставлениеКонтролирующегоОргана	= "СФР " + КодПодчиненностиФСС;
		Результат.Наименование 							= НСтр("ru = 'Ответ страхователя на требование о предоставлении документов в СФР';
																	|en = 'Insurant''s response to the request to provide documents to the Social Insurance Fund of Russia'");
		Результат.ПредставлениеПериода					= "";
		Результат.Дата									= Ссылка.Дата;
		Результат.ВариантОтчета							= "-";
		Результат.СтраницаЖурнала						= Неопределено;

	Иначе
		
		Свойства = СвойстваОбъектовФормы1СОтчетность(Ссылка);
		
		// Если свойства получить не удалось, то возвращаем пустую структура
		Если Свойства = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		// Ссылка
		Если Свойства.Свойство("ДокСсылка") Тогда
			Результат.Ссылка = Свойства.ДокСсылка;
		ИначеЕсли Свойства.Свойство("Ссылка") Тогда
			Результат.Ссылка = Свойства.Ссылка;
		КонецЕсли;
		
		// ВидКонтролирующегоОргана
		Если Свойства.Свойство("ВидКонтролирующегоОргана") Тогда
			Результат.ВидКонтролирующегоОргана = Свойства.ВидКонтролирующегоОргана;
		КонецЕсли;
		
		// КодКонтролирующегоОргана
		Если Свойства.Свойство("КодКонтролирующегоОргана") Тогда
			Результат.КодКонтролирующегоОргана = Свойства.КодКонтролирующегоОргана;
		КонецЕсли;
		
		// ПредставлениеКонтролирующегоОргана
		Если Свойства.Свойство("ВидКонтролирующегоОргана") И Свойства.Свойство("КодКонтролирующегоОргана") Тогда
			Результат.ПредставлениеКонтролирующегоОргана =
				РегламентированнаяОтчетностьВызовСервера.ПредставлениеКонтролирующегоОргана(Свойства, ДобавлятьБывш);
		КонецЕсли;
		
		// Организация
		Если Свойства.Свойство("Организация") Тогда
			Результат.Организация = Свойства.Организация;
		КонецЕсли;
		
		// Наименование
		Если Свойства.Свойство("НаименованиеОтчета") Тогда
			Результат.Наименование = Свойства.НаименованиеОтчета;
		ИначеЕсли Свойства.Свойство("Наименование") Тогда
			Результат.Наименование = Свойства.Наименование;
		КонецЕсли;

		// ПредставлениеПериода
		Если Свойства.Свойство("ПредставлениеПериода") Тогда
			Результат.ПредставлениеПериода = Свойства.ПредставлениеПериода;
		ИначеЕсли Свойства.Свойство("ДатаНачалаОП") И Свойства.Свойство("ДатаОкончанияОП") Тогда
			Результат.ПредставлениеПериода = РегламентированнаяОтчетностьВызовСервера.ПредставлениеФинансовогоПериода(Свойства.ДатаНачалаОП, Свойства.ДатаОкончанияОП);
		КонецЕсли;
		
		// Дата
		Если Свойства.Свойство("ДатаСоздания") Тогда
			Результат.Дата = Свойства.ДатаСоздания;
		Иначе
			Результат.Дата = Дата(1,1,1);
		КонецЕсли;
		
		// ВариантОтчета
		Если Свойства.Свойство("ПредставлениеВида") Тогда
			Результат.ВариантОтчета = Свойства.ПредставлениеВида;
		Иначе
			Результат.ВариантОтчета = "";
		КонецЕсли;
		
		// СтраницаЖурнала
		Если Свойства.Свойство("СтраницаЖурнала") Тогда
			Результат.СтраницаЖурнала = Свойства.СтраницаЖурнала;
		Иначе
			Результат.СтраницаЖурнала = Перечисления.СтраницыЖурналаОтчетность.Отчеты;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

Функция СсылкаНаСообщение(ТранспотрныеСообщения) Экспорт

	Возврат ?(ТранспотрныеСообщения.Количество() > 0, ТранспотрныеСообщения[0].Ссылка, Неопределено);
	
