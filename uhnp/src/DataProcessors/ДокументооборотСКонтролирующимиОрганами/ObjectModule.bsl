Функция ФорматДокументооборотаСПФР(
		ОтчетИлиВидОтправляемогоОтчета,
		ПолноеИмяФайла = Неопределено,
		ИсходноеИмяФайла = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ОтчетИлиВидОтправляемогоОтчета) И ТипЗнч(ОтчетИлиВидОтправляемогоОтчета) <>
		Тип("СправочникСсылка.ВидыОтправляемыхДокументов") Тогда
		
		ТипЗнчОтчета = ТипЗнч(ОтчетИлиВидОтправляемогоОтчета);
		МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчОтчета);
		Если МетаданныеОтчета = Неопределено Тогда
			ВидОтправляемогоОтчета = ОтчетИлиВидОтправляемогоОтчета;
			
		Иначе
			ИмяМетаданныхОтчета = МетаданныеОтчета.Имя;
			Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
				ВидОтчетаИлиСтрока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетИлиВидОтправляемогоОтчета, "ИсточникОтчета");
			ИначеЕсли ИмяМетаданныхОтчета = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
				ВидОтчетаИлиСтрока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетИлиВидОтправляемогоОтчета, "ВидОтчета");
			Иначе
				ВидОтчетаИлиСтрока = ИмяМетаданныхОтчета;
			КонецЕсли;
			
			Если ТипЗнч(ВидОтчетаИлиСтрока) = Тип("СправочникСсылка.ВидыОтправляемыхДокументов") Тогда
				ВидОтправляемогоОтчета = ВидОтчетаИлиСтрока;
				
			ИначеЕсли ВидОтчетаИлиСтрока = "ПерепискаСКонтролирующимиОрганами"
				ИЛИ ВидОтчетаИлиСтрока = "ЗапросНаИнформационноеОбслуживаниеСтрахователя"
				ИЛИ ВидОтчетаИлиСтрока = "МакетыПенсионныхДел" ИЛИ ВидОтчетаИлиСтрока = "ЗаявлениеОНазначенииПенсии" Тогда
				
				ВидОтправляемогоОтчета = ОтчетИлиВидОтправляемогоОтчета;
				
			Иначе
				ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", ВидОтчетаИлиСтрока);
				Если ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
					ВидОтправляемогоОтчетаПереопределяемый = ВидОтправляемогоДокументаПоСсылке(ОтчетИлиВидОтправляемогоОтчета);
					Если НЕ ЗначениеЗаполнено(ВидОтправляемогоОтчетаПереопределяемый)
						И СтрНачинаетсяС(ВидОтчетаИлиСтрока, "EF_") Тогда
						ВидОтправляемогоОтчетаПереопределяемый =
							Справочники.ВидыОтправляемыхДокументов.ПрочаяОтчетностьПФРДляВыпускаПатчей;
					КонецЕсли;
					Если ЗначениеЗаполнено(ВидОтправляемогоОтчетаПереопределяемый) Тогда
						ВидОтправляемогоОтчета = ВидОтправляемогоОтчетаПереопределяемый;
					Иначе
						ВидОтправляемогоОтчета = ОтчетИлиВидОтправляемогоОтчета;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ВидОтправляемогоОтчета = ОтчетИлиВидОтправляемогоОтчета;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ФорматДокументооборота", 	Перечисления.ФорматыДокументооборотаСПФР.БПИ);
	Результат.Вставить("ЭтоВозможныйФормат", 		Ложь);
	
	Если ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОТрудовойДеятельностиРаботниковСЗВ_ТД
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ЗаявленияПоЭлДокументооборотуСПФР
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.УведомлениеОПредоставленииПолномочийПредставителю
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.УведомлениеОПрекращенииПолномочийПредставителя
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ЕФС1СЗПГос
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ЕФС1ОСС
		ИЛИ ЗначениеЗаполнено(ИсходноеИмяФайла) И СтрНайти(ВРег(ИсходноеИмяФайла), "_ЕФС-1_") <> 0
		ИЛИ (ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОЗастрахованныхЛицахСЗВ_М
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОСтраховомСтажеЗастрахованныхЛицСЗВ_СТАЖ
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ДанныеОКорректировкеСведенийЗастрахованныхЛицСЗВ_КОРР
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОЗаработкеСтажеЗастрахованныхЛицСЗВ_ИСХ
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ОписьОДВ_1)
			И ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.СЗВ-хх,ОДВ-1 по ЭДОК", '20230101')
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияДляИсчисленияДоплатыКПенсииСЗВ_ДСО
		ИЛИ ((ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.АнкетаЗастрахованногоЛица
			ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ЗаявлениеОбОбменеДубликатеСтраховогоСвидетельства
			ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПачкаДокументовАДВ2
			ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПачкаДокументовАДВ3)
			И СтрНайти(ВРег(ИсходноеИмяФайла), "PFR-") = 0)
		ИЛИ ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.ПрочаяОтчетностьПФРДляВыпускаПатчей Тогда
		
		Результат.ФорматДокументооборота 	= Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
		Результат.ЭтоВозможныйФормат 		= Ложь;
		
	ИначеЕсли ФорматДокументооборотаСЗВК() = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК
		И ВидОтправляемогоОтчета = Справочники.ВидыОтправляемыхДокументов.СведенияОТрудовомСтажеЗастрахованногоЛицаСЗВК Тогда
		
		Если ПолноеИмяФайла = Неопределено Тогда
			Результат.ФорматДокументооборота 	= Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
			Результат.ЭтоВозможныйФормат 		= Истина;
			
		Иначе
			Результат.ФорматДокументооборота 	= ОпределитьТипФайлаПФР(ПолноеИмяФайла, ИсходноеИмяФайла).ФорматДокументооборота;
			Результат.ЭтоВозможныйФормат 		= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

