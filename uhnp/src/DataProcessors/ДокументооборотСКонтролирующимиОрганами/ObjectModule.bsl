	Возврат ЗначенияЗаполнения;
	
КонецФункции

#КонецОбласти

Функция ПолучитьДатыПолученияСообщений(
		Организация,
		ТекущаяДата,
		ОбменПоСЭДОНапрямую = Ложь,
		РазрешенАнализВходящих = Ложь) Экспорт
	
	МаксимальноеЧислоМесяцевПолученияЧерезОператора = 12;
	
	МассивДат 					= Новый Массив;
	ОбменЧерезОператора 		= Неопределено;
	ДатаПоследнегоСеансаОбмена 	= Неопределено;
	РазностьДат 				= 0;

	Если НЕ ЗначениеЗаполнено(ТекущаяДата) Тогда
		ТекущаяДата = МестноеВремя(ТекущаяУниверсальнаяДата(), "Europe/Moscow");
	Иначе
		ТекущаяДатаУниверсальноеВремя = УниверсальноеВремя(ТекущаяДата);
		ТекущаяДата = МестноеВремя(ТекущаяДатаУниверсальноеВремя, "Europe/Moscow");
	КонецЕсли;
	МинимальнаяДата = ДобавитьМесяц(ТекущаяДата, - МаксимальноеЧислоМесяцевПолученияЧерезОператора);
	
	ДатыПолученияСообщений = ТаблицаДатПолученияСообщенийСЭДО();
	
	ОперацияПолученияСписка = ЭлектронныйДокументооборотСФССКлиентСервер.ОперацияЗаписиДатыПолученияСпискаСообщенияСЭДО();
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналСобытийОбменаСЭДО.ДатаСобытия КАК Дата,
		|	РАЗНОСТЬДАТ(ЖурналСобытийОбменаСЭДО.ДатаСобытия, &ТекущаяДата, ДЕНЬ) КАК РазностьДат,
		|	ЖурналСобытийОбменаСЭДО.ОбменЧерезОператора КАК ОбменЧерезОператора,
		|	ЖурналСобытийОбменаСЭДО.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	ЖурналСобытийОбменаСЭДО.Событие КАК Событие
		|ПОМЕСТИТЬ ВТ_ТаблицаСобытий
		|ИЗ
		|	РегистрСведений.ЖурналСобытийОбменаСЭДО КАК ЖурналСобытийОбменаСЭДО
		|ГДЕ
		|	ЖурналСобытийОбменаСЭДО.Организация = &Организация
		|	И ЖурналСобытийОбменаСЭДО.ДатаСобытия <= &ТекущаяДата
		|	И (ЖурналСобытийОбменаСЭДО.Событие = &СобытиеПолучениеСпискаСообщений
		|			ИЛИ ЖурналСобытийОбменаСЭДО.Событие = &СобытиеПолученияНовогоВходящегоСообщения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_ТаблицаСобытий.Дата КАК Дата,
		|	ВТ_ТаблицаСобытий.РазностьДат КАК РазностьДат,
		|	ВТ_ТаблицаСобытий.ОбменЧерезОператора КАК ОбменЧерезОператора
		|ИЗ
		|	ВТ_ТаблицаСобытий КАК ВТ_ТаблицаСобытий
		|ГДЕ
		|	ВТ_ТаблицаСобытий.Событие = &СобытиеПолучениеСпискаСообщений
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_ТаблицаСобытий.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата);
	Запрос.УстановитьПараметр("СобытиеПолучениеСпискаСообщений",
		Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщений);
	Запрос.УстановитьПараметр("СобытиеПолученияНовогоВходящегоСообщения",
		Перечисления.СобытияОбменаСЭДО.ПолучениеИдентификатораВходящегоСообщения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Найдено = Ложь;
	Если Выборка.Следующий() Тогда
		ДатаПоследнегоСеансаОбмена 	= Выборка.Дата;
		РазностьДат 				= Выборка.РазностьДат;
		ОбменЧерезОператора 		= Выборка.ОбменЧерезОператора;
		Найдено 					= Истина;
	КонецЕсли;
	
	СообщенияДоСЭДОЧерезОператораПолучены = (ОбменЧерезОператора = Истина);
	
	Если ОбменПоСЭДОНапрямую И СообщенияДоСЭДОЧерезОператораПолучены Тогда

		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВТ_ТаблицаСобытий.Дата КАК Дата,
			|	ВТ_ТаблицаСобытий.РазностьДат КАК РазностьДат
			|ИЗ
			|	ВТ_ТаблицаСобытий КАК ВТ_ТаблицаСобытий
			|ГДЕ
			|	НЕ ВТ_ТаблицаСобытий.ОбменЧерезОператора
			|	И ВТ_ТаблицаСобытий.Событие = &СобытиеПолученияИдентификаторов
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВТ_ТаблицаСобытий.Дата,
			|	ВТ_ТаблицаСобытий.РазностьДат
			|ИЗ
			|	ВТ_ТаблицаСобытий КАК ВТ_ТаблицаСобытий
			|ГДЕ
			|	ВТ_ТаблицаСобытий.Дата <= &ТекущаяДата
			|	И ВТ_ТаблицаСобытий.Дата >= &МинимальнаяДата
			|	И ВТ_ТаблицаСобытий.Событие = &СобытиеПолученияНовогоВходящегоСообщения
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата УБЫВ");
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		
		Запрос.УстановитьПараметр("Организация", 		Организация);
		Запрос.УстановитьПараметр("ТекущаяДата", 		ТекущаяДата);
		Запрос.УстановитьПараметр("МинимальнаяДата", 	МинимальнаяДата);
		Запрос.УстановитьПараметр("СобытиеПолученияИдентификаторов",
			Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщений);
		Запрос.УстановитьПараметр("СобытиеПолученияНовогоВходящегоСообщения",
			Перечисления.СобытияОбменаСЭДО.ПолучениеИдентификатораВходящегоСообщения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДатаПоследнегоСеансаОбмена 	= Выборка.Дата;
			РазностьДат 				= Выборка.РазностьДат;
			Найдено 					= Истина;
			
		Иначе
			ДатаПоследнегоСеансаОбмена 	= Неопределено;
			РазностьДат 				= 0;
			ОбменЧерезОператора 		= Неопределено;
			Найдено 					= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ОбменПоСЭДОНапрямую И НЕ СообщенияДоСЭДОЧерезОператораПолучены И РазрешенАнализВходящих Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВТ_ТаблицаСобытий.Дата КАК Дата,
			|	ВТ_ТаблицаСобытий.РазностьДат КАК РазностьДат
			|ИЗ
			|	ВТ_ТаблицаСобытий КАК ВТ_ТаблицаСобытий
			|ГДЕ
			|	ВТ_ТаблицаСобытий.Дата <= &ТекущаяДата
			|	И ВТ_ТаблицаСобытий.Дата >= &МинимальнаяДата
			|	И ВТ_ТаблицаСобытий.Событие = &СобытиеПолученияНовогоВходящегоСообщения
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВТ_ТаблицаСобытий.Дата УБЫВ");
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		
		Запрос.УстановитьПараметр("Организация", 		Организация);
		Запрос.УстановитьПараметр("ТекущаяДата", 		ТекущаяДата);
		Запрос.УстановитьПараметр("МинимальнаяДата", 	МинимальнаяДата);
		Запрос.УстановитьПараметр("СобытиеПолученияНовогоВходящегоСообщения",
			Перечисления.СобытияОбменаСЭДО.ПолучениеИдентификатораВходящегоСообщения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И (ДатаПоследнегоСеансаОбмена = Неопределено
				ИЛИ Выборка.Дата < ДатаПоследнегоСеансаОбмена) Тогда
			
			ДатаПоследнегоСеансаОбмена 	= Выборка.Дата;
			РазностьДат 				= Выборка.РазностьДат;
			Найдено 					= Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Найдено Тогда
		Если НЕ ОбменПоСЭДОНапрямую И ДатаПоследнегоСеансаОбмена < МинимальнаяДата Тогда
			ДатаПоследнегоСеансаОбмена = МинимальнаяДата;
			РазностьДат = (НачалоДня(ТекущаяДата) - НачалоДня(МинимальнаяДата)) / (24 * 60 * 60);
		КонецЕсли;
		Если НачалоДня(ДатаПоследнегоСеансаОбмена) < НачалоДня(ТекущаяДата) Тогда
			СтрокаДат = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре();
			МассивДат.Добавить(СтрокаДат);
		КонецЕсли;
		
	Иначе
		// Если не нашли данных о получении сообщений, то получаем данные за последние сутки.
		СекундВСутках = 24 * 60 * 60;
		ДатаПоследнегоСеансаОбмена 	= ТекущаяДата - СекундВСутках;
		Если НачалоДня(ДатаПоследнегоСеансаОбмена) < НачалоДня(ТекущаяДата) Тогда
			РазностьДат = 1;
		КонецЕсли;
		СтрокаДат = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре();
		МассивДат.Добавить(СтрокаДат);
	КонецЕсли;
	
	Если НачалоДня(ДатаПоследнегоСеансаОбмена) = НачалоДня(ТекущаяДата) Тогда
		НоваяСтрока				= ДатыПолученияСообщений.Добавить();
		НоваяСтрока.Дата		= ДатаПоследнегоСеансаОбмена;
		НоваяСтрока.ВремяНачала	= ДатаПоследнегоСеансаОбмена;
		НоваяСтрока.ВремяКонца	= ТекущаяДата;
	Иначе
		Для К = 0 По РазностьДат Цикл
			НоваяСтрока					= ДатыПолученияСообщений.Добавить();
			НоваяСтрока.Дата			= ДатаПоследнегоСеансаОбмена;
			НоваяСтрока.ВремяНачала		= ?(К = 0, ДатаПоследнегоСеансаОбмена, НачалоДня(ТекущаяДата));
			НоваяСтрока.ВремяКонца		= ?(К = РазностьДат, ТекущаяДата, КонецДня(ДатаПоследнегоСеансаОбмена));
			ДатаПоследнегоСеансаОбмена	= ДатаПоследнегоСеансаОбмена + (24 * 60 * 60);
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Стр из ДатыПолученияСообщений Цикл
		СтрокаДат = ЭлектронныйДокументооборотСФССКлиентСервер.ПолучитьСтрокуДатВСтруктуре(
			Стр.Дата, Стр.ВремяНачала, Стр.ВремяКонца);
		МассивДат.Добавить(СтрокаДат);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("МассивДат", 			МассивДат);
	Результат.Вставить("ОбменЧерезОператора", 	ОбменЧерезОператора);
	Результат.Вставить("Найдено", 				Найдено);
	
	Возврат Результат;
	
КонецФункции

// В параметр ТекущаяДата необходимо передавать вермя преобразованное к МСК
Процедура СохранитьДатуСеансаОбменаСЭДОФСС(
		Организация,
		ТекущаяДата,
		ОбменПоСЭДОНапрямую = Истина) Экспорт
	
	Если ЗначениеЗаполнено(ТекущаяДата) Тогда
			
		ТекущаяДатаСЭДО = ТекущаяДата;
		Если НЕ ТекущаяДатаСЭДО = НачалоДня(ТекущаяДатаСЭДО)
			И НЕ ТекущаяДатаСЭДО = КонецДня(ТекущаяДатаСЭДО) Тогда
			// Сообщения могут помещаться в базу данных сервера СЭДО с задержкой.
			ВременнойЛаг = 5 * 60;
			ТекущаяДатаСЭДО = ТекущаяДатаСЭДО - ВременнойЛаг;
		КонецЕсли;
		
		ИспользоватьТестовыйСервер = ИспользоватьТестовыйСерверСЭДОФСС(Организация);
		Настройки = СерверОбменаСообщениямиСЭДОФСС(ИспользоватьТестовыйСервер, ОбменПоСЭДОНапрямую);
		Адреса = РазобратьОпределениеСервисаСЭДО(Настройки.Определение);
		
		ИдентификаторЗапроса 		= Новый УникальныйИдентификатор;
		Запись						= РегистрыСведений.ЖурналЗапросовКСерверамФСС.СоздатьМенеджерЗаписи();
		Запись.АдресРесурса 		= Адреса.АдресРесурса;
		Запись.АдресСервера 		= Адреса.АдресСервера;
		Запись.Идентификатор		= ИдентификаторЗапроса;
		Запись.Организация			= Организация;
		Запись.Операция				= ЭлектронныйДокументооборотСФССКлиентСервер.ОперацияЗаписиДатыПолученияСпискаСообщенияСЭДО();
		Запись.Дата					= ТекущаяДатаСЭДО;
		Запись.ОбменЧерезОператора	= НЕ ОбменПоСЭДОНапрямую;
		Запись.Записать();
		
		// Сохраняем данные события получения идентификаторов.
		ДанныеСобытия = ЭлектронныйДокументооборотСФСС.НовыеДанныеСобытияСЭДО();
		ДанныеСобытия.Событие 						= Перечисления.СобытияОбменаСЭДО.ПолучениеСпискаСообщений;
		ДанныеСобытия.Организация 					= Организация;
		ДанныеСобытия.ОбменЧерезОператора 			= НЕ ОбменПоСЭДОНапрямую;
		ДанныеСобытия.СохранятьЕслиДатаМаксимальная = Истина;
		ДанныеСобытия.ДатаСобытия 					= ТекущаяДатаСЭДО;
		ДанныеСобытия.ИдентификаторЗапроса 			= ИдентификаторЗапроса;
		ЭлектронныйДокументооборотСФСС.СохранитьДанныеСобытияСЭДО(ДанныеСобытия);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьРезультатПолученияОшибки(
	Организация,
	ИдентификаторСообщения,
	ОшибкаПодтверждения = "")
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Основание КАК Основание,
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ОтветСтрахователяНаТребованиеПроверкиФСС КАК ОтветСтрахователяНаТребованиеПроверкиФСС
	               |ГДЕ
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.ПредоставленныеДокументы.ИдентификаторСообщенияОтвета = &ИдентификаторСообщения
	               |	И НЕ ОтветСтрахователяНаТребованиеПроверкиФСС.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОтветСтрахователяНаТребованиеПроверкиФСС.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ИдентификаторСообщенияОшибки =
			Выборка.Основание.ОшибкиЛогическогоКонтроля.Найти(ИдентификаторСообщения, "ИдентификаторСообщенияОшибки");
		
		Если ИдентификаторСообщенияОшибки = Неопределено Тогда
			
			Попытка
				ДокументТребованияФСС = Выборка.Основание.ПолучитьОбъект();
				
				НоваяСтрока									= ДокументТребованияФСС.ОшибкиЛогическогоКонтроля.Добавить();
				НоваяСтрока.ОтветНаТребованиеФСС			= Выборка.Ссылка;
				НоваяСтрока.ИдентификаторСообщенияОшибки	= ИдентификаторСообщения;
				НоваяСтрока.ДатаИВремяПриемаОтказа			= ТекущаяДатаСеанса();
				НоваяСтрока.СодержимоеОшибки				= ОшибкаПодтверждения;
				
				ДокументТребованияФСС.Записать();
			Исключение
				
				// Сохраняем ошибку сервера в журнал регистрации.
				Шаблон = НСтр("ru = 'Не удалось обработать сообщение %2)';
								|en = 'Cannot process the message: %2)'");
				ТекстДляЖурнала = СтрШаблон(Шаблон, ИдентификаторСообщения);
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО ФСС';
						|en = 'Electronic data interchange with regulatory authorities. Receive SSF EDI data'"),
					УровеньЖурналаРегистрации.Ошибка, , ,
				ТекстДляЖурнала);
				
			КонецПопытки;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьОшибкуЛогическогоКонтроляОтветаНаЗапросДокументов(ДанныеОшибки) Экспорт
	
	Если ДанныеОшибки.ИсходноеСообщениеНайдено Тогда
		СохранитьРезультатПолученияОшибки(
			ДанныеОшибки.Организация,
			ДанныеОшибки.ДанныеИсходногоСообщения.Идентификатор,
			ДанныеОшибки.ОшибкиКонтроля);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДанныеИзИнформационнойБазыЗаявленияНаФормированиеСправкиОРасчетах(ДокументСсылка)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.Организация,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.ДатаЗадолженности,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.ИдентификаторСообщения,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.КодПодчиненностиФСС,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.РегистрационныйНомерФСС,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.РегистрационныйНомерСФР,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательЮЛ_НаимОрг,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательЮЛ_ИНН,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательЮЛ_КПП,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_Имя,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_Фамилия,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_Отчество,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_ИНН,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_ДатаВыдачиДокумента,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_ВидДокумента,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_СерияДокумента,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.СтраховательФЛ_НомерДокумента,
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.Страхователь_ЮридическоеЛицо
	|ИЗ
	|	Документ.ЗаявлениеНаФормированиеСправкиОРасчетах КАК ЗаявлениеНаФормированиеСправкиОРасчетах
	|ГДЕ
	|	ЗаявлениеНаФормированиеСправкиОРасчетах.Ссылка = &ДокументСсылка";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		ВыборкаИнформации = РезультатЗапроса.Выбрать();
		Пока ВыборкаИнформации.Следующий() Цикл
			Результат.Вставить("Организация", ВыборкаИнформации.Организация);
			Результат.Вставить("ДатаЗадолженности", ВыборкаИнформации.ДатаЗадолженности);
			Результат.Вставить("ИдентификаторСообщения", ВыборкаИнформации.ИдентификаторСообщения);
			Результат.Вставить("КодПодчиненностиФСС", ВыборкаИнформации.КодПодчиненностиФСС);
			Результат.Вставить("РегистрационныйНомерФСС", ВыборкаИнформации.РегистрационныйНомерФСС); 
			Результат.Вставить("РегистрационныйНомерСФР", ВыборкаИнформации.РегистрационныйНомерСФР);
			Результат.Вставить("Страхователь_ЮридическоеЛицо", ВыборкаИнформации.Страхователь_ЮридическоеЛицо);
			Если ВыборкаИнформации.Страхователь_ЮридическоеЛицо Тогда
				Результат.Вставить("СтраховательЮЛ_НаимОрг", ВыборкаИнформации.СтраховательЮЛ_НаимОрг);
				Результат.Вставить("СтраховательЮЛ_ИНН", ВыборкаИнформации.СтраховательЮЛ_ИНН);
				Результат.Вставить("СтраховательЮЛ_КПП", ВыборкаИнформации.СтраховательЮЛ_КПП);
			Иначе
				Результат.Вставить("СтраховательФЛ_Имя", ВыборкаИнформации.СтраховательФЛ_Имя);
				Результат.Вставить("СтраховательФЛ_Фамилия", ВыборкаИнформации.СтраховательФЛ_Фамилия);
				Результат.Вставить("СтраховательФЛ_Отчество", ВыборкаИнформации.СтраховательФЛ_Отчество);
				Результат.Вставить("СтраховательФЛ_ИНН", ВыборкаИнформации.СтраховательФЛ_ИНН);
				Результат.Вставить("СтраховательФЛ_ДатаВыдачиДокумента", ВыборкаИнформации.СтраховательФЛ_ДатаВыдачиДокумента);
				Результат.Вставить("СтраховательФЛ_ВидДокумента", ВыборкаИнформации.СтраховательФЛ_ВидДокумента);
				Результат.Вставить("СтраховательФЛ_СерияДокумента", ВыборкаИнформации.СтраховательФЛ_СерияДокумента);
				Результат.Вставить("СтраховательФЛ_НомерДокумента", ВыборкаИнформации.СтраховательФЛ_НомерДокумента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрахователиПодключеныКОбменуССФР(Страхователи)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСС.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
		|ГДЕ
		|	НастройкиОбменаФСС.ИспользоватьОбмен = ИСТИНА
		|	И НастройкиОбменаФСС.Организация В(&Страхователи)
		|	И (НастройкиОбменаФСС.Пользователь ЕСТЬ NULL
		|			ИЛИ НастройкиОбменаФСС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Страхователи", Страхователи);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура РазобратьУведомлениеОтветНаВходящийЗапросНеПоступилВовремя(Организация,
					ДанныеСообщения,
					РезультатОбработки) Экспорт
					
	// <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	// <proactiveExpireNotice xmlns="urn:ru:fss:integration:types:proactive:notifications:v01">
	//	<socialAssistNum>5177466</socialAssistNum>
	//	<missingResponseToRequest>Информируем, что Страхователю по СНИЛС 43383862804
	//		направлен запрос о представлении недостающих сведений и документов (сообщение № 100 СЭДО).
	//		Идентификатор запроса: "bca82991-0ddb-4ddd-97bd-9c64707e3f8d",
	//		дата и время направления запроса: 2024-06-19 16:25:24.622.
	//		В установленный срок ответ от Страхователя в Социальный фонд России не поступил
	//	</missingResponseToRequest>
	//</proactiveExpireNotice>
	
	ТипыСообщенийСЭДО = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	
	ИдентификаторУведомления = ДанныеСообщения.Идентификатор;
	ТекстСообщения = ДанныеСообщения.ТекстСообщения;
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.УстановитьСтроку(ТекстСообщения);
		ДанныеУведомления = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		Событие = СобытиеЖурналаРегистрации();
		ОписаниеОшибки = НСтр("ru = 'При разборе данных уведомления об отсутствии ответа на запрос СФР (СЭДО) возникла ошибка.';
								|en = 'An error occurred when parsing the data of the notification about the lack of a response to the ticket of the Social Security Fund of Russia (EDI).'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибкиДляЖурнала = ОписаниеОшибки + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиДляЖурнала);
		ОшибкаОбработки(РезультатОбработки, ИдентификаторУведомления, ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	Чтение.Закрыть();
	
	ТекстУведомления = ДанныеУведомления.missingResponseToRequest;
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ТекстУведомления, " "".");
	ПустаяДата = Дата(1, 1, 1);
	ДатаЗапроса = ПустаяДата;
	ИдентификаторЗапроса = "";
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Слово = Слова[Индекс];
		Если СтрДлина(Слово) < 10 Тогда
			Продолжить;
		КонецЕсли;
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Слово) Тогда
			ИдентификаторЗапроса = Слово;
			Продолжить;
		КонецЕсли;
		БуферДаты = СтроковыеФункцииКлиентСервер.СтрокаВДату(Слово);
		Если НЕ БуферДаты = ПустаяДата Тогда
			ДатаЗапроса = БуферДаты;
			Время = Слова[Индекс + 1];
			БуферДаты = СтроковыеФункцииКлиентСервер.СтрокаВДату(Слово + " " + Время, ЧастиДаты.ДатаВремя);
			Если НЕ БуферДаты = ПустаяДата Тогда
				ДатаЗапроса = БуферДаты;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИдентификаторЗапроса) И НЕ ДатаЗапроса = ПустаяДата Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Вывод сообщения пользователю, запись в журнал.
	Шаблон = НСтр("ru = 'Получено сообщение уведомления СФР из СЭДО %1 c типом %2 по страхователю ""%3"": %4';
					|en = 'The message of the notification of the Social Security Fund of Russia is received from EDI %1 with the %2 type on the ""%3"" insurant: %4'");
	ТекстСообщенияЖурнал = СтрШаблон(Шаблон,
		ИдентификаторУведомления,
		ТипыСообщенийСЭДО.ТипСообщенияУведомлениеОтветНаВходящийЗапросНеПоступилВовремя,
		Организация,
		ТекстСообщения);
	ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстСообщенияЖурнал);
	// Формируем ошибку обработки для вывода пользователю текста уведомления.
	ТекстСообщенияПользователю = НСтр("ru = 'Получено уведомление СФР: ';
										|en = 'Notification of the Social Security Fund of Russia is received:'") + ТекстУведомления;
	РезультатОбработки.ОшибкаОбработки = Истина;
	РезультатОбработки.ОписаниеОшибки = ТекстСообщенияПользователю;
	
	РезультатОбработки.Обработано = Истина;
	
	Если ПустаяСтрока(ИдентификаторЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаЗапроса = ПустаяДата Тогда
		ДатаЗапроса = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Идентификатор = ИдентификаторЗапроса;
	Запись.Прочитать();
	Если ПустаяСтрока(Запись.Идентификатор) Тогда
		// Идентификатор запроса не был получен, создаем новое сообщение с типом 100.
		ДанныеСообщенияЗапроса = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеДанныеСообщенияСЭДО(Истина);
		ДанныеСообщенияЗапроса.Идентификатор = ИдентификаторЗапроса;
		ТипСообщенияЗапросаСФР = ТипыСообщенийСЭДО.ЗапросНедостающихСведенийДляПроактивнойВыплатыСтраховогоОбеспечения; // Тип 100.
		ДанныеСообщенияЗапроса.Тип = ТипСообщенияЗапросаСФР;
		ДанныеСообщенияЗапроса.Дата = ДатаЗапроса;
		ДанныеСообщенияЗапроса.Новое = Истина;
		ДанныеСообщенияЗапроса.Получатель = ДанныеСообщения.Получатель;
		ДанныеСообщенияЗапроса.Комментарий = НСтр("ru = 'Сообщение создано при разборе уведомления СФР (тип 124)';
													|en = 'The message was created when parsing the notification of the Social Security Fund of Russia (type 124)'");
		НастройкиВызова = Новый Структура;
		НастройкиВызова.Вставить("БезУчетаПользователя", Истина);
		СвойстваОбменаПоСЭДОЧерезОператора =
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(
				Организация, ,
				НастройкиВызова);
		Сообщения = Новый Массив;
		Сообщения.Добавить(ДанныеСообщенияЗапроса);
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
		СохранитьДанныеВходящихСообщенийСЭДОФСС(Организация,
			Сообщения,
			ТипВзаимодействия,
			СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
	КонецЕсли;
	
КонецПроцедуры

Функция НовыеПараметрыОтправитьЗапросСервисуСЭДОФСС()
	
	Результат = Новый Структура;
	Результат.Вставить("ТребуетсяПеренаправление", Ложь);
	Результат.Вставить("АдресДляПеренаправления", "");
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьДокументДоходнойЧастиСЭДО(РеквизитыДокумента)
	
	Результат = Неопределено;
	
	ДокументОбъект = Документы.ВходящийДокументСЭДОФСС.СоздатьДокумент();
	Если НЕ ЗначениеЗаполнено(РеквизитыДокумента.ДатаДокумента) Тогда
		РеквизитыДокумента.ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	ДокументОбъект.Дата = РеквизитыДокумента.ДатаДокумента;
	ДокументОбъект.УстановитьВремя();
	ДокументОбъект.УстановитьНовыйНомер();
	ЗаполнитьЗначенияСвойств(ДокументОбъект, РеквизитыДокумента);
	
	Если РеквизитыДокумента.ЗапрашиваемыеДокументы.Количество() > 0 Тогда
		Для Каждого Документ Из РеквизитыДокумента.ЗапрашиваемыеДокументы Цикл
			НоваяСтрока = ДокументОбъект.ЗапрашиваемыеДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ);
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.Записать();
	Результат = ДокументОбъект;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение реквизита с проверкой на существование свойства.
Функция ЗначениеСвойстваУзлаXDTO(Узел, Имя, ЗначениеПоУмолчанию = "", ПривестиКТИпу = "")
	
	Результат = "";
	Если НЕ ЕстьСвойство(Узел, Имя) Тогда
		Результат = ЗначениеПоУмолчанию;
	Иначе
		Если ПустаяСтрока(ПривестиКТИпу) Тогда
			Результат = Узел[Имя];
		Иначе
			ТипЗначения = Тип(ПривестиКТИпу);
			Результат = XMLЗначение(ТипЗначения, Узел[Имя]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

