Функция ОрганизацияАвтонастройки(ПараметрыФункции, СсылкаНаУчетнуюЗапись, ИНН, КПП) Экспорт
	
	Организация = Справочники.Организации.ПустаяСсылка();
	
	Если ПараметрыФункции.Свойство("Организация") 
		И ЗначениеЗаполнено(ПараметрыФункции.Организация) Тогда
		
		Организация = ПараметрыФункции.Организация;
		
	ИначеЕсли ЗначениеЗаполнено(СсылкаНаУчетнуюЗапись) Тогда
		
		Организация = ОрганизацияУчетнойЗаписи(СсылкаНаУчетнуюЗапись);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Если ЗначениеЗаполнено(ПараметрыФункции.СсылкаНаЗаявление) Тогда
			Организация = ПараметрыФункции.СсылкаНаЗаявление.Организация;
		Иначе
			Организация = ОпределитьОрганизациюПоИННиКПП(ИНН, КПП);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

Процедура ЗаполнитьПользователяПоРегФайлу(ДанныеПользователя, ЭтоМультиРежим, АдресПользователиМультирежима) Экспорт
	
	ЭтоВосстановлениеМультирежимнойУчетнойЗаписи = 
		ЭтоМультиРежим 
		И АдресПользователиМультирежима <> Неопределено;
	
	Если ЭтоВосстановлениеМультирежимнойУчетнойЗаписи Тогда
			
		Отбор = Новый Структура();
		Отбор.Вставить("ВладелецЭЦПСНИЛС", ДанныеПользователя.ВладелецЭЦПСНИЛС);
		
		ПользователиМультирежима = ПолучитьИзВременногоХранилища(АдресПользователиМультирежима);
		
		НайденныеСтроки = ПользователиМультирежима.НайтиСтроки(Отбор);
			
		Если НайденныеСтроки.Количество() = 1 Тогда
			ДанныеПользователя.ФизическоеЛицо = НайденныеСтроки[0].ФизическоеЛицо;
		Иначе
			ДанныеПользователя.Игнорировать = Истина;
		КонецЕсли;
		
	Иначе
		ДанныеПользователя.ФизическоеЛицо = ОбработкаЗаявленийАбонента.ИсходныйВладелецСертификатаПоФИОиСНИЛС(
			ДанныеПользователя.Организация, 
			ДанныеПользователя.ВладелецЭЦПФамилия,
			ДанныеПользователя.ВладелецЭЦПИмя, 
			ДанныеПользователя.ВладелецЭЦПОтчество, 
			ДанныеПользователя.ВладелецЭЦПСНИЛС).ВладелецЭЦПИсходный;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВРегистрПраваПользователей(
		Организация,
		УчетнаяЗапись,
		УзелДанныеВладельцаЭЦП,
		ДанныеВладельца,
		ПараметрыФункции,
		ЭтоПотенциальныйПользователь,
		ТаблицаСохраненныхРеквизитов = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ Мультирежим.ЭтоМультиРежим(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	ФизическоеЛицо = ДанныеВладельца.ФизическоеЛицо;
	
	Пользователь = Мультирежим.ПользовательПоФизЛицуИзСправочникаПользователи(ФизическоеЛицо);
	Если Пользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборПрав = РегистрыСведений.ПользователиУчетныхЗаписейДокументооборота.СоздатьНаборЗаписей();
	НаборПрав.Отбор.УчетнаяЗапись.Установить(УчетнаяЗапись);
	НаборПрав.Отбор.Пользователь.Установить(Пользователь);
	НаборПрав.Прочитать();
	НаборПрав.Очистить();
	
	НовыеПрава = НаборПрав.Добавить();
	
	НовыеПрава.УчетнаяЗапись = УчетнаяЗапись;
	НовыеПрава.Пользователь = Пользователь;
	
	НовыеПрава.СНИЛС = ДанныеВладельца.ВладелецЭЦПСНИЛС;
	НовыеПрава.ФизическоеЛицо = ФизическоеЛицо;
	
	НовыеПрава.ЭлектроннаяПочта = ДанныеВладельца.ЭлектроннаяПочта;
	
	НовыеПрава.ПолучатьУведомленияОбИзмененииПрав = ЗначениеЗаполнено(НовыеПрава.ЭлектроннаяПочта);
	
	ЗначениеУзлаЭтоАдмин = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ЭтоАдмин");
	НовыеПрава.ЭтоАдмин = (БулевоПоСтроке(ЗначениеУзлаЭтоАдмин) = Истина);
	
	НовыеПрава.ЕстьДоступКоВсемГосОрганам = РегФайлКА.ЕстьДоступКоВсемГосОрганамПоРегФайлу(УзелДанныеВладельцаЭЦП, УчетнаяЗапись);
	
	НовыеПрава.ЭтоПотенциальныйПользователь = ЭтоПотенциальныйПользователь;
	
	НовыеПрава.ЭтоШифровальщик = РегФайлКА.ЭтоШифровальщикИзРегФайла(УзелДанныеВладельцаЭЦП);
	
	ДоступныеОрганы = РегФайлКА.ДоступныеОрганыВладельцаИзРегФайла(УзелДанныеВладельцаЭЦП);
	ЗаполнитьЗначенияСвойств(НовыеПрава, ДоступныеОрганы);
	
	Если ТаблицаСохраненныхРеквизитов <> Неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("УчетнаяЗапись", УчетнаяЗапись);
		Отбор.Вставить("Пользователь", 	Пользователь);
		МассивСтрок = ТаблицаСохраненныхРеквизитов.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			Для каждого КолонкаТаблицы Из ТаблицаСохраненныхРеквизитов.Колонки Цикл
				Если КолонкаТаблицы.Имя <> "УчетнаяЗапись" И КолонкаТаблицы.Имя <> "Пользователь" Тогда
					НовыеПрава[КолонкаТаблицы.Имя] = МассивСтрок[0][КолонкаТаблицы.Имя];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	НаборПрав.Записать();
	
КонецПроцедуры

Функция ШаблонДанныхРегистра(Регистр) Экспорт
	
	Шаблон = Новый Структура;
	
	Для каждого Реквизит Из Регистр.Измерения Цикл
		ДобавитьЗаписьВШаблонДанныхПользователя(Шаблон, Реквизит);
	КонецЦикла;
	
	Для каждого Реквизит Из Регистр.Ресурсы Цикл
		ДобавитьЗаписьВШаблонДанныхПользователя(Шаблон, Реквизит);
	КонецЦикла;
	
	Для каждого Реквизит Из Регистр.Реквизиты Цикл
		ДобавитьЗаписьВШаблонДанныхПользователя(Шаблон, Реквизит);
	КонецЦикла;
	
	Возврат Шаблон;
	
КонецФункции

Функция ШаблонДанныхПользователя() Экспорт
	
	Регистр = Метаданные.РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписи;
	Шаблон  = ШаблонДанныхРегистра(Регистр);
	
	Шаблон.Вставить("Организация",  Справочники.Организации.ПустаяСсылка());
	Шаблон.Вставить("Игнорировать", Ложь);
	
	Возврат Шаблон;
	
КонецФункции

Функция ДобавитьЗаписьВШаблонДанныхПользователя(Шаблон, Реквизит) Экспорт
	
	Значение = Реквизит.Тип.ПривестиЗначение(Неопределено);
	Шаблон.Вставить(Реквизит.Имя, Значение);
	
КонецФункции

Функция ДанныеПотенциальногоВладельцаИзРегФайла(УзелДанныеВладельцаЭЦП) Экспорт
	
	ДанныеПользователя = ШаблонДанныхПользователя();

	СНИЛС = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "СНИЛС");

	ФизическоеЛицо = Мультирежим.ФизЛицоПоСНИЛС(СНИЛС);
	
	Если НЕ ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		Возврат ДанныеПользователя;
	КонецЕсли;
	
	ДанныеПользователя.ФизическоеЛицо   = ФизическоеЛицо;
	ДанныеПользователя.ВладелецЭЦПСНИЛС = СНИЛС;
	ДанныеПользователя.ЭлектроннаяПочта = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ЭлектроннаяПочта");
	
	Возврат ДанныеПользователя;
	
КонецФункции

Процедура ЗаполнитьФизЛицоПоРегФайлу(ДанныеПользователя, ЭтоМультиРежим, АдресПользователиМультирежима) Экспорт
	
	ЭтоВосстановлениеМультирежимнойУчетнойЗаписи = 
		ЭтоМультиРежим 
		И АдресПользователиМультирежима <> Неопределено;
	
	Если ЭтоВосстановлениеМультирежимнойУчетнойЗаписи Тогда
			
		Отбор = Новый Структура();
		Отбор.Вставить("ВладелецЭЦПСНИЛС", ДанныеПользователя.ВладелецЭЦПСНИЛС);
		
		ПользователиМультирежима = ПолучитьИзВременногоХранилища(АдресПользователиМультирежима);
		
		НайденныеСтроки = ПользователиМультирежима.НайтиСтроки(Отбор);
			
		Если НайденныеСтроки.Количество() = 1 Тогда
			ДанныеПользователя.ФизическоеЛицо = НайденныеСтроки[0].ФизическоеЛицо;
		Иначе
			ДанныеПользователя.Игнорировать = Истина;
		КонецЕсли;
		
	Иначе
		
		ДанныеПользователя.ФизическоеЛицо = ОбработкаЗаявленийАбонента.ИсходныйВладелецСертификатаПоФИОиСНИЛС(
			ДанныеПользователя.Организация, 
			ДанныеПользователя.ВладелецЭЦПФамилия,
			ДанныеПользователя.ВладелецЭЦПИмя, 
			ДанныеПользователя.ВладелецЭЦПОтчество, 
			ДанныеПользователя.ВладелецЭЦПСНИЛС).ВладелецЭЦПИсходный;
			
		Если НЕ ЗначениеЗаполнено(ДанныеПользователя.ФизическоеЛицо) И ЭтоМультиРежим Тогда
			
			Текст = НСтр("ru = 'Не удалось определить физ. лицо по ФИО (%1 %2 %3), СНИЛС %4 и организации %5.
                          |Что делать? 
                          |1. Проверьте, что в карточке физ. лица корректно заполнены ФИО и СНИЛС.
                          |2. Убедитесь, что физ лицо %1 %2 %3 принято на работу в организации %5 (является сотрудником этой организации).';
                          |en = 'Failed to identify the individual by the full name (%1 %2 %3), SNILS %4 and the %5 company.
                          |What to do? 
                          |1. Check that the individual''s card has the full name and SNILS correctly specified.
                          |2. Make sure that individual %1 %2 %3 has been employed to the %5 company (is an employee of this company).'");
			
			Текст = СтрШаблон(
				Текст, 
				ДанныеПользователя.ВладелецЭЦПФамилия, 
				ДанныеПользователя.ВладелецЭЦПИмя,
				ДанныеПользователя.ВладелецЭЦПОтчество,
				ДанныеПользователя.ВладелецЭЦПСНИЛС,
				Строка(ДанныеПользователя.Организация));
				
			ВызватьИсключение Текст;
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеВладельцаИзРегФайла(
		ФайлDOM, 
		УзелДанныеВладельцаЭЦП, 
		АдресРегФайла, 
		Организация, 
		АдресПользователиМультирежима = Неопределено, 
		ОбщиеРеквизиты = Неопределено) Экспорт
		
	ДанныеПользователя = ШаблонДанныхПользователя();
	
	Если ОбщиеРеквизиты <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПользователя, ОбщиеРеквизиты);
	КонецЕсли;
	
	ЭтоМультиРежим = Мультирежим.ЭтоМультиРежимИзРегФайла(ФайлDOM);
	
	Отпечаток = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП,"Отпечаток");
	ДанныеПользователя.ОтпечатокСертификата = Отпечаток;
	
	// ТипКриптопровайдера
	ИмяКриптопровайдера = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ИмяКриптопровайдера");
	ТипКриптопровайдера = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ТипКриптопровайдера");
	СвойстваКриптопровайдера = КриптографияЭДКОКлиентСервер.СвойстваКриптопровайдера(ИмяКриптопровайдера, ТипКриптопровайдера);
	Если СвойстваКриптопровайдера <> Неопределено Тогда
		ДанныеПользователя.ТипКриптопровайдера = СвойстваКриптопровайдера.ТипКриптопровайдера;
	КонецЕсли;
	
	// Лицензия КриптоПро
	ДанныеПользователя.ЛицензияКриптоПроВключенаВСертификат = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП,"ЛицензияКриптоПроВключенаВСертификат");
	
	// ФИО владельца ЭЦП
	УзелФИО = УзелДанныеВладельцаЭЦП.ПолучитьЭлементыПоИмени("ФИО");
	Если ЗначениеЗаполнено(УзелФИО) Тогда
		АтрибутыУзлаФИО = УзелФИО[0].Атрибуты;
		
		// ВладелецЭЦПФамилия
		ВладелецЭЦПФамилия = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Фамилия");
		Если ВладелецЭЦПФамилия <> Неопределено Тогда
			ДанныеПользователя.ВладелецЭЦПФамилия = ВладелецЭЦПФамилия.Значение;
		КонецЕсли;
		
		// ВладелецЭЦПИмя
		ВладелецЭЦПИмя = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Имя");
		Если ВладелецЭЦПИмя <> Неопределено Тогда
			ДанныеПользователя.ВладелецЭЦПИмя = ВладелецЭЦПИмя.Значение;
		КонецЕсли;
		
		// ВладелецЭЦПОтчество
		ВладелецЭЦПОтчество = АтрибутыУзлаФИО.ПолучитьИменованныйЭлемент("Отчество");
		Если ВладелецЭЦПОтчество <> Неопределено Тогда
			ДанныеПользователя.ВладелецЭЦПОтчество = ВладелецЭЦПОтчество.Значение;
		КонецЕсли;
			
	КонецЕсли;
	
	// ТелефонМобильный, ПолучатьСМСУведомления
	ДанныеПользователя.ТелефонМобильный = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП,"ТелефонМобильный");
	Если ЗначениеЗаполнено(ДанныеПользователя.ТелефонМобильный) Тогда
		ДанныеПользователя.ПолучатьСМСУведомления = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП,"ПолучатьСМСУведомления");
	ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеПользователя.ТелефонМобильный) И НЕ ЭтоМультиРежим Тогда
		ДанныеПользователя.ТелефонМобильный = ПолучитьЗначениеУзлаXML(ФайлDOM,"ТелефонМобильный");
		ДанныеПользователя.ПолучатьСМСУведомления = ЗначениеЗаполнено(ДанныеПользователя.ТелефонМобильный);
	КонецЕсли;
	
	ДанныеПользователя.ЭлектроннаяПочта = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ЭлектроннаяПочта");
	Если НЕ ЗначениеЗаполнено(ДанныеПользователя.ЭлектроннаяПочта) И НЕ ЭтоМультиРежим Тогда
		ДанныеПользователя.ЭлектроннаяПочта = ПолучитьЗначениеУзлаXML(ФайлDOM, "ЭлектроннаяПочта");
	КонецЕсли;
	
	// ВладелецЭЦППодразделение
	ДанныеПользователя.ВладелецЭЦППодразделение = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "Подразделение");
		
	// ВладелецЭЦПДолжность
	ДанныеПользователя.ВладелецЭЦПДолжность = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "Должность");
	
	// ВладелецЭЦПЭтоФизЛицо
	ДанныеПользователя.ВладелецЭЦПЭтоФизЛицо = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ЭтоДоверенноеЛицо");
	
	ДанныеПользователя.Организация = Организация;
	
	// ВладелецЭЦПСНИЛС
	ДанныеПользователя.ВладелецЭЦПСНИЛС = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "СНИЛС");
	
	// ФизическоеЛицо
	ЗаполнитьФизЛицоПоРегФайлу(ДанныеПользователя, ЭтоМультиРежим, АдресПользователиМультирежима);
	Если ДанныеПользователя.Игнорировать Тогда
		Возврат ДанныеПользователя;
	КонецЕсли;
	
	// ВладелецЭЦПИНН
	ДанныеПользователя.ВладелецЭЦПИНН = ПолучитьЗначениеУзлаXML(УзелДанныеВладельцаЭЦП, "ИНН");
	// Обход ошибки КА
	Если НЕ ЗначениеЗаполнено(ДанныеПользователя.ВладелецЭЦПИНН)
		И ЗначениеЗаполнено(ДанныеПользователя.ФизическоеЛицо) Тогда
		ДанныеПользователя.ВладелецЭЦПИНН = ОбработкаЗаявленийАбонента.ИННФизЛица(ДанныеПользователя.ФизическоеЛицо);
	КонецЕсли;
		
	// Адрес, берется из сертификата
	ДвДанныеСертификата = СертификатMYИзФайлаАвтонастройки(
		АдресРегФайла, 
		ДанныеПользователя.ОтпечатокСертификата);
	
	Если ДвДанныеСертификата <> Неопределено Тогда
		ДанныеСертификата = Новый СертификатКриптографии(ДвДанныеСертификата);
		Субъект = ДанныеСертификата.Субъект;
			
		// Этих данных не будет в сертификате физ лиц
		Субъект.Свойство("OID2_5_4_8", ДанныеПользователя.Область);
		Субъект.Свойство("OID2_5_4_7", ДанныеПользователя.Город);
		Субъект.Свойство("OID2_5_4_9", ДанныеПользователя.Улица);
	КонецЕсли;
	
	ПолучитьПаспортныеДанныеВладельцаИзРегФайла(ДанныеПользователя, ФайлDOM, Отпечаток);
	
	Возврат ДанныеПользователя;
	
КонецФункции

Процедура СохранитьРеквизитыПотенциальныхВладельцев(
		ФайлDOM,
		ПараметрыФункции,
		УчетнаяЗапись,
		Организация,
		ТаблицаСохраненныхРеквизитов = Неопределено) Экспорт
	
	ИгнорироватьПотенциальных =
		Мультирежим.ЭтоМультиРежим(УчетнаяЗапись)
		И ПараметрыФункции.АдресПользователиМультирежима <> Неопределено;
	
	// Потенциальные владельцы
	Если Мультирежим.ЭтоМультиРежим(УчетнаяЗапись) И НЕ ИгнорироватьПотенциальных Тогда
		
		УзлыПотенциальныеВладелецыЭЦП = ФайлDOM.ПолучитьЭлементыПоИмени("ПотенциальныйПользователь");
		Для каждого УзелДанныеВладельцаЭЦП Из УзлыПотенциальныеВладелецыЭЦП Цикл
			
			ДанныеВладельца = ДанныеПотенциальногоВладельцаИзРегФайла(УзелДанныеВладельцаЭЦП);
			
			Если НЕ ЗначениеЗаполнено(ДанныеВладельца.ФизическоеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаписатьВРегистрПраваПользователей(
				Организация,
				УчетнаяЗапись,
				УзелДанныеВладельцаЭЦП,
				ДанныеВладельца,
				ПараметрыФункции,
				Истина,
				ТаблицаСохраненныхРеквизитов);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьРеквизитыВладельцев(
		ФайлDOM,
		СсылкаНаУчетнуюЗапись,
		ПараметрыФункции,
		ОбщиеРеквизиты,
		Организация,
		ТаблицаСохраненныхРеквизитов = Неопределено) Экспорт
	
	НаборЗаписейРегистра = РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписи.СоздатьНаборЗаписей();
	НаборЗаписейРегистра.Отбор.УчетнаяЗапись.Установить(СсылкаНаУчетнуюЗапись);
	НаборЗаписейРегистра.Прочитать();
	НаборЗаписейРегистра.Очистить();
	
	// Подключенные владельцы
	УзлыВладелецыЭЦП = ФайлDOM.ПолучитьЭлементыПоИмени("ВладелецЭЦП");
	
	Для каждого УзелДанныеВладельцаЭЦП Из УзлыВладелецыЭЦП Цикл
		
		СохранитьРеквизитыВладельца(
			ФайлDOM,
			УзелДанныеВладельцаЭЦП,
			ПараметрыФункции,
			НаборЗаписейРегистра,
			Организация,
			ОбщиеРеквизиты,
			ТаблицаСохраненныхРеквизитов);
		
	КонецЦикла;
	
	// Запись регистров и учетной записи
	НаборЗаписейРегистра.Записать();
	
КонецПроцедуры

Процедура СохранитьРеквизитыВладельца(
		ФайлDOM,
		УзелДанныеВладельцаЭЦП,
		ПараметрыФункции,
		НаборЗаписейРегистра,
		Организация,
		ОбщиеРеквизиты,
		ТаблицаСохраненныхРеквизитов = Неопределено) Экспорт
	
	ДанныеВладельца = ДанныеВладельцаИзРегФайла(
		ФайлDOM,
		УзелДанныеВладельцаЭЦП,
		ПараметрыФункции.ВременныйФайлОбновленийАдрес,
		Организация,
		ПараметрыФункции.АдресПользователиМультирежима,
		ОбщиеРеквизиты);
		
	Если НЕ ДанныеВладельца.Игнорировать Тогда
		
		НоваяЗаписьРегистра = НаборЗаписейРегистра.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗаписьРегистра, ДанныеВладельца);
		
		УчетнаяЗапись = ПараметрыФункции.УчетнаяЗаписьОрганизации;
		
		ЗаписатьВРегистрПраваПользователей(
			Организация,
			УчетнаяЗапись,
			УзелДанныеВладельцаЭЦП,
			НоваяЗаписьРегистра,
			ПараметрыФункции,
			Ложь,
			ТаблицаСохраненныхРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьПаспортныеДанныеВладельцаИзРегФайла(НоваяЗаписьРегистра, ФайлDOM, Отпечаток)
	
	Удостоверения = ФайлDOM.ПолучитьЭлементыПоИмени("УдЛичн");
	Если Удостоверения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Удостоверение Из Удостоверения Цикл
		
		Если ВРег(ПолучитьАтрибутУзлаXML(Удостоверение, "Отпечаток")) <> ВРег(Отпечаток) Тогда
			Продолжить;
		КонецЕсли;
		
		// Вид документа
		НоваяЗаписьРегистра.ВладелецЭЦПВидДокументаКод = ПолучитьАтрибутУзлаXML(Удостоверение, "КодВидДок");
		
		// Серия и номер
		СерНомДокВФайле = ПолучитьАтрибутУзлаXML(Удостоверение, "СерНомДок");
		СерНомДокВФайле = СтрРазделить(СерНомДокВФайле, " ");
		
		Если СерНомДокВФайле.Количество() = 1 Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПСерияДокумента = СерНомДокВФайле[0];
		ИначеЕсли СерНомДокВФайле.Количество() = 2 Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПСерияДокумента = СерНомДокВФайле[0];
			НоваяЗаписьРегистра.ВладелецЭЦПНомерДокумента = СерНомДокВФайле[1];
		ИначеЕсли СерНомДокВФайле.Количество() = 3 Тогда
			НоваяЗаписьРегистра.ВладелецЭЦПСерияДокумента = СерНомДокВФайле[0] + " " + СерНомДокВФайле[1];
			НоваяЗаписьРегистра.ВладелецЭЦПНомерДокумента = СерНомДокВФайле[2];
		КонецЕсли;
		
		// Дата выдачи
		ДатаДокВФайле = ПолучитьАтрибутУзлаXML(Удостоверение, "ДатаДок");
		НоваяЗаписьРегистра.ВладелецЭЦПДатаВыдачиДокумента = ДатаВремяИзСтроки(ДатаДокВФайле);
		
		// Кем выдан
		НоваяЗаписьРегистра.ВладелецЭЦПКемВыданДокумент = ПолучитьАтрибутУзлаXML(Удостоверение, "ВыдДок");
		
		// Код подразделения
		НоваяЗаписьРегистра.ВладелецЭЦПКодПодразделения = ПолучитьАтрибутУзлаXML(Удостоверение, "КодВыдДок");
	
	КонецЦикла; 
	
КонецПроцедуры

Функция ОрганизацияПоУчеткиеИИНН(УчетнаяЗапись, ИНН) Экспорт
	
	Организации = ОрганизацииУчетнойЗаписи(УчетнаяЗапись);
	Для каждого Организация Из Организации Цикл
		Если Организация.ИНН = ИНН
			И НЕ Организация.ПометкаУдаления Тогда
			
			Возврат Организация;
		
		КонецЕсли;
	
	КонецЦикла;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

Функция ОбщиеРеквизитыУчетнойЗаписи(ФайлDOM, СсылкаНаУчетнуюЗапись, ДатаОбновления) Экспорт
	
	ДанныеОрганизации = ШаблонДанныхПользователя();
	
	ДанныеОрганизации.УчетнаяЗапись  = СсылкаНаУчетнуюЗапись;
	ДанныеОрганизации.ДатаОбновления = ДатаОбновления;
		
	// НомерОсновнойПоставки1с
	ДанныеОрганизации.НомерОсновнойПоставки1с = ПолучитьЗначениеУзлаXML(ФайлDOM,"НомерОсновнойПоставки1с");
	
	// КраткоеНаименование
	ДанныеОрганизации.КраткоеНаименование = ПолучитьЗначениеУзлаXML(ФайлDOM,"КраткоеНаименование");
	
	// ПолноеНаименование
	ДанныеОрганизации.ПолноеНаименование = ПолучитьЗначениеУзлаXML(ФайлDOM,"ПолноеНаименование");
	
	// ИНН
	ДанныеОрганизации.ИНН = ПолучитьЗначениеУзлаXML(ФайлDOM,"ИНН");
	
	// КПП
	МассивИсключенийИменРодительскихУзлов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Оператор");
	ДанныеОрганизации.КПП = ПолучитьЗначениеУзлаXML(
		ФайлDOM,
		"КПП",,
		МассивИсключенийИменРодительскихУзлов,
		Истина,,
		Истина);
	
	// ОГРН
	ДанныеОрганизации.ОГРН = ПолучитьЗначениеУзлаXML(ФайлDOM,"ОГРН");
	
	Направления  = РегФайлКА.НаправленияУчетнойЗаписи(ФайлDOM);
	ПодключенПФР = Направления.Найти(Перечисления.ТипыКонтролирующихОрганов.ПФР) <> Неопределено;
	
	Если ПодключенПФР Тогда 
		
		// РегНомерПФР
		ДанныеОрганизации.РегНомерПФР = ПолучитьРегНомерИзРегФайла(ФайлDOM,"РегНомерПФР");
		
		// РегНомерСФР
		ДанныеОрганизации.РегНомерСФР = ПолучитьРегНомерИзРегФайла(ФайлDOM,"РегНомерСФР");
		
	Иначе
		ДанныеОрганизации.РегНомерПФР = "";
		ДанныеОрганизации.РегНомерСФР = "";
	КонецЕсли;
	
	// ЭтоНотариусАдвокатИлиГКФХ
	ДанныеОрганизации.ЭтоНотариусАдвокатИлиГКФХ = ПолучитьЗначениеУзлаXML(ФайлDOM,"ПризнакФизическогоЛица");
	
	// ТелефонОсновной
	ДанныеОрганизации.ТелефонОсновной = ПолучитьЗначениеУзлаXML(ФайлDOM,"ТелефонОсновной");
	
	// ТелефонДополнительный
	ДанныеОрганизации.ТелефонДополнительный = ПолучитьЗначениеУзлаXML(ФайлDOM,"ТелефонДополнительный");
	
	// ЭлектроннаяПочтаОрганизации
	ДанныеОрганизации.ЭлектроннаяПочтаОрганизации = ПолучитьЗначениеУзлаXML(ФайлDOM,"ЭлектроннаяПочта");
	
	СохранитьКодРегионаФСРАР(ФайлDOM, ДанныеОрганизации);
	
	Возврат ДанныеОрганизации;
	
КонецФункции

Функция ПолучитьРегНомерИзРегФайла(
		ДокументDOM,
		НазваниеУзла) Экспорт
	
	УзелDOM = ДокументDOM.ПолучитьЭлементыПоИмени(НазваниеУзла);
	
	Для Каждого ЭлементDOM Из УзелDOM Цикл
		
		Если ЭлементDOM.РодительскийУзел <> Неопределено 
			И ЭлементDOM.РодительскийУзел.ИмяУзла = "Оператор" Тогда
			Продолжить;
		Иначе
			Возврат НРег(ЭлементDOM.ТекстовоеСодержимое);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура СохранитьКодРегионаФСРАР(ФайлDOM, НоваяЗаписьРегистра)
	
	Получатели = ФайлDOM.ПолучитьЭлементыПоИмени("Получатель");
	Для Каждого Получатель из Получатели Цикл
		
		Тип = ПолучитьЗначениеУзлаXML(Получатель,"ТипПолучателя");
		Код = ПолучитьЗначениеУзлаXML(Получатель,"КодПолучателя");
		
		Если Тип = "ОИВ" Тогда
			НоваяЗаписьРегистра.КодРегионаФСРАР = Код;
			Прервать;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьНаправленияУчетнойЗаписи(ФайлDOM, СсылкаНаУчетнуюЗапись, ДатаОбновления)

	// обновляем информацию в регистре ДополнительныеРеквизитыУчетнойЗаписиПолучатели
	//
	НаборЗаписейНаправленийСдачи = РегистрыСведений.ДополнительныеРеквизитыУчетнойЗаписиПолучатели.СоздатьНаборЗаписей();
	НаборЗаписейНаправленийСдачи.Отбор.УчетнаяЗапись.Установить(СсылкаНаУчетнуюЗапись);
	НаборЗаписейНаправленийСдачи.Прочитать();
	НаборЗаписейНаправленийСдачи.Очистить();
	
	// Получатели - файл автонастроки
	Получатели = ФайлDOM.ПолучитьЭлементыПоИмени("Получатель");
	
	ХарактеристикиНаправленийСдачи = Новый ТаблицаЗначений;
	
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("УчетнаяЗапись");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("ТипПолучателя");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("КодПолучателя");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("КПП");
	ХарактеристикиНаправленийСдачи.Колонки.Добавить("ДатаОбновления");
	
	Для Каждого Получатель из Получатели Цикл
		
		Тип = ПолучитьЗначениеУзлаXML(Получатель,"ТипПолучателя");
		Код = ПолучитьЗначениеУзлаXML(Получатель,"КодПолучателя");
		
		Если Тип = "ФНС" Тогда
			ПереченьКПП = Получатель.ПолучитьЭлементыПоИмени("КПП");
			
			Если ПереченьКПП.Количество() = 0 Тогда
				
				ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
				КПППолучателя	= Неопределено;
				КодПолучателя 	= Код;
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
				СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
				СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
				
				Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
				
					НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
					
					НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
					НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
					НоваяСтрока.КПП 			= КПППолучателя;
					НоваяСтрока.КодПолучателя 	= Код;
					НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
					
				КонецЕсли;
				
			Иначе
				
				Для каждого КПП Из ПереченьКПП Цикл
					
					ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
					КПППолучателя	= XMLЗначение(Тип("Строка"), КПП.ТекстовоеСодержимое);
					КодПолучателя 	= Код;
					
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
					СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
					СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
					
					Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
					
						НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
						
						НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
						НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
						НоваяСтрока.КПП 			= КПППолучателя;
						НоваяСтрока.КодПолучателя 	= Код;
						НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли Тип <> "ЭЛН" Тогда
			
			Если Тип = "ПФР" И Получатель.ПолучитьЭлементыПоИмени("СхемаОтправкиМПД").Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Метаданные.Перечисления.ТипыКонтролирующихОрганов.ЗначенияПеречисления.Найти(Тип) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипПолучателя 	= Перечисления.ТипыКонтролирующихОрганов[Тип];
			КПППолучателя	= Неопределено;
			КодПолучателя 	= Код;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ТипПолучателя", 	ТипПолучателя);
			СтруктураПоиска.Вставить("КПП", 			КПППолучателя);
			СтруктураПоиска.Вставить("КодПолучателя", 	КодПолучателя);
			
			Если ХарактеристикиНаправленийСдачи.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда 
			
				НоваяСтрока = ХарактеристикиНаправленийСдачи.Добавить();
				
				НоваяСтрока.УчетнаяЗапись 	= СсылкаНаУчетнуюЗапись; 
				НоваяСтрока.ТипПолучателя 	= ТипПолучателя;
				НоваяСтрока.КПП 			= КПППолучателя;
				НоваяСтрока.КодПолучателя 	= Код;
				НоваяСтрока.ДатаОбновления 	= ДатаОбновления;
				
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;
	
	НаборЗаписейНаправленийСдачи.Загрузить(ХарактеристикиНаправленийСдачи);
	НаборЗаписейНаправленийСдачи.Записать();
			
КонецПроцедуры

Процедура ЗаписатьЛицензиюВУчетнуюЗапись(ФайлDOM, УчетнаяЗапись)
	
	УчетнаяЗаписьОрганизацииОбъект = УчетнаяЗапись.ПолучитьОбъект();
	УчетнаяЗаписьОрганизацииОбъект.Прочитать();
	
	// Лицензия
	УзелЛицензия = ФайлDOM.ПолучитьЭлементыПоИмени("Лицензия");
	Если ЗначениеЗаполнено(УзелЛицензия) Тогда
		АтрибутыУзлаЛицензия = УзелЛицензия[0].Атрибуты;
		
		// ЛицензияНаименование
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияНаименование = АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("Наименование").Значение;
		
		// ЛицензияДатаНачала
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаНачала = XMLЗначение(Тип("Дата"), АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ДатаНачала").Значение);
		
		// ЛицензияДатаОкончания
		УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаОкончания = XMLЗначение(Тип("Дата"), АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ДатаОкончания").Значение);
		
		// ЛицензияДатаБлокировки
		ДатаБлокировки = АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ДатаБлокировки");
		
		Если ДатаБлокировки = Неопределено Тогда
			УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаБлокировки = УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаОкончания;
		Иначе
			УчетнаяЗаписьОрганизацииОбъект.ЛицензияДатаБлокировки = XMLЗначение(Тип("Дата"), ДатаБлокировки.Значение);
		КонецЕсли;
		
		// ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия
		ИТС = АтрибутыУзлаЛицензия.ПолучитьИменованныйЭлемент("ИТС");
		Если ИТС <> Неопределено Тогда
			УчетнаяЗаписьОрганизацииОбъект.ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия = НЕ XMLЗначение(Тип("Булево"), ИТС.Значение);
		КонецЕсли;
	КонецЕсли;
	
	Совпадают = ДокументооборотСКО.РеквизитыСовпадают(
		УчетнаяЗаписьОрганизацииОбъект, 
		УчетнаяЗапись, 
		"ЛицензияНаименование, ЛицензияДатаНачала, ЛицензияДатаОкончания, ЛицензияДатаБлокировки, ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия");
		
	Если НЕ Совпадают Тогда
		УчетнаяЗаписьОрганизацииОбъект.Записать();
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ЗаявленияНаЭДОВПФР

Процедура УстановитьВидимостьМенюПФР(Форма) Экспорт
	
	Отправляются = ДокументооборотСКОВызовСервера.ЗаявленияПоЭДООтправляютсяВПФР();
	Форма.Элементы.ЗаявленияВПФР.Видимость = Отправляются;
	
КонецПроцедуры

Процедура ОбновитьСостояниеЭДОсПФРПриЗаписиТранспортногоСообщения(Предмет,
		ОбновляемоеТранспортноеСообщение = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ОбновляемоеТранспортноеСообщение) Тогда
		Отказ = Ложь;
		ПриЗаписиТранспортногоСообщения(ОбновляемоеТранспортноеСообщение, Отказ);
	КонецЕсли;
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР") Тогда
		Отказ = Ложь;
		ПриЗаписиЗаявленияПоЭлДокументооборотуСПФР(Предмет, Отказ);
	КонецЕсли;
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.УведомлениеОПредоставленииПолномочийПредставителю") Тогда
		Отказ = Ложь;
		ПриЗаписиУведомленияОПредоставленииПолномочийПредставителю(Предмет, Отказ);
	КонецЕсли;
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.УведомлениеОПрекращенииПолномочийПредставителя") Тогда
		Отказ = Ложь;
		ПриЗаписиУведомленияОПрекращенииПолномочийПредставителя(Предмет, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ДоступнаОтправкаЗаявленияВПФР(Форма) Экспорт

	Заявление = Форма.ТекущееЗаявлениеПо1СОтчетности;
	Одобрено  = Заявление.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено;
	ЗаявленияОтправляются = ДокументооборотСКОВызовСервера.ЗаявленияПоЭДООтправляютсяВПФР();
	НужноеСостояние = 
		Заявление.НастройкаЗавершена И Форма.ЭтоПредупреждениеИзПанели 
		ИЛИ НЕ Форма.ЭтоПредупреждениеИзПанели;
	
	Возврат 
		Одобрено 
		И НужноеСостояние
		И Форма.СостояниеЭДОсПФР <> Неопределено
		И ЗаявленияОтправляются;

КонецФункции

Функция НужноОтправитьЗаявлениеВПФРИзМастера(Форма, Вид) Экспорт
	
	Заявление                = Форма.ТекущееЗаявлениеПо1СОтчетности;
	ЭтоПервичноеЗаявление    = Заявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное;
	ЭтоВторичноеЗаявление    = НЕ ЭтоПервичноеЗаявление;
	ДоступнаОтправка         = ДоступнаОтправкаЗаявленияВПФР(Форма);
	НужноОтправить           = Ложь;
	
	Если ДоступнаОтправка Тогда
		
		НаправлениеПодключено = Форма.СостояниеЭДОсПФР.НаправлениеПодключено;
		
		Если Вид = Форма.НаПодключение Тогда
			
			// Не рассматриваем случай, когда это заявление на переиздание сертификата и при этом ПФР было подключено ранее,
			// но заявление в отправлено ПФР не было.
			// Причина - потому что в тексте в панели указано, что в этом заявлении должно быть подключение ПФР
			СдаватьВПФР   = ЭтоПервичноеЗаявление И ВПервичномЗаявленииПодключилиПФР(Заявление);
			ПодключилиПФР = ЭтоВторичноеЗаявление И ЭтоИзменениеСдаватьВПФР(Заявление);

			НужноОтправить = 
				Форма.СостояниеЭДОсПФР.НаПодключение.НужноОтправитьЗаявление 
				И НаправлениеПодключено
				И (СдаватьВПФР ИЛИ ПодключилиПФР);
				
		ИначеЕсли Вид = Форма.НаОтключение Тогда
				
			НеПодключенВПФР = ЭтоПервичноеЗаявление И НЕ ВПервичномЗаявленииПодключилиПФР(Заявление);
			ОтключилиПФР    = ЭтоВторичноеЗаявление И ЭтоИзменениеСдаватьВПФР(Заявление);

			// Здесь не проверяем признак Состояние.НаправлениеПодключено 
			// потому что когда открывается форма настроки заявления этот признак все еще равен НаправлениеПодключено = Истина
			НужноОтправить = 
				Форма.СостояниеЭДОсПФР.НаОтключение.НужноОтправитьЗаявление 
				И Форма.СостояниеЭДОсПФР.НаПодключение.ОрганизацияПодключена
				И (НеПодключенВПФР ИЛИ ОтключилиПФР);
			
		ИначеЕсли Вид = Форма.НаСертификат Тогда
			
			// ПФР сейчас не принимает этот вид заявления
			НужноОтправить = Ложь;
	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НужноОтправить;

КонецФункции

Функция ВПервичномЗаявленииПодключилиПФР(Заявление) Экспорт
	
	СдаватьВПФР = Ложь;
	Для Каждого СтрокаНаправления из Заявление.Получатели цикл 
		Если СтрокаНаправления.ТипПолучателя = ПредопределенноеЗначение("Перечисление.ТипыКонтролирующихОрганов.ПФР") Тогда
			СдаватьВПФР = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СдаватьВПФР;
	
КонецФункции

Функция ЭтоПереизданиеСертификата(Заявление) Экспорт
	
	ИзменившиесяРеквизиты = Заявление.ИзменившиесяРеквизитыВторичногоЗаявления;
	
	ПереизданСертификат = ЭтотПараметрИзменился(
		ИзменившиесяРеквизиты, 
		Перечисления.ПараметрыПодключенияК1СОтчетности.ПереизданиеСертификата);
		
	Возврат ПереизданСертификат;

КонецФункции

Функция ЭтоИзменениеСдаватьВПФР(Заявление)
	
	ИзменившиесяРеквизиты = Заявление.ИзменившиесяРеквизитыВторичногоЗаявления;
	
	СдаватьВПФРИзменился = ЭтотПараметрИзменился(
		ИзменившиесяРеквизиты, 
		Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВПФР);
		
	Возврат СдаватьВПФРИзменился;
			
КонецФункции

Процедура Мастер_ПриСозданииНаСервере(Форма, Заявление) Экспорт
	
	Форма.ТекущееЗаявлениеПо1СОтчетности = Заявление;
	Форма.ЭтоПредупреждениеИзМастера 	 = Истина;
	Форма.ЭтоПредупреждениеИзПанели 	 = Истина;
	
	ИнициализироватьВидыЗаявленийНаЭДОВПФР(Форма);
	
	Если Заявление.Статус = Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено
		И Заявление.НастройкаЗавершена Тогда
		Форма.СостояниеЭДОсПФР = СостояниеЭДОсПФР(Заявление.Организация);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьОформлениеПанелиПФРВМастере(Форма) Экспорт
	
	Заявление = Форма.ТекущееЗаявлениеПо1СОтчетности;
	Элементы  = Форма.Элементы;
	
	Элементы.ПодсказкаПФР.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Заявление) И ЗначениеЗаполнено(Заявление.Организация) Тогда
	
		Форма.СостояниеЭДОсПФР   = СостояниеЭДОсПФР(Заявление.Организация);
		Одобрено                 = Заявление.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено");
		НастройкаЗавершена       = Заявление.НастройкаЗавершена;
		Отправляются             = ДокументооборотСКОВызовСервера.ЗаявленияПоЭДООтправляютсяВПФР();
		НужноОтправитьЗаявлениеНаПодключение = НужноОтправитьЗаявлениеВПФРИзМастера(Форма, Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение);
		
		Элементы.ПанельПФР.Видимость = 
			Отправляются И Одобрено И НастройкаЗавершена И
			НужноОтправитьЗаявлениеНаПодключение;
		
		Если НужноОтправитьЗаявлениеНаПодключение Тогда
			
			Текст1 = НСтр("ru = 'Вы отправили оператору заявление на подключение направления СФР (бывш. ПФР и ФСС). Для обмена электронными документами с СФР Вам также необходимо ';
							|en = 'You have sent the application to enable the Social Insurance Fund as a recipient to the EDI provider. To use EDI with the Social Insurance Fund of Russia:'");
			Текст2 = Новый ФорматированнаяСтрока(НСтр("ru = 'отправить';
														|en = 'send'"),,,,"Отправьте");
			Текст3 = НСтр("ru = ' в СФР специальное заявление.';
							|en = ' special application to the Social Insurance Fund of Russia.'");
			
		КонецЕсли;
		
		Если НужноОтправитьЗаявлениеНаПодключение Тогда
			Элементы.ПодсказкаПФР.Заголовок = Новый ФорматированнаяСтрока(Текст1, Текст2, Текст3);
			Элементы.ПодсказкаПФР.Видимость = Истина;
		КонецЕсли;
		
	Иначе
		Элементы.ПанельПФР.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДействияПередОтправкойЗаявленияВПФР(Форма) Экспорт
	
	СохранитьНастройкиСостоянияЭДОСПФР(Форма);
	СоздатьЗаявленияВПФРЕслиНеСозданы(Форма);
	ОпределитьОтправляемоеЗаявлениеВПФР(Форма);

КонецПроцедуры

Функция ЗаявлениеПо1СОтчетностиДляЦелейПФР(Организация = Неопределено, Отпечаток = Неопределено) Экспорт
	
	// Получает список заявлений на подключение с направлением ПФР 
	// или на изменением с переизданием сертификата и направленинем ПФР или с подключением направления ПФР
	// Если передан отпечаток, то ищутся заявления по этому отпечатку, иначе - по организации.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВторичныеЗаявления.Ссылка КАК Ссылка,
		|	ВторичныеЗаявления.Ссылка.Дата КАК ДатаСоздания
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи.ИзменившиесяРеквизитыВторичногоЗаявления КАК ВторичныеЗаявления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявлениеАбонентаСпецоператораСвязи.Получатели КАК ВторичныеПолучатели
		|		ПО ВторичныеЗаявления.Ссылка = ВторичныеПолучатели.Ссылка
		|ГДЕ
		|	ВторичныеЗаявления.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И (ВторичныеЗаявления.ИзмененныйРеквизит = &СдаватьВПФР
		|				И &Отпечаток = НЕОПРЕДЕЛЕНО
		|			ИЛИ ВторичныеЗаявления.ИзмененныйРеквизит = &ПереизданиеСертификата
		|				И &Отпечаток <> НЕОПРЕДЕЛЕНО
		|				И ВторичныеЗаявления.Ссылка.СпособПолученияСертификата = &Новый)
		|	И ВторичныеПолучатели.ТипПолучателя = &ТипПолучателя
		|	И ВторичныеЗаявления.Ссылка.Статус = &Одобрено
		|	И ВторичныеЗаявления.Ссылка.НастройкаЗавершена = ИСТИНА
		|	И (ВторичныеЗаявления.Ссылка.Организация = &Организация
		|				И &Отпечаток = НЕОПРЕДЕЛЕНО
		|			ИЛИ ВторичныеЗаявления.Ссылка.ОтпечатокПолученногоСертификата = &Отпечаток
		|				И &Отпечаток <> НЕОПРЕДЕЛЕНО)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПервичныеЗаявления.Ссылка,
		|	ПервичныеЗаявления.Ссылка.Дата
		|ИЗ
		|	Документ.ЗаявлениеАбонентаСпецоператораСвязи КАК ПервичныеЗаявления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявлениеАбонентаСпецоператораСвязи.Получатели КАК ПервичныеПолучатели
		|		ПО (ПервичныеПолучатели.Ссылка = ПервичныеПолучатели.Ссылка)
		|ГДЕ
		|	ПервичныеЗаявления.ПометкаУдаления = ЛОЖЬ
		|	И ПервичныеЗаявления.ТипЗаявления = &Первичное
		|	И ПервичныеПолучатели.ТипПолучателя = &ТипПолучателя
		|	И ПервичныеЗаявления.Статус = &Одобрено
		|	И ПервичныеЗаявления.НастройкаЗавершена = ИСТИНА
		|	И (ПервичныеЗаявления.Ссылка.Организация = &Организация
		|				И &Отпечаток = НЕОПРЕДЕЛЕНО
		|			ИЛИ ПервичныеЗаявления.Ссылка.ОтпечатокПолученногоСертификата = &Отпечаток
		|				И &Отпечаток <> НЕОПРЕДЕЛЕНО)
		|	И ПервичныеЗаявления.СпособПолученияСертификата = &Новый
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("Первичное", Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное);
	Запрос.УстановитьПараметр("СдаватьВПФР", Перечисления.ПараметрыПодключенияК1СОтчетности.СдаватьВПФР);
	Запрос.УстановитьПараметр("ПереизданиеСертификата", Перечисления.ПараметрыПодключенияК1СОтчетности.ПереизданиеСертификата);
	Запрос.УстановитьПараметр("ТипПолучателя", Перечисления.ТипыКонтролирующихОрганов.ПФР);
	Запрос.УстановитьПараметр("Одобрено", Перечисления.СтатусыЗаявленияАбонентаСпецоператораСвязи.Одобрено);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Новый", Перечисления.СпособПолученияСертификата.ИздатьНовый);
	Запрос.УстановитьПараметр("Отпечаток", Отпечаток);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЗаявленияВПФРДанногоВида(Организация, Вид, СостояниеСдачиОтчетности, Отпечаток = "") Экспорт
	
	// Здесь получаем именно отправленные, но не завершенные
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЦиклОбмена.Ссылка КАК Ссылка,
	               |	ЦиклОбмена.Предмет КАК Предмет,
	               |	ЦиклОбмена.ДатаСоздания КАК ДатаСоздания
	               |ПОМЕСТИТЬ ЦиклыОбмена
	               |ИЗ
	               |	Справочник.ЦиклыОбмена КАК ЦиклОбмена
	               |ГДЕ
	               |	ЦиклОбмена.ПометкаУдаления = ЛОЖЬ
	               |	И ЦиклОбмена.ВидОтчета = ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.ЗаявленияПоЭлДокументооборотуСПФР)
	               |	И ЦиклОбмена.Организация = &Организация
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ЦиклОбмена.Ссылка,
	               |	ЦиклОбмена.Предмет,
	               |	ЦиклОбмена.ДатаСоздания
	               |ИЗ
	               |	Справочник.ЦиклыОбмена КАК ЦиклОбмена
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦиклыОбмена.ДополнительныеПредметы КАК ТЧЦиклОбмена
	               |		ПО (ТЧЦиклОбмена.Ссылка = ЦиклОбмена.Ссылка)
	               |ГДЕ
	               |	ЦиклОбмена.ПометкаУдаления = ЛОЖЬ
	               |	И ЦиклОбмена.ВидОтчета = ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.ЗаявленияПоЭлДокументооборотуСПФР)
	               |	И ЦиклОбмена.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ЦиклыОбмена.Ссылка КАК ЦиклОбмена,
	               |	ЗаявленияПоЭлДокументооборотуСПФР.Ссылка КАК Ссылка,
	               |	ТранспортноеСообщение.ДатаТранспорта КАК ДатаТранспорта,
	               |	ТранспортноеСообщение.Статус КАК Статус
	               |ИЗ
	               |	ЦиклыОбмена КАК ЦиклыОбмена
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
	               |		ПО (ТранспортноеСообщение.ЦиклОбмена = ЦиклыОбмена.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы КАК ЖурналОтправокВКонтролирующиеОрганы
	               |		ПО (ЖурналОтправокВКонтролирующиеОрганы.Ссылка = ЦиклыОбмена.Предмет)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявленияПоЭлДокументооборотуСПФР КАК ЗаявленияПоЭлДокументооборотуСПФР
	               |		ПО ЦиклыОбмена.Предмет = ЗаявленияПоЭлДокументооборотуСПФР.Ссылка
	               |ГДЕ
	               |	ТранспортноеСообщение.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР)
	               |	И ЗаявленияПоЭлДокументооборотуСПФР.Вид = &Вид
	               |	И (ЗаявленияПоЭлДокументооборотуСПФР.Отпечаток = &Отпечаток
	               |				И ЗаявленияПоЭлДокументооборотуСПФР.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявленийНаЭДОВПФР.НаСертификат)
	               |			ИЛИ ЗаявленияПоЭлДокументооборотуСПФР.Вид <> ЗНАЧЕНИЕ(Перечисление.ВидыЗаявленийНаЭДОВПФР.НаСертификат))
	               |	И ЗаявленияПоЭлДокументооборотуСПФР.ПометкаУдаления = ЛОЖЬ
	               |	И ЖурналОтправокВКонтролирующиеОрганы.СостояниеСдачиОтчетности = &СостояниеСдачиОтчетности
	               |	И ЗаявленияПоЭлДокументооборотуСПФР.Организация = &Организация
	               |	И ТранспортноеСообщение.ДатаТранспорта <> ДАТАВРЕМЯ(1, 1, 1)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТранспортноеСообщение.ДатаТранспорта УБЫВ";
	
	Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Отпечаток", Отпечаток);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СостояниеСдачиОтчетности", СостояниеСдачиОтчетности);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ЕстьСотрудники(Организация)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ЭтоЮрЛицо = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЭтоЮрЛицо(Организация);
	
	Если ЭтоЮрЛицо Тогда 
		Возврат Истина;
	Иначе
		ИПИспользуетТрудНаемныхРаботников = РегламентированнаяОтчетность.ИПИспользуетТрудНаемныхРаботников(Организация);  
		Возврат ИПИспользуетТрудНаемныхРаботников;
	КонецЕсли;
	
КонецФункции

Процедура ДополнитьСостояниеЭДОсПФРПодключением(Состояние, Организация, ЗаявленияОтправляются) Экспорт
	
	// На подключение
	НаПодключение = Новый Структура;
	
	НаПодключение.Вставить("ОрганизацияПодключена", ОрганизацияПодключенаКЭДОсПФР(Организация));
	
	Заявления = ЗаявленияВПФРДанногоВида(
		Организация, 
		Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение, 
		Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат);
		
	Если Заявления.Количество() > 0 Тогда
		НаПодключение.Вставить("ОтправленноеЗаявление", Заявления[0].Ссылка);
		НаПодключение.Вставить("ОтправленноеЗаявление_ДатаОтправки", Заявления[0].ДатаТранспорта);
		НаПодключение.Вставить("ЗаявлениеОтправлено", Истина);
	Иначе
		НаПодключение.Вставить("ОтправленноеЗаявление", Неопределено);
		НаПодключение.Вставить("ОтправленноеЗаявление_ДатаОтправки", Дата(1,1,1));
		НаПодключение.Вставить("ЗаявлениеОтправлено", Ложь);
	КонецЕсли;
	
	ПодключилиНоНеОтправилиЗаявление = 
		Состояние.НаправлениеПодключено 
		И НЕ НаПодключение.ОрганизацияПодключена
		И НЕ НаПодключение.ЗаявлениеОтправлено
		И ЗаявленияОтправляются
		И ЕстьСотрудники(Организация);
	
	Одобренные = ЗаявленияВПФРДанногоВида(
		Организация, 
		Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение, 
		Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота);
		
	НаПодключение.Вставить("ЕстьОдобренное", Одобренные.Количество() > 0);
	НаПодключение.Вставить("НужноОтправитьЗаявление", ПодключилиНоНеОтправилиЗаявление);
	НаПодключение.Вставить("НужноОтправитьПовторноеЗаявление", Ложь);
	
	ЗаявлениеПо1СОтчетности = ЗаявлениеПо1СОтчетностиДляЦелейПФР(Организация);
	НаПодключение.Вставить("ЗаявлениеПо1СОтчетности", ЗаявлениеПо1СОтчетности);
	
	Состояние.Вставить("НаПодключение", НаПодключение);
	
КонецПроцедуры

Процедура ДополнитьСостояниеЭДОсПФРОтключением(Состояние, Организация, ЗаявленияОтправляются) Экспорт
	
	НаОтключение = Новый Структура;
	
	НаОтключение.Вставить("ОрганизацияОтключена", ОрганизацияОтключенаОтЭДКО(Организация));
	
	Заявления = ЗаявленияВПФРДанногоВида(
		Организация, 
		Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение,
		Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат);
	
	Если Заявления.Количество() > 0 Тогда
		НаОтключение.Вставить("ОтправленноеЗаявление", Заявления[0].Ссылка);
		НаОтключение.Вставить("ОтправленноеЗаявление_ДатаОтправки", Заявления[0].ДатаТранспорта);
		НаОтключение.Вставить("ЗаявлениеОтправлено", Истина);
	Иначе
		НаОтключение.Вставить("ОтправленноеЗаявление", Неопределено);
		НаОтключение.Вставить("ОтправленноеЗаявление_ДатаОтправки", Дата(1,1,1));
		НаОтключение.Вставить("ЗаявлениеОтправлено", Ложь);
	КонецЕсли;
	
	// Здесь не проверяем признак Состояние.НаправлениеПодключено 
	// потому что когда открывается форма настроки заявления этот признак все еще равен НаправлениеПодключено = Истина
	ОтключилиНоНеОтправилиЗаявление = 
		Состояние.НаПодключение.ОрганизацияПодключена
		И НЕ НаОтключение.ОрганизацияОтключена
		И НЕ НаОтключение.ЗаявлениеОтправлено
		И ЗаявленияОтправляются
		И ЕстьСотрудники(Организация);
		
	Одобренные = ЗаявленияВПФРДанногоВида(
		Организация, 
		Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение, 
		Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота);
		
	НаОтключение.Вставить("ЕстьОдобренное", Одобренные.Количество() > 0);
		
	НаОтключение.Вставить("НужноОтправитьЗаявление", ОтключилиНоНеОтправилиЗаявление);
	
	Состояние.Вставить("НаОтключение", НаОтключение);
	
КонецПроцедуры

Процедура ДополнитьСостояниеЭДОсПФРСертификатом(Состояние, Организация, ЗаявленияОтправляются) Экспорт
	
	// На сертификат
	НаСертификат = Новый Структура;
	
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	
	НаСертификат.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	НаСертификат.Вставить("Отпечаток", "");
	
	// Заполняется позже на клиенте методом ДвДанныеСертификатаПоОрганизации
	НаСертификат.Вставить("ДвДанныеСертификата", Неопределено);
	
	НаСертификат.Вставить("ПФРУведомленОСмене", Ложь);
	НаСертификат.Вставить("ОтправленноеЗаявление", Неопределено);
	НаСертификат.Вставить("ОтправленноеЗаявление_ДатаОтправки", Дата(1,1,1));
	НаСертификат.Вставить("ЗаявлениеОтправлено", Ложь);
	
	Если ЗначениеЗаполнено(НаСертификат.Отпечаток) Тогда
		
		НаСертификат.Вставить("ПФРУведомленОСмене", СертификатПереданВПФР(НаСертификат.Отпечаток));
		
		Заявления = ЗаявленияВПФРДанногоВида(
			Организация, 
			Перечисления.ВидыЗаявленийНаЭДОВПФР.НаСертификат, 
			Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат, 
			НаСертификат.Отпечаток);
		
		Если Заявления.Количество() > 0 Тогда
			НаСертификат.Вставить("ОтправленноеЗаявление", Заявления[0].Ссылка);
			НаСертификат.Вставить("ОтправленноеЗаявление_ДатаОтправки", Заявления[0].ДатаТранспорта);
			НаСертификат.Вставить("ЗаявлениеОтправлено", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаявлениеПо1СОтчетности = ЗаявлениеПо1СОтчетностиДляЦелейПФР(, НаСертификат.Отпечаток);
	НаСертификат.Вставить("ЗаявлениеПо1СОтчетности", ЗаявлениеПо1СОтчетности);

	НаСертификат.Вставить("НужноОтправитьЗаявление", Ложь);
	
	Одобренные = ЗаявленияВПФРДанногоВида(
			Организация, 
			Перечисления.ВидыЗаявленийНаЭДОВПФР.НаСертификат, 
			Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота, 
			НаСертификат.Отпечаток);
			
	НаСертификат.Вставить("СертификатыОтправляются", Ложь);
	НаСертификат.Вставить("ЕстьОдобренное", Одобренные.Количество() > 0);
	
	Состояние.Вставить("НаСертификат", НаСертификат);
	
КонецПроцедуры

Процедура ДополнитьСостояниеЭДОсПФРНеодобренным(Состояние, Организация) Экспорт
	
	Неодобренное = Новый Структура;
	
	Если ЗначениеЗаполнено(Состояние.НаПодключение.ОтправленноеЗаявление)
		И ЕщеНеОдобреноЗаявлениеНаПодключение(Состояние)
		И Состояние.НаПодключение.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаСертификат.ОтправленноеЗаявление_ДатаОтправки  
		И Состояние.НаПодключение.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаОтключение.ОтправленноеЗаявление_ДатаОтправки Тогда
		
	    Неодобренное.Вставить("Вид", Состояние.НаПодключение.ОтправленноеЗаявление.Вид);
		Неодобренное.Вставить("Заявление", Состояние.НаПодключение.ОтправленноеЗаявление);
		Неодобренное.Вставить("Предупредить", Истина);
		
	ИначеЕсли ЗначениеЗаполнено(Состояние.НаСертификат.ОтправленноеЗаявление)
		И ЕщеНеОдобреноЗаявлениеНаСертификат(Состояние)
		И Состояние.НаСертификат.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаПодключение.ОтправленноеЗаявление_ДатаОтправки  
		И Состояние.НаСертификат.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаОтключение.ОтправленноеЗаявление_ДатаОтправки Тогда
		
		Неодобренное.Вставить("Вид", Состояние.НаСертификат.ОтправленноеЗаявление.Вид);
		Неодобренное.Вставить("Заявление", Состояние.НаСертификат.ОтправленноеЗаявление);
		Неодобренное.Вставить("Предупредить", Истина);
		
	ИначеЕсли ЗначениеЗаполнено(Состояние.НаОтключение.ОтправленноеЗаявление)
		И ЕщеНеОдобреноЗаявлениеНаОтключение(Состояние)
		И Состояние.НаОтключение.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаСертификат.ОтправленноеЗаявление_ДатаОтправки  
		И Состояние.НаОтключение.ОтправленноеЗаявление_ДатаОтправки > Состояние.НаПодключение.ОтправленноеЗаявление_ДатаОтправки Тогда
		
		Неодобренное.Вставить("Вид", Состояние.НаОтключение.ОтправленноеЗаявление.Вид);
		Неодобренное.Вставить("Заявление", Состояние.НаОтключение.ОтправленноеЗаявление);
		Неодобренное.Вставить("Предупредить", Истина);
		
	Иначе
		Неодобренное.Вставить("Вид", Неопределено);
		Неодобренное.Вставить("Заявление", Неопределено);
		Неодобренное.Вставить("Предупредить", Ложь);
	КонецЕсли;
	
	Состояние.Вставить("Неодобренное", Неодобренное);
	
КонецПроцедуры

// Функция - Состояние ЭДОс ПФР
//
// Параметры:
//  Организация	 -  - 
//  СДанными	 - Булево - Истина, если нужно вернуть ДвДанные сертификата (есть обращение к интернету для получения файла автонастройки).
// 
// Возвращаемое значение:
//	Состояние - Структура:
//
//	НаправлениеПодключено
//	ЗаявленияОтправляются
//
//	НаОтключение
//		ЕстьОдобренное
//		ЗаявлениеОтправлено
//		НужноОтправитьЗаявление
//		ОрганизацияОтключена
//		ОтправленноеЗаявление
//
//	НаПодключение
//		ЕстьОдобренное
//		ЗаявлениеОтправлено
//		НужноОтправитьЗаявление
//		ОрганизацияПодключена
//		ОтправленноеЗаявление
//
//	НаСертификат
//		ДвДанныеСертификата
//		ЕстьОдобренное
//		ЗаявлениеОтправлено
//		ЗаявлениеПо1СОтчетности
//		НужноОтправитьЗаявление
//		ОбновитьИзИнтернета
//		Отпечаток
//		ОтправленноеЗаявление
//		ПФРУведомленОСмене
//		УчетнаяЗапись
//
//	Неодобренное - для предупреждения о неодобренном (на подключение или сертификат)
//		Вид
//		Заявление
//		Предупредить
//
Функция СостояниеЭДОсПФР(Организация, Принудительно = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаявленияОтправляются = ДокументооборотСКОВызовСервера.ЗаявленияПоЭДООтправляютсяВПФР();
	
	Состояние = Новый Структура();
	Состояние.Вставить("НаправлениеПодключено", СдаватьВПФР(Организация) ИЛИ Принудительно);
	Состояние.Вставить("ЗаявленияОтправляются", ЗаявленияОтправляются);
	
	ДополнитьСостояниеЭДОсПФРПодключением(Состояние, Организация, ЗаявленияОтправляются);
	ДополнитьСостояниеЭДОсПФРОтключением(Состояние, Организация, ЗаявленияОтправляются);
	ДополнитьСостояниеЭДОсПФРСертификатом(Состояние, Организация, ЗаявленияОтправляются);
	ДополнитьСостояниеЭДОсПФРНеодобренным(Состояние, Организация);
	
	Возврат Состояние;
	
КонецФункции

Функция ЗаявленияПоЭДООтправляютсяВПФР() Экспорт
	
	Возврат ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Отпр.ЗПЭД");
	
КонецФункции

Функция ВыгрузитьЗаявленияПоЭлДокументооборотуСПФР(Заявление) Экспорт
	
	Если Не ЗначениеЗаполнено(Заявление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявление,
		"ИмяФайлаВыгрузки, ЭлектроннаяПодпись");
	ДанныеПодписи = РеквизитыОбъекта.ЭлектроннаяПодпись.Получить();
	Если ЗначениеЗаполнено(РеквизитыОбъекта.ИмяФайлаВыгрузки) И ДанныеПодписи <> Неопределено Тогда
		АдресПодписи = ПоместитьВоВременноеХранилище(ДанныеПодписи, Новый УникальныйИдентификатор);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Документ", Заявление);
		ДополнительныеПараметры.Вставить("Тип", Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС); // см Распоряжение Правления ПФ РФ от 11.10.2007 N 190р (ред. от 19.03.2010)
		ДополнительныеПараметры.Вставить("Имя", РеквизитыОбъекта.ИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Адрес", АдресПодписи);
		
		Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры);
		
		Возврат Результат;
	КонецЕсли;
	
	НаПодключение = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение;
	
	ЭтоЮридическоеЛицо = РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Заявление.Организация);
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЭДПФР");
	
		Если ДействуетФорматАФ245д() Тогда
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьАтрибутыКорня_АФ245д(ЗаписьXML, Заявление);
		Иначе
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьАтрибутыКорня_АФ241д(ЗаписьXML, Заявление);
		КонецЕсли;
		
		Если Заявление.Вид = НаПодключение Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЗПЭД"); // 3.1.3. Заявление на подключение к ЭДО ПФР (ЗПЭД)
		Иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЗОЭД"); // 3.1.4. Заявление на отключение от ЭДО ПФР (ЗОЭД)
		КонецЕсли;
		
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_ГрЮЛилиИП(ЗаписьXML, Заявление, ЭтоЮридическоеЛицо);
			
			Если Заявление.Вид = НаПодключение И НЕ ДействуетФорматАФ245д() ИЛИ ДействуетФорматАФ245д() Тогда
				ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_Оператор(ЗаписьXML, Заявление);
			КонецЕсли;
			ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_Руководитель(ЗаписьXML, Заявление);
			
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ЗПЭД/ЗОЭД
		ЗаявленияПоЭлДокументооборотуСПФР_ЗаписатьУзелXML_СлужебнаяИнформация(ЗаписьXML, Заявление);
			
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ЭДПФР
	
	ЗаписьXML.Закрыть();
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), Новый УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Документ", Заявление);
	ДополнительныеПараметры.Вставить("Тип", Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС); // см Распоряжение Правления ПФ РФ от 11.10.2007 N 190р (ред. от 19.03.2010)
	ДополнительныеПараметры.Вставить("Имя", ЗаявленияПоЭлДокументооборотуСПФР_ИмяФайла(Заявление));
	ДополнительныеПараметры.Вставить("Адрес", АдресФайла);
	
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеУПУПИзИнформационнойБазы(ДокументСсылка) Экспорт
	
	Результат = Новый Структура;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УведомлениеОПредоставленииПолномочийПредставителюКонтактнаяИнформация.Владелец КАК Владелец,
	|	УведомлениеОПредоставленииПолномочийПредставителюКонтактнаяИнформация.АдресЭлПочты КАК АдресЭлПочты,
	|	УведомлениеОПредоставленииПолномочийПредставителюКонтактнаяИнформация.Телефон КАК Телефон
	|ИЗ
	|	Документ.УведомлениеОПредоставленииПолномочийПредставителю.КонтактнаяИнформация КАК УведомлениеОПредоставленииПолномочийПредставителюКонтактнаяИнформация
	|ГДЕ
	|	УведомлениеОПредоставленииПолномочийПредставителюКонтактнаяИнформация.Ссылка = &ДокументСсылка
	|;
	|
