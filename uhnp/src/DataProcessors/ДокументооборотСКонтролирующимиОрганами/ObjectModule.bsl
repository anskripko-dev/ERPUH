Функция XDTOПоДвДанным(ДвДанные) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвДанные.Записать(ИмяВременногоФайла);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ЧтениеXML.ПерейтиКСодержимому();
	
	Фабрика = ФабрикаXDTO;
	Результат = Фабрика.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьНаименованиеНалога(
	Знач КБК, 
	НалогиПоКБК, 
	КолонкаКБК, 
	НаименованиеНалога, 
	НаименованиеПолное = Неопределено, 
	НайденнаяСтрока = Неопределено,
	ИскатьСУчетомПодвидаДохода = Истина) Экспорт
	
	КБК = СокрЛП(КБК);
	
	// Ищем по первым 13 значениям КБК, остальные цифры это подвиды доходов бюджета (штрафы, пени и т.д).
	Если НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = НалогиПоКБК.НайтиТекст(Лев(КБК, 13),, КолонкаКБК,,,,); 
	Иначе
		НачальнаяОбластьПоиска = НайденнаяСтрока;
		НайденнаяСтрока = НалогиПоКБК.НайтиТекст(Лев(КБК, 13), НачальнаяОбластьПоиска, КолонкаКБК,,,,);
	КонецЕсли;
	
	Если НайденнаяСтрока = Неопределено Тогда
		
		НаименованиеНалога = "КБК: " + КБК; // если не найден КБК в макете, выводим КБК
		НаименованиеПолное = "";
		
		Если ЭтоСтраховыеВзносы(КБК) И ИскатьСУчетомПодвидаДохода Тогда
			
			ИскатьСУчетомПодвидаДохода = Ложь;
			
			ПолучитьНаименованиеНалога(
				КБК, 
				НалогиПоКБК, 
				КолонкаКБК, 
				НаименованиеНалога, 
				НаименованиеПолное, 
				НайденнаяСтрока, 
				ИскатьСУчетомПодвидаДохода);
				
		КонецЕсли;
		
	Иначе
		
		Если ЭтоСтраховыеВзносы(КБК) И ИскатьСУчетомПодвидаДохода Тогда
			
			ПодвидДоходов = Сред(КБК, 16, 2);
			НайденноеКБК = СокрЛП(НалогиПоКБК.Область(НайденнаяСтрока.Верх, НалогиПоКБК.Область("КБК").Лево).Текст);
			ПодвидДоходовНайденногоКБК = Сред(НайденноеКБК, 16, 2);
			
			Если ПодвидДоходов <> ПодвидДоходовНайденногоКБК Тогда
				
				// Если подвид дохода не совпал, то рекурсивно начинаем поиск на следующей строке.
				ПолучитьНаименованиеНалога(
					КБК, 
					НалогиПоКБК, 
					КолонкаКБК, 
					НаименованиеНалога, 
					НаименованиеПолное, 
					НайденнаяСтрока, 
					ИскатьСУчетомПодвидаДохода);
					
				Возврат;
				
			КонецЕсли;
		КонецЕсли;
		
		НаименованиеКраткое = СокрЛП(НалогиПоКБК.Область(НайденнаяСтрока.Верх, НалогиПоКБК.Область("КраткоеНаименованиеНалога").Лево).Текст);
		НаименованиеПолное  = СокрЛП(НалогиПоКБК.Область(НайденнаяСтрока.Верх, НалогиПоКБК.Область("Наименование_КБК").Лево).Текст);
		НаименованиеНалога = ?(ЗначениеЗаполнено(НаименованиеКраткое), НаименованиеКраткое, НаименованиеПолное);
		
	КонецЕсли;

КонецПроцедуры

Функция ЭтоСтраховыеВзносы(КБК)
	
	Возврат Прав(КБК, 3) = "160"; // код 160 – страховые взносы на обязательное социальное страхование 
	
