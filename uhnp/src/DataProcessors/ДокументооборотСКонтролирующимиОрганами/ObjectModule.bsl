			Возврат Неопределено;
			
		КонецПопытки;
		
		ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
		Результат.Квитанция = ФайлОтвета.Прочитать();
		ФайлОтвета.Закрыть();
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Функция ЗакодироватьПараметрСсылки(ПараметрСсылки, КодировкаТекста = Неопределено)
	
	Если ЗначениеЗаполнено(КодировкаТекста) Тогда
		Результат = "";
		
		ДвоичныеДанныеСтроки = ПолучитьДвоичныеДанныеИзСтроки(ПараметрСсылки, КодировкаТекста);
		HexСтрокаДанных = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанныеСтроки);
		
		НомерСимвола = 1;
		Пока НомерСимвола <= СтрДлина(HexСтрокаДанных) Цикл
			Результат = Результат + "%" + Сред(HexСтрокаДанных, НомерСимвола, 2);
			НомерСимвола = НомерСимвола + 2;
		КонецЦикла;
		
	Иначе
		СимволыДляЗамены = "%" + Символы.Таб + Символы.ПС + Символы.ПФ + Символы.ВК + " !""#$&'()*+,/:;<=>?@[\]^`{|}~" + Символ(127);
		ПодставляемыеПодстроки = "%25%09%0A%0C%0D%20%21%22%23%24%26%27%28%29%2A%2B%2C%2F%3A%3B%3C%3D%3E%3F%40%5B%5C%5D%5E%60%7B%7C%7D%7E%7F";
		
		Результат = ПараметрСсылки;
		Для НомерСимвола = 1 По СтрДлина(СимволыДляЗамены) Цикл
			СимволДляЗамены = Сред(СимволыДляЗамены, НомерСимвола, 1);
			ПодставляемаяПодстрока = Сред(ПодставляемыеПодстроки, (НомерСимвола - 1) * 3 + 1, 3);
			Результат = СтрЗаменить(Результат, СимволДляЗамены, ПодставляемаяПодстрока);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстВШестнадцатеричныйUnicode(Текст)
	
	Результат = "";
	Для НомерСимвола = 1 По СтрДлина(Текст) Цикл
		ТекущийСимвол = Сред(Текст, НомерСимвола, 1);
		Если КодСимвола(ТекущийСимвол) >= 256 Тогда
			КодТекущегоСимвола = КодСимвола(ТекущийСимвол);
			СтаршийБайтКодаТекущегоСимвола = Число(КодТекущегоСимвола / 256);
			ШестнадцатеричноеПредставлениеТекущегоСимвола =
				ДокументооборотСКОВызовСервера.ЧислоВШестнадцатеричномПредставлении(СтаршийБайтКодаТекущегоСимвола, 1)
				+ ДокументооборотСКОВызовСервера.ЧислоВШестнадцатеричномПредставлении(КодТекущегоСимвола % 256, 1);
			Результат = Результат + "\u" + нрег(ШестнадцатеричноеПредставлениеТекущегоСимвола);
			
		Иначе
			Результат = Результат + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ТекстПослеПрефиксаПодобрать(
		ПолныйТекст,
		Префикс,
		Постфикс,
		ПодстрокаПоиска,
		ВернутьСледующий = Ложь)
	
	Результат = Неопределено;
	ТекстДоКонца = ТекстПослеПрефикса(ПолныйТекст, Префикс);
	
	НомерТекста = 1;
	ТекстСледующий = Неопределено;
	Пока ЗначениеЗаполнено(ТекстДоКонца) Цикл
		ПозицияПостфикса = СтрНайти(ТекстДоКонца, Постфикс);
		Если ПозицияПостфикса > 0 Тогда
			ТекстРезультата = Лев(ТекстДоКонца, ПозицияПостфикса - 1);
		Иначе
			ТекстРезультата = ТекстДоКонца;
		КонецЕсли;
		Если НомерТекста = 1 Тогда
			Результат = ТекстРезультата;
		КонецЕсли;
		
		ТекстСледующий = ТекстПослеПрефикса(ТекстДоКонца, Префикс);
		
		ДлинаТекстаМежду = СтрДлина(ТекстДоКонца) - СтрДлина(ТекстСледующий);
		ТекстМеждуПрефиксами = Лев(ТекстДоКонца, ДлинаТекстаМежду);
		
		Если СтрНайти(ТекстМеждуПрефиксами, ПодстрокаПоиска) > 0 Тогда
			Если ВернутьСледующий Тогда
				ПозицияПостфикса = СтрНайти(ТекстСледующий, Постфикс);
				Если ПозицияПостфикса > 0 Тогда
					ТекстРезультата = Лев(ТекстСледующий, ПозицияПостфикса - 1);
				Иначе
					ТекстРезультата = ТекстСледующий;
				КонецЕсли;
			КонецЕсли;
			Результат = ТекстРезультата;
			Прервать;
		КонецЕсли;
		
		НомерТекста = НомерТекста + 1;
		ТекстДоКонца = ТекстСледующий;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ТаможенноеДекларирование

//
Функция ПолучитьПроцедурыДекларированияФТСССервера(Знач ПараметрыОтправки, ПараметрыСоединения) Экспорт
	
	//запрос результатов обработки
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	ПараметрыСоединения.ПовторятьЗапросПароля = Ложь;
	
	ЗаголовкиОтчетов = ПолучитьИнформациюОПроцедурахДекларированияНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения);
	
	Если ЗаголовкиОтчетов <> Неопределено И НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// получен протокол обработки и отсутствовали ошибки соединения
		
		Результат = ЗаголовкиОтчетов;
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) ИЛИ НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(ПараметрыСоединения.ОписаниеОшибкиСервером);
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Результаты отправки не получены с портала ФТС. %1';
					|en = 'Sending results are not received from the Federal Customs Service. %1'"),
				ПараметрыСоединения.ОписаниеОшибкиСервером);
			
			СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
			
		Иначе
			ТекстСообщения = НСтр("ru = 'Не удалось получить результаты отправки с портала Федеральной таможенной службы.';
									|en = 'Cannot receive sending results from the Federal Customs Service portal.'");
			
			СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
		КонецЕсли;
		
		Результат = Неопределено;
		
	Иначе
		
		// возможно, проблемы с доступом в интернет
		Результат = Неопределено;
		
	КонецЕсли;
	
	ПараметрыСоединения.СоединениеHTTP = Неопределено;
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИнформациюОПроцедурахДекларированияНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения)
	
	УточнениеАдресаСервераИспользуется = Ложь;
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	АвторизацияПроизведена = (ПараметрыСоединения.СоединениеHTTP <> Неопределено);
	
	Если НЕ АвторизацияПроизведена Тогда
		// очистить пароль, если в диалоге сохранения пароля не установлена галочка сохранения
		Если НЕ ПараметрыСоединения.СохранитьПароль И ЗначениеЗаполнено(ПараметрыСоединения.СохраненныйПароль) Тогда
			ЗаписатьЛогинИПарольПорталаФТС(ПараметрыОтправки.Организация,, "");
			ПараметрыСоединения.СохраненныйПароль = "";
		КонецЕсли;
	КонецЕсли;
	
	Для НомерСервера = 1 По ?(УточнениеАдресаСервераИспользуется, 2, 1) Цикл
		АдресСервера = ПараметрыСоединения.ТекущийАдресСервера;
		
		Если НЕ АвторизацияПроизведена Тогда
			
			// устанавливаем соединение с сервером
			ОписаниеОшибкиУстановкиСоединения = "";
			ПараметрыСоединения.СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(
				"https://" + АдресСервера, ОписаниеОшибкиУстановкиСоединения);
			
			Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
				ПараметрыСоединения.ПовторятьСоединение = Истина;
				СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Не удалось установить соединение с сервером:
								   |%1';
								   |en = 'Cannot connect to server:
								   |%1'"), ОписаниеОшибкиУстановкиСоединения), ПараметрыСоединения.СообщенияПользователю);
				Возврат Неопределено;
			КонецЕсли;
			
			ПараметрыСоединения.ЗначениеCookie = "";
			
			Если НомерСервера = 1 И УточнениеАдресаСервераИспользуется Тогда
				ЭтоВызовПередАвторизацией = Истина;
				Если НЕ УточнитьАдресСервераФТС(ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовПередАвторизацией) Тогда
					ПараметрыСоединения.СоединениеHTTP = Неопределено;
					Возврат Неопределено;
				КонецЕсли;
				
				Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
					// сервер сменился, нужно повторно соединиться
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			АвторизацияПроизведена = АвторизоватьсяНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения);
			
		КонецЕсли;
		
		Если АвторизацияПроизведена И УточнениеАдресаСервераИспользуется Тогда
			Если НомерСервера = 1 Тогда
				ЭтоВызовПередАвторизацией = Ложь;
				Если НЕ УточнитьАдресСервераФТС(ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовПередАвторизацией) Тогда
					ПараметрыСоединения.СоединениеHTTP = Неопределено;
					Возврат Неопределено;
				КонецЕсли;
				
				Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
					// сервер сменился, нужно повторно соединиться
					АвторизацияПроизведена = Ложь;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
	Если АвторизацияПроизведена Тогда
		
		ЗаголовокОтчета = ПолучитьПроцедурыДекларированияНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения);
		
		Если ЗаголовокОтчета <> Неопределено Тогда
			
			ПараметрыСоединения.ОписаниеОшибкиСервером = "";
			ПараметрыСоединения.ПовторятьСоединение = Ложь;
			
			Возврат ЗаголовокОтчета;
			
		КонецЕсли;
		
	Иначе
		ПараметрыСоединения.СоединениеHTTP = Неопределено;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПроцедурыДекларированияНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения)
	
	Результат = Новый Массив;
	
	ЭтоВыпущенныеДТ = (ВРег(ПараметрыОтправки.РежимПолучения) = ВРег("ВыпущенныеДТ"));
	
	ОтборыВызова = Новый Структура;
	ОтборыВызова.Вставить("ТипПроцедуры", 			Неопределено);
	ОтборыВызова.Вставить("ДатаРешенияС", 			Неопределено);
	ОтборыВызова.Вставить("ДатаРешенияПо", 			Неопределено);
	ОтборыВызова.Вставить("РегистрационныйНомер", 	Неопределено);
	Если ПараметрыОтправки.Отборы <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ОтборыВызова, ПараметрыОтправки.Отборы);
	КонецЕсли;
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	// посылаем запрос списка
	
	НомерСтраницы = 1;
	ЭлементовНаСтранице = 100;
	ИспользоватьФильтрТипПроцедуры = Ложь;
	
	Пока Истина Цикл
		ИндексНачальногоЭлементаСтрокой = Формат((НомерСтраницы - 1) * ЭлементовНаСтранице, "ЧН=0; ЧГ=");
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=utf-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ПакетДляПолученияСписка = "{""OnlyMy"":0,""Filter"":"""""
		+ ?(ЗначениеЗаполнено(ОтборыВызова.ТипПроцедуры) И ИспользоватьФильтрТипПроцедуры,
		",""" + ?(ЭтоВыпущенныеДТ, "PROC", "ModelName")
		+ "_Filter_1"":""" + ОтборыВызова.ТипПроцедуры + """", "")
		+ ?(ЗначениеЗаполнено(ОтборыВызова.ДатаРешенияС), ",""" + ?(ЭтоВыпущенныеДТ, "GD1", "CreationDateTime")
		+ "_Filter_1"":""" + Формат(ОтборыВызова.ДатаРешенияС, "ДФ=дд.ММ.гггг") + """", "")
		+ ?(ЗначениеЗаполнено(ОтборыВызова.ДатаРешенияПо), ",""" + ?(ЭтоВыпущенныеДТ, "GD1", "CreationDateTime")
		+ "_Filter_1_TO"":""" + Формат(ОтборыВызова.ДатаРешенияПо, "ДФ=дд.ММ.гггг") + """", "")
		+ ?(ЗначениеЗаполнено(ОтборыВызова.РегистрационныйНомер), ",""" + ?(ЭтоВыпущенныеДТ, "ND", "RegNum")
		+ "_Filter_1"":""" + ОтборыВызова.РегистрационныйНомер + """", "")
		+ ",""Limit"":" + Формат(ЭлементовНаСтранице, "ЧГ=0")
		+ "}";
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
		ЗаписываемыйФайл.Записать(ПакетДляПолученияСписка);
		ЗаписываемыйФайл.Закрыть();
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(
			"/FtsDataSetWeb/UniversalDatabase/GetItems",
			"{FTS}/FtsDataSetWeb/UniversalDatabase/GetItems",
			ПараметрыСоединения.СоединениеHTTP)
			+ ?(ЭтоВыпущенныеДТ, "?scopeName=FtsDataSets&listName=DataSetDeclarHeaders&start=", "?scopeName=FtsPortalEd&listName=DeclProcedures&start=")
			+ ИндексНачальногоЭлементаСтрокой + "&format=JSON";
			
			// Создалим объект запроса по файлу
			ЗапросHTTP = Новый HTTPЗапрос();
			ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
			///////////////////////////////////																					
			Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл   
				ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляПолученияСписка, "utf-8");
				ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
				ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP, ИмяФайлаОтвета); 
				// Обработка исключительных ситуаций ФТС
				Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, ЗапросHTTP.АдресРесурса) Тогда
					Продолжить;
				КонецЕсли;  
				Прервать;
			КонецЦикла;  
			////////////////////////////////////////
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПараметрыСоединения.СоединениеHTTP.Сервер + ?(ПараметрыСоединения.СоединениеHTTP.Порт <> 80,
			":" + Формат(ПараметрыСоединения.СоединениеHTTP.Порт, "ЧДЦ=; ЧН=; ЧГ="), "") + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Процедуры декларирования из ФТС';
				|en = 'EDI with regulatory authorities. Certification procedures from FCS'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
			
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			Возврат Неопределено;
		КонецПопытки;
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
		ТекстОтвета = ФайлОтвета.Прочитать();
		ФайлОтвета.Закрыть();
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) = Ложь Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета); 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		СписокПолей = Новый СписокЗначений;
		Если ЭтоВыпущенныеДТ Тогда
			СписокПолей.Добавить("РегистрационныйНомер", 				"ND");
			СписокПолей.Добавить("ДатаСоздания", 						"DTLOAD");
			СписокПолей.Добавить("ТипПроцедуры", 						"PROC");
			СписокПолей.Добавить("ВсегоТоваровМест", 					"AMOUNT");
			СписокПолей.Добавить("ОбщаяСтоимость", 						"COST");
			СписокПолей.Добавить("Статус", 								"GD0");
			СписокПолей.Добавить("ДатаРешения", 						"GD1");
			СписокПолей.Добавить("Отправитель", 						"SENDER");
			СписокПолей.Добавить("Получатель", 							"RECEIVER");
			СписокПолей.Добавить("СтранаОтправления", 					"G15");
			СписокПолей.Добавить("СтранаНазначения", 					"G17B");
			СписокПолей.Добавить("СтранаПроисхождения", 				"G16");
			СписокПолей.Добавить("ОтветственныйЗаФинУрегулирование", 	"FINANCE");
			СписокПолей.Добавить("Идентификатор", 						"Id");
			СписокПолей.Добавить("ПроцедураВЛК", 						"DeclProcId");
			СписокПолей.Добавить("ДатаРегистрации", 					"G072");
			СписокПолей.Добавить("КодРегистрации", 						"G071");
			СписокПолей.Добавить("ПорядковыйНомер", 					"G073");
			СписокПолей.Добавить("Декларант", 							"DECLARANT");
			СписокПолей.Добавить("ИмяОтправителя", 						"G022");
			СписокПолей.Добавить("ИмяПолучателя", 						"G082");
			СписокПолей.Добавить("Модель", 								"ModelName");
			СписокПолей.Добавить("ИмяСтатуса", 							"StateName");
			СписокПолей.Добавить("Версия", 								"SoftVersion");
			
			
		Иначе
			СписокПолей.Добавить("РегистрационныйНомер", 	"RegNum");
			СписокПолей.Добавить("ДатаСоздания", 			"CreationDateTime");
			СписокПолей.Добавить("ТипПроцедуры", 			"ModelName");
			СписокПолей.Добавить("Статус", 					"StateName");
			СписокПолей.Добавить("Примечание", 				"Note");
		КонецЕсли;
		
		МассивИменПолей = Новый Массив;
		МассивИдентификаторовПолей = Новый Массив;
		Для каждого ЭлементСписка Из СписокПолей Цикл
			МассивИменПолей.Добавить(ЭлементСписка.Значение);
			МассивИдентификаторовПолей.Добавить(ЭлементСписка.Представление);
		КонецЦикла;
		ИменаПолей = СтрСоединить(МассивИменПолей, ", ");
		ИдентификаторыПолей = СтрСоединить(МассивИдентификаторовПолей, ", ");
		
		ЗаголовкиОтчетов = ТаблицаJSON(
		ТекстОтвета,
		"""Items"":[",
		ИменаПолей,
		ИдентификаторыПолей,
		"""Total"":",
		Истина,
		Истина);
		
		Если ЗаголовкиОтчетов <> Неопределено Тогда
			КоличествоКолонок = ЗаголовкиОтчетов.Колонки.Количество();
			Для каждого ЗаголовокОтчета Из ЗаголовкиОтчетов Цикл
				ПроцедураДекларирования = Новый Структура;
				Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
					ПроцедураДекларирования.Вставить(ЗаголовкиОтчетов.Колонки[ИндексКолонки].Имя, ЗаголовокОтчета[ИндексКолонки]);
				КонецЦикла;
				Если НЕ ИспользоватьФильтрТипПроцедуры И ЗначениеЗаполнено(ОтборыВызова.ТипПроцедуры)
					И ПроцедураДекларирования.Свойство("ТипПроцедуры")
					И СтрНайти(ВРег(ПроцедураДекларирования.ТипПроцедуры), ВРег(ОтборыВызова.ТипПроцедуры)) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если ПроцедураДекларирования.Свойство("ОбщаяСтоимость")
					И (НЕ ЗначениеЗаполнено(ПроцедураДекларирования.ОбщаяСтоимость)
					ИЛИ нрег(СокрЛП(ПроцедураДекларирования.ОбщаяСтоимость)) = "null") Тогда
					ПроцедураДекларирования.ОбщаяСтоимость = "0 RUB";
				КонецЕсли;
				Результат.Добавить(ПроцедураДекларирования);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗаголовкиОтчетов = Неопределено ИЛИ ЗаголовкиОтчетов.Количество() < ЭлементовНаСтранице Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область МашиночитаемыеДоверенностиФТС

Функция ОбработатьНаПорталеФТСССервера(Знач ПараметрыОтправки, ПараметрыСоединения) Экспорт
	
	Результат = Неопределено;
	
	УточнениеАдресаСервераИспользуется = Ложь;
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	ПараметрыСоединения.ПовторятьЗапросПароля = Ложь;
	АвторизацияПроизведена = (ПараметрыСоединения.СоединениеHTTP <> Неопределено);
	
	Если НЕ АвторизацияПроизведена Тогда
		// очистить пароль, если в диалоге сохранения пароля не установлена галочка сохранения
		Если НЕ ПараметрыСоединения.СохранитьПароль И ЗначениеЗаполнено(ПараметрыСоединения.СохраненныйПароль) Тогда
			ЗаписатьЛогинИПарольПорталаФТС(ПараметрыОтправки.Организация,, "");
			ПараметрыСоединения.СохраненныйПароль = "";
		КонецЕсли;
	КонецЕсли;
	
	Для НомерСервера = 1 По ?(УточнениеАдресаСервераИспользуется, 2, 1) Цикл
		АдресСервера = ПараметрыСоединения.ТекущийАдресСервера;
		
		Если НЕ АвторизацияПроизведена Тогда
			// устанавливаем соединение с сервером
			ОписаниеОшибкиУстановкиСоединения = "";
			ПостфиксАдреса = ".customs.ru";
			ДлинаПостфиксаАдреса = СтрДлина(ПостфиксАдреса);
			ЗавершениеАдресаСервера = Прав(АдресСервера, ДлинаПостфиксаАдреса);
			Если ВРег(ЗавершениеАдресаСервера) <> ВРег(ПостфиксАдреса) Тогда
				АдресСервера = СерверПриемаОтчетностиФТС().АдресСервера;
			КонецЕсли;
			ПараметрыСоединения.СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(
				"https://" + АдресСервера, ОписаниеОшибкиУстановкиСоединения);
			
			Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
				ПараметрыСоединения.ПовторятьСоединение = Истина;
				СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Не удалось установить соединение с сервером:
								   |%1';
								   |en = 'Cannot connect to the server:
								   |%1'"), ОписаниеОшибкиУстановкиСоединения), ПараметрыСоединения.СообщенияПользователю);
				Прервать;
			КонецЕсли;
			
			ПараметрыСоединения.ЗначениеCookie = "";
			
			Если НомерСервера = 1 И УточнениеАдресаСервераИспользуется Тогда
				ЭтоВызовПередАвторизацией = Истина;
				Если НЕ УточнитьАдресСервераФТС(ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовПередАвторизацией) Тогда
					ПараметрыСоединения.СоединениеHTTP = Неопределено;
					Прервать;
				КонецЕсли;
				
				Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
					// сервер сменился, нужно повторно соединиться
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			АвторизацияПроизведена = АвторизоватьсяНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения);
		КонецЕсли;
		
		Если АвторизацияПроизведена И УточнениеАдресаСервераИспользуется Тогда
			Если НомерСервера = 1 Тогда
				ЭтоВызовПередАвторизацией = Ложь;
				Если НЕ УточнитьАдресСервераФТС(ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовПередАвторизацией) Тогда
					ПараметрыСоединения.СоединениеHTTP = Неопределено;
					АвторизацияПроизведена = Ложь;
					Прервать;
				КонецЕсли;
				
				Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
					// сервер сменился, нужно повторно соединиться
					АвторизацияПроизведена = Ложь;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Прервать;
	КонецЦикла;
	
	Если АвторизацияПроизведена Тогда
		Если ПараметрыОтправки.ТипОперации = "ОтправитьМашиночитаемуюДоверенностьФТС" Тогда
			Результат = ОтправитьМашиночитаемуюДоверенностьФТС(ПараметрыОтправки, ПараметрыСоединения);
		ИначеЕсли ПараметрыОтправки.ТипОперации = "ОбновитьМашиночитаемуюДоверенностьФТС" Тогда
			Результат = ОбновитьМашиночитаемуюДоверенностьФТС(ПараметрыОтправки, ПараметрыСоединения);
		КонецЕсли;
		
		Если Результат <> Неопределено Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = "";
			ПараметрыСоединения.ПовторятьСоединение = Ложь;
		КонецЕсли;
		
	Иначе
		ПараметрыСоединения.СоединениеHTTP = Неопределено;
	КонецЕсли;
	
	// обработка результатов
	
	Если Результат = Неопределено ИЛИ ПараметрыСоединения.ПовторятьСоединение Тогда
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером)
			ИЛИ НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
			
			Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
				ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(
					ПараметрыСоединения.ОписаниеОшибкиСервером);
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Результаты операции не получены с портала Федеральной таможенной службы. %1';
						|en = 'Operation results are not received from the portal of the Federal Customs Service. %1'"),
					ПараметрыСоединения.ОписаниеОшибкиСервером);
				
				СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
				
			Иначе
				ТекстСообщения = НСтр("ru = 'Не удалось получить результаты операции с портала Федеральной таможенной службы.';
										|en = 'Cannot receive operation results from the portal of the Federal Customs Service.'");
				
				СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
			КонецЕсли;
		КонецЕсли;
		
		Результат = Неопределено;
	КонецЕсли;
	
	ПараметрыСоединения.СоединениеHTTP = Неопределено;
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьМашиночитаемуюДоверенностьФТС(ПараметрыОтправки, ПараметрыСоединения)
	
	Результат = Неопределено;
	
	РезультатОтправкиВыгрузки = ЗагрузитьФайлНаПорталФТС(
		ПараметрыОтправки.КороткоеИмяФайлаВыгрузки,
		ПараметрыОтправки.АдресВыгрузки,
		"text/xml",
		ПараметрыСоединения);
	
	Если РезультатОтправкиВыгрузки <> Неопределено Тогда
		КороткоеИмяФайлаПодписи = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
			ПараметрыОтправки.КороткоеИмяФайлаВыгрузки).ИмяБезРасширения + ".sgn";
		РезультатОтправкиПодписи = ЗагрузитьФайлНаПорталФТС(
			КороткоеИмяФайлаПодписи,
			ПараметрыОтправки.АдресПодписи,
			"application/pkcs7-signature",
			ПараметрыСоединения);
		
		Если РезультатОтправкиПодписи <> Неопределено Тогда
			Результат = ЗарегистрироватьМашиночитаемуюДоверенностьНаПорталеФТС(
				РезультатОтправкиВыгрузки.ИмяЗагруженногоФайла,
				РезультатОтправкиВыгрузки.ИдентификаторЗагруженногоФайла,
				РезультатОтправкиПодписи.ИмяЗагруженногоФайла,
				РезультатОтправкиПодписи.ИдентификаторЗагруженногоФайла,
				ПараметрыОтправки,
				ПараметрыСоединения);
			
			Если Результат <> Неопределено И ПараметрыОтправки.Свойство("ОтчетСсылка") Тогда
				ДвоичныеДанныеПодписываемойВыгрузки = ПолучитьИзВременногоХранилища(ПараметрыОтправки.АдресВыгрузки);
				ДвоичныеДанныеПодписи = ПолучитьИзВременногоХранилища(ПараметрыОтправки.АдресПодписи);
				
				ДатаСеанса = ТекущаяДатаСеанса();
				ПоляДляЗаписиОтправки = Новый Структура;
				ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода", 	ДатаСеанса);
				ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", 	ДатаСеанса);
				ПоляДляЗаписиОтправки.Вставить("Версия", 				0);
				
				НастройкиОтправки = Новый Структура;
				НастройкиОтправки.Вставить("ДвоичныеДанныеПодписи", ДвоичныеДанныеПодписи);
				НастройкиОтправки.Вставить("ВидОтчета",
					Справочники.ВидыОтправляемыхДокументов.МашиночитаемыеДоверенностиРаспределенныйРеестр);
				НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", ПоляДляЗаписиОтправки);
				
				ОтправкаСсылка = ДобавитьОтправкуФТС(
					ПараметрыОтправки.ОтчетСсылка,
					ПараметрыОтправки.КороткоеИмяФайлаВыгрузки,
					ДвоичныеДанныеПодписываемойВыгрузки,
					Результат.ИдентификаторОтправкиНаСервере,
					НастройкиОтправки);
				Результат.Вставить("ОтправкаСсылка", ОтправкаСсылка);
				
				ЗаписатьСтатусОтправкиФТСОтчета(
					ПараметрыОтправки.ОтчетСсылка,
					Перечисления.СтатусыОтправки.Отправлен,
					ОтправкаСсылка);
				
				ПараметрыОтправки.Вставить("ИдентификаторОтправкиНаСервере", Результат.ИдентификаторОтправкиНаСервере);
				РезультатОбновления = ОбновитьМашиночитаемуюДоверенностьФТС(ПараметрыОтправки, ПараметрыСоединения);
				ПараметрыОтправки.Вставить("ОбновлениеВыполнено", РезультатОбновления <> Неопределено);
				Если РезультатОбновления <> Неопределено Тогда
					Для каждого ЭлементРезультатаОбновления Из РезультатОбновления Цикл
						Результат.Вставить(ЭлементРезультатаОбновления.Ключ, ЭлементРезультатаОбновления.Значение);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УдалитьBOM(ИмяВременногоФайла)
	
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
	ТекстФайла64 = Base64Строка(ДвоичныеДанныеФайла);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	Результат = ПолучитьИмяВременногоФайла();
	ТекстФайла64БезСигнатуры = Сред(ТекстФайла64, 5);
	ДвоичныеДанныеФайлаБезСигнатуры = Base64Значение(ТекстФайла64БезСигнатуры);
	ДвоичныеДанныеФайлаБезСигнатуры.Записать(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьФайлНаПорталФТС(
		КороткоеИмяФайла,
		АдресФайла,
		ТипСодержимогоФайла,
		ПараметрыСоединения)
	
	МассивИменФайлов = Новый Массив;
	
	// файл 1
	ТекстФайла = СтрШаблон(
		"--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""file""; filename=""%1"""
		+ Символы.ПС + "Content-Type: %2"
		+ Символы.ПС + Символы.ПС,
		КороткоеИмяФайла,
		ТипСодержимогоФайла);
	
