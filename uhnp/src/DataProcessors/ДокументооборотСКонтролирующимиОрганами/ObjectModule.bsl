Функция РазобратьОтветВходящиеСообщенияСЭДОФСС(
	СодержимоеОтвета,
	ДатаСообщений = Неопределено,
	ИдентификаторЗапроса = "",
	СвойстваОбменаПоСЭДОЧерезОператора = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщений", Новый Массив);
	Результат.Вставить("ДанныеШироковещательныхСообщений", Новый Массив);
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("КодыОшибок", Новый Массив);
	
	Если НЕ ЗначениеЗаполнено(СодержимоеОтвета) Тогда
		Событие = СобытиеЖурналаРегистрации();
		ОписаниеОшибки = НСтр("ru = 'Получен пустой ответ с сервера СЭДО при загрузке списка входящих сообщений.';
								|en = 'An empty response is received from the EDI server when importing the incoming message list.'");
		Результат.ОписаниеОшибки = ОписаниеОшибки;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		Событие = СобытиеЖурналаРегистрации();
		ОписаниеОшибки = НСтр("ru = 'При разборе ответа с сервера СЭДО возникла ошибка при загрузке списка входящих сообщений.';
								|en = 'An error occurred when parsing the response from the EDI server when importing the incoming message list.'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибкиДляЖурнала = ОписаниеОшибки + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиДляЖурнала);
		Результат.ОписаниеОшибки = ОписаниеОшибки;
		Возврат Результат;
	КонецПопытки;
	Чтение.Закрыть();
	
	// Пример ответа сервера:
	//<soap:Body wsu:Id="OGRN_1027739443236">
	//	<ns5:messageListResponse xmlns:ns2="http://www.fss.ru/integration/types/common/v01" xmlns:ns3="http://www.fss.ru/integration/types/fault/v01"
	//		<result>
	//		<messageCount>2</messageCount>
	//			<messageList>
	//				<uuid>d885286d-c331-4e7f-80c0-387a69d51fb9</uuid>
	//				<messageType>11</messageType>
	//				<recipientId>3101011870</recipientId>
	//				<regNumSfr>1054107196</regNumSfr>
	//				<expiryDate>2024-09-30+03:00</expiryDate>
	//				<needConfirm>false</needConfirm>
	//				<messageDate>2024-09-23T16:32:56.232+03:00</messageDate>
	//			</messageList>
	//			<broadcastMessageList>
	//				<broadcastMessage>
	//					<messageUuid>a54fc184-9f02-49eb-b2c6-b1fb0b2fe25e</messageUuid>
	//					<message>В связи с переходом на Единую цифровую платформу в социальной сфере вводится
	//						новый регистрационный номер страхователя в СФР, который необходимо указывать в отчетности, представляемой в СФР с 01.11.2024.
	//						Узнать свой новый регистрационный номер в СФР страхователь может на официальном сайте СФР:
	//						https://ecp.sfr.gov.ru/new-reg-num с 01.10.2024.
	//						Кроме этого, сведения о новом регистрационном номере в СФР будут отражены в выписках ЕГРЮЛ/ЕГРИП.
	//					</message>
	//					<dateOfRelevance>2024-09-24+03:00</dateOfRelevance>
	//				</broadcastMessage>
	//			</broadcastMessageList>
	//		</result>
	//	</ns5:messageListResponse>
	//</soap:Body>
	// Или при типе взаимодействия 3 "Организация" (МЧД, для ИП в узле "org" передаются узлы "ogrnip", "inn", "snils"):
	//<soap:Body wsu:Id="OGRN_1027739443236">
	//   <ns2:messageListResponse xmlns:ns2="http://www.fss.ru/integration/types/sedo/v01" xmlns:ns3="http://www.fss.ru/integration/types/fault/v01">
	//      <result>
	//         <messageCount>1</messageCount>
	//         <messageList>
	//            <uuid>48189069-027a-4a45-ad41-b495b0048964</uuid>
	//            <messageType>211</messageType>
	//            <org>
	//               <inn>3123415674</inn>
	//               <ogrn>1173123022313</ogrn>
	//               <kpp>312301001</kpp>
	//            </org>
	//            <needConfirm>false</needConfirm>
	//         </messageList>
	//      </result>
	//   </ns2:messageListResponse>
	//</soap:Body>
	
	ДанныеСообщенияШаблон = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеДанныеСообщенияСЭДО(Истина);
	
	Если ДанныеОтвета.Свойства().Получить("Body") <> Неопределено Тогда
		Если ДанныеОтвета.Body.Свойства().Получить("messageListResponse") <> Неопределено Тогда
			УзелДанных = ДанныеОтвета.Body.messageListResponse;
		Иначе
			УзелДанных = ДанныеОтвета;
		КонецЕсли;
	Иначе
		УзелДанных = ДанныеОтвета;
	КонецЕсли;
	
	Если УзелДанных.Свойства().Получить("errorList") <> Неопределено Тогда
		Ошибки = Новый Массив;
		Для каждого Ошибка Из ЗначениеВКоллекцию(УзелДанных.errorList.message) Цикл
			Ошибки.Добавить(Ошибка);
		КонецЦикла;
		Для каждого Код Из ЗначениеВКоллекцию(УзелДанных.errorList.code) Цикл
			Результат.КодыОшибок.Добавить(Код);
		КонецЦикла;
		ТекстОшибки = СтрСоединить(Ошибки, Символы.ПС);
		Шаблон = НСтр("ru = 'Ответ СЭДО ФСС: ""%1""';
						|en = 'SSF EDI response: ""%1""'");
		Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Если УзелДанных.Свойства().Получить("result") <> Неопределено Тогда
		Количество = XMLЗначение(Тип("Число"), УзелДанных.result.messageCount);
		Если Количество > 0 И ЕстьСвойство(УзелДанных.result, "messageList") Тогда
			Для каждого Сообщение Из ЗначениеВКоллекцию(УзелДанных.result.messageList) Цикл
				// Разбирается только узел messageList, узел broadcastMessageList игнорируется.
				ДанныеСообщения = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеСообщенияШаблон);
				ДанныеСообщения.Идентификатор = Сообщение.uuid;
				ДанныеСообщения.Тип = СокрЛП(Сообщение.messageType);
				ЭлектронныйДокументооборотСФСС.ЗаполнитьОписаниеТипаВДанныхСообщенияСЭДО(ДанныеСообщения);
				Если Сообщение.Свойства().Получить("recipientId") = Неопределено
					И Сообщение.Свойства().Получить("org") <> Неопределено Тогда
					Если Сообщение.org.Свойства().Получить("ogrnip") = Неопределено Тогда
						Если Сообщение.org.Свойства().Получить("ogrn") <> Неопределено Тогда
							ДанныеСообщения.Получатель = Сообщение.org.ogrn;
						КонецЕсли;
					Иначе
						ДанныеСообщения.Получатель = Сообщение.org.ogrnip;
					КонецЕсли;
					ДанныеСообщения.ИНН = Сообщение.org.inn;
					Если Сообщение.org.Свойства().Получить("kpp") <> Неопределено Тогда
						ДанныеСообщения.КПП = Сообщение.org.kpp;
					КонецЕсли;
					Если Сообщение.org.Свойства().Получить("snils") <> Неопределено Тогда
						ДанныеСообщения.СНИЛС = ?(ТипЗнч(Сообщение.org.snils) = Тип("ОбъектXDTO"), "", Сообщение.org.snils);
					КонецЕсли;
				ИначеЕсли Сообщение.Свойства().Получить("recipientId") <> Неопределено Тогда
					ДанныеСообщения.Получатель = Сообщение.recipientId;
				КонецЕсли;
				Если ЕстьСвойство(Сообщение, "regNumSfr") Тогда
					ДанныеСообщения.РегистрационныйНомерСФР = Сообщение.regNumSfr;
				КонецЕсли;
				ДанныеСообщения.ТребуетсяПодтверждение = XMLЗначение(Тип("Булево"), Сообщение.needConfirm);
				Если ЕстьСвойство(Сообщение, "expiryDate") Тогда
					ДанныеСообщения.СрокДействия = XMLЗначение(Тип("Дата"), Сообщение.expiryDate);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДатаСообщений) Тогда
					ДанныеСообщения.Дата = ДатаСообщений;
				Иначе
					ДанныеСообщения.Дата = ТекущаяДатаСеанса();
				КонецЕсли;
				
				Если ЕстьСвойство(Сообщение, "messageDate") Тогда
					ДанныеСообщения.Дата = XMLЗначение(Тип("Дата"), Сообщение.messageDate);
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(ИдентификаторЗапроса) Тогда
					ДанныеСообщения.ИдентификаторЗапроса = ИдентификаторЗапроса;
				КонецЕсли;
				
				Результат.ДанныеСообщений.Добавить(ДанныеСообщения);
				
			КонецЦикла;
		КонецЕсли;
		Если Количество > 0
			И ЕстьСвойство(УзелДанных.result, "broadcastMessageList")
			И (НЕ СвойстваОбменаПоСЭДОЧерезОператора = Неопределено
			И СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую) Тогда
			
			Для каждого Сообщение Из ЗначениеВКоллекцию(УзелДанных.result.broadcastMessageList) Цикл
				Для каждого ШироковещательноеСообщение Из ЗначениеВКоллекцию(Сообщение.broadcastMessage) Цикл
					ДанныеСообщения = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеДанныеРассылкиСЭДО();
					ДанныеСообщения.Идентификатор = ШироковещательноеСообщение.messageUuid;
					
					Если ЕстьСвойство(ШироковещательноеСообщение, "dateOfRelevance") Тогда
						ДанныеСообщения.АктуальноДоДаты = XMLЗначение(Тип("Дата"), ШироковещательноеСообщение.dateOfRelevance);
					КонецЕсли;
					
					ДанныеСообщения.Дата = ТекущаяДатаСеанса();
					ДанныеСообщения.ТекстСообщения = ШироковещательноеСообщение.message;
					
					Результат.ДанныеШироковещательныхСообщений.Добавить(ДанныеСообщения);
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИсходногоСообщенияИзОшибкиЛогическогоКонтроля(УзелДанных)
	
	ИдентификаторИсходного = "";
	Если ЕстьСвойство(УзелДанных, "uuidInbound") Тогда 
		ИдентификаторИсходного = ИдентификаторИсходногоСообщенияСКоррекцией(УзелДанных.uuidInbound);
	Иначе
		Если ЕстьСвойство(УзелДанных, "uuid") Тогда
			ИдентификаторИсходного = ИдентификаторИсходногоСообщенияСКоррекцией(УзелДанных.uuid);
		КонецЕсли;
	КонецЕсли;
	Возврат ИдентификаторИсходного;
	
КонецФункции

Функция ИдентификаторИсходногоСообщенияСКоррекцией(Идентификатор)
	
	Результат = Идентификатор;
	Если НЕ ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		// Особенность фабрики XDTO, если значение узла не заполнено, то возвращается тип ОбъектXDTO.
		// Пример: <uuidInbound></uuidInbound>
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбор документа, предназначеного для получения сведений о найденных ошибках
// логического контроля в конверте сообщения.
Функция РазобратьСообщениеСОшибкойЛогическогоКонтроляСЭДОФСС(СодержимоеСообщения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ИдентификаторИсходногоСообщения", "");
	Результат.Вставить("ОшибкиКонтроля", "");
	
	// Пример ответа сервера:
	//<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	//<invalidDataFault xmlns="http://www.fss.ru/integration/types/fault/v01">
	//	<uuidInbound>4900e566-d7ed-4a80-91d2-8dd9f26d5f89</uuidInbound>
	//	<faultList>
	//		<fault>
	//			<uuid>4900e566-d7ed-4a80-91d2-8dd9f26d5f89</uuid>
	//			<code>E_SEDO_1025</code>
	//			<message>Пара рег.номер 7711000003 из запроса и ОГРН 1027739443236 из сертификата не найдены в справочнике страхователей</message>
	//		</fault>
	//	</faultList>
	//</invalidDataFault>
	
	//<CommonFault xmlns="http://www.fss.ru/integration/types/ls/v01" xmlns:ns2="http://www.fss.ru/integration/types/fault/v01">
	//<ns2:uuid>8edad618-7e1f-4c2f-b3f8-c01034254df4</ns2:uuid><ns2:code>LS_SEDO_ERROR_0001</ns2:code>
	//<ns2:message>Не удалось найти страхователя по указанным в запросе данным.</ns2:message></CommonFault>
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СодержимоеСообщения);
	
	УзелДанных = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Результат.ИдентификаторИсходногоСообщения = ИдентификаторИсходногоСообщенияИзОшибкиЛогическогоКонтроля(УзелДанных);
	
	Ошибки = Новый Массив;
	Если УзелДанных.Свойства().Получить("faultList") <> Неопределено Тогда
		Для каждого Ошибка Из ЗначениеВКоллекцию(УзелДанных.faultList.fault) Цикл
			Ошибки.Добавить(Ошибка.message);
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьСвойство(УзелДанных, "message") Тогда
		Ошибки.Добавить(УзелДанных.message);
	КонецЕсли;
	
	Результат.ОшибкиКонтроля = СтрСоединить(Ошибки, Символы.ПС);
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Процедура СохранитьДатуПолученияОтветаНаПодтверждениеОПрочтении(Организация,
		ИдентификаторСообщения,
		ОшибкаПодтверждения = "")

	Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Идентификатор = ИдентификаторСообщения;
	Запись.Прочитать();
	
	Запись.Организация = Организация;
	Запись.Идентификатор = ИдентификаторСообщения;
	
	Если ПустаяСтрока(ОшибкаПодтверждения) Тогда
		Если НЕ ЗначениеЗаполнено(Запись.ДатаПолученияИзвещенияОПолученииПодтверждения) Тогда
			Запись.ДатаПолученияИзвещенияОПолученииПодтверждения = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
	Иначе
		Запись.ОшибкаПодтверждения = ОшибкаПодтверждения;
		Запись.ДатаПолученияОшибкиПодтверждения = ТекущаяДатаСеанса();
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция РазобратьОтветНаПодтверждениеОПОлучении(Организация, ДанныеСообщения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("РезультатыПодтверждений", Новый Массив);
	
	// Пример ответа сервера:
	//<ns3:confirmMessageReadResponse xmlns:ns2="http://www.fss.ru/integration/types/common/v01"
	//xmlns:ns3="http://www.fss.ru/integration/types/sedo/arm/v01">
	//	<confirmResults>
	//		<uuid>09709829-4967-48cb-9dcb-f30d3043088f</uuid>
	//		<status>ERROR</status>
	//		<warn>
	//			<ns2:code>W_SEDO_3140</ns2:code>
	//			<ns2:details>Сообщение не требует подтверждения о прочтении</ns2:details>
	//		</warn>
	//	</confirmResults>
	//	<confirmResults>
	//		<uuid>40966e45-4388-4894-8a98-502e8d2340ae</uuid>
	//		<status>SUCCESS</status>
	//	</confirmResults>
	//</ns3:confirmMessageReadResponse>
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ДанныеСообщения.ТекстСообщения);
	Содержимое = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Чтение.Закрыть();
	
	Для каждого Элемент Из ЗначениеВКоллекцию(Содержимое.confirmResults) Цикл
		
		// Идентификатор входящего сообщения, которое подтверждали.
		ИдентификаторПодтвержденногоСообщения = Элемент.uuid;
		
		Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
		Запись.Организация = Организация;
		Запись.Идентификатор = ИдентификаторПодтвержденногоСообщения;
		Запись.Прочитать();
		
		// Данные подтверждения.
		Подтверждение = Новый Структура;
		Подтверждение.Вставить("ИдентификаторСообщения", ИдентификаторПодтвержденногоСообщения);
		Подтверждение.Вставить("Тип", Запись.Тип);
		Подтверждение.Вставить("ТекстОшибки", "");
		Подтверждение.Вставить("ТекстПредупреждения", "");
		
		Если Элемент.status = СтатусОшибкиСЭДО() Тогда
			Если Элемент.Свойства().Получить("warn") <> Неопределено Тогда
				ТекстОшибки = Элемент.warn.details;
				Подтверждение.ТекстПредупреждения = ТекстОшибки;
			Иначе
				ТекстОшибки = Элемент.error.details;
				Подтверждение.ТекстОшибки = ТекстОшибки;
			КонецЕсли;
			
			СохранитьДатуПолученияОтветаНаПодтверждениеОПрочтении(
				Организация,
				ИдентификаторПодтвержденногоСообщения,
				ТекстОшибки);
		ИначеЕсли Элемент.status = СтатусУспехаСЭДО() Тогда
			СохранитьДатуПолученияОтветаНаПодтверждениеОПрочтении(
				Организация,
				ИдентификаторПодтвержденногоСообщения);
		КонецЕсли;
			
		Результат.РезультатыПодтверждений.Добавить(Подтверждение);
		
	КонецЦикла;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеИсходящегоСообщенияСЭДОФСС(Организация, Идентификатор, ПроверятьИдентификаторПакетаФСС = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ДанныеСообщения", Неопределено);
	Результат.Вставить("ОшибкаПолученияТекста", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	ДанныеСообщения = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеДанныеСообщенияСЭДО();
	Результат.ДанныеСообщения = ДанныеСообщения;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СоответствиеСообщений.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	ЖурналЗапросов.Идентификатор КАК Идентификатор,
	|	ЖурналЗапросов.ИдентификаторФСС КАК ИдентификаторФСС,
	|	ЖурналЗапросов.ТипСообщенияСЭДО КАК ТипСообщенияСЭДО,
	|	ЖурналЗапросов.ТипВзаимодействияСЭДО КАК ТипВзаимодействияСЭДО,
	|	ЖурналЗапросов.Дата КАК Дата,
	|	ЖурналЗапросов.ОбменЧерезОператора КАК ОбменЧерезОператора,
	|	ЖурналЗапросов.ЭтоПользовательскийЗапрос КАК ЭтоПользовательскийЗапрос,
	|	ЖурналЗапросов.ДанныеЗапроса КАК ДанныеЗапроса
	|ИЗ
	|	РегистрСведений.СоответствиеСообщенийСЭДОЗапросам КАК СоответствиеСообщений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналЗапросовКСерверамФСС КАК ЖурналЗапросов
	|		ПО СоответствиеСообщений.ИдентификаторЗапроса = ЖурналЗапросов.Идентификатор
	|			И СоответствиеСообщений.Организация = ЖурналЗапросов.Организация
	|ГДЕ
	|	СоответствиеСообщений.Организация = &Организация
	|	И &УсловиеИдентификатора";
	
	Если ПроверятьИдентификаторПакетаФСС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИдентификатора", 
		"(СоответствиеСообщений.ИдентификаторСообщения = &ИдентификаторФСС"
			+ " ИЛИ СоответствиеСообщений.ИдентификаторПакета = &ИдентификаторФСС)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИдентификатора", 
		"СоответствиеСообщений.ИдентификаторСообщения = &ИдентификаторФСС");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ИдентификаторФСС", Идентификатор);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатВыполнения = Запрос.Выполнить();
	Если РезультатВыполнения.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатВыполнения.Выбрать();
	Выборка.Следующий();
	
	// Проверка наличия данных из ЖурналЗапросовКСерверамФСС
	Если НЕ ЗначениеЗаполнено(Выборка.Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Заполнение структуры результата
	Результат.ДанныеСообщения.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
	Результат.ДанныеСообщения.Идентификатор = Выборка.ИдентификаторФСС;
	Результат.ДанныеСообщения.Тип = Выборка.ТипСообщенияСЭДО;
	Результат.ДанныеСообщения.ТипВзаимодействия = Выборка.ТипВзаимодействияСЭДО;
	Результат.ДанныеСообщения.Дата = Выборка.Дата;
	Результат.ДанныеСообщения.ОбменЧерезОператора = Выборка.ОбменЧерезОператора;
	Результат.ДанныеСообщения.ЭтоПользовательскийЗапрос = Выборка.ЭтоПользовательскийЗапрос;
	Если ПроверятьИдентификаторПакетаФСС Тогда
		Результат.ДанныеСообщения.Идентификатор = Выборка.ИдентификаторФСС;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	// Извлечение текста исходного сообщения
	ТекстЗапроса = Выборка.ДанныеЗапроса.Получить();
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстЗапроса);
		ДанныеЗапроса = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КраткоеПредставление = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Шаблон = НСтр("ru = 'Ошибка формата сообщения СЭДО %1: %2. Текст сообщения:';
						|en = 'Error in %1 EDI message format: %2. Message text:'") + Символы.ПС + "%3";
		ТекстСобытия = СтрШаблон(Шаблон, Идентификатор, КраткоеПредставление, ТекстЗапроса);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстСобытия);
		Результат.ОшибкаПолученияТекста = Истина;
		Шаблон = НСтр("ru = 'Исходящее сообщения %1 (тип %2) имеет неверный формат.';
						|en = 'The %1 outgoing message (the %2 type) has an incorrect format.'");
		ТекстОшибкиНеверногоФормата = СтрШаблон(Шаблон, Идентификатор, Выборка.ТипСообщенияСЭДО);
		Результат.ОписаниеОшибки = ТекстОшибкиНеверногоФормата;
		Возврат Результат;
	КонецПопытки;
	
	Если ДанныеЗапроса.Body.putMessageRequest.Свойства().Получить("message") = Неопределено Тогда
		// Сообщение отправлялось в пакетном запросе
		ТекстСообщенияBase64 = СокрЛП(ДанныеЗапроса.Body.putMessageRequest.messagePackageList.messagePackage.message);
	Иначе
		ТекстСообщенияBase64 = СокрЛП(ДанныеЗапроса.Body.putMessageRequest.message);
	КонецЕсли;
	ДвоичныеДанныеСообщения = Base64Значение(ТекстСообщенияBase64);
	Если ДвоичныеДанныеСообщения = Неопределено Тогда
		// Не удалось преобразовать исходное сообщение из base64 в двоичные данные
		Шаблон = НСтр("ru = 'Не удалось извлечь текст сообщения СЭДО %1 из формата Base64: %2';
						|en = 'Cannot extract the text of the %1 EDI message from the Base64 format: %2'");
		ТекстСобытия = СтрШаблон(Шаблон, Идентификатор, ТекстСообщенияBase64);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстСобытия);
		Результат.ОшибкаПолученияТекста = Истина;
		Шаблон = НСтр("ru = 'Исходящее сообщения %1 (тип %2) имеет неверный формат.';
						|en = 'The %1 outgoing message (the %2 type) has an incorrect format.'");
		ТекстОшибкиНеверногоФормата = СтрШаблон(Шаблон, Идентификатор, Выборка.ТипСообщенияСЭДО);
		Результат.ОписаниеОшибки = ТекстОшибкиНеверногоФормата;
		Возврат Результат;
	КонецЕсли;
	Чтение = Новый ЧтениеДанных(ДвоичныеДанныеСообщения);
	ДанныеСообщения.ТекстСообщения = Чтение.ПрочитатьСимволы();
	Чтение.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеОшибокЛогическогоКонтроляСЭДОФСС(Организация, ДанныеСообщения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеИсходногоСообщения", 	Неопределено);
	Результат.Вставить("ОшибкиКонтроля", 			"");
	Результат.Вставить("Организация", 				Организация);
	Результат.Вставить("ИсходноеСообщениеНайдено", 	Ложь);
	Результат.Вставить("ОшибкаПоиска", 				"");
	Результат.Вставить("ИдентификаторФСС", 			"");
	
	РезультатРазбора = РазобратьСообщениеСОшибкойЛогическогоКонтроляСЭДОФСС(ДанныеСообщения.ТекстСообщения);
	
	ОшибкиКонтроля = РезультатРазбора.ОшибкиКонтроля;
	Идентификатор = РезультатРазбора.ИдентификаторИсходногоСообщения;
	Результат.ИдентификаторФСС = Идентификатор;
	
	ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
						|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'");
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		// Поиск исходного сообщения.
		РезультатПоиска = ДанныеИсходящегоСообщенияСЭДОФСС(
			Организация,
			Идентификатор,
			Истина);
		Если НЕ РезультатПоиска.Выполнено Тогда
			Шаблон = НСтр("ru = 'Сообщение %1 не найдено в исходящих сообщениях организации %2.';
							|en = 'The %1 message is not found in outgoing messages of %2 company.'");
			ТекстОшибки = СтрШаблон(Шаблон, Идентификатор, Организация);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				УровеньЖурналаРегистрации.Ошибка, , ,
				ТекстОшибки);
			Результат.ОшибкаПоиска = ТекстОшибки;
		Иначе
			Если РезультатПоиска.ОшибкаПолученияТекста Тогда
				Результат.ОшибкаПоиска = РезультатПоиска.ОписаниеОшибки;
			КонецЕсли;
			Результат.ИсходноеСообщениеНайдено = Истина;
			Результат.ИдентификаторФСС = РезультатПоиска.ДанныеСообщения.Идентификатор;
			Результат.ДанныеИсходногоСообщения = РезультатПоиска.ДанныеСообщения;
		КонецЕсли;
	Иначе
		// Может быть ситуация когда не задан идентификатор исходного сообщения.
		ТекстОшибки = НСтр("ru = 'Не задан идентификатор исходного сообщения.';
							|en = 'The original message ID is not specified.'");
		Результат.ОшибкаПоиска = ТекстОшибки;
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
	КонецЕсли;
		
	Результат.ОшибкиКонтроля = ОшибкиКонтроля;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьОшибкуЛогическогоКонтроляПодтвержденияОПолучении(ДанныеОшибки) Экспорт
	
	ТекстСообщения = ДанныеОшибки.ДанныеИсходногоСообщения.ТекстСообщения;
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстСообщения);
	ДанныеИсходногоСообщения = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Чтение.Закрыть();
	Для каждого Идентификатор Из ЗначениеВКоллекцию(ДанныеИсходногоСообщения.uuids.uuid) Цикл
		СохранитьДатуПолученияОтветаНаПодтверждениеОПрочтении(
			ДанныеОшибки.Организация,
			Идентификатор,
			ДанныеОшибки.ОшибкиКонтроля);
	КонецЦикла;
			
	Возврат Истина;
	
КонецФункции

Функция ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
		РегистрационныйНомерФСС,
		ДатаСообщений = Неопределено,
		Настройки = Неопределено) Экспорт
	
	НастройкиВызова = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, Настройки);
	КонецЕсли;
	
	ИнформацияОПрограмме = ИнформацияОПрограмме();
	Если НастройкиВызова.ТипВзаимодействия = Неопределено Тогда
		НастройкиВызова.ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ТекстПараметровТипаВзаимодействия = ДокументооборотСФССКлиентСервер.ТекстПараметровТипаВзаимодействияСЭДО(
		РегистрационныйНомерФСС, НастройкиВызова);
	
	УзелДаты = "";
	Шаблон = "
		|         <messageDate>%1</messageDate>";
	Если ЗначениеЗаполнено(ДатаСообщений) И ТипЗнч(ДатаСообщений) = Тип("Дата") Тогда
		УзелДаты = СтрШаблон(Шаблон, XMLДата(ДатаСообщений));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаСообщений) И ТипЗнч(ДатаСообщений) = Тип("Структура") Тогда
		Если ДатаСообщений.ВремяНачала = НачалоДня(Дата(1, 1, 1))
			И ДатаСообщений.ВремяКонца = КонецДня(Дата(1, 1, 1)) Тогда
			
			УзелДаты = СтрШаблон(Шаблон, XMLДата(ДатаСообщений.Дата));
		Иначе
			Шаблон = "
				|         <messageDate>%1</messageDate>";
			УзелДаты = СтрШаблон(
				Шаблон,
				XMLДата(ДатаСообщений.Дата));
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиВызова.ОбменПоСЭДОНапрямую Тогда
		Шаблон = "<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01"">
			|   <soapenv:Header/>
			|   <soapenv:Body>
			|      <v01:getCntMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%3</software>
			|            <softwareVersion>%4</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>%2%5
			|      </v01:getCntMessageRequest>
			|   </soapenv:Body>
			|</soapenv:Envelope>";
		
		Текст = СтрШаблон(Шаблон,
			НастройкиВызова.ТипВзаимодействия,
			ТекстПараметровТипаВзаимодействия,
			ИнформацияОПрограмме.ИДКонфигурации,
			ИнформацияОПрограмме.ВерсияКонфигурации,
			УзелДаты);
		
	Иначе
		Шаблон = "<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:v01=""http://www.fss.ru/integration/types/sedo/v01"">
			|   <soapenv:Header>
			|      <Guid>%6</Guid>
			|      <Type>1c</Type>
			|   </soapenv:Header>
			|   <soapenv:Body>
			|      <v01:getCntMessageRequest>
			|         <systemInfo>
			|            <specVersion>1.0</specVersion>
			|            <software>%3</software>
			|            <softwareVersion>%4</softwareVersion>
			|         </systemInfo>
			|         <interactionType>%1</interactionType>%2%5
			|      </v01:getCntMessageRequest>
			|   </soapenv:Body>
			|</soapenv:Envelope>";
		
		Текст = СтрШаблон(Шаблон,
			НастройкиВызова.ТипВзаимодействия,
			ТекстПараметровТипаВзаимодействия,
			ИнформацияОПрограмме.ИДКонфигурации,
			ИнформацияОПрограмме.ВерсияКонфигурации,
			УзелДаты,
			НастройкиВызова.ИдентификаторАбонентаСЭДО);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Вызывается из фонового задания обмена с ФСС.
Функция МетаданныеВходящихСообщенийСЭДОФСС(
		Организация,
		ДатаСообщений = Неопределено,
		ТипВзаимодействия = Неопределено,
		СвойстваОбменаПоСЭДОЧерезОператора = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ОшибкаСоединения", Ложь);
	Результат.Вставить("ДанныеСообщений", Неопределено);
	Результат.Вставить("ВозниклаБлокировкаИзЗаЧастыхЗапросов", Ложь);
	Результат.Вставить("ОсталосьВремениБлокировки", 0);
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	Настройки = ДокументооборотСФССКлиентСервер.НастройкиТекстовЗапросовСЭДОФСС();
	Настройки.ТипВзаимодействия = ТипВзаимодействия;
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН 			= ЭтоТипВзаимодействияОрганизацияСЭДО;
	ПолучитьИННКППиСНИЛС 	= ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(
		Организация,,
		ПолучитьОГРН,,
		ПолучитьИННКППиСНИЛС);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		ЗаполнитьЗначенияСвойств(Настройки, СвойстваОрганизации);
	КонецЕсли;
	
	Если ПустаяСтрока(РегистрационныйНомерФСС) Тогда
		Шаблон = НСтр("ru = 'Не задан рег.номер ФСС для организации %1.';
						|en = 'SSF registration number is not set for company %1.'");
		Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, Организация);
		Возврат Результат;
	КонецЕсли;
	
	Если СвойстваОбменаПоСЭДОЧерезОператора = Неопределено Тогда
		СвойстваОбменаПоСЭДОЧерезОператора =
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	КонецЕсли;
	Настройки.ОбменПоСЭДОНапрямую 		= СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	Настройки.ИдентификаторАбонентаСЭДО = СвойстваОбменаПоСЭДОЧерезОператора.ИдентификаторАбонентаСЭДО;
	
	Операция = ЭлектронныйДокументооборотСФССКлиентСервер.ОперацияПолученияСпискаВходящихСЭДО();
	
	ТекстЗапроса = ТекстЗапросаПолученияКоличестваСообщенийСЭДОФСС(
		РегистрационныйНомерФСС,
		ДатаСообщений,
		Настройки);
	АдресЗашифрованногоЗапросаSOAP = ПоместитьВоВременноеХранилище(ТекстЗапроса);
	
	// Отправка запроса.
	РезультатОтправки = ОтправитьЗапросСервисуСЭДОФСС(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP,
		СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
	ПараметрыЗапросаДляСохранения = ЭлектронныйДокументооборотСФССКлиентСервер.ПараметрыСохраненияЗапросаСЭДОФСС(
			Организация, Операция);
	ЗаполнитьЗначенияСвойств(ПараметрыЗапросаДляСохранения, РезультатОтправки);
	ПараметрыЗапросаДляСохранения.ТипВзаимодействияСЭДО = ТипВзаимодействия;
	ПараметрыЗапросаДляСохранения.УдалятьИзХранилища 	= Ложь;
	ПараметрыЗапросаДляСохранения.ОбменЧерезОператора 	= НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	ПараметрыЗапросаДляСохранения.АдресЗапросаSOAP 		= АдресЗашифрованногоЗапросаSOAP;
	ПараметрыЗапросаДляСохранения.АдресОтветаSOAP 		= РезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	ПараметрыЗапросаДляСохранения.ТипСообщенияСЭДО 		= "";
	Если НЕ РезультатОтправки.Выполнено Тогда
		Шаблон = НСтр("ru = 'Ошибка получения данных о входящих сообщениях СЭДО ФСС:
		|%1';
		|en = 'Error when receiving data on incoming SSF EDI messages:
		|%1'");
		Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
		Результат.ОписаниеОшибки = СтрШаблон(Шаблон, РезультатОтправки.ОписаниеОшибки);
		Результат.ОшибкаСоединения = РезультатОтправки.ОшибкаСоединения;
		Результат.ВозниклаБлокировкаИзЗаЧастыхЗапросов =
			РезультатОтправки.ВозниклаБлокировкаИзЗаЧастыхЗапросов;
		Результат.ОсталосьВремениБлокировки =
			РезультатОтправки.ОсталосьВремениБлокировки;
		ПараметрыЗапросаДляСохранения.УдалятьИзХранилища = Истина;
		ЭлектронныйДокументооборотСФСС.СохранитьДанныеЗапросаСЭДО(ПараметрыЗапросаДляСохранения);
		Если ЭтоАдресВременногоХранилища(РезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные) Тогда
			УдалитьИзВременногоХранилища(РезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	// Сохраняем данные запроса и ответ сервера.
	ЭлектронныйДокументооборотСФСС.СохранитьДанныеЗапросаСЭДО(ПараметрыЗапросаДляСохранения);
	
	АдресОтветаSOAP = РезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	ТекстОтвета = ПолучитьИзВременногоХранилища(АдресОтветаSOAP);
	УдалитьИзВременногоХранилища(АдресОтветаSOAP);
	УдалитьИзВременногоХранилища(РезультатОтправки.АдресЗашифрованногоОтветаSOAPДвоичныеДанные);
	
	РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(ТекстОтвета,
		ДатаСообщений,
		ПараметрыЗапросаДляСохранения.Идентификатор,
		СвойстваОбменаПоСЭДОЧерезОператора);
	Если НЕ РезультатРазбора.Выполнено Тогда
		Результат.ОписаниеОшибки = РезультатРазбора.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ДанныеСообщений = РезультатРазбора.ДанныеСообщений;
	
	РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
		Организация,
		ДанныеСообщений,
		ТипВзаимодействия,
		СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		
	ДанныеШироковещательныхСообщений = РезультатРазбора.ДанныеШироковещательныхСообщений;
	СохранитьДанныеРассылокСЭДОФСС(
		Организация,
		ДанныеШироковещательныхСообщений,
		СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
		
	Результат.ДанныеСообщений = РезультатСохранения.ДанныеСообщений;
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьДанныеВходящихСообщенийСЭДОФСС(
		Организация,
		ДанныеСообщений,
		ТипВзаимодействия = Неопределено,
		ОбменПоСЭДОНапрямую = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеСообщений", ДанныеСообщений);
	Результат.Вставить("НовыеСообщения", Новый Массив);
	Результат.Вставить("ОшибкиОбработки", Новый Массив);
	Результат.Вставить("БылиОшибкиОбработки", Ложь);
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	ТипСообщенияСоСпискомВходящихСообщений = ТипыСообщений.ТипСообщенияОтветНаЗапросИсторическихДанных; // Тип 332.
	
	Идентификаторы = Новый Массив;
	Идентификаторы332 = Новый Массив;
	Идентификаторы332ДляСоздания = Новый Массив;
	Для каждого ДанныеСообщения Из ДанныеСообщений Цикл
		Идентификаторы.Добавить(ДанныеСообщения.Идентификатор);
		Если ТипСообщенияСЭДОВСтроку(
				ДанныеСообщения.Тип) = ТипСообщенияСоСпискомВходящихСообщений Тогда
			Идентификаторы332.Добавить(ДанныеСообщения.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	// Получаем список идентификаторов 332 сообщений по которым было отправлено 330 сообщение из текущей базы.
	Если Идентификаторы332.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	СоответствиеСообщенийСЭДОЗапросам.ИдентификаторСообщения КАК Идентификатор
			|ИЗ
			|	РегистрСведений.СоответствиеСообщенийСЭДОЗапросам КАК СоответствиеСообщенийСЭДОЗапросам
			|ГДЕ
			|	СоответствиеСообщенийСЭДОЗапросам.ИдентификаторСообщения В(&Идентификаторы)
			|	И СоответствиеСообщенийСЭДОЗапросам.Организация = &Организация
			|	И СоответствиеСообщенийСЭДОЗапросам.ТипСообщения = &ТипСообщенияСЭДО";
		Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы332);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ТипСообщенияСЭДО",
			ТипыСообщений.ТипСообщенияЗапросИсторическихСообщенийЗаДатуАбонентом); // Тип 330.
		Идентификаторы332ДляСоздания = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Идентификатор");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВходящиеСообщенияСЭДОФСС.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ВходящиеСообщенияСЭДОФСС КАК ВходящиеСообщенияСЭДОФСС
		|ГДЕ
		|	ВходящиеСообщенияСЭДОФСС.Идентификатор В(&Идентификаторы)
		|	И ВходящиеСообщенияСЭДОФСС.Новое = ЛОЖЬ
		|	И ВходящиеСообщенияСЭДОФСС.Организация = &Организация";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("Организация", Организация);
	// Идентификаторы уже загруженных сообщений.
	ИдентификаторыНеНовых = Запрос.Выполнить().Выгрузить();
	
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН = ЭтоТипВзаимодействияОрганизацияСЭДО;
	СвойстваОрганизации = СвойстваОрганизацииДляОбмена(Организация,, ПолучитьОГРН);
	РегистрационныйНомерФСС = СвойстваОрганизации.РегистрационныйНомерФСС;
	РегистрационныеНомера = Новый Массив;
	ДобавитьПолучателяСЭДО(ЭтоТипВзаимодействияОрганизацияСЭДО, СвойстваОрганизации, РегистрационныеНомера);
	
	ИмяСобытияЖурналаРегистрации = НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'");
	
	// Добавляем в регистр новые сообщений.
	Для каждого ДанныеСообщения Из ДанныеСообщений Цикл
		
		ИмяСобытияЖурналаРегистрации = НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен СЭДО СФР';
											|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'");
		
		ДанныеСообщения.Тип = ТипСообщенияСЭДОВСтроку(ДанныеСообщения.Тип);
		
		Идентификатор = ДанныеСообщения.Идентификатор;
		Если НЕ ДанныеСообщения.Свойство("Новое") Тогда
			ДанныеСообщения.Вставить("Новое", Ложь);
		КонецЕсли;
		
		Если ТипСообщенияСЭДОВСтроку(ДанныеСообщения.Тип) = ТипСообщенияСоСпискомВходящихСообщений
			И Идентификаторы332ДляСоздания.Найти(Идентификатор) = Неопределено
			И НЕ ДанныеСообщения.Свойство("ТекстСообщения")  Тогда
			// Не создаем сообщения 332 типа, которые предназначены для другой базы.
			Продолжить;
		КонецЕсли;
		
		Если ИдентификаторыНеНовых.Найти(Идентификатор, "Идентификатор") = Неопределено
			ИЛИ ДанныеСообщения.Свойство("ТекстСообщения") Тогда
			
			Получатель = СокрЛП(ДанныеСообщения.Получатель);
			Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
				Если ЭтоТипВзаимодействияОрганизацияСЭДО И ЗначениеЗаполнено(Получатель)
					И СокрЛП(Получатель) <> СокрЛП(СвойстваОрганизации.ОГРН) Тогда
					Шаблон = НСтр("ru = 'ОГРН в данных сервера %1 не соответсвует ОГРН организации %2.';
									|en = 'The registration number in the %1 server data does not match the registration number of the %2 company.'");
					ТекстОшибки = СтрШаблон(Шаблон, Получатель, СвойстваОрганизации.ОГРН);
					ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации,
						УровеньЖурналаРегистрации.Ошибка,,,
						ТекстОшибки);
				КонецЕсли;
				
			ИначеЕсли РегистрационныеНомера.Найти(Получатель) = Неопределено Тогда
				Шаблон = НСтр("ru = 'Регистрационный номер ФСС в данных сообщения %1 не соответствует рег.номеру организации %2.';
								|en = 'SSF registration number in the %1 message data and the registration number of the %2 company mismatch.'");
				Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
				СтрокаРегНомеров = СтрСоединить(РегистрационныеНомера, ", ");
				ТекстОшибки = СтрШаблон(Шаблон, Получатель, СтрокаРегНомеров);
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации,
					УровеньЖурналаРегистрации.Ошибка, , ,
					ТекстОшибки);
			КонецЕсли;
			
			Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
			Запись.Организация = Организация;
			Запись.Идентификатор = Идентификатор;
			Запись.Прочитать();
			Если НЕ Запись.Выбран() Тогда
				Запись.Организация = Организация;
				Запись.Идентификатор = Идентификатор;
			КонецЕсли;
			Запись.Получатель = Получатель;
			Запись.РегистрационныйНомерСФР = ДанныеСообщения.РегистрационныйНомерСФР;
			Запись.ИНН = ДанныеСообщения.ИНН;
			Запись.КПП = ДанныеСообщения.КПП;
			Запись.СНИЛС = ДанныеСообщения.СНИЛС;
			Запись.Тип = ЭлектронныйДокументооборотСФСС.ПривестиТипСообщенияДляРегистраВходящихСообщенийСЭДО(
				ДанныеСообщения.Тип);
			Запись.ТипВзаимодействия = ТипВзаимодействия;
			Запись.ТребуетсяПодтверждение = ДанныеСообщения.ТребуетсяПодтверждение;
			Если ДанныеСообщения.Свойство("СрокДействия") Тогда
				Запись.СрокДействия = ДанныеСообщения.СрокДействия;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Запись.ДатаСоздания) Тогда
				Запись.ДатаСоздания = ТекущаяДатаСеанса();
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Запись.Дата) Тогда
				Запись.Дата = ДанныеСообщения.Дата;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ДанныеСообщения.Дата)
				И ЗначениеЗаполнено(Запись.Дата) Тогда
				// Заполняем дату сообщения из данных записи.
				ДанныеСообщения.Дата = Запись.Дата;
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеСообщения.ИдентификаторЗапроса)
				И НЕ ЗначениеЗаполнено(Запись.ИдентификаторЗапроса) Тогда
				Запись.ИдентификаторЗапроса = ДанныеСообщения.ИдентификаторЗапроса;
			КонецЕсли;
			Если ДанныеСообщения.Свойство("ТекстСообщения") Тогда
				Если НЕ ЗначениеЗаполнено(Запись.Дата) Тогда
					// Сообщения 332 типа могут загружаться по идентификатору, дата может быть не заполнена.
					Запись.Дата = ТекущаяДатаСеанса();
				КонецЕсли;
				// Был получен текст сообщения.
				Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
				Запись.Содержимое = Новый ХранилищеЗначения(
					ДанныеСообщения.ТекстСообщения,
					Новый СжатиеДанных(9));
				// Снимаем признак нового сообщения если получено содержимое.
				Запись.Новое = Ложь;
				ДанныеСообщения.Новое = Ложь;
				// Вызов предопределенного метода обработки содержимого сообщения.
				ОписаниеОшибки = "";
				Попытка
					// Вызов предопределенного метода.
					РезультатОбработки =
						ЭлектронныйДокументооборотСФСС.ПриПолученииСодержимогоСообщенияСЭДО(Организация, ДанныеСообщения);
					Если РезультатОбработки.ОшибкаОбработки Тогда
						Результат.БылиОшибкиОбработки = Истина;
						ОписаниеОшибки = РезультатОбработки.ОписаниеОшибки;
						Результат.ОшибкиОбработки.Добавить(ОписаниеОшибки);
					КонецЕсли;
				Исключение
					Запись.Новое = Истина;
					Шаблон = НСтр("ru = 'При обработке данных сообщения СЭДО %1 типа %2 организации %3';
									|en = 'An error occurred when processing data of the %1 EDI message with the %2 type of the %3 company'")
						+ " " + НСтр("ru = 'обнаружена незакрытая транзакция.';
									|en = 'an open transaction is found.'");
					ОписаниеОшибкиОТранзакции = СтрШаблон(Шаблон, Идентификатор, ДанныеСообщения.Тип, Организация);
					// Могла остаться незакрытая транзакция после вызова переопределяемого метода.
					ПроверитьНезакрытуюТранзакцию(ИмяСобытияЖурналаРегистрации, ОписаниеОшибкиОТранзакции);
					ИнформацияОбОшибке = ИнформацияОбОшибке();
					Шаблон = НСтр("ru = 'Ошибка при обработке данных сообщения СЭДО типа %1:';
									|en = 'An error occurred when processing data of the EDI message with the %1 type:'");
					ОписаниеСообщения = СтрШаблон(Шаблон, ДанныеСообщения.Тип);
					ОписаниеОшибки = ОписаниеСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
					Результат.БылиОшибкиОбработки = Истина;
					Результат.ОшибкиОбработки.Добавить(ОписаниеОшибки);
					// Запись в журнал.
					Шаблон = НСтр("ru = 'Ошибка при обработке данных сообщения СЭДО %1 типа %2 организации %3:';
									|en = 'An error occurred when processing data of the %1 EDI message with the %2 type of the company %3:'");
					ОписаниеСообщения = СтрШаблон(Шаблон, Идентификатор, ДанныеСообщения.Тип, Организация);
					ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
					ЗаписьЖурналаРегистрации(
						ИмяСобытияЖурналаРегистрации,
						УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиЖурнал);
				КонецПопытки;
				Если НЕ ПустаяСтрока(ОписаниеОшибки) Тогда
					// Сохраняем ошибку обработки в регистре.
					Запись.ОшибкаОбработкиСообщения = ОписаниеОшибки;
				Иначе
					Запись.ОшибкаОбработкиСообщения = "";
				КонецЕсли;
			Иначе
				// Сохраняем метаданные сообщения с признаком Новое.
				Запись.Новое = Истина;
				Если НЕ ЗначениеЗаполнено(Запись.ДатаСоздания) Тогда
					Запись.ДатаСоздания = ТекущаяДатаСеанса();
				КонецЕсли;
				ДанныеСообщения.Новое = Истина;
			КонецЕсли;
			
			Запись.ОбменЧерезОператора = НЕ ОбменПоСЭДОНапрямую;
			
			Если НЕ ПустаяСтрока(ДанныеСообщения.Комментарий) Тогда
				Запись.Комментарий = ДанныеСообщения.Комментарий;
			КонецЕсли;
			
			Шаблон = НСтр("ru = 'При обработке данных сообщения СЭДО %1 типа %2 организации %3';
							|en = 'An error occurred when processing data of the %1 EDI message with the %2 type of the %3 company'")
				+ " " + НСтр("ru = 'обнаружена незакрытая транзакция.';
							|en = 'an open transaction is found.'");
			ОписаниеОшибкиОТранзакции = СтрШаблон(Шаблон, Идентификатор, ДанныеСообщения.Тип, Организация);
			// Могла остаться незакрытая транзакция после вызова переопределяемого метода.
			БылаНезакрытаяТранзакция = ПроверитьНезакрытуюТранзакцию(
				ИмяСобытияЖурналаРегистрации, ОписаниеОшибкиОТранзакции);
			Если БылаНезакрытаяТранзакция Тогда
				Запись.ОшибкаОбработкиСообщения = ОписаниеОшибкиОТранзакции;
				Результат.БылиОшибкиОбработки = Истина;
				Результат.ОшибкиОбработки.Добавить(ОписаниеОшибкиОТранзакции);
				Запись.Новое = Истина;
			КонецЕсли;
			
			Попытка
				Запись.Записать();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Шаблон = НСтр("ru = 'Ошибка при сохранении данных сообщения СЭДО типа %1:';
								|en = 'An error occurred when saving data of the EDI message with the %1 type:'");
				ОписаниеСообщения = СтрШаблон(Шаблон, ДанныеСообщения.Тип);
				ОписаниеОшибки = ОписаниеСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
				Результат.БылиОшибкиОбработки = Истина;
				Результат.ОшибкиОбработки.Добавить(ОписаниеОшибки);
				// Запись в журнал.
				Шаблон = НСтр("ru = 'Ошибка при сохранении данных сообщения СЭДО %1 типа %2 организации %3:';
								|en = 'An error occurred when saving data of the %1 EDI message with the %2 type of the company %3:'");
				ОписаниеСообщения = СтрШаблон(Шаблон, Идентификатор, ДанныеСообщения.Тип, Организация);
				ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖурналаРегистрации,
					УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиЖурнал);
			КонецПопытки;
			
		КонецЕсли;
	КонецЦикла;
	
	НовыеСообщения = Новый Массив;
	ПустаяДата = Дата(1, 1, 1);
	МаксимальнаяДата = ПустаяДата;
	ИдентификаторЗапросаМаксимальнаяДата = "";
	Для каждого Сообщение Из ДанныеСообщений Цикл
		Если Сообщение.Дата > МаксимальнаяДата Тогда
			МаксимальнаяДата = Сообщение.Дата;
			ИдентификаторЗапросаМаксимальнаяДата = ДанныеСообщения.ИдентификаторЗапроса;
		КонецЕсли;
		Если Сообщение.Новое Тогда
			НовыеСообщения.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	
	// Сохраняем данные события получения самого свежего сообщения.
	Попытка
		
		Если НЕ МаксимальнаяДата = ПустаяДата Тогда
			ДанныеСобытия = ЭлектронныйДокументооборотСФСС.НовыеДанныеСобытияСЭДО();
			ДанныеСобытия.Событие = Перечисления.СобытияОбменаСЭДО.ПолучениеИдентификатораВходящегоСообщения;
			ДанныеСобытия.Организация = Организация;
			ДанныеСобытия.ОбменЧерезОператора = НЕ ОбменПоСЭДОНапрямую;
			ДанныеСобытия.ДатаСобытия = МаксимальнаяДата;
			ДанныеСобытия.СохранятьЕслиДатаМаксимальная = Истина;
			ДанныеСобытия.ВызватьИсключениеПриОшибкеЗаписи = Истина;
			ДанныеСобытия.ИдентификаторЗапроса = ИдентификаторЗапросаМаксимальнаяДата;
			ЭлектронныйДокументооборотСФСС.СохранитьДанныеСобытияСЭДО(ДанныеСобытия);
		КонецЕсли;
		
	Исключение
		Шаблон = НСтр("ru = 'При обработке списка новых сообщений СЭДО организации %1';
						|en = 'When processing the list of new EDI messages for the %1 company'")
			+ " " + НСтр("ru = 'обнаружена незакрытая транзакция.';
						|en = 'an open transaction is found.'");
		ОписаниеОшибкиОТранзакции = СтрШаблон(Шаблон, Организация);
		ПроверитьНезакрытуюТранзакцию(ИмяСобытияЖурналаРегистрации, ОписаниеОшибкиОТранзакции);
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеСообщения = НСтр("ru = 'Ошибка при обработке списка новых сообщений СЭДО:';
								|en = 'An error occurred when processing the list of new EDI messages:'");
		ОписаниеОшибки = ОписаниеСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Результат.БылиОшибкиОбработки = Истина;
		Результат.ОшибкиОбработки.Добавить(ОписаниеОшибки);
		// Запись в журнал.
		Шаблон = НСтр("ru = 'Ошибка при обработке списка новых сообщения СЭДО по организации %1:';
						|en = 'An error occurred when processing the list of new EDI messages for the %1 company:'");
		ОписаниеСообщения = СтрШаблон(Шаблон, Организация);
		ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации,
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиЖурнал);
	КонецПопытки;
	
	// Обработка новых сообщений.
	Если НовыеСообщения.Количество() > 0 Тогда
		Попытка
			Обработанные = ЭлектронныйДокументооборотСФСС.
				ПриПолученииСпискаНовыхСообщенийСЭДО(Организация, НовыеСообщения);
		Исключение
			Шаблон = НСтр("ru = 'При обработке списка новых сообщений СЭДО организации %1';
							|en = 'When processing the list of new EDI messages for the %1 company'")
				+ " " + НСтр("ru = 'обнаружена незакрытая транзакция.';
							|en = 'an open transaction is found.'");
			ОписаниеОшибкиОТранзакции = СтрШаблон(Шаблон, Организация);
			ПроверитьНезакрытуюТранзакцию(ИмяСобытияЖурналаРегистрации, ОписаниеОшибкиОТранзакции);
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОписаниеСообщения = НСтр("ru = 'Ошибка при обработке списка новых сообщений СЭДО:';
									|en = 'An error occurred when processing the list of new EDI messages:'");
			ОписаниеОшибки = ОписаниеСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			Результат.БылиОшибкиОбработки = Истина;
			Результат.ОшибкиОбработки.Добавить(ОписаниеОшибки);
			// Запись в журнал.
			Шаблон = НСтр("ru = 'Ошибка при обработке списка новых сообщения СЭДО по организации %1:';
							|en = 'An error occurred when processing the list of new EDI messages for the %1 company:'");
			ОписаниеСообщения = СтрШаблон(Шаблон, Организация);
			ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурналаРегистрации,
				УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибкиЖурнал);
		КонецПопытки;
	КонецЕсли;
	
	Результат.НовыеСообщения = НовыеСообщения;
	Результат.ДанныеСообщений = ДанныеСообщений;
	
	Возврат Результат;
	
КонецФункции

Функция ТипСообщенияСЭДОВЧисло(Знач ТипСообщенияСЭДО, Суффикс = "")
	
	Возврат ЭлектронныйДокументооборотСФСС.ТипСообщенияСЭДОВЧисло(ТипСообщенияСЭДО, Суффикс);
	
КонецФункции

Функция ТипСообщенияСЭДОВСтроку(Знач ТипСообщенияСЭДО)
	
	Возврат ЭлектронныйДокументооборотСФССКлиентСервер.ТипСообщенияСЭДОВСтроку(ТипСообщенияСЭДО);
	
КонецФункции

Процедура СохранитьДанныеРассылокСЭДОФСС(
		Организация,
		ДанныеСообщений,
		ОбменПоСЭДОНапрямую = Истина) Экспорт
		
	ИмяСобытияЖурналаРегистрации = НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'");
	
	Для каждого ДанныеСообщения Из ДанныеСообщений Цикл
		
		ЗаписатьСодержимоеРассылкиВРегистр(
			Организация,
			ДанныеСообщения,
			ОбменПоСЭДОНапрямую,
			ИмяСобытияЖурналаРегистрации);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьСодержимоеРассылкиВРегистр(
	Организация,
	ДанныеСообщения,
	ОбменПоСЭДОНапрямую,
	ИмяСобытияЖурналаРегистрации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СодержимоеСообщений.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.СодержимоеРассылокКонтролирующихОрганов КАК СодержимоеСообщений
	|ГДЕ
	|	СодержимоеСообщений.Идентификатор = &Идентификатор
	|	И СодержимоеСообщений.Тип = &Тип";
	Запрос.УстановитьПараметр("Идентификатор", ДанныеСообщения.Идентификатор);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаССФР);
	
	НоваяРассылка = Истина;
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		НоваяРассылка = Ложь;
	КонецЕсли;
	
	Идентификатор = ДанныеСообщения.Идентификатор;
	
	ТекстСообщения = ДанныеСообщения.ТекстСообщения;
	Если НЕ ДанныеСообщения.АктуальноДоДаты = Неопределено Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС
			+ НСтр("ru = 'Информация актуальна до даты: ';
					|en = 'The information is relevant up to:'")
			+ Формат(ДанныеСообщения.АктуальноДоДаты, "ДЛФ=DD");
	КонецЕсли;
		
	Запись						= РегистрыСведений.СодержимоеРассылокКонтролирующихОрганов.СоздатьМенеджерЗаписи();
	Запись.Идентификатор		= Идентификатор;
	Запись.Тип					= Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаССФР;
	Запись.Содержание			= Новый ХранилищеЗначения(ТекстСообщения, Новый СжатиеДанных(9));
	Запись.ОбменЧерезОператора	= НЕ ОбменПоСЭДОНапрямую;
	Запись.АктуальноДоДаты 		= ДанныеСообщения.АктуальноДоДаты;
	
	// Вызов предопределенного метода обработки содержимого сообщения.
	ОписаниеОшибки = "";
	Попытка
		// Вызов предопределенного метода.
		РезультатОбработки = ПриПолученииСодержимогоРассылкиСЭДО(Организация, ДанныеСообщения);
		
		// Вызываем переопределяемый метод.
		ЭлектронныйДокументооборотСФССПереопределяемый.ПослеПолученияСодержимогоРассылкиСЭДО(
			Организация,
			ДанныеСообщения,
			РезультатОбработки);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеСообщения = НСтр("ru = 'Ошибка при обработке данных рассылки СЭДО СФР:';
								|en = 'An error occurred when processing data of EDI mailout from Social Insurance Fund of Russia:'");
		ОписаниеОшибки = ОписаниеСообщения + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		// Запись в журнал.
		Шаблон = НСтр("ru = 'Ошибка при обработке данных рассылки СЭДО СФР %1 организации %2:';
						|en = 'An error occurred when processing data of EDI mailout from Social Insurance Fund of Russia %1 of %2:'");
		ОписаниеСообщения = СтрШаблон(Шаблон, Идентификатор, Организация);
		ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОписаниеОшибкиЖурнал);
	КонецПопытки;
	Если НЕ ПустаяСтрока(ОписаниеОшибки) Тогда
		// Сохраняем ошибку обработки в регистре.
		Запись.ОшибкаОбработкиСообщения = ОписаниеОшибки;
	Иначе
		Запись.ОшибкаОбработкиСообщения = "";
	КонецЕсли;
	
	Если НоваяРассылка Тогда
		Попытка
			Запись.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОписаниеСообщения = НСтр("ru = 'Ошибка при сохранении данных рассылки СЭДО СФР:';
									|en = 'An error occurred when saving data of EDI mailout from Social Insurance Fund of Russia:'");
			// Запись в журнал.
			Шаблон = НСтр("ru = 'Ошибка при сохранении данных сообщения СЭДО %1 типа %2 организации %3:';
							|en = 'An error occurred when saving data of the %1 EDI message with the %2 type of the company %3:'");
			ОписаниеСообщения = СтрШаблон(Шаблон, Идентификатор, ДанныеСообщения.Тип, Организация);
			ОписаниеОшибкиЖурнал = ОписаниеСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурналаРегистрации,
				УровеньЖурналаРегистрации.Ошибка, , ,
				ОписаниеОшибкиЖурнал);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьНезакрытуюТранзакцию(ИмяСобытия, ОписаниеОшибкиЖурнал)
	
	Результат = Ложь;
	Если ТранзакцияАктивна() Тогда
		Результат = Истина;
		Пока ТранзакцияАктивна() Цикл
			// Отменяем транзакцию чтобы не возникала ошибка при последующем обращении к БД.
			ОтменитьТранзакцию(); // АПК:325 Отмена незакрытых транзакций.
		КонецЦикла;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОписаниеОшибкиЖурнал);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьРезультатОбработкиВходящихСообщенийСЭДОФСС(
	Организация,
	ОшибкиОбработки) Экспорт
	
	Для каждого ДанныеСообщения Из ОшибкиОбработки Цикл
		НаборЗаписей = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Идентификатор.Установить(ДанныеСообщения.ИдентификаторСообщения);
		НаборЗаписей.Прочитать();
		Для каждого Запись из НаборЗаписей Цикл
			Запись.Новое = Ложь;
			Запись.ОшибкаОбработкиСообщения = ДанныеСообщения.ОписаниеОшибки;
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		Ключ,
		Запрос,
		ВыражениеУсловия,
		ПреобразоватьЗначениеВМассив = Истина,
		ИндексПакета = 0,
		ИндексОператора = 0)
		
	ЗначениеПараметра = Неопределено;
	Если Отбор <> Неопределено Тогда
		Отбор.Свойство(Ключ, ЗначениеПараметра);
	КонецЕсли;
	ПоВсем = (Отбор = Неопределено ИЛИ ЗначениеПараметра = Неопределено);
	
	Если ПоВсем Тогда
		Возврат;
	КонецЕсли;
		
	// Добавляем условие запроса.
	Схема = Новый СхемаЗапроса;
	Схема.УстановитьТекстЗапроса(Запрос.Текст);
	ОтборЗапроса = Схема.ПакетЗапросов[ИндексПакета].Операторы[ИндексОператора].Отбор;
	ОтборЗапроса.Добавить(ВыражениеУсловия);
	
	ТекстЗапроса = Схема.ПолучитьТекстЗапроса();
	Запрос.Текст = ТекстЗапроса;
	
	// Устанавливаем параметр запроса.
	Если ПреобразоватьЗначениеВМассив Тогда
		ЗначениеПараметра = ЗначениеВКоллекцию(ЗначениеПараметра);
	КонецЕсли;
	Запрос.УстановитьПараметр(Ключ, ЗначениеПараметра);
		
КонецПроцедуры

Процедура ДобавитьНаборФильтровПоСообщениямСЭДОФСС(Отбор, Запрос)
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"Организация",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.Организация В (&Организация)");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"Получатель",
		Запрос,
		"(ВходящиеСообщенияСЭДОФСС.Получатель В (&Получатель) ИЛИ ВходящиеСообщенияСЭДОФСС.РегистрационныйНомерСФР В (&Получатель))");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"Тип",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.Тип В (&Тип)");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"ТребуетсяПодтверждение",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.ТребуетсяПодтверждение В (&ТребуетсяПодтверждение)");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"Новое",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.Новое В (&Новое)");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"Идентификатор",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.Идентификатор В (&Идентификатор)");
	
	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"ТипВзаимодействия",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.ТипВзаимодействия В (&ТипВзаимодействия)");

	УстановитьУсловиеИПараметрЗапросаИзОтбора(Отбор,
		"МинимальнаяДата",
		Запрос,
		"ВходящиеСообщенияСЭДОФСС.Дата >= &МинимальнаяДата",
		Ложь);
		
КонецПроцедуры

// Возвращает данный входящих сообщений СЭДО.
Функция СообщенияСЭДОФСС(Отбор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВходящиеСообщенияСЭДОФСС.Идентификатор КАК Идентификатор,
	|	ВходящиеСообщенияСЭДОФСС.Организация КАК Организация,
	|	ВходящиеСообщенияСЭДОФСС.Тип КАК Тип,
	|	ВходящиеСообщенияСЭДОФСС.Получатель КАК Получатель,
	|	ВходящиеСообщенияСЭДОФСС.ТребуетсяПодтверждение КАК ТребуетсяПодтверждение,
	|	ВходящиеСообщенияСЭДОФСС.Содержимое КАК Содержимое,
	|	ВходящиеСообщенияСЭДОФСС.Новое КАК Новое,
	|	ВходящиеСообщенияСЭДОФСС.Дата КАК Дата,
	|	ВходящиеСообщенияСЭДОФСС.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ВходящиеСообщенияСЭДОФСС.ДатаОтправкиПодтверждения КАК ДатаОтправкиПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаПолученияИзвещенияОПолученииПодтверждения КАК ДатаПолученияИзвещенияОПолученииПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаПолученияОшибкиПодтверждения КАК ДатаПолученияОшибкиПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаСоздания КАК ДатаСоздания,
	|	ВходящиеСообщенияСЭДОФСС.ОшибкаОбработкиСообщения КАК ОшибкаОбработкиСообщения,
	|	ВходящиеСообщенияСЭДОФСС.ОшибкаПодтверждения КАК ОшибкаПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ПодтверждениеОтправлено КАК ПодтверждениеОтправлено,
	|	ВходящиеСообщенияСЭДОФСС.СрокДействия КАК СрокДействия,
	|	ВходящиеСообщенияСЭДОФСС.ТипВзаимодействия КАК ТипВзаимодействия,
	|	ВходящиеСообщенияСЭДОФСС.ИНН КАК ИНН,
	|	ВходящиеСообщенияСЭДОФСС.КПП КАК КПП,
	|	ВходящиеСообщенияСЭДОФСС.СНИЛС КАК СНИЛС,
	|	ВходящиеСообщенияСЭДОФСС.РегистрационныйНомерСФР КАК РегистрационныйНомерСФР
	|ИЗ
	|	РегистрСведений.ВходящиеСообщенияСЭДОФСС КАК ВходящиеСообщенияСЭДОФСС
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	ДатаСоздания";
	
	ДобавитьНаборФильтровПоСообщениямСЭДОФСС(Отбор, Запрос);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		ТипВзаимодействияПоУмолчанию = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
		Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаРезультата.ТипВзаимодействия) Тогда
				СтрокаРезультата.ТипВзаимодействия = ТипВзаимодействияПоУмолчанию;
			КонецЕсли;
			СтрокаРезультата.Тип = ТипСообщенияСЭДОВСтроку(
				СтрокаРезультата.Тип);
		КонецЦикла;
	КонецЕсли;
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ДобавитьПолучателяСЭДО(ЭтоТипВзаимодействияОрганизацияСЭДО, СвойстваОрганизации, Получатели)

	Если ЭтоТипВзаимодействияОрганизацияСЭДО Тогда
		Получатели.Добавить(СвойстваОрганизации.ОГРН);
	Иначе
		Если СвойстваОрганизации.ЭтоРегистрационныйНомерСФР Тогда
			Если ЗначениеЗаполнено(СвойстваОрганизации.РегНомерФСС) Тогда
				Получатели.Добавить(СвойстваОрганизации.РегНомерСФР);
				Получатели.Добавить(СвойстваОрганизации.РегНомерФСС);
			Иначе
				// У организации нет рег.номера ФСС.
				Получатели.Добавить(СвойстваОрганизации.РегНомерСФР);
			КонецЕсли;
		Иначе
			Получатели.Добавить(СвойстваОрганизации.РегНомерФСС);
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

Функция НовыеСообщенияСЭДОФСС(Организация,
				Знач Отбор = Неопределено,
				Знач ТипВзаимодействия = Неопределено,
				Знач МинимальнаяДата = Неопределено) Экспорт
	
	Если ТипВзаимодействия = Неопределено Тогда
		ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСтраховательСЭДО();
	КонецЕсли;
	
	ЭтоТипВзаимодействияОрганизацияСЭДО =
		(ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияОрганизацияСЭДО());
	ПолучитьОГРН = ЭтоТипВзаимодействияОрганизацияСЭДО;
	
	Если Отбор = Неопределено Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Организация);
	КонецЕсли;
	
	Отбор.Вставить("Новое", Истина);
	
	// Отбор по рег.номеру ФСС/ОГРН добавляется, чтобы отсечь сообщения, полученные для
	// другого рег.номера/ОГРН, например, при смене рег.номера/ОГРН в справочнике организаций.
	Получатели = Новый Массив;
	Если ТипЗнч(Отбор.Организация) = Тип("Массив") Тогда
		РегистрационныйНомерФССИлиОГРН = Новый Массив;
		Для каждого ОрганизацияОтбора Из Отбор.Организация Цикл
			СвойстваОрганизации = СвойстваОрганизацииДляОбмена(ОрганизацияОтбора,, ПолучитьОГРН);
			ДобавитьПолучателяСЭДО(ЭтоТипВзаимодействияОрганизацияСЭДО, СвойстваОрганизации, Получатели);
		КонецЦикла;
	Иначе
		СвойстваОрганизации = СвойстваОрганизацииДляОбмена(Отбор.Организация,, ПолучитьОГРН);
		ДобавитьПолучателяСЭДО(ЭтоТипВзаимодействияОрганизацияСЭДО, СвойстваОрганизации, Получатели);
	КонецЕсли;
	Отбор.Вставить("Получатель", Получатели);
	
	Если НЕ МинимальнаяДата = Неопределено Тогда
		Отбор.Вставить("МинимальнаяДата", МинимальнаяДата);
	Иначе
		ТриМесяцаНазад = ТекущаяДатаСеанса() - 24 * 3600 * 90;
		Отбор.Вставить("МинимальнаяДата", ТриМесяцаНазад);
	КонецЕсли;
	
	Сообщения = СообщенияСЭДОФСС(Отбор);
	
	// Удаляем из новых сообщения 332 типа старше недели, так как они удаляются с сервера СЭДО.
	// При попытке получить эти сообщения возникает ошибка "Указанное сообщение не найдено".
	// Такая же ошибка возникает если загружаются сообщения оператора при обмене напрямую.
	СвойстваОбменаПоСЭДОЧерезОператора =
		ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(Организация);
	ОбменПоСЭДОНапрямую = СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую;
	Неделя = 3600 * 24 * 7;
	СтрокиДляУдаления = Новый Массив;
	ИдентификаторыДляСнятияПометкиНовое = Новый Массив;
	МосковскоеВремяНеделюНазад = ЭлектронныйДокументооборотСФСС.МосковскоеВремя() - Неделя;
	ДатаЗапускаОператорнойСхемы = Дата(2023, 11, 1);
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	ТипыСообщенийОператора = ТипыСообщенийОператораСЭДО();
	Тип332 = ТипыСообщений.ТипСообщенияОтветНаЗапросИсторическихДанных;
	Для каждого Сообщение Из Сообщения Цикл
		// Проверка сообщений с типом 332.
		ТипСообщения = ТипСообщенияСЭДОВСтроку(Сообщение.Тип);
		Если ТипСообщения = Тип332
			И ((ОбменПоСЭДОНапрямую И Сообщение.Дата < МосковскоеВремяНеделюНазад)
				ИЛИ (НЕ ОбменПоСЭДОНапрямую И Сообщение.Дата < ДатаЗапускаОператорнойСхемы)) Тогда
			СтрокиДляУдаления.Добавить(Сообщение);
			ИдентификаторыДляСнятияПометкиНовое.Добавить(Сообщение.Идентификатор);
		КонецЕсли;
		// Проверка сообщений оператора, они не должны загружаться,
		// если пользователь переключился на обмен напрямую.
		Если ОбменПоСЭДОНапрямую И
			НЕ ТипыСообщенийОператора.Найти(ТипСообщения) = Неопределено Тогда
			СтрокиДляУдаления.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	Для каждого Строка Из СтрокиДляУдаления Цикл
		Сообщения.Удалить(Строка);
	КонецЦикла;
	Если ИдентификаторыДляСнятияПометкиНовое.Количество() > 0 Тогда
		СнятьОтметкуНовоеССообщенийСЭДО(ИдентификаторыДляСнятияПометкиНовое);
	КонецЕсли;
	
	Возврат Сообщения;
	
КонецФункции

Функция ТипыСообщенийОператораСЭДО()
	
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	Результат = Новый Массив;
	Результат.Добавить(ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный);
	Результат.Добавить(ТипыСообщений.ТипСообщенияРезультатПодпискиСнятияПодпискиАбонентовОтОперавтора);
	Результат.Добавить(ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР);
	Результат.Добавить(ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором);
	
	Возврат Результат;
	
КонецФункции

Процедура СнятьОтметкуНовоеССообщенийСЭДО(Идентификаторы) Экспорт
	
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки = Новый Массив;
	Для каждого Идентификатор Из Идентификаторы Цикл
		НаборЗаписей = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
		НаборЗаписей.Прочитать();
		Для каждого Запись из НаборЗаписей Цикл
			Запись.Новое = Ложь;
		КонецЦикла;
		Попытка
			НаборЗаписей.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОписаниеОшибки = НСтр("ru = 'Ошибка при снятия отметки Новое с сообщения СЭДО %1:';
									|en = 'An error occurred when removing the New mark from the %1 EDI message:'")
				+ " " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Идентификатор);
			Ошибки.Добавить(ОписаниеОшибки);
		КонецПопытки;
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		ТекстОшибок = СтрСоединить(Ошибки);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибок);
		ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстОшибок, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры

Функция ТребуетсяЗапускРегламентногоЗаданияОбменаСФСС(Организации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ТребуетсяЗапуск = СтрахователиПодключеныКОбменуССФР(Организации);
	УстановитьПривилегированныйРежим(Ложь);
	Если НЕ ТребуетсяЗапуск Тогда
		ЭлектронныйДокументооборотСФССПереопределяемый.
			ПроверитьНеобходимостьЗапускаРегламентногоЗадания(Организации, ТребуетсяЗапуск);
	КонецЕсли;
	Возврат ТребуетсяЗапуск;
	
КонецФункции

Функция СерверОбменаСообщениямиСЭДОФСС(ИспользоватьТестовыйСервер, ОбменПоСЭДОНапрямую = Истина)
	
	Результат = Новый Структура;
	
	Если ОбменПоСЭДОНапрямую Тогда
		Если НЕ ИспользоватьТестовыйСервер Тогда
			Результат.Вставить("Определение", "https://ecp.sfr.gov.ru/sedo/soap/SedoGateway?wsdl");
		Иначе
			Результат.Вставить("Определение", "https://ecp-test.sfr.gov.ru/sedo/fss/api/soap/SedoGateway?wsdl");
		КонецЕсли;
	Иначе
		Если НЕ ИспользоватьТестовыйСервер Тогда
			Результат.Вставить("Определение", "https://sedo.keydisk.ru/SedoGateway/");
		Иначе
			Результат.Вставить("Определение", "https://sedo-ecp.cloud.astral-dev.ru/SedoGateway?wsdl");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтраховательПодписанНаУведомленияПоЭЛН(ОрганизацияСсылка) Экспорт
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(ОрганизацияСсылка);
	Возврат ОтпечаткиСертификатов <> Неопределено
		И ОтпечаткиСертификатов.СтраховательПодписанНаУведомленияПоЭЛН = Истина;
	
КонецФункции

Функция ИспользоватьТестовыйСерверСЭДОФСС(ОрганизацияСсылка)
	
	Возврат ИспользоватьТестовыйСерверФССЭЛН(ОрганизацияСсылка);
	
КонецФункции

Функция ОтправитьЗапросСервисуСЭДОФССФоновое(ПараметрыФункции) Экспорт
	
	ТекстЗашифрованногоЗапросаSOAP 	= ПараметрыФункции.ТекстЗашифрованногоЗапросаSOAP;
	ОбменПоСЭДОНапрямую 			= ПараметрыФункции.ОбменПоСЭДОНапрямую;
	АдресЗашифрованногоЗапросаSOAP = ПоместитьВоВременноеХранилище(ТекстЗашифрованногоЗапросаSOAP, Новый УникальныйИдентификатор);
	Результат = ОтправитьЗапросСервисуСЭДОФСС(
		ПараметрыФункции.Организация,
		ПараметрыФункции.Операция,
		АдресЗашифрованногоЗапросаSOAP,
		ОбменПоСЭДОНапрямую);
		
	// Добавляем к результату содержимое ответа.
	Результат.Вставить("ТекстЗашифрованногоОтветаSOAP", "");
	Результат.Вставить("ДвоичныеДанныеЗашифрованногоОтветаSOAP", Неопределено);
	Если ЭтоАдресВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAP) Тогда
		ДанныеИзХранилища = ПолучитьИзВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAP);
		Результат.ТекстЗашифрованногоОтветаSOAP = ДанныеИзХранилища;
		УдалитьИзВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAP);
	КонецЕсли;
	Если ЭтоАдресВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAPДвоичныеДанные) Тогда
		ДанныеИзХранилища = ПолучитьИзВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAPДвоичныеДанные);
		Результат.ДвоичныеДанныеЗашифрованногоОтветаSOAP = ДанныеИзХранилища;
		УдалитьИзВременногоХранилища(Результат.АдресЗашифрованногоОтветаSOAPДвоичныеДанные);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьОпределениеСервисаСЭДО(Определение)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресСервера", "");
	Результат.Вставить("АдресРесурса", "");
	
	ПозицияЗавершенияСхемы = СтрНайти(Определение, "://");
	Если ПозицияЗавершенияСхемы > 0 Тогда
		СтрокаURI = Сред(Определение, ПозицияЗавершенияСхемы + 3);
		ПозицияЗавершенияСоединения = СтрНайти(СтрокаURI, "/");
		ДлинаСоединения = ?(ПозицияЗавершенияСоединения > 0, ПозицияЗавершенияСоединения - 1, СтрДлина(СтрокаURI));
		АдресРесурса = Сред(Определение, ПозицияЗавершенияСхемы + 3 + ДлинаСоединения);
		Результат.АдресСервера = Лев(Определение, ПозицияЗавершенияСхемы + 2 + ДлинаСоединения);
		
		ПозицияПараметров = СтрНайти(АдресРесурса, "?");
		ДлинаРесурсаНаСервере = ?(ПозицияПараметров > 0, ПозицияПараметров - 1, СтрДлина(АдресРесурса));
		Результат.АдресРесурса = Лев(АдресРесурса, ДлинаРесурсаНаСервере);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьЗапросСервисуСЭДОФСС(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP,
		ОбменПоСЭДОНапрямую = Неопределено,
		ДополнительныеПараметры = Неопределено) Экспорт
		
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("АдресЗашифрованногоОтветаSOAP", Неопределено);
	Результат.Вставить("АдресЗашифрованногоОтветаSOAPДвоичныеДанные", Неопределено);
	Результат.Вставить("ОшибкаСоединения", Ложь);
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("АдресРесурса", "");
	Результат.Вставить("АдресСервера", "");
	Результат.Вставить("ТребуетсяРасшифровкаОтвета", Ложь);
	Результат.Вставить("ВозниклаБлокировкаИзЗаЧастыхЗапросов", Ложь);
	Результат.Вставить("ОсталосьВремениБлокировки", 0);
	
	Если ОбменПоСЭДОНапрямую = Неопределено Тогда
		ОбменПоСЭДОНапрямую =
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(
				Организация).ОбменПоСЭДОНапрямую;
	КонецЕсли;
	
	ИспользоватьТестовыйСервер = ИспользоватьТестовыйСерверСЭДОФСС(Организация);
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = НовыеПараметрыОтправитьЗапросСервисуСЭДОФСС();
	КонецЕсли;
	
	Если НЕ ДополнительныеПараметры.ТребуетсяПеренаправление Тогда
		НастройкиWS = СерверОбменаСообщениямиСЭДОФСС(ИспользоватьТестовыйСервер, ОбменПоСЭДОНапрямую);
		Если НастройкиWS = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		НастройкиWS = Новый Структура;
		НастройкиWS.Вставить("Определение", ДополнительныеПараметры.АдресДляПеренаправления);
	КонецЕсли;
	
	Если СтрНайти(Операция, "#") > 0 Тогда
		МассивСтрок = СтрЗаменить(Операция, "#", Символы.ПС);
		Операция = СтрПолучитьСтроку(МассивСтрок, 1);
		НомерПопыткиСоединения = Число(СтрПолучитьСтроку(МассивСтрок, 2));
	Иначе
		НомерПопыткиСоединения = 1;
	КонецЕсли;
	
	ТекстЗашифрованногоЗапросаSOAP = ПолучитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
	
	РезультатРазбора = РазобратьОпределениеСервисаСЭДО(НастройкиWS.Определение);
	АдресСервера = РезультатРазбора.АдресСервера;
	АдресРесурса = РезультатРазбора.АдресРесурса;
	Результат.АдресРесурса = АдресРесурса;
	Результат.АдресСервера = АдресСервера;
	
	ОписаниеОшибкиУстановкиСоединения = "";
	Таймаут = 300;
	СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(
		АдресСервера,
		ОписаниеОшибкиУстановкиСоединения,
		Таймаут);
	Если СоединениеHTTP = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сервером %1:';
							|en = 'Cannot connect to the %1 server:'")
			+ Символы.ПС + "%2";
		ТекстОшибки = СтрШаблон(
			ТекстОшибки,
			АдресСервера,
			ОписаниеОшибкиУстановкиСоединения);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.ОшибкаСоединения = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Шаблон = """http://www.fss.ru/integration/ws/gateway/sedo/%1/v01""";
	ОперацияSOAP = СтрШаблон(Шаблон, Операция);
	
	// Формируем заголовки запроса SOAP.
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/xml; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("Proxy-Connection", "Keep-Alive");
	HTTPЗапрос.Заголовки.Вставить("SOAPAction", ОперацияSOAP);
	Если НЕ ОбменПоСЭДОНапрямую Тогда
		ОписаниеПриложения = "";
		ОписаниеПриложения = ДокументооборотСКОПовтИсп.ОписаниеКлиентскогоПриложенияДляСЭДО();
		Если НЕ ПустаяСтрока(ОписаниеПриложения) Тогда
			HTTPЗапрос.Заголовки.Вставить("User-Agent", ОписаниеПриложения);
		КонецЕсли;
	КонецЕсли;
	
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстЗашифрованногоЗапросаSOAP);
	
	// Посылаем запрос.
	Попытка
		Ответ = СоединениеHTTP.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибкиОтправки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Шаблон = ?(ОбменПоСЭДОНапрямую,
			НСтр("ru = 'Не удалось обратиться к серверу СЭДО ФСС (%1): %2. Возможно, сервер перегружен. Попробуйте повторить запрос через некоторое время.';
				|en = 'Cannot contact SSF EDI server (%1): %2. The server may be overloaded. Try again after some time.'"),
			НСтр("ru = 'Не удалось обратиться к серверу оператора СЭДО ФСС (%1): %2. Возможно, сервер перегружен. Попробуйте повторить запрос через некоторое время.';
				|en = 'Cannot contact SSF EDI provider server (%1): %2. The server may be overloaded. Try again after some time.'"));
		Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
		ТекстОшибки = СтрШаблон(Шаблон, АдресСервера, ОписаниеОшибкиОтправки);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ТекстОшибки);
		// запись в журнал.
		Шаблон = НСтр("ru = 'Не удалось отправить запрос серверу:
								 |%1';
								 |en = 'Cannot send a query to the server:
								 |%1'");
		ТекстОшибкиЖурнал = СтрШаблон(
			Шаблон,
			ОписаниеОшибкиОтправки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибкиЖурнал);
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.ОшибкаСоединения = Истина;
		Возврат Результат;
	КонецПопытки;
	
	Если Ответ.КодСостояния = 301
		ИЛИ Ответ.КодСостояния = 307 Тогда
		ДополнительныеПараметры = НовыеПараметрыОтправитьЗапросСервисуСЭДОФСС();
		ДополнительныеПараметры.ТребуетсяПеренаправление = Истина;
		ДополнительныеПараметры.АдресДляПеренаправления = Ответ.Заголовки.Получить("Location");
		Возврат ОтправитьЗапросСервисуСЭДОФСС(
					Организация,
					Операция,
					АдресЗашифрованногоЗапросаSOAP,
					ОбменПоСЭДОНапрямую,
					ДополнительныеПараметры);
	КонецЕсли;
	
	ОперацияПолученияСпискаВходящих = ЭлектронныйДокументооборотСФССКлиентСервер.ОперацияПолученияСпискаВходящихСЭДО();
	Если Операция = ОперацияПолученияСпискаВходящих
		И Ответ.КодСостояния = 200 Тогда
		ОбновитьТаймаутМеждуЗапросамиСЭДО(Ответ);
	КонецЕсли;
	
	ТекстЗашифрованногоОтветаSOAP = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Результат.АдресЗашифрованногоОтветаSOAP = ПоместитьВоВременноеХранилище(
		ТекстЗашифрованногоОтветаSOAP,
		Новый УникальныйИдентификатор());
	ДвоичныеДанныеОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Результат.АдресЗашифрованногоОтветаSOAPДвоичныеДанные = ПоместитьВоВременноеХранилище(
		ДвоичныеДанныеОтвета,
		Новый УникальныйИдентификатор());
		
	Если Найти(ТекстЗашифрованногоОтветаSOAP, "<xenc:EncryptedData") > 0 Тогда
		Результат.ТребуетсяРасшифровкаОтвета = Истина;
	КонецЕсли;
	Результат.КодСостояния = Ответ.КодСостояния;
	
	// Список входящих допускается получать не чаще чем за интервал, заданный на сервере СЭДО.
	// При более частом обращении возвращается ошибка 403.
	ОшибкаЧастогоОбращенияЗаСпискомВходящих = "E_SEDO_1012";
	Если Ответ.КодСостояния = КодСостоянияОшибкиЧастогоОбращенияЗаСпискомВходящих()
		И СтрНайти(ТекстЗашифрованногоОтветаSOAP, ОшибкаЧастогоОбращенияЗаСпискомВходящих) > 0 Тогда
		
		ЗаголовкиОтвета = Ответ.Заголовки;
		Если НЕ ЗаголовкиОтвета.Получить("retry-after") = Неопределено Тогда
			ОсталосьВремениБлокировки = Число(ЗаголовкиОтвета.Получить("retry-after")) / 1000;
			ОсталосьВремениБлокировки = Окр(ОсталосьВремениБлокировки, 0, РежимОкругления.Окр15как20);
			Результат.ОсталосьВремениБлокировки = ОсталосьВремениБлокировки;
		КонецЕсли;
		
		ПревышениеМаксимальногоТаймаута = Ложь;
		ТаймаутМеждуЗапросамиСЭДО = ПолучитьТаймаутМеждуЗапросамиСЭДО(Организация, Ответ, ПревышениеМаксимальногоТаймаута);
		
		Если НомерПопыткиСоединения >= 3
			ИЛИ ПревышениеМаксимальногоТаймаута Тогда
			ПодготовитьРезультатПоОшибкеСЭДО1012(Результат, ТаймаутМеждуЗапросамиСЭДО, АдресСервера, ОбменПоСЭДОНапрямую);
			Возврат Результат;
		КонецЕсли;
		
		Шаблон = НСтр("ru = 'При выполнении запроса операции %3 к ресурсу %1 сервера %2 произошла ошибка E_SEDO_1012.';
						|en = 'Error E_SEDO_1012 occurred when executing the %3 operation query to the %1 resource of the %2 server.'")
			+ Символы.ПС + НСтр("ru = 'Делаем задержку %4 перед следующим запросом.';
								|en = 'A pause for %4 is required before the next request.'");
		КоличествоСекундТаймаута = ОбщегоНазначенияЭДКОКлиентСервер.ПростоеСклонение(
				ТаймаутМеждуЗапросамиСЭДО,
				НСтр("ru = '%1 секунду';
					|en = '%1 second'"),
				НСтр("ru = '%1 секунды';
					|en = '%1 seconds'"),
				НСтр("ru = '%1 секунд';
					|en = '%1 seconds'"));
		КоличествоСекундТаймаута = СтрШаблон(КоличествоСекундТаймаута, ТаймаутМеждуЗапросамиСЭДО);
		ОписаниеОшибки = СтрШаблон(Шаблон, АдресРесурса, АдресСервера, Операция, КоличествоСекундТаймаута);
		// Записываем предупреждение в журнал.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОписаниеОшибки);
		// Возвращена ошибка сервера "Запрос от лица абонента уже выполнялся, попробуйте позднее".
		// Делаем задержку перед отправкой следующего запроса.
		ТекущаяДата = ТекущаяДатаСеанса();
		РезультатЗадержки = ЭлектронныйДокументооборотСФСС.Задержка(ТекущаяДата, ТаймаутМеждуЗапросамиСЭДО);
		
		Если НЕ РезультатЗадержки Тогда
			ПодготовитьРезультатПоОшибкеСЭДО1012(Результат, ТаймаутМеждуЗапросамиСЭДО, АдресСервера, ОбменПоСЭДОНапрямую);
			Возврат Результат;
		КонецЕсли;
		
		НомерПопыткиСоединения = НомерПопыткиСоединения + 1;
		Операция = Операция + "#" + НомерПопыткиСоединения; 
		Возврат ОтправитьЗапросСервисуСЭДОФСС(
			Организация,
			Операция,
			АдресЗашифрованногоЗапросаSOAP,
			ОбменПоСЭДОНапрямую);
		
	КонецЕсли;
	
	РезультатАнализа = АнализВыполненияHTTPЗапроса(Ответ, АдресРесурса, ОбменПоСЭДОНапрямую);
	Если НЕ РезультатАнализа.Выполнено Тогда
		Шаблон = НСтр("ru = 'При выполнении запроса к ресурсу %1 сервера %2 произошла ошибка:
			|%3';
			|en = 'An error occurred when executing request to resource %1 of server %2:
			|%3'");
		ОписаниеОшибки = СтрШаблон(Шаблон,
			АдресРесурса,
			АдресСервера,
			РезультатАнализа.ОписаниеОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
										|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки + "
			|" + НСтр("ru = 'Текст ответа сервера';
						|en = 'Server response text'") + ": " + Лев(ТекстЗашифрованногоОтветаSOAP, 1024));
		Результат.ОписаниеОшибки = ОписаниеОшибки;
		Если РезультатАнализа.ОшибкаСервера Тогда
			Результат.ОшибкаСоединения = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	Возврат Результат;
	
КонецФункции

Процедура ПодготовитьРезультатПоОшибкеСЭДО1012(
		Результат,
		ТаймаутМеждуЗапросамиСЭДО,
		АдресСервера,
		ОбменПоСЭДОНапрямую = Ложь)
	
	ИнформацияОбОшибке = ИнформацияОбОшибке();
	ОписаниеОшибкиОтправки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	Шаблон = ?(ОбменПоСЭДОНапрямую,
		НСтр("ru = 'Не удалось обратиться к серверу СЭДО СФР (%1).';
			|en = 'Cannot access the EDI server of Social Insurance Fund of Russia (%1).'") + 
		НСтр("ru = ' Ответ от сервера СЭДО: на сервере возникла ошибка 1012, рекомендуется повторить запрос через %2.';
			|en = ' Response from the EDI server: error 1012 occurred on the server. Please try again in %2.'"),
		НСтр("ru = 'Не удалось обратиться к серверу оператора СЭДО СФР (%1).';
			|en = 'Cannot access the EDI provider server of Social Insurance Fund of Russia (%1).'") + 
		НСтр("ru = ' Ответ от сервера оператора СЭДО: на сервере возникла ошибка 1012, рекомендуется повторить запрос через %2.';
			|en = ' Response from the EDI provider server: error 1012 occurred on the server. Please try again in %2.'"));
	ТаймаутМеждуЗапросамиСЭДОВМинутах = Окр(ТаймаутМеждуЗапросамиСЭДО / 60, 0, РежимОкругления.Окр15как20);
	ТаймаутМеждуЗапросамиСЭДОВМинутах = ?(ТаймаутМеждуЗапросамиСЭДОВМинутах = 0, 1, ТаймаутМеждуЗапросамиСЭДОВМинутах);
	КоличествоМинутТаймаута = ОбщегоНазначенияЭДКОКлиентСервер.ПростоеСклонение(
		ТаймаутМеждуЗапросамиСЭДОВМинутах,
		НСтр("ru = '%1 минуту';
			|en = '%1 minute'"),
		НСтр("ru = '%1 минуты';
			|en = '%1 minutes'"),
		НСтр("ru = '%1 минут';
			|en = '%1 minutes'"));
	КоличествоМинутТаймаута = СтрШаблон(КоличествоМинутТаймаута, ТаймаутМеждуЗапросамиСЭДОВМинутах);
	ВремяСледующейПопытки = КоличествоМинутТаймаута + НСтр("ru = ' (%1 в %2)';
															|en = ' (%1 in %2)'");
	ТочноеВремяСледующейПопытки = ТекущаяДатаСеанса() + (ТаймаутМеждуЗапросамиСЭДОВМинутах * 60);
	ВремяСледующейПопытки = СтрШаблон(
		ВремяСледующейПопытки,
		Формат(ТочноеВремяСледующейПопытки, "ДФ='dd.MM.yyyy'"),
		Формат(ТочноеВремяСледующейПопытки, "ДФ='HH:мм'"));
	Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
	ТекстОшибки = СтрШаблон(Шаблон, АдресСервера, ВремяСледующейПопытки);
	// запись в журнал.
	Шаблон = НСтр("ru = 'Не удалось отправить запрос серверу:
		|%1';
		|en = 'Cannot send a query to the server:
		|%1'");
	ОписаниеОшибкиОтправки = ОписаниеОшибкиОтправки + ". " + ТекстОшибки;
	ТекстОшибкиЖурнал = СтрШаблон(
		Шаблон,
		ОписаниеОшибкиОтправки);
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
									|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
		УровеньЖурналаРегистрации.Ошибка, , ,
		ТекстОшибкиЖурнал);
	Результат.ОписаниеОшибки = ТекстОшибки;
	Результат.ОшибкаСоединения = Истина;
	Результат.ВозниклаБлокировкаИзЗаЧастыхЗапросов = Истина;
			
КонецПроцедуры

Функция АнализВыполненияHTTPЗапроса(Ответ, АдресРесурса, ОбменПоСЭДОНапрямую = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ОшибкаСервера", Ложь);
	
	Если Ответ.КодСостояния < 300 Тогда
		Результат.Выполнено = Истина;
	ИначеЕсли Ответ.КодСостояния >= 400 И Ответ.КодСостояния < 500 Тогда
		ИнформацияОНедоступности = НСтр("ru = 'Возможно сервер временно недоступен, попробуйте повторить запрос через некоторое время.';
										|en = 'The server may be temporarily unavailable. Please try again later.'");
		Если Ответ.КодСостояния = 403 Тогда
			ОписаниеОшибки = НСтр("ru = 'Доступ к серверу запрещён, код состояния %1.';
									|en = 'Access to the server is denied. Status code is %1.'");
			Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния);
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Если ОбменПоСЭДОНапрямую Тогда
				ИнформацияОбОшибке = НСтр("ru = 'Код состояния %1, ресурс не найден на сервере СЭДО.';
											|en = 'Status code %1, the resource is not found on the EDI server.'");
			Иначе
				ИнформацияОбОшибке = НСтр("ru = 'Код состояния %1, ресурс не найден на сервере оператора СЭДО.';
											|en = 'Status code %1, the resource is not found on the EDI operator server.'");
			КонецЕсли;
			ОписаниеОшибки = ИнформацияОбОшибке +
				Символы.ПС + ИнформацияОНедоступности;
			Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния);
		Иначе
			ОписаниеОшибки = НСтр("ru = 'Ошибка клиента, код состояния %1.';
									|en = 'Client error, status code %1.'");
			Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния) +
				Символы.ПС + ИнформацияОНедоступности;
		КонецЕсли;
	ИначеЕсли Ответ.КодСостояния >= 500 И Ответ.КодСостояния < 600 Тогда
		Если Ответ.КодСостояния = 501 Тогда
			Шаблон = НСтр("ru = 'Операция %1 не реализована.';
							|en = 'The %1 operation is not implemented.'");
			Результат.ОписаниеОшибки = СтрШаблон(Шаблон, АдресРесурса);
		ИначеЕсли Ответ.КодСостояния = 504 Тогда
			ОписаниеОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(?(ОбменПоСЭДОНапрямую,
				НСтр("ru = 'Время ожидания ответа от сервера СЭДО ФСС истекло (код состояния 504). Попробуйте повторить запрос через некоторое время.';
					|en = 'Response timeout from SSF EDI server (status code 504). Try again after some time.'"),
				НСтр("ru = 'Время ожидания ответа от сервера оператора СЭДО ФСС истекло (код состояния 504). Попробуйте повторить запрос через некоторое время.';
					|en = 'Response timeout from the server of SSF EDI provider (status code 504). Try again after some time.'")), Истина);
			Результат.ОписаниеОшибки = ОписаниеОшибки;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			РезультатРазбора = РазобратьОтветСЭДОСОшибкой(Ответ);
			Если РезультатРазбора.Выполнено Тогда
				ПредставлениеСервера = ?(ОбменПоСЭДОНапрямую, НСтр("ru = 'cервера СЭДО';
																	|en = 'EDI server'"), НСтр("ru = 'сервера оператора СЭДО';
																								|en = 'EDI provider server'"));
				ОписаниеОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка %1: %2.';
						|en = 'Error %1: %2.'") + Символы.ПС + Символы.ПС +
					НСтр("ru = 'Возможно, следует проверить настройки сертификата страхователя или сертификат шифрования органа ФСС.';
						|en = 'Check insurant certificate settings or an SSF authority encryption certificate.'"), Истина);
				Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПредставлениеСервера, РезультатРазбора.ТекстОшибки);
			Иначе
				ОписаниеОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка сервера, код состояния %1.';
						|en = 'Server error, status code %1.'") + Символы.ПС + Символы.ПС +
					НСтр("ru = 'Возможно, следует проверить настройки сертификата страхователя или сертификат шифрования органа ФСС.';
						|en = 'Check insurant certificate settings or an SSF authority encryption certificate.'"), Истина);
				Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния);
			КонецЕсли;
			
		Иначе
			ОписаниеОшибки = НСтр("ru = 'Ошибка сервера, код состояния %1.';
									|en = 'Server error, status code %1.'");
			Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния);
		КонецЕсли;
		// Сохраняем ошибку сервера в журнал регистрации.
		Если ОбменПоСЭДОНапрямую Тогда
			Шаблон = НСтр("ru = 'Получена ошибка сервера СЭДО ФСС (код состояния %2): ""%1""';
							|en = 'An error of the SSF EDI server was received (state code %2): ""%1""'");
		Иначе
			Шаблон = НСтр("ru = 'Получена ошибка сервера оператора СЭДО ФСС (код состояния %2): ""%1""';
							|en = 'An error of the SSF EDI provider server is received (state code %2): ""%1""'");
		КонецЕсли;
		Шаблон = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(Шаблон, Истина);
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ТекстДляЖурнала = СтрШаблон(Шаблон, ТекстОтвета, Ответ.КодСостояния);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО СФР';
				|en = 'Electronic data interchange with regulatory authorities. Receive Social Insurance Fund of Russia EDI data'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстДляЖурнала);
		Результат.ОшибкаСервера = Истина;
	Иначе
		Если ОбменПоСЭДОНапрямую Тогда
			ОписаниеОшибки = НСтр("ru = 'Ошибка выполнения запроса к серверу СЭДО, код состояния %1.';
									|en = 'An error occurred when executing a request to the EDI server. State code: %1.'");
		Иначе
			ОписаниеОшибки = НСтр("ru = 'Ошибка выполнения запроса к серверу оператора СЭДО, код состояния %1.';
									|en = 'An error occurred when executing a request to the EDI provider server. State code: %1.'");
		КонецЕсли;
		Результат.ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Ответ.КодСостояния);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьОтветСЭДОСОшибкой(Ответ)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	
	НеизвестнаяОшибка = НСтр("ru = 'Неизвестная ошибка сервиса СЭДО';
							|en = 'Unknown EDI service error'");
	Чтение = Новый ЧтениеXML;
	ДанныеОтвета = Неопределено;
	Попытка
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Чтение.УстановитьСтроку(ТекстОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Исключение
		Чтение.Закрыть();
		ОписаниеОшибки = НСтр("ru = 'Ошибка разбора ответа сервера СЭДО.';
								|en = 'Ошибка разбора ответа сервера СЭДО.'");
		Результат.Ошибки.Добавить(ОписаниеОшибки);
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = НСтр("ru = 'Ошибка разбора ответа сервера СЭДО:';
							|en = 'Ошибка разбора ответа сервера СЭДО:'") 
			+ Символы.ПС + ПодробноеПредставлениеОшибки
			+ Символы.ПС + НСтр("ru = 'Содержимое ответа:';
								|en = 'Содержимое ответа:'") + Символы.ПС + ТекстОтвета;
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Отправка запроса СЭДО СФР';
							|en = 'Electronic data interchange with regulatory authorities. Send a Social Insurance Fund EDI request'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);
		Результат.ТекстОшибки = НеизвестнаяОшибка;
		Возврат Результат;
	КонецПопытки;
	Чтение.Закрыть();
	
	Если НЕ ЕстьСвойство(ДанныеОтвета, "Body") Тогда
		Результат.ТекстОшибки = НеизвестнаяОшибка;
		Возврат Результат;
	КонецЕсли;
	
	РезультатИзвлечения = ИзвлечьТекстОшибкиИзТелаОтветаСЭДО(ДанныеОтвета.Body);
	Результат.Выполнено = РезультатИзвлечения.УдалосьРазобрать;
	Результат.ТекстОшибки = РезультатИзвлечения.ТекстОшибки;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьТекстОшибкиИзТелаОтветаСЭДО(ТелоОтвета) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("УдалосьРазобрать", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	
	НеизвестнаяОшибка = НСтр("ru = 'Не удалось разобрать ответ сервера СЭДО с данными сообщения. Подробности см. в журнале регистрации.';
							|en = 'Не удалось разобрать ответ сервера СЭДО с данными сообщения. Подробности см. в журнале регистрации.'");
	ТекстОшибки = "";
	Если ЕстьСвойство(ТелоОтвета, "Fault") Тогда
		УзелОшибки = ТелоОтвета.Fault;
		Если ЕстьСвойство(УзелОшибки, "detail") Тогда
			УзелОшибкиДетали = УзелОшибки.detail;
			Если ЕстьСвойство(УзелОшибкиДетали, "digitalSignFault") Тогда
				ТекстОшибки = УзелОшибкиДетали.digitalSignFault.message;
				Результат.УдалосьРазобрать = Истина;
			Иначе
				ТекстОшибки = НеизвестнаяОшибка;
			КонецЕсли;
		Иначе
			Если ЕстьСвойство(УзелОшибки, "faultstring") Тогда
				ТекстОшибки = УзелОшибки.faultstring;
				Результат.УдалосьРазобрать = Истина;
			ИначеЕсли ЕстьСвойство(УзелОшибки, "faultcode") Тогда
				ТекстОшибки = НСтр("ru = 'Ошибка сервера СЭДО, код ошибки: ';
									|en = 'EDI server error, error code:'") + УзелОшибки.faultcode;
				Результат.УдалосьРазобрать = Истина;
			Иначе
				ТекстОшибки = НеизвестнаяОшибка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекстОшибки = НеизвестнаяОшибка;
	КонецЕсли;
	
	Результат.ТекстОшибки = ТекстОшибки;
	Возврат Результат;
	
КонецФункции

Функция ОписанияТиповСообщенийСЭДО() Экспорт
	
	Результат = Новый Соответствие;
	
	МакетПеречняДокументов = ПолучитьМакет("ПереченьДокументовОбрабатываемыхСЭДОФСС");
	
	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		БуферДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(МакетПеречняДокументов);
		Поток = Новый ПотокВПамяти(БуферДанных);
		ЧтениеXML.ОткрытьПоток(Поток);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		Возврат Результат;
	КонецПопытки;
		
	Если ДанныеОтвета.Свойства().Получить("dicList") <> Неопределено Тогда
		УзелСписок = ДанныеОтвета.dicList;
		Если УзелСписок.Свойства().Получить("dic") <> Неопределено Тогда
			Для К = 0 По УзелСписок.dic.Количество() - 1 Цикл
				УзелСообщения = ДанныеОтвета.dicList.dic[К];
				ТипСообщения = УзелСообщения.code;
				ПредставлениеДокумента = СокрЛП(УзелСообщения.name);
				Результат.Вставить(ТипСообщения, ПредставлениеДокумента);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Переопределение названий некоторых типов из доходной части.
	Результат.Вставить("335", "Решение о зачете суммы излишне уплаченных (взысканных) страховых взносов, пеней и штрафов");
	Результат.Вставить("336", "Решение о возврате суммы излишне уплаченных (взысканных) страховых взносов, пеней и штрафов");
	
	// Представление типов сообщений оператора.
	Результат.Вставить("1000000", "Подтверждение доставки оператором в СФР (альтернативное)");
	Результат.Вставить("1000009", "Результат подписки/снятия подписки абонентов от оператора");
	Результат.Вставить("1000011", "Подтверждение доставки оператором сообщения в СФР");
	Результат.Вставить("1000014", "Найдены ошибки при обработке сообщения оператором");
	
	// Извещение СЭДО.
	Результат.Вставить("1010", "Извещение о запросе недостающих сведений для назначения пособий по ВНиМ, ССВ");
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения) Экспорт
	
	ПредставлениеДокумента = "";
	
	ОписаниеТипов = РегламентированнаяОтчетностьПовтИсп.ОписанияТиповСообщенийСЭДО();
	Тип = Строка(ТипСообщения);
	Описание = ОписаниеТипов[Тип];
	Если ЗначениеЗаполнено(Описание) Тогда
		ПредставлениеДокумента = Описание;
	КонецЕсли;
	
	Возврат ПредставлениеДокумента;
	
КонецФункции

Функция ВходящееСообщение(ИдентификаторСообщения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВходящиеСообщенияСЭДОФСС.Идентификатор КАК Идентификатор,
	|	ВходящиеСообщенияСЭДОФСС.Организация КАК Организация,
	|	ВходящиеСообщенияСЭДОФСС.Содержимое КАК Содержимое,
	|	ВходящиеСообщенияСЭДОФСС.Дата КАК Дата,
	|	ВходящиеСообщенияСЭДОФСС.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ВходящиеСообщенияСЭДОФСС.ДатаОтправкиПодтверждения КАК ДатаОтправкиПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаПолученияИзвещенияОПолученииПодтверждения КАК ДатаПолученияИзвещенияОПолученииПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаПолученияОшибкиПодтверждения КАК ДатаПолученияОшибкиПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ДатаСоздания КАК ДатаСоздания,
	|	ВходящиеСообщенияСЭДОФСС.Новое КАК Новое,
	|	ВходящиеСообщенияСЭДОФСС.ОшибкаОбработкиСообщения КАК ОшибкаОбработкиСообщения,
	|	ВходящиеСообщенияСЭДОФСС.ОшибкаПодтверждения КАК ОшибкаПодтверждения,
	|	ВходящиеСообщенияСЭДОФСС.ПодтверждениеОтправлено КАК ПодтверждениеОтправлено,
	|	ВходящиеСообщенияСЭДОФСС.Получатель КАК Получатель,
	|	ВходящиеСообщенияСЭДОФСС.Тип КАК Тип,
	|	ВходящиеСообщенияСЭДОФСС.ТребуетсяПодтверждение КАК ТребуетсяПодтверждение,
	|	ВходящиеСообщенияСЭДОФСС.СрокДействия КАК СрокДействия
	|ИЗ
	|	РегистрСведений.ВходящиеСообщенияСЭДОФСС КАК ВходящиеСообщенияСЭДОФСС
	|ГДЕ
	|	ВходящиеСообщенияСЭДОФСС.Идентификатор = &ИдентификаторСообщения";
	
	Если ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() > 0 Тогда
			Таблица[0].Тип = ТипСообщенияСЭДОВСтроку(Таблица[0].Тип);
			Возврат Таблица[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураПоТекстуЗапроса(Запрос.Текст);
	
КонецФункции

Функция СтруктураПоТекстуЗапроса(ТекстЗапроса)
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПоследнийЗапрос = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	Структура = Новый Структура;
	Для Каждого КолонкаСхемыЗапроса Из ПоследнийЗапрос.Колонки Цикл
		Структура.Вставить(КолонкаСхемыЗапроса.Псевдоним, КолонкаСхемыЗапроса.ТипЗначения.ПривестиЗначение(Неопределено));
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

// Сообщения по доходной части СЭДО типов 300-336 (требования, сверки, уведомления).
Процедура ПослеРасшифровкиВходящиеСообщенияСЭДО(Страхователь, Сообщение, Результат) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); // Загружаются все входящие документы.
	
	Кэш = Неопределено;
	
	//Приводим тип к числу.
	ТипСообщения = ТипСообщенияСЭДОВЧисло(Сообщение.Тип);
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Ложь);
	
	ИдентификаторСообщения = НРег(СокрЛП(Сообщение.Идентификатор));
	ВходящееСообщение = ВходящееСообщение(ИдентификаторСообщения);
	ТребуетсяПодтверждение = ВходящееСообщение.ТребуетсяПодтверждение;
	ТипыСообщенийРешенийУведомлений = Новый Массив;
	ТипыСообщенийРешенийУведомлений.Добавить(ТипыСообщений.УведомлениеОФактеИзлишнейУплаты);
	ТипыСообщенийРешенийУведомлений.Добавить(ТипыСообщений.РешениеОЗачетеСуммыИзлишнеУплаченныхВзносовШтрафов);
	ТипыСообщенийРешенийУведомлений.Добавить(ТипыСообщений.РешениеОВозвратеСуммыИзлишнеУплаченныхВзносовШтрафов);
	
	Если (ТипСообщения >= ТипыСообщений.АктКамеральнойПроверки // 300
			И ТипСообщения <= ТипыСообщений.ТребованиеОВозмещенииИзлишнеПонесенныхРасходов) // 312
		ИЛИ ТипСообщения = ТипыСообщений.ТребованиеОПредставленииПоясненийИлиВнесенииИсправленийВОтчет // 342
		ИЛИ НЕ ТипыСообщенийРешенийУведомлений.Найти(ТипСообщения) = Неопределено Тогда
		ЗагрузитьСообщение300_312(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение,
			ТребуетсяПодтверждение,
			Результат,
			ТипСообщения);
		
	ИначеЕсли ТипСообщения = ТипыСообщений.УведомлениеОПриемеДокументовПоКамеральнойПроверке
			ИЛИ ТипСообщения = ТипыСообщений.УведомлениеОПриемеДокументовПоВыезднойПроверке Тогда // 315, 316
		ЗагрузитьСообщениеУведомлениеОПриеме(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			ТипСообщения);
			
	ИначеЕсли ТипСообщения = ТипыСообщений.РезультатРегистрацииЗаявленияНаФормированиеСправкиОрасчетах Тогда // 318
		ЗагрузитьСообщение318(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			ТипСообщения);
			
	ИначеЕсли ТипСообщения = ТипыСообщений.СправкаОРасчетах Тогда // 319
		ЗагрузитьСообщение319(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			ТипСообщения);
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПриПолученииСодержимогоРассылкиСЭДО(Страхователь, Сообщение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = ЭлектронныйДокументооборотСФССКлиентСервер.НовыйРезультатПриПолученииСодержимогоСообщенияСЭДО();
	
	ИдентификаторСообщения = НРег(СокрЛП(Сообщение.Идентификатор));
	
	// Широковещательные сообщения (рассылки) СЭДО СФР
	ЗагрузитьСодержимоеРассылки(
		Страхователь,
		ИдентификаторСообщения,
		Сообщение.ТекстСообщения,
		Сообщение.Дата,
		Результат);
		
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьНовоеСобытие(Объект, Страхователь, ТипСообщения, Статус = "")
	
	Если ПустаяСтрока(Статус) Тогда
		Статус = НСтр("ru = 'Принято';
						|en = 'Accepted'");
	КонецЕсли;
	
	Запись = Новый Структура;
	Запись.Вставить("Объект", Объект.Ссылка);
	Запись.Вставить("Организация", Объект.Организация);
	КодКонтролирующегоОргана = ЭлектронныйДокументооборотСФСС.ПолучитьКодОрганаСФР(Объект.Организация);
	Запись.Вставить("КонтролирующийОрган", "СФР " + КодКонтролирующегоОргана);
	
	Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами") Тогда
		Запись.Вставить("ДатаСобытия", ?(ЗначениеЗаполнено(Объект.ДатаСообщения), Объект.ДатаСообщения, ТекущаяДатаСеанса()));
		Запись.Вставить("Наименование", Объект.Наименование);
	Иначе
		Запись.Вставить("ДатаСобытия", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
		Запись.Вставить("Наименование", ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения));
	КонецЕсли;
	
	Запись.Вставить("ОтправленоПолучено", ТекущаяДатаСеанса());
	Запись.Вставить("Группа",
		Перечисления.ГруппыНовыхСобытийДокументооборотаСКонтролирующимиОрганами.ПолученныеСообщения);
	Запись.Вставить("Состояние", Перечисления.СостояниеСдачиОтчетности.ОтправленоИзКонтролирующегоОргана);
	Запись.Вставить("Статус", Статус);
	Запись.Вставить("НеОтправляетсяВКонтролирующийОрган", Истина);
	Запись.Вставить("ЕстьОтвет", Ложь);
	Запись.Вставить("ЕстьКритическиеОшибкиОтправки", Ложь);
	Запись.Вставить("Просмотрено", Ложь);
	Запись.Вставить("ПоказатьПользователю", Истина);
	Запись.Вставить("Скрыт", Ложь);
	Запись.Вставить("Страница", Перечисления.СтраницыЖурналаОтчетность.Входящие);
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗаписатьСобытиеДокументооборотаСКО(Запись);
	
КонецПроцедуры

// Фиксирует ошибку обработки сообщения.
//
// Параметры:
//   Результат - Структура - Результат обработки сообщения. Передается из параметров переопределяемого метода.
//   ИдентификаторСообщения - Строка - Идентификатор сообщения. Передается из параметров переопределяемого метода.
//   ТекстОшибки - Строка - Текст ошибки обработки сообщения.
//
Процедура ОшибкаОбработки(Результат, ИдентификаторСообщения,
		ТекстОшибки, ТекстXML = Неопределено, ЭтоПредупреждение = Ложь) Экспорт
	
	Результат.ОшибкаОбработки = Истина;
	Если ЭтоПредупреждение Тогда
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Предупреждение при обработке сообщения СЭДО %1: %2';
				|en = 'Warning when processing the EDI message %1: %2'"),
			ИдентификаторСообщения,
			ТекстОшибки);
	Иначе
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка обработки сообщения СЭДО %1: %2';
				|en = 'EDI message processing error %1: %2 '"),
			ИдентификаторСообщения,
			ТекстОшибки);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстXML) Тогда
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки
			+ Символы.ПС
			+ СтрШаблон(НСтр("ru = 'Текст XML: %1';
							|en = 'XML text: %1.'"), ТекстXML);
	КонецЕсли;
	// Записываем текст ошибки в журнал.
	ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, Результат.ОписаниеОшибки);
	
КонецПроцедуры

Функция ПолучитьВидыДокументовСЭДОФССДоходнаяЧасть() Экспорт
	
	РезультатСоответствие = Новый Соответствие;
	МакетСписокДокументов = Обработки.ДокументооборотСКонтролирующимиОрганами.ПолучитьМакет("ВидыДокументовСЭДОФССДоходнаяЧасть");
	Для Ном = 2 По МакетСписокДокументов.ВысотаТаблицы Цикл
		
		ИдентификаторДокумента = СокрЛП(МакетСписокДокументов.Область(Ном, 1, Ном, 1).Текст);
		НаименованиеДокумента = СокрЛП(МакетСписокДокументов.Область(Ном, 2, Ном, 2).Текст);
		РезультатСоответствие.Вставить(ИдентификаторДокумента, НаименованиеДокумента);
		
	КонецЦикла;
	
	Возврат РезультатСоответствие;
	
КонецФункции

Функция ТекстовоеПредставлениеРазмераФайла(РазмерВБайтах) Экспорт
	
	Размер = 0;
	РазмерВКилобайтах = Окр(РазмерВБайтах / 1024);
	Если РазмерВБайтах = 0 Тогда
		Шаблон = НСтр("ru = '%1 Б';
						|en = '%1 B'");
	ИначеЕсли РазмерВКилобайтах < 100 Тогда
		Размер = РазмерВКилобайтах;
		Шаблон = НСтр("ru = '%1 КБ';
						|en = '%1 KB'");
	Иначе
		Размер = Окр(РазмерВКилобайтах / 1024);
		Шаблон = НСтр("ru = '%1 МБ';
						|en = '%1 MB'");
	КонецЕсли;
	
	Возврат ПодставитьПараметрыВСтроку(Шаблон, Размер);
	
КонецФункции

Функция РабочихДнейНаОтправкуОтветаСтрахователяНаТребованиеСЭДО() Экспорт
	
	Возврат 11;
	
КонецФункции

Функция БлижайшийРабочийДень(Дата, НомерДня = 0, КорректироватьДату = Истина) Экспорт
	
	БлижайшиеРабочиеДни = БлижайшиеРабочиеДни(Дата, НомерДня + 1);
	Количество = БлижайшиеРабочиеДни.Количество();
	Результат = Дата;
	Если НЕ Количество = 0 Тогда
		Результат = БлижайшиеРабочиеДни[Количество - 1];
		Если КорректироватьДату Тогда
			Результат = КорректировкаДатыОтветаНаТребованиеСФР(Результат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КорректировкаДатыОтветаНаТребованиеСФР(ДатаОтвета)
	
	СекундВСутках = 3600 * 24;
	Возврат ДатаОтвета - СекундВСутках;
	
КонецФункции

Функция БлижайшиеРабочиеДни(Знач ДатаНачала, Знач Количество)
	РабочиеДни = Новый Массив;
	Если Количество < 1 Тогда
		Возврат РабочиеДни;
	КонецЕсли;
	
	ДатаНачала = НачалоДня(ДатаНачала);
	
	// Наполнение массива календарных дней, от которых будет отталкиваться запрос по рабочим дням.
	// Коэффициент компенсирует праздники и выходные с небольшим запасом, для минимизации обращений к СУБД.
	КалендарныеДни = Новый Массив;
	ВГраницаКалендарныхДней = ?(Количество < 2, 0, Цел(Количество * 1.5));
	Для ИндексДня = 0 По ВГраницаКалендарныхДней Цикл
		КалендарныеДни.Добавить(ДатаНачала + 86400 * ИндексДня);
	КонецЦикла;
	
	РабочиеДниКоличество = 0;
	Календарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	Если Не ЗначениеЗаполнено(Календарь) Тогда
		Возврат РабочиеДни;
	КонецЕсли;
	БлижайшиеРабочиеДаты = КалендарныеГрафики.БлижайшиеРабочиеДаты(Календарь, КалендарныеДни);
	Если БлижайшиеРабочиеДаты <> Неопределено Тогда
		
		Для Каждого КалендарныйДень Из КалендарныеДни Цикл
			РабочийДень = БлижайшиеРабочиеДаты[КалендарныйДень];
			Если ТипЗнч(РабочийДень) = Тип("Дата")
				И РабочийДень >= КалендарныйДень
				И РабочиеДни.Найти(РабочийДень) = Неопределено Тогда
				РабочиеДни.Добавить(РабочийДень);
				РабочиеДниКоличество = РабочиеДниКоличество + 1;
				Если РабочиеДниКоличество = Количество Тогда
					Возврат РабочиеДни;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Если найдено недостаточно рабочих дней (например, часть календарных дней попало на длинные праздники),
		// то выполняется второй запрос с недостающими днями.
		Если РабочиеДниКоличество > 0 Тогда
			ОсталосьДней = Количество - РабочиеДниКоличество;
			СледующийДень = РабочиеДни[РабочиеДниКоличество-1] + 86400;
			БлижайшиеРабочиеДни = БлижайшиеРабочиеДни(СледующийДень, ОсталосьДней);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РабочиеДни, БлижайшиеРабочиеДни, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РабочиеДни;
КонецФункции

Функция МаксимальнаяДатаОтветаНаТребованиеСФРПоДатеПодтверждения(ВходящаяДата, ДатаПодтверждения, ОтДатыПодтверждения = Ложь) Экспорт
	
	ДнейДоПолучения = РабочихДнейДоПолученияДокументаДоходнаяЧастьСЭДО();
	ДнейДоОтвета = РабочихДнейНаОтправкуОтветаСтрахователяНаТребованиеСЭДО();
	Если ОтДатыПодтверждения Тогда
		МаксимальнаяДатаОтвета = БлижайшийРабочийДень(ДатаПодтверждения, ДнейДоОтвета);
	ИначеЕсли ТекущаяДата() <= ДатаПодтверждения Тогда
		МаксимальнаяДатаОтвета = БлижайшийРабочийДень(ТекущаяДата(), ДнейДоОтвета);
	Иначе
		МаксимальнаяДатаОтвета = БлижайшийРабочийДень(ВходящаяДата, ДнейДоПолучения + ДнейДоОтвета);
	КонецЕсли;
	
	Возврат МаксимальнаяДатаОтвета;
	
КонецФункции

// Загрузка сообщений 300 - 312, 333, 335, 336 СЭДО.
Процедура ЗагрузитьСообщение300_312(
	Страхователь,
	ИдентификаторСообщения,
	Сообщение,
	ТребуетсяПодтверждение,
	Результат,
	ТипСообщения) Экспорт
	
	ТекстXML = Сообщение.ТекстСообщения;
	ДатаСообщения = Сообщение.Дата;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СекундВСутках = 24 * 60 * 60;
	
	ВидыДокументовСЭДОФССДоходнаяЧасть	= ПолучитьВидыДокументовСЭДОФССДоходнаяЧасть();
	
	ЗапрашиваемыеДокументы = Новый ТаблицаЗначений;
	ЗапрашиваемыеДокументы.Колонки.Добавить("ВидДокумента");
	ЗапрашиваемыеДокументы.Колонки.Добавить("НаименованиеДокумента");
	ЗапрашиваемыеДокументы.Колонки.Добавить("Описание");
	ЗапрашиваемыеДокументы.Колонки.Добавить("КоличествоДокументов");
	
	// Данные из xml
	РеквизитыДокумента									= РеквизитыДокументаДоходнойЧастиСЭДО();
	РеквизитыДокумента.ВходящаяДата 					= ДатаСообщения;
	РеквизитыДокумента.ТипСообщения						= ТипСообщения;
	ВидТребования = ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения);
	Если ПустаяСтрока(ВидТребования) Тогда
		ВидТребования = НСтр("ru = 'Требование о предоставлении документов';
							|en = 'The request to provide documents'");
	КонецЕсли;
	РеквизитыДокумента.ВидДокументаФСС					= ВидТребования;
	РеквизитыДокумента.ДатаИмпорта						= ТекущаяДатаСеанса();
	РеквизитыДокумента.Загружено						= Истина;
	РеквизитыДокумента.ТребуетсяПодтверждение			= ТребуетсяПодтверждение;
	
	ДвоичныеДанныеФайловПриложений = Новый ТаблицаЗначений;
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("ВидФайла");
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("ДвоичныеДанныеФайлаПриложения");
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("ИмяФайла");
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("РасширениеФайла");
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("ФайлПриложенияПодписьСотрудникаФонда");
	ДвоичныеДанныеФайловПриложений.Колонки.Добавить("ФайлПриложенияПодписьФонда");
	
	РеквизитыДокумента.ДвоичныеДанныеФайловПриложений = ДвоичныеДанныеФайловПриложений;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстXML);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При загрузке XML-содержимого сообщения ФСС %1 возникла ошибка: %2';
				|en = 'An error occurred while importing the XML content of SSF notification %1: %2'"),
			ИдентификаторСообщения,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Если ДанныеОтвета.Свойства().Получить("department") <> Неопределено Тогда
		РеквизитыДокумента.КодОтправителя = ДанныеОтвета.department.code;
		РеквизитыДокумента.Отправитель = ДанныеОтвета.department.name;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("idMessage") <> Неопределено Тогда
		РеквизитыДокумента.ИдентификаторСообщения = ДанныеОтвета.idMessage;
	КонецЕсли;
	
	РеквизитыДокумента.Организация = Страхователь;
	
	Если ЕстьСвойство(ДанныеОтвета,"regNum") Тогда
		РеквизитыДокумента.РегистрационныйНомерФСС = ДанныеОтвета.regNum;
	КонецЕсли;
	
	Если ЕстьСвойство(ДанныеОтвета, "regNumSFR") Тогда
		РеквизитыДокумента.РегистрационныйНомерСФР = ДанныеОтвета.regNumSFR;
	КонецЕсли;
	
	// Разбор сообщения типа 342 (Требование о представлении необходимых пояснений или внесении соответствующих исправлений в отчет).
	// Идентификатор отчета ЕФС-1, в рамках которого сформировано требование.
	РеквизитыДокумента.ИдентификаторОтчета = ЗначениеСвойстваУзлаXDTO(ДанныеОтвета,
		"idReport", "");
	// Идентификатор протокола передается к отчету ЕФС-1, в рамках которого сформировано требование.
	РеквизитыДокумента.ИдентификаторПротокола = ЗначениеСвойстваУзлаXDTO(ДанныеОтвета,
		"idProtocol", "");

	Если ДанныеОтвета.Свойства().Получить("date") <> Неопределено Тогда
		РеквизитыДокумента.ДатаДокумента = XMLЗначение(Тип("Дата"), ДанныеОтвета.date);
	Иначе
		РеквизитыДокумента.ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
		
	Если ДанныеОтвета.Свойства().Получить("number") <> Неопределено Тогда
		РеквизитыДокумента.ВходящийНомер = Формат(ДанныеОтвета.number, "ЧГ=");
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("requestDocs") <> Неопределено
		И ДанныеОтвета.requestDocs.Свойства().Получить("requestDoc") <> Неопределено Тогда
		
		Для Каждого УзелДокумента Из ЗначениеВКоллекцию(ДанныеОтвета.requestDocs.requestDoc) Цикл
			
			НоваяСтрока = ЗапрашиваемыеДокументы.Добавить();
			
			Если УзелДокумента.Свойства().Получить("typeDocument") <> Неопределено Тогда
				НоваяСтрока.ВидДокумента = XMLЗначение(Тип("Число"), УзелДокумента.typeDocument);
				НоваяСтрока.НаименованиеДокумента = ВидыДокументовСЭДОФССДоходнаяЧасть[УзелДокумента.typeDocument];
			КонецЕсли;
			
			Если УзелДокумента.Свойства().Получить("description") <> Неопределено Тогда
				НоваяСтрока.Описание = УзелДокумента.description;
			КонецЕсли;
			
			Если УзелДокумента.Свойства().Получить("count") <> Неопределено Тогда
				НоваяСтрока.КоличествоДокументов = XMLЗначение(Тип("Число"), УзелДокумента.count);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
	РеквизитыДокумента.ЗапрашиваемыеДокументы = ЗапрашиваемыеДокументы;
	
	// Датой получения по умолчанию считается шестой рабочий день, с момента формирования документа фондом.
	РабочихДнейДоПолучения = РабочихДнейДоПолученияДокументаДоходнаяЧастьСЭДО();
	ДатаПолученияКвитанцииФондом = КонецДня(РеквизитыДокумента.ВходящаяДата) + РабочихДнейДоПолучения * СекундВСутках;
	РеквизитыДокумента.МаксимальнаяДатаОтправкиОтвета = ДатаПолученияКвитанцииФондом
		+ РабочихДнейНаОтправкуОтветаСтрахователяНаТребованиеСЭДО() * СекундВСутках;
	РеквизитыДокумента.МаксимальнаяДатаПодтверждения = ДатаПолученияКвитанцииФондом;
	
	// Крайняя дата получения подтверждения прочтения страхователем сообщения.
	ПолучилиДатуПодтвержденияИзДокумента = Ложь;
	Если ДанныеОтвета.Свойства().Получить("dateDeadline") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.dateDeadline) Тогда
		РеквизитыДокумента.МаксимальнаяДатаПодтверждения = XMLЗначение(Тип("Дата"), ДанныеОтвета.dateDeadline);
		ПолучилиДатуПодтвержденияИзДокумента = Истина;
	КонецЕсли;
	
	Попытка
		// Вычисляем даты по календарю.
		Если НЕ ПолучилиДатуПодтвержденияИзДокумента Тогда
			ДатаПолученияКвитанцииФондом = БлижайшийРабочийДень(
				КонецДня(РеквизитыДокумента.ВходящаяДата),
				РабочихДнейДоПолучения, Ложь);
			РеквизитыДокумента.МаксимальнаяДатаПодтверждения = ДатаПолученияКвитанцииФондом;
		Иначе
			ДатаПолученияКвитанцииФондом = РеквизитыДокумента.МаксимальнаяДатаПодтверждения;
		КонецЕсли;
		РеквизитыДокумента.МаксимальнаяДатаОтправкиОтвета =МаксимальнаяДатаОтветаНаТребованиеСФРПоДатеПодтверждения(
			РеквизитыДокумента.ВходящаяДата,
			НачалоДня(ДатаПолученияКвитанцииФондом),
			Истина);
		РеквизитыДокумента.КалендарьБылНезаполнен = Ложь;
	Исключение
		Шаблон = НСтр("ru = 'В сообщении с идентификатором %1 невозможно определить ближайшую рабочую дату для даты %2, 
			|необходимо заполнить производственный календарь.';
			|en = 'Cannot determine the nearest work date for the date %2 in the message with the %1 ID. 
			|Fill the business calendar.'");
		ОписаниеОшибки = СтрШаблон(Шаблон, ИдентификаторСообщения, Формат(РеквизитыДокумента.МаксимальнаяДатаОтправкиОтвета, "ДЛФ=D"));
		
		// Записываем подробную информацию в журнал.
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);
		РеквизитыДокумента.КалендарьБылНезаполнен = Истина;
		
		ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
		ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(ОписаниеОшибки, ПараметрыВывода);
	КонецПопытки;
		
	Если ДанныеОтвета.Свойства().Получить("attachment") <> Неопределено Тогда
		УзелВложения = ДанныеОтвета.attachment;
		
		Если УзелВложения.Свойства().Получить("content") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.content) Тогда
			
			РеквизитыДокумента.ДвоичныеДанныеФайлаВложения = Base64Значение(УзелВложения.content);
			
		КонецЕсли;
		
		РеквизитыДокумента.ИмяФайлаВложения = ЗначениеСвойстваУзлаXDTO(УзелВложения, "name");
		РеквизитыДокумента.РасширениеФайлаВложения = ЗначениеСвойстваУзлаXDTO(УзелВложения, "ext", "");
		ТипРасширенияПоУмолчанию = "pdf";
		Если ПустаяСтрока(РеквизитыДокумента.РасширениеФайлаВложения) Тогда
			ТипMime = ЗначениеСвойстваУзлаXDTO(УзелВложения, "mimeType");
			Если НЕ ПустаяСтрока(ТипMime) Тогда
				ДанныеТипаMime = ТипСодержимогоИРасширениеПоMIMEТипу(ТипMime);
				РеквизитыДокумента.РасширениеФайлаВложения = ?(
					ПустаяСтрока(ДанныеТипаMime.Расширение), ТипРасширенияПоУмолчанию, ДанныеТипаMime.Расширение);
			Иначе
				РеквизитыДокумента.РасширениеФайлаВложения = ТипРасширенияПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		РеквизитыДокумента.РазмерФайлаВложения = ЗначениеСвойстваУзлаXDTO(УзелВложения, "size", 0, "Число");
		
		Если УзелВложения.Свойства().Получить("signatureEmpl") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.signatureEmpl) Тогда
			
			РеквизитыДокумента.ВходящийФайлПодписьСотрудникаФонда = Новый ХранилищеЗначения(УзелВложения.signatureEmpl);
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("signatureFund") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.signatureFund) Тогда
			
			РеквизитыДокумента.ВходящийФайлПодписьФонда = Новый ХранилищеЗначения(УзелВложения.signatureFund);
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("application") <> Неопределено Тогда
			
			Для Каждого УзелПриложения Из ЗначениеВКоллекцию(УзелВложения.application) Цикл
				
				НовоеПриложение											= РеквизитыДокумента.ДвоичныеДанныеФайловПриложений.Добавить();
				НовоеПриложение.ВидФайла								= УзелПриложения.description;
				НовоеПриложение.ДвоичныеДанныеФайлаПриложения			= Base64Значение(УзелПриложения.content);
				НовоеПриложение.ИмяФайла								= УзелПриложения.name;
				НовоеПриложение.РасширениеФайла							= УзелПриложения.ext;
				
				Если УзелПриложения.Свойства().Получить("signatureEmpl") <> Неопределено
					И ЗначениеЗаполнено(УзелПриложения.signatureEmpl) Тогда
			
					НовоеПриложение.ФайлПриложенияПодписьСотрудникаФонда	= Новый ХранилищеЗначения(УзелПриложения.signatureEmpl);
				КонецЕсли;
				
				Если УзелПриложения.Свойства().Получить("signatureFund") <> Неопределено
					И ЗначениеЗаполнено(УзелПриложения.signatureFund) Тогда
			
					НовоеПриложение.ФайлПриложенияПодписьФонда				= Новый ХранилищеЗначения(УзелПриложения.signatureFund);
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ТребуетсяПодтверждениеТипаСообщенияДоходнойЧастиСЭДО(ТипСообщения) Тогда
		РеквизитыДокумента.Статус = СтатусДокументаДоходнойЧастиСЭДОБезПодтверждения();
		РеквизитыДокумента.ТребуетсяПодтверждение = Ложь;
		Если ЗначениеЗаполнено(РеквизитыДокумента.ВходящаяДата) Тогда
			РеквизитыДокумента.МаксимальнаяДатаПодтверждения = КонецДня(РеквизитыДокумента.ВходящаяДата) + 1;
		Иначе
			РеквизитыДокумента.МаксимальнаяДатаПодтверждения = КонецДня(ТекущаяДатаСеанса()) + 1;
		КонецЕсли;
		РеквизитыДокумента.ДатаОтправкиПодтверждения = НачалоДня(РеквизитыДокумента.МаксимальнаяДатаПодтверждения);
	КонецЕсли;
	
	// Поиск документа.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВходящийДокументСЭДОФСС.Ссылка КАК Ссылка,
	|	ВходящийДокументСЭДОФСС.ВходящийНомер КАК Дата,
	|	ВходящийДокументСЭДОФСС.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ВходящийДокументСЭДОФСС КАК ВходящийДокументСЭДОФСС
	|ГДЕ
	|	ВходящийДокументСЭДОФСС.ИдентификаторСообщения = &ИдентификаторСообщения
	|	И ВходящийДокументСЭДОФСС.ТипСообщения = &ТипСообщения
	|	И ВходящийДокументСЭДОФСС.Организация = &Организация
	|	И ВходящийДокументСЭДОФСС.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ИдентификаторСообщения", РеквизитыДокумента.ИдентификаторСообщения);
	Запрос.УстановитьПараметр("ТипСообщения", Строка(РеквизитыДокумента.ТипСообщения));
	Запрос.УстановитьПараметр("Организация", Страхователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат.Обработано = Истина;
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	Попытка
		
		ДокументОбъект = ЗаписатьДокументДоходнойЧастиСЭДО(РеквизитыДокумента);
		
		// Обновление присоединенного файла.
		ИмяБезРасширения = РеквизитыДокумента.ВидДокументаФСС +
			" " + РеквизитыДокумента.ВходящийНомер + " от " + Формат(РеквизитыДокумента.ВходящаяДата, "ДФ=dd.MM.yyyy");
		
		ПараметрыФайла 						= РаботаСФайлами.ПараметрыДобавленияФайла("Идентификатор, Кодировка");
		ПараметрыФайла.РасширениеБезТочки	= РеквизитыДокумента.РасширениеФайлаВложения;
		ПараметрыФайла.Служебный			= Истина;
		ПараметрыФайла.Идентификатор		= РеквизитыДокумента.ИдентификаторСообщения;
		ПараметрыФайла.ВладелецФайлов		= ДокументОбъект.Ссылка;
		ПараметрыФайла.ИмяБезРасширения		= ИмяБезРасширения;
		СсылкаФайла = Неопределено;
		Если ЗначениеЗаполнено(РеквизитыДокумента.ДвоичныеДанныеФайлаВложения) Тогда
			АдресДвоичныхДанных 				= ПоместитьВоВременноеХранилище(РеквизитыДокумента.ДвоичныеДанныеФайлаВложения);
			СсылкаФайла							= РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДвоичныхДанных);
		КонецЕсли;
		
		ФайлыПриложений = Новый ТаблицаЗначений;
		ФайлыПриложений.Колонки.Добавить("ВидФайла");
		ФайлыПриложений.Колонки.Добавить("ИмяФайла");
		ФайлыПриложений.Колонки.Добавить("ФайлПриложения");
		ФайлыПриложений.Колонки.Добавить("ФайлПриложенияПодписьСотрудникаФонда");
		ФайлыПриложений.Колонки.Добавить("ФайлПриложенияПодписьФонда");
		
		Для каждого ФайлПриложения из РеквизитыДокумента.ДвоичныеДанныеФайловПриложений Цикл
			НовыйФайлПриложения											= ФайлыПриложений.Добавить();
			НовыйФайлПриложения.ВидФайла								= ФайлПриложения.ВидФайла;
			НовыйФайлПриложения.ИмяФайла								= ФайлПриложения.ИмяФайла;
			НовыйФайлПриложения.ФайлПриложенияПодписьСотрудникаФонда	= ФайлПриложения.ФайлПриложенияПодписьСотрудникаФонда;
			НовыйФайлПриложения.ФайлПриложенияПодписьФонда				= ФайлПриложения.ФайлПриложенияПодписьФонда;
			
			ПараметрыФайла 						= РаботаСФайлами.ПараметрыДобавленияФайла("Идентификатор, Кодировка");
			ПараметрыФайла.РасширениеБезТочки	= ФайлПриложения.РасширениеФайла;
			ПараметрыФайла.Служебный			= Истина;
			ПараметрыФайла.Идентификатор		= РеквизитыДокумента.ИдентификаторСообщения;
			ПараметрыФайла.ВладелецФайлов		= ДокументОбъект.Ссылка;
			ПараметрыФайла.ИмяБезРасширения		= ФайлПриложения.ИмяФайла;
			АдресДвоичныхДанных 				= ПоместитьВоВременноеХранилище(ФайлПриложения.ДвоичныеДанныеФайлаПриложения);
			НовыйФайлПриложения.ФайлПриложения	= РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДвоичныхДанных);
		КонецЦикла;
		
		// Запись ссылки на файл в реквизиты документа.
		ДокументОбъект.Прочитать();
		ДокументОбъект.ВходящийФайл = СсылкаФайла;
		Для каждого ФайлПриложения из ФайлыПриложений Цикл
			НовыйФайл = ДокументОбъект.ФайлыПриложений.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйФайл, ФайлПриложения);
		КонецЦикла;
		ДокументОбъект.Записать();
		
		ЗаписатьНовоеСобытие(ДокументОбъект.Ссылка, Страхователь, ТипСообщения);
		
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		
		Шаблон = НСтр("ru = 'Произошла ошибка при загрузке данных сообщения с типом %1: %2.';
						|en = 'An error occurred when importing data of the message with the %1 type: %2.'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ОписаниеОшибки = СтрШаблон(Шаблон, ТипСообщения, ТекстОшибки);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		
		// Записываем подробную информацию в журнал.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);
		
		Возврат;
	КонецПопытки;
	
	Результат.Обработано = Истина;
	
КонецПроцедуры

// Загрузка сообщений типов 315, 316 СЭДО.
Процедура ЗагрузитьСообщениеУведомлениеОПриеме(
	Страхователь,
	ИдентификаторСообщения,
	ТекстXML,
	ТребуетсяПодтверждение,
	Результат,
	ТипСообщения) Экспорт
	
	// Объявляем локальные переменные, чтобы не было ошибки из-за совпадения имен с объектами потребителей.
	Перем РеквизитыДокумента;
	Перем СтатусыДокументовОтвета;
	Перем Чтение;
	Перем ДанныеОтвета;
	Перем ТекстОшибки;
	Перем ЕстьНовыйСтатус;
	Перем НомерСтатуса;
	Перем УзелДокумента;
	Перем НоваяСтрока;
	Перем Запрос;
	Перем РезультатЗапроса;
	Перем Выборка;
	Перем ДокументТребованияСсылка;
	Перем ДокументОтветаСсылка;
	Перем Изменено;
	Перем ДокументТребованияОбъект;
	Перем УведомленияОПриемеОтказе;
	Перем СтрокПринято;
	Перем СтрокНеПринято;
	Перем ДанныеСтатусаДокумента;
	Перем ПараметрыОтбора;
	Перем Уведомления;
	Перем Строка;
	Перем КоличествоСтатусов;
	Перем СтатусОтвета;
	Перем СтатусОтветаТекстовый;
	Перем Отправка;
	Перем ОтправкаОбъект;
	Перем СтрокУведомлений;
	
	// Проверка входных параметров
	Если НЕ ЗначениеЗаполнено(Страхователь) Тогда
		ОшибкаОбработки(Результат, ИдентификаторСообщения, НСтр("ru = 'Не указан страхователь';
																|en = 'The insurant is not specified'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекстXML) Тогда
		ОшибкаОбработки(Результат, ИдентификаторСообщения, НСтр("ru = 'Отсутствует текст XML';
																|en = 'XML text is missing'"));
		Возврат;
	КонецЕсли;
	
	// Пример текста сообщения:
	//<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	//<ns2:notificationDocKp xmlns="http://www.fss.ru/integration/type/NotificationDocType/v01" xmlns:ns2="http://www.fss.ru/integration/kp/KpNotificationDocsAsv/v01">
	//	<responseOn>f49ebf18-15b1-4221-8b57-64b0e3470336</responseOn>
	//	<idMessage>98917df5-9283-45d7-8255-6ae752cd1c93</idMessage>
	//	<date>2024-10-30T17:07:12.362Z</date>
	//	<insurer>
	//		<insurerName>ООО Тест</insurerName>
	//	</insurer>
	//	<statusDocument>
	//		<idDocumentsGroup>2</idDocumentsGroup>
	//		<typeDocument>324</typeDocument>
	//		<count>1</count>
	//		<status>1</status>
	//	</statusDocument>
	//</ns2:notificationDocKp>

	УстановитьПривилегированныйРежим(Истина);
	
	// Данные из xml
	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("ВидДокументаФСС");
	РеквизитыДокумента.Вставить("ДатаИмпорта");
	РеквизитыДокумента.Вставить("ВходящаяДата");
	РеквизитыДокумента.Вставить("Загружено");
	РеквизитыДокумента.Вставить("ТребуетсяПодтверждение");
	РеквизитыДокумента.Вставить("ТипСообщения");
	РеквизитыДокумента.Вставить("ИдентификаторТребования");
	РеквизитыДокумента.Вставить("ДатаИВремяПриемаОтказа");
	РеквизитыДокумента.Вставить("ИдентификаторОтветаНаТребование");
	
	РеквизитыДокумента.ТипСообщения = ТипСообщения;
	РеквизитыДокумента.ВидДокументаФСС = ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения);
	РеквизитыДокумента.ДатаИмпорта = ТекущаяДатаСеанса();
	РеквизитыДокумента.Загружено = Истина;
	РеквизитыДокумента.ТребуетсяПодтверждение = ТребуетсяПодтверждение;
	
	СтатусыДокументовОтвета = Новый ТаблицаЗначений;
	СтатусыДокументовОтвета.Колонки.Добавить("ОтветНаТребованиеФСС");
	СтатусыДокументовОтвета.Колонки.Добавить("ИдентификаторСообщенияПротокола");
	СтатусыДокументовОтвета.Колонки.Добавить("ДатаПолученияПротокола");
	СтатусыДокументовОтвета.Колонки.Добавить("НаборДокументов");
	СтатусыДокументовОтвета.Колонки.Добавить("ВидДокумента");
	СтатусыДокументовОтвета.Колонки.Добавить("КоличествоДокументовВоВложении");
	СтатусыДокументовОтвета.Колонки.Добавить("Статус");
	СтатусыДокументовОтвета.Колонки.Добавить("ПричинаОтказа");
	СтатусыДокументовОтвета.Колонки.Добавить("ИдентификаторТребования");
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстXML);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При загрузке XML-содержимого сообщения ФСС %1 возникла ошибка: %2';
				|en = 'An error occurred while importing the XML content of SSF notification %1: %2'"),
			ИдентификаторСообщения,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстОшибки, Истина);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Если ЕстьСвойствоXDTO(ДанныеОтвета, "idMessage") Тогда
		РеквизитыДокумента.ИдентификаторТребования = ДанныеОтвета.idMessage;
	КонецЕсли;
		
	Если ЕстьСвойствоXDTO(ДанныеОтвета, "responseOn") Тогда
		РеквизитыДокумента.ИдентификаторОтветаНаТребование = ДанныеОтвета.responseOn;
	КонецЕсли;
		
	Если ЕстьСвойствоXDTO(ДанныеОтвета, "date") Тогда
		РеквизитыДокумента.ДатаИВремяПриемаОтказа = ЗначениеСвойстваУзлаXDTO(ДанныеОтвета,
			"date", , "Дата");
	КонецЕсли;
	
	Если ЕстьСвойствоXDTO(ДанныеОтвета, "statusDocument") Тогда
		ЕстьНовыйСтатус = ЗначениеВКоллекцию(ДанныеОтвета.statusDocument);
		Для НомерСтатуса = 0 По ЕстьНовыйСтатус.Количество() - 1 Цикл
			УзелДокумента = ЕстьНовыйСтатус[НомерСтатуса];
			НоваяСтрока 								= СтатусыДокументовОтвета.Добавить();
			НоваяСтрока.ИдентификаторСообщенияПротокола	= ИдентификаторСообщения;
			НоваяСтрока.ДатаПолученияПротокола			= РеквизитыДокумента.ДатаИВремяПриемаОтказа;
			НоваяСтрока.НаборДокументов					= ЗначениеСвойстваУзлаXDTO(УзелДокумента,
				"idDocumentsGroup", 0, "Число");
			НоваяСтрока.ВидДокумента					= ЗначениеСвойстваУзлаXDTO(УзелДокумента,
				"typeDocument", 0, "Число");
			НоваяСтрока.КоличествоДокументовВоВложении	= ЗначениеСвойстваУзлаXDTO(УзелДокумента,
				"count", 0, "Число");
			НоваяСтрока.Статус							= ЗначениеСвойстваУзлаXDTO(УзелДокумента,
				"status", 0, "Число");
			Если ЕстьСвойствоXDTO(УзелДокумента,"reason") Тогда
				НоваяСтрока.ПричинаОтказа					= ЗначениеСвойстваУзлаXDTO(УзелДокумента.reason,
					"description");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Единый запрос для поиска требования и ответа.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВходящийДокументСЭДОФСС.Ссылка КАК ТребованиеФСС
		|ПОМЕСТИТЬ ВТ_Требование
		|ИЗ
		|	Документ.ВходящийДокументСЭДОФСС КАК ВходящийДокументСЭДОФСС
		|ГДЕ
		|	НЕ ВходящийДокументСЭДОФСС.ПометкаУдаления
		|	И ВходящийДокументСЭДОФСС.ИдентификаторСообщения = &ИдентификаторСообщенияТребования
		|	И ВходящийДокументСЭДОФСС.Организация = &Организация
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТребованиеФСС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтветСтрахователя.Ссылка КАК ОтветСсылка,
		|	ВТ_Требование.ТребованиеФСС КАК ТребованиеФСС,
		|	ОтветСтрахователя.Основание КАК Основание
		|ПОМЕСТИТЬ ВТ_Ответы
		|ИЗ
		|	ВТ_Требование КАК ВТ_Требование
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтветСтрахователяНаТребованиеПроверкиФСС КАК ОтветСтрахователя
		|		ПО ВТ_Требование.ТребованиеФСС = ОтветСтрахователя.Основание
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОтветСсылка,
		|	ТребованиеФСС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПредоставленныеДокументы.Ссылка КАК ОтветСсылка,
		|	ПредоставленныеДокументы.ИдентификаторСообщенияОтвета КАК ИдентификаторОтвета
		|ПОМЕСТИТЬ ВТ_ПредоставленныеДокументы
		|ИЗ
		|	ВТ_Ответы КАК ВТ_Ответы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтветСтрахователяНаТребованиеПроверкиФСС.ПредоставленныеДокументы КАК ПредоставленныеДокументы
		|		ПО ВТ_Ответы.ОтветСсылка = ПредоставленныеДокументы.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОтветСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВТ_Ответы.ОтветСсылка КАК ОтветСсылка,
		|	ВТ_Ответы.ТребованиеФСС КАК ТребованиеФСС
		|ИЗ
		|	ВТ_Ответы КАК ВТ_Ответы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПредоставленныеДокументы КАК ВТ_ПредоставленныеДокументы
		|		ПО ВТ_Ответы.ОтветСсылка = ВТ_ПредоставленныеДокументы.ОтветСсылка
		|ГДЕ
		|	ВТ_ПредоставленныеДокументы.ИдентификаторОтвета = &ИдентификаторОтветаНаТребование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Требование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Ответы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ПредоставленныеДокументы";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщенияТребования", РеквизитыДокумента.ИдентификаторТребования);
	Запрос.УстановитьПараметр("ИдентификаторОтветаНаТребование", РеквизитыДокумента.ИдентификаторОтветаНаТребование);
	Запрос.УстановитьПараметр("Организация", Страхователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не найдено входящее требование ФСС с идентификатором %1 или исходящий ответ с идентификатором %2';
				|en = 'No incoming SSF request with ID %1 or outgoing response with ID %2 is found'"),
			РеквизитыДокумента.ИдентификаторТребования,
			РеквизитыДокумента.ИдентификаторОтветаНаТребование);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выгрузить();
	ДокументТребованияСсылка = Выборка[0].ТребованиеФСС;
	ДокументОтветаСсылка = Выборка[0].ОтветСсылка;
	
	Если НЕ ЗначениеЗаполнено(ДокументТребованияСсылка) Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось найти документ требования с идентификатором %1';
				|en = 'Cannot find the requirement document with ID %1'"),
			РеквизитыДокумента.ИдентификаторТребования);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОтветаСсылка) Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось найти документ ответа для требования %1';
				|en = 'Cannot find the response document for the %1 requirement'"),
			ДокументТребованияСсылка);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Изменено = Ложь;
	ДокументТребованияОбъект = ДокументТребованияСсылка.ПолучитьОбъект();
	УведомленияОПриемеОтказе = ДокументТребованияОбъект.УведомленияОПриемеОтказе;
	СтрокПринято = 0;
	СтрокНеПринято = 0;
	Для каждого ДанныеСтатусаДокумента из СтатусыДокументовОтвета Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НаборДокументов", ДанныеСтатусаДокумента.НаборДокументов);
		Уведомления = УведомленияОПриемеОтказе.НайтиСтроки(ПараметрыОтбора);
		
		Если Уведомления.Количество() = 0 Тогда
			НоваяСтрока									= ДокументТребованияОбъект.УведомленияОПриемеОтказе.Добавить();
			НоваяСтрока.ОтветНаТребованиеФСС			= ДокументОтветаСсылка;
			НоваяСтрока.ИдентификаторСообщенияПротокола	= ИдентификаторСообщения;
			НоваяСтрока.ДатаПолученияПротокола			= РеквизитыДокумента.ДатаИВремяПриемаОтказа;
			НоваяСтрока.НаборДокументов					= ДанныеСтатусаДокумента.НаборДокументов;
			НоваяСтрока.ВидДокумента					= ДанныеСтатусаДокумента.ВидДокумента;
			НоваяСтрока.КоличествоДокументовВоВложении	= ДанныеСтатусаДокумента.КоличествоДокументовВоВложении;
			НоваяСтрока.Статус							= ДанныеСтатусаДокумента.Статус;
			НоваяСтрока.ПричинаОтказа					= ДанныеСтатусаДокумента.ПричинаОтказа;
		Иначе
			Для каждого Строка из Уведомления Цикл
				Строка.Статус = ДанныеСтатусаДокумента.Статус;
				Строка.ПричинаОтказа = ДанныеСтатусаДокумента.ПричинаОтказа;
			КонецЦикла;
		КонецЕсли;
		
		Если ДанныеСтатусаДокумента.Статус = 1 Тогда
			СтрокПринято = СтрокПринято + 1;
		Иначе
			СтрокНеПринято = СтрокНеПринято + 1;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоСтатусов = СтатусыДокументовОтвета.Количество();
	Если СтрокПринято = КоличествоСтатусов Тогда
		СтатусОтвета = Перечисления.СтатусыОтправки.Сдан;
		СтатусОтветаТекстовый = НСтр("ru = 'Принят';
									|en = 'Принят'");
	ИначеЕсли СтрокНеПринято = КоличествоСтатусов Тогда
		СтатусОтвета = Перечисления.СтатусыОтправки.НеПринят;
		СтатусОтветаТекстовый = НСтр("ru = 'Не принят';
									|en = 'Not accepted'");
	Иначе
		СтатусОтвета = Перечисления.СтатусыОтправки.ПринятЕстьОшибки;
		СтатусОтветаТекстовый = НСтр("ru = 'Принят частично';
									|en = 'Partially accepted'");
	КонецЕсли;

	// Отправка формируется при обмене через оператора.
	Отправка = ПолучитьПоследнююОтправкуОтчетаВФСС(ДокументОтветаСсылка);
	Если ЗначениеЗаполнено(Отправка)
		И НЕ Отправка.СтатусОтправки = СтатусОтвета Тогда
		ОтправкаОбъект = Отправка.ПолучитьОбъект();
		ОтправкаОбъект.СтатусОтправки = СтатусОтвета;
		Попытка
			ОтправкаОбъект.Записать();
			ЗаписатьНовоеСобытие(ДокументОтветаСсылка, Страхователь, ТипСообщения, СтатусОтветаТекстовый);
		Исключение
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Ошибка записи отправки СФР %1: %2';
					|en = 'Error recording the sending of the Social Insurance Fund of Russia %1: %2'"),
				Отправка,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	// Вычисление статуса требования.
	СтрокУведомлений = ДокументТребованияОбъект.УведомленияОПриемеОтказе.Количество();
	Если СтрокУведомлений > 0 Тогда
		СтрокПринято = 0;
		СтрокНеПринято = 0;
		Для каждого Строка Из ДокументТребованияОбъект.УведомленияОПриемеОтказе Цикл
			Если Строка.Статус = 1 Тогда
				СтрокПринято = СтрокПринято + 1;
			Иначе
				СтрокНеПринято = СтрокНеПринято + 1;
			КонецЕсли;
		КонецЦикла;
		Если СтрокПринято + СтрокНеПринято = СтрокУведомлений Тогда
			Если СтрокПринято = СтрокУведомлений Тогда
				ДокументТребованияОбъект.Статус = НСтр("ru = 'Ответ принят';
														|en = 'The response is accepted'");
			Иначе
				Если СтрокНеПринято = СтрокУведомлений Тогда
					ДокументТребованияОбъект.Статус = НСтр("ru = 'Ответ не принят';
															|en = 'The response is not accepted'");
				Иначе
					ДокументТребованияОбъект.Статус = НСтр("ru = 'Ответ принят частично';
															|en = 'The response is partially accepted'");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ДокументТребованияОбъект.Записать();
		ЗаписатьНовоеСобытие(ДокументТребованияСсылка, Страхователь, ДокументТребованияОбъект.ТипСообщения, ДокументТребованияОбъект.Статус);
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка записи документа требования %1: %2';
				|en = 'Error saving the %1 requirement document: %2'"),
			ДокументТребованияСсылка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Результат.Обработано = Истина;
	
КонецПроцедуры

Процедура ЗагрузитьСообщение318(
	Страхователь,
	ИдентификаторСообщения,
	ТекстXML,
	ТребуетсяПодтверждение,
	Результат,
	ТипСообщения) Экспорт
	
	// Пример
	// <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	// <AppResult responseOn="6427337a-438d-408c-aec3-182fd0f8c801" xmlns="http://www.fss.ru/integration/types/ls/v01">
	//  <regNum>3101253258</regNum>
	//  <idMessage>5edf5d2d-ff5e-4fca-83a1-941d8dcb85da</idMessage>
	//  <id>7fac93e8-0d07-4c66-b9c6-aa33e18ba35c</id>
	//  <date>2022-11-29T17:30:02.820</date>
	//  <dateStart>2022-11-29</dateStart>
	// </AppResult>
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВидыДокументовСЭДОФССДоходнаяЧасть = ПолучитьВидыДокументовСЭДОФССДоходнаяЧасть();
	
	// Данные из xml
	РеквизитыДокумента = РеквизитыДокументаДоходнойЧастиСЭДО();
	РеквизитыДокумента.ТипСообщения = ТипСообщения;
	РеквизитыДокумента.ВидДокументаФСС = ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения);
	РеквизитыДокумента.ДатаИмпорта = ТекущаяДатаСеанса();
	РеквизитыДокумента.Загружено = Истина;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстXML);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При загрузке XML-содержимого сообщения ФСС %1 возникла ошибка: %2';
				|en = 'An error occurred while importing the XML content of SSF notification %1: %2'"),
			ИдентификаторСообщения,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Если ЕстьСвойство(ДанныеОтвета, "id") Тогда
		РеквизитыДокумента.ИдентификаторСообщения = ДанныеОтвета.id;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		РеквизитыДокумента.ИдентификаторСообщения = ДанныеОтвета.responseOn;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РеквизитыДокумента.ИдентификаторСообщения) Тогда
		ОписаниеОшибки = НСтр("ru = 'Не заполнен идентификатор сообщения заявления на формирование справки о расчетах.';
								|en = 'An ID of the message with an application for generating an AR/AP statement is not filled.'");
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	// Поиск элемента.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.Ссылка КАК Ссылка,
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.ИмяФайлаСправки КАК ИмяФайлаСправки,
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.Статус КАК Статус
	               |ИЗ
	               |	Документ.ЗаявлениеНаФормированиеСправкиОРасчетах КАК ЗаявлениеНаФормированиеСправкиОРасчетах
	               |ГДЕ
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.ИдентификаторСообщения = &ИдентификаторСообщения
	               |	И НЕ ЗаявлениеНаФормированиеСправкиОРасчетах.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", РеквизитыДокумента.ИдентификаторСообщения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Шаблон = НСтр("ru = 'Не найдено заявление на формирование справки о расчетах по идентификатору %1.';
						|en = 'An application for generating an AR/AP statement is not found by ID %1.'");
		ОписаниеОшибки = СтрШаблон(Шаблон, РеквизитыДокумента.ИдентификаторСообщения);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		Возврат;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ПустаяСтрока(Выборка.ИмяФайлаСправки) Тогда
				// Справка уже была загружен ранее.
				Результат.Обработано = Истина;
				Возврат;
			КонецЕсли;
			НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
			Попытка
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ДокументОбъект.Статус = "Зарегистрировано";
				ДокументОбъект.ДатаДоставкиВФСС = ТекущаяДатаСеанса();
				ДокументОбъект.Записать();
				
				ЗаписатьНовоеСобытие(ДокументОбъект.Ссылка, Страхователь, ТипСообщения);
				ЗафиксироватьТранзакцию();
			Исключение
				
				ОтменитьТранзакцию();
				
				Шаблон = НСтр("ru = 'Произошла ошибка при загрузке данных сообщения с типом 318: %1.';
								|en = 'An error occurred when importing data of the message with type 318: %1.'");
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
				ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
				ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
				
				// Записываем подробную информацию в журнал.
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
				ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);
				
				Возврат;
				
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Результат.Обработано = Истина;
	
КонецПроцедуры

Процедура ЗагрузитьСообщение319(
	Страхователь,
	ИдентификаторСообщения,
	ТекстXML,
	ТребуетсяПодтверждение,
	Результат,
	ТипСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВидыДокументовСЭДОФССДоходнаяЧасть = ПолучитьВидыДокументовСЭДОФССДоходнаяЧасть();
	
	// Данные из xml
	РеквизитыДокумента = РеквизитыДокументаДоходнойЧастиСЭДО();
	РеквизитыДокумента.ТипСообщения = ТипСообщения;
	РеквизитыДокумента.ВидДокументаФСС = ПредставлениеДокументаПоТипуСообщенияСЭДО(ТипСообщения);
	РеквизитыДокумента.ДатаИмпорта = ТекущаяДатаСеанса();
	РеквизитыДокумента.Загружено = Истина;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстXML);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При загрузке XML-содержимого сообщения ФСС %1 возникла ошибка: %2';
				|en = 'An error occurred while importing the XML content of SSF notification %1: %2'"),
			ИдентификаторСообщения,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Если ЕстьСвойство(ДанныеОтвета, "id") Тогда
		РеквизитыДокумента.ИдентификаторСообщения = ДанныеОтвета.id;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		РеквизитыДокумента.ИдентификаторСообщения = ДанныеОтвета.responseOn;
	КонецЕсли;
		
	Если ДанныеОтвета.Свойства().Получить("regNum") <> Неопределено Тогда
		РеквизитыДокумента.Организация = Страхователь;
	КонецЕсли;
		
	Если ДанныеОтвета.Свойства().Получить("date") <> Неопределено Тогда
		РеквизитыДокумента.ВходящаяДата = XMLЗначение(Тип("Дата"), ДанныеОтвета.date);
	КонецЕсли;
		
	Если ДанныеОтвета.Свойства().Получить("number") <> Неопределено Тогда
		РеквизитыДокумента.ВходящийНомер = Формат(ДанныеОтвета.number, "ЧГ=");
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("dateStart") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.dateStart) Тогда
		
		РеквизитыДокумента.ДатаЗадолженности = XMLЗначение(Тип("Дата"), ДанныеОтвета.dateStart);
	КонецЕсли;
		
	Если ДанныеОтвета.Свойства().Получить("attachment") <> Неопределено Тогда
		УзелВложения = ДанныеОтвета.attachment;
		
		Если УзелВложения.Свойства().Получить("content") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.content) Тогда
			
			РеквизитыДокумента.ДвоичныеДанныеФайлаВложения = Base64Значение(УзелВложения.content);
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("signatureEmpl") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.signatureEmpl) Тогда
			
			РеквизитыДокумента.ВходящийФайлПодписьСотрудникаФонда = Новый ХранилищеЗначения(УзелВложения.signatureEmpl);
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("signatureFund") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.signatureFund) Тогда
			
			РеквизитыДокумента.ВходящийФайлПодписьФонда = Новый ХранилищеЗначения(УзелВложения.signatureFund);
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("ext") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.ext) И
			УзелВложения.Свойства().Получить("name") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.name) Тогда
			
			РеквизитыДокумента.ИмяФайлаВложения = УзелВложения.name + "." + УзелВложения.ext;
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("size") <> Неопределено
			И ЗначениеЗаполнено(УзелВложения.size) Тогда
			
			РеквизитыДокумента.РазмерФайлаВложения = УзелВложения.size;
			
		КонецЕсли;
		
		Если УзелВложения.Свойства().Получить("application") <> Неопределено Тогда
			
			Для Каждого УзелПриложения Из ЗначениеВКоллекцию(УзелВложения.application) Цикл
				
				РеквизитыДокумента.ДвоичныеДанныеВходящегоФайлаСПодписьюФонда = Base64Значение(УзелПриложения.content);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РеквизитыДокумента.ИдентификаторСообщения) Тогда
		ОписаниеОшибки = НСтр("ru = 'Не заполнен идентификатор сообщения заявления на формирование справки о расчетах.';
								|en = 'An ID of the message with an application for generating an AR/AP statement is not filled.'");
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	// Поиск элемента.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.Ссылка КАК Ссылка,
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.ИмяФайлаСправки КАК ИмяФайлаСправки
	               |ИЗ
	               |	Документ.ЗаявлениеНаФормированиеСправкиОРасчетах КАК ЗаявлениеНаФормированиеСправкиОРасчетах
	               |ГДЕ
	               |	ЗаявлениеНаФормированиеСправкиОРасчетах.ИдентификаторСообщения = &ИдентификаторСообщения
	               |	И НЕ ЗаявлениеНаФормированиеСправкиОРасчетах.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИдентификаторСообщения", РеквизитыДокумента.ИдентификаторСообщения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Шаблон = НСтр("ru = 'Не найдено заявление на формирование справки о расчетах по идентификатору %1.';
						|en = 'An application for generating an AR/AP statement is not found by ID %1.'");
		ОписаниеОшибки = СтрШаблон(Шаблон, РеквизитыДокумента.ИдентификаторСообщения);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		Возврат;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ПустаяСтрока(Выборка.ИмяФайлаСправки) Тогда
				// Документ уже был загружен ранее.
				Результат.Обработано = Истина;
				Возврат;
			КонецЕсли;
			НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
			Попытка
				ОбъектДокумента										= Выборка.Ссылка.ПолучитьОбъект();
				ОбъектДокумента.ИмяФайлаСправки						= РеквизитыДокумента.ИмяФайлаВложения;
				ОбъектДокумента.ИмяФайлаСправкиПредставление		= РеквизитыДокумента.ИмяФайлаВложения +
					" (" + ТекстовоеПредставлениеРазмераФайла(РеквизитыДокумента.РазмерФайлаВложения) + ")";
				ОбъектДокумента.Статус								= "Справка получена";
				ОбъектДокумента.ДатаПолученияСправки				= ТекущаяДатаСеанса();
				ОбъектДокумента.ВходящийФайлПодписьСотрудникаФонда	= РеквизитыДокумента.ВходящийФайлПодписьСотрудникаФонда;
				ОбъектДокумента.ВходящийФайлПодписьФонда			= РеквизитыДокумента.ВходящийФайлПодписьФонда;
				
				// Обновление присоединенного файла.
				ИмяБезРасширения = РеквизитыДокумента.ВидДокументаФСС +
				" " + РеквизитыДокумента.ВходящийНомер + " от " + Формат(РеквизитыДокумента.ВходящаяДата, "ДФ=dd.MM.yyyy");
				
				ПараметрыФайла 						= РаботаСФайлами.ПараметрыДобавленияФайла("Идентификатор, Кодировка");
				ПараметрыФайла.РасширениеБезТочки	= "pdf";
				ПараметрыФайла.Служебный			= Истина;
				ПараметрыФайла.Идентификатор		= РеквизитыДокумента.ИдентификаторСообщения;
				ПараметрыФайла.ВладелецФайлов		= Выборка.Ссылка;
				ПараметрыФайла.ИмяБезРасширения		= ИмяБезРасширения;
				АдресДвоичныхДанных 				= ПоместитьВоВременноеХранилище(РеквизитыДокумента.ДвоичныеДанныеФайлаВложения);
				СсылкаФайла							= РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДвоичныхДанных);
				// Запись ссылки на файл в реквизиты документа
				ОбъектДокумента.ВходящийФайл 		= СсылкаФайла;
				
				АдресДвоичныхДанных 						= ПоместитьВоВременноеХранилище(РеквизитыДокумента.ДвоичныеДанныеВходящегоФайлаСПодписьюФонда);
				СсылкаФайла									= РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДвоичныхДанных);
				// Запись ссылки на файл в реквизиты документа с печатью СФР
				ОбъектДокумента.ВходящийФайлСПодписьюФонда 	= СсылкаФайла;
				
				ОбъектДокумента.Записать();
				
				ЗаписатьНовоеСобытие(ОбъектДокумента.Ссылка, Страхователь, ТипСообщения);
				
				ЗафиксироватьТранзакцию();
			Исключение
				
				ОтменитьТранзакцию();
				Шаблон = НСтр("ru = 'Произошла ошибка при загрузке данных сообщения с типом 319: %1.';
								|en = 'An error occurred when importing data of the message with type 319: %1.'");
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
				ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
				ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
				
				// Записываем подробную информацию в журнал.
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
				ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);
				Возврат;
				
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Результат.Обработано = Истина;
	
КонецПроцедуры

Процедура ЗагрузитьСодержимоеРассылки(
	Страхователь,
	ИдентификаторСообщения,
	ТекстСообщения,
	ДатаСообщения,
	Результат) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Поиск элемента.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПерепискаСКонтролирующимиОрганами.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПерепискаСКонтролирующимиОрганами КАК ПерепискаСКонтролирующимиОрганами
	|ГДЕ
	|	ПерепискаСКонтролирующимиОрганами.Идентификатор = &Идентификатор
	|	И ПерепискаСКонтролирующимиОрганами.Тип = &Тип";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаССФР);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат.Обработано = Истина;
		Возврат;
	КонецЕсли;
	
	МаксимальнаяДлинаТемы = 100;
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	Попытка
		ТемаПереписки = ТекстСообщения;
		Если СтрДлина(ТекстСообщения) > МаксимальнаяДлинаТемы Тогда
			ТемаПереписки = Лев(ТекстСообщения, МаксимальнаяДлинаТемы);
			Если НЕ Прав(ТемаПереписки, 1) = Символы.НПП Тогда
				ПозицияБлижайшегоНПП = СтрНайти(ТемаПереписки, " ", НаправлениеПоиска.СКонца);
				ТемаПереписки = Сред(ТекстСообщения, 0, ПозицияБлижайшегоНПП - 1);
				Если СтрДлина(ТемаПереписки) + 6 <= МаксимальнаяДлинаТемы Тогда
					ТемаПереписки = ТемаПереписки + " [...]";
				Иначе
					ПозицияБлижайшегоНПП = СтрНайти(ТемаПереписки, " ", НаправлениеПоиска.СКонца);
					ТемаПереписки = Сред(ТемаПереписки, 0, ПозицияБлижайшегоНПП - 1) + " [...]";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СправочникОбъект				= Справочники.ПерепискаСКонтролирующимиОрганами.СоздатьЭлемент();
		СправочникОбъект.Наименование	= ТемаПереписки;
		СправочникОбъект.Организация	= Страхователь;
		СправочникОбъект.Получатель		= Страхователь;
		СправочникОбъект.Статус			= Перечисления.СтатусыПисем.Полученное;
		СправочникОбъект.ДатаСообщения	= ДатаСообщения;
		СправочникОбъект.ДатаОтправки	= ДатаСообщения;
		СправочникОбъект.Идентификатор	= ИдентификаторСообщения;
		СправочникОбъект.Тип			= Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаССФР;
		
		СправочникОбъект.Записать();
		
		ЗаписатьНовоеСобытие(СправочникОбъект.Ссылка, Страхователь, 0);
		
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		
		Шаблон = НСтр("ru = 'Произошла ошибка при загрузке данных сообщения рассылки СЭДО: %2.';
						|en = 'An error occurred when importing the EDI mailout message data: %2'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
		ОшибкаОбработки(Результат, ИдентификаторСообщения, ОписаниеОшибки);
		
		// Записываем подробную информацию в журнал.
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ОписаниеОшибки = СтрШаблон(Шаблон, ТекстОшибки);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);
		
		Возврат;
	КонецПопытки;
	
	Результат.Обработано = Истина;
	
КонецПроцедуры

Функция РабочихДнейДоПолученияДокументаДоходнаяЧастьСЭДО() Экспорт
	
	Возврат 6;
	
КонецФункции

#Область ОбращенияСФРКСтрахователю

// Обработка сообщений обращений к страхователям (типы 1000, 1001, 1002).
Процедура ОбработатьСодержимоеСообщенийОбращенийКСтрахователю(Организация, ДанныеСообщения, РезультатОбработки) Экспорт
	
	Если НЕ ДанныеСообщения.Свойство("ТекстСообщения") Тогда
		Возврат;
	КонецЕсли;
	
	Типы = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	
	ТекстСообщения = ДанныеСообщения.ТекстСообщения;
	Если ДанныеСообщения.Тип = Типы.ТипСообщенияОбращениеСФРКСтрахователю Тогда
		ОбработатьОбращениеСФРКСтрахователю(Организация, ДанныеСообщения, РезультатОбработки);
	ИначеЕсли ДанныеСообщения.Тип = Типы.ТипСообщенияРезультатПриемаОтветаНаОбращениеСФРКСтрахователю Тогда
		ОбработатьРезультатПриемаОтветаНаОбращениеСФРКСтрахователю(Организация, ДанныеСообщения, РезультатОбработки);
	Иначе
		Шаблон = НСтр("ru = 'Отсутствует обработчик для типа сообщения СЭДО %1.';
						|en = 'The data processor is missing for the EDI message type %1.'");
		ОписаниеОшибки = СтрШаблон(Шаблон, ДанныеСообщения.Тип);
		ВызватьИсключение(ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОбращениеСФРКСтрахователю(Организация, ДанныеСообщения, РезультатОбработки)
	
	ТекстСообщения = ДанныеСообщения.ТекстСообщения;
	ИдентификаторСообщения = ДанныеСообщения.Идентификатор;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстСообщения);
		ДанныеОбъекта = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Шаблон = НСтр("ru = 'При разборе содержимого обращения СФР к страхователю %1 возникла ошибка: %2';
						|en = 'An error occurred when parsing the contents of the ticket of the Social Security Fund of Russia to the insurant %1: %2'");
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = СтрШаблон(
					Шаблон,
					ИдентификаторСообщения,
					ПредставлениеОшибки + Символы.ПС + ТекстСообщения);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = СтрШаблон(
			Шаблон,
			ИдентификаторСообщения,
			ПредставлениеОшибки);
		ОшибкаОбработки(РезультатОбработки, ИдентификаторСообщения, ТекстОшибки);
		ДокументСсылка = НайтиОбращениеСФРКСтрахователю(Организация, ИдентификаторСообщения);
		Если ДокументСсылка.Пустая() Тогда
			Документ = Документы.ОбращениеСФРКСтрахователю.СоздатьДокумент();
			Документ.Идентификатор = ИдентификаторСообщения;
		Иначе
			Документ = ДокументСсылка.ПолучитьОбъект();
		КонецЕсли;
		Документ.Дата = ДанныеСообщения.Дата;
		Документ.ДатаЗагрузки = ДанныеСообщения.ДатаЗагрузки;
		Документ.ОшибкиПриЗагрузке = ТекстОшибки;
		Документ.Организация = Организация;
		Документ.Ответственный = Пользователи.ТекущийПользователь();
		Документ.Записать();
		Возврат;
	КонецПопытки;
	
	ДокументСсылка = НайтиОбращениеСФРКСтрахователю(Организация, ИдентификаторСообщения);
	Если ДокументСсылка.Пустая() Тогда
		Документ = Документы.ОбращениеСФРКСтрахователю.СоздатьДокумент();
		Документ.Идентификатор = ИдентификаторСообщения;
		ДокументСсылка = Документы.ОбращениеСФРКСтрахователю.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Документ.УстановитьСсылкуНового(ДокументСсылка);
	Иначе
		Документ = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Документ.ОшибкиПриЗагрузке = "";
	Если ЗначениеЗаполнено(ДанныеСообщения.Дата) Тогда
		Документ.Дата = ДанныеСообщения.Дата;
	Иначе
		Документ.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Документ.Организация = Организация;
	Если ДанныеСообщения.Свойство("ДатаЗагрузки") Тогда
		Документ.ДатаЗагрузки = ДанныеСообщения.ДатаЗагрузки;
	Иначе
		Документ.ДатаЗагрузки = ТекущаяДатаСеанса();
	КонецЕсли;
	Документ.Заголовок = ДанныеОбъекта.appealTitle;
	Документ.ТекстОбращения = ДанныеОбъекта.appealBody;
	Документ.Ответственный = Пользователи.ТекущийПользователь();
	
	// Разбор приложенных файлов.
	ОшибкиПоФайлам = Новый Массив;
	НомерФайла = 1;
	Если ЕстьСвойство(ДанныеОбъекта, "appealFile") Тогда
		Документ.ФайлыОбращения.Очистить();
		Для каждого ДанныеФайла Из ЗначениеВКоллекцию(ДанныеОбъекта.appealFile) Цикл
			СтрокаФайла = Документ.ФайлыОбращения.Добавить();
			СодержимоеФайла = ДанныеФайла.content;
			НаименованиеФайла = ДанныеФайла.fileName;
			СтрокаФайла.ИмяФайла = НаименованиеФайла;
			БинарныеДанныеФайла = Неопределено;
			ОписаниеФайла = "";
			Если СтрНайти(СодержимоеФайла,"data:") > 0 Тогда
				// Пример содержимого файла:
				// data:application/vnd.openxmlformats-officedocument.wordprocessingml.document;base64,UEsDBB...
				ЧастиСодержимого = СтрРазделить(СодержимоеФайла, ",");
				Если ЧастиСодержимого.ВГраница() < 1 Тогда
					ТекстОшибки = НСтр("ru = 'Не найдены данные файла обращения к страхователю.';
										|en = 'The data of the ticket to the insurer was not found.'");
					ОшибкиПоФайлам.Добавить(ТекстОшибки);
					Продолжить;
				КонецЕсли;
				ОписаниеФайла = ЧастиСодержимого[0];
				ДанныеФайлаСтрока = ЧастиСодержимого[1];
				БинарныеДанныеФайла = Base64Значение(ДанныеФайлаСтрока);
			Иначе
				// Содержимое только с base64.
				БинарныеДанныеФайла = Base64Значение(СодержимоеФайла);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(БинарныеДанныеФайла) Тогда
				ТекстОшибки = НСтр("ru = 'Не найдены данные файла обращения к страхователю.';
									|en = 'The data of the ticket to the insurer was not found.'");
				ОшибкиПоФайлам.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			ЧастиПолногоИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(НаименованиеФайла);
			ИмяБезРасширения = ЧастиПолногоИмени.ИмяБезРасширения;
			Расширение = "";
			Если ПустаяСтрока(ЧастиПолногоИмени.Расширение)
				И НЕ ПустаяСтрока(ОписаниеФайла) Тогда
				ЧастиОписания = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОписаниеФайла, ":;");
				Если ЧастиОписания.ВГраница() > 1 Тогда
					ТипФайлаMIME = ЧастиОписания[1];
					ТипИРасширение = ТипСодержимогоИРасширениеПоMIMEТипу(ТипФайлаMIME);
					Расширение = ТипИРасширение.Расширение;
				КонецЕсли;
			Иначе
				Если СтрДлина(ЧастиПолногоИмени.Расширение) > 1 Тогда
					Расширение = Сред(ЧастиПолногоИмени.Расширение, 2);
				КонецЕсли;
			КонецЕсли;
			
			АдресДвоичныхДанных 				= ПоместитьВоВременноеХранилище(БинарныеДанныеФайла);
			РезультатПоиска = НайтиФайлОбращенияКСтрахователю(ДокументСсылка, ИмяБезРасширения, НомерФайла);
			Если РезультатПоиска.Количество() = 0 Тогда
				ПараметрыФайла 						= РаботаСФайлами.ПараметрыДобавленияФайла("НомерФайла");
				ПараметрыФайла.РасширениеБезТочки	= Расширение;
				ПараметрыФайла.НомерФайла			= НомерФайла;
				ПараметрыФайла.ВладелецФайлов		= ДокументСсылка;
				ПараметрыФайла.ИмяБезРасширения		= ИмяБезРасширения;
				ПрисоединенныйФайл	= РаботаСФайлами.ДобавитьФайл(ПараметрыФайла,
					АдресДвоичныхДанных);
			Иначе
				ПрисоединенныйФайл 	= РезультатПоиска[0].Ссылка;
				ПараметрыФайла = Новый Структура;
				ПараметрыФайла.Вставить("АдресФайлаВоВременномХранилище", АдресДвоичныхДанных); 
				ПараметрыФайла.Вставить("АдресВременногоХранилищаТекста", ""); 
				РаботаСФайлами.ОбновитьФайл(ПрисоединенныйФайл, ПараметрыФайла);
			КонецЕсли;
			СтрокаФайла.Содержимое = ПрисоединенныйФайл;
			СтрокаФайла.Размер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ПрисоединенныйФайл, "Размер");
			НомерФайла = НомерФайла + 1;
		КонецЦикла;
	КонецЕсли;
	Если ОшибкиПоФайлам.Количество() > 0 Тогда
		ТекстОшибок = СтрСоединить(ОшибкиПоФайлам, Символы.ВК);
		ОшибкаОбработки(РезультатОбработки, ИдентификаторСообщения, ТекстОшибок);
		Документ.ОшибкиПриЗагрузке = ТекстОшибок;
	КонецЕсли;
	
	Документ.Записать();
	
	РезультатОбработки.Обработано = Истина;
	
КонецПроцедуры

Процедура ОбработатьРезультатПриемаОтветаНаОбращениеСФРКСтрахователю(Организация, ДанныеСообщения, РезультатОбработки)

	ТекстСообщения = ДанныеСообщения.ТекстСообщения;
	ИдентификаторСообщения = ДанныеСообщения.Идентификатор;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстСообщения);
		ДанныеОбъекта = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Шаблон = НСтр("ru = 'При разборе протокола обработки ответа на обращения СФР %1 возникла ошибка: %2';
						|en = 'An error occurred when parsing the processing protocol of the response to the tickets of the Social Security Fund of Russia%1: %2'");
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = СтрШаблон(
					Шаблон,
					ИдентификаторСообщения,
					ПредставлениеОшибки + Символы.ПС + ТекстСообщения);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
		ПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибки = СтрШаблон(
			Шаблон,
			ИдентификаторСообщения,
			ПредставлениеОшибки);
		ТекстОшибки = СтрШаблон(
					Шаблон,
					ИдентификаторСообщения,
					ПредставлениеОшибки);
		ВызватьИсключение(ТекстОшибки);
	КонецПопытки;
	
	ИдентификаторОтвета = ДанныеОбъекта.appealAnswerUuid;
	Статус = ДанныеОбъекта.status;
	ТипДата = Тип("Дата");
	ДатаПриемаОтвета = XMLЗначение(ТипДата, ДанныеОбъекта.date);
	
	ДокументСсылка = НайтиОтветНаОбращениеСФР(Организация, ИдентификаторОтвета);
	
	Если ДокументСсылка.Пустая() Тогда
		Шаблон = НСтр("ru = 'Не найден ответ на обращение СФР %1, возможно он был отправлен из другой программы.';
						|en = 'The response to the tickets of the Social Security Fund of Russia %1 was not found, it was probably sent from a different program.'");;
		ТекстОшибки = СтрШаблон(
					Шаблон,
					ИдентификаторОтвета);
		ОшибкаОбработки(РезультатОбработки, ИдентификаторСообщения, ТекстОшибки, , Истина);
		Возврат;
	Иначе
		ДокументОтвета = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если Статус = "RECEIVED" Тогда
		ДокументОтвета.Статус = Перечисления.СтатусыОтправки.Сдан;
	ИначеЕсли Статус = "ERROR" Тогда
		ДокументОтвета.Статус = Перечисления.СтатусыОтправки.НеПринят;
	Иначе
		Шаблон = НСтр("ru = 'Получен неизвестный результат приема ответа на обращение СФР ""%1"".';
						|en = 'An unknown result of response has been received to the ticket of the Social Security Fund of Russia ""%1"".'");;
		ТекстОшибки = СтрШаблон(
					Шаблон,
					Статус);
		ОшибкаОбработки(РезультатОбработки, ИдентификаторСообщения, ТекстОшибки, , Истина);
	КонецЕсли;
	
	Сжатие = Новый СжатиеДанных(9);
	ДокументОтвета.Квитанция = Новый ХранилищеЗначения(ТекстСообщения, Сжатие);
	ДокументОтвета.ДатаПолученияРезультата = ТекущаяДатаСеанса();
	ДокументОтвета.ДоставленоВСФР = Истина;
	ДокументОтвета.ДатаФормированияРезультатаПриема = ДатаПриемаОтвета;
	ДокументОтвета.ИдентификаторРезультата = ИдентификаторСообщения;
	
	ДанныеОбращения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОтвета.Основание, "Статус");
	ИзменятьСтатусОбращения = Ложь;
	Если НЕ ЗначениеЗаполнено(ДанныеОбращения.Статус)
		ИЛИ ДанныеОбращения.Статус = Перечисления.СтатусыОтправки.Отправлен Тогда
		ДокументОбращения = ДокументОтвета.Основание.ПолучитьОбъект();
		ДокументОбращения.Статус = ДокументОтвета.Статус;
		ДокументОбращения.Записать();
		ИзменятьСтатусОбращения = Истина;
	КонецЕсли;
	
	ДокументОтвета.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтправкиФСС.Ссылка КАК Ссылка,
	               |	ОтправкиФСС.ОтчетСсылка КАК ОтчетСсылка
	               |ИЗ
	               |	Справочник.ОтправкиФСС КАК ОтправкиФСС
	               |ГДЕ
	               |	ОтправкиФСС.ОтчетСсылка = &Ответ
	               |	И ОтправкиФСС.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтправкиФСС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ОтправкиФСС КАК ОтправкиФСС
	               |ГДЕ
	               |	ОтправкиФСС.ОтчетСсылка = &Обращение
	               |	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
	               |	И ОтправкиФСС.Организация = &Организация";
	Запрос.УстановитьПараметр("Ответ", ДокументСсылка);
	Запрос.УстановитьПараметр("Обращение", ДокументОтвета.Основание);
	Запрос.УстановитьПараметр("Организация", Организация);
	ОтправкиПакет = Запрос.ВыполнитьПакет();
	ОтправкиОтветы = ОтправкиПакет[0].Выгрузить();
	ОтправкиОбращения = ОтправкиПакет[1].Выгрузить();
	Если ОтправкиОтветы.Количество() > 0 Тогда
		Отправка = ОтправкиОтветы[0].Ссылка.ПолучитьОбъект();
		Отправка.СтатусОтправки = ДокументОтвета.Статус;
		Отправка.Записать();
	КонецЕсли;
	
	Если ИзменятьСтатусОбращения
		И ОтправкиОбращения.Количество() > 0 Тогда
		Отправка = ОтправкиОбращения[0].Ссылка.ПолучитьОбъект();
		Отправка.СтатусОтправки = ДокументОтвета.Статус;
		Отправка.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиОбращениеСФРКСтрахователю(Организация, Идентификатор)
	
	ПустаяСсылка = Документы.ОбращениеСФРКСтрахователю.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОбращениеСФРКСтрахователю.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ОбращениеСФРКСтрахователю КАК ОбращениеСФРКСтрахователю
	               |ГДЕ
	               |	ОбращениеСФРКСтрахователю.Идентификатор = &Идентификатор
	               |	И ОбращениеСФРКСтрахователю.Организация = &Организация
	               |	И ОбращениеСФРКСтрахователю.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатВыполнения = Запрос.Выполнить();
	Если РезультатВыполнения.Пустой() Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Выборка = РезультатВыполнения.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция НайтиОтветНаОбращениеСФР(Организация, Идентификатор)
	
