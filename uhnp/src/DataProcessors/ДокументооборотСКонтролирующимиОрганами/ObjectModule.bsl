	СоответствиеТипаСообщенияПредставлению.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументЦБ, 															"Результат приема отчетности");
	СоответствиеТипаСообщенияПредставлению.Вставить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДокументЦБ, 														"Результат обработки отчетности");
	
	Возврат СоответствиеТипаСообщенияПредставлению;
	
КонецФункции

Функция ПредставлениеТранспортногоСообщнияПоТипу(ТранспортноеСообщение) Экспорт

	СоответствиеТипаСообщенияПредставлению = СоответствиеТипаСообщенияПредставлению();
	Представление = СоответствиеТипаСообщенияПредставлению.Получить(ТранспортноеСообщение.Тип);
	
	Возврат Представление;
	
КонецФункции

Функция ПечатьВозможнаДляЦиклаОбмена(Тип) Экспорт
	
	Возврат Тип = Перечисления.ТипыЦикловОбмена.НалоговаяИлиБухгалтерскаяОтчетность 
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьПФР  
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьФСГС
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.Заявление
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ИОН
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.Представление
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.Документ
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ОбращениеНП
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.Рассылка
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.РассылкаГрупповая
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ПисьмоНО
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ИОС
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.НеформализованнаяПерепискаПФРИсходящие
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ПисьменноеОбращениеВФСГС
		ИЛИ Тип = Перечисления.ТипыЦикловОбмена.ОтчетностьЦБ;
	
КонецФункции

Функция ИмяПрограммыБИП() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВладелецТикета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ВладелецТикета();
	
	МодульИнтернетПоддержкаПользователей = ЭлектронныйДокументооборотСКонтролирующимиОрганами.МодульИнтернетПоддержкаПользователей();
	
	Если МодульИнтернетПоддержкаПользователей = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат МодульИнтернетПоддержкаПользователей.ИмяПрограммы();
	КонецЕсли;
	
КонецФункции

Функция ЭПДокСкана(ПрисоединенныйФайл) Экспорт
	
	СвойстваЭП = Новый Структура();
	СвойстваЭП.Вставить("ИмяФайла", 	"");
	СвойстваЭП.Вставить("АдресДанных", 	"");
	СвойстваЭП.Вставить("Размер", 	    0);
	
	Если ЭлектроннаяПодпись.УстановленныеПодписи(ПрисоединенныйФайл).Количество() = 0 Тогда
		Возврат СвойстваЭП;
	КонецЕсли;
	
	СвойстваПодписиПрисоединенногоФайла =  ЭлектроннаяПодпись.УстановленныеПодписи(ПрисоединенныйФайл)[0];
		
	ИмяФайла	= СвойстваПодписиПрисоединенногоФайла.ИмяФайлаПодписи;
	АдресДанных = ПоместитьВоВременноеХранилище(СвойстваПодписиПрисоединенногоФайла.Подпись, Новый УникальныйИдентификатор);
	
	СвойстваЭП.ИмяФайла 	= ИмяФайла;
	СвойстваЭП.АдресДанных 	= АдресДанных;
	СвойстваЭП.Размер 	    = СвойстваПодписиПрисоединенногоФайла.Подпись.Размер();
	
	Возврат СвойстваЭП;
	
КонецФункции

Функция АдресОтчетовЭДОКСОшибкамиРасшифровки() Экспорт
	
	Если ХранилищеОбщихНастроек.Загрузить(
		"ДокументооборотСКонтролирующимиОрганами_ОшибкиРасшифровкиЭДОКНапомнитьПозже") = Ложь Тогда
		
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Реком.по ошиб.расшиф.ЭДОК",
		Истина) Тогда
		
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЦиклыОбмена.Предмет КАК Отчет,
		|	МАКСИМУМ(ЦиклыОбмена.ДатаСоздания) КАК ДатаСоздания
		|ПОМЕСТИТЬ ДатыПоследнихОтправок
		|ИЗ
		|	Справочник.ЦиклыОбмена КАК ЦиклыОбмена
		|ГДЕ
		|	ЦиклыОбмена.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыЦикловОбмена.ОтчетностьПФР)
		|	И ЦиклыОбмена.ФорматДокументооборота = ЗНАЧЕНИЕ(Перечисление.ФорматыДокументооборотаСПФР.ЭДОК)
		|	И ЦиклыОбмена.ПометкаУдаления = ЛОЖЬ
		|	И ЦиклыОбмена.ДатаСоздания >= ДАТАВРЕМЯ(2024, 8, 24)
		|	И ЦиклыОбмена.Организация В(&Организации)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦиклыОбмена.Предмет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЦиклыОбмена.Ссылка КАК ЦиклОбмена,
		|	ЦиклыОбмена.Предмет КАК Отчет,
		|	ЦиклыОбмена.УчетнаяЗапись КАК УчетнаяЗапись,
		|	ТранспортноеСообщение.Ссылка КАК ТранспортноеСообщениеОшибки
		|ПОМЕСТИТЬ ПоследниеОтправки
		|ИЗ
		|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦиклыОбмена КАК ЦиклыОбмена
		|		ПО ЦиклыОбмена.Ссылка = ТранспортноеСообщение.ЦиклОбмена
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыПоследнихОтправок КАК ДатыПоследнихОтправок
		|		ПО (ДатыПоследнихОтправок.Отчет = ЦиклыОбмена.Предмет
		|			И ДатыПоследнихОтправок.ДатаСоздания = ЦиклыОбмена.ДатаСоздания)
		|ГДЕ
		|	ТранспортноеСообщение.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.УведомлениеОбОшибкеПФР)
		|	И ТранспортноеСообщение.ПометкаУдаления = ЛОЖЬ
		|	И ЦиклыОбмена.ПометкаУдаления = ЛОЖЬ
		|	И ЦиклыОбмена.Организация В(&Организации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПоследниеОтправки.ЦиклОбмена КАК ЦиклОбмена,
		|	ПоследниеОтправки.Отчет КАК Отчет,
		|	ПоследниеОтправки.УчетнаяЗапись КАК УчетнаяЗапись,
		|	ПоследниеОтправки.ТранспортноеСообщениеОшибки КАК ТранспортноеСообщениеОшибки
		|ПОМЕСТИТЬ ПоследниеОтправкиНетПротоколов
		|ИЗ
		|	ПоследниеОтправки КАК ПоследниеОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
		|		ПО (ТранспортноеСообщение.ЦиклОбмена = ПоследниеОтправки.ЦиклОбмена
		|			И ТранспортноеСообщение.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПротоколПФР))
		|ГДЕ
		|	ТранспортноеСообщение.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТранспортноеСообщение.ДатаТранспорта КАК ДатаОтправки,
		|	ТранспортноеСообщение.ЦиклОбмена КАК ЦиклОбмена
		|ПОМЕСТИТЬ ДатыОтправки
		|ИЗ
		|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеОтправкиНетПротоколов КАК ПоследниеОтправкиНетПротоколов
		|		ПО (ПоследниеОтправкиНетПротоколов.ЦиклОбмена = ТранспортноеСообщение.ЦиклОбмена)
		|ГДЕ
		|	ТранспортноеСообщение.Ссылка.Тип =
		|		ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР)
		|	И ТранспортноеСообщение.ПометкаУдаления = ЛОЖЬ
		|	И ТранспортноеСообщение.Отправитель В(&Организации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналОтчетовСтатусы.Организация,
		|	ЖурналОтчетовСтатусы.НаименованиеОтчета КАК Представление,
		|	ЖурналОтчетовСтатусы.ФинансовыйПериод КАК ФинансовыйПериод,
		|	ЖурналОтчетовСтатусы.ВариантОтчета КАК ВариантОтчета,
		|	ПоследниеОтправкиНетПротоколов.Отчет,
		|	ЖурналОтчетовСтатусы.Статус КАК Состояние,
		|	ЖурналОтчетовСтатусы.СостояниеСдачиОтчетности КАК СостояниеСдачиОтчетности,
		|	ДатыОтправки.ДатаОтправки КАК ДатаОтправки,
		|	ПоследниеОтправкиНетПротоколов.ЦиклОбмена КАК ЦиклОбмена,
		|	ПоследниеОтправкиНетПротоколов.УчетнаяЗапись КАК УчетнаяЗапись,
		|	УчетныеЗаписиДокументооборота.РежимАвтонастройки КАК РежимАвтонастройки,
		|	ПоследниеОтправкиНетПротоколов.ТранспортноеСообщениеОшибки КАК ТранспортноеСообщениеОшибки
		|ИЗ
		|	ПоследниеОтправкиНетПротоколов КАК ПоследниеОтправкиНетПротоколов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналОтчетовСтатусы КАК ЖурналОтчетовСтатусы
		|		ПО ПоследниеОтправкиНетПротоколов.Отчет = ЖурналОтчетовСтатусы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыОтправки КАК ДатыОтправки
		|		ПО (ДатыОтправки.ЦиклОбмена = ПоследниеОтправкиНетПротоколов.ЦиклОбмена)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
		|		ПО (УчетныеЗаписиДокументооборота.Ссылка = ПоследниеОтправкиНетПротоколов.УчетнаяЗапись)
		|ГДЕ
		|	ЖурналОтчетовСтатусы.ДатаОтправки >= ДАТАВРЕМЯ(2024, 8, 24)
		|	И ЖурналОтчетовСтатусы.Организация В (&Организации)
		|УПОРЯДОЧИТЬ ПО
		|	ЖурналОтчетовСтатусы.Организация");
	
	ОрганизацииПользователя = ОрганизацииПоУчетнымЗаписямПользователя();
	Запрос.УстановитьПараметр("Организации", ОрганизацииПользователя);
	
	ОтчетыЭДОК = Запрос.Выполнить().Выгрузить();
	
	ОтчетыСОшибками = ОтчетыЭДОК.Скопировать(); // чтобы скопировать колонки
	ОтчетыСОшибками.Очистить(); // чтобы скопировать колонки
	
	Для каждого Отчет Из ОтчетыЭДОК Цикл
		Попытка
			ОшибкиЭДОК = ПолучитьВложенияТранспортногоСообщения(
				Отчет.ТранспортноеСообщениеОшибки,
				Истина,
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ОписаниеОшибкиПФР);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Ошибки расшифровки ЭДОК';
					|en = 'EDI with regulatory authorities. EDOC decryption errors'"),
				УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Продолжить;
		КонецПопытки;
		
		Если ОшибкиЭДОК.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДанныеОшибки = ОшибкиЭДОК[0].Данные.Получить();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Ошибки расшифровки ЭДОК';
					|en = 'EDI with regulatory authorities. EDOC decryption errors'"),
				УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Продолжить;
		КонецПопытки;
		
		ТекстОшибки = ПолучитьСтрокуИзДвоичныхДанных(ДанныеОшибки, "utf-8");
		ТекстОшибки = ВРег(ТекстОшибки);
		Если СтрНайти(ТекстОшибки, "CRYPTO_KEY_NOT_EXIST") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ОтчетыСОшибками.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Отчет);
	КонецЦикла;
	
	Результат = Неопределено;
	Если ОтчетыСОшибками.Количество() = 0 Тогда
		ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ОшибкиРасшифровкиЭДОКНапомнитьПозже",,
			Ложь);
	Иначе
		Результат = ПоместитьВоВременноеХранилище(ОтчетыСОшибками, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПредупреждениеОНекорректныхСтатусахОтправкиПФР

Функция ТребуетсяПредупредитьОбОшибкеВСтатусахОтправкиПФР() Экспорт
	
	ТребуетсяПредупредить 	= Ложь;
	АдресОтчетов 			= Неопределено;
	
	ОтветИлиОтчеты = ХранилищеОбщихНастроек.Загрузить("ИзменениеСтатусаПФРСоСданоНаСданоЧастично2021_НапомнитьПозжеОтчеты");
	Если ОтветИлиОтчеты <> Ложь Тогда
		Если ОтветИлиОтчеты = Неопределено ИЛИ ОтветИлиОтчеты = Истина Тогда
			ОтветИлиОтчеты = ОтчетыПФРСНекорректнымиСтатусами();
			
			ХранилищеОбщихНастроек.Сохранить("ИзменениеСтатусаПФРСоСданоНаСданоЧастично2021_НапомнитьПозжеОтчеты",,
				?(ОтветИлиОтчеты = Неопределено, Ложь, ОтветИлиОтчеты));
		КонецЕсли;
		
		Если ОтветИлиОтчеты <> Неопределено Тогда
			ТребуетсяПредупредить = Истина;
			АдресОтчетов = ПоместитьВоВременноеХранилище(ОтветИлиОтчеты, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ТребуетсяПредупредить, АдресОтчетов", ТребуетсяПредупредить, АдресОтчетов);
	
КонецФункции

Функция ОтчетыПФРСНекорректнымиСтатусами()
	
	Попытка
		ВидыОтчетов = Новый Массив;
		ВидыОтчетов.Добавить(Справочники.ВидыОтправляемыхДокументов.СведенияОЗастрахованныхЛицахСЗВ_М);
		ВидыОтчетов.Добавить(Справочники.ВидыОтправляемыхДокументов.СведенияОСтраховомСтажеЗастрахованныхЛицСЗВ_СТАЖ);
		ВидыОтчетов.Добавить(Справочники.ВидыОтправляемыхДокументов.ДанныеОКорректировкеСведенийЗастрахованныхЛицСЗВ_КОРР);
		ВидыОтчетов.Добавить(Справочники.ВидыОтправляемыхДокументов.СведенияОЗаработкеСтажеЗастрахованныхЛицСЗВ_ИСХ);
		ВидыОтчетов.Добавить(Справочники.ВидыОтправляемыхДокументов.ОписьОДВ_1);
		
		ОрганизацииПоУчетнымЗаписям = ОрганизацииПоУчетнымЗаписямПользователя();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПоследнееТранспортноеСообщение.ЦиклОбмена.Предмет КАК Отчет,
			|	МАКСИМУМ(ПоследнееТранспортноеСообщение.ДатаТранспорта) КАК ДатаТранспорта
			|ПОМЕСТИТЬ ДатыПоследнихПротоколов
			|ИЗ
			|	Документ.ТранспортноеСообщение КАК ПоследнееТранспортноеСообщение
			|ГДЕ
			|	ПоследнееТранспортноеСообщение.Тип = &ПротоколПФР
			|	И ПоследнееТранспортноеСообщение.ПометкаУдаления = ЛОЖЬ
			|	И ПоследнееТранспортноеСообщение.ЦиклОбмена.ПометкаУдаления = ЛОЖЬ
			|	И ПоследнееТранспортноеСообщение.ЦиклОбмена.ФорматДокументооборота <>
			|		ЗНАЧЕНИЕ(Перечисление.ФорматыДокументооборотаСПФР.ЭДОК)
			|	И ПоследнееТранспортноеСообщение.ЦиклОбмена.ВидОтчета В(&ВидыОтчетов)
			|	И ПоследнееТранспортноеСообщение.Получатель В(&Организации)
			|
			|СГРУППИРОВАТЬ ПО
			|	ПоследнееТранспортноеСообщение.ЦиклОбмена.Предмет
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТранспортноеСообщение.ЦиклОбмена.Предмет КАК Отчет,
			|	МАКСИМУМ(ТранспортноеСообщение.Ссылка) КАК ТранспортноеСообщение,
			|	МАКСИМУМ(ТранспортноеСообщение.ЦиклОбмена) КАК ЦиклОбмена
			|ПОМЕСТИТЬ ПоследниеОтправки
			|ИЗ
			|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыПоследнихПротоколов КАК ДатыПоследнихПротоколов
			|		ПО (ДатыПоследнихПротоколов.Отчет = ТранспортноеСообщение.ЦиклОбмена.Предмет
			|			И ДатыПоследнихПротоколов.ДатаТранспорта = ТранспортноеСообщение.ДатаТранспорта)
			|ГДЕ
			|	ТранспортноеСообщение.Тип = &ПротоколПФР
			|	И ТранспортноеСообщение.ПометкаУдаления = ЛОЖЬ
			|	И ТранспортноеСообщение.ЦиклОбмена.ПометкаУдаления = ЛОЖЬ
			|	И ТранспортноеСообщение.ЦиклОбмена.ФорматДокументооборота <>
			|		ЗНАЧЕНИЕ(Перечисление.ФорматыДокументооборотаСПФР.ЭДОК)
			|	И ТранспортноеСообщение.ЦиклОбмена.ВидОтчета В(&ВидыОтчетов)
			|	И ТранспортноеСообщение.Получатель В(&Организации)
			|
			|СГРУППИРОВАТЬ ПО
			|	ТранспортноеСообщение.ЦиклОбмена.Предмет
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТранспортныеСообщения.Ссылка.ДатаТранспорта КАК ДатаОтправки,
			|	ТранспортныеСообщения.ЦиклОбмена КАК ЦиклОбмена
			|ПОМЕСТИТЬ ДатыОтправки
			|ИЗ
			|	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеОтправки КАК ПоследниеОтправки
			|		ПО (ТранспортныеСообщения.ЦиклОбмена = ПоследниеОтправки.ТранспортноеСообщение.ЦиклОбмена)
			|ГДЕ
			|	ТранспортныеСообщения.Ссылка.Тип = &ПервичноеСообщениеСодержащееОтчетностьПФР
			|	И ТранспортныеСообщения.ПометкаУдаления = ЛОЖЬ
			|	И ТранспортныеСообщения.ЦиклОбмена.ПометкаУдаления = ЛОЖЬ
			|	И ТранспортныеСообщения.ЦиклОбмена.ФорматДокументооборота <>
			|		ЗНАЧЕНИЕ(Перечисление.ФорматыДокументооборотаСПФР.ЭДОК)
			|	И ТранспортныеСообщения.ЦиклОбмена.ВидОтчета В(&ВидыОтчетов)
			|	И ТранспортныеСообщения.Отправитель В(&Организации)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЖурналОтчетовСтатусы.Организация,
			|	ЖурналОтчетовСтатусы.НаименованиеОтчета КАК Представление,
			|	ПоследниеОтправки.Отчет,
			|	ЖурналОтчетовСтатусы.Статус КАК Состояние,
			|	ЖурналОтчетовСтатусы.СостояниеСдачиОтчетности КАК СостояниеСдачиОтчетности,
			|	ДатыОтправки.ДатаОтправки КАК ДатаОтправки,
			|	ПоследниеОтправки.ТранспортноеСообщение КАК Протокол,
			|	ПоследниеОтправки.ЦиклОбмена КАК ЦиклОбмена,
			|	""Протокол ошибок"" КАК НаименованиеПротокола
			|ИЗ
			|	ПоследниеОтправки КАК ПоследниеОтправки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналОтчетовСтатусы КАК ЖурналОтчетовСтатусы
			|		ПО ПоследниеОтправки.Отчет = ЖурналОтчетовСтатусы.Ссылка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыОтправки КАК ДатыОтправки
			|		ПО (ДатыОтправки.ЦиклОбмена = ПоследниеОтправки.ЦиклОбмена)
			|ГДЕ
			|	ЖурналОтчетовСтатусы.Статус = ""Сдано""
			|	И ПоследниеОтправки.ТранспортноеСообщение.Тип = &ПротоколПФР
			|	И ЖурналОтчетовСтатусы.ДатаОтправки >= ДАТАВРЕМЯ(2021, 1, 21, 0, 0, 0)
			|	И ЖурналОтчетовСтатусы.Организация В (&Организации)";
		
		Запрос.УстановитьПараметр("ПротоколПФР", Перечисления.ТипыТранспортныхСообщений.ПротоколПФР);
		Запрос.УстановитьПараметр("ПервичноеСообщениеСодержащееОтчетностьПФР",
			Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР);
		Запрос.УстановитьПараметр("ВидыОтчетов", ВидыОтчетов);
		Запрос.УстановитьПараметр("Организации", ОрганизацииПоУчетнымЗаписям);
		
		ОтчетыПФР = Запрос.Выполнить().Выгрузить();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Анализ состояний отправки в ПФР';
				|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Неопределено;
	КонецПопытки;
	
	ОтчетыПФРСОшибками = ОтчетыПФР.Скопировать(); // чтобы скопировать колонки
	ОтчетыПФРСОшибками.Очистить(); // чтобы скопировать колонки
	
	Для каждого ОтчетПФР Из ОтчетыПФР Цикл
		ТипыВложений = Новый Массив;
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР);
		ТипыВложений.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР);
		
		Попытка
			ПротоколыИПриложенияПФР = ПолучитьВложенияТранспортногоСообщения(
				ОтчетПФР.Протокол,
				Истина,
				ТипыВложений);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Анализ состояний отправки в ПФР';
					|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Продолжить;
		КонецПопытки;
		
		Если ПротоколыИПриложенияПФР.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПротоколПФР = ПротоколыИПриложенияПФР.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПФР, "Тип");
		
		Если ПротоколПФР = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеПротокола = ПротоколПФР.Данные.Получить();
		Если ДанныеПротокола = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлПротокола = ПолучитьИмяВременногоФайла();
		Попытка
			ДанныеПротокола.Записать(ФайлПротокола);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Анализ состояний отправки в ПФР';
					|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Продолжить;
		КонецПопытки;
		
		ДеревоXML = ЗагрузитьXMLВДеревоЗначений(ФайлПротокола);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлПротокола);
		
		Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
			Продолжить;
		КонецЕсли;
		
		// оставляем только приложения к протоколам ПФР
		ИндексПоследнегоПротоколаИлиПриложенияПФР = ПротоколыИПриложенияПФР.Количество() - 1;
		Для ИндексПротоколаСКонца = 0 По ИндексПоследнегоПротоколаИлиПриложенияПФР Цикл
			ИндексПротокола = ИндексПоследнегоПротоколаИлиПриложенияПФР - ИндексПротоколаСКонца;
			Если ПротоколыИПриложенияПФР[ИндексПротокола].Тип <>
				Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПротоколПриложениеПФР Тогда
				ПротоколыИПриложенияПФР.Удалить(ИндексПротокола);
			КонецЕсли;
		КонецЦикла;
		
		АнализПриложенияПротокола = Неопределено;
		
		ПараметрыОтбора = Новый Структура("Имя, Тип", "приложение", "Э");
		УзлыПриложение = ДеревоXML.Строки.НайтиСтроки(ПараметрыОтбора, Истина);
		Для каждого УзелПриложение Из УзлыПриложение Цикл
			УзелИдентификаторДокумента = УзелПриложение.Строки.Найти("идентификаторДокумента", "Имя", Истина);
			УзелИмяФайла = УзелПриложение.Строки.Найти("имяФайла", "Имя", Истина);
			
			Если УзелИдентификаторДокумента <> Неопределено И УзелИмяФайла <> Неопределено
				И ЗначениеЗаполнено(УзелИдентификаторДокумента.Значение) И ЗначениеЗаполнено(УзелИмяФайла.Значение) Тогда
				
				ИдентификаторДокумента = СокрЛП(УзелИдентификаторДокумента.Значение);
				ИмяФайлаПриложения = СокрЛП(УзелИмяФайла.Значение);
				
				ПриложениеПротоколаПФР = ПротоколыИПриложенияПФР.Найти(ИдентификаторДокумента, "Идентификатор");
				Если ПриложениеПротоколаПФР <> Неопределено
					И ВРег(ПриложениеПротоколаПФР.ИмяФайла) <> ВРег(ИмяФайлаПриложения) Тогда
					
					Попытка
						НачатьТранзакцию();
					Исключение
						ИнформацияОбОшибке = ИнформацияОбОшибке();
						
						ЗаписьЖурналаРегистрации(
							НСтр("ru = 'Анализ состояний отправки в ПФР';
								|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
							УровеньЖурналаРегистрации.Ошибка,,,
							ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
						Продолжить;
					КонецПопытки;
					
					Попытка
						УдалитьСодержимоеТранспортногоКонтейнера(ОтчетПФР.Протокол, ПриложениеПротоколаПФР.ИмяФайла);
						
						Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
							ОтчетПФР.Протокол,
							ПриложениеПротоколаПФР.Тип,
							ПриложениеПротоколаПФР.Данные,
							ИмяФайлаПриложения,
							ПриложениеПротоколаПФР.Размер,
							ПриложениеПротоколаПФР.ЭЦПИмяПодписанногоФайла,
							ПриложениеПротоколаПФР.ЭЦПСертификат,
							ПриложениеПротоколаПФР.ЭЦПСтатусПроверки,
							ПриложениеПротоколаПФР.ЭЦПЭтоПодписьАбонента,
							ПриложениеПротоколаПФР.ТипФайлаОтчетностиПФР,
							ПриложениеПротоколаПФР.Идентификатор,
							ПриложениеПротоколаПФР.ТипСодержимогоФайла) Тогда
							
							ОтменитьТранзакцию();
							Продолжить;
						КонецЕсли;
						ЗафиксироватьТранзакцию();
					Исключение
						ОтменитьТранзакцию();
						
						ИнформацияОбОшибке = ИнформацияОбОшибке();
						
						ЗаписьЖурналаРегистрации(
							НСтр("ru = 'Анализ состояний отправки в ПФР';
								|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
							УровеньЖурналаРегистрации.Ошибка,,,
							ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
						Продолжить;
					КонецПопытки;
					
					ПриложениеПротоколаПФР.ИмяФайла = ИмяФайлаПриложения;
					
					Если ПриложениеПротоколаПФР.ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.xml Тогда
						Попытка
							АнализПриложенияПротокола = ОтчетПФРСданЧастично(,
								ПротоколыИПриложенияПФР,
								Перечисления.ФорматыДокументооборотаСПФР.БПИ);
						Исключение
							ИнформацияОбОшибке = ИнформацияОбОшибке();
							
							ЗаписьЖурналаРегистрации(
								НСтр("ru = 'Анализ состояний отправки в ПФР';
									|en = 'Analysis of PF sending states'", ОбщегоНазначения.КодОсновногоЯзыка()), 
								УровеньЖурналаРегистрации.Ошибка,,,
								ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
							Продолжить;
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если АнализПриложенияПротокола <> Неопределено
			И (АнализПриложенияПротокола.СданЧастично ИЛИ АнализПриложенияПротокола.НеСдан) Тогда
			
			Попытка
				УстановитьКорректноеЗначениеОшибкиПротоколаПФР(ОтчетПФР.Протокол);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Корректировка состояния отправки в ПФР';
						|en = 'Adjust sending state to PF'", ОбщегоНазначения.КодОсновногоЯзыка()), 
					УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				Продолжить;
			КонецПопытки;
			
			Попытка
				КорректныеСтатусы = УстановитьКорректныеСтатусыОтчетовПФР(ОтчетПФР.Отчет, ОтчетПФР.Организация);
				ОбновитьСтатусыСвязанногоОбъектаПриНеобходимости(ОтчетПФР.ЦиклОбмена, Истина);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Корректировка состояния отправки в ПФР';
						|en = 'Adjust sending state to PF'", ОбщегоНазначения.КодОсновногоЯзыка()), 
					УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				Продолжить;
			КонецПопытки;
			
			Если ЗначениеЗаполнено(КорректныеСтатусы.СтатусОтправки)
				ИЛИ ЗначениеЗаполнено(КорректныеСтатусы.СостояниеСдачиОтчетности) Тогда
				ОтчетПФР.Состояние 					= КорректныеСтатусы.СтатусОтправки;
				ОтчетПФР.СостояниеСдачиОтчетности 	= КорректныеСтатусы.СостояниеСдачиОтчетности;
			КонецЕсли;
			
			НоваяСтрока = ОтчетыПФРСОшибками.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОтчетПФР);
		КонецЕсли;
	КонецЦикла;
	
	Если ОтчетыПФРСОшибками.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОтчетыПФРСОшибками;
	
КонецФункции

Функция УстановитьКорректныеСтатусыОтчетовПФР(Отчет, Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусОтправки", 			Неопределено);
	Результат.Вставить("СостояниеСдачиОтчетности", 	Неопределено);
	
	НачатьТранзакцию();
	
	Попытка
		ВидКонтролирующегоОргана 	= Перечисления.ТипыКонтролирующихОрганов.ПФР;
		
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
			Отчет, Организация, ВидКонтролирующегоОргана, Результат.СостояниеСдачиОтчетности, Результат.СтатусОтправки);
		
		СтруктураКлюча = Новый Структура("Ссылка", Отчет);
		Ключ = РегистрыСведений.ЖурналОтчетовСтатусы.СоздатьКлючЗаписи(СтруктураКлюча);
		ЗаблокироватьДанныеДляРедактирования(Ключ);
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЖурналОтчетовСтатусы");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Отчет);
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ЖурналОтчетовСтатусы.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Ссылка.Установить(Отчет);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись из НаборЗаписей Цикл
			Запись.СостояниеСдачиОтчетности = Результат.СостояниеСдачиОтчетности;
			Запись.Статус 					= Результат.СтатусОтправки;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Корректировка состояния отправки в ПФР';
				|en = 'Adjust sending state to PF'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьКорректноеЗначениеОшибкиПротоколаПФР(ТранспортноеСообщение)
	
	Если ЯвляетсяОтрицательнымПротоколом(ТранспортноеСообщение) <> Ложь Тогда
		ТранспортноеСообщениеОбъект = ТранспортноеСообщение.ПолучитьОбъект();
		ТранспортноеСообщениеОбъект.ПротоколСОшибкой = Истина;
		ТранспортноеСообщениеОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ОпределениеИзмененныхПараметровПодключенияВФоне(ПолныеСвойстваВсехСертификатов, АдресРезультата) Экспорт
	
	Результат = ИзменившиесяПараметрыПодключения(ПолныеСвойстваВсехСертификатов);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Функция ВидимостьКнопкиВыгрузкиОтветаИОНИПодписи(Запрос) Экспорт

	Если ТипЗнч(Запрос) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика") Тогда
		Ответы            = ПолучитьОтветыНаЗапросИОН(Запрос); 
		ПоказатьКнопку    = Ответы.Количество() > 0;
	Иначе
		ПоказатьКнопку    = Ложь;
	КонецЕсли;
	
	Возврат ПоказатьКнопку;

КонецФункции

// Формирует список организаций доступных пользоветелю для обмена
//
// Параметры:
//	ВсеОрганизации - Булево
//
// Возвращаемое значение:
//	ТаблицаЗначений с колонками
//		* Организация		- СправочникСсылка.Организация
//		* НетОграничения	- Булево
//
Функция ОрганизацииСОграничениемПрав(ВсеОрганизации = Ложь) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА Организации.ВидОбменаСКонтролирующимиОрганами <> ЗНАЧЕНИЕ(Перечисление.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеЗаписиДокументооборота.ПустаяСсылка)
	|		ИНАЧЕ Организации.УчетнаяЗаписьОбмена
	|	КОНЕЦ КАК УчетнаяЗаписьОбмена,
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВсеОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И (Организации.ВидОбменаСКонтролирующимиОрганами = ЗНАЧЕНИЕ(Перечисление.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате)
	|				И Организации.УчетнаяЗаписьОбмена <> ЗНАЧЕНИЕ(Справочник.УчетныеЗаписиДокументооборота.ПустаяСсылка)
	|			ИЛИ &ВсеОрганизации = ИСТИНА)
	|	И &УсловиеПоОрганизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеОрганизации.Ссылка КАК Ссылка,
	|	ВсеОрганизации.УчетнаяЗаписьОбмена КАК УчетнаяЗаписьОбмена,
	|	НЕ РазрешенныеОрганизации.Ссылка ЕСТЬ NULL КАК НетОграничения
	|ИЗ
	|	ВсеОрганизации КАК ВсеОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОрганизации КАК РазрешенныеОрганизации
	|		ПО ВсеОрганизации.Ссылка = РазрешенныеОрганизации.Ссылка
	|			И (РазрешенныеОрганизации.УчетнаяЗаписьОбмена В (&ТекущиеУчетныеЗаписиНалогоплательщика))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВсеОрганизации.Наименование";
	
	Если ОбщегоНазначенияБРО.ИспользуетсяАрхив() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации", "НЕ Организации.ВАрхиве");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации", "Истина");
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТекущиеУчетныеЗаписиНалогоплательщика", ДокументооборотСКО.ТекущиеУчетныеЗаписиНалогоплательщика());
	Запрос.УстановитьПараметр("ВсеОрганизации", ВсеОрганизации);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Формирует массив организаций настроенных пользователем для обмена
//
// Параметры:
//	ВсеОрганизации - Массив
//
// Возвращаемое значение:
//	Массив
//
Функция ВыбранныеОрганизацииДляОбмена() Экспорт
	
	Результат = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключенныеОрганизацииОбменаСКО КАК ИсключенныеОрганизацииОбменаСКО
	|		ПО Организации.Ссылка = ИсключенныеОрганизацииОбменаСКО.Организация
	|			И (ИсключенныеОрганизацииОбменаСКО.Пользователь = &Пользователь)
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И ИсключенныеОрганизацииОбменаСКО.Организация ЕСТЬ NULL
	|	И &УсловиеПоОрганизации";
	
	Если ОбщегоНазначенияБРО.ИспользуетсяАрхив() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации", "НЕ Организации.ВАрхиве");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОрганизации", "Истина");
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТемаБезSPAM(Тема)
	
	СокрЛПТема = СокрЛП(Тема);
	
	// обход ситуации, когда тема модифицируется антиспам-фильтром
	Если ВРег(Лев(СокрЛПТема, 5)) = "[SPAM" Тогда
		ВхождениеЗакрывающейСкобки = СтрНайти(СокрЛПТема, "]");
		Если ВхождениеЗакрывающейСкобки <> 0 Тогда
			СокрЛПТема = СокрЛП(Сред(СокрЛПТема, ВхождениеЗакрывающейСкобки + 1));
		КонецЕсли;
	Конецесли;
	
	Возврат СокрЛПТема;
	
КонецФункции

Функция ЗаявлениеСвязаноСПолучениемСертификата(Заявление) Экспорт
	
	ЭтоПервичноеЗаявление    = Заявление.ТипЗаявления = Перечисления.ТипыЗаявленияАбонентаСпецоператораСвязи.Первичное;
	ИспользоватьСуществующий = ОбработкаЗаявленийАбонентаКлиентСервер.ИспользоватьСуществующий(Заявление);
	
	Если ЭтоПервичноеЗаявление Тогда
		
		ТребуетсяВПервичном = НЕ ИспользоватьСуществующий;
		Возврат ТребуетсяВПервичном;
		
	Иначе
		
		ЭтоСертификатКА = НЕ Заявление.ЭтоСертификатДругогоУЦ;
		
		ТребуетсяВоВторичном  = 
			НЕ ИспользоватьСуществующий 
			И ЭтоСертификатКА 
			И ЭтоПереизданиеСертификата(Заявление);

		Возврат ТребуетсяВоВторичном;
		
	КонецЕсли;
	
КонецФункции

Функция СертификатMYИзФайлаАвтонастройки(АдресФайлаАвтонастройки, Отпечаток) Экспорт
		
	Если ЭтоАдресВременногоХранилища(АдресФайлаАвтонастройки) Тогда
		
		СертификатыИзФайлаНастройки = ПолучитьСертификатыИзФайлаНастройки(АдресФайлаАвтонастройки);
		Для Каждого СертификатИзФайлаНастройки Из СертификатыИзФайлаНастройки Цикл
			
			ЭтоПодходящийСертификат = 
				Врег(СертификатИзФайлаНастройки.Хранилище) = "MY" 
				И (ЗначениеЗаполнено(Отпечаток) И ВРег(Отпечаток) = ВРег(СертификатИзФайлаНастройки.Отпечаток)
				ИЛИ НЕ ЗначениеЗаполнено(Отпечаток));
			
			Если ЭтоПодходящийСертификат Тогда
				ДвДанныеСертификата = СертификатИзФайлаНастройки.Сертификат;
				Возврат ДвДанныеСертификата;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьЦБВДокумент(ДокументЗаявление) Экспорт
	
	НоваяСтрокаНаправления = ДокументЗаявление.Получатели.Добавить();
	НоваяСтрокаНаправления.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ЦБ;
	НоваяСтрокаНаправления.КПП = "";
	
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		НоваяСтрокаНаправления.КодПолучателя = "99";
	Иначе
		НоваяСтрокаНаправления.КодПолучателя = "00";
	КонецЕсли;
	
КонецПроцедуры

#Область ОтправкаРегламентированногоОтчетаВЦБ

Функция ОтправкаРегламентированногоОтчетаВЦБ_ПередВыгрузкойФайла(Контекст, Док, УникальныйИдентификатор, ТекстСообщения) Экспорт

	Контекст = Новый Структура();
	Контекст.Вставить("Документ", Док);
	Контекст.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	Если НЕ ЗначениеЗаполнено(Док) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки.';
								|en = 'Document for sending is not selected.'");
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Организация");
	Если Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	СвойстваУчетнойЗаписи = ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСЦБ, ДоверенностьЦБ");
	Если СвойстваУчетнойЗаписи.ПредназначенаДляДокументооборотаСЦБ <> Истина Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	ТипЗнчДок = ТипЗнч(Док);
	МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчДок);
	Если МетаданныеОтчета = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Unknown report type.'");
		Возврат Ложь;
	КонецЕсли;
	
	// ВидОтправляемогоДокументаТипДокумента заполняется и анализиризуется лишь для внешних электронных представлений
	ВидОтправляемогоДокументаТипДокумента = Неопределено;
	
	ИмяМетаданныхОтчета = МетаданныеОтчета.Имя;
	Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док, "ДатаНачала, ДатаОкончания, ИсточникОтчета");
		ДатаНачалаПериодаОтчета = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета = ЗначенияРеквизитов.ДатаОкончания;
		ВидОтправляемогоОтчета = ЗначенияРеквизитов.ИсточникОтчета;
		
		НеобходимоНараститьСчетчикФайлов = Ложь;
		
	ИначеЕсли ИмяМетаданныхОтчета = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда // внешнее электронное представление
		
		ДатаНачалаПериодаОтчета = Док.ДатаНачала;
		ДатаОкончанияПериодаОтчета = Док.ДатаОкончания;
		ВидОтправляемогоОтчета = Док.ВидОтчета.Источник;
		
		ВидОтправляемогоДокументаТипДокумента = Док.ВидОтчета.ТипДокумента;
		
		НеобходимоНараститьСчетчикФайлов = Истина;
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Unknown report type.'");
		Возврат Ложь;
		
	КонецЕсли;
	
	// инициализируем переменные, зависящие от типа отчета
	ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ОтчетностьЦБ;
	ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ;
	ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиЦБ;
	
	// сертификаты подписи абонента
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток");
	Если НЕ Сертификат.Найден Тогда
		ТекстСообщения = Сертификат.ТекстОшибки;
		Возврат Ложь;
	КонецЕсли;
	
	Контекст.Вставить("Организация", 							Организация);
	Контекст.Вставить("ДатаНачалаПериодаОтчета", 				ДатаНачалаПериодаОтчета);
	Контекст.Вставить("ДатаОкончанияПериодаОтчета", 			ДатаОкончанияПериодаОтчета);
	Контекст.Вставить("ВидОтправляемогоОтчета", 				ВидОтправляемогоОтчета);
	Контекст.Вставить("ТипОтправляемогоДокумента", 				ИмяМетаданныхОтчета);
	Контекст.Вставить("ТипЦиклаОбмена", 						ТипЦиклаОбмена);
	Контекст.Вставить("ТипТранспортногоСообщения", 				ТипТранспортногоСообщения);
	Контекст.Вставить("ТипСодержимогоКонтейнера", 				ТипСодержимогоКонтейнера);
	Контекст.Вставить("НеобходимоНараститьСчетчикФайлов", 		НеобходимоНараститьСчетчикФайлов);
	Контекст.Вставить("УчетнаяЗапись", 							УчетнаяЗапись);
	Контекст.Вставить("ДоверенностьЦБ", 						СвойстваУчетнойЗаписи.ДоверенностьЦБ);
	Контекст.Вставить("СертификатРуководителя", 				Сертификат.Отпечаток); //+
	Контекст.Вставить("СертификатГлавногоБухгалтера", 			Сертификат.Отпечаток); //+
	Контекст.Вставить("СертификатОтветственногоЗаШифрование", 	Сертификат.Отпечаток); //+
	
	Возврат Истина;
	
КонецФункции

Функция ОтправкаРегламентированногоОтчетаВЦБ_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст) Экспорт
	
	РезультатФормирования = Неопределено;
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		МодульДокументооборотСБанкомРоссииВызовСервера =
			ОбщегоНазначения.ОбщийМодуль("ДокументооборотСБанкомРоссииВызовСервера");
		РезультатФормирования = МодульДокументооборотСБанкомРоссииВызовСервера.СформироватьАрхивСОтчетамиЦБ(Контекст);
	КонецЕсли;
	Если РезультатФормирования = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Отправка отчетности в Банк России не поддерживается.';
								|en = 'Reporting to the Bank of Russia is not supported.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли РезультатФормирования = Ложь Тогда
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСЦБ;
	ЦиклОбмена.Предмет = Контекст.Документ;
	ЦиклОбмена.Идентификатор = ?(Контекст.ОсновныеПоляОтчета <> Неопределено, Контекст.ОсновныеПоляОтчета.Идентификатор,
		СгенерироватьUUID());
	
	ТипОтправляемогоДокумента = Контекст.ТипОтправляемогоДокумента;
	Если ТипОтправляемогоДокумента = "РегламентированныйОтчет" Тогда
		РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", Контекст.ВидОтправляемогоОтчета);
		Если РезультатПоиска = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден элемент с именем объекта метаданных %1!';
									|en = 'The item with metadata object name %1 is not found in the ""Kinds of documents to be sent"" catalog.'"),
									Символ(34) + Контекст.ВидОтправляемогоОтчета + Символ(34));
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		ЦиклОбмена.ВидОтчета = РезультатПоиска;
		ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
		Если ТипОтправляемогоДокумента = "РегламентированныйОтчет" Тогда
			ЦиклОбмена.ВидДокумента = Контекст.Документ.Вид;
		КонецЕсли;
		
	Иначе
		ЦиклОбмена.ВидОтчета = Контекст.Документ.ВидОтчета;
		ЦиклОбмена.ВидДокумента = Контекст.Документ.Версия;
		ЦиклОбмена.Тип = Контекст.ТипЦиклаОбмена;
	КонецЕсли;
	
	ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
	ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	ЦиклОбмена.Организация = Контекст.Организация;
	ЦиклОбмена.УчетнаяЗапись = Контекст.УчетнаяЗапись;
	
	ЦиклОбмена.ВнешняяОрганизация = Контекст.УчетнаяЗапись.СерверДокументооборота;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = Контекст.ТипТранспортногоСообщения;
	ТранспортноеСообщение.Отправитель = Контекст.Организация;
	ТранспортноеСообщение.Получатель = Контекст.УчетнаяЗапись.СерверДокументооборота;
	ТранспортноеСообщение.УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	// ДОБАВЛЯЕМ ВЛОЖЕНИЯ
	
	// определяем кодировку и тип содержимого
	КодировкаФайла = "windows-1251";
	ТипСодержимого = Перечисления.ТипыСодержимогоФайлов.Неизвестный;
	
	// сохраняем выгрузку во временный файл
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
	Если ЭтоАдресВременногоХранилища(Контекст.ТекстВыгрузки) Тогда
		ДвоичныеДанныеФайлаВыгрузки = ПолучитьИзВременногоХранилища(Контекст.ТекстВыгрузки);
		ДвоичныеДанныеФайлаВыгрузки.Записать(ИмяВремФайла);
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Контекст.ТекстВыгрузки);
		Текст.Записать(ИмяВремФайла, КодировкаФайла);
	КонецЕсли;
	
	// добавляем ДИВ
	Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
		ТранспортноеСообщение.Ссылка,
		Контекст.ТипСодержимогоКонтейнера,
		ИмяВремФайла,
		Контекст.ИмяФайлаВыгрузки,,,,,,,
		СгенерироватьUUID(),
		ТипСодержимого) Тогда
		
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контекст.ДоверенностьЦБ) Тогда
		ПараметрыВозврата = Новый Структура;
		ПараметрыВозврата.Вставить("ВозвращатьПриложеннуюПодпись", Истина);
		РезультатВыгрузки = ДокументооборотСКОВызовСервера.ВыгрузитьМЧДЦБ(
			Контекст.ДоверенностьЦБ,
			Истина,
			ПараметрыВозврата);
		Если РезультатВыгрузки = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ТипЗнч(РезультатВыгрузки) <> Тип("Массив") И ТипЗнч(РезультатВыгрузки) <> Тип("ФиксированныйМассив")
			ИЛИ РезультатВыгрузки.Количество() < 2 Тогда
			
			ТекстСообщения = НСтр("ru = 'Машиночитаемая доверенность (Банк России) должна быть подписана доверителем или загружена с подписью доверителя.';
									|en = 'Machine-readable authorization letter (Bank of Russia) must be signed by an authorizing party or imported with the signature from the authorizing party.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		Для каждого ФайлВыгрузкиДоверенности Из РезультатВыгрузки Цикл
			ЭлементыИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ФайлВыгрузкиДоверенности.Имя);
			ЭтоПодписьДоверенности = (нрег(ЭлементыИмениФайла.Расширение) = ".sig");
			
			Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(
				ТранспортноеСообщение.Ссылка,
				?(ЭтоПодписьДоверенности, Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись,
					Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьЦБ),
				ФайлВыгрузкиДоверенности.Адрес,
				?(ЭтоПодписьДоверенности, ЭлементыИмениФайла.ИмяБезРасширения + ".xml.2.sig",
					ЭлементыИмениФайла.ИмяБезРасширения + ".xml.enc"),,
				?(ЭтоПодписьДоверенности, ЭлементыИмениФайла.ИмяБезРасширения + ".xml.enc", Неопределено),,
				?(ЭтоПодписьДоверенности, ПредопределенноеЗначение("Перечисление.СтатусыПроверкиЭЦП.Валидна"), Неопределено),
				Истина,,
				СгенерироватьUUID(),
				?(ЭтоПодписьДоверенности, Неопределено, Перечисления.ТипыСодержимогоФайлов.xml)) Тогда
				
				ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
										|en = 'Report sending is canceled.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// пишем цикл обмена
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	
	Возврат Истина;
	
КонецФункции

Функция ВыгрузитьРегламентированныйОтчетЦБИзВнешнихЭлектронныхПредставлений(Контекст) Экспорт
	
	Результат = Новый Массив;
	
	ФайлыДИВ = ИзвлечьЭлектронныеПредставленияИзХранилища(Контекст.Документ);
	Если ФайлыДИВ <> Неопределено Тогда
		Для Каждого ФайлДИВ Из ФайлыДИВ Цикл
			СтрРезультат = Новый Структура("Документ, Тип, Имя, Адрес, ВАрхиве");
			СтрРезультат.Документ = Контекст.Документ;
			СтрРезультат.Тип = ФайлДИВ.ТипФайлаОтчетности;
			СтрРезультат.Имя = ФайлДИВ.ИмяФайла;
			СтрРезультат.ВАрхиве = ФайлДИВ.ВАрхиве;
			СтрРезультат.Адрес = ПоместитьВоВременноеХранилище(ФайлДИВ.Данные, Контекст.УникальныйИдентификатор);
			
			Результат.Добавить(СтрРезультат);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьПакетЦБ_ПроверкиСертификатовПослеПолученияСертификатовРазобратьНайденное(
		Сертификаты,
		СертификатРуководителя, //+
		СертификатГлавногоБухгалтера, //+
		СертификатОтветственногоЗаШифрование) Экспорт //+
	
	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя); //+
	ОтпечатокСертификатГлавногоБухгалтера = СокрЛП(СертификатГлавногоБухгалтера); //+
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование); //+
	
	ОбъектСертификатРуководителя = Неопределено;
	ОбъектСертификатГлавногоБухгалтера = Неопределено;
	ОбъектСертификатОтветственногоЗаШифрование = Неопределено;
	
	Для каждого НайденныйСертификат Из Сертификаты Цикл
		Если ОтпечатокСертификатРуководителя = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатРуководителя = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатГлавногоБухгалтера = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатГлавногоБухгалтера = НайденныйСертификат;
		КонецЕсли;
		Если ОтпечатокСертификатОтветственногоЗаШифрование = НайденныйСертификат.Отпечаток Тогда
			ОбъектСертификатОтветственногоЗаШифрование = НайденныйСертификат;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектСертификатРуководителя = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат руководителя в системном хранилище сертификатов.';
								|en = 'Cannot find a manager certificate in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;

	// Сертификат мог быть получен без проверки на валидность, тогда в его свойствах не будет такого поля.
	Если ОбъектСертификатРуководителя.Свойство("Валиден") И НЕ ОбъектСертификатРуководителя.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат руководителя не валиден.';
								|en = 'Manager certificate is not valid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтпечатокСертификатГлавногоБухгалтера) И ОбъектСертификатГлавногоБухгалтера = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат главного бухгалтера в системном хранилище сертификатов.';
								|en = 'Cannot find a certificate of the Chief Accountant in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСертификатГлавногоБухгалтера) 
		И ОбъектСертификатГлавногоБухгалтера.Свойство("Валиден") И НЕ ОбъектСертификатГлавногоБухгалтера.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат главного бухгалтера не валиден.';
								|en = 'Chief accountant certificate is not valid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОтпечатокСертификатОтветственногоЗаШифрование = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось найти сертификат ответственного за шифрование в системном хранилище сертификатов.';
								|en = 'Cannot find a certificate of the person responsible for encryption in the system certificate storage.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектСертификатОтветственногоЗаШифрование.Свойство("Валиден") И НЕ ОбъектСертификатОтветственногоЗаШифрование.Валиден Тогда
		ТекстСообщения = НСтр("ru = 'Сертификат ответственного за шифрование не валиден.';
								|en = 'Certificate of the person responsible for encryption is invalid.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ОбъектСертификатРуководителя",               ОбъектСертификатРуководителя);
	Результат.Вставить("ОбъектСертификатГлавногоБухгалтера",         ОбъектСертификатГлавногоБухгалтера);
	Результат.Вставить("ОбъектСертификатОтветственногоЗаШифрование", ОбъектСертификатОтветственногоЗаШифрование);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СформироватьПакетЦБ

Функция СформироватьПакетЦБ_ПодготовитьСертификатыДляПоиска(
	УчетнаяЗапись, 
	СертификатРуководителя, //+ 
	СертификатГлавногоБухгалтера, //+
	СертификатОтветственногоЗаШифрование) Экспорт //+

	МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(УчетнаяЗапись);
	
	СертификатыДляПоиска = Новый Массив;
	
	ОтпечатокСертификатРуководителя = СокрЛП(СертификатРуководителя); //+
	ОтпечатокСертификатГлавногоБухгалтера = СокрЛП(СертификатГлавногоБухгалтера); //+
	ОтпечатокСертификатОтветственногоЗаШифрование = СокрЛП(СертификатОтветственногоЗаШифрование); //+
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатРуководителя) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат руководителя.';
				|en = 'Manager certificate is not specified in settings of account %1.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатРуководителя);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтпечатокСертификатГлавногоБухгалтера) Тогда
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатГлавногоБухгалтера);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификатОтветственногоЗаШифрование) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В настройках учетной записи %1 не задан сертификат ответственного за шифрование.';
				|en = 'Certificate of the person responsible for encryption is not specified in account %1 settings.'"), УчетнаяЗапись);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		НовыйСертификат = Новый Структура("Отпечаток", ОтпечатокСертификатОтветственногоЗаШифрование);
		КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(МестоХраненияКлюча, НовыйСертификат);
		СертификатыДляПоиска.Добавить(НовыйСертификат);
	КонецЕсли;
	
	Возврат СертификатыДляПоиска;

КонецФункции

Функция СформироватьПакетЦБ_ОбщиеПроверкиПередФормированием(Контекст) Экспорт
	
	Сообщение = Контекст.ТранспортноеСообщение;
	СообщениеТема = Сообщение.Тема;
	
	// проверка на то, что сообщение исходящее
	СтатусТранспортногоСообщения = Сообщение.Статус;
	Если СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Сохраненное
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Исходящее
	И СтатусТранспортногоСообщения <> Перечисления.СтатусыПисем.Отправленное Тогда
		ТекстСообщения = НСтр("ru = 'Невозможно формирование пакета по входящему сообщению!';
								|en = 'Cannot generate a package from the incoming message.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ПризнакОшибки = Ложь;
	
	ТипСообщения = Сообщение.Тип;
	
	СсылкаОтправитель = Сообщение.Отправитель;
	СсылкаПолучатель = ОпределитьПолучателяТранспортногоКонтейнера(Сообщение);
	УчетнаяЗапись = Сообщение.УчетнаяЗапись;
	ЦиклОбмена = Сообщение.ЦиклОбмена;
	СообщениеОснование = Сообщение.Основание;
	
	Если НЕ ЗначениеЗаполнено(ТипСообщения) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: тип транспортного сообщения не определен!';
								|en = 'An error occurred while encrypting the transport message: the transport message type is not determined.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаОтправитель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задан отправитель!';
								|en = 'An error occurred while encrypting the transport message: sender is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаПолучатель) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не удалось определить получателя!';
								|en = 'An error occurred while encrypting the transport message: cannot identify a recipient.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: не задана учетная запись!';
								|en = 'An error occurred while encrypting the transport message: account is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	ИначеЕсли НЕ УчетнаяЗапись.ПредназначенаДляДокументооборотаСЦБ Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: учетная запись не предназначена для электронного документооборота с ЦБ!';
								|en = 'An error occurred when encrypting a transport message: the account is not for electronic data interchange with the Bank of Russia.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦиклОбмена) Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка шифрования транспортного сообщения: цикл обмена не задан!';
								|en = 'An error occurred while encrypting the transport message: exchange cycle is not specified.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		ПризнакОшибки = Истина;
	КонецЕсли;
	
	// определяем сертификат получателя
	СертификатПолучателя = ПолучитьСертификатСубъекта(СсылкаПолучатель);
	
	// определяем сертификаты отправителя
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток");
	Если НЕ Сертификат.Найден Тогда
		ТекстСообщения = Сертификат.ТекстОшибки;
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// запоминаем в контексте
	Контекст.Вставить("ТипСообщения", ТипСообщения);
	Контекст.Вставить("СсылкаОтправитель", СсылкаОтправитель);
	Контекст.Вставить("СсылкаПолучатель", СсылкаПолучатель);
	Контекст.Вставить("СсылкаСерверДокументооборота", УчетнаяЗапись.СерверДокументооборота);
	Контекст.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена);
	Контекст.Вставить("СертификатРуководителя", СокрЛП(Сертификат.Отпечаток)); //+
	Контекст.Вставить("СертификатГлавногоБухгалтера", СокрЛП(Сертификат.Отпечаток)); //+
	Контекст.Вставить("СертификатОтветственногоЗаШифрование", СокрЛП(Сертификат.Отпечаток)); //+
	Контекст.Вставить("СертификатПолучателя", СертификатПолучателя);
	Контекст.Вставить("СертификатСервераДокументооборота", Неопределено);
	
	Контекст.Вставить("ТипТранспортногоСообщения", ТипСообщения);
	Контекст.Вставить("СообщениеОснование", СообщениеОснование);
	
	Возврат НЕ ПризнакОшибки;
	
КонецФункции

Функция СформироватьПакетЦБ_ПолучитьИПроверитьСертификатыПолучателяПослеПолученияСертификатовРазобратьНайденное(
		Выполнено,
		НайденныеСертификаты,
		НенайденныеСертификаты,
		СсылкаПолучатель,
		ИнформацияОПолучателяхИСертификатах = Неопределено) Экспорт
	
	Если ИнформацияОПолучателяхИСертификатах = Неопределено Тогда
		СертификатСервераДокументооборота 	= Неопределено;
		СсылкаСерверДокументооборота 		= Неопределено;
		СертификатПолучателя 				= Неопределено;
	Иначе
		СертификатСервераДокументооборота 	= СокрЛП(ИнформацияОПолучателяхИСертификатах.СертификатСервераДокументооборота);
		СсылкаСерверДокументооборота 		= ИнформацияОПолучателяхИСертификатах.СсылкаСерверДокументооборота;
		СертификатПолучателя 				= ИнформацияОПолучателяхИСертификатах.СертификатПолучателя;
	КонецЕсли;
	
	Если Не Выполнено Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СертификатСервераДокументооборота) Тогда
		Для каждого НенайденныйСертификат Из НенайденныеСертификаты Цикл
			Если СокрЛП(НенайденныйСертификат.Отпечаток) = СертификатСервераДокументооборота Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось определить цифровой сертификат сервера документооборота %1.';
						|en = 'Cannot determine a digital certificate of data interchange server %1.'"),
					СсылкаСерверДокументооборота);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НенайденныеСертификаты.Количество() > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось определить цифровой сертификат получателя
                  |%1
                  |для шифрования сообщения!';
                  |en = 'Cannot determine a digital certificate of recipient 
                  |%1
                  |for encrypting the message.'"), СсылкаПолучатель);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексСертификатаСервераДокументооборота = -1;
	Если ТипЗнч(СсылкаПолучатель) = Тип("СправочникСсылка.СерверыДокументооборота") Тогда
		// Проверяем сертификат.
		Если НЕ НайденныеСертификаты[0].Валиден Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Ошибка проверки сертификата сервера документооборота %1.';
					|en = 'An error occurred while checking a certificate of data interchange server %1.'"), СсылкаПолучатель);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НайденныеСертификатыПолучателя", НайденныеСертификаты);
	Результат.Вставить("НайденныйСертификатСервераДокументооборота", Неопределено);
	
	Если ИндексСертификатаСервераДокументооборота <> -1 Тогда
		Если СертификатПолучателя <> СертификатСервераДокументооборота И (ТипЗнч(СертификатПолучателя) <> Тип("Массив")
			ИЛИ СертификатПолучателя.Найти(СертификатСервераДокументооборота) = Неопределено) Тогда
			
			Результат.НайденныеСертификатыПолучателя = ОбщегоНазначения.СкопироватьРекурсивно(НайденныеСертификаты);
			Результат.НайденныеСертификатыПолучателя.Удалить(ИндексСертификатаСервераДокументооборота);
		КонецЕсли;
		
		Результат.НайденныйСертификатСервераДокументооборота = НайденныеСертификаты[ИндексСертификатаСервераДокументооборота];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьПакетЦБ_ПроверкиНаСервере(Контекст) Экспорт
	
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	СсылкаПолучатель = Контекст.СсылкаПолучатель;
	ЦиклОбмена = Контекст.ЦиклОбмена;
	
	// получаем и проверяем код отправителя
	КодОтправителя = СокрЛП(УчетнаяЗапись.ИдентификаторАбонента);
	Если ПустаяСтрока(КодОтправителя) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан идентификатор абонента в свойствах учетной записи.';
								|en = 'Subscriber ID is not specified in the account properties.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// получаем код оператора электронного документооборота
	Если УчетнаяЗапись.ОбменНапрямую Тогда
		КодСпецоператора = Неопределено;
	Иначе
		КодСпецоператора = СокрЛП(УчетнаяЗапись.ИдентификаторСпецоператора);
		Если ПустаяСтрока(КодСпецоператора) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан идентификатор оператор электронного документооборота в свойствах учетной записи.';
									|en = 'ID of the electronic data interchange provider is not specified in the account properties.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// получаем и проверяем код получателя
	КодПолучателя = СокрЛП(УчетнаяЗапись.ИдентификаторСпецоператора);
	Если ПустаяСтрока(КодПолучателя) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан идентификатор оператора электронного документооборота в свойствах учетной записи.';
								|en = 'ID of the electronic data interchange provider is not specified in the account properties.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	ТипПолучателя = "спецоператор";
	
	//
	UUIDПакета = СокрЛП(ЦиклОбмена.Идентификатор);
	
	Контекст.Вставить("КодОтправителя", КодОтправителя);
	Контекст.Вставить("КодСпецоператора", КодСпецоператора);
	Контекст.Вставить("КодПолучателя", КодПолучателя);
	Контекст.Вставить("ТипПолучателя", ТипПолучателя);
	Контекст.Вставить("UUIDПакета", UUIDПакета);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьПакетЦБ_ЗаключительныеДействияНаСервере(Контекст) Экспорт
	
	ДеревоДокументов = ПолучитьИзВременногоХранилища(Контекст.ДеревоДокументов);
	
	//////////////////////////////////////////////////////////////////////////////
	// СОЗДАНИЕ АРХИВА ПАКЕТА
	
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	КодЦБ = "00";
	Если ДокументооборотСКОВызовСервера.ИспользуетсяРежимТестирования() Тогда
		КодЦБ = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_КодЦБ");
		КодЦБ = ?(ЗначениеЗаполнено(КодЦБ), КодЦБ, "99");
	КонецЕсли;
	КороткоеИмяФайлаАрхива = "CB_" + Сред(Контекст.КодОтправителя, 4) + "_" + КодЦБ
		+ "_" + Контекст.ЦиклОбмена.Идентификатор + ".zip";
	ПолноеИмяФайлаАрхива = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайлаАрхива;
	
	ЗаписьZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаАрхива, , , МетодСжатияZIP.Копирование); // архив пакета создается без сжатия
	Для каждого СтрДокумент Из ДеревоДокументов.Строки Цикл
		
		ПолноеИмяФайлаПакета = ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент);
		ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		
		Для каждого СтрДокумент2 Из СтрДокумент.Строки Цикл
			ПолноеИмяФайлаПакета = ВыгрузитьФайлПакетаИзВременногоХранилищаВКаталог(КаталогФайловОтчетности, СтрДокумент2);
			ЗаписьZIP.Добавить(ПолноеИмяФайлаПакета);
		КонецЦикла;
		
	КонецЦикла;
	
	// добавляем описание пакета
	ЗаписьZIP.Записать();
	
	//////////////////////////////////////////////////////////////////////////////
	// ДОБАВЛЕНИЕ ПАКЕТА В РЕГИСТР КОНТЕЙНЕРОВ
	
	ДобавитьТранспортныйКонтейнер(Контекст.ТранспортноеСообщение, ПолноеИмяФайлаАрхива, КороткоеИмяФайлаАрхива);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ПолноеИмяФайлаАрхива);
	
	Для каждого Строка Из ДеревоДокументов.Строки Цикл
		УдалитьИзВременногоХранилища(Строка.Адрес);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьПакетЦБ_СформироватьДеревоОписанияДокументовПакета(Контекст) Экспорт
	
	// определяем структуру с отложенными командами
	ОтложенныеКоманды = Новый СписокЗначений;
	СвойстваОтложенныхКоманд = Новый Соответствие;
	
	// создаем вспомогательное дерево описания документов пакета
	ДеревоДокументов = СоздатьДеревоОписанияДокументовПакета();
	
	// выгружаем все файлы сообщения во временный каталог
	КаталогФайловОтчетности = ОперацииСФайламиЭДКО.СоздатьВременныйКаталог();
	
	// выгружаем все содержимое во временное хранилище
	ТипыСодержимого = Новый Массив;
	ТипыШифруемогоСодержимого = Новый Массив;
	
	Если Контекст.ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ Тогда
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиЦБ);
		ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьЦБ);
		
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиЦБ);
		ТипыШифруемогоСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ДоверенностьЦБ);
	КонецЕсли;
	ТипыСодержимого.Добавить(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
	
	ВложенияДИВ = ПолучитьВложенияТранспортногоСообщения(Контекст.ТранспортноеСообщение, Истина, ТипыСодержимого);
	ВложенияДИВ.Колонки.Добавить("Адрес");
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		Попытка
			ВложениеДИВ.Адрес = ПоместитьВоВременноеХранилище(ВложениеДИВ.Данные.Получить(), Контекст.УникальныйИдентификатор);
		Исключение
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(КаталогФайловОтчетности);
			ТекстСообщения = НСтр("ru = 'Ошибка формирования пакета: не удалось сохранить документ во временный каталог для подписания.';
									|en = 'An error occurred while generating the package: cannot save the document to the temporary directory for signing.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	// заполняем дерево описания сначала ДИВ
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		
		Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись Тогда
			Продолжить;
		КонецЕсли;
		
		// пакуем файл
		Если ТипыШифруемогоСодержимого.Найти(ВложениеДИВ.Тип) <> Неопределено Тогда
			ОтложеннаяКоманда = ОтложенныеКоманды.Добавить(ВложениеДИВ.Адрес, "Зашифровать");
			СтрДокумент = ОпределитьДокументВДеревеОписания(
				ДеревоДокументов,
				ВложениеДИВ.Тип,
				ТипСодержимогоПоОписаниюДИВ(ВложениеДИВ),
				ВложениеДИВ.Идентификатор,
				Истина,
				Истина,
				ВложениеДИВ.ИмяФайла,
				ВложениеДИВ.ИмяФайла,
				ВложениеДИВ.Адрес);
			
		Иначе
			СтрДокумент = ОпределитьДокументВДеревеОписания(
				ДеревоДокументов,
				ВложениеДИВ.Тип,
				"xml",
				ВложениеДИВ.Идентификатор,
				Истина,
				Ложь,
				ВложениеДИВ.ИмяФайла,
				ВложениеДИВ.ИмяФайла,
				ВложениеДИВ.Адрес);
		КонецЕсли;
		
	КонецЦикла;
	
	// дополняем дерево описания информацией об ЭЦП
	Для Каждого ВложениеДИВ Из ВложенияДИВ Цикл
		Если ВложениеДИВ.Тип = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись Тогда
			ПодписанныйДокумент = ДеревоДокументов.Строки.Найти(ВложениеДИВ.ЭЦПИмяПодписанногоФайла, "ИмяФайлаДокумента");
			Если ПодписанныйДокумент <> Неопределено Тогда
				ОпределитьДокументВДеревеОписания(ПодписанныйДокумент, , , , , , ВложениеДИВ.ИмяФайла, , ВложениеДИВ.Адрес);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// 
	Контекст.Вставить("ОтложенныеКоманды", ОтложенныеКоманды);
	Контекст.Вставить("СвойстваОтложенныхКоманд", СвойстваОтложенныхКоманд);
	Контекст.Вставить("ДеревоДокументов", ПоместитьВоВременноеХранилище(ДеревоДокументов, Контекст.УникальныйИдентификатор));
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

Функция Укоротить(Знач Текст, Длина = 50, Постфикс = "_")
	
	Текст = Строка(Текст);
	
	Если СтрДлина(Текст) > Длина Тогда
		Текст = Лев(Текст, Длина) + Постфикс;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ДанныеУчетныхЗаписейПользователяСОрганизациями(ДобавитьПереизданныйСертификат = Истина) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Организации.Ссылка КАК Организация,
	|	УчетныеЗаписиДокументооборота.Ссылка КАК УчетнаяЗаписьДокументооборота,
	|	УчетныеЗаписиДокументооборота.СертификатРуководителя КАК ОтпечатокСертификата,
	|	УчетныеЗаписиДокументооборота.ЛицензияДатаОкончания КАК ЛицензияДатаОкончания,
	|	УчетныеЗаписиДокументооборота.ЛицензияНаименование КАК ЛицензияНаименование,
	|	УчетныеЗаписиДокументооборота.ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия КАК ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
	|		ПО Организации.УчетнаяЗаписьОбмена = УчетныеЗаписиДокументооборота.Ссылка
	|ГДЕ
	|	Организации.ВидОбменаСКонтролирующимиОрганами = &ОбменВУниверсальномФормате
	|	И НЕ Организации.ПометкаУдаления
	|	И УчетныеЗаписиДокументооборота.Ссылка В(&ТекущиеУчетныеЗаписиНалогоплательщика)
	|	И НЕ УчетныеЗаписиДокументооборота.ЭтоМультиРежим
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Организации.Ссылка,
	|	УчетныеЗаписиДокументооборота.Ссылка,
	|	УчетныеЗаписиДокументооборота.Отпечаток,
	|	УчетныеЗаписиДокументооборота.Ссылка.ЛицензияДатаОкончания,
	|	УчетныеЗаписиДокументооборота.Ссылка.ЛицензияНаименование,
	|	УчетныеЗаписиДокументооборота.Ссылка.ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота.СертификатыЛичные КАК УчетныеЗаписиДокументооборота
	|		ПО Организации.УчетнаяЗаписьОбмена = УчетныеЗаписиДокументооборота.Ссылка
	|ГДЕ
	|	Организации.ВидОбменаСКонтролирующимиОрганами = &ОбменВУниверсальномФормате
	|	И НЕ Организации.ПометкаУдаления
	|	И УчетныеЗаписиДокументооборота.Текущий
	|	И УчетныеЗаписиДокументооборота.Ссылка В(&ТекущиеУчетныеЗаписиНалогоплательщика)
	|	И УчетныеЗаписиДокументооборота.Пользователь = &Пользователь
	|	И УчетныеЗаписиДокументооборота.Ссылка.ЭтоМультиРежим";
	
	Запрос.УстановитьПараметр("Пользователь", 				Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("ОбменВУниверсальномФормате", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	Запрос.УстановитьПараметр("ТекущиеУчетныеЗаписиНалогоплательщика", ДокументооборотСКО.ТекущиеУчетныеЗаписиНалогоплательщика());
	
	ТипДата   = Новый ОписаниеТипов("Дата", , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("УчетнаяЗаписьДокументооборота", Новый ОписаниеТипов("СправочникСсылка.УчетныеЗаписиДокументооборота"));
	Результат.Колонки.Добавить("ОтпечатокСертификата", ТипСтрока);
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Результат.Колонки.Добавить("НаименованиеСертификата", ТипСтрока);
	Результат.Колонки.Добавить("СертификатДействителенПо", ТипДата);
	Результат.Колонки.Добавить("ОтпечатокНовогоСертификата", ТипСтрока);
	Результат.Колонки.Добавить("НовыйСертификатДействителенС", ТипДата);
	Результат.Колонки.Добавить("НовыйСертификатДействителенПо", ТипДата);
	Результат.Колонки.Добавить("НовыйСертификат", Новый ОписаниеТипов("Структура"));
	Результат.Колонки.Добавить("ЛицензияНаименование", ТипСтрока);
	Результат.Колонки.Добавить("ЛицензияТребуетсяНапоминаниеОбОкончанииСрокаДействия", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЛицензияДатаОкончания", ТипДата);
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОтпечатокСертификата = нрег(СокрЛП(Выборка.ОтпечатокСертификата));
			
			Если НЕ ПустаяСтрока(ОтпечатокСертификата) Тогда
				
				НоваяСтрокаРезультата = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультата, Выборка);
				НоваяСтрокаРезультата.ОтпечатокСертификата = ОтпечатокСертификата;
				
				Если ДобавитьПереизданныйСертификат Тогда
					
					ДанныеПереизданногоСертификата = ДанныеПереизданногоСертификата(Выборка.УчетнаяЗаписьДокументооборота);
					
					Если ДанныеПереизданногоСертификата <> Неопределено Тогда
						
						НоваяСтрокаРезультата.ОтпечатокНовогоСертификата 	= ДанныеПереизданногоСертификата.Отпечаток;
						НоваяСтрокаРезультата.НовыйСертификатДействителенС 	= ДанныеПереизданногоСертификата.ДатаНачала;
						НоваяСтрокаРезультата.НовыйСертификатДействителенПо = ДанныеПереизданногоСертификата.ДатаКонца;
						
					КонецЕсли;				
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СокрЛП_Врег(Строка) Экспорт
	
	Возврат ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.СтрокаВФорматеДляСравнения(Строка);

КонецФункции

Функция УПУПыКОтправкеПослеОдобренияЗПЭД() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УведомлениеОПредоставленииПолномочийПредставителю.Ссылка КАК Ссылка,
		|	УведомлениеОПредоставленииПолномочийПредставителю.Организация КАК Организация
		|ИЗ
		|	Документ.УведомлениеОПредоставленииПолномочийПредставителю КАК УведомлениеОПредоставленииПолномочийПредставителю
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы КАК ЖурналОтправокВКонтролирующиеОрганы
		|		ПО УведомлениеОПредоставленииПолномочийПредставителю.Ссылка = ЖурналОтправокВКонтролирующиеОрганы.Ссылка
		|ГДЕ
		|	УведомлениеОПредоставленииПолномочийПредставителю.Организация В(&Организации)
		|	И НЕ УведомлениеОПредоставленииПолномочийПредставителю.ПометкаУдаления
		|	И УведомлениеОПредоставленииПолномочийПредставителю.Дата > &Дата
		|	И ЖурналОтправокВКонтролирующиеОрганы.СостояниеСдачиОтчетности = ЗНАЧЕНИЕ(Перечисление.СостояниеСдачиОтчетности.ДокументооборотНеНачат)
		|
		|УПОРЯДОЧИТЬ ПО
		|	УведомлениеОПредоставленииПолномочийПредставителю.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Организации", ПараметрыСеанса.ОрганизацииПринятыхЗПЭД);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса() - 1*30*24*60*60); // 1 мес.
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	УПУПы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Если ДокументооборотСКОВызовСервера.МЧДПодписана(Выборка.Ссылка)
			И НЕ ДокументооборотСКОВызовСервера.ОтчетОтправлен(Выборка.Ссылка) Тогда
			
			УПУП = Новый Структура("Ссылка, Организация");
			ЗаполнитьЗначенияСвойств(УПУП, Выборка);
			
			УПУПы.Добавить(УПУП);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат УПУПы;
	
КонецФункции

// Десериализует из JSON в соответствие.
//
// Параметры:
//   СтрокаОтвет - Строка - строка в формате JSON
//
// Возвращаемое значение:
//   Строка, Соответствие - результат десериализации.
//
Функция JsonВСоответствие(СтрокаОтвет) Экспорт 
	
	ПолученныеДанные = "";
	
	Если СтрокаОтвет = Неопределено Или СтрокаОтвет = "" Тогда
		Возврат ПолученныеДанные;	
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	
	Попытка
		Чтение.УстановитьСтроку(СтрокаОтвет);
		ПолученныеДанные = ПрочитатьJSON(Чтение, Истина);
		
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Десериализация Json в соответствие';
										|en = 'JSON deserialization in correspondence'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	Чтение.Закрыть();
	
	Возврат ПолученныеДанные; 
	
КонецФункции  

// Значение из соответствия  
//
// Параметры:
//  СоответствиеПоиска - Соответствие
//  ПутьКЗначению  - Строка
//
// Возвращаемое значение:
//	Неопределено, Произвольный
//
Функция ЗначениеСоответствия(Знач СоответствиеПоиска, ПутьКЗначению) Экспорт
	
	ЗначениеВозврата = Неопределено;
	
	Если Не ТипЗнч(СоответствиеПоиска) = Тип("Соответствие") Тогда
		Возврат ЗначениеВозврата;	
	КонецЕсли; 
	
	МассивЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКЗначению,",",,Истина);
	
	Для каждого СтрокаМассива Из МассивЗначений Цикл
		ЗначениеВозврата = СоответствиеПоиска.Получить(СтрокаМассива);
		Если ЗначениеВозврата = Неопределено Тогда
			Прервать;
		Иначе
			СоответствиеПоиска = ЗначениеВозврата;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат ЗначениеВозврата;
	
КонецФункции 

#КонецОбласти

#Область ЛичныеКабинеты

Процедура ЗаполнитьПараметрыСпецоператора(Знач Спецоператор, ПараметрыСтруктура) Экспорт
	
	ПараметрыСпецоператора = ПолучитьПараметрыОператораСвязи(Спецоператор);
	ЗаполнитьЗначенияСвойств(ПараметрыСтруктура, ПараметрыСпецоператора);
	
КонецПроцедуры

Функция ПолучитьМассивИспользуемыхСпецоператоров() Экспорт
	
	МассивРезультат = Новый Массив;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                      |	УчетныеЗаписиДокументооборота.СпецоператорСвязи
	                      |ИЗ
	                      |	Справочник.Организации КАК Организации
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
	                      |		ПО Организации.УчетнаяЗаписьОбмена = УчетныеЗаписиДокументооборота.Ссылка
	                      |ГДЕ
	                      |	Организации.ВидОбменаСКонтролирующимиОрганами = &ВидОбменаСКонтролирующимиОрганами
	                      |	И УчетныеЗаписиДокументооборота.СпецоператорСвязи <> ЗНАЧЕНИЕ(Перечисление.СпецоператорыСвязи.ПустаяСсылка)
						  |	И НЕ Организации.ПометкаУдаления
	                      |	И НЕ УчетныеЗаписиДокументооборота.ПометкаУдаления");
						  
	Запрос.УстановитьПараметр("ВидОбменаСКонтролирующимиОрганами", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивРезультат.Добавить(Выборка.СпецоператорСвязи);
	КонецЦикла; 
	
	Возврат МассивРезультат;
	
КонецФункции

Функция ПолучитьТаблицуИспользуемыхСпецоператоровУчетныхЗаписейОрганизаций() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                      |	Организации.Ссылка КАК Организация,
	                      |	УчетныеЗаписиДокументооборота.Ссылка КАК УчетнаяЗапись,
	                      |	УчетныеЗаписиДокументооборота.СпецоператорСвязи КАК Спецоператор,
	                      |	РегистрацииВНалоговомОргане.Код КАК КодНО
	                      |ИЗ
	                      |	Справочник.Организации КАК Организации
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
	                      |		ПО Организации.УчетнаяЗаписьОбмена = УчетныеЗаписиДокументооборота.Ссылка
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	                      |		ПО Организации.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОргане.Ссылка
	                      |ГДЕ
	                      |	Организации.ВидОбменаСКонтролирующимиОрганами = &ВидОбменаСКонтролирующимиОрганами
	                      |	И УчетныеЗаписиДокументооборота.СпецоператорСвязи <> ЗНАЧЕНИЕ(Перечисление.СпецоператорыСвязи.ПустаяСсылка)
						  |	И НЕ Организации.ПометкаУдаления
	                      |	И НЕ УчетныеЗаписиДокументооборота.ПометкаУдаления");
						  
	Запрос.УстановитьПараметр("ВидОбменаСКонтролирующимиОрганами", Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

Процедура ПриЗаписиОтветаНаТребованиеФНС(Объект, Отказ = Ложь) Экспорт
	
	Если Объект.Ссылка <> Неопределено Тогда
		
		Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ОписиИсходящихДокументовВНалоговыеОрганы") Тогда 
			Основание = Объект.Ссылка.Основание;
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.УведомлениеОСпецрежимахНалогообложения") Тогда
			Основание = УведомлениеОСпецрежимахНалогообложения.ПолучитьТребованиеИзУведомления(Объект.Ссылка);
		Иначе
			Основание = Объект.Ссылка.Требование;
		КонецЕсли;
		
		Если ТипЗнч(Основание) = Тип("СправочникСсылка.ДокументыРеализацииПолномочийНалоговыхОрганов")
			И ЗначениеЗаполнено(Основание) Тогда
	
			// Ответы
			Результат 			= ТребованияФНС.ПолучитьКоличествоОтветовНаТребования(Основание);
			КоличествоОтветов 	= Результат.Получить(Основание);
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИзменитьЗначениеВФорме1СОтчетность(
				Основание, 
				"ЕстьОтвет", 
				КоличествоОтветов <> Неопределено И КоличествоОтветов > 0);
				
			Если КоличествоОтветов <> Неопределено И КоличествоОтветов > 0 Тогда
				ТребованияФНС.ОбновитьИнформациюВРегистреИзвлеченныеДанныеТребований(
					Основание, 
					Новый Структура("КоличествоОтветов", КоличествоОтветов));
				ДокументооборотСКОПереопределяемый.ЗарегистрироватьИзменениеСтатусаЗадачТребованиеФНС(Основание);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами")
			И (Объект.Статус = Перечисления.СтатусыПисем.Исходящее 
			ИЛИ Объект.Статус = Перечисления.СтатусыПисем.Отправленное) Тогда
			
			ИдентификаторОснования = Объект.ИдентификаторОснования;
			Если ЗначениеЗаполнено(ИдентификаторОснования) Тогда
				
				Основание = ПисьмоПоИдентификатору(ИдентификаторОснования);
				ЕстьОтвет = ОтветНаПисьмоСуществует(Основание);
				
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИзменитьЗначениеВФорме1СОтчетность(
					Основание, 
					"ЕстьОтвет", 
					ЕстьОтвет);
					
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьПоясненияКДекларацииПоНДСВРегистрЖурналОтправокВКонтролирующиеОрганы(Объект) Экспорт
	
	Свойства = СвойстваОтветаНаТребованиеПоясненийКДекларацииНДС(Объект);
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.СоздатьЗаписьВРегистреЖурналОтправокВКонтролирующиеОрганы(Свойства);
	
	ТребованияФНС.ЗаписатьВРегистрИзвлеченныеДанныеТребований(Объект.Требование);
	
КонецПроцедуры

Функция СвойстваОтветаНаТребованиеПоясненийКДекларацииНДС(Объект) Экспорт

	Ссылка = Объект.Ссылка;
	
	// Наименование
	Требование = Объект.Требование;
	Наименование = Документы.ПоясненияКДекларацииПоНДС.НаименованиеОтветаПоТребованию(Объект.Требование);
	
	// Вид и код контролирующего органа
	ВидКонтролирующегоОргана	= Перечисления.ТипыКонтролирующихОрганов.ФНС;
	Если ЗначениеЗаполнено(Объект.НалоговыйОрган) Тогда
		КодКонтролирующегоОргана	= Объект.НалоговыйОрган.Код;
	Иначе
		КодКонтролирующегоОргана	= "";
	КонецЕсли;
	
	Организация = Объект.Организация;
	
	// Запись в регистр
	ЗначенияЗаполнения = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПараметрыПроцедурыСоздатьЗаписьВРегистреЖурналОтправокВКонтролирующиеОрганы();
	ЗначенияЗаполнения.Ссылка 					= Ссылка;
	ЗначенияЗаполнения.ДатаСоздания				= Ссылка.Дата;
	ЗначенияЗаполнения.Наименование 			= Наименование;
	ЗначенияЗаполнения.ВидКонтролирующегоОргана = ВидКонтролирующегоОргана;
	ЗначенияЗаполнения.КодКонтролирующегоОргана = КодКонтролирующегоОргана;
	ЗначенияЗаполнения.Организация 				= Организация;
	ЗначенияЗаполнения.СтраницаЖурнала			= Перечисления.СтраницыЖурналаОтчетность.Письма;
	ЗначенияЗаполнения.Комментарий				= Ссылка.Комментарий;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

Функция ОпределитьОрганизациюПоИННиКПП(ИНН, КПП, НаходитьПомеченныеНаУдаление = Ложь) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                      |	Организации.Ссылка
	                      |ИЗ
	                      |	Справочник.Организации КАК Организации");
	
	Если НЕ ЗначениеЗаполнено(КПП) Тогда
		Запрос.Текст = Запрос.Текст + "	ГДЕ ";
	Иначе
		Запрос.Текст = Запрос.Текст + "
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
							|		ПО Организации.Ссылка = РегистрацииВНалоговомОргане.Владелец
							|	ГДЕ РегистрацииВНалоговомОргане.КПП = &КПП
							|		И ";
		Запрос.УстановитьПараметр("КПП", КПП);
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + " Организации.ИНН = &ИНН"
		+ ?(НаходитьПомеченныеНаУдаление, "", " И Организации.ПометкаУдаления = ЛОЖЬ");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

