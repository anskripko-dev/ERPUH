Функция ОтчетОтправляетсяПоЭДОК(Ссылка) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ЦиклыОбмена") Тогда
		Возврат Ссылка.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	Иначе
		Сведения = СведенияПоОтправляемымОбъектам(Ссылка);
		Если Сведения.ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
			Возврат ФорматДокументооборотаСПФР(Ссылка).ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция СвойстваПодписиСообщенияПоЭДОК(СтрокаСвойстваПодписи)
	
	// записываем вложение во временный файл
	ФайлСообщения = ПолучитьИмяВременногоФайла("xml");
	Попытка
		СтрокаСвойстваПодписи.ДвДанные.Записать(ФайлСообщения);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	// считываем уведомление из файла в дерево XML
	ОписаниеОшибки = "";
	КонтекстЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ДеревоXML = КонтекстЭДО.ЗагрузитьXMLВДеревоЗначений(ФайлСообщения, , ОписаниеОшибки);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлСообщения);
	Если НЕ ЗначениеЗаполнено(ДеревоXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// анализируем XML
	УзелX509Certificate = НайтиСтрокиДереваЗначений(ДеревоXML,,, "X509Certificate", "Э");
	Если НЕ ЗначениеЗаполнено(УзелX509Certificate) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПодписьВBase64 = УзелX509Certificate.Значение;
	ДвДанныеСертификата = Base64Значение(ПодписьВBase64);
	
	Сертификат = Новый Структура;
	Сертификат.Вставить("Сертификат", ДвДанныеСертификата);
	
	Подписант = Новый Структура;
	Подписант.Вставить("Сертификат", Сертификат);
	
	Подписанты = Новый Массив;
	Подписанты.Добавить(Подписант);
	
	СвойстваПодписи = Новый Структура();
	СвойстваПодписи.Вставить("Подписанты", Подписанты);
	
	Возврат СвойстваПодписи;
	
КонецФункции

