				|en = 'An error occurred while registering the machine-readable authorization letter on the Federal Customs Service portal.'");
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ИдентификаторОтправкиНаСервере", 	ИдентификаторОтправкиНаСервере);
	Результат.Вставить("ТекстОтвета", 						ТекстОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция ОбновитьМашиночитаемуюДоверенностьФТС(ПараметрыОтправки, ПараметрыСоединения)
	
	ОтправкаСсылка = ?(ПараметрыОтправки.Свойство("ОтправкаСсылка"), ПараметрыОтправки.ОтправкаСсылка, Неопределено);
	
	Если НЕ ПараметрыОтправки.Свойство("ОтчетСсылка") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыОтправки.ОтчетСсылка)
		И ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		
		ОтчетСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтправкаСсылка, "ОтчетСсылка");
		ПараметрыОтправки.Вставить("ОтчетСсылка", ОтчетСсылка);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыОтправки.ИдентификаторОтправкиНаСервере) И ЗначениеЗаполнено(ОтправкаСсылка)
		ИЛИ (ПараметрыОтправки.Свойство("ОтчетСсылка") И ЗначениеЗаполнено(ПараметрыОтправки.ОтчетСсылка)) Тогда
		
		Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФТС(ПараметрыОтправки.ОтчетСсылка);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтправкаСсылка) Тогда
			ПараметрыОтправки.ИдентификаторОтправкиНаСервере = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтправкаСсылка,
				"ИдентификаторОтправкиНаСервере");
		КонецЕсли;
	КонецЕсли;
	
	Результат = ПолучитьИнформациюОМашиночитаемойДоверенностиНаПорталеФТС(
		ПараметрыОтправки.ИдентификаторОтправкиНаСервере,
		ПараметрыОтправки,
		ПараметрыСоединения);
	
	Если Результат <> Неопределено И ПараметрыОтправки.Свойство("ОтчетСсылка") Тогда
		Если Результат.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда
			СтатусОтчета = НСтр("ru = 'Доверенность зарегистрирована';
								|en = 'Authorization letter is registered'");
			ЦветСтатуса = Новый Цвет(0, 179, 16);
			СтатусМашиночитаемойДоверенности = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Зарегистрировано;
			
		ИначеЕсли Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят И Результат.Отозвано Тогда
			СтатусОтчета = НСтр("ru = 'Доверенность отменена';
								|en = 'The letter of authority is canceled'");
			ЦветСтатуса = Новый Цвет(255, 0, 0);
			СтатусМашиночитаемойДоверенности = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано;
			
		ИначеЕсли Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
			СтатусОтчета = НСтр("ru = 'Обнаружены ошибки, доверенность не зарегистрирована';
								|en = 'Errors are found. The authorization letter is not registered'");
			ЦветСтатуса = Новый Цвет(255, 0, 0);
			СтатусМашиночитаемойДоверенности = Перечисления.СтатусыМашиночитаемойДоверенностиКО.ОтказВРегистрации;
			
		Иначе
			СтатусОтчета =
				НСтр("ru = 'Находится в обработке, попробуйте через некоторое время использовать в отчете кнопку ""Обновить""';
					|en = 'Processing is in progress. Try to click Update in the report after a while'");
			СтатусМашиночитаемойДоверенности = Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отправлено;
			Если Результат.СтатусОтправки = Перечисления.СтатусыОтправки.ПустаяСсылка()
				И ЗначениеЗаполнено(Результат.НаименованиеСтатуса) Тогда
				СтатусОтчета = СтатусОтчета + " (" + Результат.НаименованиеСтатуса + ")";
			КонецЕсли;
			ЦветСтатуса = Новый Цвет(0, 0, 192);
		КонецЕсли;
		
		Протокол = ГенерироватьHTMLПротоколаОбработкиФТС(
			Новый Структура("Протокол, ПоляПротоколаДоверенности", Результат.ТекстОтвета, Результат),
			СтатусОтчета,
			ЦветСтатуса,
			Результат.СтатусОтправки,
			Ложь,
			ПараметрыОтправки,
			ПараметрыОтправки.ОтчетСсылка);
		Результат.Вставить("Протокол", Протокол);
		
		Если ОтправкаСсылка = Неопределено Тогда
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФТС(
				ПараметрыОтправки.ОтчетСсылка,
				ПараметрыОтправки.ИдентификаторОтправкиНаСервере);
		КонецЕсли;
		
		ОтправкаОбъект = ОтправкаСсылка.ПолучитьОбъект();
		ОтправкаОбъект.ДатаПолученияРезультата = ТекущаяДатаСеанса();
		ОтправкаОбъект.СтатусОтправки = ?(Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
			И Результат.Отозвано, Перечисления.СтатусыОтправки.ПринятЕстьОшибки, Результат.СтатусОтправки);
		ОтправкаОбъект.Протокол = Новый ХранилищеЗначения(Результат.Протокол);
		ОтправкаОбъект.НаКонтроле = Ложь;
		ОтправкаОбъект.Записать();
		Результат.Вставить("ОтправкаСсылка", ОтправкаСсылка);
		
		ЗаписатьСтатусОтправкиФТСОтчета(
			ПараметрыОтправки.ОтчетСсылка,
			Результат.СтатусОтправки,
			ОтправкаСсылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИнформациюОМашиночитаемойДоверенностиНаПорталеФТС(
		ИдентификаторОтправкиНаСервере,
		ПараметрыОтправки,
		ПараметрыСоединения)
	
	Результат = Неопределено;
	
	НомерСтраницы = 1;
	ЭлементовНаСтранице = 10;
	
	Пока Истина Цикл
		ТекстЗапроса = "{""OnlyMy"":0,""Filter"":"""",""StateName"":""New"",""CanSignDocuments"":0}";
		
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
		ОбъектЗаписьТекста.Записать(ТекстЗапроса);
		ОбъектЗаписьТекста.Закрыть();
		ИмяФайлаЗапроса = УдалитьBOM(ИмяФайлаЗапроса);
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=UTF-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		ИндексЭлементаСтрокой = Формат((НомерСтраницы - 1) * ЭлементовНаСтранице, "ЧДЦ=; ЧН=; ЧГ=");
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(
					"/FtsPersonalCabinetWeb/UniversalDatabase/GetItems",
					"{FTS}/FtsPersonalCabinetWeb/UniversalDatabase/GetItems",
					ПараметрыСоединения.СоединениеHTTP)
				+ СтрШаблон(
					"?scopeName=FtsPersonalCabinet&listName=EMCHD&start=%1&format=JSON",
					ИндексЭлементаСтрокой);
			ЗапросHTTP = Новый HTTPЗапрос(РесурсНаСервере, ЗаголовкиHTTP);
			ЗапросHTTP.УстановитьИмяФайлаТела(ИмяФайлаЗапроса);
			
			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ОтправитьДляОбработки(
				ЗапросHTTP,
				ИмяФайлаОтвета);
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ПовторятьСоединение = НЕ ОбщегоНазначения.РазделениеВключено();
			Если НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
				ПараметрыСоединения.ОписаниеОшибкиСервером =
					НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
						|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			КонецЕсли;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		Попытка
			ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
			ТекстОтвета = ФайлОтвета.Прочитать();
			ФайлОтвета.Закрыть();
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ОписаниеОшибкиСервером =
				НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета,, Истина);
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.ОткрытьФайл(ИмяФайлаОтвета, "utf-8");
			СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			МассивЭлементов = СтруктураОтвета.Items;
			ЭтоПоследняяСтраница = (МассивЭлементов.Количество() < ЭлементовНаСтранице);
			Для каждого ЭлементОтвета Из МассивЭлементов Цикл
				Если ЭлементОтвета.Id = ИдентификаторОтправкиНаСервере Тогда
					Результат = Новый Структура;
					Результат.Вставить("ИдентификаторОтправкиНаСервере", 	ЭлементОтвета.Id);
					Результат.Вставить("ДатаСозданияСтрокой", 				ЭлементОтвета.CreationDateTime);
					Результат.Вставить("ДатаВыдачиСтрокой", 				ЭлементОтвета.DateTo);
					Результат.Вставить("ДатаОкончанияСтрокой", 				ЭлементОтвета.DateFrom);
					Результат.Вставить("РегистрационныйНомер", 				?(ЭлементОтвета.Свойство("RegNum"), ЭлементОтвета.RegNum, ""));
					Результат.Вставить("КодСтатуса", 						ЭлементОтвета.StateName);
					Результат.Вставить("НаименованиеСтатуса", 				ЭлементОтвета.Status.DisplayName);
					Результат.Вставить("НаименованиеСтатусаОбмена", 		ЭлементОтвета.Status.DisplayNameExchange);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ОписаниеОшибкиСервером =
				НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		Если Результат <> Неопределено ИЛИ ЭтоПоследняяСтраница Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		ПараметрыСоединения.ОписаниеОшибкиСервером =
			НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
				|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаСоздания 	= ?(ЗначениеЗаполнено(Результат.ДатаСозданияСтрокой),
					  ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(Результат.ДатаСозданияСтрокой), "");
	ДатаВыдачи 		= ?(ЗначениеЗаполнено(Результат.ДатаВыдачиСтрокой),
					  ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(Результат.ДатаВыдачиСтрокой), "");
	ДатаОкончания 	= ?(ЗначениеЗаполнено(Результат.ДатаОкончанияСтрокой),
					  ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(Результат.ДатаОкончанияСтрокой), "");
	
	Результат.Вставить("ДатаСоздания", 	ДатаСоздания);
	Результат.Вставить("ДатаВыдачи", 	ДатаВыдачи);
	Результат.Вставить("ДатаОкончания", ДатаОкончания);
	
	Результат.Вставить("ВремяСозданияСтрокой", "");
	
	Результат.ДатаСозданияСтрокой = ?(ЗначениеЗаполнено(ДатаСоздания), Формат(ДатаСоздания, "ДФ='дд.ММ.гггг'"),
		Результат.ДатаСозданияСтрокой);
	Результат.ВремяСозданияСтрокой = ?(ЗначениеЗаполнено(ДатаСоздания), Формат(ДатаСоздания, "ДФ='ЧЧ:мм:сс'"),
		Результат.ВремяСозданияСтрокой);
	Результат.ДатаВыдачиСтрокой = ?(ЗначениеЗаполнено(ДатаВыдачи), Формат(ДатаВыдачи, "ДФ='дд.ММ.гггг'"),
		Результат.ДатаВыдачиСтрокой);
	Результат.ДатаОкончанияСтрокой = ?(ЗначениеЗаполнено(ДатаОкончания), Формат(ДатаОкончания, "ДФ='дд.ММ.гггг'"),
		Результат.ДатаОкончанияСтрокой);
	
	// получение протокола ошибок
	
	ТекстОтвета = "";
	НаименованиеСтатусаВРег = ВРег(Результат.НаименованиеСтатуса);
	НаименованиеСтатусаОбменаВРег = ВРег(Результат.НаименованиеСтатусаОбмена);
	
	Результат.Вставить("СтатусОтправки", 	Перечисления.СтатусыОтправки.ПустаяСсылка());
	Результат.Вставить("Отозвано", 			Ложь);
	
	Если СтрНайти(НаименованиеСтатусаВРег, "ЗАРЕГИСТРИРОВАН") <> 0
		ИЛИ СтрНайти(НаименованиеСтатусаОбменаВРег, "ЗАРЕГИСТРИРОВАН") <> 0 Тогда
		
		Результат.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
		
	ИначеЕсли СтрНайти(НаименованиеСтатусаВРег, "ОТОЗВАН") <> 0
		ИЛИ СтрНайти(НаименованиеСтатусаОбменаВРег, "ОТОЗВАН") <> 0 Тогда
		
		Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
		Результат.Отозвана = Истина;
		
	ИначеЕсли ВРег(Результат.КодСтатуса) = "EMCHD_STATUS_ERROR" ИЛИ СтрНайти(НаименованиеСтатусаВРег, "ОШИБК") <> 0
		ИЛИ СтрНайти(НаименованиеСтатусаОбменаВРег, "ОШИБК") <> 0 Тогда
		
		Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
		
	ИначеЕсли ВРег(Результат.КодСтатуса) = "EMCHD_STATUS_SENT" ИЛИ СтрНайти(НаименованиеСтатусаВРег, "ОТПРАВЛЕН") <> 0
		ИЛИ СтрНайти(НаименованиеСтатусаОбменаВРег, "ОТПРАВЛЕН") <> 0 Тогда
		
		Результат.СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен;
		
	ИначеЕсли ВРег(Результат.КодСтатуса) = "EMCHD_STATUS_NEW" ИЛИ СтрНайти(НаименованиеСтатусаВРег, "ЧЕРНОВИК") <> 0
		ИЛИ СтрНайти(НаименованиеСтатусаОбменаВРег, "ЧЕРНОВИК") <> 0 Тогда
		
		Результат.СтатусОтправки = Перечисления.СтатусыОтправки.ПустаяСсылка();
	КонецЕсли;
	
	Если Результат.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят И НЕ Результат.Отозвано Тогда
		ТекстЗапроса = СтрШаблон(
			"{""Item"":{""Name"":""Action_ViewError"",""DisplayName"":""Просмотреть ошибку"",""Icon"":""PageError"","
				+ """Scopes"":""List"",""Exception"":null,""SoftVersion"":""%1/%2"",""ModelName"":""EMCHD_MODEL"",""Id"":""%3"","
				+ """executing"":true,""Action"":null}}",
			ПараметрыОтправки.ВерсияФормированияДоверенности,
			ПараметрыОтправки.ВерсияОтправкиДоверенности,
			Результат.ИдентификаторОтправкиНаСервере);
		
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
		ОбъектЗаписьТекста.Записать(ТекстЗапроса);
		ОбъектЗаписьТекста.Закрыть();
		ИмяФайлаЗапроса = УдалитьBOM(ИмяФайлаЗапроса);
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=UTF-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(
					"/FtsPersonalCabinetWeb/NgActions/ExecuteAction",
					"{FTS}/FtsPersonalCabinetWeb/NgActions/ExecuteAction",
					ПараметрыСоединения.СоединениеHTTP)
				+ СтрШаблон(
					"?action=Action_ViewError&modelName=EMCHD_MODEL&softVersion=%1%%2F%2",
					ПараметрыОтправки.ВерсияФормированияДоверенности,
					ПараметрыОтправки.ВерсияОтправкиДоверенности);
			ЗапросHTTP = Новый HTTPЗапрос(РесурсНаСервере, ЗаголовкиHTTP);
			ЗапросHTTP.УстановитьИмяФайлаТела(ИмяФайлаЗапроса);
			
			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ОтправитьДляОбработки(
				ЗапросHTTP,
				ИмяФайлаОтвета);
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ПовторятьСоединение = НЕ ОбщегоНазначения.РазделениеВключено();
			Если НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
				ПараметрыСоединения.ОписаниеОшибкиСервером =
					НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
						|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			КонецЕсли;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		Попытка
			ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
			ТекстОтвета = ФайлОтвета.Прочитать();
			ФайлОтвета.Закрыть();
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ОписаниеОшибкиСервером =
				НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета,, Истина);
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ИдентификаторПротокола = Строка(ТекстПослеПрефикса(ТекстОтвета, """Data"":""../FtsDocumentsMvc/PartView/Index/", """"));
		ПозицияРазделителя = СтрНайти(ИдентификаторПротокола, "?");
		Если ПозицияРазделителя <> 0 Тогда
			ИдентификаторПротокола = Лев(ИдентификаторПротокола, ПозицияРазделителя - 1);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИдентификаторПротокола) Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером =
				НСтр("ru = 'Ошибка получения протокола обработки машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting a protocol of processing the machine-readable authorization letter on the Federal Customs Service portal.'");
			Возврат Неопределено;
		КонецЕсли;
		
		// печать протокола ошибок
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=UTF-8");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(
					"/FtsDocumentsMvc/PartPrint/Index/",
					"{FTS}/FtsDocumentsMvc/PartPrint/Index/",
					ПараметрыСоединения.СоединениеHTTP)
				+ ИдентификаторПротокола + "?HideMenu=True";
			ЗапросHTTP = Новый HTTPЗапрос(РесурсНаСервере, ЗаголовкиHTTP);
			
			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.Получить(
				ЗапросHTTP,
				ИмяФайлаОтвета);
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ПовторятьСоединение = НЕ ОбщегоНазначения.РазделениеВключено();
			Если НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
				ПараметрыСоединения.ОписаниеОшибкиСервером =
					НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
						|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			КонецЕсли;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		Попытка
			ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
			ТекстОтвета = ФайлОтвета.Прочитать();
			ФайлОтвета.Закрыть();
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ПараметрыСоединения.ОписаниеОшибкиСервером =
				НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'");
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. МЧД ФТС';
					|en = 'EDI with regulatory authorities. Machine-readable authorization letter FCS'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПредставлениеОшибки);
			Возврат Неопределено;
		КонецПопытки;
		
		ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета);
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтрНайти(ТекстОтвета, "ResultInformation") = 0 Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ?(ЗначениеЗаполнено(ТекстОтвета), ТекстОтвета,
				НСтр("ru = 'Ошибка получения информации о машиночитаемой доверенности на портале Федеральной таможенной службы.';
					|en = 'An error occurred while getting information on the machine-readable authorization letter on the Federal Customs Service portal.'"));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("ТекстОтвета", ТекстОтвета);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

