Функция ОрганизацияОтключенаОтЭДКО(Организация) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостояниеПодключенияКЭДОсПФР.ОрганизацияОтключенаОтЭДКО КАК ОрганизацияОтключена
		|ИЗ
		|	РегистрСведений.СостояниеПодключенияКЭДОсПФР КАК СостояниеПодключенияКЭДОсПФР
		|ГДЕ
		|	СостояниеПодключенияКЭДОсПФР.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ОрганизацияОтключена;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОрганизацияПодключенаКЭДОсПФР(Организация) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостояниеПодключенияКЭДОсПФР.ОрганизацияПодключенаКЭДКО
		|		И НЕ СостояниеПодключенияКЭДОсПФР.ОрганизацияОтключенаОтЭДКО КАК ОрганизацияПодключена
		|ИЗ
		|	РегистрСведений.СостояниеПодключенияКЭДОсПФР КАК СостояниеПодключенияКЭДОсПФР
		|ГДЕ
		|	СостояниеПодключенияКЭДОсПФР.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ОрганизацияПодключена;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура УстановитьСостояниеПодключенияКЭДОсПФР(
		Организация,
		ОрганизацияПодключенаКЭДКО = Неопределено,
		ОрганизацияОтключенаОтЭДКО = Неопределено) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
	
		НаборЗаписей = РегистрыСведений.СостояниеПодключенияКЭДОсПФР.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Очистить();
		
		Запись = НаборЗаписей.Добавить();
		Запись.Организация = Организация;
		
		Если ОрганизацияПодключенаКЭДКО = Неопределено Тогда
			Запись.ОрганизацияПодключенаКЭДКО = ОрганизацияПодключенаКЭДОсПФР(Организация);
		Иначе
			Запись.ОрганизацияПодключенаКЭДКО = ОрганизацияПодключенаКЭДКО;
		КонецЕсли;
		
		Если ОрганизацияОтключенаОтЭДКО = Неопределено Тогда
			Запись.ОрганизацияОтключенаОтЭДКО = ОрганизацияОтключенаОтЭДКО(Организация);
		Иначе
			Запись.ОрганизацияОтключенаОтЭДКО = ОрганизацияОтключенаОтЭДКО;
		КонецЕсли;
			
		НаборЗаписей.Записать(Истина);
	
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Установить состояние подключения к ПФР';
				|en = 'Electronic data interchange with regulatory authorities. Establish PF connection status'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
	КонецПопытки;
	
КонецПроцедуры

Функция СдаватьВПФР(Организация) Экспорт

	СдаватьВПФР = Ложь;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		УчетнаяЗаписьОбмена = Организация.УчетнаяЗаписьОбмена;
		ЕстьДоступ = ПользователюРазрешеноВыполнятьОбменПоУчетнойЗаписи(УчетнаяЗаписьОбмена);			
		
		Если ЗначениеЗаполнено(УчетнаяЗаписьОбмена) Тогда
			
			Если ЕстьДоступ И УчетнаяЗаписьОбмена.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.КалугаАстрал Тогда
				КонтекстЭДОСервер = ДокументооборотСКО.ПолучитьОбработкуЭДО();
														   
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.ТипПолучателя,
					|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КодПолучателя,
					|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.КПП
					|ИЗ
					|	РегистрСведений.ДополнительныеРеквизитыУчетнойЗаписиПолучатели КАК ДополнительныеРеквизитыУчетнойЗаписиПолучатели
					|ГДЕ
					|	ДополнительныеРеквизитыУчетнойЗаписиПолучатели.УчетнаяЗапись = &УчетнаяЗапись";

				Запрос.УстановитьПараметр("УчетнаяЗапись", КонтекстЭДОСервер.УчетнаяЗаписьОрганизации(Организация));
				Результат = Запрос.Выполнить().Выгрузить();
				
				Для Каждого СтрокаНаправлений Из Результат Цикл
					Если СтрокаНаправлений.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
						СдаватьВПФР = Истина;
					КонецЕсли;
				КонецЦикла;
			Иначе
				ПредназначенаДляДокументооборотаСПФР = ДокументооборотСКОВызовСервера.УчетнаяЗаписьПредназначенаДляДокументооборотаСПФР(УчетнаяЗаписьОбмена);
				СдаватьВПФР = ПредназначенаДляДокументооборотаСПФР = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СдаватьВПФР;

КонецФункции

Процедура ПриЗаписиЗаявленияПоЭлДокументооборотуСПФР(Объект, Отказ) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолучатьДаты", 			Ложь);
	ДополнительныеПараметры.Вставить("ПолучатьОшибкиОтправки", 	Ложь);
	
	ТекущееСостояние = ТекущееСостояниеОтправки(
		Объект.Ссылка, 
		"ПФР", 
		ДополнительныеПараметры);
		
	Если ТекущееСостояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭтапОтправки = ТекущееСостояние.ТекущийЭтапОтправки;
	
	Если ТекущийЭтапОтправки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеСдачиОтчетности = ТекущийЭтапОтправки.СостояниеСдачиОтчетности;
	Успешно = СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
	
	// Нельзя сбрасывать статус в Ложь, потому что он мог быть установлен вручную.
	// Поэтому делаем сохранение только про успешной отправке
	Если Успешно Тогда
	
		Если Объект.Вид = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаПодключение Тогда
			УстановитьСостояниеПодключенияКЭДОсПФР(Объект.Организация,Истина, Ложь);
		ИначеЕсли Объект.Вид = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение Тогда
			УстановитьСостояниеПодключенияКЭДОсПФР(Объект.Организация,,Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

