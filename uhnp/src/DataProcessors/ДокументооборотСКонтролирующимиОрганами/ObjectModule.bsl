Процедура СохранитьДатуНапоминанияДляИзменившихсяРеквизитов(ИзмененныеПараметрыПодключения, ДатаНапоминания) Экспорт
	
	// Получаем из хранилища общих настроек сведения по изменившимся реквизитам
	СохраненныеНастроки = ДатыНапоминанийПоИзменившимсяРеквизитам();
	
	// Если запись в хранилище общих настроек существует, то обновляем дату напоминания, иначе создаем новую запись 
	Для Каждого ТекущийПараметр Из ИзмененныеПараметрыПодключения Цикл
		Если ЗначениеЗаполнено(ТекущийПараметр.СписокИзменившихсяРеквизитов) Тогда
			
			// Ищем строки среди запомненных
			Отбор = Новый Структура; 
			Отбор.Вставить("Организация", ТекущийПараметр.Организация);
			Отбор.Вставить("УчетнаяЗапись", ТекущийПараметр.УчетнаяЗаписьДокументооборота);
			СохраненнаяНастрока = СохраненныеНастроки.НайтиСтроки(Отбор);
			Если СохраненнаяНастрока.Количество() > 0 Тогда
				Напоминание = СохраненнаяНастрока[0];
				ДатаНапоминанияПоИзмененнымРеквизитам = Напоминание.ДатаНапоминания;
			Иначе
				Напоминание = Неопределено;
			КонецЕсли;

			// Заполнение данных в строке
			Если Напоминание = Неопределено Тогда
				Напоминание = СохраненныеНастроки.Добавить();
				Напоминание.Организация = ТекущийПараметр.Организация;
				Напоминание.УчетнаяЗапись = ТекущийПараметр.УчетнаяЗаписьДокументооборота;
			КонецЕсли;
			Напоминание.СписокИзменившихсяРеквизитов = ТекущийПараметр.СписокИзменившихсяРеквизитов;
			Напоминание.ДатаНапоминания = ДатаНапоминания;
		КонецЕсли;
	КонецЦикла;
	
	// Если сейчас расхождений нет, но раньше были, то удаляем такие строки из запомненых 
	Счетчик = ИзмененныеПараметрыПодключения.Количество() - 1;
	Пока Счетчик >= 0 Цикл
		
		// Ищем строки среди запомненных
		Отбор = Новый Структура; 
		Отбор.Вставить("Организация", ИзмененныеПараметрыПодключения[Счетчик].Организация);
		Отбор.Вставить("УчетнаяЗапись", ИзмененныеПараметрыПодключения[Счетчик].УчетнаяЗаписьДокументооборота);
		СохраненнаяНастрока = СохраненныеНастроки.НайтиСтроки(Отбор);
		Если СохраненнаяНастрока.Количество() > 0 Тогда
			Напоминание = СохраненнаяНастрока[0];
		Иначе
			Напоминание = Неопределено;
		КонецЕсли;
		
		// Удаляем лишние строки
		Если НЕ ЗначениеЗаполнено(ИзмененныеПараметрыПодключения[Счетчик].СписокИзменившихсяРеквизитов) // сейчас нет изменившихся реквизитов 
			И Напоминание <> Неопределено Тогда // раньше были изменившиеся реквизиты
			СохраненныеНастроки.Удалить(Напоминание);
		КонецЕсли;
		Счетчик = Счетчик - 1;
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ДатыНапоминанийПоИзменившимсяРеквизитам", , СохраненныеНастроки);
	
КонецПроцедуры

Процедура СохранитьДатуНапоминанияДляСертификатов(ИзмененныеПараметрыПодключения, ДатаНапоминания) Экспорт
	
	// Получаем из хранилища общих настроек сведения по сертификатам
	СохраненныеНастроки = ДатыНапоминанийПоИстекающимСертификатам();
	
	// Если серификат найден в хранилище общих настроек, то обновляем дату напоминания, иначе создаем новую запись 
	Для Каждого ТекущийСертификат Из ИзмененныеПараметрыПодключения Цикл
		Если ЗначениеЗаполнено(ТекущийСертификат.ОтпечатокСертификата) Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Организация", ТекущийСертификат.Организация);
			Отбор.Вставить("Отпечаток", ТекущийСертификат.ОтпечатокСертификата);
			СохраненнаяНастрока = СохраненныеНастроки.НайтиСтроки(Отбор);
			
			Если СохраненнаяНастрока.Количество() > 0 Тогда
				Напоминание = СохраненнаяНастрока[0];
				ДатаНапоминанияПоИстекающемуСертификату = Напоминание.ДатаНапоминания;
			Иначе
				Напоминание = Неопределено;
			КонецЕсли;
			
			Если Напоминание = Неопределено Тогда
				Напоминание = СохраненныеНастроки.Добавить();
				Напоминание.Организация = ТекущийСертификат.Организация;
				Напоминание.Отпечаток = ТекущийСертификат.ОтпечатокСертификата;
			КонецЕсли;
			Напоминание.ДействителенПо = ТекущийСертификат.СертификатДействителенПо;
			Напоминание.ДатаНапоминания = ДатаНапоминания;
		КонецЕсли;
	КонецЦикла;
	
	// если сертификат истек более полугода назад, то делаем ему дату напоминания - Дата(1,1,1) - никогда не напоминать 
	ТекДата = ТекущаяДатаСеанса();
	Индекс = СохраненныеНастроки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если СохраненныеНастроки[Индекс].ДействителенПо <= ДобавитьМесяц(ТекДата, -6) Тогда
			СохраненныеНастроки[Индекс].ДатаНапоминания = Дата(1,1,1);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_НапоминаниеПоИстекающимСертификатам", , СохраненныеНастроки);
	
КонецПроцедуры

Функция ДатыНапоминанийПоЛицензиям(ИгнорироватьДатуПоследнегоОтображения = Ложь)

	СохраненныеНастроки = ХранилищеОбщихНастроек.Загрузить("ДокументооборотСКонтролирующимиОрганами_ДатыНапоминанийПоИстекающимЛицензиям");
	
	Если СохраненныеНастроки = Неопределено Тогда
		
		СохраненныеНастроки = Новый ТаблицаЗначений;
		СохраненныеНастроки.Колонки.Добавить("Организация");
		СохраненныеНастроки.Колонки.Добавить("УчетнаяЗапись");
		СохраненныеНастроки.Колонки.Добавить("ЛицензияНаименование");
		СохраненныеНастроки.Колонки.Добавить("ЛицензияДатаОкончания");
		СохраненныеНастроки.Колонки.Добавить("ДатаНапоминания");
		
	КонецЕсли;
	
	Возврат СохраненныеНастроки;
	
КонецФункции

Процедура СохранитьДатуНапоминанияДляЛицензий(ИзмененныеПараметрыПодключения, ДатаНапоминания) Экспорт
	
	// Получаем из хранилища общих настроек сведения по лицензиям
	СохраненныеНастроки = ДатыНапоминанийПоЛицензиям();
	
	// Если лицензия найдена в хранилище общих настроек, то обновляем дату напоминания, иначе создаем новую запись 
	Для Каждого ТекущаяЛицензия Из ИзмененныеПараметрыПодключения Цикл
		
		Если ЗначениеЗаполнено(ТекущаяЛицензия.ЛицензияНаименование) Тогда
			ПараметрыОтбора =  Новый Структура();
			ПараметрыОтбора.Вставить("Организация", ТекущаяЛицензия.Организация);
			ПараметрыОтбора.Вставить("УчетнаяЗапись", ТекущаяЛицензия.УчетнаяЗаписьДокументооборота);
			ПараметрыОтбора.Вставить("ЛицензияНаименование", ТекущаяЛицензия.ЛицензияНаименование);
			ПараметрыОтбора.Вставить("ЛицензияДатаОкончания", ТекущаяЛицензия.ЛицензияДатаОкончания);
			
			СохраненнаяНастрока = СохраненныеНастроки.НайтиСтроки(ПараметрыОтбора);
			
			Если СохраненнаяНастрока.Количество() = 0 Тогда
				Напоминание = СохраненныеНастроки.Добавить();
				Напоминание.Организация = ТекущаяЛицензия.Организация;
				Напоминание.УчетнаяЗапись = ТекущаяЛицензия.УчетнаяЗаписьДокументооборота;
				Напоминание.ЛицензияНаименование = ТекущаяЛицензия.ЛицензияНаименование;
				Напоминание.ЛицензияДатаОкончания = ТекущаяЛицензия.ЛицензияДатаОкончания;
			Иначе
				Напоминание = СохраненнаяНастрока[0]; 
			КонецЕсли;
			Напоминание.ДатаНапоминания = ДатаНапоминания;
		КонецЕсли;
			
	КонецЦикла;
	
	// если лицензия истекла более полугода назад, то делаем ей дату напоминания - Дата(1,1,1) - никогда не напоминать 
	ТекДата = ТекущаяДатаСеанса();
	Индекс = СохраненныеНастроки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если СохраненныеНастроки[Индекс].ЛицензияДатаОкончания <= ДобавитьМесяц(ТекДата, -6) Тогда
			СохраненныеНастроки[Индекс].ДатаНапоминания = Дата(1,1,1);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ДатыНапоминанийПоИстекающимЛицензиям", , СохраненныеНастроки);
	
КонецПроцедуры

Процедура СохранитьДатуНапоминанияДляНовогоСертификата(ИзмененныеПараметрыПодключения, ДатаНапоминания) Экспорт
	
	// Получаем из хранилища общих настроек сведения по сертификатам
	СохраненныеНастроки = ДатыНапоминанийПоПереизданнымСертификатам(Ложь);
	
	// Если серификат найден в хранилище общих настроек, то обновляем дату напоминания, иначе создаем новую запись 
	Для Каждого ТекущаяОрганизация Из ИзмененныеПараметрыПодключения Цикл
		Если ЗначениеЗаполнено(ТекущаяОрганизация.ОтпечатокНовогоСертификата) Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Организация", ТекущаяОрганизация.Организация);
			Отбор.Вставить("Отпечаток",   ТекущаяОрганизация.ОтпечатокНовогоСертификата);
			НайденныеСтроки = СохраненныеНастроки.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовоеНапоминание = СохраненныеНастроки.Добавить();
				НовоеНапоминание.Организация = ТекущаяОрганизация.Организация;
				НовоеНапоминание.Отпечаток   = ТекущаяОрганизация.ОтпечатокСертификата;
			Иначе
				НовоеНапоминание = НайденныеСтроки[0];
			КонецЕсли;
			
			НовоеНапоминание.ДатаНапоминания = ДатаНапоминания;
			
		КонецЕсли;
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_НапоминаниеПоСертификатамИмеющимПереизданные", , СохраненныеНастроки);
	
КонецПроцедуры

Процедура СохранитьДатуНапоминанияДляКриптопровайдера(ДатаНапоминания) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ДатаНапоминанияОбОбновленииКриптопровайдера",, ДатаНапоминания);
	
КонецПроцедуры

Функция ЭтотПараметрИзменился(ТабличнаяЧасть, НазваниеРеквизита) Экспорт
	
	СтруктураПоиска = Новый Структура("ИзмененныйРеквизит", НазваниеРеквизита);
	Возврат ТабличнаяЧасть.НайтиСтроки(СтруктураПоиска).Количество() > 0 ;
	
КонецФункции

Функция ПоддерживаетсяВторичноеЗаявление(Организация) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УчетнаяЗапись  = УчетнаяЗаписьОрганизации(Организация);
	Поддерживается = ОбработкаЗаявленийАбонентаВызовСервера.ПоддерживаетсяВторичноеЗаявление(УчетнаяЗапись);
	
	Возврат Поддерживается;
	
КонецФункции

Функция УчетнаяЗаписьОрганизации(Организация) Экспорт
	
	ПустаяУчетнаяЗапись = Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка();
	
	УстановитьПривилегированныйРежим(Истина);
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат ПустаяУчетнаяЗапись;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	ВидОбменаСКонтролирующимиОрганами = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВидОбменаСКонтролирующимиОрганами");
	Если ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		Возврат Организация.УчетнаяЗаписьОбмена;
	Иначе
		Возврат ПустаяУчетнаяЗапись;
	КонецЕсли;
	
КонецФункции

Функция ОрганизацияУчетнойЗаписи(УчетнаяЗапись) Экспорт

	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;

	Организации = ОрганизацииУчетнойЗаписи(УчетнаяЗапись);

	Если Организации.Количество() = 0 Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	Иначе
		Возврат Организации[0];
	КонецЕсли;

КонецФункции

Функция УчетнаяЗаписьПоОбъектуОтправки(ОбъектСсылка) Экспорт
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Организация = ДокументооборотСКОВызовСервера.ОрганизацияПоОбъектуОтправки(ОбъектСсылка.Ссылка);
		Если ЗначениеЗаполнено(Организация) Тогда
			УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
			Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
				Возврат УчетнаяЗапись;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

Функция ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура;
	ТипУчетнойЗаписи = ТипЗнч(УчетнаяЗапись);
	
	Если ТипУчетнойЗаписи = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота") Тогда
		
		Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись);
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
							  |	УчетныеЗаписиДокументооборота.АдресЭлектроннойПочты,
							  |	УчетныеЗаписиДокументооборота.НалоговыйОрган.Код КАК КодНалоговогоОргана,
							  |	УчетныеЗаписиДокументооборота.НалоговыйОрган.АдресЭлектроннойПочтыДляЦелейДокументооборотаСНалогоплательщиками КАК АдресНалоговогоОргана,
							  |	УчетныеЗаписиДокументооборота.СерверДокументооборота.Сертификат КАК СертификатПочтовогоСервера,
							  |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыФНС КАК АдресЭлектроннойПочтыПочтовогоСервера,
							  |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыПФР КАК АдресЭлектроннойПочтыПочтовогоСервераПФР,
							  |	УчетныеЗаписиДокументооборота.СерверДокументооборота.АдресЭлектроннойПочтыФСГС КАК АдресЭлектроннойПочтыПочтовогоСервераФСГС,
							  |	УчетныеЗаписиДокументооборота.ОбменНапрямую,
							  |	УчетныеЗаписиДокументооборота.СерверДокументооборота КАК СерверДокументооборота,
							  |	УчетныеЗаписиДокументооборота.ИмяПользователяPOP3 КАК ИмяПользователяPOP3,
							  |	УчетныеЗаписиДокументооборота.ПарольPOP3 КАК ПарольPOP3,
							  |	УчетныеЗаписиДокументооборота.СерверPOP3 КАК СерверPOP3,
							  |	УчетныеЗаписиДокументооборота.ПортPOP3 КАК ПортPOP3,
							  |	УчетныеЗаписиДокументооборота.ИмяПользователяSMTP КАК ИмяПользователяSMTP,
							  |	УчетныеЗаписиДокументооборота.ПарольSMTP КАК ПарольSMTP,
							  |	УчетныеЗаписиДокументооборота.СерверSMTP КАК СерверSMTP,
							  |	УчетныеЗаписиДокументооборота.ПортSMTP КАК ПортSMTP,
							  |	УчетныеЗаписиДокументооборота.ТребуетсяSMTPАутентификация КАК ТребуетсяSMTPАутентификация,
							  |	УчетныеЗаписиДокументооборота.РежимАвтонастройки,
							  |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСФНС,
							  |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСПФР,
							  |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСФСГС,
							  |	УчетныеЗаписиДокументооборота.ПредназначенаДляДокументооборотаСЦБ,
							  |	УчетныеЗаписиДокументооборота.ИдентификаторАбонента,
							  |	УчетныеЗаписиДокументооборота.ИдентификаторСпецоператора,
							  |	УчетныеЗаписиДокументооборота.СпецоператорСвязи,
							  |	УчетныеЗаписиДокументооборота.ИдентификаторДокументооборота,
							  |	УчетныеЗаписиДокументооборота.ОператорРегНомерПФР КАК ОператорРегНомерПФР,
							  |	УчетныеЗаписиДокументооборота.ОператорНаименованиеПолное КАК ОператорНаименованиеПолное,
							  |	УчетныеЗаписиДокументооборота.ОператорНаименованиеКраткое КАК ОператорНаименованиеКраткое,
							  |	УчетныеЗаписиДокументооборота.ОператорИНН КАК ОператорИНН,
							  |	УчетныеЗаписиДокументооборота.ОператорКПП КАК ОператорКПП,
							  |	УчетныеЗаписиДокументооборота.ИспользуетсяЕЦППФР КАК ИспользуетсяЕЦППФР,
							  |	УчетныеЗаписиДокументооборота.ТипыДокументовЕЦППФР КАК ТипыДокументовЕЦППФР
							  |ИЗ
							  |	Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
							  |ГДЕ
							  |	УчетныеЗаписиДокументооборота.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", УчетнаяЗапись);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Результат.Вставить("АдресЭлектроннойПочты",							Выборка.АдресЭлектроннойПочты);
		Результат.Вставить("КодНалоговогоОргана",							Выборка.КодНалоговогоОргана);
		Результат.Вставить("АдресНалоговогоОргана",							Выборка.АдресНалоговогоОргана);
		Результат.Вставить("СертификатПочтовогоСервера",					Выборка.СертификатПочтовогоСервера);
		Результат.Вставить("АдресЭлектроннойПочтыПочтовогоСервера",			Выборка.АдресЭлектроннойПочтыПочтовогоСервера);
		Результат.Вставить("АдресЭлектроннойПочтыПочтовогоСервераПФР",		Выборка.АдресЭлектроннойПочтыПочтовогоСервераПФР);
		Результат.Вставить("АдресЭлектроннойПочтыПочтовогоСервераФСГС",		Выборка.АдресЭлектроннойПочтыПочтовогоСервераФСГС);
		Результат.Вставить("СертификатРуководителя",						Сертификат.Отпечаток); //+
		Результат.Вставить("СертификатГлавногоБухгалтера",					Сертификат.Отпечаток); //+
		Результат.Вставить("СертификатДляШифрования",						Сертификат.Отпечаток); //+
		Результат.Вставить("ОбменНапрямую",									Выборка.ОбменНапрямую);
		Результат.Вставить("СерверДокументооборота",						Выборка.СерверДокументооборота);
		Результат.Вставить("ИмяПользователяPOP3",							Выборка.ИмяПользователяPOP3);
		Результат.Вставить("ПарольPOP3",									Выборка.ПарольPOP3);
		Результат.Вставить("СерверPOP3",									Выборка.СерверPOP3);
		Результат.Вставить("ПортPOP3",										Выборка.ПортPOP3);
		Результат.Вставить("ИмяПользователяSMTP",							Выборка.ИмяПользователяSMTP);
		Результат.Вставить("ПарольSMTP",									Выборка.ПарольSMTP);
		Результат.Вставить("СерверSMTP",									Выборка.СерверSMTP);
		Результат.Вставить("ПортSMTP",										Выборка.ПортSMTP);
		Результат.Вставить("ТребуетсяSMTPАутентификация",					Выборка.ТребуетсяSMTPАутентификация);
		Результат.Вставить("РежимАвтонастройки",							Выборка.РежимАвтонастройки);
		Результат.Вставить("ПредназначенаДляДокументооборотаСФНС",			Выборка.ПредназначенаДляДокументооборотаСФНС);
		Результат.Вставить("ПредназначенаДляДокументооборотаСПФР",			Выборка.ПредназначенаДляДокументооборотаСПФР);
		Результат.Вставить("ПредназначенаДляДокументооборотаСФСГС",			Выборка.ПредназначенаДляДокументооборотаСФСГС);
		Результат.Вставить("ПредназначенаДляДокументооборотаСЦБ",			Выборка.ПредназначенаДляДокументооборотаСЦБ);
		Результат.Вставить("ИдентификаторАбонента",							Выборка.ИдентификаторАбонента);
		Результат.Вставить("ИдентификаторСпецоператора",					Выборка.ИдентификаторСпецоператора);
		Результат.Вставить("СпецоператорСвязи",								Выборка.СпецоператорСвязи);
		Результат.Вставить("ЭлектроннаяПодписьВМоделиСервиса", 				Сертификат.ЭлектроннаяПодписьВМоделиСервиса);
		Результат.Вставить("МодельХраненияЗакрытогоКлюча",	 				Сертификат.МодельХраненияЗакрытогоКлюча);
		Результат.Вставить("ТелефонМобильныйДляАвторизации", 				Сертификат.ТелефонМобильныйДляАвторизации);
		Результат.Вставить("ИдентификаторДокументооборота", 				Выборка.ИдентификаторДокументооборота);
		Результат.Вставить("ОператорРегНомерПФР", 							Выборка.ОператорРегНомерПФР);
		Результат.Вставить("ОператорНаименованиеПолное", 					Выборка.ОператорНаименованиеПолное);
		Результат.Вставить("ОператорНаименованиеКраткое", 					Выборка.ОператорНаименованиеКраткое);
		Результат.Вставить("ОператорИНН", 									Выборка.ОператорИНН);
		Результат.Вставить("ОператорКПП", 									Выборка.ОператорКПП);
		Результат.Вставить("ИспользуетсяЕЦППФР", 							Выборка.ИспользуетсяЕЦППФР);
		Результат.Вставить("ТипыДокументовЕЦППФР", 							Выборка.ТипыДокументовЕЦППФР);
		Результат.Вставить("УчетнаяЗаписьОблачнойПодписи", 					Сертификат.УчетнаяЗаписьОблачнойПодписи);
		
	ИначеЕсли ТипУчетнойЗаписи = Тип("СправочникОбъект.УчетныеЗаписиДокументооборота") Тогда
		
		Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись.Ссылка);
		
