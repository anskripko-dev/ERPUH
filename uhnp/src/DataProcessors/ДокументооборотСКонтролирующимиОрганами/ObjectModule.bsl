Функция СоздатьПодтверждениеПриНеобходимости(СсылкаНаОбъект)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.

	СообщениеОбОшибке = "";
	
	Результат = ПризнакАвтоматическогоФормированияПодтвержденийИТипСообщения(СсылкаНаОбъект, Истина);
	Если НЕ Результат.Автоподтверждение Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// формируем подтверждение на расшифрованное сообщение при необходимости
	Если Результат.ТребуетсяПодтверждение Тогда
	 
		ОтветноеСообщение = СоздатьПодтверждение(СсылкаНаОбъект);
		
		// Создадим пакет для отправки подтвержения.
		Если ОтветноеСообщение <> Неопределено Тогда
			СформироватьПакет(ОтветноеСообщение.Ссылка, СообщениеОбОшибке);
		Иначе
			СообщениеОбОшибке = ТекстСообщенийПользователю();
		КонецЕсли;

	КонецЕсли;
	
	Возврат НЕ ЗначениеЗаполнено(СообщениеОбОшибке);
	
КонецФункции

Функция СоздатьПодтверждение(Основание)

	// Внимание!
	// ---------
	// В Контейнере есть одноименная процедура, которая используется при отправке отчетов
	// в интерактивном режиме пользователем.
	// При изменениях необходимо синхронно менять обе процедуры.
	
	// создаем на сервере
	ОтветноеСообщение = СоздатьИЗаполнитьОтветноеСообщение(Основание);
	Если ОтветноеСообщение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстОтправки = Новый Структура("Подтверждение", ОтветноеСообщение.Ссылка);
	
	// различные действия на сервере в зависимости от типа сообщения
	ТипОснования = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ЗначениеРеквизитаОбъекта(Основание, "Тип");
	Если ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПротоколПФР Тогда
		
		ПодписатьСообщение("ПФР", КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееПФР Тогда
		
		ПодписатьСообщение("ПФР", КонтекстОтправки, ОтветноеСообщение.Ссылка, ОтветноеСообщение.Тип, "Руководитель", ОтветноеСообщение.УчетнаяЗапись, Основание);
		
	ИначеЕсли ТипОснования = Перечисления.ТипыТранспортныхСообщений.ПодтверждениеДатыОтправкиФСГС Тогда
		
