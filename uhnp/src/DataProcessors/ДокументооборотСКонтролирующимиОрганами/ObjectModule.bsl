Функция СертификатыПользователейВНастройкахОбменаАктуальны(
		СертификатыИзРегФайла,
		Организация,
		ИмяРегистра,
		ИмяРесурсаОтпечатка) Экспорт
		
	ОтпечаткиИзРегФайла = Новый Массив;
	Для каждого Запись Из СертификатыИзРегФайла Цикл
		ОтпечаткиИзРегФайла.Добавить(НРег(Запись.Ключ));
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ИмяРесурсаОтпечатка КАК Отпечаток,
	|	НастройкиОбмена.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбмена
	|ГДЕ
	|	НастройкиОбмена.Организация = &ОрганизацияСсылка
	|	И НЕ НастройкиОбмена.Пользователь ЕСТЬ NULL
	|	И НастройкиОбмена.Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяРесурсаОтпечатка", "НастройкиОбмена." + ИмяРесурсаОтпечатка);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиОбменаФСС", ИмяРегистра);
	
	Запрос.УстановитьПараметр("ОрганизацияСсылка", Организация);
	
	ОтпечаткиИзРегистра = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Отпечаток");
	
	Актуальны = ОбщегоНазначения.КоллекцииИдентичны(ОтпечаткиИзРегистра, ОтпечаткиИзРегФайла);
	Возврат Актуальны;
	
КонецФункции

Функция МодельХраненияУчетнойЗаписи(ДокументDOM, ПараметрыФункции, УчетнаяЗапись)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЭтоМультиРежим = Мультирежим.ЭтоМультиРежимИзРегФайла(ДокументDOM);
	
	Если ЭтоМультиРежим Тогда
		
		ЕдинаяМодель = Ложь;
		
		Модели = Новый Массив;
		Модели.Добавить(Перечисления.МодельХраненияЗакрытогоКлюча.ЛокальныйКлюч);
		Модели.Добавить(Перечисления.МодельХраненияЗакрытогоКлюча.ОблачнаяПодпись);
		Модели.Добавить(Перечисления.МодельХраненияЗакрытогоКлюча.ВМоделиСервиса);
		Для каждого Модель Из Модели Цикл
		
			Если ВсеСертификатыСОднойМоделью(УчетнаяЗапись, Модель) Тогда
				МодельХраненияКлюча = Модель;
				ЕдинаяМодель = Истина;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
		Если НЕ ЕдинаяМодель ТОгда
			МодельХраненияКлюча = Перечисления.МодельХраненияЗакрытогоКлюча.Смешанная;
			ТелефонМобильныйДляАвторизации = "";
		КонецЕсли;
		
	Иначе
		МодельХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(ПараметрыФункции);
		ТелефонМобильныйДляАвторизации = ПараметрыФункции.ТелефонМобильныйДляАвторизации;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("МодельХраненияКлюча", МодельХраненияКлюча);
	Результат.Вставить("ТелефонМобильныйДляАвторизации", ТелефонМобильныйДляАвторизации);
	
	Возврат Результат;

КонецФункции

Функция ВсеСертификатыСОднойМоделью(УчетнаяЗапись, МодельХранения)

	Отбор = Новый Структура();
	Отбор.Вставить("Текущий", Истина);
	
	ТекущиеСертификаты = УчетнаяЗапись.СертификатыЛичные.НайтиСтроки(Отбор);
	
	Отбор.Вставить("МодельХраненияЗакрытогоКлюча", МодельХранения);
	СтрокиСМоделью = УчетнаяЗапись.СертификатыЛичные.НайтиСтроки(Отбор);
		
	Результат = ТекущиеСертификаты.Количество() = СтрокиСМоделью.Количество();
	
	Возврат Результат;
	
КонецФункции

