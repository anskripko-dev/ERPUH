Функция ПредставлениеОрганов(Направления)
	
	// Выбрана часть органов
	Органы = Новый Массив;
	Для каждого Направление Из Направления Цикл
		
		Если Направление.Подключить И Направление.ПризнакПоддержки Тогда
		
			ПредставлениеОргана = Направление.Орган;
			
			Если Направление.Детализация <> Неопределено И Направление.Детализация.Количество() > 1 Тогда
				ПредставлениеОргана = ПредставлениеОргана + "(" + Строка(Направление.Детализация.Количество()) + ")";
			КонецЕсли;
			
			ПредставлениеОргана = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ПредставлениеОргана);
			Органы.Добавить(ПредставлениеОргана);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Органы = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Органы);
	
	ПредставлениеОрганов 	= СтрСоединить(Органы, ", ");
	ПозицияПоследнейЗапятой = СтрНайти(ПредставлениеОрганов, ",", НаправлениеПоиска.СКонца);
	
	ЛеваяЧасть  = СокрЛП(Лев(ПредставлениеОрганов, ПозицияПоследнейЗапятой - 1));
	ПраваяЧасть = СокрЛП(Сред(ПредставлениеОрганов, ПозицияПоследнейЗапятой + 1));
	
	// Добавляем "и" перед последним словом
	Если ЛеваяЧасть = "" Тогда
		ПредставлениеОрганов = ПраваяЧасть;
	Иначе
		ПредставлениеОрганов = ЛеваяЧасть + " и " + ПраваяЧасть;
	КонецЕсли;

	Возврат ПредставлениеОрганов;
	
КонецФункции

Функция ИнициализироватьТаблицуОрганов(Форма) Экспорт
	
	Направления = Новый ТаблицаЗначений;
	Направления.Колонки.Добавить("Орган");
	Направления.Колонки.Добавить("Подключить");
	Направления.Колонки.Добавить("ПризнакПоддержки");
	Направления.Колонки.Добавить("Детализация");
	
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'ФНС';
												|en = 'FTS'"), Форма.СдаватьВФНС, Форма.ПризнакПоддержкиФНС, Форма.ПолучателиФНС);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'ПФР';
												|en = 'Pension Fund'"), Форма.СдаватьВПФР, Форма.ПризнакПоддержкиПФР);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'Росстат';
												|en = 'Russian Federal State Statistics Service'"), Форма.СдаватьВРосстат, Форма.ПризнакПоддержкиРосстат, Форма.ПолучателиФСГС);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'ФСС';
												|en = 'Social Security Fund'"), Форма.СдаватьВФСС, Форма.ПризнакПоддержкиФСС);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'ФСРАР';
												|en = 'FSAMR'"), Форма.ПодатьЗаявкуНаСертификатДляФСРАР, Форма.ПризнакПоддержкиФСРАР);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'РПН';
												|en = 'RPN'"), Форма.ПодатьЗаявкуНаПодключениеРПН, Форма.ПризнакПоддержкиРПН);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'ФТС';
												|en = 'FCS'"), Форма.ПодатьЗаявкуНаПодключениеФТС, Форма.ПризнакПоддержкиФТС);
	ДобавитьСтрокуНаправления(Направления, НСтр("ru = 'Банк России';
												|en = 'The Bank Of Russia'"), Форма.СдаватьВЦБ, Форма.ПризнакПоддержкиЦБ);
	
	Возврат Направления;
	
КонецФункции

Процедура ДобавитьСтрокуНаправления(Направления, Орган, Подключить, ПризнакПоддержки, Детализация = Неопределено)
	
	НоваяСтрока = Направления.Добавить();
	НоваяСтрока.Орган = Орган;
	НоваяСтрока.Подключить = Подключить;
	НоваяСтрока.ПризнакПоддержки = ПризнакПоддержки;
	НоваяСтрока.Детализация = Детализация;
	
КонецПроцедуры

Функция НоваяСтрокаТаблицыОрганов()
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Орган", 		Перечисления.ТипыКонтролирующихОрганов.ПустаяСсылка());
	ДополнительныеПараметры.Вставить("Доступен", 	Истина);
	ДополнительныеПараметры.Вставить("Подключить", 	Истина);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Процедура ОпределитьПодключаемыеНаправленияСдачиОтчетности(Форма, ЭтоСкопированоеЗаявление = Ложь) Экспорт
	
	Направления = Новый Массив;
	
	// Признаки ПризнакПоддержкиФСРАР, ПризнакПоддержкиРПН, ПризнакПоддержкиФТС 
	// определяются настройками спецоператора в процедуре ИнициализироватьПараметрыУЦ
	
	// ФНС
	НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
	НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ФНС;
	Направления.Добавить(НоваяСтрока);
	
	// ПФР
	НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
	НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ПФР;
	Направления.Добавить(НоваяСтрока);
	
	// Росстат
	НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
	НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ФСГС;
	Направления.Добавить(НоваяСтрока);
	
	// ФСС
	НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
	НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ФСС;
	Направления.Добавить(НоваяСтрока);
	
	// ФСРАР
	Если Форма.ПризнакПоддержкиФСРАР Тогда
		// Если оператор не поддерживает орган, то не даем переопределять это признак
		НоваяСтрока 		= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 	= Перечисления.ТипыКонтролирующихОрганов.ФСРАР;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	// РПН
	Если Форма.ПризнакПоддержкиРПН Тогда
		// Если оператор не поддерживает орган, то не даем переопределять это признак
		НоваяСтрока 		= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 	= Перечисления.ТипыКонтролирующихОрганов.РПН;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;

	// ФТС
	Если Форма.ПризнакПоддержкиФТС Тогда
		// Если оператор не поддерживает орган, то не даем переопределять это признак
		НоваяСтрока 		= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 	= Перечисления.ТипыКонтролирующихОрганов.ФТС;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	// ЦБ
	Если ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		НоваяСтрока 		= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 	= Перечисления.ТипыКонтролирующихОрганов.ЦБ;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.ОпределитьПодключаемыеНаправленияСдачиОтчетности(
		Форма.Организация, Направления);
	
	// ФСРАР
	Если НЕ Форма.ПризнакПоддержкиФСРАР Тогда
		НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ФСРАР;
		НоваяСтрока.Доступен 	= Ложь;
		НоваяСтрока.Подключить 	= Ложь;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	// РПН
	Если НЕ Форма.ПризнакПоддержкиРПН Тогда
		НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.РПН;
		НоваяСтрока.Доступен 	= Ложь;
		НоваяСтрока.Подключить 	= Ложь;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;

	// ФТС
	Если НЕ Форма.ПризнакПоддержкиФТС Тогда
		НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ФТС;
		НоваяСтрока.Доступен 	= Ложь;
		НоваяСтрока.Подключить 	= Ложь;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	// ЦБ
	Если НЕ ДокументооборотСКОКлиентСервер.ПодсистемаЦБСуществует() Тогда
		НоваяСтрока 			= НоваяСтрокаТаблицыОрганов();
		НоваяСтрока.Орган 		= Перечисления.ТипыКонтролирующихОрганов.ЦБ;
		НоваяСтрока.Доступен 	= Ложь;
		НоваяСтрока.Подключить 	= Ложь;
		Направления.Добавить(НоваяСтрока);
	КонецЕсли;
	
	Для каждого Направление Из Направления Цикл
		
		Если Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
			
			Форма.ПризнакПоддержкиФНС = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.СдаватьВФНС = Форма.СдаватьВФНС И Форма.ПризнакПоддержкиФНС;
			Иначе
				Форма.СдаватьВФНС = Направление.Подключить И Форма.ПризнакПоддержкиФНС;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
			
			Форма.ПризнакПоддержкиПФР = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.СдаватьВПФР = Форма.СдаватьВПФР И Форма.ПризнакПоддержкиПФР;
			Иначе
				Форма.СдаватьВПФР = Направление.Подключить И Форма.ПризнакПоддержкиПФР;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
			
			Форма.ПризнакПоддержкиРосстат = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.СдаватьВРосстат = Форма.СдаватьВРосстат И Форма.ПризнакПоддержкиРосстат;
			Иначе
				Форма.СдаватьВРосстат = Направление.Подключить И Форма.ПризнакПоддержкиРосстат;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
			
			Форма.ПризнакПоддержкиФСС = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.СдаватьВФСС = Форма.СдаватьВФСС И Форма.ПризнакПоддержкиФСС;
			Иначе
				Форма.СдаватьВФСС = Направление.Подключить И Форма.ПризнакПоддержкиФСС;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ФСРАР Тогда
			
			Форма.ПризнакПоддержкиФСРАР = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.ПодатьЗаявкуНаСертификатДляФСРАР = Форма.ПодатьЗаявкуНаСертификатДляФСРАР И Форма.ПризнакПоддержкиФСРАР;
			Иначе
				Форма.ПодатьЗаявкуНаСертификатДляФСРАР = Направление.Подключить И Форма.ПризнакПоддержкиФСРАР;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.РПН Тогда
			
			Форма.ПризнакПоддержкиРПН = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.ПодатьЗаявкуНаПодключениеРПН = Форма.ПодатьЗаявкуНаПодключениеРПН И Форма.ПризнакПоддержкиРПН;
			Иначе
				Форма.ПодатьЗаявкуНаПодключениеРПН = Направление.Подключить И Форма.ПризнакПоддержкиРПН;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
			
			Форма.ПризнакПоддержкиФТС = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.ПодатьЗаявкуНаПодключениеФТС = Форма.ПодатьЗаявкуНаПодключениеФТС И Форма.ПризнакПоддержкиФТС;
			Иначе
				Форма.ПодатьЗаявкуНаПодключениеФТС = Направление.Подключить И Форма.ПризнакПоддержкиФТС;
			КонецЕсли;
			
		ИначеЕсли Направление.Орган = Перечисления.ТипыКонтролирующихОрганов.ЦБ Тогда
			
			Форма.ПризнакПоддержкиЦБ = Направление.Доступен;
			
			Если ЭтоСкопированоеЗаявление Тогда
				Форма.СдаватьВЦБ = Форма.СдаватьВЦБ И Форма.ПризнакПоддержкиЦБ;
			Иначе
				Форма.СдаватьВЦБ = Направление.Подключить И Форма.ПризнакПоддержкиЦБ;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьПараметрыУЦ(Форма) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Форма.Спецоператор) Тогда
		Спецоператоры = ПолучитьСписокСпецоператоровСвязи();
		Форма.Спецоператор  = Спецоператоры[0];
	КонецЕсли;
	
	НачатьОпределениеДанныхУЦ(Форма);
	ПараметрыСпецоператора = ПолучитьПараметрыОператораСвязи(Форма.Спецоператор);
	
	Форма.ПризнакПоддержкиФСРАР = ПараметрыСпецоператора.ФСРАРПризнак = Истина
		ИЛИ ПараметрыСпецоператора.ФСРАРПризнак = "Истина";
	
	Форма.ПризнакПоддержкиРПН = ПараметрыСпецоператора.РПНПризнак = Истина
		ИЛИ ПараметрыСпецоператора.РПНПризнак = "Истина";
	
	Форма.ПризнакПоддержкиФТС = ПараметрыСпецоператора.ФТСПризнак = Истина
		ИЛИ ПараметрыСпецоператора.ФТСПризнак = "Истина";
	
	Форма.ОператорПоддерживаетСМСУведомление = ПараметрыСпецоператора.ПризнакПоддержкиСМС = Истина
		ИЛИ ПараметрыСпецоператора.ПризнакПоддержкиСМС = "Истина";
	
КонецПроцедуры

Процедура НачатьОпределениеДанныхУЦ(Форма)

	Если Форма.ЗапретитьИзменение Тогда
		Возврат;
	КонецЕсли;
	
	Форма.АдресЗаданияПоПолучениюДанныхССервераКА = ПоместитьВоВременноеХранилище(Неопределено, Форма.УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Спецоператор", 	Форма.Спецоператор);
	ДополнительныеПараметры.Вставить("АдресХранилища",  Форма.АдресЗаданияПоПолучениюДанныхССервераКА);
	
	ПолучитьДанныеССервераКАФоновоеЗадание(ДополнительныеПараметры); 

КонецПроцедуры

Процедура УдалитьПрисоединенныеФайлы(НовыйДокументЗаявление)
	
	МассивУдаляемыхФайлов = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(НовыйДокументЗаявление.Ссылка, МассивУдаляемыхФайлов);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого ПрисоединенныйФайлСсылка Из МассивУдаляемыхФайлов Цикл
		ПрисоединенныйФайлОбъект = ПрисоединенныйФайлСсылка.ПолучитьОбъект();
		ПрисоединенныйФайлОбъект.Удалить()
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьДокументыЗаявления(Форма, НовыйДокументЗаявление) Экспорт
	
	НовыйДокументЗаявление.Записать();
	НовыйДокументЗаявление.ЭлектронныеДокументы.Очистить();
	УдалитьПрисоединенныеФайлы(НовыйДокументЗаявление);
	
	НомераФайлов = Новый Соответствие;
	
	Для Каждого ЭлементСписка Из Форма.ФайлыДокументов Цикл
		
		Свойства = ЭлементСписка.Значение;
		
		Документ = Свойства.Документ;
		ВидыДокументов = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма);
		
		// Не сохраняем документы, которые не видны.
		// Такая ситуация может возникнуть при смене способа подписания или при неудачной отправке заявления
		Если НЕ ВидыДокументов.Свойство(Документ) ИЛИ НЕ ВидыДокументов[Документ].Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
		ПараметрыФайла.Вставить("ВладелецФайлов", НовыйДокументЗаявление.Ссылка);
		
		Файл = Новый Файл(Свойства.ИсходноеИмя);
		
		Представление 	 = ВидыДокументов[Документ].Представление;
		
		ИмяБезРасширения = ИмяПрисоединенногоФайла(Документ, Представление, НомераФайлов);
		
		ПараметрыФайла.Вставить("ИмяБезРасширения", 			ИмяБезРасширения);
		ПараметрыФайла.Вставить("РасширениеБезТочки", 			СтрЗаменить(Файл.Расширение, ".", ""));
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", 	ТекущаяУниверсальнаяДата());
		ПараметрыФайла.Вставить("Автор", 						Пользователи.ТекущийПользователь());
		
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Свойства.Адрес);
		
		НоваяСтрока = НовыйДокументЗаявление.ЭлектронныеДокументы.Добавить();
		НоваяСтрока.Документ 	= Свойства.Документ;
		НоваяСтрока.Файл 		= ПрисоединенныйФайл;
		
		Если Свойства.Свойство("Размер") И Свойства.Размер > 0 Тогда
			НоваяСтрока.Размер = Свойства.Размер;
		Иначе
			ДвДанные = ПолучитьИзВременногоХранилища(Свойства.Адрес);
			НоваяСтрока.Размер = ДвДанные.Размер();
		КонецЕсли;
		
		Если Свойства.Свойство("ЭтоМЧД")  Тогда
			НоваяСтрока.ЭтоМЧД = Свойства.ЭтоМЧД;
		КонецЕсли;
		
		Если Свойства.Свойство("ЭтоПодписьКМЧД") Тогда
			НоваяСтрока.ЭтоПодписьКМЧД = Свойства.ЭтоПодписьКМЧД;
		КонецЕсли;
		
		Если Свойства.Свойство("МЧД") Тогда
			НоваяСтрока.МЧД = Свойства.МЧД;
		КонецЕсли;
		
	КонецЦикла;
	
	НовыйДокументЗаявление.Записать();
		
КонецПроцедуры

Функция ИмяПрисоединенногоФайла(Документ, Представление, НомераФайлов)

	Если НомераФайлов.Получить(Документ) = Неопределено Тогда
		НомераФайлов.Вставить(Документ, 1);
	Иначе
		НомераФайлов[Документ] = НомераФайлов[Документ] + 1;
	КонецЕсли;
	
	Если НомераФайлов[Документ] = 1 Тогда
		ИмяФайла = Представление;
	Иначе
		ИмяФайла = СтрШаблон("%1 - %2", Представление, Формат(НомераФайлов[Документ], "ЧВН=; ЧГ="));
	КонецЕсли;
	
	Возврат ИмяФайла;

КонецФункции

Процедура ЗаполнитьДокументыИзСкопированногоЗаявления(Форма) Экспорт
	
	ВидыДокументов = ОбработкаЗаявленийАбонентаКлиентСервер.ВидыДокументовПоФорме(Форма);
	
	Для Каждого ЭлектронныйДокумент Из Форма.Реквизит.ЭлектронныеДокументы Цикл
		
		// Среди присоединенных документов могут еще быть файлы архивов, текст заявления, подписи
		ЭтоСкан = ВидыДокументов.Свойство(ЭлектронныйДокумент.Документ);
		Если НЕ ЭтоСкан Тогда
			Продолжить;
		КонецЕсли;
		
		ДополнительныеПараметры = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ДополнительныеПараметры.ИдентификаторФормы 				= Форма.УникальныйИдентификатор;
		ДополнительныеПараметры.ПолучатьСсылкуНаДвоичныеДанные 	= Истина;
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ЭлектронныйДокумент.Файл, ДополнительныеПараметры);
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Размер", 		 ДанныеФайла.Размер);
		ОписаниеФайла.Вставить("Адрес", 		 ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ОписаниеФайла.Вставить("ИсходноеИмя", 	 ДанныеФайла.ИмяФайла);
		ОписаниеФайла.Вставить("Документ", 		 ЭлектронныйДокумент.Документ);
		ОписаниеФайла.Вставить("МЧД", 			 ЭлектронныйДокумент.МЧД);
		ОписаниеФайла.Вставить("ЭтоМЧД", 		 ЭлектронныйДокумент.ЭтоМЧД);
		ОписаниеФайла.Вставить("ЭтоПодписьКМЧД", ЭлектронныйДокумент.ЭтоПодписьКМЧД);
		
		Форма.ФайлыДокументов.Добавить(ОписаниеФайла, ЭлектронныйДокумент.Документ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьНастройкиРежимаОграниченнойФункциональности(Форма) Экспорт

	Форма.ЭтоРежимОграниченнойФункциональности = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЭтоРежимОграниченнойФункциональности();
	Форма.ЭтоРежимБесплатнойНулевойОтчетности  = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЭтоРежимБесплатнойНулевойОтчетности();
	
	// Для тестирования нулевки:
	//Форма.ЭтоРежимОграниченнойФункциональности = Истина;
	//Форма.ЭтоРежимБесплатнойНулевойОтчетности  = Истина;
	
	Если Форма.ЭтоРежимБесплатнойНулевойОтчетности Тогда
		Форма.СсылкаПерейдитеНаПлатныйТариф = ЭлектронныйДокументооборотСКонтролирующимиОрганами.СсылкаПерейдитеНаПлатныйТариф();
		// Для тестирования нулевки:
		// СсылкаПерейдитеНаПлатныйТариф = "https://1cnul.ru/tarif/";
	Иначе
		Форма.СсылкаПерейдитеНаПлатныйТариф = "";
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоСертификатУЦКалугиПоИмениУЦ(ИмяУЦСертификта) Экспорт
	
	ИменаУЦКалуги = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ИменаУЦКалуги();
	ИменаУЦ       = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаУЦКалуги, Символы.ПС);
	
	ЭтоСертификатКалуги = Ложь;
	Для каждого ИмяУЦ Из ИменаУЦ Цикл
		Если ИмяУЦ = ИмяУЦСертификта Тогда
			ЭтоСертификатКалуги = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;  

	Возврат ЭтоСертификатКалуги;
	
КонецФункции

Функция НастройкиУчетнойЗаписиОрганизации(Организация) Экспорт
	
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	Если УчетнаяЗапись = Неопределено ИЛИ УчетнаяЗапись = Справочники.УчетныеЗаписиДокументооборота.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьНастройкиУчетнойЗаписиИзИБ(УчетнаяЗапись);
	
КонецФункции

Функция ОформлениеНаправлений(Параметры) Экспорт
	
	Заголовок   = "";
	ЦветТекста  = Новый Цвет;
	КрасныйЦвет = Новый Цвет(178,34, 34);
	
	Направления = ИнициализироватьТаблицуОрганов(Параметры);
	
	Если НеВыбранНиОдинОрган(Направления) Тогда
		
		// Ни один орган не выбран или не доступен
		Заголовок  = НСтр("ru = 'Уточнить';
							|en = 'Specify'");
		ЦветТекста = КрасныйЦвет;
		
	ИначеЕсли НЕ ПроверитьНаправления(Параметры, , Ложь) Тогда
		
		// Ни один орган не выбран или не доступен
		Заголовок  = НСтр("ru = 'Обнаружены ошибки';
							|en = 'Errors are found'");
		ЦветТекста = КрасныйЦвет;
		
	ИначеЕсли ВыбраныВсеНаправления(Направления) 
		И НЕ ВыбранТолькоОдинОрган(Направления)
		И Параметры.ЭтоГосОрганыУчетнойЗаписи Тогда
		
		// Выбраны все органы
		Заголовок  = НСтр("ru = 'Все направления';
							|en = 'All lines of business'");
		ЦветТекста = Новый Цвет();
		
	Иначе
		
		// Выбрана часть органов
		Заголовок  = ПредставлениеОрганов(Направления);
		ЦветТекста = Новый Цвет();
		
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("ЦветТекста", ЦветТекста);
	
	Возврат Результат;
	
КонецФункции

