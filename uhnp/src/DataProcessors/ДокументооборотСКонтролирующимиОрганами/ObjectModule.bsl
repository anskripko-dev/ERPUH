#Область ПечатьСертификата

Процедура ПечатьСертификатаНаСервере(ТабличныйДокумент, Сертификат) Экспорт
	
	ВступилВСилу = ПриказФСБ50ВступилВСилу();
	
	Если ВступилВСилу Тогда
		Макет = ПолучитьМакетОбработки("ПечатьСертификатПриказФСБ50");
	Иначе
		Макет = ПолучитьМакетОбработки("ПечатьСертификат");
	КонецЕсли;
		
	Свойства  = ПолучитьСвойстваСертификатаДляПечати(Сертификат);
	ЭтоЮЛ     = Свойства.ЭтоЮрЛицо;
	
	Имена = Новый Массив;
	Имена.Добавить("Шапка");
	Имена.Добавить(?(ЭтоЮЛ,"СведенияОЮЛ", "СведенияОИП"));
	Имена.Добавить("Подвал");
	
	Для каждого ИмяОбласти Из Имена Цикл
		Область = Макет.ПолучитьОбласть(ИмяОбласти);
		Область.Параметры.Заполнить(Свойства);
		ТабличныйДокумент.Вывести(Область);
	КонецЦикла;
	
	РазместитьНаОдномЛисте(ТабличныйДокумент);
	
КонецПроцедуры

Процедура РазместитьНаОдномЛисте(ТабличныйДокумент) Экспорт
	
	Попытка
		
		Дельта = 0;
		ТабличныйДокумент.МасштабПечати = 100;
		Пока ТабличныйДокумент.КоличествоСтраниц() > 1 И Дельта < 20 Цикл
			Дельта = Дельта + 1;
			ТабличныйДокумент.АвтоМасштаб = Ложь;
			ТабличныйДокумент.МасштабПечати = 100 - Дельта;
		КонецЦикла;
		
	Исключение
		
		ТабличныйДокумент.МасштабПечати = 100;
		ТабличныйДокумент.АвтоМасштаб = Истина;
		
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Электронный документооборот с контролирующими органами.Печать на одну страницу';
										|en = 'EDI with regulatory authorities. Print on one page'", КодОсновногоЯзыка),УровеньЖурналаРегистрации.Ошибка,,,ИнформацияОбОшибке);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСвойстваСертификатаДляПечати(Сертификат) Экспорт
	
	ВступилВСилу = ПриказФСБ50ВступилВСилу();
	
	РасширенныеСвойства = ПолучитьРасширенныеСвойстваСертификата(Сертификат);
	
	СертификатКриптографии = Новый СертификатКриптографии(Сертификат);
	
	СвойстваСертификата = РасширенныеСвойства;
	СвойстваСертификата.Вставить("СерийныйНомер", СертификатКриптографии.СерийныйНомер);
	ПериодДействия = СтрШаблон(
		НСтр("ru = 'с %1 по %2';
			|en = 'from %1 to %2'"), 
		Формат(СертификатКриптографии.ДатаНачала, "ДФ='dd MMMM yyyy ''г.'' H:mm:ss'"),
		Формат(СертификатКриптографии.ДатаОкончания, "ДФ='dd MMMM yyyy ''г.'' H:mm:ss'"));
	СвойстваСертификата.Вставить("ПериодДействия", ПериодДействия);
	
	Субъект = СертификатКриптографии.Субъект;
	
	Если Субъект.Свойство("OID1_2_643_100_3") Тогда 
		СвойстваСертификата.Вставить("СНИЛС", Субъект.OID1_2_643_100_3);
	КонецЕсли;
	
	ИНН = ДокументооборотСКОКлиентСервер.ИННИзСертификата(Субъект);
	ЭтоЮрЛицо = СтрДлина(ИНН) = 10;
	
	Если ЭтоЮрЛицо Тогда
		
		СвойстваСертификата.Вставить("Наименование", Субъект.CN);

		Если Субъект.Свойство("OID1_2_643_100_1") Тогда
			СвойстваСертификата.Вставить("ОГРН", Субъект.OID1_2_643_100_1);
		КонецЕсли;
		
		СвойстваСертификата.Вставить("ИНН", ИНН);
		СвойстваСертификата.Вставить("Адрес",   АдресИзСертификатаКриптографии(Субъект));
		СвойстваСертификата.Вставить("Фамилия", Субъект.OID2_5_4_4);
		СвойстваСертификата.Вставить("ИмяОтчество", Субъект.OID2_5_4_42);
		Если Субъект.Свойство("OID2_5_4_12") Тогда
			СвойстваСертификата.Вставить("Должность", Субъект.OID2_5_4_12);
		Иначе
			СвойстваСертификата.Вставить("Должность", "-");
		КонецЕсли;
		
		Владелец = Субъект.OID2_5_4_4 + " " + Субъект.OID2_5_4_42;
		
	Иначе
		
		Если Субъект.Свойство("OID1_2_643_100_5") Тогда
			СвойстваСертификата.Вставить("ОГРН", Субъект.OID1_2_643_100_5);
		КонецЕсли;
		СвойстваСертификата.Вставить("ИНН", ИНН);
		СвойстваСертификата.Вставить("Фамилия", Субъект.OID2_5_4_4);
		СвойстваСертификата.Вставить("ИмяОтчество", Субъект.OID2_5_4_42);

		Владелец = Субъект.CN;
		
	КонецЕсли;
	
	Если Субъект.Свойство("OID1_2_840_113549_1_9_1") Тогда
		СвойстваСертификата.Вставить("ЭлектроннаяПочта", Субъект.OID1_2_840_113549_1_9_1);
	Иначе
		СвойстваСертификата.Вставить("ЭлектроннаяПочта", "");
	КонецЕсли;
	
	Криптопровайдер = КриптографияЭДКОСлужебныйВызовСервера.ИзвлечьКриптопровайдер(Сертификат);
	Если Криптопровайдер <> Неопределено Тогда
		СвойстваСертификата.Вставить("Криптопровайдер", Криптопровайдер.ТипКриптопровайдера);
	КонецЕсли;
	
	ДопСвойстваСертификата = КриптографияЭДКОСлужебныйВызовСервера.ПолучитьСвойстваСертификата(Сертификат);
	Если ДопСвойстваСертификата.ТипИдентификации <> Неопределено Тогда
		СвойстваСертификата.Вставить("ТипИдентификации", ДопСвойстваСертификата.ТипИдентификации);
	КонецЕсли;
	Если ДопСвойстваСертификата.СерийныйНомерСертификатаУЦ <> Неопределено Тогда
		СвойстваСертификата.Вставить("СерийныйНомерСертификатаУЦ", ДопСвойстваСертификата.СерийныйНомерСертификатаУЦ);
	КонецЕсли;
	
	Если ДопСвойстваСертификата.КлючДействителенС <> Неопределено И ДопСвойстваСертификата.КлючДействителенПо <> Неопределено Тогда
		
		ПериодДействияКлюча = СтрШаблон(
			НСтр("ru = 'с %1 по %2';
				|en = 'from %1 to %2'"), 
			Формат(ДопСвойстваСертификата.КлючДействителенС, "ДФ='dd MMMM yyyy ''г.'' H:mm:ss'"),
			Формат(ДопСвойстваСертификата.КлючДействителенПо, "ДФ='dd MMMM yyyy ''г.'' H:mm:ss'"));
		
		СвойстваСертификата.Вставить("ПериодДействияКлюча", ПериодДействияКлюча);
		
	КонецЕсли;
	
	СвойстваСертификата.Вставить("ОткрытыйКлюч", СертификатКриптографии.ОткрытыйКлюч);
	СвойстваСертификата.Вставить("НаименованиеУЦ", СертификатКриптографии.Издатель.CN);
	СвойстваСертификата.Вставить("АдресУЦ", АдресИзСертификатаКриптографии(СертификатКриптографии.Издатель));
	СвойстваСертификата.Вставить("Владелец", Владелец);
	СвойстваСертификата.Вставить("ЭтоЮрЛицо", ЭтоЮрЛицо);
	
	Возврат СвойстваСертификата;
	
КонецФункции

Функция ПриказФСБ50ВступилВСилу() Экспорт
	
	ВступилВСилу = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("ПриказФСБ50", ТекущаяДата() >= Дата(2024,09,01));
	Возврат ВступилВСилу;
	
КонецФункции

Функция АдресИзСертификатаКриптографии(Источник)
	
	Издатель = Новый Структура("C, ST, L, Street"); 
	ЗаполнитьЗначенияСвойств(Издатель, Источник);
	
	Адрес = Новый Массив;
	
	Если ЗначениеЗаполнено(Издатель.C) Тогда
		Адрес.Добавить(Издатель.C);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Издатель.ST) Тогда
		Адрес.Добавить(Издатель.ST);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Издатель.L) Тогда
		Адрес.Добавить(Издатель.L);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Издатель.Street) Тогда
		Адрес.Добавить(Издатель.Street);
	КонецЕсли;
	
	Адрес = СтрСоединить(Адрес, ", ");
	
	Возврат Адрес;
			
КонецФункции

Функция НайтиСигнатуру(Байты, Сигнатура, Позиция)
	
	НачалаСигнатуры = -1;
	СигнатураНайдена = Ложь;
	Для Индекс = Позиция + 1 По Байты.ВГраница() - Сигнатура.ВГраница() Цикл
		Байт = Байты[Индекс];
		Если Байт = Сигнатура[0] Тогда
			СигнатураНайдена = Истина;
			Для Индекс2 = 1 По Сигнатура.Количество() - 1 Цикл
				Если Байты[Индекс2 + Индекс] <> Сигнатура[Индекс2] Тогда
					СигнатураНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СигнатураНайдена Тогда
				НачалаСигнатуры = Индекс;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НачалаСигнатуры;
	
КонецФункции

Функция ПолучитьРасширенныеСвойстваСертификата(Сертификат)
	
	РасширенныеСвойства = Новый Структура;
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Сертификат.Записать(ИмяФайла);
	
	Байты = ПрочитатьФайлВМассив(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	
	Сигнатура = Новый Массив; // Ищем OID 1.2.643.100.111
	Сигнатура.Добавить(6);
	Сигнатура.Добавить(5);
	Сигнатура.Добавить(42);
	Сигнатура.Добавить(133);
	Сигнатура.Добавить(3);
	Сигнатура.Добавить(100);
	Сигнатура.Добавить(111);
	
	Позиция = 0;
	НачалоСигнатуры = НайтиСигнатуру(Байты, Сигнатура, Позиция);
	
	Если НачалоСигнатуры <> -1 Тогда
		Позиция = НачалоСигнатуры + Сигнатура.Количество();
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING	
		Позиция = Позиция + 1; // сдвиг сразу к UTF8String
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Строка = ПрочитатьСтроку(Байты, Позиция, Размер);
		
		РасширенныеСвойства.Вставить("СКЗИ", Строка);
	КонецЕсли;
	
	Сигнатура = Новый Массив; // Ищем OID 1.2.643.100.112
	Сигнатура.Добавить(6);
	Сигнатура.Добавить(5);
	Сигнатура.Добавить(42);
	Сигнатура.Добавить(133);
	Сигнатура.Добавить(3);
	Сигнатура.Добавить(100);
	Сигнатура.Добавить(112);
	
	НачалоСигнатуры = НайтиСигнатуру(Байты, Сигнатура, Позиция);	
		
	Если НачалоСигнатуры <> -1 Тогда
		Позиция = НачалоСигнатуры + Сигнатура.Количество();
		//Позиция = Позиция + 1;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING	
		Позиция = Позиция + 1; // сдвиг сразу к UTF8String
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Позиция = Позиция + 1;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Строка = ПрочитатьСтроку(Байты, Позиция, Размер);
		РасширенныеСвойства.Вставить("СКЗИ", Строка);
		
		Позиция = Позиция + 1;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Строка = ПрочитатьСтроку(Байты, Позиция, Размер);
		РасширенныеСвойства.Вставить("СКЗИ_УЦ", Строка);

		
		Позиция = Позиция + 1;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Строка = ПрочитатьСтроку(Байты, Позиция, Размер);
		РасширенныеСвойства.Вставить("Заключение", Строка);
		
		Позиция = Позиция + 1;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING
		Строка = ПрочитатьСтроку(Байты, Позиция, Размер);
		РасширенныеСвойства.Вставить("ЗаключениеУЦ", Строка);
	КонецЕсли;
	
	РасширенныеСвойства.Вставить("КлассУЦ", "КС2");

	
	Сигнатура = Новый Массив; // Ищем 1.2.643.2.2.3
	Сигнатура.Добавить(6);
	Сигнатура.Добавить(6);
	Сигнатура.Добавить(42);
	Сигнатура.Добавить(133);
	Сигнатура.Добавить(3);
	Сигнатура.Добавить(2);
	Сигнатура.Добавить(2);
	Сигнатура.Добавить(3);
	
	НачалоСигнатуры = НайтиСигнатуру(Байты, Сигнатура, Позиция);
	
	Если НачалоСигнатуры = -1 Тогда
		Сигнатура = Новый Массив; // Ищем 1.2.643.7.1.1.3.2 (ГОСТ Р 34.10-2012 с ключом 256 бит)
		Сигнатура.Добавить(6);
		Сигнатура.Добавить(8);
		Сигнатура.Добавить(42);
		Сигнатура.Добавить(133);
		Сигнатура.Добавить(3);
		Сигнатура.Добавить(7);
		Сигнатура.Добавить(1);
		Сигнатура.Добавить(1);
		Сигнатура.Добавить(3);
		Сигнатура.Добавить(2);
		
		НачалоСигнатуры = НайтиСигнатуру(Байты, Сигнатура, Позиция);
		
		Если НачалоСигнатуры = -1 Тогда
			Сигнатура = Новый Массив; // Ищем 1.2.643.7.1.1.3.3 (ГОСТ Р 34.10-2012 с ключом 512 бит)
			Сигнатура.Добавить(6);
			Сигнатура.Добавить(8);
			Сигнатура.Добавить(42);
			Сигнатура.Добавить(133);
			Сигнатура.Добавить(3);
			Сигнатура.Добавить(7);
			Сигнатура.Добавить(1);
			Сигнатура.Добавить(1);
			Сигнатура.Добавить(3);
			Сигнатура.Добавить(3);
			
			НачалоСигнатуры = НайтиСигнатуру(Байты, Сигнатура, Позиция);
		КонецЕсли;
	КонецЕсли;
	
	Если НачалоСигнатуры <> -1 Тогда
		Позиция = НачалоСигнатуры + Сигнатура.Количество();
		Пока Байты[Позиция] <> 3 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Размер = ПрочитатьРазмер(Байты, Позиция); // OCTET STRING	
		Позиция = Позиция + 1; // сдвиг сразу к BIT STRING
		
		Подпись = Новый Массив;
		Для Индекс = 1 По Размер - 1 Цикл
			Позиция = Позиция + 1;
			Байт = Байты[Позиция];
			Подпись.Вставить(0, Байт);
		КонецЦикла;
		
		ИмяФайла = ПолучитьИмяВременногоФайла();
		ЗаписатьФайлИзМассива(ИмяФайла, Подпись);
		
		Подпись = Новый ДвоичныеДанные(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
	Алгоритм = КриптографияЭДКО.АлгоритмКриптосообщенияИлиСертификата(
		Сертификат,
		Истина,
		Ложь);
	ИмяАлгоритма = КриптографияЭДКОКлиентСервер.СвойстваАлгоритма(Алгоритм).Имя;
	
	РасширенныеСвойства.Вставить("Алгоритм", ИмяАлгоритма);
	РасширенныеСвойства.Вставить("Класс", "Класс средства ЭП КС1;Класс средства ЭП КС2;");
	РасширенныеСвойства.Вставить("ОбластьИспользования", "Цифровая подпись, Неотрекаемость, Шифрование ключей, Шифрование данных");
	РасширенныеСвойства.Вставить("Подпись", Подпись);
	
	Возврат РасширенныеСвойства;
	
КонецФункции

Функция ПрочитатьРазмер(Байты, Позиция)
	
	Позиция = Позиция + 1;
	Байт = Байты[Позиция];
	БитоваяСтрока = ЧислоВСтрокуБитов(Байт);
	Если Сред(БитоваяСтрока, 1, 1) = "1" Тогда
		КоличествоБайт = СтрокаБитовВЧисло(Прав(БитоваяСтрока, 7));
		Размер = ПрочитатьЦелоеЧисло(Байты, Позиция, КоличествоБайт);
	Иначе
		Размер = Байт;		
	КонецЕсли;
	
	Возврат Размер;
	
КонецФункции

Функция ПрочитатьЦелоеЧисло(Байты, Позиция, КоличествоБайт)
	
	БитоваяСтрокаДлиныБлока = "";
	Для Индекс = 1 По КоличествоБайт Цикл
		Позиция = Позиция + 1;
		Байт = Байты[Позиция];
		БитоваяСтрокаДлиныБлока = БитоваяСтрокаДлиныБлока + ЧислоВСтрокуБитов(Байт);
	КонецЦикла;
	
	Возврат СтрокаБитовВЧисло(БитоваяСтрокаДлиныБлока);
	
КонецФункции

Функция ПрочитатьСтроку(Байты, Позиция, КоличествоБайт)
	
	БайтыДляЗаписи = Новый Массив;
	Для Индекс = 1 По КоличествоБайт Цикл
		Позиция = Позиция + 1;
		Байт = Байты[Позиция];
		БайтыДляЗаписи.Добавить(Байт);
	КонецЦикла;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("txt");
	ЗаписатьФайлИзМассива(ИмяФайла, БайтыДляЗаписи);
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, "utf-8");
	Строка = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ИмяФайла);
	
	Возврат Строка;
	
КонецФункции

// Переводит заданное десятичное число в соответствующую строку битов.
//
// Параметры:
// ИсходноеЧисло - Число - 10-тичное.
//
// Возвращаемое значение:
// Строка - последовательность битов, соответствующая заданному числу.
//
Функция ЧислоВСтрокуБитов(Знач ИсходноеЧисло) Экспорт

	ИсходноеЧисло = Цел(?(ИсходноеЧисло < 0, - ИсходноеЧисло, ИсходноеЧисло));
	Если ИсходноеЧисло = 0 Тогда
		Возврат "00000000";
	КонецЕсли;
	
	СтрокаБитов = "";
	
	Пока ИсходноеЧисло > 0 Цикл
		ЗначениеМладшегоБита = ИсходноеЧисло % 2;
		СтрокаБитов = Строка(ЗначениеМладшегоБита) + СтрокаБитов;
		ИсходноеЧисло = (ИсходноеЧисло - ЗначениеМладшегоБита) / 2;
	КонецЦикла;
	
	Префикс = "";
	Для Индекс = 1 По 8 - СтрДлина(СтрокаБитов) Цикл
		Префикс = Префикс + "0";
	КонецЦикла;
	
    Возврат Префикс + СтрокаБитов;
	
КонецФункции

// Переводит строку битов в соответствующее десятичное число.
//
// Параметры:
// СтрокаБитов - Строка.
//
// Возвращаемое значение:
// Число.
//
Функция СтрокаБитовВЧисло(Знач СтрокаБитов) Экспорт

	СтрокаБитов = СокрЛП(СтрокаБитов);
	ДлинаСтроки = СтрДлина(СтрокаБитов);
	Если ДлинаСтроки = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(СтрокаБитов, "01") Тогда
		ВызватьИсключение(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '""%1"" не является последовательностью битов';
																						|en = '""%1"" is not a bit sequence'"), СтрокаБитов));
	КонецЕсли;	
	
	Число = 0;
	
	Для Индекс = 1 По ДлинаСтроки Цикл
		СимволЦифры = Сред(СтрокаБитов, Индекс, 1);
		Число = Число * 2 + Число(СимволЦифры)
	КонецЦикла;
	
    Возврат Число;
	
КонецФункции

Функция СтрокаСодержитТолькоДопустимыеСимволы(Знач ИсходнаяСтрока, Знач ДопустимыеСимволы)
	
	ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
	Если ДлинаСтроки = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	
	
   	Для Индекс = 1 По ДлинаСтроки Цикл 
    	ТекущийСимвол = Сред(ИсходнаяСтрока, Индекс, 1); 
	   	Если Найти(ДопустимыеСимволы, ТекущийСимвол) = 0 Тогда
		    Возврат Ложь;
	    КонецЕсли;
	КонецЦикла; 
	
   	Возврат Истина;
	
КонецФункции

Функция ПолучитьОтпечаток(УчетнаяЗапись, ТипСертификата, Объект) Экспорт
	
	Отпечаток = "";
	
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток");
	
	Если ТипСертификата = "Руководитель" И Сертификат.Найден Тогда
		
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
		
	ИначеЕсли ТипСертификата = "Главный бухгалтер" И Сертификат.Найден Тогда
		
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
		
	ИначеЕсли ТипСертификата = "Шифрование" И Сертификат.Найден Тогда
		
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
		
	ИначеЕсли ТипСертификата = "Сервер документооборота" Тогда
		
		Отпечаток = СокрЛП(Объект.Сертификат);
		
	ИначеЕсли ТипСертификата = "Орган ПФР" ИЛИ ТипСертификата = "Налоговый орган" ИЛИ ТипСертификата = "Орган ФСГС" Тогда
		
		Отпечаток = Объект.Сертификаты.ВыгрузитьКолонку("Сертификат");
		
	КонецЕсли;
	Возврат Отпечаток;
	
КонецФункции

Функция ПолучитьСертификатСубъекта(Объект, ТипСертификата = Неопределено, ОрганизацияСсылка = Неопределено) Экспорт
	
	ТипОбъекта = ТипЗнч(Объект);
	
	ЭтоУчетка = ТипОбъекта = Тип("СправочникСсылка.УчетныеЗаписиДокументооборота");
	Если ЭтоУчетка Тогда
		Сертификат = Мультирежим.СертификатПользователя(Объект, "Отпечаток");
	КонецЕсли;
	
	Отпечаток = "";
	Если ТипСертификата = "Руководитель" И ЭтоУчетка И Сертификат.Найден Тогда
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
	ИначеЕсли ТипСертификата = "Главный бухгалтер" И ЭтоУчетка И Сертификат.Найден Тогда
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
	ИначеЕсли ТипСертификата = "Шифрование" И ЭтоУчетка И Сертификат.Найден Тогда
		Отпечаток = СокрЛП(Сертификат.Отпечаток);
	Иначе
		Если ТипОбъекта = Тип("СправочникСсылка.СерверыДокументооборота") Тогда
			Отпечаток = СокрЛП(Объект.Сертификат);
		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.НалоговыеОрганы") Тогда
			Отпечаток = Объект.Сертификаты.ВыгрузитьКолонку("Сертификат");
		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ОрганыПФР") Тогда
			Если ТипСертификата = "ЕЦП" Тогда
				Отпечаток = Объект.СертификатыЕЦП.ВыгрузитьКолонку("Сертификат");
				Если Отпечаток.Количество() = 0 И ТекущаяДатаСеанса() < '20251012153100' Тогда
					Отпечаток = ДокументооборотСКОВызовСервера.СертификатШифрованияЕЦП(, Истина).Отпечаток;
					Отпечаток = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отпечаток);
				КонецЕсли;
			ИначеЕсли ТипСертификата = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
				Отпечаток = Объект.СертификатыЭДОК.ВыгрузитьКолонку("Сертификат");
			Иначе
				Отпечаток = Объект.Сертификаты.ВыгрузитьКолонку("Сертификат");
				// возможны письма из других (неподключенных) органов ПФР региона, с тем же сертификатом шифрования
				Если ТипЗнч(ОрганизацияСсылка) = Тип("СправочникСсылка.Организации")
					И (Отпечаток = Неопределено ИЛИ Отпечаток.Количество() = 0) Тогда
					КодОрганаПФРДонораСертификата = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
						ОрганизацияСсылка,, "КодОрганаПФР").КодОрганаПФР;
					Если Объект.Код <> КодОрганаПФРДонораСертификата Тогда
						РезультатПоиска = Справочники.ОрганыПФР.НайтиПоКоду(КодОрганаПФРДонораСертификата);
						Если ЗначениеЗаполнено(РезультатПоиска) Тогда
							Отпечаток = РезультатПоиска.Сертификаты.ВыгрузитьКолонку("Сертификат");
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ОрганыФСГС") Тогда
			Отпечаток = Объект.Сертификаты.ВыгрузитьКолонку("Сертификат");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Отпечаток;
	
КонецФункции

Функция ПроверитьСертификатПоПериоду(ОбъектСертификат, ПогрешностьДат = 86400) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбъектСертификат) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекДата = ТекущаяДатаСеанса();
	Если Дата(ОбъектСертификат.ДействителенС - ПогрешностьДат) > ТекДата Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Период действия сертификата %1 еще не наступил!';
				|en = 'Certificate %1 is not valid yet.'"), Символ(34) + ПредставлениеСертификатаПоСвойствам(ОбъектСертификат) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат Ложь;
	ИначеЕсли Дата(ОбъектСертификат.ДействителенПо + ПогрешностьДат) < ТекДата Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Период действия сертификата %1 истек!';
				|en = 'Certificate %1 expired.'"), Символ(34) + ПредставлениеСертификатаПоСвойствам(ОбъектСертификат) + Символ(34));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПредставлениеСертификатаПоСвойствам(СвойстваСертификата) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СвойстваСертификата) Тогда
		Возврат "<отсутствует>";
	КонецЕсли;
	
	Если ТипЗнч(СвойстваСертификата) = Тип("ДанныеФормыКоллекция") ИЛИ ТипЗнч(СвойстваСертификата) = Тип("Массив") Тогда
		Возврат Формат(СвойстваСертификата.Количество(), "ЧН=") + " сертификатов";
	КонецЕсли;
	
	Наименование = "";
	Владелец = "";
	ДействителенС = "";
	ДействителенПо = "";
	Отпечаток = "";
	
	СвойстваСертификата.Свойство("Наименование", Наименование);
	СвойстваСертификата.Свойство("ИмяВладельца", Владелец);
	СвойстваСертификата.Свойство("ДействителенС", ДействителенС);
	СвойстваСертификата.Свойство("ДействителенПо", ДействителенПо);
	СвойстваСертификата.Свойство("Отпечаток", Отпечаток);
	
	ПредставлениеСертификата = "";
	Если ЗначениеЗаполнено(Наименование) Тогда
		ПредставлениеСертификата = СокрЛП(Наименование);
	ИначеЕсли ЗначениеЗаполнено(Владелец) Тогда
		ПредставлениеСертификата = СокрЛП(Владелец);
	Иначе
		ПредставлениеСертификата = СокрЛП(Отпечаток);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДействителенС) И ЗначениеЗаполнено(ДействителенПо) Тогда
		Если НЕ ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ЭтоФайрФоксХромИлиСафари() Тогда
		ПредставлениеСертификата = ПредставлениеСертификата + " (" + Формат(ДействителенС, "ДФ='dd.MM.yyyy HH:mm'") + " - " + Формат(ДействителенПо, "ДФ='dd.MM.yyyy HH:mm'") + ")";
		Иначе
			ПредставлениеСертификата = ПредставлениеСертификата + " (" + Строка(ДействителенС) + " - " + Строка(ДействителенПо) + ")";
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПредставлениеСертификата;
	
КонецФункции

Функция ПолучитьОтпечатокСертификатаПолучателя(ТранспортноеСообщениеСсылка) Экспорт
	
	УчетнаяЗапись = ТранспортноеСообщениеСсылка.УчетнаяЗапись;
	
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись, "Отпечаток");

	СертификатПолучателя = Новый Структура;
	СертификатПолучателя.Вставить("Отпечаток", Сертификат.Отпечаток);
	СертификатПолучателя.Вставить("КлючевойКонтейнер", УчетнаяЗапись.ИдентификаторДокументооборота);
	
	КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(УчетнаяЗапись, СертификатПолучателя);
	
	Возврат СертификатПолучателя;

КонецФункции

Функция ПолучитьСвойстваСертификатовПоОтпечаткамНаСервере(Отпечатки, ЛогическоеХранилище = Неопределено, ВыполнятьПроверку = Ложь)
	
	Сертификаты = Новый Массив;
	Для Каждого Отпечаток Из Отпечатки Цикл 
		Сертификаты.Добавить(КриптографияЭДКО.НайтиСертификат(Новый Структура("Отпечаток", Отпечаток), ВыполнятьПроверку));
	КонецЦикла;
	
	Возврат Сертификаты;
	
