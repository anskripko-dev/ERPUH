КонецПроцедуры

Функция УведомлениеОПредоставленииПолномочийПредставителю_ИмяФайла(Уведомление)
	
	//Структура имени файла, должна быть следующей:
	//ПФР_[рег.номер]_[код ТО ПФР]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код ТО ПФР] - код территориального органа ПФР, принимающего/направляющего сведения, содержащиеся в файле (указывается согласно классификатору территориальных органов ПФР);
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	//
	//Альтернативный вариант при регистрационном номере СФР из 10 цифр:
	//ПФР_[рег.номер]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	
	СтраховательЮЛ = ПредопределенноеЗначение("Перечисление.СубъектыДоверенностиСтрахователя.СтраховательЮЛ");
	РеквизитыСтрахователя = Уведомление.Ссылка.РеквизитыСубъектов.НайтиСтроки(Новый Структура("Владелец", СтраховательЮЛ));
	Если НЕ ЗначениеЗаполнено(РеквизитыСтрахователя) Тогда
		СтраховательФЛ = ПредопределенноеЗначение("Перечисление.СубъектыДоверенностиСтрахователя.СтраховательФЛ");
		РеквизитыСтрахователя = Уведомление.Ссылка.РеквизитыСубъектов.НайтиСтроки(Новый Структура("Владелец", СтраховательФЛ));
		Если ЗначениеЗаполнено(РеквизитыСтрахователя) Тогда
			РегистрационныйНомерПФР = РеквизитыСтрахователя[0].РегистрационныйНомерПФР;
		КонецЕсли;
	Иначе
		РегистрационныйНомерПФР = РеквизитыСтрахователя[0].РегистрационныйНомерПФР;
	КонецЕсли;

	РегНомер = СокрЛП(РегистрационныйНомерПФР);
	КодТОПФР = СтрЗаменить(СокрЛП(Уведомление.Получатель.Код), "-", "");
	КодДокумента = "УПУП"; 
	ДатаФормированияФайла = Формат(ТекущаяДатаСеанса(), "ДФ=ггггММдд");
	
	GUID = Уведомление.УникальныйИдентификатор;
	
	ИмяФайла = "ПФР_%1%2_%3_%4_%5.xml";
	ИмяФайла = СтрШаблон(
		ИмяФайла,
		РегНомер,
		?(СтрДлина(РегНомер) = 10, "", "_" + КодТОПФР),
		КодДокумента,
		ДатаФормированияФайла,
		GUID);
		
	Возврат ИмяФайла;
	
КонецФункции

Процедура УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьАтрибутыКорня_АФ245д(ЗаписьXML, Заявление)
	
	ЗаписьXML.ЗаписатьАтрибут("xmlns", "http://пф.рф/УПУП/2020-02-03");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:УТ2", "http://пф.рф/УТ/2017-08-21");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:ЭДО", "http://пф.рф/ВС/ЭДО/типы/2019-09-27");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:АФ5", "http://пф.рф/АФ/2018-12-07");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:АФ4", "http://пф.рф/АФ/2017-08-21");
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_СлужебнаяИнформация(ЗаписьXML, Уведомление) 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СлужебнаяИнформация");
	
	Если ДействуетФорматАФ245д() Тогда
		ДатаСеанса = ТекущаяДатаСеанса();
		СтрокаДатыСеанса = ДокументооборотСКОВызовСервера.ДатаСЧасовымПоясом(ДатаСеанса);
		
		ЗаписатьУзелXML(ЗаписьXML, "АФ5:GUID", Уведомление.УникальныйИдентификатор);
		ЗаписатьУзелXML(ЗаписьXML, "АФ5:ДатаВремя", СтрокаДатыСеанса);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Уведомление, ТипПредставителя)
	
	Телефон = ЭлектронныйДокументооборотСКонтролирующимиОрганамиКлиентСервер.ТелефонМобильныйБезРазделителей(Уведомление[ТипПредставителя + "_Телефон"]);
	
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Телефон", СокрЛП(Телефон), Истина);
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:АдресЭлПочты", СокрЛП(Уведомление[ТипПредставителя + "_АдресЭлПочты"]), Истина);
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_ФИО(ЗаписьXML, ФИО)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("УТ2:ФИО");
	
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Фамилия", СокрЛП(ФИО.Фамилия));
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Имя", СокрЛП(ФИО.Имя));
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Отчество", СокрЛП(ФИО.Отчество), Истина);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_Страхователь(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Страхователь");
	
	ТипПредставителя = "";
	
	Если ЭтоЮридическоеЛицо Тогда
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ЮЛ");
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Уведомление.СтраховательЮЛ_РегистрационныйНомерПФР));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:Наименование", СокрЛП(Уведомление.СтраховательЮЛ_Наименование));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:НаименованиеКраткое", СокрЛП(Уведомление.СтраховательЮЛ_НаименованиеКраткое));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Уведомление.СтраховательЮЛ_ИНН));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:КПП", СокрЛП(Уведомление.СтраховательЮЛ_КПП));
		ТипПредставителя = "СтраховательЮЛ";
		
	Иначе
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ИП");
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Уведомление.СтраховательФЛ_РегистрационныйНомерПФР));
		ФИО = Новый Структура("Фамилия, Имя, Отчество", 
			СокрЛП(Уведомление.СтраховательФЛ_Фамилия),
			СокрЛП(Уведомление.СтраховательФЛ_Имя),
			СокрЛП(Уведомление.СтраховательФЛ_Отчество));
		УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_ФИО(ЗаписьXML, ФИО);
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:СНИЛС", СокрЛП(Уведомление.СтраховательФЛ_СНИЛС));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Уведомление.СтраховательФЛ_ИНН));
		ТипПредставителя = "СтраховательФЛ";
		
	КонецЕсли;
	
	УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Уведомление, ТипПредставителя);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ЮЛ или ИП
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Страхователь
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_Представитель(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("УполномоченныйПредставитель");
	
	ТипПредставителя = "";
	
	Если Уведомление.ПредставительСотрудник
		ИЛИ (НЕ Уведомление.ПредставительСотрудник И Уведомление.ПредставительФизическоеЛицо) Тогда
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПредставительФизЛицо");
		КонецЕсли;
		
		ФИО = Новый Структура("Фамилия, Имя, Отчество", 
			СокрЛП(Уведомление.СотрудникПредставителя_Фамилия),
			СокрЛП(Уведомление.СотрудникПредставителя_Имя),
			СокрЛП(Уведомление.СотрудникПредставителя_Отчество));
		УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_ФИО(ЗаписьXML, ФИО);
		
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:СНИЛС", СокрЛП(Уведомление.СотрудникПредставителя_СНИЛС));
		ЗаписатьУзелXML(ЗаписьXML, "Должность", СокрЛП(Уведомление.СотрудникПредставителя_Должность), Истина);
		
		ТипПредставителя = "СотрудникПредставителя";
		УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Уведомление, ТипПредставителя);
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
		
	Если ЭтоЮридическоеЛицо Тогда
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПредставительЮЛ");
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Уведомление.ПредставительЮЛ_РегистрационныйНомерПФР));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:Наименование", СокрЛП(Уведомление.ПредставительЮЛ_Наименование));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:НаименованиеКраткое", СокрЛП(Уведомление.ПредставительЮЛ_НаименованиеКраткое));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Уведомление.ПредставительЮЛ_ИНН));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:КПП", СокрЛП(Уведомление.ПредставительЮЛ_КПП));
		ТипПредставителя = "ПредставительЮЛ";
		
		УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Уведомление, ТипПредставителя);
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	ИначеЕсли НЕ Уведомление.ПредставительФизическоеЛицо Тогда
		
		Если ДействуетФорматАФ245д() Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПредставительИП");
		КонецЕсли;
		
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:РегНомер", СокрЛП(Уведомление.ПредставительФЛ_РегистрационныйНомерПФР));
		ФИО = Новый Структура("Фамилия, Имя, Отчество",
			СокрЛП(Уведомление.ПредставительФЛ_Фамилия),
			СокрЛП(Уведомление.ПредставительФЛ_Имя),
			СокрЛП(Уведомление.ПредставительФЛ_Отчество));
		УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_ФИО(ЗаписьXML, ФИО);
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:СНИЛС", СокрЛП(Уведомление.ПредставительФЛ_СНИЛС));
		ЗаписатьУзелXML(ЗаписьXML, "УТ2:ИНН", СокрЛП(Уведомление.ПредставительФЛ_ИНН));
		ТипПредставителя = "ПредставительФЛ";
		
		УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьУзелXML_КонтактнаяИнформация(ЗаписьXML, Уведомление, ТипПредставителя);
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // УполномоченныйПредставитель
	
КонецПроцедуры

Процедура УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_СтраховательСотрудник(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ПредставительСотрудник");
	
	ФИО = Новый Структура("Фамилия, Имя, Отчество", 
		СокрЛП(Уведомление.СотрудникСтрахователя_Фамилия),
		СокрЛП(Уведомление.СотрудникСтрахователя_Имя),
		СокрЛП(Уведомление.СотрудникСтрахователя_Отчество));
	УведомлениеОПредоставленииПолномочийПредставителю_ЗаписатьУзелXML_ФИО(ЗаписьXML, ФИО);
	ЗаписатьУзелXML(ЗаписьXML, "УТ2:Должность", СокрЛП(Уведомление.СотрудникСтрахователя_Должность));
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ПредставительСотрудник
	
КонецПроцедуры

Функция УведомлениеОПрекращенииПолномочийПредставителя_ИмяФайла(Уведомление)
	
	//Структура имени файла, должна быть следующей:
	//ПФР_[рег.номер]_[код ТО ПФР]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код ТО ПФР] - код территориального органа ПФР, принимающего/направляющего сведения, содержащиеся в файле (указывается согласно классификатору территориальных органов ПФР);
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	//
	//Альтернативный вариант при регистрационном номере СФР из 10 цифр:
	//ПФР_[рег.номер]_[код документа]_[дата формирования файла]_[GUID].xml
	//где:
	//•	[рег.номер] - номер под которым организация зарегистрирована как плательщик страховых взносов, с указанием кодов региона и района по классификации, принятой в ПФР;
	//•	[код документа] – код формы документов, содержащихся в файле;
	//•	[дата формирования файла] – дата в формате ГГГГММДД;
	//•	[GUID] – глобальный уникальный идентификатор, обеспечивающий уникальность электронного документа. Значение GUID должно быть идентично значению GUID документа, содержащегося в файле. Реализация спецификации стандарта http://www.ietf.org/rfc/rfc4122.txt.
	
	СтраховательЮЛ = ПредопределенноеЗначение("Перечисление.СубъектыДоверенностиСтрахователя.СтраховательЮЛ");
	РеквизитыСтрахователя = Уведомление.Ссылка.РеквизитыСубъектов.НайтиСтроки(Новый Структура("Владелец", СтраховательЮЛ));
	Если НЕ ЗначениеЗаполнено(РеквизитыСтрахователя) Тогда
		СтраховательФЛ = ПредопределенноеЗначение("Перечисление.СубъектыДоверенностиСтрахователя.СтраховательФЛ");
		РеквизитыСтрахователя = Уведомление.Ссылка.РеквизитыСубъектов.НайтиСтроки(Новый Структура("Владелец", СтраховательФЛ));
		Если ЗначениеЗаполнено(РеквизитыСтрахователя) Тогда
			РегистрационныйНомерПФР = РеквизитыСтрахователя[0].РегистрационныйНомерПФР;
		КонецЕсли;
	Иначе
		РегистрационныйНомерПФР = РеквизитыСтрахователя[0].РегистрационныйНомерПФР;
	КонецЕсли;

	РегНомер = СокрЛП(РегистрационныйНомерПФР);
	КодТОПФР = СтрЗаменить(СокрЛП(Уведомление.Получатель.Код), "-", "");
	КодДокумента = "УПРУП"; 
	ДатаФормированияФайла = Формат(ТекущаяДатаСеанса(), "ДФ=ггггММдд");
	
	GUID = Уведомление.УникальныйИдентификатор;
	
	ИмяФайла = "ПФР_%1%2_%3_%4_%5.xml";
	ИмяФайла = СтрШаблон(
		ИмяФайла,
		РегНомер,
		?(СтрДлина(РегНомер) = 10, "", "_" + КодТОПФР),
		КодДокумента,
		ДатаФормированияФайла,
		GUID);
	
	Возврат ИмяФайла;
	
КонецФункции

