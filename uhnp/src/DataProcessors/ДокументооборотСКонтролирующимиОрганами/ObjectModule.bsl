	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаВыгрузки);
	
	// 
	Возврат КНДФормы;
	
КонецФункции

Процедура ДобавитьДополнительныеСведенияДляОписания(Сведения, Сообщение, КППДляПоиска = "")
	
	Если ЗначениеЗаполнено(Сообщение.УчетнаяЗапись)
		И Сообщение.УчетнаяЗапись.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.Такском Тогда
		
		ЦиклОбмена = Сообщение.ЦиклОбмена;
		ВидДокументаПредставление = ?(ЗначениеЗаполнено(ЦиклОбмена.ВидДокумента), "корректирующий", "первичный");
		
		ОрганизацияСсылка 		= ЦиклОбмена.Организация;
		НаименованиеОрганизации = "";
		ИННОрганизации 			= "";
		КППОрганизации 			= "";
		Если РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(ОрганизацияСсылка) Тогда
			ДанныеОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
				ОрганизацияСсылка,, "НаимЮЛПол, ИННЮЛ, КППЮЛ");
			НаименованиеОрганизации = ДанныеОрганизации.НаимЮЛПол;
			ИННОрганизации 			= ДанныеОрганизации.ИННЮЛ;
			КППОрганизации 			= ДанныеОрганизации.КППЮЛ;
		Иначе
			ДанныеОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
				ОрганизацияСсылка,, "ФИО, ИННФЛ");
			НаименованиеОрганизации = ДанныеОрганизации.ФИО;
			ИННОрганизации 			= ДанныеОрганизации.ИННФЛ;
			КППОрганизации 			= "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КППДляПоиска) Тогда
			КППОрганизации = КППДляПоиска;
			
		ИначеЕсли ТипЗнч(ЦиклОбмена.ВнешняяОрганизация) = Тип("СправочникСсылка.НалоговыеОрганы")
			И ЗначениеЗаполнено(ЦиклОбмена.ВнешняяОрганизация.Код) Тогда
			
			ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(
				ОрганизацияСсылка,
				ЦиклОбмена.ВнешняяОрганизация.Код);
			Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
				КППОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлРегистрацияВИФНС, "КПП");
			КонецЕсли;
		КонецЕсли;
		
		Сведения.Вставить("ВидДокументаПредставление", 	ВидДокументаПредставление);
		Сведения.Вставить("НаименованиеОрганизации", 	НаименованиеОрганизации);
		Сведения.Вставить("ИННОрганизации", 			ИННОрганизации);
		Сведения.Вставить("КППОрганизации", 			КППОрганизации);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьСтруктуруПараметровФайлаВыгрузкиДляОписанияСведений(ФайлВыгрузки, ОстановитьПоискЕслиНайденКНД = Ложь)

	ПоказателиВыгрузки = Новый Соответствие;
	ОбъектЧтениеXML = Новый ЧтениеXML;
	Попытка
		ОбъектЧтениеXML.ОткрытьФайл(ФайлВыгрузки);
		ОбъектЧтениеXML.ИгнорироватьПробелы = Ложь;
		Пока ОбъектЧтениеXML.Прочитать() Цикл
			Если ОбъектЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Пока ОбъектЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ПоказателиВыгрузки[ОбъектЧтениеXML.Имя] = Неопределено Тогда
						ПоказателиВыгрузки.Вставить(ОбъектЧтениеXML.Имя, ОбъектЧтениеXML.Значение);
						Если ОбъектЧтениеXML.Имя = "КНД" И ОстановитьПоискЕслиНайденКНД Тогда
							ПоказателиВыгрузки.Вставить("ЭтоXML", Истина);
							Возврат ПоказателиВыгрузки;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	
		ОбъектЧтениеXML.Закрыть();
		ПоказателиВыгрузки.Вставить("ЭтоXML", Истина);
	Исключение
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(ФайлВыгрузки, "cp866");
		ТекСтр = Текст.ПрочитатьСтроку();
		Пока ТекСтр <> Неопределено Цикл
			ТекСтр = СокрЛП(ТекСтр);
			ВхождениеДвоеточия = СтрНайти(ТекСтр, ":");
			ИмяПоказателя = СокрЛП(Лев(ТекСтр, ВхождениеДвоеточия - 1));
			ЗначениеПоказателя = СокрЛП(Сред(ТекСтр, ВхождениеДвоеточия + 1));
			Если ВхождениеДвоеточия <> 0 Тогда
				Если ПоказателиВыгрузки[ИмяПоказателя] = Неопределено Тогда
					ПоказателиВыгрузки.Вставить(ИмяПоказателя, ЗначениеПоказателя);
				КонецЕсли;
			КонецЕсли;
			ТекСтр = Текст.ПрочитатьСтроку();
		КонецЦикла;
		Текст.Закрыть();
		ПоказателиВыгрузки.Вставить("ЭтоXML", Ложь);
	КонецПопытки;
	Возврат ПоказателиВыгрузки;

КонецФункции

Функция СформироватьСтруктуруПараметровФайлаЗапросаДляОписанияСведений(ФайлВыгрузки)

	ПоказателиВыгрузки = Новый Соответствие;
	ОбъектЧтениеXML = Новый ЧтениеXML;
	ОбъектЧтениеXML.ОткрытьФайл(ФайлВыгрузки);
	ОбъектЧтениеXML.ИгнорироватьПробелы = Ложь;
	Пока ОбъектЧтениеXML.Прочитать() Цикл
		Если ОбъектЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Пока ОбъектЧтениеXML.ПрочитатьАтрибут() Цикл
				Если ПоказателиВыгрузки[ОбъектЧтениеXML.Имя] = Неопределено Тогда
					ПоказателиВыгрузки.Вставить(ОбъектЧтениеXML.Имя, ОбъектЧтениеXML.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ОбъектЧтениеXML.Закрыть();
	Возврат ПоказателиВыгрузки;

КонецФункции

Функция СформироватьОписаниеСведений2НДФЛ(
		Сообщение,
		Вложения,
		КороткоеИмяФайла = Неопределено,
		КППДляПоиска = "")
	
	// извлекаем ключевые параметры
	КлючевыеПараметрыФайлаВыгрузки = ОпределитьКлючевыеПараметрыФайлаВыгрузки2НДФЛ(
		Сообщение,
		Вложения,
		КППДляПоиска);
	Если НЕ ЗначениеЗаполнено(КлючевыеПараметрыФайлаВыгрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	ДобавитьУзелXML(Дерево, "имяФормы", , "2-НДФЛ");
	ДобавитьУзелXML(Дерево, "КНДФормы", , "1151078");
	Если КлючевыеПараметрыФайлаВыгрузки.Свойство("ВидДокументаПредставление") Тогда // только для Такскома
		ДобавитьУзелXML(Дерево, "видДокумента", , КлючевыеПараметрыФайлаВыгрузки["ВидДокументаПредставление"]);
	КонецЕсли;
	ДобавитьУзелXML(Дерево, "год", , Формат(Год(Сообщение.ЦиклОбмена.ДатаНачалаПериода), "ЧГ="));
	ДобавитьУзелXML(Дерево, "НОПоМестуУчета", , 		КлючевыеПараметрыФайлаВыгрузки["НОПоМестуУчета"]);
	ДобавитьУзелXML(Дерево, "НОПоМестуНахождения", , 	КлючевыеПараметрыФайлаВыгрузки["НОПоМестуНахождения"]);
	
	Если КлючевыеПараметрыФайлаВыгрузки.Свойство("ВидДокументаПредставление") Тогда // только для Такскома
		УзелДопСв = ДобавитьУзелXML(Дерево, "ДопСв");
		УзелСвНП = ДобавитьУзелXML(УзелДопСв, "СвНП");
		ДобавитьУзелXML(УзелСвНП, "ИНН", Истина, КлючевыеПараметрыФайлаВыгрузки["ИННОрганизации"]);
		Если ЗначениеЗаполнено(КлючевыеПараметрыФайлаВыгрузки["КППОрганизации"]) Тогда
			ДобавитьУзелXML(УзелСвНП, "КПП", Истина, КлючевыеПараметрыФайлаВыгрузки["КППОрганизации"]);
		КонецЕсли;
		ДобавитьУзелXML(УзелСвНП, "Наименование", Истина, КлючевыеПараметрыФайлаВыгрузки["НаименованиеОрганизации"]);
	КонецЕсли;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описание");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
КонецФункции

Функция СформироватьОписаниеСведенийОбращенияПисьмаРассылки(
		Сообщение,
		Вложения,
		КороткоеИмяФайла,
		КППДляПоиска = "")
	
	Предмет = Сообщение.ЦиклОбмена.Предмет;
	
	// создаем дерево описания XML
	Дерево = СоздатьДеревоXML();
	
	Если ЗначениеЗаполнено(Предмет.ИдентификаторОснования) Тогда
		ДобавитьУзелXML(Дерево, "ответНа", , Предмет.ИдентификаторОснования);
	КонецЕсли;
	
	ДобавитьУзелXML(Дерево, "тема", , СокрЛП(Предмет.Наименование));
	
	КлючевыеПараметрыФайлаВыгрузки = Новый Структура;
	ДобавитьДополнительныеСведенияДляОписания(КлючевыеПараметрыФайлаВыгрузки, Сообщение, КППДляПоиска);
	Если КлючевыеПараметрыФайлаВыгрузки.Свойство("ВидДокументаПредставление") Тогда // только для Такскома
		УзелДопСв = ДобавитьУзелXML(Дерево, "ДопСв");
		УзелСвНП = ДобавитьУзелXML(УзелДопСв, "СвНП");
		ДобавитьУзелXML(УзелСвНП, "ИНН", Истина, КлючевыеПараметрыФайлаВыгрузки["ИННОрганизации"]);
		Если ЗначениеЗаполнено(КлючевыеПараметрыФайлаВыгрузки["КППОрганизации"]) Тогда
			ДобавитьУзелXML(УзелСвНП, "КПП", Истина, КлючевыеПараметрыФайлаВыгрузки["КППОрганизации"]);
		КонецЕсли;
		ДобавитьУзелXML(УзелСвНП, "Наименование", Истина, КлючевыеПараметрыФайлаВыгрузки["НаименованиеОрганизации"]);
	КонецЕсли;
	
	// формируем строку XML на основе дерева
	СтрокаXML = ВыгрузитьДеревоВXML_ПФР(Дерево, "описание");
	
	// записываем строку в файл
	КороткоеИмяФайла = СгенерироватьИмяФайлаДокументаВСоставеПакета();
	ПолноеИмяФайлаДокументаВСоставеПакета = ПолучитьКаталогВременныхФайлов() + КороткоеИмяФайла;
	РезультатЗаписи = ЗаписатьXMLВФайл(СтрокаXML, ПолноеИмяФайлаДокументаВСоставеПакета);
	Если РезультатЗаписи = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолноеИмяФайлаДокументаВСоставеПакета;
	
