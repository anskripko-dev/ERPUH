Функция ЗначениеВКоллекцию(Значение) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Массив")
		И ТипЗнч(Значение) <> Тип("ТаблицаЗначений")
		И ТипЗнч(Значение) <> Тип("СписокXDTO") Тогда
		
		Коллекция = Новый Массив;
		Коллекция.Добавить(Значение);
		Возврат Коллекция;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Процедура УстановитьПризнакСтраховательПодписанНаУведомленияПоЭЛН(Организация, Значение) Экспорт
	
	Запись = РегистрыСведений.НастройкиОбменаФСС.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Пользователь = Справочники.Пользователи.ПустаяСсылка();
	Запись.Прочитать();
	Если Запись.СтраховательПодписанНаУведомленияПоЭЛН <> Значение Тогда
		Запись.Организация = Организация;
		Запись.Пользователь = Справочники.Пользователи.ПустаяСсылка();
		Запись.СтраховательПодписанНаУведомленияПоЭЛН = Значение;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция РазобратьРезультатПодпискиСтрахователя(Организация, Знач ДанныеСообщения) Экспорт
	
	//<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	//<subscriptionResponse responseOn="1bcd0ddb-120d-42c5-a17c-e32bf9895095"
	//xmlns="http://www.fss.ru/integration/types/eln/event/v01" xmlns:ns2="http://www.fss.ru/integration/types/common/v01">
	//	<result>
	//		<regNum>7700000003</regNum>
	//		<status>SUCCESS</status>
	//	</result>
	//</subscriptionResponse>
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ДанныеСообщения.ТекстСообщения);
	Данные = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Чтение.Закрыть();
	
	Если ЕстьСвойство(Данные, "responseOn") Тогда
		ИдентификаторИсходногоСообщения = Данные.responseOn;
	ИначеЕсли ЕстьСвойство(Данные, "uuid") Тогда
		ИдентификаторИсходногоСообщения = Данные.uuid;
	Иначе
		// Отсутствуют обязательные поля responseOn или uuid.
		Возврат Ложь;
	КонецЕсли;
	
	РезультатПоиска = ДанныеИсходящегоСообщенияСЭДОФСС(Организация, ИдентификаторИсходногоСообщения);
	
	Если НЕ РезультатПоиска.Выполнено Тогда
		// Исходное сообщение не найдено.
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеИсходногоСообщения = РезультатПоиска.ДанныеСообщения;
	РезультатОперации = Данные.result;
	Если РезультатОперации.status = СтатусУспехаСЭДО() Тогда
		// Обрабатываем только успешные изменения статуса подписки страхователя.
		Если ДанныеИсходногоСообщения.Тип =
			ТипСообщенийПодпискиСтрахователяНаОповещенияЭЛНСЭДО() Тогда
				УстановитьПризнакСтраховательПодписанНаУведомленияПоЭЛН(Организация, Истина);
		ИначеЕсли ДанныеИсходногоСообщения.Тип =
			ТипСообщенийОтпискиСтрахователяНаОповещенияЭЛНСЭДО() Тогда
				УстановитьПризнакСтраховательПодписанНаУведомленияПоЭЛН(Организация, Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьСвойство(Данные, Имя) Экспорт
	
