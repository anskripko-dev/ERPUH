			Запрос.УстановитьПараметр("ТипыСодержимогоТранспортногоКонтейнера", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ПодтверждениеПолученияПисьма);
			
			ПисьмоКвитанцияПФР = Новый Массив;
			ПисьмоКвитанцияПФР.Добавить(Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееКвитанцияПФР);
			ПисьмоКвитанцияПФР.Добавить(Перечисления.ТипыТранспортныхСообщений.ПисьмоВходящееКвитанцияПФР);
			
			Запрос.УстановитьПараметр("ПисьмоКвитанцияПФР", ПисьмоКвитанцияПФР);
				
			Запрос.УстановитьПараметр("ТипСодержимогоЭлектронноЦифроваяПодпись", Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ЭлектронноЦифроваяПодпись);
			Запрос.УстановитьПараметр("парамИстина", Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// компилируем запрос из подзапросов
	Для Инд = 0 По Подзапросы.Количество() - 1 Цикл
		ТекЗапрос = Подзапросы[Инд];
		Если Инд = 0 Тогда
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Сред(ТекЗапрос, 8);
		Иначе
			Запрос.Текст = Запрос.Текст + "
						  |
						  |ОБЪЕДИНИТЬ ВСЕ
						  |
						  |" + ТекЗапрос;
		КонецЕсли;
	КонецЦикла;
	
	// выполняем запрос, сохраняем файлы во временный каталог и формируем таблицу файлов
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Иначе
		ТаблицаЗапроса = Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаЗапроса;
	
КонецФункции

Функция ТипыИзвещенийОПолучении() Экспорт
	
	ТипСообщенияПодтверждениеОтправкиОтчетности = Новый Массив;
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеДекларацияНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбращениеНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПисьмоНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРассылкаНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗапросНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеФорма2НДФЛНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеЗаявлениеНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеДокументНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПредставлениеНО);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатПриемаНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеПодтверждениеНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиРФНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеОбОтзывеЗаявлениеРФНП);
	ТипСообщенияПодтверждениеОтправкиОтчетности.Добавить(Перечисления.ТипыТранспортныхСообщений.ИзвещениеРезультатОбработкиТСНП);

	Возврат ТипСообщенияПодтверждениеОтправкиОтчетности;
	
КонецФункции

Функция ПолучитьДатуОтправки(Объект, Знач КонтролирующийОрган = "ФНС") Экспорт
	
	НеПолучатьДаты = Ложь;
	ДатаОтправки   = Дата(1,1,1);
	
	ТипКонтролирующегоОргана = ТипКонтролирующегоОргана(КонтролирующийОрган);
	
	// <Объект не найден>
	ИмяТипаСправочникаМашиночитаемыеДоверенности = "МашиночитаемыеДоверенности";
	Если СтрНайти(Строка(Объект),"Объект не найден") > 0 Тогда
		ДатаОтправки = Дата(1,1,1);
	// Переписка
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ПерепискаСКонтролирующимиОрганами") Тогда
		
		Если Объект.Статус = Перечисления.СтатусыПисем.Полученное Тогда
			ДатаОтправки = Дата(1,1,1);
		Иначе
			
			ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Объект.Ссылка);
			
			Если ЗначениеЗаполнено(ЦиклОбмена) Тогда

				СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь,Истина);
				
				Если Объект.Тип = Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСПФР Тогда
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееПФР;
				ИначеЕсли Объект.Тип = Перечисления.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСФСГС Тогда
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПисьмоИсходящееФСГС;
				Иначе
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ОбращениеНП;
				КонецЕсли;
				
				СтрПервичныеСообщения = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", ТипСообщения));
					
				ДатаОтправки = ?(СтрПервичныеСообщения.Количество() > 0, СтрПервичныеСообщения[0].Дата, Дата(1,1,1));
				
			КонецЕсли;
			
		КонецЕсли;
		
	// Макеты ПД, Заявления о пенсии
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.МакетыПенсионныхДел")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ЗаявлениеОНазначенииПенсии") Тогда
		
		ДатаОтправки = ?(ЗначениеЗаполнено(Объект.ДатаСоздания) , " " + Формат(Объект.ДатаСоздания, "ДЛФ=DT"), Дата(1,1,1));
		
	// МЧД РР
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиРаспределенныйРеестр") Тогда
		ДатаОтправки = ?(ЗначениеЗаполнено(Объект.ДатаОтправки) , " " + Формат(Объект.ДатаОтправки, "ДЛФ=DT"), Дата(1,1,1));
		
	// МЧД единый формат
	ИначеЕсли ДокументооборотСКОКлиентСервер.ПодсистемаЦПРРМЧДСуществует()
		И ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка." + ИмяТипаСправочникаМашиночитаемыеДоверенности) Тогда
		
		СвойстваДоверенности = ДокументооборотСКОВызовСервера.СвойстваМЧДЕдиногоФормата(Объект.Ссылка);
		ОтчетОтправлен = ЗначениеЗаполнено(СвойстваДоверенности.ТехническийСтатус)
			И СвойстваДоверенности.ТехническийСтатус <>
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Создание")
			И СвойстваДоверенности.ТехническийСтатус <>
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Подписание")
			И СвойстваДоверенности.ТехническийСтатус <>
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Подписана")
			И СвойстваДоверенности.ТехническийСтатус <>
				ДокументооборотСКОВызовСервера.ТехническиеСтатусыМЧДЕдиногоФормата("Активна");
		ДатаОтправки = ?(ОтчетОтправлен И ЗначениеЗаполнено(СвойстваДоверенности.ДатаТранзакции),
			" " + Формат(СвойстваДоверенности.ДатаТранзакции, "ДЛФ=DT"), Дата(1,1,1));
		
	// ЕГРЮЛ, ЕГРИП, Запрос ИОН, Запрос ИОС, ФНС, ПФР, Росстат, ЦБ
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеСтрахователя")
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФНС
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПФР
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСГС
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ЦБ Тогда
		
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Объект.Ссылка);
		
		Если ЗначениеЗаполнено(ЦиклОбмена) Тогда

			СообщенияЦикла = ПолучитьСообщенияЦиклаОбмена(ЦиклОбмена,,Ложь,Истина);
			
			Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП") Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНаВыпискуЕРГЮЛ_ЕГРИП;
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеНалогоплательщика") Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗапросНП;
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗапросНаИнформационноеОбслуживаниеСтрахователя") Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееЗапросПФР;
			ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФНС Тогда
				Если ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Заявление Тогда
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ЗаявлениеНП;
				ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Форма2НДФЛ Тогда
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.Форма2НДФЛНП;
				ИначеЕсли ЦиклОбмена.Тип = Перечисления.ТипыЦикловОбмена.Представление Тогда
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПредставлениеНП;
				Иначе
					ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ДекларацияНП;
				КонецЕсли;
			ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПФР Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР;
			ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСГС Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьФСГС;
			ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ЦБ Тогда
				ТипСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ;
			КонецЕсли;
			
			СтрПервичныеСообщения = СообщенияЦикла.НайтиСтроки(Новый Структура("Тип", ТипСообщения));
				
			ДатаОтправки = ДатаОтправки(СтрПервичныеСообщения, НеПолучатьДаты);
			
		КонецЕсли;
		
	// ФСС, ФСРАР, РПН, ФТС, БанкРоссии
	ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСРАР
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.РПН
		ИЛИ ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
	
		Если ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС Тогда
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСС(Объект.Ссылка);
		ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСРАР Тогда
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВФСРАР(Объект.Ссылка);
		ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.РПН Тогда
			ОтправкаСсылка = ПолучитьПоследнююОтправкуОтчетаВРПН(Объект.Ссылка);
		ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФТС Тогда
			ОтправкаСсылка =  ПолучитьПоследнююОтправкуОтчетаВФТС(Объект.Ссылка);
		ИначеЕсли ТипКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.УдалитьБанкРоссии Тогда
			ОтправкаСсылка =  ПолучитьПоследнююОтправкуОтчетаВБанкРоссии(Объект.Ссылка);
		КонецЕсли;
		
		ДатаОтправки = ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
		
	КонецЕсли;
	
	Возврат ДатаОтправки;

КонецФункции

Функция СвойстваВходящегоДокументаСЭДОФСС(Объект) Экспорт
	
	Ссылка = Объект.Ссылка;
	
	// Наименование
	Наименование = НСтр("ru = '%1';
						|en = '%1'");
	Наименование = СтрШаблон(Наименование, Ссылка.ВидДокументаФСС);
	
	// Вид и код контролирующего органа
	ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС;
	
	КодКонтролирующегоОргана = Объект.КодОтправителя;
	
	Организация = Объект.Организация;
	
	// Запись в регистр
	ЗначенияЗаполнения = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПараметрыПроцедурыСоздатьЗаписьВРегистреЖурналОтправокВКонтролирующиеОрганы();
	ЗначенияЗаполнения.Ссылка 					= Ссылка;
	ЗначенияЗаполнения.ДатаСоздания				= Объект.ВходящаяДата;
	ЗначенияЗаполнения.Наименование 			= Наименование;
	ЗначенияЗаполнения.ВидКонтролирующегоОргана = ВидКонтролирующегоОргана;
	ЗначенияЗаполнения.КодКонтролирующегоОргана = КодКонтролирующегоОргана;
	ЗначенияЗаполнения.Организация 				= Организация;
	ЗначенияЗаполнения.СтраницаЖурнала			= Перечисления.СтраницыЖурналаОтчетность.Входящие;
	ЗначенияЗаполнения.ВидДокумента				= Перечисления.ВидыДокументовВЖурнале.ТребованиеИлиУведомление;
	ЗначенияЗаполнения.Комментарий				= Ссылка.Комментарий;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

Функция СвойстваЗаявленияНаФормированиеСправкиОРасчетах(Объект) Экспорт
	
	Ссылка = Объект.Ссылка;
	
	// Наименование
	Наименование = НСтр("ru = 'Справка о расчетах';
						|en = 'Statement of payments'");
	
	// Вид и код контролирующего органа
	ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС;
	
	КодКонтролирующегоОргана = Объект.КодПодчиненностиФСС;
	
	Организация = Объект.Организация;
	
	// Запись в регистр
	ЗначенияЗаполнения = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПараметрыПроцедурыСоздатьЗаписьВРегистреЖурналОтправокВКонтролирующиеОрганы();
	ЗначенияЗаполнения.Ссылка 					= Ссылка;
	ЗначенияЗаполнения.ДатаСоздания				= Объект.Дата;
	ЗначенияЗаполнения.Наименование 			= Наименование;
	ЗначенияЗаполнения.ВидКонтролирующегоОргана = ВидКонтролирующегоОргана;
	ЗначенияЗаполнения.КодКонтролирующегоОргана = КодКонтролирующегоОргана;
	ЗначенияЗаполнения.Организация 				= Организация;
	ЗначенияЗаполнения.СтраницаЖурнала			= Перечисления.СтраницыЖурналаОтчетность.Сверки;
	ЗначенияЗаполнения.Комментарий				= Ссылка.Комментарий;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

