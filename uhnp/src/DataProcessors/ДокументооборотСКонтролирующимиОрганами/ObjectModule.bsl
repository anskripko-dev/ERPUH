Функция УчетнаяЗаписьПоИдентификатору(ИдентификаторАбонента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеЗаписиДокументооборота.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписиДокументооборота
	|ГДЕ
	|	УчетныеЗаписиДокументооборота.ИдентификаторАбонента ПОДОБНО ""%"" + &ИдентификаторАбонента + ""%""
	|	И НЕ УчетныеЗаписиДокументооборота.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИдентификаторАбонента", ИдентификаторАбонента);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		УчетныеЗаписиДокументооборота = Выборка.Ссылка;
	Иначе
		УчетныеЗаписиДокументооборота = Неопределено
	КонецЕсли;
	
	Возврат УчетныеЗаписиДокументооборота;

КонецФункции

