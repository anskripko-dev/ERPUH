Функция ПолучитьДанныеСтрокой64(ДвДанные) Экспорт
	
	Если ТипЗнч(ДвДанные) = Тип("ХранилищеЗначения") Тогда 
		ДвДанные = ДвДанные.Получить();
	КонецЕсли;
	
	СтрокаBase64 = Base64Строка(ДвДанные);
	СтрокаЗамены = Символ(13) + Символ(10);
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, СтрокаЗамены, "");
	
	Возврат СтрокаBase64;
	
КонецФункции

