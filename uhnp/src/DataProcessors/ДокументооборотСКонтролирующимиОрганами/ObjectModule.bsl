Функция ДатаИзОтвета(ПоследнийРезультатПриема, НеПолучатьДаты)
	
	ДатаИзОтвета = Дата(1,1,1);
	
	Если НЕ НеПолучатьДаты Тогда
		
		Если ТипЗнч(ПоследнийРезультатПриема) = Тип("Массив") Тогда
			
			Если ПоследнийРезультатПриема.Количество() > 0 Тогда
				
				ТранспортноеСообщение 	= ПоследнийРезультатПриема[0].Ссылка;
				ДатаИзОтвета 			= ДатаИзОтветовКонтролирующихОрганов(ТранспортноеСообщение);
			
			КонецЕсли;
				
		Иначе
				
			ДатаИзОтвета = ДатаИзОтветовКонтролирующихОрганов(ПоследнийРезультатПриема.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ДатаИзОтвета;
	
КонецФункции

Функция ДатаОтправки(ПоследнийРезультатПриема, НеПолучатьДаты) Экспорт
	
	ДатаИзОтвета = Дата(1,1,1);
	
	Если НеПолучатьДаты Тогда
		
		ДатаИзОтвета = Дата(1,1,1);
		
	Иначе
		
		Если ТипЗнч(ПоследнийРезультатПриема) = Тип("Массив") Тогда
			
			ДатаИзОтвета = ?(
				ПоследнийРезультатПриема.Количество() > 0, 
				ПоследнийРезультатПриема[0].ДатаТранспорта, 
				Дата(1,1,1));
			
		Иначе
		
			ДатаИзОтвета = ПоследнийРезультатПриема.ДатаТранспорта;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДатаИзОтвета;
	
КонецФункции

Процедура ОтметитьДеревоПросмотренным(Новое) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокиДерева = Новое.ПолучитьЭлементы();
	
	СсылкиДляОтметки = Новый Массив;
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
			СсылкиДляОтметки.Добавить(СтрокаДерева.Ссылка);
		КонецЕсли;
		
		ПодстрокиДерева = СтрокаДерева.ПолучитьЭлементы();
		Для Каждого ПодстрокаДерева Из ПодстрокиДерева Цикл
			Если ЗначениеЗаполнено(ПодстрокаДерева.Ссылка) Тогда
				СсылкиДляОтметки.Добавить(ПодстрокаДерева.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналНовыхСобытий.Ссылка КАК Ссылка,
		|	ЖурналНовыхСобытий.ПоказатьПользователю КАК ПоказатьПользователю
		|ИЗ
		|	РегистрСведений.ЖурналНовыхСобытий КАК ЖурналНовыхСобытий
		|ГДЕ
		|	ЖурналНовыхСобытий.Ссылка В(&Ссылка)
		|	И ЖурналНовыхСобытий.ПоказатьПользователю = ИСТИНА";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкиДляОтметки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОтметитьСсылкуПоказаннойПользователю(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтметитьСсылкуПоказаннойПользователю(Ссылка) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЖурналНовыхСобытий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ссылка.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	
	Для каждого ЗаписьНабора Из НаборЗаписей Цикл
		ЗаписьНабора["ПоказатьПользователю"] = Ложь;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область БанкРоссии

Функция ТаблицаЭтаповОтправкиБанкРоссии(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет);
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
	СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
	СтрокаЭтапа.Дата						= Дата(1,1,1);
	СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправлено();
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
	СтрокаЭтапа.ЭтапПройден					= Истина;
	
	// определяем последнюю отправку
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		ОтправкаСсылка = ДополнительныеПараметры.Отправка;
	Иначе
		ОтправкаСсылка =  ПолучитьПоследнююОтправкуОтчетаВБанкРоссии(СсылкаНаОтчет);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
		Возврат ТаблицаЭтаповОтправки;
	КонецЕсли;
	
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Отправлено в Банк России';
													|en = 'Sent to the Bank of Russia '");
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Отправлено в Банк России';
													|en = 'Sent to the Bank of Russia '");
	СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Ожидается результат обработки';
													|en = 'Processing result is expected'");
	СтрокаЭтапа.НаименованиеПротокола		= "";
	СтрокаЭтапа.Протокол					= "";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено;

	
	Если ОтправкаСсылка <> Неопределено И  ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и отправьте отчет еще раз';
														|en = 'Correct errors and send the report again'");
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	Иначе
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан, ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол о сдаче';
														|en = 'Delivery protocol'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
			
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ТаблицаЭтаповОтправкиМинобороны(СсылкаНаОтчет, ДополнительныеПараметры)
	
	НачальныйСтатус = НачальныйСтатусПриФормированииТаблицыЭтаповОтправки(СсылкаНаОтчет, "Минобороны");
	
	ТаблицаЭтаповОтправки = ЗаготовкаТаблицыЭтаповОтправки();
	ТаблицаЭтаповОтправки.Колонки.Добавить("СтатусУстановленВручную", Новый ОписаниеТипов("Булево"));
	
	ПоследняяОтправка = ПолучитьПоследнююОтправкуОтчетаВМинобороны(СсылкаНаОтчет);
	
	// определяем последнюю отправку
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Отправка") Тогда
		
		ОтправкаСсылка = ДополнительныеПараметры.Отправка;
		
	Иначе
		
		ОтправкаСсылка = ПоследняяОтправка;
		
	КонецЕсли;
	
	// СтатусУстановленВручную устанавливаем только для последней отправки к ней относится статус в журнале
	Если ОтправкаСсылка = ПоследняяОтправка Тогда
		МодульДокументооборотСМинобороны = ОбщегоНазначения.ОбщийМодуль("ДокументооборотСМинобороны");
		СтатусУстановленВручную = МодульДокументооборотСМинобороны.СтатусУстановленВручную(ОтправкаСсылка, НачальныйСтатус);
	Иначе
		СтатусУстановленВручную = Ложь;
	КонецЕсли; 
	
	Если СтатусУстановленВручную Тогда
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НачальныйСтатус;
		СтрокаЭтапа.ТекстСтатуса				= НачальныйСтатус;
		СтрокаЭтапа.Дата						= Дата(1,1,1);
		Если НачальныйСтатус = ИнтерфейсыВзаимодействияБРОКлиентСервер.СтатусВРаботеСтрокой() Тогда
			СтрокаЭтапа.КомментарийКСостоянию		= КомментарийКСостояниюНеОтправленоМинобороны();
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
		ИначеЕсли НачальныйСтатус = ДокументооборотСКОКлиентСервер.СтатусПереданоВМинобороны() ИЛИ НачальныйСтатус = "Передано" Тогда
			СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусПереданоВМинобороны();
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Передано';
															|en = 'Handed over'");
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
		ИначеЕсли НачальныйСтатус = "Сдано" ИЛИ НачальныйСтатус = ДокументооборотСКОКлиентСервер.СтатусСданоЕстьЗамечания() Тогда
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		ИначеЕсли НачальныйСтатус = "Не сдано" Тогда
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		КонецЕсли;
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= "";
		СтрокаЭтапа.ЭтапПройден					= Истина;
		СтрокаЭтапа.СтатусУстановленВручную = Истина;
 	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ОтправкаСсылка) ИЛИ
		ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПустаяСсылка()
		ИЛИ СтатусУстановленВручную Тогда
		
		// таблица должна содержать хотя бы одну строку
		Если ТаблицаЭтаповОтправки.Количество() = 0 Тогда
			СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
			СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусПереданоВМинобороны();
			СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Передано';
															|en = 'Handed over'");
			СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
			СтрокаЭтапа.КомментарийКСостоянию		= "";
			СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Загрузить протокол сдачи';
															|en = 'Import delivery protocol'", "ru");
			СтрокаЭтапа.Протокол					= "ЗагрузитьОтветнуюКвитанцию";
			СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
			СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено;
		КонецЕсли;
		
		Возврат ТаблицаЭтаповОтправки;
		
	КонецЕсли;
	
	// этапы отчетов отправленных в Минобороны
	СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
	СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусПереданоВМинобороны();
	СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Передано';
													|en = 'Handed over'");
	СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаОтправки, Дата(1,1,1));
	СтрокаЭтапа.КомментарийКСостоянию		= "";
	СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Загрузить протокол сдачи';
													|en = 'Import delivery protocol'", "ru");
	СтрокаЭтапа.Протокол					= "ЗагрузитьОтветнуюКвитанцию";
	СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ДокументооборотНачат;
	СтрокаЭтапа.ЭтапПройден					= ОтправкаСсылка <> Неопределено;
		
	Если ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Не сдано';
														|en = 'Not submitted'");
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка), ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол ошибок';
														|en = 'Error log'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.КомментарийКСостоянию		= НСтр("ru = 'Исправьте ошибки и передайте отчет еще раз';
														|en = 'Correct errors and pass the report again'");
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ОтрицательныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки Тогда 
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= ДокументооборотСКОКлиентСервер.СтатусСданоЕстьЗамечания();
		СтрокаЭтапа.ТекстСтатуса				= ДокументооборотСКОКлиентСервер.СтатусСданоЕстьЗамечания();
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки, ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		СтрокаЭтапа.НаименованиеПротокола		= НСтр("ru = 'Протокол сдачи';
														|en = 'Delivery protocol'");
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
		
	ИначеЕсли ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан Тогда 
		
		СтрокаЭтапа = ТаблицаЭтаповОтправки.Добавить();
		СтрокаЭтапа.ТекстНадписи				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.ТекстСтатуса				= НСтр("ru = 'Сдано';
														|en = 'Submitted:'");
		СтрокаЭтапа.Дата						= ?(ЗначениеЗаполнено(ОтправкаСсылка) И ОтправкаСсылка.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан, ОтправкаСсылка.ДатаЗакрытия, Дата(1,1,1));
		СтрокаЭтапа.КомментарийКСостоянию		= "";
		// если сдано, то протокол ошибок не отображается
		СтрокаЭтапа.НаименованиеПротокола		= "";
		СтрокаЭтапа.Протокол					= ОтправкаСсылка;
		СтрокаЭтапа.СостояниеСдачиОтчетности	= Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота;
		СтрокаЭтапа.ЭтапПройден					= Истина;
			
	КонецЕсли;
	
	Возврат ТаблицаЭтаповОтправки;
	
КонецФункции

Функция ПолучитьПоследнююОтправкуОтчетаВБанкРоссии(ОтчетСсылка) Экспорт
	
	Отправка = Неопределено;
	
	Если ДокументооборотСКОКлиентСервер.ПодсистемаУдалитьЦБСуществует() Тогда
		МодульУдалитьДокументооборотСБанкомРоссии = ОбщегоНазначения.ОбщийМодуль("УдалитьДокументооборотСБанкомРоссии");
		Возврат МодульУдалитьДокументооборотСБанкомРоссии.ПолучитьПоследнююОтправкуОтчета(ОтчетСсылка);
	КонецЕсли;
	
	Возврат Отправка;
	
КонецФункции

Функция ПолучитьПоследнююОтправкуОтчетаВМинобороны(ОтчетСсылка) Экспорт
	
	Отправка = Неопределено;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.СдачаОтчетностиВМинобороны") Тогда
		МодульДокументооборотСМинобороны = ОбщегоНазначения.ОбщийМодуль("ДокументооборотСМинобороны");
		Возврат МодульДокументооборотСМинобороны.ПолучитьПоследнююОтправкуОтчета(ОтчетСсылка);
	КонецЕсли;
	
	Возврат Отправка;
	
КонецФункции

Процедура ПриЗаписиОтправкиБанкРоссии(Объект, Отказ) Экспорт
	
	Если Объект.ОтчетСсылка <> Неопределено Тогда
		// отражаем изменения в регистре статусов отправки
		ОбновитьСтатусОтправкиОтчетаВБанкРоссии(Объект.ОтчетСсылка);
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗаписьОбъектовРегламентированнойОтчетности(Объект.ОтчетСсылка, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиОтправкиМинобороны(Объект, Отказ) Экспорт
	
	Если Объект.ОтчетСсылка <> Неопределено Тогда
		// отражаем изменения в регистре статусов отправки
		ОбновитьСтатусОтправкиОтчетаВМинобороны(Объект.ОтчетСсылка);
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗаписьОбъектовРегламентированнойОтчетности(Объект.ОтчетСсылка, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСтатусОтправкиОтчетаВМинобороны(Отчет)
	
	// находим последнюю не помеченную на удаление отправку отчета
	ПоследняяОтправка = ПолучитьПоследнююОтправкуОтчетаВМинобороны(Отчет);
	
	// вычисляем значение статуса отправки (ПеречислениеСсылка.СтатусыОтправки)
	Если ЗначениеЗаполнено(ПоследняяОтправка) Тогда
		
		СтатусОтправки = ПоследняяОтправка.СтатусОтправки;
		Если СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки Тогда
			//введено после добавления дополнительного статуса ПринятЕстьОшибки, при котором отчет считается сданным
			СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
		КонецЕсли;
		
	Иначе
		СтатусОтправки = Неопределено;
	КонецЕсли;
	
	// сохраняем статус в базе
	ЗаписатьСтатусОтправкиОтчетаВМинобороны(Отчет, СтатусОтправки, ПоследняяОтправка);
	
КонецПроцедуры

Процедура ЗаписатьСтатусОтправкиОтчетаВМинобороны(Отчет, СтатусОтправки, ОснованиеСтатуса)
	
	Если ЗначениеЗаполнено(СтатусОтправки) Тогда
		МенЗап = РегистрыСведений.СтатусыОтправки.СоздатьМенеджерЗаписи();
		МенЗап.Объект = Отчет;
		МенЗап.Статус = СтатусОтправки;
		МенЗап.Основание = ОснованиеСтатуса;
		МенЗап.Записать(Истина);
	Иначе
		МенЗап = РегистрыСведений.СтатусыОтправки.СоздатьМенеджерЗаписи();
		МенЗап.Объект = Отчет;
		МенЗап.Прочитать();
		Если МенЗап.Выбран() Тогда
			МенЗап.Удалить();
		КонецЕсли;
	КонецЕсли;
	
	// вызываем переопределяемую процедуру отработки изменения статуса отправки
	ПриИзмененииСтатусаОтправкиДокумента(Отчет, СтатусОтправки);
	
КонецПроцедуры

Процедура ОбновитьСтатусОтправкиОтчетаВБанкРоссии(Отчет)
	
	// находим последнюю не помеченную на удаление отправку отчета
	ПоследняяОтправка = ПолучитьПоследнююОтправкуОтчетаВБанкРоссии(Отчет);
	
