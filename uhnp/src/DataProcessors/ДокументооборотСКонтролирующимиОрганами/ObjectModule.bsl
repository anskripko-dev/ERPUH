	Если НЕ ЗначениеЗаполнено(ПараметрыФайлаВыгрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем КодНО
	КодНО = ПараметрыФайлаВыгрузки["КодНО"];
	Если КодНО = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений заявления: не удалось определить код налогового органа - получателя.';
								|en = 'Cannot generate the application information description: cannot determine a code of the recipient tax authority.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем номер заявления
	НомерДокНП = ПараметрыФайлаВыгрузки["НомерДокНП"];
	Если НомерДокНП = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений заявления: не удалось определить номер заявления, указанный налогоплательщиком.';
								|en = 'Cannot generate an application information description: cannot determine an application number specified by the taxpayer.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// удаляем временный файл выгрузки
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаВыгрузки);
	
	Результат = Новый Структура("КодНО, НомерДокНП", КодНО, НомерДокНП);
	
	ДобавитьДополнительныеСведенияДляОписания(Результат, Сообщение, КППДляПоиска);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьКлючевыеПараметрыФайлаЗапроса(
		Сообщение,
		Вложения,
		КППДляПоиска = "")
	
	// ищем файл запроса
	СтрФайлЗапроса = Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Запрос, "Тип");
	Если СтрФайлЗапроса = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось обнаружить файл запроса среди вложений сообщения.';
								|en = 'Cannot generate information description: cannot find a query file among message attachments.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ФайлыЗапроса = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, , СтрФайлЗапроса.ИмяФайла);
	
	// сохраняем файл запроса во временный файл
	ИмяВременногоФайлаЗапроса = ПолучитьИмяВременногоФайла();
	Попытка
		ФайлыЗапроса[0].Данные.Получить().Записать(ИмяВременногоФайлаЗапроса);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось сохранить файл запроса во временный каталог';
								|en = 'Cannot generate information description: cannot save the query file to the temporary directory.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	// разбираем содержимое файла запроса
	ПараметрыФайлаЗапроса = СформироватьСтруктуруПараметровФайлаЗапросаДляОписанияСведений(ИмяВременногоФайлаЗапроса);
	Если НЕ ЗначениеЗаполнено(ПараметрыФайлаЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ищем КНД
	КодЗапр = ПараметрыФайлаЗапроса["КодЗапр"];
	Если КодЗапр = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось определить код типа запроса по файлу запроса.';
								|en = 'Cannot generate information description: cannot determine a query type code by the query file.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// определяем инспекции по имени файла
	Инспекции = ОпределитьИнспекцииПоИмениФайла(СтрФайлЗапроса.ИмяФайла);
	Если НЕ ЗначениеЗаполнено(Инспекции) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось выделить коды инспекций в имени файла запроса.';
								|en = 'Cannot generate information description: cannot select inspection codes in the query file name.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	// удаляем временный файл выгрузки
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаЗапроса);
	
	// 
	Результат = Новый Структура("КодЗапр,	НОПоМестуПредставления,	НОПоМестуНахождения",
								 КодЗапр,	Инспекции.КодИФНС1,		Инспекции.КодИФНС2);
	
	ДобавитьДополнительныеСведенияДляОписания(Результат, Сообщение, КППДляПоиска);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьКНДФайлаВыгрузкиПредставления(Сообщение, Вложения)
	
	// ищем файл выгрузки
	СтрФайлВыгрузки = Вложения.Найти(Перечисления.ТипыСодержимогоТранспортногоКонтейнера.Представление, "Тип");
	Если СтрФайлВыгрузки = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось обнаружить файл выгрузки среди вложений сообщения.';
								|en = 'Cannot generate information description: cannot detect an export file among message attachments.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	ФайлыВыгрузки = ПолучитьВложенияТранспортногоСообщения(Сообщение, Истина, , СтрФайлВыгрузки.ИмяФайла);
	
	// сохраняем файл выгрузки во временный файл
	ИмяВременногоФайлаВыгрузки = ПолучитьИмяВременногоФайла();
	Попытка
		ФайлыВыгрузки[0].Данные.Получить().Записать(ИмяВременногоФайлаВыгрузки);
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать описание сведений: не удалось сохранить файл выгрузки во временный каталог.';
								|en = 'Cannot generate information description: cannot save the export file to the temporary directory.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Неопределено;
