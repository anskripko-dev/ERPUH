	|ВЫБРАТЬ
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.Владелец КАК Владелец,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.РегистрационныйНомерПФР КАК РегистрационныйНомерПФР,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.Наименование КАК Наименование,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.НаименованиеКраткое КАК НаименованиеКраткое,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.ИНН КАК ИНН,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.КПП КАК КПП,
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.СНИЛС КАК СНИЛС
	|ИЗ
	|	Документ.УведомлениеОПрекращенииПолномочийПредставителя.РеквизитыСубъектов КАК УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов
	|ГДЕ
	|	УведомлениеОПрекращенииПолномочийПредставителяРеквизитыСубъектов.Ссылка = &ДокументСсылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаКонтактнойИнформации = ПакетЗапросов[0].Выгрузить();
	
	КонтактнаяИнформация = Новый Массив;
	ВыборкаКонтактнойИнформации = ПакетЗапросов[0].Выбрать();
	Пока ВыборкаКонтактнойИнформации.Следующий() Цикл
		
		Владелец = СтрЗаменить(ВыборкаКонтактнойИнформации.Владелец, " ", "");
		Результат.Вставить(Владелец + "_" + "АдресЭлПочты", ВыборкаКонтактнойИнформации.АдресЭлПочты);
		Результат.Вставить(Владелец + "_" + "Телефон", ВыборкаКонтактнойИнформации.Телефон);
	КонецЦикла;
	
	ВыборкаФИОСубъектов = ПакетЗапросов[1].Выбрать();
	Пока ВыборкаФИОСубъектов.Следующий() Цикл
		
		Владелец = СтрЗаменить(ВыборкаФИОСубъектов.Владелец, " ", "");
		Результат.Вставить(Владелец + "_" + "Фамилия", ВыборкаФИОСубъектов.Фамилия);
		Результат.Вставить(Владелец + "_" + "Имя", ВыборкаФИОСубъектов.Имя);
		Результат.Вставить(Владелец + "_" + "Отчество", ВыборкаФИОСубъектов.Отчество);
		Результат.Вставить(Владелец + "_" + "Должность", ВыборкаФИОСубъектов.Должность);
		
	КонецЦикла;
	
	ВыборкаИнформации = ПакетЗапросов[2].Выбрать();
	Если ВыборкаИнформации.Следующий() Тогда
	
		Результат.Вставить("Ссылка", ВыборкаИнформации.Ссылка);
		Результат.Вставить("Дата", Формат(ВыборкаИнформации.Дата,"ДФ=yyyy-MM-dd"));
		Результат.Вставить("Организация", ВыборкаИнформации.Организация);
		Результат.Вставить("Страхователь", ВыборкаИнформации.Страхователь);
		Результат.Вставить("Представитель", ВыборкаИнформации.Представитель);
		Результат.Вставить("ПредставительСотрудник", 
			?(ВыборкаИнформации.ПредставительСотрудник = "" 
				ИЛИ ВыборкаИнформации.ПредставительСотрудник = Неопределено
				ИЛИ НЕ ЗначениеЗаполнено(ВыборкаИнформации.ПредставительСотрудник), Ложь, Истина));
		Результат.Вставить("СтраховательСотрудник", ВыборкаИнформации.СтраховательСотрудник);
		Результат.Вставить("Получатель", ВыборкаИнформации.Получатель);
		Результат.Вставить("РегНомерПФР", ВыборкаИнформации.РегНомерПФР);
			
	КонецЕсли;
	
	ВыборкаРеквизитовСубъектов = ПакетЗапросов[3].Выбрать();
	Пока ВыборкаРеквизитовСубъектов.Следующий() Цикл
		
		Владелец = СтрЗаменить(ВыборкаРеквизитовСубъектов.Владелец, " ", "");
		Результат.Вставить(Владелец + "_" + "РегистрационныйНомерПФР", ВыборкаРеквизитовСубъектов.РегистрационныйНомерПФР);
		Результат.Вставить(Владелец + "_" + "Наименование", ВыборкаРеквизитовСубъектов.Наименование);
		Результат.Вставить(Владелец + "_" + "НаименованиеКраткое", ВыборкаРеквизитовСубъектов.НаименованиеКраткое);
		Результат.Вставить(Владелец + "_" + "ИНН", ВыборкаРеквизитовСубъектов.ИНН);
		Результат.Вставить(Владелец + "_" + "КПП", ВыборкаРеквизитовСубъектов.КПП);
		Результат.Вставить(Владелец + "_" + "СНИЛС", ВыборкаРеквизитовСубъектов.СНИЛС);
		
	КонецЦикла;
	
	Если ТипЗнч(Результат.Представитель) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Результат.Вставить("ПредставительФизическоеЛицо", Истина);
	ИначеЕсли ТипЗнч(Результат.Представитель) = Тип("Строка")
		И Результат.Свойство("СотрудникПредставителя_Имя")
		И НЕ Результат.ПредставительСотрудник Тогда
		Результат.Вставить("ПредставительФизическоеЛицо", Истина);
	Иначе
		Результат.Вставить("ПредставительФизическоеЛицо", Ложь);
	КонецЕсли;
		
	Результат.Вставить("УникальныйИдентификатор", ДокументСсылка.УникальныйИдентификатор());
	Получатель = ОпределитьОрганПФРОрганизации(ВыборкаИнформации.Организация);
	Результат.Вставить("Получатель", Получатель);
	
	Возврат Результат;
	
КонецФункции

Функция ВыгрузитьУведомлениеОПрекращенииПолномочийПредставителя(УведомлениеСсылка) Экспорт
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УведомлениеСсылка,
		"ИмяФайлаВыгрузки, ЭлектроннаяПодпись");
	ДанныеПодписи = РеквизитыОбъекта.ЭлектроннаяПодпись.Получить();
	Если ЗначениеЗаполнено(РеквизитыОбъекта.ИмяФайлаВыгрузки) И ДанныеПодписи <> Неопределено Тогда
		АдресПодписи = ПоместитьВоВременноеХранилище(ДанныеПодписи, Новый УникальныйИдентификатор);
		
		Уведомление = ДанныеУПРУПИзИнформационнойБазы(УведомлениеСсылка);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Документ", Уведомление);
		ДополнительныеПараметры.Вставить("Тип", Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС);
		ДополнительныеПараметры.Вставить("Имя", РеквизитыОбъекта.ИмяФайлаВыгрузки);
		ДополнительныеПараметры.Вставить("Адрес", АдресПодписи);
		
		Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры);
		
		Возврат Результат;
	КонецЕсли;
	
	РезультатыПроверки = ДокументооборотСКОВызовСервера.ПроверитьУПРУП(УведомлениеСсылка);
	
	Если РезультатыПроверки.Количество() <> 0 Тогда
		Для каждого РезультатПроверки Из РезультатыПроверки Цикл
			ОбщегоНазначения.СообщитьПользователю(РезультатПроверки.ТекстОшибки);
		КонецЦикла;
		
		Возврат Неопределено;
	КонецЕсли;
	
	Уведомление = ДанныеУПРУПИзИнформационнойБазы(УведомлениеСсылка);
	
	Если Не ЗначениеЗаполнено(Уведомление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоЮридическоеЛицо = ?(Уведомление.Свойство("СтраховательЮЛ_ИНН"), Истина, Ложь);
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЭДПФР");
	
	Если ДействуетФорматАФ245д() Тогда
		УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьАтрибутыКорня_АФ245д(ЗаписьXML, Уведомление);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("УПРУП");
	
	УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_Страхователь(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо);
	
	ЭтоЮридическоеЛицо = ?(Уведомление.Свойство("ПредставительЮЛ_ИНН"), Истина, Ложь);

	УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_Представитель(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо);
	
	Если ЗначениеЗаполнено(Уведомление.СтраховательСотрудник) Тогда
		УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_СтраховательСотрудник(ЗаписьXML, Уведомление, ЭтоЮридическоеЛицо);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // УПРУП
	УведомлениеОПрекращенииПолномочийПредставителя_ЗаписатьУзелXML_СлужебнаяИнформация(ЗаписьXML, Уведомление);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ЭДПФР
	
	ЗаписьXML.Закрыть();
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), Новый УникальныйИдентификатор);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Документ", Уведомление);
	ДополнительныеПараметры.Вставить("Тип", Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС);
	ДополнительныеПараметры.Вставить("Имя", УведомлениеОПрекращенииПолномочийПредставителя_ИмяФайла(Уведомление));
	ДополнительныеПараметры.Вставить("Адрес", АдресФайла);
	
	Результат = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры);
	
	Возврат Результат;
	
КонецФункции

Функция АдресДанныхФайлаАвтонастройки(УчетнаяЗапись) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФайлыСведенийСпецоператоры.Данные
		|ИЗ
		|	РегистрСведений.ФайлыСведенийСпецоператоры КАК ФайлыСведенийСпецоператоры
		|ГДЕ
		|	ФайлыСведенийСпецоператоры.УчетнаяЗапись = &УчетнаяЗапись";
	
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Адрес = ПоместитьВоВременноеХранилище(ВыборкаДетальныеЗаписи.Данные.Получить(), Новый УникальныйИдентификатор);
	Иначе
		Адрес = Неопределено;
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

Функция ОтпечатокПоДвДаннымСертификата(ДвДанныеСертификата) Экспорт
	
	Если ТипЗнч(ДвДанныеСертификата) = Тип("ДвоичныеДанные") Тогда
		СертификатОбъект = Новый СертификатКриптографии(ДвДанныеСертификата);
		Отпечаток = Строка(СертификатОбъект.Отпечаток);
		Отпечаток = НРег(СтрЗаменить(Отпечаток, " ", ""));
	Иначе
		Отпечаток = "";
	КонецЕсли;
	
	Возврат Отпечаток;
	
КонецФункции

