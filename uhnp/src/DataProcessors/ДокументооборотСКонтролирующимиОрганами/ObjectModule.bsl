			Если НайденнаяСтрока <> Неопределено Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("Пояснен");
				ЗаписьXML.ЗаписатьАтрибут("ТипИнф", "2");
				ЗаписьXML.ЗаписатьНачалоЭлемента("ВСчФ_173.5");
				ЗаписатьСтрокуВыставленныеСФ_173_5(ЗаписьXML, НайденнаяСтрока, Колонки);
				ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли;
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ВыгрузитьСведКС(ЗаписьXML, СведКС)
	
	Если НЕ ЗначениеЗаполнено(СведКС)
		ИЛИ СведКС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из СведКС Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СведКС");
		
		ЗаписатьАтрибутПриНеобходимости(
			ЗаписьXML, "НомКС", СтрокаТаблицы.НомКС);
			
		ЗаписатьАтрибутПриНеобходимости(
			ЗаписьXML, "ПоясненКС", СтрокаТаблицы.ПоясненКС);
			
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьНетКнигаПрод(ЗаписьXML, НеподтвЗаписи, СведенияРасходятся)
	
	Если Не ЗначениеЗаполнено(НеподтвЗаписи)
		И Не ЗначениеЗаполнено(СведенияРасходятся.Расхождение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("НетКнигаПрод");
	
	Если ЗначениеЗаполнено(НеподтвЗаписи) Тогда
		
		Для Каждого СтрокаТаблицы Из НеподтвЗаписи Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("НеподтвЗаписи");
			
			ЗаписатьАтрибутПриНеобходимости(
				ЗаписьXML, "НомСчФПрод", СтрокаТаблицы.НомСчФПрод);
				
			ЗаписатьАтрибутПриНеобходимости(
				ЗаписьXML, "ДатаСчФПрод", Формат(СтрокаТаблицы.ДатаСчФПрод, "ДФ=dd.MM.yyyy"));
				
			ЗаписатьДанныеКонтрагента(ЗаписьXML, СтрокаТаблицы.СвКонтрагент, "СвКонтрагент");
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияРасходятся.Расхождение) Тогда
		
		Для Каждого СтрокаТаблицы Из СведенияРасходятся.Расхождение Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("СведРасх");
			
			НайденнаяСтрока = СведенияРасходятся.Пояснение.Найти(СтрокаТаблицы.НомерСтроки, "НомерСтроки");
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Расхожд");
			ЗаписьXML.ЗаписатьАтрибут("ТипИнф", "1");
			ЗаписатьСтрокуНетКнигаПрод(ЗаписьXML, СтрокаТаблицы);
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			Если НайденнаяСтрока <> Неопределено Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("Пояснен");
				ЗаписьXML.ЗаписатьАтрибут("ТипИнф", "2");
				ЗаписатьСтрокуНетКнигаПрод(ЗаписьXML, НайденнаяСтрока);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли;

			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьСтрокуНетКнигаПрод(ЗаписьXML, СтрокаТаблицы, Колонки = Неопределено)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("НеКнПрСтр");
	
	ЗаписатьАтрибутПриНеобходимости(
		ЗаписьXML, "НомСчФПрод", СтрокаТаблицы.НомСчФПрод, Колонки);
		
	Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаСчФПрод) Тогда	
		ЗаписатьАтрибутПриНеобходимости(
			ЗаписьXML, "ДатаСчФПрод", Формат(СтрокаТаблицы.ДатаСчФПрод, "ДФ=dd.MM.yyyy"), Колонки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СтоимПродСФВ) Тогда
		ЗаписатьАтрибутПриНеобходимости(
			ЗаписьXML, "СтоимПродСФВ", Формат(СтрокаТаблицы.СтоимПродСФВ, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="), Колонки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СтоимПродСФ) Тогда
		ЗаписатьАтрибутПриНеобходимости(
			ЗаписьXML, "СтоимПродСФ", Формат(СтрокаТаблицы.СтоимПродСФ, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="), Колонки);
	КонецЕсли;
			
	ЗаписатьАтрибутПриНеобходимости(
		ЗаписьXML, "Раздел", СтрокаТаблицы.Раздел, Колонки);
		
	Если Не ЗначениеЗаполнено(Колонки) ИЛИ Колонки.Найти("СвПокуп") <> Неопределено Тогда	
		ЗаписатьДанныеКонтрагента(ЗаписьXML, СтрокаТаблицы.СвПокуп, "СвПокуп");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Колонки) ИЛИ Колонки.Найти("СвПосред") <> Неопределено Тогда	
		ЗаписатьДанныеКонтрагента(ЗаписьXML, СтрокаТаблицы.СвПосред, "СвПосред");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Колонки) ИЛИ Колонки.Найти("КодВидОпер") <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаТаблицы.КодВидОпер) Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("КодВидОпер");
			ЗаписьXML.ЗаписатьТекст(СтрокаТаблицы.КодВидОпер);
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ВыгрузитьПояснИнОсн(ЗаписьXML, ПояснИнОсн)
	
	Если НЕ ЗначениеЗаполнено(ПояснИнОсн) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ПояснИнОсн");
	ЗаписьXML.ЗаписатьТекст(ПояснИнОсн);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ИдентификаторФайла(Организация, КодНалоговогоОргана)
	
	ЭлРегистрацияВИФНС = РегистрацияВИФНСПоОрганизацииИКодуНО(Организация, КодНалоговогоОргана);
	
	ПараметрыОписи = СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана);
	Если ПараметрыОписи = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// формируем идентификатор отправителя
	Если ПараметрыОписи.ПрПодп = 2 Тогда
		СвПред = ПараметрыОписи.Доверенность.СвУпПред.СвПред;
		Если СвПред.Свойство("СвОрг") Тогда
			ИННОтправителя = СокрЛП(СвПред.СвОрг.ИННЮЛ);
			КППОтправителя = СокрЛП(СвПред.СвОрг.КПП);
		Иначе
			Если НЕ ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации Тогда
				ИННОтправителя = СокрЛП(СвПред.СведФизЛ.ИННФЛ);
				КППОтправителя = "";
			ИначеЕсли ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизации
				И ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.Свойство("ЯвляетсяСотрудникомОрганизацииПоМЧД")
				И ПараметрыОписи.Доверенность.СвУпПред.СвПред.СведФизЛ.ЯвляетсяСотрудникомОрганизацииПоМЧД = Ложь
				И ДокументооборотСКОКлиентСервер.ПараметрыОтправкиПоМЧДФНС("ИзменятьФайлВыгрузкиДляФизическогоЛица") Тогда
				ИННОтправителя = ?(ПараметрыОписи.Доверенность.СвПредст.ЯвляетсяФЛ, СокрЛП(ПараметрыОписи.Доверенность.СвПредст.ИННФЛ),
					СокрЛП(ПараметрыОписи.Доверенность.СвПредст.ИННЮЛ));
				КППОтправителя = ?(ПараметрыОписи.Доверенность.СвПредст.ЯвляетсяФЛ, "", СокрЛП(ЭлРегистрацияВИФНС.КПП));
			Иначе
				ИННОтправителя = ?(ПараметрыОписи.ЭтоПБОЮЛ, СокрЛП(ПараметрыОписи.ИННФЛ), СокрЛП(ПараметрыОписи.ИННЮЛ));
				КППОтправителя = ?(ПараметрыОписи.ЭтоПБОЮЛ, "", СокрЛП(ПараметрыОписи.КППЮЛ));
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИННОтправителя = ?(ПараметрыОписи.ЭтоПБОЮЛ, СокрЛП(ПараметрыОписи.ИННФЛ), СокрЛП(ПараметрыОписи.ИННЮЛ));
		КППОтправителя = ?(ПараметрыОписи.ЭтоПБОЮЛ, "", СокрЛП(ПараметрыОписи.КППЮЛ));
	КонецЕсли;
	
	R_T = "ON_OTTRNDS";
	
	ЭтоКрупнейший    = ДокументооборотСКО.ЭтоКрупнейший(Организация);
	КодНОКрупнейшего = ДокументооборотСКО.КодНОКрупнейшего(Организация);
	
	Если ЭтоКрупнейший 
		И ЗначениеЗаполнено(КодНОКрупнейшего) Тогда
		КодНалоговогоОрганаПосредника = СокрЛП(КодНОКрупнейшего);
	Иначе
		КодНалоговогоОрганаПосредника = КодНалоговогоОргана;
	КонецЕсли;
	
	A_K = КодНалоговогоОрганаПосредника + "_" + КодНалоговогоОргана;
	
	Если СтрДлина(ИННОтправителя) = 10 Тогда
		O = ИННОтправителя + КППОтправителя;
	ИначеЕсли СтрДлина(ИННОтправителя) = 12 Тогда
		O = ИННОтправителя;
	Иначе
		O = "000000000000";
	КонецЕсли;
	
	GGGGMMDD = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd");
	
	N = ВРЕГ(Строка(Новый УникальныйИдентификатор));
	
	Возврат R_T + "_" + A_K + "_" + O + "_" + GGGGMMDD + "_" + N;
	
КонецФункции

Функция СформироватьПараметрыОписиИсходящихДокументов(Организация, ЭлРегистрацияВИФНС, КодНалоговогоОргана) Экспорт
	
	СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация);
	
	ЭтоПБОЮЛ = НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Организация);
	СведенияОбОрганизации.Вставить("ЭтоПБОЮЛ", ЭтоПБОЮЛ);
	
	// ищем РегистрацияВИФНС по организации и коду налогового органа
	СведенияОбОрганизации.Вставить("КодНО", КодНалоговогоОргана);
	
	Доверенность = РегистрацияВНОСервер.ДанныеРегистрации(ЭлРегистрацияВИФНС).Доверенность;
	
	Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) И ЗначениеЗаполнено(Доверенность) Тогда
		ДоверенностьПредставителя = Доверенность;
		// признак подписания представителем
		СведенияОбОрганизации.Вставить("ПрПодп", 2);
		СведенияДоверенности = ПолучитьСведенияДоверенности(ЭлРегистрацияВИФНС, Организация,, Истина);
		Если СведенияДоверенности = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		СведенияОбОрганизации.Вставить("Доверенность", СведенияДоверенности);
	Иначе
		// признак подписания налогоплательщиком
		СведенияОбОрганизации.Вставить("ПрПодп", 1);
	КонецЕсли;
	
	Если ЭтоПБОЮЛ Тогда
		ФИОИП = ФИОИндивидуальногоПредпринимателя(Организация, СведенияОбОрганизации);
		Если ФИОИП = Неопределено Тогда
			СведенияОбОрганизации.Вставить("ИПФамилия", "");
			СведенияОбОрганизации.Вставить("ИПИмя", "");
			СведенияОбОрганизации.Вставить("ИПОтчество", "");
		Иначе
			СведенияОбОрганизации.Вставить("ИПФамилия", ФИОИП.Фамилия);
			СведенияОбОрганизации.Вставить("ИПИмя", ФИОИП.Имя);
			СведенияОбОрганизации.Вставить("ИПОтчество", ФИОИП.Отчество);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ЭлРегистрацияВИФНС) Тогда
			СведенияОбОрганизации.Вставить("КППЮЛ", СокрЛП(ЭлРегистрацияВИФНС.КПП));
		Иначе
			СведенияОбОрганизации.Вставить("КППЮЛ", СокрЛП(СведенияОбОрганизации.КППЮЛ));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СведенияОбОрганизации;
	
КонецФункции

#КонецОбласти

#Область ПодписьФайлаXMLDSig

Функция КанонизированныйУзелПодписьВBase64СПодставленнымХеш(
		КанонизированныйУзелПодписьВBase64,
		ХешСтрокаВBase64Ключа,
		ХешСтрокаВBase64,
		СконвертироватьИзШестнадцатеричногоПредставленияХеша,
		ДобавляемыеАтрибуты = Неопределено,
		НастройкиПодписи = Неопределено) Экспорт
		
	ИспользоватьПреобразованиеККаноническомуXML =
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ИспользоватьПреобразованиеККаноническомуXML", Ложь);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ИспользоватьВременноеХранилище = ЭтоАдресВременногоХранилища(КанонизированныйУзелПодписьВBase64);
	Если ИспользоватьВременноеХранилище Тогда
		ДвоичныеДанныеКанонизированныйУзелПодпись = ПолучитьИзВременногоХранилища(КанонизированныйУзелПодписьВBase64);
	Иначе
		ДвоичныеДанныеКанонизированныйУзелПодпись = Base64Значение(КанонизированныйУзелПодписьВBase64);
	КонецЕсли;
	ДвоичныеДанныеКанонизированныйУзелПодпись.Записать(ИмяВременногоФайла);
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла, "UTF-8");
	СтрокаКанонизированныйУзелПодпись = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	Если СконвертироватьИзШестнадцатеричногоПредставленияХеша Тогда
		Если ХешСтрокаВBase64Ключа <> Неопределено Тогда
			ХешСтрокаВBase64Ключа = СтрокаВШестнадцатеричномПредставленииВBase64(ХешСтрокаВBase64Ключа);
		КонецЕсли;
		
		ХешСтрокаВBase64 = СтрокаВШестнадцатеричномПредставленииВBase64(ХешСтрокаВBase64);
	КонецЕсли;
	
	Если ХешСтрокаВBase64Ключа <> Неопределено Тогда
		СтрокаКанонизированныйУзелПодпись = СтрЗаменить(СтрокаКанонизированныйУзелПодпись, "%KeyInfoDigestValue%", ХешСтрокаВBase64Ключа);
	КонецЕсли;
	СтрокаКанонизированныйУзелПодпись = СтрЗаменить(СтрокаКанонизированныйУзелПодпись, "%DigestValue%", ХешСтрокаВBase64);
	Если ДобавляемыеАтрибуты <> Неопределено Тогда
		Если ИспользоватьПреобразованиеККаноническомуXML Тогда
			СтрокаКанонизированныйУзелПодпись = СтрЗаменить(СтрокаКанонизированныйУзелПодпись,
				"<SignedInfo>",
				"<SignedInfo " + "xmlns=""http://www.w3.org/2000/09/xmldsig#"">");
		Иначе
			СтрокаКанонизированныйУзелПодпись = СтрЗаменить(СтрокаКанонизированныйУзелПодпись,
				"<SignedInfo>",
				"<SignedInfo " + ДобавляемыеАтрибуты + ">");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиПодписи <> Неопределено
		И НастройкиПодписи.Свойство("ХешСтрокаПодписанныхСвойствВBase64")
		И ЗначениеЗаполнено(НастройкиПодписи.ХешСтрокаПодписанныхСвойствВBase64) Тогда
		
		СтрокаКанонизированныйУзелПодпись = СтрЗаменить(СтрокаКанонизированныйУзелПодпись, "%SignedPropsDigestValue%",
			НастройкиПодписи.ХешСтрокаПодписанныхСвойствВBase64);
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, "utf-8");
	ЗаписьТекста.Записать(СтрокаКанонизированныйУзелПодпись);
	ЗаписьТекста.Закрыть();
	ДвоичныеДанныеСтрокиНаПодпись = Новый ДвоичныеДанные(ИмяВременногоФайла);
	СтрокаНаПодписьBase64 = Base64Строка(ДвоичныеДанныеСтрокиНаПодпись);
	// удалим из файла в кодировке "UTF-8" сигнатуру BOM
	СтрокаНаПодписьBase64 = Сред(СтрокаНаПодписьBase64, 5);
	
	Если ИспользоватьВременноеХранилище Тогда
		ДвоичныеДанныеСтрокиНаПодпись = Base64Значение(СтрокаНаПодписьBase64);
		СтрокаНаПодписьBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеСтрокиНаПодпись, Новый УникальныйИдентификатор);
	КонецЕсли;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	Возврат СтрокаНаПодписьBase64;
	
КонецФункции

Функция ПодписьИзПодписанныхДанныхBase64(ПодписанныеДанныеВBase64)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	ИспользоватьВременноеХранилище = ЭтоАдресВременногоХранилища(ПодписанныеДанныеВBase64);
	Если ИспользоватьВременноеХранилище Тогда
		ДвоичныеДанныеПодписанныхДанных = ПолучитьИзВременногоХранилища(ПодписанныеДанныеВBase64);
	Иначе
		ДвоичныеДанныеПодписанныхДанных = Base64Значение(ПодписанныеДанныеВBase64);
	КонецЕсли;
	ДвоичныеДанныеПодписанныхДанных.Записать(ИмяВременногоФайла);
	
	ИсходныйМассивБайтов = ПрочитатьФайлВМассив(ИмяВременногоФайла);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	МассивБайтов = Новый Массив;
	Для Инд = 1 По 64 Цикл
		ЗначениеБайта = ИсходныйМассивБайтов[ИсходныйМассивБайтов.ВГраница() + 1 - Инд];
		МассивБайтов.Добавить(ЗначениеБайта);
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЗаписатьФайлИзМассива(ИмяВременногоФайла, МассивБайтов);
	ДвоичныеДанныеПодпись = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	Если ИспользоватьВременноеХранилище Тогда
		ПодписьВBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеПодпись, Новый УникальныйИдентификатор);
	Иначе
		ПодписьВBase64 = Base64Строка(ДвоичныеДанныеПодпись);
	КонецЕсли;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	Возврат ПодписьВBase64;
	
КонецФункции

Функция АдресДанныхДляПодписиФайлаXML(
		СодержимоеФайлаXMLВBase64,
		АдресСодержимогоПодготовленногоФайлаXML = Неопределено,
		СертификатПолучателяВBase64 = Неопределено,
		Кодировка = Неопределено,
		НастройкиПодписи = Неопределено,
		Алгоритм = Неопределено) Экспорт
	
	Трансформация1_1 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "Трансформация1_1", Ложь);
	ВключатьХэшСертификата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ВключатьХэшСертификата", Ложь);
	НеВключатьЗаголовокXML = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"НеВключатьЗаголовокXML", Ложь);
	ЗаменаУзлаОбъекта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ЗаменаУзлаОбъекта", Неопределено);
	НормализацияОтключена = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"НормализацияОтключена", Ложь);
	ДанныеВнутриПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ДанныеВнутриПодписи", Ложь);
	ИдентификаторПодписываемыхДанных = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИдентификаторПодписываемыхДанных", Неопределено);
	ДобавляемыеАтрибуты = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДобавляемыеАтрибуты", Неопределено);
	НеВключатьИнформациюОСертификате = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"НеВключатьИнформациюОСертификате", Ложь);
	НеВключатьИнформациюОбОбъекте = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"НеВключатьИнформациюОбОбъекте", Ложь);
	ДополнительныеТрансформации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДополнительныеТрансформации", Неопределено);
	ДополнительныеОбратныеТрансформации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДополнительныеОбратныеТрансформации", Неопределено);
	ПереданХешВместоОбъекта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ПереданХешВместоОбъекта", Ложь);
	ИспользуетсяУзелТрансформации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИспользуетсяУзелТрансформации", Ложь);
	ЭтоИсключающаяКанонизация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ЭтоИсключающаяКанонизация", Ложь);
	ДополнитьПространстваИменУзлаПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДополнитьПространстваИменУзлаПодписи", Ложь);
	КанонизацияБезКомментариев = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"КанонизацияБезКомментариев", Ложь);
	ИспользоватьПреобразованиеККаноническомуXML = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИспользоватьПреобразованиеККаноническомуXML", Ложь);
	ТипКаноническогоXMLФайла = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ТипКаноническогоXML",
		?(КанонизацияБезКомментариев, "ИсключающийКаноническийXML", "ИсключающийКаноническийXMLСКомментариями"));
	ТипКаноническогоXMLФайла = ПредопределенноеЗначение("ТипКаноническогоXML." + ТипКаноническогоXMLФайла);
	ПрефиксПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ПрефиксПодписи", "");
	ДобавитьШтампВремени = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ДобавитьШтампВремени", Ложь);
	ТолькоСвойстваБезШтампаВремени = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ТолькоСвойстваБезШтампаВремени", Ложь);
	СертификатПодписанта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"СертификатПодписанта", Неопределено);
	ХешСертификата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ХешСертификата", Неопределено);
	УникальныйИдентификаторПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"УникальныйИдентификаторПодписи", Неопределено);
	ДополнительноеПространствоИмен = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДополнительноеПространствоИмен", Неопределено);
	ДополнениеОбъекта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ДополнениеОбъекта", Неопределено);
	СсылкаНаМЧД = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "СсылкаНаМЧД", Неопределено);
	ИННДоверителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи, "ИННДоверителя", Неопределено);
	ПодстрокаУзлаДляИнформацииОПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ПодстрокаУзлаДляИнформацииОПодписи", "");
	ИмяСобытияДляИнформацииОПодписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИмяСобытияДляИнформацииОПодписи", "");
	ИсключитьИдентификаторСсылкиРодителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиПодписи,
		"ИсключитьИдентификаторСсылкиРодителя", Ложь);
	
	ПрефиксПодписиИДвоеточие = ?(ЗначениеЗаполнено(ПрефиксПодписи), ПрефиксПодписи + ":", ПрефиксПодписи);
	ДвоеточиеИПрефиксПодписи = ?(ЗначениеЗаполнено(ПрефиксПодписи), ":" + ПрефиксПодписи, ПрефиксПодписи);
	
	ИспользоватьВременноеХранилище = ЭтоАдресВременногоХранилища(СодержимоеФайлаXMLВBase64);
	Если ИспользоватьВременноеХранилище Тогда
		ДвоичныеДанныеФайлаXML = ПолучитьИзВременногоХранилища(СодержимоеФайлаXMLВBase64);
	Иначе
		ДвоичныеДанныеФайлаXML = ДвоичныеДанныеИзСтроки64НаСервере(СодержимоеФайлаXMLВBase64);
	КонецЕсли;
	
	ДобавитьИнформациюОПодписи = ЗначениеЗаполнено(ПодстрокаУзлаДляИнформацииОПодписи);
	Если ДобавитьИнформациюОПодписи Тогда
		СтрокаФайлаXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайлаXML, "utf-8");
		
		ПозицияЗакрытияОсновногоУзла = СтрНайти(СтрокаФайлаXML, "</", НаправлениеПоиска.СКонца);
		Если ПозицияЗакрытияОсновногоУзла = 0 Тогда
			ДобавитьИнформациюОПодписи = Ложь;
			
		ИначеЕсли ПодстрокаУзлаДляИнформацииОПодписи <> "*" Тогда
			ЗакрытиеОсновногоУзла = Сред(СтрокаФайлаXML, ПозицияЗакрытияОсновногоУзла + 2);
			ДобавитьИнформациюОПодписи = СтрНайти(ЗакрытиеОсновногоУзла, ПодстрокаУзлаДляИнформацииОПодписи) <> 0;
		КонецЕсли;
		
		Если ДобавитьИнформациюОПодписи И ЗначениеЗаполнено(ИмяСобытияДляИнформацииОПодписи) Тогда
			ДобавитьИнформациюОПодписи = ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило(
				ИмяСобытияДляИнформацииОПодписи);
		КонецЕсли;
		
		Если ДобавитьИнформациюОПодписи Тогда
			ЗначениеСертификатПолучателяВBase64 = СтрЗаменить(СертификатПолучателяВBase64, Символы.ВК, "");
			ЗначениеСертификатПолучателяВBase64 = СтрЗаменить(ЗначениеСертификатПолучателяВBase64, Символы.ПС, "");
			ДанныеСертификатПолучателя = Base64Значение(ЗначениеСертификатПолучателяВBase64);
			
			Настройки = Новый Структура("ВозвращатьИсключения", Ложь);
			
			СвойстваСертификата = КриптографияЭДКОСлужебныйВызовСервера.ПолучитьСвойстваСертификата(ДанныеСертификатПолучателя,
				Настройки);
			
			ВладелецСертификата = КриптографияЭДКОКлиентСервер.РазобратьСтрокуСубъекта(СертификатПодписанта.Владелец);
			ПоставщикСертификата = КриптографияЭДКОКлиентСервер.РазобратьСтрокуСубъекта(СертификатПодписанта.Поставщик);
			
			ИдентификаторКлючаСубъекта = СтрЗаменить(СвойстваСертификата.ИдентификаторКлючаСубъекта, " ", "");
			ИдентификаторКлючаСубъекта = нрег(ИдентификаторКлючаСубъекта);
			
			ИмяВладельца = ВладелецСертификата["GN"];
			ОтчествоВладельца = "";
			ПозицияПробела = СтрНайти(ИмяВладельца, " ");
			Если ПозицияПробела <> 0 Тогда
				ОтчествоВладельца = Сред(ИмяВладельца, ПозицияПробела + 1);
				ИмяВладельца = Лев(ИмяВладельца, ПозицияПробела - 1);
			КонецЕсли;
			
			ТекстИнформацииОПодписи =
				"	<sig:SignInfo>" + ?(ЗначениеЗаполнено(ВладелецСертификата["O"]), "
				|		<sig:Name>" + ТекстВHTML(ВладелецСертификата["O"], Истина) + "</sig:Name>", "") + "
				|		<sig:Owner>
				|			<sig:Surname>" + ТекстВHTML(ВладелецСертификата["SN"], Истина) + "</sig:Surname>
				|			<sig:Name>" + ТекстВHTML(ИмяВладельца, Истина) + "</sig:Name>" + ?(ЗначениеЗаполнено(ОтчествоВладельца), "
				|			<sig:Patronymic>" + ТекстВHTML(ОтчествоВладельца, Истина) + "</sig:Patronymic>", "") + "
				|		</sig:Owner>
				|		<sig:Issuer>" + ТекстВHTML(ПоставщикСертификата["CN"], Истина) + "</sig:Issuer>
				|		<sig:CertID>" + ТекстВHTML(ИдентификаторКлючаСубъекта, Истина) + "</sig:CertID>
				|		<sig:CertValid>
				|			<sig:From>" + Формат(СертификатПодписанта.ДействителенС, "ДФ=гггг-ММ-дд") + "</sig:From>
				|			<sig:To>" + Формат(СертификатПодписанта.ДействителенПо, "ДФ=гггг-ММ-дд") + "</sig:To>
				|		</sig:CertValid>" + ?(ЗначениеЗаполнено(СвойстваСертификата.КлючДействителенС)
							И ЗначениеЗаполнено(СвойстваСертификата.КлючДействителенПо), "
				|		<sig:PrivateKeyValid>
				|			<sig:From>" + Формат(СвойстваСертификата.КлючДействителенС, "ДФ=гггг-ММ-дд") + "</sig:From>
				|			<sig:To>" + Формат(СвойстваСертификата.КлючДействителенПо, "ДФ=гггг-ММ-дд") + "</sig:To>
				|		</sig:PrivateKeyValid>", "") + "
				|	</sig:SignInfo>
				|";
			
			СтрокаФайлаXML = Лев(СтрокаФайлаXML, ПозицияЗакрытияОсновногоУзла - 1) + ТекстИнформацииОПодписи
				+ Сред(СтрокаФайлаXML, ПозицияЗакрытияОсновногоУзла);
			
			ПозицияЗавершенияЗаголовка = СтрНайти(СтрокаФайлаXML, "?>");
			ПозицияОсновногоУзла = СтрНайти(СтрокаФайлаXML, "<",, ПозицияЗавершенияЗаголовка + 1);
			ПозицияОкончанияОсновногоУзла = СтрНайти(СтрокаФайлаXML, ">",, ПозицияОсновногоУзла + 1);
			
			АтрибутыОсновногоУзла = Сред(СтрокаФайлаXML, ПозицияОсновногоУзла + 1, ПозицияОкончанияОсновногоУзла - ПозицияОсновногоУзла - 1);
			
			ПространствоИменИнформацииОПодписи = " xmlns:sig=""http://iis.ecp.ru/SignInfo/2023-01-10""";
			Если СтрНайти(АтрибутыОсновногоУзла, ПространствоИменИнформацииОПодписи) = 0 Тогда
				ПозицияПробелаОсновногоУзла = СтрНайти(СтрокаФайлаXML, " ",, ПозицияОсновногоУзла + 1);
				Если ПозицияПробелаОсновногоУзла <> 0 Тогда
					СтрокаФайлаXML = Лев(СтрокаФайлаXML, ПозицияПробелаОсновногоУзла - 1) + ПространствоИменИнформацииОПодписи
						+ Сред(СтрокаФайлаXML, ПозицияПробелаОсновногоУзла);
				КонецЕсли;
			КонецЕсли;
			
			ДвоичныеДанныеФайлаXML = ПолучитьДвоичныеДанныеИзСтроки(СтрокаФайлаXML, "utf-8");
		КонецЕсли;
	КонецЕсли;
	
	ПодписываемыйФайлXML = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайлаXML.Записать(ПодписываемыйФайлXML);
	
	Если ИспользоватьПреобразованиеККаноническомуXML Тогда
		
		// Для каноникализации используется объект ПреобразованиеККаноническомуXML.
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ПодписываемыйФайлXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
		
		КанонизированныйПодписываемыйФайлXML = ФайлПреобразованиеККаноническомуXML(ДокументDOM, ТипКаноническогоXMLФайла);
		
	Иначе
		
		// Для каноникализации используется объект КаноническийDOM, при этом xml предвательно адаптируется.
		ПрефиксыПространствИмен = Неопределено;
		ПрефиксОбхода = Неопределено;
		Если Кодировка <> Неопределено ИЛИ Трансформация1_1 ИЛИ ВключатьХэшСертификата
			ИЛИ ДополнитьПространстваИменУзлаПодписи Тогда
			
			ИсходнаяКодировка = ?(Кодировка <> Неопределено, "windows-1251", "utf-8");
			ЧтениеФайлаXML = Новый ЧтениеТекста(ПодписываемыйФайлXML, ИсходнаяКодировка);
			СодержимоеФайлаXML = ЧтениеФайлаXML.Прочитать();
			СодержимоеФайлаXMLБезЗамен = СодержимоеФайлаXML;
			СодержимоеФайлаXMLБезДополнительныхТрансформаций = СодержимоеФайлаXML;
			ЧтениеФайлаXML.Закрыть();
			
			Если Кодировка <> Неопределено ИЛИ Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи Тогда
				Если Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи Тогда
					// преобразования обхода ошибки канонизации платформы
					ПрефиксыПространствИмен = Новый Массив;
					ТекстXML = СодержимоеФайлаXML;
					Пока ЗначениеЗаполнено(ТекстXML) Цикл
						ПозицияПослеПостфикса = 0;
						ПрефиксПространстваИмен = ТекстПослеПрефикса(ТекстXML, " xmlns:", "=", ПозицияПослеПостфикса);
						Если ЗначениеЗаполнено(ПрефиксПространстваИмен) И ПрефиксыПространствИмен.Найти(ПрефиксПространстваИмен) = Неопределено Тогда
							ПрефиксыПространствИмен.Добавить(ПрефиксПространстваИмен);
						КонецЕсли;
						ТекстXML = Сред(ТекстXML, ПозицияПослеПостфикса);
					КонецЦикла;
					
					ПрефиксОбхода = "EQERLRLQKE";
					СодержимоеФайлаXML = СтрЗаменить(СодержимоеФайлаXML, " xmlns=""", " xmlns=""" + ПрефиксОбхода);
					Для каждого ПрефиксПространстваИмен Из ПрефиксыПространствИмен Цикл
						СодержимоеФайлаXML = СтрЗаменить(СодержимоеФайлаXML, " xmlns:" + ПрефиксПространстваИмен + "=""",
							" xmlns:" + ПрефиксПространстваИмен + "=""" + ПрефиксОбхода);
					КонецЦикла;
					
					СодержимоеФайлаXMLБезДополнительныхТрансформаций = СодержимоеФайлаXML;
					Если ДополнительныеТрансформации <> Неопределено Тогда
						ИндексТрансформации = 0;
						Пока ИндексТрансформации < ДополнительныеТрансформации.Количество() Цикл
							СодержимоеФайлаXML = СтрЗаменить(СодержимоеФайлаXML, ДополнительныеТрансформации[ИндексТрансформации],
								ДополнительныеТрансформации[ИндексТрансформации + 1]);
							ИндексТрансформации = ИндексТрансформации + 2;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				Кодировка = ?(Кодировка <> Неопределено, Кодировка, ИсходнаяКодировка);
				ПерекодированныйФайлXML = ПолучитьИмяВременногоФайла();
				ЗаписьФайлаXML = Новый ЗаписьТекста(ПерекодированныйФайлXML, Кодировка);
				ЗаписьФайлаXML.Записать(СодержимоеФайлаXML);
				ЗаписьФайлаXML.Закрыть();
				
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ПодписываемыйФайлXML);
				ПодписываемыйФайлXML = ПерекодированныйФайлXML;
			КонецЕсли;
		КонецЕсли;
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ПодписываемыйФайлXML);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
		
		Если ДополнитьПространстваИменУзлаПодписи И НЕ ЭтоИсключающаяКанонизация Тогда
			ПространстваИменКорневогоУзла = Новый СписокЗначений;
			КорневыеУзлы = ДокументDOM.ДочерниеУзлы;
			Если КорневыеУзлы.Количество() > 0 Тогда
				Для каждого АтрибутКорневогоУзла Из КорневыеУзлы[0].Атрибуты Цикл
					Если АтрибутКорневогоУзла.Префикс = "xmlns" И ЗначениеЗаполнено(АтрибутКорневогоУзла.ЛокальноеИмя) Тогда
						ПространстваИменКорневогоУзла.Добавить(АтрибутКорневогоУзла.ЛокальноеИмя, АтрибутКорневогоУзла.Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ПространстваИменКорневогоУзла.СортироватьПоЗначению();
		КонецЕсли;
		
		НастройкиКонвертации = Новый Структура;
		НастройкиКонвертации.Вставить("ПрефиксОбхода", 					ПрефиксОбхода);
		НастройкиКонвертации.Вставить("ПрефиксыПространствИмен", 		ПрефиксыПространствИмен);
		НастройкиКонвертации.Вставить("ПространствоИменПоУмолчанию", 	Неопределено);
		КанонизированныйПодписываемыйФайлXML = ФайлКанонизированныйУзелDOM(
			ДокументDOM,,,
			Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи,
			Трансформация1_1 И НЕ НормализацияОтключена,
			ДополнительныеОбратныеТрансформации,
			НастройкиКонвертации);
			
	КонецЕсли;
		
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		ЧтениеФайлаXML = Новый ЧтениеТекста(КанонизированныйПодписываемыйФайлXML, "windows-1251");
		СодержимоеКанонизированногоФайлаXML = ЧтениеФайлаXML.Прочитать();
		ЧтениеФайлаXML.Закрыть();
		ТекстТелаЗапросаИсходный = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайлаXML);
		СодержимоеКанонизированногоФайлаXML = ИсправитьОшибкиВТелеЗапросаПриНеобходимости(
			СодержимоеКанонизированногоФайлаXML, ТекстТелаЗапросаИсходный);
		КанонизированныйФайлXMLВBase64 = Неопределено;
		
	Иначе
		Если ИспользоватьВременноеХранилище Тогда
			ДвоичныеДанныеКанонизированногоФайлаXML = Новый ДвоичныеДанные(КанонизированныйПодписываемыйФайлXML);
			КанонизированныйФайлXMLВBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКанонизированногоФайлаXML, Новый УникальныйИдентификатор);
		Иначе
			КанонизированныйФайлXMLВBase64 = ПрочитатьBase64ИзФайла(КанонизированныйПодписываемыйФайлXML);
		КонецЕсли;
	КонецЕсли;
	
	// Добавляем в документ DOM узел для описания ЭЦП
	КорневойУзел = ДокументDOM.ДочерниеУзлы[0]; //report
	
	ПространствоИменXMLNS = "http://www.w3.org/2000/xmlns/";
	ПространствоИменXMLDSig = "http://www.w3.org/2000/09/xmldsig#";
	ПространствоИменXAdES = "http://uri.etsi.org/01903/v1.3.2#";
	ПространствоИменXAdES141 = "http://uri.etsi.org/01903/v1.4.1#";
	
	УзелИнформацииОПодписи = Неопределено;
	Если ДобавитьИнформациюОПодписи Тогда
		КоличествоДочернихУзлов = КорневойУзел.ДочерниеУзлы.Количество();
		УзелИнформацииОПодписи = КорневойУзел.ДочерниеУзлы[КоличествоДочернихУзлов - 1];
	КонецЕсли;
	УзелПодпись = СоздатьИДобавитьДочернийЭлемент(
		КорневойУзел,
		ПространствоИменXMLDSig,
		ПрефиксПодписи,
		"Signature",
		УзелИнформацииОПодписи);
	
	УзелПодписьИнфо = СоздатьИДобавитьДочернийЭлемент(УзелПодпись,, ПрефиксПодписи, "SignedInfo");
	
	УзелМетодКанонизации = СоздатьИДобавитьДочернийЭлемент(УзелПодписьИнфо,, ПрефиксПодписи, "CanonicalizationMethod");
	УзелМетодПодписи = СоздатьИДобавитьДочернийЭлемент(УзелПодписьИнфо,, ПрефиксПодписи, "SignatureMethod");
	Если ВключатьХэшСертификата Тогда
		УзелСсылкаКлюч = СоздатьИДобавитьДочернийЭлемент(УзелПодписьИнфо,, ПрефиксПодписи, "Reference");
	КонецЕсли;
	УзелСсылка = СоздатьИДобавитьДочернийЭлемент(УзелПодписьИнфо,, ПрефиксПодписи, "Reference");
	
	Если НЕ Трансформация1_1 ИЛИ НЕ НормализацияОтключена ИЛИ ИспользуетсяУзелТрансформации Тогда
		Если ВключатьХэшСертификата Тогда
			УзелПреобразованияКлюч = СоздатьИДобавитьДочернийЭлемент(УзелСсылкаКлюч,, ПрефиксПодписи, "Transforms");
		КонецЕсли;
		УзелПреобразования = СоздатьИДобавитьДочернийЭлемент(УзелСсылка,, ПрефиксПодписи, "Transforms");
		
		Если ВключатьХэшСертификата Тогда
			Если Трансформация1_1 И НЕ ИспользуетсяУзелТрансформации Тогда
				УзелПреобразование2Ключ = СоздатьИДобавитьДочернийЭлемент(УзелПреобразованияКлюч,, ПрефиксПодписи, "Transform");
			Иначе
				Если НЕ ИспользуетсяУзелТрансформации Тогда
					УзелПреобразование1Ключ = СоздатьИДобавитьДочернийЭлемент(УзелПреобразованияКлюч,, ПрефиксПодписи, "Transform");
				КонецЕсли;
				УзелПреобразование2Ключ = СоздатьИДобавитьДочернийЭлемент(УзелПреобразованияКлюч,, ПрефиксПодписи, "Transform");
			КонецЕсли;
		КонецЕсли;
		Если Трансформация1_1 И НЕ ИспользуетсяУзелТрансформации Тогда
			УзелПреобразование2 = СоздатьИДобавитьДочернийЭлемент(УзелПреобразования,, ПрефиксПодписи, "Transform");
		Иначе
			Если НЕ ИспользуетсяУзелТрансформации Тогда
				УзелПреобразование1 = СоздатьИДобавитьДочернийЭлемент(УзелПреобразования,, ПрефиксПодписи, "Transform");
			КонецЕсли;
			Если НЕ КанонизацияБезКомментариев Тогда
				УзелПреобразование2 = СоздатьИДобавитьДочернийЭлемент(УзелПреобразования,, ПрефиксПодписи, "Transform");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ВключатьХэшСертификата Тогда
		УзелМетодХэшированияКлюч = СоздатьИДобавитьДочернийЭлемент(УзелСсылкаКлюч,, ПрефиксПодписи, "DigestMethod");
		УзелРезультатХэшированияКлюч = СоздатьИДобавитьДочернийЭлемент(УзелСсылкаКлюч,, ПрефиксПодписи, "DigestValue");
	КонецЕсли;
	УзелМетодХэширования = СоздатьИДобавитьДочернийЭлемент(УзелСсылка,, ПрефиксПодписи, "DigestMethod");
	УзелРезультатХэширования = СоздатьИДобавитьДочернийЭлемент(УзелСсылка,, ПрефиксПодписи, "DigestValue");
	
	УзелРезультатПодписания = СоздатьИДобавитьДочернийЭлемент(УзелПодпись,, ПрефиксПодписи, "SignatureValue");
	Если НЕ НеВключатьИнформациюОСертификате Тогда
		УзелИнформацияОКлючах = СоздатьИДобавитьДочернийЭлемент(УзелПодпись,, ПрефиксПодписи, "KeyInfo");
	КонецЕсли;
	Если (ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи) И НЕ НеВключатьИнформациюОбОбъекте Тогда
		УзелИнформацияОбОбъекте = СоздатьИДобавитьДочернийЭлемент(УзелПодпись,, ПрефиксПодписи, "Object");
	КонецЕсли;
	
	Если НЕ НеВключатьИнформациюОСертификате Тогда
		Если СсылкаНаМЧД <> Неопределено Тогда
			Если ТипЗнч(СсылкаНаМЧД) = Тип("Строка") Тогда
				НомерДоверенности = СсылкаНаМЧД;
			Иначе
				НомерДоверенности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаМЧД, "НомерДоверенности");
			КонецЕсли;
			УзелMCDId = СоздатьИДобавитьДочернийЭлемент(УзелИнформацияОКлючах,, ПрефиксПодписи, "MCDId");
			УзелINNPrincipal = СоздатьИДобавитьДочернийЭлемент(УзелИнформацияОКлючах,, ПрефиксПодписи, "INNPrincipal");
			УзелMCDId.ТекстовоеСодержимое = НомерДоверенности;
			УзелINNPrincipal.ТекстовоеСодержимое = ИННДоверителя;
		КонецЕсли;
		УзелДанныеX509 = СоздатьИДобавитьДочернийЭлемент(УзелИнформацияОКлючах,, ПрефиксПодписи, "X509Data");
		УзелСертификатX509 = СоздатьИДобавитьДочернийЭлемент(УзелДанныеX509,, ПрефиксПодписи, "X509Certificate");
	КонецЕсли;
	
	АлгоритмКанонизацииДляУзловТрансформации = ?(ЭтоИсключающаяКанонизация,
		"http://www.w3.org/2001/10/xml-exc-c14n#" + ?(КанонизацияБезКомментариев, "", 
			?(ТипКаноническогоXMLФайла = ТипКаноническогоXML.ИсключающийКаноническийXML, "", "WithComments")),
		"http://www.w3.org/TR/2001/REC-xml-c14n-20010315");
	АлгоритмКанонизации = АлгоритмКанонизацииДляУзловТрансформации + ?(ЭтоИсключающаяКанонизация, "",
		"#" + ?(КанонизацияБезКомментариев, "",
			?(ТипКаноническогоXMLФайла = ТипКаноническогоXML.ИсключающийКаноническийXML, "", "WithComments")));
	
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		Если ВключатьХэшСертификата Тогда
			УзелСсылкаКлюч.УстановитьАтрибут("URI", "#KeyInfo");
		КонецЕсли;
		УзелСсылка.УстановитьАтрибут("URI", "#" + ?(ИдентификаторПодписываемыхДанных = Неопределено, "Object", ИдентификаторПодписываемыхДанных));
		
	Иначе
		Если ЗначениеЗаполнено(УникальныйИдентификаторПодписи) И НЕ ИсключитьИдентификаторСсылкиРодителя Тогда
			УзелСсылка.УстановитьАтрибут("Id", "xmldsig-" + УникальныйИдентификаторПодписи + "-ref0");
		КонецЕсли;
		УзелСсылка.УстановитьАтрибут("URI", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УникальныйИдентификаторПодписи) Тогда
		УзелПодпись.УстановитьАтрибут("Id", "xmldsig-" + УникальныйИдентификаторПодписи);
	КонецЕсли;
	АлгоритмПодписи = ?(Алгоритм = "GOST R 34.10-2012-256", "urn:ietf:params:xml:ns:cpxmlsec:algorithms:gostr34102012-gostr34112012-256",
					  ?(Алгоритм = "GOST R 34.10-2012-512", "urn:ietf:params:xml:ns:cpxmlsec:algorithms:gostr34102012-gostr34112012-512",
															"http://www.w3.org/2001/04/xmldsig-more#gostr34102001-gostr3411"));
	УзелМетодПодписи.УстановитьАтрибут("Algorithm", АлгоритмПодписи);
	Если Трансформация1_1 Тогда
		УзелМетодКанонизации.УстановитьАтрибут("Algorithm", ?(НЕ НормализацияОтключена, "urn:xml-dsig:transformation:v1.1",
			АлгоритмКанонизации));
	Иначе
		УзелМетодКанонизации.УстановитьАтрибут("Algorithm", АлгоритмКанонизацииДляУзловТрансформации);
	КонецЕсли;
	Если НЕ Трансформация1_1 ИЛИ НЕ НормализацияОтключена ИЛИ ИспользуетсяУзелТрансформации Тогда
		Если ВключатьХэшСертификата Тогда
			Если Трансформация1_1 И НЕ ИспользуетсяУзелТрансформации Тогда
				УзелПреобразование2Ключ.УстановитьАтрибут("Algorithm", "urn:xml-dsig:transformation:v1.1");
			Иначе
				Если НЕ ИспользуетсяУзелТрансформации Тогда
					УзелПреобразование1Ключ.УстановитьАтрибут("Algorithm", "http://www.w3.org/2000/09/xmldsig#enveloped-signature");
				КонецЕсли;
				УзелПреобразование2Ключ.УстановитьАтрибут("Algorithm", АлгоритмКанонизацииДляУзловТрансформации);
			КонецЕсли;
		КонецЕсли;
		Если Трансформация1_1 И НЕ ИспользуетсяУзелТрансформации Тогда
			УзелПреобразование2.УстановитьАтрибут("Algorithm", "urn:xml-dsig:transformation:v1.1");
		Иначе
			Если НЕ ИспользуетсяУзелТрансформации Тогда
				УзелПреобразование1.УстановитьАтрибут("Algorithm", "http://www.w3.org/2000/09/xmldsig#enveloped-signature");
			КонецЕсли;
			Если НЕ КанонизацияБезКомментариев Тогда
				УзелПреобразование2.УстановитьАтрибут("Algorithm", АлгоритмКанонизацииДляУзловТрансформации);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	АлгоритмХеша = ?(Алгоритм = "GOST R 34.10-2012-256", "urn:ietf:params:xml:ns:cpxmlsec:algorithms:gostr34112012-256",
				   ?(Алгоритм = "GOST R 34.10-2012-512", "urn:ietf:params:xml:ns:cpxmlsec:algorithms:gostr34112012-512",
														 "http://www.w3.org/2001/04/xmldsig-more#gostr3411"));
	Если ВключатьХэшСертификата Тогда
		УзелМетодХэшированияКлюч.УстановитьАтрибут("Algorithm", АлгоритмХеша);
	КонецЕсли;
	УзелМетодХэширования.УстановитьАтрибут("Algorithm", АлгоритмХеша);
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		Если ВключатьХэшСертификата И НЕ НеВключатьИнформациюОСертификате Тогда
			УзелИнформацияОКлючах.УстановитьАтрибут("Id", "KeyInfo");
		КонецЕсли;
		Если НЕ НеВключатьИнформациюОбОбъекте Тогда
			УзелИнформацияОбОбъекте.УстановитьАтрибут("Id", ?(ИдентификаторПодписываемыхДанных = Неопределено, "Object", ИдентификаторПодписываемыхДанных));
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(УникальныйИдентификаторПодписи) Тогда
		УзелРезультатПодписания.УстановитьАтрибут("Id", "xmldsig-" + УникальныйИдентификаторПодписи + "-sigvalue");
	КонецЕсли;
	
	Если ВключатьХэшСертификата Тогда
		УзелРезультатХэшированияКлюч.ТекстовоеСодержимое = "%KeyInfoDigestValue%";
	КонецЕсли;
	Если ПереданХешВместоОбъекта Тогда
		УзелРезультатХэширования.ТекстовоеСодержимое = ТекстПослеПрефикса(СодержимоеФайлаXMLБезЗамен,
			"<Object xmlns=""" + ПространствоИменXMLDSig + """ Id=""Object"">", "</Object>");
	Иначе
		УзелРезультатХэширования.ТекстовоеСодержимое = "%DigestValue%";
	КонецЕсли;
	УзелРезультатПодписания.ТекстовоеСодержимое = "%SignatureValue%";
	Если НЕ НеВключатьИнформациюОСертификате Тогда
		ЗначениеСертификатПолучателяВBase64 = СтрЗаменить(СертификатПолучателяВBase64, Символы.ВК, "");
		УзелСертификатX509.ТекстовоеСодержимое = СтрЗаменить(ЗначениеСертификатПолучателяВBase64, Символы.ПС, "");
	КонецЕсли;
	Если (ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи) И НЕ НеВключатьИнформациюОбОбъекте Тогда
		УзелИнформацияОбОбъекте.ТекстовоеСодержимое = "%SigningXML%";
	КонецЕсли;
	
	Если ИспользоватьПреобразованиеККаноническомуXML И ДобавитьШтампВремени Тогда
		УзелСсылкаПодписанныеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелПодписьИнфо,, ПрефиксПодписи, "Reference");
		УзелСсылкаПодписанныеСвойства.УстановитьАтрибут("URI", "#xmldsig-" + УникальныйИдентификаторПодписи + "-signedprops");
		УзелСсылкаПодписанныеСвойства.УстановитьАтрибут("Type", "http://uri.etsi.org/01903#SignedProperties");
		
		УзелМетодХэшированияПодписанныеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелСсылкаПодписанныеСвойства,,
			ПрефиксПодписи, "DigestMethod");
		УзелМетодХэшированияПодписанныеСвойства.УстановитьАтрибут("Algorithm", АлгоритмХеша);
		
		УзелРезультатХэшированияПодписанныеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелСсылкаПодписанныеСвойства,,
			ПрефиксПодписи, "DigestValue");
		УзелРезультатХэшированияПодписанныеСвойства.ТекстовоеСодержимое = "%SignedPropsDigestValue%";
		
		УзелОбъектКвалифицирующихСвойств = СоздатьИДобавитьДочернийЭлемент(УзелПодпись,, ПрефиксПодписи, "Object");
		
		УзелКвалифицирующиеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелОбъектКвалифицирующихСвойств,
			ПространствоИменXAdES, "xades", "QualifyingProperties");
		УзелКвалифицирующиеСвойства.УстановитьАтрибут(ПространствоИменXMLNS,
			"xmlns:xades141", "http://uri.etsi.org/01903/v1.4.1#");
		Если ЗначениеЗаполнено(УникальныйИдентификаторПодписи) Тогда
			УзелКвалифицирующиеСвойства.УстановитьАтрибут("Target", "#xmldsig-" + УникальныйИдентификаторПодписи);
		КонецЕсли;
		
		УзелПодписанныеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелКвалифицирующиеСвойства,, "xades", "SignedProperties");
		Если ЗначениеЗаполнено(УникальныйИдентификаторПодписи) Тогда
			УзелПодписанныеСвойства.УстановитьАтрибут("Id", "xmldsig-" + УникальныйИдентификаторПодписи + "-signedprops");
		КонецЕсли;
		
		УзелПодписанныеСвойстваПодписи = СоздатьИДобавитьДочернийЭлемент(УзелПодписанныеСвойства,,
			"xades", "SignedSignatureProperties");
		
		УзелВремяПодписи = СоздатьИДобавитьДочернийЭлемент(УзелПодписанныеСвойстваПодписи,, "xades", "SigningTime");
		// дата вида "2022-02-09T19:32:50.000+03:00"
		ДатаСеанса = ТекущаяДатаСеанса();
		ПоясСеанса = ЧасовойПоясСеанса();
		СмещениеВремени = СмещениеСтандартногоВремени(ПоясСеанса, ДатаСеанса);
		ЭтоНеотрицательноеСмещение = СмещениеВремени >= 0;
		СмещениеВремени = ?(ЭтоНеотрицательноеСмещение, СмещениеВремени, -СмещениеВремени);
		СмещениеВремениВМинутах = Окр(СмещениеВремени / 60);
		ЧасыСмещенияВремени = Цел(СмещениеВремениВМинутах / 60);
		МинутыСмещенияВремени = СмещениеВремениВМинутах % 60;
		ДатаСоСмещением = Формат(ДатаСеанса, "ДФ='гггг-ММ-ддTЧЧ:мм:сс.000'")
			+ ?(ЭтоНеотрицательноеСмещение, "+", "-") + Формат(ЧасыСмещенияВремени, "ЧЦ=2; ЧВН=; ЧДЦ=; ЧН=; ЧГ=")
			+ ":" + Формат(МинутыСмещенияВремени, "ЧЦ=2; ЧВН=; ЧДЦ=; ЧН=; ЧГ=");
		УзелВремяПодписи.ТекстовоеСодержимое = ДатаСоСмещением;
		
		УзелПодписываемыйСертификат = СоздатьИДобавитьДочернийЭлемент(УзелПодписанныеСвойстваПодписи,,
			"xades", "SigningCertificate");
		
		УзелСертификат = СоздатьИДобавитьДочернийЭлемент(УзелПодписываемыйСертификат,, "xades", "Cert");
		
		УзелХешСертификата = СоздатьИДобавитьДочернийЭлемент(УзелСертификат,, "xades", "CertDigest");
		
		УзелМетодХешированияСертификата = СоздатьИДобавитьДочернийЭлемент(УзелХешСертификата,,
			ПрефиксПодписи, "DigestMethod");
		УзелМетодХешированияСертификата.УстановитьАтрибут("Algorithm", АлгоритмХеша);
		
		УзелЗначениеХешаСертификата = СоздатьИДобавитьДочернийЭлемент(УзелХешСертификата,, ПрефиксПодписи, "DigestValue");
		ДанныеХешаСертификата = ПолучитьДвоичныеДанныеИзHexСтроки(ХешСертификата);
		Сертификат64 = Base64Строка(ДанныеХешаСертификата);
		Сертификат64 = СтрЗаменить(Сертификат64, Символы.ВК, "");
		Сертификат64 = СтрЗаменить(Сертификат64, Символы.ПС, "");
		УзелЗначениеХешаСертификата.ТекстовоеСодержимое = Сертификат64;
		
		УзелПоставщикСерийныйНомер = СоздатьИДобавитьДочернийЭлемент(УзелСертификат,, "xades", "IssuerSerial");
		
		УзелПоставщик = СоздатьИДобавитьДочернийЭлемент(УзелПоставщикСерийныйНомер,, ПрефиксПодписи, "X509IssuerName");
		УзелПоставщик.ТекстовоеСодержимое = КриптографияЭДКОСлужебныйВызовСервера.ПоставщикДляXAdES(
			СертификатПодписанта.Поставщик, СертификатПолучателяВBase64);
		
		УзелСерийныйНомер = СоздатьИДобавитьДочернийЭлемент(УзелПоставщикСерийныйНомер,, ПрефиксПодписи, "X509SerialNumber");
		СерийныйНомерЧислом = ЧислоИзШестнадцатеричногоПредставления(СертификатПодписанта.СерийныйНомер);
		УзелСерийныйНомер.ТекстовоеСодержимое = Формат(СерийныйНомерЧислом, "ЧДЦ=; ЧН=; ЧГ=");
		
		Если НЕ ТолькоСвойстваБезШтампаВремени Тогда
			УзелНеподписанныеСвойства = СоздатьИДобавитьДочернийЭлемент(УзелКвалифицирующиеСвойства,,
				"xades", "UnsignedProperties");
			
			УзелНеподписанныеСвойстваПодписи = СоздатьИДобавитьДочернийЭлемент(УзелНеподписанныеСвойства,,
				"xades", "UnsignedSignatureProperties");
			
			УзелШтампВремениПодписи = СоздатьИДобавитьДочернийЭлемент(УзелНеподписанныеСвойстваПодписи,,
				"xades", "SignatureTimeStamp");
			
			УзелМетодКанонизацииДляШтампа = СоздатьИДобавитьДочернийЭлемент(УзелШтампВремениПодписи,,
				ПрефиксПодписи, "CanonicalizationMethod");
			УзелМетодКанонизацииДляШтампа.УстановитьАтрибут("Algorithm", АлгоритмКанонизацииДляУзловТрансформации);
			
			УзелДанныеШтампаВремени = СоздатьИДобавитьДочернийЭлемент(УзелШтампВремениПодписи,,
				"xades", "EncapsulatedTimeStamp");
			УзелДанныеШтампаВремени.ТекстовоеСодержимое = "%TimeStamp%";
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.Отступ = Ложь;
	Если НЕ НеВключатьЗаголовокXML Тогда
		ЗаписьXML.УстановитьСтроку("utf-8");
	Иначе
		ЗаписьXML.УстановитьСтроку("windows-1251");
	КонецЕсли;
	ЗаписьDOM = Новый ЗаписьDOM;
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		ЗаписьDOM.Записать(УзелПодпись, ЗаписьXML);
	Иначе
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	КонецЕсли;
	
	ТекстовоеСодержимоеФайлаXML = ЗаписьXML.Закрыть();
	Если ЗначениеЗаполнено(ДополнениеОбъекта) Тогда
		ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, "</xades:QualifyingProperties>",
			"</xades:QualifyingProperties>" + ДополнениеОбъекта);
	КонецЕсли;
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		Если ЗаменаУзлаОбъекта <> Неопределено ИЛИ ПереданХешВместоОбъекта Тогда
			ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, "<Object Id=""" + ?(ИдентификаторПодписываемыхДанных = Неопределено,
				"Object", ИдентификаторПодписываемыхДанных) + """>%SigningXML%</Object>",
				?(ЗаменаУзлаОбъекта <> Неопределено, ЗаменаУзлаОбъекта, "<Object xmlns=""" + ПространствоИменXMLDSig + """ Id="""
				+ ?(ИдентификаторПодписываемыхДанных = Неопределено, "Object", ИдентификаторПодписываемыхДанных) + """/>"));
		Иначе
			ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, "%SigningXML%", СодержимоеФайлаXMLБезДополнительныхТрансформаций);
			ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, Символы.ВК, "");
		КонецЕсли;
	КонецЕсли;
	Если (Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи) И ПрефиксыПространствИмен <> Неопределено Тогда
		// обратные преобразования обхода ошибки канонизации
		Для ИндексЭлемента = 0 По ПрефиксыПространствИмен.Количество() - 1 Цикл
			ПрефиксПространстваИмен = ПрефиксыПространствИмен[ПрефиксыПространствИмен.Количество() - 1 - ИндексЭлемента];
			ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML,
				" xmlns:" + ПрефиксПространстваИмен + "=""" + ПрефиксОбхода, " xmlns:" + ПрефиксПространстваИмен + "=""");
			ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML,
				" :" + ПрефиксПространстваИмен + "=""" + ПрефиксОбхода, " xmlns:" + ПрефиксПространстваИмен + "="""); // обход ошибки платформы
		КонецЦикла;
		
		ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, " xmlns=""" + ПрефиксОбхода, " xmlns=""");
		ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, " =""" + ПрефиксОбхода, " xmlns="""); // обход ошибки платформы
		ТекстовоеСодержимоеФайлаXML = СтрЗаменить(ТекстовоеСодержимоеФайлаXML, " ="""">", ">"); // обход ошибки платформы
	КонецЕсли;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ПодписываемыйФайлXML);
	
	АдресСодержимогоПодготовленногоФайлаXML = ПоместитьВоВременноеХранилище(ТекстовоеСодержимоеФайлаXML, Новый УникальныйИдентификатор);
	
	ПространствоИменПоУмолчанию = Неопределено;
	Если ДобавляемыеАтрибуты = Неопределено Тогда
		Если ДополнитьПространстваИменУзлаПодписи И НЕ ЭтоИсключающаяКанонизация
			И ПространстваИменКорневогоУзла.Количество() > 0 Тогда
			
			// обход ошибки платформы сортировки пространств имен при канонизации дочернего узла
			ПространствоИменПоУмолчанию = "AAAAAAAAAA";
			Пока ПространстваИменКорневогоУзла.НайтиПоЗначению(ПространствоИменПоУмолчанию) <> Неопределено Цикл
				ПространствоИменПоУмолчанию = ПространствоИменПоУмолчанию + "A";
			КонецЦикла;
			УзелПодписьИнфо.УстановитьСоответствиеПространстваИмен(ПространствоИменПоУмолчанию, ПространствоИменXMLDSig);
			Для каждого ПространствоИменКорневогоУзла Из ПространстваИменКорневогоУзла Цикл
				УзелПодписьИнфо.УстановитьСоответствиеПространстваИмен(ПространствоИменКорневогоУзла.Значение,
					ПространствоИменКорневогоУзла.Представление);
			КонецЦикла;
			
		Иначе
			УзелПодписьИнфо.УстановитьАтрибут("xmlns" + ДвоеточиеИПрефиксПодписи, ПространствоИменXMLDSig);
		КонецЕсли;
	КонецЕсли;
	НастройкиКонвертации = Новый Структура;
	НастройкиКонвертации.Вставить("ПрефиксОбхода", 					ПрефиксОбхода);
	НастройкиКонвертации.Вставить("ПрефиксыПространствИмен", 		ПрефиксыПространствИмен);
	НастройкиКонвертации.Вставить("ПространствоИменПоУмолчанию", 	ПространствоИменПоУмолчанию);
	
	// Каноникализации узла подписи.
	Если ИспользоватьПреобразованиеККаноническомуXML Тогда
		// Для канонокализации используется объект ПреобразованиеККаноническомуXML.
		
		// Канонизации с фильтром XPach медленно работают при крупных файлах, удаление неиспользуемой при этих канонизациях
		// части XML
		Если ДвоичныеДанныеФайлаXML.Размер() > 1024 * 1024 И ДокументDOM.ДочерниеУзлы.Количество() <> 0
			И ДокументDOM.ДочерниеУзлы[0].ДочерниеУзлы.Количество() > 1 Тогда
			
			ДокументDOM.ДочерниеУзлы[0].УдалитьДочерний(ДокументDOM.ДочерниеУзлы[0].ДочерниеУзлы[0]);
		КонецЕсли;
		
		ФайлКанонизированныйУзелПодпись = ФайлПреобразованиеККаноническомуXML(
			ДокументDOM,
			ТипКаноническогоXMLФайла,
			"(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='" + ПрефиксПодписиИДвоеточие + "SignedInfo']]");
		
		Если ДобавитьШтампВремени Тогда
			АтрибутПространстваИменКорневогоУзла = КорневойУзел.Атрибуты.ПолучитьИменованныйЭлемент(ПространствоИменXMLNS, "xmlns");
			Если АтрибутПространстваИменКорневогоУзла <> Неопределено Тогда
				ФайлКанонизированныйУзелПодпись = СкопироватьИЗаменитьВФайле(
					ФайлКанонизированныйУзелПодпись,
					"",
					"xmlns:ds=""" + ПространствоИменXMLDSig + """",,
					" ",
					">");
			КонецЕсли;
			
			АтрибутПространстваИменURNКорневогоУзла = КорневойУзел.Атрибуты.ПолучитьИменованныйЭлемент(ПространствоИменXMLNS,
				"urn");
			Если АтрибутПространстваИменURNКорневогоУзла <> Неопределено Тогда
				ФайлКанонизированныйУзелПодпись = СкопироватьИЗаменитьВФайле(
					ФайлКанонизированныйУзелПодпись,
					" xmlns:urn=""" + АтрибутПространстваИменURNКорневогоУзла.Значение
						+ """ xmlns:ds=""" + ПространствоИменXMLDSig + """",
					"");
			КонецЕсли;
			
			ФайлКанонизированныйУзелПодписанныхСвойств = ФайлПреобразованиеККаноническомуXML(
				ДокументDOM,
				ТипКаноническогоXMLФайла,
				"(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='xades:SignedProperties']]");
			
			ФайлКанонизированныйУзелЗначенияПодписи = ФайлПреобразованиеККаноническомуXML(
				ДокументDOM,
				ТипКаноническогоXMLФайла,
				"(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='"
					+ ПрефиксПодписиИДвоеточие + "SignatureValue']]");
			
			Если ЭтоИсключающаяКанонизация И ЗначениеЗаполнено(ПрефиксПодписи)
				И (нрег(ДокументDOM.КодировкаИсточника) = "utf-8" ИЛИ нрег(ДокументDOM.КодировкаИсточника) = "") Тогда
				
				// обход ошибки платформы
				Если АтрибутПространстваИменКорневогоУзла <> Неопределено Тогда
					ФайлКанонизированныйУзелЗначенияПодписи = СкопироватьИЗаменитьВФайле(
						ФайлКанонизированныйУзелЗначенияПодписи,
						"",
						"xmlns:ds=""" + ПространствоИменXMLDSig + """",,
						" ",
						" Id=""");
				КонецЕсли;
				
				Если АтрибутПространстваИменURNКорневогоУзла <> Неопределено Тогда
					ФайлКанонизированныйУзелЗначенияПодписи = СкопироватьИЗаменитьВФайле(
						ФайлКанонизированныйУзелЗначенияПодписи,
						" xmlns:ds=""" + ПространствоИменXMLDSig
							+ """ xmlns:urn=""" + АтрибутПространстваИменURNКорневогоУзла.Значение + """",
						" xmlns:ds=""" + ПространствоИменXMLDSig + """");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// Для канонокализации используется объект КаноническийDOM.
		ФайлКанонизированныйУзелПодпись = ФайлКанонизированныйУзелDOM(
			УзелПодписьИнфо,,,
			Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи,
			Трансформация1_1 И НЕ НормализацияОтключена,,
			НастройкиКонвертации);
	КонецЕсли;
		
	Если ИспользоватьВременноеХранилище Тогда
		ДвоичныеДанныеКанонизированногоУзлаПодписать = Новый ДвоичныеДанные(ФайлКанонизированныйУзелПодпись);
		КанонизированныйУзелПодписьВBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКанонизированногоУзлаПодписать, Новый УникальныйИдентификатор);
	Иначе
		КанонизированныйУзелПодписьВBase64 = ПрочитатьBase64ИзФайла(ФайлКанонизированныйУзелПодпись);
	КонецЕсли;
	
	ДанныеДляПодписи = Новый Структура;
	ДанныеДляПодписи.Вставить("КанонизированныйФайлXMLВBase64", КанонизированныйФайлXMLВBase64);
	ДанныеДляПодписи.Вставить("КанонизированныйУзелПодписьВBase64", КанонизированныйУзелПодписьВBase64);
	
	Если ИспользоватьПреобразованиеККаноническомуXML И ДобавитьШтампВремени Тогда
		Если ИспользоватьВременноеХранилище Тогда
			ДвоичныеДанныеКанонизированногоУзлаПодписанныхСвойств =
				Новый ДвоичныеДанные(ФайлКанонизированныйУзелПодписанныхСвойств);
			КанонизированныйУзелПодписанныхСвойствВBase64 = ПоместитьВоВременноеХранилище(
				ДвоичныеДанныеКанонизированногоУзлаПодписанныхСвойств, Новый УникальныйИдентификатор);
		Иначе
			КанонизированныйУзелПодписанныхСвойствВBase64 = ПрочитатьBase64ИзФайла(ФайлКанонизированныйУзелПодписанныхСвойств);
		КонецЕсли;
		ДанныеДляПодписи.Вставить("КанонизированныйУзелПодписанныхСвойствВBase64",
			КанонизированныйУзелПодписанныхСвойствВBase64);
		
		Если ИспользоватьВременноеХранилище Тогда
			ДвоичныеДанныеКанонизированногоУзлаЗначенияПодписи =
				Новый ДвоичныеДанные(ФайлКанонизированныйУзелЗначенияПодписи);
			КанонизированныйУзелЗначенияПодписиВBase64 = ПоместитьВоВременноеХранилище(
				ДвоичныеДанныеКанонизированногоУзлаЗначенияПодписи, Новый УникальныйИдентификатор);
		Иначе
			КанонизированныйУзелЗначенияПодписиВBase64 = ПрочитатьBase64ИзФайла(ФайлКанонизированныйУзелЗначенияПодписи);
		КонецЕсли;
		ДанныеДляПодписи.Вставить("КанонизированныйУзелЗначенияПодписиВBase64",
			КанонизированныйУзелЗначенияПодписиВBase64);
	КонецЕсли;
	
	Если ВключатьХэшСертификата ИЛИ ДанныеВнутриПодписи Тогда
		Если ВключатьХэшСертификата И НЕ НеВключатьИнформациюОСертификате Тогда
			НастройкиКонвертации = Новый Структура;
			НастройкиКонвертации.Вставить("ПрефиксОбхода", 					ПрефиксОбхода);
			НастройкиКонвертации.Вставить("ПрефиксыПространствИмен", 		ПрефиксыПространствИмен);
			НастройкиКонвертации.Вставить("ПространствоИменПоУмолчанию", 	Неопределено);
			ФайлКанонизированныйУзелИнформацияОКлючах = ФайлКанонизированныйУзелDOM(
				УзелИнформацияОКлючах,,,
				Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи,
				Трансформация1_1 И НЕ НормализацияОтключена,,
				НастройкиКонвертации);
			Если Трансформация1_1 Тогда
				ЧтениеФайлаУзелИнформацияОКлючах = Новый ЧтениеТекста(ФайлКанонизированныйУзелИнформацияОКлючах, "windows-1251");
				СодержимоеФайлаУзелИнформацияОКлючах = ЧтениеФайлаУзелИнформацияОКлючах.Прочитать();
				ЧтениеФайлаУзелИнформацияОКлючах.Закрыть();
				СодержимоеФайлаУзелИнформацияОКлючах = СтрЗаменить(СодержимоеФайлаУзелИнформацияОКлючах,
					"<n1:KeyInfo Id=""KeyInfo"">", "<n1:KeyInfo xmlns:n1=""http://www.w3.org/2000/09/xmldsig#"" Id=""KeyInfo"">");
				ЗаписьФайлаУзелИнформацияОКлючах = Новый ЗаписьТекста(ФайлКанонизированныйУзелИнформацияОКлючах, "windows-1251");
				ЗаписьФайлаУзелИнформацияОКлючах.Записать(СодержимоеФайлаУзелИнформацияОКлючах);
				ЗаписьФайлаУзелИнформацияОКлючах.Закрыть();
			КонецЕсли;
			Если ИспользоватьВременноеХранилище Тогда
				ДвоичныеДанныеКанонизированногоУзлаИнформацииОКлючах = Новый ДвоичныеДанные(ФайлКанонизированныйУзелИнформацияОКлючах);
				КанонизированныйУзелИнформацияОКлючахВBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКанонизированногоУзлаИнформацииОКлючах, Новый УникальныйИдентификатор);
			Иначе
				КанонизированныйУзелИнформацияОКлючахВBase64 = ПрочитатьBase64ИзФайла(ФайлКанонизированныйУзелИнформацияОКлючах);
			КонецЕсли;
			ДанныеДляПодписи.Вставить("КанонизированныйУзелИнформацияОКлючахXMLВBase64", КанонизированныйУзелИнформацияОКлючахВBase64);
		КонецЕсли;
		
		Если НЕ ДанныеВнутриПодписи И НЕ ПереданХешВместоОбъекта Тогда
			НастройкиКонвертации = Новый Структура;
			НастройкиКонвертации.Вставить("ПрефиксОбхода", 					ПрефиксОбхода);
			НастройкиКонвертации.Вставить("ПрефиксыПространствИмен", 		ПрефиксыПространствИмен);
			НастройкиКонвертации.Вставить("ПространствоИменПоУмолчанию", 	Неопределено);
			ФайлКанонизированныйУзелИнформацияОбОбъекте = ФайлКанонизированныйУзелDOM(
				УзелИнформацияОбОбъекте,,,
				Трансформация1_1 ИЛИ ДополнитьПространстваИменУзлаПодписи,
				Трансформация1_1 И НЕ НормализацияОтключена,
				ДополнительныеОбратныеТрансформации,
				НастройкиКонвертации);
			
			ЧтениеФайлаУзелИнформацияОбОбъекте = Новый ЧтениеТекста(ФайлКанонизированныйУзелИнформацияОбОбъекте, "windows-1251");
			СодержимоеФайлаУзелИнформацияОбОбъекте = ЧтениеФайлаУзелИнформацияОбОбъекте.Прочитать();
			ЧтениеФайлаУзелИнформацияОбОбъекте.Закрыть();
			Если Трансформация1_1 Тогда
				ЗначениеИдентификатораПодписываемыхДанных = ?(ИдентификаторПодписываемыхДанных = Неопределено, "Object", ИдентификаторПодписываемыхДанных);
				СодержимоеФайлаУзелИнформацияОбОбъекте = СтрЗаменить(СодержимоеФайлаУзелИнформацияОбОбъекте,
					"<n1:Object Id=""" + ЗначениеИдентификатораПодписываемыхДанных + """>",
					"<n1:Object xmlns:n1=""http://www.w3.org/2000/09/xmldsig#"" Id=""" + ЗначениеИдентификатораПодписываемыхДанных + """>");
			КонецЕсли;
			СодержимоеФайлаУзелИнформацияОбОбъекте = СтрЗаменить(СодержимоеФайлаУзелИнформацияОбОбъекте, "%SigningXML%", СодержимоеКанонизированногоФайлаXML);
		Иначе
			ФайлКанонизированныйУзелИнформацияОбОбъекте = ПолучитьИмяВременногоФайла();
			СодержимоеФайлаУзелИнформацияОбОбъекте = СодержимоеКанонизированногоФайлаXML;
		КонецЕсли;
		ЗаписьФайлаУзелИнформацияОбОбъекте = Новый ЗаписьТекста(ФайлКанонизированныйУзелИнформацияОбОбъекте, "windows-1251");
		ЗаписьФайлаУзелИнформацияОбОбъекте.Записать(СодержимоеФайлаУзелИнформацияОбОбъекте);
		ЗаписьФайлаУзелИнформацияОбОбъекте.Закрыть();
		Если ИспользоватьВременноеХранилище Тогда
			ДвоичныеДанныеКанонизированногоУзлаИнформацииОбОбъекте = Новый ДвоичныеДанные(ФайлКанонизированныйУзелИнформацияОбОбъекте);
			КанонизированныйУзелИнформацияОбОбъектеВBase64 = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКанонизированногоУзлаИнформацииОбОбъекте, Новый УникальныйИдентификатор);
		Иначе
			КанонизированныйУзелИнформацияОбОбъектеВBase64 = ПрочитатьBase64ИзФайла(ФайлКанонизированныйУзелИнформацияОбОбъекте);
		КонецЕсли;
		ДанныеДляПодписи.Вставить("КанонизированныйУзелИнформацияОбОбъектеXMLВBase64", КанонизированныйУзелИнформацияОбОбъектеВBase64);
	КонецЕсли;
	
	Если ИспользоватьВременноеХранилище Тогда
		// элементы структуры уже помещены во временное хранилище
		Возврат ДанныеДляПодписи;
	Иначе
		Возврат ПоместитьВоВременноеХранилище(ДанныеДляПодписи, Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецФункции

Функция СоздатьИДобавитьДочернийЭлемент(
		ЭлементDOM,
		URIПространстваИмен = "",
		ПрефиксПространстваИмен = "",
		ЛокальноеИмя = "Файл",
		УзелПередКоторымВставить = Неопределено)
	
	ДокументDOM = ЭлементDOM.ДокументВладелец;
	
	КвалифицированноеИмя = ?(ЗначениеЗаполнено(ПрефиксПространстваИмен), ПрефиксПространстваИмен + ":", "")
		+ ЛокальноеИмя;
	Если ЗначениеЗаполнено(URIПространстваИмен) Тогда
		НовыйЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространстваИмен, КвалифицированноеИмя);
	Иначе
		НовыйЭлементDOM = ДокументDOM.СоздатьЭлемент(КвалифицированноеИмя);
	КонецЕсли;
	
	Если УзелПередКоторымВставить = Неопределено Тогда
		Возврат ЭлементDOM.ДобавитьДочерний(НовыйЭлементDOM);
	Иначе
		Возврат ЭлементDOM.ВставитьПеред(НовыйЭлементDOM, УзелПередКоторымВставить);
	КонецЕсли;
	
КонецФункции

Функция СкопироватьИЗаменитьВФайле(
		ИмяФайла,
		ПодстрокаПоиска = "",
		ПодстрокаЗамены = "",
		Кодировка = "utf-8",
		ПодстрокаНачала = "",
		ПодстрокаКонца = "")
	
	ОбъектЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, Кодировка);
	ТекстФайла = ОбъектЧтениеТекста.Прочитать();
	ОбъектЧтениеТекста.Закрыть();
	
	Если (ТипЗнч(ПодстрокаПоиска) = Тип("Массив") ИЛИ ТипЗнч(ПодстрокаПоиска) = Тип("ФиксированныйМассив")
		ИЛИ ТипЗнч(ПодстрокаНачала) = Тип("Массив") ИЛИ ТипЗнч(ПодстрокаНачала) = Тип("ФиксированныйМассив")
		ИЛИ ТипЗнч(ПодстрокаКонца) = Тип("Массив") ИЛИ ТипЗнч(ПодстрокаКонца) = Тип("ФиксированныйМассив"))
		И (ТипЗнч(ПодстрокаЗамены) = Тип("Массив") ИЛИ ТипЗнч(ПодстрокаЗамены) = Тип("ФиксированныйМассив")) Тогда
		
		МассивПодстрокПоиска 	= ПодстрокаПоиска;
		МассивПодстрокЗамены 	= ПодстрокаЗамены;
		МассивПодстрокНачала 	= ПодстрокаНачала;
		МассивПодстрокКонца 	= ПодстрокаКонца;
		
	Иначе
		МассивПодстрокПоиска 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодстрокаПоиска);
		МассивПодстрокЗамены 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодстрокаЗамены);
		МассивПодстрокНачала 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодстрокаНачала);
		МассивПодстрокКонца 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПодстрокаКонца);
	КонецЕсли;
	
	Для ИндексПодстроки = 0 По МассивПодстрокПоиска.Количество() - 1 Цикл
		Если (ТипЗнч(МассивПодстрокПоиска) <> Тип("Массив") И ТипЗнч(МассивПодстрокПоиска) <> Тип("ФиксированныйМассив")
				ИЛИ МассивПодстрокПоиска[ИндексПодстроки] = "")
			И ТипЗнч(МассивПодстрокНачала) = Тип("Массив") ИЛИ ТипЗнч(МассивПодстрокНачала) = Тип("ФиксированныйМассив")
			И ТипЗнч(МассивПодстрокКонца) = Тип("Массив") ИЛИ ТипЗнч(МассивПодстрокКонца) = Тип("ФиксированныйМассив") Тогда
			
			ПозицияНачала = СтрНайти(ТекстФайла, МассивПодстрокНачала[ИндексПодстроки]);
			Если ПозицияНачала <> 0 Тогда
				ДлинаПодстрокиНачала = СтрДлина(МассивПодстрокНачала[ИндексПодстроки]);
				ТекстФайлаПослеПодстрокиНачала = Сред(ТекстФайла, ПозицияНачала + ДлинаПодстрокиНачала);
				ПозицияКонца = СтрНайти(ТекстФайлаПослеПодстрокиНачала, МассивПодстрокКонца[ИндексПодстроки]);
				Если ПозицияКонца <> 0 Тогда
					ТекстФайла = Лев(ТекстФайла, ПозицияНачала + ДлинаПодстрокиНачала - 1) + МассивПодстрокЗамены[ИндексПодстроки]
						+ Сред(ТекстФайлаПослеПодстрокиНачала, ПозицияКонца);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			ТекстФайла = СтрЗаменить(ТекстФайла, МассивПодстрокПоиска[ИндексПодстроки], МассивПодстрокЗамены[ИндексПодстроки]);
		КонецЕсли;
	КонецЦикла;
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайла);
	
	Результат = ПолучитьИмяВременногоФайла();
	ДанныеТекста = ПолучитьДвоичныеДанныеИзСтроки(ТекстФайла, Кодировка);
	ДанныеТекста.Записать(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ФайлПреобразованиеККаноническомуXML(ДокументDOM,
	ТипКаноническогоXMLФайла = Неопределено,
	ФильтрXPath = Неопределено,
	Знач ИмяВыходногоФайла = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ИмяВыходногоФайла) Тогда
		ИмяВыходногоФайла = ПолучитьИмяВременногоФайла();
	КонецЕсли;
	
	// обход ошибки платформы для русских пространств имен
	ИзмененныеЗначенияУзлов = Новый Соответствие;
	Для каждого АтрибутDOM Из ДокументDOM.ЭлементДокумента.Атрибуты Цикл
		Если АтрибутDOM.Префикс = "xmlns" ИЛИ АтрибутDOM.ЛокальноеИмя = "xmlns" Тогда
			ИзмененноеЗначениеУзла = "http://" + Строка(Новый УникальныйИдентификатор);
			ИзмененныеЗначенияУзлов[ИзмененноеЗначениеУзла] = АтрибутDOM.ЗначениеУзла;
			АтрибутDOM.ЗначениеУзла = ИзмененноеЗначениеУзла;
		КонецЕсли;
	КонецЦикла;
	
	ИмяВыходногоФайлаБезКонвертации = ПолучитьИмяВременногоФайла();
	
	Преобразование = Новый ПреобразованиеККаноническомуXML;
	Преобразование.КанонизироватьВФайл(
		ДокументDOM,
		ИмяВыходногоФайлаБезКонвертации,
		ТипКаноническогоXMLФайла,
		ФильтрXPath);
	
	Для каждого АтрибутDOM Из ДокументDOM.ЭлементДокумента.Атрибуты Цикл
		Если АтрибутDOM.Префикс = "xmlns" ИЛИ АтрибутDOM.ЛокальноеИмя = "xmlns" Тогда
			АтрибутDOM.ЗначениеУзла = ИзмененныеЗначенияУзлов[АтрибутDOM.ЗначениеУзла];
		КонецЕсли;
	КонецЦикла;
	
	КодировкаXML = ?(ЗначениеЗаполнено(ДокументDOM.КодировкаИсточника), ДокументDOM.КодировкаИсточника, "utf-8");
	ЧтениеТекста = Новый ЧтениеТекста(ИмяВыходногоФайлаБезКонвертации, КодировкаXML);
	ТекстXML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Для каждого ИзмененноеЗначениеУзла Из ИзмененныеЗначенияУзлов Цикл
		ТекстXML = СтрЗаменить(ТекстXML, ИзмененноеЗначениеУзла.Ключ, ИзмененноеЗначениеУзла.Значение);
	КонецЦикла;
	
	ИмяВыходногоФайлаСBOM = ПолучитьИмяВременногоФайла();
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВыходногоФайлаСBOM, КодировкаXML);
	ЗаписьТекста.Записать(ТекстXML);
	ЗаписьТекста.Закрыть();
	
	// удалим из файла в кодировке "UTF-8" сигнатуру BOM
	ДанныеЧтение = Новый ДвоичныеДанные(ИмяВыходногоФайлаСBOM);
	ДанныеЗапись = Base64Значение(Сред(Base64Строка(ДанныеЧтение), 5));
	ДанныеЗапись.Записать(ИмяВыходногоФайла);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВыходногоФайлаБезКонвертации);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВыходногоФайлаСBOM);
	
	Возврат ИмяВыходногоФайла;
	
КонецФункции

Функция ФайлКанонизированныйУзелDOM(
	УзелDOM,
	ИмяФайлаУзелDOM = Неопределено,
	РезультатXPath = Неопределено,
	КоррекцияКанонизации = Ложь,
	Нормализация1_1 = Ложь,
	ДополнительныеОбратныеТрансформации = Неопределено,
	НастройкиКонвертации = Неопределено)

	
	ПрефиксОбхода 				= НастройкиКонвертации.ПрефиксОбхода;
	ПрефиксыПространствИмен 	= НастройкиКонвертации.ПрефиксыПространствИмен;
	ПространствоИменПоУмолчанию = НастройкиКонвертации.ПространствоИменПоУмолчанию;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаУзелDOM) Тогда
		ИмяФайлаУзелDOM = ПолучитьИмяВременногоФайла();
	КонецЕсли;
	
	ЗаписьXML = Новый КаноническаяЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКаноническогоXML.КаноническийXML);
	
	КаноническийDOM = Новый КаноническийDOM;
	КаноническийDOM.Канонизировать(УзелDOM, ЗаписьXML, РезультатXPath);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	// обход ошибки платформы
	Пока Истина Цикл
		ПозицияНачала = СтрНайти(СтрокаXML, "&#xD;" + Символы.ПС);
		Если ПозицияНачала = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияКонца = ПозицияНачала + 6;
		Пока ПозицияКонца <= СтрДлина(СтрокаXML) Цикл
			СимволСтроки = Сред(СтрокаXML, ПозицияКонца, 1);
			Если СокрЛП(СимволСтроки) <> "" Тогда
				Прервать;
			КонецЕсли;
			ПозицияКонца = ПозицияКонца + 1;
		КонецЦикла;
		
		Если СимволСтроки <> "<" Тогда // если "&#xD;" внутри значения, а не между тегами
			ПозицияКонца = ПозицияНачала + 5;
		КонецЕсли;
		
		СтрокаXML = Лев(СтрокаXML, ПозицияНачала - 1) + Сред(СтрокаXML, ПозицияКонца);
	КонецЦикла;
	
	// для обхода ошибки платформы, аналоги замены :xsi="" на xmlns:xsi=""
	
	Если КоррекцияКанонизации Тогда
		Если ДополнительныеОбратныеТрансформации <> Неопределено Тогда
			ИндексТрансформации = ДополнительныеОбратныеТрансформации.Количество() - 2;
			Пока ИндексТрансформации >= 0 Цикл
				СтрокаXML = СтрЗаменить(СтрокаXML, ДополнительныеОбратныеТрансформации[ИндексТрансформации],
					ДополнительныеОбратныеТрансформации[ИндексТрансформации + 1]);
				ИндексТрансформации = ИндексТрансформации - 2;
			КонецЦикла;
		КонецЕсли;
		Если ПрефиксОбхода <> Неопределено И ПрефиксыПространствИмен <> Неопределено Тогда
			// обратные преобразования обхода ошибки канонизации
			Для ИндексЭлемента = 0 По ПрефиксыПространствИмен.Количество() - 1 Цикл
				ПрефиксПространстваИмен = ПрефиксыПространствИмен[ПрефиксыПространствИмен.Количество() - 1 - ИндексЭлемента];
				СтрокаXML = СтрЗаменить(СтрокаXML,
					" xmlns:" + ПрефиксПространстваИмен + "=""" + ПрефиксОбхода, " xmlns:" + ПрефиксПространстваИмен + "=""");
				СтрокаXML = СтрЗаменить(СтрокаXML,
					" :" + ПрефиксПространстваИмен + "=""" + ПрефиксОбхода, " xmlns:" + ПрефиксПространстваИмен + "="""); // обход ошибки платформы
			КонецЦикла;
			СтрокаXML = СтрЗаменить(СтрокаXML, " xmlns=""" + ПрефиксОбхода, " xmlns=""");
			СтрокаXML = СтрЗаменить(СтрокаXML, " =""" + ПрефиксОбхода, " xmlns="""); // обход ошибки платформы
			СтрокаXML = СтрЗаменить(СтрокаXML, " ="""">", ">"); // обход ошибки платформы
		КонецЕсли;
	КонецЕсли;
	Если Нормализация1_1 Тогда
		СтрокаXML = XMLDSigНормализация1_1(СтрокаXML);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПространствоИменПоУмолчанию) Тогда
		// обход ошибки платформы сортировки пространств имен при канонизации дочернего узла
		СтрокаXML = СтрЗаменить(СтрокаXML, " xmlns:" + ПространствоИменПоУмолчанию + "=", " xmlns=");
		СтрокаXML = СтрЗаменить(СтрокаXML, " :" + ПространствоИменПоУмолчанию + "=", " xmlns=");
	КонецЕсли;
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаУзелDOM, "UTF-8");
	ЗаписьТекста.Записать(СтрокаXML);
	ЗаписьТекста.Закрыть();
	
	// удалим из файла в кодировке "UTF-8" сигнатуру BOM
	ДанныеЧтение = Новый ДвоичныеДанные(ИмяФайлаУзелDOM);
	ДанныеЗапись = Base64Значение(Сред(Base64Строка(ДанныеЧтение), 5));
	ДанныеЗапись.Записать(ИмяФайлаУзелDOM);
	
	Возврат ИмяФайлаУзелDOM;
	
КонецФункции

Функция XMLDSigНормализация1_1(СтрокаXML)
	
	Результат = СтрЗаменить(СтрокаXML, "<", "<n1:");
	Результат = СтрЗаменить(Результат, "<n1:/", "</n1:");
	Результат = СтрЗаменить(Результат, " xmlns=", " xmlns:n1=");
	Возврат Результат;
	
КонецФункции

Функция ХешСтрокаВBase64КанонизированногоФайлаXMLИзПодписи(
		ПодписьКлючаВBase64,
		ПодписьВBase64,
		АдресДанныхДляПодписиФайлаXML,
		УдалитьПодписиИзВременногоХранилища = Ложь,
		Алгоритм = Неопределено) Экспорт
	
	Результат = Новый Структура("ХешСтрокаВBase64", Неопределено);
	
	Если ПодписьКлючаВBase64 <> Неопределено Тогда
		Результат.Вставить("ХешСтрокаВBase64Ключа", Неопределено);
		Результат.ХешСтрокаВBase64Ключа = ХешСтрокаВBase64ИзПодписи(ПодписьКлючаВBase64, УдалитьПодписиИзВременногоХранилища, Алгоритм);
	КонецЕсли;
	
	Если ПодписьКлючаВBase64 = Неопределено ИЛИ Результат.ХешСтрокаВBase64Ключа <> Неопределено Тогда
		Результат.ХешСтрокаВBase64 = ХешСтрокаВBase64ИзПодписи(ПодписьВBase64, УдалитьПодписиИзВременногоХранилища, Алгоритм);
	КонецЕсли;
	
	Если Результат.ХешСтрокаВBase64 = Неопределено И Алгоритм <> "GOST R 34.10-2012-256" И Алгоритм <> "GOST R 34.10-2012-512" Тогда
		Результат = ХешСтрокаВBase64КанонизированногоФайлаXML(АдресДанныхДляПодписиФайлаXML);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ХешСтрокаВBase64ИзПодписи(ПодписьВBase64, УдалитьПодписьИзВременногоХранилища = Ложь, Алгоритм = Неопределено)
	
	Перем ХешСтрокаВBase64;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Если ЭтоАдресВременногоХранилища(ПодписьВBase64) Тогда
		ДвоичныеДанныеПодписи = ПолучитьИзВременногоХранилища(ПодписьВBase64);
		Если УдалитьПодписьИзВременногоХранилища Тогда
			УдалитьИзВременногоХранилища(ПодписьВBase64);
		КонецЕсли;
	Иначе
		ДвоичныеДанныеПодписи = Base64Значение(ПодписьВBase64);
	КонецЕсли;
	ДвоичныеДанныеПодписи.Записать(ИмяВременногоФайла);
	МассивПодписи = ПрочитатьФайлВМассив(ИмяВременногоФайла);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
	
	МассивБайтовДляПоиска = ПолучитьМассивБайтовИзСтрокиВШестнадцатеричномПредставлении("30 2F 06 09 2A 86 48 86 F7 0D 01 09 04 31 22 04 20");
	МаксИндексДанныхПоиска = МассивБайтовДляПоиска.ВГраница();
	МаксИндексДанныхПодписи = МассивПодписи.ВГраница() - МаксИндексДанныхПоиска;
	ИндНайдено = -1;
	Для Инд = 500 По МаксИндексДанныхПодписи Цикл
		ИндНайдено = Инд;
		Для ИндПоиска = 0 По МаксИндексДанныхПоиска Цикл
			Если МассивПодписи[Инд + ИндПоиска] <> МассивБайтовДляПоиска[ИндПоиска] Тогда
				ИндНайдено = -1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ИндНайдено > -1 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ИндНайдено >= 0 Тогда
		
		МассивБайт = Новый Массив;
		Попытка
			Для Инд = 1 По ?(Алгоритм = "GOST R 34.10-2012-512", 64, 32) Цикл
				МассивБайт.Добавить(МассивПодписи[ИндНайдено + МаксИндексДанныхПоиска + Инд]);
			КонецЦикла; 
		Исключение
			ТекстСообщения = НСтр("ru = 'Ошибка извлечения данных хеша из файла подписи!';
									|en = 'An error occurred while extracting hash data from the signature file.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат "";
		КонецПопытки;
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ЗаписатьФайлИзМассива(ИмяВременногоФайла, МассивБайт);
		
		ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
		ХешСтрокаВBase64 = Base64Строка(ДвоичныеДанныеФайла);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		
	Иначе
		
		ХешСтрокаВBase64 = Неопределено;
		
	КонецЕсли;
	
	Возврат ХешСтрокаВBase64;
	
КонецФункции

Функция ХешСтрокаВBase64КанонизированногоФайлаXML(АдресДанныхДляПодписиФайлаXML)
	
	Результат = Новый Структура("ХешСтрокаВBase64", Неопределено);
	
	ИспользоватьВременноеХранилище = (ТипЗнч(АдресДанныхДляПодписиФайлаXML) <> Тип("Строка") ИЛИ НЕ ЭтоАдресВременногоХранилища(АдресДанныхДляПодписиФайлаXML));
	Если ИспользоватьВременноеХранилище Тогда
		ДанныеДляПодписиФайлаXML = АдресДанныхДляПодписиФайлаXML
	Иначе
		ДанныеДляПодписиФайлаXML = ПолучитьИзВременногоХранилища(АдресДанныхДляПодписиФайлаXML);
	КонецЕсли;
	
	Если ДанныеДляПодписиФайлаXML.Свойство("КанонизированныйУзелИнформацияОКлючахXMLВBase64") Тогда
		Результат.Вставить("ХешСтрокаВBase64Ключа", Неопределено);
		Если ИспользоватьВременноеХранилище И ЭтоАдресВременногоХранилища(ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОКлючахXMLВBase64) Тогда
			ДвДанныеДляПодписиИнформацииОКлючахXML = ПолучитьИзВременногоХранилища(ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОКлючахXMLВBase64);
		Иначе
			ДвДанныеДляПодписиИнформацииОКлючахXML = Base64Значение(ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОКлючахXMLВBase64);
		КонецЕсли;
		Результат.ХешСтрокаВBase64Ключа = ВычислитьХешПоАлгоритмуГОСТР3411_94(ДвДанныеДляПодписиИнформацииОКлючахXML, Истина);
	КонецЕсли;
	
	КанонизированныйОбъектXMLВBase64 = ?(НЕ ДанныеДляПодписиФайлаXML.Свойство("КанонизированныйУзелИнформацияОбОбъектеXMLВBase64"),
		ДанныеДляПодписиФайлаXML.КанонизированныйФайлXMLВBase64, ДанныеДляПодписиФайлаXML.КанонизированныйУзелИнформацияОбОбъектеXMLВBase64);
	Если ИспользоватьВременноеХранилище И ЭтоАдресВременногоХранилища(КанонизированныйОбъектXMLВBase64) Тогда
		ДвДанныеДляПодписиОбъектаXML = ПолучитьИзВременногоХранилища(КанонизированныйОбъектXMLВBase64);
	Иначе
		ДвДанныеДляПодписиОбъектаXML = Base64Значение(КанонизированныйОбъектXMLВBase64);
	КонецЕсли;
	Результат.ХешСтрокаВBase64 = ВычислитьХешПоАлгоритмуГОСТР3411_94(ДвДанныеДляПодписиОбъектаXML, Истина);
	
	Возврат Результат;
	
КонецФункции

Функция ПодписанныйФайлXMLВBase64(
		АдресСодержимогоПодготовленногоФайлаXML,
		ХешСтрокаВBase64Ключа,
		ХешСтрокаВBase64,
		ПодписанныеДанныеВBase64,
		ВозвращатьАдресВоВременномХранилище = Ложь,
		ВключатьХэшСертификата = Ложь,
		НастройкиПодписи = Неопределено) Экспорт
	
	Если ВключатьХэшСертификата Тогда
		Если ВозвращатьАдресВоВременномХранилище Тогда
			ДанныеПодписи = ПолучитьИзВременногоХранилища(ПодписанныеДанныеВBase64);
			ПодписьВBase64 = Base64Строка(ДанныеПодписи);
		Иначе
			ПодписьВBase64 = ПодписанныеДанныеВBase64;
		КонецЕсли;
	Иначе
		ПодписьВBase64 = ПодписьИзПодписанныхДанныхBase64(ПодписанныеДанныеВBase64);
	КонецЕсли;
	
	Если Лев(ПодписьВBase64, 6) = "e1cib/" Тогда 
		ДанныеПодписи = ПолучитьИзВременногоХранилища(ПодписьВBase64);
		ПодписьВBase64 = Base64Строка(ДанныеПодписи);
	КонецЕсли;
	
	Если ХешСтрокаВBase64Ключа <> Неопределено Тогда
		ХешСтрокаВBase64Ключа = СтрЗаменить(ХешСтрокаВBase64Ключа, Символы.ВК, "");
		ХешСтрокаВBase64Ключа = СтрЗаменить(ХешСтрокаВBase64Ключа, Символы.ПС, "");
	КонецЕсли;
	ХешСтрокаВBase64 = СтрЗаменить(ХешСтрокаВBase64, Символы.ВК, "");
	ХешСтрокаВBase64 = СтрЗаменить(ХешСтрокаВBase64, Символы.ПС, "");
	ПодписьВBase64 = СтрЗаменить(ПодписьВBase64, Символы.ВК, "");
	ПодписьВBase64 = СтрЗаменить(ПодписьВBase64, Символы.ПС, "");
	
	ТекстовоеСодержимоеПодписанногоФайлаXML = ПолучитьИзВременногоХранилища(АдресСодержимогоПодготовленногоФайлаXML);
	Если ХешСтрокаВBase64Ключа <> Неопределено Тогда
		ТекстовоеСодержимоеПодписанногоФайлаXML = СтрЗаменить(ТекстовоеСодержимоеПодписанногоФайлаXML, "%KeyInfoDigestValue%", ХешСтрокаВBase64Ключа);
	КонецЕсли;
	
	ТекстовоеСодержимоеПодписанногоФайлаXML = СтрЗаменить(ТекстовоеСодержимоеПодписанногоФайлаXML, "%DigestValue%", ХешСтрокаВBase64);
	
	Если НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("ХешСтрокаПодписанныхСвойствВBase64")
		И ЗначениеЗаполнено(НастройкиПодписи.ХешСтрокаПодписанныхСвойствВBase64) Тогда
		
		ТекстовоеСодержимоеПодписанногоФайлаXML = СтрЗаменить(ТекстовоеСодержимоеПодписанногоФайлаXML,
			"%SignedPropsDigestValue%", НастройкиПодписи.ХешСтрокаПодписанныхСвойствВBase64);
	КонецЕсли;
	
	ТекстовоеСодержимоеПодписанногоФайлаXML = СтрЗаменить(ТекстовоеСодержимоеПодписанногоФайлаXML, "%SignatureValue%", ПодписьВBase64);
	
	Если НастройкиПодписи <> Неопределено И НастройкиПодписи.Свойство("КанонизированныйУзелЗначенияПодписиВBase64")
		И ЗначениеЗаполнено(НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64) Тогда
		
		Если ВозвращатьАдресВоВременномХранилище Тогда
			ДанныеКанонизированногоУзлаЗначенияПодписи = ПолучитьИзВременногоХранилища(
				НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64);
			
		Иначе
			ДанныеКанонизированногоУзлаЗначенияПодписи = Base64Значение(
				НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64);
		КонецЕсли;
		КанонизированныйУзелЗначенияПодписи =
			ПолучитьСтрокуИзДвоичныхДанных(ДанныеКанонизированногоУзлаЗначенияПодписи, "utf-8");
		
		КанонизированныйУзелЗначенияПодписи = СтрЗаменить(КанонизированныйУзелЗначенияПодписи,
			"%SignatureValue%", ПодписьВBase64);
		
		ДанныеКанонизированногоУзлаЗначенияПодписи = ПолучитьДвоичныеДанныеИзСтроки(
			КанонизированныйУзелЗначенияПодписи, "utf-8");
		Если ВозвращатьАдресВоВременномХранилище Тогда
			НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64 = ПоместитьВоВременноеХранилище(
				ДанныеКанонизированногоУзлаЗначенияПодписи, НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64);
		Иначе
			НастройкиПодписи.КанонизированныйУзелЗначенияПодписиВBase64 = Base64Строка(
				ДанныеКанонизированногоУзлаЗначенияПодписи);
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайлаXML = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаXML, "UTF-8");
	ЗаписьТекста.Записать(ТекстовоеСодержимоеПодписанногоФайлаXML);
	ЗаписьТекста.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаXML);
	
	// удалим из файла в кодировке "UTF-8" сигнатуру BOM
	ПодготовленныйФайлXMLВBase64 = Сред(Base64Строка(ДвоичныеДанные), 5);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаXML);
	
	Если ВозвращатьАдресВоВременномХранилище Тогда
		ДвоичныеДанныеПодготовленногоФайлаXML = Base64Значение(ПодготовленныйФайлXMLВBase64);
		Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанныеПодготовленногоФайлаXML, Новый УникальныйИдентификатор);
	Иначе
		Возврат ПодготовленныйФайлXMLВBase64;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьШтампВремениИПодставитьВПодписанныйФайлXMLВBase64(
		СодержимоеПодписанногоФайлаXMLВBase64,
		ХешСтрокаЗначенияПодписи,
		ВозвращатьАдресВоВременномХранилище = Ложь) Экспорт
	
	СлучайноеЧислоОт8Байт = ТекущаяУниверсальнаяДатаВМиллисекундах() * (256 * 256 * 256 * 256)
		+ ТекущаяУниверсальнаяДатаВМиллисекундах();
	ХешСтрокаЗначенияПодписиБезПробелов = СтрЗаменить(ХешСтрокаЗначенияПодписи, " ", "");
	Случайные16ШестнадцатеричныхСимволов = ДокументооборотСКОВызовСервера.ЧислоВШестнадцатеричномПредставлении(
		СлучайноеЧислоОт8Байт, 8);
	
	ДанныеШтампаВремени = КриптографияЭДКОСлужебныйВызовСервера.ШтампВремени(,
		ХешСтрокаЗначенияПодписиБезПробелов,
		Случайные16ШестнадцатеричныхСимволов);
	ШтампВремениВBase64 = Base64Строка(ДанныеШтампаВремени);
	ШтампВремениВBase64 = СтрЗаменить(ШтампВремениВBase64, Символы.ВК, "");
	ШтампВремениВBase64 = СтрЗаменить(ШтампВремениВBase64, Символы.ПС, "");
	
	Если ВозвращатьАдресВоВременномХранилище Тогда
		ДанныеПодписанногоФайлаXML = ПолучитьИзВременногоХранилища(СодержимоеПодписанногоФайлаXMLВBase64);
	Иначе
		ДанныеПодписанногоФайлаXML = Base64Значение(СодержимоеПодписанногоФайлаXMLВBase64);
	КонецЕсли;
	СодержимоеПодписанногоФайлаXML = ПолучитьСтрокуИзДвоичныхДанных(ДанныеПодписанногоФайлаXML, "utf-8");
	
	СодержимоеПодписанногоФайлаXML = СтрЗаменить(СодержимоеПодписанногоФайлаXML, "%TimeStamp%", ШтампВремениВBase64);
	
	ДанныеПодписанногоФайлаXML = ПолучитьДвоичныеДанныеИзСтроки(СодержимоеПодписанногоФайлаXML, "utf-8");
	Если ВозвращатьАдресВоВременномХранилище Тогда
		Результат = ПоместитьВоВременноеХранилище(ДанныеПодписанногоФайлаXML, СодержимоеПодписанногоФайлаXMLВBase64);
	Иначе
		Результат = Base64Строка(ДанныеПодписанногоФайлаXML);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВычислитьХешПоАлгоритмуГОСТР3411_94(
		ХешируемыеДанные,
		ПредставитьРезультатХешированияВBase64 = Истина,
		ИмяНабораПараметров = "ГОСТР3411_94_НаборПараметровКриптоПро")
	
	Перем Данные;
	Перем РезультатХеширования;
	
	БуферДанных = Новый Массив;
	МаксРазмерБуфера = 262144;
	
	Если ТипЗнч(ХешируемыеДанные) = Тип("ДвоичныеДанные") Тогда
		Данные = ПолучитьМассивБайтовИзДвоичныхДанных(ХешируемыеДанные);
	ИначеЕсли ТипЗнч(ХешируемыеДанные) = Тип("Строка") Тогда
		Данные = ПолучитьМассивБайтовИзСтроки(ХешируемыеДанные);
	ИначеЕсли ТипЗнч(ХешируемыеДанные) = Тип("Массив") Тогда
		Данные = ХешируемыеДанные;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	РазмерДанных = Данные.Количество();
	
	ХешКонтекст = ИнициализироватьХешКонтекст(ИмяНабораПараметров);
	
	ОбработаноБайтов = 0;
	Пока ОбработаноБайтов < РазмерДанных Цикл
		
		РазмерБуфера = 0;
		Для Инд = ОбработаноБайтов По РазмерДанных - 1 Цикл
			БуферДанных.Добавить(Данные[Инд]);
			РазмерБуфера = РазмерБуфера + 1;
			Если РазмерБуфера >= МаксРазмерБуфера Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если РазмерБуфера = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ВыполнитьОперациюХешированияДанныхБуфера(ХешКонтекст, БуферДанных);
		
		БуферДанных.Очистить();
		
		ОбработаноБайтов = ОбработаноБайтов + РазмерБуфера;
		
	КонецЦикла;
	
	ВыполнитьЗавершающуюОперациюХеширования(ХешКонтекст, РезультатХеширования);
	
	Если ПредставитьРезультатХешированияВBase64 Тогда
		Возврат ПолучитьСтрокуBase64ИзМассиваБайтов(РезультатХеширования);
	КонецЕсли;
	
	РультатВШестнадцатеричномПредставлении = "";
	Для каждого ЗначениеБайта Из РезультатХеширования Цикл
		РультатВШестнадцатеричномПредставлении = РультатВШестнадцатеричномПредставлении
			+ ДокументооборотСКОВызовСервера.ЧислоВШестнадцатеричномПредставлении(ЗначениеБайта, 1);
	КонецЦикла;
	
	Возврат РультатВШестнадцатеричномПредставлении;
	
КонецФункции

Функция ПрочитатьФайлВМассив(ИмяФайла, Позиция = 0, Количество = Неопределено)
	
	Результат = Новый Массив;
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, "ISO-8859-1", Символы.ПС, Символы.ПС);
	
	Прочтено = 0;
	Пока Позиция > Прочтено Цикл
		ДлинаБлока = Позиция - Прочтено;
		ДлинаБлока = ?(ДлинаБлока <= 1000000, ДлинаБлока, 1000000);
		ТекстИзФайла = ЧтениеТекста.Прочитать(ДлинаБлока);
		Если ТекстИзФайла = Неопределено ИЛИ СтрДлина(ТекстИзФайла) < ДлинаБлока Тогда
			ЧтениеТекста.Закрыть();
			Возврат Результат;
		КонецЕсли;
		Прочтено = Прочтено + ДлинаБлока;
	КонецЦикла;
	
	Осталось = Количество;
	Пока Осталось = Неопределено ИЛИ Осталось > 0 Цикл
		СимволТекста = ЧтениеТекста.Прочитать(1);
		Если СимволТекста = Неопределено Тогда
			Прервать;
		КонецЕсли;
		КодСимволаТекста = КодСимвола(СимволТекста);
		
		Результат.Добавить(КодСимволаТекста);
		
		Если Осталось <> Неопределено Тогда
			Осталось = Осталось - 1;
		КонецЕсли;
	КонецЦикла;
	ЧтениеТекста.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьФайлИзМассива(ИмяФайла, Массив)
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, "ISO-8859-1", Символы.ПС, , Символы.ПС);
	
	Для ИндексВМассиве = 0 По Массив.ВГраница() Цикл
		СимволИзМассива = Символ(Массив[ИндексВМассиве]);
		ЗаписьТекста.Записать(СимволИзМассива);
	КонецЦикла;
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

Функция СкопироватьФрагментИзФайла(ИмяФайла, ИмяФайлаРезультата, Позиция = 0, Количество = Неопределено)
	
	Скопировано = 0;
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, "ISO-8859-1", Символы.ПС, Символы.ПС);
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайлаРезультата, "ISO-8859-1", Символы.ПС, , Символы.ПС);
	
	Прочтено = 0;
	Пока Прочтено < Позиция Цикл
		ДлинаБлока = Позиция - Прочтено;
		ДлинаБлока = ?(ДлинаБлока <= 1000000, ДлинаБлока, 1000000);
		ТекстИзФайла = ЧтениеТекста.Прочитать(ДлинаБлока);
		Если ТекстИзФайла = Неопределено ИЛИ СтрДлина(ТекстИзФайла) < ДлинаБлока Тогда
			ЗаписьТекста.Закрыть();
			ЧтениеТекста.Закрыть();
			Возврат Скопировано;
		КонецЕсли;
		Прочтено = Прочтено + ДлинаБлока;
	КонецЦикла;
	
	Пока Количество = Неопределено ИЛИ Скопировано < Количество Цикл
		ДлинаБлока = ?(Количество <> Неопределено И Количество - Скопировано <= 1000000, Количество - Скопировано, 1000000);
		ТекстИзФайла = ЧтениеТекста.Прочитать(ДлинаБлока);
		Если ТекстИзФайла <> Неопределено Тогда
			ЗаписьТекста.Записать(ТекстИзФайла);
			Скопировано = Скопировано + СтрДлина(ТекстИзФайла);
		КонецЕсли;
		Если ТекстИзФайла = Неопределено ИЛИ СтрДлина(ТекстИзФайла) < ДлинаБлока Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗаписьТекста.Закрыть();
	ЧтениеТекста.Закрыть();
	
	Возврат Скопировано;
	
КонецФункции

