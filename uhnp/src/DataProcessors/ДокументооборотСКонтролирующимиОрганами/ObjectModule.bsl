	Возврат Результат;
	
КонецФункции

Функция СпособыАвторизацииОблачнойПодписи() Экспорт
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(0, "Первичный_УчетныеДанные"); // Отсутствует - по умолчанию
	Результат.Вставить(1, "Первичный_УчетныеДанные"); // Только идентификация - с пустым паролем
	Результат.Вставить(2, "Первичный_СертификатАвторизации"); // Аутентификация по сертификату
	Результат.Вставить(3, "Первичный_УчетныеДанные"); // Аутентификация по паролю
	Результат.Вставить(4, "Первичный_УчетныеДанные"); // Аутентификация по SAML-токену - по умолчанию
	Результат.Вставить(5, "Вторичный_СМС"); // Аутентификация по SMS
	Результат.Вставить(6, "Первичный_КодАвторизации"); // Аутентификация по протоколу OATH
	Результат.Вставить(7, "Первичный_ДвухФакторная"); // Аутентификация по SIM-карте - по умолчанию
	Результат.Вставить(8, "Вторичный_ЭлектроннаяПочта"); // Аутентификация по электронной почте
	Результат.Вставить(9, "Вторичный_МобильноеПриложение"); // Аутентификация c помощью мобильного приложения
	Результат.Вставить(10, "Вторичный_СМС"); // Аутентификация c помощью обмена MT/MO сообщениями - по умолчанию
	Результат.Вставить(11, "Вторичный_СМС"); // Аутентификация c помощью MO сообщения - по умолчанию
	Результат.Вставить(12, "Вторичный_AirKeyLite"); // Аутентификация c помощью мобильного приложения AirKey
	Результат.Вставить(13, "Первичный_ДвухФакторная"); // Аутентификация c помощью Rutoken - по умолчанию
	Результат.Вставить(14, "Первичный_ДвухФакторная"); // Аутентификация c помощью JaCarta и eToken - по умолчанию
	Результат.Вставить(15, "Первичный_ДвухФакторная"); // Аутентификация "myDSS for Desktop" - по умолчанию
	Результат.Вставить(16, "Вторичный_DSSSDK"); // Аутентификация c помощью мобильного приложения 2.0
	
	// дополнительные случаи
	Результат.Вставить(-2, "Первичный_ДвухФакторная"); // аутентификация требует подтверждения
	Результат.Вставить(-1, "Первичный_КодАвторизации"); // кастомизированный способ пользователя
	
	Возврат Результат;
	
КонецФункции	

Функция СвойствоСтруктуры(ДанныеСтруктуры, Знач ПутьДанных, ЗначениеПоУмолчанию = Неопределено)
	
	МодульСервисКриптографииDSSКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СервисКриптографииDSSКлиентСервер");
	Результат = МодульСервисКриптографииDSSКлиентСервер.ПолучитьПолеСтруктуры(ДанныеСтруктуры, ПутьДанных, ЗначениеПоУмолчанию);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыПодтвержденияОблачнойПодписи(СсылкаСправочника, Принудительно = Ложь) Экспорт
	
	ПервичнаяОтправка = ДокументооборотСКОВызовСервера.ТипПервичныхСообщений();
	СписокОпераций = Новый Соответствие;
	Для Каждого СтрокаМассива Из ПервичнаяОтправка Цикл
		СписокОпераций.Вставить(СтрокаМассива, Истина);
	КонецЦикла;	
	
	// дополним специальными операциями
	СписокОпераций.Вставить("ЗагрузкаЭЛН", Истина);
	СписокОпераций.Вставить("ОперацииСЭЛН", Истина);
	СписокОпераций.Вставить("ПодтверждениеВидаДеятельности", Истина);
	СписокОпераций.Вставить("ЗаявлениеНаПодключение", Истина);
	СписокОпераций.Вставить("ЗаявлениеНаПодключениеСканы", Истина);
	СписокОпераций.Вставить("ОписьИсходящихДокументовВФНС", Истина);
	СписокОпераций.Вставить("ЖурналСчетовФактурВФНС", Истина);
	СписокОпераций.Вставить("ПакетДляОтправкиВФСС", Истина);
	СписокОпераций.Вставить("ПакетДляОтправкиВФСРАР", Истина);
	СписокОпераций.Вставить("ПакетДляОтправкиВРПН", Истина);
	СписокОпераций.Вставить("ОтветНаТребованиеПоясненийКДекларацииНДС", Истина);
	СписокОпераций.Вставить("ОтправкаВФТС", Истина);
	СписокОпераций.Вставить("ПакетСОС", Истина);
	
	// служебные операции
	СписокОпераций.Вставить("ЗаявлениеВПФР", Ложь);
	СписокОпераций.Вставить("СформироватьПакетФНС", Ложь);
	СписокОпераций.Вставить("СформироватьПакетПФР", Ложь);
	СписокОпераций.Вставить("СформироватьПакетФСГС", Ложь);
	СписокОпераций.Вставить("СформироватьПакетФНС", Ложь);
	СписокОпераций.Вставить("СформироватьПакетСОС", Ложь);
	СписокОпераций.Вставить("ПакетДляОтправкиВФСРАРЗавершение", Ложь);
	
	Результат = Новый Структура;
	ТекущийРежим = 1;
	// 1 - По умолчанию, определяется в коде программе
	// 2 - Все отключено
	// 3 - Все подтверждать (режим тестирования)
	// 4 - Выборочный режим
	
	Если ТипЗнч(СсылкаСправочника) = Тип("Структура") Тогда
		НастройкиПользователя = СсылкаСправочника;
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		НастройкиПользователя = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СсылкаСправочника, "ПодтверждениеОперацийОблачнойПодписи");
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;	
	
	Если НастройкиПользователя <> Неопределено Тогда
		ТекущийРежим = СвойствоСтруктуры(НастройкиПользователя, "РежимПодтверждения", 1);
		ТекущийСписокОпераций = СвойствоСтруктуры(НастройкиПользователя, "СписокОпераций", СписокОпераций);
		
		Если ТекущийРежим = 4 ИЛИ Принудительно Тогда
			Для Каждого СтрокаКлюча Из ТекущийСписокОпераций Цикл
				Если СписокОпераций[СтрокаКлюча.Ключ] <> Неопределено Тогда
					СписокОпераций.Вставить(СтрокаКлюча.Ключ, СтрокаКлюча.Значение);
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("РежимПодтверждения", ТекущийРежим); 
	Результат.Вставить("СписокОпераций", СписокОпераций);
	
	Возврат Результат;
	
КонецФункции

Функция ПоказатьПанельНовойКриптографии(НовоеЗначение = Неопределено, ДополнениеПараметра = Ложь) Экспорт
	
	Результат = Ложь;
	ЭтоСервис = КриптографияЭДКО.РаботаВМоделиСервиса();
	ЕстьПодсистема = КриптографияЭДКО.ДоступнаПодсистемаКриптографииDSS();
	
	Если ЭтоСервис И ЕстьПодсистема Тогда
		
		Если ДополнениеПараметра = Истина Тогда
			ИмяПараметра = "УведомлениеПевичноеЗаявление";
		ИначеЕсли ДополнениеПараметра = Ложь Тогда
			ИмяПараметра = "УведомлениеЗаявлениеНаИзменение";
		Иначе
			ИмяПараметра = "Уведомление";
		КонецЕсли;
		
		Если НовоеЗначение <> Неопределено Тогда
			Результат = НовоеЗначение;
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("СервисКриптографииDSS", ИмяПараметра, НовоеЗначение);
		Иначе
			Результат = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("СервисКриптографииDSS", ИмяПараметра, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Ложь;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодключениеКСервисамКалугиАстрал

Функция ВыполнитьЗапросREST(АдресСервера, АдресМетода, ПараметрыМетода = Неопределено, МетодЗапроса = "GET", Заголовки = Неопределено, ТаймАут = 60)
	
	Результат = Новый Структура("Выполнено, Ошибка, Результат", Ложь, "", Неопределено);
	
	Путь = АдресМетода;
	
	ПараметрыЗапроса = Неопределено;
	
	Если Заголовки = Неопределено Тогда
		Заголовки = Новый Соответствие;
	КонецЕсли;	
	
	Если ПараметрыМетода <> Неопределено Тогда
		ПараметрыЗапроса = "";
		Если МетодЗапроса = "GET" Тогда
			Для Каждого СтрокаКлюча Из ПараметрыМетода Цикл
				ПараметрыЗапроса = ПараметрыЗапроса + ?(ПустаяСтрока(ПараметрыЗапроса), "", "&");
				ЗначениеПараметра = СтрокаКлюча.Значение;
				ПараметрыЗапроса = ПараметрыЗапроса + СтрокаКлюча.Ключ + "=" + ЗначениеПараметра;
			КонецЦикла;
			Путь = Путь + ?(ПустаяСтрока(ПараметрыЗапроса), "", "?" + ПараметрыЗапроса);
		ИначеЕсли ТипЗнч(ПараметрыМетода) = Тип("ДвоичныеДанные") Тогда
			ПараметрыЗапроса = ПараметрыМетода;
		ИначеЕсли ТипЗнч(ПараметрыМетода) <> Тип("Строка") Тогда
			ПараметрыЗапроса = JsonИзСтруктуры(ПараметрыМетода);
		Иначе
			ПараметрыЗапроса = ПараметрыМетода;
		КонецЕсли;
	КонецЕсли;
	
	Попытка 
		Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(АдресСервера, , ТаймАут);
		
		Запрос = Новый HTTPЗапрос(Путь, Заголовки);
		
		Если ТипЗнч(ПараметрыЗапроса) = Тип("Строка") Тогда
			Запрос.УстановитьТелоИзСтроки(ПараметрыЗапроса);
		ИначеЕсли ТипЗнч(ПараметрыЗапроса) = Тип("ДвоичныеДанные") Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(ПараметрыЗапроса);
		КонецЕсли;	
		
		ОтветСервиса = Соединение.ВызватьHTTPМетод(МетодЗапроса, Запрос);
		
		ТелоКакСтрока = ОтветСервиса.ПолучитьТелоКакСтроку();
		
		Если ОтветСервиса.КодСостояния = 200 Тогда
			Результат.Результат = JsonВСтруктуру(ТелоКакСтрока);
			Результат.Выполнено = Истина;
		Иначе
			Результат.Ошибка = ТелоКакСтрока;
		КонецЕсли;
		
	Исключение
		ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Вызов REST сервиса: ';
							|en = 'EDI with regulatory authorities. Call REST service:'", ОбщегоНазначения.КодОсновногоЯзыка()) + АдресСервера;
		ДанныеОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			ИмяСобытия ,
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ДанныеОшибки));
		Результат.Ошибка = КраткоеПредставлениеОшибки(ДанныеОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции	

Функция ПараметрыПодключенияСервисовОблачнойПодписи(ИмяТочкиПодключения)
	
	АдресСервера = "https://reg-api.keydisk.ru";
	
	ВсеАдреса = новый Структура();
	ВсеАдреса.Вставить("РеестрСерверов", "/api/v1/dssapi/GetDssList");
	ВсеАдреса.Вставить("АктивироватьУчетнуюЗапись", "/api/v1/dssapi/ActivatePassword?skid=%1&guid=%2");
	ВсеАдреса.Вставить("ПроверитьЛогин", "/api/v1/DssUserInfo/CheckLogin");
	ВсеАдреса.Вставить("АктивироватьКлючМобильногоПриложения", "/api/v1/dssapi/ActivateKeyAndGetActivationCode?skid=%1&guid=%2");
	ВсеАдреса.Вставить("СвойствоУчетнойЗаписи", "/api/v1/dssapi/PropertyLogin");
	ВсеАдреса.Вставить("ОтправитьКодАктивацииКлюча", "/api/v1/dssapi/GetActivationCode?skid=%1&guid=%2");
	
	Результат = Новый Структура;
	Результат.Вставить("АдресСервера", АдресСервера);
	Результат.Вставить("АдресЗапроса", ВсеАдреса[ИмяТочкиПодключения]);
	
	Возврат Результат;
	
КонецФункции	
	
Функция ОбменССерверомСписокСерверовОблачнойПодписи(ПараметрыФункции) Экспорт
	
	СписокСерверов = Новый Массив();
	СпецоператорСвязи = ПараметрыФункции.СпецоператорСвязи;
	ВнутреннийИдентификатор = СвойствоСтруктуры(ПараметрыФункции, "ВнутреннийИдентификатор", "");
	ТаймАут = СвойствоСтруктуры(ПараметрыФункции, "ТаймАут", 60);
	РежимТестирования = Константы.ДокументооборотСКонтролирующимиОрганами_РежимТестирования.Получить();
	
	ПараметрыПодключения = ПараметрыПодключенияСервисовОблачнойПодписи("РеестрСерверов");
	ПараметрыЗапроса= Новый Структура;
	
	ОтветСервиса 	= ВыполнитьЗапросREST(ПараметрыПодключения.АдресСервера, ПараметрыПодключения.АдресЗапроса, ПараметрыЗапроса, , , ТаймАут);
	Если ОтветСервиса.Выполнено Тогда
		СоответствиеТипов = СпособыАвторизацииОблачнойПодписи();

		Для Каждого ТекущийЭлемент Из ОтветСервиса.Результат Цикл
			
			АдресСервера = СвойствоСтруктуры(ТекущийЭлемент, "srvUri", "");
			НаименованиеСервера = АдресСервера;
			ИдентификаторСервера = СвойствоСтруктуры(ТекущийЭлемент, "prvId", "");
			Используется = СвойствоСтруктуры(ТекущийЭлемент, "isUsed", Истина);
			
			Если ЗначениеЗаполнено(ВнутреннийИдентификатор)
				И НРег(ВнутреннийИдентификатор) <> НРег(АдресСервера)
				И НРег(ВнутреннийИдентификатор) <> НРег(ИдентификаторСервера) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ РежимТестирования 
				И (СтрНайти(ИдентификаторСервера, "ASTRAL") > 0 ИЛИ НЕ Используется) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИдентификаторСервера = "realsts" Тогда
				НаименованиеСервера = "1С:DSS";
			КонецЕсли;
			
			ОписаниеСервиса = ПолучитьОписаниеСервисаОблачнойПодписи();
			
			ОписаниеСервиса.Наименование = НаименованиеСервера;
			ОписаниеСервиса.АдресСервера = АдресСервера;
			ОписаниеСервиса.СервисПодписи = СвойствоСтруктуры(ТекущийЭлемент, "sgnSrv", "");
			ОписаниеСервиса.СервисИдентификации = СвойствоСтруктуры(ТекущийЭлемент, "stsSrv", "");
			ОписаниеСервиса.СервисПроверки = СвойствоСтруктуры(ТекущийЭлемент, "verSrv", "");
			ОписаниеСервиса.ИдентификаторЦИ = СвойствоСтруктуры(ТекущийЭлемент, "stsId", "");
			ОписаниеСервиса.ИдентификаторСЭП = СвойствоСтруктуры(ТекущийЭлемент, "sgnId", "");
			
			ОписаниеСервиса.Используется = СвойствоСтруктуры(ТекущийЭлемент, "isUsed", Истина);
			ОписаниеСервиса.ТаймАут = СвойствоСтруктуры(ТекущийЭлемент, "timeout", 120);
			ОписаниеСервиса.ВерсияАПИ = СвойствоСтруктуры(ТекущийЭлемент, "apiVer", "");
			Если СвойствоСтруктуры(ТекущийЭлемент, "apiVer", "") = "2.0" Тогда
				ОписаниеСервиса.ВерсияАПИ = "2.0.3284";
			КонецЕсли;
			ОписаниеСервиса.ВерсияАПИ = "2.0.2882";
			
			ОписаниеСервиса.АдресЛичногоКабинета = СвойствоСтруктуры(ТекущийЭлемент, "accUri", "");
			ОписаниеСервиса.ВнутреннийИдентификатор = ИдентификаторСервера;
			
			ОписаниеСервиса.ПользовательШифрования = СвойствоСтруктуры(ТекущийЭлемент, "pubUser", "");
			ОписаниеСервиса.ПарольПользовательШифрования = СвойствоСтруктуры(ТекущийЭлемент, "pubUserPassword", "");
			
			ВариантАутентификации = СвойствоСтруктуры(ТекущийЭлемент, "authMeth", 3);
			СпособАвторизации = СвойствоСтруктуры(ТекущийЭлемент, "cfrmMeth", 9);
			
			Если ВариантАутентификации = 3 И СпособАвторизации = 9 Тогда
				ВариантАутентификации = -2;
			ИначеЕсли ВариантАутентификации = 3 И СпособАвторизации = 16 Тогда
				ВариантАутентификации = -2;
			КонецЕсли;
			
			ОграничениеАвторизации = Новый Массив;
			ОграничениеАвторизации.Добавить(СоответствиеТипов[0]);
			ОграничениеАвторизации.Добавить(СоответствиеТипов[ВариантАутентификации]);
			ОграничениеАвторизации.Добавить(СоответствиеТипов[СпособАвторизации]);
			
			ОписаниеСервиса.ОграничениеАвторизации = СтрСоединить(ОграничениеАвторизации, ",");
			
			СписокСерверов.Добавить(ОписаниеСервиса);
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат СписокСерверов;
	
КонецФункции

Функция ОбменССерверомПроверитьЛогин(ПараметрыФункции) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Пройден", Неопределено);
	Результат.Вставить("Варианты", "");
	
	ПараметрыПодключения = ПараметрыПодключенияСервисовОблачнойПодписи("ПроверитьЛогин");
	Логин = ПараметрыФункции.Логин;
	ВнутреннийИдентификатор = ПараметрыФункции.ВнутреннийИдентификатор;
	ТаймАут = СвойствоСтруктуры(ПараметрыФункции, "ТаймАут", 30);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("login", Логин);
	Если ЗначениеЗаполнено(ВнутреннийИдентификатор) Тогда
		ПараметрыЗапроса.Вставить("prvId", ВнутреннийИдентификатор);
	КонецЕсли;
	
	ОтветСервиса = ВыполнитьЗапросREST(ПараметрыПодключения.АдресСервера, ПараметрыПодключения.АдресЗапроса, ПараметрыЗапроса, , , ТаймАут);
	Если ОтветСервиса.Выполнено Тогда
		Если СвойствоСтруктуры(ОтветСервиса.Результат, "code", -1) = 0 Тогда
			Результат.Пройден = СвойствоСтруктуры(ОтветСервиса.Результат, "isFree", Ложь);
			Результат.Варианты = СвойствоСтруктуры(ОтветСервиса.Результат, "Login", "");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбменССерверомАктивироватьУчетнуюЗапись(ПараметрыФункции) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Истина);
	Результат.Вставить("Результат", Ложь);
	
	ПараметрыПодключения = ПараметрыПодключенияСервисовОблачнойПодписи("АктивироватьУчетнуюЗапись");
	ПодписьПароля = ПараметрыФункции.ПодписьПароля;
	ИдентификаторСубъекта = ПараметрыФункции.ИдентификаторСубъекта;
	ДанныеПодписи = ПараметрыФункции.ДанныеПодписи;
	
	АдресЗапроса = СтрШаблон(ПараметрыПодключения.АдресЗапроса, ИдентификаторСубъекта, ПодписьПароля);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	ОтветСервиса = ВыполнитьЗапросREST(ПараметрыПодключения.АдресСервера, АдресЗапроса, JsonИзСтруктуры(Base64Строка(ДанныеПодписи)), "POST", Заголовки);
	Если ОтветСервиса.Выполнено Тогда
		Если СвойствоСтруктуры(ОтветСервиса.Результат, "code", "-1") = "0" Тогда
			Результат.Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
