КонецФункции

Функция НайтиФайлОбращенияКСтрахователю(Обращение, ИмяФайла, НомерФайла)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбращениеСФРКСтрахователюПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбращениеСФРКСтрахователюПрисоединенныеФайлы КАК ОбращениеСФРКСтрахователюПрисоединенныеФайлы
	|ГДЕ
	|	НЕ ОбращениеСФРКСтрахователюПрисоединенныеФайлы.ПометкаУдаления
	|	И ОбращениеСФРКСтрахователюПрисоединенныеФайлы.ВладелецФайла = &ОбращениеСсылка
	|	И ОбращениеСФРКСтрахователюПрисоединенныеФайлы.НомерФайла = &НомерФайла
	|	И ОбращениеСФРКСтрахователюПрисоединенныеФайлы.Наименование = &Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбращениеСФРКСтрахователюПрисоединенныеФайлы.ДатаСоздания";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОбращениеСсылка", Обращение);
	Запрос.УстановитьПараметр("НомерФайла", НомерФайла);
	Запрос.УстановитьПараметр("Наименование", ИмяФайла);
	ТаблицаФайлов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаФайлов;
	
КонецФункции

Функция СвойстваОбращениеСФРКСтрахователю(Объект) Экспорт
	
	Ссылка = Объект.Ссылка;
	
	ДанныеОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Дата, Организация, ДатаОтправкиОтвета");
	
	// Наименование
	Наименование = НСтр("ru = 'Обращение СФР к страхователю';
						|en = 'Ticket of the Social Security Fund of Russia to the insurant'");
	КодКонтролирующегоОргана = "";
	
	// Вид и код контролирующего органа
	ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФСС;
	Организация = ДанныеОбъекта.Организация;
	
	// Запись в регистр
	ЗначенияЗаполнения = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ПараметрыПроцедурыСоздатьЗаписьВРегистреЖурналОтправокВКонтролирующиеОрганы();
	ЗначенияЗаполнения.Ссылка 					= Ссылка;
	ЗначенияЗаполнения.ДатаСоздания				= ДанныеОбъекта.Дата;
	ЗначенияЗаполнения.Наименование 			= Наименование;
	ЗначенияЗаполнения.ВидКонтролирующегоОргана = ВидКонтролирующегоОргана;
	ЗначенияЗаполнения.КодКонтролирующегоОргана = КодКонтролирующегоОргана;
	ЗначенияЗаполнения.Организация 				= Организация;
	ЗначенияЗаполнения.СтраницаЖурнала			= Перечисления.СтраницыЖурналаОтчетность.Входящие;
	ЗначенияЗаполнения.ВидДокумента				= Перечисления.ВидыДокументовВЖурнале.ВходящееПисьмо;
	ЗначенияЗаполнения.Комментарий				= Ссылка.Комментарий;
	ЗначенияЗаполнения.ЕстьОтвет				= ЗначениеЗаполнено(ДанныеОбъекта.ДатаОтправкиОтвета);
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

