Функция ЗаписатьXMLВФайл(ТекстДляЗаписи, ФайлДляЗаписи, Кодировка = "windows-1251", УдалятьBOM = Ложь) Экспорт
	
	Попытка
		ПотокЗаписи = Новый ЗаписьТекста(ФайлДляЗаписи, Кодировка, , , Символы.ПС);
		ПотокЗаписи.Записать(ТекстДляЗаписи);
		ПотокЗаписи.Закрыть();
		
		Если (нрег(Кодировка) = "utf-8" ИЛИ Кодировка = КодировкаТекста.UTF8) И УдалятьBOM Тогда
			// удалим из файла в кодировке "UTF-8" сигнатуру BOM
			ДанныеФайла = Новый ДвоичныеДанные(ФайлДляЗаписи);
			Данные64 = Base64Строка(ДанныеФайла);
			Данные64БезBOM = Сред(Данные64, 5);
			ДанныеФайлаБезBOM = Base64Значение(Данные64БезBOM);
			ДанныеФайлаБезBOM.Записать(ФайлДляЗаписи);
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Не удалось записать файл XML:%1';
								|en = 'Cannot write XML file:%1'"), Символы.ПС + ИнформацияОбОшибке().Описание);
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	Конецпопытки;
	Возврат Истина;
	
КонецФункции

