#Область ДокументооборотСФСС

Функция СформироватьФайлОтправкиВФССССервера(
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ЭтоАдреса = Истина,
		Адрес = Неопределено,
		ТипОтправляемогоДокумента = Неопределено,
		ВидОтправляемогоДокумента = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СтрокаBase64ФайлаПакета", 	СтрокаBase64ФайлаПакета);
	Результат.Вставить("СтрокаBase64ФайлаОтправки", Неопределено);
	
	ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС);
	ЭтоПодтверждениеВидаДеятельности =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента =
		Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам);
	ЭтоАдресТекстаТребуетКонвертации = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
		ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	
	Если ЭтоАдресТекстаТребуетКонвертации Тогда
		ТекстФайлаПакета = ПолучитьИзВременногоХранилища(СтрокаBase64ФайлаПакета);
		ИмяФайлаПакета = ПолучитьИмяВременногоФайла();
		ЗаписьФайлаПакета = Новый ЗаписьТекста(ИмяФайлаПакета, "utf-8");
		ЗаписьФайлаПакета.Записать(ТекстФайлаПакета);
		ЗаписьФайлаПакета.Закрыть();
		ДвоичныеДанныеФайлаПакета = Новый ДвоичныеДанные(ИмяФайлаПакета);
	КонецЕсли;
	
	//файл отправки является файлом пакета
	Если ЭтоАдреса Тогда
		Если ЭтоАдресТекстаТребуетКонвертации Тогда
			Результат.СтрокаBase64ФайлаПакета = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПакета,
				СтрокаBase64ФайлаПакета);
		Иначе
			ДвоичныеДанныеФайлаПакета = ПолучитьИзВременногоХранилища(СтрокаBase64ФайлаПакета);
		КонецЕсли;
		Результат.СтрокаBase64ФайлаОтправки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПакета, Адрес);
		
	Иначе
		Если ЭтоАдресТекстаТребуетКонвертации Тогда
			Результат.СтрокаBase64ФайлаПакета = Base64Строка(ДвоичныеДанныеФайлаПакета);
		КонецЕсли;
		Результат.СтрокаBase64ФайлаОтправки = Результат.СтрокаBase64ФайлаПакета;
	КонецЕсли;
	
	Если ЭтоАдресТекстаТребуетКонвертации Тогда
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаПакета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьРезультатКонкретнойОтправкиФССССервера(
		ОтправкаСсылка,
		ПолученРезультатОтСервераФСС,
		НастройкиССервера,
		АдресЗашифрованногоЗапросаSOAP = Неопределено,
		АдресЗашифрованногоОтветаSOAP = Неопределено) Экспорт
	
	ИнформацияОбОтправляемомДокументе = ПолучитьТипВидаОтправляемогоДокументаПоСсылкеНаОбъектОтправкиДляФСС(
		ОтправкаСсылка,
		Истина);
	Если ИнформацияОбОтправляемомДокументе = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента = ИнформацияОбОтправляемомДокументе.ВидОтправляемогоДокумента;
	
	АдресСервера = СерверПриемаОтчетностиФСС(ТипОтправляемогоДокумента, ВидОтправляемогоДокумента);
	
	Если АдресСервера = Неопределено Тогда
		
		Если ОтправкаСсылка.ВидОтчета <> Справочники.ВидыОтправляемыхДокументов.ДокументСЭДО Тогда
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить тип документа!';
																|en = 'Cannot determine a document type.'"));
		КонецЕсли;
		Возврат;
	
	КонецЕсли;
	
	НастройкиССервера = Новый Структура("АдресСервера, РазделениеВключено", АдресСервера, ОбщегоНазначения.РазделениеВключено());
	
	РезультатОтправки = ПолучитьРезультатОтправкиФСС(
		АдресСервера,
		ОтправкаСсылка.ИдентификаторОтправкиНаСервере,
		ОтправкаСсылка,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		АдресЗашифрованногоЗапросаSOAP);
	ПолученРезультатОтСервераФСС = (РезультатОтправки <> Неопределено);
	Если РезультатОтправки <> Неопределено И РезультатОтправки.Свойство("АдресЗашифрованногоОтветаSOAP") Тогда
		АдресЗашифрованногоОтветаSOAP = РезультатОтправки.АдресЗашифрованногоОтветаSOAP;
	Иначе
		СохранитьРезультатОтправкиФСС(ОтправкаСсылка, РезультатОтправки);
	КонецЕсли;
	
	Если НЕ ПолученРезультатОтСервераФСС Тогда
		ПредставлениеОтчетаОтправки = ПредставлениеОтчета(ОтправкаСсылка.ОтчетСсылка);
		НастройкиССервера.Вставить("ПредставлениеОтчетаОшибки", ПредставлениеОтчетаОтправки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРезультатОтправкиФСС(
		АдресСервера,
		ИдентификаторОтправкиНаСервере,
		ОтправкаСсылка,
		ТипОтправляемогоДокумента = Неопределено,
		ВидОтправляемогоДокумента = Неопределено,
		АдресЗашифрованногоЗапросаSOAP = Неопределено)
	
	Результат = Новый Структура;
	
	НаименованиеОтчета = "";
	
	СсылкаКвитанция = "";
	СсылкаПротоколОшибок = "";
	СтатусОтчета = "";
	ЦветСтатуса = ЦветаСтиля.ЦветНезавершившейсяОтправкиБРО;
	СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен;
	ЕстьОшибки = Ложь;
	
	//запрос протокола обработки
	КодировкаФайла = "utf-8";
	ОтчетСдан = Неопределено;
	ОтчетСданСОшибками = Неопределено;
	ЕстьОшибкиФорматногоКонтроля = Неопределено;
	ЕстьПрочиеОшибки = Неопределено;
	ТекстПоследнейОшибкиВебСервиса = "";
	КвитанцияОтсутствует = Неопределено;
	ДвоичныеДанныеКвитанции = Неопределено;
	ТЗОбработки = Новый ТаблицаЗначений;
	
	ЭтоПодтверждениеВидаДеятельности =
		(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	ЭтоПодписьИШифрованиеSOAP = ЭтоПодтверждениеВидаДеятельности;
	
	ИспользуетсяВебСервис = СтрНайти(ИдентификаторОтправкиНаСервере, "-") <> 9 ИЛИ ЭтоПодписьИШифрованиеSOAP;
	
	Если ИспользуетсяВебСервис Тогда
		// если отправка с использованием API
		
		// устанавливаем соединение с сервером
		Если ЭтоПодписьИШифрованиеSOAP Тогда
			Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета("https://" + АдресСервера,, 120);
		Иначе
			Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(АдресСервера);
		КонецЕсли;
		Если Соединение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ЭтоПодписьИШифрованиеSOAP Тогда
			РесурсНаСервере = "/ws-gtw-okved-confirm/api/soap/v1/OkvedconfirmGatewayService";
			
		ИначеЕсли ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
		И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС Тогда
			РесурсНаСервере = "/F4ExtService/ExtService.svc";
			ПространствоИменСервиса = "http://tempuri.org/";
			ИмяСервиса = "IExtService";
			
		Иначе
			РесурсНаСервере = "/ExtService/GatewayService.svc";
			ПространствоИменСервиса = "http://asystems.fss";
			ИмяСервиса = "IGatewayService";
		КонецЕсли;
		
		РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(РесурсНаСервере, "{FSS}" + РесурсНаСервере, Соединение);
		
		Если ЭтоПодписьИШифрованиеSOAP Тогда
			// формируем общие заголовки зашифрованного запроса SOAP
			ЗаголовкиHTTP = Новый Соответствие();
			ЗаголовкиHTTP.Вставить("Content-Type", "text/xml; charset=utf-8");
			ЗаголовкиHTTP.Вставить("SOAPAction", "http://gtw.ws.fss.ru/openservice/okvedconfirm/getResultById");
			ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
			
			ТекстЗапросаSOAP = ПолучитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
			УдалитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
			
		Иначе
			// формируем общие заголовки запроса SOAP
			ЗаголовкиHTTP = Новый Соответствие();
			ЗаголовкиHTTP.Вставить("Content-Type", "application/soap+xml; charset=utf-8");
			ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
			
			ТекстЗапросаSOAP =
				"<s:Envelope xmlns:s=""http://www.w3.org/2003/05/soap-envelope"" xmlns:a=""http://www.w3.org/2005/08/addressing"">
				|	<s:Header>
				|		<a:Action s:mustUnderstand=""1"">" + ПространствоИменСервиса + ?(Прав(ПространствоИменСервиса, 1) <> "/", "/", "")
							+ ИмяСервиса + "/UploadGetByExtID</a:Action>
				|		<a:To s:mustUnderstand=""1"">http://" + АдресСервера + РесурсНаСервере + "</a:To>
				|	</s:Header>
				|	<s:Body>
				|		<UploadGetByExtID xmlns=""" + ПространствоИменСервиса + """>
				|			<id>" + ИдентификаторОтправкиНаСервере + "</id>
				|		</UploadGetByExtID>
				|	</s:Body>
				|</s:Envelope>";
		КонецЕсли;
		
		ИмяФайлаSOAP = ПолучитьИмяВременногоФайла();
		ТекстовыйФайлSOAP = Новый ЗаписьТекста(ИмяФайлаSOAP, "utf-8");
		ТекстовыйФайлSOAP.Записать(ТекстЗапросаSOAP);
		ТекстовыйФайлSOAP.Закрыть();
		
		// посылаем запрос
		ФайлРезультата = ПолучитьИмяВременногоФайла();
		Попытка
			Соединение.ОтправитьДляОбработки(ИмяФайлаSOAP, РесурсНаСервере, ФайлРезультата, ЗаголовкиHTTP);
		Исключение
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаSOAP);
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Для ИндексПричиныОшибки = 1 По 5 Цикл
				Если НЕ ЭтоПодписьИШифрованиеSOAP И СтрНайти(ИнформацияОбОшибке.Описание, "ExtServiceException") > 0 Тогда
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
						ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(НСтр("ru = 'Сбой на сервере ФСС.';
																				|en = 'SSF server failed.'"), Истина));
					Возврат Результат;
					
				ИначеЕсли ЭтоПодписьИШифрованиеSOAP
					И СтрНайти(ИнформацияОбОшибке.Описание, "http://schemas.xmlsoap.org/soap/envelope/") > 0
					И СтрНайти(ИнформацияОбОшибке.Описание, "<faultstring>") > 0 Тогда
					
					ОписаниеОшибкиСервером = ТекстПослеПрефикса(ИнформацияОбОшибке.Описание, "<faultstring>", "<");
					ОписаниеОшибкиСервером = ТекстИзHTML(ОписаниеОшибкиСервером);
					ОписаниеОшибкиСервером = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Ошибка сервера ФСС.';
							|en = 'SSF server error.'"), Истина) + " " + СокрЛ(ОписаниеОшибкиСервером);
					ОписаниеОшибкиСервером = СокрЛП(ОписаниеОшибкиСервером);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ОписаниеОшибкиСервером);
					Возврат Результат;
				КонецЕсли;
				
				Если ИнформацияОбОшибке.Причина = Неопределено Тогда
					Прервать;
				КонецЕсли;
				ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
			КонецЦикла;
			
			Возврат Неопределено;
		КонецПопытки;
		
		ТекстовыйФайлРезультата = Новый ЧтениеТекста(ФайлРезультата, "utf-8");
		ТекстРезультата = ТекстовыйФайлРезультата.Прочитать();
		ТекстовыйФайлРезультата.Закрыть();
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаSOAP);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлРезультата);
		
		Если НЕ ЗначениеЗаполнено(ТекстРезультата) Тогда
			ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Сбой на сервере ФСС.';
							|en = 'SSF server failed.'"), Истина);
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			Возврат Результат;
		КонецЕсли;
		
		РезультатИзвлечения = ИзвлечьРезультатSOAP(
			ТекстРезультата,
			?(ЭтоПодписьИШифрованиеSOAP, "", "UploadGetByExtID"),
			ЭтоПодписьИШифрованиеSOAP);
		УзелРезультата 	= РезультатИзвлечения.УзелРезультата;
		ТекстОшибки 	= РезультатИзвлечения.ТекстОшибки;
		Если УзелРезультата = Неопределено Тогда
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			Иначе
				ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка формата ответа сервера ФСС. Вероятно, отправка была удалена на сервере';
						|en = 'An error of SSF server response format. The sending might have been deleted on the server'"), Истина);
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СФР';
						|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Security Fund of Russia'"),
					УровеньЖурналаРегистрации.Ошибка,,,
					ТекстОшибки);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		
		Если ЭтоПодписьИШифрованиеSOAP Тогда
			АдресЗашифрованногоОтветаSOAP = ПоместитьВоВременноеХранилище(ТекстРезультата, Новый УникальныйИдентификатор);
			Возврат Новый Структура("АдресЗашифрованногоОтветаSOAP", АдресЗашифрованногоОтветаSOAP);
		КонецЕсли;
		
		ЗначениеСостояния = Неопределено;
		УзелСостояния = НайтиУзел(УзелРезультата, "STATE_ID");
		Если УзелСостояния <> Неопределено Тогда
			Попытка
				ЗначениеСостояния = XMLЗначение(Тип("Число"), УзелСостояния.Значение);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ТекстСостояния = "";
		УзелТекстаСостояния = НайтиУзел(УзелРезультата, "STATE");
		Если УзелТекстаСостояния <> Неопределено Тогда
			ТекстСостояния = СокрЛП(XMLЗначение(Тип("Строка"), УзелТекстаСостояния.Значение));
		КонецЕсли;
		
		ЗначениеДатыОбновления = Неопределено;
		УзелДатыОбновления = НайтиУзел(УзелРезультата, "MD_DATE");
		Если УзелДатыОбновления <> Неопределено Тогда
			Попытка
				ЗначениеДатыОбновления = XMLЗначение(Тип("Дата"), УзелДатыОбновления.Значение);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеСостояния <> Неопределено Тогда
			УзелОшибки = НайтиУзел(УзелРезультата, "LAST_EXCEPTION");
			ТекстОшибки = "";
			Если УзелОшибки <> Неопределено Тогда
				ТекстОшибки = СокрЛП(XMLЗначение(Тип("Строка"), УзелОшибки.Значение));
				
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					ВременныйФайлОшибки = ПолучитьИмяВременногоФайла();
					ДвоичныеДанныеОшибки = Base64Значение(ТекстОшибки);
					ДвоичныеДанныеОшибки.Записать(ВременныйФайлОшибки);
					
					ОбъектЧтениеТекста = Новый ЧтениеТекста(ВременныйФайлОшибки, "windows-1251");
					ТекстОшибки = ОбъектЧтениеТекста.Прочитать();
					ОбъектЧтениеТекста.Закрыть();
					ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ВременныйФайлОшибки);
				КонецЕсли;
				ТекстПоследнейОшибкиВебСервиса = ТекстОшибки;
			КонецЕсли;
		КонецЕсли;
		
		УзелПротоколаРезультата = НайтиУзел(УзелРезультата, "FILE_TICKET");
		ЕстьПротокол = (УзелПротоколаРезультата <> Неопределено);
		Если ЕстьПротокол Тогда
			ФайлРезультата = ПолучитьИмяВременногоФайла();
			ДвоичныеДанныеПротоколаРезультата = Base64Значение(УзелПротоколаРезультата.Значение);
			ДвоичныеДанныеПротоколаРезультата.Записать(ФайлРезультата);
			КодировкаФайла = "windows-1251";
			
		Иначе
			ФайлРезультата = Неопределено;
			
			Если ЗначениеСостояния = Неопределено Тогда
				ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
					НСтр("ru = 'Ошибка формата ответа сервера ФСС при получении состояния отправки. Вероятно, отправка была удалена на сервере';
						|en = 'An error of SSF server response format occurred when receiving the sending state. The sending might have been deleted on the server'"),
					Истина);
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СФР';
						|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Security Fund of Russia'"),
					УровеньЖурналаРегистрации.Ошибка,,,
					ТекстОшибки);
				Возврат Результат;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеСостояния <> Неопределено Тогда
			// проанализировать состояние обработки
			РезультатФормирования = СформироватьТаблицуОбработки(
				ЗначениеСостояния,
				ТекстСостояния,
				ЗначениеДатыОбновления,
				ТекстОшибки,
				ЕстьПротокол,
				ТипОтправляемогоДокумента);
			
			Если НЕ ЕстьПротокол Тогда
				ТЗОбработки 				= РезультатФормирования.ТЗОбработки;
			КонецЕсли;
			ОтчетСдан 						= РезультатФормирования.ОтчетСдан;
			ОтчетСданСОшибками				= РезультатФормирования.ОтчетСданСОшибками;
			ЕстьОшибкиФорматногоКонтроля 	= РезультатФормирования.ЕстьОшибкиФорматногоКонтроля;
			ЕстьПрочиеОшибки 				= РезультатФормирования.ЕстьПрочиеОшибки;
		КонецЕсли;
		
		УзелЗашифрованнойКвитанции = НайтиУзел(УзелРезультата, "FILE_TICKET_ENC");
		Если УзелЗашифрованнойКвитанции <> Неопределено Тогда
			ДвоичныеДанныеКвитанции = Base64Значение(УзелЗашифрованнойКвитанции.Значение);
		Иначе
			КвитанцияОтсутствует = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
	И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС Тогда
		РесурсСервера = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/fss/statusreport", "{FSS}/fss/statusreport", Соединение) + "?id=" + ИдентификаторОтправкиНаСервере;
		ФайлРезультата = ПолучитьРезультатЗапросаGet(АдресСервера, РесурсСервера);
		
	Иначе
		// если реестр был отправлен без использования API
		РесурсСервера = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/home/Results", "{FSS}/home/Results", Соединение) + "?id=" + ИдентификаторОтправкиНаСервере;
		ФайлРезультата = ПолучитьРезультатЗапросаGet(АдресСервера, РесурсСервера);
	КонецЕсли;
	
	Если ФайлРезультата <> Неопределено ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
		ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС ИЛИ ИспользуетсяВебСервис Тогда
		
		Если ФайлРезультата <> Неопределено Тогда
			// получен протокол обработки
			Попытка
				// извлекаем таблицу обработки из файла результата
				ТЗОбработки = ИзвлечьИзФайлаТаблицуОбработки(ФайлРезультата, ТипОтправляемогоДокумента, КодировкаФайла, ИспользуетсяВебСервис);
			Исключение
				// обрабатываем ошибки, возникшие в случае, если невозможно разобрать ответ от сервера
				ОбъектЧтениеТекста = Новый ЧтениеТекста;
				ЧтениеТекстаОткрытьНаСервере(ОбъектЧтениеТекста, ФайлРезультата);
				ТекстОтвета = ОбъектЧтениеТекста.Прочитать();
				ОбъектЧтениеТекста.Закрыть();
				
				Если (ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
				ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС ИЛИ ИспользуетсяВебСервис)
				И (СокрЛП(ТекстОтвета) = "OK;") Тогда
					//ситуация, когда отчет еще не обработан
					ФайлРезультата = Неопределено;
				ИначеЕсли НЕ ИспользуетсяВебСервис Тогда
					
					Если СтрНайти(ВРЕГ(ТекстОтвета), НСтр("ru = 'НЕДОСТУПЕН';
															|en = 'UNAVAILABLE'")) <> 0 Тогда
						ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
							НСтр("ru = 'Сервер ФСС недоступен';
								|en = 'SSF server is unavailable'"), Истина);
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
					Иначе
						ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
							НСтр("ru = 'Не удалось разобрать ответ, полученный от сервера ФСС';
								|en = 'Cannot parse the response received from SSF server'"), Истина);
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
					КонецЕсли;
					
					Возврат Результат;
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
		
		Если ФайлРезультата <> Неопределено Тогда
			// читаем содержимое протокола обработки
			ОбъектЧтение = Новый ЧтениеТекста(ФайлРезультата, КодировкаФайла);
			стрРезультатОбработки = СокрЛП(ОбъектЧтение.Прочитать());
			
			ОбъектЧтение.Закрыть();
		Иначе
			//ситуация, когда отчет еще не обработан
			стрРезультатОбработки = "";
		КонецЕсли;
		
		// анализируем содержимое страницы протокола обработки
		Если (СтрНайти(стрРезультатОбработки, "invoice?id") > 0 И НЕ ИспользуетсяВебСервис)
			ИЛИ ОтчетСдан = Истина ИЛИ ОтчетСданСОшибками = Истина Тогда
			
			// есть ссылка на квитанцию - отчет принят
			Если СтрНайти(стрРезультатОбработки, "invoice?id") > 0 И КвитанцияОтсутствует <> Истина Тогда
				Если ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
				И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
				И НЕ ИспользуетсяВебСервис Тогда
					СсылкаКвитанция = "invoice?id=" + ИдентификаторОтправкиНаСервере;
				Иначе
					НомерОтправкиНаСервере = ТекстПослеПрефикса(стрРезультатОбработки, "invoice?id=", """");
					СсылкаКвитанция = "invoice?id=" + НомерОтправкиНаСервере;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрНайти(стрРезультатОбработки, "invoice?lid") > 0 ИЛИ ОтчетСданСОшибками = Истина Тогда
				// есть ссылка на протокол ошибок логического контроля
				СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки;
				Если СтрНайти(стрРезультатОбработки, "invoice?lid") > 0 Тогда
					СсылкаПротоколОшибок = "invoice?lid=" + ИдентификаторОтправкиНаСервере;
				КонецЕсли;
				СтатусОтчета = НСтр("ru = 'Сдан, обнаружены ошибки при логическом контроле';
									|en = 'Submitted, errors are detected during logical control'");
				ЦветСтатуса = ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
				ЕстьОшибки = Истина;
			Иначе
				СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
				СтатусОтчета = НСтр("ru = 'Сдан, ошибок не обнаружено.';
									|en = 'Submitted, no errors detected.'");
				ЦветСтатуса = ЦветаСтиля.ЦветПоложительногоПротокола;
			КонецЕсли;
			
		ИначеЕсли СтрНайти(стрРезультатОбработки, "invoice?fid") > 0 ИЛИ ЕстьОшибкиФорматногоКонтроля = Истина
			ИЛИ ((ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
			ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС ИЛИ ИспользуетсяВебСервис)
			И (ТЗОбработки.Количество() = 0) И (стрРезультатОбработки <> "OK;") И (стрРезультатОбработки <> "")) Тогда
			
			// есть ссылка на протокол ошибок форматного контроля - отчет не принят
			СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
			Если СтрНайти(стрРезультатОбработки, "invoice?fid") > 0 Тогда
				СсылкаПротоколОшибок = "invoice?fid=" + ИдентификаторОтправкиНаСервере;
			КонецЕсли;
			СтатусОтчета = НСтр("ru = 'Не принят, обнаружены ошибки при форматном контроле';
								|en = 'Not received, errors are detected during format control'");
			ЦветСтатуса = ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			ЕстьОшибки = Истина;
		ИначеЕсли ЕстьОшибкиСтатуса(ТЗОбработки) ИЛИ ЕстьПрочиеОшибки = Истина Тогда
			СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
			СтатусОтчета = НСтр("ru = 'Не принят, обнаружены ошибки';
								|en = 'Not received, errors are detected'");
			ЦветСтатуса = ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			ЕстьОшибки = Истина;
		Иначе
			//отчет еще не обработан
			СтатусОтчета = НСтр("ru = 'Находится в обработке, попробуйте через некоторое время использовать в отчете кнопку ""Обновить""';
								|en = 'Being processed. Try to click Update in the report after a while'");
		КонецЕсли;
		
		ПротоколОшибок = "";
		ПротоколОшибокЭтоHTML = Ложь;
		ПротоколОшибокВозвращенВебСервисом = (ЗначениеЗаполнено(ТекстПоследнейОшибкиВебСервиса)
			И (ЕстьОшибкиФорматногоКонтроля = Истина ИЛИ ОтчетСданСОшибками = Истина)
			И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
			И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС);
		
		Если СсылкаПротоколОшибок <> "" ИЛИ ПротоколОшибокВозвращенВебСервисом
			ИЛИ ((ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
			ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
			ИЛИ (ИспользуетсяВебСервис И ТЗОбработки.Количество() = 0))
			И (ФайлРезультата <> Неопределено)) Тогда
			
			Если ПротоколОшибокВозвращенВебСервисом Тогда
				ПротоколОшибок = ТекстПоследнейОшибкиВебСервиса;
				
			Иначе
				Если СсылкаПротоколОшибок <> "" Тогда
					ФайлРезультата = ПолучитьРезультатЗапросаGet(АдресСервера, СсылкаПротоколОшибок);
					КодировкаФайла = "utf-8";
				КонецЕсли;
				// считаем содержимое протокола ошибок
				ОбъектЧтение = НовыйЧтениеТекстаНаСервере(ФайлРезультата);
				ПротоколОшибок = СокрЛП(ОбъектЧтение.Прочитать());
			КонецЕсли;
			
			ПротоколОшибокЭтоHTML = СтрНайти(ВРЕГ(ПротоколОшибок), "HTML") > 0
				И ((СсылкаПротоколОшибок <> "" И НЕ ИспользуетсяВебСервис)
				ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
				ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
				ИЛИ (ИспользуетсяВебСервис И ТЗОбработки.Количество() = 0));
			
			Если ПротоколОшибокЭтоHTML И НЕ ПротоколОшибокВозвращенВебСервисом Тогда
				ОбъектЧтение = Новый ЧтениеТекста(ФайлРезультата, КодировкаФайла);
				ПротоколОшибок = СокрЛП(ОбъектЧтение.Прочитать());
			КонецЕсли;
		КонецЕсли;
		
		Если ПротоколОшибокЭтоHTML Тогда
			Протокол = ПротоколОшибок;
			
			Если ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
			ИЛИ ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС
			ИЛИ ИспользуетсяВебСервис Тогда
				Протокол = ПротоколHTMLБезКартинокИСсылок(Протокол);
			КонецЕсли;
			
		Иначе
			Протокол = ГенерироватьHTMLПротоколаОбработкиФСС(ИдентификаторОтправкиНаСервере, ТЗОбработки, ПротоколОшибок, СтатусОтчета, ЦветСтатуса, ОтправкаСсылка, ЕстьОшибки);
		КонецЕсли;
		
		//заполняем результирующую структуру
		ДатаСеанса = ТекущаяДатаСеанса();
		Результат = Новый Структура;
		Результат.Вставить("ДатаПолученияРезультата", 	ДатаСеанса);
		Результат.Вставить("СтатусОтправки", 			СтатусОтправки);
		Результат.Вставить("Протокол", 					Протокол);
		Результат.Вставить("Квитанция", 				Неопределено);
		
		Если СсылкаКвитанция <> "" ИЛИ ДвоичныеДанныеКвитанции <> Неопределено Тогда
			//по полученной ссылке скачаем квитанцию
			Если ДвоичныеДанныеКвитанции = Неопределено Тогда
				ФайлРезультата = ПолучитьРезультатЗапросаGet(АдресСервера, СсылкаКвитанция);
				ДвоичныеДанныеКвитанции = Новый ДвоичныеДанные(ФайлРезультата);
			КонецЕсли;
			Результат.Квитанция = ДвоичныеДанныеКвитанции;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьРезультатОтправкиФСС(ОправкаСсылка, РезультатОтправки)
	
	Если РезультатОтправки <> Неопределено И РезультатОтправки.Свойство("Протокол") Тогда
		ДанныеОтправки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОправкаСсылка, "СтатусОтправки, ВидОтчета");
		Если ДанныеОтправки.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности Тогда
			Если (ДанныеОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
				ИЛИ ДанныеОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан
				ИЛИ ДанныеОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки)
				И РезультатОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен Тогда
				// Не меняем статус на Отправлен если отчет уже принят или отклонен.
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		
		ОтправкаОбъект = ОправкаСсылка.ПолучитьОбъект();
		ОтчетСсылка = ОтправкаОбъект.ОтчетСсылка;
		
		Если РезультатОтправки.Свойство("ИдентификаторОтправкиНаСервере")
			И ЗначениеЗаполнено(РезультатОтправки.ИдентификаторОтправкиНаСервере)
			И РезультатОтправки.ИдентификаторОтправкиНаСервере <> ОтправкаОбъект.ИдентификаторОтправкиНаСервере Тогда
			
			ОтправкаОбъект.ИдентификаторОтправкиНаСервере = РезультатОтправки.ИдентификаторОтправкиНаСервере;
		КонецЕсли;
		
		ОтправкаОбъект.ДатаПолученияРезультата = РезультатОтправки.ДатаПолученияРезультата;
		ОтправкаОбъект.СтатусОтправки = РезультатОтправки.СтатусОтправки;
		ОтправкаОбъект.Протокол = Новый ХранилищеЗначения(РезультатОтправки.Протокол);
		Если РезультатОтправки.Квитанция <> Неопределено Тогда
			ОтправкаОбъект.Квитанция = Новый ХранилищеЗначения(РезультатОтправки.Квитанция);
		КонецЕсли;
		Если РезультатОтправки.Свойство("ПакетКвитанции") И РезультатОтправки.ПакетКвитанции <> Неопределено Тогда
			ОтправкаОбъект.ПакетКвитанции = Новый ХранилищеЗначения(РезультатОтправки.ПакетКвитанции);
		КонецЕсли;
		
		ОтправкаОбъект.Записать();
		
		Если ТипЗнч(ОтчетСсылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС")
			И РезультатОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят Тогда
			
			СтатусМашиночитаемойДоверенности = ?(РезультатОтправки.Свойство("РезультатыОперации")
				И РезультатОтправки.РезультатыОперации <> Неопределено
				И РезультатОтправки.РезультатыОперации.Свойство("СтатусОбработки")
				И ВРег(РезультатОтправки.РезультатыОперации.СтатусОбработки) = "REVOKED",
				Перечисления.СтатусыМашиночитаемойДоверенностиКО.Отозвано,
				Перечисления.СтатусыМашиночитаемойДоверенностиКО.ПустаяСсылка());
			
			ОтчетОбъект = ОтчетСсылка.ПолучитьОбъект();
			Если ОтчетОбъект.Статус <> СтатусМашиночитаемойДоверенности Тогда
				ОтчетОбъект.Статус = СтатусМашиночитаемойДоверенности;
				ОтчетОбъект.Записать();
			КонецЕсли;
		ИначеЕсли ТипЗнч(ОтчетСсылка) = Тип("ДокументСсылка.ЗаявлениеНаФормированиеСправкиОРасчетах")
			И РезультатОтправки.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят
			И РезультатОтправки.Свойство("РезультатыОперации") Тогда
			ДокументОбъект = ОтчетСсылка.ПолучитьОбъект();
			ДокументОбъект.Статус = НСтр("ru = 'Не принято';
										|en = 'Not received'");
			ДокументОбъект.ОшибкиКонтроля = РезультатОтправки.РезультатыОперации.СообщениеОбОшибке;
			ДокументОбъект.Записать();
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьРезультатЗапросаGet(АдресСервера, РесурсСервера)

	// устанавливаем соединение с сервером
	Соединение = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(АдресСервера);
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// посылаем запрос
	ФайлРезультата = ПолучитьИмяВременногоФайла();
	Попытка
		Соединение.Получить(РесурсСервера, ФайлРезультата);
		Соединение = Неопределено;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ФайлРезультата;
	
КонецФункции

Функция ГенерироватьHTMLПротоколаОбработкиФСС(ИдентификаторОтчета, ТЗОбработки, ПротоколОшибок, СтатусОтчета, ЦветСтатуса, ОтправкаСсылка, ЕстьОшибки)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Шаблон = ПолучитьМакет("ФССШаблонДляHTML");
	
	СекцияШапка = Шаблон.ПолучитьОбласть("Шапка");
	
	СвойстваОрганизации 			= РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(ОтправкаСсылка.Организация, ,"НаимЮЛПол, ИННЮЛ");
	ПолноеНаименованиеОрганизации 	= СвойстваОрганизации.НаимЮЛПол;
	ИННОрганизации 					= СвойстваОрганизации.ИННЮЛ;
	
	// Наименование протокола 
	НаименованиеПротокола = "";
	Если ЕстьОшибки Тогда
		НаименованиеПротокола = НСтр("ru = 'Протокол ошибок';
									|en = 'Error log'");
	Иначе
		НаименованиеПротокола = НСтр("ru = 'Протокол о сдаче';
									|en = 'Delivery protocol'");
	КонецЕсли;
	СекцияШапка.Параметры.НаименованиеПротокола = НаименованиеПротокола;
	
	СведенияПоОбъекту 	= СведенияПоОтправляемымОбъектам(ОтправкаСсылка.ОтчетСсылка);
	НаименованиеОргана 	= СведенияПоОбъекту.ПредставлениеКонтролирующегоОргана;
	НаименованиеОтчета 	= СведенияПоОбъекту.Наименование;
	
	СекцияШапка.Параметры.Организация 	= ПолноеНаименованиеОрганизации;
	СекцияШапка.Параметры.ИНН 			= НСтр("ru = 'ИНН ';
												|en = 'TIN'") + ИННОрганизации;
	СекцияШапка.Параметры.Получатель 	= НаименованиеОргана;
	СекцияШапка.Параметры.Отчет 		= НаименованиеОтчета;
	СекцияШапка.Параметры.СтатусОтчета 	= СтатусОтчета;
	СекцияШапка.Параметры.Файл 			= ИдентификаторОтчета;
	СекцияШапка.Области.СтатусОтчета.ЦветТекста = ЦветСтатуса;
	
	ТабДок.Вывести(СекцияШапка);
	
	ПротоколОшибокОтображаемый = СокрЛП(ПротоколОшибок);
	
	СекцияСтрока = Шаблон.ПолучитьОбласть("Строка");
	Для каждого СтрокаТЗ Из ТЗОбработки Цикл
		ОписаниеОшибкиИзТаблицы = СокрЛП(СтрокаТЗ.ОписаниеОшибки);
		Если ЗначениеЗаполнено(ОписаниеОшибкиИзТаблицы) И СтрДлина(ПротоколОшибокОтображаемый) >= СтрДлина(ОписаниеОшибкиИзТаблицы)
			И СтрДлина(ПротоколОшибокОтображаемый) <= СтрДлина(ОписаниеОшибкиИзТаблицы) + 20
			И Прав(ВРег(ПротоколОшибокОтображаемый), СтрДлина(ОписаниеОшибкиИзТаблицы)) = ВРег(ОписаниеОшибкиИзТаблицы) Тогда
			ПротоколОшибокОтображаемый = "";
		КонецЕсли;
		
		СекцияСтрока.Параметры.Заполнить(СтрокаТЗ);
		ТабДок.Вывести(СекцияСтрока);
	КонецЦикла;
	
	СекцияПодвал = Шаблон.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(СекцияПодвал);
	
	Если ПротоколОшибокОтображаемый <> "" Тогда
		СекцияПротоколОшибок = Шаблон.ПолучитьОбласть("ПротоколОшибок");
		СекцияПротоколОшибок.Параметры.ПротоколОшибок = ПротоколОшибокОтображаемый;
		ТабДок.Вывести(СекцияПротоколОшибок);
	КонецЕсли;
	
	ИмяТемпФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяТемпФайла, ТипФайлаТабличногоДокумента.HTML);
	ТекстHTML = Новый ТекстовыйДокумент;
	ТекстHTML.Прочитать(ИмяТемпФайла);
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	Возврат ТекстHTML;
	
КонецФункции

Функция ЕстьОшибкиСтатуса(ТЗОбработки)
	
	Для каждого СтрокаТЗ Из ТЗОбработки Цикл
		Если СтрокаТЗ.Статус = "Ошибка" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИзвлечьИзФайлаТаблицуОбработки(ФайлОтвета, ТипОтправляемогоДокумента = Неопределено, КодировкаФайла = "utf-8", ИспользуетсяВебСервис = Ложь)
	
	ТЗОбработки = Новый ТаблицаЗначений;
	ТЗОбработки.Колонки.Добавить("СтадияОбработки");
	ТЗОбработки.Колонки.Добавить("Статус");
	ТЗОбработки.Колонки.Добавить("Дата");
	ТЗОбработки.Колонки.Добавить("КодОшибки");
	ТЗОбработки.Колонки.Добавить("ОписаниеОшибки");
	ТЗОбработки.Колонки.Добавить("Действие");
	
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.ОткрытьФайл(ФайлОтвета, КодировкаФайла);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);
	
	ЭлементыTABLE = ДокументDOM.ПолучитьЭлементыПоИмени("TABLE");
	
	СтрокиТаблицыHTML = ЭлементыTABLE[?(ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
		И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС И НЕ ИспользуетсяВебСервис, 2, 0)].ДочерниеУзлы;
	
	//перебираем все строки из таблицы обработки, первая строка таблицы (индекс 0)- заголовки - не используем
	КолвоСтрок = СтрокиТаблицыHTML.Количество();
	Для НомСтроки = 1 По (КолвоСтрок - 1) Цикл
		СтрокаТаблицыHTML = СтрокиТаблицыHTML[НомСтроки];
		НоваяСтрокаТЗ = ТЗОбработки.Добавить();
		//перебираем ячейки строки таблицы (выделяя их из общего списка узлов по типу), заполняем ТЗ
		УзлыСтрокиHTML = СтрокаТаблицыHTML.ДочерниеУзлы;
		НомЯчейки = 0;
		Для каждого УзелСтрокиHTML Из УзлыСтрокиHTML Цикл
			Если УзелСтрокиHTML.ТипУзла = ТипУзлаDOM.Элемент Тогда
				НоваяСтрокаТЗ[НомЯчейки] = СокрЛП(УзелСтрокиHTML.ТекстовоеСодержимое);
				НомЯчейки = НомЯчейки + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТЗОбработки;
	
КонецФункции

Функция ПротоколHTMLБезКартинокИСсылок(ПротоколHTML)
	
	Результат = ПротоколHTML;
	
	Для НомерУдаляемогоТэга = 1 По 2 Цикл
		
		Если НомерУдаляемогоТэга = 1 Тогда
			НачалоТэга = "<IMG ";
			ЗавершениеТэга = ">";
		ИначеЕсли НомерУдаляемогоТэга = 2 Тогда
			НачалоТэга = "<A ";
			ЗавершениеТэга = "</A>";
		КонецЕсли;
		
		Пока Истина Цикл
			
			ПозицияТэга = СтрНайти(ВРег(Результат), НачалоТэга);
			Если ПозицияТэга = 0 Тогда
				Прервать;
			КонецЕсли;
			
			ПротоколДоТэга = Лев(Результат, ПозицияТэга - 1);
			ПротоколСТэга = Сред(Результат, ПозицияТэга);
			
			ПозицияЗавершенияТэга = СтрНайти(ВРег(ПротоколСТэга), ЗавершениеТэга);
			ПротоколПослеТэга = "";
			Если ПозицияЗавершенияТэга > 0 Тогда
				ПротоколПослеТэга = Сред(ПротоколСТэга, ПозицияЗавершенияТэга + СтрДлина(ЗавершениеТэга));
			КонецЕсли;
			
			Результат = ПротоколДоТэга + ПротоколПослеТэга;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТаблицуОбработки(
	ПолноеСостояние,
	ТекстСостояния,
	ДатаОбновления,
	ТекстОшибки,
	ТолькоПроанализироватьСостояния = Ложь,
	ТипОтправляемогоДокумента = Неопределено)
	
	СостояниеПолучен = 0;
	СостояниеОшибкаПолучения = 10;
	СостояниеЭППроверена = 1;
	СостояниеОшибкаПроверкиЭП = 11;
	СостояниеПереданоНаРассмотрение = 2;
	СостояниеФЛКНеПройден = 21;
	
	Состояние = ПолноеСостояние;
	ОтчетСданСОшибками = Ложь;
	
	Если ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.Отчет4аФСС
		И ТипОтправляемогоДокумента <> Перечисления.ТипыОтправляемыхДокументов.РеестрСведенийФСС Тогда
		
		Если ПолноеСостояние = -1 Тогда
			Состояние = СостояниеПолучен;
		ИначеЕсли ПолноеСостояние = -11 Тогда
			Состояние = СостояниеОшибкаПолучения;
		ИначеЕсли ПолноеСостояние = 1 Тогда
			Состояние = СостояниеЭППроверена;
		ИначеЕсли ПолноеСостояние = 11 Тогда
			Состояние = СостояниеОшибкаПроверкиЭП;
		ИначеЕсли ПолноеСостояние = 2 Тогда
			Состояние = СостояниеЭППроверена;
		ИначеЕсли ПолноеСостояние = 21 Тогда
			Состояние = СостояниеФЛКНеПройден;
		ИначеЕсли ПолноеСостояние = 3 Тогда
			Состояние = СостояниеЭППроверена;
		ИначеЕсли ПолноеСостояние = 31 Тогда
			Состояние = СостояниеПереданоНаРассмотрение;
			ОтчетСданСОшибками = Истина;
		ИначеЕсли ПолноеСостояние = 4 Тогда
			Состояние = СостояниеПереданоНаРассмотрение;
		ИначеЕсли ПолноеСостояние = 41 Тогда
			Состояние = СостояниеПереданоНаРассмотрение;
			ОтчетСданСОшибками = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоНеизвестноеСостояние = (Состояние <> СостояниеПолучен И Состояние <> СостояниеОшибкаПолучения И Состояние <> СостояниеЭППроверена
		И Состояние <> СостояниеОшибкаПроверкиЭП И Состояние <> СостояниеПереданоНаРассмотрение И Состояние <> СостояниеФЛКНеПройден);
	
	ТЗОбработки = Неопределено;
	Если НЕ ТолькоПроанализироватьСостояния Тогда
		
		ТЗОбработки = Новый ТаблицаЗначений;
		ТЗОбработки.Колонки.Добавить("СтадияОбработки");
		ТЗОбработки.Колонки.Добавить("Статус");
		ТЗОбработки.Колонки.Добавить("Дата");
		ТЗОбработки.Колонки.Добавить("КодОшибки");
		ТЗОбработки.Колонки.Добавить("ОписаниеОшибки");
		ТЗОбработки.Колонки.Добавить("Действие");
		
		НоваяСтрокаТЗ = ТЗОбработки.Добавить();
		НоваяСтрокаТЗ.СтадияОбработки = ?(НЕ ЭтоНеизвестноеСостояние, НСтр("ru = '1. Получение файла';
																			|en = '1. Receive file'"), ТекстСостояния);
		НоваяСтрокаТЗ.Статус = ?(НЕ ЭтоНеизвестноеСостояние, ?(Состояние <> СостояниеОшибкаПолучения, НСтр("ru = 'Успешно';
																											|en = 'Done'"), НСтр("ru = 'Ошибка';
																																	|en = 'Error'")), "");
		НоваяСтрокаТЗ.Дата = ?(ЗначениеЗаполнено(ДатаОбновления), Формат(ДатаОбновления, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'"), "");
		НоваяСтрокаТЗ.КодОшибки = "";
		НоваяСтрокаТЗ.ОписаниеОшибки = ?(ЭтоНеизвестноеСостояние ИЛИ Состояние = СостояниеПолучен ИЛИ Состояние = СостояниеОшибкаПолучения, ТекстОшибки, "");
		НоваяСтрокаТЗ.Действие = "";
		
		Если Состояние = СостояниеЭППроверена ИЛИ Состояние = СостояниеОшибкаПроверкиЭП ИЛИ Состояние = СостояниеПереданоНаРассмотрение
			ИЛИ Состояние = СостояниеФЛКНеПройден Тогда
			
			НоваяСтрокаТЗ = ТЗОбработки.Добавить();
			НоваяСтрокаТЗ.СтадияОбработки = НСтр("ru = '2. Расшифровка файла и проверка ЭП';
												|en = '2. File decryption and DS check'");
			НоваяСтрокаТЗ.Статус = ?(Состояние <> СостояниеОшибкаПроверкиЭП, НСтр("ru = 'Успешно';
																					|en = 'Done'"), НСтр("ru = 'Ошибка';
																											|en = 'Error'"));
			НоваяСтрокаТЗ.Дата = ?(ЗначениеЗаполнено(ДатаОбновления), Формат(ДатаОбновления, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'"), "");
			НоваяСтрокаТЗ.КодОшибки = "";
			НоваяСтрокаТЗ.ОписаниеОшибки = ?(Состояние = СостояниеЭППроверена ИЛИ Состояние = СостояниеОшибкаПроверкиЭП, ТекстОшибки, "");
			НоваяСтрокаТЗ.Действие = "";
			
			Если Состояние = СостояниеПереданоНаРассмотрение ИЛИ Состояние = СостояниеФЛКНеПройден Тогда
				НоваяСтрокаТЗ = ТЗОбработки.Добавить();
				НоваяСтрокаТЗ.СтадияОбработки = НСтр("ru = '3. Форматно-логический контроль';
													|en = '3. Format-logical control'");
				НоваяСтрокаТЗ.Статус = ?(Состояние <> СостояниеФЛКНеПройден, НСтр("ru = 'Успешно';
																					|en = 'Done'"), НСтр("ru = 'Ошибка';
																											|en = 'Error'"));
				НоваяСтрокаТЗ.Дата = ?(ЗначениеЗаполнено(ДатаОбновления), Формат(ДатаОбновления, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'"), "");
				НоваяСтрокаТЗ.КодОшибки = "";
				НоваяСтрокаТЗ.ОписаниеОшибки = ТекстОшибки;
				НоваяСтрокаТЗ.Действие = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ОтчетСдан = (Состояние = СостояниеПереданоНаРассмотрение);
	ЕстьОшибкиФорматногоКонтроля = (Состояние = СостояниеФЛКНеПройден);
	ЕстьПрочиеОшибки = (Состояние = СостояниеОшибкаПолучения ИЛИ Состояние = СостояниеОшибкаПроверкиЭП
		ИЛИ (ЭтоНеизвестноеСостояние И ЗначениеЗаполнено(ТекстОшибки)));
	
	Результат = Новый Структура;
	Результат.Вставить("ТЗОбработки", 					ТЗОбработки);
	Результат.Вставить("ОтчетСдан", 					ОтчетСдан);
	Результат.Вставить("ОтчетСданСОшибками", 			ОтчетСданСОшибками);
	Результат.Вставить("ЕстьОшибкиФорматногоКонтроля", 	ЕстьОшибкиФорматногоКонтроля);
	Результат.Вставить("ЕстьПрочиеОшибки", 				ЕстьПрочиеОшибки);
	Возврат Результат;
	
КонецФункции

Функция ОтправкаНаСерверФСС(
		МестоХраненияКлюча,
		АдресСервера,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ИмяФайлаОтправки,
		ПовторятьСоединение,
		НастройкиОтправки)
	
	ТипОтправляемогоДокумента 	= НастройкиОтправки.ТипОтправляемогоДокумента;
	ВидОтправляемогоДокумента 	= НастройкиОтправки.ВидОтправляемогоДокумента;
	
	Идентификатор = Неопределено;
	ОписаниеОшибкиСервером = Неопределено;
	РезультатОтправки = ОтправкаЗашифрованногоПакетаНаСерверФСС(
		АдресСервера,
		ИмяФайлаОтправки,
		ТипОтправляемогоДокумента,
		ВидОтправляемогоДокумента,
		КороткоеИмяФайлаПакета,
		НастройкиОтправки);
	
	Если РезультатОтправки.ОтветПолучен Тогда
		ПовторятьСоединение = Ложь;
		
		ЭтоДанныеЭЛН = (ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ДанныеЭЛНФСС);
		ЭтоПодтверждениеВидаДеятельности =
			(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
			И ВидОтправляемогоДокумента = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
		ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
			(ТипОтправляемогоДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
			И ВидОтправляемогоДокумента =
			Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам);
		ЭтоПодписьИШифрованиеSOAP = ЭтоДанныеЭЛН ИЛИ ЭтоПодтверждениеВидаДеятельности
			ИЛИ ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
		
		Если РезультатОтправки.Идентификатор <> Неопределено И ЭтоПодписьИШифрованиеSOAP Тогда
			ТекстРезультата = РезультатОтправки.Идентификатор;
			Возврат ПоместитьВоВременноеХранилище(ТекстРезультата, Новый УникальныйИдентификатор);
		КонецЕсли;
		
		Если РезультатОтправки.Идентификатор <> Неопределено Тогда
			//отправленный файл принят сервером, отправке присвоен идентификатор
			Возврат ДобавитьОтправкуФСС(
				МестоХраненияКлюча,
				КороткоеИмяФайлаПакета,
				СтрокаBase64ФайлаПакета,
				РезультатОтправки.Идентификатор,
				НастройкиОтправки);
			
		Иначе
			Если РезультатОтправки.ОписаниеОшибкиСервером <> Неопределено Тогда
				//отправленный файл не был принят сервером, получено описание ошибки
				Если СтрНайти(РезультатОтправки.ОписаниеОшибкиСервером,
					"зашифровано на ключе отличном от ключа уполномоченного лица") > 0 Тогда
					
					ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Ошибка расшифровки отчета на сервере ФСС: выбран некорректный сертификат ФСС ЭЛН, ПОВЭД, СЭДО в настройках обмена с ФСС.';
							|en = 'Report decryption error on the SSF server: an incorrect SSF ESLR, FEA, EDI certificate was selected in the SSF exchange settings.'"), Истина);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
					
					КонтекстОснования = Новый ФиксированнаяСтруктура("АдресСсылки", "НастройкиОбменаФСС");
					ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Перейти в форму настроек обмена с ФСС.';
							|en = 'Go to SSF exchange settings form.'"), Истина);
					ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
						ТекстОшибки,,,,,
						НовыйКонтекстОбработки(КонтекстОснования));
					
				Иначе
					Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатОтправки, "СкрытьПрефиксОшибки", Ложь) Тогда
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(РезультатОтправки.ОписаниеОшибкиСервером);
					Иначе
						ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(
							НСтр("ru = 'Отчет не принят сервером.';
								|en = 'Report is not accepted by the server.'") + " " + РезультатОтправки.ОписаниеОшибкиСервером);
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				// в ответе сервера отсутствует как идентификатор, так и описание ошибки
				ТекстОшибки = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(
						НСтр("ru = 'Зашифрованный пакет не удалось отправить на сервер ФСС.';
							|en = 'Cannot send the encrypted package to SSF server.'"), Истина);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстОшибки);
			КонецЕсли;
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		ПовторятьСоединение = Истина;
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ДобавитьОтправкуФСС(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		Идентификатор,
		НастройкиОтправки) Экспорт
	
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("ОтчетСсылка", 			Неопределено);
	НастройкиВызова.Вставить("ПоляДляЗаписиОтправки", 	Неопределено);
	НастройкиВызова.Вставить("СтатусОтправки", 			Перечисления.СтатусыОтправки.Отправлен);
	НастройкиВызова.Вставить("Протокол", 				Неопределено);
	НастройкиВызова.Вставить("Квитанция", 				Неопределено);
	НастройкиВызова.Вставить("ПодписанныйПакет", 		Неопределено);
	НастройкиВызова.Вставить("ПакетКвитанции", 			Неопределено);
	НастройкиВызова.Вставить("ЭтоТекстФайлаПакета", 	Ложь);
	НастройкиВызова.Вставить("ВидОтчета", 				Неопределено);
	НастройкиВызова.Вставить("ДатаОтправки", 			Неопределено);
	НастройкиВызова.Вставить("ДатаПолученияРезультата", Неопределено);
	НастройкиВызова.Вставить("Организация", 			Неопределено);
	НастройкиВызова.Вставить("ОбменЧерезОператора", 	Ложь);
	Если НастройкиОтправки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВызова, НастройкиОтправки);
	КонецЕсли;
	ОтчетСсылка 			= НастройкиВызова.ОтчетСсылка;
	ПоляДляЗаписиОтправки 	= НастройкиВызова.ПоляДляЗаписиОтправки;
	
	ПоляДляЗаписиОтправки = Новый Структура;
	ПоляДляЗаписиОтправки.Вставить("КодОрганаФСС", 			"");
	ПоляДляЗаписиОтправки.Вставить("ДатаНачалаПериода", 	Неопределено);
	ПоляДляЗаписиОтправки.Вставить("ДатаОкончанияПериода", 	Неопределено);
	ПоляДляЗаписиОтправки.Вставить("Версия", 				"");
	Если НастройкиВызова.ПоляДляЗаписиОтправки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПоляДляЗаписиОтправки, НастройкиВызова.ПоляДляЗаписиОтправки);
	КонецЕсли;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	ТипЗнчСсылкаНаОтчет = ТипЗнч(ОтчетСсылка);
	
	Если ЗначениеЗаполнено(ОтчетСсылка) Тогда
		СвойстваОбъекта = СвойстваОбъектовФормы1СОтчетность(ОтчетСсылка, Истина);
		Организация = ?(ТипЗнч(СвойстваОбъекта) = Тип("Структура") И СвойстваОбъекта.Свойство("Организация"),
			СвойстваОбъекта.Организация, Неопределено);
		ИменаРеквизитовОтчета = ?(ЗначениеЗаполнено(Организация), "", "Организация")
			+ ?(ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет"),
			?(ЗначениеЗаполнено(Организация), "", ", ") + "ИсточникОтчета", "")
			+ ?(ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов"),
			?(ЗначениеЗаполнено(Организация), "", ", ") + "ВидОтчета", "");
		РеквизитыОтчета = ?(ЗначениеЗаполнено(ИменаРеквизитовОтчета),
			ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетСсылка, ИменаРеквизитовОтчета), Новый Структура);
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			Организация = РеквизитыОтчета.Организация;
		КонецЕсли;
	Иначе
		Организация = НастройкиВызова.Организация;
		РеквизитыОтчета = Новый Структура("Организация", Организация);
	КонецЕсли;
	
	ЭтоРеестрСведений = ДокументооборотСФССКлиентСервер.ЭтоРеестрСведенийНаВыплатуПособийФСС(ОтчетСсылка);
	ОбъектПоУмолчаниюРеестрЭЛНСуществует =
		Метаданные.Документы.Найти("РеестрДанныхЭЛНЗаполняемыхРаботодателем") <> Неопределено;
	ЭтоРеестрЭЛН = ДокументооборотСФССКлиентСервер.ЭтоРеестрДанныхЭЛНЗаполняемыхРаботодателем(ОтчетСсылка,
		ОбъектПоУмолчаниюРеестрЭЛНСуществует);
	ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует =
		Метаданные.Документы.Найти("РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам") <> Неопределено;
	ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам =
		ДокументооборотСФССКлиентСервер.ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(ОтчетСсылка,
		ОбъектПоУмолчаниюРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникамСуществует);
	
	ВидОтчета = Неопределено;
	Если ЗначениеЗаполнено(НастройкиВызова.ВидОтчета) Тогда
		ВидОтчета = НастройкиВызова.ВидОтчета;
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		// ОбъектФСС - рег отчет
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", РеквизитыОтчета.ИсточникОтчета);
	ИначеЕсли ЭтоРеестрСведений Тогда
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.РеестрСведенийВФСС;
	ИначеЕсли ЭтоРеестрЭЛН Тогда
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.РеестрДанныхЭЛНЗаполняемыхРаботодателем;
	ИначеЕсли ЭтоРеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам;
	ИначеЕсли ТипЗнчСсылкаНаОтчет = Тип("СправочникСсылка.ЭлектронныеПредставленияРегламентированныхОтчетов") Тогда
		ВидОтчета = РеквизитыОтчета.ВидОтчета;
	Иначе
		МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчСсылкаНаОтчет);
		Если МетаданныеОтчета <> Неопределено Тогда
			ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", МетаданныеОтчета.Имя);
		КонецЕсли;
	КонецЕсли;
	
	Если ВидОтчета = Неопределено Тогда
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(НСтр("ru = 'Не удалось определить тип документа!';
															|en = 'Cannot determine a document type.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	НоваяЗапись = Справочники.ОтправкиФСС.СоздатьЭлемент();
	НоваяЗапись.ОтчетСсылка = ОтчетСсылка;
	НоваяЗапись.ИдентификаторОтправкиНаСервере = Идентификатор;
	
	Если ТипЗнч(СтрокаBase64ФайлаПакета) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанныеФайлаПакета = СтрокаBase64ФайлаПакета;
		
	ИначеЕсли НастройкиВызова.ЭтоТекстФайлаПакета Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ОбъектЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, "utf-8");
		ОбъектЗаписьТекста.Записать(СтрокаBase64ФайлаПакета);
		ОбъектЗаписьТекста.Закрыть();
		ДвоичныеДанныеФайлаПакета = Новый ДвоичныеДанные(ИмяВременногоФайла);
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайла);
		
	ИначеЕсли НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		ДвоичныеДанныеФайлаПакета = ПолучитьИзВременногоХранилища(СтрокаBase64ФайлаПакета);
	Иначе
		ДвоичныеДанныеФайлаПакета = Base64Значение(СтрокаBase64ФайлаПакета);
	КонецЕсли;
	
	НоваяЗапись.ЗашифрованныйПакет = Новый ХранилищеЗначения(ДвоичныеДанныеФайлаПакета);
	НоваяЗапись.ИмяФайлаПакета = КороткоеИмяФайлаПакета;
	НоваяЗапись.СтатусОтправки = НастройкиВызова.СтатусОтправки;
	НоваяЗапись.ДатаОтправки = ?(ЗначениеЗаполнено(НастройкиВызова.ДатаОтправки),
		НастройкиВызова.ДатаОтправки, ДатаСеанса);
	НоваяЗапись.Организация = Организация;
	НоваяЗапись.КодОрганаФСС = ПоляДляЗаписиОтправки.КодОрганаФСС;
	НоваяЗапись.ДатаНачалаПериода = ПоляДляЗаписиОтправки.ДатаНачалаПериода;
	НоваяЗапись.ДатаОкончанияПериода = ПоляДляЗаписиОтправки.ДатаОкончанияПериода;
	НоваяЗапись.Версия = ПоляДляЗаписиОтправки.Версия;
	НоваяЗапись.ПредставлениеПериода = ПредставлениеПериода(НоваяЗапись.ДатаНачалаПериода,
		КонецДня(НоваяЗапись.ДатаОкончанияПериода), "ФП=Истина");
	НоваяЗапись.ПредставлениеВидаДокумента = РегламентированнаяОтчетность.ПредставлениеВидаДокумента(НоваяЗапись.Версия);
	НоваяЗапись.ВидОтчета = ВидОтчета;
	НоваяЗапись.ОбменЧерезОператора = НастройкиВызова.ОбменЧерезОператора;
	
	Если НастройкиВызова.Протокол <> Неопределено ИЛИ ЗначениеЗаполнено(НастройкиВызова.ДатаПолученияРезультата) Тогда
		НоваяЗапись.ДатаПолученияРезультата = ?(ЗначениеЗаполнено(НастройкиВызова.ДатаПолученияРезультата),
			НастройкиВызова.ДатаПолученияРезультата, ДатаСеанса);
		Если НастройкиВызова.Протокол <> Неопределено Тогда
			НоваяЗапись.Протокол = Новый ХранилищеЗначения(НастройкиВызова.Протокол);
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиВызова.Квитанция <> Неопределено Тогда
		НоваяЗапись.Квитанция = Новый ХранилищеЗначения(НастройкиВызова.Квитанция);
	КонецЕсли;
	
	Если НастройкиВызова.ПодписанныйПакет <> Неопределено Тогда
		Если НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
			ДвоичныеДанныеПодписанногоПакета = ПолучитьИзВременногоХранилища(НастройкиВызова.ПодписанныйПакет);
		Иначе
			ДвоичныеДанныеПодписанногоПакета = Base64Значение(НастройкиВызова.ПодписанныйПакет);
		КонецЕсли;
		НоваяЗапись.ПодписанныйПакет = Новый ХранилищеЗначения(ДвоичныеДанныеПодписанногоПакета);
	КонецЕсли;
	Если НастройкиВызова.ПакетКвитанции <> Неопределено Тогда
		НоваяЗапись.ПакетКвитанции = Новый ХранилищеЗначения(НастройкиВызова.ПакетКвитанции);
	КонецЕсли;
	
	НоваяЗапись.Записать();
	
	Возврат НоваяЗапись.Ссылка;
	
КонецФункции

Функция ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(
		ОрганизацияСсылка,
		ТекущийПользователь = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСС.СертификатСтрахователяОтпечаток КАК СертификатСтрахователяОтпечаток,
		|	НастройкиОбменаФСС.СертификатФССОтпечаток КАК СертификатФССОтпечаток,
		|	НастройкиОбменаФСС.СертификатФССЭЛНОтпечаток КАК СертификатФССЭЛНОтпечаток,
		|	НастройкиОбменаФСС.ТестовыйСерверФССЭЛН КАК ТестовыйСерверФССЭЛН,
		|	НастройкиОбменаФСС.ИспользоватьНесколько КАК ИспользоватьНесколько,
		|	НастройкиОбменаФССПользователей.СертификатСтрахователяОтпечаток КАК СертификатСтрахователяПользователяОтпечаток,
		|	НастройкиОбменаФСС.СтраховательПодписанНаУведомленияПоЭЛН КАК СтраховательПодписанНаУведомленияПоЭЛН,
		|	НастройкиОбменаФСС.Доверенность.НомерДоверенности КАК МЧД,
		|	НастройкиОбменаФССПользователей.Доверенность.НомерДоверенности КАК МЧДПользователя,
		|	НастройкиОбменаФСС.ОбменПоСЭДОНапрямую КАК ОбменПоСЭДОНапрямую
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФССПользователей
		|		ПО НастройкиОбменаФСС.Организация = НастройкиОбменаФССПользователей.Организация
		|			И (НастройкиОбменаФССПользователей.Пользователь = &ПользовательСсылка)
		|ГДЕ
		|	НастройкиОбменаФСС.Организация = &ОрганизацияСсылка
		|	И (НастройкиОбменаФСС.Пользователь ЕСТЬ NULL
		|			ИЛИ НастройкиОбменаФСС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
		|	И НастройкиОбменаФСС.ИспользоватьОбмен = ИСТИНА";
	
	Если ТекущийПользователь = Неопределено Тогда
		ТекущийПользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", 	ОрганизацияСсылка);
	Запрос.УстановитьПараметр("ПользовательСсылка", ТекущийПользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Результат = Неопределено;
		
	Иначе
		ОтпечатокСертификатаСтрахователяПользователя = ?(Выборка.ИспользоватьНесколько,
			Выборка.СертификатСтрахователяПользователяОтпечаток, "");
		ОтпечатокСертификатаСтрахователя = ОтпечатокСертификатаСтрахователяПользователя;
		Если НЕ ЗначениеЗаполнено(ОтпечатокСертификатаСтрахователя) Тогда
			ОтпечатокСертификатаСтрахователя = Выборка.СертификатСтрахователяОтпечаток;
		КонецЕсли;
		МЧД = ?(Выборка.ИспользоватьНесколько, СокрЛП(Выборка.МЧДПользователя), "");
		Если НЕ ЗначениеЗаполнено(МЧД) И НЕ ЗначениеЗаполнено(ОтпечатокСертификатаСтрахователяПользователя) Тогда
			МЧД = СокрЛП(Выборка.МЧД);
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("СертификатСтрахователяОтпечаток", 			ОтпечатокСертификатаСтрахователя);
		Результат.Вставить("СертификатФССОтпечаток", 					Выборка.СертификатФССОтпечаток);
		Результат.Вставить("СертификатФССЭЛНОтпечаток", 				Выборка.СертификатФССЭЛНОтпечаток);
		Результат.Вставить("ИспользоватьНесколько", 					Выборка.ИспользоватьНесколько);
		Результат.Вставить("ТестовыйСерверФССЭЛН", 						Выборка.ТестовыйСерверФССЭЛН);
		Результат.Вставить("СтраховательПодписанНаУведомленияПоЭЛН", 	Выборка.СтраховательПодписанНаУведомленияПоЭЛН);
		Результат.Вставить("МЧД", 										МЧД);
		Результат.Вставить("ОбменПоСЭДОНапрямую", 						Выборка.ОбменПоСЭДОНапрямую);
	КонецЕсли;
	
	// Проверка подписания из мастера МЧД
	ОтпечатокРуководителя = ДокументооборотСКОВызовСервера.ЗапоминаниеОшибок(,, Истина, "МЧДОтпечатокРуководителя");
	Если ЗначениеЗаполнено(ОтпечатокРуководителя) Тогда
		ОбменПоСЭДОНапрямую = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ОбменПоСЭДОНапрямую", Истина)
			ИЛИ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "СертификатСтрахователяОтпечаток", "") <>
			ОтпечатокРуководителя;
		
		Если Результат = Неопределено Тогда
			Результат = Новый Структура;
			Результат.Вставить("СертификатСтрахователяОтпечаток", 			"");
			Результат.Вставить("СертификатФССОтпечаток", 					"");
			Результат.Вставить("СертификатФССЭЛНОтпечаток", 				"");
			Результат.Вставить("ИспользоватьНесколько", 					Ложь);
			Результат.Вставить("ТестовыйСерверФССЭЛН", 						Ложь);
			Результат.Вставить("СтраховательПодписанНаУведомленияПоЭЛН", 	Ложь);
			Результат.Вставить("МЧД", 										"");
			Результат.Вставить("ОбменПоСЭДОНапрямую", 						Ложь);
		КонецЕсли;
		
		Результат.СертификатСтрахователяОтпечаток 	= ОтпечатокРуководителя;
		Результат.ОбменПоСЭДОНапрямую 				= ОбменПоСЭДОНапрямую;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПоследнююОтправкуОтчетаВФСС(ОтчетСсылка) Экспорт
	
	Отправка = Неопределено;
	
	Если ЗначениеЗаполнено(ОтчетСсылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
					   |	ОтправкиФСС.Ссылка
					   |ИЗ
					   |	Справочник.ОтправкиФСС КАК ОтправкиФСС
					   |ГДЕ
					   |	ОтправкиФСС.ОтчетСсылка = &ЭтотОтчет
					   |	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
					   |
					   |УПОРЯДОЧИТЬ ПО
					   |	ОтправкиФСС.ДатаОтправки УБЫВ";
		Запрос.Параметры.Вставить("ЭтотОтчет", ОтчетСсылка);
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Отправка = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Отправка;
	
КонецФункции

Функция СвойстваПоследнихОтправокОтчетаВФСС(СсылкаНаОтчет) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаОтправки", 					Неопределено);
	Результат.Вставить("ОбменЧерезОператора", 			Ложь);
	Результат.Вставить("КоличествоЗаписей", 			0);
	Результат.Вставить("КоличествоДоставленныхВСФР", 	0);
	Результат.Вставить("МаксимальнаяДатаДоставкиВСФР", 	Неопределено);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ОтправкиФСС.Ссылка КАК Ссылка,
		|	ОтправкиФСС.ДатаОтправки КАК ДатаОтправки,
		|	ОтправкиФСС.ОбменЧерезОператора КАК ОбменЧерезОператора,
		|	ОтправкиФСС.ДоставленоВСФР КАК ДоставленоВСФР,
		|	ОтправкиФСС.ДатаДоставкиВСФР КАК ДатаДоставкиВСФР
		|ИЗ
		|	Справочник.ОтправкиФСС КАК ОтправкиФСС
		|ГДЕ
		|	ОтправкиФСС.ОтчетСсылка = &ОтчетСсылка
		|	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтправкиФСС.ДатаОтправки УБЫВ");
	
	Запрос.Параметры.Вставить("ОтчетСсылка", СсылкаНаОтчет);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Результат.КоличествоЗаписей = 0 Тогда
			Результат.ДатаОтправки = Выборка.ДатаОтправки;
			Результат.ОбменЧерезОператора = Выборка.ОбменЧерезОператора;
			
		ИначеЕсли Выборка.ДатаОтправки <> Результат.ДатаОтправки
			ИЛИ Выборка.ОбменЧерезОператора <> Результат.ОбменЧерезОператора Тогда
			
			Прервать;
		КонецЕсли;
		
		Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;
		Если Выборка.ДоставленоВСФР Тогда
			Результат.КоличествоДоставленныхВСФР = Результат.КоличествоДоставленныхВСФР + 1;
			
			Если Результат.МаксимальнаяДатаДоставкиВСФР = Неопределено
				ИЛИ Выборка.ДатаДоставкиВСФР > Результат.МаксимальнаяДатаДоставкиВСФР Тогда
				
				Результат.МаксимальнаяДатаДоставкиВСФР = Выборка.ДатаДоставкиВСФР;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьСтатусОтправкиФССОтчета(Отчет)
	
	// находим последнюю не помеченную на удаление отправку отчета
	ПоследняяОтправка = ПолучитьПоследнююОтправкуОтчетаВФСС(Отчет);
	
	// вычисляем значение статуса отправки (Перечисления.СтатусыОтправки)
	Если ЗначениеЗаполнено(ПоследняяОтправка) Тогда
		СтатусОтправки = ПоследняяОтправка.СтатусОтправки;
		Если СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки
			И ПоследняяОтправка.ВидОтчета <>
			Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			//введено после добавления дополнительного статуса ПринятЕстьОшибки, при котором отчет считается сданным
			СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
		КонецЕсли;
	Иначе
		СтатусОтправки = Неопределено;
	КонецЕсли;
	
	// сохраняем статус в базе
	ЗаписатьСтатусОтправкиФССОтчета(Отчет, СтатусОтправки, ПоследняяОтправка);
	
КонецПроцедуры

Процедура ЗаписатьСтатусОтправкиФССОтчета(Отчет, СтатусОтправки, ОснованиеСтатуса)
	
	Если ЗначениеЗаполнено(СтатусОтправки) Тогда
		МенЗап = РегистрыСведений.СтатусыОтправки.СоздатьМенеджерЗаписи();
		МенЗап.Объект = Отчет;
		МенЗап.Статус = СтатусОтправки;
		МенЗап.Основание = ОснованиеСтатуса;
		МенЗап.Записать(Истина);
	Иначе
		МенЗап = РегистрыСведений.СтатусыОтправки.СоздатьМенеджерЗаписи();
		МенЗап.Объект = Отчет;
		МенЗап.Прочитать();
		Если МенЗап.Выбран() Тогда
			МенЗап.Удалить();
		КонецЕсли;
	КонецЕсли;
	
	// вызываем переопределяемую процедуру отработки изменения статуса отправки
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПриИзмененииСтатусаОтправкиДокумента(Отчет, СтатусОтправки);
	
КонецПроцедуры

Функция ПолучитьПустуюДатуЗавершенияОтправкиФСС()
	
	Возврат '39991231235959';
	
КонецФункции

Процедура ПередЗаписьюОтправкиФСС(Объект, Отказ)
	
	Если НЕ ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = СокрЛП(Формат(Объект.ДатаОкончанияПериода, "ДФ=yyyyMMdd") + Формат('39991231' - Объект.ДатаНачалаПериода, "ДФ=yyyyMMdd"));
	КонецЕсли;
	
	Если Объект.СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
			Объект.ДатаЗакрытия = ПолучитьПустуюДатуЗавершенияОтправкиФСС();
		КонецЕсли;
		
	Иначе
		Объект.ДатаЗакрытия = Объект.ДатаПолученияРезультата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиОтправкиФСС(Объект, Отказ)
	
	Если Объект.ОтчетСсылка <> Неопределено Тогда
		// отражаем изменения в регистре статусов отправки
		ОбновитьСтатусОтправкиФССОтчета(Объект.ОтчетСсылка);
		ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЗаписьОбъектовРегламентированнойОтчетности(Объект.ОтчетСсылка, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция СписокДопустимыхОрганизацийВОбъектахОбменаФСС() Экспорт
	
	ДопустимыхОрганизацийВОбъектахОбменаФСС = Новый Массив;
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.РегистрыСведений.НастройкиОбменаФСС) Тогда
		Возврат ДопустимыхОрганизацийВОбъектахОбменаФСС;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(НастройкиОбменаФСС.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
	|		ПО (НастройкиОбменаФСС.Организация = Организации.Ссылка)
	|			И (НЕ Организации.ПометкаУдаления)
	|ГДЕ
	|	НастройкиОбменаФСС.ИспользоватьОбмен
	|	И (НастройкиОбменаФСС.Пользователь ЕСТЬ NULL
	|			ИЛИ НастройкиОбменаФСС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|	И &УсловиеПоОрганизации
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(НастройкиОбменаФСС.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))";
	
	Если ОбщегоНазначенияБРО.ИспользуетсяАрхив() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОрганизации", "НЕ Организации.ВАрхиве");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОрганизации", "Истина");
	КонецЕсли;
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДопустимыхОрганизацийВОбъектахОбменаФСС.Добавить(Выборка.Организация);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ДопустимыхОрганизацийВОбъектахОбменаФСС;
	
КонецФункции

Функция ОрганизацияИспользуетОбменСФСС(
		ОрганизацияСсылка, 
		ИспользуетсяАвтонастройка = Ложь, 
		ДоступностьОнлайнПроверки = Ложь, 
		ПроверятьДляТекущегоПользователя = Истина) Экспорт
		
	СвойстваОрганизации = ЗначенияРеквизитовОбъекта(ОрганизацияСсылка, "ВидОбменаСКонтролирующимиОрганами, УчетнаяЗаписьОбмена");
		
	Если ДоступностьОнлайнПроверки Тогда
		
		Попытка
			
			ОбменИОнлайнПроверкаВключены = 
				СвойстваОрганизации.ВидОбменаСКонтролирующимиОрганами = Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате 
				И ЗначениеЗаполнено(СвойстваОрганизации.УчетнаяЗаписьОбмена)
				И НЕ СвойстваОрганизации.УчетнаяЗаписьОбмена.ОбменНапрямую 
				И СвойстваОрганизации.УчетнаяЗаписьОбмена.ИспользоватьСервисОнлайнПроверкиОтчетов;
				
		Исключение
			ОбменИОнлайнПроверкаВключены = Ложь;
		КонецПопытки;
		
		ОнлайнПроверкаКонтролирующиеОрганы = ?(ОбменИОнлайнПроверкаВключены,
			?(СвойстваОрганизации.УчетнаяЗаписьОбмена.СпецоператорСвязи = Перечисления.СпецоператорыСвязи.Такском,
			"ФНС;ПФР;ФСС;ФСРАР;ФТС",
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.ПолучитьПараметрСпецоператора(
			СвойстваОрганизации.УчетнаяЗаписьОбмена.СпецоператорСвязи, "ОнлайнПроверкаКонтролирующиеОрганы")), "");
			
		ОнлайнПроверкаКонтролирующиеОрганы = СокрЛП(ОнлайнПроверкаКонтролирующиеОрганы);
		ОнлайнПроверкаКонтролирующиеОрганы = ВРег(ОнлайнПроверкаКонтролирующиеОрганы);
		
		ДоступностьОнлайнПроверки = СтрНайти(";" + ОнлайнПроверкаКонтролирующиеОрганы + ";", ";ФСС;") > 0;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСС.ИспользоватьОбмен КАК ИспользоватьОбмен,
		|	НастройкиОбменаФСС.ИспользоватьАвтонастройку КАК ИспользоватьАвтонастройку
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
		|ГДЕ
		|	НастройкиОбменаФСС.Организация = &ОрганизацияСсылка
		|	И (НастройкиОбменаФСС.Пользователь ЕСТЬ NULL
		|	ИЛИ НастройкиОбменаФСС.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", ОрганизацияСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И Выборка.ИспользоватьОбмен Тогда
		
		ЕстьДоступ = Мультирежим.ЕстьПравоНаОрганПоОрганизации(
			ОрганизацияСсылка, 
			Перечисления.ТипыКонтролирующихОрганов.ФСС, 
			ПроверятьДляТекущегоПользователя);
			
		ИспользуетсяАвтонастройка = 
			Выборка.ИспользоватьАвтонастройку 
			И ЕстьДоступ;
			
		ДоступностьОнлайнПроверки = 
			ДоступностьОнлайнПроверки 
			И ЕстьДоступ;
			
		Возврат ЕстьДоступ;
		
	Иначе
		// Проверка подписания из мастера МЧД
		Возврат (ДокументооборотСКОВызовСервера.ЗапоминаниеОшибок(,, Истина, "МЧДТолькоПодписание") = Истина);
	КонецЕсли;
	
КонецФункции

