Функция ТаблицаДатПолученияСообщенийСЭДО()
	
	// Определение типов для таблицы
	ТипДата = Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипВремя = Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Время));
	
	ДатыПолученияСообщений = Новый ТаблицаЗначений;
	ДатыПолученияСообщений.Колонки.Добавить("Дата", ТипДата);
	ДатыПолученияСообщений.Колонки.Добавить("ВремяНачала", ТипВремя);
	ДатыПолученияСообщений.Колонки.Добавить("ВремяКонца", ТипВремя);
	
	Возврат ДатыПолученияСообщений;
	
КонецФункции

#КонецОбласти

#Область ОбменЛисткамиНетрудоспособностиСФСС

Функция СерверПриемаОтчетностиФССЭЛН(ИспользоватьТестовыйСервер, Параметры) Экспорт
	
	ПараметрыФормата = ПараметрыФорматаЭЛН();
	
	Результат = Новый Структура;
	
	Если ПараметрыФормата.Версия = "1.0" Тогда
		Если НЕ ИспользоватьТестовыйСервер Тогда
			Результат.Вставить("Определение", "https://docs.fss.ru/WSInsurerCrypto/FileOperationsLnPort?wsdl");
		Иначе
			Результат.Вставить("Определение", "https://docs-test.fss.ru/WSInsurerCrypto/FileOperationsLnPort?wsdl");
		КонецЕсли;
		
	ИначеЕсли ПараметрыФормата.Версия = "1.1" Тогда
		Если НЕ ИспользоватьТестовыйСервер Тогда
			Результат.Вставить("Определение", "https://docs.fss.ru/ws-insurer-crypto-v11/FileOperationsLnPort?wsdl");
		Иначе
			Результат.Вставить("Определение", "https://docs-test.fss.ru/ws-insurer-crypto-v11/FileOperationsLnPort?wsdl");
		КонецЕсли;
		
	Иначе // 2.0
		Если НЕ ИспользоватьТестовыйСервер Тогда
			Если ОнлайнСервисыРегламентированнойОтчетностиВызовСервера.СобытиеНаступило("Исп.адрес ЭЛН для ЕЦП", Истина) Тогда
				Результат.Вставить("Определение", "https://eln.sfr.gov.ru/ws-insurer-crypto/FileOperationsLnService?wsdl");
			Иначе
				Результат.Вставить("Определение", "https://eln.fss.ru/ws-insurer-crypto-v20/FileOperationsLnService?WSDL");
			КонецЕсли;
		Иначе
			Результат.Вставить("Определение", "https://ecp-test.sfr.gov.ru/eln/ws-insurer-crypto/api/soap/FileOperationsLnService?wsdl");
		КонецЕсли;
	КонецЕсли;
	
	ЭтоВерсия1X = Лев(ПараметрыФормата.Версия, 2) = "1.";
	
	Результат.Определение = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С(Результат.Определение);
	
	Результат.Вставить("URIПространстваИменСервиса", 	ПараметрыФормата.ПространствоИмен);
	Результат.Вставить("ИмяСервиса", 					?(ЭтоВерсия1X, "FileOperationsLnImplService", "FileOperationsLnService"));
	Результат.Вставить("ИмяТочкиПодключения", 			"FileOperationsLnPort");
	Результат.Вставить("ВерсияОбмена", 					ПараметрыФормата.Версия);
	Результат.Вставить("WSПрокси", 						Неопределено);
	Результат.Вставить("ТипОшибки", 					"");
	Результат.Вставить("КодСостояния", 					0);
	Результат.Вставить("СообщениеОбОшибке", 			"");
	
	Если Параметры.СоздаватьWSПрокси Тогда
		СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Результат.Определение);
		Схема = ?(ЗначениеЗаполнено(СтруктураURI.Схема), СтруктураURI.Схема, "http");
		Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(Схема);
		
		ЗащищенноеСоединение = Неопределено;
		Если (Схема = "https" Или Схема = "ftps")  Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		КонецЕсли;
		
		// загрузка или получение из кэша описания веб-сервиса
		ВерсияНастроек = ?(ПараметрыФормата.Версия = "1.0", "", СтрЗаменить(ПараметрыФормата.Версия, ".", "_"));
		КлючНастроек = ?(НЕ ИспользоватьТестовыйСервер, "ЭЛН", "ТестовыеЭЛН");
		
		ДатаОписанияВебСервиса = Неопределено;
		Если БезопасныйРежим() = Ложь Тогда
			УстановитьПривилегированныйРежим(Истина);
			
			ДатаОписанияВебСервиса = ХранилищеОбщихНастроек.Загрузить(
				"ДокументооборотСКонтролирующимиОрганами_ДатаОписанияВебСервиса" + ВерсияНастроек,
				КлючНастроек);
			
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		ТекущаяДатаСервера = ТекущаяДатаСеанса();
		
		ТребуетсяОбновлениеОписания = (Параметры.ВремяХраненияОписанияВебСервиса = 0 ИЛИ НЕ ЗначениеЗаполнено(ДатаОписанияВебСервиса)
			ИЛИ ТекущаяДатаСервера - ДатаОписанияВебСервиса >= Параметры.ВремяХраненияОписанияВебСервиса ИЛИ ТекущаяДатаСервера < ДатаОписанияВебСервиса);
		
		Если ТребуетсяОбновлениеОписания Тогда
			ПараметрыПолучения = Новый Структура;
			ПараметрыПолучения.Вставить("Таймаут", 				Параметры.ТаймаутСоединения);
			ПараметрыПолучения.Вставить("ЗащищенноеСоединение", ЗащищенноеСоединение);
			
			РезультатСкачивания = ПолучениеФайловИзИнтернета.СкачатьФайлВоВременноеХранилище(Результат.Определение, ПараметрыПолучения);
			Если НЕ РезультатСкачивания.Статус Тогда
				Если Параметры.ВозвращатьОписаниеОшибки Тогда
					Результат.ТипОшибки = ?(РезультатСкачивания.КодСостояния = 0 ИЛИ РезультатСкачивания.КодСостояния = 1,
						"ОшибкаСоединения", "ОшибкаНаСервере");
					Результат.КодСостояния = РезультатСкачивания.КодСостояния;
					Результат.СообщениеОбОшибке = РезультатСкачивания.СообщениеОбОшибке;
					Возврат Результат;
				Иначе
					ВызватьИсключение(РезультатСкачивания.СообщениеОбОшибке);
				КонецЕсли;
			КонецЕсли;
			
			ДвоичныеДанныеОписания = ПолучитьИзВременногоХранилища(РезультатСкачивания.Путь);
			
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			
			ДвоичныеДанныеОписания = ХранилищеОбщихНастроек.Загрузить(
				"ДокументооборотСКонтролирующимиОрганами_ОписаниеВебСервиса" + ВерсияНастроек,
				КлючНастроек);
			
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		// получение объекта доступа к веб-сервису и обновление кэша при необходимости
		ИмяФайлаОписания = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанныеОписания.Записать(ИмяФайлаОписания);
		
		Попытка
			WSОпределения = Новый WSОпределения(
				ИмяФайлаОписания,
				"",
				"",
				Прокси,
				Параметры.ТаймаутСоединения,
				ЗащищенноеСоединение);
			
			Результат.WSПрокси = Новый WSПрокси(
				WSОпределения,
				Результат.URIПространстваИменСервиса,
				Результат.ИмяСервиса,
				Результат.ИмяТочкиПодключения,
				Прокси,
				Параметры.ТаймаутВызовов,
				ЗащищенноеСоединение);
		Исключение
			Если Параметры.ВозвращатьОписаниеОшибки Тогда
				ИнформацияОбОшибкеОбмена = ИнформацияОбОшибке();
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Обмен данными ЭЛН';
						|en = 'Exchange ESLR data'"),
					УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибкеОбмена));
				
				ПричинаОшибки = ИнформацияОбОшибкеОбмена;
				Пока ПричинаОшибки.Причина <> Неопределено Цикл
					ПричинаОшибки = ПричинаОшибки.Причина;
				КонецЦикла;
				Результат.ТипОшибки = "ОшибкаНаСервере";
				Результат.СообщениеОбОшибке = ПричинаОшибки.Описание;
				Возврат Результат;
				
			ИначеЕсли ЭтоВерсия1X Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		
		Если ТребуетсяОбновлениеОписания И БезопасныйРежим() = Ложь Тогда
			УстановитьПривилегированныйРежим(Истина);
			
			ХранилищеОбщихНастроек.Сохранить(
				"ДокументооборотСКонтролирующимиОрганами_ОписаниеВебСервиса" + ВерсияНастроек,
				КлючНастроек,
				ДвоичныеДанныеОписания);
			
			ХранилищеОбщихНастроек.Сохранить(
				"ДокументооборотСКонтролирующимиОрганами_ДатаОписанияВебСервиса" + ВерсияНастроек,
				КлючНастроек,
				ТекущаяДатаСервера);
			
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОписания);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользоватьТестовыйСерверФССЭЛН(ОрганизацияСсылка) Экспорт
	
	ОтпечаткиСертификатов = ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(ОрганизацияСсылка);
	Возврат ОтпечаткиСертификатов <> Неопределено И ОтпечаткиСертификатов.ТестовыйСерверФССЭЛН = Истина;
	
КонецФункции

Функция ПараметрыФорматаЭЛН() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", 			"2.0");
	Результат.Вставить("ПространствоИмен", 	"http://www.fss.ru/integration/types/eln/ins/v01");
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы.ПособияСоциальногоСтрахования") Тогда
		МодульОбменЛисткамиНетрудоспособностиФСС = ОбщегоНазначения.ОбщийМодуль("ОбменЛисткамиНетрудоспособностиФСС");
		
		Попытка
			Результат.Версия 			= МодульОбменЛисткамиНетрудоспособностиФСС.Версия();
			Результат.ПространствоИмен 	= МодульОбменЛисткамиНетрудоспособностиФСС.ПространствоИмен();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен ЭЛН';
					|en = 'EDI with regulatory authorities. Exchange ESLR'"),
				УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьЗапросСервисуФССЭЛН(
		Организация,
		Операция,
		АдресЗашифрованногоЗапросаSOAP) Экспорт
	
	Результат = Новый Структура("АдресЗашифрованногоОтветаSOAP, ТекстОшибки", Неопределено, "");
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("СоздаватьWSПрокси", 				Истина);
	ПараметрыВызова.Вставить("ТаймаутСоединения", 				30);
	ПараметрыВызова.Вставить("ТаймаутВызовов", 					600);
	ПараметрыВызова.Вставить("ВозвращатьОписаниеОшибки", 		Ложь);
	ПараметрыВызова.Вставить("ВремяХраненияОписанияВебСервиса", 2 * 60 * 60);
	
	ИспользоватьТестовыйСервер = ИспользоватьТестовыйСерверФССЭЛН(Организация);
	
	НастройкиWS = СерверПриемаОтчетностиФССЭЛН(ИспользоватьТестовыйСервер, ПараметрыВызова);
	Если НастройкиWS = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗашифрованногоЗапросаSOAP = ПолучитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
	УдалитьИзВременногоХранилища(АдресЗашифрованногоЗапросаSOAP);
	
	АдресСервера = НастройкиWS.Определение;
	РесурсНаСервере = "";
	ПозицияЗавершенияСхемы = СтрНайти(АдресСервера, "://");
	Если ПозицияЗавершенияСхемы > 0 Тогда
		СтрокаURI = Сред(АдресСервера, ПозицияЗавершенияСхемы + 3);
		ПозицияЗавершенияСоединения = СтрНайти(СтрокаURI, "/");
		ДлинаСоединения = ?(ПозицияЗавершенияСоединения > 0, ПозицияЗавершенияСоединения - 1, СтрДлина(СтрокаURI));
		РесурсНаСервере = Сред(АдресСервера, ПозицияЗавершенияСхемы + 3 + ДлинаСоединения);
		АдресСервера = Лев(АдресСервера, ПозицияЗавершенияСхемы + 2 + ДлинаСоединения);
		
		ПозицияПараметров = СтрНайти(РесурсНаСервере, "?");
		ДлинаРесурсаНаСервере = ?(ПозицияПараметров > 0, ПозицияПараметров - 1, СтрДлина(РесурсНаСервере));
		РесурсНаСервере = Лев(РесурсНаСервере, ДлинаРесурсаНаСервере);
	КонецЕсли;
	
	ОписаниеОшибкиУстановкиСоединения = "";
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	НастройкиВызова = Новый Структура;
	НастройкиВызова.Вставить("Таймаут", 				120);
	НастройкиВызова.Вставить("ЗащищенноеСоединение", 	ЗащищенноеСоединение);
	СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета(
		АдресСервера,
		ОписаниеОшибкиУстановкиСоединения,
		НастройкиВызова);
	Если СоединениеHTTP = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сервером:
								 |%1';
								 |en = 'Cannot connect to server:
								 |%1'");
		ТекстОшибки = СтрШаблон(
			ТекстОшибки,
			ОписаниеОшибкиУстановкиСоединения);
		Результат.ТекстОшибки = ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	// формируем общие заголовки запроса SOAP
	ЗаголовкиHTTP = Новый Соответствие();
	ЗаголовкиHTTP.Вставить("Content-Type", "text/xml; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
	
	ФайлЗапросаSOAP = ПолучитьИмяВременногоФайла();
	ТекстовыйФайлSOAP = Новый ЗаписьТекста(ФайлЗапросаSOAP, "utf-8");
	ТекстовыйФайлSOAP.Записать(ТекстЗашифрованногоЗапросаSOAP);
	ТекстовыйФайлSOAP.Закрыть();
	
	// посылаем запрос
	ФайлОтветаSOAP = ПолучитьИмяВременногоФайла();
	Попытка
		СоединениеHTTP.ОтправитьДляОбработки(ФайлЗапросаSOAP, РесурсНаСервере, ФайлОтветаSOAP, ЗаголовкиHTTP);
	Исключение
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлЗапросаSOAP);
		ОписаниеОшибкиОтправки = ОписаниеОшибки();
		ТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сервером:
								 |%1';
								 |en = 'Cannot connect to server:
								 |%1'");
		ТекстОшибки = СтрШаблон(
			ТекстОшибки,
			ОписаниеОшибкиОтправки);
		
		Результат.ТекстОшибки = ТекстОшибки;
		Возврат Результат;
	КонецПопытки;
	
	ТекстовыйФайлОтветаSOAP = Новый ЧтениеТекста(ФайлОтветаSOAP, "utf-8");
	ТекстЗашифрованногоОтветаSOAP = ТекстовыйФайлОтветаSOAP.Прочитать();
	ТекстовыйФайлОтветаSOAP.Закрыть();
	АдресЗашифрованногоОтветаSOAP = ПоместитьВоВременноеХранилище(ТекстЗашифрованногоОтветаSOAP, Новый УникальныйИдентификатор());
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлЗапросаSOAP);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлОтветаSOAP);
	
	Результат.АдресЗашифрованногоОтветаSOAP = АдресЗашифрованногоОтветаSOAP;
	Возврат Результат;
КонецФункции

Функция ОбработатьРезультатОтправкиРеестраЭЛН(
		ОтчетСсылка,
		ОрганизацияСсылка,
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ПараметрыРезультата) Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("АдресРасшифрованногоОтветаSOAP", 			Неопределено);
	ПараметрыВызова.Вставить("АдресЗашифрованногоОтветаSOAP", 			Неопределено);
	ПараметрыВызова.Вставить("ПоляДляЗаписиОтправки", 					Неопределено);
	ПараметрыВызова.Вставить("СохранятьАдресРасшифрованногоОтветаSOAP", Ложь);
	ПараметрыВызова.Вставить("ПодписанныйSOAP64", 						Неопределено);
	Если ПараметрыРезультата <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВызова, ПараметрыРезультата);
	КонецЕсли;
	АдресРасшифрованногоОтветаSOAP 			= ПараметрыВызова.АдресРасшифрованногоОтветаSOAP;
	АдресЗашифрованногоОтветаSOAP 			= ПараметрыВызова.АдресЗашифрованногоОтветаSOAP;
	ПоляДляЗаписиОтправки 					= ПараметрыВызова.ПоляДляЗаписиОтправки;
	СохранятьАдресРасшифрованногоОтветаSOAP = ПараметрыВызова.СохранятьАдресРасшифрованногоОтветаSOAP;
	ПодписанныйSOAP64 						= ПараметрыВызова.ПодписанныйSOAP64;
	
	ТекстРезультата = ПолучитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	Если НЕ СохранятьАдресРасшифрованногоОтветаSOAP Тогда
		УдалитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	КонецЕсли;
	
	ИмяФайлаРезультата = ПолучитьИмяВременногоФайла();
	ФайлРезультата = Новый ЗаписьТекста(ИмяФайлаРезультата, "utf-8");
	ФайлРезультата.Записать(ТекстРезультата);
	ФайлРезультата.Закрыть();
	ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяФайлаРезультата);
	
	ТекстПакетаРезультата = ПолучитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	ИмяФайлаПакетаРезультата = ПолучитьИмяВременногоФайла();
	ФайлПакетаРезультата = Новый ЗаписьТекста(ИмяФайлаПакетаРезультата, "utf-8");
	ФайлПакетаРезультата.Записать(ТекстПакетаРезультата);
	ФайлПакетаРезультата.Закрыть();
	ДвоичныеДанныеПакетаРезультата = Новый ДвоичныеДанные(ИмяФайлаПакетаРезультата);
	
	РезультатыОперации = РезультатыОтправкиРеестраЭЛН(ТекстРезультата);
	СтатусОперации = СтатусОтправкиРеестраЭЛН(РезультатыОперации);
	
	ТекстHTML = ГенерироватьHTMLПротоколаОбработкиРеестраЭЛН(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации);
	
	НастройкиОтправки = Новый Структура;
	НастройкиОтправки.Вставить("ОтчетСсылка", 				ОтчетСсылка);
	НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 	ПоляДляЗаписиОтправки);
	НастройкиОтправки.Вставить("СтатусОтправки", 			СтатусОперации.СтатусОтправки);
	НастройкиОтправки.Вставить("Протокол", 					ТекстHTML);
	НастройкиОтправки.Вставить("Квитанция", 				ДвоичныеДанныеРезультата);
	НастройкиОтправки.Вставить("ПодписанныйПакет", 			ПодписанныйSOAP64);
	НастройкиОтправки.Вставить("ПакетКвитанции", 			ДвоичныеДанныеПакетаРезультата);
	НоваяОтправкаСсылка = ДобавитьОтправкуФСС(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		РезультатыОперации.ИдентификаторЗапроса,
		НастройкиОтправки);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаРезультата);
	УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	Если ПодписанныйSOAP64 <> Неопределено И НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ПодписанныйSOAP64);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НоваяОтправкаСсылка", 	НоваяОтправкаСсылка);
	Результат.Вставить("СтатусОтправки", 		СтатусОперации.СтатусОтправки);
	Возврат Результат;
	
КонецФункции

Функция РезультатыОтправкиРеестраЭЛН(ТекстРезультата)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", 	"");
	Результат.Вставить("СтатусЗапроса", 		Неопределено);
	Результат.Вставить("СообщениеОбОшибке", 	"");
	Результат.Вставить("РезультатыОбработки", 	Новый Массив);
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(Неопределено, ТекстРезультата);
	Если ДеревоXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелКонверт = НайтиУзел(ДеревоXML, "Envelope");
	Если УзелКонверт = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелТело = НайтиУзел(УзелКонверт, "Body");
	Если УзелТело = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелОтвета = НайтиУзел(УзелТело, "prParseReestrFileResponse");
	Если УзелОтвета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелРезультата = НайтиУзел(УзелОтвета, "WSResult");
	Если УзелРезультата = Неопределено Тогда
		УзелРезультата = НайтиУзел(УзелОтвета, "wsResult");
		Если УзелРезультата = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	УзелИдентификаторЗапроса = НайтиУзел(УзелРезультата, "REQUEST_ID");
	Если УзелИдентификаторЗапроса = Неопределено Тогда
		УзелИдентификаторЗапроса = НайтиУзел(УзелРезультата, "requestId");
	КонецЕсли;
	Если УзелИдентификаторЗапроса <> Неопределено Тогда
		Результат.ИдентификаторЗапроса = XMLЗначение(Тип("Строка"), УзелИдентификаторЗапроса.Значение);
		Результат.ИдентификаторЗапроса = СокрЛП(Результат.ИдентификаторЗапроса);
	КонецЕсли;
	
	УзелСтатусЗапроса = НайтиУзел(УзелРезультата, "STATUS");
	Если УзелСтатусЗапроса = Неопределено Тогда
		УзелСтатусЗапроса = НайтиУзел(УзелРезультата, "status");
	КонецЕсли;
	Если УзелСтатусЗапроса <> Неопределено И ЗначениеЗаполнено(УзелСтатусЗапроса.Значение) Тогда
		Результат.СтатусЗапроса = XMLЗначение(Тип("Число"), УзелСтатусЗапроса.Значение);
	КонецЕсли;
	
	УзелСообщениеОбОшибке = НайтиУзел(УзелРезультата, "MESS");
	Если УзелСообщениеОбОшибке = Неопределено Тогда
		УзелСообщениеОбОшибке = НайтиУзел(УзелРезультата, "mess");
	КонецЕсли;
	Если УзелСообщениеОбОшибке <> Неопределено Тогда
		Результат.СообщениеОбОшибке = XMLЗначение(Тип("Строка"), УзелСообщениеОбОшибке.Значение);
		Результат.СообщениеОбОшибке = СокрЛП(Результат.СообщениеОбОшибке);
	КонецЕсли;
	
	УзелИнформация = НайтиУзел(УзелРезультата, "INFO");
	Если УзелИнформация = Неопределено Тогда
		УзелИнформация = НайтиУзел(УзелРезультата, "info");
	КонецЕсли;
	Если УзелИнформация = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелНаборЗаписей = НайтиУзел(УзелИнформация, "ROWSET");
	Если УзелНаборЗаписей = Неопределено Тогда
		УзелНаборЗаписей = НайтиУзел(УзелИнформация, "infoRowset");
		Если УзелНаборЗаписей = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	УзлыЗапись = НайтиУзел(УзелНаборЗаписей, "ROW", Истина);
	Если УзлыЗапись.Количество() = 0 Тогда
		УзлыЗапись = НайтиУзел(УзелНаборЗаписей, "infoRow", Истина);
	КонецЕсли;
	Для каждого УзелЗапись Из УзлыЗапись Цикл
		РезультатОбработки = Новый Структура;
		РезультатОбработки.Вставить("СтатусОбработки", 	Неопределено);
		РезультатОбработки.Вставить("НомерЗаписиЛН", 	Неопределено);
		РезультатОбработки.Вставить("НомерЛН", 			"");
		РезультатОбработки.Вставить("ХешЛН", 			"");
		РезультатОбработки.Вставить("КодСостоянияЛН", 	"");
		РезультатОбработки.Вставить("ОшибкиОбработки", 	Новый Массив);
		
		УзелСтатусОбработки = НайтиУзел(УзелЗапись, "STATUS");
		Если УзелСтатусОбработки = Неопределено Тогда
			УзелСтатусОбработки = НайтиУзел(УзелЗапись, "status");
		КонецЕсли;
		Если УзелСтатусОбработки <> Неопределено И ЗначениеЗаполнено(УзелСтатусОбработки.Значение) Тогда
			РезультатОбработки.СтатусОбработки = XMLЗначение(Тип("Число"), УзелСтатусОбработки.Значение);
		КонецЕсли;
		
		УзелНомерЗаписиЛН = НайтиУзел(УзелЗапись, "ROW_NO");
		Если УзелНомерЗаписиЛН = Неопределено Тогда
			УзелНомерЗаписиЛН = НайтиУзел(УзелЗапись, "rowNo");
		КонецЕсли;
		Если УзелНомерЗаписиЛН <> Неопределено И ЗначениеЗаполнено(УзелНомерЗаписиЛН.Значение) Тогда
			РезультатОбработки.НомерЗаписиЛН = XMLЗначение(Тип("Число"), УзелНомерЗаписиЛН.Значение);
		КонецЕсли;
		
		УзелНомерЛН = НайтиУзел(УзелЗапись, "LN_CODE");
		Если УзелНомерЛН = Неопределено Тогда
			УзелНомерЛН = НайтиУзел(УзелЗапись, "lnCode");
		КонецЕсли;
		Если УзелНомерЛН <> Неопределено Тогда
			РезультатОбработки.НомерЛН = XMLЗначение(Тип("Строка"), УзелНомерЛН.Значение);
			РезультатОбработки.НомерЛН = СокрЛП(РезультатОбработки.НомерЛН);
		КонецЕсли;
		
		Если РезультатОбработки.СтатусОбработки = 1 Тогда
			УзелХешЛН = НайтиУзел(УзелЗапись, "LN_HASH");
			Если УзелХешЛН = Неопределено Тогда
				УзелХешЛН = НайтиУзел(УзелЗапись, "lnHash");
			КонецЕсли;
			Если УзелХешЛН <> Неопределено Тогда
				РезультатОбработки.ХешЛН = XMLЗначение(Тип("Строка"), УзелХешЛН.Значение);
				РезультатОбработки.ХешЛН = СокрЛП(РезультатОбработки.ХешЛН);
			КонецЕсли;
			
			УзелКодСостоянияЛН = НайтиУзел(УзелЗапись, "LN_STATE");
			Если УзелКодСостоянияЛН = Неопределено Тогда
				УзелКодСостоянияЛН = НайтиУзел(УзелЗапись, "lnState");
			КонецЕсли;
			Если УзелКодСостоянияЛН <> Неопределено Тогда
				РезультатОбработки.КодСостоянияЛН = XMLЗначение(Тип("Строка"), УзелКодСостоянияЛН.Значение);
				РезультатОбработки.КодСостоянияЛН = СокрЛП(РезультатОбработки.КодСостоянияЛН);
			КонецЕсли;
			
		Иначе
			УзелОшибкиОбработки = НайтиУзел(УзелЗапись, "ERRORS");
			Если УзелОшибкиОбработки = Неопределено Тогда
				УзелОшибкиОбработки = НайтиУзел(УзелЗапись, "errors");
			КонецЕсли;
			Если УзелОшибкиОбработки <> Неопределено Тогда
				УзлыОшибкаОбработки = НайтиУзел(УзелОшибкиОбработки, "ERROR", Истина);
				Если УзлыОшибкаОбработки.Количество() = 0 Тогда
					УзлыОшибкаОбработки = НайтиУзел(УзелОшибкиОбработки, "error", Истина);
				КонецЕсли;
				Для каждого УзелОшибкаОбработки Из УзлыОшибкаОбработки Цикл
					ОшибкаОбработки = Новый Структура;
					ОшибкаОбработки.Вставить("КодОшибки", 	"");
					ОшибкаОбработки.Вставить("ТекстОшибки", "");
					
					УзелКодОшибки = НайтиУзел(УзелОшибкаОбработки, "ERR_CODE");
					Если УзелКодОшибки = Неопределено Тогда
						УзелКодОшибки = НайтиУзел(УзелОшибкаОбработки, "errCode");
					КонецЕсли;
					Если УзелКодОшибки <> Неопределено Тогда
						ОшибкаОбработки.КодОшибки = XMLЗначение(Тип("Строка"), УзелКодОшибки.Значение);
						ОшибкаОбработки.КодОшибки = СокрЛП(ОшибкаОбработки.КодОшибки);
					КонецЕсли;
					
					УзелТекстОшибки = НайтиУзел(УзелОшибкаОбработки, "ERR_MESS");
					Если УзелТекстОшибки = Неопределено Тогда
						УзелТекстОшибки = НайтиУзел(УзелОшибкаОбработки, "errMess");
					КонецЕсли;
					Если УзелТекстОшибки <> Неопределено Тогда
						ОшибкаОбработки.ТекстОшибки = XMLЗначение(Тип("Строка"), УзелТекстОшибки.Значение);
						ОшибкаОбработки.ТекстОшибки = СокрЛП(ОшибкаОбработки.ТекстОшибки);
					КонецЕсли;
					
					РезультатОбработки.ОшибкиОбработки.Добавить(ОшибкаОбработки);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Результат.РезультатыОбработки.Добавить(РезультатОбработки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусОтправкиРеестраЭЛН(РезультатыОперации)
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусОтправки", 	Неопределено);
	Результат.Вставить("ЦветСтатуса", 		Неопределено);
	Результат.Вставить("СтатусОтчета", 		"");
	
	КоличествоСданных 		= 0;
	КоличествоОшибок 		= 0;
	КоличествоСданныхРанее 	= 0;
	Для каждого РезультатОбработки Из РезультатыОперации.РезультатыОбработки Цикл
		Если РезультатОбработки.СтатусОбработки = 1 Тогда
			КоличествоСданных = КоличествоСданных + 1;
			
		ИначеЕсли РезультатОбработки.ОшибкиОбработки.Количество() = 1
			И СтрНайти(РезультатОбработки.ОшибкиОбработки[0].ТекстОшибки,
			"Направленные данные страхователя уже присутствуют в системе") > 0 Тогда
			
			КоличествоСданныхРанее = КоличествоСданныхРанее + 1;
			
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ЭЛНСданыРанее = "";
	Если КоличествоСданныхРанее > 0 Тогда
		ЭЛНСданРанее = НСтр("ru = '%1 ЭЛН был сдан ранее';
							|en = '%1 ESLR has been submitted earlier'");
		ЭЛНСданыРанее = НСтр("ru = '%1 ЭЛН были сданы ранее';
							|en = '%1 ESLRs have been submitted earlier'");
		ЭЛНСданыРанее = ПростоеСклонение(КоличествоСданныхРанее, ЭЛНСданРанее, ЭЛНСданыРанее, ЭЛНСданыРанее);
		КоличествоСданныхРанееТекстом = Формат(КоличествоСданныхРанее, "ЧДЦ=; ЧН=; ЧГ=");
		ЭЛНСданыРанее = ". " + СтрШаблон(
			ЭЛНСданыРанее,
			КоличествоСданныхРанееТекстом);
	КонецЕсли;
	
	Если КоличествоСданных > 0 Тогда
		Если КоличествоОшибок > 0 Тогда
			ЭЛНСдан = НСтр("ru = '%1 ЭЛН сдан';
							|en = '%1 ESLR has been submitted'");
			ЭЛНСданы = НСтр("ru = '%1 ЭЛН сданы';
							|en = '%1 ESLRs have been submitted'");
			ЭЛНСданы = ПростоеСклонение(КоличествоСданных, ЭЛНСдан, ЭЛНСданы, ЭЛНСданы);
			КоличествоСданныхТекстом = Формат(КоличествоСданных, "ЧДЦ=; ЧН=; ЧГ=");
			ЭЛНСданы = СтрШаблон(
				ЭЛНСданы,
				КоличествоСданныхТекстом);
			
			ЭЛННеПринят = НСтр("ru = '%1 ЭЛН не принят, обнаружены ошибки';
								|en = '%1 ESLR not accepted, errors found'");
			ЭЛННеПриняты = НСтр("ru = '%1 ЭЛН не приняты, обнаружены ошибки';
								|en = '%1 ESLRs not accepted, errors found'");
			ЭЛННеПриняты = ПростоеСклонение(КоличествоОшибок, ЭЛННеПринят, ЭЛННеПриняты, ЭЛННеПриняты);
			КоличествоОшибокТекстом = Формат(КоличествоОшибок, "ЧДЦ=; ЧН=; ЧГ=");
			ЭЛННеПриняты = ". " + СтрШаблон(
				ЭЛННеПриняты,
				КоличествоОшибокТекстом);
			
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.ПринятЕстьОшибки;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			Результат.СтатусОтчета 		= ЭЛНСданы + ЭЛНСданыРанее + ЭЛННеПриняты;
			
		Иначе
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.Сдан;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветПоложительногоПротокола;
			Результат.СтатусОтчета 		= НСтр("ru = 'Сдан, ошибок не обнаружено';
													|en = 'Submitted, no errors detected'") + ЭЛНСданыРанее;
		КонецЕсли;
		
	Иначе
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Результат.СтатусОтчета 		= НСтр("ru = 'Не принят, обнаружены ошибки';
												|en = 'Not received, errors are detected'") + ЭЛНСданыРанее;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГенерироватьHTMLПротоколаОбработкиРеестраЭЛН(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Шаблон = ПолучитьМакет("ФССЭЛНШаблонДляHTML");
	
	СекцияШапка = Шаблон.ПолучитьОбласть("Шапка");
	
	НаименованиеПротокола = ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан,
		НСтр("ru = 'Протокол о сдаче';
			|en = 'Delivery protocol'"), ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят,
		НСтр("ru = 'Протокол ошибок';
			|en = 'Error log'"), НСтр("ru = 'Протокол о частичной сдаче';
											|en = 'Partial delivery record'")));
	
	СвойстваОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
		ОрганизацияСсылка,,
		"НаимЮЛПол, ИННЮЛ");
	ПолноеНаименованиеОрганизации 	= СвойстваОрганизации.НаимЮЛПол;
	ИННОрганизации 					= СвойстваОрганизации.ИННЮЛ;
	
	СведенияПоОбъекту = СведенияПоОтправляемымОбъектам(ОтчетСсылка);
	
	Если РезультатыОперации.СтатусЗапроса = 1 Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Реестр ЭЛН успешно загружен';
										|en = 'ESLR registry successfully loaded'");
	ИначеЕсли РезультатыОперации.СтатусЗапроса = 2 Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Реестр ЭЛН загружен с ошибками';
										|en = 'ESLR registry loaded with errors'");
	ИначеЕсли РезультатыОперации.СтатусЗапроса = 0 Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Реестр ЭЛН не загружен';
										|en = 'ESLR registry did not load'");
	Иначе
		СтатусОбработкиТекстом = Строка(РезультатыОперации.СтатусЗапроса);
	КонецЕсли;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	СекцияШапка.Параметры.НаименованиеПротокола 	= НаименованиеПротокола;
	СекцияШапка.Параметры.Организация 				= ПолноеНаименованиеОрганизации;
	СекцияШапка.Параметры.ИНН 						= НСтр("ru = 'ИНН';
															|en = 'TIN'") + " " + ИННОрганизации;
	СекцияШапка.Параметры.Получатель 				= СведенияПоОбъекту.ПредставлениеКонтролирующегоОргана;
	СекцияШапка.Параметры.Отчет 					= СведенияПоОбъекту.Наименование;
	СекцияШапка.Параметры.СтатусОтчета 				= СтатусОперации.СтатусОтчета;
	СекцияШапка.Области.СтатусОтчета.ЦветТекста 	= СтатусОперации.ЦветСтатуса;
	СекцияШапка.Параметры.ИдентификаторЗапроса 		= РезультатыОперации.ИдентификаторЗапроса;
	СекцияШапка.Параметры.СтатусОбработки 			= СтатусОбработкиТекстом;
	СекцияШапка.Параметры.ДатаПротокола 			= Формат(ДатаСеанса, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'");
	
	ТабДок.Вывести(СекцияШапка);
	
	Если ЗначениеЗаполнено(РезультатыОперации.СообщениеОбОшибке) И ВРег(РезультатыОперации.СообщениеОбОшибке) <> "OK"
		И ВРег(РезультатыОперации.СообщениеОбОшибке) <> "ОК" Тогда
		
		СекцияПротоколОшибок = Шаблон.ПолучитьОбласть("ПротоколОшибок");
		СекцияПротоколОшибок.Параметры.СообщениеОбОшибке = РезультатыОперации.СообщениеОбОшибке;
		ТабДок.Вывести(СекцияПротоколОшибок);
	КонецЕсли;
	
	ВывестиПримечаниеКСданным = Ложь;
	Если РезультатыОперации.РезультатыОбработки.Количество() > 0 Тогда
		СекцияРезультатыОбработки = Шаблон.ПолучитьОбласть("РезультатыОбработки");
		ТабДок.Вывести(СекцияРезультатыОбработки);
		
		Для ИндексРезультата = 0 По РезультатыОперации.РезультатыОбработки.Количество() - 1 Цикл
			РезультатОбработки = РезультатыОперации.РезультатыОбработки[ИндексРезультата];
			
			СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.РезультатыОбработки.Количество() - 1
				И РезультатОбработки.ОшибкиОбработки.Количество() <= 1, 2,
				?(РезультатОбработки.ОшибкиОбработки.Количество() > 1, 0, 1)),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
			
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.РезультатыОбработки.Количество() - 1
				И РезультатОбработки.ОшибкиОбработки.Количество() <= 1, 2, 1),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу = ЛинияГраницыСнизу;
			
			Если РезультатОбработки.СтатусОбработки = 1 Тогда
				ВывестиПримечаниеКСданным = Истина;
			КонецЕсли;
			
			НомерЗаписиЛНТекстом = Формат(РезультатОбработки.НомерЗаписиЛН, "ЧДЦ=; ЧН=; ЧГ=");
			СтатусОбработкиТекстом = ?(РезультатОбработки.СтатусОбработки = 1, НСтр("ru = 'Сдано';
																					|en = 'Submitted'") + "*",
				?(РезультатОбработки.СтатусОбработки = 0, НСтр("ru = 'Ошибка';
																|en = 'Error'"), Строка(РезультатОбработки.СтатусОбработки)));
			Если РезультатОбработки.КодСостоянияЛН = "010" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Открыт';
											|en = 'Open'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "020" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Продлен';
											|en = 'Extended'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "030" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Закрыт';
											|en = 'Closed'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "040" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Направление на МСЭ';
											|en = 'Appointment to MSA'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "050" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Дополнен данными МСЭ';
											|en = 'Supplemented with MSA data'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "060" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Заполнен Страхователем';
											|en = 'Populated by insurant'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "070" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Пособие начислено Страховщиком (ПВСО)';
											|en = 'Allowance accrued by Insurer (DICP)'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "080" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Пособие выплачено';
											|en = 'Allowance is paid'");
			ИначеЕсли РезультатОбработки.КодСостоянияЛН = "090" Тогда
				КодСостоянияЛНТекстом = НСтр("ru = 'Действия прекращены';
											|en = 'Actions are canceled'");
			Иначе
				КодСостоянияЛНТекстом = Строка(РезультатОбработки.КодСостоянияЛН);
			КонецЕсли;
			
			КодПервойОшибки = ?(РезультатОбработки.ОшибкиОбработки.Количество() > 0,
				РезультатОбработки.ОшибкиОбработки[0].КодОшибки, "");
			ТекстПервойОшибки = ?(РезультатОбработки.ОшибкиОбработки.Количество() > 0,
				РезультатОбработки.ОшибкиОбработки[0].ТекстОшибки, "");
			
			СекцияСтрокаРезультатов.Параметры.НомерЗаписиЛН 	= НомерЗаписиЛНТекстом;
			СекцияСтрокаРезультатов.Параметры.НомерЛН 			= РезультатОбработки.НомерЛН;
			СекцияСтрокаРезультатов.Параметры.СтатусОбработки 	= СтатусОбработкиТекстом;
			СекцияСтрокаРезультатов.Параметры.КодСостоянияЛН 	= КодСостоянияЛНТекстом;
			СекцияСтрокаРезультатов.Параметры.ХешЛН 			= РезультатОбработки.ХешЛН;
			СекцияСтрокаРезультатов.Параметры.КодОшибки 		= КодПервойОшибки;
			СекцияСтрокаРезультатов.Параметры.ТекстОшибки 		= ТекстПервойОшибки;
			
			ТабДок.Вывести(СекцияСтрокаРезультатов);
			
			Для ИндексОшибки = 1 По РезультатОбработки.ОшибкиОбработки.Количество() - 1 Цикл
				ОшибкаОбработки = РезультатОбработки.ОшибкиОбработки[ИндексОшибки];
				
				СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
				ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
				ЛинияГраницыСверху = Новый Линия(
					ЛинияГраницыСверху.ТипЛинии,
					0,
					ЛинияГраницыСверху.Отступ);
				ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
				ЛинияГраницыСнизу = Новый Линия(
					ЛинияГраницыСнизу.ТипЛинии,
					?(ИндексОшибки = РезультатОбработки.ОшибкиОбработки.Количество() - 1,
					?(ИндексРезультата = РезультатыОперации.РезультатыОбработки.Количество() - 1, 2, 1), 0),
					ЛинияГраницыСнизу.Отступ);
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
				
				ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху;
				ЛинияГраницыСверху = Новый Линия(
					ЛинияГраницыСверху.ТипЛинии,
					0,
					ЛинияГраницыСверху.Отступ);
				ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу;
				ЛинияГраницыСнизу = Новый Линия(
					ЛинияГраницыСнизу.ТипЛинии,
					?(ИндексРезультата = РезультатыОперации.РезультатыОбработки.Количество()
					И ИндексОшибки = РезультатОбработки.ОшибкиОбработки.Количество() - 1, 2, 1),
					ЛинияГраницыСнизу.Отступ);
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху = ЛинияГраницыСверху;
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу = ЛинияГраницыСнизу;
				
				СекцияСтрокаРезультатов.Параметры.НомерЗаписиЛН 	= "";
				СекцияСтрокаРезультатов.Параметры.НомерЛН 			= "";
				СекцияСтрокаРезультатов.Параметры.СтатусОбработки 	= "";
				СекцияСтрокаРезультатов.Параметры.КодСостоянияЛН 	= "";
				СекцияСтрокаРезультатов.Параметры.ХешЛН 			= "";
				СекцияСтрокаРезультатов.Параметры.КодОшибки 		= ОшибкаОбработки.КодОшибки;
				СекцияСтрокаРезультатов.Параметры.ТекстОшибки 		= ОшибкаОбработки.ТекстОшибки;
				
				ТабДок.Вывести(СекцияСтрокаРезультатов);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ВывестиПримечаниеКСданным Тогда
		СекцияПримечаниеКСданным = Шаблон.ПолучитьОбласть("ПримечаниеКСданным");
		ТабДок.Вывести(СекцияПримечаниеКСданным);
	КонецЕсли;
	
	СекцияПодвал = Шаблон.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(СекцияПодвал);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	ТекстHTML = Новый ТекстовыйДокумент;
	ТекстHTML.Прочитать(ИмяВременногоФайла);
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	Возврат ТекстHTML;
	
КонецФункции

#КонецОбласти

#Область ОтправкаПодтвержденияВидаДеятельностиФСС

Функция СохранитьПротоколПриОперацииСОКВЭДИлиПолучитьОтправкуСЭДО(
		ОтправкаСсылка,
		ОтчетСсылка,
		ОрганизацияСсылка,
		ПараметрыПротокола) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусОтправки", Неопределено);
	Результат.Вставить("Рассматривается", Ложь);
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("АдресРасшифрованногоОтветаSOAP", 	Неопределено);
	ПараметрыВызова.Вставить("АдресЗашифрованногоОтветаSOAP", 	Неопределено);
	ПараметрыВызова.Вставить("ИдентификаторОтправкиНаСервере", 	"");
	ПараметрыВызова.Вставить("ТолькоПолучитьОтправкуСЭДО", 		Ложь);
	Если ПараметрыПротокола <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВызова, ПараметрыПротокола);
	КонецЕсли;
	АдресРасшифрованногоОтветаSOAP 	= ПараметрыВызова.АдресРасшифрованногоОтветаSOAP;
	АдресЗашифрованногоОтветаSOAP 	= ПараметрыВызова.АдресЗашифрованногоОтветаSOAP;
	ИдентификаторОтправкиНаСервере 	= ПараметрыВызова.ИдентификаторОтправкиНаСервере;
	ТолькоПолучитьОтправкуСЭДО 		= ПараметрыВызова.ТолькоПолучитьОтправкуСЭДО;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Если ТолькоПолучитьОтправкуСЭДО Тогда
		СвойстваОтправки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтправкаСсылка,
			"СтатусОтправки, ВидОтчета, Организация, Квитанция");
		Если СвойстваОтправки.ВидОтчета <> Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности Тогда
			// для прочих отчетов нет статуса "Рассматривается", сразу возвращаем результат
			Результат.СтатусОтправки = СвойстваОтправки.СтатусОтправки;
			Возврат Результат;
		КонецЕсли;
		
		ДвоичныеДанныеРезультата = СвойстваОтправки.Квитанция.Получить();
		Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеРезультата) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекстРезультата = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеРезультата, "utf-8");
		
		РезультатыОперации = РезультатыОперацииСОтчетомФССЧерезСЭДО(
			ТекстРезультата,,
			СвойстваОтправки.ВидОтчета,
			СвойстваОтправки.Организация);
		
	Иначе
		ТекстРезультата = ПолучитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
		УдалитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
		ТекстПакетаРезультата = ПолучитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
		УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
		
		ИмяФайлаРезультата = ПолучитьИмяВременногоФайла();
		ФайлРезультата = Новый ЗаписьТекста(ИмяФайлаРезультата, "utf-8");
		ФайлРезультата.Записать(ТекстРезультата);
		ФайлРезультата.Закрыть();
		ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяФайлаРезультата);
		
		ИмяФайлаПакетаРезультата = ПолучитьИмяВременногоФайла();
		ФайлПакетаРезультата = Новый ЗаписьТекста(ИмяФайлаПакетаРезультата, "utf-8");
		ФайлПакетаРезультата.Записать(ТекстПакетаРезультата);
		ФайлПакетаРезультата.Закрыть();
		ДвоичныеДанныеПакетаРезультата = Новый ДвоичныеДанные(ИмяФайлаПакетаРезультата);
		
		РезультатыОперации = РезультатыОперацииСОКВЭД(ТекстРезультата);
	КонецЕсли;
	
	СтатусОперации = СтатусОперацииСОКВЭД(РезультатыОперации);
	
	Если НЕ ТолькоПолучитьОтправкуСЭДО Тогда
		ТекстHTML = ГенерироватьHTMLПротоколаОбработкиОперацииСОКВЭД(
			ОтчетСсылка,
			ОрганизацияСсылка,
			РезультатыОперации,
			СтатусОперации,
			ИдентификаторОтправкиНаСервере);
		
		РезультатОтправки = Новый Структура;
		РезультатОтправки.Вставить("ДатаПолученияРезультата", 	ДатаСеанса);
		РезультатОтправки.Вставить("СтатусОтправки", 			СтатусОперации.СтатусОтправки);
		РезультатОтправки.Вставить("Протокол", 					ТекстHTML);
		РезультатОтправки.Вставить("Квитанция", 				ДвоичныеДанныеРезультата);
		РезультатОтправки.Вставить("ПакетКвитанции", 			ДвоичныеДанныеПакетаРезультата);
		
		СохранитьРезультатОтправкиФСС(ОтправкаСсылка, РезультатОтправки);
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаРезультата);
	КонецЕсли;
	
	Результат.СтатусОтправки = СтатусОперации.СтатусОтправки;
	Результат.Рассматривается = СтатусОперации.Рассматривается;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьРезультатОтправкиПриОперацииСОКВЭД(
		ОтчетСсылка,
		ОрганизацияСсылка,
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ПараметрыРезультата) Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("АдресРасшифрованногоОтветаSOAP", 	Неопределено);
	ПараметрыВызова.Вставить("АдресЗашифрованногоОтветаSOAP", 	Неопределено);
	ПараметрыВызова.Вставить("ПоляДляЗаписиОтправки", 			Неопределено);
	ПараметрыВызова.Вставить("ПодписанныйSOAP64", 				Неопределено);
	Если ПараметрыРезультата <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВызова, ПараметрыРезультата);
	КонецЕсли;
	АдресРасшифрованногоОтветаSOAP 	= ПараметрыВызова.АдресРасшифрованногоОтветаSOAP;
	АдресЗашифрованногоОтветаSOAP 	= ПараметрыВызова.АдресЗашифрованногоОтветаSOAP;
	ПоляДляЗаписиОтправки 			= ПараметрыВызова.ПоляДляЗаписиОтправки;
	ПодписанныйSOAP64 				= ПараметрыВызова.ПодписанныйSOAP64;
	
	ТекстРезультата = ПолучитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	УдалитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	
	ИмяФайлаРезультата = ПолучитьИмяВременногоФайла();
	ФайлРезультата = Новый ЗаписьТекста(ИмяФайлаРезультата, "utf-8");
	ФайлРезультата.Записать(ТекстРезультата);
	ФайлРезультата.Закрыть();
	ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяФайлаРезультата);
	
	ТекстПакетаРезультата = ПолучитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	ИмяФайлаПакетаРезультата = ПолучитьИмяВременногоФайла();
	ФайлПакетаРезультата = Новый ЗаписьТекста(ИмяФайлаПакетаРезультата, "utf-8");
	ФайлПакетаРезультата.Записать(ТекстПакетаРезультата);
	ФайлПакетаРезультата.Закрыть();
	ДвоичныеДанныеПакетаРезультата = Новый ДвоичныеДанные(ИмяФайлаПакетаРезультата);
	
	РезультатыОперации = РезультатыОперацииСОКВЭД(ТекстРезультата);
	СтатусОперации = СтатусОперацииСОКВЭД(РезультатыОперации);
	
	ТекстHTML = ГенерироватьHTMLПротоколаОбработкиОперацииСОКВЭД(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации);
	
	НастройкиОтправки = Новый Структура;
	НастройкиОтправки.Вставить("ОтчетСсылка", 				ОтчетСсылка);
	НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 	ПоляДляЗаписиОтправки);
	НастройкиОтправки.Вставить("СтатусОтправки", 			СтатусОперации.СтатусОтправки);
	НастройкиОтправки.Вставить("Протокол", 					ТекстHTML);
	НастройкиОтправки.Вставить("Квитанция", 				ДвоичныеДанныеРезультата);
	НастройкиОтправки.Вставить("ПодписанныйПакет", 			ПодписанныйSOAP64);
	НастройкиОтправки.Вставить("ПакетКвитанции", 			ДвоичныеДанныеПакетаРезультата);
	НоваяОтправкаСсылка = ДобавитьОтправкуФСС(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		РезультатыОперации.ИдентификаторЗапроса,
		НастройкиОтправки);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаРезультата);
	УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	Если НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ПодписанныйSOAP64);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НоваяОтправкаСсылка", 	НоваяОтправкаСсылка);
	Результат.Вставить("СтатусОтправки", 		СтатусОперации.СтатусОтправки);
	Результат.Вставить("Рассматривается", 		СтатусОперации.Рассматривается);
	Возврат Результат;
	
КонецФункции

Функция РезультатыОперацииСОКВЭД(ТекстРезультата)
	
	Результат = Новый Структура;
	Результат.Вставить("ТипРезультата", 		"");
	Результат.Вставить("ИдентификаторОтчета", 	"");
	Результат.Вставить("СтатусОбработки", 		"");
	Результат.Вставить("ДатаОтчета", 			Неопределено);
	Результат.Вставить("СообщениеОбОшибке", 	"");
	Результат.Вставить("РезультатыВЦелом", 		Новый Массив);
	Результат.Вставить("ИсторияСменыСтатусов", 	Новый Массив);
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(Неопределено, ТекстРезультата);
	Если ДеревоXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелКонверт = НайтиУзел(ДеревоXML, "Envelope");
	Если УзелКонверт = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелТело = НайтиУзел(УзелКонверт, "Body");
	Если УзелТело = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелОтвета = НайтиУзел(УзелТело, "OKVEDConfirmationResponse");
	Если УзелОтвета = Неопределено Тогда
		УзелОтвета = НайтиУзел(УзелТело, "getResultByIdResponse");
		
		Если УзелОтвета = Неопределено Тогда
			Если УзелТело.Строки.Количество() >= 1 Тогда
				УзелОтвета = УзелТело.Строки[0];
			Иначе
				Возврат Результат;
			КонецЕсли;
			
		Иначе
			Результат.ТипРезультата = "РезультатОбработки";
		КонецЕсли;
		
	Иначе
		Результат.ТипРезультата = "РезультатОтправки";
	КонецЕсли;
	
	УзелИдентификаторОтчета = НайтиУзел(УзелОтвета, "transportId");
	Если УзелИдентификаторОтчета = Неопределено Тогда
		УзелИдентификаторОтчета = НайтиУзел(УзелОтвета, "requestId");
	КонецЕсли;
	Если УзелИдентификаторОтчета <> Неопределено Тогда
		Результат.ИдентификаторОтчета = XMLЗначение(Тип("Строка"), УзелИдентификаторОтчета.Значение);
	КонецЕсли;
	
	УзелСтатусОбработки = НайтиУзел(УзелОтвета, "requestStatus");
	Если УзелСтатусОбработки <> Неопределено Тогда
		Результат.СтатусОбработки = XMLЗначение(Тип("Строка"), УзелСтатусОбработки.Значение);
		Результат.СтатусОбработки = СокрЛП(Результат.СтатусОбработки);
		Результат.СтатусОбработки = ВРег(Результат.СтатусОбработки);
	КонецЕсли;
	
	УзелДатаОтчета = НайтиУзел(УзелОтвета, "crDate");
	Если УзелДатаОтчета <> Неопределено И ЗначениеЗаполнено(УзелДатаОтчета.Значение) Тогда
		Результат.ДатаОтчета = XMLЗначение(Тип("Дата"), УзелДатаОтчета.Значение);
	КонецЕсли;
	
	Если Результат.ТипРезультата <> "РезультатОбработки" Тогда
		УзелСообщениеОбОшибке = НайтиУзел(УзелОтвета, "errorMessage");
		Если УзелСообщениеОбОшибке <> Неопределено Тогда
			Результат.СообщениеОбОшибке = XMLЗначение(Тип("Строка"), УзелСообщениеОбОшибке.Значение);
		КонецЕсли;
	КонецЕсли;
	
	Если Результат.ТипРезультата <> "РезультатОтправки" Тогда
		УзелРезультатОбработки = НайтиУзел(УзелОтвета, "processingResult");
		Если УзелРезультатОбработки <> Неопределено Тогда
			УзелРезультатыВЦелом = НайтиУзел(УзелРезультатОбработки, "results");
			Если УзелРезультатыВЦелом <> Неопределено Тогда
				УзлыХранилищаРезультатов = НайтиУзел(УзелРезультатыВЦелом, "storage", Истина);
				Для каждого УзелХранилищаРезультатов Из УзлыХранилищаРезультатов Цикл
					РезультатВЦелом = Новый Структура;
					РезультатВЦелом.Вставить("КодСообщения", 	"");
					РезультатВЦелом.Вставить("ТекстСообщения", 	"");
					
					УзелКодСообщения = НайтиУзел(УзелХранилищаРезультатов, "code");
					Если УзелКодСообщения <> Неопределено Тогда
						РезультатВЦелом.КодСообщения = XMLЗначение(Тип("Строка"), УзелКодСообщения.Значение);
					КонецЕсли;
					
					УзелТекстСообщения = НайтиУзел(УзелХранилищаРезультатов, "message");
					Если УзелТекстСообщения <> Неопределено Тогда
						РезультатВЦелом.ТекстСообщения = XMLЗначение(Тип("Строка"), УзелТекстСообщения.Значение);
					КонецЕсли;
					
					Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
				КонецЦикла;
			КонецЕсли;
			
			УзлыИсторияСменыСтатусов = НайтиУзел(УзелРезультатОбработки, "claimStatusInfo", Истина);
			Для каждого УзелИсторияСменыСтатусов Из УзлыИсторияСменыСтатусов Цикл
				СтатусОбработки = Новый Структура;
				СтатусОбработки.Вставить("СтатусРассмотрения", 	"");
				СтатусОбработки.Вставить("КомментарийСтатуса", 	"");
				СтатусОбработки.Вставить("ДатаСтатуса", 			Неопределено);
				
				УзелСтатусРассмотрения = НайтиУзел(УзелИсторияСменыСтатусов, "status");
				Если УзелСтатусРассмотрения <> Неопределено Тогда
					СтатусОбработки.СтатусРассмотрения = XMLЗначение(Тип("Строка"), УзелСтатусРассмотрения.Значение);
					СтатусОбработки.СтатусРассмотрения = СокрЛП(СтатусОбработки.СтатусРассмотрения);
					СтатусОбработки.СтатусРассмотрения = ВРег(СтатусОбработки.СтатусРассмотрения);
				КонецЕсли;
				
				УзелКомментарийСтатуса = НайтиУзел(УзелИсторияСменыСтатусов, "reason");
				Если УзелКомментарийСтатуса <> Неопределено Тогда
					СтатусОбработки.КомментарийСтатуса = XMLЗначение(Тип("Строка"), УзелКомментарийСтатуса.Значение);
				КонецЕсли;
				
				УзелДатаСтатуса = НайтиУзел(УзелИсторияСменыСтатусов, "createDate");
				Если УзелДатаСтатуса <> Неопределено И ЗначениеЗаполнено(УзелДатаСтатуса.Значение) Тогда
					СтатусОбработки.ДатаСтатуса = XMLЗначение(Тип("Дата"), УзелДатаСтатуса.Значение);
				КонецЕсли;
				
				Результат.ИсторияСменыСтатусов.Добавить(СтатусОбработки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТекстСтатусаОтчетаСОКВЭД(ШаблонТекста, ИсторияСменыСтатусов)
	
	ТекстСтатусаОтчета = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ШаблонТекста);
			
	ИндексСтатуса = ИсторияСменыСтатусов.ВГраница();
	Если ИндексСтатуса >= 0
		И ЗначениеЗаполнено(ИсторияСменыСтатусов[ИндексСтатуса].КомментарийСтатуса) Тогда
		Статус = ИсторияСменыСтатусов[ИндексСтатуса];
		ТекстСтатусаОтчета 			= ТекстСтатусаОтчета
			+ " " + НСтр("ru = 'по причине:';
						|en = 'Reason:'")
			+ " "
			+ Статус.КомментарийСтатуса;
	КонецЕсли;
			
	Возврат ТекстСтатусаОтчета;
	
КонецФункции

Функция СтатусОперацииСОКВЭД(РезультатыОперации)
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусРассмотрения", 	"");
	Результат.Вставить("ДатаСтатуса", 			Неопределено);
	Результат.Вставить("СтатусОтправки", 		Перечисления.СтатусыОтправки.Отправлен);
	Результат.Вставить("ЦветСтатуса", 			ЦветаСтиля.ЦветНезавершившейсяОтправкиБРО);
	Результат.Вставить("СтатусОтчета", 			"");
	Результат.Вставить("Рассматривается", 		Ложь);
	
	Результат.СтатусРассмотрения = "";
	Результат.ДатаСтатуса = Неопределено;
	Для каждого СтатусОбработки Из РезультатыОперации.ИсторияСменыСтатусов Цикл
		ПриоритетСтатуса = ?(НЕ ЗначениеЗаполнено(Результат.СтатусРассмотрения), 0,
			?(Результат.СтатусРассмотрения = "REGISTERED", 1, 2));
		ПриоритетСтатусаОтчета = ?(НЕ ЗначениеЗаполнено(СтатусОбработки.СтатусРассмотрения), 0,
			?(СтатусОбработки.СтатусРассмотрения = "REGISTERED", 1, 2));
		
		Если ПриоритетСтатусаОтчета > ПриоритетСтатуса
			ИЛИ ПриоритетСтатусаОтчета = ПриоритетСтатуса И (НЕ ЗначениеЗаполнено(Результат.ДатаСтатуса)
			ИЛИ ЗначениеЗаполнено(СтатусОбработки.ДатаСтатуса)
			И СтатусОбработки.ДатаСтатуса >= Результат.ДатаСтатуса) Тогда
			
			Результат.СтатусРассмотрения 	= СтатусОбработки.СтатусРассмотрения;
			Результат.ДатаСтатуса 			= СтатусОбработки.ДатаСтатуса;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.СтатусРассмотрения = "CONFIRMED" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.Сдан;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветПоложительногоПротокола;
		Результат.СтатусОтчета 		= НСтр("ru = 'Сдан, ошибок не обнаружено';
												|en = 'Submitted, no errors detected'");
		
	ИначеЕсли Результат.СтатусРассмотрения = "CANCELED" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Шаблон = НСтр("ru = 'Заявление на подтверждение отменено сотрудником ФСС';
						|en = 'Application for confirmation canceled by SSF employee'");
		ТекстСтатусаОтчета = СформироватьТекстСтатусаОтчетаСОКВЭД(
			Шаблон, РезультатыОперации.ИсторияСменыСтатусов);
		Результат.СтатусОтчета 		= ТекстСтатусаОтчета;
		
	ИначеЕсли Результат.СтатусРассмотрения = "REJECTED" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Шаблон = НСтр("ru = 'Не подтвержден сотрудником ФСС';
						|en = 'Not confirmed by FSS employee'");
		ТекстСтатусаОтчета = СформироватьТекстСтатусаОтчетаСОКВЭД(
			Шаблон, РезультатыОперации.ИсторияСменыСтатусов);
		Результат.СтатусОтчета 		= ТекстСтатусаОтчета;
		
	ИначеЕсли РезультатыОперации.СтатусОбработки = "PROCESSING_ERROR" Тогда
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Результат.СтатусОтчета 		= НСтр("ru = 'Не принят, обнаружены ошибки';
												|en = 'Not received, errors are detected'");
		
	ИначеЕсли Результат.СтатусРассмотрения = "REGISTERED" ИЛИ Результат.СтатусРассмотрения = "SEND"
		ИЛИ РезультатыОперации.СтатусОбработки = "PROCESSED" Тогда
		
		Результат.Рассматривается = Истина;
		ТекстСтатусаОтчета =
			НСтр("ru = 'Отчет рассматривается ФСС.
					   |Окончательный протокол должен быть сформирован по результатам рассмотрения сотрудником ФСС в срок от 1 дня до 2-х недель.
					   |Для обновления статуса отправки отчета используйте кнопку ""Обновить"" на верхней панели отчета.';
					   |en = 'Report is reviewed by FSS.
					   |The final protocol is to be generated based on the review results by FSS employee in the period from 1 day to 2 weeks.
					   | To update the report sending status, click ""Update"" on the top report bar.'");
		Результат.СтатусОтчета = ДокументооборотСКОКлиентСервер.ЗаменитьПФРиФССнаСФР(ТекстСтатусаОтчета, Истина);
		
	Иначе
		Результат.СтатусОтчета =
			НСтр("ru = 'Находится в обработке, попробуйте через некоторое время использовать кнопку ""Обновить"" на верхней панели отчета';
				|en = 'Being processed, try to click ""Update"" on the top report bar after some time'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГенерироватьHTMLПротоколаОбработкиОперацииСОКВЭД(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации,
		ИдентификаторОтправкиНаСервере = Неопределено)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Шаблон = ПолучитьМакет("ФССОКВЭДШаблонДляHTML");
	
	СекцияШапка = Шаблон.ПолучитьОбласть("Шапка");
	
	НаименованиеПротокола = ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан,
		НСтр("ru = 'Протокол о сдаче';
			|en = 'Delivery protocol'"), ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят,
		НСтр("ru = 'Протокол ошибок';
			|en = 'Error log'"), НСтр("ru = 'Промежуточный протокол';
											|en = 'Intermediate protocol'")));
	
	СвойстваОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
		ОрганизацияСсылка,,
		"НаимЮЛПол, ИННЮЛ");
	ПолноеНаименованиеОрганизации 	= СвойстваОрганизации.НаимЮЛПол;
	ИННОрганизации 					= СвойстваОрганизации.ИННЮЛ;
	
	СведенияПоОбъекту = СведенияПоОтправляемымОбъектам(ОтчетСсылка);
	
	ИдентификаторОтправки = ?(ЗначениеЗаполнено(ИдентификаторОтправкиНаСервере),
		ИдентификаторОтправкиНаСервере, РезультатыОперации.ИдентификаторОтчета);
	
	Если РезультатыОперации.СтатусОбработки = "REGISTERED" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Сообщение зарегистрировано';
										|en = 'Message registered'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = "READY_TO_PROCESS" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Сообщение готово к обработке';
										|en = 'Message is ready for processing'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = "PROCESSING" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Обрабатывается';
										|en = 'Processing'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = "PROCESSED" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Сообщение успешно обработано';
										|en = 'Message successfully processed'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = "PROCESSING_ERROR" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Ошибка обработки сообщения';
										|en = 'Message processing error'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = "CANCELED" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Сообщение отменено';
										|en = 'Message is canceled'");
	Иначе
		СтатусОбработкиТекстом = РезультатыОперации.СтатусОбработки;
	КонецЕсли;
	
	ДатаОтчетаСВременем = ЗначениеЗаполнено(РезультатыОперации.ДатаОтчета) И (Час(РезультатыОперации.ДатаОтчета) <> 0
		ИЛИ Минута(РезультатыОперации.ДатаОтчета) <> 0 ИЛИ Секунда(РезультатыОперации.ДатаОтчета) <> 0);
	ДатаОтчетаТекстом = Формат(РезультатыОперации.ДатаОтчета,
		?(ДатаОтчетаСВременем, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'", "ДФ='дд.ММ.гггг'"));
	
	СекцияШапка.Параметры.НаименованиеПротокола 	= НаименованиеПротокола;
	СекцияШапка.Параметры.Организация 				= ПолноеНаименованиеОрганизации;
	СекцияШапка.Параметры.ИНН 						= НСтр("ru = 'ИНН ';
															|en = 'TIN'") + ИННОрганизации;
	СекцияШапка.Параметры.Получатель 				= СведенияПоОбъекту.ПредставлениеКонтролирующегоОргана;
	СекцияШапка.Параметры.Отчет 					= СведенияПоОбъекту.Наименование;
	СекцияШапка.Параметры.СтатусОтчета 				= СтатусОперации.СтатусОтчета;
	СекцияШапка.Области.СтатусОтчета.ЦветТекста 	= СтатусОперации.ЦветСтатуса;
	СекцияШапка.Параметры.ИдентификаторОтчета 		= ИдентификаторОтправки;
	СекцияШапка.Параметры.СтатусОбработки 			= СтатусОбработкиТекстом;
	СекцияШапка.Параметры.ДатаОтправки 				= ДатаОтчетаТекстом;
	
	ТабДок.Вывести(СекцияШапка);
	
	Если ЗначениеЗаполнено(РезультатыОперации.СообщениеОбОшибке) Тогда
		СекцияПротоколОшибок = Шаблон.ПолучитьОбласть("ПротоколОшибок");
		СекцияПротоколОшибок.Параметры.СообщениеОбОшибке = РезультатыОперации.СообщениеОбОшибке;
		ТабДок.Вывести(СекцияПротоколОшибок);
		
		Если РезультатыОперации.РезультатыВЦелом.Количество() > 0 Тогда
			СекцияРазделительПротокола = Шаблон.ПолучитьОбласть("РазделительПротокола");
			ТабДок.Вывести(СекцияРазделительПротокола);
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатыОперации.РезультатыВЦелом.Количество() > 0 Тогда
		СекцияРезультатыОбработки = Шаблон.ПолучитьОбласть("РезультатыОбработки");
		ТабДок.Вывести(СекцияРезультатыОбработки);
		
		Для ИндексРезультата = 0 По РезультатыОперации.РезультатыВЦелом.Количество() - 1 Цикл
			РезультатВЦелом = РезультатыОперации.РезультатыВЦелом[ИндексРезультата];
			
			СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.РезультатыВЦелом.Количество() - 1, 2, 1),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
			
			СекцияСтрокаРезультатов.Параметры.КодСообщения = РезультатВЦелом.КодСообщения;
			СекцияСтрокаРезультатов.Параметры.ТекстСообщения = РезультатВЦелом.ТекстСообщения;
			
			ТабДок.Вывести(СекцияСтрокаРезультатов);
		КонецЦикла;
		
		Если РезультатыОперации.ИсторияСменыСтатусов.Количество() > 0 Тогда
			СекцияРазделительРезультатов = Шаблон.ПолучитьОбласть("РазделительРезультатов");
			ТабДок.Вывести(СекцияРазделительРезультатов);
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатыОперации.ИсторияСменыСтатусов.Количество() > 0 Тогда
		СекцияШапкаИстории = Шаблон.ПолучитьОбласть("ШапкаИстории");
		ТабДок.Вывести(СекцияШапкаИстории);
		
		Для ИндексСтатуса = 0 По РезультатыОперации.ИсторияСменыСтатусов.Количество() - 1 Цикл
			СтатусОбработки = РезультатыОперации.ИсторияСменыСтатусов[ИндексСтатуса];
			
			СекцияСтрокаИстории = Шаблон.ПолучитьОбласть("СтрокаИстории");
			ЛинияГраницыСверху = СекцияСтрокаИстории.Области.ПоляСтрокиИстории.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексСтатуса = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаИстории.Области.ПоляСтрокиИстории.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексСтатуса = РезультатыОперации.ИсторияСменыСтатусов.Количество() - 1, 2, 1),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаИстории.Области.ПоляСтрокиИстории.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаИстории.Области.ПоляСтрокиИстории.ГраницаСнизу = ЛинияГраницыСнизу;
			
			ДатаСтатусаСВременем = ЗначениеЗаполнено(СтатусОбработки.ДатаСтатуса)
				И (Час(СтатусОбработки.ДатаСтатуса) <> 0 ИЛИ Минута(СтатусОбработки.ДатаСтатуса) <> 0
				ИЛИ Секунда(СтатусОбработки.ДатаСтатуса) <> 0);
			ДатаОтчетаТекстом = Формат(СтатусОбработки.ДатаСтатуса,
				?(ДатаСтатусаСВременем, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'", "ДФ='дд.ММ.гггг'"));
				
			Если СтатусОбработки.СтатусРассмотрения = "REGISTERED" Тогда
				СтатусРассмотренияТекстом = НСтр("ru = 'Создано заявление';
												|en = 'Application created'");
			ИначеЕсли СтатусОбработки.СтатусРассмотрения = "CONFIRMED" Тогда
				СтатусРассмотренияТекстом = НСтр("ru = 'Подтвержден';
												|en = 'Confirmed'");
			ИначеЕсли СтатусОбработки.СтатусРассмотрения = "CANCELED" Тогда
				СтатусРассмотренияТекстом = НСтр("ru = 'Заявление отменено';
												|en = 'Application canceled'");
			ИначеЕсли СтатусОбработки.СтатусРассмотрения = "REJECTED" Тогда
				СтатусРассмотренияТекстом = НСтр("ru = 'Не подтвержден';
												|en = 'Not confirmed'");
			ИначеЕсли СтатусОбработки.СтатусРассмотрения = "SEND" Тогда
				СтатусРассмотренияТекстом = НСтр("ru = 'Заявление отправлено';
												|en = 'Application is sent'");
			Иначе
				СтатусРассмотренияТекстом = СтатусОбработки.СтатусРассмотрения;
			КонецЕсли;
			
			СекцияСтрокаИстории.Параметры.ДатаСтатуса 			= ДатаОтчетаТекстом;
			СекцияСтрокаИстории.Параметры.СтатусРассмотрения 	= СтатусРассмотренияТекстом;
			СекцияСтрокаИстории.Параметры.КомментарийСтатуса 	= СтатусОбработки.КомментарийСтатуса;
			
			ТабДок.Вывести(СекцияСтрокаИстории);
		КонецЦикла;
	КонецЕсли;
	
	СекцияПодвал = Шаблон.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(СекцияПодвал);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	ТекстHTML = Новый ТекстовыйДокумент;
	ТекстHTML.Прочитать(ИмяВременногоФайла);
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	Возврат ТекстHTML;
	
КонецФункции

Функция РазобратьУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельностиСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ"	, 					"");
	Результат.Вставить("СтатусОбработки", 						"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	// <ns2:statusChangeNotification xmlns:ns2="http://ws.fss.ru/integration/types/rust/poved/v01" responseOn="e9556c68-0c4d-4811-ad97-f4b7aefd1195">
	//    <requestNum>0204_009876</requestNum>
	//    <requestStatus>REGISTERED</requestStatus>
	// </ns2:statusChangeNotification>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("requestNum") = Неопределено
			И ДанныеОтвета.Свойства().Получить("requestStatus") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.responseOn;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuidInbound") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuidInbound;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("requestNum") <> Неопределено Тогда
		Результат.НомерОтчетаРУСТ = ДанныеОтвета.requestNum;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("requestStatus") <> Неопределено Тогда
		Результат.СтатусОбработки = ДанныеОтвета.requestStatus;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("note") <> Неопределено Тогда
		Результат.КомментарийКСтатусуОбработкиОтчета = ДанныеОтвета.note;
		
		// заявление отменено в связи с получением заявления
		Если НЕ ЗначениеЗаполнено(Результат.СтатусОбработки)
			И СтрНачинаетсяС(Результат.КомментарийКСтатусуОбработкиОтчета, "Заявление отменено") Тогда
			
			Результат.СтатусОбработки = "CANCELED";
		КонецЕсли;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьРезультатОбработкиОтчета4ФСССЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ"	, 					"");
	Результат.Вставить("СтатусОбработки", 						"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Результат.Вставить("ДатаОтчета", 							Неопределено);
	Результат.Вставить("ГодОтчета", 							Неопределено);
	Результат.Вставить("КварталОтчета", 						Неопределено);
	Результат.Вставить("ПротоколОбработки", 					Новый Массив);
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <?xml version="1.0" encoding="utf-8"?>
	// <ns3:ReportVerificationProtocol xmlns:ns2="http://fz122.fss.ru"
	//     xmlns:ns3="http://www.fss.ru/integration/types/sedo/v01">
	//   <ns2:uuid>92b387291010430cb250fb7847e588cb</ns2:uuid>
	//   <ns2:datereceived>2019-04-01+05:00</ns2:datereceived>
	//   <ns2:year>2019</ns2:year>
	//   <ns2:quarter>06</ns2:quarter>
	//   <ns2:status>SUCCESS</ns2:status>
	//   <ns2:protocol>
	//     <ns2:dateprotocol>2019-04-01+05:00</ns2:dateprotocol>
	//     <ns2:number>12442556367633678</ns2:number>
	//     <ns2:document>
	//       <ns2:content>UEsDBBQACAgIAA...</ns2:content>
	//       <ns2:ext>pdf</ns2:ext>
	//       <ns2:size>3542</ns2:size>
	//     </ns2:document>
	//     <ns2:sign>
	//       <ns2:content>UEsDBBQACAgIAA5im...</ns2:content>
	//       <ns2:ext>pdf</ns2:ext>
	//       <ns2:size>3542</ns2:size>
	//     </ns2:sign>
	//   </ns2:protocol>
	// </ns3:ReportVerificationProtocol>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("uuid") = Неопределено
			И ДанныеОтвета.Свойства().Получить("year") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.responseOn;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuid") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuid;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuidInbound") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuidInbound;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("dateReceived") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.dateReceived) Тогда
		Результат.ДатаОтчета = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ДанныеОтвета.dateReceived);
	ИначеЕсли ДанныеОтвета.Свойства().Получить("datereceived") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.datereceived) Тогда
		Результат.ДатаОтчета = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ДанныеОтвета.datereceived);
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("status") <> Неопределено Тогда
		Результат.СтатусОбработки = ДанныеОтвета.status;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("year") <> Неопределено Тогда
		Результат.ГодОтчета = ДанныеОтвета.year;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("quarter") <> Неопределено Тогда
		Результат.КварталОтчета = ДанныеОтвета.quarter;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("errors") <> Неопределено
		И ДанныеОтвета.errors.Свойства().Получить("error") <> Неопределено Тогда
		
		Для каждого УзелСообщения Из ЗначениеВКоллекцию(ДанныеОтвета.errors.error) Цикл
			КодСообщения = ?(УзелСообщения.Свойства().Получить("code") = Неопределено, "", УзелСообщения.code);
			ТекстСообщения = ?(УзелСообщения.Свойства().Получить("message") = Неопределено, "", УзелСообщения.message);
			Рекомендации = ?(УзелСообщения.Свойства().Получить("details") = Неопределено, "", УзелСообщения.details);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	КодСообщения);
			РезультатВЦелом.Вставить("ТипСообщения", 	"");
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	Рекомендации);
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено Тогда
		УзелПротокола = ДанныеОтвета.protocol;
		
		РезультатОбработки = Новый Структура;
		РезультатОбработки.Вставить("ДатаПротокола", 			Неопределено);
		РезультатОбработки.Вставить("НомерПротокола", 			"");
		РезультатОбработки.Вставить("Содержимое", 				Неопределено);
		РезультатОбработки.Вставить("РасширениеСодержимого", 	"");
		РезультатОбработки.Вставить("MIMEТипСодержимого", 		"");
		РезультатОбработки.Вставить("РазмерСодержимого", 		Неопределено);
		РезультатОбработки.Вставить("ИмяСодержимого", 			Неопределено);
		РезультатОбработки.Вставить("Подпись", 					Неопределено);
		РезультатОбработки.Вставить("РасширениеПодписи", 		"");
		РезультатОбработки.Вставить("MIMEТипПодписи", 			"");
		РезультатОбработки.Вставить("РазмерПодписи", 			Неопределено);
		РезультатОбработки.Вставить("ИмяПодписи", 				Неопределено);
		
		Если УзелПротокола.Свойства().Получить("date") <> Неопределено И ЗначениеЗаполнено(УзелПротокола.date) Тогда
			РезультатОбработки.ДатаПротокола = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелПротокола.date);
		ИначеЕсли УзелПротокола.Свойства().Получить("dateprotocol") <> Неопределено
			И ЗначениеЗаполнено(УзелПротокола.dateprotocol) Тогда
			РезультатОбработки.ДатаПротокола = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
				УзелПротокола.dateprotocol);
		КонецЕсли;
		
		Если УзелПротокола.Свойства().Получить("num") <> Неопределено Тогда
			РезультатОбработки.НомерПротокола = УзелПротокола.num;
		ИначеЕсли УзелПротокола.Свойства().Получить("number") <> Неопределено Тогда
			РезультатОбработки.НомерПротокола = УзелПротокола.number;
		КонецЕсли;
		
		Если УзелПротокола.Свойства().Получить("document") <> Неопределено Тогда
			УзелСодержимого = УзелПротокола.document;
			
			Если УзелСодержимого.Свойства().Получить("content") <> Неопределено Тогда
				РезультатОбработки.Содержимое = Base64Значение(УзелСодержимого.content);
			КонецЕсли;
			Если УзелСодержимого.Свойства().Получить("ext") <> Неопределено Тогда
				РезультатОбработки.РасширениеСодержимого = УзелСодержимого.ext;
			КонецЕсли;
			Если УзелСодержимого.Свойства().Получить("mimeType") <> Неопределено Тогда
				РезультатОбработки.MIMEТипСодержимого = УзелСодержимого.mimeType;
			КонецЕсли;
			Если УзелСодержимого.Свойства().Получить("size") <> Неопределено Тогда
				РезультатОбработки.РазмерСодержимого = УзелСодержимого.size;
			КонецЕсли;
			Если УзелСодержимого.Свойства().Получить("name") <> Неопределено Тогда
				РезультатОбработки.ИмяСодержимого = УзелСодержимого.name;
			КонецЕсли;
		КонецЕсли;
		
		Если УзелПротокола.Свойства().Получить("sign") <> Неопределено Тогда
			УзелПодписи = УзелПротокола.sign;
			
			Если УзелПодписи.Свойства().Получить("content") <> Неопределено Тогда
				РезультатОбработки.Подпись = Base64Значение(УзелПодписи.content);
			КонецЕсли;
			Если УзелПодписи.Свойства().Получить("ext") <> Неопределено Тогда
				РезультатОбработки.РасширениеПодписи = УзелПодписи.ext;
			КонецЕсли;
			Если УзелПодписи.Свойства().Получить("mimeType") <> Неопределено Тогда
				РезультатОбработки.MIMEТипПодписи = УзелПодписи.mimeType;
			КонецЕсли;
			Если УзелПодписи.Свойства().Получить("size") <> Неопределено Тогда
				РезультатОбработки.РазмерПодписи = УзелПодписи.size;
			КонецЕсли;
			Если УзелПодписи.Свойства().Получить("name") <> Неопределено Тогда
				РезультатОбработки.ИмяПодписи = УзелПодписи.name;
			КонецЕсли;
		КонецЕсли;
		
		Результат.ПротоколОбработки.Добавить(РезультатОбработки);
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникамСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ"	, 					"");
	Результат.Вставить("СтатусОбработки", 						"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Результат.Вставить("ИдентификаторОтправки", 				"");
	Результат.Вставить("ДатаВремяОбработки", 					Неопределено);
	Результат.Вставить("СообщенияОбОшибках", 					"");
	Результат.Вставить("ОшибкиПервичнойОбработки", 				Новый Массив);
	Результат.Вставить("ПредупрежденияПервичнойОбработки", 		Новый Массив);
	Результат.Вставить("ПротоколОбработки", 					Новый Массив);
	Результат.Вставить("НомераСданныхЗаписей", 					Новый Массив);
	Результат.Вставить("НомераНеПринятыхЗаписей", 				Новый Массив);
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <?xml version="1.0" encoding="UTF-8"?>
	// <n1:submitCovidWorkerRegistrResponse xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	//      xmlns:n1="http://www.fss.ru/integration/types/pvso/quarantine/covidworkerregistr/v01"
	//      xsi:schemaLocation="http://www.fss.ru/integration/types/pvso/quarantine/covidworkerregistr/v01 CovidWorkerRegistr.xsd">
	//    <n1:dateTimeReceive>2001-12-17T09:30:47Z</n1:dateTimeReceive>
	//    <n1:recriveID>a</n1:recriveID>
	//    <n1:statusGeneral>0</n1:statusGeneral>
	//    <n1:firstErrorList>
	//       <n1:error>
	//          <n1:errorCode>a</n1:errorCode>
	//          <n1:errorDescription>a</n1:errorDescription>
	//       </n1:error>
	//       <n1:error>
	//          <n1:errorCode>a</n1:errorCode>
	//          <n1:errorDescription>a</n1:errorDescription>
	//       </n1:error>
	//    </n1:firstErrorList>
	//    <n1:protocol>
	//       <n1:failedList>
	//          <n1:failedBatchNoDetail>
	//             <n1:batchNo>C_0000000000_1900_00_00_00:0</n1:batchNo>
	//             <n1:errorList>
	//                <n1:error>
	//                   <n1:errorCode>a</n1:errorCode>
	//                   <n1:errorDescription>a</n1:errorDescription>
	//                </n1:error>
	//                <n1:error>
	//                   <n1:errorCode>a</n1:errorCode>
	//                   <n1:errorDescription>a</n1:errorDescription>
	//                </n1:error>
	//             </n1:errorList>
	//          </n1:failedBatchNoDetail>
	//          <n1:failedBatchNoDetail>
	//             <n1:batchNo>C_0000000000_1900_00_00_00:0</n1:batchNo>
	//             <n1:errorList>
	//                <n1:error>
	//                   <n1:errorCode>a</n1:errorCode>
	//                   <n1:errorDescription>a</n1:errorDescription>
	//                </n1:error>
	//                <n1:error>
	//                   <n1:errorCode>a</n1:errorCode>
	//                   <n1:errorDescription>a</n1:errorDescription>
	//                </n1:error>
	//             </n1:errorList>
	//          </n1:failedBatchNoDetail>
	//       </n1:failedList>
	//    </n1:protocol>
	//</n1:submitCovidWorkerRegistrResponse>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("statusGeneral") = Неопределено
			И ДанныеОтвета.Свойства().Получить("recriveID") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.responseOn;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuidInbound") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuidInbound;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("sedoInMsgUuid") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.sedoInMsgUuid;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("recriveID") <> Неопределено Тогда
		Результат.ИдентификаторОтправки = ДанныеОтвета.recriveID;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("dateTimeReceive") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.dateTimeReceive) Тогда
		Результат.ДатаВремяОбработки = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
			ДанныеОтвета.dateTimeReceive);
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("statusGeneral") <> Неопределено Тогда
		Результат.СтатусОбработки = ДанныеОтвета.statusGeneral;
		Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Результат.СтатусОбработки) Тогда
			Результат.СтатусОбработки = Число(Результат.СтатусОбработки);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("firstErrorList") <> Неопределено
		И ДанныеОтвета.firstErrorList.Свойства().Получить("error") <> Неопределено Тогда
		
		Для каждого УзелОшибка Из ЗначениеВКоллекцию(ДанныеОтвета.firstErrorList.error) Цикл
			ОшибкаОбработки = Новый Структура;
			ОшибкаОбработки.Вставить("КодОшибки", 		"");
			ОшибкаОбработки.Вставить("ОписаниеОшибки", 	"");
			
			Если УзелОшибка.Свойства().Получить("errorCode") <> Неопределено Тогда
				ОшибкаОбработки.КодОшибки = УзелОшибка.errorCode;
			КонецЕсли;
			Если УзелОшибка.Свойства().Получить("errorDescription") <> Неопределено Тогда
				ОшибкаОбработки.ОписаниеОшибки = УзелОшибка.errorDescription;
			КонецЕсли;
			
			Результат.СообщенияОбОшибках = Результат.СообщенияОбОшибках
				+ ?(ЗначениеЗаполнено(Результат.СообщенияОбОшибках), Символы.ВК + Символы.ПС, "")
				+ ?(ЗначениеЗаполнено(ОшибкаОбработки.ОписаниеОшибки),
					СокрЛП(ОшибкаОбработки.ОписаниеОшибки) + ?(ЗначениеЗаполнено(ОшибкаОбработки.КодОшибки),
						" (" + ОшибкаОбработки.КодОшибки + ")", ""),
					?(ЗначениеЗаполнено(ОшибкаОбработки.КодОшибки), ОшибкаОбработки.КодОшибки,
						НСтр("ru = 'Сбой формирования информации об ошибках';
							|en = 'Error report generation failure'")));
			
			Результат.ОшибкиПервичнойОбработки.Добавить(ОшибкаОбработки);
			Если Лев(ОшибкаОбработки.КодОшибки, 4) = "WARN" Тогда
				Результат.ПредупрежденияПервичнойОбработки.Добавить(ОшибкаОбработки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено
		И ДанныеОтвета.protocol.Свойства().Получить("failedList") <> Неопределено
		И ДанныеОтвета.protocol.failedList.Свойства().Получить("failedBatchNoDetail") <> Неопределено Тогда
		
		Для каждого УзелДеталиЗаписи Из ЗначениеВКоллекцию(ДанныеОтвета.protocol.failedList.failedBatchNoDetail) Цикл
			РезультатОбработки = Новый Структура;
			РезультатОбработки.Вставить("НомерЗаписи", 		"");
			РезультатОбработки.Вставить("ОшибкиОбработки", 	Новый Массив);
			
			Если УзелДеталиЗаписи.Свойства().Получить("batchNo") <> Неопределено Тогда
				РезультатОбработки.НомерЗаписи = СокрЛП(УзелДеталиЗаписи.batchNo);
			КонецЕсли;
			
			ЕстьОшибки = Ложь;
			ЕстьПредупреждения = Ложь;
			Если УзелДеталиЗаписи.Свойства().Получить("errorList") <> Неопределено
				И УзелДеталиЗаписи.errorList.Свойства().Получить("error") <> Неопределено Тогда
				
				Для каждого УзелОшибка Из ЗначениеВКоллекцию(УзелДеталиЗаписи.errorList.error) Цикл
					ОшибкаОбработки = Новый Структура;
					ОшибкаОбработки.Вставить("КодОшибки", 		"");
					ОшибкаОбработки.Вставить("ОписаниеОшибки", 	"");
					
					Если УзелОшибка.Свойства().Получить("errorCode") <> Неопределено Тогда
						ОшибкаОбработки.КодОшибки = СокрЛП(УзелОшибка.errorCode);
					КонецЕсли;
					Если Лев(ОшибкаОбработки.КодОшибки, 4) = "WARN" Тогда
						ЕстьПредупреждения = Истина;
					Иначе
						ЕстьОшибки = Истина;
					КонецЕсли;
					
					Если УзелОшибка.Свойства().Получить("errorDescription") <> Неопределено Тогда
						ОшибкаОбработки.ОписаниеОшибки = СокрЛП(УзелОшибка.errorDescription);
					КонецЕсли;
					
					РезультатОбработки.ОшибкиОбработки.Добавить(ОшибкаОбработки);
				КонецЦикла;
			КонецЕсли;
			
			Результат.ПротоколОбработки.Добавить(РезультатОбработки);
			
			Если ЕстьОшибки Тогда
				Результат.НомераНеПринятыхЗаписей.Добавить(РезультатОбработки.НомерЗаписи);
			ИначеЕсли ЕстьПредупреждения Тогда
				Результат.НомераСданныхЗаписей.Добавить(РезультатОбработки.НомерЗаписи);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.СтатусОбработки = 1 И Результат.НомераНеПринятыхЗаписей.Количество() = 0
		ИЛИ ((Результат.СтатусОбработки = 0 ИЛИ Результат.СтатусОбработки = 2)
		И Результат.ОшибкиПервичнойОбработки.Количество() =
		Результат.ПредупрежденияПервичнойОбработки.Количество()) Тогда
		
		Результат.СтатусОбработки = "REGISTERED";
		
	Иначе
		Результат.СтатусОбработки = "ERROR";
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтправкаМашиночитаемойДоверенностиФСС

Функция СтатусОперацииСМЧДФСС(РезультатыОперации)
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаСтатуса", 		Неопределено);
	Результат.Вставить("СтатусОтправки", 	Перечисления.СтатусыОтправки.Отправлен);
	Результат.Вставить("ЦветСтатуса", 		ЦветаСтиля.ЦветНезавершившейсяОтправкиБРО);
	Результат.Вставить("СтатусОтчета", 		"");
	
	Результат.ДатаСтатуса = ТекущаяДатаСеанса();
	
	Если ВРег(РезультатыОперации.СтатусОбработки) = "REGISTERED"
		ИЛИ ВРег(РезультатыОперации.СтатусОбработки) = "VALID" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.Сдан;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветПоложительногоПротокола;
		Результат.СтатусОтчета 		= НСтр("ru = 'Зарегистрировано, ошибок не обнаружено';
												|en = 'Registered, no errors found'");
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "REVOKED" Тогда
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Результат.СтатусОтчета 		= НСтр("ru = 'Отозвано';
												|en = 'Revoked'");
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "ERROR"
		ИЛИ ВРег(РезультатыОперации.СтатусОбработки) = "NOT_REGISTERED" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Результат.СтатусОтчета 		= НСтр("ru = 'Не зарегистрировано, обнаружены ошибки';
												|en = 'Not registered, errors are found'");
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "PROCESSING_ERROR" Тогда
		
		Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
		Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
		Результат.СтатусОтчета 		= НСтр("ru = 'Не зарегистрировано, ошибки обработки';
												|en = 'Not registered, processing errors'");
		
	Иначе
		Результат.СтатусОтчета =
			НСтр("ru = 'Находится в обработке, попробуйте через некоторое время использовать кнопку ""Обновить"" на верхней панели отчета';
				|en = 'Being processed, try to click ""Update"" on the top report bar after some time'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГенерироватьHTMLПротоколаОбработкиМЧДФСС(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации,
		ИдентификаторОтправкиНаСервере = Неопределено,
		СведенияПоОбъекту = Неопределено)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Шаблон = ПолучитьМакет("ФССМЧДШаблонДляHTML");
	
	СекцияШапка = Шаблон.ПолучитьОбласть("Шапка");
	
	НаименованиеПротокола = ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан,
		НСтр("ru = 'Протокол о регистрации';
			|en = 'Registration protocol'"), ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят,
		НСтр("ru = 'Протокол ошибок';
			|en = 'Error log'"), НСтр("ru = 'Промежуточный протокол';
											|en = 'Intermediate protocol'")));
	
	СвойстваОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
		ОрганизацияСсылка,,
		"НаимЮЛПол, ИННЮЛ");
	ПолноеНаименованиеОрганизации 	= СвойстваОрганизации.НаимЮЛПол;
	ИННОрганизации 					= СвойстваОрганизации.ИННЮЛ;
	
	Если СведенияПоОбъекту = Неопределено Тогда
		СведенияПоОбъекту = СведенияПоОтправляемымОбъектам(ОтчетСсылка);
		Если СведенияПоОбъекту = Неопределено Тогда
			НаименованиеОбъекта = НСтр("ru = 'Технологический документ при обмене машиночитаемыми доверенностями (ФСС)';
										|en = 'Technological document when exchanging machine-readable authorization letters (SSF)'");
			СведенияПоОбъекту = Новый Структура;
			СведенияПоОбъекту.Вставить("ПредставлениеКонтролирующегоОргана", 	НСтр("ru = 'ФСС';
																						|en = 'SSF'"));
			СведенияПоОбъекту.Вставить("Наименование", 							НаименованиеОбъекта);
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторОтправки = ?(ЗначениеЗаполнено(ИдентификаторОтправкиНаСервере),
		ИдентификаторОтправкиНаСервере, РезультатыОперации.ИдентификаторОтчета);
	
	ЭтоМашиночитаемаяДоверенностьФСС = (ТипЗнч(ОтчетСсылка) = Тип("СправочникСсылка.МашиночитаемыеДоверенностиФСС"));
	
	Если ВРег(РезультатыОперации.СтатусОбработки) = "REGISTERED"
		ИЛИ ВРег(РезультатыОперации.СтатусОбработки) = "VALID" Тогда
		
		СтатусОбработкиТекстом = ?(ЭтоМашиночитаемаяДоверенностьФСС,
			НСтр("ru = 'Доверенность зарегистрирована';
				|en = 'Authorization letter is registered'"), НСтр("ru = 'Зарегистрировано';
																|en = 'Registered'"));
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "REVOKED" Тогда
		СтатусОбработкиТекстом = ?(ЭтоМашиночитаемаяДоверенностьФСС,
			НСтр("ru = 'Доверенность отозвана';
				|en = 'Authorization letter is revoked'"), НСтр("ru = 'Отозвано';
														|en = 'Revoked'"));
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "ERROR"
		ИЛИ ВРег(РезультатыОперации.СтатусОбработки) = "NOT_REGISTERED" Тогда
		
		СтатусОбработкиТекстом = ?(ЭтоМашиночитаемаяДоверенностьФСС,
			НСтр("ru = 'Обнаружены ошибки, доверенность не зарегистрирована';
				|en = 'Errors are found, authorization letter is not registered'"), НСтр("ru = 'Обнаружены ошибки';
																					|en = 'Errors are found'"));
		
	ИначеЕсли ВРег(РезультатыОперации.СтатусОбработки) = "PROCESSING_ERROR" Тогда
		СтатусОбработкиТекстом = ?(ЭтоМашиночитаемаяДоверенностьФСС,
			НСтр("ru = 'Ошибка обработки, доверенность не зарегистрирована';
				|en = 'Processing error, authorization letter is not registered'"), НСтр("ru = 'Ошибка обработки';
																					|en = 'Processing error'"));
		
	Иначе
		СтатусОбработкиТекстом = РезультатыОперации.СтатусОбработки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РезультатыОперации.ДатаОтчета) И РезультатыОперации.Свойство("ДатаРегистрации")
		И ЗначениеЗаполнено(РезультатыОперации.ДатаРегистрации) Тогда
		
		ТипДаты = НСтр("ru = 'Дата обработки';
						|en = 'Date processed'");
		ДатаОтчета = РезультатыОперации.ДатаРегистрации;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(РезультатыОперации.ДатаОтчета) И РезультатыОперации.Свойство("ДатаПолученияРезультата")
		И ЗначениеЗаполнено(РезультатыОперации.ДатаПолученияРезультата) Тогда
		
		ТипДаты = НСтр("ru = 'Дата получения';
						|en = 'Received on'");
		ДатаОтчета = РезультатыОперации.ДатаПолученияРезультата;
		
	Иначе
		ТипДаты = НСтр("ru = 'Дата отправки';
						|en = 'Date sent'");
		ДатаОтчета = РезультатыОперации.ДатаОтчета;
	КонецЕсли;
	
	ДатаОтчетаСВременем = ЗначениеЗаполнено(ДатаОтчета) И (Час(ДатаОтчета) <> 0 ИЛИ Минута(ДатаОтчета) <> 0
		ИЛИ Секунда(ДатаОтчета) <> 0);
	ДатаОтчетаТекстом = Формат(ДатаОтчета, ?(ДатаОтчетаСВременем, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'", "ДФ='дд.ММ.гггг'"));
	
	СекцияШапка.Параметры.НаименованиеПротокола 			= НаименованиеПротокола;
	СекцияШапка.Параметры.Организация 						= ПолноеНаименованиеОрганизации;
	СекцияШапка.Параметры.ИНН 								= НСтр("ru = 'ИНН';
																	|en = 'TIN'") + " " + ИННОрганизации;
	СекцияШапка.Параметры.Получатель 						= СведенияПоОбъекту.ПредставлениеКонтролирующегоОргана;
	СекцияШапка.Параметры.Отчет 							= СведенияПоОбъекту.Наименование;
	СекцияШапка.Параметры.СтатусОтчета 						= СтатусОперации.СтатусОтчета;
	СекцияШапка.Области.СтатусОтчета.ЦветТекста 			= СтатусОперации.ЦветСтатуса;
	СекцияШапка.Параметры.ИдентификаторИсходногоСообщения 	= ИдентификаторОтправки;
	СекцияШапка.Параметры.СтатусОбработки 					= СтатусОбработкиТекстом;
	СекцияШапка.Параметры.ТипДаты 							= ТипДаты;
	СекцияШапка.Параметры.ДатаОтправки 						= ДатаОтчетаТекстом;
	
	ТабДок.Вывести(СекцияШапка);
	
	Если ЗначениеЗаполнено(РезультатыОперации.СообщениеОбОшибке) Тогда
		СекцияПротоколОшибок = Шаблон.ПолучитьОбласть("ПротоколОшибок");
		СекцияПротоколОшибок.Параметры.СообщениеОбОшибке = РезультатыОперации.СообщениеОбОшибке;
		ТабДок.Вывести(СекцияПротоколОшибок);
		
		Если РезультатыОперации.РезультатыВЦелом.Количество() > 0 Тогда
			СекцияРазделительПротокола = Шаблон.ПолучитьОбласть("РазделительПротокола");
			ТабДок.Вывести(СекцияРазделительПротокола);
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатыОперации.РезультатыВЦелом.Количество() > 0 Тогда
		СекцияРезультатыОбработки = Шаблон.ПолучитьОбласть("РезультатыОбработки");
		ТабДок.Вывести(СекцияРезультатыОбработки);
		
		Для ИндексРезультата = 0 По РезультатыОперации.РезультатыВЦелом.Количество() - 1 Цикл
			РезультатВЦелом = РезультатыОперации.РезультатыВЦелом[ИндексРезультата];
			
			СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.РезультатыВЦелом.Количество() - 1, 2, 1),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
			
			ТипСообщенияТекстом = ?(ВРег(РезультатВЦелом.ТипСообщения) = "WARN"
				ИЛИ ВРег(РезультатВЦелом.ТипСообщения) = "WARNING", НСтр("ru = 'Предупреждение';
																		|en = 'Warning'"),
				?(ВРег(РезультатВЦелом.ТипСообщения) = "ERR" ИЛИ ВРег(РезультатВЦелом.ТипСообщения) = "ERROR",
				НСтр("ru = 'Ошибка';
					|en = 'Error'"), РезультатВЦелом.ТипСообщения));
			
			СекцияСтрокаРезультатов.Параметры.КодСообщения 		= РезультатВЦелом.КодСообщения;
			СекцияСтрокаРезультатов.Параметры.ТипСообщения 		= ТипСообщенияТекстом;
			СекцияСтрокаРезультатов.Параметры.ТекстСообщения 	= РезультатВЦелом.ТекстСообщения;
			СекцияСтрокаРезультатов.Параметры.Рекомендации 		= РезультатВЦелом.Рекомендации;
			
			ТабДок.Вывести(СекцияСтрокаРезультатов);
		КонецЦикла;
	КонецЕсли;
	
	СекцияПодвал = Шаблон.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(СекцияПодвал);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	ТекстHTML = Новый ТекстовыйДокумент;
	ТекстHTML.Прочитать(ИмяВременногоФайла);
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	Возврат ТекстHTML;
	
КонецФункции

Функция РазобратьРезультатСозданияМЧДСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерИсходногоОтчета", 					"");
	Результат.Вставить("НомерОтчетаРУСТ", 						"");
	Результат.Вставить("СтатусОбработки", 		 				"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	// <urn:registerPowerOfAttorneyResult xmlns:urn="urn:ru:fss:integration:types:mchd:v01">
	//    <urn:uuid>string</urn:uuid>
	//    <urn:status>REGISTERED</urn:status>
	//    <!--Optional:-->
	//    <urn:protocol>
	//       <!--Zero or more repetitions:-->
	//       <urn:message>
	//          <urn:mnemonic>NOT_FOUND</urn:mnemonic>
	//          <urn:level>WARN</urn:level>
	//          <!--Optional:-->
	//          <urn:comment>string</urn:comment>
	//          <!--Optional:-->
	//          <urn:recommendation>string</urn:recommendation>
	//       </urn:message>
	//    </urn:protocol>
	// </urn:registerPowerOfAttorneyResult>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("uuid") = Неопределено
			И ДанныеОтвета.Свойства().Получить("status") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.responseOn;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuidInbound") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuidInbound;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("uuid") <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения) Тогда
			Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuid;
		КонецЕсли;
		Результат.НомерИсходногоОтчета = ДанныеОтвета.uuid;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("status") <> Неопределено Тогда
		Результат.СтатусОбработки = ДанныеОтвета.status;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено
		И ДанныеОтвета.protocol.Свойства().Получить("message") <> Неопределено Тогда
		
		Для каждого УзелСообщения Из ЗначениеВКоллекцию(ДанныеОтвета.protocol.message) Цикл
			КодСообщения = ?(УзелСообщения.Свойства().Получить("mnemonic") = Неопределено, "", УзелСообщения.mnemonic);
			ТипСообщения = ?(УзелСообщения.Свойства().Получить("level") = Неопределено, "", УзелСообщения.level);
			ТекстСообщения = ?(УзелСообщения.Свойства().Получить("comment") = Неопределено, "", УзелСообщения.comment);
			Рекомендации = ?(УзелСообщения.Свойства().Получить("recommendation") = Неопределено,
				"", УзелСообщения.recommendation);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	КодСообщения);
			РезультатВЦелом.Вставить("ТипСообщения", 	ТипСообщения);
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	Рекомендации);
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
		КонецЦикла;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьРезультатОтзываМЧДСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь,
		НайтиОтчетИОтправку = Истина,
		Организация = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ", 						"");
	Результат.Вставить("СтатусОтзыва", 		 					"");
	Результат.Вставить("СтатусОбработки", 		 				"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("ДатаРегистрации", 						Неопределено);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	Если НайтиОтчетИОтправку Тогда
		Результат.Вставить("ОтчетСсылка", 						Неопределено);
		Результат.Вставить("ОтправкаСсылка", 					Неопределено);
		Результат.Вставить("ВидОтчета", 						Неопределено);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <urn:revocationPowerOfAttorneyResult xmlns:urn="urn:ru:fss:integration:types:mchd:v01">
	//    <!--Optional:-->
	//    <urn:uuid>string</urn:uuid>
	//    <urn:cancelStatus>string</urn:cancelStatus>
	//    <urn:paStatus>REGISTERED</urn:paStatus>
	//    <!--Optional:-->
	//    <urn:protocol>
	//       <!--Zero or more repetitions:-->
	//       <urn:message>
	//          <urn:mnemonic>string</urn:mnemonic>
	//          <urn:level>WARN</urn:level>
	//          <!--Optional:-->
	//          <urn:comment>string</urn:comment>
	//          <!--Optional:-->
	//          <urn:recommendation>string</urn:recommendation>
	//       </urn:message>
	//    </urn:protocol>
	// </urn:revocationPowerOfAttorneyResult>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("uuid") = Неопределено
			И ДанныеОтвета.Свойства().Получить("paStatus") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("uuid") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuid;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("responseOn") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.responseOn;
	ИначеЕсли ДанныеОтвета.Свойства().Получить("uuidInbound") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuidInbound;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("cancelStatus") <> Неопределено Тогда
		Результат.СтатусОтзыва = ДанныеОтвета.cancelStatus;
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("revocationDate") <> Неопределено
		И ЗначениеЗаполнено(ДанныеОтвета.revocationDate) Тогда
		Результат.ДатаРегистрации = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ДанныеОтвета.revocationDate);
	КонецЕсли;
	Если ДанныеОтвета.Свойства().Получить("paStatus") <> Неопределено Тогда
		Результат.СтатусОбработки = ДанныеОтвета.paStatus;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено
		И ДанныеОтвета.protocol.Свойства().Получить("message") <> Неопределено Тогда
		
		Для каждого УзелСообщения Из ЗначениеВКоллекцию(ДанныеОтвета.protocol.message) Цикл
			КодСообщения = ?(УзелСообщения.Свойства().Получить("mnemonic") = Неопределено, "", УзелСообщения.mnemonic);
			ТипСообщения = ?(УзелСообщения.Свойства().Получить("level") = Неопределено, "", УзелСообщения.level);
			ТекстСообщения = ?(УзелСообщения.Свойства().Получить("comment") = Неопределено, "", УзелСообщения.comment);
			Рекомендации = ?(УзелСообщения.Свойства().Получить("recommendation") = Неопределено,
				"", УзелСообщения.recommendation);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	КодСообщения);
			РезультатВЦелом.Вставить("ТипСообщения", 	ТипСообщения);
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	Рекомендации);
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
		КонецЦикла;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	ОшибкаОтзыва = ВРег(Результат.СтатусОбработки) <> "REVOKED";
	
	Если ОшибкаОтзыва Тогда
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ОтзывМашиночитаемойДоверенностиФСС;
		ДатаСеанса = ТекущаяДатаСеанса();
		ИдентификаторИсходногоСообщения = "ОтзывМЧД_" + ?(ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения),
			Результат.ИдентификаторИсходногоСообщения, нрег(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")));
		ИмяФайлаОтчета = ?(ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения),
			"PR_" + Результат.ИдентификаторИсходногоСообщения + ".xml", "");
		
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("СтатусОтправки", 	Перечисления.СтатусыОтправки.НеПринят);
		НастройкиОтправки.Вставить("ВидОтчета", 		ВидОтчета);
		НастройкиОтправки.Вставить("ДатаОтправки", 		ДатаСеанса);
		НастройкиОтправки.Вставить("Организация", 		Организация);
		
		ДанныеСодержимого = ПолучитьДвоичныеДанныеИзСтроки(СодержимоеОтвета, "utf-8");
		
		Результат.ОтправкаСсылка = ДобавитьОтправкуФСС(
			Ложь,
			ИмяФайлаОтчета,
			ДанныеСодержимого,
			ИдентификаторИсходногоСообщения,
			НастройкиОтправки);
		Если ЗначениеЗаполнено(Результат.ОтправкаСсылка) Тогда
			Результат.ИдентификаторИсходногоСообщения 	= ИдентификаторИсходногоСообщения;
			Результат.ВидОтчета 						= НастройкиОтправки.ВидОтчета;
			Если НЕ ЗначениеЗаполнено(Результат.ДатаРегистрации) Тогда
				Результат.ДатаРегистрации 				= ДатаСеанса;
			КонецЕсли;
			
			СведенияПоОбъекту = Новый Структура;
			СведенияПоОбъекту.Вставить("ПредставлениеКонтролирующегоОргана", 	НСтр("ru = 'ФСС';
																						|en = 'SSF'"));
			СведенияПоОбъекту.Вставить("Наименование", 							НСтр("ru = 'Отзыв машиночитаемой доверенности (ФСС)';
																						|en = 'Machine-readable authorization letter revocation (SSF)'"));
			Результат.Вставить("СведенияПоОбъекту", СведенияПоОбъекту);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения) И НайтиОтчетИОтправку Тогда
		ЗапросОтправок = Новый Запрос;
		ЗапросОтправок.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ОтправкиФСС.Ссылка КАК Ссылка,
			|	ОтправкиФСС.ИдентификаторОтправкиНаСервере КАК ИдентификаторОтправкиНаСервере,
			|	ОтправкиФСС.ВидОтчета КАК ВидОтчета,
			|	МашиночитаемыеДоверенностиФСС.Ссылка КАК ОтчетСсылка
			|ИЗ
			|	Справочник.ОтправкиФСС КАК ОтправкиФСС
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МашиночитаемыеДоверенностиФСС КАК МашиночитаемыеДоверенностиФСС
			|		ПО МашиночитаемыеДоверенностиФСС.Ссылка = ОтправкиФСС.ОтчетСсылка
			|ГДЕ
			|	МашиночитаемыеДоверенностиФСС.Организация = &Организация
			|	И МашиночитаемыеДоверенностиФСС.НомерДоверенности = &НомерДоверенности
			|	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОтправкиФСС.ДатаОтправки УБЫВ,
			|	МашиночитаемыеДоверенностиФСС.ПометкаУдаления";
		ЗапросОтправок.Параметры.Вставить("Организация", 		Организация);
		ЗапросОтправок.Параметры.Вставить("НомерДоверенности", 	Результат.ИдентификаторИсходногоСообщения);
		
		Выборка = ЗапросОтправок.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.ОтчетСсылка 						= Выборка.ОтчетСсылка;
			Результат.ОтправкаСсылка 					= Выборка.Ссылка;
			Результат.ВидОтчета 						= Выборка.ВидОтчета;
			Результат.ИдентификаторИсходногоСообщения 	= Выборка.ИдентификаторОтправкиНаСервере;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьМашиночитаемуюДоверенностьСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь,
		Организация = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ", 						"");
	Результат.Вставить("СтатусОбработки", 		 				"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("ДанныеСодержимого", 					Неопределено);
	Результат.Вставить("ДатаРегистрации", 						Неопределено);
	Результат.Вставить("ПричинаОтзыва", 						"");
	Результат.Вставить("ДатаОтзыва", 							Неопределено);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Результат.Вставить("ОтправкаСсылка", 						Неопределено);
	Результат.Вставить("ОтчетСсылка", 							Неопределено);
	Результат.Вставить("ВидОтчета", 							Неопределено);
	Результат.Вставить("ДатаОтчета", 							Неопределено);
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <urn:powerOfAttorneyResponse xmlns:urn="urn:ru:fss:integration:types:mchd:v01">
	//    <!--Optional:-->
	//    <urn:powerOfAttorneyInfo>
	//       <urn:content>string</urn:content>
	//       <urn:status>REGISTERED</urn:status>
	//       <urn:issued>2007-10-26T10:36:28</urn:issued>
	//       <!--Optional:-->
	//       <urn:revocationReason>string</urn:revocationReason>
	//       <!--Optional:-->
	//       <urn:revocationDate>2004-02-14T21:44:14</urn:revocationDate>
	//    </urn:powerOfAttorneyInfo>
	//    <!--Optional:-->
	//    <urn:protocol>
	//       <!--Zero or more repetitions:-->
	//       <urn:message>
	//          <urn:mnemonic>string</urn:mnemonic>
	//          <urn:level>WARN</urn:level>
	//          <!--Optional:-->
	//          <urn:comment>string</urn:comment>
	//          <!--Optional:-->
	//          <urn:recommendation>string</urn:recommendation>
	//       </urn:message>
	//    </urn:protocol>
	// </urn:powerOfAttorneyResponse>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.ВладеющееСвойство().Имя <> "urn:powerOfAttorneyResponse");
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("powerOfAttorneyInfo") <> Неопределено Тогда
		УзелИнформацииМЧД = ДанныеОтвета.powerOfAttorneyInfo;
		
		Если УзелИнформацииМЧД.Свойства().Получить("content") <> Неопределено
			И ЗначениеЗаполнено(УзелИнформацииМЧД.content) Тогда
			Результат.ДанныеСодержимого = Base64Значение(УзелИнформацииМЧД.content);
		КонецЕсли;
		Если УзелИнформацииМЧД.Свойства().Получить("status") <> Неопределено Тогда
			Результат.СтатусОбработки = УзелИнформацииМЧД.status;
		КонецЕсли;
		Если УзелИнформацииМЧД.Свойства().Получить("issued") <> Неопределено
			И ЗначениеЗаполнено(УзелИнформацииМЧД.issued) Тогда
			Результат.ДатаРегистрации = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелИнформацииМЧД.issued);
		КонецЕсли;
		Если УзелИнформацииМЧД.Свойства().Получить("revocationReason") <> Неопределено Тогда
			Результат.ПричинаОтзыва = УзелИнформацииМЧД.revocationReason;
		КонецЕсли;
		Если УзелИнформацииМЧД.Свойства().Получить("revocationDate") <> Неопределено
			И ЗначениеЗаполнено(УзелИнформацииМЧД.revocationDate) Тогда
			Результат.ДатаОтзыва = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(УзелИнформацииМЧД.revocationDate);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено
		И ДанныеОтвета.protocol.Свойства().Получить("message") <> Неопределено Тогда
		
		Для каждого УзелСообщения Из ЗначениеВКоллекцию(ДанныеОтвета.protocol.message) Цикл
			КодСообщения = ?(УзелСообщения.Свойства().Получить("mnemonic") = Неопределено, "", УзелСообщения.mnemonic);
			ТипСообщения = ?(УзелСообщения.Свойства().Получить("level") = Неопределено, "", УзелСообщения.level);
			ТекстСообщения = ?(УзелСообщения.Свойства().Получить("comment") = Неопределено, "", УзелСообщения.comment);
			Рекомендации = ?(УзелСообщения.Свойства().Получить("recommendation") = Неопределено,
				"", УзелСообщения.recommendation);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	КодСообщения);
			РезультатВЦелом.Вставить("ТипСообщения", 	ТипСообщения);
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	Рекомендации);
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.ДанныеСодержимого) Тогда
		РезультатЗагрузки = Справочники.МашиночитаемыеДоверенностиФСС.ЗагрузитьЭлементИзФайлаОбмена(
			Результат.ДанныеСодержимого, "ЗапрещеноОбновлятьСуществующий",, Организация);
		
		Если РезультатЗагрузки.Выполнено И РезультатЗагрузки.Ошибка <> "ЗапрещеноОбновлятьСуществующий" Тогда
			Результат.ОтчетСсылка 						= РезультатЗагрузки.Ссылка;
			Результат.ИдентификаторИсходногоСообщения 	= РезультатЗагрузки.НомерДоверенности;
			
		Иначе
			ТекстСообщения = ?(РезультатЗагрузки.Ошибка = "ЗапрещеноОбновлятьСуществующий",
				НСтр("ru = 'Машиночитаемая доверенность (СФР) уже присутствует в базе';
					|en = 'Machine-readable authorization letter (Social Insurance Fund) is already in the infobase'"), Результат.Ошибка);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	"");
			РезультатВЦелом.Вставить("ТипСообщения", 	"");
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	"");
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
			
			Результат.СтатусОбработки = "ERROR";
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Результат.СтатусОбработки) Тогда
		Результат.СтатусОбработки = "ERROR";
	КонецЕсли;
	
	ВидОтчета = ?(ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения),
		Справочники.ВидыОтправляемыхДокументов.МашиночитаемыеДоверенностиФСС,
		Справочники.ВидыОтправляемыхДокументов.ЗапросМашиночитаемойДоверенностиФСС);
	ДатаСеанса = ТекущаяДатаСеанса();
	ДатаОтчета = ?(ЗначениеЗаполнено(Результат.ДатаРегистрации) И Результат.ДатаРегистрации <= ДатаСеанса,
		Результат.ДатаРегистрации, ДатаСеанса);
	ИдентификаторИсходногоСообщения = ?(ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения),
		Результат.ИдентификаторИсходногоСообщения,
		"ЗапросМЧД_" + нрег(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")));
	ИмяФайлаОтчета = ?(ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения),
		"P_" + Результат.ИдентификаторИсходногоСообщения + ".xml", "");
	
	НастройкиОтправки = Новый Структура;
	Если ЗначениеЗаполнено(Результат.ОтчетСсылка) Тогда
		НастройкиОтправки.Вставить("ОтчетСсылка", 	Результат.ОтчетСсылка);
	КонецЕсли;
	НастройкиОтправки.Вставить("СтатусОтправки", 	Перечисления.СтатусыОтправки.Отправлен);
	НастройкиОтправки.Вставить("ВидОтчета", 		ВидОтчета);
	НастройкиОтправки.Вставить("ДатаОтправки", 		ДатаСеанса);
	НастройкиОтправки.Вставить("Организация", 		Организация);
	
	Результат.ОтправкаСсылка = ДобавитьОтправкуФСС(
		Ложь,
		ИмяФайлаОтчета,
		Результат.ДанныеСодержимого,
		ИдентификаторИсходногоСообщения,
		НастройкиОтправки);
	Если ЗначениеЗаполнено(Результат.ОтправкаСсылка) Тогда
		Результат.ИдентификаторИсходногоСообщения 	= ИдентификаторИсходногоСообщения;
		Результат.ВидОтчета 						= НастройкиОтправки.ВидОтчета;
		Результат.ДатаОтчета 						= ДатаОтчета;
		Если НЕ ЗначениеЗаполнено(Результат.ОтчетСсылка) Тогда
			СведенияПоОбъекту = Новый Структура;
			СведенияПоОбъекту.Вставить("ПредставлениеКонтролирующегоОргана", 	НСтр("ru = 'ФСС';
																						|en = 'SSF'"));
			СведенияПоОбъекту.Вставить("Наименование", 							НСтр("ru = 'Запрос машиночитаемой доверенности (ФСС)';
																						|en = 'Machine-readable authorization letter request (SSF)'"));
			Результат.Вставить("СведенияПоОбъекту", СведенияПоОбъекту);
		КонецЕсли;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьСправочникПолномочийМашиночитаемыхДоверенностейСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь,
		Организация = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("НомерОтчетаРУСТ", 						"");
	Результат.Вставить("СтатусОбработки", 		 				"");
	Результат.Вставить("КомментарийКСтатусуОбработкиОтчета", 	"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("Полномочия", 							Новый Массив);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Результат.Вставить("ОтправкаСсылка", 						Неопределено);
	Результат.Вставить("ОтчетСсылка", 							Неопределено);
	Результат.Вставить("ВидОтчета", 							Неопределено);
	Результат.Вставить("ДатаОтчета", 							Неопределено);
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 		Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <urn:dicAuthorityListResponse xmlns:urn="urn:ru:fss:integration:types:mchd:v01">
	//    <urn:authorities>
	//    <!--Zero or more repetitions:-->
	//       <urn:authority>
	//          <urn:mnemonic>string</urn:mnemonic>
	//          <urn:name>string</urn:name>
	//          <urn:parentMnemonic>string</urn:parentMnemonic>
	//          <urn:dateStart>2008-09-29</urn:dateStart>
	//          <urn:dateEnd>2014-09-19</urn:dateEnd>
	//       </urn:authority>
	//    </urn:authorities>
	//    <!--Optional:-->
	//    <urn:protocol>
	//       <!--Zero or more repetitions:-->
	//       <urn:message>
	//          <urn:mnemonic>string</urn:mnemonic>
	//          <urn:level>ERROR</urn:level>
	//          <!--Optional:-->
	//          <urn:comment>string</urn:comment>
	//          <!--Optional:-->
	//          <urn:recommendation>string</urn:recommendation>
	//       </urn:message>
	//    </urn:protocol>
	// </urn:dicAuthorityListResponse>
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.ВладеющееСвойство().Имя <> "urn:dicAuthorityListResponse");
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Если ДанныеОтвета.Свойства().Получить("authorities") <> Неопределено Тогда
		УзелСправочникПолномочий = ДанныеОтвета.authorities;
		
		Если УзелСправочникПолномочий.Свойства().Получить("authority") <> Неопределено Тогда
			УзлыПолномочий = ПоместитьВКоллекциюПриНеобходимости(УзелСправочникПолномочий.authority);
			Для каждого УзелПолномочия Из УзлыПолномочий Цикл
				Результат.СтатусОбработки = "REGISTERED";
				
				ПолномочиеПредставителя = Новый Структура;
				ПолномочиеПредставителя.Вставить("Код", 			"");
				ПолномочиеПредставителя.Вставить("Наименование", 	"");
				ПолномочиеПредставителя.Вставить("КодРодителя", 	"");
				ПолномочиеПредставителя.Вставить("ДатаНачала", 		Неопределено);
				ПолномочиеПредставителя.Вставить("ДатаОкончания", 	Неопределено);
				ПолномочиеПредставителя.Вставить("Ссылка", 			Неопределено);
				
				Если УзелПолномочия.Свойства().Получить("mnemonic") <> Неопределено Тогда
					ПолномочиеПредставителя.Код = УзелПолномочия.mnemonic;
				КонецЕсли;
				Если УзелПолномочия.Свойства().Получить("name") <> Неопределено Тогда
					ПолномочиеПредставителя.Наименование = УзелПолномочия.name;
				КонецЕсли;
				Если УзелПолномочия.Свойства().Получить("parentMnemonic") <> Неопределено Тогда
					ПолномочиеПредставителя.КодРодителя = УзелПолномочия.parentMnemonic;
					Если ПолномочиеПредставителя.КодРодителя = ПолномочиеПредставителя.Код Тогда
						ПолномочиеПредставителя.КодРодителя = "";
					КонецЕсли;
				КонецЕсли;
				Если УзелПолномочия.Свойства().Получить("dateStart") <> Неопределено
					И ЗначениеЗаполнено(УзелПолномочия.dateStart) Тогда
					ПолномочиеПредставителя.ДатаНачала = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
						УзелПолномочия.dateStart);
				КонецЕсли;
				Если УзелПолномочия.Свойства().Получить("dateEnd") <> Неопределено
					И ЗначениеЗаполнено(УзелПолномочия.dateEnd) Тогда
					ПолномочиеПредставителя.ДатаОкончания = ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
						УзелПолномочия.dateEnd);
					Если ПолномочиеПредставителя.ДатаОкончания = '20991231'
						И ПолномочиеПредставителя.ДатаОкончания > ДатаСеанса + 20 * 365 * 24 * 60 * 60
						ИЛИ ПолномочиеПредставителя.ДатаОкончания > ДатаСеанса + 100 * 365 * 24 * 60 * 60 Тогда
						ПолномочиеПредставителя.ДатаОкончания = Неопределено;
					КонецЕсли;
				КонецЕсли;
				
				Результат.Полномочия.Добавить(ПолномочиеПредставителя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат.СтатусОбработки) Тогда
		Результат.СтатусОбработки = "ERROR";
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("protocol") <> Неопределено
		И ДанныеОтвета.protocol.Свойства().Получить("message") <> Неопределено Тогда
		
		Для каждого УзелСообщения Из ЗначениеВКоллекцию(ДанныеОтвета.protocol.message) Цикл
			КодСообщения = ?(УзелСообщения.Свойства().Получить("mnemonic") = Неопределено, "", УзелСообщения.mnemonic);
			ТипСообщения = ?(УзелСообщения.Свойства().Получить("level") = Неопределено, "", УзелСообщения.level);
			ТекстСообщения = ?(УзелСообщения.Свойства().Получить("comment") = Неопределено, "", УзелСообщения.comment);
			Рекомендации = ?(УзелСообщения.Свойства().Получить("recommendation") = Неопределено,
				"", УзелСообщения.recommendation);
			
			РезультатВЦелом = Новый Структура;
			РезультатВЦелом.Вставить("КодСообщения", 	КодСообщения);
			РезультатВЦелом.Вставить("ТипСообщения", 	ТипСообщения);
			РезультатВЦелом.Вставить("ТекстСообщения", 	ТекстСообщения);
			РезультатВЦелом.Вставить("Рекомендации", 	Рекомендации);
			Результат.РезультатыВЦелом.Добавить(РезультатВЦелом);
		КонецЦикла;
	КонецЕсли;
	
	ОбновлениеПолномочийПредставителяФСС(Результат.Полномочия, Организация);
	
	// добавление отправки
	
	Если НЕ ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения) Тогда
		ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ЗапросСправочникаПолномочийМашиночитаемойДоверенностиФСС;
		ДатаОтчета = ?(ЗначениеЗаполнено(Результат.ДатаОтчета) И Результат.ДатаОтчета <= ДатаСеанса,
			Результат.ДатаОтчета, ДатаСеанса);
		ИдентификаторИсходногоСообщения = "ЗапросПолномочийМЧД_"
			+ нрег(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
		
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("СтатусОтправки", 			Перечисления.СтатусыОтправки.Отправлен);
		НастройкиОтправки.Вставить("ВидОтчета", 				ВидОтчета);
		НастройкиОтправки.Вставить("ДатаОтправки", 				ДатаСеанса);
		НастройкиОтправки.Вставить("ДатаПолученияРезультата", 	ДатаСеанса);
		НастройкиОтправки.Вставить("Организация", 				Организация);
		
		ДанныеСодержимого = ПолучитьДвоичныеДанныеИзСтроки(СодержимоеОтвета, "utf-8");
		
		// протокол будет добавлен и изменено состояние по результатам анализа отправки
		Результат.ОтправкаСсылка = ДобавитьОтправкуФСС(
			Ложь,
			"",
			ДанныеСодержимого,
			ИдентификаторИсходногоСообщения,
			НастройкиОтправки);
		Если ЗначениеЗаполнено(Результат.ОтправкаСсылка) Тогда
			Результат.ИдентификаторИсходногоСообщения 	= ИдентификаторИсходногоСообщения;
			Результат.ВидОтчета 						= НастройкиОтправки.ВидОтчета;
			Результат.ДатаОтчета 						= ДатаОтчета;
			Если НЕ ЗначениеЗаполнено(Результат.ОтчетСсылка) Тогда
				НаименованиеОбъекта = НСтр("ru = 'Запрос справочника полномочий машиночитаемой доверенности (ФСС)';
											|en = 'Request of a catalog of powers of a machine-readable authorization letter (SSF)'");
				СведенияПоОбъекту = Новый Структура;
				СведенияПоОбъекту.Вставить("ПредставлениеКонтролирующегоОргана", 	НСтр("ru = 'ФСС';
																							|en = 'SSF'"));
				СведенияПоОбъекту.Вставить("Наименование", 							НаименованиеОбъекта);
				Результат.Вставить("СведенияПоОбъекту", СведенияПоОбъекту);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновлениеПолномочийПредставителяФСС(Полномочия, ОрганизацияДляСохраненияДатыОбновления = Неопределено)
	
	ЗапросПолномочий = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПолномочияПредставителяФСС.Ссылка КАК Ссылка,
		|	ПолномочияПредставителяФСС.Код КАК Код,
		|	ПолномочияПредставителяФСС.Наименование КАК Наименование,
		|	ПолномочияПредставителяФСС.ДатаНачала КАК ДатаНачала,
		|	ПолномочияПредставителяФСС.ДатаОкончания КАК ДатаОкончания,
		|	ПолномочияПредставителяФСС.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ПолномочияПредставителяФСС КАК ПолномочияПредставителяФСС
		|УПОРЯДОЧИТЬ ПО
		|	ПолномочияПредставителяФСС.Ссылка ИЕРАРХИЯ");
	
	ДеревоПолномочий = ЗапросПолномочий.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ДеревоПолномочий.Колонки.Добавить("ПолномочиеПредставителяСуществует");
	ДеревоПолномочий.Колонки.Добавить("ИзмененноеПолномочиеПредставителя");
	
	ДобавляемыеПолномочия = Новый Массив;
	КодыДобавляемыхПолномочий = Новый Массив;
	ИзменяемыеПолномочия = Новый Массив;
	Для каждого ПолномочиеПредставителя Из Полномочия Цикл
		СтрокаПолномочий = ДеревоПолномочий.Строки.Найти(ПолномочиеПредставителя.Код, "Код", Истина);
		Если СтрокаПолномочий = Неопределено Тогда
			ДобавляемыеПолномочия.Добавить(ПолномочиеПредставителя);
			КодыДобавляемыхПолномочий.Добавить(ПолномочиеПредставителя.Код);
			
		Иначе
			СтрокаПолномочий.ПолномочиеПредставителяСуществует = Истина;
			
			Если СтрокаПолномочий.Код <> ПолномочиеПредставителя.Код
				ИЛИ СтрокаПолномочий.Наименование <> ПолномочиеПредставителя.Наименование
				ИЛИ ?(СтрокаПолномочий.Родитель = Неопределено, "", СтрокаПолномочий.Родитель.Код) <>
				ПолномочиеПредставителя.КодРодителя
				ИЛИ СтрокаПолномочий.ДатаНачала <> ПолномочиеПредставителя.ДатаНачала
				ИЛИ СтрокаПолномочий.ДатаОкончания <> ПолномочиеПредставителя.ДатаОкончания
				ИЛИ СтрокаПолномочий.ПометкаУдаления Тогда
				
				СтрокаПолномочий.ИзмененноеПолномочиеПредставителя = ПолномочиеПредставителя;
				ИзменяемыеПолномочия.Добавить(СтрокаПолномочий);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОтборПомечаемыхНаУдалениеПолномочий = Новый Структура("ПолномочиеПредставителяСуществует, ПометкаУдаления",
		Неопределено, Ложь);
	ПомечаемыеНаУдалениеПолномочия = ДеревоПолномочий.Строки.НайтиСтроки(ОтборПомечаемыхНаУдалениеПолномочий, Истина);
	
	Если ДобавляемыеПолномочия.Количество() > 0 ИЛИ ИзменяемыеПолномочия.Количество() > 0
		ИЛИ ПомечаемыеНаУдалениеПолномочия.Количество() > 0 Тогда
		
		НачатьТранзакцию();
		
		Для каждого СтрокаПолномочий Из ПомечаемыеНаУдалениеПолномочия Цикл
			ОбъектПолномочия = СтрокаПолномочий.Ссылка.ПолучитьОбъект();
			ОбъектПолномочия.УстановитьПометкуУдаления(Истина, Ложь);
			ОбъектПолномочия.Записать();
		КонецЦикла;
		
		КоличествоВсехДобавленных = 0;
		ДобавитьБезРодителя = Ложь;
		Пока Истина Цикл
			КоличествоДобавленных = 0;
			Для каждого ПолномочиеПредставителя Из ДобавляемыеПолномочия Цикл
				Если ЗначениеЗаполнено(ПолномочиеПредставителя.Ссылка) Тогда
					Продолжить;
				КонецЕсли;
				
				СсылкаНаРодителя = Неопределено;
				Если ЗначениеЗаполнено(ПолномочиеПредставителя.КодРодителя) Тогда
					СтрокаРодительскогоПолномочия = ДеревоПолномочий.Строки.Найти(ПолномочиеПредставителя.КодРодителя, "Код", Истина);
					Если СтрокаРодительскогоПолномочия = Неопределено Тогда
						ИндексРодительскогоПолномочия = КодыДобавляемыхПолномочий.Найти(ПолномочиеПредставителя.КодРодителя);
						Если ИндексРодительскогоПолномочия = Неопределено Тогда
							ПолномочиеПредставителя.КодРодителя = "";
						Иначе
							СсылкаНаРодителя = ДобавляемыеПолномочия[ИндексРодительскогоПолномочия].Ссылка;
						КонецЕсли;
					Иначе
						СсылкаНаРодителя = СтрокаРодительскогоПолномочия.Ссылка;
					КонецЕсли;
					Если ДобавитьБезРодителя И НЕ ЗначениеЗаполнено(СсылкаНаРодителя) Тогда
						ПолномочиеПредставителя.КодРодителя = "";
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ПолномочиеПредставителя.КодРодителя) ИЛИ ЗначениеЗаполнено(СсылкаНаРодителя) Тогда
					НовыйОбъектПолномочия = Справочники.ПолномочияПредставителяФСС.СоздатьЭлемент();
					ПолномочиеПредставителя.Ссылка = Справочники.ПолномочияПредставителяФСС.ПолучитьСсылку();
					НовыйОбъектПолномочия.УстановитьСсылкуНового(ПолномочиеПредставителя.Ссылка);
					НовыйОбъектПолномочия.Код 			= ПолномочиеПредставителя.Код;
					НовыйОбъектПолномочия.Наименование 	= ПолномочиеПредставителя.Наименование;
					НовыйОбъектПолномочия.Родитель 		= СсылкаНаРодителя;
					НовыйОбъектПолномочия.ДатаНачала 	= ПолномочиеПредставителя.ДатаНачала;
					НовыйОбъектПолномочия.ДатаОкончания = ПолномочиеПредставителя.ДатаОкончания;
					НовыйОбъектПолномочия.Записать();
					КоличествоДобавленных = КоличествоДобавленных + 1;
				КонецЕсли;
			КонецЦикла;
			
			КоличествоВсехДобавленных = КоличествоВсехДобавленных + КоличествоДобавленных;
			Если КоличествоВсехДобавленных < ДобавляемыеПолномочия.Количество() Тогда
				Если КоличествоДобавленных = 0 Тогда
					Если ДобавитьБезРодителя Тогда
						Прервать;
					Иначе
						ДобавитьБезРодителя = Истина; // остались только перекрестные ссылки
					КонецЕсли;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаПолномочий Из ИзменяемыеПолномочия Цикл
			ПолномочиеПредставителя = СтрокаПолномочий.ИзмененноеПолномочиеПредставителя;
			
			СсылкаНаРодителя = Неопределено;
			Если ЗначениеЗаполнено(ПолномочиеПредставителя.КодРодителя) Тогда
				КодРодителя = ПолномочиеПредставителя.КодРодителя;
				ЭтоПервыйПоиск = Истина;
				Пока Истина Цикл
					СтрокаРодительскогоПолномочия = ДеревоПолномочий.Строки.Найти(КодРодителя, "Код", Истина);
					
					Если СтрокаРодительскогоПолномочия = Неопределено Тогда
						ИндексРодительскогоПолномочия = КодыДобавляемыхПолномочий.Найти(КодРодителя);
						Если ИндексРодительскогоПолномочия = Неопределено Тогда
							Если ЭтоПервыйПоиск Тогда
								ПолномочиеПредставителя.КодРодителя = "";
								КодРодителя = "";
							КонецЕсли;
						Иначе
							Если ЭтоПервыйПоиск Тогда
								СсылкаНаРодителя = ДобавляемыеПолномочия[ИндексРодительскогоПолномочия].Ссылка;
							КонецЕсли;
							КодРодителя = ДобавляемыеПолномочия[ИндексРодительскогоПолномочия].КодРодителя;
						КонецЕсли;
					Иначе
						Если ЭтоПервыйПоиск Тогда
							СсылкаНаРодителя = СтрокаРодительскогоПолномочия.Ссылка;
						КонецЕсли;
						КодРодителя = ?(ЗначениеЗаполнено(СтрокаРодительскогоПолномочия.Родитель),
							СтрокаРодительскогоПолномочия.Родитель.Код, "");
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(КодРодителя) Тогда
						Прервать;
					ИначеЕсли КодРодителя = ПолномочиеПредставителя.Код Тогда
						ПолномочиеПредставителя.КодРодителя = ""; // перекрестная ссылка
						Прервать;
					КонецЕсли;
					
					ЭтоПервыйПоиск = Ложь;
				КонецЦикла;
			КонецЕсли;
			
			ОбъектПолномочия = СтрокаПолномочий.Ссылка.ПолучитьОбъект();
			ОбъектПолномочия.УстановитьПометкуУдаления(Ложь, Ложь);
			ОбъектПолномочия.Код 			= ПолномочиеПредставителя.Код;
			ОбъектПолномочия.Наименование 	= ПолномочиеПредставителя.Наименование;
			ОбъектПолномочия.Родитель 		= СсылкаНаРодителя;
			ОбъектПолномочия.ДатаНачала 	= ?(ЗначениеЗаполнено(ПолномочиеПредставителя.ДатаНачала),
											  ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
											  ПолномочиеПредставителя.ДатаНачала), Неопределено);
			ОбъектПолномочия.ДатаОкончания 	= ?(ЗначениеЗаполнено(ПолномочиеПредставителя.ДатаОкончания),
											  ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(
											  ПолномочиеПредставителя.ДатаОкончания), Неопределено);
			
			ОбъектПолномочия.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
		Если ЗначениеЗаполнено(ОрганизацияДляСохраненияДатыОбновления) Тогда
			ДатаСеанса = ТекущаяДатаСеанса();
			ИзмененияПолномочийПредставителяФСС = ХранилищеОбщихНастроек.Загрузить(
				"ДокументооборотСКонтролирующимиОрганами_ИзмененияПолномочийПредставителяФСС");
			Если ИзмененияПолномочийПредставителяФСС = Неопределено Тогда
				ИзмененияПолномочийПредставителяФСС = Новый Соответствие;
			КонецЕсли;
			ИзмененияПолномочийПредставителяФСС[ОрганизацияДляСохраненияДатыОбновления] =
				Новый Структура("ДатаИзменения", ДатаСеанса);
			ХранилищеОбщихНастроек.Сохранить("ДокументооборотСКонтролирующимиОрганами_ИзмененияПолномочийПредставителяФСС",,
				ИзмененияПолномочийПредставителяФСС);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НачальноеЗаполнениеПолномочийПредставителяФСС(ТолькоПолучитьЭлементСИндексом = Неопределено) Экспорт
	
	Если ТолькоПолучитьЭлементСИндексом = Неопределено ИЛИ ТолькоПолучитьЭлементСИндексом = 0 Тогда
		ЗапросПолномочий = Новый Запрос;
		ЗапросПолномочий.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ПолномочияПредставителяФСС.Код КАК Код,
			|	ПолномочияПредставителяФСС.Наименование КАК Наименование,
			|	ПолномочияПредставителяФСС.ДатаНачала КАК ДатаНачала,
			|	ПолномочияПредставителяФСС.ДатаОкончания КАК ДатаОкончания
			|ИЗ
			|	Справочник.ПолномочияПредставителяФСС КАК ПолномочияПредставителяФСС
			|ГДЕ
			|	НЕ ПолномочияПредставителяФСС.ПометкаУдаления" + ?(ТолькоПолучитьЭлементСИндексом = Неопределено, "
			|	И ПолномочияПредставителяФСС.Код = ""FSS_000120""", "") + ?(ТолькоПолучитьЭлементСИндексом = 0, "
			|	И Родитель = ЗНАЧЕНИЕ(Справочник.ПолномочияПредставителяФСС.ПустаяСсылка)
			|УПОРЯДОЧИТЬ ПО
			|	Код", "");
		
		Выборка = ЗапросПолномочий.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ТолькоПолучитьЭлементСИндексом = Неопределено Тогда
				Возврат Ложь;
				
			Иначе
				КодПолномочия 			= СокрЛП(Выборка.Код);
				НаименованиеПолномочия 	= СокрЛП(Выборка.Наименование);
				
				ПолномочиеПредставителя = Новый Структура;
				ПолномочиеПредставителя.Вставить("Код", 			КодПолномочия);
				ПолномочиеПредставителя.Вставить("КодРодителя", 	"");
				ПолномочиеПредставителя.Вставить("Наименование", 	НаименованиеПолномочия);
				ПолномочиеПредставителя.Вставить("ДатаНачала", 		Выборка.ДатаНачала);
				ПолномочиеПредставителя.Вставить("ДатаОкончания", 	Выборка.ДатаОкончания);
				Возврат ПолномочиеПредставителя;
			КонецЕсли
		КонецЕсли;
		
		Если ТолькоПолучитьЭлементСИндексом = Неопределено Тогда
			СсылкиНаПолномочия = Новый Соответствие;
		КонецЕсли;
	КонецЕсли;
	
	МакетСписокДокументов = Справочники.МашиночитаемыеДоверенностиФСС.ПолучитьМакет("ОписаниеПолномочийПредставителя");
	ГруппаПолномочий = МакетСписокДокументов.Области.ГруппаПолномочий;
	
	ИндексСтроки = ГруппаПолномочий.Верх;
	
	Если ТолькоПолучитьЭлементСИндексом = Неопределено Тогда
		Полномочия = Новый Массив;
	Иначе
		ИндексСтроки = ИндексСтроки + ТолькоПолучитьЭлементСИндексом;
	КонецЕсли;
	
	Пока ИндексСтроки <= ГруппаПолномочий.Низ Цикл
		КодПолномочия 				= МакетСписокДокументов.Область(ИндексСтроки, 1).Текст;
		КодРодительскогоПолномочия 	= МакетСписокДокументов.Область(ИндексСтроки, 2).Текст;
		НаименованиеПолномочия 		= МакетСписокДокументов.Область(ИндексСтроки, 3).Текст;
		ДатаНачала 					= МакетСписокДокументов.Область(ИндексСтроки, 4).Текст;
		ДатаОкончания 				= МакетСписокДокументов.Область(ИндексСтроки, 5).Текст;
		
		КодПолномочия = СокрЛП(КодПолномочия);
		КодРодительскогоПолномочия = СокрЛП(КодРодительскогоПолномочия);
		НаименованиеПолномочия = СокрЛП(НаименованиеПолномочия);
		ДатаНачала = ?(ЗначениеЗаполнено(ДатаНачала),
			ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ДатаНачала), Неопределено);
		ДатаОкончания = ?(ЗначениеЗаполнено(ДатаОкончания),
			ДокументооборотСКОВызовСервера.ДатаИзСтрокиРазныхФорматов(ДатаОкончания), Неопределено);
		
		ПолномочиеПредставителя = Новый Структура;
		ПолномочиеПредставителя.Вставить("Код", 			КодПолномочия);
		ПолномочиеПредставителя.Вставить("КодРодителя", 	КодРодительскогоПолномочия);
		ПолномочиеПредставителя.Вставить("Наименование", 	НаименованиеПолномочия);
		ПолномочиеПредставителя.Вставить("ДатаНачала", 		ДатаНачала);
		ПолномочиеПредставителя.Вставить("ДатаОкончания", 	ДатаОкончания);
		ПолномочиеПредставителя.Вставить("Ссылка", 			Неопределено);
		
		Если ТолькоПолучитьЭлементСИндексом = Неопределено Тогда
			Полномочия.Добавить(ПолномочиеПредставителя);
			ИндексСтроки = ИндексСтроки + 1;
			
		Иначе
			Возврат ПолномочиеПредставителя;
		КонецЕсли;
	КонецЦикла;
	
	Если ТолькоПолучитьЭлементСИндексом = Неопределено Тогда
		ОбновлениеПолномочийПредставителяФСС(Полномочия);
		
		Возврат Истина;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ИнформацияПоОтправкеФСС(ОтправкаСсылка, ИспользоватьКеширование = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторОтправкиНаСервере", 		Неопределено);
	Результат.Вставить("ОтчетСсылка", 							Неопределено);
	Результат.Вставить("ОрганизацияСсылка", 					Неопределено);
	Результат.Вставить("ВидОтчета", 							Неопределено);
	Результат.Вставить("ТипДокумента", 							Неопределено);
	Результат.Вставить("ОтправкаЧерезСЭДО", 					Ложь);
	Результат.Вставить("ТипВзаимодействия", 					Неопределено);
	МестоХраненияКлюча = Неопределено;
	
	РеквизитыОтправки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтправкаСсылка,
		"ОтчетСсылка, ИдентификаторОтправкиНаСервере, Организация, ВидОтчета, ИмяФайлаПакета, ПодписанныйПакет");
	Результат.ОтчетСсылка 						= РеквизитыОтправки.ОтчетСсылка;
	Результат.ИдентификаторОтправкиНаСервере 	= РеквизитыОтправки.ИдентификаторОтправкиНаСервере;
	Результат.ОрганизацияСсылка 				= РеквизитыОтправки.Организация;
	Результат.ВидОтчета 						= РеквизитыОтправки.ВидОтчета;
	
	ОтправкаЧерезСЭДОВключаетсяПоСобытию = (ДокументооборотСФССКлиентСервер.ПараметрыОтправкиВидаДокументаЧерезСЭДО(
		Результат.ВидОтчета, Ложь, Ложь).ОтправкаЧерезСЭДО = Неопределено);
	РасширениеФайлаПакета = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(
		РеквизитыОтправки.ИмяФайлаПакета).Расширение;
	РасширениеФайлаПакета = нрег(РасширениеФайлаПакета);
	
	Если ОтправкаЧерезСЭДОВключаетсяПоСобытию Тогда
		Если РасширениеФайлаПакета = ".ef4" ИЛИ РасширениеФайлаПакета = ".esl"
			ИЛИ РасширениеФайлаПакета = ".e4a" Тогда
			
			ОтправкаЧерезСЭДОБылаВыполнена = Ложь;
			
		Иначе
			ПодписанныйПакет = РеквизитыОтправки.ПодписанныйПакет.Получить();
			ОтправкаЧерезСЭДОБылаВыполнена = (ПодписанныйПакет = Неопределено
				ИЛИ ТипЗнч(ПодписанныйПакет) = Тип("ДвоичныеДанные") И ПодписанныйПакет.Размер() = 0);
		КонецЕсли;
		
	Иначе
		ОтправкаЧерезСЭДОБылаВыполнена = Неопределено;
	КонецЕсли;
	
	Результат.ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыОтправки.ВидОтчета, "ТипДокумента");
	
	ЭтоПодтверждениеВидаДеятельности =
		(Результат.ТипДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФСС
		И Результат.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности);
	ЭтоПодписьИШифрованиеSOAP = ЭтоПодтверждениеВидаДеятельности;
	
	ТипВзаимодействия = ДокументооборотСФССКлиентСервер.ТипВзаимодействияСЭДО(
		Результат.ВидОтчета,
		-1,
		ОтправкаЧерезСЭДОБылаВыполнена);
	Если ТипВзаимодействия <> -1 Тогда
		Результат.ОтправкаЧерезСЭДО = Истина;
		Результат.ТипВзаимодействия = ТипВзаимодействия;
	КонецЕсли;
	
	Если ЭтоПодписьИШифрованиеSOAP Тогда
		МестоХраненияКлюча = КриптографияЭДКОКлиентСервер.КонтекстМоделиХраненияКлюча(Результат.ОрганизацияСсылка);
	КонецЕсли;
	
	КриптографияЭДКОКлиентСервер.ЗаполнитьМестоХраненияКлюча(МестоХраненияКлюча, Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтправкаОтчетовЧерезСЭДОФСС

Процедура ОбработкаСодержимогоСообщенияСЭДООперацииСОтчетомФСС(
		Организация,
		ДанныеСообщения,
		РезультатОбработки) Экспорт
	
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	
	Если НЕ ДанныеСообщения.Новое И ДанныеСообщения.Свойство("ТекстСообщения")
		И ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияОтветНаЗапросИсторическихДанных Тогда
		
		// Разбор данных 332 сообщения.
		РезультатПоиска = ДанныеИсходящегоСообщенияСЭДОФСС(Организация, ДанныеСообщения.Идентификатор);
		Если РезультатПоиска.Выполнено Тогда
			ДатаКонца = Неопределено;
			ОписаниеОшибки = "";
			Если НЕ РезультатПоиска.ДанныеСообщения.ЭтоПользовательскийЗапрос Тогда
				Попытка
					Чтение = Новый ЧтениеXML;
					Чтение.УстановитьСтроку(РезультатПоиска.ДанныеСообщения.ТекстСообщения);
					ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
					Чтение.Закрыть();
					ДатаКонца = ?(ЗначениеЗаполнено(ДанныеОтвета.period.dateTo),
						ЗначениеСвойстваУзлаXDTO(ДанныеОтвета.period, "dateTo", Дата(1, 1, 1), "Дата"),
						Неопределено);
				Исключение
					ОписаниеОшибки = СтрШаблон(
						НСтр("ru = 'Ошибка разбора XML: %1.';
							|en = 'XML parsing error: %1.'"),
						ИнформацияОбОшибке().Описание);
					ЗаписьЖурналаРегистрации(
						НСтр("ru = 'Электронный документооборот с контролирующими органами. Обмен с СЭДО СФР';
							|en = 'Electronic data interchange with regulatory authorities. Exchange with Social Insurance Fund of Russia EDI'"),
						УровеньЖурналаРегистрации.Ошибка, , ,
						ОписаниеОшибки);
					РезультатОбработки.ОшибкаОбработки = Истина;
					РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки;
					Возврат;
				КонецПопытки;
			КонецЕсли;
			
			СвойстваОбменаПоСЭДОЧерезОператора =
				ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(Организация);
			
			// В качестве идентфикатора запроса сохраняем идентфикатор 332 сообщения.
			РезультатРазбора = РазобратьОтветВходящиеСообщенияСЭДОФСС(ДанныеСообщения.ТекстСообщения,
				Неопределено, ДанныеСообщения.Идентификатор, СвойстваОбменаПоСЭДОЧерезОператора);
			Если РезультатРазбора.Выполнено Тогда
				// Сохранение данных о сообщениях в БД.
				РезультатСохранения = СохранитьДанныеВходящихСообщенийСЭДОФСС(
					Организация,
					РезультатРазбора.ДанныеСообщений,,
					СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
				Если РезультатСохранения.БылиОшибкиОбработки Тогда
					РезультатОбработки.ОписаниеОшибки = СтрСоединить(РезультатСохранения.ОшибкиОбработки, Символы.ПС);
					РезультатОбработки.ОшибкаОбработки = Истина;
					Возврат;
				КонецЕсли;
				Если НЕ РезультатПоиска.ДанныеСообщения.ЭтоПользовательскийЗапрос
					И ЗначениеЗаполнено(ДатаКонца) Тогда
					СохранитьДатуСеансаОбменаСЭДОФСС(
						Организация,
						ДатаКонца,
						СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую);
				КонецЕсли;
			Иначе
				Шаблон = НСтр("ru = 'При разборе данных сообщения СЭДО с типом 332 произошла ошибка:
					|%1';
					|en = 'An error occurred while parsing the data of the EDI message with type 332:
					|%1'");
				ОписаниеОшибки = СтрШаблон(Шаблон, РезультатРазбора.ОписаниеОшибки);
				ИмяСобытия = НСтр("ru = 'Электронный документооборот с контролирующими органами. Получение данных СЭДО';
									|en = 'Electronic data interchange with regulatory authorities. Receive EDI data'");
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
					ИмяСобытия,
					УровеньЖурналаРегистрации.Ошибка, , ,
					ОписаниеОшибки);
				РезультатОбработки.ОшибкаОбработки = Истина;
				РезультатОбработки.ОписаниеОшибки = ОписаниеОшибки;
				Возврат;
			КонецЕсли;
				
		КонецЕсли;
		
	ИначеЕсли НЕ ДанныеСообщения.Новое И ДанныеСообщения.Свойство("ТекстСообщения")
		И (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатПодпискиСнятияПодпискиАбонентовОперавтора
			ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатПодпискиСнятияПодпискиАбонентовОтОперавтора) Тогда
		
		СвойстваОбменаПоСЭДОЧерезОператора =
			ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервера.СвойстваОбменаПоСЭДОЧерезОператора(Организация);
		Если НЕ СвойстваОбменаПоСЭДОЧерезОператора.ОбменПоСЭДОНапрямую Тогда
			РезультатПодпискиСнятияПодпискиАбонентовОператора =
				РазобратьРезультатПодпискиСнятияПодпискиАбонентовОператораСЭДОСФР(ДанныеСообщения.ТекстСообщения, Организация);
			Если ЗначениеЗаполнено(РезультатПодпискиСнятияПодпискиАбонентовОператора.ОписаниеОшибки) Тогда
				ПараметрыВывода = ЭлектронныйДокументооборотСФССКлиентСервер.НовыеПараметрыВывестиОшибку(Истина);
				ЭлектронныйДокументооборотСФССКлиентСервер.ВывестиОшибку(
					НСтр("ru = 'Вашу организацию не удалось подписать на обмен по системе СЭДО через оператора Калуга Астрал по причине';
						|en = 'Cannot sign up your company for EDI exchange through the Kaluga Astral provider due to'") + ":
					|" + РезультатПодпискиСнятияПодпискиАбонентовОператора.ОписаниеОшибки, ПараметрыВывода);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли НЕ ДанныеСообщения.Новое И ДанныеСообщения.Свойство("ТекстСообщения")
		И (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
		ИЛИ (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельности
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОбработкиОтчета4ФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникам
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатСозданияМашиночитаемойДоверенностиФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОтзываМашиночитаемойДоверенностиФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияСписокМашиночитаемыхДоверенностейФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияМашиночитаемаяДоверенностьФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияСправочникПолномочийМашиночитаемыхДоверенностейФСС
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР
		ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором)
		И НЕ РезультатОбработки.Обработано) Тогда
		
		ОтправкаСсылка 	= Неопределено;
		ОтчетСсылка 	= Неопределено;
		ВидОтчета 		= Неопределено;
		
		Если ЗначениеЗаполнено(ДанныеСообщения.ТекстСообщения) Тогда
			РезультатыОперации = РезультатыОперацииСОтчетомФССЧерезСЭДО(
				ДанныеСообщения.ТекстСообщения,
				ДанныеСообщения.Тип,,
				Организация);
			
			Если РезультатыОперации.Свойство("ОтправкаСсылка") И ЗначениеЗаполнено(РезультатыОперации.ОтправкаСсылка) Тогда
				ОтправкаСсылка = РезультатыОперации.ОтправкаСсылка;
				ОтчетСсылка = ?(РезультатыОперации.Свойство("ОтчетСсылка"), РезультатыОперации.ОтчетСсылка, Неопределено);
				ВидОтчета = ?(РезультатыОперации.Свойство("ВидОтчета"), РезультатыОперации.ВидОтчета, Неопределено);
				
			ИначеЕсли ЗначениеЗаполнено(РезультатыОперации.ИдентификаторОтправкиНаСервере)
				ИЛИ ЗначениеЗаполнено(РезультатыОперации.НомерОтчетаРУСТ) Тогда
				
				ИдентификаторИНомерЗаполнены = ЗначениеЗаполнено(РезультатыОперации.ИдентификаторОтправкиНаСервере)
					И ЗначениеЗаполнено(РезультатыОперации.НомерОтчетаРУСТ);
				
				ЗапросОтправок = Новый Запрос;
				ЗапросОтправок.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	ОтправкиФСС.Ссылка КАК Ссылка,
					|	ОтправкиФСС.ИдентификаторОтправкиНаСервере КАК ИдентификаторОтправкиНаСервере,
					|	ОтправкиФСС.ДатаОтправки КАК ДатаОтправки,
					|	ОтправкиФСС.ОтчетСсылка КАК ОтчетСсылка,
					|	ОтправкиФСС.ВидОтчета КАК ВидОтчета
					|ИЗ
					|	Справочник.ОтправкиФСС КАК ОтправкиФСС
					|ГДЕ
					|	ОтправкиФСС.Организация = &Организация
					|	И "
					+ ?(ИдентификаторИНомерЗаполнены, "(", "")
					+ ?(ЗначениеЗаполнено(РезультатыОперации.ИдентификаторОтправкиНаСервере),
						"ОтправкиФСС.ИдентификаторОтправкиНаСервере ПОДОБНО &ИдентификаторОтправкиНаСервере", "")
					+ ?(ИдентификаторИНомерЗаполнены, " ИЛИ ", "")
					+ ?(ЗначениеЗаполнено(РезультатыОперации.НомерОтчетаРУСТ),
						"ОтправкиФСС.ИдентификаторОтправкиНаСервере ПОДОБНО &НомерОтчетаРУСТ", "")
					+ ?(ИдентификаторИНомерЗаполнены, ")", "") + "
					|	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
					|
					|УПОРЯДОЧИТЬ ПО
					|	ОтправкиФСС.ДатаОтправки УБЫВ";
				ЗапросОтправок.Параметры.Вставить("Организация", Организация);
				Если ЗначениеЗаполнено(РезультатыОперации.ИдентификаторОтправкиНаСервере) Тогда
					ЗапросОтправок.Параметры.Вставить("ИдентификаторОтправкиНаСервере",
						"%" + РезультатыОперации.ИдентификаторОтправкиНаСервере + "%");
				КонецЕсли;
				Если ЗначениеЗаполнено(РезультатыОперации.НомерОтчетаРУСТ) Тогда
					ЗапросОтправок.Параметры.Вставить("НомерОтчетаРУСТ", "%" + РезультатыОперации.НомерОтчетаРУСТ + "%");
				КонецЕсли;
				
				ОтправкаНайдена = Ложь;
				ПохожаяОтправкаСсылка 		= Неопределено;
				ПохожийИдентификаторОтчета 	= "";
				ПохожаяДатаОтчета 			= Неопределено;
				ПохожыйОтчетСсылка 			= Неопределено;
				ПохожийВидОтчета 			= Неопределено;
				Выборка = ЗапросОтправок.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Если ИдентификаторИНомерЗаполнены
						И СтрНайти(Выборка.ИдентификаторОтправкиНаСервере, РезультатыОперации.НомерОтчетаРУСТ) = 0 Тогда
						
						ПохожаяОтправкаСсылка 		= Выборка.Ссылка;
						ПохожийИдентификаторОтчета 	= Выборка.ИдентификаторОтправкиНаСервере;
						ПохожаяДатаОтчета 			= Выборка.ДатаОтправки;
						ПохожыйОтчетСсылка 			= Выборка.ОтчетСсылка;
						ПохожийВидОтчета 			= Выборка.ВидОтчета;
						Продолжить;
					КонецЕсли;
					
					ОтправкаСсылка 							= Выборка.Ссылка;
					РезультатыОперации.ИдентификаторОтчета 	= Выборка.ИдентификаторОтправкиНаСервере;
					РезультатыОперации.ДатаОтчета 			= Выборка.ДатаОтправки;
					ОтчетСсылка 							= Выборка.ОтчетСсылка;
					ВидОтчета 								= Выборка.ВидОтчета;
					ОтправкаНайдена = Истина;
					Прервать;
				КонецЦикла;
				
				Если НЕ ОтправкаНайдена И ЗначениеЗаполнено(ПохожаяОтправкаСсылка) Тогда
					ОтправкаСсылка 							= ПохожаяОтправкаСсылка;
					РезультатыОперации.ИдентификаторОтчета 	= ПохожийИдентификаторОтчета;
					РезультатыОперации.ДатаОтчета 			= ПохожаяДатаОтчета;
					ОтчетСсылка 							= ПохожыйОтчетСсылка;
					ВидОтчета 								= ПохожийВидОтчета;
				КонецЕсли;
			КонецЕсли;
			
			ПоискЛюбойОтправки = Ложь;
			Если ПоискЛюбойОтправки И НЕ ЗначениеЗаполнено(ОтправкаСсылка)
				И НЕ ЗначениеЗаполнено(РезультатыОперации.ИдентификаторОтправкиНаСервере)
				И (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
				ИЛИ ДанныеСообщения.Тип =
					ТипыСообщений.ТипСообщенияУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельности
				ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором) Тогда
				
				ЗапросОтправок = Новый Запрос;
				ЗапросОтправок.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ОтправкиФСС.Ссылка КАК Ссылка,
					|	ОтправкиФСС.ИдентификаторОтправкиНаСервере КАК ИдентификаторОтправкиНаСервере,
					|	ОтправкиФСС.ДатаОтправки КАК ДатаОтправки,
					|	ОтправкиФСС.ОтчетСсылка КАК ОтчетСсылка,
					|	ОтправкиФСС.ВидОтчета КАК ВидОтчета,
					|	ОтправкиФСС.ПодписанныйПакет КАК ПодписанныйПакет
					|ИЗ
					|	Справочник.ОтправкиФСС КАК ОтправкиФСС
					|ГДЕ
					|	ОтправкиФСС.Организация = &Организация
					|	И ОтправкиФСС.ВидОтчета = ЗНАЧЕНИЕ(Справочник.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности)
					|	И ОтправкиФСС.ПометкаУдаления = ЛОЖЬ
					|
					|УПОРЯДОЧИТЬ ПО
					|	ОтправкиФСС.ДатаОтправки УБЫВ";
				ЗапросОтправок.Параметры.Вставить("Организация", Организация);
				
				Выборка = ЗапросОтправок.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОтправкаЧерезСЭДО = (Выборка.ПодписанныйПакет.Получить() = Неопределено);
					
					Если ОтправкаЧерезСЭДО Тогда
						ИдентификаторВОтправкеОтчета = Выборка.ИдентификаторОтправкиНаСервере;
						ЕстьНомерОтчетаРУСТ = СтрНайти(ИдентификаторВОтправкеОтчета, "(") <> 0;
						
						Если НЕ ЕстьНомерОтчетаРУСТ Тогда
							ОтправкаСсылка 							= Выборка.Ссылка;
							РезультатыОперации.ИдентификаторОтчета 	= ИдентификаторВОтправкеОтчета;
							РезультатыОперации.ДатаОтчета 			= Выборка.ДатаОтправки;
							ОтчетСсылка 							= Выборка.ОтчетСсылка;
							ВидОтчета 								= Выборка.ВидОтчета;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный
				ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР)
				И РезультатыОперации.ИсходноеСообщениеНайдено Тогда
				
				ДанныеИсходногоСообщения = Новый Структура;
				ДанныеИсходногоСообщения.Вставить("Идентификатор", 		РезультатыОперации.ИдентификаторОтправкиНаСервере);
				ДанныеИсходногоСообщения.Вставить("Тип", 				РезультатыОперации.ТипИсходногоСообщения);
				ДанныеИсходногоСообщения.Вставить("Дата", 				РезультатыОперации.ДатаИсходногоСообщения);
				ДанныеИсходногоСообщения.Вставить("ТипВзаимодействия", 	РезультатыОперации.ТипВзаимодействияИсходногоСообщения);
				
				ЭлектронныйДокументооборотСФССПереопределяемый.ПослеПолученияПодтвержденияДоставкиОператоромСообщенияСЭДО(
					Организация,
					ДанныеИсходногоСообщения,
					РезультатыОперации.СтатусПодрверждения,
					РезультатОбработки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОтправкаСсылка) Тогда
				Если ЗначениеЗаполнено(РезультатыОперации.НомерОтчетаРУСТ)
					И СтрНайти(РезультатыОперации.ИдентификаторОтчета, РезультатыОперации.НомерОтчетаРУСТ) = 0 Тогда
					
					ПозицияНачалаНомераРУСТ = СтрНайти(РезультатыОперации.ИдентификаторОтчета, "(");
					Если ПозицияНачалаНомераРУСТ <> 0 Тогда
						РезультатыОперации.ИдентификаторОтчета = Лев(РезультатыОперации.ИдентификаторОтчета,
							ПозицияНачалаНомераРУСТ - 1);
						РезультатыОперации.ИдентификаторОтчета = СокрЛП(РезультатыОперации.ИдентификаторОтчета);
					КонецЕсли;
					
					РезультатыОперации.ИдентификаторОтчета = СтрШаблон(
						"%1 (номер заявления в РУСТ: %2)",
						РезультатыОперации.ИдентификаторОтчета,
						РезультатыОперации.НомерОтчетаРУСТ);
					РезультатыОперации.ИдентификаторОтчета = Лев(РезультатыОперации.ИдентификаторОтчета, 100);
				КонецЕсли;
				
				Если ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатСозданияМашиночитаемойДоверенностиФСС
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОтзываМашиночитаемойДоверенностиФСС
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияМашиночитаемаяДоверенностьФСС
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияСправочникПолномочийМашиночитаемыхДоверенностейФСС
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором
					И (ВидОтчета = Справочники.ВидыОтправляемыхДокументов.МашиночитаемыеДоверенностиФСС
					ИЛИ ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ЗапросСправочникаПолномочийМашиночитаемойДоверенностиФСС) Тогда
					
					СведенияПоОбъекту = ?(РезультатыОперации.Свойство("СведенияПоОбъекту"),
						РезультатыОперации.СведенияПоОбъекту, Неопределено);
					
					СтатусОперации = СтатусОперацииСМЧДФСС(РезультатыОперации);
					
					Если СведенияПоОбъекту = Неопределено И НЕ ЗначениеЗаполнено(ОтчетСсылка)
						И ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ЗапросСправочникаПолномочийМашиночитаемойДоверенностиФСС Тогда
						
						НаименованиеОбъекта = НСтр("ru = 'Запрос справочника полномочий машиночитаемой доверенности (ФСС)';
													|en = 'Request of a catalog of powers of a machine-readable authorization letter (SSF)'");
						СведенияПоОбъекту = Новый Структура;
						СведенияПоОбъекту.Вставить("ПредставлениеКонтролирующегоОргана", 	НСтр("ru = 'ФСС';
																									|en = 'SSF'"));
						СведенияПоОбъекту.Вставить("Наименование", 							НаименованиеОбъекта);
					КонецЕсли;
					
					ТекстHTML = ГенерироватьHTMLПротоколаОбработкиМЧДФСС(
						ОтчетСсылка,
						Организация,
						РезультатыОперации,
						СтатусОперации,
						РезультатыОперации.ИдентификаторОтчета,
						СведенияПоОбъекту);
					
				ИначеЕсли (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельности
					ИЛИ (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОбработкиОтчета4ФСС
					ИЛИ (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
							ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором)
						И (ВидОтчета = Справочники.ВидыОтправляемыхДокументов.ПодтверждениеВидаДеятельности)
							ИЛИ ВидОтчета = Справочники.ВидыОтправляемыхДокументов.Отчет4ФСС)) Тогда
					
					СтатусОперации = СтатусОперацииСОКВЭД(РезультатыОперации);
					
					ТекстHTML = ГенерироватьHTMLПротоколаОбработкиОперацииСОКВЭД(
						ОтчетСсылка,
						Организация,
						РезультатыОперации,
						СтатусОперации,
						РезультатыОперации.ИдентификаторОтчета);
					
				ИначеЕсли ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникам
					ИЛИ (ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
							ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором)
						И ВидОтчета = Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
					
					СтатусОперации = СтатусОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(РезультатыОперации);
					
					ТекстHTML = ГенерироватьHTMLПротоколаОбработкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
						ОтчетСсылка,
						Организация,
						РезультатыОперации,
						СтатусОперации);
					
				ИначеЕсли ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный
					ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР Тогда
					
					Если ВРег(РезультатыОперации.СтатусПодрверждения) = "SUCCESS" Тогда
						ДвоичныеДанныеСообщения = ПолучитьДвоичныеДанныеИзСтроки(ДанныеСообщения.ТекстСообщения, "utf-8");
						
						ОтправкаОбъект = ОтправкаСсылка.ПолучитьОбъект();
						ОтправкаОбъект.ОбменЧерезОператора = Истина;
						ОтправкаОбъект.ДоставленоВСФР = Истина;
						ОтправкаОбъект.ДатаДоставкиВСФР = ?(ЗначениеЗаполнено(ДанныеСообщения.Дата), ДанныеСообщения.Дата,
							РезультатыОперации.ДатаПолученияРезультата);
						ОтправкаОбъект.КвитанцияДоставкиВСФР = Новый ХранилищеЗначения(ДвоичныеДанныеСообщения);
						ОтправкаОбъект.Записать();
					КонецЕсли;
					
				Иначе
					СтатусОперации = Новый Структура("СтатусОтправки",
						?(ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
							ИЛИ ДанныеСообщения.Тип = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором,
						Перечисления.СтатусыОтправки.НеПринят, Перечисления.СтатусыОтправки.Сдан));
					ТекстHTML = "";
				КонецЕсли;
				
				Если ДанныеСообщения.Тип <> ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный
					И ДанныеСообщения.Тип <> ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР Тогда
					
					ДвоичныеДанныеСообщения = ПолучитьДвоичныеДанныеИзСтроки(ДанныеСообщения.ТекстСообщения, "utf-8");
					
					РезультатОтправки = Новый Структура;
					РезультатОтправки.Вставить("ИдентификаторОтправкиНаСервере", 	РезультатыОперации.ИдентификаторОтчета);
					РезультатОтправки.Вставить("ДатаПолученияРезультата", 			РезультатыОперации.ДатаПолученияРезультата);
					РезультатОтправки.Вставить("СтатусОтправки", 					СтатусОперации.СтатусОтправки);
					РезультатОтправки.Вставить("Протокол", 							ТекстHTML);
					РезультатОтправки.Вставить("Квитанция", 						ДвоичныеДанныеСообщения);
					РезультатОтправки.Вставить("РезультатыОперации", 				РезультатыОперации);
					
					СохранитьРезультатОтправкиФСС(ОтправкаСсылка, РезультатОтправки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеСообщения.Тип <> ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
			И ДанныеСообщения.Тип <> ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором
			ИЛИ ЗначениеЗаполнено(ОтправкаСсылка) Тогда
			
			РезультатОбработки.Обработано = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция РезультатыОперацииСОтчетомФССЧерезСЭДО(
		ТекстРезультата,
		ТипСообщения = "",
		ВидОтчета = Неопределено,
		Организация = Неопределено)
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Результат = Новый Структура;
	Результат.Вставить("ТипРезультата", 						"");
	Результат.Вставить("ИдентификаторОтчета", 					"");
	Результат.Вставить("СтатусОбработки", 						"");
	Результат.Вставить("ДатаОтчета", 							Неопределено);
	Результат.Вставить("СообщениеОбОшибке", 					"");
	Результат.Вставить("РезультатыВЦелом", 						Новый Массив);
	Результат.Вставить("ИсторияСменыСтатусов", 					Новый Массив);
	Результат.Вставить("ТипСообщения", 							ТипСообщения);
	Результат.Вставить("ИдентификаторОтправкиНаСервере", 		"");
	Результат.Вставить("НомерОтчетаРУСТ", 						"");
	Результат.Вставить("ДатаРегистрации", 						Неопределено);
	Результат.Вставить("ДатаПолученияРезультата", 				ДатаСеанса);
	Результат.Вставить("СтатусПодрверждения", 					"");
	Результат.Вставить("ИсходноеСообщениеНайдено", 				Ложь);
	Результат.Вставить("ТипИсходногоСообщения", 				"");
	Результат.Вставить("ТипВзаимодействияИсходногоСообщения", 	2);
	Результат.Вставить("ДатаИсходногоСообщения", 				Неопределено);
	
	ТипыСообщений = ДокументооборотСФССКлиентСервер.ТипыСообщенийСЭДО(Истина);
	
	ЭтоУведомлениеОЛогическойОшибкеСообщения 	= Ложь;
	ЭтоУведомлениеОбИзмененииСтатуса 			= Ложь;
	ЭтоПодтверждениеДоставкиОператоромВСФР 		= Ложь;
	Если НЕ ЗначениеЗаполнено(Результат.ТипСообщения) Тогда
		Если ВидОтчета = Справочники.ВидыОтправляемыхДокументов.МашиночитаемыеДоверенностиФСС Тогда
			УведомлениеОбИзмененииСтатуса = РазобратьРезультатСозданияМЧДСЭДОФСС(ТекстРезультата, Истина);
			Если УведомлениеОбИзмененииСтатуса.ОтсутствуютОбязательныеУзлы Тогда
				УведомлениеОбИзмененииСтатуса = РазобратьРезультатОтзываМЧДСЭДОФСС(ТекстРезультата, Истина,, Организация);
			КонецЕсли;
		ИначеЕсли ВидОтчета = Справочники.ВидыОтправляемыхДокументов.Отчет4ФСС Тогда
			УведомлениеОбИзмененииСтатуса = РазобратьРезультатОбработкиОтчета4ФСССЭДОФСС(ТекстРезультата, Истина);
		ИначеЕсли ВидОтчета = Справочники.ВидыОтправляемыхДокументов.РеестрСтимулирующихВыплатМедицинскимИСоциальнымРаботникам Тогда
			УведомлениеОбИзмененииСтатуса = РазобратьРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникамСЭДОФСС(
				ТекстРезультата, Истина);
		Иначе
			УведомлениеОбИзмененииСтатуса = РазобратьУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельностиСЭДОФСС(
				ТекстРезультата, Истина);
		КонецЕсли;
		Если УведомлениеОбИзмененииСтатуса.ОтсутствуютОбязательныеУзлы Тогда
			УведомлениеОЛогическойОшибке = РазобратьУведомлениеОЛогическойОшибкеСообщенияСЭДОФСС(ТекстРезультата, Истина,,
				Организация);
			Если НЕ УведомлениеОЛогическойОшибке.ОтсутствуютОбязательныеУзлы Тогда
				ЭтоУведомлениеОЛогическойОшибкеСообщения = Истина;
			КонецЕсли;
		Иначе
			ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщения
		ИЛИ ТипСообщения = ТипыСообщений.ТипСообщенияНайденыОшибкиПриОбработкеСообщенияОператором Тогда
		
		УведомлениеОЛогическойОшибке = РазобратьУведомлениеОЛогическойОшибкеСообщенияСЭДОФСС(ТекстРезультата,,, Организация);
		ЭтоУведомлениеОЛогическойОшибкеСообщения = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельности Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьУведомлениеОбИзмененииСтатусаПодтвержденияВидаДеятельностиСЭДОФСС(
			ТекстРезультата);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияРезультатОбработкиОтчета4ФСС Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьРезультатОбработкиОтчета4ФСССЭДОФСС(ТекстРезультата);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникам Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьРезультатОбработкиРеестраСтимулирующихВыплатМедИСоцРаботникамСЭДОФСС(
			ТекстРезультата);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияРезультатСозданияМашиночитаемойДоверенностиФСС Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьРезультатСозданияМЧДСЭДОФСС(ТекстРезультата);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияРезультатОтзываМашиночитаемойДоверенностиФСС Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьРезультатОтзываМЧДСЭДОФСС(ТекстРезультата,,, Организация);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияМашиночитаемаяДоверенностьФСС Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьМашиночитаемуюДоверенностьСЭДОФСС(ТекстРезультата,, Организация);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияСправочникПолномочийМашиночитаемыхДоверенностейФСС Тогда
		УведомлениеОбИзмененииСтатуса = РазобратьСправочникПолномочийМашиночитаемыхДоверенностейСЭДОФСС(ТекстРезультата,,
			Организация);
		ЭтоУведомлениеОбИзмененииСтатуса = Истина;
		
	ИначеЕсли ТипСообщения = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФРАльтернативный
		ИЛИ ТипСообщения = ТипыСообщений.ТипСообщенияПодтверждениеДоставкиОператоромВСФР Тогда
		
		ПодтверждениеДоставкиОператоромВСФР = РазобратьПодтверждениеДоставкиОператоромВСФРПоСЭДО(ТекстРезультата,,,
			Организация);
		ЭтоПодтверждениеДоставкиОператоромВСФР = Истина;
	КонецЕсли;
	
	Если ЭтоУведомлениеОЛогическойОшибкеСообщения Тогда
		Если УведомлениеОЛогическойОшибке.Выполнено Тогда
			Результат.ИдентификаторОтправкиНаСервере = УведомлениеОЛогическойОшибке.ИдентификаторИсходногоСообщения;
			Результат.ИдентификаторОтчета = УведомлениеОЛогическойОшибке.ИдентификаторИсходногоСообщения;
			Для каждого ДанныеСообщенияОбОшибках Из УведомлениеОЛогическойОшибке.ДанныеСообщенийОбОшибках Цикл
				Результат.СообщениеОбОшибке = ?(ЗначениеЗаполнено(Результат.СообщениеОбОшибке),
					Результат.СообщениеОбОшибке + Символы.ВК + Символы.ПС, "")
					+ ?(ЗначениеЗаполнено(ДанныеСообщенияОбОшибках.КодОшибки), ДанныеСообщенияОбОшибках.КодОшибки + ". ", "")
					+ ДанныеСообщенияОбОшибках.ТекстОшибки;
			КонецЦикла;
			Результат.СтатусОбработки = "PROCESSING_ERROR";
		КонецЕсли;
		
	ИначеЕсли ЭтоУведомлениеОбИзмененииСтатуса Тогда
		Если УведомлениеОбИзмененииСтатуса.Выполнено Тогда
			Результат.ИдентификаторОтправкиНаСервере = УведомлениеОбИзмененииСтатуса.ИдентификаторИсходногоСообщения;
			Результат.НомерОтчетаРУСТ = УведомлениеОбИзмененииСтатуса.НомерОтчетаРУСТ;
			Результат.ИдентификаторОтчета = УведомлениеОбИзмененииСтатуса.НомерОтчетаРУСТ;
			Результат.СтатусОбработки = УведомлениеОбИзмененииСтатуса.СтатусОбработки;
			Если УведомлениеОбИзмененииСтатуса.Свойство("РезультатыВЦелом") Тогда
				Результат.РезультатыВЦелом = УведомлениеОбИзмененииСтатуса.РезультатыВЦелом;
			КонецЕсли;
			СтатусОбработки = Новый Структура;
			СтатусОбработки.Вставить("СтатусРассмотрения", УведомлениеОбИзмененииСтатуса.СтатусОбработки);
			СтатусОбработки.Вставить("КомментарийСтатуса",
				УведомлениеОбИзмененииСтатуса.КомментарийКСтатусуОбработкиОтчета);
			СтатусОбработки.Вставить("ДатаСтатуса", ДатаСеанса);
			
			Результат.ИсторияСменыСтатусов.Добавить(СтатусОбработки);
			Если УведомлениеОбИзмененииСтатуса.Свойство("ОтправкаСсылка") Тогда
				Результат.Вставить("ОтправкаСсылка", УведомлениеОбИзмененииСтатуса.ОтправкаСсылка);
				Если ЗначениеЗаполнено(УведомлениеОбИзмененииСтатуса.ОтправкаСсылка) Тогда
					Результат.ИдентификаторОтчета = УведомлениеОбИзмененииСтатуса.ИдентификаторИсходногоСообщения;
				КонецЕсли;
			КонецЕсли;
			
			МассивПолей = СтрРазделить("ОтчетСсылка,ВидОтчета,СведенияПоОбъекту,ДатаОтчета,ДатаРегистрации,ДатаВремяОбработки,"
				+ "ИдентификаторОтправки,НомераНеПринятыхЗаписей,НомераСданныхЗаписей,СообщенияОбОшибках,ОшибкиПервичнойОбработки,"
				+ "ПредупрежденияПервичнойОбработки,ПротоколОбработки", ",");
			Для каждого ИмяПоля Из МассивПолей Цикл
				ЗначениеПоля = Неопределено;
				Если УведомлениеОбИзмененииСтатуса.Свойство(ИмяПоля, ЗначениеПоля) Тогда
					Результат.Вставить(ИмяПоля, ЗначениеПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ЭтоПодтверждениеДоставкиОператоромВСФР Тогда
		Результат.ИдентификаторОтправкиНаСервере 		= ПодтверждениеДоставкиОператоромВСФР.ИдентификаторИсходногоСообщения;
		Результат.СтатусПодрверждения 					= ПодтверждениеДоставкиОператоромВСФР.СтатусПодрверждения;
		Результат.ИсходноеСообщениеНайдено 				= ПодтверждениеДоставкиОператоромВСФР.ИсходноеСообщениеНайдено;
		Результат.ТипИсходногоСообщения 				= ПодтверждениеДоставкиОператоромВСФР.ТипИсходногоСообщения;
		Результат.ТипВзаимодействияИсходногоСообщения 	= ПодтверждениеДоставкиОператоромВСФР.ТипВзаимодействияИсходногоСообщения;
		Результат.ДатаИсходногоСообщения 				= ПодтверждениеДоставкиОператоромВСФР.ДатаИсходногоСообщения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьУведомлениеОЛогическойОшибкеСообщенияСЭДОФСС(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь,
		ЗаменятьИдентификаторПакетаФСС = Истина,
		Организация = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 	"");
	Результат.Вставить("ДанныеСообщенийОбОшибках", 			Новый Массив);
	Результат.Вставить("Выполнено", 						Ложь);
	Результат.Вставить("ОписаниеОшибки", 					"");
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 	Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	// <invalidDataFault xmlns="http://www.fss.ru/integration/types/fault/v01">
	//    <uuidInbound>4900e566-d7ed-4a80-91d2-8dd9f26d5f89</uuidInbound>
	//    <faultList>
	//       <fault>
	//          <uuid>4900e566-d7ed-4a80-91d2-8dd9f26d5f89</uuid>
	//          <code>E_SEDO_1025</code>
	//          <message>Пара рег.номер 7711000003 из запроса и ОГРН 1027739443236 из сертификата не найдены в справочнике страхователей</message>
	//       </fault>
	//    </faultList>
	//</invalidDataFault>
	
	ДанныеСообщенияОбОшибкеШаблон = Новый Структура;
	ДанныеСообщенияОбОшибкеШаблон.Вставить("ИдентификаторИсходногоСообщения", 	"");
	ДанныеСообщенияОбОшибкеШаблон.Вставить("КодОшибки", 						"");
	ДанныеСообщенияОбОшибкеШаблон.Вставить("ТекстОшибки", 						"");
	
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.ОтсутствуютОбязательныеУзлы = (ДанныеОтвета.Свойства().Получить("uuidInbound") = Неопределено
			И ДанныеОтвета.Свойства().Получить("faultList") = Неопределено);
		Если Результат.ОтсутствуютОбязательныеУзлы Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Результат.ИдентификаторИсходногоСообщения = ИдентификаторИсходногоСообщенияИзОшибкиЛогическогоКонтроля(ДанныеОтвета);
	
	Если НЕ ДанныеОтвета.Свойства().Получить("faultList") = Неопределено Тогда
		Для каждого СообщениеОбОшибке Из ЗначениеВКоллекцию(ДанныеОтвета.faultList.fault) Цикл
			ДанныеСообщенияОбОшибке = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеСообщенияОбОшибкеШаблон);
			Если СообщениеОбОшибке.Свойства().Получить("uuid") <> Неопределено Тогда
				ДанныеСообщенияОбОшибке.ИдентификаторИсходногоСообщения = ИдентификаторИсходногоСообщенияСКоррекцией(СообщениеОбОшибке.uuid);
			КонецЕсли;
			Если СообщениеОбОшибке.Свойства().Получить("code") <> Неопределено Тогда
				ДанныеСообщенияОбОшибке.КодОшибки = СообщениеОбОшибке.code;
			КонецЕсли;
			Если СообщениеОбОшибке.Свойства().Получить("message") <> Неопределено Тогда
				ДанныеСообщенияОбОшибке.ТекстОшибки = СообщениеОбОшибке.message;
			КонецЕсли;
			Результат.ДанныеСообщенийОбОшибках.Добавить(ДанныеСообщенияОбОшибке);
		КонецЦикла;
	КонецЕсли;
	
	Результат.Выполнено = Истина;
	
	Если ЗаменятьИдентификаторПакетаФСС И ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения) Тогда
		Результат.ИдентификаторИсходногоСообщения = СвойстваПоИдентификаторуПакетаФСС(
			Организация,
			Результат.ИдентификаторИсходногоСообщения,
			Результат.ИдентификаторИсходногоСообщения).ИдентификаторФСС;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьПодтверждениеДоставкиОператоромВСФРПоСЭДО(
		СодержимоеОтвета,
		ПроверитьОбязательныеУзлы = Ложь,
		ЗаменятьИдентификаторПакетаФСС = Истина,
		Организация = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 		"");
	Результат.Вставить("ДанныеСообщенийОбОшибках", 				Новый Массив);
	Результат.Вставить("Выполнено", 							Ложь);
	Результат.Вставить("ОписаниеОшибки", 						"");
	Результат.Вставить("СтатусПодрверждения", 					"");
	Результат.Вставить("ИсходноеСообщениеНайдено", 				Ложь);
	Результат.Вставить("ТипИсходногоСообщения", 				"");
	Результат.Вставить("ТипВзаимодействияИсходногоСообщения", 	2);
	Результат.Вставить("ДатаИсходногоСообщения", 				Неопределено);
	Если ПроверитьОбязательныеУзлы Тогда
		Результат.Вставить("ОтсутствуютОбязательныеУзлы", 	Истина);
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <ns3:сonfirmMessageReadResponse
	//     xmlns:ns2="http://www.fss.ru/integration/types/common/v01"
	//     xmlns:ns3="http://www.fss.ru/integration/types/sedo/arm/v01">
	//     <confirmResults>
	//         <uuid>7cfe7c5f-2a8c-448f-b50d-e8d0dd36f179</uuid>
	//         <status>SUCCESS</status>
	//     </confirmResults>
	// </ns3:сonfirmMessageReadResponse>
	
	Результат.ИдентификаторИсходногоСообщения 	= СокрЛП(ДанныеОтвета.confirmResults.uuid);
	Результат.СтатусПодрверждения 				= СокрЛП(ДанныеОтвета.confirmResults.status);
	
	Результат.Выполнено = Истина;
	
	Если ЗаменятьИдентификаторПакетаФСС И ЗначениеЗаполнено(Результат.ИдентификаторИсходногоСообщения) Тогда
		СвойстваИсходногоСообщения = СвойстваПоИдентификаторуПакетаФСС(
			Организация,
			Результат.ИдентификаторИсходногоСообщения,
			Результат.ИдентификаторИсходногоСообщения);
		Результат.ИдентификаторИсходногоСообщения 		= СвойстваИсходногоСообщения.ИдентификаторФСС;
		Результат.ИсходноеСообщениеНайдено 				= СвойстваИсходногоСообщения.Найдено;
		Результат.ТипИсходногоСообщения 				= СвойстваИсходногоСообщения.ТипСообщенияСЭДО;
		Результат.ТипВзаимодействияИсходногоСообщения 	= СвойстваИсходногоСообщения.ТипВзаимодействияСЭДО;
		Результат.ДатаИсходногоСообщения 				= СвойстваИсходногоСообщения.Дата;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьРезультатПодпискиСнятияПодпискиАбонентовОператораСЭДОСФР(
		СодержимоеОтвета,
		Организация,
		ОтборОшибокПоРегистрационномуНомеруФСС = Истина)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторИсходногоСообщения", 	"");
	Результат.Вставить("ДанныеСообщенийОбОшибках", 			Новый Массив);
	Результат.Вставить("Выполнено", 						Ложь);
	Результат.Вставить("ОписаниеОшибки", 					"");
	Результат.Вставить("РезультатыПодписки", 				Новый Массив);
	
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СодержимоеОтвета);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка разбора XML: %1.';
				|en = 'XML parsing error: %1.'"),
			ИнформацияОбОшибке().Описание);
		Возврат Результат;
	КонецПопытки;
	
	// Пример ответа сервера:
	// <v01:subscriptionResponse xmlns:v01="http://www.fss.ru/integration/types/sedo/arm/v01" xmlns:v011="http://www.fss.ru/integration/types/common/v01">
	//    <!--1 or more repetitions:-->
	//    <v011:uuid>anyType</v011:uuid>
	//    <!--You have a CHOICE of the next 3 items at this level-->
	//    <resultList>
	//       <!--1 or more repetitions:-->
	//       <result>
	//          <regNum>string</regNum>
	//          <status>ERROR</status>
	//          <!--Optional:-->
	//          <error>
	//             <!--Optional:-->
	//             <v011:code>string</v011:code>
	//             <!--Optional:-->
	//             <v011:message>string</v011:message>
	//             <!--Optional:-->
	//             <v011:details>string</v011:details>
	//          </error>
	//       </result>
	//    </resultList>
	//    <resultOrgList>
	//       <!--1 or more repetitions:-->
	//       <resultOrg>
	//          <org>
	//             <!--You have a CHOICE of the next 4 items at this level-->
	//             <ogrn>stringstrings</ogrn>
	//             <inn>stringstring</inn>
	//             <!--Optional:-->
	//             <kpp>stringstr</kpp>
	//             <ogrnip>stringstringstr</ogrnip>
	//             <inn>stringstring</inn>
	//             <snils>stringstrin</snils>
	//             <snils>stringstrin</snils>
	//             <inn>stringstring</inn>
	//             <!--Optional:-->
	//             <regnum>stringstri</regnum>
	//             <inn>stringstring</inn>
	//             <!--Optional:-->
	//             <kpp>stringstr</kpp>
	//          </org>
	//          <status>SUCCESS</status>
	//          <!--Optional:-->
	//          <error>
	//             <!--Optional:-->
	//             <v011:code>string</v011:code>
	//             <!--Optional:-->
	//             <v011:message>string</v011:message>
	//             <!--Optional:-->
	//             <v011:details>string</v011:details>
	//          </error>
	//       </resultOrg>
	//    </resultOrgList>
	//    <error>
	//       <!--Optional:-->
	//       <v011:code>string</v011:code>
	//       <!--Optional:-->
	//       <v011:message>string</v011:message>
	//       <!--Optional:-->
	//       <v011:details>string</v011:details>
	//    </error>
	// </v01:subscriptionResponse>
	
	ШаблонРезультатаПодписки = Новый Структура;
	ШаблонРезультатаПодписки.Вставить("РегистрационныйНомер", 	"");
	ШаблонРезультатаПодписки.Вставить("Статус", 				"");
	ШаблонРезультатаПодписки.Вставить("КодОшибки", 				"");
	ШаблонРезультатаПодписки.Вставить("ТекстОшибки", 			"");
	ШаблонРезультатаПодписки.Вставить("ДеталиОшибки", 			"");
		
	Если ДанныеОтвета.Свойства().Получить("uuid") <> Неопределено Тогда
		Результат.ИдентификаторИсходногоСообщения = ДанныеОтвета.uuid;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("resultList") <> Неопределено
		И ДанныеОтвета.resultList.Получить("result") <> Неопределено Тогда
		
		Для каждого ЭлементРезультатов Из ЗначениеВКоллекцию(ДанныеОтвета.resultList.result) Цикл
			РезультатПодписки = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонРезультатаПодписки);
			
			РезультатПодписки.РегистрационныйНомер 	= ЭлементРезультатов.regNum;
			РезультатПодписки.Статус 				= ЭлементРезультатов.status;
			
			Если ЭлементРезультатов.Свойства().Получить("error") <> Неопределено Тогда
				Если ЭлементРезультатов.error.Свойства().Получить("code") <> Неопределено Тогда
					РезультатПодписки.КодОшибки = ЭлементРезультатов.error.code;
				КонецЕсли;
				Если ЭлементРезультатов.error.Свойства().Получить("message") <> Неопределено Тогда
					РезультатПодписки.ТекстОшибки = ЭлементРезультатов.error.message;
				КонецЕсли;
				Если ЭлементРезультатов.error.Свойства().Получить("details") <> Неопределено Тогда
					РезультатПодписки.ДеталиОшибки = ЭлементРезультатов.error.details;
				КонецЕсли;
			КонецЕсли;
			
			Результат.РезультатыПодписки.Добавить(РезультатПодписки);
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("resultOrgList") <> Неопределено
		И ДанныеОтвета.resultOrgList.Получить("resultOrg") <> Неопределено Тогда
		
		Для каждого ЭлементРезультатов Из ЗначениеВКоллекцию(ДанныеОтвета.resultOrgList.resultOrg) Цикл
			РезультатПодписки = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонРезультатаПодписки);
			
			РезультатПодписки.РегистрационныйНомер 	= ЭлементРезультатов.org.regnum;
			РезультатПодписки.Статус 				= ЭлементРезультатов.status;
			
			Если ЭлементРезультатов.Свойства().Получить("error") <> Неопределено Тогда
				Если ЭлементРезультатов.error.Свойства().Получить("code") <> Неопределено Тогда
					РезультатПодписки.КодОшибки = ЭлементРезультатов.error.code;
				КонецЕсли;
				Если ЭлементРезультатов.error.Свойства().Получить("message") <> Неопределено Тогда
					РезультатПодписки.ТекстОшибки = ЭлементРезультатов.error.message;
				КонецЕсли;
				Если ЭлементРезультатов.error.Свойства().Получить("details") <> Неопределено Тогда
					РезультатПодписки.ДеталиОшибки = ЭлементРезультатов.error.details;
				КонецЕсли;
			КонецЕсли;
			
			Результат.РезультатыПодписки.Добавить(РезультатПодписки);
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеОтвета.Свойства().Получить("error") <> Неопределено
		И (ДанныеОтвета.error.Свойства().Получить("code") <> Неопределено И ЗначениеЗаполнено(ДанныеОтвета.error.code)
		ИЛИ ДанныеОтвета.error.Свойства().Получить("message") <> Неопределено И ЗначениеЗаполнено(ДанныеОтвета.error.message)
		ИЛИ ДанныеОтвета.error.Свойства().Получить("details") <> Неопределено
			И ЗначениеЗаполнено(ДанныеОтвета.error.details)) Тогда
		
		РезультатПодписки = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонРезультатаПодписки);
		
		РезультатПодписки.Статус = "ERROR";
		
		Если ДанныеОтвета.error.Свойства().Получить("code") <> Неопределено Тогда
			РезультатПодписки.КодОшибки = ЭлементРезультатов.error.code;
		КонецЕсли;
		Если ДанныеОтвета.error.Свойства().Получить("message") <> Неопределено Тогда
			РезультатПодписки.ТекстОшибки = ЭлементРезультатов.error.message;
		КонецЕсли;
		Если ДанныеОтвета.error.Свойства().Получить("details") <> Неопределено Тогда
			РезультатПодписки.ДеталиОшибки = ЭлементРезультатов.error.details;
		КонецЕсли;
		
		Результат.РезультатыПодписки.Добавить(РезультатПодписки);
	КонецЕсли;
	
	ДанныеСообщенияОбОшибкеШаблон = Новый Структура;
	ДанныеСообщенияОбОшибкеШаблон.Вставить("КодОшибки", 	"");
	ДанныеСообщенияОбОшибкеШаблон.Вставить("ТекстОшибки", 	"");
	
	РегистрационныйНомерФСС = Неопределено;
	МассивОписанийОшибок = Новый Массив;
	Для каждого РезультатПодписки Из Результат.РезультатыПодписки Цикл
		РезультатПодписки.Статус = СокрЛП(РезультатПодписки.Статус);
		Если ВРег(РезультатПодписки.Статус) = "ERROR" Тогда
			Если ЗначениеЗаполнено(РезультатПодписки.РегистрационныйНомер) И ОтборОшибокПоРегистрационномуНомеруФСС Тогда
				Если РегистрационныйНомерФСС = Неопределено Тогда
					РегистрационныйНомерФСС = СвойстваОрганизацииДляОбмена(Организация).РегистрационныйНомерФСС;
					РегистрационныйНомерФСС = СокрЛП(РегистрационныйНомерФСС);
				КонецЕсли;
				Если РезультатПодписки.РегистрационныйНомер <> РегистрационныйНомерФСС Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ДанныеСообщенияОбОшибке = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеСообщенияОбОшибкеШаблон);
			
			ДанныеСообщенияОбОшибке.КодОшибки = РезультатПодписки.КодОшибки;
			ДанныеСообщенияОбОшибке.ТекстОшибки = СокрЛП(РезультатПодписки.ТекстОшибки);
			ДанныеСообщенияОбОшибке.ТекстОшибки = ДанныеСообщенияОбОшибке.ТекстОшибки
				+ ?(ЗначениеЗаполнено(ДанныеСообщенияОбОшибке.ТекстОшибки)
				И ЗначениеЗаполнено(РезультатПодписки.ДеталиОшибки),
				?(Прав(ДанныеСообщенияОбОшибке.ТекстОшибки, 1) = ".", " ", ". "), "") + СокрЛП(РезультатПодписки.ДеталиОшибки);
			
			Результат.ДанныеСообщенийОбОшибках.Добавить(ДанныеСообщенияОбОшибке);
			
			ОписаниеОшибки = ?(ЗначениеЗаполнено(ДанныеСообщенияОбОшибке.КодОшибки), ДанныеСообщенияОбОшибке.КодОшибки
				+ ?(ЗначениеЗаполнено(ДанныеСообщенияОбОшибке.ТекстОшибки), ". ", ""), "") + ДанныеСообщенияОбОшибке.ТекстОшибки;
			МассивОписанийОшибок.Добавить(ОписаниеОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Результат.ОписаниеОшибки = СтрСоединить(МассивОписанийОшибок, "
		|");
	
	Результат.Выполнено = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция СвойстваПоИдентификаторуПакетаФСС(Организация, ИдентификаторПакетаФСС, ИдентификаторФССПоУмолчанию = "")
	
	Результат = Новый Структура;
	Результат.Вставить("Найдено", 				Ложь);
	Результат.Вставить("Дата", 					Неопределено);
	Результат.Вставить("ИдентификаторФСС", 		ИдентификаторФССПоУмолчанию);
	Результат.Вставить("ТипСообщенияСЭДО", 		"");
	Результат.Вставить("ТипВзаимодействияСЭДО", 2);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЖурналЗапросовКСерверамФСС.Дата КАК Дата,
		|	ЖурналЗапросовКСерверамФСС.ИдентификаторФСС КАК ИдентификаторФСС,
		|	ЖурналЗапросовКСерверамФСС.ТипСообщенияСЭДО КАК ТипСообщенияСЭДО,
		|	ЖурналЗапросовКСерверамФСС.ТипВзаимодействияСЭДО КАК ТипВзаимодействияСЭДО
		|ИЗ
		|	РегистрСведений.ЖурналЗапросовКСерверамФСС КАК ЖурналЗапросовКСерверамФСС
		|ГДЕ
		|	ЖурналЗапросовКСерверамФСС.ИдентификаторПакетаФСС = &ИдентификаторПакетаФСС
		|	И ЖурналЗапросовКСерверамФСС.Организация = &Организация");
	
	Запрос.УстановитьПараметр("ИдентификаторПакетаФСС", ИдентификаторПакетаФСС);
	Запрос.УстановитьПараметр("Организация", 			Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найдено 				= Истина;
		Результат.Дата 					= Выборка.Дата;
		Результат.ИдентификаторФСС 		= Выборка.ИдентификаторФСС;
		Результат.ТипСообщенияСЭДО 		= Выборка.ТипСообщенияСЭДО;
		Результат.ТипВзаимодействияСЭДО = Выборка.ТипВзаимодействияСЭДО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтправкаРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам

Функция ОбработатьРезультатОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
		ОтчетСсылка,
		ОрганизацияСсылка,
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		ПараметрыРезультата) Экспорт
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("АдресРасшифрованногоОтветаSOAP", 			Неопределено);
	ПараметрыВызова.Вставить("АдресЗашифрованногоОтветаSOAP", 			Неопределено);
	ПараметрыВызова.Вставить("ПоляДляЗаписиОтправки", 					Неопределено);
	ПараметрыВызова.Вставить("СохранятьАдресРасшифрованногоОтветаSOAP", Ложь);
	ПараметрыВызова.Вставить("ПодписанныйSOAP64", 						Неопределено);
	Если ПараметрыРезультата <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВызова, ПараметрыРезультата);
	КонецЕсли;
	АдресРасшифрованногоОтветаSOAP 			= ПараметрыВызова.АдресРасшифрованногоОтветаSOAP;
	АдресЗашифрованногоОтветаSOAP 			= ПараметрыВызова.АдресЗашифрованногоОтветаSOAP;
	ПоляДляЗаписиОтправки 					= ПараметрыВызова.ПоляДляЗаписиОтправки;
	СохранятьАдресРасшифрованногоОтветаSOAP = ПараметрыВызова.СохранятьАдресРасшифрованногоОтветаSOAP;
	ПодписанныйSOAP64 						= ПараметрыВызова.ПодписанныйSOAP64;
	
	ТекстРезультата = ПолучитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	Если НЕ СохранятьАдресРасшифрованногоОтветаSOAP Тогда
		УдалитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
	КонецЕсли;
	
	ИмяФайлаРезультата = ПолучитьИмяВременногоФайла();
	ФайлРезультата = Новый ЗаписьТекста(ИмяФайлаРезультата, "utf-8");
	ФайлРезультата.Записать(ТекстРезультата);
	ФайлРезультата.Закрыть();
	ДвоичныеДанныеРезультата = Новый ДвоичныеДанные(ИмяФайлаРезультата);
	
	ТекстПакетаРезультата = ПолучитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	ИмяФайлаПакетаРезультата = ПолучитьИмяВременногоФайла();
	ФайлПакетаРезультата = Новый ЗаписьТекста(ИмяФайлаПакетаРезультата, "utf-8");
	ФайлПакетаРезультата.Записать(ТекстПакетаРезультата);
	ФайлПакетаРезультата.Закрыть();
	ДвоичныеДанныеПакетаРезультата = Новый ДвоичныеДанные(ИмяФайлаПакетаРезультата);
	
	РезультатыОперации = РезультатыОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
		ТекстРезультата,
		МестоХраненияКлюча,
		ПодписанныйSOAP64);
	СтатусОперации = СтатусОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(РезультатыОперации);
	
	ТекстHTML = ГенерироватьHTMLПротоколаОбработкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации);
	
	НастройкиОтправки = Новый Структура;
	НастройкиОтправки.Вставить("ОтчетСсылка", 				ОтчетСсылка);
	НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", 	ПоляДляЗаписиОтправки);
	НастройкиОтправки.Вставить("СтатусОтправки", 			СтатусОперации.СтатусОтправки);
	НастройкиОтправки.Вставить("Протокол", 					ТекстHTML);
	НастройкиОтправки.Вставить("Квитанция", 				ДвоичныеДанныеРезультата);
	НастройкиОтправки.Вставить("ПодписанныйПакет", 			ПодписанныйSOAP64);
	НастройкиОтправки.Вставить("ПакетКвитанции", 			ДвоичныеДанныеПакетаРезультата);
	НоваяОтправкаСсылка = ДобавитьОтправкуФСС(
		МестоХраненияКлюча,
		КороткоеИмяФайлаПакета,
		СтрокаBase64ФайлаПакета,
		РезультатыОперации.ИдентификаторОтправки,
		НастройкиОтправки);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаРезультата);
	УдалитьИзВременногоХранилища(АдресЗашифрованногоОтветаSOAP);
	Если ПодписанныйSOAP64 <> Неопределено И НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) Тогда
		УдалитьИзВременногоХранилища(ПодписанныйSOAP64);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НоваяОтправкаСсылка", 	НоваяОтправкаСсылка);
	Результат.Вставить("СтатусОтправки", 		СтатусОперации.СтатусОтправки);
	Возврат Результат;
	
КонецФункции

Функция РезультатыОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
		ТекстРезультата,
		МестоХраненияКлюча = Ложь,
		ПодписанныйПакет = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторОтправки", 			"");
	Результат.Вставить("СтатусОбработки", 					Неопределено);
	Результат.Вставить("ДатаВремяОбработки", 				Неопределено);
	Результат.Вставить("СообщенияОбОшибках", 				"");
	Результат.Вставить("ОшибкиПервичнойОбработки", 			Новый Массив);
	Результат.Вставить("ПредупрежденияПервичнойОбработки", 	Новый Массив);
	Результат.Вставить("ПротоколОбработки", 				Новый Массив);
	Результат.Вставить("НомераСданныхЗаписей", 				Новый Массив);
	Результат.Вставить("НомераНеПринятыхЗаписей", 			Новый Массив);
	
	НомераЗаписейВыгрузки = Новый Массив;
	Если ЗначениеЗаполнено(ПодписанныйПакет) Тогда
		Если НЕ КриптографияЭДКОКлиентСервер.ЭтоЛокальнаяПодпись(МестоХраненияКлюча) И ЭтоАдресВременногоХранилища(ПодписанныйПакет) Тогда
			ДвоичныеДанныеПодписанногоПакета = ПолучитьИзВременногоХранилища(ПодписанныйПакет);
		Иначе
			ДвоичныеДанныеПодписанногоПакета = Base64Значение(ПодписанныйПакет);
		КонецЕсли;
		Если ТипЗнч(ДвоичныеДанныеПодписанногоПакета) = Тип("ДвоичныеДанные") Тогда
			ФайлПодписанногоПакета = ПолучитьИмяВременногоФайла("xml");
			ДвоичныеДанныеПодписанногоПакета.Записать(ФайлПодписанногоПакета);
			ДеревоXMLВыгрузки = ЗагрузитьXMLВДеревоЗначений(ФайлПодписанногоПакета);
			Если ДеревоXMLВыгрузки <> Неопределено Тогда
				ФильтрСтрокВыгрузки = Новый Структура("Имя", "batchNo");
				СтрокиНомеровЗаписейВыгрузки = ДеревоXMLВыгрузки.Строки.НайтиСтроки(ФильтрСтрокВыгрузки, Истина);
				Для каждого СтрокаНомераЗаписиВыгрузки Из СтрокиНомеровЗаписейВыгрузки Цикл
					НомераЗаписейВыгрузки.Добавить(СтрокаНомераЗаписиВыгрузки.Значение);
				КонецЦикла;
			КонецЕсли;
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ФайлПодписанногоПакета);
		КонецЕсли;
	КонецЕсли;
	
	ДеревоXML = ЗагрузитьXMLВДеревоЗначений(Неопределено, ТекстРезультата);
	Если ДеревоXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелКонверт = НайтиУзел(ДеревоXML, "Envelope");
	Если УзелКонверт = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелТело = НайтиУзел(УзелКонверт, "Body");
	Если УзелТело = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	УзелОтвета = НайтиУзел(УзелТело, "submitCovidWorkerRegistrResponse");
	Если УзелОтвета = Неопределено Тогда
		УзелОтвета = НайтиУзел(УзелТело, "submit2023WorkerRegistrResponse");
		Если УзелОтвета = Неопределено Тогда
			УзелОтвета = НайтиУзел(УзелТело, "PaymentsFederalCivilServantsResponse");
			Если УзелОтвета = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УзелИдентификаторОтправки = НайтиУзел(УзелОтвета, "recriveID");
	Если УзелИдентификаторОтправки <> Неопределено Тогда
		Результат.ИдентификаторОтправки = XMLЗначениеВнутр(Тип("Строка"), УзелИдентификаторОтправки.Значение);
		Результат.ИдентификаторОтправки = СокрЛП(Результат.ИдентификаторОтправки);
	КонецЕсли;
	
	УзелСтатусОбработки = НайтиУзел(УзелОтвета, "statusGeneral");
	Если УзелСтатусОбработки <> Неопределено И ЗначениеЗаполнено(УзелСтатусОбработки.Значение) Тогда
		Результат.СтатусОбработки = XMLЗначениеВнутр(Тип("Число"), УзелСтатусОбработки.Значение);
	КонецЕсли;
	
	УзелДатаВремяОбработки = НайтиУзел(УзелОтвета, "dateTimeReceive");
	Если УзелДатаВремяОбработки <> Неопределено И ЗначениеЗаполнено(УзелДатаВремяОбработки.Значение) Тогда
		Результат.ДатаВремяОбработки = XMLЗначениеВнутр(Тип("Дата"), УзелДатаВремяОбработки.Значение);
	КонецЕсли;
	
	УзелСообщенияОбОшибкахПервичнойПроверки = НайтиУзел(УзелОтвета, "firstErrorList");
	Если УзелСообщенияОбОшибкахПервичнойПроверки <> Неопределено Тогда
		УзлыОшибка = НайтиУзел(УзелСообщенияОбОшибкахПервичнойПроверки, "error", Истина);
		Для каждого УзелОшибка Из УзлыОшибка Цикл
			ОшибкаОбработки = Новый Структура;
			ОшибкаОбработки.Вставить("КодОшибки", 		"");
			ОшибкаОбработки.Вставить("ОписаниеОшибки", 	"");
			
			УзелКодОшибки = НайтиУзел(УзелОшибка, "errorCode");
			Если УзелКодОшибки <> Неопределено Тогда
				ОшибкаОбработки.КодОшибки = XMLЗначениеВнутр(Тип("Строка"), УзелКодОшибки.Значение);
				ОшибкаОбработки.КодОшибки = СокрЛП(ОшибкаОбработки.КодОшибки);
			КонецЕсли;
			
			УзелОписаниеОшибки = НайтиУзел(УзелОшибка, "errorDescription");
			Если УзелОписаниеОшибки <> Неопределено Тогда
				ОшибкаОбработки.ОписаниеОшибки = XMLЗначениеВнутр(Тип("Строка"), УзелОписаниеОшибки.Значение);
				ОшибкаОбработки.ОписаниеОшибки = СокрЛП(ОшибкаОбработки.ОписаниеОшибки);
			КонецЕсли;
			
			Результат.СообщенияОбОшибках = Результат.СообщенияОбОшибках
				+ ?(ЗначениеЗаполнено(Результат.СообщенияОбОшибках), Символы.ВК + Символы.ПС, "")
				+ ?(ЗначениеЗаполнено(ОшибкаОбработки.ОписаниеОшибки),
					СокрЛП(ОшибкаОбработки.ОписаниеОшибки) + ?(ЗначениеЗаполнено(ОшибкаОбработки.КодОшибки),
						" (" + ОшибкаОбработки.КодОшибки + ")", ""),
					?(ЗначениеЗаполнено(ОшибкаОбработки.КодОшибки), ОшибкаОбработки.КодОшибки,
						НСтр("ru = 'Сбой формирования информации об ошибках';
							|en = 'Error report generation failure'")));
			
			Результат.ОшибкиПервичнойОбработки.Добавить(ОшибкаОбработки);
			Если Лев(ОшибкаОбработки.КодОшибки, 4) = "WARN" Тогда
				Результат.ПредупрежденияПервичнойОбработки.Добавить(ОшибкаОбработки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	УзелПротоколОбработки = НайтиУзел(УзелОтвета, "protocol");
	Если УзелПротоколОбработки <> Неопределено Тогда
		УзелПереченьПроблем = НайтиУзел(УзелПротоколОбработки, "failedList");
		Если УзелПереченьПроблем <> Неопределено Тогда
			УзлыДеталиЗаписи = НайтиУзел(УзелПереченьПроблем, "failedBatchNoDetail", Истина);
			Для каждого УзелДеталиЗаписи Из УзлыДеталиЗаписи Цикл
				РезультатОбработки = Новый Структура;
				РезультатОбработки.Вставить("НомерЗаписи", 		"");
				РезультатОбработки.Вставить("ОшибкиОбработки", 	Новый Массив);
				
				УзелНомерЗаписи = НайтиУзел(УзелДеталиЗаписи, "batchNo");
				Если УзелНомерЗаписи <> Неопределено Тогда
					РезультатОбработки.НомерЗаписи = XMLЗначениеВнутр(Тип("Строка"), УзелНомерЗаписи.Значение);
					РезультатОбработки.НомерЗаписи = СокрЛП(РезультатОбработки.НомерЗаписи);
				КонецЕсли;
				ИндексЗаписи = НомераЗаписейВыгрузки.Найти(РезультатОбработки.НомерЗаписи);
				Если ИндексЗаписи <> Неопределено Тогда
					НомераЗаписейВыгрузки.Удалить(ИндексЗаписи);
				КонецЕсли;
				
				ЕстьОшибки = Ложь;
				ЕстьПредупреждения = Ложь;
				УзелСообщенияОбОшибках = НайтиУзел(УзелДеталиЗаписи, "errorList");
				Если УзелСообщенияОбОшибках <> Неопределено Тогда
					УзлыОшибка = НайтиУзел(УзелСообщенияОбОшибках, "error", Истина);
					Для каждого УзелОшибка Из УзлыОшибка Цикл
						ОшибкаОбработки = Новый Структура;
						ОшибкаОбработки.Вставить("КодОшибки", 		"");
						ОшибкаОбработки.Вставить("ОписаниеОшибки", 	"");
						
						УзелКодОшибки = НайтиУзел(УзелОшибка, "errorCode");
						Если УзелКодОшибки <> Неопределено Тогда
							ОшибкаОбработки.КодОшибки = XMLЗначениеВнутр(Тип("Строка"), УзелКодОшибки.Значение);
							ОшибкаОбработки.КодОшибки = СокрЛП(ОшибкаОбработки.КодОшибки);
						КонецЕсли;
						Если Лев(ОшибкаОбработки.КодОшибки, 4) = "WARN" Тогда
							ЕстьПредупреждения = Истина;
						Иначе
							ЕстьОшибки = Истина;
						КонецЕсли;
						
						УзелОписаниеОшибки = НайтиУзел(УзелОшибка, "errorDescription");
						Если УзелОписаниеОшибки <> Неопределено Тогда
							ОшибкаОбработки.ОписаниеОшибки = XMLЗначениеВнутр(Тип("Строка"), УзелОписаниеОшибки.Значение);
							ОшибкаОбработки.ОписаниеОшибки = СокрЛП(ОшибкаОбработки.ОписаниеОшибки);
						КонецЕсли;
						
						РезультатОбработки.ОшибкиОбработки.Добавить(ОшибкаОбработки);
					КонецЦикла;
				КонецЕсли;
				
				Результат.ПротоколОбработки.Добавить(РезультатОбработки);
				
				Если ЕстьОшибки Тогда
					Результат.НомераНеПринятыхЗаписей.Добавить(РезультатОбработки.НомерЗаписи);
				ИначеЕсли ЕстьПредупреждения Тогда
					Результат.НомераСданныхЗаписей.Добавить(РезультатОбработки.НомерЗаписи);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Для каждого НомерЗаписиВыгрузки Из НомераЗаписейВыгрузки Цикл
		Результат.НомераСданныхЗаписей.Добавить(НомерЗаписиВыгрузки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтатусОтправкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(РезультатыОперации)
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусОтправки", 	Неопределено);
	Результат.Вставить("ЦветСтатуса", 		Неопределено);
	Результат.Вставить("СтатусОтчета", 		"");
	
	ОтправкаЧерезСЭДО = (ТипЗнч(РезультатыОперации.СтатусОбработки) = Тип("Строка"));
	
	Если РезультатыОперации.СтатусОбработки = 2 ИЛИ РезультатыОперации.СтатусОбработки = 1
		ИЛИ ОтправкаЧерезСЭДО И РезультатыОперации.СтатусОбработки = "REGISTERED" Тогда
		
		Если РезультатыОперации.НомераНеПринятыхЗаписей.Количество() > 0 Тогда
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.ПринятЕстьОшибки;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			Результат.СтатусОтчета 		= НСтр("ru = 'Сдан, обнаружены ошибки';
													|en = 'Delivered, errors found'");
			
		Иначе
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.Сдан;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветПоложительногоПротокола;
			Результат.СтатусОтчета 		= НСтр("ru = 'Сдан, ошибок не обнаружено';
													|en = 'Submitted, no errors detected'");
		КонецЕсли;
		
	Иначе // РезультатыОперации.СтатусОбработки = 0
		Если РезультатыОперации.ОшибкиПервичнойОбработки.Количество() =
			РезультатыОперации.ПредупрежденияПервичнойОбработки.Количество()
			И (РезультатыОперации.НомераСданныхЗаписей.Количество() > 0 ИЛИ ОтправкаЧерезСЭДО) Тогда
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.ПринятЕстьОшибки;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			Результат.СтатусОтчета 		= НСтр("ru = 'Сдан, обнаружены ошибки';
													|en = 'Delivered, errors found'");
			
		Иначе
			СтатусОтчета = ?(ОтправкаЧерезСЭДО, НСтр("ru = 'Не принят или сдан частично, обнаружены ошибки';
													|en = 'Not received, errors are detected'"),
				НСтр("ru = 'Не принят, обнаружены ошибки';
					|en = 'Not received, errors are detected'"));
			
			Результат.СтатусОтправки 	= Перечисления.СтатусыОтправки.НеПринят;
			Результат.ЦветСтатуса 		= ЦветаСтиля.ЦветОшибкиВПротоколеБРО;
			Результат.СтатусОтчета 		= СтатусОтчета;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГенерироватьHTMLПротоколаОбработкиРеестраСтимулирующихВыплатМедицинскимИСоциальнымРаботникам(
		ОтчетСсылка,
		ОрганизацияСсылка,
		РезультатыОперации,
		СтатусОперации)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Шаблон = ПолучитьМакет("ФСССтимулирующиеВыплатыШаблонДляHTML");
	
	СекцияШапка = Шаблон.ПолучитьОбласть("Шапка");
	
	НаименованиеПротокола = ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.Сдан,
		НСтр("ru = 'Протокол о сдаче';
			|en = 'Delivery protocol'"), ?(СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят,
		НСтр("ru = 'Протокол ошибок';
			|en = 'Error log'"), НСтр("ru = 'Протокол о частичной сдаче';
											|en = 'Partial delivery record'")));
	
	СвойстваОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
		ОрганизацияСсылка,,
		"НаимЮЛПол, ИННЮЛ");
	ПолноеНаименованиеОрганизации 	= СвойстваОрганизации.НаимЮЛПол;
	ИННОрганизации 					= СвойстваОрганизации.ИННЮЛ;
	
	СведенияПоОбъекту = СведенияПоОтправляемымОбъектам(ОтчетСсылка);
	
	ОтправкаЧерезСЭДО = (ТипЗнч(РезультатыОперации.СтатусОбработки) = Тип("Строка"));
	
	Если СтатусОперации.СтатусОтправки = Перечисления.СтатусыОтправки.ПринятЕстьОшибки Тогда
		СтатусОбработкиТекстом =
			НСтр("ru = 'Реестр загружен частично. Отправьте повторно только записи с ошибками, исправив ошибки';
				|en = 'The registry is partially loaded. Resubmit only entries with errors after correcting the errors'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = 2 ИЛИ РезультатыОперации.СтатусОбработки = 1
		ИЛИ ОтправкаЧерезСЭДО И РезультатыОперации.СтатусОбработки = "REGISTERED" Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Реестр успешно загружен';
										|en = 'Registry successfully imported'");
	ИначеЕсли РезультатыОперации.СтатусОбработки = 0 Тогда
		СтатусОбработкиТекстом = НСтр("ru = 'Реестр не загружен';
										|en = 'Registry is not imported'");
	ИначеЕсли ОтправкаЧерезСЭДО Тогда
		СтатусОбработкиТекстом =
			НСтр("ru = 'Реестр не загружен или загружен частично. Отправьте повторно только записи с ошибками, исправив ошибки';
				|en = 'The registry is not imported or partially imported. Resubmit only records with errors after correcting the errors'");
	Иначе
		СтатусОбработкиТекстом = Строка(РезультатыОперации.СтатусОбработки);
	КонецЕсли;
	
	СекцияШапка.Параметры.НаименованиеПротокола 	= НаименованиеПротокола;
	СекцияШапка.Параметры.Организация 				= ПолноеНаименованиеОрганизации;
	СекцияШапка.Параметры.ИНН 						= НСтр("ru = 'ИНН';
															|en = 'TIN'") + " " + ИННОрганизации;
	СекцияШапка.Параметры.Получатель 				= СведенияПоОбъекту.ПредставлениеКонтролирующегоОргана;
	СекцияШапка.Параметры.Отчет 					= СведенияПоОбъекту.Наименование;
	СекцияШапка.Параметры.СтатусОтчета 				= СтатусОперации.СтатусОтчета;
	СекцияШапка.Области.СтатусОтчета.ЦветТекста 	= СтатусОперации.ЦветСтатуса;
	СекцияШапка.Параметры.ИдентификаторОтправки 	= РезультатыОперации.ИдентификаторОтправки;
	СекцияШапка.Параметры.СтатусОбработки 			= СтатусОбработкиТекстом;
	СекцияШапка.Параметры.ДатаПротокола 			= Формат(РезультатыОперации.ДатаВремяОбработки, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'");
	
	ТабДок.Вывести(СекцияШапка);
	
	Если ЗначениеЗаполнено(РезультатыОперации.СообщенияОбОшибках) Тогда
		СекцияПротоколОшибок = Шаблон.ПолучитьОбласть("ПротоколОшибокПервичнойПроверки");
		СекцияПротоколОшибок.Параметры.СообщенияОбОшибках = РезультатыОперации.СообщенияОбОшибках;
		ТабДок.Вывести(СекцияПротоколОшибок);
	КонецЕсли;
	
	Если РезультатыОперации.ПротоколОбработки.Количество() > 0 Тогда
		СекцияРезультатыОбработки = Шаблон.ПолучитьОбласть("РезультатыОбработки");
		ТабДок.Вывести(СекцияРезультатыОбработки);
		
		Для ИндексРезультата = 0 По РезультатыОперации.ПротоколОбработки.Количество() - 1 Цикл
			РезультатОбработки = РезультатыОперации.ПротоколОбработки[ИндексРезультата];
			
			СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.ПротоколОбработки.Количество() - 1
				И РезультатОбработки.ОшибкиОбработки.Количество() <= 1, 2,
				?(РезультатОбработки.ОшибкиОбработки.Количество() > 1, 0, 1)),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
			
			ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху;
			ЛинияГраницыСверху = Новый Линия(
				ЛинияГраницыСверху.ТипЛинии,
				?(ИндексРезультата = 0, 2, 1),
				ЛинияГраницыСверху.Отступ);
			ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу;
			ЛинияГраницыСнизу = Новый Линия(
				ЛинияГраницыСнизу.ТипЛинии,
				?(ИндексРезультата = РезультатыОперации.ПротоколОбработки.Количество() - 1
				И РезультатОбработки.ОшибкиОбработки.Количество() <= 1, 2, 1),
				ЛинияГраницыСнизу.Отступ);
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху = ЛинияГраницыСверху;
			СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу = ЛинияГраницыСнизу;
			
			
			КодПервойОшибки = ?(РезультатОбработки.ОшибкиОбработки.Количество() > 0,
				РезультатОбработки.ОшибкиОбработки[0].КодОшибки, "");
			ОписаниеПервойОшибки = ?(РезультатОбработки.ОшибкиОбработки.Количество() > 0,
				РезультатОбработки.ОшибкиОбработки[0].ОписаниеОшибки, "");
			
			СекцияСтрокаРезультатов.Параметры.НомерЗаписи 		= РезультатОбработки.НомерЗаписи;
			СекцияСтрокаРезультатов.Параметры.КодОшибки 		= КодПервойОшибки;
			СекцияСтрокаРезультатов.Параметры.ОписаниеОшибки 	= ОписаниеПервойОшибки;
			
			ТабДок.Вывести(СекцияСтрокаРезультатов);
			
			Для ИндексОшибки = 1 По РезультатОбработки.ОшибкиОбработки.Количество() - 1 Цикл
				ОшибкаОбработки = РезультатОбработки.ОшибкиОбработки[ИндексОшибки];
				
				СекцияСтрокаРезультатов = Шаблон.ПолучитьОбласть("СтрокаРезультатов");
				ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху;
				ЛинияГраницыСверху = Новый Линия(
					ЛинияГраницыСверху.ТипЛинии,
					0,
					ЛинияГраницыСверху.Отступ);
				ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу;
				ЛинияГраницыСнизу = Новый Линия(
					ЛинияГраницыСнизу.ТипЛинии,
					?(ИндексОшибки = РезультатОбработки.ОшибкиОбработки.Количество() - 1,
					?(ИндексРезультата = РезультатыОперации.ПротоколОбработки.Количество() - 1, 2, 1), 0),
					ЛинияГраницыСнизу.Отступ);
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСверху = ЛинияГраницыСверху;
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатов.ГраницаСнизу = ЛинияГраницыСнизу;
				
				ЛинияГраницыСверху = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху;
				ЛинияГраницыСверху = Новый Линия(
					ЛинияГраницыСверху.ТипЛинии,
					0,
					ЛинияГраницыСверху.Отступ);
				ЛинияГраницыСнизу = СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу;
				ЛинияГраницыСнизу = Новый Линия(
					ЛинияГраницыСнизу.ТипЛинии,
					?(ИндексРезультата = РезультатыОперации.ПротоколОбработки.Количество() - 1
					И ИндексОшибки = РезультатОбработки.ОшибкиОбработки.Количество() - 1, 2, 1),
					ЛинияГраницыСнизу.Отступ);
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСверху = ЛинияГраницыСверху;
				СекцияСтрокаРезультатов.Области.ПоляСтрокиРезультатовКолонкиОшибки.ГраницаСнизу = ЛинияГраницыСнизу;
				
				СекцияСтрокаРезультатов.Параметры.НомерЗаписи 		= "";
				СекцияСтрокаРезультатов.Параметры.КодОшибки 		= ОшибкаОбработки.КодОшибки;
				СекцияСтрокаРезультатов.Параметры.ОписаниеОшибки 	= ОшибкаОбработки.ОписаниеОшибки;
				
				ТабДок.Вывести(СекцияСтрокаРезультатов);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	СекцияПодвал = Шаблон.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(СекцияПодвал);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	ТекстHTML = Новый ТекстовыйДокумент;
	ТекстHTML.Прочитать(ИмяВременногоФайла);
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	Возврат ТекстHTML;
	
КонецФункции

#КонецОбласти

#Область ОбменСКонтролирующимиОрганами

Процедура ВыполнитьОбмен(УчетнаяЗапись) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	АвторасшифровкаДоступна = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ДоступнаАвторасшифровкаТранспортныхСообщений(УчетнаяЗапись);
	
	Если АвторасшифровкаДоступна Тогда
		// Подготовим список ошибок текущей итерации обмена.
		ИнициализироватьСохранениеОшибокОбмена(УчетнаяЗапись);
	КонецЕсли;
	
	ПолучитьСообщения(УчетнаяЗапись, АвторасшифровкаДоступна);
	
	ОтправитьСообщения(УчетнаяЗапись);
	
	Если АвторасшифровкаДоступна Тогда
		// Сохраним возникшие в процессе обмена ошибки.
		СохранитьОшибкиОбмена(УчетнаяЗапись);
	КонецЕсли;
	
	ПолучитьУведомленияРПН(УчетнаяЗапись, Ложь);
	
КонецПроцедуры

Функция ПолучитьСообщения(УчетнаяЗапись, АвторасшифровкаДоступна = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПочтовыеСообщения = ПолучитьПочтовыеСообщения(УчетнаяЗапись);
	
	ПолученныеТранспортныеСообщения = СоздатьТранспортныеСообщения(УчетнаяЗапись, ПочтовыеСообщения);
	
	РаспознатьТранспортныеСообщения(УчетнаяЗапись, АвторасшифровкаДоступна);
	
	Возврат ПолученныеТранспортныеСообщения;
	
КонецФункции

Процедура ОтправитьСообщения(УчетнаяЗапись) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СообщенияДляОтправки = ПолучитьСообщенияДляОтправки(УчетнаяЗапись);
	
	ПараметрыПодключения = 
	ПолучитьПараметрыПодключенияПоУчетнойЗаписи(УчетнаяЗапись);
	Соединение = ДокументооборотСКО.ОткрытьСоединениеДляОтправкиПочты(ПараметрыПодключения);
	
	Для Каждого СообщениеДляОтправки Из СообщенияДляОтправки Цикл
		ОтправитьТранспортноеСообщение(СообщениеДляОтправки, Соединение);
	КонецЦикла;
	
	ДокументооборотСКО.ЗакрытьПочтовоеСоединение(Соединение);
	
КонецПроцедуры

Процедура РаспознатьТранспортныеСообщения(УчетнаяЗапись, АвторасшифровкаДоступна)

	Выборка = ПолучитьТранспортныеСообщенияДляРаспознавания();
	
	Пока Выборка.Следующий() Цикл
		
		Ссылка = Выборка.Ссылка;
		Если НЕ Ссылка.ПометкаУдаления
			И Ссылка.Тип = Перечисления.ТипыТранспортныхСообщений.ПустаяСсылка() Тогда
		
			РаспознатьТранспортноеСообщение(Выборка.Ссылка, Истина);
			Если АвторасшифровкаДоступна Тогда
				РасшифроватьТранспортноеСообщение(Выборка.Ссылка);
			КонецЕсли;
			ОбновитьСтатусыСвязанногоОбъектаПриНеобходимости(Выборка.Ссылка, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТранспортныеСообщенияДляРаспознавания()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортноеСообщение.Ссылка
	|ИЗ
	|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
	|ГДЕ
	|	НЕ ТранспортноеСообщение.ПометкаУдаления
	|	И ТранспортноеСообщение.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПисем.Полученное)
	|	И ТранспортноеСообщение.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПустаяСсылка)";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ПолучитьПараметрыПодключенияПоУчетнойЗаписи(УчетнаяЗапись)
	
	ПараметрыПодключения = Новый Структура;
	
	Поля = "ИмяПользователяPOP3, ИмяПользователяSMTP, ПарольPOP3, ПарольSMTP, ПортPOP3,
			|ПортSMTP, СерверPOP3, СерверSMTP, ТребуетсяSMTPАутентификация, 
			|СерверДокументооборота.ДлительностьОжиданияСервера";
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, Поля);
	
	ПараметрыPOP3 = Новый Структура;
	ПараметрыPOP3.Вставить("Сервер", ЗначенияРеквизитов.СерверPOP3);
	ПараметрыPOP3.Вставить("Пользователь", ЗначенияРеквизитов.ИмяПользователяPOP3);
	ПараметрыPOP3.Вставить("Пароль", ЗначенияРеквизитов.ПарольPOP3);
	ПараметрыPOP3.Вставить("Порт", ЗначенияРеквизитов.ПортPOP3);
	ВариантАутентификации = СпособPOP3Аутентификации.Обычная;
	ПараметрыPOP3.Вставить("СпособАутентификации", ВариантАутентификации);
	
	ПараметрыSMTP = Новый Структура;
	ПараметрыSMTP.Вставить("Сервер", ЗначенияРеквизитов.СерверSMTP);
	ПараметрыSMTP.Вставить("Пользователь", ЗначенияРеквизитов.ИмяПользователяSMTP);
	ПараметрыSMTP.Вставить("Пароль", ЗначенияРеквизитов.ПарольSMTP);
	ПараметрыSMTP.Вставить("Порт", ЗначенияРеквизитов.ПортSMTP);
	ВариантАутентификации = ?(ЗначенияРеквизитов.ТребуетсяSMTPАутентификация, СпособSMTPАутентификации.Login, СпособSMTPАутентификации.БезАутентификации);
	ПараметрыSMTP.Вставить("СпособАутентификации", ВариантАутентификации);
	
	ПараметрыПодключения.Вставить("POP3", ПараметрыPOP3);
	ПараметрыПодключения.Вставить("SMTP", ПараметрыSMTP);
	
	ПараметрыПодключения.Вставить("Таймаут", ЗначенияРеквизитов.СерверДокументооборотаДлительностьОжиданияСервера);

	Возврат ПараметрыПодключения;
	
КонецФункции

Функция ПолучитьПочтовыеСообщения(УчетнаяЗапись)
	
	ПараметрыПодключения = ПолучитьПараметрыПодключенияПоУчетнойЗаписи(УчетнаяЗапись);
	Соединение = ДокументооборотСКО.ОткрытьСоединениеДляПолученияПочты(ПараметрыПодключения);	
	
	ЗаголовкиПочтовыхСообщений = Соединение.ПолучитьЗаголовки();
	
	ПочтовыеСообщения = Новый Массив;
	СообщенияДляПолучения = ОтобратьПочтовыеСообщения(УчетнаяЗапись, ЗаголовкиПочтовыхСообщений, Ложь);
	Если ЗначениеЗаполнено(СообщенияДляПолучения) Тогда
		ПочтовыеСообщения = Соединение.Выбрать(Ложь, СообщенияДляПолучения);
	КонецЕсли;
	
	// Сообщения по завершенным циклам обмена считаем более не нужными и удаляем с сервера.
	СообщенияДляУдаления = ОтобратьПочтовыеСообщения(УчетнаяЗапись, ЗаголовкиПочтовыхСообщений, Истина);	
	Если ЗначениеЗаполнено(СообщенияДляУдаления) Тогда
		Соединение.УдалитьСообщения(СообщенияДляУдаления);
	КонецЕсли;
	
	ДокументооборотСКО.ЗакрытьПочтовоеСоединение(Соединение);
	
	Возврат ПочтовыеСообщения;
	
КонецФункции

Функция ОтобратьПочтовыеСообщения(УчетнаяЗапись, ЗаголовкиСообщений, ДляУдаления)
	
	ИдентификаторыПолученныхСообщений = Новый ТаблицаЗначений;
	ИдентификаторыПолученныхСообщений.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(255)));
	Для Каждого ЗаголовокСообщения Из ЗаголовкиСообщений Цикл
		НоваяСтрока = ИдентификаторыПолученныхСообщений.Добавить();
		НоваяСтрока.Идентификатор = ЗаголовокСообщения.ИдентификаторСообщения;
	КонецЦикла;
	
	Если ДляУдаления Тогда
		ИдентификаторыСообщений = ПолучитьИдентификаторыСообщенийДляУдаления(УчетнаяЗапись, ИдентификаторыПолученныхСообщений);
	Иначе
		ИдентификаторыСообщений = ПолучитьИдентификаторыСообщенийДляПолучения(УчетнаяЗапись, ИдентификаторыПолученныхСообщений);
	КонецЕсли;
	
	ОтобранныеСообщения = Новый Массив;
	Если ЗначениеЗаполнено(ИдентификаторыСообщений) Тогда
		Для Каждого ЗаголовокСообщения Из ЗаголовкиСообщений Цикл
			Если ИдентификаторыСообщений.Найти(ЗаголовокСообщения.ИдентификаторСообщения) <> Неопределено Тогда
				ОтобранныеСообщения.Добавить(ЗаголовокСообщения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ОтобранныеСообщения;
	
КонецФункции

Функция ПолучитьИдентификаторыСообщенийДляПолучения(УчетнаяЗапись, ИдентификаторыПолученныхСообщений)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторыПолученныхСообщений.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ИдентификаторыПолученныхСообщений
	|ИЗ
	|	&ИдентификаторыПолученныхСообщений КАК ИдентификаторыПолученныхСообщений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортноеСообщение.Ссылка,
	|	ТранспортноеСообщение.ИдентификаторСообщения
	|ПОМЕСТИТЬ ТранспортныеСообщенияПоУчетнойЗаписи
	|ИЗ
	|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
	|ГДЕ
	|	ТранспортноеСообщение.УчетнаяЗапись = &УчетнаяЗапись
	|	И ТранспортноеСообщение.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПисем.Полученное)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИдентификаторыПолученныхСообщений.Идентификатор КАК ИдентификаторСообщения,
	|	ТранспортныеСообщенияПоУчетнойЗаписи.Ссылка
	|ИЗ
	|	ИдентификаторыПолученныхСообщений КАК ИдентификаторыПолученныхСообщений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТранспортныеСообщенияПоУчетнойЗаписи КАК ТранспортныеСообщенияПоУчетнойЗаписи
	|		ПО ИдентификаторыПолученныхСообщений.Идентификатор = ТранспортныеСообщенияПоУчетнойЗаписи.ИдентификаторСообщения";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ИдентификаторыПолученныхСообщений", ИдентификаторыПолученныхСообщений);
	
	ИдентификаторыСообщений = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			ИдентификаторыСообщений.Добавить(Выборка.ИдентификаторСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИдентификаторыСообщений;

КонецФункции

Функция ПолучитьИдентификаторыСообщенийДляУдаления(УчетнаяЗапись, ИдентификаторыПолученныхСообщений)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторыПолученныхСообщений.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ИдентификаторыПолученныхСообщений
	|ИЗ
	|	&ИдентификаторыПолученныхСообщений КАК ИдентификаторыПолученныхСообщений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТранспортноеСообщение.Ссылка,
	|	ТранспортноеСообщение.ИдентификаторСообщения
	|ПОМЕСТИТЬ ТранспортныеСообщенияПоУчетнойЗаписи
	|ИЗ
	|	Документ.ТранспортноеСообщение КАК ТранспортноеСообщение
	|ГДЕ
	|	ТранспортноеСообщение.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПисем.Полученное)
	|	И ТранспортноеСообщение.ЦиклОбмена <> ЗНАЧЕНИЕ(Справочник.ЦиклыОбмена.ПустаяСсылка)
	|	И ТранспортноеСообщение.ЦиклОбмена.ДатаЗакрытия <> ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	|	И ТранспортноеСообщение.ЦиклОбмена.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТранспортноеСообщение.УчетнаяЗапись = &УчетнаяЗапись
	|	И (НЕ ТранспортноеСообщение.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПисьмоВходящееПФР), ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС), ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПисьмоНО), ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ДокументНО))
	|			ИЛИ ТранспортноеСообщение.УчетнаяЗапись.СпецоператорСвязи = ЗНАЧЕНИЕ(Перечисление.СпецоператорыСвязи.Прочие))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИдентификаторыПолученныхСообщений.Идентификатор КАК ИдентификаторСообщения,
	|	ТранспортныеСообщенияПоУчетнойЗаписи.Ссылка
	|ИЗ
	|	ИдентификаторыПолученныхСообщений КАК ИдентификаторыПолученныхСообщений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТранспортныеСообщенияПоУчетнойЗаписи КАК ТранспортныеСообщенияПоУчетнойЗаписи
	|		ПО ИдентификаторыПолученныхСообщений.Идентификатор = ТранспортныеСообщенияПоУчетнойЗаписи.ИдентификаторСообщения";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ИдентификаторыПолученныхСообщений", ИдентификаторыПолученныхСообщений);
	
	ИдентификаторыСообщений = Новый Массив;
	ИдентификаторыСообщений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");
	
	Возврат ИдентификаторыСообщений;

КонецФункции

Функция СоздатьТранспортныеСообщения(УчетнаяЗапись, ПочтовыеСообщения)
	
	ПолученныеСообщения = Новый Массив;
	Для Каждого ПочтовоеСообщение Из ПочтовыеСообщения Цикл
		ПолученныеСообщения.Добавить(ЗаполнитьТранспортноеСообщение(УчетнаяЗапись, ПочтовоеСообщение));
	КонецЦикла;
	
	ЗаполнитьСвойстваТранспортныхСообщений(ПолученныеСообщения);
	
	Возврат ПолученныеСообщения;
	
КонецФункции

Функция ЗаполнитьТранспортноеСообщение(УчетнаяЗапись, ПочтовоеСообщение)

	НачатьТранзакцию();
	Попытка
		ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
		
		ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись; 
		
		ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Полученное;
		ТранспортноеСообщение.Тема = ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(СокрЛП(ПочтовоеСообщение.Тема));
		ТранспортноеСообщение.ИдентификаторСообщения = ПочтовоеСообщение.ИдентификаторСообщения;
		ТранспортноеСообщение.ДатаТранспорта = ПочтовоеСообщение.ДатаПолучения;
		ТранспортноеСообщение.Дата = ПочтовоеСообщение.ДатаОтправления;
		ТранспортноеСообщение.Кодировка = ПочтовоеСообщение.Кодировка;
		
		ТранспортноеСообщение.ОтКогоАдрес = ПочтовоеСообщение.Отправитель.Адрес;
		ТранспортноеСообщение.ОтКогоПредставление = ПочтовоеСообщение.Отправитель.ОтображаемоеИмя;
		
		
		ЗаполнитьАдресатов(ТранспортноеСообщение.Кому, ПочтовоеСообщение.Получатели);
		ЗаполнитьАдресатов(ТранспортноеСообщение.Копии, ПочтовоеСообщение.Копии);
		ЗаполнитьТекстПисьма(ТранспортноеСообщение, ПочтовоеСообщение);
		ЗаполнитьДополнительныеРеквизитыЗаголовка(ТранспортноеСообщение, ПочтовоеСообщение);
		
		Ссылка = Документы.ТранспортноеСообщение.ПолучитьСсылку();
		ТранспортноеСообщение.УстановитьСсылкуНового(Ссылка);
		
		ТранспортноеСообщение.Записать();
		
		РазобратьВложения(Ссылка, ПочтовоеСообщение);
		
		ЗафиксироватьТранзакцию(); 
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Транспортное сообщение';
				|en = 'Electronic data interchange with regulatory authorities. Transport message'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ТранспортноеСообщение.Ссылка;

КонецФункции

Процедура ЗаполнитьАдресатов(Приемник, Источник)
	
	Для Каждого Адресат Из Источник Цикл
		НоваяСтрока = Приемник.Добавить();
		НоваяСтрока.АдресЭлектроннойПочты = Адресат.Адрес;
		НоваяСтрока.Представление = Адресат.ОтображаемоеИмя;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТекстПисьма(ТранспортноеСообщение, Сообщение)
	
	Для Каждого ТекстПисьма Из Сообщение.Тексты Цикл
		Если ЗначениеЗаполнено(ТекстПисьма.Текст) Тогда
			ТранспортноеСообщение.ТекстПисьма = ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(ТекстПисьма.Текст);
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеРеквизитыЗаголовка(ТранспортноеСообщение, Сообщение)
	
	ТипыДополнительныхРеквизитов = Новый Соответствие;
	ТипыДополнительныхРеквизитов.Вставить("X-Tax-System", Перечисления.ТипыДополнительныхРеквизитов.ИмяПередающейСистемы);
	ТипыДополнительныхРеквизитов.Вставить("X-Tax-Type", Перечисления.ТипыДополнительныхРеквизитов.ТипПередаваемойИнформации);
	ТипыДополнительныхРеквизитов.Вставить("X-Tax-Reciever", Перечисления.ТипыДополнительныхРеквизитов.ИдентификаторПолучателя);
	ТипыДополнительныхРеквизитов.Вставить("X-Tax-Sender", Перечисления.ТипыДополнительныхРеквизитов.ИдентификаторОтправителя);
	ТипыДополнительныхРеквизитов.Вставить("X-Message-ID", Перечисления.ТипыДополнительныхРеквизитов.ИдентификаторПервичногоСообщения);
	ТипыДополнительныхРеквизитов.Вставить("X-PFR-Message-ID", "X-PFR-Message-ID");
	
	Для Каждого ТипРеквизита Из ТипыДополнительныхРеквизитов Цикл
		ПолеЗаголовка = Сообщение.ПолучитьПолеЗаголовка(ТипРеквизита.Ключ, "");
		Если ЗначениеЗаполнено(ПолеЗаголовка) Тогда 
			НоваяСтрока = ТранспортноеСообщение.ДополнительныеРеквизитыЗаголовка.Добавить();
			НоваяСтрока.Тип = ТипРеквизита.Значение;
			НоваяСтрока.Значение = ПолеЗаголовка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура РазобратьВложения(ТранспортноеСообщение, Сообщение)
	
	Для Каждого Вложение Из Сообщение.Вложения Цикл
		ДобавитьТранспортныйКонтейнерИзДвоичныхДанных(ТранспортноеСообщение, Вложение.Данные, Вложение.ИмяФайла);
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавитьТранспортныйКонтейнерИзДвоичныхДанных(ТранспортноеСообщение, Данные, ИмяФайла, Размер = Неопределено) Экспорт
	
	МакимальныйРазмерФрагмента = 700000000;
	
	ОбработанноеИмяФайла = ОбщегоНазначенияЭДКОКлиентСервер.ЗаменитьНечитаемыеСимволы(ИмяФайла);
	ДлинаИмениФайла = СтрДлина(ОбработанноеИмяФайла);
	
	НачатьТранзакцию();
	
	НовыйНаборЗаписей = РегистрыСведений.ТранспортныеКонтейнеры.СоздатьНаборЗаписей();
	НовыйНаборЗаписей.Отбор.ТранспортноеСообщение.Установить(ТранспортноеСообщение);
	НовыйНаборЗаписей.Отбор.ИмяФайла.Установить(ОбработанноеИмяФайла);
	
	НоваяЗапись = НовыйНаборЗаписей.Добавить();
	НоваяЗапись.ТранспортноеСообщение = ТранспортноеСообщение;
	НоваяЗапись.ИмяФайла = ОбработанноеИмяФайла;
	НоваяЗапись.Размер = Данные.Размер();
	
	КомпонентыИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ОбработанноеИмяФайла);
	РасширениеФайлаБезТочки = Сред(КомпонентыИмениФайла.Расширение, 2);
	
	НовыйНаборЗаписей.Записать(Истина);
	
	Если Данные.Размер() >= МакимальныйРазмерФрагмента Тогда
		МассивДанных = РазделитьДвоичныеДанные(Данные, МакимальныйРазмерФрагмента);
	Иначе
		МассивДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные);
	КонецЕсли;
	
	Если МассивДанных.Количество() = 1 Тогда
		// сначала пробуем загрузить первые два присоединенные файла фрагмента без более тяжелого запроса с "ПОДОБНО",
		// так как обычно файл один, разделение на фрагменты не используется
		МассивИменФайлов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбработанноеИмяФайла);
		МассивИменФайлов.Добавить(ОбработанноеИмяФайла + "1");
		
		ТаблицаФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортноеСообщение,
			"ТранспортноеСообщениеКонтейнерыПрисоединенныеФайлы",
			МассивИменФайлов,
			"ИсходноеИмяФайла");
	КонецЕсли;
	
	Если МассивДанных.Количество() <> 1 ИЛИ ТаблицаФайлов.Количество() > 1 Тогда
		// если присоединенных файлов несколько, то получаем все запросом с "ПОДОБНО"
		ТаблицаФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
			ТранспортноеСообщение,
			"ТранспортноеСообщениеКонтейнерыПрисоединенныеФайлы",
			ОбработанноеИмяФайла,
			"ИсходноеИмяФайла",,
			Истина);
	КонецЕсли;
	
	// обновление существующих присоединенных файлов
	Для каждого СтрокаТаблицы Из ТаблицаФайлов Цикл
		// имя файла фрагмента дополняется индексом, кроме нулевого
		Если СтрДлина(СтрокаТаблицы.ИсходноеИмяФайла) > ДлинаИмениФайла Тогда
			ИндексФайлаСтрокой = Сред(СтрокаТаблицы.ИсходноеИмяФайла, ДлинаИмениФайла + 1);
			ОписаниеТипа = Новый ОписаниеТипов("Число");
			ИндексФайла = ОписаниеТипа.ПривестиЗначение(ИндексФайлаСтрокой);
		Иначе
			ИндексФайлаСтрокой = "";
			ИндексФайла = 0;
		КонецЕсли;
		
		ПрисоединенныйФайл = СтрокаТаблицы.Ссылка;
		
		Если ИндексФайла >= МассивДанных.Количество() Тогда
			ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
			ПрисоединенныйФайлОбъект.УстановитьПометкуУдаления(Истина);
			
		Иначе
			АдресФайла = ПоместитьВоВременноеХранилище(МассивДанных[ИндексФайла], Новый УникальныйИдентификатор);
			УникальноеИмяФайлаБезРасширения = ОбщегоНазначенияЭДКОКлиентСервер.УникальнаяСтрока(
				КомпонентыИмениФайла.ИмяБезРасширения + ИндексФайлаСтрокой, 150);
			
			ИнформацияОбОбновляемомФайле = Новый Структура;
			ИнформацияОбОбновляемомФайле.Вставить("АдресФайлаВоВременномХранилище", АдресФайла);
			ИнформацияОбОбновляемомФайле.Вставить("АдресВременногоХранилищаТекста", Неопределено);
			ИнформацияОбОбновляемомФайле.Вставить("ИмяБезРасширения", 				УникальноеИмяФайлаБезРасширения);
			ИнформацияОбОбновляемомФайле.Вставить("Расширение", 					РасширениеФайлаБезТочки);
			
			РаботаСФайлами.ОбновитьФайл(ПрисоединенныйФайл, ИнформацияОбОбновляемомФайле);
			
			ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
			ПрисоединенныйФайлОбъект.ИсходноеИмяФайла = СтрокаТаблицы.ИсходноеИмяФайла;
			ПрисоединенныйФайлОбъект.Записать();
			
			УдалитьИзВременногоХранилища(АдресФайла);
			
			МассивДанных[ИндексФайла] = Неопределено; // присоединенный файл с этим индексом добавлять не нужно
		КонецЕсли;
	КонецЦикла;
	
	// добавление новых присоединенных файлов
	ИндексФайла = 0;
	Для ИндексФайла = 0 По МассивДанных.Количество() - 1 Цикл
		Если МассивДанных[ИндексФайла] <> Неопределено Тогда
			ИндексФайлаСтрокой = ?(ИндексФайла = 0, "", Формат(ИндексФайла, "ЧДЦ=; ЧН=; ЧГ="));
			АдресФайла = ПоместитьВоВременноеХранилище(МассивДанных[ИндексФайла], Новый УникальныйИдентификатор);
			УникальноеИмяФайлаБезРасширения = ОбщегоНазначенияЭДКОКлиентСервер.УникальнаяСтрока(
				КомпонентыИмениФайла.ИмяБезРасширения + ИндексФайлаСтрокой, 150);
			
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("Автор", 						Неопределено);
			ПараметрыФайла.Вставить("ВладелецФайлов", 				ТранспортноеСообщение);
			ПараметрыФайла.Вставить("ИмяБезРасширения", 			УникальноеИмяФайлаБезРасширения);
			ПараметрыФайла.Вставить("РасширениеБезТочки", 			РасширениеФайлаБезТочки);
			ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", 	Неопределено);
			
			НоваяСсылкаНаФайл = РаботаСФайлами.НоваяСсылкаНаФайл(ТранспортноеСообщение,
				"ТранспортноеСообщениеКонтейнерыПрисоединенныеФайлы");
			ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайла,,, НоваяСсылкаНаФайл);
			
			ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
			ПрисоединенныйФайлОбъект.ИсходноеИмяФайла = ОбработанноеИмяФайла + ИндексФайлаСтрокой;
			ПрисоединенныйФайлОбъект.Записать();
			
			УдалитьИзВременногоХранилища(АдресФайла);
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецФункции

Функция ИменаПользователейИБКоторымРазрещенаРаботаСУчетнойЗаписью(УчетнаяЗапись)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПользователиУчетныхЗаписейДокументооборота.Пользователь.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
	|ИЗ
	|	РегистрСведений.ПользователиУчетныхЗаписейДокументооборота КАК ПользователиУчетныхЗаписейДокументооборота
	|ГДЕ
	|	ПользователиУчетныхЗаписейДокументооборота.УчетнаяЗапись = &УчетнаяЗапись";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.ИдентификаторПользователяИБ) Тогда
			Продолжить;
		КонецЕсли;
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Выборка.ИдентификаторПользователяИБ);
		Если ПользовательИБ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(ПользовательИБ.Имя);
	
	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Процедура ИнициализироватьСохранениеОшибокОбмена(УчетнаяЗапись)

	ДлительнаяОтправкаКлиентСервер.ОчиститьПараметрыДлительнойОтправки();
	
	// Установим организацию из учетной записи  и идентификатор получателя сообщений об ошибках,
	// чтобы при последующих вызовах они накапливались в списке.
	ДлительнаяОтправкаКлиентСервер.ИзменитьПараметрыДлительнойОтправки("ТекущаяОрганизация", ОрганизацияУчетнойЗаписи(УчетнаяЗапись));
	
	ДлительнаяОтправкаКлиентСервер.ИзменитьПараметрыДлительнойОтправки("ИдентификаторПолучателя", Новый УникальныйИдентификатор());

КонецПроцедуры

Процедура СохранитьОшибкиОбмена(УчетнаяЗапись)

	Ошибки = ДлительнаяОтправкаКлиентСервер.ЗначениеПараметраДлительнойОтправки("Ошибки");
	
	// Определим список пользователей, которые могут работать с учетной записью, чтобы для них сохранять ошибки.
	ИменаПользователейИБ = ИменаПользователейИБКоторымРазрещенаРаботаСУчетнойЗаписью(УчетнаяЗапись);
	
	Если ИменаПользователейИБ.Количество() = 0 Тогда
		// В обычном случае сюда не должны попадать, т.к. нет пользователей, 
		// которым разрешено работать с учетной записью, некому показывать ошибки.
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Отсутствуют пользователи, которым разрешена работа с учетной записью %1';
										|en = 'No users who can use the %1 account'"), УчетнаяЗапись);
		ЗаписатьСобытиеВЖурнал(УровеньЖурналаРегистрации.Предупреждение, ТекстСообщения, УчетнаяЗапись);
		Возврат;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		// Подготовим структуру для сохранения информации об ошибках.
		СведенияПоОшибкам = ДлительнаяОтправкаКлиентСервер.НовыеПараметрыСохранения(Ложь);
		СведенияПоОшибкам.Ошибки         = Ошибки;
		СведенияПоОшибкам.ЕстьОшибки     = Истина;
		СведенияПоОшибкам.ЭтоРасшифровка = Истина;
	Иначе
		// На текущей итерации все прошло успешно, очистим возможные ошибки, возникшие на предыдущих итерациях.
		СведенияПоОшибкам = Неопределено;
	КонецЕсли;
	
	Для каждого ИмяПользователя Из ИменаПользователейИБ Цикл
		ДлительнаяОтправкаВызовСервера.СохранитьОшибкиПоследнегоОбмена(СведенияПоОшибкам, ИмяПользователя);
	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьТаймаутМеждуЗапросамиСЭДО(Ответ)
	
	ИнтервалМеждуЗапросамиСЭДО =
		ЭлектронныйДокументооборотСФССКлиентСервер.ИнтервалМеждуЗапросамиСпискаВходящихСообщенийСЭДОПоУмолчанию();
	ЗаголовкиОтвета = Ответ.Заголовки;
	ЗаголовокИнтервала = "access-control-max-age";
	Если НЕ ЗаголовкиОтвета.Получить(ЗаголовокИнтервала) = Неопределено Тогда
		ИнтервалМеждуЗапросамиСЭДО = Число(ЗаголовкиОтвета.Получить(ЗаголовокИнтервала)) / 1000;
		ИнтервалМеждуЗапросамиСЭДО = ИнтервалМеждуЗапросамиСЭДО + 1;
	КонецЕсли;
	
	КлючОбъектаНастроек = ЭлектронныйДокументооборотСФССКлиентСервер.КлючОбъектаНастроекЗапросовКСерверуСЭДО();
	КлючНастроек = ЭлектронныйДокументооборотСФССКлиентСервер.КлючНастроекИнтервалаМеждуЗапросамиКСерверуСЭДО();
	СохраненныйТаймаутМеждуЗапросамиСЭДО = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек, КлючНастроек);
	СохраненныйТаймаутМеждуЗапросамиСЭДО =
		?(ЗначениеЗаполнено(СохраненныйТаймаутМеждуЗапросамиСЭДО), СохраненныйТаймаутМеждуЗапросамиСЭДО, 0);
	
	Если НЕ СохраненныйТаймаутМеждуЗапросамиСЭДО = ИнтервалМеждуЗапросамиСЭДО Тогда
		ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек, КлючНастроек, ИнтервалМеждуЗапросамиСЭДО);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаймаутМеждуЗапросамиСЭДО(Организация, Ответ, ПревышениеМаксимальногоИнтервала)
	
	ИнтервалМеждуЗапросамиСЭДО	=
		ЭлектронныйДокументооборотСФССКлиентСервер.ИнтервалМеждуЗапросамиСпискаВходящихСообщенийСЭДОПоУмолчанию();
	// Максимальный интервал для которого запустится ожидание.
	МаксимальныйИнтервалДляОжидания			= 60;
	
	Если Ответ.КодСостояния = КодСостоянияОшибкиЧастогоОбращенияЗаСпискомВходящих() Тогда
		ЗаголовкиОтвета = Ответ.Заголовки;
		ЗаголовокОсталосьВремени = "retry-after";
		Если НЕ ЗаголовкиОтвета.Получить(ЗаголовокОсталосьВремени) = Неопределено Тогда
			ИнтервалМеждуЗапросамиСЭДО = Число(ЗаголовкиОтвета.Получить(ЗаголовокОсталосьВремени)) / 1000;
			ИнтервалМеждуЗапросамиСЭДО = Окр(ИнтервалМеждуЗапросамиСЭДО, 0, РежимОкругления.Окр15как20);
			Если ИнтервалМеждуЗапросамиСЭДО >= МаксимальныйИнтервалДляОжидания Тогда
				ПревышениеМаксимальногоИнтервала = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		КлючОбъектаНастроек = ЭлектронныйДокументооборотСФССКлиентСервер.КлючОбъектаНастроекЗапросовКСерверуСЭДО();
		КлючНастроек = ЭлектронныйДокументооборотСФССКлиентСервер.КлючНастроекИнтервалаМеждуЗапросамиКСерверуСЭДО();
		СохраненныйИнтервалМеждуЗапросамиСЭДО = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек, КлючНастроек);
		Если ЗначениеЗаполнено(СохраненныйИнтервалМеждуЗапросамиСЭДО) Тогда
			ИнтервалМеждуЗапросамиСЭДО = СохраненныйИнтервалМеждуЗапросамиСЭДО;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИнтервалМеждуЗапросамиСЭДО;
	
КонецФункции

Функция КодСостоянияОшибкиЧастогоОбращенияЗаСпискомВходящих()
	
	Возврат 403;
	
КонецФункции

#КонецОбласти

#Область ОбменСФТС

///////////////////////////////////////////////////////////////////////////////
// Функции с использованием общих модулей и дублирующие функции для организации
// вызовов общих модулей при документообороте с ФТС

Функция СформироватьФайлОтправкиВФТСССервера(
		КороткоеИмяФайлаВыгрузки,
		СтрокаBase64ФайлаВыгрузки,
		ЭтоАдреса,
		Адрес,
		Кодировка,
		ПараметрыОтправки,
		ВерсияПортала = Неопределено) Экспорт
	
	Если ВерсияПортала = Неопределено Тогда
		ВерсииПортала = Новый Массив;
		ВерсииПортала.Добавить("");
		ВерсииПортала.Добавить("2017");
		
		Результат = Новый Массив;
		Для каждого ПоддерживаемаяВерсияПортала Из ВерсииПортала Цикл
			ФайлОтправки = СформироватьФайлОтправкиВФТСССервера(
				КороткоеИмяФайлаВыгрузки,
				СтрокаBase64ФайлаВыгрузки,
				ЭтоАдреса,
				"",
				Кодировка,
				ПараметрыОтправки,
				ПоддерживаемаяВерсияПортала);
			Результат.Добавить(ФайлОтправки);
		КонецЦикла;
		Если ЭтоАдреса Тогда
			Результат = ПоместитьВоВременноеХранилище(Результат, Адрес);
		КонецЕсли;
		
		Возврат Результат;
	КонецЕсли;
	
	РежимыОтправки = ПараметрыОтправки.РежимыОтправки;
	
	//файл отправки получаем, объединяя файл пакета с файлами начала и окончания POST-запроса
	
	// файл 1
	СодержимоеФайла = "--My1cV8bNdr"
		+ ?(ВерсияПортала = "2017",
		Символы.ПС + "Content-Disposition: form-data; name=""file[0]""; filename=""" + КороткоеИмяФайлаВыгрузки + """",
		Символы.ПС + "Content-Disposition: form-data; name=""ctl55"""
		+ Символы.ПС + Символы.ПС + Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""__EVENTTARGET"""
		+ Символы.ПС + Символы.ПС + "ctl02"
		+ Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""__EVENTARGUMENT"""
		+ Символы.ПС + Символы.ПС + "-|public|UploadFile"
		+ Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""TextFieldNote"""
		+ Символы.ПС + Символы.ПС + Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""DropDownCreateVersion"""
		+ Символы.ПС + Символы.ПС + ПараметрыОтправки.ВерсияФормированияВыгрузки + "/" + ПараметрыОтправки.ВерсияОтправкиПортала
		+ Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""actionUpload""; filename=""" + КороткоеИмяФайлаВыгрузки + """")
		+ Символы.ПС + "Content-Type: text/xml"
		+ Символы.ПС + Символы.ПС;
	
	// запишем файл в кодировке "UTF-8", затем удалим из него сигнатуру BOM
	ИмяФайлаЗапросаНачалоUTF8ССигнатурой = ПолучитьИмяВременногоФайла();
	ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапросаНачалоUTF8ССигнатурой, "utf-8");
	ЗаписываемыйФайл.Записать(СодержимоеФайла);
	ЗаписываемыйФайл.Закрыть();
	
	ИмяФайлаЗапросаНачало = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайлаЗапросаНачалоUTF8ССигнатурой = Новый ДвоичныеДанные(ИмяФайлаЗапросаНачалоUTF8ССигнатурой);
	Данные64ФайлаЗапросаНачалоUTF8ССигнатурой = Base64Строка(ДвоичныеДанныеФайлаЗапросаНачалоUTF8ССигнатурой);
	Данные64ФайлаЗапросаНачалоUTF8БезСигнатуры = Сред(Данные64ФайлаЗапросаНачалоUTF8ССигнатурой, 5);
	ДвоичныеДанныеФайлаЗапросаНачалоUTF8БезСигнатуры = Base64Значение(Данные64ФайлаЗапросаНачалоUTF8БезСигнатуры);
	ДвоичныеДанныеФайлаЗапросаНачалоUTF8БезСигнатуры.Записать(ИмяФайлаЗапросаНачало);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапросаНачалоUTF8ССигнатурой);
	
	// файл 2
	ИмяФайлаВыгрузки = ПолучитьИмяВременногоФайла();
	
	Если ЭтоАдреса Тогда
		ПолучитьИзВременногоХранилища(СтрокаBase64ФайлаВыгрузки).Записать(ИмяФайлаВыгрузки);
	Иначе
		ДвоичныеДанныеФайлаВыгрузки = Base64Значение(СтрокаBase64ФайлаВыгрузки);
		ДвоичныеДанныеФайлаВыгрузки.Записать(ИмяФайлаВыгрузки);
	КонецЕсли;
	
	Если Кодировка <> Неопределено Тогда
		ТекстовыйФайлВыгрузки = Новый ЧтениеТекста(ИмяФайлаВыгрузки, "windows-1251");
		ТекстВыгрузки = ТекстовыйФайлВыгрузки.Прочитать();
		ТекстовыйФайлВыгрузки.Закрыть();
		ТекстовыйФайлВыгрузки = Новый ЗаписьТекста(ИмяФайлаВыгрузки, Кодировка);
		ТекстовыйФайлВыгрузки.Записать(ТекстВыгрузки);
		ТекстовыйФайлВыгрузки.Закрыть();
		
		// в случае кодировки "UTF-8" удалим из файла сигнатуру BOM
		Если нрег(Кодировка) = "utf-8" Тогда
			ДанныеФайлаВыгрузкиUTF8ССигнатурой = Новый ДвоичныеДанные(ИмяФайлаВыгрузки);
			Данные64ФайлаВыгрузкиUTF8ССигнатурой = Base64Строка(ДанныеФайлаВыгрузкиUTF8ССигнатурой);
			Данные64ФайлаВыгрузкиUTF8БезСигнатуры = Сред(Данные64ФайлаВыгрузкиUTF8ССигнатурой, 5);
			ДанныеФайлаВыгрузкиUTF8БезСигнатуры = Base64Значение(Данные64ФайлаВыгрузкиUTF8БезСигнатуры);
			ДанныеФайлаВыгрузкиUTF8БезСигнатуры.Записать(ИмяФайлаВыгрузки);
		КонецЕсли;
	КонецЕсли;
	
	// файл 3
	СодержимоеФайла = ?(ВерсияПортала = "2017", "", Символы.ПС + Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""submitDirectEventConfig"""
		+ Символы.ПС + Символы.ПС + "{""config"":{""extraParams"":{""target"":""" + РежимыОтправки.ИдентификаторНеПринятойОтправкиНаСервере + """}}}"
		+ Символы.ПС + "--My1cV8bNdr"
		+ Символы.ПС + "Content-Disposition: form-data; name=""__ExtNetDirectEventMarker"""
		+ Символы.ПС + Символы.ПС + "delta=true")
		+ Символы.ПС + "--My1cV8bNdr--";
	
	// запишем файл в кодировке "UTF-8", затем удалим из него сигнатуру BOM
	ИмяФайлаЗапросаОкончаниеUTF8ССигнатурой = ПолучитьИмяВременногоФайла();
	ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапросаОкончаниеUTF8ССигнатурой, "utf-8");
	ЗаписываемыйФайл.Записать(СодержимоеФайла);
	ЗаписываемыйФайл.Закрыть();
	
	ИмяФайлаЗапросаОкончание = ПолучитьИмяВременногоФайла();
	ДвоичныеДанныеФайлаЗапросаОкончаниеUTF8ССигнатурой = Новый ДвоичныеДанные(ИмяФайлаЗапросаОкончаниеUTF8ССигнатурой);
	Данные64ФайлаЗапросаОкончаниеUTF8ССигнатурой = Base64Строка(ДвоичныеДанныеФайлаЗапросаОкончаниеUTF8ССигнатурой);
	Данные64ФайлаЗапросаОкончаниеUTF8БезСигнатуры = Сред(Данные64ФайлаЗапросаОкончаниеUTF8ССигнатурой, 5);
	ДвоичныеДанныеФайлаЗапросаОкончаниеUTF8БезСигнатуры = Base64Значение(Данные64ФайлаЗапросаОкончаниеUTF8БезСигнатуры);
	ДвоичныеДанныеФайлаЗапросаОкончаниеUTF8БезСигнатуры.Записать(ИмяФайлаЗапросаОкончание);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапросаОкончаниеUTF8ССигнатурой);
	
	// объединение
	МассивИмен = Новый Массив;
	МассивИмен.Добавить(ИмяФайлаЗапросаНачало);
	МассивИмен.Добавить(ИмяФайлаВыгрузки);
	МассивИмен.Добавить(ИмяФайлаЗапросаОкончание);
	ИмяФайлаОтправки = ПолучитьИмяВременногоФайла();
	ОбъединитьФайлы(МассивИмен, ИмяФайлаОтправки);
	
	Если ЭтоАдреса Тогда
		Результат = Новый ДвоичныеДанные(ИмяФайлаОтправки);
		Если Адрес <> "" Тогда
			Результат = ПоместитьВоВременноеХранилище(Результат, Адрес);
		КонецЕсли;
	Иначе
		ДвоичныеДанныеФайлаОтправки = Новый ДвоичныеДанные(ИмяФайлаОтправки);
		Результат = Base64Строка(ДвоичныеДанныеФайлаОтправки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//////////////////////////////////////////////////////////////////////////////////
//// ДОКУМЕНТООБОРОТ С ФТС, код без использования вызовов общих модулей
////

Функция ОбновитьРезультатКонкретнойОтправкиФТСССервера(Знач ОтправкаСсылка, Знач ОтправкаОбъектЗагружен, Знач ПараметрыОтправки, ПараметрыСоединения, Знач ЭтоВызовИзСписка = Ложь) Экспорт
	
	Если ОтправкаОбъектЗагружен Тогда
		ОсновныеРеквизитыОтправки = Новый Структура("ОтчетСсылка, ИмяФайлаВыгрузки, ИдентификаторОтправкиНаСервере, СтатусОтправки",
			ОтправкаСсылка.ОтчетСсылка, ОтправкаСсылка.ИмяФайлаВыгрузки, ОтправкаСсылка.ИдентификаторОтправкиНаСервере, ОтправкаСсылка.СтатусОтправки);
	Иначе
		ОсновныеРеквизитыОтправки = ЗначенияРеквизитовОбъекта(ОтправкаСсылка, "ОтчетСсылка, ИмяФайлаВыгрузки, ИдентификаторОтправкиНаСервере, СтатусОтправки");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ИдентификаторОтправкиНаСервере) Тогда
		ПараметрыСоединения.ИдентификаторОтправкиНаСервере = ОсновныеРеквизитыОтправки.ИдентификаторОтправкиНаСервере;
	КонецЕсли;
	
	РезультатОтправки = ПолучитьРезультатОтправкиФТС(ОсновныеРеквизитыОтправки, ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовИзСписка, ОтправкаСсылка);
	
	ПараметрыСоединения.СоединениеHTTP = Неопределено;
	
	СохранитьРезультатОтправкиФТС(ОтправкаСсылка, РезультатОтправки, ПараметрыОтправки);
	
	Возврат (РезультатОтправки <> Неопределено);
	
КонецФункции

Функция СохранитьРезультатОтправкиФТС(ОтправкаСсылка, РезультатОтправки, ПараметрыОтправки)
	
	Если РезультатОтправки <> Неопределено Тогда
		ОтправкаОбъект = ОтправкаСсылка.ПолучитьОбъект();
		Если СокрЛП(РезультатОтправки.ИдентификаторОтправкиНаСервере) <> СокрЛП(ОтправкаОбъект.ИдентификаторОтправкиНаСервере)
			ИЛИ РезультатОтправки.СтатусОтправки <> ОтправкаОбъект.СтатусОтправки
			ИЛИ РезультатОтправки.СтатусОтправки <> Перечисления.СтатусыОтправки.Сдан
			ИЛИ РезультатОтправки.НаКонтроле <> ОтправкаОбъект.НаКонтроле ИЛИ РезультатОтправки.НаКонтроле
			ИЛИ НЕ ЗначениеЗаполнено(РезультатОтправки.Протокол) ИЛИ НЕ ЗначениеЗаполнено(ОтправкаОбъект.Протокол)
			ИЛИ РезультатОтправки.Протокол <> ОтправкаОбъект.Протокол.Получить() Тогда
			
			ИдентификаторАннулированнойОтправки = ?(СокрЛП(РезультатОтправки.ИдентификаторОтправкиНаСервере) <>
				СокрЛП(ОтправкаОбъект.ИдентификаторОтправкиНаСервере), ОтправкаОбъект.ИдентификаторОтправкиНаСервере, "");
			ОтчетСсылка = ОтправкаОбъект.ОтчетСсылка;
			
			ОтправкаОбъект.ИдентификаторОтправкиНаСервере = РезультатОтправки.ИдентификаторОтправкиНаСервере; // аннулирование с подачей
			ОтправкаОбъект.ДатаПолученияРезультата = РезультатОтправки.ДатаПолученияРезультата;
			ОтправкаОбъект.СтатусОтправки = РезультатОтправки.СтатусОтправки;
			ОтправкаОбъект.Протокол = Новый ХранилищеЗначения(РезультатОтправки.Протокол);
			ОтправкаОбъект.НаКонтроле = РезультатОтправки.НаКонтроле;
			ОтправкаОбъект.Квитанция = Новый ХранилищеЗначения(РезультатОтправки.Квитанция);
			ОтправкаОбъект.Записать();
			
			Если ЗначениеЗаполнено(ИдентификаторАннулированнойОтправки) Тогда
				АннулированнаяОтправкаСсылка = Неопределено;
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	ОтправкиФТС.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.ОтправкиФТС КАК ОтправкиФТС
					|ГДЕ
					|	ОтправкиФТС.ОтчетСсылка = &ОтчетСсылка
					|	И ОтправкиФТС.ИдентификаторОтправкиНаСервере = &ИдентификаторОтправкиНаСервере
					|	И ОтправкиФТС.ПометкаУдаления = ЛОЖЬ
					|
					|УПОРЯДОЧИТЬ ПО
					|	ОтправкиФТС.ДатаОтправки УБЫВ";
				Запрос.Параметры.Вставить("ОтчетСсылка", 					ОтчетСсылка);
				Запрос.Параметры.Вставить("ИдентификаторОтправкиНаСервере", ИдентификаторАннулированнойОтправки);
				
				РезультатЗапроса = Запрос.Выполнить();
				Если НЕ РезультатЗапроса.Пустой() Тогда
					ЗаписьЗапроса = РезультатЗапроса.Выгрузить()[0];
					АннулированнаяОтправкаСсылка = ЗаписьЗапроса.Ссылка;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(АннулированнаяОтправкаСсылка) Тогда
					Протокол = ГенерироватьHTMLПротоколаОбработкиФТС(
						Новый Структура("Протокол", ""),
						НСтр("ru = 'Отчет аннулирован пользователем.';
							|en = 'Report is canceled by the user.'"),
						Новый Цвет(255, 0, 0),
						Перечисления.СтатусыОтправки.НеПринят,
						Ложь,
						ПараметрыОтправки,
						ОтчетСсылка);
					
					ОтправкаОбъект = АннулированнаяОтправкаСсылка.ПолучитьОбъект();
					ОтправкаОбъект.СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
					ОтправкаОбъект.Протокол = Новый ХранилищеЗначения(Протокол);
					ОтправкаОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьРезультатОтправкиФТС(ОсновныеРеквизитыОтправки, ПараметрыОтправки, ПараметрыСоединения, ЭтоВызовИзСписка, ОтправкаСсылка)
	
	СтатусОтчета = "";
	ЦветСтатуса = Новый Цвет(0, 0, 192);
	СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен;
	НаКонтроле = Ложь;
	
	//запрос результатов обработки
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	ПараметрыСоединения.ПовторятьЗапросПароля = Ложь;
	
	ЗаголовокОтчета = ПолучитьИнформациюОбОтчетеНаПорталеФТС(ПараметрыОтправки, ПараметрыСоединения);
	
	УспешноОбработан = Неопределено;
	ОтчетНаКонтроле = Ложь;
	ОтчетАннулирован = Ложь;
	ОтказаноВАннулировании = Ложь;
	ЭтоЧерновик = Ложь;
	Если ЗаголовокОтчета <> Неопределено Тогда
		УспешноОбработан = УспешноОбработанОтчетФТС(
			ЗаголовокОтчета.Состояние,
			ЗаголовокОтчета.РасширенноеСостояниеНаКонтроле,
			ПараметрыСоединения.ВерсияПортала,
			ОтчетНаКонтроле,
			ОтчетАннулирован,
			ОтказаноВАннулировании,
			ЭтоЧерновик);
	КонецЕсли;
	
	Если ЗаголовокОтчета <> Неопределено И НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
		
		// получен протокол обработки и отсутствовали ошибки соединения
		
		// анализируем содержимое страницы протокола обработки
		Если УспешноОбработан = Истина Тогда
			// отчет принят
			СтатусОтправки = Перечисления.СтатусыОтправки.Сдан;
			СтатусОтчета = НСтр("ru = 'Отчет принят, ошибок не обнаружено.';
								|en = 'Report is accepted, no errors detected.'");
			ЦветСтатуса = Новый Цвет(0, 179, 16);
			
		ИначеЕсли УспешноОбработан = Ложь ИЛИ (УспешноОбработан = Неопределено И ЭтоЧерновик) Тогда
			// отчет не принят
			СтатусОтправки = Перечисления.СтатусыОтправки.НеПринят;
			Если УспешноОбработан = Неопределено И ЭтоЧерновик Тогда
				СтатусОтчета = НСтр("ru = 'Отчет не принят в обработку, повторите отправку.';
									|en = 'Report is not accepted for processing, send again.'");
			ИначеЕсли ОтчетНаКонтроле Тогда
				НаКонтроле = Истина;
				СтатусОтчета = НСтр("ru = 'Отчет зарегистрирован, поставлен на контроль с комментарием должностного лица на портале ФТС.';
									|en = 'Report is registered, brought under control with a comment of an official on FCS portal.'");
			ИначеЕсли ОтчетАннулирован Тогда
				СтатусОтчета = НСтр("ru = 'Отчет аннулирован пользователем.';
									|en = 'Report is canceled by the user.'");
			ИначеЕсли ОтказаноВАннулировании Тогда
				СтатусОтчета = НСтр("ru = 'Отказано в аннулировании отчета.';
									|en = 'Refused to cancel the report.'");
			Иначе
				СтатусОтчета = НСтр("ru = 'Отчет не принят, обнаружены ошибки.';
									|en = 'Report is not accepted, errors are detected.'");
			КонецЕсли;
			ЦветСтатуса = Новый Цвет(255, 0, 0);
			
		Иначе
			// отчет еще не обработан
			СтатусОтчета = НСтр("ru = 'Находится в обработке, попробуйте через некоторое время использовать в отчете кнопку ""Обновить""';
								|en = 'Being processed. Try to click Update in the report after a while'");
		КонецЕсли;
		
		Протокол = ГенерироватьHTMLПротоколаОбработкиФТС(ЗаголовокОтчета, СтатусОтчета, ЦветСтатуса, СтатусОтправки, НаКонтроле, ПараметрыОтправки, ОсновныеРеквизитыОтправки.ОтчетСсылка);
		
		//заполняем результирующую структуру
		Результат = Новый Структура("ДатаПолученияРезультата, ИдентификаторОтправкиНаСервере, СтатусОтправки, Протокол, НаКонтроле, Квитанция",
			ТекущаяДатаСеанса(), ЗаголовокОтчета.ИдентификаторОтправки, СтатусОтправки, Протокол, НаКонтроле, ЗаголовокОтчета.Квитанция);
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) ИЛИ НЕ ПараметрыСоединения.ПовторятьСоединение Тогда
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(ПараметрыСоединения.ОписаниеОшибкиСервером);
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Результаты отправки не получены с портала ФТС. %1';
					|en = 'Sending results are not received from the Federal Customs Service. %1'"),
				ПараметрыСоединения.ОписаниеОшибкиСервером);
			
			Если ЭтоВызовИзСписка Тогда
				ПредставлениеОтчетаОтправки = ПредставлениеОтчета(ОтправкаСсылка.ОтчетСсылка);
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = '%1 Попробуйте через некоторое время использовать кнопку ""Обновить""  в отчете %2.';
						|en = '%1 Click ""Update"" in the %2 report after some time.'"),
					ТекстСообщения,
					ПредставлениеОтчетаОтправки);
			КонецЕсли;
			
			СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
			
		Иначе
			ТекстСообщения = НСтр("ru = 'Не удалось получить результаты отправки с портала Федеральной таможенной службы.';
									|en = 'Cannot receive sending results from the Federal Customs Service portal.'");
			
			Если ЭтоВызовИзСписка Тогда
				ПредставлениеОтчетаОтправки = ПредставлениеОтчета(ОтправкаСсылка.ОтчетСсылка);
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru = '%1 Возможно, портал перегружен. Попробуйте через некоторое время использовать кнопку ""Обновить"" в отчете %2.';
						|en = '%1 The portal may be overloaded. Click ""Update"" in the %2 report after some time.'"),
					ТекстСообщения,
					ПредставлениеОтчетаОтправки);
			КонецЕсли;
			
			СообщитьПользователю(ТекстСообщения, ПараметрыСоединения.СообщенияПользователю);
		КонецЕсли;
		
		Результат = Неопределено;
		
	Иначе
		
		// возможно, проблемы с доступом в интернет
		Результат = Неопределено;
		
	КонецЕсли;
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	
	Возврат Результат;
	
КонецФункции

Функция ОтправкаНаСерверФТС(ФайлыИДанныеОтправки, ОтчетСсылка, ПараметрыОтправки, ПараметрыСоединения)
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	ПараметрыСоединения.ПовторятьЗапросПароля = Ложь;
	
	ОтправкаПроизведена = ОтправитьВыгрузкуНаСерверФТС(ФайлыИДанныеОтправки, ПараметрыОтправки, ПараметрыСоединения);
	
	Если ОтправкаПроизведена Тогда
		
		ПараметрыСоединения.ПовторятьСоединение = Ложь;
		
		Возврат Истина;
		
	ИначеЕсли (ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) ИЛИ НЕ ПараметрыСоединения.ПовторятьСоединение) Тогда
		
		ЭтоРегламентированныйОтчет = (ТипЗнч(ОтчетСсылка) = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнч(ОтчетСсылка) = Тип("Неопределено"));
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			
			ЭтоОшибкиПроверки = Ложь;
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(ПараметрыСоединения.ОписаниеОшибкиСервером, ЭтоОшибкиПроверки);
			
			Если ЭтоОшибкиПроверки Тогда
				ПараметрыСоединения.ОписаниеОшибокПроверки = ПараметрыСоединения.ОписаниеОшибкиСервером;
				
			Иначе
				//отправленный файл не был принят сервером, получено описание ошибки
				Если Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "." И Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "!" Тогда
					ПараметрыСоединения.ОписаниеОшибкиСервером = ПараметрыСоединения.ОписаниеОшибкиСервером + ".";
				КонецЕсли;
				СообщитьПользователю(ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Отчет не принят порталом. %1';
							|en = 'Report is not accepted by the portal. %1'"),
						ПараметрыСоединения.ОписаниеОшибкиСервером) + "
					|" + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
						НСтр("ru = 'Для отправки отчета возможно выгрузить его в файл, используя кнопку ""Выгрузить"", далее отправить этот файл на портале %1';
							|en = 'To send a report, you can export it to a file by clicking Export and send this file on the %1 portal'"),
						НСтр("ru = 'Существует возможность отправить файл выгрузки отчета на портале %1';
							|en = 'You can send the report export file on portal %1'")),
						"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
					ПараметрыСоединения.СообщенияПользователю);
			КонецЕсли;
			
		Иначе
			// в ответе сервера отсутствует описание ошибки и установлен признак повтора соединения
			СообщитьПользователю(НСтр("ru = 'Отчет не удалось отправить на портал Федеральной таможенной службы.';
										|en = 'Cannot send the report to the portal of the Federal Customs Service.'")
				+ " " + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
					НСтр("ru = 'Для отправки отчета возможно выгрузить его в файл, используя кнопку ""Выгрузить"", далее отправить этот файл на портале %1';
						|en = 'To send a report, you can export it to a file by clicking Export and send this file on the %1 portal'"),
					НСтр("ru = 'Существует возможность отправить файл выгрузки отчета на портале %1';
						|en = 'You can send the report export file on portal %1'")),
					"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
				ПараметрыСоединения.СообщенияПользователю);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ОтправкаПодписанногоЗапросаНаСерверФТС(ФайлыИДанныеОтправки, ОтчетСсылка, ПараметрыОтправки, ПараметрыСоединения)
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	ОтправкаПроизведена = ОтправитьПодписанныйЗапросНаСерверФТС(ФайлыИДанныеОтправки, ПараметрыОтправки, ПараметрыСоединения);
	
	Если ОтправкаПроизведена Тогда
		
		ПараметрыСоединения.ПовторятьСоединение = Ложь;
		
	ИначеЕсли ПараметрыСоединения.ОрганизацияПодтверждена <> Истина Тогда
		
		ЭтоРегламентированныйОтчет = (ТипЗнч(ОтчетСсылка) = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнч(ОтчетСсылка) = Тип("Неопределено"));
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			
			ЭтоОшибкиПроверки = Ложь;
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(ПараметрыСоединения.ОписаниеОшибкиСервером, ЭтоОшибкиПроверки);
			
			Если ЭтоОшибкиПроверки Тогда
				ПараметрыСоединения.ОписаниеОшибокПроверки = ПараметрыСоединения.ОписаниеОшибкиСервером;
				
			Иначе
				//отправленный файл не был принят сервером, получено описание ошибки
				Если Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "." И Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "!" Тогда
					ПараметрыСоединения.ОписаниеОшибкиСервером = ПараметрыСоединения.ОписаниеОшибкиСервером + ".";
				КонецЕсли;
				СообщитьПользователю(ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Запрос подтверждения организации не принят порталом. %1';
							|en = 'Company confirmation request was not accepted by the portal. %1'"),
						ПараметрыСоединения.ОписаниеОшибкиСервером)
					+ " " + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
						НСтр("ru = 'Для отправки отчета возможно выгрузить его в файл, используя кнопку ""Выгрузить"", далее отправить данный файл на портале %1';
							|en = 'To send the report, you can export it to a file by clicking ""Export"", then send the file on portal %1'"),
						НСтр("ru = 'Существует возможность отправить файл выгрузки отчета на портале %1';
							|en = 'You can send the report export file on portal %1'")),
						"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
					ПараметрыСоединения.СообщенияПользователю);
			КонецЕсли;
			
		Иначе
			// в ответе сервера отсутствует описание ошибки и установлен признак повтора соединения
			СообщитьПользователю(НСтр("ru = 'Подписанный запрос подтверждения организации не удалось отправить на портал Федеральной таможенной службы.';
										|en = 'Cannot send the signed company confirmation request to the Federal Customs Service portal.'")
				+ " " + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
					НСтр("ru = 'Для отправки отчета выгрузите его в файл, используя кнопку ""Выгрузить"". Далее отправьте данный файл на портале %1';
						|en = 'To send the report, you can export it to a file by clicking ""Export"". Then send the file on portal %1'"),
					НСтр("ru = 'Для отправки отчета отправьте файл выгрузки отчета на портале %1';
						|en = 'To send the report, send the report export file in portal %1'")),
					"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
				ПараметрыСоединения.СообщенияПользователю);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОтправкаПроизведена;
	
КонецФункции

Функция ОтправкаПодписиНаСерверФТС(ФайлыИДанныеОтправки, ОтчетСсылка, ПараметрыОтправки, ПараметрыСоединения)
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	ОтправкаПроизведена = ОтправитьПодписьНаСерверФТС(ФайлыИДанныеОтправки, ПараметрыОтправки, ПараметрыСоединения);
	
	Если ОтправкаПроизведена Тогда
		
		ПараметрыСоединения.ПовторятьСоединение = Ложь;
		
		//отправленный файл принят сервером
		
		ДвоичныеДанныеПодписываемойВыгрузки = Новый ДвоичныеДанные(ФайлыИДанныеОтправки.ИмяФайлаПодписываемойВыгрузки);
		ДвоичныеДанныеПодписи = Новый ДвоичныеДанные(ФайлыИДанныеОтправки.ИмяФайлаПодписи);
		
		НастройкиОтправки = Новый Структура;
		НастройкиОтправки.Вставить("ДвоичныеДанныеПодписи", ДвоичныеДанныеПодписи);
		НастройкиОтправки.Вставить("ПоляДляЗаписиОтправки", ПараметрыОтправки.ПоляДляЗаписиОтправки);
		
		Результат = ДобавитьОтправкуФТС(
			ОтчетСсылка,
			ФайлыИДанныеОтправки.КороткоеИмяФайлаВыгрузки,
			ДвоичныеДанныеПодписываемойВыгрузки,
			ПараметрыСоединения.ИдентификаторОтправкиНаСервере,
			НастройкиОтправки);
		
		Возврат Результат;
		
	ИначеЕсли (ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) ИЛИ НЕ ПараметрыСоединения.ПовторятьСоединение) Тогда
		
		ЭтоРегламентированныйОтчет = (ТипЗнч(ОтчетСсылка) = Тип("ДокументСсылка.РегламентированныйОтчет") ИЛИ ТипЗнч(ОтчетСсылка) = Тип("Неопределено"));
		
		Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			
			ЭтоОшибкиПроверки = Ложь;
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиБезТехническойИнформацииФТС(ПараметрыСоединения.ОписаниеОшибкиСервером, ЭтоОшибкиПроверки);
			
			Если ЭтоОшибкиПроверки Тогда
				ПараметрыСоединения.ОписаниеОшибокПроверки = ПараметрыСоединения.ОписаниеОшибкиСервером;
				
			Иначе
				//отправленный файл не был принят сервером, получено описание ошибки
				Если Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "." И Прав(ПараметрыСоединения.ОписаниеОшибкиСервером, 1) <> "!" Тогда
					ПараметрыСоединения.ОписаниеОшибкиСервером = ПараметрыСоединения.ОписаниеОшибкиСервером + ".";
				КонецЕсли;
				СообщитьПользователю(ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Отчет не принят порталом. %1';
							|en = 'Report is not accepted by the portal. %1'"),
						ПараметрыСоединения.ОписаниеОшибкиСервером) + "
					|" + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
						НСтр("ru = 'Для отправки отчета возможно выгрузить его в файл, используя кнопку ""Выгрузить"", далее отправить этот файл на портале %1';
							|en = 'To send a report, you can export it to a file by clicking Export and send this file on the %1 portal'"),
						НСтр("ru = 'Существует возможность отправить файл выгрузки отчета на портале %1';
							|en = 'You can send the report export file on portal %1'")),
						"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
					ПараметрыСоединения.СообщенияПользователю);
			КонецЕсли;
			
		Иначе
			// в ответе сервера отсутствует описание ошибки и установлен признак повтора соединения
			СообщитьПользователю(НСтр("ru = 'Подписанный пакет не удалось отправить на портал Федеральной таможенной службы.';
										|en = 'Cannot send the signed package to the Federal Customs Service portal.'")
				+ " " + ПодставитьПараметрыВСтроку(?(ЭтоРегламентированныйОтчет,
					НСтр("ru = 'Для отправки отчета возможно выгрузить его в файл, используя кнопку ""Выгрузить"", далее отправить этот файл на портале %1';
						|en = 'To send a report, you can export it to a file by clicking Export and send this file on the %1 portal'"),
					НСтр("ru = 'Существует возможность отправить файл выгрузки отчета на портале %1';
						|en = 'You can send the report export file on portal %1'")),
					"https://" + ПараметрыОтправки.АдресСервера + "/FtsPersonalCabinetWeb/#?service=StatEp&start=0&view=List"),
				ПараметрыСоединения.СообщенияПользователю);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДобавитьОтправкуФТС(
		ОтчетСсылка,
		ИмяФайлаПодписываемойВыгрузки,
		ДвоичныеДанныеПодписываемойВыгрузки,
		ИдентификаторОтправкиНаСервере,
		НастройкиОтправки) Экспорт
	
	НоваяЗапись = Справочники.ОтправкиФТС.СоздатьЭлемент();
	НоваяЗапись.ОтчетСсылка = ОтчетСсылка;
	НоваяЗапись.ИдентификаторОтправкиНаСервере = ИдентификаторОтправкиНаСервере;
	НоваяЗапись.ВыгрузкаДляПодписи = Новый ХранилищеЗначения(ДвоичныеДанныеПодписываемойВыгрузки);
	НоваяЗапись.Подпись = Новый ХранилищеЗначения(НастройкиОтправки.ДвоичныеДанныеПодписи);
	НоваяЗапись.ИмяФайлаВыгрузки = ИмяФайлаПодписываемойВыгрузки;
	НоваяЗапись.СтатусОтправки = Перечисления.СтатусыОтправки.Отправлен;
	НоваяЗапись.ДатаОтправки = ?(НастройкиОтправки.Свойство("ДатаОтправки"), НастройкиОтправки.ДатаОтправки,
		ТекущаяДатаСеанса());
	НоваяЗапись.Организация = ?(ОтчетСсылка <> Неопределено,
		ДокументооборотСКОВызовСервера.ОрганизацияПоОбъектуОтправки(ОтчетСсылка), Неопределено);
	НоваяЗапись.ДатаНачалаПериода = НастройкиОтправки.ПоляДляЗаписиОтправки.ДатаНачалаПериода;
	НоваяЗапись.ДатаОкончанияПериода = НастройкиОтправки.ПоляДляЗаписиОтправки.ДатаОкончанияПериода;
	
	Если НастройкиОтправки.Свойство("ВидОтчета") Тогда
		НоваяЗапись.ВидОтчета = НастройкиОтправки.ВидОтчета;
		
	ИначеЕсли ОтчетСсылка <> Неопределено И ТипЗнч(ОтчетСсылка) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		НоваяЗапись.ВидОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", ОтчетСсылка.ИсточникОтчета);
		
	Иначе // электронные представления
		НоваяЗапись.ВидОтчета = ?(ОтчетСсылка <> Неопределено, ОтчетСсылка.ВидОтчета, Неопределено);
	КонецЕсли;
	
	НоваяЗапись.Версия = НастройкиОтправки.ПоляДляЗаписиОтправки.Версия;
	НоваяЗапись.ПредставлениеПериода = ПредставлениеПериода(НоваяЗапись.ДатаНачалаПериода,
		КонецДня(НоваяЗапись.ДатаОкончанияПериода), "ФП=Истина");
	НоваяЗапись.ПредставлениеВидаДокумента = ПредставлениеВидаДокумента(НоваяЗапись.Версия);
	НоваяЗапись.Записать();
	
	Возврат НоваяЗапись.Ссылка;
	
КонецФункции

Функция ОтправитьПодписанныйЗапросНаСерверФТС(ФайлыИДанныеОтправки, ПараметрыОтправки, ПараметрыСоединения)
	
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	ЗагрузкаПроизведена = Ложь;
	АдресСервера = ПараметрыСоединения.ТекущийАдресСервера;
	
	СоединениеУстановлено = (ПараметрыСоединения.СоединениеHTTP <> Неопределено);
	
	Если НЕ СоединениеУстановлено Тогда
		
		// устанавливаем соединение с сервером
		ОписаниеОшибкиУстановкиСоединения = "";
		ПараметрыСоединения.СоединениеHTTP = ДокументооборотСКО.УстановитьСоединениеССерверомИнтернета("https://" + АдресСервера, ОписаниеОшибкиУстановкиСоединения);
		
		Если ПараметрыСоединения.СоединениеHTTP = Неопределено Тогда
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Не удалось установить соединение с сервером:
								|%1';
								|en = 'Cannot connect to server:
								|%1'"), ОписаниеОшибкиУстановкиСоединения), ПараметрыСоединения.СообщенияПользователю);
			Возврат Ложь;
		КонецЕсли;
		
		СоединениеУстановлено = Истина;
		
	КонецЕсли;
	
	Если СоединениеУстановлено Тогда
		
		ЗагрузкаПроизведена = ЗагрузитьПодписанныйЗапросНаПорталФТС(ФайлыИДанныеОтправки.ИмяФайлаПодписанногоЗапроса, ПараметрыОтправки, ПараметрыСоединения);
		Если ЗагрузкаПроизведена Тогда
			НастройкиПользователя = НастройкиПользователяФТС(ПараметрыОтправки, ПараметрыСоединения);
			Если НастройкиПользователя <> Неопределено И НЕ НастройкиПользователя.ОтправленЗапросНаПодтверждениеОрганизации И НЕ НастройкиПользователя.ОрганизацияПодтверждена Тогда
				ЗагрузкаПроизведена = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ПараметрыСоединения.СоединениеHTTP = Неопределено;
	КонецЕсли;
	
	Возврат ЗагрузкаПроизведена;
	
КонецФункции

Функция НастройкиПользователяФТС(
		ПараметрыОтправки,
		ПараметрыСоединения,
		СформироватьПодписываемыйЗапрос = Ложь,
		ПомещатьВоВременноеХранилище = Ложь)
	
	Если ПараметрыСоединения.ВерсияПортала = "2017" Тогда
		Возврат НастройкиПользователяФТС2017(
			ПараметрыОтправки,
			ПараметрыСоединения,
			СформироватьПодписываемыйЗапрос,
			ПомещатьВоВременноеХранилище);
	КонецЕсли;
	
	// получим свойства профиля
	ЗаголовкиHTTP = Новый Соответствие();
	ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
	ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
	Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
		ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
	КонецЕсли;
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
	
	Попытка
		РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsPersonalCabinetWeb/Api/GetConfig", 
																							"{FTS}/FtsPersonalCabinetWeb/Api/GetConfig", 
																							ПараметрыСоединения.СоединениеHTTP);
		ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.Получить(РесурсНаСервере, ИмяФайлаОтвета, ЗаголовкиHTTP);
	Исключение
		
		ПараметрыСоединения.СоединениеHTTP = Неопределено;
		ПараметрыСоединения.ПовторятьСоединение = Истина;
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		Возврат Неопределено;
		
	КонецПопытки;
	
	ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
	ТекстОтвета = ФайлОтвета.Прочитать();
	ФайлОтвета.Закрыть();
	
	ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
	ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
	
	// проанализируем свойства профиля
	Результат = Новый Структура("ОрганизацияПодтверждена, ОтправленЗапросНаПодтверждениеОрганизации, ПодписываемыйЗапрос64", Ложь, Ложь, "");
	
	ЭлементОрганизации = """Organizations"":";
	ПозицияОрганизации = СтрНайти(ТекстОтвета, ЭлементОрганизации);
	
	Если ПозицияОрганизации > 0 Тогда
		ПозицияОрганизации = ПозицияОрганизации + СтрДлина(ЭлементОрганизации);
		ТекстОтвета = Сред(ТекстОтвета, ПозицияОрганизации);
		
		Если Лев(ТекстОтвета, 2) <> "[]" Тогда
			ЭлементОрганизацияАктивна = """IsActive"":";
			ПозицияОрганизацияАктивна = СтрНайти(ТекстОтвета, ЭлементОрганизацияАктивна);
			
			Если ПозицияОрганизацияАктивна > 0 Тогда
				ПозицияОрганизацияАктивна = ПозицияОрганизацияАктивна + СтрДлина(ЭлементОрганизацияАктивна);
				
				Результат.ОрганизацияПодтверждена = (Сред(ТекстОтвета, ПозицияОрганизацияАктивна, 4) = "true");
				Результат.ОтправленЗапросНаПодтверждениеОрганизации = НЕ Результат.ОрганизацияПодтверждена;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// сформируем запрос
	Если НЕ Результат.ОтправленЗапросНаПодтверждениеОрганизации И СформироватьПодписываемыйЗапрос Тогда
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
		
		Попытка
			РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsPersonalCabinetWeb/Api/CreateOrganizationRequest", 
																								"{FTS}/FtsPersonalCabinetWeb/Api/CreateOrganizationRequest", 
																								ПараметрыСоединения.СоединениеHTTP);
			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.Получить(РесурсНаСервере, ИмяФайлаОтвета, ЗаголовкиHTTP);
		Исключение
			
			ПараметрыСоединения.СоединениеHTTP = Неопределено;
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
			Возврат Неопределено;
			
		КонецПопытки;
		
		ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
		ТекстОтвета = ФайлОтвета.Прочитать();
		ФайлОтвета.Закрыть();
		
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		
		Если Лев(ТекстОтвета, 1) = """" И Прав(ТекстОтвета, 1) = """" Тогда
			ДлинаОтвета = СтрДлина(ТекстОтвета);
			ТекстОтвета = Сред(ТекстОтвета, 2, ДлинаОтвета - 2);
		КонецЕсли;
		ТекстОтвета = СтрЗаменить(ТекстОтвета, "\""", """");
		
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
		ЗаписываемыйФайл.Записать(ТекстОтвета);
		ЗаписываемыйФайл.Закрыть();
		
		ДанныеЗапроса = Новый ДвоичныеДанные(ИмяФайлаЗапроса);
		ПодписываемыйЗапрос64 = Base64Строка(ДанныеЗапроса);
		ПодписываемыйЗапрос64 = Сред(ПодписываемыйЗапрос64, 5);
		// удалим из файла в кодировке "UTF-8" сигнатуру BOM
		Если ПомещатьВоВременноеХранилище Тогда
			ДанныеЗапроса = Base64Значение(ПодписываемыйЗапрос64);
			Результат.ПодписываемыйЗапрос64 = ПоместитьВоВременноеХранилище(ДанныеЗапроса, Новый УникальныйИдентификатор);
		Иначе
			Результат.ПодписываемыйЗапрос64 = ПодписываемыйЗапрос64;
		КонецЕсли;
		
		ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиПользователяФТС2017(
		ПараметрыОтправки,
		ПараметрыСоединения,
		СформироватьПодписываемыйЗапрос = Ложь,
		ПомещатьВоВременноеХранилище = Ложь)
	
	// проанализируем свойства профиля
	Результат = Новый Структура("ОрганизацияПодтверждена, ОтправленЗапросНаПодтверждениеОрганизации, ПодписываемыйЗапрос64", Ложь, Ложь, "");
	
	СтатусОрганизации = ТекстПослеПрефикса(ПараметрыСоединения.ТекстОтветаАвторизации, """Status"":{", "}");
	Если ЗначениеЗаполнено(СтатусОрганизации) Тогда
		Результат.ОрганизацияПодтверждена = (СтрНайти(СтатусОрганизации, """Waiting"":true") = 0);
		Результат.ОтправленЗапросНаПодтверждениеОрганизации = НЕ Результат.ОрганизацияПодтверждена;
	КонецЕсли;
	
	Если НЕ Результат.ОтправленЗапросНаПодтверждениеОрганизации И СформироватьПодписываемыйЗапрос Тогда
		// загрузим профиль организации
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
