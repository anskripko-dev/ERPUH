#Область ОтправкаРегламентированногоОтчетаВПФР

Функция ОтправкаРегламентированногоОтчетаВПФР_ПередВыгрузкойФайла(Контекст, Док, УникальныйИдентификатор, ТекстСообщения) Экспорт

	Контекст = Новый Структура();
	Контекст.Вставить("Документ", Док);
	Контекст.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	
	Если ТипЗнч(Контекст.Документ) = Тип("Массив") Тогда
		ОсновнойДок = Контекст.Документ[0];
	Иначе
		ОсновнойДок = Контекст.Документ;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОсновнойДок) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран документ для отправки.';
								|en = 'Document for sending is not selected.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	// проверяем, включен ли обмен по организации
	СвойстваОбъекта = СвойстваОбъектовФормы1СОтчетность(ОсновнойДок, Истина);
	Организация = ?(ТипЗнч(СвойстваОбъекта) = Тип("Структура") И СвойстваОбъекта.Свойство("Организация"),
		СвойстваОбъекта.Организация, Неопределено);
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнойДок, "Организация");
	КонецЕсли;
	Если Организация.ВидОбменаСКонтролирующимиОрганами <> Перечисления.ВидыОбменаСКонтролирующимиОрганами.ОбменВУниверсальномФормате Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("ОтсутствуетУчетнаяЗапись", Истина);

		Возврат Ложь;
		
	КонецЕсли;
	
	// проверяем, предназначена ли эта учетная запись для документооборота с ФНС
	УчетнаяЗапись = УчетнаяЗаписьОрганизации(Организация);
	
	ПропуститьПроверку = 
		ТипЗнч(ОсновнойДок) = Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР") 
		И ОсновнойДок.Вид = Перечисления.ВидыЗаявленийНаЭДОВПФР.НаОтключение;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПредназначенаДляДокументооборотаСПФР") <> Истина И НЕ ПропуститьПроверку Тогда
		
		// Текст ошибки будет выведен в виде формы
		Контекст.Вставить("НаправлениеНеПодключено", Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	ТипЗнчДок = ТипЗнч(ОсновнойДок);
	МетаданныеОтчета = Метаданные.НайтиПоТипу(ТипЗнчДок);
	Если МетаданныеОтчета = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Неизвестный тип отчета.';
								|en = 'Unknown report type.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ИмяМетаданныхОтчета = МетаданныеОтчета.Имя;
	Если ИмяМетаданныхОтчета = "РегламентированныйОтчет" Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойДок, "ДатаНачала, ДатаОкончания, ИсточникОтчета");
		
		ДатаНачалаПериодаОтчета         = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета      = ЗначенияРеквизитов.ДатаОкончания;
		ВидРегламентированногоОтчетаСтр = ЗначенияРеквизитов.ИсточникОтчета;
	ИначеЕсли ИмяМетаданныхОтчета = "ЭлектронныеПредставленияРегламентированныхОтчетов" Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойДок, "ДатаНачала, ДатаОкончания, ВидОтчета");
		
		ДатаНачалаПериодаОтчета         = ЗначенияРеквизитов.ДатаНачала;
		ДатаОкончанияПериодаОтчета      = ЗначенияРеквизитов.ДатаОкончания;
		ВидРегламентированногоОтчетаСтр = ЗначенияРеквизитов.ВидОтчета;
	ИначеЕсли ИмяМетаданныхОтчета = "ЗаявленияПоЭлДокументооборотуСПФР" Тогда
		
		// Тут определены такие даты, но в цикл обмена они не пишутся
		ДатаНачалаПериодаОтчета         = ТекущаяДатаСеанса();
		ДатаОкончанияПериодаОтчета      = ТекущаяДатаСеанса();
		ВидРегламентированногоОтчетаСтр = ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.ЗаявленияПоЭлДокументооборотуСПФР");
		
	ИначеЕсли ИмяМетаданныхОтчета = "УведомлениеОПредоставленииПолномочийПредставителю" Тогда
		
		// Тут определены такие даты, но в цикл обмена они не пишутся
		ДатаНачалаПериодаОтчета         = ТекущаяДатаСеанса();
		ДатаОкончанияПериодаОтчета      = ТекущаяДатаСеанса();
		ВидРегламентированногоОтчетаСтр = ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.УведомлениеОПредоставленииПолномочийПредставителю");
		
	ИначеЕсли ИмяМетаданныхОтчета = "УведомлениеОПрекращенииПолномочийПредставителя" Тогда
		
		// Тут определены такие даты, но в цикл обмена они не пишутся
		ДатаНачалаПериодаОтчета         = ТекущаяДатаСеанса();
		ДатаОкончанияПериодаОтчета      = ТекущаяДатаСеанса();
		ВидРегламентированногоОтчетаСтр = ПредопределенноеЗначение("Справочник.ВидыОтправляемыхДокументов.УведомлениеОПрекращенииПолномочийПредставителя");
		
	Иначе
		ДатыПериодаОтчета = ЭлектронныйДокументооборотСКонтролирующимиОрганамиВызовСервераПереопределяемый.ПолучитьДатыПериодаДокумента(ОсновнойДок);
		
		ДатаНачалаПериодаОтчета         = ДатыПериодаОтчета.ДатаНачала;
		ДатаОкончанияПериодаОтчета      = ДатыПериодаОтчета.ДатаОкончания;
		ВидРегламентированногоОтчетаСтр = ИмяМетаданныхОтчета;
	КонецЕсли;
	
	ТипЦиклаОбмена = Перечисления.ТипыЦикловОбмена.ОтчетностьПФР;
	ТипТранспортногоСообщения = Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьПФР;
	ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
	
	Если ТипЗнч(ВидРегламентированногоОтчетаСтр) = Тип("СправочникСсылка.ВидыОтправляемыхДокументов") Тогда
		ВидРегламентированногоОтчета = ВидРегламентированногоОтчетаСтр;
	Иначе
		ВидРегламентированногоОтчета = Справочники.ВидыОтправляемыхДокументов.НайтиПоРеквизиту("Источник", ВидРегламентированногоОтчетаСтр);
		Если ВидРегламентированногоОтчета = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка() Тогда
			
			ВидОтправляемогоДокументаПереопределяемый = ВидОтправляемогоДокументаПоСсылке(ОсновнойДок);
			
			Если НЕ ЗначениеЗаполнено(ВидОтправляемогоДокументаПереопределяемый)
				И СтрНачинаетсяС(ВидРегламентированногоОтчетаСтр, "EF_") Тогда
				ВидОтправляемогоДокументаПереопределяемый =
					Справочники.ВидыОтправляемыхДокументов.ПрочаяОтчетностьПФРДляВыпускаПатчей;
			КонецЕсли;
			Если ЗначениеЗаполнено(ВидОтправляемогоДокументаПереопределяемый) Тогда
				ВидРегламентированногоОтчета = ВидОтправляемогоДокументаПереопределяемый;
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В справочнике ""Виды отправляемых документов"" не найден соответствующий элемент для отправки объекта %1!';
					|en = 'The corresponding item for sending object %1 is not found in the ""Kinds of documents being sent"" catalog.'"), ОсновнойДок);
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;	
			КонецЕсли;
			
		КонецЕсли;
		// с 2014 года отправляются комплекты на основе РСВ-1 с приложениями
		Если (ВидРегламентированногоОтчета = Справочники.ВидыОтправляемыхДокументов.КомплектыОтчетностиПерсучета 
			ИЛИ ВидРегламентированногоОтчета = Справочники.ВидыОтправляемыхДокументов.РСВ1) И ДатаНачалаПериодаОтчета >= '20140101000000' Тогда
			ВидРегламентированногоОтчета = Справочники.ВидыОтправляемыхДокументов.КомплектыРСВ1;
		КонецЕсли;
	КонецЕсли;
	
	КодОрганаПФР = Неопределено;
	РегНомерПФР = Неопределено;
	РегНомерСФР = Неопределено;
	ИспользоватьОрганЕЦП = (ФорматДокументооборотаСПФР(ВидРегламентированногоОтчета).ФорматДокументооборота =
		Перечисления.ФорматыДокументооборотаСПФР.ЭДОК);
	ОрганПФР = ОпределитьОрганПФРОрганизации(
		Организация,
		КодОрганаПФР,
		РегНомерПФР,
		РегНомерСФР,
		ИспользоватьОрганЕЦП);
	Если ОрганПФР = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'В свойствах организации не задан код органа ПФР.';
								|en = 'PF authority code is not specified in the company properties.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	ИначеЕсли НЕ ЗначениеЗаполнено(ОрганПФР) Тогда
		ТекстСообщения = ?(ЗначениеЗаполнено(КодОрганаПФР) И СтрНайти(КодОрганаПФР, "-") = 0,
			НСтр("ru = 'Отсутствует дефис в поле ""Код территориального органа ПФР"" свойств организации, скорректируйте это значение и повторите попытку.';
				|en = 'No hyphen in the ""PF local authority code"" field of the company properties, correct this value and try again.'"),
			НСтр("ru = 'Не удалось найти в справочнике ""Органы ПФР"" получателя отчетности.';
				|en = 'Cannot find a reporting recipient in the ""PF authorities"" catalog.'"));
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Контекст.Вставить("Организация", 					Организация);
	Контекст.Вставить("ДатаНачалаПериодаОтчета", 		ДатаНачалаПериодаОтчета);
	Контекст.Вставить("ДатаОкончанияПериодаОтчета", 	ДатаОкончанияПериодаОтчета);
	Контекст.Вставить("ТипОтправляемогоДокумента", 		ИмяМетаданныхОтчета);
	Контекст.Вставить("ТипЦиклаОбмена", 				ТипЦиклаОбмена);
	Контекст.Вставить("ТипТранспортногоСообщения", 		ТипТранспортногоСообщения);
	Контекст.Вставить("ТипСодержимогоКонтейнера",  		ТипСодержимогоКонтейнера);
	Контекст.Вставить("УчетнаяЗапись", 					УчетнаяЗапись);
	Контекст.Вставить("ОрганПФР", 						ОрганПФР);
	Контекст.Вставить("РегНомерПФР", 					РегНомерПФР);
	Контекст.Вставить("РегНомерСФР", 					РегНомерСФР);
	
	Контекст.Вставить("ВидРегламентированногоОтчета", 	ВидРегламентированногоОтчета);
	Контекст.Вставить("ИсточникОтчета", 				ВидРегламентированногоОтчетаСтр);
	
	Возврат Истина;
	
КонецФункции

Функция ОтправкаРегламентированногоОтчетаВПФР_ОпределитьЦиклОбменаИСообщениеВИБ(Контекст) Экспорт
	
	Отчет = Контекст.Документ;
	Организация = Контекст.Организация;
	ТипЦиклаОбмена = Контекст.ТипЦиклаОбмена;
	УчетнаяЗапись = Контекст.УчетнаяЗапись;
	ОрганПФР = Контекст.ОрганПФР;
	ТипТранспортногоСообщения = Контекст.ТипТранспортногоСообщения;
	ВидРегламентированногоОтчета = Контекст.ВидРегламентированногоОтчета;
	РезультатВыгрузкиОтчетности = Контекст.РезультатВыгрузки;
	
	// формируем массив предметов
	МассивПредметов = ПолучитьМассивПредметов(РезультатВыгрузкиОтчетности, Отчет);
	
	НачатьТранзакцию();
	
	// формируем цикл обмена
	ЦиклОбмена = Справочники.ЦиклыОбмена.СоздатьЭлемент();
	ЦиклОбменаСсылка = Справочники.ЦиклыОбмена.ПолучитьСсылку();
	ЦиклОбмена.УстановитьСсылкуНового(ЦиклОбменаСсылка);
	ЦиклОбмена.Вид = Перечисления.ВидыЦикловОбмена.ЦиклОбменаСПФР;

	ЦиклОбмена.ВидОтчета = ВидРегламентированногоОтчета;
	ЦиклОбмена.Организация = Организация;
	ЦиклОбмена.УчетнаяЗапись = УчетнаяЗапись;
	ЦиклОбмена.ВнешняяОрганизация = ОрганПФР;
	ЦиклОбмена.Тип = ТипЦиклаОбмена;
	
	ЦиклОбмена.Предмет = МассивПредметов[0];
	Для Инд = 1 По МассивПредметов.Количество() - 1 Цикл
		НовСтр = ЦиклОбмена.ДополнительныеПредметы.Добавить();
		НовСтр.Предмет = МассивПредметов[Инд];
	КонецЦикла;
	
	Если ТипЗнч(ЦиклОбмена.Предмет) <> Тип("ДокументСсылка.ЗаявленияПоЭлДокументооборотуСПФР") Тогда
		ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
		ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	КонецЕсли;
	
	Если ТипЗнч(ЦиклОбмена.Предмет) <> Тип("ДокументСсылка.УведомлениеОПредоставленииПолномочийПредставителю") Тогда
		ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
		ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	КонецЕсли;
	
	Если ТипЗнч(ЦиклОбмена.Предмет) <> Тип("ДокументСсылка.УведомлениеОПрекращенииПолномочийПредставителя") Тогда
		ЦиклОбмена.ДатаНачалаПериода = Контекст.ДатаНачалаПериодаОтчета;
		ЦиклОбмена.ДатаОкончанияПериода = Контекст.ДатаОкончанияПериодаОтчета;
	КонецЕсли;
	
	// формируем первичное транспортное сообщение
	ТранспортноеСообщение = Документы.ТранспортноеСообщение.СоздатьДокумент();
	ТранспортноеСообщение.ЦиклОбмена = ЦиклОбменаСсылка;
	ТранспортноеСообщение.Тип = ТипТранспортногоСообщения;
	ТранспортноеСообщение.Отправитель = Организация;
	ТранспортноеСообщение.Получатель = ОрганПФР;
	ТранспортноеСообщение.УчетнаяЗапись = УчетнаяЗапись;
	ТранспортноеСообщение.Статус = Перечисления.СтатусыПисем.Исходящее;
	Попытка
		ТранспортноеСообщение.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Мультирежим.ЗаписатьВладельцевОбъекта1СОтчетности(
		ЦиклОбменаСсылка,
		УчетнаяЗапись,
		Перечисления.ТипыКонтролирующихОрганов.ПФР) Тогда
		
		ОтменитьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Отправка прервана.';
								|en = 'Sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.БПИ;
	
	// добавляем ДИВы
	Для Каждого СтрРезультатВыгрузкиОтчетности Из РезультатВыгрузкиОтчетности Цикл
		
		ТипФайлаОтчетностиПФР = Неопределено;
		ИмяТипаДокументаПачкаДокументовСПВ_1 = "ПачкаДокументовСПВ_1";
		ИмяТипаДокументаПачкаДокументовСПВ_2 = "ПачкаДокументовСПВ_2";
		Если СтрРезультатВыгрузкиОтчетности.Свойство("Документ") И
			((Метаданные.Документы.Найти(ИмяТипаДокументаПачкаДокументовСПВ_1) <> Неопределено И ТипЗнч(СтрРезультатВыгрузкиОтчетности.Документ) = Тип("ДокументСсылка." + ИмяТипаДокументаПачкаДокументовСПВ_1))
			ИЛИ (Метаданные.Документы.Найти(ИмяТипаДокументаПачкаДокументовСПВ_2) <> Неопределено И ТипЗнч(СтрРезультатВыгрузкиОтчетности.Документ) = Тип("ДокументСсылка." + ИмяТипаДокументаПачкаДокументовСПВ_2))) Тогда
			ТипФайлаОтчетностиПФР = Перечисления.ТипыФайловОтчетностиПФР.ПачкаСВВ;
		КонецЕсли;
		
		Если РегламентированнаяОтчетностьКлиентСервер.СвойствоОпределено(СтрРезультатВыгрузкиОтчетности, "Тип") Тогда
			Если ТипЗнч(СтрРезультатВыгрузкиОтчетности.Тип) = Тип("ПеречислениеСсылка.ТипыФайловОтчетностиПФР") ИЛИ ТипФайлаОтчетностиПФР <> Неопределено
				ИЛИ (СтрРезультатВыгрузкиОтчетности.Свойство("ОпределитьТипПоСодержимому") И СтрРезультатВыгрузкиОтчетности.ОпределитьТипПоСодержимому) Тогда
				ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
			ИначеЕсли ТипЗнч(СтрРезультатВыгрузкиОтчетности.Тип) = Тип("ПеречислениеСсылка.ТипыСодержимогоТранспортногоКонтейнера") Тогда
				ТипСодержимогоКонтейнера = СтрРезультатВыгрузкиОтчетности.Тип;
			Иначе
				ОтменитьТранзакцию();
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
				ТекстСообщения = НСтр("ru = 'Отправка прервана.';
										|en = 'Sending is canceled.'");
				ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		Иначе	
			ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.ФайлОтчетностиПФР;
		КонецЕсли;
		
		Если ТипСодержимогоКонтейнера = Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР Тогда
			ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.Неизвестный;
		Иначе
			ТипСодержимогоФайла = Перечисления.ТипыСодержимогоФайлов.xml;
		КонецЕсли;
		
		Если ТипФайлаОтчетностиПФР = Неопределено Тогда
			ТипФайлаОтчетностиПФР = СтрРезультатВыгрузкиОтчетности.Тип;
		КонецЕсли;
		ОпределитьТипПоСодержимому = ТипФайлаОтчетностиПФР = Неопределено
			И СтрРезультатВыгрузкиОтчетности.Свойство("ОпределитьТипПоСодержимому")
			И СтрРезультатВыгрузкиОтчетности.ОпределитьТипПоСодержимому;
		
		ИнформацияОФорматеДокументооборота = ФорматДокументооборотаСПФР(
			ВидРегламентированногоОтчета,,
			СтрРезультатВыгрузкиОтчетности.Имя);
		
		Если ОпределитьТипПоСодержимому
			ИЛИ ИнформацияОФорматеДокументооборота.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК
			И ИнформацияОФорматеДокументооборота.ЭтоВозможныйФормат Тогда
			
			ИмяВремФайла = ПолучитьИмяВременногоФайла();
			ПолучитьИзВременногоХранилища(СтрРезультатВыгрузкиОтчетности.Адрес).Записать(ИмяВремФайла);
			ИнформацияОТипеФайла = Неопределено;
			Попытка
				ИнформацияОТипеФайла = ОпределитьТипФайлаПФР(ИмяВремФайла, СтрРезультатВыгрузкиОтчетности.Имя);
			Исключение
			КонецПопытки;
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВремФайла);
			
			Если ОпределитьТипПоСодержимому Тогда
				ТипФайлаОтчетностиПФР = ?(ИнформацияОТипеФайла = Неопределено, Неопределено, ИнформацияОТипеФайла.ТипФайла);
			КонецЕсли;
			Если ИнформацияОФорматеДокументооборота.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК
				И ИнформацияОФорматеДокументооборота.ЭтоВозможныйФормат
				И ИнформацияОТипеФайла <> Неопределено
				И ИнформацияОТипеФайла.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
				
				ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
			КонецЕсли;
			
		ИначеЕсли ИнформацияОФорматеДокументооборота.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК
			И НЕ ИнформацияОФорматеДокументооборота.ЭтоВозможныйФормат Тогда
			
			ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
		КонецЕсли;
		
		// удалить переводы строк при наличии для исключения ошибок проверки подписи
		Если ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
			ДвоичныеДанныеВыгрузки = ПолучитьИзВременногоХранилища(СтрРезультатВыгрузкиОтчетности.Адрес);
			ИмяВременногоФайлаВыгрузки = ПолучитьИмяВременногоФайла();
			ДвоичныеДанныеВыгрузки.Записать(ИмяВременногоФайлаВыгрузки);
			Попытка
				КодировкаВыгрузки = ОпределитьКодировку(ДвоичныеДанныеВыгрузки);
			Исключение
				ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Электронный документооборот с контролирующими органами.ПрочитатьТекстИзФайла()';
						|en = 'Electronic data interchange with regulatory authorities.ПрочитатьТекстИзФайла()'"), 
					УровеньЖурналаРегистрации.Ошибка,,,
					СтрШаблон("%1: %2", "Определение кодировки не удалось", ИнформацияОбОшибке));
			КонецПопытки;
			ТекстВыгрузки = ПрочитатьТекстИзФайла(ИмяВременногоФайлаВыгрузки, КодировкаВыгрузки);
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаВыгрузки);
			
			ТекстВыгрузки = СтрЗаменить(ТекстВыгрузки, Символы.ПС, "");
			ТекстВыгрузки = СтрЗаменить(ТекстВыгрузки, Символы.ВК, "");
			
			ИмяВременногоФайлаВыгрузки = ПолучитьИмяВременногоФайла();
			ЗаписатьXMLВФайл(ТекстВыгрузки, ИмяВременногоФайлаВыгрузки, КодировкаВыгрузки, Истина);
			ДвоичныеДанныеВыгрузки = Новый ДвоичныеДанные(ИмяВременногоФайлаВыгрузки);
			СтрРезультатВыгрузкиОтчетности.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанныеВыгрузки,
				СтрРезультатВыгрузкиОтчетности.Адрес);
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяВременногоФайлаВыгрузки);
		КонецЕсли;
		
		Если НЕ ДобавитьСодержимоеТранспортногоКонтейнера(ТранспортноеСообщение.Ссылка,
														ТипСодержимогоКонтейнера,
														СтрРезультатВыгрузкиОтчетности.Адрес,
														СтрРезультатВыгрузкиОтчетности.Имя,
														,
														,
														,
														,
														,
														ТипФайлаОтчетностиПФР,
														СгенерироватьUUID(),
														ТипСодержимогоФайла) Тогда
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
									|en = 'Report sending is canceled.'");
			ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ЦиклОбмена.Идентификатор = СгенерироватьUUID(ФорматДокументооборота);
	ЦиклОбмена.ФорматДокументооборота = ФорматДокументооборота;
	
	// пишем цикл обмена только (!) после записи ДИВ, потому что при записи цикла
	// используется информация из связанных ДИВ
	Попытка
		ЦиклОбмена.Записать();
	Исключение
		ОтменитьТранзакцию();
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ИнформацияОбОшибке().Описание);
		ТекстСообщения = НСтр("ru = 'Отправка отчета прервана.';
								|en = 'Report sending is canceled.'");
		ДлительнаяОтправкаКлиентСервер.ВывестиОшибку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	Контекст.Вставить("ЦиклОбмена", ЦиклОбмена.Ссылка);
	Контекст.Вставить("ТранспортноеСообщение", ТранспортноеСообщение.Ссылка);
	Контекст.Вставить("ФорматДокументооборота", ФорматДокументооборота);
	
	Возврат Истина;
	
КонецФункции

Функция ВыгрузитьРегламентированныйОтчетПФРИзВнешнихЭлектронныхПредставлений(Контекст) Экспорт
	
	Результат = Новый Массив;
	
	ФайлыДИВ = ИзвлечьЭлектронныеПредставленияИзХранилища(Контекст.Документ);
	Если ФайлыДИВ <> Неопределено Тогда
		Для Каждого ФайлДИВ Из ФайлыДИВ Цикл
			
			СтрРезультат = Новый Структура("Документ, Тип, Имя, Адрес, ВАрхиве");
			СтрРезультат.Документ = Контекст.Документ;
			СтрРезультат.Тип = ФайлДИВ.ТипФайлаОтчетности;
			СтрРезультат.Имя = ФайлДИВ.ИмяФайла;
			СтрРезультат.ВАрхиве = ФайлДИВ.ВАрхиве;			
			СтрРезультат.Адрес = ПоместитьВоВременноеХранилище(ФайлДИВ.Данные, Контекст.УникальныйИдентификатор);
			
			Результат.Добавить(СтрРезультат);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипПоИдентификаторуТипаФайлаВыгрузки(ИдентификаторТипаФайлаВыгрузки) Экспорт
	
	Если ТипЗнч(ИдентификаторТипаФайлаВыгрузки) <> Тип("Строка") Тогда
		Возврат ИдентификаторТипаФайлаВыгрузки;
	Иначе
		Если ВРЕГ(ИдентификаторТипаФайлаВыгрузки) = ВРЕГ("сведенияПриложение") ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторТипаФайлаВыгрузки) Тогда
			Возврат Перечисления.ТипыСодержимогоТранспортногоКонтейнера.СведенияПриложениеПФР;
		Иначе
			МетаданныеЗначения = Метаданные.Перечисления.ТипыФайловОтчетностиПФР.ЗначенияПеречисления.Найти(ИдентификаторТипаФайлаВыгрузки);
			Если МетаданныеЗначения <> Неопределено Тогда
				ИндексМетаданныхЗначения = Метаданные.Перечисления.ТипыФайловОтчетностиПФР.ЗначенияПеречисления.Индекс(МетаданныеЗначения);
				Возврат Перечисления.ТипыФайловОтчетностиПФР.Получить(ИндексМетаданныхЗначения);
			Иначе
				Возврат Неопределено;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьМассивПредметов(РезультатВыгрузкиОтчетности, Отчет)
	
	// формируем массив предметов
	МассивПредметов = Новый Массив;
	Для Инд = 0 По РезультатВыгрузкиОтчетности.Количество() - 1 Цикл
		Если МассивПредметов.Найти(РезультатВыгрузкиОтчетности[Инд].Документ) = Неопределено Тогда
			МассивПредметов.Добавить(РезультатВыгрузкиОтчетности[Инд].Документ);
		КонецЕсли;
	КонецЦикла;
	
	// добавляем основной, если его нет в списке
	Если МассивПредметов.Найти(Отчет) = Неопределено Тогда
		МассивПредметов.Вставить(0, Отчет);
	КонецЕсли;
	
	Возврат МассивПредметов;
	
КонецФункции

Функция ОпределитьТипФайлаПФР(ПолноеИмяФайла, ИсходноеИмяФайла = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("ТипФайла", 					Неопределено);
	Результат.Вставить("ФорматДокументооборота", 	Перечисления.ФорматыДокументооборотаСПФР.БПИ);
	
	// 
	ДеревоXML = ДеревоXMLИзФайла(ПолноеИмяФайла);
	Если ДеревоXML = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектФайл = Новый Файл(?(ИсходноеИмяФайла = Неопределено, ПолноеИмяФайла, ИсходноеИмяФайла));
	КороткоеИмяФайла = ОбъектФайл.Имя;
	Если ВРЕГ(Лев(КороткоеИмяФайла, 4)) = "ПФР_" ИЛИ ВРЕГ(Лев(КороткоеИмяФайла, 4)) = "СФР_" Тогда
		УзелПачкаВходящихДокументов = ДеревоXML;
		
	Иначе
		Если ДеревоXML.Свойства().Получить("ПачкаВходящихДокументов") = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		УзелПачкаВходящихДокументов = ДеревоXML.ПачкаВходящихДокументов;
	КонецЕсли;
	
	СвойстваУзла = УзелПачкаВходящихДокументов.Свойства();
	Если СвойстваУзла.Получить("АНКЕТА_ЗЛ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("ЗАЯВЛЕНИЕ_ОБ_ОБМЕНЕ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("ЗАЯВЛЕНИЕ_О_ДУБЛИКАТЕ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_О_СТРАХОВЫХ_ВЗНОСАХ_И_СТРАХОВОМ_СТАЖЕ_ЗЛ") <> Неопределено Тогда
		
		УзелСведения = УзелПачкаВходящихДокументов.СВЕДЕНИЯ_О_СТРАХОВЫХ_ВЗНОСАХ_И_СТРАХОВОМ_СТАЖЕ_ЗЛ;
		Если ТипЗнч(УзелСведения) = Тип("ОбъектXDTO") Тогда
			УзелСведенияОсновной = УзелСведения;
		Иначе
			Если УзелСведения.Количество() > 0 Тогда
				УзелСведенияОсновной = УзелСведения.Получить(0);
			Иначе
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		Если УзелСведенияОсновной.Свойства().Получить("ВидФормы") <> Неопределено
		И СокрЛП(УзелСведенияОсновной.ВидФормы) = "СПВ-1" Тогда
			Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаСВВ;
		Иначе
			Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		КонецЕсли;
		
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_О_СТРАХОВОМ_СТАЖЕ_ЗЛ_ДЛЯ_УСТАНОВЛЕНИЯ_ПЕНСИИ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаСВВ;
	ИначеЕсли СвойстваУзла.Получить("ОПИСЬ_СВЕДЕНИЙ_ПЕРЕДАВАЕМЫХ_СТРАХОВАТЕЛЕМ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаАДВ;
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_О_СУММЕ_ВЫПЛАТ_И_ВОЗНАГРАЖДЕНИЙ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("КОНВЕРТАЦИЯ") <> Неопределено Тогда
		Если ФорматДокументооборотаСЗВК() = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК Тогда
			СвойстваУзлаКонвертация = УзелПачкаВходящихДокументов.КОНВЕРТАЦИЯ.Свойства();
			Если СвойстваУзлаКонвертация.Получить("ВидФормы") <> Неопределено
				И СвойстваУзлаКонвертация.Получить("ФактПроживанияКрым") <> Неопределено Тогда
				
				УзелКонвертация = УзелПачкаВходящихДокументов.КОНВЕРТАЦИЯ;
				Если УзелКонвертация.ВидФормы = "СЗВ-К" И Строка(УзелКонвертация.ФактПроживанияКрым) = "1" Тогда
					Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_СВ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ_НАЧИНАЯ_С_2012_ГОДА") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_СВ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ_НАЧИНАЯ_С_2013_ГОДА") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ_2014") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ_2015") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_ПО_ПАЧКЕ_ДОКУМЕНТОВ_РАЗДЕЛА_6") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаСВВ;
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_О_СУММЕ_ВЫПЛАТ_И_СТРАХОВОМ_СТАЖЕ_ЗЛ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаСВВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ПЛАТЕЛЬЩИКАМИ_НЕ_ПРОИЗВОДЯЩИМИ_ВЫПЛАТЫ_ФЛ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_СТРАХОВЫМ_ВЗНОСАМ_НА_ОПС_И_ОМС_ГЛАВАМИ_КФХ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РСВ-2") <> Неопределено ИЛИ СвойстваУзла.Получить("РСВ_2") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РАСЧЕТ_ПО_ВЗНОСАМ_НА_ДОПОЛНИТЕЛЬНОЕ_СОЦИАЛЬНОЕ_ОБЕСПЕЧЕНИЕ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("РВ-3") <> Неопределено ИЛИ СвойстваУзла.Получить("РВ_3") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаРСВ;
	ИначеЕсли СвойстваУзла.Получить("ЗАЯВЛЕНИЕ_О_ДОБРОВОЛЬНОМ_ВСТУПЛЕНИИ_В_ПРАВООТНОШЕНИЯ_В_ЦЕЛЯХ_УПЛАТЫ_ДСВ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаДСВ;
	ИначеЕсли СвойстваУзла.Получить("РЕЕСТР_ДСВ_РАБОТОДАТЕЛЬ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.РеестрДСВ;
	ИначеЕсли СвойстваУзла.Получить("СВЕДЕНИЯ_О_СУММЕ_ВЫПЛАТ_О_СТРАХОВЫХ_ВЗНОСАХ_И_СТРАХОВОМ_СТАЖЕ_ЗЛ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("ВЕДОМОСТЬ_УПЛАТЫ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаАДВ;
	ИначеЕсли СвойстваУзла.Получить("ИС_СЗВ-4-1") <> Неопределено ИЛИ СвойстваУзла.Получить("ИС_СЗВ_4_1") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("ИС_СЗВ-4-2") <> Неопределено ИЛИ СвойстваУзла.Получить("ИС_СЗВ_4_2") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СТАРЫЕ_ИС_СЗВ-1") <> Неопределено ИЛИ СвойстваУзла.Получить("СТАРЫЕ_ИС_СЗВ_1") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СТАРЫЕ_ИС_СЗВ-3") <> Неопределено ИЛИ СвойстваУзла.Получить("СТАРЫЕ_ИС_СЗВ_3") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-М") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_М") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-СТАЖ") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_СТАЖ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-КОРР") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_КОРР") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-ИСХ") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_ИСХ") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("ОДВ-1") <> Неопределено ИЛИ СвойстваУзла.Получить("ОДВ_1") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-ТД") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_ТД") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("ЗПЭД") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("ЗОЭД") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("УПУП") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("УПРУП") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("ЕФС-1") <> Неопределено ИЛИ СвойстваУзла.Получить("ЕФС_1") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("СЗВ-ДСО") <> Неопределено ИЛИ СвойстваУзла.Получить("СЗВ_ДСО") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("АДВ-1") <> Неопределено ИЛИ СвойстваУзла.Получить("АДВ_1") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("АДВ-2") <> Неопределено ИЛИ СвойстваУзла.Получить("АДВ_2") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	ИначеЕсли СвойстваУзла.Получить("АДВ-3") <> Неопределено ИЛИ СвойстваУзла.Получить("АДВ_3") <> Неопределено Тогда
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПачкаИС;
		Результат.ФорматДокументооборота = Перечисления.ФорматыДокументооборотаСПФР.ЭДОК;
	Иначе
		Результат.ТипФайла = Перечисления.ТипыФайловОтчетностиПФР.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
