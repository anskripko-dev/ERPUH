Функция ДанныеМакетаЧерезПостроительЗапроса(
		Макет, 
		КолонкиБулево = Неопределено) Экспорт

	ОбластьЯчеек = Макет.Область(1, 1, Макет.ВысотаТаблицы, Макет.ШиринаТаблицы);
	
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
	ПостроительЗапроса.Выполнить();
	
	Таблица = ПостроительЗапроса.Результат.Выгрузить();
	Если КолонкиБулево <> Неопределено Тогда
		ПреобразоватьКолонкиСтрокиВБулево(Таблица, КолонкиБулево);
	КонецЕсли;
	
	Возврат Таблица;;
		
КонецФункции

Процедура ПреобразоватьКолонкиСтрокиВБулево(Таблица, КолонкиБулево) Экспорт

	ПредобработкаВидовПредставляемыхДокументов(Таблица, КолонкиБулево); 
	
	Для каждого Строка Из Таблица Цикл
		ОбработкаВидовПредставляемыхДокументов(Строка, КолонкиБулево); 
	КонецЦикла; 
	
	ПостобработкаВидовПредставляемыхДокументов(Таблица, КолонкиБулево);
	
КонецПроцедуры

Процедура ПредобработкаВидовПредставляемыхДокументов(Таблица, КолонкиБулево)

	Для каждого Имя Из КолонкиБулево Цикл
		Таблица.Колонки.Добавить(Имя + "_Булево");
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбработкаВидовПредставляемыхДокументов(Строка, КолонкиБулево)
	
	Для каждого Имя Из КолонкиБулево Цикл
		Строка[Имя + "_Булево"] = Булево(Строка[Имя]);
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПостобработкаВидовПредставляемыхДокументов(Виды, КолонкиБулево)
	
