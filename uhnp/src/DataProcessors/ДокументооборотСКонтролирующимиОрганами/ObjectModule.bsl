Функция АвторизоватьсяНаПорталеФТС2017(ПараметрыОтправки, ПараметрыСоединения)
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	ЗаголовкиHTTP = Новый Соответствие();
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=utf-8");
	ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
	ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
	ДобавитьОбязательныеЗаголовкиФТС(ЗаголовкиHTTP);
	Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
		ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
	КонецЕсли;
	
	ПакетДляАвторизации = СтрШаблон(
	"{""userName"":""%1"",""password"":""%2"",""loginMode"":""UserName""}",
	ПараметрыСоединения.Логин,
	ПараметрыСоединения.Пароль);
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
	ЗаписываемыйФайл.Записать(ПакетДляАвторизации);
	ЗаписываемыйФайл.Закрыть();
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
	
	ОтветHTTP = Неопределено;
	Попытка
		РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsPersonalCabinetWeb/Service/AuthenticateLogin", 
		"{FTS}/FtsPersonalCabinetWeb/Service/AuthenticateLogin", 
		ПараметрыСоединения.СоединениеHTTP);
		// Создалим объект запроса по файлу
		ЗапросHTTP = Новый HTTPЗапрос();
		ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
		ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляАвторизации, "utf-8");
		///////////////////////////////////																					
		Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл       
			ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
			ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP, ИмяФайлаОтвета);
			
			// Обработка исключительных ситуаций ФТС
			Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, ЗапросHTTP.АдресРесурса) Тогда
				Продолжить;
			КонецЕсли;  
			Прервать;
		КонецЦикла;  
		////////////////////////////////////////
	Исключение
		
		ОбъектФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		Если НЕ ОбъектФайлОтвета.Существует() Тогда
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПараметрыСоединения.СоединениеHTTP.Сервер + ?(ПараметрыСоединения.СоединениеHTTP.Порт <> 80,
			":" + Формат(ПараметрыСоединения.СоединениеHTTP.Порт, "ЧДЦ=; ЧН=; ЧГ="), "") + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Электронный документооборот с контролирующими органами. Авторизоваться в ФТС';
				|en = 'EDI with regulatory authorities. Authorize in FCS'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
			
			ПараметрыСоединения.ПовторятьСоединение = Истина;
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
			Возврат Ложь;
		КонецЕсли;
		
	КонецПопытки;
	
	Если ОтветHTTP <> Неопределено Тогда
		ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
		ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
	КонецЕсли;
	
	ФайлОтвета = Новый ЧтениеТекста(ИмяФайлаОтвета, "utf-8");
	ТекстОтвета = ФайлОтвета.Прочитать();
	ФайлОтвета.Закрыть();
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаЗапроса);
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
	
	Если ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) = Ложь Тогда
		ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОшибкиПорталаФТС(ТекстОтвета, Истина);
		Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстПослеПрефикса(ТекстОтвета, "System.Exception:", " at ");
			ПараметрыСоединения.ОписаниеОшибкиСервером = СокрЛП(ПараметрыСоединения.ОписаниеОшибкиСервером);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) И ОтветHTTP = Неопределено Тогда
			ПараметрыСоединения.ОписаниеОшибкиСервером = ТекстОтвета;
		КонецЕсли; 
	КонецЕсли;
	
	ПараметрыСоединения.ПовторятьЗапросПароля = ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером) Тогда
		ПараметрыСоединения.ТекстОтветаАвторизации = ТекстОтвета;
	КонецЕсли;
	
	// сохранить пароль при успешной авторизации
	
	Если НЕ ПараметрыСоединения.ПовторятьЗапросПароля И (ПараметрыСоединения.Логин <> ПараметрыСоединения.СохраненныйЛогин ИЛИ (ПараметрыСоединения.СохранитьПароль И ПараметрыСоединения.Пароль <> ПараметрыСоединения.СохраненныйПароль)) Тогда
		ПарольДляСохранения = ?(ПараметрыСоединения.СохранитьПароль, ПараметрыСоединения.Пароль, "");
		ЗаписатьЛогинИПарольПорталаФТС(ПараметрыОтправки.Организация, ПараметрыСоединения.Логин, ПарольДляСохранения);
		ПараметрыСоединения.СохраненныйЛогин = ПараметрыСоединения.Логин;
		ПараметрыСоединения.СохраненныйПароль = ПарольДляСохранения;
	КонецЕсли;
	
	Результат = НЕ ЗначениеЗаполнено(ПараметрыСоединения.ОписаниеОшибкиСервером);
	
	// подтвердить организацию
	
	Если Результат Тогда
		ИНН = ДокументооборотСКОВызовСервера.ИННОрганизации(ПараметрыОтправки.Организация);
		
		ИдентификаторОрганизации = ИдентификаторОрганизацииДляПодтверждения(ИНН, ТекстОтвета);
		
		Если ЗначениеЗаполнено(ИдентификаторОрганизации) Тогда
			ЗаголовкиHTTP = Новый Соответствие();
			ЗаголовкиHTTP.Вставить("Content-Type", "application/json;charset=utf-8");
			ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
			ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
			Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
				ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
			КонецЕсли;
			
			ПакетДляЗаданияОрганизации = СтрШаблон(
			"{""organization"":""%1""}",
			ИдентификаторОрганизации);
			ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
			ЗаписываемыйФайл = Новый ЗаписьТекста(ИмяФайлаЗапроса, "utf-8");
			ЗаписываемыйФайл.Записать(ПакетДляЗаданияОрганизации);
			ЗаписываемыйФайл.Закрыть();
			
			ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
			
			Попытка
				РесурсНаСервере = ДокументооборотСКО.ПолучитьЗаменяемоеЗначениеТестовогоСервера1С("/FtsPersonalCabinetWeb/Service/SetActiveOrganization", 
				"{FTS}/FtsPersonalCabinetWeb/Service/SetActiveOrganization", 
				ПараметрыСоединения.СоединениеHTTP); 
				// Создалим объект запроса по файлу
				ЗапросHTTP = Новый HTTPЗапрос();
				ЗапросHTTP.АдресРесурса = РесурсНаСервере; 
				ЗапросHTTP.УстановитьТелоИзСтроки(ПакетДляЗаданияОрганизации, "utf-8");
				///////////////////////////////////																					
				Для НомерПопытки = 1 По КоличествоПопытокДляЗапросовФТС() Цикл       
					ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
					ОтветHTTP = ПараметрыСоединения.СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP, ИмяФайлаОтвета);
					// Обработка исключительных ситуаций ФТС
					Если НуженПовторЦелевогоЗапросаФТС(ОтветHTTP, ПараметрыСоединения, ЗаголовкиHTTP, ЗапросHTTP.АдресРесурса) Тогда
						Продолжить;
					КонецЕсли;  
					Прервать;
				КонецЦикла;  
				////////////////////////////////////////
			Исключение
				
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ПараметрыСоединения.СоединениеHTTP.Сервер + ?(ПараметрыСоединения.СоединениеHTTP.Порт <> 80,
				":" + Формат(ПараметрыСоединения.СоединениеHTTP.Порт, "ЧДЦ=; ЧН=; ЧГ="), "") + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронный документооборот с контролирующими органами. Авторизоваться в ФТС организация';
					|en = 'EDI with regulatory authorities. Authorize in FCS company'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ТекстОшибки);
				
				ПараметрыСоединения.СоединениеHTTP = Неопределено;
				ПараметрыСоединения.ПовторятьСоединение = Истина;
				ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
				Возврат Ложь;
				
			КонецПопытки;
			
			ЗначениеSetCookie = ОтветHTTP.Заголовки.Получить("Set-Cookie");
			ПараметрыСоединения.ЗначениеCookie = ОбновленноеЗначениеCookie(ПараметрыСоединения.ЗначениеCookie, ЗначениеSetCookie);
			
			ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
		КонецЕсли;
	КонецЕсли;
	
	ОперацииСФайламиЭДКО.УдалитьВременныйФайл(ИмяФайлаОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторОрганизацииДляПодтверждения(ИННОрганизации, ТекстОтвета)
	
	Результат = Неопределено;
	
	СтруктураОтвета = JsonВСоответствие(ТекстОтвета);
	Результат = ЗначениеСоответствия(СтруктураОтвета, "User,Id");
	
	ОрганизацииКонтрагента = ЗначениеСоответствия(СтруктураОтвета, "User,Organizations");
	Если Не ЗначениеЗаполнено(ОрганизацииКонтрагента) Тогда
		Возврат Результат;
	КонецЕсли;   
	
	Для каждого СтрокаМассива Из ОрганизацииКонтрагента Цикл
		ИННСтроки = ЗначениеСоответствия(СтрокаМассива, "INN"); 
		Если ИННСтроки = ИННОрганизации Тогда
			Результат = ЗначениеСоответствия(СтрокаМассива, "Id");
			Прервать;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат; 
	
КонецФункции // ()

Функция ЗагрузитьОтчетНаПорталФТС(
		МассивИменФайловОтправки,
		КороткоеИмяФайлаВыгрузки,
		ПараметрыОтправки,
		ПараметрыСоединения)
	
	ИмяФайлаОтправки = ?(ТипЗнч(МассивИменФайловОтправки) = Тип("Массив"),
		МассивИменФайловОтправки[?(ПараметрыСоединения.ВерсияПортала = "2017", 1, 0)],
		МассивИменФайловОтправки);
	
	Если ПараметрыСоединения.ВерсияПортала = "2017" Тогда
		Возврат ЗагрузитьОтчетНаПорталФТС2017(
			ИмяФайлаОтправки,
			КороткоеИмяФайлаВыгрузки,
			ПараметрыОтправки,
			ПараметрыСоединения);
	КонецЕсли;
	
	ПараметрыСоединения.ОписаниеОшибкиСервером = "";
	ПараметрыСоединения.ПовторятьСоединение = Ложь;
	
	РежимыОтправки = ПараметрыОтправки.РежимыОтправки;
	
	Если РежимыОтправки.ЭтоАннулированиеСОтправкойНового Тогда
		
		// посылаем запрос аннулирования с подачей
		
		ЗаголовкиHTTP = Новый Соответствие();
		ЗаголовкиHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
		ЗаголовкиHTTP.Вставить("Proxy-Connection", "Keep-Alive");
		ЗаголовкиHTTP.Вставить("Pragma", "no-cache");
		ЗаголовкиHTTP.Вставить("X-Ext.Net", "delta=true");
		Если ЗначениеЗаполнено(ПараметрыСоединения.ЗначениеCookie) Тогда
			ЗаголовкиHTTP.Вставить("Cookie", ПараметрыСоединения.ЗначениеCookie);
		КонецЕсли;
		
