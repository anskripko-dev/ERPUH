#Область СПАРК

Функция ЭтоНужныйВидОтчетаСПАРК(СсылкаНаОтчет) Экспорт
	
	ОтправкаОтчетностиВИнтерфакс = "РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОтправкаОтчетностиВИнтерфакс";
	Если ОбщегоНазначения.ПодсистемаСуществует(ОтправкаОтчетностиВИнтерфакс) Тогда
		МодульОтправкаРегОтчетовВСПАРК = ОбщегоНазначения.ОбщийМодуль("ОтправкаРегОтчетовВСПАРК");
		Возврат МодульОтправкаРегОтчетовВСПАРК.ЭтоНужныйВидОтчетаСПАРК(СсылкаНаОтчет);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СвойстваОтчетаСПАРК(СсылкаНаОтчет) Экспорт
	
	ОтправкаОтчетностиВИнтерфакс = "РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОтправкаОтчетностиВИнтерфакс";
	Если ОбщегоНазначения.ПодсистемаСуществует(ОтправкаОтчетностиВИнтерфакс) Тогда
		МодульОтправкаРегОтчетовВСПАРК = ОбщегоНазначения.ОбщийМодуль("ОтправкаРегОтчетовВСПАРК");
		Возврат МодульОтправкаРегОтчетовВСПАРК.СвойстваОтчетаСПАРК(СсылкаНаОтчет);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ПроверкаТекстовогоСодержимогоНаСимволыXML

Функция ПроверитьЗаменитьНедопустимыеСимволы(ПроверяемаяСтрока)
	
	НайденныеСимволы = ПроверитьНеДопустимыеСимволы(ПроверяемаяСтрока);
	Результат = ЗаменитьНедопустимыеСимволы(ПроверяемаяСтрока, НайденныеСимволы);
	Возврат Результат;
	
КонецФункции	

Функция ПроверитьНедопустимыеСимволы(ПроверяемаяСтрока) Экспорт
	
	Результат = Новый Соответствие;
	
	СтрокаАнализа = ПроверяемаяСтрока;
	
	НовоеВхождение = Неопределено;
	Позиция = НайтиНедопустимыеСимволыXML(СтрокаАнализа);
	Пока Позиция <> 0 Цикл
		Если НовоеВхождение <> Неопределено И НовоеВхождение + Результат[НовоеВхождение] = Позиция Тогда
			Результат[НовоеВхождение] = Результат[НовоеВхождение] + 1;
		Иначе	
			НовоеВхождение = Позиция;
			Результат.Вставить(Позиция, 1);
		КонецЕсли;
		Позиция = НайтиНедопустимыеСимволыXML(СтрокаАнализа, Позиция + 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаменитьНедопустимыеСимволы(ПроверяемаяСтрока, КлючиНайденныхСимволов, СимволЗамены = "?") Экспорт
	
	Результат = ПроверяемаяСтрока;
	
	Для Каждого СтрокаКлюча Из КлючиНайденныхСимволов Цикл
		Результат = Сред(Результат, 1, СтрокаКлюча.Ключ - 1)
					+ СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов(СимволЗамены, СтрокаКлюча.Значение)
					+ Сред(Результат, СтрокаКлюча.Ключ + СтрокаКлюча.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

#КонецОбласти

#Область ТранспортныеСообщенияКРасшифровке

Функция ПолучитьСообщенияДляРасшифровки(МассивСообщений, ПараметрыПоказа = Неопределено) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ОтключеноПодтверждение", Ложь);
	Результат.Вставить("ИтогиПоСообщениям", Новый Массив);
	
	ТаблицаИсходная = СообщенияДляРасшифровки(МассивСообщений, ПараметрыПоказа);
	ТаблицаИсходнаяСЭДОФСС = СообщенияДляРасшифровкиСЭДОФСС(ПараметрыПоказа);
	
	Если ТаблицаИсходная.Количество() = 0 И ТаблицаИсходнаяСЭДОФСС.Количество() = 0 Тогда
		Результат.Отказ = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Таблица = ТаблицаИсходная.Скопировать();
	Таблица.Свернуть("Организация, УчетнаяЗапись, ЭлектроннаяПодписьВМоделиСервиса, МодельХраненияЗакрытогоКлюча", "КоличествоСообщений");
	
	ОтключеноПодтверждение = Истина;
	
	Для Каждого СтрокаРезультата Из Таблица Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("Организация", СтрокаРезультата.Организация);
		
		ТаблицаОтбора = ТаблицаИсходная.Скопировать(Отбор);
		Сообщения = ТаблицаОтбора.ВыгрузитьКолонку("ТранспортноеСообщение");
		
		НоваяСтрока = Новый Структура("Организация, КоличествоСообщений, Сообщения");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
		НоваяСтрока.Сообщения = Новый ФиксированныйМассив(Сообщения);
		
		ДокументОтФНС = ТребованияФНС.КоличествоТребованийИУведомлений(
			Сообщения,
			СтрокаРезультата.Организация,
			ТаблицаОтбора,
			ПараметрыПоказа);
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(НоваяСтрока, ДокументОтФНС);
		
		Если КриптографияЭДКОКлиентСервер.ЭтоПодписьСервиса(СтрокаРезультата.МодельХраненияЗакрытогоКлюча) Тогда
			ОтключеноПодтверждение = ОтключеноПодтверждение И ОтключеноПодтверждение(СтрокаРезультата.УчетнаяЗапись);
		Иначе
			ОтключеноПодтверждение = Ложь;
		КонецЕсли;
		
		Результат.ИтогиПоСообщениям.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Результат.ОтключеноПодтверждение = ОтключеноПодтверждение;
	
	Если ПараметрыПоказа = Неопределено ИЛИ НЕ ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		ТаблицаФСС = ТаблицаИсходнаяСЭДОФСС.Скопировать();
		ТаблицаФСС.Свернуть("Организация", "КоличествоСообщений");
		ТаблицаТребованияИУведомленияСЭДОФСС = ТаблицаИсходнаяСЭДОФСС.Скопировать();
		ТаблицаТребованияИУведомленияСЭДОФСС.Свернуть("Организация", "Требование, Уведомление");
		Для Каждого СтрокаРезультата Из ТаблицаФСС Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаРезультата.Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			Сообщения = Новый Массив;
			
			ТребованияИУведомления = ТаблицаТребованияИУведомленияСЭДОФСС.Найти(СтрокаРезультата.Организация, "Организация");
			
			НайденнаяОрганизация = Неопределено;
			Для каждого Элемент из Результат.ИтогиПоСообщениям Цикл
				Если Элемент.Организация = СтрокаРезультата.Организация Тогда
					Элемент.КоличествоСообщений	= Элемент.КоличествоСообщений + СтрокаРезультата.КоличествоСообщений;
					Элемент.Требований			= Элемент.Требований + ТребованияИУведомления.Требование;
					Элемент.Уведомлений			= Элемент.Уведомлений + ТребованияИУведомления.Уведомление;
					НайденнаяОрганизация		= СтрокаРезультата.Организация;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НайденнаяОрганизация = Неопределено Тогда
				
				НоваяСтрока = Новый Структура("Организация, КоличествоСообщений, Сообщения, Требований, Уведомлений");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
				
				НоваяСтрока.Сообщения	= Новый ФиксированныйМассив(Сообщения);
				
				НоваяСтрока.Требований	= ТребованияИУведомления.Требование;
				НоваяСтрока.Уведомлений	= ТребованияИУведомления.Уведомление;
				
				Результат.ИтогиПоСообщениям.Добавить(НоваяСтрока);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СобратьСообщенияДляРасшифровки(ИтогиПоСообщениям, ПараметрыПоказа = Неопределено) Экспорт
	
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(10);
	
	МассивОрганизаций = Новый Массив;
	ТаблицаРасшифровкиПоОрганизациям = Новый ТаблицаЗначений;
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("Отметка", Новый ОписаниеТипов("Булево"));
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("КоличествоСообщений", ТипЧисло);
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("ТекстСообщения", Новый ОписаниеТипов("Булево"));
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("КоличествоРасшифрованных", ТипЧисло);
	ТаблицаРасшифровкиПоОрганизациям.Колонки.Добавить("КоличествоНеРасшифрованных", ТипЧисло);
	
	ТребующиеРасшифровки = Новый ТаблицаЗначений;
	ТребующиеРасшифровки.Колонки.Добавить("ТранспортноеСообщение", Новый ОписаниеТипов("ДокументСсылка.ТранспортноеСообщение"));
	ТребующиеРасшифровки.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТребующиеРасшифровки.Колонки.Добавить("ТипТранспортногоСообщения", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыТранспортныхСообщений"));
	
	ВыбранныеСообщения = Новый Массив;
	Для Каждого СтрокаМассива Из ИтогиПоСообщениям Цикл
		Если МассивОрганизаций.Найти(СтрокаМассива.Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(СтрокаМассива.Организация);
			
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
				ВыбранныеСообщения, 
				Новый Массив(СтрокаМассива.Сообщения));
				
		КонецЕсли;
		НоваяСтрока = ТаблицаРасшифровкиПоОрганизациям.Добавить();
		НоваяСтрока.Отметка = Истина;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
	КонецЦикла;
	
	Таблица = СообщенияДляРасшифровки(ВыбранныеСообщения, ПараметрыПоказа);
	Для каждого Строка Из Таблица Цикл
		Если МассивОрганизаций.Найти(Строка.Организация) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТребующиеРасшифровки.Добавить();
		НоваяСтрока.Организация = Строка.Организация;
		НоваяСтрока.ТранспортноеСообщение = Строка.ТранспортноеСообщение;
		НоваяСтрока.ТипТранспортногоСообщения = Строка.Тип;
	КонецЦикла;
	
	Если ПараметрыПоказа = Неопределено ИЛИ НЕ ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		ТаблицаСЭДОФСС = СообщенияДляРасшифровкиСЭДОФСС();
		Для каждого Строка Из ТаблицаСЭДОФСС Цикл
			Если МассивОрганизаций.Найти(Строка.Организация) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТребующиеРасшифровки.Добавить();
			НоваяСтрока.Организация = Строка.Организация;
			НоваяСтрока.ТранспортноеСообщение = ПредопределенноеЗначение("Документ.ТранспортноеСообщение.ПустаяСсылка");
			НоваяСтрока.ТипТранспортногоСообщения = Строка.Тип;
		КонецЦикла;
	КонецЕсли;
	
	// уточнение количества собранных вх.сообщений
	ПромежуточнаяТаблица = ТребующиеРасшифровки.Скопировать();
	ПромежуточнаяТаблица.Свернуть("Организация");
	
	Для Каждого СтрокаСвертки ИЗ ПромежуточнаяТаблица Цикл 
		
		Отбор = Новый Структура("Организация", СтрокаСвертки.Организация);
		
		РезультатОтбора = ТаблицаРасшифровкиПоОрганизациям.НайтиСтроки(Отбор);
		Если РезультатОтбора.Количество() > 0 Тогда 
			ОтборТребующихРасшифровки = ТребующиеРасшифровки.НайтиСтроки(Отбор);
			РезультатОтбора[0].КоличествоСообщений = ОтборТребующихРасшифровки.Количество();
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТребующиеРасшифровки.Количество() = 0 Тогда
		Результат = Неопределено;
		
	Иначе	
		АдресТребующиеРасшифровки = ПоместитьВоВременноеХранилище(ТребующиеРасшифровки, Новый УникальныйИдентификатор);
			
		АдресТаблицаРасшифровкиПоОрганизациям = ПоместитьВоВременноеХранилище(ТаблицаРасшифровкиПоОрганизациям, Новый УникальныйИдентификатор);
		
		Результат = Новый Структура();
		Результат.Вставить("АдресТребующиеРасшифровки", АдресТребующиеРасшифровки);
		Результат.Вставить("АдресТаблицаРасшифровкиПоОрганизациям", АдресТаблицаРасшифровкиПоОрганизациям);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтключеноПодтверждение(УчетнаяЗапись)
	
	Результат = Ложь;
	
	Сертификат = Мультирежим.СертификатПользователя(УчетнаяЗапись);
	Если НЕ Сертификат.Найден Тогда
		Возврат Результат;
	КОнецЕсли;
	
	Если КриптографияЭДКОКлиентСервер.ЭтоПодписьСервиса(Сертификат.МодельХраненияЗакрытогоКлюча) Тогда
		
		НастройкиПодтверждения = ЭлектроннаяПодписьВМоделиСервисаБРОВызовСервера.СвойстваРасшифрованияПодписанияСертификата(Сертификат);
		Результат = НастройкиПодтверждения.СпособПодтвержденияКриптоопераций = Перечисления.СпособыПодтвержденияКриптоопераций.ДолговременныйТокен;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция РасшифроватьТранспортныеСообщенияВФоне(ТребующиеРасшифровки, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Истина);
	Результат.Вставить("ВсегоРасшифровано", 0);
	
	Для Каждого СтрокаМассива Из ТребующиеРасшифровки Цикл
		Выполнено = РасшифроватьТранспортноеСообщение(СтрокаМассива);
		Если Выполнено Тогда
			Результат.ВсегоРасшифровано = Результат.ВсегоРасшифровано + 1;
		КонецЕсли;
		Результат.Выполнено = Результат.Выполнено И Выполнено;
	КонецЦикла;
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция СообщенияДляРасшифровки(Сообщения, ПараметрыПоказа = Неопределено) Экспорт
	
	// Внимание! Не делать ВНУТРЕННЕЕ соединения с Справочник.ЦиклыОбмена
	// Для входящих сообщение его еще может не быть!!!!
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросВыбораСообщенийДляРасшифровки(ПараметрыПоказа);
	
	Запрос.УстановитьПараметр("ТриМесяцаНазад", ДатаСеанса - 3*30*24*60*60);
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
		И НЕ ПараметрыПоказа.ВсеСообщения Тогда
		
		ТриРабочихДняНазад = ДатаСеанса - 3*24*60*60;
		Пока ДатаСеанса - ТриРабочихДняНазад < 2*30*24*60*60
			И ТребованияФНС.РазностьДатПоКалендарю(ТриРабочихДняНазад, ДатаСеанса).Дельта < 3 Цикл
			
			ТриРабочихДняНазад = ТриРабочихДняНазад - 24*60*60;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ТриРабочихДняНазад", ТриРабочихДняНазад);
	КонецЕсли;
	Запрос.УстановитьПараметр("Сообщения", Сообщения);
	Запрос.УстановитьПараметр("ТекущиеУчетныеЗаписиНалогоплательщика", ДокументооборотСКО.ТекущиеУчетныеЗаписиНалогоплательщика());
	Запрос.УстановитьПараметр("ТипыТранспортныхСообщенийЦБ", ТипыТранспортныхСообщенийЦБ());
	Запрос.УстановитьПараметр("ТипыСообщенийИнициированныхФНС", ТипыСообщенийИнициированныхФНС());
	Если ПараметрыПоказа <> Неопределено И НЕ ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
	КонецЕсли;
	Если ПараметрыПоказа <> Неопределено И ЗначениеЗаполнено(ПараметрыПоказа.Организация) Тогда
		Запрос.УстановитьПараметр("Организация", ПараметрыПоказа.Организация);
	КонецЕсли;
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
		И НЕ СообщенияДляРасшифровки_ПроверитьВладельцевУдалитьЛишниеСтроки(Таблица, ПараметрыПоказа) Тогда
		
		ПараметрыПоказа.ПоказДляДругихПользователей = Ложь;
		Возврат СообщенияДляРасшифровки(Сообщения, ПараметрыПоказа);
	КонецЕсли;
	
	СообщенияДляРасшифровки_ПроверитьПрава(Таблица);
	
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		СообщенияДляРасшифровки_ЗавершитьПроверкуВладельцевУдалитьЛишниеКолонки(Таблица, ПараметрыПоказа);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция СообщенияДляРасшифровкиСЭДОФСС(ПараметрыПоказа = Неопределено) Экспорт
	
	СтроковыйТипСообщения = НЕ ЭлектронныйДокументооборотСФСС.ТипСообщенияЧислоВРегистреВходящихСообщенийСЭДО();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация");
	Если СтроковыйТипСообщения Тогда
		Результат.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Иначе
		Результат.Колонки.Добавить("Тип", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	Результат.Колонки.Добавить("КоличествоСообщений", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Требование", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Уведомление", Новый ОписаниеТипов("Число"));
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ВходящиеСообщенияСЭДОФСС) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ПараметрыПоказа = Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		// Это показ для других пользователей.
		Возврат Результат;
	Иначе
		// Получаем по организациям у которых есть настройки для текущего пользователя.
		НастройкиОбменаФСС = ДокументооборотСКОВызовСервера.НастройкиОбменаФССДляТекущегоПользователя();
		ДопустимыеОрганизацииВОбъектахОбменаФСС = НастройкиОбменаФСС.ВыгрузитьКолонку("Организация");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВходящиеСообщенияСЭДОФСС.Организация КАК Организация,
	               |	ВходящиеСообщенияСЭДОФСС.Тип КАК Тип,
	               |	1 КАК КоличествоСообщений,
	               |	ВЫБОР
	               |		КОГДА ВходящиеСообщенияСЭДОФСС.Тип В (&ТипыСообщенийТребований)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Требование,
	               |	ВЫБОР
	               |		КОГДА ВходящиеСообщенияСЭДОФСС.Тип В (&ТипыСообщенийУведомлений)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Уведомление
	               |ИЗ
	               |	РегистрСведений.ВходящиеСообщенияСЭДОФСС КАК ВходящиеСообщенияСЭДОФСС
	               |ГДЕ
	               |	ВходящиеСообщенияСЭДОФСС.Дата >= &ТриМесяцаНазад
	               |	И ВходящиеСообщенияСЭДОФСС.Организация В(&Организации)
	               |	И ВходящиеСообщенияСЭДОФСС.Новое";
	
	ТипыСЭДО = ЭлектронныйДокументооборотСФССКлиентСервер.ТипыСообщенийТребованийИУведомленийСЭДО();
	ТипыСообщенийТребований = ТипыСЭДО.ТипыТребований;
	ТипыСообщенийУведомлений = ТипыСЭДО.ТипыУведомлений;
	
	ДатаСеанса	= ТекущаяДатаСеанса();
	День		= 24 * 60 * 60;
	ТриМесяца	= 3 * 30 * День;
	Запрос.УстановитьПараметр("Организации", ДопустимыеОрганизацииВОбъектахОбменаФСС);
	Запрос.УстановитьПараметр("ТипыСообщенийТребований", ТипыСообщенийТребований);
	Запрос.УстановитьПараметр("ТипыСообщенийУведомлений", ТипыСообщенийУведомлений);
	Запрос.УстановитьПараметр("ТриМесяцаНазад", ДатаСеанса - ТриМесяца);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ТипыТранспортныхСообщенийЦБ() Экспорт
	
	Типы = Новый Массив;
	Типы.Добавить(Перечисления.ТипыТранспортныхСообщений.ПервичноеСообщениеСодержащееОтчетностьЦБ);
	Типы.Добавить(Перечисления.ТипыТранспортныхСообщений.РезультатЗагрузкиЦБ);
	Типы.Добавить(Перечисления.ТипыТранспортныхСообщений.РезультатПриемаДокументЦБ);
	Типы.Добавить(Перечисления.ТипыТранспортныхСообщений.РезультатОбработкиДокументЦБ);
	Типы.Добавить(Перечисления.ТипыТранспортныхСообщений.УведомлениеОбОшибкеЦБ);
	
	Возврат Типы;
	
КонецФункции

Функция ТипыСообщенийИнициированныхФНС() Экспорт
	
	ТипМассивПервичное = Новый Массив;
	ТипМассивПервичное.Добавить(Перечисления.ТипыТранспортныхСообщений.ДокументНО);
	ТипМассивПервичное.Добавить(Перечисления.ТипыТранспортныхСообщений.ПисьмоНО);
	ТипМассивПервичное.Добавить(Перечисления.ТипыТранспортныхСообщений.РассылкаНО);
	
	Возврат ТипМассивПервичное;
	
КонецФункции

Функция ЗапросВыбораСообщенийДляРасшифровки(ПараметрыПоказа = Неопределено) Экспорт
	
	// Внимание!
	// 1. Не делать ВНУТРЕННЕЕ соединения с Справочник.ЦиклыОбмена
	// Для входящих сообщение его еще может не быть!!!!
	// 2. Проверять работу метода Мультирежим.СообщенияДляРасшифровки(Сообщение)
	
	Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Организации.Ссылка КАК Организация,
		|	ТранспортныеСообщения.Ссылка КАК ТранспортноеСообщение,
		|	1 КАК КоличествоСообщений,
		|	УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
		|	УчетныеЗаписи.ЭлектроннаяПодписьВМоделиСервиса КАК ЭлектроннаяПодписьВМоделиСервиса,
		|	УчетныеЗаписи.МодельХраненияЗакрытогоКлюча КАК МодельХраненияЗакрытогоКлюча,
		|	ТранспортныеСообщения.Тип КАК Тип,
		|	ЛОЖЬ КАК Удалить,
		|	УчетныеЗаписи.ЭтоМультиРежим КАК ЭтоМультиРежим,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Отправитель) = ТИП(Справочник.НалоговыеОрганы)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Получатель) = ТИП(Справочник.НалоговыеОрганы)
		|				ИЛИ ЦиклыОбмена.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСФНС)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
		|		КОГДА ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Отправитель) = ТИП(Справочник.ОрганыФСГС)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Получатель) = ТИП(Справочник.ОрганыФСГС)
		|				ИЛИ ЦиклыОбмена.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСФСГС)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
		|		КОГДА ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Отправитель) = ТИП(Справочник.ОрганыПФР)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ТранспортныеСообщения.Получатель) = ТИП(Справочник.ОрганыПФР)
		|				ИЛИ ЦиклыОбмена.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЦикловОбмена.ЦиклОбменаСПФР)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПФР)
		|		КОГДА ТранспортныеСообщения.Тип В (&ТипыТранспортныхСообщенийЦБ)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ЦБ)
		|	КОНЕЦ КАК Направление,
		|	УчетныеЗаписи.ЭтоМультиРежим
		|		И ТранспортныеСообщения.Тип В (&ТипыСообщенийИнициированныхФНС) КАК ТолькоДляШифровальщика"
		+ ?(ПараметрыПоказа = Неопределено ИЛИ НЕ ПараметрыПоказа.ПоказДляДругихПользователей, "", ",
		|	ТранспортныеСообщения.ПротоколСОшибкой КАК ПротоколСОшибкой,
		|	ТранспортныеСообщения.ДатаТранспорта КАК ДатаТранспорта,
		|	ЦиклыОбмена.Тип КАК ТипЦиклаОбмена,
		|	ВЫБОР
		|		КОГДА ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL
		|			ТОГДА ВладельцыОбъектов1СОтчетностиТС.Владелец
		|			ИНАЧЕ ВладельцыОбъектов1СОтчетности.Владелец
		|	КОНЕЦ КАК Владелец,
		|	ВЫБОР
		|		КОГДА ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL
		|			ТОГДА ВладельцыОбъектов1СОтчетностиТС.СодержимоеПроанализировано
		|			ИНАЧЕ ВладельцыОбъектов1СОтчетности.СодержимоеПроанализировано
		|	КОНЕЦ КАК СодержимоеПроанализировано") + "
		|ИЗ
		|	Документ.ТранспортноеСообщение КАК ТранспортныеСообщения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиДокументооборота КАК УчетныеЗаписи
		|		ПО (УчетныеЗаписи.Ссылка = ТранспортныеСообщения.УчетнаяЗапись)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО (УчетныеЗаписи.Ссылка = Организации.УчетнаяЗаписьОбмена)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦиклыОбмена КАК ЦиклыОбмена
		|		ПО (ЦиклыОбмена.Ссылка = ТранспортныеСообщения.ЦиклОбмена)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваТранспортныхСообщений КАК СвойстваТранспортныхСообщений
		|		ПО (СвойстваТранспортныхСообщений.ТранспортноеСообщение = ТранспортныеСообщения.Ссылка)"
		+ ?(ПараметрыПоказа = Неопределено, "", "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВладельцыОбъектов1СОтчетности КАК ВладельцыОбъектов1СОтчетности
		|		ПО (ЦиклыОбмена.Ссылка = ВладельцыОбъектов1СОтчетности.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВладельцыОбъектов1СОтчетности КАК ВладельцыОбъектов1СОтчетностиТС
		|		ПО (ТранспортныеСообщения.Ссылка = ВладельцыОбъектов1СОтчетностиТС.Объект
		|			И ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL)") + "
		|ГДЕ
		|	НЕ УчетныеЗаписи.ОтключитьАвтообмен
		|	И СвойстваТранспортныхСообщений.ТребуетРасшифровки
		|	И НЕ ТранспортныеСообщения.ПометкаУдаления
		|	И ТранспортныеСообщения.ДатаТранспорта >= &ТриМесяцаНазад"
		+ ?(ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
			И НЕ ПараметрыПоказа.ВсеСообщения, "
		|	И ТранспортныеСообщения.ДатаТранспорта <= &ТриРабочихДняНазад", "") + "
		|	И ТранспортныеСообщения.Ссылка В(&Сообщения)
		|	И УчетныеЗаписи.Ссылка В(&ТекущиеУчетныеЗаписиНалогоплательщика)"
		+ ?(ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
			И НЕ ПараметрыПоказа.ВсеСообщения, "
		|	И ТранспортныеСообщения.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.РассылкаНО)
		|	И (ТранспортныеСообщения.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПисьмоВходящееПФР)
		|		ИЛИ ЦиклыОбмена.Тип ЕСТЬ NULL
		|		ИЛИ ЦиклыОбмена.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыЦикловОбмена.РассылкаПФР))
		|	И ТранспортныеСообщения.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.ПисьмоВходящееФСГС)
		|	И ТранспортныеСообщения.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыТранспортныхСообщений.РассылкаФСГС)", "")
		+ ?(ПараметрыПоказа <> Неопределено И ЗначениеЗаполнено(ПараметрыПоказа.Организация), "
		|	И Организации.Ссылка = &Организация", "")
		+ ?(ПараметрыПоказа = Неопределено ИЛИ ПараметрыПоказа.ПоказДляДругихПользователей,
		?(ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей, "
		|	И УчетныеЗаписи.ЭтоМультиРежим", ""), "
		|	И (НЕ УчетныеЗаписи.ЭтоМультиРежим
		|	ИЛИ (ВладельцыОбъектов1СОтчетности.Владелец = &ТекущийПользователь
		|			ИЛИ ВладельцыОбъектов1СОтчетности.Владелец ЕСТЬ NULL)
		|		И (ВладельцыОбъектов1СОтчетностиТС.Владелец = &ТекущийПользователь
		|			ИЛИ ВладельцыОбъектов1СОтчетностиТС.Владелец ЕСТЬ NULL))")
		+ ?(ПараметрыПоказа <> Неопределено, "
		|УПОРЯДОЧИТЬ ПО
		|	ТранспортныеСообщения.Ссылка", "");
	
	Возврат Текст;
	
КонецФункции

Функция СообщенияДляРасшифровки_ПроверитьПрава(Таблица) Экспорт
	
	Отбор = Новый Структура();
	Отбор.Вставить("ЭтоМультиРежим", Истина);
	
	УчетныеЗаписи = Таблица.Скопировать(Отбор, "УчетнаяЗапись");
	УчетныеЗаписи.Свернуть("УчетнаяЗапись");
	УчетныеЗаписи = УчетныеЗаписи.ВыгрузитьКолонку("УчетнаяЗапись");
	
	Для каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		Мультирежим.СообщенияДляРасшифровки_ПроверитьПраваНаУчетнуюЗапись(Таблица, УчетнаяЗапись, Ложь);
	КонецЦикла;
	
	СообщенияДляРасшифровки_УдалитьЛишниеСтроки(Таблица);
	СообщенияДляРасшифровки_УдалитьЛишниеКолонки(Таблица);
	
	Возврат Таблица;
	
КонецФункции

Функция СообщенияДляРасшифровки_УдалитьЛишниеСтроки(Таблица) Экспорт
	
	Отбор = Новый Структура();
	Отбор.Вставить("Удалить", Истина);
	
	НайденныеСтроки = Таблица.НайтиСтроки(Отбор);
	
	Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Таблица.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
КонецФункции

Функция СообщенияДляРасшифровки_УдалитьЛишниеКолонки(Таблица) Экспорт
	
	Таблица.Колонки.Удалить("ТолькоДляШифровальщика");
	Таблица.Колонки.Удалить("Направление");
	Таблица.Колонки.Удалить("ЭтоМультиРежим");
	Таблица.Колонки.Удалить("Удалить");
	
КонецФункции

Функция СообщенияДляРасшифровки_ПроверитьВладельцевУдалитьЛишниеСтроки(Таблица, ПараметрыПоказа = Неопределено) Экспорт
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	// известных владельцев строк представить в виде массива
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		Таблица.Колонки.Добавить("КатегорияСообщения", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Таблица.Колонки.Добавить("МассивВладельцев", Новый ОписаниеТипов("Массив"));
	КоличествоСтрок = Таблица.Количество();
	Для ИндексСКонца = 0 По КоличествоСтрок - 1 Цикл
		СтрокаТаблицы = Таблица[КоличествоСтрок - ИндексСКонца - 1];
		ПредыдущаяСтрокаТаблицы = ?(ИндексСКонца < КоличествоСтрок - 1, Таблица[КоличествоСтрок - ИндексСКонца - 2],
			Неопределено);
		
		Если ПредыдущаяСтрокаТаблицы <> Неопределено
			И СтрокаТаблицы.ТранспортноеСообщение = ПредыдущаяСтрокаТаблицы.ТранспортноеСообщение Тогда
			
			Если ТипЗнч(СтрокаТаблицы.МассивВладельцев) = Тип("Массив") И СтрокаТаблицы.МассивВладельцев.Количество() <> 0 Тогда
				ПредыдущаяСтрокаТаблицы.МассивВладельцев = СтрокаТаблицы.МассивВладельцев;
			ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Владелец) Тогда
				ПредыдущаяСтрокаТаблицы.МассивВладельцев = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТаблицы.Владелец);
			ИначеЕсли ЗначениеЗаполнено(ПредыдущаяСтрокаТаблицы.Владелец) Тогда
				ПредыдущаяСтрокаТаблицы.МассивВладельцев = Новый Массив;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПредыдущаяСтрокаТаблицы.Владелец) Тогда
				ПредыдущаяСтрокаТаблицы.МассивВладельцев.Добавить(ПредыдущаяСтрокаТаблицы.Владелец);
			КонецЕсли;
			
			Если СтрокаТаблицы.СодержимоеПроанализировано = Ложь Тогда
				ПредыдущаяСтрокаТаблицы.СодержимоеПроанализировано = Ложь;
			КонецЕсли;
			
			Таблица.Удалить(СтрокаТаблицы);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Владелец) И (ТипЗнч(СтрокаТаблицы.МассивВладельцев) <> Тип("Массив")
			ИЛИ СтрокаТаблицы.МассивВладельцев.Количество() = 0) Тогда
			
			СтрокаТаблицы.МассивВладельцев = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаТаблицы.Владелец);
		КонецЕсли;
	КонецЦикла;
	
	// при расшифровке сообщений для других пользователей если есть текущий пользователь, то удаляем строку,
	// при расшифровки сообщений для себя если есть пользователи и нет текущего пользователя, то удаляем строку
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		ТаблицаПользователейУчетныхЗаписей = Новый ТаблицаЗначений;
		ТаблицаПользователейУчетныхЗаписей.Колонки.Добавить(
			"УчетнаяЗапись",
			Новый ОписаниеТипов("СправочникСсылка.УчетныеЗаписиДокументооборота"));
		ТаблицаПользователейУчетныхЗаписей.Колонки.Добавить(
			"Пользователь",
			Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	КонецЕсли;
	КоличествоСтрок = Таблица.Количество();
	Для ИндексСКонца = 0 По КоличествоСтрок - 1 Цикл
		СтрокаТаблицы = Таблица[КоличествоСтрок - ИндексСКонца - 1];
		
		Если ТипЗнч(СтрокаТаблицы.МассивВладельцев) = Тип("Массив") И СтрокаТаблицы.МассивВладельцев.Количество() <> 0
			И СтрокаТаблицы.МассивВладельцев.Найти(ТекущийПользователь) = Неопределено Тогда
			
			Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
				Для каждого Владелец Из СтрокаТаблицы.МассивВладельцев Цикл
					СтрокаПользовательУчетнойЗаписи = ТаблицаПользователейУчетныхЗаписей.Добавить();
					СтрокаПользовательУчетнойЗаписи.УчетнаяЗапись 	= СтрокаТаблицы.УчетнаяЗапись;
					СтрокаПользовательУчетнойЗаписи.Пользователь 	= Владелец;
				КонецЦикла;
				
			Иначе
				Таблица.Удалить(СтрокаТаблицы);
			КонецЕсли;
			
		ИначеЕсли ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
			Таблица.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
		И НЕ ПараметрыПоказа.ВсеСообщения Тогда
		
		Если Таблица.Количество() = 0 И ПараметрыПоказа.ПоказДляТекущегоПользователя Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// определяем, сколько дней никто не просматривал диалог нерасшифрованных
		// при изменении текущей даты на компьютере больше, чем на три дня в будущее, сброс
		ТаблицаПользователейУчетныхЗаписей.Свернуть("УчетнаяЗапись, Пользователь");
		КоличествоДнейБезПросмотраНерасшифрованных = Неопределено;
		МаксимальнаяДатаПросмотраНерасшифрованных = Мультирежим.МаксимальнаяДатаПросмотраНерасшифрованных(
			ТаблицаПользователейУчетныхЗаписей);
		Если МаксимальнаяДатаПросмотраНерасшифрованных > ДатаСеанса + 3*24*60*60 Тогда
			МаксимальнаяДатаПросмотраНерасшифрованных = '00010101';
		КонецЕсли;
		Если ЗначениеЗаполнено(МаксимальнаяДатаПросмотраНерасшифрованных) Тогда
			КоличествоДнейБезПросмотраНерасшифрованных = ТребованияФНС.РазностьДатПоКалендарю(
				МаксимальнаяДатаПросмотраНерасшифрованных, ДатаСеанса).Дельта;
			Если ДатаСеанса - НачалоДня(ДатаСеанса) <
				МаксимальнаяДатаПросмотраНерасшифрованных - НачалоДня(МаксимальнаяДатаПросмотраНерасшифрованных) Тогда
				
				КоличествоДнейБезПросмотраНерасшифрованных = КоличествоДнейБезПросмотраНерасшифрованных - 1;
			КонецЕсли;
		КонецЕсли;
		
		Если КоличествоДнейБезПросмотраНерасшифрованных <> Неопределено
			И КоличествоДнейБезПросмотраНерасшифрованных < 1 Тогда
			
			Если ПараметрыПоказа.ПоказДляТекущегоПользователя Тогда
				Возврат Ложь;
			Иначе
				ПараметрыПоказа.ПоказДляДругихПользователей = Ложь;
				Таблица.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей Тогда
		// анализируем дату транспорта
		МаксимальнаяДатаТранспорта = '00010101';
		Для каждого СтрокаТаблицы Из Таблица Цикл
			Если СтрокаТаблицы.ДатаТранспорта > МаксимальнаяДатаТранспорта Тогда
				МаксимальнаяДатаТранспорта = СтрокаТаблицы.ДатаТранспорта;
			КонецЕсли;
		КонецЦикла;
		ПараметрыПоказа.ДниОжидания = (ДатаСеанса - МаксимальнаяДатаТранспорта) / (24*60*60);
		
		// заполняем и анализируем категории
		ЕстьСрочнаяКатегория = Ложь;
		Для каждого СтрокаТаблицы Из Таблица Цикл
			СтрокаТаблицы.КатегорияСообщения =
				ЭлектронныйДокументооборотСКонтролирующимиОрганами.КатегорияТранспортногоСообщения(
				СтрокаТаблицы.Тип,
				СтрокаТаблицы.ПротоколСОшибкой,
				СтрокаТаблицы.ТипЦиклаОбмена,
				Истина);
			Если ЗначениеЗаполнено(СтрокаТаблицы.КатегорияСообщения) И СтрокаТаблицы.КатегорияСообщения <> "Другое" Тогда
				ЕстьСрочнаяКатегория = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПараметрыПоказа.ВсеСообщения И НЕ ЕстьСрочнаяКатегория
			И ПараметрыПоказа.ДниОжидания < 14 И ПараметрыПоказа.ДниОжидания > -14 Тогда
			
			ПараметрыПоказа.ПоказДляДругихПользователей = Ложь;
			Таблица.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СообщенияДляРасшифровки_ЗавершитьПроверкуВладельцевУдалитьЛишниеКолонки(Таблица, ПараметрыПоказа) Экспорт
	
	Если ПараметрыПоказа <> Неопределено Тогда
		Если ПараметрыПоказа.ПоказДляДругихПользователей Тогда
			МассивПользователей = Новый Массив;
			МассивСвойствПользователей = Новый Массив;
			СообщенийПоКатегориям = Новый Соответствие;
			Для каждого СтрокаТаблицы Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрокаТаблицы.КатегорияСообщения) Тогда
					КоличествоСообщений = СообщенийПоКатегориям[СтрокаТаблицы.КатегорияСообщения];
					СообщенийПоКатегориям[СтрокаТаблицы.КатегорияСообщения] =
						?(ЗначениеЗаполнено(КоличествоСообщений), КоличествоСообщений + 1, 1);
				КонецЕсли;
				
				Если ТипЗнч(СтрокаТаблицы.МассивВладельцев) = Тип("Массив") Тогда
					Для каждого Владелец Из СтрокаТаблицы.МассивВладельцев Цикл
						ИндексПользователя = МассивПользователей.Найти(Владелец);
						Если ИндексПользователя = Неопределено Тогда
							МассивПользователей.Добавить(Владелец);
							СтрокаСвойствПользователя = Новый Структура;
							СтрокаСвойствПользователя.Вставить("Пользователь", 							Владелец);
							СтрокаСвойствПользователя.Вставить("СообщенийПоКатегориям", 				Новый Соответствие);
							СтрокаСвойствПользователя.Вставить("Требований", 							0);
							СтрокаСвойствПользователя.Вставить("Уведомлений", 							0);
							СтрокаСвойствПользователя.Вставить("СообщенийСТребованиямиУведомлениями", 	0);
							МассивСвойствПользователей.Добавить(СтрокаСвойствПользователя);
							ИндексПользователя = МассивПользователей.Количество() - 1;
						КонецЕсли;
						КоличествоСообщений =
							МассивСвойствПользователей[ИндексПользователя].СообщенийПоКатегориям[СтрокаТаблицы.КатегорияСообщения];
						МассивСвойствПользователей[ИндексПользователя].СообщенийПоКатегориям[СтрокаТаблицы.КатегорияСообщения] =
							?(ЗначениеЗаполнено(КоличествоСообщений), КоличествоСообщений + 1, 1);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ПараметрыПоказа.Пользователи 			= МассивПользователей;
			ПараметрыПоказа.СвойстваПользователей 	= МассивСвойствПользователей;
			ПараметрыПоказа.СообщенийПоКатегориям 	= СообщенийПоКатегориям;
			
			Таблица.Колонки.Удалить("КатегорияСообщения");
		КонецЕсли;
		
		Таблица.Колонки.Удалить("ПротоколСОшибкой");
		Таблица.Колонки.Удалить("ДатаТранспорта");
		Таблица.Колонки.Удалить("ТипЦиклаОбмена");
		Таблица.Колонки.Удалить("СодержимоеПроанализировано");
	КонецЕсли;
	
КонецПроцедуры

Процедура УточнитьПараметрыПоказаСообщенийТребующихРасшифровки(ПараметрыПоказа) Экспорт
	
	Если ПараметрыПоказа <> Неопределено И ПараметрыПоказа.ПоказДляДругихПользователей
		И НЕ ПараметрыПоказа.ВсеСообщения Тогда
		
		ДатаСеанса = ТекущаяДатаСеанса();
		ДатаПоказа = ХранилищеОбщихНастроек.Загрузить(
			"ДокументооборотСКонтролирующимиОрганами_ДатаРасшифровкаДляДругихПользователей");
		// если дата показа меньше максимально возможной, то, значит, переводили дату, показывать
		Если ДатаПоказа <> Неопределено И ДатаПоказа > ДатаСеанса
			И ДатаПоказа <= ДобавитьМесяц(ДатаСеанса, 1) ИЛИ ДатаПоказа = '39991231' Тогда
			ПараметрыПоказа.ПоказДляДругихПользователей = Ложь;
			ПараметрыПоказа.НикогдаНеПоказыватьДляДругихПользователей = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеИзИнформационнойБазыОбОрганизации(ОрганизацияСсылка, ДатыСообщений)
	
	Результат = Новый Структура;
	
	СвойстваОрганизацииДляОбмена = СвойстваОрганизацииДляОбмена(ОрганизацияСсылка, Истина);
	РегистрационныйНомерФСС = СвойстваОрганизацииДляОбмена.РегистрационныйНомерФСС;
	Результат.Вставить("РегистрационныйНомерФСС", РегистрационныйНомерФСС);
	
	ИндексДаты = 0;
	Если НЕ ЗначениеЗаполнено(ДатыСообщений[0].Дата) Тогда
		ИндексДаты = 1;
	КонецЕсли;
	
	ДатаПоследнегоОбменаСЭДОФСС = Дата(Формат(ДатыСообщений[ИндексДаты].Дата, "ДФ=yyyyMMdd") +
		Формат(ДатыСообщений[ИндексДаты].ВремяНачала, "ДФ=HHmmss"));
	Результат.Вставить("ДатаПоследнегоСеансаОбмена", ДатаПоследнегоОбменаСЭДОФСС);
	
	ИндексДаты = 1;
	
	ТекущаяДатаПолученияСообщений = Дата(
		Формат(ДатыСообщений[ДатыСообщений.Количество() - ИндексДаты].Дата, "ДФ=yyyyMMdd") +
		Формат(ДатыСообщений[ДатыСообщений.Количество() - ИндексДаты].ВремяКонца, "ДФ=HHmmss"));
	Результат.Вставить("ТекущаяДатаПолученияСообщений", ТекущаяДатаПолученияСообщений);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьЗапросИсторическихСообщенийЗаДатуАбонентом(
	ОрганизацияСсылка,
	ДатыСообщений) Экспорт
	
	//<v01:getCountMessageRequest xmlns:v01="http://www.fss.ru/integration/types/sedo/arm/v01">
	//  <!--You have a CHOICE of the next 2 items at this level-->
	//  <recipientId>stringstring</recipientId>
	//  <org>
	//    <!--You have a CHOICE of the next 4 items at this level-->
	//    <ogrn>stringstrings</ogrn>
	//    <inn>stringstring</inn>
	//    <!--Optional:-->
	//    <kpp>stringstr</kpp>
	//    <ogrnip>stringstringstr</ogrnip>
	//    <inn>stringstring</inn>
	//    <snils>stringstrin</snils>
	//    <snils>stringstrin</snils>
	//    <inn>stringstring</inn>
	//    <!--Optional:-->
	//    <regnum>stringstri</regnum>
	//    <inn>stringstring</inn>
	//    <!--Optional:-->
	//    <kpp>stringstr</kpp>
	//  </org>
	//  <period>
	//    <dateFrom>2008-09-29T07:49:45</dateFrom>
	//    <dateTo>2014-09-19T05:18:33</dateTo>
	//  </period>
	//</v01:getCountMessageRequest>
	
	Результат = Новый Структура;
	Результат.Вставить("Содержимое",	"");
	Результат.Вставить("ИмяФайла",		"");
	
	ДанныеДокумента = ДанныеИзИнформационнойБазыОбОрганизации(ОрганизацияСсылка, ДатыСообщений);
	
	Если ДанныеДокумента = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось сформировать запрос исторических данных';
													|en = 'Cannot generate a history data request'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Результат.ИмяФайла = "getCountMessageRequest";
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("utf-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("v01:getCountMessageRequest");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:v01", "http://www.fss.ru/integration/types/sedo/arm/v01");
	
	ЗаписатьУзелXML(ЗаписьXML, "recipientId", ДанныеДокумента.РегистрационныйНомерФСС);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("period");
	// Иногда сообщения могут отправляться "задним числом", поэтому всегда запрашиваем с начала дня.
	ДатаНачала = НачалоДня(ДанныеДокумента.ДатаПоследнегоСеансаОбмена);
	ЗаписатьУзелXML(ЗаписьXML, "dateFrom", XMLДата(ДатаНачала)
		+ "T" + XMLВремя(ДатаНачала));
	ЗаписатьУзелXML(ЗаписьXML, "dateTo", XMLДата(ДанныеДокумента.ТекущаяДатаПолученияСообщений)
		+ "T" + XMLВремя(ДанныеДокумента.ТекущаяДатаПолученияСообщений));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Результат.Содержимое = ЗаписьXML.Закрыть();
	
	Результат.ИмяФайла = Результат.ИмяФайла + ".xml";
	
	Возврат Результат.Содержимое;
	
КонецФункции

#КонецОбласти

