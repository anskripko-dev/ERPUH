
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ОбновитьНастройкиПрав;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбновитьНастройкиПрав Тогда
		
		НастройкаПравДоступаУХ.ОбработатьИзменениеНастройкиПравДоступаВидыОтчетов();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьНастройкиПрав=(НЕ Значение=Константы.ИспользоватьГруппыДоступаКВидамОтчетов.Получить());
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

