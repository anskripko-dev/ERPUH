#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ЭтотОбъект.Значение = Ложь И ЕстьСтрокиОтчетовСВыбраннойОпциейСтатьяВАналитике() Тогда
		ОбщегоНазначенияУХ.ПредупреждениеОбОшибке(Нстр("ru = 'Значение константы не может быть изменено, так как в базе присутствуют строки отчетов с опцией ""Статья указывется в аналитике""!'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьСтрокиОтчетовСВыбраннойОпциейСтатьяВАналитике() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтрокиОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
		|ГДЕ
		|	СтрокиОтчетов.СтатьяУказываетсяВАналитике = &СтатьяУказываетсяВАналитике";
	
	Запрос.УстановитьПараметр("СтатьяУказываетсяВАналитике", Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли