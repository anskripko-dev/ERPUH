#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьТаблицуЭлементовПоОтбору(СправочникОтбор,ТолькоПроверка=Истина,НастройкаСоответствия=Неопределено) Экспорт
	
	ИсточникОбъект=ПолучитьИсточникПоНастройке(СправочникОтбор,НастройкаСоответствия,ТолькоПроверка); 
	
	Возврат  УправлениеОтчетамиУХ.ПолучитьТаблицуДанныхПоИсточнику(Неопределено,ИсточникОбъект,ТолькоПроверка); 
		
КонецФункции // ПолучитьТаблицуЭлементовПоОтбору() 

Функция ПолучитьИсточникПоНастройке(СправочникОтбор,НастройкаСоответствия=Неопределено,ТолькоПроверка=Ложь) Экспорт 
	
	ОтборОбъект=СправочникОтбор.ПолучитьОбъект();
	ИсточникОбъект=Справочники.ИсточникиДанныхДляРасчетов.СоздатьЭлемент();
	
	ЗаполнитьЗначенияСвойств(ИсточникОбъект,ОтборОбъект,,"Ссылка,Родитель,Владелец");
	ИсточникОбъект.Код="Технический";
	ИсточникОбъект.ТипБД=ОтборОбъект.Владелец; 
	ИсточникОбъект.ПотребительРасчета=Справочники.ПоказателиОтчетов.ПустаяСсылка();
	
	ИсточникОбъект.ТаблицаПараметровОтбораБД.Загрузить(ОтборОбъект.ТаблицаПараметровОтбораБД.Выгрузить());
	ИсточникОбъект.УточненияСпособовОпределения.Загрузить(ОтборОбъект.УточненияСпособовОпределения.Выгрузить()); 
	ИсточникОбъект.ОбъектБД=ОтборОбъект.ОбъектБД; 
		
	НоваяСтрока=ИсточникОбъект.ПравилаИспользованияПолейЗапроса.Добавить(); 
	НоваяСтрока.Поле="Ссылка";
	НоваяСтрока.Синоним="Ссылка";
	НоваяСтрока.КодАналитики="Ссылка";
	
	Если НЕ ОтборОбъект.Владелец=Справочники.ТипыБазДанных.ТекущаяИБ Тогда 
		
		Если НастройкаСоответствия=Неопределено Тогда
			
			Запрос=Новый Запрос;
			Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
			|	СоответствиеВнешнимИБ.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
			|ГДЕ
			|	СоответствиеВнешнимИБ.Владелец = &Владелец
			|	И СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ = &ОписаниеОбъектаВИБ";
			
			Запрос.УстановитьПараметр("Владелец",ОтборОбъект.Владелец);
			Запрос.УстановитьПараметр("ОписаниеОбъектаВИБ",ОтборОбъект.ОбъектБД);
			
			Результат=Запрос.Выполнить().Выбрать();
			
			Если Результат.Следующий() Тогда
				
				НастройкаСоответствия=Результат.Ссылка;
				
			КонецЕсли;
			
			Если НастройкаСоответствия=Неопределено Тогда
				
				Возврат Новый ТаблицаЗначений;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.НастройкаСоответствия=НастройкаСоответствия;		
		ИсточникОбъект.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнешниеДанныеСправочники;
		
	Иначе
		
		ИсточникОбъект.СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеСправочники;	
		
	КонецЕсли;
	
	НоваяСтрока.СпособЗаполнения=Перечисления.СпособыЗаполненияПолейИсточника.ПолеИсходнойТаблицы;
	НоваяСтрока.ФиксированноеЗначение = Неопределено;
	
	Возврат ИсточникОбъект;
		
КонецФункции // ПолучитьИсточникПоНастройке() 
	
#КонецЕсли