	Элемент2.ЦветТекста     				= Новый Цвет(255,79,91);
	//Элемент2.Шрифт     						= Новый.ШрифтТекстаИндикатора;
	Элемент2.ГоризонтальноеПоложение 		= ГоризонтальноеПоложениеЭлемента.Центр;
	
	//Добавим картинку ошибки
	Элемент3 = Элементы.Добавить(
	"КартинкаОшибки_"+тОбластьВТаблице.ИмяЭлемента,
	Тип("ДекорацияФормы"),
