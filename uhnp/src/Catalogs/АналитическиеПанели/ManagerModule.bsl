	//Элемент2.Шрифт     						= Новый.ШрифтТекстаИндикатора;
    Элемент4.Гиперссылка    				= Истина;
	Элемент4.ГоризонтальноеПоложение 		= ГоризонтальноеПоложениеЭлемента.Центр;
	Элемент4.Подсказка                      = тОбластьВТаблице.ИнформацияОбОшибке;
	
