	Элемент3.РазмерКартинки = РазмерКартинки.АвтоРазмер;
	Элемент3.Ширина 					= 3;
	Элемент3.Высота 					= 1;	
	Элемент3.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	
	//Добавим гиперссылку об ошибке
	Элемент4 = Элементы.Добавить(
	"СсылкаНаОшибку_"+тОбластьВТаблице.ИмяЭлемента,
