Процедура СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице) Экспорт

	Элементы   = ЭтаФорма.Элементы;
		
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;

	
	ИндексКоманды = тОбластьВТаблице.ИмяСтраницы+"_"+тОбластьВТаблице.ИндексСтроки+"_"+тОбластьВТаблице.ИндексКолонки;
	
	//Добавим главную группу индикатора
	ЭлементГруппа1 = Элементы.Добавить(
	тОбластьВТаблице.ИмяЭлемента,
	Тип("ГруппаФормы"),
	Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ГруппаФормы
	
	ЭлементГруппа1.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппа1.Отображение			= ОтображениеОбычнойГруппы.Нет;
	ЭлементГруппа1.Группировка           = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ЭлементГруппа1.Ширина 					= НастройкиЭлемента.Ширина;
	ЭлементГруппа1.Высота 					= НастройкиЭлемента.Высота;
