КонецПроцедуры	

Процедура СоздатьФреймКартинки(ЭтаФорма,тОбластьВТаблице) Экспорт

	Элементы   = ЭтаФорма.Элементы;
	
	ЭтаФорма.ПоследнийИндексОбъектаИзображение = ЭтаФорма.ПоследнийИндексОбъектаИзображение+1;																				
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ПолеКартинки"+ЭтаФорма.ПоследнийИндексОбъектаИзображение,	Новый ОписаниеТипов("Строка")));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	тОбластьВТаблице.ИмяРеквизитаФормы = "ПолеКартинки"+ЭтаФорма.ПоследнийИндексОбъектаИзображение; 
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;

	//Добавим поле картинки
	Элемент1 = Элементы.Добавить(
	тОбластьВТаблице.ИмяЭлемента,
	Тип("ПолеФормы"),
	Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ПолеФормы
	
	Элемент1.Вид 						= ВидПоляФормы.ПолеКартинки;
	Элемент1.ПутьКДанным 				= тОбластьВТаблице.ИмяРеквизитаФормы;
	
	Если ЗначениеЗаполнено(НастройкиЭлемента.Изображение) Тогда
		ЭтаФорма[тОбластьВТаблице.ИмяРеквизитаФормы] = ПоместитьВоВременноеХранилище(ЗначениеИзСтрокиВнутр(НастройкиЭлемента.Изображение),ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	Элемент1.Ширина 						= НастройкиЭлемента.Ширина;
	Элемент1.Высота 						= НастройкиЭлемента.Высота;	
	Элемент1.РастягиватьПоВертикали     	= НастройкиЭлемента.РастягиватьПоВертикали;
	Элемент1.РастягиватьПоГоризонтали   	= НастройкиЭлемента.РастягиватьПоГоризонтали;
    Элемент1.Рамка             				= Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
	Элемент1.ПоложениеЗаголовка         	= ПоложениеЗаголовкаЭлементаФормы.Нет;
    Элемент1.РазмерКартинки             	= РазмерКартинки.Пропорционально;
	Элемент1.Гиперссылка             		= Истина;
	
	Элемент1.УстановитьДействие("Нажатие", "ЭлементДекорацияНажатие");
	
КонецПроцедуры	

Процедура СоздатьФреймТекстовогоДокумента(ЭтаФорма,тОбластьВТаблице) Экспорт

