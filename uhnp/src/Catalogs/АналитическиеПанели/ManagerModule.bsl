	ИндексКоманды = тОбластьВТаблице.ИмяСтраницы+"_"+тОбластьВТаблице.ИндексСтроки+"_"+тОбластьВТаблице.ИндексКолонки;
	
	//Установим элемент
	 ЭлементДекорация =  Элементы.Добавить(
		тОбластьВТаблице.ИмяЭлемента,
		Тип("ДекорацияФормы"),
		Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ДекорацияФормы
		
    ЭлементДекорация.Вид 						= ВидДекорацииФормы.Картинка;
	ЭлементДекорация.ТекстНевыбраннойКартинки	= Нстр("ru = 'Нажмите на заголовок чтобы выбрать текущий элемент панели'");;
	ЭлементДекорация.Ширина 					= НастройкиЭлемента.Ширина;
	ЭлементДекорация.Высота 					= НастройкиЭлемента.Высота;
    ЭлементДекорация.Рамка                      = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
	ЭлементДекорация.Гиперссылка                = Истина;
	ЭлементДекорация.размерКартинки             = РазмерКартинки.Пропорционально;

	
КонецПроцедуры	


Процедура СоздатьФреймИндикатора(ЭтаФорма,тОбластьВТаблице) Экспорт

	Элементы   = ЭтаФорма.Элементы;
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	ЭтаФорма.ПоследнийИндексОбъектаТабДок = ЭтаФорма.ПоследнийИндексОбъектаТабДок+1;																				
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок,	Новый ОписаниеТипов("ТабличныйДокумент")));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	тОбластьВТаблице.ИмяРеквизитаФормы = "ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок; 
		
	ТабДокРезультат = ЭтаФорма["ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок];
		

	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;

	
	ИндексКоманды = тОбластьВТаблице.ИмяСтраницы+"_"+тОбластьВТаблице.ИндексСтроки+"_"+тОбластьВТаблице.ИндексКолонки;
	
	СтруктураУсловногоОформления = ПолучитьТаблицуДанныхИндикатора(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента);
	
	Если СтруктураУсловногоОформления = Неопределено Тогда		
		СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице);
		Возврат;
	КонецЕсли;
	
		Если НастройкиЭлемента.Свойство("ШаблонВиджета") Тогда
		Результат = НастройкиЭлемента.ШаблонВиджета;
	Иначе	
		Результат = Новый ТабличныйДокумент;
		Результат.Вывести(Справочники.АналитическиеПанели.ПолучитьМакет("ШаблонВиджета"));
	КонецЕсли;	
	
	ЭтаФорма["ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок] = Результат;
	
	ЦветФонаСтраницы  =  ЭтаФорма.Элементы[тОбластьВТаблице.ИмяСтраницы].ЦветФона; // Цвет
	Если ЦветФонаСтраницы.Зеленый =  -1  Тогда
		  ЦветФонаСтраницы = ЦветаСтиля.ЦветФонаФормы;
	КонецЕсли;

	//Установим элемент
	ЭлементДекорация =  Элементы.Добавить(
	тОбластьВТаблице.ИмяЭлемента,
	Тип("ПолеФормы"),
	Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ПолеФормы
	
	ЭлементДекорация.Вид 						= ВидПоляФормы.ПолеТабличногоДокумента;
	ЭлементДекорация.ПутьКДанным 				= тОбластьВТаблице.ИмяРеквизитаФормы;
	
	ЭлементДекорация.Ширина 					= НастройкиЭлемента.Ширина;
	ЭлементДекорация.Высота 					= НастройкиЭлемента.Высота;
	ЭлементДекорация.РастягиватьПоВертикали     = НастройкиЭлемента.РастягиватьПоВертикали;
	ЭлементДекорация.РастягиватьПоГоризонтали   = НастройкиЭлемента.РастягиватьПоГоризонтали;
	ЭлементДекорация.ПоложениеЗаголовка         = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементДекорация.РежимМасштабированияПросмотра  = РежимМасштабированияПросмотра.Обычный;
	
	Если НастройкиЭлемента.Свойство("ВыводитьРамку")
		И НастройкиЭлемента.ВыводитьРамку Тогда		
		ЭлементДекорация.ЦветРамки                  = НастройкиЭлемента.ЦветРамкиЭлемента;
	Иначе		
		ЭлементДекорация.ЦветРамки                  = ЦветФонаСтраницы;		
	КонецЕсли;
	
	ЭлементДекорация.ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
	ЭлементДекорация.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
	
	Если ЭтаФорма.РежимРаботыСДанными Тогда
		ЭлементДекорация.УстановитьДействие("ОбработкаДополнительнойРасшифровки", "ОбработкаРасшифровки");	
	КонецЕсли;
	
	УдаляемыеРисунки = Новый Массив;
	
	Для Каждого СтрРисунок Из Результат.Рисунки Цикл
		
		Если СтрРисунок.Имя = "ОсновноеЗначение" Тогда
			
			Если СтруктураУсловногоОформления.СтруктураУсловногоОформленияОсн.Количество()>0 Тогда
				СтрРисунок.Текст = СтруктураУсловногоОформления.СтруктураУсловногоОформленияОсн.Заголовок;
				//СтрРисунок.Шрифт = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Заголовок;
				//СтрРисунок.ЦветТекста = СтруктураУсловногоОформления.СтруктураУсловногоОформленияОсн.ЦветТекста;
				СтрРисунок.Расшифровка = СтруктураУсловногоОформления.СтруктураУсловногоОформленияОсн.Расшифровка;
			КонецЕсли;
			
		КонецЕсли;	
	
		Если СтрРисунок.Имя = "БазовоеЗначение" Тогда
			Если НастройкиЭлемента.Свойство("Индикатор_ВыводитьБазовоеЗначение")
				И НастройкиЭлемента.Индикатор_ВыводитьБазовоеЗначение 
				И СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Количество()>1 Тогда
	
				СтрРисунок.Текст = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Заголовок;
				//СтрРисунок.ЦветТекста = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.ЦветТекста;			
				СтрРисунок.Расшифровка = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Расшифровка;

			Иначе	
				СтрРисунок.Текст = "";
				СтрРисунок.Расшифровка = "";
				УдаляемыеРисунки.Добавить(СтрРисунок);

			КонецЕсли;		
			
		КонецЕсли;
		
		Если СтрРисунок.Имя = "ЛогоБазовогоЗначения" Тогда
			Если НастройкиЭлемента.Свойство("Индикатор_ВыводитьБазовоеЗначение")
				И НастройкиЭлемента.Индикатор_ВыводитьБазовоеЗначение 
				И НЕ СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Картинка = Неопределено Тогда
				СтрРисунок.Картинка = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Картинка 
			Иначе	
				СтрРисунок.Картинка = Новый Картинка;
				УдаляемыеРисунки.Добавить(СтрРисунок);
			КонецЕсли;		
		КонецЕсли;

		Если СтрРисунок.Имя = "Динамика" Тогда
			Если НастройкиЭлемента.Свойство("ИндикаторВыводитьДинамику") 
				И НастройкиЭлемента.ИндикаторВыводитьДинамику Тогда
				//СтрРисунок.Картинка = СтруктураУсловногоОформления.СтруктураУсловногоОформленияБаз.Картинка;
			Иначе	
				УдаляемыеРисунки.Добавить(СтрРисунок);
			КонецЕсли;		
		КонецЕсли;
		
				
	КонецЦикла;	
	
	Для Каждого СтрУдаляемыйРисунок Из УдаляемыеРисунки Цикл
		  Результат.Рисунки.Удалить(СтрУдаляемыйРисунок);
	КонецЦикла;	
	
	ЭлементДекорация.УстановитьДействие("ОбработкаРасшифровки", "ИндикаторОбработкаРасшифровки");	
	ЭлементДекорация.УстановитьДействие("ОбработкаДополнительнойРасшифровки", "ИндикаторОбработкаДопРасшифровки");	
	
КонецПроцедуры	

Функция ПолучитьТаблицуДанныхИндикатора(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента)
	
	ТаблицаЗначений = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресТаблицыДанных);
	
	ТабДокРезультат = Новый ТабличныйДокумент;
	
	ДополнитьОтборыЭлемента(ЭтаФорма,НастройкиЭлемента,тОбластьВТаблице);
	
	НастройкиЭлемента.НастройкиКомпоновщика.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор",Ложь);
	НастройкиЭлемента.НастройкиКомпоновщика.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных",Ложь);

	
	РабочийКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	РабочийКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ЭтаФорма.URLСхемыНастроек));
	РабочийКомпоновщикНастроек.ЗагрузитьНастройки(НастройкиЭлемента.НастройкиКомпоновщика);
	
	
	
	Попытка
		
		ДанныеРасшифровки = Неопределено;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		//	
		ВнешниеНаборыДанных = Новый Структура;		
		ВнешниеНаборыДанных.Вставить("ИсточникДанныхДляРасчетов", ТаблицаЗначений);
		
		СКДНастройки    = ПолучитьИзВременногоХранилища(ЭтаФорма.URLСхемыНастроек);
		
		//дополним вычисляемыми полями
		//тПолеСКД = СКДНастройки.НаборыДанных[0].Поля.Найти(НастройкиЭлемента.ИсточникДанныхИндикатора);
		//ПолеОсноногоЗначения = СКДНастройки.ВычисляемыеПоля.Добавить();
		//ПолеОсноногоЗначения.ПутьКДанным 	= НастройкиЭлемента.ИсточникДанныхИндикатора+"_";
		//ПолеОсноногоЗначения.Выражение 		= "ВЫБОР КОГДА "+НастройкиЭлемента.ИсточникДанныхИндикатора+"<>0 ТОГДА "+НастройкиЭлемента.ИсточникДанныхИндикатора+" ИНАЧЕ 0 КОНЕЦ";
		//ПолеОсноногоЗначения.ТипЗначения 	= тПолеСКД.ТипЗначения;	
		//ПолеОсноногоЗначения.Заголовок   	= НастройкиЭлемента.ИсточникДанныхИндикатора+"_";;
		//
		//Если НЕ НастройкиЭлемента.ИсточникДанныхИндикатораБаза = "" Тогда
		//	
		//	тПолеСКД = СКДНастройки.НаборыДанных[0].Поля.Найти(НастройкиЭлемента.ИсточникДанныхИндикатораБаза);
		//	ПолеОсноногоЗначения = СКДНастройки.ВычисляемыеПоля.Добавить();
		//	ПолеОсноногоЗначения.ПутьКДанным 	= НастройкиЭлемента.ИсточникДанныхИндикатораБаза+"_База";
		//	ПолеОсноногоЗначения.Выражение 		= "ВЫБОР КОГДА "+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+"<>0 ТОГДА "+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+" ИНАЧЕ 0 КОНЕЦ";

		//	Если НастройкиЭлемента.Свойство("ВариантОтображенияБазовогоЗначения") Тогда
		//		Если  НастройкиЭлемента.ВариантОтображенияБазовогоЗначения = 2 Тогда
		//			
		//			ПолеОсноногоЗначения.Выражение = "ВЫБОР КОГДА ("+НастройкиЭлемента.ИсточникДанныхИндикатора-НастройкиЭлемента.ИсточникДанныхИндикатораБаза+")<>0 
		//			|ТОГДА "+НастройкиЭлемента.ИсточникДанныхИндикатора+"-"+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+" ИНАЧЕ 0 КОНЕЦ";
		//			
		//		ИначеЕсли НастройкиЭлемента.ВариантОтображенияБазовогоЗначения = 3 Тогда
		//			
		//			ПолеОсноногоЗначения.Выражение = "ВЫБОР КОГДА ("+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+") = 0 
		//			|ТОГДА 0 ИНАЧЕ "+"
		//			|100*(("+НастройкиЭлемента.ИсточникДанныхИндикатора+"-"+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+")/
		//			|"+НастройкиЭлемента.ИсточникДанныхИндикатораБаза+") КОНЕЦ";
		//			
		//		КонецЕсли;
		//			
		//	КонецЕсли;
		//	
		//	ПолеОсноногоЗначения.ТипЗначения 	= тПолеСКД.ТипЗначения;	
		//	ПолеОсноногоЗначения.Заголовок   	= НастройкиЭлемента.ИсточникДанныхИндикатора+"_База";;
		//			
		//КонецЕсли;	
		    		
		Если НЕ ЭтаФорма.РежимРаботыСДанными Тогда
			ПреобразоватьНастройкиСКДДляТестовыхДанных(РабочийКомпоновщикНастроек.Настройки);
		КонецЕсли;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СКДНастройки, РабочийКомпоновщикНастроек.Настройки, ДанныеРасшифровки);
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
		//Создадим и инициализируем процессор вывода результата
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДокРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
			тОбластьВТаблице.АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки,ЭтаФорма.УникальныйИдентификатор);	
		КонецЕсли;

		//читаем оформление основного поля
		СтруктураУсловногоОформления 		= Новый Структура;
		СтруктураУсловногоОформленияОсн     = Новый Структура;
		СтруктураУсловногоОформленияБаз     = Новый Структура;
        СтруктураУсловногоОформленияБаз.Вставить("Картинка",Неопределено);
	
		
		Для Инд =2 По ТабДокРезультат.ВысотаТаблицы Цикл 
			тЯчейка = ТабДокРезультат.Область(Инд,1);
			
			Если ТипЗнч(тЯчейка.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных")
				И СтруктураУсловногоОформленияОсн.Количество() = 0 Тогда
				
				СтруктураУсловногоОформленияОсн.Вставить("Заголовок",тЯчейка.Текст);			
				СтруктураУсловногоОформленияОсн.Вставить("ЦветТекста",тЯчейка.ЦветТекста);
				СтруктураУсловногоОформленияОсн.Вставить("Шрифт",тЯчейка.Шрифт);
				СтруктураУсловногоОформленияОсн.Вставить("ЦветФона",тЯчейка.ЦветФона);		
				СтруктураУсловногоОформленияОсн.Вставить("Расшифровка",тЯчейка.Расшифровка);		
				СтруктураУсловногоОформленияОсн.Вставить("Формат",тЯчейка.Формат);
				
				
				Если ТипЗнч(СтруктураУсловногоОформленияОсн.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
					СтруктураУсловногоОформленияОсн.Вставить("тЗначение", ДанныеРасшифровки.Элементы[СтруктураУсловногоОформленияОсн.Расшифровка].ПолучитьПоля()[0].Значение);
				Иначе	
					СтруктураУсловногоОформленияОсн.Вставить("тЗначение",0);
				КонецЕсли;	
				
				Продолжить;
				
			КонецЕсли;	
			
			Если ТипЗнч(тЯчейка.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
				
				СтруктураУсловногоОформленияБаз.Вставить("Заголовок",тЯчейка.Текст);			
				СтруктураУсловногоОформленияБаз.Вставить("ЦветТекста",тЯчейка.ЦветТекста);
				СтруктураУсловногоОформленияБаз.Вставить("Шрифт",тЯчейка.Шрифт);
				СтруктураУсловногоОформленияБаз.Вставить("Картинка",тЯчейка.Картинка);
				СтруктураУсловногоОформленияБаз.Вставить("ЦветФона",тЯчейка.ЦветФона);
				СтруктураУсловногоОформленияБаз.Вставить("Расшифровка",тЯчейка.Расшифровка);		
				СтруктураУсловногоОформленияБаз.Вставить("Формат",тЯчейка.Формат);
				
				Если ТипЗнч(СтруктураУсловногоОформленияБаз.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
					СтруктураУсловногоОформленияБаз.Вставить("тЗначение", ДанныеРасшифровки.Элементы[СтруктураУсловногоОформленияБаз.Расшифровка].ПолучитьПоля()[0].Значение);
				Иначе	
					СтруктураУсловногоОформленияБаз.Вставить("тЗначение",0);
				КонецЕсли;	
				
				СтруктураУсловногоОформления.Вставить("СтруктураУсловногоОформленияБаз",СтруктураУсловногоОформленияБаз);
				
			КонецЕсли;			
		КонецЦикла;
		
		Если ТабДокРезультат.Рисунки.Количество() = 1 Тогда 
			ТабДокРезультат.Рисунки[0].Объект.ОтображатьЛегенду = Ложь;
			ТабДокРезультат.Рисунки[0].Объект.ОбластьПостроения.ОтображатьПодписиШкалыЗначений = Ложь;
			ТабДокРезультат.Рисунки[0].Объект.ОтображатьЗаголовок = Ложь;
			
			ТабДокРезультат.Рисунки[0].Объект.ОбластьПостроения.ШкалаТочек.Отображение = ОтображениевДиаграмме.НеОтображать;
			
			СтруктураУсловногоОформления.Вставить("ДинамикаДиаграмма",ТабДокРезультат.Рисунки[0].Объект);
		КонецЕсли;	
			
		
		Если НастройкиЭлемента.Свойство("ВариантОтображенияБазовогоЗначения") 
			И СтруктураУсловногоОформленияОсн.Свойство("тЗначение")
			И СтруктураУсловногоОформленияБаз.Свойство("тЗначение") Тогда
			
			Если НастройкиЭлемента.ВариантОтображенияБазовогоЗначения = 2 Тогда
				ЗначениеОтклонения = СтруктураУсловногоОформленияОсн.тЗначение - СтруктураУсловногоОформленияБаз.тЗначение;
				//СтруктураУсловногоОформленияБаз.Заголовок = СтрЗаменить(СтруктураУсловногоОформленияБаз.Заголовок,Строка(СтруктураУсловногоОформленияБаз.тЗначение),ЗначениеОтклонения);
				СтруктураУсловногоОформленияБаз.Заголовок = Формат(ЗначениеОтклонения,СтруктураУсловногоОформленияБаз.Формат);

				
			ИначеЕсли  НастройкиЭлемента.ВариантОтображенияБазовогоЗначения = 3 Тогда
				
				Если СтруктураУсловногоОформленияБаз.тЗначение = 0 Тогда
					ЗначениеОтклонения = 0;
				Иначе	
					ЗначениеОтклонения = Окр(100*((СтруктураУсловногоОформленияОсн.тЗначение - СтруктураУсловногоОформленияБаз.тЗначение)/СтруктураУсловногоОформленияБаз.тЗначение),2);
				КонецЕсли;	
				СтруктураУсловногоОформленияБаз.Заголовок = Формат(ЗначениеОтклонения,СтруктураУсловногоОформленияБаз.Формат);

				
			КонецЕсли;	
			
		КонецЕсли;	

		
		СтруктураУсловногоОформления.Вставить("СтруктураУсловногоОформленияОсн",СтруктураУсловногоОформленияОсн);
		СтруктураУсловногоОформления.Вставить("СтруктураУсловногоОформленияБаз",СтруктураУсловногоОформленияБаз);
				
		Возврат СтруктураУсловногоОформления;	
		
	Исключение	
		
		тОбластьВТаблице.ИнформацияОбОшибке  = ОписаниеОшибки();	
		Возврат Неопределено;
		
	КонецПопытки;
	
	
КонецФункции	


Процедура СоздатьФреймДиаграммыГанта(ЭтаФорма,тОбластьВТаблице) Экспорт
	
	Элементы = ЭтаФорма.Элементы;
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	ЭтаФорма.ПоследнийИндексОбъектаДиаграмма = ЭтаФорма.ПоследнийИндексОбъектаДиаграмма+1;																				
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма,	Новый ОписаниеТипов("ДиаграммаГанта")));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	тОбластьВТаблице.ИмяРеквизитаФормы = "Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма; 
	
	Результат = ПолучитьДанныеДиаграммыГанта(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента);
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;
			
	Если Результат = Неопределено Тогда		
		СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице);
	Иначе	
		
		ЭтаФорма["Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма] = Результат;
		//Установим поле диаграммы
		ЭлементДекорация =  Элементы.Добавить(
		тОбластьВТаблице.ИмяЭлемента,
		Тип("ПолеФормы"),
		Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ПолеФормы
		
		ЭлементДекорация.Вид 						= ВидПоляФормы.ПолеДиаграммыГанта;
		ЭлементДекорация.ПутьКДанным 				= тОбластьВТаблице.ИмяРеквизитаФормы ;
		
		ЭлементДекорация.Ширина 					= НастройкиЭлемента.Ширина;
		ЭлементДекорация.Высота 					= НастройкиЭлемента.Высота;
		ЭлементДекорация.РастягиватьПоВертикали     = НастройкиЭлемента.РастягиватьПоВертикали;
		ЭлементДекорация.РастягиватьПоГоризонтали   = НастройкиЭлемента.РастягиватьПоГоризонтали;
		ЭлементДекорация.ПоложениеЗаголовка         = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
				
									
		КонецЕсли;
		
		//ЭлементДекорация.УстановитьДействие("ОбработкаРасшифровки", "ДиаграммаОбработкаРасшифровки");	
		
	КонецЕсли;	
	
		
КонецПроцедуры	

Функция ПолучитьДанныеДиаграммыГанта(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента)
	
	ТаблицаЗначений = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресТаблицыДанных);
	
	ОтборПоПроекту = "";
	ВыводимыйДокумент = Новый ДиаграммаГанта;
	
	Если НастройкиЭлемента.Свойство("ВыводитьРамку")
		И НастройкиЭлемента.ВыводитьРамку Тогда
		
		ВыводимыйДокумент.Рамка  	= Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
		ВыводимыйДокумент.ЦветРамки = НастройкиЭлемента.ЦветРамкиЭлемента;
		
	КонецЕсли;

	Попытка
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
			ОбработкаГант = Обработки.ДиаграммаГантаОперации.Создать();
			ОбработкаГант.Проект = ОтборПоПроекту;
			ОбработкаГант.ДатаНач = ЭтаФорма.ПериодОтчета.ДатаНачала;
			ОбработкаГант.ДатаКон = ЭтаФорма.ПериодОкончания.ДатаОкончания;
			ДанныеОбъекта = Новый Структура;
			ДанныеОбъекта.Вставить("Проект", ОтборПоПроекту);
			ОбработкаГант.СформироватьОтчетПоПоказателям(ВыводимыйДокумент, ДанныеОбъекта, ЭтаФорма.Сценарий);
			
			Возврат ВыводимыйДокумент;
			
		Иначе	
			
			Возврат ВыводимыйДокумент;
			
		КонецЕсли;
		
	Исключение	
		
		тОбластьВТаблице.ИнформацияОбОшибке  = ОписаниеОшибки();	
		Возврат Неопределено;
		
	КонецПопытки;
	
	
КонецФункции	


Процедура ОбновитьФреймДиаграммы(ЭтаФорма,тОбластьВТаблице,ТабДокумент = Неопределено) Экспорт
	
	Элементы = ЭтаФорма.Элементы;
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
			
	Результат = ПолучитьТаблицуДанныхДиаграммы(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента,ТабДокумент);
	
	Если Результат = Неопределено Тогда
		СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице);
	Иначе	
		ЭтаФорма[тОбластьВТаблице.ИмяРеквизитаФормы] = Результат;
	КонецЕсли;	
		
	
КонецПроцедуры	

