  
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
  
  
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	
	Если НЕ ВидФормы = "ФормаОбъекта"  Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если (Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ))
		ИЛИ Параметры.Свойство("АдресПараметровИнициализации") Тогда
		
		// Открытие созданной ранее панели
		ВыбраннаяФорма = "ФормаНастройкиПанели";
		
	ИначеЕсли Параметры.Свойство("ЗначениеКопирования") 
		И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда	
		
		// Копирование документа
			ВыбраннаяФорма = "ФормаНастройкиПанели";		
	Иначе
		
		ВыбраннаяФорма = "ФормаСозданияНовойПанели";
		
	КонецЕсли;
	
КонецПроцедуры


#Область ВыводЭлементовПанели

Процедура ЗаполнитьПанельПоРазметке(ЭтаФорма,ИмяСтраницы = Неопределено,СоздаватьЭлементы = Истина) Экспорт
		
	ЭтаФорма.РазметкаПанели.Сортировать("ИмяСтраницы,ИндексСтроки,ИндексКолонки");
	
	тРазметка = ЭтаФорма.РазметкаПанели.Выгрузить();
	
	тИмяСтраницы  = Неопределено;
	
	Для Каждого СтрРазметки Из тРазметка Цикл
		
		Если НЕ ИмяСтраницы = Неопределено 
			И  НЕ ИмяСтраницы = СтрРазметки.ИмяСтраницы Тогда
			Продолжить;
		КонецЕсли;	
		
		
		Если  НЕ тИмяСтраницы = СтрРазметки.ИмяСтраницы Тогда
			 тИмяСтраницы  	= СтрРазметки.ИмяСтраницы;
			 СтрокаКоманды  = 0;
		КонецЕсли;	
		
		КолонкаКоманды = СтрРазметки.ИндексКолонки;
			
		Если НЕ СтрокаКоманды  = СтрРазметки.ИндексСтроки Тогда
			СтрокаКоманды  = СтрРазметки.ИндексСтроки;
			ДобавитьСтрокуРазметкиСервер(ЭтаФорма,СтрРазметки,СтрРазметки.ИмяСтраницы);
		Иначе	
			ДобавитьЭлементНаФорму(ЭтаФорма,СтрРазметки);
		КонецЕсли;
					
	КонецЦикла;	
	
	Этаформа.РазметкаПанели.Загрузить(тРазметка);

КонецПроцедуры	

Процедура ОбновитьПанельПоРазметке(ЭтаФорма,ИмяСтраницы = Неопределено) Экспорт
		
	ЭтаФорма.РазметкаПанели.Сортировать("ИмяСтраницы,ИндексСтроки,ИндексКолонки");
	
	тРазметка = ЭтаФорма.РазметкаПанели.Выгрузить();
	
	тИмяСтраницы  = Неопределено;
	
	Для Каждого СтрокаЭлемента Из тРазметка Цикл
		
		Если НЕ ИмяСтраницы = Неопределено 
			И  НЕ ИмяСтраницы = СтрокаЭлемента.ИмяСтраницы Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
			
			ОбновитьФреймТаблицы(ЭтаФорма,СтрокаЭлемента);
			
		ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПустаяСсылка() Тогда
					
		ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда	
			
			СоздатьФреймИндикатора(ЭтаФорма,СтрокаЭлемента);	   
			
		ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда
			
		ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда
			
		Иначе 
			//Поле диаграммы
			ОбновитьФреймДиаграммы(ЭтаФорма,СтрокаЭлемента);	
		КонецЕсли;
		
					
	КонецЦикла;	
	
	Этаформа.РазметкаПанели.Загрузить(тРазметка);


КонецПроцедуры	

Процедура ДобавитьСтрокуРазметкиСервер(ЭтаФорма,СтрокаРазметки = Неопределено,СтраницаРазметки = Неопределено) Экспорт

   Элементы	             = ЭтаФорма.Элементы;
   ПоследнийИндексСтроки = 0;	
   
   Если СтраницаРазметки = Неопределено Тогда
	    СтраницаРазметки = ЭтаФорма.ТекущаяСтраницаИмя;
   КонецЕсли;	   
   
   //добавить строку в разметку панели
   Если СтрокаРазметки  = Неопределено Тогда
	   нСтр 				= ЭтаФорма.РазметкаПанели.Добавить();
	   нСтр.ИмяСтраницы     = СтраницаРазметки;
	   нСтр.ИндексСтроки    = ЭтаФорма.СтрокаКоманды+1;
	   нСтр.ИндексКолонки   = 1;
	   нСтр.ИмяЭлемента     	= "Элемент_"+СтраницаРазметки+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
	   нСтр.ИмяГруппыЭлемента  	= "ЭлементГруппа_"+СтраницаРазметки+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
	   нСтр.ЗаголовокЭлемента   = Нстр("ru = 'Новый элемент'");
   Иначе	   
	  нСтр  = СтрокаРазметки;
   КонецЕсли;
   
   //добавить группу элементов текущей строки
   ЭлементРодитель = Элементы[СтраницаРазметки];	
		
   Если Элементы.Найти(СтраницаРазметки+"_Строка"+нСтр.ИндексСтроки) = Неопределено Тогда
	   
	   ЭлементГруппа = Элементы.Добавить(
	   СтраницаРазметки+"_Строка"+нСтр.ИндексСтроки,
	   Тип("ГруппаФормы"),
	   ЭлементРодитель); // ГруппаФормы
	   
	   ЭлементГруппа.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
	   ЭлементГруппа.Группировка	        = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	   ЭлементГруппа.ВертикальныйИнтервал   = ИнтервалМеждуЭлементамиФормы.Нет;
       ЭлементГруппа.ОтображатьЗаголовок  	= Ложь;

	   
   КонецЕсли;
   
   //Добавить первую колонку с элементом		
   ДобавитьЭлементНаФорму(ЭтаФорма,нСтр);
   
   Если Не ЭтаФорма.РежимРаботыСДанными Тогда
	   ОбновитьРасположениеКнопкиДобавленияНовойСтроки(ЭтаФорма,нСтр,1);
   КонецЕсли;
   
КонецПроцедуры	

Процедура ДобавитьЭлементНаФорму(ЭтаФорма,СтрокаЭлемента) Экспорт

   Элементы	       = ЭтаФорма.Элементы;
   ЭлементРодитель = Элементы[СтрокаЭлемента.ИмяСтраницы+"_Строка"+СтрокаЭлемента.ИндексСтроки];	
		
    //Заполним структуру свойств в текущей строке разметки 
   Если Не ЗначениеЗаполнено(СтрокаЭлемента.НастройкиЭлемента) Тогда
	   СтрокаЭлемента.НастройкиЭлемента =  ПолучитьНастройкиОбъектаПоУмолчанию();
   КонецЕсли;
   
   Если Не ЗначениеЗаполнено(СтрокаЭлемента.ИдентификаторОбъекта) Тогда
	    СтрокаЭлемента.ИдентификаторОбъекта = Новый УникальныйИдентификатор;
   КонецЕсли;	   
   
   тНастройки = ЗначениеИзСтрокиВнутр(СтрокаЭлемента.НастройкиЭлемента);
   
   Если Не Элементы.Найти(СтрокаЭлемента.ИмяГруппыЭлемента) = Неопределено Тогда
	    Элементы.Удалить(Элементы[СтрокаЭлемента.ИмяГруппыЭлемента]);
   КонецЕсли;	   
	   
   
   //Создадим поле заголовка фрейма
   ЭлементГруппа = Элементы.Добавить(
   СтрокаЭлемента.ИмяГруппыЭлемента,
   Тип("ГруппаФормы"),
   ЭлементРодитель); // ГруппаФормы
   
   ЭлементГруппа.Вид 								= ВидГруппыФормы.ОбычнаяГруппа;
   ЭлементГруппа.Отображение						= ОтображениеОбычнойГруппы.СлабоеВыделение;
   ЭлементГруппа.ОтображатьЗаголовок  				= Ложь;
   ЭлементГруппа.Группировка                        = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
   ЭлементГруппа.ВертикальныйИнтервал               = ИнтервалМеждуЭлементамиФормы.Половинный;
   
   //Создадим поле надписи заголовка
   ЭлементЗаголовка = Элементы.Добавить(
   "Заголовок_"+СтрокаЭлемента.ИмяЭлемента,
   Тип("ДекорацияФормы"),
   ЭлементГруппа); // ДекорацияФормы
   
   ЭлементЗаголовка.Вид 			= ВидДекорацииФормы.Надпись;
   
   УстановитьСвойстваЗаголовкаФрейма(СтрокаЭлемента.ЗаголовокЭлемента,ЭлементЗаголовка,тНастройки,СтрокаЭлемента.СкрытьЗаголовокЭлемента);
   
   ЭлементЗаголовка.УстановитьДействие("Нажатие", "ИзменитьСвойстваОбласти");	
   
   
   Если СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
	   
	   СоздатьФреймТаблицы(ЭтаФорма,СтрокаЭлемента);
	   
   ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПустаяСсылка() Тогда
	   
	   СоздатьФреймПустогоПоля(ЭтаФорма,СтрокаЭлемента);
	   
   ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда	
		
		СоздатьФреймИндикатора(ЭтаФорма,СтрокаЭлемента);	   
	   
   ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда
	   
	    СоздатьФреймТекстовогоДокумента(ЭтаФорма,СтрокаЭлемента);

   ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда
	   
        СоздатьФреймДиаграммыГанта(ЭтаФорма,СтрокаЭлемента);
	   
   ИначеЕсли СтрокаЭлемента.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда
	   
	   	СоздатьФреймКартинки(ЭтаФорма,СтрокаЭлемента);	   
	   
   Иначе 
	   //Поле диаграммы
	   СоздатьФреймДиаграммы(ЭтаФорма,СтрокаЭлемента);
   КонецЕсли;

   Если НЕ ЭтаФорма.РежимРаботыСДанными Тогда 
	   ОбновитьРасположениеКнопкиДобавленияНовойКолонки(ЭтаФорма,СтрокаЭлемента,1);
   КонецЕсли;
   
КонецПроцедуры

Процедура ОбновитьРасположениеКнопкиДобавленияНовойКолонки(ЭтаФорма,СтрокаЭлемента,Направление)

	Элементы = ЭтаФорма.Элементы;
	
	Если Направление = 1 Тогда
				
		ЭлементРодитель =  Элементы[СтрокаЭлемента.ИмяСтраницы+"_Строка"+СтрокаЭлемента.ИндексСтроки];
	
		Если СтрокаЭлемента.ИндексКолонки>1 Тогда  
			ПредыдущаяКнопка = "ДобавитьКолонку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+(СтрокаЭлемента.ИндексКолонки-1); 
			Если НЕ Элементы.Найти(ПредыдущаяКнопка) = Неопределено Тогда
				Элементы.Удалить(Элементы[ПредыдущаяКнопка]);
			КонецЕсли;	
		КонецЕсли;
		
		ИмяНовойКнопки = "ДобавитьКолонку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+СтрокаЭлемента.ИндексКолонки;
		
		Если Элементы.Найти("ДобавитьСтроку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+СтрокаЭлемента.ИндексКолонки) = Неопределено Тогда
					
			НоваяКнопка = Элементы.Добавить(
			"ДобавитьКолонку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+СтрокаЭлемента.ИндексКолонки
			,Тип("КнопкаФормы")
			,ЭлементРодитель); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДобавитьКолонкуРазметки";
			НоваяКнопка.Отображение = ОтображениеКнопки.Картинка;
			
		КонецЕсли;

	КонецЕсли;	
	
	
КонецПроцедуры	

Процедура ОбновитьРасположениеКнопкиДобавленияНовойСтроки(ЭтаФорма,СтрокаЭлемента,Направление)

	Элементы = ЭтаФорма.Элементы;
	
	Если Направление = 1 Тогда
				
		ЭлементРодитель =  Элементы[СтрокаЭлемента.ИмяСтраницы];
	
		Если СтрокаЭлемента.ИндексСтроки>1 Тогда  		
			ПредыдущаяКнопка = "ДобавитьСтроку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+(СтрокаЭлемента.ИндексСтроки-1)+"_"+СтрокаЭлемента.ИндексКолонки; 
			Если НЕ Элементы.Найти(ПредыдущаяКнопка) = Неопределено Тогда	
				Элементы.Удалить(Элементы[ПредыдущаяКнопка]);
			КонецЕсли;	
		КонецЕсли;
		
		Если Элементы.Найти("ДобавитьСтроку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+СтрокаЭлемента.ИндексКолонки) = Неопределено Тогда
			НоваяКнопка = Элементы.Добавить(
			"ДобавитьСтроку"+"_"+СтрокаЭлемента.ИмяСтраницы+"_"+СтрокаЭлемента.ИндексСтроки+"_"+СтрокаЭлемента.ИндексКолонки
			,Тип("КнопкаФормы")
			,ЭлементРодитель); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДобавитьСтрокуРазметки";
			НоваяКнопка.Отображение = ОтображениеКнопки.Картинка;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	
КонецПроцедуры	

Функция ПолучитьНастройкиОбъектаПоУмолчанию(ТипОбъекта = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("Ширина",							25);
	Параметры.Вставить("Высота",							8);
    Параметры.Вставить("РастягиватьПоВертикали",			Ложь);
	Параметры.Вставить("РастягиватьПоГоризонтали",			Ложь);
    Параметры.Вставить("АвтомаксимальнаяВысота",			Истина);
	Параметры.Вставить("АвтомаксимальнаяШирина",			Истина);
	Параметры.Вставить("МаксимальнаяВысота",				0);
	Параметры.Вставить("МаксимальнаяШирина",				0);
   	
    Параметры.Вставить("НастройкиКомпоновщика",				Неопределено);

	Возврат ЗначениеВСтрокуВнутр(Параметры);
	
КонецФункции	

Процедура УстановитьСвойстваЗаголовкаФрейма(ЗаголовокЭлемента,ЭлементЗаголовка,тНастройки,СкрытьЗаголовокЭлемента) Экспорт  
	
	ЭлементЗаголовка.Заголовок 		= ЗаголовокЭлемента;;
	
	//Если тНастройки.Свойство("ШрифтЗаголовка") Тогда 
	//	ЭлементЗаголовка.Шрифт     		= тНастройки.ШрифтЗаголовка;
	//КонецЕсли;	
	
	Если тНастройки.Свойство("ЦветФонаЗаголовка") Тогда 
		ЭлементЗаголовка.ЦветФона     		= тНастройки.ЦветФонаЗаголовка;
	КонецЕсли;	
	
	Если тНастройки.Свойство("ЦветТекстаЗаголовка") Тогда 
		ЭлементЗаголовка.ЦветТекста     		= тНастройки.ЦветТекстаЗаголовка;
	КонецЕсли;	
		
	ЭлементЗаголовка.Гиперссылка    = Истина;
	ЭлементЗаголовка.ГоризонтальноеПоложение 		= ГоризонтальноеПоложениеЭлемента.Лево;
    ЭлементЗаголовка.РастягиватьПоГоризонтали       = Истина;
	ЭлементЗаголовка.АвтоМаксимальнаяШирина         = Ложь;
	ЭлементЗаголовка.Видимость                      = НЕ СкрытьЗаголовокЭлемента;
	
	Если тНастройки.РастягиватьПоГоризонтали Тогда
		ЭлементЗаголовка.МаксимальнаяШирина                         = 0;	
	Иначе
		ЭлементЗаголовка.МаксимальнаяШирина                         = тНастройки.Ширина;	
	КонецЕсли;	

КонецПроцедуры	


Процедура СоздатьФреймДиаграммы(ЭтаФорма,тОбластьВТаблице) Экспорт
	
	Элементы = ЭтаФорма.Элементы;
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	ЭтаФорма.ПоследнийИндексОбъектаДиаграмма = ЭтаФорма.ПоследнийИндексОбъектаДиаграмма+1;																				
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма,	Новый ОписаниеТипов("Диаграмма")));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	тОбластьВТаблице.ИмяРеквизитаФормы = "Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма; 
	
	Результат = ПолучитьТаблицуДанныхДиаграммы(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента);
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;
			
	Если Результат = Неопределено Тогда		
		СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице);
	Иначе	
		
		ЭтаФорма["Диаграмма"+ЭтаФорма.ПоследнийИндексОбъектаДиаграмма] = Результат;
		//Установим поле диаграммы
		ЭлементДекорация =  Элементы.Добавить(
		тОбластьВТаблице.ИмяЭлемента,
		Тип("ПолеФормы"),
		Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ПолеФормы
		
		ЭлементДекорация.Вид 						= ВидПоляФормы.ПолеДиаграммы;
		ЭлементДекорация.ПутьКДанным 				= тОбластьВТаблице.ИмяРеквизитаФормы ;
		
		ЭлементДекорация.Ширина 					= НастройкиЭлемента.Ширина;
		ЭлементДекорация.Высота 					= НастройкиЭлемента.Высота;
		ЭлементДекорация.РастягиватьПоВертикали     = НастройкиЭлемента.РастягиватьПоВертикали;
		ЭлементДекорация.РастягиватьПоГоризонтали   = НастройкиЭлемента.РастягиватьПоГоризонтали;
		ЭлементДекорация.ПоложениеЗаголовка         = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
				
			НоваяКнопка = Элементы.Добавить(
			"КМ_Открыть"+"_"+тОбластьВТаблице.ИмяЭлемента
			,Тип("КнопкаФормы")
			,ЭлементДекорация.КонтекстноеМеню); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДиаграммаКМОткрытьЗначение";
			НоваяКнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;

			
			НоваяКнопка = Элементы.Добавить(
			"КМ_Расшифровать"+"_"+тОбластьВТаблице.ИмяЭлемента
			,Тип("КнопкаФормы")
			,ЭлементДекорация.КонтекстноеМеню); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДиаграммаКМРасшифроватьЗначение";
			НоваяКнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;
			
		
			НоваяКнопка = Элементы.Добавить(
			"КМ_УстановитьДопОтбор"+"_"+тОбластьВТаблице.ИмяЭлемента
			,Тип("КнопкаФормы")
			,ЭлементДекорация.КонтекстноеМеню); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДиаграммаКМУстановитьОтборПоЗначениям";
			НоваяКнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;
			
			НоваяКнопка = Элементы.Добавить(
			"КМ_СброситьДопОтбор"+"_"+тОбластьВТаблице.ИмяЭлемента
			,Тип("КнопкаФормы")
			,ЭлементДекорация.КонтекстноеМеню); // КнопкаФормы
			
			НоваяКнопка.Вид 		= ВидКнопкиФормы.ОбычнаяКнопка;
			НоваяКнопка.ИмяКоманды 	= "ДиаграммаКМСброситьОтборПоЗначениям";
			НоваяКнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;

			
		КонецЕсли;
		
		ЭлементДекорация.УстановитьДействие("ОбработкаРасшифровки", "ДиаграммаОбработкаРасшифровки");	
		
	КонецЕсли;	
	
		
КонецПроцедуры	

Функция ПолучитьТаблицуДанныхДиаграммы(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента,ТабДокРезультат = Неопределено)
	
	ТаблицаЗначений = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресТаблицыДанных);
	
	Если ТабДокРезультат = Неопределено Тогда
		ТабДокРезультат = Новый ТабличныйДокумент;		
	КонецЕсли;
	
	ДополнитьОтборыЭлемента(ЭтаФорма,НастройкиЭлемента,тОбластьВТаблице);
		
	РабочийКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	РабочийКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ЭтаФорма.URLСхемыНастроек));
	РабочийКомпоновщикНастроек.ЗагрузитьНастройки(НастройкиЭлемента.НастройкиКомпоновщика);
	
	Попытка
		
		ДанныеРасшифровки = Неопределено;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		//	
		ВнешниеНаборыДанных = Новый Структура;		
		ВнешниеНаборыДанных.Вставить("ИсточникДанныхДляРасчетов", ТаблицаЗначений);
		
		СКДНастройки    = ПолучитьИзВременногоХранилища(ЭтаФорма.URLСхемыНастроек);
		
		Если НЕ ЭтаФорма.РежимРаботыСДанными Тогда
			ПреобразоватьНастройкиСКДДляТестовыхДанных(РабочийКомпоновщикНастроек.Настройки);
		КонецЕсли;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СКДНастройки, РабочийКомпоновщикНастроек.Настройки, ДанныеРасшифровки);
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
		//Создадим и инициализируем процессор вывода результата
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДокРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
			тОбластьВТаблице.АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки,ЭтаФорма.УникальныйИдентификатор);	
		КонецЕсли;

		
		Если ТабДокРезультат.Рисунки.Количество()>0 Тогда
			
			Диаграмма =  ТабДокРезультат.Рисунки[0].Объект;						
			
			Если НастройкиЭлемента.Свойство("ВыводитьРамку")
				И НастройкиЭлемента.ВыводитьРамку Тогда
				
				ТабДокРезультат.Рисунки[0].Объект.Рамка  	= Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
				ТабДокРезультат.Рисунки[0].Объект.ЦветРамки = НастройкиЭлемента.ЦветРамкиЭлемента;
				
			КонецЕсли;
			
			Возврат ТабДокРезультат.Рисунки[0].Объект;
			
		КонецЕсли;		
		
	Исключение	
		
		тОбластьВТаблице.ИнформацияОбОшибке  = ОписаниеОшибки();	
		Возврат Неопределено;
		
	КонецПопытки;
	
	
КонецФункции	


Процедура СоздатьФреймТаблицы(ЭтаФорма,тОбластьВТаблице) Экспорт 
	
    Элементы   = ЭтаФорма.Элементы;
	
	НастройкиЭлемента = ЗначениеИзСтрокиВнутр(тОбластьВТаблице.НастройкиЭлемента);
	
	ЭтаФорма.ПоследнийИндексОбъектаТабДок = ЭтаФорма.ПоследнийИндексОбъектаТабДок+1;																				
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок,	Новый ОписаниеТипов("ТабличныйДокумент")));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	тОбластьВТаблице.ИмяРеквизитаФормы = "ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок; 
		
	ТабДокРезультат = ЭтаФорма["ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок];
		
	Результат = ПолучитьТаблицуДанныхТаблицы(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента);
	
	ЦветФонаСтраницы  =  ЭтаФорма.Элементы[тОбластьВТаблице.ИмяСтраницы].ЦветФона; // Цвет
    Если ЦветФонаСтраницы.Зеленый =  -1 Тогда
		  ЦветФонаСтраницы = ЦветаСтиля.ЦветФонаФормы;
	КонецЕсли;
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
		Элементы.Удалить(Элементы[тОбластьВТаблице.ИмяЭлемента]);
	КонецЕсли;	
	
	Если Результат = Неопределено Тогда
		СоздатьФреймОшибкиВывода(ЭтаФорма,тОбластьВТаблице);
	Иначе	
		ЭтаФорма["ТабличныйДокумент"+ЭтаФорма.ПоследнийИндексОбъектаТабДок] = Результат;
		
		//Установим элемент
		ЭлементДекорация =  Элементы.Добавить(
		тОбластьВТаблице.ИмяЭлемента,
		Тип("ПолеФормы"),
		Элементы[тОбластьВТаблице.ИмяГруппыЭлемента]); // ПолеФормы
		
		ЭлементДекорация.Вид 						= ВидПоляФормы.ПолеТабличногоДокумента;
		ЭлементДекорация.ПутьКДанным 				= тОбластьВТаблице.ИмяРеквизитаФормы;
		
		ЭлементДекорация.Ширина 					= НастройкиЭлемента.Ширина;
		ЭлементДекорация.Высота 					= НастройкиЭлемента.Высота;
		ЭлементДекорация.РастягиватьПоВертикали     = НастройкиЭлемента.РастягиватьПоВертикали;
		ЭлементДекорация.РастягиватьПоГоризонтали   = НастройкиЭлемента.РастягиватьПоГоризонтали;
		ЭлементДекорация.ПоложениеЗаголовка         = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементДекорация.РежимМасштабированияПросмотра  = РежимМасштабированияПросмотра.Обычный;
		
		Если НастройкиЭлемента.Свойство("ВыводитьРамку")
			И НастройкиЭлемента.ВыводитьРамку Тогда		
			ЭлементДекорация.ЦветРамки                  = НастройкиЭлемента.ЦветРамкиЭлемента;
		Иначе		
			ЭлементДекорация.ЦветРамки                  = ЦветФонаСтраницы;		
		КонецЕсли;
			
		ЭлементДекорация.ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
		ЭлементДекорация.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
		
		ЭлементДекорация.УстановитьДействие("ОбработкаРасшифровки", "ТаблицаОбработкаРасшифровки");	
		ЭлементДекорация.УстановитьДействие("ОбработкаДополнительнойРасшифровки", "ТаблицаОбработкаДопРасшифровки");	
		
		
	КонецЕсли;	
	
КонецПроцедуры	

Функция ПолучитьТаблицуДанныхТаблицы(ЭтаФорма,тОбластьВТаблице,НастройкиЭлемента)
	
	ТаблицаЗначений = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресТаблицыДанных);
	
	ТабДокРезультат = Новый ТабличныйДокумент;
	
	ДополнитьОтборыЭлемента(ЭтаФорма,НастройкиЭлемента,тОбластьВТаблице);
	
	РабочийКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	РабочийКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ЭтаФорма.URLСхемыНастроек));
	РабочийКомпоновщикНастроек.ЗагрузитьНастройки(НастройкиЭлемента.НастройкиКомпоновщика);
	
	
	Попытка
		
		ДанныеРасшифровки = Неопределено;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		//	
		ВнешниеНаборыДанных = Новый Структура;		
		ВнешниеНаборыДанных.Вставить("ИсточникДанныхДляРасчетов", ТаблицаЗначений);
		
		СКДНастройки    = ПолучитьИзВременногоХранилища(ЭтаФорма.URLСхемыНастроек);
		
		Если НЕ ЭтаФорма.РежимРаботыСДанными Тогда
			ПреобразоватьНастройкиСКДДляТестовыхДанных(РабочийКомпоновщикНастроек.Настройки);
		КонецЕсли;
	
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СКДНастройки, РабочийКомпоновщикНастроек.Настройки, ДанныеРасшифровки);
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
		//Создадим и инициализируем процессор вывода результата
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДокРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		Если ЭтаФорма.РежимРаботыСДанными Тогда
			тОбластьВТаблице.АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки,ЭтаФорма.УникальныйИдентификатор);	
		КонецЕсли;
		
		Возврат ТабДокРезультат;	
		
	Исключение	
		
		тОбластьВТаблице.ИнформацияОбОшибке  = ОписаниеОшибки();	
		Возврат Неопределено;
		
	КонецПопытки;
	
	
КонецФункции	


Процедура СоздатьФреймПустогоПоля(ЭтаФорма,тОбластьВТаблице) Экспорт
	
	Элементы   = ЭтаФорма.Элементы;
	
	Если НЕ Элементы[тОбластьВТаблице.ИмяГруппыЭлемента].ПодчиненныеЭлементы.Найти(тОбластьВТаблице.ИмяЭлемента) = Неопределено Тогда 
