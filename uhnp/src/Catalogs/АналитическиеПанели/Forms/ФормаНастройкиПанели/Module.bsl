КонецПроцедуры	

&НаСервере
Процедура ПрочитатьНастройкиПанели()
	
	 	 
	РазметкаПанели.Загрузить(Объект.РазметкаПанели.Выгрузить());
	
	Для Каждого Выборка Из Объект.СтраницыПанели Цикл
		
		//Создадим элемент
		ЭлементСтраница =  Элементы.Добавить(
		Выборка.ИмяСтраницы,
		Тип("ГруппаФормы"),
		Элементы.ГруппаСтраницыПанели);
		
		ЭлементСтраница.Вид 		= ВидГруппыФормы.Страница;
		ЭлементСтраница.Заголовок 	= Выборка.Заголовок;	 
		ЭлементСтраница.РастягиватьПоГоризонтали = Истина;
		ЭлементСтраница.РастягиватьПоВертикали   = Истина;
		
		ЭлементСтраница.ВертикальныйИнтервал  	= ИнтервалМеждуЭлементамиФормы.Половинный;
		ЭлементСтраница.ГоризонтальныйИнтервал  = ИнтервалМеждуЭлементамиФормы.Половинный;

		Если ЗначениеЗаполнено(Выборка.ЦветФонаСтрока) Тогда
			 ЭлементСтраница.ЦветФона = ЗначениеИзСтрокиВнутр(Выборка.ЦветФонаСтрока);
		КонецЕсли;	
				
		Если НЕ Выборка.Видимость Тогда
			ЭлементСтраница.Картинка 			= БиблиотекаКартинок.ВводимыеСимволыСкрыты;
			ЭлементСтраница.ЦветТекстаЗаголовка 	= Новый Цвет(160,160,160);
		Иначе	 
			ЭлементСтраница.Картинка 				= Новый Картинка;
			ЭлементСтраница.ЦветТекстаЗаголовка 	= Новый Цвет(0,0,0);
		КонецЕсли;
		
		Если Выборка.ИндексСтраницы = 1 Тогда
			ТекущаяСтраница 		 = Выборка.ИмяСтраницы;    
		КонецЕсли;
		
		Если Объект.ОтображатьЗаголовкиСтраниц Тогда
			Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		Иначе	
			Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		КонецЕсли;	
		
	КонецЦикла;

	 
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьНастройкиПанели()
		
	Объект.РазметкаПанели.Очистить();
	Объект.ИспользуемыеИБ.Очистить();
	
	тРазличныеИБ =  Объект.ИспользуемыеИБ.Выгрузить().СкопироватьКолонки();
	
	нстрИБ 						= тРазличныеИБ.Добавить();
	нстрИБ.ИнформационнаяБаза 	= Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ;
	нстрИБ.ТипИБ              	= Справочники.ТипыБазДанных.ТекущаяИБ;	
	
	Для Каждого СтрРазметки Из РазметкаПанели Цикл
		
		нСтр = Объект.РазметкаПанели.Добавить();
		ЗаполнитьЗначенияСвойств(нСтр,СтрРазметки);
		
		Если Не СтрРазметки.НастройкиЭлемента = "" Тогда
			НастройкиЭлемента = ЗначениеИзСтрокиВнутр(СтрРазметки.НастройкиЭлемента);
			Если НастройкиЭлемента.Свойство("ИнформационнаяБаза")
				И ЗначениеЗаполнено(НастройкиЭлемента.ИнформационнаяБаза) Тогда
				нстрИБ = тРазличныеИБ.Добавить();
				нстрИБ.ИнформационнаяБаза = НастройкиЭлемента.ИнформационнаяБаза;
				нстрИБ.ТипИБ              = НастройкиЭлемента.ИнформационнаяБаза.ТипБД;					
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;	 
	
	тРазличныеИБ.Свернуть("ТипИБ,ИнформационнаяБаза");
	Объект.ИспользуемыеИБ.Загрузить(тРазличныеИБ);
	
	//Пишем настройки страниц 
	Объект.СтраницыПанели.Очистить();
	
	ИндексСтраницы = 1;
	Для Каждого ЭлементСтраница Из Элементы.ГруппаСтраницыПанели.ПодчиненныеЭлементы Цикл
		
		Если НЕ ЭлементСтраница.Видимость Тогда
			Продолжить;
		КонецЕсли;	
		
		нСтраница 						= Объект.СтраницыПанели.Добавить();
		нСтраница.ИмяСтраницы   		= ЭлементСтраница.Имя;
		нСтраница.Заголовок     		= ЭлементСтраница.Заголовок;
		нСтраница.ИндексСтраницы        = ИндексСтраницы;
		нСтраница.Видимость             = ЭлементСтраница.Картинка = Новый Картинка;
		нСтраница.ЦветФонаСтрока        = Значениевстрокувнутр(ЭлементСтраница.ЦветФона);
		
		ИндексСтраницы = ИндексСтраницы+1;
		
	КонецЦикла;	
	
	Объект.ОтображатьЗаголовкиСтраниц 		= НЕ Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;	
	СхемаКД  								= ПолучитьИзВременногоХранилища(URLСхемы);	
	Объект.СхемаКомпоновкиДанных            = ЗначениеВСтрокуВнутр(СхемаКД);
	
	Элементы.ГруппаСтатусРасхожденияСКД.Видимость = Ложь;
	
КонецПроцедуры	

&НаСервере
Процедура ИнициализироватьСКДИсточника()
	
	СхемаКомпоновкиДанныхИсточника  = Объект.ИсточникДанных.СхемаКомпоновкиДанныхпоУмолчанию.Получить();
	
	//Из сохраненной КД текущей панели нам нужны Поля итогов и Вычисляемые поля
	Если ЗначениеЗаполнено(Объект.СхемаКомпоновкиДанных) Тогда
		СхемаКомпоновкиДанныхПанели      = ЗначениеИзСтрокиВнутр(Объект.СхемаКомпоновкиДанных);
    Иначе
		СхемаКомпоновкиДанныхПанели	      = Неопределено;
	КонецЕсли;	

	//Перенесем вычисляемые поля и итоги 
	  Если НЕ  СхемаКомпоновкиДанныхПанели = Неопределено Тогда
				
		СхемаКомпоновкиДанныхИсточника.ПоляИтога.Очистить();
		
		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ПоляИтога Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.ПоляИтога.Добавить();
			ЗаполнитьЗначенияСвойств(нПоле,тПоле);
			Для Каждого ИтогГруппировка Из тПоле.Группировки Цикл
				нПоле.Группировки.Добавить(ИтогГруппировка);
			КонецЦикла;	
			
			
		КонецЦикла;	
		
		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ВычисляемыеПоля Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.ВычисляемыеПоля.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			
		КонецЦикла;	

		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.Параметры Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.Параметры.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			
		КонецЦикла;
		
	КонецЕсли;	

	
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхИсточника,ЭтаФорма.УникальныйИдентификатор);	
	
	Для Каждого СтрПоле Из СхемаКомпоновкиДанныхИсточника.НаборыДанных[0].Поля Цикл
		Если Строка(СтрПоле.Поле) = "Источник" Тогда
			
			нПараметрВыбраСКД = СтрПоле.ПараметрыРедактирования.Элементы.Найти("ПараметрыВыбора");
            НовыйОтбор			=	нПараметрВыбраСКД.Значение.Добавить();
            НовыйОтбор.Имя 		= "Отбор.ПотребительРасчета";
            НовыйОтбор.Значение = Объект.ИсточникДанных;
            нПараметрВыбраСКД.Использование = Истина;
			
		КонецЕсли;	
	КонецЦикла;	
	
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	Исключение
		
		СообщениеПользователю = Новый СообщениеПользователю;
		
		СтрокаШаблона = Нстр("ru = 'При инициализации настроек источника данных возникла ошибка:
		|%1'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда			
			СообщениеПользователю.Текст = СтрШаблон(СтрокаШаблона, ОписаниеОшибки());
		КонецЕсли;
		
		СообщениеПользователю.Сообщить();		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
	КонецПопытки;

	//Схема для отрисовки тестовых макетов при разработке панели
	ИнициализироватьСКДРазработчика();
	
	//Обновим список доступных типов ИБ из  пакета
	ТипыВнешнихИБ.Очистить();
	тИсточники = Объект.ИсточникДанных.ИсточникиДанных.Выгрузить();
	Для Каждого СтрИсточник Из тИсточники Цикл
		Если НЕ СтрИсточник.ТипИБ = Справочники.ТипыБазДанных.ТекущаяИБ Тогда	
			нСтрокаИБ 		= ТипыВнешнихИБ.Добавить();
			нСтрокаИБ.ТипИБ = СтрИсточник.ТипИБ;
		КонецЕсли;	
	КонецЦикла;	
	
	
	ИнформацияОРасхождениях = "";	
	//Сравним Поля набора из сохраненной настройки и текущего пакета
	//Если есть расхождения - выведем сообщение;
	Если НЕ СхемаКомпоновкиДанныхПанели = Неопределено Тогда
		Для Каждого ПолеСКДПакета Из  СхемаКомпоновкиДанныхИсточника.НаборыДанных[0].Поля Цикл
			
			ПолеПанели = СхемаКомпоновкиДанныхПанели.НаборыДанных[0].Поля.Найти(ПолеСКДПакета.Поле); 
			Если  ПолеПанели = Неопределено Тогда
				СтрокаШаблона = Нстр("ru = 'Поле источника %1 добавлено или изменено'");
				СтрокаШаблона = СтрШаблон(СтрокаШаблона,ПолеСКДПакета.Поле);
				ИнформацияОРасхождениях = ИнформацияОРасхождениях+Символы.ПС+СтрокаШаблона;
			ИначеЕсли НЕ ПолеПанели.ТипЗначения = ПолеСКДПакета.ТипЗначения Тогда	
				
				СтрокаШаблона = Нстр("ru = 'Тип значения поля источника %1  изменено'");
				СтрокаШаблона = СтрШаблон(СтрокаШаблона,ПолеСКДПакета.Поле);
				ИнформацияОРасхождениях = ИнформацияОРасхождениях+Символы.ПС+СтрокаШаблона;

			КонецЕсли;	
		КонецЦикла;	
		
		Для Каждого ПолеСКДПакета Из  СхемаКомпоновкиДанныхПанели.НаборыДанных[0].Поля Цикл
			
			ПолеПанели = СхемаКомпоновкиДанныхИсточника.НаборыДанных[0].Поля.Найти(ПолеСКДПакета.Поле); 
			Если  ПолеПанели = Неопределено Тогда
				СтрокаШаблона = Нстр("ru = 'Поле источника %1 удалено или изменено'");
				СтрокаШаблона = СтрШаблон(СтрокаШаблона,ПолеСКДПакета.Поле);
				ИнформацияОРасхождениях = ИнформацияОРасхождениях+Символы.ПС+СтрокаШаблона;
			КонецЕсли;	
		КонецЦикла;	
	
	КонецЕсли;
	
	Элементы.ГруппаСтатусРасхожденияСКД.Видимость = ЗначениеЗаполнено(ИнформацияОРасхождениях);
	ЭтаФорма.Модифицированность                   = ЗначениеЗаполнено(ИнформацияОРасхождениях);
	
КонецПроцедуры	

&НаСервере
Процедура ИнициализироватьСКДРазработчика()
	
   ПакетДанных	        = Объект.ИсточникДанных;
	
   ПакетОбъект 			= ПакетДанных.ПолучитьОбъект();
   ИзмеренияПакета      = ПакетОбъект.ИзмеренияИсточников.Выгрузить();
   РесурсыПакета	    = ПакетОбъект.Ресурсы.Выгрузить();
   
   ИзмеренияПакета.Свернуть("ИмяВКубе,СинонимПоля");
   РесурсыПакета.Свернуть("ИмяВКубе,СинонимПоля,ТипЗначенияСтрока");
   
   СКДПакета            = ПолучитьИзВременногоХранилища(URLСхемы);
   
   ДемоТаблица = Новый ТаблицаЗначений;
   
   СКДНастройки = Новый СхемаКомпоновкиДанных;
	
   ИсточникДанных             = СКДНастройки.ИсточникиДанных.Добавить();
   ИсточникДанных.Имя         = "ИсточникДанных";
   ИсточникДанных.ТипИсточникаДанных = "Local";
	
   НаборДанных                = СКДНастройки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
   НаборДанных.Имя            = "НаборДанных1";
   НаборДанных.ИмяОбъекта     = "ИсточникДанныхДляРасчетов";
   НаборДанных.ИсточникДанных = "ИсточникДанных";
   
   
   тРесурсы 	= Новый Структура;
   тИзмерения 	= Новый Структура;
   
   Для Каждого ПолеСКД Из СКДПакета.НаборыДанных[0].Поля Цикл
	   
	   Поле 			= НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	   Поле.Поле        = ПолеСКД.ПутьКДанным;
	   Поле.Заголовок   = ПолеСКД.Заголовок;
	   Поле.ПутьКДанным = ПолеСКД.ПутьКДанным;
	   
	   Если  НЕ ДемоТаблица.Колонки.Найти(ПолеСКД.ПутьКДанным) = Неопределено Тогда
		   Продолжить;
	   КонецЕсли;	   
	   
	   Если НЕ РесурсыПакета.Найти(ПолеСКД.ПутьКДанным,"ИмяВКубе") = Неопределено Тогда
		   ДемоТаблица.Колонки.Добавить(ПолеСКД.ПутьКДанным,ПолеСКД.ТипЗначения,ПолеСКД.Заголовок);
		   Поле.ТипЗначения = ПолеСКД.ТипЗначения;
	   Иначе	 
		   ДемоТаблица.Колонки.Добавить(ПолеСКД.ПутьКДанным,ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100),ПолеСКД.Заголовок);
		   Поле.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	   КонецЕсли;   
	   
	   ВыбранноеПолеКомпоновкиДанных 				= СКДНастройки.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
	   ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(Строка(ПолеСКД.ПутьКДанным));
	   ВыбранноеПолеКомпоновкиДанных.Использование  = Истина;
   
   КонецЦикла;

   Для Каждого ПолеСКД Из СКДПакета.ВычисляемыеПоля Цикл
	   	   
	   Если НЕ РесурсыПакета.Найти(ПолеСКД.ПутьКДанным,"ИмяВКубе") = Неопределено Тогда
		   ДемоТаблица.Колонки.Добавить(ПолеСКД.ПутьКДанным,ПолеСКД.ТипЗначения,ПолеСКД.Заголовок);
		   Поле.ТипЗначения = ПолеСКД.ТипЗначения;
	   Иначе	 
		   ДемоТаблица.Колонки.Добавить(ПолеСКД.ПутьКДанным,ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100),ПолеСКД.Заголовок);
		   Поле.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(100));
	   КонецЕсли;   
	   
	   ВыбранноеПолеКомпоновкиДанных 				= СКДНастройки.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
	   ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(Строка(ПолеСКД.ПутьКДанным));
	   ВыбранноеПолеКомпоновкиДанных.Использование  = Истина;
   
   КонецЦикла;

   
   
   тТипЧисло 	=  Тип("Число");
   тТипДата 	=  Тип("Дата");
   тТипБулево 	=  Тип("Булево");
   
   Для Каждого СтрРесурс Из СКДПакета.ПоляИтога Цикл
	   	   
	   ПолеИтога 				= СКДНастройки.ПоляИтога.Добавить();
	   ПолеИтога.ПутьКДанным    = СтрРесурс.ПутькДанным;  
	   ПолеИтога.Выражение 		= СтрРесурс.Выражение;
	  
	   
   КонецЦикла;
   
   Для Каждого СтрВычполе Из СКДПакета.ВычисляемыеПоля Цикл
	   	   
	   вычПоле 					= СКДНастройки.ВычисляемыеПоля.Добавить();
	   ЗаполнитьЗначенияСвойств(вычПоле,СтрВычполе);
		    
	   Если СтрВычполе.ТипЗначения.Типы()[0] = тТипЧисло Тогда
		   вычПоле.Выражение = "123";
	   Иначе	    
		   вычПоле.ТипЗначения = Новый ОписаниеТипов("Строка");
		   вычПоле.Выражение = """<...>""";
	   КонецЕсли;
	   	   
   КонецЦикла;
   
   
   //Заполним тестовыми данными
   Для ИндСтроки= 1 По 5 Цикл
	   
	   нСтр 			= ДемоТаблица.Добавить();
	   ИндексИзмерения  = 1;
	   
	   Для Каждого СтрПоле Из СКДПакета.НаборыДанных[0].Поля Цикл
		   
		   Если СтрПоле.ТипЗначения.Типы()[0] = тТипЧисло Тогда
			   нСтр[СтрПоле.ПутьКДанным] = (ИндексИзмерения*10)+(ИндСтроки*10);
		   ИначеЕсли СтрПоле.ТипЗначения.Типы()[0]  = тТипДата Тогда	    
			   нСтр[СтрПоле.ПутьКДанным] = ТекущаяДата();
		   ИначеЕсли СтрПоле.ТипЗначения.Типы()[0]  = тТипБулево Тогда		   
			   нСтр[СтрПоле.ПутьКДанным] = Ложь;
           Иначе
			  нСтр[СтрПоле.ПутьКДанным] = СтрПоле.Заголовок+Строка(ИндСтроки);
		   КонецЕсли; 
		   
		   ИндексИзмерения = ИндексИзмерения +1;
		   
	   КонецЦикла;	   
	   
   КонецЦикла;		   
   
   URLСхемыНастроек 	= ПоместитьВоВременноеХранилище(СКДНастройки,ЭтаФорма.УникальныйИдентификатор);
   АдресТаблицыДанных   = ПоместитьВоВременноеХранилище(ДемоТаблица,ЭтаФорма.УникальныйИдентификатор);
   
   
КонецПроцедуры	

