 
#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Объект.Ссылка.Пустая()  Тогда	
		//Создание новой панели по параметрам
		Если НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Если Параметры.Свойство("Наименование")  Тогда 		
				Объект.Наименование 		= Параметры.Наименование;
				Объект.ИсточникДанных       = Параметры.ИсточникДанных;			
			Иначе			
				Отказ =Истина;		
			КонецЕсли;	
		Иначе	
			Объект.Наименование = Объект.Наименование+ Нстр("ru = ' (копия)'")
		КонецЕсли;		
	КонецЕсли;
	
	ТекущаяСтраницаИмя 		= "Страница1";    
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
		
	ИнициализироватьСКДИсточника();
		
	ПрочитатьНастройкиПанели();
	
	Если РазметкаПанели.Количество() = 0 Тогда
		ДобавитьПервуюСтраницу();
		Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма);
	Иначе	
		Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма);
	КонецЕсли;	

	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
		
	ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.5);
	ПодключитьОбработчикОжидания("ПоказатьТекущийЭлемент_Подключаемый", 1,Ложь);
	
	Элементы.ФормаВставитьОбласть.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
   	ЗаписатьНастройкиПанели();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОтображатьЗаголовкиСтраниц" Тогда
		
		Если Параметр Тогда
			Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		Иначе	
			Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		КонецЕсли;	
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ИзменитьВидимостьСтраницы" Тогда
		
		 тЭлемент 					= Элементы[Параметр.Страница];
		 //тЭлемент.Видимость   		= Параметр.Видимость;
		 Если НЕ Параметр.Видимость Тогда
			  тЭлемент.Картинка 			= БиблиотекаКартинок.ВводимыеСимволыСкрыты;
			  тЭлемент.ЦветТекстаЗаголовка 	= Новый Цвет(160,160,160);
		 Иначе	 
			  тЭлемент.Картинка 			= Новый Картинка;
			  тЭлемент.ЦветТекстаЗаголовка 	= Новый Цвет(0,0,0);
		 КонецЕсли;
		 
		 ЭтаФорма.Модифицированность = Истина;
		 
	ИначеЕсли ИмяСобытия = "ИзменитьЗаголовокСтраницы" Тогда
		
		 тЭлемент 					= Элементы[Параметр.Страница];
		 тЭлемент.Заголовок   		= Параметр.Заголовок;
		 
		 ЭтаФорма.Модифицированность = Истина;
	 
	ИначеЕсли ИмяСобытия = "ИзменитьЦветФонаСтраницы" Тогда
		
		 тЭлемент 					= Элементы[Параметр.Страница];
		 тЭлемент.ЦветФона   		= Параметр.ЦветФона;
		 
		 ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "СдвинутьСтраницу" Тогда
		
		СдвинутьСтраницуСервер(Параметр);
		
		ЭтаФорма.Модифицированность = Истина;
	
	ИначеЕсли ИмяСобытия = "ДобавитьСтраницу" Тогда
		
		ДобавитьСтраницуСервер(Параметр);	
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "УдалитьСтраницу" Тогда
		
		УдалитьСтраницуСервер(Параметр);	
		
		ЭтаФорма.Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ПоказатьСтраницу" Тогда
		
		Если НЕ Элементы.Найти(Параметр.Страница) = Неопределено Тогда
			 Элементы.ГруппаСтраницыПанели.ТекущаяСтраница = Элементы.Найти(Параметр.Страница);
		КонецЕсли;	
			
	КонецЕсли;	
		
КонецПроцедуры


#КонецОбласти

#Область УправлениеСтраницамиПанели

&НаКлиенте
Процедура ГруппаСтраницыПанелиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущаяСтраницаИмя =  ТекущаяСтраница.Имя;
	
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеСтраницами(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьНастройкиСтраницЗавершение", ЭтаФорма);
		
	ПараметрыФормы 		= ПодготовитьПараметрыВызоваФормыСтраниц();	
		
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаУправленияСтраницами",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыВызоваФормыСтраниц() 
	
	СтраницыПанели.Очистить();
	
	ИндексСтраницы = 1;
	Для Каждого ЭлементСтраница Из Элементы.ГруппаСтраницыПанели.ПодчиненныеЭлементы Цикл
			
		нСтраница 						= СтраницыПанели.Добавить();
		нСтраница.ИмяСтраницы   		= ЭлементСтраница.Имя;
		нСтраница.Заголовок     		= ЭлементСтраница.Заголовок;
		нСтраница.ИндексСтраницы        = ИндексСтраницы;
		нСтраница.Видимость             = ЭлементСтраница.Картинка = Новый Картинка;
		нСтраница.ЦветФона              = ЭлементСтраница.ЦветФона;
		
		тЭлементы =  РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы",нСтраница.ИмяСтраницы));
		Если тЭлементы.Количество() = 1 
			И НЕ ЗначениеЗаполнено(тЭлементы[0].ТипОбъекта) Тогда
			//Пустая страница - заготовка
		Иначе	
			нСтраница.ЕстьЭлементы = Истина;
		КонецЕсли;	
			
		ИндексСтраницы = ИндексСтраницы+1;
		
	КонецЦикла;	
	
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("АдресСтраницыПанели",ПоместитьВоВременноеХранилище(СтраницыПанели.Выгрузить(),ЭтаФорма.УникальныйИдентификатор));
	СтруктураОтвета.Вставить("ОтображатьЗаголовкиСтраниц",НЕ Элементы.ГруппаСтраницыПанели.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет);
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьНастройкиСтраницЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	
	
КонецПроцедуры

&НаСервере
Процедура СдвинутьСтраницуСервер(Параметр)
	
	тЭлемент 					= Элементы[Параметр.Страница];
	Если Не Параметр.ПредыдущаяСтраница = Неопределено Тогда
		Элементы.Переместить(тЭлемент,Элементы.ГруппаСтраницыПанели,Элементы[Параметр.ПредыдущаяСтраница]);
	Иначе	
		Элементы.Переместить(тЭлемент,Элементы.ГруппаСтраницыПанели);	
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьСтраницуСервер(Параметр)
	
	 //Установим элемент
	ЭлементСтраница =  Элементы.Добавить(
	Параметр.ИмяСтраницы,
	Тип("ГруппаФормы"),
	Элементы.ГруппаСтраницыПанели);
	
	ЭлементСтраница.Вид = ВидГруппыФормы.Страница;
	ЭлементСтраница.Заголовок = Параметр.Заголовок;
	
	Элементы.ГруппаСтраницыПанели.ТекущаяСтраница = ЭлементСтраница;
	
	ТекущаяСтраница 		= Параметр.ИмяСтраницы;    
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;

	Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма,,ТекущаяСтраница);
	
		
КонецПроцедуры	

&НаСервере
Процедура УдалитьСтраницуСервер(Параметр)
	
	//Удалим  элемент	
	УдаляемаяСтраницаЭлемент = Элементы[Параметр.Страница]; 
	Элементы.Удалить(УдаляемаяСтраницаЭлемент);
	
	//Очистим кэш разметки
	МассивУдаляемыхЭлементовРазметки = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы",Параметр.Страница));
	Для Каждого УдЭлемент Из МассивУдаляемыхЭлементовРазметки Цикл
		РазметкаПанели.Удалить(УдЭлемент);
	КонецЦикла;	
		
КонецПроцедуры	


#КонецОбласти

#Область УправлениеРазметкойСтраницы

&НаКлиенте
Процедура ДобавитьСтрокуРазметки(Команда)
	
	КолонкаКоманды = Прав(ЭтаФорма.ТекущийЭлемент.Имя,1);
	СтрокаКоманды  = Лев(Прав(ЭтаФорма.ТекущийЭлемент.Имя,3),1);
	
	ДобавитьСтрокуРазметкиСервер();

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРазметкиСервер(СтрокаРазметки = Неопределено,СтраницаРазметки = Неопределено)

	Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма);
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитКолонкуРазметки(Команда)
	
	 КолонкаКоманды = Прав(ЭтаФорма.ТекущийЭлемент.Имя,1);
	 СтрокаКоманды  = Лев(Прав(ЭтаФорма.ТекущийЭлемент.Имя,3),1);
	
     ДобавитьКолонкуРазметкиСервер();
	 	 
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуРазметкиСервер(КолонкаРазметки = Неопределено)
    
	Если КолонкаРазметки = Неопределено Тогда	
		нСтр 					= РазметкаПанели.Добавить();
		нСтр.ИмяСтраницы     	= ТекущаяСтраницаИмя;
		нСтр.ИндексСтроки    	= СтрокаКоманды;
		нСтр.ИндексКолонки   	= КолонкаКоманды+1;
		нСтр.ИмяЭлемента     	= "Элемент_"+ТекущаяСтраницаИмя+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
		нСтр.ИмяГруппыЭлемента  = "ЭлементГруппа_"+ТекущаяСтраницаИмя+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
		нСтр.ЗаголовокЭлемента   = Нстр("ru = 'Новый элемент'") ;
	Иначе	
		нСтр = КолонкаРазметки;
	КонецЕсли;
   
   Справочники.АналитическиеПанели.ДобавитьЭлементНаФорму(ЭтаФорма,нСтр);
      
КонецПроцедуры	

&НаКлиенте
Процедура ИзменитьСвойстваОбласти(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьСвойстваОбластиЗавершение", ЭтаФорма);
		
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);

	ПараметрыФормы 		= ПодготовитьПараметрыВызоваФормыОбъекта(СвойстваТекущегоЭлемента[0].НастройкиЭлемента);	
	
	ПараметрыФормы.Вставить("URLСхемы",URLСхемы);
	ПараметрыФормы.Вставить("ТипОбъекта",			СвойстваТекущегоЭлемента[0].ТипОбъекта);
	ПараметрыФормы.Вставить("ЗаголовокЭлемента",	СвойстваТекущегоЭлемента[0].ЗаголовокЭлемента);
	ПараметрыФормы.Вставить("ЗафиксироватьОтборы",	СвойстваТекущегоЭлемента[0].ЗафиксироватьОтборы);
	ПараметрыФормы.Вставить("ТипыВнешнихИБ",		ТипыВнешнихИБ);
    ПараметрыФормы.Вставить("СкрытьЗаголовокЭлемента",СвойстваТекущегоЭлемента[0].СкрытьЗаголовокЭлемента);

	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаИзмененияСвойствОбласти",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыВызоваФормыОбъекта(НастройкиЭлементаСтрока)
	
	Параметры = Новый Структура;

	Если Не ЗначениеЗаполнено(НастройкиЭлементаСтрока) Тогда
		Возврат Параметры;
	КонецЕсли;	
		
	Параметры 												= ЗначениеИзСтрокиВнутр(НастройкиЭлементаСтрока);
		
	Возврат Параметры;
	
КонецФункции	

&НаКлиенте
Процедура ИзменитьСвойстваОбластиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	Если СвойстваТекущегоЭлемента.Количество() =0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяТекущегоЭлемента = СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	
	Элементы[ИмяТекущегоЭлемента].Ширина 					= Результат.НастройкиЭлемента.Ширина;
	Элементы[ИмяТекущегоЭлемента].Высота 					= Результат.НастройкиЭлемента.Высота;
	Элементы[ИмяТекущегоЭлемента].РастягиватьПоВертикали 	= Результат.НастройкиЭлемента.РастягиватьПоВертикали;
	Элементы[ИмяТекущегоЭлемента].РастягиватьПоГоризонтали = Результат.НастройкиЭлемента.РастягиватьПоГоризонтали;
	
	Если НЕ ТипЗнч(Элементы[ИмяТекущегоЭлемента]) = Тип("ГруппаФормы") Тогда 
		Элементы[ИмяТекущегоЭлемента].АвтомаксимальнаяВысота 	= Результат.НастройкиЭлемента.АвтомаксимальнаяВысота;
		Элементы[ИмяТекущегоЭлемента].АвтомаксимальнаяШирина 	= Результат.НастройкиЭлемента.АвтомаксимальнаяШирина;
		Элементы[ИмяТекущегоЭлемента].МаксимальнаяВысота 		= Результат.НастройкиЭлемента.МаксимальнаяВысота;
		Элементы[ИмяТекущегоЭлемента].МаксимальнаяШирина 		= Результат.НастройкиЭлемента.МаксимальнаяШирина;
	КонецЕсли;
	
	Результат.Вставить("ИмяТекущегоЭлемента",ИмяТекущегоЭлемента);
		
	ИзменитьСвойстваОбластиСервер(Результат);

	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСвойстваОбластиСервер(Результат);
		
	//Изменим свойства соответствующего элемента в разметке таблицы
	тРазметкаПанели  = РазметкаПанели.Выгрузить();
	тОбластьВТаблице = тРазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",Результат.ИмяТекущегоЭлемента))[0];

	тОбластьВТаблице.НастройкиЭлемента 			= ЗначениеВСтрокуВнутр(Результат.НастройкиЭлемента);
	тОбластьВТаблице.ТипОбъекта             	= Результат.ТипОбъекта;
	тОбластьВТаблице.ЗаголовокЭлемента      	= Результат.ЗаголовокЭлемента;
	тОбластьВТаблице.ЗафиксироватьОтборы    	= Результат.ЗафиксироватьОтборы;
	тОбластьВТаблице.СкрытьЗаголовокЭлемента    = Результат.СкрытьЗаголовокЭлемента;
	
	Справочники.АналитическиеПанели.УстановитьСвойстваЗаголовкаФрейма(Результат.ЗаголовокЭлемента,Элементы["Заголовок_"+Результат.ИмяТекущегоЭлемента],Результат.НастройкиЭлемента,Результат.СкрытьЗаголовокЭлемента);
		
	Если тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймТаблицы(ЭтаФорма,тОбластьВТаблице);
		
	ИначеЕсли тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПустаяСсылка() Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймПустогоПоля(ЭтаФорма,тОбластьВТаблице);
		
	ИначеЕсли тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймИндикатора(ЭтаФорма,тОбластьВТаблице);
		
	ИначеЕсли тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймДиаграммыГанта(ЭтаФорма,тОбластьВТаблице);
		
	ИначеЕсли тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймТекстовогоДокумента(ЭтаФорма,тОбластьВТаблице);
	
	ИначеЕсли тОбластьВТаблице.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймКартинки(ЭтаФорма,тОбластьВТаблице);
	
	Иначе 
		//Поле диаграммы
		Справочники.АналитическиеПанели.СоздатьФреймДиаграммы(ЭтаФорма,тОбластьВТаблице);

	КонецЕсли;

	РазметкаПанели.Загрузить(тРазметкаПанели);
	
КонецПроцедуры



#КонецОбласти

#Область УправлениеОбластямиПанели

&НаКлиенте
Процедура УдалитьОбласть(Команда)
		
	Если РазметкаПанели.Количество() = 1 Тогда  		
		Возврат;
	КонецЕсли;
 	
	Оповещение = Новый ОписаниеОповещения("ВопросУдалитьОбластьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить текущий элемент со всеми настройками ?'"), РежимДиалогаВопрос.ДаНет);
			
КонецПроцедуры  

&НаКлиенте
Процедура ВопросУдалитьОбластьЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущийЭлементГруппа = ЭтаФорма.ТекущийЭлемент.Родитель;	
	ИмяУдаляемогоЭлемента = СтрЗаменить(ТекущийЭлементГруппа.Имя,"ИндикаторОсновнаяИнформация_Элемент","ЭлементГруппа");
	
	УдалитьОбластьСервер(ИмяУдаляемогоЭлемента);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОбластьСервер(ИмяЭлемента)
	
	УдаляемаяСтрока = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяГруппыЭлемента",ИмяЭлемента))[0];
	
	ИндексУдаляемойСтроки =  УдаляемаяСтрока.ИндексСтроки;
	ИндексУдаляемойКолонки =  УдаляемаяСтрока.ИндексКолонки;
	
	//Единственный элемент не удаляем.
	Если РазметкаПанели.Количество() = 1 Тогда  		
		Возврат;
	КонецЕсли;
	
	//Если будет смещение по строке или колонке перегенирируем разметку таблицы и имена элементов
	Для Каждого СтрРазметки Из РазметкаПанели Цикл  
		Если СтрРазметки.ИмяСтраницы = ТекущаяСтраницаИмя 
			И СтрРазметки.ИндексСтроки = ИндексУдаляемойСтроки Тогда
			
			 Если СтрРазметки.ИндексКолонки>ИндексУдаляемойКолонки Тогда
				  СтрРазметки.ИндексКолонки = СтрРазметки.ИндексКолонки - 1;
				  
				  НовоеИмяЭлемента 			= "Элемент_"+ТекущаяСтраницаИмя+"_"+СтрРазметки.ИндексСтроки+"_"+СтрРазметки.ИндексКолонки;
				  НовоеИмяГруппыЭлемента    = "ЭлементГруппа_"+ТекущаяСтраницаИмя+"_"+СтрРазметки.ИндексСтроки+"_"+СтрРазметки.ИндексКолонки;
				  
				  СтрРазметки.ИмяЭлемента     		= НовоеИмяЭлемента;
				  СтрРазметки.ИмяГруппыЭлемента  	= НовоеИмяГруппыЭлемента;
				  
			 КонецЕсли; 	 
				 
		КонецЕсли;	
	КонецЦикла;
	
	МассивУдаляемыхЭлементов  = Новый Массив;
	УдаялемыеЭлементы = Элементы[ТекущаяСтраницаИмя].ПодчиненныеЭлементы;
	Для Каждого Стр Из УдаялемыеЭлементы Цикл
		МассивУдаляемыхЭлементов.Добавить(Стр);
	КонецЦикла;	
	
	Для Каждого Стр Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Стр);
	КонецЦикла;
	
	РазметкаПанели.Удалить(УдаляемаяСтрока);
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
	
	Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма,ТекущаяСтраницаИмя);

КонецПроцедуры  

&НаКлиенте
Процедура РедактироватьНастройки(Команда)
	
    Оповещение = Новый ОписаниеОповещения("РедактироватьНастройкиЗавершение", ЭтаФорма);		
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Наименование",Объект.Наименование);
	СтруктураПараметров.Вставить("Комментарий",Объект.Комментарий);
	СтруктураПараметров.Вставить("ИсточникДанных",Объект.ИсточникДанных);
    СтруктураПараметров.Вставить("URLСхемы",URLСхемы);
	
	ЕстьЭлементыСНастройкой = Ложь;
	Для Каждого стрРазметка Из РазметкаПанели Цикл		
		Если ЗначениеЗаполнено(стрРазметка.НастройкиЭлемента) Тогда
			ЕстьЭлементыСНастройкой = Истина;
			Прервать;
		КонецЕсли;		
	КонецЦикла;	
	
	СтруктураПараметров.Вставить("ЕстьЭлементыСНастройкой",ЕстьЭлементыСНастройкой);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаРедактированияСвойствПанели",СтруктураПараметров,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	ОбновитьСвойстваПанели(Результат);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСвойстваПанели(Результат)
	
	Объект.Наименование 				= Результат.Наименование;
	Объект.Комментарий  				= Результат.Комментарий;
	Объект.ИсточникДанных               = Результат.ИсточникДанных;	
	Объект.СхемаКомпоновкиДанных       	= Результат.URLСхемы;
		
	ИнициализироватьСКДИсточника();
	
	Если РазметкаПанели.Количество() > 0 Тогда
		Справочники.АналитическиеПанели.ОбновитьПанельПоРазметке(ЭтаФорма);
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиенте
Процедура ПолеДиаграммыВыбор(Элемент, ЗначениеДиаграммы, СтандартнаяОбработка)
	
    СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьОбласть(Команда)
		
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	Если СвойстваТекущегоЭлемента.Количество()  = 0 Тогда
		 ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Выберите элемент для копирования'"));
		 Возврат;
	КонецЕсли;	
	
	ИмяОбластиДляВставки = СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	
	Элементы.ФормаВставитьОбласть.Доступность = Истина;

	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьОбласть(Команда)
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);

	
	Если РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяОбластиДляВставки)).Количество() = 0 Тогда
		 ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Не выбран элемент - источник'"));
		 Возврат;
	КонецЕсли;	
	
	Если СвойстваТекущегоЭлемента.Количество() = 0 Тогда
		 ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Выберите элемент для вставки'"));
		 Возврат;
	КонецЕсли;	
	
	Если ИмяОбластиДляВставки = СвойстваТекущегоЭлемента[0].ИмяЭлемента Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяПриемника =   СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	ВставитьОбластьСервер(ИмяПриемника);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ВставитьОбластьСервер(ИмяПриемника)
	
	
	тИсточник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяОбластиДляВставки))[0];
    тПриемник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяПриемника))[0];
	
	тПриемник.ТипОбъекта 				=  тИсточник.ТипОбъекта;
	тПриемник.НастройкиЭлемента     	=  тИсточник.НастройкиЭлемента;
	тПриемник.ЗаголовокЭлемента     	=  тИсточник.ЗаголовокЭлемента;
	тПриемник.ЗафиксироватьОтборы   	=  тИсточник.ЗафиксироватьОтборы;
    тПриемник.СкрытьЗаголовокЭлемента   =  тИсточник.СкрытьЗаголовокЭлемента;
		
	тНастройки =  ЗначениеИзСтрокиВнутр(тИсточник.НастройкиЭлемента);
	
	Справочники.АналитическиеПанели.УстановитьСвойстваЗаголовкаФрейма(тПриемник.ЗаголовокЭлемента,Элементы["Заголовок_"+тПриемник.ИмяЭлемента],тНастройки,тИсточник.СкрытьЗаголовокЭлемента);

	
	Если тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймТаблицы(ЭтаФорма,тПриемник);
		
	ИначеЕсли тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПустаяСсылка() Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймПустогоПоля(ЭтаФорма,тПриемник);
		
	ИначеЕсли тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймИндикатора(ЭтаФорма,тПриемник);
		
	ИначеЕсли тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймДиаграммыГанта(ЭтаФорма,тПриемник);
		
	ИначеЕсли тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймТекстовогоДокумента(ЭтаФорма,тПриемник);
	
	ИначеЕсли тПриемник.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда
		
		Справочники.АналитическиеПанели.СоздатьФреймКартинки(ЭтаФорма,тПриемник);
	
	Иначе 
		//Поле диаграммы
		Справочники.АналитическиеПанели.СоздатьФреймДиаграммы(ЭтаФорма,тПриемник);

	КонецЕсли;

		
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьЭлементВправо(Команда)
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);

	Если СвойстваТекущегоЭлемента.Количество() = 0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Выберите элемент для перемещения'"));
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента =   СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	ПереместитьЭлементВправоСервер(ИмяЭлемента);
    ЭтаФорма.ТекущийЭлемент = Элементы[ЭтаФорма.ТекущийЭлемент.Имя];
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьЭлементВлево(Команда)
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	Если СвойстваТекущегоЭлемента.Количество() = 0 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Выберите элемент для перемещения'"));
		Возврат;
	КонецЕсли;	
	
	ИмяЭлемента =   СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	ПереместитьЭлементВлевоСервер(ИмяЭлемента);
    ЭтаФорма.ТекущийЭлемент = Элементы[ЭтаФорма.ТекущийЭлемент.Имя];
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементВправоСервер(ИмяЭлемента)
	
	тИсточник 		= РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяЭлемента))[0];
	ИндексИсточника = тИсточник.ИндексКолонки;
	
	ИндексПриемника = ИндексИсточника+1;
	
	тПриемник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы,ИндексСтроки,ИндексКолонки"
	,ТекущаяСтраницаИмя,тИсточник.ИндексСтроки,ИндексПриемника));
	
	Если тПриемник.Количество() = 0 Тогда //Правая граница, берем первый элемент
		
		тПриемник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы,ИндексСтроки,ИндексКолонки"
		,ТекущаяСтраницаИмя,тИсточник.ИндексСтроки,1));
				
	КонецЕсли;
		
	КолонкиКоллекции = РазметкаПанели.Выгрузить().СкопироватьКолонки();
	
	СтруктураСвойствИсточника = Новый Структура;	
	СтруктураСвойствИсточника.Вставить("ТипОбъекта");
	СтруктураСвойствИсточника.Вставить("НастройкиЭлемента");
	СтруктураСвойствИсточника.Вставить("ЗаголовокЭлемента");
    СтруктураСвойствИсточника.Вставить("ИмяРеквизитаФормы");
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствИсточника,тИсточник);
		
	СтруктураСвойствПриемника = Новый Структура;	
	СтруктураСвойствПриемника.Вставить("ТипОбъекта");
	СтруктураСвойствПриемника.Вставить("НастройкиЭлемента");
	СтруктураСвойствПриемника.Вставить("ЗаголовокЭлемента");
    СтруктураСвойствПриемника.Вставить("ИмяРеквизитаФормы");	
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствПриемника,тПриемник[0]);
	
	ЗаполнитьЗначенияСвойств(тПриемник[0],СтруктураСвойствИсточника);
	ЗаполнитьЗначенияСвойств(тИсточник,СтруктураСвойствПриемника);
	
	МассивУдаляемыхЭлементов  = Новый Массив;
	УдаялемыеЭлементы = Элементы[ТекущаяСтраницаИмя].ПодчиненныеЭлементы;
	Для Каждого Стр Из УдаялемыеЭлементы Цикл
		МассивУдаляемыхЭлементов.Добавить(Стр);
	КонецЦикла;	
	
	Для Каждого Стр Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Стр);
	КонецЦикла;
	
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
	
	Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма,ТекущаяСтраницаИмя);

	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементВлевоСервер(ИмяЭлемента)
	
	тИсточник 		= РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяЭлемента))[0];
	ИндексИсточника = тИсточник.ИндексКолонки;
	
	ЭлементыТекущейСтроки = РазметкаПанели.Выгрузить(Новый Структура("ИмяСтраницы,ИндексСтроки",ТекущаяСтраницаИмя,тИсточник.ИндексСтроки));
	ЭлементыТекущейСтроки.Сортировать("ИндексКолонки УБЫВ");
	
	ИндексПриемника = ИндексИсточника-1;
	
	тПриемник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы,ИндексСтроки,ИндексКолонки"
	,ТекущаяСтраницаИмя,тИсточник.ИндексСтроки,ИндексПриемника));
	
	Если тПриемник.Количество() = 0 Тогда //Левая граница, берем последний элемент
		
		тПриемник = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы,ИндексСтроки,ИндексКолонки"
		,ТекущаяСтраницаИмя,тИсточник.ИндексСтроки,ЭлементыТекущейСтроки[0].ИндексКолонки));
				
	КонецЕсли;
		
	КолонкиКоллекции = РазметкаПанели.Выгрузить().СкопироватьКолонки();
	
	СтруктураСвойствИсточника = Новый Структура;	
	СтруктураСвойствИсточника.Вставить("ТипОбъекта");
	СтруктураСвойствИсточника.Вставить("НастройкиЭлемента");
	СтруктураСвойствИсточника.Вставить("ЗаголовокЭлемента");
    СтруктураСвойствИсточника.Вставить("ИмяРеквизитаФормы");
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствИсточника,тИсточник);
		
	СтруктураСвойствПриемника = Новый Структура;	
	СтруктураСвойствПриемника.Вставить("ТипОбъекта");
	СтруктураСвойствПриемника.Вставить("НастройкиЭлемента");
	СтруктураСвойствПриемника.Вставить("ЗаголовокЭлемента");
    СтруктураСвойствПриемника.Вставить("ИмяРеквизитаФормы");	
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойствПриемника,тПриемник[0]);
	
	ЗаполнитьЗначенияСвойств(тПриемник[0],СтруктураСвойствИсточника);
	ЗаполнитьЗначенияСвойств(тИсточник,СтруктураСвойствПриемника);
	
	МассивУдаляемыхЭлементов  = Новый Массив;
	УдаялемыеЭлементы = Элементы[ТекущаяСтраницаИмя].ПодчиненныеЭлементы;
	Для Каждого Стр Из УдаялемыеЭлементы Цикл
		МассивУдаляемыхЭлементов.Добавить(Стр);
	КонецЦикла;	
	
	Для Каждого Стр Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Стр);
	КонецЦикла;
	
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
	
	Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма,ТекущаяСтраницаИмя);

	
КонецПроцедуры


