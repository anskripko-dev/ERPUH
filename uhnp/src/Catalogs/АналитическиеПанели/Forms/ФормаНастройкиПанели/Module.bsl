&НаКлиенте
Процедура ОткрытьФормуНастройкиСтруктуры()
	
	ПараметрыФормы = ПодготовитьПараметрыДляВызоваФормыРедактирования(Ложь);
	ПараметрыФормы.Вставить("Источник",Объект.ИсточникДанных);
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаНастройкиСКД", ПараметрыФормы,  ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыДляВызоваФормыРедактирования(РасширеннаяНастройка)
	
	Возврат Новый Структура("URLСхемы, КомпоновщикНастроек, НаименованиеОтчета"
							, URLСхемы
							, КомпоновщикНастроек
							, Объект.Наименование);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОписаниеОшибки(Команда) Экспорт
		
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	тЭлементИмя = Элементы[ЭтаФорма.ТекущийЭлемент.Имя].Родитель.Имя;
	тЭлемент    = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",тЭлементИмя))[0];
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстОписанияОшибки",тЭлемент.ИнформацияОбОшибке);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаОписанияОшибки",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтивРежимПросмотра(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда	
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Записать изменения ?'"), РежимДиалогаВопрос.ДаНетОтмена);
	Иначе	
		ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаРаботыСДанными",Новый Структура("ШаблонПанели",Объект.Ссылка),ЭтаФорма,Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЭтаФорма.Записать();
		ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаРаботыСДанными",Новый Структура("ШаблонПанели",Объект.Ссылка),ЭтаФорма,Истина);
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда 	
		ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаРаботыСДанными",Новый Структура("ШаблонПанели",Объект.Ссылка),ЭтаФорма,Истина);
	КонецЕсли;	
		
КонецПроцедуры

