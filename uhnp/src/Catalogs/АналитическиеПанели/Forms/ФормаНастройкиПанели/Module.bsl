&НаКлиенте
Процедура УправлениеЭлементами(Команда)
	  	
	Оповещение = Новый ОписаниеОповещения("ИзменитьНастройкиРазметкиЗавершение", ЭтаФорма);
		
	ПараметрыФормы 		= Новый Структура("РазметкаПанели,ТекущаяСтраницаИмя",РазметкаПанели,ТекущаяСтраницаИмя);	
		
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаУправленияРазметкойСтраницы",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкиРазметкиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	МассивУдаляемыхЭлементов = Новый Массив;
	ЭлементыТекущейСтраницы = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяСтраницы",ТекущаяСтраницаИмя));
	
	Для Каждого Элемент Из ЭлементыТекущейСтраницы Цикл
		   МассивУдаляемыхЭлементов.Добавить(Элемент);
	КонецЦикла;	
	
	Для Каждого уДЭлемент Из МассивУдаляемыхЭлементов Цикл
		   РазметкаПанели.Удалить(уДЭлемент);
	КонецЦикла;	
	
	Для Каждого нЭлемент Из Результат Цикл
		нСтр = РазметкаПанели.Добавить();
		ЗаполнитьЗначенияСвойств(нСтр,нЭлемент);
	КонецЦикла;	
	
	ЗаполнитьПанельПоРазметке();
		
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПанельПоРазметке()
	
	
	МассивУдаляемыхЭлементов  = Новый Массив;
	УдаялемыеЭлементы = Элементы[ТекущаяСтраницаИмя].ПодчиненныеЭлементы;
	Для Каждого Стр Из УдаялемыеЭлементы Цикл
		МассивУдаляемыхЭлементов.Добавить(Стр);
	КонецЦикла;	
	
	Для Каждого Стр Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Стр);
	КонецЦикла;
	
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
	
	
	Если РазметкаПанели.Количество() = 0 Тогда
		ДобавитьПервуюСтраницу();
		Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма);
	Иначе	
		Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

