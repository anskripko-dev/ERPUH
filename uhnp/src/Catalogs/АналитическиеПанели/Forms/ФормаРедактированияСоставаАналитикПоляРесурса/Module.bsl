
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ВыбранныеПоля = Параметры.ВыбранныеПоля; 	
	ДоступныеПоля = Параметры.ДоступныеПоля;
	
	Для Каждого ВыбПоле Из ВыбранныеПоля Цикл
		
		тПоле  = ДоступныеПоля.НайтиПоЗначению(ВыбПоле.Значение);
		Если НЕ тПоле = Неопределено Тогда
			тПоле.Пометка = Истина;		
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
		
	Закрыть(Новый Структура("ВыбранныеПоля",ДоступныеПоля));
	
КонецПроцедуры




