
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если НЕ Параметры.ВыбранныеПоля = Неопределено  Тогда
		ВыбранныеПоля.ЗагрузитьЗначения(Параметры.ВыбранныеПоля);	
	КонецЕсли;
	
	ПутьКДанным 				= Параметры.ПутьКДанным;	
	ТипЗначения 				= Параметры.ТипЗначения;
	тЗаголовок  				= Параметры.Заголовок;	
	ИсходныйПутькДанным  		= Параметры.ПутьКДанным;	
	Выражение 					= Параметры.Выражение;
	
	Если НЕ ЗначениеЗаполнено(ТипЗначения) Тогда
		 ТипЗначения = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18,5);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ЗначениеЗаполнено(ПутьКДанным) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен путь к данным'"),,"ПутьКДанным");		
		Возврат;
	КонецЕсли;
	
	Если НЕ ВыбранныеПоля.НайтиПоЗначению(ПутьКДанным) = Неопределено 
		И ПутьКДанным<>ИсходныйПутькДанным Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле с таким путем уже существует, введите другой путь'"),,"ПутьКДанным");		
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ПутьКДанным,ТипЗначения,Заголовок,Выражение"
	,ПутьКДанным
	,ТипЗначения
	,?(тЗаголовок="",ПутьКДанным,тЗаголовок)
	,Выражение));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыражениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект,"Выражение");

КонецПроцедуры

&НаКлиенте
Процедура ПутьКДаннымПриИзменении(Элемент)
	
	Если тЗаголовок = "" Тогда
		 тЗаголовок = ПутьКДанным;
	КонецЕсли;	
	
КонецПроцедуры




