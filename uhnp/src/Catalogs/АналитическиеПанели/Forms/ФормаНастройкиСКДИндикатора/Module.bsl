
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	URLСхемы                            = Параметры.URLСхемы;
	ТипОбъекта                          = Параметры.ТипОбъекта;
	ИндексПоказатеяИндикатора           = Параметры.ИндексПоказатеяИндикатора;
	
	Если Не Параметры.НастройкиКомпоновщика = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Параметры.НастройкиКомпоновщика);
	Иначе	
		КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьИзВременногоХранилища(URLСхемы).НастройкиПоУмолчанию);
		КомпоновщикНастроек.Настройки.Структура.Очистить();
	КонецЕсли;
	
	ИнициализироватьСКДИсточника();
	

КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ГруппаСтруктураОбъекта.Видимость = Ложь;
	
	Если  КомпоновщикНастроек.Настройки.Структура.Количество() = 3 
		И ТипЗнч(КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора]) = Тип("ГруппировкаКомпоновкиДанных") Тогда
		
		Для Каждого СтрУО Из КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора].УсловноеОформление.Элементы Цикл 
			
			нСтрокаУО = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
			
			ЗаполнитьЗначенияСвойств(нСтрокаУО,СтрУО);
			
			Для Каждого ЭлементОформления Из СтрУО.Оформление.Элементы Цикл
				нСтрокаУО.Оформление.УстановитьЗначениеПараметра(ЭлементОформления.Параметр,ЭлементОформления.Значение);
				нСтрокаУО.Оформление.ПолучитьОбъектПоИдентификатору(СтрУО.Оформление.ПолучитьИдентификаторПоОбъекту(ЭлементОформления)).Использование = ЭлементОформления.Использование;
			КонецЦикла;	
			Для Каждого ЭлементОтбора Из СтрУО.Отбор.Элементы Цикл
				нЭлементОтбора = нСтрокаУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(нЭлементОтбора,ЭлементОтбора);
			КонецЦикла;	
		КонецЦикла;
		
		Элементы.ГруппаПараметрыДиаграммы.Видимость = Ложь;
		
	ИначеЕсли  КомпоновщикНастроек.Настройки.Структура.Количество() = 3 
		И ТипЗнч(КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора]) = Тип("ДиаграммаКомпоновкиДанных") Тогда
		
		ИднетификаторОбъектаСКД = КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту( КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора]);
		//Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока = ИднетификаторОбъектаСКД;
		
		Для Каждого СтрУО Из  КомпоновщикНастроек.Настройки.Структура[2].ПараметрыВывода.Элементы Цикл		
			КомпоновщикНастроек.Настройки.ПараметрыВывода.УстановитьЗначениеПараметра(СтрУО.Параметр,СтрУО.Значение);		
		КонецЦикла;	
		
		Элементы.ГруппаСтруктураОбъекта.Видимость = Истина;

		
	КонецЕсли;	
	
	
КонецПроцедуры

 


&НаСервере
Процедура ИнициализироватьСКДИсточника()
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	Исключение
		
		СообщениеПользователю = Новый СообщениеПользователю;
		
		СтрокаШаблона = Нстр("ru = 'При инициализации отчета возникла ошибка:
		|%1'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда			
			СообщениеПользователю.Текст = СтрШаблон(СтрокаШаблона, ОписаниеОшибки());
		КонецЕсли;
		
		СообщениеПользователю.Сообщить();		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
	КонецПопытки;

	
КонецПроцедуры	

&НаКлиенте
Процедура Применить(Команда)
	
	КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора].УсловноеОформление.Элементы.Очистить();
	
	Для Каждого СтрУО Из КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы Цикл 
		нСтрокаУО = КомпоновщикНастроек.Настройки.Структура[ИндексПоказатеяИндикатора].УсловноеОформление.Элементы.Добавить();
		
		ЗаполнитьЗначенияСвойств(нСтрокаУО,СтрУО);
		
		Для Каждого ЭлементОформления Из СтрУО.Оформление.Элементы Цикл
			нСтрокаУО.Оформление.УстановитьЗначениеПараметра(ЭлементОформления.Параметр,ЭлементОформления.Значение);
			нСтрокаУО.Оформление.ПолучитьОбъектПоИдентификатору(СтрУО.Оформление.ПолучитьИдентификаторПоОбъекту(ЭлементОформления)).Использование = ЭлементОформления.Использование;
		КонецЦикла;	
		
		Для Каждого ЭлементОтбора Из СтрУО.Отбор.Элементы Цикл
			нЭлементОтбора = нСтрокаУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(нЭлементОтбора,ЭлементОтбора);
		КонецЦикла;	
	
	КонецЦикла;
	
	КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Очистить();

	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Настройки",КомпоновщикНастроек.Настройки);
	
	Закрыть(СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиПередУдалением(Элемент, Отказ)
	
	ЭлементСтруктуры = КомпоновщикНастроек.Настройки.ПолучитьОбъектПоИдентификатору(Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока);
    ТипЭлемента = ТипЗнч(ЭлементСтруктуры); 
	Если ТипЭлемента = Тип("ТаблицаКомпоновкиДанных")
		ИЛИ ТипЭлемента = Тип("ДиаграммаКомпоновкиДанных") Тогда
		Отказ =Истина;
	КонецЕсли;	
		

	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиПриАктивизацииСтроки(Элемент)
		
	
	ЭлементСтруктуры = КомпоновщикНастроек.Настройки.ПолучитьОбъектПоИдентификатору(Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока);	
	ТипЭлемента = ТипЗнч(ЭлементСтруктуры); 
	
	Если ТипЭлемента = Тип("ГруппировкаТаблицыКомпоновкиДанных")
		ИЛИ ТипЭлемента = Тип("ГруппировкаДиаграммыКомпоновкиДанных") 
		ИЛИ ТипЭлемента = Тип("КоллекцияЭлементовСтруктурыТаблицыКомпоновкиДанных") 
		ИЛИ ТипЭлемента = Тип("КоллекцияЭлементовСтруктурыДиаграммыКомпоновкиДанных") Тогда
		Элементы.КомпоновщикНастроекНастройки.ТолькоПросмотр = Ложь;
		
	Иначе	
		 	Элементы.КомпоновщикНастроекНастройки.ТолькоПросмотр = Истина;

	КонецЕсли;	
	
		
КонецПроцедуры

