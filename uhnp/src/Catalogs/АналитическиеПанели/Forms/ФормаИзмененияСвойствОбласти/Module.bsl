#Область НастройкиИзображения

&НаКлиенте
Процедура ИзменитьИзображение(Команда)
	
	Попытка
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Фильтр = "PNG (*.png)|*.png|JPEG (*.jpg)|*.jpg|SVG (*.svg)|*.svg|" + Нстр("ru = 'Все файлы'") + " (*.*)|*.*";
		ДиалогОткрытияФайла.Фильтр = Фильтр;
		ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите изображение'");
		
		ОписаниеОткрытияФайла = Новый ОписаниеОповещения("ДиалогОткрытияФайла1Завершение", ЭтаФорма);
		ДиалогОткрытияФайла.Показать(ОписаниеОткрытияФайла);
		
	Исключение
		ТекстСообщения = НСтр("ru = 'Произошла ошибка при  изображения: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки
	
КонецПроцедуры

&НаКлиенте
Процедура ДиалогОткрытияФайла1Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Для Каждого ТекМассивФайлов Из ВыбранноеЗначение Цикл
			ТекКартинка = Новый Картинка(ТекМассивФайлов);
			СтрокаИзображение = ПоместитьВоВременноеХранилище(ТекКартинка, ЭтаФорма.УникальныйИдентификатор);
		КонецЦикла;
		
	Иначе
		ТекстСообщения = НСтр("ru = 'Файл не выбран.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаИзображениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИзменитьИзображение(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзображение(Команда)
	
	ТекКартинка = Новый Картинка();
	СтрокаИзображение = ПоместитьВоВременноеХранилище(ТекКартинка, ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры



#КонецОбласти

#Область НастройкиДиаграммыГанта

&НаКлиенте
Процедура ПолеПроектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ПолеПроектВыборЗавершение", ЭтаФорма);
	
	ПараметрыФормы  = Новый Структура;
	ПараметрыФормы.Вставить("URLСхемы",URLСхемы);
	ПараметрыФормы.Вставить("ОтображатьИзмерения",Истина);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаВыбораПоляСКД",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеПроектВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
    ПолеПроект = Строка(Результат);
	
КонецПроцедуры


#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьСКДИсточника()
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	Исключение
		
		СообщениеПользователю = Новый СообщениеПользователю;
		
		СтрокаШаблона = Нстр("ru = 'При инициализации отчета возникла ошибка:
		|%1'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда			
			СообщениеПользователю.Текст = СтрШаблон(СтрокаШаблона, ОписаниеОшибки());
		КонецЕсли;
		
		СообщениеПользователю.Сообщить();		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
	КонецПопытки;

	
КонецПроцедуры	

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.ГруппаНастройкиИндикатора.Видимость 			= Ложь;
	Элементы.ГруппаНастройкаОбъекта.Видимость 				= Ложь;
	Элементы.ГруппаВнешняяИБ.Видимость 						= Ложь;
	Элементы.ГруппаНастройкиКартинки.Видимость 				= Ложь;
	Элементы.ГруппаНастройкиТекста.Видимость 				= Ложь;
	Элементы.ГруппаНастройкиДиаграммыГанта.Видимость 		= Ложь;

	
	Если ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ИзмерительнаяДиаграмма
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Гистограмма
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ГистограммаГоризонтальная
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.График
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ГрафикСОбластями
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ТочечнаяДиаграмма
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.КруговаяДиаграмма
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Поверхность
		ИЛИ ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Воронка Тогда
		
		Элементы.ГруппаНастройкаОбъекта.Видимость 	  = Истина;
		Элементы.ГруппаВнешняяИБ.Видимость            = НЕ РежимРаботыСДанными;
	
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда	
		
		Элементы.ГруппаНастройкиИндикатора.Видимость  = НЕ РежимРаботыСДанными;
		Элементы.ГруппаВнешняяИБ.Видимость            = НЕ РежимРаботыСДанными;
		
		Элементы.ГруппаНастройкаБазовогоЗначенияИндикатора.Доступность         = Индикатор_ВыводитьБазовоеЗначение;
		Элементы.ГруппаДинамика.Доступность   						   		   = ИндикаторВыводитьДиаграмму;
		
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда	
		
		Элементы.ГруппаНастройкиКартинки.Видимость    = НЕ РежимРаботыСДанными;
			
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда	
		
		Элементы.ГруппаНастройкиТекста.Видимость    	= НЕ РежимРаботыСДанными;	
		
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда	
		
		Элементы.ГруппаНастройкиДиаграммыГанта.Видимость    = НЕ РежимРаботыСДанными;
		
	Иначе			
		
	КонецЕсли;	
	
	Элементы.МаксимальнаяШирина_.Видимость = Не АвтомаксимальнаяШирина_;
	Элементы.МаксимальнаяВысота_.Видимость = Не АвтомаксимальнаяВысота_;
	
	Элементы.ТипОбъекта.Видимость  				  = НЕ РежимРаботыСДанными;
	Элементы.ГруппаЗаголовок.Видимость    		  = НЕ РежимРаботыСДанными;
	Элементы.ГруппаРамка.Видимость    		  	  = НЕ РежимРаботыСДанными;
	
КонецПроцедуры	

&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ЗначениеЗаполнено(ТипОбъекта) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран тип объекта '"),,"ТипОбъекта");		
		Возврат;
	КонецЕсли;
	
	Если ТипОбъекта = ПредопределенноеЗначение("Перечисление.ВидыЭлементовАналитическойПанели.ПолеИндикатора") Тогда
		Если Не ЗначениеЗаполнено(ИсточникДанныхИндикатора) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран источник значения для индиктора '"),,"ИсточникДанныхИндикатора");		
			Возврат;
		КонецЕсли;
		
		Если Индикатор_ВыводитьБазовоеЗначение И 
			НЕ ЗначениеЗаполнено(ИсточникДанныхИндикатораБаза) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран источник базового значения для индиктора '"),,"ИсточникДанныхИндикатораБаза");		
			Возврат;
		КонецЕсли;
				
	ИначеЕсли ТипОбъекта = ПредопределенноеЗначение("Перечисление.ВидыЭлементовАналитическойПанели.ДиаграммаГанта") Тогда	
		
		  Если  НЕ ЗначениеЗаполнено(ПолеПроект) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана  аналитика  проекта диаграммы Ганта '"),,"ПолеПроект");		
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ТипОбъекта",ТипОбъекта);
	СтруктураПараметров.Вставить("ЗаголовокЭлемента",ЗаголовокЭлемента);
	СтруктураПараметров.Вставить("СкрытьЗаголовокЭлемента",СкрытьЗаголовокЭлемента);
    СтруктураПараметров.Вставить("ЗафиксироватьОтборы",ЗафиксироватьОтборы);

	
	НастройкиЭлемента = Новый Структура;
	
	НастройкиЭлемента.Вставить("ШрифтЗаголовка",ШрифтЗаголовка);
	НастройкиЭлемента.Вставить("ЦветТекстаЗаголовка",ЦветТекстаЗаголовка);
	НастройкиЭлемента.Вставить("ЦветФонаЗаголовка",ЦветФонаЗаголовка);

	НастройкиЭлемента.Вставить("Ширина",Ширина_);
	НастройкиЭлемента.Вставить("Высота",Высота_);
	НастройкиЭлемента.Вставить("АвтомаксимальнаяВысота",АвтомаксимальнаяВысота_);
	НастройкиЭлемента.Вставить("АвтомаксимальнаяШирина",АвтомаксимальнаяШирина_);
    НастройкиЭлемента.Вставить("МаксимальнаяВысота",МаксимальнаяВысота_);
	НастройкиЭлемента.Вставить("МаксимальнаяШирина",МаксимальнаяШирина_);
    НастройкиЭлемента.Вставить("РастягиватьПоГоризонтали",РастягиватьПоГоризонтали_);
	НастройкиЭлемента.Вставить("РастягиватьПоВертикали",РастягиватьПоВертикали_);
	НастройкиЭлемента.Вставить("НастройкиКомпоновщика",КомпоновщикНастроек.Настройки);
	НастройкиЭлемента.Вставить("ИнформационнаяБаза",ИнформационнаяБаза);
    НастройкиЭлемента.Вставить("ВыводитьРамку",ВыводитьРамку);
	НастройкиЭлемента.Вставить("ЦветРамкиЭлемента",ЦветРамкиЭлемента);

	ДополнитьНастройкиЭлемента(НастройкиЭлемента);
	
	СтруктураПараметров.Вставить("НастройкиЭлемента",НастройкиЭлемента);
	
	Закрыть(СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьНастройкиЭлемента(НастройкиЭлемента)

    Если ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда
		
		НастройкиЭлемента.Вставить("ИсточникДанныхИндикатора",ИсточникДанныхИндикатора);
		НастройкиЭлемента.Вставить("ИсточникДанныхИндикатораБаза",ИсточникДанныхИндикатораБаза);
		НастройкиЭлемента.Вставить("ЕдиницаИзмеренияИндикатора",ЕдиницаИзмеренияИндикатора);
		НастройкиЭлемента.Вставить("Индикатор_ВыводитьБазовоеЗначение",Индикатор_ВыводитьБазовоеЗначение);
		НастройкиЭлемента.Вставить("ИндикаторВыводитьДиаграмму",ИндикаторВыводитьДиаграмму);
        НастройкиЭлемента.Вставить("ИндикаторПолеПериодаДинамики",ИндикаторПолеПериодаДинамики);
		НастройкиЭлемента.Вставить("ИндикаторКоличествоПериодовДинамики",ИндикаторКоличествоПериодовДинамики);
		
		Если ШаблонВиджета.ВысотаТаблицы = 0 Тогда
			  ШаблонВиджета.Вывести(Справочники.АналитическиеПанели.ПолучитьМакет("ШаблонВиджета"));
		КонецЕсли;	
		
		НастройкиЭлемента.Вставить("ШаблонВиджета",ШаблонВиджета);
		
		Если НЕ СтрокаЛоготип = "" Тогда 
			НастройкиЭлемента.Вставить("Логотип",ЗначениеВСтрокуВнутр(ПолучитьИзВременногоХранилища(СтрокаЛоготип)));
		Иначе	
			НастройкиЭлемента.Вставить("Логотип",ЗначениевСтрокуВнутр(Новый Картинка));
		КонецЕсли;
		
		НастройкиЭлемента.Вставить("ФорматЗначенияИндикатора",ФорматЗначенияИндикатора);
		НастройкиЭлемента.Вставить("ЦветТекстаЗначенияИндикатора",ЦветТекстаЗначенияИндикатора);
        НастройкиЭлемента.Вставить("ШрифтТекстаИндикатора",ШрифтТекстаИндикатора);
		НастройкиЭлемента.Вставить("ЦветФонаИндикатора",ЦветФонаИндикатора);
		
		
		НастройкиЭлемента.НастройкиКомпоновщика.Структура[0].Выбор.Элементы.Очистить();
		нПоле = НастройкиЭлемента.НастройкиКомпоновщика.Структура[0].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		нПоле.Поле  = Новый ПолеКомпоновкиДанных(ИсточникДанныхИндикатора);
		
		НастройкиЭлемента.НастройкиКомпоновщика.Структура[1].Выбор.Элементы.Очистить();
		Если Индикатор_ВыводитьБазовоеЗначение Тогда
			нПоле = НастройкиЭлемента.НастройкиКомпоновщика.Структура[1].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			нПоле.Поле  = Новый ПолеКомпоновкиДанных(ИсточникДанныхИндикатораБаза);
		КонецЕсли;
		
		НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Выбор.Элементы.Очистить();
		НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Точки.Очистить();
		
		Если ИндикаторВыводитьДиаграмму Тогда
			НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Использование = Истина;
			нПоле = НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			нПоле.Поле  			= Новый ПолеКомпоновкиДанных(ИсточникДанныхИндикатора);
			
			нГруппировка        	= НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Точки.Добавить();
			
			ПолеГруппировки 		= нГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле 	= Новый ПолеКомпоновкиДанных(ИндикаторПолеПериодаДинамики);
			нГруппировка.ПараметрыВывода.УстановитьЗначениеПараметра("КоличествоЗаписей",ИндикаторКоличествоПериодовДинамики);
		
		Иначе	
			НастройкиЭлемента.НастройкиКомпоновщика.Структура[2].Использование = Ложь;
		КонецЕсли;
		
		НастройкиЭлемента.Вставить("ВариантОтображенияБазовогоЗначения",ВариантОтображенияБазовогоЗначения);
				
	ИначеЕсли  ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда	
		
		НастройкиЭлемента.Вставить("ПолеПроект",ПолеПроект);
	
	ИначеЕсли  ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда
		
		Если НЕ СтрокаИзображение = "" Тогда 
			НастройкиЭлемента.Вставить("Изображение",ЗначениеВСтрокуВнутр(ПолучитьИзВременногоХранилища(СтрокаИзображение)));
		Иначе	
			НастройкиЭлемента.Вставить("Изображение",ЗначениевСтрокуВнутр(Новый Картинка));
		КонецЕсли;		 
		
	ИначеЕсли  ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда
		
		НастройкиЭлемента.Вставить("ПолеТекст",ПолеТекст);
			 	
	КонецЕсли;	 


КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)
	
	УстановитьТипОбъекта();
	УправлениеФормой();
	ТипОбъектаТекущий = ТипОбъекта;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипОбъекта()
	
	
	СовместимыеТипыОбъектов = Новый Массив;
	СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.Воронка);
	СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.ИзмерительнаяДиаграмма);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.Гистограмма);
	СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.ГистограммаГоризонтальная);
	СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.График);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.ГрафикСОбластями);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.ТочечнаяДиаграмма);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.РадарныйГрафик);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.КруговаяДиаграмма);
    СовместимыеТипыОбъектов.Добавить(Перечисления.ВидыЭлементовАналитическойПанели.Поверхность);
	
	Если ЗначениеЗаполнено(ТипОбъектаТекущий) Тогда
		Если НЕ СовместимыеТипыОбъектов.Найти(ТипОбъектаТекущий) = Неопределено
			И НЕ СовместимыеТипыОбъектов.Найти(ТипОбъекта) = Неопределено Тогда
			//Другая диаграмма 
			ДобавитьНастройкиПоТипуОбъекта(СовместимыеТипыОбъектов);	
			
		Иначе
			КомпоновщикНастроек.Настройки.Структура.Очистить();
			ДобавитьНастройкиПоТипуОбъекта(СовместимыеТипыОбъектов);
		КонецЕсли;
	Иначе	
		//Добавляем 
		ДобавитьНастройкиПоТипуОбъекта(СовместимыеТипыОбъектов);
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьНастройкиПоТипуОбъекта(СовместимыеТипыОбъектов);
	
	СоответствиеТиповДиаграмм = Новый Соответствие;
	СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.Воронка,ТипДиаграммы.Воронка);
	СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.ИзмерительнаяДиаграмма,ТипДиаграммы.Измерительная);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.Гистограмма,ТипДиаграммы.Гистограмма);
	СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.ГистограммаГоризонтальная,ТипДиаграммы.ГистограммаГоризонтальная);
	СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.График,ТипДиаграммы.График);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.ГрафикСОбластями,ТипДиаграммы.ГрафикСОбластями);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.ТочечнаяДиаграмма,ТипДиаграммы.Точечная);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.РадарныйГрафик,ТипДиаграммы.РадарныйГрафик);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.КруговаяДиаграмма,ТипДиаграммы.Круговая);
    СоответствиеТиповДиаграмм.Вставить(Перечисления.ВидыЭлементовАналитическойПанели.Поверхность,ТипДиаграммы.Поверхность);
	
	Если ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
		
		Если КомпоновщикНастроек.Настройки.Структура.Количество() = 0 Тогда		
			нОбъект = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));		
		КонецЕсли;	
			
	ИначеЕсли НЕ СовместимыеТипыОбъектов.Найти(ТипОбъекта) = Неопределено Тогда
		
		Если КомпоновщикНастроек.Настройки.Структура.Количество() = 0 Тогда
			СхемаКД = ПолучитьИзВременногоХранилища(URLСхемы);	 
			нОбъект = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ДиаграммаКомпоновкиДанных"));
        Иначе
			нОбъект = КомпоновщикНастроек.Настройки.Структура[0];
		КонецЕсли;
		
		Если ТипЗнч(нОбъект) = Тип("ДиаграммаКомпоновкиДанных") Тогда
			
			Если нОбъект.Выбор.Элементы.Количество() = 0 Тогда
				//Заполним выбранные ресурсы диаграммы
				Для Каждого Рес Из СхемаКД.ПоляИтога Цикл
					нПоле = нОбъект.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					нПоле.Поле  = Новый ПолеКомпоновкиДанных(Рес.ПутьКДанным);
				КонецЦикла;	 
			КонецЕсли;
			
			//Установим тип диаграммы 
			нОбъект.ПараметрыВывода.УстановитьЗначениеПараметра("ТипДиаграммы",СоответствиеТиповДиаграмм.Получить(ТипОбъекта));			
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда	
					
		//Для вывода значения
		Группировка1 = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
		//для вывода базового/отклонения от базы
		Группировка2 = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
		//для вывода графика с динамикой
		Группировка3 = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ДиаграммаКомпоновкиДанных"));
		Группировка3.ПараметрыВывода.УстановитьЗначениеПараметра("ТипДиаграммы",ТипДиаграммы.График);			
		
		ЦветФонаИндикатора                      = Новый Цвет(255,255,255);	
	
		Высота_ = 5;
		Ширина_ = 22;
		ИндикаторКоличествоПериодовДинамики     = 5;
		
	КонецЕсли;
	
			
КонецПроцедуры	


&НаКлиенте
Процедура ОткрытьНастройкиСКДДиаграммыИндикатора(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьСвойстваСКДДиаграммыИндикатораЗавершение", ЭтаФорма);
	
	ПараметрыФормы  = Новый Структура;
	ПараметрыФормы.Вставить("URLСхемы",URLСхемы);
	ПараметрыФормы.Вставить("НастройкиКомпоновщика",		КомпоновщикНастроек.Настройки);
	ПараметрыФормы.Вставить("ТипОбъекта",					ТипОбъекта);
    ПараметрыФормы.Вставить("ИндексПоказатеяИндикатора",	2);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаНастройкиСКДИндикатора",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСвойстваСКДДиаграммыИндикатораЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
    КомпоновщикНастроек.ЗагрузитьНастройки(Результат.Настройки);
	
КонецПроцедуры





#КонецОбласти



