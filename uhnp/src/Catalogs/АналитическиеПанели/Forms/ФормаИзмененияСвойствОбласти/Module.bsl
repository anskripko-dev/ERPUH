
#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ширина_ 							= Параметры.Ширина;
	Высота_             				= Параметры.Высота;
	АвтомаксимальнаяВысота_ 			= Параметры.АвтомаксимальнаяВысота;
	АвтомаксимальнаяШирина_ 			= Параметры.АвтомаксимальнаяШирина;
	МаксимальнаяВысота_ 				= Параметры.МаксимальнаяВысота;
	МаксимальнаяШирина_ 				= Параметры.МаксимальнаяШирина;
    РастягиватьПоГоризонтали_ 			= Параметры.РастягиватьПоГоризонтали;
	РастягиватьПоВертикали_ 			= Параметры.РастягиватьПоВертикали;
	ТипОбъекта                          = Параметры.ТипОбъекта;
	ЗаголовокЭлемента                   = Параметры.ЗаголовокЭлемента;
	СкрытьЗаголовокЭлемента             = Параметры.СкрытьЗаголовокЭлемента;
    РежимРаботыСДанными                 = Параметры.РежимРаботыСДанными;
	ЗафиксироватьОтборы                 = Параметры.ЗафиксироватьОтборы;
	
	Элементы.ВариантОтображенияБазовогоЗначения.СписокВыбора.Добавить(1,Нстр("ru = 'Значение'"));
	Элементы.ВариантОтображенияБазовогоЗначения.СписокВыбора.Добавить(2,Нстр("ru = 'Абс. отклонение'"));
    Элементы.ВариантОтображенияБазовогоЗначения.СписокВыбора.Добавить(3,Нстр("ru = 'Отн. отклонение (%)'"));
	
	ВариантОтображенияБазовогоЗначения = 3;
	
	//ТипыВнешнихИБ.Загрузить(Параметры.ТипыВнешнихИБ.Выгрузить());
	
	Если Параметры.Свойство("ШрифтЗаголовка") Тогда
		ШрифтЗаголовка                      = Параметры.ШрифтЗаголовка;	
	КонецЕсли;
	
	Если Параметры.Свойство("ИнформационнаяБаза") Тогда
		ИнформационнаяБаза                   = Параметры.ИнформационнаяБаза;	
	КонецЕсли;
	
	Если Параметры.Свойство("ЦветТекстаЗаголовка") Тогда
		ЦветТекстаЗаголовка  = Параметры.ЦветТекстаЗаголовка;	
	Иначе	
		ЦветТекстаЗаголовка  = Новый Цвет(28,85,174);
	КонецЕсли;
	
	Если Параметры.Свойство("ЦветФонаЗаголовка") Тогда
		ЦветФонаЗаголовка  = Параметры.ЦветФонаЗаголовка;	
	Иначе	
		ЦветФонаЗаголовка  = Новый Цвет(255,255,255);
	КонецЕсли;
	
	Если Параметры.Свойство("ВыводитьРамку") Тогда
		ВыводитьРамку  = Параметры.ВыводитьРамку;	
	КонецЕсли;
	
	Если Параметры.Свойство("ЦветРамкиЭлемента") Тогда
		ЦветРамкиЭлемента  = Параметры.ЦветРамкиЭлемента;	
	КонецЕсли;
	
	Если Параметры.Свойство("ВариантОтображенияБазовогоЗначения") Тогда
		ВариантОтображенияБазовогоЗначения  = Параметры.ВариантОтображенияБазовогоЗначения;	
	КонецЕсли;

	
	URLСхемы                            = Параметры.URLСхемы;
	
	ТипОбъектаТекущий                 	 = ТипОбъекта;
	
	Если Не Параметры.НастройкиКомпоновщика = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Параметры.НастройкиКомпоновщика);
	Иначе	
		КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьИзВременногоХранилища(URLСхемы).НастройкиПоУмолчанию);
		КомпоновщикНастроек.Настройки.Структура.Очистить();
	КонецЕсли;
	
	Если ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда
		
		ИсточникДанныхИндикатора 		= Параметры.ИсточникДанныхИндикатора;
		ИсточникДанныхИндикатораБаза 	= Параметры.ИсточникДанныхИндикатораБаза;
		ЕдиницаИзмеренияИндикатора 		= Параметры.ЕдиницаИзмеренияИндикатора;
		СтрокаЛоготип					= ПоместитьВоВременноеХранилище(ЗначениеИзСтрокиВнутр(Параметры.Логотип),ЭтаФорма.УникальныйИдентификатор);
		ФорматЗначенияИндикатора 		= Параметры.ФорматЗначенияИндикатора;
		ЦветТекстаЗначенияИндикатора 	= Параметры.ЦветТекстаЗначенияИндикатора;
		ШрифтТекстаИндикатора 			= Параметры.ШрифтТекстаИндикатора;
		
		Индикатор_ВыводитьБазовоеЗначение = Параметры.Индикатор_ВыводитьБазовоеЗначение;
		ИндикаторВыводитьДинамику 		  = Параметры.ИндикаторВыводитьДинамику;
        ИндикаторПолеПериодаДинамики 	  = Параметры.ИндикаторПолеПериодаДинамики;
		ИндикаторКоличествоПериодовДинамики = Параметры.ИндикаторКоличествоПериодовДинамики;
		
		Если Параметры.Свойство("ЦветФонаИндикатора") Тогда
			ЦветФонаИндикатора                      = Параметры.ЦветФонаИндикатора;	
		Иначе	
			ЦветФонаИндикатора  					= Новый Цвет(255,255,255);		
		КонецЕсли;
		
		Если Параметры.Свойство("ШаблонВиджета") Тогда
			ШаблонВиджета.Вывести(Параметры.ШаблонВиджета);	
		КонецЕсли;

		
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда	
		
		СтрокаИзображение					= ПоместитьВоВременноеХранилище(ЗначениеИзСтрокиВнутр(Параметры.Изображение),ЭтаФорма.УникальныйИдентификатор);
	
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда	
		
		Если Параметры.Свойство("ПолеТекст") Тогда
			ПолеТекст                       = Параметры.ПолеТекст;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДиаграммаГанта Тогда	
		
		Если Параметры.Свойство("ПолеПроект") Тогда
			ПолеПроект                        = Параметры.ПолеПроект;
		КонецЕсли;
		
	КонецЕсли;	
		
	ИнициализироватьСКДИсточника();
	
	УправлениеФормой();

КонецПроцедуры

#КонецОбласти

