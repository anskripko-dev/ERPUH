&НаКлиенте
Процедура Подключаемый_ОбработатьВыборДействия(ВыполненноеДействие,  Настройки, ДополнительныеПараметры) Экспорт
    
    Расшифровка = ДополнительныеПараметры.Расшифровка;
        
    // Осуществим выбор действия расшифровки пользователем     
    Если Настройки <> Неопределено Тогда
        // Пользователь выбрал действие, для которого нужно менять настройки
        Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Упорядочить Тогда
			
			// Если требуется упорядочить - упорядочим в текущем отчете
            КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
			
		ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Упорядочить Тогда	
	
			
		ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
            ПоказатьЗначение(, Настройки);
        Иначе
            
			Вн_Настройки =ПрименитьНастройкиКД(Расшифровка, Настройки);
			
			ОбщийОтбор = Новый Структура;
			ОбщийОтбор.Вставить("Сценарий",Сценарий);
			ОбщийОтбор.Вставить("ПериодОтчета",ПериодОтчета);
			ОбщийОтбор.Вставить("ПериодОкончания",ПериодОкончания);
			//ОбщийОтбор.Вставить("Организация",Организация);
			ОбщийОтбор.Вставить("Валюта",Валюта);

			
			ПараметрыФормы = Новый Структура("URLСхемы, Настройки,ОбщийОтбор, ЭтоРасшифровка, АдресТаблицыДанных,ПакетДанных", 
												URLСхемы, Вн_Настройки,ОбщийОтбор, Истина, АдресТаблицыДанных,ПакетДанных);
            ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаРасшифровкиЗначения", ПараметрыФормы, , Истина);
				
		КонецЕсли;
		
	Иначе	
		
		Если ВыполненноеДействие ="ТаблицаКМУстановитьОтборПоЗначениям" Тогда 
			ТаблицаКМУстановитьОтборПоЗначениям(ЭтаФорма.ТекущийЭлемент);
		ИначеЕсли ВыполненноеДействие ="ТаблицаКМСброситьОтборПоЗначениям" Тогда	 
			ТаблицаКМСброситьОтборПоЗначениям(ЭтаФорма.ТекущийЭлемент);
		КонецЕсли;
		
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРасшифровкуТекущегоЭлемента(Элемент,Расшифровка, СтандартнаяОбработка) Экспорт
	
	Перем СписокДоступныхРасшифровок;
	Перем АдресМассиваДоступныхРасшифровок;
	
	СтандартнаяОбработка = Ложь;
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя)[0];
	ТекущийЭлементИмя        = ЭтаФорма.ТекущийЭлемент.Имя;
	АдресДанныхРасшифровки   = СвойстваТекущегоЭлемента.АдресДанныхРасшифровки;
	
	СтруктураОтвета = ВернутьСписокДоступныхРасшифровок(Расшифровка,СвойстваТекущегоЭлемента.АдресДанныхРасшифровки);
	СтруктураОтвета.Свойство("СписокДоступныхРасшифровок", СписокДоступныхРасшифровок);
	СтруктураОтвета.Свойство("АдресМассиваДоступныхРасшифровок", АдресМассиваДоступныхРасшифровок);
	
	Если СписокДоступныхРасшифровок.Количество() = 1 Тогда
		ВыбранноеЗначение = СписокДоступныхРасшифровок[0];
	Иначе
		
		ДопПараметры =Новый Структура("Расшифровка", Расшифровка);
		Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработкаРасшифровки", ЭтотОбъект, ДопПараметры);
		ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокДоступныхРасшифровок,Элемент);
		
		Возврат;
		
	КонецЕсли;
	
	ОбработкаРасшифровкиЗавершение(Элемент,ВыбранноеЗначение, Расшифровка);
	
КонецПроцедуры

&НаКлиенте
Процедура СтандартнаяОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка = Ложь)

	Перем ВыполненноеДействие;
	Перем Настройки;
	
	// Запретим стандартную обработку расшифровки
	СтандартнаяОбработка = Ложь;
	
	// Создадим и инициализируем обработчик расшифровки
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ТекущийЭлементИмя)[0];
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(СвойстваТекущегоЭлемента.АдресДанныхРасшифровки, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));

	ДопПараметры = Новый Структура("ВыполненноеДействие, Настройки, Расшифровка", ВыполненноеДействие, Настройки, Расшифровка);
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьВыборДействия", ЭтотОбъект, ДопПараметры);
	
	ДоступныеДействия = Новый Массив();
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);

	ДополнительныеПунктыМеню = Новый СписокЗначений;
	ДополнительныеПунктыМеню.Добавить("ТаблицаКМУстановитьОтборПоЗначениям","Установить отбор по значениям",,БиблиотекаКартинок.СводнаяТаблицаФильтрАктивен);
	ДополнительныеПунктыМеню.Добавить("ТаблицаКМСброситьОтборПоЗначениям","Сбросить отбор по значениям",,БиблиотекаКартинок.СводнаяТаблицаФильтрНеАктивен);

	
	ЭтаФорма.ТекущийЭлемент = Элемент;
	
	ОбработкаРасшифровки.ПоказатьВыборДействия(Оповещение, Расшифровка,ДоступныеДействия,ДополнительныеПунктыМеню,,Элемент);

КонецПроцедуры

