 
#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ШаблонПанели = Параметры.ШаблонПанели;
	
	Если ШаблонПанели.Пустая()  Тогда	
		Отказ =Истина;					
	КонецЕсли;
	
	Элементы.ГруппаСтатусОбновить.Видимость = Ложь;	
	
	РежимРаботыСДанными     = Истина;
	ТекущаяСтраницаИмя 		= "Страница1";    
	
	СтрокаКоманды 			= 0;
	КолонкаКоманды 			= 1;
				
	ПрочитатьНастройкиПанели();
	
	ИнициализироватьСКДИсточника();
	
	Если РазметкаПанели.Количество() = 0 Тогда
		ДобавитьПервуюСтраницу();
		Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма);
	Иначе	
		Справочники.АналитическиеПанели.ЗаполнитьПанельПоРазметке(ЭтаФорма);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Периодичность) 
		И Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		 Периодичность = Перечисления.Периодичность.Месяц;
	 ИначеЕсли Не ЗначениеЗаполнено(Периодичность) 
		 И  ЗначениеЗаполнено(ПериодОтчета) Тогда
	     Периодичность = ПериодОтчета.Периодичность;
	КонецЕсли;
	  
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.5);
	ПодключитьОбработчикОжидания("ПоказатьТекущийЭлемент_Подключаемый", 1,Ложь);
	
	КоличествоВыделенныхЯчеек = 1;
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
   	ЗаписатьНастройкиПанели();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
		
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
		
	Если НЕ ЭтоРасшифровка Тогда
		
		Если ЗначениеЗаполнено(ТекущийВариантПанели) Тогда
				
			тВариантОбъект =  ТекущийВариантПанели.ПолучитьОбъект();
			//Запишем значения быстрых отборов варианта
			тВариантОбъект.Периодичность 	= Периодичность;
			тВариантОбъект.ПериодОтчета  	= ПериодОтчета;
            тВариантОбъект.ПериодОкончания  = ПериодОкончания;
            тВариантОбъект.Валюта 			= Валюта;
            тВариантОбъект.Сценарий 		= Сценарий;
			тВариантОбъект.НастройкиСКД     = ЗначениеВСтрокуВнутр(КомпоновщикНастроек.Настройки);
			тВариантОбъект.Записать();
			
			ПоследнийВариант = РегистрыСведений.НастройкиПользователейАналитическихПанелей.СоздатьНаборЗаписей();
			ПоследнийВариант.Отбор.Пользователь.Установить(ОбщегоНазначенияУХ.ТекущийПользователь());
			ПоследнийВариант.Отбор.ШаблонПанели.Установить(ШаблонПанели);
			
			ПоследнийВариант.Записать(Истина);
			
			ПоследнийВариант = РегистрыСведений.НастройкиПользователейАналитическихПанелей.СоздатьНаборЗаписей();
			ПоследнийВариант.Отбор.Пользователь.Установить(ОбщегоНазначенияУХ.ТекущийПользователь());
			ПоследнийВариант.Отбор.ШаблонПанели.Установить(ШаблонПанели);
			ПоследнийВариант.Отбор.ВариантПанели.Установить(ТекущийВариантПанели);
			
			ЗаписьВарианта = ПоследнийВариант.Добавить();
			ЗаписьВарианта.ВариантПанели = ТекущийВариантПанели;
			ЗаписьВарианта.ШаблонПанели = ШаблонПанели;
			ЗаписьВарианта.Пользователь = ОбщегоНазначенияУХ.ТекущийПользователь();
			
			ПоследнийВариант.Записать();
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры



