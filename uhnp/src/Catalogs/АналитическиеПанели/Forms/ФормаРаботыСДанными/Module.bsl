&НаКлиенте
Процедура ДобавитьСтрокуРазметки(Команда)
	
	КолонкаКоманды = Прав(ЭтаФорма.ТекущийЭлемент.Имя,1);
	СтрокаКоманды  = Лев(Прав(ЭтаФорма.ТекущийЭлемент.Имя,3),1);
	
	ДобавитьСтрокуРазметкиСервер();

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРазметкиСервер(СтрокаРазметки = Неопределено,СтраницаРазметки = Неопределено)

	Справочники.АналитическиеПанели.ДобавитьСтрокуРазметкиСервер(ЭтаФорма);
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитКолонкуРазметки(Команда)
	
	 КолонкаКоманды = Прав(ЭтаФорма.ТекущийЭлемент.Имя,1);
	 СтрокаКоманды  = Лев(Прав(ЭтаФорма.ТекущийЭлемент.Имя,3),1);
	
     ДобавитьКолонкуРазметкиСервер();
	 	 
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуРазметкиСервер(КолонкаРазметки = Неопределено)
    
	Если КолонкаРазметки = Неопределено Тогда	
		нСтр 					= РазметкаПанели.Добавить();
		нСтр.ИмяСтраницы     	= ТекущаяСтраницаИмя;
		нСтр.ИндексСтроки    	= СтрокаКоманды;
		нСтр.ИндексКолонки   	= КолонкаКоманды+1;
		нСтр.ИмяЭлемента     	= "Элемент_"+ТекущаяСтраницаИмя+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
		нСтр.ИмяГруппыЭлемента  = "ЭлементГруппа_"+ТекущаяСтраницаИмя+"_"+нСтр.ИндексСтроки+"_"+нСтр.ИндексКолонки;
		нСтр.ЗаголовокЭлемента   = Нстр("ru = 'Новый элемент'") ;
	Иначе	
		нСтр = КолонкаРазметки;
	КонецЕсли;
   
   Справочники.АналитическиеПанели.ДобавитьЭлементНаФорму(ЭтаФорма,нСтр);
      
КонецПроцедуры	

&НаКлиенте
Процедура ИзменитьСвойстваОбласти(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьСвойстваОбластиЗавершение", ЭтаФорма);
		
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);

	ПараметрыФормы 		= ПодготовитьПараметрыВызоваФормыОбъекта(СвойстваТекущегоЭлемента[0].НастройкиЭлемента);	
	
	ПараметрыФормы.Вставить("URLСхемы",URLСхемы);
	ПараметрыФормы.Вставить("ТипОбъекта",			СвойстваТекущегоЭлемента[0].ТипОбъекта);
	ПараметрыФормы.Вставить("ЗаголовокЭлемента",	СвойстваТекущегоЭлемента[0].ЗаголовокЭлемента);
	ПараметрыФормы.Вставить("ЗафиксироватьОтборы",	СвойстваТекущегоЭлемента[0].ЗафиксироватьОтборы);

	ПараметрыФормы.Вставить("РежимРаботыСДанными",	РежимРаботыСДанными);

	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаИзмененияСвойствОбласти",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыВызоваФормыОбъекта(НастройкиЭлементаСтрока)
	
	Параметры = Новый Структура;

	Если Не ЗначениеЗаполнено(НастройкиЭлементаСтрока) Тогда
		Возврат Параметры;
	КонецЕсли;	
		
	Параметры 												= ЗначениеИзСтрокиВнутр(НастройкиЭлементаСтрока);
		
	Возврат Параметры;
	
КонецФункции	

&НаКлиенте
Процедура ИзменитьСвойстваОбластиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	Если СвойстваТекущегоЭлемента.Количество() =0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяТекущегоЭлемента = СвойстваТекущегоЭлемента[0].ИмяЭлемента;
	
	Элементы[ИмяТекущегоЭлемента].Ширина 					= Результат.НастройкиЭлемента.Ширина;
	Элементы[ИмяТекущегоЭлемента].Высота 					= Результат.НастройкиЭлемента.Высота;
	Элементы[ИмяТекущегоЭлемента].РастягиватьПоВертикали 	= Результат.НастройкиЭлемента.РастягиватьПоВертикали;
	Элементы[ИмяТекущегоЭлемента].РастягиватьПоГоризонтали = Результат.НастройкиЭлемента.РастягиватьПоГоризонтали;
	СвойстваТекущегоЭлемента[0].ЗафиксироватьОтборы 		= Результат.ЗафиксироватьОтборы;
	
	Если НЕ ТипЗнч(Элементы[ИмяТекущегоЭлемента]) = Тип("ГруппаФормы") Тогда 
		Элементы[ИмяТекущегоЭлемента].АвтомаксимальнаяВысота 	= Результат.НастройкиЭлемента.АвтомаксимальнаяВысота;
		Элементы[ИмяТекущегоЭлемента].АвтомаксимальнаяШирина 	= Результат.НастройкиЭлемента.АвтомаксимальнаяШирина;
		Элементы[ИмяТекущегоЭлемента].МаксимальнаяВысота 		= Результат.НастройкиЭлемента.МаксимальнаяВысота;
		Элементы[ИмяТекущегоЭлемента].МаксимальнаяШирина 		= Результат.НастройкиЭлемента.МаксимальнаяШирина;
	КонецЕсли;
	
	Результат.Вставить("ИмяТекущегоЭлемента",ИмяТекущегоЭлемента);
		
	ИзменитьСвойстваОбластиСервер(Результат);

	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСвойстваОбластиСервер(Результат);
		
	//Изменим свойства соответствующего элемента в разметке таблицы
	тРазметкаПанели  = РазметкаПанели.Выгрузить();
	тОбластьВТаблице = тРазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",Результат.ИмяТекущегоЭлемента))[0];

	тОбластьВТаблице.НастройкиЭлемента 		= ЗначениеВСтрокуВнутр(Результат.НастройкиЭлемента);
	тОбластьВТаблице.ТипОбъекта             = Результат.ТипОбъекта;
	тОбластьВТаблице.ЗаголовокЭлемента      = Результат.ЗаголовокЭлемента;
	тОбластьВТаблице.ЗафиксироватьОтборы    = Результат.ЗафиксироватьОтборы;
	
	Справочники.АналитическиеПанели.УстановитьСвойстваЗаголовкаФрейма(Результат.ЗаголовокЭлемента,Элементы["Заголовок_"+Результат.ИмяТекущегоЭлемента],Результат.НастройкиЭлемента,Результат.СкрытьЗаголовокЭлемента);
	
	Если Результат.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.Таблица Тогда
					
		СоздатьФреймТаблицы(тОбластьВТаблице);
	
	ИначеЕсли Результат.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ПолеИндикатора Тогда	
		
		СоздатьФреймИндикатора(тОбластьВТаблице);
		
	ИначеЕсли Результат.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияКартинка Тогда	
		
	ИначеЕсли Результат.ТипОбъекта = Перечисления.ВидыЭлементовАналитическойПанели.ДекорацияНадпись Тогда	
		
	Иначе //Все разновидности диаграмм	
		                                                                                
				
		СоздатьФреймДиаграммы(тОбластьВТаблице);
				
	КонецЕсли;	
	
	РазметкаПанели.Загрузить(тРазметкаПанели);
	
КонецПроцедуры

