&НаКлиенте
Процедура ТаблицаКМУстановитьОтборПоЗначениям(Элемент) Экспорт
	
	//Определим тип элемента
	тЭлемент = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ЭтаФорма.ТекущийЭлемент.Имя));
	Если тЭлемент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	
	тОбласть =  Элементы[ЭтаФорма.ТекущийЭлемент.Имя].ТекущаяОбласть;
	Если НЕ ТипЗнч(тОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда 
		Возврат;
	КонецЕСли;

	
	МассивРасшифровок = Новый Массив;
	
	Для ИндСтроки = тОбласть.Верх По тОбласть.Низ Цикл 
		Для ИндКолонки =  тОбласть.Лево По  тОбласть.Право Цикл
			тЯчейка = ЭтаФорма[тЭлемент[0].ИмяРеквизитаФормы].Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки);
			
			Если ТипЗнч(тЯчейка.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
				МассивРасшифровок.Добавить(тЯчейка.Расшифровка);
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	Если МассивРасшифровок.Количество()>0 Тогда
		
		СброситьОтборПоЗначениям(ЭтаФорма.ТекущийЭлемент.Имя); 
		
		ПолучитьЗначенияРасшировкиДляОтборов(МассивРасшифровок,тЭлемент[0].АдресДанныхРасшифровки,тЭлемент[0].ИмяЭлемента);	
		
		СформироватьОтчет(Неопределено);
		
	КонецЕсли;
		
КонецПроцедуры

