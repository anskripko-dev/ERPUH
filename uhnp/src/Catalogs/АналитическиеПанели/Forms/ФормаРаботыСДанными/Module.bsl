Процедура ЗаписатьНастройкиПанели()
		
		
КонецПроцедуры	



&НаСервере
Процедура ИнициализироватьСКДИсточника()
	
	СхемаКомпоновкиДанныхИсточника  = ШаблонПанели.ИсточникДанных.СхемаКомпоновкиДанныхпоУмолчанию.Получить();
	
	//Из сохраненной КД текущей панели нам нужны Поля итогов и Вычисляемые поля
	Если ЗначениеЗаполнено(ШаблонПанели.СхемаКомпоновкиДанных) Тогда
		СхемаКомпоновкиДанныхПанели      = ЗначениеИзСтрокиВнутр(ШаблонПанели.СхемаКомпоновкиДанных);
    Иначе
		СхемаКомпоновкиДанныхПанели	      = Неопределено;
	КонецЕсли;	

	//Перенесем вычисляемые поля и итоги 
	  Если НЕ  СхемаКомпоновкиДанныхПанели = Неопределено Тогда
				
		СхемаКомпоновкиДанныхИсточника.ПоляИтога.Очистить();
		
		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ПоляИтога Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.ПоляИтога.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			Для Каждого ИтогГруппировка Из тПоле.Группировки Цикл
				нПоле.Группировки.Добавить(ИтогГруппировка);
			КонецЦикла;	

			
		КонецЦикла;	
		
		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ВычисляемыеПоля Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.ВычисляемыеПоля.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			
		КонецЦикла;	

		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.Параметры Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.Параметры.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			
		КонецЦикла;
		
	КонецЕсли;	

	
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхИсточника,ЭтаФорма.УникальныйИдентификатор);	
		
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	Исключение
		
		СообщениеПользователю = Новый СообщениеПользователю;
		
		СтрокаШаблона = Нстр("ru = 'При инициализации настроек источника данных возникла ошибка:
		|%1'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда			
			СообщениеПользователю.Текст = СтрШаблон(СтрокаШаблона, ОписаниеОшибки());
		КонецЕсли;
		
		СообщениеПользователю.Сообщить();		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
	КонецПопытки;

	//скроем ненужные быстрые отборы.
	Справочники.АналитическиеПанели.ПолучитьОбзятаельныеОтборы(ЭтаФорма,СхемаКомпоновкиДанныхИсточника);
		
	//Получим данные по из пакета
	ПолучитьТаблицуДанныхПакета();
	
КонецПроцедуры	




&НаСервере
Процедура ПолучитьТаблицуДанныхПакета()
	
	ПакетДанных	        = ШаблонПанели.ИсточникДанных;
	
	ОбщийОтбор = Новый Структура;
	ОбщийОтбор.Вставить("Сценарий",Сценарий);
	ОбщийОтбор.Вставить("ПериодОтчета",ПериодОтчета);
	ОбщийОтбор.Вставить("ПериодОкончания",ПериодОкончания);
	ОбщийОтбор.Вставить("Валюта",Валюта);
	ОбщийОтбор.Вставить("Организация",Справочники.Организации.ПустаяСсылка());

	
	//Добавить общий отбор по организации
	Для Каждого СтрОтбор Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если СтрОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация")
			И СтрОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
			И ТипЗнч(СтрОтбор.ПравоеЗначение) =  Тип("СправочникСсылка.Организации") 
			И СтрОтбор.Использование Тогда		
			ОбщийОтбор.Вставить("Организация",СтрОтбор.ПравоеЗначение);
       КонецЕсли;
		
	КонецЦикла;	
	
	ИсточникОбъект = ШаблонПанели.ИсточникДанных.ПолучитьОбъект();
	
	СоответствиеИспользуемыхИБ = Новый Соответствие;
	
	КлючевыеРеквизитыЗаполнены = Истина;
	Если ИспользуетсяПериод 
		И Не ЗначениеЗаполнено(ПериодОтчета) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен период начала'"));
		КлючевыеРеквизитыЗаполнены = Ложь;
	КонецЕсли;
	
	Если ИспользуетсяПериод И 
		Не ЗначениеЗаполнено(ПериодОкончания) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен период окончания'"));
        КлючевыеРеквизитыЗаполнены = Ложь;
	КонецЕсли;

	Если ИспользуетсяВалюта И 
		Не ЗначениеЗаполнено(Валюта) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнена валюта отображения'"));
		КлючевыеРеквизитыЗаполнены = Ложь;
	КонецЕсли;

	Если ИспользуетсяСценарий И 
		Не ЗначениеЗаполнено(Сценарий) Тогда
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Не заполнен Сценарий'"));
		КлючевыеРеквизитыЗаполнены = Ложь;
	КонецЕсли;
	
	Если НЕ КлючевыеРеквизитыЗаполнены Тогда
		ТаблицаДанных        = Справочники.АналитическиеПанели.ПолучитьОписаниеПустойТаблицыДанных(URLСхемы);		
	Иначе	
		ТаблицаДанных        	= Справочники.АналитическиеПанели.ПолучитьТаблицуПоНаборуДанных(ОбщийОтбор,ИсточникОбъект,ИспользуемыеИБ);		
		ИзмененКлючевойРеквизит = Ложь;
	КонецЕсли;
	
	URLСхемыНастроек = URLСхемы;
	АдресТаблицыДанных   = ПоместитьВоВременноеХранилище(ТаблицаДанных,ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьНастройкиДемоТаблицы(СКД,тРесурсы,тИзмерения,НастройкиИсточника = Неопределено)
	
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	нТаблица = НастройкиПоУмолчанию.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
	нСтрока  = нТаблица.Строки.Добавить("ГруппировкаКомпоновкиДанных");
	нКолонка = нТаблица.Колонки.Добавить("ГруппировкаКомпоновкиДанных");
	
	ВсегоИзмерений = тИзмерения.Количество();
	ИндексИзмерения = 1;
	
	тИзмеренияСтрок 	= Новый Структура;
	тИзмеренияКолонок   = Новый Структура;
	
	Для Инд = 1 По ВсегоИзмерений Цикл
		
		Если Не Инд = ВсегоИзмерений Тогда
			
		Иначе	
			
		КонецЕсли;
		
	КонецЦикла;	
		
		
	Для Каждого СтрРесурс Из тРесурсы Цикл
		
		ВыбранноеПолеКомпоновкиДанных 				= НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.Ключ);
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
		
		ВыбранноеПолеГрКомпоновкиДанных 				= нКолонка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеГрКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.Ключ);
		ВыбранноеПолеГрКомпоновкиДанных.Использование = Истина;
				
	КонецЦикла;	
 
	Для Каждого СтрРесурс Из тИзмерения Цикл
		
		нПолеГруппировки 			= нСтрока.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		нПолеГруппировки.Поле		= Новый ПолеКомпоновкиДанных(СтрРесурс.Ключ);	
		
		ВыбранноеПолеКомпоновкиДанных 				= НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.Ключ);
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
		
		ВыбранноеПолеГрКомпоновкиДанных 				= нСтрока.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеГрКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.Ключ);
		ВыбранноеПолеГрКомпоновкиДанных.Использование = Истина;
				
	КонецЦикла;	
	

КонецПроцедуры	

&НаКлиенте
Процедура ДекорацияЭлементПанелиНажатие(Элемент)
	
	ОповещениеКонтекстноеМеню = Новый ОписаниеОповещения("ВыборДействияИзКонтекстногоМенюБланк", ЭтаФорма);

	СписокКоманд = Новый СписокЗначений;
	
		СписокКоманд.Добавить("СкопироватьДанныеПоКолонке",Нстр("ru = 'Добавить элемент'"),,БиблиотекаКартинок.СводнаяТаблицаСкопироватьПоКолонке);
		СписокКоманд.Добавить("ОчиститьДиапазон",Нстр("ru = 'Изменить свойства области'"),,БиблиотекаКартинок.СводнаяТаблицаОчиститьДиапазон);
		СписокКоманд.Добавить("КомментироватьПоказатель",Нстр("ru = 'Удалить элемент'"),,БиблиотекаКартинок.СводнаяТаблицаДобавитьПримечание);		
	
	ЭтаФорма.ПоказатьВыборИзМеню(ОповещениеКонтекстноеМеню,СписокКоманд,Элемент);
	
КонецПроцедуры   


&НаКлиенте
Процедура ПоказатьТекущийЭлемент_Подключаемый()
	
	ЗаголовокТекущегоЭлемента = "";
	
	тЭлемент = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	Если тЭлемент.Количество() = 1 Тогда
		 ЗаголовокТекущегоЭлемента = тЭлемент[0].ЗаголовокЭлемента+" ("+тЭлемент[0].ТипОбъекта+")";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ВернутьСвойстваТекущегоЭлемента(ИмяЭлемента)
	
	ИмяТекущегоЭлемента     = СтрЗаменить(ИмяЭлемента,"Заголовок_","");
	ИмяТекущегоЭлемента     = СтрЗаменить(ИмяТекущегоЭлемента,"ЗначениеИндикатора_","");
	
	СтрокаЭлемента = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ИмяТекущегоЭлемента));
	
	Возврат СтрокаЭлемента;
	
КонецФункции	

&НаКлиенте
Процедура РедактироватьСхемуДанных(Команда)
				
	ОткрытьФормуНастройкиСтруктуры();
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСтруктуры()
	
	ПараметрыФормы = ПодготовитьПараметрыДляВызоваФормыРедактирования(Ложь);
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаНастройкиСКД", ПараметрыФормы,  ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыДляВызоваФормыРедактирования(РасширеннаяНастройка)
	
	Возврат Новый Структура("URLСхемы, КомпоновщикНастроек, НаименованиеОтчета, Источник"
							, URLСхемы
							, КомпоновщикНастроек
							, ШаблонПанели.Наименование
							, ШаблонПанели.ИсточникДанных);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьОписаниеОшибки(Команда) Экспорт
		
	СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя);
	
	тЭлементИмя = Элементы[ЭтаФорма.ТекущийЭлемент.Имя].Родитель.Имя;
	тЭлемент    = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",тЭлементИмя))[0];
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстОписанияОшибки",тЭлемент.ИнформацияОбОшибке);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаОписанияОшибки",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


#Область РаботаСДиалогомВыбораПериода

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	ОтборДатаНачалаПериода 		= ПериодОтчета;
	ОтборДатаОкончанияПериода   = ПериодОкончания;
	
	ЗаполнитьПериоды(ОтборДатаНачалаПериода,ОтборДатаОкончанияПериода);	
	
	ИзмененКлючевойРеквизит = Истина;
	УстановитьСостояниеНеИспользовать(НСтр("ru = 'Отчет не актуален. Нажмите ""Сформировать (F5)"" для обновления данных.'"));
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	ПолучитьДатыПериодов(Диалог.Период.ДатаНачала,Диалог.Период.ДатаОкончания);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
		
	Если  ЗначениеЗаполнено(РезультатВыбора) Тогда	
		ЗаполнитьПериоды(РезультатВыбора.ДатаНачала,РезультатВыбора.ДатаОкончания);	
		ИзмененКлючевойРеквизит = Истина;
		УстановитьСостояниеНеИспользовать(НСтр("ru = 'Отчет не актуален. Нажмите ""Сформировать (F5)"" для обновления данных.'"));
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура ПолучитьДатыПериодов(ДатаНачала,ДатаОкончания)
	
	 ДатаНачала 		= ?(ЗначениеЗаполнено(ПериодОтчета),ПериодОтчета.ДатаНачала,ТекущаяДата());
	 ДатаОкончания 		= ?(ЗначениеЗаполнено(ПериодОкончания),ПериодОкончания.ДатаОкончания,ТекущаяДата());
	 
КонецПроцедуры	
 
&НаСервере
Процедура ЗаполнитьПериоды(ОтборДатаНачалаПериода,ОтборДатаОкончанияПериода)
	
	ПериодОтчета 	= Справочники.Периоды.ПустаяСсылка();
	ПериодОкончания 	= Справочники.Периоды.ПустаяСсылка();
	
	УстановитьПараметрыВыбораПериодов();
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Периоды.Ссылка Как ПериодПланированияОтборНачало,
	|   NULL КАК ПериодПланированияОтборОкончание
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.ДатаНачала = &ДатаНачала
	|	И Периоды.Периодичность = &Периодичность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|   NULL,
	|	Периоды.Ссылка
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Периодичность = &Периодичность
	|	И Периоды.ДатаНачала = &ДатаОкончания";
	
	
	Если ТипЗнч(ОтборДатаНачалаПериода) = Тип("СправочникСсылка.Периоды") Тогда
		 ОтборДатаНачалаПериода = ОтборДатаНачалаПериода.ДатаНачала;
	КонецЕсли;
	
	Если ТипЗнч(ОтборДатаОкончанияПериода) = Тип("СправочникСсылка.Периоды") Тогда
		 ОтборДатаОкончанияПериода = ОтборДатаОкончанияПериода.ДатаНачала;
	КонецЕсли;
	
	Если Периодичность = Перечисления.Периодичность.Месяц Тогда
		Запрос.УстановитьПараметр("ДатаНачала",НачалоМесяца(ОтборДатаНачалаПериода));
		Запрос.УстановитьПараметр("ДатаОкончания",НачалоМесяца(ОтборДатаОкончанияПериода));
	ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда
		Запрос.УстановитьПараметр("ДатаНачала",НачалоКвартала(ОтборДатаНачалаПериода));
		Запрос.УстановитьПараметр("ДатаОкончания",НачалоКвартала(ОтборДатаОкончанияПериода));	
	ИначеЕсли  Периодичность = Перечисления.Периодичность.Год Тогда
		Запрос.УстановитьПараметр("ДатаНачала",НачалоГода(ОтборДатаНачалаПериода));
		Запрос.УстановитьПараметр("ДатаОкончания",НачалоГода(ОтборДатаОкончанияПериода));		
	ИначеЕсли  Периодичность = Перечисления.Периодичность.Неделя Тогда
		Запрос.УстановитьПараметр("ДатаНачала",НачалоНедели(ОтборДатаНачалаПериода));
		Запрос.УстановитьПараметр("ДатаОкончания",НачалоНедели(ОтборДатаОкончанияПериода));		
	Иначе 
		Запрос.УстановитьПараметр("ДатаНачала",ОтборДатаНачалаПериода);
		Запрос.УстановитьПараметр("ДатаОкончания",ОтборДатаОкончанияПериода);		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Периодичность",Периодичность);
    
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ПериодПланированияОтборНачало) Тогда
			 ПериодОтчета =  Выборка.ПериодПланированияОтборНачало
		КонецЕсли;
	    Если ЗначениеЗаполнено(Выборка.ПериодПланированияОтборОкончание) Тогда
			 ПериодОкончания =  Выборка.ПериодПланированияОтборОкончание
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры	 

&НаСервере
Процедура УстановитьПараметрыВыбораПериодов()
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Периодичность", Периодичность);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.ПериодПланированияОтборНачало.ПараметрыВыбора 	= НовыеПараметры;	
	Элементы.ПериодПланированияОтборОкончание.ПараметрыВыбора = НовыеПараметры;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПолучитьДанные(Команда)
	
   ПолучитьТаблицуДанныхПакета();
   
   СформироватьОтчет(Команда);
   
КонецПроцедуры

#КонецОбласти

   

#Область РаботаСВариантамиОтчетов

&НаКлиенте
Процедура СохранитьВариант(Команда)
	
	СохранитьВариантСервер();	
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантКак(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ДобавлениеВариантаНастройкиЗавершение", ЭтаФорма);
	
	НастройкиВарианта  = Новый Структура;
	НастройкиВарианта.Вставить("Периодичность",Периодичность);
	НастройкиВарианта.Вставить("ПериодОтчета",ПериодОтчета);
	НастройкиВарианта.Вставить("ПериодОкончания",ПериодОкончания);
	НастройкиВарианта.Вставить("Валюта",Валюта);
	НастройкиВарианта.Вставить("Сценарий",Сценарий);
	НастройкиВарианта.Вставить("КомпоновщикНастроек",КомпоновщикНастроек);
	
	ПараметрыФормы = Новый Структура("ШаблонПанели,НастройкиВарианта"
	,ШаблонПанели
	,НастройкиВарианта);
	
	ОткрытьФорму("Справочник.ВариантыАналитическихПанелей.Форма.ФормаЭлемента",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеВариантаНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущийВариантПанели = Результат;
	ОбновитьСписокДоступныхЧерезМенюВариантов();
    ИзмененыНастройкиСКД 	= Ложь;
	ЭтаФорма.Заголовок 		= ТекущийВариантПанели;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВариант(Команда)
	  
  ИндексКоманды = Число(Прав(Команда.Имя,1));
  
  ОписаниеКоманды = ВариантыПанелиДляБыстрогоДоступа.НайтиСтроки(Новый Структура("ИндексКоманды",ИндексКоманды));
  
  Если ОписаниеКоманды.Количество() = 1  Тогда
	   ЗагрузитьНастройкиВарианта(ОписаниеКоманды[0].ВариантПанели);
	   УстановитьСостояниеНеИспользовать(НСтр("ru = 'Изменился вариант панели. Нажмите ""Сформировать (F5)"" для обновления данных.'"));	  	
  КонецЕсли;	  
   
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВариант(Команда)
	
	ПараметрыФормы = Новый Структура("ШаблонПанели,НастройкиВарианта"
	,ШаблонПанели
	,ТекущийВариантПанели);
	
	Оповещение = Новый ОписаниеОповещения("ВыборВариантаНастройкиЗавершение", ЭтаФорма);	
	ОткрытьФорму("Справочник.ВариантыАналитическихПанелей.Форма.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборВариантаНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	ЗагрузитьНастройкиВарианта(Результат);
	
	ТекущийВариантПанели = Результат;
	ИзмененыНастройкиСКД = Ложь;

	
КонецПроцедуры


&НаСервере
Процедура ОбновитьСписокДоступныхЧерезМенюВариантов()
	
	Для Каждого СтрЭлемент Из Элементы.ГруппаВариантыОтчетаЕще.ПодчиненныеЭлементы Цикл
		СтрЭлемент.Видимость  = Ложь;
		СтрЭлемент.Пометка    = Ложь;
	КонецЦикла;	
		
	ВариантыПанелиДляБыстрогоДоступа.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 9
	               |	ВариантыАналитическихПанелей.Ссылка КАК Ссылка,
	               |	ВариантыАналитическихПанелей.ЭтоОсновнойВариант КАК ЭтоОсновнойВариант
	               |ИЗ
	               |	Справочник.ВариантыАналитическихПанелей КАК ВариантыАналитическихПанелей
	               |ГДЕ
	               |	(ВариантыАналитическихПанелей.Автор = &Автор
	               |			ИЛИ ВариантыАналитическихПанелей.ЭтоОсновнойВариант)
	               |	И ВариантыАналитическихПанелей.ПометкаУдаления = ЛОЖЬ
	               |	И ВариантыАналитическихПанелей.ШаблонПанели = &ШаблонПанели
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоОсновнойВариант УБЫВ,
	               |	ВариантыАналитическихПанелей.Наименование";
	
	Запрос.УстановитьПараметр("Автор",ОбщегоНазначенияУХ.ТекущийПользователь() );
	Запрос.УстановитьПараметр("ШаблонПанели",ШаблонПанели);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИндексОтчета = 1;
	Пока Выборка.Следующий() Цикл
	
		 нВариант 						= ВариантыПанелиДляБыстрогоДоступа.Добавить();
		 нВариант.ВариантПанели 		= Выборка.Ссылка;
		 нВариант.ЭтоОсновнойВариант  	= Выборка.ЭтоОсновнойВариант;
		 нВариант.ТекущийВариант      	= Выборка.Ссылка = ТекущийВариантПанели;
		 нВариант.ИндексКоманды         = ИндексОтчета;
		 
		 Элементы["ЗагрузитьВариант"+ИндексОтчета].Видимость = Истина;
		 Элементы["ЗагрузитьВариант"+ИндексОтчета].Заголовок = Строка(Выборка.Ссылка);
		 Элементы["ЗагрузитьВариант"+ИндексОтчета].Пометка   = нВариант.ТекущийВариант;
		 
		 Если нВариант.ЭтоОсновнойВариант  Тогда
			 Элементы["ЗагрузитьВариант"+ИндексОтчета].Картинка = БиблиотекаКартинок.ЗакрытьПроцесс;
		 Иначе	 
			 Элементы["ЗагрузитьВариант"+ИндексОтчета].Картинка = Новый Картинка(); 
		 КонецЕсли;	 
		 
		 ИндексОтчета = ИндексОтчета+1;
		 
	КонецЦикла;
	

КонецПроцедуры	

&НаСервере
Процедура СохранитьВариантСервер()
	
	Если Не ЗначениеЗаполнено(ТекущийВариантПанели) 
		ИЛИ ТекущийВариантПанели.ЭтоОсновнойВариант Тогда
		Возврат;
	КонецЕсли;	
	
	ВариантОбъект 					= ТекущийВариантПанели.ПолучитьОбъект();
		
	ВариантОбъект.Периодичность            = Периодичность;
	ВариантОбъект.ПериодОтчета             = ПериодОтчета;
	ВариантОбъект.ПериодОкончания          = ПериодОкончания;
	ВариантОбъект.Валюта          		   = Валюта;
	ВариантОбъект.Сценарий                 = Сценарий;
	
	ВариантОбъект.НастройкиСКД       = ЗначениеВСтрокуВнутр(КомпоновщикНастроек.Настройки);
	
	ВариантОбъект.Записать();
	
	ИзмененыНастройкиСКД = Ложь;
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиПоследнегоВарианта() 

     ПоследнийВариант = РегистрыСведений.НастройкиПользователейАналитическихПанелей.СоздатьНаборЗаписей();
     ПоследнийВариант.Отбор.Пользователь.Установить(ОбщегоНазначенияУХ.ТекущийПользователь());
	 ПоследнийВариант.Отбор.ШаблонПанели.Установить(ШаблонПанели);
	 
	 ПоследнийВариант.Прочитать();
	 
	 Если ПоследнийВариант.Количество() = 0 Тогда		 
		 //Отсутствует последний сохраненный вариант - загружаем настройки основного варианта
		 ТекущийВариант = Неопределено;
	 Иначе	  		 
		 ТекущийВариант = ПоследнийВариант[0].ВариантПанели;	 
	 КонецЕсли;	 
	 
	 ЗагрузитьНастройкиВарианта(ТекущийВариант);
	 
КонецПроцедуры	

&НаСервере
Процедура  ЗагрузитьНастройкиВарианта(Вариант = Неопределено) 
	
	Если Вариант = Неопределено Тогда
		ЗагрузитьНастройкиОсновногоВарианта();		
	Иначе			
		Если НЕ Вариант = ТекущийВариантПанели Тогда
			ПрочитатьНастройкиВарианта(Вариант)		
		КонецЕсли;	
	КонецЕсли;
	
	УправлениеФормой();
	ЭтаФорма.Модифицированность = Истина;

	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиВарианта(Вариант)
	
	Периодичность 		= Вариант.Периодичность;
	ПериодОтчета  		= Вариант.ПериодОтчета;
	ПериодОкончания  	= Вариант.ПериодОкончания;
	Валюта              = Вариант.Валюта;
	Сценарий            = Вариант.Сценарий;
	
	Если НЕ Вариант.НастройкиСКД = "" Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(Вариант.НастройкиСКД));
	КонецЕсли;
	
	ТекущийВариантПанели = Вариант;
	ЭтаФорма.Заголовок   = Строка(Вариант)+НСтр("ru = ' (Аналитические панели)'");
	
	
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьНастройкиОсновногоВарианта() 
	
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ВариантыАналитическихПанелей.Ссылка КАК Ссылка,
	                |	ВариантыАналитическихПанелей.ВерсияДанных КАК ВерсияДанных,
	                |	ВариантыАналитическихПанелей.ПометкаУдаления КАК ПометкаУдаления,
	                |	ВариантыАналитическихПанелей.Код КАК Код,
	                |	ВариантыАналитическихПанелей.Наименование КАК Наименование,
	                |	ВариантыАналитическихПанелей.ШаблонПанели КАК ШаблонПанели,
	                |	ВариантыАналитическихПанелей.Автор КАК Автор,
	                |	ВариантыАналитическихПанелей.ЭтоОсновнойВариант КАК ЭтоОсновнойВариант,
	                |	ВариантыАналитическихПанелей.НастройкиСКД КАК НастройкиСКД,
	                |	ВариантыАналитическихПанелей.Периодичность КАК Периодичность,
	                |	ВариантыАналитическихПанелей.ПериодОтчета КАК ПериодОтчета,
	                |	ВариантыАналитическихПанелей.ПериодОкончания КАК ПериодОкончания,
	                |	ВариантыАналитическихПанелей.Валюта КАК Валюта,
	                |	ВариантыАналитическихПанелей.Сценарий КАК Сценарий,
	                |	ВариантыАналитическихПанелей.Комментарий КАК Комментарий,
	                |	ВариантыАналитическихПанелей.Предопределенный КАК Предопределенный,
	                |	ВариантыАналитическихПанелей.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	                |	ВариантыАналитическихПанелей.Представление КАК Представление
	                |ИЗ
	                |	Справочник.ВариантыАналитическихПанелей КАК ВариантыАналитическихПанелей
	                |ГДЕ
	                |	
	                |	ВариантыАналитическихПанелей.ЭтоОсновнойВариант = Истина
	                |	И ВариантыАналитическихПанелей.ШаблонПанели = &ШаблонПанели";
	 
	 Запрос.УстановитьПараметр("ШаблонПанели",ШаблонПанели);
	 
	 РезультатЗапроса = Запрос.Выполнить();
	 Выборка = РезультатЗапроса.Выбрать();
	 
	 Если Выборка.Следующий() Тогда
		 //Есть основной вариант
		 ПрочитатьНастройкиВарианта(Выборка.Ссылка);
		 
	 Иначе	
	     //Создаем новый основной вариант
		 нВариантОтчета  					= Справочники.ВариантыАналитическихПанелей.СоздатьЭлемент();
		 нВариантОтчета.Наименование 		= Строка(ШаблонПанели);
		 нВариантОтчета.ЭтоОсновнойВариант  = Истина;
		 нВариантОтчета.ШаблонПанели   = ШаблонПанели;
		 нВариантОтчета.Записать();
		 ПрочитатьНастройкиВарианта(нВариантОтчета.Ссылка);
		 
	 КонецЕсли;
	 	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	ОбновитьСписокДоступныхЧерезМенюВариантов();
	
	Элементы.ВариантыПанели.Видимость = Не ЭтоРасшифровка;
	
	Если ЗначениеЗаполнено(ТекущийВариантПанели)
		И НЕ ТекущийВариантПанели.ЭтоОсновнойВариант Тогда
		Элементы.СохранитьВариант.Доступность = Истина;
	Иначе	
		Элементы.СохранитьВариант.Доступность = Ложь;
	КонецЕсли;	
	
	Элементы.ГруппаОтборыПериода.Видимость 	= ИспользуетсяПериод;
	Элементы.ВалютаОтображения.Видимость 	= ИспользуетсяВалюта;
    Элементы.Сценарий.Видимость 			= ИспользуетсяСценарий;

	
КонецПроцедуры	

&НаСервере
Процедура УстановитьСостояниеНеИспользовать(ТекстСообщения)
	
	Элементы.ГруппаСтраницыПанели.Доступность  = Ложь;
	Элементы.ДекорацияОбновить.Заголовок = ТекстСообщения;
	Элементы.ГруппаСтатусОбновить.Видимость = Истина;	
		
КонецПроцедуры	

&НаСервере
Процедура СброситьСостояниеНеИспользовать()
	
	Элементы.ГруппаСтраницыПанели.Доступность  	= Истина;
	Элементы.ГруппаСтатусОбновить.Видимость 	= Ложь;	
		
КонецПроцедуры	

&НаКлиенте
Процедура ВалютаОтображенияПриИзменении(Элемент)
	
  	УстановитьСостояниеНеИспользовать(НСтр("ru = 'Отчет не актуален. Нажмите ""Сформировать (F5)"" для обновления данных.'"));
	ИзмененКлючевойРеквизит = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
  	УстановитьСостояниеНеИспользовать(НСтр("ru = 'Отчет не актуален. Нажмите ""Сформировать (F5)"" для обновления данных.'"));
	ИзмененКлючевойРеквизит = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
   Если ИзмененКлючевойРеквизит  Тогда
	    ПолучитьТаблицуДанныхПакета();
   КонецЕсли;	
   
   УстановленГлобальныйФильтр = Ложь;
   Для Каждого СтрЭл Из КомпоновщикНастроек.Настройки.Отбор.Элементы цикл
	   Если СтрЭл.Использование Тогда
		   УстановленГлобальныйФильтр = Истина;
		   Прервать;  
	   КонецЕсли;	   
   КонецЦикла;	   
   
   Если УстановленГлобальныйФильтр Тогда
	  Элементы.ДополнительныеНастройки.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрАктивен; 
   Иначе   
	  Элементы.ДополнительныеНастройки.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрНеАктивен; 		   
   КонецЕсли;	    
   
   ОбновитьЭлементыПанели();
    
   СброситьСостояниеНеИспользовать();
   Модифицированность = Ложь;
    
КонецПроцедуры


Процедура ОбновитьЭлементыПанели()

	Если РазметкаПанели.Количество() > 0 Тогда
		Справочники.АналитическиеПанели.ОбновитьПанельПоРазметке(ЭтаФорма);
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеНастройки(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьДополнительныеОтборыЗавершение", ЭтаФорма);
	
	ПараметрыФормы  = Новый Структура;
	ПараметрыФормы.Вставить("URLСхемы",URLСхемы);
	ПараметрыФормы.Вставить("НастройкиКомпоновщика",		КомпоновщикНастроек.Настройки);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаОтборовПанели",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДополнительныеОтборыЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
    КомпоновщикНастроек.ЗагрузитьНастройки(Результат.НастройкиОтчета);
	
	СформироватьОтчет(Неопределено);
	
КонецПроцедуры

#КонецОбласти


#Область РасшифровкаНажатияНаЭлементамыПанели

&НаКлиенте
Процедура ДиаграммаКМРасшифроватьЗначение(Команда) Экспорт
			
	Перем ВыполненноеДействие;
	Перем Настройки;
	
	//Определим тип элемента
	тЭлемент = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ЭтаФорма.ТекущийЭлемент.Имя));
	Если тЭлемент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	АдресДанныхРасшифровки  = тЭлемент[0].АдресДанныхРасшифровки;
	
	ИмяОбъектаДиаграммы = тЭлемент[0].ИмяРеквизитаФормы;	
		
	тВыделенныеЭлементы =  Элементы[ЭтаФорма.ТекущийЭлемент.Имя].ПолучитьВыделенныеЭлементы();
	
	Если тВыделенныеЭлементы.Количество()>0 Тогда
				
		Расшифровка =  тВыделенныеЭлементы[0].Расшифровка;
		
		// Создадим и инициализируем обработчик расшифровки
		СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя)[0];
		
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(СвойстваТекущегоЭлемента.АдресДанныхРасшифровки, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
		
		
		ДопПараметры = Новый Структура("ВыполненноеДействие, Настройки, Расшифровка", ВыполненноеДействие,Настройки, Расшифровка);
		Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьВыборДействия", ЭтотОбъект, ДопПараметры);
		
		ДоступныеДействия = Новый Массив();
		ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
				
		ОбработкаРасшифровки.ПоказатьВыборДействия(Оповещение, Расшифровка,ДоступныеДействия,,Истина, ЭтаФорма.ТекущийЭлемент);
					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаКМОткрытьЗначение(Команда) Экспорт
			
	Перем ВыполненноеДействие;
	Перем Настройки;
	
	//Определим тип элемента
	тЭлемент = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ЭтаФорма.ТекущийЭлемент.Имя));
	Если тЭлемент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяОбъектаДиаграммы = тЭлемент[0].ИмяРеквизитаФормы;	
		
	тВыделенныеЭлементы =  Элементы[ЭтаФорма.ТекущийЭлемент.Имя].ПолучитьВыделенныеЭлементы();
	
	Если тВыделенныеЭлементы.Количество()>0 Тогда
				
		Расшифровка =  тВыделенныеЭлементы[0].Расшифровка;
		
		// Создадим и инициализируем обработчик расшифровки
		СвойстваТекущегоЭлемента = ВернутьСвойстваТекущегоЭлемента(ЭтаФорма.ТекущийЭлемент.Имя)[0];
		
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(СвойстваТекущегоЭлемента.АдресДанныхРасшифровки, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
		
		
		ДопПараметры = Новый Структура("ВыполненноеДействие, Настройки, Расшифровка", ВыполненноеДействие,Настройки, Расшифровка);
		Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработатьВыборДействия", ЭтотОбъект, ДопПараметры);
		
		ДоступныеДействия = Новый Массив();
		ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
				
		ОбработкаРасшифровки.ПоказатьВыборДействия(Оповещение, Расшифровка,ДоступныеДействия,,Истина, ЭтаФорма.ТекущийЭлемент);
					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
		
	СтандартнаяОбработка = Ложь;
	
	ДиаграммаКМРасшифроватьЗначение(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаКМУстановитьОтборПоЗначениям(Элемент) Экспорт
	
	//Определим тип элемента
	тЭлемент = РазметкаПанели.НайтиСтроки(Новый Структура("ИмяЭлемента",ЭтаФорма.ТекущийЭлемент.Имя));
	Если тЭлемент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяОбъектаДиаграммы = тЭлемент[0].ИмяРеквизитаФормы;	
		
	тВыделенныеЭлементы =  Элементы[ЭтаФорма.ТекущийЭлемент.Имя].ПолучитьВыделенныеЭлементы();
	
	МассивРасшифровок = Новый Массив;
	Для Каждого ЭлементРасшифровки Из тВыделенныеЭлементы Цикл
		МассивРасшифровок.Добавить(ЭлементРасшифровки.Расшифровка);
	КонецЦикла;
		
	Если МассивРасшифровок.Количество()>0 Тогда
		
		СброситьОтборПоЗначениям(ЭтаФорма.ТекущийЭлемент.Имя); 
		
		ПолучитьЗначенияРасшировкиДляОтборов(МассивРасшифровок,тЭлемент[0].АдресДанныхРасшифровки,тЭлемент[0].ИмяЭлемента);	
		
		СформироватьОтчет(Неопределено);
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ПолучитьЗначенияРасшировкиДляОтборов(МассивРасшифровок,АдресДанныхРасшифровки,ИмяЭлемента)
	
	ДанныеРасшифровки 	= ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
	СхемаКД 			= ПолучитьИзВременногоХранилища(URLСхемы);
	СтруктураПолейОтбора      = Новый Структура;
	
	Для Каждого ПолеКД Из СхемаКД.НаборыДанных.НаборДанных1.Поля Цикл
		 СтруктураПолейОтбора.Вставить(ПолеКД.ПутьКДанным,Новый СписокЗначений);
	КонецЦикла;	
	
	Для Каждого ПолеКД Из СхемаКД.ВычисляемыеПоля Цикл
		 СтруктураПолейОтбора.Вставить(ПолеКД.ПутьКДанным,Новый СписокЗначений);
	КонецЦикла;
	
	Для Каждого ЭлементРасшифровки Из МассивРасшифровок Цикл
		
		СтруктураПолей = Новый Структура;
		Для Каждого ПолеКД Из СхемаКД.НаборыДанных.НаборДанных1.Поля Цикл
			СтруктураПолей.Вставить(ПолеКД.ПутьКДанным);
		КонецЦикла;	
		Для Каждого ПолеКД Из  СхемаКД.ВычисляемыеПоля Цикл
			СтруктураПолей.Вставить(ПолеКД.ПутьКДанным);
		КонецЦикла;
		
		
		СводнаяТаблицаУХ.ПолучитьРасшифровкуГруппировок(ДанныеРасшифровки.Элементы[ЭлементРасшифровки],СтруктураПолей);
		
		Для Каждого ЭлСтруктуры Из СтруктураПолей Цикл
			Если НЕ ЭлСтруктуры.Значение = Неопределено Тогда
				СтруктураПолейОтбора[ЭлСтруктуры.Ключ].Добавить(ЭлСтруктуры.Значение);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
	
	Для Каждого Стр Из СтруктураПолейОтбора Цикл
		
		Если Стр.Значение.Количество()=1 Тогда
			нЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			нЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Стр.Ключ);
			нЭлементОтбора.ИдентификаторПользовательскойНастройки = ИмяЭлемента;
			нЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			нЭлементОтбора.ПравоеЗначение = Стр.Значение[0].Значение;

		ИначеЕсли  Стр.Значение.Количество()>1 Тогда	
			нЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			нЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Стр.Ключ);
			нЭлементОтбора.ИдентификаторПользовательскойНастройки = ИмяЭлемента;
			нЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
