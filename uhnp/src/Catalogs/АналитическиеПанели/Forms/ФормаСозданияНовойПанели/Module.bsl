
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.ОтображатьЗаголовкиСтраниц = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПанель(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено наименование '"),,"Объект.Наименование");		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ИсточникДанных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран источник данных '"),,"Объект.ИсточникДанных");		
		Возврат;
	КонецЕсли;

	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("Наименование", Объект.Наименование);
	ПараметрыВызова.Вставить("ИсточникДанных", Объект.ИсточникДанных);
	
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаНастройкиПанели", ПараметрыВызова);
	
	ЭтаФорма.Закрыть();

КонецПроцедуры


