   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Наименование 			= Параметры.Наименование;
    ИсточникДанных 			= Параметры.ИсточникДанных;
	ИсточникДанныхИсходный 	= Параметры.ИсточникДанных;

	Комментарий 			= Параметры.Комментарий;
    ИсходныйURLСхемы        = Параметры.URLСхемы;
	ЕстьЭлементыСНастройкой = Параметры.ЕстьЭлементыСНастройкой;
	
	ИнициализироватьСКДИсточника();

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСКДИсточника(СброситьНастройкиТекущейПанели = Ложь)
	
	//Получаем актуальную КД из пакета данных
	СхемаКомпоновкиДанныхИсточника  = ИсточникДанных.СхемаКомпоновкиДанныхпоУмолчанию.Получить();
	
	//Из сохраненной КД текущей панели нам нужны Поля итогов и Вычисляемые поля
	Если ЗначениеЗаполнено(ИсходныйURLСхемы) Тогда
		СхемаКомпоновкиДанныхПанели      = ПолучитьИзВременногоХранилища(ИсходныйURLСхемы);
    Иначе
		СхемаКомпоновкиДанныхПанели	      = Неопределено;
	КонецЕсли;	
	
	ПроверитьИзмененияПолей(СхемаКомпоновкиДанныхИсточника,СхемаКомпоновкиДанныхПанели);
		
	Если СброситьНастройкиТекущейПанели
		И НЕ СхемаКомпоновкиДанныхПанели = Неопределено Тогда
		
		//СхемаКомпоновкиДанныхПанели.ВычисляемыеПоля.Очистить();
		СхемаКомпоновкиДанныхПанели.ПоляИтога.Очистить();
		//СхемаКомпоновкиДанныхПанели.Параметры.Очистить();
		
	КонецЕсли;	

	
	Если НЕ СброситьНастройкиТекущейПанели
		//Перенесем вычисляемые поля и итоги 
		И НЕ  СхемаКомпоновкиДанныхПанели = Неопределено Тогда
			
		СхемаКомпоновкиДанныхИсточника.ПоляИтога.Очистить();
		
		Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ПоляИтога Цикл
			
			нПоле = СхемаКомпоновкиДанныхИсточника.ПоляИтога.Добавить();
			заполнитьЗначенияСвойств(нПоле,тПоле);
			Для Каждого ИтогГруппировка Из тПоле.Группировки Цикл
				нПоле.Группировки.Добавить(ИтогГруппировка);
			КонецЦикла;	
			
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.ВычисляемыеПоля Цикл
		
		нПоле = СхемаКомпоновкиДанныхИсточника.ВычисляемыеПоля.Добавить();
		заполнитьЗначенияСвойств(нПоле,тПоле);
		
	КонецЦикла;	
	
	Для Каждого тПоле Из СхемаКомпоновкиДанныхПанели.Параметры Цикл
		
		нПоле = СхемаКомпоновкиДанныхИсточника.Параметры.Добавить();
		заполнитьЗначенияСвойств(нПоле,тПоле);
		
	КонецЦикла;
	
	
	
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхИсточника,ЭтаФорма.УникальныйИдентификатор);	
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	Исключение
		
		СообщениеПользователю = Новый СообщениеПользователю;
		
		СтрокаШаблона = Нстр("ru = 'При инициализации настроек источника данных возникла ошибка:
		|%1'");
		
		Если Не ПустаяСтрока(СтрокаШаблона) тогда			
			СообщениеПользователю.Текст = СтрШаблон(СтрокаШаблона, ОписаниеОшибки());
		КонецЕсли;
		
		СообщениеПользователю.Сообщить();		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
	КонецПопытки;

	
КонецПроцедуры	

Процедура ПроверитьИзмененияПолей(СхемаКомпоновкиДанныхИсточника,СхемаКомпоновкиДанныхПанели); 
	
	Если СхемаКомпоновкиДанныхИсточника = Неопределено 
		ИЛИ СхемаКомпоновкиДанныхПанели = Неопределено Тогда		
		Возврат;	
	КонецЕсли;	
		
	//Есть в пакете, нет в панели
	Для Каждого СтрПоле Из СхемаКомпоновкиДанныхИсточника.НаборыДанных[0].Поля Цикл
		
		НайденноеПоле =  СхемаКомпоновкиДанныхПанели.НаборыДанных[0].Поля.Найти(СтрПоле.Поле); 
		Если НайденноеПоле  = Неопределено Тогда
			
			СтрокаШаблона = Нстр("ru = 'Поле источника %1 добавлено или изменено'");
			СтрокаШаблона = СтрШаблон(СтрокаШаблона,СтрПоле.Поле);
            ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрокаШаблона);
			
		ИначеЕсли НЕ НайденноеПоле.ТипЗначения = СтрПоле.ТипЗначения Тогда
			
			СтрокаШаблона = Нстр("ru = 'У Поля %1 изменился тип значения'");
			СтрокаШаблона = СтрШаблон(СтрокаШаблона,СтрПоле.Поле);
            ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрокаШаблона);
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого СтрПоле Из СхемаКомпоновкиДанныхПанели.НаборыДанных[0].Поля Цикл
		
		НайденноеПоле =  СхемаКомпоновкиДанныхИсточника.НаборыДанных[0].Поля.Найти(СтрПоле.Поле);  

		Если НайденноеПоле = Неопределено Тогда
			
			СтрокаШаблона = Нстр("ru = 'Поле источника %1 удалено или изменено'");
			СтрокаШаблона = СтрШаблон(СтрокаШаблона,СтрПоле.Поле);
            ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрокаШаблона);
				
		КонецЕсли;	
		
	КонецЦикла;	
		
КонецПроцедуры	



&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено наименование '"),,"Наименование");		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсточникДанных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран источник данных '"),,"ИсточникДанных");		
		Возврат;
	КонецЕсли;
	
	Если ЕстьЭлементыСНастройкой 
		И ИсточникДанныхИсходный<>ИсточникДанных Тогда			
		ВопросПрименитьНовыйИсточник();	
	Иначе			
		Закрыть(ПодготовитьПараметры());	
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПрименитьНовыйИсточник()
	
	Оповещение = Новый ОписаниеОповещения("ВопросПрименитьНовыйИсточникЗавершение",ЭтаФорма);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'При изменении источника текущие настройки элементов панели, итогов и вычисляемых полей станут неактуальными, продолжить?'"), РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры


&НаКлиенте
Процедура ВопросПрименитьНовыйИсточникЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда				
		ИнициализироватьСКДИсточника(Истина);
		Закрыть(ПодготовитьПараметры());		
	КонецЕсли;		
			
КонецПроцедуры


Функция ПодготовитьПараметры() 
	
	 Возврат Новый Структура("URLСхемы,Наименование,Комментарий,ИсточникДанных"
	,ЗначениеВстрокуВнутр(ПолучитьИзВременногоХранилища(URLСхемы))
	,Наименование
	,Комментарий
	,ИсточникДанных)
	
КонецФункции	

&НаКлиенте
Процедура РедактироватьСхемуДанных(Команда)
				
	ОткрытьФормуНастройкиСтруктуры();
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСтруктуры()
	
	ПараметрыФормы = ПодготовитьПараметрыДляВызоваФормыРедактирования(Ложь);
	ПараметрыФормы.Вставить("Источник",ИсточникДанных);
	ОткрытьФорму("Справочник.АналитическиеПанели.Форма.ФормаНастройкиСКД", ПараметрыФормы,  ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыДляВызоваФормыРедактирования(РасширеннаяНастройка)
	
	Возврат Новый Структура("URLСхемы, КомпоновщикНастроек, НаименованиеОтчета"
							, URLСхемы
							, КомпоновщикНастроек
							, Наименование);
	
КонецФункции

&НаКлиенте
Процедура ПеречитатьНастройкиИсточника(Команда)
	
	ИнициализироватьСКДИсточника(Истина);
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ИсточникДанныхПриИзменении(Элемент)
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры



