  
#Область ОбработчикиСобытийФормы  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
		
	КомпоновщикНастроекПользовательский.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.URLСхемы));	
	
	URLСхемы = Параметры.URLСхемы;
	
	СхемаКД = ПолучитьИзВременногоХранилища(URLСхемы);	 
	
	Если Параметры.ОтображатьИзмерения Тогда
		Для Каждого ПолеКД Из СхемаКД.НаборыДанных[0].Поля Цикл
			Если  СхемаКД.ПоляИтога.Найти(ПолеКД.ПутьКДанным) = Неопределено Тогда
				нПоле = КомпоновщикНастроекПользовательский.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				нПоле.Поле  = Новый ПолеКомпоновкиДанных(ПолеКД.ПутьКДанным);
			КонецЕсли;			
		КонецЦикла;	
	КонецЕсли;
	
	Если Параметры.ОтображатьРесурсы Тогда
		Для Каждого Рес Из СхемаКД.ПоляИтога Цикл
			нПоле = КомпоновщикНастроекПользовательский.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			нПоле.Поле  = Новый ПолеКомпоновкиДанных(Рес.ПутьКДанным);
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	Закрыть(Элементы.ПоляВыбора.ТекущиеДанные.Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоляВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Выбрать(Неопределено);
	
КонецПроцедуры



#КонецОбласти


