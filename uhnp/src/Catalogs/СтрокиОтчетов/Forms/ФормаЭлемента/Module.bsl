КонецПроцедуры

&НаКлиенте
Процедура РежимУказанияСтатьиПриИзменении(Элемент)
	
	Если РежимУказанияСтатьи = 0 Тогда
		Объект.СтатьяУказываетсяВАналитике = Ложь;
		Объект.ГруппаСтатейДляУстановкиАналитикБДДС = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка");
	Иначе
		Объект.СтатьяУказываетсяВАналитике = Истина;
		Объект.СтатьяДвиженияДенежныхСредств = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка");
	КонецЕсли;

	Объект.ГруппаРаскрытия = ПредопределенноеЗначение("Справочник.ГруппыРаскрытия.ПустаяСсылка");
	Объект.АналитикаСтатьи = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка");
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ВключитьКонтрольСоставаАналитикСтатейНаУровнеГруппыНаСервере()
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ПроцессыИСогласование") Тогда // не БМ, НМ
		КонстантаИмя = "КонтролироватьСоставАналитикСтатейНаУровнеГруппы";
		Константы[КонстантаИмя].Установить(Истина);
		КонтролироватьСоставАналитикСтатейНаУровнеГруппы = Истина;
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьКонтрольСоставаАналитикСтатейНаУровнеГруппы(Команда)
	
	ВключитьКонтрольСоставаАналитикСтатейНаУровнеГруппыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКорректностьВыбраннойГруппыАналитик(Отказ);
	
	ПроверитьСоответствиеАналитикиСтатьиИГруппыРаскрытия(Отказ);
	ПроверитьСоответствиеАналитикГруппыСтатейИГруппыРаскрытия(Отказ);
	ПроверитьСоответствиеЭлементовВыбраннойГруппыМаскеАналитик(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоответствиеАналитикиСтатьиИГруппыРаскрытия(Отказ)
	
	Отказ = Истина;
	Для НомерАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Если Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики] = Объект.АналитикаСтатьи Тогда
			Отказ = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ = Истина Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Аналитика статьи отсутствует в группе раскрытия!'"));
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоответствиеАналитикГруппыСтатейИГруппыРаскрытия(Отказ)
	
	Если Объект.Предназначение = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств Тогда
		РеквизитГруппы = "ГруппаСтатейДляУстановкиАналитикБДДС";
	Иначе
		РеквизитГруппы = "ГруппаСтатейДляУстановкиАналитикБДР";
	КонецЕсли;
	
	Для НомерАналитикиГруппыСтатей = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		СоответствиеНайдено = Ложь;
		Для НомерАналитикиГруппыРаскрытия = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			Если Объект[РеквизитГруппы]["ВидАналитики" + НомерАналитикиГруппыСтатей] = Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитикиГруппыРаскрытия] Тогда
				СоответствиеНайдено = Истина;
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		Если НЕ СоответствиеНайдено Тогда
			ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Группа раскрытия должна содержать все аналитики, определенные на уровне группы статей!'"));
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоответствиеЭлементовВыбраннойГруппыМаскеАналитик(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Статьи.Ссылка КАК Ссылка,
		|	Статьи.ВидАналитики1 КАК ВидАналитики1,
		|	Статьи.ВидАналитики2 КАК ВидАналитики2,
		|	Статьи.ВидАналитики3 КАК ВидАналитики3,
		|	Статьи.ВидАналитики4 КАК ВидАналитики4,
		|	Статьи.ВидАналитики5 КАК ВидАналитики5,
		|	Статьи.ВидАналитики6 КАК ВидАналитики6
		|ПОМЕСТИТЬ ВТ_Группа
		|ИЗ
		|	Справочник.СтатьиДвиженияДенежныхСредств КАК Статьи
		|ГДЕ
		|	Статьи.Ссылка = &ГруппаСтатей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Статьи.Ссылка КАК Ссылка,
		|	Статьи.ВидАналитики1 КАК ВидАналитики1,
		|	Статьи.ВидАналитики2 КАК ВидАналитики2,
		|	Статьи.ВидАналитики3 КАК ВидАналитики3,
		|	Статьи.ВидАналитики4 КАК ВидАналитики4,
		|	Статьи.ВидАналитики5 КАК ВидАналитики5,
		|	Статьи.ВидАналитики6 КАК ВидАналитики6
		|ПОМЕСТИТЬ ВТ_СтатьиГруппы
		|ИЗ
		|	Справочник.СтатьиДвиженияДенежныхСредств КАК Статьи
		|ГДЕ
		|	Статьи.Ссылка В ИЕРАРХИИ(&ГруппаСтатей)
		|	И Статьи.Ссылка <> &ГруппаСтатей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Группа.Ссылка КАК Группа,
		|	ВТ_СтатьиГруппы.Ссылка КАК Статья
		|ИЗ
		|	ВТ_Группа КАК ВТ_Группа
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_СтатьиГруппы КАК ВТ_СтатьиГруппы
		|		ПО (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики1.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики1 = ВТ_СтатьиГруппы.ВидАналитики1
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики2.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики2 = ВТ_СтатьиГруппы.ВидАналитики2
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики3.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики3 = ВТ_СтатьиГруппы.ВидАналитики3
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики4.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики4 = ВТ_СтатьиГруппы.ВидАналитики4
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики5.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики5 = ВТ_СтатьиГруппы.ВидАналитики5
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА НЕ ВТ_Группа.ВидАналитики6.Ссылка ЕСТЬ NULL
		|					ТОГДА ВТ_Группа.ВидАналитики6 = ВТ_СтатьиГруппы.ВидАналитики6
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|ГДЕ
		|	ВТ_Группа.Ссылка ЕСТЬ NULL";
	
	Если Объект.Предназначение = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств Тогда
		Запрос.УстановитьПараметр("ГруппаСтатей",Объект.ГруппаСтатейДляУстановкиАналитикБДДС);
	ИначеЕсли Объект.Предназначение = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.СтатьиДвиженияДенежныхСредств", "Справочник.СтатьиДоходовИРасходов");
		Запрос.УстановитьПараметр("ГруппаСтатей",Объект.ГруппаСтатейДляУстановкиАналитикБДР);
	Иначе
		Возврат;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Данная группа не может быть выбрана, так как не все входящие в нее статьи соответствуют заданной на уровне группы маске аналитик!'"));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьПользователюОНеобходимостиЗаполненияГруппыСтатей(Поле, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Заполните группу статей для определения состава аналитик!'");
	Сообщение.Поле = Поле;
	Сообщение.ПутьКДанным = "Объект";
	Сообщение.Сообщить();
			
	Отказ = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАналитикуСтатьиИзГруппыРаскрытия()

	Аналитика = Неопределено;
	ТипБДДС = "СправочникСсылка.СтатьиДвиженияДенежныхСредств";

	Если ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ПроцессыИСогласование") Тогда
		ТипБДР = "СправочникСсылка.СтатьиДоходовИРасходов";
	Иначе
		ТипБДР = "Строка";
	КонецЕсли;
	
	Для НомерАналитики = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики]) Тогда
			Если Объект.Предназначение = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств 
				И Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики].ТипЗначения.СодержитТип(Тип(ТипБДДС)) Тогда
				Аналитика = Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики];
			ИначеЕсли Объект.Предназначение = Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов 
				И Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики].ТипЗначения.СодержитТип(Тип(ТипБДР)) Тогда
				Аналитика = Объект.ГруппаРаскрытия["ВидАналитики" + НомерАналитики];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Аналитика;
				
КонецФункции