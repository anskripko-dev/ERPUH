
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)
	
	
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	УидПакетаСтрока = Строка(ЭтотОбъект.Ссылка.УникальныйИдентификатор());

	
	Если ИсточникиДанных.Количество()>0 Тогда
		 РасширеннаяНастройка = Истина;
	КонецЕсли;	
	
	ИспользуютсяВнешниеДанные = Ложь;
	Для Каждого СтрИсточник Из ИсточникиДанных Цикл
		
		Если ЗначениеЗаполнено(СтрИсточник.Источник)
			И НЕ СтрИсточник.Источник.ТипБД = Справочники.ТипыБазДанных.ТекущаяИБ Тогда
			ИспользуютсяВнешниеДанные = Истина;
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;	
	
	ДатаВерсииИсточникаДанных = ТекущаяДата();
	
	ТзСвойстваПоказателей 	= АналитическийБланкГенерацияМакетаУХСервер.ПолучитьСвойстваВыбранныхПоказателей(ПоказателиОтчета.ВыгрузитьКолонку("ПоказательОтчета"));

	Для Каждого СтрПоказатель Из ПоказателиОтчета Цикл 
		
		Если СтрПоказатель.Отборы = "" Тогда
			 СтрПоказатель.ХэшОтборов = 0;
		Иначе	
			 СтрПоказатель.ХэшОтборов = Строка(MD5ХешСтрока(СтрПоказатель.Отборы));
		КонецЕсли;	
		
		СоответствиеПолейИИзмерений = Новый Соответствие();
		
		АналитикиТекущегоПоказателя = ИзмеренияИсточников.НайтиСтроки(Новый Структура("ИсточникПредставление",СтрПоказатель.Представление));
		Для Каждого СтрАналитика Из АналитикиТекущегоПоказателя Цикл
			 СоответствиеПолейИИзмерений.Вставить(СтрАналитика.ПутьКИзмерению,СтрАналитика.ИмяВКубе);
		КонецЦикла;	
		
		РесурсыТекущегоПоказателя  = Ресурсы.НайтиСтроки(Новый Структура("ИсточникПредставление",СтрПоказатель.Представление));
        Для Каждого СтрРесурс Из РесурсыТекущегоПоказателя Цикл
			 СоответствиеПолейИИзмерений.Вставить(СтрРесурс.ПутьКРесурсу,СтрРесурс.ИмяВКубе);
		КонецЦикла;	
		
		СтрПоказатель.СоответствиеПолейИИзмерений = ЗначениеВСтрокуВнутр(СоответствиеПолейИИзмерений); 
		СтрПоказатель.ХэшКлючейИзмеренийРесурсов = Строка(MD5ХешСтрока(СтрПоказатель.СоответствиеПолейИИзмерений));
		
		СтрПоказатель.УидПакетаСтрока = УидПакетаСтрока;
		СтрПоказатель.ВидОтчета = ТзСвойстваПоказателей.Найти(СтрПоказатель.ПоказательОтчета,"Ссылка").ВидОтчета;

		
		
	КонецЦикла;
	
	РазличныеГруппы = ПоказателиОтчета.Выгрузить();
	РазличныеГруппы.Свернуть("ХэшОтборов,ХэшКлючейИзмеренийРесурсов");
	
	ГруппыПоказателей.Очистить();
	
	Для Каждого ГруппаПоказателей Из РазличныеГруппы Цикл
		
		нГруппа = ГруппыПоказателей.Добавить();
		ЗаполнитьЗначенияСвойств(нГруппа,ГруппаПоказателей); 
		тЭлементГруппы = ПоказателиОтчета.НайтиСтроки(Новый Структура("ХэшОтборов,ХэшКлючейИзмеренийРесурсов",ГруппаПоказателей.ХэшОтборов,ГруппаПоказателей.ХэшКлючейИзмеренийРесурсов))[0];
		нГруппа.Отборы = тЭлементГруппы.Отборы;
		нГруппа.СоответствиеПолейИИзмерений = тЭлементГруппы.СоответствиеПолейИИзмерений;
		
	КонецЦикла;	
	
	
КонецПроцедуры

Функция MD5ХешСтрока(тСтрокаОтборов)
	
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5); 
 	Хеш.Добавить(тСтрокаОтборов);
 
 	Возврат Хеш.ХешСумма; 

КонецФункции   

#КонецЕсли
