
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ИменаГрупп.ЗагрузитьЗначения(Параметры.ИменаГрупп.ВыгрузитьЗначения());	
		
	ИмяГруппы 			 = Параметры.ИмяГруппы;	
	ИсходноеИмяГруппы    = Параметры.ИмяГруппы;	
		
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяГруппы) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено имя группы'"),,"ИмяГруппы");		
		Возврат;
	КонецЕсли;
	
	Если НЕ ИменаГрупп.НайтиПоЗначению(ИмяГруппы) = Неопределено 
		И ИмяГруппы<>ИсходноеИмяГруппы Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Такое имя группы уже есть, введите другое имя'"),,"ИмяГруппы");		
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ИмяГруппы",ИмяГруппы));
	
КонецПроцедуры

