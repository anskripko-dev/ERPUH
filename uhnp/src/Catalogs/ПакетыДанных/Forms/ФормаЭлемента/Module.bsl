Процедура ИсточникиДанныхПередУдалением(Элемент, Отказ)
	
	УдаляемыйИсточникИсточник =  Элементы.ИсточникиДанных.ТекущиеДанные.Источник;

КонецПроцедуры

&НаКлиенте
Процедура ИсточникиДанныхПослеУдаления(Элемент)
	
	//Удалим источник из таблицы кэшей
	УдаляемыеСтроки  = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление",УдаляемыйИсточникИсточник));
	
	МассивУдаляемыхСтрок = Новый Массив;
	Для Каждого СтрокаТаблицы Из УдаляемыеСтроки Цикл 
		МассивУдаляемыхСтрок.Добавить(СтрокаТаблицы);
	КонецЦикла;	  
	
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхСтрок Цикл 
		КэшДоступныхИзмеренийИРесурсов.Удалить(СтрокаТаблицы);
	КонецЦикла;

	МассивУдаляемыхИзмерений 	= Новый Массив;
	МассивУдаляемыхРесурсов 	= Новый Массив;
	//Удалим источник из таблицы измерений
	Для Каждого СтрокаИзмерение Из ИзмеренияИсточниковСвернутые Цикл
		
		МассивУдаляемыхЭлементовСписка = Новый Массив;
		Для Каждого СтрИсточникИзСписка Из СтрокаИзмерение.СписокИсточников Цикл 
			Если НЕ СтрИсточникИзСписка.Значение.Получить(УдаляемыйИсточникИсточник) = Неопределено Тогда	
				МассивУдаляемыхЭлементовСписка.Добавить(СтрИсточникИзСписка);
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Эл Из МассивУдаляемыхЭлементовСписка Цикл
			СтрокаИзмерение.СписокИсточников.Удалить(Эл)
		КонецЦикла;	
		
		Если КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИмяВКубе,ЭтоРесурс",СтрокаИзмерение.ИмяВКубе,Ложь)).Количество()=0 Тогда
			МассивУдаляемыхИзмерений.Добавить(СтрокаИзмерение);
		КонецЕсли;	
		
	КонецЦикла;	
		
	//Удалим источник из таблицы ресурсов
	Для Каждого СтрокаРесурс Из РесурсыИсточниковСвернутые Цикл
		
		МассивУдаляемыхЭлементовСписка = Новый Массив;
		Для Каждого СтрИсточникИзСписка Из СтрокаРесурс.СписокИсточников Цикл 
			Если НЕ СтрИсточникИзСписка.Значение.Получить(УдаляемыйИсточникИсточник) = Неопределено Тогда	
				МассивУдаляемыхЭлементовСписка.Добавить(СтрИсточникИзСписка);
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Эл Из МассивУдаляемыхЭлементовСписка Цикл
			СтрокаРесурс.СписокИсточников.Удалить(Эл)
		КонецЦикла;	
		
		Если КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИмяВКубе,ЭтоРесурс",СтрокаРесурс.ИмяВКубе,Истина)).Количество()=0 Тогда
			МассивУдаляемыхРесурсов.Добавить(СтрокаРесурс);
		КонецЕсли;
		
	КонецЦикла;	
		
	//Проверим - если в кэше не осталось записей по измерениям и ресурсам - удалим их из текущих таблиц
	//Удалим источник из таблицы измерений
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхИзмерений Цикл 
		ИзмеренияИсточниковСвернутые.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхРесурсов Цикл 
		РесурсыИсточниковСвернутые.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	УправлениеФормойСервер();

КонецПроцедуры

 
#КонецОбласти
 
#Область ОбработчикиСобытийЭлементовФормыИзмерения
 
 &НаКлиенте
Процедура ИзмеренияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Не Поле.Имя = "ИзмеренияСинонимПоля" Тогда
		 СтандартнаяОбработка = Ложь;
	КонецЕсли;	


КонецПроцедуры

&НаКлиенте
Процедура ИзмеренияИсточниковСвернутыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ИзмеренияИсточниковСвернутыеСписокИсточников" Тогда 	
		
		СтандартнаяОбработка = Ложь;
		
		СписокГруппПоказателей = Новый СписокЗначений;
		Для Каждого СтрГруппаПоказателей Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
			СписокГруппПоказателей.Добавить(СтрГруппаПоказателей.Представление);
		КонецЦикла;	
		
		Если Объект.ИсточникиДанных.Количество()>0 Тогда
			СписокГруппПоказателей.Добавить("ИсточникиДанных",Нстр("ru = 'Источники данных'"));
		КонецЕсли;	
		
		
		ПараметрыФормы = Новый Структура("ДоступныеИсточникиАдрес,ВыбранныеИсточники,СписокГруппПоказателей"
		,ПодготовитьАдресТаблицыДоступныхИсточниковИзмерений(Элементы.ИзмеренияИсточниковСвернутые.ТекущиеДанные.ТипЗначенияСтрока)
		,Элементы.ИзмеренияИсточниковСвернутые.ТекущиеДанные.СписокИсточников
		,СписокГруппПоказателей);	   	
		
		Оповещение = Новый ОписаниеОповещения("ФормаРедактированияИстчниковИзмеренийЗавершение", ЭтаФорма);
		
		ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаРедактированияСпискаИсточников", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе	
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ФормаРедактированияИстчниковИзмеренийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
			 	
	Элементы.ИзмеренияИсточниковСвернутые.ТекущиеДанные.СписокИсточников = Результат;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзмеренияПоУмолчаниюКлиент(Команда)
	
	Если Объект.ИзмеренияИсточников.Количество() = 0 Тогда
		ЗаполнитьИзмеренияИРесурсыСервер(,1);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьИзмеренияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Состав измерений будет перезаполнен автоматически, продолжить?'"), РежимДиалогаВопрос.ДаНет);
        Возврат;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьИзмеренияЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьИзмеренияИРесурсыСервер(,1);

КонецПроцедуры

&НаКлиенте
Процедура ИзмеренияИсточниковСвернутыеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
    ДобавитьРесурс(Неопределено);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзмеренияИРесурсыСервер(МассивПредставлений = Неопределено,ТипЗаполнения = 0)
	
	//ТипЗаполнения = 0: Перезаполняем все; 1: Только измерения; 2: Только ресурсы
	
	Если МассивПредставлений = Неопределено Тогда
		//Перезаполняем все измерения и ресурсы по источникам по-умолчанию
		Если ТипЗаполнения = 0  
			ИЛИ ТипЗаполнения = 1 Тогда 
			ЗаполнитьИзмеренияПоУмолчанию();
		КонецЕсли;
		
		Если ТипЗаполнения = 0  
			ИЛИ ТипЗаполнения = 2 Тогда 
			ЗаполнитьРесурсыПоУмолчанию();		
		КонецЕсли;
		
				
	Иначе
		//Добавляем источники в соответствующие по типу измерения и ресурсы
		Для Каждого Представление Из МассивПредставлений Цикл
			
			Если ТипЗаполнения = 0  
				ИЛИ ТипЗаполнения = 1 Тогда 
				
				
				Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,ЭтоРесурс",Представление,Ложь));
				Для Каждого СтрокаИсточника Из Источник Цикл
					
					Нстр = Объект.ИзмеренияИсточников.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,СтрокаИсточника);
					
				КонецЦикла;	
			КонецЕсли;
			
			Если ТипЗаполнения = 0  
				ИЛИ ТипЗаполнения = 2 Тогда 
				
				
				Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,ЭтоРесурс",Представление,Истина));
				Для Каждого СтрокаИсточника Из Источник Цикл
					
					Нстр = Объект.Ресурсы.Добавить();
					ЗаполнитьЗначенияСвойств(Нстр,СтрокаИсточника);	
				КонецЦикла;	
			КонецЕсли;
			
		КонецЦикла;	
				
	КонецЕсли;	
		
	Если ТипЗаполнения = 0  
		ИЛИ ТипЗаполнения = 1 Тогда 
		ОбновитьТаблицуСвернутыхИзмерений();
	КонецЕсли;

	Если ТипЗаполнения = 0  
		ИЛИ ТипЗаполнения = 2 Тогда 	
		ОбновитьТаблицуСвернутыхРесурсов();
	КонецЕсли;

	
КонецПроцедуры	

&НаСервере
Функция ПодготовитьАдресТаблицыДоступныхИсточниковИзмерений(ТипЗначенияСтрока) 
	
	ДоступныеИсточники = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ТипЗначенияСтрока,ЭтоРесурс",ТипЗначенияСтрока,Ложь));
	
	ДоступныеИсточники.Колонки.Добавить("ГруппаПоказателей");
	
	Для Каждого СтрИсточник Из ДоступныеИсточники Цикл
		
		Если ТипЗнч(СтрИсточник.Источник) = Тип("СправочникСсылка.ИсточникиДанныхДляРасчетов") Тогда
			
			СтрИсточник.ГруппаПоказателей = "ИсточникиДанных";
			
		Иначе
			
			Для Каждого СтрГруппаПоказателей Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
				
				Для Каждого СтрПоказатель Из  СтрГруппаПоказателей.ПолучитьЭлементы() Цикл
					Если СтрИсточник.ИсточникПредставление = СтрПоказатель.Представление Тогда					
						СтрИсточник.ГруппаПоказателей = СтрГруппаПоказателей.Представление;
						Прервать;
					КонецЕсли;	
				КонецЦикла;		
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
	
	Возврат ПоместитьВоВременноеХранилище(ДоступныеИсточники,ЭтаФорма.УникальныйИдентификатор);

КонецФункции	

&НаСервере
Процедура ЗаполнитьИзмеренияПоУмолчанию()
	
	Объект.ИзмеренияИсточников.Очистить();
	
	Для Каждого Стр Из КэшДоступныхИзмеренийИРесурсов Цикл
		
		Если НЕ Стр.ЭтоРесурс Тогда
			
			Нстр = Объект.ИзмеренияИсточников.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,Стр);
			Нстр.ПутьКИзмерению = Стр.Путь;

		КонецЕсли;	
				
	КонецЦикла;	
			
КонецПроцедуры	

&НаСервере
Процедура ОбновитьТаблицуСвернутыхИзмерений()
	
	ИзмеренияИсточниковСвернутые.Очистить();
	
	Для Каждого СтрИзмерение Из Объект.ИзмеренияИсточников Цикл
		
		СуществющиеИзмерения = ИзмеренияИсточниковСвернутые.НайтиСтроки(Новый Структура("ПредставлениеИзмерения,ТипЗначенияСтрока",СтрИзмерение.СинонимПоля,СтрИзмерение.ТипЗначенияСтрока));
		Если  СуществющиеИзмерения.Количество()=0 Тогда
			СтрокаИзмерение = ИзмеренияИсточниковСвернутые.Добавить();	
			СтрокаИзмерение.ПредставлениеИзмерения = СтрИзмерение.СинонимПоля;
			СтрокаИзмерение.Использовать = Истина;
		Иначе	
			СтрокаИзмерение = СуществющиеИзмерения[0];	
		КонецЕсли;	
		
		СооствествиеИсточникаПути = Новый Соответствие;
		СооствествиеИсточникаПути.Вставить(СтрИзмерение.ИсточникПредставление,СтрИзмерение.ПутьКИзмерению);
		СтрокаИзмерение.СписокИсточников.Добавить(СооствествиеИсточникаПути,"["+СтрИзмерение.ИсточникПредставление+"]."+СтрИзмерение.ПутьКИзмерению);
		
		
		СтрокаИзмерение.ПутьКИзмерению = СтрИзмерение.ПутьКИзмерению;
        СтрокаИзмерение.ТипЗначенияСтрока = СтрИзмерение.ТипЗначенияСтрока;
		СтрокаИзмерение.ИмяВКубе = СтрИзмерение.ИмяВКубе;
		СтрокаИзмерение.ПриоритетСортировки = СтрИзмерение.ПриоритетСортировки;
		
	КонецЦикла;	
	
	ИзмеренияИсточниковСвернутые.Сортировать("ПриоритетСортировки,ПредставлениеИзмерения");

КонецПроцедуры	



#КонецОбласти  
 
 #Область ОбработчикиСобытийЭлементовФормыРесурсы
 
&НаКлиенте
Процедура РесурсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
   Если Не Поле.Имя = "РесурсыСинонимПоля" Тогда
		СтандартнаяОбработка = Ложь;
   КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура РесурсыИсточниковСвернутыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;	
	ИзменитьРесурс();
		
КонецПроцедуры

&НаКлиенте
Процедура ФормаРедактированияИстчниковРесурсовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
			 	
	Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.СписокИсточников.ЗагрузитьЗначения(Результат);
	
	УдаляемыеСтроки = Новый Массив();
	тРесурсы = Объект.Ресурсы.НайтиСтроки(Новый Структура("ИмяВКубе",Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.ИмяВКубе));
	Для Каждого Рес Из тРесурсы Цикл
		 УдаляемыеСтроки.Добавить(Рес);	
	КонецЦикла;	
	
	Для Каждого удСтрока Из УдаляемыеСтроки Цикл
		Объект.Ресурсы.Удалить(удСтрока);
	КонецЦикла;	
	
	Для Каждого ВыбранныйИстчник Из Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.СписокИсточников Цикл
		 	
		тСтрокаКэша = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИмяВКубе,ИсточникПредставление,ЭтоРесурс",Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.ИмяВКубе,ВыбранныйИстчник.Значение,Истина));
		Для Каждого Стр Из тСтрокаКэша Цикл
			нРесурс = Объект.Ресурсы.Добавить();
			ЗаполнитьЗначенияСвойств(нРесурс,Стр);
		КонецЦикла;	
		
	КонецЦикла;	
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРесурсыПоУмолчаниюКлиент(Команда)
	
	Если Объект.Ресурсы.Количество() = 0 Тогда
		ЗаполнитьИзмеренияИРесурсыСервер(,2);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьРесурсыЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Состав ресурсов будет перезаполнен автоматически, продолжить?'"), РежимДиалогаВопрос.ДаНет);
        Возврат;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьРесурсыЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьИзмеренияИРесурсыСервер(,2);

КонецПроцедуры

&НаКлиенте
Процедура РесурсыИсточниковСвернутыеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	Если Копирование Тогда
		Отказ = Истина;
	Иначе	
		Отказ = Истина;
		ДобавитьРесурс(Неопределено);
	КонецЕсли;			
	
КонецПроцедуры

&НаКлиенте
Процедура РесурсыИсточниковСвернутыеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ИзменитьРесурс();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРесурс(Команда)
	
	
	СписокГруппПоказателей = Новый СписокЗначений;
	Для Каждого СтрГруппаПоказателей Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
		СписокГруппПоказателей.Добавить(СтрГруппаПоказателей.Представление);
	КонецЦикла;	

	
	ПараметрыФормы = Новый Структура("ДоступныеИсточникиАдрес,ВыбранныеИсточники,ТекущиеРесурсы,ВыбранныйРесурс,ТипЗначенияРесурса,СписокГруппПоказателей"
	,ПодготовитьАдресТаблицыДоступныхИсточниковРесурсов()
	,Неопределено
	,ПолучитьТекущиеРесурсы()
	,Неопределено
	,Неопределено
	,СписокГруппПоказателей);	   	
	
	Оповещение = Новый ОписаниеОповещения("ФормаДобавленияРесурсовЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаДобавленияИзмененияРесурса", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРесурс()
	
	
	СписокГруппПоказателей = Новый СписокЗначений;
	Для Каждого СтрГруппаПоказателей Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
		СписокГруппПоказателей.Добавить(СтрГруппаПоказателей.Представление);
	КонецЦикла;	
	
	Если Объект.ИсточникиДанных.Количество()>0 Тогда
		СписокГруппПоказателей.Добавить("ИсточникиДанных",Нстр("ru = 'Источники данных'"));
	КонецЕсли;	
	

	
	ПараметрыФормы = Новый Структура("ДоступныеИсточникиАдрес,ВыбранныеИсточники,ТекущиеРесурсы,ВыбранныйРесурс,ТипЗначенияРесурса,СписокГруппПоказателей"
	,ПодготовитьАдресТаблицыДоступныхИсточниковРесурсов(Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.ТипЗначенияСтрока)
	,Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.СписокИсточников
	,ПолучитьТекущиеРесурсы()
	,Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.ПредставлениеРесурса
	,Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные.ТипЗначенияСтрока
	,СписокГруппПоказателей);	   	
	
	Оповещение = Новый ОписаниеОповещения("ФормаИзмененияРесурсовЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаДобавленияИзмененияРесурса", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаДобавленияРесурсовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	НРесурсСвернутый = РесурсыИсточниковСвернутые.Добавить();
	НРесурсСвернутый.Использовать = Истина;
	НРесурсСвернутый.ТипЗначенияСтрока = Результат.ТипЗначенияРесурса;
	НРесурсСвернутый.СписокИсточников  = Результат.СписокИсточников;
	НРесурсСвернутый.ПредставлениеРесурса = Результат.ЗаголовокРесурса;
	НРесурсСвернутый.ИмяВКубе            =  СформироватьКодНаОснованииНаименования(Результат.ЗаголовокРесурса);
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаИзмененияРесурсовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	НРесурсСвернутый = Элементы.РесурсыИсточниковСвернутые.ТекущиеДанные;
	НРесурсСвернутый.Использовать = Истина;
	НРесурсСвернутый.ТипЗначенияСтрока = Результат.ТипЗначенияРесурса;
	НРесурсСвернутый.СписокИсточников  = Результат.СписокИсточников;
	НРесурсСвернутый.ПредставлениеРесурса = Результат.ЗаголовокРесурса;
	НРесурсСвернутый.ИмяВКубе            =  СформироватьКодНаОснованииНаименования(Результат.ЗаголовокРесурса);

	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРесурсыПоУмолчанию()
	
	Объект.Ресурсы.Очистить();
	
	//Для источников - показателей группируем ресурсы по колонкам показателей
	Если Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоКолонкеПоказателя Тогда
		КэшДоступныхРесурсовПоказателей = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ЭтоРесурс,ЭтоПоказательОтчета",Истина,Истина)); 
		КолонкиПоказателей = КэшДоступныхРесурсовПоказателей.Скопировать(); 
		КолонкиПоказателей.Свернуть("КолонкаОтчета");
		
		Для Каждого СтрКолонка Из КолонкиПоказателей Цикл
			
			СоставПоказателейКолонки = КэшДоступныхРесурсовПоказателей.НайтиСтроки(Новый Структура("КолонкаОтчета",СтрКолонка.КолонкаОтчета));
			Для Каждого СтрПоказатель Из СоставПоказателейКолонки Цикл
				Нстр = Объект.Ресурсы.Добавить();
				ЗаполнитьЗначенияСвойств(Нстр,СтрПоказатель);
				Нстр.ИмяВКубе 			= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрКолонка.КолонкаОтчета,"Код"));
				Нстр.СинонимПоля 		= Строка(СтрКолонка.КолонкаОтчета);			
				Нстр.ПутьКРесурсу 		= СтрПоказатель.Путь;
			КонецЦикла;	
			
		КонецЦикла;	
		
	ИначеЕсли Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоПоказателю Тогда
		
		КэшДоступныхРесурсовПоказателей = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ЭтоРесурс,ЭтоПоказательОтчета",Истина,Истина)); 
		
		Для Каждого СтрПоказатель Из КэшДоступныхРесурсовПоказателей Цикл
			
			Нстр = Объект.Ресурсы.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрПоказатель);
			Нстр.ИмяВКубе 		= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрПоказатель.Источник,"Код"));
			Нстр.СинонимПоля 	= СтрПоказатель.ИсточникПредставление;
			Нстр.ПутьКРесурсу = СтрПоказатель.Путь;					
		КонецЦикла;	
		
	Иначе
		
		КэшДоступныхРесурсовПоказателей = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ЭтоРесурс,ЭтоПоказательОтчета",Истина,Истина)); 
		
		Для Каждого СтрПоказатель Из КэшДоступныхРесурсовПоказателей Цикл
			
			Нстр = Объект.Ресурсы.Добавить();
			ЗаполнитьЗначенияСвойств(Нстр,СтрПоказатель);
			Нстр.ИмяВКубе 		= "Значение";
			Нстр.СинонимПоля 	= "Значение";		
			Нстр.ПутьКРесурсу = СтрПоказатель.Путь;		
		КонецЦикла;	
		
	КонецЕсли;
	
	КэшДоступныхРесурсовИсточников = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ЭтоРесурс,ЭтоПоказательОтчета",Истина,Ложь)); 
    Для Каждого Стр Из КэшДоступныхРесурсовИсточников Цикл
		Нстр = Объект.Ресурсы.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр,Стр);
		Нстр.ПутьКРесурсу = Стр.Путь;	
	КонецЦикла;	
		
КонецПроцедуры	

&НаСервере
Функция ПодготовитьАдресТаблицыДоступныхИсточниковРесурсов(ТипЗначенияСтрока = Неопределено) 
	
	Если НЕ ТипЗначенияСтрока = Неопределено Тогда
		ДоступныеИсточники = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ТипЗначенияСтрока,ЭтоРесурс",ТипЗначенияСтрока,Истина));
	Иначе	
		ДоступныеИсточники = КэшДоступныхИзмеренийИРесурсов.Выгрузить(Новый Структура("ЭтоРесурс",Истина));
	КонецЕсли;
	
	ДоступныеИсточники.Колонки.Добавить("ГруппаПоказателей");
	
	Для Каждого СтрИсточник Из ДоступныеИсточники Цикл
		
		Если ТипЗнч(СтрИсточник.Источник) = Тип("СправочникСсылка.ИсточникиДанныхДляРасчетов") Тогда
			
			СтрИсточник.ГруппаПоказателей = "ИсточникиДанных";		
		Иначе	
			
			Для Каждого СтрГруппаПоказателей Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
				
				Для Каждого СтрПоказатель Из  СтрГруппаПоказателей.ПолучитьЭлементы() Цикл
					Если СтрИсточник.ИсточникПредставление = СтрПоказатель.Представление Тогда					
						СтрИсточник.ГруппаПоказателей = СтрГруппаПоказателей.Представление;
						Прервать;
					КонецЕсли;	
				КонецЦикла;		
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЦикла;		
	
	Возврат ПоместитьВоВременноеХранилище(ДоступныеИсточники,ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ПолучитьТекущиеРесурсы() 
		
	Возврат РесурсыИсточниковСвернутые.Выгрузить().ВыгрузитьКолонку("ПредставлениеРесурса");

КонецФункции


#КонецОбласти
 
#Область СтандартноеЗаполнениеИзмеренийИРесуров

&НаСервере
Процедура ОбновитьСвернутыеИзмеренияИРесурсыСервер(МассивПредставлений)
	
	
	//Добавляем источники в соответствующие по типу измерения и ресурсы
	Для Каждого Представление Из МассивПредставлений Цикл
		
		Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,ЭтоРесурс",Представление,Ложь));
		Для Каждого СтрокаИсточника Из Источник Цикл
			
			тИзмерение = ИзмеренияИсточниковСвернутые.НайтиСтроки(Новый Структура("ИмяВКубе,ТипЗначенияСтрока",СтрокаИсточника.ИмяВКубе,СтрокаИсточника.ТипЗначенияСтрока));
			Если тИзмерение.Количество() = 0 Тогда
				Измерение = ИзмеренияИсточниковСвернутые.Добавить();
				ЗаполнитьЗначенияСвойств(Измерение,СтрокаИсточника);
							
				ОбновитьСписокИсточниковПоля(Измерение,СтрокаИсточника);
				
				Измерение.ПредставлениеИзмерения =  СтрокаИсточника.СинонимПоля;
				Измерение.ПутьКИзмерению         =  СтрокаИсточника.Путь;
			Иначе	
				Измерение = тИзмерение[0];
				ОбновитьСписокИсточниковПоля(Измерение,СтрокаИсточника);
								
			КонецЕсли;				
				
		КонецЦикла;	
			
		Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,ЭтоРесурс",Представление,Истина));
		
		Для Каждого СтрокаИсточника Из Источник Цикл
			
			Если Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ВОдинРесурс Тогда
				тРесурс = РесурсыИсточниковСвернутые.НайтиСтроки(Новый Структура("ИмяВКубе,ТипЗначенияСтрока",СтрокаИсточника.ИмяВКубе,СтрокаИсточника.ТипЗначенияСтрока))
			ИначеЕсли Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоКолонкеПоказателя Тогда	
				тРесурс = РесурсыИсточниковСвернутые.НайтиСтроки(Новый Структура("ПредставлениеРесурса,ТипЗначенияСтрока",Строка(СтрокаИсточника.КолонкаОтчета),СтрокаИсточника.ТипЗначенияСтрока))
			ИначеЕсли Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоПоказателю Тогда	
				тРесурс = РесурсыИсточниковСвернутые.НайтиСтроки(Новый Структура("ПредставлениеРесурса,ТипЗначенияСтрока",СтрокаИсточника.ИсточникПредставление,СтрокаИсточника.ТипЗначенияСтрока))
			КонецЕсли;
			
			Если тРесурс.Количество() = 0 Тогда
				Ресурс = РесурсыИсточниковСвернутые.Добавить();
				ЗаполнитьЗначенияСвойств(Ресурс,СтрокаИсточника);
				ОбновитьСписокИсточниковПоля(Ресурс,СтрокаИсточника);
			
				Если Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ВОдинРесурс Тогда
					Ресурс.ПредставлениеРесурса =  СтрокаИсточника.СинонимПоля;
					Ресурс.ИмяВКубе 			=  СтрокаИсточника.ИмяВКубе;
				ИначеЕсли Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоКолонкеПоказателя Тогда	
					Ресурс.ПредставлениеРесурса =  Строка(СтрокаИсточника.КолонкаОтчета);
					Ресурс.ИмяВКубе 			=  СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаИсточника.КолонкаОтчета,"Код"));
				ИначеЕсли Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоПоказателю Тогда	
					Ресурс.ПредставлениеРесурса =  СтрокаИсточника.ИсточникПредставление;
					Ресурс.ИмяВКубе 			=  СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаИсточника.ИсточникПредставление,"Код"));			    
				КонецЕсли;                         

				
				Ресурс.ПутьКРесурсу = 	СтрокаИсточника.Путь;			
						
			Иначе	
				Ресурс = тРесурс[0];
				ОбновитьСписокИсточниковПоля(Ресурс,СтрокаИсточника);
				
			КонецЕсли;				
			
						
		КонецЦикла;	
		
	КонецЦикла;	

		
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСвернутыеИзмеренияИРесурсыПоИсточникуСервер(НовыйИсточник)
	
	
	//Добавляем источники в соответствующие по типу измерения и ресурсы
		
		Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("Источник,ЭтоРесурс",НовыйИсточник,Ложь));
		Для Каждого СтрокаИсточника Из Источник Цикл
			
			тИзмерение = ИзмеренияИсточниковСвернутые.НайтиСтроки(Новый Структура("ИмяВКубе,ТипЗначенияСтрока",СтрокаИсточника.ИмяВКубе,СтрокаИсточника.ТипЗначенияСтрока));
			Если тИзмерение.Количество() = 0 Тогда
				Измерение = ИзмеренияИсточниковСвернутые.Добавить();
