
  
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	//Заполним кэш доступных измерений и ресурсов и их типов значений на основании текущих иточников
	ОбновитьКэшДоступныхИзмеренийИРесурсов();
	
	ОбновитьТаблицуСвернутыхИзмерений();
	ОбновитьТаблицуСвернутыхРесурсов();
	
	УправлениеФормойСервер();
	
	Если НЕ ЗначениеЗаполнено(Объект.ГруппировкаРесурсовПоказателей) Тогда
		 Объект.ГруппировкаРесурсовПоказателей = Перечисления.ВариантыГруппировкиПоказателейВИсточинках.ПоКолонкеПоказателя;
	КонецЕсли;	
	
	//Заполним дерево показателей - групп
	Для Каждого СтрГруппа Из Объект.ГруппыПоказателейВИнтерфейсе Цикл
		нГруппа = ПоказателиПоГруппам.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(нГруппа,СтрГруппа);
		нГруппа.ИндексКартинки = 1;
		
		ПоказателиГруппы = Объект.ПоказателиОтчета.НайтиСтроки(Новый Структура("ГруппаПоказателей",СтрГруппа.Представление));
		Для Каждого СтрПоказатель Из ПоказателиГруппы Цикл
			нПоказатель = нГруппа.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(нПоказатель,СтрПоказатель);
            нПоказатель.ИндексКартинки = 2;
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	тКэшДоступныхИзмеренийИРесурсов = КэшДоступныхИзмеренийИРесурсов.Выгрузить();
	тКэшДоступныхИзмеренийИРесурсов.Индексы.Добавить("ИсточникПредставление,Путь,ЭтоРесурс");
	
	//заполним развернутые таблицы измерений - ресурсов
	ТекущийОбъект.ИзмеренияИсточников.Очистить();
	
	Для Каждого СтрИзмерение Из ИзмеренияИсточниковСвернутые Цикл
		
			Для Каждого СтрИсточник Из СтрИзмерение.СписокИсточников Цикл
				
				нИзмерение = ТекущийОбъект.ИзмеренияИсточников.Добавить();
				нИзмерение.ТипЗначенияСтрока        = СтрИзмерение.ТипЗначенияСтрока;
				нИзмерение.ИмяВКубе                 = СтрИзмерение.ИмяВКубе;
				
				Для Каждого СтрКлюч Из СтрИсточник.Значение Цикл
					
					Источники = тКэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,Путь,ЭтоРесурс"
					,СтрКлюч.Ключ
					,СтрКлюч.Значение
					,Ложь));
					
					Если НЕ Источники.Количество() = 0 Тогда
						Источник = Источники[0]
					Иначе	
						ТекстСообщения  = НСтр("ru = 'Не найдено поле источника измерения %1'");
						ТекстСообщения  = СтрШаблон(ТекстСообщения,СтрКлюч.Ключ);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"ЗаголовокРесурса",,Отказ);		
						Возврат;
					КонецЕсли;	
					
				КонецЦикла;
				
				
				нИзмерение.ПутьКИзмерению 			= Источник.Путь;
				нИзмерение.Источник                 = Источник.Источник;
				нИзмерение.ИсточникПредставление    = Источник.ИсточникПредставление;
				нИзмерение.ПриоритетСортировки      = СтрИзмерение.ПриоритетСортировки;
				нИзмерение.СинонимПоля              = СтрИзмерение.ПредставлениеИзмерения;
				нИзмерение.Использовать             = СтрИзмерение.Использовать;
				
			КонецЦикла;	
		
	КонецЦикла;	
	
	//заполним развернутые таблицы измерений - ресурсов
	ТекущийОбъект.Ресурсы.Очистить();
	Для Каждого СтрРесурс Из РесурсыИсточниковСвернутые Цикл
		
		Для Каждого СтрИсточник Из СтрРесурс.СписокИсточников Цикл
			
			нИзмерение = ТекущийОбъект.Ресурсы.Добавить();
			нИзмерение.ТипЗначенияСтрока        = СтрРесурс.ТипЗначенияСтрока;
			нИзмерение.ИмяВКубе                 = СтрРесурс.ИмяВКубе;
			
			Для Каждого СтрКлюч Из СтрИсточник.Значение Цикл
				Источники = тКэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление,Путь,ЭтоРесурс"
				,СтрКлюч.Ключ
				,СтрКлюч.Значение
				,Истина));
				
				Если НЕ Источники.Количество() = 0 Тогда
					Источник = Источники[0]
				Иначе	
					ТекстСообщения  = НСтр("ru = 'Не найдено поле источника ресурса %1'");
					ТекстСообщения  = СтрШаблон(ТекстСообщения,СтрКлюч.Ключ);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"ЗаголовокРесурса",,Отказ);		
					Возврат;					
				КонецЕсли;			
				
			КонецЦикла;
			
			нИзмерение.ПутьКРесурсу 			= Источник.Путь;
			нИзмерение.Источник                 = Источник.Источник;
			нИзмерение.ИсточникПредставление    = Источник.ИсточникПредставление;
			нИзмерение.ПриоритетСортировки      = СтрРесурс.ПриоритетСортировки;
			нИзмерение.СинонимПоля              = СтрРесурс.ПредставлениеРесурса;
			нИзмерение.Использовать             = СтрРесурс.Использовать;
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	
	//Если есть источники - показатели сформируем соответствие парметров отборов и контекста по умолчанию 
	Для Каждого СтрИсточник Из ТекущийОбъект.ИсточникиДанных Цикл
		
		ИсточникОбъект = СтрИсточник.Источник.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		
	КонецЦикла;	
	
	//Для отображения показателей в виде дерева запишем группы
	ТекущийОбъект.ГруппыПоказателейВИнтерфейсе.Очистить();
	ТекущийОбъект.ПоказателиОтчета.Очистить();
	
	ПоказателиГруппы = ПоказателиПоГруппам.ПолучитьЭлементы();
	Для Каждого ПоказательГруппа Из ПоказателиГруппы Цикл
		Если ПоказательГруппа.ИндексКартинки = 1 Тогда
			нГруппа = ТекущийОбъект.ГруппыПоказателейВИнтерфейсе.Добавить();
			ЗаполнитьЗначенияСвойств(нГруппа,ПоказательГруппа);
			Для Каждого ПоказательЭлемент Из ПоказательГруппа.ПолучитьЭлементы() Цикл
				нПоказатель = ТекущийОбъект.ПоказателиОтчета.Добавить();
				ЗаполнитьЗначенияСвойств(нПоказатель,ПоказательЭлемент);
				нПоказатель.ГруппаПоказателей = ПоказательГруппа.Представление;
			КонецЦикла;			
		КонецЕсли;	
	КонецЦикла;	
	
	
	//Сформируем и запишем схему компоновки по умолчанию, для использования в отчтеах.
	СКДИстчоника = Справочники.ПакетыДанных.СформироватьСКДПоНаборуДанных(ТекущийОбъект);
	ТекущийОбъект.СхемаКомпоновкиДанныхпоУмолчанию  = Новый ХранилищеЗначения(СКДИстчоника);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормойСервер()
	
	Элементы.ГруппаИзмерения.Доступность = 
	НЕ (Объект.ПоказателиОтчета.Количество()+Объект.ИсточникиДанных.Количество() = 0);
	
	Элементы.ГруппаРесурсы.Доступность = 
	НЕ (Объект.ПоказателиОтчета.Количество()+Объект.ИсточникиДанных.Количество() = 0);

	Элементы.РасширеннаяНастройка.Доступность 			= Объект.ИсточникиДанных.Количество() = 0;
	Элементы.ГруппаИсточникиДанных.Видимость 			= Объект.РасширеннаяНастройка;
	Элементы.ДекорацияПростаяНастройка.Видимость 		= НЕ Объект.РасширеннаяНастройка;
	Элементы.ДекорацияРасширеннаяНастройка.Видимость 	= Объект.РасширеннаяНастройка;

	
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиСобытийЭлементовДеревоПоказатели

&НаКлиенте
Процедура ПодборПоказателей(Команда)
	
	Оповещение 		= Новый ОписаниеОповещения("ПодборПоказателейЗавершение", ЭтаФорма);
	ОткрытьФорму("Справочник.ПоказателиОтчетов.ФормаВыбора", Новый Структура("МножественныйВыбор", Истина), ЭтаФорма,,,,Оповещение);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоказателейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	МассивПредставлений = Новый Массив;
	
	ТекущаяГруппаПоказателей = Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные;
	Если ТекущаяГруппаПоказателей = Неопределено Тогда
		//Нет групп - добавим первую
		ДобавитьГруппуПоказателей(Неопределено);
		ГруппаРодитель =ПоказателиПоГруппам.ПолучитьЭлементы()[0];
		
	ИначеЕсли Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ИндексКартинки =1  Тогда	
		//Находимся на папке с группой
		ГруппаРодитель = ПоказателиПоГруппам.НайтиПоИдентификатору(Элементы.ПоказателиПоГруппамДерево.ТекущаяСтрока);
	Иначе	
		//Находимся вниутри группы
		ГруппаРодитель = ПоказателиПоГруппам.НайтиПоИдентификатору(Элементы.ПоказателиПоГруппамДерево.ТекущаяСтрока);
		ГруппаРодитель = ГруппаРодитель.ПолучитьРодителя();
	КонецЕсли;	
	
	
	Для Каждого СтрПоказатель Из Результат.МассивПоказателей Цикл		
		
		СуществующиеПоказателиКоличество = Объект.ПоказателиОтчета.НайтиСтроки(Новый Структура("ПоказательОтчета",СтрПоказатель.Ссылка)).Количество();
	
		//Добавляем показатель в интерфейс дерева
		нСтр = ГруппаРодитель.ПолучитьЭлементы().Добавить();
		нСтр.ПоказательОтчета  = СтрПоказатель.Ссылка;
		Если СуществующиеПоказателиКоличество=0 Тогда
			нСтр.Представление      = Строка(СтрПоказатель.Ссылка);
		Иначе	
			нСтр.Представление      = Строка(СтрПоказатель.Ссылка)+" #"+Строка(СуществующиеПоказателиКоличество);
		КонецЕсли;			
		нСтр.ПредставлениеОтбора  = Нстр("ru = 'Нет'");
        нСтр.ИндексКартинки       = 2;
		
		//добавляем показатель в таб часть показателей				
		нСтр = Объект.ПоказателиОтчета.Добавить();
		нСтр.ПоказательОтчета  = СтрПоказатель.Ссылка;		
		нСтр.Использовать      = Истина;
				
		Если СуществующиеПоказателиКоличество=0 Тогда
			нСтр.Представление      = Строка(СтрПоказатель.Ссылка);
		Иначе	
			нСтр.Представление      = Строка(СтрПоказатель.Ссылка)+" #"+Строка(СуществующиеПоказателиКоличество);
		КонецЕсли;	
			
		нСтр.ПредставлениеОтбора  = Нстр("ru = 'Нет'");
		
		МассивПредставлений.Добавить(нСтр.Представление);		
		
		
	КонецЦикла;	
	
	ОбновитьКэшДоступныхИзмеренийИРесурсов();
	ОбновитьСвернутыеИзмеренияИРесурсыСервер(МассивПредставлений);
	//ОбновитьТаблицуСвернутыхИзмерений();
	//ОбновитьТаблицуСвернутыхРесурсов();
	УправлениеФормойСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьГруппуПоказателей(Команда)
	
	Если Команда = Неопределено Тогда//Программное авто добавление первой группы
		НоваяГруппа 							= ПоказателиПоГруппам.ПолучитьЭлементы().Добавить();
		НоваяГруппа.ИндексКартинки 			= 1;
		НоваяГруппа.Представление     		= "Новая группа";
		НоваяГруппа.ПредставлениеОтбора    	= Нстр("ru = 'Нет'");
	Иначе 
		
		ИменаГрупп  = Новый СписокЗначений;
		
		Для Каждого СтрГруппа Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
			ИменаГрупп.Добавить(СтрГруппа.Представление);
		КонецЦикла;	
			
		ПараметрыФормы = Новый Структура("ИмяГруппы,ИменаГрупп","",ИменаГрупп);	   	
		
		Оповещение = Новый ОписаниеОповещения("ДобавлениеГруппыПоказателейЗавершение", ЭтаФорма);
		
		ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаДобавленияИзмененияГруппыПоказателей", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

	  
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если  Поле.Имя = "ПоказателиПоГруппамДеревоПредставление" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		//Группу показателей можно редактировать
		Если Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ИндексКартинки = 1 Тогда
			
			ИменаГрупп  = Новый СписокЗначений;
			
			Для Каждого СтрГруппа Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
				ИменаГрупп.Добавить(СтрГруппа.Представление);
			КонецЦикла;	
			
			ПараметрыФормы = Новый Структура("ИмяГруппы,ИменаГрупп",Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.Представление,ИменаГрупп);	   	
			
			Оповещение = Новый ОписаниеОповещения("ИзменениеГруппыПоказателейЗавершение", ЭтаФорма);			
			ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаДобавленияИзмененияГруппыПоказателей", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
					
		КонецЕсли;	
		
		
	ИначеЕсли Поле.Имя = "ПоказателиПоГруппамДеревоПредставлениеОтбора" Тогда 	
		 
		 СтандартнаяОбработка = Ложь;
		 	 		 
		 Если Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ИндексКартинки = 1 Тогда
			  Возврат;
		 КонецЕсли;	 
		  
		 МассивПоказателей = Новый Массив;
		 МассивПоказателей.Добавить(Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ПоказательОтчета);
		 
		 СтруктураПараметров = ПодготовитьТаблицуОтборовПоказателей(МассивПоказателей,Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.Отборы);

		 ПараметрыФормы = Новый Структура("Бланк,ГрупповойРежим,ТзРасшифровкаОтборовАдрес,ТЗРасшифровкаОтборовГруппРаскрытия,ОтображатьСуммуВДопВалюте"
		 ,Неопределено
		 ,Ложь
		 ,СтруктураПараметров.ТзРасшифровкаОтборов
		 ,СтруктураПараметров.ТЗРасшифровкаОтборовГруппРаскрытия
		 ,СтруктураПараметров.ОтображатьСуммуВДопВалюте);	   	
		 
		 Оповещение = Новый ОписаниеОповещения("ФормаРедактированияОтборовЗавершение", ЭтаФорма);
		 
		 ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаРедактированияОтборов", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		 	 
	 КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПередУдалением(Элемент, Отказ)
	
	Если НЕ Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные = Неопределено 
		И Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ИндексКартинки = 1 
		И Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ПолучитьЭлементы().Количество()>0 Тогда //Удаляем не пустую группу
		
		Оповещение = Новый ОписаниеОповещения("ВопросУдалитьГруппуПоказателейЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить группу со  всеми показателями ?'"), РежимДиалогаВопрос.ДаНет);
		
		Отказ = Истина;
		
	ИначеЕсли НЕ Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные = Неопределено Тогда	 
		
		УдаляемыйИсточникПоказатель =  Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.Представление;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУдалитьГруппуПоказателейЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	УдалитьГруппуПоказателей();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьГруппуПоказателей()
	
	МассивУдаленныхЭлементов = Новый Массив;
	
	УдаляемаяГруппа = Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные;
		
	Для Каждого СтрЭлемент Из УдаляемаяГруппа.ПолучитьЭлементы() Цикл 
		УдаляемыйИсточникПоказатель = СтрЭлемент.Представление;
		ПоказателиПоГруппамДеревоПослеУдаления(Неопределено);
	КонецЦикла;	
		
	ПоказателиПоГруппам.ПолучитьЭлементы().Удалить(УдаляемаяГруппа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПослеУдаления(Элемент)
		
	УдаляемыеПоказатели = Объект.ПоказателиОтчета.НайтиСтроки(Новый Структура("Представление",УдаляемыйИсточникПоказатель));
	
	МассивУдаляемыхСтрок = Новый Массив;
	Для Каждого СтрокаТаблицы Из УдаляемыеПоказатели Цикл 
		МассивУдаляемыхСтрок.Добавить(СтрокаТаблицы);
	КонецЦикла;	  
	
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхСтрок Цикл 
		Объект.ПоказателиОтчета.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	ПоказателиОтчетаПослеУдаления(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеГруппыПоказателейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	нГруппа 				= Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные;
	нГруппа.Представление 	= Результат.ИмяГруппы;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеГруппыПоказателейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	НоваяГруппа 							= ПоказателиПоГруппам.ПолучитьЭлементы().Добавить();
	НоваяГруппа.ИндексКартинки 			= 1;
	НоваяГруппа.Представление     		= Результат.ИмяГруппы;
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ЭлементПриемник = ПоказателиПоГруппам.НайтиПоИдентификатору(Строка);
	
	МассивУдаляемых = Новый Массив;
	
	Для Каждого СтрокаИсточник Из ПараметрыПеретаскивания.Значение Цикл
		
		СтандартнаяОбработка = Истина;
		
		ЭлементИсточник = ПоказателиПоГруппам.НайтиПоИдентификатору(СтрокаИсточник);
		
		Если ЭлементИсточник.ИндексКартинки = 1 Тогда //Группу запрещаем перетаскивать
			СтандартнаяОбработка = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЭлементПриемник.ИндексКартинки = 1 Тогда//Приемник - элемент. Перетащим в его родителя
			СтандартнаяОбработка = Ложь;
			тРодитель = ЭлементПриемник.ПолучитьРодителя();
			нЭлемент = тРодитель.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(нЭлемент,ЭлементИсточник);
			МассивУдаляемых.Добавить(ЭлементИсточник);
			
			ЭлементИсточник.ПолучитьРодителя().ПолучитьЭлементы().Удалить(ЭлементИсточник);
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаРедактированияОтборовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	СтрукутраОтборов = ЗаписатьОтборСервер(Результат.АдресРезультатаРедактирования);
	 
	Если СтрукутраОтборов = "" Тогда
		ПредставлениеОтбора = Нстр("ru = 'Нет'");
	Иначе
		ПредставлениеОтбора = Нстр("ru = 'Установлен отбор'");
	КонецЕсли;	
	
	Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.Отборы = СтрукутраОтборов;
	Элементы.ПоказателиПоГруппамДерево.ТекущиеДанные.ПредставлениеОтбора = ПредставлениеОтбора;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтборПоказателей(Команда)
	
	МассивПоказателей = Новый Массив;
	
	Для Каждого ВыдСтрока Из Элементы.ПоказателиПоГруппамДерево.ВыделенныеСтроки Цикл		
		ТекСтрока = ПоказателиПоГруппам.НайтиПоИдентификатору(ВыдСтрока);	
		Если ЗначениеЗаполнено(ТекСтрока.ПоказательОтчета) Тогда 
			МассивПоказателей.Добавить(ТекСтрока.ПоказательОтчета);
		КонецЕсли;	
	КонецЦикла;	
		
	СтруктураПараметров = ПодготовитьТаблицуОтборовПоказателей(МассивПоказателей);
	
	ПараметрыФормы = Новый Структура("Бланк,ГрупповойРежим,ТзРасшифровкаОтборовАдрес,ТЗРасшифровкаОтборовГруппРаскрытия,ОтображатьСуммуВДопВалюте"
	,Неопределено
	,Истина
	,СтруктураПараметров.ТзРасшифровкаОтборов
	,СтруктураПараметров.ТЗРасшифровкаОтборовГруппРаскрытия
	,СтруктураПараметров.ОтображатьСуммуВДопВалюте);	  	
	
	 Оповещение = Новый ОписаниеОповещения("ФормаРедактированияОтборовМассивЗавершение", ЭтаФорма);
		 
	 ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаРедактированияОтборов", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		 	 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаРедактированияОтборовМассивЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ВыдСтрока Из Элементы.ПоказателиПоГруппамДерево.ВыделенныеСтроки Цикл		
		ТекСтрока = ПоказателиПоГруппам.НайтиПоИдентификатору(ВыдСтрока);	
		СтрукутраОтборов = ЗаписатьОтборСервер(Результат.АдресРезультатаРедактирования);
		
		Если СтрукутраОтборов = "" Тогда
			ПредставлениеОтбора = Нстр("ru = 'Нет'");
		Иначе
			ПредставлениеОтбора = Нстр("ru = 'Установлен отбор'");
		КонецЕсли;	
		
		ТекСтрока.Отборы 				= СтрукутраОтборов;
		ТекСтрока.ПредставлениеОтбора 	= ПредставлениеОтбора;
			
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиОтчетаПослеУдаления(Элемент)
	
	//Удалим источник из таблицы кэшей
	УдаляемыеСтроки  = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИсточникПредставление",УдаляемыйИсточникПоказатель));
	
	МассивУдаляемыхСтрок = Новый Массив;
	Для Каждого СтрокаТаблицы Из УдаляемыеСтроки Цикл 
		МассивУдаляемыхСтрок.Добавить(СтрокаТаблицы);
	КонецЦикла;	  
	
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхСтрок Цикл 
		КэшДоступныхИзмеренийИРесурсов.Удалить(СтрокаТаблицы);
	КонецЦикла;

	МассивУдаляемыхИзмерений 	= Новый Массив;
	МассивУдаляемыхРесурсов 	= Новый Массив;
	//Удалим источник из таблицы измерений
	Для Каждого СтрокаИзмерение Из ИзмеренияИсточниковСвернутые Цикл
		
		МассивУдаляемыхЭлементовСписка = Новый Массив;
		Для Каждого СтрИсточникИзСписка Из СтрокаИзмерение.СписокИсточников Цикл 
			Если НЕ СтрИсточникИзСписка.Значение.Получить(УдаляемыйИсточникПоказатель) = Неопределено Тогда	
				МассивУдаляемыхЭлементовСписка.Добавить(СтрИсточникИзСписка);
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Эл Из МассивУдаляемыхЭлементовСписка Цикл
			СтрокаИзмерение.СписокИсточников.Удалить(Эл)
		КонецЦикла;	
		
		Если КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("ИмяВКубе,ЭтоРесурс",СтрокаИзмерение.ИмяВКубе,Ложь)).Количество()=0 Тогда
			МассивУдаляемыхИзмерений.Добавить(СтрокаИзмерение);
		КонецЕсли;	
		
	КонецЦикла;	
	
	//Удалим источник из таблицы ресурсов
	Для Каждого СтрокаРесурс Из РесурсыИсточниковСвернутые Цикл
		
		МассивУдаляемыхЭлементовСписка = Новый Массив;
		Для Каждого СтрИсточникИзСписка Из СтрокаРесурс.СписокИсточников Цикл 
			Если НЕ СтрИсточникИзСписка.Значение.Получить(УдаляемыйИсточникПоказатель) = Неопределено Тогда	
				МассивУдаляемыхЭлементовСписка.Добавить(СтрИсточникИзСписка);
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Эл Из МассивУдаляемыхЭлементовСписка Цикл
			СтрокаРесурс.СписокИсточников.Удалить(Эл)
		КонецЦикла;	
		
		Если КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("Путь,ЭтоРесурс",СтрокаРесурс.ПутьКРесурсу,Истина)).Количество()=0 Тогда
			МассивУдаляемыхРесурсов.Добавить(СтрокаРесурс);
		КонецЕсли;
		
	КонецЦикла;	

		
	//Проверим - если в кэше не осталось записей по измерениям и ресурсам - удалим их из текущих таблиц
	//Удалим источник из таблицы измерений
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхИзмерений Цикл 
		ИзмеренияИсточниковСвернутые.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из МассивУдаляемыхРесурсов Цикл 
		РесурсыИсточниковСвернутые.Удалить(СтрокаТаблицы);
	КонецЦикла;

	
	УправлениеФормойСервер();

КонецПроцедуры


&НаСервере
Функция ЗаписатьОтборСервер(АдресРезультатаРедактирования)
	
	Если ТипЗнч(АдресРезультатаРедактирования) = Тип("ТаблицаЗначений") Тогда
		РасшифровкаОтборов   		=	АдресРезультатаРедактирования;
		ОтображатьСуммуВДопВалюте   =   Ложь;
	Иначе
		РасшифровкаОтборов   =  ПолучитьИзВременногоХранилища(АдресРезультатаРедактирования.ОтборыГруппы);
		ОтображатьСуммуВДопВалюте = АдресРезультатаРедактирования.ОтображатьСуммуВДопВалюте;
	КонецЕсли;	
	
	РасшифровкаГруппОтборов = Новый Структура;
	//Формируем таблицу отборов для ячейки - сохраняем тлько отборы отличные от дефолтных...
	Для Каждого тОтбор Из РасшифровкаОтборов Цикл		
		Если НЕ (АналитическийБланкГенерацияМакетаУХСервер.ПроверитьЭтоСтандартныйОтбор(тОтбор)) И тОтбор.Использовать  Тогда
			АналитическийБланкГенерацияМакетаУХСервер.СформироватьСтрокуОтбора(РасшифровкаГруппОтборов,тОтбор);	
		КонецЕсли;				
	КонецЦикла;	

	Если РасшифровкаГруппОтборов.Количество() = 0 И НЕ ОтображатьСуммуВДопВалюте Тогда
		ПредставлениеОтбора = Нстр("ru = 'Нет'");
		Возврат "";	
	Иначе	
		СтрукутраОтвета = Новый Структура;
		СтрукутраОтвета.Вставить("ОтображатьСуммуВДопВалюте",ОтображатьСуммуВДопВалюте);
		СтрукутраОтвета.Вставить("РасшифровкаГруппОтборов",РасшифровкаГруппОтборов);
		СтрукутраОтвета.Вставить("ПредставлениеОтбора",ПредставлениеОтбора);
				
		Возврат ЗначениеВстрокуВнутр(СтрукутраОтвета);
		
	КонецЕсли;	
		
КонецФункции	

&НаСервере
Функция ПодготовитьТаблицуОтборовПоказателей(Показатели,РасшифровкаОтборовСтрока = "") Экспорт
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	ТЗРасшифровкаОтборов = ОбъектАБ.РасшифровкаГруппОтборов.Выгрузить();
	ТЗРасшифровкаОтборовГруппРаскрытия = ТЗРасшифровкаОтборов.СкопироватьКолонки();
	
	СтруктураЗначенийПоказателей = Новый Структура;
	
	Для Каждого СтрПоказатель Из Показатели Цикл 
		СтруктураЗначенийПоказателей.Вставить(СокрЛП(СтрПоказатель.Код),СтрПоказатель);
	КонецЦикла;
	
	Обработки.АналитическийБланк.ЗполнитьПервоначальныйКэшОтборов(ТЗРасшифровкаОтборов,"");	

	АналитическийБланкГенерацияМакетаУХСервер.ДополнитьОтборыАналитикамиРаскрытия(СтруктураЗначенийПоказателей,ТЗРасшифровкаОтборов);
	
	Если НЕ РасшифровкаОтборовСтрока = "" Тогда
		СтруктураРасшифровки = ЗначениеИзСтрокиВнутр(РасшифровкаОтборовСтрока);
		Если СтруктураРасшифровки.Свойство("РасшифровкаГруппОтборов") Тогда
			
			Для Каждого СтрОтбор Из СтруктураРасшифровки.РасшифровкаГруппОтборов Цикл		 
				
				НстрОтборов =  ТЗРасшифровкаОтборов.НайтиСтроки(Новый Структура("ПолеКод",СтрОтбор.Ключ));
				
				Если НстрОтборов.Количество() = 1 Тогда
					СтрОтборСвойства = АналитическийБланкГенерацияМакетаУХСервер.ПрочитатьСтрокуОтборов(СтрОтбор);
					ЗаполнитьЗначенияСвойств(НстрОтборов[0],СтрОтборСвойства);	 				
					НстрОтборов[0].Отбор = ?(ЗначениеЗаполнено(СтрОтборСвойства.Отбор),ЗначениеИзСтрокиВнутр(СтрОтборСвойства.Отбор),Неопределено);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;	 
		
		Если СтруктураРасшифровки.Свойство("РасшифровкаОтборов") Тогда
			ОтображатьСуммуВДопВалюте = СтруктураРасшифровки.ОтображатьСуммуВДопВалюте;
		Иначе	
			ОтображатьСуммуВДопВалюте = Ложь;
		КонецЕсли;
			
	КонецЕсли;
	

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТЗРасшифровкаОтборов",ПоместитьВоВременноеХранилище(ТЗРасшифровкаОтборов,Новый УникальныйИдентификатор()));
    СтруктураВозврата.Вставить("ТЗРасшифровкаОтборовГруппРаскрытия",ПоместитьВоВременноеХранилище(ТЗРасшифровкаОтборовГруппРаскрытия,Новый УникальныйИдентификатор()));
	СтруктураВозврата.Вставить("ОтображатьСуммуВДопВалюте",ОтображатьСуммуВДопВалюте);
	
	Возврат СтруктураВозврата;
		
КонецФункции	


#КонецОбласти

 #Область ОбработчикиСобытийЭлементовФормыИсточники
 
 &НаКлиенте
Процедура ИсточникиДанныхПриИзменении(Элемент)
	
