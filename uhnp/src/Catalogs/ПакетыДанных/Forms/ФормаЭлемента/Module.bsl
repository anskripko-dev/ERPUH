				Измерение.ПутьКИзмерению         =  СтрокаИсточника.Путь;
			Иначе	
				Измерение = тИзмерение[0];
				ОбновитьСписокИсточниковПоля(Измерение,СтрокаИсточника);
								
			КонецЕсли;				
		КонецЦикла;		
			
		Источник = КэшДоступныхИзмеренийИРесурсов.НайтиСтроки(Новый Структура("Источник,ЭтоРесурс",НовыйИсточник,Истина));
		
		Для Каждого СтрокаИсточника Из Источник Цикл
			
			тРесурс = РесурсыИсточниковСвернутые.НайтиСтроки(Новый Структура("ПредставлениеРесурса,ТипЗначенияСтрока",СтрокаИсточника.СинонимПоля,СтрокаИсточника.ТипЗначенияСтрока));
			
			Если тРесурс.Количество() = 0 Тогда
				Ресурс = РесурсыИсточниковСвернутые.Добавить();
				ЗаполнитьЗначенияСвойств(Ресурс,СтрокаИсточника);
				ОбновитьСписокИсточниковПоля(Ресурс,СтрокаИсточника);
				
				Ресурс.ПредставлениеРесурса =  СтрокаИсточника.СинонимПоля;
				Если  СтрокаИсточника.ЭтоПоказательОтчета Тогда
					Ресурс.ИмяВКубе 			=  СформироватьКодНаОснованииНаименования(СтрокаИсточника.ИсточникПредставление);
					Ресурс.ПутьКРесурсу 		=  СтрокаИсточника.Путь;			
				КонецЕсли;
				
			Иначе	
				Ресурс = тРесурс[0];
				ОбновитьСписокИсточниковПоля(Ресурс,СтрокаИсточника);		
			КонецЕсли;				
			
		КонецЦикла;	
		

		
КонецПроцедуры	



&НаСервере
Процедура ОбновитьСписокИсточниковПоля(ТекущаяСтрокаТаблицы,СтрокаИсточника)
	
	СооствествиеИсточникаПути = Новый Соответствие;
	СооствествиеИсточникаПути.Вставить(СтрокаИсточника.ИсточникПредставление,СтрокаИсточника.Путь);
	ТекущаяСтрокаТаблицы.СписокИсточников.Добавить(СооствествиеИсточникаПути,"["+СтрокаИсточника.ИсточникПредставление+"]."+СтрокаИсточника.Путь);
			
КонецПроцедуры	


#КонецОбласти

  

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ОбновитьКэшДоступныхИзмеренийИРесурсов(ДобавленныеИсточники=Неопределено,УдаленныеИсточники = Неопределено)
	
	Если ДобавленныеИсточники = Неопределено 
		И УдаленныеИсточники = Неопределено Тогда 
		КэшДоступныхИзмеренийИРесурсов.Очистить();
		ОбновитьДоступныеИзмеренияИРесурсы();
	
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступныеИзмеренияИРесурсы()
	
		
	ТзСвойстваПоказателей 	= АналитическийБланкГенерацияМакетаУХСервер.ПолучитьСвойстваВыбранныхПоказателей(Объект.ПоказателиОтчета.Выгрузить().ВыгрузитьКолонку("ПоказательОтчета"));
	
	Для Каждого СтрИсточникПоказатель Из Объект.ПоказателиОтчета Цикл
		
		ДобавитьИзмерениеПоОписанию(СтрИсточникПоказатель.ПоказательОтчета,СтрИсточникПоказатель.Представление,"ПоказательОтчета","ПоказательОтчета","СправочникСсылка.ПоказателиОтчетов","Показатель отчета",1);
		
		ДобавитьИзмерениеПоОписанию(СтрИсточникПоказатель.ПоказательОтчета,СтрИсточникПоказатель.Представление,"Сценарий","Сценарий","СправочникСсылка.Сценарии","Сценарий",2);

		ДобавитьИзмерениеПоОписанию(СтрИсточникПоказатель.ПоказательОтчета,СтрИсточникПоказатель.Представление,"ПериодОтчета","ПериодОтчета","СправочникСсылка.Периоды","Период отчета",3);
		
		ДобавитьИзмерениеПоОписанию(СтрИсточникПоказатель.ПоказательОтчета,СтрИсточникПоказатель.Представление,"Организация","Организация","СправочникСсылка.Организации","Организация",4);
		
		ДобавитьИзмерениеПоОписанию(СтрИсточникПоказатель.ПоказательОтчета,СтрИсточникПоказатель.Представление,"Проект","Проект","СправочникСсылка.Проекты","Проект",5);

		СтрСвойство = ТзСвойстваПоказателей.Найти(СтрИсточникПоказатель.ПоказательОтчета,"Ссылка");
		
		//добавляем аналитики - измерения
		Для Инд =1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
			Если ЗначениеЗаполнено(СтрСвойство["ВОВидАналитики"+Инд]) Тогда
				
				ДобавитьИзмерениеПоОписанию(СтрСвойство.Ссылка
				,СтрИсточникПоказатель.Представление
				,
				,СтрСвойство["ВОВидАналитики"+Инд].Код
				,Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(СтрСвойство["ВОВидАналитики"+Инд])
				,Строка(СтрСвойство["ВОВидАналитики"+Инд]));

				
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтрСвойство["ГруппаРаскрытияВидАналитики"+Инд]) Тогда
				
				ДобавитьИзмерениеПоОписанию(СтрСвойство.Ссылка
				,СтрИсточникПоказатель.Представление
				,
				,СтрСвойство["ГруппаРаскрытияВидАналитики"+Инд].Код
				,Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(СтрСвойство["ГруппаРаскрытияВидАналитики"+Инд])
				,Строка(СтрСвойство["ГруппаРаскрытияВидАналитики"+Инд]));			
				
			КонецЕсли;	
			
		КонецЦикла;
		
		
		нРесурс 								= КэшДоступныхИзмеренийИРесурсов.Добавить();
		
		нРесурс.ИмяВКубе 	 					= "Значение";
		нРесурс.ТипЗначенияСтрока  				= Строка(СтрСвойство.ТипЗначения);
		нРесурс.Путь 							= "Значение";
		нРесурс.СинонимПоля 					= "Значение";
		нРесурс.Источник  						= СтрИсточникПоказатель.ПоказательОтчета;
		нРесурс.ИсточникПредставление 			= СтрИсточникПоказатель.Представление;	
		нРесурс.ЭтоРесурс 						= Истина;	
		нРесурс.ПриоритетСортировки  			= 1;
	    нРесурс.ЭтоПоказательОтчета 			= Истина;
        нРесурс.КолонкаОтчета                   = СтрСвойство.Колонка;
		
	КонецЦикла;	
	
	
	Для Каждого СтрИсточник Из Объект.ИсточникиДанных Цикл
		
		//добавляем аналитики - измерения
		Если НЕ ЗначениеЗаполнено(СтрИсточник.Источник) Тогда
			 Продолжить;
		КонецЕсли;	
		
		
		ИсточникОбъект = СтрИсточник.Источник.ПолучитьОбъект();
		ИсточникОбъект.ПодготовитьТаблицыСопоставленийИОтборов();
		
		//Измерения
		//Для Каждого ИсточникИзмерение Из ИсточникОбъект.мТаблицаПоказателейБД Цикл
		Для Каждого ВыбранноеИзмерение Из ИсточникОбъект.ТаблицаСоответствияБД Цикл		
			
			Если НЕ ВыбранноеИзмерение.Сопоставлено Тогда
				 Продолжить;
			КонецЕсли;	
			
			ИсточникИзмерение = ИсточникОбъект.мТаблицаПоказателейБД.Найти(ВыбранноеИзмерение.ПолеБД,"ПолеБД");
			
			Если ИсточникИзмерение = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			ТипыЗначения = ИсточникИзмерение.ТипДанныхПоля.ВыгрузитьЗначения();
			
			Если ТипыЗначения.Количество() = 0 Тогда
				//попробуем вытищить тип из настройки соответствия
				Если ЗначениеЗаполнено(ВыбранноеИзмерение.НастройкаСоответствия) Тогда
					 ОписаниеТипов = Новый ОписаниеТипов(ВыбранноеИзмерение.НастройкаСоответствия.ТипОбъектаКонсолидации+"Ссылка."+ВыбранноеИзмерение.НастройкаСоответствия.ОписаниеОбъектаТек.ИмяОбъектаМетаданных);		
                Иначе
					Продолжить;
				КонецЕсли;	
			Иначе	
				ОписаниеТипов = Новый ОписаниеТипов(ТипыЗначения);
				Если ОписаниеТипов.СодержитТип(Тип("Число"))  
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Строка"))
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Дата"))
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
					Продолжить;
				КонецЕсли;		
			КонецЕсли;	
			
			
			нИзмерение 							= КэшДоступныхИзмеренийИРесурсов.Добавить();
			нИзмерение.Источник 				= СтрИсточник.Источник;;
			нИзмерение.Путь  					= ИсточникИзмерение.ПолеБД;
			нИзмерение.ИсточникПредставление 	= Строка(СтрИсточник.Источник);
			
			
			Если  ИсточникОбъект.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета Тогда
				Если ИсточникИзмерение.ПолеБД 	 		= "Версия.Организация" Тогда
					нИзмерение.СинонимПоля 	 			= "Организация";
				ИначеЕсли  ИсточникИзмерение.ПолеБД 	= "Версия.Сценарий" Тогда
					нИзмерение.СинонимПоля 	 			= "Сценарий";
				Иначе	
					нИзмерение.СинонимПоля 	 			= ИсточникИзмерение.НаименованиеБД;					
				КонецЕсли;
			Иначе	
				нИзмерение.СинонимПоля 	 			= ИсточникИзмерение.НаименованиеБД;		
			КонецЕсли;
			
			нИзмерение.ИмяВКубе 	 			= СформироватьКодНаОснованииНаименования(нИзмерение.СинонимПоля);
			нИзмерение.ТипЗначенияСтрока  		= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(ОписаниеТипов);		
			нИзмерение.ЭтоРесурс            	= Ложь;
			
		КонецЦикла;	
		
		//Ресурсы
		Если ЗначениеЗаполнено(ИсточникОбъект.РесурсРегистра) Тогда
			
			нРесурс 								= КэшДоступныхИзмеренийИРесурсов.Добавить();
			нРесурс.Источник 						= СтрИсточник.Источник;
			нРесурс.ИсточникПредставление 			= Строка(СтрИсточник.Источник);		
			нРесурс.ИмяВКубе 	 					= Строка(ИсточникОбъект.РесурсРегистра);
			нРесурс.СинонимПоля 	 				= Строка(ИсточникОбъект.РесурсРегистра);	
			нРесурс.Путь 	 						= "Значение";
			нРесурс.ТипЗначенияСтрока 				= Строка(ИсточникОбъект.ТипЗначения);
			нРесурс.ЭтоРесурс            			= Истина;
			
		ИначеЕсли ИсточникОбъект.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета 
			ИЛИ ИсточникОбъект.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета Тогда
			
			нРесурс 								= КэшДоступныхИзмеренийИРесурсов.Добавить();
			нРесурс.Источник 						= СтрИсточник.Источник;
			нРесурс.ИсточникПредставление 			= Строка(СтрИсточник.Источник);		
			нРесурс.ИмяВКубе 	 					= "Значение";
			нРесурс.СинонимПоля 	 				= "Значение";	
			нРесурс.Путь 	 						= "Значение";
			нРесурс.ТипЗначенияСтрока 				= Строка(ИсточникОбъект.ТипЗначения);
			нРесурс.ЭтоРесурс            			= Истина;
			
		Иначе	
			
			//Если ресурсы не определены явно, то получим их из простых полей
			Для Каждого ИсточникИзмерение Из ИсточникОбъект.мТаблицаПоказателейБД Цикл
				
				Если НЕ ИсточникИзмерение.Измерение Тогда
					Продолжить;
				КонецЕсли;	
				
				ТипыЗначения = ИсточникИзмерение.ТипДанныхПоля.ВыгрузитьЗначения();
				ОписаниеТипов = Новый ОписаниеТипов(ТипыЗначения);
				Если ОписаниеТипов.СодержитТип(Тип("Число"))  
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Строка"))
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Дата"))
					ИЛИ ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
									
					нРесурс 								= КэшДоступныхИзмеренийИРесурсов.Добавить();
					нРесурс.Источник 						= СтрИсточник.Источник;
					нРесурс.ИсточникПредставление 			= Строка(СтрИсточник.Источник);	
					нРесурс.Путь  							= ИсточникИзмерение.ПолеБД;
					нРесурс.ИмяВКубе 	 					= СформироватьКодНаОснованииНаименования(ИсточникИзмерение.НаименованиеБД);		
					нРесурс.СинонимПоля 	 				= ИсточникИзмерение.НаименованиеБД;		
					нРесурс.ТипЗначенияСтрока  				= Обработки.АналитическийБланкСводнаяТаблица.ПолучитьТипЗначенияАналитики(ОписаниеТипов);		
					нРесурс.ЭтоРесурс            			= Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьИзмерениеПоОписанию(Источник,ИсточникПредставление,ИмяВКубе=Неопределено,Путь,ТипЗначенияСтрока,СинонимПоля,ПриоритетСортировки=10)
	
	
	нИзмерение 						= КэшДоступныхИзмеренийИРесурсов.Добавить();
	Если ИмяВКубе = Неопределено Тогда
		нИзмерение.ИмяВКубе 	 		= СформироватьКодНаОснованииНаименования(СинонимПоля);
	Иначе
		нИзмерение.ИмяВКубе 	 		= ИмяВКубе;
	КонецЕсли;
	нИзмерение.ТипЗначенияСтрока  	= ТипЗначенияСтрока;
	нИзмерение.Путь 				= Путь;
	нИзмерение.СинонимПоля 			= СинонимПоля;
	нИзмерение.Источник  			= Источник;	
	нИзмерение.ИсточникПредставление 			= ИсточникПредставление;
	нИзмерение.ПриоритетСортировки  			= ПриоритетСортировки;
	
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ИзмеренияСинонимПоляПриИзменении(Элемент)
		
	Элементы.Измерения.ТекущиеДанные.ИмяВКубе =
		СформироватьКодНаОснованииНаименования(Элементы.Измерения.ТекущиеДанные.СинонимПоля);
					
КонецПроцедуры  

&НаСервереБезКонтекста
Функция СформироватьКодНаОснованииНаименования(СинонимПоля) 
	
	Возврат ОбщегоНазначенияУХ.СформироватьКодНаОснованииНаименования(СинонимПоля,100);
	
КонецФункции	

&НаСервере
Процедура ОбновитьТаблицуСвернутыхРесурсов()
	
	РесурсыИсточниковСвернутые.Очистить();
	
	Для Каждого СтрРесурс Из Объект.Ресурсы Цикл
		
		СуществющиеРесурсы = РесурсыИсточниковСвернутые.НайтиСтроки(Новый Структура("ПредставлениеРесурса",СтрРесурс.СинонимПоля));
		Если  СуществющиеРесурсы.Количество()=0 Тогда
			СтрокаСтрРесурс = РесурсыИсточниковСвернутые.Добавить();	
			СтрокаСтрРесурс.ПредставлениеРесурса = СтрРесурс.СинонимПоля;
			СтрокаСтрРесурс.Использовать = Истина;
		Иначе	
			СтрокаСтрРесурс = СуществющиеРесурсы[0];	
		КонецЕсли;	
		
		//СтрокаСтрРесурс.СписокИсточников.Добавить(СтрРесурс.ИсточникПредставление);
		СооствествиеИсточникаПути = Новый Соответствие;
		СооствествиеИсточникаПути.Вставить(СтрРесурс.ИсточникПредставление,СтрРесурс.ПутьКРесурсу);
		СтрокаСтрРесурс.СписокИсточников.Добавить(СооствествиеИсточникаПути,"["+СтрРесурс.ИсточникПредставление+"]."+СтрРесурс.ПутьКРесурсу);
		
		СтрокаСтрРесурс.ПутьКРесурсу = СтрРесурс.ПутьКРесурсу;
		СтрокаСтрРесурс.ТипЗначенияСтрока = СтрРесурс.ТипЗначенияСтрока;
		СтрокаСтрРесурс.ИмяВКубе = СтрРесурс.ИмяВКубе;
		СтрокаСтрРесурс.ПриоритетСортировки = СтрРесурс.ПриоритетСортировки;

		
	КонецЦикла;	

	РесурсыИсточниковСвернутые.Сортировать("ПриоритетСортировки,ПредставлениеРесурса");


КонецПроцедуры	

&НаКлиенте
Процедура РасширеннаяНастройкаПриИзменении(Элемент)
	УправлениеФормойСервер();
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	УправлениеФормойСервер();
КонецПроцедуры

&НаКлиенте
Процедура ГруппировкаРесурсовПоказателейПриИзменении(Элемент)
		
	Если Объект.Ресурсы.Количество() = 0 Тогда
		ЗаполнитьИзмеренияИРесурсыСервер(,2);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьРесурсыЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Состав ресурсов будет перезаполнен автоматически, продолжить?'"), РежимДиалогаВопрос.ДаНет);
        Возврат;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИсточник(Команда)
	
	Оповещение 		= Новый ОписаниеОповещения("ВыборИсточникаЗавершение", ЭтаФорма);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПотребительРасчета",Объект.Ссылка);
	
	ОткрытьФорму("Справочник.ИсточникиДанныхДляРасчетов.ФормаВыбора", Новый Структура("РежимВыбора,Отбор", Истина,ПараметрыОтбора), ЭтаФорма,,,,Оповещение);	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИсточникаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ИсточникиДанных.НайтиСтроки(Новый Структура("Источник",Результат)).Количество()>0 Тогда
		 Возврат;
	КонецЕсли;	
	
	нСтр = Объект.ИсточникиДанных.Добавить();
	нСтр.Источник = Результат;
		
	ОбновитьКэшДоступныхИзмеренийИРесурсов();
	ОбновитьСвернутыеИзмеренияИРесурсыПоИсточникуСервер(Результат);	
	УправлениеФормойСервер();

КонецПроцедуры
	

&НаКлиенте
Процедура ИсточникиДанныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ИсточникиДанныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле.Имя = "ИсточникиДанныхИсточник" Тогда
		
		ОткрытьЗначение(Элементы.ИсточникиДанных.ТекущиеДанные.Источник);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИсточник1САналитика(Команда)
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Пакет",Объект.Ссылка);
	ПараметрыФормы.Вставить("ИмяИсточника",Объект.Аналитика_ИмяИсточника);
    ПараметрыФормы.Вставить("ПредставлениеИсточника",Объект.Аналитика_ПредставлениеИсточника);
	
	Оповещение 		= Новый ОписаниеОповещения("ЭкспортАналитикаЗавершение", ЭтаФорма);
	ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаЭкспортаВАналитику",ПараметрыФормы, ЭтаФорма,,,,Оповещение);	
	
	
КонецПроцедуры  

&НаКлиенте
Процедура ЭкспортАналитикаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
		
КонецПроцедуры


