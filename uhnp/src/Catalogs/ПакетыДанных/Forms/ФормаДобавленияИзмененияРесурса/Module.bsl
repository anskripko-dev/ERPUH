
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ДоступныеИсточникиАдрес 	= Параметры.ДоступныеИсточникиАдрес;	
	Если НЕ Параметры.ТекущиеРесурсы = Неопределено  Тогда
		ТекущиеРесурсы.ЗагрузитьЗначения(Параметры.ТекущиеРесурсы);	
	КонецЕсли;
	
	ЗаголовокРесурса 			= Параметры.ВыбранныйРесурс;	
	ИсходныйЗаголовокРесурса    = Параметры.ВыбранныйРесурс;	
	ТипЗначенияРесурса  		= Параметры.ТипЗначенияРесурса;	
	СписокИсточников 			= Параметры.ВыбранныеИсточники;
	СписокГруппПоказателей      = Параметры.СписокГруппПоказателей;
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	Если Не ЗначениеЗаполнено(ЗаголовокРесурса) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен заголовок ресурса'"),,"ЗаголовокРесурса");		
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущиеРесурсы.НайтиПоЗначению(ЗаголовокРесурса) = Неопределено 
		И ЗаголовокРесурса<>ИсходныйЗаголовокРесурса Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ресурс с таким именем уже существует, введите другое имя'"),,"ЗаголовокРесурса");		
		Возврат;
	КонецЕсли;

	
	Если СписокИсточников.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбраны источники для ресурса'"),,"СписокИсточников");		
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ЗаголовокРесурса,СписокИсточников,ТипЗначенияРесурса"
	,ЗаголовокРесурса
	,СписокИсточников
	,ТипЗначенияРесурса));
	
КонецПроцедуры

&НаКлиенте
Процедура СписокИсточниковНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ДоступныеИсточникиАдрес,ВыбранныеИсточники,СписокГруппПоказателей"
	,ДоступныеИсточникиАдрес
	,СписокИсточников
	,СписокГруппПоказателей);	   	
	
	Оповещение = Новый ОписаниеОповещения("ФормаРедактированияИстчниковРесурсовЗавершение", ЭтаФорма);
	
	ОткрытьФорму("Справочник.ПакетыДанных.Форма.ФормаРедактированияСпискаИсточников", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаРедактированияИстчниковРесурсовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
			 	
	СписокИсточников = Результат;	
	
	ТипЗначенияРесурса =  ПолучитьТипЗначенияПоИсточникам(Результат);
		
КонецПроцедуры

&НаСервере
Функция ПолучитьТипЗначенияПоИсточникам(СписокИсточников)
	
	ДоступныеИсточники = ПолучитьИзВременногоХранилища(Параметры.ДоступныеИсточникиАдрес);
	
	МассивТипов = Новый Массив();
	Для Каждого СтрЗначение Из СписокИсточников Цикл
		Для Каждого СтрПредставление Из СтрЗначение.Значение Цикл
			тИсточник = ДоступныеИсточники.НайтиСтроки(Новый Структура("ИсточникПредставление",СтрПредставление.Ключ));
			Если МассивТипов.Найти(тИсточник[0].ТипЗначенияСтрока) = Неопределено Тогда
				МассивТипов.Добавить(тИсточник[0].ТипЗначенияСтрока);
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
	
	Возврат СтрСоединить(МассивТипов,";");
	
КонецФункции	




