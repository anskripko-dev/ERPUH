
&НаКлиенте
Процедура Применить(Команда)
	
	
	СписокВыбранныхИсточников = Новый СписокЗначений;
		
	Для Каждого СтрГруппа Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
		
		Для Каждого СтрПоказатель Из СтрГруппа.ПолучитьЭлементы() Цикл
			
			Если СтрПоказатель.Использование = 1 Тогда
				
				СооствествиеИсточникаПути = Новый Соответствие;
				СооствествиеИсточникаПути.Вставить(СтрПоказатель.Представление,СтрПоказатель.Путь);
				СписокВыбранныхИсточников.Добавить(СооствествиеИсточникаПути,СтрПоказатель.ПолныйПутькДанным)
						
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;	
	
	
	Закрыть(СписокВыбранныхИсточников);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 
	ДоступныеИсточники 		= ПолучитьИзВременногоХранилища(Параметры.ДоступныеИсточникиАдрес);
	ВыбранныеИсточники 		= Параметры.ВыбранныеИсточники;
	СписокГруппПоказателей 	= Параметры.СписокГруппПоказателей;
	
	Для Каждого Группа Из СписокГруппПоказателей Цикл
		
		нСтрДерево 						=  ПоказателиПоГруппам.ПолучитьЭлементы().Добавить();
		нСтрДерево.ИндексКартинки 		= 1;
		нСтрДерево.Представление 		= Группа.Значение;
		нСтрДерево.ПолныйПутькДанным 	= Группа.Значение;
	
		ДоступныеИсточникиГруппы = ДоступныеИсточники.НайтиСтроки(Новый Структура("ГруппаПоказателей",Группа.Значение));
		
		Для Каждого Источник Из ДоступныеИсточникиГруппы Цикл
			нСтрПоказатель =  нСтрДерево.ПолучитьЭлементы().Добавить();
            нСтрПоказатель.ИндексКартинки = 2;
			нСтрПоказатель.Представление = Источник.ИсточникПредставление;
			нСтрПоказатель.ПолныйПутькДанным = "["+Источник.ИсточникПредставление+"]."+Источник.Путь;
            нСтрПоказатель.Использование = НайтиПоПредставлениюИсточника(ВыбранныеИсточники,нСтрПоказатель.ПолныйПутькДанным);	
            нСтрПоказатель.ПоказательОтчета  = Источник.Источник;		
			нСтрПоказатель.Путь              = Источник.Путь;
		КонецЦикла;	
	
			
	КонецЦикла;	
	
	
КонецПроцедуры

&НаСервере
Функция НайтиПоПредставлениюИсточника(ВыбранныеИсточники,ПредставлениеИсточника)
	
	Для Каждого СтрИсточник Из ВыбранныеИсточники Цикл
		
		Если СтрИсточник.Представление = ПредставлениеИсточника Тогда
			 Возврат Истина;
		КонецЕсли;	
		
	КонецЦикла;	
	
    Возврат Ложь;
	
КонецФункции	

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПоГруппамДеревоПриИзменении(Элемент)
	
	Если Элемент.ТекущийЭлемент.Имя = "ПоказателиПоГруппамДеревоИспользование" Тогда	
		тСтрока = ПоказателиПоГруппам.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);	
		Если тСтрока.Использование = 2 Тогда 
		     тСтрока.Использование = 0;
		КонецЕсли;	 
		
		Если Элемент.ТекущиеДанные.ИндексКартинки = 1 Тогда //Устанавливаем или снимаем все флаги у группы
			ОбойтиСтрокиРекурсивно(тСтрока,Элемент.ТекущиеДанные.Использование);
		Иначе	
			УстановитьФлагиПоГруппе(тСтрока.ПолучитьРодителя());
		КонецЕсли;	
					
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ОбойтиСтрокиРекурсивно(тСтрока,Флаг)
			
	тСтрока["Использование"] = Флаг;	
			
	Для Каждого тЭлемент Из тСтрока.ПолучитьЭлементы() Цикл	
		ОбойтиСтрокиРекурсивно(тЭлемент,Флаг);				
	КонецЦикла;	
		
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьФлагиПоГруппе(тСтрока)
	
	ЕстьИстина  = Ложь;
	ЕстьЛожь  	= Ложь;
	
	Для Каждого тЭлемент Из тСтрока.ПолучитьЭлементы() Цикл				
			
		Если тЭлемент.Использование = 1 Тогда
			ЕстьИстина  = Истина;
		ИначеЕсли тЭлемент.Использование = 0 Тогда
			ЕстьЛожь  	= Истина;
		КонецЕсли;	
			
	КонецЦикла;		
	
	Если ЕстьИстина
		И ЕстьЛожь Тогда
		тСтрока.Использование = 2;
	ИначеЕсли ЕстьИстина Тогда
		тСтрока.Использование = 1;
	ИначеЕсли ЕстьЛожь Тогда
		тСтрока.Использование = 0;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для Каждого СтрокаДерева Из ПоказателиПоГруппам.ПолучитьЭлементы() Цикл
		
		УстановитьФлагиПоГруппе(СтрокаДерева);
		
	КонецЦикла;	


КонецПроцедуры

