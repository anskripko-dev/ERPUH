#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция СформироватьСКДПоНаборуДанных(ОбъектИсточник) Экспорт
		
	МассивРесурсов = Новый Массив;
	ТипЧисло       = Тип("Число");
		
	СКД = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных             = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя         = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя            = "НаборДанных1";
	НаборДанных.ИмяОбъекта     = "ИсточникДанныхДляРасчетов";
	НаборДанных.ИсточникДанных = "ИсточникДанных";
	
	
	//Заполняем ресурсы 
	тУникальныхРесусов = ОбъектИсточник.Ресурсы.Выгрузить();
	тУникальныхРесусов.Свернуть("ИмяВКубе,СинонимПоля,ТипЗначенияСтрока");
	
	Для Каждого СтрРесурс Из тУникальныхРесусов Цикл
		
		ПолеИтога = СКД.ПоляИтога.Добавить();
		ПолеИтога.ПутьКДанным = СтрРесурс.ИмяВКубе;
		ПолеИтога.Выражение   = "СУММА(" + СтрРесурс.ИмяВКубе + ")";
		
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));

		Поле.Заголовок   = СтрРесурс.СинонимПоля;
		Поле.Поле        = СтрРесурс.ИмяВКубе;
		Поле.ПутьКДанным = СтрРесурс.ИмяВКубе;
		Поле.ТипЗначения = Новый ОписаниеТипов(СтрРесурс.ТипЗначенияСтрока);
		
	КонецЦикла;	
	
	//Заполняем ресурсы 
	тУникальныхАналитик = ОбъектИсточник.ИзмеренияИсточников.Выгрузить();
	тУникальныхАналитик.Свернуть("ИмяВКубе,СинонимПоля,ТипЗначенияСтрока");
	
	ЕстьИзмерениеПериодОтчета = Ложь;
	
	
	Для Каждого СтрРесурс Из тУникальныхАналитик Цикл
				
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));

		Поле.Заголовок   = СтрРесурс.СинонимПоля;
		Поле.Поле        = СтрРесурс.ИмяВКубе;
		Поле.ПутьКДанным = СтрРесурс.ИмяВКубе;
		
		ТипЗначенияСтроки = СтрРазделить(СтрРесурс.ТипЗначенияСтрока,"|");
		ТипЗначенияМассив  = Новый Массив;
		Для Каждого СтрТип Из ТипЗначенияСтроки Цикл
			ТипЗначенияМассив.Добавить(Тип(СтрТип));
		КонецЦикла;	
		
		
		Поле.ТипЗначения = Новый ОписаниеТипов(ТипЗначенияМассив);
		
		Если СтрРесурс.ИмявКубе  = "ПериодОтчета" 
			 И СтрРесурс.ТипЗначенияСтрока= "СправочникСсылка.Периоды" Тогда
			 ЕстьИзмерениеПериодОтчета = Истина;
		КонецЕсли;	

		
	КонецЦикла;	
	
	//Добавим специальное поле для нестандартной расшифровки источника 
	Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	
	Поле.Заголовок   =  Нстр("ru = 'Источник'");
	Поле.Поле        = "Источник";
	Поле.ПутьКДанным = "Источник";;
	Поле.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ИсточникиДанныхДляРасчетов");

		
	//Настройки схемы включаеют все поля и группирвку из одного уровня
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	Группировка = НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	
	Для Каждого СтрРесурс Из тУникальныхРесусов Цикл
		
		ВыбранноеПолеКомпоновкиДанных 				= НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВКубе);
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
		
		ВыбранноеПолеГрКомпоновкиДанных 				= Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеГрКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВКубе);
		ВыбранноеПолеГрКомпоновкиДанных.Использование = Истина;
				
	КонецЦикла;	
 
	Для Каждого СтрРесурс Из тУникальныхАналитик Цикл
		
		нПолеГруппировки 			= Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		нПолеГруппировки.Поле		= Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВКубе);	
		
		ВыбранноеПолеКомпоновкиДанных 				= НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВКубе);
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
		
		ВыбранноеПолеГрКомпоновкиДанных 				= Группировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));			
		ВыбранноеПолеГрКомпоновкиДанных.Поле 			= Новый ПолеКомпоновкиДанных(СтрРесурс.ИмяВКубе);
		ВыбранноеПолеГрКомпоновкиДанных.Использование = Истина;
				
	КонецЦикла;	

	//Если есть период отчета - добавим сортировку по ДатеНачала
	Если ЕстьИзмерениеПериодОтчета Тогда
		
		НовыйЭлементПорядка 					= НастройкиПоУмолчанию.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		НовыйЭлементПорядка.Поле 				= Новый ПолеКомпоновкиДанных("ПериодОтчета.ДатаНачала");		
		
	КонецЕсли;	
	
	Возврат СКД;
	
КонецФункции
	

#Область Интеграция_1САналитика

Функция ПолучитьТекстЗапроса1САналитика(ОбъектИсточник) Экспорт
	
	
	//Сгруппируем показатели по одинаковым группам отборов	
	глТекстЗапроса = "";
	
	ГруппыПоказателейСвернутоПоОтборам = ОбъектИсточник.ГруппыПоказателей.Выгрузить();
	ГруппыПоказателейСвернутоПоОтборам.Свернуть("ХэшОтборов");
	
	СтруктураРаскрываемыхАналитик  = Новый Структура;	
		
	Для Каждого СтрГруппаПоказателей Из ОбъектИсточник.ГруппыПоказателей  Цикл
		

		СоответствиеПолейИИзмерений = ЗначениеИзСтрокиВнутр(СтрГруппаПоказателей.СоответствиеПолейИИзмерений);

		Для Каждого СтрАналитика Из СоответствиеПолейИИзмерений Цикл
			
			СтрокаРесурса = ОбъектИсточник.ИзмеренияИсточников.Найти(СтрАналитика.Ключ,"ПутьКИзмерению");

			Если  СтрокаРесурса = Неопределено Тогда
				СтруктураРаскрываемыхАналитик.Вставить(СтрАналитика.Ключ);
			Иначе	
				СтруктураРаскрываемыхАналитик.Вставить(СтрАналитика.Ключ,СтрокаРесурса.ТипЗначенияСтрока);
			КонецЕсли;
			
		КонецЦикла;	
	КонецЦикла;

	
	
	Для Каждого СтрГруппаПоказателей Из ГруппыПоказателейСвернутоПоОтборам  Цикл
		
		МассивПоказателей = ОбъектИсточник.ПоказателиОтчета.Выгрузить(Новый Структура("ХэшОтборов",СтрГруппаПоказателей.ХэшОтборов)).ВыгрузитьКолонку("ПоказательОтчета");
			
		ДополнительныеПараметры        = Новый Структура;
        СтруктураОтбираемыхАналитик    = Новый Структура;		

		СтруктураОтбираемыхАналитик.Вставить("ХэшОтборов",СтрГруппаПоказателей.ХэшОтборов);
		СтруктураОтбираемыхАналитик.Вставить("ПоказательОтчета",МассивПоказателей);
		СтруктураОтбираемыхАналитик.Вставить("УидПакетаСтрока",ОбъектИсточник.УидПакетаСтрока);
	
		СтрГруппаПоказателейОтборы = ОбъектИсточник.ГруппыПоказателей.НайтиСтроки(Новый Структура("ХэшОтборов",СтрГруппаПоказателей.ХэшОтборов))[0].Отборы;			
			
		Если ЗначениеЗАполнено(СтрГруппаПоказателейОтборы) Тогда 
			ДополнительныйОтбор = Обработки.АналитическийБланк.ПолучитьОписаниеТаблицыТекущихОтборов();
			РасшифровкаОтборов = ЗначениеИзСтрокиВнутр(СтрГруппаПоказателейОтборы);
			
			Для Каждого СтрОтбор Из РасшифровкаОтборов.РасшифровкаГруппОтборов Цикл
				
				нДополнительныйОтбор 				= ДополнительныйОтбор.Добавить();
				нДополнительныйОтбор.ПолеКод      	= СтрОтбор.Ключ;
				РасшифровкаЗначенияОтбора           = АналитическийБланкГенерацияМакетаУХСервер.ПрочитатьСтрокуОтборов(СтрОтбор);
				
				нДополнительныйОтбор.ВидСравнения 	= ЗначениеИзСтрокиВнутр(РасшифровкаЗначенияОтбора.Отбор);				
				нДополнительныйОтбор.ЗначениеОтбора = ЗначениеИзСтрокиВнутр(РасшифровкаЗначенияОтбора.ЗначениеОтбораСтрока);	
				
				Если СтруктураОтбираемыхАналитик.Свойство(СтрОтбор.Ключ) Тогда
					СтруктураОтбираемыхАналитик.Удалить(СтрОтбор.Ключ);
				КонецЕсли;	
				
			КонецЦикла;
			
			ДополнительныеПараметры.Вставить("ДополнительныйФильтр",ДополнительныйОтбор);
		КонецЕсли;
			
		ТекстЗапроса = ПолучитьЗначениеПоказателейДляАналитики(СтруктураОтбираемыхАналитик,СтруктураРаскрываемыхАналитик,ДополнительныеПараметры);	
		Если глТекстЗапроса = "" Тогда
			глТекстЗапроса =  ТекстЗапроса;
		Иначе	
			глТекстЗапроса = глТекстЗапроса+"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|"+ТекстЗапроса;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого СтрПоле Из СтруктураРаскрываемыхАналитик Цикл 
		
		СтрокаРесурса = ОбъектИсточник.ИзмеренияИсточников.Найти(СтрПоле.Ключ,"ПутьКИзмерению");
		
		Если Не СтрокаРесурса = Неопределено Тогда
			
			глТекстЗапроса = СтрЗаменить(глТекстЗапроса,"КАК "+СтрПоле.Ключ,"КАК "+СтрокаРесурса.ИмяВКубе);
			
		КонецЕсли;	
		
	КонецЦикла;	
		
	Возврат глТекстЗапроса;
	
КонецФункции	

Функция ПолучитьЗначениеПоказателейДляАналитики(СтруктураПараметровОтбора,РаскрываемыеАналитики=Неопределено,ДополнительныеПараметры = Неопределено) Экспорт
	
	флОшибки 						= Ложь;
	СообщениеОбОшибки	 			= "";
	КэшПоказателей         			= Неопределено;
	КэшАналитик            			= Неопределено;
	
	СтруктураЗаменяемыхАналитик 	= Неопределено;
	ВОсновнойВалюте  				= Ложь;
	СдвигПоПериоду                  = 0;
	Периодичность                   = Неопределено;
	ЭтоНечисловые         			= Ложь;
	ДополнительныйФильтр            = Неопределено;
	
	Запрос                 			= Новый Запрос;
	СхемаЗапроса 					= Новый СхемаЗапроса;
	
	Если НЕ ТипЗнч(СтруктураПараметровОтбора) = Тип("Структура") Тогда
		флОшибки = Истина;
		СообщениеОбОшибки = НСтр("ru = 'Не задана структура отборов показателей'");
		ПротоколируемыеСобытияУХ.ДобавитьЗаписьОшибка("СводнаяТаблицаУХ.ПолучитьЗначениеПоказателей", , , СообщениеОбОшибки);
	КонецЕсли;
	
	МассивПоказателей = СтруктураПараметровОтбора.ПоказательОтчета;
		
	Если НЕ ДополнительныеПараметры = Неопределено Тогда	 
		Если ДополнительныеПараметры.Свойство("ВОсновнойВалюте") Тогда
			ВОсновнойВалюте = ДополнительныеПараметры.ВОсновнойВалюте;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("СдвигПоПериоду") Тогда
			СдвигПоПериоду = ДополнительныеПараметры.СдвигПоПериоду;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("Периодичность") Тогда
			Периодичность = ДополнительныеПараметры.Периодичность;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ЭтоНечисловые") Тогда
			ЭтоНечисловые = ДополнительныеПараметры.ЭтоНечисловые;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ДополнительныйФильтр") Тогда
			ДополнительныйФильтр = ДополнительныеПараметры.ДополнительныйФильтр;
		КонецЕсли;
			
	КонецЕсли;
	
	ТзАналитик = Новый ТаблицаЗначений;
	
	СтруктураПоиска 				= Новый Структура;
	СтруктураПараметровВерсии 		= Новый Структура;
	ОтборВерсий                     = Новый Структура;
	СтруктураПараметровВерсии.Вставить("ОтборВерсий",ОтборВерсий);
	СтруктураПараметровВерсии.Вставить("ВОсновнойВалюте",ВОсновнойВалюте);
	СтруктураПараметровВерсии.Вставить("СдвигПоПериоду",СдвигПоПериоду);
	СтруктураПараметровВерсии.Вставить("Периодичность",Периодичность);
	
	
	ДополнительныйОтбор = Новый Структура;
	Для Каждого Пар Из СтруктураПараметровОтбора Цикл
		
		Ключ = НРег(Пар.Ключ);
		Если Ключ = "сценарий" 
			ИЛИ Ключ = "организация"
			ИЛИ Ключ = "проект"
			ИЛИ Ключ = "периодотчета"
			ИЛИ Ключ = "валюта"  
			ИЛИ Ключ = "видотчета"
			ИЛИ Ключ = "показательотчета" Тогда
			Продолжить;
		КонецЕсли;
		
		ДополнительныйОтбор.Вставить(Пар.Ключ,Пар.Значение);
		
	КонецЦикла;
	
	РаскрываемыеАналитики_ = Новый ТаблицаЗначений;
	РаскрываемыеАналитики_.Колонки.Добавить("Ключ");
	РаскрываемыеАналитики_.Колонки.Добавить("ТипЗначенияСтрока");

	
	Нстр = РаскрываемыеАналитики_.Добавить();
	Нстр.Ключ = "Организация";	 
	Нстр = РаскрываемыеАналитики_.Добавить();
	Нстр.Ключ = "Проект";	 
	Нстр = РаскрываемыеАналитики_.Добавить();
	Нстр.Ключ = "Сценарий";
	Нстр = РаскрываемыеАналитики_.Добавить();
	Нстр.Ключ = "ПериодОтчета";
	Нстр = РаскрываемыеАналитики_.Добавить();
	Нстр.Ключ = "Валюта";
	
	Если Не РаскрываемыеАналитики=Неопределено Тогда	 
		Для Каждого Стр Из РаскрываемыеАналитики Цикл	 	 
			Если ВРЕГ(Стр.Ключ) = "АНАЛИТИКАВАЛЮТА" Тогда
				Нстр = РаскрываемыеАналитики_.Добавить();
				Нстр.Ключ = Стр.Ключ;
				Продолжить;	 
			КонецЕсли;	 
			Если ВРЕГ(Стр.Ключ) = "ВИДОТЧЕТА" Тогда
				Нстр = РаскрываемыеАналитики_.Добавить();
				Нстр.Ключ = Стр.Ключ;
				Продолжить;	 
			КонецЕсли;	  
			Если ВРЕГ(Лев(Стр.Ключ,9)) = "АНАЛИТИКА" Тогда
				ИндексАналитики = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Прав(Стр.Ключ,1));	
				Если ИндексАналитики = Неопределено ИЛИ ИндексАналитики>ПараметрыСеанса.ЧислоДопАналитик Тогда
					Продолжить;
				Иначе	
					Нстр = РаскрываемыеАналитики_.Добавить();
					Нстр.Ключ = Стр.Ключ;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ПВХзначение = ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.НайтиПоКоду(Стр.Ключ);
			Если ЗначениеЗаполнено(ПВХзначение) Тогда
				Нстр = РаскрываемыеАналитики_.Добавить();
				Нстр.Ключ = Стр.Ключ;
				Нстр.ТипЗначенияСтрока = Стр.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Для Каждого СтрДопОтбор Из ДополнительныйОтбор Цикл	 
	//	Если РаскрываемыеАналитики_.Найти(СтрДопОтбор.Ключ,"Ключ") = Неопределено Тогда
	//		Нстр = РаскрываемыеАналитики_.Добавить();
	//		Нстр.Ключ = СтрДопОтбор.Ключ;	 
	//	КонецЕсли;
	//КонецЦикла;
		
