
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ДоступныеЭтапыДоговора(Договор) Экспорт
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПустаяСсылка());
	КонецЕсли;
	
	Контекст = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Договор, "ВариантРаздельнойЗакупки");
		
	Если Не ЗначениеЗаполнено(Контекст.ВариантРаздельнойЗакупки) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПустаяСсылка());
	КонецЕсли;

	Возврат ДоступныеЭтапыВариантаЗакупки(Контекст.ВариантРаздельнойЗакупки);
	
КонецФункции

Функция ДоступныеЭтапыВариантаЗакупки(ВариантЗакупки) Экспорт

	Контекст = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ВариантЗакупки, "НакладнаяБезОрдера, ОрдерПередНакладной, НакладнаяПередОрдером");
		
	Результат = Новый Массив;
	
	Если Контекст.ОрдерПередНакладной Тогда
		Результат.Добавить(ОрдерПередНакладной);
		Результат.Добавить(НакладнаяПослеОрдера);
	КонецЕсли;

	Если Контекст.НакладнаяПередОрдером Тогда
		Результат.Добавить(НакладнаяПередОрдером);
		Результат.Добавить(ОрдерПослеНакладной);
	КонецЕсли;
	
	Если Контекст.НакладнаяБезОрдера Тогда
		Результат.Добавить(ПустаяСсылка());
	ИначеЕсли Результат.Количество() = 0 Тогда
		Результат.Добавить(ПустаяСсылка());
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭтоОрдер(Этап) Экспорт 

	Возврат (Этап = ОрдерПередНакладной)
		ИЛИ (Этап = ОрдерПослеНакладной);

КонецФункции

Функция ЭтоНакладная(Этап) Экспорт 

	Возврат (Этап = НакладнаяПослеОрдера)
		ИЛИ (Этап = НакладнаяПередОрдером);

КонецФункции

Функция ЭтоФактуровка(Этап) Экспорт 
	Возврат (Этап = ПустаяСсылка()) ИЛИ ЭтоНакладная(Этап);
КонецФункции

#КонецОбласти

