// Определяет настройки начального заполнения элементов
//
// Параметры:
//  Настройки - Структура - настройки заполнения:
//   * ПриНачальномЗаполненииЭлемента - Булево - Если Истина, то для каждого элемента будет
//      вызвана процедура индивидуального заполнения ПриНачальномЗаполненииЭлемента.
Процедура ПриНастройкеНачальногоЗаполненияЭлементов(Настройки) Экспорт
	
	Настройки.ПриНачальномЗаполненииЭлемента = Истина;
	
КонецПроцедуры

// Вызывается при начальном заполнении справочника.
//
// Параметры:
//  КодыЯзыков - Массив - список языков конфигурации. Актуально для мультиязычных конфигураций.
//  Элементы   - ТаблицаЗначений - данные заполнения. Состав колонок соответствует набору реквизитов справочника.
//  ТабличныеЧасти - Структура из КлючИЗначение - данные заполнения табличных частей.
//                                                Состав колонок соответствует набору реквизитов табличных частей.
Процедура ПриНачальномЗаполненииЭлементов(КодыЯзыков, Элементы, ТабличныеЧасти) Экспорт

	Элемент = Элементы.Добавить();
	Элемент.ИмяПредопределенныхДанных = "ОрдерПередНакладной";
	ДополнительныеЯзыкиУХ.ЗаполнитьМультиязычныйРеквизит(Элемент, "Наименование", "ru = 'Ордер перед накладной'", КодыЯзыков); // @NStr-2
	Элемент.Код = "000000001";
	
	Элемент = Элементы.Добавить();
	Элемент.ИмяПредопределенныхДанных = "ОрдерПослеНакладной";
	ДополнительныеЯзыкиУХ.ЗаполнитьМультиязычныйРеквизит(Элемент, "Наименование", "ru = 'Ордер после накладной'", КодыЯзыков); // @NStr-2
	Элемент.Код = "000000002";
	
	Элемент = Элементы.Добавить();
	Элемент.ИмяПредопределенныхДанных = "НакладнаяПередОрдером";
	ДополнительныеЯзыкиУХ.ЗаполнитьМультиязычныйРеквизит(Элемент, "Наименование", "ru = 'Накладная перед ордером'", КодыЯзыков); // @NStr-2
	Элемент.Код = "000000003";
	
	Элемент = Элементы.Добавить();
	Элемент.ИмяПредопределенныхДанных = "НакладнаяПослеОрдера";
	ДополнительныеЯзыкиУХ.ЗаполнитьМультиязычныйРеквизит(Элемент, "Наименование", "ru = 'Накладная после ордера'", КодыЯзыков); // @NStr-2
	Элемент.Код = "000000004";
	
КонецПроцедуры

