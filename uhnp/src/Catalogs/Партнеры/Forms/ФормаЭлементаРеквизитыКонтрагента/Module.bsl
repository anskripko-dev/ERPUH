&НаКлиенте
Процедура ЦНСИ_ВвестиЗаявкуНаИзменение_Подключаемый_Контрагент() Экспорт
	
	ВозможнаЗаявкаПартнер=Ложь;
	
	Если НЕ (ЭтотОбъект.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер")=Неопределено
		ИЛИ ЭтотОбъект.Элементы.ЦНСИ_ВвестиЗаявкуНаРегистрацию_Партнер.Видимость) Тогда
		
		Записать();
		УправлениеФормойНСИКлиентКонтрагентПартнер.ВвестиЗаявкуНаСогласованиеИзменений_Партнер(ЭтотОбъект,ЦНСИ_ПолучитьАдресДанныхОбъекта(Ложь),Ложь);
		ВозможнаЗаявкаПартнер=Истина;
		
	ИначеЕсли НЕ (ЭтотОбъект.Элементы.Найти("ЦНСИ_ВвестиЗаявкуНаИзменение_Партнер")=Неопределено
		ИЛИ ЭтотОбъект.Элементы.ЦНСИ_ВвестиЗаявкуНаИзменение_Партнер.Видимость) Тогда
		
		УправлениеФормойНСИКлиентКонтрагентПартнер.ВвестиЗаявкуНаСогласованиеИзменений_Партнер(ЭтотОбъект,ЦНСИ_ПолучитьАдресДанныхОбъекта(Истина));		
		ВозможнаЗаявкаПартнер=Истина;
		
	КонецЕсли;
	
	УправлениеФормойНСИКлиентКонтрагентПартнер.ВвестиЗаявкуНаСогласованиеИзменений_Контрагент(ЭтотОбъект,
				ЦНСИ_ПолучитьАдресДанныхОбъекта_Контрагент(Истина),Истина,?(ВозможнаЗаявкаПартнер,Объект.Ссылка,Неопределено));
			
КонецПроцедуры // ЦНСИ_ВвестиЗаявкуНаИзменение_Подключаемый()

&НаСервере
Функция ЦНСИ_ПолучитьАдресДанныхОбъекта_Контрагент(СогласованиеИзменений)
	
	Если СогласованиеИзменений Тогда
		
		КонтрагентОбъект = КонтрагентПартнера.ПолучитьОбъект();
		УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, КонтрагентОбъект);
		
		КонтрагентОбъект.Наименование = Объект.Наименование;
		КонтрагентОбъект.НаименованиеПолное        = Объект.НаименованиеПолное;
		КонтрагентОбъект.НаименованиеМеждународное = НаименованиеМеждународное;
		КонтрагентОбъект.Партнер                   = Объект.Ссылка;
		КонтрагентОбъект.ЮрФизЛицо                 = ЮрФизЛицо;
		КонтрагентОбъект.ОбособленноеПодразделение = ОбособленноеПодразделение;
		КонтрагентОбъект.СтранаРегистрации         = СтранаРегистрации;
		КонтрагентОбъект.РегистрационныйНомер      = РегистрационныйНомер;
		КонтрагентОбъект.НалоговыйНомер            = НалоговыйНомер;
		КонтрагентОбъект.ИНН                       = ИНН;
		КонтрагентОбъект.ИсторияНаименований.Загрузить(ИсторияНаименований.Выгрузить());
		
		Если Не ЗначениеЗаполнено(ГоловнойКонтрагент) И Не ОбособленноеПодразделение Тогда
			
			ГоловнойКонтрагент = КонтрагентПартнера;
			
		КонецЕсли;
		
		КонтрагентОбъект.ГоловнойКонтрагент = ГоловнойКонтрагент;
		ПартнерыИКонтрагенты.ЗаполнитьКонтактнуюИнформациюКонтрагентаПартнера(КонтрагентОбъект, ЭтотОбъект, Объект.КонтактнаяИнформация);
		ПартнерыИКонтрагентыЛокализация.ПередЗаписьюКонтрагентаПартнера(КонтрагентОбъект, ЭтаФорма);
		// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
		ПроверкаКонтрагентов.ПередЗаписьюНаСервереКонтрагент(ЭтотОбъект, КонтрагентОбъект);
		// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
		
		РеквизитыКонтрагента = "ГруппаКонтрагента, ОрганизационнаяЕдиница, ФормаУчастияВКапитале, АдресМеждународный,
		|ГородСтранаМеждународный, Наименование1, Наименование2, ДатаПостановкиНаУчетВНалоговой, СубъектМалогоИлиСреднегоПредпринимательстваУХ,
		|КодОКОПФ, НаименованиеОКОПФ";
		
		ЗаполнитьЗначенияСвойств(КонтрагентОбъект,ЭтаФорма, РеквизитыКонтрагента);
		
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("Ссылка",КонтрагентПартнера);	
		СтруктураПараметров.Вставить("Объект",КонтрагентОбъект); 
		
	Иначе
		
		СтруктураПараметров=Новый Структура;
		СтруктураПараметров.Вставить("Ссылка",КонтрагентПартнера);	
		СтруктураПараметров.Вставить("Объект",КонтрагентПартнера);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("СвязанныйОбъект",Объект.Ссылка);
		
	Возврат ПоместитьВоВременноеХранилище(СтруктураПараметров);	
	
КонецФункции // ПолучитьАдресДанныхОбъекта() 

&НаСервере
Функция ПолучитьДанныеОбъекта(КонтрагентОбъект)
	
	ОписаниеОбъекта = УправлениеНСИ.ПолучитьДанныеОбъектаНСИ("Контрагенты");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СправочникиБДРеквизиты.Имя КАК Имя
	|ИЗ
	|	Справочник.СправочникиБД.Реквизиты КАК СправочникиБДРеквизиты
	|ГДЕ
	|	СправочникиБДРеквизиты.Ссылка = &Ссылка
	|	И НЕ СправочникиБДРеквизиты.ИзменениеБезСогласования";
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	МассивСогласуемыхРеквизитов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя");
	
	СтруктураОбъекта=Новый Структура;
	
	Для Каждого Реквизит ИЗ МассивСогласуемыхРеквизитов Цикл
		
		СтруктураОбъекта.Вставить(Реквизит,КонтрагентОбъект[Реквизит]);
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ.Имя КАК ОписаниеТЧИмя,
	             |	СправочникиБДСогласуемыеТЧ.ОписаниеТЧ КАК ОписаниеТЧ
	             |ИЗ
	             |	Справочник.СправочникиБД.СогласуемыеТЧ КАК СправочникиБДСогласуемыеТЧ
	             |ГДЕ
	             |	СправочникиБДСогласуемыеТЧ.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",ОписаниеОбъекта.Ссылка);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		СтруктураОбъекта.Вставить(Результат.ОписаниеТЧИмя,КонтрагентОбъект[Результат.ОписаниеТЧИмя].Выгрузить());
		
	КонецЦикла;
	
	Возврат СтруктураОбъекта;
			
КонецФункции // ПолучитьДанныеОбъекта() 

