
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	УправлениеФормой(ЭтаФорма);
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПодготовитьФормуНаСервере(ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере(ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Попытка
		
		Для каждого ИмяСчета Из КэшируемыеЗначения.ИменаСубконто Цикл

			Если ТекущийОбъект[ИмяСчета.Ключ].Пустая() Тогда
				ОбъектСчет = Справочники.СчетаУчетаМСФО.СоздатьЭлемент();
				ОбъектСчет.УстановитьНовыйКод();
			Иначе 
				ОбъектСчет = ТекущийОбъект[ИмяСчета.Ключ].ПолучитьОбъект();
			КонецЕсли;
			
			ОбъектСчет.ПланСчетовБД	= ТекущийОбъект.ПланСчетовБД;
			ОбъектСчет.Счет			= ЭтотОбъект[ИмяСчета.Ключ];
			ОбъектСчет.Субконто1	= ЭтотОбъект[ИмяСчета.Ключ + "Субконто1"];
			ОбъектСчет.Субконто2	= ЭтотОбъект[ИмяСчета.Ключ + "Субконто2"];
			ОбъектСчет.Субконто3	= ЭтотОбъект[ИмяСчета.Ключ + "Субконто3"];
			
			ОбъектСчет.Записать();
			
			ТекущийОбъект[ИмяСчета.Ключ] = ОбъектСчет.Ссылка;
			
		КонецЦикла;
		
	Исключение
		ТекстСообщение = НСтр("ru = 'Не удалось обновить счета учета МСФО:'")
							+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщение, ЭтотОбъект,,, Отказ);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если (ВладелецФормы <> Неопределено) 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВладелецФормы, "ПараметрыВыбора")
		И ВладелецФормы.ПараметрыВыбора.Количество() Тогда
	
		ПараметрыЗаполнения = Новый Структура("ПланСчетовБД, РазделПланаСчетов, Авансы");
		Для каждого ПараметрВыбора Из ВладелецФормы.ПараметрыВыбора Цикл
			ПараметрыЗаполнения.Вставить(ПараметрВыбора.Имя, ПараметрВыбора.Значение);
		КонецЦикла;
		
		Если Объект.ПланСчетовБД.Пустая() Тогда
			Объект.ПланСчетовБД = ПараметрыЗаполнения.ПланСчетовБД;
		КонецЕсли;
		
		Если Объект.ВидОбъектаУчета.Пустая() Тогда
			ВидыОбъектовУчета = ВидыОбъектовУчета(ПараметрыЗаполнения.РазделПланаСчетов, ПараметрыЗаполнения.Авансы);
			Объект.ВидОбъектаУчета = ?(ВидыОбъектовУчета.Количество(), ВидыОбъектовУчета[0], Объект.ВидОбъектаУчета);
		КонецЕсли;
		
		УправлениеФормой(ЭтотОбъект);
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти



#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПланСчетовБДПриИзменении(Элемент)
	ОбновитьСубконтоСчетов();
КонецПроцедуры

&НаКлиенте
Процедура ВидОбъектаУчетаПриИзменении(Элемент)
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	
	КэшируемыеЗначения.Вставить("КлючевыеСубконто", МСФОКлиентСерверУХ.КлючевыеСубконтоСчета(СчетУчета));
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, Элемент.Имя, ЭтотОбъект,,, СчетУчета);

	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, "СчетДоходов", ЭтотОбъект,,, СчетДоходов);
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, "СчетРасходов", ЭтотОбъект,,, СчетРасходов);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоходовПриИзменении(Элемент)
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, Элемент.Имя, ЭтотОбъект,,, СчетДоходов);
КонецПроцедуры

&НаКлиенте
Процедура СчетРасходовПриИзменении(Элемент)
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, Элемент.Имя, ЭтотОбъект,,, СчетРасходов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	КэшируемыеЗначения = Форма.КэшируемыеЗначения;

	СтарыйВид = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КэшируемыеЗначения, "ВидОбъектаУчета");
	Если Объект.ВидОбъектаУчета = СтарыйВид Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеВида = ОписаниеВидаОбъекта(Объект.ВидОбъектаУчета);
	КэшируемыеЗначения.Вставить("ОписаниеВидаОбъекта", ОписаниеВида);
	КэшируемыеЗначения.Вставить("ВидОбъектаУчета", Объект.ВидОбъектаУчета);
	
	ИменаСчетов = Новый Структура("СчетУчета, СчетДоходов, СчетРасходов");
	Для каждого ИмяСчета Из ИменаСчетов Цикл
		Элементы["Группа" + ИмяСчета.Ключ].Видимость = ОписаниеВида.Свойство(ИмяСчета.Ключ);
		Элементы[ИмяСчета.Ключ].Заголовок = ?(ОписаниеВида.Свойство(ИмяСчета.Ключ), ОписаниеВида[ИмяСчета.Ключ], "");
	КонецЦикла;
	
	ИменаСчетов = Новый Структура("ПараметрыАванса, ПараметрыНДС", "ВидАвансов", "ВидНДС");
	
	Для каждого ИмяСчета Из ИменаСчетов Цикл
		Элементы[ИмяСчета.Ключ].Видимость = ОписаниеВида.Свойство(ИмяСчета.Значение);
		Элементы[ИмяСчета.Ключ].Заголовок = ?(ОписаниеВида.Свойство(ИмяСчета.Значение), ОписаниеВида[ИмяСчета.Значение], "");
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(ТекущийОбъект = Неопределено)
	
	КэшируемыеЗначения = Новый Структура;
	
	КэшируемыеЗначения.Вставить("ИменаСубконто", Справочники.ПараметрыОбъектовУчетаМСФО.ПолучитьИменаСубконто());
	КэшируемыеЗначения.Вставить("КлючевыеСубконто", МСФОКлиентСерверУХ.КлючевыеСубконтоСчета(Объект.СчетУчета.Счет));
	
	ОбновитьСубконтоСчетов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСубконтоСчетов()
	
	ПараметрыВыбораСчета = МСФОУХ.ПолучитьПараметрыВыбораСчетаБД(Объект.ПланСчетовБД, Ложь, Ложь);
	
	Для каждого ИмяСчета Из КэшируемыеЗначения.ИменаСубконто Цикл
		
		ЭтотОбъект[ИмяСчета.Ключ] = Объект[ИмяСчета.Ключ].Счет;
		Для й = 1 По 3 Цикл
			ЭтотОбъект[ИмяСчета.Ключ + "Субконто" + й] = Объект[ИмяСчета.Ключ]["Субконто" + й];
		КонецЦикла;
		
		Элемент = Элементы.Найти(ИмяСчета.Ключ);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент.ПараметрыВыбора = ПараметрыВыбораСчета;
		МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтотОбъект, Элемент.Имя, ЭтотОбъект,,, ЭтотОбъект[ИмяСчета.Ключ]);
		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидыОбъектовУчета(РазделПланаСчетов, ЕстьАвансы = Неопределено)
	Возврат Справочники.ПараметрыОбъектовУчетаМСФО.ВидыОбъектовУчета(РазделПланаСчетов, ЕстьАвансы);
КонецФункции

#Область ОтображениеСчетовУчета

&НаСервереБезКонтекста
Функция ОписаниеВидаОбъекта(ВидОбъектаУчета) 
	Возврат Справочники.ВидыОбъектовУчетаМСФО.ОписаниеВидаОбъекта(ВидОбъектаУчета);
КонецФункции

#КонецОбласти

