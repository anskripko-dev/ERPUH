
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Поля.Добавить("Ссылка");
	Поля.Добавить("Наименование");
	Поля.Добавить("ВидОбъектаУчета");
	Поля.Добавить("СчетУчета");
	Поля.Добавить("СчетДоходов");
	Поля.Добавить("СчетРасходов");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	Если Не Данные.Свойство("ВидОбъектаУчета") Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Данные.Наименование) Тогда
		Представление = Данные.Наименование;
		Возврат;
	КонецЕсли;
	
	МассивНаименование = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.ВидОбъектаУчета);
	
	ДобавитьСчетаУчетаМСФО(МассивНаименование, Данные.СчетУчета);
	ДобавитьСчетаУчетаМСФО(МассивНаименование, Данные.СчетДоходов);
	ДобавитьСчетаУчетаМСФО(МассивНаименование, Данные.СчетРасходов);
	
	Представление = СтрСоединить(МассивНаименование, ", ");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСобытий

Процедура ДобавитьСчетаУчетаМСФО(МассивНаименование, СчетаУчетаМСФО)
	
	СтрокаСчет = ?(ЗначениеЗаполнено(СчетаУчетаМСФО), Строка(СчетаУчетаМСФО), "");
	Если Не ЗначениеЗаполнено(СтрокаСчет) Тогда
		Возврат;
	КонецЕсли;
	
	МассивНаименование.Добавить(СтрокаСчет);
	
КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
		
	Если Параметры.Свойство("ПланСчетовБД") Тогда
		Параметры.Отбор.Вставить("ПланСчетовБД", Параметры.ПланСчетовБД);
	КонецЕсли;
	
	Если Параметры.Свойство("РазделПланаСчетов") Тогда
		
		ЕстьАвансы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Авансы");
		ВидОбъектаУчета = ВидыОбъектовУчета(Параметры.РазделПланаСчетов, ЕстьАвансы);
		
		Параметры.Отбор.Вставить("ВидОбъектаУчета", ВидОбъектаУчета);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограмныйИнтерфейс

Функция ВидыОбъектовУчета(РазделПланаСчетов, ЕстьАвансы = Неопределено) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОбъектовУчетаМСФО КАК т
	|ГДЕ
	|	т.РазделПланаСчетов В(&РазделПланаСчетов)");
	Запрос.УстановитьПараметр("РазделПланаСчетов", РазделПланаСчетов);
	
	Если ЕстьАвансы = Истина Тогда
		Запрос.Текст = Запрос.Текст + " И т.ИмяПредопределенныхДанных НЕ В (""ДЗ"", ""КЗ"")";
	ИначеЕсли ЕстьАвансы = Ложь Тогда
		Запрос.Текст = Запрос.Текст + " И т.ИмяПредопределенныхДанных НЕ В (""АвансВыданный"", ""АвансПолученный"")";
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецФункции

Функция ПолучитьПараметры(Объект, ПланСчетовМСФО) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.ПараметрыУчетаМСФО КАК ПараметрыУчетаМСФО
	|ИЗ
	|	РегистрСведений.ПараметрыОбъектовУчетаМСФО КАК т
	|ГДЕ
	|	т.ПланСчетовМСФО = &ПланСчетовМСФО
	|	И т.Актив В (&Актив, НЕОПРЕДЕЛЕНО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.Актив = &Актив УБЫВ,
	|	т.Актив");
	
	Если ЗначениеЗаполнено(Объект) Тогда
		
		МД = Объект.Метаданные();
		Имя = МД.ПолноеИмя();
		
		Дополнения = Новый Массив;
		Дополнения.Добавить(СтрШаблон("ЗНАЧЕНИЕ(%1.ПустаяСсылка)", Имя));
			
		Если МД.Имя = "Номенклатура" Тогда
			Шаблон = "ВЫРАЗИТЬ(&Актив КАК %1).НоменклатурнаяГруппа";
			Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
				Шаблон = "ВЫРАЗИТЬ(&Актив КАК %1).ГруппаФинансовогоУчета";
			КонецЕсли;
			Дополнения.Добавить(СтрШаблон(Шаблон, Имя));
		ИначеЕсли МД.Иерархический Тогда
			Шаблон = "ВЫРАЗИТЬ(&Актив КАК %1).Родитель";
			Дополнения.Добавить(СтрШаблон(Шаблон, Имя));
		КонецЕсли;
		
		Запрос.Текст= СтрЗаменить(Запрос.Текст, "НЕОПРЕДЕЛЕНО", СтрСоединить(Дополнения, ","));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Актив", 			Объект);
	Запрос.УстановитьПараметр("ПланСчетовМСФО", ПланСчетовМСФО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПустаяСсылка();	
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить().Получить(0).Получить(0);
	
КонецФункции

Функция ПараметрыПоУмолчанию(ПланСчетовБД, ВидОбъектаУчета) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПараметрыОбъектовУчетаМСФО КАК т
	|ГДЕ
	|	т.ПланСчетовБД = &ПланСчетовБД
	|	И т.ВидОбъектаУчета = &ВидОбъектаУчета
	|	И НЕ т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.Код УБЫВ");
	Запрос.УстановитьПараметр("ПланСчетовБД", ПланСчетовБД);
	Запрос.УстановитьПараметр("ВидОбъектаУчета", ВидОбъектаУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить().Получить(0).Ссылка;
	
КонецФункции

Функция ПолучитьИменаСубконто() Экспорт 

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "СчетУчетаСубконто1");
	Субконто.Вставить(2, "СчетУчетаСубконто2");
	Субконто.Вставить(3, "СчетУчетаСубконто3");
	
	Результат.Вставить("СчетУчета", Субконто);
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "СчетДоходовСубконто1");
	Субконто.Вставить(2, "СчетДоходовСубконто2");
	Субконто.Вставить(3, "СчетДоходовСубконто3");
	
	Результат.Вставить("СчетДоходов", Субконто);
		
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "СчетРасходовСубконто1");
	Субконто.Вставить(2, "СчетРасходовСубконто2");
	Субконто.Вставить(3, "СчетРасходовСубконто3");
	
	Результат.Вставить("СчетРасходов", Субконто);
		
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_втСчетаУчета(НомераТаблиц, ПоляАналитик, ПутиСубконто) Экспорт

	НомераТаблиц.Вставить("втСчетаУчета", НомераТаблиц.Количество());

	ТекстЗапроса = СтрЗаменить(ШаблонЗапроса_втСчетаУчета(), "&ПараметрыОбъектовУчета", ТекстЗапроса_ПолучениеСчетов(ПоляАналитик));
	
	ШаблонКогдаТогда = "КОГДА &.ТипДанных ПОДОБНО ""&&""+""%1""+""&&"" ТОГДА ""%1"" ";
	ШаблонРоль = СтрЗаменить(МСФОУХ.ВыборТипаСубконто(ШаблонКогдаТогда, ПутиСубконто), "&&", "%");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РольСубконто1", СтрЗаменить(ШаблонРоль, "&", "ВидСубконто1"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РольСубконто2", СтрЗаменить(ШаблонРоль, "&", "ВидСубконто2"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РольСубконто3", СтрЗаменить(ШаблонРоль, "&", "ВидСубконто3"));
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапроса_ПолучениеСчетов(ПоляАналитикТекстом)
	
	ТекстЗапроса = Новый Массив;
	ШаблонЗапроса = 
	"
	|ВЫБРАТЬ
	|	т.%1
	|ИЗ
	|	%2 КАК т
	|ГДЕ 
	|	т.%1.Счет <> ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	|"; // @query-part
	
	ПоляАналитик = СтрРазделить(ПоляАналитикТекстом, Символы.ПС);
	
	Для каждого ПолеАналитики Из ПоляАналитик Цикл
		ЧастиА = СтрРазделить(СокрЛП(ПолеАналитики), ".");
		ТекстЗапроса.Добавить(СтрШаблон(ШаблонЗапроса, ЧастиА[1], ЧастиА[0]));
	КонецЦикла;
	
	Возврат СтрСоединить(ТекстЗапроса, " ОБЪЕДИНИТЬ ВСЕ ");

КонецФункции

Функция ШаблонЗапроса_втСчетаУчета()
	
	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК АналитикаУчета,
	|	т.Счет КАК СчетИБ,
	|	т.Счет.СчетСсылка КАК СчетСсылка,
	|	ВЫБОР
	|		КОГДА ИСТИНА
	|			ТОГДА т.Счет.СчетСсылка
	|		ИНАЧЕ т.Счет
	|	КОНЕЦ КАК Счет,
	|	т.Счет.СчетСсылка.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	т.Счет.СчетСсылка.УчетПоНаправлениямДеятельности КАК УчетПоНаправлениямДеятельности,
	|	т.Счет.СчетСсылка.Вид КАК Вид,
	|	т.Счет.СчетСсылка.Валютный КАК Валютный,
	|	т.Счет.СчетСсылка.Количественный КАК Количественный,
	|	ВЫБОР
	|		КОГДА т.Субконто1 = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		КОГДА 1 В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					1
	|				ИЗ
	|					Справочник.ИдентификаторыОбъектовМетаданных КАК мд
	|				ГДЕ
	|					мд.ЗначениеПустойСсылки = т.Субконто1)
	|			ТОГДА NULL
	|		ИНАЧЕ т.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА т.Субконто2 = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		КОГДА 1 В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					1
	|				ИЗ
	|					Справочник.ИдентификаторыОбъектовМетаданных КАК мд
	|				ГДЕ
	|					мд.ЗначениеПустойСсылки = т.Субконто2)
	|			ТОГДА NULL
	|		ИНАЧЕ т.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА т.Субконто3 = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		КОГДА 1 В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					1
	|				ИЗ
	|					Справочник.ИдентификаторыОбъектовМетаданных КАК мд
	|				ГДЕ
	|					мд.ЗначениеПустойСсылки = т.Субконто3)
	|			ТОГДА NULL
	|		ИНАЧЕ т.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	ЕСТЬNULL(ВидСубконто1.ВидСубконтоСсылка, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконто1,
	|	ЕСТЬNULL(ВидСубконто2.ВидСубконтоСсылка, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконто2,
	|	ЕСТЬNULL(ВидСубконто3.ВидСубконтоСсылка, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоКорпоративные.ПустаяСсылка)) КАК ВидСубконто3,
	|	&РольСубконто1 КАК РольСубконто1,
	|	&РольСубконто2 КАК РольСубконто2,
	|	&РольСубконто3 КАК РольСубконто3
	|ПОМЕСТИТЬ втСчетаУчета
	|ИЗ
	|	Справочник.СчетаУчетаМСФО КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто1
	|		ПО т.Счет = ВидСубконто1.Ссылка
	|			И (ВидСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто2
	|		ПО т.Счет = ВидСубконто2.Ссылка
	|			И (ВидСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаБД.ВидыСубконто КАК ВидСубконто3
	|		ПО т.Счет = ВидСубконто3.Ссылка
	|			И (ВидСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	т.Ссылка В(&ПараметрыОбъектовУчета)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	АналитикаУчета";

КонецФункции

#КонецОбласти

#КонецЕсли
