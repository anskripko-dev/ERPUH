&НаСервере
Функция ДоступностьПротокола_НаСервере()
	
	ДоступностьЭл = Ложь;
	Если Объект.Протокол = Перечисления.тн_ПротоколыПодключений.WS Тогда
		ДоступностьЭл = Истина;
	Иначе
		ДоступностьЭл = Ложь;
	КонецЕсли;
	
	Возврат ДоступностьЭл;
	
КонецФункции

// Калинин А. 22.05.2018 Выполнение задач №000028467
