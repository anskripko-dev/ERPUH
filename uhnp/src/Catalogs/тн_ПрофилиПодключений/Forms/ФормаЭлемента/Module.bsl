// Луконин Е.А. 14.01.2020 Выполнение задач №000033749
&НаКлиенте
Процедура УстановитьВидимостьКоманд() Экспорт 
	
	ЭлементыКоманднойПанели = Элементы.ФормаКоманднаяПанель.ПодчиненныеЭлементы;
	КнопкаФедерализовать    = ЭлементыКоманднойПанели.Найти("ФормаСправочникТН_ПрофилиПодключенийФедерализовать");
	КнопкаРасфедерализовать = ЭлементыКоманднойПанели.Найти("ФормаСправочникТН_ПрофилиПодключенийРасфедерализовать");
	
	Если КнопкаФедерализовать = Неопределено Или КнопкаРасфедерализовать = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Объект.ЯвляетсяОбъектомЦБ Тогда 
		КнопкаФедерализовать   .Видимость = Ложь;
		КнопкаРасфедерализовать.Видимость = Истина;
	Иначе 
		КнопкаФедерализовать   .Видимость = Истина;
		КнопкаРасфедерализовать.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимостьКоманд()

// Кутовой Д.Б. 07.09.2023 Выполнение задач №000046649
//
&НаСервере
Процедура ПолучитьДанныеИзБезопасногоХранилища()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеБП = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "Password, ApiKey");
	Если ДанныеБП <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеБП.Password) Тогда
			Пароль = ЭтотОбъект.УникальныйИдентификатор;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеБП.ApiKey) Тогда
			ApiKey = ЭтотОбъект.УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	
	// НАЧАЛО Смирнов Д.А. 14.08.2025 Выполнение задач №000052291
	Для Сч = 0 По Объект.ДополнительныеПараметры.Количество() - 1 Цикл
		ТекущаяСтрока = Объект.ДополнительныеПараметры.Получить(Сч);
		Если ТекущаяСтрока.Секрет Тогда
			ТекущаяСтрока.ЗначениеСекрета = "******";
			Если Объект.Ссылка = Справочники.ТН_ПрофилиПодключений.EDA И ТекущаяСтрока.Ключ = "Authorization" Тогда
				Authorization = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "Ключ_" + ТекущаяСтрока.НомерСтроки);
				ТекущаяСтрока.Представление = Лев(Authorization, СтрНайти(Authorization, "/")) + "***********" + Прав(Authorization, 3);
			КонецЕсли;
		Иначе
			ТекущаяСтрока.ЗначениеСекрета = ТекущаяСтрока.Значение;
		КонецЕсли;
	КонецЦикла;
	// КОНЕЦ Смирнов Д.А. 14.08.2025 Выполнение задач №000052291	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Кутовой Д.Б. 07.09.2023 Выполнение задач №000046649
//
&НаСервере
Процедура ЗаписатьДанныеВБезопасноеХранилище(Ссылка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Пароль <> Строка(ЭтотОбъект.УникальныйИдентификатор) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, Пароль, "Password");
		Пароль = ЭтотОбъект.УникальныйИдентификатор;
	КонецЕсли;
	
	Если ApiKey <> Строка(ЭтотОбъект.УникальныйИдентификатор) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Ссылка, ApiKey, "ApiKey");
		ApiKey = ЭтотОбъект.УникальныйИдентификатор;
	КонецЕсли;
	
	// НАЧАЛО Смирнов Д.А. 14.08.2025 Выполнение задач №000052291
	Для Каждого Элемент Из Объект.ДополнительныеПараметры Цикл
		Если Элемент.Секрет И СтрЗаменить(Элемент.ЗначениеСекрета, "*", "") <> "" Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(
				Ссылка, Элемент.ЗначениеСекрета, "Ключ_" + Элемент.НомерСтроки);
				
			Элемент.ЗначениеСекрета = "******";
		КонецЕсли;
	КонецЦикла;
	// КОНЕЦ Смирнов Д.А. 14.08.2025 Выполнение задач №000052291	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ИзмененыСекреты = Ложь;
	
КонецПроцедуры

