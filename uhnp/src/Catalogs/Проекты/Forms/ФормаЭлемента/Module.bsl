&НаСервере
Процедура ДобавитьСтрокуМакетаСКлючевымПоказателем(МакетВыводаКлючевыхПоказателей,НаименованиеПоказателя,ПредставлениеПоказателя)
	
	тОбласть                   			= МакетВыводаКлючевыхПоказателей.ПолучитьОбласть(НаименованиеПоказателя);
	тОбласть.Область(1,2,1,2).Текст 	= ПредставлениеПоказателя;
	
	ДанныеТекущий=АтрибутыПроектов.НайтиСтроки(Новый Структура("Сценарий",Объект.ОсновнойСценарий));
	
	Если ДанныеТекущий.Количество()=1 Тогда
		тОбласть.Область(1,3,1,3).Значение = ДанныеТекущий[0][НаименованиеПоказателя];
	КонецЕсли;

	ДанныеБазис=АтрибутыПроектов.НайтиСтроки(Новый Структура("Сценарий",СценарийБазис));
	Если ДанныеБазис.Количество()=1 Тогда		
		тОбласть.Область(1,4,1,4).Значение = ДанныеБазис[0][НаименованиеПоказателя];		
	КонецЕсли;
	
	// Выведем отклонения
	ЦветПоложительный = Новый Цвет(0,128,0);
	ЦветОтрицательный = Новый Цвет(255,0,0);

	
	Если тОбласть.Область(1,5,1,5).СодержитЗначение Тогда
		тОбласть.Область(1,5,1,5).Значение = тОбласть.Область(1,3,1,3).Значение-тОбласть.Область(1,4,1,4).Значение;
		Если тОбласть.Область(1,5,1,5).Значение>0 Тогда
			 тОбласть.Область(1,5,1,5).ЦветТекста = ЦветПоложительный;
		ИначеЕсли тОбласть.Область(1,5,1,5).Значение<0 Тогда
			  тОбласть.Область(1,5,1,5).ЦветТекста = ЦветОтрицательный;
		КонецЕсли;			
	КонецЕсли;

	Если тОбласть.Область(1,6,1,6).СодержитЗначение  И тОбласть.Область(1,4,1,4).Значение>0 Тогда	
		тОбласть.Область(1,6,1,6).Значение  = (тОбласть.Область(1,3,1,3).Значение-тОбласть.Область(1,4,1,4).Значение)/тОбласть.Область(1,4,1,4).Значение; 		
		Если тОбласть.Область(1,6,1,6).Значение>0 Тогда
			  тОбласть.Область(1,6,1,6).ЦветТекста = ЦветПоложительный;
		ИначеЕсли тОбласть.Область(1,6,1,6).Значение<0 Тогда
			  тОбласть.Область(1,6,1,6).ЦветТекста = ЦветОтрицательный;
		КонецЕсли;			
	КонецЕсли;
	
	КлючевыеПоказателиТабДок.Вывести(тОбласть);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеСтрокиЭффективности(Строка, ДанныеЗаполнения)
	
	ИмяПоказателя = Строка.ИмяРеквизита;
	
	Строка.Факт = ?(Строка.ЭтоДата, Дата(ДанныеЗаполнения["Факт"+ИмяПоказателя]),Число(ДанныеЗаполнения["Факт"+ИмяПоказателя])); // заполняем у всех
	
	Если НЕ Строка.ТолькоФакт Тогда // Сравнение, Отклонение
		Строка.Сравнение = ?(Строка.ЭтоДата, Дата(ДанныеЗаполнения["Сравнение"+ИмяПоказателя]),Число(ДанныеЗаполнения["Сравнение"+ИмяПоказателя]));
	КонецЕсли;
	
	РассчитатьДанныеСтрокиПоказателей(Строка);
	
КонецПроцедуры

