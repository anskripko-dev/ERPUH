&НаСервере
Функция ПодготовитьПараметрыВызоваБланка()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Бланк",Объект.ФормаОтображенияМоделиРасчета);
	ПараметрыФормы.Вставить("Организация",Объект.Организация);
	ПараметрыФормы.Вставить("Периодичность",Объект.ПериодичностьРасчетаАнализаKPI);
    ПараметрыФормы.Вставить("Регламент",Объект.МодельРасчетаПоказателейПроекта);
	
	ТекущиеАтрибуты = АтрибутыПроектов.НайтиСтроки(Новый Структура("Сценарий",Объект.ОсновнойСценарий));
	
	Если ТекущиеАтрибуты.Количество() = 1 Тогда
		ПериодОтчета 		= ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ТекущиеАтрибуты[0].ДатаНачала,Объект.ПериодичностьРасчетаАнализаKPI);
		ПериодОкончания 	= ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ТекущиеАтрибуты[0].ДатаОкончания,Объект.ПериодичностьРасчетаАнализаKPI);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("Сценарий",Объект.ОсновнойСценарий);
	ПараметрыФормы.Вставить("Проект",Объект.Ссылка);
	
	Возврат ПараметрыФормы;
	
КонецФункции	

