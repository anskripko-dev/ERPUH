
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
  ШаблонПанели = Параметры.ШаблонПанели;	

   
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьДанныеДругихАвторовПриИзменении(Элемент)
	
  ПолучитьСписокВариантов();	
  Элементы.Список.Обновить();

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
 ПолучитьСписокВариантов();	
	 
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокВариантов()
	
  ШаблонПанели = Параметры.ШаблонПанели;	

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
                 |	ВложенныйЗапрос.Ссылка КАК Ссылка
                 |ИЗ
                 |	(ВЫБРАТЬ
                 |		СправочникВариантыАналитическихПанелей.Ссылка КАК Ссылка,
                 |		СправочникВариантыАналитическихПанелей.Код КАК Код,
                 |		СправочникВариантыАналитическихПанелей.Наименование КАК Наименование,
                 |		СправочникВариантыАналитическихПанелей.ЭтоОсновнойВариант КАК ЭтоОсновнойВариант,
                 |		СправочникВариантыАналитическихПанелей.Автор КАК Автор
                 |	ИЗ
                 |		Справочник.ВариантыАналитическихПанелей КАК СправочникВариантыАналитическихПанелей
                 |	ГДЕ
                 |		СправочникВариантыАналитическихПанелей.Автор = &Пользователь
                 |		И СправочникВариантыАналитическихПанелей.ШаблонПанели = &ШаблонПанели
                 |	
                 |	ОБЪЕДИНИТЬ ВСЕ
                 |	
                 |	ВЫБРАТЬ
                 |		СправочникВариантыАналитическихПанелей.Ссылка,
                 |		СправочникВариантыАналитическихПанелей.Код,
                 |		СправочникВариантыАналитическихПанелей.Наименование,
                 |		СправочникВариантыАналитическихПанелей.ЭтоОсновнойВариант,
                 |		СправочникВариантыАналитическихПанелей.Автор
                 |	ИЗ
                 |		Справочник.ВариантыАналитическихПанелей КАК СправочникВариантыАналитическихПанелей
                 |	ГДЕ
                 |		&ОтображатьДанныеДругихАвторов
                 |		И СправочникВариантыАналитическихПанелей.Пользователи.Пользователь = &Пользователь
                 |		И СправочникВариантыАналитическихПанелей.ШаблонПанели = &ШаблонПанели
                 |	
                 |	ОБЪЕДИНИТЬ ВСЕ
                 |	
                 |	ВЫБРАТЬ
                 |		СправочникВариантыАналитическихПанелей.Ссылка,
                 |		СправочникВариантыАналитическихПанелей.Код,
                 |		СправочникВариантыАналитическихПанелей.Наименование,
                 |		СправочникВариантыАналитическихПанелей.ЭтоОсновнойВариант,
                 |		СправочникВариантыАналитическихПанелей.Автор
                 |	ИЗ
                 |		Справочник.ВариантыАналитическихПанелей КАК СправочникВариантыАналитическихПанелей
                 |	ГДЕ
                 |		СправочникВариантыАналитическихПанелей.ЭтоОсновнойВариант = ИСТИНА
                 |		И СправочникВариантыАналитическихПанелей.ШаблонПанели = &ШаблонПанели) КАК ВложенныйЗапрос";
  
  Запрос.УстановитьПараметр("Пользователь",ОбщегоНазначенияУХ.ТекущийПользователь());
  Запрос.УстановитьПараметр("ШаблонПанели",ШаблонПанели);
  Запрос.УстановитьПараметр("ОтображатьДанныеДругихАвторов",ОтображатьДанныеДругихАвторов);
  
  СписокВариантов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
  
  ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("СписокВариантов",СписокВариантов);

   
КонецПроцедуры

