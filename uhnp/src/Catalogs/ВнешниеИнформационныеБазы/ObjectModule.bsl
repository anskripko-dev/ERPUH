
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ТипБД) Тогда
		
		Если ТипБД = Справочники.ТипыБазДанных.ОбменТаблДок Тогда
			
			ПроверяемыеРеквизиты.Добавить("ТипТабличногоДокумента");
			ПроверяемыеРеквизиты.Добавить("НачалоИмени");
			
		ИначеЕсли ТипБД = Справочники.ТипыБазДанных.ТекущаяИБ Тогда							
			
			ПроверяемыеРеквизиты.Очистить();
			
		Иначе
			
			Если ТипБД.ВерсияПлатформы = Перечисления.ПлатформыВнешнихИнформационныхБаз.ADO Тогда
				
				ПроверяемыеРеквизиты.Добавить("СтрокаПодключения");
				
			Иначе
			
				Если РазмещениеВнешнейИБ=Перечисления.ВидыРазмещенияИБ.WebСервис Тогда
					
					ПроверяемыеРеквизиты.Добавить("ПутьКWebСервису");
					ПроверяемыеРеквизиты.Добавить("ИмяWebСервиса");
					ПроверяемыеРеквизиты.Добавить("ТочкаПодключенияWebСервиса");
					
				ИначеЕсли РазмещениеВнешнейИБ=Перечисления.ВидыРазмещенияИБ.Шина Тогда	
					
					ПроверяемыеРеквизиты.Добавить("КодИнформационнойСистемы");
					
				Иначе
				
					Если РазмещениеВнешнейИБ <> Перечисления.ВидыРазмещенияИБ.КлиентСерверный
					 ИЛИ ТипБД.ВерсияПлатформы = Перечисления.ПлатформыВнешнихИнформационныхБаз.Предприятие77 Тогда
						ПроверяемыеРеквизиты.Добавить("КаталогИБ");
					Иначе
						ПроверяемыеРеквизиты.Добавить("ИмяСервера");
						ПроверяемыеРеквизиты.Добавить("ИмяИБНаСервере");
					КонецЕсли;

				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Константы.ЭтоЦентрализованнаяБазаНСИ.Получить() И Ссылка=Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ Тогда
		
		// Необходимо передать в дочерние базы измененные данные централизованной базы НСИ
		
		ИмяРегистраКонтроля="УстановкаПараметровКонтроляНСИ";
		
		НаборЗаписей=РегистрыСведений[ИмяРегистраКонтроля].СоздатьНаборЗаписей();
		НаборЗаписей.Прочитать();
		
		Для Каждого Строка ИЗ НаборЗаписей Цикл
			
			Строка.ЗначениеУстановлено=Ложь;
			
		КонецЦикла;
		
		НаборЗаписей.Записать(); 
		
		МодульОбменаДаннымиНСИ=ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиНСИУХ");	
		МодульОбменаДаннымиНСИ.ВыгрузитьДанныеКонтроляНСИ(,Истина);
		
	КонецЕсли;			
	
КонецПроцедуры

#КонецЕсли

