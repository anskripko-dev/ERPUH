#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимВыбора = "ПоВидуОперации";

	ВидОперации = Параметры.Отбор.ВидОперацииУХ;
	Параметры.Отбор.Удалить("ВидОперацииУХ");
	
	ШаблонЗаголовка = НСтр("ru = 'Выбор вида подтверждающего документа для операции ""%1""';
							|en = 'Select cash flow item for transaction ""%1""'");
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗаголовка, ВидОперации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			СписокПоВидуОперации,
			"ВидОперацииУХ",
			ВидОперации,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			Истина);

	Элементы.СписокПоВидуОперацииВыбрать.КнопкаПоУмолчанию 	= Истина;
	Элементы.ГруппаСтраницы.ТекущаяСтраница 				= Элементы.ГруппаПоВидуОперации;

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура РежимВыбораПриИзменении(Элемент)
	
	ИспользованиеОтбора = ?(РежимВыбора = "ПоВидуОперации", Истина, Ложь);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = ?(ИспользованиеОтбора,
		Элементы.ГруппаПоВидуОперации, Элементы.ГруппаВсе);
		
	Элементы.СписокПоВидуОперацииВыбрать.КнопкаПоУмолчанию 	= ИспользованиеОтбора;
	Элементы.СписокВсеВыбрать.КнопкаПоУмолчанию 			= НЕ ИспользованиеОтбора;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВсеВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповеститьОВыборе(Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПоВидуОперацииВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповеститьОВыборе(Значение);

КонецПроцедуры
#КонецОбласти
