Перем ОбъектОснование;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр = Истина;
	
	ИнициализацияОтчета(Истина);		
	
КонецПроцедуры

#КонецОбласти


&НаСервере
Процедура ИнициализацияОтчета(ПрименитьСохраненныеНастройки = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.ИсточникДанныхОтчета) Тогда
		СтрокаШаблона = Нстр("ru = 'Не выбран источник отчета. Выберите пакет данных в качестве источника'");
		Элементы.ДекорацияОшибка.Заголовок = СтрокаШаблона;
		Элементы.ДекорацияОшибка.Видимость = Истина;
		Возврат;
	КонецЕсли;	
	
	ТекОбъект 				= РеквизитФормыВЗначение("Объект");
	URLСхемы 				= ПолучитьАдресСхемыИзИсточника(ТекОбъект,ПрименитьСохраненныеНастройки);
	СхемаИзИсточника 		= ПолучитьИзВременногоХранилища(URLСхемы); 
	ТекОбъект.СхемаКомпоновкиДанных = Новый ХранилищеЗначения(СхемаИзИсточника);	
			
	Если НЕ ПрименитьСохраненныеНастройки Тогда 
		НастройкиСхемыКомпоновкиДанныхПоУмолчанию = ТекОбъект.НастройкиСхемыКомпоновкиДанныхПоУмолчанию.Получить();
	Иначе
		НастройкиСхемыКомпоновкиДанныхПоУмолчанию = СхемаИзИсточника.НастройкиПоУмолчанию;
	КонецЕсли;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиСхемыКомпоновкиДанныхПоУмолчанию);
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
		
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресСхемыИзИсточника(ОтчетОбъект,ПрименитьСохраненныеНастройки = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.ИсточникДанныхОтчета) Тогда
		СКД = Новый СхемаКомпоновкиДанных;
	Иначе	
		  
		Если ПрименитьСохраненныеНастройки  Тогда
			//из сохраненной в отчете схемы читаем настройки ресурсов и выч. полей
			//так как они доступны для редактирования
			СКДОтчета = ОтчетОбъект.СхемаКомпоновкиДанных.Получить();		
			СКД = Объект.ИсточникДанныхОтчета.СхемаКомпоновкиДанныхпоУмолчанию.Получить();
			//Перенесем сохраненные данные в СКД источника
			Если НЕ СКДОтчета = Неопределено Тогда 
				Для Каждого СтрРесурс Из СКДОтчета.ПоляИтога Цикл
					Если НЕ ЕстьТакоеПолеИтогаСКД(СКД,СтрРесурс) Тогда
						ПолеИтога = СКД.ПоляИтога.Добавить();
						ЗаполнитьЗначенияСвойств(ПолеИтога,СтрРесурс);
					КонецЕсли;	
				КонецЦикла;
				
				Для Каждого СтрВычисляемоеПоле Из СКДОтчета.ВычисляемыеПоля Цикл
					ВычисляемоеПоле = СКД.ВычисляемыеПоля.Добавить();
					ЗаполнитьЗначенияСвойств(ВычисляемоеПоле,СтрВычисляемоеПоле);
				КонецЦикла;
				
				Для Каждого СтрПараметр Из СКДОтчета.Параметры Цикл
					нПараметр = СКД.Параметры.Добавить();
					ЗаполнитьЗначенияСвойств(нПараметр,СтрПараметр);
				КонецЦикла;

				
			КонецЕсли;
			
		Иначе	
			СКД = Объект.ИсточникДанныхОтчета.СхемаКомпоновкиДанныхпоУмолчанию.Получить();	
		КонецЕсли;
		
		Если СКД = Неопределено Тогда		
			СКД = Новый СхемаКомпоновкиДанных;
		КонецЕсли;	
	КонецЕсли;	
	
	
	
	
	Возврат ПоместитьВоВременноеХранилище(СКД,ЭтаФорма.УникальныйИдентификатор);
		
КонецФункции 

&НаСервере
Функция ЕстьТакоеПолеИтогаСКД(СКД,ПолеИтога)
	
	Для Каждого СтрРесурс Из СКД.ПоляИтога Цикл
		
		Если СтрРесурс.ПутьКДанным = ПолеИтога.ПутьКДанным 
			И СтрРесурс.Группировки.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;	
			
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции



#Область ОбработчикиСобытийЭлементовФормы


&НаКлиенте
Процедура РедактироватьВариантСхемы(Команда)
			
	ОткрытьФормуНастройкиСтруктуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСтруктуры()
	
	ПараметрыФормы = ПодготовитьПараметрыДляВызоваФормыРедактирования(Ложь);
	ПараметрыФормы.Вставить("Источник",Объект.ИсточникДанныхОтчета);
	ОткрытьФорму("Справочник.ПроизвольныеОтчеты.Форма.ФормаНастройкиСКД", ПараметрыФормы,  ЭтаФорма);

КонецПроцедуры


#КонецОбласти


&НаСервере
Функция ПодготовитьПараметрыДляВызоваФормыРедактирования(РасширеннаяНастройка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Возврат Новый Структура("URLСхемы, КомпоновщикНастроек, НаименованиеОтчета"
							, URLСхемы
							, КомпоновщикНастроек
							, Объект.Наименование);
	
КонецФункции
