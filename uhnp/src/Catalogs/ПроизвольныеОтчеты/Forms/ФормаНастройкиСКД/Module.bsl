&НаКлиенте
Процедура РесурсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РесурсыРассчитыватьПо" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура("ВыбранныеПоля,ДоступныеПоля"
		,Элементы.Ресурсы.ТекущиеДанные.РассчитыватьПо
		,ПолучитьДоступныеПоляРасчетаРесурса());	   	
		
		Оповещение = Новый ОписаниеОповещения("ФормаИзмененияПолейРесурсаЗавершение", ЭтаФорма);
		
		ОткрытьФорму("Справочник.ПроизвольныеОтчеты.Форма.ФормаРедактированияСоставаАналитикПоляРесурса", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		
		
	КонецЕсли;	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаИзмененияПолейРесурсаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
	
	Нполе 					= Элементы.Ресурсы.ТекущиеДанные;
	Нполе.РассчитыватьПо    = Результат;
	
    ЭтаФорма.Модифицированность = Истина;
	ИзмененаСхемаКД 			= Истина;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеПоляРасчетаРесурса() 
	
	СписокДоступныхПолей = Новый СписокЗначений;
	
	СхемаКД = ПолучитьИзВременногоХранилища(URLСхемы);
	Для Каждого Поле Из СхемаКД.НаборыДанных[0].Поля Цикл
		
		СписокДоступныхПолей.Добавить(Поле.Поле,Поле.Заголовок);
		
		Если Поле.ТипЗначения.Типы().Количество()=1 Тогда 
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Поле.ТипЗначения.Типы()[0]);
			Если НЕ ОбъектМетаданных = Неопределено 
				И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда 
				 СписокДоступныхПолей.Добавить(Поле.Поле,Поле.Заголовок+" Иерархия");
			КонецЕсли;	
				
		КонецЕсли;	
		
	КонецЦикла;	
	
	СписокДоступныхПолей.СортироватьПоЗначению();
	СписокДоступныхПолей.Добавить("","Общий итог");
	
	Возврат СписокДоступныхПолей; 
	
КонецФункции	

