&НаСервере
Процедура УправлениеФормойСервер()
	
	Элементы.СтраницаПараметры.Видимость 					= Не ЭтоЭлементНастройки;
	Элементы.СтаницаВычисляемыхПолей.Видимость 				= Не ЭтоЭлементНастройки;
