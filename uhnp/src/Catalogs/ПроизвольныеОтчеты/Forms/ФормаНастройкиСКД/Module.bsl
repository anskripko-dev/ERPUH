Процедура РесурсыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Для Каждого СтрПоле Из ПараметрыПеретаскивания.Значение Цикл
		
		ДобавитьПолеИтога(СтрПоле.Поле);
		
	КонецЦикла;	
	
	
КонецПроцедуры   

&НаСервере
Процедура  ДобавитьПолеИтога(Поле)
	
    ПолеВыбора = КомпоновщикНастроекПользовательский.Настройки.ДоступныеПоляВыбора.НайтиПоле(Поле);
    Если ПолеВыбора.ТипЗначения.СодержитТип(Тип("Число")) Тогда  
		нРесурс = Ресурсы.Добавить();
		нРесурс.ПутьКДанным = Строка(Поле);
		нРесурс.Выражение = "СУММА("+Строка(Поле)+")";
	Иначе	
		нРесурс = Ресурсы.Добавить();
		нРесурс.ПутьКДанным = Строка(Поле);
		нРесурс.Выражение = "КОЛИЧЕСТВО("+Строка(Поле)+")";
	КонецЕсли;      
	
	ЭтаФорма.Модифицированность = Истина;
	ИзмененаСхемаКД = Истина;

КонецПроцедуры

