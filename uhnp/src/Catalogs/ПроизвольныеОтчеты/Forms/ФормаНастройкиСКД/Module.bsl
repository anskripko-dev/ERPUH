	Оповещение = Новый ОписаниеОповещения("ВопросЗагрузитьНастройкиИсточникаЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Текущие настройки будут заменены настройками источника, продолжить?'"), РежимДиалогаВопрос.ДаНет);
	
