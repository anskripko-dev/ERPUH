	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;	
	
	ПрименитьНастройкиИсточникаСервер();

КонецПроцедуры
	
&НаСервере
Процедура ПрименитьНастройкиИсточникаСервер()
	
	СКД = Источник.СхемаКомпоновкиДанныхпоУмолчанию.Получить();	
			
	URLСхемы =  ПоместитьВоВременноеХранилище(СКД,ЭтаФорма.УникальныйИдентификатор);
	
	КомпоновщикНастроекПользовательский.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));	
	КомпоновщикНастроекПользовательский.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
	ВычисляемыеПоля.Очистить();
	Ресурсы.Очистить();
	
	ЗаполнитьРесурсы();
	
КонецПроцедуры

