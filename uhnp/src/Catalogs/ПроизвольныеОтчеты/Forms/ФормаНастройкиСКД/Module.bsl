&НаКлиенте
Процедура ВычисляемыеПоляПутьКДаннымОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если СокрЛП(Текст) = "" Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Путь к полю не должен быть пустым'"));
		СтандартнаяОбработка = Ложь;
	Иначе	
		Если ВычисляемыеПоля.НайтиСтроки(Новый Структура("ПутьКДанным",Текст)).Количество()>0 Тогда
			ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Вычисляемое поле с таким именем уже существует'"));
			СтандартнаяОбработка = Ложь;		
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

