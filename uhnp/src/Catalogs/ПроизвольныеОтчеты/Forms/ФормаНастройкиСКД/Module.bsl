  
#Область ОбработчикиСобытийФормы  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Источник  				= Параметры.Источник;
	ЭтоЭлементНастройки     = Параметры.ЭтоЭлементНастройки;
	ИдентификаторНастройки  = Параметры.ИдентификаторНастройки;
	
	Заголовок = НСтр("ru = 'Настройка структуры аналитического отчета '");
	
	Если НЕ ПустаяСтрока(Параметры.НаименованиеОтчета) Тогда
		Заголовок = Заголовок + "(" + Параметры.НаименованиеОтчета + ")";
	КонецЕсли;
	
	КомпоновщикНастроекПользовательский.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.URLСхемы));	
	КомпоновщикНастроекПользовательский.ЗагрузитьНастройки(Параметры.КомпоновщикНастроек.ПолучитьНастройки());
	
	URLСхемы = Параметры.URLСхемы;
	
	ЗаполнитьРесурсы();
	
	УправлениеФормойСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ОповеститьОВыборе(ЗаполнитьКомпоновщикНастроекОтчета());
	
	Если Открыта() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтоЭлементНастройки Тогда
		
		Элементы.Структура.ТекущаяСтрока = ИдентификаторНастройки;
		СтруктураПриАктивизацииСтроки(Неопределено);
		
		
		ЛокальныеПараметрыВывода 	= Истина;
		ЛокальныеВыбранныеПоля   	= Истина;
		ЛокальныйОтбор   		 	= Истина;
		ЛокальныйПорядок         	= Истина;
		ЛокальноеУсловноеОформление = Истина;

		
		ЛокальныеВыбранныеПоляПриИзменении(Неопределено);
        ЛокальныйОтборПриИзменении(Неопределено);
		ЛокальныйПорядокПриИзменении(Неопределено);
		ЛокальноеУсловноеОформлениеПриИзменении(Неопределено);
		ЛокальныеПараметрыВыводаПриИзменении(Неопределено);
		
	КонецЕсли;
	
	
КонецПроцедуры


#КонецОбласти

#Область РаботаСНастройкамиСКД

&НаСервере
Процедура ЗаполнитьРесурсы()
	
	СхемаКД = ПолучитьИзВременногоХранилища(URLСхемы);
	
	Для Каждого СтрРесурс Из СхемаКД.ПоляИтога Цикл
		
		нРесурс = Ресурсы.Добавить();
		нРесурс.ПутьКДанным 		=  СтрРесурс.ПутьКДанным;
		нРесурс.Выражение 			=  СтрРесурс.Выражение;
		нРесурс.РассчитыватьПо 		=  СтрРесурс.Группировки;
		нРесурс.ГруппировкиСтрока 	=  ЗначениеВСтрокуВнутр(СтрРесурс.Группировки);
	
	КонецЦикла;	
	
	Для Каждого СтрПоле Из СхемаКД.ВычисляемыеПоля Цикл
			
		ВычисляемоеПоле 			= ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = СтрПоле.ПутьКДанным;
		ВычисляемоеПоле.Выражение 	= СтрПоле.Выражение;
		ВычисляемоеПоле.ТипЗначения = СтрПоле.ТипЗначения;	
		ВычисляемоеПоле.Заголовок   = СтрПоле.Заголовок;
		
	КонецЦикла;	
	
	Для Каждого СтрПараметр Из СхемаКД.Параметры Цикл
		
		ПараметрСКД 							= ПараметрыСхемы.Добавить();
		ПараметрСКД.Параметр 					= СтрПараметр.Имя;
		ПараметрСКД.ТипЗначения 				= СтрПараметр.ТипЗначения;
		ПараметрСКД.Значение 					= СтрПараметр.Значение;
		ПараметрСКД.ДоступенСписокЗначений      = СтрПараметр.ДоступенСписокЗначений;
		
	КонецЦикла;	
	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьКомпоновщикНастроекОтчета()
	
	Возврат Новый ФиксированнаяСтруктура( "URLСхемы,НастройкиОтчета"
	, ПолучитьURLСхемы()
	, КомпоновщикНастроекПользовательский.ПолучитьНастройки());
		
КонецФункции

&НаСервере
Функция ПолучитьURLСхемы() 
	
	СхемаКД = ПолучитьИзВременногоХранилища(URLСхемы);
	СхемаКД.ПоляИтога.Очистить();
		
	Для Каждого СтрРесурс Из Ресурсы Цикл
		
		ПолеИтога = СхемаКД.ПоляИтога.Добавить();
		ПолеИтога.ПутьКДанным = СтрРесурс.ПутьКДанным;
		ПолеИтога.Выражение   = СтрРесурс.Выражение;
	КонецЦикла;	
	
	СхемаКД.ВычисляемыеПоля.Очистить();
	
	Для Каждого СтрПоле Из ВычисляемыеПоля Цикл
			
		ВычисляемоеПоле = СхемаКД.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = СтрПоле.ПутьКДанным;
		ВычисляемоеПоле.Выражение = СтрПоле.Выражение;
		ВычисляемоеПоле.ТипЗначения = СтрПоле.ТипЗначения;	
		ВычисляемоеПоле.Заголовок   = СтрПоле.Заголовок;
		
	КонецЦикла;	
	
	СхемаКД.Параметры.Очистить();
	
	Для Каждого СтрПоле Из ПараметрыСхемы Цикл
			
		ПараметрСКД = СхемаКД.Параметры.Добавить();
		
		ПараметрСКД.Имя 						= СтрПоле.Параметр;
		ПараметрСКД.ТипЗначения  				= СтрПоле.ТипЗначения;
		ПараметрСКД.Значение     				= СтрПоле.Значение;
		ПараметрСКД.ДоступенСписокЗначений     	= СтрПоле.ДоступенСписокЗначений;
		ПараметрСКД.ОграничениеИспользования    = Истина;
		
	КонецЦикла;	

	
	Возврат (ПоместитьВоВременноеХранилище(СхемаКД,Новый УникальныйИдентификатор)); 
	
КонецФункции	

&НаКлиенте
Процедура ВыбранныеПоляДоступны(ЭлементСтруктуры)
	
	Если КомпоновщикНастроекПользовательский.Настройки.НаличиеВыбораУЭлемента(ЭлементСтруктуры) Тогда
				
		ЛокальныеВыбранныеПоля = Истина;
		Элементы.СтраницыПолейВыбора.ТекущаяСтраница = Элементы.НастройкиВыбранныхПолей;
			
	Иначе
			
		ЛокальныеВыбранныеПоля = Ложь;
		Элементы.СтраницыПолейВыбора.ТекущаяСтраница = Элементы.ОтключенныеНастройкиВыбранныхПолей;
			
	КонецЕсли;
		
	Элементы.ЛокальныеВыбранныеПоля.ТолькоПросмотр = Ложь;
					
КонецПроцедуры

