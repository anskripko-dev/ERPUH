Процедура ПроверитьЭлемент(Знач КодИсключения, Знач Описание, Знач ТаблицаИсключений)
	
	Перем ИсключениеСсылка, Исключения;
	
	Исключения = ТаблицаИсключений.НайтиСтроки(Новый Структура("Код", КодИсключения));   
	Если Исключения.Количество() = 1 Тогда
		ИсключениеСсылка = Исключения[0].Ссылка.ПолучитьОбъект();
	Иначе
		ИсключениеСсылка = Справочники.ИсключенияНациональногоРежима.СоздатьЭлемент();
	КонецЕсли; 
	
	Если ИсключениеСсылка.Наименование <> Описание Тогда
		ИсключениеСсылка.Наименование = Описание;
		ИсключениеСсылка.Код = КодИсключения; 
		ИсключениеСсылка.Системный = Истина;
		ИсключениеСсылка.Записать();
	КонецЕсли;
	
КонецПроцедуры
