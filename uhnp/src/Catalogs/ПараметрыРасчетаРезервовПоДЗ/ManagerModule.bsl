
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбновитьПредопределенные(Параметры = Неопределено) Экспорт

	Объект = Справочники.ПараметрыРасчетаРезервовПоДЗ.КлассНадежностиКонтрагента.ПолучитьОбъект();
	Объект.Используется = Истина;
	Объект.Алгоритм = "";
	Объект.ТипПараметраРасчетаРезервов = Перечисления.ТипыПараметровРасчетаРезерва.ПоКонтрагенту;
	Объект.Записать();

	Объект = Справочники.ПараметрыРасчетаРезервовПоДЗ.КоэффициентСрокаПогашения.ПолучитьОбъект();
	Объект.Используется = Истина;
	Объект.Алгоритм = "РасчетноеЗначение = ПолучитьДолюПросрочки(СтрокаДокументаРезерв);";
	Объект.ТипПараметраРасчетаРезервов = Перечисления.ТипыПараметровРасчетаРезерва.Вычисляемый;
	Объект.Записать();
		
КонецПроцедуры

