Процедура ОбновитьПредопределенные(Параметры = Неопределено) Экспорт
	
	Элемент = Справочники.ВариантыМногоэтапнойЗакупки.НакладнаяБезОрдера.ПолучитьОбъект();
	Элемент.НакладнаяБезОрдера = Истина;
	Элемент.ОрдерПередНакладной = Ложь;
	Элемент.НакладнаяПередОрдером = Ложь;
	
	ОбновлениеИнформационнойБазыБМ.ЗаписатьОбъект(Элемент);
	
	Элемент = Справочники.ВариантыМногоэтапнойЗакупки.НакладнаяПередОрдером.ПолучитьОбъект();
	Элемент.НакладнаяБезОрдера = Ложь;
	Элемент.ОрдерПередНакладной = Ложь;
	Элемент.НакладнаяПередОрдером = Истина;
	
	ОбновлениеИнформационнойБазыБМ.ЗаписатьОбъект(Элемент);
	
	Элемент = Справочники.ВариантыМногоэтапнойЗакупки.ОрдерПередНакладной.ПолучитьОбъект();
	Элемент.НакладнаяБезОрдера = Ложь;
	Элемент.ОрдерПередНакладной = Истина;
	Элемент.НакладнаяПередОрдером = Ложь;
	
	ОбновлениеИнформационнойБазыБМ.ЗаписатьОбъект(Элемент);
	
