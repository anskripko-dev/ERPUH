
// Устарела. Следует использовать новую (см. Справочники.ИсходящиеСообщения.Отправить)
// 
// Публикация сообщения во внутренней очереди
//
Процедура Опубликовать(Знач КлючМаршрутизации,
					   Знач Сообщение,
					   Знач ДатаСобытия = '00010101',
					   Знач ТочкаПубликации = "api.onec",
					   Знач СерверОчередей = "") Экспорт

	Объект = СоздатьЭлемент();
	Объект.ТочкаПубликации   = ТочкаПубликации;
	Объект.КлючМаршрутизации = КлючМаршрутизации;
	Объект.ДатаВремяСобытия  = ДатаСобытия;
	Объект.Сообщение         = Сообщение;
	
	Если Не ЗначениеЗаполнено(СерверОчередей) Тогда
		СерверОчередей = Справочники.СерверыОчередейRMQ.Основной;
	ИначеЕсли ТипЗнч(СерверОчередей) = Тип("Строка") Тогда
		// Временное приведение типов для мягкой миграции 1.3 -> 1.4
		СерверОчередей = Справочники.СерверыОчередейRMQ.ПолучитьПараметрыСервера(СерверОчередей).Ссылка;
	КонецЕсли;
	
	Объект.СерверОчередей = СерверОчередей;
	
	// Вычисление универсальной даты события для переходящих с API 1.3
	УниверсальноеДатаСобытия = УниверсальноеВремя(Объект.ДатаВремяСобытия);
	ЧислоСекунд = УниверсальноеВремя(УниверсальноеДатаСобытия);
	Объект.УниверсальнаяДатаСобытияВМиллисекундах = ЧислоСекунд * 1000;
	
	Объект.Записать();

КонецПроцедуры // Опубликовать()

// Борисенко И.Н. 07.05.2021 Выполнение задачи №000035594
// Поместить сообщение в очередь отложенной отправки сообщений.
//
// Параметры:
//  Сообщение						 - Строка - Тело сообщения 
//  ТочкаПубликации					 - Строка - Точка публикации
//		(необязательно) Значение по умолчанию - ""
//  КлючМаршрутизации				 - Строка - Ключ маршрутизации
//		(необязательно) Значение по умолчанию - ""
//  СерверОчередей					 - СправочникСсылка.СерверыОчередейRMQ - Ссылка на настройки подключения к серверу очередей.
//                                     Если не заполнено, отправка осуществляется в "Основной" сервер очередей.
//		(необязательно) Значение по умолчанию - Неопределено
//  СвойстваСообщения				 - Структура - Свойства сообщения. Названия ключей соответствия доступны в методе
//                                     ОчередьСообщений.ВозможныеСвойстваСообщения
//		(необязательно) Значение по умолчанию - Неопределено
//  УниверсальнаяДатаВремяСобытия	 - Число - Универсальная дата и время события в миллисекундах. Если не заполнено,
//                                     заполняется текущей датой.
//		(необязательно) Значение по умолчанию - 0
//
Процедура Отправить(Знач Сообщение,
					Знач ТочкаПубликации = "",
					Знач КлючМаршрутизации = "",
					Знач СерверОчередей = Неопределено,
					Знач СвойстваСообщения = Неопределено,
					Знач ВидСообщения = Неопределено,                // Борисенко Игорь 18.05.2021 Выполнение задач №000037903
					Знач УниверсальнаяДатаВремяСобытия = 0) Экспорт
					
	Объект = Неопределено;				
	Сс = ПолучитьСсылку(СвойстваСообщения.УИД);
	Если Сс <> Неопределено Тогда
		Объект = Сс.ПолучитьОбъект();
	КонецЕсли;
	Если Объект = Неопределено Тогда
		
		Объект = СоздатьЭлемент();
		
		Если ТипЗнч(СвойстваСообщения) = Тип("Структура") И СвойстваСообщения.Свойство("УИД") И ЗначениеЗаполнено(СвойстваСообщения.УИД) Тогда
			Объект.УстановитьСсылкуНового(ПолучитьСсылку(СвойстваСообщения.УИД));
		КонецЕсли;
		
	КонецЕсли;
	Если ТипЗнч(СвойстваСообщения) = Тип("Структура") И СвойстваСообщения.Свойство("УИД") И ЗначениеЗаполнено(СвойстваСообщения.УИД) Тогда
		СвойстваСообщения.Удалить("УИД");
	КонецЕсли;
	
	// НАЧАЛО Луконин Е.А. 01.09.2025 Выполнение задач №000054975
	Если ТипЗнч(СвойстваСообщения) = Тип("Структура") Тогда
		
		//НАЧАЛО Ведутенко С.А. 02.09.2025 Выполнение задач №000054799
		Если СвойстваСообщения.Свойство("СтруктураРеквизитовИсходящегоСообщения") Тогда 
			ЗаполнитьЗначенияСвойств(Объект, СвойстваСообщения.СтруктураРеквизитовИсходящегоСообщения);
			СвойстваСообщения.Удалить("СтруктураРеквизитовИсходящегоСообщения");
		КонецЕсли;    
		//КОНЕЦ  Ведутенко С.А. 02.09.2025 Выполнение задач №000054799

		Если СвойстваСообщения.Свойство("Type") Тогда				
			Объект.ТипСообщения = СвойстваСообщения.Type;
			РегистрыСведений.ТН_Интеграция_ПриоритетыОбработкиСообщенийRMQ.ДобавитьТипЗапроса(СвойстваСообщения.Type, Истина);
		КонецЕсли;
		
		// НАЧАЛО Шкапов В.А. 21.01.2026 Выполнение задач №000056484
		Если СвойстваСообщения.Свойство("AppId") Тогда
			СвойстваСообщения.AppId = КлючОтправителя();
		Иначе
			СвойстваСообщения.Вставить("AppId", КлючОтправителя()); 	
		КонецЕсли;
		// КОНЕЦ Шкапов В.А. 21.01.2026 Выполнение задач №000056484
		
	КонецЕсли;
	// КОНЕЦ Луконин Е.А. 01.09.2025 Выполнение задач №000054975
	
	// НАЧАЛО Шкапов В.А. 21.01.2026 Выполнение задач №000056484
	Если СвойстваСообщения = Неопределено Тогда
		СвойстваСообщения = Новый Структура;
		СвойстваСообщения.Вставить("AppId", КлючОтправителя());
	КонецЕсли;
	// КОНЕЦ Шкапов В.А. 21.01.2026 Выполнение задач №000056484
	
	Объект.ТочкаПубликации   = ТочкаПубликации;
	Объект.КлючМаршрутизации = КлючМаршрутизации;
	Объект.УниверсальнаяДатаСобытияВМиллисекундах = УниверсальнаяДатаВремяСобытия;
	Объект.Сообщение         = Сообщение;
	Объект.СерверОчередей    = СерверОчередей;
			
// НАЧАЛО Борисенко Игорь 18.05.2021 Выполнение задач №000037903
	Если ЗначениеЗаполнено(ВидСообщения) Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_Интеграция_НастройкиПовторнойОтправки.КоличествоПопыток КАК КоличествоПопыток,
		// НАЧАЛО Тулинов Владимир 18.02.2026 Выполнение задач №000056806
		|	ТН_Интеграция_НастройкиПовторнойОтправки.КоличествоПопытокДоставки КАК КоличествоПопытокДоставки,
		|	ТН_Интеграция_НастройкиПовторнойОтправки.ИнтервалПовторнойДоставки КАК ИнтервалПовторнойДоставки,
		// КОНЕЦ Тулинов Владимир 18.02.2026 Выполнение задач №000056806
		|	тн_Интеграция_НастройкиПовторнойОтправки.ИнтервалПовторнойОтправки КАК ИнтервалПовторнойОтправки
		|ИЗ
		|	РегистрСведений.тн_Интеграция_НастройкиПовторнойОтправки КАК тн_Интеграция_НастройкиПовторнойОтправки
		|ГДЕ
		|	тн_Интеграция_НастройкиПовторнойОтправки.ВидСообщения = &ВидСообщения";
		
		Запрос.УстановитьПараметр("ВидСообщения", ВидСообщения);
		
		Выборка = Запрос.Выполнить().Выбрать();				
		
		Если Выборка.Следующий() Тогда
			
			Объект.КоличествоПопыток = Выборка.КоличествоПопыток;
			Объект.ИнтервалПовторнойОтправки = Выборка.ИнтервалПовторнойОтправки;
			
			// НАЧАЛО Тулинов Владимир 18.02.2026 Выполнение задач №000056806
			Объект.КоличествоПопытокДоставки = Выборка.КоличествоПопытокДоставки;
			Объект.ИнтервалПовторнойДоставки = Выборка.ИнтервалПовторнойДоставки;
			// КОНЕЦ Тулинов Владимир 18.02.2026 Выполнение задач №000056806
			
		КонецЕсли;
		
	КонецЕсли;
// КОНЕЦ  Борисенко Игорь 18.05.2021 Выполнение задач №000037903	
	
	// НАЧАЛО Тулинов Владимир 18.02.2026 Выполнение задач №000056806
	Объект.КоличествоПопыток		 = Объект.КоличествоПопыток + 1;
	// КОНЕЦ Тулинов Владимир 18.02.2026 Выполнение задач №000056806
	
	Если СвойстваСообщения <> Неопределено Тогда
		Объект.СвойстваСообщения = ЗначениеВСтрокуВнутр(СвойстваСообщения);
	КонецЕсли;	
	
	Объект.Записать();
					
КонецПроцедуры // Отправить()

// Шкапов В.А. 21.01.2026 Выполнение задач №000056484
//
Функция КлючОтправителя()
	
	ПроизводственноеПодразделение = Константы.тн_ПроизводственноеПодразделение.Получить();
	
	Возврат XMLСтрока(ПроизводственноеПодразделение);
	
КонецФункции