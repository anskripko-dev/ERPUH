#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ОписаниеВидаОбъекта(ВидОбъектаУчета) Экспорт

	Результат = Новый Структура("СчетУчета, СчетДоходов, СчетРасходов, ВидАвансов, ВидНДС",
					ВидОбъектаУчета.ЗаголовокСчетУчета,
					ВидОбъектаУчета.ЗаголовокСчетДоходов,
					ВидОбъектаУчета.ЗаголовокСчетРасходов,
					ВидОбъектаУчета.ВидАвансов,
					ВидОбъектаУчета.ВидНДС);
	
	Если Не ВидОбъектаУчета.ЕстьСчетУчета Тогда
		Результат.Удалить("СчетУчета");
	КонецЕсли;
	
	Если Не ВидОбъектаУчета.ЕстьСчетДоходов Тогда
		Результат.Удалить("СчетДоходов");
	КонецЕсли;
	
	Если Не ВидОбъектаУчета.ЕстьСчетРасходов Тогда
		Результат.Удалить("СчетРасходов");
	КонецЕсли;
	
	Если ВидОбъектаУчета.ВидАвансов.Пустая() Тогда
		Результат.Удалить("ВидАвансов");
	КонецЕсли;
	
	Если ВидОбъектаУчета.ВидНДС.Пустая() Тогда
		Результат.Удалить("ВидНДС");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции	

