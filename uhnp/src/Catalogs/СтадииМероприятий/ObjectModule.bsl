#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Сбросим способ выбора поставщика для всех видов событий, кроме закупочной процедуры.
	Если ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ЦентрализованныеЗакупки") И ВидМероприятия <> Перечисления.ВидыМероприятий.ЗакупочнаяПроцедура Тогда
		Имя = "Перечисление.СпособыВыбораПоставщика.ПустаяСсылка";        
		СпособВыбораПоставщика = ПредопределенноеЗначение(Имя);
	КонецЕсли;	
	
	// Добавим идентификаторы вложений.
	Для Каждого ТекТипыИтоговыхДокументов Из ТипыИтоговыхДокументов Цикл
		Если Не ЗначениеЗаполнено(ТекТипыИтоговыхДокументов.ИдентификаторДокумента) Тогда
			ТекТипыИтоговыхДокументов.ИдентификаторДокумента = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

// Устанавливает всем вложениям текущей стадии флаг обязательности
// в значение ЗначениеФлагаВход.
Процедура УстановитьФлагОбязательностиВсемВложениям(ЗначениеФлагаВход = Истина) Экспорт
	Для Каждого ТекТипыИтоговыхДокументов Из ТипыИтоговыхДокументов Цикл
		ТекТипыИтоговыхДокументов.Обязательный = ЗначениеФлагаВход;
	КонецЦикла;	
КонецПроцедуры		// УстановитьФлагОбязательностиВсемВложениям()	

#КонецЕсли