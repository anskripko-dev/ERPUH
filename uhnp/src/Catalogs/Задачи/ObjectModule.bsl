
Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьРегистры();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ПометкаУдаления Тогда
		ОчиститьРегистры();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьРегистры()
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоРегистру = Новый Запрос();
	ЗапросПоРегистру.УстановитьПараметр("Задача", Ссылка);
		
	//РегистрСведений.ОтправленныеЗадачи
	ЗапросПоРегистру.Текст = 
	"ВЫБРАТЬ
	|	ОтправленныеЗадачи.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.ОтправленныеЗадачи КАК ОтправленныеЗадачи
	|ГДЕ
	|	ОтправленныеЗадачи.Задача = &Задача";
	
	ВыборкаПоРегистру = ЗапросПоРегистру.Выполнить().Выбрать();
	НаборЗаписей = РегистрыСведений.ОтправленныеЗадачи.СоздатьНаборЗаписей();
	
	Пока ВыборкаПоРегистру.Следующий() Цикл		
		НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(ВыборкаПоРегистру.ИдентификаторСообщения);
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;
		
КонецПроцедуры
