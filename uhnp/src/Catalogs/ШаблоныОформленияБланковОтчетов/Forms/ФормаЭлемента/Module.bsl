
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ДекорацияПредопределенный.Видимость        	= Ложь;

	
	Если Объект.Ссылка = Справочники.ШаблоныОформленияБланковОтчетов.Классический
		ИЛИ Объект.Ссылка = Справочники.ШаблоныОформленияБланковОтчетов.Основной Тогда	
		
		АналитическийБланкГенерацияМакетаУХСервер.ЗаполнитьСтандартныеШаблоныОформленияБланковОтчетов();
		
		Элементы.ТабличныйДокументМакет.ТолькоПросмотр 		= Истина;		
		Элементы.ФормаЗаписать.Видимость 					= Ложь;	
		Элементы.ФормаЗаписатьИЗакрыть.Видимость 			= Ложь;
		Элементы.ДекорацияПредопределенный.Видимость        = Истина;
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		МакетСтруктурыОтчета = Параметры.ЗначениеКопирования.Макет.Получить();
	Иначе	
		МакетСтруктурыОтчета = Объект.Ссылка.Макет.Получить();
	КонецЕсли;

	Если МакетСтруктурыОтчета = Неопределено Тогда
		ШаблонПоУмолчанию = Константы.ШаблонОформленияБланковОтчетовПоУмолчанию.Получить();
		
		Если НЕ ШаблонПоУмолчанию.Пустая() Тогда
			МакетСтруктурыОтчета = ШаблонПоУмолчанию.Макет.Получить();	
		Иначе	
			ТекущийОбъект = РеквизитФормыВЗначение("Объект");
			МакетСтруктурыОтчета = ТекущийОбъект.ПолучитьМакет("Основной");
		КонецЕсли;
	КонецЕсли;
	
	ТабличныйДокументМакет.Вывести(МакетСтруктурыОтчета);
	ТабличныйДокументМакет.ФиксацияСверху = МакетСтруктурыОтчета.ФиксацияСверху;
	ТабличныйДокументМакет.ФиксацияСлева = МакетСтруктурыОтчета.ФиксацияСлева;
	
	ТабличныйДокументМакетКэш.Очистить();
	ТабличныйДокументМакетКэш.Вывести(ТабличныйДокументМакет);
	ТабличныйДокументМакетКэш.ФиксацияСверху = ТабличныйДокументМакет.ФиксацияСверху;
	ТабличныйДокументМакетКэш.ФиксацияСлева = ТабличныйДокументМакет.ФиксацияСлева;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьМакетВХранилище(ТекущийОбъект.Макет, ТабличныйДокументМакет);
			
КонецПроцедуры

&НаСервере
Процедура СохранитьМакетВХранилище(ОбъектМакет, ТабличныйДокументМакет)
	
	Если ТипЗнч(ТабличныйДокументМакет) <> Тип("ТабличныйДокумент") Тогда
		Возврат;
	КонецЕсли;
		
	ОбъектМакет = Новый ХранилищеЗначения(ТабличныйДокументМакет, Новый СжатиеДанных(9));
		
КонецПроцедуры

&НаСервере
Процедура УстановитьМакетПоУмолчаниюНаСервере()
		
	Константы.ШаблонОформленияБланковОтчетовПоУмолчанию.Установить(Объект.Ссылка);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМакетПоУмолчанию(Команда)
	
	УстановитьМакетПоУмолчаниюНаСервере();
	
	Оповестить("ИзмененШаблонОформленияБланковОтчетовПоУмолчанию", Объект.Ссылка, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументМакетВыбор(Элемент, Область, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументМакетПриИзменении(Элемент)
	
	ТабличныйДокументМакетПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТабличныйДокументМакетПриИзмененииНаСервере()
	
	Если ТабличныйДокументМакетКэш.ШиринаТаблицы <> ТабличныйДокументМакет.ШиринаТаблицы
		ИЛИ ТабличныйДокументМакетКэш.ВысотаТаблицы <> ТабличныйДокументМакет.ВысотаТаблицы Тогда
		
		ТабличныйДокументМакет.Очистить();
		ТабличныйДокументМакет.Вывести(ТабличныйДокументМакетКэш);
		ТабличныйДокументМакет.ФиксацияСверху = ТабличныйДокументМакетКэш.ФиксацияСверху;
		ТабличныйДокументМакет.ФиксацияСлева = ТабличныйДокументМакетКэш.ФиксацияСлева;
	Иначе
		ТабличныйДокументМакетКэш.Очистить();
		ТабличныйДокументМакетКэш.Вывести(ТабличныйДокументМакет);
		ТабличныйДокументМакетКэш.ФиксацияСверху = ТабличныйДокументМакет.ФиксацияСверху;
		ТабличныйДокументМакетКэш.ФиксацияСлева = ТабличныйДокументМакет.ФиксацияСлева;
	КонецЕсли;
	
КонецПроцедуры
