
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
		
	ШаблонОформленияБланковОтчетовПоУмолчанию = Константы.ШаблонОформленияБланковОтчетовПоУмолчанию.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.Пометка Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда				
			Если НЕ ТекущиеДанные.Пометка Тогда
								
				ВыбранныеШаблоны = Новый Массив;	
				ВыбранныеШаблоны.Добавить(ВыбраннаяСтрока);
				
				УстановитьЗначениеКонстантыШаблонОформленияБланковОтчетов(ВыбраннаяСтрока);
								
				Список.Параметры.УстановитьЗначениеПараметра("ВыбранныеШаблоны", ВыбранныеШаблоны);
				Элементы.Список.Обновить();
								
			КонецЕсли;	
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеКонстантыШаблонОформленияБланковОтчетов(Значение)

	Константы.ШаблонОформленияБланковОтчетовПоУмолчанию.Установить(Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыбранныеШаблоны = Новый Массив;
	ВыбранныеШаблоны.Добавить(ШаблонОформленияБланковОтчетовПоУмолчанию);
	 
	Список.Параметры.УстановитьЗначениеПараметра("ВыбранныеШаблоны", ВыбранныеШаблоны);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Пометка.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Ссылка.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Код.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Пометка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ШрифтЯчейки = Элемент.Оформление.Элементы.Найти("Шрифт").Значение;
	ШрифтЯчейкиПолужирный = Новый Шрифт(ШрифтЯчейки,,, Истина,,,, 120);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЯчейкиПолужирный);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененШаблонОформленияБланковОтчетовПоУмолчанию" Тогда
		
		ВыбранныеШаблоны = Новый Массив;
		ВыбранныеШаблоны.Добавить(Параметр);
		
		Список.Параметры.УстановитьЗначениеПараметра("ВыбранныеШаблоны", ВыбранныеШаблоны);
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры
