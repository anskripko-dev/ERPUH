&НаКлиенте
Процедура СгенерироватьКонтекстноеМеню() Экспорт
	
	ОповещениеКонтекстноеМеню = Новый ОписаниеОповещения("ВыборДействияИзКонтекстногоМенюБланк", ЭтаФорма);
	
	СписокКоманд = Новый СписокЗначений;
	
	СписокКоманд.Добавить("ПоказатьСоставКолонок",Нстр("ru = 'Редактировать состав колонок'"),,БиблиотекаКартинок.Ресурс);
	СписокКоманд.Добавить("ПоказатьНастройкиТаблицыПоОсям",Нстр("ru = 'Редактировать расположение группировок'"),,БиблиотекаКартинок.ВнешнийИсточникДанныхКуб);
	СписокКоманд.Добавить("ПоказатьНастройкиПериодов",Нстр("ru = 'Редактировать настройки отображения периодов'"),,БиблиотекаКартинок.ПолучениеНовостейКаждые15Минут);
	
	ЭтаФорма.ПоказатьВыборИзМеню(ОповещениеКонтекстноеМеню,СписокКоманд,ЭтаФорма.ТекущийЭлемент);	
		
КонецПроцедуры	

&НаСервере
Процедура ВывестиМакетАналитическийБланкСводнаяТаблица(ИмяСтраницы)
	
	ТекущийОбъектВКэше 		=  КэшБланков.НайтиСтроки(Новый Структура("ИмяСтраницы",ИмяСтраницы))[0];

	тОбъектАБ 	=  ЭтаФорма[ТекущийОбъектВКэше.ИмяОбъекта];
	тМакет     	=  ЭтаФорма[ТекущийОбъектВКэше.ИмяМакета];
	тБланк      =  ТекущийОбъектВКэше.Бланк;
	
	ЗагрузитьТекущиеНастройкиСводнойТаблицыИзКэша(ТекущийОбъектВКэше);
	
	ДополнительныеНастройки = Неопределено;
	
	НомерОсновногоЯзыка=ПараметрыСеанса.ЯзыкОтчетности;

	Если ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Количество() = 0 Тогда
		УстановитьСостояниеНеИспользовать(тМакет,НСтр("ru = 'Не заполнен состав строк сводной таблицы'"));
		Возврат;
	КонецЕсли;	
	
	Если ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Количество() = 0 Тогда
		УстановитьСостояниеНеИспользовать(тМакет,НСтр("ru = 'Не заполнен состав колонок сводной таблицы'"));
		Возврат;
	КонецЕсли;	
	
	МакетОснование=Неопределено;	
	ОтчетАБ = РеквизитФормыВЗначение(ТекущийОбъектВКэше.ИмяОбъекта);
	ОтчетАБ.РежимСводнойТаблицы     = Истина;
	ОтчетАБ.Сценарий				= ОтборПоСценарию;
	ОтчетАБ.ПериодОтчета			= ПериодПланированияОтборНачало;
	ОтчетАБ.ПериодОтчетаОкончание 	= ПериодПланированияОтборОкончание;
	ОтчетАБ.Организация 			= ОтборПоОрганизации;
	ОтчетАБ.Проект 			 		= ОтборПоПроекту;
	ОтчетАБ.Валюта		            = ОтборПоВалюте;
	//ОтчетАБ.ЕдиницаИзмерения 		= Объект.ЕдиницаИзмерения;
	ОтчетАБ.логИзмененныхКомментариевАдрес = "";
		
	СтруктураПараметров     = Новый Структура;
	СтруктураПараметров.Вставить("ПолеТабличногоДокументаМакет",тМакет);
	СтруктураПараметров.Вставить("ОбновитьДанные",Истина);
	СтруктураПараметров.Вставить("ДополнительныеНастройки",ДополнительныеНастройки); 
	//СтруктураПараметров.Вставить("ТекущаяТочность",ТекущаяТочность);
	//СтруктураПараметров.Вставить("ТекущийДелитель",ТекущийДелитель);
	СтруктураПараметров.Вставить("НомерОсновногоЯзыка",НомерОсновногоЯзыка);
	СтруктураПараметров.Вставить("СтруктураНастроекВарианта",ПолучитьИзВременногоХранилища(СтруктураНастроекАналитическогоБланкаАдрес));
	СтруктураПараметров.Вставить("ЗаголовокСводнойТаблицы",тБланк);
	
	//Офоомление групп иерарахии по нужному шаблону
	СтруктураОформления  = Новый Структура;
	Обработки.АналитическийБланкСводнаяТаблица.УстановитьШаблонУсловногоОформления(СтруктураОформления);
	СтруктураПараметров.Вставить("СтруктураОформления",СтруктураОформления);
	
	ОтчетАБ.ПолучитьРезультирующийМакет(СтруктураПараметров);
	ОтчетАБ.НомерОсновногоЯзыка		= НомерОсновногоЯзыка;
	//ОтчетАБ.ТекущийДелитель = ТекущийДелитель;
	//ОтчетАБ.ТекущаяТочность = ТекущаяТочность;
	ОтчетАБ.ИдентификаторСеанса 	= ЭтаФорма.УникальныйИдентификатор;
	
	//ЗначениеВРеквизитФормы(ОтчетАБ,"ОбъектАналитическогоБланка");		
		
	СброситьСостояниеНеИспользовать(Элементы[ТекущийОбъектВКэше.ИмяМакета]);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыборДействияИзКонтекстногоМенюБланк(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		
		ЗагрузитьТекущиеНастройкиСводнойТаблицыИзКэша();
		
		Если  Результат.Значение = "ПоказатьСоставКолонок" Тогда
			ПоказатьСоставКолонок();	
		ИначеЕсли Результат.Значение = "ПоказатьНастройкиТаблицыПоОсям" Тогда	
			ПоказатьНастройкиТаблицыПоОсям();
		ИначеЕсли Результат.Значение = "ПоказатьНастройкиПериодов" Тогда	
			ПоказатьНастройкиПериодов();	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСоставКолонок()
	
	Если  ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Количество()>0 Тогда	
		Оповещение = Новый ОписаниеОповещения("ИзменениеСоставаКолонокЗавершение", ЭтаФорма);
		Параметры_ = Новый Структура("ВариантСводнойТаблицы,НастройкиСоставаКолонокСводнойТаблицыАдрес,НастройкиСоставаСтрокСводнойТаблицыАдрес"
		,ВариантСводнойТаблицы
		,ПолучитьНастройкиСоставаКолонокСводнойТаблицыАдрес()
		,ПолучитьНастройкиСоставаСтрокСводнойТаблицыАдрес());
		ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаНастройкиКолонок",Параметры_,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			
	Иначе		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Строки не выбраны. Заполните состав строк в режиме разработки бланка'"));
				
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеСоставаКолонокЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
	
	ПрименитьНастройкиСоставаКолонок(Результат);
	
	//УстановитьСостояниеНеИспользовать(НСтр("ru = 'Таблица не актуальна. Нажмите ""Сформировать (F5)"" для обновления данных.'"));
	 	
КонецПроцедуры

&НаСервере
Процедура ПрименитьНастройкиСоставаКолонок(Результат)
	
	ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиСоставаКолонокСводнойТаблицыАдрес));
	Обработки.АналитическийБланкСводнаяТаблица.CгенерироватьШаблонСводнойТаблицы(ЭтаФорма);
	ВыгрузитьТекущиеНастройкиСводнойТаблицыВКэш();
	ВывестиМакетАналитическийБланкСводнаяТаблица(ИмяТекущейСтраницы);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьНастройкиТаблицыПоОсям()
		
	Если  ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Количество()>0 Тогда	
		Оповещение = Новый ОписаниеОповещения("НастрйкаОсейЗавершение", ЭтаФорма);
		Параметры_ = Новый Структура("НастройкиРасположенияПолейСводнойТаблицыАдрес,НастройкиСоставаСтрокСводнойТаблицыАдрес,НастройкиПолейСводнойТаблицыАдрес,НастройкиВариантаСводнойТаблицыАдрес,НастройкиПроизводныхПолейСводнойТаблицыАдрес" 
		,ПолучитьНастройкиРасположенияПолейСводнойТаблицыАдрес()
		,ПолучитьНастройкиСоставаСтрокСводнойТаблицыАдрес()
		,ПолучитьНастройкиПолейСводнойТаблицыАдрес()
		,ПолучитьНастройкиВариантаСводнойТаблицыАдрес()
		,ПолучитьНастройкиПроизводныхПолейСводнойТаблицыАдрес());
		
		ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаНастройкиРасположенияИзмерений", 
		Параметры_,ЭтаФорма,Истина,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 		
	Иначе		
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(Нстр("ru = 'Строки не выбраны. Заполните состав строк в режиме разработки бланка'"));
				
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура НастрйкаОсейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если  Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;	
			
	ПрименитьНастройкиРасположенияПолей(Результат);
			
КонецПроцедуры

&НаСервере
Процедура ПрименитьНастройкиРасположенияПолей(Результат)
	
	ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиРасположенияПолейСводнойТаблицыАдрес));
	ЭтаФорма["НастройкиПолейСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиПолейСводнойТаблицыАдрес));
	ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиВариантаСводнойТаблицыАдрес));
	
	ВыгрузитьТекущиеНастройкиСводнойТаблицыВКэш();

	Обработки.АналитическийБланкСводнаяТаблица.CгенерироватьШаблонСводнойТаблицы(ЭтаФорма);
	ВыгрузитьТекущиеНастройкиСводнойТаблицыВКэш();
	ВывестиМакетАналитическийБланкСводнаяТаблица(ИмяТекущейСтраницы);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьНастройкиПериодов()
	

	Оповещение = Новый ОписаниеОповещения("ИзменениеНастройкиПериодовЗавершение", ЭтаФорма);
	
	Параметры_ = Новый Структура("ВариантСводнойТаблицы,НастройкиПериодовСводнойТаблицыАдрес,ИспользоватьДинамическийГоризонт,Организации,УправлениеПериодом"
	,ВариантСводнойТаблицы
	,ПолучитьНастройкиПериодовСводнойТаблицыАдрес()
	,Ложь
	,тОрганизации
	,тУправленияПериодом);
	
	ОткрытьФорму("Обработка.АналитическийБланкСводнаяТаблица.Форма.ФормаНастройкиШкалыПериодов",Параметры_,ЭтаФорма,Истина,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	 
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеНастройкиПериодовЗавершение(Результат, ДополнительныеПараметры) Экспорт      
	
	Если Результат = Неопределено  Или Результат = КодВозвратаДиалога.Отмена  Тогда
		Возврат;
	КонецЕсли;	
				
	ПрименитьИзменениеНастройкиПериодов(Результат);
			
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзменениеНастройкиПериодов(Результат)
	
	ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Загрузить(ПолучитьИзВременногоХранилища(Результат.НастройкиПериодовСводнойТаблицыАдрес));		
	Обработки.АналитическийБланкСводнаяТаблица.CгенерироватьШаблонСводнойТаблицы(ЭтаФорма);
	ВыгрузитьТекущиеНастройкиСводнойТаблицыВКэш(); 
	ВывестиМакетАналитическийБланкСводнаяТаблица(ИмяТекущейСтраницы);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТекущиеНастройкиСводнойТаблицыИзКэша(ТекущийОбъектВКэшеВход = Неопределено)

	Если ТекущийОбъектВКэшеВход = Неопределено Тогда
		ИмяТекущейСтраницы 		=  ЭтаФорма.ТекущийЭлемент.Родитель.Родитель.Имя;
		ОбъектыВКэше 			=  КэшБланков.НайтиСтроки(Новый Структура("ИмяСтраницы",ИмяТекущейСтраницы));
		
		Если ОбъектыВКэше.Количество()=1 Тогда
			ТекущийОбъектВКэше =  ОбъектыВКэше[0];
		Иначе	
			Возврат;
		КонецЕсли;	
	Иначе	
		ТекущийОбъектВКэше = ТекущийОбъектВКэшеВход;
	КонецЕсли;
		
	НастройкиВариантаПоКэшу 		= ПолучитьИзВременногоХранилища(ТекущийОбъектВКэше.АдресПараметровСводнойТаблицы);
	ЭтаФорма["НастройкиВариантаСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиВариантаСводнойТаблицы);
	ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиПериодовСводнойТаблицы);
	ЭтаФорма["НастройкиПолейСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиПолейСводнойТаблицы);
	ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиРасположенияПолейСводнойТаблицы);
	ЭтаФорма["НастройкиСоставаАналитикиСтрокСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиСоставаАналитикиСтрокСводнойТаблицы);
	ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиСоставаКолонокСводнойТаблицы);
	ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Загрузить(НастройкиВариантаПоКэшу.НастройкиСоставаСтрокСводнойТаблицы);
	
	ЗначениеВРеквизитФормы(НастройкиВариантаПоКэшу.НастройкиОтборов,"НастройкиОтборов");
	
	СтруктураНастроекАналитическогоБланкаАдрес = ТекущийОбъектВКэше.СтруктураНастроекАналитическогоБланкаАдрес;
	
		
КонецПроцедуры	

&НаСервере
Процедура ВыгрузитьТекущиеНастройкиСводнойТаблицыВКэш()

	ТекущееИмяГруппы 		=  ЭтаФорма.ТекущийЭлемент.Родитель.Родитель.Имя;
	ТекущийОбъектВКэше 		=  КэшБланков.НайтиСтроки(Новый Структура("ИмяСтраницы",ТекущееИмяГруппы));
	
	Если ТекущийОбъектВКэше.Количество()=1 Тогда
				
		СтруктураТаблицСводнойТаблицы = Новый Структура;
		СтруктураТаблицСводнойТаблицы.Вставить("НастройкиВариантаСводнойТаблицы",ЭтаФорма.НастройкиВариантаСводнойТаблицы.Выгрузить());
		СтруктураТаблицСводнойТаблицы.Вставить("НастройкиОтборов",РеквизитФормыВЗначение("НастройкиОтборов"));
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиПериодовСводнойТаблицы",ЭтаФорма.НастройкиПериодовСводнойТаблицы.Выгрузить());
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиПолейСводнойТаблицы",ЭтаФорма.НастройкиПолейСводнойТаблицы.Выгрузить());
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиРасположенияПолейСводнойТаблицы",ЭтаФорма.НастройкиРасположенияПолейСводнойТаблицы.Выгрузить());
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиСоставаАналитикиСтрокСводнойТаблицы",ЭтаФорма.НастройкиСоставаАналитикиСтрокСводнойТаблицы.Выгрузить());
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиСоставаКолонокСводнойТаблицы",ЭтаФорма.НастройкиСоставаКолонокСводнойТаблицы.Выгрузить());
        СтруктураТаблицСводнойТаблицы.Вставить("НастройкиСоставаСтрокСводнойТаблицы",ЭтаФорма.НастройкиСоставаСтрокСводнойТаблицы.Выгрузить());
	
		ТекущийОбъектВКэше[0].АдресПараметровСводнойТаблицы = ПоместитьВоВременноеХранилище(СтруктураТаблицСводнойТаблицы,ЭтаФорма.УникальныйИдентификатор);
		ТекущийОбъектВКэше[0].СтруктураНастроекАналитическогоБланкаАдрес = ЭтаФорма.СтруктураНастроекАналитическогоБланкаАдрес;
				
	КонецЕсли;	

	
КонецПроцедуры	

&НаСервере
Функция ПолучитьНастройкиРасположенияПолейСводнойТаблицыАдрес()
	
	Возврат ПоместитьВоВременноеХранилище(ЭтаФорма["НастройкиРасположенияПолейСводнойТаблицы"].Выгрузить(),ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиСоставаКолонокСводнойТаблицыАдрес()
	
	Возврат ПоместитьВоВременноеХранилище(ЭтаФорма["НастройкиСоставаКолонокСводнойТаблицы"].Выгрузить(),ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиСоставаСтрокСводнойТаблицыАдрес()
	
	Возврат ПоместитьВоВременноеХранилище(ЭтаФорма["НастройкиСоставаСтрокСводнойТаблицы"].Выгрузить(),ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиПериодовСводнойТаблицыАдрес()
	
	Возврат ПоместитьВоВременноеХранилище(ЭтаФорма["НастройкиПериодовСводнойТаблицы"].Выгрузить(),ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

