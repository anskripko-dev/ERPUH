
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВидДокумента	= Параметры.ВидДокумента; 
	СписокВыбранных = Параметры.СписокВыбранных;
	
	СписокРеквизитов.Очистить();
	МетаданныеДокумента = Метаданные.Документы[ВидДокумента].Реквизиты;
	
	Для каждого Метаданное Из МетаданныеДокумента Цикл
		
		ИмяМетаданного	= Метаданное.Имя;			
		Пометка = ?(Не СписокВыбранных.НайтиПоЗначению(ИмяМетаданного) = Неопределено,Истина, Ложь);			 
		
		СписокРеквизитов.Добавить(ИмяМетаданного,Метаданное.Представление(),Пометка);
			
	КонецЦикла; 
	
	СписокРеквизитов.СортироватьПоПредставлению();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	СписокВыбранных.Очистить(); 
	
	Для Каждого Элемент Из СписокРеквизитов Цикл
		Если Элемент.Пометка Тогда
			СписокВыбранных.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(СписокВыбранных);

КонецПроцедуры

#КонецОбласти 
