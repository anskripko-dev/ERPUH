#Область ОбработчикиСобытийФормы
 
 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//пока ограничим выбор, т.к. в регистрах, связанных с механизмом СФД он тоже ограничен	
	ПоказатьПолныйСписокДокументов = Ложь;	
	ВидДокументаСписокВыбора = Элементы.ВидДокумента.СписокВыбора; 
	Если ПоказатьПолныйСписокДокументов Тогда
		Для Каждого ОбъектМДДокумент Из Метаданные.Документы Цикл
			ВидДокументаСписокВыбора.Добавить(ОбъектМДДокумент.Имя,ОбъектМДДокумент.Синоним);	
		Конеццикла;	
	Иначе
		ВидДокументаСписокВыбора.Добавить("ПередачаТоваровМеждуОрганизациями","Передача товаров между организациями");
		ВидДокументаСписокВыбора.Добавить("РеализацияТоваровУслуг","Реализация товаров и услуг");	
		//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874
		ВидДокументаСписокВыбора.Добавить("ПриобретениеТоваровУслуг","Приобретение товаров и услуг");
		//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874 
		//НАЧАЛО Блинова М.А. 10.01.2025 Выполнение задач №000052052
		ВидДокументаСписокВыбора.Добавить("ПередачаТоваровХранителю","Передача товаров");
		//КОНЕЦ Блинова М.А. 10.01.2025 Выполнение задач №000052052		
	КонецЕсли;
	ВидДокументаСписокВыбора.СортироватьПоПредставлению();
	
	ПереченьДоступныхЗначений(Объект.ВидДокумента,"ТабличныеЧасти","ПереченьРеквизитовКопированиеИмяТабличнойЧастиПриемник");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановкаДоступностиДополнительныхНастроек();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	УстановкаДоступностиДополнительныхНастроек();
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если Объект.ПереченьРеквизитовПодстановка.Количество()>0
		Или Объект.ПереченьРеквизитовКопирование.Количество()>0 Тогда
		
		//СтандартнаяОбработка = Ложь;
		ТекстВопроса = "Табличные части будут очищены. Продолжить?";  
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
		ДопПараметры.Вставить("ТекущееЗначение", Объект.ВидДокумента);
		Оповещение = Новый ОписаниеОповещения("ВопросОчиститьТЧЗавершение", ЭтотОбъект, ДопПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ПереченьДоступныхЗначений(ВыбранноеЗначение, "ТабличныеЧасти","ПереченьРеквизитовКопированиеИмяТабличнойЧастиПриемник");
		ПереченьДоступныхЗначений(ВыбранноеЗначение, "Реквизиты","ПереченьРеквизитовКопированиеИмяРеквизитаПриемник"); 
		//закладка Дополнительно - сбрасываем все настройки
		Объект.РегистрацияСчетаФактуры		= Ложь;
		Объект.ПересчетСуммДокументаВВалюту = Ложь;  
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереченьРеквизитовПодстановкаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина; 
	
	Если ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ЭтаФорма.Модифицированность = Истина;
		СписокВыбранныхРеквизитов = ПолучитьСписокВыбранныхРеквизитов();	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПереченьРеквизитовПодстановкаПередНачаломДобавления_Завершение",ЭтотОбъект);
		ПараметрыОткрытия = Новый Структура("ВидДокумента, СписокВыбранных", Объект.ВидДокумента, СписокВыбранныхРеквизитов);	
		ОткрытьФорму("Справочник.тн_СхемыФормированияДокументов.Форма.ФормаВыбораРеквизитов",ПараметрыОткрытия, , , , ,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите сначала Вид документа!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереченьРеквизитовПодстановкаИмяРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ложь;
	
	СписокВыбранныхРеквизитов = ПолучитьСписокВыбранныхРеквизитов();	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПереченьРеквизитовПодстановкаПередНачаломДобавления_Завершение",ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура("ВидДокумента, СписокВыбранных", Объект.ВидДокумента, СписокВыбранныхРеквизитов);	
	ОткрытьФорму("Справочник.тн_СхемыФормированияДокументов.Форма.ФормаВыбораРеквизитов",ПараметрыОткрытия, , , , ,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ПереченьРеквизитовКопированиеИмяРеквизитаПриемникПриИзменении(Элемент)
	
	ТекущиеДанные		= Элементы.ПереченьРеквизитовКопирование.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ИмяРеквизитаИсточник)
			И ЗначениеЗаполнено(ТекущиеДанные.ИмяРеквизитаПриемник)тогда
			ТекущиеДанные.ИмяРеквизитаИсточник	= ТекущиеДанные.ИмяРеквизитаПриемник;
		КонецЕсли;  
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереченьРеквизитовКопированиеИмяТабличнойЧастиПриемникПриИзменении(Элемент)
	
	ТекущиеДанные		= Элементы.ПереченьРеквизитовКопирование.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено Тогда
		//1. задаем аналогичное имя ТЧ источника
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ИмяТабличнойЧастиИсточник)
			И ЗначениеЗаполнено(ТекущиеДанные.ИмяТабличнойЧастиПриемник)тогда
			ТекущиеДанные.ИмяТабличнойЧастиИсточник	= ТекущиеДанные.ИмяТабличнойЧастиПриемник;
		КонецЕсли;  
		
		//2. формируем список доступных реквизитов ТЧ приемника
		ПереченьРеквизитовТабличнойЧастиПриемника(ТекущиеДанные.ИмяТабличнойЧастиПриемник);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереченьРеквизитовКопированиеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	ТекущиеДанные = Элемент.ТекущиеДанные; 
	Если Копирование И НЕ ТекущиеДанные = Неопределено
		И ЗначениеЗаполнено(ТекущиеДанные.ИмяТабличнойЧастиПриемник) Тогда
		
		ПереченьРеквизитовТабличнойЧастиПриемника(ТекущиеДанные.ИмяТабличнойЧастиПриемник);  
		
	Иначе
		ПереченьДоступныхЗначений(Объект.ВидДокумента,"Реквизиты","ПереченьРеквизитовКопированиеИмяРеквизитаПриемник");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчетСуммДокументаВВалютуПриИзменении(Элемент)
	Элементы.ВалютаФормируемогоДокумента.Доступность = Объект.ПересчетСуммДокументаВВалюту;
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПереченьРеквизитовПодстановкаПередНачаломДобавления_Завершение(СписокВыбранныхРеквизитов, ДопПараметры) Экспорт

	Если НЕ СписокВыбранныхРеквизитов=Неопределено Тогда
		
		//сначала удалим лишние реквизиты:
		НомерСтроки	= Объект.ПереченьРеквизитовПодстановка.Количество()-1;
		Пока НомерСтроки >= 0 цикл
			СтрокаТЧ = Объект.ПереченьРеквизитовПодстановка.Получить(НомерСтроки);
			Если СписокВыбранныхРеквизитов.НайтиПоЗначению(СтрокаТЧ.ИмяРеквизита) = Неопределено Тогда
				Объект.ПереченьРеквизитовПодстановка.Удалить(СтрокаТЧ);
			КонецЕсли;
			НомерСтроки	= НомерСтроки - 1;
		Конеццикла;	
		
		//добавляем новые выбранные реквизиты
		СписокИмеющихсяВТЧРеквизитов = ПолучитьСписокВыбранныхРеквизитов(); 	
		Для Каждого ЭлементСЗ Из СписокВыбранныхРеквизитов Цикл			
			Если СписокИмеющихсяВТЧРеквизитов.НайтиПоЗначению(ЭлементСЗ.Значение) = Неопределено Тогда		
				Строка = Объект.ПереченьРеквизитовПодстановка.Добавить();
				Строка.ИмяРеквизита =  ЭлементСЗ.Значение;						
			КонецЕсли;				
		КонецЦикла;	
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьТЧЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		Объект.ВидДокумента = ДополнительныеПараметры.ВыбранноеЗначение; 
		ОбновлениеДанныхСправочникаНаСервере();  
		//закладка Дополнительно - сбрасываем все настройки
		Объект.РегистрацияСчетаФактуры		= Ложь;
		Объект.ПересчетСуммДокументаВВалюту = Ложь; 
		//НАЧАЛО Блинова М.А. 13.01.2025 Выполнение задач №000052052  
		Объект.АгентскаяСхема = Ложь;
		//КОНЕЦ Блинова М.А. 13.01.2025 Выполнение задач №000052052
	Иначе
		Объект.ВидДокумента = ДополнительныеПараметры.ТекущееЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере  
//Процедура формирует список доступных реквизитов табличной части
Процедура ПереченьРеквизитовТабличнойЧастиПриемника(ИмяТабличнойЧастиПриемник)
	
	Если ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		
		СписокДоступныхЗначений = Элементы.ПереченьРеквизитовКопированиеИмяРеквизитаПриемник.СписокВыбора;
		СписокДоступныхЗначений.Очистить();	
		
		МетаданныеДокумента	= Метаданные.Документы[Объект.ВидДокумента];
		
		//если табличная часть не заполнена выдаем в список реквизиты шапки
		Если Не ЗначениеЗаполнено(ИмяТабличнойЧастиПриемник) Тогда
			ПереченьДоступныхЗначений(Объект.ВидДокумента,"Реквизиты", "ПереченьРеквизитовКопированиеИмяРеквизитаПриемник");						
		Иначе
			Для Каждого РеквизитТабличнойТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти[ИмяТабличнойЧастиПриемник].Реквизиты Цикл
				СписокДоступныхЗначений.Добавить(РеквизитТабличнойТабличнаяЧасть.Имя,		РеквизитТабличнойТабличнаяЧасть.Синоним);	
			КонецЦикла;	
		КонецЕсли;	
		
		СписокДоступныхЗначений.СортироватьПоПредставлению();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
//Процедура формирует список доступных реквизитов или список доступных табличных частей для выбора
//ИмяМетаданного = Реквизиты/ТабличныеЧасти
Процедура ПереченьДоступныхЗначений(ВидДокумента, ИмяМетаданного, ИмяЭлементаФормы)
	
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		
		СписокДоступныхЗначений = Элементы[ИмяЭлементаФормы].СписокВыбора;
		СписокДоступныхЗначений.Очистить();
		
		МетаданныеДокумента	= Метаданные.Документы[ВидДокумента];
		Для Каждого Значение Из МетаданныеДокумента[ИмяМетаданного] Цикл
			СписокДоступныхЗначений.Добавить(Значение.Имя, Значение.Синоним);	
		КонецЦикла;	 
		
		Если ИмяМетаданного = "Реквизиты" Тогда
			СписокДоступныхЗначений.Добавить("Дата", "Дата");	
		КонецЕсли;
		
		СписокДоступныхЗначений.СортироватьПоПредставлению();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыбранныхРеквизитов()
	
	ТЗ = Объект.ПереченьРеквизитовПодстановка.Выгрузить();
	СписокВыбранныхРеквизитов = Новый СписокЗначений;
	СписокВыбранныхРеквизитов.ЗагрузитьЗначения(ТЗ.ВыгрузитьКолонку("ИмяРеквизита"));	
	
	Возврат СписокВыбранныхРеквизитов
	
КонецФункции

&НаСервере
Процедура ОбновлениеДанныхСправочникаНаСервере()
	
	Объект.ПереченьРеквизитовПодстановка.Очистить();
	Объект.ПереченьРеквизитовКопирование.Очистить();
	ПереченьДоступныхЗначений(Объект.ВидДокумента,"ТабличныеЧасти","ПереченьРеквизитовКопированиеИмяТабличнойЧастиПриемник");
	ПереченьДоступныхЗначений(Объект.ВидДокумента,"Реквизиты","ПереченьРеквизитовКопированиеИмяРеквизитаПриемник");  
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаДоступностиДополнительныхНастроек();
	
	Элементы.РегистрацияСчетаФактуры.Доступность=
						//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874
						Объект.ВидДокумента = "РеализацияТоваровУслуг"
						Или Объект.ВидДокумента = "ПриобретениеТоваровУслуг" Или
						//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874
						Объект.ВидДокумента = "ПередачаТоваровМеждуОрганизациями"; 
	Элементы.ГруппаПересчетСуммДокументаВВалюту.Доступность =
						//НАЧАЛО Качикина 27.09.2024 Выполнение задач №000050874
						Объект.ВидДокумента = "РеализацияТоваровУслуг"
						Или Объект.ВидДокумента = "ПриобретениеТоваровУслуг" Или
						//КОНЕЦ Качикина 27.09.2024 Выполнение задач №000050874
						Объект.ВидДокумента = "ПередачаТоваровМеждуОрганизациями";
	Элементы.ВалютаФормируемогоДокумента.Доступность = Объект.ПересчетСуммДокументаВВалюту;
						
КонецПроцедуры

#КонецОбласти
