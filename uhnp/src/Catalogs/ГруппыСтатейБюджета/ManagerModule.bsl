Функция СписокЗначенийГруппСтатей(ВидБюджета)  Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыСтатейБюджета.Ссылка КАК ГруппаСтатьи,
	|	ГруппыСтатейБюджета.Наименование КАК Наименование,
	|	ГруппыСтатейБюджета.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.ГруппыСтатейБюджета КАК ГруппыСтатейБюджета
	|ГДЕ
	|	ГруппыСтатейБюджета.ПометкаУдаления = ЛОЖЬ
	|	И ГруппыСтатейБюджета.Владелец = &ВидБюджета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппыСтатейБюджета.Наименование";
	
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый СписокЗначений;  
	Результат.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ГруппаСтатьи"));  
	Результат.Вставить(0,Справочники.ГруппыСтатейБюджета.ПустаяСсылка(), Нстр("ru = '<Исключить из группы>'"));

	Возврат Результат;
	
КонецФункции 

