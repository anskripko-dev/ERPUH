
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВидФИ = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ПараметрКоманды, "ВидФинансовогоИнструмента");	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ФИ, ВидФИ", ПараметрКоманды, ВидФИ));
		
	ОткрытьФорму("Справочник.ПараметрыУчетаФИРСБУ.ФормаСписка", 
				ПараметрыФормы, 
				ПараметрыВыполненияКоманды.Источник, 
				Истина, 
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка
			);

КонецПроцедуры
