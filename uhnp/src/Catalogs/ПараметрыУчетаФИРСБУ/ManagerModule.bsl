Процедура ДозаполнитьСчетаДокументов(Параметры = Неопределено) Экспорт

	ЗаполнитьПоУмолчанию();
	
	ТипыДокументов = Метаданные.РегистрыНакопления
		.РасчетыСКонтрагентамиГрафики.Измерения.ВерсияГрафика.Тип.Типы();
		
	ШаблонЗапроса =	ТекстЗапроса_СчетаУчетаДляДобавления();
		
	Для каждого ТекТип Из ТипыДокументов Цикл
		
		мдДокумента = Метаданные.НайтиПоТипу(ТекТип);
		Если мдДокумента.ТабличныеЧасти.Найти("СчетаУчета") = Неопределено Тогда
			Продолжить;	//без счетов учета	
		КонецЕсли;
		
		Поиск = "ВидДоговораУХ.ВидФинансовогоИнструмента";
		Если СтрНачинаетсяС(мдДокумента.Имя, "ВерсияСоглашения") Тогда
			Замена = Поиск;
		Иначе
			Замена = "ФинансовыйИнструмент.ВидФинансовогоИнструмента";			
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, Поиск, Замена);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВерсияСоглашенияКредит", мдДокумента.Имя);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		
		ВыборкаДок = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДок.Следующий() Цикл
			
			ДокОбъект = ВыборкаДок.Документ.ПолучитьОбъект();
			Выборка = ВыборкаДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока Выборка.Следующий() Цикл
				НовСтрока = ДокОбъект.СчетаУчета.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
			КонецЦикла; 
			
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
			Исключение
				
				ЗаписьЖурналаРегистрации(
						"УХ.ФИРСБУ.ОбновлениеСчетаУчета",
						УровеньЖурналаРегистрации.Ошибка,
						мдДокумента,
						ВыборкаДок.Документ,
						НСтр("ru = 'Ошибка обновления счета учета ФИ РСБУ'"),
						РежимТранзакцииЗаписиЖурналаРегистрации.Независимая
					);
				
			КонецПопытки;
			
		КонецЦикла; 
				
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПоУмолчанию(ЗаменятьУстановленные = Истина, ОбновитьВидыСчетовФИ = Истина) Экспорт
	
	Если ОбновитьВидыСчетовФИ Тогда
		Справочники.ВидыСчетовФИ.ОбновлениеПредопределенных();
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса_ЗаполнитьПоУмолчанию());
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	РезультатЗапросаОтключенные = РезультатПакет.Получить(РезультатПакет.ВГраница()-1);
	ПометитьОтключенные(РезультатЗапросаОтключенные);
	
	ВыборкаВидФИ = РезультатПакет.Получить(РезультатПакет.ВГраница()).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВидыБУЕРП = Перечисления.ВидыФинансовыхИнструментов.ВидыБУЕРП();
	Пока ВыборкаВидФИ.Следующий() Цикл
		
		Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
			Если ВидыБУЕРП.НайтиПоЗначению(ВыборкаВидФИ.ВидФИ) <> Неопределено Тогда
				Продолжить;//стандартные счета и начисления ЕРП
			КонецЕсли;
		КонецЕсли;
		
		ВыборкаПараметрыУчетаФИ = ВыборкаВидФИ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПараметрыУчетаФИ.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаПараметрыУчетаФИ.ПараметрыУчетаФИ) Тогда
				Объект = ВыборкаПараметрыУчетаФИ.ПараметрыУчетаФИ.ПолучитьОбъект();
				
				КэшСтарых = Объект.СчетаУчета.Выгрузить();
				КэшСтарых.Индексы.Добавить("ВидСчетаФИ");
				Объект.СчетаУчета.Очистить();
				
			Иначе 
				Объект = Справочники.ПараметрыУчетаФИРСБУ.СоздатьЭлемент();
				Объект.УстановитьНовыйКод();
				ЗаполнитьЗначенияСвойств(Объект, ВыборкаПараметрыУчетаФИ);
				
				КэшСтарых = Объект.СчетаУчета.Выгрузить();
				
			КонецЕсли;
						
			ВыборкаВидСчета = ВыборкаПараметрыУчетаФИ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ЕстьИзменения = КэшСтарых.Количество() <> ВыборкаВидСчета.Количество();
			Пока ВыборкаВидСчета.Следующий() Цикл
				
				СтрокаТаб = Объект.СчетаУчета.Добавить();
				
				СтрокаСтарая = КэшСтарых.Найти(ВыборкаВидСчета.ВидСчетаФИ, "ВидСчетаФИ");
				Если СтрокаСтарая = Неопределено Тогда
					СтрокаТаб.ВидСчетаФИ = ВыборкаВидСчета.ВидСчетаФИ;
				Иначе
					ЗаполнитьЗначенияСвойств(СтрокаТаб, СтрокаСтарая);
				КонецЕсли;
				
				Если СтрокаТаб.Счет = ВыборкаВидСчета.Счет Тогда
					Продолжить;// счет не был изменен
				КонецЕсли;
				
				ЕстьИзменения = Истина;
				СтрокаТаб.Счет = ВыборкаВидСчета.Счет;
				Для каждого СтрокаВид Из ВыборкаВидСчета.Счет.ВидыСубконто Цикл
					
					ИмяКолонки = "Субконто" + СтрокаВид.НомерСтроки;
					
					СтрокаТаб[ИмяКолонки] = СтрокаВид.ВидСубконто.ТипЗначения.ПривестиЗначение(СтрокаТаб[ИмяКолонки]);
					
				КонецЦикла;

			КонецЦикла;
			
			Если ЕстьИзменения Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ПометитьБУЕРП(ВидыБУЕРП);
	
КонецПроцедуры

Процедура ПеренестиИзРегистра() Экспорт

