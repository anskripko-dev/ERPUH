
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ОбъектИсточник = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЗначениеКопирования");
		ПодготовитьФормуНаСервере(ОбъектИсточник);
	КонецЕсли;

	УправлениеФормой(ЭтаФорма);	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если (ПараметрыУчетаДля = 0) Тогда 
		ТекущийОбъект.ФИ = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ПодготовитьФормуНаСервере(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ПодготовитьФормуНаСервере(ТекущийОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура СчетаУчетаПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.СчетаУчета.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, "Счет", ТекущаяСтрока, "СчетаУчета", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыУчетаДляПриИзменении(Элемент)
	
	Если (ПараметрыУчетаДля = 1) Тогда 
		
		Если Объект.ФИ <> КэшируемыеЗначения.ИсточникВидимостиСчетов Тогда
			КэшируемыеЗначения.Вставить("ИсточникВидимостиСчетов", Неопределено);//заполним счета
		КонецЕсли;
		
	КонецЕсли;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидФИПриИзменении(Элемент)
	УправлениеФормой(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ФИПриИзменении(Элемент)
	
	Если Объект.ФИ <> КэшируемыеЗначения.ИсточникВидимостиСчетов Тогда
		КэшируемыеЗначения.Вставить("ИсточникВидимостиСчетов", Неопределено);//заполним счета
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ФИ) Тогда
	
		ПутьВидФИ = "ВидДоговораУХ.ВидФинансовогоИнструмента";
		Если ТипЗнч(Объект.ФИ) = Тип("СправочникСсылка.ЦенныеБумаги") Тогда
			ПутьВидФИ = "ВидФинансовогоИнструмента";
		КонецЕсли;
		
		Объект.ВидФИ = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(Объект.ФИ, ПутьВидФИ);
		
	Иначе 
		
		Объект.ВидФИ = Неопределено;
	
	КонецЕсли;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АктивОбязательствоПриИзменении(Элемент)
	
	Объект.Актив = (АктивОбязательство = 1);
	КэшируемыеЗначения.Вставить("ИсточникВидимостиСчетов", Неопределено);//заполним счета

	УправлениеФормой(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СчетаУчетаСчетПриИзменении(Элемент)
	ТекущаяСтрока = Объект.СчетаУчета.НайтиПоИдентификатору(Элементы.СчетаУчета.ТекущаяСтрока);
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, "Счет", ТекущаяСтрока, "СчетаУчета", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииСчета(Элемент) Экспорт
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтаФорма, Элемент.Имя, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере(ТекущийОбъект = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = ЭтотОбъект.Объект;	
	КонецЕсли;
	
	АктивОбязательство = ТекущийОбъект.Актив;
	ПараметрыУчетаДля = ЗначениеЗаполнено(ТекущийОбъект.ФИ);
	НовыйИсточник = ?(ЗначениеЗаполнено(Объект.ФИ), Объект.ФИ, Объект.ВидФИ);
	
	ФинансовыеИнструментыФормы.ПриСозданииНаСервере_СчетаУчета(ЭтотОбъект);
	
	КэшируемыеЗначения.Вставить("ИсточникВидимостиСчетов", 	?(Параметры.Ключ.Пустая(), Неопределено, НовыйИсточник));// при повторном открытии не заполняем счета
	КэшируемыеЗначения.Вставить("ИменаСубконто", 	ПолучитьИменаСубконто());
	КэшируемыеЗначения.Вставить("Организация", 		Справочники.Организации.ПустаяСсылка());
	КэшируемыеЗначения.Вставить("ВидыЦенныхБумаг", 	Перечисления.ВидыФинансовыхИнструментов.ПолучитьВидыЦенныхБумаг().ВыгрузитьЗначения());
	
	Для каждого ТекущаяСтрока Из Объект.СчетаУчета Цикл
		МСФОКлиентСерверУХ.УстановитьДоступностьСубконто(ТекущаяСтрока.Счет, ТекущаяСтрока, КэшируемыеЗначения.ИменаСубконто);
		МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(ЭтотОбъект, "Счет", ТекущаяСтрока, "СчетаУчета", Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Если Форма.ПараметрыУчетаДля = 0 Тогда
		ЭтоЦБ = Форма.КэшируемыеЗначения.ВидыЦенныхБумаг.Найти(Объект.ВидФИ) <> Неопределено;
	Иначе	
		ЭтоЦБ = (ТипЗнч(Объект.ФИ) = Тип("СправочникСсылка.ЦенныеБумаги"));
	КонецЕсли;
		
	Элементы.ВидФИ.Видимость = Форма.ПараметрыУчетаДля = 0;
	Элементы.ФИ.Видимость = Форма.ПараметрыУчетаДля = 1;
	Элементы.АктивОбязательство.Видимость = ЭтоЦБ;
	
	ФинансовыеИнструментыФормыКлиентСервер.УправлениеФормой_СчетаУчета(Форма, , Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИменаСубконто() Экспорт 

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	
	Субконто.Вставить(1, "Субконто1");
	Субконто.Вставить(2, "Субконто2");
	Субконто.Вставить(3, "Субконто3");
	
	Результат.Вставить("Счет", Субконто);	
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
