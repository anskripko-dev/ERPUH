
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИмяДокумента")
		И СтрНачинаетсяС(Параметры.ИмяДокумента, "ВерсияСоглашения") Тогда
		
		ЭтотОбъект.Заголовок = НСтр("ru = 'Счета учета версии соглашения'");
		ЭтотОбъект.АвтоЗаголовок = Ложь;
		
	КонецЕсли;
	
	Если Параметры.Свойство("РежимРедактирования")
		И Параметры.РежимРедактирования = Ложь Тогда
		
		ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + НСтр("ru = ' (только для чтения)'");
		
		Элементы.СчетаУчета.ТолькоПросмотр = Истина;
		Элементы.ФормаОК.Доступность = Ложь;
		Элементы.ФормаЗаполнитьПоУмолчанию.Доступность = Ложь;
		
	КонецЕсли;
	
	КэшируемыеЗначения = Новый Структура("ИмяДокумента, Организация, СчетаУчета, КлючевыеСубконто");
	ЗаполнитьЗначенияСвойств(КэшируемыеЗначения, Параметры);
	КэшируемыеЗначения.Вставить("ИменаСубконто", ПолучитьИменаСубконто());
	
	ЗаполнитьСчетаУчетаИзОбъекта(Параметры.СчетаУчета);
	
	МСФОКлиентСерверУХ.УсловноеОформлениеКлючевыхСубконто(
		ЭтотОбъект, "СчетаУчета");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(ВладелецФормы) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Элементы.ФормаЗаполнитьПоУмолчанию.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Модифицированность Тогда
		
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru='Данные не сохранены.
			|Нажмите кнопку [ОК] или [Отмена].'");
		
		Если Не ЗавершениеРаботы Тогда
			ПоказатьПредупреждение(, ТекстПредупреждения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура СчетаУчетаСчетПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.СчетаУчета.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(
		ЭтотОбъект, "Счет", ТекущаяСтрока, "СчетаУчета", Ложь);

	Модифицированность = Истина;
	
КонецПроцедуры

