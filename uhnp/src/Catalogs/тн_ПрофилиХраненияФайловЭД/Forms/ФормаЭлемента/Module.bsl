

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.СпособОтправки = "RabbitMQ";
		Объект.НаименованиеСхемы = "systemsToeda_create_document_v1";
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОператорЭДОПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОператорЭДО) Тогда
		ТекстСпособОтправки = ?(ЗначениеЗаполнено(Объект.СпособОтправки), "(" + Объект.СпособОтправки + ")", "");
		Объект.Наименование = Строка(Объект.ОператорЭДО) + " " + ТекстСпособОтправки;	
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СпособОтправкиПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОператорЭДО) Тогда
		ТекстСпособОтправки = ?(ЗначениеЗаполнено(Объект.СпособОтправки), "(" + Объект.СпособОтправки + ")", "");
		Объект.Наименование = Строка(Объект.ОператорЭДО) + " " + ТекстСпособОтправки;	
	КонецЕсли;	
	
КонецПроцедуры

