Перем ЗначениеКопирования Экспорт;

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаШаблона = Нстр("ru = 'Шаблон процесса: ""%1"" не может быть записан:'");
	
	Если Не ПустаяСтрока(СтрокаШаблона) тогда		
		ШапкаОшибки = СтрШаблон(СтрокаШаблона, ЭтотОбъект);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеКопирования) Тогда
		Если СкопироватьСвязнуюИнформацию(ЗначениеКопирования, Отказ, ШапкаОшибки) Тогда
			ЗначениеКопирования = Неопределено;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция СкопироватьСвязнуюИнформацию(Источник, Отказ = Ложь, ШапкаОшибки = "") Экспорт
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции