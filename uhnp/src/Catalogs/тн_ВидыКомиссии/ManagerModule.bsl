Процедура ЗаменитьПеречислениеНаСправочник(Параметры = Неопределено) Экспорт	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриказНаКомиссию.Ссылка КАК Ссылка,
		|	ПриказНаКомиссию.ВидКомиссии КАК ВидКомиссии,
		|	ПриказНаКомиссию.УдалитьВидКомиссии КАК УдалитьВидКомиссии
		|ИЗ
		|	Документ.тн_ПриказНаКомиссиюПоИнвентаризации КАК ПриказНаКомиссию";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ВидКомиссии) И ЗначениеЗаполнено(Выборка.УдалитьВидКомиссии) Тогда
								
			НачатьТранзакцию();
			Попытка   
				ИмяПеречисления = XMLСтрока(Выборка.УдалитьВидКомиссии);			
				СпрВидКомиссии = Справочники.тн_ВидыКомиссии[ИмяПеречисления];
				
				ПриказНаКомиссиюОбъект = Выборка.Ссылка.ПолучитьОбъект();	
				ПриказНаКомиссиюОбъект.ОбменДанными.Загрузка = Истина;
				ПриказНаКомиссиюОбъект.ВидКомиссии = СпрВидКомиссии;
				ПриказНаКомиссиюОбъект.Записать();  
				
				НаборЗаписей = РегистрыСведений.тн_Комиссии.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка); 
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Прочитать(); 
				
				Для Каждого Запись Из НаборЗаписей Цикл
					Запись.ВидКомиссии = СпрВидКомиссии;		
				КонецЦикла;
				
				НаборЗаписей.Записать();
								
	            ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				
				ТекстОшибки = "Ошибка при выполнении обработчика обновления Справочники.тн_ВидыКомиссии.ЗаменитьПеречислениеНаСправочник: " 
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обновление информационной базы",
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.тн_ВидыКомиссии,,
					ТекстОшибки);
				
			КонецПопытки;			
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли