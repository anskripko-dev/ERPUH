	КодЯзыка = ТекущийЯзык().КодЯзыка;
	
	Элемент = Элементы.Добавить();	
	Элемент.ИмяПредопределенныхДанных = "ВключениеВРеестр";
	ЗаполнитьМультиязычныйРеквизит(Элемент,"ru = 'Включение в реестр платежей'", КодыЯзыков);
		
	Элемент = Элементы.Добавить();	
	Элемент.ИмяПредопределенныхДанных = "ИсключениеИзСтопЛиста";
