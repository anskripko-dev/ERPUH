#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция ПоставляемыеНастройкиВидовСобытий() Экспорт
	
	ОписаниеТиповСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(250);
	
	НастройкиВидовСобытий = Новый ТаблицаЗначений;
	НастройкиВидовСобытий.Колонки.Добавить("ВидСобытия",                  ОписаниеТиповСтрока);
	НастройкиВидовСобытий.Колонки.Добавить("КатегорияСобытия",            ОписаниеТиповСтрока);
	НастройкиВидовСобытий.Колонки.Добавить("ШаблонОповещенияПоУмолчанию", ОписаниеТиповСтрока);
	НастройкиВидовСобытий.Колонки.Добавить("ДополнительныеПараметры",     ОписаниеТиповСтрока);
	НастройкиВидовСобытий.Колонки.Добавить("Описание",                    ОписаниеТиповСтрока);
	
	НаименованиеПараметра = НСтр("ru = 'Параметр'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрСсылка = НСтр("ru = 'Ссылка'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	// ОповещениеОбОтказеВДоступеВнешнемуПоставщику
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбОтказеВДоступеВнешнемуПоставщику.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;	
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = НСтр("ru='Вам отказано в доступе к рабочему столу поставщика.'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	// ОповещениеОбОткрытииДоступаВнешнемуПоставщику
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбОткрытииДоступаВнешнемуПоставщику.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	ПараметрПользовательИБИмя = НСтр("ru = 'ПользовательИБИмя'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрПользовательИБВременныйПароль = НСтр("ru = 'ПользовательИБВременныйПароль'", ОбщегоНазначения.КодОсновногоЯзыка());
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Вам предоставлен доступ к рабочему столу поставщика.
		|						Для доступа используйте имя пользователя [%1.%2]
		|						и пароль [%1.%3]
		|						--'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрПользовательИБИмя, ПараметрПользовательИБВременныйПароль);
		
	// ОповещениеОбОтменеАккредитация
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбОтменеАккредитации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;

	// ОповещениеОбОтправкеНаИсправлениеАккредитации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбОтправкеНаИсправлениеАккредитации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОбОтправкеНаИсправлениеКвалификации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбОтправкеНаИсправлениеКвалификации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОбУтвержденииАккредитации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбУтвержденииАккредитации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	ПараметрОрганизация = НСтр("ru = 'Организация'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрДатаНачалаСрокаАккредитации = НСтр("ru = 'ДатаНачалаСрокаАккредитации'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрДатаОкончанияСрокаАккредитации = НСтр("ru = 'ДатаОкончанияСрокаАккредитации'", ОбщегоНазначения.КодОсновногоЯзыка());
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Вы аккредитованы по организации [%1.%2] с [%1.%3] по [%1.%4].'", ОбщегоНазначения.КодОсновногоЯзыка()), 
		НаименованиеПараметра, ПараметрОрганизация, ПараметрДатаНачалаСрокаАккредитации, ПараметрДатаОкончанияСрокаАккредитации);
	
	// ОповещениеОбУтвержденииКвалификации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОбУтвержденииКвалификации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОВозможностиУчаствоватьВЛотеАккредитованномуВнешнемуПоставщику
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОВозможностиУчаствоватьВЛотеАккредитованномуВнешнемуПоставщику.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОВозможностиУчаствоватьВЛотеВнешнемуПоставщику
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОВозможностиУчаствоватьВЛотеВнешнемуПоставщику.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	ПараметрЛот = НСтр("ru = 'Лот'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрПредметДоговора = НСтр("ru = 'ПредметДоговора'", ОбщегоНазначения.КодОсновногоЯзыка());
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='По лоту [#%1.%2] проводится квалификация.
		|						Приглашаем принять участие.
		|						
		|						Предмет торгов по лоту:
		|						[%1.%3]
		|						--'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрЛот, ПараметрПредметДоговора);
	
	// ОповещениеОЗапретеАккредитацииДоДаты
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОЗапретеАккредитацииДоДаты.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОЛишенииАккредитации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОЛишенииАккредитации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещениеОНеутвержденииАккредитации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОНеутвержденииАккредитации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;

	// ОповещениеОНеутвержденииКвалификации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОНеутвержденииКвалификации.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;

	// ОповещениеОНеобходимостиПроверкиАккредитацииПоставщика    
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОНеобходимостиПроверкиАккредитацииПоставщика.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	// ОповещениеОНеобходимостиПроверкиАккредитацииПоставщика    
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещениеОНеобходимостиПроверкиКвалификацииПоставщика.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.АккредитацияПоставщиков.ИмяПредопределенныхДанных;
	
	// ОповещенияЭтапаПроцесса
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = ОповещенияЭтапаПроцесса.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.ОповещенияЭтапаПроцесса.ИмяПредопределенныхДанных;

	// Напоминания
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "-";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = НСтр("ru='Напоминание о событии'", ОбщегоНазначения.КодОсновногоЯзыка());

	// Напоминание_ЛотВскрытиеЗаявок
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотВскрытиеЗаявок";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Вскрытие заявок по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотНачалоПодготовкиЗакупки
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотНачалоПодготовкиЗакупки";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Официальное объявление закупки по закупочной процедуре [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_НачалоПодготовкиЗакупки
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = Напоминание_НачалоПодготовкиЗакупки.ИмяПредопределенныхДанных;
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Официальное объявление закупки по закупочной процедуре [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
		
	// Напоминание_ЛотНачалоПредоставлениеРазъяснений
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотНачалоПредоставлениеРазъяснений";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Начало предоставление разъяснений, извещения, документации по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотНачалоПриемаЗаявок
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотНачалоПриемаЗаявок";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Начало приема заявок по лоту[#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотОглашениеРезультатов
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотОглашениеРезультатов";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Оглашение результатов по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотОкончаниеКвалификации
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотОкончаниеКвалификации";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Окончание квалификации по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотОкончаниеПредоставлениеРазъяснений
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотОкончаниеПредоставлениеРазъяснений";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Окончание предоставления разъяснений, извещения, документации по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотОкончаниеПриемаЗаявок
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
	НоваяНастройка.ВидСобытия = "Напоминание_ЛотОкончаниеПриемаЗаявок";
	НоваяНастройка.КатегорияСобытия = Справочники.КатегорииСобытийОповещений.Напоминания.ИмяПредопределенныхДанных;
	НоваяНастройка.ШаблонОповещенияПоУмолчанию = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Окончание приема заявок по лоту [#%1.%2]'", ОбщегоНазначения.КодОсновногоЯзыка()), НаименованиеПараметра, ПараметрСсылка);
	
	// Напоминание_ЛотОкончаниеРассмотренияЗаявок
	НоваяНастройка = НастройкиВидовСобытий.Добавить();
