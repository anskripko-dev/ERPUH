 
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Договор = ПараметрКоманды;
	
	ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии, КлючВарианта", 
										ПолучитьОтбор(Договор), 
										Истина,
										"АнализСубконто"
									);

	ОткрытьФорму("Отчет.ОСВМСФО.Форма", 
						ПараметрыФормы, 
						ПараметрыВыполненияКоманды.Источник, 
						ПараметрыВыполненияКоманды.Уникальность, 
						ПараметрыВыполненияКоманды.Окно, 
						ПараметрыВыполненияКоманды.НавигационнаяСсылка
				);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьОтбор(Ссылка)

	ДатаНачала = НачалоГода(?(ЗначениеЗаполнено(Ссылка.Дата), Ссылка.Дата, ТекущаяДата()));
	ПериодОтчета = Новый СтандартныйПериод(ДатаНачала, КонецГода(ТекущаяДата()));
	
	Результат = Новый Структура;	
	Результат.Вставить("Организация", 	Ссылка.Организация);
	Результат.Вставить("Сценарий", 		Константы.СценарийМСФО.Получить());
	Результат.Вставить("Период", 		ПериодОтчета);
	
	Результат.Вставить("ВидСубконто", 	ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.СправочникДоговораКонтрагентов);
	Результат.Вставить("Субконто", 		Ссылка);
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти

