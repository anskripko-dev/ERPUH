Функция ПолучитьИменаСубконто() Экспорт

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "СчетИсточникСубконто1");
	Субконто.Вставить(2, "СчетИсточникСубконто2");
	Субконто.Вставить(3, "СчетИсточникСубконто3");
	Субконто.Вставить("УчетПоПодразделениям", "СчетИсточникПодразделение");
	Субконто.Вставить("УчетПоНаправлениямДеятельности", "СчетИсточникНаправлениеДеятельности");
	
	Результат.Вставить("СчетИсточник", Субконто);
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "СчетПриемникСубконто1");
	Субконто.Вставить(2, "СчетПриемникСубконто2");
	Субконто.Вставить(3, "СчетПриемникСубконто3");
	Субконто.Вставить("УчетПоПодразделениям", "СчетПриемникПодразделение");
	Субконто.Вставить("УчетПоНаправлениямДеятельности", "СчетПриемникНаправлениеДеятельности");
	
	Результат.Вставить("СчетПриемник", Субконто);
		
	Субконто = Новый Соответствие;
	
	Субконто.Вставить(1, "Субконто1");
	Субконто.Вставить(2, "Субконто2");
	Субконто.Вставить(3, "Субконто3");
	Субконто.Вставить("УчетПоПодразделениям", "Подразделение");
	Субконто.Вставить("УчетПоНаправлениямДеятельности", "НаправлениеДеятельности");
	
	Результат.Вставить("БазаРаспределенияПриемника", Новый Структура("Счет", Субконто));	
		
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьРеквизитПланСчетовБД(Параметры = Неопределено) Экспорт

	ПоУмолчаниюПС = Константы.ПланСчетовПоУмолчанию.Получить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.УдалитьРегистрУчета.ПланСчетов КАК ПланСчетовБД
	|ИЗ
	|	Справочник.НастройкиРаспределенияЗатратМСФО КАК т
	|ГДЕ
	|	т.ПланСчетовБД = ЗНАЧЕНИЕ(Справочник.ПланыСчетовБД.ПустаяСсылка)");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ПланСчетовБД = ?(ЗначениеЗаполнено(Выборка.ПланСчетовБД), Выборка.ПланСчетовБД, ПоУмолчаниюПС);
		ОбновлениеИнформационнойБазыБМ.ЗаписатьОбъект(Объект);
		
	КонецЦикла; 	

КонецПроцедуры

#КонецЕсли
