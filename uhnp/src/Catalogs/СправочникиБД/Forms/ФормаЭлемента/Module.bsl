&НаСервере 
Процедура ОбновитьДоступностьЭлементов()
	
	Элементы.ГруппаСогласование.Видимость=ЭтоТекущаяБД И Метаданные.ОпределяемыеТипы.ОбъектыДляСогласования.Тип.СодержитТип(Тип("СправочникСсылка." + Объект.Наименование));
	
	Элементы.РеквизитыИспользоватьДляСогласования.Видимость	= Объект.Согласуется;
	
	ИмяКонстантыИнтеграции = "ИспользоватьИнтеграциюС1СДокументооборот3";
	Если Метаданные.Константы.Найти(ИмяКонстантыИнтеграции) <> Неопределено
		И ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.СогласованиеЧерез1СДокументооборот") Тогда
		
		Элементы.ГруппаСогласуетсяВДокументообороте.Видимость = Объект.Согласуется И Константы[ИмяКонстантыИнтеграции].Получить();
	Иначе
		Элементы.ГруппаСогласуетсяВДокументообороте.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаРеквизитыСогласования.Видимость			= Объект.Согласуется;
	
	Элементы.ГруппаКонтролируемый.Видимость=ЭтоТекущаяБД И Объект.Реквизиты.НайтиСтроки(Новый Структура("Имя","НСИ_НеАктивный")).Количество()=1;	
	
	//Элементы только текущей ИБ
	Элементы.ГруппаПризнакиСинхронизации.Видимость = ЭтоТекущаяБД;
	Элементы.РеквизитыОтображать.Видимость=Не ЭтоТекущаяБД;
		
	Если ЭтоТекущаяБД Тогда
		
		Элементы.СоздаватьПриНеудачномПоискеПриИмпорте.Заголовок=НСтр("ru = 'Создавать при неудачном поиске при импорте'");
		Элементы.ОбновлятьРеквизитыПриИмпорте.Заголовок=НСтр("ru = 'Обновлять реквизиты при импорте'");
		
	Иначе
		
		Элементы.СоздаватьПриНеудачномПоискеПриИмпорте.Заголовок=НСтр("ru = 'Создавать при неудачном поиске при экспорте'");
		Элементы.ОбновлятьРеквизитыПриИмпорте.Заголовок=НСтр("ru = 'Обновлять реквизиты при экспорте'")
		
	КонецЕсли;
	
	Элементы.ГруппаРазделениеПоОрганизациям.Видимость=ЭтоТекущаяБД;
	Элементы.ГруппаЦентрализованный.Доступность=(НЕ Объект.ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.Поставщик);
			
	Элементы.ОткрытьМатрицуПолномочийНСИ.Видимость			= Объект.ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам;
	Элементы.ТабличныеЧастиИзмененияСогласуются.Видимость   = Объект.ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам;
	Элементы.РеквизитыИзменениеБезСогласования.Видимость	= Объект.ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам;
	Элементы.ГруппаУтверждение.Видимость					= Объект.ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам;
		 	
	Если Объект.Наименование = "Проекты" ИЛИ Объект.Наименование = "ДоговорыКонтрагентов" Тогда 
		Элементы.Согласуется.Доступность = Ложь;  
		Элементы.ГруппаРеквизитыСогласования.ТолькоПросмотр = Истина;	
	КонецЕсли;
	
	Элементы.ФормаОткрытьСправочникБД.Видимость=ЭтоТекущаяБД;
	Элементы.РеквизитРазделенияПоОрганизациям.Видимость=Объект.РазделятьПоОрганизациям;
	Элементы.РеквизитРазделенияПоПроектам.Видимость=Объект.РазделятьПоПроектам;
	
	Если ЗначениеЗаполнено(Объект.ЦентрализованнаяБазаНСИ) Тогда
		
		Элементы.РеквизитыОбязательный.ТолькоПросмотр=Истина;
		Элементы.РеквизитыКонтрольУникальности.ТолькоПросмотр=Истина;
		Элементы.РеквизитыИзменениеБезСогласования.ТолькоПросмотр=Истина;
		Элементы.РеквизитыИзменениеБезСогласования.ТолькоПросмотр=Истина;
		Элементы.ТабличныеЧастиИзмененияСогласуются.ТолькоПросмотр=Истина;
		
		Элементы.ВидКонтроляНСИ.Доступность=Ложь;
		Элементы.ПоставщикПотребительНСИ.Доступность=Ложь;
		
		Элементы.ДекорацияВнешнийКонтроль.Видимость=Истина;
		Элементы.ДекорацияВнешнийКонтроль.Заголовок=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Контролируется внешней базой %1'"),Объект.ЦентрализованнаяБазаНСИ);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокРеквизитовСогласования()
	
	ТаблицаРеквизитов=Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Имя");
	ТаблицаРеквизитов.Колонки.Добавить("Синоним");
	ТаблицаРеквизитов.Колонки.Добавить("Вес",ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(5));
	
	Для Каждого Строка ИЗ Объект.Реквизиты Цикл
		
		Если НЕ (СтрНайти(Строка.ТипДанных,"Справочник.")>0 ИЛИ СтрНайти(Строка.ТипДанных,"Перечисление.")>0) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока=ТаблицаРеквизитов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.Вес=?(СтрНайти(Строка.Имя,"Состоян")>0,1,0);
		
	КонецЦикла;
	
	ТаблицаРеквизитов.Сортировать("Вес Убыв");
		
КонецПроцедуры // ОбновитьСписокРеквизитовСогласования() 

