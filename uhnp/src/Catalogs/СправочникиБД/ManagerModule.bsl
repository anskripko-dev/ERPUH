#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Наименование");
	Поля.Добавить("Синоним");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Данные.Синоним) Тогда
		СтандартнаяОбработка = Ложь;
		Представление = Данные.Синоним;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСправочникБД(Имя, ТипБД = Неопределено) Экспорт
	
	Если ТипБД = Неопределено Тогда
		ТипБД = Справочники.ТипыБазДанных.ТекущаяИБ;	
	КонецЕсли;
	
	Возврат Справочники.СправочникиБД.НайтиПоНаименованию(Имя, Истина, , ТипБД);
	
КонецФункции 

Функция ПолучитьТипКонтроляНСИ(ВидКонтроляНСИ,ПоставщикПотребительНСИ) Экспорт
	
	Если ПоставщикПотребительНСИ=Перечисления.ПоставщикПотребительНСИ.Потребитель Тогда
		
		ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияЗапрещены;
		
	ИначеЕсли ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоЗаявкам Тогда
		
		ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ЗаявкиНаИзменениеНСИ;
		
	ИначеЕсли ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ИзмененияПоВерсиям Тогда
		
		ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ИзмененияПоВерсиям;
	
	ИначеЕсли ВидКонтроляНСИ=Перечисления.ВидыКонтроляНСИ.ПроверятьЗаполнениеРеквизитов Тогда
		
		ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.ПроверятьЗаполнениеРеквизитов;
		
	Иначе
		
		ТипКонтроляНСИ=Перечисления.ТипыКонтроляНСИ.НеКонтролируется;
		
	КонецЕсли;		
	
	Возврат ТипКонтроляНСИ;
	
КонецФункции // ПолучитьТипКонтроляНСИ()

Функция ЭтоДоговорКонтрагента(НаименованиеОбъекта) Экспорт
	
	Возврат НаименованиеОбъекта="ДоговорыКонтрагентов"
		ИЛИ НаименованиеОбъекта="ДоговорыКредитовИДепозитов";
	
	
КонецФункции // ЭтоДоговорКонтрагента()

