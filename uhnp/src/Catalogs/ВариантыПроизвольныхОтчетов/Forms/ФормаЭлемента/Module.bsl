

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.ПроизвольныйОтчет) Тогда
		
		Объект.ПроизвольныйОтчет 		= Параметры.ПроизвольныйОтчет;
		Объект.Наименование 			= Строка(Параметры.ПроизвольныйОтчет)+НСтр("ru = '- копия'");
		Объект.Автор                    = ОбщегоНазначенияУХ.ТекущийПользователь();
		
		Объект.Периодичность            = Параметры.НастройкиВарианта.Периодичность;
		Объект.ПериодОтчета             = Параметры.НастройкиВарианта.ПериодОтчета;
		Объект.ПериодОкончания          = Параметры.НастройкиВарианта.ПериодОкончания;
		Объект.Валюта          			= Параметры.НастройкиВарианта.Валюта;
		Объект.Сценарий                 = Параметры.НастройкиВарианта.Сценарий;
		
		Объект.НастройкиСКД             = ЗначениеВСтрокуВнутр(Параметры.НастройкиВарианта.КомпоновщикНастроек.Настройки);
		
	КонецЕсли;
	
	УправлениеФормойСервер();
	
КонецПроцедуры

