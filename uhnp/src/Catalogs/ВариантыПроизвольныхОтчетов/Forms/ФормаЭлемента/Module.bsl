&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЭтаФорма.Записать();
	ЭтаФорма.Закрыть(Объект.Ссылка);
	
КонецПроцедуры

Процедура УправлениеФормойСервер()
	
	ЭтаФорма.ТолькоПросмотр = НЕ ОбщегоНазначенияУХ.ТекущийПользователь() = Объект.Автор;
	
КонецПроцедуры	
