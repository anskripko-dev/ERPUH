
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
  ПроизвольныйОтчет = Параметры.ПроизвольныйОтчет;	

   
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьДанныеДругихАвторовПриИзменении(Элемент)
	
  ПолучитьСписокВариантов();	
  Элементы.Список.Обновить();

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
 ПолучитьСписокВариантов();	
	 
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокВариантов()
	
  ПроизвольныйОтчет = Параметры.ПроизвольныйОтчет;	

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
                 |	ВложенныйЗапрос.Ссылка КАК Ссылка
                 |ИЗ
                 |	(ВЫБРАТЬ
                 |		СправочникВариантыПроизвольныхОтчетов.Ссылка КАК Ссылка,
                 |		СправочникВариантыПроизвольныхОтчетов.Код КАК Код,
                 |		СправочникВариантыПроизвольныхОтчетов.Наименование КАК Наименование,
                 |		СправочникВариантыПроизвольныхОтчетов.ЭтоОсновнойВариант КАК ЭтоОсновнойВариант,
                 |		СправочникВариантыПроизвольныхОтчетов.Автор КАК Автор
                 |	ИЗ
                 |		Справочник.ВариантыПроизвольныхОтчетов КАК СправочникВариантыПроизвольныхОтчетов
                 |	ГДЕ
                 |		СправочникВариантыПроизвольныхОтчетов.Автор = &Пользователь
                 |		И СправочникВариантыПроизвольныхОтчетов.ПроизвольныйОтчет = &ПроизвольныйОтчет
                 |	
                 |	ОБЪЕДИНИТЬ ВСЕ
                 |	
                 |	ВЫБРАТЬ
                 |		СправочникВариантыПроизвольныхОтчетов.Ссылка,
                 |		СправочникВариантыПроизвольныхОтчетов.Код,
                 |		СправочникВариантыПроизвольныхОтчетов.Наименование,
                 |		СправочникВариантыПроизвольныхОтчетов.ЭтоОсновнойВариант,
                 |		СправочникВариантыПроизвольныхОтчетов.Автор
                 |	ИЗ
                 |		Справочник.ВариантыПроизвольныхОтчетов КАК СправочникВариантыПроизвольныхОтчетов
                 |	ГДЕ
                 |		&ОтображатьДанныеДругихАвторов
                 |		И СправочникВариантыПроизвольныхОтчетов.Пользователи.Пользователь = &Пользователь
                 |		И СправочникВариантыПроизвольныхОтчетов.ПроизвольныйОтчет = &ПроизвольныйОтчет
                 |	
                 |	ОБЪЕДИНИТЬ ВСЕ
                 |	
                 |	ВЫБРАТЬ
                 |		СправочникВариантыПроизвольныхОтчетов.Ссылка,
                 |		СправочникВариантыПроизвольныхОтчетов.Код,
                 |		СправочникВариантыПроизвольныхОтчетов.Наименование,
                 |		СправочникВариантыПроизвольныхОтчетов.ЭтоОсновнойВариант,
                 |		СправочникВариантыПроизвольныхОтчетов.Автор
                 |	ИЗ
                 |		Справочник.ВариантыПроизвольныхОтчетов КАК СправочникВариантыПроизвольныхОтчетов
                 |	ГДЕ
                 |		СправочникВариантыПроизвольныхОтчетов.ЭтоОсновнойВариант = ИСТИНА
                 |		И СправочникВариантыПроизвольныхОтчетов.ПроизвольныйОтчет = &ПроизвольныйОтчет) КАК ВложенныйЗапрос";
  
  Запрос.УстановитьПараметр("Пользователь",ОбщегоНазначенияУХ.ТекущийПользователь());
  Запрос.УстановитьПараметр("ПроизвольныйОтчет",ПроизвольныйОтчет);
  Запрос.УстановитьПараметр("ОтображатьДанныеДругихАвторов",ОтображатьДанныеДругихАвторов);
  
  СписокВариантов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
  
  ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("СписокВариантов",СписокВариантов);

   
КонецПроцедуры

