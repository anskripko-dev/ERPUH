
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)
	
	Если Способы.Количество() = 0 Тогда
		
		//Актуальными считаем реквизиты - заполним ТЧ
		ЦФО = Подразделение;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Подразделение, "ЦФО") Тогда
			ЦФО = Подразделение["ЦФО"];
		КонецЕсли;
		
		НовыйСпособ = Способы.Добавить();
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.СчетЗатрат,	СчетЗатрат);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.Субконто1,	СчетЗатратСубконто1);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.Субконто2,	СчетЗатратСубконто2);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.Субконто3,	СчетЗатратСубконто3);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.Подразделение,			ЦФО);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НовыйСпособ.НаправлениеДеятельности,	НаправлениеДеятельности);

	ИначеЕсли Способы.Количество() = 1 Тогда
		
		//Актуальными считаем Реквизиты - обновим ТЧ по реквизитам
		Способ1 = Способы[0];
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатрат,			Способ1.СчетЗатрат);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто1,	Способ1.Субконто1);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто2,	Способ1.Субконто2);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто3,	Способ1.Субконто3);
		//ОбщегоНазначенияУХ.УстановитьНовоеЗначение(Подразделение, 		Способ1.Подразделение);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(НаправлениеДеятельности,	Способ1.НаправлениеДеятельности);
		
	Иначе
		
		//Когда записей > 1, тогда актуальными считаем ТЧ - очистим реквизиты
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатрат, Справочники.СчетаБД.ПустаяСсылка());
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто1, Неопределено);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто2, Неопределено);
		ОбщегоНазначенияУХ.УстановитьНовоеЗначение(СчетЗатратСубконто3, Неопределено);

	КонецЕсли;
	
	НовоеЗначение = Справочники.СпособыОтраженияРасходовПоАмортизацииМСФО.ПолучитьОписание(ЭтотОбъект);
	ОбщегоНазначенияУХ.УстановитьНовоеЗначение(Описание, НовоеЗначение);

КонецПроцедуры

#КонецЕсли

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Способы.Итог("Коэффициент") <> 100 Тогда
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Сумма коэффициентов не равна 100'"), Отказ);
	КонецЕсли;
	
КонецПроцедуры
