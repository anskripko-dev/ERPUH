
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	АлгоритмОпределенияСтатуса.УстановитьТекст(Объект.АлгоритмОпределенияСтатуса);
	АлгоритмОпределенияСтатусаНаКлиенте.УстановитьТекст(Объект.АлгоритмОпределенияСтатусаНаКлиенте);
	АлгоритмРасшифровки.УстановитьТекст(Объект.АлгоритмРасшифровки);
	Если Объект.ИмяПредопределенныхДанных = "" Тогда
		Элементы.ФормаЗаполнитьИзПоставляемыхДанных.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.АлгоритмОпределенияСтатуса = АлгоритмОпределенияСтатуса.ПолучитьТекст();
	Объект.АлгоритмОпределенияСтатусаНаКлиенте = АлгоритмОпределенияСтатусаНаКлиенте.ПолучитьТекст();
	Объект.АлгоритмРасшифровки = АлгоритмРасшифровки.ПолучитьТекст();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзПоставляемыхДанных(Команда)
	ЗаполнитьИзПоставляемыхДанныхНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзПоставляемыхДанныхНаСервере()
	Макет = Справочники.РасширенияПанелиНалоговогоМониторинга.ПолучитьМакет("ПоставляемыеДанные");
	Инд = 1;
	Пока Истина Цикл 
		Инд = Инд + 1;
		ИмяПредопределенного = Макет.Область(Инд, 1, Инд, 1).Текст;
		Если ПустаяСтрока(ИмяПредопределенного) Тогда
			Прервать;
		КонецЕсли;
		Если ИмяПредопределенного = Объект.ИмяПредопределенныхДанных Тогда
			АлгоритмОпределенияСтатуса.УстановитьТекст(Макет.Область(Инд, 2, Инд, 2).Текст);
			АлгоритмОпределенияСтатусаНаКлиенте.УстановитьТекст(Макет.Область(Инд, 3, Инд, 3).Текст);
			АлгоритмРасшифровки.УстановитьТекст(Макет.Область(Инд, 4, Инд, 4).Текст);
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

