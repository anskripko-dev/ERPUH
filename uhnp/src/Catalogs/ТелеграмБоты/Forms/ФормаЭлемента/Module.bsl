
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	МенеджерЗаписи = РегистрыСведений.ТелеграмНастройки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ТелеграмБот = ТекущийОбъект.Ссылка;
		
	Попытка
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.ТелеграмБот = ТекущийОбъект.Ссылка;
		МенеджерЗаписи.Token = ТекущийОбъект.Token;	
		МенеджерЗаписи.Записать();
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось обновить ""token"" в Настройках Telegram;'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРегламентноеЗаданиеПолучение(Команда)
		
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Действие", "Изменить");	
	ПараметрыФормы.Вставить("Идентификатор", ТелеграмСерверУХ.ПолучитьИдентификаторРегламентногоЗаданияПолучение());
	
	ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРегламентноеЗаданиеОтправка(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Действие", "Изменить");	
	ПараметрыФормы.Вставить("Идентификатор", ТелеграмСерверУХ.ПолучитьИдентификаторРегламентногоЗаданияОтправка());
	
	ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура TokenПриИзменении(Элемент)
	
	TokenПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура TokenПриИзмененииНаСервере(Отказ = Ложь)
		
	Если ЗначениеЗаполнено(Объект.token) Тогда
		
		Приемник = "bot" + Объект.token + "/getMe";
		
		HTTPСоединение = Новый HTTPСоединение(ТелеграмСерверУХ.ПолучитьТелеграмАПИПоУмолчанию(), 443,,,,, Новый ЗащищенноеСоединениеOpenSSL());
		HTTPЗапрос = Новый HTTPЗапрос(Приемник);
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Данные = ТелеграмСерверУХ.ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
			Объект.ИмяБота = Данные.result.first_name;
		Иначе	
			Объект.ИмяБота = "";
			Отказ = Истина;
			
			ТекстСообщения = НСтр("ru = 'Не корректный ""token""'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	Иначе
		Объект.ИмяБота = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	TokenПриИзмененииНаСервере(Отказ);
	
КонецПроцедуры
