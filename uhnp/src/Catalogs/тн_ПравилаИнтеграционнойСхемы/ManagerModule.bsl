// Юдина Екатерина 04.12.2025 Выполнение задач №000056034
//
Процедура ЗаполнитьПоМассивуСправочников(МассивСправочников, СоответствиеРеквизитов)        
		
	ТЗ_ЗагружаемыеТипы = тн_Интеграция_ERP_УХ.ТЗ_ЗагружаемыеТипы();
	
	Для Каждого ИмяСправочника Из МассивСправочников Цикл   
		
	    МетаданныеСправочника = Метаданные.Справочники[ИмяСправочника];	
		ИмяРеквизитаЯвляетсяОбъектомЦБ = ?(ОбщегоНазначения.ЕстьРеквизитОбъекта("тн_ЯвляетсяОбъектомЦБ", МетаданныеСправочника), "тн_ЯвляетсяОбъектомЦБ", "ЯвляетсяОбъектомЦБ");
				
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Менеджер", "Справочники." + ИмяСправочника); 
		НайденныеСтроки = ТЗ_ЗагружаемыеТипы.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого сТип Из НайденныеСтроки Цикл   
			
			тн_ПравилаИнтеграционнойСхемы = Справочники.тн_ПравилаИнтеграционнойСхемы.НайтиПоРеквизиту("ИмяОбъектовМетаданных", "Справочник." + ИмяСправочника);
			
			Если Не ЗначениеЗаполнено(тн_ПравилаИнтеграционнойСхемы) Тогда  
				
				Обтн_ПравилаИнтеграционнойСхемы = Справочники.тн_ПравилаИнтеграционнойСхемы.СоздатьЭлемент();
				Обтн_ПравилаИнтеграционнойСхемы.ИмяОбъектовМетаданных = "Справочник." + ИмяСправочника;
				Обтн_ПравилаИнтеграционнойСхемы.Наименование = Обтн_ПравилаИнтеграционнойСхемы.ИмяОбъектовМетаданных;
				
				НСТаблицыСхем = Обтн_ПравилаИнтеграционнойСхемы.ТаблицыСхем.Добавить();  
				НСТаблицыСхем.ИмяСхемы = сТип.ТегXDTO;
				НСТаблицыСхем.ИмяТаблицы = ИмяСправочника;    
				
				НСРеквизитыСхем = Обтн_ПравилаИнтеграционнойСхемы.РеквизитыСхем.Добавить(); 
				НСРеквизитыСхем.ИмяТаблицы = ИмяСправочника;
				НСРеквизитыСхем.ИмяРеквизита = ИмяРеквизитаЯвляетсяОбъектомЦБ;						
				
				Для Каждого СтрокаРеквизита Из сТип.СоотвТеговИРеквизитов Цикл
					
					Если СтрНайти(Нрег(СтрокаРеквизита.Ключ), Нрег("ДопСвойстваТЧОбъекта")) > 0 Тогда
						
						СтруктураТаблицы = СтрокаРеквизита.Значение; 
						СтруктураПолей = СтруктураТаблицы.ПоляТЧ;
						
						ПерваяСтрока = Истина;      
						
						Для Каждого СтрокаПолей Из СтруктураПолей Цикл
							
							НСРеквизитыСхем = Обтн_ПравилаИнтеграционнойСхемы.РеквизитыСхем.Добавить();
							НСРеквизитыСхем.ИмяТаблицы = СоответствиеРеквизитов.Получить(СтруктураТаблицы.ТегТЧ);
							
							Если ПерваяСтрока Тогда 
								НСТаблицыСхем = Обтн_ПравилаИнтеграционнойСхемы.ТаблицыСхем.Добавить();  
								НСТаблицыСхем.ИмяТаблицы = НСРеквизитыСхем.ИмяТаблицы; 
								НСТаблицыСхем.ИмяСхемы = СтруктураТаблицы.ТегТЧ;
								ПерваяСтрока = Ложь;
							КонецЕсли;
							
							Если ТипЗнч(СтрокаПолей.Значение) = Тип("Структура") Тогда  
								НСРеквизитыСхем.ИмяРеквизита     = СтрокаПолей.Ключ;
								НСРеквизитыСхем.ИмяСвойстваСхемы = СтрокаПолей.Значение.Тег; 	
							Иначе        
								НСРеквизитыСхем.ИмяРеквизита     = СоответствиеРеквизитов.Получить(СтрокаПолей.Ключ);
								НСРеквизитыСхем.ИмяСвойстваСхемы = СтрокаПолей.Ключ; 
							КонецЕсли;    
							
						КонецЦикла;
						
					ИначеЕсли СтрНайти(Нрег(СтрокаРеквизита.Ключ), Нрег("ДопСвойстваОбъекта")) > 0 Тогда

						ИмяРеквизита = СоответствиеРеквизитов.Получить(СтрокаРеквизита.Значение);
						
						Если ЗначениеЗаполнено(ИмяРеквизита) Тогда   
							
							НСРеквизитыСхем = Обтн_ПравилаИнтеграционнойСхемы.РеквизитыСхем.Добавить(); 
							НСРеквизитыСхем.ИмяТаблицы = ИмяСправочника;
							НСРеквизитыСхем.ИмяРеквизита     = ИмяРеквизита;						
							НСРеквизитыСхем.ИмяСвойстваСхемы = СтрокаРеквизита.Значение; 
							
						КонецЕсли;
					
					ИначеЕсли СтрНайти(Нрег(СтрокаРеквизита.Ключ), Нрег("ДопСвойстваОбъекта")) = 0 Тогда
						
						НСРеквизитыСхем = Обтн_ПравилаИнтеграционнойСхемы.РеквизитыСхем.Добавить();
						НСРеквизитыСхем.ИмяРеквизита  = СтрокаРеквизита.Ключ;    
						Если ТипЗнч(СтрокаРеквизита.Значение) = Тип("Структура") Тогда
							НСРеквизитыСхем.ИмяСвойстваСхемы = СтрокаРеквизита.Значение.Тег; 	
						Иначе
							НСРеквизитыСхем.ИмяСвойстваСхемы = СтрокаРеквизита.Значение; 
						КонецЕсли;
						НСРеквизитыСхем.ИмяТаблицы =  ИмяСправочника;  
						
					КонецЕсли;
					
				КонецЦикла;   
				
				Попытка
					Обтн_ПравилаИнтеграционнойСхемы.Записать();	
				Исключение
					ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
						Метаданные.Справочники.тн_ПравилаИнтеграционнойСхемы, ,
						"Ошибка при выполнении обработчика обновления тн_ОбновлениеИнформационнойБазы_ТН_Общий.ЗаполнитьПравилаИнтеграционнойСхемы: " 
						+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
				
			КонецЕсли;	
			
		КонецЦикла;  
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
