#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	ВерсияФИ	= Форма.ВерсияФИ;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;
	
	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);

	//Установка значений
	Объект.ДисконтнаяЦБ = Форма.ТипЦБ > 0;
	Если Объект.ДисконтнаяЦБ Тогда
		ВерсияФИ.ТипПроцентнойСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.ПустаяСсылка");
		Форма.СтавкаДоходностиПоДисконту = ПолучитьЭСП(Форма);
	КонецЕсли;

	ПоДням = ВерсияФИ.ПериодичностьУплатыПроцентов = ПредопределенноеЗначение("Перечисление.Периодичность.День");
	Если ПоДням Тогда
		
		ОбщегоНазначенияКлиентСерверУХ.УстановитьНовоеЗначение(
				ВерсияФИ.БазаДляРасчетаПроцентов,
				ПредопределенноеЗначение("Справочник.СпособыРасчетаДнейПериодическихОпераций.Год360Месяц30")
			);

	КонецЕсли;
	
	ВидимостьСтороныСоглашения(Форма);
	УправлениеФормой_Условия(Форма);
	
	ВидимостьПроценты(Форма);
	ВидимостьПроценты_ПроцентнаяСтавка(Форма);
	ВидимостьПроценты_ПлатежВекселя(Форма);
	ВидимостьПроценты_Дополнительно(Форма);
	ВидимостьДисконт(Форма);
	
	ВидимостьСправочноВексель(Форма);
	ВидимостьРЦБ(Форма);
 	ВидимостьГрафик(Форма);
	
КонецПроцедуры

#Область УправлениеФормой

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьСтороныСоглашения(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;

	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	ЭтоПереводнойВексель = (Форма.ПараметрыЦеннойБумаги.ФормаВекселя = ПредопределенноеЗначение("Перечисление.ФормаВекселя.Переводной"));
	
	Элементы.ПервыйПолучатель.Видимость = ЭтоОблигация Или ЭтоВексель;
	
	Элементы.ФормаВекселя.Видимость		= ЭтоВексель;
	Элементы.Векселедатель.Видимость	= ЭтоВексель;
	Элементы.Должник.Видимость			= ЭтоВексель И ЭтоПереводнойВексель;
	Элементы.Поручитель.Видимость		= ЭтоВексель;
	
	ЗаголовокПервыйПолучатель = "";
	Если ЭтоВексель Тогда
		ЗаголовокПервыйПолучатель = НСтр("ru = 'Первый векселедержатель'");
	ИначеЕсли Объект.ЭтоБиржевойРынок > 0 Тогда 
		ЗаголовокПервыйПолучатель = НСтр("ru = 'Андеррайтер'");
	Иначе
		ЗаголовокПервыйПолучатель = НСтр("ru = 'Кредитор'");
	КонецЕсли;
		
	Элементы.Векселедатель.Заголовок = ?(ЭтоПереводнойВексель, НСтр("ru = 'Векселедатель'"), НСтр("ru = 'Векселедатель и плательщик'"));
	Элементы.ПервыйПолучатель.Заголовок = ЗаголовокПервыйПолучатель;
	
	Если Не ЭтоВексель Тогда
		
		ТекстЗаголовкаСвернутогоОтображения = СтрШаблон(
			НСтр("ru = 'Стороны: Эмитент %1'"),
			Объект.Эмитент);
			
	ИначеЕсли ЭтоПереводнойВексель Тогда
		
		ТекстЗаголовкаСвернутогоОтображения = СтрШаблон(
			НСтр("ru = 'Стороны: векселедатель %1, плательщик %2)'"),
			ПараметрыЦеннойБумаги.Векселедатель, ПараметрыЦеннойБумаги.Должник);
		
	Иначе
		
		ТекстЗаголовкаСвернутогоОтображения = СтрШаблон(
			НСтр("ru = 'Стороны: Векселедатель %1'"),
			ПараметрыЦеннойБумаги.Векселедатель);
			
	КонецЕсли;
		
	Элементы.ГруппаСтороны.ЗаголовокСвернутогоОтображения = ТекстЗаголовкаСвернутогоОтображения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой_Условия(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;
	
	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	ЭтоПлатежПоПредъявлении = ЭтоПлатежПоПредъявлении(ПараметрыЦеннойБумаги);
	
	Элементы.Количество.Видимость		= Не ЭтоВексель;
	Элементы.СрокПогашения.Видимость	= ЭтоОблигация;
	Элементы.ТипЦБ.Видимость			= ЭтоОблигация;
	
	Элементы.СрокПогашения.Заголовок = ?(ЭтоОблигация,
		НСтр("ru = 'Срок погашения'"),
		НСтр("ru = 'Срок погашения не ранее'"));
		
	Элементы.СрокПлатежа.Видимость = ЭтоВексель;
	Элементы.ДатаПлатежа.Видимость = ЭтоВексель;
	Элементы.УказанаДатаПредъявленияНеРанее.Видимость = ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиДатаПредъявленияНеРанее.Видимость = ЭтоВексель;
	Элементы.ОтсрочкаПлатежа.Видимость = ЭтоВексель И ЭтоПлатежПоПредъявлении;
	
	Элементы.ПараметрыЦеннойБумагиПредусмотренПроцентныйДоход.Видимость = ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиПредусмотренПроцентныйДоход.ТолькоПросмотр = Не ЭтоПлатежПоПредъявлении;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПроценты(Форма)
	
	Элементы	= Форма.Элементы;
	Объект		= Форма.Объект;

	ВерсияФИ	= Форма.ВерсияФИ;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;

	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	
	//Видимость
	Элементы.ГруппаПериодичностьПроцентов.Видимость = ЭтоОблигация;
	
	Элементы.ДатаОкончанияПервогоПроцентногоПериода.Видимость 
		= (ВерсияФИ.ДатаОтсчетаПроцентныхПериодов 
			= ПредопределенноеЗначение("Перечисление.ВидыДатОтсчетаПериодичности.ДатаПервогоПогашения"));
	
	Элементы.ГруппаПроценты.Видимость 
		= (ЭтоОблигация И Не Объект.ДисконтнаяЦБ) 
		ИЛИ (ЭтоВексель И ПараметрыЦеннойБумаги.ПредусмотренПроцентныйДоход);
		
	//Заголовки
	Элементы.ГруппаПроценты.Заголовок = ?(ЭтоОблигация, НСтр("ru = 'Купоны'"), НСтр("ru = 'Проценты'"));
	Элементы.ГруппаПериодичностьПроцентов.Заголовок = ?(ЭтоОблигация, 
		НСтр("ru = 'Купонные периоды'"), НСтр("ru = 'Процентные периоды'"));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПроценты_ПроцентнаяСтавка(Форма)
	
	Элементы	= Форма.Элементы;
	Объект		= Форма.Объект;
	
	ВерсияФИ	= Форма.ВерсияФИ;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;
	
	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	
	ВерсияФИ.ВыплачиватьПроцентыПериодически = ЭтоОблигация И Не Объект.ДисконтнаяЦБ;
	
	Элементы.ТипПроцентнойСтавки.Видимость = ЭтоОблигация;
	Элементы.ЧислоДнейКупонногоПериода.Видимость = (ВерсияФИ.ПериодичностьУплатыПроцентов = ПредопределенноеЗначение("Перечисление.Периодичность.День"));
	
	Элементы.ГруппаФиксированнаяСтавкаСтавка.Видимость = НЕ ВерсияФИ.РучноеУправлениеИзменениямиСтавки;
	Элементы.РедактироватьПроцентныеСтавкиФиксированная.Видимость = ВерсияФИ.РучноеУправлениеИзменениямиСтавки;
	Элементы.РедактироватьПроцентныеСтавкиПлавающая.Видимость = ВерсияФИ.РучноеУправлениеИзменениямиСтавки;
	
	ЭтоФиксированнаяСтавка = (ВерсияФИ.ТипПроцентнойСтавки 
		= ПредопределенноеЗначение("Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная"));
	Элементы.ГруппаФиксированнаяСтавка.Видимость = ЭтоФиксированнаяСтавка;
	Элементы.ГруппаПлавающаяСтавка.Видимость = НЕ ЭтоФиксированнаяСтавка;
	
	ЗаголовокСтавка = ?(ЭтоОблигация, НСтр("ru = 'Ставка купона'"), НСтр("ru = 'Процентная ставка'"));
	Элементы.ПроцентнаяСтавка.Заголовок = ЗаголовокСтавка;
	Элементы.ИндикативнаяСтавка.Заголовок = ЗаголовокСтавка;
	
	Элементы.ГруппаПроцентнаяСтавка.Заголовок = ?(ЭтоОблигация, НСтр("ru = 'Ставка купонов'"), НСтр("ru = 'Процентная ставка'"));
	
	Если ВерсияФИ.ПорядокОпределенияСтавки = ПредопределенноеЗначение("Перечисление.ПорядокОпределенияСтавки.ПериодическаяФиксация") Тогда
		Элементы.ДекорацияДниПослеДатыИзменения.Видимость = Ложь;
		Элементы.ТочкаОтсчетаДатыФиксацииСтавки.Видимость = Истина;
		Элементы.СдвигДатыФиксацииСтавки.Заголовок = НСтр("ru = 'Ставка фиксируется за'");
	Иначе
		Элементы.ДекорацияДниПослеДатыИзменения.Видимость = Истина;
		Элементы.ТочкаОтсчетаДатыФиксацииСтавки.Видимость = Ложь;
		Элементы.СдвигДатыФиксацииСтавки.Заголовок = НСтр("ru = 'Ставка вступает в силу через'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПроценты_Дополнительно(Форма)
	
	Элементы	= Форма.Элементы;
	Объект		= Форма.Объект;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;

	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	//ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	
	Элементы.БазаДляРасчетаПроцентов.Видимость = ЭтоОблигация;
	Элементы.ПереносДатСНерабочихДней.Видимость = ЭтоОблигация;
	Элементы.ВерсияФИПроизводственныйКалендарь.Видимость = ЭтоОблигация;
	
	Элементы.ИзменяетсяДлительностьПроцентногоПериодаПриПереносе.Видимость = ЭтоОблигация;
	
	Элементы.ПериодичностьНачисленияПроцентов.ТолькоПросмотр = Не Объект.НачислениеПроцентовНаОтчетныеДаты;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПроценты_ПлатежВекселя(Форма)
	
	Элементы	= Форма.Элементы;
	Объект		= Форма.Объект;
	
	ВерсияФИ	= Форма.ВерсияФИ;
	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;

	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	ЭтоПлатежПоПредъявлении = ЭтоПлатежПоПредъявлении(ПараметрыЦеннойБумаги);
	
	УказанаДатаПредъявления = (ПараметрыЦеннойБумаги.СпособУказанияДатыПредъявления = ПредопределенноеЗначение("Перечисление.СпособыУказанияДатыПредъявленияВекселя.НеРанееУказаннойДаты"));
	НачислятьПроцентыСДатыПредъявления = (ПараметрыЦеннойБумаги.ВариантДатыНачалаНачисленияПроцентов = ПредопределенноеЗначение("Перечисление.ВариантыДатыНачалаНачисленияПроцентовПоВекселю.СДатыВозможногоПредъявления"));
	ЭтоФиксированная = (ВерсияФИ.ТипПроцентнойСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная"));
	
	Элементы.НачислятьПроцентыСДатыСоставления.Видимость = ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиДатаОкончанияНачисленияПроцентов.Видимость = ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиМаксимальнаяСуммаПроцентов.Видимость = ЭтоВексель И ЭтоФиксированная;
	Элементы.ПараметрыЦеннойБумагиВалютаНоминала.Видимость = ЭтоВексель;
	
	Элементы.ГруппаПлатежНеРанее.Видимость	= ЭтоВексель И ЭтоПлатежПоПредъявлении;
	Элементы.ДатаПлатежа.Видимость			= ЭтоВексель И Не ЭтоПлатежПоПредъявлении;
	Элементы.ПараметрыЦеннойБумагиДатаПредъявленияНеРанее.Видимость = ЭтоВексель И УказанаДатаПредъявления;
	Элементы.ПараметрыЦеннойБумагиДатаНачалаНачисленияПроцентов.Видимость = ЭтоВексель И Не НачислятьПроцентыСДатыПредъявления;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьДисконт(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Элементы.ЦенаВыпуска.Видимость = Объект.ДисконтнаяЦБ;
	Элементы.СтавкаДоходностиПоДисконту.Видимость = Объект.ДисконтнаяЦБ;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьСправочноВексель(Форма)

	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);

	Элементы.ПараметрыЦеннойБумагиМестоПлатежа.Видимость				= ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиМестоСоставления.Видимость			= ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиПодписантРуководитель.Видимость		= ЭтоВексель;
	Элементы.ПараметрыЦеннойБумагиПодписантГлавныйБухгалтер.Видимость	= ЭтоВексель;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьРЦБ(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);

	Элементы.РынокЦБ.Видимость		= Не ЭтоВексель;
	Элементы.Биржа.Видимость		= Не ЭтоВексель И Объект.ЭтоБиржевойРынок;
	Элементы.БиржевойКод.Видимость	= Не ЭтоВексель И Объект.ЭтоБиржевойРынок;
	Элементы.Котировка.Видимость	= Не ЭтоВексель И Объект.ЭтоБиржевойРынок;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьМСФО(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);

	Элементы.ВалютаКотировки.Видимость = Не ЭтоВексель;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьГрафик(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	ЭтоОблигация = ЦенныеБумагиКлиентСерверУХ.ЭтоОблигация(Объект.ВидФинансовогоИнструмента);
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	
	ЕстьГрафик = Не Объект.ДисконтнаяЦБ И ЭтоОблигация;
	
	Элементы.ГруппаГрафик.Видимость = ЕстьГрафик;
	Элементы.ГруппаСтраницы.ОтображениеСтраниц 
		= ?(ЕстьГрафик, ОтображениеСтраницФормы.ЗакладкиСверху, ОтображениеСтраницФормы.Нет);
	
	ВидФИ = Объект.ВидФинансовогоИнструмента;
	ФинансовыеИнструментыФормыКлиентСервер.УстановитьЗаголовкиГрафика(
		Форма, ВидФИ, Истина, "ВерсияЦБГрафик", "ВерсияЦБГрафикПроценты");	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЭСП(Форма)
	
	Объект = Форма.Объект;

	ДенежныйПоток = Новый Массив;
	ДенежныйПоток.Добавить(-Объект.ЦенаВыпуска);
	ДенежныйПоток.Добавить(Объект.Номинал);
	
	ДатыПотока = Новый Массив;
	ДатыПотока.Добавить(Объект.ДатаВыпуска);
	ДатыПотока.Добавить(Объект.СрокПогашения);

	Возврат ФинансоваяМатематикаКлиентСервер
		.ПолучитьЭффективнуюСтавкуПроцента(ДенежныйПоток, ДатыПотока, 0) * 100;
	
КонецФункции

#КонецОбласти

#Область Векселя

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДатыВекселя(Форма)
	
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Форма.Объект.ВидФинансовогоИнструмента);
	Если Не ЭтоВексель Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;
	
	Если ПараметрыЦеннойБумаги.СпособУказанияДатыПредъявления <> ПредопределенноеЗначение("Перечисление.СпособыУказанияДатыПредъявленияВекселя.НеРанееУказаннойДаты") Тогда
		ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее = ПараметрыЦеннойБумаги.ДатаСоставления;
	КонецЕсли;
	
	Если ПараметрыЦеннойБумаги.ВариантДатыНачалаНачисленияПроцентов = ПредопределенноеЗначение("Перечисление.ВариантыДатыНачалаНачисленияПроцентовПоВекселю.СДатыВозможногоПредъявления") Тогда
		ПараметрыЦеннойБумаги.ДатаНачалаНачисленияПроцентов = ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее + 86400;
	КонецЕсли;
	
	ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов = ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее + 365 * 86400;
	
	Если ДеньГода(КонецГода(ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее)) = 366 Тогда
		ДатаПроверки = Дата(Год(ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее),2,29);
	ИначеЕсли ДеньГода(КонецГода(ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов)) = 366 Тогда
		ДатаПроверки = Дата(Год(ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов),2,29);
	Иначе
		ДатаПроверки = Дата(1,1,1);
	КонецЕсли;
	
	Если ДатаПроверки >= ПараметрыЦеннойБумаги.ДатаПредъявленияНеРанее И ДатаПроверки <= ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов Тогда
		ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов = ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов + 86400; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуПроцентов(Форма)
	
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Форма.Объект.ВидФинансовогоИнструмента);
	Если Не ЭтоВексель Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЦеннойБумаги = Форма.ПараметрыЦеннойБумаги;
	
	Если ПараметрыЦеннойБумаги.ПредусмотренПроцентныйДоход Тогда
		ПараметрыЦеннойБумаги.МаксимальнаяСуммаПроцентов = ФинансоваяМатематикаКлиентСервер.СуммаПроцентовЗаПериод(
			ПараметрыЦеннойБумаги.ДатаНачалаНачисленияПроцентов,
			ПараметрыЦеннойБумаги.ДатаОкончанияНачисленияПроцентов,
			ПараметрыЦеннойБумаги.Номинал,
			ПараметрыЦеннойБумаги.ПроцентнаяСтавка);
	Иначе
		ПараметрыЦеннойБумаги.МаксимальнаяСуммаПроцентов = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцентныеСтавки

&НаКлиенте
Процедура НадписьРедактироватьПроцентныеСтавкиПродолжение(Результат, Параметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		ЗагрузитьТаблицуПроцентныхСтавок(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТаблицуПроцентныхСтавок(АдресХранилища)
	
	ВерсияФИ.ПроцентныеСтавки.Загрузить(ПолучитьИзВременногоХранилища(АдресХранилища));
	
КонецПроцедуры

#КонецОбласти

#Область График

&НаСервере
Процедура ЗаполнитьГрафикНаСервере()
	
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);
	Если ЭтоВексель Тогда
		Возврат;
	КонецЕсли;
	
	Если (Объект.Номинал = 0) 
		Или Не ЗначениеЗаполнено(Объект.ДатаВыпуска) 
		Или Не ЗначениеЗаполнено(Объект.СрокПогашения) Тогда
		
		ВерсияФИ.График.Очистить();
		Возврат;
		
	КонецЕсли;
	
	Объект.ДисконтнаяЦБ = ТипЦБ > 1;
	
	ЗаполнитьОсновнойДолгЦБ = Новый Структура(
		"ДатаВыпуска, ДатаПогашения, ОсновнойДолгПолучение, ОсновнойДолгВозврат",
			Объект.ДатаВыпуска, 
			Объект.СрокПогашения, 
			Объект.Номинал, 
			?(Объект.ДисконтнаяЦБ, Объект.ЦенаВыпуска, Объект.Номинал));

	СтрукутураДействий = Новый Структура(
		"ЗаполнитьОсновнойДолгЦБ, ЗаполнитьПроценты, СвернутьГрафик, РассчитатьСальдо",
		ЗаполнитьОсновнойДолгЦБ);
	
	Если Не Объект.ДисконтнаяЦБ Тогда
		СтрукутураДействий.Вставить("РассчитатьПроценты");
	КонецЕсли;
	
	КэшируемыеЗначения.ПараметрыГрафика.Вставить("Финансовыйинструмент", Объект);
	
	ВерсияФИ.График.Загрузить(ФинансовыеИнструментыФормыВызовСервера.ПолучитьГрафик(
		СтрукутураДействий, ВерсияФИ, КэшируемыеЗначения.ПараметрыГрафика));
	
	ФинансовыеИнструментыФормыКлиентСервер.ОбновитьИтогиФормаЦБ(ЭтаФорма, ВерсияФИ.График);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатуВерсии(Форма)
	
	ВерсияФИ.Дата = ТекущаяДата();
	
КонецПроцедуры

#Область ЗагрузкаГрафика

&НаКлиенте
Процедура ЗагрузитьГрафикЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия = Неопределено ИЛИ РезультатЗакрытия = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьГрафикСервер(РезультатЗакрытия);

КонецПроцедуры

&НаСервере
Функция ПолучитьАдресГрафика()
	
	ИменаКолонок = "Дата,ОсновнойДолгПолучение,ОсновнойДолгВозврат,ПроцентыНачислено,ПроцентыУплачено";
	
	ТаблицаГрафик = ВерсияФИ.График.Выгрузить(,ИменаКолонок);
	ПредставленияКолонок = Справочники.ОперацииГрафиковДоговоров.ПолучитьПараметрыПоВидуФИ(Объект.ВидФинансовогоИнструмента, Истина);
	
	Для каждого КолонкаГрафика Из ТаблицаГрафик.Колонки Цикл
		
		Если ПредставленияКолонок.Свойство(КолонкаГрафика.Имя, КолонкаГрафика.Заголовок) 
			И Не ЗначениеЗаполнено(КолонкаГрафика.Заголовок) Тогда
			КолонкаГрафика.Заголовок = КолонкаГрафика.Имя;
		КонецЕсли;
				
	КонецЦикла;
		
	Возврат ПоместитьВоВременноеХранилище(ТаблицаГрафик);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьГрафикСервер(АдресГрафика)
	
	ДанныеГрафика = ПолучитьИзВременногоХранилища(АдресГрафика);	
	ВерсияФИ.График.Загрузить(ДанныеГрафика.График);
		
	ФинансовыеИнструментыФормыВызовСервера.ПриИзмененииГрафикаНаФорме(ЭтаФорма, ВерсияФИ);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьИтогиСтрокиГрафика(СтрокаГрафика)

	СтрокаГрафика.ОсновнойДолгОстаток = СтрокаГрафика.ОсновнойДолгПолучение - СтрокаГрафика.ОсновнойДолгВозврат;
	СтрокаГрафика.ПроцентыОстаток = СтрокаГрафика.ПроцентыНачислено - СтрокаГрафика.ПроцентыУплачено;

КонецПроцедуры

&НаСервере
Процедура ВерсияЦБГрафикПриИзмененииНаСервере()
	ВерсияФИОбъект = РеквизитФормыВЗначение("ВерсияФИ");
	ФинансовыеИнструментыФормыВызовСервера.ПриИзмененииГрафикаНаФорме(ЭтаФорма, ВерсияФИОбъект);
	ЗначениеВРеквизитФормы(ВерсияФИОбъект, "ВерсияФИ");
КонецПроцедуры

#КонецОбласти

#КонецОбласти

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ТипЦБ = Объект.ДисконтнаяЦБ;
	ЭтоВексель = ЦенныеБумагиКлиентСерверУХ.ЭтоВексель(Объект.ВидФинансовогоИнструмента);

	ДокВерсия = ПолучитьОбъектВерсияЦБ();
	Если ДокВерсия <> Неопределено Тогда
		Если ЭтоВексель Тогда
			ЗначениеВРеквизитФормы(ДокВерсия, "ПараметрыЦеннойБумаги");
		Иначе 
			ЗначениеВРеквизитФормы(ДокВерсия, "ВерсияФИ");
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.ЗаблокироватьДанныеФормыДляРедактирования();
	УправлениеФормой(ЭтаФорма);
	ЦенныеБумагиКлиентСерверУХ.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОбъектВерсияЦБ()
	
	ИмяДокумента = ЦенныеБумагиКлиентСерверУХ.ПолучитьИмяДокумента(
		Объект.ВидФинансовогоИнструмента);
	
	ЕстьПараметрыЦБ = ЗначениеЗаполнено(Объект.ПараметрыЦеннойБумаги);
	Если ЕстьПараметрыЦБ 
		И (ИмяДокумента <> Объект.ПараметрыЦеннойБумаги.Метаданные().Имя) Тогда
		ЕстьПараметрыЦБ = Ложь;
	КонецЕсли;
	
	Если ЕстьПараметрыЦБ Тогда
		Возврат Объект.ПараметрыЦеннойБумаги.ПолучитьОбъект();
	ИначеЕсли Параметры.Свойство("ЗначениеКопирования")
		И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Возврат Параметры.ЗначениеКопирования.ПараметрыЦеннойБумаги.Скопировать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не Объект.Ссылка.Пустая() Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	т.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВерсияГрафикаЦеннойБумаги КАК т
		|ГДЕ
		|	т.ФинансовыйИнструмент = &ФИ");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
			"ВерсияГрафикаЦеннойБумаги", ИмяДокумента);
		
		Запрос.УстановитьПараметр("ФИ", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			Возврат РезультатЗапроса.Выгрузить().Получить(0).Получить(0).ПолучитьОбъект();
		КонецЕсли;
		
	КонецЕсли;
	
	ДокВерсия = Документы[ИмяДокумента].СоздатьДокумент();
	ДокВерсия.Заполнить(Объект);
	
	Возврат ДокВерсия;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПлатежПоПредъявлении(ПараметрыЦеннойБумаги)

	Возврат ПараметрыЦеннойБумаги.СрокПлатежаПоВекселю 
		= ПредопределенноеЗначение("Перечисление.СрокиПлатежаПоВекселю.ПоПредъявлении");

КонецФункции

#КонецОбласти
