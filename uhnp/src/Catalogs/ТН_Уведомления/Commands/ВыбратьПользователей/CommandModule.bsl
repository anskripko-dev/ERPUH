
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоВыбранные", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ВыборГруппПользователей", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Подбор получателей'"));
	ПараметрыФормы.Вставить("ЗаголовокСпискаВыбранных", НСтр("ru = 'Выбранные пользователи:'"));
	
	ДопПараметры = Новый Структура; 
	ДопПараметры.Вставить("МассивУведомлений", ПараметрКоманды);
	ДопПараметры.Вставить("Источник", ПараметрыВыполненияКоманды.Источник);
	
	ОписаниеОповещенияОбработкиВыбора = Новый ОписаниеОповещения("ЗавершитьПодборПолучателей", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник,,,,
					ОписаниеОповещенияОбработкиВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодборПолучателей(ВыбранныеПолучатели, ДопПараметры) Экспорт
	
	Если ВыбранныеПолучатели = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("ВыбранныеПолучатели", ?(ТипЗнч(ВыбранныеПолучатели) = Тип("Массив"), 
														ВыбранныеПолучатели, 
														ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранныеПолучатели)));
	СтруктураОтправки.Вставить("МассивУведомлений", ДопПараметры.МассивУведомлений);  
	
	ОткрытьФорму("Справочник.ТН_Уведомления.Форма.ФормаОтправки", СтруктураОтправки, ДопПараметры.Источник,,,,,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 
