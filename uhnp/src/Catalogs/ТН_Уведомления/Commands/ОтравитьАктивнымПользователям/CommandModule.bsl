
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВыбранныеПолучатели = ТН_РаботаСУведомлениями.МассивАктивныхПользователей();
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("ВыбранныеПолучатели", ?(ТипЗнч(ВыбранныеПолучатели) = Тип("Массив"),
														ВыбранныеПолучатели,
														ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранныеПолучатели)));
	СтруктураОтправки.Вставить("МассивУведомлений", ПараметрКоманды);  
	ОткрытьФорму("Справочник.ТН_Уведомления.Форма.ФормаОтправки", СтруктураОтправки, ПараметрыВыполненияКоманды.Источник,,,,,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
