#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ВыбранныеПолучатели") Тогда
		Получатели.ЗагрузитьЗначения(Параметры.ВыбранныеПолучатели);
	КонецЕсли;
	
	Если Параметры.Свойство("МассивУведомлений") Тогда
		СписокУведомлений.ЗагрузитьЗначения(Параметры.МассивУведомлений);
	КонецЕсли;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы      

&НаКлиенте
Процедура КомандаПодбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоВыбранные", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ВыборГруппПользователей", Истина);
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Подбор получателей'"));
	ПараметрыФормы.Вставить("ЗаголовокСпискаВыбранных", НСтр("ru = 'Выбранные пользователи:'"));
	
	ДопПараметры = Новый Структура; 
	ДопПараметры.Вставить("МассивУведомлений", СписокУведомлений.ВыгрузитьЗначения());
	ДопПараметры.Вставить("Источник", ЭтаФорма);
	
	ОписаниеОповещенияОбработкиВыбора = Новый ОписаниеОповещения("ЗавершитьПодборПолучателей", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,,
					ОписаниеОповещенияОбработкиВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры   

&НаКлиенте
Процедура КомандаОтправить(Команда)
	
	КомандаОтправитьНаСервере(); 
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.ТН_Уведомления"));
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура КомандаОтправитьНаСервере()  
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("ВыбранныеПолучатели", Получатели.ВыгрузитьЗначения());
	СтруктураОтправки.Вставить("МассивУведомлений", СписокУведомлений.ВыгрузитьЗначения());  
	
	РегистрыСведений.ТН_ОчередьУведомлений.ДобавитьУведомления(СтруктураОтправки); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьДоступность()  
	
	Элементы.КомандаОтправить.Доступность = Получатели.Количество();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодборПолучателей(ВыбранныеПолучатели, ДопПараметры) Экспорт
	
	Если ВыбранныеПолучатели = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Получатели.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранныеПолучатели));
	УстановитьВидимостьДоступность();
	
КонецПроцедуры 

#КонецОбласти

