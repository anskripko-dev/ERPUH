#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ФД.Видимость = ПоказыватьОписание; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент) 

	ПодключитьОбработчикОжидания("ОбработкаОжидания", 0.2, Истина);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПоказыватьОписаниеПриИзменении(Элемент)
	
	Элементы.ФД.Видимость = ПоказыватьОписание; 
	СписокПриАктивизацииСтроки(Элемент);
	
КонецПроцедуры  

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)  
	
	ТекущаяСтрока =  Элементы.Список.ТекущаяСтрока;
	Если ПоказыватьОписание Тогда
		ПоказатьОписаниеНаСервере(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПолучилиНажатие(Элемент, СтандартнаяОбработка)
	
	СтруктураОтборов = Новый Структура("Уведомление", Элемент.ТекущаяСтрока);
	ОткрытьОтчет(СтруктураОтборов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиталиНажатие(Элемент, СтандартнаяОбработка)
	
	СтруктураОтборов = Новый Структура("Уведомление", Элемент.ТекущаяСтрока);
	ОткрытьОтчет(СтруктураОтборов);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "Получили" Тогда  
		
		СтандартнаяОбработка = Ложь;
		ПолучилиНажатие(Элемент, СтандартнаяОбработка);
		Возврат;
		
	ИначеЕсли Поле.Имя = "Прочитали" Тогда 
		
		СтандартнаяОбработка = Ложь;
		ПрочиталиНажатие(Элемент, СтандартнаяОбработка);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработкаОжидания()
	
	Если Элементы.Дерево.ТекущаяСтрока <> Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Родитель", 
					Элементы.Дерево.ТекущаяСтрока,,, ЗначениеЗаполнено(Элементы.Дерево.ТекущаяСтрока));
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьОписаниеНаСервере(ТекущаяСтрока) 
	
	Если ТекущаяСтрока = Неопределено Тогда
		ФД.Удалить();
		Возврат;
	КонецЕсли;
	
	СтруктураКартинокВФорматеHTML = ТекущаяСтрока.Ссылка.КартинкиУведомления.Получить();
	
	Если СтруктураКартинокВФорматеHTML = Неопределено Тогда
		СтруктураКартинокВФорматеHTML = Новый Структура;
	КонецЕсли;
	
	ФД.УстановитьHTML(ТекущаяСтрока.Ссылка.Содержание, СтруктураКартинокВФорматеHTML); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(СтруктураОтборов)

	ФормаОтчета = ПолучитьФорму("Отчет.ТН_ОтчетДоставкиУведомлений.Форма");
	
	КомпоновщикНастроек = ФормаОтчета.Отчет.КомпоновщикНастроек; 
	Для Каждого Отбор Из СтруктураОтборов Цикл 
		УстановитьОтборСКД(КомпоновщикНастроек, Отбор.Ключ, Отбор.Значение);
	КонецЦикла;
	
	ФормаОтчета.СкомпоноватьРезультат(); 
	ФормаОтчета.ВариантМодифицирован = Ложь;
	ФормаОтчета.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСКД(КомпоновщикНастроек, ИмяПоля, Значение)

	ПолеОтбора = Новый ПолеКомпоновкиДанных(ИмяПоля);
	НовыйОтбор = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйОтбор.ЛевоеЗначение = ПолеОтбора;
	НовыйОтбор.ПравоеЗначение = Значение;
	НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйОтбор.Использование = Истина;
	
КонецПроцедуры

#КонецОбласти


