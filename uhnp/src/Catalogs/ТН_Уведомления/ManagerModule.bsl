
Функция СоздатьУведомление(Текст, СрокУведомления = Неопределено, Наименование = "") Экспорт
	
	Элемент = СоздатьЭлемент();
	
	Элемент.ДатаСоздания = ТекущаяДатаСеанса();
	Элемент.Содержание = Текст;
	Элемент.Автор = Пользователи.ТекущийПользователь();
	Элемент.СрокУведомления = СрокУведомления;
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Элемент.Наименование = "Обновление";
	КонецЕсли;
	
	Элемент.Записать();
	
	Возврат Элемент.Ссылка;
	
КонецФункции