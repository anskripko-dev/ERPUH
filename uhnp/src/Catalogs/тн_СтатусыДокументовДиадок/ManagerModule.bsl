#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция ПолучитьЗначениеСтатуса(НаименованиеСтатуса) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_СтатусыДокументовДиадок.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.тн_СтатусыДокументовДиадок КАК тн_СтатусыДокументовДиадок
		|ГДЕ
		|	тн_СтатусыДокументовДиадок.Наименование = &Наименование
		|	И НЕ тн_СтатусыДокументовДиадок.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеСтатуса);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Спр = Справочники.тн_СтатусыДокументовДиадок.СоздатьЭлемент();
		Спр.Наименование = НаименованиеСтатуса;
		Спр.Записать();
		Возврат Спр.Ссылка;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
	 	Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
		
КонецФункции
#КонецЕсли