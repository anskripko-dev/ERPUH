
&НаСервере
Функция ПолучитьМакетЗакупочнойПроцедуры(ЗакупочнаяПроцедура) Экспорт
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныМакетаЗакупочныхПроцедур.Ссылка КАК Шаблон
	               |ИЗ
	               |	Справочник.ШаблоныМакетаЗакупочныхПроцедур КАК ШаблоныМакетаЗакупочныхПроцедур
	               |ГДЕ
	               |	ШаблоныМакетаЗакупочныхПроцедур.ПометкаУдаления = ложь
	               |	И ШаблоныМакетаЗакупочныхПроцедур.СпособыВыбораПоставщика = &СпособыВыбораПоставщика
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ЭТП = &ЭТП
	               |	И ШаблоныМакетаЗакупочныхПроцедур.ЗакрытаяЗакупка = &ЗакрытаяЗакупка";
	Запрос.УстановитьПараметр("СпособыВыбораПоставщика",ЗакупочнаяПроцедура.СпособВыбораПоставщика);
	Запрос.УстановитьПараметр("ЭТП",ЗакупочнаяПроцедура.ЭТП);
	Запрос.УстановитьПараметр("ЗакрытаяЗакупка",ЗакупочнаяПроцедура.ЗакрытаяЗакупка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Шаблон;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции

&НаСервере
Функция УстановитьПараметры(ОбъектПечати,МакетПечати) Экспорт

	ТекстМакета = МакетПечати;
	
	НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураДопРеквизит");
	Свойства = УправлениеСвойствами.ПолучитьЗначенияСвойств(ОбъектПечати,Истина,Истина);
	ТекстМакета = СтрЗаменить(ТекстМакета, " (Справочник &quot;Закупочные процедуры&quot;)"," (Справочник ""Закупочные процедуры"")");
	Пока НомерСтрокиНачало > 0 Цикл
		Окончание = СтрНайти(ТекстМакета," (Справочник ""Закупочные процедуры"")]");
		СтрокаПоиска = Сред(ТекстМакета,НомерСтрокиНачало,Окончание-НомерСтрокиНачало);
		ИмяРеквизита = СтрЗаменить(СтрокаПоиска,"[ЗакупочнаяПроцедураДопРеквизит.","")+" (Справочник ""Закупочные процедуры"")";
		ЗначениеРеквизита = "";
		Для Каждого Элемент ИЗ Свойства Цикл
			Если Строка(Элемент.Свойство) = ИмяРеквизита Тогда
				ЗначениеРеквизита = Элемент.Значение;	
			КонецЕсли;
		КонецЦикла;	
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
			ЗначениеРеквизита = Формат(ЗначениеРеквизита,"ДЛФ=ДД");
		КонецЕсли;	
		СтрДЛ = СтрДлина("[ЗакупочнаяПроцедураДопРеквизит."+ИмяРеквизита+"]");
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1) + Строка(ЗначениеРеквизита) + Сред(ТекстМакета,НомерСтрокиНачало+СтрДЛ);
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураДопРеквизит");
	КонецЦикла;
	
	НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураПрограммныйРеквизит");
	Пока НомерСтрокиНачало > 0 Цикл
		Окончание = СтрНайти(сред(ТекстМакета,НомерСтрокиНачало),"]")+НомерСтрокиНачало;
		СтрокаПоиска = Сред(ТекстМакета,НомерСтрокиНачало,Окончание-НомерСтрокиНачало-1);
		ИмяРеквизита = СтрЗаменить(СтрокаПоиска,"[ЗакупочнаяПроцедураПрограммныйРеквизит.","");
		ВычисляемоеЗначение = ВычисляемоеЗначение(ИмяРеквизита,ОбъектПечати);
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1) + Строка(ВычисляемоеЗначение) + Сред(ТекстМакета,Окончание);
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураПрограммныйРеквизит");
	КонецЦикла;

	НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураСуммаПрописью");
	Пока НомерСтрокиНачало > 0 Цикл  
		Окончание = СтрНайти(сред(ТекстМакета,НомерСтрокиНачало),"]")+НомерСтрокиНачало;
		СтрокаПоиска = Сред(ТекстМакета,НомерСтрокиНачало,Окончание-НомерСтрокиНачало-1);
		ИмяРеквизита = СтрЗаменить(СтрокаПоиска,"[ЗакупочнаяПроцедураСуммаПрописью.","");
		Попытка                              
			ЗначениеРеквизита = ЧислоПрописью(ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ОбъектПечати,ИмяРеквизита),," , , , , , , , , 0");
		Исключение
			ЗначениеРеквизита = "";
		КонецПопытки;
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1) + Строка(ЗначениеРеквизита) + Сред(ТекстМакета,Окончание+1);
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедураСуммаПрописью");
	КонецЦикла;	
	
	НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедура");
	Пока НомерСтрокиНачало > 0 Цикл
		Окончание = СтрНайти(ТекстМакета,"]");
		СтрокаПоиска = Сред(ТекстМакета,НомерСтрокиНачало,Окончание-НомерСтрокиНачало);
		ИмяРеквизита = СтрЗаменить(СтрокаПоиска,"[ЗакупочнаяПроцедура.","");
		Попытка
			ЗначениеРеквизита = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ОбъектПечати,ИмяРеквизита);
		Исключение
			ЗначениеРеквизита = "";
		КонецПопытки;
		Если ТипЗнч(ЗначениеРеквизита) = Тип("Дата") Тогда
			ЗначениеРеквизита = Формат(ЗначениеРеквизита,"ДЛФ=ДД");
		КонецЕсли;	
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1) + Строка(ЗначениеРеквизита) + Сред(ТекстМакета,Окончание+1);
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"[ЗакупочнаяПроцедура");
	КонецЦикла;
	
	НомерСтрокиНачало = СтрНайти(ТекстМакета,"{ТаблицаЛотов.КолонкиНачало"); 
	Пока НомерСтрокиНачало > 0 Цикл
		Окончание = СтрНайти(ТекстМакета,"ТаблицаЛотов.КолонкиОкончание}");
		Колонки = Сред(ТекстМакета,НомерСтрокиНачало,Окончание);		
		ТаблицаЛотов = ПолучитьТаблицуЛотов(ОбъектПечати,Колонки);
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1)+ ТаблицаЛотов + Сред(ТекстМакета,Окончание+СтрДлина("ТаблицаЛотов.КолонкиОкончание}"));
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"ТаблицаЛотов.КолонкиНачало"); 
	КонецЦикла;

	НомерСтрокиНачало = СтрНайти(ТекстМакета,"{ТаблицаМероприятий.КолонкиНачало"); 
	Пока НомерСтрокиНачало > 0 Цикл
		ТаблицаЛотов = ПолучитьТаблицуМероприятий(ОбъектПечати);
		Окончание = СтрНайти(ТекстМакета,"ТаблицаМероприятий.КолонкиОкончание}");
		ТекстМакета = Сред(ТекстМакета,0,НомерСтрокиНачало-1)+ ТаблицаЛотов + Сред(ТекстМакета,Окончание+СтрДлина("ТаблицаМероприятий.КолонкиОкончание}"));
		НомерСтрокиНачало = СтрНайти(ТекстМакета,"ТаблицаМероприятий.КолонкиНачало"); 
	КонецЦикла;
	
	ТекстМакета = СтрЗаменить(ТекстМакета,"</body>","");
	ТекстМакета = СтрЗаменить(ТекстМакета,"</html>","");
	ТекстМакета = ТекстМакета + " </body>";
	ТекстМакета = ТекстМакета + " </html>";
	
	Возврат ТекстМакета;
	
КонецФункции

Функция ВычисляемоеЗначение(ИмяРеквизита,ОбъектПечати)
	Если ИмяРеквизита = "СуммаЗакупочнойПроцедуры" Тогда 
		Значение = Справочники.ЗакупочныеПроцедуры.РасчитатьСуммуПоЛотам(
		ОбъектПечати.Ссылка,
		ОбъектПечати.ВалютаДокумента,
		ТекущаяДатаСеанса());	
		Возврат Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Функция ПолучитьТаблицуЛотов(ОбъектПечати,Колонки)
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	Лоты.Ссылка КАК Наименование,
	             |	Лоты.МетодОценкиПредложенийПоставщиков КАК МетодОценкиПредложенийПоставщиков,
	             |	Лоты.СуммаЛота КАК СуммаЛота,
	             |	Лоты.ВалютаДокумента КАК Валюта
	             |ИЗ
	             |	Документ.Лот КАК Лоты
	             |ГДЕ
	             |	Лоты.ПометкаУдаления = ЛОЖЬ
	             |	И Лоты.ЗакупочнаяПроцедура = &ссылка"; 
	Запрос.УстановитьПараметр("Ссылка",ОбъектПечати);
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ПунктПорядкуИспользуется",ИСТИНА);
	СтруктураПараметров.Вставить("ЦветШапки","eadbaf");
	СтруктураПараметров.Вставить("Ширина3","300");
	СтруктураПараметров.Вставить("Положение1","center");
	СтруктураПараметров.Вставить("Положение2","center");
	СтруктураПараметров.Вставить("Положение3","center");
	СтруктураПараметров.Вставить("Положение4","center");
	СтруктураПараметров.Вставить("Заголовок1","Наименование");
	СтруктураПараметров.Вставить("Заголовок2","Метод оценки"); 
	СтруктураПараметров.Вставить("Заголовок3","Сумма по лоту");
	СтруктураПараметров.Вставить("Заголовок4","Валюта");	
	Если СтрНайти(Колонки,"Наименование") = 0 Тогда
		ТаблицаЗначений.Колонки.Удалить("Наименование");
	КонецЕсли;	
	ТаблицаЗначенийВТаблицуХТМЛ = ТаблицаЗначенийВТаблицуХТМЛ(ТаблицаЗначений,СтруктураПараметров);
	Возврат ТаблицаЗначенийВТаблицуХТМЛ;
КонецФункции	

Функция ПолучитьТаблицуМероприятий(ОбъектПечати)
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ПрогрессСтадийМероприятий.ДатаНачала КАК ДатаНачала,
	             |	ПрогрессСтадийМероприятий.ДатаОкончания КАК ДатаОкончания,
	             |	ПрогрессСтадийМероприятий.Стадия КАК Стадия
	             |ИЗ
	             |	РегистрСведений.ПрогрессСтадийМероприятий КАК ПрогрессСтадийМероприятий
	             |ГДЕ
	             |	ПрогрессСтадийМероприятий.Мероприятие.Контекст = &Ссылка
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ПрогрессСтадийМероприятий.НомерСтроки"; 
	Запрос.УстановитьПараметр("Ссылка",ОбъектПечати);
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ПунктПорядкуИспользуется",ИСТИНА);
	СтруктураПараметров.Вставить("ЦветШапки","eadbaf");
	СтруктураПараметров.Вставить("Ширина3","300");
	СтруктураПараметров.Вставить("Положение1","center");
	СтруктураПараметров.Вставить("Положение2","center");
	СтруктураПараметров.Вставить("Положение3","left");
	СтруктураПараметров.Вставить("Положение4","left");
	СтруктураПараметров.Вставить("Заголовок1","Дата начала");	
	СтруктураПараметров.Вставить("Заголовок2","Дата окончания");
	СтруктураПараметров.Вставить("Заголовок3","Стадия");
	ТаблицаЗначенийВТаблицуХТМЛ = ТаблицаЗначенийВТаблицуХТМЛ(ТаблицаЗначений,СтруктураПараметров);
	Возврат ТаблицаЗначенийВТаблицуХТМЛ;
КонецФункции	

Функция ТаблицаЗначенийВТаблицуХТМЛ(ТабЗначений,СтруктураПараметрыТаблицыХТМЛ = Неопределено) Экспорт
	МассивИменКолонок = Новый Массив;
	
	Если ТипЗнч(СтруктураПараметрыТаблицыХТМЛ) <> Тип("Структура") Тогда
		СтруктураПараметрыТаблицыХТМЛ = Новый Структура;
	КонецЕсли;
				
	КоличествоКолонок = ТабЗначений.Колонки.Количество();
	ПунктПорядкуИспользуется = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ПунктПорядкуИспользуется"),СтруктураПараметрыТаблицыХТМЛ.ПунктПорядкуИспользуется,ЛОЖЬ);	
	
	Если КоличествоКолонок < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	ЦветШапки = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ЦветШапки")," bgcolor=""#" + СтруктураПараметрыТаблицыХТМЛ.ЦветШапки + """","");
	ШиринаТаблицы = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ШиринаТаблицы")," style=""width:" + СтруктураПараметрыТаблицыХТМЛ.ШиринаТаблицы + "px""",""); 
	ТаблицаХТМЛ = "<table border=""1"" cellpadding=""1"" cellspacing=""0"" " + ШиринаТаблицы + ">
				|<tbody>
				|<tr>";
	
	//Первым выводим столбик П/П если он задан в шапку
	Если ПунктПорядкуИспользуется Тогда
		ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|<td"  " style=""width:30px"" align=""center"">п/п</td>";	
	КонецЕсли;
	
	//Формируем шапку
	Для Счетчик = 1 по КоличествоКолонок Цикл
		ИмяСвойстваШирина = "Ширина" + Счетчик;
		ШиринаСтолбца = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство(ИмяСвойстваШирина)," style=""width:" + СтруктураПараметрыТаблицыХТМЛ[ИмяСвойстваШирина] + "px""","");
		ИмяКолонки = ТабЗначений.Колонки[Счетчик-1].Имя;
		ИмяКолонкиЗаголовок = ИмяКолонки;
		ИмяСвойстваЗаголовок = "Заголовок" + Счетчик;
		ЗаголовокКолонки = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство(ИмяСвойстваЗаголовок),СтруктураПараметрыТаблицыХТМЛ[ИмяСвойстваЗаголовок],ИмяКолонкиЗаголовок);
		ТаблицаХТМЛ = ТаблицаХТМЛ + " 
				|<td" + ШиринаСтолбца + " align=""center"">" + ЗаголовокКолонки + "</td>";	
		МассивИменКолонок.Добавить(ИмяКолонки);
	КонецЦикла;
	ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|</tr>";
	
	//Заполняем таблицу	
	ПунктПорядку = 0;
	Для каждого СтрокаТаблицы Из ТабЗначений Цикл
		ПунктПорядку = ПунктПорядку + 1;
		ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|<tr>" + ?(ПунктПорядкуИспользуется, Символы.ПС + "<td align=""center"">" + ПунктПорядку + "</td>","") + "";
		Для Счетчик = 0 по КоличествоКолонок - 1 Цикл
			ИмяСвойстваПоложение = "Положение" + Строка(Счетчик + 1);
			Положение = " align=""" + ?(СтруктураПараметрыТаблицыХТМЛ.Свойство(ИмяСвойстваПоложение),СтруктураПараметрыТаблицыХТМЛ[ИмяСвойстваПоложение],"left") + """";
			Значение = СтрокаТаблицы[МассивИменКолонок[Счетчик]];
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Значение = Формат(Значение,"ДЛФ=ДД");
			КонецЕсли;	
			
			ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|<td " + Положение + ">" + Значение + "</td>";			
		КонецЦикла;				
		ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|</tr>";
	КонецЦикла;	
	
	ТаблицаХТМЛ = ТаблицаХТМЛ + " 
				|</tbody>
				|</table>";
	
	Возврат ТаблицаХТМЛ;

КонецФункции

Процедура ПредзаполнитьИзвещенияПоСпособамЗакупок() Экспорт
	
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СпособВыбораПоставщика.СпособыВыбораПоставщика КАК СпособыВыбораПоставщика
	               |ИЗ
	               |	Справочник.СпособыВыбораПоставщика КАК СпособВыбораПоставщика
	               |ГДЕ
	               |	НЕ СпособВыбораПоставщика.ПометкаУдаления
	               |	И НЕ СпособВыбораПоставщика.СпособыВыбораПоставщика = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.ПустаяСсылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СпособВыбораПоставщика.СпособыВыбораПоставщика";
