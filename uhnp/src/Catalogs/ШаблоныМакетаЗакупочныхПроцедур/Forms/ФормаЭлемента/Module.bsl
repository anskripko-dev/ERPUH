#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	ЗагрузитьДеревоМетаданных();
	
	ДополнительныеПараметры = Новый Структура;
    ДополнительныеПараметры.Вставить("Объект", Объект);
    ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
   // УправлениеСвойствами.ПриСозданииНаСервере(ЭтаФорма, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЦветФонаЗаменяемогоПараметра = ПечатьДоговоров.ЦветФонаЗаменяемогоПараметра();
	Если Объект.ТекстHTML = "" Тогда   //ЗакупочныеПроцедуры  
		Макет = Справочники.ШаблоныМакетаЗакупочныхПроцедур.ПолучитьМакет("ШаблонЗакупочнойПроцедуры").ПолучитьТекст();
	Иначе
		Макет = Объект.ТекстHTML;
	КонецЕсли;
	ТекстПросьбы = Символы.ПС + Символы.Таб + НСтр("ru = 'Пожалуйста, подождите...'");
	ШрифтПросьбы = Новый Шрифт( , 18, Истина);
	ПросьбаПодождать = Новый ФорматированнаяСтрока(ТекстПросьбы, ШрифтПросьбы);
	ФорматированныйДокумент.УстановитьФорматированнуюСтроку(ПросьбаПодождать);
	ФорматированныйДокумент.УстановитьHTML(Макет,Новый Структура());	
	
	СписокЗначенийДопРеквизитов = Справочники.ЗакупочныеПроцедуры.ПолучитьСвойстваНастроекДопРеквизитов();
	СчетчикДляГруппы = 0;
	Счетчик = 0;
	Для Каждого Элемент ИЗ СписокЗначенийДопРеквизитов Цикл
		
		Если СчетчикДляГруппы = 0 Тогда
			ГруппаШапка = ЭтаФорма.Элементы.Добавить("ГруппаДопРеквизит"+Счетчик, Тип("ГруппаФормы"),Элементы.ГруппаДополнительныеРеквизиты);
			ГруппаШапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаШапка.Отображение = ОтображениеОбычнойГруппы.Нет;
			ГруппаШапка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			ГруппаШапка.РастягиватьПоГоризонтали = ИСТИНА;
		КонецЕсли;
		Реквизиты = Новый Массив;

		Реквизиты.Добавить(Новый РеквизитФормы(Элемент.Значение.ИдентификаторДляФормул,Новый ОписаниеТипов(Элемент.Значение.ТипЗначения),,Элемент.Значение.Заголовок));
		ЭтаФорма.ИзменитьРеквизиты(Реквизиты);
		
		ПолеВвода = Элементы.Добавить(Элемент.Значение.ИдентификаторДляФормул,Тип("ПолеФормы"),Элементы.ГруппаДополнительныеРеквизиты);	    
		
		ПолеВвода.Заголовок = Элемент.Значение.Заголовок;
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.ПутьКДанным = Элемент.Значение.ИдентификаторДляФормул;		
		СчетчикДляГруппы = СчетчикДляГруппы + 1;
		
		Если СчетчикДляГруппы = 2 Тогда
			СчетчикДляГруппы = 0;
		КонецЕсли;	
		Счетчик = Счетчик + 1;
	КонецЦикла;	
	
	УстановитьЗначенияДопСвойств();
	Если Объект.ВЭлектроннойФорме Тогда
		//Элементы.СпособСозданияДоговора.Видимость  = Истина;
		Элементы.ЭТП.Видимость  = Истина;
	Иначе
	//	Элементы.СпособСозданияДоговора.Видимость = Ложь;
		Элементы.ЭТП.Видимость  = Ложь;
	КонецЕсли;
		
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьДеревоМетаданных()
	
	ЗаполнитьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ТекстHTML = "";
	ФорматированныйДокумент.ПолучитьHTML(ТекстHTML,Новый Структура());
	Объект.ТекстHTML =  ТекстHTML;
	ЗаписатьДопСвойство();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДерево()
 	ДеревоМетаданных = РеквизитФормыВЗначение("ДеревоМетаданныхЗакупочныхПроцедур");
	ОбработанныеТипы = Новый Массив;            
	ПостроитьДеревоМетаданныхСправочника( Новый ОписаниеТипов("СправочникСсылка.ЗакупочныеПроцедуры"), ДеревоМетаданных, ОбработанныеТипы);
	ЗначениеВРеквизитФормы(ДеревоМетаданных, "ДеревоМетаданныхЗакупочныхПроцедур");
КонецПроцедуры

&НаСервере
Процедура ПостроитьДеревоМетаданныхСправочника(ОписаниеТипов, Дерево, ОбработанныеТипы)
	
	НоваяСтрока = Дерево.Строки.Добавить();
	НоваяСтрока.Элемент = "ЗакупочныеПроцедуры";
	НоваяСтрока.Синоним = "Закупочные процедуры";
	
	Типы = ОписаниеТипов.Типы();
	Для каждого Тип Из Типы Цикл
		Если Типы.Количество() > 1 Тогда
			СтрокаТипа = НоваяСтрока.Строки.Добавить();
			СтрокаТипа.Элемент = " (ТИП: "+Тип + ")";
			СтрокаТипа.Синоним = " (ТИП: "+Тип + ")";
		Иначе
			СтрокаТипа = НоваяСтрока;
			СтрокаТипа.Элемент = НоваяСтрока.Элемент;
			СтрокаТипа.Синоним = НоваяСтрока.Элемент;		
		КонецЕсли;	
		Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
		    Если ОбработанныеТипы.Найти(Тип)=Неопределено Тогда
				СсылкаМетаданные = Метаданные.НайтиПоТипу(Тип);
				ОбработанныеТипы.Добавить(Тип);
				ДобавитьКоллекцию(СтрокаТипа, "Стандартные реквизиты", "СтандартныеРеквизиты", Неопределено, ОбработанныеТипы, СсылкаМетаданные);
				ДобавитьКоллекцию(СтрокаТипа, "Реквизиты", "Реквизиты", Неопределено, ОбработанныеТипы, СсылкаМетаданные);
				ОбработанныеТипы.Удалить(ОбработанныеТипы.Количество()-1);
				НоваяСтрока = СтрокаТипа.Строки.Добавить();
				НоваяСтрока.Элемент = "Табличная часть. Лоты закупочных процедур";
				НоваяСтрока.Синоним = "Табличная часть. Лоты закупочных процедур";
				НоваяСтрока = СтрокаТипа.Строки.Добавить();
				НоваяСтрока.Элемент = "Табличная часть. Стадии мероприятий";
				НоваяСтрока.Синоним = "Табличная часть. Стадии мероприятий";
				НоваяСтрока = СтрокаТипа.Строки.Добавить();
				НоваяСтрока.Элемент = "Программный реквизит. СуммаЗакупочнойПроцедуры";
				НоваяСтрока.Синоним = "Программный реквизит. Сумма закупочной процедуры";
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеРеквизиты = УправлениеСвойствами.ПолучитьСписокСвойств(Справочники.ЗакупочныеПроцедуры.ПустаяСсылка());	
	НоваяСтрока = Дерево.Строки.Добавить();
	НоваяСтрока.Элемент = "Дополнительные реквизиты справочника";
	НоваяСтрока.Синоним = "Дополнительные реквизиты справочника";
	
	Для Каждого Элемент ИЗ ДополнительныеРеквизиты Цикл
		ДопРеквизит = НоваяСтрока.Строки.Добавить();
		ДопРеквизит.Элемент = Элемент;
		ДопРеквизит.Синоним = Элемент;
	КонецЦикла;	
	

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКоллекцию(Строка, ИмяСтроки, ИмяКоллекции, Тип=Неопределено, ОбработанныеТипы, СсылкаМетаданные)
	НоваяСтрока = Строка.Строки.Добавить();
	НоваяСтрока.Элемент = ИмяСтроки;
	НоваяСтрока.Синоним = ИмяСтроки;
	Для каждого Элемент Из СсылкаМетаданные[ИмяКоллекции] Цикл
		Если Тип = Неопределено Тогда
			ТипДанных = Элемент.Тип;
		Иначе
			ТипДанных = Тип;
		КонецЕсли;
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			Синоним = Элемент.Имя;
		Иначе 
			Синоним = Элемент.Синоним;
		КонецЕсли;	
		НовСтрока = ПостроитьДерево(Элемент.Имя,Синоним, ТипДанных, НоваяСтрока, ОбработанныеТипы);   
		Если Строка(ТипДанных) = "Число" Тогда
			НовСтрока = ПостроитьДерево(Элемент.Имя,"СуммаПрописью()."+Синоним, ТипДанных, НоваяСтрока, ОбработанныеТипы);   
		КонецЕсли;			
		ПостроитьДеревоОбъекта(Элемент.Имя, ТипДанных, НовСтрока, ОбработанныеТипы,Элемент); 
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПостроитьДеревоОбъекта(Имя,ОписаниеТипов, НоваяСтрока, ОбработанныеТипы,Элемент)
	
	//НоваяСтрока = Дерево.Строки.Добавить();
	//НоваяСтрока.Элемент = Имя;
	Типы = ОписаниеТипов.Типы();
	Для каждого Тип Из Типы Цикл
		Если Типы.Количество() > 1 Тогда
			СтрокаТипа = НоваяСтрока.Строки.Добавить();
			СтрокаТипа.Элемент = " (ТИП: "+Тип + ")";
			СтрокаТипа.Синоним = " (ТИП: "+Тип + ")";
		Иначе
			СтрокаТипа = НоваяСтрока;
			СтрокаТипа.Элемент = НоваяСтрока.Элемент;	
			СтрокаТипа.Синоним = ?(НоваяСтрока.Синоним="",НоваяСтрока.Элемент,НоваяСтрока.Синоним);		
		КонецЕсли;	
		Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
		    Если ОбработанныеТипы.Найти(Тип)=Неопределено Тогда
				СсылкаМетаданные = Метаданные.НайтиПоТипу(Тип);
				ОбработанныеТипы.Добавить(Тип);
				ДобавитьКоллекциюОбъекта(СтрокаТипа, "Стандартные реквизиты", "СтандартныеРеквизиты", Неопределено, ОбработанныеТипы, СсылкаМетаданные,Имя);
				ДобавитьКоллекциюОбъекта(СтрокаТипа, "Реквизиты", "Реквизиты", Неопределено, ОбработанныеТипы, СсылкаМетаданные,Имя);
				ОбработанныеТипы.Удалить(ОбработанныеТипы.Количество()-1);
				  
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКоллекциюОбъекта(Строка, ИмяСтроки, ИмяКоллекции, Тип=Неопределено, ОбработанныеТипы, СсылкаМетаданные,Имя)
	НоваяСтрока = Строка.Строки.Добавить();
	НоваяСтрока.Элемент = ИмяСтроки;
	НоваяСтрока.Синоним = ИмяСтроки;
	Для каждого Элемент Из СсылкаМетаданные[ИмяКоллекции] Цикл
		Если Тип = Неопределено Тогда
			ТипДанных = Элемент.Тип;
		Иначе
			ТипДанных = Тип;
		КонецЕсли;
		//ПостроитьДеревоОбъекта(Элемент.Имя, ТипДанных, НоваяСтрока, ОбработанныеТипы);
		СтрокаНов = ПостроитьДерево(Элемент.Имя,?(Элемент.Синоним="",Элемент.Имя,Элемент.Синоним), ТипДанных, НоваяСтрока, ОбработанныеТипы,Имя+".");
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПостроитьДерево(Имя, Синоним, ОписаниеТипов, Дерево, ОбработанныеТипы,ИмяРодителя = "")
	НоваяСтрока = Дерево.Строки.Добавить();
	НоваяСтрока.Элемент = Имя;
	НоваяСтрока.Синоним = Синоним;
	Типы = ОписаниеТипов.Типы();
	Для каждого Тип Из Типы Цикл
		Если Типы.Количество() > 1 Тогда
			СтрокаТипа = НоваяСтрока.Строки.Добавить();
			СтрокаТипа.Элемент = " (ТИП: "+Тип + ")";
			СтрокаТипа.Синоним = " (ТИП: "+Тип + ")";
			
		Иначе
			СтрокаТипа = НоваяСтрока;
			СтрокаТипа.Элемент = ИмяРодителя + НоваяСтрока.Элемент;	
			СтрокаТипа.Синоним = Синоним;
		КонецЕсли;	
	КонецЦикла;
	Возврат  НоваяСтрока;
КонецФункции


&НаКлиенте
Процедура ДеревоМетаданныхЗакупочныхПроцедурОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	к=1;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхЗакупочныхПроцедурВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	к=1; 
	Текст = ДеревоМетаданныхЗакупочныхПроцедур.НайтиПоИдентификатору(ВыбраннаяСтрока).Элемент;
	
	ЗакладкаНачала = Неопределено;
	ЗакладкаОкончания = Неопределено;
	Элементы.ФорматированныйДокумент.ПолучитьГраницыВыделения(ЗакладкаНачала, ЗакладкаОкончания);
	ПозицияНачала = ФорматированныйДокумент.ПолучитьПозициюПоЗакладке(ЗакладкаНачала);
	ПозицияОкончания = ФорматированныйДокумент.ПолучитьПозициюПоЗакладке(ЗакладкаОкончания);
	Если ЗакладкаНачала <> ЗакладкаОкончания Тогда 
		ФорматированныйДокумент.Удалить(ЗакладкаНачала, ЗакладкаОкончания);
		Элементы.ФорматированныйДокумент.УстановитьГраницыВыделения(ЗакладкаНачала, ЗакладкаНачала);
	КонецЕсли;
	ШрифтПоУмолчанию = Неопределено;
	ЦветФонаПоУмолчанию = Неопределено;
	ВыделенныеЭлементы = ФорматированныйДокумент.ПолучитьЭлементы(ЗакладкаНачала, ЗакладкаОкончания);
	// Ищем последний текстовый элемент среди выделенных для копирования его шрифта.
	Сч = ВыделенныеЭлементы.Количество() - 1;
	Пока Сч >= 0 Цикл
		Если ТипЗнч(ВыделенныеЭлементы[Сч]) = Тип("ТекстФорматированногоДокумента") Тогда
			ШрифтПоУмолчанию 	= ВыделенныеЭлементы[Сч].Шрифт;
			ЦветФонаПоУмолчанию = ВыделенныеЭлементы[Сч].ЦветФона;
			Прервать;
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;

	//ВременныйФорматированныйДокумент = ЗаменитьПараметрНаСервере(
	//	  ШаблонДоговора, ШрифтПоУмолчанию);
	Если ШрифтПоУмолчанию = Неопределено Тогда
		ШрифтПоУмолчанию = Новый Шрифт();
	КонецЕсли;	

	Если ЦветФонаПоУмолчанию = Неопределено Тогда
		ЦветФонаПоУмолчанию = ПечатьДоговоровКлиентСервер.ЦветФонаПоУмолчанию();
	КонецЕсли;
	
	Если ЗакладкаНачала <> ЗакладкаОкончания Тогда 
		ФорматированныйДокумент.Удалить(ЗакладкаНачала, ЗакладкаОкончания);
		Элементы.ФорматированныйДокумент.УстановитьГраницыВыделения(ЗакладкаНачала, ЗакладкаНачала);
	КонецЕсли;
	
	ПервыйЭлементДокумента = ФорматированныйДокумент.Добавить(" ", Тип("ТекстФорматированногоДокумента"));
	ПервыйЭлементДокумента.Шрифт = ШрифтПоУмолчанию;
	ЭлементДерева = ДеревоМетаданныхЗакупочныхПроцедур.НайтиПоИдентификатору(ВыбраннаяСтрока).Элемент;  
	СинонимДерева = ДеревоМетаданныхЗакупочныхПроцедур.НайтиПоИдентификатору(ВыбраннаяСтрока).Синоним;
	
	Если СтрНайти(ЭлементДерева,"Программный реквизит") > 0 Тогда
		Текст = "[ЗакупочнаяПроцедураПрограммныйРеквизит." + СтрЗаменить(ЭлементДерева,"Программный реквизит. ","") +"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"Табличная часть") = 0 И СтрНайти(ЭлементДерева,"Объем работ (Справочник ""Закупочные процедуры"")") = 0  
		И СтрНайти(СинонимДерева,"СуммаПрописью()") = 0 Тогда
		Текст = "[ЗакупочнаяПроцедура."+ЭлементДерева+"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"Табличная часть") = 0 И СтрНайти(ЭлементДерева,"Объем работ (Справочник ""Закупочные процедуры"")") = 0  
		И СтрНайти(СинонимДерева,"СуммаПрописью()") > 0 Тогда
		Текст = "[ЗакупочнаяПроцедураСуммаПрописью."+ЭлементДерева+"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));		
	ИначеЕсли СтрНайти(ЭлементДерева,"(Справочник ""Закупочные процедуры"")")>0 Тогда
		Текст = "[ЗакупочнаяПроцедураДопРеквизит."+ЭлементДерева+"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"Табличная часть. Стадии мероприятий")>0 Тогда
		Текст = "{ТаблицаМероприятий.КолонкиНачало}{ДатаНачала}{ДатаОкончания}{Стадия}{ТаблицаМероприятий.КолонкиОкончание}";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	Иначе 
		Текст = "{ТаблицаЛотов.КолонкиНачало}{Код}{Наименование}{МетодОценкиПредложенийПоставщиков}{ТаблицаЛотов.КолонкиОкончание}";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	КонецЕсли;	
КонецПроцедуры

&НаСервере
