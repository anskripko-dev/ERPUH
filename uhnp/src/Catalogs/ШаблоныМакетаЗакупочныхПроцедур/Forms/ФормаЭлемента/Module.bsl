		Если Объект.ДополнительныеРеквизитыДопСвойств.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
			
			НовоеСвойство = Объект.ДополнительныеРеквизитыДопСвойств.Добавить();
			НовоеСвойство.Свойство = Элемент.Значение;
			НовоеСвойство.Значение = ЭтаФорма[Элемент.Значение.ИдентификаторДляФормул];
