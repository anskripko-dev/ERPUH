		Иначе
			Объект.ДополнительныеРеквизитыДопСвойств.НайтиСтроки(СтруктураПоиска)[0].Значение = ЭтаФорма[Элемент.Значение.ИдентификаторДляФормул];
		КонецЕсли;	
	КонецЦикла;	

