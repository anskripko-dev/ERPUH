&НаКлиенте
Процедура ВставитьВМакет(Команда)   
	
	ВыбраннаяСтрока = Элементы.ДеревоМетаданныхЗакупочныхПроцедур.ТекущиеДанные;
	Если  ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	СтандартнаяОбработка = Ложь;
	к=1; 
	Текст = ВыбраннаяСтрока.Элемент;
	
	ЗакладкаНачала = Неопределено;
	ЗакладкаОкончания = Неопределено;
	Элементы.ФорматированныйДокумент.ПолучитьГраницыВыделения(ЗакладкаНачала, ЗакладкаОкончания);
	ПозицияНачала = ФорматированныйДокумент.ПолучитьПозициюПоЗакладке(ЗакладкаНачала);
	ПозицияОкончания = ФорматированныйДокумент.ПолучитьПозициюПоЗакладке(ЗакладкаОкончания);
	Если ЗакладкаНачала <> ЗакладкаОкончания Тогда 
		ФорматированныйДокумент.Удалить(ЗакладкаНачала, ЗакладкаОкончания);
		Элементы.ФорматированныйДокумент.УстановитьГраницыВыделения(ЗакладкаНачала, ЗакладкаНачала);
	КонецЕсли;
	ШрифтПоУмолчанию = Неопределено;
	ЦветФонаПоУмолчанию = Неопределено;
	ВыделенныеЭлементы = ФорматированныйДокумент.ПолучитьЭлементы(ЗакладкаНачала, ЗакладкаОкончания);
	// Ищем последний текстовый элемент среди выделенных для копирования его шрифта.
	Сч = ВыделенныеЭлементы.Количество() - 1;
	Пока Сч >= 0 Цикл
		Если ТипЗнч(ВыделенныеЭлементы[Сч]) = Тип("ТекстФорматированногоДокумента") Тогда
			ШрифтПоУмолчанию 	= ВыделенныеЭлементы[Сч].Шрифт;
			ЦветФонаПоУмолчанию = ВыделенныеЭлементы[Сч].ЦветФона;
			Прервать;
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;

	//ВременныйФорматированныйДокумент = ЗаменитьПараметрНаСервере(
	//	  ШаблонДоговора, ШрифтПоУмолчанию);
	Если ШрифтПоУмолчанию = Неопределено Тогда
		ШрифтПоУмолчанию = Новый Шрифт();
	КонецЕсли;	

	Если ЦветФонаПоУмолчанию = Неопределено Тогда
		ЦветФонаПоУмолчанию = ПечатьДоговоровКлиентСервер.ЦветФонаПоУмолчанию();
	КонецЕсли;
	
	Если ЗакладкаНачала <> ЗакладкаОкончания Тогда 
		ФорматированныйДокумент.Удалить(ЗакладкаНачала, ЗакладкаОкончания);
		Элементы.ФорматированныйДокумент.УстановитьГраницыВыделения(ЗакладкаНачала, ЗакладкаНачала);
	КонецЕсли;
	
	ПервыйЭлементДокумента = ФорматированныйДокумент.Добавить(" ", Тип("ТекстФорматированногоДокумента"));
	ПервыйЭлементДокумента.Шрифт = ШрифтПоУмолчанию;
	ЭлементДерева = ВыбраннаяСтрока.Элемент;
	Если СтрНайти(ЭлементДерева,"Программный реквизит") > 0 Тогда
		Текст = "[ЗакупочнаяПроцедураПрограммныйРеквизит." + СтрЗаменить(ЭлементДерева,"Программный реквизит. ","") +"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"Табличная часть") = 0 И СтрНайти(ЭлементДерева,"Объем работ (Справочник ""Закупочные процедуры"")") = 0 Тогда 
		Текст = "[ЗакупочнаяПроцедура."+ЭлементДерева+"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"(Справочник ""Закупочные процедуры"")")>0 Тогда
		Текст = "[ЗакупочнаяПроцедураДопРеквизит."+ЭлементДерева+"]";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	ИначеЕсли СтрНайти(ЭлементДерева,"Табличная часть. Стадии мероприятий")>0 Тогда
		Текст = "{ТаблицаМероприятий.КолонкиНачало}{ДатаНачала}{ДатаОкончания}{Стадия}{ТаблицаМероприятий.КолонкиОкончание}";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	Иначе 
		Текст = "{ТаблицаЛотов.КолонкиНачало}{Код}{Наименование}{МетодОценкиПредложенийПоставщиков}{ТаблицаЛотов.КолонкиОкончание}";
		НовыйЭлемент = ФорматированныйДокумент.Вставить(ЗакладкаНачала, Текст, Тип("ТекстФорматированногоДокумента"));
	КонецЕсли;	
