#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Создание новых элементов запрещено'"),,,,Отказ);
	КонецЕсли;
	
	Элементы.ДнейВМесяце.Доступность= НЕ Объект.ПоФактуМесяц;
	Элементы.ДнейВГоду.Доступность	= НЕ Объект.ПоФактуГод;
	
	Элементы.ГруппаГод.Видимость	= Не Объект.Предопределенный;
	Элементы.ГруппаМесяц.Видимость	= Не Объект.Предопределенный;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ПоФактуГодПриИзменении(Элемент)
	
	Если Объект.ПоФактуГод Тогда
		
		Объект.ДнейВГоду=0;
		
	КонецЕсли;
	
	Элементы.ДнейВГоду.Доступность=НЕ Объект.ПоФактуГод;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоФактуМесяцПриИзменении(Элемент)
	
	Если Объект.ПоФактуМесяц Тогда
		
		Объект.ДнейВМесяце=0;
		
	КонецЕсли;
	
	Элементы.ДнейВМесяце.Доступность=НЕ Объект.ПоФактуМесяц;
		
КонецПроцедуры

#КонецОбласти