
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НаименованиеСправочника	= Параметры.НаименованиеСправочника;
	НеЗакрыватьПриВыборе	= Параметры.НеЗакрыватьПриВыборе;
	Наименование			= Параметры.Наименование;
	
	СтрокаРеквизитов=Параметры.СтрокаРеквизитов;
	ОписаниеОбъектаБД=Параметры.ОписаниеОбъектаБД;
	
	Запрос=Новый Запрос;
	
	Если ЗначениеЗаполнено(ОписаниеОбъектаБД) Тогда
		
		ТаблицаАналитики=ОписаниеОбъектаБД.Метаданные().ПолноеИмя();
		ТекстОтбор=" ГДЕ ОписаниеОбъектаБД.Ссылка=&ОписаниеОбъектаБД";
		Запрос.УстановитьПараметр("ОписаниеОбъектаБД",ОписаниеОбъектаБД);
		
	Иначе
		
		ТаблицаАналитики="Справочник."+ОбщегоНазначенияУХ.ПолучитьИмяСправочникаОписанияПоТипуМетаданных(Параметры.ТипМетаДанных);
		ТекстОтбор=" ГДЕ ОписаниеОбъектаБД.Наименование=&СправочникБД
		|И ОписаниеОбъектаБД.Владелец=&ТипБД";
		
		Запрос.УстановитьПараметр("СправочникБД",Параметры.СправочникБД);
		Запрос.УстановитьПараметр("ТипБД",Параметры.ТипБД);	
		
	КонецЕсли;
	
	Запрос.Текст="ВЫБРАТЬ
	|	ОписаниеОбъектаБД.Ссылка КАК Ссылка,
	|	ОписаниеОбъектаБД.ТипОбъектаМетаданных КАК ТипОбъектаМетаданных,
	|	ОписаниеОбъектаБД.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных
	|ИЗ
	|	"+ТаблицаАналитики+" КАК ОписаниеОбъектаБД "+ТекстОтбор;
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	ОписаниеОбъектаБД		= Результат.Ссылка;
	ТипМетаДанных			= Результат.ТипОбъектаМетаданных;
	СправочникБД			= Результат.ИмяОбъектаМетаданных;

	Если ПустаяСтрока(СтрокаРеквизитов) Тогда
		
		Запрос.Текст="ВЫБРАТЬ
		|	РеквизитыОбъектаБД.Имя КАК Имя
		|ИЗ
		|	"+ТаблицаАналитики+".Реквизиты КАК РеквизитыОбъектаБД
		|ГДЕ
		|	РеквизитыОбъектаБД.Отображать
		|	И РеквизитыОбъектаБД.Ссылка = &ОписаниеОбъектаБД";
		
		Запрос.УстановитьПараметр("ОписаниеОбъектаБД",ОписаниеОбъектаБД);
		СтрокаРеквизитов=СтрСоединить(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя"),",");
		
	КонецЕсли;
		
	ТипЗначения=РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьНаименованиеСсылочногоТипаБД(Неопределено,ТипМетаДанных)+"Ссылка."+СправочникБД;
	
	ИспользованиеРеквизита 	= XMLString(Параметры.ИспользованиеРеквизита);

	ЗакрыватьПриВыборе=НЕ НеЗакрыватьПриВыборе;
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("Использование77",			Параметры.Использование77);
	СтруктураПараметров.Вставить("КодНеИспользуется",		Параметры.КодНеИспользуется);
	СтруктураПараметров.Вставить("Наименование",			Параметры.Наименование);
	СтруктураПараметров.Вставить("НаименованиеСправочника",	Параметры.НаименованиеСправочника);
	СтруктураПараметров.Вставить("ТипБД",					Параметры.ТипБД);
	СтруктураПараметров.Вставить("ТипМетаДанных",			ТипМетаДанных);
	СтруктураПараметров.Вставить("СправочникБД",			СправочникБД);
	СтруктураПараметров.Вставить("СтрокаРеквизитов",		СтрокаРеквизитов);
	СтруктураПараметров.Вставить("ВнешняяИнформационнаяБаза",Параметры.ВнешняяИнформационнаяБаза);
	
	
	
	Если ПустаяСтрока(Параметры.АдресДереваОбъектов) Тогда
		
		Использование77=Параметры.Использование77;
		ИспользуемаяИБ=Параметры.ВнешняяИнформационнаяБаза;				
		СправочникБД=Параметры.СправочникБД;
		
		Если ТипМетаДанных = "Catalogs" 
			ИЛИ ТипМетаДанных="Documents" 
			ИЛИ ТипМетаДанных="ChartsOfCharacteristicTypes" 
			ИЛИ ТипМетаДанных="ChartsOfAccounts" Тогда
			
			ДанныеСправочника = РасширениеИнтеграцииУХ.ЗаполнитьДеревоЗначенийДляСправочникаВИБ(СтруктураПараметров);
			
		ИначеЕсли ТипМетаДанных = "Enums" Тогда
			
			ДанныеСправочника = РасширениеИнтеграцииУХ.ЗаполнитьДеревоЗначенийДляПеречисленияВИБ(СтруктураПараметров);
			
		КонецЕсли;
		
		ДеревоЗначений=ДанныеСправочника.ДеревоЗначений;
		КодНеИспользуется=ДанныеСправочника.КодНеИспользуется;
		
	Иначе
		
		ДеревоЗначений=ПолучитьИзВременногоХранилища(Параметры.АдресДереваОбъектов);
		КодНеИспользуется=Параметры.КодНеИспользуется;
		
	КонецЕсли;
	
	ТекущаяСсылка=Параметры.ТекущаяСсылка;
	
	Заголовок=ТипМетаДанных+": "+СправочникБД+", "+ ИспользуемаяИБ;
	
	РеквизитыКДобавлению=Новый Массив;
	РеквизитыКУдалению=Новый Массив;
	
	МассивПредопределенных=Новый Массив;
	МассивПредопределенных.Добавить("Код");
	МассивПредопределенных.Добавить("Наименование");
	МассивПредопределенных.Добавить("ЭтоГруппа");
	МассивПредопределенных.Добавить("ПометкаУдаления");
	МассивПредопределенных.Добавить("СостояниеОбъекта");
	МассивПредопределенных.Добавить("Ссылка");

	Для Каждого Колонка ИЗ ДеревоЗначений.Колонки Цикл
		
		Если НЕ МассивПредопределенных.Найти(Колонка.Имя)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		РеквизитыКДобавлению.Добавить(Новый РеквизитФормы(Колонка.Имя,
		ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255),
		"ТабличноеПолеЗначенияВИБ",
		Колонка.Имя,
		Ложь));
		
	КонецЦикла;
	
	ИзменитьРеквизиты(РеквизитыКДобавлению,РеквизитыКУдалению);
	
	Для Каждого Колонка ИЗ ДеревоЗначений.Колонки Цикл
		
		Если НЕ МассивПредопределенных.Найти(Колонка.Имя)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЭтаФорма.Элементы.Добавить(Колонка.Имя,Тип("ПолеФормы"),ЭтаФорма.Элементы.ТабличноеПолеЗначенияВИБ);	
		
		ЭтаФорма.Элементы[Колонка.Имя].ПутьКДанным		= "ТабличноеПолеЗначенияВИБ."+Колонка.Имя;
		ЭтаФорма.Элементы[Колонка.Имя].Вид				= ВидПоляФормы.ПолеВвода;
					
		ЭтаФорма.Элементы[Колонка.Имя].ОграничениеТипа	= ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(255);
		ЭтаФорма.Элементы[Колонка.Имя].ТолькоПросмотр=Истина;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ТабличноеПолеЗначенияВИБ");
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЭлемента(ДанныеДляВыбора)
	
	Если ДанныеДляВыбора.ЭтоГруппа Тогда
		
		Если ИспользованиеРеквизита="ДляЭлемента" Тогда 
			
			ПоказатьПредупреждение(,НСтр("ru = 'Выберите элемент, а не группу.'"));
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Если ИспользованиеРеквизита="ДляГруппы" Тогда 
			
			ПоказатьПредупреждение(,НСтр("ru = 'Выберите группу.'"));
			Возврат;
			
		КонецЕсли;
			
	КонецЕсли; 
	
	Если ДанныеДляВыбора.ПометкаУдаления Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыборОбъектаЗавершение", ЭтотОбъект, Новый Структура("ДанныеДляВыбора", ДанныеДляВыбора));
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Выбранный объект помечен на удаление. Продолжить?'"), РежимДиалогаВопрос.ДаНет, 0);
		
	Иначе
		
		ЗавершитьВыборОбъекта(ДанныеДляВыбора);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборОбъекта(ДанныеДляВыбора)
	
	ПолученноеЗначение = Новый СписокЗначений;	
	ПолученноеЗначение.Добавить(ДанныеДляВыбора.Код, ДанныеДляВыбора.Наименование, Истина);
	
	Если НеЗакрыватьПриВыборе Тогда
		
		Оповестить("ВыбранЭлементВИБ",ПолученноеЗначение);
		
	Иначе
		
		Закрыть(ПолученноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры // ЗавершитьВыборОбъекта() 

&НаКлиенте
Процедура ВыборОбъектаЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЗавершитьВыборОбъекта(Параметры.ДанныеДляВыбора);
		
	КонецЕсли;
		
КонецПроцедуры // ОбработатьВыборЭлемента() 

&НаКлиенте
Процедура ВыбратьЭлемент(Команда)
	
	ДанныеДляВыбора=Элементы.ТабличноеПолеЗначенияВИБ.ТекущиеДанные;
	
	Если НЕ ДанныеДляВыбора=Неопределено Тогда
		
		ОбработатьВыборЭлемента(ДанныеДляВыбора);
					
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеЗначенияВИБВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДанныеДляВыбора=Элементы.ТабличноеПолеЗначенияВИБ.ТекущиеДанные;
	
	Если НЕ ДанныеДляВыбора=Неопределено Тогда
		
		ОбработатьВыборЭлемента(ДанныеДляВыбора);
					
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МассивНайденных=Новый Массив;
	
	Если ЗначениеЗаполнено(ТекущаяСсылка) Тогда
				
		МассивНайденных=УниверсальныеМеханизмыКлиентУХ.ДеревоФормыНайтиСтроки(ТабличноеПолеЗначенияВИБ,Новый Структура("Ссылка",ТекущаяСсылка));
		
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
				
		МассивНайденных=УниверсальныеМеханизмыКлиентУХ.ДеревоФормыНайтиСтроки(ТабличноеПолеЗначенияВИБ,Новый Структура("Наименование",Наименование));
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если МассивНайденных.Количество()>0 Тогда
		
		Элементы.ТабличноеПолеЗначенияВИБ.ТекущаяСтрока=МассивНайденных[0].ПолучитьИдентификатор();
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъект(Команда)
	
	СтрокаGUID=Элементы.ТабличноеПолеЗначенияВИБ.ТекущиеДанные.Ссылка;
	
	Если ПустаяСтрока(СтрокаGUID) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеОбъекта=ПолучитьДанныеОбъектаВИБ(СтрокаGUID);	
	
	Имя = "ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
	ОткрытьФорму(Имя, Новый Структура("Расшифровка, ИспользуемаяИБ", ДанныеОбъекта, ИспользуемаяИБ));
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеОбъектаВИБ(СтрокаGUID)
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("Значение",СтрокаGUID);
	ДанныеОбъекта.Вставить("ТипЗначения",ТипЗначения);

	Возврат ДанныеОбъекта;
			
КонецФункции // ПолучитьДанныеОбъектаВИБ()


