
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	ТекстСообщения      = "";	
	ПодробнаяИнформация = "";
	
	Если ПроверитьПодключениеНаСервере(ПараметрКоманды, ПодробнаяИнформация)Тогда 
		ТекстСообщения = "Проверка прошла успешно!" + Символы.ПС;
	Иначе 
		ТекстСообщения = "Проверка завершилась ошибкой:" + Символы.ПС;
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + ПодробнаяИнформация;
	
	ПоказатьПредупреждение(,ТекстСообщения, 30, "Проверка подключения к ""MS Service Bus""");

КонецПроцедуры

