
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьЗаголовкиЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособАутентификацииПриИзменении(Элемент)
	
	УстановитьЗаголовкиЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьЗаголовкиЭлементовФормы()
	
	Если Объект.СпособАутентификации = ПредопределенноеЗначение("Перечисление.тн_СпособАутентификацииSB.ACS") Тогда 
		Элементы.ЛогинSB.Заголовок    = "Логин пользователя SB";
		Элементы.ПарольSB.Заголовок   = "Пароль пользователя SB";		
	ИначеЕсли Объект.СпособАутентификации = ПредопределенноеЗначение("Перечисление.тн_СпособАутентификацииSB.SAS") Тогда  
		Элементы.ЛогинSB.Заголовок    = "Shared Access Key Name";
		Элементы.ПарольSB.Заголовок   = "Shared Access Key";		
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти

