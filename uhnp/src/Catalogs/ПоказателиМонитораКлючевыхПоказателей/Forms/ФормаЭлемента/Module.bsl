&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокВыбораТипаИсточника.Добавить(ОбщегоНазначенияУХ.ПолучитьОписаниеТиповЧисла(18, 5), "Число");
	СписокВыбораТипаИсточника.Добавить(Новый ОписаниеТипов("СправочникСсылка.ИсточникиДанныхДляРасчетов"), Нстр("ru = 'Источник данных'"));
	СтрокаЛоготип = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "Логотип");
	
	ПроцентДостиженияЦелиОтображение = НЕ Объект.ОтображатьПроцентДостиженияЦелиВместоПроцентаОтклонения;
	
	УправлениеФормой();
	
КонецПроцедуры


&НаСервере
Процедура  УправлениеФормой()
	
	//Если Объект.ИспользоватьКоридорЗначений Тогда
	//	Элементы.ГруппаГраницыЗначений.Видимость = Истина;
	//	Элементы.ТрактованиеПоложительногоОтклонения.Видимость = Ложь;
	//Иначе
	//	Элементы.ГруппаГраницыЗначений.Видимость = Ложь;
	//	Элементы.ТрактованиеПоложительногоОтклонения.Видимость = Истина;
	//КонецЕсли;
	
	Элементы.ИсточникЗначенияТекущегоПериода.Видимость 				= Объект.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка;
	Элементы.ГруппаИсточникЗначенияТекущегоПериодаПоказатель.Видимость 	= НЕ Объект.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка;
	
	Элементы.ИсточникЗначенияПериодаСравнения.Видимость 			= Объект.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка;
	Элементы.ГруппаИсточникЗначенияПериодаСравненияПоказатель.Видимость 	= НЕ Объект.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка;
	
	Элементы.ИсточникПлановогоЗначения.Видимость 					= Объект.ИсточникПлановогоЗначенияРасширеннаяНастройка;
	Элементы.ГруппаИсточникПлановогоЗначенияПоказатель.Видимость 	= НЕ Объект.ИсточникПлановогоЗначенияРасширеннаяНастройка;
	
	Если ЗначениеЗаполнено(Объект.ИсточникЗначенияТекущегоПериодаПоказательОтбор) Тогда
		Элементы.ИсточникЗначенияТекущегоПериодаПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрАктивен;
	Иначе	
		Элементы.ИсточникЗначенияТекущегоПериодаПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрНеАктивен;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ИсточникЗначенияПериодаСравненияПоказательОтбор) Тогда
		Элементы.ИсточникЗначенияПериодаСравненияПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрАктивен;
	Иначе	
		Элементы.ИсточникЗначенияПериодаСравненияПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрНеАктивен;
	КонецЕсли;	

	Если ЗначениеЗаполнено(Объект.ИсточникПлановогоЗначенияПоказательОтбор) Тогда
		Элементы.ИсточникПлановогоЗначенияПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрАктивен;
	Иначе	
		Элементы.ИсточникПлановогоЗначенияПоказательПоказатьОтборы.Картинка = БиблиотекаКартинок.СводнаяТаблицаФильтрНеАктивен;
	КонецЕсли;	

	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеФлага(ИмяФлага)
	
	ИдСтроки = Элементы.ИсточникиДанныхДляРасчета.ТекущиеДанные.НомерСтроки;
	
	Если Элементы.ИсточникиДанныхДляРасчета.ТекущиеДанные[ИмяФлага] Тогда
		НайденныеСтроки = Объект.ИсточникиДанныхДляРасчета.НайтиСтроки(Новый Структура(ИмяФлага, Истина));
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			
			Если ТекСтрока.НомерСтроки <> ИдСтроки Тогда
				ТекСтрока[ИмяФлага] = Ложь;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


