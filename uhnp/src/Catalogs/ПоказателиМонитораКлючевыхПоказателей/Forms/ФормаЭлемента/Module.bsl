&НаСервере
Функция ПодготовитьТаблицуОтборовПоказателей(Показатели,РасшифровкаОтборовСтрока = "") Экспорт
	
	ОбъектАБ = Обработки.АналитическийБланк.Создать();
	ТЗРасшифровкаОтборов = ОбъектАБ.РасшифровкаГруппОтборов.Выгрузить();
	ТЗРасшифровкаОтборовГруппРаскрытия = ТЗРасшифровкаОтборов.СкопироватьКолонки();
	
	СтруктураЗначенийПоказателей = Новый Структура;
	
	Для Каждого СтрПоказатель Из Показатели Цикл 
		СтруктураЗначенийПоказателей.Вставить(СокрЛП(СтрПоказатель.Код),СтрПоказатель);
	КонецЦикла;
	
	Обработки.АналитическийБланк.ЗполнитьПервоначальныйКэшОтборов(ТЗРасшифровкаОтборов,"");	

	АналитическийБланкГенерацияМакетаУХСервер.ДополнитьОтборыАналитикамиРаскрытия(СтруктураЗначенийПоказателей,ТЗРасшифровкаОтборов);
	
	Если НЕ РасшифровкаОтборовСтрока = "" Тогда
		СтруктураРасшифровки = ЗначениеИзСтрокиВнутр(РасшифровкаОтборовСтрока);
		Если СтруктураРасшифровки.Свойство("РасшифровкаГруппОтборов") Тогда
			
			Для Каждого СтрОтбор Из СтруктураРасшифровки.РасшифровкаГруппОтборов Цикл		 
				
				НстрОтборов =  ТЗРасшифровкаОтборов.НайтиСтроки(Новый Структура("ПолеКод",СтрОтбор.Ключ));
				
				Если НстрОтборов.Количество() = 1 Тогда
					СтрОтборСвойства = АналитическийБланкГенерацияМакетаУХСервер.ПрочитатьСтрокуОтборов(СтрОтбор);
					ЗаполнитьЗначенияСвойств(НстрОтборов[0],СтрОтборСвойства);	 				
					НстрОтборов[0].Отбор = ?(ЗначениеЗаполнено(СтрОтборСвойства.Отбор),ЗначениеИзСтрокиВнутр(СтрОтборСвойства.Отбор),Неопределено);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;	 
		
		Если СтруктураРасшифровки.Свойство("РасшифровкаОтборов") Тогда
			ОтображатьСуммуВДопВалюте = СтруктураРасшифровки.ОтображатьСуммуВДопВалюте;
		Иначе	
			ОтображатьСуммуВДопВалюте = Ложь;
		КонецЕсли;
			
	КонецЕсли;
	

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТЗРасшифровкаОтборов",ПоместитьВоВременноеХранилище(ТЗРасшифровкаОтборов,Новый УникальныйИдентификатор()));
    СтруктураВозврата.Вставить("ТЗРасшифровкаОтборовГруппРаскрытия",ПоместитьВоВременноеХранилище(ТЗРасшифровкаОтборовГруппРаскрытия,Новый УникальныйИдентификатор()));
	СтруктураВозврата.Вставить("ОтображатьСуммуВДопВалюте",ОтображатьСуммуВДопВалюте);
	
	Возврат СтруктураВозврата;
		
КонецФункции	

&НаСервере
Функция ЗаписатьОтборСервер(АдресРезультатаРедактирования)
	
	Если ТипЗнч(АдресРезультатаРедактирования) = Тип("ТаблицаЗначений") Тогда
		РасшифровкаОтборов   		=	АдресРезультатаРедактирования;
		ОтображатьСуммуВДопВалюте   =   Ложь;
	Иначе
		РасшифровкаОтборов   =  ПолучитьИзВременногоХранилища(АдресРезультатаРедактирования.ОтборыГруппы);
		ОтображатьСуммуВДопВалюте = АдресРезультатаРедактирования.ОтображатьСуммуВДопВалюте;
	КонецЕсли;	
	
	РасшифровкаГруппОтборов = Новый Структура;
	//Формируем таблицу отборов для ячейки - сохраняем тлько отборы отличные от дефолтных...
	Для Каждого тОтбор Из РасшифровкаОтборов Цикл		
		Если НЕ (АналитическийБланкГенерацияМакетаУХСервер.ПроверитьЭтоСтандартныйОтбор(тОтбор)) И тОтбор.Использовать  Тогда
			АналитическийБланкГенерацияМакетаУХСервер.СформироватьСтрокуОтбора(РасшифровкаГруппОтборов,тОтбор);	
		КонецЕсли;				
	КонецЦикла;	

	Если РасшифровкаГруппОтборов.Количество() = 0 И НЕ ОтображатьСуммуВДопВалюте Тогда
		ПредставлениеОтбора = Нстр("ru = 'Нет'");
		Возврат "";	
	Иначе	
		СтрукутраОтвета = Новый Структура;
		СтрукутраОтвета.Вставить("ОтображатьСуммуВДопВалюте",ОтображатьСуммуВДопВалюте);
		СтрукутраОтвета.Вставить("РасшифровкаГруппОтборов",РасшифровкаГруппОтборов);
		СтрукутраОтвета.Вставить("ПредставлениеОтбора",ПредставлениеОтбора);
				
		Возврат ЗначениеВстрокуВнутр(СтрукутраОтвета);
		
	КонецЕсли;	
		
КонецФункции	



