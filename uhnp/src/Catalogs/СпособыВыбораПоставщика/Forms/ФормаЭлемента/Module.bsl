
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформлениеФормы();
	УстановитьЗаголовокФормы();
	УстановитьПараметрыДоступности();
КонецПроцедуры


#Область ОбработчикиОформления
&НаСервере 
Процедура УстановитьУсловноеОформлениеФормы()
	УстновитьДоступностьЭлементыФормы();	 
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ТиповойСпособ = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстновитьДоступностьЭлементыФормы()
	
	Если НЕ Объект.ТиповойСпособ Тогда
		Элементы.Конкурентный.Доступность = Истина;  
		Элементы.СпособыВыбораПоставщика.Доступность = Истина;  
		Элементы.МСП.Доступность = Истина;
		Элементы.МСПСубПодряд.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ОчиститьНастройкиПоНетиповымСпособам()

	Если НЕ Объект.ТиповойСпособ Тогда
		Объект.СпособыВыбораПоставщика = Перечисления.СпособыВыбораПоставщика.ПустаяСсылка();
		Объект.МСП = Ложь;
		Объект.МСПСубПодряд = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	Заголовок_ = СокрЛП(Объект.Наименование);
	Если ПустаяСтрока(Заголовок_) Тогда
		Заголовок_ = НСтр("ru = 'новый'");
	КонецЕсли;      
	Заголовок_ = Заголовок_;
	ЭтаФорма.Заголовок = Заголовок_;
КонецПроцедуры

&НаСервере
Процедура СпособыВыбораПоставщикаПриИзмененииНаСервере()
	Если Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Редукцион")
		Тогда
		Объект.МСП = Ложь;
		Объект.Конкурентный = Истина;
		Объект.ЭлектроннаяФорма = Ложь;
	ИначеЕсли Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложений")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Конкурс")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Аукцион")
		Тогда
		Объект.МСП = Ложь;
		Объект.Конкурентный = Истина;
		Объект.ЭлектроннаяФорма = Истина;
	ИначеЕсли Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложенийУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросКотировокУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.КонкурсУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.АукционУМсп")
		Тогда
		Объект.МСП = Истина;
		Объект.МСПСубПодряд = Истина;
		Объект.Конкурентный = Истина;
		Объект.ЭлектроннаяФорма = Истина;
	КонецЕсли;
	Объект.Наименование = Объект.СпособыВыбораПоставщика;
	Объект.НаименованиеЕИС = Объект.СпособыВыбораПоставщика;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДоступности()
	Если Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Редукцион")
		Тогда
		Элементы.МСП.Доступность = Ложь;
		Элементы.Конкурентный.Доступность = Ложь;
	ИначеЕсли Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложений")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Конкурс")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.Аукцион")
		Тогда
		Элементы.МСП.Доступность = Ложь;
		Элементы.Конкурентный.Доступность = Ложь;
	ИначеЕсли Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросПредложенийУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.ЗапросКотировокУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.КонкурсУМсп")
		ИЛИ Объект.СпособыВыбораПоставщика = ПредопределенноеЗначение("Перечисление.СпособыВыбораПоставщика.АукционУМсп")
		Тогда
		Элементы.МСП.Доступность = Ложь;
		Элементы.МСПСубПодряд.Доступность = Ложь;
		Элементы.Конкурентный.Доступность = Ложь;
	Иначе
		Элементы.МСП.Доступность = Истина;
		Элементы.МСПСубПодряд.Доступность = Истина;
		Элементы.Конкурентный.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпособыВыбораПоставщикаПриИзменении(Элемент)
	СпособыВыбораПоставщикаПриИзмененииНаСервере();
	УстановитьПараметрыДоступности();
КонецПроцедуры

&НаКлиенте
Процедура ТиповойСпособПриИзменении(Элемент)
	УстновитьДоступностьЭлементыФормы();
КонецПроцедуры

#КонецОбласти
