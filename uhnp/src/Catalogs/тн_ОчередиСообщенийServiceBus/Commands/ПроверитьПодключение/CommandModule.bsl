
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	ПодробнаяИнформация = "";
	
	Успех = ПроверитьПодключениеНаСервере(ПараметрКоманды, ПодробнаяИнформация);
	
	Если Успех Тогда 
		ТекстСообщения = "Проверка прошла успешно!" + Символы.ПС;
	Иначе 
		ТекстСообщения = "Проверка завершилась ошибкой:" + Символы.ПС;
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + ПодробнаяИнформация;
	
	ПоказатьПредупреждение(,ТекстСообщения, 30, "Проверка подключения к ""MS Service Bus""");
	
КонецПроцедуры

