&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаголовокРазрешенныхОрганизацийПоУмолчанию = Элементы.РазрешенныеОрганизации.Заголовок; 
	
КонецПроцедуры //ПриСозданииНаСервере()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#КонецОбласти 

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#Область ОбработчикиСобытийЭлементовТаблицыЗапретыНаЗагрузку

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
//
&НаКлиенте
Процедура ЗапретыНаЗагрузкуПриАктивизацииСтроки(Элемент)
    
    ВыделенныеСтроки = Элементы.ЗапретыНаЗагрузку.ВыделенныеСтроки;
    ТекущиеДанныеЗапрета = Элементы.ЗапретыНаЗагрузку.ТекущиеДанные;   

	Если ВыделенныеСтроки.Количество() <> 1 
		ИЛИ ТекущиеДанныеЗапрета = Неопределено Тогда
		Элементы.РазрешенныеОрганизации.ОтборСтрок = Неопределено;
		Элементы.РазрешенныеОрганизации.Заголовок = ЗаголовокРазрешенныхОрганизацийПоУмолчанию;
        Возврат;
    КонецЕсли;
	
	УстановитьОтборПоВидуСообщения(ТекущиеДанныеЗапрета);
    
КонецПроцедуры //ЗапретыНаЗагрузкуПриАктивизацииСтроки()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
//
&НаКлиенте
Процедура ЗапретыНаЗагрузкуПередУдалением(Элемент, Отказ) 
	
	УдаляемаяСтрока = Элемент.ТекущиеДанные;
    Если УдаляемаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ВидСообщенияДляУдаления = УдаляемаяСтрока.ВидСообщения;
    
    ПараметрыПоиска = Новый Структура("ВидСообщения", ВидСообщенияДляУдаления);
    НайденныеСтроки = Объект.РазрешенныеОрганизации.НайтиСтроки(ПараметрыПоиска);
    
    Для Каждого СтрокаКУдалению Из НайденныеСтроки Цикл
        Объект.РазрешенныеОрганизации.Удалить(СтрокаКУдалению);
	КонецЦикла; 
	
КонецПроцедуры  //ЗапретыНаЗагрузкуПередУдалением()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#КонецОбласти

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#Область ОбработчикиСобытийЭлементовТаблицыРазрешенныеОрганизации 

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
//
&НаКлиенте
Процедура РазрешенныеОрганизацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
        Возврат;
    КонецЕсли;
    
    ТекущаяСтрокаЗапрета = Элементы.ЗапретыНаЗагрузку.ТекущиеДанные;
    
    Если ТекущаяСтрокаЗапрета = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Элемент.ТекущиеДанные.ВидСообщения = ТекущаяСтрокаЗапрета.ВидСообщения; 
	УстановитьОтборПоВидуСообщения(ТекущаяСтрокаЗапрета);
	
КонецПроцедуры //РазрешенныеОрганизацииПриНачалеРедактирования()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#КонецОбласти

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
//
Процедура УстановитьОтборПоВидуСообщения(ТекущиеДанныеЗапрета)
	
	ЗначениеОтбора = ТекущиеДанныеЗапрета.ВидСообщения;
	Элементы.РазрешенныеОрганизации.ОтборСтрок = Новый ФиксированнаяСтруктура("ВидСообщения", ЗначениеОтбора);
	Элементы.РазрешенныеОрганизации.Заголовок = ЗаголовокРазрешенныхОрганизацийПоУмолчанию + " по виду сообщения """ + ЗначениеОтбора + """";

КонецПроцедуры //УстановитьОтборПоВидуСообщения()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#КонецОбласти
