//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
//
Процедура ДобавитьЗапретЗагрузкиСтатьиРасходовСтатьиДоходовСтруктураПредприятия(Параметры = Неопределено) Экспорт
	
	// базы Каркас - catalogExpendItem 
	// базы Каркас - catalogIncomItem
	// базы Каркас – catalogDepartment – со списком разрешенных организаций
	
	СписокИдентификаторовБазКаркас = Новый Массив;
	СписокИдентификаторовБазКаркас.Добавить("1cd9edb0-b78b-11db-8995-000423d38bac"); //Лоджикруф
	СписокИдентификаторовБазКаркас.Добавить("f77dc96b-0a59-11db-951b-0004617b078b"); //НН
	СписокИдентификаторовБазКаркас.Добавить("977cee8a-94d2-11db-872a-000423d38bac"); //ПП Минеральные воды
	СписокИдентификаторовБазКаркас.Добавить("ee0a3d7c-6dc4-11ee-b836-0050568c1cc8"); //ПП Н.Новгород ПЭТ
	СписокИдентификаторовБазКаркас.Добавить("3bd7f0b2-1b67-11ec-b812-0050568c1cc8"); //ПП Ревда
	СписокИдентификаторовБазКаркас.Добавить("a7220a05-61c3-11ee-b836-0050568c1cc8"); //ПП Серпухов
	СписокИдентификаторовБазКаркас.Добавить("d49cb47a-0739-11e2-b27d-00505601010b"); //Северо-Запад
	СписокИдентификаторовБазКаркас.Добавить("f88bd991-0280-11db-9511-0004617b078b"); //Учалы
	СписокИдентификаторовБазКаркас.Добавить("3569580f-9811-11dc-b959-003048785fc1"); //Хабаровск
	СписокИдентификаторовБазКаркас.Добавить("0391ac35-d169-11db-8b26-000423d38bac"); //Юрга Плекс
	
	//ПП Рязань Лоджикруф
	ГТИ_ИНН = "6229100503";
	ГТИ_КПП = "623001001";
	Лоджикруф_ИНН = "6230054971"; 
	Лоджикруф_КПП = "623001001";
	Техноплекс_ИНН = "6230043899";
	Техноплекс_КПП = "623001001"; 
	
	//ПП Учалы
	ЛоджикруфУчалы_ИНН = "0270408129"; 
	ЛоджикруфУчалы_КПП = "027001001";
	ТехноплексУчалы_ИНН = "6230043899";
	ТехноплексУчалы_КПП = "027043001"; 
	
	//ПП Серпухов 
	Серпухов_ИНН = "6230043899";
	Серпухов_КПП = "504343001";
	
	//ПП Ревда 
	Ревда_ИНН = "6230043899";
	Ревда_КПП = "668443001";
	
	//ПП Северо-Запад
	Пушкин_ИНН = "6230043899";
	Пушкин_КПП = "471643001";
	
	//ПП Хабаровск 
	Хабаровск_ИНН = "6230043899";
	Хабаровск_КПП = "272343001";
	
	//ПП Юрга 
	Юрга_ИНН = "6230043899";
	Юрга_КПП = "423043001";
	
	//ПП Минеральные Воды
	МинВоды_ИНН = "6230043899";
	МинВоды_КПП = "263043001";
	
	ИНН = Новый Массив;
	ИНН.Добавить(ГТИ_ИНН);
	ИНН.Добавить(Лоджикруф_ИНН);
	ИНН.Добавить(Техноплекс_ИНН);
	ИНН.Добавить(ЛоджикруфУчалы_ИНН);
	ИНН.Добавить(ТехноплексУчалы_ИНН);
	ИНН.Добавить(Серпухов_ИНН);
	ИНН.Добавить(Ревда_ИНН);
	ИНН.Добавить(Пушкин_ИНН);
	ИНН.Добавить(Хабаровск_ИНН);
	ИНН.Добавить(Юрга_ИНН);
	ИНН.Добавить(МинВоды_ИНН);
	
	КПП = Новый Массив;
	КПП.Добавить(ГТИ_КПП);
	КПП.Добавить(Лоджикруф_КПП);
	КПП.Добавить(Техноплекс_КПП);
	КПП.Добавить(ЛоджикруфУчалы_КПП);
	КПП.Добавить(ТехноплексУчалы_КПП);
	КПП.Добавить(Серпухов_КПП);
	КПП.Добавить(Ревда_КПП);
	КПП.Добавить(Пушкин_КПП);
	КПП.Добавить(Хабаровск_КПП);
	КПП.Добавить(Юрга_КПП);
	КПП.Добавить(МинВоды_КПП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ИДБазРеспондентов.Ссылка КАК Ссылка,
		|	тн_ИДБазРеспондентов.systemSender КАК systemSender
		|ПОМЕСТИТЬ ВТ_СписокБазКаркас
		|ИЗ
		|	Справочник.тн_ИДБазРеспондентов КАК тн_ИДБазРеспондентов
		|ГДЕ
		|	тн_ИДБазРеспондентов.systemSender В(&СписокИдентификаторовБазКаркас)
		|	И НЕ тн_ИДБазРеспондентов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Организации.Ссылка КАК Организация,
		|	ВЫБОР
		|		КОГДА Организации.ИНН = &ГТИ_ИНН
		|				И Организации.КПП = &ГТИ_КПП
		|			ТОГДА ""1cd9edb0-b78b-11db-8995-000423d38bac""
		|		КОГДА Организации.ИНН = &Лоджикруф_ИНН
		|				И Организации.КПП = &Лоджикруф_КПП
		|			ТОГДА ""1cd9edb0-b78b-11db-8995-000423d38bac""
		|		КОГДА Организации.ИНН = &Техноплекс_ИНН
		|				И Организации.КПП = &Техноплекс_КПП
		|			ТОГДА ""1cd9edb0-b78b-11db-8995-000423d38bac""
		|		КОГДА Организации.ИНН = &ТехноплексУчалы_ИНН
		|				И Организации.КПП = &ТехноплексУчалы_КПП
		|			ТОГДА ""f88bd991-0280-11db-9511-0004617b078b""
		|		КОГДА Организации.ИНН = &ЛоджикруфУчалы_ИНН
		|				И Организации.КПП = &ЛоджикруфУчалы_КПП
		|			ТОГДА ""f88bd991-0280-11db-9511-0004617b078b""
		|		КОГДА Организации.ИНН = &Серпухов_ИНН
		|				И Организации.КПП = &Серпухов_КПП
		|			ТОГДА ""a7220a05-61c3-11ee-b836-0050568c1cc8""
		|		КОГДА Организации.ИНН = &Ревда_ИНН
		|				И Организации.КПП = &Ревда_КПП
		|			ТОГДА ""3bd7f0b2-1b67-11ec-b812-0050568c1cc8""
		|		КОГДА Организации.ИНН = &Пушкин_ИНН
		|				И Организации.КПП = &Пушкин_КПП
		|			ТОГДА ""d49cb47a-0739-11e2-b27d-00505601010b""
		|		КОГДА Организации.ИНН = &Хабаровск_ИНН
		|				И Организации.КПП = &Хабаровск_КПП
		|			ТОГДА ""3569580f-9811-11dc-b959-003048785fc1""
		|		КОГДА Организации.ИНН = &Юрга_ИНН
		|				И Организации.КПП = &Юрга_КПП
		|			ТОГДА ""0391ac35-d169-11db-8b26-000423d38bac""
		|		КОГДА Организации.ИНН = &МинВоды_ИНН
		|				И Организации.КПП = &МинВоды_КПП
		|			ТОГДА ""977cee8a-94d2-11db-872a-000423d38bac""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК УИДБазы
		|ПОМЕСТИТЬ ВТ_СписокРазрешенныхОрганизаций
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ИНН В(&ИНН)
		|	И Организации.КПП В(&КПП)
		|	И Организации.ИспользоватьВРегламентированномУчете
		|	И НЕ Организации.ОбособленноеПодразделение
		|	И НЕ Организации.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписокБазКаркас.Ссылка КАК База,
		|	ЕСТЬNULL(ВТ_СписокРазрешенныхОрганизаций.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация
		|ИЗ
		|	ВТ_СписокБазКаркас КАК ВТ_СписокБазКаркас
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СписокРазрешенныхОрганизаций КАК ВТ_СписокРазрешенныхОрганизаций
		|		ПО ВТ_СписокБазКаркас.systemSender = ВТ_СписокРазрешенныхОрганизаций.УИДБазы
		|ИТОГИ
		|	МАКСИМУМ(Организация)
		|ПО
		|	База";
	
	Запрос.УстановитьПараметр("СписокИдентификаторовБазКаркас", СписокИдентификаторовБазКаркас);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Запрос.УстановитьПараметр("ГТИ_ИНН", ГТИ_ИНН);
	Запрос.УстановитьПараметр("ГТИ_КПП", ГТИ_КПП);
	Запрос.УстановитьПараметр("Лоджикруф_ИНН", Лоджикруф_ИНН);
	Запрос.УстановитьПараметр("Лоджикруф_КПП", Лоджикруф_КПП);
	Запрос.УстановитьПараметр("Техноплекс_ИНН", Техноплекс_ИНН);
	Запрос.УстановитьПараметр("Техноплекс_КПП", Техноплекс_КПП);
	
	Запрос.УстановитьПараметр("ЛоджикруфУчалы_ИНН", ЛоджикруфУчалы_ИНН);
	Запрос.УстановитьПараметр("ЛоджикруфУчалы_КПП", ЛоджикруфУчалы_КПП);
	Запрос.УстановитьПараметр("ТехноплексУчалы_ИНН", ТехноплексУчалы_ИНН);
	Запрос.УстановитьПараметр("ТехноплексУчалы_КПП", ТехноплексУчалы_КПП);
	
	Запрос.УстановитьПараметр("Серпухов_ИНН", Серпухов_ИНН);
	Запрос.УстановитьПараметр("Серпухов_КПП", Серпухов_КПП);
	
	Запрос.УстановитьПараметр("Ревда_ИНН", Ревда_ИНН);
	Запрос.УстановитьПараметр("Ревда_КПП", Ревда_КПП); 
	
	Запрос.УстановитьПараметр("Пушкин_ИНН", Пушкин_ИНН);
	Запрос.УстановитьПараметр("Пушкин_КПП", Пушкин_КПП);
	
	Запрос.УстановитьПараметр("Хабаровск_ИНН", Хабаровск_ИНН);
	Запрос.УстановитьПараметр("Хабаровск_КПП", Хабаровск_КПП); 
	
	Запрос.УстановитьПараметр("Юрга_ИНН", Юрга_ИНН);
	Запрос.УстановитьПараметр("Юрга_КПП", Юрга_КПП); 
	
	Запрос.УстановитьПараметр("МинВоды_ИНН", МинВоды_ИНН);
	Запрос.УстановитьПараметр("МинВоды_КПП", МинВоды_КПП);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаБаза = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаБаза.Следующий() Цикл
		
		Попытка  
			
			БазаОбъект = ВыборкаБаза.База.ПолучитьОбъект();
			НоваяСтрока = БазаОбъект.ЗапретыНаЗагрузку.Добавить();
			НоваяСтрока.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogExpendItem;
			НоваяСтрока = БазаОбъект.ЗапретыНаЗагрузку.Добавить();
			НоваяСтрока.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogIncomItem;
			НоваяСтрока = БазаОбъект.ЗапретыНаЗагрузку.Добавить();
			НоваяСтрока.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogDepartment;
			
			Если ЗначениеЗаполнено(ВыборкаБаза.Организация) Тогда
			
				Выборка = ВыборкаБаза.Выбрать();
				Пока Выборка.Следующий() Цикл
					НоваяСтрокаПоОрганизации = БазаОбъект.РазрешенныеОрганизации.Добавить(); 
					НоваяСтрокаПоОрганизации.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogDepartment;
					НоваяСтрокаПоОрганизации.Организация = Выборка.Организация;
				КонецЦикла;
		
			КонецЕсли;
			
			БазаОбъект.ОбменДанными.Загрузка = Истина;
			БазаОбъект.Записать(); 
			
		Исключение 
			
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.тн_ИДБазРеспондентов,,
				"Ошибка при выполнении обработчика обновления Справочники.тн_ИДБазРеспондентов.ДобавитьЗапретЗагрузкиСтатьиРасходовСтатьиДоходовСтруктураПредприятия: " 
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
				
		КонецПопытки;
		
	КонецЦикла;
	
	// база ОКС - catalogRulesAllocatingExpenses
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ИДБазРеспондентов.Ссылка КАК База
		|ИЗ
		|	Справочник.тн_ИДБазРеспондентов КАК тн_ИДБазРеспондентов
		|ГДЕ
		|	тн_ИДБазРеспондентов.systemSender = ""b115b326-5811-11dd-ae0d-000423d38bac""
		|	И НЕ тн_ИДБазРеспондентов.ПометкаУдаления";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Попытка  
			
			БазаОбъект = Выборка.База.ПолучитьОбъект();
			НоваяСтрока = БазаОбъект.ЗапретыНаЗагрузку.Добавить();
			НоваяСтрока.ВидСообщения = Перечисления.тн_ВидыСообщений_ERP_УХ.catalogRulesAllocatingExpenses;
			
			БазаОбъект.ОбменДанными.Загрузка = Истина;
			БазаОбъект.Записать(); 
			
		Исключение  
			
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.тн_ИДБазРеспондентов,,
				"Ошибка при выполнении обработчика обновления Справочники.тн_ИДБазРеспондентов.ДобавитьЗапретЗагрузкиСтатьиРасходовСтатьиДоходовСтруктураПредприятия: " 
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
				
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры //ДобавитьЗапретЗагрузкиСтатьиРасходовСтатьиДоходовСтруктураПредприятия()

//Сафиуллина З.Р. 25.09.2025 Выполнение задач №000055082
#КонецЕсли