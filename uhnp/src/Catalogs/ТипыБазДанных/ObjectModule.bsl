#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Перем СоздатьНастройкиСоответствияПоGUID;
Перем ОбновитьНастройкиПравилКонтроляНСИ;

Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		
		СоздатьНастройкиСоответствияПоGUID=ИспользуютсяПланыОбмена;
		
	Иначе
		
		СоздатьНастройкиСоответствияПоGUID= (ИспользуютсяПланыОбмена И (НЕ Ссылка.ИспользуютсяПланыОбмена));
		
	КонецЕсли;
	
	ОбновитьНастройкиПравилКонтроляНСИ= НЕ(КонтролироватьНСИ = Ссылка.КонтролироватьНСИ); 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если СоздатьНастройкиСоответствияПоGUID Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		             |	СправочникиБД.Ссылка КАК Ссылка
		             |ИЗ
		             |	Справочник.СправочникиБД КАК СправочникиБД
		             |ГДЕ
		             |	СправочникиБД.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец",Ссылка);
		Результат=Запрос.Выполнить();
		
		Если Не Результат.Пустой() Тогда
			
			Справочники.ТипыБазДанных.СоздатьНастройкиСоответствияПоGUID(Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновитьНастройкиПравилКонтроляНСИ Тогда
		
		МодульОбменаДаннымиНСИ=ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиНСИУХ");		
		МодульОбменаДаннымиНСИ.СоздатьНастройкиПравилКонтроляНСИ(Ссылка,,КонтролироватьНСИ);
		
	КонецЕсли;
				
КонецПроцедуры


#КонецЕсли