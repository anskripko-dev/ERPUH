#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда 
	
Процедура СоздатьНастройкиСоответствияПоGUID(ТипБД) Экспорт
		
	ТаблицаОбъектов=КэшируемыеПроцедурыУХ.ПолучитьПоддерживаемыеОбъектыУниверсальныйФормат();
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ТаблицаОбъектов.ТипОбъектаМетаданных КАК ТипОбъектаМетаданных,
	             |	ТаблицаОбъектов.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных
	             |ПОМЕСТИТЬ ТаблицаОбъектов
	             |ИЗ
	             |	&ТаблицаОбъектов КАК ТаблицаОбъектов
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК ОписаниеОбъектаБД,
	             |	""Справочник"" КАК ТипОбъектаМетаданных,
	             |	СправочникиБД.Наименование КАК ИмяОбъектаМетаданных
	             |ПОМЕСТИТЬ ОписанияОбъектовТек
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	НЕ СправочникиБД.ОтсутствуетВКонфигурации
	             |	И НЕ СправочникиБД.ПометкаУдаления
	             |	И СправочникиБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПланыВидовХарактеристикБД.Ссылка,
	             |	""ПланВидовХарактеристик"",
	             |	ПланыВидовХарактеристикБД.Наименование
	             |ИЗ
	             |	Справочник.ПланыВидовХарактеристикБД КАК ПланыВидовХарактеристикБД
	             |ГДЕ
	             |	НЕ ПланыВидовХарактеристикБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПланыВидовХарактеристикБД.ПометкаУдаления
	             |	И ПланыВидовХарактеристикБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПланыСчетовБД.Ссылка,
	             |	""ПланСчетов"",
	             |	ПланыСчетовБД.Наименование
	             |ИЗ
	             |	Справочник.ПланыСчетовБД КАК ПланыСчетовБД
	             |ГДЕ
	             |	НЕ ПланыСчетовБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПланыСчетовБД.ПометкаУдаления
	             |	И ПланыСчетовБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПеречисленияБД.Ссылка,
	             |	""Перечисление"",
	             |	ПеречисленияБД.Наименование
	             |ИЗ
	             |	Справочник.ПеречисленияБД КАК ПеречисленияБД
	             |ГДЕ
	             |	НЕ ПеречисленияБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПеречисленияБД.ПометкаУдаления
	             |	И ПеречисленияБД.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СправочникиБД.Ссылка КАК ОписаниеОбъектаБД,
	             |	""Справочник"" КАК ТипОбъектаМетаданных,
	             |	СправочникиБД.Наименование КАК ИмяОбъектаМетаданных
	             |ПОМЕСТИТЬ ОписанияОбъектовВИБ
	             |ИЗ
	             |	Справочник.СправочникиБД КАК СправочникиБД
	             |ГДЕ
	             |	НЕ СправочникиБД.ОтсутствуетВКонфигурации
	             |	И НЕ СправочникиБД.ПометкаУдаления
	             |	И СправочникиБД.Владелец = &ТипБД
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПланыВидовХарактеристикБД.Ссылка,
	             |	""ПланВидовХарактеристик"",
	             |	ПланыВидовХарактеристикБД.Наименование
	             |ИЗ
	             |	Справочник.ПланыВидовХарактеристикБД КАК ПланыВидовХарактеристикБД
	             |ГДЕ
	             |	НЕ ПланыВидовХарактеристикБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПланыВидовХарактеристикБД.ПометкаУдаления
	             |	И ПланыВидовХарактеристикБД.Владелец = &ТипБД
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПланыСчетовБД.Ссылка,
	             |	""ПланСчетов"",
	             |	ПланыСчетовБД.Наименование
	             |ИЗ
	             |	Справочник.ПланыСчетовБД КАК ПланыСчетовБД
	             |ГДЕ
	             |	НЕ ПланыСчетовБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПланыСчетовБД.ПометкаУдаления
	             |	И ПланыСчетовБД.Владелец = &ТипБД
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ПеречисленияБД.Ссылка,
	             |	""Перечисление"",
	             |	ПеречисленияБД.Наименование
	             |ИЗ
	             |	Справочник.ПеречисленияБД КАК ПеречисленияБД
	             |ГДЕ
	             |	НЕ ПеречисленияБД.ОтсутствуетВКонфигурации
	             |	И НЕ ПеречисленияБД.ПометкаУдаления
	             |	И ПеречисленияБД.Владелец = &ТипБД
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТаблицаОбъектов.ТипОбъектаМетаданных КАК ТипОбъектаМетаданных,
	             |	ТаблицаОбъектов.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
	             |	ОписанияОбъектовТек.ОписаниеОбъектаБД КАК ОписаниеОбъектаТек,
	             |	ОписанияОбъектовВИБ.ОписаниеОбъектаБД КАК ОписаниеОбъектаВИБ
	             |ПОМЕСТИТЬ СоответствиеОписаний
	             |ИЗ
	             |	ТаблицаОбъектов КАК ТаблицаОбъектов
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОписанияОбъектовТек КАК ОписанияОбъектовТек
	             |		ПО ТаблицаОбъектов.ТипОбъектаМетаданных = ОписанияОбъектовТек.ТипОбъектаМетаданных
	             |			И ТаблицаОбъектов.ИмяОбъектаМетаданных = ОписанияОбъектовТек.ИмяОбъектаМетаданных
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОписанияОбъектовВИБ КАК ОписанияОбъектовВИБ
	             |		ПО ТаблицаОбъектов.ТипОбъектаМетаданных = ОписанияОбъектовВИБ.ТипОбъектаМетаданных
	             |			И ТаблицаОбъектов.ИмяОбъектаМетаданных = ОписанияОбъектовВИБ.ИмяОбъектаМетаданных
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СоответствиеОписаний.ТипОбъектаМетаданных КАК ТипОбъектаМетаданных,
	             |	СоответствиеОписаний.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
	             |	СоответствиеОписаний.ОписаниеОбъектаТек КАК ОписаниеОбъектаТек,
	             |	СоответствиеОписаний.ОписаниеОбъектаВИБ КАК ОписаниеОбъектаВИБ,
	             |	ЕСТЬNULL(СоответствиеВнешнимИБ.Ссылка, НЕОПРЕДЕЛЕНО) КАК НастройкаСоответствия
	             |ИЗ
	             |	СоответствиеОписаний КАК СоответствиеОписаний
	             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |		ПО СоответствиеОписаний.ОписаниеОбъектаТек = СоответствиеВнешнимИБ.ОписаниеОбъектаТек
	             |			И СоответствиеОписаний.ОписаниеОбъектаВИБ = СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ"; 
	
	Запрос.УстановитьПараметр("ТипБД",ТипБД);
	Запрос.УстановитьПараметр("ТаблицаОбъектов",ТаблицаОбъектов);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Результат.НастройкаСоответствия) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СоответствиеОбъект=Справочники.СоответствиеВнешнимИБ.СоздатьЭлемент();
		СоответствиеОбъект.Владелец=ТипБД;
		
		СоответствиеОбъект.ТипОбъектаКонсолидации=Результат.ТипОбъектаМетаданных;
		СоответствиеОбъект.ИмяОбъектаМетаданных=Результат.ИмяОбъектаМетаданных;
		СоответствиеОбъект.ОписаниеОбъектаТек=Результат.ОписаниеОбъектаТек;
		
		СоответствиеОбъект.ТипОбъектаВИБ=Результат.ТипОбъектаМетаданных;
		СоответствиеОбъект.ОписаниеОбъектаВИБ=Результат.ОписаниеОбъектаВИБ;
		
		СоответствиеОбъект.СинхронизацияПоGUID=Истина;
		СоответствиеОбъект.Записать();
			
	КонецЦикла;
	
		
КонецПроцедуры // СоздатьНастройкиСоответствияПоGUID() 

	
#КонецЕсли