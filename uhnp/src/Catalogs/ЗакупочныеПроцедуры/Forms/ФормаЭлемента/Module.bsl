&НаСервере
Функция ПоместитьЭтапыГрафикаОплатыВоВременноеХранилищеНаСервере()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.ЭтапыГрафикаОплаты.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура НадписьОплатаНажатиеЗавершение(ПараметрыОплаты, ДополнительныеПараметры) Экспорт

	Если ПараметрыОплаты <> Неопределено Тогда
		
		Модифицированность = Истина;
		Объект.ЭтапыГрафикаОплаты.Очистить();
		Если ЗначениеЗаполнено(ПараметрыОплаты.АдресВоВременномХранилище) Тогда
			ЗаполнитьЭтапыОплатыИзВременногоХранилищаСервер(ПараметрыОплаты.АдресВоВременномХранилище);
		КонецЕсли; 
		Если ПараметрыОплаты.Свойство("Календарь") Тогда
			Объект.Календарь = ПараметрыОплаты.Календарь;
		КонецЕсли;
		
	КонецЕсли;
    НадписьОплата(Объект.ЭтапыГрафикаОплаты.Количество());	
   	ТекстУсловиеОплаты();  

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьЭтапыОплатыИзВременногоХранилищаСервер(АдресВоВременномХранилище)
	
	ЭтапыОплаты = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	Для Каждого ТекСтрока Из ЭтапыОплаты Цикл
		НоваяСтрока = Объект.ЭтапыГрафикаОплаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтапыГрафикаОплатыЗавершение(Результат, ДополнительныеПараметры) Экспорт 

	Если Результат = КодВозвратаДиалога.Да Тогда
   		Если Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
			ЗаполнитьПланОплаты();                       
		КонецЕсли;
		НадписьОплата(Объект.ЭтапыГрафикаОплаты.Количество());	
		ТекстУсловиеОплаты(); 
	Иначе
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнитьПланОплаты()

	Объект.ЭтапыГрафикаОплаты.Очистить();
	Доб = Объект.ЭтапыГрафикаОплаты.Добавить();
	Доб.ВариантОплаты = Перечисления.ВариантыКонтроляОплатыПоставщику.ПредоплатаДоПоступления;
	Доб.Сдвиг = 1;
	Доб.ПроцентПлатежа = 100;
	Доб.ВариантОтсчета = Перечисления.ВариантыОтсчетаДатыПлатежа.ДоДатыОтгрузки;
	НадписьОплата = НадписьОплата(Объект.ЭтапыГрафикаОплаты.Количество());
	Модифицированность = Истина;

КонецПроцедуры


&НаСервере
Процедура ТекстУсловиеОплаты()
	
	Объект.УсловияОплаты = "";     
	Для Каждого Строка ИЗ Объект.ЭтапыГрафикаОплаты Цикл   
		Если НЕ Объект.УсловияОплаты = "" Тогда
			Объект.УсловияОплаты = Объект.УсловияОплаты + Символы.ПС;
		КонецЕсли;	
		Объект.УсловияОплаты = Объект.УсловияОплаты + "Этап "+Строка.НомерСтроки +": " + Строка.ВариантОтсчета + " " + 
		Строка.Сдвиг + " (дн.)" + ", Оплата "+Строка.ПроцентПлатежа + "%."; 
	КонецЦикла;	
	Объект.УсловияОплаты = Строка(Объект.УсловияОплаты)+Символы.ПС +"Учет отсрочки по календарным дням.";                                                                                         
	
КонецПроцедуры	

&НаСервере
Функция НадписьОплата(КоличествоЭтаповОплаты)
	
	НадписьОплата = НСтр("ru = 'Этапов оплаты: %КоличествоЭтаповОплаты%, %Календарь%';
						|en = 'Payment steps: %КоличествоЭтаповОплаты%, %Календарь%'");
	НадписьОплата = СтрЗаменить(НадписьОплата, "%Календарь%", ?(ЗначениеЗаполнено(Объект.Календарь), НСтр("ru = 'по рабочим дням';
																									|en = 'on workdays'"),НСтр("ru = 'по календарным дням';
																																|en = 'by calendar days'")));
	НадписьОплата = СтрЗаменить(НадписьОплата, "%КоличествоЭтаповОплаты%", КоличествоЭтаповОплаты);
	
	Возврат НадписьОплата;
	
КонецФункции   

&НаСервере
Процедура УстановитьВерсииДокументации()
	Запрос =Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВерсияДокументацииЗакупочныхПроцедур.Ссылка КАК ВерсияЗакупочнойДокументации,
	               |	ВЫБОР
	               |		КОГДА РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта ЕСТЬ NULL
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Черновик)
	               |		ИНАЧЕ РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта
	               |	КОНЕЦ КАК СостоянияСогласования,
	               |	ВерсияДокументацииЗакупочныхПроцедур.НомерВерсииДокументации КАК НомерВерсии,
	               |	ВерсияДокументацииЗакупочныхПроцедур.ВидДокументаЗакупочнойПроцедуры КАК ВидДокументаЗакупочнойПроцедуры,
	               |	ВерсияДокументацииЗакупочныхПроцедур.АрхивныйДокумент КАК АрхивнаяВерсия
	               |ИЗ
	               |	Документ.ВерсияДокументацииЗакупочныхПроцедур КАК ВерсияДокументацииЗакупочныхПроцедур
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних КАК РегистрСостоянийОбъектовСрезПоследних
	               |		ПО ВерсияДокументацииЗакупочныхПроцедур.Ссылка = РегистрСостоянийОбъектовСрезПоследних.Объект
	               |ГДЕ
	               |	ВерсияДокументацииЗакупочныхПроцедур.ЗакупочнаяПроцедура = &ЗакупочнаяПроцедура
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерВерсии";
	Запрос.УстановитьПараметр("ЗакупочнаяПроцедура",Объект.Ссылка);
	ВерсииДокументацииЗакупочнойПроцедуры.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьСтрокуТребованияКПоставщикам(СтрокаТребования)
	Если СтрокаТребования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыТребования = ПолучитьРеквизитыТребованияКПоставщикам(СтрокаТребования.ТребованиеКПоставщику);
