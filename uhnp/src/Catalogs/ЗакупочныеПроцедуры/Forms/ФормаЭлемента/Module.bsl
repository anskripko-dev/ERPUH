&НаСервере
Функция  НастройкиКомпоновкиРаспределения()
	ОтчетОбъект = Отчеты["РаспределениеПоставщиковПоЭТП"].Создать();
	КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОтчета", Объект.ДатаНачалаПодготовкиЗакупки);
	Для Каждого ЭлементОтбора ИЗ Настройки.Отбор.Элементы Цикл	
		Если ЭлементОтбора.ЛевоеЗначение =  Новый ПолеКомпоновкиДанных("Организация") Тогда
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Объект.ОрганизацияДляЗаключенияДоговора;       
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение =  Новый ПолеКомпоновкиДанных("ТоварнаяКатегория")
			И ЗначениеЗаполнено(Объект.ТоварнаяКатегория) Тогда
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Объект.ТоварнаяКатегория;       
		КонецЕсли;
	КонецЦикла;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	Возврат КомпоновщикНастроек.ПользовательскиеНастройки;	
КонецФункции	



