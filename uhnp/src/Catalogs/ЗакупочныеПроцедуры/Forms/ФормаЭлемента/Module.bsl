	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	КомпоновщикНастроек = НастройкиКомпоновкиРаспределения();
	ПараметрыФормы.Вставить("ПользовательскиеНастройки",КомпоновщикНастроек);
