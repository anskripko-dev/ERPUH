&НаКлиенте
Процедура ДобавитьНовыйЛот(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'Требуется записать закупочную процедуру перед добавлением лота'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат;
	КонецЕсли;
		
	ТоварнаяКатегорияОбъекта = Объект.ТоварнаяКатегория;
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗакупочнаяПроцедура", Объект.Ссылка);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ДанныеЗаполнения);
	РежимБлокировать = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;    
	Если ЗначениеЗаполнено(Объект.ОснованиеЗавершения) Тогда 	
		ТекстСообщения = НСтр("ru = 'По закупочной процедуре уже введен протокол закупок, создание лота невозможно'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		Возврат; 
	ИначеЕсли Объект.ПриобретениеФинансовыхУслуг Тогда
		ОткрытьФорму("Документ.Лот.Форма.ФормаПриобретениеФинансовыхУслуг", ПараметрыФормы,	ЭтаФорма, , , ,	, РежимБлокировать);	                                       
	ИначеЕсли НЕ ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ОрганизацияДляЗаключенияДоговора, "ИспользоватьПрограммуЗакупок") = Истина Тогда 	
		ОткрытьФорму("Документ.Лот.ФормаОбъекта", ПараметрыФормы,	ЭтаФорма, , , ,	, РежимБлокировать);	
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПериодЗакупок", Объект.ПериодЗакупок);
		ПараметрыФормы.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
		ПараметрыФормы.Вставить("ОрганизаторЗакупки", Объект.ОрганизаторЗакупки); 
		ПараметрыФормы.Вставить("ОрганизацияДляЗаключенияДоговора", Объект.ОрганизацияДляЗаключенияДоговора);
		ПараметрыФормы.Вставить("Отбор", Новый Структура("СпособВыбораПоставщика",Объект.СпособВыбораПоставщика));   
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗакупочнаяПроцедура",Объект.Ссылка);
		ПараметрыФормы.Вставить("СпособВыбораПоставщика", Объект.СпособВыбораПоставщика);
		
		Если НЕ Объект.СовместнаяЗакупка Тогда
			ПараметрыФормы.Вставить("ОрганизацияДляЗаключенияДоговора", Объект.ОрганизацияДляЗаключенияДоговора);
		Иначе
			ПараметрыФормы.Вставить("ОрганизацииДляЗаключенияДоговора", ПолучитьУчастниковСовместнойЗакупки());
		КонецЕсли;
		ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработатьВыборСтрокиПланаЗакупок", ЭтаФорма);
		ОткрытьФорму("Документ.СтрокаПланаЗакупок.Форма.ФормаВыбораСвободных",
