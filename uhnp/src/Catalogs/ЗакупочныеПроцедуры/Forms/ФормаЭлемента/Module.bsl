&НаСервере
Процедура РазместитьЭлементыДопРеквизитов()
	ДопРеквизиты = Элементы.ГруппаДополнительныеРеквизиты.ПодчиненныеЭлементы;
	СчетчикДляГруппы = 0;
	Счетчик = 0;
	КоличествоЭлементов = ДопРеквизиты.Количество() - 1;
	Пока КоличествоЭлементов >= 0 Цикл
		ДопРеквизит = ДопРеквизиты[КоличествоЭлементов];
		Если СчетчикДляГруппы = 0 Тогда
			ГруппаШапка = ЭтаФорма.Элементы.Добавить("ГруппаДопРеквизит"+Счетчик, Тип("ГруппаФормы"),Элементы.ГруппаДополнительныеРеквизиты);
			ГруппаШапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаШапка.Отображение = ОтображениеОбычнойГруппы.Нет;
			ГруппаШапка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			ГруппаШапка.РастягиватьПоГоризонтали = Истина;
		КонецЕсли;
		СчетчикДляГруппы = СчетчикДляГруппы + 1;
		ЭтаФорма.Элементы.Переместить(ДопРеквизит,ГруппаШапка);
		Если СчетчикДляГруппы = 2 Тогда
			СчетчикДляГруппы = 0;
		КонецЕсли;	
		Счетчик = Счетчик + 1;
		КоличествоЭлементов = КоличествоЭлементов - 1;
	КонецЦикла;	
КонецПроцедуры

