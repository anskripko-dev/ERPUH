&НаКлиенте
Процедура ПараметрыОтчета1ТипЗначенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
		
	МассивВсехСсылок = ОбщегоНазначенияУХ.ПолучитьМассивТиповЛюбаяСсылка();
		
	СписокВсехСсылок = Новый СписокЗначений;
	СписокВсехСсылок.ЗагрузитьЗначения(МассивВсехСсылок);
		
	СписокВсехСсылок.СортироватьПоЗначению();
		
	СписокВсехСсылок.Вставить(0, Тип("Булево"));
	СписокВсехСсылок.Вставить(0, Тип("Дата"));
	СписокВсехСсылок.Вставить(0, Тип("Строка"));
	СписокВсехСсылок.Вставить(0, Тип("Число"));
	
	ТекущийТип = СписокВсехСсылок.НайтиПоЗначению(ТипЗнч(Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.ЗначениеПоУмолчанию));
			
	ОписаниеОповещенияОбработкаВыбора = Новый ОписаниеОповещения("ОписаниеОповещенияОбработкаВыбора", ЭтотОбъект);
	ЗаголовокВыбора = Нстр("ru = 'Выбор типа данных'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	СписокВсехСсылок.ПоказатьВыборЭлемента(ОписаниеОповещенияОбработкаВыбора, ЗаголовокВыбора, ТекущийТип);
		
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеОповещенияОбработкаВыбора(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Модифицированность = Истина;
	Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.ТипЗначения = Результат.Значение;
	
	Если Результат.Значение = ТипЗнч(Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.ЗначениеПоУмолчанию) Тогда		
		Возврат;
	КонецЕсли;
		
	УстановитьТипЗначения(Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.НомерСтроки, "ЗначениеПоУмолчанию", ОбщегоНазначенияУХ.ПустоеЗначениеТипа(Результат.Значение));
		
КонецПроцедуры

