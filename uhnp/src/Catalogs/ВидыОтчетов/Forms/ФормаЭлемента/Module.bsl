&НаКлиенте
Процедура УстановитьЗначенияПараметров(Команда)
		
	ПараметрыОтбора = Новый Структура; 
	СтруктураОтбора = Новый Структура;
	
	СтруктураОтбора.Вставить("ВидОтчета", Объект.Ссылка);
		
	ПараметрыОтбора.Вставить("Отбор", СтруктураОтбора);
		 
	ОткрытьФорму("РегистрСведений.ЗначенияПараметровОтчетов.ФормаСписка", ПараметрыОтбора, Этаформа, Объект.Ссылка);
		
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтчета1КодОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
		
	Если Объект.ПараметрыОтчета.НайтиСтроки(Новый Структура("Код", Текст)).Количество() > 0 Тогда	
		ИндексСтроки = Элементы.ПараметрыОтчета_Таблица.ТекущаяСтрока;
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = Нстр("ru = 'Код строки не уникален.'");
		СообщениеПользователю.Поле  = "ТабличноеПолеСтрок[" + ИндексСтроки + "].Код";
		СообщениеПользователю.Сообщить();
		СтандартнаяОбработка = Ложь;
		
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтчета_ТаблицаПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	
	КодПараметра = Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.Код;
	ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить всю историю значений параметра ""%1""?'"), КодПараметра);
	ОписаниеЗакрытие = Новый ОписаниеОповещения("ПередУдалением_Завершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеЗакрытие, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередУдалением_Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		ВыполнитьУдалениеНаСервере(Элементы.ПараметрыОтчета_Таблица.ТекущиеДанные.Код);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьУдалениеНаСервере(КодПараметра)
	
	Объект.ПараметрыОтчета.Удалить(Элементы.ПараметрыОтчета_Таблица.ТекущаяСтрока);
	
	Модифицированность = Истина;
	
	ЗапросПоРегистру = Новый Запрос("ВЫБРАТЬ
	                                |	ЗначенияПараметровОтчетов.ВидОтчета КАК ВидОтчета,
	                                |	ЗначенияПараметровОтчетов.Организация КАК Организация,
	                                |	ЗначенияПараметровОтчетов.Сценарий КАК Сценарий,
	                                |	ЗначенияПараметровОтчетов.Проект КАК Проект,
	                                |	ЗначенияПараметровОтчетов.Аналитика1 КАК Аналитика1,
	                                |	ЗначенияПараметровОтчетов.Аналитика2 КАК Аналитика2,
	                                |	ЗначенияПараметровОтчетов.Аналитика3 КАК Аналитика3,
	                                |	ЗначенияПараметровОтчетов.Аналитика4 КАК Аналитика4,
	                                |	ЗначенияПараметровОтчетов.Аналитика5 КАК Аналитика5,
	                                |	ЗначенияПараметровОтчетов.Аналитика6 КАК Аналитика6,
	                                |	ЗначенияПараметровОтчетов.КодПараметра КАК КодПараметра
	                                |ИЗ
	                                |	РегистрСведений.ЗначенияПараметровОтчетов КАК ЗначенияПараметровОтчетов
	                                |ГДЕ
	                                |	ЗначенияПараметровОтчетов.ВидОтчета = &ВидОтчета
	                                |	И ЗначенияПараметровОтчетов.КодПараметра = &КодПараметра");
	
	ЗапросПоРегистру.УстановитьПараметр("ВидОтчета", Объект.Ссылка);
	ЗапросПоРегистру.УстановитьПараметр("КодПараметра", КодПараметра);
	
	ВыборкаПоРегистру = ЗапросПоРегистру.Выполнить().Выбрать();
	
	НаборЗаписей = РегистрыСведений.ЗначенияПараметровОтчетов.СоздатьНаборЗаписей();
		
	Пока ВыборкаПоРегистру.Следующий() Цикл
				
		НаборЗаписей.Отбор.ВидОтчета.Установить(ВыборкаПоРегистру.ВидОтчета);	
		НаборЗаписей.Отбор.Организация.Установить(ВыборкаПоРегистру.Организация);
		НаборЗаписей.Отбор.Сценарий.Установить(ВыборкаПоРегистру.Сценарий);
		НаборЗаписей.Отбор.Проект.Установить(ВыборкаПоРегистру.Проект);
		НаборЗаписей.Отбор.Аналитика1.Установить(ВыборкаПоРегистру.Аналитика1);
		НаборЗаписей.Отбор.Аналитика2.Установить(ВыборкаПоРегистру.Аналитика2);
		НаборЗаписей.Отбор.Аналитика3.Установить(ВыборкаПоРегистру.Аналитика3);
		НаборЗаписей.Отбор.Аналитика4.Установить(ВыборкаПоРегистру.Аналитика4);
		НаборЗаписей.Отбор.Аналитика5.Установить(ВыборкаПоРегистру.Аналитика5);
		НаборЗаписей.Отбор.Аналитика6.Установить(ВыборкаПоРегистру.Аналитика6);
		НаборЗаписей.Отбор.КодПараметра.Установить(ВыборкаПоРегистру.КодПараметра);
		
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтчета_ТаблицаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущееПоле = Элемент.ТекущийЭлемент;
	
	Если ТекущееПоле.Имя = "ПараметрыОтчета1ЗначениеПоУмолчанию" И Элемент.ТекущиеДанные.ТипЗначения = "Дата" Тогда			
		ТекущееПоле.ОграничениеТипа = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);	
	Иначе	
		ТекущееПоле.ОграничениеТипа = Новый ОписаниеТипов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОтчета_ТаблицаПриАктивизацииПоля(Элемент)
	
	ТекущееПоле = Элемент.ТекущийЭлемент;
	
	Если ТекущееПоле.Имя = "ПараметрыОтчета1ЗначениеПоУмолчанию" И Элемент.ТекущиеДанные.ТипЗначения = "Дата" Тогда			
		ТекущееПоле.ОграничениеТипа = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НеВыводитьГруппирующиеСчетаПриИзменении(Элемент)
	
	Если Объект.ПравилаФормированияФормул=1 Тогда
		
		Объект.ПравилаФормированияФормул=2;
		
	КонецЕсли;
	
