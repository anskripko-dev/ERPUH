КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПроектов(ТолькоУтвержденные = Ложь)
	
	
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	                 |	Проекты.Ссылка КАК Проект,
	                 |	Проекты.РазделИнвестиционнойПрограммы КАК РазделИнвестиционнойПрограммы,
	                 |	РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта КАК Статус,
	                 |	АтрибутыПроектов.ИтогоСписанияБДДС КАК ИтогоСписанияБДДС,
	                 |	АтрибутыПроектов.ИтогоРасходыБДР КАК ИтогоРасходыБДР,
	                 |	АтрибутыПроектов.ИтогоПоступленияБДДС КАК ИтогоПоступленияБДДС,
	                 |	АтрибутыПроектов.ИтогоДоходыБДР КАК ИтогоДоходыБДР,
	                 |	АтрибутыПроектов.ИтогоЧистыйДенежныйПоток КАК ИтогоЧистыйДенежныйПоток,
	                 |	АтрибутыПроектов.ИтогоПрибыльУбыток КАК ИтогоПрибыльУбыток,
	                 |	АтрибутыПроектов.ДлительностьДней КАК ДлительностьДней
	                 |ИЗ
	                 |	Справочник.Проекты КАК Проекты
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АтрибутыПроектов КАК АтрибутыПроектов
	                 |		ПО Проекты.Ссылка = АтрибутыПроектов.Проект
	                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних КАК РегистрСостоянийОбъектовСрезПоследних
	                 |		ПО Проекты.Ссылка = РегистрСостоянийОбъектовСрезПоследних.Объект
	                 |ГДЕ
	                 |	Проекты.Организация = &Организация
	                 |	И АтрибутыПроектов.Сценарий = &Сценарий
	                 |	И АтрибутыПроектов.ДатаОкончания >= &ДатаНачалаПрограммы
	                 |	И АтрибутыПроектов.ДатаНачала <= &ДатаОкончанияПрограммы
	                 |	И Проекты.Проект = ИСТИНА
	                 |	И Проекты.ПометкаУдаления = ЛОЖЬ";
	  
	  Запрос.УстановитьПараметр("Организация",Объект.Организация);
	  Запрос.УстановитьПараметр("Сценарий",Объект.Сценарий);
      Запрос.УстановитьПараметр("ДатаНачалаПрограммы",Объект.Период.ДатаНачала);
	  Запрос.УстановитьПараметр("ДатаОкончанияПрограммы",Объект.ПериодОкончание.ДатаНачала);

	  
	  РезультатПроекты = Запрос.Выполнить().Выгрузить();
	  
	  Проекты.Очистить();
	  
	  Если ТолькоУтвержденные Тогда
		  
		  РезультатПроекты =  РезультатПроекты.Скопировать(Новый Структура("Статус",Перечисления.СостоянияПроектов.Утвержден));
		  
	  КонецЕсли;	  
	  
	  Для Каждого текПроект Из РезультатПроекты Цикл
		  
		  нСтрокаПроект = Проекты.Добавить();
		  ЗаполнитьЗначенияСвойств(нСтрокаПроект,текПроект);
		  
	  КонецЦикла;	  
	  
	  ОбновитьЗначенияАтрибутовПроектов();

	  ЭтаФорма.Модифицированность = Истина;
		
КонецПроцедуры	

&НаСервере
Процедура ОбновитьЗначенияАтрибутовПроектов()
	
	СписокПроектов 		=  Проекты.Выгрузить().ВыгрузитьКолонку("Проект");
	АтрибутыПроектов    =  ВернутьКлючевыеПоказателиПроектов(СписокПроектов);
	
	Для Каждого Проект Из Проекты Цикл
		
		тСтрокаАтрибут = АтрибутыПроектов.Найти(Проект.Проект,"Проект");
		Если Не тСтрокаАтрибут = Неопределено Тогда
			
			  ЗаполнитьЗначенияСвойств(Проект,тСтрокаАтрибут);
	
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ВернутьКлючевыеПоказателиПроектов(СписокПроектов)

  	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Проекты.Ссылка КАК Проект,
	               |	Проекты.РазделИнвестиционнойПрограммы КАК РазделИнвестиционнойПрограммы,
	               |	РегистрСостоянийОбъектовСрезПоследних.СостояниеОбъекта КАК Статус,
	               |	АтрибутыПроектов.ИтогоСписанияБДДС КАК ИтогоСписанияБДДС,
	               |	АтрибутыПроектов.ИтогоРасходыБДР КАК ИтогоРасходыБДР,
	               |	АтрибутыПроектов.ИтогоПоступленияБДДС КАК ИтогоПоступленияБДДС,
	               |	АтрибутыПроектов.ИтогоДоходыБДР КАК ИтогоДоходыБДР,
	               |	АтрибутыПроектов.ИтогоЧистыйДенежныйПоток КАК ИтогоЧистыйДенежныйПоток,
	               |	АтрибутыПроектов.ИтогоПрибыльУбыток КАК ИтогоПрибыльУбыток,
	               |	АтрибутыПроектов.ДлительностьДней КАК ДлительностьДней,
	               |	СостояниеОценкиОбъектов.Завершен КАК ОценкаЗавершена,
	               |	АтрибутыПроектов.ДатаНачала КАК ДатаНачала,
	               |	0 КАК ИтоговыйБалл,
	               |	АтрибутыПроектов.ДатаОкончания КАК ДатаОкончания,
	               |	СостояниеОценкиОбъектов.ЭтапОценки КАК ЭтапОценки,
	               |	Проекты.НеОцениваетсяПоКритериям КАК НеОцениваетсяПоКритериям
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АтрибутыПроектов КАК АтрибутыПроектов
	               |		ПО Проекты.Ссылка = АтрибутыПроектов.Проект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСостоянийОбъектов.СрезПоследних КАК РегистрСостоянийОбъектовСрезПоследних
	               |		ПО Проекты.Ссылка = РегистрСостоянийОбъектовСрезПоследних.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеОценкиОбъектов КАК СостояниеОценкиОбъектов
	               |		ПО Проекты.Ссылка = СостояниеОценкиОбъектов.ОбъектОценки
	               |ГДЕ
	               |	АтрибутыПроектов.Сценарий = &Сценарий
	               |	И Проекты.Ссылка В(&Проекты)";
	
	Запрос.УстановитьПараметр("Проекты",СписокПроектов);
	Запрос.УстановитьПараметр("Сценарий",Объект.Сценарий);
	Запрос.УстановитьПараметр("ИнвестиционнаяПрограмма",Объект.Ссылка);
	
	ТзАтрибуты =  Запрос.Выполнить().Выгрузить();
	Для Каждого АСтр Из ТзАтрибуты Цикл
		
		Если АСтр.НеОцениваетсяПоКритериям Тогда
			АСтр.ИтоговыйБалл = 1;
			АСтр.ОценкаЗавершена = Истина;
		Иначе	
			
			АСтр.ИтоговыйБалл =  ВыборОбъектовУХ.ИнтегральнаяОценкаОбъекта(АСтр.РазделИнвестиционнойПрограммы
			, АСтр.Проект
			, АСтр.ЭтапОценки
			, Ложь);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ТзАтрибуты;
	
КонецФункции	

&НаСервере
Процедура ПрочитатьТЧПроекты(ОбновлятьЗначенияАтрибутов = Ложь)
	
	//прочитаем таблицу текущих проектов в табличную часть
	Для Каждого СтрПроект Из Объект.Проекты Цикл		
		нСтрокаПроект = Проекты.Добавить();
		ЗаполнитьЗначенияСвойств(нСтрокаПроект,СтрПроект);				
	КонецЦикла;	 
	
	//Обновим все значения по текущим данным
	Если ОбновлятьЗначенияАтрибутов Тогда
		ОбновитьЗначенияАтрибутовПроектов();
	КонецЕсли;
			
КонецПроцедуры	

&НаКлиенте
Процедура ВвестиЗначенияКритериев(Команда)
	
	Если Элементы.Проекты.ТекущиеДанные = Неопределено Тогда		
		Возврат;
	КонецЕсли;
		
	ТекущийПроект 		= Элементы.Проекты.ТекущиеДанные.Проект;
	ТекущийРаздел 		= Элементы.Проекты.ТекущиеДанные.РазделИнвестиционнойПрограммы;
	ТекущаяПрограмма 	= Объект.Ссылка;
	
	ОповещениеОценкаПоКритериямЗавршение = Новый ОписаниеОповещения("ОценкаПоКритериямЗавршение", ЭтаФорма);
	
	ПараметрыФормы = Новый Структура("РазделИнвестиционнойПрограммы,Проект,ИнвестиционнаяПрограмма",ТекущийРаздел,ТекущийПроект,ТекущаяПрограмма);  
	ОткрытьФорму("Обработка.ОценкаОбъектовИнвестиционныхПроектов.Форма", ПараметрыФормы, ЭтаФорма, Ложь,,,ОповещениеОценкаПоКритериямЗавршение);

КонецПроцедуры

&НаКлиенте
Процедура ОценкаПоКритериямЗавршение(Результат, ДополнительныеПараметры) Экспорт
	
	 ОбновитьДанныеПроектов(Неопределено);
	 
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПроектов(Команда)
	
	ОбновитьЗначенияАтрибутовПроектов();

КонецПроцедуры

&НаКлиенте
Процедура ПроектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПроектыИтоговыйБалл" ИЛИ Поле.Имя = "ПроектыОценкаЗавершена" Тогда		
		ВвестиЗначенияКритериев(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроектыПриИзменении(Элемент)
	
	ОбновитьЗначенияАтрибутовПроектов();
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаОтображенияПриИзменении(Элемент)

       ОбновитьОтображениеПоказателей();

КонецПроцедуры

&НаСервере
Процедура  ОбновитьОтображениеПоказателей();
	
	Элементы.Поступление.Заголовок 	= Нстр("ru = 'Поступления '")+ПолучитьПредставлениеМасштаба(Объект.ЕдиницаОтображения)+ " "+ВалютаПоказателей;
    Элементы.Списание.Заголовок 	= Нстр("ru = 'Списания '")+ПолучитьПредставлениеМасштаба(Объект.ЕдиницаОтображения)+" "+ВалютаПоказателей;
		
	ФорматМасштаба =   ПолучитьФорматМасштаба(Объект.ЕдиницаОтображения);
	
	Если Объект.ЕдиницаОтображения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		Элементы.ПроектыИтогоДоходыБДР.Формат 			=   ФорматМасштаба;
		Элементы.ПроектыИтогоПоступленияБДДС.Формат 	=   ФорматМасштаба;
		Элементы.ПроектыИтогоРасходыБДР.Формат 			=   ФорматМасштаба;
		Элементы.ПроектыИтогоСписанияБДДС.Формат 		=   ФорматМасштаба;		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеМасштаба(ЕдиницаИзмерения)
	
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		ТекущийДелитель = Нстр("ru = 'Млн.'");
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		ТекущийДелитель  = Нстр("ru = 'Тыс.'");
	Иначе
		ТекущийДелитель =  "";
	КонецЕсли;
	
	Возврат ТекущийДелитель;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФорматМасштаба(ЕдиницаИзмерения)
	
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		ФорматМасштаба = "ЧДЦ=2; ЧС=6";
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		ФорматМасштаба  = "ЧДЦ=2; ЧС=3";
	Иначе
		ФорматМасштаба =  "ЧДЦ=2; ЧС=0";
	КонецЕсли;
	
	Возврат ФорматМасштаба;
	
КонецФункции




&НаСервере
Процедура ПолучитьСводныйОтчет()
	
	РазделыСводнаяИнформация.Очистить();

	МакетИтоговыйОтчет = Справочники.ИнвестиционныеПрограммы.ПолучитьМакет("МакетИтоговогоОтчетаИПР");
	
	//Установить формат числовых ячеек
	ФорматМасштаба =   ПолучитьФорматМасштаба(Объект.ЕдиницаОтображения);
	Для ИндСтроки = МакетИтоговыйОтчет.ФиксацияСверху по МакетИтоговыйОтчет.ВысотаТаблицы Цикл
		Для ИндКолонки = МакетИтоговыйОтчет.ФиксацияСлева по МакетИтоговыйОтчет.ШиринаТаблицы Цикл			
			МакетИтоговыйОтчет.Область(ИндСтроки,ИндКолонки,ИндСтроки,ИндКолонки).Формат = ФорматМасштаба;
		КонецЦикла;			
	КонецЦикла;	
	
	ОбластьШапка       = МакетИтоговыйОтчет.ПолучитьОбласть("ОбластьШапкаТаблицы");
    ОбластьШапка.Параметры.Заголовок1 	= Нстр("ru = 'Поступления '")+ПолучитьПредставлениеМасштаба(Объект.ЕдиницаОтображения)+ " "+ВалютаПоказателей;
    ОбластьШапка.Параметры.Заголовок2 	= Нстр("ru = 'Списания '")+ПолучитьПредставлениеМасштаба(Объект.ЕдиницаОтображения)+" "+ВалютаПоказателей;
		
	РазделыСводнаяИнформация.Вывести(ОбластьШапка);
	
	ОбластьИтого       = МакетИтоговыйОтчет.ПолучитьОбласть("ОластьРазделИтого");
    ОбластьИтого.Параметры.БДРПоступления 		= Проекты.Итог("ИтогоДоходыБДР");
	ОбластьИтого.Параметры.БДДСПоступления 		= Проекты.Итог("ИтогоПоступленияБДДС");
    ОбластьИтого.Параметры.БДРСписания 			= Проекты.Итог("ИтогоРасходыБДР");
	ОбластьИтого.Параметры.БДДССписания 		= Проекты.Итог("ИтогоСписанияБДДС");
	
		
	РазделыСводнаяИнформация.Вывести(ОбластьИтого);
	
	ТекущиеРазделы = Проекты.Выгрузить().Скопировать();
	ТекущиеРазделы.Свернуть("РазделИнвестиционнойПрограммы");
	
	РазделыСводнаяИнформация.НачатьГруппуСтрок();
	
	ОбластьРаздел   =  МакетИтоговыйОтчет.ПолучитьОбласть("ОластьРазделПрограммы");
    ОбластьПроект   =  МакетИтоговыйОтчет.ПолучитьОбласть("ОластьПроект");

	
	Для Каждого СтрРаздел Из ТекущиеРазделы Цикл
		
		тПроектыРаздела =  Проекты.Выгрузить(Новый Структура("РазделИнвестиционнойПрограммы",СтрРаздел.РазделИнвестиционнойПрограммы)).Скопировать();
		
		ОбластьРаздел.Параметры.Раздел =  СтрРаздел.РазделИнвестиционнойПрограммы;
	
		ОбластьРаздел.Параметры.БДРПоступления 		= тПроектыРаздела.Итог("ИтогоДоходыБДР");
		ОбластьРаздел.Параметры.БДДСПоступления 	= тПроектыРаздела.Итог("ИтогоПоступленияБДДС");
		ОбластьРаздел.Параметры.БДРСписания 		= тПроектыРаздела.Итог("ИтогоРасходыБДР");
		ОбластьРаздел.Параметры.БДДССписания 		= тПроектыРаздела.Итог("ИтогоСписанияБДДС");
		
		РазделыСводнаяИнформация.Вывести(ОбластьРаздел);
		
		РазделыСводнаяИнформация.НачатьГруппуСтрок();

		Для Каждого тПроект Из тПроектыРаздела Цикл
			
			
			ОбластьПроект.Параметры.Проект =  тПроект.Проект;
			
			ОбластьПроект.Параметры.БДРПоступления 		= тПроект.ИтогоДоходыБДР;
			ОбластьПроект.Параметры.БДДСПоступления 	= тПроект.ИтогоПоступленияБДДС;
			ОбластьПроект.Параметры.БДРСписания 		= тПроект.ИтогоРасходыБДР;
			ОбластьПроект.Параметры.БДДССписания 		= тПроект.ИтогоСписанияБДДС;
			
			РазделыСводнаяИнформация.Вывести(ОбластьПроект);
			
			
		КонецЦикла;	
		
		РазделыСводнаяИнформация.ЗакончитьГруппуСтрок();

		
	КонецЦикла;	
	
	РазделыСводнаяИнформация.ЗакончитьГруппуСтрок();
	
	
КонецПроцедуры	

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ГруппаРазделы Тогда
		 ПолучитьСводныйОтчет();
	КонецЕсли;	
	
КонецПроцедуры


 #КонецОбласти 


