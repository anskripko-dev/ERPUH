
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	#Область УниверсальныеПроцессыСогласование
	ДействияСогласованиеУХСервер.НарисоватьПанельСогласованияИОпределитьСостояниеОбъекта(ЭтаФорма);
	#КонецОбласти
	
	Если Не ЗначениеЗаполнено(Объект.Периодичность) Тогда
		 Объект.Периодичность = Перечисления.Периодичность.Год;
	КонецЕсли;	
	
	ПрочитатьТЧПроекты(Истина);
	
	УстановитьВидимостьДоступностьЭлементов();
	
	Если Не ЗначениеЗаполнено(Объект.ЕдиницаОтображения) Тогда
		Объект.ЕдиницаОтображения = Перечисления.ПорядкиОкругленияОтчетности.Окр1;
	КонецЕсли;	
	
	ВалютаПоказателей = Константы.ВалютаРасчетаПоказателейПроекта.Получить();
	
	ОбновитьОтображениеПоказателей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбъектСогласован" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти	
	ИначеЕсли ИмяСобытия = "ОбъектОтклонен" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти	
	ИначеЕсли ИмяСобытия = "МаршрутИнициализирован" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти		
	ИначеЕсли ИмяСобытия = "СостояниеЗаявкиПриИзменении" Тогда
		#Область УниверсальныеПроцессыСогласование
		ОпределитьСостояниеОбъекта();
		#КонецОбласти		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПередЗаписьюНаСервере();

КонецПроцедуры

 &НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	ТекущийСтатусПрограммы = УправлениеПроцессамиСогласованияУХ.ВернутьСтатусОбъекта(Объект.Ссылка); 
	
	Элементы.ГруппаОсновнаяИнформация.ТолькоПросмотр 	= ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;
	Элементы.ГруппаПроекты.ТолькоПросмотр  			= ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;
	Элементы.ФормаЗаписатьИЗакрыть.Доступность 		= НЕ ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;
	Элементы.ФормаЗаписать.Доступность			 	= НЕ ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;
	Элементы.ИзменитьПериод.Доступность             = НЕ ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;
	Элементы.ГруппаКоманднаяПанельПроекты.Доступность = НЕ ТекущийСтатусПрограммы =Перечисления.СостоянияСогласования.Утверждена;

КонецПроцедуры	

&НаСервере
Процедура ПередЗаписьюНаСервере()
	
	Объект.Проекты.Очистить();
	
	//Запишем таблицу текущих проектов в табличную часть
	Для Каждого СтрПроект Из Проекты Цикл
		
		нСтрокаТЧПроект = Объект.Проекты.Добавить();
		ЗаполнитьЗначенияСвойств(нСтрокаТЧПроект,СтрПроект);
				
	КонецЦикла;	 
		
КонецПроцедуры


	
#Область ОбработчикиРаботыСПериодами

&НаКлиенте
Процедура ИзменитьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("СтандартныйПериод") Тогда
		
		ВыбраннаяПериодичность = Объект.Периодичность;
		
		РезультатДатаНачала 		= РезультатВыбора.ДатаНачала;
		РезультатДатаОкончания 		= РезультатВыбора.ДатаОкончания;
		
		Если (ЗначениеЗаполнено(РезультатДатаНачала)) И (ЗначениеЗаполнено(РезультатДатаОкончания)) Тогда
			
			ПериодыУХПовтИсп.ПроверитьИнтервалПериодов(РезультатДатаНачала, РезультатДатаОкончания, ВыбраннаяПериодичность);
			
			Объект.Период		 		= ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатДатаНачала, ВыбраннаяПериодичность);
			Объект.ПериодОкончание	 	= ОбщегоНазначенияУХ.ПолучитьПериодПоДате(РезультатДатаОкончания, ВыбраннаяПериодичность);
									
		Иначе
			// Не изменяем периоды.
		КонецЕсли;
	ИначеЕсли РезультатВыбора = Неопределено Тогда	
		// Пользователь отказался. Не изменяем периоды.
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный вариант периода ""%Период%"". Операция отменена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Период%", Строка(РезультатВыбора));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериод(Команда)
	
	ПустаяДата = Дата(1, 1, 1);
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Если ЗначениеЗаполнено(Объект.Период) Тогда
		Диалог.Период.ДатаНачала	 = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.Период, "ДатаНачала");
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПериодОкончание) Тогда
		Диалог.Период.ДатаОкончания	 = ОбщегоНазначенияУХ.ПолучитьЗначениеРеквизита(Объект.ПериодОкончание, "ДатаОкончания");
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

