&НаКлиенте
Процедура ВыбратьЗначениеСостояния(Элемент,СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	
	ОбновитьЗначениеТипаСостояния();
	
	Если НЕ ЗначениеЗаполнено(Объект.РеквизитСостоянияСтрока) ИЛИ Прав(Объект.РеквизитСостоянияСтрока, 1) = "." Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НаменованиеРеквизитаСостояния = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(Объект.РеквизитСостояния, "Наименование");
	
	Элемент.СписокВыбора.Очистить();
	СтруктураДанных = ПолучитьДанныеНаСервере(НаменованиеРеквизитаСостояния);
	Для Каждого ЭлементСостояние Из СтруктураДанных.СписокСостояний Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСостояние.Значение, ЭлементСостояние.Представление);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура("ИмяРеквизита", Элемент.Имя);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСостояния", ЭтотОбъект, ДополнительныеПараметры);
	Элемент.СписокВыбора.ПоказатьВыборЭлемента(Оповещение);
						
КонецПроцедуры // ВыбратьЗначениеСостояния()

&НаСервере
Функция ПолучитьДанныеНаСервере(НаменованиеПеречисления)
	
	СписокСостояний = Новый СписокЗначений();
	
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[НаменованиеПеречисления].ЗначенияПеречисления Цикл
		ЭлементПеречисления = Перечисления[НаменованиеПеречисления][ЗначениеПеречисления.Имя];
		ЭлементПеречисленияПредставление = Строка(ЭлементПеречисления);
		
		Если СтрНайти(ЭлементПеречисленияПредставление, "(не используется)") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СписокСостояний.Добавить(ЭлементПеречисления, ЭлементПеречисленияПредставление);
	КонецЦикла;
			
	Возврат Новый Структура("СписокСостояний", СписокСостояний);
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСостояния(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
