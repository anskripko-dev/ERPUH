
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	Если ЗначениеЗаполнено(ТекущийОбъект.ИмяПредопределенныхДанных) Тогда
    	ЭтотОбъект.ТолькоПросмотр = Истина;		
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьСтруктуруПараметров(); 
	УправлениеФормой();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДопустимБезналичныйРасчетПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ДопустимНаличныйРасчетПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииДДСНаличныйРасчетПриИзменении(Элемент)
	ЗаполнитьПризнаки();
КонецПроцедуры

&НаКлиенте
Процедура ВстречныйВидОперацииПереводСобственныхСредствПриИзменении(Элемент)
	ЗаполнитьПризнаки();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПризнаки()
	//      
	ОбновитьСтруктуруПараметров();    
	
	Для каждого Элемент Из СтруктураПараметров Цикл
		Если НЕ ЗначениеЗаполнено(Элемент.Значение) Тогда
			Объект[Элемент.Ключ] = Неопределено;
		Иначе	
			Объект[Элемент.Ключ] = Элемент.Значение;
		КонецЕсли;	
	КонецЦикла;  
	
	УправлениеФормой();
	
КонецПроцедуры    

&НаСервере
Процедура ОбновитьСтруктуруПараметров()
	
	СтруктураПараметров = Справочники.ВидыОперацийУХ.ПолучитьСтруктуруПараметров();
	Если ЭтотОбъект.ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;

	ПараметрыВидыОпераций = ВидыОперацийУХВызовСервераПовтИсп.ПараметрыВидыОпераций();
	Если Объект.ДопустимБезналичныйРасчет Тогда

		СтруктураПараметровБезналичныйРасчет = ПараметрыВидыОпераций[Объект.ВидОперацииДДСБезналичныйРасчет];
		Если ЗначениеЗаполнено(СтруктураПараметровБезналичныйРасчет) Тогда
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтруктураПараметровБезналичныйРасчет);	
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ДопустимНаличныйРасчет Тогда
		СтруктураПараметровНаличныйРасчет = ПараметрыВидыОпераций[Объект.ВидОперацииДДСНаличныйРасчет];
		Если ЗначениеЗаполнено(СтруктураПараметровНаличныйРасчет) Тогда
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтруктураПараметровНаличныйРасчет);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УправлениеФормой()  
	Если ЭтотОбъект.ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидОперацииДДСБезналичныйРасчет", "Доступность", Объект.ДопустимБезналичныйРасчет);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидОперацииДДСНаличныйРасчет", "Доступность", Объект.ДопустимНаличныйРасчет);	
	
	Если ЗначениеЗаполнено(СтруктураПараметров)
		И  (Объект.ДопустимБезналичныйРасчет ИЛИ Объект.ДопустимНаличныйРасчет) Тогда
		Для каждого Элемент Из СтруктураПараметров Цикл
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Элемент.Ключ, "Доступность", Ложь);	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
 
