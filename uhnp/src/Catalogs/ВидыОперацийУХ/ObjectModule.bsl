Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если НЕ ЭтоГруппа Тогда
		
		МассивНепроверяемыхРеквизитов = Новый Массив; 
		
		Если Не ДопустимБезналичныйРасчет Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ВидОперацииДДСБезналичныйРасчет");	
		КонецЕсли;                                                                    
		
		Если Не ДопустимНаличныйРасчет Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ВидОперацииДДСНаличныйРасчет");			
		КонецЕсли;
		
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
		
		// проверка параметров пользовательских видов операций  
		Если ДопустимБезналичныйРасчет 
			И ДопустимНаличныйРасчет Тогда
			
			СтруктураПараметровБезналичныйРасчет = Справочники.ВидыОперацийУХ.ПолучитьСтруктуруПараметров();
			СтруктураПараметровНаличныйРасчет = Справочники.ВидыОперацийУХ.ПолучитьСтруктуруПараметров();
			
			ПараметрыВидыОпераций = ВидыОперацийУХВызовСервераПовтИсп.ПараметрыВидыОпераций();
			
			СтруктураПараметровЭталон = ПараметрыВидыОпераций[ВидОперацииДДСБезналичныйРасчет];
			Если ЗначениеЗаполнено(СтруктураПараметровЭталон) Тогда
				ЗаполнитьЗначенияСвойств(СтруктураПараметровБезналичныйРасчет, СтруктураПараметровЭталон);	
			КонецЕсли;
			
			СтруктураПараметровЭталон = ПараметрыВидыОпераций[ВидОперацииДДСНаличныйРасчет];
			Если ЗначениеЗаполнено(СтруктураПараметровЭталон) Тогда
				ЗаполнитьЗначенияСвойств(СтруктураПараметровНаличныйРасчет, СтруктураПараметровЭталон);	
			КонецЕсли;  
					
			Для каждого Элемент Из СтруктураПараметровБезналичныйРасчет Цикл
				Если Элемент.Значение <> СтруктураПараметровНаличныйРасчет[Элемент.Ключ] Тогда 
					ТекстСообщения = НСтр("ru = 'Выбраны противоречивые виды операции ДДС '");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);                                 
					Прервать;
            	КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

