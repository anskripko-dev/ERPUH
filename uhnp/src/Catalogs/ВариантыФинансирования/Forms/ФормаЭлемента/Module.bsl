#Область ОписаниеПеременных   
&НаКлиенте
Перем ИсходнаяДатаСтроки;
#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ТипПроцентнойСтавки 				= Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная; 
		Объект.ВидДнейСдвигаУплаты 				= Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням;
		Объект.ТочкаОтсчетаДатыФиксацииСтавки   = Перечисления.СпособыОпределенияДатыОперацииПоПериоду.НачалоПериода;
		РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьПроизводственныеКалендариПоУмолчанию(Объект.ПроизводственныеКалендари);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПокрытиеПотребностиВФинансировании) Тогда
		ИменаРеквизитов = "ВалютаДокумента, СуммаДокумента";
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПокрытиеПотребностиВФинансировании, ИменаРеквизитов); 
		СуммаЗаявки 	= СтруктураРеквизитов.СуммаДокумента;
		
	КонецЕсли;

	ОписаниеГрафика 	= Справочники.ВариантыФинансирования.ОписаниеГрафика();
	
	ПереченьОпераций 	= РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, Объект, Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);
	
	ОперацииГрафика 	= Новый ФиксированноеСоответствие(ПереченьОпераций);

	// создание таблицы графика расчетов
	ДоговорыКонтрагентовФормыУХ.СоздатьКолонкиИРеквизитыГрафикаРасчетовНаФорме(ЭтотОбъект);
	ДоговорыКонтрагентовФормыУХ.СоздатьКолонкиГрафикаРасчетовЛинейныйНаФорме(ЭтотОбъект);
	ДоговорыКонтрагентовФормыУХ.СоздатьРеквизитТаблицаФактНаФорме(ЭтотОбъект);
	ДоговорыКонтрагентовФормыУХ.ОбновитьТаблицуГрафикРасчетов(ЭтотОбъект, Неопределено, ОписаниеГрафика);
	
	ДоговорыКонтрагентовФормыУХ.СоздатьЭлементыАналитикСтатейНаФорме(ЭтотОбъект);
	УправлениеФормой(ЭтотОбъект);                  
	ДоговорыКонтрагентовФормыУХКлиентСервер.УстановитьТекстНадписиПроизводственныеКалендари(ЭтотОбъект);
	УстановитьПараметрыВыбораРамочногоДоговора();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Результат = ДоговорыКонтрагентовФормыУХКлиент.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, ИсточникВыбора);
	Если Результат.Свойство("ОбновитьГрафикРасчетов") Тогда
		ОбновитьГрафикНаСервере();
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.УправлениеДоступом
    Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
        МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
        МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
       КонецЕсли;
    // Конец СтандартныеПодсистемы.УправлениеДоступом
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Оповестить("ВариантФинансирования", Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("ОбновлениеВариантаФинансирования", ПараметрыЗаписи, Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ТипПроцентнойСтавкиПриИзменении(Элемент)
	РассчитатьСуммыПроцентовНаСервере();
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВидФинансированияПриИзменении(Элемент)
	УправлениеФормой(ЭтотОбъект);
	Объект.Договор = ПредопределенноеЗначение("Справочник.ДоговорыКредитовИДепозитов.ПустаяСсылка");
	УстановитьПараметрыВыбораРамочногоДоговора();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	Объект		= Форма.Объект;
	Элементы	= Форма.Элементы;
	
	ФинансовыеИнструментыФормыКлиентСервер.УстановитьЗаголовкиГрафика(Форма, ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Кредит"), Неопределено, "ГрафикРасчетов");
	
	ЭтоТранш = Объект.ВидФинансирования  = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма")
			Или Объект.ВидФинансирования = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншКредитнойЛинии");
	Элементы.Договор.Видимость =  ЭтоТранш;	
	ЭтоНовыйКредит = Объект.ВидФинансирования = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.НовыйКредит");
			
	Элементы.ПериодичностьНачисленияПроцентов.Доступность 		= Объект.НачислениеПроцентовНаОтчетныеДаты;
	Элементы.ДатаОкончанияПервогоПроцентногоПериода.Видимость 	= (Объект.ДатаОтсчетаПроцентныхПериодов
						= ПредопределенноеЗначение("Перечисление.ВидыДатОтсчетаПериодичности.ДатаПервогоПогашения"));
	
	ЭтоФиксированнаяСтавка = (Объект.ТипПроцентнойСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная"));
	Элементы.ГруппаФиксированнаяСтавка.Видимость 	= ЭтоФиксированнаяСтавка;
	Элементы.ГруппаПлавающаяСтавка.Видимость 		= НЕ ЭтоФиксированнаяСтавка;
	
	Элементы.ГруппаФиксированнаяСтавкаСтавка.Видимость 				= НЕ Объект.РучноеУправлениеИзменениямиСтавки;
	
	Элементы.РедактироватьПроцентныеСтавкиФиксированная.Видимость 	= Объект.РучноеУправлениеИзменениямиСтавки;
	Элементы.РедактироватьПроцентныеСтавкиПлавающая.Видимость 		= Объект.РучноеУправлениеИзменениямиСтавки;
	
	Если Объект.РучноеУправлениеИзменениямиСтавки И Объект.ПроцентныеСтавки.Количество() Тогда
		
		ТекстСтавок = ФинансовыеИнструментыФормыКлиентСервер.ПредставлениеИсторииСтавок(Объект.ПроцентныеСтавки);
		Элементы.РедактироватьПроцентныеСтавкиФиксированная.Заголовок 	= ТекстСтавок;
		Элементы.РедактироватьПроцентныеСтавкиПлавающая.Заголовок 		= ТекстСтавок;
		
	КонецЕсли;

	Элементы.ГруппаПериодичностьПроцентов.Видимость = Объект.ВыплачиватьПроцентыПериодически;
	ОтображатьНачисления 	= Истина;
	ЭлементыФормыНачисление = Новый Массив;
	ЭлементыФормыНачисление.Добавить(Элементы.ГрафикРасчетовГруппаПроцентыНачислено);
	ЭлементыФормыНачисление.Добавить(Элементы.ГрафикРасчетовПроцентыОстаток);

	ФинансовыеИнструментыФормыКлиентСервер.УстановитьВидимостьЭлементов(ЭлементыФормыНачисление, ОтображатьНачисления);
	
	Элементы.Ковенанты.Видимость  = ЭтоНовыйКредит;  
	
	Элементы.РедактироватьПроцентныеСтавкиПлавающая.Видимость = Объект.РучноеУправлениеИзменениямиСтавки;
	
	Если Объект.РучноеУправлениеИзменениямиСтавки И Объект.ПроцентныеСтавки.Количество() Тогда
		
		ТекстСтавок = ФинансовыеИнструментыФормыКлиентСервер.ПредставлениеИсторииСтавок(Объект.ПроцентныеСтавки);
		Элементы.РедактироватьПроцентныеСтавкиФиксированная.Заголовок 	= ТекстСтавок;
		Элементы.РедактироватьПроцентныеСтавкиПлавающая.Заголовок 		= ТекстСтавок;
		
	КонецЕсли;  
	
	Элементы.ВидФинансирования.Видимость			= НЕ Объект.ПриобретениеФинансовыхУслуг;
    Элементы.ГруппаЗаявка.Видимость					= НЕ Объект.ПриобретениеФинансовыхУслуг;
		
КонецПроцедуры
 
&НаКлиенте
Процедура ПроцентнаяСтавкаПриИзменении(Элемент)
	РассчитатьСуммыПроцентовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТекстПроизводственныеКалендариНажатие(Элемент, СтандартнаяОбработка)

	ДоговорыКонтрагентовФормыУХКлиент.ИзменитьПроизводственныеКалендари(ЭтотОбъект, Элемент, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ОбщаяСуммаПриИзменении(Элемент)
	Объект.ГрафикРасчетов.Очистить();
	РассчитатьСуммыПроцентовНаСервере();
КонецПроцедуры

