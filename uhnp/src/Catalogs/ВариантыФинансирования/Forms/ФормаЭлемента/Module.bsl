&НаКлиенте
Процедура ГрафикРасчетовЛинейныйПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ПодключитьОбработчикОжидания("ПриОкончанииРедактированияДетализацииГрафика", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииРедактированияДетализацииГрафика()

	Если РедактированиеОсновногоДолга() Тогда
		ОбработатьИзменениеСекцииНаСервере(Объект.ГрафикРасчетов.Индекс(Элементы.ГрафикРасчетовЛинейный.ТекущиеДанные), "ОсновнойДолг");
	Иначе
		ОбработатьИзменениеСекцииНаСервере(Объект.ГрафикРасчетов.Индекс(Элементы.ГрафикРасчетовЛинейный.ТекущиеДанные), "Проценты");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ЗагрузитьГрафик(Команда)
	Данные = ДанныеДляЗагрузкиГрафикаСервер();
	ДоговорыКонтрагентовФормыУХКлиент.ОткрытьЗагрузкуГрафика(ЭтотОбъект, Данные);	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВесьГрафик(Команда)
	РассчитатьСуммыПроцентовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьГрафикОтТекущейДаты(Команда)
	РассчитатьСуммыПроцентовНаСервере(,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ГрафикРасчетовПриАктивизацииЯчейки(Элемент)
	Если Элемент.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Элемент.ТекущийЭлемент.Имя;
	ДоговорыКонтрагентовФормыУХКлиент.ПриАктивизацииЯчейкиГрафикаРасчетов(ЭтотОбъект, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьПроцентныеСтавки(Команда)

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИсходныеДанные", Объект);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НадписьРедактироватьПроцентныеСтавкиПродолжение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.РедактированиеГрафика.Форма.ФормаРедактированияПроцентныхСтавок", СтруктураПараметров, ЭтотОбъект,,,,ОписаниеОповещения);

КонецПроцедуры  

&НаКлиенте
Процедура НадписьРедактироватьПроцентныеСтавкиПродолжение(Результат, Параметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Результат) Тогда
		ЗагрузитьТаблицуПроцентныхСтавок(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПараметрыОпераций(Команда)
	ПараметрыКоманды = ДанныеОткрытияПараметровОперацийГрафика();			
	ДоговорыКонтрагентовФормыУХКлиент.ОткрытьПараметрыОперацийГрафика(ЭтотОбъект, ПараметрыКоманды);
КонецПроцедуры  

&НаСервере
Функция ДанныеОткрытияПараметровОперацийГрафика()	
		
	НастройкиОпераций = Объект.ПараметрыОпераций.Выгрузить();
	АдресНастроек = ПоместитьВоВременноеХранилище(НастройкиОпераций, УникальныйИдентификатор);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("АдресНастроек", АдресНастроек);
	ВариантОбъект 			= РеквизитФормыВЗначение("Объект");
	ГруппаОперацийГрафика 	= ВариантОбъект.ГруппаОперацийГрафика();	
	ПараметрыОткрытия.Вставить("ГруппаОперацийГрафика", ГруппаОперацийГрафика);
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", Ложь);
	
	Возврат ПараметрыОткрытия;
КонецФункции

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции                     

&НаСервере
Процедура УстановитьПараметрыВыбораРамочногоДоговора() 
	
	ЭлементРамочныйДоговор = Элементы.Договор;
	Если Объект.ВидФинансирования  = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма") Тогда
		ПараметрВидДоговора = Новый ПараметрВыбора("Отбор.ВидДоговораУХ", ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный"));
	Иначе
		ПараметрВидДоговора = Новый ПараметрВыбора("Отбор.ВидДоговораУХ", ПредопределенноеЗначение("Справочник.ВидыДоговоровКонтрагентовУХ.Кредит"));
	КонецЕсли;
	ОбщегоНазначенияКлиентСерверУХ.ЗаменитьУдалитьПараметрВыбора(ЭлементРамочныйДоговор,
			"Отбор.ВидДоговораУХ", ПараметрВидДоговора);
	ПараметрВидСоглашения = Новый ПараметрВыбора("Отбор.ВидСоглашения", ПредопределенноеЗначение("Перечисление.ВидыСоглашений.РамочныйДоговор"));
	ОбщегоНазначенияКлиентСерверУХ.ЗаменитьУдалитьПараметрВыбора(ЭлементРамочныйДоговор,
			"Отбор.ВидСоглашения", ПараметрВидСоглашения);
КонецПроцедуры                                                                                               
    
&НаКлиенте
Функция РедактированиеОсновногоДолга()
	
	Если ЗначениеЗаполнено(ЭлементСтруктурыЗадолженностиПриИзмененииДаты) Тогда  
		ЭлементСтруктурыЗадолженности = ЭлементСтруктурыЗадолженностиПриИзмененииДаты; 
		ЭлементСтруктурыЗадолженностиПриИзмененииДаты = Неопределено;
	Иначе
		ТекущиеДанные = Элементы.ГрафикРасчетовЛинейный.ТекущиеДанные;
		ЭлементСтруктурыЗадолженности = ТекущиеДанные.ЭлементСтруктурыЗадолженности;
	КонецЕсли;
	
	Возврат ЭлементСтруктурыЗадолженности = ПредопределенноеЗначение("Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг")
	
КонецФункции

&НаСервере
Процедура ОбработатьИзменениеСекцииНаСервере(ИндексСтроки, ИмяЭлемента);
	
	СтруктураДействий = Новый Структура;
	
	ИмяСекции = ФинансовыеИнструментыФормыКлиентСервер.ПолучитьИмяСекцииГрафикаПоИмениГруппы(ИмяЭлемента);
	
	СтруктураДействий.Вставить("Замкнуть", Новый Структура("СекцииГрафика", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИмяСекции)));
	Если ИмяСекции = "ОсновнойДолг" Тогда
			СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Проценты")));
	КонецЕсли;
	
	ОбъектЗначение =  ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.ВариантыФинансирования"));
	ФинансовыеИнструментыУХ.ПересчетГрафика(ОбъектЗначение, ИндексСтроки, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий);
	ЗначениеВДанныеФормы(ОбъектЗначение,Объект);
	ДоговорыКонтрагентовФормыУХ.ОбновитьТаблицуГрафикРасчетов(ЭтотОбъект, СтруктураДействий, ОписаниеГрафика);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГрафикНаСервере(Знач СтруктураДействий = Неопределено)
	РассчитатьСуммыПроцентовНаСервере(Ложь);
	ДоговорыКонтрагентовФормыУХ.ОбновитьТаблицуГрафикРасчетов(ЭтотОбъект, СтруктураДействий, ОписаниеГрафика);
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыПроцентовНаСервере(ОбновлятьГрафик = Истина, Отказ = Ложь)
	
	Если Объект.ГрафикРасчетов.Итог("Сумма") = 0 Тогда 
		ЗаполнитьОсновныеДвижения();
	КонецЕсли;
	
	СтруктураДействий 	= Новый Структура;
	Секции 				= Новый Массив;
	Если Не ФинансовыеИнструментыУХ.СтрокиСекцииГрафика(Объект.ГрафикРасчетов, ОписаниеГрафика["ОсновнойДолг"]).Количество() Тогда
		Секции.Добавить("ОсновнойДолг");
	КонецЕсли;
	Секции.Добавить("Проценты");
	
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));
	ОбъектЗначение =  ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.ВариантыФинансирования"));
	ФинансовыеИнструментыУХ.ПересчетГрафика(ОбъектЗначение, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий, Отказ);
	ЗначениеВДанныеФормы(ОбъектЗначение,Объект);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	
	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности, ОперацияГрафика",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты, Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено);
	СтрокиПроценты 	= Объект.ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	ИтогПроценты 	= 0;
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ИтогПроценты = ИтогПроценты + СтрокаПроценты.Сумма;	
	КонецЦикла;

	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты);
	СтрокиПроценты 	= Объект.ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПокрытиеПотребностиВФинансировании, "ЦФО, Проект");
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ЗаполнитьЗначенияСвойств(СтрокаПроценты, РеквизитыОснования);
	КонецЦикла;

	Объект.ОбщаяСуммаПроцентов = ИтогПроценты;
	
	Для каждого СтрокаГрафикРасчетов Из Объект.ГрафикРасчетов Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаГрафикРасчетов.Валюта) Тогда
			СтрокаГрафикРасчетов.Валюта = Объект.ВалютаДокумента;	
		КонецЕсли;  
		Если НЕ ЗначениеЗаполнено(СтрокаГрафикРасчетов.СчетОрганизации) Тогда
			СтрокаГрафикРасчетов.СчетОрганизации = Объект.БанковскийСчет;	
		КонецЕсли;
	КонецЦикла;

	Если ОбновлятьГрафик Тогда
		ОбновитьГрафикНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДанныеДляЗагрузкиГрафикаСервер()
	Возврат ДоговорыКонтрагентовФормыУХ.ДанныеДляЗагрузкиГрафика(ЭтотОбъект);
КонецФункции

&НаСервере
Процедура ЗаполнитьОсновныеДвижения()
	
		СтрокаПрихода 						= Объект.ГрафикРасчетов.Добавить();
		СтрокаПрихода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаПрихода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Приход;
		СтрокаПрихода.Дата					= Объект.ДатаНачалаДействия;
		СтрокаПрихода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение;
		СтрокаПрихода.Сумма					= Объект.ОбщаяСумма;
		СтрокаПрихода.Валюта				= Объект.ВалютаДокумента;
		СтрокаПрихода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаПрихода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПоступленияПоКредитамИЗаймам;
		СтрокаПрихода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Приход;
		
		СтрокаРасхода 						= ОБъект.ГрафикРасчетов.Добавить();
		СтрокаРасхода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаРасхода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Расход;
		СтрокаРасхода.Дата					= Объект.ДатаОкончанияДействия;
		СтрокаРасхода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат;
		СтрокаРасхода.Сумма					= Объект.ОбщаяСумма;
		СтрокаРасхода.Валюта				= Объект.ВалютаДокумента;
		СтрокаРасхода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаРасхода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПлатежПоКредитуИлиЗайму;
		СтрокаРасхода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Расход;
     
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТаблицуПроцентныхСтавок(АдресХранилища)
	
	Объект.ПроцентныеСтавки.Загрузить(ПолучитьИзВременногоХранилища(АдресХранилища));
	РассчитатьСуммыПроцентовНаСервере();
		
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьНастройкуОпераций(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		ЗагрузитьНастройкиОпераций(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиОпераций(Адрес)	
	
	ТаблицаНастроек = ПолучитьИзВременногоХранилища(Адрес);	

	Объект.ПараметрыОпераций.Загрузить(ТаблицаНастроек);
	Модифицированность = Истина;
	
	ОбновитьОперацииГрафикаПоПараметрамОперацийВерсии(Объект.ГрафикРасчетов, Объект.ПараметрыОпераций);

КонецПроцедуры  

&НаСервере
Процедура ОбновитьОперацииГрафикаПоПараметрамОперацийВерсии(ГрафикРасчетов, ПараметрыОпераций)
	
	Для каждого СтрокаГрафика Из ГрафикРасчетов Цикл
		
		СтрокиПараметров = ПараметрыОпераций.НайтиСтроки(
			Новый Структура("ОперацияГрафика", СтрокаГрафика.ОперацияГрафика));
			
		Если ЗначениеЗаполнено(СтрокиПараметров) Тогда
			 ЗаполнитьЗначенияСвойств(СтрокаГрафика, СтрокиПараметров[0]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СтатьяБюджета_ПриИзменении(Элемент)
	АналитикиСтатейБюджетовУХКлиент.ПриИзмененииСтатьиБюджета(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

#КонецОбласти
