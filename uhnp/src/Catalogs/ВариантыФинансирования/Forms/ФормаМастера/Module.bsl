   
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация 					= Параметры.Организация;
	ДатаНачалаДействия		 		= Параметры.ДатаНачалаДействия;
	ДатаОкончанияДействия			= Параметры.ДатаОкончанияДействия;
	ВидФинансирования				= Параметры.ВидФинансирования;   
	СуммаПроцентов					= Параметры.СуммаПроцентов;
	СуммаДокумента					= Параметры.СуммаДокумента;
	ВалютаДокумента					= Параметры.ВалютаДокумента;
	ДокументСсылка					= Параметры.ДокументСсылка;	
	
    ЗаполнитьТаблицуВарианты();

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура СоздатьВыбрать(Команда)
	НовыйВариант = СоздатьВыбратьНаСервере();
	Закрыть(НовыйВариант);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСоздание(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Перезаполнить(Команда)
	ЗаполнитьТаблицуВарианты();
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Функция СоздатьВыбратьНаСервере() 
	ВыбранныеВарианты = ТаблицаВариантов.НайтиСтроки(Новый Структура("Пометка", Истина));
	ВыбранТолькоОдинВариант  = Ложь;
	Если ВыбранныеВарианты.Количество() = 0 Тогда 
		Возврат Неопределено; 
	ИначеЕсли	ВыбранныеВарианты.Количество() = 1 Тогда 
		ВыбранТолькоОдинВариант  = Истина;		
	КонецЕсли;
	
	Для каждого СтрокаВариант Из ВыбранныеВарианты Цикл
		
		НовыйВариант = Справочники.ВариантыФинансирования.СоздатьЭлемент();
		НовыйВариант.ПокрытиеПотребностиВФинансировании	= ДокументСсылка;
		НовыйВариант.ТипПроцентнойСтавки    			= СтрокаВариант.ТипПроцентнойСтавки;
		Если НЕ ЗначениеЗаполнено(НовыйВариант.ТипПроцентнойСтавки) Тогда
			НовыйВариант.ТипПроцентнойСтавки = Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная;	
		КонецЕсли;                                                                                                  
		НовыйВариант.ПроцентнаяСтавка					= СтрокаВариант.ПроцентнаяСтавка;
		НовыйВариант.РучноеУправлениеИзменениямиСтавки	= СтрокаВариант.РучноеУправлениеИзменениямиСтавки;
		НовыйВариант.Организация						= Организация;
		НовыйВариант.ОбщаяСумма							= СуммаДокумента;
		НовыйВариант.ИндикативнаяСтавка					= СтрокаВариант.ИндикативнаяСтавка;      
		НовыйВариант.ПлавающаяСтавкаМинимум				= СтрокаВариант.ПлавающаяСтавкаМинимум;     
		НовыйВариант.ПлавающаяСтавкаМаксимум			= СтрокаВариант.ПлавающаяСтавкаМаксимум;    
		НовыйВариант.ДатаОкончанияПервогоПроцентногоПериода	= СтрокаВариант.ДатаОкончанияПервогоПроцентногоПериода;     
		НовыйВариант.ДатаОтсчетаПроцентныхПериодов		= СтрокаВариант.ДатаОтсчетаПроцентныхПериодов;    
		НовыйВариант.ПериодичностьУплатыПроцентов		= СтрокаВариант.ПериодичностьУплатыПроцентов; 
		НовыйВариант.ВыплачиватьПроцентыПериодически	= СтрокаВариант.ВыплачиватьПроцентыПериодически;
		НовыйВариант.БазаДляРасчетаПроцентов			= Справочники.СпособыРасчетаДнейПериодическихОпераций.ГодФактМесяцФакт;
		НовыйВариант.ВидДнейСдвигаУплаты 				= Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням;
		НовыйВариант.ТочкаОтсчетаДатыФиксацииСтавки   	= Перечисления.СпособыОпределенияДатыОперацииПоПериоду.НачалоПериода;
		НовыйВариант.НачислениеПроцентовНаКрайниеДаты	= Перечисления.СпособыНачисленияПроцентовНаГраницыПериодов.НачислятьПроцентыНаПоследнийДень;
		НовыйВариант.ДатаНачалаДействия					= ДатаНачалаДействия; 
		НовыйВариант.ДатаОкончанияДействия				= ДатаОкончанияДействия; 
		НовыйВариант.Контрагент							= СтрокаВариант.Контрагент; 
		НовыйВариант.Договор                            = СтрокаВариант.Договор;  
		НовыйВариант.ВалютаДокумента					= ВалютаДокумента;	
		Если ТипЗнч(СтрокаВариант.Договор) = Тип("ДокументСсылка.КредитныйЛимит") Тогда
			НовыйВариант.ВидФинансирования				= Перечисления.ВидыФинансирования.НовыйКредит;
			Наименование								= СтрШаблон(НСтр("ru='%1 %2'"),
															Строка(СтрокаВариант.Контрагент),
															Строка(НовыйВариант.ВидФинансирования));
		ИначеЕсли ТипЗнч(СтрокаВариант.Договор) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов") Тогда  
			ЗначенияРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаВариант.Договор, "ВидДоговораУХ, Наименование");
			Если  ЗначенияРеквизитовДоговора.ВидДоговораУХ = Справочники.ВидыДоговоровКонтрагентовУХ.Кредит Тогда 
		    	НовыйВариант.ВидФинансирования			= Перечисления.ВидыФинансирования.ТраншКредитнойЛинии;
			Иначе
				НовыйВариант.ВидФинансирования			= Перечисления.ВидыФинансирования.ТраншКредитнойЛинии;
			КонецЕсли;	
			Наименование								= СтрШаблон(НСтр("ru='%1 %2 %3'"),
															Строка(СтрокаВариант.Контрагент),
															Строка(НовыйВариант.ВидФинансирования),
															ЗначенияРеквизитовДоговора.Наименование);
		КонецЕсли;
		НовыйВариант.Наименование						= Наименование;
		РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьПроизводственныеКалендариПоУмолчанию(НовыйВариант.ПроизводственныеКалендари);
		
		СтрокаПрихода 						= НовыйВариант.ГрафикРасчетов.Добавить();
		СтрокаПрихода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаПрихода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Приход;
		СтрокаПрихода.Дата					= ДатаНачалаДействия;
		СтрокаПрихода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение;
		СтрокаПрихода.Сумма					= СуммаДокумента;
		СтрокаПрихода.Валюта				= ВалютаДокумента;
		СтрокаПрихода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаПрихода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПоступленияПоКредитамИЗаймам;
		СтрокаПрихода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Приход;
		
		СтрокаРасхода 						= НовыйВариант.ГрафикРасчетов.Добавить();
		СтрокаРасхода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаРасхода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Расход;
		СтрокаРасхода.Дата					= ДатаОкончанияДействия;
		СтрокаРасхода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат;
		СтрокаРасхода.Сумма					= СуммаДокумента;
		СтрокаРасхода.Валюта				= ВалютаДокумента;
		СтрокаРасхода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаРасхода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПлатежПоКредитуИлиЗайму;
		СтрокаРасхода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Расход;
		
		РассчитатьСуммыПроцентовНаСервере(НовыйВариант);
		
		Для каждого СтрокаГрафик Из НовыйВариант.ГрафикРасчетов Цикл
			СтрокаГрафик.Валюта				= ВалютаДокумента;                                                   
		КонецЦикла; 
		
		ГруппаОперацийГрафика = НовыйВариант.ГруппаОперацийГрафика();
		ТаблицаНастроек = РаботаСДоговорамиКонтрагентовУХ.ПараметрыОперацийГрафикаПоУмолчанию(ГруппаОперацийГрафика);
		НовыйВариант.ПараметрыОпераций.Загрузить(ТаблицаНастроек);

		НовыйВариант.Записать();
			
	КонецЦикла;
	
	Если ВыбранТолькоОдинВариант Тогда
		Возврат НовыйВариант.Ссылка;
	Иначе		
	    Возврат Неопределено;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура РассчитатьСуммыПроцентовНаСервере(Объект, Отказ = Ложь)
	
	Если Объект.ГрафикРасчетов.Итог("Сумма") = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ОписаниеГрафика 	= Справочники.ВариантыФинансирования.ОписаниеГрафика();
	ПереченьОпераций 	= РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, Объект, Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);
	ОперацииГрафика 	= Новый ФиксированноеСоответствие(ПереченьОпераций);
	СтруктураДействий 	= Новый Структура;
	Секции 				= Новый Массив;
	Если Не ФинансовыеИнструментыУХ.СтрокиСекцииГрафика(Объект.ГрафикРасчетов, ОписаниеГрафика["ОсновнойДолг"]).Количество() Тогда
		Секции.Добавить("ОсновнойДолг");
	КонецЕсли;
	Секции.Добавить("Проценты");
	
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));
	ФинансовыеИнструментыУХ.ПересчетГрафика(Объект, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий, Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(ЭтотОбъект);
	
	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности, ОперацияГрафика",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты, Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено);
	СтрокиПроценты 	= Объект.ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	ИтогПроценты 	= 0;
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ИтогПроценты = ИтогПроценты + СтрокаПроценты.Сумма;		
	КонецЦикла;
	Объект.ОбщаяСуммаПроцентов = ИтогПроценты;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВарианты()
	ТаблицаВариантов.Очистить();
	ЗаполнитьКредитныеЛимиты();
	ЗаполнитьВГЗРамочныеДоговора();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКредитныеЛимиты()

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКредитовИДепозитов.Ссылка КАК ПредметГрафика,
		|	ДоговорыКредитовИДепозитов.Контрагент КАК Контрагент,
		|	ДоговорыКредитовИДепозитов.ВидФинансовогоИнструмента КАК ВидФинансовогоИнструмента,
		|	ДоговорыКредитовИДепозитов.Организация КАК Организация,
		|	ДоговорыКредитовИДепозитов.СуммаТраншей КАК СуммаДоговора,
		|	ДоговорыКредитовИДепозитов.ВалютаВзаиморасчетов КАК ВалютаФинансовогоИнструмента
		|ПОМЕСТИТЬ втДоговоры
		|ИЗ
		|	Справочник.ДоговорыКредитовИДепозитов КАК ДоговорыКредитовИДепозитов
		|ГДЕ
		|	НЕ ДоговорыКредитовИДепозитов.ПометкаУдаления
		|	И ДоговорыКредитовИДепозитов.ДатаПервогоТранша <= &ДатаНачалаСрокаПривлечения
		|	И ДоговорыКредитовИДепозитов.ДатаПоследнегоПлатежа >= &ДатаОкончанияСрокаПривлечения
		|	И ДоговорыКредитовИДепозитов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
		|	И ДоговорыКредитовИДепозитов.ВидСоглашения <> ЗНАЧЕНИЕ(Перечисление.ВидыСоглашений.Спецификация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КредитныеЛимитыСрезПоследних.Контрагент КАК Контрагент,
		|	КредитныеЛимитыСрезПоследних.Лимит КАК КредитныйЛимит,
		|	КредитныйЛимитОрганизации.Организация КАК Организация,
		|	КредитныеЛимитыСрезПоследних.Регистратор.ВалютаДокумента КАК ВалютаЛимита,
		|	КредитныеЛимитыСрезПоследних.Регистратор.СуммаЛимита КАК СуммаЛимита,
		|	КредитныеЛимитыСрезПоследних.Регистратор.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		|ПОМЕСТИТЬ втЛимиты
		|ИЗ
		|	РегистрСведений.КредитныеЛимиты.СрезПоследних(&Период, ) КАК КредитныеЛимитыСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КредитныйЛимит.Организации КАК КредитныйЛимитОрганизации
		|		ПО КредитныеЛимитыСрезПоследних.Регистратор = КредитныйЛимитОрганизации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КредитныйЛимит.ВидыФинансовыхИнструментов КАК КредитныйЛимитВидыФинансовыхИнструментов
		|		ПО КредитныеЛимитыСрезПоследних.Регистратор = КредитныйЛимитВидыФинансовыхИнструментов.Ссылка
		|			И (КредитныйЛимитВидыФинансовыхИнструментов.ВидФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыФинансовыхИнструментов.КредитПолученный))
		|ГДЕ
		|	КредитныеЛимитыСрезПоследних.Использовать
		|	И КредитныеЛимитыСрезПоследних.Регистратор.ВалютаДокумента = &ВалютаВзаиморасчетов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	т.Валюта КАК Валюта,
		|	т.Курс КАК Курс,
		|	т.Кратность КАК Кратность
		|ПОМЕСТИТЬ втКурсы
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(
		|			,
		|			Валюта В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					втЛимиты.ВалютаЛимита
		|				ИЗ
		|					втЛимиты КАК втЛимиты)) КАК т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	втЛимиты.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(втЛимиты.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
		|	втЛимиты.ВалютаЛимита КАК ВалютаЛимита,
		|	втЛимиты.КредитныйЛимит КАК КредитныйЛимит,
		|	втЛимиты.СуммаЛимита КАК СуммаЛимита,
		|	втЛимиты.СуммаЛимита - СУММА(ВЫБОР
		|			КОГДА втЛимиты.ВалютаЛимита = втДоговоры.ВалютаФинансовогоИнструмента
		|				ТОГДА ЕСТЬNULL(втДоговоры.СуммаДоговора, 0)
		|			КОГДА ЕСТЬNULL(втКурсыОД.Кратность, 0) = 0
		|					ИЛИ ЕСТЬNULL(втКурсыЛимита.Курс, 0) = 0
		|				ТОГДА ЕСТЬNULL(втДоговоры.СуммаДоговора, 0)
		|			ИНАЧЕ ЕСТЬNULL(втДоговоры.СуммаДоговора, 0) * втКурсыОД.Курс * втКурсыЛимита.Кратность / втКурсыОД.Кратность / втКурсыЛимита.Курс
		|		КОНЕЦ) КАК СуммаДоговораВВалютеЛимита,
		|	СУММА(втДоговоры.СуммаДоговора) КАК СуммаДоговора,
		|	втЛимиты.КредитныйЛимит.ДатаНачала КАК ДатаНачалаДействияЛимита,
		|	втЛимиты.КредитныйЛимит.ДатаОкончания КАК ДатаОкончанияДействияЛимита,
		|	втЛимиты.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		|ПОМЕСТИТЬ втСоединение
		|ИЗ
		|	втЛимиты КАК втЛимиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДоговоры КАК втДоговоры
		|		ПО втЛимиты.Контрагент = втДоговоры.Контрагент
		|			И (ВЫБОР
		|				КОГДА втЛимиты.Организация ЕСТЬ NULL
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ втЛимиты.Организация = втДоговоры.Организация
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсыЛимита
		|		ПО (втЛимиты.ВалютаЛимита <> втДоговоры.ВалютаФинансовогоИнструмента)
		|			И втЛимиты.ВалютаЛимита = втКурсыЛимита.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсыОД
		|		ПО (втЛимиты.ВалютаЛимита <> втДоговоры.ВалютаФинансовогоИнструмента)
		|			И (втДоговоры.ВалютаФинансовогоИнструмента = втКурсыОД.Валюта)
		|
		|СГРУППИРОВАТЬ ПО
		|	втЛимиты.Контрагент,
		|	втЛимиты.ВалютаЛимита,
		|	втЛимиты.КредитныйЛимит,
		|	втЛимиты.СуммаЛимита,
		|	втЛимиты.КредитныйЛимит.ДатаНачала,
		|	втЛимиты.КредитныйЛимит.ДатаОкончания,
		|	втЛимиты.ПроцентнаяСтавка,
		|	ЕСТЬNULL(втЛимиты.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Организации.Ссылка) КАК КоличествоОрганизаций
		|ПОМЕСТИТЬ ВТ_Организации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка В(&Организация)
		|	И Организации.Ссылка <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСоединение.Контрагент КАК Контрагент,
		|	втСоединение.Организация КАК Организация,
		|	втСоединение.ВалютаЛимита КАК ВалютаЛимита,
		|	втСоединение.КредитныйЛимит КАК Договор,
		|	втСоединение.СуммаЛимита КАК СуммаЛимита,
		|	втСоединение.ДатаНачалаДействияЛимита КАК ДатаНачалаДействияЛимита,
		|	втСоединение.ДатаОкончанияДействияЛимита КАК ДатаОкончанияДействияЛимита,
		|	втСоединение.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	втСоединение.СуммаДоговораВВалютеЛимита КАК ОстатокЛимита
		|ИЗ
		|	втСоединение КАК втСоединение
		|ГДЕ
		|	втСоединение.Организация В(&Организация)
		|	И втСоединение.СуммаДоговораВВалютеЛимита >= &СуммаДокумента
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	втСоединение.Контрагент,
		|	втСоединение.Организация,
		|	втСоединение.ВалютаЛимита,
		|	втСоединение.КредитныйЛимит,
		|	втСоединение.СуммаЛимита,
		|	втСоединение.ДатаНачалаДействияЛимита,
		|	втСоединение.ДатаОкончанияДействияЛимита,
		|	втСоединение.ПроцентнаяСтавка,
		|	втСоединение.СуммаДоговораВВалютеЛимита
		|ИЗ
		|	втСоединение КАК втСоединение,
		|	ВТ_Организации КАК ВТ_Организации
		|ГДЕ
		|	втСоединение.СуммаДоговораВВалютеЛимита >= &СуммаДокумента
		|	И ВЫБОР
		|			КОГДА ВТ_Организации.КоличествоОрганизаций = 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ втСоединение.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("Период", 						ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СуммаДокумента", 				СуммаДокумента);
	Запрос.УстановитьПараметр("ДатаНачалаСрокаПривлечения", 	ДатаНачалаДействия);   
	Запрос.УстановитьПараметр("ДатаОкончанияСрокаПривлечения",	ДатаОкончанияДействия);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов",			ВалютаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НомерСтроки 	= 1;
	РазницаВДнях 	= (НачалоДня(ДатаОкончанияДействия) - НачалоДня(ДатаНачалаДействия)) / (60 * 60 * 24);

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТаблицаВариантов 				= ТаблицаВариантов.Добавить();
		СтрокаТаблицаВариантов.НомерСтроки 	= НомерСтроки;
		НомерСтроки 						= НомерСтроки + 1;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицаВариантов, ВыборкаДетальныеЗаписи);
		Если  ВыборкаДетальныеЗаписи.ПроцентнаяСтавка <> 0 Тогда
			СтрокаТаблицаВариантов.СуммаПроцентов = ПолучитьПроцентыЗаПериод(СуммаДокумента,
																	ВыборкаДетальныеЗаписи.ПроцентнаяСтавка, РазницаВДнях);
		КонецЕсли;   
		СтрокаТаблицаВариантов.ТипПроцентнойСтавки 		= Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная;
		СтрокаТаблицаВариантов.ПроцентнаяСтавкаСтрока 	= Строка(ВыборкаДетальныеЗаписи.ПроцентнаяСтавка) + " %";	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВГЗРамочныеДоговора()
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика КАК Договор,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаНачалаДоступности, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаДоступности,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаОкончанияДоступности, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияДоступности,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаНачалаДействия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаДействия,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ДатаОкончанияДействия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияДействия,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.Сумма, 0) КАК ОбщийЛимит,
		|	ЕСТЬNULL(ВерсииГрафиковРасчетовСрезПоследних.Регистратор.ВозобновляемыйЛимит, ЛОЖЬ) КАК ВозобновляемыйЛимит
		|ПОМЕСТИТЬ ВТПараметры
		|ИЗ
		|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(&ДатаОтбора, Организация = &Организация) КАК ВерсииГрафиковРасчетовСрезПоследних
		|ГДЕ
		|	ВерсииГрафиковРасчетовСрезПоследних.ПредметГрафика.ВидДоговораУХ В(&ВидДоговораУХ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛимитыРамочныхДоговоров.РамочныйДоговор КАК БазовыйДоговор,
		|	ЛимитыРамочныхДоговоров.СуммаЛимитаОборот КАК СуммаЛимита,
		|	ЛимитыРамочныхДоговоров.ИсполнениеГрафикОборот КАК ИтогоРасход
		|ПОМЕСТИТЬ ВТИсполнение
		|ИЗ
		|	РегистрНакопления.ЛимитыРамочныхДоговоровКредитовЗаймов.Обороты(
		|			,
		|			&ДатаОтбора,
		|			,
		|			Организация = &Организация
		|				И РамочныйДоговор В
		|					(ВЫБРАТЬ
		|						ВТПараметры.Договор
		|					ИЗ
		|						ВТПараметры)) КАК ЛимитыРамочныхДоговоров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Организация КАК Организация,
		|	ВТПараметры.Договор КАК Договор,
		|	ВТПараметры.Договор.ВерсияСоглашения.ТипПроцентнойСтавки КАК ТипПроцентнойСтавки,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ПроцентнаяСтавка, 0) КАК ПроцентнаяСтавка,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.РучноеУправлениеИзменениямиСтавки, ЛОЖЬ) КАК РучноеУправлениеИзменениямиСтавки,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ИндикативнаяСтавка, НЕОПРЕДЕЛЕНО) КАК ИндикативнаяСтавка,
		|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ИндикативнаяСтавка, НЕОПРЕДЕЛЕНО)) КАК ИндикативнаяСтавкаПредставление,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ПлавающаяСтавкаМаксимум, 0) КАК ПлавающаяСтавкаМаксимум,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ПлавающаяСтавкаМинимум, 0) КАК ПлавающаяСтавкаМинимум,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ДатаОтсчетаПроцентныхПериодов, НЕОПРЕДЕЛЕНО) КАК ДатаОтсчетаПроцентныхПериодов,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ДатаОкончанияПервогоПроцентногоПериода, НЕОПРЕДЕЛЕНО) КАК ДатаОкончанияПервогоПроцентногоПериода,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ПериодичностьУплатыПроцентов, НЕОПРЕДЕЛЕНО) КАК ПериодичностьУплатыПроцентов,
		|	ЕСТЬNULL(ВТПараметры.Договор.ВерсияСоглашения.ВыплачиватьПроцентыПериодически, ЛОЖЬ) КАК ВыплачиватьПроцентыПериодически,
		|	ВТПараметры.ДатаНачалаДоступности КАК ДатаНачалаДоступности,
		|	ВТПараметры.ДатаОкончанияДоступности КАК ДатаОкончанияДоступности,
		|	ВТПараметры.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ВТПараметры.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	ВТПараметры.ОбщийЛимит КАК ОбщийЛимит,
		|	ВТПараметры.ВозобновляемыйЛимит КАК ВозобновляемыйЛимит,
		|	ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0) КАК ИтогоРасход,
		|	ВЫБОР
		|		КОГДА ВТПараметры.ВозобновляемыйЛимит
		|			ТОГДА ЕСТЬNULL(ВТИсполнение.СуммаЛимита, 0)
		|		ИНАЧЕ ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0)
		|	КОНЕЦ КАК ОстатокЛимита,
		|	ВТПараметры.Договор.Владелец КАК Контрагент
		|ИЗ
		|	ВТПараметры КАК ВТПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИсполнение КАК ВТИсполнение
		|		ПО ВТПараметры.Договор = ВТИсполнение.БазовыйДоговор
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ВТПараметры.ВозобновляемыйЛимит
		|				ТОГДА ЕСТЬNULL(ВТИсполнение.СуммаЛимита, 0)
		|			ИНАЧЕ ВТПараметры.ОбщийЛимит - ЕСТЬNULL(ВТИсполнение.ИтогоРасход, 0)
		|		КОНЕЦ >= &СуммаДокумента
		|	И ВТПараметры.ДатаНачалаДействия <= &ДатаНачалаДействия
		|	И ВТПараметры.ДатаОкончанияДействия >= &ДатаОкончанияДействия";
	
	Запрос.УстановитьПараметр("ДатаОтбора", 			ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", 			Организация);   
	Запрос.УстановитьПараметр("ДатаНачалаДействия", 	ДатаНачалаДействия); 
	Запрос.УстановитьПараметр("ДатаОкончанияДействия", 	ДатаОкончанияДействия); 
	Запрос.УстановитьПараметр("СуммаДокумента", 		СуммаДокумента);
	МассивВидовДоговоров = Новый Массив;
	МассивВидовДоговоров.Добавить(Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);
	МассивВидовДоговоров.Добавить(Справочники.ВидыДоговоровКонтрагентовУХ.ЗаемПолученный);
	Запрос.УстановитьПараметр("ВидДоговораУХ", 			МассивВидовДоговоров);
	
	РезультатЗапроса 		= Запрос.Выполнить();
	ВыборкаДетальныеЗаписи 	= РезультатЗапроса.Выбрать();
	
	НомерСтроки 	= ТаблицаВариантов.Количество() + 1;
	РазницаВДнях 	= (НачалоДня(ДатаОкончанияДействия) - НачалоДня(ДатаНачалаДействия)) / (60 * 60 * 24);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокаТаблицаВариантов = ТаблицаВариантов.Добавить();
		СтрокаТаблицаВариантов.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицаВариантов, ВыборкаДетальныеЗаписи);
		Если  ВыборкаДетальныеЗаписи.ПроцентнаяСтавка <> 0 Тогда  
			ДопПроцент = 0;
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИндикативнаяСтавка) Тогда
				ДопПроцент = РегистрыСведений.ЗначенияКотировокФИ.ПолучитьКотировку(ВыборкаДетальныеЗаписи.ИндикативнаяСтавка);		
			КонецЕсли;
			СтрокаТаблицаВариантов.СуммаПроцентов = ПолучитьПроцентыЗаПериод(СуммаДокумента,
						ВыборкаДетальныеЗаписи.ПроцентнаяСтавка+ДопПроцент, РазницаВДнях);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИндикативнаяСтавка)
				И	ВыборкаДетальныеЗаписи.ТипПроцентнойСтавки <> Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная Тогда
			ПроцентнаяСтавкаСтрока = СтрШаблон(НСтр("ru='%1 + %2 %3'"), ВыборкаДетальныеЗаписи.ИндикативнаяСтавкаПредставление, ВыборкаДетальныеЗаписи.ПроцентнаяСтавка,"%");
			СтрокаТаблицаВариантов.ПроцентнаяСтавкаСтрока = ПроцентнаяСтавкаСтрока;
		Иначе
			СтрокаТаблицаВариантов.ПроцентнаяСтавкаСтрока = Строка(ВыборкаДетальныеЗаписи.ПроцентнаяСтавка) + " %";			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПроцентыЗаПериод(ДенежныйПоток, Процент, ЧислоДнейНачисления)
	Возврат ДенежныйПоток * (Pow(1 + Процент, ЧислоДнейНачисления / 365) - 1);
КонецФункции

#КонецОбласти
