
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс 
// Возвращает структуру параметров для расчета секций графика расчетов
//
Функция ПараметрыРасчетаСекции(ИмяСекции, ОписаниеГрафика) Экспорт
	
	Результат = ФинансоваяМатематикаКлиентСервер.СтруктураПараметровРасчетаПроцентов();
	
	Если ИмяСекции = "Проценты" Тогда
		Результат.ДатаНачала 		= ДатаНачалаДействия;
		Результат.ДатаОкончания 	= ДатаОкончанияДействия;
		Результат.ПравилоПереноса 	= ПереносДатСНерабочихДней;
		Результат.ИзменятьПроцентныйПериод 			= ИзменяетсяДлительностьПроцентногоПериодаПриПереносе;
		Результат.ПроизводственныйКалендарь 		= ПроизводственныеКалендари.ВыгрузитьКолонку("ПроизводственныйКалендарь");
		Результат.ПериодичностьУплаты 				= ПериодичностьУплатыПроцентов;
		Результат.ПериодичностьНачисленияПроцентов 	= ?(НачислениеПроцентовНаОтчетныеДаты, 
															ПериодичностьНачисленияПроцентов, 
															Перечисления.Периодичность.ПустаяСсылка());
		Результат.ДатаОтсчетаПроцентныхПериодов 	= ДатаОтсчетаПроцентныхПериодов;
		Результат.ДатаНачалаДействия 				= ДатаНачалаДействия;
		Результат.ДатаПервогоПогашения 				= ДатаОкончанияПервогоПроцентногоПериода;
		Результат.ТочкаОтсчетаСдвигаДатыУплаты 		= ТочкаОтсчетаСдвигаДатыУплаты;
		Результат.СдвигДатыУплаты 					= СдвигДатыУплатыПроцентов;
		Результат.ВидДнейСдвигаУплаты 				= ВидДнейСдвигаУплаты;
		Результат.ТипПроцентнойСтавки 				= ТипПроцентнойСтавки;
		Результат.ТочкаОтсчетаДатыФиксацииСтавки 	= ТочкаОтсчетаДатыФиксацииСтавки;
		Результат.СдвигДатыФиксацииСтавки 			= СдвигДатыФиксацииСтавки;
		Результат.ПроцентнаяСтавка 					= ПроцентнаяСтавка;
		Результат.ИндикативнаяСтавка 				= ИндикативнаяСтавка;
		Результат.ПлавающаяСтавкаМинимум 			= ПлавающаяСтавкаМинимум;
		Результат.ПлавающаяСтавкаМаксимум 			= ПлавающаяСтавкаМаксимум;
		Результат.РучноеУправлениеИзменениямиСтавки = РучноеУправлениеИзменениямиСтавки;
		Результат.ПроцентныеСтавки 					= ПроцентныеСтавки.Выгрузить();
		Результат.ВыплачиватьПроцентыПериодически 	= ВыплачиватьПроцентыПериодически;
		Результат.ВыплачиватьПроцентыВДатыПогашенияТела = ВыплачиватьПроцентыВДатыПогашенияТела;
		Результат.НачислениеПроцентовНаКрайниеДаты 		= НачислениеПроцентовНаКрайниеДаты;
		Результат.ОперацииИзмененияБазы 				= ФинансовыеИнструментыУХ.ТаблицаИзмененияБазыИзГрафика(ГрафикРасчетов, ОписаниеГрафика);
		Результат.ДатаПервойВыборки 					= ?(Результат.ОперацииИзмененияБазы.Количество(), Результат.ОперацииИзмененияБазы[0].Дата, ДатаНачалаДействия);
		Результат.БазаДляРасчетаПроцентов 				= БазаДляРасчетаПроцентов;
		Результат.ГраницаФактическихДанных 				= ГраницаФактическихДанных;
		
		// Проанализируем график в части факта.
		Результат.ДатаПоследнегоНачисления 		= ФинансовыеИнструментыУХ.ДатаПоследнегоНачисленияСекцииГрафика(ГрафикРасчетов, ОписаниеГрафика["Проценты"], ГраницаФактическихДанных);		
		Результат.СуммаНакопленнойЗадолженности = ФинансовыеИнструментыУХ.ОстатокЗадолженностиСекцииГрафика(ГрафикРасчетов, ОписаниеГрафика["Проценты"], ГраницаФактическихДанных);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет расчет и заполняет секцию графика расчетов 
//
Процедура ПересчитатьСекциюГрафика(ИмяСекции, ОписаниеГрафика, ОперацииГрафика, ДопПараметры, Отказ = Ложь) Экспорт
	
	Если ИмяСекции = "ОсновнойДолг" Тогда
		ФинансовыеИнструментыУХ.НачальноеЗаполнениеОсновногоДолга(ЭтотОбъект, ИмяСекции, ОписаниеГрафика, ОперацииГрафика, 0);
	ИначеЕсли ИмяСекции = "Проценты" Тогда
		ФинансовыеИнструментыУХ.ПересчитатьСекциюГрафика(ЭтотОбъект, ИмяСекции, ОписаниеГрафика, ОперацииГрафика, ДопПараметры, Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если НЕ НачислениеПроцентовНаОтчетныеДаты Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ПериодичностьНачисленияПроцентов");	
	КонецЕсли;
	
	ЭтоТранш = ВидФинансирования  = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншВнутригрупповогоЗайма")
			Или ВидФинансирования = ПредопределенноеЗначение("Перечисление.ВидыФинансирования.ТраншКредитнойЛинии");
	Если НЕ ЭтоТранш Тогда 
		МассивНепроверяемыхРеквизитов.Добавить("Договор");
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
	КонецЕсли;			
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")  Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		БазаДляРасчетаПроцентов				= Справочники.СпособыРасчетаДнейПериодическихОпераций.ГодФактМесяцФакт;
		ВидДнейСдвигаУплаты 				= Перечисления.СпособыРасчетаКоличестваДнейВПериоде.ПоКалендарнымДням;
		ТочкаОтсчетаДатыФиксацииСтавки   	= Перечисления.СпособыОпределенияДатыОперацииПоПериоду.НачалоПериода;
		НачислениеПроцентовНаКрайниеДаты	= Перечисления.СпособыНачисленияПроцентовНаГраницыПериодов.НачислятьПроцентыНаПоследнийДень;
		
		Если ДанныеЗаполнения.Свойство("Лот") 
			И ДанныеЗаполнения.Свойство("Поставщик") Тогда
			ЗаполнитьПоЛоту(ДанныеЗаполнения.Лот, ДанныеЗаполнения.Поставщик)
		КонецЕсли;
		
	КонецЕсли;     
	
	// заполним параметры операций
	ТаблицаНастроек = РаботаСДоговорамиКонтрагентовУХ.ПараметрыОперацийГрафикаПоУмолчанию(ГруппаОперацийГрафика());
	ПараметрыОпераций.Загрузить(ТаблицаНастроек);

	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Функция ГруппаОперацийГрафика() Экспорт

	МассивГрупп = Новый Массив;  
	Если ВидФинансирования = Перечисления.ВидыФинансирования.НовыйВнутригрупповойЗаем 
		ИЛИ ВидФинансирования = Перечисления.ВидыФинансирования.ТраншВнутригрупповогоЗайма
		Тогда
		МассивГрупп.Добавить(Справочники.ОперацииГрафиковДоговоров.ЗаемПолученный);  
	Иначе
		МассивГрупп.Добавить(Справочники.ОперацииГрафиковДоговоров.КредитПолученный);  
	КонецЕсли;
 	
	Возврат МассивГрупп;
	
КонецФункции

Процедура ЗаполнитьПоЛоту(ДокументЛоты, КонтрагентПоставщик)
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ПроцентнаяСтавка");
	СтруктураРеквизитов.Вставить("ВалютаДокумента");
	СтруктураРеквизитов.Вставить("ДатаНачалаДействия",		"ДатаПривлечения");
	СтруктураРеквизитов.Вставить("ДатаОкончанияДействия",	"ДатаВозврата"); 
	СтруктураРеквизитов.Вставить("ОбщаяСумма",				"СуммаПривлечения"); 
	СтруктураРеквизитов.Вставить("ПериодичностьНачисленияПроцентов",	"ПроцентныйПериод"); 
	СтруктураРеквизитов.Вставить("ПериодичностьУплатыПроцентов",		"ПроцентныйПериод"); 
	СтруктураРеквизитов.Вставить("Организация",							"ЗакупочнаяПроцедура.ОрганизацияДляЗаключенияДоговора");
		
	РеквизитыЛота = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЛоты, СтруктураРеквизитов); 
  	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыЛота); 
	ВидФинансирования		= Перечисления.ВидыФинансирования.НовыйКредит;
	Контрагент				= КонтрагентПоставщик;
	ПриобретениеФинансовыхУслуг		= Истина;
	ВыплачиватьПроцентыПериодически = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛотыГрафикУплатыПроцентов.Дата КАК Дата,
		|	ЛотыГрафикУплатыПроцентов.Сумма КАК Сумма,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ВалютаДокумента КАК Валюта,
		|	ЛотыГрафикУплатыПроцентов.Заявка.СтатьяДвиженияДенежныхСредств КАК СтатьяБюджета,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика1 КАК Аналитика1,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика2 КАК Аналитика2,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика3 КАК Аналитика3,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика4 КАК Аналитика4,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика5 КАК Аналитика5,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика6 КАК Аналитика6,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Организация КАК Организация,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ЦФО КАК ЦФО,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Проект КАК Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено) КАК ОперацияГрафика,
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты) КАК ЭлементСтруктурыЗадолженности,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК НаправлениеДвижения,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход) КАК КолонкаСекции
		|ИЗ
		|	Документ.Лот.ГрафикУплатыПроцентов КАК ЛотыГрафикУплатыПроцентов
		|ГДЕ
		|	ЛотыГрафикУплатыПроцентов.Ссылка = &ДокументЛоты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛотыГрафикУплатыПроцентов.Дата,
		|	ЛотыГрафикУплатыПроцентов.Сумма,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ВалютаДокумента,
		|	ЛотыГрафикУплатыПроцентов.Заявка.СтатьяДвиженияДенежныхСредств,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика1,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика2,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика3,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика4,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика5,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика6,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Организация,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ЦФО,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыУплачено),
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты),
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
		|ИЗ
		|	Документ.Лот.ГрафикУплатыПроцентов КАК ЛотыГрафикУплатыПроцентов
		|ГДЕ
		|	ЛотыГрафикУплатыПроцентов.Ссылка = &ДокументЛоты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Заявки.Ссылка.ДатаПривлечения,
		|	Заявки.Сумма,
		|	Заявки.Валюта,
		|	Заявки.СтатьяДвиженияДенежныхСредствОсновнойДолг,
		|	Заявки.АналитикаОсновнойДолг1,
		|	Заявки.АналитикаОсновнойДолг2,
		|	Заявки.АналитикаОсновнойДолг3,
		|	Заявки.АналитикаОсновнойДолг4,
		|	Заявки.АналитикаОсновнойДолг5,
		|	Заявки.АналитикаОсновнойДолг6,
		|	Заявки.Организация,
		|	Заявки.ЦФО,
		|	Заявки.Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение),
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
		|ИЗ
		|	Документ.Лот.ЗаявкиНаПривлечениеФинансирования КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка = &ДокументЛоты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Заявки.Ссылка.ДатаВозврата,
		|	Заявки.Сумма,
		|	Заявки.Валюта,
		|	Заявки.СтатьяДвиженияДенежныхСредствОсновнойДолг,
		|	Заявки.АналитикаОсновнойДолг1,
		|	Заявки.АналитикаОсновнойДолг2,
		|	Заявки.АналитикаОсновнойДолг3,
		|	Заявки.АналитикаОсновнойДолг4,
		|	Заявки.АналитикаОсновнойДолг5,
		|	Заявки.АналитикаОсновнойДолг6,
		|	Заявки.Организация,
		|	Заявки.ЦФО,
		|	Заявки.Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат),
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
		|ИЗ
		|	Документ.Лот.ЗаявкиНаПривлечениеФинансирования КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка = &ДокументЛоты"; 
	
	
	Запрос.УстановитьПараметр("ДокументЛоты", ДокументЛоты);   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаГрафика = ГрафикРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаГрафика,ВыборкаДетальныеЗаписи); 
	КонецЦикла;    
	
	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности, ОперацияГрафика",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты, Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено);
	СтрокиПроценты 	= ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	ИтогПроценты 	= 0;
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ИтогПроценты = ИтогПроценты + СтрокаПроценты.Сумма;	
	КонецЦикла;
	ОбщаяСуммаПроцентов = ИтогПроценты;
  
