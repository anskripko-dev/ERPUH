
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс
// Возвращает заполненную структура описания графика
//
Функция ОписаниеГрафика() Экспорт

	Результат 	= Новый Структура;
	СекцияТело 	= ФинансовыеИнструментыФормыКлиентСервер.ОписаниеСекцииГрафика();
	СекцияТело.Имя 				= "ОсновнойДолг";
	СекцияТело.Представление 	= НСтр("ru = 'Основной долг'");
	СекцияТело.КолонкаПриход 	= "ОсновнойДолгПолучение";
	СекцияТело.КолонкаРасход 	= "ОсновнойДолгВозврат";
	СекцияТело.КолонкаОстаток 	= "ОсновнойДолгОстаток";
	СекцияТело.КолонкаПриходПредставление 		= НСтр("ru = 'Получение'");
	СекцияТело.КолонкаРасходПредставление 		= НСтр("ru = 'Возврат'");
	СекцияТело.КолонкаОстатокПредставление 		= НСтр("ru = 'Остаток'");
	СекцияТело.ЭлементСтруктурыЗадолженности 	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
			
	СекцияПроценты = ФинансовыеИнструментыФормыКлиентСервер.ОписаниеСекцииГрафика();
	СекцияПроценты.Имя 				= "Проценты";
	СекцияПроценты.Представление 	= НСтр("ru = 'Проценты'");
	СекцияПроценты.КолонкаПриход 	= "ПроцентыНачислено";
	СекцияПроценты.КолонкаРасход 	= "ПроцентыУплачено";
	СекцияПроценты.КолонкаПриходКорректировка 	= "ПроцентыНачисленоКорректировка";
	СекцияПроценты.КолонкаРасходКорректировка 	= "ПроцентыУплаченоКорректировка";
	СекцияПроценты.КолонкаОстаток 				= "ПроцентыОстаток";
	СекцияПроценты.КолонкаПриходПредставление 	= НСтр("ru = 'Начисление'");
	СекцияПроценты.КолонкаРасходПредставление 	= НСтр("ru = 'Уплата'");
	СекцияПроценты.КолонкаОстатокПредставление 	= НСтр("ru = 'Остаток'");
	СекцияПроценты.ЭлементСтруктурыЗадолженности 	= Перечисления.ЭлементыСтруктурыЗадолженности.Проценты;
	СекцияПроценты.ЭтоРасчетнаяСекция 				= Истина;
	
	Результат.Вставить(СекцияТело.Имя,        СекцияТело);
	Результат.Вставить(СекцияПроценты.Имя,    СекцияПроценты);
	
	// Заполним операции
	РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьОперацииВОписанииГрафика(Результат,
									Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);

	Возврат Результат;
	
КонецФункции

// Дополняет перечень операций по описанию графика
//
Процедура ДополнитьПереченьОперацийГрафиков(ОперацииГрафика, ОписаниеГрафика, ДокументОбъект) Экспорт
	
	РаботаСДоговорамиКонтрагентовУХ.ДополнитьПереченьОперацийГрафиков(ОперацииГрафика, ОписаниеГрафика, ДокументОбъект);
	
КонецПроцедуры 

Функция ПерезаполнитьВариантФинансированияПоЛоту(ДокументЛот, ВариантФинансирования, Контрагент) Экспорт
	
	Если ВариантФинансирования = Неопределено  Тогда
		ВариантФинансированияОбъект = Справочники.ВариантыФинансирования.СоздатьЭлемент();	
	Иначе
		ВариантФинансированияОбъект = ВариантФинансирования.ПолучитьОбъект();
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ПроцентнаяСтавка");
	СтруктураРеквизитов.Вставить("ВалютаДокумента");
	СтруктураРеквизитов.Вставить("ДатаНачалаДействия",		"ДатаПривлечения");
	СтруктураРеквизитов.Вставить("ДатаОкончанияДействия",	"ДатаВозврата"); 
	СтруктураРеквизитов.Вставить("ОбщаяСумма",				"СуммаПривлечения"); 
	СтруктураРеквизитов.Вставить("ПериодичностьНачисленияПроцентов",	"ПроцентныйПериод"); 
	СтруктураРеквизитов.Вставить("ПериодичностьУплатыПроцентов",	"ПроцентныйПериод");
		
	РеквизитыЛота = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЛот, СтруктураРеквизитов); 
  	ЗаполнитьЗначенияСвойств(ВариантФинансированияОбъект, РеквизитыЛота); 
	ВариантФинансированияОбъект.ВидФинансирования		= Перечисления.ВидыФинансирования.НовыйКредит;
	ВариантФинансированияОбъект.Контрагент				= Контрагент;
	ВариантФинансированияОбъект.ПриобретениеФинансовыхУслуг		= Истина;
	ВариантФинансированияОбъект.ВыплачиватьПроцентыПериодически = Истина; 
	ВариантФинансированияОбъект.РучноеУправлениеИзменениямиСтавки = Ложь;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛотыГрафикУплатыПроцентов.Дата КАК Дата,
		|	ЛотыГрафикУплатыПроцентов.Сумма КАК Сумма,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ВалютаДокумента КАК Валюта,
		|	ЛотыГрафикУплатыПроцентов.Заявка.СтатьяДвиженияДенежныхСредств КАК СтатьяБюджета,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика1 КАК Аналитика1,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика2 КАК Аналитика2,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика3 КАК Аналитика3,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика4 КАК Аналитика4,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика5 КАК Аналитика5,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Аналитика6 КАК Аналитика6,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Организация КАК Организация,
		|	ЛотыГрафикУплатыПроцентов.Заявка.ЦФО КАК ЦФО,
		|	ЛотыГрафикУплатыПроцентов.Заявка.Проект КАК Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено) КАК ОперацияГрафика,
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.Проценты) КАК ЭлементСтруктурыЗадолженности,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК НаправлениеДвижения,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход) КАК КолонкаСекции
		|ИЗ
		|	Документ.Лот.ГрафикУплатыПроцентов КАК ЛотыГрафикУплатыПроцентов
		|ГДЕ
		|	ЛотыГрафикУплатыПроцентов.Ссылка = &ДокументЛоты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Заявки.Ссылка.ДатаПривлечения,
		|	Заявки.Сумма,
		|	Заявки.Валюта,
		|	Заявки.СтатьяДвиженияДенежныхСредствОсновнойДолг,
		|	Заявки.АналитикаОсновнойДолг1,
		|	Заявки.АналитикаОсновнойДолг2,
		|	Заявки.АналитикаОсновнойДолг3,
		|	Заявки.АналитикаОсновнойДолг4,
		|	Заявки.АналитикаОсновнойДолг5,
		|	Заявки.АналитикаОсновнойДолг6,
		|	Заявки.Организация,
		|	Заявки.ЦФО,
		|	Заявки.Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение),
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)
		|ИЗ
		|	Документ.Лот.ЗаявкиНаПривлечениеФинансирования КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка = &ДокументЛоты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Заявки.Ссылка.ДатаВозврата,
		|	Заявки.Сумма,
		|	Заявки.Валюта,
		|	Заявки.СтатьяДвиженияДенежныхСредствОсновнойДолг,
		|	Заявки.АналитикаОсновнойДолг1,
		|	Заявки.АналитикаОсновнойДолг2,
		|	Заявки.АналитикаОсновнойДолг3,
		|	Заявки.АналитикаОсновнойДолг4,
		|	Заявки.АналитикаОсновнойДолг5,
		|	Заявки.АналитикаОсновнойДолг6,
		|	Заявки.Организация,
		|	Заявки.ЦФО,
		|	Заявки.Проект,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат),
		|	ЗНАЧЕНИЕ(Перечисление.ЭлементыСтруктурыЗадолженности.ОсновнойДолг),
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
		|ИЗ
		|	Документ.Лот.ЗаявкиНаПривлечениеФинансирования КАК Заявки
		|ГДЕ
		|	Заявки.Ссылка = &ДокументЛоты"; 
	
	
	Запрос.УстановитьПараметр("ДокументЛоты", ДокументЛот);   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВариантФинансированияОбъект.ГрафикРасчетов.Очистить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаГрафика = ВариантФинансированияОбъект.ГрафикРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаГрафика,ВыборкаДетальныеЗаписи); 
	КонецЦикла;    
	
	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности, ОперацияГрафика",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты, Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено);
	СтрокиПроценты 	= ВариантФинансированияОбъект.ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	ИтогПроценты 	= 0;
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ИтогПроценты = ИтогПроценты + СтрокаПроценты.Сумма;	
	КонецЦикла;
	ВариантФинансированияОбъект.ОбщаяСуммаПроцентов = ИтогПроценты;
	
	ВариантФинансированияОбъект.Записать();
	
	Возврат ВариантФинансированияОбъект.Ссылка;
	
КонецФункции

Функция СоздатьВариантФинансированияПокрытия(ДокументПокрытия, СтруктураЗаполнения, НаименованиеДоговора) Экспорт

		НовыйВариант = Справочники.ВариантыФинансирования.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовыйВариант, СтруктураЗаполнения);
		НовыйВариант.ПокрытиеПотребностиВФинансировании	= ДокументПокрытия;
		НовыйВариант.ТипПроцентнойСтавки    			= Перечисления.ТипыСтавокДляРасчетаПериодическихОпераций.Фиксированная;
		НовыйВариант.ОбщаяСумма							= СтруктураЗаполнения.Сумма;
	 	НовыйВариант.ВидФинансирования					= Перечисления.ВидыФинансирования.НовыйКредит;
  		НовыйВариант.Наименование						= НаименованиеДоговора;
		РаботаСДоговорамиКонтрагентовУХ.ЗаполнитьПроизводственныеКалендариПоУмолчанию(НовыйВариант.ПроизводственныеКалендари);
		
		ГруппаОперацийГрафика = НовыйВариант.ГруппаОперацийГрафика();
		ТаблицаНастроек = РаботаСДоговорамиКонтрагентовУХ.ПараметрыОперацийГрафикаПоУмолчанию(ГруппаОперацийГрафика);
		НовыйВариант.ПараметрыОпераций.Загрузить(ТаблицаНастроек);

		СтрокаПрихода 						= НовыйВариант.ГрафикРасчетов.Добавить();
		СтрокаПрихода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаПрихода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Приход;
		СтрокаПрихода.Дата					= СтруктураЗаполнения.ДатаНачалаДействия;
		СтрокаПрихода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгПолучение;
		СтрокаПрихода.Сумма					= СтруктураЗаполнения.Сумма;
		СтрокаПрихода.Валюта				= СтруктураЗаполнения.ВалютаДокумента;
		СтрокаПрихода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаПрихода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПоступленияПоКредитамИЗаймам;
		СтрокаПрихода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Приход;
				
		СтрокаРасхода 						= НовыйВариант.ГрафикРасчетов.Добавить();
		СтрокаРасхода.ВидБюджета			= ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
		СтрокаРасхода.НаправлениеДвижения 	= Перечисления.ВидыДвиженийПриходРасход.Расход;
		СтрокаРасхода.Дата					= СтруктураЗаполнения.ДатаОкончанияДействия;
		СтрокаРасхода.ОперацияГрафика		= Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ОсновнойДолгВозврат;
		СтрокаРасхода.Сумма					= СтруктураЗаполнения.Сумма;
		СтрокаРасхода.Валюта				= СтруктураЗаполнения.ВалютаДокумента;
		СтрокаРасхода.ЭлементСтруктурыЗадолженности	= Перечисления.ЭлементыСтруктурыЗадолженности.ОсновнойДолг;
		СтрокаРасхода.ВидОперацииУХ			= Справочники.ВидыОперацийУХ.ПлатежПоКредитуИлиЗайму;
		СтрокаРасхода.КолонкаСекции			= Перечисления.ВидыДвиженийПриходРасход.Расход; 
				
		РассчитатьСуммыПроцентовНаСервере(НовыйВариант);
		
		Для каждого СтрокаГрафик Из НовыйВариант.ГрафикРасчетов Цикл
			СтрокаГрафик.Валюта				= СтруктураЗаполнения.ВалютаДокумента;   
			СтрокаГрафик.СтатьяБюджета		= НастройкиОперацииФинансовогоИнструмента(СтрокаГрафик.ОперацияГрафика);
        КонецЦикла; 
		НовыйВариант.Записать();
     	
		Возврат НовыйВариант.Ссылка;

КонецФункции // ()

#Область ДляВызоваИзДругихПодсистем
// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом
#КонецОбласти

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции
Процедура РассчитатьСуммыПроцентовНаСервере(Объект, Отказ = Ложь )
	
	Если Объект.ГрафикРасчетов.Итог("Сумма") = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ОписаниеГрафика 	= Справочники.ВариантыФинансирования.ОписаниеГрафика();
	ПереченьОпераций 	= РаботаСДоговорамиКонтрагентовУХ.ОперацииГрафика(ОписаниеГрафика, Объект, Справочники.ВидыДоговоровКонтрагентовУХ.Кредит);
	ОперацииГрафика 	= Новый ФиксированноеСоответствие(ПереченьОпераций);
	СтруктураДействий 	= Новый Структура;
	Секции 				= Новый Массив;
	Если Не ФинансовыеИнструментыУХ.СтрокиСекцииГрафика(Объект.ГрафикРасчетов, ОписаниеГрафика["ОсновнойДолг"]).Количество() Тогда
		Секции.Добавить("ОсновнойДолг");
	КонецЕсли;
	Секции.Добавить("Проценты");
	
	СтруктураДействий.Вставить("Пересчитать", Новый Структура("СекцииГрафика", Секции));
	ФинансовыеИнструментыУХ.ПересчетГрафика(Объект, 0, ОписаниеГрафика, ОперацииГрафика, СтруктураДействий, Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АналитикиСтатейБюджетовУХ.ЗаполнитьРеквизитыАналитикВсехСтатей(Объект);
	
	ОтборПроцентов 	= Новый Структура("ЭлементСтруктурыЗадолженности, ОперацияГрафика",
						   Перечисления.ЭлементыСтруктурыЗадолженности.Проценты, Справочники.ОперацииГрафиковДоговоров.КредитПолученный_ПроцентыНачислено);
	СтрокиПроценты 	= Объект.ГрафикРасчетов.НайтиСтроки(ОтборПроцентов);
	ИтогПроценты 	= 0;
	Для каждого СтрокаПроценты Из СтрокиПроценты Цикл
		ИтогПроценты = ИтогПроценты + СтрокаПроценты.Сумма;
	КонецЦикла;  
	Объект.ОбщаяСуммаПроцентов = ИтогПроценты;
	
КонецПроцедуры

// Функция возвращает статью бюджета для заданной операции финансового инструмента,
// определяемой через свои свойства.
//
// Параметры:
//  ВидФинансовогоИнструмента		 - ПеречислениеСсылка.ВидыФинансовыхИнструментов	 - вид финансового инструмента искомой операции
// 
// Возвращаемое значение:
//    СтатьяБюджета - Статья бюджета, соответствующая данной операции.
//
Функция НастройкиОперацииФинансовогоИнструмента(Операция) 
	
    СтатьяБюджета 	= Неопределено;	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиФинансовыхИнструментов.Операция КАК Операция,
	|	НастройкиФинансовыхИнструментов.СтатьяБюджета КАК СтатьяБюджета
	|ИЗ
	|	РегистрСведений.НастройкиФинансовыхИнструментов КАК НастройкиФинансовыхИнструментов
	|ГДЕ
	|	НастройкиФинансовыхИнструментов.Операция = &Операция
	|";

	Запрос.УстановитьПараметр("Операция", 	Операция);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтатьяБюджета = Выборка.СтатьяБюджета;
	КонецЕсли;
	
	Возврат СтатьяБюджета;
	
КонецФункции

#КонецОбласти

#КонецЕсли