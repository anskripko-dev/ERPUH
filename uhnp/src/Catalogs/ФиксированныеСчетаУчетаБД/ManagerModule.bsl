Функция ПолучитьИменаСубконто() Экспорт 

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "Субконто1");
	Субконто.Вставить(2, "Субконто2");
	Субконто.Вставить(3, "Субконто3");
	
	Результат.Вставить("Счет", Субконто);
		
	Возврат Результат;
	
КонецФункции

Функция АналитикаФиксированногоСчета(ФиксированныйСчет = Неопределено, УчетнаяПолитика = Неопределено) Экспорт

	Таб = АналитикаФиксированныхСчетов(ФиксированныйСчет, УчетнаяПолитика);
	
	Если Таб.Количество() = 0 Тогда
		Таб.Добавить();//добавим пустую строку
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Таб.Получить(0));
	
КонецФункции

Функция АналитикаФиксированныхСчетов(ФиксированныеСчета = Неопределено, УчетнаяПолитика = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ФиксированныеСчетаУчетаБД.Ссылка КАК ФиксированныйСчет,
	|	ФиксированныеСчетаУчетаБД.Счет КАК СчетИБ,
	|	ФиксированныеСчетаУчетаБД.Счет.СчетСсылка КАК СчетСсылка,
	|	ФиксированныеСчетаУчетаБД.Субконто1 КАК Субконто1,
	|	ФиксированныеСчетаУчетаБД.Субконто2 КАК Субконто2,
	|	ФиксированныеСчетаУчетаБД.Субконто3 КАК Субконто3
	|ИЗ
	|	Справочник.ФиксированныеСчетаУчетаБД КАК ФиксированныеСчетаУчетаБД
	|ГДЕ
	|	ФиксированныеСчетаУчетаБД.Ссылка В(&ФиксированныеСчета)";
	
	Документы.УчетнаяПолитикаМСФО.ЗаменитьФиксированныеСчетаУчетаБД(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ФиксированныеСчета",	ФиксированныеСчета);
	Запрос.УстановитьПараметр("УчетнаяПолитика",	УчетнаяПолитика);//для УП
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

