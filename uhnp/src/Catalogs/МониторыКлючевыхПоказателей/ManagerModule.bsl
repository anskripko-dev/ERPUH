#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбновитьМКП(Результат,МКП,СохраненнаяНастройка,ОбщийОтбор ,ПараметрыОтчета,ИмяОтчета,НастройкиКомпоновщика,ГрафСхема) Экспорт
		
	ТЗОтвета           = Новый ТаблицаЗначений;
	ОбновитьДанныеМонитораКлючевыхПоказателей(МКП,ИмяОтчета,ОбщийОтбор,НастройкиКомпоновщика, ПараметрыОтчета,СохраненнаяНастройка,ГрафСхема,ТЗОтвета);
	Результат = ТЗОтвета;
	
КонецПроцедуры
	
Процедура ОбновитьДанныеМонитораКлючевыхПоказателей(Объект,ИмяОтчета,ОбщийОтбор,НастройкиКомпоновщика, ПараметрыОтчета,СохраненнаяНастройка,ГрафСхема,ТЗОтвета)
		
	НастройкиМонитораЭффективности = Новый Структура;
	
	Если ТипЗнч(ПараметрыОтчета) = Тип("Структура") Тогда		
		Для Каждого ЭлементСтруктуры Из ПараметрыОтчета Цикл
			НастройкиМонитораЭффективности.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЦикла;		
	КонецЕсли;
	
	// По умолчанию результат - пустое дерево значений, которое вернется в случае ошибки.
	ТЗОтвета =  СформироватьТаблицуМонитораПоказателей(ИмяОтчета);
	Результат = ТЗОтвета; 			
	
	ОтборОрганизация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ОбщийОтбор, "Организация", Справочники.Организации.ПустаяСсылка());
		
		
	//Получаем все поля из базы и считаем вычисляемые значения
	Запрос = ПолучитьЗапросПоказателейМКП(Объект);
	ТаблицаПоказателей = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТаблицы Из ТаблицаПоказателей Цикл
			
		Если СтрТаблицы.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка Тогда
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникЗначенияТекущегоПериода) Тогда 	
				СтрТаблицы.ФактическоеЗначениеТекущегоПериода = ПолучитьЗначениеПоИсточникуДанных(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникЗначенияТекущегоПериода);
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникЗначенияТекущегоПериодаПоказатель) Тогда 	
				СтрТаблицы.ФактическоеЗначениеТекущегоПериода = ПолучитьЗначениеПоПоказателю(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникЗначенияТекущегоПериодаПоказатель,СтрТаблицы.ИсточникЗначенияТекущегоПериодаПоказательОтбор);
			КонецЕсли;
		КонецЕсли;
			
		Если СтрТаблицы.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка Тогда
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникЗначенияПериодаСравнения) Тогда 	
				СтрТаблицы.ФактическоеЗначениеПредыдущегоПериода = ПолучитьЗначениеПоИсточникуДанных(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникЗначенияПериодаСравнения);
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникЗначенияПериодаСравненияПоказатель) Тогда 	
				СтрТаблицы.ФактическоеЗначениеПредыдущегоПериода = ПолучитьЗначениеПоПоказателю(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникЗначенияПериодаСравненияПоказатель,СтрТаблицы.ИсточникЗначенияПериодаСравненияПоказательОтбор);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрТаблицы.ИсточникПлановогоЗначенияРасширеннаяНастройка Тогда
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникПлановогоЗначения) Тогда 	
				СтрТаблицы.ПлановоеЗначение = ПолучитьЗначениеПоИсточникуДанных(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникПлановогоЗначения);
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СтрТаблицы.ИсточникЗначенияПериодаСравненияПоказатель) Тогда 	
				СтрТаблицы.ПлановоеЗначение = ПолучитьЗначениеПоПоказателю(ОбщийОтбор,СтрТаблицы,СтрТаблицы.ИсточникПлановогоЗначенияПоказатель,СтрТаблицы.ИсточникПлановогоЗначенияПоказательОтбор);
			КонецЕсли;
		КонецЕсли;
		
			
	Конеццикла;	
	
	ОбновитьВычисляемыеПоляМКП(ТаблицаПоказателей);
		
	// Группировка не используется. Вывод данных напрямую из таблицы показателей
	Если Объект.ГруппировкаМонитора = 0 Тогда 		
		
		//нарисовать карту целей
		Если Объект.ОтображатьЦели Тогда
				
			ТаблицаСвязей      = Новый ТаблицаЗначений;
			ТаблицаЭлементов   = Новый ТаблицаЗначений;
			
			ЗаполнитьТаблицуСвязейИЭлементов(ТаблицаСвязей, ТаблицаЭлементов, ТаблицаПоказателей, 3, ОтборОрганизация);
			
			ЭлементыПервогоУровня = ТаблицаЭлементов.Скопировать(Новый Структура("ЭлементВерхнегоУровня", Истина));
			
			Для Каждого Элемент Из ЭлементыПервогоУровня Цикл
				
				СтрокаЦели = ТЗОтвета.Строки.Добавить();
				СтрокаЦели[ИмяОтчета + "Показатель"] = Элемент.Элемент;
				СтрокаЦели[ИмяОтчета + "Ответственный"] = Элемент.Ответственный;
				ВидСтроки = ?(ТипЗнч(Элемент.Элемент) = Тип("СправочникСсылка.ПоказателиМонитораКлючевыхПоказателей"), 0, 1);
				СтрокаЦели[ИмяОтчета + "СлужебнаяСтрока"] = ВидСтроки;
				Состояние = ЗаполнитьПодчиненныеСтрокиДерева(ТаблицаСвязей, СтрокаЦели, ТаблицаПоказателей, ТаблицаЭлементов, ИмяОтчета, НастройкиМонитораЭффективности);
				Если ВидСтроки = 1 Тогда
					СтрокаЦели[ИмяОтчета + "Состояние"] = ВернутьКодПредставленияТренда(Состояние);
				КонецЕсли;
				
			КонецЦикла;
			
			ВывестиГрафическуюСхему(ГрафСхема,ТаблицаСвязей,ТаблицаЭлементов, ТЗОтвета, ИмяОтчета);

		Иначе
			
		//ТЗОтвета = 	ТаблицаПоказателей.Скопиоровать();
			
	КонецЕсли;
		
	// Группировка по ответственному	
	ИначеЕсли Объект.ГруппировкаМонитора = 1 Тогда 
						
		СоответствиеСтрокИПроекций = Новый Соответствие;
		
		Если Объект.ОтображатьЦели Тогда // Если отображаются цели, тогда группировка по ответственным по целям, иначе по показателям.
			ТаблицаСвязей      = Новый ТаблицаЗначений;
			ТаблицаЭлементов   = Новый ТаблицаЗначений;
			ЗаполнитьТаблицуСвязейИЭлементов(ТаблицаСвязей, ТаблицаЭлементов, ТаблицаПоказателей, 3, ОтборОрганизация);
			ТаблицаСтрокПервогоУровня    = ТаблицаЭлементов.Скопировать(Новый Структура("ЭлементВерхнегоУровня", Истина));
			
			Для Каждого Элемент Из ТаблицаСтрокПервогоУровня Цикл
				
				Если СоответствиеСтрокИПроекций[Элемент.Ответственный] = Неопределено Тогда
					
					НоваяСтрока = ТЗОтвета.Строки.Добавить();
					НоваяСтрока[ИмяОтчета + "Ответственный"] = Элемент.Ответственный;
					НоваяСтрока[ИмяОтчета + "СлужебнаяСтрока"] = 2;
					СоответствиеСтрокИПроекций.Вставить(Элемент.Ответственный, НоваяСтрока);
					
				КонецЕсли;
				
				СтрокаЦели = СоответствиеСтрокИПроекций[Элемент.Ответственный].Строки.Добавить();
				СтрокаЦели[ИмяОтчета + "Показатель"] = Элемент.Элемент;
				СтрокаЦели[ИмяОтчета + "Ответственный"] = Элемент.Ответственный;
				ВидСтроки = ?(ТипЗнч(Элемент.Элемент) = Тип("СправочникСсылка.ПоказателиМонитораКлючевыхПоказателей") ,0, 1);
				СтрокаЦели[ИмяОтчета + "СлужебнаяСтрока"] = ВидСтроки;
				Состояние = ЗаполнитьПодчиненныеСтрокиДерева(ТаблицаСвязей, СтрокаЦели, ТаблицаПоказателей, ТаблицаЭлементов, ИмяОтчета, НастройкиМонитораЭффективности);
				Если ВидСтроки = 1 Тогда
					СтрокаЦели[ИмяОтчета + "Состояние"] = ВернутьКодПредставленияТренда(Состояние);
				КонецЕсли;
				
			КонецЦикла;
			
			ВывестиГрафическуюСхему(ГрафСхема,ТаблицаСвязей,ТаблицаЭлементов, ТЗОтвета, ИмяОтчета);			
			
		Иначе
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Вн_Таблица.Ответственный КАК ЭлементПервогоУровня ИЗ Вн_Таблица КАК Вн_Таблица";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ТзОтвета.Строки.Добавить();
				НоваяСтрока[ИмяОтчета + "Ответственный"] = Выборка.ЭлементПервогоУровня;
				НоваяСтрока[ИмяОтчета + "СлужебнаяСтрока"] = Истина;
				СоответствиеСтрокИПроекций.Вставить(Выборка.ЭлементПервогоУровня, НоваяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
		
	// Группировка по проекции	
	ИначеЕсли Объект.ГруппировкаМонитора = 2 Тогда 		
						
		СоответствиеСтрокИПроекций = Новый Соответствие;
		
		Если Объект.ОтображатьЦели Тогда
			
			ТаблицаСвязей      = Новый ТаблицаЗначений;
			ТаблицаЭлементов   = Новый ТаблицаЗначений;
			ЗаполнитьТаблицуСвязейИЭлементов(ТаблицаСвязей, ТаблицаЭлементов, ТаблицаПоказателей, 3, ОтборОрганизация);
			ТаблицаСтрокПервогоУровня    = ТаблицаЭлементов.Скопировать(Новый Структура("ЭлементВерхнегоУровня", Истина));
			
			Для Каждого Элемент Из ТаблицаСтрокПервогоУровня Цикл
				
				Если СоответствиеСтрокИПроекций[Элемент.Проекция] = Неопределено Тогда
					
					НоваяСтрока = ТЗОтвета.Строки.Добавить();
					НоваяСтрока[ИмяОтчета + "Показатель"] = Элемент.Проекция;
					НоваяСтрока[ИмяОтчета + "СлужебнаяСтрока"] = 2;
					СоответствиеСтрокИПроекций.Вставить(Элемент.Проекция, НоваяСтрока);
					
				КонецЕсли;
				
				СтрокаЦели = СоответствиеСтрокИПроекций[Элемент.Проекция].Строки.Добавить();
				СтрокаЦели[ИмяОтчета + "Показатель"] = Элемент.Элемент;
				СтрокаЦели[ИмяОтчета + "Ответственный"] = Элемент.Ответственный;
				ВидСтроки = ?(ТипЗнч(Элемент.Элемент) = Тип("СправочникСсылка.ПоказателиМонитораКлючевыхПоказателей"), 0, 1);
				СтрокаЦели[ИмяОтчета + "СлужебнаяСтрока"] = ВидСтроки;
				Состояние = ЗаполнитьПодчиненныеСтрокиДерева(ТаблицаСвязей, СтрокаЦели, ТаблицаПоказателей, ТаблицаЭлементов, ИмяОтчета, НастройкиМонитораЭффективности);
				Если ВидСтроки = 1 Тогда
					СтрокаЦели[ИмяОтчета + "Состояние"] = ВернутьКодПредставленияТренда(Состояние);
				КонецЕсли;
				
			КонецЦикла;
			
			ВывестиГрафическуюСхему(ГрафСхема,ТаблицаСвязей,ТаблицаЭлементов, ТЗОтвета, ИмяОтчета);			
			
		Иначе
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Вн_Таблица.Проекция КАК ЭлементПервогоУровня ИЗ ВН_Таблица КАК ВН_Таблица";
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ТзОтвета.Строки.Добавить();
				НоваяСтрока[ИмяОтчета + "Показатель"] = Выборка.ЭлементПервогоУровня;
				НоваяСтрока[ИмяОтчета + "СлужебнаяСтрока"] = Истина;
				СоответствиеСтрокИПроекций.Вставить(Выборка.ЭлементПервогоУровня, НоваяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = 
	"УНИЧТОЖИТЬ Вн_Таблица";
	Запрос.Выполнить();
	
	Если ЗначениеЗаполнено(ТаблицаПоказателей) Тогда
		
		//НеобработанныеПоказатели = ТаблицаПоказателей.НайтиСтроки(Новый Структура("Обработано", Истина));
		
		Для Каждого Элемент Из ТаблицаПоказателей Цикл
			
			Если Объект.ГруппировкаМонитора = 1 Тогда
				ПолеГруппировки = Элемент.Ответственный;
			ИначеЕсли Объект.ГруппировкаМонитора = 2 Тогда
				ПолеГруппировки = Элемент.Проекция;
			Иначе
				ПолеГруппировки = Неопределено;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ПолеГруппировки) Тогда
				НоваяСтрока = ТЗОтвета; // Нет группировок, строки добавляем непосредственно в таблицу.
			ИначеЕсли СоответствиеСтрокИПроекций[ПолеГруппировки] = Неопределено Тогда
				НоваяСтрока                 = ТзОтвета.Строки.Добавить();
				Если Объект.ГруппировкаМонитора = 1 Тогда
					НоваяСтрока[ИмяОтчета + "Ответственный"] = ПолеГруппировки;
				Иначе
					НоваяСтрока[ИмяОтчета + "Показатель"]    = ПолеГруппировки;
				КонецЕсли;
				НоваяСтрока[ИмяОтчета + "СлужебнаяСтрока"] = 2;
				СоответствиеСтрокИПроекций.Вставить(Элемент.Проекция, НоваяСтрока);
			Иначе
				НоваяСтрока = СоответствиеСтрокИПроекций[ПолеГруппировки];
			КонецЕсли;
			
			//Проверка фактора на быстрые отборы
			Если СостояниеИТрендУдовлетворяетУсловиям(Элемент.Тренд, НастройкиМонитораЭффективности)
				И СостояниеИТрендУдовлетворяетУсловиям(Элемент.Состояние, НастройкиМонитораЭффективности) Тогда
				
				ДобавлятьНовуюСтроку = Истина;
				
				Если ТипЗнч(НоваяСтрока) = Тип("ДеревоЗначений") Тогда
					СтрокиПоказателя = НоваяСтрока.Строки.НайтиСтроки(Новый Структура("Показатель",Элемент.Показатель),Истина);
					Если СтрокиПоказателя.Количество() > 0 Тогда 
						
						Для Каждого СтрокаПоказателя Из СтрокиПоказателя Цикл
							СтрокаПоказателя[ИмяОтчета + "Показатель"]                            = Элемент.Показатель;
							СтрокаПоказателя[ИмяОтчета + "ИспользуемаяИБ"]                        = Элемент.ВнешняяИБ;
							СтрокаПоказателя[ИмяОтчета + "Ответственный"]                         = Элемент.Ответственный;
							СтрокаПоказателя[ИмяОтчета + "Тренд"]                                 = ВернутьКодПредставленияТренда(Элемент.Тренд);
							СтрокаПоказателя[ИмяОтчета + "Состояние"]                             = ВернутьКодПредставленияТренда(Элемент.Состояние);
							СтрокаПоказателя[ИмяОтчета + "ФактическоеЗначениеТекущегоПериода"]    = Элемент.ФактическоеЗначениеТекущегоПериода;
							СтрокаПоказателя[ИмяОтчета + "ФактическоеЗначениеПредыдущегоПериода"] = Элемент.ФактическоеЗначениеПредыдущегоПериода;
							СтрокаПоказателя[ИмяОтчета + "ПлановоеЗначение"]                      = Элемент.ПлановоеЗначение;
							СтрокаПоказателя[ИмяОтчета + "ИзменениеАбсолютное"]                   = Элемент.ИзменениеАбсолютное;
							СтрокаПоказателя[ИмяОтчета + "ИзменениеОтносительное"]                = Элемент.ИзменениеОтносительное;
							СтрокаПоказателя[ИмяОтчета + "ОтклонениеОтПланаОтносительное"]        = Элемент.ОтклонениеОтПланаОтносительное;
							СтрокаПоказателя[ИмяОтчета + "ОтклонениеОтПланаАбсолютное"]           = Элемент.ОтклонениеОтПланаАбсолютное;
							СтрокаПоказателя[ИмяОтчета + "ПроцентВыполненияПлана"]                = Элемент.ПроцентВыполненияПлана;
						
						КонецЦикла;	
						
						ДобавлятьНовуюСтроку = Ложь;
						
						
					КонецЕсли;	
					
				КонецЕсли;
				
				Если ДобавлятьНовуюСтроку Тогда
					СтрокаПоказателя = НоваяСтрока.Строки.Добавить();
					СтрокаПоказателя[ИмяОтчета + "Показатель"]                            = Элемент.Показатель;
					СтрокаПоказателя[ИмяОтчета + "ИспользуемаяИБ"]                        = Элемент.ВнешняяИБ;
					СтрокаПоказателя[ИмяОтчета + "Ответственный"]                         = Элемент.Ответственный;
					СтрокаПоказателя[ИмяОтчета + "Тренд"]                                 = ВернутьКодПредставленияТренда(Элемент.Тренд);
					СтрокаПоказателя[ИмяОтчета + "Состояние"]                             = ВернутьКодПредставленияТренда(Элемент.Состояние);
					СтрокаПоказателя[ИмяОтчета + "ФактическоеЗначениеТекущегоПериода"]    = Элемент.ФактическоеЗначениеТекущегоПериода;
					СтрокаПоказателя[ИмяОтчета + "ФактическоеЗначениеПредыдущегоПериода"] = Элемент.ФактическоеЗначениеПредыдущегоПериода;
					СтрокаПоказателя[ИмяОтчета + "ПлановоеЗначение"]                      = Элемент.ПлановоеЗначение;
					СтрокаПоказателя[ИмяОтчета + "ИзменениеАбсолютное"]                   = Элемент.ИзменениеАбсолютное;
					СтрокаПоказателя[ИмяОтчета + "ИзменениеОтносительное"]                = Элемент.ИзменениеОтносительное;
					СтрокаПоказателя[ИмяОтчета + "ОтклонениеОтПланаОтносительное"]        = Элемент.ОтклонениеОтПланаОтносительное;
					СтрокаПоказателя[ИмяОтчета + "ОтклонениеОтПланаАбсолютное"]           = Элемент.ОтклонениеОтПланаАбсолютное;
					СтрокаПоказателя[ИмяОтчета + "ПроцентВыполненияПлана"]                = Элемент.ПроцентВыполненияПлана;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	
КонецПроцедуры	

Функция ПолучитьЗапросПоказателейМКП(МониторКлючевыхПоказателей)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МониторыКлючевыхПоказателейИсточникиДанных.ИсточникДанных КАК Показатель,
	|	ПоказателиМонитораКлючевыхПоказателей.Проекция КАК Проекция,
	|	ЕСТЬNULL(ЦелиКлючевыеПоказатели.Ссылка, ЗНАЧЕНИЕ(Справочник.Цели.ПустаяСсылка)) КАК Цель,
	|	МониторыКлючевыхПоказателейИсточникиДанных.ВнешняяИБ КАК ВнешняяИБ,
	|	0 КАК ФактическоеЗначениеТекущегоПериода,
	|	0 КАК ФактическоеЗначениеПредыдущегоПериода,
	|	0 КАК ПлановоеЗначение,
	|	0 КАК Состояние,
	|	0 КАК Тренд,
	|	0 КАК ИзменениеАбсолютное,
	|	0 КАК ИзменениеОтносительное,
	|	0 КАК ОтклонениеОтПланаАбсолютное,
	|	0 КАК ОтклонениеОтПланаОтносительное,
	|	0 КАК ПроцентВыполненияПлана,
	|	ВЫБОР
	|		КОГДА ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияТекущегоПериода = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ИспользуетсяФактическоеЗначениеТекущегоПериода,
	|	ВЫБОР
	|		КОГДА ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияПериодаСравнения = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ИспользуетсяФактическоеЗначениеПредыдущегоПериода,
	|	ВЫБОР
	|		КОГДА ПоказателиМонитораКлючевыхПоказателей.ИсточникПлановогоЗначения = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхДляРасчетов.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ИспользуетсяПлановоеЗначение,
	|	ПоказателиМонитораКлючевыхПоказателей.Ответственный КАК Ответственный,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияТекущегоПериода КАК ИсточникЗначенияТекущегоПериода,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияПериодаСравнения КАК ИсточникЗначенияПериодаСравнения,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникПлановогоЗначения КАК ИсточникПлановогоЗначения,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияТекущегоПериодаПоказатель КАК ИсточникЗначенияТекущегоПериодаПоказатель,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияПериодаСравненияПоказатель КАК ИсточникЗначенияПериодаСравненияПоказатель,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникПлановогоЗначенияПоказатель КАК ИсточникПлановогоЗначенияПоказатель,
	|	ПоказателиМонитораКлючевыхПоказателей.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПоказателиМонитораКлючевыхПоказателей.ТочностьОтображения КАК ТочностьОтображения,
	|	ПоказателиМонитораКлючевыхПоказателей.ИспользоватьКоридорЗначений КАК ИспользоватьКоридорЗначений,
	|	ПоказателиМонитораКлючевыхПоказателей.ВерхняяГраницаЗначения КАК ВерхняяГраницаЗначения,
	|	ПоказателиМонитораКлючевыхПоказателей.НижняяГраницаЗначения КАК НижняяГраницаЗначения,
	|	ПоказателиМонитораКлючевыхПоказателей.ПорогЗначимостиТренда КАК ПорогЗначимостиТренда,
	|	ПоказателиМонитораКлючевыхПоказателей.Состояние_ЛевыйДиапазон КАК Состояние_ЛевыйДиапазон,
	|	ПоказателиМонитораКлючевыхПоказателей.Состояние_ПравыйДиапазон КАК Состояние_ПравыйДиапазон,
	|	ПоказателиМонитораКлючевыхПоказателей.ТрактовкаПоложительногоОтклонения КАК ТрактовкаПоложительногоОтклонения,
	|	ПоказателиМонитораКлючевыхПоказателей.ПредставлениеНуля КАК ПредставлениеНуля,
	|	ПоказателиМонитораКлючевыхПоказателей.СпособРасчетаИтоговогоЗначения КАК СпособРасчетаИтоговогоЗначения,
	|	ПоказателиМонитораКлючевыхПоказателей.ДопустимоеОтклонениеОтПлана КАК ДопустимоеОтклонениеОтПлана,
	|	ПоказателиМонитораКлючевыхПоказателей.ПредельноеОтклонениеОтПлана КАК ПредельноеОтклонениеОтПлана,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка КАК ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка КАК ИсточникЗначенияПериодаСравненияРасширеннаяНастройка,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникПлановогоЗначенияРасширеннаяНастройка КАК ИсточникПлановогоЗначенияРасширеннаяНастройка,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияТекущегоПериодаПоказательОтбор КАК ИсточникЗначенияТекущегоПериодаПоказательОтбор,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникЗначенияПериодаСравненияПоказательОтбор КАК ИсточникЗначенияПериодаСравненияПоказательОтбор,
	|	ПоказателиМонитораКлючевыхПоказателей.ИсточникПлановогоЗначенияПоказательОтбор КАК ИсточникПлановогоЗначенияПоказательОтбор
	|ПОМЕСТИТЬ ВН_Таблица
	|ИЗ
	|	Справочник.МониторыКлючевыхПоказателей.ИсточникиДанных КАК МониторыКлючевыхПоказателейИсточникиДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиМонитораКлючевыхПоказателей КАК ПоказателиМонитораКлючевыхПоказателей
	|		ПО МониторыКлючевыхПоказателейИсточникиДанных.ИсточникДанных = ПоказателиМонитораКлючевыхПоказателей.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Цели.КлючевыеПоказатели КАК ЦелиКлючевыеПоказатели
	|		ПО (ЦелиКлючевыеПоказатели.Показатель = ПоказателиМонитораКлючевыхПоказателей.Ссылка)
	|ГДЕ
	|	МониторыКлючевыхПоказателейИсточникиДанных.Ссылка = &МКП";
	
	Запрос.УстановитьПараметр("МКП", МониторКлючевыхПоказателей);
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Вн_Таблица.Показатель КАК Показатель,
	               |	Вн_Таблица.Ответственный КАК Ответственный,
	               |	Вн_Таблица.Проекция КАК Проекция,
	               |	Вн_Таблица.Цель КАК Цель,
	               |	Вн_Таблица.ВнешняяИБ КАК ВнешняяИБ,
	               |	Вн_Таблица.ФактическоеЗначениеТекущегоПериода КАК ФактическоеЗначениеТекущегоПериода,
	               |	Вн_Таблица.ФактическоеЗначениеПредыдущегоПериода КАК ФактическоеЗначениеПредыдущегоПериода,
	               |	Вн_Таблица.ПлановоеЗначение КАК ПлановоеЗначение,
	               |	Вн_Таблица.ИзменениеАбсолютное КАК ИзменениеАбсолютное,
	               |	Вн_Таблица.ИзменениеОтносительное КАК ИзменениеОтносительное,
	               |	Вн_Таблица.ОтклонениеОтПланаАбсолютное КАК ОтклонениеОтПланаАбсолютное,
	               |	Вн_Таблица.ОтклонениеОтПланаОтносительное КАК ОтклонениеОтПланаОтносительное,
	               |	Вн_Таблица.ПроцентВыполненияПлана КАК ПроцентВыполненияПлана,
