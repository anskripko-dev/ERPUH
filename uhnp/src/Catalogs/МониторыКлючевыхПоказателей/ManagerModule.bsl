                  |	ПоказателиМонитораКлючевыхПоказателей.ЭтоГруппа = Ложь";
   
   
   Результат = Запрос.Выполнить();
   Выборка = Результат.Выбрать();
   
   Пока Выборка.Следующий() Цикл
	   
	   ПоказательМКПОбъект = Выборка.Ссылка.ПолучитьОбъект();
	   
	   Если ЗначениеЗаполнено(ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериода) Тогда
		   ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка = Истина;
	   КонецЕсли;	   
	   
	   Если ЗначениеЗаполнено(ПоказательМКПОбъект.ИсточникЗначенияПериодаСравнения) Тогда
		   ПоказательМКПОбъект.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка = Истина;
	   КонецЕсли;	
	   
	   Если ЗначениеЗаполнено(ПоказательМКПОбъект.ИсточникПлановогоЗначения) Тогда
		   ПоказательМКПОбъект.ИсточникПлановогоЗначенияРасширеннаяНастройка = Истина;
	   КонецЕсли;	
	   
	   Если ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериодаРасширеннаяНастройка Тогда
		   ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериодаПредставление  =  Строка(ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериода);
	   Иначе	
		   ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериодаПредставление  =  Строка(ПоказательМКПОбъект.ИсточникЗначенияТекущегоПериодаПоказатель);
	   КонецЕсли;
	   
	   Если ПоказательМКПОбъект.ИсточникЗначенияПериодаСравненияРасширеннаяНастройка Тогда
		   ПоказательМКПОбъект.ИсточникЗначенияПериодаСравненияПредставление  =  Строка(ПоказательМКПОбъект.ИсточникЗначенияПериодаСравнения);
	   Иначе	
		   ПоказательМКПОбъект.ИсточникЗначенияПериодаСравненияПредставление  =  Строка(ПоказательМКПОбъект.ИсточникЗначенияПериодаСравненияПоказатель);
	   КонецЕсли;
	   
	   Если ПоказательМКПОбъект.ИсточникПлановогоЗначенияРасширеннаяНастройка Тогда
		   ПоказательМКПОбъект.ИсточникПлановогоЗначенияПредставление  =  Строка(ПоказательМКПОбъект.ИсточникПлановогоЗначения);
	   Иначе	
		   ПоказательМКПОбъект.ИсточникПлановогоЗначенияПредставление  =  Строка(ПоказательМКПОбъект.ИсточникПлановогоЗначенияПоказатель);
	   КонецЕсли;
	   
	   ПоказательМКПОбъект.ОбменДанными.Загрузка = Истина;
	   ПоказательМКПОбъект.Записать();
	   
   КонецЦикла;
   
   Запрос = Новый Запрос;
   Запрос.Текст = "ВЫБРАТЬ
                  |	ПроизвольныеОтчеты.Ссылка КАК Ссылка,
                  |	ПроизвольныеОтчеты.Наименование КАК Наименование,
                  |	ПроизвольныеОтчеты.ОтображатьЦели КАК ОтображатьЦели,
                  |	ПроизвольныеОтчеты.ОтображатьВВидеСхемы КАК ОтображатьВВидеСхемы,
                  |	ПроизвольныеОтчеты.ГруппировкаМонитора КАК ГруппировкаМонитора
                  |ИЗ
                  |	Справочник.ПроизвольныеОтчеты КАК ПроизвольныеОтчеты
                  |ГДЕ
                  |	ПроизвольныеОтчеты.ЭтоГруппа = ЛОЖЬ
                  |	И ПроизвольныеОтчеты.ПометкаУдаления = ЛОЖЬ
                  |	И ПроизвольныеОтчеты.ВидПроизвольногоОтчета = 1";
   
   
   Результат = Запрос.Выполнить();
   Выборка = Результат.Выбрать();
   
   Пока Выборка.Следующий() Цикл
	   
	   
	   нМКП 				= Справочники.МониторыКлючевыхПоказателей.СоздатьЭлемент();
	 
	   нМКП.Наименование    = Выборка.Наименование;
	   нМКП.ОтображатьЦели = Выборка.ОтображатьЦели;
	   нМКП.ОтображатьВВидеСхемы = Выборка.ОтображатьВВидеСхемы;
	   нМКП.ГруппировкаМонитора  = Выборка.ГруппировкаМонитора;
	   
	   Для Каждого Стр Из Выборка.Ссылка.ИсточникиДанных Цикл
		   
		   нСтр = нМКП.ИсточникиДанных.Добавить();
		   ЗаполнитьЗначенияСвойств(нСтр,Стр); 
		   
	   КонецЦикла;	   
	   
	   
	   нМКП.ОбменДанными.Загрузка = Истина;
	   нМКП.Записать();
   
   КонецЦикла;
   


КонецПроцедуры


	
#КонецЕсли

