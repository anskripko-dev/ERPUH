#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиРеквизитов = Новый Массив;
	НастройкиТЧ         = Новый Массив;

	Если Параметры.НастройкиПроверкиКонтрольнойСуммы <> Неопределено Тогда
		НастройкиРеквизитов = Параметры.НастройкиПроверкиКонтрольнойСуммы.Реквизиты;
		НастройкиТЧ         = Параметры.НастройкиПроверкиКонтрольнойСуммы.ТабличныеЧасти;
	КонецЕсли;
	
	РеквизитОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Параметры.ТипОбъектаСогласования,
		"ИмяОбъектаМетаданных");
	
	ИмяОбъектаМетаданных = РеквизитОбъекта.ИмяОбъектаМетаданных;
	ИмяСправочника       = Параметры.ИмяСправочника;
	
	Если Параметры.ИмяСправочника = "СправочникиБД" Тогда
		ПолноеИмяОбъектаМетаданных = "Справочник." + РеквизитОбъекта.ИмяОбъектаМетаданных;
	Иначе
		ПолноеИмяОбъектаМетаданных = "Документ." + РеквизитОбъекта.ИмяОбъектаМетаданных;
	КонецЕсли;
	
	ОбновитьСписокРеквизитов(НастройкиРеквизитов);
	ОбновитьСписокТабличныхЧастей(НастройкиТЧ);
	
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 : Настройки проверки'"),
		Параметры.Наименование);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТолькоВыбранныеРеквизиты(Команда)
	ТолькоВыбранныеРеквизитыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеТабличныеЧасти(Команда)
	ТолькоВыбранныеТабличныеЧастиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	Реквизиты      = Новый Массив;
	ТабличныеЧасти = Новый Массив;
	
	ПараметрыОтбора = Новый Структура("Проверять", Истина);
	НайденныеРеквизиты = РеквизитыОбъекта.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого Стр Из НайденныеРеквизиты Цикл
		Реквизиты.Добавить(Стр.Имя);
	КонецЦикла;
	
	НайденныеТЧ = ТабличныеЧастиОбъекта.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого Стр Из НайденныеТЧ Цикл
		ТабличныеЧасти.Добавить(Стр.Имя);
	КонецЦикла;
	
	Если Реквизиты.Количество() = 0 И ТабличныеЧасти.Количество() = 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Не выбраны реквизиты или табличные части для проверки контрольной суммы 
			|при утверждении документа. 
			|Сбросить флаг ""Использовать проверку версии объекта при утверждении этапов""?'");
			
		Оповещение = Новый ОписаниеОповещения("ОбработатьПустыеНастройкиЗавершение", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0)
		
	Иначе
		НастройкиПроверки = Новый Структура;
		НастройкиПроверки.Вставить("Реквизиты",      Реквизиты);
		НастройкиПроверки.Вставить("ТабличныеЧасти", ТабличныеЧасти);
		Закрыть(НастройкиПроверки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	НастройкиПоУмолчаниюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыУстановитьФлажки(Команда)
	ОбработатьФлажкиРеквизитов(Истина);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыСнятьФлажки(Команда)
	ОбработатьФлажкиРеквизитов(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиСнятьФлажки(Команда)
	ОбработатьФлажкиТабличныхЧастей(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТабличныеЧастиУстановитьФлажки(Команда)
	ОбработатьФлажкиТабличныхЧастей(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьПустыеНастройкиЗавершение(РезультатВопроса, ПараметрыВопроса) Экспорт
	
	Если РезультатВопроса <> Неопределено Тогда
		
		Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
			НастройкиПроверки = Новый Структура;
			НастройкиПроверки.Вставить("Реквизиты",      Новый Массив);
			НастройкиПроверки.Вставить("ТабличныеЧасти", Новый Массив);
			Закрыть(НастройкиПроверки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокРеквизитов(НастройкиРеквизитов, ТолькоВыбранные = Истина)
	
	ТолькоВыбранныеРеквизиты = ТолькоВыбранные;
	
	ДоступностьОбъектов = ДоступностьОбъектов();
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъектаМетаданных);
	
	ФильтруемыеРеквизиты = ФильтрРедактированияПоТипу(ОбъектМетаданных);

	ЗакрытыеФункциональнымиОпциями = Новый Соответствие;
	
	ОписаниеРеквизитов = ОбъектМетаданных.Реквизиты;
	Для Каждого Реквизит Из ОписаниеРеквизитов Цикл
		Если ДоступностьОбъектов[Реквизит] = Ложь Тогда
			ЗакрытыеФункциональнымиОпциями.Вставить(Реквизит.Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого РеквизитЗакрытыйФункциональнымиОпциями Из ЗакрытыеФункциональнымиОпциями Цикл
		ФильтруемыеРеквизиты.Вставить(РеквизитЗакрытыйФункциональнымиОпциями.Ключ, Истина);
	КонецЦикла;
	
	НаборФильтруемыхРеквизитов = Новый Массив;
	Для Каждого Реквизит Из ФильтруемыеРеквизиты Цикл
		НаборФильтруемыхРеквизитов.Добавить(Реквизит.Ключ);
	КонецЦикла;
	
	РеквизитыОбъекта.Очистить();
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитов Цикл
		
		Если ТипЗнч(ОписаниеРеквизита) = Тип("ОписаниеСтандартногоРеквизита") Тогда
			Если НЕ ПравоДоступа("Редактирование", ОбъектМетаданных, , ОписаниеРеквизита.Имя) Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			Если НЕ ПравоДоступа("Редактирование", ОписаниеРеквизита) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если НаборФильтруемыхРеквизитов.Найти(ОписаниеРеквизита.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Проверять = НастройкиРеквизитов.Найти(ОписаниеРеквизита.Имя) <> Неопределено;
		
		Если ТолькоВыбранные И Не Проверять Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитОбъекта = РеквизитыОбъекта.Добавить();
		РеквизитОбъекта.Имя = ОписаниеРеквизита.Имя;
		РеквизитОбъекта.Представление = ОписаниеРеквизита.Представление();
		РеквизитОбъекта.Проверять     = Проверять;
		
	КонецЦикла;
	
	РеквизитыОбъекта.Сортировать("Представление Возр");
	
	Элементы.РеквизитыОбъектаТолькоВыбранныеРеквизиты.Пометка = ТолькоВыбранные;
	Элементы.РеквизитыОбъектаПроверять.Доступность            = Не ТолькоВыбранные;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокТабличныхЧастей(НастройкиТЧ, ТолькоВыбранные = Истина)
	
	ТолькоВыбранныеТабличныеЧасти = ТолькоВыбранные;
	
	ДоступностьОбъектов = ДоступностьОбъектов();
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъектаМетаданных);
	
	ФильтруемыеРеквизиты = ФильтрРедактированияПоТипу(ОбъектМетаданных);

	ЗакрытыеФункциональнымиОпциями = Новый Соответствие;
	
	ОписаниеТабличныхЧастей = ОбъектМетаданных.ТабличныеЧасти;
	Для Каждого ТабличнаяЧасть Из ОписаниеТабличныхЧастей Цикл
		Если ДоступностьОбъектов[ТабличнаяЧасть] = Ложь Тогда
			ЗакрытыеФункциональнымиОпциями.Вставить(ТабличнаяЧасть.Имя + ".*", Истина);
		Иначе
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				Если ДоступностьОбъектов[Реквизит] = Ложь Тогда
					ЗакрытыеФункциональнымиОпциями.Вставить(ТабличнаяЧасть.Имя + "." + Реквизит.Имя, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого РеквизитЗакрытыйФункциональнымиОпциями Из ЗакрытыеФункциональнымиОпциями Цикл
		ФильтруемыеРеквизиты.Вставить(РеквизитЗакрытыйФункциональнымиОпциями.Ключ, Истина);
	КонецЦикла;
	
	НаборФильтруемыхРеквизитов = Новый Массив;
	Для Каждого Реквизит Из ФильтруемыеРеквизиты Цикл
		НаборФильтруемыхРеквизитов.Добавить(Реквизит.Ключ);
	КонецЦикла;
	
	ТабличныеЧастиОбъекта.Очистить();
	Для Каждого ОписаниеТабличнойЧасти Из ОбъектМетаданных.ТабличныеЧасти Цикл
			
		Если Не ПравоДоступа("Редактирование", ОписаниеТабличнойЧасти) Тогда
			Продолжить;
		КонецЕсли;

		Если НаборФильтруемыхРеквизитов.Найти(ОписаниеТабличнойЧасти.Имя + ".*") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Проверять = НастройкиТЧ.Найти(ОписаниеТабличнойЧасти.Имя) <> Неопределено;
		
		Если ТолькоВыбранные И Не Проверять Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличнаяЧастьОбъекта = ТабличныеЧастиОбъекта.Добавить();
		ТабличнаяЧастьОбъекта.Имя = ОписаниеТабличнойЧасти.Имя; 
		ТабличнаяЧастьОбъекта.Представление = ОписаниеТабличнойЧасти.Представление();
		ТабличнаяЧастьОбъекта.Проверять     = Проверять;
		
	КонецЦикла;
	
	ТабличныеЧастиОбъекта.Сортировать("Представление Возр");
	
	Элементы.ТабличныеЧастиОбъектаТолькоВыбранныеТабличныеЧасти.Пометка = ТолькоВыбранные;
	Элементы.ТабличныеЧастиОбъектаПроверять.Доступность                 = Не ТолькоВыбранные;
	
КонецПроцедуры

&НаСервере
Функция ДоступностьОбъектов()
	
	ДоступностьОбъектов = Новый Соответствие;
	Для Каждого ФункциональнаяОпция Из Метаданные.ФункциональныеОпции Цикл
		Если Не Метаданные.Константы.Содержит(ФункциональнаяОпция.Хранение) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ПолучитьФункциональнуюОпцию(ФункциональнаяОпция.Имя, Новый Структура);
		Для Каждого Элемент Из ФункциональнаяОпция.Состав Цикл
			Если Элемент.Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Значение = Истина Тогда
				ДоступностьОбъектов.Вставить(Элемент.Объект, Истина);
			Иначе
				Если ДоступностьОбъектов[Элемент.Объект] = Неопределено Тогда
					ДоступностьОбъектов.Вставить(Элемент.Объект, Ложь);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДоступностьОбъектов;
	
КонецФункции

&НаСервере
Функция ФильтрРеквизитов()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80)));
	Результат.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80)));
	
