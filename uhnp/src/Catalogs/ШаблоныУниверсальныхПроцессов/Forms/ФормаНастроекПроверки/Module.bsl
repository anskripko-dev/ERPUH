	// Планы обмена.
	Фильтр = Результат.Добавить();
	Фильтр.ТипОбъекта = "ПланыОбмена";
	Фильтр.Реквизит = "Код";
	
	Фильтр = Результат.Добавить();
	Фильтр.ТипОбъекта = "ПланыОбмена";
	Фильтр.Реквизит = "НомерОтправленного";
	
	Фильтр = Результат.Добавить();
	Фильтр.ТипОбъекта = "ПланыОбмена";
	Фильтр.Реквизит = "НомерПринятого";
	
	Результат.Индексы.Добавить("ТипОбъекта");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФильтрРедактированияПоТипу(ОбъектМетаданных)
	
	ФильтрТаблица = ФильтрРеквизитов();
	
	// Реквизиты, блокируемые для любого типа объектов метаданных.
	ОбщийФильтр = ФильтрТаблица.НайтиСтроки(Новый Структура("ТипОбъекта", "*"));
	
	// Реквизиты, блокируемые для указанного типа объектов метаданных.
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ИмяБазовогоТипаПоОбъектуМетаданных = "Документы";
	Иначе
		ИмяБазовогоТипаПоОбъектуМетаданных = "Справочники";
	КонецЕсли;
		
	ФильтрПоТипуОбъекта = ФильтрТаблица.НайтиСтроки(Новый Структура("ТипОбъекта", 
		ИмяБазовогоТипаПоОбъектуМетаданных));
	
	ФильтруемыеРеквизиты = Новый Соответствие;
	
	Для Каждого СтрокаОписание Из ОбщийФильтр Цикл
		ФильтруемыеРеквизиты[СтрокаОписание.Реквизит] = Истина;
	КонецЦикла;
	
	Для Каждого СтрокаОписание Из ФильтрПоТипуОбъекта Цикл
		ФильтруемыеРеквизиты[СтрокаОписание.Реквизит] = Истина;
	КонецЦикла;
	
	ПрефиксУдаляемыхРеквизитов = "Удалить";
	ОписаниеРеквизитов = ОбъектМетаданных.Реквизиты;
	Для Каждого Реквизит Из ОписаниеРеквизитов Цикл
		Если НРег(Лев(Реквизит.Имя, СтрДлина(ПрефиксУдаляемыхРеквизитов))) = НРег(ПрефиксУдаляемыхРеквизитов) Тогда
			ФильтруемыеРеквизиты[Реквизит.Имя] = Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Если НРег(Лев(ТабличнаяЧасть.Имя, СтрДлина(ПрефиксУдаляемыхРеквизитов))) = НРег(ПрефиксУдаляемыхРеквизитов) Тогда
			ФильтруемыеРеквизиты[ТабличнаяЧасть.Имя + ".*"] = Истина;
		Иначе
			ОписаниеРеквизитовТабличнойЧасти = ТабличнаяЧасть.Реквизиты;
			Для Каждого Реквизит Из ОписаниеРеквизитовТабличнойЧасти Цикл
				Если НРег(Лев(Реквизит.Имя, СтрДлина(ПрефиксУдаляемыхРеквизитов))) = НРег(ПрефиксУдаляемыхРеквизитов) Тогда
					ФильтруемыеРеквизиты[ТабличнаяЧасть.Имя + "." + Реквизит.Имя] = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ФильтруемыеРеквизиты;
	
КонецФункции

&НаСервере
Процедура ТолькоВыбранныеТабличныеЧастиНаСервере()
	
	НастройкиТЧ = Новый Массив;
	Для Каждого Стр Из ТабличныеЧастиОбъекта Цикл
		Если Стр.Проверять Тогда
			НастройкиТЧ.Добавить(Стр.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьСписокТабличныхЧастей(НастройкиТЧ, Не ТолькоВыбранныеТабличныеЧасти);
	
КонецПроцедуры

&НаСервере
Процедура ТолькоВыбранныеРеквизитыНаСервере()
	
	НастройкиРеквизитов = Новый Массив;
	Для Каждого Стр Из РеквизитыОбъекта Цикл
		Если Стр.Проверять Тогда
			НастройкиРеквизитов.Добавить(Стр.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьСписокРеквизитов(НастройкиРеквизитов, Не ТолькоВыбранныеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура НастройкиПоУмолчаниюНаСервере()
	
	Если РегистрыСведений.ДанныеДляПроверкиСогласования.ЕстьРекомендуемыеНастройки(ПолноеИмяОбъектаМетаданных) Тогда
		МенеджерОбъекта              = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъектаМетаданных);
		РеквизитыДляКонтрольнойСуммы = МенеджерОбъекта.РеквизитыДляКонтрольнойСуммы();
	Иначе
		РеквизитыИТабличныеЧастиПоУмолчанию = РегистрыСведений.ДанныеДляПроверкиСогласования.РеквизитыДляКонтрольнойСуммыПоУмолчанию();
		Если ИмяСправочника = "СправочникиБД" Тогда
			МетаданныеОбъекта = Метаданные.Справочники.Найти(ИмяОбъектаМетаданных);
		Иначе
			МетаданныеОбъекта = Метаданные.Документы.Найти(ИмяОбъектаМетаданных);
		КонецЕсли;
		Реквизиты      = Новый Массив;
		ТабличныеЧасти = Новый Массив;
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			Если РеквизитыИТабличныеЧастиПоУмолчанию.Реквизиты.Найти(Реквизит.Имя) <> Неопределено Тогда
				Реквизиты.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			Если РеквизитыИТабличныеЧастиПоУмолчанию.ТабличныеЧасти.Найти(ТабличнаяЧасть.Имя) <> Неопределено Тогда
				ТабличнаяЧасть.Добавить(ТабличнаяЧасть.Имя);
			КонецЕсли;
		КонецЦикла;
		
		РеквизитыДляКонтрольнойСуммы = Новый Структура;
		РеквизитыДляКонтрольнойСуммы.Вставить("Реквизиты",      Реквизиты);
		РеквизитыДляКонтрольнойСуммы.Вставить("ТабличныеЧасти", ТабличныеЧасти);
		
	КонецЕсли;
	
	ОбновитьСписокРеквизитов(РеквизитыДляКонтрольнойСуммы.Реквизиты);
	ОбновитьСписокТабличныхЧастей(РеквизитыДляКонтрольнойСуммы.ТабличныеЧасти);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиРеквизитов(ЗначениеФлажка)
	
	Для Каждого Стр Из РеквизитыОбъекта Цикл
		Стр.Проверять = ЗначениеФлажка;
	КонецЦикла;
	Если ТолькоВыбранныеТабличныеЧасти Тогда
		ОбновитьСписокРеквизитов(Новый Массив, ТолькоВыбранныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиТабличныхЧастей(ЗначениеФлажка)
	
	Для Каждого Стр Из ТабличныеЧастиОбъекта Цикл
		Стр.Проверять = ЗначениеФлажка;
	КонецЦикла;
	Если ТолькоВыбранныеТабличныеЧасти Тогда
		ОбновитьСписокТабличныхЧастей(Новый Массив, ТолькоВыбранныеТабличныеЧасти);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
