
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
    
	Поля.Добавить("Ссылка");
	Поля.Добавить("Счет");
	Поля.Добавить("Субконто1");
	Поля.Добавить("Субконто2");
	Поля.Добавить("Субконто3");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
		
	Если Не Данные.Свойство("Счет") Тогда
		Возврат;	
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	
	Наименование = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Данные.Счет);
	
	Если ЗначениеЗаполнено(Данные.Субконто1) Тогда
		
		Наименование.Добавить(Данные.Субконто1);
		
		Если ЗначениеЗаполнено(Данные.Субконто2) Тогда
			
			Наименование.Добавить(Данные.Субконто2);
            Если ЗначениеЗаполнено(Данные.Субконто3) Тогда
				Наименование.Добавить(Данные.Субконто3);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Представление = СтрСоединить(Наименование, ", ");
    
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ПолучитьИменаСубконто() Экспорт

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "Субконто1");
	Субконто.Вставить(2, "Субконто2");
	Субконто.Вставить(3, "Субконто3");
	
	Результат.Вставить("Счет", Субконто);
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКопию(СчетИсточник, Отказ = Ложь) Экспорт

	Объект = СчетИсточник.Скопировать();
	
	Попытка
		Объект.Записать();
	Исключение
		
		Шаблон = НСтр("ru = 'Не удалось создать копию <%1>: '");
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(Шаблон, СчетИсточник) + ОписаниеОшибки(), СчетИсточник, , , Отказ);
			
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

#КонецОбласти

#КонецЕсли
