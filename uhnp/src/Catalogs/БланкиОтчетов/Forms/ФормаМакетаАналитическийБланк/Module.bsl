&НаСервере
Процедура ИзменитьУровеньГруппировкиСтрокиСервер(ИмяОбласти,СтруктураОбластиДляВыделения,Направление)

	тОбласть = ПолеТабличногоДокументаМакет.Область(ИмяОбласти);
	
	ТабДокНовойГруппы = Новый ТабличныйДокумент;
	
	Если тОбласть.Лево = 0 Тогда
		
		Если СтруктураОбластиДляВыделения.ИмяОбластиГруппы=Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Выберите область, содержашую макет аналитики'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Возврат;
		Иначе	
			ГруппаМакетаРаскрытия = ТаблицаРаскрываемыхОбластейСтрок.НайтиСтроки(Новый Структура("ИмяОбластиГруппы",СтруктураОбластиДляВыделения.ИмяОбластиГруппы)); 
			
			тОбластьИсточник =  ТаблицаРаскрываемыхОбластейСтрок.НайтиСтроки(Новый Структура("ИмяОбласти,ИмяОбластиГруппы",СтруктураОбластиДляВыделения.ИмяОбласти,СтруктураОбластиДляВыделения.ИмяОбластиГруппы))[0];
			УровеньИсточника =  тОбластьИсточник.УровеньГруппировки;
			
			Если Направление = 1 Тогда //Сдвиг вверх
				Если УровеньИсточника =  1 Тогда
					Возврат;//Это первый уровень, рекурсивный сдвиг не поддерживаем
				Иначе	 
					УровеньПриемника  = УровеньИсточника-1;
				КонецЕсли;	
			Иначе
				Если УровеньИсточника =  ГруппаМакетаРаскрытия[ГруппаМакетаРаскрытия.Количество()-1].УровеньГруппировки Тогда
					Возврат;//Это последний уровень, рекурсивный сдвиг не поддерживаем 
				Иначе	 
					УровеньПриемника  = УровеньИсточника+1;
				КонецЕсли;	
			КонецЕсли;
			
			тОбластьПриемник  =  ТаблицаРаскрываемыхОбластейСтрок.НайтиСтроки(Новый Структура("УровеньГруппировки,ИмяОбластиГруппы",УровеньПриемника,СтруктураОбластиДляВыделения.ИмяОбластиГруппы))[0];
			
			НоваяТаблицаРаскрытия = ТаблицаРаскрываемыхОбластейСтрок.Выгрузить().СкопироватьКолонки();
			
			УровеньВГруппе = 1;
			РазмерМакетов  = 0;
			ИсходныйВерх   = ГруппаМакетаРаскрытия[0].Верх;
			
			Для Каждого Строка Из ГруппаМакетаРаскрытия Цикл
				
				НовСтр =  НоваяТаблицаРаскрытия.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Строка);
						
				Если Строка.УровеньГруппировки = УровеньИсточника Тогда					
					ЗаполнитьЗначенияСвойств(НовСтр,тОбластьПриемник);
  				ИначеЕсли Строка.УровеньГруппировки = УровеньПриемника Тогда						
					ЗаполнитьЗначенияСвойств(НовСтр,тОбластьИсточник);
				КонецЕсли;	
					
				НовСтр.УровеньГруппировки = УровеньВГруппе;				
				НовСтр.Верх = ИсходныйВерх+РазмерМакетов;				
				РазмерМакетов = РазмерМакетов+ Строка.ВысотаМакета;				
				УровеньВГруппе = УровеньВГруппе+1;
				
			КонецЦикла;	
                                   
			
			//Нарисуем новую иерархию уровней в техническом макете
			Для Каждого Строка Из НоваяТаблицаРаскрытия Цикл
			
				ОбластьИсточникПоИмени = ПолеТабличногоДокументаМакет.Область(Строка.ИмяОбласти); 				
				ОбластьИсточник = ПолеТабличногоДокументаМакет.Область(ОбластьИсточникПоИмени.Верх,0,ОбластьИсточникПоИмени.Верх+(Строка.ВысотаМакета-1),0);
				ОбластьПриемник = ТабДокНовойГруппы.Область(Строка.Верх,0,Строка.Верх+(Строка.ВысотаМакета-1),0);
                ТабДокНовойГруппы.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.БезСмещения);
				ОбластьПриемник.Имя = "";
				
				ТабДокНовойГруппы.Область(Строка.Верх,0,Строка.Низ).Имя = Строка.ИмяОбласти;
							
			КонецЦикла;	
			
			//Заменим группу в исходном макете
			ОбластьИсточникГруппа = ТабДокНовойГруппы.Область(ИсходныйВерх,0,ТабДокНовойГруппы.ВысотаТаблицы,0);
			ОбластьПриемникГруппа = ПолеТабличногоДокументаМакет.Область(СтруктураОбластиДляВыделения.ИмяОбластиГруппы); 
			ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточникГруппа,ОбластьПриемникГруппа,ТипСмещенияТабличногоДокумента.БезСмещения);
										
		КонецЕсли;	  
		
		ОбновитьСлужебныеОбласти(ПолеТабличногоДокументаМакет,Истина);	
		
		тОбластьИсточник =  ТаблицаРаскрываемыхОбластейСтрок.НайтиСтроки(Новый Структура("ИмяОбласти",СтруктураОбластиДляВыделения.ИмяОбласти));		
		
		Если  тОбластьИсточник.Количество() = 1 Тогда
			
			нВыделОбласть  =  ПолеТабличногоДокументаМакет.Область(тОбластьИсточник[0].Верх
			,0
			,тОбластьИсточник[0].Верх+(тОбластьИсточник[0].ВысотаМакета-1)
			,0);
			
			МассивВО       =  Новый Массив;
			МассивВО.Добавить(нВыделОбласть);
			Элементы.ПолеТабличногоДокументаМакет.УстановитьВыделенныеОбласти(МассивВО);
			
		КонецЕсли;
	
		
	КонецЕсли;	

	ЭтаФорма.Модифицированность = Истина;  
	
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьУровеньГруппировкиКолонкиСервер(ИмяОбласти,СтруктураОбластиДляВыделения,Направление)

	тОбласть = ПолеТабличногоДокументаМакет.Область(ИмяОбласти);
	
	ТабДокНовойГруппы = Новый ТабличныйДокумент;
	
	Если тОбласть.Верх = 0 Тогда
		
		Если СтруктураОбластиДляВыделения.ИмяОбластиГруппы=Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Выберите область, содержашую макет аналитики'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Возврат;
		Иначе	
			ГруппаМакетаРаскрытия = ТаблицаРаскрываемыхОбластейКолонок.НайтиСтроки(Новый Структура("ИмяОбластиГруппы",СтруктураОбластиДляВыделения.ИмяОбластиГруппы)); 
			
			тОбластьИсточник =  ТаблицаРаскрываемыхОбластейКолонок.НайтиСтроки(Новый Структура("ИмяОбласти,ИмяОбластиГруппы",СтруктураОбластиДляВыделения.ИмяОбласти,СтруктураОбластиДляВыделения.ИмяОбластиГруппы))[0];
			УровеньИсточника =  тОбластьИсточник.УровеньГруппировки;
			
			Если Направление = 1 Тогда //Сдвиг вверх
				Если УровеньИсточника =  1 Тогда
					Возврат;//Это первый уровень, рекурсивный сдвиг не поддерживаем
				Иначе	 
					УровеньПриемника  = УровеньИсточника-1;
				КонецЕсли;	
			Иначе
				Если УровеньИсточника =  ГруппаМакетаРаскрытия[ГруппаМакетаРаскрытия.Количество()-1].УровеньГруппировки Тогда
					Возврат;//Это последний уровень, рекурсивный сдвиг не поддерживаем 
				Иначе	 
					УровеньПриемника  = УровеньИсточника+1;
				КонецЕсли;	
			КонецЕсли;
			
			тОбластьПриемник  =  ТаблицаРаскрываемыхОбластейКолонок.НайтиСтроки(Новый Структура("УровеньГруппировки,ИмяОбластиГруппы",УровеньПриемника,СтруктураОбластиДляВыделения.ИмяОбластиГруппы))[0];
			
			НоваяТаблицаРаскрытия = ТаблицаРаскрываемыхОбластейКолонок.Выгрузить().СкопироватьКолонки();
			
			УровеньВГруппе = 1;
			РазмерМакетов  = 0;
			ИсходныйЛево   = ГруппаМакетаРаскрытия[0].Лево;
			
			Для Каждого Строка Из ГруппаМакетаРаскрытия Цикл
				
				НовСтр =  НоваяТаблицаРаскрытия.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Строка);
						
				Если Строка.УровеньГруппировки = УровеньИсточника Тогда					
					ЗаполнитьЗначенияСвойств(НовСтр,тОбластьПриемник);
  				ИначеЕсли Строка.УровеньГруппировки = УровеньПриемника Тогда						
					ЗаполнитьЗначенияСвойств(НовСтр,тОбластьИсточник);
				КонецЕсли;	
					
				НовСтр.УровеньГруппировки = УровеньВГруппе;				
				НовСтр.Лево 		= ИсходныйЛево+РазмерМакетов;				
				РазмерМакетов 		= РазмерМакетов+ Строка.ШиринаМакета;				
				УровеньВГруппе 		= УровеньВГруппе+1;
				
			КонецЦикла;	
                                   
			
			//Нарисуем новую иерархию уровней в техническом макете
			Для Каждого Строка Из НоваяТаблицаРаскрытия Цикл
			
				ОбластьИсточникПоИмени = ПолеТабличногоДокументаМакет.Область(Строка.ИмяОбласти); 				
				ОбластьИсточник = ПолеТабличногоДокументаМакет.Область(0,ОбластьИсточникПоИмени.Лево,0,ОбластьИсточникПоИмени.Лево+(Строка.ШиринаМакета-1));
				ОбластьПриемник = ТабДокНовойГруппы.Область(0,Строка.Лево,0,Строка.ЛЕво+(Строка.ШиринаМакета-1));
                ТабДокНовойГруппы.ВставитьОбласть(ОбластьИсточник,ОбластьПриемник,ТипСмещенияТабличногоДокумента.БезСмещения);
				ОбластьПриемник.Имя = "";
				
				ТабДокНовойГруппы.Область(0,Строка.Лево,0,Строка.Право).Имя = Строка.ИмяОбласти;
							
			КонецЦикла;	
			
			//Заменим группу в исходном макете
			ОбластьИсточникГруппа = ТабДокНовойГруппы.Область(0,ИсходныйЛево,0,ТабДокНовойГруппы.ШиринаТаблицы);
			ОбластьПриемникГруппа = ПолеТабличногоДокументаМакет.Область(СтруктураОбластиДляВыделения.ИмяОбластиГруппы); 
			ПолеТабличногоДокументаМакет.ВставитьОбласть(ОбластьИсточникГруппа,ОбластьПриемникГруппа,ТипСмещенияТабличногоДокумента.БезСмещения);
				
			//Обновим выделенную область
			
			
						
		КонецЕсли;	  
		
		ОбновитьСлужебныеОбласти(ПолеТабличногоДокументаМакет,Ложь,Истина);	
		
		тОбластьИсточник =  ТаблицаРаскрываемыхОбластейКолонок.НайтиСтроки(Новый Структура("ИмяОбласти",СтруктураОбластиДляВыделения.ИмяОбласти));	
			
		Если  тОбластьИсточник.Количество() = 1 Тогда
			
			нВыделОбласть  =  ПолеТабличногоДокументаМакет.Область(0
			,тОбластьИсточник[0].Лево
			,0
			,тОбластьИсточник[0].Лево+(тОбластьИсточник[0].ШиринаМакета-1));
			
			МассивВО       =  Новый Массив;
			МассивВО.Добавить(нВыделОбласть);
			Элементы.ПолеТабличногоДокументаМакет.УстановитьВыделенныеОбласти(МассивВО);
			
		КонецЕсли;
		
	КонецЕсли;	

	ЭтаФорма.Модифицированность = Истина;  
  
	
	
КонецПроцедуры


#КонецОбласти

#Область РаботаСКонструкторомФормул

&НаКлиенте
Процедура ИзменитьОтборОперанда(Команда)
	
	ВыделенныйТекст  	= СокрЛП(Элементы.ТекстФормулы.ВыделенныйТекст); 
	
	Если НЕ ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		СтрокаНач=0;
		СтрокаКон=0;
		КолонкаНач=0;
		КолонкаКон=0;
		
		Элементы.ТекстФормулы.ПолучитьГраницыВыделения(СтрокаНач,
		КолонкаНач,
		СтрокаКон,
		КолонкаКон);
		
		ИсходныйТекстФормулы = (ТекстФормулы.ПолучитьТекст());	
		
		Если КолонкаНач> СтрДлина(ИсходныйТекстФормулы) Тогда
			 Возврат;
		КонецЕсли;	
		
		ПозицияПравойСкобки  = СтрНайти(ИсходныйТекстФормулы,"]",,КолонкаКон,1);
		ПозицияЛевойСкобки   = СтрНайти(ИсходныйТекстФормулы,"[",НаправлениеПоиска.СКонца,КолонкаНач,1);
		
		тПозицияПравойСкобки  = СтрНайти(ИсходныйТекстФормулы,"[",,КолонкаКон,1);
		тПозицияЛевойСкобки   = СтрНайти(ИсходныйТекстФормулы,"]",НаправлениеПоиска.СКонца,КолонкаНач,1);

		Если ПозицияЛевойСкобки>КолонкаНач ИЛИ ПозицияПравойСкобки<КолонкаКон Тогда
			 Возврат;
		КонецЕсли;	

		Если ПозицияПравойСкобки>0 И ПозицияЛевойСкобки>0 Тогда
			 ВыделенныйТекст = Сред(ИсходныйТекстФормулы,ПозицияЛевойСкобки,ПозицияПравойСкобки - ПозицияЛевойСкобки+1);
		КонецЕсли;		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		ГрупповойРежим 		= Ложь;
		СтруктураПараметров = ПолучитьРасшифровкуОперандовТаблицуФормулы(ВыделенныйТекст,ГрупповойРежим);		
	КонецЕсли;	
	
	Если СтруктураПараметров = Неопределено Тогда
		 Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("Бланк,ГрупповойРежим,ТзРасшифровкаОтборовАдрес,ТЗРасшифровкаОтборовГруппРаскрытия,ОтображатьСуммуВДопВалюте"
	,Бланк
	,ГрупповойРежим
	,СтруктураПараметров.ТзРасшифровкаОтборов
	,СтруктураПараметров.ТЗРасшифровкаОтборовГруппРаскрытия
	,СтруктураПараметров.ОтображатьСуммуВДопВалюте);	   	
	
	Оповещение = Новый ОписаниеОповещения("ФормаРедактированияОтборовОперандаЗавершение", ЭтаФорма);

	ОткрытьФорму("Обработка.АналитическийБланк.Форма.ФормаРедактированияОтборов", ПараметрыФормы,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
  
