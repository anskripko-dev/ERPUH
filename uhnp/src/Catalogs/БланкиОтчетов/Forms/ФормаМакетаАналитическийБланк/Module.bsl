		сОбласть   = ПолеТабличногоДокументаМакет.Область(ИмяОбласти);
		
		Если ОбластьПриемник.Право > сОбласть.Право Тогда	
			нОбласть   = ПолеТабличногоДокументаМакет.Область(0, сОбласть.Лево,0,сОбласть.Право+1);
