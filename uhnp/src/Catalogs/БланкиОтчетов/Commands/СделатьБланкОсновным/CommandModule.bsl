
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если ПараметрКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если УстановитьБланкОсновным(ПараметрКоманды) Тогда
		КартинкаОповещения = БиблиотекаКартинок.Информация32;
		ТекстОповещения = НСтр("ru = 'Настройка бланка'");
		ПояснениеОповещения = НСтр("ru = 'Бланк %БланкОтчета% установлен основным'");
		ПояснениеОповещения = СтрЗаменить(ПояснениеОповещения, "%БланкОтчета%", Строка(ПараметрКоманды));
		ПоказатьОповещениеПользователя(ТекстОповещения, , ПояснениеОповещения, КартинкаОповещения);
		Оповестить("ОбновитьБланки");
	Иначе
		ТекстСообщения = НСтр("ru = 'Установка бланка %БланкОтчета% основным не удалась'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%БланкОтчета%", Строка(ПараметрКоманды));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьБланкОсновным(БланкОтчета)
	
	Отказ = Ложь;
	ДанныеБланка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БланкОтчета, "ЭтоГруппа, РежимБланка, Владелец");
	
	Если ДанныеБланка.ЭтоГруппа Тогда
		ТекстСообщения = НСтр("ru = 'Невозможно установить основным бланком группу ""%1""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, БланкОтчета);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
	Иначе
		Если ДанныеБланка.РежимБланка = 1 Тогда
			УправлениеОтчетамиУХ.ЗаписатьНастройкуПоУмолчаниюОбработкиШаблонов(ДанныеБланка.Владелец, "БланкСводнойТаблицы", БланкОтчета, , Отказ);
		ИначеЕсли ДанныеБланка.РежимБланка = 2 Тогда
			УправлениеОтчетамиУХ.ЗаписатьНастройкуПоУмолчаниюОбработкиШаблонов(ДанныеБланка.Владелец, "БланкДляОтображения", БланкОтчета, , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции
