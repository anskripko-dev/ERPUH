#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьПараметрыОплаты(Положение, ИД) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК КалендарьГрафика,
		|	ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения_КалендарьГрафика
		|ИЗ
		|	Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|ГДЕ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Ссылка = &Положение
		|	И ПоложениеОЗакупкахПараметрыЗакупки.ИД = &ИД
		|	И ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.КалендарьГрафика)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК ГрафикОплаты,
		|	ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения_ГрафикОплаты
		|ИЗ
		|	Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|ГДЕ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Ссылка = &Положение
		|	И ПоложениеОЗакупкахПараметрыЗакупки.ИД = &ИД
		|	И ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.Ссылка КАК Ссылка,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.НомерСтроки КАК НомерСтроки,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.ИД КАК ИД,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.ВариантОтсчета КАК ВариантОтсчета,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.ВариантОплаты КАК ВариантОплаты,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.ПроцентЗалогаЗаТару КАК ПроцентЗалогаЗаТару,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.Сдвиг КАК Сдвиг
		|ИЗ
		|	Справочник.ПоложениеОЗакупках.ЭтапыГрафикаОплаты КАК ПоложениеОЗакупкахЭтапыГрафикаОплаты
		|ГДЕ
		|	ПоложениеОЗакупкахЭтапыГрафикаОплаты.Ссылка = &Положение
		|	И ПоложениеОЗакупкахЭтапыГрафикаОплаты.ИД = &ИД";
	
	Запрос.УстановитьПараметр("ИД", 		ИД);
	Запрос.УстановитьПараметр("Положение", 	Положение);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();      
	
	Результат = Новый Структура("КалендарьГрафика, ЗапретИзменения_КалендарьГрафика, ГрафикОплаты, ЗапретИзменения_ГрафикОплаты, ЭтапыГрафикаОплаты");
	
	Если Не РезультатЗапроса[0].Пустой() Тогда  
		
		Выборка = РезультатЗапроса[0].Выбрать();
		Выборка.Следующий();               
		
		Результат.КалендарьГрафика 					= Выборка.КалендарьГрафика; 
		Результат.ЗапретИзменения_КалендарьГрафика 	= Выборка.ЗапретИзменения_КалендарьГрафика;  
		
	КонецЕсли; 
	
	Если Не РезультатЗапроса[1].Пустой() Тогда      
		
		Выборка = РезультатЗапроса[1].Выбрать();
		Выборка.Следующий();                         
		
		Результат.ГрафикОплаты 					= Выборка.ГрафикОплаты; 
		Результат.ЗапретИзменения_ГрафикОплаты 	= Выборка.ЗапретИзменения_ГрафикОплаты; 
		
	КонецЕсли;
	
	Если Не РезультатЗапроса[2].Пустой() Тогда   
		
		Выборка = РезультатЗапроса[2].Выгрузить();
		Результат.ЭтапыГрафикаОплаты = Выборка;   
		
	КонецЕсли;   
	
	Результат.Вставить("ПоложениеОЗакупках", 	Положение); 
	Результат.Вставить("УИДУсловия", 			ИД);
	
	Возврат Результат;

КонецФункции // ПолучитьПараметрыОплаты()

Функция ОбновитьСпособыЗакупкиИзПоложений() Экспорт   

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Свойство,
		|	ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
		|	ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
		|	ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|	ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
		|	ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД
		|ПОМЕСТИТЬ СпособыЗакупки
		|ИЗ
		|	Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|ГДЕ
		|	ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки)
		|	И ПоложениеОЗакупкахПараметрыЗакупки.Значение ССЫЛКА Перечисление.СпособыВыбораПоставщика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СпособыЗакупки.Свойство КАК Параметр,
		|	СпособыЗакупки.Значение КАК Значение,
		|	СпособыЗакупки.Использовать КАК Использовать,
		|	СпособыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|	СпособыЗакупки.Ссылка КАК Ссылка,
		|	СпособыЗакупки.ИД КАК ИД,
		|	ЕСТЬNULL(ВложенныйЗапросМСП.Значение, ЛОЖЬ) КАК МСП,
		|	ЕСТЬNULL(ВложенныйЗапросМСПСубПодряд.Значение, ЛОЖЬ) КАК МСПСубПодряд,
		|	ЕСТЬNULL(ВложенныйЗапросЭлектроннаяФорма.Значение, ЛОЖЬ) КАК ЭлектроннаяФорма,
		|	ЕСТЬNULL(ВложенныйЗапросЗакрытыйСпособ.Значение, ЛОЖЬ) КАК ЗакрытыйСпособ
		|ИЗ
		|	СпособыЗакупки КАК СпособыЗакупки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Свойство,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД
		|		ИЗ
		|			Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|		ГДЕ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП)) КАК ВложенныйЗапросМСП
		|		ПО СпособыЗакупки.Ссылка = ВложенныйЗапросМСП.Ссылка
		|			И СпособыЗакупки.ИД = ВложенныйЗапросМСП.ИД
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Свойство,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД
		|		ИЗ
		|			Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|		ГДЕ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.СубподрядчикиСМП)) КАК ВложенныйЗапросМСПСубПодряд
		|		ПО СпособыЗакупки.Ссылка = ВложенныйЗапросМСПСубПодряд.Ссылка
		|			И СпособыЗакупки.ИД = ВложенныйЗапросМСПСубПодряд.ИД
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Свойство,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД
		|		ИЗ
		|			Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|		ГДЕ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.Электронно)) КАК ВложенныйЗапросЭлектроннаяФорма
		|		ПО СпособыЗакупки.Ссылка = ВложенныйЗапросЭлектроннаяФорма.Ссылка
		|			И СпособыЗакупки.ИД = ВложенныйЗапросЭлектроннаяФорма.ИД
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Свойство,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения,
		|			ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
		|			ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД
		|		ИЗ
		|			Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
		|		ГДЕ
		|			ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ГосТайна)) КАК ВложенныйЗапросЗакрытыйСпособ
		|		ПО СпособыЗакупки.Ссылка = ВложенныйЗапросЗакрытыйСпособ.Ссылка
		|			И СпособыЗакупки.ИД = ВложенныйЗапросЗакрытыйСпособ.ИД";
	
	
	Для Каждого КлючИЗначение Из СоответствиеСвойствСпособаЗакупки() Цикл 
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);	
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить(); 
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();      
	ТаблицаРезультат.Колонки.Добавить("СпособыВыбораПоставщикаСсылка");   
	
	НачатьТранзакцию();
	Попытка
	
		Для Каждого СтрокаРезультат Из ТаблицаРезультат Цикл
			Если Не ЗначениеЗаполнено(СтрокаРезультат.СпособыВыбораПоставщикаСсылка) Тогда    
				СпособОбъект = Справочники.СпособыВыбораПоставщика.СоздатьЭлемент();   
				ЗаполнитьЗначенияСвойств(СпособОбъект, СтрокаРезультат); 
				СпособОбъект.Наименование = Строка(СтрокаРезультат.Значение)
											+ ?(СтрокаРезультат.МСП 			= Истина, 	" МСП", "")
											+ ?(СтрокаРезультат.МСПСубПодряд 	= Истина, 	" МСПСубПодряд", "")
											+ ?(СтрокаРезультат.ЭлектроннаяФорма = Истина, 	" ЭлектроннаяФорма", "")
											+ ?(СтрокаРезультат.ЗакрытыйСпособ 	= Истина, 	" ЗакрытыйСпособ", ""); 
				СпособОбъект.Записать(); 
				
				ПоляПоиска = "Параметр, Значение, Использовать, МСП, МСПСубПодряд, ЭлектроннаяФорма, ЗакрытыйСпособ";  
				СтруктураПоиска = Новый Структура(ПоляПоиска);    
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаРезультат, ПоляПоиска);
				СтрокиСпособа = ТаблицаРезультат.НайтиСтроки(СтруктураПоиска);    
				
				Для Каждого НайденнаяСтрока Из СтрокиСпособа Цикл  
					
					НайденнаяСтрока.СпособыВыбораПоставщикаСсылка = СпособОбъект.Ссылка;
					НайденнаяСтрока.Значение = СпособОбъект.Ссылка;
					
					ПоложениеОбъект = НайденнаяСтрока.Ссылка.ПолучитьОбъект();  
					ПараметрыЗаполнения = Новый Структура("Значение, Использовать, ЗапретИзменения, Параметр"); 
					ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, НайденнаяСтрока); 
					ЗаписатьИзменениеРеквизитаРасшифровкиNTСервер(ПоложениеОбъект, НайденнаяСтрока.ИД, ПараметрыЗаполнения); 
					ПоложениеОбъект.Записать();
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;    
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПоложениеОЗакупкахПараметрыЗакупки.Ссылка КАК Ссылка,
			|	ПоложениеОЗакупкахПараметрыЗакупки.НомерСтроки КАК НомерСтроки,
			|	ПоложениеОЗакупкахПараметрыЗакупки.ИД КАК ИД,
			|	ПоложениеОЗакупкахПараметрыЗакупки.Свойство КАК Параметр,
			|	ПоложениеОЗакупкахПараметрыЗакупки.Значение КАК Значение,
			|	ПоложениеОЗакупкахПараметрыЗакупки.Использовать КАК Использовать,
			|	ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения КАК ЗапретИзменения
			|ИЗ
			|	Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
			|ИТОГИ ПО
			|	Ссылка,
			|	ИД";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСсылка.Следующий() Цикл
		
			ВыборкаИД = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			СправочникОбъект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
		
			Пока ВыборкаИД.Следующий() Цикл
		
				ВыборкаДетальныеЗаписи = ВыборкаИД.Выбрать();
		
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
					
					Если ВыборкаДетальныеЗаписи.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки Тогда
						ПараметрыЗаполнения = Новый Структура("Значение, Использовать, ЗапретИзменения, Параметр"); 
						ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыборкаДетальныеЗаписи); 
						ЗаписатьИзменениеРеквизитаРасшифровкиNTСервер(СправочникОбъект, ВыборкаИД.ИД, ПараметрыЗаполнения);
					КонецЕсли;  
					
					Если ВыборкаДетальныеЗаписи.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП
						Или ВыборкаДетальныеЗаписи.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.ЗакупкаИВПиЛС Тогда    
						
						ПараметрыЗаполнения = Новый Структура("Значение, Использовать, ЗапретИзменения, Параметр"); 
						ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыборкаДетальныеЗаписи);       
						ПараметрыЗаполнения.ЗапретИзменения = Истина;
						ЗаписатьИзменениеРеквизитаРасшифровкиNTСервер(СправочникОбъект, ВыборкаИД.ИД, ПараметрыЗаполнения); 
						
					КонецЕсли; 
					
				КонецЦикла; 
				
			КонецЦикла;   
			
			СправочникОбъект.Записать();
			
		КонецЦикла;  
		
	ЗафиксироватьТранзакцию();
		
	Исключение      
		
		ОтменитьТранзакцию();    
		Информация = ИнформацияОбОшибке();
		ВызватьИсключение ПодробноеПредставлениеОшибки(Информация); 
		
	КонецПопытки;
	
	ПланыВидовХарактеристик.ПараметрыЗакупки.ПервоначальноеЗаполнениеПВХПараметрыЗакупки();

КонецФункции // ОбновитьСпособыЗакупкиИзПоложений()


Процедура ЗаписатьИзменениеРеквизитаРасшифровкиNTСервер(Знач Объект, Знач ИД, Знач ПараметрыЗаполнения) Экспорт
	
	Перем СтрокаРасшифровки, Строки, СтруктураПоиска, Свойство, Параметр, Значение;
	
	УстановитьЗначениеПараметраРасшифровки(Объект, ИД, ПараметрыЗаполнения, ПараметрыЗаполнения.Параметр, ПараметрыЗаполнения.Значение);  
	
	Если ПараметрыЗаполнения.Параметр = ПланыВидовХарактеристик.ПараметрыЗакупки.СпособЗакупки Тогда    
		
		СоответствиеСвойств = СоответствиеСвойствСпособаЗакупки();
		ЗначенияРеквизитов 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Значение, "МСП, МСПСубПодряд, ЭлектроннаяФорма, ЗакрытыйСпособ"); 
		
		Для Каждого КлючИЗначение Из ЗначенияРеквизитов Цикл     
			УстановитьЗначениеПараметраРасшифровки(Объект, ИД, ПараметрыЗаполнения, 
													СоответствиеСвойств.Получить(КлючИЗначение.Ключ), 
													КлючИЗначение.Значение); 
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Функция СоответствиеСвойствСпособаЗакупки() Экспорт
	
	Перем СоответствиеСвойств;
	
	СоответствиеСвойств = Новый Соответствие;
	СоответствиеСвойств.Вставить("МСП", 			ПланыВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП);
	СоответствиеСвойств.Вставить("МСПСубПодряд", 	ПланыВидовХарактеристик.ПараметрыЗакупки.СубподрядчикиСМП);
	СоответствиеСвойств.Вставить("ЭлектроннаяФорма", ПланыВидовХарактеристик.ПараметрыЗакупки.Электронно);
	СоответствиеСвойств.Вставить("ЗакрытыйСпособ", 	ПланыВидовХарактеристик.ПараметрыЗакупки.ГосТайна);  
		
	Возврат СоответствиеСвойств;

КонецФункции

Процедура УстановитьЗначениеПараметраРасшифровки(Знач Объект, Знач ИД, Знач ПараметрыЗаполнения, Знач Свойство, Знач Значение)
	
	Перем СтрокаРасшифровки, Строки, СтруктураПоиска;
	
	СтруктураПоиска = Новый Структура("ИД, Свойство", ИД, Свойство);
	Строки = Объект.ПараметрыЗакупки.НайтиСтроки(СтруктураПоиска); 
	
	Если Строки.Количество() = 0 Тогда
		СтрокаРасшифровки 			= Объект.ПараметрыЗакупки.Добавить();
		СтрокаРасшифровки.ИД 		= ИД;
		СтрокаРасшифровки.Свойство 	= Свойство; 
		СтрокаРасшифровки.Значение 	= Значение;
	Иначе
		СтрокаРасшифровки 			= Строки[0];  
		СтрокаРасшифровки.Значение 	= Значение;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, ПараметрыЗаполнения, "Использовать, ЗапретИзменения");     
	
	Если СтрокаРасшифровки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ПриоритетСМП Тогда
		СтрокаРасшифровки.ЗапретИзменения = Истина; 
	ИначеЕсли СтрокаРасшифровки.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ЗакупкаИВПиЛС Тогда
		СтрокаРасшифровки.ЗапретИзменения = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецЕсли