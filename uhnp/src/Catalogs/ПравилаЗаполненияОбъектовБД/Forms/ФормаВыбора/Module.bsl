
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.Отбор)=Тип("Структура") И Параметры.Отбор.Свойство("Владелец") Тогда
		
		ДокументБД=Параметры.Отбор.Владелец;
		ОбновитьОтборПоВладельцу();
	Иначе
		
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПравилаЗаполненияОбъектовБД.Владелец КАК Владелец
		|ИЗ
		|	Справочник.ПравилаЗаполненияОбъектовБД КАК ПравилаЗаполненияОбъектовБД
		|ГДЕ
		|	ПравилаЗаполненияОбъектовБД.Владелец.Владелец = ЗНАЧЕНИЕ(Справочник.ТипыБазДанных.ТекущаяИБ)
		|	И НЕ ПравилаЗаполненияОбъектовБД.ПометкаУдаления
		|	И ПравилаЗаполненияОбъектовБД.Владелец ССЫЛКА Справочник.ДокументыБД";
		
		Результат=Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			
			ДокументБД=Результат.Владелец;
			ОбновитьОтборПоВладельцу();
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборПоВладельцу()
	
	ОбщегоНазначенияКлиентСерверУХ.УстановитьЭлементОтбора(Список.Отбор,"Владелец",ДокументБД,ВидСравненияКомпоновкиДанных.Равно,,Истина);
				
КонецПроцедуры // ОбновитьОтборПоВладельцу()

&НаКлиенте
Процедура ДокументБДПриИзменении(Элемент)
	
	ОбновитьОтборПоВладельцу();
	
КонецПроцедуры
