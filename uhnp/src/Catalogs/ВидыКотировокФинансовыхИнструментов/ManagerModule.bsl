Функция ТекстЗапросаКотировок(НомераТаблиц = Неопределено) Экспорт

	Если НомераТаблиц <> Неопределено Тогда
		НомераТаблиц.Вставить("ЗначенияКотировок", НомераТаблиц.Количество());
	КонецЕсли;
	
	Возврат
	"ВЫБРАТЬ
	|	втКотировки.ВидКотировки КАК ВидКотировки,
	|	втКотировки.Значение
	|
	|ИЗ
	|	РегистрСведений.ЗначенияКотировокФИ.СрезПоследних(
	|			&Дата,
	|			ВидКотировки В
	|				(ВЫБРАТЬ
	|					т.ВидКотировки
	|				ИЗ
	|					втВидыКотировок КАК т)) КАК втКотировки";
	
КонецФункции

Процедура ПроверитьДублиКотировки(Котировка, Отказ = Ложь) Экспорт

	Если Котировка.ТипКотировки <> Перечисления.ТипыКотировокФинансовыхИнструментов.КурсВалюты
		И Котировка.ТипКотировки <> Перечисления.ТипыКотировокФинансовыхИнструментов.КотировкаЦеннойБумаги
		И Котировка.ТипКотировки <> Перечисления.ТипыКотировокФинансовыхИнструментов.БанковскаяКотировка
		Тогда
		Возврат; 	
	КонецЕсли;  
	
	Запрос = Новый Запрос(ТекстЗапроса_ЕстьДубли());
	
	Запрос.УстановитьПараметр("Ссылка", 				Котировка.Ссылка);
	Запрос.УстановитьПараметр("ТипКотировки", 			Котировка.ТипКотировки);
	Запрос.УстановитьПараметр("ЦеннаяБумага", 			Котировка.ЦеннаяБумага);
	Запрос.УстановитьПараметр("Контрагент", 			Котировка.Контрагент);
	Запрос.УстановитьПараметр("Страна", 				Котировка.Страна);
	Запрос.УстановитьПараметр("ФункциональнаяВалюта", 	Котировка.ФункциональнаяВалюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Котировка дублирует котировку <%1>'");
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(Шаблон, РезультатЗапроса.Выгрузить()[0].Ссылка), Котировка,,, Отказ);
	
КонецПроцедуры 

Процедура ПроверитьИдентификатор(Котировка, Отказ = Ложь) Экспорт

	Если Котировка.ИдентификаторДляЗагрузки = "" Тогда
		Возврат; 	
	КонецЕсли;  
	
	Запрос = Новый Запрос(ТекстЗапроса_ЕстьДублиИдентификатора());
	
	Запрос.УстановитьПараметр("Ссылка", 					Котировка.Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторДляЗагрузки", 	Котировка.ИдентификаторДляЗагрузки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Котировка дублирует котировку <%1>'");
	ТекстСообщения =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, РезультатЗапроса.Выгрузить()[0].Ссылка);
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Котировка,,, Отказ);
	
КонецПроцедуры


