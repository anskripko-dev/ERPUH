Функция ТекстЗапроса_ЕстьДубли()

	Возврат
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКотировокФинансовыхИнструментов КАК т
	|ГДЕ
	|	т.Ссылка <> &Ссылка
	|	И т.ТипКотировки = &ТипКотировки
	|	И т.ФункциональнаяВалюта = &ФункциональнаяВалюта
	|	И ВЫБОР т.ТипКотировки
	|			КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.КурсВалюты)
	|				ТОГДА т.Страна = &Страна
	|			КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.БанковскаяКотировка)
	|				ТОГДА т.Контрагент = &Контрагент
	|			КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.КотировкаЦеннойБумаги)
	|				ТОГДА т.ЦеннаяБумага = &ЦеннаяБумага
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";

КонецФункции   

Функция ТекстЗапроса_ЕстьДублиИдентификатора()

	Возврат
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКотировокФинансовыхИнструментов КАК Справочник
	|ГДЕ
	|	Справочник.Ссылка <> &Ссылка
	|	И Справочник.ИдентификаторДляЗагрузки = &ИдентификаторДляЗагрузки";

КонецФункции

