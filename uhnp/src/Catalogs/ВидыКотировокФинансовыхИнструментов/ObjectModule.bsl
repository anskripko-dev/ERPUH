#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда		
		ДанныеЗаполнения = Новый Структура;	
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("ФункциональнаяВалюта", 
		ОбщегоНазначенияПовтИспУХ.ПолучитьВалютуРегламентированногоУчета());
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;	
	КонецЕсли;
	
	Справочники.ВидыКотировокФинансовыхИнструментов.ПроверитьДублиКотировки(ЭтотОбъект, Отказ);
	Справочники.ВидыКотировокФинансовыхИнструментов.ПроверитьИдентификатор(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти

#КонецЕсли

