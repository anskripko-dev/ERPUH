
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаспределятьПолученныеКорректировки = (Объект.ЧислоИтераций > 0);
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ПодготовитьФормуНаСервере(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ПодготовитьФормуНаСервере(ТекущийОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы
 
&НаКлиенте
Процедура ПланСчетовБДПриИзменении(Элемент)
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СчетаЗакрытияЗадатьСпискомПриИзменении(Элемент)
	
	Объект.УточненияСчетовЗакрытия.Очистить();
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределятьПолученныеКорректировкиПриИзменении(Элемент)
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	КэшируемыеЗначения = Форма.КэшируемыеЗначения;
	
	Элементы.ГруппаКатегорииСчетов.Видимость = Не Объект.СчетаЗакрытияЗадаются;
	Элементы.ГруппаНастройкиСчетовЗакрытия.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
	Если Объект.СчетаЗакрытияЗадаются Тогда
		Элементы.ГруппаНастройкиСчетовЗакрытия.Отображение = ОтображениеОбычнойГруппы.Нет;
	КонецЕсли;
	
	Элементы.ЧислоИтераций.ТолькоПросмотр = Не Форма.РаспределятьПолученныеКорректировки;
	Элементы.УточненияСчетовЗакрытияКорректировки.ТолькоПросмотр = Не Форма.РаспределятьПолученныеКорректировки;
	Элементы.УточненияСчетовЗакрытияКорректировки.Видимость = Форма.РаспределятьПолученныеКорректировки ИЛИ НЕ Объект.СчетаЗакрытияЗадаются;
	
	Если Объект.СчетаЗакрытияЗадаются Тогда
		Элементы.УточненияСчетовЗакрытия.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		Элементы.ГруппаНастройкиСчетовЗакрытия.ОтображатьЗаголовок = Ложь;
	Иначе 
		Элементы.УточненияСчетовЗакрытия.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСверху;
		Элементы.ГруппаНастройкиСчетовЗакрытия.ОтображатьЗаголовок = Истина;
	КонецЕсли;
	
	Если Не Форма.РаспределятьПолученныеКорректировки Тогда
		Объект.ЧислоИтераций = 0;
	КонецЕсли;
	
	Список = Элементы.УточненияСчетовЗакрытияКорректировки.СписокВыбора;
	
	Список.Очистить();
	Если Объект.СчетаЗакрытияЗадаются Тогда
		
		Список.Добавить(Корректировки_1_1());
		Список.Добавить(Корректировки_0_1());
		
	Иначе
		
		Список.Добавить(Корректировки_0_0());
		Список.Добавить(Корректировки_0_1());
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(ТекущийОбъект = Неопределено)
	
	Для каждого _ Из Объект.УточненияСчетовЗакрытия Цикл
		
		_.Корректировки = Корректировки_1_1();
		
		Если Не _.КорректироватьСтоимость И Не _.РаспределятьПолученныеКорректировки Тогда
			_.Корректировки = Корректировки_0_0();
		ИначеЕсли Не _.КорректироватьСтоимость И _.РаспределятьПолученныеКорректировки Тогда
			_.Корректировки = Корректировки_0_1();
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УточненияСчетовЗакрытияКорректировкиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.УточненияСчетовЗакрытия.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоКорректировкеСтроку(ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКорректировкеСтроку(ТекущаяСтрока)
	
	ТекущаяСтрока.КорректироватьСтоимость = Истина;
	ТекущаяСтрока.РаспределятьПолученныеКорректировки = Истина;
	
	Если ТекущаяСтрока.Корректировки = Корректировки_0_0() Тогда
		ТекущаяСтрока.КорректироватьСтоимость = Ложь;
		ТекущаяСтрока.РаспределятьПолученныеКорректировки = Ложь;
	ИначеЕсли ТекущаяСтрока.Корректировки = Корректировки_0_1() Тогда
		ТекущаяСтрока.КорректироватьСтоимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Корректировки_0_0()
	Возврат НСтр("ru = 'Исключить из закрытия'");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Корректировки_0_1()
	Возврат НСтр("ru = 'Только последующие корректировки'");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Корректировки_1_1()
	Возврат НСтр("ru = 'Первоначальное сальдо и последующие корректировки'");
КонецФункции

&НаКлиенте
Процедура УточненияСчетовЗакрытияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УточненияСчетовЗакрытия.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.СчетаЗакрытияЗадаются Тогда
		ТекущаяСтрока.Корректировки = Корректировки_1_1();
	Иначе
		ТекущаяСтрока.Корректировки = Корректировки_0_0();
	КонецЕсли;
	
	ЗаполнитьПоКорректировкеСтроку(ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

