#Область ОПК

&НаКлиенте
Процедура Подключаемый_Команда(Команда)

	ПостояннаяКоманда = ЭтаФорма["ПостоянныеКоманды"].НайтиПоЗначению(Команда.Имя);
	Если ПостояннаяКоманда <> Неопределено И ЗначениеЗаполнено(ПостояннаяКоманда.Представление) Тогда
		МассивПодстрок = СтрРазделить(ПостояннаяКоманда.Представление, ".");
		КлиентскийМодуль = ОбщегоНазначенияКлиент.ОбщийМодуль(МассивПодстрок[0]);
		Обработчик = Новый ОписаниеОповещения(МассивПодстрок[1], КлиентскийМодуль, Команда);
		ВыполнитьОбработкуОповещения(Обработчик, ЭтотОбъект);
	КонецЕсли;  
	
КонецПроцедуры

#Область НажатиеКонтроляСтатьи
&НаКлиенте
Процедура Подключаемый_УправлениеЛимитами(Команда)
	
	Завершение = Новый ОписаниеОповещения("НажатиеУправлениеЛимитамиЗавершение", 
											ЭтотОбъект);
	Если ЭтаФорма.Модифицированность Тогда
		ПоказатьВопрос(Завершение, 
						НСтр("ru = 'Сохранить изменения?'"),
						РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Завершение, КодВозвратаДиалога.Да);
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура НажатиеУправлениеЛимитамиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда 
		Если ЭтаФорма.Модифицированность Тогда
			ЭтаФорма.Записать();
		КонецЕсли;
		ПараметрыОткрытия = Новый Структура("ВидОперации, Статья, ВидБюджета", 
											4, 
											Объект.Ссылка,
											ЭтаФорма.ПараметрыЛимитированияВидБюджета);
		ОткрытьФорму("Отчет.УправлениеЛимитами.Форма", 
						Новый Структура("ПараметрыОткрытия", ПараметрыОткрытия), 
						ЭтаФорма, 
						Истина);
	КонецЕсли;

КонецПроцедуры
