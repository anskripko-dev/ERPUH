
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Отбор.Свойство("ПланСчетовБД") Тогда //если не передан
		
		ПС = МСФОУХ.ПланСчетовПоУмолчанию();
		
		ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора( Список.КомпоновщикНастроек.Настройки.Отбор, 
			"ПланСчетовБД", , ПС, , Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	КонецЕсли;
	
КонецПроцедуры
