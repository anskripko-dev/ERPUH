
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.ТипОбъектаМетаданных="Справочник";
		Объект.СпособВыбораИБ=Перечисления.СпособыВыбораИБДляОбменаНСИ.Все;
		Объект.НаправлениеОбмена=Перечисления.ВыгрузкаЗагрузка.Выгрузка;
		Объект.СпособЗапуска=Перечисления.СпособыЗапускаОбменаНСИ.РегламентноеЗадание;
		
	КонецЕсли;
	
	ТипОписаниеОбъектаТек=ПолучитьОписаниеТипаДляОграничения(Объект.ТипОбъектаМетаданных);
	Элементы.ФормаОтключитьВключить.Пометка=?(ЗначениеЗаполнено(Объект.Ссылка),Объект.Отключен,Ложь);
	
	ОбработатьКолонкуАдресОбмена();
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокИБНаСервере()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеВнешнимИБ.Владелец КАК ТипИБ
	|ПОМЕСТИТЬ ТипыИБ
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|ГДЕ
	|	СоответствиеВнешнимИБ.ОписаниеОбъектаТек = &ОписаниеОбъектаТек
	|И ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВнешниеИнформационныеБазы.Ссылка КАК АдресОбмена
	|ИЗ
	|	Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	|ГДЕ
	|	ВнешниеИнформационныеБазы.ТипБД В
	|			(ВЫБРАТЬ
	|				ТипыИБ.ТипИБ
	|			ИЗ
	|				ТипыИБ)";
	
	Если Объект.НаправлениеОбмена=Перечисления.ВыгрузкаЗагрузка.Выгрузка Тогда
		
		ТекстОтбор="(НЕ (СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы=ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.Предприятие77)
		|ИЛИ СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы=ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.ADO)))";
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"ИСТИНА",ТекстОтбор);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОписаниеОбъектаТек",Объект.ОписаниеОбъектаМетаданных);
	Объект.АдресацияОбменаНСИ.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокИБ(Команда)
	ЗаполнитьСписокИБНаСервере();
КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.АдресацияОбменаНСИ.Видимость=(Не Объект.СпособВыбораИБ=Перечисления.СпособыВыбораИБДляОбменаНСИ.Все);		
			
	Если Элементы.ФормаОтключитьВключить.Пометка Тогда
		
		Элементы.ФормаОтключитьВключить.ЦветТекста=Новый Цвет(255,0,0);
		Элементы.ФормаОтключитьВключить.Шрифт=Новый Шрифт(Элементы.ФормаОтключитьВключить.Шрифт, , , Истина);
		Элементы.ФормаОтключитьВключить.Заголовок=НСтр("ru = 'Отключен'");
		
	Иначе
		
		Элементы.ФормаОтключитьВключить.ЦветТекста=Новый Цвет(77,77,77);
		Элементы.ФормаОтключитьВключить.Шрифт=Новый Шрифт(Элементы.ФормаОтключитьВключить.Шрифт, , , Ложь);
		Элементы.ФормаОтключитьВключить.Заголовок=НСтр("ru = 'Отключить'");
		
	КонецЕсли; 
	
	ЗагрузкаДанных=(Объект.НаправлениеОбмена=Перечисления.ВыгрузкаЗагрузка.Загрузка);
	
	Элементы.АдресацияОбменаНСИОтбор.Видимость=ЗагрузкаДанных;
	Элементы.НастройкаОтбора.Видимость=(НЕ ЗагрузкаДанных);
	Элементы.ТолькоИзмененные.Видимость=(НЕ ЗагрузкаДанных);
		
КонецПроцедуры // УстановитьВидимость() 

&НаКлиенте
Процедура ПоВсемИБПриИзменении(Элемент)
	
	Объект.АдресацияОбменаНСИ.Очистить();
	ПриИзмененииСпособаВыбораИБ();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСпособаВыбораИБ()
	
	ОбработатьКолонкуАдресОбмена();
	УстановитьВидимость();
	
КонецПроцедуры // ПриИзмененииСпособаВыбораИБ()

&НаСервере
Процедура ОбработатьКолонкуАдресОбмена() 
	
	ТекстСпособВыбора=XMLСтрока(Объект.СпособВыбораИБ);
	
	Если ТекстСпособВыбора="ВыбранногоТипа" Тогда
		
		Элементы.АдресацияОбменаНСИАдресОбмена.Заголовок=НСтр("ru = 'Тип информационной базы'");
		Элементы.АдресацияОбменаНСИАдресОбмена.ОграничениеТипа=ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.ТипыБазДанных");
		
	ИначеЕсли ТекстСпособВыбора="Выбранные" Тогда
		
		Элементы.АдресацияОбменаНСИАдресОбмена.Заголовок=НСтр("ru = 'Внешняя информационная база'");
		Элементы.АдресацияОбменаНСИАдресОбмена.ОграничениеТипа=ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.ВнешниеИнформационныеБазы");
		
	КонецЕсли;	
		
КонецПроцедуры // ОбработатьКолонкуАдресОбмена() 

&НаКлиенте
Процедура ТипОбъектаМетаданныхПриИзменении(Элемент)
	
	ПриИзмененииТипаОбъектаМетаданных();		
		
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииТипаОбъектаМетаданных()
	
	ТипОписаниеОбъектаТек=ПолучитьОписаниеТипаДляОграничения(Объект.ТипОбъектаМетаданных);
	ПодготовитьПолеОписаниеОбъектаТек();
	
КонецПроцедуры // ПриИзмененииТипаОбъектаТекущейИБ()

&НаСервере
Функция ПолучитьОписаниеТипаДляОграничения(ТипОбъектаМетаданных)
	
	Если ТипОбъектаМетаданных="Справочник" Тогда
		
		ТипОписание="СправочникСсылка.СправочникиБД";
						
	ИначеЕсли ТипОбъектаМетаданных="ПланВидовХарактеристик" Тогда
		
		ТипОписание="СправочникСсылка.ПланыВидовХарактеристикБД";
				
	КонецЕсли;
	
	Возврат ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСсылка(ТипОписание);
		
КонецФункции // ПолучитьОграничениеТипаОписание() 

&НаКлиенте
Процедура ПодготовитьПолеОписаниеОбъектаТек()
	
	Элементы.ОписаниеОбъектаМетаданных.ОграничениеТипа=ТипОписаниеОбъектаТек;
	
	НовыйМассив = Новый Массив();
				
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец",ПредопределенноеЗначение("Справочник.ТипыБазДанных.ТекущаяИБ"));
	НовыйМассив.Добавить(НовыйПараметр); 
		
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ОтсутствуетВКонфигурации",Ложь);
	НовыйМассив.Добавить(НовыйПараметр);
		

	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	Элементы.ОписаниеОбъектаМетаданных.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры // ПодготовитьПолеОписаниеОбъектаВИБ()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодготовитьПолеОписаниеОбъектаТек();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОбменНаСервере()
		
	Если Модифицированность Тогда
		
		Записать();
		
	КонецЕсли;
	
	ОбменДаннымиНСИУХ.ВыполнитьОбменНСИПоПараметрам(Объект.Ссылка);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен(Команда) 
	
	Если НЕ ЗначениеЗаполнено(Объект.ОписаниеОбъектаМетаданных) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru='Не указан объект для обмена.'"));
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НаправлениеОбмена) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru='Не указано направление обмена.'"));
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьОбменНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТиповИБНаСервере()
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеВнешнимИБ.Владелец КАК АдресОбмена
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|ГДЕ
	|	СоответствиеВнешнимИБ.ОписаниеОбъектаТек = &ОписаниеОбъектаТек
	|И ИСТИНА";
	
	Если Объект.НаправлениеОбмена=Перечисления.ВыгрузкаЗагрузка.Выгрузка Тогда
		
		ТекстОтбор="(НЕ (СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы=ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.Предприятие77)
		|ИЛИ СоответствиеВнешнимИБ.Владелец.ВерсияПлатформы=ЗНАЧЕНИЕ(Перечисление.ПлатформыВнешнихИнформационныхБаз.ADO)))";
		
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"ИСТИНА",ТекстОтбор);
		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("ОписаниеОбъектаТек",Объект.ОписаниеОбъектаМетаданных);
	
	Объект.АдресацияОбменаНСИ.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокТиповИБ(Команда)
	ЗаполнитьСписокТиповИБНаСервере();
КонецПроцедуры 

&НаКлиенте
Процедура ОтключитьВключить(Команда)
	
	Элементы.ФормаОтключитьВключить.Пометка=Не Элементы.ФормаОтключитьВключить.Пометка;
	Объект.Отключен=Элементы.ФормаОтключитьВключить.Пометка;
	
	Модифицированность=Истина;
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыбораНастройкиИБ(ИдентификаторСтроки)
	
	СтрокаВИБ=Объект.АдресацияОбменаНСИ.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТипБД=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаВИБ.АдресОбмена,"ТипБД");
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	СоответствиеВнешнимИБ.ТипОбъектаВИБ КАК ТипОбъектаВИБ,
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ.Наименование КАК НаименованиеОбъектаВИБ
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |ГДЕ
	             |	СоответствиеВнешнимИБ.Владелец = &Владелец
	             |	И СоответствиеВнешнимИБ.ОписаниеОбъектаТек = &ОписаниеОбъектаТек";
	
	Запрос.УстановитьПараметр("Владелец",ТипБД);
	Запрос.УстановитьПараметр("ОписаниеОбъектаТек",Объект.ОписаниеОбъектаМетаданных);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("ИмяТаблицы",Результат.ТипОбъектаВИБ+"_"+Результат.НаименованиеОбъектаВИБ);
		СтруктураОтбора.Вставить("Владелец",ТипБД);
		
		Возврат СтруктураОтбора 
		
	Иначе
		
		Возврат СтрШаблон(Нстр("ru = 'Не удалось определить настройку соответствия для объекта %1
		|во внешней информационной базе %2 типа %3'"),Объект.ОписаниеОбъектаМетаданных,СтрокаВИБ.АдресОбмена,ТипБД);
		
	КонецЕсли;
		
КонецФункции // ПолучитьПараметрыВыбораНастройкиИБ() 

&НаСервере
Функция ПолучитьПараметрыВыбораНастройкиТипИБ(ИдентификаторСтроки)
	
	СтрокаТипВИБ=Объект.АдресацияОбменаНСИ.НайтиПоИдентификатору(ИдентификаторСтроки);
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	СоответствиеВнешнимИБ.ТипОбъектаВИБ КАК ТипОбъектаВИБ,
	             |	СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ.Наименование КАК НаименованиеОбъектаВИБ
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	             |ГДЕ
	             |	СоответствиеВнешнимИБ.Владелец = &Владелец
	             |	И СоответствиеВнешнимИБ.ОписаниеОбъектаТек = &ОписаниеОбъектаТек";
	
	Запрос.УстановитьПараметр("Владелец",СтрокаТипВИБ.АдресОбмена);
	Запрос.УстановитьПараметр("ОписаниеОбъектаТек",Объект.ОписаниеОбъектаМетаданных);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("ИмяТаблицы",Результат.ТипОбъектаВИБ+"_"+Результат.НаименованиеОбъектаВИБ);
		СтруктураОтбора.Вставить("Владелец",СтрокаТипВИБ.АдресОбмена);
		
		Возврат СтруктураОтбора 
		
	Иначе
		
		Возврат СтрШаблон(Нстр("ru = 'Не удалось определить настройку соответствия для объекта %1
		|в информационных базах типа %2'"),Объект.ОписаниеОбъектаМетаданных,СтрокаТипВИБ.АдресОбмена);
		
	КонецЕсли;
		
КонецФункции // ПолучитьПараметрыВыбораНастройкиИБ()

&НаСервере
Процедура ЗаполнитьАдресациюОбменаНаСервере()
	
	Если Объект.СпособВыбораИБ=Перечисления.СпособыВыбораИБДляОбменаНСИ.ВыбранногоТипа Тогда
		
		ЗаполнитьСписокТиповИБНаСервере();
		
	Иначе
		
		ЗаполнитьСписокИБНаСервере();
		
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАдресациюОбмена(Команда)
	ЗаполнитьАдресациюОбменаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АдресацияОбменаНСИОтборНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь; 
	
	Если НЕ ЗначениеЗаполнено(Объект.ОписаниеОбъектаМетаданных) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru='Не указан объект для обмена.'"));
		Возврат;
		
	КонецЕсли;
	
	ТекущиеДанные=Элементы.АдресацияОбменаНСИ.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.АдресОбмена) Тогда
		
		Если ТекстСпособВыбора="Выбранные" Тогда
			
			ПоказатьПредупреждение(,НСтр("ru='Не указана внешняя информационная база.'"));
			
		Иначе
			
			ПоказатьПредупреждение(,НСтр("ru='Не указан тип внешней информационной базы.'"));
			
		КонецЕсли;
			
		Возврат;
		
	КонецЕсли;  
	
	Если ТекстСпособВыбора="Выбранные" Тогда
		
		ДанныеОтбора=ПолучитьПараметрыВыбораНастройкиИБ(ТекущиеДанные.ПолучитьИдентификатор());
		
	Иначе
		
		ДанныеОтбора=ПолучитьПараметрыВыбораНастройкиТипИБ(ТекущиеДанные.ПолучитьИдентификатор());
		
	КонецЕсли;
		
	Если ТипЗнч(ДанныеОтбора)=Тип("Структура") Тогда 
		
		ОткрытьФорму("Справочник.СохраненныеНастройкиОтборов.ФормаВыбора",Новый	Структура("Отбор,ТекущаяСтрока",ДанныеОтбора,ТекущиеДанные.Отбор),Элемент);
		
	Иначе
		
		ПоказатьПредупреждение(,ДанныеОтбора);
		Возврат;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура НаправлениеОбменаПриИзменении(Элемент)
	
	УстановитьВидимость();
	
КонецПроцедуры 
