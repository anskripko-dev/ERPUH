		ЗаполнитьАналитикуПоСубконтоСчетаБД(ТаблицаПолей,ДанныеОперанда);
		ЗаполнитьАналитикуПоСубконтоСчетаБД(ТаблицаПолей,ДанныеОперанда,Ложь);
				 
	КонецЕсли;
	
	Возврат ТаблицаПолей;
			
КонецФункции // ПолучитьТаблицуВозможныхПолей()

Процедура ЗаполнитьАналитикуПоГруппеРаскрытия(ТаблицаПолей,ДанныеОперанда)
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	|	ГруппыРаскрытия.ВидАналитикиВалютаДт КАК ВидАналитикиВалютаДт";
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		ТекстЗапроса=ТекстЗапроса+СтрЗаменить(",	
		|	ВЫБОР
		|		КОГДА ГруппыРаскрытия.ВидАналитики# = НЕОПРЕДЕЛЕНО
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ГруппыРаскрытия.ВидАналитики#
		|	КОНЕЦ КАК ВидАналитики#","#",Индекс);
		
	КонецЦикла;	
	
	ТекстЗапроса=ТекстЗапроса+"
	|ИЗ
	|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
	|ГДЕ
	|	ГруппыРаскрытия.Ссылка = &Ссылка";
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка",ДанныеОперанда.ГруппаРаскрытияИсточник);
	ДанныеРаскрытия=Запрос.Выполнить().Выгрузить()[0];
	
	Если ЗначениеЗаполнено(ДанныеРаскрытия.ВидАналитикиВалютаДт) Тогда
		
		НоваяСтрока=ТаблицаПолей.Добавить();
		НоваяСтрока.ПолеБД="АналитикаВалюта";
		НоваяСтрока.ТипДанных="Справочник.Валюты";
		
	КонецЕсли;
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		Если ЗначениеЗаполнено(ДанныеРаскрытия["ВидАналитики"+Индекс]) Тогда
			
			МассивТипов=ДанныеРаскрытия["ВидАналитики"+Индекс].ТипЗначения.Типы();
			
			Если МассивТипов.Количество()=1 Тогда
				
				НоваяСтрока=ТаблицаПолей.Добавить();
				НоваяСтрока.ПолеБД="Аналитика"+Индекс; 
				НоваяСтрока.ТипДанных=Метаданные.НайтиПоТипу(МассивТипов[0]).ПолноеИмя();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры // ЗаполнитьАналитикуПоГруппеРаскрытия() 

Процедура ЗаполнитьАналитикуПоСубконтоСчетаБД(ТаблицаПолей,ДанныеОперанда,Дебетовый = Истина) Экспорт
	
	Если (Не Дебетовый И ПустаяСтрока(ДанныеОперанда.КоррСчет)) ИЛИ (ПустаяСтрока(ДанныеОперанда.Счет)) Тогда
		Возврат;
	КонецЕсли;
		
	ТекСчет = ?(Дебетовый, ДанныеОперанда.Счет, ДанныеОперанда.КоррСчет);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СчетаБДВидыСубконто.Номер КАК Номер,
	|	СчетаБДВидыСубконто.ТипДанных КАК ТипДанных
	|ИЗ
	|	Справочник.СчетаБД.ВидыСубконто КАК СчетаБДВидыСубконто
	|ГДЕ
	|	СчетаБДВидыСубконто.Ссылка = &ТекСчет"; 
	
	Запрос.УстановитьПараметр("ТекСчет",ТекСчет);
	ДанныеСубконто=Запрос.Выполнить().Выгрузить();
						
	Для Каждого ВидСубконто Из ДанныеСубконто Цикл
		
		СтрокаПоказателей                  = ТаблицаПолей.Добавить();			
				
		Если ЗначениеЗаполнено(ДанныеОперанда.КоррСчет) Тогда
			
			СтрокаПоказателей.ПолеБД          = "Субконто"+?(Дебетовый,"Дт","Кт") + ВидСубконто.Номер;
			
		Иначе
			
			СтрокаПоказателей.ПолеБД          = "Субконто"+ ВидСубконто.Номер;
			
		КонецЕсли;
		
		СтрокаПоказателей.ТипДанных=ВидСубконто.ТипДанных; 
						
	КонецЦикла;
		
КонецПроцедуры 


	
	
	
	
	


