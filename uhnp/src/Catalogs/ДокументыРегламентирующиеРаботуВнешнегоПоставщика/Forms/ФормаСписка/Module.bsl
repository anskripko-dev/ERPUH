
#Область ОбработкаОсновныхСобытийФормы


#КонецОбласти


#Область ОбработкаСобытийЭлементовФормы

&НаКлиенте
Процедура ОбработчикДобавитьФайл(Команда)
	Элементы.Список.ДобавитьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОткрытьФайл(Команда)
	ОткрытьФайл();
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыНаКлиенте


&НаКлиенте
Процедура ОткрытьФайл()
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено И НЕ ПустаяСтрока(ТекДанные.ИДФайла) Тогда
		ДанныеФайла = ПолучитьДанныеФайла(ТекДанные.ИДФайла, УникальныйИдентификатор);
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФайла(УникальныйИдентификатор,
	Знач ИдентификаторФормы = Неопределено,
	Знач ПолучатьСсылкуНаДвоичныеДанные = Истина)
	
	Файл = Справочники.ВнешнихПоставщиковПрисоединенныеФайлы.ПолучитьСсылку( Новый УникальныйИдентификатор(УникальныйИдентификатор));
	Возврат РаботаСФайлами.ДанныеФайла(Файл, ИдентификаторФормы, ПолучатьСсылкуНаДвоичныеДанные);
	
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыНаСервере


#КонецОбласти


