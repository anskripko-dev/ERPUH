	ОткрытьФайл();
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыНаКлиенте


&НаКлиенте
Процедура ОткрытьФайл()
	Если НЕ ПустаяСтрока(Объект.ИДФайла) Тогда
		ДанныеФайла = ПолучитьДанныеФайла(Объект.ИДФайла, УникальныйИдентификатор);
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФайла(УникальныйИдентификатор,
	Знач ИдентификаторФормы = Неопределено,
	Знач ПолучатьСсылкуНаДвоичныеДанные = Истина)
	
	Файл = Справочники.ВнешнихПоставщиковПрисоединенныеФайлы.ПолучитьСсылку( Новый УникальныйИдентификатор(УникальныйИдентификатор));
	Возврат РаботаСФайлами.ДанныеФайла(Файл, ИдентификаторФормы, ПолучатьСсылкуНаДвоичныеДанные);
	
КонецФункции

&НаКлиенте
Процедура ДобавитьФайл(ЗаписатьОбъект=Ложь)
	// выбрать и записать новый файл
	ДопПараметры = Новый Структура("ЗаписатьОбъект", ЗаписатьОбъект);
	//УстановитьСсылкуДокумента();
	ОписаниеОбработчикаДобавленияФайла = Новый ОписаниеОповещения(
						"ОбработчикДобавленияФайла", ЭтаФорма, ДопПараметры);
	//СвязанныеФайлыКлиентУХ.ДобавитьФайлВИБ(Объект.Ссылка, Объект.ИДФайла,
	//	ОписаниеОбработчикаДобавленияФайла,	ЭтаФорма.УникальныйИдентификатор);
	ДопПараметры = Новый Структура("ЗаписатьОбъект", ЗаписатьОбъект);
	ОписаниеОбработчикаДобавленияФайла = Новый ОписаниеОповещения("ОбработчикДобавленияФайла", ЭтаФорма, ДопПараметры);
	РаботаСФайламиКлиент.ДобавитьФайл(ОписаниеОбработчикаДобавленияФайла,Объект.Ссылка, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикДобавленияФайла(СсылкаНаФайл, ДопПараметры) Экспорт
	Если СсылкаНаФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = РаботаСФайламиКлиент.ДанныеФайла(СсылкаНаФайл.ФайлСсылка); 
	Если ДанныеФайла.Расширение = "" Тогда
		СообщениеОбОшибке = "Необходимо наличие расширения у добавляемого файла!";       
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибке);
		Возврат
	КонецЕсли;	
	ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеОбОшибке);
		
	Объект.ИмяФайла	 = ДанныеФайла.Наименование + ?(ПустаяСтрока(ДанныеФайла.Расширение), "", "." + ДанныеФайла.Расширение);
	Объект.ИДФайла	 = СсылкаНаФайл.ФайлСсылка.УникальныйИдентификатор();
	
	Если ПустаяСтрока(Объект.Наименование) Тогда
		Объект.Наименование = ДанныеФайла.Наименование;
	КонецЕсли;
	            
	Если ДопПараметры.ЗаписатьОбъект Тогда
		Записать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыНаСервере

&НаСервере
Процедура УстановитьСсылкуДокумента()
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Ссылка = Справочники.ДокументыРегламентирующиеРаботуВнешнегоПоставщика.ПолучитьСсылку(Новый УникальныйИдентификатор);
	КонецЕсли;
	//этотобъект.получить
КонецПроцедуры


#КонецОбласти
