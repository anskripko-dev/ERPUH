
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("ЭтоФормулаКолонки") 
		 И  Параметры.Отбор.ЭтоФормулаКолонки Тогда
			
		Если  Параметры.Режим = Перечисления.РежимыДоступаКФункциямСводнойТаблицы.ПолныйДоступ ИЛИ
			Параметры.Режим =  Перечисления.РежимыДоступаКФункциямСводнойТаблицы.РазработкаМакета Тогда
		Иначе	
			//ограничим возможность создавать формулы.
			ЭтаФорма.ТолькоПросмотр = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры
