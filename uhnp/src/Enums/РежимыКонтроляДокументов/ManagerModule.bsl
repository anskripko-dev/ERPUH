#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	ЕстьКакВБюджете = Параметры.Свойство("КакВБюджете");
	ТребуютсяКартинки = Параметры.Свойство("Картинки");
	
	Если Параметры.Свойство("КонтрольЛимитов") Тогда   
		
		Если Параметры.КонтрольЛимитов = Перечисления.РежимыКонтроляДокументов.НеКонтролировать Тогда
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.НеКонтролировать);
			СтандартнаяОбработка = Ложь;          
			
		ИначеЕсли Параметры.КонтрольЛимитов = Перечисления.РежимыКонтроляДокументов.Информировать ИЛИ
					Параметры.КонтрольЛимитов = Перечисления.РежимыКонтроляДокументов.Блокировать Тогда
					
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Информировать);
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Блокировать);
			СтандартнаяОбработка = Ложь; 			
		КонецЕсли;   
				
	ИначеЕсли ЕстьКакВБюджете Тогда
		
		ДанныеВыбора = Новый СписокЗначений;
		
		Если Параметры.Свойство("КонтрольЛимитов") 
			И Параметры.КонтрольЛимитов = Перечисления.РежимыКонтроляДокументов.ПустаяСсылка() Тогда
			// доступно только значение КакВБюджете
		Иначе
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Блокировать);
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Информировать);
			ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.НеКонтролировать);
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
	ИначеЕсли ТребуютсяКартинки Тогда
		ДанныеВыбора = Новый СписокЗначений;
		
		ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Блокировать);
		ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.Информировать);
		ДанныеВыбора.Добавить(Перечисления.РежимыКонтроляДокументов.НеКонтролировать);
		
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	Если НЕ СтандартнаяОбработка Тогда
		Если ЕстьКакВБюджете Тогда
			ДанныеВыбора.Вставить(0, Перечисления.РежимыКонтроляДокументов.ПустаяСсылка(), НСтр("ru = '<Как в бюджете>'"));
		КонецЕсли;
		
		//
		Если ТребуютсяКартинки Тогда
			Картинки = Новый Соответствие;
			Картинки.Вставить(Перечисления.РежимыКонтроляДокументов.ПустаяСсылка(), БиблиотекаКартинок.Пустая);
			Картинки.Вставить(Перечисления.РежимыКонтроляДокументов.Блокировать, БиблиотекаКартинок.Удалить);
			Картинки.Вставить(Перечисления.РежимыКонтроляДокументов.Информировать, БиблиотекаКартинок.Информация);
			Картинки.Вставить(Перечисления.РежимыКонтроляДокументов.НеКонтролировать, БиблиотекаКартинок.Реквизит);
			
			Для Поз = 0 По ДанныеВыбора.Количество()-1 Цикл
				ЭлементСписка = ДанныеВыбора[Поз];
				ЭлементСписка.Картинка = Картинки[ЭлементСписка.Значение];
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

