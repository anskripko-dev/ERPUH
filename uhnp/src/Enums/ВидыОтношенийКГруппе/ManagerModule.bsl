#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПодсказкаПоВидам() Экспорт

	Результат = Новый Соответствие;
	Для каждого ТекущееЗначение Из Метаданные.Перечисления.ВидыОтношенийКГруппе.ЗначенияПеречисления Цикл	
		
		ТекущийЭлемент = Перечисления.ВидыОтношенийКГруппе[ТекущееЗначение.Имя];
		Комментарий = "";
		
		Если ТекущийЭлемент = Материнское Тогда
			Комментарий = НСтр("ru = 'Консолидируется с расчетной долей 100% (независимо от указанной эффективной доли) и является основной единицей холдинга, на которую заведены все инвестиции'");
		ИначеЕсли ТекущийЭлемент = Дочернее Тогда
			Комментарий = НСтр("ru = 'Консолидируется в отчетности Группы с расчетной долей 100% (независимо от указанной эффективной доли)'");
		ИначеЕсли ТекущийЭлемент = Ассоциированное Тогда
			Комментарий = НСтр("ru = 'Не консолидируется в отчетности Группы, отражается по методу долевого участия (инвестиция равна доле в чистых активах)'");
		ИначеЕсли ТекущийЭлемент = Совместное Тогда
			Комментарий = НСтр("ru = 'Не консолидируется в отчетности Группы, отражается по методу долевого участия (инвестиция равна доле в чистых активах)'");
		ИначеЕсли ТекущийЭлемент = СвязанныеСтороны Тогда
			Комментарий = НСтр("ru = 'Не консолидируются, используются для сбора данных в части раскрытия операций со связанными сторонами'");
		ИначеЕсли ТекущийЭлемент = ТретьиСтороны Тогда
			Комментарий = НСтр("ru = 'Не консолидируются в отчетности Группы'");
		ИначеЕсли ТекущийЭлемент = СовместныеОперации Тогда
			Комментарий = НСтр("ru = 'Консолидируются в отчетности Группы пропорционально эффективной доле'");
		КонецЕсли;
		
		Результат.Вставить(ТекущийЭлемент, Комментарий);
		
	КонецЦикла;
	
	Возврат Результат; 
	
КонецФункции

#КонецЕсли
