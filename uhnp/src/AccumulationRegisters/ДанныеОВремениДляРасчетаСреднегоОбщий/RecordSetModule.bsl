#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем таблицу сотрудников и месяцев предыдущего состояния набора, 
	// т.к. по ним также нужно пересчитать корректировки.
	Запрос = РегистрыБЗК.ЗапросНабораИзБазыДанных(ЭтотОбъект, Замещение, "Сотрудник, Период", Истина, "ВТСотрудникиМесяцыПредыдущегоНабора");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	ДополнительныеСвойства.Вставить("МенеджерВременныхТаблиц", Запрос.МенеджерВременныхТаблиц);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ЗарплатаКадры.ОтключитьБизнесЛогикуПриЗаписи(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	// Объединяем данные ключевых измерений (сотрудник и месяц) до и после записи набора
	// таблицу ВТСотрудникиМесяцыПредыдущегоНабора получаем перед записью набора.
	
	МенеджерВременныхТаблиц = ДополнительныеСвойства.МенеджерВременныхТаблиц;
	
	Запрос = РегистрыБЗК.ЗапросНабораИзБазыДанных(ЭтотОбъект, Замещение, "Сотрудник, Период", Истина, "ВТСотрудникиМесяцыТекущегоНабора");
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПредыдущийНабор.Сотрудник КАК Сотрудник,
		|	НАЧАЛОПЕРИОДА(ПредыдущийНабор.Период, МЕСЯЦ) КАК Месяц
		|ПОМЕСТИТЬ ВТСотрудникиМесяцы
		|ИЗ
		|	ВТСотрудникиМесяцыПредыдущегоНабора КАК ПредыдущийНабор
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДанныеНабора.Сотрудник,
		|	НАЧАЛОПЕРИОДА(ДанныеНабора.Период, МЕСЯЦ)
		|ИЗ
		|	ВТСотрудникиМесяцыТекущегоНабора КАК ДанныеНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТСотрудникиМесяцыПредыдущегоНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТСотрудникиМесяцыТекущегоНабора";
	
	Запрос.Выполнить();
	
	// Если пишется пустой набор записей, то игнорируем движения текущего регистратора.
	// Такое правило применяем для обновления корректировок при отмене проведения, 
	// т.к. на момент обновления корректировок пустые наборы по другим регистрам могут быть пока не записаны.
	
	ИсключаемыйРегистратор = Неопределено;
	Если Количество() = 0 И Отбор.Найти("Регистратор") <> Неопределено И Отбор.Регистратор.Использование Тогда
		ИсключаемыйРегистратор = Отбор.Регистратор.Значение;
	КонецЕсли;
	
	// Кроме того, исключаемый регистратор может быть определен при временной записи набора в форме проведенного документа.
	// Например, при увольнении последним днем месяца.
	
	Если ДополнительныеСвойства.Свойство("ИсключаемыйРегистратор") Тогда
		ИсключаемыйРегистратор = ДополнительныеСвойства.ИсключаемыйРегистратор;
	КонецЕсли;
	
	УчетСреднегоЗаработка.ОбновитьДанныеКорректировкиДнейДляРасчетаОбщегоСреднегоЗаработка(МенеджерВременныхТаблиц, ИсключаемыйРегистратор);
	
КонецПроцедуры

#КонецОбласти
	
#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.';
						|en = 'Invalid object call on the client.'");
#КонецЕсли