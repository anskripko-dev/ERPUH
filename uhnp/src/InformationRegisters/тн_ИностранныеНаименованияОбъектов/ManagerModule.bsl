
Функция ПолучитьИностранноеНаименование(ОбъектПоиска, КодЯзыка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИностранныеНаименованияОбъектов.НаименованиеОбъектаИностранное КАК НаименованиеОбъектаИностранное
		|ИЗ
		|	РегистрСведений.тн_ИностранныеНаименованияОбъектов КАК ИностранныеНаименованияОбъектов
		|ГДЕ
		|	ИностранныеНаименованияОбъектов.Объект = &Объект
		|	И ИностранныеНаименованияОбъектов.КодЯзыка = &КодЯзыка";

	Запрос.УстановитьПараметр("Объект", ОбъектПоиска);
	Запрос.УстановитьПараметр("КодЯзыка", КодЯзыка);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НаименованиеОбъектаИностранное;
	Иначе	
		Возврат "";
	КонецЕсли;
     
КонецФункции // ПолучитьИностранноеНаименование()
