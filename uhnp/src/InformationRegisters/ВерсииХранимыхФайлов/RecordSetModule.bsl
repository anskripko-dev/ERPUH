// Процедура удаляет запись регистра сведений по заданным параметрам 
// 
Процедура УдалитьЛокальнуюВерсиюХФО(ХранимыйФайл, Период) Экспорт

	Отбор.ХранимыйФайл  .Установить(ХранимыйФайл);
	Отбор.Период        .Установить(Период);
	
	Прочитать();
	Очистить();
	
	Попытка
		Записать();
	Исключение
		Сообщить(ОписаниеОшибки()); 
	КонецПопытки; 

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ОБЪЕКТА

// Процедура - обработчик события набора записей "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = "";

	ПроверитьПередЗаписью(Отказ, Сообщение);

	Если Отказ Тогда
		Сообщить(СокрЛ(Сообщение), СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТИРУЕМЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ОБЪЕКТА

// Процедура выполняет необходимые проверки перед записью набора записей.
//
// Параметры:
//  Сообщение - строка, в которую будут дописаны "замечания", выявленные при проверке.
//              Сформированная таким образом строка может использоваться в вызывающей
//              процедуре в качестве сообщения или предупреждения.
//  Отказ     - Истина, если проверка выявила проблемы. В противном случае не меняется.
//              В параметр удобно передавать параметр Отказ обработчика ПередЗаписью.
//
// Возвращаемое значение:
//  Нет.
//
Процедура ПроверитьПередЗаписью(Отказ, Сообщение = "") Экспорт

	Для каждого Запись Из ЭтотОбъект Цикл
		ОтказПоЗаписи     = Ложь;
		СообщениеПоЗаписи = СтрШаблон(Нстр("ru = 'Версия хранимого файла ""%1/%2"" не может быть записана:'"), Запись.ХранимыйФайл.Владелец, 
			Запись.ХранимыйФайл.ПолноеНаименование());

		Если Запись.ХранимыйФайл.Пустая() Тогда
			ОтказПоЗаписи     = Истина;
			СообщениеПоЗаписи = СтрШаблон(Нстр("ru = '%1- Не указано значение свойства ""Хранимый файл"".'"), 
				СообщениеПоЗаписи + Символы.ПС);
		КонецЕсли;

		Если Запись.ДатаИзмененияФайла = '00010101' Тогда
			ОтказПоЗаписи     = Истина;
			СообщениеПоЗаписи = СтрШаблон(Нстр("ru = '%1- Не указано значение свойства ""Дата изменения файла"".'"), 
				СообщениеПоЗаписи + Символы.ПС);
		КонецЕсли;

		Если Запись.АвторВерсии.Пустая() Тогда
			ОтказПоЗаписи     = Истина;
			СообщениеПоЗаписи = СтрШаблон(Нстр("ru = '%1- Не указано значение свойства ""Автор версии"".'"), СообщениеПоЗаписи + Символы.ПС);
		КонецЕсли;

		Если ОтказПоЗаписи Тогда
			Отказ     = Истина;
			Сообщение = Сообщение + Символы.ПС + СообщениеПоЗаписи;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры



