#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ДобавитьТаблицуДляДвижений(ДополнительныеСвойства, Отказ) Экспорт
	
	Если Не ДополнительныеСвойства.ДляПроведения.Реквизиты.ЕстьДоли Тогда
		Возврат;	
	КонецЕсли;
	
	Реквизиты			= ДополнительныеСвойства.ДляПроведения.Реквизиты;
	ДвижениеИнвестиций 	= ДополнительныеСвойства.ТаблицыДляДвижений.ДвижениеИнвестиций;
	ИсточникРасчета 	= ДополнительныеСвойства.ТаблицыДляДвижений.ИсточникРасчетаЭффективныхДолей;
	
	Движения = Новый Структура("СтатусыОбъектовИнвестирования, ДвижениеИнвестиций", 
				ПустаяТаблицаДвижений(), ДвижениеИнвестиций);
	
	ДвижениеИнвестиций.Индексы.Добавить("Инвестор");
	Инвесторы = ДвижениеИнвестиций.Скопировать(, "ОбъектИнвестирования");
	Инвесторы.Свернуть("ОбъектИнвестирования");

	ПоследовательностиУчастия = РасчетДолейВладения.ПолучитьПоследовательностиУчастия(
			Инвесторы.ВыгрузитьКолонку("ОбъектИнвестирования"), ИсточникРасчета);
	
	РасчетДолейВладения.СформироватьДвиженияПоследовательности(
			Движения, Реквизиты, ПоследовательностиУчастия, Отказ);
			
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.ТаблицыДляДвижений.Вставить(
		"СтатусыОбъектовИнвестирования", Движения.СтатусыОбъектовИнвестирования);
	
	ДополнительныеСвойства.ТаблицыДляДвижений.Удалить("ИсточникРасчетаЭффективныхДолей");
	
	Реквизиты.Вставить("ОбъектИнвестирования", 
		ДвижениеИнвестиций.ВыгрузитьКолонку("ОбъектИнвестирования"));//для ПроверитьПроведение
		
КонецПроцедуры

Функция ПустаяТаблицаДвижений()

	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Период");
	
	Результат.Колонки.Добавить("ОбъектИнвестирования");
	Результат.Колонки.Добавить("Инвестор");
	Результат.Колонки.Добавить("Сценарий");
	Результат.Колонки.Добавить("ОтношениеКГруппе");
	Результат.Колонки.Добавить("ЭффективнаяДоля");
	Результат.Колонки.Добавить("ЦепочкаПАО");
	Результат.Колонки.Добавить("ПоследовательностиУчастия");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьПоследовательности(Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос(ТекстЗапроса_Статусы());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПоследовательностиУчастия.Получить() <> Неопределено Тогда
			Продолжить; // документ уже обработан
		КонецЕсли;
		
		Запрос = Новый Запрос(ТекстЗапроса_Последовательности());
		Запрос.УстановитьПараметр("Регистратор", Выборка.Регистратор);
		
		ПоследовательностиУчастия = Запрос.Выполнить().Выгрузить();
		ПоследовательностиУчастия.Индексы.Добавить("ОбъектИнвестирования, Инвестор, НомерПоследовательностиУчастия, Сценарий");
		Отбор = Новый Структура("ОбъектИнвестирования, Инвестор, НомерПоследовательностиУчастия, Сценарий");
		
		нз = РегистрыСведений.СтатусыОбъектовИнвестирования.СоздатьНаборЗаписей();
		нз.Отбор.Регистратор.Установить(Выборка.Регистратор);
		нз.Прочитать();
				
		Для каждого Запись Из нз Цикл //КлючЗаписи: ОбъектИнвестирования,Инвестор,Сценарий
			
			ЗаполнитьЗначенияСвойств(Отбор, Запись);
			
			НомерПоследовательности = 1;
			ТекущиеПоследовательности = Новый Соответствие;
		
			Пока Истина Цикл
				
				Отбор.Вставить("НомерПоследовательностиУчастия", НомерПоследовательности);
				
				Последовательность = ПоследовательностиУчастия.Скопировать(Отбор);
				Если Последовательность.Количество() = 0 Тогда
					Прервать;
				КонецЕсли;
				
				ТекущиеПоследовательности.Вставить(
						ЗначениеВСтрокуВнутр(Последовательность.Скопировать(, "ИнвесторПоследовательности,ОбъектИнвестированияПоследовательности")),
				    	Новый Структура("НомерПоследовательности,Последовательность", НомерПоследовательности, Последовательность)
					);
					
				НомерПоследовательности = НомерПоследовательности + 1;
			
			КонецЦикла;
			
			Запись.ПоследовательностиУчастия = Новый ХранилищеЗначения(ТекущиеПоследовательности);
			
		КонецЦикла;
		
		нз.Записать();
		
	КонецЦикла; 

КонецПроцедуры

Функция ТекстЗапроса_Статусы()

	Возврат
	"ВЫБРАТЬ
	|	т.Регистратор КАК Регистратор,
	|	т.НомерСтроки КАК НомерСтроки,
	|	ПУ.ПоследовательностиУчастия КАК ПоследовательностиУчастия
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.Регистратор КАК Регистратор,
	|		МИНИМУМ(т.НомерСтроки) КАК НомерСтроки
	|	ИЗ
	|		РегистрСведений.СтатусыОбъектовИнвестирования КАК т
	|	
	|	СГРУППИРОВАТЬ ПО
	|		т.Регистратор) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыОбъектовИнвестирования КАК ПУ
	|		ПО т.Регистратор = ПУ.Регистратор
	|			И т.НомерСтроки = ПУ.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.Регистратор";

КонецФункции

Функция ТекстЗапроса_Последовательности()

	Возврат
	"ВЫБРАТЬ
	|	т.Инвестор КАК Инвестор,
	|	т.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|	т.НомерПоследовательностиУчастия КАК НомерПоследовательностиУчастия,
	|	т.Номер КАК Номер,
	|	т.ЭффективнаяДоля КАК ЭффективнаяДоля,
	|	т.ОбъектИнвестированияПоследовательности КАК ОбъектИнвестированияПоследовательности,
	|	т.ИнвесторПоследовательности КАК ИнвесторПоследовательности,
	|	т.Сценарий КАК Сценарий
	|ИЗ
	|	РегистрСведений.ПоследовательностиУчастия КАК т
	|ГДЕ
	|	т.Регистратор = &Регистратор
	|	И НЕ (т.Инвестор, т.ОбъектИнвестирования, т.НомерПоследовательностиУчастия) В
	|				(ВЫБРАТЬ
	|					Пустые.Инвестор КАК Инвестор,
	|					Пустые.ОбъектИнвестирования КАК ОбъектИнвестирования,
	|					Пустые.НомерПоследовательностиУчастия КАК НомерПоследовательностиУчастия
	|				ИЗ
	|					РегистрСведений.ПоследовательностиУчастия КАК Пустые
	|				ГДЕ
	|					Пустые.ЭффективнаяДоля > 0.000000001)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектИнвестирования,
	|	Инвестор,
	|	Сценарий,
	|	НомерПоследовательностиУчастия";

КонецФункции

#КонецЕсли
	
