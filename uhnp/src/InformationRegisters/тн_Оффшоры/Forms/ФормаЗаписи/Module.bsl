#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьДанные();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДанные()
	
	Данные = ОбновитьДанныеПоВзаимозависимости(Запись.Страна, Запись.Период);
	СведенияДействуютПо = Данные.СведенияДействуютПо;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьДанныеПоВзаимозависимости(Страна, Период)
	
	СтруктураВозврата = Новый Структура("СведенияДействуютПо, Период, Страна");
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("Страна", Страна);
	Запрос.Параметры.Вставить("Период", Период);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МАКСИМУМ(тн_Оффшоры.Период) КАК Период
	|ИЗ
	|	РегистрСведений.тн_Оффшоры КАК тн_Оффшоры
	|ГДЕ
	|	тн_Оффшоры.Страна = &Страна
	|	И тн_Оффшоры.Период > &Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Не Выборка.Период = NULL Тогда
		ДатаОкончанияДействия = Формат(НачалоДня(Выборка.Период - 1), "ДЛФ=D");
		СведенияДействуютПо = НСтр("ru = 'по %ДатаОкончанияДействия%';
									|en = 'by %ДатаОкончанияДействия%'");
		СтруктураВозврата.СведенияДействуютПо = СтрЗаменить(СведенияДействуютПо, "%ДатаОкончанияДействия%", ДатаОкончанияДействия);
	Иначе
		СтруктураВозврата.СведенияДействуютПо = НСтр("ru = 'по настоящее время';
													|en = 'until present '");
	КонецЕсли;
		
	Возврат СтруктураВозврата;
	
КонецФункции   

#КонецОбласти