#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.ЗначенияЗаполнения.Свойство("СвязанныйДоговор") Тогда
		Элементы.СвязанныйДоговор.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если Параметры.ЗначенияЗаполнения.Свойство("БазовыйДоговор") Тогда
		Элементы.БазовыйДоговор.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	УстановитьПараметрыВыбора();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПараметрыОповещения = Новый Структура("БазовыйДоговор,СвязанныйДоговор");
	ЗаполнитьЗначенияСвойств(ПараметрыОповещения, Запись);
	Оповестить("СвязанныеДоговоры_Изменение", ПараметрыОповещения, ЭтаФорма);
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ВидСвязиПриИзменении(Элемент)
	УстановитьПараметрыВыбора();
КонецПроцедуры

#КонецОбласти
 
#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура УстановитьПараметрыВыбора()
	
	Если Не ЗначениеЗаполнено(Запись.ВидСвязи) Тогда
		Элементы.СвязанныйДоговор.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораДоговора = Новый Массив;
	
	РеквизитыВидаСвязи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.ВидСвязи, "ОдинаковаяОрганизация,ОдинаковыйКонтрагент,ОдинаковаяВалюта,ОдинаковаяСумма");
	ПоляБазовогоДоговора = Новый Структура;
	Если РеквизитыВидаСвязи.ОдинаковаяОрганизация Тогда
		ПоляБазовогоДоговора.Вставить("Организация","Организация");
	КонецЕсли; 
	
	Если РеквизитыВидаСвязи.ОдинаковыйКонтрагент Тогда
		ПоляБазовогоДоговора.Вставить("Контрагент","Контрагент");
	КонецЕсли;
	
	Если РеквизитыВидаСвязи.ОдинаковаяВалюта Тогда
		ПоляБазовогоДоговора.Вставить("ВалютаВзаиморасчетов","ВалютаВзаиморасчетов");
	КонецЕсли;
	
	Если РеквизитыВидаСвязи.ОдинаковаяСумма Тогда
		ПоляБазовогоДоговора.Вставить("Сумма","Сумма");
	КонецЕсли;
	
	Если ПоляБазовогоДоговора.Количество() Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.БазовыйДоговор, ПоляБазовогоДоговора);
		Для Каждого ТекРеквизитДоговора Из РеквизитыДоговора Цикл
			ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор." + ТекРеквизитДоговора.Ключ, ТекРеквизитДоговора.Значение));
		КонецЦикла;
	КонецЕсли;
	
	СвязанныеДоговорыУХПереопределяемый.УстановитьПараметрыВыбораФормаЗаписи(Запись, ПараметрыВыбораДоговора);
	
	Элементы.СвязанныйДоговор.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораДоговора);
КонецПроцедуры

#КонецОбласти
