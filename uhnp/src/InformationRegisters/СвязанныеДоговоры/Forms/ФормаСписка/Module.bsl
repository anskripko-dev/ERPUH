#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УправлениеФормойУХ.УстановитьПредставлениеОтбора(ЭтотОбъект, , Метаданные.Справочники.ДоговорыКонтрагентов);
	
	ЭтоПодчиненныеДоговоры = Параметры.Отбор.Свойство("БазовыйДоговор") И ЗначениеЗаполнено(Параметры.Отбор.БазовыйДоговор);
	
	ЭтоБазовыеДоговоры = Параметры.Отбор.Свойство("СвязанныйДоговор") И ЗначениеЗаполнено(Параметры.Отбор.СвязанныйДоговор);
	
	Если ЭтоПодчиненныеДоговоры Тогда
		Заголовок = НСтр("ru = 'Подчиненные договоры'");
		Элементы.БазовыйДоговор.Видимость = Ложь;
	ИначеЕсли ЭтоБазовыеДоговоры Тогда
		Заголовок = НСтр("ru = 'Базовые договоры'");
		Элементы.СвязанныйДоговор.Видимость = Ложь;
	Иначе
		Заголовок = НСтр("ru = 'Связанные договоры'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти