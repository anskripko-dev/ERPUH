#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьБазовогоДоговора = Неопределено;
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		РеквизитыДоговора1 = СвязанныеДоговорыУХПереопределяемый.РеквизитыДляПроверки(Запись.БазовыйДоговор);
		РеквизитыДоговора2 = СвязанныеДоговорыУХПереопределяемый.РеквизитыДляПроверки(Запись.СвязанныйДоговор);
		
		Если Запись.ВидСвязи.ОдинаковаяОрганизация И (РеквизитыДоговора1.Организация <> РеквизитыДоговора2.Организация) Тогда
			ТекстСообщения = НСтр("ru = 'Для договоров <%1> И <%2> должна быть указана одинаковая организация(вид связи <%3>)'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
		КонецЕсли;
		
	    Если Запись.ВидСвязи.ОдинаковыйКонтрагент И (РеквизитыДоговора1.Контрагент <> РеквизитыДоговора2.Контрагент) Тогда
			ТекстСообщения = НСтр("ru = 'Для договоров <%1> И <%2> должен быть указан одинаковый контрагент(вид связи <%3>)'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
		КонецЕсли;
		
		Если Запись.ВидСвязи.ОдинаковаяВалюта И (РеквизитыДоговора1.Валюта <> РеквизитыДоговора2.Валюта) Тогда
			ТекстСообщения = НСтр("ru = 'Для договоров <%1> И <%2> должна быть указана одинаковая валюта(вид связи <%3>)'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
		КонецЕсли;
		
		Если Запись.ВидСвязи.ОдинаковаяСумма 
			И (РеквизитыДоговора1.Сумма <> РеквизитыДоговора2.Сумма) Тогда
			
			ТекстСообщения = НСтр("ru = 'Для договоров <%1> И <%2> должна быть указана одинаковая сумма(вид связи <%3>)'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
			
		КонецЕсли;
		
		Если Запись.ВидСвязи.Внутригрупповой Тогда
			
			Если ОрганизацияКонтрагентаДоговора(Запись.БазовыйДоговор) <> Запись.СвязанныйДоговор.Организация Тогда
				ТекстСообщения = НСтр("ru = 'Организация по договору <%1> должна совпадать с контрагентом договора <%2> (вид связи <%3>)'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
			КонецЕсли;			
			
			Если ОрганизацияКонтрагентаДоговора(Запись.СвязанныйДоговор) <> Запись.БазовыйДоговор.Организация Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент по договору <%1> должен совпадать с организацией договора <%2> (вид связи <%3>)'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.БазовыйДоговор, Запись.СвязанныйДоговор, Запись.ВидСвязи),,,,Отказ);
			КонецЕсли;
			
			Если Не ДополнительныеСвойства.Свойство("ПроверитьУникальностьБазовогоДоговора", ПроверитьУникальностьБазовогоДоговора) Тогда
				ПроверитьУникальностьБазовогоДоговора = Новый Массив;
			КонецЕсли;
			
			ПроверитьУникальностьБазовогоДоговора.Добавить(Запись.БазовыйДоговор);
			ДополнительныеСвойства.Вставить("ПроверитьУникальностьБазовогоДоговора", ПроверитьУникальностьБазовогоДоговора);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьБазовогоДоговора = Неопределено;
	
	Если Не ДополнительныеСвойства.Свойство("ПроверитьУникальностьБазовогоДоговора", ПроверитьУникальностьБазовогоДоговора) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьВнутригрупповых(ПроверитьУникальностьБазовогоДоговора, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУникальностьВнутригрупповых(БазовыйДоговор, Отказ)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СвязанныеДоговоры.БазовыйДоговор,
	|	КОЛИЧЕСТВО(СвязанныеДоговоры.СвязанныйДоговор) КАК КоличествоВстречных
	|ИЗ
	|	РегистрСведений.СвязанныеДоговоры КАК СвязанныеДоговоры
	|ГДЕ
	|	СвязанныеДоговоры.БазовыйДоговор В(&БазовыйДоговор)
	|	И СвязанныеДоговоры.ВидСвязи.Внутригрупповой
	|
	|СГРУППИРОВАТЬ ПО
	|	СвязанныеДоговоры.БазовыйДоговор
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(СвязанныеДоговоры.СвязанныйДоговор) > 1");
	Запрос.УстановитьПараметр("БазовыйДоговор", БазовыйДоговор);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ТекстСообщения = НСтр("ru = 'По договору <%1> уже установлен встречный договор'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстСообщения, Выборка.БазовыйДоговор),,,,Отказ);
	
КонецПроцедуры

Функция РеквизитыДляПроверки(ДоговорСсылка)
	
	ТипОбъекта = ТипЗнч(ДоговорСсылка);
	
	Если ТипОбъекта = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		РеквизитыДоговоровДляПроверки = Новый Структура("Организация,Контрагент,Валюта,Сумма","Организация","Владелец","ВалютаВзаиморасчетов","Сумма");
	ИначеЕсли ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() И 
			ТипЗнч(ДоговорСсылка) = Тип("СправочникСсылка." + "ОбеспечениеТретьихЛиц") Тогда
		РеквизитыДоговоровДляПроверки = Новый Структура("Организация,Контрагент,Валюта,Сумма","Бенефициар","Контрагент","Валюта","Сумма");
	Иначе
		ТекстШаблона = НСтр("ru = 'Объект %1 имеет некорректный тип %2.'");
		ВызватьИсключение СтрШаблон(ТекстШаблона, ДоговорСсылка, ТипОбъекта);
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорСсылка, РеквизитыДоговоровДляПроверки);
	
КонецФункции

Функция ОрганизацияКонтрагентаДоговора(Договор)
	Возврат СвязанныеДоговорыУХПереопределяемый.ОрганизацияКонтрагентаДоговора(Договор);
КонецФункции

#КонецОбласти

#КонецЕсли