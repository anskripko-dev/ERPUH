#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область СлужебныйПрограммныйИнтерфейс

Функция ДанныеПроверкиСогласования(ДокументСсылка, НастройкиПроверкиКонтрольноСуммы) Экспорт
	
	МенеджерОбъекта   = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументСсылка);
	
	ДанныеДляПроверки = НастройкиПроверкиКонтрольноСуммы.Получить();
	Если ДанныеДляПроверки = Неопределено Тогда
		ДанныеДляПроверки = МенеджерОбъекта.РеквизитыДляКонтрольнойСуммы();
	КонецЕсли;
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Реквизит");
	ТаблицаРеквизитов.Колонки.Добавить("Значение");
	
	РеквизитыДляПроверки      = ДанныеДляПроверки.Реквизиты;
	ТабличныеЧастиДляПроверки = ДанныеДляПроверки.ТабличныеЧасти;
	
	Для Каждого ИмяПоля Из РеквизитыДляПроверки Цикл
		
		ЗначениеПоля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, ИмяПоля);
		
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.Реквизит  = ИмяПоля;
		НоваяСтрока.Значение  = ЗначениеПоля;
		
	КонецЦикла;
	
	ТаблицаРеквизитов.Сортировать("Реквизит Возр");
	
	СписокТабличныхЧастей = Новый СписокЗначений;
	СписокТабличныхЧастей.ЗагрузитьЗначения(ТабличныеЧастиДляПроверки);
	СписокТабличныхЧастей.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	ТабличныеЧастиДляПроверки = СписокТабличныхЧастей.ВыгрузитьЗначения();
	
	ТабличныеЧасти = Новый Соответствие;
	Для Каждого ТЧ Из ТабличныеЧастиДляПроверки Цикл
		ТабличныеЧасти.Вставить(ТЧ, ДокументСсылка[ТЧ].Выгрузить());
	КонецЦикла;
	
	СоответствиеДляПроверки = Новый Соответствие;
	СоответствиеДляПроверки.Вставить("Реквизиты",      ТаблицаРеквизитов);
	СоответствиеДляПроверки.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	Возврат СоответствиеДляПроверки;
	
КонецФункции

Процедура ОбновитьДанныеДляПроверкиСогласования(ДокументСсылка, НастройкиПроверкиКонтрольноСуммы) Экспорт 
	
	ДанныеОбъекта = ДанныеПроверкиСогласования(ДокументСсылка, НастройкиПроверкиКонтрольноСуммы);
	
	УстановитьПривилегированныйРежим(Истина);
	НоваяЗапись = РегистрыСведений.ДанныеДляПроверкиСогласования.СоздатьМенеджерЗаписи();
	НоваяЗапись.ОбъектДляСогласования = ДокументСсылка;
	НоваяЗапись.КонтрольнаяСумма      = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ДанныеОбъекта);
	НоваяЗапись.ДанныеДляПроверки     = Новый ХранилищеЗначения(ДанныеОбъекта, Новый СжатиеДанных(9));
	НоваяЗапись.Записать();
	
КонецПроцедуры

Функция ПроверитьКонтрольнуюСуммуДокумента(ДокументСсылка, НастройкиПроверкиКонтрольнойСуммы) Экспорт
	
	ДанныеДляПроверки           = ДанныеПроверкиСогласования(ДокументСсылка, НастройкиПроверкиКонтрольнойСуммы);
	КонтрольнаяСуммаДляПроверки = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ДанныеДляПроверки);
	КонтрольнаяСуммаДокумента   = "";
	ЗафиксированныеДанные       = Неопределено;
	СообщениеОбОшибке           = "";
	
	Результат = Новый Структура;
	Результат.Вставить("КонтрольнаяСуммаСовпадает", Ложь);
	Результат.Вставить("СообщениеОбОшибке",         "");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДляПроверкиСогласования.КонтрольнаяСумма КАК КонтрольнаяСумма,
		|	ДанныеДляПроверкиСогласования.ДанныеДляПроверки КАК ДанныеДляПроверки
		|ИЗ
		|	РегистрСведений.ДанныеДляПроверкиСогласования КАК ДанныеДляПроверкиСогласования
		|ГДЕ
		|	ДанныеДляПроверкиСогласования.ОбъектДляСогласования = &ОбъектДляСогласования";
	
	Запрос.УстановитьПараметр("ОбъектДляСогласования", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КонтрольнаяСуммаДокумента = ВыборкаДетальныеЗаписи.КонтрольнаяСумма;
		ЗафиксированныеДанные     = ВыборкаДетальныеЗаписи.ДанныеДляПроверки.Получить();
	КонецЦикла;
	
	Если ПустаяСтрока(КонтрольнаяСуммаДокумента) Тогда
		Результат.СообщениеОбОшибке = НСтр("ru = 'Отсутствуют данные о контрольной сумме документа.'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;
	
	Результат.КонтрольнаяСуммаСовпадает = КонтрольнаяСуммаДокумента = КонтрольнаяСуммаДляПроверки;
	СообщенияОбОшибках = Новый Массив;
	Если Не Результат.КонтрольнаяСуммаСовпадает Тогда
		НовыеЗначения = ДанныеДляПроверки.Получить("Реквизиты");
		ШаблонСообщения = 
			НСтр("ru = 'Изменилось значение реквизита ""%1"" с ""%2"" на ""%3"".'", ОбщегоНазначения.КодОсновногоЯзыка());
		ЗафиксированныеДанныеРеквизитов = ЗафиксированныеДанные.Получить("Реквизиты");
		Для Каждого Стр Из ЗафиксированныеДанныеРеквизитов Цикл
			ПараметрыОтбора = Новый Структура("Реквизит", Стр.Реквизит);
			НайденныеСтроки = НовыеЗначения.НайтиСтроки(ПараметрыОтбора);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если НайденнаяСтрока.Значение <> Стр.Значение Тогда
					СообщенияОбОшибках.Добавить(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонСообщения,
							Стр.Реквизит,
							Стр.Значение,
							НайденнаяСтрока.Значение));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ЗафиксированныеДанныеТЧ = ЗафиксированныеДанные.Получить("ТабличныеЧасти");
		ДанныеДляПроверкиТЧ     = ДанныеДляПроверки.Получить("ТабличныеЧасти");
		ШаблонСообщения = 
					НСтр("ru = 'Изменилось значение в колонке ""%1"" в строке ""%2"" таблицы ""%3"" с ""%4"" на ""%5"".'", ОбщегоНазначения.КодОсновногоЯзыка());
		Для Каждого ТЧ Из ЗафиксированныеДанныеТЧ Цикл
			ТЧДляПроверки = ДанныеДляПроверкиТЧ.Получить(ТЧ.Ключ);
			КоличествоСтрокДляПроверки = ТЧДляПроверки.Количество();
			Если ТЧ.Значение.Количество() <> КоличествоСтрокДляПроверки Тогда
				ШаблонСообщения = 
					НСтр("ru = 'Изменилось количество строк в таблице ""%1"".'", ОбщегоНазначения.КодОсновногоЯзыка());
				СообщенияОбОшибках.Добавить(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения,
						ТЧ.Ключ));
				Прервать;
			КонецЕсли;
			КолонкиТЧ = ТЧ.Значение.Колонки;
			Для Каждого Стр Из ТЧ.Значение Цикл
				Для Каждого Колонка Из КолонкиТЧ Цикл
					Если Стр[Колонка.Имя] <> ТЧДляПроверки[Стр.НомерСтроки  -1][Колонка.Имя] Тогда
						СообщенияОбОшибках.Добавить(
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонСообщения,
							Колонка.Имя,
							Стр.НомерСтроки,
							ТЧ.Ключ,
							Стр[Колонка.Имя],
							ТЧДляПроверки[Стр.НомерСтроки  -1][Колонка.Имя]));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	
		Результат.СообщениеОбОшибке = СтрСоединить(СообщенияОбОшибках, Символы.ПС);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьДанныеДляПроверки(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ДанныеДляПроверкиСогласования.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ОбъектДляСогласования.Установить(ДокументСсылка);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция РеквизитыДляКонтрольнойСуммыПоУмолчанию() Экспорт
	
	РеквизитыДляПроверкиСогласования = Новый Массив;
	ТабличныеЧастиДляПроверкиСогласования = Новый Массив;
	
	Результат = Новый Структура;
	Результат.Вставить("Реквизиты",      РеквизитыДляПроверкиСогласования);
	Результат.Вставить("ТабличныеЧасти", ТабличныеЧастиДляПроверкиСогласования); 
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРекомендуемыеНастройки(ПолноеИмяОбъектаМетаданных) Экспорт
	
	ДокументыСРекомендуемымиНастройками = Новый Массив;
	ДокументыСРекомендуемымиНастройками.Добавить("Документ.ЗаявкаНаРасходованиеДенежныхСредств");
	
	Возврат ДокументыСРекомендуемымиНастройками.Найти(ПолноеИмяОбъектаМетаданных) <> Неопределено;
	
КонецФункции

#КонецОбласти

