
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьГеоПризнаки(Страна, Период) Экспорт
	Возврат ПолучитьПоследнее(КонецГода(Период), Новый Структура("Страна", Страна));
КонецФункции

Функция ПолучитьФлагСтраны(КодСтраны, КэшКартинок = Неопределено) Экспорт
	
	Перем РезультатФлаг;
	
	Если КэшКартинок <> Неопределено Тогда		
		Возврат КэшКартинок.Получить(КодСтраны);		
	КонецЕсли;
	
	КэшКартинок = Новый Соответствие;
	
	Макет = ПолучитьМакет("ФлагиСтран");
	
	Для Инд = 2 По Макет.ВысотаТаблицы Цикл
		
		ТекущийКодСтраны = Макет.Область(Инд, 1, Инд, 1).Текст;
		ТекущаяКартинка = Макет.Рисунки.Получить(Инд - 2).Картинка;
		КэшКартинок.Вставить(ТекущийКодСтраны, ТекущаяКартинка);
		
		Если ТекущийКодСтраны = КодСтраны Тогда
			РезультатФлаг = ТекущаяКартинка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатФлаг;
	
КонецФункции

