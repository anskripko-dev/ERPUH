
#Область ОбработкаОсновныхСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("ПериметрСверки", ПериметрСверки) Тогда
		
		Сценарий = Неопределено;
		ПериодСценария = Неопределено;
		Параметры.Свойство("Сценарий", Сценарий);
		Параметры.Свойство("ПериодСценария", ПериодСценария);
		
		ПериметрСверки = УправлениеРабочимиПроцессамиУХ
			.ПолучитьДокументУправленияПериодомСценария(Сценарий, ПериодСценария);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбработатьИзменениеПериодаСценарияНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработкаСобытийЭлементовФормы


&НаКлиенте
Процедура ОбновитьОтображение(Команда)
	ОбработатьИзменениеПериодаСценарияНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПериметрСверкиПриИзменении(Элемент)
	ОбработатьИзменениеПериодаСценарияНаКлиенте();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыНаКлиенте


&НаКлиенте
Процедура ОбработатьИзменениеПериодаСценарияНаКлиенте()
	Если ПериметрСверки = ПериметрСверкиСтарый Тогда
		Возврат;
	КонецЕсли;
	Если Модифицированность Тогда
		СпроситьВозможностьЗаписатьИзмененныеЗаписи();
	Иначе
		ОбработатьИзменениеПериодаСценарияНаСервере();
	КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СпроситьВозможностьЗаписатьИзмененныеЗаписи()
	ОбработчикОтветаНаВозможностьЗатеретьИзменения = Новый ОписаниеОповещения("ОбработатьОтветОВозможностиЗаписатьИзмененныеЗаписи", ЭтаФорма);
	ПоказатьВопрос(ОбработчикОтветаНаВозможностьЗатеретьИзменения,
		НСтр("ru = 'Для выполнения операции необходимо записать текущие данные. Продолжить?'"),
		РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветОВозможностиЗаписатьИзмененныеЗаписи(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ПериметрСверки = ПериметрСверкиСтарый;
        Возврат;
	КонецЕсли;
	
	Записать(Неопределено);
	
	ОбработатьИзменениеПериодаСценарияНаСервере();
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыНаСервере

&НаСервере
Процедура ОбработатьИзменениеПериодаСценарияНаСервере()
	РегистрыСведений.УдалитьОтветственныеЗаСверкуВГОПоОрганизациям.ЗаполнитьОрганизациямиПериметраНаСервере(ПериметрСверки.Сценарий, ПериметрСверки.ПериодСценария);
	ПрочитатьДанныеРегистраНаСервере();
	
	ПериметрСверкиСтарый = ПериметрСверки;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеРегистраНаСервере()
	
	НаборЗаписей = РегистрыСведений.УдалитьОтветственныеЗаСверкуВГОПоОрганизациям.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.ПериодСценария.Значение = ПериметрСверки.ПериодСценария;
	НаборЗаписей.Отбор.ПериодСценария.Использование = Истина;
	НаборЗаписей.Отбор.ПериодСценария.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписей.Отбор.Сценарий.Значение = ПериметрСверки.Сценарий;
	НаборЗаписей.Отбор.Сценарий.Использование = Истина;
    НаборЗаписей.Отбор.Сценарий.ВидСравнения = ВидСравнения.Равно;
	
	НаборЗаписей.Прочитать();   
	
	ЗначениеВДанныеФормы(НаборЗаписей, ОтветственныеЗаСверку);
	
КонецПроцедуры

#КонецОбласти
