#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ЗаполнитьОрганизациямиПериметраНаСервере(Сценарий, ПериодСценария) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Сценарий) ИЛИ НЕ ЗначениеЗаполнено(ПериодСценария) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.ОрганизационнаяЕдиница КАК ОрганизационнаяЕдиница
		|ПОМЕСТИТЬ ОрганизацииРегламента
		|ИЗ
		|	Документ.УправлениеПериодомСценария КАК УправлениеПериодомСценария
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности КАК ВерсииРегламентовПодготовкиОтчетности
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВерсииРегламентовПодготовкиОтчетности.ОрганизационныеЕдиницы КАК ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы
		|			ПО ВерсииРегламентовПодготовкиОтчетности.Ссылка = ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.Ссылка
		|		ПО УправлениеПериодомСценария.ВерсияОрганизационнойСтруктуры = ВерсииРегламентовПодготовкиОтчетности.Ссылка
		|			И (УправлениеПериодомСценария.Сценарий = &Сценарий)
		|			И (УправлениеПериодомСценария.ПериодСценария = &ПериодСценария)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсииРегламентовПодготовкиОтчетностиОрганизационныеЕдиницы.ОрганизационнаяЕдиница
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОрганизацииРегламента.ОрганизационнаяЕдиница КАК Организация
		|ИЗ
		|	ОрганизацииРегламента КАК ОрганизацииРегламента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаСверкуВГОПоОрганизациям КАК ОтветственныеЗаСверкуВГОПоОрганизациям
		|		ПО ОрганизацииРегламента.ОрганизационнаяЕдиница = ОтветственныеЗаСверкуВГОПоОрганизациям.Организация
		|			И (ОтветственныеЗаСверкуВГОПоОрганизациям.ПериодСценария = &ПериодСценария)
		|			И (ОтветственныеЗаСверкуВГОПоОрганизациям.Сценарий = &Сценарий)
		|ГДЕ
		|	ОтветственныеЗаСверкуВГОПоОрганизациям.Организация ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтветственныеЗаСверкуВГОПоОрганизациям.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ОтветственныеЗаСверкуВГОПоОрганизациям КАК ОтветственныеЗаСверкуВГОПоОрганизациям
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОрганизацииРегламента КАК ОрганизацииРегламента
		|		ПО (ОрганизацииРегламента.ОрганизационнаяЕдиница = ОтветственныеЗаСверкуВГОПоОрганизациям.Организация)
		|ГДЕ
		|	ОтветственныеЗаСверкуВГОПоОрганизациям.ПериодСценария = &ПериодСценария
		|	И ОтветственныеЗаСверкуВГОПоОрганизациям.Сценарий = &Сценарий
		|	И ОрганизацииРегламента.ОрганизационнаяЕдиница ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ПериодСценария", ПериодСценария);
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	
	мРезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если НЕ мРезультатЗапроса[1].Пустой() ИЛИ НЕ мРезультатЗапроса[2].Пустой() Тогда
		
		НаборЗаписей = РегистрыСведений.УдалитьОтветственныеЗаСверкуВГОПоОрганизациям.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПериодСценария.Установить(ПериодСценария);
		НаборЗаписей.Отбор.Сценарий.Установить(Сценарий);
		
		ВыборкаОрганизацийДляДобавления = мРезультатЗапроса[1].Выбрать();
		Пока ВыборкаОрганизацийДляДобавления.Следующий() Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ПериодСценария = ПериодСценария;
			НоваяЗапись.Сценарий = Сценарий;
			НоваяЗапись.Организация = ВыборкаОрганизацийДляДобавления.Организация;
			
		КонецЦикла;
		
		НаборЗаписей.Записать(Ложь); 
		НаборЗаписей.Очистить();
		
		ВыборкаОрганизацийДляУдаления = мРезультатЗапроса[2].Выбрать();
		Пока ВыборкаОрганизацийДляУдаления.Следующий() Цикл
			НаборЗаписей.Отбор.Организация.Установить(ВыборкаОрганизацийДляУдаления.Организация);
			НаборЗаписей.Записать(Истина); 
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция АдресаВГО() Экспорт

	Запрос = Новый Запрос(ТекстЗапроса_Адреса());
	
	//Запрос.УстановитьПараметр("Регистратор", Ссылка);
	//Запрос.УстановитьПараметр("НачалоПериода", ДатаНач);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
	КонецЦикла; 

КонецФункции

Функция ТекстЗапроса_Адреса()

	Возврат
	"ВЫБРАТЬ
	|	т.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ИСТИНА
	|			ТОГДА т.Куратор
	|		ИНАЧЕ т.Исполнитель
	|	КОНЕЦ КАК Пользователь
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаСверкуВГОПоОрганизациям КАК т"

КонецФункции

#КонецЕсли