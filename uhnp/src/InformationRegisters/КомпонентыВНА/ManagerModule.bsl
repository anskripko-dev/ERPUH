
Функция ПолучитьКомпонентыВНА(ВНА) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КомпонентыВНА.Компонент
	|ИЗ
	|	РегистрСведений.КомпонентыВНА КАК КомпонентыВНА
	|ГДЕ
	|	КомпонентыВНА.БазовыйВНА = &БазовыйВНА"
	);
	
	Запрос.УстановитьПараметр("БазовыйВНА", ВНА);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ЗаписатьКомпоненты(ВНА, КомпонентыВНА, Отказ = Ложь) Экспорт

	НаборКомпоненты = РегистрыСведений.КомпонентыВНА.СоздатьНаборЗаписей();	
	НаборКомпоненты.Отбор.БазовыйВНА.Установить(ВНА, Истина);
	НаборКомпоненты.Прочитать();
	
	НаборКомпоненты.Очистить();
	
	Для каждого КомпонентВНА Из КомпонентыВНА Цикл
		
		Запись = НаборКомпоненты.Добавить();
		Запись.БазовыйВНА = ВНА;
		Запись.Компонент = КомпонентВНА.Компонент;		
	
	КонецЦикла;
	
	Попытка	
		НаборКомпоненты.Записать();	
	Исключение
		ОбщегоНазначенияУХ.СообщитьОбОшибке(НСтр("ru = 'Не удалось записать список компонент для ВНА '") + ВНА, Отказ);
		Сообщить(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры
