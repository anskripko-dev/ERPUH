#Область ПрограммныйИнтерфейс
Функция ИсполнениеКовенантовПоОтбору(Отбор = Неопределено) Экспорт
	
	Если Отбор = Неопределено Тогда
		Отбор = Новый Структура;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Период КАК Период,
	|	Данные.Регистратор КАК Регистратор,
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	Данные.Активность КАК Активность,
	|	Данные.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Данные.Ковенант КАК Ковенант,
	|	Данные.ПлановаяДата КАК ПлановаяДата,
	|	Данные.СтатусИсполнения КАК СтатусИсполнения,
	|	Данные.РеакцияБанкаНаНарушение КАК РеакцияБанкаНаНарушение,
	|	Данные.Ответственный КАК Ответственный,
	|	ПРЕДСТАВЛЕНИЕ(Данные.Ковенант) КАК КовенантПредставление
	|ИЗ
	|	РегистрСведений.СостоянияИсполненияКовенантов.СрезПоследних КАК Данные";
	
	Запрос = Новый Запрос;
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ПараметрыТаблицы = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры;
	Если Отбор.Свойство("Период") Тогда
		 ПараметрыТаблицы[0].Выражение = Новый ВыражениеСхемыЗапроса("&Период");
		 Запрос.УстановитьПараметр("Период", Отбор.Период);
	КонецЕсли;
	
	УсловияСрезаПоследних = Новый Массив;
	Если Отбор.Свойство("ДоговорКонтрагента") Тогда
		 УсловияСрезаПоследних.Добавить("ДоговорКонтрагента = &ДоговорКонтрагента");
		 Запрос.УстановитьПараметр("ДоговорКонтрагента", Отбор.ДоговорКонтрагента);
	КонецЕсли;	
	
	Если Отбор.Свойство("Ковенант") Тогда
		Если ТипЗнч(Отбор.Ковенант) = Тип("Массив") Тогда
			Условие = "Ковенант В (&Ковенант)"
		Иначе
			Условие = "Ковенант = &Ковенант"
		КонецЕсли;	
		
		УсловияСрезаПоследних.Добавить(Условие);
		Запрос.УстановитьПараметр("Ковенант", Отбор.Ковенант);
	КонецЕсли;
	 
	Если ЗначениеЗаполнено(УсловияСрезаПоследних) Тогда
		 ПараметрыТаблицы[1].Выражение = Новый ВыражениеСхемыЗапроса(
		 		СтрСоединить(УсловияСрезаПоследних, " И "));
	КонецЕсли;
	
	УсловиеОтбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	Если Отбор.Свойство("СтатусИсполнения") Тогда
		 УсловиеОтбора.Добавить("Данные.СтатусИсполнения = &СтатусИсполнения");
		 Запрос.УстановитьПараметр("СтатусИсполнения", Отбор.СтатусИсполнения);
	КонецЕсли;
	
	Если Отбор.Свойство("РеакцияБанкаНаНарушение") Тогда
		 УсловиеОтбора.Добавить("Данные.РеакцияБанкаНаНарушение = &РеакцияБанкаНаНарушение");
		 Запрос.УстановитьПараметр("РеакцияБанкаНаНарушение", Отбор.РеакцияБанкаНаНарушение);
	КонецЕсли; 
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();

	ТабИсполнениеКовенантов = Запрос.Выполнить().Выгрузить();
	Возврат ТабИсполнениеКовенантов;
	
КонецФункции
#КонецОбласти