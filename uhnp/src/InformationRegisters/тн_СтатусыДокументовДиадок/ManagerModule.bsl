#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Процедура УстановитьСтатусДокумента(ДокументУчета, Статус) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_СтатусыДокументовДиадокСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.тн_СтатусыДокументовДиадок КАК тн_СтатусыДокументовДиадокСрезПоследних
		|ГДЕ
		|	тн_СтатусыДокументовДиадокСрезПоследних.ДокументУчета = &ДокументУчета 
		|	И тн_СтатусыДокументовДиадокСрезПоследних.Статус = &Статус";
	
	Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
	Запрос.УстановитьПараметр("Статус", Статус);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Набор = РегистрыСведений.тн_СтатусыДокументовДиадок.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументУчета.Установить(ДокументУчета);
		НоваяЗАпись = Набор.Добавить();
		НоваяЗАпись.ДокументУчета = ДокументУчета;
		НоваяЗАпись.Статус = Статус;
		Набор.Записать();
	КонецЕсли;	
КонецПроцедуры
#КонецЕсли