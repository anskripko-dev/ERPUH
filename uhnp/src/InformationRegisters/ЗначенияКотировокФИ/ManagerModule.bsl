
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьКотировку(ВидКотировки, Знач Период = Неопределено) Экспорт

	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Возврат ПолучитьПоследнее(Период, Новый Структура("ВидКотировки", ВидКотировки)).Значение;

КонецФункции

Функция ПолучитьКурс(ВидКотировки, Знач Период = Неопределено) Экспорт

	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Курс = ПолучитьПоследнее(Период, Новый Структура("ВидКотировки", ВидКотировки));
	
	Возврат Новый Структура("Курс, Кратность", Курс.Значение, ?(Курс.Кратность=0, 1, Курс.Кратность));

КонецФункции

Функция КроссКурс(Период, ВалютаТекущая, ВалютаНовая = Неопределено, Организация = Неопределено) Экспорт

	КурсНовый = Неопределено;//ФВ
	КурсТекущий = Неопределено;//ВД
	
	Если Организация <> Неопределено Тогда
		
		Запрос = Новый Запрос(ТекстЗапроса_КроссКурс());
		
		Запрос.УстановитьПараметр("ВалютаНовая", 	ВалютаНовая);
		Запрос.УстановитьПараметр("ВалютаТекущая", 	ВалютаТекущая);
		Запрос.УстановитьПараметр("Организация", 	Организация);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			КурсТекущий = ПолучитьКурс(Выборка.КотировкаТекущая, Период);
			Если ЗначениеЗаполнено(КурсТекущий.Курс) И ЗначениеЗаполнено(Выборка.КотировкаНовая) Тогда
				КурсНовый = ПолучитьКурс(Выборка.КотировкаНовая, Период);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Если (КурсНовый = Неопределено) Или (КурсТекущий = Неопределено) Тогда
		КурсНовый = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаНовая, Период);
		КурсТекущий = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаТекущая, Период);
	КонецЕсли;
	
	// 100 EUR в RUB = 100*КК = 100 * 60 / 1 = 6000 (1EUR=60RUB, кк EUR - 60/1)
	// 100 EUR в USD = 100*КК = 100 * 60 / 50 = 120 (1EUR=1.2USD, кк EUR - 60*1/(50*1))
	Возврат Новый Структура("Курс, Кратность", 
					КурсНовый.Курс * КурсТекущий.Кратность, 
					КурсТекущий.Курс * КурсНовый.Кратность); 
	
КонецФункции

Процедура ЗаполнитьКроссКурсВО(Запрос, РеквизитыУП) Экспорт

	КроссКурсВО = КроссКурс(
		РеквизитыУП.Дата, 
		РеквизитыУП.ФункциональнаяВалюта, 
		РеквизитыУП.ВалютаПредставления, 
		РеквизитыУП.Организация);
		
	Запрос.УстановитьПараметр("КурсВО",
		?(ЗначениеЗаполнено(КроссКурсВО.Курс), КроссКурсВО.Курс, 1));
		
	Запрос.УстановитьПараметр("КратностьВО",
		?(ЗначениеЗаполнено(КроссКурсВО.Кратность), КроссКурсВО.Кратность, 1));

КонецПроцедуры

Функция ТекстЗапроса_КроссКурс() Экспорт
	
	// Если ВалютаРегламентированногоУчета = ВалютаСтраны - используем рс.КурсыВалют
	// Если ВалютаКотировки не найдена - используем рс.КурсыВалют
	// Если ВБ не найдена И ВБ <> ВалютаСтраны - используем рс.КурсыВалют
	// Если ВБ не найдена И ВБ = ВалютаСтраны - считаем что Курс/кратность=1/1
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВалютыСтран.Валюта КАК ВалютаБанкаСтраны,
	|	ВалютаНовая.Ссылка КАК КотировкаНовая,
	|	ВалютаТекущая.Ссылка КАК КотировкаТекущая
	|ИЗ
	|	РегистрСведений.ВалютыСтран КАК ВалютыСтран
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ВалютаРегламентированногоУчета КАК ВалютаРегл
	|		ПО ВалютыСтран.Валюта <> ВалютаРегл.Значение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыКотировокФинансовыхИнструментов КАК ВалютаТекущая
	|		ПО ВалютыСтран.Валюта = ВалютаТекущая.Валюта
	|			И (ВалютаТекущая.ТипКотировки = ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.КурсВалюты))
	|			И (ВалютаТекущая.ФункциональнаяВалюта = &ВалютаТекущая)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКотировокФинансовыхИнструментов КАК ВалютаНовая
	|		ПО ВалютыСтран.Валюта = ВалютаНовая.Валюта
	|			И (ВалютаНовая.ТипКотировки = ЗНАЧЕНИЕ(Перечисление.ТипыКотировокФинансовыхИнструментов.КурсВалюты))
	|			И (ВалютаНовая.ФункциональнаяВалюта = &ВалютаНовая)
	|ГДЕ
	|	ВалютыСтран.Страна = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).СтранаРегистрации";
	
	Если Не ОбщегоНазначенияПовтИспУХ.ЕстьРСБУ() Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
			"ВалютаРегламентированногоУчета", 
			"ВалютаУправленческогоУчета");
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецЕсли
