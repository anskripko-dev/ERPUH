
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьОписание();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидКотировкиПриИзменении(Элемент)
	ОбновитьОписание();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьОписание()
	
	Если ТипЗнч(Запись.ВидКотировки) <> Тип("СправочникСсылка.ВидыКотировокФинансовыхИнструментов") Тогда		
		Элементы.ДекорацияОписание.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	Элементы.ДекорацияОписание.Заголовок = Справочники.ВидыКотировокФинансовыхИнструментов.ПолучитьОписаниеЗначенияКотировки(Запись.ВидКотировки);
	
	Элементы.Кратность.Видимость = (Запись.ВидКотировки.ТипКотировки = Перечисления.ТипыКотировокФинансовыхИнструментов.КурсВалюты);
	
КонецПроцедуры

#КонецОбласти
