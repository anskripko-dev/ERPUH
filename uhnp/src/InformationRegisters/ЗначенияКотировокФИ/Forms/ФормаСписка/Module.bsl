
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СинонимыПолей = Новый Структура("ВидКотировки", "Котировка");
	УправлениеФормойУХ.УстановитьПредставлениеОтбора(ЭтотОбъект,,,,,СинонимыПолей);
	
	Если Параметры.Отбор.Свойство("ВидКотировки") И ЗначениеЗаполнено(Параметры.Отбор.ВидКотировки) Тогда
		Элементы.ВидКотировки.Видимость = Ложь;
	КонецЕсли;
	
	УО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(УО.Поля, "Кратность");
	УО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	ТиповыеОтчетыУХ.ДобавитьОтбор(УО.Отбор, "ВидКотировки.ТипКотировки", 
		Перечисления.ТипыКотировокФинансовыхИнструментов.КурсВалюты, , Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗначенияКотировки(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = "РегистрСведений.ЗначенияКотировокФИ";
	ВидКотировки = ТекущаяСтрока.ВидКотировки;
	
	ДопПараметры = Новый Структура("ИмяОбъекта, ИмяТЧ, ИсточникКолонок",
									ИмяТЧ, ИмяТЧ, "НЗ");

	Отбор = Новый Структура("ВидКотировки", ВидКотировки);
	
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДопПараметры);
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ОписаниеКоманды",	ОписаниеКоманды);
	ПараметрыЗагрузки.Вставить("Форма",				ЭтотОбъект);
	ПараметрыЗагрузки.Вставить("Объект",			ВидКотировки);
	ПараметрыЗагрузки.Вставить("Отбор",				Отбор);
	ПараметрыЗагрузки.Вставить("ОтборыТипов",		ВстраиваниеУХКлиентСервер.ПустыеОтборыТипов());
	ПараметрыЗагрузки.Вставить("ПропуститьПроверкуЗагрузки",	Истина);
	
	МСФОКлиентУХ.ЗагрузкаДанных_Подключаемый(ВидКотировки, ПараметрыЗагрузки);

КонецПроцедуры

#КонецОбласти

