#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВидОтчета = Константы.ВидОтчетаБюджетированияПлатежногоКалендаря.Получить();
	Если НЕ ЗначениеЗаполнено(ВидОтчета) Тогда
		ТекстСообщения = Нстр("ru = 'Не выбран вид отчета, содержащего данные для платежного календаря.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
		
	ЗаполнитьСписокВыбораРеквизитов(СписокВыбораРеквизита, Запись.ПоказательОтчета);
	ЗаполнитьПредставленияРеквизитов();
	
	Для каждого Элемент Из Элементы.ГруппаРеквизиты.ПодчиненныеЭлементы Цикл
		Элемент.УстановитьДействие("НачалоВыбора", "Подключаемый_РеквизитНачалоВыбора");
	КонецЦикла;	
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиШапкиФормы
&НаСервере
Процедура ПоказательОтчетаПриИзмененииНаСервере()
	Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ПоказательОтчета, "Владелец");
	Если Владелец <> ВидОтчета Тогда
		ТекстСообщения = СтрШаблон(Нстр("ru = 'Выбранный показатель не относится к виду отчета %1'"), ВидОтчета);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"ПоказательОтчета", "Запись");
		Запись.ПоказательОтчета = Справочники.ПоказателиОтчетов.ПустаяСсылка();
	КонецЕсли;
	
	ЗаполнитьСписокВыбораРеквизитов(СписокВыбораРеквизита, Запись.ПоказательОтчета);
	ЗаполнитьПредставленияРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказательОтчетаПриИзменении(Элемент)
	ПоказательОтчетаПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокТипов = СписокТиповДляВыбора(Элемент.Имя);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлемента", Элемент.Имя);
	ДополнительныеПараметры.Вставить("ИмяРеквизитаПредставления", "Представление" + Элемент.Имя);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РеквизитВыборТипаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	СписокТипов.ПоказатьВыборЭлемента(ОписаниеОповещения, Нстр("ru = 'Выбор типа данных'"), Элемент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокТиповДляВыбора(ИмяРеквизита)
	
	МетаданныеРесурсы = Метаданные.РегистрыСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю.Ресурсы;
	Ресурс = МетаданныеРесурсы.Найти(ИмяРеквизита);
	МассивТипов = Ресурс.Тип.Типы();
	СписокТипов = Новый СписокЗначений;
	СписокТипов.ЗагрузитьЗначения(МассивТипов);
	
	Возврат СписокТипов;
	
КонецФункции

&НаКлиенте
Процедура РеквизитВыборТипаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
	
		ОписаниеОповещения = Новый ОписаниеОповещения("РеквизитВыборЭлементаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ВыбранныйТип = ВыбранныйЭлемент.Значение;
		Если ВыбранныйТип = Тип("ПеречислениеСсылка.РеквизитыПоказателейОтчетов") Тогда
			СписокВыбораРеквизита.ПоказатьВыборЭлемента(ОписаниеОповещения, Нстр("ru = 'Выбор реквизита показателя'"), Элементы[ДополнительныеПараметры.ИмяЭлемента]);
		Иначе	
			ПараметрыОткрытия = ПараметрыОткрытияФормыВыбораРеквизита(ВыбранныйТип);
			ПоказатьВводЗначения(ОписаниеОповещения,,ПараметрыОткрытия.Подсказка, ВыбранныйТип);
		КонецЕсли;
	
	КонецЕсли;
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыОткрытияФормыВыбораРеквизита(ВыбранныйТип)
	
	Мет = Метаданные.НайтиПоТипу(ВыбранныйТип);
	
	Подсказка = Мет.Представление();
	ПараметрыОткрытия = Новый Структура("Подсказка", Подсказка);
	
	Возврат ПараметрыОткрытия;
	
КонецФункции	

&НаКлиенте
Процедура РеквизитВыборЭлементаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		Если ТипЗнч(ВыбранныйЭлемент) = Тип("ЭлементСпискаЗначений") Тогда
			Запись[ДополнительныеПараметры.ИмяЭлемента] = ВыбранныйЭлемент.Значение;
			ЭтотОбъект[ДополнительныеПараметры.ИмяРеквизитаПредставления] = ВыбранныйЭлемент.Представление;
		Иначе
			Запись[ДополнительныеПараметры.ИмяЭлемента] = ВыбранныйЭлемент;
			ЭтотОбъект[ДополнительныеПараметры.ИмяРеквизитаПредставления] = Строка(ВыбранныйЭлемент);
		КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура ЗаполнитьПредставленияРеквизитов()
		
	МетаданныеРесурсы = Метаданные.РегистрыСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю.Ресурсы;
	Для каждого Ресурс Из МетаданныеРесурсы Цикл
		Значение = Запись[Ресурс.Имя];
		ИмяРеквизитаПредставления = "Представление" + Ресурс.Имя;
		Представление = "";
		Если ТипЗнч(Значение) = Тип("ПеречислениеСсылка.РеквизитыПоказателейОтчетов") Тогда
			Эл = СписокВыбораРеквизита.НайтиПоЗначению(Значение);
			Если Эл <> Неопределено Тогда
				Представление = Эл.Представление;
			Иначе
				ТекстСообщения = Нстр("ru = 'Не найден реквизит %1 в доступных реквизитах показателя.
                                       |Значение очищено.'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Значение);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, ИмяРеквизитаПредставления);
				Запись[Ресурс.Имя] = Неопределено;
			КонецЕсли;
			
		Иначе
			Представление = Строка(Значение);
		КонецЕсли;
		
		ЭтотОбъект[ИмяРеквизитаПредставления] = Представление;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСписокВыбораРеквизитов(СписокВыбораРеквизита, ПоказательОтчета)
	
	СписокВыбораРеквизита.Очистить();
	
	РеквизитыПоказателя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоказательОтчета, "Владелец, ГруппаРаскрытия");
		
	ТаблицаВидовАналитикГруппы = ОбщегоНазначенияУХ.ЗаполнитьВидыАналитик(РеквизитыПоказателя.ГруппаРаскрытия);
	ТаблицаВидовАналитикОтчета = ОбщегоНазначенияУХ.ЗаполнитьВидыАналитик(РеквизитыПоказателя.Владелец);
	
	Количество = Перечисления.РеквизитыПоказателейОтчетов.Количество();
	МетЗначенияПеречисления = Метаданные.Перечисления.РеквизитыПоказателейОтчетов.ЗначенияПеречисления;
	Для Индекс = 0 По Количество - 1 Цикл
		Значение = Перечисления.РеквизитыПоказателейОтчетов[Индекс];
		Имя = МетЗначенияПеречисления.Получить(Индекс).Имя;
		Синоним = МетЗначенияПеречисления.Получить(Индекс).Синоним;
		
		Если Лев(Имя, СтрДлина("Аналитика")) = "Аналитика" Тогда	
			
			Представление = "";
			Строка = ТаблицаВидовАналитикГруппы.Найти(Имя, "КодАналитики");
			Если Строка = Неопределено Тогда
				Строка = ТаблицаВидовАналитикОтчета.Найти(Имя, "КодАналитики");
			КонецЕсли;	 
			
			Если Строка	<> Неопределено Тогда
				Представление = Строка.ПредставлениеАналитики;
				СписокВыбораРеквизита.Добавить(Значение, Представление);
			КонецЕсли;
		Иначе	
			СписокВыбораРеквизита.Добавить(Значение, Синоним);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

