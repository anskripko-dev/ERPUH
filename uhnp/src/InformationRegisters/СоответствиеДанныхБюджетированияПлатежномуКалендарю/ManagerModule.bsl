#Область ПрограммныйИнтерфейс
Функция ПоказателиБюджетирования() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СоответствиеДанныхБюджетированияПлатежномуКалендарю.ПоказательОтчета КАК ПоказательОтчета
	|ИЗ
	|	РегистрСведений.СоответствиеДанныхБюджетированияПлатежномуКалендарю КАК СоответствиеДанныхБюджетированияПлатежномуКалендарю"
	);
	
	МассивПоказателей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПоказательОтчета");
	
	Возврат МассивПоказателей;
	
КонецФункции
#КонецОбласти