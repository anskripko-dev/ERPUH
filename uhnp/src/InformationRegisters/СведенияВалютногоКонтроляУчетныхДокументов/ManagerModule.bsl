#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область СлужебныйПрограммныйИнтерфейс	
#Область ОбновлениеИБ
	
Процедура ПеренестиДанныеУчетныхДокументов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СправкаОПодтверждающихДокументах.Ссылка КАК Регистратор,
	|	СправкаОПодтверждающихДокументах.Дата КАК Период,
	|	СправкаОПодтверждающихДокументахПодтверждающиеДокументы.ПодтверждающийДокумент КАК ДокументРасчетов,
	|	СправкаОПодтверждающихДокументахПодтверждающиеДокументы.ОжидаемыйСрок КАК СрокРепатриации,
	|	СправкаОПодтверждающихДокументахПодтверждающиеДокументы.СуммаДокумента КАК СуммаДокументаРасчетов,
	|	NULL КАК Сумма
	|ИЗ
	|	Документ.СправкаОПодтверждающихДокументах.ПодтверждающиеДокументы КАК СправкаОПодтверждающихДокументахПодтверждающиеДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СправкаОПодтверждающихДокументах КАК СправкаОПодтверждающихДокументах
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияВалютногоКонтроляУчетныхДокументов КАК СведенияВалютногоКонтроляУчетныхДокументов
	|			ПО (СведенияВалютногоКонтроляУчетныхДокументов.Регистратор = СправкаОПодтверждающихДокументах.Ссылка)
	|		ПО СправкаОПодтверждающихДокументахПодтверждающиеДокументы.Ссылка = СправкаОПодтверждающихДокументах.Ссылка
	|			И (СправкаОПодтверждающихДокументахПодтверждающиеДокументы.ПодтверждающийДокумент <> НЕОПРЕДЕЛЕНО)
	|ГДЕ
	|	СправкаОПодтверждающихДокументах.Проведен
	|	И СведенияВалютногоКонтроляУчетныхДокументов.Регистратор ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СправкаОВалютныхОперациях.Ссылка,
	|	СправкаОВалютныхОперациях.Дата,
	|	СправкаОВалютныхОперацияхВалютныеОперации.Документ,
	|	СправкаОВалютныхОперацияхВалютныеОперации.ОжидаемыйСрок,
	|	NULL,
	|	СправкаОВалютныхОперацияхВалютныеОперации.Сумма
	|ИЗ
	|	Документ.СправкаОВалютныхОперациях.ВалютныеОперации КАК СправкаОВалютныхОперацияхВалютныеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СправкаОВалютныхОперациях КАК СправкаОВалютныхОперациях
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияВалютногоКонтроляУчетныхДокументов КАК СведенияВалютногоКонтроляУчетныхДокументов
	|			ПО (СведенияВалютногоКонтроляУчетныхДокументов.Регистратор = СправкаОВалютныхОперациях.Ссылка)
	|		ПО СправкаОВалютныхОперацияхВалютныеОперации.Ссылка = СправкаОВалютныхОперациях.Ссылка
	|			И (СправкаОВалютныхОперацияхВалютныеОперации.Документ <> НЕОПРЕДЕЛЕНО)
	|ГДЕ
	|	СправкаОВалютныхОперациях.Проведен
	|	И СведенияВалютногоКонтроляУчетныхДокументов.Регистратор ЕСТЬ NULL
	|ИТОГИ ПО
	|	Регистратор";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.СведенияВалютногоКонтроляУчетныхДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ВыборкаДетальныеЗаписи);
			
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
КонецПроцедуры

#КонецОбласти                         
#КонецОбласти
	
#КонецЕсли