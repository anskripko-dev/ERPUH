Процедура ПерепровестиДокументы(МассивВыделенныхСтрок = Неопределено) Экспорт   
	
	СтараяАрхитектураВзаиморасчетов = Константы.НеНоваяАрхитектураВзаиморасчетов.Получить(); 
	НоваяАрхитектураВзаиморасчетов = Константы.НоваяАрхитектураВзаиморасчетов.Получить();
	Если СтараяАрхитектураВзаиморасчетов И НЕ НоваяАрхитектураВзаиморасчетов  Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок = Неопределено Тогда
		//обходим все данные в регистре 		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов
		|ИЗ
		|	РегистрСведений.тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов КАК тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов";
		
		РезультатЗапроса = Запрос.Выполнить();	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Попытка
				ПроведениеДокументаПоНовойАрхитектуре(ВыборкаДетальныеЗаписи.ДокументВзаиморасчетов) ;
			Исключение                       
			КонецПопытки;     	
		КонецЦикла;
	Иначе   
		Для Каждого СтрокаРегистра из МассивВыделенныхСтрок Цикл
			Попытка   
				ЗаписьПерезаписываемогоДокумента = РегистрыСведений.тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ЗаписьПерезаписываемогоДокумента, СтрокаРегистра);
				ЗаписьПерезаписываемогоДокумента.Прочитать(); 
				ПерезаписываемыйДокумент = ЗаписьПерезаписываемогоДокумента.ДокументВзаиморасчетов;
				ПроведениеДокументаПоНовойАрхитектуре(ПерезаписываемыйДокумент);
			Исключение                       
			КонецПопытки;             
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры  

Процедура ПроведениеДокументаПоНовойАрхитектуре(ПерезаписываемыйДокумент)
	
	ДокОбъект = ПерезаписываемыйДокумент.ПолучитьОбъект();
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	НаборЗаписей = РегистрыСведений.тн_ДобавленныеДокументыПоСтаройАрхитектуреВзаиморасчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументВзаиморасчетов.Установить(ПерезаписываемыйДокумент);
	НаборЗаписей.Очистить(); 
	НаборЗаписей.Записать();
	
КонецПроцедуры