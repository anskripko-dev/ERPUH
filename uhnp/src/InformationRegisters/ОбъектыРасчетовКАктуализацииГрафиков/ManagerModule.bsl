#Область ПрограммныйИнтерфейс

Процедура ЗарегистрироватьГрафикРасчетов(ОбъектРасчетов) Экспорт  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		Возврат;
	КонецЕсли; 	   
	
	МенеджерЗаписи = РегистрыСведений.ОбъектыРасчетовКАктуализацииГрафиков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОбъектРасчетов = ОбъектРасчетов;
	
	МенеджерЗаписи.Записать();	

КонецПроцедуры  

Процедура УдалитьГрафикРасчетов(ОбъектРасчетов) Экспорт  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		Возврат;
	КонецЕсли; 	   
	
	МенеджерЗаписи = РегистрыСведений.ОбъектыРасчетовКАктуализацииГрафиков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОбъектРасчетов = ОбъектРасчетов;
	
	МенеджерЗаписи.Удалить();	

КонецПроцедуры

Функция ЭтоОтложенныйГрафикРасчетов(ОбъектРасчетов) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов КАК ОбъектРасчетов
	|ИЗ
	|	РегистрСведений.ОбъектыРасчетовКАктуализацииГрафиков КАК ОбъектыРасчетовКАктуализацииГрафиков
	|ГДЕ
	|	ОбъектыРасчетовКАктуализацииГрафиков.ОбъектРасчетов = &ОбъектРасчетов";
	
	Запрос.УстановитьПараметр("ОбъектРасчетов", ОбъектРасчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции    

