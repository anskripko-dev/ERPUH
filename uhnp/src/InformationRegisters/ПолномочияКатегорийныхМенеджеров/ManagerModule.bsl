#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
// Возвращает массив товарных категорий, сопоставленных менеджеру ПользовательВход
// в организации ОрганизацияВход.
Функция ПолучитьТоварныеКатегорииПоМенеджеру(ПользовательВход, ОрганизацияВход) Экспорт
	РезультатФункции = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория КАК ТоварнаяКатегория
		|ИЗ
		|	РегистрСведений.ПолномочияКатегорийныхМенеджеров КАК ПолномочияКатегорийныхМенеджеров
		|ГДЕ
		|	ПолномочияКатегорийныхМенеджеров.Менеджер = &Менеджер
		|	И ПолномочияКатегорийныхМенеджеров.Организация В(&Организация)
		|	И ТИПЗначения(ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория) = ТИП(Справочник.КатегорииЗакупок)";
	Запрос.УстановитьПараметр("Менеджер", ПользовательВход);
	Запрос.УстановитьПараметр("Организация", ОрганизацияВход);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатФункции.Добавить(ВыборкаДетальныеЗаписи.ТоварнаяКатегория);
	КонецЦикла;
	РезультатФункции = ОбщегоНазначенияКлиентСервер.СвернутьМассив(РезультатФункции);
	РезультатФункции = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(РезультатФункции);
	РезультатФункции = ОбщегоНазначенияКлиентСерверУХ.СортироватьМассив(РезультатФункции);
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьТоварныеКатегорииПоМенеджеру()
	
#КонецЕсли