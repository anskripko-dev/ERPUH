#Область ПрограммныйИнтерфейс 

Процедура СброситьЗависшиеСообщенияRMQ() Экспорт
	
	МаксимальноеВремяОбработкиПорцииСообщенийRMQ = Константы.тн_Интеграция_МаксимальноеВремяОбработкиПорцииСообщенийRMQ.Получить(); 
	Если Не ЗначениеЗаполнено(МаксимальноеВремяОбработкиПорцииСообщенийRMQ) Тогда
		Возврат;
	КонецЕсли;
	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//ГраницаЗависшихСообщений = тн_Интеграция_УПП.ТекущаяДатаСервера() - МаксимальноеВремяОбработкиПорцииСообщенийRMQ * 60;
	ГраницаЗависшихСообщений = ТекущаяДатаСервера() - МаксимальноеВремяОбработкиПорцииСообщенийRMQ * 60;
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ИДСообщения КАК ИДСообщения
		|ИЗ
		|	РегистрСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ КАК тн_Интеграция_СтатусыОбработкиСообщенийRMQ
		|ГДЕ
		|	тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ВРаботе
		|	И тн_Интеграция_СтатусыОбработкиСообщенийRMQ.ДатаПостановкиВРаботу < &ГраницаЗависшихСообщений";    	
	
	Запрос.УстановитьПараметр("ГраницаЗависшихСообщений", ГраницаЗависшихСообщений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  		
		ИзменитьСтатус(ВыборкаДетальныеЗаписи.ИДСообщения, Ложь);  			
	КонецЦикла; 	
			
КонецПроцедуры // СброситьЗависшиеСообщенияRMQ()

Процедура ИзменитьСтатус(ИДСообщения, ВРаботе) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.ИДСообщения = ИДСообщения;
	
	МенеджерЗаписи.Прочитать();     		
	
	МенеджерЗаписи.ИДСообщения = ИДСообщения;
	
	МенеджерЗаписи.ВРаботе = ВРаботе;	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//МенеджерЗаписи.ДатаПостановкиВРаботу = ?(ВРаботе, тн_Интеграция_УПП.ТекущаяДатаСервера(), Дата(1,1,1));
	МенеджерЗаписи.ДатаПостановкиВРаботу = ?(ВРаботе, ТекущаяДатаСервера(), Дата(1,1,1));
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Если ВРаботе Тогда
		МенеджерЗаписи.КоличествоПопыток = МенеджерЗаписи.КоличествоПопыток + 1;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
			
КонецПроцедуры // ИзменитьСтатус()

Процедура УдалитьСтатус(ИДСообщения) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИДСообщения = ИДСообщения;
	МенеджерЗаписи.Удалить();
			
КонецПроцедуры // УдалитьСтатус()

#КонецОбласти

