
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьТаблицу();
	
	Если Параметры.Свойство("ШаблонНазначенияПлатежа") Тогда
		ШаблонНазначенияПлатежа = Параметры.ШаблонНазначенияПлатежа;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ШаблонНазначенияПлатежаПриИзменении(Элемент)
	ВыполнитьПроверкуТекста();	
КонецПроцедуры

&НаКлиенте
Процедура ПроверочныйТекстПриИзменении(Элемент)
	ВыполнитьПроверкуТекста();
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаУправляющихКонструкций
&НаКлиенте
Процедура ТаблицаУправляющихКонструкцийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	ДобавитьТекстВШаблон(ТекДанные.Символы);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	Закрыть(ШаблонНазначенияПлатежа);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТекст(Команда)
	ВыполнитьПроверкуТекста();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Проверка не пройдена
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПроверочныйТекст.Имя);

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РезультатПроверки", ВидСравненияКомпоновкиДанных.Равно,1,,Истина);

	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПредупреждения);
	
	// Проверка пройдена
	ЭлементУО = УсловноеОформление.Элементы.Добавить();

	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ПроверочныйТекст.Имя);

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РезультатПроверки", ВидСравненияКомпоновкиДанных.Равно,2,,Истина);

	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаУдачнойОтправки);

	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекстВШаблон(ДобавляемыйТекст)
	
	ШаблонНазначенияПлатежа = ШаблонНазначенияПлатежа + ДобавляемыйТекст;
	ВыполнитьПроверкуТекста();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуТекста()
	
	ТекстДляПроверки = Элементы.ПроверочныйТекст.ТекстРедактирования;
	ТекстШаблона = Элементы.ШаблонНазначенияПлатежа.ТекстРедактирования;
	
	Если ПустаяСтрока(ТекстДляПроверки) Тогда
		РезультатПроверки = 0;
	Иначе
		РезультатПроверки = ПроверитьТекстНаСервере(ТекстДляПроверки, ТекстШаблона);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьТекстНаСервере(ПроверяемыйТекст, Шаблон)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|&ПроверяемыйТекст ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\"" КАК Результат";
	
	Запрос.УстановитьПараметр("ПроверяемыйТекст", ПроверяемыйТекст);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Результат Тогда
			Возврат 2; // Проверка пройдена.
		Иначе
			Возврат 1; // Проверка не пройдена.
		КонецЕсли;
	Иначе
		Возврат 0; // Проверка не выполнялась.
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицу()
	
	ДобавитьСтрокуТаблицы("_", НСтр("ru = 'Один произвольный символ'"));
	ДобавитьСтрокуТаблицы("%", НСтр("ru = 'Любое количество произвольных символов'"));
	ДобавитьСтрокуТаблицы(НСтр("ru = '[абв]'"), НСтр("ru = 'Любой символ из а, б или в'"));
	ДобавитьСтрокуТаблицы(НСтр("ru = '[^абв]'"), НСтр("ru = 'Любой символ кроме а, б, в'"));
	ДобавитьСтрокуТаблицы(НСтр("ru = '[а-я]'"), НСтр("ru = 'Любой символ из диапазона а-я'"));
	ДобавитьСтрокуТаблицы(НСтр("ru = '[^а-я]'"), НСтр("ru = 'Любой символ, не входящий в диапазон а-я'"));
	ДобавитьСтрокуТаблицы(НСтр("ru = '[а-я0-9]'"), НСтр("ru = 'Любой символ из диапазонов а-я или 0-9'"));
	ДобавитьСтрокуТаблицы("\[", НСтр("ru = 'Символ ['"));
	ДобавитьСтрокуТаблицы("\]", НСтр("ru = 'Символ ]'"));
	ДобавитьСтрокуТаблицы("\^", НСтр("ru = 'Символ ^'"));
	ДобавитьСтрокуТаблицы("\_", НСтр("ru = 'Символ _'"));
	ДобавитьСтрокуТаблицы("\%", НСтр("ru = 'Символ %'"));
	ДобавитьСтрокуТаблицы("\\", НСтр("ru = 'Символ \'"));

	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуТаблицы(Символы, Описание)
	
	НовСтрока = ТаблицаУправляющихКонструкций.Добавить();
	НовСтрока.Символы = Символы;
	НовСтрока.Описание = Описание;
	
КонецПроцедуры

#КонецОбласти
