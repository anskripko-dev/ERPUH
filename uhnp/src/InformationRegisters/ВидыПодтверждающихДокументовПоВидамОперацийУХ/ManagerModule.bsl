#Область ПрограмнныйИнтерфейс
	
Функция ВидыПодтверждающихДокументовОбязательные(ВидОперацииУХ) Экспорт
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
		"ВЫБРАТЬ
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента КАК ВидДокумента
		|ИЗ
		|	РегистрСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ КАК ВидыПодтверждающихДокументовПоВидамОперацийУХ
		|ГДЕ
		|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ = &ВидОперацииУХ
		|	И ВидыПодтверждающихДокументовПоВидамОперацийУХ.Обязателен";
	
	Запрос.УстановитьПараметр("ВидОперацииУХ", ВидОперацииУХ);

	РезультатЗапроса 		= Запрос.Выполнить();
	ВыборкаДетальныеЗаписи 	= РезультатЗапроса.Выбрать();
	МассивВидов 			= Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивВидов.Добавить(ВыборкаДетальныеЗаписи.ВидДокумента)
	КонецЦикла;

	Возврат МассивВидов;
КонецФункции // ()  

 #КонецОбласти 
