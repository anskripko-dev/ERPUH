#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("МассивВидовОпераций")
			Тогда
	    Для каждого МассивЭлемент Из Параметры.МассивВидовОпераций Цикл
		   СтрокаТаблицы = ТаблицаВидовОпераций.Добавить();
		   СтрокаТаблицы.ВидОперации =  МассивЭлемент;
		КонецЦикла;
	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Создать(Команда) 
	
	Если Не ЗначениеЗаполнено(ВидПодтверждающегоДокумента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Поле ""Вид подтверждающего документа"" не заполнено.'"),,
			"ВидПодтверждающегоДокумента");
        Возврат;
	КонецЕсли;
	СоздатьНаСервере();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьНаСервере()
	
	Для каждого СтрокаТаблицы Из ТаблицаВидовОпераций Цикл
		МенеджерЗаписи = РегистрыСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидОперацииУХ 				= СтрокаТаблицы.ВидОперации;
		МенеджерЗаписи.ВидПодтверждающегоДокумента 	= ВидПодтверждающегоДокумента;
	    МенеджерЗаписи.Обязателен 					= Обязателен; 
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

