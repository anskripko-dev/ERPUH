#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор") И 
		Параметры.Отбор.Свойство("ВидОперацииУХ") Тогда
	    УстановитьВидОперации(Параметры.Отбор.ВидОперацииУХ);
		Элементы.СписокВидовОпераций.Видимость = Ложь;
	Иначе
		УстановитьВидОперации(Справочники.ВидыОперацийУХ.ПустаяСсылка());	
	КонецЕсли; 
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокВидовОпераций
 &НаКлиенте
Процедура СписокВидовОперацийПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УстановитьВидОперации(Элемент.ТекущиеДанные.ВидОперации);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокВидовОперацийПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
	
	"ВЫБРАТЬ
	|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ КАК ВидОперацииУХ,
	|	ПРЕДСТАВЛЕНИЕ(ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ) КАК ВидОперацииУХСтрока,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидПодтверждающегоДокумента) КАК ВидПодтверждающихДокументов
	|ИЗ
	|	РегистрСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ КАК ВидыПодтверждающихДокументовПоВидамОперацийУХ
	|ГДЕ
	|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ В (&ВидОперацииУХ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВидыПодтверждающихДокументовПоВидамОперацийУХ.ВидОперацииУХ";
	Запрос.УстановитьПараметр("ВидОперацииУХ", Строки.ПолучитьКлючи());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	    СтрокаСписка = Строки[Выборка.ВидОперацииУХ];
		МассивНаименования = Новый Массив;
		МассивНаименования.Добавить(Выборка.ВидОперацииУХСтрока);
		МассивНаименования.Добавить(" (");
		МассивНаименования.Добавить(Выборка.ВидПодтверждающихДокументов);
		МассивНаименования.Добавить(")");
		СтрокаСписка.Оформление["ВидОперации"].УстановитьЗначениеПараметра("Текст", СтрСоединить(МассивНаименования));
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти  

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	Элементы.СписокВидовОпераций.Обновить();
КонецПроцедуры	

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьВиды(Команда)   
	
	ВыделенныеСтроки = Элементы.СписокВидовОпераций.ВыделенныеСтроки;
	
	Если НЕ ВыделенныеСтроки.Количество() Тогда
		Возврат;	
	КонецЕсли;
	
	МассивВидовОпераций = Новый Массив;
	Для каждого СтрокаСписка Из ВыделенныеСтроки Цикл
			ТекущиеДанные = Элементы.СписокВидовОпераций.ДанныеСтроки(СтрокаСписка);
			МассивВидовОпераций.Добавить(ТекущиеДанные.ВидОперации);
	КонецЦикла;

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МассивВидовОпераций", МассивВидовОпераций);                               
	ОповещениеСозданиеВидов = Новый ОписаниеОповещения("ПослеСозданияВидов",ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ.Форма.ФормаСозданияВидов",
					СтруктураПараметров,,,,,ОповещениеСозданиеВидов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВид(Команда)

	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если Элементы.СписокВидовОпераций.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидОперацииУХ    = Элементы.СписокВидовОпераций.ТекущиеДанные.ВидОперации;
	
	Если НЕ ВыделенныеСтроки.Количество() Тогда
		Возврат;	
	КонецЕсли; 
	
	МассивВидовОпераций = Новый Массив;
	Для каждого СтрокаСписка Из ВыделенныеСтроки Цикл
			ТекущиеДанные 	= Элементы.Список.ДанныеСтроки(СтрокаСписка); 
			СтруктураСтроки = Новый Структура("ВидОперацииУХ, ВидПодтверждающегоДокумента",	
											   ВидОперацииУХ, ТекущиеДанные.ВидПодтверждающегоДокумента);
         	МассивВидовОпераций.Добавить(СтруктураСтроки);
	КонецЦикла;
	ТекстВопроса = НСтр("ru = 'Продолжить удаление?'");
	СтруктураПараметров = Новый Структура; 
	СтруктураПараметров.Вставить("МассивВидовОпераций", МассивВидовОпераций); 
	ОповещениеУдаления 	= Новый ОписаниеОповещения("ПослеУдаленияВидовЗавершение",ЭтотОбъект, СтруктураПараметров);
 
	ПоказатьВопрос(ОповещениеУдаления, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеСозданияВидов(Результат, ДополнительныеПараметры) Экспорт

	Элементы.СписокВидовОпераций.Обновить();  
	Элементы.Список.Обновить(); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидОперации(ВидОперацииУХ)
	
	Список.Отбор.Элементы.Очистить();
	Элементы.Список.Доступность 		= НЕ ВидОперацииУХ.ЭтоГруппа;
	НовЭлементОтбора 	= Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    НовЭлементОтбора.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("ВидОперацииУХ");
    НовЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
    НовЭлементОтбора.Использование 		= Истина;
    НовЭлементОтбора.ПравоеЗначение 	= ВидОперацииУХ; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияВидовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        УдалитьМассивВидов(ДополнительныеПараметры.МассивВидовОпераций);
		Элементы.Список.Обновить();	
		Элементы.СписокВидовОпераций.Обновить(); 
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура УдалитьМассивВидов(МассивЗаписей)

	Для каждого ЭлементМассива Из МассивЗаписей Цикл
		НаборЗаписей = РегистрыСведений.ВидыПодтверждающихДокументовПоВидамОперацийУХ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидОперацииУХ.Установить(ЭлементМассива.ВидОперацииУХ);
		НаборЗаписей.Отбор.ВидПодтверждающегоДокумента.Установить(ЭлементМассива.ВидПодтверждающегоДокумента);		
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
