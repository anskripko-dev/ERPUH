
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗначениеПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВидАналитики		= Запись.ВидАналитики;
	ЗначениеПоУмолчанию = Запись.ЗначениеПоУмолчанию;
	ОграничениеТипа		= ПолучитьОграничениеТипа(ВидАналитики);
	
	Элемент.ВыбиратьТип = Ложь;
	
	Если ОграничениеТипа.Типы().Количество() = 1
		И ОграничениеТипа.СодержитТип(Тип("СправочникСсылка.ПроизвольныйКлассификаторУХ")) Тогда
			
		СтандартнаяОбработка = Ложь;
		
		ОткрытьФорму("Справочник.ПроизвольныйКлассификаторУХ.ФормаВыбора", 
			Новый Структура("Отбор", Новый Структура("Владелец", ВидАналитики)),
			ЭтаФорма,,,,
			Новый ОписаниеОповещения("ПослеВыбораЗначенияПоУмолчанию", ЭтаФорма));
			
	Иначе
		
		Элемент.ОграничениеТипа = ОграничениеТипа;
		ЗначениеПоУмолчанию = Элемент.ОграничениеТипа.ПривестиЗначение(ЗначениеПоУмолчанию);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗначенияПоУмолчанию(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Запись.ЗначениеПоУмолчанию = Результат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьОграничениеТипа(ВидАналитики)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАналитики, "ТипЗначения");
	
КонецФункции

#КонецОбласти