#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗНО = КэшируемыеПроцедурыОПК.ПустаяЗаявкаНаОплату();
	ОПДС = КэшируемыеПроцедурыОПК.ПустоеПланируемоеПоступление();
	
	РеквизитыЗНО  = ЗаявкиНаОперации.РеквизитыДокументаЗаявка(ТипЗнч(ЗНО));
	РеквизитыОПДС = ЗаявкиНаОперации.РеквизитыДокументаЗаявка(ТипЗнч(ОПДС));
	
	Свойства = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	
	// ЦФО
	
	ТекстДляЗамены = "ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ЦФО";
	ТекстЗамены = СтрШаблон(
		"ВЫБОР
		|	КОГДА РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.%1
		|		ТОГДА ВЫРАЗИТЬ(РазмещениеЗаявок.ЗаявкаНаОперацию КАК Документ.%1).%2
		|	КОГДА РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.%3
		|		ТОГДА ВЫРАЗИТЬ(РазмещениеЗаявок.ЗаявкаНаОперацию КАК Документ.%3).%4
		|	КОНЕЦ КАК ЦФО",
		ЗНО.Метаданные().Имя,  РеквизитыЗНО.ЦФО.ИмяРеквизита,
		ОПДС.Метаданные().Имя, РеквизитыОПДС.ЦФО.ИмяРеквизита);
	ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ТекстДляЗамены, ТекстЗамены);
		
	// Инициатор
	ТекстДляЗамены = "ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка) КАК Инициатор";
	ТекстЗамены = СтрШаблон(
		"ВЫБОР
		|	КОГДА РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.%1
		|		ТОГДА ВЫРАЗИТЬ(РазмещениеЗаявок.ЗаявкаНаОперацию КАК Документ.%1).%2
		|	КОГДА РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.%3
		|		ТОГДА ВЫРАЗИТЬ(РазмещениеЗаявок.ЗаявкаНаОперацию КАК Документ.%3).%4
		|	КОНЕЦ КАК Инициатор",
		ЗНО.Метаданные().Имя,  РеквизитыЗНО.Ответственный.ИмяРеквизита,
		ОПДС.Метаданные().Имя, РеквизитыОПДС.Ответственный.ИмяРеквизита);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстДляЗамены, ТекстЗамены);
	
	//
	Свойства = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	Свойства.ТекстЗапроса = ТекстЗапроса;
	Свойства.ОсновнаяТаблица = "РегистрСведений.СостоянияИсполненияДокументовПланирования.СрезПоследних";
	Свойства.ДинамическоеСчитываниеДанных = Ложь;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, Свойства);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(,Элементы.Список.ТекущиеДанные.ДокументПланирования);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВернутьВРаботу(Команда)
	ВернутьВРаботуНаСервере(Элементы.Список.ВыделенныеСтроки);
	Элементы.Список.Обновить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВернутьВРаботуНаСервере(Знач КлючиЗаписи)
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого Ключ Из КлючиЗаписи Цикл
			ПлатежныеПозиции.ВернутьПозициюНаИсполнение(Ключ.ИдентификаторПозиции);
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Выполнение операции'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

 

