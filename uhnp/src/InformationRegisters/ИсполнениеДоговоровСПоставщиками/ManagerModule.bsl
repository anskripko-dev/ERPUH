// Записывает движения в набор записей читая данные из выборки запроса.
// Поля запроса должны соответствовать полям регистра.
//
Процедура ЗаполнитьДвиженияИзВыборкиЗапроса(
							НаборЗаписей,
							ВыборкаЗапроса,
							ПостоянныеЗначенияЗаполнения) Экспорт
	Пока ВыборкаЗапроса.Следующий() Цикл
		Движение = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ПостоянныеЗначенияЗаполнения);
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаЗапроса);
	КонецЦикла;	
КонецПроцедуры

// Очистим регистр с отбором по документу.
//
Процедура ОчиститьПоДокументу(ДокументСсылка) Экспорт
	НаборЗаписей = 
		РегистрыСведений.ИсполнениеДоговоровСПоставщиками.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
	НаборЗаписей.Записать(Истина);
КонецПроцедуры


