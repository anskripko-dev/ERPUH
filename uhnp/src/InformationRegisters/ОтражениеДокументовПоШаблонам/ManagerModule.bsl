
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьТипыИсходныхДокументов() Экспорт 
	
	МассивТиповДокументов=Новый Массив; 
	
	Запрос=Новый Запрос; 
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ШаблоныТрансляций.РегистрБухгалтерииИсточник.Наименование КАК НаименованиеРегистра
	|ИЗ
	|	Справочник.ШаблоныТрансляций КАК ШаблоныТрансляций
	|ГДЕ
	|	НЕ ШаблоныТрансляций.ПометкаУдаления
	|	И НЕ ШаблоныТрансляций.РегистрБухгалтерииИсточник = ЗНАЧЕНИЕ(Справочник.РегистрыБухгалтерииБД.ПустаяСсылка)";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Если Метаданные.РегистрыБухгалтерии.Найти(Результат.НаименованиеРегистра)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
	
		МетаданныеРегистрИсточник=Метаданные.РегистрыБухгалтерии[Результат.НаименованиеРегистра];
		
		Для каждого ОбъектМетаданных Из Метаданные.Документы Цикл
			
			Если ОбъектМетаданных.Имя="Трансляция"
				ИЛИ ОбъектМетаданных.Имя="ТрансформационнаяКорректировка"
				ИЛИ (НЕ ОбъектМетаданных.Движения.Содержит(МетаданныеРегистрИсточник)) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипДокумента="Документ." + ОбъектМетаданных.Имя;
			
			Если МассивТиповДокументов.Найти(ТипДокумента)=Неопределено Тогда
				
				МассивТиповДокументов.Добавить("Документ." + ОбъектМетаданных.Имя);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ЕСТЬNULL(ШаблоныТрансформационныхКорректировок.ДокументБД.Наименование, НЕОПРЕДЕЛЕНО) КАК ИмяДокумента
	             |ИЗ
	             |	Справочник.ШаблоныТрансформационныхКорректировок КАК ШаблоныТрансформационныхКорректировок
	             |ГДЕ
	             |	НЕ ЕСТЬNULL(ШаблоныТрансформационныхКорректировок.ДокументБД.Наименование, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО";
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		ОбъектМетаданных=Метаданные.Документы.Найти(Результат.ИмяДокумента);
		
		Если ОбъектМетаданных=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли; 
		
		ТипДокумента="Документ." + ОбъектМетаданных.Имя;
		
		Если МассивТиповДокументов.Найти(ТипДокумента)=Неопределено Тогда
			
			МассивТиповДокументов.Добавить("Документ." + ОбъектМетаданных.Имя);
			
		КонецЕсли;
				
		МассивТиповДокументов.Добавить("Документ." + ОбъектМетаданных.Имя);
		
	КонецЦикла; 
	
	Возврат МассивТиповДокументов; 
		
КонецФункции // ПолучитьТипыИсходныхДокументов()

Процедура ВыполнитьОтражениеОбъекта(ДанныеОбъекта) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.Сценарий) Тогда
		
		ДанныеОбъекта.Сценарий=ДанныеОбъекта.УдалитьСценарий;
		
	КонецЕсли;
	
	ВидДокумента=?(ТипЗнч(ДанныеОбъекта.ШаблонОперации)=Тип("СправочникСсылка.ШаблоныТрансформационныхКорректировок"),
			Перечисления.ВидыДокументовЭтапа.ТрансформационныеКорректировки,
			Перечисления.ВидыДокументовЭтапа.ДокументыТрансляции);
	
	Если ДанныеОбъекта.ПроведениеОтменено Тогда
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода)
			ИЛИ ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) Тогда
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПервогоОтражения) И (НЕ ЗначениеЗаполнено(ДанныеОбъекта.ДокументСторноПервогоОтражения)) Тогда
				
				ВыполнитьСторнированиеОбъекта(ДанныеОбъекта);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПоследнегоОтражения) Тогда
				
				ОчиститьДокументОтражения(ДанныеОбъекта.ДокументПоследнегоОтражения);
				
			КонецЕсли;
			
		Иначе
			
			ОчиститьДокументОтражения(ДанныеОбъекта.ДокументПервогоОтражения);
			
		КонецЕсли;
		
		ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.да;	
	
	ИначеЕсли (НЕ ЗначениеЗаполнено(ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода)) Тогда
		
		ДокументОтражения=КорректировкиЗначенийПоказателей32.ОбработатьКорректировкиПоПараметрам(ВидДокумента,
														ДанныеОбъекта.ПериодОтбора,
														ДанныеОбъекта.Сценарий,
														ДанныеОбъекта.Организация,
														ДанныеОбъекта.ШаблонОперации,
														ДанныеОбъекта.ДатаЗаписиДоЗакрытияПериода,
														ДанныеОбъекта.ДокументПервогоОтражения,
														Неопределено,
														ДанныеОбъекта.ИсходныйДокумент,
														ДанныеОбъекта.УчетнаяПолитика);
														
		Если ДокументОтражения=Неопределено Тогда
			
			Возврат;
			
		Иначе
			
			ДанныеОбъекта.ДокументПервогоОтражения=ДокументОтражения;
			ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.да;						
			
		КонецЕсли;
			
	Иначе
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ДокументПервогоОтражения) И (НЕ ЗначениеЗаполнено(ДанныеОбъекта.ДокументСторноПервогоОтражения)) Тогда
			
			ВыполнитьСторнированиеОбъекта(ДанныеОбъекта);
			
		КонецЕсли;
		
		ДокументОтражения=КорректировкиЗначенийПоказателей32.ОбработатьКорректировкиПоПараметрам(ВидДокумента,
														ДанныеОбъекта.ПериодОтбора,
														ДанныеОбъекта.Сценарий,
														ДанныеОбъекта.Организация,
														ДанныеОбъекта.ШаблонОперации,
														ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода,
														ДанныеОбъекта.ДокументПоследнегоОтражения,
														ДанныеОбъекта.ПериодОтражения,
														ДанныеОбъекта.ИсходныйДокумент,
														ДанныеОбъекта.УчетнаяПолитика);
														
		Если ДокументОтражения=Неопределено Тогда
			
			Возврат;
			
		Иначе
			
			ДанныеОбъекта.ДокументПоследнегоОтражения=ДокументОтражения;
			ДанныеОбъекта.ОбработкаВыполнена=Перечисления.ДаНет.да;
			
		КонецЕсли;
		
	КонецЕсли;
																																				
КонецПроцедуры // ВыполнитьОтражениеОбъекта() 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДокументСторно(ДанныеОбъекта) 
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ
	|	ДокументОтражения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Трансляция КАК ДокументОтражения
	|ГДЕ
	|	ДокументОтражения.ИсходныйДокумент = &ИсходныйДокумент
	|	И ДокументОтражения.ПериодОтражения = &ПериодОтражения
	|	И ДокументОтражения.Сторнирование";
	
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"Документ.Трансляция",ДанныеОбъекта.ДокументПервогоОтражения.Метаданные().ПолноеИмя());
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ИсходныйДокумент",ДанныеОбъекта.ИсходныйДокумент);
	Запрос.УстановитьПараметр("ПериодОтражения",ДанныеОбъекта.ПериодОтражения);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ДокументСторно=Результат.Ссылка.ПолучитьОбъект();
		
		Если ДокументСторно.ПометкаУдаления Тогда
			
			ДокументСторно.ПометкаУдаления=Ложь;
			
		КонецЕсли;
		
		Возврат ДокументСторно;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
				
КонецФункции // ПолучитьДокументСторно() 

Процедура ЗаполнитьДанныеНовогоСторно(ДокументСторно,ДанныеОбъекта)
	
	ДокументСторно.ПериодОтражения=ДанныеОбъекта.ПериодОтражения;
	ДокументСторно.ДатаОтраженияВУчете=?(ДокументСторно.РасчетДатыОтраженияВУчете=Перечисления.СпособыРасчетаДатыОтраженияВУчете.ДатаНачалаПериода,ДокументСторно.ПериодОтражения.ДатаНачала,КонецДня(ДокументСторно.ПериодОтражения.ДатаОкончания));
	ДокументСторно.Сторнирование=Истина;  
	
	Если ЗначениеЗаполнено(ДокументСторно.ИсходныйДокумент) Тогда
		
		ДокументСторно.Дата=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСторно.ИсходныйДокумент,"Дата");
		
	Иначе
		
		ДокументСторно.Дата = ДанныеОбъекта.ДатаЗаписиПослеЗакрытияПериода;
		
	КонецЕсли;
	
    ДокументСторно.УстановитьНовыйНомер();
	
	Для Каждого Строка ИЗ ДокументСторно.СводныеПроводки Цикл
		
		Строка.Значение			= Строка.Значение*(-1);
		
	КонецЦикла;
		
	Для Каждого Строка ИЗ ДокументСторно.Проводки Цикл
		
		Строка.Значение			= Строка.Значение*(-1); 
		Строка.ПредставлениеЗначения= Строка.ПредставлениеЗначения*(-1);
		Строка.ЗначениеВалютаДт	= Строка.ЗначениеВалютаДт*(-1);
		Строка.ЗначениеВалютаКт	= Строка.ЗначениеВалютаКт*(-1);
		Строка.КоличествоДт		= Строка.КоличествоДт*(-1);
		Строка.КоличествоКт		= Строка.КоличествоКт*(-1);
		
	КонецЦикла;
	
	Если ТипЗнч(ДокументСторно)=Тип("ДокументОбъект.Трансляция") Тогда
		
		Для Каждого Строка ИЗ ДокументСторно.РедактируемыеЗаписи Цикл
			
			Строка.Значение			= Строка.Значение*(-1);
			Строка.ЗначениеВалюта	= Строка.ЗначениеВалюта*(-1);
			Строка.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
		Для Каждого Строка ИЗ ДокументСторно.ПоказателиОтчетов Цикл
			
			Строка.Значение			= Строка.Значение*(-1);
			Строка.ЗначениеВалюта	= Строка.ЗначениеВалюта*(-1);
			Строка.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Строка ИЗ ДокументСторно.ДополнительныеКорректировки Цикл
			
			Строка.Значение			= Строка.Значение*(-1);
			Строка.ЗначениеВалюта	= Строка.ЗначениеВалюта*(-1);
			Строка.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьДанныеНовогоСторно()

Процедура ОбновитьДанныеСуществующегоСторно(ДокументСторно,ДанныеОбъекта)

	СторнируемыйОбъект=ДанныеОбъекта.ДокументПервогоОтражения.ПолучитьОбъект();
	
	ДокументСторно.ДатаОтраженияВУчете=?(СторнируемыйОбъект.РасчетДатыОтраженияВУчете=Перечисления.СпособыРасчетаДатыОтраженияВУчете.ДатаНачалаПериода,ДокументСторно.ПериодОтражения.ДатаНачала,КонецДня(ДокументСторно.ПериодОтражения.ДатаОкончания));
	
	ДокументСторно.СводныеПроводки.Очистить();
	ДокументСторно.Проводки.Очистить();	
		
	Для Каждого Строка ИЗ СторнируемыйОбъект.СводныеПроводки Цикл
		
		НоваяСтрока=ДокументСторно.СводныеПроводки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.Значение = Строка.Значение*(-1);
		
	КонецЦикла;
		
	Для Каждого Строка ИЗ СторнируемыйОбъект.Проводки Цикл 
		
		НоваяСтрока=ДокументСторно.Проводки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
		
		НоваяСтрока.Значение			= Строка.Значение*(-1); 
		НоваяСтрока.ПредставлениеЗначения= Строка.ПредставлениеЗначения*(-1);
		НоваяСтрока.ЗначениеВалютаДт	= Строка.ЗначениеВалютаДт*(-1);
		НоваяСтрока.ЗначениеВалютаКт	= Строка.ЗначениеВалютаКт*(-1);
		НоваяСтрока.КоличествоДт		= Строка.КоличествоДт*(-1);
		НоваяСтрока.КоличествоКт		= Строка.КоличествоКт*(-1);
		
	КонецЦикла;
	
	Если ТипЗнч(ДокументСторно)=Тип("ДокументОбъект.Трансляция") Тогда
		
		ДокументСторно.РедактируемыеЗаписи.Очистить();
		ДокументСторно.ПоказателиОтчетов.Очистить();
		
		Для Каждого Строка ИЗ СторнируемыйОбъект.РедактируемыеЗаписи Цикл
			
			НоваяСтрока=ДокументСторно.РедактируемыеЗаписи.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
			НоваяСтрока.Значение			= Строка.Значение*(-1);
			НоваяСтрока.ЗначениеВалюта		= Строка.ЗначениеВалюта*(-1);
			НоваяСтрока.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
		Для Каждого Строка ИЗ СторнируемыйОбъект.ПоказателиОтчетов Цикл
			
			НоваяСтрока=ДокументСторно.ПоказателиОтчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
			НоваяСтрока.Значение			= Строка.Значение*(-1);
			НоваяСтрока.ЗначениеВалюта		= Строка.ЗначениеВалюта*(-1);
			НоваяСтрока.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
	Иначе
		
		ДокументСторно.ДополнительныеКорректировки.Очистить();
		
		Для Каждого Строка ИЗ СторнируемыйОбъект.ДополнительныеКорректировки Цикл
			
			НоваяСтрока=ДокументСторно.ДополнительныеКорректировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
			НоваяСтрока.Значение			= Строка.Значение*(-1);
			НоваяСтрока.ЗначениеВалюта		= Строка.ЗначениеВалюта*(-1);
			НоваяСтрока.ЭкземплярОтчета 	= Неопределено;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьДанныеНовогоСторно()

Процедура ВыполнитьСторнированиеОбъекта(ДанныеОбъекта) 
	
	ДокументСторно=ПолучитьДокументСторно(ДанныеОбъекта);
	
	Если ДокументСторно=Неопределено Тогда
	
		Попытка
			
			ДокументСторно=ДанныеОбъекта.ДокументПервогоОтражения.Скопировать(); 
			ЗаполнитьДанныеНовогоСторно(ДокументСторно,ДанныеОбъекта);
			
		Исключение
			
			Возврат;
			
		КонецПопытки; 
		
	Иначе
		
		ОбновитьДанныеСуществующегоСторно(ДокументСторно,ДанныеОбъекта);
		
	КонецЕсли;
	
	ОбработкаОбъект=Обработки.КорректировкиЗначенийПоказателей.Создать();
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект,ДокументСторно,,"Ссылка");
	
	ОбработкаОбъект.ДокументОбъект=ДокументСторно;
	ОбработкаОбъект.ИмяОбъектаМетаданных=?(ТипЗнч(ОбработкаОбъект.ДокументОбъект)=Тип("ДокументОбъект.Трансляция"),"Трансляция","ТрансформационнаяКорректировка");
	
	ОбработкаОбъект.ИнициализироватьКонтекст();	
	
	Попытка
		
		ОбработкаОбъект.ЗаписатьРабочийОбъект(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		ДанныеОбъекта.ДокументСторноПервогоОтражения=ОбработкаОбъект.Ссылка;
		
	Исключение
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Не удалось записать документ %1: %2'"), 
			ОбработкаОбъект.ДокументОбъект, ОписаниеОшибки()),,,СтатусСообщения.Важное);
		Возврат;
		
	КонецПопытки;
		
КонецПроцедуры // ВыполнитьСторнированиеОбъекта()

Процедура ОчиститьДокументОтражения(ДокументОтражения)
	
	Если НЕ ЗначениеЗаполнено(ДокументОтражения) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДокументОбъект=ДокументОтражения.ПолучитьОбъект();
	
	Если ДокументОбъект=Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДокументОбъект.СводныеПроводки.Очистить();
	ДокументОбъект.Проводки.Очистить();

	Если ТипЗнч(ДокументОбъект)=Тип("ДокументОбъект.Трансляция") Тогда	
		
		ДокументОбъект.РедактируемыеЗаписи.Очистить();
		ДокументОбъект.ПоказателиОтчетов.Очистить();
		
	Иначе
		
		ДокументОбъект.ДополнительныеКорректировки.Очистить();
		
	КонецЕсли;
			
	ОбработкаОбъект=Обработки.КорректировкиЗначенийПоказателей.Создать();
	ЗаполнитьЗначенияСвойств(ОбработкаОбъект,ДокументОбъект);
	
	ОбработкаОбъект.ДокументОбъект=ДокументОбъект;
	ОбработкаОбъект.ИмяОбъектаМетаданных=?(ТипЗнч(ОбработкаОбъект.ДокументОбъект)=Тип("ДокументОбъект.Трансляция"),"Трансляция","ТрансформационнаяКорректировка");
	
	ОбработкаОбъект.ИнициализироватьКонтекст();	
	
	Попытка
		
		ОбработкаОбъект.ЗаписатьРабочийОбъект(РежимЗаписиДокумента.ОтменаПроведения,РежимПроведенияДокумента.Неоперативный);
		
	Исключение
		
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Не удалось записать документ %1: %2'"), 
			ОбработкаОбъект.ДокументОбъект, ОписаниеОшибки()),,,СтатусСообщения.Важное);
		Возврат;
		
	КонецПопытки;
		
КонецПроцедуры // ОчиститьДокументОтражения()     

#КонецОбласти

#КонецЕсли
