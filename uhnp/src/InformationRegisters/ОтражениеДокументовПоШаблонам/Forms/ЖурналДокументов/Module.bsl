
&НаКлиенте
Процедура ОтражениеДокумента(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ФормаОтражениеДокумента",Новый Структура("ИсходныйДокумент",ТекущаяСтрока.ИсходныйДокумент),,Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", НачалоПериода, КонецПериода);
	
	ПустаяДата = Дата(1, 1, 1);
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Диалог.Период.ДатаНачала	 = НачалоПериода;
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Диалог.Период.ДатаОкончания	 = КонецПериода;
	Иначе
		Диалог.Период.ДатаНачала	 = ПустаяДата;
	КонецЕсли;
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьНадписьПериод()
	
	ТекстПериод=НСтр("ru = 'Период'");
	
	Если НЕ (ЗначениеЗаполнено(НачалоПериода)
		ИЛИ ЗначениеЗаполнено(КонецПериода)) Тогда
		
		ТекстПериод=ТекстПериод+" "+НСтр("ru = 'без ограничений'");
			
	КонецЕсли;
			
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		
		ТекстПериод=ТекстПериод+" "+НСтр("ru = 'с'")+" "+Формат(НачалоПериода,"ДЛФ=DD");
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		
		ТекстПериод=ТекстПериод+" "+НСтр("ru = 'по'")+" "+Формат(КонецПериода,"ДЛФ=DD");
		
	КонецЕсли;
	
	Элементы.СписокУстановитьПериод.Заголовок=ТекстПериод;
	
КонецПроцедуры // ОбновитьНадписьПериод() 

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачалоПериода=РезультатВыбора.ДатаНачала;
	КонецПериода=РезультатВыбора.ДатаОкончания;
	
	УстановитьОтборПоПериоду();
	ОбновитьНадписьПериод();
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьОтборПоПериоду()
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Список, "НачалоПериода", НачалоПериода, ЗначениеЗаполнено(НачалоПериода)); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Список, "КонецПериода", КонецПериода, ЗначениеЗаполнено(КонецПериода)); 
		
КонецПроцедуры

&НаКлиенте
Процедура ОтборТипыДокументовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка=Ложь;
	
	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ВыборТиповДокументов",
			Новый Структура("ОтборТипыДокументов",ОтборТипыДокументов),,,,,
			Новый ОписаниеОповещения("ОтборПоТипамДокументовЗавершение", 
			ЭтотОбъект));
			
КонецПроцедуры

