	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ФормаНастройкиОбработки",ПараметрыФормы, , , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтражениеПоШаблонам(Команда)
	
	ПараметрыФормы=Новый Структура("ТипДействия","Отключить");
	ОписаниеОЗакрытии = Новый ОписаниеОповещения("ИзменитьОтражение_Завершение", ЭтотОбъект,ПараметрыФормы);
	ОткрытьФорму("РегистрСведений.ОтражениеДокументовПоШаблонам.Форма.ФормаНастройкиОбработки",ПараметрыФормы, , , , , ОписаниеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры 

&НаКлиенте
Процедура ИзменитьОтражение_Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ВключитьОтражение=(ДополнительныеПараметры.ТипДействия="Включить");
	
	Если ВыбранноеЗначение.СпособОбработки="Все" Тогда
		
		ИзменитьОтражениеПоШаблонамВсе(ВключитьОтражение);
		
	Иначе
		
		ИзменитьОтражениеПоШаблонамВыделенные(ВключитьОтражение);
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтражениеПоШаблонамВыделенные(ВключитьОтражение)
		
	ИзменитьОтражениеПоШаблонамНаСервере(ПолучитьМассивВыделенныхДокументов(),ВключитьОтражение);
	
КонецПроцедуры 

&НаСервере
Процедура ИзменитьОтражениеПоШаблонамВсе(ВключитьОтражение)
		
	ИзменитьОтражениеПоШаблонамНаСервере(ПолучитьМассивДокументовИзСписка(),ВключитьОтражение);
	
КонецПроцедуры  

&НаСервере
Процедура ИзменитьОтражениеПоШаблонамНаСервере(МассивДокументов,ВключитьОтражение) 
	
	КорректировкиЗначенийПоказателей32.ИзменитьОтражениеПоШаблонам(МассивДокументов,ВключитьОтражение);	
	
КонецПроцедуры // ИзменитьОтражениеПоШаблонамНаСервере() 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ИзмененоОтражениеДокументаПоШаблонам" Тогда
		
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусОбработкаВыполнена=НСтр("ru = 'Отражение выполнено'");
	СтатусОжидаетОтраженияАвто=НСтр("ru = 'Ожидается (автоматически)'");
	СтатусОжидаетОтраженияВручную=НСтр("ru = 'Ожидается (вручную)'");
	СтатусОтражениеОтключено=НСтр("ru = 'Отражение отключено'");
	СтатусПовторнаяТрансляция=НСтр("ru = 'Требуется повторная трансляция'");
	
	ЭтаФорма.Список.ТекстЗапроса=УстановитьТекстДинамическогоСписка();
	
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(9,НСтр("ru = 'Отбор не установлен'"));
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(0,СтатусОжидаетОтраженияВручную);
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(1,СтатусОжидаетОтраженияАвто);
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(3,СтатусОтражениеОтключено);
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(2,СтатусОбработкаВыполнена);
	Элементы.ОтборФлагОбработки.СписокВыбора.Добавить(4,СтатусПовторнаяТрансляция);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОбработкаВыполнена",СтатусОбработкаВыполнена);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОжидаетОтраженияАвто",СтатусОжидаетОтраженияАвто);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОжидаетОтраженияВручную",СтатусОжидаетОтраженияВручную);
   	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОтражениеОтключено",СтатусОтражениеОтключено);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ПовторнаяТрансляция",СтатусПовторнаяТрансляция);
	
	ФлагОбработки=9;
	
	Заголовок=НСтр("ru = 'Журнал отражения документов по шаблонам'");
	
	Параметры.Свойство("НачалоПериода",	НачалоПериода);
	Параметры.Свойство("КонецПериода",	КонецПериода);
	Параметры.Свойство("ФлагОбработки",	ФлагОбработки);
	Параметры.Свойство("Организация",	Организация);
	Параметры.Свойство("ПланСчетов",	ПланСчетов);
	
	ИспользоватьНесколькоПлановСчетов=Константы.ИспользоватьУчетныеПолитикиМСФО.Получить();
	Элементы.ПланСчетов.Видимость=ИспользоватьНесколькоПлановСчетов;
	Элементы.ОтборПланСчетов.Видимость=ИспользоватьНесколькоПлановСчетов;
	
	
	УстановитьОтборыСписка();
	
КонецПроцедуры  

&НаСервере
Функция УстановитьТекстДинамическогоСписка()
	
	ТекстОтбораПоДате=ПолучитьТекстОтбораПоДате();
	ТекстЗапроса="ВЫБРАТЬ Различные ДокументыДляПовторнойТрансляции.ИсходныйДокумент
	|ПОМЕСТИТЬ ДокументыПовторнойТрансляции ИЗ РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции 
	|Индексировать ПО ДокументыДляПовторнойТрансляции.ИсходныйДокумент
	|;
	|ВЫБРАТЬ
	|	ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК ИсходныйДокумент,
	|	"+ТекстОтбораПоДате+" КАК Дата,
	|	ТИПЗНАЧЕНИЯ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент) КАК ТипДокумента,
	|	ОтражениеДокументовПоШаблонам.Организация КАК Организация,
	|	ОтражениеДокументовПоШаблонам.ПериодОтражения КАК ПериодОтражения,
	|	ОтражениеДокументовПоШаблонам.ШаблонОперации КАК ШаблонОперации,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО,ЛОЖЬ)= ЛОЖЬ
	|			ТОГДА ВЫБОР КОГДА НЕ ЕСТЬNULL(ДокументыДляПовторнойТрансляции.ДокументТрансляции,ЛОЖЬ)=Ложь ТОГДА &ПовторнаяТрансляция
	|					КОГДА ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|						ТОГДА &ОбработкаВыполнена
	|					КОГДА ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием
	|						ТОГДА &ОжидаетОтраженияАвто
	|					ИНАЧЕ &ОжидаетОтраженияВручную
	|				КОНЕЦ
	|		ИНАЧЕ &ОтражениеОтключено
	|	КОНЕЦ КАК СтатусОбработки,
	|	ОтражениеДокументовПоШаблонам.УчетнаяПолитика.ПланСчетовУчета КАК ПланСчетов
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовПоШаблонам КАК ОтражениеДокументовПоШаблонам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыНеОтражаемыеПоШаблонам КАК ДокументыНеОтражаемыеПоШаблонам
	|		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыНеОтражаемыеПоШаблонам.Документ 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыДляПовторнойТрансляции КАК ДокументыДляПовторнойТрансляции
	|		ПО ОтражениеДокументовПоШаблонам.ИсходныйДокумент = ДокументыДляПовторнойТрансляции.ИсходныйДокумент
	|ГДЕ
	|	НЕ ОтражениеДокументовПоШаблонам.ОтраженоВСледующемПериоде
	|{ГДЕ
	|	("+ТекстОтбораПоДате+" >= &НачалоПериода),
	|	("+ТекстОтбораПоДате+" <= &КонецПериода),
	|	ОтражениеДокументовПоШаблонам.Организация.*,
	|	ОтражениеДокументовПоШаблонам.ОбработкаВыполнена,
	|	ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием,
	|	(ВЫБОР
	|			КОГДА ЕСТЬNULL(ДокументыНеОтражаемыеПоШаблонам.НеОтражатьМСФО,ЛОЖЬ)= ЛОЖЬ
	|				ТОГДА ВЫБОР КОГДА НЕ ЕСТЬNULL(ДокументыДляПовторнойТрансляции.ДокументТрансляции,ЛОЖЬ)=Ложь ТОГДА 4
	|						КОГДА ОтражениеДокументовПоШаблонам.ОбработкаВыполнена = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|							ТОГДА 2
	|						КОГДА ОтражениеДокументовПоШаблонам.ОтражениеФоновымЗаданием
	|							ТОГДА 1
	|						ИНАЧЕ 0
	|					КОНЕЦ
	|			ИНАЧЕ 3
	|		КОНЕЦ) КАК ФлагОбработки,
	|	ОтражениеДокументовПоШаблонам.УчетнаяПолитика.ПланСчетовУчета КАК ПланСчетов,
	|	(ТИПЗНАЧЕНИЯ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент)) КАК ТипДокумента}";
	
	Возврат ТекстЗапроса;
	
КонецФункции // УстановитьТекстДинамическогоСписка() 

&НаСервере
Функция ПолучитьТекстОтбораПоДате()
	
	МассивТиповДокументов=ПолучитьТипыИсходныхДокументов(); 
	
	ТекстОтбора="(ВЫБОР";
	
	Для Каждого СтрокаТип ИЗ МассивТиповДокументов Цикл
		
		ТекстОтбора=ТекстОтбора+"
		|КОГДА ОтражениеДокументовПоШаблонам.ИсходныйДокумент ССЫЛКА СтрокаТип
		|ТОГДА ВЫРАЗИТЬ(ОтражениеДокументовПоШаблонам.ИсходныйДокумент КАК СтрокаТип).Дата"; // @query-part
		
		ТекстОтбора = СтрЗаменить(ТекстОтбора, "СтрокаТип", СтрокаТип);
		
	КонецЦикла;
	
	Возврат ТекстОтбора+"
	|КОНЕЦ)";	
	
КонецФункции // ПолучитьТекстОтбораПоДате() 

&НаСервереБезКонтекста
Функция ПолучитьТипыИсходныхДокументов() 
	
	Возврат РегистрыСведений.ОтражениеДокументовПоШаблонам.ПолучитьТипыИсходныхДокументов();
			
КонецФункции // ПолучитьТипыИсходныхДокументов()

&НаСервере 
Процедура УстановитьОтборыСписка()

	Если ЗначениеЗаполнено(НачалоПериода) ИЛИ ЗначениеЗаполнено(КонецПериода) Тогда
		
		УстановитьОтборПоПериоду();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		УстановитьОтборПоОрганизации();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПланСчетов) Тогда
		
		УстановитьОтборПоПлануСчетов();
		
	КонецЕсли;
	
	Если ФлагОбработки<9 Тогда
		
		УстановитьОтборПоСтатусу();
		
	КонецЕсли;	
			
КонецПроцедуры // УстановитьОтборыСписка()

&НаСервере 
Процедура УстановитьОтборПоСтатусу()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ФлагОбработки", ФлагОбработки, , , НЕ ФлагОбработки=9);
	
КонецПроцедуры // УстановитьОтборПоСтатусу()

&НаСервере
Процедура УстановитьОтборПоПлануСчетов()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПланСчетов", ПланСчетов, , , ЗначениеЗаполнено(ПланСчетов));
	
КонецПроцедуры // УстановитьОтборПоПлануСчетов() 

&НаКлиенте
Процедура ОтборФлагОбработкиПриИзменении(Элемент)

	УстановитьОтборПоСтатусу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	УстановитьОтборПоОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПланСчетовПриИзменении(Элемент)
	
	УстановитьОтборПоПлануСчетов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПланСчетовОчистка(Элемент, СтандартнаяОбработка)
	
	УстановитьОтборПоПлануСчетов();
	
КонецПроцедуры


