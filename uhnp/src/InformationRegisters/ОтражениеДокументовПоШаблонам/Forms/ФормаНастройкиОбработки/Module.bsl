

&НаКлиенте
Процедура ОбработатьВсе(Команда)
	
	Если ВключаяОбработанные Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВсе_Завершение", ЭтотОбъект);
		ТекстВопроса=НСтр("ru = 'Отражение по шаблонам всех документов, включая уже обработанные, может занять продолжительное время.
		|Продолжить?'");
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет,30,КодВозвратаДиалога.Нет);
		
	Иначе
		
		Закрыть(Новый Структура("СпособОбработки,ВключаяОбработанные","Все",Ложь));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВсе_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат=КодВозвратаДиалога.Да Тогда
		
		Закрыть(Новый Структура("СпособОбработки,ВключаяОбработанные","Все",Истина));
		
	КонецЕсли;
		
КонецПроцедуры // ОбработатьВсе_Завершение() 
 

&НаКлиенте
Процедура ОбработатьВыделенные(Команда)
	
	Закрыть(Новый Структура("СпособОбработки,ВключаяОбработанные","Выделенные",ВключаяОбработанные));
	
КонецПроцедуры


&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ТипДействия="Включить" Тогда
		
		Элементы.ВключаяОбработанные.Видимость=Ложь;
		Заголовок=НСтр("ru = 'Включение отражения документов по шаблонам'");
		
	ИначеЕсли Параметры.ТипДействия="Отключить" Тогда
		
		Элементы.ВключаяОбработанные.Видимость=Ложь;
		Заголовок=НСтр("ru = 'Отключение отражения документов по шаблонам'");
		Элементы.ДекорацияОтключение.Видимость=Истина;
		
	Иначе		
		
		Элементы.ВключаяОбработанные.Видимость=Истина;
		Заголовок=НСтр("ru = 'Отражение документов по шаблонам'");
		
	КонецЕсли;
	
КонецПроцедуры

