// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
//Процедура ДобавитьЛогСообщенияИсходящего(ВидИнтеграции, Ключ, XML_Пакет = Неопределено, ВидСообщения = "", ВидСобытия = "", ОписаниеОшибки = "") Экспорт
Процедура ДобавитьЛогСообщенияИсходящего(ВидИнтеграции, Ключ, XML_Пакет = Неопределено, ВидСообщения = "", ВидСобытия = "", ОписаниеОшибки = "", БазаРеспондентИД = "") Экспорт
// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	
	ТекущийКлючЗаписи = ?(ТипЗнч(Ключ) = Тип("УникальныйИдентификатор"), Ключ, Новый УникальныйИдентификатор(Ключ));
	
	НаборЗаписей = РегистрыСведений.тн_Интеграция_ЛогСообщений.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.ВидИнтеграции.Установить(ВидИнтеграции);
	НаборЗаписей.Отбор.Ключ.Установить(ТекущийКлючЗаписи);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда 
		Запись = НаборЗаписей[0];
	Иначе 
		Запись = НаборЗаписей.Добавить();
	КонецЕсли;
	
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//Запись.Период                              = ТекущаяДата();
	Запись.Период                              = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	Запись.Ключ                                = ТекущийКлючЗаписи;
	Запись.ВидИнтеграции                       = ВидИнтеграции;
	
	Если НЕ (XML_Пакет = Неопределено) Тогда 
		Запись.XML_ПакетИсходящий                  = XML_Пакет;
	КонецЕсли;
	
	Запись.УниверсальнаяДатаИсходящееСообщение = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ЗначениеЗаполнено(ВидСообщения) Тогда 
		Запись.ВидСообщения                        = ВидСообщения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидСобытия) Тогда 
		Запись.ВидСобытия                          = ВидСобытия;
	КонецЕсли;
	
	Запись.ОписаниеОшибки                      = ОписаниеОшибки;
	// НАЧАЛО Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	Запись.БазаРеспондентИД                    = БазаРеспондентИД;
	// КОНЕЦ Борисенко Игорь 08.06.2022 Выполнение задач №000041384
	
	НаборЗаписей.Записать(Истина);
			
КонецПроцедуры

