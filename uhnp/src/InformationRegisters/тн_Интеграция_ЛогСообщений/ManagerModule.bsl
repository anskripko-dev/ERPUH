Процедура ДобавитьЛогСообщения(ВидИнтеграции, КлючСтроковый = "", XML_ПакетВходящий = "", XML_ПакетИсходящий = "", УниверсальнаяДатаВходящееСообщение = 0, УниверсальнаяДатаИсходящееСообщение = 0, ВидСообщения = "", ВидСобытия = "", ОписаниеОшибки = "", БазаРеспондентИД = "") Экспорт
