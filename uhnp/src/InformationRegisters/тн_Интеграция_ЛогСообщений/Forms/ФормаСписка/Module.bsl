// Ситалов Дмитрий 22.06.2022 Выполнение задач №000041657
Процедура УстановитьПараметрыСписка()
	
	ДатаОкончания = ?(ЗначениеЗаполнено(ОтборПериод.ДатаОкончания), ОтборПериод.ДатаОкончания, Дата(2999,1,1));
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаНачала", ОтборПериод.ДатаНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаОкончания", ДатаОкончания);
	
КонецПроцедуры

#КонецОбласти
