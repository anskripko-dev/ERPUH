
&НаКлиенте
Процедура ПланСчетовБДПриИзменении(Элемент)
	
	ПланСчетовБДПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПланСчетовБДПриИзмененииНаСервере()
	
	ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, "ПланСчетовБД", ПланСчетовБД, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоШаблонуТрансляции(Команда)
	
	ОткрытьФорму("Справочник.ШаблоныТрансляций.ФормаВыбора",Новый Структура("Отбор",Новый Структура("ПланСчетовИсточник",ПланСчетовБД)),ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение)=Тип("СправочникСсылка.ШаблоныТрансляций") Тогда
		
		ОбновитьЗаписиПоСпискуТрансляций(ПланСчетовБД,ВыбранноеЗначение);
		Если Элементы.Список.Видимость Тогда
			Элементы.Список.Обновить();
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьЗаписиПоСпискуТрансляций(ПланСчетовБД,ШаблонТрансляции)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсточникиДанныхДляРасчетов.Счет,
	|	ИсточникиДанныхДляРасчетов.КоррСчет
	|ПОМЕСТИТЬ КорреспонденцииМэппинга
	|ИЗ
	|	Справочник.ИсточникиДанныхДляРасчетов КАК ИсточникиДанныхДляРасчетов
	|ГДЕ
	|	ИсточникиДанныхДляРасчетов.НазначениеРасчетов.Владелец = &ШаблонТрансляции
	|	И ИсточникиДанныхДляРасчетов.НазначениеРасчетов.НаправлениеТрансляции = ЗНАЧЕНИЕ(Перечисление.НаправленияТрансляцииДанных.РегистрБухгалтерииВРегистрБухгалтерии)
	|	И НЕ ИсточникиДанныхДляРасчетов.ПометкаУдаления
	|	И НЕ(ИсточникиДанныхДляРасчетов.Счет = ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка)
	|				ИЛИ ИсточникиДанныхДляРасчетов.КоррСчет = ЗНАЧЕНИЕ(Справочник.СчетаБД.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСопоставления.Счет,
	|	ТабСопоставления.КоррСчет
	|ИЗ
	|	(ВЫБРАТЬ
	|		КорреспонденцииМэппинга.Счет КАК Счет,
	|		КорреспонденцииМэппинга.КоррСчет КАК КоррСчет,
	|		ЕСТЬNULL(КорреспонденцииВидовДвиженийМСФО.ВидДвижения, НЕОПРЕДЕЛЕНО) КАК ВидДвижения
	|	ИЗ
	|		КорреспонденцииМэппинга КАК КорреспонденцииМэппинга
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорреспонденцииВидовДвиженийМСФО КАК КорреспонденцииВидовДвиженийМСФО
	|			ПО КорреспонденцииМэппинга.Счет = КорреспонденцииВидовДвиженийМСФО.СчетДт
	|				И КорреспонденцииМэппинга.КоррСчет = КорреспонденцииВидовДвиженийМСФО.СчетКт
	|				И (КорреспонденцииВидовДвиженийМСФО.ПланСчетовБД = &ПланСчетовБД)) КАК ТабСопоставления
	|ГДЕ
	|	ТабСопоставления.ВидДвижения = НЕОПРЕДЕЛЕНО";
	
    Запрос.УстановитьПараметр("ПланСчетовБД",ПланСчетовБД);
	Запрос.УстановитьПараметр("ШаблонТрансляции",ШаблонТрансляции);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НаборЗаписей=РегистрыСведений.КорреспонденцииВидовДвиженийМСФО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПланСчетовБД.Установить(ПланСчетовБД);
		НаборЗаписей.Отбор.СчетДт.Установить(Результат.Счет);
		НаборЗаписей.Отбор.СчетКт.Установить(Результат.КоррСчет);
		
		НоваяСтрока=НаборЗаписей.Добавить();
		НоваяСтрока.ПланСчетовБД=ПланСчетовБД;
		НоваяСтрока.СчетДт=Результат.Счет;
		НоваяСтрока.СчетКт=Результат.КоррСчет;
		
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры
