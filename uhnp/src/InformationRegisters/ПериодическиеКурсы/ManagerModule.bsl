
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбновитьПериодическиеКурсы(ПериодКурса, Сценарий, ПериодОкончания, Отказ = Ложь) Экспорт

	ТаблицаКурсов = ОбщегоНазначенияСерверУХ.ЗаполнитьПериодическиеКурсыВалют(ПериодКурса, Сценарий, ПериодОкончания);
	
	НачатьТранзакцию();
	
	Для каждого Элемент Из ТаблицаКурсов Цикл
	
		НаборЗаписей = РегистрыСведений.ПериодическиеКурсы.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Сценарий		.Установить(Сценарий);
		НаборЗаписей.Отбор.Валюта		.Установить(Элемент.Валюта);
		НаборЗаписей.Отбор.ПериодКурса	.Установить(ПериодКурса);
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент); 
		
		НоваяСтрока.ПериодКурса	= ПериодКурса;
		НоваяСтрока.Сценарий	= Сценарий;
		
		Попытка			
			НаборЗаписей.Записать(Истина);			
		Исключение			
			ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрШаблон(Нстр("ru = 'Не удалось сохранить курсы валют: %1'"), 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), Отказ);			
		КонецПопытки;
		
	КонецЦикла;
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
	Иначе	
		ЗафиксироватьТранзакцию();
	КонецЕсли;

КонецПроцедуры
	
