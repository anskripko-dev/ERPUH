
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура("Сценарий", Константы.СценарийМСФО.Получить());
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если НЕ ДанныеЗаполнения.Свойство("Сценарий") Тогда
			ДанныеЗаполнения.Вставить("Сценарий", Константы.СценарийМСФО.Получить());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	ТзТекущегоНабора = ЭтотОбъект.Выгрузить();
	
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		
		ПредыдущийПериод = ОбщегоНазначенияУХ.глОтносительныйПериод(ТекЗапись.ПериодКурса,-1);
		
		тСтрокиПредыдущегоПериода = ТзТекущегоНабора.НайтиСтроки(Новый Структура("Валюта,Сценарий,ПериодКурса"
		,ТекЗапись.Валюта,ТекЗапись.Сценарий,ПредыдущийПериод));
		
		Если тСтрокиПредыдущегоПериода.Количество() > 0 Тогда
			
			ТекЗапись.СреднийКурсЗаПредыдущийПериод  		= тСтрокиПредыдущегоПериода[0].СреднийКурсЗаПериод;
			ТекЗапись.СреднийКурсЗаПредыдущийПериодЦБ  		= тСтрокиПредыдущегоПериода[0].СреднийКурсЗаПериодЦБ;
			ТекЗапись.КурсНаКонецПредыдущегоПериода  		= тСтрокиПредыдущегоПериода[0].КурсНаКонецПериода;

		Иначе	 
			
			ЗаписьПредыдущегоПериода = ПолучитьЗаписьПредыдущегоПериода(ТекЗапись);
			
			Если НЕ ЗаписьПредыдущегоПериода = Неопределено Тогда
				
				ТекЗапись.СреднийКурсЗаПредыдущийПериод  		= ЗаписьПредыдущегоПериода.СреднийКурсЗаПериод;
				ТекЗапись.СреднийКурсЗаПредыдущийПериодЦБ  		= ЗаписьПредыдущегоПериода.СреднийКурсЗаПериодЦБ;
				ТекЗапись.КурсНаКонецПредыдущегоПериода  		= ЗаписьПредыдущегоПериода.КурсНаКонецПериода;
				
			КонецЕсли;	 
			
		КонецЕсли;
		
	КонецЦикла;	 
		 
	
	
КонецПроцедуры


Функция ПолучитьЗаписьПредыдущегоПериода(текЗапись)
	
	ПредыдущийПериод = ОбщегоНазначенияУХ.глОтносительныйПериод(ТекЗапись.ПериодКурса,-1);
	 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПериодическиеКурсы.СреднийКурсЗаПериод КАК СреднийКурсЗаПериод,
	               |	ПериодическиеКурсы.СреднийКурсЗаПериодЦБ КАК СреднийКурсЗаПериодЦБ,
	               |	ПериодическиеКурсы.КурсНаКонецПериода КАК КурсНаКонецПериода
	               |ИЗ
	               |	РегистрСведений.ПериодическиеКурсы КАК ПериодическиеКурсы
	               |ГДЕ
	               |	ПериодическиеКурсы.Валюта = &Валюта
	               |	И ПериодическиеКурсы.Сценарий = &Сценарий
	               |	И ПериодическиеКурсы.ПериодКурса = &ПериодКурса";
	
	Запрос.УстановитьПараметр("Валюта",текЗапись.Валюта);
	Запрос.УстановитьПараметр("Сценарий",текЗапись.Сценарий);
	Запрос.УстановитьПараметр("ПериодКурса",ПредыдущийПериод);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		 Возврат Выборка;
	
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции	
