Процедура ОтразитьСведенияОПодписяхВПриказах(ДополнительныеСвойства, Движения, Отказ) Экспорт
		
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.Таблицатн_СведенияОПодписяхВПриказах;
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияСведенияОВозвратах = Движения.тн_СведенияОПодписяхВПриказах;
	ДвиженияСведенияОВозвратах.Записывать = Истина;
	ДвиженияСведенияОВозвратах.Загрузить(ТаблицаДвижений);
	
КонецПроцедуры

//Качикина 24.01.2026 Выполнение задач №000056363 
Функция НастройкиСведенийОПодписяхВПриказах(Дата, ПараметрыОтбора) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса =   
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Период КАК Период,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Организация КАК Организация,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Пользователь КАК Пользователь,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.СтрокаНомер КАК СтрокаНомер,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ВидПодписи КАК ВидПодписи,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Подразделение КАК Подразделение,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Приказ КАК Приказ,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ФИОвПодписи КАК ФИОвПодписи,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Должность КАК Должность,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ПриказНаЭкспорт КАК ПриказНаЭкспорт,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ФИОВПодписиНаЭкспорт КАК ФИОвПодписиНаЭкспорт,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.ДолжностьНаЭкспорт КАК ДолжностьНаЭкспорт,
	|	тн_СведенияОПодписяхВПриказахСрезПоследних.Статус КАК Статус
	|ПОМЕСТИТЬ втСведенияОПодписях
	|ИЗ
	|	РегистрСведений.тн_СведенияОПодписяхВПриказах.СрезПоследних(
	|			&Период,
	|			Статус = &Статус
	|				И &ОтборОрганизация_
	|				И &ОтборПользователь_
	|				И &ОтборПодразделениеОрганизации_
	|				И &Отбор_ВидПодписи_
	|				И &ОтборПодразделение_) КАК тн_СведенияОПодписяхВПриказахСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСведенияОПодписях.Организация КАК Организация,
	|	втСведенияОПодписях.Подразделение КАК Подразделение,
	|	втСведенияОПодписях.ВидПодписи КАК ВидПодписи,
	|	МАКСИМУМ(втСведенияОПодписях.Период) КАК Период
	|ПОМЕСТИТЬ втАктуальныеСведения
	|ИЗ
	|	втСведенияОПодписях КАК втСведенияОПодписях
	|
	|СГРУППИРОВАТЬ ПО
	|	втСведенияОПодписях.Организация,
	|	втСведенияОПодписях.Подразделение,
	|	втСведенияОПодписях.ВидПодписи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСведенияОПодписях.Организация КАК Организация,
	|	втСведенияОПодписях.Пользователь КАК Пользователь,
	|	втСведенияОПодписях.ПодразделениеОрганизации КАК ПодразделениеОрганизации,
	|	втСведенияОПодписях.СтрокаНомер КАК СтрокаНомер,
	|	втСведенияОПодписях.ВидПодписи КАК ВидПодписи,
	|	втСведенияОПодписях.Подразделение КАК Подразделение,
	|	втСведенияОПодписях.Приказ КАК Приказ,
	|	втСведенияОПодписях.ФИОвПодписи КАК ФИОвПодписи,
	|	втСведенияОПодписях.Должность КАК Должность,
	|	втСведенияОПодписях.ПриказНаЭкспорт КАК ПриказНаЭкспорт,
	|	втСведенияОПодписях.ФИОвПодписиНаЭкспорт КАК ФИОвПодписиНаЭкспорт,
	|	втСведенияОПодписях.ДолжностьНаЭкспорт КАК ДолжностьНаЭкспорт,
	|	втСведенияОПодписях.Статус КАК Статус
	|ИЗ
	|	втСведенияОПодписях КАК втСведенияОПодписях
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втАктуальныеСведения КАК втАктуальныеСведения
	|		ПО втСведенияОПодписях.Организация = втАктуальныеСведения.Организация
	|			И втСведенияОПодписях.Подразделение = втАктуальныеСведения.Подразделение
	|			И втСведенияОПодписях.ВидПодписи = втАктуальныеСведения.ВидПодписи
	|			И втСведенияОПодписях.Период = втАктуальныеСведения.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втСведенияОПодписях
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втАктуальныеСведения";
	
	Запрос.УстановитьПараметр("Период",	Дата);
	Если ПараметрыОтбора.Свойство("Статус") Тогда
		Запрос.УстановитьПараметр("Статус",ПараметрыОтбора.Статус); 
	Иначе
		//по-умолчанию
		Запрос.УстановитьПараметр("Статус",	Перечисления.СтатусыДоговоровКонтрагентов.Действует);	
	КонецЕсли;
	Запрос.УстановитьПараметр("ОтборОрганизация_",Истина);
	Запрос.УстановитьПараметр("ОтборПользователь_",Истина);
	Запрос.УстановитьПараметр("ОтборПодразделениеОрганизации_",Истина);
	Запрос.УстановитьПараметр("Отбор_ВидПодписи_",Истина);
	Запрос.УстановитьПараметр("ОтборПодразделение_",Истина);
	
	Если ПараметрыОтбора.Свойство("Организация") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборОрганизация_", " Организация В (&ОтборОрганизация_)");
		Запрос.УстановитьПараметр("ОтборОрганизация_",ПараметрыОтбора.Организация); 
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("Пользователь") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПользователь_", " Пользователь В (&ОтборПользователь_)");
		Запрос.УстановитьПараметр("ОтборПользователь_",ПараметрыОтбора.Пользователь);
	КонецЕсли; 
	Если ПараметрыОтбора.Свойство("ПодразделениеОрганизации") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПодразделениеОрганизации_", " ПодразделениеОрганизации В (&ОтборПодразделениеОрганизации_)");
		Запрос.УстановитьПараметр("ОтборПодразделениеОрганизации_",ПараметрыОтбора.ПодразделениеОрганизации);
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("ВидПодписи") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор_ВидПодписи_", " ВидПодписи В (&Отбор_ВидПодписи_)");
		Запрос.УстановитьПараметр("Отбор_ВидПодписи_",ПараметрыОтбора.ВидПодписи);
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("Подразделение") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПодразделение_", " Подразделение В (&ОтборПодразделение_)");
		Запрос.УстановитьПараметр("ОтборПодразделение_",ПараметрыОтбора.Подразделение);
	КонецЕсли;  
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить().Выгрузить();
		
	Возврат Результат;
	
КонецФункции
