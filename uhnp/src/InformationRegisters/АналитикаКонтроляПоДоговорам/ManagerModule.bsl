Функция ИнформацияОКлюче() Экспорт
	
	//
	Результат = Новый Структура;
	Результат.Вставить("СправочникИмя", "КлючиКонтроляПоДоговорам");
	Результат.Вставить("СправочникМенеджер", Справочники.КлючиКонтроляПоДоговорам);
	Результат.Вставить("СправочникМетаданные", Метаданные.Справочники.КлючиКонтроляПоДоговорам);
	Результат.Вставить("РегистрИмя", "АналитикаКонтроляПоДоговорам");
	Результат.Вставить("РегистрМенеджер", РегистрыСведений.АналитикаКонтроляПоДоговорам);
	Результат.Вставить("РегистрМетаданные", Метаданные.РегистрыСведений.АналитикаКонтроляПоДоговорам);
	
	Результат.Вставить("ИмяПоляАналитика", "АналитикаКонтроляПоДоговорам");
	
	КонтрольУХКлючи.ДобавитьИзмеренияКлюча(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи) Экспорт

	Поля = Новый Массив;
	Поля.Добавить(СокрЛП(МенеджерЗаписи.Организация));
	Поля.Добавить(СокрЛП(МенеджерЗаписи.Контрагент));
	Если ЗначениеЗаполнено(МенеджерЗаписи.ВерсияСоглашения) Тогда
		Поля.Добавить(СокрЛП(МенеджерЗаписи.ВерсияСоглашения));
	Иначе
		Поля.Добавить(СокрЛП(МенеджерЗаписи.Договор));
	КонецЕсли;
	Возврат СтрСоединить(Поля, "; ");
	
КонецФункции

