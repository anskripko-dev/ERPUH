#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//~ Урубков И. 04.09.2025 Выполнение задач №000054387 Добавлен обязательный параметр для обработчика с режимом выполнения "Отложенно"
//Процедура ЗаполнитьПервоначальныеСведенияПоКлассификацииЗадолженностиМСФО() Экспорт
Процедура ЗаполнитьПервоначальныеСведенияПоКлассификацииЗадолженностиМСФО(Параметры = Неопределено) Экспорт
	
	СчетМСФО6120 = ПланыСчетов.МСФО.НайтиПоКоду("6120");
	СчетМСФО6121 = ПланыСчетов.МСФО.НайтиПоКоду("6121");
	СчетМСФО6122 = ПланыСчетов.МСФО.НайтиПоКоду("6122");
	СчетМСФО6123 = ПланыСчетов.МСФО.НайтиПоКоду("6123");
	СчетМСФО6132 = ПланыСчетов.МСФО.НайтиПоКоду("6132");
	СчетМСФО6133 = ПланыСчетов.МСФО.НайтиПоКоду("6133");
	
	ВсеСчетаНайдены = ЗначениеЗаполнено(СчетМСФО6120) И ЗначениеЗаполнено(СчетМСФО6121) И ЗначениеЗаполнено(СчетМСФО6122) 
		И ЗначениеЗаполнено(СчетМСФО6123) И ЗначениеЗаполнено(СчетМСФО6132) И ЗначениеЗаполнено(СчетМСФО6133);
		
	Если НЕ ВсеСчетаНайдены Тогда
		ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.РегистрыСведений.тн_КлассификацияЗадолженностиМСФО,,
			"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_КлассификацияЗадолженностиМСФО.ЗаполнитьПервоначальныеСведенияПоКлассификацииЗадолженностиМСФО: " 
			+ "Не найдены счета МСФО со следующими кодами: 6120, 6121, 6122, 6123, 6132, 6133");
		Возврат;
	КонецЕсли;
	
	//поиск по коду невозможен, т.к. есть элементы с одинаковым кодом
	ОсобыеВидыВзаиморасчетов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	тн_ВидыВзаиморасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.тн_ВидыВзаиморасчетов КАК тн_ВидыВзаиморасчетов
		|ГДЕ
		|	тн_ВидыВзаиморасчетов.Код = &КодРетроБонус
		|	И тн_ВидыВзаиморасчетов.Наименование = &НаименованиеРетроБонус
		|	И НЕ тн_ВидыВзаиморасчетов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	тн_ВидыВзаиморасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.тн_ВидыВзаиморасчетов КАК тн_ВидыВзаиморасчетов
		|ГДЕ
		|	тн_ВидыВзаиморасчетов.Код = &КодРасчетыСПоставщикамиОС
		|	И тн_ВидыВзаиморасчетов.Наименование = &НаименованиеРасчетыСПоставшикамиОС
		|	И НЕ тн_ВидыВзаиморасчетов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	тн_ВидыВзаиморасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.тн_ВидыВзаиморасчетов КАК тн_ВидыВзаиморасчетов
		|ГДЕ
		|	тн_ВидыВзаиморасчетов.Код = &КодРасчетыСПоставщикамиНМА
		|	И тн_ВидыВзаиморасчетов.Наименование = &НаименованиеРасчетыСПоставшикамиНМА
		|	И НЕ тн_ВидыВзаиморасчетов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодРасчетыСПоставщикамиНМА", "00035");
	Запрос.УстановитьПараметр("КодРасчетыСПоставщикамиОС", "00007");
	Запрос.УстановитьПараметр("КодРетроБонус", "00001");
	Запрос.УстановитьПараметр("НаименованиеРасчетыСПоставшикамиНМА", "Расчеты с поставщиками НМА");
	Запрос.УстановитьПараметр("НаименованиеРасчетыСПоставшикамиОС", "Расчеты с поставщиками ОС");
	Запрос.УстановитьПараметр("НаименованиеРетроБонус", "Ретро-бонус");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатРетроБонус = РезультатЗапроса[0];
	РезультатОС = РезультатЗапроса[1];
	РезультатНМА = РезультатЗапроса[2];
	
	Если РезультатРетроБонус.Пустой() ИЛИ РезультатОС.Пустой() ИЛИ РезультатНМА.Пустой() Тогда 
		ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.РегистрыСведений.тн_КлассификацияЗадолженностиМСФО,,
			"Ошибка при выполнении обработчика обновления тн_ОбновлениеИнформационнойБазы_ТН_Общий.ЗаполнитьСведенияПоКлассификацииЗадолженностиМСФО: " 
			+ "Найдены не все виды взаиморасчетов из следующих: Ретро-бонус, Расчеты с поставщиками ОС, Расчеты с поставщиками НМА");
		Возврат;
	КонецЕсли;
	
	ВыборкаРетроБонус = РезультатРетроБонус.Выбрать();
	ВыборкаРетроБонус.Следующий();
	ВидВзаиморасчетовРетроБонус = ВыборкаРетроБонус.Ссылка;
	ВыборкаОС = РезультатОС.Выбрать();
	ВыборкаОС.Следующий();
	ВидВзаиморасчетовРасчетыСПоставщикамиОС = ВыборкаОС.Ссылка;
	ВыборкаНМА = РезультатНМА.Выбрать();
	ВыборкаНМА.Следующий();
	ВидВзаиморасчетовРасчетыСПоставщикамиНМА = ВыборкаНМА.Ссылка; 
	
	ОсобыеВидыВзаиморасчетов.Добавить(ВидВзаиморасчетовРетроБонус);
	ОсобыеВидыВзаиморасчетов.Добавить(ВидВзаиморасчетовРасчетыСПоставщикамиОС);
	ОсобыеВидыВзаиморасчетов.Добавить(ВидВзаиморасчетовРасчетыСПоставщикамиНМА);
	
	НаборЗаписей = РегистрыСведений.тн_КлассификацияЗадолженностиМСФО.СоздатьНаборЗаписей();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыКонтрагентов.Ссылка КАК Ссылка,
		|	ГруппыКонтрагентов.ВидОтношенияКГруппе КАК ВидОтношенияКГруппе
		|ПОМЕСТИТЬ ВТ_ГруппыКонтрагентов
		|ИЗ
		|	Справочник.ГруппыКонтрагентов КАК ГруппыКонтрагентов
		|ГДЕ
		|	НЕ ГруппыКонтрагентов.ПометкаУдаления
		|	И (ГруппыКонтрагентов.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.ТретьиСтороны)
		|			ИЛИ ГруппыКонтрагентов.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.СвязанныеСТороны))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ВидыВзаиморасчетов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ВидыВзаиморасчетов
		|ИЗ
		|	Справочник.тн_ВидыВзаиморасчетов КАК тн_ВидыВзаиморасчетов
		|ГДЕ
		|	НЕ тн_ВидыВзаиморасчетов.ПометкаУдаления
		|	И НЕ тн_ВидыВзаиморасчетов.Ссылка В (&ОсобыеВидыВзаиморасчетов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ГруппыКонтрагентов.Ссылка КАК ТипКонтрагента,
		|	ВТ_ВидыВзаиморасчетов.Ссылка КАК ВидВзаиморасчетов,
		|	ВЫБОР
		|		КОГДА ВТ_ГруппыКонтрагентов.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.ТретьиСтороны)
		|			ТОГДА &СчетМСФО6121
		|		ИНАЧЕ &СчетМСФО6120
		|	КОНЕЦ КАК СчетМСФО,
		|	ВЫБОР
		|		КОГДА ВТ_ГруппыКонтрагентов.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.ТретьиСтороны)
		|			ТОГДА ""Торговая кредиторская задолженность - 3d""
		|		ИНАЧЕ ""Торговая кредиторская задолженность - r/p""
		|	КОНЕЦ КАК НаименованиеСчетаМСФО
		|ИЗ
		|	ВТ_ВидыВзаиморасчетов КАК ВТ_ВидыВзаиморасчетов,
		|	ВТ_ГруппыКонтрагентов КАК ВТ_ГруппыКонтрагентов";
	
	Запрос.УстановитьПараметр("ОсобыеВидыВзаиморасчетов", ОсобыеВидыВзаиморасчетов);
	Запрос.УстановитьПараметр("СчетМСФО6121", СчетМСФО6121);
	Запрос.УстановитьПараметр("СчетМСФО6120", СчетМСФО6120);

	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ИтоговыйРезультат = РезультатЗапроса[2];
	НаборЗаписей.Загрузить(ИтоговыйРезультат.Выгрузить());
	
    РезультатГруппыКонтрагентов = РезультатЗапроса[0];
	ВыборкаГруппыКонтрагентов = РезультатГруппыКонтрагентов.Выбрать();
	
	Пока ВыборкаГруппыКонтрагентов.Следующий() Цикл  
		
		Если ЗначениеЗаполнено(ВидВзаиморасчетовРетроБонус) Тогда
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТипКонтрагента = ВыборкаГруппыКонтрагентов.Ссылка; 
			НоваяЗапись.ВидВзаиморасчетов =  ВидВзаиморасчетовРетроБонус;
			Если ВыборкаГруппыКонтрагентов.ВидОтношенияКГруппе = Перечисления.ВидыОтношенийКГруппе.СвязанныеСтороны Тогда
				НоваяЗапись.СчетМСФО = СчетМСФО6122;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность по бонусам покупателям - r/p";
			Иначе
				НоваяЗапись.СчетМСФО = СчетМСФО6123;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность по бонусам покупателям - 3d";
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидВзаиморасчетовРасчетыСПоставщикамиОС) Тогда
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТипКонтрагента = ВыборкаГруппыКонтрагентов.Ссылка; 
			НоваяЗапись.ВидВзаиморасчетов =  ВидВзаиморасчетовРасчетыСПоставщикамиОС;
			Если ВыборкаГруппыКонтрагентов.ВидОтношенияКГруппе = Перечисления.ВидыОтношенийКГруппе.СвязанныеСтороны Тогда
				НоваяЗапись.СчетМСФО = СчетМСФО6132;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность за ОС и НМА (краткосрочная) - r/p";
			Иначе
				НоваяЗапись.СчетМСФО = СчетМСФО6133;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность за ОС и НМА (краткосрочная) - 3d";
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидВзаиморасчетовРасчетыСПоставщикамиНМА) Тогда
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТипКонтрагента = ВыборкаГруппыКонтрагентов.Ссылка; 
			НоваяЗапись.ВидВзаиморасчетов =  ВидВзаиморасчетовРасчетыСПоставщикамиНМА;
			Если ВыборкаГруппыКонтрагентов.ВидОтношенияКГруппе = Перечисления.ВидыОтношенийКГруппе.СвязанныеСтороны Тогда
				НоваяЗапись.СчетМСФО = СчетМСФО6132;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность за ОС и НМА (краткосрочная) - r/p";
			Иначе
				НоваяЗапись.СчетМСФО = СчетМСФО6133;
				НоваяЗапись.НаименованиеСчетаМСФО = "Кредиторская задолженность за ОС и НМА (краткосрочная) - 3d";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка
	    НаборЗаписей.Записать(); 
	Исключение
	    ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.РегистрыСведений.тн_КлассификацияЗадолженностиМСФО,,
			"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_КлассификацияЗадолженностиМСФО.ЗаполнитьПервоначальныеСведенияПоКлассификацииЗадолженностиМСФО: " 
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

//Урубков И. 04.09.2025 Выполнение задач №000054387
#КонецЕсли