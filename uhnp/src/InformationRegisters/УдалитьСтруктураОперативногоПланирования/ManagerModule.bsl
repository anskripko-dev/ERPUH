Процедура ПервоначальноеЗаполнение() Экспорт
	
	АОП = Справочники.АналитикиОперативногоПланирования;
	
	Реквизиты = "Аналитика, ОбязательноеЗаполнение, КонтрольЛимитов";
	
	Аналитики = Новый Массив;
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.ВидБюджета,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Период,			Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Валюта,			Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.ЦФО,				Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Проект,			Ложь,	Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.СтатьяБюджета, 	Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика1,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика2,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика3,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика4,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика5,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Аналитика6,		Истина, Истина));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.Контрагент,		Ложь,	Ложь));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.ДоговорКонтрагента,Ложь,	Ложь));
	Аналитики.Добавить(Новый Структура(Реквизиты, АОП.ПриходРасход,		Истина, Ложь));
	
	АналитикиБЗ = Новый Массив;
	АналитикиБЗ.Добавить(Новый Структура(Реквизиты, АОП.Организация,		Истина,	Ложь));
	АналитикиБЗ.Добавить(Новый Структура(Реквизиты, АОП.Менеджер,		Ложь,	Ложь));
	АналитикиБЗ.Добавить(Новый Структура(Реквизиты, АОП.МестоПоставки,	Истина, Ложь));
	АналитикиБЗ.Добавить(Новый Структура(Реквизиты, АОП.Номенклатура,	Истина, Ложь));
	АналитикиБЗ.Добавить(Новый Структура(Реквизиты, АОП.Приоритет,		Истина, Ложь));
	
	//
	ПВХ = ПланыВидовХарактеристик.ВидыБюджетов;
	ПР = Перечисления.ПредназначенияЭлементовСтруктурыОтчета;
	
	Реквизиты = "ВидБюджета, Предназначение";
	
	Бюджеты = Новый Массив;
	Бюджеты.Добавить(Новый Структура(Реквизиты, ПВХ.БюджетДвиженияДенежныхСредств, ПР.БюджетДвиженияДенежныхСредств));
	Бюджеты.Добавить(Новый Структура(Реквизиты, ПВХ.БюджетДоходовИРасходов, ПР.БюджетДоходовИРасходов));
	
	// Заполнение
	Для Каждого Бюджет Из Бюджеты Цикл
		
		НаборЗаписей = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидБюджета.Установить(Бюджет.ВидБюджета);
		НаборЗаписей.Отбор.Предназначение.Установить(Бюджет.Предназначение);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Для Каждого Аналитика Из Аналитики Цикл
			Движение = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, Бюджет);
			ЗаполнитьЗначенияСвойств(Движение, Аналитика);
		КонецЦикла;
			
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВидБюджетаИзПредназначения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтруктураОперативногоПланирования.ВидБюджета КАК ВидБюджета,
	|	СтруктураОперативногоПланирования.Предназначение КАК Предназначение,
	|	СтруктураОперативногоПланирования.Аналитика КАК Аналитика,
	|	ВидыБюджетов.Ссылка КАК ВидБюджетаНовый
	|ИЗ
	|	РегистрСведений.СтруктураОперативногоПланирования КАК СтруктураОперативногоПланирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|		ПО СтруктураОперативногоПланирования.Предназначение = ВидыБюджетов.Предназначение
	|ГДЕ
	|	СтруктураОперативногоПланирования.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Предназначение.Установить(Выборка.Предназначение);
		НаборЗаписей.Отбор.Аналитика.Установить(Выборка.Аналитика);
		НаборЗаписей.Прочитать();
		Для Каждого Движение Из НаборЗаписей Цикл
			Движение.ВидБюджета = Выборка.ВидБюджетаНовый;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьДо6АналитикСтатьи() Экспорт
	
	// Обновить регистр сведений СтруктураОперативногоПланирования
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыБюджетов.Ссылка КАК ВидБюджета
	|ПОМЕСТИТЬ ВТ_ВсеБюджеты
	|ИЗ
	|	ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|ГДЕ
	|	ВидыБюджетов.Предопределенный = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика1) КАК Аналитика
	|ПОМЕСТИТЬ ВТ_ВсеАналитики
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика2)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика3)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика4)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика5)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.АналитикиОперативногоПланирования.Аналитика6)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеБюджеты.ВидБюджета КАК ВидБюджета,
	|	ВТ_ВсеАналитики.Аналитика КАК Аналитика
	|ПОМЕСТИТЬ ВТ_ВсеБюджетыАналитики
	|ИЗ
	|	ВТ_ВсеБюджеты КАК ВТ_ВсеБюджеты,
	|	ВТ_ВсеАналитики КАК ВТ_ВсеАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеБюджетыАналитики.ВидБюджета КАК ВидБюджета,
	|	ВТ_ВсеБюджетыАналитики.ВидБюджета.Предназначение КАК Предназначение,
	|	ВТ_ВсеБюджетыАналитики.Аналитика КАК Аналитика,
	|	ИСТИНА КАК ОбязательноеЗаполнение,
	|	ИСТИНА КАК КонтрольЛимитов
	|ИЗ
	|	ВТ_ВсеБюджетыАналитики КАК ВТ_ВсеБюджетыАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураОперативногоПланирования КАК СтруктураОперативногоПланирования
	|		ПО ВТ_ВсеБюджетыАналитики.ВидБюджета.Предназначение = СтруктураОперативногоПланирования.Предназначение
	|			И ВТ_ВсеБюджетыАналитики.Аналитика = СтруктураОперативногоПланирования.Аналитика
	|ГДЕ
	|	СтруктураОперативногоПланирования.Аналитика ЕСТЬ NULL
	|ИТОГИ ПО
	|	ВидБюджета";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаВидБюджета = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидБюджета.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.СтруктураОперативногоПланирования.СоздатьНаборЗаписей();
		Отбор = НаборЗаписей.Отбор.Предназначение;
		Отбор.ВидСравнения = ВидСравнения.Равно;
		Отбор.Значение = ВыборкаВидБюджета.Предназначение;
		
		НаборЗаписей.Прочитать();
		
		Выборка = ВыборкаВидБюджета.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

Функция ВозможноИзменениеСтруктуры(Предназначение) Экспорт
	
	Результат = ЗапросБлокирующихСсылок(Предназначение);
	Возврат Результат.Пустой();
	
КонецФункции

Функция КоличествоБлокирующихСсылок(ВидБюджета) Экспорт
	
	Результат = ЗапросБлокирующихСсылок(ВидБюджета);
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе
		Возврат Результат.Выбрать().Количество();
	КонецЕсли;
	
КонецФункции

Функция БлокирующиеСсылки(ВидБюджета) Экспорт
	
	Результат = ЗапросБлокирующихСсылок(ВидБюджета);
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапросБлокирующихСсылок(ВидБюджета)
	
	// Есть проведенные опер.планы 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперативныйПлан.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперативныйПлан КАК ОперативныйПлан
	|ГДЕ
	|	ОперативныйПлан.ВидБюджета = &ВидБюджета
	|	И ОперативныйПлан.Проведен = ИСТИНА";
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли 