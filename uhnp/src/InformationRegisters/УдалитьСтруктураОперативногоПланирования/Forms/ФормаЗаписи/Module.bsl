
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВозможноЛимитирование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Аналитика, "ВозможноЛимитирование");
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ВозможностьРедактирования();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АналитикаПриИзменении(Элемент)
	АналитикаПриИзмененииНаСервере();
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ВидБюджетаПриИзменении(Элемент)
	ВидБюджетаПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.КонтрольЛимитов.ТолькоПросмотр = НЕ ВозможноЛимитирование;
	Если ВозможноЛимитирование Тогда
		Элементы.КонтрольЛимитов.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Иначе
		Элементы.КонтрольЛимитов.Подсказка = НСтр("ru = 'Аналитика не используется для лимитирования'");
		Элементы.КонтрольЛимитов.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АналитикаПриИзмененииНаСервере()
	
	ВозможноЛимитирование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Аналитика, "ВозможноЛимитирование");
	Если НЕ ВозможноЛимитирование И Запись.КонтрольЛимитов Тогда
		Запись.КонтрольЛимитов = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидБюджетаПриИзмененииНаСервере()
	Запись.Предназначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ВидБюджета, "Предназначение");
	ВозможностьРедактирования();
КонецПроцедуры

&НаСервере
Процедура ВозможностьРедактирования()
	
	Если НЕ Параметры.Ключ.Пустой() Тогда
		КоличествоБлокирующихСсылок = РегистрыСведений.СтруктураОперативногоПланирования.КоличествоБлокирующихСсылок(Запись.Предназначение);
	Иначе
		КоличествоБлокирующихСсылок = 0;
	КонецЕсли;
	
	ВозможноРедактирование = КоличествоБлокирующихСсылок = 0;
	
	Элементы.ГруппаТолькоПросмотр.Видимость = НЕ ВозможноРедактирование;
		
	Если ВозможноРедактирование Тогда
		Элементы.ДекорацияБлокирующиеСсылки.Заголовок = "";
	Иначе
		Шаблон = НСтр("ru = 'Существуют блокирующие редактирование ссылки (%1 шт).'");
		Элементы.ДекорацияБлокирующиеСсылки.Заголовок = СтрШаблон(Шаблон, КоличествоБлокирующихСсылок);
	КонецЕсли;
	
	// Блокирование элементов формы
	Элементы.Аналитика.ТолькоПросмотр = НЕ ВозможноРедактирование;
	Элементы.ОбязательноеЗаполнение.ТолькоПросмотр = НЕ ВозможноРедактирование;
	Элементы.ГруппаЛимитирование.ТолькоПросмотр = НЕ ВозможноРедактирование;
	
КонецПроцедуры

#КонецОбласти

