
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	МассивОшибок = Новый Массив;	
	
	Если Запись.КонтрольНеотправленных И Не ЗначениеЗаполнено(Запись.ЛимитНеотправленных) Тогда
		МассивОшибок.Добавить("Не заполнен ""Лимит неотправленных""");	
	КонецЕсли;
	
	Если Запись.КонтрольНедоставленных И Не ЗначениеЗаполнено(Запись.ЛимитНедоставленных) Тогда
		МассивОшибок.Добавить("Не заполнен ""Лимит недоставленных""");	
	КонецЕсли;
	
	Если Не МассивОшибок.Количество() = 0 Тогда
		МассивОшибок.Вставить(0, "Не удалось изменить записи, причина:");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(СтрСоединить(МассивОшибок, Символы.ПС), Отказ);	
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КонтрольНеотправленныхПриИзменении(Элемент)
	Элементы.ЛимитНеотправленных.АвтоОтметкаНезаполненного = Запись.КонтрольНеотправленных;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольНедоставленныхПриИзменении(Элемент)
	Элементы.ЛимитНедоставленных.АвтоОтметкаНезаполненного = Запись.КонтрольНедоставленных;
КонецПроцедуры

#КонецОбласти

