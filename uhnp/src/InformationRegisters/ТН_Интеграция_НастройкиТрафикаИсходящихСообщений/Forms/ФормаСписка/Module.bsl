&НаКлиенте
Процедура ПодобратьУзлыПланаОбмена(Команда)
	
	ОписаниеОповещенияПодбора = Новый ОписаниеОповещения("ПодобратьУзлыПланаОбменаЗавершение", ЭтотОбъект);
	
	СписокДоступныхПлановОбмена = Новый СписокЗначений;
	СписокДоступныхПлановОбмена.ЗагрузитьЗначения(ДоступныеПланыОбменаНастройкиТрафика());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборПланаОбменаЗавершение", ЭтотОбъект, ОписаниеОповещенияПодбора);
	СписокДоступныхПлановОбмена.ПоказатьВыборЭлемента(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеИзменениеЗаписей(Команда)	

	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;   
	
	МассивВыделенныхСтрок = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Элементы.Список.ВыделенныеСтроки);
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ГрупповоеИзменениеЗаписейОбработкаВопроса", ЭтотОбъект, МассивВыделенныхСтрок);		
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, "Изменить выделенные строки?", РежимДиалогаВопрос.ДаНет);		

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыборПланаОбменаЗавершение(Результат, ОписаниеОповещенияПодбора) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмяОбъекта = Результат.Значение;
	
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыСпискаОбъекта = ПолноеИмяОбъекта + ".ФормаВыбора";
	УникальностьФормы = Строка(УникальныйИдентификатор) + ПолноеИмяОбъекта;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму(ИмяФормыСпискаОбъекта, ПараметрыФормы, , УникальностьФормы, , , ОписаниеОповещенияПодбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеИзменениеЗаписейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено И Не ДополнительныеПараметры.РежимПодборУзлов Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.РежимПодборУзлов Тогда
		ОбработатьПодбораУзловПланаОбменаНаСервере(ДополнительныеПараметры.МассивДобавляемыхУзловПланаОбмена, Результат);
	Иначе
		ГрупповоеИзменениеЗаписейНаСервере(ДополнительныеПараметры.МассивВыделенныхСтрок, Результат);
	КонецЕсли;
		
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ГрупповоеИзменениеЗаписейНаСервере(МассивВыделенныхСтрок, СтруктураИзменямыхПолейРегистра)
	
	Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл // ВыделенныеСтроки содержат ключи записи регистра
		
		НаборЗаписей = РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.СоздатьНаборЗаписей();
		
		Для Каждого ЭлементОтбора Из НаборЗаписей.Отбор Цикл 
			ЭлементОтбора.Установить(ВыделеннаяСтрока[ЭлементОтбора.Имя]);
		КонецЦикла;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Выбран() И Не НаборЗаписей.Количество() = 0 Тогда
			
			Запись = НаборЗаписей[0];
			ЗаполнитьЗначенияСвойств(Запись, СтруктураИзменямыхПолейРегистра);
			
			НаборЗаписей.Записать();
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеИзменениеЗаписейОбработкаВопроса(РезультатВопроса, МассивВыделенныхСтрок) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимПодборУзлов", Ложь);
	ДополнительныеПараметры.Вставить("МассивВыделенныхСтрок", МассивВыделенныхСтрок);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ГрупповоеИзменениеЗаписейЗавершение", ЭтотОбъект, ДополнительныеПараметры); 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимГрупповогоИзменения", Истина);
	ОткрытьФорму("РегистрСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.Форма.ФормаГрупповогоИзмененияЗаписей", ПараметрыФормы, , УникальныйИдентификатор, 
							Окно, , ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоступныеПланыОбменаНастройкиТрафика()

	Результат = Новый Массив;
	
	МассивТиповПланаОбмена = Метаданные.РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.Измерения.УзелПланаОбмена.Тип.Типы();

	Для Каждого ЭлементМассива Из МассивТиповПланаОбмена Цикл
		
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ЭлементМассива);
		Результат.Добавить(МетаданныеОбъекта.ПолноеИмя());		
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьПодбораУзловПланаОбменаНаСервере(Знач МассивДобавляемыхУзловПланаОбмена, СтруктураИзменямыхПолейРегистра = Неопределено)
	
	// - Ранее добавленные узлы не изменяем
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.УзелПланаОбмена КАК УзелПланаОбмена
		|ИЗ
		|	РегистрСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений КАК ТН_Интеграция_НастройкиТрафикаИсходящихСообщений
		|ГДЕ
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.УзелПланаОбмена В(&УзлыПланаОбмена)";
	
	Запрос.УстановитьПараметр("УзлыПланаОбмена", МассивДобавляемыхУзловПланаОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныхЗаписей = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныхЗаписей.Следующий() Цикл
			
			УдаляемыйЭлементМассив = МассивДобавляемыхУзловПланаОбмена.Найти(ВыборкаДетальныхЗаписей.УзелПланаОбмена);
			Если Не УдаляемыйЭлементМассив = Неопределено Тогда
				МассивДобавляемыхУзловПланаОбмена.Удалить(УдаляемыйЭлементМассив);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	// - Добавляем узлы плана обмена в регистр
	
	Для Каждого ЭлементМассива Из МассивДобавляемыхУзловПланаОбмена Цикл
		
		МенеджерЗаписи = РегистрыСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УзелПланаОбмена = ЭлементМассива;
		
		Если Не СтруктураИзменямыхПолейРегистра = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураИзменямыхПолейРегистра);	
		КонецЕсли;
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьУзлыПланаОбменаЗавершение(МассивДобавляемыхУзловПланаОбмена, ОписаниеОповещениеПослеПодбора) Экспорт
	
	Если МассивДобавляемыхУзловПланаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметрыОповещения = Новый Структура;
	ДополнительныеПараметрыОповещения.Вставить("РежимПодборУзлов", Истина);
	ДополнительныеПараметрыОповещения.Вставить("МассивДобавляемыхУзловПланаОбмена", МассивДобавляемыхУзловПланаОбмена);
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ГрупповоеИзменениеЗаписейЗавершение", ЭтотОбъект, ДополнительныеПараметрыОповещения); 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимГрупповогоИзменения", Ложь);
	ОткрытьФорму("РегистрСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.Форма.ФормаГрупповогоИзмененияЗаписей", ПараметрыФормы, , УникальныйИдентификатор, 
							Окно, , ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
									
КонецПроцедуры

#КонецОбласти
