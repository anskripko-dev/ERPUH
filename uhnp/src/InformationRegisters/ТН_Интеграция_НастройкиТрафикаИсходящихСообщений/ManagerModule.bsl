
Функция ПроверитьЛимитыТрафика(УзелПланаОбмена) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Истина);
	Результат.Вставить("ТекстОшибки", "");
	
	ТекстЗапроса = ТекстЗапросаКонтрольПревышениеЛимитаТрафика();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборУзелПланаОбмена", "ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.УзелПланаОбмена = &УзелПланаОбмена");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;   	
	Запрос.УстановитьПараметр("УзелПланаОбмена", УзелПланаОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда	
	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		МассивОшибок = МассивСообщенийПревышениеТрафика(ВыборкаДетальныеЗаписи, УзелПланаОбмена);
		
		Если Не МассивОшибок.Количество() = 0 Тогда
			
			Результат.Успешно = Ложь;
			Результат.ТекстОшибки = СтрСоединить(МассивОшибок, Символы.ПС);
			
		КонецЕсли;
					
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаКонтрольПревышениеЛимитаТрафика(ДобавитьИтоги = Ложь) Экспорт
	
	// Запрос:	
	// 	- Получает все узлы плана обмена (или с отбором по узлу) у которых включен контроль трафика и заполнен лимит
	// 	- Для каждого найденного узла получаем статистику по исходящим сообщениям (кол-во недоставленных и неотправленных)
	// 	- Сравниваем статистику с лимитами и получаем список узлов по которым превышен лимит
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.УзелПланаОбмена КАК УзелПланаОбмена,
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.ЛимитНедоставленных КАК ЛимитНедоставленных
		|ПОМЕСТИТЬ ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных
		|ИЗ
		|	РегистрСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений КАК ТН_Интеграция_НастройкиТрафикаИсходящихСообщений
		|ГДЕ
		|	&ОтборУзелПланаОбмена
		|	И ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.КонтрольНедоставленных
		|	И НЕ ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.ЛимитНедоставленных = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.УзелПланаОбмена КАК УзелПланаОбмена,
		|	ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.ЛимитНеотправленных КАК ЛимитНеотправленных
		|ПОМЕСТИТЬ ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных
		|ИЗ
		|	РегистрСведений.ТН_Интеграция_НастройкиТрафикаИсходящихСообщений КАК ТН_Интеграция_НастройкиТрафикаИсходящихСообщений
		|ГДЕ
		|	&ОтборУзелПланаОбмена
		|	И ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.КонтрольНеотправленных
		|	И НЕ ТН_Интеграция_НастройкиТрафикаИсходящихСообщений.ЛимитНеотправленных = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящиеСообщения.УзелПланаОбмена КАК УзелПланаОбмена,
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных.ЛимитНедоставленных КАК ЛимитНедоставленных,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИсходящиеСообщения.Ссылка) КАК КоличествоНедоставленных,
		|	ИСТИНА КАК ПревышенЛимитНедоставленных
		|ПОМЕСТИТЬ ВТ_ИсходящиеСообщенияНедоставленные
		|ИЗ
		|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных КАК ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных
		|		ПО ИсходящиеСообщения.УзелПланаОбмена = ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных.УзелПланаОбмена
		|ГДЕ
		|	НЕ ИсходящиеСообщения.Доставлено
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсходящиеСообщения.УзелПланаОбмена,
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных.ЛимитНедоставленных
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИсходящиеСообщения.Ссылка) > ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных.ЛимитНедоставленных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсходящиеСообщения.УзелПланаОбмена КАК УзелПланаОбмена,
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных.ЛимитНеотправленных КАК ЛимитНеотправленных,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИсходящиеСообщения.Ссылка) КАК КоличествоНеотправленных,
		|	ИСТИНА КАК ПревышенЛимитНеотправленных
		|ПОМЕСТИТЬ ВТ_ИсходящиеСообщенияНеотправленных
		|ИЗ
		|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных КАК ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных
		|		ПО ИсходящиеСообщения.УзелПланаОбмена = ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных.УзелПланаОбмена
		|ГДЕ
		|	ИсходящиеСообщения.ДатаВремяОтправки = ДАТАВРЕМЯ(1, 1, 1)
		//НАЧАЛО Ведутенко С.А. 11.11.2025 Выполнение задач №000055781
		|	И ИсходящиеСообщения.КоличествоПопыток > 0		
		//КОНЕЦ  Ведутенко С.А. 11.11.2025 Выполнение задач №000055781
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсходящиеСообщения.УзелПланаОбмена,
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных.ЛимитНеотправленных
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИсходящиеСообщения.Ссылка) > ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных.ЛимитНеотправленных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных.УзелПланаОбмена КАК УзелПланаОбмена
		|ПОМЕСТИТЬ ВТ_КонтролируемыеУзлыПланаОбмена
		|ИЗ
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных КАК ВТ_НастройкаТрафикаИсходящихСообщений_Недоставленных
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных.УзелПланаОбмена
		|ИЗ
		|	ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных КАК ВТ_НастройкаТрафикаИсходящихСообщений_Неотправленных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТИПЗНАЧЕНИЯ(ВТ_КонтролируемыеУзлыПланаОбмена.УзелПланаОбмена) КАК ТипУзлаПланаОбмена,
		|	ВТ_КонтролируемыеУзлыПланаОбмена.УзелПланаОбмена КАК УзелПланаОбмена,
		|	ПРЕДСТАВЛЕНИЕ(ВТ_КонтролируемыеУзлыПланаОбмена.УзелПланаОбмена) КАК ПредставлениеУзелПланаОбмена,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНедоставленные.ПревышенЛимитНедоставленных, ЛОЖЬ) КАК ПревышенЛимитНедоставленных,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНеотправленных.ПревышенЛимитНеотправленных, ЛОЖЬ) КАК ПревышенЛимитНеотправленных,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНедоставленные.КоличествоНедоставленных, 0) КАК КоличествоНедоставленных,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНеотправленных.КоличествоНеотправленных, 0) КАК КоличествоНеотправленных,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНедоставленные.ЛимитНедоставленных, 0) КАК ЛимитНедоставленных,
		|	ЕСТЬNULL(ВТ_ИсходящиеСообщенияНеотправленных.ЛимитНеотправленных, 0) КАК ЛимитНеотправленных
		|ИЗ
		|	ВТ_КонтролируемыеУзлыПланаОбмена КАК ВТ_КонтролируемыеУзлыПланаОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсходящиеСообщенияНедоставленные КАК ВТ_ИсходящиеСообщенияНедоставленные
		|		ПО ВТ_КонтролируемыеУзлыПланаОбмена.УзелПланаОбмена = ВТ_ИсходящиеСообщенияНедоставленные.УзелПланаОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсходящиеСообщенияНеотправленных КАК ВТ_ИсходящиеСообщенияНеотправленных
		|		ПО ВТ_КонтролируемыеУзлыПланаОбмена.УзелПланаОбмена = ВТ_ИсходящиеСообщенияНеотправленных.УзелПланаОбмена
		|ГДЕ
		|	(ЕСТЬNULL(ВТ_ИсходящиеСообщенияНедоставленные.ПревышенЛимитНедоставленных, ЛОЖЬ)
		|			ИЛИ ЕСТЬNULL(ВТ_ИсходящиеСообщенияНеотправленных.ПревышенЛимитНеотправленных, ЛОЖЬ))";
	
	Если ДобавитьИтоги Тогда
		
		ТекстЗапроса = ТекстЗапроса 
						+ "
						|ИТОГИ
						|	МАКСИМУМ(ПревышенЛимитНедоставленных),
						|	МАКСИМУМ(ПревышенЛимитНеотправленных),
						|	МАКСИМУМ(КоличествоНедоставленных),
						|	МАКСИМУМ(КоличествоНеотправленных),
						|	МАКСИМУМ(ЛимитНедоставленных),
						|	МАКСИМУМ(ЛимитНеотправленных)
						|ПО
						|	ТипУзлаПланаОбмена";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция МассивСообщенийПревышениеТрафика(ДанныеКонтроляТрафика, УзелПланаОбмена) Экспорт

	МассивОшибок = Новый Массив;
		
	Если ДанныеКонтроляТрафика.ПревышенЛимитНеотправленных Тогда	
		
		ТекстОшибки = СтрШаблон("Лимит неотправленных - %1, количество неотправленных - %2",
								ДанныеКонтроляТрафика.ЛимитНеотправленных,
								ДанныеКонтроляТрафика.КоличествоНеотправленных);
		МассивОшибок.Добавить(ТекстОшибки); 	
		
	КонецЕсли;
	
	Если ДанныеКонтроляТрафика.ПревышенЛимитНедоставленных Тогда	
		
		ТекстОшибки = СтрШаблон("Лимит недоставленных - %1, количество недоставленных - %2",
								ДанныеКонтроляТрафика.ЛимитНедоставленных,
								ДанныеКонтроляТрафика.КоличествоНедоставленных);
		МассивОшибок.Добавить(ТекстОшибки); 	
		
	КонецЕсли;
	
	Если Не МассивОшибок.Количество() = 0 Тогда
		
		Если ТипЗнч(УзелПланаОбмена) = Тип("Тип") Тогда
			ТекстОшибки = СтрШаблон("Превышен трафик исходящих сообщений для плана обмена %1:", Строка(УзелПланаОбмена));
		Иначе
			ТекстОшибки = СтрШаблон("Превышен трафик исходящих сообщений для узла %1:", Строка(УзелПланаОбмена));	
		КонецЕсли;
		
		МассивОшибок.Вставить(0, ТекстОшибки);
		
	КонецЕсли;
	
	Возврат МассивОшибок;
	
КонецФункции

Функция СоответствиеПараметровПоискаАктивныхФоновыхЗаданий() Экспорт
	
	Результат = Новый Соответствие;
	Результат.Вставить(Тип("ПланОбменаСсылка.тн_Интеграция_ЗУП")	, ПараметрыПоискаАктивныхФоновыхЗаданий_тн_Интеграция_ЗУП());
	Результат.Вставить(Тип("ПланОбменаСсылка.тн_Интеграция_УПП")	, ПараметрыПоискаАктивныхФоновыхЗаданий_тн_Интеграция_УПП());
	Результат.Вставить(Тип("ПланОбменаСсылка.тн_Интеграция_УПП_ОКС"), ПараметрыПоискаАктивныхФоновыхЗаданий_тн_Интеграция_УПП_ОКС());
	Результат.Вставить(Тип("ПланОбменаСсылка.тн_Интеграция_УПП_ЦБ")	, ПараметрыПоискаАктивныхФоновыхЗаданий_тн_Интеграция_УПП_ЦБ());
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыПоискаАктивныхФоновыхЗаданий_тн_Интеграция_ЗУП()
	
	Результат = ШаблонПараметровПоискаАктивныхФоновыхЗаданий();
	Результат.РежимОтборРЗ 					= Истина;
	Результат.ИмяРегламентногоЗадания 		= Метаданные.РегламентныеЗадания.тн_Интеграция_Выгрузка_ЗУП.Имя;
	
	// Дополнительные отборы фоновых заданий
	
	МассивНайденныхРегламентныхЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.тн_Интеграция_Выгрузка_ЗУП));
	Если Не МассивНайденныхРегламентныхЗаданий.Количество() = 0 Тогда
		Результат.ОтборыФоновыхЗаданий.Вставить("РегламентноеЗадание", МассивНайденныхРегламентныхЗаданий[0]);
	КонецЕсли;
	
	Возврат Результат;	
	
