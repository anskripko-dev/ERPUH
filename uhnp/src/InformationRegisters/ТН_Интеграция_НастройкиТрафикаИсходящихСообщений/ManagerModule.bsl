	Результат.ИмяРегламентногоЗадания 		= Метаданные.РегламентныеЗадания.тн_Интеграция_Выгрузка_ЦБ.Имя;
	
	// Дополнительные отборы фоновых заданий
	
	МассивНайденныхРегламентныхЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.тн_Интеграция_Выгрузка_ЦБ));
	Если Не МассивНайденныхРегламентныхЗаданий.Количество() = 0 Тогда
		Результат.ОтборыФоновыхЗаданий.Вставить("РегламентноеЗадание", МассивНайденныхРегламентныхЗаданий[0]);
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ШаблонПараметровПоискаАктивныхФоновыхЗаданий()
	
	Результат = Новый Структура;
	Результат.Вставить("РежимОтборРЗ"				, Ложь);// В этом режиме фоновые задания будут искаться по регламентному заданию
	Результат.Вставить("РежимШаблонногоПоиска"		, Ложь);// В этом режиме фоновые задания будут искаться по подстроке (Шаблон поиска)
	Результат.Вставить("ИмяСвойстваШаблонногоПоиска", "");  // Имя свойство по которому будет производиться поиск по подстраке
	Результат.Вставить("ШаблонПоиска"				, "");  // Значение поиска по подстраке
	Результат.Вставить("ИмяРегламентногоЗадания"	, "");	// Для информации в ЖР при отмене ФЗ
	Результат.Вставить("ПроверкаДетальныхЗаписей"	, Ложь);// Для планов обменов, у которых задано несколько узлов плана обмена
		
	ПараметрыЗаменыШаблонаПоиска = Новый Структура;
	ПараметрыЗаменыШаблонаПоиска.Вставить("Использовать", Ложь);         // Используется для подстановки значение в ШаблонПоиска. Значение подставляются из данных контроля трафика
	ПараметрыЗаменыШаблонаПоиска.Вставить("ИмяЗаменяемойПодстроки", ""); // Используется как подстрока поиска и как имя колонки / свойства у получаемого значения
	Результат.Вставить("ПараметрыЗаменыШаблонаПоиска", ПараметрыЗаменыШаблонаПоиска);
	
	ОтборыФоновыйЗаданий = Новый Структура;
	ОтборыФоновыйЗаданий.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);	
	Результат.Вставить("ОтборыФоновыхЗаданий", ОтборыФоновыйЗаданий); 	
	
	Возврат Результат;
	
КонецФункции
