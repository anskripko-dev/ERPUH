
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЕстьСвойствоВидБюджета = Параметры.ЗначенияЗаполнения.Свойство("ВидБюджета");
	
	Если Параметры.Ключ.Пустой() Тогда		
		Если ЕстьСвойствоВидБюджета Тогда
			ЗаполнитьЗначенияСвойств(Запись, Параметры.ЗначенияЗаполнения);
		Иначе
			ВызватьИсключение НСтр("ru = 'Работа с регистром возможна через АРМ ""Управление планами и лимитами""'");	
		КонецЕсли;  	
	Иначе  	
		Если Не ЕстьСвойствоВидБюджета Тогда
			ТолькоПросмотр = Истина;   
		КонецЕсли;  		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

