#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Или Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьПризнакАктСверки(Отказ);
	
	Если Не Отказ И ДополнительныеСвойства.КоличествоЗаписей = 0 Тогда
		ЭтотОбъект[0].АктСверки = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПризнакАктСверки(Отказ, ВыводитьСообщение = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	тн_ДоговорыПоПодразделениямФС.Договор КАК Договор,
	               |	тн_ДоговорыПоПодразделениямФС.ПодразделениеФС КАК ПодразделениеФС
	               |ИЗ
	               |	РегистрСведений.тн_ДоговорыПоПодразделениямФС КАК тн_ДоговорыПоПодразделениямФС
	               |ГДЕ
	               |	тн_ДоговорыПоПодразделениямФС.Договор В(&ДоговорыКонтрагентов)
	               |	И тн_ДоговорыПоПодразделениямФС.АктСверки = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(тн_ДоговорыПоПодразделениямФС.ПодразделениеФС) КАК КоличествоЗаписей
	               |ИЗ
	               |	РегистрСведений.тн_ДоговорыПоПодразделениямФС КАК тн_ДоговорыПоПодразделениямФС
	               |ГДЕ
	               |	тн_ДоговорыПоПодразделениямФС.Договор В(&ДоговорыКонтрагентов)";
	
	Запрос.УстановитьПараметр("ДоговорыКонтрагентов", ВыгрузитьКолонку("Договор"));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = РезультатыЗапроса[0].Выгрузить();
	Результат.Индексы.Добавить("Договор");
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		ИнформацияПоДоговору = Результат.Найти(Запись.Договор, "Договор");
		Если ИнформацияПоДоговору = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Запись.АктСверки И ИнформацияПоДоговору.ПодразделениеФС <> Запись.ПодразделениеФС Тогда
			
			ТекстОшибки = НСтр("ru = 'Признак ""Акт сверки"" не может быть установлен для нескольких подразделений ФС в рамках одного договора.'");
			
			Если ВыводитьСообщение Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);
			Иначе
				Отказ = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		ДополнительныеСвойства.Вставить("КоличествоЗаписей", Выборка.КоличествоЗаписей);	
	Иначе
		ДополнительныеСвойства.Вставить("КоличествоЗаписей", 0);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли