
&НаКлиенте
Процедура НастройкаОрганизацииПриИзменении(Элемент)
	
	НастроитьПараметрыОтбораОрганизации();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПараметрыОтбораОрганизации()
	
	ПолеКомпоновки = Новый ПолеКомпоновкиДанных("ПоГруппамОрганизаций");
	ТекЭлемент = ТиповыеОтчеты_УправляемыйРежимУХ.ВернутьЭлементОтбора(Список.Отбор, ПолеКомпоновки);
	
	Если ТекЭлемент = Неопределено Тогда
		
		Если НастройкаОрганизации=0 Тогда
			
			Возврат;
			
		Иначе
			
			ТекЭлемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ТекЭлемент.ЛевоеЗначение = ПолеКомпоновки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НастройкаОрганизации=0 Тогда
		
		ТекЭлемент.Использование = Ложь;
		
	Иначе
		
		ТекЭлемент.Использование = Истина;
		ТекЭлемент.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ТекЭлемент.ПравоеЗначение = ?(НастройкаОрганизации=1,1,0);
		
		Элементы.Организация.Заголовок=?(НастройкаОрганизации=1,Нстр("ru = 'Организации'"),Нстр("ru = 'Группы доступа к организациям'"));
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьПараметрыОтбораОрганизации()

