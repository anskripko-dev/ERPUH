&НаКлиенте
Процедура ОткрытьМатрицуНастроек(Команда)
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		ФормаОбработки = "Обработка.МатрицаПравДоступаВидыОтчетов.Форма";
		ОткрытьФорму(ФормаОбработки);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ=Истина;
	
	СтруктураПараметров=Новый Структура;
	
	Если Копирование И ЗначениеЗаполнено(Элемент.ТекущаяСтрока) Тогда
		
		СтруктураПараметров.Вставить("ЗначениеКопирования",Элемент.ТекущаяСтрока);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("НастройкаВидыОтчетов",НастройкаВидыОтчетов);
	СтруктураПараметров.Вставить("НастройкаОрганизации",НастройкаОрганизации);
	СтруктураПараметров.Вставить("НастройкаПользователи",НастройкаПользователи);
	
	ОткрытьФорму("РегистрСведений.НастройкиПравДоступаПользователейВидыОтчетов.ФормаЗаписи",СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Отказ=Истина;
	
	СтруктураПараметров=Новый Структура;
	
	Если ЗначениеЗаполнено(Элемент.ТекущаяСтрока) Тогда
		
		СтруктураПараметров.Вставить("Ключ",Элемент.ТекущаяСтрока);
		
	КонецЕсли;
	
	СтруктураПараметров.Вставить("НастройкаВидыОтчетов",НастройкаВидыОтчетов);
	СтруктураПараметров.Вставить("НастройкаОрганизации",НастройкаОрганизации);
	СтруктураПараметров.Вставить("НастройкаПользователи",НастройкаПользователи);
	
	ОткрытьФорму("РегистрСведений.НастройкиПравДоступаПользователейВидыОтчетов.ФормаЗаписи",СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяКонстантыГруппыВидыОтчетов="ИспользоватьГруппыДоступаКВидамОтчетов";
	ИмяКонстантыГруппыОрганизации="ИспользоватьГруппыДоступаОрганизацииВидыОтчетов";
	ИмяКонстантыГруппыПользователи="ИспользоватьГруппыДоступаПользователиВидыОтчетов";
	
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда 
		
		НастройкаВидыОтчетов=?(Константы[ИмяКонстантыГруппыВидыОтчетов].Получить(),2,1);
		НастройкаОрганизации=?(Константы[ИмяКонстантыГруппыОрганизации].Получить(),2,1);
		НастройкаПользователи=?(Константы[ИмяКонстантыГруппыПользователи].Получить(),2,1);
		
	Иначе
		
		НастройкаВидыОтчетов=1;
		НастройкаОрганизации=1;
		НастройкаПользователи=1;
		
	КонецЕсли;
		
	НастроитьПараметрыОтбораВидыОтчетов();
	НастроитьПараметрыОтбораОрганизации();
	НастроитьПараметрыОтбораПользователи();
	
КонецПроцедуры
