#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗФизЛиц.ФизическоеЛицо
		|ПОМЕСТИТЬ ТаблицаФизЛиц
		|ИЗ
		|	&ТЗФизЛиц КАК ТЗФизЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФункциональныеНаправленияФизическихЛиц.ФизическоеЛицо КАК Сотрудник
		|ИЗ
		|	РегистрСведений.ФункциональныеНаправленияФизическихЛиц КАК ФункциональныеНаправленияФизическихЛиц
		|ГДЕ
		|	&Условие
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ТаблицаФункциональныхНаправлений.ФизическоеЛицо
		|ИЗ
		|	ТаблицаФизЛиц КАК ТаблицаФункциональныхНаправлений";
		
	Запрос.УстановитьПараметр("ТЗФизЛиц", ЭтотОбъект.Выгрузить(,"ФизическоеЛицо"));
	
	флПервыйЭлементОтбора = Истина;	
	ТекстУсловия = "";
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если флПервыйЭлементОтбора Тогда
			флПервыйЭлементОтбора = Ложь;
		Иначе
			ТекстУсловия = ТекстУсловия + "	И ";
		КонецЕсли;
		
		Имя_ = ЭлементОтбора.Имя;
		ТекстУсловия = ТекстУсловия + "ФункциональныеНаправленияФизическихЛиц." + Имя_ + " = &" + Имя_ + Символы.ПС;
        Запрос.УстановитьПараметр(Имя_, ЭлементОтбора.Значение);
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстУсловия) Тогда
		Запрос.УстановитьПараметр("Условие", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", ТекстУсловия);
	КонецЕсли;
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("мСотрудников", РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Сотрудник"));
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("мСотрудников") И ЭтотОбъект.ДополнительныеСвойства.мСотрудников.Количество() > 0 Тогда
		ВыборОбъектовУХ.ОбновитьНастройкиПроцессаВыбораПоСотрудникам(ЭтотОбъект.ДополнительныеСвойства.мСотрудников);
	КонецЕсли;
		
КонецПроцедуры

#КонецЕсли
