
Функция Печать(Отбор) Экспорт
		
	Схема = РегистрыСведений.ОрганизационныеЕдиницыЭтаповПроцессов.ПолучитьМакет("Отчет");
	Если ЗначениеЗаполнено(Отбор) Тогда
		Для Каждого КлючЗначение Из Отбор Цикл
			ЭлементОтбора = Схема.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = КлючЗначение.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	МакетКомпоновки = Компоновщик.Выполнить(Схема, Схема.НастройкиПоУмолчанию, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Для НомерСтроки = 1 По Результат.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По Результат.ШиринаТаблицы Цикл
			Область = Результат.Область(НомерСтроки, НомерКолонки);
			Если НЕ Область.Расшифровка = Неопределено И ТипЗнч(Область.Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
				Область.Расшифровка = ДанныеРасшифровки.Элементы[Область.Расшифровка].ПолучитьПоля()[0].Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции