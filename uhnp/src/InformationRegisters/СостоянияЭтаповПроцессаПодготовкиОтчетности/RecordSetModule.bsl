#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из ЭтотОбъект Цикл
		
		// Проверим, необходимо ли завершать процесс
		Если Запись.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда

			СтруктураПараметров = УправлениеПроцессамиПодготовкиОтчетности.ПараметрыОбработкиЭтапов();
			СтруктураПараметров.Вставить("УправлениеПериодом", Запись.УправлениеПериодомСценария);
			
			Запрос = УправлениеПроцессамиПодготовкиОтчетности.ЗапросПоДаннымЭтапов(СтруктураПараметров);
			Запрос.Текст = Запрос.Текст +
				"ВЫБРАТЬ
				|	МИНИМУМ(ВЫБОР
				|			КОГДА ДанныеЭтапов.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен)
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ ЛОЖЬ
				|		КОНЕЦ) КАК ВсеЭтапыЗавершены
				|ИЗ
				|	втДанныеЭтапов КАК ДанныеЭтапов";
			
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				ВыборкаЗапроса = РезультатЗапроса.Выбрать();
				ВыборкаЗапроса.Следующий();
				Если ВыборкаЗапроса.ВсеЭтапыЗавершены = Истина Тогда
					МенеджерЗаписи = РегистрыСведений.СостоянияПроцессаПодготовкиОтчетности.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.УправлениеПериодомСценария = Запись.УправлениеПериодомСценария;
					МенеджерЗаписи.Состояние = Перечисления.СостоянияПроцессаПодготовкиОтчетности.Завершен;
					МенеджерЗаписи.ДатаОкончания = Запись.ДатаОкончания;
					МенеджерЗаписи.Записать();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Выполним оповещение ответственных лиц
		Если Запись.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ВОбработке Тогда
			УправлениеПроцессамиПодготовкиОтчетности.ОповеститьОтветственных(Справочники.ВидыСобытийОповещений.ТребуетсяЗаполнитьОтчетыПоЭтапу, Запись, Отказ);
			ВидыСобытийОповещений = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусВОбработке;
		ИначеЕсли Запись.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.Завершен Тогда
			ВидыСобытийОповещений = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершен;
		ИначеЕсли Запись.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.ЗавершенСОшибкой Тогда
			ВидыСобытийОповещений = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусЗавершенСОшибкой;
		ИначеЕсли Запись.Состояние = Перечисления.СостоянияЭтаповПроцессаПодготовкиОтчетности.НеАктивен Тогда
			ВидыСобытийОповещений = Справочники.ВидыСобытийОповещений.ЭтапПроцессаПереведенВСтатусНеАктивен;
		КонецЕсли;
		УправлениеПроцессамиПодготовкиОтчетности.ОповеститьОтветственных(ВидыСобытийОповещений, Запись, Отказ);
		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
