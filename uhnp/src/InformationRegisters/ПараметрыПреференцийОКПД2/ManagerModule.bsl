#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда  
	
Процедура ОбновитьДанныеПреференций() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлассификаторОКПД2.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлассификаторОКПД2 КАК КлассификаторОКПД2
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыПреференцийОКПД2 КАК ПараметрыПреференцийОКПД2
		|		ПО ПараметрыПреференцийОКПД2.ОКПД2 = КлассификаторОКПД2.Ссылка
		|ГДЕ
		|	ПараметрыПреференцийОКПД2.Значение ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Менеджер = РегистрыСведений.ПараметрыПреференцийОКПД2.СоздатьМенеджерЗаписи();
		Менеджер.ОКПД2 = ВыборкаДетальныеЗаписи.Ссылка;
		Менеджер.Записать(Истина);
	КонецЦикла;
	

КонецПроцедуры

Функция ПреференцииКодовПоНоменклатуре(Период, Коллекция) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.КодОКПД2 КАК КодОКПД2
		|ПОМЕСТИТЬ СоответствиеКодов
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КатегорииЗакупок.Ссылка,
		|	КатегорииЗакупок.КодОКПД2
		|ИЗ
		|	Справочник.ТоварныеКатегории КАК КатегорииЗакупок
		|ГДЕ
		|	КатегорииЗакупок.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеКодов.КодОКПД2 КАК КодОКПД2,
		|	ЕСТЬNULL(ПараметрыПреференцийОКПД2СрезПоследних.НациональныйРежимЗакупок, ЗНАЧЕНИЕ(Перечисление.НациональныйРежимЗакупок.НеИспользовать)) КАК НациональныйРежимЗакупок,
		|	ЕСТЬNULL(ПараметрыПреференцийОКПД2СрезПоследних.Значение, 0) КАК Значение,
		|	ЕСТЬNULL(ПараметрыПреференцийОКПД2СрезПоследних.ЗапретОграничение, ЛОЖЬ) КАК ЗапретОграничение,
		|	СоответствиеКодов.Ссылка КАК Ссылка
		|ИЗ
		|	СоответствиеКодов КАК СоответствиеКодов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыПреференцийОКПД2.СрезПоследних(
		|				&Период,
		|				ОКПД2 В
		|					(ВЫБРАТЬ
		|						СоответствиеКодов.КодОКПД2
		|					ИЗ
		|						СоответствиеКодов КАК СоответствиеКодов)) КАК ПараметрыПреференцийОКПД2СрезПоследних
		|		ПО СоответствиеКодов.КодОКПД2 = ПараметрыПреференцийОКПД2СрезПоследних.ОКПД2";
	
	Запрос.УстановитьПараметр("Период", Период); 
	Запрос.УстановитьПараметр("Ссылка", Коллекция); 
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ТоварныеКатегории", "Справочник.КатегорииЗакупок");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
	
	Результат = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Параметры = Новый Структура("КодОКПД2, НациональныйРежимЗакупок, Значение, ЗапретОграничение");
		ЗаполнитьЗначенияСвойств(Параметры, ВыборкаДетальныеЗаписи, "КодОКПД2, НациональныйРежимЗакупок, Значение, ЗапретОграничение");
		Результат.Вставить(ВыборкаДетальныеЗаписи.Ссылка, Параметры); 
	КонецЦикла;
	
	Возврат Результат;

КонецФункции // ПреференцииКодовПоНоменклатуре()

#КонецЕсли