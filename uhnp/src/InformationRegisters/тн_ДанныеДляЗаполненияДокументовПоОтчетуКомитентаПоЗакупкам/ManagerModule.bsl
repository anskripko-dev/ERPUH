#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ПолучитьДанныеДляЗаполненияДокумента(Контрагент, ВидДокумента) Экспорт

	Результат = Неопределено;
	
	Запрос = Новый Запрос;      
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	               |	тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.Статья КАК Статья,
	               |	тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.Аналитика КАК Аналитика
	               |ИЗ
	               |	РегистрСведений.тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам КАК тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам
	               |ГДЕ
	               |	тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.Контрагент = &Контрагент
	               |	И тн_ДанныеДляЗаполненияДокументовПоОтчетуКомитентаПоЗакупкам.ВидДокумента = &ВидДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("ПодразделениеПолучатель", Выборка.ПодразделениеПолучатель);
		Результат.Вставить("Статья",                  Выборка.Статья);
		Результат.Вставить("Аналитика",               Выборка.Аналитика);
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции		
	
#КонецЕсли
