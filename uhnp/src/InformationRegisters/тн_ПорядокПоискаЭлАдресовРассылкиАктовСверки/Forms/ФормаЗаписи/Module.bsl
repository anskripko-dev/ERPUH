
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЭтотОбъект.Параметры.ЗначениеКопирования.Пустой() Или НЕ ЗначениеЗаполнено(Запись.Порядок) Тогда 
	
	    Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ПорядокПоискаЭлАдресовКонтрагентов.Порядок) КАК Порядок
		|ИЗ
		|	РегистрСведений.тн_ПорядокПоискаЭлАдресовРассылкиАктовСверки КАК ПорядокПоискаЭлАдресовКонтрагентов";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Запись.Порядок = ?(ВыборкаДетальныеЗаписи.Порядок = null, 0, ВыборкаДетальныеЗаписи.Порядок) + 1;
		
		мПорядок = Запись.Порядок;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокПриИзменении(Элемент)
	
	Если Запись.Порядок = 0 Тогда
		Запись.Порядок = мПорядок;
	Иначе
		мПорядок = Запись.Порядок;
	КонецЕсли;
	
КонецПроцедуры
