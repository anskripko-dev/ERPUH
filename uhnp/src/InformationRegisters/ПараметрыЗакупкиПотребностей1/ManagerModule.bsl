Процедура ЗаписатьПараметрыЗакупкиПроектовСПЗПользователя(Пользователь, ТаблицаДанных) Экспорт
	
	НастройкиПараметровЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
	
	// 
	ТаблицаДанных2 = ТаблицаДанных.Скопировать(, "АналитикаНоменклатуры, АналитикаПотребностей, АналитикаСтруктуры, УИДУсловия, ПоложениеОЗакупках, Результат, НомерСтроки, ПериодПотребности, ДатаОперации, ПериодЗакупки");
	
	// Добавляем недостающие колонки
	ТаблицаДанных2.Колонки.Добавить("ФлагиВозможностиИзменения", ОбщегоНазначения.ОписаниеТипаЧисло(10,0, ДопустимыйЗнак.Любой));
	ТаблицаДанных2.Колонки.Добавить("КлючПараметровЗакупки", Новый ОписаниеТипов("СправочникСсылка.КлючиПараметровЗакупки"));
	Для Каждого Параметр Из НастройкиПараметровЗакупки Цикл
		ТаблицаДанных2.Колонки.Добавить(Параметр.ПараметрИмя, Параметр.ТипЗначения);
		ТаблицаДанных2.Колонки.Добавить("ЗапретИзменения_"+Параметр.ПараметрИмя, Новый ОписаниеТипов("Булево"));
	КонецЦикла;
	
	//
	Для каждого СтрокаДанных Из ТаблицаДанных2 Цикл
		
		СтрокаДанных.ФлагиВозможностиИзменения = 0 ;
		Для Каждого Параметр Из НастройкиПараметровЗакупки Цикл
			
			Инфо = СтрокаДанных.Результат[Параметр.Параметр];
			Если Инфо = неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			//
			СтрокаДанных[Параметр.ПараметрИмя] = Инфо.Значение;
			СтрокаДанных["ЗапретИзменения_"+Параметр.ПараметрИмя] = Инфо.ЗапретИзменения;
			СтрокаДанных.ФлагиВозможностиИзменения = УстановитьБит(СтрокаДанных.ФлагиВозможностиИзменения, Параметр.ПараметрНомер-НастройкиПараметровЗакупки[0].ПараметрНомер, Инфо.ЗапретИзменения);
			
		КонецЦикла;
	
	КонецЦикла; 
	
	// КлючиАналитикиПланированияПотребностей
	ИменаПолей = РегистрыСведений.АналитикаПараметровЗакупки.ИменаПолейКоллекцииПоУмолчанию();
	ИменаПолей.АналитикаПараметровЗакупки = "КлючПараметровЗакупки";
	РегистрыСведений.АналитикаПараметровЗакупки.ЗаполнитьВКоллекции(ТаблицаДанных2, ИменаПолей);
	
	// Записываем
	ТаблицаДанных2.Колонки.Добавить("Автор", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	
	ТаблицаДанных2.ЗаполнитьЗначения(Пользователь, "Автор");  
	
	НЗ = РегистрыСведений.ПараметрыЗакупкиПотребностей1.СоздатьНаборЗаписей(); 
	ТаблицаЭталон = НЗ.Выгрузить();
	
	Колонки = Новый Массив;
	Удалить = Новый Массив;
	Для Каждого Колонка Из ТаблицаДанных2.Колонки Цикл  
		Если ТаблицаЭталон.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Удалить.Добавить(Колонка.Имя);
		Иначе
			Колонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;   
	Для Каждого ИмяКолонки Из Удалить Цикл    
		ТаблицаДанных2.Колонки.Удалить(ИмяКолонки);	
	КонецЦикла;
	ТаблицаДанных2.Свернуть(СтрСоединить(Колонки, ", "));
	
	//
	нз.Отбор.Автор.Установить(Пользователь);
	нз.Прочитать();
	нз.Очистить();
	НЗ.Загрузить(ТаблицаДанных2); 
	
	НЗ.Записать(Истина);
	
КонецПроцедуры   

