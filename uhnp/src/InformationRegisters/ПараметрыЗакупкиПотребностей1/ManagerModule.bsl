	ОбщегоНазначенияУХ.ЗагрузитьТаблицуВоВременнуюТаблицуЗапроса(Запрос, "ПараметрыПоложений", ТаблицаДанных2.Скопировать(, "УИДУсловия, ПоложениеОЗакупках, ПустойУИД")); 
