Функция ПолучитьТаблицуПотребностейДляПользователя(Пользователь)
	
	// 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Пользователь);
	Запрос.УстановитьПараметр("ПустойУИД", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("РазделятьПотребностиПоКатегорийнымМенеджерам",Ложь); 
	
	Запрос.Текст = ТекстЗапроса_ДанныеПотребностейПользователя()
		+ ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета()
		+ "ВЫБРАТЬ РАЗЛИЧНЫЕ
		  |	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
		  |	ВТ_Данные.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		  |	ВТ_Данные.Организация КАК Организация,
		  |	ВТ_Данные.ЦФО КАК ЦФО,
		  |	ВТ_Данные.Номенклатура КАК Номенклатура,
		  |	ВТ_Данные.Характеристика КАК Характеристика,
		  |	ВЫБОР
		  |		КОГДА ВТ_Данные.Номенклатура ССЫЛКА Справочник.Номенклатура
		  |			ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Номенклатура КАК Справочник.Номенклатура).ТоварнаяКатегория
		  |		КОГДА ВТ_Данные.Номенклатура ССЫЛКА Справочник.ТоварныеКатегории
		  |			ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Номенклатура КАК Справочник.ТоварныеКатегории)
		  |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
		  |	КОНЕЦ КАК ТоварнаяКатегория,
		  |	ВТ_Данные.Номенклатура.КодОКПД2 КАК ОКПД2,
		  |	ВТ_Данные.МестоПоставки КАК МестоПоставки,
		  |	ВТ_Данные.Приоритет КАК Приоритет,
		  |	ВТ_Данные.Проект КАК Проект,
		  |	ВТ_Данные.Менеджер КАК Менеджер,
		  |	ВТ_Данные.Назначение КАК Назначение,
		  |	ВТ_Данные.ДатаОперации КАК ДатаОперации,
		  |	Периоды.Ссылка КАК ПериодЗакупки,
		  |	ВТ_Данные.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		  |	ВТ_Данные.АналитикаПотребностей КАК АналитикаПотребностей,
		  |	ВТ_Данные.АналитикаСтруктуры КАК АналитикаСтруктуры
		  |ПОМЕСТИТЬ Перегруппировка
		  |ИЗ
		  |	ВТ_ДанныеПотребности КАК ВТ_Данные
		  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
		  |		ПО (Периоды.ДатаНачала <= ВТ_Данные.ДатаОперации)
		  |			И (Периоды.ДатаОкончания >= ВТ_Данные.ДатаОперации)
		  |			И (Периоды.Произвольный = ЛОЖЬ)
		  |			И (Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год))
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ
		  |	Перегруппировка.НомерСтроки - ВложенныйЗапрос.НомерСтрокиДельта + 1 КАК НомерСтроки,
		  |	Перегруппировка.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		  |	Перегруппировка.Организация КАК Организация,
		  |	Перегруппировка.ЦФО КАК ЦФО,
		  |	Перегруппировка.Номенклатура КАК Номенклатура,
		  |	Перегруппировка.Характеристика КАК Характеристика,
		  |	Перегруппировка.ТоварнаяКатегория КАК ТоварнаяКатегория,
		  |	Перегруппировка.ОКПД2 КАК ОКПД2,
		  |	Перегруппировка.МестоПоставки КАК МестоПоставки,
		  |	Перегруппировка.Приоритет КАК Приоритет,
		  |	Перегруппировка.Проект КАК Проект,
		  |	Перегруппировка.Менеджер КАК Менеджер,
		  |	Перегруппировка.Назначение КАК Назначение,
		  |	Перегруппировка.ДатаОперации КАК ДатаОперации,
		  |	Перегруппировка.ПериодЗакупки КАК ПериодЗакупки,
		  |	Перегруппировка.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		  |	Перегруппировка.АналитикаПотребностей КАК АналитикаПотребностей,
		  |	Перегруппировка.АналитикаСтруктуры КАК АналитикаСтруктуры
		  |ИЗ
		  |	Перегруппировка КАК Перегруппировка
		  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		  |			МИНИМУМ(Перегруппировка.НомерСтроки) КАК НомерСтрокиДельта
		  |		ИЗ
		  |			Перегруппировка КАК Перегруппировка) КАК ВложенныйЗапрос
		  |		ПО (ИСТИНА)";

		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТекстЗапроса_ДанныеПотребностейПользователя() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.ДатаОперации КАК ДатаОперации
	|ПОМЕСТИТЬ ДатыОперации
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей.Остатки(, АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ЗаявкиСогласованные)) КАК ПланированиеПотребностейОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Периоды.Ссылка КАК Период
	|ПОМЕСТИТЬ ВТ_ПериодыПотребности
	|ИЗ
	|	Справочник.Периоды КАК ПериодЗакупки,
	|	Константа.ПериодичностьЦентрализованныхЗакупок КАК ПериодичностьЦентрализованныхЗакупок
