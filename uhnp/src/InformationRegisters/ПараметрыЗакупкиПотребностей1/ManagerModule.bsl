Функция РассчитатьПараметрыЗакупкиПоПользователю(Пользователь, ПараметрыВыполнения = Неопределено) экспорт
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Новый Структура("Количество", 0);
	КонецЕсли;
	
	//
	ТаблицаДанных = ПолучитьТаблицуПотребностейДляПользователя(Пользователь);   
	ТаблицаДанных.Колонки.Добавить("ПериодПотребности", Новый ОписаниеТипов("СправочникСсылка.Периоды"));     
	УстановитьНомерСтрокиТаблица(ТаблицаДанных);          
	
	Если ПараметрыВыполнения <> Неопределено Тогда
		ПериодПотребностей = ПараметрыВыполнения.ПериодПотребностей;
	Иначе
		ПериодПотребностей = Неопределено;
	КонецЕсли;

	Если ТаблицаДанных.Количество() = 0 Тогда
		ОчиститьРезультатыРасчетаПараметровЗакупкиПользователя(Пользователь);
	Иначе
		ЗаполнитьПараметрыЗакупкиПользователя(ТаблицаДанных, ПериодПотребностей);
		
		ПотребностиУХ.ВыполнитьКлючеваниеКоллекцииПотребностей(ТаблицаДанных); 
		
		ПериодичностьЗакупокГод = Константы.ПериодичностьЦентрализованныхЗакупок.Получить();
        СоответствиеПериодов = Новый Соответствие;
		Для Каждого ПараметрыПотребности Из ТаблицаДанных Цикл 
			ПериодЗакупкиПотребности = СоответствиеПериодов.Получить(ПараметрыПотребности.ДатаОперации); 
			Если ПериодЗакупкиПотребности = Неопределено Тогда
				ПериодЗакупкиПотребности = ОбщегоНазначенияУХ.ПолучитьПериодПоДате(ПараметрыПотребности.ДатаОперации, 
																					ПериодичностьЗакупокГод);   
				СоответствиеПериодов.Вставить(ПараметрыПотребности.ДатаОперации, ПериодЗакупкиПотребности);
			КонецЕсли;																		
			ПараметрыПотребности.ПериодПотребности = ПериодЗакупкиПотребности; 
		КонецЦикла;
		
		ЗаписатьПараметрыЗакупкиПроектовСПЗПользователя(Пользователь, ТаблицаДанных);
	КонецЕсли;
	
	Возврат Новый Структура("Количество", ТаблицаДанных.Количество());
	
КонецФункции

Процедура УстановитьНомерСтрокиТаблица(Знач ТаблицаДанных)
	
	Перем СтрокаДанных, Счетчик;
	
	Счетчик = 0;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл 
		Счетчик = Счетчик + 1;
		СтрокаДанных.НомерСтроки = Счетчик; 
	КонецЦикла;

КонецПроцедуры


// Функция дополняет таблицу значений ТаблицаПотребностей параметрами закупки по положениям о закупках
// Добавляемые колонки:
//		ПоложениеОЗакупках - - ИспользованноеПоложениеОЗакупках
//		УИДУсловия	- УникальныйИдентификатор - - ИД условия из положения о закупках
//		Результат - Соответствие - в котором ключ это ПВХ.ПараметрыЗакупки, а значение это структура("Значение, ЗапретИзменения", Характеритика.ПараметрыЗакупки, Булево)
// Параметры:
//  ПериодЗакупки 			- СправочникСсылка.Периоды - Период закупки
//  ТаблицаПотребностей		- ТаблицаЗначений - Таблица с потребностями и следующими колонками
// 		Колонки:
//			ОрганизацияЗаказчик,
//			Организация,
//			Номенклатура,
//			Характеристика,
//			ТоварнаяКатегория,
//			ОКПД2,
//			МестоПоставки,
//			Приоритет,
//			Проект,
//			Менеджер,
//			Назначение (ДоговорСПокупателем)
//
// Возвращаемое значение:
//   Булево   - Истина, если выполнилось
//	
Функция ДополнитьТаблицуПотребностейПараметрамиЗакупки(ТаблицаПотребностей) экспорт
	
	Если НЕ ЗначениеЗаполнено(ТаблицаПотребностей) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//
	ЗаполнитьПараметрыЗакупкиПользователя(ТаблицаПотребностей);
	
	Возврат Истина;
	
КонецФункции

