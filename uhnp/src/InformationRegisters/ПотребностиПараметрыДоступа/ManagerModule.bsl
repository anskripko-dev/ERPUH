#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс
	
Процедура РассчитатьПараметрыДоступаПользователяКПотребностям(Пользователь) экспорт
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПолномочияКатегорийныхМенеджеров.Менеджер КАК Автор,
	|	ПолномочияКатегорийныхМенеджеров.Организация.ЗакупкаПоФЗ223 КАК Субъект223ФЗ,
	|	ПолномочияКатегорийныхМенеджеров.Организация КАК ОрганизацияЗаказчик,
	|	ПолномочияКатегорийныхМенеджеров.ТоварнаяКатегория КАК Объект
	|ИЗ
	|	РегистрСведений.ПолномочияКатегорийныхМенеджеров КАК ПолномочияКатегорийныхМенеджеров
	|ГДЕ
	|	ПолномочияКатегорийныхМенеджеров.Менеджер = &Пользователь
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&Пользователь,
	|	Организации.ЗакупкаПоФЗ223,
	|	Организации.Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И Организации.ОбособленноеПодразделение = ЛОЖЬ";
	
	НаборЗаписей = РегистрыСведений.ПотребностиПараметрыДоступа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Автор.Установить(Пользователь);
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры
	
#КонецОбласти

