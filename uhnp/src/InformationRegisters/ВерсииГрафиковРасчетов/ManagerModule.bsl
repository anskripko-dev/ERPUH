
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
		  
#Область ПрограммныйИнтерфейс

Функция ПолучитьАктуальнуюВерсиюФинансовогоИнструмента(ПредметГрафика, 
			ДатаАктуальности = Неопределено, Организация = Неопределено, ОпорныйГрафик = Ложь) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииГрафиковРасчетовСрезПоследних.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
	|			&Период,
	|			ПредметГрафика = &ПредметГрафика
	|				И Организация = &Организация
	|				И ИСТИНА) КАК ВерсииГрафиковРасчетовСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВерсииГрафиковРасчетовСрезПоследних.Период УБЫВ");
	
	Запрос.УстановитьПараметр("ПредметГрафика",	ПредметГрафика);
	Запрос.УстановитьПараметр("Период",			ДатаАктуальности);	
	Запрос.УстановитьПараметр("Организация",	?(Организация = Неопределено, ПредметГрафика.Организация, Организация));
	
	Если ОпорныйГрафик Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "ОпорныйГрафик");
	КонецЕсли;      
	
	ЭтоДоговор = ТипЗнч(ПредметГрафика) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
	             ИЛИ ТипЗнч(ПредметГрафика) = Тип("СправочникСсылка.ДоговорыКредитовИДепозитов")
	             ИЛИ ТипЗнч(ПредметГрафика) = Тип("СправочникСсылка.ДоговорыАренды");
	                              
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	
		
		Если ЭтоДоговор Тогда
			АктуальнаяВерсияСоглашения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредметГрафика, "ВерсияСоглашения");
			Если ЗначениеЗаполнено(АктуальнаяВерсияСоглашения) Тогда
				Возврат АктуальнаяВерсияСоглашения;  
			Иначе
				Возврат Неопределено;
			КонецЕсли;
		Иначе	
			Возврат Неопределено;  
		КонецЕсли;
		
	Иначе 
		Возврат РезультатЗапроса.Выгрузить()[0].Регистратор;	
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли