#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиОбновления

Процедура ПервоначальноеЗаполнение() Экспорт
	
	ПараметрыЦЗ = ВстраиваниеОПК.ПараметрыЦентрализованныхЗакупок();
	Если НЕ ПараметрыЦЗ.Использовать И НЕ ЗначениеЗаполнено(ПараметрыЦЗ.Периодичность) Тогда
		ПараметрыЦЗ.Периодичность = Перечисления.Периодичность.Месяц;
	КонецЕсли;
	
	// Заполнить РегистрСведений.ПараметрыОперативногоПланирования
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоТекущегоГода", НачалоГода(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ИспользоватьЦЗ", ПараметрыЦЗ.Использовать);
	Запрос.УстановитьПараметр("ПериодичностьЦЗ", ПараметрыЦЗ.Периодичность);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц) КАК ПериодичностьОперативногоПланирования
	|ПОМЕСТИТЬ ВТ_ЗначенияПоУмолчанию
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗначенияПоУмолчанию.ВидБюджета КАК ВидБюджета,
	|	ВТ_ЗначенияПоУмолчанию.ПериодичностьОперативногоПланирования КАК ПериодичностьОперативногоПланирования
	|ИЗ
	|	ВТ_ЗначенияПоУмолчанию КАК ВТ_ЗначенияПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УдалитьПараметрыОперативногоПланирования КАК ПараметрыОперативногоПланирования
	|		ПО ВТ_ЗначенияПоУмолчанию.ВидБюджета = ПараметрыОперативногоПланирования.УдалитьВидБюджета
	|ГДЕ
	|	ПараметрыОперативногоПланирования.УдалитьВидБюджета ЕСТЬ NULL";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.УдалитьПараметрыОперативногоПланирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидБюджета.Установить(Выборка.ВидБюджета);
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей,,, Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

#КонецОбласти

#КонецЕсли 