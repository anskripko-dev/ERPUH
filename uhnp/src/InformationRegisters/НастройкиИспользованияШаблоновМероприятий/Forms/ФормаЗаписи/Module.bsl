// Считывает из базы данных расписание по текущим измерениям.
&НаСервере
Процедура СчитатьРасписаниеЗаписи()
	АдресРасписания = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст КАК Контекст,
		|	НастройкиИспользованияШаблоновМероприятий.ШаблонМероприятия КАК ШаблонМероприятия,
		|	НастройкиИспользованияШаблоновМероприятий.РасписаниеПовторения КАК РасписаниеПовторения
		|ИЗ
		|	РегистрСведений.НастройкиИспользованияШаблоновМероприятий КАК НастройкиИспользованияШаблоновМероприятий
		|ГДЕ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст = &Контекст
		|	И НастройкиИспользованияШаблоновМероприятий.ШаблонМероприятия = &ШаблонМероприятия";
	Запрос.УстановитьПараметр("Контекст", Запись.Контекст);
	Запрос.УстановитьПараметр("ШаблонМероприятия", Запись.ШаблонМероприятия);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РасписаниеХранилищеЗначения = ВыборкаДетальныеЗаписи.РасписаниеПовторения;
		РасписаниеЗначение = РасписаниеХранилищеЗначения.Получить();
		АдресРасписания = ПоместитьВоВременноеХранилище(РасписаниеЗначение, ЭтаФорма);
	КонецЦикла;
КонецПроцедуры		// СчитатьРасписаниеЗаписи()	

// Выводит на форму текстовое представление текущего расписания.
&НаСервере
Процедура ВывестиПредставлениеРасписания()
	Если ЭтоАдресВременногоХранилища(АдресРасписания) Тогда
		РасписаниеЗначение = ПолучитьИзВременногоХранилища(АдресРасписания);
		Если ТипЗнч(РасписаниеЗначение) = Тип("РасписаниеРегламентногоЗадания") Тогда
			ПредставлениеРасписания = Строка(РасписаниеЗначение);
		Иначе
			ПредставлениеРасписания = "";
		КонецЕсли;
	Иначе
		ПредставлениеРасписания = "";
	КонецЕсли;	
КонецПроцедуры		// ВывестиПредставлениеРасписания()

// Управляет доступностью элементов на форме.
&НаСервере
Процедура УправлениеДоступностью()
	Элементы.ОткрытьРасписание.Доступность = Запись.ИспользоватьРасписание;
	ЭтоКонтекстРиск = (ТипЗнч(Запись.Контекст) = Тип("СправочникСсылка.Риски"));
	Элементы.ВидМероприятия.Доступность = ЭтоКонтекстРиск;
	ЭтоВидМероприятияКонтрольнаяПроцедура = (Запись.ВидМероприятия = Перечисления.ВидыМероприятий.КонтрольноеМероприятие);
	Элементы.ГруппаРасписание.Видимость = ((ЭтоВидМероприятияКонтрольнаяПроцедура) И (ЭтоКонтекстРиск));
КонецПроцедуры		// УправлениеДоступностью()	
	
&НаКлиенте
Процедура РедактированиеРасписания_Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение <> Неопределено Тогда
		АдресРасписания = ПоместитьВоВременноеХранилище(ВыбранноеЗначение, ЭтаФорма.УникальныйИдентификатор);
		ВывестиПредставлениеРасписания();
	Иначе
		// Значение не выбрано. Не изменяем расписание.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасписание(Команда)
	РасписаниеЗначение = Новый РасписаниеРегламентногоЗадания;
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗначение);
	Если ЭтоАдресВременногоХранилища(АдресРасписания) Тогда
		РасписаниеЗначение = ПолучитьИзВременногоХранилища(АдресРасписания);
		Если ТипЗнч(РасписаниеЗначение) = Тип("РасписаниеРегламентногоЗадания") Тогда
			Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗначение);
		Иначе
			РасписаниеЗначение = Новый РасписаниеРегламентногоЗадания;
			Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗначение);
		КонецЕсли;
	Иначе
		РасписаниеЗначение = Новый РасписаниеРегламентногоЗадания;
		Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗначение);
	КонецЕсли;	
	// Отображение полученного расписания в диалоге.
	ПараметрыОповещения = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("РедактированиеРасписания_Завершение", ЭтаФорма, ПараметрыОповещения);
	Диалог.Показать(ОписаниеОповещения);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СчитатьРасписаниеЗаписи();
	ВывестиПредставлениеРасписания();
	УправлениеДоступностью();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЭтоАдресВременногоХранилища(АдресРасписания) Тогда
		РасписаниеЗначение = ПолучитьИзВременногоХранилища(АдресРасписания);
		ТекущийОбъект.РасписаниеПовторения = Новый ХранилищеЗначения(РасписаниеЗначение);
	Иначе
		ТекущийОбъект.РасписаниеПовторения = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьРасписаниеПриИзменении(Элемент)
	УправлениеДоступностью();
КонецПроцедуры

&НаКлиенте
Процедура ШаблонМероприятияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы 					  = Новый Структура;
	СтруктураОтбора 				  = Новый Структура;
	ИмяСправочникаЗакупочныеПроцедуры =	"СправочникСсылка.ЗакупочныеПроцедуры";
	ИмяСправочникаЦели = "СправочникСсылка.Цели";
	ИмяПеречисленияСпособыВыбораПоставщика = "ПеречислениеСсылка.СпособыВыбораПоставщика";
	Если ТипЗнч(Запись.Контекст) = Тип("СправочникСсылка.Риски") Тогда
		// Риски.
		СтруктураОтбора.Вставить("ВидМероприятия", Запись.ВидМероприятия);
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.ШаблоныМероприятий.ФормаВыбора", ПараметрыФормы, Элементы.ШаблонМероприятия);
	ИначеЕсли ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПодсистемыУХ.ЦентрализованныеЗакупки")
				И (ТипЗнч(Запись.Контекст) = Тип(ИмяСправочникаЗакупочныеПроцедуры)) ИЛИ (ТипЗнч(Запись.Контекст) = Тип(ИмяПеречисленияСпособыВыбораПоставщика)) Тогда
		// Закупочные процедуры.
		СтруктураОтбора.Вставить("ВидМероприятия", ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.ЗакупочнаяПроцедура"));
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.ШаблоныМероприятий.ФормаВыбора", ПараметрыФормы, Элементы.ШаблонМероприятия);
	ИначеЕсли ТипЗнч(Запись.Контекст) = Тип(ИмяСправочникаЦели) Тогда
		// Цели.
		СтруктураОтбора.Вставить("ВидМероприятия", ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.Инициатива"));
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		ОткрытьФорму("Справочник.ШаблоныМероприятий.ФормаВыбора", ПараметрыФормы, Элементы.ШаблонМероприятия);
	Иначе
		// Неизвестный вариант. Без отбора.
		СтандартнаяОбработка = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтекстПриИзменении(Элемент)
	ТекКонтекст = Запись.Контекст;
	ИмяСправочникаЗакупочныеПроцедуры 		= "СправочникСсылка.ЗакупочныеПроцедуры";
	ИмяПеречисленияСпособыВыбораПоставщика 	= "ПеречислениеСсылка.СпособыВыбораПоставщика";
	ИмяСправочникаЦели = "СправочникСсылка.Цели";
	Если  ТипЗнч(ТекКонтекст) = Тип(ИмяСправочникаЦели) Тогда
		Запись.ВидМероприятия = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.Инициатива");
	ИначеЕсли  ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПодсистемыУХ.ЦентрализованныеЗакупки")  
				И ТипЗнч(ТекКонтекст) = Тип(ИмяСправочникаЗакупочныеПроцедуры) Тогда
		Запись.ВидМероприятия = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.ЗакупочнаяПроцедура");
	ИначеЕсли  ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПодсистемыУХ.ЦентрализованныеЗакупки")
				И ТипЗнч(ТекКонтекст) = Тип(ИмяПеречисленияСпособыВыбораПоставщика) Тогда
		Запись.ВидМероприятия = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.ЗакупочнаяПроцедура");
	ИначеЕсли ТипЗнч(ТекКонтекст) = Тип("СправочникСсылка.Риски") Тогда
		ВидыМероприятийРисков = Новый Массив;
		ВидыМероприятийРисков.Добавить(ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.КонтрольноеМероприятие"));
		ВидыМероприятийРисков.Добавить(ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыМероприятий.РеакцияНаРиск"));
		Если ВидыМероприятийРисков.Найти(Запись.ВидМероприятия) = Неопределено Тогда
			Запись.ВидМероприятия = ПредопределенноеЗначение("Перечисление.ВидыМероприятий.ПустаяСсылка");
		Иначе
			// Оставляем прежнее значение вида мероприятия.
		КонецЕсли;	
	Иначе
		ТекстСообщения = НСтр("ru = 'Неизвестный вариант контекста %Контекст%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Контекст%", Строка(ТекКонтекст));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	УправлениеДоступностью();
КонецПроцедуры

&НаКлиенте
Процедура ВидМероприятияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если ТипЗнч(Запись.Контекст) = Тип("СправочникСсылка.Риски") Тогда
		// Ограничим доступные значения.
		СтандартнаяОбработка = Ложь;
		НовыйСписокВыбора = Новый Массив;
		НовыйСписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыМероприятий.КонтрольноеМероприятие"));
		НовыйСписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыМероприятий.РеакцияНаРиск"));
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(НовыйСписокВыбора);
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидМероприятияПриИзменении(Элемент)
	УправлениеДоступностью();
КонецПроцедуры
