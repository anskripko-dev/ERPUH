#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Возвращает основной шаблон мероприятия, сопоставленный
// для контекста КонтекстВход по виду мероприятия ВидМероприятияВход.
Функция ПолучитьОсновнойШаблонПоКонтексту(КонтекстВход, ВидМероприятияВход = Неопределено) Экспорт
	РезультатФункции = Справочники.ШаблоныМероприятий.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст КАК Контекст,
		|	НастройкиИспользованияШаблоновМероприятий.ШаблонМероприятия КАК ШаблонМероприятия,
		|	НастройкиИспользованияШаблоновМероприятий.НазначенОсновным КАК НазначенОсновным
		|ИЗ
		|	РегистрСведений.НастройкиИспользованияШаблоновМероприятий КАК НастройкиИспользованияШаблоновМероприятий
		|ГДЕ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст = &Контекст
		|	И НастройкиИспользованияШаблоновМероприятий.НазначенОсновным
		|	И ВЫБОР
		|			КОГДА &ВидМероприятия = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ НастройкиИспользованияШаблоновМероприятий.ВидМероприятия = &ВидМероприятия
		|		КОНЕЦ";
	ВидМероприятияРабочий = Неопределено;
	Если ЗначениеЗаполнено(ВидМероприятияВход) Тогда
		ВидМероприятияРабочий = ВидМероприятияВход;
	Иначе
		ВидМероприятияРабочий = Неопределено;
	КонецЕсли;	
	Запрос.УстановитьПараметр("ВидМероприятия", ВидМероприятияРабочий);
	Запрос.УстановитьПараметр("Контекст", КонтекстВход);
	РезультатЗапроса = Запрос.Выполнить();
	Выгрузка = РезультатЗапроса.Выгрузить();
	Если Выгрузка.Количество() = 1 Тогда
		ПерваяСтрока = Выгрузка[0];
		РезультатФункции = ПерваяСтрока.ШаблонМероприятия;
	Иначе
		РезультатФункции = Справочники.ШаблоныМероприятий.ПустаяСсылка();
	КонецЕсли;	
	Возврат РезультатФункции;
КонецФункции		// ПолучитьОсновнойШаблонПоКонтексту()	

// Устанавливает основным шаблон мероприятия ШаблонМероприятияВход для контекста
// КонтекстВход по виду мероприятия ВидМероприятияВход. Возвращает успешность операции.
Функция УстановитьШаблонОсновным(КонтекстВход, ВидМероприятияВход, ШаблонМероприятияВход) Экспорт
	РезультатФункции = Истина;
	НачатьТранзакцию();
	ЕстьОшибки = Ложь;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст КАК Контекст,
		|	НастройкиИспользованияШаблоновМероприятий.ВидМероприятия КАК ВидМероприятия,
		|	НастройкиИспользованияШаблоновМероприятий.ШаблонМероприятия КАК ШаблонМероприятия,
		|	НастройкиИспользованияШаблоновМероприятий.НазначенОсновным КАК НазначенОсновным
		|ИЗ
		|	РегистрСведений.НастройкиИспользованияШаблоновМероприятий КАК НастройкиИспользованияШаблоновМероприятий
		|ГДЕ
		|	НастройкиИспользованияШаблоновМероприятий.Контекст = &Контекст
		|	И НастройкиИспользованияШаблоновМероприятий.ВидМероприятия = &ВидМероприятия
		|	И НастройкиИспользованияШаблоновМероприятий.ШаблонМероприятия = &ШаблонМероприятия";
		Запрос.УстановитьПараметр("ВидМероприятия", ВидМероприятияВход);
		Запрос.УстановитьПараметр("Контекст", КонтекстВход);
		Запрос.УстановитьПараметр("ШаблонМероприятия", ШаблонМероприятияВход);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				НаборЗаписей = РегистрыСведений.НастройкиИспользованияШаблоновМероприятий.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Контекст.Установить(Выборка.Контекст);
				НаборЗаписей.Отбор.ВидМероприятия.Установить(Выборка.ВидМероприятия);
				НаборЗаписей.Отбор.ШаблонМероприятия.Установить(Выборка.ШаблонМероприятия);
				НаборЗаписей.Прочитать();
				Для Каждого ТекНаборЗаписей Из НаборЗаписей Цикл
					ТекНаборЗаписей.НазначенОсновным = Истина;
				КонецЦикла;	
				НаборЗаписей.Записать();
			КонецЦикла;	
		Иначе
			НаборЗаписей = РегистрыСведений.НастройкиИспользованияШаблоновМероприятий.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Контекст.Установить(КонтекстВход);
			НаборЗаписей.Отбор.ВидМероприятия.Установить(ВидМероприятияВход);
			НаборЗаписей.Отбор.ШаблонМероприятия.Установить(ШаблонМероприятияВход);
			ТекНаборЗаписей = НаборЗаписей.Добавить();
			ТекНаборЗаписей.Контекст			 = КонтекстВход;
			ТекНаборЗаписей.ВидМероприятия		 = ВидМероприятияВход;
			ТекНаборЗаписей.ШаблонМероприятия	 = ШаблонМероприятияВход;
			ТекНаборЗаписей.НазначенОсновным	 = Истина;
			НаборЗаписей.Записать();
		КонецЕсли;	
	Исключение
		ТекстСообщения = НСтр("ru = 'При установке шаблона %Шаблон% основным для контекста %Контекст% возникли ошибки: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Шаблон%", Строка(ШаблонМероприятияВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Контекст%", Строка(КонтекстВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, ЕстьОшибки);
	КонецПопытки;
	Если НЕ ЕстьОшибки Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		// УстановитьШаблонОсновным() 	

// Устанавливает/снимает шаблону мероприятия ШаблонМероприятияВход признак 
// основного по контексту КонтекстВход и виду мероприятия ВидМероприятияВход
// в зависимости от значения ОтметкаВход. 
Функция ИзменитьОтметкуОсновногоШаблона(КонтекстВход, ВидМероприятияВход, ШаблонМероприятияВход, ОтметкаВход) Экспорт
	Если ОтметкаВход Тогда
		РегистрыСведений.НастройкиИспользованияШаблоновМероприятий.УстановитьШаблонОсновным(КонтекстВход, ВидМероприятияВход, ШаблонМероприятияВход); 
	Иначе	
		НаборЗаписей = РегистрыСведений.НастройкиИспользованияШаблоновМероприятий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контекст.Установить(КонтекстВход);
		НаборЗаписей.Отбор.ВидМероприятия.Установить(ВидМероприятияВход);
		НаборЗаписей.Отбор.ШаблонМероприятия.Установить(ШаблонМероприятияВход);
		НаборЗаписей.Прочитать();
		Для Каждого ТекНаборЗаписей Из НаборЗаписей Цикл
			ТекНаборЗаписей.НазначенОсновным = Ложь;
		КонецЦикла;	
		НаборЗаписей.Записать();
	КонецЕсли;
КонецФункции		// ИзменитьОтметкуОсновногоШаблона()

#КонецЕсли