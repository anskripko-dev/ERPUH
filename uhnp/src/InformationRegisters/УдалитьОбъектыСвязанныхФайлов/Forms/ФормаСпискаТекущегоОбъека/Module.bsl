
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.Элементы[0].Значение=Параметры.Отбор.ИмпортированныйОбъект;
	Список.Параметры.Элементы[0].Использование=Истина;
	
	ПапкаПоУмолчанию=Справочники.ПапкиФайлов.НайтиПоНаименованию("НЕ УДАЛЯТЬ Данные вложенных файлов");
	Если ПапкаПоУмолчанию=Справочники.ПапкиФайлов.ПустаяСсылка() Тогда
	КонецЕсли;
	
	ТекущийЭлементССылка=Параметры.Отбор.ИмпортированныйОбъект; 	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьФайлСДиска(Команда)
	
	//ЗначениеПараметраКД = Список.Параметры.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Владелец"));
	//Если ЗначениеПараметраКД = Неопределено Тогда
		ВладелецФайла = ПапкаПоУмолчанию;
	//Иначе
	//	ВладелецФайла = ЗначениеПараметраКД.Значение;
	//КонецЕсли;
	
	ПараметрыДобавления = Новый Структура;
	ПараметрыДобавления.Вставить("ОбработчикРезультата", Неопределено);
	ПараметрыДобавления.Вставить("ВладелецФайла", ВладелецФайла);
	ПараметрыДобавления.Вставить("ФормаВладелец", ЭтотОбъект);
	ПараметрыДобавления.Вставить("НеОткрыватьКарточкуПослеСозданияИзФайла", Неопределено);
	
	Результат=РаботаСФайламиСлужебныйКлиент.ДобавитьИзФайловойСистемыСРасширениемСинхронно(ПараметрыДобавления);
	Если Результат.ФайлДобавлен Тогда
		 ДобавитьТекЗапись(Результат.ФайлСсылка);	
	КонецЕсли;

КонецПроцедуры

