
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция УстановитьРК(ДокументСсылка) Экспорт

	мз = СоздатьМенеджерЗаписи();
	мз.ДокументИсточник = ДокументСсылка;
	мз.Прочитать();
	
	Если мз.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;       
	
	мз.ДокументИсточник = ДокументСсылка;
	мз.Записать();
	
	Возврат Истина;
	
КонецФункции

Функция УдалитьРК(ДокументСсылка) Экспорт

	Выборка = Выбрать(Новый Структура("ДокументИсточник", ДокументСсылка));
	Пока Выборка.Следующий() Цикл
		Выборка.ПолучитьМенеджерЗаписи().Удалить();			
	КонецЦикла;
	
КонецФункции

Функция ЕстьРК(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Выбрать(Новый Структура("ДокументИсточник", ДокументСсылка));
	Возврат Выборка.Следующий();

КонецФункции

