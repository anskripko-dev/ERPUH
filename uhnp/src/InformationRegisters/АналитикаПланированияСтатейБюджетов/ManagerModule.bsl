#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	СтруктураАналитики = Новый Структура("СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, ПриходРасход");
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики);
	Если НЕ ЗначениеЗаполнено(СтруктураАналитики.СтатьяБюджета)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика1)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика2) 
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика3)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика4)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика5)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.Аналитика6)
	 И НЕ ЗначениеЗаполнено(СтруктураАналитики.ПриходРасход) Тогда
		Возврат Неопределено
	Иначе
		НаборЗаписей = РегистрыСведений.АналитикаПланированияСтатейБюджетов.СоздатьНаборЗаписей();
		
		Для Каждого КлючЗначение Из СтруктураАналитики Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, "СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, ПриходРасход");
		//ПроверитьЗаполнениеПоляСтатьяБюджета(НоваяСтрока);
		Возврат НаборЗаписей;
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьЗаполнениеПоляСтатьяБюджета(МенеджерЗаписиАналитикаПланированияСтатейБюджетов)

	Если МенеджерЗаписиАналитикаПланированияСтатейБюджетов.СтатьяБюджета = Неопределено 
		Тогда
		ВызватьИсключение НСтр("ru = 'Ошибочное значение параметра ""Статья бюджета""'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Коллекция.НомерСтроки - 1 КАК Индекс,
		|	&ПолеАналитикаПланирования КАК АналитикаПланированияСтатейБюджетов,
		|	&ПолеСтатьяБюджета КАК СтатьяБюджета,
		|	&ПолеАналитика1 КАК Аналитика1,
		|	&ПолеАналитика2 КАК Аналитика2,
		|	&ПолеАналитика3 КАК Аналитика3,
		|	&ПолеАналитика4 КАК Аналитика4,
		|	&ПолеАналитика5 КАК Аналитика5,
		|	&ПолеАналитика6 КАК Аналитика6,
		|	&ПолеПриходРасход КАК ПриходРасход
		|
		|ПОМЕСТИТЬ Коллекция
		|ИЗ &Коллекция КАК Коллекция;
		|
		|ВЫБРАТЬ
		|	Коллекция.Индекс,
		|	Аналитика.КлючАналитики КАК АналитикаПланированияСтатейБюджетов,
		|	Коллекция.СтатьяБюджета,
		|	Коллекция.Аналитика1,
		|	Коллекция.Аналитика2,
		|	Коллекция.Аналитика3,
		|	Коллекция.Аналитика4,
		|	Коллекция.Аналитика5,
		|	Коллекция.Аналитика6,
		|	Коллекция.ПриходРасход
		|ИЗ
		|	Коллекция КАК Коллекция
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК Аналитика
		|		ПО Аналитика.СтатьяБюджета = Коллекция.СтатьяБюджета
		|		И Аналитика.Аналитика1 = Коллекция.Аналитика1
		|		И Аналитика.Аналитика2 = Коллекция.Аналитика2
		|		И Аналитика.Аналитика3 = Коллекция.Аналитика3
		|		И Аналитика.Аналитика4 = Коллекция.Аналитика4
		|		И Аналитика.Аналитика5 = Коллекция.Аналитика5
		|		И Аналитика.Аналитика6 = Коллекция.Аналитика6
		|		И Аналитика.ПриходРасход = Коллекция.ПриходРасход
		|ГДЕ
		|	Аналитика.КлючАналитики ЕСТЬ NULL
		|	ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаПланированияСтатейБюджетов
		|	ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка)
		|";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПланирования", "Коллекция." + ИменаПолей.АналитикаПланированияСтатейБюджетов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтатьяБюджета", "Коллекция." + ИменаПолей.СтатьяБюджета);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика1", "Коллекция." + ИменаПолей.Аналитика1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика2", "Коллекция." + ИменаПолей.Аналитика2);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика3", "Коллекция." + ИменаПолей.Аналитика3);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика4", "Коллекция." + ИменаПолей.Аналитика4);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика5", "Коллекция." + ИменаПолей.Аналитика5);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика6", "Коллекция." + ИменаПолей.Аналитика6);
	
	// Поле ПриходРасход может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.ПриходРасход) Тогда
		Если ТипЗнч(ИменаПолей.ПриходРасход) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриходРасход", ИменаПолей.ПриходРасход.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриходРасход", "Коллекция." + ИменаПолей.ПриходРасход);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриходРасход", "ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)");
	КонецЕсли; 
	
	Возврат ТекстЗапроса;    
	
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Коллекция.НомерСтроки - 1 КАК Индекс,
		|	&ПолеАналитика            КАК АналитикаПланированияСтатейБюджетов,
		|	&ПолеПриемник             КАК АналитикаПланированияСтатейБюджетовПриемник,
		|	&ПолеСтатьяБюджета        КАК СтатьяБюджета,
		|	&ПолеАналитика1			  КАК Аналитика1,
		|	&ПолеАналитика2			  КАК Аналитика2,
		|	&ПолеАналитика3			  КАК Аналитика3,
		|	&ПолеАналитика4			  КАК Аналитика4,
		|	&ПолеАналитика5			  КАК Аналитика5,
		|	&ПолеАналитика6			  КАК Аналитика6,
		|	&ПолеПриходРасход		  КАК ПриходРасход
		|ПОМЕСТИТЬ ВтКоллекция
		|ИЗ &Коллекция КАК Коллекция
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс                       КАК Индекс,
		|	Коллекция.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов,
		|	Коллекция.АналитикаПланированияСтатейБюджетовПриемник КАК АналитикаПланированияСтатейБюджетовПриемник,
		|	ВЫБОР КОГДА Коллекция.СтатьяБюджета = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.СтатьяБюджета, неопределено)
		|		ИНАЧЕ Коллекция.СтатьяБюджета
		|	КОНЕЦ                                КАК СтатьяБюджета,
		|	ВЫБОР КОГДА Коллекция.Аналитика1 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика1, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика1
		|	КОНЕЦ                                КАК Аналитика1,
		|	ВЫБОР КОГДА Коллекция.Аналитика2 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика2, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика2
		|	КОНЕЦ                                КАК Аналитика2,
		|	ВЫБОР КОГДА Коллекция.Аналитика3 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика3, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика3
		|	КОНЕЦ                                КАК Аналитика3,
		|	ВЫБОР КОГДА Коллекция.Аналитика4 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика4, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика4
		|	КОНЕЦ                                КАК Аналитика4,
		|	ВЫБОР КОГДА Коллекция.Аналитика5 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика5, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика5
		|	КОНЕЦ                                КАК Аналитика5,
		|	ВЫБОР КОГДА Коллекция.Аналитика6 = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Аналитика6, неопределено)
		|		ИНАЧЕ Коллекция.Аналитика6
		|	КОНЕЦ                                КАК Аналитика6,
		|	Коллекция.ПриходРасход               КАК ПриходРасход
		|ПОМЕСТИТЬ Коллекция
		|ИЗ
		|	ВтКоллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК Аналитика
		|	ПО Коллекция.АналитикаПланированияСтатейБюджетов = Аналитика.КлючАналитики
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс КАК Индекс,
		|	Ключи.КлючАналитики КАК АналитикаПланированияСтатейБюджетов,
		|	Коллекция.СтатьяБюджета КАК СтатьяБюджета,
		|	Коллекция.Аналитика1 КАК Аналитика1,
		|	Коллекция.Аналитика2 КАК Аналитика2,
		|	Коллекция.Аналитика3 КАК Аналитика3,
		|	Коллекция.Аналитика4 КАК Аналитика4,
		|	Коллекция.Аналитика5 КАК Аналитика5,
		|	Коллекция.Аналитика6 КАК Аналитика6,
		|	Коллекция.ПриходРасход КАК ПриходРасход
		|ИЗ
		|	Коллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияСтатейБюджетов КАК Ключи
		|	ПО Ключи.СтатьяБюджета = Коллекция.СтатьяБюджета
		|		И Ключи.Аналитика1 = Коллекция.Аналитика1
		|		И Ключи.Аналитика2 = Коллекция.Аналитика2
		|		И Ключи.Аналитика3 = Коллекция.Аналитика3
		|		И Ключи.Аналитика4 = Коллекция.Аналитика4
		|		И Ключи.Аналитика5 = Коллекция.Аналитика5
		|		И Ключи.Аналитика6 = Коллекция.Аналитика6
		|		И Ключи.ПриходРасход = Коллекция.ПриходРасход
		|ГДЕ
		|	Ключи.КлючАналитики ЕСТЬ NULL
		|	ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаПланированияСтатейБюджетов
		|	ИЛИ Коллекция.АналитикаПланированияСтатейБюджетовПриемник = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка)
		|";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаПланированияСтатейБюджетов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаПланированияСтатейБюджетов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтатьяБюджета", ?(ЗначениеЗаполнено(ИменаПолей.СтатьяБюджета),"Коллекция." + ИменаПолей.СтатьяБюджета, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика1", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика1),"Коллекция." + ИменаПолей.Аналитика1, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика2", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика2),"Коллекция." + ИменаПолей.Аналитика2, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика3", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика3),"Коллекция." + ИменаПолей.Аналитика3, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика4", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика4),"Коллекция." + ИменаПолей.Аналитика4, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика5", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика5),"Коллекция." + ИменаПолей.Аналитика5, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика6", ?(ЗначениеЗаполнено(ИменаПолей.Аналитика6),"Коллекция." + ИменаПолей.Аналитика6, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриходРасход", ?(ЗначениеЗаполнено(ИменаПолей.ПриходРасход),"Коллекция." + ИменаПолей.ПриходРасход, "ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.ПустаяСсылка)"));
	
	Возврат ТекстЗапроса;
КонецФункции

