// Функция возвращает информацию о ключе
Функция ИнформацияОКлюче() Экспорт

	//
	Результат = Новый Структура;
	Результат.Вставить("СправочникИмя", "КлючиАналитикиПланированияСтатейБюджетов");
	Результат.Вставить("СправочникМенеджер", Справочники.КлючиАналитикиПланированияСтатейБюджетов);
	Результат.Вставить("СправочникМетаданные", Метаданные.Справочники.КлючиАналитикиПланированияСтатейБюджетов);
	Результат.Вставить("РегистрИмя", "АналитикаПланированияСтатейБюджетов");
	Результат.Вставить("РегистрМенеджер", РегистрыСведений.АналитикаПланированияСтатейБюджетов);
	Результат.Вставить("РегистрМетаданные", Метаданные.РегистрыСведений.АналитикаПланированияСтатейБюджетов);
	
	Результат.Вставить("ИмяПоляАналитика", "АналитикаПланированияСтатейБюджетов");
	
	КонтрольУХКлючи.ДобавитьИзмеренияКлюча(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи) Экспорт

	ЕстьАналитика = Истина;
	Если МенеджерЗаписи.Аналитика1 = неопределено
		И МенеджерЗаписи.Аналитика2 = неопределено
		И МенеджерЗаписи.Аналитика3 = неопределено
		И МенеджерЗаписи.Аналитика4 = неопределено
		И МенеджерЗаписи.Аналитика5 = неопределено
		И МенеджерЗаписи.Аналитика6 = неопределено Тогда
		ЕстьАналитика = Ложь;
	КонецЕсли;
	
	Имя = СокрЛП(МенеджерЗаписи.СтатьяБюджета);
	Если ЕстьАналитика Тогда
		Имя = Имя + " ("
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика1), СокрЛП(МенеджерЗаписи.Аналитика1), " - ") + "; "
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика2), СокрЛП(МенеджерЗаписи.Аналитика2), " - ") + "; "
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика3), СокрЛП(МенеджерЗаписи.Аналитика3), " - ") + "; "
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика4), СокрЛП(МенеджерЗаписи.Аналитика4), " - ") + "; "
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика5), СокрЛП(МенеджерЗаписи.Аналитика5), " - ") + "; "
			+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Аналитика6), СокрЛП(МенеджерЗаписи.Аналитика6), " - ") + ")";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МенеджерЗаписи.ПриходРасход) Тогда
		Имя = Имя + " " + СокрЛП(МенеджерЗаписи.ПриходРасход);
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

// Функция получает элемент справочника - ключ аналитики планирования статей бюджетов.
//
// Параметры:
//	ПараметрыАналитики - Выборка, Структура - Содержит полями "СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, ПриходРасход":
//		* СтатьяБюджета - СправочникСсылка.СтатьиДвиженияДенежныхСредств, СтатьиДоходовРасходов, СтатьиДвиженияРесурсов.
//		* Аналитика1-3 - ХарактеристикаСсылка.ВидыСубконтоКорпоративные.
//		* ПриходРасход - ПеречислениеСсылка.ВидыДвиженийПриходРасход
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияСтатьейБюджетов - Созданный элемент справочника.
//
Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

	НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0
			И Не ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			Результат = НаборЗаписей[0].КлючАналитики;
		Иначе
			Результат = СоздатьКлючАналитики(ПараметрыАналитики);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

КонецФункции

// Функция получает элемент справочника - ключ аналитики планирования.
//
// Параметры:
//	ПараметрыАналитики - Выборка или Структура  с полями "СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, ПриходРасход".
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияСтатейБюджетов - Созданный элемент справочника.
//
Функция СоздатьКлючАналитики(ПараметрыАналитики, ЗаписьПриОбновленииИБ = Ложь) Экспорт
	
	Возврат КонтрольУХКлючи.СоздатьКлючАналитики(ИнформацияОКлюче(), ПараметрыАналитики);
	
КонецФункции

// Заполняет поле АналитикаПланированияСтатейБюджетов в коллекции, содержащей статью бюджета, аналитику1-3, Направление.
//
// Параметры:
//
//	Коллекция - ТабличнаяЧасть - Коллекция, в которой производится заполнение аналитики планирования статей бюджетов.
//
//	ИменаПолей - Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля берется из имени ключа.
//		секция идентификации {СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, ПриходРасход, АналитикаПланированияСтатейБюджета},
//	
//	ПараметрыЗаполнения - Структура - см. метод КонтрольУХКлючи.ПараметрыЗаполненияКлючейАналитики()
//
// Пример 1:
//	ИменаПолей = РегистрыСведений.АналитикаПланированияСтатейБюджетов.ИменаПолейКоллекцииПоУмолчанию();
//	РегистрыСведений.АналитикаПланированияСтатейБюджетов.ЗаполнитьВКоллекции(ДвиженияОперации, ИменаПолей);
//
// Пример 2:
//	РегистрыСведений.АналитикаПланированияСтатейБюджетов.ЗаполнитьВКоллекции(ДвиженияОперации);
//
Процедура ЗаполнитьВКоллекции(Коллекция, 
								ИменаПолей = Неопределено, ДополнитьКлюч = Ложь, ПараметрыЗаполнения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = КонтрольУХКлючи.ПараметрыЗаполненияКлючейАналитики();
	КонецЕсли;
	
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.СтатьяБюджета, Метаданные.ПланыВидовХарактеристик.ВидыБюджетов.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика1, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика2, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика3, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика4, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика5, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.Аналитика6, Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные.Тип);
	КонтрольУХКлючи.ПривестиКолонкуКТипу(Коллекция, ИменаПолей.ПриходРасход, Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"));
	
	Если ДополнитьКлюч Тогда
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейДополненияКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
	Иначе
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		
		Если ЗначениеЗаполнено(ИменаПолей.ПриходРасход)
			И ТипЗнч(ИменаПолей.ПриходРасход) = Тип("Структура")
			И ИменаПолей.ПриходРасход.Свойство("Значение") Тогда
			Запрос.УстановитьПараметр("ПриходРасход", ИменаПолей.ПриходРасход.Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.АналитикаПланированияСтатейБюджетов) Тогда
			Если ПараметрыЗаполнения.СоздаватьВКлючи Тогда
				КлючАналитики = ЗначениеКлючаАналитики(Выборка);
			Иначе
				ТекстИсключения = НСтр("ru = 'Ошибка при заполнении ключей в коллекции: есть аналитики, по которым ключи еще не созданы.'");
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.КлючиАналитикиПланированияСтатейБюджетов,
					,
					ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		Иначе
			КлючАналитики = Выборка.АналитикаПланированияСтатейБюджетов;
		КонецЕсли;
		
		ПараметрыЗаполнения.ИзмененаАналитика = Истина;
		Если Не ПараметрыЗаполнения.ЗаполнятьКлючВКоллекции Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнитьКлюч Тогда
			Коллекция[Выборка.Индекс][ИменаПолей.ЗаполняемаяАналитикаПланированияСтатейБюджетов] = КлючАналитики;
		Иначе
			Коллекция[Выборка.Индекс][ИменаПолей.АналитикаПланированияСтатейБюджетов] = КлючАналитики;
		КонецЕсли;  
		
	КонецЦикла;  
	
КонецПроцедуры

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики планирования статей бюджетов.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля должно браться из имени ключа.
//		секция идентификации {СтатьяБюджета, Аналитика1, Аналитика2, Аналитика3, Аналитика4, Аналитика5, Аналитика6, АналитикаПланированияСтатейБюджетов, ПриходРасход},
//			все ключи заданы.
//
Функция ИменаПолейКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("СтатьяБюджета", "СтатьяБюджета");
	ИменаПолей.Вставить("Аналитика1", "Аналитика1");
	ИменаПолей.Вставить("Аналитика2", "Аналитика2");
	ИменаПолей.Вставить("Аналитика3", "Аналитика3");
	ИменаПолей.Вставить("Аналитика4", "Аналитика4");
	ИменаПолей.Вставить("Аналитика5", "Аналитика5");
	ИменаПолей.Вставить("Аналитика6", "Аналитика6");
	ИменаПолей.Вставить("ПриходРасход", "ПриходРасход");
	ИменаПолей.Вставить("АналитикаПланированияСтатейБюджетов", "АналитикаПланированияСтатейБюджетов");
	
	Возврат ИменаПолей;
КонецФункции

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики планирования статей бюджетов.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//
Функция ИменаПолейДополненияКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("АналитикаПланированияСтатейБюджетов", "АналитикаПланированияСтатейБюджетов");
	ИменаПолей.Вставить("ЗаполняемаяАналитикаПланированияСтатейБюджетов", "АналитикаПланированияСтатейБюджетов");
	ИменаПолей.Вставить("СтатьяБюджета", "");
	ИменаПолей.Вставить("Аналитика1", "");
	ИменаПолей.Вставить("Аналитика2", "");
	ИменаПолей.Вставить("Аналитика3", "");
	ИменаПолей.Вставить("Аналитика4", "");
	ИменаПолей.Вставить("Аналитика5", "");
	ИменаПолей.Вставить("Аналитика6", "");
	ИменаПолей.Вставить("ПриходРасход", "");
	
	Возврат ИменаПолей;
КонецФункции

#КонецОбласти

