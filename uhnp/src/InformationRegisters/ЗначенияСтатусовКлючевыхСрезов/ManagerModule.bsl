#Область ПрограммныйИнтерфейс

Процедура УдалитьЗаписиКлючевогоСреза(ДанныеСреза, Отказ) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияСтатусовКлючевыхСрезов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ВидОтчета", ДанныеСреза.ВидОтчета);
		ЭлементБлокировки.УстановитьЗначение("Сценарий", ДанныеСреза.Сценарий);
		Если ЗначениеЗаполнено(ДанныеСреза.Организация) Тогда
			ЭлементБлокировки.УстановитьЗначение("ОрганизационнаяЕдиница", ДанныеСреза.Организация);
		КонецЕсли;
		Периоды = ПолучитьПериодыБлокировки(ДанныеСреза.МассивПериодов);
		ЭлементБлокировки.ИсточникДанных = Периоды;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодОтчета", "ПериодыОтчета");
		
		Если ЗначениеЗаполнено(ДанныеСреза.Проект) Тогда
			ЭлементБлокировки.УстановитьЗначение("Проект", ДанныеСреза.Проект);
		КонецЕсли;
		Если ДанныеСреза.МаксАналитикОтчета > 0 Тогда
			Для Номер = 1 По ДанныеСреза.МаксАналитикОтчета Цикл
				ЭлементБлокировки.УстановитьЗначение("Аналитика" + Номер, ДанныеСреза["Аналитика" + Номер]);
			КонецЦикла;
		КонецЕсли;
		Блокировка.Заблокировать();
		
		Для Каждого ПериодСреза Из ДанныеСреза.МассивПериодов Цикл
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВидОтчета.Установить(ДанныеСреза.ВидОтчета);
			НаборЗаписей.Отбор.Сценарий.Установить(ДанныеСреза.Сценарий);
			Если ЗначениеЗаполнено(ДанныеСреза.Организация) Тогда
				НаборЗаписей.Отбор.ОрганизационнаяЕдиница.Установить(ДанныеСреза.Организация);
			КонецЕсли;
			НаборЗаписей.Отбор.ПериодОтчета.Установить(ПериодСреза);
			Если ЗначениеЗаполнено(ДанныеСреза.Проект) Тогда
				НаборЗаписей.Отбор.Проект.Установить(ДанныеСреза.Проект);
			КонецЕсли;
			
			Если ДанныеСреза.МаксАналитикОтчета > 0 Тогда
				Для Номер = 1 По ДанныеСреза.МаксАналитикОтчета Цикл
					НаборЗаписей.Отбор["Аналитика" + Номер].Установить(ДанныеСреза["Аналитика" + Номер]);
				КонецЦикла;
			КонецЕсли;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ОбработатьОшибкуУдаленияЗаписей();
		Отказ = Истина;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьЗаписиПоВидуОтчета(ВидОтчета, Отказ = Ложь) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияСтатусовКлючевыхСрезов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ВидОтчета", ВидОтчета);
		Блокировка.Заблокировать();
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидОтчета.Установить(ВидОтчета);
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ОбработатьОшибкуУдаленияЗаписей();
		Отказ = Истина;
		
	КонецПопытки;
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбновлениеИнформационнойБазы


Процедура ПеренестиЗначенияСтатусовЭкземпляровОтчетов() Экспорт
	
	МетаданныеРегистра = СоздатьНаборЗаписей().Метаданные();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗначенияСтатусовПоказателейСинтетика.ВидОтчета КАК ВидОтчета,
	|	ЗначенияСтатусовПоказателейСинтетика.Сценарий КАК Сценарий,
	|	ЗначенияСтатусовПоказателейСинтетика.ОрганизационнаяЕдиница КАК ОрганизационнаяЕдиница,
	|	ЗначенияСтатусовПоказателейСинтетика.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияСтатусовПоказателейСинтетика.Проект КАК Проект,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика1 КАК Аналитика1,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика2 КАК Аналитика2,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика3 КАК Аналитика3,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика4 КАК Аналитика4,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика5 КАК Аналитика5,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика6 КАК Аналитика6,
	|	ВЫБОР
	|		КОГДА ЗначенияСтатусовПоказателейСинтетика.ЗначениеЗаблокировано > 1
	|			ТОГДА 1
	|		ИНАЧЕ ЗначенияСтатусовПоказателейСинтетика.ЗначениеЗаблокировано
	|	КОНЕЦ КАК ЗначениеЗаблокировано,
	|	ЗначенияСтатусовПоказателейСинтетика.ИндексСостояния КАК ИндексСостояния
	|ИЗ
	|	РегистрСведений.ЗначенияСтатусовПоказателейСинтетика КАК ЗначенияСтатусовПоказателейСинтетика
	|ГДЕ
	|	ЗначенияСтатусовПоказателейСинтетика.ВидОтчета.ОбъектДляСогласованияЗначений = ЗНАЧЕНИЕ(Перечисление.ОбъектыСогласованияЗначенийПоказателейОтчетов.ЭкземплярОтчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗначенияСтатусовПоказателейСинтетика.ВидОтчета,
	|	ЗначенияСтатусовПоказателейСинтетика.Сценарий,
	|	ЗначенияСтатусовПоказателейСинтетика.ОрганизационнаяЕдиница,
	|	ЗначенияСтатусовПоказателейСинтетика.ПериодОтчета,
	|	ЗначенияСтатусовПоказателейСинтетика.Проект,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика1,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика2,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика3,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика4,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика5,
	|	ЗначенияСтатусовПоказателейСинтетика.Аналитика6,
	|	ЗначенияСтатусовПоказателейСинтетика.ИндексСостояния,
	|	ВЫБОР
	|		КОГДА ЗначенияСтатусовПоказателейСинтетика.ЗначениеЗаблокировано > 1
	|			ТОГДА 1
	|		ИНАЧЕ ЗначенияСтатусовПоказателейСинтетика.ЗначениеЗаблокировано
	|	КОНЕЦ
	|ИТОГИ ПО
	|	ВидОтчета";
	
	Результат = Запрос.Выполнить();
	ВыборкаВидОтчета = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидОтчета.Следующий() Цикл
		
		Попытка
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ВидОтчета.Установить(ВыборкаВидОтчета.ВидОтчета);
			
			Выборка = ВыборкаВидОтчета.Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка)
			КонецЦикла;
			
			ВидОтчетаСтрокой = Строка(ВыборкаВидОтчета.ВидОтчета);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
		Исключение
			
			ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось создать записи для вида отчета ""%1"" по причине:
				|%2.'"), ВидОтчетаСтрокой, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				МетаданныеРегистра,
				,
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПериодыБлокировки(МассивПериодов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивПериодов", МассивПериодов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Периоды.Ссылка КАК ПериодыОтчета
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.Ссылка В (&МассивПериодов)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ОбработатьОшибкуУдаленияЗаписей()
	
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка удаления записей регистра сведений ""Значения статусов ключевых срезов"" по причине: %1'"),
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка удаления записей регистра сведений ""Значения статусов ключевых срезов"": %1'"),
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка удаления записей регистра сведений ""Значения статусов ключевых срезов""'"),
		УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.ЗначенияСтатусовКлючевыхСрезов,, ТекстОшибки);
	
КонецПроцедуры


#КонецОбласти

