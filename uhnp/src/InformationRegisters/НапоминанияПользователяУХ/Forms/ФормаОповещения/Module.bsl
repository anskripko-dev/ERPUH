// Выполняет обновление таблицы напоминаний по данным информационной базы
// для текущего пользователя.
&НаСервере
Процедура ОбновитьНапоминанияТекущегоПользователя()
	ТаблицаОповещений.Очистить();
	ТаблицаСобытий = МодульУправленияОповещениямиУХ.ПолучитьТаблицуАктуальныхНапоминанийПользователя(ТекущийПользователь);
	Для Каждого ТекТаблицаСобытий Из ТаблицаСобытий Цикл
		НоваяСтрока = ТаблицаОповещений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекТаблицаСобытий);
	КонецЦикла;
КонецПроцедуры

// Отключает оповещения по строкам МассивСтрокВход. Возвращает количество успешных операций.
&НаСервере
Функция Прекратить_Сервер(МассивСтрокВход)
	СчетчикУспешных = 0;
	Для Каждого ИндексСтроки Из МассивСтрокВход Цикл
		ДанныеСтроки = ТаблицаОповещений.НайтиПоИдентификатору(ИндексСтроки);
		ВыбВидСобытия	 = ДанныеСтроки.ВидСобытияОповещения;
		ВыбВремяСобытия	 = ДанныеСтроки.ВремяСобытия;
		ВыбИсточник		 = ДанныеСтроки.Источник;
		ВыбПользователь	 = ДанныеСтроки.Пользователь;
		РезультатОтключения = МодульУправленияОповещениямиУХ.ОтключитьНапоминание(ВыбПользователь, ВыбВремяСобытия, ВыбИсточник, ВыбВидСобытия);
		Если РезультатОтключения Тогда
			СчетчикУспешных = СчетчикУспешных + 1;
		Иначе
			// Не изменяем.
		КонецЕсли;
	КонецЦикла;
	Возврат СчетчикУспешных;	
КонецФункции

// Переносит оповещения по строкам МассивСтрокВход на интервал СрокПовторногоОповещенияВход. 
//Возвращает количество успешных операций.
&НаСервере
Функция Отложить_Сервер(МассивСтрокВход, СрокПовторногоОповещенияВход)
	СчетчикУспешных = 0;
	Для Каждого ИндексСтроки Из МассивСтрокВход Цикл
		ДанныеСтроки = ТаблицаОповещений.НайтиПоИдентификатору(ИндексСтроки);
		ВыбВидСобытия	 = ДанныеСтроки.ВидСобытияОповещения;
		ВыбВремяСобытия	 = ДанныеСтроки.ВремяСобытия;
		ВыбИсточник		 = ДанныеСтроки.Источник;
		ВыбПользователь	 = ДанныеСтроки.Пользователь;
		НоваяДатаОповещения = ТекущаяДатаСеанса() + СрокПовторногоОповещенияВход*60*60;
		РезультатПереноса = МодульУправленияОповещениямиУХ.ПеренестиНапоминание(ВыбПользователь, ВыбВремяСобытия, ВыбИсточник, ВыбВидСобытия, НоваяДатаОповещения);
		Если РезультатПереноса Тогда
			СчетчикУспешных = СчетчикУспешных + 1;
		Иначе
			// Не изменяем.
		КонецЕсли;
	КонецЦикла;
	Возврат СчетчикУспешных;	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Заполним таблицу из параметров.
	Если Параметры.Свойство("СписокОповещений") Тогда
		ТаблицаОповещений.Очистить();
		СписокОповещений = Параметры.СписокОповещений;
		Для Каждого ТекСписокОповещений Из СписокОповещений Цикл
			НоваяСтрока = ТаблицаОповещений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСписокОповещений.Значение);
		КонецЦикла;
	Иначе
		ТекстОшибки = НСтр("ru = 'Недостаточно данных для отображения напоминания'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки);
	КонецЕсли;
	// Заполним параметры по умолчанию.
	СрокПовторногоОповещения = 0.25;			// 15 минут по умолчанию.
	ТекущийПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИсточник(Команда)
	ТекДанные = Элементы.ТаблицаОповещений.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекДанные.Источник);
	Иначе
		// Строка не выбрана.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Прекратить(Команда)
	Если Элементы.ТаблицаОповещений.ТекущиеДанные <> Неопределено Тогда
		// Отключение напоминаний.
		МассивВыделенныхСтрок = Элементы.ТаблицаОповещений.ВыделенныеСтроки;
		СчетчикУспешных = Прекратить_Сервер(МассивВыделенныхСтрок);
		// Сообщаем результат.
		ТекстСообщения = "";
		Если (МассивВыделенныхСтрок.Количество() = 1) И (СчетчикУспешных = 1) Тогда
			ТекстСообщения = НСтр("ru = 'Напоминание отключено'");
		ИначеЕсли (МассивВыделенныхСтрок.Количество() = 1) И (СчетчикУспешных = 0) Тогда
			ТекстСообщения = НСтр("ru = 'Напоминание не было отключено'");	
		Иначе
			ТекстСообщения = НСтр("ru = 'Было отключено %Количество% напоминаний'");	
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%", Строка(СчетчикУспешных));
		КонецЕсли;
		ПоказатьОповещениеПользователя(ТекстСообщения);
		ОбновитьНапоминанияТекущегоПользователя();
	Иначе
		// Строка не выбрана.
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	ОбновитьНапоминанияТекущегоПользователя();
КонецПроцедуры

&НаКлиенте
Процедура Отложить(Команда)
	Если Элементы.ТаблицаОповещений.ТекущиеДанные <> Неопределено Тогда
		// Перенос напоминаний.
		МассивВыделенныхСтрок = Элементы.ТаблицаОповещений.ВыделенныеСтроки;
		СчетчикУспешных = Отложить_Сервер(МассивВыделенныхСтрок, СрокПовторногоОповещения);
		// Сообщаем результат.
		ТекстСообщения = "";
		Если (МассивВыделенныхСтрок.Количество() = 1) И (СчетчикУспешных = 1) Тогда
			ТекстСообщения = НСтр("ru = 'Напоминание перенесено'");
		ИначеЕсли (МассивВыделенныхСтрок.Количество() = 1) И (СчетчикУспешных = 0) Тогда
			ТекстСообщения = НСтр("ru = 'Напоминание не было перенесено'");	
		Иначе
			ТекстСообщения = НСтр("ru = 'Было перенесено %Количество% напоминаний'");	
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%", Строка(СчетчикУспешных));
		КонецЕсли;
		ПоказатьОповещениеПользователя(ТекстСообщения);
		ОбновитьНапоминанияТекущегоПользователя();
	Иначе
		// Строка не выбрана.
	КонецЕсли;	
КонецПроцедуры
