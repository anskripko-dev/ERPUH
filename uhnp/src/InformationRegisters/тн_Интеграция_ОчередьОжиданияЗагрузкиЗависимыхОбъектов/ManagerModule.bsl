// Юдина Екатерина 16.10.2025 Выполнение задач №000055524
Процедура УдалитьСообщение(ИДСообщения, УдалитьСтатус = Ложь) Экспорт
	
	Если УдалитьСтатус Тогда
		РегистрыСведений.тн_Интеграция_СтатусыОбработкиСообщенийRMQ.УдалитьСтатус(ИДСообщения);
	КонецЕсли;
	
    Набор = РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.ИДСообщения.Установить(ИДСообщения);
	Набор.Записать();	
	
КонецПроцедуры // УдалитьСообщение()

// Чекордина Ирина 30.12.2025 Выполнение задач №000056058
Процедура ЗаполнитьБазуРеспондентИД(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ИДСообщения КАК ИДСообщения,
		|	тн_Интеграция_ОчередьОбработкиСообщенийRMQ.БазаРеспондентИД КАК БазаРеспондентИД
		|ИЗ
		|	РегистрСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов КАК тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.тн_Интеграция_ОчередьОбработкиСообщенийRMQ КАК тн_Интеграция_ОчередьОбработкиСообщенийRMQ
		|		ПО тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ИДСообщения = тн_Интеграция_ОчередьОбработкиСообщенийRMQ.ИДСообщения
		|			И (тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.БазаРеспондентИД = """")";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличествоОшибок = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НЗ = РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.СоздатьНаборЗаписей();
		НЗ.Отбор.ИДСообщения.Установить(Выборка.ИДСообщения);
		НЗ.Прочитать();
		
		Если НЗ.Количество() > 0 Тогда
			
			Для Каждого Запись Из НЗ Цикл
				Запись.БазаРеспондентИД = Выборка.БазаРеспондентИД;
			КонецЦикла;
			
			Попытка
				НЗ.Записать(); 
			Исключение
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецПопытки;
				
		КонецЕсли;
			
	КонецЦикла;
	
	Если КоличествоОшибок > 0 Тогда
		ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов, ,
		"Не удалось записать " + КоличествоОшибок + " наборов записей при выполнении обработчика обновления РегистрыСведений.тн_Интеграция_ОчередьОжиданияЗагрузкиЗависимыхОбъектов.ЗаполнитьБазуРеспондентИД"); 
	КонецЕсли;
	
КонецПроцедуры

