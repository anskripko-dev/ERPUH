
&НаКлиенте
Процедура ИсходныйОбъектСсылкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	
	Если НЕ ЗначениеЗаполнено(Запись.ИсходныйОбъектСсылка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(Запись.ИсходныйОбъектСсылка)=Тип("Строка") Тогда
		
		СтруктураПараметров=ПолучитьДанныеОбъектаВИБ(Запись.ИсходныйОбъектСсылка,Запись);
		
		Если ТипЗнч(СтруктураПараметров)=Тип("Структура") Тогда
			
			ОткрытьФорму("ОбщаяФорма.ОтображениеЭлементаWS_Управляемая", Новый Структура("Расшифровка, ИспользуемаяИБ", СтруктураПараметров, ИспользуемаяИБ));
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьЗначение(, Запись.ИсходныйОбъектСсылка);
		
	КонецЕсли;
		
КонецПроцедуры



&НаСервере
Функция ПолучитьДанныеОбъектаВИБ(СтрокаGUID, ЗНАЧ Запись)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ПравилаЗаполненияОбъектовБД.ИсходныйОбъектБД.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ПравилаЗаполненияОбъектовБД КАК ПравилаЗаполненияОбъектовБД
	|ГДЕ
	|	ПравилаЗаполненияОбъектовБД.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ПолучитьРеквизитСеанса(Запись.СеансОбменаДанными,"ПравилоЗаполнения"));
	
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
		
	СтруктураОбъекта=Новый Структура("ТипЗначения, Значение", "ДокументСсылка."+Результат.Наименование,СтрокаGUID);
	
	Возврат СтруктураОбъекта;			

КонецФункции // ПолучитьДанныеОбъектаВИБ()

&НаСервереБезКонтекста
Функция ПолучитьРеквизитСеанса(СеансОбменаДанными,ИмяРеквизита)
	
	Возврат СеансОбменаДанными[ИмяРеквизита];	
	
КонецФункции // ПолучитьРеквизитСеанса()

&НаКлиенте
Процедура ОбработанныйОбъектСсылкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	
	Если НЕ ЗначениеЗаполнено(Запись.ОбработанныйОбъектСсылка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(Запись.ОбработанныйОбъектСсылка)=Тип("Строка") Тогда
		
		СтруктураПараметров=ПолучитьДанныеОбъектаВИБ(Запись.ОбработанныйОбъектСсылка,Запись);
		
		Если ТипЗнч(СтруктураПараметров)=Тип("Структура") Тогда
			
			ОткрытьФорму("ОбщаяФорма.ОтображениеЭлементаWS_Управляемая", Новый Структура("Расшифровка, ИспользуемаяИБ", СтруктураПараметров, ИспользуемаяИБ));
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьЗначение(, Запись.ОбработанныйОбъектСсылка);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемаяИБПриИзменении(Элемент)
	
	ИспользуемаяИБПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИспользуемаяИБПриИзмененииНаСервере()
	
	ТипБД=ИспользуемаяИБ.ТипБД;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СеансыОбменаДанными.ОбъектБД,
	|	СеансыОбменаДанными.ИспользуемаяИБ,
	|	СеансыОбменаДанными.ПравилоЗаполнения,
	|	СеансыОбменаДанными.ОбластьГенерации,
	|	СеансыОбменаДанными.Организация,
	|	СеансыОбменаДанными.ПериодОтчета,
	|	ЕСТЬNULL(ПротоколыОбъектов.Протокол, НЕОПРЕДЕЛЕНО) КАК ПротоколОбмена,
	|	ЕСТЬNULL(ПротоколыОбъектов.ЕстьОшибки, ЛОЖЬ) КАК ЕстьОшибки
	|ИЗ
	|	Справочник.СеансыОбменаДанными КАК СеансыОбменаДанными
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколыОбъектов КАК ПротоколыОбъектов
	|		ПО СеансыОбменаДанными.Ссылка = ПротоколыОбъектов.Объект
	|ГДЕ
	|	СеансыОбменаДанными.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Запись.СеансОбменаДанными);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ОбъектБД			= Результат.ОбъектБД;
		ИспользуемаяИБ		= Результат.ИспользуемаяИБ;
		ПравилоЗаполнения	= Результат.ПравилоЗаполнения;
		ОбластьГенерации	= Результат.ОбластьГенерации;
		Организация			= Результат.Организация;
		ПериодОтчета		= Результат.ПериодОтчета;
		ПротоколОбмена		= Результат.ПротоколОбмена;
		ЕстьОшибки			= Результат.ЕстьОшибки;
		
	КонецЕсли;
	
	Элементы.ОтобразитьПротокол.Видимость=ЗначениеЗаполнено(ПротоколОбмена);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПротоколируемыхОбъектов(СеансОбменаДанными)
	
	МассивОбъектов=Новый Массив;
	МассивОбъектов.Добавить(СеансОбменаДанными);
	
	Возврат ПротоколируемыеСобытияУХ.ПолучитьМассивПротоколируемыхОбъектов(МассивОбъектов);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКонтекстОбъекта(СеансОбменаДанными)
	
	Возврат ПротоколируемыеСобытияУХ.ПолучитьСтруктуруКонтекста(СеансОбменаДанными);	
	
КонецФункции


&НаКлиенте
Процедура ОтобразитьПротокол(Команда)
	
	МассивПротоколируемыхОбъектов=ПолучитьМассивПротоколируемыхОбъектов(Запись.СеансОбменаДанными);
	
	Если МассивПротоколируемыхОбъектов.Количество()>0 Тогда
		
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",Новый Структура("МассивПротоколируемыхОбъектов",МассивПротоколируемыхОбъектов));
		
	Иначе
		
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",Новый Структура("КонтекстПротокола",ПолучитьКонтекстОбъекта(Запись.СеансОбменаДанными)));
		
	КонецЕсли;
	
КонецПроцедуры
