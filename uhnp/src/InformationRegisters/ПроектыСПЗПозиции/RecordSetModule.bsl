#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	// Проверка на наличие отрицательных остатков
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Автор", Отбор.Автор.Значение);
	Запрос.УстановитьПараметр("ОрганизацияЗаказчик", Отбор.ОрганизацияЗаказчик.Значение);
	Запрос.УстановитьПараметр("ПериодЗакупки", Отбор.ПериодЗакупки.Значение);
	Запрос.УстановитьПараметр("ИД", Отбор.ИД.Значение);
	Запрос.Текст = ТексЗапроса_СуществующиеДанные();
	Запрос.Выполнить();
	
	ДополнительныеСвойства.Вставить("МенеджерВТ", МенеджерВТ);
	
	// Рассчитать цену
	Для Каждого Строка Из ЭтотОбъект Цикл
		Если Строка.Цена = 0 И Строка.Количество <> 0 Тогда
			Строка.Цена = Строка.Сумма / Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка на наличие отрицательных остатков
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.МенеджерВТ;
	Запрос.УстановитьПараметр("Автор", Отбор.Автор.Значение);
	Запрос.УстановитьПараметр("ОрганизацияЗаказчик", Отбор.ОрганизацияЗаказчик.Значение);
	Запрос.УстановитьПараметр("ПериодЗакупки", Отбор.ПериодЗакупки.Значение);
	Запрос.УстановитьПараметр("ИД", Отбор.ИД.Значение);
	Запрос.Текст = ТексЗапроса_ТекущиеДанные();
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = "";
	
	МассивКонтролей = Новый Массив;
	ДобавитьКонтроль_СуществуютВсеПараметрыЗакупки(МассивКонтролей, Запрос);
	
	Если НЕ (ДополнительныеСвойства.Свойство("РазрешеноДобавлениеПротиворечивыхПозицийВКорзину") 
		И ДополнительныеСвойства.РазрешеноДобавлениеПротиворечивыхПозицийВКорзину = ИСТИНА) Тогда
		ДобавитьКонтроль_НаличиеПротиворечийВПозиции(МассивКонтролей, Запрос);
	КонецЕсли;
		
	ДобавитьКонтроль_ЕстьПревышениеПотребностей(МассивКонтролей, Запрос);
	
	Если НЕ ДополнительныеСвойства.Свойство("РазрешеноНесколькоОрганизацийЗаказчиков") 
		ИЛИ НЕ ДополнительныеСвойства.РазрешеноНесколькоОрганизацийЗаказчиков Тогда
		ДобавитьКонтроль_НесколькоОрганизацийЗаказчиковНедопустимо(МассивКонтролей, Запрос);
	КонецЕсли;
	
	РезультатОперации = Новый Соответствие; 
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	//Для Поз = 0 По МассивКонтролей.Количество()-1 Цикл
	//	Если МассивКонтролей[Поз] = "СуществуютВсеПараметрыЗакупки" Тогда
	//		Результат = ВыполнитьКонтроль_СуществуютВсеПараметрыЗакупки(РезультатЗапроса[Поз], Отказ);
	//	ИначеЕсли МассивКонтролей[Поз] = "НаличиеПротиворечийВПозиции" Тогда
	//		Результат = РегистрыСведений.ПроектыСПЗПозиции.ВыполнитьКонтроль_НаличиеПротиворечийВПозиции(Запрос, РезультатЗапроса[Поз], Отказ);
	//	ИначеЕсли МассивКонтролей[Поз] = "ЕстьПревышениеПотребностей" Тогда
	//		Результат = ВыполнитьКонтроль_ЕстьПревышениеПотребностей(РезультатЗапроса[Поз], Отказ);
	//	ИначеЕсли МассивКонтролей[Поз] = "НесколькоОрганизацийЗаказчиковНедопустимо" Тогда
	//		Результат = ВыполнитьКонтроль_НесколькоОрганизацийЗаказчиковНедопустимо(РезультатЗапроса[Поз], Отказ);
	//	Иначе
	//		Продолжить;
	//	КонецЕсли;
	//	Отказ = Отказ ИЛИ Результат.Ошибка;
	//	Результат.Вставить("Имя", МассивКонтролей[Поз]);
	//	РезультатОперации.Вставить(МассивКонтролей[Поз], Результат);
	//КонецЦикла;
	
	ДополнительныеСвойства.Вставить("РезультатОперации", РезультатОперации);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТекстыЗапросов
	
Функция ТексЗапроса_ТекущиеДанные()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.Автор КАК Автор,
	|	ПроектыСПЗПозиции.ИД КАК ИД,
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.Количество КАК Количество,
	|	ПроектыСПЗПозиции.Сумма КАК Сумма,
	|	ВЫБОР КОГДА ВТ_СуществующиеДанные.АналитикаНоменклатуры ЕСТЬ NULL ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоНоваяЗапись
	|ПОМЕСТИТЬ ВТ_ТекущиеДанные
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуществующиеДанные ВТ_СуществующиеДанные
	|			ПО ПроектыСПЗПозиции.ОрганизацияЗаказчик = ВТ_СуществующиеДанные.ОрганизацияЗаказчик
	|				И ПроектыСПЗПозиции.АналитикаНоменклатуры = ВТ_СуществующиеДанные.АналитикаНоменклатуры
	|				И ПроектыСПЗПозиции.АналитикаПотребностей = ВТ_СуществующиеДанные.АналитикаПотребностей
	|				И ПроектыСПЗПозиции.АналитикаСтруктуры = ВТ_СуществующиеДанные.АналитикаСтруктуры
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ИД = &ИД
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекущиеДанные.Автор КАК Автор,
	|	ВТ_ТекущиеДанные.ИД КАК ИД,
	|	ВТ_ТекущиеДанные.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ВТ_ТекущиеДанные.ПериодЗакупки КАК ПериодЗакупки,
	|	ВТ_ТекущиеДанные.ПериодПотребности КАК ПериодПотребности,
	|	ВТ_ТекущиеДанные.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_ТекущиеДанные.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_ТекущиеДанные.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВТ_ТекущиеДанные.ЭтоНоваяЗапись КАК ЭтоНоваяЗапись,
	|	ВТ_ТекущиеДанные.Количество КАК Количество,
	|	ВТ_ТекущиеДанные.Сумма КАК Сумма,
	|	ПараметрыЗакупкиПотребностей1.КлючПараметровЗакупки КАК КлючПараметровЗакупки
	|ПОМЕСТИТЬ ВТ_ТекущиеДанныеСПараметрамиЗакупки
	|ИЗ
	|	ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЗакупкиПотребностей1 КАК ПараметрыЗакупкиПотребностей1
	|		ПО ВТ_ТекущиеДанные.Автор = ПараметрыЗакупкиПотребностей1.Автор
	|			И ВТ_ТекущиеДанные.ПериодЗакупки = ПараметрыЗакупкиПотребностей1.ПериодЗакупки
	|			И ВТ_ТекущиеДанные.АналитикаНоменклатуры = ПараметрыЗакупкиПотребностей1.АналитикаНоменклатуры
	|			И ВТ_ТекущиеДанные.АналитикаПотребностей = ПараметрыЗакупкиПотребностей1.АналитикаПотребностей
	|			И ВТ_ТекущиеДанные.АналитикаСтруктуры = ПараметрыЗакупкиПотребностей1.АналитикаСтруктуры";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТексЗапроса_СуществующиеДанные()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.АналитикаИсточника КАК АналитикаИсточника,
	|	ПроектыСПЗПозиции.АналитикаПланирования КАК АналитикаПланирования
	|ПОМЕСТИТЬ ВТ_СуществующиеДанные
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ИД = &ИД
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроектыСПЗПозиции.АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.АналитикаИсточника,
	|	ПроектыСПЗПозиции.АналитикаПланирования";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти 

#Область Контроль_ЕстьПревышениеПотребностей

Процедура ДобавитьКонтроль_ЕстьПревышениеПотребностей(МассивКонтролей, Запрос)
	ИмяКонтроля  = "ЕстьПревышениеПотребностей";
	МассивКонтролей.Добавить(ИмяКонтроля);
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + 
			ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	Запрос.Организация КАК Организация,
	|	Запрос.ПериодПотребности КАК ПериодПотребности,
	|	Запрос.Приоритет КАК Приоритет,
	|	Запрос.Номенклатура КАК Номенклатура,
	|	Запрос.Характеристика КАК Характеристика,
	|	Запрос.МестоПоставки КАК МестоПоставки,
	|	Запрос.Проект КАК Проект,
	|	Запрос.Менеджер КАК Менеджер,
	|	Запрос.ДоговорСПокупателем КАК ДоговорСПокупателем,
	|	СУММА(Запрос.Количество) КАК Количество,
	|	СУММА(Запрос.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		""К обеспечению"" КАК Источник,
	|		ВЫБОР
	|			КОГДА ПотребностиВНоменклатуреОбороты.Организация.ОбособленноеПодразделение
	|				ТОГДА ПотребностиВНоменклатуреОбороты.Организация.ГоловнаяОрганизация
	|			ИНАЧЕ ПотребностиВНоменклатуреОбороты.Организация
	|		КОНЕЦ КАК ОрганизацияЗаказчик,
	|		ПотребностиВНоменклатуреОбороты.Организация КАК Организация,
	|		ПотребностиВНоменклатуреОбороты.ПериодПотребности КАК ПериодПотребности,
	|		ПотребностиВНоменклатуреОбороты.Приоритет КАК Приоритет,
	|		ПотребностиВНоменклатуреОбороты.Номенклатура КАК Номенклатура,
	|		ПотребностиВНоменклатуреОбороты.Характеристика КАК Характеристика,
	|		ПотребностиВНоменклатуреОбороты.МестоПоставки КАК МестоПоставки,
	|		ПотребностиВНоменклатуреОбороты.Проект КАК Проект,
	|		ПотребностиВНоменклатуреОбороты.Менеджер КАК Менеджер,
	|		ПотребностиВНоменклатуреОбороты.ДоговорСПокупателем КАК ДоговорСПокупателем,
	|		ПотребностиВНоменклатуреОбороты.КоличествоПотребностьОборот - ПотребностиВНоменклатуреОбороты.КоличествоВОбеспеченииОборот КАК Количество,
	|		ПотребностиВНоменклатуреОбороты.СуммаПотребностьОборот - ПотребностиВНоменклатуреОбороты.СуммаВОбеспеченииОборот КАК Сумма
	|	ИЗ
	|		РегистрНакопления.ПотребностиВНоменклатуре.Обороты(
	|				,
	|				,
	|				,
	|				(Организация, Проект, ПериодПотребности, Номенклатура, Характеристика, МестоПоставки, Приоритет, Менеджер, ДоговорСПокупателем) В
	|					(ВЫБРАТЬ
	|						ВТ_ТекущиеДанные.АналитикаСтруктуры.Организация КАК АналитикаСтруктурыОрганизация,
	|						ВТ_ТекущиеДанные.АналитикаСтруктуры.Проект КАК АналитикаСтруктурыПроект,
	|						ВТ_ТекущиеДанные.ПериодПотребности КАК ПериодПотребности,
	|						ВТ_ТекущиеДанные.АналитикаНоменклатуры.Номенклатура КАК АналитикаНоменклатурыНоменклатура,
	|						ВТ_ТекущиеДанные.АналитикаНоменклатуры.Характеристика КАК АналитикаНоменклатурыХарактеристика,
	|						ВТ_ТекущиеДанные.АналитикаПотребностей.МестоПоставки КАК АналитикаПотребностейМестоПоставки,
	|						ВТ_ТекущиеДанные.АналитикаПотребностей.Приоритет КАК АналитикаПотребностейПриоритет,
	|						ВТ_ТекущиеДанные.АналитикаПотребностей.Менеджер КАК АналитикаПотребностейМенеджер,
	|						ВТ_ТекущиеДанные.АналитикаПотребностей.Назначение КАК АналитикаПотребностейНазначение
	|					ИЗ
	|						ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные)) КАК ПотребностиВНоменклатуреОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		""Текущая операция"",
	|		ВТ_ТекущиеДанные.ОрганизацияЗаказчик,
	|		ВТ_ТекущиеДанные.АналитикаСтруктуры.Организация,
	|		ВТ_ТекущиеДанные.ПериодПотребности,
	|		ВТ_ТекущиеДанные.АналитикаПотребностей.Приоритет,
	|		ВТ_ТекущиеДанные.АналитикаНоменклатуры.Номенклатура,
	|		ВТ_ТекущиеДанные.АналитикаНоменклатуры.Характеристика,
	|		ВТ_ТекущиеДанные.АналитикаПотребностей.МестоПоставки,
	|		ВТ_ТекущиеДанные.АналитикаСтруктуры.Проект,
	|		ВТ_ТекущиеДанные.АналитикаПотребностей.Менеджер,
	|		ВТ_ТекущиеДанные.АналитикаПотребностей.Назначение,
	|		-ВТ_ТекущиеДанные.Количество,
	|		-ВТ_ТекущиеДанные.Сумма
	|	ИЗ
	|		ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		""Чужие сессии"",
	|		ПроектыСПЗПозиции.ОрганизацияЗаказчик,
	|		ПроектыСПЗПозиции.АналитикаСтруктуры.Организация,
	|		ПроектыСПЗПозиции.ПериодПотребности,
	|		ПроектыСПЗПозиции.АналитикаПотребностей.Приоритет,
	|		ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура,
	|		ПроектыСПЗПозиции.АналитикаНоменклатуры.Характеристика,
	|		ПроектыСПЗПозиции.АналитикаПотребностей.МестоПоставки,
	|		ПроектыСПЗПозиции.АналитикаСтруктуры.Проект,
	|		ПроектыСПЗПозиции.АналитикаПотребностей.Менеджер,
	|		ПроектыСПЗПозиции.АналитикаПотребностей.Назначение,
	|		-ПроектыСПЗПозиции.Количество,
	|		-ПроектыСПЗПозиции.Сумма
	|	ИЗ
	|		ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|			ПО ВТ_ТекущиеДанные.ОрганизацияЗаказчик = ПроектыСПЗПозиции.ОрганизацияЗаказчик
	|				И ВТ_ТекущиеДанные.ПериодПотребности = ПроектыСПЗПозиции.ПериодПотребности
	|				И ВТ_ТекущиеДанные.АналитикаНоменклатуры = ПроектыСПЗПозиции.АналитикаНоменклатуры
	|				И ВТ_ТекущиеДанные.АналитикаПотребностей = ПроектыСПЗПозиции.АналитикаПотребностей
	|				И ВТ_ТекущиеДанные.АналитикаСтруктуры = ПроектыСПЗПозиции.АналитикаСтруктуры
	|	ГДЕ
	|		(ВТ_ТекущиеДанные.Автор <> ПроектыСПЗПозиции.Автор
	|				ИЛИ ВТ_ТекущиеДанные.ИД <> ПроектыСПЗПозиции.ИД)) КАК Запрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Запрос.ПериодПотребности,
	|	Запрос.Проект,
	|	Запрос.МестоПоставки,
	|	Запрос.Менеджер,
	|	Запрос.ДоговорСПокупателем,
	|	Запрос.Приоритет,
	|	Запрос.Номенклатура,
	|	Запрос.Организация,
	|	Запрос.Характеристика
	|
	|ИМЕЮЩИЕ
	|	(СУММА(Запрос.Количество) < 0
	|		ИЛИ СУММА(Запрос.Сумма) < 0)";
	
КонецПроцедуры

