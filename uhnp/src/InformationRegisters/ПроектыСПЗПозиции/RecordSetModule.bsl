#КонецОбласти 

#Область Контроль_НаличиеПротиворечийВПозиции

Процедура ДобавитьКонтроль_НаличиеПротиворечийВПозиции(МассивКонтролей, Запрос) Экспорт
	ИмяКонтроля  = "НаличиеПротиворечийВПозиции";
	МассивКонтролей.Добавить(ИмяКонтроля);
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + 
			ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	КонецЕсли;
	
	//
	ТекстЗапроса = "";
	// 
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&%1 КАК Свойство,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.%2 КАК Значение
	|ИЗ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки КАК ВТ_ТекущиеДанныеСПараметрамиЗакупки
	|ГДЕ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.ЗапретИзменения_%2 = ИСТИНА";
	
	ПараметрыЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
	ЭтоПервыйПараметр = Истина;
	Для Каждого ПараметрЗакупки Из ПараметрыЗакупки Цикл
		
		Если Не ЭтоПервыйПараметр Тогда
			ТекстЗапроса = ТекстЗапроса +
			"
			|	
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;
		
		ИмяПараметра = "ПараметрЗакупкиСвойство"+ПараметрЗакупки.ПараметрНомер;
		
		Запрос.УстановитьПараметр(ИмяПараметра, ПараметрЗакупки.Параметр);
		
		ТекстЗапроса = ТекстЗапроса
			+ СтрШаблон(ШаблонТекстаЗапроса, ИмяПараметра, ПараметрЗакупки.ПараметрИмя);
			
		ЭтоПервыйПараметр = Ложь;
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Свойство КАК Свойство,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Значение) КАК Значение
	|ИЗ
	|	("+ТекстЗапроса+") КАК ВложенныйЗапрос
	|	
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Свойство
	|	
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Значение) > 1";
	
КонецПроцедуры

#КонецОбласти 

#Область Контроль_НесколькоОрганизацийЗаказчиков

Процедура ДобавитьКонтроль_НесколькоОрганизацийЗаказчиковНедопустимо(МассивКонтролей, Запрос)
	ИмяКонтроля  = "НесколькоОрганизацийЗаказчиковНедопустимо";
	МассивКонтролей.Добавить(ИмяКонтроля);
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + 
			ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ТекущиеДанные.ОрганизацияЗаказчик) КАК ОрганизацияЗаказчик
	|ИЗ
	|	ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|ГДЕ
	|	(ВТ_ТекущиеДанные.Количество <> 0
	|			ИЛИ ВТ_ТекущиеДанные.Сумма <> 0)";
	
КонецПроцедуры

Функция ВыполнитьКонтроль_НесколькоОрганизацийЗаказчиковНедопустимо(РезультатЗапроса, Отказ)
	
	Результат = РегистрыСведений.ПроектыСПЗПозиции.ОписаниеКонтроля();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Если Выборка.ОрганизацияЗаказчик > 1 Тогда
		// Установить отказ
		Результат.АдресВХ = неопределено;
		Результат.Ошибка = Истина;
		Результат.Сообщение = НСтр("ru = 'Недопустимо наличие в корзине потребностей по нескольким организациям-заказчикам!'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

