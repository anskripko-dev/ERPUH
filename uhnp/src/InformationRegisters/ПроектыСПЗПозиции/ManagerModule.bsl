Функция ВКорзинеПрисутствуютПротиворечивыеПозиции(Автор, ПериодЗакупки) Экспорт
	
	// Проверка на наличие отрицательных остатков
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ИД", ПотребностиУХ.ПустойУИД());
	Запрос.Текст = ТексЗапроса_ТекущиеДанные();
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ОписаниеКонтроля();
	КонецЕсли;
	
	Запрос.Текст = "";
	МассивКонтролей = Новый Массив;
	ДобавитьКонтроль_НаличиеПротиворечийВПозиции(МассивКонтролей, Запрос);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Отказ = Ложь;
	Результат = ВыполнитьКонтроль_НаличиеПротиворечийВПозиции(Запрос, РезультатЗапроса, Отказ);
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьКонтроль_НаличиеПротиворечийВПозиции(Запрос, РезультатЗапроса, Отказ) Экспорт
	
	Результат = РегистрыСведений.ПроектыСПЗПозиции.ОписаниеКонтроля();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивСвойствСОшибками = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Свойство");
	
	ТекстЗапроса = "";
	
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.ПериодПотребности КАК ПериодПотребности,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.ЭтоНоваяЗапись КАК ЭтоНоваяЗапись,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.%2 КАК Значение,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.ЗапретИзменения_%2 КАК ЗапретИзменения,
	|	&%1 КАК Свойство
	|ИЗ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки КАК ВТ_ТекущиеДанныеСПараметрамиЗакупки
	|ГДЕ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.ЗапретИзменения_%2 = ИСТИНА";
	
	ПараметрыЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
	ЭтоПервыйПараметр = Истина;
	Для Каждого ПараметрЗакупки Из ПараметрыЗакупки Цикл
		
		Если МассивСвойствСОшибками.Найти(ПараметрЗакупки.Параметр) = неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЭтоПервыйПараметр Тогда
			ТекстЗапроса = ТекстЗапроса +
			"
			|	
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;
		
		ИмяПараметра = "ПараметрЗакупкиСвойство"+ПараметрЗакупки.ПараметрНомер;
		Запрос.УстановитьПараметр(ИмяПараметра, ПараметрЗакупки.Параметр);
		ТекстЗапроса = ТекстЗапроса
			+ СтрШаблон(ШаблонТекстаЗапроса, ИмяПараметра, ПараметрЗакупки.ПараметрИмя);
			
		ЭтоПервыйПараметр = Ложь;
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	// Установить отказ
	Результат.АдресВХ = ПоместитьВоВременноеХранилище(ТаблицаРезультат);
	Результат.Ошибка = Истина;
	Результат.Сообщение = НСтр("ru = 'При добавлении потребностей обнаружены противоречия в параметрах закупки!'");
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеКонтроля() Экспорт
	Возврат Новый Структура("Ошибка,Сообщение,АдресВХ", Ложь, неопределено, "");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТексЗапроса_ТекущиеДанные()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.Автор КАК Автор,
	|	ПроектыСПЗПозиции.ИД КАК ИД,
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.Количество КАК Количество,
	|	ПроектыСПЗПозиции.Сумма КАК Сумма,
	|	ЛОЖЬ КАК ЭтоНоваяЗапись
	|ПОМЕСТИТЬ ВТ_ТекущиеДанные
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ИД = &ИД
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекущиеДанные.Автор КАК Автор,
	|	ВТ_ТекущиеДанные.ИД КАК ИД,
	|	ВТ_ТекущиеДанные.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ВТ_ТекущиеДанные.ПериодЗакупки КАК ПериодЗакупки,
	|	ВТ_ТекущиеДанные.ПериодПотребности КАК ПериодПотребности,
	|	ВТ_ТекущиеДанные.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_ТекущиеДанные.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_ТекущиеДанные.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВТ_ТекущиеДанные.ЭтоНоваяЗапись КАК ЭтоНоваяЗапись,
	|	ВТ_ТекущиеДанные.Количество КАК Количество,
	|	ВТ_ТекущиеДанные.Сумма КАК Сумма,
	|	ПараметрыЗакупкиПотребностей1.КлючПараметровЗакупки КАК КлючПараметровЗакупки
	|ПОМЕСТИТЬ ВТ_ТекущиеДанныеСПараметрамиЗакупки
	|ИЗ
	|	ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЗакупкиПотребностей1 КАК ПараметрыЗакупкиПотребностей1
	|		ПО ВТ_ТекущиеДанные.Автор = ПараметрыЗакупкиПотребностей1.Автор
	|			И ВТ_ТекущиеДанные.ПериодЗакупки = ПараметрыЗакупкиПотребностей1.ПериодЗакупки
	|			И ВТ_ТекущиеДанные.АналитикаНоменклатуры = ПараметрыЗакупкиПотребностей1.АналитикаНоменклатуры
	|			И ВТ_ТекущиеДанные.АналитикаПотребностей = ПараметрыЗакупкиПотребностей1.АналитикаПотребностей
	|			И ВТ_ТекущиеДанные.АналитикаСтруктуры = ПараметрыЗакупкиПотребностей1.АналитикаСтруктуры";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ДобавитьКонтроль_НаличиеПротиворечийВПозиции(МассивКонтролей, Запрос)
	ИмяКонтроля  = "НаличиеПротиворечийВПозиции";
	МассивКонтролей.Добавить(ИмяКонтроля);
	
	Если Запрос.Текст <> "" Тогда
		Запрос.Текст = Запрос.Текст + 
			ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	КонецЕсли;
	
	//
	ТекстЗапроса = "";
	// 
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&%1 КАК Свойство,
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.%2 КАК Значение
	|ИЗ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки КАК ВТ_ТекущиеДанныеСПараметрамиЗакупки
	|ГДЕ
	|	ВТ_ТекущиеДанныеСПараметрамиЗакупки.КлючПараметровЗакупки.ЗапретИзменения_%2 = ИСТИНА";
	
	ПараметрыЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();
	ЭтоПервыйПараметр = Истина;
	Для Каждого ПараметрЗакупки Из ПараметрыЗакупки Цикл
		
		Если Не ЭтоПервыйПараметр Тогда
			ТекстЗапроса = ТекстЗапроса +
			"
			|	
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;
		
		ИмяПараметра = "ПараметрЗакупкиСвойство"+ПараметрЗакупки.ПараметрНомер;
		
		Запрос.УстановитьПараметр(ИмяПараметра, ПараметрЗакупки.Параметр);
		
		ТекстЗапроса = ТекстЗапроса
			+ СтрШаблон(ШаблонТекстаЗапроса, ИмяПараметра, ПараметрЗакупки.ПараметрИмя);
			
		ЭтоПервыйПараметр = Ложь;
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Свойство КАК Свойство,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Значение) КАК Значение
	|ИЗ
	|	("+ТекстЗапроса+") КАК ВложенныйЗапрос
	|	
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Свойство
	|	
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Значение) > 1";
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли 

