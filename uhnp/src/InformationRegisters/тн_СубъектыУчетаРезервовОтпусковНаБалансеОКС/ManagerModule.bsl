Функция РезервыОтпусковУчитываютсяНаБалансеОКС(Организация, Подразделение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_СубъектыУчетаРезервовОтпусковНаБалансеОКС.ПодразделениеПредприятия КАК ПодразделениеПредприятия
		|ИЗ
		|	РегистрСведений.тн_СубъектыУчетаРезервовОтпусковНаБалансеОКС КАК тн_СубъектыУчетаРезервовОтпусковНаБалансеОКС
		|ГДЕ
		|	тн_СубъектыУчетаРезервовОтпусковНаБалансеОКС.Организация = &Организация
		|	И тн_СубъектыУчетаРезервовОтпусковНаБалансеОКС.ПодразделениеПредприятия = &Подразделение";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции
