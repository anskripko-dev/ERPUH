// Функция - возвращает эталонный макет для переданного экземпляра отчета
//
// Параметры:
//  ЭкземплярОтчета	 - ДокументСсылка.НастраиваемыйОтчет - Ссылка на экземпляр отчета
// 
// Возвращаемое значение:
//   - ТабличныйДокумент - Эталонный макет для переданного экземпляра отчета
//
Функция ПолучитьЭталонныйМакет(ЭкземплярОтчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХранилищаЭталонныхМакетовТестированияПересчетаПоказателей.ЭталонныйМакет КАК ЭталонныйМакет
		|ИЗ
		|	РегистрСведений.ХранилищаЭталонныхМакетовТестированияПересчетаПоказателей КАК ХранилищаЭталонныхМакетовТестированияПересчетаПоказателей
		|ГДЕ
		|	ХранилищаЭталонныхМакетовТестированияПересчетаПоказателей.ЭкземплярОтчета = &ЭкземплярОтчета";
	
	Запрос.УстановитьПараметр("ЭкземплярОтчета", ЭкземплярОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	Возврат ВыборкаДетальныеЗаписи.ЭталонныйМакет.Получить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
