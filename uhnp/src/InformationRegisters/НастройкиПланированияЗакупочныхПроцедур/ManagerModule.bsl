#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиОбновленияИнформационнойБазы

// Первоначальное заполнение регистра сведений
Процедура ВыполнитьПервоначальноеЗаполнение() экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.Конкурс) КАК СпособЗакупки,
	|	ЗНАЧЕНИЕ(Перечисление.МетодыОценкиПредложенийПоставщиков.ПоКритериям) КАК МетодОценки,
	|	30 КАК СрокПодготовки,
	|	30 КАК ДлительностьПроцедуры
	|ПОМЕСТИТЬ ВТ_ДанныеПоУмолчанию
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.ЗапросКотировок),
	|	ЗНАЧЕНИЕ(Перечисление.МетодыОценкиПредложенийПоставщиков.ПоЦенам),
	|	15,
	|	10
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.ЗапросПредложений),
	|	ЗНАЧЕНИЕ(Перечисление.МетодыОценкиПредложенийПоставщиков.ПоКритериям),
	|	25,
	|	20
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.Аукцион),
	|	ЗНАЧЕНИЕ(Перечисление.МетодыОценкиПредложенийПоставщиков.ПоЦенам),
	|	10,
	|	2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.КонкурентныеПереговоры),
	|	ЗНАЧЕНИЕ(Перечисление.МетодыОценкиПредложенийПоставщиков.ПоКритериям),
	|	30,
	|	30
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеПоУмолчанию.СпособЗакупки КАК СпособЗакупки,
	|	ВТ_ДанныеПоУмолчанию.МетодОценки КАК МетодОценки,
	|	ВТ_ДанныеПоУмолчанию.СрокПодготовки КАК СрокПодготовки,
	|	ВТ_ДанныеПоУмолчанию.ДлительностьПроцедуры КАК ДлительностьПроцедуры
	|ИЗ
	|	ВТ_ДанныеПоУмолчанию КАК ВТ_ДанныеПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПланированияЗакупочныхПроцедур КАК НастройкиПланированияЗакупочныхПроцедур
	|		ПО (НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки = ВТ_ДанныеПоУмолчанию.СпособЗакупки)
	|ГДЕ
	|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки ЕСТЬ NULL";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Нз = РегистрыСведений.НастройкиПланированияЗакупочныхПроцедур.СоздатьНаборЗаписей();
		Нз.Отбор.СпособЗакупки.Установить(Выборка.СпособЗакупки);
		Нз.Прочитать();
		Мз = Нз.Добавить();
		ЗаполнитьЗначенияСвойств(Мз, Выборка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Нз);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти  

#Область ПрограммныйИнтерфейс
Функция ПараметрыПланированияПроцедурПоСпособу(СпособЗакупки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки КАК СпособЗакупки,
		|	НастройкиПланированияЗакупочныхПроцедур.МетодОценки КАК МетодОценки,
		|	НастройкиПланированияЗакупочныхПроцедур.СрокПодготовки КАК СрокПодготовки,
		|	НастройкиПланированияЗакупочныхПроцедур.ДлительностьПроцедуры КАК ДлительностьПроцедуры
		|ИЗ
		|	РегистрСведений.НастройкиПланированияЗакупочныхПроцедур КАК НастройкиПланированияЗакупочныхПроцедур
		|ГДЕ
		|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки = &СпособЗакупки";
	
	Запрос.УстановитьПараметр("СпособЗакупки", СпособЗакупки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Результат = Новый Структура("СпособЗакупки, МетодОценки, СрокПодготовки, ДлительностьПроцедуры");
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаДетальныеЗаписи);  
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	

КонецФункции

#КонецОбласти


#КонецЕсли
