#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьСведения(ТекущийОбъект) Экспорт
	
	Сведения = Новый Структура;
	Сведения.Вставить("ПоследнийРедактировавший", Справочники.Пользователи.ПустаяСсылка());
	Сведения.Вставить("ДатаИзменения", Дата(1, 1, 1));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияОбИзмененииДокументов.ПоследнийРедактировавший КАК ПоследнийРедактировавший,
		|	СведенияОбИзмененииДокументов.ДатаИзменения КАК ДатаИзменения
		|ИЗ
		|	РегистрСведений.СведенияОбИзмененииДокументов КАК СведенияОбИзмененииДокументов
		|ГДЕ
		|	СведенияОбИзмененииДокументов.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект", ТекущийОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		ЗаполнитьЗначенияСвойств(Сведения, ВыборкаДетальныеЗаписи);
	КонецЕсли;
	
	Возврат Сведения
	
КонецФункции

#КонецОбласти

