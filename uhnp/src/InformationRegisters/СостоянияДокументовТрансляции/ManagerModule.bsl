#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда 
	
Процедура ЗаполнитьРегистрыСостоянияДокументов(Параметры=Неопределено) Экспорт
		
	НаборЗаписей=РегистрыСведений.ДокументыДляПовторнойТрансляции.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()=0 Тогда
		
		Запрос=Новый Запрос; 
		Запрос.Текст="ВЫБРАТЬ
		|	СостоянияДокументовТрансляции.ДокументТрансляции.ШаблонКорректировки КАК ШаблонТрансляции,
		|	СостоянияДокументовТрансляции.ДокументТрансляции КАК ДокументТрансляции,
		|	СостоянияДокументовТрансляции.ДокументТрансляции.ИсходныйДокумент КАК ИсходныйДокумент,
		|	СостоянияДокументовТрансляции.ДокументТрансляции.Дата КАК ДатаДокумента,
		|	СостоянияДокументовТрансляции.ДокументТрансляции.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.СостоянияДокументовТрансляции КАК СостоянияДокументовТрансляции
		|ГДЕ
		|	НЕ СостоянияДокументовТрансляции.ДокументТрансляции.ИсходныйДокумент = НЕОПРЕДЕЛЕНО";
		
		НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());		
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;

	НаборЗаписей=РегистрыСведений.ДокументыСводнойТрансляции.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()=0 Тогда
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	СостоянияДокументовТрансляции.ДокументТрансляции.ШаблонКорректировки КАК ШаблонТрансляции,
		|	СостоянияДокументовТрансляции.ДокументТрансляции.Организация КАК Организация,
		|	СостоянияДокументовТрансляции.ДокументТрансляции.ПериодОтчета КАК ПериодОтчета,
		|	СостоянияДокументовТрансляции.ДокументТрансляции КАК ДокументТрансляции,
		|	СостоянияДокументовТрансляции.ЕстьРасхождения КАК ЕстьРасхождения,
		|	СостоянияДокументовТрансляции.ИзмененыИсходныеДанные КАК ИзмененыИсходныеДанные,
		|	СостоянияДокументовТрансляции.ИзмененШаблонКорректировки КАК ИзмененШаблонКорректировки
		|ИЗ
		|	РегистрСведений.СостоянияДокументовТрансляции КАК СостоянияДокументовТрансляции
		|ГДЕ
		|	СостоянияДокументовТрансляции.ДокументТрансляции.ИсходныйДокумент = НЕОПРЕДЕЛЕНО";
		
		НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());		
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;		
		
КонецПроцедуры // ЗаполнитьРегистрыСостоянияДокументов() 

	
#КонецЕсли	