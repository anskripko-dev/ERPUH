#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиОбновления

// Процедура заполняет регистр при первоначальном заполнении информационной базы
Процедура ПервоначальноеЗаполнение() Экспорт
	
	ВалютаРубль = НайтиСоздатьВалюту("643", "руб.", "Российский рубль", "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
	ДатаУстановкиКурса = '19800101000000';
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютаРубль", ВалютаРубль);
	Запрос.УстановитьПараметр("ДатаУстановкиКурса", ДатаУстановкиКурса);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыЛимитированияКурсыВалют.Период КАК Период,
	|	ПараметрыЛимитированияКурсыВалют.Валюта КАК Валюта,
	|	ПараметрыЛимитированияКурсыВалют.Курс КАК Курс
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияКурсыВалют КАК ПараметрыЛимитированияКурсыВалют
	|ГДЕ
	|	ПараметрыЛимитированияКурсыВалют.Валюта = &ВалютаРубль
	|	И ПараметрыЛимитированияКурсыВалют.Период = ДАТАВРЕМЯ(1980,1,1,0,0,0)";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияКурсыВалют.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Валюта.Установить(ВалютаРубль);
		НаборЗаписей.Отбор.Период.Установить(ДатаУстановкиКурса);
		
		Движение = НаборЗаписей.Добавить();
		Движение.Валюта = ВалютаРубль;
		Движение.Период = ДатаУстановкиКурса;
		Движение.Курс = 1;
		Движение.Кратность = 1;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);  
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Не удалось записать регистр сведений ""%1"" за период ""%2"" по валюте ""%3"" 
			|%4'"),
			"Курсы валют для целей планирования/лимитирования", 
			Формат(ДатаУстановкиКурса, "ДФ=dd.MM.yyyy"), ВалютаРубль,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  	 
		
	КонецЕсли;    		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	КурсыВалют.Курс КАК Курс,
	|	КурсыВалют.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Валюта <> &ВалютаРубль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("ВалютаРубль", ВалютаРубль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		 МенеджерЗаписи = РегистрыСведений.ПараметрыЛимитированияКурсыВалют.СоздатьМенеджерЗаписи();
		 ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		 
		 Попытка
			 МенеджерЗаписи.Записать();   
		 Исключение
			 ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
			 "ru = 'Не удалось записать регистр сведений ""%1"" за период ""%2"" по валюте ""%3"" 
			 |%4'"),
			 "Курсы валют для целей планирования/лимитирования", 
			 Формат(ВыборкаДетальныеЗаписи.Период, "ДФ=dd.MM.yyyy"), ВыборкаДетальныеЗаписи.Валюта,
			 ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			 
			 ЗаписьЖурналаРегистрации(
			 ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			 УровеньЖурналаРегистрации.Ошибка,
			 ,
			 , 
			 ТекстСообщения);
		 КонецПопытки;  	 
		 
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
Функция НайтиСоздатьВалюту(Код, Наименование, НаименованиеПолное, ПараметрыПрописиНаРусском)
	
	Ссылка = Справочники.Валюты.НайтиПоКоду(Код);
	
	Если Ссылка.Пустая() Тогда
		
		СправочникОбъект = Справочники.Валюты.СоздатьЭлемент();
		
		СправочникОбъект.Код                = Код;
		СправочникОбъект.Наименование       = Наименование;
		СправочникОбъект.НаименованиеПолное = НаименованиеПолное;
		СправочникОбъект.ПараметрыПрописи   = ПараметрыПрописиНаРусском;
		
		СправочникОбъект.Записать();
		
		Ссылка = СправочникОбъект.Ссылка;
		
		// установим курс и кратность = 1 на 1 января 1980
		РаботаСКурсамиВалют.ПроверитьКорректностьКурсаНа01_01_1980(Ссылка);
		
	Иначе
		
		// Рубль может быть создан из классификатора, где он имеет наименование RUB,
		// нам это не подходит, т.к. это поле выводится в печатных формах
		Если Ссылка.Наименование <> Наименование Тогда
			СправочникОбъект = Ссылка.ПолучитьОбъект();
			СправочникОбъект.Наименование = Наименование;
			
			СправочникОбъект.Записать();
			Ссылка = СправочникОбъект.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции
	
#КонецОбласти

#КонецЕсли