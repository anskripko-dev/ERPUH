#Область ИнтерфейсРаботыСВнутригрупповымиПоказателями


// Процедура ищет все показатели, связанные с указанной группой раскрытия
// и сбрасывает признак - внутригрупповой.
//
Процедура СброситьПризнакВнутригрупповойДляПоказателейГруппыРаскрытия(ГруппаРаскрытия) Экспорт
	
	МассивПоказателей = Новый Массив;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПоказателиОтчетов.Ссылка
	                      |ИЗ
	                      |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	                      |ГДЕ
	                      |	ПоказателиОтчетов.ВнутриГрупповой = ИСТИНА
	                      |	И (НЕ ПоказателиОтчетов.ПометкаУдаления)
	                      |	И ПоказателиОтчетов.ГруппаРаскрытия = &ГруппаРаскрытия");
						  
	Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивПоказателей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для Каждого Элемент Из МассивПоказателей Цикл
		
		ОбъектПоказатель = Элемент.ПолучитьОбъект();
		ОбъектПоказатель.ОбменДанными.Загрузка  = Истина;
		ОбъектПоказатель.ВнутриГрупповой = Ложь;
		Попытка
			ОбъектПоказатель.Записать();
			ОчиститьСоответствияВГОДляПоказателей(Элемент);
		Исключение
		Сообщить(СтрШаблон(Нстр("ru = 'Ошибка при записи: %1'"), ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;
КонецПроцедуры

// Процедура убирает записи регистра СоответствиеВнутригрупповыхПоказателей для указанных показателей.
//
Процедура ОчиститьСоответствияВГОДляПоказателей(Показатель) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписейРегистра = РегистрыСведений.СоответствиеВнутригрупповыхПоказателей.СоздатьНаборЗаписей();
	НаборЗаписейРегистра.Отбор.ПоказательБазис.Значение = Показатель;
	НаборЗаписейРегистра.Отбор.ПоказательБазис.Использование = Истина;
	
	НаборЗаписейРегистра.Очистить();
	НаборЗаписейРегистра.Записать();
	
	НаборЗаписейРегистра.Отбор.ПоказательБазис.Использование = Ложь;	
	НаборЗаписейРегистра.Отбор.ПоказательСравнение.Значение = Показатель;
	НаборЗаписейРегистра.Отбор.ПоказательСравнение.Использование = Истина;
	
	НаборЗаписейРегистра.Очистить();
	НаборЗаписейРегистра.Записать();
	
КонецПроцедуры


