
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СКД = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных             = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя         = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя            = "НаборДанных1";
	НаборДанных.ИсточникДанных = "ИсточникДанных";
	
	ТипОбъекта = Параметры.ТипОбъекта;
	
	МетаданныеОбъекта = Неопределено;
	Если ТипОбъекта = Перечисления.ТипыОбъектов.ПериодСценария Тогда
		МетаданныеОбъекта = Метаданные.Справочники.Периоды;
	ИначеЕсли ТипОбъекта = Перечисления.ТипыОбъектов.Сценарий Тогда
		МетаданныеОбъекта = Метаданные.Справочники.Сценарии;
	ИначеЕсли ТипОбъекта = Перечисления.ТипыОбъектов.Организация Тогда
		МетаданныеОбъекта = Метаданные.Справочники.Организации;
	ИначеЕсли ТипОбъекта = Перечисления.ТипыОбъектов.Проект Тогда
		МетаданныеОбъекта = Метаданные.Справочники.Проекты;
	ИначеЕсли ТипОбъекта = Перечисления.ТипыОбъектов.ВидОтчета Тогда
		МетаданныеОбъекта = Метаданные.Справочники.ВидыОтчетов;
	ИначеЕсли ТипЗнч(ТипОбъекта) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконтоКорпоративные") Тогда
		ВидыСубконтоТекущиеДанные = ТипОбъекта;
		Если Не ВидыСубконтоТекущиеДанные = Неопределено Тогда
			ТипЗначенияОбъекта = ТипОбъекта.ТипЗначения.Типы()[0];
			МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначенияОбъекта);
		КонецЕсли;
	КонецЕсли;
	
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	ВставкаЗапроса = "";
	
	Если МетаданныеОбъекта.ДлинаКода Тогда
		Элементы.ЗаполнятьПо.СписокВыбора.Добавить(0, "Код");
	КонецЕсли;
	
	Если МетаданныеОбъекта.ДлинаНаименования Тогда
		Элементы.ЗаполнятьПо.СписокВыбора.Добавить(1, "Наименование");
	КонецЕсли;
	
	ЗаполнятьПо = Элементы.ЗаполнятьПо.СписокВыбора[0].Значение;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	_Справочник.*
	|ИЗ
	|	" + МетаданныеОбъекта.ПолноеИмя()+ " КАК _Справочник";
	
	ОтборПоАналитикам = ТипЗнч(ТипОбъекта) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконтоКорпоративные") и МетаданныеОбъекта.Владельцы.Содержит(Метаданные.ПланыВидовХарактеристик.ВидыСубконтоКорпоративные);
	
	Если ОтборПоАналитикам Тогда
		ТекстЗапроса = ТекстЗапроса + "
		| Где _Справочник.Владелец = &Владелец";
		НовыйПараметр = СКД.Параметры.Добавить();
		НовыйПараметр.Имя = "Владелец";		
		
	КонецЕсли;
	
	НаборДанных.Запрос = ТекстЗапроса;
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	АдресСКД = ПоместитьВоВременноеХранилище(СКД,ЭтаФорма.УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
	
	Если ОтборПоАналитикам Тогда
		
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Владелец", ТипОбъекта);
		
	КонецЕсли;
	
	ТиповыеОтчетыУХ.ДобавитьАвтоВыбранноеПоле(КомпоновщикНастроек.Настройки);
	ТиповыеОтчетыУХ.ДобавитьГруппировку(КомпоновщикНастроек);
	ТиповыеОтчетыУХ.ДобавитьВыбранноеПоле(КомпоновщикНастроек, "Ссылка");
	
	Для Каждого Элемент Из Элементы.ЗаполнятьПо.СписокВыбора Цикл
		ТиповыеОтчетыУХ.ДобавитьВыбранноеПоле(КомпоновщикНастроек, Элемент.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеВРегистр()
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(ПолучитьИзВременногоХранилища(АдресСКД), КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.ОтображатьПроцентВывода = Истина;
	РезультатВыбора = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	НачатьТранзакцию();
	
	Для Инд = 0 По РезультатВыбора.Количество() - 1 Цикл
		
		Выборка = РезультатВыбора[Инд];
		
		Имя = СокрЛП(?(ЗаполнятьПо = 0, Выборка.Код, Выборка.Наименование));
		МенеджерЗаписи = РегистрыСведений.ИменаФайловИКаталогов.СоздатьМенеджерЗаписи();
		Если Прав(Имя,1) = "." Тогда
			Имя = Сред(Имя, 1, СтрДлина(Имя) - 1);
		КонецЕсли;
		МенеджерЗаписи.Имя = ХранимыеФайлыУХ.СформироватьИмяФайла(Имя);
		МенеджерЗаписи.ТипОбъекта = ТипОбъекта;
		МенеджерЗаписи.Объект = Выборка.Ссылка;
		
		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ОписаниеОшибки());
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры


&НаКлиенте
Процедура Сформировать(Команда)
	
	ЗаписатьДанныеВРегистр();
	Оповестить("ИзмененыИменаФайловИКаталогов",ТипОбъекта);
	Закрыть();
	
КонецПроцедуры

