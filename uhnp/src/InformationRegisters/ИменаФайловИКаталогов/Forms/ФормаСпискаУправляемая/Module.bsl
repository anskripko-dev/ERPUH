
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипыЗначений = Новый Структура("Страница_Период, Страница_Сценарий, Страница_Организация , Страница_Проект, Страница_ВидОтчета,СтраницаДокументы"
	  , Перечисления.ТипыОбъектов.ПериодСценария
	  , Перечисления.ТипыОбъектов.Сценарий
	  , Перечисления.ТипыОбъектов.Организация
	  , Перечисления.ТипыОбъектов.Проект
	  , Перечисления.ТипыОбъектов.ВидОтчета
	  , Перечисления.ТипыОбъектов.ДокументПараллельногоУчета);
	
	СоответствиеСписков=Новый Соответствие;
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.ВидОтчета,					"Список_ВидОтчета");
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.ДокументПараллельногоУчета,	"Список_Документы");
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.Организация,					"Список_Организация");
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.Проект,						"Список_Проект");
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.ПериодСценария,				"Список_Период");
	СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов.Сценарий,					"Список_Сценарий");
	
	Для Индекс=1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		СоответствиеСписков.Вставить(Перечисления.ТипыОбъектов["Аналитика"+Индекс],	"Список_Аналитики");
		
	КонецЦикла;
	
	СоответствиеСписковОбъектам=Новый ФиксированноеСоответствие(СоответствиеСписков);
	
	УстановитьОтборПоВидуСубконто();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОрганизацияПередНачаломИзменения(Элемент, Отказ)
	
	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоВидуСубконто()
	
	ТекущаяСтрока = Элементы.ВидыСубконто.ТекущаяСтрока;
	ТиповыеОтчетыУХ.ДобавитьОтбор(Список_Аналитики.Отбор, "ТипОбъекта", ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыСубконтоПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборПоВидуСубконто();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Перем ТипОбъекта;
	
	Если Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя = "Страница_Аналитики" Тогда
		ТипОбъекта = Элементы.ВидыСубконто.ТекущаяСтрока;
	Иначе
		ТипыЗначений.Свойство(Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя, ТипОбъекта);
	КонецЕсли;
	
	ОткрытьФорму("РегистрСведений.ИменаФайловИКаталогов.Форма.ФормаЗаполненияИменФайловИКаталогов_Управляемая", Новый Структура("ТипОБъекта", ТипОБъекта));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ИзмененыИменаФайловИКаталогов" Тогда
		
		ИмяСписка=СоответствиеСписковОбъектам.Получить(Параметр);
		
		Если Не ИмяСписка=Неопределено Тогда
			
			Элементы[ИмяСписка].Обновить();
			
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

