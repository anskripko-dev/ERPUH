
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Ключ.Пустой() Тогда
		ТипПараметров = ПолучитьТипПараметров(Параметры.Ключ);
	КонецЕсли;
	
	ОбновитьОтображение(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипПараметров(Источник)	
	Возврат ?(Источник.Организация.Пустая(), 0, 1);	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидФинансовогоИнструментаПриИзменении(Элемент)
	ОбновитьВидимостьПоВидуФИ(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ТипПараметровПриИзменении(Элемент)	
	ОбновитьОтображение(ЭтаФорма);	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтображение(Форма)
	
	Элементы = Форма.Элементы;
	Запись = Форма.Запись;
	ТипПараметров = Форма.ТипПараметров;
	
	Элементы.ВидФинансовогоИнструмента.Видимость	= (ТипПараметров = 0 ИЛИ ТипПараметров = 1);
	Элементы.Организация.Видимость 					= (ТипПараметров = 1);
		
	ОбновитьВидимостьПоВидуФИ(Форма);
	
	Если ТипПараметров = 0 Тогда		
		Запись.Организация = Неопределено;		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьПоВидуФИ(Форма)
	
	Элементы = Форма.Элементы;	
	ТипПараметров = Форма.ТипПараметров;
	
	СтороныФИ = Новый Массив;
	СтороныФИ.Добавить(ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.Акция"));
	СтороныФИ.Добавить(ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.Вексель"));
	СтороныФИ.Добавить(ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.Облигация"));
	СтороныФИ.Добавить(ПредопределенноеЗначение("Перечисление.ВидыФинансовыхИнструментов.ПрочиеЦенныеБумаги"));
	
	Элементы.Валютный.Видимость = (ТипПараметров = 0 ИЛИ ТипПараметров = 1);
	Элементы.Выданный.Видимость = (ТипПараметров = 0 ИЛИ ТипПараметров = 1) И (СтороныФИ.Найти(Форма.Запись.ВидФинансовогоИнструмента) <> Неопределено);

КонецПроцедуры

#КонецОбласти
