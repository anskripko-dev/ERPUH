
Функция ПолучитьПараметрыФИ(ВидФинансовогоИнструмента, Организация, Валютный = Ложь, Выданный = Неопределено) Экспорт
	
	Запрос = Новый ПостроительЗапроса(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыУчетаОрганизацииФИМСФО.ПараметрыУчетаФИ
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаВидовФИМСФО КАК ПараметрыУчетаОрганизацииФИМСФО
	|ГДЕ
	|	ПараметрыУчетаОрганизацииФИМСФО.ВидФинансовогоИнструмента = &ВидФинансовогоИнструмента
	|	И ПараметрыУчетаОрганизацииФИМСФО.Организация = &Организация
	|	И ПараметрыУчетаОрганизацииФИМСФО.Валютный = &Валютный
	|{ГДЕ
	|	ПараметрыУчетаОрганизацииФИМСФО.Выданный}
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыУчетаФИМСФО.ПараметрыУчетаФИ
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаВидовФИМСФО КАК ПараметрыУчетаФИМСФО
	|ГДЕ
	|	ПараметрыУчетаФИМСФО.ВидФинансовогоИнструмента = &ВидФинансовогоИнструмента
	|	И ПараметрыУчетаФИМСФО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ПараметрыУчетаФИМСФО.Валютный = &Валютный
	|{ГДЕ
	|	ПараметрыУчетаФИМСФО.Выданный}");
	
	Если Выданный <> Неопределено Тогда
		Запрос.Отбор.Добавить("Выданный", "Выданный").Установить(Выданный, Истина);
	КонецЕсли;	
	
	Запрос.Параметры.Вставить("ВидФинансовогоИнструмента", ВидФинансовогоИнструмента);
	Запрос.Параметры.Вставить("Организация", Организация);
	Запрос.Параметры.Вставить("Валютный", Валютный);
	
	РезультатЗапроса = Запрос.ПолучитьЗапрос().Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.ПараметрыУчетаФинансовыхИнструментовМСФО.ПустаяСсылка();
	Иначе 
		Возврат РезультатЗапроса.Выгрузить()[0].ПараметрыУчетаФИ;
	КонецЕсли;	
	
КонецФункции
