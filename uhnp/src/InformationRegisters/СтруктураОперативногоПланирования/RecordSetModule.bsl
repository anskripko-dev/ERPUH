#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВидБюджета") И НЕ ДанныеЗаполнения.Свойство("Предназначение") Тогда
			ДанныеЗаполнения.Вставить("Предназначение", ПланыВидовХарактеристик.ВидыБюджетов.Предназначение(ДанныеЗаполнения.ВидБюджета));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.Аналитика = Справочники.АналитикиОперативногоПланирования.ДокументПланирования Тогда
			ТекстСообщения = НСтр("ru = 'Аналитика ""Документ планирования"" не может быть выбрана в качестве аналитики оперативного планирования.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Запись.Аналитика", , Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отбор.Найти("Предназначение") <> Неопределено Тогда
		Предназначение = Отбор.Предназначение.Значение;
		ВозможнаЗапись = РегистрыСведений.СтруктураОперативногоПланирования.ВозможноИзменениеСтруктуры(Предназначение);
	ИначеЕсли Отбор.Найти("ВидБюджета") <> Неопределено Тогда
		Предназначение = ПланыВидовХарактеристик.ВидыБюджетов.Предназначение(Отбор.ВидБюджета.Значение);
		ВозможнаЗапись = РегистрыСведений.СтруктураОперативногоПланирования.ВозможноИзменениеСтруктуры(Предназначение);
	КонецЕсли;
	
	Если ВозможнаЗапись = Ложь Тогда
		Шаблон = НСтр("ru = 'По виду бюджета %1 есть проведенные документы ""Операционный план"". Изменение структуры оперативного планирования запрещено.'");
		
		ТекстСообщения = СтрШаблон(Шаблон, Предназначение);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Запись.ВидБюджета", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли