
Перем СтруктураНастроек;

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураНастроек) Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.Администратор И Запись.УИДПользователя > 0 тогда
			
			МенеджерЗаписи = РегистрыСведений.ТелеграмНастройки.СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураНастроек);
				
			Попытка
				МенеджерЗаписи.Прочитать();
				МенеджерЗаписи.AdminChatId = Запись.УИДПользователя;
				МенеджерЗаписи.Записать();
			Исключение
			КонецПопытки;
									
		КонецЕсли;
		
		Если Запись.УИДПользователя = 0 тогда
			ТелеграмСерверУХ.ОчиститьИсториюСообщений(,, Запись.ТелеграмИмя, Запись.ТелеграмФамилия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек = ТелеграмСерверУХ.ПолучитьНастройкиTelegram();
	
	ТекстСообщения = "";
		
	Если НЕ ЗначениеЗаполнено(СтруктураНастроек.token) тогда
		ТекстСообщения = НСтр("ru = 'В настройках Telegram-бота не заполнен ""token"";'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТелеграмСерверУХ.ПодключениеТелеграмДляОповещений();
		
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Не ЗначениеЗаполнено(Запись.УИДПользователя) тогда
			
			НомерТелефона = СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(Запись.Телефон, "(", ""), ")", ""), "-", ""));
			
			Если СтрДлина(НомерТелефона) = 12 И СтруктураНастроек.AdminChatId <> 0 тогда
				
				HTTPСоединение = Новый HTTPСоединение(СтруктураНастроек.api, 443,,,,, Новый ЗащищенноеСоединениеOpenSSL());
				
				Приемник = "bot" + СтруктураНастроек.token + "/sendContact?chat_id=" + Формат(СтруктураНастроек.AdminChatId, "ЧДЦ=; ЧГ=") + "&phone_number=" + НомерТелефона + "&first_name=Admin";
				
				HTTPЗапрос = Новый HTTPЗапрос(Приемник);
				HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
				
				Если HTTPОтвет.КодСостояния = 200 Тогда
					
					Источник = "bot" + СтруктураНастроек.token + "/getUpdates";
					HTTPЗапрос = Новый HTTPЗапрос(Источник);	
					HTTPОтвет2 = HTTPСоединение.Получить(HTTPЗапрос);
					
					Если HTTPОтвет2.КодСостояния = 200 Тогда
						
						Данные = ТелеграмСерверУХ.ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
						
						Если Данные.ok И Данные.result.Количество()>0 Тогда
							
							УИДПользователя = Данные.result.contact.user_id;
							
							Приемник = "bot" + СтруктураНастроек.token + "/deleteMessage?chat_id=" + Формат(СтруктураНастроек.AdminChatId, "ЧДЦ=; ЧГ=") + "&message_id=" + Формат(Данные.result.message_id, "ЧДЦ=; ЧГ=");
							
							HTTPЗапрос = Новый HTTPЗапрос(Приемник);
							HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
							
							Запись.УИДПользователя = УИДПользователя;
							
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли СтрДлина(НомерТелефона) = 12 И СтруктураНастроек.AdminChatId = 0
				И НЕ (ЗначениеЗаполнено(Запись.ТелеграмИмя) И ЗначениеЗаполнено(Запись.ТелеграмФамилия)) тогда
				
				Если СтруктураНастроек.AdminChatId = 0 тогда	
					ТекстСообщения = НСтр("ru = 'Используйте идентификацию по имени и фамилии'");
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
					
					Продолжить;			
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

СтруктураНастроек = Неопределено;
