Процедура ДобавитьЗапись(Объект, БазаРеспондент) Экспорт  
		
	МенеджерЗаписи = РегистрыСведений.тн_ИсточникиЗагруженныхОбъектов.СоздатьМенеджерЗаписи();
	
	// Измерения 
	МенеджерЗаписи.Объект 				= Объект;
	// Ресурсы
	МенеджерЗаписи.БазаРеспондент 		= БазаРеспондент;
	// Реквизиты
	МенеджерЗаписи.Тип 					= Строка(ТипЗнч(Объект));
	МенеджерЗаписи.ГУИД 				= Строка(Объект.УникальныйИдентификатор());	
	
	МенеджерЗаписи.Записать();
		
КонецПроцедуры

Функция ПолучитьСтурктуруЗначенийЗаписи() Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ЗапретитьЗагрузку", Ложь);
	СтруктураВозврата.Вставить("НужнаЗапись", Ложь);
	СтруктураВозврата.Вставить("БазаРеспондентИсточник", Неопределено);	
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ПроверкаЭлементаНаСоответствиеБазыИсточника(Объект, БазаРеспондент, СтурктураЗначенийЗаписи) Экспорт  
		
	СтруктураОтбора = Новый Структура("Объект", Объект);
	
	ВыборкаЗаписей = РегистрыСведений.тн_ИсточникиЗагруженныхОбъектов.Выбрать(СтруктураОтбора);
		
	Если ВыборкаЗаписей.Следующий() Тогда
		Если ВыборкаЗаписей.БазаРеспондент <> БазаРеспондент Тогда
			СтурктураЗначенийЗаписи.ЗапретитьЗагрузку = Истина;
			СтурктураЗначенийЗаписи.БазаРеспондентИсточник = ВыборкаЗаписей.БазаРеспондент; 
		КонецЕсли;
	Иначе
		СтурктураЗначенийЗаписи.НужнаЗапись = Истина;
	КонецЕсли;
		
КонецПроцедуры

