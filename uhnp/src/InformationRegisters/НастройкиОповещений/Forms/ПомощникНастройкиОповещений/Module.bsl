&НаСервере
Перем ПредставлениеДействиеИзменениеОповещениеВключено, ПредставлениеДействиеУдалениеОповещения;

&НаКлиенте 
Перем МожноЗакрывать;

// Проверяет совпадение данных измерений регистра НастройкиОповещений 
// в структурах СтруктураИсточникВход и СтруктураПриемникВход.
&НаКлиентеНаСервереБезКонтекста
Функция СтруктурыИзмеренийСовпадают(СтруктураИсточникВход, СтруктураПриемникВход, ВсеНастройкиВход = Неопределено)
	РезультатФункции = Ложь;
	СовпадаютКатегории = (СтруктураИсточникВход.КатегорияОповещения = СтруктураПриемникВход.КатегорияОповещения);
	СовпадаютВидыСобытий = (СтруктураИсточникВход.ВидСобытияОповещения = СтруктураПриемникВход.ВидСобытияОповещения);
	СовпадаютТипыОбъектов = (СтруктураИсточникВход.ТипОбъектаОповещения = СтруктураПриемникВход.ТипОбъектаОповещения);
	СовпадаютВидыОбъектов = (СтруктураИсточникВход.ВидОбъектаОповещения = СтруктураПриемникВход.ВидОбъектаОповещения);
	Если ВсеНастройкиВход = Неопределено Тогда
		СовпадаютВсеНастройки = Истина;
	Иначе
		СовпадаютВсеНастройки = (СтруктураИсточникВход.ВсеНастройки = СтруктураПриемникВход.ВсеНастройки);
	КонецЕсли;
	РезультатФункции = (СовпадаютКатегории И СовпадаютВидыСобытий И СовпадаютТипыОбъектов И СовпадаютВидыОбъектов И СовпадаютВсеНастройки);
	Возврат РезультатФункции;
КонецФункции

// Возвращает строку дерева на форме со структурой СтруктураВход.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокуДереваПоСтруктуре(ДеревоВход, СтруктураВход, УчитыватьВсеНастройки = Ложь, ГлубинаРекурсииВход = 0)
	// Защита от бесконечной рекурсии.
	Если ГлубинаРекурсииВход > 10000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Инициализация.
	РезультатФункции = Неопределено;
	ПодчиненныеСтроки = ДеревоВход.ПолучитьЭлементы();
	Для Каждого ТекПодчиненныеСтроки Из ПодчиненныеСтроки Цикл
		Если РезультатФункции = Неопределено Тогда
			// Сравнение структур с учетом различных значений параметра УчитыватьВсеНастройки.
			Если УчитыватьВсеНастройки Тогда
				РезультатСравнения = СтруктурыИзмеренийСовпадают(ТекПодчиненныеСтроки, СтруктураВход, СтруктураВход.ВсеНастройки);
			Иначе
				РезультатСравнения = СтруктурыИзмеренийСовпадают(ТекПодчиненныеСтроки, СтруктураВход);
			КонецЕсли;
			// Обработка полученного результата: возврат результат либо продолжение рекурсивного обхода.
			Если РезультатСравнения Тогда
				РезультатФункции = ТекПодчиненныеСтроки;
				Возврат РезультатФункции;
			Иначе
				РезультатФункции = НайтиСтрокуДереваПоСтруктуре(ТекПодчиненныеСтроки, СтруктураВход, УчитыватьВсеНастройки, ГлубинаРекурсииВход + 1);
			КонецЕсли;
		Иначе
			Возврат РезультатФункции;		// Решение найдено.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции

// Возвращает уровень строки в дереве по структуре измерений СтруктураВход.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьУровеньСтруктурыСтроки(СтруктураВход)
	РезультатФункции = 1;
	// Получим уровень строки согласно заполнению измерений.
	Если СтруктураВход.ВидСобытияОповещения = Неопределено Тогда
		РезультатФункции = 1;
	ИначеЕсли СтруктураВход.ТипОбъектаОповещения = Неопределено Тогда
		РезультатФункции = 2;
	ИначеЕсли СтруктураВход.ВидОбъектаОповещения = Неопределено Тогда
		РезультатФункции = 3;	
	Иначе
		РезультатФункции = 4;	
	КонецЕсли;
	// Сделаем корректировку на запись ВсеНастройки.
	Если ОбщегоназначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураВход, "ВсеНастройки") Тогда
		Если СтруктураВход.ВсеНастройки Тогда
			РезультатФункции = РезультатФункции + 1;
		Иначе
			// Линейная запись настроек. Не изменяем результат.
		КонецЕсли;
	Иначе
		// Нет данных. Не изменяем результат.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Возвращает строку дерева значений на форме со структурой СтруктураВход.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокуДереваЗначений(ДеревоВход, СтруктураВход, ВсеНастройки = Неопределено, ГлубинаРекурсииВход = 0)
	Если ГлубинаРекурсииВход > 10000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	РезультатФункции = Неопределено;
	ПодчиненныеСтроки = ДеревоВход.Строки;
	Для Каждого ТекПодчиненныеСтроки Из ПодчиненныеСтроки Цикл
		Если РезультатФункции = Неопределено Тогда
			Если СтруктурыИзмеренийСовпадают(ТекПодчиненныеСтроки, СтруктураВход, ВсеНастройки) Тогда
				РезультатФункции = ТекПодчиненныеСтроки;
				Возврат РезультатФункции;
			Иначе
				РезультатФункции = НайтиСтрокуДереваЗначений(ТекПодчиненныеСтроки, СтруктураВход, ВсеНастройки, ГлубинаРекурсииВход + 1);
			КонецЕсли;
		Иначе
			Возврат РезультатФункции;		// Решение найдено.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции

// Возвращает идентификатор строки у дерева ДеревоВход с измерениями СтруктураВход.
// Когда параметр УровеьВход не равен нулю, будет получен родитель указанного уровня.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоВход, Знач СтруктураВход, УровеньВход = 0, УчитыватьВсеНастройки = Ложь)
	РезультатФункции = -1;
	УровеньЗаписи = ПолучитьУровеньСтруктурыСтроки(СтруктураВход);
	Если УровеньВход = 3 Тогда
		СтруктураВход.Вставить("ВидОбъектаОповещения", Неопределено);
	ИначеЕсли УровеньВход = 2 Тогда	
		СтруктураВход.Вставить("ВидОбъектаОповещения", Неопределено);
		СтруктураВход.Вставить("ТипОбъектаОповещения", Неопределено);
	ИначеЕсли УровеньВход = 1 Тогда	
		СтруктураВход.Вставить("ВидОбъектаОповещения", Неопределено);
		СтруктураВход.Вставить("ТипОбъектаОповещения", Неопределено);
		СтруктураВход.Вставить("ВидСобытияОповещения", Неопределено);
	Иначе
		// Не изменяем структуру поиска.
	КонецЕсли;
	Если (УровеньЗаписи > УровеньВход) И (УровеньВход <> 0) Тогда
		НайденнаяСтрока = НайтиСтрокуДереваПоСтруктуре(ДеревоВход, СтруктураВход);
	Иначе	
		НайденнаяСтрока = НайтиСтрокуДереваПоСтруктуре(ДеревоВход, СтруктураВход, УчитыватьВсеНастройки);
	КонецЕсли;
	Если НайденнаяСтрока <> Неопределено Тогда
		РезультатФункции = НайденнаяСтрока.ПолучитьИдентификатор();
	Иначе
		РезультатФункции = -1;
	КонецЕсли;
	Возврат РезультатФункции;	
КонецФункции

// Добавляет в строку дерева РодительскаяСтрокаВход подчинённую строку <Все типы объектов>
//с измерениями из структуры СтруктураИзмеренийВход и с использованием ИспользованиеВход.
&НаСервере
Функция ДобавитьПодчиненнуюСтрокуВсеТипыОбъектов(РодительскаяСтрокаВход, СтруктураИзмеренийВход, ИспользованиеВход, ИзмененШаблонВход = Ложь, ЕстьДопОповещаемыеВход = Ложь)
	НоваяСтрокаТипОбъектаОповещения = РодительскаяСтрокаВход.Строки.Добавить();
	НоваяСтрокаТипОбъектаОповещения.ЭлементНастройки		 = Строка(НСтр("ru = '<Все объекты>'"));
	НоваяСтрокаТипОбъектаОповещения.Использование			 = ИспользованиеВход;
	НоваяСтрокаТипОбъектаОповещения.ИзмененШаблон			 = ИзмененШаблонВход;
	НоваяСтрокаТипОбъектаОповещения.ЕстьДопОповещаемые		 = ЕстьДопОповещаемыеВход;
	НоваяСтрокаТипОбъектаОповещения.КатегорияОповещения		 = СтруктураИзмеренийВход.КатегорияОповещения;
	НоваяСтрокаТипОбъектаОповещения.ВидСобытияОповещения	 = СтруктураИзмеренийВход.ВидСобытияОповещения;
	НоваяСтрокаТипОбъектаОповещения.ТипОбъектаОповещения	 = Неопределено;
	НоваяСтрокаТипОбъектаОповещения.ВидОбъектаОповещения	 = Неопределено;
	НоваяСтрокаТипОбъектаОповещения.ВсеНастройки			 = Истина;
	НоваяСтрокаТипОбъектаОповещения.УровеньСтроки			 = 3;
КонецФункции

// Добавляет в строку дерева РодительскаяСтрокаВход подчинённую строку <Все виды объектов> 
//с измерениями из структуры СтруктураИзмеренийВход и с использованием ИспользованиеВход.
&НаСервере
Функция ДобавитьПодчиненнуюСтрокуВсеВидыОбъектов(РодительскаяСтрокаВход, СтруктураИзмеренийВход, ИспользованиеВход, ИзмененшаблонВход = Ложь, ЕстьДопОповещаемыеВход = Ложь)
	НоваяСтрокаВидОбъектаОповещения = РодительскаяСтрокаВход.Строки.Добавить();
	НоваяСтрокаВидОбъектаОповещения.ЭлементНастройки		 = Строка(НСтр("ru = '<Все виды объектов>'"));
	НоваяСтрокаВидОбъектаОповещения.Использование			 = ИспользованиеВход;
	НоваяСтрокаВидОбъектаОповещения.ИзмененШаблон			 = ИзмененшаблонВход;
	НоваяСтрокаВидОбъектаОповещения.ЕстьДопОповещаемые		 = ЕстьДопОповещаемыеВход;
	НоваяСтрокаВидОбъектаОповещения.КатегорияОповещения		 = СтруктураИзмеренийВход.КатегорияОповещения;
	НоваяСтрокаВидОбъектаОповещения.ВидСобытияОповещения	 = СтруктураИзмеренийВход.ВидСобытияОповещения;
	НоваяСтрокаВидОбъектаОповещения.ТипОбъектаОповещения	 = СтруктураИзмеренийВход.ТипОбъектаОповещения;
	НоваяСтрокаВидОбъектаОповещения.ВидОбъектаОповещения	 = Неопределено;
	НоваяСтрокаВидОбъектаОповещения.ВсеНастройки			 = Истина;
	НоваяСтрокаВидОбъектаОповещения.УровеньСтроки			 = 4;
КонецФункции
					
// Заполняет дерево настроек данными из БД.
&НаСервере
Процедура СчитатьДеревоНастроек()
	// Инициализация дерева.
	ДеревоПостроение = Новый ДеревоЗначений;
	ДеревоПостроение.Колонки.Добавить("ЭлементНастройки");
	ДеревоПостроение.Колонки.Добавить("Использование");
	ДеревоПостроение.Колонки.Добавить("ИзмененШаблон");
	ДеревоПостроение.Колонки.Добавить("ЕстьДопОповещаемые");
	ДеревоПостроение.Колонки.Добавить("КатегорияОповещения");
	ДеревоПостроение.Колонки.Добавить("ВидСобытияОповещения");
	ДеревоПостроение.Колонки.Добавить("ТипОбъектаОповещения");
	ДеревоПостроение.Колонки.Добавить("ВидОбъектаОповещения");
	ДеревоПостроение.Колонки.Добавить("ВсеНастройки");
	ДеревоПостроение.Колонки.Добавить("УровеньСтроки");
	ДеревоПостроение.Колонки.Добавить("ИспользованиеРасш");
	ДеревоПостроение.Колонки.Добавить("ИзмененШаблонРасш");
	ДеревоПостроение.Колонки.Добавить("ЕстьДопОповещаемыеРасш");
	// Считывание данных из БД.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыСобытийОповещений.Ссылка КАК ВидСобытия
	|ПОМЕСТИТЬ ВТ_ВсеСобытия
	|ИЗ
	|	Справочник.ВидыСобытийОповещений КАК ВидыСобытийОповещений
	|ГДЕ
	|	НЕ ВидыСобытийОповещений.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &ОтбиратьОповещения
	|				ТОГДА ВидыСобытийОповещений.Ссылка В (&СобытияОповещения)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ВсеСобытия.ВидСобытия.КатегорияСобытия КАК КатегорияОповещения,
	|	ВТ_ВсеСобытия.ВидСобытия КАК ВидСобытияОповещения,
	|	НастройкиОповещений.ТипОбъектаОповещения КАК ТипОбъектаОповещения,
	|	НастройкиОповещений.ВидОбъектаОповещения КАК ВидОбъектаОповещения,
	|	НастройкиОповещений.ШаблонОповещения КАК ШаблонОповещения,
	|	НастройкиОповещений.СписокРассылкиПредставление КАК СписокРассылкиПредставление,
	|	НастройкиОповещений.СписокРассылки КАК СписокРассылки,
	|	ЕСТЬNULL(НастройкиОповещений.ОповещениеВключено, ЛОЖЬ) КАК ОповещениеВключено,
	|	НастройкиОповещений.ПериодНапоминания КАК ПериодНапоминания,
	|	НастройкиОповещений.ИнтервалВремениНапоминания КАК ИнтервалВремениНапоминания,
	|	ЕСТЬNULL(НастройкиОповещений.СписокРассылкиПредставление <> """", ЛОЖЬ) КАК ЕстьДопОповещаемые,
	|	ЕСТЬNULL(НастройкиОповещений.ШаблонОповещения.НестандартныйШаблон, ЛОЖЬ) КАК ИзмененШаблон
	|ИЗ
	|	ВТ_ВсеСобытия КАК ВТ_ВсеСобытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОповещений КАК НастройкиОповещений
	|		ПО (НастройкиОповещений.ВидСобытияОповещения = ВТ_ВсеСобытия.ВидСобытия)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиОповещений.КатегорияОповещения.Наименование,
	|	НастройкиОповещений.ВидСобытияОповещения.Наименование,
	|	НастройкиОповещений.ТипОбъектаОповещения.Наименование,
	|	НастройкиОповещений.ВидОбъектаОповещения.Наименование
	|ИТОГИ
	|	МАКСИМУМ(ОповещениеВключено),
	|	МАКСИМУМ(ЕстьДопОповещаемые),
	|	МАКСИМУМ(ИзмененШаблон)
	|ПО
	|	КатегорияОповещения,
	|	ВидСобытияОповещения,
	|	ТипОбъектаОповещения,
	|	ВидОбъектаОповещения";
	Если ОтборСобытий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("СобытияОповещения", ОтборСобытий);
		Запрос.УстановитьПараметр("ОтбиратьОповещения", Истина);
	Иначе
		Запрос.УстановитьПараметр("СобытияОповещения", Новый СписокЗначений);
		Запрос.УстановитьПараметр("ОтбиратьОповещения", Ложь);
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	// Категории.
	ВыборкаКатегории = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КатегорияОповещения");
	Пока ВыборкаКатегории.Следующий() Цикл
		НоваяСтрокаКатегория = ДеревоПостроение.Строки.Добавить();
		НоваяСтрокаКатегория.ЭлементНастройки		 = Строка(ВыборкаКатегории.КатегорияОповещения);
		НоваяСтрокаКатегория.Использование			 = ВыборкаКатегории.ОповещениеВключено;
		НоваяСтрокаКатегория.ИзмененШаблон			 = ВыборкаКатегории.ИзмененШаблон;
		НоваяСтрокаКатегория.КатегорияОповещения	 = ВыборкаКатегории.КатегорияОповещения;
		НоваяСтрокаКатегория.ВидСобытияОповещения	 = Неопределено;
		НоваяСтрокаКатегория.ТипОбъектаОповещения	 = Неопределено;
		НоваяСтрокаКатегория.ВидОбъектаОповещения	 = Неопределено;
		НоваяСтрокаКатегория.ЕстьДопОповещаемые		 = ВыборкаКатегории.ЕстьДопОповещаемые;
		НоваяСтрокаКатегория.ВсеНастройки			 = Ложь;
		НоваяСтрокаКатегория.УровеньСтроки			 = 1;
		// Виды событий.
		ВыборкаВидСобытия = ВыборкаКатегории.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидСобытияОповещения");
		Пока ВыборкаВидСобытия.Следующий() Цикл
			НоваяСтрокаВидСобытия = НоваяСтрокаКатегория.Строки.Добавить();
			НоваяСтрокаВидСобытия.ЭлементНастройки		 = Строка(ВыборкаВидСобытия.ВидСобытияОповещения);
			НоваяСтрокаВидСобытия.Использование			 = ВыборкаВидСобытия.ОповещениеВключено;
			НоваяСтрокаВидСобытия.ИзмененШаблон			 = ВыборкаВидСобытия.ИзмененШаблон;
			НоваяСтрокаВидСобытия.КатегорияОповещения	 = ВыборкаВидСобытия.КатегорияОповещения;
			НоваяСтрокаВидСобытия.ВидСобытияОповещения	 = ВыборкаВидСобытия.ВидСобытияОповещения;
			НоваяСтрокаВидСобытия.ТипОбъектаОповещения	 = Неопределено;
			НоваяСтрокаВидСобытия.ВидОбъектаОповещения	 = Неопределено;
			НоваяСтрокаВидСобытия.ЕстьДопОповещаемые	 = ВыборкаВидСобытия.ЕстьДопОповещаемые;
			НоваяСтрокаВидСобытия.ВсеНастройки			 = Ложь;
			НоваяСтрокаВидСобытия.УровеньСтроки			 = 2;
			// Типы объектов оповещений.
			ВыборкаТипОбъектаОповещения = ВыборкаВидСобытия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ТипОбъектаОповещения");
			СчетчикТипОбъекта = 0;
			ИспользованиеПустого		 = Ложь;
			ИзмененШаблонПустого		 = Ложь;
			ЕстьДопОповещаемыеПустого	 = Ложь;
			Пока ВыборкаТипОбъектаОповещения.Следующий() Цикл
				Если НЕ ЗначениеЗаполнено(ВыборкаТипОбъектаОповещения.ТипОбъектаОповещения) Тогда
					ИспользованиеПустого		 = ВыборкаТипОбъектаОповещения.ОповещениеВключено;
					ИзмененШаблонПустого		 = ВыборкаТипОбъектаОповещения.ИзмененШаблон;
					ЕстьДопОповещаемыеПустого	 = ВыборкаТипОбъектаОповещения.ЕстьДопОповещаемые;
					Продолжить;			// Пустой элемент.
				Иначе
					// Выполняем далее.
				КонецЕсли;
				НоваяСтрокаТипОбъектаОповещения = НоваяСтрокаВидСобытия.Строки.Добавить();
				НоваяСтрокаТипОбъектаОповещения.ЭлементНастройки		 = Строка(ВыборкаТипОбъектаОповещения.ТипОбъектаОповещения);
				НоваяСтрокаТипОбъектаОповещения.Использование			 = ВыборкаТипОбъектаОповещения.ОповещениеВключено;
				НоваяСтрокаТипОбъектаОповещения.ИзмененШаблон			 = ВыборкаТипОбъектаОповещения.ИзмененШаблон;
				НоваяСтрокаТипОбъектаОповещения.КатегорияОповещения		 = ВыборкаТипОбъектаОповещения.КатегорияОповещения;
				НоваяСтрокаТипОбъектаОповещения.ВидСобытияОповещения	 = ВыборкаТипОбъектаОповещения.ВидСобытияОповещения;
				НоваяСтрокаТипОбъектаОповещения.ТипОбъектаОповещения	 = ВыборкаТипОбъектаОповещения.ТипОбъектаОповещения;
				НоваяСтрокаТипОбъектаОповещения.ВидОбъектаОповещения	 = Неопределено;
				НоваяСтрокаТипОбъектаОповещения.ЕстьДопОповещаемые		 = ВыборкаТипОбъектаОповещения.ЕстьДопОповещаемые;
				НоваяСтрокаТипОбъектаОповещения.ВсеНастройки			 = Ложь;
				НоваяСтрокаТипОбъектаОповещения.УровеньСтроки			 = 3;
				// Виды объектов (виды операций) оповещений.
				ВыборкаВидОбъектаОповещения = ВыборкаТипОбъектаОповещения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидОбъектаОповещения");
				СчетчикВидОбъекта = 0;
				ИспользованиеПустогоВидаОбъекта		 = Ложь;
				ИзмененШаблонПустогоВидаОбъекта		 = Ложь;
				ЕстьДоОповещаемыеПустогоВидаОбъекта	 = Ложь;
				Пока ВыборкаВидОбъектаОповещения.Следующий() Цикл
					Если НЕ ЗначениеЗаполнено(ВыборкаВидОбъектаОповещения.ВидОбъектаОповещения) Тогда
						ИспользованиеПустогоВидаОбъекта		 = ВыборкаВидОбъектаОповещения.ОповещениеВключено;
						ИзмененШаблонПустогоВидаОбъекта		 = ВыборкаВидОбъектаОповещения.ИзмененШаблон;
						ЕстьДоОповещаемыеПустогоВидаОбъекта	 = ВыборкаВидОбъектаОповещения.ЕстьДопОповещаемые;
						Продолжить;			// Пустой элемент.
					Иначе
						// Выполняем далее.
					КонецЕсли;
					НоваяСтрокаВидОбъектаОповещения = НоваяСтрокаТипОбъектаОповещения.Строки.Добавить();
					НоваяСтрокаВидОбъектаОповещения.ЭлементНастройки		 = Строка(ВыборкаВидОбъектаОповещения.ВидОбъектаОповещения);
					НоваяСтрокаВидОбъектаОповещения.Использование			 = ВыборкаВидОбъектаОповещения.ОповещениеВключено;
					НоваяСтрокаВидОбъектаОповещения.ИзмененШаблон			 = ВыборкаВидОбъектаОповещения.ИзмененШаблон;
					НоваяСтрокаВидОбъектаОповещения.КатегорияОповещения		 = ВыборкаВидОбъектаОповещения.КатегорияОповещения;
					НоваяСтрокаВидОбъектаОповещения.ВидСобытияОповещения	 = ВыборкаВидОбъектаОповещения.ВидСобытияОповещения;
					НоваяСтрокаВидОбъектаОповещения.ТипОбъектаОповещения	 = ВыборкаВидОбъектаОповещения.ТипОбъектаОповещения;
					НоваяСтрокаВидОбъектаОповещения.ВидОбъектаОповещения	 = ВыборкаВидОбъектаОповещения.ВидОбъектаОповещения;
					НоваяСтрокаВидОбъектаОповещения.ЕстьДопОповещаемые		 = ВыборкаВидОбъектаОповещения.ЕстьДопОповещаемые;
					НоваяСтрокаВидОбъектаОповещения.ВсеНастройки			 = Ложь;
					НоваяСтрокаВидОбъектаОповещения.УровеньСтроки			 = 4;
					СчетчикВидОбъекта = СчетчикВидОбъекта + 1;
				КонецЦикла;
				Если СчетчикВидОбъекта > 0 Тогда
					// Все виды объектов.
					ДобавитьПодчиненнуюСтрокуВсеВидыОбъектов(НоваяСтрокаТипОбъектаОповещения, ВыборкаТипОбъектаОповещения, ИспользованиеПустогоВидаОбъекта, ИзмененШаблонПустогоВидаОбъекта, ЕстьДоОповещаемыеПустогоВидаОбъекта);
				Иначе
					НоваяСтрокаТипОбъектаОповещения.ВсеНастройки		 = Ложь;
					НоваяСтрокаТипОбъектаОповещения.УровеньСтроки		 = 3;
				КонецЕсли;
				СчетчикТипОбъекта = СчетчикТипОбъекта + 1;
				НоваяСтрокаТипОбъектаОповещения.Строки.Сортировать("ЭлементНастройки Возр", Ложь);
			КонецЦикла;
			Если СчетчикТипОбъекта > 0 Тогда
				// Все типы объектов.
				НовыйТипОбъекта = МодульУправленияОповещениямиУХ.ПолучитьТипОбъектаПоВидуОповещения(ВыборкаВидСобытия.ВидСобытияОповещения);
				Если НовыйТипОбъекта = Неопределено Тогда
					ДобавитьПодчиненнуюСтрокуВсеТипыОбъектов(НоваяСтрокаВидСобытия, ВыборкаВидСобытия, ИспользованиеПустого, ИзмененШаблонПустого, ЕстьДопОповещаемыеПустого);
				Иначе
					// Данное событие определено только для одного объекта.
				КонецЕсли;
			Иначе
				НоваяСтрокаВидСобытия.ВсеНастройки		 = Ложь;
				НоваяСтрокаВидСобытия.УровеньСтроки		 = 2;
			КонецЕсли;
			НоваяСтрокаВидСобытия.Строки.Сортировать("ЭлементНастройки Возр", Ложь);
		КонецЦикла;
		НоваяСтрокаКатегория.Строки.Сортировать("ЭлементНастройки Возр", Ложь);
	КонецЦикла;
	ДеревоПостроение.Строки.Сортировать("ЭлементНастройки Возр", Ложь);
	// Вывод сформированного дерева на форму.
	ЗначениеВРеквизитФормы(ДеревоПостроение, "ДеревоНастроек");
	ТаблицаИзменений.Очистить();
	ЭтаФорма.Модифицированность = Ложь;
КонецПроцедуры

// Проверяет существование единственной записи регистра Настройки оповещений 
// по структуре.
&НаСервере
Функция НайтиЗаписиОповещения(СтруктураИзмеренийВход)
	РезультатФункции = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(НастройкиОповещений.ТипОбъектаОповещения) КАК КоличествоТипОбъектаОповещения
		|ИЗ
		|	РегистрСведений.НастройкиОповещений КАК НастройкиОповещений
		|ГДЕ
		|	НастройкиОповещений.КатегорияОповещения = &КатегорияОповещения
		|	И НастройкиОповещений.ВидСобытияОповещения = &ВидСобытияОповещения
		|	И НастройкиОповещений.ТипОбъектаОповещения = &ТипОбъектаОповещения
		|	И НастройкиОповещений.ВидОбъектаОповещения = &ВидОбъектаОповещения";
	Запрос.УстановитьПараметр("ВидОбъектаОповещения",	 СтруктураИзмеренийВход.ВидОбъектаОповещения);
	Запрос.УстановитьПараметр("ВидСобытияОповещения",	 СтруктураИзмеренийВход.ВидСобытияОповещения);
	Запрос.УстановитьПараметр("КатегорияОповещения",	 СтруктураИзмеренийВход.КатегорияОповещения);
	Запрос.УстановитьПараметр("ТипОбъектаОповещения",	 СтруктураИзмеренийВход.ТипОбъектаОповещения);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатФункции = (Выборка.КоличествоТипОбъектаОповещения = 1);
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции

// Добавляет/изменяет в таблицу изменений настроек по структуре СтруктураИзмеренийВход, 
// ИспользованиеВход устанавливает новое значение ОповещениеВключено.
&НаСервере
Процедура ДобавитьИзменениеНастройкиОповещений(СтруктураИзмеренийВход, ИспользованиеВход)
	// Получение параметров.
	Если ЗначениеЗаполнено(СтруктураИзмеренийВход.ТипОбъектаОповещения) Тогда
		ТипОбъектаОповещенияРабочий = СтруктураИзмеренийВход.ТипОбъектаОповещения;
	Иначе
		ТипОбъектаОповещенияРабочий = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураИзмеренийВход.ВидОбъектаОповещения) Тогда
		ВидОбъектаОповещенияРабочий = СтруктураИзмеренийВход.ВидОбъектаОповещения;
	Иначе
		ВидОбъектаОповещенияРабочий = Неопределено;
	КонецЕсли;
	// Поиск уже существующих строк.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КатегорияОповещения", СтруктураИзмеренийВход.КатегорияОповещения);
	СтруктураПоиска.Вставить("ВидСобытияОповещения", СтруктураИзмеренийВход.ВидСобытияОповещения);
	СтруктураПоиска.Вставить("ТипОбъектаОповещения", ТипОбъектаОповещенияРабочий);
	СтруктураПоиска.Вставить("ВидОбъектаОповещения", ВидОбъектаОповещенияРабочий);
	НайденныеСтроки = ТаблицаИзменений.НайтиСтроки(СтруктураПоиска);
	// Изменение данных в таблице.
	Если НайденныеСтроки.Количество() > 0 Тогда
		// Строки найдены. Изменим существующие.
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			ТекНайденныеСтроки.ОповещениеВключено	 = ИспользованиеВход;
			ТекНайденныеСтроки.ДействиеИзменения	 = ПредставлениеДействиеИзменениеОповещениеВключено;
		КонецЦикла;
	Иначе
		// Строки не найдены. Добавим новую.
		НоваяСтрока = ТаблицаИзменений.Добавить();
		НоваяСтрока.КатегорияОповещения		 = СтруктураИзмеренийВход.КатегорияОповещения;
		НоваяСтрока.ВидСобытияОповещения	 = СтруктураИзмеренийВход.ВидСобытияОповещения;
		НоваяСтрока.ТипОбъектаОповещения	 = ТипОбъектаОповещенияРабочий;
		НоваяСтрока.ВидОбъектаОповещения	 = ВидОбъектаОповещенияРабочий;
		НоваяСтрока.ОповещениеВключено		 = ИспользованиеВход;
		НоваяСтрока.ДействиеИзменения		 = ПредставлениеДействиеИзменениеОповещениеВключено;
	КонецЕсли;
КонецПроцедуры

// Добавлеяет изменения настроек из массива структур измерений МассивИзмененийВход.
&НаСервере
Процедура ДобавитьМассивИзмененийСтруктурыНастроек(МассивИзмененийВход, ИспользованиеВход)
	Для Каждого ТекМассивИзмененийВход Из МассивИзмененийВход Цикл
		ДобавитьИзменениеНастройкиОповещений(ТекМассивИзмененийВход, ИспользованиеВход);
	КонецЦикла;
КонецПроцедуры

// Добавляет/изменяет в таблицу удаление настроек по структуре СтруктураИзмеренийВход.
&НаСервере
Процедура ДобавитьУдалениеНастройкиОповещений(СтруктураИзмеренийВход)
	// Получение параметров.
	Если ЗначениеЗаполнено(СтруктураИзмеренийВход.ТипОбъектаОповещения) Тогда
		ТипОбъектаОповещенияРабочий = СтруктураИзмеренийВход.ТипОбъектаОповещения;
	Иначе
		ТипОбъектаОповещенияРабочий = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураИзмеренийВход.ВидОбъектаОповещения) Тогда
		ВидОбъектаОповещенияРабочий = СтруктураИзмеренийВход.ВидОбъектаОповещения;
	Иначе
		ВидОбъектаОповещенияРабочий = Неопределено;
	КонецЕсли;
	// Поиск уже существующих строк.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КатегорияОповещения", СтруктураИзмеренийВход.КатегорияОповещения);
	СтруктураПоиска.Вставить("ВидСобытияОповещения", СтруктураИзмеренийВход.ВидСобытияОповещения);
	СтруктураПоиска.Вставить("ТипОбъектаОповещения", ТипОбъектаОповещенияРабочий);
	СтруктураПоиска.Вставить("ВидОбъектаОповещения", ВидОбъектаОповещенияРабочий);
	НайденныеСтроки = ТаблицаИзменений.НайтиСтроки(СтруктураПоиска);
	// Изменение данных в таблице.
	Если НайденныеСтроки.Количество() > 0 Тогда
		// Строки найдены. Изменим существующие.
		Для Каждого ТекНайденныеСтроки Из НайденныеСтроки Цикл
			ТекНайденныеСтроки.ДействиеИзменения	 = ПредставлениеДействиеУдалениеОповещения;
		КонецЦикла;
	Иначе
		// Строки не найдены. Добавим новую.
		НоваяСтрока = ТаблицаИзменений.Добавить();
		НоваяСтрока.КатегорияОповещения		 = СтруктураИзмеренийВход.КатегорияОповещения;
		НоваяСтрока.ВидСобытияОповещения	 = СтруктураИзмеренийВход.ВидСобытияОповещения;
		НоваяСтрока.ТипОбъектаОповещения	 = ТипОбъектаОповещенияРабочий;
		НоваяСтрока.ВидОбъектаОповещения	 = ВидОбъектаОповещенияРабочий;
		НоваяСтрока.ДействиеИзменения		 = ПредставлениеДействиеУдалениеОповещения;
	КонецЕсли;
КонецПроцедуры

// Вносит изменения в базу данных согласно таблице изменений.
&НаСервере
Функция ПрименитьИзмененияПоТаблице()
	НачатьТранзакцию();
	ЕстьОшибки = Ложь;
	Для Каждого ТекТаблицаИзменений Из ТаблицаИзменений Цикл    
		Если ЗначениеЗаполнено(ТекТаблицаИзменений.ТипОбъектаОповещения) Тогда
			ТипОбъектаОповещенияРабочий = ТекТаблицаИзменений.ТипОбъектаОповещения;
		Иначе
			ТипОбъектаОповещенияРабочий = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекТаблицаИзменений.ВидОбъектаОповещения) Тогда
			ВидОбъектаОповещенияРабочий = ТекТаблицаИзменений.ВидОбъектаОповещения;
		Иначе
			ВидОбъектаОповещенияРабочий = Неопределено;
		КонецЕсли;
		Если ТекТаблицаИзменений.ДействиеИзменения = ПредставлениеДействиеИзменениеОповещениеВключено Тогда
			// Изменение существующих/добавление новых настроек.
			Попытка
				НаборЗаписей = РегистрыСведений.НастройкиОповещений.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КатегорияОповещения.Установить(ТекТаблицаИзменений.КатегорияОповещения);
				НаборЗаписей.Отбор.ВидСобытияОповещения.Установить(ТекТаблицаИзменений.ВидСобытияОповещения);
				НаборЗаписей.Отбор.ТипОбъектаОповещения.Установить(ТипОбъектаОповещенияРабочий);
				НаборЗаписей.Отбор.ВидОбъектаОповещения.Установить(ВидОбъектаОповещенияРабочий);
				НаборЗаписей.Прочитать();
				Если НаборЗаписей.Количество() > 0 Тогда
					// Настройки найдены. Изменим их.
					Для Каждого ТекНаборЗаписей Из НаборЗаписей Цикл
						ТекНаборЗаписей.ОповещениеВключено = ТекТаблицаИзменений.ОповещениеВключено;
					КонецЦикла;
				Иначе
					// Настройки не найдены. Добавим новые.
					НоваяСтрока = НаборЗаписей.Добавить();
					НоваяСтрока.КатегорияОповещения		 = ТекТаблицаИзменений.КатегорияОповещения;
					НоваяСтрока.ВидСобытияОповещения	 = ТекТаблицаИзменений.ВидСобытияОповещения;
					НоваяСтрока.ТипОбъектаОповещения	 = ТипОбъектаОповещенияРабочий;
					НоваяСтрока.ВидОбъектаОповещения	 = ВидОбъектаОповещенияРабочий;
					НоваяСтрока.ОповещениеВключено		 = ТекТаблицаИзменений.ОповещениеВключено;
					СтруктураИзмерений = Новый Структура;
					СтруктураИзмерений.Вставить("КатегорияОповещения", ТекТаблицаИзменений.КатегорияОповещения);
					СтруктураИзмерений.Вставить("ВидСобытияОповещения", ТекТаблицаИзменений.ВидСобытияОповещения);
					СтруктураИзмерений.Вставить("ТипОбъектаОповещения", ТекТаблицаИзменений.ТипОбъектаОповещения);
					СтруктураИзмерений.Вставить("ВидОбъектаОповещения", ТекТаблицаИзменений.ВидОбъектаОповещения);
					НовыйШаблон = УправлениеШаблонамиУХ.СоздатьШаблонПоСтруктуреСобытия(СтруктураИзмерений, Истина);
					НоваяСтрока.ШаблонОповещения = НовыйШаблон;
				КонецЕсли;
				НаборЗаписей.Записать();	
			Исключение
				ТекстСообщения = НСтр("ru = 'Возникли ошибки при записи настроек для события %ВидСобытия%: %ОписаниеОшибки%. Операция будет отменена.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ВидСобытия%", Строка(ТекТаблицаИзменений.ВидСобытияОповещения));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				ЕстьОшибки = Истина;
			КонецПопытки;
		ИначеЕсли ТекТаблицаИзменений.ДействиеИзменения = ПредставлениеДействиеУдалениеОповещения Тогда
			// Удаление существующих настроек.
			Попытка
				НаборЗаписей = РегистрыСведений.НастройкиОповещений.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КатегорияОповещения.Установить(ТекТаблицаИзменений.КатегорияОповещения);
				НаборЗаписей.Отбор.ВидСобытияОповещения.Установить(ТекТаблицаИзменений.ВидСобытияОповещения);
				НаборЗаписей.Отбор.ТипОбъектаОповещения.Установить(ТипОбъектаОповещенияРабочий);
				НаборЗаписей.Отбор.ВидОбъектаОповещения.Установить(ВидОбъектаОповещенияРабочий);
				НаборЗаписей.Прочитать();
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();	
			Исключение
				ТекстСообщения = НСтр("ru = 'Возникли ошибки при удалении настроек для события %ВидСобытия%: %ОписаниеОшибки%. Операция будет отменена.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ВидСобытия%", Строка(ТекТаблицаИзменений.ВидСобытияОповещения));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				ЕстьОшибки = Истина;
			КонецПопытки;
		Иначе
			// Неизвестный вариант. Сообщим пользователю.
			ТекстСообщения = НСтр("ru = 'Неизвестный вариант произведенных изменений: %ПредставлениеИзменения%. Операция отменена.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ПредставлениеИзменения%", Строка(ТекТаблицаИзменений.ДействиеИзменения));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОшибки Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
		ТаблицаИзменений.Очистить();
	КонецЕсли;
КонецФункции

// Устанавливает доступность и видимость элементов.
&НаСервере
Процедура УправлениеДоступностью()
	Элементы.ПрименитьИзменения.Доступность = ЭтаФорма.Модифицированность;
	Элементы.ОтменитьИзменения.Доступность = ЭтаФорма.Модифицированность;
КонецПроцедуры

// Возвращает количество подчинённых строк для строки дерева СтрокаДереваВход.
// Когда СтрокаДереваВход является структурой - будет найдена соответственная строка.
&НаСервере
Функция КоличествоПодчиненныхСтрок(СтрокаДереваВход)
	РезультатФункции = 0;
	Если ТипЗнч(СтрокаДереваВход) = Тип("Структура") Тогда
		ДеревоЗначение = РеквизитФормыВЗначение("ДеревоНастроек");
		НайденнаяСтрока = НайтиСтрокуДереваЗначений(ДеревоЗначение, СтрокаДереваВход, Ложь);
		ПодчиненныеСтроки = НайденнаяСтрока.Строки;
	Иначе	
		ПодчиненныеСтроки = СтрокаДереваВход.Строки;
	КонецЕсли;
	РезультатФункции = (ПодчиненныеСтроки.Количество());
	Возврат РезультатФункции;
КонецФункции

// Определяет, требуется ли добавление элемента <Все типы объектов> / <Все виды объектов>
// в подчиненные строки в узле дерева СтрокаДерева.
&НаСервере
Функция ТребуетсяДобавлениеВсеЭлементы(СтрокаДерева)
	РезультатФункции = Ложь;
	ЗаполненаКатегория = ЗначениеЗаполнено(СтрокаДерева.КатегорияОповещения); 
	ЗаполненВидСобытия = ЗначениеЗаполнено(СтрокаДерева.ВидСобытияОповещения);
	НетПодчиненныхСтрок = (КоличествоПодчиненныхСтрок(СтрокаДерева) = 0);
	РезультатФункции = НетПодчиненныхСтрок И ЗаполненаКатегория И ЗаполненВидСобытия;
	Возврат РезультатФункции;
КонецФункции

// Добавляет в дереве на форме в строку с измерениями СтруктураРодительскойЗаписи
// новую строку со структурой реквизитов СтруктурураДобавлемойЗаписи.
&НаСервере
Процедура ДобавитьСтрокуДерева(СтруктураРодительскойЗаписи, СтруктурураДобавляемойЗаписи)
	// Получение исходных данных.
	ДеревоПостроение = РеквизитФормыВЗначение("ДеревоНастроек");
	СтрокаДерева = НайтиСтрокуДереваЗначений(ДеревоПостроение, СтруктураРодительскойЗаписи);
	Если СтрокаДерева <> Неопределено Тогда
		// Добавление строк Все элементы.
		ТребуетсяДобавление = ТребуетсяДобавлениеВсеЭлементы(СтрокаДерева);
		Если ТребуетсяДобавление Тогда
			Если НЕ ЗначениеЗаполнено(СтруктураРодительскойЗаписи.ТипОбъектаОповещения) Тогда
				// Добавим элемент <Все типы объектов>.
				НовыйТипОбъекта = МодульУправленияОповещениямиУХ.ПолучитьТипОбъектаПоВидуОповещения(СтрокаДерева.ВидСобытияОповещения);
				Если НовыйТипОбъекта = Неопределено Тогда
					ДобавитьПодчиненнуюСтрокуВсеТипыОбъектов(СтрокаДерева, СтруктураРодительскойЗаписи, Ложь);
				Иначе
					// Данное событие определено только для одного объекта.
				КонецЕсли;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтруктураРодительскойЗаписи.ВидОбъектаОповещения) Тогда
				// Добавим элемент <Все виды объектов>.
				ДобавитьПодчиненнуюСтрокуВсеВидыОбъектов(СтрокаДерева, СтруктураРодительскойЗаписи, Ложь);
			Иначе	
				// Не добавляем на нижний уровень.
			КонецЕсли;
		Иначе
			// Не нужно добавлять Все элементы.
		КонецЕсли;
		// Добавление основых строк.
		ПодчиненныеСтроки = СтрокаДерева.Строки;
		НоваяСтрока = ПодчиненныеСтроки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктурураДобавляемойЗаписи);
		// Вывод изменённого дерева.
		ЗначениеВРеквизитФормы(ДеревоПостроение, "ДеревоНастроек");
	Иначе
		ТекстСообщения = НСтр("ru = 'Не найдена строка с выбранным набором измерений. Обновление дерева отменено.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

// Рекурсивно обходит дерево значений ДеревоВход, удаляет строку 
// с измерениями из структуры СтруктураВход.
&НаСервере
Функция УдалитьСтрокуВУзлахДерева(СтруктураВход, ДеревоВход, ГлубинаРекурсии = 0)
	Если ГлубинаРекурсии > 10000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	РезультатФункции = Неопределено;
	СтрокиДерева = ДеревоВход.Строки;
	Для Каждого ТекСтрокиДерева Из СтрокиДерева Цикл
		Если РезультатФункции = Неопределено Тогда
			Если СтруктурыИзмеренийСовпадают(ТекСтрокиДерева, СтруктураВход, СтруктураВход.ВсеНастройки) Тогда
				РезультатФункции = ТекСтрокиДерева.Родитель;
				СтрокиДерева.Удалить(ТекСтрокиДерева);
				Возврат РезультатФункции;
			Иначе
				РезультатФункции = УдалитьСтрокуВУзлахДерева(СтруктураВход, ТекСтрокиДерева, ГлубинаРекурсии + 1);
			КонецЕсли;
		Иначе
			Возврат РезультатФункции;		// Строка найдена. Удаление уже произошло.
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции

// Удаляет из дерева на форме строку по измерениям СтруктураВход.
&НаСервере
Процедура УдалитьСтрокуДерева(СтруктураВход)
	ДеревоПостроение = РеквизитФормыВЗначение("ДеревоНастроек");
	РодительСтроки = УдалитьСтрокуВУзлахДерева(СтруктураВход, ДеревоПостроение);
	ЗначениеВРеквизитФормы(ДеревоПостроение, "ДеревоНастроек");
	НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, РодительСтроки);
	Если НайденнаяСтрока <> -1 Тогда
		Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
	Иначе
		// Не найдена строка. Не изменяем позиционирование.
	КонецЕсли;
КонецПроцедуры

// Возвращает значение подчиненных для флажка элемента дерева ДеревоВход. 
// Устанавливает текущему значению.
&НаКлиенте
Функция ПолучитьФлажокДочерних(ДеревоВход, ИмяПоляДанныхВход, ИмяПоляПредставленияВход)
	ДочерниеЭлементы = ДеревоВход.ПолучитьЭлементы();
	РезультатФункции = -1;         				// Значения флажков: -1 - не инициализировано; 0 - Ложь; 1 - Истина; 2 - Неизвестно ("серый");
	Если ДочерниеЭлементы.Количество() > 0 Тогда
		// Обойдём дочерние элементы.
		Для Каждого ТекДочерниеЭлементы Из ДочерниеЭлементы Цикл
			ТекФлажок = ПолучитьФлажокДочерних(ТекДочерниеЭлементы, ИмяПоляДанныхВход, ИмяПоляПредставленияВход);
			// Сравним значения подчинённых элементов с текущими.
			Если ТекФлажок = 2 Тогда
				РезультатФункции = 2;		// Подчинённые под вопросом. Текущий выставляем также.
			ИначеЕсли (ТекФлажок = 0 ИЛИ ТекФлажок = 1) Тогда
				// Есть определённое значение для подчинённых.
				Если (РезультатФункции = -1) Тогда 
					РезультатФункции = ТекФлажок;			// Текущий пока не инициализирован. Инициализируем значением подчинённых.
				ИначеЕсли РезультатФункции <> ТекФлажок Тогда
					РезультатФункции = 2;					// Подчинённые отличаются от текущего. Выставляем неизвесный вариант.
				ИначеЕсли РезультатФункции = ТекФлажок Тогда
					РезультатФункции = ТекФлажок;			// Подчинённые совпадают с текущим. Выставляем его.
				Иначе
					РезультатФункции = 2;					// Неизвестный вариант. Возвращаем его.
				КонецЕсли;
			Иначе
				РезультатФункции = 2;						// Неизвестный вариант. Возвращаем его.
			КонецЕсли;
		КонецЦикла;
		// Выставим использование текущего элемента.
		Если ТипЗнч(ДеревоВход) = Тип("ДанныеФормыЭлементДерева") Тогда
			ДеревоВход[ИмяПоляПредставленияВход] = РезультатФункции;
		Иначе
			// Корень дерева. Не изменяем.
		КонецЕсли;
	Иначе
		Если ДеревоВход[ИмяПоляДанныхВход] Тогда
			РезультатФункции = 1;
		Иначе
			РезультатФункции = 0;
		КонецЕсли;
		ДеревоВход[ИмяПоляПредставленияВход] = РезультатФункции;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// Устанавливает расширенные флажки согласно данным основных.
&НаКлиенте
Функция РасставитьФлажки()
	ПолучитьФлажокДочерних(ДеревоНастроек, "Использование", "ИспользованиеРасш");
	ПолучитьФлажокДочерних(ДеревоНастроек, "ИзмененШаблон", "ИзмененШаблонРасш");
	ПолучитьФлажокДочерних(ДеревоНастроек, "ЕстьДопОповещаемые", "ЕстьДопОповещаемыеРасш");
КонецФункции

// Возвращает структуру, содержащую измерения регистра НастройкаОповещений по текущей 
// выбранной строке в списке на форме.
&НаКлиенте
Функция ПолучитьСтруктуруПоВыбраннойСтроке(СтрокаДереваВход = Неопределено)
	Если СтрокаДереваВход = Неопределено Тогда
		ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Иначе
		ТекДанные = СтрокаДереваВход;
	КонецЕсли;
	СтруктураИзмерений = Новый Структура;
	Если ТекДанные <> Неопределено Тогда
		// Данные получены. Запоним выходную структуру по ним.
		СтруктураИзмерений.Вставить("КатегорияОповещения", ТекДанные.КатегорияОповещения);
		СтруктураИзмерений.Вставить("ВидСобытияОповещения", ТекДанные.ВидСобытияОповещения);
		СтруктураИзмерений.Вставить("ТипОбъектаОповещения", ТекДанные.ТипОбъектаОповещения);
		СтруктураИзмерений.Вставить("ВидОбъектаОповещения", ТекДанные.ВидОбъектаОповещения);
		СтруктураИзмерений.Вставить("УдалитьВидОбъектаОповещения", Неопределено);
		СтруктураИзмерений.Вставить("ВсеНастройки", ТекДанные.ВсеНастройки);
	Иначе
		// Нет исходных данных. Вернём структуру с пустыми значениями.
		СтруктураИзмерений.Вставить("КатегорияОповещения", Неопределено);
		СтруктураИзмерений.Вставить("ВидСобытияОповещения", Неопределено);
		СтруктураИзмерений.Вставить("ТипОбъектаОповещения", Неопределено);
		СтруктураИзмерений.Вставить("ВидОбъектаОповещения", Неопределено);
		СтруктураИзмерений.Вставить("УдалитьВидОбъектаОповещения", Неопределено);
		СтруктураИзмерений.Вставить("ВсеНастройки", Ложь);
	КонецЕсли;
	Возврат СтруктураИзмерений;
КонецФункции

// Сворачивает дерево на форме.
&НаКлиенте
Процедура СвернутьДерево()
	ЭлементыДереваНастроек = ДеревоНастроек.ПолучитьЭлементы();
	Для Каждого ТекЭлементыДереваНастроек Из ЭлементыДереваНастроек Цикл 
		ТекИдентификатор = ТекЭлементыДереваНастроек.ПолучитьИдентификатор();
		Элементы.ДеревоНастроек.Свернуть(ТекИдентификатор);
		ЭлементыВторойУровень = ТекЭлементыДереваНастроек.ПолучитьЭлементы();
		Для Каждого ТекЭлементыВторойУровень Из ЭлементыВторойУровень Цикл
			ТекИдентификатор = ТекЭлементыВторойУровень.ПолучитьИдентификатор();
			Элементы.ДеревоНастроек.Свернуть(ТекИдентификатор);
			ЭлементыТретийУровень = ТекЭлементыВторойУровень.ПолучитьЭлементы();
			Для Каждого ТекЭлементыТретийУровень Из ЭлементыТретийУровень Цикл
				ТекИдентификатор = ТекЭлементыТретийУровень.ПолучитьИдентификатор();
				Элементы.ДеревоНастроек.Свернуть(ТекИдентификатор);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Сворачивает дерево на форме и после разворачивает его до уровня УровеньВход.
&НаКлиенте
Процедура РазвернутьДеревоДоУровня(УровеньВход)
	// Первый уровень.
	СвернутьДерево();
	// Второй уровень.
	Если УровеньВход <= 1 Тогда
		Возврат;
	Иначе
		// Разворачиваем дерево дальше.
	КонецЕсли;
	ЭлементыДереваНастроек = ДеревоНастроек.ПолучитьЭлементы();
	Для Каждого ТекЭлементыДереваНастроек Из ЭлементыДереваНастроек Цикл 
		ТекИдентификатор = ТекЭлементыДереваНастроек.ПолучитьИдентификатор();
		Элементы.ДеревоНастроек.Развернуть(ТекИдентификатор);
		// Третий уровень.
		Если УровеньВход <= 2 Тогда
			Продолжить;
		Иначе
			// Разворачиваем дерево дальше.
		КонецЕсли;
		ЭлементыВторойУровень = ТекЭлементыДереваНастроек.ПолучитьЭлементы();
		Для Каждого ТекЭлементыВторойУровень Из ЭлементыВторойУровень Цикл
			ТекИдентификатор = ТекЭлементыВторойУровень.ПолучитьИдентификатор();
			Элементы.ДеревоНастроек.Развернуть(ТекИдентификатор);
			// Четвертый уровень.
			Если УровеньВход <= 3 Тогда
				Продолжить;
			Иначе
				// Разворачиваем дерево дальше.
			КонецЕсли;
			ЭлементыТретийУровень = ТекЭлементыВторойУровень.ПолучитьЭлементы();
			Для Каждого ТекЭлементыТретийУровень Из ЭлементыТретийУровень Цикл
				ТекИдентификатор = ТекЭлементыТретийУровень.ПолучитьИдентификатор();
				Элементы.ДеревоНастроек.Развернуть(ТекИдентификатор);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Добавляет в массив МассивИзменений структуры с измерениями подчиненных
&НаКлиенте
Процедура ЗаполнитьМассивИспользованиеПодчиненных(РодительскийЭлементВход, ИспользованиеВход, МассивИзменений, ГлубинаРекурсииВход = 0);
	Если ГлубинаРекурсииВход > 10000 Тогда
		Возврат;
	КонецЕсли;
	ДочерниеЭлементы = РодительскийЭлементВход.ПолучитьЭлементы();
	Для Каждого ТекДочерниеЭлементы Из ДочерниеЭлементы Цикл
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке(ТекДочерниеЭлементы);
		МассивИзменений.Добавить(СтруктураИзмерений);
		ТекДочерниеЭлементы.Использование = ИспользованиеВход;
		ЗаполнитьМассивИспользованиеПодчиненных(ТекДочерниеЭлементы, ИспользованиеВход, МассивИзменений);
	КонецЦикла;
КонецПроцедуры

// Разворачивает дерево до уровня УровеньВход и сохраняет выделенной текущую строку.
&НаКлиенте
Процедура РазвернутьУровеньССохранениемСтроки(УровеньВход)
	СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();
	НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, СтруктураИзмерений, УровеньВход, Истина);
	РазвернутьДеревоДоУровня(УровеньВход);
	Если НайденнаяСтрока <> -1 Тогда
		Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
	Иначе
		// Не найдена строка. Не изменяем позиционирование.
	КонецЕсли;
КонецПроцедуры

// Обновляет данные в дереве, не меняя позиции строки.
&НаКлиенте
Процедура СчитатьДеревоНастроекССохранениемСтроки()
	СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();
	СчитатьДеревоНастроек();
	РасставитьФлажки();
	НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, СтруктураИзмерений, , Истина);
	Если НайденнаяСтрока <> -1 Тогда
		Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
	Иначе
		// Не найдена строка. Не изменяем позиционирование.
	КонецЕсли;
КонецПроцедуры

// Преобразует строку таблицы формы ДанныеЭлементФормыВход в структуру измерений.
&НаКлиенте
Функция ПреобразоватьСтрокуЭлементаФормыВСтруктуруИзмерений(ДанныеЭлементФормыВход)
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("КатегорияОповещения", ДанныеЭлементФормыВход.КатегорияОповещения);
	РезультатФункции.Вставить("ВидСобытияОповещения", ДанныеЭлементФормыВход.ВидСобытияОповещения);
	РезультатФункции.Вставить("ТипОбъектаОповещения", ДанныеЭлементФормыВход.ТипОбъектаОповещения);
	РезультатФункции.Вставить("ВидОбъектаОповещения", ДанныеЭлементФормыВход.ВидОбъектаОповещения);
	РезультатФункции.Вставить("ВсеНастройки", ДанныеЭлементФормыВход.ВсеНастройки);
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтборСобытий = Параметры.ОтборСобытий.Скопировать();
	СчитатьДеревоНастроек();
	УправлениеДоступностью();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	Если ЭтаФорма.Модифицированность Тогда
		Оповещение = Новый ОписаниеОповещения("ОбновитьДанныеЗавершение", ЭтотОбъект); 
		ТекстВопроса = НСтр("ru = 'Считывание настроек из базы повлечёт к потере введённых изменений. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СчитатьДеревоНастроекССохранениемСтроки();
		УправлениеДоступностью();
	КонецЕсли;
	РасставитьФлажки();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		СчитатьДеревоНастроекССохранениемСтроки();
		УправлениеДоступностью();
	Иначе
		// Пользователь отказался. Ничего не делаем.		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();
		ТекКоличествоПодчиненныхСтрок = КоличествоПодчиненныхСтрок(СтруктураИзмерений);
		Если ТекКоличествоПодчиненныхСтрок = 0 Тогда
			Если НайтиЗаписиОповещения(СтруктураИзмерений) Тогда
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(СтруктураИзмерений); 
				СтруктураИзмерений.Удалить("ВсеНастройки");
				КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.НастройкиОповещений", МассивПараметров);
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
				ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", ПараметрыФормы);
			Иначе
				ЕстьТипОбъекта = ЗначениеЗаполнено(СтруктураИзмерений.ТипОбъектаОповещения);
				ЕстьВидСобытия = ЗначениеЗаполнено(СтруктураИзмерений.ВидСобытияОповещения);
				ЭтоВсеНастройки = СтруктураИзмерений.ВсеНастройки;
				Если (Не ЕстьТипОбъекта) И (ЕстьВидСобытия) И (НЕ ЭтоВсеНастройки) Тогда
					// Проверим, можно ли получить однозначно тип объекта. В случае существования такой возможности - дозаполним структуру.
					НовыйТипОбъекта = МодульУправленияОповещениямиУХ.ПолучитьТипОбъектаПоВидуОповещения(СтруктураИзмерений.ВидСобытияОповещения);
					Если ЗначениеЗаполнено(НовыйТипОбъекта) Тогда
						СтруктураИзмерений.Вставить("ТипОбъектаОповещения", НовыйТипОбъекта);
					Иначе
						// Нельзя однозначно определить тип объекта. Оставляем поле незаполненным.
					КонецЕсли;
				Иначе
					// Оставляем структуру.
				КонецЕсли;
				СтруктураИзмерений.Удалить("ВсеНастройки");	
				ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", СтруктураИзмерений);
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Для изменения настроек по элементу %ЭлементНастройки%, пожалуйста, воспользуйтесь подчинёнными строками.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭлементНастройки%", Строка(ТекДанные.ЭлементНастройки));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастроекИспользованиеПриИзменении(Элемент)
	ЭтаФорма.Модифицированность = Истина;
	ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		МассивИзменений = Новый Массив;
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();
		ДобавитьИзменениеНастройкиОповещений(СтруктураИзмерений, ТекДанные.Использование);
		ЗаполнитьМассивИспользованиеПодчиненных(ТекДанные, ТекДанные.Использование, МассивИзменений);
		ДобавитьМассивИзмененийСтруктурыНастроек(МассивИзменений, ТекДанные.Использование);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	РасставитьФлажки();
	УправлениеДоступностью();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьУровень1(Команда)
	РазвернутьУровеньССохранениемСтроки(1);
КонецПроцедуры

