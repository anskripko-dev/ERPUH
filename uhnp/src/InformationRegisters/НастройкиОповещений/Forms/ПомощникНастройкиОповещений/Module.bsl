КонецПроцедуры

&НаКлиенте
Процедура ВыборТипаДобавляемогоОбъекта_Завершение(Выбор, ПараметрыОповещения)  Экспорт
	Если ЗначениеЗаполнено(Выбор) Тогда
		СтруктураДобавления = Новый Структура;
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();		
		СтруктураДобавления.Вставить("КатегорияОповещения", СтруктураИзмерений.КатегорияОповещения);
		СтруктураДобавления.Вставить("ВидСобытияОповещения", СтруктураИзмерений.ВидСобытияОповещения);
		СтруктураДобавления.Вставить("ТипОбъектаОповещения", Выбор);
		СтруктураДобавления.Вставить("ВидОбъектаОповещения", Неопределено);
		ИспользованиеСтроки = Истина;
		СтруктураДобавления.Вставить("Использование", ИспользованиеСтроки);
		СтруктураДобавления.Вставить("УровеньСтроки", 3);
		СтруктураДобавления.Вставить("ЭлементНастройки", Строка(Выбор));
		ДобавитьСтрокуДерева(СтруктураИзмерений, СтруктураДобавления);
		СтруктураИзмерений.Вставить("ТипОбъектаОповещения", Выбор);
		НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, СтруктураИзмерений);
		Если НайденнаяСтрока <> -1 Тогда
			Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
		Иначе
			// Не найдена строка. Не изменяем позиционирование.
		КонецЕсли;
		УправлениеДоступностью();
		ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", СтруктураИзмерений, , Истина);
	Иначе
		// Пользователь отказался от выбора. Не добавляем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент = Неопределено Тогда
        // Пользователь отказался. Ничего не делаем
	Иначе
		СтрокаОткрытияФормы = "Справочник.СправочникиБД.ФормаВыбора";
		Если ВыбранныйЭлемент.Значение = "СправочникБД" Тогда
			СтрокаОткрытияФормы = "Справочник.СправочникиБД.ФормаВыбора";
		ИначеЕсли ВыбранныйЭлемент.Значение = "ДокументБД" Тогда	
			СтрокаОткрытияФормы = "Справочник.ДокументыБД.ФормаВыбора";
		Иначе
			ТекстСообщения = НСтр("ru = 'Неизвестный вариант типа данных: %ТипДанных%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипДанных%", Строка(ВыбранныйЭлемент));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			СтрокаОткрытияФормы = "Справочник.СправочникиБД.ФормаВыбора";
		КонецЕсли;
		ПараметрыФормы = Новый Структура;
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Владелец", ПредопределенноеЗначение("Справочник.ТипыБазДанных.ТекущаяИБ"));
		СтруктураОтбора.Вставить("Согласуется", Истина);
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ВыборТипаДобавляемогоОбъекта_Завершение", ЭтаФорма);
		ОткрытьФорму(СтрокаОткрытияФормы, ПараметрыФормы, , , , , ОписаниеОповещенияОЗакрытии)
    КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ВыборВидаОбъектаОповещения_Завершение(Выбор, ПараметрыОповещения) Экспорт
	Если ЗначениеЗаполнено(Выбор) Тогда
		СтруктураДобавления = Новый Структура;
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();			
		СтруктураДобавления.Вставить("КатегорияОповещения", СтруктураИзмерений.КатегорияОповещения);
		СтруктураДобавления.Вставить("ВидСобытияОповещения", СтруктураИзмерений.ВидСобытияОповещения);
		СтруктураДобавления.Вставить("ТипОбъектаОповещения", СтруктураИзмерений.ТипОбъектаОповещения);
		СтруктураДобавления.Вставить("ВидОбъектаОповещения", Выбор);
		ИспользованиеСтроки = Истина;
		СтруктураДобавления.Вставить("Использование", ИспользованиеСтроки);
		СтруктураДобавления.Вставить("УровеньСтроки", 4);
		СтруктураДобавления.Вставить("ЭлементНастройки", Строка(Выбор));
		ДобавитьСтрокуДерева(СтруктураИзмерений, СтруктураДобавления);
		СтруктураИзмерений.Вставить("ВидОбъектаОповещения", Выбор);
		НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, СтруктураИзмерений);
		Если НайденнаяСтрока <> -1 Тогда
			Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
		Иначе
			// Не найдена строка. Не изменяем позиционирование.
		КонецЕсли;
		УправлениеДоступностью();
		ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", СтруктураИзмерений, , Истина);
	Иначе
		// Пользователь отказался от выбора. Не добавляем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОповещение(Команда)
	ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		СтруктураИзмерений = ПреобразоватьСтрокуЭлементаФормыВСтруктуруИзмерений(ТекДанные);
		ЕстьКатегория = ЗначениеЗаполнено(СтруктураИзмерений.КатегорияОповещения);
		ЕстьВидСобытия = ЗначениеЗаполнено(СтруктураИзмерений.ВидСобытияОповещения);
		ЕстьТипОбъекта = ЗначениеЗаполнено(СтруктураИзмерений.ТипОбъектаОповещения);
		ЕстьВидОбъекта = ЗначениеЗаполнено(СтруктураИзмерений.ВидОбъектаОповещения);
		ЭтоВсеНастройки = ТекДанные.ВсеНастройки;
		Если ЕстьКатегория И ЕстьВидСобытия И НЕ (ЭтоВсеНастройки) Тогда
			Если ЕстьТипОбъекта И НЕ ЕстьВидОбъекта Тогда
				// Вид объекта.
				НовоеОграничениеТипа = МодульУправленияОповещениямиУХ.ПолучитьОграниченияТипаДляВидаОбъектаОповещения(СтруктураИзмерений.КатегорияОповещения, СтруктураИзмерений.ВидСобытияОповещения, СтруктураИзмерений.ТипОбъектаОповещения);
				СтрокаОткрытияФормы = "";
				Если ОбщегоНазначенияУХ.СодержитТипВПодсистеме(НовоеОграничениеТипа, "СправочникСсылка.ВидыОперацийУХ", "ПодсистемыУХ.КорпоративноеКазначейство") Тогда
					СтрокаОткрытияФормы = "Справочник.ВидыОперацийУХ.ФормаВыбора";
				ИначеЕсли НовоеОграничениеТипа.СодержитТип(Тип("СправочникСсылка.ШаблоныУниверсальныхПроцессов")) Тогда
					СтрокаОткрытияФормы = "Справочник.ШаблоныУниверсальныхПроцессов.ФормаВыбора";
				ИначеЕсли НовоеОграничениеТипа.СодержитТип(Тип("СправочникСсылка.ЭтапыУниверсальныхПроцессов")) Тогда
					СтрокаОткрытияФормы = "Справочник.ЭтапыУниверсальныхПроцессов.ФормаВыбора";
				ИначеЕсли НовоеОграничениеТипа.СодержитТип(Тип("СправочникСсылка.ВидыОтчетов")) Тогда
					СтрокаОткрытияФормы = "Справочник.ВидыОтчетов.ФормаВыбора";
				Иначе	
					СтрокаОткрытияФормы = "";
				КонецЕсли;
				Если СтрокаОткрытияФормы <> "" Тогда
					ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ВыборВидаОбъектаОповещения_Завершение", ЭтаФорма);
					ОткрытьФорму(СтрокаОткрытияФормы, , , , , , ОписаниеОповещенияОЗакрытии);
				Иначе
					ТекстСообщения = НСтр("ru = 'Для типа объектов %ТипОбъекта% не определены виды объектов'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипОбъекта%", Строка(СтруктураИзмерений.ТипОбъектаОповещения));
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				КонецЕсли;
			ИначеЕсли НЕ ЕстьТипОбъекта Тогда
				// Тип объекта.
				НовыйТипОбъекта = МодульУправленияОповещениямиУХ.ПолучитьТипОбъектаПоВидуОповещения(СтруктураИзмерений.ВидСобытияОповещения);
				Если НовыйТипОбъекта = Неопределено Тогда
					// Не удалось получить тип объекта однозначно. Поручим выбор пользователю.
					ТекущаяИбТип = ПредопределенноеЗначение("Справочник.ТипыБазДанных.ТекущаяИБ");
					СтруктураПараметров = Новый Структура;
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("Владелец", ТекущаяИбТип);
					СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
					СписокВыбора = Новый СписокЗначений;
					СписокВыбора.Добавить("ДокументБД",		 НСтр("ru = 'Документ БД'"));
					СписокВыбора.Добавить("СправочникБД",	 НСтр("ru = 'Справочник БД'"));
					Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма);
					СписокВыбора.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выбор типа данных'"));
				Иначе
					// Тип объекта удалось получить однозначно. Добавим его в дерево и раскроем форму новой настройки.
					Если КоличествоПодчиненныхСтрок(СтруктураИзмерений) = 0 Тогда
						СтруктураДобавления = Новый Структура;
						СтруктураДобавления.Вставить("КатегорияОповещения", СтруктураИзмерений.КатегорияОповещения);
						СтруктураДобавления.Вставить("ВидСобытияОповещения", СтруктураИзмерений.ВидСобытияОповещения);
						СтруктураДобавления.Вставить("ТипОбъектаОповещения", НовыйТипОбъекта);
						СтруктураДобавления.Вставить("ВидОбъектаОповещения", Неопределено);
						ИспользованиеСтроки = Истина;
						СтруктураДобавления.Вставить("Использование", ИспользованиеСтроки);
						СтруктураДобавления.Вставить("УровеньСтроки", 3);
						СтруктураДобавления.Вставить("ЭлементНастройки", Строка(НовыйТипОбъекта));
						ДобавитьСтрокуДерева(СтруктураИзмерений, СтруктураДобавления);
						НайденнаяСтрока = НайтиИдентификаторСтрокиДереваПоСтруктуре(ДеревоНастроек, СтруктураИзмерений);
						Если НайденнаяСтрока <> -1 Тогда
							Элементы.ДеревоНастроек.ТекущаяСтрока = НайденнаяСтрока;
						Иначе
							// Не найдена строка. Не изменяем позиционирование.
						КонецЕсли;
						УправлениеДоступностью();
						ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", СтруктураДобавления, , Истина);
					Иначе
						ТекстСообщения = НСтр("ru = 'По настройке %ЭлементНастройки% уже введен элемент. Добавление отменено.'");
						ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ЭлементНастройки%", Строка(ТекДанные.ЭлементНастройки));
						ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
						СтруктураИзмерений.Вставить("ТипОбъектаОповещения", НовыйТипОбъекта);
						Если НайтиЗаписиОповещения(СтруктураИзмерений) Тогда
							МассивПараметров = Новый Массив;
							МассивПараметров.Добавить(СтруктураИзмерений); 
							СтруктураИзмерений.Удалить("ВсеНастройки");
							КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.НастройкиОповещений", МассивПараметров);
							ПараметрыФормы = Новый Структура;
							ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
							ОткрытьФорму("РегистрСведений.НастройкиОповещений.ФормаЗаписи", ПараметрыФормы);
						Иначе
							// Не удалось получить строку настройки.
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru = 'Запрещено добавлять настройки данного уровня иерархии.'");
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Запрещено добавлять настройки данного уровня иерархии.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;	
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	РасставитьФлажки();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОповещение(Команда)
	ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		СтруктураИзмерений = ПреобразоватьСтрокуЭлементаФормыВСтруктуруИзмерений(ТекДанные);
		ЕстьКатегория = ЗначениеЗаполнено(СтруктураИзмерений.КатегорияОповещения);
		ЕстьВидСобытия = ЗначениеЗаполнено(СтруктураИзмерений.ВидСобытияОповещения);
		ЕстьТипОбъекта = ЗначениеЗаполнено(СтруктураИзмерений.ТипОбъектаОповещения);
		ЭтоВсеНастройки = ТекДанные.ВсеНастройки;
		Если Не ЭтоВсеНастройки Тогда
			МожноУдалять = (ЕстьКатегория И ЕстьВидСобытия И ЕстьТипОбъекта) ИЛИ ЭтоВсеНастройки;
			Если МожноУдалять Тогда   
				КоличествоПодчиненных = КоличествоПодчиненныхСтрок(СтруктураИзмерений);
				Если КоличествоПодчиненных = 0 Тогда
					Оповещение = Новый ОписаниеОповещения("УдалитьОповещениеЗавершение", ЭтотОбъект, СтруктураИзмерений); 
					ТекстВопроса = НСтр("ru = 'Удалить настройку оповещения для события %ВидСобытия%?'");
					ТекстВопроса = СтрЗаменить(ТекстВопроса, "%ВидСобытия%", Строка(СтруктураИзмерений.ВидСобытияОповещения));
					ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);     
				Иначе
					ТекстСообщения = НСтр("ru = 'По группе %ПредставлениеЭлемента% есть подчинённые строки (%КоличествоСтрок%). Удаление отменено.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ПредставлениеЭлемента%", Строка(ТекДанные.ЭлементНастройки));
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КоличествоСтрок%", Строка(КоличествоПодчиненных));
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru = 'Запрещено удалять настройки данного уровня иерархии.'");
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Запрещено удаление элемента %ИмяЭлемента%. Операция отменена.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяЭлемента%", Строка(ТекДанные.ЭлементНастройки));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОповещениеЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ДобавитьУдалениеНастройкиОповещений(Параметры);
		УдалитьСтрокуДерева(Параметры);
		ЭтаФорма.Модифицированность = Истина;
		УправлениеДоступностью();
	Иначе
		// Пользователь отказался. Ничего не делаем.		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	Если ЭтаФорма.Модифицированность Тогда
		Оповещение = Новый ОписаниеОповещения("ОбновитьДанныеЗавершение", ЭтотОбъект); 
		ТекстВопроса = НСтр("ru = 'Все введённые настройки будут потеряны. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СчитатьДеревоНастроекССохранениемСтроки();
		УправлениеДоступностью();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РасставитьФлажки();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастроекИспользованиеРасшПриИзменении(Элемент)
	ЭтаФорма.Модифицированность = Истина;
	ТекДанные = Элементы.ДеревоНастроек.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		// Исключим неопределенный флаг.
		Если ТекДанные.ИспользованиеРасш = 2 Тогда
			ТекДанные.ИспользованиеРасш = 0;
		Иначе 
			// Оставляем в текущем положении.
		КонецЕсли;
		// Переключим "основной" флаг.
		Если ТекДанные.ИспользованиеРасш = 1 Тогда
			ТекДанные.Использование = Истина;
		Иначе
			ТекДанные.Использование = Ложь;
		КонецЕсли;
		МассивИзменений = Новый Массив;
		СтруктураИзмерений = ПолучитьСтруктуруПоВыбраннойСтроке();
		ДобавитьИзменениеНастройкиОповещений(СтруктураИзмерений, ТекДанные.Использование);
		ЗаполнитьМассивИспользованиеПодчиненных(ТекДанные, ТекДанные.Использование, МассивИзменений);
		ДобавитьМассивИзмененийСтруктурыНастроек(МассивИзменений, ТекДанные.Использование);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
	РасставитьФлажки();
	УправлениеДоступностью();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат, Параметры) Экспорт 
	Если Результат = КодВозвратаДиалога.Да Тогда 
		МожноЗакрывать = Истина; 
		ПрименитьИзмененияПоТаблице();
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда 	
		МожноЗакрывать = Истина; 
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда 		
		// Пользователь отказался закрывать форму.
	Иначе
		// Неизвестный вариант. Ничего не делаем.
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если НЕ ЗавершениеРаботы Тогда
		Если (ЭтаФорма.Модифицированность) И (МожноЗакрывать <> Истина)Тогда
			Отказ = Истина; 
			Оповещение = Новый ОписаниеОповещения( "ПередЗакрытиемЗавершение", ЭтотОбъект); 
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);
		Иначе
			// Изменений нет. Ничего не делаем.
