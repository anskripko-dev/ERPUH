
#Область ПрограммныйИнтерфейс

Процедура ЗаписатьСобытиеУспешногоВыполнения(Обработчик) Экспорт
	
	НаборЗаписей = РегистрыСведений.ТН_ОбработчикиОбновления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Процедура.Установить(Обработчик.Процедура);
	НаборЗаписей.Отбор.НомерВЗ.Установить(Обработчик.НомерВЗ);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Запись = НаборЗаписей[0];
	Иначе
		Запись = НаборЗаписей.Добавить();
	КонецЕсли;
	
	Запись.Процедура = Обработчик.Процедура;
	Запись.НомерВЗ = Обработчик.НомерВЗ;
	Запись.Выполнено = Истина;
	Запись.ВРаботе = Ложь;
	Запись.ТекстОшибки = "";
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	
	// НАЧАЛО Урубков И. 02.09.2025 Выполнение задач №000054387
	Запись.ВерсияВыполненияОбработчика = Метаданные.Версия;
	// КОНЕЦ Урубков И. 02.09.2025 Выполнение задач №000054387
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗаписатьСобытиеОшибочногоВыполнения(Обработчик, ТекстОшибки) Экспорт
	
	НаборЗаписей = РегистрыСведений.ТН_ОбработчикиОбновления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Процедура.Установить(Обработчик.Процедура);
	НаборЗаписей.Отбор.НомерВЗ.Установить(Обработчик.НомерВЗ);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Запись = НаборЗаписей[0];
	Иначе
		Запись = НаборЗаписей.Добавить();
	КонецЕсли;
	
	Запись.Процедура = Обработчик.Процедура;
	Запись.НомерВЗ = Обработчик.НомерВЗ;
	Запись.Выполнено = Ложь;
	Запись.ВРаботе = Ложь;
	Запись.ТекстОшибки = ТекстОшибки;
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗаписатьСобытиеНачалаВыполнения(Обработчик) Экспорт
	
	НаборЗаписей = РегистрыСведений.ТН_ОбработчикиОбновления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Процедура.Установить(Обработчик.Процедура);
	НаборЗаписей.Отбор.НомерВЗ.Установить(Обработчик.НомерВЗ);
	
	Запись = НаборЗаписей.Добавить();
	Запись.Процедура = Обработчик.Процедура;
	Запись.НомерВЗ = Обработчик.НомерВЗ;
	Запись.Выполнено = Ложь;
	Запись.ВРаботе = Истина;
	Запись.ДатаНачалаВыполнения = ТекущаяДатаСеанса();
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

