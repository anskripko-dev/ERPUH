Функция ПолучитьВыполненныеОбработчики() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТН_ОбработчикиОбновления.Процедура КАК Процедура,
		|	ТН_ОбработчикиОбновления.НомерВЗ КАК НомерВЗ
		|ИЗ
		|	РегистрСведений.ТН_ОбработчикиОбновления КАК ТН_ОбработчикиОбновления
		|ГДЕ
		|	ТН_ОбработчикиОбновления.Выполнено";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

