#Область ПрограммныйИнтерфейс
Функция СчетаВладельца(Владелец) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	БанковскиеСчетаПоУмолчанию.Владелец КАК Владелец,
	|	БанковскиеСчетаПоУмолчанию.Валюта КАК Валюта,
	|	БанковскиеСчетаПоУмолчанию.ПлатежныйИнструмент КАК ПлатежныйИнструмент,
	|	БанковскиеСчетаПоУмолчанию.БанковскийСчет КАК БанковскийСчет
	|ИЗ
	|	РегистрСведений.БанковскиеСчетаПоУмолчанию КАК БанковскиеСчетаПоУмолчанию
	|ГДЕ
	|	БанковскиеСчетаПоУмолчанию.Владелец = &Владелец"
	);
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура УстановитьБанковскийСчет(Владелец, Валюта, ПлатежныйИнструмент, БанковскийСчет) Экспорт
		
	МЗ = РегистрыСведений.БанковскиеСчетаПоУмолчанию.СоздатьМенеджерЗаписи();
	МЗ.Владелец = Владелец;
	МЗ.Валюта = Валюта;
	МЗ.ПлатежныйИнструмент = ПлатежныйИнструмент;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		МЗ.БанковскийСчет = БанковскийСчет;
		МЗ.Записать();
	Иначе
		МЗ.Удалить();
	КонецЕсли;

КонецПроцедуры
#КонецОбласти