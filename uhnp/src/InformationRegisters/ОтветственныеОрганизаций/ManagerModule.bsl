
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ЗаписатьОтветственного(Объект, Роль, Пользователь) Экспорт

	Если Роль.ПроверятьУникальность Тогда
		
		нз = СоздатьНаборЗаписей();
		нз.Отбор.Организация.Установить(Объект);
		нз.Отбор.Роль.Установить(Роль);
		
		нз.Прочитать();
		нз.Очистить();//замена ответственного
		
		Запись = нз.Добавить();		
		Запись.Организация 	= Объект;
		Запись.Роль 		= Роль;
		Запись.Пользователь = Пользователь;
		
		нз.Записать();
		
	Иначе 
		
		мз = СоздатьМенеджерЗаписи();
		
		мз.Организация 	= Объект;
		мз.Роль 		= Роль;
		мз.Пользователь = Пользователь;
		
		мз.Записать();
		
	КонецЕсли;
	
КонецФункции	

Функция УдалитьОтветственных(Объект, Роль) Экспорт

	мз = СоздатьНаборЗаписей();
	
	мз.Отбор.Организация.Установить(Объект);
	мз.Отбор.Роль.Установить(Роль);
	
	мз.Прочитать();
	мз.Очистить();
	
	мз.Записать();

КонецФункции

Функция ПолучитьРоли() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РолиКонтактныхЛиц КАК т
	|ГДЕ
	|	НЕ т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.Наименование");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

