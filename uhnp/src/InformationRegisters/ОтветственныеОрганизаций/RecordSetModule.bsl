// Выполняет проверку этапов процесса по ролям текущего набора записей. В случае
// необходимости меняет значение кеша.
Процедура ПроверитьЗаполнениеЭтаповПроцесса()
	ВыгрузкаРегистра = ЭтотОбъект.Выгрузить();
	МассивРолей = ВыгрузкаРегистра.ВыгрузитьКолонку("Роль");
	РольОтбора = ЭтотОбъект.Отбор.Роль.Значение;
	МассивРолей.Добавить(РольОтбора);
	МассивРолей = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивРолей);
	МассивРолей = ОбщегоНазначенияКлиентСерверУХ.УдалитьПустыеЭлементыМассива(МассивРолей);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь,
		|	ЭтапыУниверсальныхПроцессовУтверждающие.Ссылка,
		|	ЭтапыУниверсальныхПроцессовУтверждающие.Ссылка.НайденыОшибки
		|ИЗ
		|	Справочник.ЭтапыУниверсальныхПроцессов.Утверждающие КАК ЭтапыУниверсальныхПроцессовУтверждающие
		|ГДЕ
		|	ЭтапыУниверсальныхПроцессовУтверждающие.Пользователь В(&Роль)
		|	И НЕ ЭтапыУниверсальныхПроцессовУтверждающие.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Роль", МассивРолей);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекЭтап = ВыборкаДетальныеЗаписи.Ссылка;
		ЕстьОшибки = МодульУправленияПроцессамиУХ.ПроверитьОшибкиЭтапа(ТекЭтап);
		Если ЕстьОшибки <> ВыборкаДетальныеЗаписи.НайденыОшибки Тогда
			Попытка
				ЭтапОбъект = ТекЭтап.ПолучитьОбъект();
				ЭтапОбъект.НайденыОшибки = ЕстьОшибки;
				ЭтапОбъект.Записать();
			Исключение
				ТекстСообщения = НСтр("ru = 'Не удалось записать новое значение проверки этапа %Этап%: %ОписаниеОшибки%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Этап%", Строка(ТекЭтап));
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
				ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			КонецПопытки;
		Иначе
			// Данные кеша актуальны. Не изменяем.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ПроверитьЗаполнениеЭтаповПроцесса();
КонецПроцедуры
