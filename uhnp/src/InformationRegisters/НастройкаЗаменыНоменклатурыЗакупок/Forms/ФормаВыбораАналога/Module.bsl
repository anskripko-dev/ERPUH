
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("СтрокаРасшифровки") ИЛИ НЕ Параметры.СтрокаРасшифровки.Свойство("Поля") Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Поля = Параметры.СтрокаРасшифровки.Поля;
	
	ТекущийАналог = Поля.АналогНоменклатура;
	ТекущийАналогЕдиницаИзмерения = Поля.АналогЕдиницаИзмерения;
	Если Поля.Свойство("АналогХарактеристика") Тогда
		ТекущийАналогХарактеристика = Параметры.СтрокаРасшифровки.Поля.АналогХарактеристика;
	КонецЕсли;
	
	//  
	Если Поля.Свойство("Характеристика") Тогда
		Характеристика = Поля.Характеристика; 
	Иначе
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтотОбъект.Список, 
																			"НоменклатураИсточник", 
																			Поля.Номенклатура, 
																			ВидСравненияКомпоновкиДанных.Равно, 
																			НСтр("ru = 'Номенклатура'"), 
																			Истина);  
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтотОбъект.Список, 
																			"ХарактеристикаИсточник", 
																			Характеристика, 
																			ВидСравненияКомпоновкиДанных.Равно, 
																			НСтр("ru = 'Характеристика'"), 
																			Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтотОбъект.Список, 
																			"ЕдиницаИзмеренияИсточник", 
																			Поля.ЕдиницаИзмерения, 
																			ВидСравненияКомпоновкиДанных.Равно, 
																			НСтр("ru = 'Номенклатура'"), 
																			Истина);
		
																			
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		Список, "ЕдиницаИзмерения", Поля.ЕдиницаИзмерения);  
		
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "ТипЦен", Константы.ТипЦенДляРасценкиЗаявокНаПотребность.Получить());
	
КонецПроцедуры

