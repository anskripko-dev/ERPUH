
&НаКлиенте
Процедура СпособЗаменыОтборПриИзменении(Элемент)
	Если ЗначениеЗаполнено(СпособЗаменыОтбор) Тогда
		ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, "СпособЗамены", СпособЗаменыОтбор, Истина);
		Если СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения") Тогда
			Элементы.НоменклатураИсточник.Заголовок = НСтр("ru = 'Номенклатура'");
			Элементы.ХарактеристикаИсточник.Заголовок = НСтр("ru = 'Характеристика'");
			Элементы.НоменклатураПриемник.Видимость = Ложь;
			Элементы.ХарактеристикаПриемник.Видимость = Ложь;
			Элементы.ЕдиницаИзмеренияИсточник.Заголовок = НСтр("ru = 'Ед. изм. база'");
			Элементы.ЕдиницаИзмеренияПриемник.Заголовок = НСтр("ru = 'Ед. изм. пересчет'");
			
			ЭтаФорма.Заголовок = НСтр("ru = 'Настройка замены номенклатуры'");
			
		иначеЕсли СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.Унификат") Тогда
			Элементы.НоменклатураИсточник.Заголовок = НСтр("ru = 'Номенклатура'");
			Элементы.ХарактеристикаИсточник.Заголовок = НСтр("ru = 'Характеристика номенклатуры'");
			Элементы.НоменклатураПриемник.Заголовок = НСтр("ru = 'Унификат'");
			Элементы.ХарактеристикаПриемник.Заголовок = НСтр("ru = 'Характеристика унификата'");
			Элементы.ЕдиницаИзмеренияИсточник.Заголовок = НСтр("ru = 'Ед. изм. исходная'");
			Элементы.ЕдиницаИзмеренияПриемник.Заголовок = НСтр("ru = 'Ед. изм. унификата'");
			Элементы.НоменклатураПриемник.Видимость = Истина;
			
			ЭтаФорма.Заголовок = НСтр("ru = 'Настройка унификатов номенклатуры'");
			
		иначеЕсли СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.Аналоги") Тогда
			Элементы.НоменклатураИсточник.Заголовок = НСтр("ru = 'Номенклатура исходная'");
			Элементы.ХарактеристикаИсточник.Заголовок = НСтр("ru = 'Характеристика исходная'");
			Элементы.НоменклатураПриемник.Заголовок = НСтр("ru = 'Номенклатура аналог'");
			Элементы.ХарактеристикаПриемник.Заголовок = НСтр("ru = 'Характеристика аналога'");
			Элементы.ЕдиницаИзмеренияИсточник.Заголовок = НСтр("ru = 'Ед. изм. исходная'");
			Элементы.ЕдиницаИзмеренияПриемник.Заголовок = НСтр("ru = 'Ед. изм. аналог'");
			Элементы.НоменклатураПриемник.Видимость = Истина;
			
			ЭтаФорма.Заголовок = НСтр("ru = 'Настройка аналогов номенклатуры'");
			
		КонецЕсли;
		
	Иначе
		ОтборыСписковКлиентСерверУХ.УдалитьЭлементОтбораСписка(Список, "СпособЗамены");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсточникПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(СпособЗаменыОтбор) Тогда
		Возврат;
	КонеЦЕсли;
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения") Тогда
		ТекДанные.НоменклатураПриемник = ТекДанные.НоменклатураИсточник;
		
	иначеЕсли СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.Унификат") Тогда
		
		
	иначеЕсли СпособЗаменыОтбор = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.Аналоги") Тогда
		
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаИсточникПриИзменении(Элемент)
	Если СпособЗаменыОтбор = ПредопределенноеЗначение(
			"Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения") Тогда
		ТекДанные = Элементы.Список.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ТекДанные.ХарактеристикаПриемник = ТекДанные.ХарактеристикаИсточник;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ВидОперации") И ЗначениеЗаполнено(Параметры.ВидОперации) Тогда
		СпособЗаменыОтбор = Параметры.ВидОперации;
		Элементы.СпособЗаменыОтбор.ТолькоПросмотр = Истина;
	Иначе
		СпособЗаменыОтбор = Перечисления.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СпособЗаменыОтборПриИзменении(Элементы.СпособЗаменыОтбор);
КонецПроцедуры

