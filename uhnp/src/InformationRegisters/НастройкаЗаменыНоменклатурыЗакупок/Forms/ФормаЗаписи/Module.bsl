&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Единица = 1;
	
	ИспользоватьХарактеристикиИсточник = ОпределитьХарактеристикиИспользуются(
		Запись.НоменклатураИсточник);
	ИспользоватьХарактеристикиПриемник = ОпределитьХарактеристикиИспользуются(
		Запись.НоменклатураПриемник);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой()
	
	ЭтоПересчетЕдиниц = 
		Запись.СпособЗамены = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения");
	
	Элементы.НоменклатураПриемник.Видимость = НЕ ЭтоПересчетЕдиниц;
	
	// 
	Элемент = Элементы.НоменклатураИсточник;
	Если ЭтоПересчетЕдиниц Тогда
		Элемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
		Запись.НоменклатураИсточник = Элемент.ОграничениеТипа.ПривестиЗначение(Запись.НоменклатураИсточник);
		Элемент.ВыбиратьТип = Ложь;
	Иначе
		Элемент.ОграничениеТипа = Новый ОписаниеТипов;
		Элемент.ВыбиратьТип = Истина;
	КонецЕсли;
	
	УстановитьВидимостьХарактеристик();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьХарактеристик()
	Элементы.ХарактеристикаИсточник.Видимость = ИспользоватьХарактеристикиИсточник;
	Элементы.ХарактеристикаПриемник.Видимость = ИспользоватьХарактеристикиПриемник;
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсточникПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Запись.СпособЗамены) Тогда
		Возврат;
	КонеЦЕсли;
	
	Если Запись.СпособЗамены = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения") Тогда
		Запись.НоменклатураПриемник = Запись.НоменклатураИсточник;
	КонецЕсли;

	ИспользоватьХарактеристикиИсточник = ОпределитьХарактеристикиИспользуются(
		Запись.НоменклатураИсточник);
	УстановитьВидимостьХарактеристик();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриемникПриИзменении(Элемент)
	ИспользоватьХарактеристикиПриемник = ОпределитьХарактеристикиИспользуются(
		Запись.НоменклатураПриемник);
	УстановитьВидимостьХарактеристик();
КонецПроцедуры
	
&НаКлиенте
Процедура ХарактеристикаИсточникПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Запись.СпособЗамены) Тогда
		Возврат;
	КонеЦЕсли;
	Если Запись.СпособЗамены = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.ПересчетЕдиницыИзмерения") Тогда
		Запись.ХарактеристикаПриемник = Запись.ХарактеристикаИсточник;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпособЗаменыПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Запись.СпособЗамены = ПредопределенноеЗначение("Перечисление.СпособыЗаменыНоменклатуры.Унификат") Тогда
		// Отбор, который покажет еще не использованную в настройках унификатов номенклатуру.
		СтандартнаяОбработка = ложь;
		
		СписокТипов = Новый СписокЗначений;
		СписокТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекущееЗначение", Запись.НоменклатураИсточник);
		
		ДелегатОбработатьВыборТипаОбъекта = Новый ОписаниеОповещения("ОбработатьВыборТипаОбъекта", ЭтаФорма, ДопПараметры);
		СписокТипов.ПоказатьВыборЭлемента(ДелегатОбработатьВыборТипаОбъекта, НСтр("ru = 'Укажите тип источника'"), ТипЗнч(Запись.НоменклатураИсточник));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборТипаОбъекта(ВыбранныйТипОбъекта, ДопПараметры) Экспорт
	
	Если ВыбранныйТипОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДелегатОбработатьВыборНоменклатурыИсточник = Новый ОписаниеОповещения("ОбработатьВыборНоменклатурыИсточник", ЭтаФорма);
	ПараметрыФормыВыбора = Новый Структура("ВыбранныйТипОбъекта,ТекущееЗначение,ЗакрыватьПриВыборе",
		ВыбранныйТипОбъекта.Значение, ДопПараметры.ТекущееЗначение, Истина);
	ОткрытьФорму("РегистрСведений.НастройкаЗаменыНоменклатуры.Форма.ФормаВыбораНоменклатуры",
		ПараметрыФормыВыбора, ЭтаФорма,,,,ДелегатОбработатьВыборНоменклатурыИсточник, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборНоменклатурыИсточник(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись.НоменклатураИсточник = Результат;
	НоменклатураИсточникПриИзменении(Элементы.НоменклатураИсточник);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьХарактеристикиИспользуются(Номенклатура)
	Возврат	УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.ХарактеристикиИспользуются(Номенклатура);
КонецФункции
