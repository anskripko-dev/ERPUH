#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиОбновления

Процедура ЗаполнитьИноеДействие() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.Период КАК Период,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.ВидБюджета КАК ВидБюджета,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.ИноеДействие КАК ИноеДействие,
	|	ИСТИНА КАК ИноеДействие_Новое
	|ИЗ
	|	РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыКонтроляЛимитаСтатейБюджетов
	|ГДЕ
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.ИноеДействие = ЛОЖЬ
	|	И НЕ ПараметрыКонтроляЛимитаСтатейБюджетов.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидБюджета.Установить(Выборка.ВидБюджета);
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.СтатьяБюджета.Установить(Выборка.СтатьяБюджета);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.ИноеДействие = Выборка.ИноеДействие_Новое;
		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);       
		Исключение
			ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'Не удалось обновить регистр сведений ""%1"" по статье ""%2"" 
				|%3'"),
				Метаданные.РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.Представление(), 
				Выборка.СтатьяБюджета, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,
			,
			, 
			ТекстСообщения);
		КонецПопытки;  	

	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
	
#Область ПрограммныйИнтерфейс
// Функция - Доступно изменение параметров контроля статьи бюджета
//
// Параметры:
//  ВидБюджета			 - ПланВидовХарактеристикСсылка.ВидыБюджетов - Вид бюджета
//  ПериодЛимитирования	 - Дата - Дата начала периода лимитирования
//  СтатьяБюджета		 - Характеристика.ВидыБюджета - 
// 
// Возвращаемое значение:
//   Булево - Возвращает Истина, если доступно изменение параметров контроля статьи бюджетов
//
Функция ДоступноИзменениеПараметровКонтроляСтатьиБюджета(ВидБюджета, ПериодЛимитирования, СтатьяБюджета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииБюджетовОбороты.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	ОперацииБюджетовОбороты.СуммаОборот КАК СуммаОборот,
	|	ОперацииБюджетовОбороты.КоличествоОборот КАК КоличествоОборот,
	|	ОперацииБюджетовОбороты.ЛимитОборот КАК ЛимитОборот,
	|	ОперацииБюджетовОбороты.СуммаИсполненоОборот КАК СуммаИсполненоОборот,
	|	ОперацииБюджетовОбороты.КоличествоИсполненоОборот КАК КоличествоИсполненоОборот,
	|	ОперацииБюджетовОбороты.ЛимитИсполненоОборот КАК ЛимитИсполненоОборот
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов.Обороты(
	|			НАЧАЛОПЕРИОДА(&ПериодЛимитирования, ГОД),
	|			КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ПериодЛимитирования, ГОД, 1), ГОД),
	|			,
	|			ВидБюджета = &ВидБюджета
	|				И АналитикаСтатейБюджетов.СтатьяБюджета = &СтатьяБюджета) КАК ОперацииБюджетовОбороты";
	
	Запрос.УстановитьПараметр("ПериодЛимитирования", ПериодЛимитирования);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);     
	Запрос.УстановитьПараметр("СтатьяБюджета", СтатьяБюджета);

	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

// Процедура устанавливает параметры лимитирования для статей бюджетов 
//
// Параметры:
//  ВидБюджета				- ПланВидовХарактеристикСсылка.ВидыБюджетов<Тип.Вид> - Вид бюджета, для которого производится установка
//  ПериодЛимитирования		- Дата - Дата начала нового лимитирования (обычно это начало года)
//  СтатьиБюджета			- Массив - Статьи бюджета, по которым производится установка параметров
//  КонтрольЛимитов			- ПеречислениеСсылка.РежимыКонтроляДокументов - Действие, при проведении документа с превышением лимита бюджета
//  КонтрольРезервов		- ПеречислениеСсылка.РежимыКонтроляДокументов - Действие, при проведении документа с превышением резерва
//  КонролироватьАналитики	- Булево - Использовать аналитики при контроле лимитов
//
Процедура УстановитьПараметрыКонтроляСтатейБюджетаПакетно(ВидБюджета, ПериодЛимитирования, СтатьиБюджета, КонтрольЛимитов, КонтрольРезервов, КонролироватьАналитики) Экспорт
	
	ЭтоУстановкаПараметров = НЕ (КонтрольЛимитов = Перечисления.РежимыКонтроляДокументов.ПустаяСсылка()
		И КонтрольРезервов = Перечисления.РежимыКонтроляДокументов.ПустаяСсылка());
		
	Если ЭтоУстановкаПараметров Тогда
		РеквизитыЗаписи = Новый Структура;
		РеквизитыЗаписи.Вставить("Активность", Истина);
		РеквизитыЗаписи.Вставить("ВидБюджета", ВидБюджета);
		РеквизитыЗаписи.Вставить("Период", ПериодЛимитирования);
		РеквизитыЗаписи.Вставить("КонтрольЛимитов", КонтрольЛимитов);
		РеквизитыЗаписи.Вставить("КонтрольРезервов", КонтрольРезервов);
	КонецЕсли;
	
	ВидыАналитикСтатей = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СтатьиБюджета, АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("ВидАналитики%1"));
	Для Каждого КлючЗначение Из ВидыАналитикСтатей Цикл
		
		Если ЭтоУстановкаПараметров Тогда
			РеквизитыЗаписи.Вставить("СтатьяБюджета", КлючЗначение.Ключ);
			Для Номер = 1 По АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи() Цикл
				ИмяВидАналитики = СтрШаблон("ВидАналитики%1", Номер);
				ИмяРесурса = СтрШаблон("КонтролироватьАналитику%1", Номер);
				РеквизитыЗаписи.Вставить(ИмяРесурса, КонролироватьАналитики И ЗначениеЗаполнено(КлючЗначение.Значение[ИмяВидАналитики]));
			КонецЦикла;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Отбор.Период.Установить(ПериодЛимитирования);
		НаборЗаписей.Отбор.СтатьяБюджета.Установить(КлючЗначение.Ключ);
		
		Если ЭтоУстановкаПараметров Тогда
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), РеквизитыЗаписи);
		КонецЕсли;
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Устанавливает параметры контроля статьи
//
// Параметры:
//  ВидБюджета		 - ПланВидовХарактеристикСсылка.ВидыБюджетов	 - Ссылка на вид бюджета по которому устанавливается контроль
//  СтатьяБюджета	 - Характеристика.ВидыБюджетов	 - Ссылка на статью бюджета
//  Период			 - Дата	 - Дата формата 20хх.01.01
//  ДанныеЗаписи	 - Структура	 - см. ОписаниеПараметровСтатьи()
//						*ИсточникДляЛимитовВидБюджета - Источник параметров лимитирования в статье
//						*КонтрольЛимитов - ПеречислениеСсылка.РежимыКонтроляДокументов                                                          
//						*КонтрольРезервов - ПеречислениеСсылка.РежимыКонтроляДокументов
//						*КонтролироватьАналитику1..N - Булево
//
Процедура ВыполнитьУстановкуПараметровСтатьи(ВидБюджета, СтатьяБюджета, Период, ДанныеЗаписи) Экспорт
	
	ИменаРеквизитов = "КонтрольЛимитов,КонтрольРезервов,"+АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("КонтролироватьАналитику%1");
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов");
	ЭлементБлокировки.УстановитьЗначение("Период", 			Период);
	ЭлементБлокировки.УстановитьЗначение("ВидБюджета", 		ВидБюджета);
	ЭлементБлокировки.УстановитьЗначение("СтатьяБюджета", 	СтатьяБюджета);
	
	НаборЗаписей = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СоздатьНаборЗаписей();
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка.Заблокировать();
		
		НаборЗаписей.Очистить();
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Отбор.Период.Установить(Период);
		НаборЗаписей.Отбор.СтатьяБюджета.Установить(СтатьяБюджета);
		
		Если ДанныеЗаписи.ИсточникДляЛимитовВидБюджета = Ложь Тогда
			Движение = НаборЗаписей.Добавить();
			Движение.ВидБюджета = ВидБюджета;
			Движение.Период = Период;
			Движение.СтатьяБюджета = СтатьяБюджета;
			ЗаполнитьЗначенияСвойств(Движение, ДанныеЗаписи, ИменаРеквизитов);
			Движение.КонтролироватьСтатью = Истина;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Описание параметров статьи для ВыполнитьУстановкуПараметровСтатьи(
// 
// Возвращаемое значение:
//  Структура - Структура параметров для ВыполнитьУстановкуПараметровСтатьи()
// 	*ИсточникДляЛимитовВидБюджета - Источник параметров лимитирования в статье
// 	*КонтрольЛимитов - ПеречислениеСсылка.РежимыКонтроляДокументов                                                          
// 	*КонтрольРезервов - ПеречислениеСсылка.РежимыКонтроляДокументов
// 	*КонтролироватьАналитику1..N - Булево
//
// Пример:
// 	ПараметрыСтатьи = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.ОписаниеПараметровСтатьи();
//	ПараметрыСтатьи.ИсточникДляЛимитовВидБюджета = ЭтаФорма.КонтролироватьСтатью; 
//	ПараметрыСтатьи.КонтрольЛимитов = ЭтаФорма.КонтрольЛимитов;                                                          
//	ПараметрыСтатьи.КонтрольРезервов = ЭтаФорма.КонтрольРезервов;
//	ЗаполнитьЗначенияСвойств(Форма.ВидыАналитик, ПараметрыСтатьи, АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("КонтролироватьАналитику%1"));  
Функция ОписаниеПараметровСтатьи() Экспорт

	ИменаРеквизитов = "КонтрольЛимитов,КонтрольРезервов,"+АналитикиСтатейБюджетовУХКлиентСервер.РеквизитыАналитикИзШаблона("КонтролироватьАналитику%1");
	Возврат Новый Структура("ИсточникДляЛимитовВидБюджета," + ИменаРеквизитов);

КонецФункции // ОписаниеПараметровСтатьи()
	
#КонецОбласти

#КонецЕсли
