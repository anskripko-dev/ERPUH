
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда    
		ВызватьИсключение НСтр("ru = 'Работа с регистром возможна через АРМ ""Управление планами и лимитами""'");
	КонецЕсли;  
	ТолькоПросмотр = Истина;    
	
	ЗаполнитьДанныеКонтроляСтатьи();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеКонтроляСтатьи()
	
	ЗаполненаСтатья = ЗначениеЗаполнено(Запись.СтатьяБюджета);
	ВидыАналитикОбъекта = АналитикиСтатейБюджетовУХ.ВидыАналитикОбъекта(Запись.СтатьяБюджета);
	Если Параметры.Ключ.СтатьяБюджета = Запись.СтатьяБюджета Тогда
		ПараметрыКонтроля = Запись;
	Иначе
		ПараметрыКонтроля = АналитикиСтатейБюджетовУХ.ПараметрыЛимитированияСтатьиБюджета(Запись.СтатьяБюджета);
	КонецЕсли;
	
	Запись.КонтролироватьСтатью = ПараметрыКонтроля.КонтролироватьСтатью;
	
	КонтрольАналитик.Очистить();
	КоличествоАналитик = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();
	Для Номер = 1 По КоличествоАналитик Цикл
		Строка = КонтрольАналитик.Добавить();
		Строка.НомерАналитики = Номер;
		ВидАналитики = ВидыАналитикОбъекта[СтрШаблон("ВидАналитики%1", Номер)];
		Строка.ВидАналитики = ВидАналитики;
		Если ЗаполненаСтатья Тогда
			Строка.КонтролироватьАналитику = ПараметрыКонтроля[СтрШаблон("КонтролироватьАналитику%1", Номер)];
			Строка.КонтролироватьАналитикуАрхив = Истина;
		Иначе
			Строка.КонтролироватьАналитику = Ложь;
			Строка.КонтролироватьАналитикуАрхив = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

