#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("СтатьяБюджета") Тогда
			
			Если НЕ ДанныеЗаполнения.Свойство("ВидБюджета") Тогда
				ВидыБюджетовСтатьи = ПолучитьСписокВидовБюджетаДляТипаСтатьи(ТипЗнч(ДанныеЗаполнения.СтатьяБюджета));
				Если ВидыБюджетовСтатьи.Количество() > 0 Тогда
					ДанныеЗаполнения.Вставить("ВидБюджета", ВидыБюджетовСтатьи[0]);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	КолвоАналитик = АналитикиСтатейБюджетовУХКлиентСервер.КоличествоАналитикСтатьи();
	Для Каждого Движение Из ЭтотОбъект Цикл
		
		Движение.ИноеДействие = ЗначениеЗаполнено(Движение.КонтрольЛимитов) ИЛИ ЗначениеЗаполнено(Движение.КонтрольРезервов);
		
		Если Движение.КонтролироватьСтатью Тогда
			Продолжить;
		КонецЕсли;
		
		Для Номер = 1 По КолвоАналитик Цикл
			
			Если Движение["КонтролироватьАналитику"+Номер] = Истина Тогда
				Движение["КонтролироватьАналитику"+Номер] = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСписокВидовБюджетаДляТипаСтатьи(ТипСтатьиБюджета)
	
	Результат = Новый Массив;
	
	Запрос = Новый запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыБюджетов.Ссылка КАК Ссылка,
	|	ВидыБюджетов.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.ВидыБюджетов КАК ВидыБюджетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ТипЗначения.СодержитТип(ТипСтатьиБюджета) Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

