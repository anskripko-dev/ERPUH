
&НаСервере
Процедура ВыгрузитьОбъекты(ТолькоВыделенные=Истина)
	
	ПротоколируемыеСобытияУХ.Начать();
	
	Если ТолькоВыделенные Тогда
		
		ТаблицаДляВыгрузки=Новый ТаблицаЗначений;
		ТаблицаДляВыгрузки.Колонки.Добавить("НастройкаСоответствия");
		ТаблицаДляВыгрузки.Колонки.Добавить("ИспользуемаяИБ");
		ТаблицаДляВыгрузки.Колонки.Добавить("Элемент");
		
		Для Каждого Строка ИЗ Элементы.Список.ВыделенныеСтроки Цикл
			
			НоваяСтрока=ТаблицаДляВыгрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
	Иначе
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
		|	ИзмененныеОбъектыДляВыгрузки.НастройкаСоответствия КАК НастройкаСоответствия,
		|	ИзмененныеОбъектыДляВыгрузки.ИспользуемаяИБ КАК ИспользуемаяИБ,
		|	ИзмененныеОбъектыДляВыгрузки.Элемент КАК Элемент
		|ИЗ
		|	РегистрСведений.ИзмененныеОбъектыДляВыгрузки КАК ИзмененныеОбъектыДляВыгрузки";
		
		ТаблицаДляВыгрузки=Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	ВыгрузитьОбъектыВВИБ(ТаблицаДляВыгрузки);
	
	ТаблицаОшибок=ПротоколируемыеСобытияУХ.Завершить(Нстр("ru = 'Обмен НСИ'"),,,,Ложь);
	ЗначениеВРеквизитФормы(ТаблицаОшибок,"ТаблицаСобытийЗагрузки");
	
КонецПроцедуры // ВыгрузитьОбъекты()

&НаСервере
Процедура ВыгрузитьОбъектыВВИБ(ТаблицаДляВыгрузки)
	
	ТаблицаДляВыгрузки.Сортировать("ИспользуемаяИБ Возр, НастройкаСоответствия Возр");
	
	ТекНастройкаСоответствия=Неопределено;
	ТекИспользуемаяИБ=Неопределено;
	СписокОбъектов=Новый СписокЗначений;
	
	Для Каждого СтрокаВыгрузки ИЗ ТаблицаДляВыгрузки Цикл
		
		Если ТекНастройкаСоответствия=Неопределено Тогда
			
			ТекНастройкаСоответствия=СтрокаВыгрузки.НастройкаСоответствия;
			ТекИспользуемаяИБ=СтрокаВыгрузки.ИспользуемаяИБ;
			СписокОбъектов.Добавить(СтрокаВыгрузки.Элемент);
			
		ИначеЕсли НЕ (СтрокаВыгрузки.НастройкаСоответствия=ТекНастройкаСоответствия И СтрокаВыгрузки.ИспользуемаяИБ=ТекИспользуемаяИБ) Тогда
			
			ИнтеграцияСВнешнимиСистемамиУХ.ВыгрузитьОбъектыВВИБ(ТекИспользуемаяИБ,ТекНастройкаСоответствия,СписокОбъектов);
			
			СписокОбъектов.Очистить();
			
			ТекНастройкаСоответствия=СтрокаВыгрузки.НастройкаСоответствия;
			ТекИспользуемаяИБ=СтрокаВыгрузки.ИспользуемаяИБ;
			СписокОбъектов.Добавить(СтрокаВыгрузки.Элемент);
			
		Иначе
			
			СписокОбъектов.Добавить(СтрокаВыгрузки.Элемент);

		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокОбъектов.Количество()>0 И (НЕ ТекНастройкаСоответствия=Неопределено) Тогда
		
		ИнтеграцияСВнешнимиСистемамиУХ.ВыгрузитьОбъектыВВИБ(ТекИспользуемаяИБ,ТекНастройкаСоответствия,СписокОбъектов);
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры // ВыгрузитьОбъектыВВИБ() 


&НаКлиенте
Процедура ВыгрузитьВыделенныеОбъекты(Команда)
	
	ВыгрузитьОбъекты();
	ПроверитьОтобразитьПротокол()
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВсеОбъекты(Команда)
	
	ВыгрузитьОбъекты(Ложь);
	ПроверитьОтобразитьПротокол()
	
КонецПроцедуры

&НаКлиенте
Процедура  ПроверитьОтобразитьПротокол()
	
	Если ТаблицаСобытийЗагрузки.Количество()>0 Тогда
		
		ОткрытьФорму("Обработка.ОтображениеПротоколируемыхСобытий.Форма.Форма",Новый Структура("АдресТаблицыСобытий",ПолучитьАдресТаблицыСобытий()));
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьОтобразитьПротокол();

&НаСервере
Функция ПолучитьАдресТаблицыСобытий()
	
	ТаблицаСобытий=РеквизитФормыВЗначение("ТаблицаСобытийЗагрузки");
	ТаблицаСобытий.Сортировать("Дата,ВремяMs");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаСобытий,ЭтаФорма.УникальныйИдентификатор);
		
КонецФункции // ПолучитьАдресТаблицыСобытий()
