
&НаСервере
Процедура СоздатьНастройкуПоВидамНоменклатурыНаСервере()
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНоменклатуры.Ссылка КАК НоменклатураВидНоменклатуры
	               |ПОМЕСТИТЬ НоменклатураПоступлений
	               |ИЗ
	               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВидыНоменклатуры.Ссылка;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураПоступлений.НоменклатураВидНоменклатуры КАК ВидНоменклатуры
	               |ИЗ
	               |	НоменклатураПоступлений КАК НоменклатураПоступлений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыОперацийПоступленияПоВидамНоменклатуры КАК ВидыОперацийПоступленияПоВидамНоменклатуры
	               |		ПО НоменклатураПоступлений.НоменклатураВидНоменклатуры = ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры
	               |ГДЕ
	               |	(ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры ЕСТЬ NULL
	               |			ИЛИ ВидыОперацийПоступленияПоВидамНоменклатуры.ВидОперацииПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеТоваровУслуг.ПустаяСсылка))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураПоступлений.НоменклатураВидНоменклатуры"; 
	
	Выборка = Запрос.Выполнить().Выбрать();   
	Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.ВидыОперацийПоступленияПоВидамНоменклатуры.СоздатьНаборЗаписей(); 
			МенеджерЗаписи.Отбор.ВидНоменклатуры.Установить(Выборка.ВидНоменклатуры);	
			Запись = МенеджерЗаписи.Добавить();
			Запись.ВидНоменклатуры = Выборка.ВидНоменклатуры;
			МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНастройкуПоВидамНоменклатуры(Команда)
	СоздатьНастройкуПоВидамНоменклатурыНаСервере();   
	Элементы.Список.Обновить();
КонецПроцедуры

