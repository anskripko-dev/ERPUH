#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


// Добавляет в регистр отсутствующие виды номенклатуры.
// Устанавливает вид операции поступления по умолчанию.
//
Процедура ОбновитьСоставВидовНоменклатуры() Экспорт
	НачатьТранзакцию();
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить();
	ЭлементБлокировки.Область = 
		"РегистрСведений.ВидыОперацийПоступленияПоВидамНоменклатуры";
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	СоздатьВидыНоменклатурыИзРезультатаЗапроса(
		ПолучитьРезультатЗапросаОтсутствующихВидовНоменклатуры());
	ЗафиксироватьТранзакцию();
КонецПроцедуры

Функция ПолучитьРезультатЗапросаОтсутствующихВидовНоменклатуры()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры,
		|	ВЫБОР
		|		КОГДА ВидыНоменклатуры.Услуга
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеТоваровУслуг.Услуги)
		|		ИНАЧЕ &ВидОперацииПоступления
		|	КОНЕЦ КАК ВидОперацииПоступления
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыОперацийПоступленияПоВидамНоменклатуры КАК ВидыОперацийПоступленияПоВидамНоменклатуры
		|		ПО (ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
		|ГДЕ
		|	ВидыОперацийПоступленияПоВидамНоменклатуры.ВидНоменклатуры ЕСТЬ NULL";
	МетаданныеРегистра =
		Метаданные.РегистрыСведений.ВидыОперацийПоступленияПоВидамНоменклатуры;
	Запрос.УстановитьПараметр("ВидОперацииПоступления",
		МетаданныеРегистра.Ресурсы.ВидОперацииПоступления.ЗначениеЗаполнения);
	Возврат Запрос.Выполнить();
КонецФункции

Процедура СоздатьВидыНоменклатурыИзРезультатаЗапроса(РезультатЗапроса)
	ТЗВидовНоменклатуры = РезультатЗапроса.Выгрузить();
	Если ТЗВидовНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НаборЗаписей = 
		РегистрыСведений.ВидыОперацийПоступленияПоВидамНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ТЗВидовНоменклатуры);
	НаборЗаписей.Записать(Ложь);
КонецПроцедуры


#КонецЕсли