Функция ПолучитьСкладПоДоговору(ТипДокумента, Договор, Склад) Экспорт
	
	Результат = Склад;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеОсновныхРеквизитов.Склад КАК Склад
		|ИЗ
		|	РегистрСведений.тн_СоответствиеОсновныхРеквизитовПриИнтеграцииERP КАК СоответствиеОсновныхРеквизитов
		|ГДЕ
		|	СоответствиеОсновныхРеквизитов.ТипДокумента = &ТипДокумента
		|	И СоответствиеОсновныхРеквизитов.Договор = &Договор";
	
	Запрос.УстановитьПараметр("Договор", 		Договор);
	Запрос.УстановитьПараметр("ТипДокумента", 	ТипДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;	
	КонецЕсли;
	
	пВыборка = РезультатЗапроса.Выбрать();
	
	Если пВыборка.Следующий() Тогда
		Результат = пВыборка.Склад;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //ЗаполнитьСкладПоДоговору()