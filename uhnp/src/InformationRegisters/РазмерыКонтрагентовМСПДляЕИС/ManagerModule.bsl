// Возвращает размер контрагента на текущую, либо указанную дату.
//
// Параметры:
//  Контрагент - - 
//  Дата - Дата|Неопределено - дата на которую нужно получить сведения.
//		Если передано Неопределено, то текущая дата будет получена
//		по текущей дате сеанса.
// 
// Возвращаемое значение:
//   - ПеречислениеСсылка.РазмерыКонтрагентовДляЕИС.
// 			Если для контрагента нет зарегистрированного размера, будет
// 			возвращен размер Крупный.
//
Функция ПолучитьРазмер(Контрагент, Дата=Неопределено) Экспорт  
	
	Если ЗначениеЗаполнено(Контрагент) Тогда  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РазмерыКонтрагентовМСПДляЕИС.Размер КАК Размер
			|ИЗ
			|	РегистрСведений.РазмерыКонтрагентовМСПДляЕИС.СрезПоследних(&Дата, Контрагент = &Контрагент) КАК РазмерыКонтрагентовМСПДляЕИС"; 
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);  
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.Размер;   
		Иначе
			Возврат Перечисления.РазмерыКонтрагентовДляЕИС.Крупный;	
		КонецЕсли;  
		

	КонецЕсли;   
	
	Возврат Перечисления.РазмерыКонтрагентовДляЕИС.Крупный;  
	
КонецФункции

// Возвращает документ РегистрацияРазмераКонтрагентаДляЕИС, который зарегистрировал
// размер РазмерВход для контрагента КонтрагентВход. Когда документ не найден - будет
// возвращена пустая ссылка.
Функция ПолучитьДанныеРегистрацииРазмера(КонтрагентВход, РазмерВход = Неопределено) Экспорт  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Контрагент", КонтрагентВход);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РазмерыКонтрагентовМСПДляЕИССрезПоследних.Регистратор КАК Регистратор,
		|	РазмерыКонтрагентовМСПДляЕИССрезПоследних.Размер КАК Размер
		|ИЗ
		|	РегистрСведений.РазмерыКонтрагентовМСПДляЕИС.СрезПоследних(, Контрагент = &Контрагент) КАК РазмерыКонтрагентовМСПДляЕИССрезПоследних";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Новый Структура("Регистратор, Размер", 
								ВыборкаДетальныеЗаписи.Регистратор, 
								ВыборкаДетальныеЗаписи.Размер);
	Иначе   
		Возврат Новый Структура("Регистратор, Размер", 
								Документы.РегистрацияРазмераКонтрагентаДляЕИС.ПустаяСсылка(), 
								Перечисления.РазмерыКонтрагентовДляЕИС.ПустаяСсылка());
	КонецЕсли;
	
КонецФункции		 // НайтиДокументРегистрацииРазмера()

Процедура ЗаполнитьДанныеРазмеровКонтрагентов() Экспорт

		

КонецПроцедуры

Функция ЭтоМСП(КонтрагентВход) Экспорт

	РазмерыСМсп = Перечисления.РазмерыКонтрагентовДляЕИС.ПолучитьРазмерыСМСП();
	ДанныеРазмера = ПолучитьДанныеРегистрацииРазмера(КонтрагентВход);
	ЭтоРазмерМСП = (РазмерыСМсп.Найти(ДанныеРазмера.Размер) <> Неопределено);   
	Возврат ЭтоРазмерМСП;

КонецФункции // ЭтоМСП()

Процедура ФормаЭлементаРеквизитыКонтрагента_ПриСозданииНаСервереГруппаМСП(ГруппаФЗ223, Знач ПараметрыГруппы = Неопределено, Знач Форма, Знач Контрагент, Знач Элементы) Экспорт
	
	Перем ГиперссылкаКлассификаторы, ГруппаФЗ223МСП, ДанныеРегистрации;            
	
	Если ПараметрыГруппы = Неопределено Тогда
		// Параметры групп 
		ПараметрыГруппы = Новый Структура;
		ПараметрыГруппы.Вставить("ШрифтЗаголовка", Элементы.ГруппаНаименования.ШрифтЗаголовка);
		ПараметрыГруппы.Вставить("Отображение", Элементы.ГруппаНаименования.Отображение);
		ПараметрыГруппы.Вставить("Группировка", Элементы.ГруппаНаименования.Группировка);
		ПараметрыГруппы.Вставить("Объединенная", Истина);
	КонецЕсли;
	
	ИмяКоманды = "ОткрытьДокументРазмерКонтрагента";  
	ФормыУХ.СоздатьКоманду(Форма, ИмяКоманды, НСтр("ru = 'Регистратор'"), "Подключаемый_ОткрытьДокументРазмерКонтрагента");
	ФормыУХ.СоздатьКоманду(Форма, ИмяКоманды + "Изменить", НСтр("ru = 'Регистратор'"), "Подключаемый_ОткрытьДокументРазмерКонтрагента");
	
	ГруппаФЗ223МСП = ФормыУХ.СоздатьГруппуФормы(Элементы, "ГруппаФЗ223МСП", , , ГруппаФЗ223,, ПараметрыГруппы);
	ГруппаФЗ223МСП.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаФЗ223МСП.ОтображатьЗаголовок = Ложь;
	
	ДанныеРегистрации = ПолучитьДанныеРазмерКонтрагента(Контрагент);
	
	ДекорацияРазмерКонтрагента = ФормыУХ.СоздатьДекорациюФормы(Элементы, 
									"ДекорацияРазмерКонтрагента", 
									СтрШаблон(НСтр("ru = 'Субъект малого или среднего предпринимательства: %1'"), 
									?(ЗначениеЗаполнено(ДанныеРегистрации.Размер), ДанныеРегистрации.Размер, НСтр("ru = '<не указано>'"))), 
									ВидДекорацииФормы.Надпись, 
									ГруппаФЗ223МСП,,,);  
	ДекорацияРазмерКонтрагента.Ширина = 41;  
	
	Если ПравоДоступа("Проведение", Метаданные.Документы.РегистрацияРазмераКонтрагентаДляЕИС, Пользователи.АвторизованныйПользователь()) Тогда 
		
		ГиперссылкаКлассификаторы = Элементы.Добавить("ГиперссылкаРазмерКонтрагентаМСП", Тип("КнопкаФормы"), ГруппаФЗ223МСП);
		ГиперссылкаКлассификаторы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		ГиперссылкаКлассификаторы.Отображение = ОтображениеКнопки.Картинка;
		ГиперссылкаКлассификаторы.Картинка = БиблиотекаКартинок.Изменить;
		ГиперссылкаКлассификаторы.Заголовок = НСтр("ru = 'Изменить'");
		ГиперссылкаКлассификаторы.ИмяКоманды = ИмяКоманды + "Изменить";  
		
		ГиперссылкаКлассификаторы = Элементы.Добавить("ГиперссылкаРазмерКонтрагентаМСПОткрыть", Тип("КнопкаФормы"), ГруппаФЗ223МСП);
		ГиперссылкаКлассификаторы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		ГиперссылкаКлассификаторы.Отображение = ОтображениеКнопки.Картинка;
		ГиперссылкаКлассификаторы.Картинка = БиблиотекаКартинок.Найти;
		ГиперссылкаКлассификаторы.Заголовок = НСтр("ru = 'Открыть'");
		ГиперссылкаКлассификаторы.ИмяКоманды = ИмяКоманды;   
		
	КонецЕсли;

КонецПроцедуры

Функция НайтиДокументРегистрацииРазмера(СсылкаВход)
	ПустойДокумент = Документы.РегистрацияРазмераКонтрагентаДляЕИС.ПустаяСсылка();
	РезультатФункции = ПустойДокумент;
	Если ЗначениеЗаполнено(СсылкаВход) Тогда
		ДанынеКонтрагента = РегистрыСведений.РазмерыКонтрагентовМСПДляЕИС.ПолучитьДанныеРегистрацииРазмера(СсылкаВход);
		РезультатФункции = ДанынеКонтрагента.Регистратор;
	Иначе       
		РезультатФункции = ПустойДокумент;
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // НайтиДокументРегистрацииРазмера()   

// Возвращает данные документа регистрации размера контрагента
// для текущего объекта формы.
Функция ПолучитьДанныеРазмерКонтрагента(КонтрагентПартнера) Экспорт 
	УстановитьПривилегированныйРежим(Истина);
	РезультатФункции = НСтр("ru = 'Регистратор'");
	СсылкаКонтрагент = КонтрагентПартнера;
	ДанныеРегистрации = РегистрыСведений.РазмерыКонтрагентовМСПДляЕИС.ПолучитьДанныеРегистрацииРазмера(СсылкаКонтрагент);
	Возврат ДанныеРегистрации;
КонецФункции		 // ПолучитьИмяКомандыРазмерКонтрагента()


