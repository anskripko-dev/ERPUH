#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Процедура ВернутьЗначенияНастроек(СтруктураНастроек) Экспорт
	Если СтруктураНастроек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	// НАЧАЛО Османов Нагим 25.07.2022 Выполнение задач №000042020
	//	"ВЫБРАТЬ "; 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ "; 
	// КОНЕЦ Османов Нагим 25.07.2022 Выполнение задач №000042020
	Для Каждого Свойство ИЗ СтруктураНастроек Цикл
		Запрос.Текст = Запрос.Текст + "
		|	тн_НастройкиДиадок." + Свойство.Ключ + " КАК " + Свойство.Ключ + ",";	
	КонецЦикла;
	Запрос.Текст = Сред(Запрос.Текст,1, СтрДлина(Запрос.Текст)-1);
		Запрос.Текст = Запрос.Текст + "
		|ИЗ
		|	РегистрСведений.тн_НастройкиДиадок КАК тн_НастройкиДиадок";

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка);
КонецПроцедуры
#КонецЕсли