Процедура ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеРегистра.Документ КАК Документ,
	|	ДанныеРегистра.ВидБюджета КАК ВидБюджета,
	|	ДанныеРегистра.ЦФО КАК ЦФО,
	|	ДанныеРегистра.Проект КАК Проект,
	|	ДанныеРегистра.ДокументБюджетирования КАК ДокументБюджетирования,
	|	ДанныеРегистра.НачалоПериода КАК НачалоПериода,
	|	ДанныеРегистра.Периодичность КАК Периодичность,
	|	ДанныеРегистра.УдалитьПериодЛимитирования КАК УдалитьПериодЛимитирования,
	|	ДанныеРегистра.УдалитьПериодЛимитирования.Периодичность КАК Новый_Периодичность,
	|	ДанныеРегистра.УдалитьПериодЛимитирования.ДатаНачала КАК Новый_НачалоПериода
	|ИЗ
	|	РегистрСведений.УдалитьУстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования КАК ДанныеРегистра
	|ГДЕ
	|	ДанныеРегистра.УдалитьПериодЛимитирования <> ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)
	|	И (ДанныеРегистра.НачалоПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ДанныеРегистра.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка))";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьУстановкаЛимитовПоДаннымБюджетированияПараметрыБюджетирования.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Документ.Установить(Выборка.Документ);
		НаборЗаписей.Отбор.ВидБюджета.Установить(Выборка.ВидБюджета);
		НаборЗаписей.Отбор.ЦФО.Установить(Выборка.ЦФО);
		НаборЗаписей.Отбор.Проект.Установить(Выборка.Проект);
		НаборЗаписей.Отбор.ДокументБюджетирования.Установить(Выборка.ДокументБюджетирования);
		НаборЗаписей.Отбор.УдалитьПериодЛимитирования.Установить(Выборка.УдалитьПериодЛимитирования);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 1 Тогда
			Движение = НаборЗаписей[0];
			Движение.НачалоПериода = Выборка.Новый_НачалоПериода;
			Движение.Периодичность = Выборка.Новый_Периодичность;
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

