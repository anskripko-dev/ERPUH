#Область ПрограммныйИнтерфейс

Функция ЛинейнаяТаблицаВесовЛиквидности(ИсточникиДанных = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИсточникиДанных.Источник КАК Источник,
	|	ИсточникиДанных.ПриходРасход КАК ПриходРасход
	|ПОМЕСТИТЬ ВТ_ИсточникиДанных
	|ИЗ
	|	&ИсточникиДанных КАК ИсточникиДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатрицаВесовЛиквидности.Источник КАК Источник,
	|	МатрицаВесовЛиквидности.ПриходРасход КАК ПриходРасход,
	|	МатрицаВесовЛиквидности.ГоризонтПланированияЛиквидности КАК ГоризонтПланированияЛиквидности,
	|	МатрицаВесовЛиквидности.Вес КАК Вес
	|ИЗ
	|	РегистрСведений.МатрицаВесовЛиквидности КАК МатрицаВесовЛиквидности
	|ГДЕ
	|	Истина И &ДополнительныйОтбор";

	ТаблицаИсточникиДанных = Новый ТаблицаЗначений;
	ТаблицаИсточникиДанных.Колонки.Добавить("Источник",Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиДанныхПлатежногоКалендаря"));	
	ТаблицаИсточникиДанных.Колонки.Добавить("ПриходРасход", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"));	

	Если Не ИсточникиДанных = Неопределено Тогда 
		
		Для Каждого СтрокаТаблицы Из ИсточникиДанных Цикл 
			
			Если СтрокаТаблицы.Поступления Тогда 
				НовСтр = ТаблицаИсточникиДанных.Добавить();
				НовСтр.Источник = СтрокаТаблицы.ИсточникДанных;
				НовСтр.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Приход;
			КонецЕсли; 
			
			Если СтрокаТаблицы.Списания Тогда 
				НовСтр = ТаблицаИсточникиДанных.Добавить();
				НовСтр.Источник = СтрокаТаблицы.ИсточникДанных;
				НовСтр.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			КонецЕсли;
			
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДополнительныйОтбор","(МатрицаВесовЛиквидности.Источник,МатрицаВесовЛиквидности.ПриходРасход) В
												|(ВЫБРАТЬ ИсточникиДанных.Источник,ИсточникиДанных.ПриходРасход ИЗ ВТ_ИсточникиДанных КАК ИсточникиДанных)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДополнительныйОтбор","ИСТИНА");
	КонецЕсли;

	Запрос.УстановитьПараметр("ИсточникиДанных", ТаблицаИсточникиДанных);  

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КроссТаблицаВесовЛиквидности(Знач ЛинейнаяТаблицаВход = Неопределено) Экспорт
	
	КроссТаблица = НовыйКроссТаблицаВесовЛиквидности(ЛинейнаяТаблицаВход);
	
	Если ЛинейнаяТаблицаВход = Неопределено Тогда
		ЛинейнаяТаблица = ЛинейнаяТаблицаВесовЛиквидности();
	Иначе
		ЛинейнаяТаблица = ЛинейнаяТаблицаВход;
	КонецЕсли;
	
	Для Каждого ТекСтрокаВеса из ЛинейнаяТаблица Цикл
		СтрокаДляЗаполнения = КроссТаблица.Найти(ТекСтрокаВеса.Источник, "Источник");
		Если СтрокаДляЗаполнения <> Неопределено Тогда
			ИмяГоризонта = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекСтрокаВеса.ГоризонтПланированияЛиквидности);
			ИмяПриходРасход = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекСтрокаВеса.ПриходРасход);
			
			СтрокаДляЗаполнения[ИмяГоризонта + "_" + ИмяПриходРасход] = ТекСтрокаВеса.Вес;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КроссТаблица;
	
КонецФункции

Функция ПреобразоватьКроссТаблицуВЛинейнуюТаблицу(Знач КроссТаблицаВход) Экспорт
	
	ЛинейнаяТаблица = НовыйЛинейнаяТаблицаВесовЛиквидности();
	
	Для Каждого ТекКолонка Из КроссТаблицаВход.Колонки Цикл
		
		Если ТекКолонка.Имя = "Источник" Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПеречислений = СтрРазделить(ТекКолонка.Имя, "_");
		
		Если ИменаПеречислений.Количество() <> 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ГоризонтПланированияЛиквидности = Перечисления.ГоризонтыПланированияЛиквидности[ИменаПеречислений[0]];
		ПриходРасход = Перечисления.ВидыДвиженийПриходРасход[ИменаПеречислений[1]];
		
		Для Каждого ТекСтрока Из КроссТаблицаВход Цикл
			
			НоваяЗапись = ЛинейнаяТаблица.Добавить();
			НоваяЗапись.Источник = ТекСтрока.Источник;
			НоваяЗапись.ГоризонтПланированияЛиквидности = ГоризонтПланированияЛиквидности;
			НоваяЗапись.ПриходРасход = ПриходРасход;
			НоваяЗапись.Вес = ТекСтрока[ТекКолонка.Имя];
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ЛинейнаяТаблица;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИспользуемыеИсточникиДанных(ЭтоБазоваяФункциональность) Экспорт    					

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МатрицаВесовЛиквидности.Источник КАК Источник
	|ИЗ
	|	РегистрСведений.МатрицаВесовЛиквидности КАК МатрицаВесовЛиквидности
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЭтоБазоваяФункциональность
	|				ТОГДА МатрицаВесовЛиквидности.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиДанныхПлатежногоКалендаря.ЗаявкиУтвержденные)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	МатрицаВесовЛиквидности.Источник";
	
	Запрос.УстановитьПараметр("ЭтоБазоваяФункциональность", ЭтоБазоваяФункциональность);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Источник");
	
КонецФункции  

Функция НовыйКроссТаблицаВесовЛиквидности(Знач ЛинейнаяТаблицаВход = Неопределено)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Источник", Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиДанныхПлатежногоКалендаря"));
	Для Каждого ТекГоризонт Из Перечисления.ГоризонтыПланированияЛиквидности Цикл
		ИмяГоризонта = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекГоризонт);
		Для Каждого ТекПриходРасход из Перечисления.ВидыДвиженийПриходРасход Цикл
			ИмяПриходРасход = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПриходРасход);
			
			Результат.Колонки.Добавить(ИмяГоризонта + "_" + ИмяПриходРасход, Метаданные.ОпределяемыеТипы.ВесИсточникаДанныхПлатежногоКалендаря.Тип);
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ТекИсточникДанныхПлатежногоКалендаря из Перечисления.ИсточникиДанныхПлатежногоКалендаря Цикл
		
		Если Не ЛинейнаяТаблицаВход = Неопределено Тогда 
			
			НайдСтроки = ЛинейнаяТаблицаВход.НайтиСтроки(Новый Структура("Источник",ТекИсточникДанныхПлатежногоКалендаря));
			
			Если Не НайдСтроки.Количество() Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Источник = ТекИсточникДанныхПлатежногоКалендаря;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // НовыйТаблицаВесовЛиквидности()

Функция НовыйЛинейнаяТаблицаВесовЛиквидности()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Источник",							Новый ОписаниеТипов("ПеречислениеСсылка.ИсточникиДанныхПлатежногоКалендаря"));
	Результат.Колонки.Добавить("ПриходРасход",						Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийПриходРасход"));
	Результат.Колонки.Добавить("ГоризонтПланированияЛиквидности",	Новый ОписаниеТипов("ПеречислениеСсылка.ГоризонтыПланированияЛиквидности"));
	Результат.Колонки.Добавить("Вес",								Метаданные.ОпределяемыеТипы.ВесИсточникаДанныхПлатежногоКалендаря.Тип);
	
	Возврат Результат;
	
КонецФункции
	
#КонецОбласти

#КонецЕсли
