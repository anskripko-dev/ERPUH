Процедура ЗаполнитьПараметрыКурсаВРазмещенииЗаявок() Экспорт
	
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ
	|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию,
	|	РазмещениеЗаявок.ПриходРасход КАК ПриходРасход,
	|	РазмещениеЗаявок.ИдентификаторПозиции КАК ИдентификаторПозиции,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КурсПлатежа КАК КурсПлатежа,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КратностьПлатежа КАК КратностьПлатежа,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.СпособОпределенияКурсаПлатежа КАК СпособОпределенияКурсаПлатежа,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.ДатаФиксацииКурсаПлатежа КАК ДатаФиксацииКурсаПлатежа,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.СдвигДатыФиксацииКурсаПлатежа КАК СдвигДатыФиксацииКурсаПлатежа,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КурсПлатежаНеБолее КАК КурсПлатежаНеБолее,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КурсПлатежаНеМенее КАК КурсПлатежаНеМенее,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КурсПлатежаНеМенееВВалютеОплаты КАК КурсПлатежаНеМенееВВалютеОплаты,
	|	РазмещениеЗаявок.ЗаявкаНаОперацию.КурсПлатежаНеБолееВВалютеОплаты КАК КурсПлатежаНеБолееВВалютеОплаты
	|ИЗ
	|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
	|ГДЕ
	|	РазмещениеЗаявок.СпособОпределенияКурсаПлатежа = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.ПустаяСсылка)
	|	И РазмещениеЗаявок.ЗаявкаНаОперацию.СпособОпределенияКурсаПлатежа <> ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияКурсаПлатежа.ПустаяСсылка)";
	
	Запрос = Новый Запрос;
	
	ТекстыПодзапросов = Новый Массив;
	
	ТекстДляЗамены = "РазмещениеЗаявок.ЗаявкаНаОперацию";
	
	ШаблонЗаявка = "ВЫРАЗИТЬ(%1 КАК Документ.%2)";
	ШаблонГде = "
			|	И РазмещениеЗаявок.ЗаявкаНаОперацию ССЫЛКА Документ.%1";
	
	// заявка на оплату
	ПустаяЗаявка = КэшируемыеПроцедурыОПК.ПустаяЗаявкаНаОплату();
	ДокументыЗаявки = Новый Массив;
	ДокументыЗаявки.Добавить(КэшируемыеПроцедурыОПК.ПустаяЗаявкаНаОплату());
	ДокументыЗаявки.Добавить(КэшируемыеПроцедурыОПК.ПустоеПланируемоеПоступление());
	Для Каждого ДокументЗаявка Из ДокументыЗаявки Цикл
		ИмяМетаданных = ДокументЗаявка.Метаданные().Имя;
		ТекстЗамены = СтрШаблон(ШаблонЗаявка, ТекстДляЗамены, ИмяМетаданных);
		ТекстЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, ТекстДляЗамены, ТекстЗамены)
					 + СтрШаблон(ШаблонГде, ИмяМетаданных);
		ТекстыПодзапросов.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	ТекстОбъекдинения = 
	"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|";
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыПодзапросов, ТекстОбъекдинения);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.РазмещениеЗаявок.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаявкаНаОперацию.Установить(Выборка.ЗаявкаНаОперацию);
		НаборЗаписей.Отбор.ПриходРасход.Установить(Выборка.ПриходРасход);
		НаборЗаписей.Отбор.ИдентификаторПозиции.Установить(Выборка.ИдентификаторПозиции);
		
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Позиция = НаборЗаписей[0];
		Позиция.СпособОпределенияКурсаПлатежа = Выборка.СпособОпределенияКурсаПлатежа;
		Если Позиция.СпособОпределенияКурсаПлатежа = Перечисления.СпособыОпределенияКурсаПлатежа.ФиксированныйКурс
			И Позиция.КурсПлатежа = 0 Тогда
			Позиция.КурсПлатежа = Выборка.КурсПлатежа;
			Позиция.КратностьПлатежа = Выборка.КратностьПлатежа;
		КонецЕсли;
		Позиция.ДатаФиксацииКурсаПлатежа = Выборка.ДатаФиксацииКурсаПлатежа;
		Позиция.СдвигДатыФиксацииКурсаПлатежа = Выборка.СдвигДатыФиксацииКурсаПлатежа;
		Позиция.КурсПлатежаНеБолее = Выборка.КурсПлатежаНеБолее;
		Позиция.КурсПлатежаНеМенее = Выборка.КурсПлатежаНеМенее;
		Позиция.КурсПлатежаНеМенееВВалютеОплаты = Выборка.КурсПлатежаНеМенееВВалютеОплаты;
		Позиция.КурсПлатежаНеБолееВВалютеОплаты = Выборка.КурсПлатежаНеБолееВВалютеОплаты;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

