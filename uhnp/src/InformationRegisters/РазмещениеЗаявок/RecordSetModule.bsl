#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("НеОбновлятьДенежныеСредстваКВыплате") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаявкаНаОперацию = ЭтотОбъект.Отбор.ЗаявкаНаОперацию.Значение;	
	
	Если Не ЗначениеЗаполнено(ЗаявкаНаОперацию) Тогда
		
		ИдентификаторПозиции = ЭтотОбъект.Отбор.ИдентификаторПозиции.Значение;	
		
		Если ЗначениеЗаполнено(ИдентификаторПозиции) Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РазмещениеЗаявок.ЗаявкаНаОперацию КАК ЗаявкаНаОперацию
			|ИЗ
			|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
			|ГДЕ
			|	РазмещениеЗаявок.ИдентификаторПозиции = &ИдентификаторПозиции";
			
			Запрос.УстановитьПараметр("ИдентификаторПозиции", ИдентификаторПозиции);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();			
			ВыборкаДетальныеЗаписи.Следующий(); 
			
			ЗаявкаНаОперацию = ВыборкаДетальныеЗаписи.ЗаявкаНаОперацию;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаОперацию) Тогда
		
		ТипыДокументовПланирования = Новый Массив;
		ТипыДокументовПланирования.Добавить(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
		ТипыДокументовПланирования.Добавить(Тип("ДокументСсылка.ЗаявкаНаКомандировку"));			
		
		//Проверим тип регистратора
		Если Не ТипыДокументовПланирования.Найти(ТипЗнч(ЗаявкаНаОперацию)) = Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Регистратор,
			|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	РазмещениеЗаявок.БанковскийСчетКасса КАК БанковскийСчетКасса,
			|	ВЫБОР
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.Ссылка.СписокФизЛиц
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаЗаймаСотруднику))
			|			ТОГДА ЗаявкаНаРасходованиеДенежныхСредств.ПодотчетноеЛицо
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств))
			|			ТОГДА ЗаявкаНаРасходованиеДенежныхСредств.ОрганизацияПолучатель
			|		ИНАЧЕ ЗаявкаНаРасходованиеДенежныхСредств.Контрагент
			|	КОНЕЦ КАК Получатель,
			|	РазмещениеЗаявок.Организация КАК Организация,
			|	СУММА(РазмещениеЗаявок.СуммаВзаиморасчетов) КАК Сумма,
			|	ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
			|	РазмещениеЗаявок.ДатаИсполнения КАК Период,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения
			|ИЗ
			|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
			|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
			|ГДЕ
			|	РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
			|	И РазмещениеЗаявок.Проведен
			|	И РазмещениеЗаявок.ДатаИсполнения <> ДАТАВРЕМЯ(1, 1, 1)
			|	И ЗаявкаНаРасходованиеДенежныхСредств.Ссылка = &ЗаявкаНаОперацию
			|
			|СГРУППИРОВАТЬ ПО
			|	РазмещениеЗаявок.БанковскийСчетКасса,
			|	ВЫБОР
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.Ссылка.СписокФизЛиц
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаЗаймаСотруднику))
			|			ТОГДА ЗаявкаНаРасходованиеДенежныхСредств.ПодотчетноеЛицо
			|		КОГДА ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию), ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВнутренняяПередачаДенежныхСредств))
			|			ТОГДА ЗаявкаНаРасходованиеДенежныхСредств.ОрганизацияПолучатель
			|		ИНАЧЕ ЗаявкаНаРасходованиеДенежныхСредств.Контрагент
			|	КОНЕЦ,
			|	РазмещениеЗаявок.Организация,
			|	РазмещениеЗаявок.ДатаИсполнения,
			|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка,
			|	ЗаявкаНаРасходованиеДенежныхСредств.ХозяйственнаяОперация,
			|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЗаявкаНаКомандировку.Ссылка,
			|	ЗаявкаНаКомандировку.Ссылка,
			|	РазмещениеЗаявок.БанковскийСчетКасса,
			|	ЗаявкаНаКомандировку.Сотрудник,
			|	РазмещениеЗаявок.Организация,
			|	СУММА(РазмещениеЗаявок.СуммаВзаиморасчетов),
			|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику),
			|	РазмещениеЗаявок.ДатаИсполнения,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|ИЗ
			|	РегистрСведений.РазмещениеЗаявок КАК РазмещениеЗаявок
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаКомандировку КАК ЗаявкаНаКомандировку
			|		ПО РазмещениеЗаявок.ЗаявкаНаОперацию = ЗаявкаНаКомандировку.Ссылка
			|ГДЕ
			|	РазмещениеЗаявок.ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)
			|	И РазмещениеЗаявок.Проведен
			|	И РазмещениеЗаявок.ДатаИсполнения <> ДАТАВРЕМЯ(1, 1, 1)
			|	И ЗаявкаНаКомандировку.Ссылка = &ЗаявкаНаОперацию
			|
			|СГРУППИРОВАТЬ ПО
			|	РазмещениеЗаявок.БанковскийСчетКасса,
			|	РазмещениеЗаявок.Организация,
			|	РазмещениеЗаявок.ДатаИсполнения,
			|	ЗаявкаНаКомандировку.Ссылка,
			|	ЗаявкаНаКомандировку.Ссылка,
			|	ЗаявкаНаКомандировку.Сотрудник";
			
			Запрос.УстановитьПараметр("ЗаявкаНаОперацию", ЗаявкаНаОперацию);
			
			ТаблицаРазмещенияЗаявок = Запрос.Выполнить().Выгрузить();
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ДенежныеСредстваКВыплате");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = ТаблицаРазмещенияЗаявок;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ЗаявкаНаРасходованиеДенежныхСредств", "ЗаявкаНаРасходованиеДенежныхСредств");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("БанковскийСчетКасса", "БанковскийСчетКасса");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Получатель", 		   "Получатель");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", 		   "Организация");
			
			Блокировка.Заблокировать();	 
			
			НаборЗаписей = РегистрыНакопления.ДенежныеСредстваКВыплате.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ЗаявкаНаОперацию);  
			НаборЗаписей.Прочитать();   
			
			НаборЗаписей.Загрузить(ТаблицаРазмещенияЗаявок);
			
			НаборЗаписей.Записать(); 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
