&НаСервереБезКонтекста
Процедура УдалитьЗаписьРегистра(Инвестор, ОбъектИнвестирования, Сценарий)
	Набор = РегистрыСведений.МоделированиеДвиженийИнвестиций.СоздатьНаборЗаписей();
	Набор.Отбор.Инвестор.Установить(Инвестор);
	Набор.Отбор.ОбъектИнвестирования.Установить(ОбъектИнвестирования);
	Набор.Отбор.Сценарий.Установить(Сценарий);
	Набор.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАтрибутОбъекта(ПоступлениеИнвестиций, Действие)
	Объект = ПоступлениеИнвестиций.ПолучитьОбъект();
	Если Действие = "Удаление" Тогда
		Объект.УстановитьПометкуУдаления(Истина);
	ИначеЕсли Действие = "Провести" Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	ИначеЕсли Действие = "ОтменаПроведения" Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура СоздатьИПровестиДокумент(СтрокаЗаполнения)
	Перем СозданныеДокументы;
	
	ВыделенныеСтроки = РегистрыСведений.МоделированиеДвиженийИнвестиций.СоздатьНаборЗаписей().ВыгрузитьКолонки();		
	СтрокаТаб = ВыделенныеСтроки.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТаб, СтрокаЗаполнения);
	
	Если Не ЗначениеЗаполнено(СтрокаТаб.Дата) Тогда
		СтрокаТаб.Дата = ТекущаяДата();			
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаТаб.Сценарий) Тогда
		СтрокаТаб.Сценарий = Сценарий;			
	КонецЕсли;
	СтрокаТаб.МСО = Истина;
	
	Попытка
		СозданныеДокументы = Обработки.СтруктураВладения.СформироватьДвиженияИнвестицийПоТаблицеМоделирования(Сценарий, ВыделенныеСтроки);
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сформировать Движения инвестиций по причине: '") + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры


&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Элементы.Список.ТекущиеДанные.Ссылка) Тогда
		ПоказатьЗначение(, Элементы.Список.ТекущиеДанные.Ссылка);
	Иначе
		ЗначениеКлюча = Новый Структура("Инвестор, ОбъектИнвестирования, Сценарий", Элементы.Список.ТекущиеДанные.Инвестор, Элементы.Список.ТекущиеДанные.ОбъектИнвестирования, Сценарий);
        МассивКлючей = Новый Массив;
        МассивКлючей.Добавить(ЗначениеКлюча);
        КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.МоделированиеДвиженийИнвестиций", МассивКлючей);
        ОткрытьФорму("РегистрСведений.МоделированиеДвиженийИнвестиций.ФормаЗаписи", Новый Структура("Ключ", КлючЗаписи));
	КонецЕсли;
КонецПроцедуры

