&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	ПараметрыЗаполнения = Новый Структура;
 	ПараметрыЗаполнения.Вставить("Дата", ТекущаяДата());
	ПараметрыЗаполнения.Вставить("МСО", Истина);
	ПараметрыЗаполнения.Вставить("Сценарий", Сценарий);
 	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, СкрытьСценарий", ПараметрыЗаполнения, Истина);
	ОткрытьФорму("РегистрСведений.МоделированиеДвиженийИнвестиций.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

