
&НаКлиенте
Процедура ВыгрузитьШаблон(Команда)
	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Фильтр = НСтр("ru = 'Файл Excel'; en = 'Excel file'") + "(*.xlsx)|*.xlsx";
	
	ДиалогСохранения.Показать(Новый ОписаниеОповещения("ВыгрузитьШаблонЗавершение", ЭтотОбъект, Новый Структура("ДиалогСохранения", ДиалогСохранения)));
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьШаблонЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	ДиалогСохранения = ДополнительныеПараметры.ДиалогСохранения;
	
	
	РезультатВыбора = (ВыбранныеФайлы <> Неопределено);
	
	Если РезультатВыбора <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок = СоздатьИЗаполнитьШаблон();
	ТабДок.Записать(ДиалогСохранения.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ЗагрузитьКорректировкиИзФайла", ЭтотОбъект);
	
	ДиалогВыбораФайла = Новый Структура;
	ДиалогВыбораФайла.Вставить("Заголовок", "Загрузка движений инвестиций");
	ДиалогВыбораФайла.Вставить("Фильтр", "Файлы Microsoft Excel (*.xls, *.xlsx)|*.xls; *.xlsx|Файлы табличного документа (*.mxl)|*.mxl|Все файлы (*.*)|*.*");	
	
	ОбщегоНазначенияКлиентУХ.ПоказатьПомещениеФайла(Оповещение, УникальныйИдентификатор, "", ДиалогВыбораФайла);
КонецПроцедуры

&НаСервере
Функция СоздатьИЗаполнитьШаблон()
	Макет = РегистрыСведений.ДанныеРасчетаПоказателейРНБВП.ПолучитьМакет("Шаблон");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыОбъектовИнвестированияСрезПоследних.ОбъектИнвестирования КАК ОбъектИнвестирования
		|ПОМЕСТИТЬ ВсеОрганизацииВсехГрупп
		|ИЗ
		|	РегистрСведений.СтатусыОбъектовИнвестирования.СрезПоследних(
		|			,
		|			Сценарий В
		|				(ВЫБРАТЬ
		|					СценарийМСФО.Значение КАК Значение
		|				ИЗ
		|					Константа.СценарийМСФО КАК СценарийМСФО)) КАК СтатусыОбъектовИнвестированияСрезПоследних
		|ГДЕ
		|	СтатусыОбъектовИнвестированияСрезПоследних.ОтношениеКГруппе.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.Дочернее)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СтатусыОбъектовИнвестированияСрезПоследних.Инвестор
		|ИЗ
		|	РегистрСведений.СтатусыОбъектовИнвестирования.СрезПоследних(
		|			,
		|			Сценарий В
		|				(ВЫБРАТЬ
		|					СценарийМСФО.Значение КАК Значение
		|				ИЗ
		|					Константа.СценарийМСФО КАК СценарийМСФО)) КАК СтатусыОбъектовИнвестированияСрезПоследних
		|ГДЕ
		|	СтатусыОбъектовИнвестированияСрезПоследних.ОтношениеКГруппе.ВидОтношенияКГруппе = ЗНАЧЕНИЕ(Перечисление.ВидыОтношенийКГруппе.Дочернее)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеОрганизацииВсехГрупп.ОбъектИнвестирования КАК ОбъектИнвестирования,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.Прибыль, 0) КАК Прибыль,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.Активы, 0) КАК Активы,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.НалогНаПрибыль, 0) КАК НалогНаПрибыль,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.EBITDA, 0) КАК EBITDA,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.РасходыПоПроцентам, 0) КАК РасходыПоПроцентам,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.Капитал, 0) КАК Капитал,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.ДобавочныйКапитал, 0) КАК ДобавочныйКапитал,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.НакопленнаяПрибыль, 0) КАК НакопленнаяПрибыль,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.Доход, 0) КАК Доход,
		|	ЕСТЬNULL(ДанныеРасчетаПоказателейРНБВПСрезПоследних.ЧисленностьРаботников, 0) КАК ЧисленностьРаботников
		|ИЗ
		|	ВсеОрганизацииВсехГрупп КАК ВсеОрганизацииВсехГрупп
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеРасчетаПоказателейРНБВП.СрезПоследних КАК ДанныеРасчетаПоказателейРНБВПСрезПоследних
		|		ПО ВсеОрганизацииВсехГрупп.ОбъектИнвестирования = ДанныеРасчетаПоказателейРНБВПСрезПоследних.Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.Вывести(ОбластьШапка);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ЗагрузитьКорректировкиИзФайла(ПомещенныеФайлы, ДополнительныеПараметры = Неопределено) Экспорт  

	Если ПомещенныеФайлы = Неопределено Или (ПомещенныеФайлы.Количество() = 0) Тогда		
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКорректировкиИзФайлаНаСервере(ПомещенныеФайлы[0]);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКорректировкиИзФайлаНаСервере(ИмяФайла)	
	Таб = РегистрыСведений.ДанныеРасчетаПоказателейРНБВП.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	отСтрока = ОбщегоНазначенияУХ.ПолучитьОписаниеТиповСтроки(300);
	ТабДок = Новый ТабличныйДокумент;
	Таб.Колонки.Добавить("тОрганизация",	отСтрока);
	Таб.Колонки.Добавить("тКод",			отСтрока);
	
	Попытка
		РасширениеФайла = СтроковыеФункцииКлиентСерверУХ.РазложитьСтрокуВМассивПодстрок(ИмяФайла.Имя, ".");
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла[РасширениеФайла.ВГраница()]);
		ДанныеФайла = ПолучитьИзВременногоХранилища(ИмяФайла.Хранение);
		ДанныеФайла.Записать(ИмяВременногоФайла);		
		ТабДок.Прочитать(ИмяВременногоФайла);
		УдалитьФайлы(ИмяВременногоФайла);
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;	
	
	Для Стр = 2 По ТабДок.ВысотаТаблицы Цикл
		
		Код = СокрЛП(ТабДок.Область(Стр, 2).Текст);
		
		Если Не ЗначениеЗаполнено(Код) Тогда			
			Продолжить;			
		КонецЕсли;
		
		СтрокаТаб = Таб.Добавить();
		СтрокаТаб.тОрганизация 				= СокрЛП(ТабДок.Область(Стр, 1).Текст);
		СтрокаТаб.тКод		 				= СокрЛП(ТабДок.Область(Стр, 2).Текст);		
		СтрокаТаб.Прибыль					= Числом(ТабДок.Область(Стр, 3).Текст);
		СтрокаТаб.Активы					= Числом(ТабДок.Область(Стр, 4).Текст);
		СтрокаТаб.НалогНаПрибыль			= Числом(ТабДок.Область(Стр, 5).Текст);
		СтрокаТаб.EBITDA					= Числом(ТабДок.Область(Стр, 6).Текст);
		СтрокаТаб.РасходыПоПроцентам		= Числом(ТабДок.Область(Стр, 7).Текст);
		СтрокаТаб.Капитал					= Числом(ТабДок.Область(Стр, 8).Текст);
		СтрокаТаб.ДобавочныйКапитал			= Числом(ТабДок.Область(Стр, 9).Текст);
		СтрокаТаб.НакопленнаяПрибыль		= Числом(ТабДок.Область(Стр, 10).Текст);
		СтрокаТаб.Доход						= Числом(ТабДок.Область(Стр, 11).Текст);
		СтрокаТаб.ЧисленностьРаботников		= Числом(ТабДок.Область(Стр, 14).Текст);		
		
	КонецЦикла;
	Коды = Таб.ВыгрузитьКолонку("Код");
	
	СтрокиКУдалению = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.Код КАК Код
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Код В(&Коды)
		|	И Организации.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Коды", Коды);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из Таб Цикл
	
		Если РезультатЗапроса.Найти(Стр.Код, "Код") = Неопределено Тогда
			СтрокиКУдалению.Добавить(Стр);
		Иначе
			Стр.Организация = РезультатЗапроса.Найти(Стр.Код, "Код").Организация;
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого Стр Из СтрокиКУдалению Цикл
		Таб.Удалить(Стр);
	КонецЦикла;

	НачатьТранзакцию();
	
	Набор = РегистрыСведений.ДанныеРасчетаПоказателейРНБВП.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(НачалоГода(ТекущаяДата()));
	Для каждого Стр Из Таб Цикл
		Запись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Стр);
	КонецЦикла;
	Набор.Записать();
	ЗафиксироватьТранзакцию();
	Возврат;
КонецПроцедуры

&НаСервере
Функция Числом(СтрокаИсточник)
	Если СтрокаИсточник = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(СтрокаИсточник);
	Исключение
		ОбщегоНазначенияУХ.СообщитьОбОшибке("Не удалось преобразовать в число: " + СтрокаИсточник);
		Возврат 0;
	КонецПопытки;
КонецФункции
