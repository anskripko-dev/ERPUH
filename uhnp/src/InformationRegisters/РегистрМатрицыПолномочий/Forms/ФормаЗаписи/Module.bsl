
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Если Параметры.ЗначенияЗаполнения.Свойство("ДокументБД") Тогда
		 Запись.ДокументБД = Параметры.ЗначенияЗаполнения["ДокументБД"];
	КонецЕсли;
	
	Если Параметры.ЗначенияЗаполнения.Свойство("ШаблонДокументаБД") Тогда
		 Запись.ШаблонДокументаБД = Параметры.ЗначенияЗаполнения["ШаблонДокументаБД"];
	КонецЕсли;

	
	ОбновитьДоступностьРеквизитов();  		
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонДокументаБДПриИзменении(Элемент)
	ОбновитьДоступностьРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ДокументБДПриИзменении(Элемент)
	ОбновитьДоступностьРеквизитов();
КонецПроцедуры

Процедура ОбновитьДоступностьРеквизитов()
	
	ИспользоватьОрганизации = Ложь;
	ИспользоватьПроекты	    = Ложь;   	
		
	Если ЗначениеЗаполнено(Запись.ДокументБД) Тогда
		
		Если Запись.ДокументБД.Наименование = "РакурсДанных" Тогда
			
			Если ЗначениеЗаполнено(Запись.ШаблонДокументаБД) Тогда
				
				ИспользоватьОрганизации = Запись.ШаблонДокументаБД.РазделятьПоОрганизациям;
				ИспользоватьПроекты	    = Запись.ШаблонДокументаБД.РазделятьПоПроектам;
				
			КонецЕсли;			
			
		Иначе				
			ИспользоватьОрганизации = Запись.ДокументБД.РазделятьПоОрганизациям;
			ИспользоватьПроекты	    = Запись.ДокументБД.РазделятьПоПроектам;		
		КонецЕсли;	
		
		Если Запись.ДокументБД.Наименование = "РакурсДанных" ИЛИ Запись.ДокументБД.Наименование = "НастраиваемыйОтчет" Тогда
			 Элементы.Исполняющий.Доступность = Истина;
		Иначе	 
			 Элементы.Исполняющий.Доступность = Ложь;
		КонецЕсли;
		
		Элементы.ВерсияРегламентаПодготовкиОтчетности.Доступность = Запись.ДокументБД.ИспользуетсяВНастройкахРеглмента;
					
	КонецЕсли;	

	
	Элементы.Организация.Доступность = ИспользоватьОрганизации;
	Элементы.Проект.Доступность 	 = ИспользоватьПроекты;
	
КонецПроцедуры

&НаКлиенте
Процедура СогласованиеПриИзменении(Элемент)
	// Предупредим пользователя о некорректной работе, если выбран маршрут Автоутверждение.
	Если РасширениеПроцессыИСогласованиеУХ.ПроверитьЭтоШаблонАвтоутверждение(Запись.Согласование) Тогда
		ТекстСообщения = НСтр("ru = 'Выбран шаблон процесса Автоутверждение. Работа процесса может быть некорректной.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	Иначе
		// Проверка пройдена.
	КонецЕсли;
КонецПроцедуры
