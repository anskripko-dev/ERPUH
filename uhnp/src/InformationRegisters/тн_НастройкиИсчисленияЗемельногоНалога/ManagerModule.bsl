Функция ПолучитьНастройки(Организация, ДатаСрез) Экспорт	
	
	РезультатСтруктура = Новый Структура;
    
    Если Не ЗначениеЗаполнено(Организация) Тогда
        Возврат РезультатСтруктура;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ *
        |ИЗ
        |	РегистрСведений.тн_НастройкиИсчисленияЗемельногоНалога.СрезПоследних(
        |		&ДатаСрез,
        |		Организация = &Организация) КАК НастройкиЗемельногоНалога";
    
    Запрос.УстановитьПараметр("ДатаСрез", ДатаСрез);
    Запрос.УстановитьПараметр("Организация", Организация);
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            ИмяПоля     	= Колонка.Имя;
            ЗначениеПоля 	= Выборка[ИмяПоля]; // Получаем значение из выборки по имени
            
            РезультатСтруктура.Вставить(ИмяПоля, ЗначениеПоля);
        КонецЦикла;;
    КонецЕсли;
    
    Возврат РезультатСтруктура;
			
КонецФункции   

#КонецОбласти

#КонецЕсли