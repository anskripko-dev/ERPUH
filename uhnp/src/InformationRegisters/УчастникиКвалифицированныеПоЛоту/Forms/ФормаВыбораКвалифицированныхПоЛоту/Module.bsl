
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Лот = Параметры.Лот;
	ЗакупочнаяПроцедура = Лот.ЗакупочнаяПроцедура;
	Если НЕ ЗначениеЗаполнено(ЗакупочнаяПроцедура) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Форму выбора контрагентов квалифицированных по лоту разрешено открывать только с указанием закупочной процедуры'");
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЕсли;
	// Устанавливаем отбор по массиву контрагентов т.к. динамический
	// запрос с соединением по регистру ведет себя непредсказуемо.
	МассивУчастников = РегистрыСведений.УчастникиКвалифицированныеПоЛоту.ПолучитьПоЗакупке(ЗакупочнаяПроцедура);
	Список.Параметры.УстановитьЗначениеПараметра("мСсылок", МассивУчастников);
КонецПроцедуры
