
#Область ОбработкаОсновныхСобытийФормы


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Свойство("Объект") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Для редактирования версии ЕИС необходимо указать объект.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ОбъектЕИС = Параметры.Объект;
КонецПроцедуры


#КонецОбласти

#Область ОбработкаСобытийЭлементовФормы


&НаКлиенте
Процедура РазмещенПриИзменении(Элемент)
	ТекДанные = Элементы.НаборЗаписей.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработатьИзменениеФлагаРазмещен(ТекДанные.НомерВерсии, ТекДанные.Размещен);
КонецПроцедуры

&НаКлиенте
Процедура НаборЗаписейПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.НаборЗаписей.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ТекДанные.Объект = ОбъектЕИС;
		ТекДанные.НомерВерсии = МаксНомерВерсии() + 1;
		ТекДанные.Дата = УниверсальноеВремя(ТекущаяДата());
		ТекДанные.ГУИДВерсии = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыНаКлиенте


&НаКлиенте
Процедура ОбработатьИзменениеФлагаРазмещен(НомерВерсии, Размещен)
	Если Размещен Тогда
		УстановитьФлагРазмещенПредыдущимВерсиям(НомерВерсии);
	Иначе
		СброситьФлагРазмещенПоследующимВерсиям(НомерВерсии);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагРазмещенПредыдущимВерсиям(ТекущаяВерсия)
	Для Каждого СтрокаРегистра Из НаборЗаписей Цикл
		Если СтрокаРегистра.НомерВерсии < ТекущаяВерсия Тогда
			СтрокаРегистра.Размещен = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СброситьФлагРазмещенПоследующимВерсиям(ТекущаяВерсия)
	Для Каждого СтрокаРегистра Из НаборЗаписей Цикл
		Если СтрокаРегистра.НомерВерсии > ТекущаяВерсия Тогда
			СтрокаРегистра.Размещен = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция МаксНомерВерсии()
	МаксНомер = 0;
	Для Каждого СтрокаРегистра Из НаборЗаписей Цикл
		Если СтрокаРегистра.НомерВерсии > МаксНомер Тогда
			МаксНомер = СтрокаРегистра.НомерВерсии;
		КонецЕсли;
	КонецЦикла;
	Возврат МаксНомер;
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыНаСервере


#КонецОбласти





