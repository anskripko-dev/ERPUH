#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
// Возвращает ГУИД, сопоставленный первой версии строки плана закупок СтрокаПланаВход.
// Когда значение получить не удалось, возвращает пустую ссылку.
Функция ПолучитьГуидПервойВерсииСтрокиПлана(СтрокаПланаВход, ИсключатьСовпадающие = Ложь, ДокументОснованиеВход) Экспорт
	РезультатФункции = "";
	// Получим ссылку на первую версию строки плана.
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.СтатусыВыгружаемыхОбъектовЕИС.Выгружен);
	МассивСтатусов.Добавить(Перечисления.СтатусыВыгружаемыхОбъектовЕИС.Размещен);
	ПерваяВерсияПлана = Документы.СтрокаПланаЗакупок.ПолучитьПервуюВерсиюСтрокиПлана(СтрокаПланаВход, МассивСтатусов);
	ВерсияОснование = Документы.СтрокаПланаЗакупок.ПолучитьВерсиюСтрокиПланаОснования(СтрокаПланаВход, ДокументОснованиеВход);
	// Получим ГУИД, сопоставленный найденной строке плана.
	РазличаетсяПерваяВерсия = (СтрокаПланаВход <> ПерваяВерсияПлана);
	РазличаетсяОснование = (СтрокаПланаВход <> ВерсияОснование);
	Если (НЕ ИсключатьСовпадающие) ИЛИ (РазличаетсяПерваяВерсия) ИЛИ (НЕ РазличаетсяОснование) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВерсииОбъектовДляЕИС.ГУИДВерсии КАК ГУИДВерсии,
		|	ВерсииОбъектовДляЕИС.Объект КАК Объект,
		|	ВерсииОбъектовДляЕИС.НомерВерсии КАК НомерВерсии
		|ИЗ
		|	РегистрСведений.ВерсииОбъектовДляЕИС КАК ВерсииОбъектовДляЕИС
		|ГДЕ
		|	ВерсииОбъектовДляЕИС.Объект = &Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерВерсии";
		Запрос.УстановитьПараметр("Объект", ПерваяВерсияПлана);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выгрузка = РезультатЗапроса.Выгрузить();
			ПерваяСтрока = Выгрузка[0];
			РезультатФункции = ПерваяСтрока.ГУИДВерсии;
		Иначе
			РезультатФункции = "";		// Не удалось найти GUID в регистре.
		КонецЕсли;
	Иначе
		РезультатФункции = "";		// Включен режим исключения совпадающих и версия совпадает.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции		 // ПолучитьГуидПервойВерсииСтрокиПлана()
	
// Устанавливает в регистре ВерсииОбъектовДляЕИС для объекта
// СсылкаВход ресурс Размещен в состояние РазмещенВход. Когда
// параметр НомерВерсииВход не Неопределено, также отбирает
// по номеру версии.
Функция УстановитьФлагРазмещенияПоОбъекту(СсылкаВход, РазмещенВход, НомерВерсииВход = Неопределено) Экспорт
	РезультатФункции = Истина;
	Попытка
		НаборЗаписей = РегистрыСведений.ВерсииОбъектовДляЕИС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(СсылкаВход); 
		Если НомерВерсииВход <> Неопределено Тогда
			НаборЗаписей.Отбор.НомерВерсии.Установить(НомерВерсииВход); 
		Иначе
			// Не требуется отбор по версии.
		КонецЕсли;
		НаборЗаписей.Прочитать();
		Для Каждого ТекНаборЗаписей Из НаборЗаписей Цикл 
			ТекНаборЗаписей.Размещен = РазмещенВход; 
		КонецЦикла; 
		НаборЗаписей.Записать(); 
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось установить флаг размещён для объекта ""%Ссылка%"" с версией %Версия% по причине: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Строка(СсылкаВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Версия%", Строка(НомерВерсииВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции		 // УстановитьФлагРазмещенияПоОбъекту()

#КонецЕсли