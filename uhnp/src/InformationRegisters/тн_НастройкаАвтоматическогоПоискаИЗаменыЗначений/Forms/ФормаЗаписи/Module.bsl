
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект = РеквизитФормыВЗначение("Запись");
	
	Данные = Объект.ИсключаемыеРегистрыСведений.Получить();
	Если Данные = Неопределено Тогда
		Список_ИсключаемыеРегистрыСведений = Новый СписокЗначений;
	Иначе
		Список_ИсключаемыеРегистрыСведений = Данные;
	КонецЕсли;
	
	Список_ИсключаемыеРегистрыСведений.ТипЗначения = Новый ОписаниеТипов("Строка");
	
	//НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	РеквизитыПроверкиЗамен = Объект.РеквизитыПроверкиЗамен;
	Если ЗначениеЗаполнено(РеквизитыПроверкиЗамен) Тогда
		МассивРеквизитовПроверкиЗамен = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(РеквизитыПроверкиЗамен,",");
		Список_РеквизитыПроверкиЗамен.ЗагрузитьЗначения(МассивРеквизитовПроверкиЗамен);
	КонецЕсли;
	//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	
	//НАЧАЛО Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
	
	УстановитьВидимостьДоступностьЭлементов();
	
	//КОНЕЦ  Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыборОбъектовМетаданных" Тогда
		
		Запись.ТипОбъекта = Параметр[0].Значение;
		//НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
		Список_РеквизитыПроверкиЗамен.Очистить();
		УстановитьВидимостьДоступностьЭлементов();
		//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещения()

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ИсключаемыеРегистрыСведений = Новый ХранилищеЗначения(Список_ИсключаемыеРегистрыСведений);
    //НАЧАЛО Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	МассивРеквизитовПроверкиЗамен = Список_РеквизитыПроверкиЗамен.ВыгрузитьЗначения();
	ТекущийОбъект.РеквизитыПроверкиЗамен = СтрСоединить(МассивРеквизитовПроверкиЗамен,",");
	//КОНЕЦ Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
	
КонецПроцедуры // ПередЗаписьюНаСервере()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КоллекцииВыбираемыхОбъектовМетаданных = Новый СписокЗначений;
	КоллекцииВыбираемыхОбъектовМетаданных.Добавить("Справочники");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("Документы");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("Перечисления");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("ПланыВидовХарактеристик");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("ПланыСчетов");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("ПланыВидовРасчета");
	//КоллекцииВыбираемыхОбъектовМетаданных.Добавить("РегистрыСведений");
	
	ВыбранныеОбъектыМетаданных = Новый СписокЗначений;
	
	Если Не ПустаяСтрока(Запись.ТипОбъекта) Тогда
		ВыбранныеОбъектыМетаданных.Добавить(Запись.ТипОбъекта);
	КонецЕсли;
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("КоллекцииВыбираемыхОбъектовМетаданных"	, КоллекцииВыбираемыхОбъектовМетаданных);
	ПараметрыФормыВыбора.Вставить("ВыбранныеОбъектыМетаданных"				, ВыбранныеОбъектыМетаданных);
	ПараметрыФормыВыбора.Вставить("НачальноеЗначениеВыбора"					, Запись.ТипОбъекта);
	ПараметрыФормыВыбора.Вставить("ВыборЕдинственного"						, Истина);
	
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданных", ПараметрыФормыВыбора, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры // ТипОбъектаНачалоВыбора()

//Ведутенко С.А. 29.09.2023 Выполнение задач № 000047019  
//
&НаКлиенте
Процедура ТиповаяОбработкаЗаменПриИзменении(Элемент)
	УстановитьВидимостьДоступностьЭлементов();
КонецПроцедуры

//Сафиуллина З.Р. 27.03.2026 Выполнение задач №000057186
