&НаСервере
Процедура УправлениеДоступностью()
	//Если установлен параметр ТолькоПросмотрИзмерения, то заблокируем поля измерений
	Если Параметры.ТолькоПросмотрИзмерения Тогда
		Элементы.Надежность.ТолькоПросмотр = Истина;
		Элементы.Значимость.ТолькоПросмотр = Истина;
	Иначе
		//Не меняем ТолькоПросмотр у измерений
	КонецЕсли;
КонецПроцедуры

