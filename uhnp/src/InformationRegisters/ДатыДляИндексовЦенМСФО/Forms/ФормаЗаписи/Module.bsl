
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ПодготовитьФормуНаСервере(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда
		ПодготовитьФормуНаСервере(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	ОбновитьОтборыСчетСубконто(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	ПриИзмененииРеквизита();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПриИзмененииРеквизита();
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	ПриИзмененииРеквизита();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриИзмененииРеквизита()
	ПодготовитьФормуНаСервере(ЭтотОбъект);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодготовитьФормуНаСервере(Форма)
	
	Запись = Форма.Запись;
	
	ПланСчетовБД = МСФОВызовСервераУХ.ЗначениеУП("ПланСчетовУчета",
		Запись.Организация, Запись.ПериодОтчета.ДатаОкончания, Запись.Сценарий);
	
	Форма.КэшируемыеЗначения = Новый Структура;
	Форма.КэшируемыеЗначения.Вставить("ИменаСубконто",		РегистрыСведений.ДатыДляИндексовЦенМСФО.ПолучитьИменаСубконто());
	Форма.КэшируемыеЗначения.Вставить("КлючевыеСубконто",	МСФОВНАУХ.ПолучитьКлючевыеСубконтоВНА());
	Форма.КэшируемыеЗначения.Вставить("ПланСчетовБД",		ПланСчетовБД);
	
	ОбновитьОтборыСчетСубконто(Форма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтборыСчетСубконто(Форма)
	
	ПараметрыВыбора = ПараметрыВыбораСчета(Форма.КэшируемыеЗначения.ПланСчетовБД);
	
	Для каждого ИмяСчета Из Форма.КэшируемыеЗначения.ИменаСубконто Цикл
		Форма.Элементы[ИмяСчета.Ключ].ПараметрыВыбора = ПараметрыВыбора;
		МСФОКлиентСерверУХ.ОбновитьСубконтоСчета(Форма, ИмяСчета.Ключ, Форма.Запись);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыВыбораСчета(УчетнаяПолитикаМСФО)

	Если Не ЗначениеЗаполнено(УчетнаяПолитикаМСФО) Тогда
		Возврат Новый ФиксированныйМассив(Новый Массив);
	ИначеЕсли ТипЗнч(УчетнаяПолитикаМСФО) = Тип("ДокументСсылка.УчетнаяПолитикаМСФО") Тогда
		Возврат МСФОУХ.ПолучитьПараметрыВыбораСчетаБД(УчетнаяПолитикаМСФО.ПланСчетовУчета, Ложь);
	Иначе //плансчетов вместо УП
		Возврат МСФОУХ.ПолучитьПараметрыВыбораСчетаБД(УчетнаяПолитикаМСФО, Ложь);
	КонецЕсли;

КонецФункции

#КонецОбласти
