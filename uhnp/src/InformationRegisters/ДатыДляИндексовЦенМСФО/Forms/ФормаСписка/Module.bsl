
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление()
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПланСчетовБД = ОбщегоНазначенияУХ.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Счет, "ПланСчетовБД");
	
	ИмяТЧ = "РегистрСведений.ДатыДляИндексовЦенМСФО";
	ПериодОтчета = ТекущаяСтрока.ПериодОтчета;
	
	ДопПараметры = Новый Структура("ИмяОбъекта, ИмяТЧ, ИсточникКолонок",
									ИмяТЧ, ИмяТЧ, "НЗ");

	Отбор = Новый Структура("ПериодОтчета, Организация, Сценарий");
	ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);
	
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДопПараметры);
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ОписаниеКоманды",	ОписаниеКоманды);
	ПараметрыЗагрузки.Вставить("Форма",				ЭтотОбъект);
	ПараметрыЗагрузки.Вставить("Объект",			ПериодОтчета);
	ПараметрыЗагрузки.Вставить("Отбор",				Отбор);
	ПараметрыЗагрузки.Вставить("ОтборыТипов",		ВстраиваниеУХКлиентСервер.ПустыеОтборыТипов());
	ПараметрыЗагрузки.Вставить("ПропуститьПроверкуЗагрузки",	Истина);
	ПараметрыЗагрузки.Вставить("ПланСчетовБД",	ПланСчетовБД);
	
	МСФОКлиентУХ.ЗагрузкаДанных_Подключаемый(ПериодОтчета, ПараметрыЗагрузки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	МСФОУХ.УсловноеОформление_Субконто(ЭтотОбъект, "Список", "Список", "МСФО", "");

КонецПроцедуры

#КонецОбласти

