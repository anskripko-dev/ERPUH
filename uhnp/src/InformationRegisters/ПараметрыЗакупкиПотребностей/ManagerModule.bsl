#Область ПрограммныйИнтерфейс
	
Процедура РассчитатьПараметрыЗакупкиПоПользователю(Пользователь, ПериодЗакупки) экспорт
	
	Если НЕ ЗначениеЗаполнено(ПериодЗакупки) ИЛИ НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	
	//
	ТаблицаДанных = ПолучитьТаблицуПотребностейДляПользователя(Пользователь, ПериодЗакупки);
	Если ТаблицаДанных.Количество() = 0 Тогда
		ОчиститьРезультатыРасчетаПараметровЗакупкиПользователя(Пользователь, ПериодЗакупки);
	Иначе
		ЗаполнитьПараметрыЗакупкиПользователя(Пользователь, ПериодЗакупки, ТаблицаДанных);
		
		ПотребностиУХ.ВыполнитьКлючеваниеКоллекцииПотребностей(ТаблицаДанных);
		
		ЗаписатьПараметрыЗакупкиПроектовСПЗПользователя(Пользователь, ПериодЗакупки, ТаблицаДанных);
		
		//// NT
		//СформироватьТаблицуКлючейПараметровЗакупки(Пользователь, ПериодЗакупки, ТаблицаДанных);
		//
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ФормированиеПотребностей

Функция ПолучитьТаблицуПотребностейДляПользователя(Пользователь, ПериодЗакупки)
	
	// Формиру
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Пользователь);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ПустойУИД", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.Текст = ТекстЗапроса_ДанныеПотребностейПользователя()
		+ ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета()
		+ "ВЫБРАТЬ РАЗЛИЧНЫЕ
		  |	ВТ_Данные.НомерСтроки КАК НомерСтроки,
		  |	ВТ_Данные.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		  |	ВТ_Данные.Организация КАК Организация,
		  |	ВТ_Данные.Номенклатура КАК Номенклатура,
		  |	ВТ_Данные.Характеристика КАК Характеристика,
		  |	ВЫБОР
		  |		КОГДА ВТ_Данные.Номенклатура ССЫЛКА Справочник.Номенклатура
		  |			ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Номенклатура КАК Справочник.Номенклатура).ТоварнаяКатегория
		  |		КОГДА ВТ_Данные.Номенклатура ССЫЛКА Справочник.ТоварныеКатегории
		  |			ТОГДА ВЫРАЗИТЬ(ВТ_Данные.Номенклатура КАК Справочник.ТоварныеКатегории)
		  |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
		  |	КОНЕЦ КАК ТоварнаяКатегория,
		  |	ВТ_Данные.Номенклатура.КодОКПД2 КАК ОКПД2,
		  |	ВТ_Данные.МестоПоставки КАК МестоПоставки,
		  |	ВТ_Данные.Приоритет КАК Приоритет,
		  |	ВТ_Данные.Проект КАК Проект,
		  |	ВТ_Данные.Менеджер КАК Менеджер,
		  |	ВТ_Данные.Назначение КАК Назначение,
		  |	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка) КАК АналитикаНоменклатуры,
		  |	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка) КАК АналитикаПотребностей,
		  |	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка) КАК АналитикаСтруктуры
		  |ИЗ
		  |	ВТ_ДанныеПотребности КАК ВТ_Данные";
		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТекстЗапроса_ДанныеПотребностейПользователя() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПотребностиПараметрыДоступа.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	Организации.Ссылка КАК Организация
	|ПОМЕСТИТЬ ВТ_Организации
	|ИЗ
	|	РегистрСведений.ПотребностиПараметрыДоступа КАК ПотребностиПараметрыДоступа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (ПотребностиПараметрыДоступа.Автор = &Автор)
	|			И ПотребностиПараметрыДоступа.ОрганизацияЗаказчик = Организации.ГоловнаяОрганизация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.Ссылка КАК Период
	|ПОМЕСТИТЬ ВТ_ПериодыПотребности
	|ИЗ
	|	Справочник.Периоды КАК ПериодЗакупки,
	|	Константа.ПериодичностьЦентрализованныхЗакупок КАК ПериодичностьЦентрализованныхЗакупок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
	|		ПО ПериодичностьЦентрализованныхЗакупок.Значение = Периоды.Периодичность
	|			И (Периоды.Произвольный = ЛОЖЬ)
	|ГДЕ
	|	ПериодЗакупки.Ссылка = &ПериодЗакупки
	|	И Периоды.ДатаНачала МЕЖДУ ПериодЗакупки.ДатаНачала И ПериодЗакупки.ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация.ГоловнаяОрганизация КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация КАК Организация,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.Характеристика КАК Характеристика,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.МестоПоставки КАК МестоПоставки,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Приоритет КАК Приоритет,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Проект КАК Проект,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Менеджер КАК Менеджер,
	|	NULL КАК Назначение
	|ПОМЕСТИТЬ ВТ_РаботаСПотребностями
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация В
	|			(ВЫБРАТЬ
	|				ВТ_Организации.Организация КАК Организация
	|			ИЗ
	|				ВТ_Организации КАК ВТ_Организации)
	|	И ПроектыСПЗПозиции.ПериодПотребности В
	|			(ВЫБРАТЬ
	|				ВТ_ПериодыПотребности.Период КАК Период
	|			ИЗ
	|				ВТ_ПериодыПотребности КАК ВТ_ПериодыПотребности)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.ЕдиницаИзмерения,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Проект,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Менеджер,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Приоритет,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Назначение,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.МестоПоставки,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры.Характеристика,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация.ГоловнаяОрганизация
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация.ГоловнаяОрганизация,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.МестоПоставки,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Приоритет,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Проект,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Менеджер,
	|	NULL
	|ИЗ
	|	РегистрНакопления.ПланированиеПотребностей.Остатки(, АналитикаПланирования.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ЗаявкиСогласованные)) КАК ПланированиеПотребностейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация.ГоловнаяОрганизация,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Номенклатура,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Проект,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.Характеристика,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаНоменклатуры.ЕдиницаИзмерения,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаСтруктуры.Организация,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.МестоПоставки,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Приоритет,
	|	ПланированиеПотребностейОстатки.АналитикаПланирования.АналитикаПотребностей.Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	Запрос.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	Запрос.Организация КАК Организация,
	|	Запрос.Номенклатура КАК Номенклатура,
	|	Запрос.Характеристика КАК Характеристика,
	|	Запрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Запрос.МестоПоставки КАК МестоПоставки,
	|	1 КАК Коэффициент,
	|	Запрос.Приоритет КАК Приоритет,
	|	Запрос.Проект КАК Проект,
	|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ЦФО,
	|	Запрос.Менеджер КАК Менеджер,
	|	Запрос.Назначение КАК Назначение
	|ПОМЕСТИТЬ ВТ_ДанныеПотребности
	|ИЗ
	|	ВТ_РаботаСПотребностями КАК Запрос";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти 

#Область РаботаСДанными

Процедура ЗаписатьПараметрыЗакупкиПроектовСПЗПользователя(Автор, ПериодЗакупки, ТаблицаПотребности)
	
	нз = РегистрыСведений.ПараметрыЗакупкиПотребностей.СоздатьНаборЗаписей();
	нз.Отбор.Автор.Установить(Автор);
	нз.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	
	Для Каждого СтрокаПотребности Из ТаблицаПотребности Цикл
		
		Для Каждого КлючЗначение Из СтрокаПотребности.Результат Цикл
			
			дв = нз.Добавить();
			ЗаполнитьЗначенияСвойств(дв, СтрокаПотребности);
			ЗаполнитьЗначенияСвойств(дв, КлючЗначение.Значение);
			дв.Свойство = КлючЗначение.Ключ;
			
			дв.Автор = Автор;
			дв.ПериодЗакупки = ПериодЗакупки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	нз.Записать(Истина);
	
КонецПроцедуры

Процедура ОчиститьРезультатыРасчетаПараметровЗакупкиПользователя(Автор, ПериодЗакупки)
	
	НаборЗаписей = РегистрыСведений.ПараметрыЗакупкиПотребностей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Автор.Установить(Автор);
	НаборЗаписей.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаПотребностейПоПоложениюОЗакупках

Процедура ЗаполнитьПараметрыЗакупкиПользователя(Пользователь, ПериодЗакупки, ТаблицаПотребности)
	
	Если ТаблицаПотребности.Колонки.Найти("ПоложениеОЗакупках") = неопределено Тогда
		ТаблицаПотребности.Колонки.Добавить("ПоложениеОЗакупках", Новый ОписаниеТипов("СправочникСсылка.ПоложениеОЗакупках"));
	КонецЕсли;
	
	Если ТаблицаПотребности.Колонки.Найти("УИДУсловия") = неопределено Тогда
		ТаблицаПотребности.Колонки.Добавить("УИДУсловия", Новый ОписаниеТипов("УникальныйИдентификатор"));
	КонецЕсли;
	
	//
	ТМП = ТаблицаПотребности.Скопировать(, "ОрганизацияЗаказчик, Организация");
	ТМП.Свернуть("ОрганизацияЗаказчик, Организация", "");
	
	Для Каждого Строка Из ТМП Цикл
		ЗаполнитьПараметрыЗакупкиПоДействующимПоложениям(ПериодЗакупки, Строка.ОрганизацияЗаказчик, Строка.Организация, ТаблицаПотребности);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЗакупкиПоДействующимПоложениям(ПериодЗакупки, ОрганизацияЗаказчик, Организация, ТаблицаПотребности)
	
	ДобавитьКолонкуРезультат(ТаблицаПотребности, Новый ОписаниеТипов("Соответствие"));
	
	ПоложенияОЗакупках = ПолучитьДействующиеПоложенияОЗакупках(ОрганизацияЗаказчик, Организация, ПериодЗакупки);
	
	СтруктураПоиска = Новый Структура("ОрганизацияЗаказчик, Организация", ОрганизацияЗаказчик, Организация);
	СтрокиПотребностей = ТаблицаПотребности.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаПотребности Из СтрокиПотребностей Цикл
		
		ПараметрыОпределены = Ложь;
		Для Каждого ДанныеПоложения Из ПоложенияОЗакупках Цикл
			
			Результат = ОпределитьПараметрыЗакупкиДляСтрокиПотребности(ДанныеПоложения, СтрокаПотребности);
			Если Результат.Данные.Количество() > 0 Тогда
				СтрокаПотребности.Результат = Результат.Данные;
				СтрокаПотребности.ПоложениеОЗакупках = Результат.Позиция.ПоложениеОЗакупках;
				СтрокаПотребности.УИДУсловия = Результат.Позиция.УИДУсловия;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКолонкуРезультат(ТаблицаПотребности, ОписаниеТипаКолонкиРезультат)
	
	Если ТаблицаПотребности.Колонки.Найти("Результат") <> неопределено 
		И ТаблицаПотребности.Колонки.Результат.ТипЗначения <> ОписаниеТипаКолонкиРезультат Тогда
		ТаблицаПотребности.Колонки.Удалить("Результат");
	КонецЕсли;
	
	Если ТаблицаПотребности.Колонки.Найти("Результат") = неопределено Тогда
		ТаблицаПотребности.Колонки.Добавить("Результат", ОписаниеТипаКолонкиРезультат);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДействующиеПоложенияОЗакупках(ОрганизацияЗаказчик, Организация, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДействиеПоложенийОЗакупках.Положение КАК Положение,
	|	ДействиеПоложенийОЗакупках.Организация КАК Организация,
	|	ДействиеПоложенийОЗакупках.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ ВТ_ПоложенияЭтогоФилиала
	|ИЗ
	|	РегистрСведений.ДействиеПоложенийОЗакупках КАК ДействиеПоложенийОЗакупках
	|ГДЕ
	|	ДействиеПоложенийОЗакупках.Организация = &Организация
	|	И ДействиеПоложенийОЗакупках.ПериодЗакупок = &ПериодЗакупок
	|	И ДействиеПоложенийОЗакупках.Положение <> ЗНАЧЕНИЕ(Справочник.ПоложениеОЗакупках.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоложенияЭтогоФилиала.Положение КАК Положение,
	|	1 КАК Приоритет1,
	|	ВТ_ПоложенияЭтогоФилиала.Приоритет КАК Приоритет2
	|ИЗ
	|	ВТ_ПоложенияЭтогоФилиала КАК ВТ_ПоложенияЭтогоФилиала
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДействиеПоложенийОЗакупках.Положение,
	|	2,
	|	ДействиеПоложенийОЗакупках.Приоритет
	|ИЗ
	|	РегистрСведений.ДействиеПоложенийОЗакупках КАК ДействиеПоложенийОЗакупках
	|ГДЕ
	//|	&ОрганизацияЗаказчик <> &Организация
//	|	И 
	|	ДействиеПоложенийОЗакупках.Организация = &ОрганизацияЗаказчик
	|	И ДействиеПоложенийОЗакупках.ПериодЗакупок = &ПериодЗакупок
	|	И ДействиеПоложенийОЗакупках.Положение <> ЗНАЧЕНИЕ(Справочник.ПоложениеОЗакупках.ПустаяСсылка)
	|	И НЕ ДействиеПоложенийОЗакупках.Положение В
	|				(ВЫБРАТЬ
	|					ВТ_ПоложенияЭтогоФилиала.Положение КАК Положение
	|				ИЗ
	|					ВТ_ПоложенияЭтогоФилиала КАК ВТ_ПоложенияЭтогоФилиала)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет1,
	|	Приоритет2";
	Запрос.УстановитьПараметр("ОрганизацияЗаказчик", ОрганизацияЗаказчик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодЗакупок", Период);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДействующиеПоложения = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		ДействующиеПоложения.Добавить(ПолучитьДанныеПоложения(Строка.Положение, ОрганизацияЗаказчик));
	КонецЦикла;
	
	Возврат ДействующиеПоложения;
	
КонецФункции

Функция ПолучитьДанныеПоложения(Положение, ОрганизацияЗаказчик)
	
	ДанныеПоложения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Положение, "ХранилищеДереваУсловий, ПараметрыЗакупки");
	
	УсловияЗакупки = ДанныеПоложения.ХранилищеДереваУсловий.Получить();
	ПараметрыЗакупки = ДанныеПоложения.ПараметрыЗакупки.Выгрузить();
	МатрицаРеквизитов = МатрицаИменРеквизитов();
	
	//
	СписокИД = ПараметрыЗакупки.Скопировать(, "ИД");
	СписокИД.Свернуть("ИД", "");
	
	ПараметрыЗакупкиПреобразованные = Новый Соответствие;
	Для Каждого СтрокаИД Из СписокИД Цикл
		
		Строки = ПараметрыЗакупки.НайтиСтроки(Новый Структура("ИД", СтрокаИД.ИД));
		
		Параметры = Новый Структура;
		Параметры2 = Новый Соответствие;
		
		Для Каждого Строка Из Строки Цикл
			
			Если НЕ Строка.Использовать Тогда
				Продолжить;
			КонецЕсли;
			
			Параметры.Вставить(МатрицаРеквизитов[Строка.Свойство], Строка.Значение);
			Параметры2.Вставить(Строка.Свойство, Новый Структура("Значение, ЗапретИзменения", Строка.Значение, Строка.ЗапретИзменения));
			
		КонецЦикла;
		
		ПараметрыЗакупкиПреобразованные.Вставить(СтрокаИД.ИД, Параметры2);
		
	КонецЦикла;
	
	// Стартовые параметры закупки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЗакупки.Ссылка КАК Ссылка,
	|	ПараметрыЗакупки.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.ПараметрыЗакупки КАК ПараметрыЗакупки
	|ГДЕ
	|	ПараметрыЗакупки.ЭтоГруппа = ЛОЖЬ";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СтартовыеЗначения = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		СтартовыеЗначения.Вставить(Выборка.Ссылка, Новый Структура("Значение, ЗапретИзменения", Выборка.ТипЗначения.ПривестиЗначение(неопределено), Ложь));
	КонецЦикла;
	
	Результат = Новый Структура("Положение, ОрганизацияЗаказчик", Положение, ОрганизацияЗаказчик);
	Результат.Вставить("УсловияЗакупки", УсловияЗакупки);
	Результат.Вставить("ПараметрыЗакупки", ПараметрыЗакупкиПреобразованные);
	Результат.Вставить("СтартовыеЗначения", СтартовыеЗначения);
	
	Возврат Результат;
			
КонецФункции

Функция ОпределитьПараметрыЗакупкиДляСтрокиПотребности(Знач ДанныеПоложения, СтрокаПотребности)
	
	Данные = Новый Соответствие;
	
	Данные = Новый Соответствие(Новый ФиксированноеСоответствие(ДанныеПоложения.СтартовыеЗначения));
	Позиция = Новый Структура("ПоложениеОЗакупках, УИДУсловия", ДанныеПоложения.Положение);
	
	ВыполнитьПоискПоДереву(СтрокаПотребности, ДанныеПоложения.УсловияЗакупки.Строки[0], ДанныеПоложения.ПараметрыЗакупки, Данные, Позиция);
	
	СтруктураОрганизатор = Данные[ПланыВидовХарактеристик.ПараметрыЗакупки.Организатор];
	Если ТипЗнч(СтруктураОрганизатор) = Тип("Структура")
	//	И НЕ ЗначениеЗаполнено(СтруктураОрганизатор.Значение)
		Тогда
		СтруктураОрганизатор.Значение = ДанныеПоложения.ОрганизацияЗаказчик;
	КонецЕсли;
	
	Возврат Новый Структура("Данные, Позиция", Данные, Позиция);
	
КонецФункции

Функция ВыполнитьПоискПоДереву(Знач СтрокаПотребности, Знач ДеревоУсловий, Знач ПараметрыЗакупки, Результат, Позиция)
	
	// Сохраняем уид условия
	Позиция.УИДУсловия = ДеревоУсловий.ИД;
	
	// Записать результат
	Параметры = ПараметрыЗакупки[ДеревоУсловий.ИД];
	Если Параметры <> неопределено Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Строка Из ДеревоУсловий.Строки Цикл
	
		Если ПроверитьУсловие(Строка, СтрокаПотребности) Тогда
			ВыполнитьПоискПоДереву(СтрокаПотребности, Строка, ПараметрыЗакупки, Результат, Позиция);
		КонецЕсли;
	
	КонецЦикла;
	
КонецФункции

Функция ПроверитьУсловие(Условие, СтрокаПотребности)
	
	Результат = Ложь;
	
	ПВХ = ПланыВидовХарактеристик.РеквизитыЗакупки;
	
	ЗначениеПотребности = неопределено;
	Если Условие.Реквизит = ПВХ.Номенклатура Тогда
		ЗначениеПотребности = СтрокаПотребности.Номенклатура;
	ИначеЕсли Условие.Реквизит = ПВХ.МестоПоставки Тогда
		ЗначениеПотребности = СтрокаПотребности.МестоПоставки;
	ИначеЕсли Условие.Реквизит = ПВХ.ТоварнаяКатегория Тогда
		ЗначениеПотребности = СтрокаПотребности.ТоварнаяКатегория;
	ИначеЕсли Условие.Реквизит = ПВХ.ОКПД2 Тогда
		ЗначениеПотребности = СтрокаПотребности.ОКПД2;
	ИначеЕсли Условие.Реквизит = ПВХ.Организация Тогда
		ЗначениеПотребности = СтрокаПотребности.Организация;
	ИначеЕсли Условие.Реквизит = ПВХ.Менеджер Тогда
		ЗначениеПотребности = СтрокаПотребности.Менеджер;
	ИначеЕсли Условие.Реквизит = ПВХ.Назначение Тогда
		ЗначениеПотребности = СтрокаПотребности.Назначение;
	ИначеЕсли Условие.Реквизит = ПВХ.Приоритет Тогда
		ЗначениеПотребности = СтрокаПотребности.Приоритет;
	ИначеЕсли Условие.Реквизит = ПВХ.Проект Тогда
		ЗначениеПотребности = СтрокаПотребности.Проект;
	//ИначеЕсли Условие.Реквизит = ПВХ. Тогда
	//	ЗначениеПотребности = СтрокаПотребности.;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
		Результат = ЗначениеПотребности = Условие.Значение;
	ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Результат = ЗначениеПотребности <> Условие.Значение;
	ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
		Результат = ЗначениеЗаполнено(ЗначениеПотребности);
	ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Результат = НЕ ЗначениеЗаполнено(ЗначениеПотребности);
	ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Если ТипЗнч(Условие.Значение) <> Тип("СписокЗначений") Тогда
			Возврат Ложь;
		КонецЕсли;
		Результат = Условие.Значение.НайтиПоЗначению(ЗначениеПотребности) <> неопределено;
	ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Если ТипЗнч(Условие.Значение) <> Тип("СписокЗначений") Тогда
			Возврат Ложь;
		КонецЕсли;
		Результат = Условие.Значение.НайтиПоЗначению(ЗначениеПотребности) = неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МатрицаИменРеквизитов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЗакупки.Ссылка КАК Ссылка,
	|	ПараметрыЗакупки.ИмяПредопределенныхДанных КАК ИмяРеквизита
	|ИЗ
	|	ПланВидовХарактеристик.ПараметрыЗакупки КАК ПараметрыЗакупки
	|ГДЕ
	|	ПараметрыЗакупки.ЭтоГруппа = ЛОЖЬ";
	Результат = Запрос.Выполнить().Выгрузить();
	
	Матрица = Новый Соответствие;
	
	Для Каждого Строка Из Результат Цикл
		Матрица.Вставить(Строка.Ссылка, Строка.ИмяРеквизита);
	КонецЦикла;
	
	Возврат Матрица;
	
КонецФункции

