Процедура ОтразитьСведенияОВозвратахТоваровПоставщику(ДополнительныеСвойства, Движения, Отказ) Экспорт
		
	ТаблицаДвижений = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаТН_СведенияОВозвратахТоваровПоставщикам;
	Если Отказ ИЛИ ТаблицаДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияСведенияОВозвратах = Движения.тн_СведенияОВозвратахТоваровПоставщикам;
	ДвиженияСведенияОВозвратах.Записывать = Истина;
	ДвиженияСведенияОВозвратах.Загрузить(ТаблицаДвижений);
	
КонецПроцедуры

//Шабалкина Е.В. 22.12.2021 Выполнение задач №000039896
// Возвращает тексты запросов для сторнирования движений при исправлении документов
// 
// Параметры:
// 	МетаданныеДокумента - ОбъектМетаданныхДокумент - Метаданные документа, который проводится.
// 
// Возвращаемое значение:
// 	Соответствие - Соответствие полного имени регистра тексту запроса сторнирования
//
Функция ТекстыЗапросовСторнирования(МетаданныеДокумента) Экспорт
	
	ДвиженияДокумента = МетаданныеДокумента.Движения;
	
	ТекстыЗапросов = Новый Соответствие();
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.тн_СведенияОВозвратахТоваровПоставщикам;
	
	Если ДвиженияДокумента.Содержит(МетаданныеРегистра) Тогда
		ТекстыЗапросов.Вставить(МетаданныеРегистра.ПолноеИмя(),
			ПроведениеДокументов.ТекстСторнирующегоЗапроса(
				МетаданныеРегистра,
				МетаданныеДокумента,
				));
	КонецЕсли;
	
	Возврат ТекстыЗапросов;
	
КонецФункции

