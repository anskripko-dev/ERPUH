#Область СлужебныйПрограммныйИнтерфейс

// Функция возвращает информацию о ключе
Функция ИнформацияОКлюче() Экспорт

	//
	Результат = Новый Структура;
	Результат.Вставить("СправочникИмя", "КлючиАналитикиПланированияНоменклатуры");
	Результат.Вставить("СправочникМенеджер", Справочники.КлючиАналитикиПланированияНоменклатуры);
	Результат.Вставить("СправочникМетаданные", Метаданные.Справочники.КлючиАналитикиПланированияНоменклатуры);
	Результат.Вставить("РегистрИмя", "АналитикаПланированияНоменклатуры");
	Результат.Вставить("РегистрМенеджер", РегистрыСведений.АналитикаПланированияНоменклатуры);
	Результат.Вставить("РегистрМетаданные", Метаданные.РегистрыСведений.АналитикаПланированияНоменклатуры);
	
	Результат.Вставить("ИмяПоляАналитика", "АналитикаПланированияНоменклатуры");
	
	КонтрольУХКлючи.ДобавитьИзмеренияКлюча(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи) Экспорт
	
	Поля = Новый Массив;
	Поля.Добавить(СокрЛП(МенеджерЗаписи.Номенклатура));
	Если ЗначениеЗаполнено(МенеджерЗаписи.Характеристика) Тогда
		Поля.Добавить(СокрЛП(МенеджерЗаписи.Характеристика));
	КонецЕсли;
	Если ЗначениеЗаполнено(МенеджерЗаписи.ЕдиницаИзмерения) Тогда
		Поля.Добавить(СокрЛП(МенеджерЗаписи.ЕдиницаИзмерения));
	КонецЕсли;
	Если ЗначениеЗаполнено(МенеджерЗаписи.Коэффициент) Тогда
		Поля.Добавить(СокрЛП(МенеджерЗаписи.Коэффициент));
	КонецЕсли;
	Если ЗначениеЗаполнено(МенеджерЗаписи.ИсходнаяНоменклатура) Тогда
		Поля.Добавить(СокрЛП(МенеджерЗаписи.ИсходнаяНоменклатура));
	КонецЕсли;
	
	Возврат СтрСоединить(Поля, "; ");
	
КонецФункции

// Функция получает элемент справочника - ключ аналитики учета потребностей.
//
// Параметры:
//	ПараметрыАналитики     - Выборка, Структура - Содержит полями "Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура":
//		* Номенклатура     - СправочникСсылка.Номенклатура, СправочникСсылка.ТоварныеКатегории
//		* Характеристика   - СправочникСсылка.ХарактеристикиНоменклатуры
//		* ЕдиницаИзмерения - ОпределяемыйТип.ЕдиницаИзмерения
//		* Коэффициент      - ОпределяемыйТип.КоэффициентЕдиницыИзмеренияУХ
//		* ИсходнаяНоменклатура - СправочникСсылка.АналитикаПланированияНоменклатуры
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияНоменклатуры - Созданный элемент справочника.
//
Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

	НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0
			И Не ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			Результат = НаборЗаписей[0].КлючАналитики;
		Иначе
			Результат = СоздатьКлючАналитики(ПараметрыАналитики);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

КонецФункции

// Функция получает элемент справочника - ключ аналитики учета.
//
// Параметры:
//	ПараметрыАналитики - Выборка или Структура  с полями "Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура".
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиАналитикиПланированияНоменклатуры - Созданный элемент справочника.
//
Функция СоздатьКлючАналитики(ПараметрыАналитики, ЗаписьПриОбновленииИБ = Ложь) Экспорт
	
	Возврат КонтрольУХКлючи.СоздатьКлючАналитики(ИнформацияОКлюче(), ПараметрыАналитики);
	
КонецФункции

// Заполняет поле АналитикаПланированияНоменклатуры в коллекции, содержащей номенклатуру, характеристику, ед.изм и коэффициент.
// Места учета и имена полей для мест учета трактуются следующим образом:
//	для ключей, кроме Произвольный:
//		если имя поля указано (есть ключ в структуре) и значение заполнено, то выбирать данные из этого поля коллекции;
//		если имя поля указано, но значение не заполнено ("" или Неопределено), то данные всегда устанавливать из мест учета;
//		если имя поля не указано, то смотрится заполнение ключа Произвольный;
//	для ключа Произвольный:
//		если значение имени поля заполнено, то все типы номенклатуры, которые не упомянуты в других ключах, выбирают
//		данные из этого поля коллекции, если в поле коллекции значение не задано, то данные устанавливаются из мест учета;
//		если значение поля не заполнено, то данные всегда устанавливаются из мест учета;
//
// Параметры:
//
//	Коллекция - ТабличнаяЧасть - Коллекция, в которой производится заполнение аналитики учета потребностей.
//
//	ИменаПолей - Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля берется из имени ключа.
//		секция идентификации {Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура, АналитикаПланированияНоменклатуры},
//	
//	ПараметрыЗаполнения - Структура - см. метод КонтрольУХКлючи.ПараметрыЗаполненияКлючейАналитики()
//
// Пример 1:
//	ИменаПолей = РегистрыСведений.АналитикаПланированияНоменклатуры.ИменаПолейКоллекцииПоУмолчанию();
//	РегистрыСведений.АналитикаПланированияНоменклатуры.ЗаполнитьВКоллекции(ДвиженияОперации, ИменаПолей);
//
// Пример 2:
//	РегистрыСведений.АналитикаПланированияНоменклатуры.ЗаполнитьВКоллекции(ДвиженияОперации);
//
Процедура ЗаполнитьВКоллекции(Коллекция, 
								ИменаПолей = Неопределено, ДополнитьКлюч = Ложь, ПараметрыЗаполнения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = КонтрольУХКлючи.ПараметрыЗаполненияКлючейАналитики();
	КонецЕсли;
	
	Если ДополнитьКлюч Тогда
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейДополненияКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
	Иначе
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.АналитикаПланированияНоменклатуры) Тогда
			Если ПараметрыЗаполнения.СоздаватьВКлючи Тогда
				КлючАналитики = ЗначениеКлючаАналитики(Выборка);
			Иначе
				ТекстИсключения = НСтр("ru = 'Ошибка при заполнении ключей в коллекции: есть аналитики, по которым ключи еще не созданы.'");
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.КлючиАналитикиПланированияНоменклатуры,
					,
					ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		Иначе
			КлючАналитики = Выборка.АналитикаПланированияНоменклатуры;
		КонецЕсли;
		
		ПараметрыЗаполнения.ИзмененаАналитика = Истина;
		Если НЕ ПараметрыЗаполнения.ЗаполнятьКлючВКоллекции Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнитьКлюч Тогда
			Коллекция[Выборка.Индекс][ИменаПолей.ЗаполняемаяАналитикаПланированияНоменклатуры] = КлючАналитики;
		Иначе
			Коллекция[Выборка.Индекс][ИменаПолей.АналитикаПланированияНоменклатуры] = КлючАналитики;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики учета потребностей.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля должно браться из имени ключа.
//		секция идентификации {Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура, АналитикаПланированияНоменклатуры},
//			все ключи заданы.
//
Функция ИменаПолейКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Номенклатура",					"Номенклатура");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		ИменаПолей.Вставить("Характеристика",				"Характеристика");
	Иначе
		ИменаПолей.Вставить("Характеристика",				""); // не используется
	КонецЕсли;
	ИменаПолей.Вставить("ЕдиницаИзмерения",				"ЕдиницаИзмерения");
	ИменаПолей.Вставить("Коэффициент",					"Коэффициент");
	ИменаПолей.Вставить("ИсходнаяНоменклатура",			"ИсходнаяНоменклатура");
	ИменаПолей.Вставить("АналитикаПланированияНоменклатуры",	"АналитикаНоменклатуры");
	
	Возврат ИменаПолей;
КонецФункции

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики учета номенклатуры.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//
Функция ИменаПолейДополненияКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("АналитикаПланированияНоменклатуры", "АналитикаПланированияНоменклатуры");
	ИменаПолей.Вставить("ЗаполняемаяАналитикаПланированияНоменклатуры", "АналитикаПланированияНоменклатуры");
	ИменаПолей.Вставить("Номенклатура", "");
	ИменаПолей.Вставить("Характеристика", "");
	ИменаПолей.Вставить("ЕдиницаИзмерения", "");
	ИменаПолей.Вставить("Коэффициент", "");
	ИменаПолей.Вставить("ИсходнаяНоменклатура", "");
	
	Возврат ИменаПолей;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	СтруктураАналитики = Новый Структура("Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура");
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики);
	Если НЕ ЗначениеЗаполнено(СтруктураАналитики.Номенклатура) Тогда
		Возврат Неопределено
	Иначе
		НаборЗаписей = РегистрыСведений.АналитикаПланированияНоменклатуры.СоздатьНаборЗаписей();
		
		Для Каждого КлючЗначение Из СтруктураАналитики Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, "Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, ИсходнаяНоменклатура");
		ПроверитьЗаполнениеПоляНоменклатура(НоваяСтрока);
		Возврат НаборЗаписей;
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьЗаполнениеПоляНоменклатура(МенеджерЗаписиАналитикаПланированияНоменклатуры)

	Если МенеджерЗаписиАналитикаПланированияНоменклатуры.Номенклатура = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Ошибочное значение параметра ""Номенклатура""'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки - 1 КАК Индекс,
	|	&ПолеАналитикаУчета КАК АналитикаПланированияНоменклатуры,
	|	&ПолеНоменклатура КАК Номенклатура,
	|	&ПолеХарактеристика КАК Характеристика,
	|	&ПолеЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ПолеКоэффициент КАК Коэффициент,
	|	&ПолеИсходнаяНоменклатура КАК ИсходнаяНоменклатура
	|
	|ПОМЕСТИТЬ Коллекция
	|ИЗ &Коллекция КАК Коллекция;
	|
	|ВЫБРАТЬ
	|	Коллекция.Индекс,
	|	Аналитика.КлючАналитики КАК АналитикаПланированияНоменклатуры,
	|	Коллекция.Номенклатура,
	|	Коллекция.Характеристика,
	|	Коллекция.ЕдиницаИзмерения,
	|	Коллекция.Коэффициент,
	|	Коллекция.ИсходнаяНоменклатура
	|ИЗ
	|	Коллекция КАК Коллекция
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК Аналитика
	|		ПО Аналитика.Номенклатура = Коллекция.Номенклатура
	|		И Аналитика.Характеристика = Коллекция.Характеристика
	|		И Аналитика.ЕдиницаИзмерения = Коллекция.ЕдиницаИзмерения
	|		И Аналитика.Коэффициент = Коллекция.Коэффициент
	|		И Аналитика.ИсходнаяНоменклатура = Коллекция.ИсходнаяНоменклатура
	|ГДЕ
	|	Аналитика.КлючАналитики ЕСТЬ NULL
	|	ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаПланированияНоменклатуры
	|	ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)
	|";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаУчета", 	"Коллекция." + ИменаПолей.АналитикаПланированияНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатура", 		"Коллекция." + ИменаПолей.Номенклатура);
	
	// Поле Характеристика может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.Характеристика) Тогда
		Если ТипЗнч(ИменаПолей.Характеристика) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеХарактеристика", ИменаПолей.Характеристика.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеХарактеристика", "Коллекция." + ИменаПолей.Характеристика);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеХарактеристика", "ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)");
	КонецЕсли; 
	
	// Поле ЕдиницаИзмерения может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.ЕдиницаИзмерения) Тогда
		Если ТипЗнч(ИменаПолей.ЕдиницаИзмерения) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЕдиницаИзмерения", ИменаПолей.ЕдиницаИзмерения.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЕдиницаИзмерения", "Коллекция." + ИменаПолей.ЕдиницаИзмерения);
		КонецЕсли;  
	Иначе
		// Если ЕдиницаИзмерения не указана, то берем ее из Номенклатуры и коэффициент ставим = 1.
		Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
			ПустаяЕИ = "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)";
		Иначе
			ПустаяЕИ = "ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)";
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЕдиницаИзмерения", ПустаяЕИ);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Аналитика.ЕдиницаИзмерения = Коллекция.ЕдиницаИзмерения", "И Аналитика.ЕдиницаИзмерения = Коллекция.Номенклатура.ЕдиницаИзмерения");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Коллекция.ЕдиницаИзмерения", "Коллекция.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКоэффициент", "1"); // Считаем, что коэффициент в базовой ЕИ = 1
	КонецЕсли; 
	
	// Поля Коэффициент и ЕдиницаИзмерения могут отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.Коэффициент) Тогда
		Если ТипЗнч(ИменаПолей.Коэффициент) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКоэффициент", ИменаПолей.Коэффициент.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКоэффициент", "Коллекция." + ИменаПолей.Коэффициент);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКоэффициент", "1");
	КонецЕсли; 
	
	// Поле ИсходнаяНоменклатура может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.ИсходнаяНоменклатура) Тогда
		Если ТипЗнч(ИменаПолей.ИсходнаяНоменклатура) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИсходнаяНоменклатура", ИменаПолей.ИсходнаяНоменклатура.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИсходнаяНоменклатура", "Коллекция." + ИменаПолей.ИсходнаяНоменклатура);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИсходнаяНоменклатура", "ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)");
	КонецЕсли; 
	
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Коллекция.НомерСтроки - 1 КАК Индекс,
		|	&ПолеАналитика            КАК АналитикаПланированияНоменклатуры,
		|	&ПолеПриемник             КАК АналитикаПланированияНоменклатурыПриемник,
		|	&ПолеНоменклатура         КАК Номенклатура,
		|	&ПолеХарактеристика		  КАК Характеристика,
		|	&ПолеЕдиницаИзмерения	  КАК ЕдиницаИзмерения,
		|	&ПолеКоэффициент		  КАК Коэффициент,
		|	&ПолеИсходнаяНоменклатура КАК ИсходнаяНоменклатура
		|ПОМЕСТИТЬ ВтКоллекция
		|ИЗ &Коллекция КАК Коллекция
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс                       КАК Индекс,
		|	Коллекция.АналитикаПланированияНоменклатуры КАК АналитикаПланированияНоменклатуры,
		|	Коллекция.АналитикаПланированияНоменклатурыПриемник КАК АналитикаПланированияНоменклатурыПриемник,
		|	ВЫБОР КОГДА Коллекция.Номенклатура = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.Номенклатура, неопределено)
		|		ИНАЧЕ Коллекция.Номенклатура
		|	КОНЕЦ                                КАК Номенклатура,
		|	ВЫБОР КОГДА Коллекция.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.Характеристика
		|	КОНЕЦ                                КАК Характеристика,
		|	ВЫБОР КОГДА Коллекция.ЕдиницаИзмерения = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.ЕдиницаИзмерения, неопределено)
		|		ИНАЧЕ Коллекция.ЕдиницаИзмерения
		|	КОНЕЦ                                КАК ЕдиницаИзмерения,
		|	ВЫБОР КОГДА Коллекция.Коэффициент = 0
		|		ТОГДА ЕСТЬNULL(Аналитика.Коэффициент, 1)
		|		ИНАЧЕ Коллекция.Коэффициент
		|	КОНЕЦ                                КАК Коэффициент,
		|	ВЫБОР КОГДА Коллекция.ИсходнаяНоменклатура = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.ИсходнаяНоменклатура, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.ИсходнаяНоменклатура
		|	КОНЕЦ                                КАК ИсходнаяНоменклатура
		|ПОМЕСТИТЬ Коллекция
		|ИЗ
		|	ВтКоллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК Аналитика
		|	ПО Коллекция.АналитикаПланированияНоменклатуры = Аналитика.КлючАналитики
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс КАК Индекс,
		|	Ключи.КлючАналитики КАК АналитикаПланированияНоменклатуры,
		|	Коллекция.Номенклатура КАК Номенклатура,
		|	Коллекция.Характеристика КАК Характеристика,
		|	Коллекция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Коллекция.Коэффициент КАК Коэффициент,
		|	Коллекция.ИсходнаяНоменклатура КАК ИсходнаяНоменклатура
		|ИЗ
		|	Коллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланированияНоменклатуры КАК Ключи
		|	ПО Ключи.Номенклатура = Коллекция.Номенклатура
		|		И Ключи.Характеристика = Коллекция.Характеристика
		|		И Ключи.ЕдиницаИзмерения = Коллекция.ЕдиницаИзмерения
		|		И Ключи.Коэффициент = Коллекция.Коэффициент
		|		И Ключи.ИсходнаяНоменклатура = Коллекция.ИсходнаяНоменклатура
		|ГДЕ
		|	Ключи.КлючАналитики ЕСТЬ NULL
		|	ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаПланированияНоменклатуры
		|	ИЛИ Коллекция.АналитикаПланированияНоменклатурыПриемник = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)
		|";
	
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаПланированияНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаПланированияНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатура", ?(ЗначениеЗаполнено(ИменаПолей.Номенклатура),"Коллекция." + ИменаПолей.Номенклатура, "неопределено"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеХарактеристика", ?(ЗначениеЗаполнено(ИменаПолей.Характеристика),"Коллекция." + ИменаПолей.Характеристика, "ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)"));
	
	Если ОбщегоНазначения.ПодсистемаСуществует("БухгалтерияПредприятияПодсистемы") Тогда
		ПустаяЕИ = "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)";
	Иначе
		ПустаяЕИ = "ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЕдиницаИзмерения", ?(ЗначениеЗаполнено(ИменаПолей.ЕдиницаИзмерения),"Коллекция." + ИменаПолей.ЕдиницаИзмерения, ПустаяЕИ));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКоэффициент", ?(ЗначениеЗаполнено(ИменаПолей.Коэффициент),"Коллекция." + ИменаПолей.Коэффициент, "1"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИсходнаяНоменклатура", ?(ЗначениеЗаполнено(ИменаПолей.ИсходнаяНоменклатура),"Коллекция." + ИменаПолей.ИсходнаяНоменклатура, "ЗНАЧЕНИЕ(Справочник.АналитикаПланированияНоменклатуры.ПустаяСсылка)"));
	
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
