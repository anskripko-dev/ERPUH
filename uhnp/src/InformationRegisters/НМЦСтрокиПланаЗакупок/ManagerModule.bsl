// Если не находит, то возвращает Неопределено.
//
Функция ПолучитьНМЦПоВерсииСтрокиПлана(СтрокаПланаЗакупок) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НМЦСтрокиПланаЗакупокСрезПоследних.Сумма КАК Сумма
		|ИЗ
		|	РегистрСведений.НМЦСтрокиПланаЗакупок.СрезПоследних КАК НМЦСтрокиПланаЗакупокСрезПоследних
		|ГДЕ
		|	НМЦСтрокиПланаЗакупокСрезПоследних.СтрокаПлана = &СтрокаПланаЗакупок";
	Запрос.УстановитьПараметр("СтрокаПланаЗакупок", СтрокаПланаЗакупок);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Сумма;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Если не находит, то возвращает Неопределено.
//
Функция ПолучитьНМЦПоИдентификаторуСтрокиПлана(ИдентификаторСтрокиПланаЗакупок) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НМЦСтрокиПланаЗакупокСрезПоследних.Сумма КАК Сумма
		|ИЗ
		|	РегистрСведений.СтрокиПланаЗакупок.СрезПоследних(, ИдентификаторСтрокиПланаЗакупок = &ИдентификаторСтрокиПланаЗакупок) КАК СтрокиПланаЗакупокСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НМЦСтрокиПланаЗакупок.СрезПоследних КАК НМЦСтрокиПланаЗакупокСрезПоследних
		|		ПО СтрокиПланаЗакупокСрезПоследних.СтрокаПлана = НМЦСтрокиПланаЗакупокСрезПоследних.СтрокаПлана";
	Запрос.УстановитьПараметр("ИдентификаторСтрокиПланаЗакупок", ИдентификаторСтрокиПланаЗакупок);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Сумма;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

	
