
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПланОбмена = Метаданные.ПланыОбмена.тн_Интеграция_УПП;
	
	Для Каждого Элемент Из ПланОбмена.Состав Цикл
		
		ПолноеИмяЭлемента = Элемент.Метаданные.ПолноеИмя();
		Если СтрНайти(ПолноеИмяЭлемента, "Документ.") <> 0 Тогда
			Элементы.ТипДокумента.СписокВыбора.Добавить(ПолноеИмяЭлемента, Элемент.Метаданные.Синоним);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Запись.ДатаОкончания) И Запись.ДатаОкончания < Запись.ДатаНачала Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Дата окончания не может быть меньше даты начала!");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
