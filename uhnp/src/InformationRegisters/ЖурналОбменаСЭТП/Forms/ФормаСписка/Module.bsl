&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбъектОбмена = Неопределено;
	Если Параметры.Свойство("ОбъектОбмена", ОбъектОбмена) Тогда
		ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, "ОбъектОбмена", ОбъектОбмена, Истина);
		Элементы.ОбъектОбмена.Видимость = Ложь;
	Иначе 
		ОтборыСписковКлиентСерверУХ.ИзменитьЭлементОтбораСписка(Список, "ОбъектОбмена", ОбъектОбмена, Ложь);
		Элементы.ОбъектОбмена.Видимость = Истина;
	КонецЕСли;
	
	ЭтаФорма.ТолькоПросмотр = Истина;
КонецПроцедуры
