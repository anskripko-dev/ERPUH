
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТолькоПросмотр = Истина;
	УстановитьОформлениеФормы()
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеФормы()
	Элементы.ГруппаЗапрос.Видимость = ЗначениеЗаполнено(Запись.КлючСообщения);
	Элементы.ГруппаОтвет.Видимость = ЗначениеЗаполнено(Запись.КлючОтвета);
	Элементы.ТекстОшибки.Видимость = Запись.Ошибка;
	Элементы.Ошибка.ЦветТекста = ЦветаСтиля.ЦветШрифтаОшибкиУХ;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекстЗапроса(Команда)
	флИсходящееСообщение = (Команда.Имя = "ОткрытьТекстЗапроса");
	
	Если флИсходящееСообщение Тогда
		ПередаваемыйКлюч = Запись.КлючСообщения;
	Иначе
		ПередаваемыйКлюч = Запись.КлючОтвета;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПередаваемыйКлюч) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = ИнтеграцияЦУЗсЭТПСерверУХ.ПолучитьСообщениеОбменаПоКлючу(Запись.ЭТП, Запись.ОбъектОбмена, ПередаваемыйКлюч, флИсходящееСообщение);
	
	ОбщегоНазначенияКлиентУХ.ОткрытьФормуРедактированияМногострочногоТекста(
		Неопределено, ТекстСообщения, Неопределено,, НСтр("ru='Текст сообщения в ЕИС'"));
		
КонецПроцедуры

