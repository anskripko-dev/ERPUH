#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьИменаСубонто() Экспорт 

	Результат = Новый Структура;
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "ЗначениеСубконто1Источник");
	Субконто.Вставить(2, "ЗначениеСубконто2Источник");
	Субконто.Вставить(3, "ЗначениеСубконто3Источник");
	
	Результат.Вставить("СчетИсточник", Субконто);
	
	Субконто = Новый Соответствие;
	Субконто.Вставить(1, "ЗначениеСубконто1Приемник");
	Субконто.Вставить(2, "ЗначениеСубконто2Приемник");
	Субконто.Вставить(3, "ЗначениеСубконто3Приемник");
	
	Результат.Вставить("СчетПриемник", Субконто);
		
	Возврат Результат;
	
КонецФункции

Процедура ПеренестиРаспределенияВСправочник() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Источник.ПериодСценария КАК ПериодСценария,
	|	Источник.Сценарий КАК Сценарий,
	|	Источник.Организация КАК Организация,
	|	Источник.СчетИсточник КАК СчетИсточник,
	|	Источник.СчетПриемник КАК СчетПриемник,
	|	Источник.ЗначениеСубконто1Источник КАК ЗначениеСубконто1Источник,
	|	Источник.ЗначениеСубконто2Источник КАК ЗначениеСубконто2Источник,
	|	Источник.ЗначениеСубконто3Источник КАК ЗначениеСубконто3Источник,
	|	Источник.ЗначенияСубконтоПриемник КАК ЗначенияСубконтоПриемник,
	|	Источник.ПодразделениеИсточник КАК ПодразделениеИсточник,
	|	Источник.НаправлениеДеятельностиИсточник КАК НаправлениеДеятельностиИсточник,
	|	Источник.ПодразделениеПриемник КАК ПодразделениеПриемник,
	|	Источник.НаправлениеДеятельностиПриемник КАК НаправлениеДеятельностиПриемник,
	|	Источник.БазаРаспределения КАК БазаРаспределения,
	|	Источник.ИсточникИПриемникОдинаковы КАК ИсточникИПриемникОдинаковы,
	|	Источник.ПустоеСубконто1Источник КАК ПустоеСубконто1Источник,
	|	Источник.ПустоеСубконто2Источник КАК ПустоеСубконто2Источник,
	|	Источник.ПустоеСубконто3Источник КАК ПустоеСубконто3Источник,
	|	Источник.ПустоеСубконто1Приемник КАК ПустоеСубконто1Приемник,
	|	Источник.ПустоеСубконто2Приемник КАК ПустоеСубконто2Приемник,
	|	Источник.ПустоеСубконто3Приемник КАК ПустоеСубконто3Приемник,
	|	Источник.ЗначениеСубконто1Приемник КАК ЗначениеСубконто1Приемник,
	|	Источник.ЗначениеСубконто2Приемник КАК ЗначениеСубконто2Приемник,
	|	Источник.ЗначениеСубконто3Приемник КАК ЗначениеСубконто3Приемник,
	|	Источник.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.УдалитьНастройкаРаспределенияЗатратМСФО КАК Источник
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРаспределенияЗатратМСФО КАК Приемник
	|		ПО Источник.ПериодСценария = Приемник.ПериодСценария
	|			И Источник.Сценарий = Приемник.Сценарий
	|			И Источник.Организация = Приемник.Организация
	|			И Источник.СчетИсточник = Приемник.СчетИсточник
	|			И Источник.СчетПриемник = Приемник.СчетПриемник
	|			И Источник.ЗначениеСубконто1Источник = Приемник.СчетИсточникСубконто1
	|			И Источник.ЗначениеСубконто2Источник = Приемник.СчетИсточникСубконто2
	|			И Источник.ЗначениеСубконто3Источник = Приемник.СчетИсточникСубконто3
	|			И Источник.ПодразделениеИсточник = Приемник.СчетИсточникПодразделение
	|			И Источник.НаправлениеДеятельностиИсточник = Приемник.СчетИсточникНаправлениеДеятельности
	|			И Источник.ПодразделениеПриемник = Приемник.СчетПриемникПодразделение
	|			И Источник.НаправлениеДеятельностиПриемник = Приемник.СчетПриемникНаправлениеДеятельности
	|			И Источник.ЗначениеСубконто1Приемник = Приемник.СчетПриемникСубконто1
	|			И Источник.ЗначениеСубконто2Приемник = Приемник.СчетПриемникСубконто2
	|			И Источник.ЗначениеСубконто3Приемник = Приемник.СчетПриемникСубконто3
	|ГДЕ
	|	НЕ Источник.Обработан
	|	И Приемник.Ссылка ЕСТЬ NULL");
	
	СпособЗакрытияПоУмолчанию = ПредопределенноеЗначение("Перечисление.СпособыЗакрытияСчетовЗатрат.ПропорциональноОборотуНсбуДтКт");
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		Объект = Справочники.НастройкиРаспределенияЗатратМСФО.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
		
		Объект.СчетИсточникНаправлениеДеятельности = Выборка.НаправлениеДеятельностиИсточник;
		Объект.СчетИсточникПодразделение = Выборка.ПодразделениеИсточник;
		Объект.СчетИсточникСубконто1 = Выборка.ЗначениеСубконто1Источник;
		Объект.СчетИсточникСубконто2 = Выборка.ЗначениеСубконто2Источник;
		Объект.СчетИсточникСубконто3 = Выборка.ЗначениеСубконто3Источник;
		
		Объект.СчетПриемникНаправлениеДеятельности = Выборка.НаправлениеДеятельностиПриемник;
		Объект.СчетПриемникПодразделение = Выборка.ПодразделениеПриемник;
		Объект.СчетПриемникСубконто1 = Выборка.ЗначениеСубконто1Приемник;
		Объект.СчетПриемникСубконто2 = Выборка.ЗначениеСубконто2Приемник;
		Объект.СчетПриемникСубконто3 = Выборка.ЗначениеСубконто3Приемник;
		
		Объект.СпособЗакрытия = СпособЗакрытияПоУмолчанию;
		
		Объект.УстановитьНовыйКод();
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		
		мз = РегистрыСведений.УдалитьНастройкаРаспределенияЗатратМСФО.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(мз, Выборка);
		мз.Прочитать();
		
		мз.Обработан = Истина;
		
		мз.Записать();
				
	КонецЦикла;
	
	Запрос = Новый Запрос(ТекстЗапроса_НовыеНастройкиБезСпособа());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.СпособЗакрытия = СпособЗакрытияПоУмолчанию;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		
	КонецЦикла; 

КонецПроцедуры

Функция ТекстЗапроса_НовыеНастройкиБезСпособа()

	Возврат
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НастройкиРаспределенияЗатратМСФО КАК т
	|ГДЕ
	|	т.СпособЗакрытия = ЗНАЧЕНИЕ(Перечисление.СпособыЗакрытияСчетовЗатрат.ПустаяСсылка)";

КонецФункции

#КонецЕсли
