
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ДЛя Каждого Запись из ЭтотОбъект Цикл
		
		Если НЕ ЗначениеЗаполнено(Запись.ЗначенияСубконтоПриемник) Тогда
			Отказ = Истина;
			ВызватьИсключение НСтр("ru = 'Не заполнено поле <ЗначенияСубконтоПриемник>!'");
		КонецЕсли;
		
		Если Запись.СчетИсточник = Запись.СчетПриемник
			И Запись.ЗначениеСубконто1Источник = Запись.ЗначениеСубконто1Приемник
			И Запись.ЗначениеСубконто2Источник = Запись.ЗначениеСубконто2Приемник
			И Запись.ЗначениеСубконто3Источник = Запись.ЗначениеСубконто3Приемник Тогда
			Запись.ИсточникИПриемникОдинаковы = Истина;
		Иначе
			Запись.ИсточникИПриемникОдинаковы = Ложь;
		КонецЕсли;
		
		Для Ном_ = 1 По 3 Цикл
			Запись["ПустоеСубконто" + Ном_ + "Источник"] = НЕ ЗначениеЗаполнено(Запись["ЗначениеСубконто" + Ном_ + "Источник"]);
			Запись["ПустоеСубконто" + Ном_ + "Приемник"] = НЕ ЗначениеЗаполнено(Запись["ЗначениеСубконто" + Ном_ + "Приемник"]);
		КонецЦикла;
				
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура("Сценарий", Константы.СценарийМСФО.Получить());
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если НЕ ДанныеЗаполнения.Свойство("Сценарий") Тогда
			ДанныеЗаполнения.Вставить("Сценарий", Константы.СценарийМСФО.Получить());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры