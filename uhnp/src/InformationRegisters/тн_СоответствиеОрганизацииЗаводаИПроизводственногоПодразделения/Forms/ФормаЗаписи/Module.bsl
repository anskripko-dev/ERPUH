&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения.ОрганизацияЗавода.Представление КАК ОрганизацияЗаводаПредставление
	|ИЗ
	|	РегистрСведений.тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения КАК тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения
	|ГДЕ
	|	тн_СоответствиеОрганизацииЗаводаИПроизводственногоПодразделения.ПроизводственноеПодразделение = &ПроизводственноеПодразделение";
	
	Запрос.УстановитьПараметр("ПроизводственноеПодразделение", Запись.ПроизводственноеПодразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТекстОшибки = Выборка.ОрганизацияЗаводаПредставление;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда  
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Нельзя сопоставлять одно подразделение с несколькими организациями! Данное подразделение уже задано для организации %1", ТекстОшибки));
	КонецЕсли;
	
КонецПроцедуры
