Процедура СброситьЗависшиеОшибки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкаАвтоматическогоПоискаИЗаменыЗначений.ТипОбъекта КАК ТипОбъекта,
		|	НастройкаАвтоматическогоПоискаИЗаменыЗначений.ДнейНаРазборОшибки КАК ДнейНаРазборОшибки
		|ИЗ
	
		//НАЧАЛО Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
		
		//|	РегистрСведений.тн_НастройкаАвтоматическогоПоискаИЗаменыЗначений КАК НастройкаАвтоматическогоПоискаИЗаменыЗначений";
		
		|	РегистрСведений.тн_НастройкаАвтоматическогоПоискаИЗаменыЗначений КАК НастройкаАвтоматическогоПоискаИЗаменыЗначений
		|ГДЕ
		|	НЕ НастройкаАвтоматическогоПоискаИЗаменыЗначений.ТиповаяОбработкаЗамен";	
		
		//КОНЕЦ  Ведутенко С.А. 29.09.2023 Выполнение задач №000047019
	
	РезультатЗапроса = Запрос.Выполнить();	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаНастройки = РезультатЗапроса.Выбрать();
	
	Сч = 0;
	Запрос.Текст = "";
	Пока ВыборкаНастройки.Следующий() Цикл
		
		Сч = Сч + 1;
		
		Если Сч > 1 Тогда
			Запрос.Текст = Запрос.Текст + " ОБЪЕДИНИТЬ ";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + 
			"
			|ВЫБРАТЬ
			|	Ошибки.ЧтоЗаменять КАК ЧтоЗаменять,
			|	Ошибки.УникальныйИдентификатор КАК УникальныйИдентификатор
			|ИЗ
			|	РегистрСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений КАК Ошибки
			|ГДЕ
			|	Ошибки.ЧтоЗаменять Ссылка //ПолноеИмяТипа
			|	И Ошибки.ДатаОшибки <> ДАТАВРЕМЯ(1, 1, 1)
			|	И Ошибки.ДатаОшибки < &ГраницаЗависшихОшибок" + Сч;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПолноеИмяТипа", ВыборкаНастройки.ТипОбъекта);
	    Запрос.УстановитьПараметр("ГраницаЗависшихОшибок" + Сч, ТекущаяДатаСеанса() - ВыборкаНастройки.ДнейНаРазборОшибки * 24 * 60 * 60);
	
	КонецЦикла;
	
	//Запрос.Текст = ОбщегоНазначения.СделатьЗапросРазрешенным(Запрос.Текст);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  		
		
		МенеджерЗаписи = РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЧтоЗаменять = ВыборкаДетальныеЗаписи.ЧтоЗаменять;
		МенеджерЗаписи.УникальныйИдентификатор = ВыборкаДетальныеЗаписи.УникальныйИдентификатор;
		МенеджерЗаписи.Удалить();
	
	КонецЦикла; 	
			
КонецПроцедуры // СброситьЗависшиеОшибки()

Процедура ЗаписатьОшибку(ЧтоЗаменять, НаЧтоЗаменять, Данные, ОписаниеОшибки) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.ЧтоЗаменять 					= ЧтоЗаменять;
	МенеджерЗаписи.УникальныйИдентификатор 		= Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.НаЧтоЗаменять 				= НаЧтоЗаменять;
	МенеджерЗаписи.Данные 						= Данные;
	МенеджерЗаписи.ДатаОшибки 					= ТекущаяДатаСеанса();
	МенеджерЗаписи.ОписаниеОшибки 				= ОписаниеОшибки;
	
	МенеджерЗаписи.Записать();
		
КонецПроцедуры // ЗаписатьОшибку()

#КонецОбласти

#КонецЕсли
