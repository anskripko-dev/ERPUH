
&НаКлиенте
Процедура УдалитьОшибки(Команда)
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
	
	СписокДействий = Новый СписокЗначений;
	СписокДействий.Добавить(КодВозвратаДиалога.Да, "По значению ""Что заменять""");
	СписокДействий.Добавить(КодВозвратаДиалога.Нет, "Все ошибки");
	СписокДействий.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, "Выберите действие ...", СписокДействий);
	
КонецПроцедуры // УдалитьОшибки()

&НаКлиенте
Процедура ПослеЗакрытияВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ТекДанные = Элементы.Список.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана строка с ошибкой.");
			Возврат;
		КонецЕсли;
		
		УдалитьОшибкиНаСервере(ТекДанные.ЧтоЗаменять);
		Элементы.Список.Обновить();
		
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		УдалитьОшибкиНаСервере();
		Элементы.Список.Обновить();
		
    КонецЕсли;

КонецПроцедуры // ПослеЗакрытияВопроса()

&НаСервере
Процедура УдалитьОшибкиНаСервере(ЧтоЗаменять = Неопределено)
	
	Если ЧтоЗаменять = Неопределено Тогда
		
		НаборЗаписей = РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.СоздатьНаборЗаписей();
		НаборЗаписей.Записать();
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ЧтоЗаменять", ЧтоЗаменять);
	Выборка = РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.Выбрать(ПараметрыПоиска);
	
	Пока Выборка.Следующий() Цикл
	
		НаборЗаписей = РегистрыСведений.тн_ОшибкиАвтоматическогоПоискаИЗаменыЗначений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЧтоЗаменять.Установить(ЧтоЗаменять);
		НаборЗаписей.Отбор.УникальныйИдентификатор.Установить(Выборка.УникальныйИдентификатор);
		
		НаборЗаписей.Записать();
		
	КонецЦикла;		
	
КонецПроцедуры // УдалитьОшибкиНаСервере()
