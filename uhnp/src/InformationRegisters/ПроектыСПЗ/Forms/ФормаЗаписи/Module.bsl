#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.Договор Тогда
		ВключитьВДоговор = Запись.ВключитьВ;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДоговор;
	ИначеЕсли Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.СПЗ Тогда
		ВключитьВСПЗ = РегистрыСведений.ПроектыСПЗ.ПолучитьСПЗПоИдентификатору(Запись.ВключитьВ);
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСПЗ;
	ИначеЕсли Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПроектСПЗ;
	КонецЕсли;
	
	Элементы.ВключитьВ.Заголовок = Строка(Запись.Обеспечение);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		ПозицииПроекта,	  
		"ИД",	Запись.ИД, ВидСравненияКомпоновкиДанных.Равно, , 
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	Если Параметры.Свойство("ТолькоПросмотр") Тогда
		ТолькоПросмотр = Параметры.ТолькоПросмотр;
	КонецЕсли;
	
	Если Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
		Элементы.СтраницаПроектСПЗ.Видимость = Истина;
		Элементы.СтраницаСПЗ.Видимость = Ложь;
		Элементы.СтраницаДоговор.Видимость = Ложь;
		Элементы.СтраницаНоменклатура.Видимость = Истина;    
		Элементы.ПараметрыЗакупки.ТолькоПросмотр = Истина;
		СформироватьОтчет_СПЗСУчетомКорректировки(ОтчетСПЗСУчетомКорректировки);
	ИначеЕсли Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.Лот Тогда
		Элементы.СтраницаПроектСПЗ.Видимость = Истина;
		Элементы.СтраницаСПЗ.Видимость = Ложь;
		Элементы.СтраницаДоговор.Видимость = Ложь;
		Элементы.СтраницаНоменклатура.Видимость = Истина;
		СформироватьОтчет_СПЗСУчетомКорректировки(ОтчетСПЗСУчетомКорректировки);  
		ЭтотОбъект.Заголовок = НСтр("ru = 'Черновик Лота'");
		Элементы.ПараметрыЗакупки.ТолькоПросмотр = Истина;
	ИначеЕсли Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.СПЗ Тогда
		Элементы.СтраницаПроектСПЗ.Видимость = Ложь;
		Элементы.СтраницаСПЗ.Видимость = Истина;
		Элементы.СтраницаДоговор.Видимость = Ложь;
		Элементы.СтраницаНоменклатура.Видимость = Истина;
		СформироватьОтчет_СПЗСУчетомКорректировки(ОтчетСПЗСУчетомКорректировки);
	ИначеЕсли Запись.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.Договор Тогда
		Элементы.СтраницаПроектСПЗ.Видимость = Ложь;
		Элементы.СтраницаСПЗ.Видимость = Ложь;
		Элементы.СтраницаДоговор.Видимость = Истина;
		Элементы.СтраницаНоменклатура.Видимость = Ложь;
	Иначе
		Элементы.ОтчетСПЗСУчетомКорректировки.Видимость = Ложь;
	КонецЕсли;
	
	ЗаполнитьПараметрыЗакупки();
	
	//
	// Установить ОрганизациюЗаказчки
	ЭлементОргЗаказчик = Элементы.Организация;
	ЭлементОргЗаказчик.СписокВыбора.Очистить();
	СписокОрганизацийЗаказчиков = РегистрыСведений.ПроектыСПЗ.СписокОрганизацийЗаказчиков(Запись.Автор, Запись.ПериодЗакупки, Запись.ИД);
	Если ЗначениеЗаполнено(Запись.ОрганизацияЗаказчик) И СписокОрганизацийЗаказчиков.Найти(Запись.ОрганизацияЗаказчик) = неопределено Тогда
		СписокОрганизацийЗаказчиков.Добавить(Запись.ОрганизацияЗаказчик);
	КонецЕсли;
	Колво = СписокОрганизацийЗаказчиков.Количество();
	Если Колво = 0 Тогда
		//Запись.ОрганизацияЗаказчик = Справочники.Организации.ПустаяСсылка();
	Иначе
		//Запись.ОрганизацияЗаказчик = СписокОрганизацийЗаказчиков[0];
		ЭлементОргЗаказчик.СписокВыбора.ЗагрузитьЗначения(СписокОрганизацийЗаказчиков);
	КонецЕсли;
	
	//
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВключитьВНажатие(Элемент, СтандартнаяОбработка)
	
	Если Запись.Обеспечение = ПредопределенноеЗначение("Перечисление.ВариантыВключенияПозицийПотребностей.СПЗ") Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Документ.СтрокаПланаЗакупок.ФормаОбъекта", Новый Структура("Ключ", ВключитьВСПЗ));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСПЗСУчетомКорректировкиОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Перем ВыполненноеДействие;
	
	СтандартнаяОбработка=Ложь;
	
	СтрокаРасшифровки = ПолучитьДанныеРасшифровки(ДанныеРасшифровкиАдрес, Расшифровка);
	Если СтрокаРасшифровки.Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаРасшифровки.Поля[0].Поле = "Динамика" Тогда
	
		Поля = Новый Структура;
		Для Каждого Поле Из СтрокаРасшифровки.Поля Цикл
			Поля.Вставить(Поле.Поле, Поле.Значение);
		КонецЦикла;
		
		ШаблонСообщения = НСтр("ru = '%1 (было: %3 %2; изм: %4 %2)         '");
		
		Если НЕ Поля.Свойство("ЕдиницаИзмерения") Тогда
			ЕИ = "";
		Иначе
			ЕИ = Строка(Поля.ЕдиницаИзмерения);
		КонецЕсли;
		
		ДополнительныеДействия = Новый СписокЗначений;
		ДополнительныеДействия.Добавить("Колво", СтрШаблон(ШаблонСообщения, НСтр("ru = 'Кол-во'"), ЕИ, Строка(Поля.Количество), Строка(Поля.К_Колво)));
		ДополнительныеДействия.Добавить("Сумма", СтрШаблон(ШаблонСообщения, НСтр("ru = 'Сумма'"), "", Строка(Поля.Сумма), Строка(Поля.К_Сумма)));
		
		ЗавершениеВыбора = Новый ОписаниеОповещения("ЗаврешениеВыбораДействияРасшифровки", ЭтаФорма);
		
		ПоказатьВыборИзСписка(ЗавершениеВыбора, ДополнительныеДействия);
		
		Возврат;
		
	КонецЕсли;
	
	ДоступныеДействия = Новый Массив;
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
	//ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(
		ДанныеРасшифровкиАдрес, 
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	//
	ВыполненноеДействие = неопределено;
	ПараметрыВыбранногоДействия = неопределено;
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	ДополнительныеПараметры = Новый Структура("Расшифровка", Расшифровка);
	ДополнительныеПараметры.Вставить("СтрокаРасшифровки",СтрокаРасшифровки);
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатОбработкаДополнительнойРасшифровкиПродолжение", ЭтаФорма, ДополнительныеПараметры);
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения,Расшифровка, ДоступныеДействия,ДополнительныеДействия);

	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровкиПродолжение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ВыполненноеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		Значение = ПараметрВыполненногоДействия;
		ПараметрыФормы = Новый Структура("Ключ", Значение);
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Организации") Тогда
			ОткрытьФорму("Справочник.Организации.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.МестаПоставки") Тогда
			ОткрытьФорму("Справочник.МестаПоставки.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ОткрытьФорму("Справочник.ФизическиеЛица.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ПриоритетыПотребностей") Тогда
			ОткрытьФорму("Справочник.ПриоритетыПотребностей.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Проекты") Тогда
			ОткрытьФорму("Справочник.Проекты.ФормаОбъекта", ПараметрыФормы);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСПЗСУчетомКорректировкиОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПараметрыЗакупки

&НаКлиенте
Процедура ПараметрыЗакупкиПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПараметрыЗакупкиОткрытьПравило.Доступность = Элемент.ТекущиеДанные.ДетальнаяЗапись;
	
	Если Элемент.ТекущиеДанные.ДетальнаяЗапись Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Элемент.ТекущиеДанные.Значение) = Тип("Булево") Тогда
		// для булево не отрабатывает событие АвтоПодбор, поэтому принудительно чистим список выбора
		Элементы.ПараметрыЗакупкиЗначение.СписокВыбора.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗакупкиЗначениеАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТД = Элементы.ПараметрыЗакупки.ТекущиеДанные;
	
	Если ТипЗнч(ТД.Значение) = Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбораДляСвойства = ПараметрыЗакупки_СпискиВыбора[ТД.Свойство];
	
	СписокВыбора = Элемент.СписокВыбора;
	
	Если СписокВыбора.Количество()> 0 Тогда
		СписокВыбора.Очистить();
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СписокВыбораДляСвойства Цикл
		
		СписокВыбора.Добавить(КлючЗначение.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗакупкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Возврат;
	
	ТД = Элемент.ТекущиеДанные;
	Если ТД = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТД.ПоложениеОЗакупках) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДопПараметры = Новый Структура("Ключ, УИДУсловия", ТД.ПоложениеОЗакупках, ТД.УИДУсловия);
	ОткрытьФорму("Справочник.ПоложениеОЗакупках.Форма.ФормаЭлемента", ДопПараметры, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьСПЗ(Команда)
	
	Если Модифицированность Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Черновик СПЗ редактируется. Сохраните черновик и повторите операцию.'"));
		Возврат;
		
	КонецЕсли;
	Закрыть();
	СформироватьСПЗНаОснованииПроектаНаСервере(Запись.Автор, Запись.ОрганизацияЗаказчик, Запись.ПериодЗакупки, Запись.ИД);
	
	Оповестить("ОбработанЧерновикСПЗИзФормы");
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВыключитьВозможностьИзмененияТоварныхПозиций(Команда)
	
	Кнопка = Элементы.ФормаВключитьВыключитьВозможностьИзмененияТоварныхПозиций;
	Кнопка.Пометка = НЕ Кнопка.Пометка;
	ПоказатьСпрятатьСтраницуИзменений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПравило(Команда)
	
	ТД = Элементы.ПараметрыЗакупки.ТекущиеДанные;
	Если ТД = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТД.ПоложениеОЗакупках) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ДопПараметры = Новый Структура("Ключ, УИДУсловия", ТД.ПоложениеОЗакупках, ТД.УИДУсловия);
	ОткрытьФорму("Справочник.ПоложениеОЗакупках.Форма.ФормаЭлемента", ДопПараметры, Элементы.ПараметрыЗакупки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	ПотребностиУХ.УстановитьУсловноеОформлениеДереваПараметровЗакупки(ЭтаФорма, "ПараметрыЗакупки");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчет_СПЗСУчетомКорректировки(ТабДок)
	
	//Получаем схему из макета
	СКДОтчета = РегистрыСведений.ПроектыСПЗ.ПолучитьМакет("СКД_СПЗСУчетомКорректировки");
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.СхемаКомпоновкиДанных) Тогда
		ЭтаФорма.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СКДОтчета, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	МакетОформления = ПолучитьОбщийМакет("ОформлениеОтчетовЗеленый");
	
	//Из схемы возьмем настройки по умолчанию
	Настройки = СКДОтчета.НастройкиПоУмолчанию;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Автор"));
	Параметр.Значение = Запись.Автор;
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодЗакупки"));
	Параметр.Значение = Запись.ПериодЗакупки;
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ИД"));
	Параметр.Значение = Запись.ИД;
	//Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОрганизацияЗаказчик"));
	//Параметр.Значение = Запись.ОрганизацияЗаказчик;
	
	//Помещаем в переменную данные о расшифровке данных
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	//Формируем макет, с помощью компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	//Передаем в макет компоновки схему, настройки и данные расшифровки
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКДОтчета, Настройки, ДанныеРасшифровки, МакетОформления);
	
	//Очищаем поле табличного документа
	ТабДок.Очистить();
	
	//Выполним компоновку с помощью процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	//Выводим результат в табличный документ
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ДанныеРасшифровкиАдрес = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
	
//	ТабДок.ПоказатьУровеньГруппировокСтрок(1);
//	ТабДок.ПоказатьУровеньГруппировокСтрок(0);
	
КонецПроцедуры

