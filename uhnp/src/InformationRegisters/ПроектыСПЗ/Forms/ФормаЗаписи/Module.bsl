&НаСервереБезКонтекста
Функция ПолучитьДанныеРасшифровки(ДанныеРасшифровкиАдрес, Расшифровка)
	
	ДанныеРасшифровкиКомпоновки = ПолучитьИзВременногоХранилища(ДанныеРасшифровкиАдрес);
	СтрокаДляРасшифровки = ДанныеРасшифровкиКомпоновки.Элементы[Расшифровка];
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", СтрокаДляРасшифровки.Идентификатор);
	Результат.Вставить("ОсновноеДействие", СтрокаДляРасшифровки.ОсновноеДействие);
	Результат.Вставить("Родители", Новый Массив);
	Результат.Вставить("Поля", Новый Массив);
	
	//
	Для Каждого Родитель Из СтрокаДляРасшифровки.ПолучитьРодителей() Цикл
		Инфо = Новый Структура("Идентификатор, ОсновноеДействие");
		ЗаполнитьЗначенияСвойств(Инфо, Родитель);
		Результат.Родители.Добавить(Инфо);
	КонецЦикла;
	
	//
	Для Каждого Поле Из СтрокаДляРасшифровки.ПолучитьПоля() Цикл
		Инфо = Новый Структура("Поле, Значение, Иерархия");
		ЗаполнитьЗначенияСвойств(Инфо, Поле);
		Результат.Поля.Добавить(Инфо);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

