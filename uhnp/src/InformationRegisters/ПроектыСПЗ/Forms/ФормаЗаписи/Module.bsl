&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗакупки(ИДПроекта, ПериодЗакупки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИД", ИДПроекта);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЗакупки.Ссылка КАК Свойство,
	|	ПараметрыЗакупки.НомерПараметра КАК НомерПараметра,
	|	ВЫБОР
	|		КОГДА ПараметрыЗакупки.Предопределенный
	|			ТОГДА ПараметрыЗакупки.ИмяПредопределенныхДанных
	|		ИНАЧЕ ПараметрыЗакупки.Имя
	|	КОНЕЦ КАК Имя
	|ПОМЕСТИТЬ ВТ_ПараметрыЗакупок
	|ИЗ
	|	ПланВидовХарактеристик.ПараметрыЗакупки КАК ПараметрыЗакупки
	|ГДЕ
	|	ПараметрыЗакупки.ЭтоГруппа = ЛОЖЬ
	|	И ПараметрыЗакупки.Ссылка В(&ПараметрыОтбор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыЗакупкиПотребностей1.Автор КАК Автор,
	|	ПараметрыЗакупкиПотребностей1.ПериодЗакупки КАК ПериодЗакупки,
	|	ПараметрыЗакупкиПотребностей1.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПараметрыЗакупкиПотребностей1.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПараметрыЗакупкиПотребностей1.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПараметрыЗакупкиПотребностей1.КлючПараметровЗакупки КАК КлючПараметровЗакупки,
	|	ПараметрыЗакупкиПотребностей1.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|	ПараметрыЗакупкиПотребностей1.УИДУсловия КАК УИДУсловия
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрСведений.ПараметрыЗакупкиПотребностей1 КАК ПараметрыЗакупкиПотребностей1
	|ГДЕ
	|	(ПараметрыЗакупкиПотребностей1.АналитикаНоменклатуры, ПараметрыЗакупкиПотребностей1.АналитикаПотребностей, ПараметрыЗакупкиПотребностей1.АналитикаСтруктуры) В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|				ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|				ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры
	|			ИЗ
	|				РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|			ГДЕ
	|				ПроектыСПЗПозиции.ИД = &ИД
	|				И НЕ(ПроектыСПЗПозиции.Количество = 0
	|						И ПроектыСПЗПозиции.Сумма = 0))
	|	И ПараметрыЗакупкиПотребностей1.ПериодЗакупки = &ПериодЗакупки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПараметрыЗакупок.Свойство КАК Свойство,
	|	ВТ_ПараметрыЗакупок.Имя КАК Имя,
	|	ВТ_Данные.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_Данные.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_Данные.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	&УсловиеЗначение КАК Значение,
	|	&УсловиеЗапретИзменения КАК ЗапретИзменения,
	|	ВТ_Данные.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|	ВТ_Данные.УИДУсловия КАК УИДУсловия,
	|	ВТ_Данные.КлючПараметровЗакупки КАК КлючПараметровЗакупки
	|ПОМЕСТИТЬ ВТ_ПараметрыЗакупкиДетальные
	|ИЗ
	|	ВТ_ПараметрыЗакупок КАК ВТ_ПараметрыЗакупок,
	|	ВТ_Данные КАК ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Запрос.Свойство КАК Свойство,
	|	Запрос.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	Запрос.АналитикаПотребностей КАК АналитикаПотребностей,
	|	Запрос.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Запрос.Значение КАК Значение,
	|	Запрос.ЗапретИзменения КАК ЗапретИзменения,
	|	Запрос.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|	Запрос.УИДУсловия КАК УИДУсловия,
	|	0 КАК ИндексКартинки,
	|	Запрос.ДетальнаяЗапись КАК ДетальнаяЗапись,
	|	Запрос.Свойство.НомерПараметра КАК НомерПараметра
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПроектыСПЗПараметры.Свойство КАК Свойство,
	|		ПроектыСПЗПараметры.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|		ПроектыСПЗПараметры.АналитикаПотребностей КАК АналитикаПотребностей,
	|		ПроектыСПЗПараметры.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|		ПроектыСПЗПараметры.Значение КАК Значение,
	|		ПроектыСПЗПараметры.ЗапретИзменения КАК ЗапретИзменения,
	|		ПроектыСПЗПараметры.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|		ПроектыСПЗПараметры.УИДУсловия КАК УИДУсловия,
	|		ЛОЖЬ КАК ДетальнаяЗапись
	|	ИЗ
	|		РегистрСведений.ПроектыСПЗПараметры КАК ПроектыСПЗПараметры
	|	ГДЕ
	|		ПроектыСПЗПараметры.ИД = &ИД
	|		И (ПроектыСПЗПараметры.АналитикаНоменклатуры, ПроектыСПЗПараметры.АналитикаПотребностей, ПроектыСПЗПараметры.АналитикаСтруктуры) В
	|				(ВЫБРАТЬ
	|					ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка),
	|					ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка),
	|					ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка))
	|		И ПроектыСПЗПараметры.Свойство В(&ПараметрыОтбор)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ПараметрыЗакупкиДетальные.Свойство,
	|		ВТ_ПараметрыЗакупкиДетальные.АналитикаНоменклатуры,
	|		ВТ_ПараметрыЗакупкиДетальные.АналитикаПотребностей,
	|		ВТ_ПараметрыЗакупкиДетальные.АналитикаСтруктуры,
	|		ВТ_ПараметрыЗакупкиДетальные.Значение,
	|		ВТ_ПараметрыЗакупкиДетальные.ЗапретИзменения,
	|		ВТ_ПараметрыЗакупкиДетальные.ПоложениеОЗакупках,
	|		ВТ_ПараметрыЗакупкиДетальные.УИДУсловия,
	|		ИСТИНА
	|	ИЗ
	|		ВТ_ПараметрыЗакупкиДетальные КАК ВТ_ПараметрыЗакупкиДетальные) КАК Запрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результат.Свойство КАК Свойство,
	|	ВТ_Результат.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ВТ_Результат.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ВТ_Результат.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ВТ_Результат.Значение КАК Значение,
	|	ВТ_Результат.ЗапретИзменения КАК ЗапретИзменения,
	|	ВТ_Результат.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|	ВТ_Результат.УИДУсловия КАК УИДУсловия,
	|	ВТ_Результат.ИндексКартинки КАК ИндексКартинки,
	|	ВТ_Результат.ДетальнаяЗапись КАК ДетальнаяЗапись,
	|	ВТ_Результат.НомерПараметра КАК НомерПараметра
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат 
	|
	|ГДЕ
	|	ВТ_Результат.Свойство <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Результат.Свойство,
	|	ВТ_Результат.АналитикаНоменклатуры,
	|	ВТ_Результат.АналитикаПотребностей,
	|	ВТ_Результат.АналитикаСтруктуры,
	|	ПоложениеОЗакупкахПараметрыЗакупки.Значение,
	|	ПоложениеОЗакупкахПараметрыЗакупки.ЗапретИзменения,
	|	ВТ_Результат.ПоложениеОЗакупках,
	|	ВТ_Результат.УИДУсловия,
	|	ВТ_Результат.ИндексКартинки,
	|	ВТ_Результат.ДетальнаяЗапись,
	|	ВТ_Результат.НомерПараметра
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоложениеОЗакупках.ПараметрыЗакупки КАК ПоложениеОЗакупкахПараметрыЗакупки
	|		ПО ВТ_Результат.ПоложениеОЗакупках = ПоложениеОЗакупкахПараметрыЗакупки.Ссылка
	|			И ВТ_Результат.УИДУсловия = ПоложениеОЗакупкахПараметрыЗакупки.ИД
	|			И (ПоложениеОЗакупкахПараметрыЗакупки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты)) 
	|ГДЕ
	|	ВТ_Результат.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПараметра,
	|	ДетальнаяЗапись,
	|	АналитикаНоменклатуры,
	|	АналитикаПотребностей,
	|	АналитикаСтруктуры
	|ИТОГИ ПО
	|	Свойство
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	МодифицироватьТекстЗапроса(Запрос);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоПараметрыЗакупки(Результат)
	
	// Заполнить реквизит формы ПараметрыЗакупки
	Дерево = РеквизитФормыВЗначение("ПараметрыЗакупки");
	Дерево.Строки.Очистить();
	
	//
	ВыборкаСвойство = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСвойство.Следующий() Цикл
		
		СтрокаДерево = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерево, ВыборкаСвойство);
		
		ВыборкаДетали = ВыборкаСвойство.Выбрать();
		Пока ВыборкаДетали.Следующий() Цикл
			
			Если ВыборкаДетали.ДетальнаяЗапись Тогда
				
				СтрокаДетали = СтрокаДерево.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДетали, ВыборкаДетали);  
				
				Если ВыборкаДетали.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты Тогда 
					СтрокаДетали.ИндексКартинки = ?(СтрокаДетали.ЗапретИзменения, 0, 1);
				КонецЕсли;
				
			Иначе
				
				//
				СтрокаДерево.Значение = ВыборкаДетали.Значение;
				СтрокаДерево.ЗапретИзменения = ВыборкаДетали.ЗапретИзменения;
				СтрокаДерево.ИндексКартинки = ВыборкаДетали.ИндексКартинки;
				
			КонецЕсли;   
			
			Если СтрокаДерево.Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.ГрафикОплаты Тогда 
				ПараметрыОплаты = Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(Запись.ПоложениеОплаты, Запись.УИДУсловияОплаты);   
				СтрокаДерево.Значение = ПараметрыОплаты.ГрафикОплаты;    
				СтрокаДерево.ЗапретИзменения = ПараметрыОплаты.ЗапретИзменения_ГрафикОплаты;   
				СтрокаДерево.ИндексКартинки = ?(СтрокаДерево.ЗапретИзменения, 0, 1);
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ПараметрыЗакупки");
	
	// Рассчитать списки выбора
	РассчитатьСпискиВыбораДляСвойствНовогоПроектаСПЗ(Дерево);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыЗакупки()
	
	// Получить данные запросом
	Результат = ПолучитьПараметрыЗакупки(Запись.ИД, Запись.ПериодЗакупки);
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнить дерево параметров выбора
	ЗаполнитьДеревоПараметрыЗакупки(Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура МодифицироватьТекстЗапроса(Запрос)
	
	// Параметры закупки
	ПараметрыЗакупки = ПланыВидовХарактеристик.ПараметрыЗакупки.ПолучитьТаблицуНастроекПараметровЗакупки();  
	
	//Уберём скрытые          
	МодифицироватьТекстЗапросаУдалитьПараметр(ПланыВидовХарактеристик.ПараметрыЗакупки.УсловияОплаты, 	ПараметрыЗакупки);
	МодифицироватьТекстЗапросаУдалитьПараметр(ПланыВидовХарактеристик.ПараметрыЗакупки.КалендарьГрафика,ПараметрыЗакупки);
	
	// 
	Значение = "ВЫБОР";
	ЗапретИзменения = "ВЫБОР";
	
	ПараметрыОтбор = Новый Массив;
	
	// Условия получения полей
	Для Каждого Параметр Из ПараметрыЗакупки Цикл
		
		Если Параметр.ЭтоПараметрПозиции Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПараметраСвойство = "Свойство" + Параметр.ПараметрНомер;
		
		Значение = Значение + СтрШаблон("
			|		КОГДА ВТ_ПараметрыЗакупок.Свойство = &%1
			|			ТОГДА ВТ_Данные.КлючПараметровЗакупки.%2", ИмяПараметраСвойство, Параметр.ПараметрИмя);
		
		ЗапретИзменения = ЗапретИзменения + СтрШаблон("
			|		КОГДА ВТ_ПараметрыЗакупок.Свойство = &%1
			|			ТОГДА ВТ_Данные.КлючПараметровЗакупки.%2", ИмяПараметраСвойство, Параметр.ЗапретИзменения);
		
		Запрос.УстановитьПараметр(ИмяПараметраСвойство, Параметр.Параметр);
		
		ПараметрыОтбор.Добавить(Параметр.Параметр);
		
	КонецЦикла;
	
	Значение = Значение + "
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ";
	
	ЗапретИзменения = ЗапретИзменения + "
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗначение", Значение);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗапретИзменения", ЗапретИзменения);
	
	Запрос.УстановитьПараметр("ПараметрыОтбор", ПараметрыОтбор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура МодифицироватьТекстЗапросаУдалитьПараметр(Знач Параметр, Знач ПараметрыЗакупки)
	
	Перем Строка, Строки;
	
	Строки = ПараметрыЗакупки.НайтиСтроки(Новый Структура("Параметр", Параметр));
	Если Строки.Количество() Тогда
		Для Каждого Строка Из Строки Цикл
			ПараметрыЗакупки.Удалить(Строка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РассчитатьСпискиВыбораДляСвойствНовогоПроектаСПЗ(Дерево)
	
	Соответствие = Новый Соответствие;
	
	Для Каждого Строка1 Из Дерево.Строки Цикл
		Соответствие.Вставить(Строка1.Свойство, ПолучитьСписокВыбора(Строка1));
	КонецЦикла;
	
	ПараметрыЗакупки_СпискиВыбора = Новый ФиксированноеСоответствие(Соответствие);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокВыбора(СтрокаДерева)
	
	Результат = Новый СписокЗначений;
	
	Для Каждого Строка Из СтрокаДерева.Строки Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Значение) 
			И ТипЗнч(Строка.Значение) <> Тип("Булево") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Результат.НайтиПоЗначению(Строка.Значение) = неопределено Тогда
			Результат.Добавить(Строка.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти