Функция ОпределитьРеквизит(ДанныеЗаполнения, Свойство, Значение)
	ПВХ = ПланыВидовХарактеристик.ПараметрыЗакупки;
	Если Свойство = ПВХ.СпособЗакупки Тогда
		ДанныеЗаполнения.Вставить("СпособВыбораПоставщика", Значение);    
	ИначеЕсли Свойство = ПВХ.УсловияОплаты Тогда
		ДанныеЗаполнения.Вставить("УсловияОплаты", Значение);
	ИначеЕсли Свойство = ПВХ.Организатор Тогда
		ДанныеЗаполнения.Вставить("ОрганизаторЗакупки", Значение);
	ИначеЕсли Свойство = ПВХ.Электронно Тогда
		ДанныеЗаполнения.Вставить("ВЭлектроннойФорме", Значение);
	//ИначеЕсли Свойство = ПВХ.Обоснование Тогда
	//	ДанныеЗаполнения.Вставить("ТребуетсяОбоснованиеНМЦ", Значение);
	ИначеЕсли Свойство = ПВХ.ПриоритетСМП Тогда
		ДанныеЗаполнения.Вставить("ПриоритетУчастияМалогоИСреднегоПредпринимательства", Значение);
	ИначеЕсли Свойство = ПВХ.СубподрядчикиСМП Тогда
		ДанныеЗаполнения.Вставить("ПривлечениеМалогоИСреднегоПредпринимательстваКакПодрядчиков", Значение);
	ИначеЕсли Свойство = ПВХ.ГосТайна Тогда
		ДанныеЗаполнения.Вставить("ЗакрытаяЗакупка", Значение);
	ИначеЕсли Свойство = ПВХ.ЗакупкаИВПиЛС Тогда
		ДанныеЗаполнения.Вставить("ЗакупкаИнновационнойВысокотехнологичнойПродукцииИЛекарственныхСредств", Значение);
	ИначеЕсли Свойство = ПВХ.ДлительностьПодготовки Тогда
		ДанныеЗаполнения.Вставить("ДлительностьПодготовки", Значение);
	ИначеЕсли Свойство = ПВХ.ДлительностьПроцедуры Тогда
		ДанныеЗаполнения.Вставить("ДлительностьПроцедуры", Значение);
	//ИначеЕсли Свойство = ПВХ. Тогда
	//	ДанныеЗаполнения.Вставить("", Значение);
	КонецЕсли;
	
КонецФункции

