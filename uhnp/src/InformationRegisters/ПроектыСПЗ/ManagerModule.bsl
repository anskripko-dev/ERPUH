Процедура НаОснованииПроектаСПЗ_СформироватьСПЗ(СтруктураПроектаСПЗ, СписокДокументов)
	
	Перем Док, МенеджерСоздания;
	
	НачатьТранзакцию(); 
	
	МенеджерСоздания = ПомощникПланированияСерверВстраивание;  
	
	Док = МенеджерСоздания.СформироватьСПЗНаОснованииПроекта(СтруктураПроектаСПЗ);
	
	РегистрыСведений.ПроектыСПЗ.СохранитьПроектВИстории(СтруктураПроектаСПЗ, Док.Ссылка);
	РегистрыСведений.ПроектыСПЗ.УдалитьПроектСПЗ(СтруктураПроектаСПЗ.Автор, СтруктураПроектаСПЗ.ПериодЗакупки, СтруктураПроектаСПЗ.ИД);   
	
	СписокДокументов.Добавить(Док.Ссылка);
	
	ЗафиксироватьТранзакцию();
	
