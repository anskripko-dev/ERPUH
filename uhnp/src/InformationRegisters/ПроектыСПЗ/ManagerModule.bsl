	|	ПроектыСПЗПозиции.АналитикаПотребностей.Менеджер КАК Менеджер,
	|	ПроектыСПЗПозиции.АналитикаПотребностей.Назначение КАК Назначение,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Проект КАК Проект,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры.Организация КАК Организация,
	|	ПараметрыЗакупкиПотребностей.Свойство КАК Свойство,
	|	ПараметрыЗакупкиПотребностей.Значение КАК Значение,
	|	ПараметрыЗакупкиПотребностей.ЗапретИзменения КАК ЗапретИзменения,
	|	ПроектыСПЗПозиции.АналитикаИсточника КАК АналитикаИсточника,
	|	ПроектыСПЗПозиции.АналитикаПланирования КАК АналитикаПланирования,
	|	ПроектыСПЗПозиции.АналитикаПланирования.ДатаОперации КАК ДатаПоставки,
	|	ПараметрыЗакупкиПотребностей.ПоложениеОЗакупках КАК ПоложениеОЗакупках,
	|	ПараметрыЗакупкиПотребностей.УИДУсловия КАК УИДУсловия
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЗакупкиПотребностей КАК ПараметрыЗакупкиПотребностей
	|		ПО ПроектыСПЗПозиции.Автор = ПараметрыЗакупкиПотребностей.Автор
	|			И ПроектыСПЗПозиции.ОрганизацияЗаказчик = ПараметрыЗакупкиПотребностей.ОрганизацияЗаказчик
	|			И ПроектыСПЗПозиции.ПериодЗакупки = ПараметрыЗакупкиПотребностей.ПериодЗакупки
	|			И ПроектыСПЗПозиции.АналитикаНоменклатуры = ПараметрыЗакупкиПотребностей.АналитикаНоменклатуры
	|			И ПроектыСПЗПозиции.АналитикаПотребностей = ПараметрыЗакупкиПотребностей.АналитикаПотребностей
	|			И ПроектыСПЗПозиции.АналитикаСтруктуры = ПараметрыЗакупкиПотребностей.АналитикаСтруктуры
	|			И (ПараметрыЗакупкиПотребностей.Свойство.ЭтоПараметрПозиции = ИСТИНА)
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗПозиции.ИД = &ИД
	|	И (ПроектыСПЗПозиции.Количество <> 0
	|			ИЛИ ПроектыСПЗПозиции.Сумма <> 0)";
	
	// Учет архитектурных отличий решений
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидСтавкиНДС",
		ПотребностиВстраиваниеПереопределяемыйУХ.ИмяРеквизита_Номенклатура_ВидСтавкиНДС("ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтавкаНДС",
		ПотребностиВстраиваниеПереопределяемыйУХ.ИмяРеквизита_Номенклатура_СтавкаНДС("ПроектыСПЗПозиции.АналитикаНоменклатуры.Номенклатура"));
	
	МассивРезультат = Запрос.ВыполнитьПакет();
	
	//
	Выборка = МассивРезультат[0].Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'Ошибка при получении данных проекта СПЗ'");
		Возврат;
	КонецЕсли;
	
	//
	СтруктураПроектаСПЗ.Вставить("ВидОперации", 		Выборка.Обеспечение);
	СтруктураПроектаСПЗ.Вставить("Объект", 				Выборка.ВключитьВ);    
	СтруктураПроектаСПЗ.Вставить("Сумма", 				Выборка.Сумма);
	СтруктураПроектаСПЗ.Вставить("ПериодПредставление", Выборка.ПериодПредставление); 
	СтруктураПроектаСПЗ.Вставить("ОбщиеТребования", 	Выборка.ОбщиеТребования);
	СтруктураПроектаСПЗ.Вставить("ПоложениеОплаты", 	Выборка.ПоложениеОплаты);
	СтруктураПроектаСПЗ.Вставить("УИДУсловияОплаты", 	Выборка.УИДУсловияОплаты); 
	СтруктураПроектаСПЗ.Вставить("Параметры", 			МассивРезультат[1].Выгрузить());
	СтруктураПроектаСПЗ.Вставить("Позиции", 			МассивРезультат[2].Выгрузить());
	СтруктураПроектаСПЗ.Вставить("ПараметрыПозиции", 	МассивРезультат[3].Выгрузить());    
	СтруктураПроектаСПЗ.Вставить("ПараметрыОплаты", 	Справочники.ПоложениеОЗакупках.ПолучитьПараметрыОплаты(СтруктураПроектаСПЗ.ПоложениеОплаты, 
																												СтруктураПроектаСПЗ.УИДУсловияОплаты)); 
	
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ОрганизацияДляЗаключенияДоговора", Выборка.ОрганизацияЗаказчик);
	ДанныеЗаполнения.Вставить("ПериодЗакупок",	 Выборка.ПериодЗакупки);
	СтруктураПроектаСПЗ.Вставить("ДанныеЗаполнения", ДанныеЗаполнения);
	
	// Рассчитать дополнительные данные заполнения
	Если СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
		
		СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ПредметДоговора", Выборка.ПредметДоговора);
		СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ОбщиеТребования", Выборка.ОбщиеТребования);
		
		ЗаполнитьДанныеЗаполненияИзПараметровПроектаСПЗ(
			СтруктураПроектаСПЗ.ДанныеЗаполнения,
			СтруктураПроектаСПЗ.Параметры);
		
		РассчитатьДанныеЗаполнения(СтруктураПроектаСПЗ);
		
	ИначеЕсли СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.СПЗ Тогда
		СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("СПЗОснование", ПолучитьСПЗПоИдентификатору(СтруктураПроектаСПЗ.Объект));
	КонецЕсли;
	
	// Расчитываем дополнительные данные позиций потребностей
	ПотребностиВстраиваниеПереопределяемыйУХ.РассчитатьДанныеПозицииДляРешения(СтруктураПроектаСПЗ);
	РассчитатьДанныеПозиции(СтруктураПроектаСПЗ);
	
КонецПроцедуры

Процедура РассчитатьДанныеПозиции(СтруктураПроектаСПЗ)
	
	// Добавить в позиции параметры позиции
	ДобавитьПараметрыПозиции(СтруктураПроектаСПЗ);
	
КонецПроцедуры

Процедура ДобавитьПараметрыПозиции(СтруктураПроектаСПЗ)
	
	//
	Параметры = СтруктураПроектаСПЗ.ПараметрыПозиции.Скопировать(, "Свойство");
	Параметры.Свернуть("Свойство", "");
	
	Для Каждого СтрокаПараметра Из Параметры Цикл
		
		Инфо = ПолучитьОписаниеПараметра(СтрокаПараметра.Свойство);
		Если Инфо = неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Обнаружено неизвестный параметр позиции ""%1""'"), СтрокаПараметра.Свойство);
		КонецЕсли;
		
		// Добавить при необходимости колонку
		Если СтруктураПроектаСПЗ.Позиции.Колонки.Найти(Инфо.ИмяРеквизита) = неопределено Тогда
			СтруктураПроектаСПЗ.Позиции.Колонки.Добавить(Инфо.ИмяРеквизита, Инфо.ТипЗначения);
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("Свойство, Номенклатура, МестоПоставки, Организация, Проект, Менеджер, Приоритет, Назначение");
		СтруктураПоиска.Свойство = СтрокаПараметра.Свойство;
		
		//
		Для Каждого СтрокаПозиции Из СтруктураПроектаСПЗ.Позиции Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаПозиции);
			СтруктураПоиска.Назначение = СтрокаПозиции.ДоговорСПокупателем;
			Строки = СтруктураПроектаСПЗ.ПараметрыПозиции.НайтиСтроки(СтруктураПоиска);
			Если Строки.Количество() = 0 Тогда
				ВызватьИсключение НСтр("ru = 'Не найден параметр позиции'");
			//ИначеЕсли Строки.Количество() = 1 Тогда
			//	СтрокаПозиции[Инфо.ИмяРеквизита] = Строки[0].Значение;
			Иначе
				//ВызватьИсключение НСтр("ru = 'Найдено несколько значений параметров для одной позиции'");  
				СтрокаПозиции[Инфо.ИмяРеквизита] = Строки[0].Значение;

			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьОписаниеПараметра(Свойство)
	
	Результат = Новый Структура("ИмяРеквизита, ТипЗначения");
	
	Если Свойство = ПланыВидовХарактеристик.ПараметрыЗакупки.Обоснование Тогда
		Результат.ИмяРеквизита = "ТребуетсяОбоснованиеНМЦ";
		Результат.ТипЗначения = Свойство.ТипЗначения;
		Возврат Результат;
	Иначе
		Возврат неопределено;
	КонецЕсли;
	
КонецФункции

Процедура РассчитатьДанныеЗаполнения(СтруктураПроектаСПЗ)
	
	РассчитатьДатыСПЗ(СтруктураПроектаСПЗ);
	РассчитатьЕдиноеМестоПоставки(СтруктураПроектаСПЗ);
	
КонецПроцедуры

Процедура РассчитатьЕдиноеМестоПоставки(СтруктураПроектаСПЗ)
	
	ТМП = СтруктураПроектаСПЗ.Позиции.Скопировать(, "МестоПоставки");
	ТМП.Свернуть("МестоПоставки", "");
	
	СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ЕдиноеМестоПоставки", ТМП.Количество() < 2);
	
КонецПроцедуры

Процедура РассчитатьДатыСПЗ(СтруктураПроектаСПЗ)
	
	// Дата начала подготовки, официального объявления закупки и дата исполнения договора
	Если НЕ СтруктураПроектаСПЗ.ДанныеЗаполнения.Свойство("СпособВыбораПоставщика") Тогда
		ВызватьИсключение НСтр("ru = 'Для расчета дат строки плана закупок необходим способ выбора поставщика'");
	КонецЕсли;
	//
	ДлительностиПоУмолчанию = ПолучитьДлительностиПоУмолчанию(СтруктураПроектаСПЗ.ДанныеЗаполнения.СпособВыбораПоставщика);
	
	Если СтруктураПроектаСПЗ.ДанныеЗаполнения.Свойство("ДлительностьПодготовки") Тогда
		ДлительностьПодготовки = СтруктураПроектаСПЗ.ДанныеЗаполнения.ДлительностьПодготовки;
	Иначе
		ДлительностьПодготовки = ДлительностиПоУмолчанию.СрокПодготовки;
	КонецЕсли;
	
	Если СтруктураПроектаСПЗ.ДанныеЗаполнения.Свойство("ДлительностьПроцедуры") Тогда
		ДлительностьПроцедуры = СтруктураПроектаСПЗ.ДанныеЗаполнения.ДлительностьПодготовки;
	Иначе
		ДлительностьПроцедуры = ДлительностиПоУмолчанию.ДлительностьПроцедуры;
	КонецЕсли;
	
	МассивПериодов = СтруктураПроектаСПЗ.Позиции.ВыгрузитьКолонку("ПериодПотребности");
	НачалоОкончаниеПоставок = ПолучитьНачалоОкончаниеПоставок(СтруктураПроектаСПЗ.ПериодЗакупки, МассивПериодов);
	
	День = 60*60*24;
	
	СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ДатаНачалаПодготовкиЗакупки", 
		НачалоОкончаниеПоставок.ДатаНачала - День * (ДлительностьПодготовки + ДлительностьПроцедуры));
	СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ДатаОфициальногоОбъявленияЗакупки", 
		НачалоОкончаниеПоставок.ДатаНачала - День * (ДлительностьПроцедуры));
	СтруктураПроектаСПЗ.ДанныеЗаполнения.Вставить("ДатаИсполненияДоговора", НачалоОкончаниеПоставок.ДатаОкончания);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеЗаполненияИзПараметровПроектаСПЗ(ДанныеЗаполнения, ПараметрыПроектаСПЗ)
	
	Для Каждого Строка Из ПараметрыПроектаСПЗ Цикл
		
		Если НЕ Переопределенный_ОпределитьРеквизит(ДанныеЗаполнения, Строка.Свойство, Строка.Значение) Тогда
			ОпределитьРеквизит(ДанныеЗаполнения, Строка.Свойство, Строка.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНачалоОкончаниеПоставок(ПериодЗакупки, МассивПериодов)
	
	//
	ПериодыПотребностей = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		МассивПериодов, "ДатаНачала, ДатаОкончания");
	
	Если ПериодыПотребностей.Количество() = 0 Тогда
		Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодЗакупки, "ДатаНачала, ДатаОкончания");
	КонецЕсли;
	
	//
	ДатаНачала = неопределено; ПериодНачала = Справочники.Периоды.ПустаяСсылка();
	ДатаОкончания = неопределено; ПериодОкончания = Справочники.Периоды.ПустаяСсылка();
	
	Для Каждого КлючЗначение Из ПериодыПотребностей Цикл
		
		Если ДатаНачала = неопределено
			 ИЛИ КлючЗначение.Значение.ДатаНачала < ДатаНачала Тогда
			ДатаНачала = КлючЗначение.Значение.ДатаНачала;
			ПериодНачала = КлючЗначение.Ключ;
		КонецЕсли;
		
		Если ДатаОкончания = неопределено
			 ИЛИ КлючЗначение.Значение.ДатаОкончания > ДатаОкончания Тогда
			ДатаОкончания = КлючЗначение.Значение.ДатаОкончания;
			ПериодОкончания = КлючЗначение.Ключ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("ДатаНачала, ДатаОкончания, ПериодНачала, ПериодОкончания", 
					         ДатаНачала, ДатаОкончания, ПериодНачала, ПериодОкончания);
	
КонецФункции

Функция ПолучитьДлительностиПоУмолчанию(СпособЗакупки)
	
	Результат = Новый Структура("СрокПодготовки, ДлительностьПроцедуры", 100, 100);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпособЗакупки", СпособЗакупки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки КАК СпособЗакупки,
	|	НастройкиПланированияЗакупочныхПроцедур.МетодОценки КАК МетодОценки,
	|	НастройкиПланированияЗакупочныхПроцедур.СрокПодготовки КАК СрокПодготовки,
	|	НастройкиПланированияЗакупочныхПроцедур.ДлительностьПроцедуры КАК ДлительностьПроцедуры
	|ИЗ
	|	РегистрСведений.НастройкиПланированияЗакупочныхПроцедур КАК НастройкиПланированияЗакупочныхПроцедур
	|ГДЕ
	|	НастройкиПланированияЗакупочныхПроцедур.СпособЗакупки = &СпособЗакупки";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции 	

