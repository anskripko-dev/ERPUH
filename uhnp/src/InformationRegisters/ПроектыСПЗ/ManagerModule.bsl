Функция УстановитьЦФОИсполнитель(Позиции)  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Позиции",Позиции); 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Позиции.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	Позиции.Организация КАК Организация
	               |ПОМЕСТИТЬ ТЗПозицииНоменклатура
	               |ИЗ
	               |	&Позиции КАК Позиции
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Позиции.Номенклатура КАК Справочник.ТоварныеКатегории) КАК Номенклатура,
	               |	Позиции.Организация КАК Организация
	               |ПОМЕСТИТЬ ТЗПозицииТоварныеКатегории
	               |ИЗ
	               |	&Позиции КАК Позиции
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЗПозицииНоменклатура.Номенклатура КАК Номенклатура,
	               |	ТЗПозицииНоменклатура.Организация КАК Организация
	               |ПОМЕСТИТЬ ТЗПозиции
	               |ИЗ
	               |	ТЗПозицииНоменклатура КАК ТЗПозицииНоменклатура
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ТЗПозицииТоварныеКатегории.Номенклатура,
	               |	ТЗПозицииТоварныеКатегории.Организация
	               |ИЗ
	               |	ТЗПозицииТоварныеКатегории КАК ТЗПозицииТоварныеКатегории
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтветственныеЗаФункциональныеНаправления.ЦФО КАК ЦФО
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	ТЗПозиции КАК Позиции
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаФункциональныеНаправления КАК ОтветственныеЗаФункциональныеНаправления
	               |		ПО (ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(Позиции.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |					ТОГДА Позиции.Номенклатура.ТоварнаяКатегория.ФункциональноеНаправление = ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление
	               |				КОГДА ТИПЗНАЧЕНИЯ(Позиции.Номенклатура) = ТИП(Справочник.ТоварныеКатегории)
	               |					ТОГДА Позиции.Номенклатура.ФункциональноеНаправление = ОтветственныеЗаФункциональныеНаправления.ФункциональноеНаправление
	               |			КОНЕЦ)
	               |			И Позиции.Организация = ОтветственныеЗаФункциональныеНаправления.Организация
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтветственныеЗаФункциональныеНаправления.ЦФО
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.ЦФО КАК ЦФО
	               |ИЗ
	               |	ВТ КАК ВТ";
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() = 1 Тогда
		Возврат Выборка[0].ЦФО;
	КонецЕсли;	
	
КонецФункции

Процедура НаОснованииПроектаСПЗС_ДополнитьСПЗ(СтруктураПроектаСПЗ)
	
	НачатьТранзакцию();
	
	Док = Документы.СтрокаПланаЗакупок.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	
	Если Док.Дата < СтруктураПроектаСПЗ.ДанныеЗаполнения.СПЗОснование.Дата Тогда
		Док.Дата = СтруктураПроектаСПЗ.ДанныеЗаполнения.СПЗОснование.Дата + 1;
	КонецЕсли;
	
	Док.Заполнить(СтруктураПроектаСПЗ.ДанныеЗаполнения.СПЗОснование);
	
	НоменклатураСПЗ = Док.Номенклатура.Выгрузить();
	ДополнитьТЧНоменклатураНовымиПозициями(СтруктураПроектаСПЗ, НоменклатураСПЗ);
	Док.Номенклатура.Загрузить(НоменклатураСПЗ);
	
	// исправление ошибок в процедуре заполнения 
	Док.ЕдиноеМестоПоставки = Ложь;
	Док.Проведен = Ложь;
	Док.ПорядокФормированияЦеныДоговора = ".";
	
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	//Док.Записать(РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);
	
	РегистрыСведений.ПроектыСПЗ.СохранитьПроектВИстории(СтруктураПроектаСПЗ, Док.Ссылка);
	РегистрыСведений.ПроектыСПЗ.УдалитьПроектСПЗ(СтруктураПроектаСПЗ.Автор, СтруктураПроектаСПЗ.ПериодЗакупки, СтруктураПроектаСПЗ.ИД);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура НаОснованииПроектаСПЗС_ДополнитьДоговор(СтруктураПроектаСПЗ)
	
	НачатьТранзакцию();
	
	Док = Документы.ВерсияСоглашенияКоммерческийДоговор.СоздатьДокумент();
	Док.Заполнить(СтруктураПроектаСПЗ.Объект);
	
	//
	НоменклатураСПЗ = Док.Номенклатура.Выгрузить();
	ДополнитьТЧНоменклатураНовымиПозициями(СтруктураПроектаСПЗ, НоменклатураСПЗ);
	
	НачалоОкончаниеПоставок = ПолучитьНачалоОкончаниеПоставок(
		СтруктураПроектаСПЗ.ПериодЗакупки,
		НоменклатураСПЗ.ВыгрузитьКолонку("ПериодПотребности")
	);
	
	Док.Номенклатура.Загрузить(НоменклатураСПЗ);
	
	МассивПериодов = Новый Массив;
	Если ЗначениеЗаполнено(Док.ПериодЗакупокНачало) Тогда
		МассивПериодов.Добавить(Док.ПериодЗакупокНачало);
	КонецЕсли;
	Если ЗначениеЗаполнено(Док.ПериодЗакупокОкончание) Тогда
		МассивПериодов.Добавить(Док.ПериодЗакупокОкончание);
	КонецЕсли;
	ДатыНачала = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивПериодов, "ДатаНачала");
	
	Если ЗначениеЗаполнено(Док.ПериодЗакупокНачало) Тогда
		Если НачалоОкончаниеПоставок.ДатаНачала < ДатыНачала[Док.ПериодЗакупокНачало] Тогда
			Док.ПериодЗакупокНачало = НачалоОкончаниеПоставок.ПериодНачала;
		КонецЕсли;
	Иначе
		Док.ПериодЗакупокНачало = НачалоОкончаниеПоставок.ПериодНачала;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Док.ПериодЗакупокОкончание) Тогда
		Если НачалоОкончаниеПоставок.ДатаОкончания > ДатыНачала[Док.ПериодЗакупокОкончание] Тогда
			Док.ПериодЗакупокОкончание = НачалоОкончаниеПоставок.ПериодОкончания;
		КонецЕсли;
	Иначе
		Док.ПериодЗакупокОкончание = НачалоОкончаниеПоставок.ПериодОкончания;
	КонецЕсли;
	
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	
	РегистрыСведений.ПроектыСПЗ.СохранитьПроектВИстории(СтруктураПроектаСПЗ, Док.Ссылка);
	РегистрыСведений.ПроектыСПЗ.УдалитьПроектСПЗ(СтруктураПроектаСПЗ.Автор, СтруктураПроектаСПЗ.ПериодЗакупки, СтруктураПроектаСПЗ.ИД);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

// Устанавливает в шапку документа ДокИзм товарную категорию, исходя из табличной 
// части номенклатуры.
Процедура УстановитьТоварнуюКатегорию(ДокИзм)
	Если ТипЗнч(ДокИзм) = Тип("ДокументОбъект.СтрокаПланаЗакупок") Тогда
		// Получим заполненную таблицу номенклатуры.
		ПустаяКатегория = Справочники.ТоварныеКатегории.ПустаяСсылка();
		Выгрузка = ДокИзм.Номенклатура.Выгрузить();
		// Добавим колонку Товарная категрия.
		Выгрузка.Колонки.Добавить("ТоварнаяКатегория");
		Для Каждого ТекВыгрузка Из Выгрузка Цикл
			ТекНоменклатура = ТекВыгрузка.Номенклатура;
			Если ЗначениеЗаполнено(ТекНоменклатура) и типзнч(ТекНоменклатура)=тип("СправочникСсылка.ТоварныеКатегории")  Тогда
				ТекВыгрузка.ТоварнаяКатегория = ТекНоменклатура;
			Иначе
				ТекВыгрузка.ТоварнаяКатегория = ПустаяКатегория;
			КонецЕсли;
		КонецЦикла;	
		// Если категория уникальна - запишем её в шапку.
		МассивКатегорий = Выгрузка.ВыгрузитьКолонку("ТоварнаяКатегория");
		МассивКатегорий = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКатегорий);
		Если МассивКатегорий.Количество() = 1 Тогда
			ДокИзм.ТоварнаяКатегория = МассивКатегорий[0];
		Иначе
			// Не удалось однозначно определить товарную категорию.  не записываем в шапку.
		КонецЕсли;
	Иначе
		// Неизвестный вариант. Пропускаем.
	КонецЕсли;
КонецПроцедуры		// УстановитьТоварнуюКатегорию()

#КонецОбласти

Процедура ДополнитьТЧНоменклатураНовымиПозициями(СтруктураПроектаСПЗ, НоменклатураСПЗ)
	
	СтруктураПоиска = Новый Структура("ПериодПотребности, Номенклатура, Характеристика, ЕдиницаИзмерения, Коэффициент, МестоПоставки, Приоритет, Менеджер, ДоговорСПокупателем, Проект, Организация, СтавкаНДС");
	Для Каждого СтрокаПозиции Из СтруктураПроектаСПЗ.Позиции Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаПозиции);
		
		Строки = НоменклатураСПЗ.НайтиСтроки(СтруктураПоиска);
		Если Строки.Количество() = 0 Тогда
			СтрокаНоменклатурыСПЗ = НоменклатураСПЗ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНоменклатурыСПЗ, СтруктураПоиска);
		Иначе
			СтрокаНоменклатурыСПЗ = Строки[0];
		КонецЕсли;
		
		СтрокаНоменклатурыСПЗ.Количество = СтрокаНоменклатурыСПЗ.Количество + СтрокаПозиции.Количество;
		СтрокаНоменклатурыСПЗ.Сумма = СтрокаНоменклатурыСПЗ.Сумма + СтрокаПозиции.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСПЗПоИдентификатору(ИдентификаторСПЗ) экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторСПЗ) Тогда
		Возврат неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторСПЗ", ИдентификаторСПЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтрокиПланаЗакупокСрезПоследних.СтрокаПлана КАК СПЗ,
	|	СтрокиПланаЗакупокСрезПоследних.ИдентификаторСтрокиПланаЗакупок КАК ИдентификаторСтрокиПланаЗакупок
	|ИЗ
	|	РегистрСведений.СтрокиПланаЗакупок.СрезПоследних КАК СтрокиПланаЗакупокСрезПоследних
	|ГДЕ
	|	СтрокиПланаЗакупокСрезПоследних.ИдентификаторСтрокиПланаЗакупок = &ИдентификаторСПЗ";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СПЗ;
	
КонецФункции

