Функция ОчиститьКорзинуПользователя(Автор, ПериодЗакупки, Субъекты223ФЗ = Неопределено)  экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("Субъекты223ФЗ", Субъекты223ФЗ);
	Запрос.УстановитьПараметр("ПустойУИД", ПотребностиУХ.ПустойУИД());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроектыСПЗ.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗ.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗ.Автор КАК Автор,
	|	ПроектыСПЗ.ИД КАК ИД
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗ
	|ГДЕ
	|	ПроектыСПЗ.Автор = &Автор
	|	И ПроектыСПЗ.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗ.ОрганизацияЗаказчик.ЗакупкаПоФЗ223 = &Субъекты223ФЗ
	|	И ПроектыСПЗ.ИД = &ПустойУИД";      
	
	Если Субъекты223ФЗ = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПроектыСПЗ.ОрганизацияЗаказчик.ЗакупкаПоФЗ223 = &Субъекты223ФЗ", "");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		
		// ПозицииСПЗ
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗПозиции");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ОрганизацияЗаказчик", "ОрганизацияЗаказчик");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодЗакупки", "ПериодЗакупки");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Автор", "Автор");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИД", "ИД");
		
		Блокировка.Заблокировать();
		
		Для Каждого Строка Из Результат Цикл
		
			// ПроектыСПЗПозиции
			нз = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(Строка.Автор);
			нз.Отбор.ПериодЗакупки.Установить(Строка.ПериодЗакупки);
			нз.Отбор.ИД.Установить(Строка.ИД);
			нз.Очистить();
			нз.Записать(Истина);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
	
		ОтменитьТранзакцию();
		
		ТекстШаблона = НСтр("ru = 'Очистка корзины пользователя %1 за период %2'");
		ТекстСообщения = СтрШаблон(ТекстШаблона, Автор, ПериодЗакупки);
		
	    ЗаписьЖурналаРегистрации(ТекстСообщения,
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции

Функция КорзинаПользователяПуста(Автор, ПериодЗакупки)  экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", 					Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки",			ПериодЗакупки);
	Запрос.УстановитьПараметр("ИД",						ПотребностиУХ.ПустойУИД());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.Количество КАК Количество,
	|	ПроектыСПЗПозиции.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗПозиции.ИД = &ИД
	|	И НЕ (ПроектыСПЗПозиции.Количество = 0
	|	И ПроектыСПЗПозиции.Сумма = 0)";
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Пустой();
	
