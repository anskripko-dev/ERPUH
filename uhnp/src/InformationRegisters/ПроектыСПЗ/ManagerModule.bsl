Функция ОбработатьПроектСПЗ(Автор, ОрганизацияЗаказчик, ПериодЗакупки, ИД, СписокДокументов = Неопределено) экспорт  
	
	Если СписокДокументов = Неопределено Тогда
		СписокДокумент = Новый СписокЗначений;
	КонецЕсли;
	
	// 
	СтруктураПроектаСПЗ = Новый Структура("Автор, ОрганизацияЗаказчик, ПериодЗакупки, ИД", Автор, ОрганизацияЗаказчик, ПериодЗакупки, ИД);
	ЗаполнитьСтруктуруПроектаСПЗ(СтруктураПроектаСПЗ);
	
	Если СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
		
		НаОснованииПроектаСПЗ_СформироватьСПЗ(СтруктураПроектаСПЗ, СписокДокументов);
		
	ИначеЕсли СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.СПЗ Тогда
		
		НаОснованииПроектаСПЗС_ДополнитьСПЗ(СтруктураПроектаСПЗ);
		
	ИначеЕсли СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.Договор Тогда
		
		НаОснованииПроектаСПЗС_ДополнитьДоговор(СтруктураПроектаСПЗ);  
		
	ИначеЕсли СтруктураПроектаСПЗ.ВидОперации = Перечисления.ВариантыВключенияПозицийПотребностей.Лот Тогда
		
		НаОснованииПроектаСПЗС_СформироватьЛот(СтруктураПроектаСПЗ, СписокДокументов);
		
	КонецЕсли;
	
КонецФункции

Процедура СохранитьПроектВИстории(СтруктураПроектаСПЗ, СохраненВ) экспорт
	
	НаборЗаписей = РегистрыСведений.ПроектыСПЗИстория.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Автор.Установить(СтруктураПроектаСПЗ.Автор);
	НаборЗаписей.Отбор.ПериодЗакупки.Установить(СтруктураПроектаСПЗ.ПериодЗакупки);
	НаборЗаписей.Отбор.ИД.Установить(СтруктураПроектаСПЗ.ИД);
	
	Движение = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураПроектаСПЗ);
	Движение.Период = ТекущаяДатаСеанса();
	Движение.Объект = СохраненВ;
	Движение.Данные = Новый ХранилищеЗначения(СтруктураПроектаСПЗ);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Процедура добавляет потребности из корзины или из параметра ПозицииПроектаСПЗ в проектСПЗ договора или СПЗ
Функция ДобавитьВПроектСПЗ(Пользователь, ПериодЗакупки, ВключитьВ, ПозицииПроектаСПЗ = неопределено) экспорт
	
	// Определить ИД, если уже есть
	Если ТипЗнч(ВключитьВ) = Тип("СправочникСсылка.ИдентификаторыСтрокПлановЗакупок") Тогда
		Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.СПЗ;
		ОрганизацияЗаказчик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВключитьВ, "ОрганизацияДляЗаключенияДоговора");
	ИначеЕсли ТипЗнч(ВключитьВ) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.Договор;
		ОрганизацияЗаказчик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВключитьВ, "Организация");
	Иначе
		ВызватьИсключение НСтр("ru = 'Неверный получатель потребности'");
	КонецЕсли;
	//
	НачатьТранзакцию();
	
	Попытка
	
		СтруктураУИД = ПолучитьУИДПроектаСПЗ(Пользователь, Обеспечение, ВключитьВ, ПериодЗакупки);
		Если НЕ СтруктураУИД.Существует Тогда
			// Добавить описание проекта СПЗ
			ЗаписатьОписаниеПроектаСПЗ(
				СтруктураУИД.ИД, Пользователь, ПериодЗакупки, ОрганизацияЗаказчик, 
				НСтр("ru = 'это текст предмета'"), НСтр("ru = 'Это текст требований'"), Обеспечение, ВключитьВ);
		КонецЕсли;
			
		Инфо = ПолучитьОбъединенныйПроектСПЗ(Пользователь, ПериодЗакупки, СтруктураУИД.ИД, ПозицииПроектаСПЗ);
		
		Если ПозицииПроектаСПЗ = неопределено Тогда
			ОчиститьКорзинуПользователя(Пользователь, ПериодЗакупки);
		КонецЕсли;
		
		//
		нзПозиции = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
		
		нзПозиции.ДополнительныеСвойства.Вставить("РазрешеноНесколькоОрганизацийЗаказчиков", 
			ВЧерновикеРазрешеноНесколькоОрганизацийЗаказчиков());
		
		нзПозиции.Отбор.Автор.Установить(Пользователь);
		нзПозиции.Отбор.ИД.Установить(СтруктураУИД.ИД);
		нзПозиции.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
		нзПозиции.Очистить();
		
		нзПозиции.Загрузить(Инфо.Позиции);
		нзПозиции.Записать(Истина);
		
		//
		нзПараметры = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
		нзПараметры.Отбор.Автор.Установить(Пользователь);
		нзПараметры.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
		нзПараметры.Отбор.ИД.Установить(СтруктураУИД.ИД);
		нзПараметры.Загрузить(Инфо.Параметры);
		нзПараметры.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		//
		Если нзПозиции <> неопределено И нзПозиции.ДополнительныеСвойства.Свойство("РезультатОперации") Тогда
			
			Для Каждого КлючЗначение Из нзПозиции.ДополнительныеСвойства.РезультатОперации Цикл
				Если КлючЗначение.Значение.Ошибка = Истина Тогда
					// в поле Сообщение текст ошибки
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки; 
	
	
	Возврат СтруктураУИД.ИД;
	
КонецФункции

// Процедура добавляет потребности из корзины в ранее созданный проектСПЗ
Процедура ДобавитьКорзинуВПроектСПЗ(УИДПроекта, Пользователь, ПериодЗакупки) экспорт
	
	//
	НачатьТранзакцию();
	
	Инфо = ПолучитьОбъединенныйПроектСПЗ(Пользователь, ПериодЗакупки, УИДПроекта);
	
	ОчиститьКорзинуПользователя(Пользователь, ПериодЗакупки);
	
	//
	нзПозиции = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
	
	нзПозиции.ДополнительныеСвойства.Вставить("РазрешеноНесколькоОрганизацийЗаказчиков", 
		ВЧерновикеРазрешеноНесколькоОрганизацийЗаказчиков());
	
	нзПозиции.Отбор.Автор.Установить(Пользователь);
	нзПозиции.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	нзПозиции.Отбор.ИД.Установить(УИДПроекта);
	нзПозиции.Загрузить(Инфо.Позиции);
	нзПозиции.Записать(Истина);
	
	// Чистим корзину
	ОчиститьКорзинуПользователя(Пользователь, ПериодЗакупки);
	
	//
	нзПараметры = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
	нзПараметры.Отбор.Автор.Установить(Пользователь);
	нзПараметры.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	нзПараметры.Отбор.ИД.Установить(УИДПроекта);
	нзПараметры.Загрузить(Инфо.Параметры);
	нзПараметры.Записать(Истина);
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

#КонецОбласти 

Функция СписокОрганизацийЗаказчиков(Автор, ПериодЗакупки, ПустойИД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ПустойИД", ПустойИД);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗПозиции.ИД = &ПустойИД
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияЗаказчик
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОрганизацияЗаказчик");
	
КонецФункции

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

#Область УправлениеПроектамиСПЗ

Процедура ЗаписатьОписаниеПроектаСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки, ОрганизацияЗаказчик, ТекстПредмет, ТекстТребования, Обеспечение, ВключитьВ = неопределено)
	
	// 
	нзОписание = СоздатьНаборЗаписей();
	нзОписание.Отбор.Автор.Установить(ТекПользователь);
	нзОписание.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	нзОписание.Отбор.ИД.Установить(УИДПроекта);
	нзОписание.Прочитать();
	Если нзОписание.Количество() > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Что-то пошло не так и уникальный идентификатор оказался неуникальным.
			|Пожалуйста, повторите операцию.'");
	КонецЕсли;
	
	//
	дв = нзОписание.Добавить();
	дв.Автор = ТекПользователь;
	дв.ИД = УИДПроекта;
	дв.ПериодЗакупки = ПериодЗакупки;
	
	дв.ОрганизацияЗаказчик = ОрганизацияЗаказчик;
	Если Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.НовыйПроектСПЗ Тогда
		дв.Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ;
		дв.ВключитьВ = неопределено;
	ИначеЕсли Обеспечение = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ Тогда
		дв.Обеспечение = Обеспечение;
		дв.ВключитьВ = неопределено;
	Иначе
		дв.Обеспечение = Обеспечение;
		дв.ВключитьВ = ВключитьВ;
	КонецЕсли;
	дв.ПредметДоговора = ТекстПредмет;
	дв.ОбщиеТребования = ТекстТребования;
	дв.Дата = ТекущаяДатаСеанса();
	
	нзОписание.Записать(Истина);
	
КонецПроцедуры

Процедура ЗаписатьПараметрыСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки, ДеревоПараметровСПЗ)
	
	// Параметры ПроектаСПЗ
	нзПараметры = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
	нзПараметры.Отбор.Автор.Установить(ТекПользователь);
	нзПараметры.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	нзПараметры.Отбор.ИД.Установить(УИДПроекта);
	нзПараметры.Очистить();
	
	Ключ = Новый Структура("Автор, ПериодЗакупки, ИД, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей",
		ТекПользователь, ПериодЗакупки, УИДПроекта,
		Справочники.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка(),
		Справочники.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка(),
		Справочники.КлючиАналитикиПланированияПотребностей.ПустаяСсылка());
		
	Итоговые = "Свойство, Значение, ЗапретИзменения";
	Детали = "Свойство, Значение, ЗапретИзменения, АналитикаНоменклатуры, АналитикаСтруктуры, АналитикаПотребностей, ПоложениеОЗакупках, УИДУсловия";
		
	Для Каждого СтрокаДерева Из ДеревоПараметровСПЗ.Строки Цикл
		дв = нзПараметры.Добавить();
		ЗаполнитьЗначенияСвойств(дв, Ключ);
		ЗаполнитьЗначенияСвойств(дв, СтрокаДерева, Итоговые);
		
		Для Каждого СтрокаВариант Из СтрокаДерева.Строки Цикл
			дв = нзПараметры.Добавить();
			ЗаполнитьЗначенияСвойств(дв, Ключ);
			ЗаполнитьЗначенияСвойств(дв, СтрокаВариант, Детали);
		КонецЦикла;
		
	КонецЦикла;
	
	нзПараметры.Записать(Истина);
	
КонецПроцедуры

Процедура ЗаписатьПозицииСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки, ПозицииПроектаСПЗ)
	
	нзПозиции = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
	нзПозиции.Отбор.Автор.Установить(ТекПользователь);
	нзПозиции.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
	
	// Добавляем возможно недостающие колонки
	Если ПозицииПроектаСПЗ.Колонки.Найти("ИД") = неопределено Тогда
		ПозицииПроектаСПЗ.Колонки.Добавить("ИД");
		ПозицииПроектаСПЗ.ЗаполнитьЗначения(УИДПроекта, "ИД");
	КонецЕсли;
	Если ПозицииПроектаСПЗ.Колонки.Найти("Автор") = неопределено Тогда
		ПозицииПроектаСПЗ.Колонки.Добавить("Автор");
		ПозицииПроектаСПЗ.ЗаполнитьЗначения(ТекПользователь, "Автор");
	КонецЕсли;
	
	нзПозиции.Отбор.ИД.Установить(УИДПроекта);
	нзПозиции.Загрузить(ПозицииПроектаСПЗ); 
	//Попытка
	нзПозиции.Записать(Истина);
	//Исключение
	//КонецПопытки
КонецПроцедуры

// Функция возвращает таблицу потрбеностей, ранее помещенную в корзину. Корзина очищается.
Функция ПолучитьПотребностиИзКорзины(УИДПроекта, ТекПользователь, ПериодЗакупки)

	ПустойУИД = ОбщегоНазначенияКлиентСерверУХ.ПустойУникальныйИдентификатор();
	ЗаблокироватьПозицииПроектаСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки);

	// Получаем данные корзины
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", ТекПользователь);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ПустойУИД", ПустойУИД);
	Запрос.УстановитьПараметр("ИД", УИДПроекта);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроектыСПЗПозиции.Автор КАК Автор,
	|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
	|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
	|	&ИД КАК ИД,
	|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
	|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
	|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	ПроектыСПЗПозиции.Количество КАК Количество,
	|	ПроектыСПЗПозиции.Сумма КАК Сумма,
	|	ПроектыСПЗПозиции.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
	|ГДЕ
	|	ПроектыСПЗПозиции.Автор = &Автор
	|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗПозиции.ИД = &ПустойУИД
	|	И (ПроектыСПЗПозиции.Количество <> 0
	|			ИЛИ ПроектыСПЗПозиции.Сумма <> 0)";
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
	
КонецФункции

// Процедура блокирует по УИДПроекта позиции проекта СПЗ
Процедура ЗаблокироватьПозицииПроектаСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки)

	// Блокируемся
	Блокировка = Новый БлокировкаДанных;
	ОбъектБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗПозиции");
	ОбъектБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ОбъектБлокировки.УстановитьЗначение("Автор",			ТекПользователь);
	ОбъектБлокировки.УстановитьЗначение("ПериодЗакупки",	ПериодЗакупки);
	ОбъектБлокировки.УстановитьЗначение("ИД", 				УИДПроекта);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ПолучитьУИДПроектаСПЗ(ТекущийПользователь, Обеспечение, ВключитьВ, ПериодЗакупки)
	
	СтруктураРезультат = Новый Структура("ИД, Существует");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", ТекущийПользователь);
	Запрос.УстановитьПараметр("Обеспечение", Обеспечение);
	Запрос.УстановитьПараметр("ВключитьВ", ВключитьВ);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроектыСПЗ.ИД КАК ИД
	|ИЗ
	|	РегистрСведений.ПроектыСПЗ КАК ПроектыСПЗ
	|ГДЕ
	|	ПроектыСПЗ.Автор = &Автор
	|	И ПроектыСПЗ.ПериодЗакупки = &ПериодЗакупки
	|	И ПроектыСПЗ.Обеспечение = &Обеспечение
	|	И ПроектыСПЗ.ВключитьВ = &ВключитьВ";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		СтруктураРезультат.ИД = Новый УникальныйИдентификатор;
		СтруктураРезультат.Существует = Ложь;
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		СтруктураРезультат.ИД = Выборка.ИД;
		СтруктураРезультат.Существует = Истина;
		
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Функция ПолучитьОбъединенныйПроектСПЗ(Автор, ПериодЗакупки, УИДКуда, ПозицииПроектаСПЗКДобавлению = неопределено)
	
	// Блокируем позиции проектов получателя и если формируем из корзины, то и корзину
	ЗаблокироватьПозицииПроектаСПЗ(УИДКуда, Автор, ПериодЗакупки);
	Если ПозицииПроектаСПЗКДобавлению = неопределено Тогда
		ПустойУИД = ПотребностиУХ.ПустойУИД();
		ЗаблокироватьПозицииПроектаСПЗ(ПустойУИД, Автор, ПериодЗакупки);
	КонецЕсли;
	
	// Записать новый проект
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("ЦелевойУИД", УИДКуда);
	
	Если ПозицииПроектаСПЗКДобавлению = неопределено Тогда
		Запрос.УстановитьПараметр("ПустойУИД", ПустойУИД);
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПроектыСПЗПозиции.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		|	ПроектыСПЗПозиции.ПериодЗакупки КАК ПериодЗакупки,
		|	ПроектыСПЗПозиции.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	ПроектыСПЗПозиции.АналитикаПотребностей КАК АналитикаПотребностей,
		|	ПроектыСПЗПозиции.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	ПроектыСПЗПозиции.ПериодПотребности КАК ПериодПотребности,
		|	СУММА(ПроектыСПЗПозиции.Количество) КАК Количество,
		|	СУММА(ПроектыСПЗПозиции.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ВТ_Позиции
		|ИЗ
		|	РегистрСведений.ПроектыСПЗПозиции КАК ПроектыСПЗПозиции
		|ГДЕ
		|	ПроектыСПЗПозиции.Автор = &Автор
		|	И ПроектыСПЗПозиции.ИД = &ПустойУИД
		|	И ПроектыСПЗПозиции.ПериодЗакупки = &ПериодЗакупки
		|
		|СГРУППИРОВАТЬ ПО
		|	ПроектыСПЗПозиции.ОрганизацияЗаказчик,
		|	ПроектыСПЗПозиции.ПериодЗакупки,
		|	ПроектыСПЗПозиции.АналитикаСтруктуры,
		|	ПроектыСПЗПозиции.ПериодПотребности,
		|	ПроектыСПЗПозиции.АналитикаНоменклатуры,
		|	ПроектыСПЗПозиции.АналитикаПотребностей
		|
		|ИМЕЮЩИЕ
		|	НЕ(СУММА(ПроектыСПЗПозиции.Количество) = 0
		|			И СУММА(ПроектыСПЗПозиции.Сумма) = 0)";
	Иначе
		Запрос.УстановитьПараметр("ПозицииПроектаСПЗКДобавлению", ПозицииПроектаСПЗКДобавлению);
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Таблица.ОрганизацияЗаказчик КАК ОрганизацияЗаказчик,
		|	&ПериодЗакупки КАК ПериодЗакупки,
		|	Таблица.ПериодПотребности КАК ПериодПотребности,
		|	Таблица.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
		|	Таблица.АналитикаПотребностей КАК АналитикаПотребностей,
		|	Таблица.АналитикаСтруктуры КАК АналитикаСтруктуры,
		|	Таблица.КорректировкаКоличество КАК Количество,
		|	Таблица.КорректировкаСумма КАК Сумма
		|ПОМЕСТИТЬ ВТ_Позиции
		|ИЗ
		|	&ПозицииПроектаСПЗКДобавлению КАК Таблица";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса +
