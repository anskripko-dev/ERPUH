Процедура ЗаписатьНовыйПроектСПЗ(ТекПользователь, ПериодЗакупки, ОрганизацияЗаказчик, ПараметрыЗакупки, ПозицииПроектаСПЗ = неопределено, ПредметЗакупки = "", ОбщиеТребования = "", ВариантВключенияПозиций = Неопределено) экспорт
	
	//
	УИДПроекта = Новый УникальныйИдентификатор;
	
	//
	НачатьТранзакцию();   
	
	Если ВариантВключенияПозиций = Неопределено Тогда
		ИспользоватьПрограммуЗакупок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияЗаказчик, "ИспользоватьПрограммуЗакупок");     
		Если ИспользоватьПрограммуЗакупок = Истина Тогда
			ВариантВключенияПозиций = Перечисления.ВариантыВключенияПозицийПотребностей.ПроектСПЗ;
		Иначе
			ВариантВключенияПозиций = Перечисления.ВариантыВключенияПозицийПотребностей.Лот;
		КонецЕсли;
	КонецЕсли;
	
	Попытка

		Если ПозицииПроектаСПЗ = неопределено Тогда
			ПозицииПроектаКДобавлениюВСПЗ = ПолучитьПотребностиИзКорзины(УИДПроекта, ТекПользователь, ПериодЗакупки);
			// Чистим корзину
			ОчиститьКорзинуПользователя(ТекПользователь, ПериодЗакупки);
		Иначе
			ПозицииПроектаКДобавлениюВСПЗ = ПозицииПроектаСПЗ;
		КонецЕсли;
		
		// Описание проекта СПЗ
		ЗаписатьОписаниеПроектаСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки,
			ОрганизацияЗаказчик, ПредметЗакупки, ОбщиеТребования, ВариантВключенияПозиций);
		
		// Параметры проекта СПЗ
		ЗаписатьПараметрыСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки, ПараметрыЗакупки);
		
		// Позиции проекта СПЗ
		ЗаписатьПозицииСПЗ(УИДПроекта, ТекПользователь, ПериодЗакупки, ПозицииПроектаКДобавлениюВСПЗ);
		
		//
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Попытка сформировать новый проект СПЗ оказалась неудачной.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция УдалитьВсеПроектыСПЗ(Автор, ПериодЗакупки) экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроектыСПЗ.Автор КАК Автор,
	|	ПроектыСПЗ.ПериодЗакупки КАК ПериодЗакупки,
	|	ПроектыСПЗ.ИД КАК ИД
	|ИЗ
	|	РегистрСведений.ПроектыСПЗ КАК ПроектыСПЗ
	|ГДЕ
	|	ПроектыСПЗ.Автор = &Автор
	|	И ПроектыСПЗ.ПериодЗакупки = &ПериодЗакупки";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	НачатьТранзакцию();
	
	Попытка
	
		Блокировка = Новый БлокировкаДанных;
		
		// ПроектыСПЗ
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗ");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Автор", "Автор");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодЗакупки", "ПериодЗакупки");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИД", "ИД");
		
		// ПозицииСПЗ
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗПозиции");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Автор", "Автор");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодЗакупки", "ПериодЗакупки");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИД", "ИД");
		
		// ПараметрыСПЗ
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПроектыСПЗПараметры");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Результат;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Автор", "Автор");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПериодЗакупки", "ПериодЗакупки");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИД", "ИД");
		
		Блокировка.Заблокировать();
		
		Для Каждого Строка Из Результат Цикл
		
			//
			нз = РегистрыСведений.ПроектыСПЗ.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(Строка.Автор);
			нз.Отбор.ПериодЗакупки.Установить(Строка.ПериодЗакупки);
			//нз.Отбор.ИД.Установить(Строка.ИД);
			нз.Очистить();
			нз.Записать(Истина);
			
			//
			нз = РегистрыСведений.ПроектыСПЗПозиции.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(Строка.Автор);
			нз.Отбор.ПериодЗакупки.Установить(Строка.ПериодЗакупки);
			//нз.Отбор.ИД.Установить(Строка.ИД);
			нз.Очистить();
			нз.Записать(Истина);
			
			//
			нз = РегистрыСведений.ПроектыСПЗПараметры.СоздатьНаборЗаписей();
			нз.Отбор.Автор.Установить(Автор);
			нз.Отбор.ПериодЗакупки.Установить(ПериодЗакупки);
			//нз.Отбор.ИД.Установить(Строка.ИД);
			нз.Очистить();
			нз.Записать(Истина);
		
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстШаблона = НСтр("ru = 'Удаление всех черновиков СПЗ пользователя %1 за период %2'");
		ТекстСообщения = СтрШаблон(ТекстШаблона, Автор, ПериодЗакупки);
		
		
	    ЗаписьЖурналаРегистрации(ТекстСообщения,
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции

