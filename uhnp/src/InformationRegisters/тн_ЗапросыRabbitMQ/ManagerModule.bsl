Процедура ДобавитьЗаписьПриОтправкеСообщения(ПараметрыЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ЗапросыRabbitMQ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗапроса = ПараметрыЗаписи.ИдентификаторЗапроса;
	МенеджерЗаписи.ВидСообщения 		= ПараметрыЗаписи.ВидСообщения;
	МенеджерЗаписи.ДатаОтправкиЗапроса 	= ТекущаяДатаСеанса();
	МенеджерЗаписи.XML_ПакетИсходящий 	= ПараметрыЗаписи.ТекстСообщения;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ОбновитьЗаписьПриПолученииСообщения(ПараметрыЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ЗапросыRabbitMQ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗапроса = ПараметрыЗаписи.ИдентификаторЗапроса;
	МенеджерЗаписи.ВидСообщения = ПараметрыЗаписи.ВидСообщения;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
		
	МенеджерЗаписи.XML_ПакетВходящий = ПараметрыЗаписи.XML_ПакетВходящий;
	МенеджерЗаписи.ДатаПолученияОтвета = ТекущаяДатаСеанса();
	МенеджерЗаписи.ЕстьОшибки = ЗначениеЗаполнено(ПараметрыЗаписи.ТекстОшибки);
	МенеджерЗаписи.ТекстОшибки = ПараметрыЗаписи.ТекстОшибки;
	МенеджерЗаписи.ОтветПолучен = Истина;
	
	//НАЧАЛО Качикина 30.07.2025 Выполнение задач №000054582
	//// НАЧАЛО Ермаков Дмитрий 20.05.2025 Выполнение задач №000053741
