		ЗаписьЖурналаРегистрации("Ошибка записи в регистр сведений ""Запросы Rabbit MQ (тн)""", 
			УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
	КонецПопытки;
		
КонецПроцедуры

Функция ПолучитьЗапись(СтруктураЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ЗапросыRabbitMQ.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

