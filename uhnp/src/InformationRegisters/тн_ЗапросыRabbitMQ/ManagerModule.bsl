	//	МенеджерЗаписи.Объект = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыЗаписи.ИдентификаторОбъекта));
	//КонецЕсли;
	//// КОНЕЦ Ермаков Дмитрий 20.05.2025 Выполнение задач №000053741 
	//КОНЕЦ Качикина 30.07.2025 Выполнение задач №000054582
	
	// НАЧАЛО Ермаков Дмитрий 25.08.2025 Выполнение задач №000054888
	Если МенеджерЗаписи.ВидСообщения = Перечисления.ТН_ВидыСообщений_ОбменМеждуЦИС.requestPersons_v1
		И ПараметрыЗаписи.ИдентификаторОбъекта <> "00000000-0000-0000-0000-000000000000" Тогда 
		МенеджерЗаписи.Объект = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыЗаписи.ИдентификаторОбъекта));
