#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбновитьРесурсыРегистра(Параметры=Неопределено) Экспорт
		
	НаборЗаписей=РегистрыСведений.ДокументыНеОтражаемыеПоШаблонам.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Для Каждого Строка ИЗ НаборЗаписей Цикл
		
		МетаданныеОбъекта=Строка.Документ.Метаданные();
		
		Если МетаданныеОбъекта.Реквизиты.Найти("Организация")=Неопределено Тогда 
			Строка.ДатаДокумента=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Документ,"Дата");
		Иначе
			
			ДанныеДокумента=ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Документ,"Организация,Дата");
			Строка.ДатаДокумента=ДанныеДокумента.Дата;
			Строка.Организация	=ДанныеДокумента.Организация

		КонецЕсли;
		
		Строка.НеОтражатьМСФО=Истина;
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры // ОбновитьРесурсыРегистра() 	
	
#КонецЕсли