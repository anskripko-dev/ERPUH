
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		ТекЗапись.ПериодСортировкиМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЦикла;	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
		
	КлючевойОбъектПроцесса = ЭтотОбъект.Отбор.ДокументПроцесса.Значение.КлючевойОбъектПроцесса;

	Если Метаданные.ОпределяемыеТипы.ОбъектыДляСогласования.Тип.СодержитТип(ТипЗнч(КлючевойОбъектПроцесса)) Тогда
		
		НаборЗаписейИсторияСогласованияОбъектов = РегистрыСведений.ИсторияСогласованияОбъектов.СоздатьНаборЗаписей();
		
		НаборЗаписейИсторияСогласованияОбъектов.Отбор.Период.Установить(ЭтотОбъект.Отбор.Период.Значение);
		НаборЗаписейИсторияСогласованияОбъектов.Отбор.ОбъектСогласования.Установить(КлючевойОбъектПроцесса);
		НаборЗаписейИсторияСогласованияОбъектов.Отбор.ДатаНачалаСогласования.Установить(ЭтотОбъект.Отбор.ДокументПроцесса.Значение.Дата);
		НаборЗаписейИсторияСогласованияОбъектов.Отбор.ЭтапПроцесса.Установить(ЭтотОбъект.Отбор.ЭтапПроцесса.Значение);
		НаборЗаписейИсторияСогласованияОбъектов.Отбор.ИдентификаторСообщения.Установить(ЭтотОбъект.Отбор.ИдентификаторСообщения.Значение);
				
		Для Каждого ТекЗапись Из ЭтотОбъект Цикл 
			НоваяЗапись = НаборЗаписейИсторияСогласованияОбъектов.Добавить();
			
			//Измерения
			НоваяЗапись.Период = ТекЗапись.Период;
			НоваяЗапись.ОбъектСогласования = КлючевойОбъектПроцесса;
			НоваяЗапись.ДатаНачалаСогласования = ТекЗапись.ДокументПроцесса.Дата;
			НоваяЗапись.ЭтапПроцесса = ТекЗапись.ЭтапПроцесса;
			НоваяЗапись.ИдентификаторСообщения = ТекЗапись.ИдентификаторСообщения;
			
			//Ресурсы
			НоваяЗапись.Пользователь = ТекЗапись.Пользователь;
			НоваяЗапись.Событие = ТекЗапись.Событие;
			НоваяЗапись.Комментарий = ТекЗапись.Комментарий;
			НоваяЗапись.КомментарийСистемы = ТекЗапись.КомментарийСистемы;
			
			//Реквизиты
			НоваяЗапись.ПериодСортировкиМс = ТекЗапись.ПериодСортировкиМс;
		КонецЦикла;
		
		Попытка
			НаборЗаписейИсторияСогласованияОбъектов.Записать(Замещение);
		Исключение
		КонецПопытки;
		
	КонецЕсли;
		
КонецПроцедуры
