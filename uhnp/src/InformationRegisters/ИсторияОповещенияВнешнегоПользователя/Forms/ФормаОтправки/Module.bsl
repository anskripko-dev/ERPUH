
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресЭП = Параметры.АдресЭП;       
	Документ = Параметры.Документ;
	Пользователь = Параметры.Пользователь;
	СписокИстории.Параметры.УстановитьЗначениеПараметра("Документ",Документ);
	
	ОпределитьОповещение(); 
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьОповещение()

	ВидСобытия = АккредитацияПоставщиковУХ.ПолучитьВидСобытияПоОбъекту(Документ);
	Оповещение  = ВидСобытия;
	ТекстШаблона = МодульУправленияОповещениямиУХ.ПолучитьТекстПоВидуСобытияПоШаблону(
			ВидСобытия,
			Документ);

	ТекстОповещений.УстановитьHTML(ТекстШаблона,Новый Структура());
КонецПроцедуры

&НаСервере
Процедура ОтправитьПисьмоНаСервере()

	РезультатФункции = ЦентрализованныеЗакупкиКлиентСерверУХ.ПолучитьПустойРезультатРаботы();

	Попытка
		АккредитацияПоставщиковУХ.СоздатьИОтправитьПисьмо(ТекстОповещений.ПолучитьТекст(), Строка(Оповещение), АдресЭП);
		ТекстУспешнойОтправки = НСтр("ru = 'Отправлено оповещение поставщику %АнкетаПоставщика% на адрес %АдресЭП%.'");
		ТекстУспешнойОтправки = СтрЗаменить(ТекстУспешнойОтправки, "%АнкетаПоставщика%", Строка(Документ));
		ТекстУспешнойОтправки = СтрЗаменить(ТекстУспешнойОтправки, "%АдресЭП%", АдресЭП);    
		
		НаборЗаписей = РегистрыСведений.ИсторияОповещенияВнешнегоПользователя.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
		НаборЗаписей.Отбор.Период.Установить(ТекущаяДатаСеанса());
		
		Движение = НаборЗаписей.Добавить();
		Движение.Период = ТекущаяДатаСеанса();
		Движение.Пользователь = Пользователь;
		Движение.Документ = Документ; 
		Если ТипЗнч(Документ) = Тип("СправочникСсылка.АнкетыПоставщиков") Тогда
		Движение.Получатель = Документ.ВнешнийПользователь;	
		ИначеЕсли ТипЗнч(Документ) = Тип("СправочникСсылка.АнкетыПоставщиков") Тогда	
		Движение.Получатель = Документ.АнкетаПоставщика.ВнешнийПользователь;    
		Иначе     
		Движение.Получатель = Документ.АнкетаПоставщика.ВнешнийПользователь; 
		КонецЕсли;
		Движение.Оповещение = Оповещение;
		Движение.АдресОтправки = АдресЭП;
		Движение.ТекстОповещений = ТекстОповещений.ПолучитьТекст();   
		ДанныеОбъекта = СериализоватьОбъект(Документ);

		Движение.ВерсияДокумента = Новый ХранилищеЗначения(ДанныеОбъекта, Новый СжатиеДанных(9));
		НаборЗаписей.Записать(Истина);
		Элементы.СписокИстории.Обновить();
	Исключение
		ТекстСообщения = НСтр("ru = 'При отправке письма на адрес %АдресЭП% возникли ошибки: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%АдресЭП%", Строка(АдресЭП));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ЦентрализованныеЗакупкиКлиентСерверУХ.СообщитьОшибкиПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция СериализоватьОбъект(Объект) Экспорт
	
	ЗаписьXML = Новый ЗаписьFastInfoset;
	ЗаписьXML.УстановитьДвоичныеДанные();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписатьXML(ЗаписьXML, Объект, НазначениеТипаXML.Явное);
	
	Возврат ЗаписьXML.Закрыть();

КонецФункции

&НаКлиенте
Процедура ОтправитьПисьмо(Команда)
	ОтправитьПисьмоНаСервере();
КонецПроцедуры

&НаСервере
Функция АдресСериализованногоОбъекта(Период)
	// Вставить содержимое обработчика.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсторияОповещенияВнешнегоПользователя.ВерсияДокумента КАК ВерсияДокумента
	               |ИЗ
	               |	РегистрСведений.ИсторияОповещенияВнешнегоПользователя КАК ИсторияОповещенияВнешнегоПользователя
	               |ГДЕ
	               |	ИсторияОповещенияВнешнегоПользователя.Документ = &Документ
	               |	И ИсторияОповещенияВнешнегоПользователя.Период = &Период";
	Запрос.УстановитьПараметр("Документ",Документ);
	Запрос.УстановитьПараметр("Период",Период);  
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		МассивВерсий = Новый Массив;
		МассивВерсий.Добавить(ПоместитьВоВременноеХранилище(Выборка.ВерсияДокумента,Новый УникальныйИдентификатор));
		Возврат ПоместитьВоВременноеХранилище(Выборка.ВерсияДокумента,Новый УникальныйИдентификатор);	
	КонецЦикла;	                                             
КонецФункции

&НаКлиенте
Процедура СписокИсторииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.СписокИстории.ТекущиеДанные; 
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	АдресСериализованногоОбъекта = АдресСериализованногоОбъекта(ТекДанные.Период); 
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("Ссылка",Документ);
	ПараметрыДокумента.Вставить("ПоВерсии",Истина);
	ПараметрыДокумента.Вставить("АдресСериализованногоОбъекта",АдресСериализованногоОбъекта); 
	ПараметрыДокумента.Вставить("ДатаВерсии",ТекДанные.Период);
	ОткрытьФорму("РегистрСведений.ИсторияОповещенияВнешнегоПользователя.Форма.ОтчетПоВерсиямОбъекта",ПараметрыДокумента);
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПриИзменении(Элемент)
	ТекстОповещений = МодульУправленияОповещениямиУХ.ПолучитьТекстПоВидуСобытияПоШаблону(
			Оповещение,
			Документ);
КонецПроцедуры



#КонецОбласти 
