
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекущееЗначение = Неопределено;
	ВыбранныйТипОбъекта = Тип("СправочникСсылка.Номенклатура");
	Параметры.Свойство("ТекущееЗначение", ТекущееЗначение);
	Параметры.Свойство("ВыбранныйТипОбъекта", ВыбранныйТипОбъекта);
	ИнициализироватьСписокИзПараметров(ТекущееЗначение, ВыбранныйТипОбъекта);
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСписокИзПараметров(ТекущееЗначение, ВыбранныйТипОбъекта)
	Если ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		ПутьКСтавкеНДС = "Номенклатура.СтавкаНДС";
	Иначе
		ПутьКСтавкеНДС = "Номенклатура.ВидСтавкиНДС";
	КонецЕсли;
	Список.ТекстЗапроса = СтрЗаменить(
		Список.ТекстЗапроса, "&СтавкаНДС", ПутьКСтавкеНДС);
	Список.Параметры.УстановитьЗначениеПараметра("ТекущееЗначение", ТекущееЗначение);
	Если ВыбранныйТипОбъекта = Тип("СправочникСсылка.ТоварныеКатегории") Тогда
		Список.ОсновнаяТаблица = "";
		ТекстЗапроса = СтрЗаменить(
			Список.ТекстЗапроса, "Справочник.Номенклатура", "Справочник.ТоварныеКатегории");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И НЕ Номенклатура.ЭтоГруппа", "");
		Список.ТекстЗапроса = ТекстЗапроса;
		Список.ОсновнаяТаблица = "Справочник.ТоварныеКатегории";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	Если НЕ ИдентификацияПродуктаУХКлиентСервер.ЭтоЕХ() Тогда
		УправлениеЗакупкамиВстраиваниеПереопределяемыйУХ.УстановитьУсловноеОформлениеВидаСтавкиНДС(
			УсловноеОформление.Элементы,
			ОбщегоНазначения.ТекущаяДатаПользователя(),
			"Список.ВидСтавкиНДС",
			"ВидСтавкиНДС");
	КонецЕсли;
КонецПроцедуры
