
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Период, ГруппаПараметраРасчетаРезерва, ПараметрРасчетаРезервов");
	
	КэшируемыеЗначения = Новый Структура;
	КэшируемыеЗначения.Вставить("ТипыПараметровРасчетаРезерва", 
		МСФОВызовСервераУХ.ПолучитьСтруктуруСоЗначениямиПеречисления("ТипыПараметровРасчетаРезерва"));
		
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	ЗаписатьНаСервере();
	Оповестить("ОбновленыПризнакиРезервов");
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПараметрРасчетаРезервовПриИзменении(Элемент)

	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыФункции

&НаСервере
Процедура ЗаписатьНаСервере()
	
	СписокОбъектов = Новый СписокЗначений;
	
	ТипПараметраРасчетаРезервов = ТипПараметраРасчетаРезервов(ПараметрРасчетаРезервов);
	Если (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоКонтрагенту) Тогда
		СписокОбъектов = СписокКонтрагенты;
	ИначеЕсли (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоБанку) Тогда
		СписокОбъектов = СписокБанки;
	ИначеЕсли (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоДоговору) Тогда
		СписокОбъектов = СписокДоговоры;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Для каждого ОбъектСписка Из СписокОбъектов Цикл
	
		нз = РегистрыСведений.ПризнакиЗадолженности.СоздатьНаборЗаписей();
		нз.Отбор.Период.Установить(Период);
		нз.Отбор.Объект.Установить(ОбъектСписка.Значение);
		нз.Отбор.ПараметрРасчетаРезервов.Установить(ПараметрРасчетаРезервов);
		
		нз.Прочитать();
		
		нз.Очистить();
		
		Запись = нз.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ЭтаФорма);
		Запись.Объект = ОбъектСписка.Значение;
		Запись.ГруппаПризнака = ГруппаПараметраРасчетаРезерва;
		
		нз.Записать();
	
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Элементы = Форма.Элементы;
	КэшируемыеЗначения = Форма.КэшируемыеЗначения;
	
	ТипПараметраРасчетаРезервов = ТипПараметраРасчетаРезервов(Форма.ПараметрРасчетаРезервов);
	Если (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоКонтрагенту) Тогда
		
		Элементы.СтраницаКонтрагенты.Видимость = Истина;
		Элементы.СтраницаДоговоры.Видимость = Ложь;
		Элементы.СтраницаБанки.Видимость = Ложь;
		Элементы.ФормаЗаписать.Доступность = Истина;
				
	ИначеЕсли (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоДоговору) Тогда
				
		Элементы.СтраницаКонтрагенты.Видимость = Ложь;
		Элементы.СтраницаДоговоры.Видимость = Истина;
		Элементы.СтраницаБанки.Видимость = Ложь;
		Элементы.ФормаЗаписать.Доступность = Истина;
		
	ИначеЕсли (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.ПоБанку) Тогда
				
		Элементы.СтраницаКонтрагенты.Видимость = Ложь;
		Элементы.СтраницаДоговоры.Видимость = Ложь;
		Элементы.СтраницаБанки.Видимость = Истина;
		Элементы.ФормаЗаписать.Доступность = Истина;

	ИначеЕсли (ТипПараметраРасчетаРезервов = КэшируемыеЗначения.ТипыПараметровРасчетаРезерва.Вычисляемый) Тогда
		
		Элементы.СтраницаКонтрагенты.Видимость = Ложь;
		Элементы.СтраницаДоговоры.Видимость = Ложь;
		Элементы.СтраницаБанки.Видимость = Ложь;
		Элементы.ФормаЗаписать.Доступность = Ложь;
				
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипПараметраРасчетаРезервов(ПараметрРасчетаРезервов)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПараметрРасчетаРезервов, "ТипПараметраРасчетаРезервов");

КонецФункции

#КонецОбласти