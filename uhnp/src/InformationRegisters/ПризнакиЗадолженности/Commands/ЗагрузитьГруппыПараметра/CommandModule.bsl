
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ИмяТЧ = "РегистрСведений.ПризнакиЗадолженности";
	
	ДопПараметры = Новый Структура("ИмяОбъекта, ИмяТЧ, ИсточникКолонок",
									ИмяТЧ, ИмяТЧ, "НЗ");

	Отбор = Неопределено;
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ПараметрыРасчетаРезервовПоДЗ") Тогда
		Отбор = Новый Структура("ПараметрРасчетаРезервов", ПараметрКоманды);
	КонецЕсли;
	
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДопПараметры);
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("ОписаниеКоманды",	ОписаниеКоманды);
	ПараметрыЗагрузки.Вставить("Форма",				ПараметрыВыполненияКоманды.Источник);
	ПараметрыЗагрузки.Вставить("Объект",			ПараметрКоманды);
	ПараметрыЗагрузки.Вставить("Отбор",				Отбор);
	ПараметрыЗагрузки.Вставить("ОтборыТипов",		ВстраиваниеУХКлиентСервер.ПустыеОтборыТипов());
	ПараметрыЗагрузки.Вставить("ПропуститьПроверкуЗагрузки",	Истина);
	
	МСФОКлиентУХ.ЗагрузкаДанных_Подключаемый(ПараметрКоманды, ПараметрыЗагрузки);

КонецПроцедуры
