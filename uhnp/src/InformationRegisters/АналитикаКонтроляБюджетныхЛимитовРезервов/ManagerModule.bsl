#Область ОбработчикиОбновления

Процедура ЗаменитьПредназначениеИПериодЛимитирования() Экспорт
	
	Предназначения = Новый Соответствие;
	Предназначения.Вставить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДвиженияДенежныхСредств, 
		ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	Предназначения.Вставить(Перечисления.ПредназначенияЭлементовСтруктурыОтчета.БюджетДоходовИРасходов, 
		ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Коллекция.Ссылка КАК Ссылка,
	|	Коллекция.ВидБюджета КАК ВидБюджета,
	|	Коллекция.УдалитьПредназначение КАК УдалитьПредназначение,
	|	Коллекция.УдалитьПериодЛимитирования КАК УдалитьПериодЛимитирования,
	|	Коллекция.УдалитьПериодЛимитирования.ДатаНачала КАК УдалитьПериодЛимитированияДатаНачала,
	|	Коллекция.УдалитьПериодЛимитирования.Периодичность КАК УдалитьПериодЛимитированияПериодичность,
	|	Коллекция.ПериодичностьКонтроля КАК ПериодичностьКонтроля,
	|	Коллекция.НачалоПериодаКонтроля КАК НачалоПериодаКонтроля
	|ИЗ
	|	Справочник.КлючиКонтроляБюджетныхЛимитовРезервов КАК Коллекция
	|ГДЕ
	|	(Коллекция.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|				И Коллекция.УдалитьПредназначение <> ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|			ИЛИ Коллекция.УдалитьПериодЛимитирования <> ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)
	|				И (Коллекция.ПериодичностьКонтроля = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|					ИЛИ Коллекция.НачалоПериодаКонтроля = ДАТАВРЕМЯ(1, 1, 1)))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Коллекция.ВидБюджета КАК ВидБюджета,
	|	Коллекция.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов,
	|	Коллекция.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры,
	|	Коллекция.ДокументРезервирования КАК ДокументРезервирования,
	|	Коллекция.НачалоПериодаКонтроля КАК НачалоПериодаКонтроля,
	|	Коллекция.ПериодичностьКонтроля КАК ПериодичностьКонтроля,
	|	Коллекция.УдалитьПредназначение КАК УдалитьПредназначение,
	|	Коллекция.УдалитьПериодЛимитирования КАК УдалитьПериодЛимитирования,
	|	Коллекция.КлючАналитики КАК КлючАналитики,
	|	Коллекция.УдалитьПериодЛимитирования.ДатаНачала КАК УдалитьПериодЛимитированияДатаНачала,
	|	Коллекция.УдалитьПериодЛимитирования.Периодичность КАК УдалитьПериодЛимитированияПериодичность
	|ИЗ
	|	РегистрСведений.УдалитьАналитикаКонтроляБюджетныхЛимитовРезервов КАК Коллекция
	|ГДЕ
	|	(Коллекция.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
	|				И Коллекция.УдалитьПредназначение <> ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|			ИЛИ Коллекция.УдалитьПериодЛимитирования <> ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)
	|				И (Коллекция.ПериодичностьКонтроля = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
	|					ИЛИ Коллекция.НачалоПериодаКонтроля = ДАТАВРЕМЯ(1, 1, 1)))";
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Справочник
	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если ЗначениеЗаполнено(Выборка.УдалитьПредназначение) И НЕ ЗначениеЗаполнено(Выборка.ВидБюджета) Тогда
			Объект.ВидБюджета = Предназначения[Выборка.УдалитьПредназначение];
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.УдалитьПериодЛимитирования) И 
			(НЕ ЗначениеЗаполнено(Выборка.ПериодичностьКонтроля) ИЛИ НЕ ЗначениеЗаполнено(Выборка.НачалоПериодаКонтроля)) Тогда
			Объект.ПериодичностьКонтроля = Выборка.УдалитьПериодЛимитированияПериодичность;
			Объект.НачалоПериодаКонтроля = Выборка.УдалитьПериодЛимитированияДатаНачала;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		
	КонецЦикла;
	
	// Регистр сведений
	Измерения = Новый Структура("АналитикаПланированияСтатейБюджетов, АналитикаПланированияСтруктуры, ДокументРезервирования, УдалитьПредназначение, УдалитьПериодЛимитирования");
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьАналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьНаборЗаписей();
		Для Каждого КлючЗначение Из Измерения Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(Выборка[КлючЗначение.Ключ]);
		КонецЦикла;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = НаборЗаписей[0];
		Если ЗначениеЗаполнено(Выборка.УдалитьПредназначение) И НЕ ЗначениеЗаполнено(Выборка.ВидБюджета) Тогда
			Запись.ВидБюджета = Предназначения[Выборка.УдалитьПредназначение];
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.УдалитьПериодЛимитирования) И 
			(НЕ ЗначениеЗаполнено(Выборка.ПериодичностьКонтроля) ИЛИ НЕ ЗначениеЗаполнено(Выборка.НачалоПериодаКонтроля)) Тогда
			Запись.ПериодичностьКонтроля = Выборка.УдалитьПериодЛимитированияПериодичность;
			Запись.НачалоПериодаКонтроля = Выборка.УдалитьПериодЛимитированияДатаНачала;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи) Экспорт

	Шаблон = НСтр("ru = '%1, %2 с %3, %4, %5, %6'");
	
	Возврат СтрШаблон(Шаблон, СокрЛП(МенеджерЗаписи.ВидБюджета), СокрЛП(МенеджерЗаписи.ПериодичностьКонтроля), Формат(МенеджерЗаписи.НачалоПериодаКонтроля, "ДЛФ=D"),
		СокрЛП(МенеджерЗаписи.АналитикаПланированияСтатейБюджетов), СокрЛП(МенеджерЗаписи.АналитикаПланированияСтруктуры),
		СокрЛП(МенеджерЗаписи.ДокументРезервирования));
	
КонецФункции

// Функция получает элемент справочника - ключ аналитики контроля бюджетных лимитов/резервов.
//
// Параметры:
//	ПараметрыАналитики - Выборка, Структура - Содержит полями "ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов,АналитикаПланированияСтруктуры,ДокументРезервирования":
//		* ВидБюджета - ПланВидовХарактеристикСсылка.ВидыБюджетов.
//		* ПериодичностьКонтроля - ПеречислениеСсылка.Периодичность.
//		* НачалоПериодаКонтроля - Дата
//		* АналитикаПланированияСтатейБюджетов - Справочник.АналитикаПланированияСтатейБюджетов.
//		* АналитикаПланированияСтруктуры - Справочник.КлючиАналитикиПланированияСтруктуры.
//		* ДокументРезервирования - ОпределяемыеТипы.ОбъектыПланирования
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиКонтроляБюджетныхЛимитовРезервов - Созданный элемент справочника.
//
Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

	НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0
			И Не ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			Результат = НаборЗаписей[0].КлючАналитики;
		Иначе
			Результат = СоздатьКлючАналитики(ПараметрыАналитики);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

КонецФункции

// Функция получает элемент справочника - ключ аналитики контроля бюджетных лимитов/резервов.
//
// Параметры:
//	ПараметрыАналитики - Выборка или Структура  с полями "ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов,АналитикаПланированияСтруктуры,ДокументРезервирования".
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиКонтроляБюджетныхЛимитовРезервов - Созданный элемент справочника.
//
Функция СоздатьКлючАналитики(ПараметрыАналитики, ЗаписьПриОбновленииИБ = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ПараметрыАналитики.ВидБюджета) 
			И ЗначениеЗаполнено(ПараметрыАналитики.ПериодичностьКонтроля)
			И ЗначениеЗаполнено(ПараметрыАналитики.НачалоПериодаКонтроля)
			И ЗначениеЗаполнено(ПараметрыАналитики.АналитикаПланированияСтатейБюджетов)
			И ЗначениеЗаполнено(ПараметрыАналитики.АналитикаПланированияСтруктуры) Тогда
			
		НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
		
		Если НаборЗаписей <> Неопределено Тогда
			
			НачатьТранзакцию(); // Создание нового ключа аналитики.
			Попытка
				СтрокаНабора = НаборЗаписей[0];
				
				СправочникОбъект = Справочники.КлючиКонтроляБюджетныхЛимитовРезервов.СоздатьЭлемент();
				СправочникОбъект.Наименование = ПолучитьПолноеНаименованиеКлючаАналитики(СтрокаНабора);
				ЗаполнитьЗначенияСвойств(СправочникОбъект, СтрокаНабора, "ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов,АналитикаПланированияСтруктуры,ДокументРезервирования");
				Если ЗаписьПриОбновленииИБ Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
				Иначе
					СправочникОбъект.Записать();
				КонецЕсли;

				Результат = СправочникОбъект.Ссылка;

				СтрокаНабора.КлючАналитики = Результат;
				
				Если ЗаписьПриОбновленииИБ Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Ложь, Истина);
				Иначе
					НаборЗаписей.Записать(Ложь);
				КонецЕсли;
				ЗафиксироватьТранзакцию();
			Исключение
				// во время инициализации ключа, данный ключ уже был создан в ИБ другим сеансом.
				НаборЗаписей.Прочитать();
				Если НаборЗаписей.Количество() = 0 Тогда // запись не создана из-за ошибки заполнения полей.
					ОтменитьТранзакцию();
					ВызватьИсключение;
				Иначе
					ОтменитьТранзакцию();
					Результат = НаборЗаписей[0].КлючАналитики;
				КонецЕсли;
			КонецПопытки;

			Возврат Результат;
			
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Возвращает параметры генерации ключей аналитики. Используется в обработчиках обновления.
// Возвращаемое значение:
//	Структура - Структура содержит поля: ЕстьНеобработанныеКлючи, ИзмененаАналитика, СоздаватьНовыеКлючи.
Функция ПараметрыЗаполненияКлючейАналитики() Экспорт
	Возврат Новый Структура("ИзмененаАналитика,СоздаватьВКлючи", Ложь, Истина);
КонецФункции

// Заполняет поле АналитикаКонтроляБюджетныхЛимитовРезервов в коллекции, содержащей колонки ключа
//
// Параметры:
//
//	Коллекция - ТабличнаяЧасть - Коллекция, в которой производится заполнение аналитики контроля бюджетных лимитов/резервов.
//
//	ИменаПолей - Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля берется из имени ключа.
//		секция идентификации {ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов,АналитикаПланированияСтруктуры,ДокументРезервирования, АналитикаКонтроляБюджетныхЛимитовРезервов},
//	
//	ПараметрыЗаполнения - Структура - см. метод ПараметрыЗаполненияКлючейАналитики()
//
// Пример 1:
//	ИменаПолей = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.ИменаПолейКоллекцииПоУмолчанию();
//	РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.ЗаполнитьВКоллекции(ДвиженияОперации, ИменаПолей);
//
// Пример 2:
//	РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.ЗаполнитьВКоллекции(ДвиженияОперации);
//
Процедура ЗаполнитьВКоллекции(Коллекция, 
								ИменаПолей = Неопределено, ДополнитьКлюч = Ложь, ПараметрыЗаполнения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполненияКлючейАналитики();
	КонецЕсли;
	
	Если ДополнитьКлюч Тогда
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейДополненияКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
	Иначе
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.АналитикаКонтроляБюджетныхЛимитовРезервов) Тогда
			Если ПараметрыЗаполнения.СоздаватьВКлючи Тогда
				КлючАналитики = ЗначениеКлючаАналитики(Выборка);
			Иначе
				ТекстИсключения = НСтр("ru = 'Ошибка при заполнении ключей в коллекции: есть аналитики, по которым ключи еще не созданы.'");
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.КлючиКонтроляБюджетныхЛимитовРезервов,
					,
					ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		Иначе
			КлючАналитики = Выборка.АналитикаКонтроляБюджетныхЛимитовРезервов;
		КонецЕсли;
		Если ДополнитьКлюч Тогда
			Коллекция[Выборка.Индекс][ИменаПолей.ЗаполняемаяАналитикаКонтроляБюджетныхЛимитовРезервов] = КлючАналитики;
		Иначе
			Коллекция[Выборка.Индекс][ИменаПолей.АналитикаКонтроляБюджетныхЛимитовРезервов] = КлючАналитики;
		КонецЕсли;
		ПараметрыЗаполнения.ИзмененаАналитика = Истина;
	КонецЦикла;
КонецПроцедуры

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики контроля бюджетных лимитов/резервов.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля должно браться из имени ключа.
//		секция идентификации {ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов,АналитикаПланированияСтруктуры,ДокументРезервирования},
//			все ключи заданы.
//
Функция ИменаПолейКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("ВидБюджета", "ВидБюджета");
	ИменаПолей.Вставить("ПериодичностьКонтроля", "ПериодичностьКонтроля");
	ИменаПолей.Вставить("НачалоПериодаКонтроля", "НачалоПериодаКонтроля");
	ИменаПолей.Вставить("АналитикаПланированияСтатейБюджетов", "АналитикаПланированияСтатейБюджетов");
	ИменаПолей.Вставить("АналитикаПланированияСтруктуры", "АналитикаПланированияСтруктуры");
	ИменаПолей.Вставить("ДокументРезервирования", "ДокументРезервирования");
	ИменаПолей.Вставить("АналитикаКонтроляБюджетныхЛимитовРезервов", "АналитикаКонтроляБюджетныхЛимитовРезервов");
	
	Возврат ИменаПолей;
КонецФункции

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики контроля бюджетных лимитов/резервов.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//
Функция ИменаПолейДополненияКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("АналитикаКонтроляБюджетныхЛимитовРезервов", "АналитикаКонтроляБюджетныхЛимитовРезервов");
	ИменаПолей.Вставить("ЗаполняемаяАналитикаКонтроляБюджетныхЛимитовРезервов", "АналитикаКонтроляБюджетныхЛимитовРезервов");
	ИменаПолей.Вставить("ВидБюджета", "");
	ИменаПолей.Вставить("ПериодичностьКонтроля", "");
	ИменаПолей.Вставить("НачалоПериодаКонтроля", "");
	ИменаПолей.Вставить("АналитикаПланированияСтатейБюджетов", "");
	ИменаПолей.Вставить("АналитикаПланированияСтруктуры", "");
	ИменаПолей.Вставить("ДокументРезервирования", "");
	
	Возврат ИменаПолей;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	СтруктураАналитики = Новый Структура("ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов, АналитикаПланированияСтруктуры, ДокументРезервирования");
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики);
	Если НЕ ЗначениеЗаполнено(СтруктураАналитики.ВидБюджета)
	 ИЛИ НЕ ЗначениеЗаполнено(СтруктураАналитики.ПериодичностьКонтроля)
	 ИЛИ НЕ ЗначениеЗаполнено(СтруктураАналитики.НачалоПериодаКонтроля) Тогда
		Возврат Неопределено
	Иначе
		НаборЗаписей = РегистрыСведений.АналитикаКонтроляБюджетныхЛимитовРезервов.СоздатьНаборЗаписей();
		
		Для Каждого КлючЗначение Из СтруктураАналитики Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, "ВидБюджета, ПериодичностьКонтроля, НачалоПериодаКонтроля, АналитикаПланированияСтатейБюджетов, АналитикаПланированияСтруктуры, ДокументРезервирования");
		ПроверитьЗаполнениеПоляСтруктуры(НоваяСтрока);
		Возврат НаборЗаписей;
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьЗаполнениеПоляСтруктуры(МенеджерЗаписиАналитикаКонтроляБюджетныхЛимитовРезервов)

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК Индекс,
	|	&АналитикаКонтроляБюджетныхЛимитовРезервов КАК АналитикаКонтроляБюджетныхЛимитовРезервов,
	|	&ПолеВидБюджета КАК ВидБюджета,
	|	&ПолеПериодичностьКонтроля КАК ПериодичностьКонтроля,
	|	&ПолеНачалоПериодаКонтроля КАК НачалоПериодаКонтроля,
	|	&ПолеАналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов,
	|	&ПолеАналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры,
	|	&ПолеДокументРезервирования КАК ДокументРезервирования
	|ПОМЕСТИТЬ Коллекция
	|ИЗ
	|	&Коллекция КАК Коллекция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Коллекция.Индекс - 1 КАК Индекс,
	|	Аналитика.КлючАналитики КАК АналитикаКонтроляБюджетныхЛимитовРезервов,
	|	Коллекция.ВидБюджета КАК ВидБюджета,
	|	Коллекция.ПериодичностьКонтроля КАК ПериодичностьКонтроля,
	|	Коллекция.НачалоПериодаКонтроля КАК НачалоПериодаКонтроля,
	|	Коллекция.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов,
	|	Коллекция.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры,
	|	Коллекция.ДокументРезервирования КАК ДокументРезервирования
	|ИЗ
	|	Коллекция КАК Коллекция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаКонтроляБюджетныхЛимитовРезервов КАК Аналитика
	|		ПО (Аналитика.ВидБюджета = Коллекция.ВидБюджета)
	|			И (Аналитика.ПериодичностьКонтроля = Коллекция.ПериодичностьКонтроля)
	|			И (Аналитика.НачалоПериодаКонтроля = Коллекция.НачалоПериодаКонтроля)
	|			И (Аналитика.АналитикаПланированияСтатейБюджетов = Коллекция.АналитикаПланированияСтатейБюджетов)
	|			И (Аналитика.АналитикаПланированияСтруктуры = Коллекция.АналитикаПланированияСтруктуры)
	|			И (Аналитика.ДокументРезервирования = Коллекция.ДокументРезервирования)
	|ГДЕ
	|	(Аналитика.КлючАналитики ЕСТЬ NULL
	|			ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервов
	|			ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиКонтроляБюджетныхЛимитовРезервов.ПустаяСсылка))";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&АналитикаКонтроляБюджетныхЛимитовРезервов", "Коллекция." + ИменаПолей.АналитикаКонтроляБюджетныхЛимитовРезервов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВидБюджета", "Коллекция." + ИменаПолей.ВидБюджета);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПериодичностьКонтроля", "Коллекция." + ИменаПолей.ПериодичностьКонтроля);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНачалоПериодаКонтроля", "Коллекция." + ИменаПолей.НачалоПериодаКонтроля);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПланированияСтатейБюджетов", "Коллекция." + ИменаПолей.АналитикаПланированияСтатейБюджетов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПланированияСтруктуры", "Коллекция." + ИменаПолей.АналитикаПланированияСтруктуры);
	
	// Поле ДокументРезервирования может отсутствовать в таблице.
	Если ЗначениеЗаполнено(ИменаПолей.ДокументРезервирования) Тогда
		Если ТипЗнч(ИменаПолей.ДокументРезервирования) = Тип("Структура") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДокументРезервирования", ИменаПолей.ДокументРезервирования.ТекстПоля);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДокументРезервирования", "Коллекция." + ИменаПолей.ДокументРезервирования);
		КонецЕсли;  
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДокументРезервирования", "неопределено");
	КонецЕсли; 
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Коллекция.НомерСтроки - 1					КАК Индекс,
		|	&ПолеАналитика								КАК АналитикаКонтроляБюджетныхЛимитовРезервов,
		|	&ПолеПриемник								КАК АналитикаКонтроляБюджетныхЛимитовРезервовПриемник,
		|	&ПолеВидБюджета								КАК ВидБюджета,
		|	&ПолеПериодичностьКонтроля					КАК ПериодичностьКонтроля,
		|	&ПолеНачалоПериодаКонтроля					КАК НачалоПериодаКонтроля,
		|	&ПолеАналитикаПланированияСтатейБюджетов	КАК АналитикаПланированияСтатейБюджетов,
		|	&ПолеАналитикаПланированияСтруктуры 		КАК АналитикаПланированияСтруктуры,
		|	&ПолеДокументРезервирования					КАК ДокументРезервирования
		|ПОМЕСТИТЬ ВтКоллекция
		|ИЗ &Коллекция КАК Коллекция
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс					КАК Индекс,
		|	Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервов КАК АналитикаКонтроляБюджетныхЛимитовРезервов,
		|	Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервовПриемник КАК АналитикаКонтроляБюджетныхЛимитовРезервовПриемник,
		|	ВЫБОР КОГДА Коллекция.ВидБюджета = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.ВидБюджета, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.ВидБюджета
		|	КОНЕЦ                                КАК ВидБюджета,
		|	ВЫБОР КОГДА Коллекция.ПериодичностьКонтроля = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.ПериодичностьКонтроля, ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.ПериодичностьКонтроля
		|	КОНЕЦ                                КАК ПериодичностьКонтроля,
		|	ВЫБОР КОГДА Коллекция.НачалоПериодаКонтроля = ДАТАВРЕМЯ(1,1,1)
		|		ТОГДА ЕСТЬNULL(Аналитика.НачалоПериодаКонтроля, ДАТАВРЕМЯ(1,1,1))
		|		ИНАЧЕ Коллекция.НачалоПериодаКонтроля
		|	КОНЕЦ                                КАК НачалоПериодаКонтроля,
		
		|	ВЫБОР КОГДА Коллекция.АналитикаПланированияСтатейБюджетов = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаПланированияСтатейБюджетов, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтатейБюджетов.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.АналитикаПланированияСтатейБюджетов
		|	КОНЕЦ                                КАК АналитикаПланированияСтатейБюджетов,
		|	ВЫБОР КОГДА Коллекция.АналитикаПланированияСтруктуры = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка)
		|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаПланированияСтруктуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка))
		|		ИНАЧЕ Коллекция.АналитикаПланированияСтруктуры
		|	КОНЕЦ                                КАК АналитикаПланированияСтруктуры,
		|	ВЫБОР КОГДА Коллекция.ДокументРезервирования = неопределено
		|		ТОГДА ЕСТЬNULL(Аналитика.ДокументРезервирования, неопределено)
		|		ИНАЧЕ Коллекция.ДокументРезервирования
		|	КОНЕЦ                                КАК ДокументРезервирования
		|ПОМЕСТИТЬ Коллекция
		|ИЗ
		|	ВтКоллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаКонтроляБюджетныхЛимитовРезервов КАК Аналитика
		|	ПО Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервов = Аналитика.КлючАналитики
		|;
		|ВЫБРАТЬ
		|	Коллекция.Индекс КАК Индекс,
		|	Ключи.КлючАналитики КАК АналитикаКонтроляБюджетныхЛимитовРезервов,
		|	Коллекция.ВидБюджета КАК ВидБюджета,
		|	Коллекция.ПериодичностьКонтроля КАК ПериодичностьКонтроля,
		|	Коллекция.НачалоПериодаКонтроля КАК НачалоПериодаКонтроля,
		|	Коллекция.АналитикаПланированияСтатейБюджетов КАК АналитикаПланированияСтатейБюджетов,
		|	Коллекция.АналитикаПланированияСтруктуры КАК АналитикаПланированияСтруктуры,
		|	Коллекция.ДокументРезервирования КАК ДокументРезервирования
		|ИЗ
		|	Коллекция КАК Коллекция
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаКонтроляБюджетныхЛимитовРезервов КАК Ключи
		|	ПО Ключи.ВидБюджета = Коллекция.ВидБюджета
		|		И Ключи.ПериодичностьКонтроля = Коллекция.ПериодичностьКонтроля
		|		И Ключи.НачалоПериодаКонтроля = Коллекция.НачалоПериодаКонтроля
		|		И Ключи.АналитикаПланированияСтатейБюджетов = Коллекция.АналитикаПланированияСтатейБюджетов
		|		И Ключи.АналитикаПланированияСтруктуры = Коллекция.АналитикаПланированияСтруктуры
		|		И Ключи.ДокументРезервирования = Коллекция.ДокументРезервирования
		|ГДЕ
		|	Ключи.КлючАналитики ЕСТЬ NULL
		|	ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервов
		|	ИЛИ Коллекция.АналитикаКонтроляБюджетныхЛимитовРезервовПриемник = ЗНАЧЕНИЕ(Справочник.КлючиКонтроляБюджетныхЛимитовРезервов.ПустаяСсылка)";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаКонтроляБюджетныхЛимитовРезервов);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаКонтроляБюджетныхЛимитовРезервов);
