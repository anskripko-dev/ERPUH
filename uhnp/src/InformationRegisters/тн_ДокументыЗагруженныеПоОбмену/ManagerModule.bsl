//Процедура ЗарегистрироватьДокументКакЗагруженный(Документ,Организация = Неопределено,ДатаДокумента  = Неопределено) Экспорт
//Процедура ЗарегистрироватьДокументКакЗагруженный(Документ, Организация = Неопределено, ДатаДокумента  = Неопределено, ИДСообщения = "") Экспорт
Процедура ЗарегистрироватьДокументКакЗагруженный(Документ, Организация = Неопределено, ДатаДокумента  = Неопределено, ИДСообщения = "",ИсходнаяОрганизация = Неопределено) Экспорт
		
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.тн_ДокументыЗагруженныеПоОбмену.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ 	         = Документ; 
	// НАЧАЛО Егоров Петр 10.06.2025 Выполнение задач №000054028
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		МенеджерЗаписи.Организация 	         = Организация; 
		МенеджерЗаписи.ДатаДокумента 	         = ДатаДокумента; 
	КонецЕсли;
	// КОНЕЦ Егоров Петр 10.06.2025 Выполнение задач №000054028
	// НАЧАЛО Егоров Петр 05.02.2026 Выполнение задач №000056658
	 Если ЗначениеЗаполнено(ИсходнаяОрганизация) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		МенеджерЗаписи.ИсходнаяОрганизация 	         = ИсходнаяОрганизация; 
	КонецЕсли;
	// КОНЕЦ Егоров Петр 05.02.2026 Выполнение задач №000056658
	//НАЧАЛО Блинова М.А. 29.04.2026 Выполнение задач №000057501
	//МенеджерЗаписи.ДатаПоследнейЗагрузки = тн_Интеграция_УПП.ТекущаяДатаСервера();   
	МенеджерЗаписи.ДатаПоследнейЗагрузки = ТекущаяДатаСервера();
	//КОНЕЦ Блинова М.А. 29.04.2026 Выполнение задач №000057501
	// НАЧАЛО Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	МенеджерЗаписи.ИДСообщения = ИДСообщения;
	// КОНЕЦ Чекордина Ирина 10.12.2025 Выполнение задач №000056084
	
	МенеджерЗаписи.Записать(Истина);
		
КонецПроцедуры // ЗарегистрироватьДокументКакЗагруженный()

// Белоконенко Денис 21.11.2025 Выполнение задач №000055912 
Функция ЭтоДокументЗагруженныйПоОбмену(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗагруженныйПоОбмену = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_ДокументыЗагруженныеПоОбмену.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.тн_ДокументыЗагруженныеПоОбмену КАК тн_ДокументыЗагруженныеПоОбмену
		|ГДЕ
		|	тн_ДокументыЗагруженныеПоОбмену.Документ = &ДокументСсылка";
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗагруженныйПоОбмену = Истина;
	КонецЕсли;
	
	Возврат ЗагруженныйПоОбмену;
	
КонецФункции

