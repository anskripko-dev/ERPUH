#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
// Возвращает сумму малых закупок для организации ОрганизацияВход
// в периоде ПериодВход. Когда ПериодВход не указан, возвращает на
// текущую дату.
Функция ПолучитьСуммуМалыхЗакупок(ОрганизацияВход, ПериодВход = Неопределено) Экспорт 
	РезультатФункции = 0;
	ТекДата = ТекущаяДатаСеанса();
	ПериодРабочий = ТекДата;
	Если ПериодВход = Неопределено Тогда
		ПериодРабочий = ТекДата;
	Иначе
		ПериодРабочий = ПериодВход;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	МалыеЗакупкиСрезПоследних.Организация КАК Организация,
		|	МалыеЗакупкиСрезПоследних.Сумма КАК Сумма
		|ИЗ
		|	РегистрСведений.МалыеЗакупки.СрезПоследних(&Период, ) КАК МалыеЗакупкиСрезПоследних
		|ГДЕ
		|	МалыеЗакупкиСрезПоследних.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", ОрганизацияВход);
	Запрос.УстановитьПараметр("Период", ПериодРабочий);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатФункции = ВыборкаДетальныеЗаписи.Сумма;
	КонецЦикла;
	Возврат РезультатФункции;
КонецФункции		 //	ПолучитьСуммуМалыхЗакупок()

// Устанавливает в регистр Малые закупки значение СуммаВход по организации
// ОрганизацияВход. Когда параметр ПериодВход указан, устанавливает на этот период,
// в противном случае - на текущую дату.
Процедура ЗаписатьСуммуМалыхЗакупок(ОрганизацияВход, СуммаВход, ПериодВход = Неопределено) Экспорт
	ТекДата = ТекущаяДатаСеанса();
	ПериодРабочий = ТекДата;
	Если ПериодВход = Неопределено Тогда
		ПериодРабочий = ТекДата;
	Иначе
		ПериодРабочий = ПериодВход;
	КонецЕсли;
	Попытка
		НаборЗаписей = РегистрыСведений.МалыеЗакупки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ОрганизацияВход); 
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.Период		 = ПериодРабочий;
		НоваяЗапись.Организация	 = ОрганизацияВход; 
		НоваяЗапись.Сумма		 = СуммаВход; 
		НаборЗаписей.Записать(); 
	Исключение
		ТекстСообщения = НСтр("ru = 'При установке размера малых закупок для организации %Организация% произошли ошибки: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Строка(ОрганизацияВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
КонецПроцедуры		// ЗаписатьСуммуМалыхЗакупок()

#КонецЕсли