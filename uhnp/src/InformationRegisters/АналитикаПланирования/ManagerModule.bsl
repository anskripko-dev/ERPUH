#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	ИменаРеквизитов = "Этап, ОбъектПланирования,АналитикаСтатейБюджетовПоставки, АналитикаСтруктуры, АналитикаНоменклатуры, АналитикаПотребностей, АналитикаПоставки, УсловиеОплаты, Цена, Валюта, ДатаОперации, АналитикаСтатейБюджетов";
	
	СтруктураАналитики = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики); 
	
	НаборЗаписей = ИнформацияОКлюче().РегистрМенеджер.СоздатьНаборЗаписей();
	Для Каждого КлючЗначение Из СтруктураАналитики Цикл
		НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
	КонецЦикла;
	
	НоваяСтрока = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, ИменаРеквизитов);
	ПроверитьЗаполнениеПолей(НоваяСтрока);
	Возврат НаборЗаписей;
	
КонецФункции

Процедура ПроверитьЗаполнениеПолей(МенеджерЗаписи)
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки - 1 КАК Индекс,
	|	&ПолеАналитикаПланирования КАК АналитикаПланирования,
	|	&ПолеЭтап КАК Этап,
	|	&ПолеОбъектПланирования КАК ОбъектПланирования,
	|	&ПолеАналитикаСтруктуры КАК АналитикаСтруктуры,
	|	&ПолеАналитикаПотребностей КАК АналитикаПотребностей,
	|	&ПолеАналитикаПоставки КАК АналитикаПоставки,
	|	&ПолеАналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	&ПолеУсловиеОплаты КАК УсловиеОплаты,
	|	&ПолеЦена КАК Цена,
	|	&ПолеВалюта КАК Валюта,
	|	&ПолеДатаОперации КАК ДатаОперации,
	|	&ПолеАналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,    
	|	&ПолеАналитикаСтатейБюджетовПоставки КАК АналитикаСтатейБюджетовПоставки
	|ПОМЕСТИТЬ Коллекция
	|ИЗ
	|	&Коллекция КАК Коллекция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Коллекция.Индекс КАК Индекс,
	|	Аналитика.КлючАналитики КАК АналитикаПланирования,
	|	Коллекция.Этап КАК Этап,
	|	Коллекция.ОбъектПланирования КАК ОбъектПланирования,
	|	Коллекция.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Коллекция.АналитикаПотребностей КАК АналитикаПотребностей,
	|	Коллекция.АналитикаПоставки КАК АналитикаПоставки,
	|	Коллекция.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	Коллекция.УсловиеОплаты КАК УсловиеОплаты,
	|	Коллекция.Цена КАК Цена,
	|	Коллекция.Валюта КАК Валюта,
	|	Коллекция.ДатаОперации КАК ДатаОперации,
	|	Коллекция.АналитикаСтатейБюджетов КАК АналитикаСтатейБюджетов,
	|	Коллекция.АналитикаСтатейБюджетовПоставки КАК АналитикаСтатейБюджетовПоставки	
	|ИЗ
	|	Коллекция КАК Коллекция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланирования КАК Аналитика
	|		ПО (Аналитика.Этап = Коллекция.Этап)
	|			И (Аналитика.ОбъектПланирования = Коллекция.ОбъектПланирования)
	|			И (Аналитика.АналитикаСтруктуры = Коллекция.АналитикаСтруктуры)
	|			И (Аналитика.АналитикаПотребностей = Коллекция.АналитикаПотребностей)
	|			И (Аналитика.АналитикаПоставки = Коллекция.АналитикаПоставки)
	|			И (Аналитика.АналитикаНоменклатуры = Коллекция.АналитикаНоменклатуры)
	|			И (Аналитика.УсловиеОплаты = Коллекция.УсловиеОплаты)
	|			И (Аналитика.Цена = Коллекция.Цена)
	|			И (Аналитика.Валюта = Коллекция.Валюта)
	|			И (Аналитика.ДатаОперации = Коллекция.ДатаОперации)
	|			И (Аналитика.АналитикаСтатейБюджетов = Коллекция.АналитикаСтатейБюджетов) 
	|			И (Аналитика.АналитикаСтатейБюджетовПоставки = Коллекция.АналитикаСтатейБюджетовПоставки)
	|ГДЕ
	|	(Аналитика.КлючАналитики ЕСТЬ NULL
	|			ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаПланирования
	|			ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка))";

	Инфо = ИнформацияОКлюче();
	Для Каждого КлючЗначение Из Инфо.Измерения Цикл
		Измерение = КлючЗначение.Значение;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Поле"+Измерение.Имя, 	"Коллекция." + ИменаПолей[Измерение.Имя]);
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Поле"+Инфо.ИмяПоляАналитика, 	"Коллекция." + ИменаПолей[Инфо.ИмяПоляАналитика]);
	
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Коллекция.НомерСтроки - 1	КАК Индекс,
	|	&ПолеАналитика			 	КАК АналитикаПланирования,
	|	&ПолеПриемник				КАК АналитикаПланированияПриемник,
	|	&ПолеЭтап					КАК Этап,
	|	&ПолеОбъектПланирования		КАК ОбъектПланирования,
	|	&ПолеАналитикаСтруктуры		КАК АналитикаСтруктуры,
	|	&ПолеАналитикаПотребностей	КАК АналитикаПотребностей,
	|	&ПолеАналитикаПоставки		КАК АналитикаПоставки,
	|	&ПолеАналитикаНоменклатуры	КАК АналитикаНоменклатуры,
	|	&ПолеУсловиеОплаты			КАК УсловиеОплаты,
	|	&ПолеЦена					КАК Цена,
	|	&ПолеВалюта 				КАК Валюта,
	|	&ПолеДатаОперации			КАК ДатаОперации
	|ПОМЕСТИТЬ ВтКоллекция
	|ИЗ &Коллекция КАК Коллекция
	|;
	|ВЫБРАТЬ
	|	Коллекция.Индекс						КАК Индекс,
	|	Коллекция.АналитикаПланирования			КАК АналитикаПланирования,
	|	Коллекция.АналитикаПланированияПриемник	КАК АналитикаПланированияПриемник,
	|	ВЫБОР КОГДА Коллекция.Этап = ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.Этап, ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.Этап
	|	КОНЕЦ КАК Этап,
	|	ВЫБОР КОГДА Коллекция.ОбъектПланирования = ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.ОбъектПланирования, ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.ОбъектПланирования
	|	КОНЕЦ КАК ОбъектПланирования,
	|	ВЫБОР КОГДА Коллекция.АналитикаСтруктуры = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаСтруктуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.АналитикаСтруктуры
	|	КОНЕЦ КАК АналитикаСтруктуры,
	|	ВЫБОР КОГДА Коллекция.АналитикаПотребностей = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаПотребностей, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.АналитикаПотребностей
	|	КОНЕЦ КАК АналитикаПотребностей,
	|	ВЫБОР КОГДА Коллекция.АналитикаПоставки = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаПоставки, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.АналитикаПоставки
	|	КОНЕЦ КАК АналитикаПоставки,
	|	ВЫБОР КОГДА Коллекция.АналитикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.АналитикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.АналитикаНоменклатуры
	|	КОНЕЦ КАК АналитикаНоменклатуры,
	|	ВЫБОР КОГДА Коллекция.УсловиеОплаты = &ПустоеУсловиеОплаты
	|		ТОГДА ЕСТЬNULL(Аналитика.УсловиеОплаты, &ПустоеУсловиеОплаты)
	|		ИНАЧЕ Коллекция.УсловиеОплаты
	|	КОНЕЦ КАК УсловиеОплаты,
	|	ВЫБОР КОГДА Коллекция.Цена = 0
	|		ТОГДА ЕСТЬNULL(Аналитика.Цена, 0)
	|		ИНАЧЕ Коллекция.Цена
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР КОГДА Коллекция.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(Аналитика.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|		ИНАЧЕ Коллекция.Валюта
	|	КОНЕЦ КАК Валюта,   
	|	ВЫБОР КОГДА Коллекция.ДатаОперации = ДАТАВРЕМЯ(1,1,1,0,0,0)
	|		ТОГДА ЕСТЬNULL(Аналитика.ДатаОперации, ДАТАВРЕМЯ(1,1,1,0,0,0))
	|		ИНАЧЕ Коллекция.ДатаОперации
	|	КОНЕЦ КАК ДатаОперации
	|ПОМЕСТИТЬ Коллекция
	|ИЗ
	|	ВтКоллекция КАК Коллекция
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланирования КАК Аналитика
	|	ПО Коллекция.АналитикаПланирования = Аналитика.КлючАналитики
	|;
	|ВЫБРАТЬ
	|	Коллекция.Индекс КАК Индекс,
	|	Ключи.КлючАналитики КАК АналитикаПланирования,
	|	Коллекция.Этап КАК Этап,
	|	Коллекция.ОбъектПланирования КАК ОбъектПланирования,
	|	Коллекция.АналитикаСтруктуры КАК АналитикаСтруктуры,
	|	Коллекция.АналитикаПотребностей КАК АналитикаПотребностей,
	|	Коллекция.АналитикаПоставки КАК АналитикаПоставки,
	|	Коллекция.АналитикаНоменклатуры КАК АналитикаНоменклатуры,
	|	Коллекция.УсловиеОплаты КАК УсловиеОплаты,
	|	Коллекция.Цена КАК Цена,
	|	Коллекция.Валюта КАК Валюта,
	|	Коллекция.ДатаОперации КАК ДатаОперации
	|ИЗ
	|	Коллекция КАК Коллекция
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПланирования КАК Ключи
	|	ПО Ключи.Этап = Коллекция.Этап
	|		И Ключи.ОбъектПланирования = Коллекция.ОбъектПланирования
	|		И Ключи.АналитикаСтруктуры = Коллекция.АналитикаСтруктуры
	|		И Ключи.АналитикаПотребностей = Коллекция.АналитикаПотребностей
	|		И Ключи.АналитикаПоставки = Коллекция.АналитикаПоставки
	|		И Ключи.АналитикаНоменклатуры = Коллекция.АналитикаНоменклатуры
	|		И Ключи.УсловиеОплаты = Коллекция.УсловиеОплаты
	|		И Ключи.Цена = Коллекция.Цена
	|		И Ключи.Валюта = Коллекция.Валюта
	|		И Ключи.ДатаОперации = Коллекция.ДатаОперации
	|ГДЕ
	|	Ключи.КлючАналитики ЕСТЬ NULL
	|	ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаПланирования
	|	ИЛИ Коллекция.АналитикаПланированияПриемник = ЗНАЧЕНИЕ(Справочник.КлючиАналитикПланирования.ПустаяСсылка)";
	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустоеУсловиеОплаты", КэшируемыеПроцедурыОПК.ПустоеУсловиеОплатыСтрокой());
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаПланирования);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаПланирования);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЭтап",
		?(ЗначениеЗаполнено(ИменаПолей.Этап), "Коллекция." + ИменаПолей.Этап, "ЗНАЧЕНИЕ(Перечисление.ЭтапыПланированияПотребностей.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОбъектПланирования",
		?(ЗначениеЗаполнено(ИменаПолей.ОбъектПланирования), "Коллекция." + ИменаПолей.ОбъектПланирования, "ЗНАЧЕНИЕ(Справочник.ОбъектыПланирования.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаСтруктуры",
		?(ЗначениеЗаполнено(ИменаПолей.АналитикаСтруктуры), "Коллекция." + ИменаПолей.АналитикаСтруктуры, "ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияСтруктуры.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПотребностей",
		?(ЗначениеЗаполнено(ИменаПолей.АналитикаПотребностей), "Коллекция." + ИменаПолей.АналитикаПотребностей, "ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПотребностей.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПоставки",
		?(ЗначениеЗаполнено(ИменаПолей.АналитикаПоставки), "Коллекция." + ИменаПолей.АналитикаПоставки, "ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияПоставки.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаНоменклатуры",
		?(ЗначениеЗаполнено(ИменаПолей.АналиткаНоменклатуры), "Коллекция." + ИменаПолей.АналиткаНоменклатуры, "ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПланированияНоменклатуры.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеУсловиеОплаты",
		?(ЗначениеЗаполнено(ИменаПолей.УсловиеОплаты), "Коллекция." + ИменаПолей.УсловиеОплаты, КэшируемыеПроцедурыОПК.ПустоеУсловиеОплатыСтрокой()));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦена",
		?(ЗначениеЗаполнено(ИменаПолей.Цена), "Коллекция." + ИменаПолей.Цена, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВалюта",
		?(ЗначениеЗаполнено(ИменаПолей.Валюта), "Коллекция." + ИменаПолей.Валюта, "ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДатаОперации",
		?(ЗначениеЗаполнено(ИменаПолей.ДатаОперации), "Коллекция." + ИменаПолей.ДатаОперации, "ДАТАВРЕМЯ(1,1,1,0,0,0)"));
	
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти

