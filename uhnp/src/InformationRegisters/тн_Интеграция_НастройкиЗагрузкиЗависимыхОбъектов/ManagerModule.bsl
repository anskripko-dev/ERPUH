Процедура ДобавитьНастройку_РеализацияОтгруженныхТоваров_shipmentDocumentGuid(Параметры = Неопределено) Экспорт
	
	НаборЗаписей = РегистрыСведений.тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов.СоздатьНаборЗаписей(); 
	НаборЗаписей.Прочитать(); 
	
	// ожидаемый вид - Документ.РеализацияТоваровУслуг
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ВидДокумента = "Документ.РеализацияОтгруженныхТоваров"; 
	НоваяЗапись.ПутьКРеквизиту =  "shipmentDocumentGuid";
	
	ТаблицаПроверкиДублей = НаборЗаписей.Выгрузить();
	ТаблицаПроверкиДублей.Свернуть("ВидДокумента, ПутьКРеквизиту"); 
	НаборЗаписей.Загрузить(ТаблицаПроверкиДублей);
	
	Попытка
		НаборЗаписей.Записать(); 
	Исключение
		ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.РегистрыСведений.тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов,,
			"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_Интеграция_НастройкиЗагрузкиЗависимыхОбъектов.ДобавитьНастройку_РеализацияОтгруженныхТоваров_shipmentDocumentGuid: " 
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры // ДобавитьНастройку_РеализацияОтгруженныхТоваров_shipmentDocumentGuid()

