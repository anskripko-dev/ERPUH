#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	Если ЭтотОбъект.Количество() = 0 Тогда 
		ЭтотОбъект.Прочитать();		
		ИдентификаторПроцедуры = Новый УникальныйИдентификатор();
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторПроцедуры);
		ПараметрыВыполнения.Вставить("ЗапуститьВФоне", Истина);
		ПараметрыВыполнения.Вставить("ОжидатьЗавершение", 0);
		
		ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
			"РегистрыСведений.ПравилаЗапретаОпераций.ПроверитьПравилаЗапретаОпераций",
			ЭтотОбъект.Выгрузить(), Истина);  
		ЭтотОбъект.Очистить();
	КонецЕсли;	
	
	// Проверим ввод хотя бы одного запрета.
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		Если (НЕ ТекЗапись.ЗапретПлатежей) И (Не ТекЗапись.ЗапретОтгрузки) Тогда
			ТекстСообщения = НСтр("ru = 'Требуется указать один из двух запретов перез записью настроек запретов платежей и отгрузки по организации ""%Организация%"" и контрагенту ""%Контрагент%""'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Строка(ТекЗапись.Организация));
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Контрагент%", Строка(ТекЗапись.Контрагент));
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
			Отказ = Истина;
		Иначе
			// Проверка пройдена успешно.
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПроцедуры = Новый УникальныйИдентификатор();
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторПроцедуры);
	ПараметрыВыполнения.Вставить("ЗапуститьВФоне", Истина);
	ПараметрыВыполнения.Вставить("ОжидатьЗавершение", 0);
	
	ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, 
		"РегистрыСведений.ПравилаЗапретаОпераций.ПроверитьПравилаЗапретаОпераций", Выгрузить());
			
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = неопределено Тогда
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("СтатьяДвиженияДенежныхСредств") Тогда
		Если ДанныеЗаполнения.СтатьяДвиженияДенежныхСредств = Неопределено Тогда
			ДанныеЗаполнения.Вставить("СтатьяДвиженияДенежныхСредств", 
				КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
		КонецЕсли;
	Иначе
		ДанныеЗаполнения.Вставить("СтатьяДвиженияДенежныхСредств", 
			КэшируемыеПроцедурыОПК.ПустаяСтатьяДвиженияДенежныхСредств());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

