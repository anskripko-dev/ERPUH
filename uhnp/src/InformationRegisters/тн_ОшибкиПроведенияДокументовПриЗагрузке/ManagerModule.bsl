Функция ТипОшибкиПоОписанию(ОписаниеОшибки) Экспорт
	
	ТекстОшибки = НРег(ОписаниеОшибки);
	
	Если СтрНайти(ТекстОшибки, "в закрытом периоде" ) <> 0
		Или СтрНайти(ТекстОшибки, "в запрещенном периоде") <> 0 Тогда
		
		ТипОшибки = Перечисления.тн_ТипыОшибокОбмена.ЗакрытыйПериод;	
		
	ИначеЕсли СтрНайти(ТекстОшибки, "поля документа не заполнены") <> 0 Тогда
		
		ТипОшибки = Перечисления.тн_ТипыОшибокОбмена.ЗаполнениеОбъекта;	
		
	ИначеЕсли СтрНайти(ТекстОшибки, "объект расчетов") <> 0 Тогда
		
		ТипОшибки = Перечисления.тн_ТипыОшибокОбмена.НекорректныйОбъектРасчетов;
		
	ИначеЕсли СтрНайти(ТекстОшибки, "не удалось провести") <> 0
		Или СтрНайти(ТекстОшибки, "Ошибка при выполнении обработчика - 'ОбработкаПроведения'") <> 0 Тогда
		
		ТипОшибки = Перечисления.тн_ТипыОшибокОбмена.ОшибкаПроведения;
		
	Иначе
		ТипОшибки = Перечисления.тн_ТипыОшибокОбмена.Прочее;	
	КонецЕсли;
	
	Возврат ТипОшибки;	

КонецФункции