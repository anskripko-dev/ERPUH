#Область ПрограммныйИнтрефейс
Процедура УдалитьЗаписиПоДокументу(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|*
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиКовенантов КАК СтатусыПроверкиКовенантов
	|ГДЕ
	|	СтатусыПроверкиКовенантов.Документ = &Документ"
	);
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.СтатусыПроверкиКовенантов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Удалить();
	КонецЦикла;		
	
КонецПроцедуры

Процедура ДобавитьЗаписиВРегистр(Таблица) Экспорт
	
	Для каждого Строка Из Таблица Цикл
		МенеджерЗаписи = РегистрыСведений.СтатусыПроверкиКовенантов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Строка);
		МенеджерЗаписи.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ИмяПоляРегистратора() Экспорт
	Возврат "Документ";
КонецФункции	

// Функция - Плановые даты по договору
//
// Параметры:
//  ДоговорКонтрагента	 - 	 - 
//  Дата				 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ПлановыеДатыПоДоговоруПоДату(ДоговорКонтрагента, Дата) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	АктуальнаяВерсия = РегистрыСведений.ВерсииГрафиковРасчетов.ПолучитьАктуальнуюВерсиюФинансовогоИнструмента(ДоговорКонтрагента, Дата);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатусыПроверкиКовенантов.ПлановаяДата КАК ПлановаяДата
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиКовенантов КАК СтатусыПроверкиКовенантов
	|ГДЕ
	|	СтатусыПроверкиКовенантов.Документ = &ВерсияСоглашения
	|	И СтатусыПроверкиКовенантов.ПлановаяДата <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлановаяДата"
	);
	
	Запрос.УстановитьПараметр("ВерсияСоглашения", АктуальнаяВерсия);
	Запрос.УстановитьПараметр("Дата", Дата);
	 
	МассивДат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПлановаяДата"); 
	Возврат МассивДат;
	
КонецФункции	

Функция НепроверенныеКовенантыНаДату(ПлановаяДата) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СтатусыПроверкиКовенантовСрезПоследних.Ковенант КАК Ковенант,
	|	СтатусыПроверкиКовенантовСрезПоследних.ПлановаяДата КАК ПлановаяДата,
	|	СтатусыПроверкиКовенантовСрезПоследних.Контрагент КАК Контрагент,
	|	СтатусыПроверкиКовенантовСрезПоследних.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СтатусыПроверкиКовенантовСрезПоследних.Ответственный КАК Ответственный,
	|	СтатусыПроверкиКовенантовСрезПоследних.Организация КАК Организация,
	|	СтатусыПроверкиКовенантовСрезПоследних.Период КАК Период,
	|	СтатусыПроверкиКовенантовСрезПоследних.Документ КАК Документ,
	|	СтатусыПроверкиКовенантовСрезПоследних.СтатусПроверки КАК СтатусПроверки,
	|	СтатусыПроверкиКовенантовСрезПоследних.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ Вт_Ковенанты
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиКовенантов.СрезПоследних(, ПлановаяДата <= &ПлановаяДата) КАК СтатусыПроверкиКовенантовСрезПоследних
	|ГДЕ
	|	СтатусыПроверкиКовенантовСрезПоследних.СтатусПроверки = ЗНАЧЕНИЕ(Перечисление.СтатусыПроверкиКовенантов.НеПроверялся)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатусыПроверкиКовенантовСрезПоследних.Ковенант КАК Ковенант,
	|	СтатусыПроверкиКовенантовСрезПоследних.ПлановаяДата КАК ПлановаяДата,
	|	СтатусыПроверкиКовенантовСрезПоследних.Документ КАК ВерсияСоглашения,
	|	СтатусыПроверкиКовенантовСрезПоследних.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_ВерсииСоглашения
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиКовенантов.СрезПоследних(
	|			,
	|			Документ ССЫЛКА Документ.ВерсияСоглашенияКредит
	|				И Ковенант В
	|					(ВЫБРАТЬ
	|						Вт_Ковенанты.Ковенант КАК Ковенант
	|					ИЗ
	|						Вт_Ковенанты КАК Вт_Ковенанты)) КАК СтатусыПроверкиКовенантовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_Ковенанты.Ковенант КАК Ковенант,
	|	Вт_Ковенанты.ПлановаяДата КАК ПлановаяДата,
	|	Вт_Ковенанты.Контрагент КАК Контрагент,
	|	Вт_Ковенанты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Вт_Ковенанты.Ответственный КАК Ответственный,
	|	Вт_Ковенанты.Организация КАК Организация,
	|	Вт_Ковенанты.Период КАК Период,
	|	Вт_Ковенанты.Документ КАК Документ,
	|	Вт_Ковенанты.СтатусПроверки КАК СтатусПроверки,
	|	Вт_Ковенанты.Комментарий КАК Комментарий
	|ИЗ
	|	Вт_Ковенанты КАК Вт_Ковенанты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВерсииСоглашения КАК ВТ_ВерсииСоглашения
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииГрафиковРасчетов.СрезПоследних(
	|					,
	|					ПредметГрафика В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Вт_Ковенанты.ДоговорКонтрагента КАК ДоговорКонтрагента
	|						ИЗ
	|							Вт_Ковенанты КАК Вт_Ковенанты)) КАК ВерсииРасчетовСрезПоследних
	|			ПО ВТ_ВерсииСоглашения.ВерсияСоглашения = ВерсииРасчетовСрезПоследних.ВерсияГрафика
	|				И ВТ_ВерсииСоглашения.ДоговорКонтрагента = ВерсииРасчетовСрезПоследних.ПредметГрафика
	|		ПО Вт_Ковенанты.Ковенант = ВТ_ВерсииСоглашения.Ковенант
	|			И Вт_Ковенанты.ПлановаяДата = ВТ_ВерсииСоглашения.ПлановаяДата"
	);
	Запрос.УстановитьПараметр("ПлановаяДата", ПлановаяДата);

	Таблица = Запрос.Выполнить().Выгрузить();	
	Возврат Таблица;
	
КонецФункции
#КонецОбласти