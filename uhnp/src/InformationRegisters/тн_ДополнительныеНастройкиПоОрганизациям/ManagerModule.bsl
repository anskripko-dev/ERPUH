//Процедура ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг() Экспорт
Процедура ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг(Параметры = Неопределено) Экспорт
	
	ОрганизацияТНСС = Справочники.Организации.ПустаяСсылка(); 
	ВидВзаиморасчетовРасчетыСТЭК = Справочники.тн_ВидыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Код = &КодОрганизации
		|	И Организации.ИНН = &ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ВидыВзаиморасчетов.Ссылка КАК ВидВзаиморасчета
		|ИЗ
		|	Справочник.тн_ВидыВзаиморасчетов КАК тн_ВидыВзаиморасчетов
		|ГДЕ
		|	тн_ВидыВзаиморасчетов.Код = &КодВидаВзаиморасчета
		|	И тн_ВидыВзаиморасчетов.Наименование = &НаименованиеВидаВзаиморасчета";
	
	Запрос.УстановитьПараметр("ИНН", "7702521529");
	Запрос.УстановитьПараметр("КодОрганизации", "000000001");
	Запрос.УстановитьПараметр("КодВидаВзаиморасчета", "00026");
	Запрос.УстановитьПараметр("НаименованиеВидаВзаиморасчета", "Расчеты с ТЭК");
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаОрганизация = Результат[0].Выбрать();
	Если ВыборкаОрганизация.Следующий() Тогда
		ОрганизацияТНСС = ВыборкаОрганизация.Организация; 
	КонецЕсли;
	
	ВыборкаВидВзаиморасчета = Результат[1].Выбрать();
	Если ВыборкаВидВзаиморасчета.Следующий() Тогда
		ВидВзаиморасчетовРасчетыСТЭК = ВыборкаВидВзаиморасчета.ВидВзаиморасчета; 
	КонецЕсли;
	
	ДанныеЗаполненияНайдены = ЗначениеЗаполнено(ОрганизацияТНСС) И ЗначениеЗаполнено(ВидВзаиморасчетовРасчетыСТЭК);
	Если НЕ ДанныеЗаполненияНайдены Тогда
		Если НЕ ЗначениеЗаполнено(ОрганизацияТНСС) Тогда
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям,,
				"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг: " 
				+ "Не найдена организация ""ТН-Строительные системы""");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ВидВзаиморасчетовРасчетыСТЭК) Тогда
			ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям,,
				"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг: " 
				+ "Не найден вид взаиморасчетов ""Расчеты с ТЭК""");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	тн_ДополнительныеНастройкиПоОрганизациямСрезПоследних.Период КАК Период,
		|	тн_ДополнительныеНастройкиПоОрганизациямСрезПоследних.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.тн_ДополнительныеНастройкиПоОрганизациям.СрезПоследних(, Организация = &ОрганизацияТНСС) КАК тн_ДополнительныеНастройкиПоОрганизациямСрезПоследних";
	
	Запрос.УстановитьПараметр("ОрганизацияТНСС", ОрганизацияТНСС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Запись = РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.СоздатьМенеджерЗаписи();
		Запись.Организация = Выборка.Организация;
		Запись.Период = Выборка.Период;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.ВидВзаиморасчетовПоРасшифровкеТУ = ВидВзаиморасчетовРасчетыСТЭК;
		КонецЕсли;
		
		Попытка
	    	Запись.Записать(); 
		Исключение
	    	ЗаписьЖурналаРегистрации("Обновление информационной базы", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям,,
				"Ошибка при выполнении обработчика обновления РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг: " 
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры  //ДобавитьВидВзаиморасчетовПоРасшифровкеТранспортныхУслуг()

