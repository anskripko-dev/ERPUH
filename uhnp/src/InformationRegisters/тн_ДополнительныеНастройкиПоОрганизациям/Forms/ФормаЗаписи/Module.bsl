#Область ВспомогательныеПроцедурыИФункции

// Иванов ВЮ (Код-Эксперт) 03.02.2025 Выполнение задач №000050329
&НаСервере
Функция СписокЗаголовковРесурсов()
	
	СписокЗаголовков = Новый СписокЗначений;
	
	Ресурсы = Метаданные.РегистрыСведений.тн_ДополнительныеНастройкиПоОрганизациям.Ресурсы;
	
	Для Каждого ТекущийРесурс Из Ресурсы Цикл
		СписокЗаголовков.Добавить(ТекущийРесурс.Имя, ТекущийРесурс.Синоним);
	КонецЦикла;
	
	СписокЗаголовков.СортироватьПоЗначению();
	
	Возврат СписокЗаголовков;
	
КонецФункции // СписокЗаголовковРесурсов()

#КонецОбласти
     