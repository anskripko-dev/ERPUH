#Область СобытияЭлементовФормы

// Иванов ВЮ (Код-Эксперт) 03.02.2025 Выполнение задач №000050329
&НаКлиенте
Процедура СтрокаПоискаНастройкиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	СписокЗаголовков = СписокЗаголовковРесурсов();
	
	Для Каждого ТекущийЭлементСписка Из СписокЗаголовков Цикл
		
		ЭлементФормы = Элементы.Найти(ТекущийЭлементСписка.Значение);
		
		Если ЭлементФормы <> Неопределено
			И СтрНайти(НРег(ТекущийЭлементСписка.Представление), НРег(Текст)) > 0 Тогда
			ПутьКДанным = "Запись." + ТекущийЭлементСписка.Значение;
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекущийЭлементСписка.Представление, , , ПутьКДанным);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СтрокаПоискаНастройкиОкончаниеВводаТекста()

// Белоконенко Денис 01.04.2026 Выполнение задач №000057017
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Запись.ИспользоватьПодразделениеРеализацииРабот И Не ЗначениеЗаполнено(Запись.ПодразделениеРеализацииРабот) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не указано ""Подразделение реализации работ""",,
			"ПодразделениеРеализацииРабот","Запись");
		
		Отказ = Истина;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

