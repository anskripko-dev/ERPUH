#Область ОбработчикиКомандФормы  

&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	ОповещениеФормыПодбора = Новый ОписаниеОповещения("ПослеЗакрытияФормыПодбора", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.НастройкаПодтвержденияЗакупки.Форма.ФормаПодбора",,,,,,
						ОповещениеФормыПодбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияФормыПодбора(Результат, ДополнительныеПараметры) Экспорт
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДанные(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЦФО", 			ТекущиеДанные.ЦФО);
	СтруктураПараметров.Вставить("Номенклатура", 	ТекущиеДанные.Номенклатура);
	ОткрытьФорму("РегистрСведений.НастройкаПодтвержденияЗакупки.Форма.ФормаСвязанныеДанные",СтруктураПараметров,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТоварныеКатегории(Команда)                           

	ПараметрыФормы = Новый Структура("СформироватьПриОткрытии", Истина);

	ОткрытьФорму("Отчет.ОтчетПоТоварнымКатегориям.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти