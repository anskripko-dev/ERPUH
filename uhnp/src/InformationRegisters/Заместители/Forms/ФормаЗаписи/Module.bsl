
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр = Ложь;
	
	Если Параметры.Свойство("ЗамещаемыйПользователь") Тогда
		Запись.ЗамещаемыйПользователь = Параметры.ЗамещаемыйПользователь;
	КонецЕсли;
	
	Если Параметры.Свойство("Заместитель") Тогда
		Запись.Заместитель = Параметры.Заместитель;
	КонецЕсли;
	
	Если Параметры.Свойство("Модифицированность") Тогда
		Модифицированность = Параметры.Модифицированность;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Параметры.ПользовательОтбор) Тогда
		
		ЭтаФорма.Заголовок = Нстр("ru = 'Заместитель для пользователя: '")+ Параметры.ПользовательОтбор;
		Элементы.ЗамещаемыйПользователь.Доступность = Ложь;
		Запись.ЗамещаемыйПользователь = Параметры.ПользовательОтбор;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Оповестить("ОбновитьМоиЗадачиИОповещения");
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ДатаНачала > ТекущийОбъект.ДатаОкончания И ТекущийОбъект.ДатаОкончания <> Дата(1,1,1) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не верно указан период: дата начала: %1, дата окончания: %2'"),
			ТекущийОбъект.ДатаНачала, ТекущийОбъект.ДатаОкончания);
			
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	ЗапросПоПериодам = Новый Запрос("ВЫБРАТЬ
	|	Заместители.ЗамещаемыйПользователь КАК ЗамещаемыйПользователь,
	|	Заместители.Заместитель КАК Заместитель,
	|	Заместители.ДатаНачала КАК ДатаНачала,
	|	Заместители.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	РегистрСведений.Заместители КАК Заместители
	|ГДЕ
	|	Заместители.ЗамещаемыйПользователь = &ЗамещаемыйПользователь
	|	И Заместители.Заместитель = &Заместитель
	|	И (Заместители.ДатаНачала <> &ДатаНачала
	|			ИЛИ Заместители.ДатаОкончания <> &ДатаОкончания)
	|	И (Заместители.ДатаНачала <= &ДатаОкончания
	|			ИЛИ Заместители.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|	И (Заместители.ДатаОкончания >= &ДатаНачала
	|			ИЛИ Заместители.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))");
	
	ЗапросПоПериодам.УстановитьПараметр("ЗамещаемыйПользователь", ТекущийОбъект.ЗамещаемыйПользователь);
	ЗапросПоПериодам.УстановитьПараметр("Заместитель", ТекущийОбъект.Заместитель);
	ЗапросПоПериодам.УстановитьПараметр("ДатаНачала", ТекущийОбъект.ДатаНачала);
	ЗапросПоПериодам.УстановитьПараметр("ДатаОкончания", ТекущийОбъект.ДатаОкончания);
	
	ВыборкаПоПериодам = ЗапросПоПериодам.Выполнить().Выбрать();
	
	Пока ВыборкаПоПериодам.Следующий() Цикл
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Пересечение по периодам. Замещаемый пользователь: %1, заместитель: %2, дата начала: %3, дата окончания: %4'"),
			ВыборкаПоПериодам.ЗамещаемыйПользователь, ВыборкаПоПериодам.Заместитель, ВыборкаПоПериодам.ДатаНачала, ВыборкаПоПериодам.ДатаОкончания);
			
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения, Отказ);
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Закрыть(НЕ Модифицированность);

КонецПроцедуры
