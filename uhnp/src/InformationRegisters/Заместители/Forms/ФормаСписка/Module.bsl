// Функция добавляет заместителя текущему пользователю. Возвращает
// успешность выполнения операции.
&НаСервере
Функция ДобавитьЗаместителяТекущегоПользователя(ЗаместительВход)
	РезультатФункции = Истина;
	ТекПользователь = ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
	РезультатФункции = РегистрыСведений.Заместители.ДобавитьЗаместителяПользователя(ТекПользователь, ЗаместительВход);
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если  ЗначениеЗаполнено(Параметры.ПользовательОтбор) Тогда
		// Общие реквизиты формы.
		ПользовательОтбор = Параметры.ПользовательОтбор;
		ТекстЗаголовка = НСтр("ru = 'Заместители для пользователя: %Пользователь%'");
		ТекстЗаголовка = СтрЗаменить(ТекстЗаголовка, "%Пользователь%", Строка(Параметры.ПользовательОтбор));
		ЭтаФорма.Заголовок = ТекстЗаголовка;
		// Список заместителей текущего пользователя.
		ОбщегоНазначенияКлиентСерверУХ.УстановитьЭлементОтбора(Список.Отбор,"ЗамещаемыйПользователь",Параметры.ПользовательОтбор,ВидСравненияКомпоновкиДанных.Равно,,Истина);
		Элементы.ЗамещаемыйПользователь.Видимость = Ложь;
		// Список замещаемых текущего пользователя.
		ОбщегоНазначенияКлиентСерверУХ.УстановитьЭлементОтбора(СписокЗамещаемых.Отбор, "Заместитель", Параметры.ПользовательОтбор, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		Элементы.СписокЗамещаемых.Видимость = Истина;
	Иначе
		ЭтаФорма.Заголовок = НСтр("ru = 'Заместители'");
		Элементы.СписокЗамещаемых.Видимость = Ложь;
	КонецЕсли;			
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНового(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаместителяЗавершение(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	РезультатУдаления = МодульСогласованияДокументовУХ.УдалитьЗаместителя(Параметры.ЗамещаемыйПользователь, Параметры.Заместитель, Параметры.ДатаНачала, Параметры.ДатаОкончания);	
	Если РезультатУдаления Тогда
		ТекстСообщения = НСтр("ru = 'Заместитель %Заместитель% был удалён.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заместитель%", Параметры.Заместитель);
		ЗаголовокПредупреждения = НСтр("ru = 'Удаление заместителей'");
		ПоказатьОповещениеПользователя(ЗаголовокПредупреждения, , ТекстСообщения, БиблиотекаКартинок.ЗначокКадры32);
	Иначе
		ТекстСообщения = НСтр("ru = 'Удаление заместителя %Заместитель% пользователя %Замещаемый% отменено.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заместитель%", Параметры.Заместитель);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Замещаемый%", Параметры.ЗамещаемыйПользователь);
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	Элементы.Список.Обновить();
	Оповестить("ОбновитьМоиЗадачиИОповещения");
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(Новый Структура("Режим","ОК"))
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	Оповестить("ОбновитьМоиЗадачиИОповещения");
КонецПроцедуры

&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаместителя(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		// Нет выбранных строк. Ничего не делаем.
	Иначе
		Если (ТекДанные.Свойство("Заместитель")) И (ТекДанные.Свойство("ЗамещаемыйПользователь")) Тогда
			ТекстВопроса = НСтр("ru = 'Удалить заместителя %Заместитель%?'");
			ТекстВопроса = СтрЗаменить(ТекстВопроса, "%Заместитель%", ТекДанные.Заместитель);
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Заместитель", ТекДанные.Заместитель);
			ДополнительныеПараметры.Вставить("ЗамещаемыйПользователь", ТекДанные.ЗамещаемыйПользователь);
			ДополнительныеПараметры.Вставить("ДатаНачала", ТекДанные.ДатаНачала);
			ДополнительныеПараметры.Вставить("ДатаОкончания", ТекДанные.ДатаОкончания);
			ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьЗаместителяЗавершение", ЭтаФорма, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ТекстСообщения = НСтр("ru = 'Не удалось получить заместителя. Операция отменена.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Пользователи") Тогда
		
		ТекущийПользователь	= ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
				
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗамещаемыйПользователь", ТекущийПользователь);
		ПараметрыФормы.Вставить("Заместитель", ВыбранноеЗначение);
		ПараметрыФормы.Вставить("Модифицированность", Истина);
		ЕстьСуперПользователь = МодульСогласованияДокументовУХ.ЕстьСуперПользователь(Неопределено);
		Если Не ЕстьСуперПользователь ИЛИ Список.Отбор.Элементы.Количество() > 0 тогда
			ПараметрыФормы.Вставить("ПользовательОтбор", ТекущийПользователь);
		КонецЕсли;
				
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
		ОповещениеОЗаместителе = Новый ОписаниеОповещения("ОповеститьОЗаместителе", ЭтаФорма, ДополнительныеПараметры);
		
		ОткрытьФорму("РегистрСведений.Заместители.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗаместителе);		
	Иначе
		// Неизвестный вариант. Ничего не делаем.
	КонецЕсли;
	Элементы.Список.Обновить();
	Оповестить("ОбновитьМоиЗадачиИОповещения");
КонецПроцедуры

&НаСервере
Функция ПолучитьКлючЗаписиЗаместители(ЗначенияКлюча)

	Возврат РегистрыСведений.Заместители.СоздатьКлючЗаписи(ЗначенияКлюча);
	
КонецФункции

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ЗамещаемыйПользователь" Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
		
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
			
	Если Поле.Имя = "ДатаНачала" ИЛИ Поле.Имя = "ДатаОкончания" Тогда		
		ЕстьСуперПользователь = МодульСогласованияДокументовУХ.ЕстьСуперПользователь(Неопределено);
				
		СтандартнаяОбработка = Ложь;
		ТекущийПользователь	= ОбщегоНазначенияУХ.ПолучитьЗначениеПеременной("глТекущийПользователь");
		
		Если ТекДанные.ЗамещаемыйПользователь <> ТекущийПользователь И НЕ ЕстьСуперПользователь Тогда
			ТекстСообщения = НСтр("ru = 'Для изменения чужих заместителей требуется роль ""Суперпользователь"" для всех организаций.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);		
			Возврат;
		КонецЕсли;
		
		ЗначенияКлюча = Новый Структура;
		ЗначенияКлюча.Вставить("ЗамещаемыйПользователь", ТекДанные.ЗамещаемыйПользователь);
		ЗначенияКлюча.Вставить("Заместитель", ТекДанные.Заместитель);	
		ЗначенияКлюча.Вставить("ДатаНачала", ТекДанные.ДатаНачала);
		ЗначенияКлюча.Вставить("ДатаОкончания", ТекДанные.ДатаОкончания);
		
		КлючЗаписи = ПолучитьКлючЗаписиЗаместители(ЗначенияКлюча);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		Если Не ЕстьСуперПользователь ИЛИ Список.Отбор.Элементы.Количество() > 0 тогда
			ПараметрыФормы.Вставить("ПользовательОтбор", ТекДанные.ЗамещаемыйПользователь);
		КонецЕсли;
			
		ОткрытьФорму("РегистрСведений.Заместители.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
		Возврат;
				
	КонецЕсли;
		
	СтандартнаяОбработка = Ложь;
	Если ТекДанные.Свойство("Заместитель") Тогда
		ПоказатьЗначение(, ТекДанные.Заместитель);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось получить заместителя. Операция отменена.'");
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗамещаемыхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.СписокЗамещаемых.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекДанные.ЗамещаемыйПользователь);
	Иначе
		// Строка не выбрана. Ничего не делаем.
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПоЗаместителям(Команда)
	ПараметрыФормы = Новый Структура;
	ТекПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	НовыеПользовательскиеНастройки = ОбщегоНазначенияУХ.УстановитьЗначениеПараметраВПользовательскиеНастройки("ОтчетОЗамещении", "Пользователь", ТекПользователь);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", НовыеПользовательскиеНастройки);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ОткрытьФорму("Отчет.ОтчетОЗамещении.Форма", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОЗаместителе(РезультатЗакрытия, Параметры) Экспорт
	
	Если РезультатЗакрытия Тогда
		ПояснениеОповещения = НСтр("ru = 'Добавлен заместитель %Заместитель%'");
		ПояснениеОповещения = СтрЗаменить(ПояснениеОповещения, "%Заместитель%", Строка(Параметры.ВыбранноеЗначение));
		ТекстОповещения = НСтр("ru = 'Добавлен заместитель'");
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Параметры.ВыбранноеЗначение);
		ПоказатьОповещениеПользователя(ТекстОповещения, НавигационнаяСсылка, ПояснениеОповещения, БиблиотекаКартинок.ЗначокКадры32);
	Иначе
		ТекстСообщения = НСтр("ru = 'Заместитель %Заместитель% не был добавлен'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заместитель%", Строка(Параметры.ВыбранноеЗначение));
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецЕсли;	
	
КонецПроцедуры
