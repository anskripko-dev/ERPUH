
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ВидСобытияДобавлениеЗаместителя = Справочники.ВидыСобытийОповещений.ДобавленЗаместитель;
	Для Каждого Запись Из ЭтотОбъект Цикл
		ТекЗамещаемый = Запись.ЗамещаемыйПользователь;
		ТекЗаместитель = Запись.Заместитель;
		// Запрет замещения самого себя.
		Если ТекЗаместитель = ТекЗамещаемый Тогда
			ТекстОшибки = НСтр("ru = 'Назначить заместителем самого себя нельзя. Операция отменена.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		// Проверка на цикличные замещения.
		Запрос = Новый Запрос;		
		Запрос.Текст = "ВЫБРАТЬ
		|	Заместители.ЗамещаемыйПользователь КАК ЗамещаемыйПользователь
		|ИЗ
		|	РегистрСведений.Заместители КАК Заместители
		|ГДЕ
		|	Заместители.ЗамещаемыйПользователь = &Заместитель
		|	И Заместители.Заместитель = &ЗамещаемыйПользователь
		|	И (Заместители.ДатаНачала <= &ТекущаяДата
		|			ИЛИ Заместители.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
		|	И (Заместители.ДатаОкончания >= &ТекущаяДата
		|			ИЛИ Заместители.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
		
		Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));		
		Запрос.УстановитьПараметр("Заместитель",ТекЗаместитель);
		Запрос.УстановитьПараметр("ЗамещаемыйПользователь",ТекЗамещаемый);
		Результат = Запрос.Выполнить().Выгрузить();
		Если Результат.Количество()>0 Тогда		  
			ТекстОшибки = НСтр("ru = 'Обнаружено циклическое замещение. Операция отменена.'");
			ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстОшибки);
			Отказ = Истина;  
			Возврат;
		КонецЕсли;
		// Оповещение заместителя.
		Если (ЗначениеЗаполнено(ТекЗаместитель)) И (ЗначениеЗаполнено(ТекЗамещаемый)) Тогда
			КоличествоЗадачЗамещаемого = МодульСогласованияДокументовУХ.ПолучитьКоличествоЗадачПользователяПоСогласованию(ТекЗамещаемый);
			СтруктураДопПараметры = Новый Структура;
			СтруктураДопПараметры.Вставить("КоличествоНеобработанных", КоличествоЗадачЗамещаемого);
			СтруктураДопПараметры.Вставить("ДатаНачала", Формат(Запись.ДатаНачала, "ДФ='дд.ММ.гггг'"));
			СтруктураДопПараметры.Вставить("ДатаОкончания", Формат(Запись.ДатаОкончания, "ДФ='дд.ММ.гггг'"));
			МодульУправленияОповещениямиУХ.ОповеститьПользователей(ВидСобытияДобавлениеЗаместителя, , ТекЗамещаемый, ТекЗаместитель, СтруктураДопПараметры);
		Иначе
			// Заместитель или замещаемый не заполнены. Не отправляем уведомление.
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры
