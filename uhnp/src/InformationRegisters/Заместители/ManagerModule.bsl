// Добавляет заместителя ЗаместительВход пользователю ЗамещаемыйВход. Возвращает 
// успешность выполнения операции.
Функция ДобавитьЗаместителяПользователя(ЗамещаемыйВход, ЗаместительВход) Экспорт
	РезультатФункции = Истина;
	Попытка
		МенеджерЗаписи = РегистрыСведений.Заместители.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗамещаемыйПользователь = ЗамещаемыйВход;
		МенеджерЗаписи.Заместитель = ЗаместительВход;
		МенеджерЗаписи.Записать();		
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось добавить заместителя %Заместитель% пользователю %Замещаемый%: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Заместитель%", Строка(ЗаместительВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Замещаемый%", Строка(ЗамещаемыйВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
		РезультатФункции = Ложь;
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции
