// Возвращает соответствие ответственных из договоров в МассивДоговоровВход
Функция ПолучитьСоответствиеДоговоровОтветственным(МассивДоговоровВход)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДоговорыКонтрагентов.Ссылка,
	|	ДоговорыКонтрагентов.Ответственный
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка В(&Договоры)";
	Запрос.УстановитьПараметр("Договоры", МассивДоговоровВход);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	РезультатФункции = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатФункции.Вставить(ВыборкаДетальныеЗаписи.Ссылка, ВыборкаДетальныеЗаписи.Ответственный);
	КонецЦикла;
	Возврат  РезультатФункции;
КонецФункции

// Добавляет напоминания ответственному по договору о приближении даты оплаты.
Процедура СоздатьНапоминанияПоДоговору()
	// Инициализация.
	ВидСобытияГрафик = Справочники.ВидыСобытийОповещений.Напоминание_ОплатаПоГрафикуДоговора;
	СтруктураНастроек = МодульУправленияОповещениямиУХ.ПолучитьНастройкиОповещенийПоВидуСобытия(ВидСобытияГрафик);
	Если СтруктураНастроек.Количество() > 0 Тогда
		Если НЕ СтруктураНастроек.ОповещениеВключено Тогда
			Возврат;      // Создание напоминаний по данному виду события отключено.
		Иначе
			// Можно продолжать.
		КонецЕсли;
		ВыгрузкаНабора = ЭтотОбъект.Выгрузить();
		ВыгрузкаНабора.Свернуть("ПредметГрафика, ДатаОперации");
		Если ВыгрузкаНабора.Количество() > 0 Тогда         
			// Получим соответствие договоров и их ответственных по данному набору записей.
			МассивПредметГрафика = ВыгрузкаНабора.ВыгрузитьКолонку("ПредметГрафика");      		
			МассивДоговоров = Новый Массив;
			Для Каждого ТекМассивПредметГрафика Из МассивПредметГрафика Цикл
				Если ТипЗнч(ТекМассивПредметГрафика) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
					Если МассивДоговоров.Найти(ТекМассивПредметГрафика) = Неопределено Тогда
						МассивДоговоров.Добавить(ТекМассивПредметГрафика);
					Иначе
						Продолжить;	// Уже есть такое значение.
					КонецЕсли;
				Иначе
					Продолжить;		// Не договор. Не добавляем оповещение.
				КонецЕсли;
			КонецЦикла;     
			СоответствиеДоговоровОтветственным = ПолучитьСоответствиеДоговоровОтветственным(МассивДоговоров);
			// Очистим существующие напоминания.
			МодульУправленияОповещениямиУХ.УдалитьНапоминанияПоДоговорам(МассивДоговоров);  
			// Запишем напоминания ответственным за график.
			Для Каждого ТекВыгрузкаНабора Из ВыгрузкаНабора Цикл
				ТекДоговор = ТекВыгрузкаНабора.ПредметГрафика;
				ПользовательЗапись = СоответствиеДоговоровОтветственным[ТекДоговор];
				Если ЗначениеЗаполнено(ПользовательЗапись) Тогда
					// Создадим запись в регистре напоминания.
					СтруктураНапоминание = МодульУправленияОповещениямиУХ.СоздатьСтруктуруНапоминанияПоУмолчанию(СтруктураНастроек, ПользовательЗапись, ТекВыгрузкаНабора.ДатаОперации, ТекДоговор);
					МодульУправленияОповещениямиУХ.ДобавитьНапоминаниеПользователяСЗадачей(СтруктураНапоминание);
					МодульУправленияОповещениямиУХ.ОбработатьНапоминанияТекущегоПользователя();
				Иначе
					Продолжить;			//Пустой ответственный по договору. Нет получателя для напоминания.
				КонецЕсли;
			КонецЦикла;
		Иначе
			// Пустой набор записей. Не добавляем напоминание.	
		КонецЕсли; 
	Иначе
		// Не удалось получить настройки по данному виду события
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	// Добавляем напоминания ответственному по графику оплаты.
	СоздатьНапоминанияПоДоговору();	
КонецПроцедуры
