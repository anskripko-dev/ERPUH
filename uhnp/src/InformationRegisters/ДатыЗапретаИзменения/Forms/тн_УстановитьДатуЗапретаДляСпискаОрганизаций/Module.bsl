#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пользователь = Параметры.Пользователь;
	
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551 
	ТекПользователь = ПользователиТЗ.Добавить(); 
	ТекПользователь.Пользователь = Пользователь; 
	ЗаполнитьНомераКартинокПользователейДатЗапрета(ЭтотОбъект);
	
	ПолучитьТекущиеНастройкиПоДатамЗапрета();
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаКлиенте
Процедура ОрганизацииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Объекты = ВыбранноеЗначение;
	Иначе
		Объекты = Новый Массив;
		Объекты.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	ОбъектыДляДобавления = Новый Массив;
	Для Каждого Объект Из Объекты Цикл
		ЗначениеНеНайдено = Истина;
		Для Каждого Строка Из Организации Цикл
			Если Строка.Организация = Объект Тогда
				ЗначениеНеНайдено = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеНеНайдено Тогда
			НоваяСтрока = Организации.Добавить(); 
			НоваяСтрока.Организация = Объект;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаКлиенте
Процедура ПользователиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура("Пользователь");
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Объекты = ВыбранноеЗначение;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Булево") Тогда  
		Возврат;
	Иначе
		Объекты = Новый Массив;
		Объекты.Добавить(ВыбранноеЗначение);
	КонецЕсли;	
	
	Для Каждого Значение Из Объекты Цикл
		Отбор.Пользователь = Значение;
		Если ПользователиТЗ.НайтиСтроки(Отбор).Количество() = 0 Тогда
			
			НовыйПользователь 				= ПользователиТЗ.Добавить();
			НовыйПользователь.Пользователь  = Отбор.Пользователь;
			
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьНомераКартинокПользователейДатЗапрета(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Отказ = Ложь;
	
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551
	//Если Пользователь = Неопределено Тогда
	//	ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбран пользователь для установки даты запрета!");
	Если ПользователиТЗ.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбраны пользователи для установки даты запрета!");
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551
		Отказ = Истина;
	КонецЕсли;
	
	Если  Организации.Количество()=0  Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбраны организации для установки даты запрета!");
		Отказ = Истина;	
	КонецЕсли;
	
	Если Не Отказ Тогда	
		ДобавитьОбъектыВРазделы(); 	
		Закрыть();		
	КонецЕсли;

КонецПроцедуры            

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаКлиенте
Процедура ПодобратьОрганизации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь); 
	
	ОткрытьФорму("Справочник.Организации.ФормаВыбора", ПараметрыФормы, Элементы.Организации);

КонецПроцедуры

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаКлиенте
Процедура ПодобратьПользователя(Команда)
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ПараметрыФормы.Вставить("ВыборГруппПользователей", Истина);	
