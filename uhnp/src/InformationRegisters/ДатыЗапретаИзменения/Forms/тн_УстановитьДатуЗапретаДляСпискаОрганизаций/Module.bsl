	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, Элементы.ПользователиТЗ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьОбъектыВРазделы()
	
	//1. Получаем список разделов
	СвойстваРазделов = ДатыЗапретаИзмененияСлужебный.СвойстваРазделов();
	Разделы = СвойстваРазделов.Разделы; 
	
	//2. Получаем список банковских счетов для организации (для раздела "Банк")
	СписокОрганизаций = Организации.Выгрузить(Новый Структура("ЗаполнитьДляБС", Истина)).ВыгрузитьКолонку("Организация");
	БанковскиеСчета = ПолучитьБанковскиеСчетаОрганизации(СписокОрганизаций);
	
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551 
	Для Каждого СтрокаПользователь Из ПользователиТЗ Цикл 
		ТекПользователь = СтрокаПользователь.Пользователь;	
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551	
	
	//3. Вносим данные в регистр:
	//		Объект - из ТЧ Организации (Организация/Банковский счет)
	//		Пользователь - передали из основной формы 
	//		ДатаЗапрета - Либо общая, либо из ТЧ
	//		Реквизиты ОписаниеДатыЗапрета и Комментарий -  не заполняем	
	НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей(); 
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551
	//НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);	
	//НаборЗаписей.Прочитать();    
	НаборЗаписей.Отбор.Пользователь.Установить(ТекПользователь);
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551
	//НАЧАЛО Качикина 31.03.2025 Выполнение задач №000053234  
	НаборЗаписей.Прочитать();
	//КОНЕЦ Качикина 31.03.2025 Выполнение задач №000053234
	
	ТаблицаДвиженийПоПользователю = НаборЗаписей.Выгрузить();		
	
	ДанныеЗаполнения = Новый Структура;
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551
	//ДанныеЗаполнения.Вставить("Пользователь", Пользователь);
	ДанныеЗаполнения.Вставить("Пользователь", ТекПользователь);
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551   
	ДанныеЗаполнения.Вставить("ОписаниеДатыЗапрета","");
	ДанныеЗаполнения.Вставить("Комментарий",""); 	
	ДанныеЗаполнения.Вставить("Раздел");
	ДанныеЗаполнения.Вставить("Объект"); 
	ДанныеЗаполнения.Вставить("ДатаЗапрета");
	
	Попытка  
		
		//НАЧАЛО Качикина 31.03.2025 Выполнение задач №000053234  
		//т.к. набор по текущему пользователю полностью зачищается, добавляем отдельно запись по общей дате запрета, если такая была установлена
		ПустойРаздел	= ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
		ЕстьОбщаяДЗ		= Ложь;
		НС = ТаблицаДвиженийПоПользователю.НайтиСтроки(Новый Структура("Раздел, Объект",ПустойРаздел,ПустойРаздел)); 
		Если НС.Количество()>0 Тогда 
			ЗаполнитьЗначенияСвойств(ДанныеЗаполнения,НС[0]);
			ЕстьОбщаяДЗ = Истина;
		КонецЕсли; 
		
		// НАЧАЛО Юдина Екатерина 14.07.2025 Выполнение задач №000054405
		// Сохраняем записи по БС для организаций, по которым дата БС не редактируется  
	    МассивОрганизацийДляСохраненияБС = Организации.Выгрузить(Новый Структура("ЗаполнитьДляБС", Ложь)).ВыгрузитьКолонку("Организация");
		
		МассивСтрокБанк = ТаблицаДвиженийПоПользователю.НайтиСтроки(Новый Структура("Раздел", ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.НайтиПоНаименованию("Банк")));		
		ТаблицаСохраненныхДвиженийБанкПоПользователю = ТаблицаДвиженийПоПользователю.СкопироватьКолонки();
		Для Каждого Строка Из МассивСтрокБанк Цикл 
			
			Если ЗначениеЗаполнено(Строка.Объект)
				И МассивОрганизацийДляСохраненияБС.Найти(Строка.Объект.Владелец) <> Неопределено Тогда
				НС = ТаблицаСохраненныхДвиженийБанкПоПользователю.Добавить();  
				ЗаполнитьЗначенияСвойств(НС, Строка);
			КонецЕсли;
			
		КонецЦикла;
	    // КОНЕЦ Юдина Екатерина 14.07.2025 Выполнение задач №000054405 
		ТаблицаДвиженийПоПользователю.Очистить();    
		Если ЕстьОбщаяДЗ Тогда  
			ЗаписатьДатуЗапретаВНабор(ТаблицаДвиженийПоПользователю, ДанныеЗаполнения);
		КонецЕсли;
		//КОНЕЦ Качикина 31.03.2025 Выполнение задач №000053234
		// НАЧАЛО Юдина Екатерина 14.07.2025 Выполнение задач №000054405
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаСохраненныхДвиженийБанкПоПользователю, ТаблицаДвиженийПоПользователю);
		// КОНЕЦ Юдина Екатерина 14.07.2025 Выполнение задач №000054405
		 
		Для каждого Раздел Из Разделы Цикл
			
			ТекущийРаздел = Раздел.Ключ;
			
			Если ТипЗнч(ТекущийРаздел) = Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			
			//3.1. Для каждого раздела проверяем доступные ему типы (нас интересуют Организации и банковские счета)
			ТипыОбъектовРаздела = Раздел.Значение.ТипыОбъектов;
			Если ТипыОбъектовРаздела = Неопределено Или ТипыОбъектовРаздела.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СписокТипов = Новый СписокЗначений;
			Для Каждого СвойстваТипа Из ТипыОбъектовРаздела Цикл
				СписокТипов.Добавить(СвойстваТипа.ПолноеИмя, СвойстваТипа.Представление);
			КонецЦикла;
			
			Для каждого ЭлСпискаТипов Из СписокТипов Цикл
				
				ЭтоБС = ЭлСпискаТипов.Значение = "Справочник.БанковскиеСчетаОрганизаций"; 
				ЭтоОрганизации = ЭлСпискаТипов.Значение = "Справочник.Организации"; 
				
				Если НЕ (ЭтоБС Или ЭтоОрганизации) Тогда	
					//пропускаем такой раздел
					Продолжить;
				КонецЕсли; 
				
				//3.2. Добавляем запись в регистр по разделу 
				Для Каждого ТекущийОбъект Из Организации Цикл
					
					ТекущаяДатаЗапрета = ?(ЗначениеЗаполнено(ТекущийОбъект.ДатаЗапрета),ТекущийОбъект.ДатаЗапрета,ОбщаяДатаЗапрета);
					Если Не ЗначениеЗаполнено(ТекущаяДатаЗапрета) Тогда
						// НАЧАЛО Чекордина Ирина 28.05.2025 Выполнение задач №000053846
						//ТекущаяДатаЗапрета = '39991231';
						Продолжить;
						// КОНЕЦ Чекордина Ирина 28.05.2025 Выполнение задач №000053846
					КонецЕсли;   
					
					ДанныеЗаполнения.ДатаЗапрета = ТекущаяДатаЗапрета;
					ДанныеЗаполнения.Раздел=ТекущийРаздел; 
					
					Если ЭтоБС Тогда
						 
						Для каждого СтрокаБС Из БанковскиеСчета Цикл
							Если СтрокаБС.Владелец = ТекущийОбъект.Организация Тогда 
								ДанныеЗаполнения.Объект = СтрокаБС.БС; 
								ЗаписатьДатуЗапретаВНабор(ТаблицаДвиженийПоПользователю, ДанныеЗаполнения);
							КонецЕсли;
						конецЦикла  
						
					Иначе   						
						ДанныеЗаполнения.Объект = ТекущийОбъект.Организация;  
						ЗаписатьДатуЗапретаВНабор(ТаблицаДвиженийПоПользователю, ДанныеЗаполнения);
					КонецЕсли;  
					
				КонецЦикла; //цикл по организациям 
					
			КонецЦикла; //цикл по типу раздела
			
		КонецЦикла; //цикл по разделам
		
		НаборЗаписей.Загрузить(ТаблицаДвиженийПоПользователю);  
		НаборЗаписей.Записать();
		
		ВозвращаемоеЗначение = Истина;
	Исключение
		ВозвращаемоеЗначение = Ложь;
		ОбщегоНазначения.СообщитьПользователю("Не удалось установить даты запрета по разделам для списка организаций: "+ОписаниеОшибки());
	КонецПопытки;
	
	// НАЧАЛО Белоконенко Денис 17.02.2025 Выполнение задач №000052551 
	КонецЦикла;
	// КОНЕЦ Белоконенко Денис 17.02.2025 Выполнение задач №000052551	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьБанковскиеСчетаОрганизации(МассивОрганизаций)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	БанковскиеСчетаОрганизаций.Ссылка КАК БС,
	               |	БанковскиеСчетаОрганизаций.Владелец КАК Владелец
	               |ИЗ
	               |	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	               |ГДЕ БанковскиеСчетаОрганизаций.Владелец В (&МассивОрганизаций)";
	
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	БанковскиеСчета = Запрос.Выполнить().Выгрузить();

	Возврат БанковскиеСчета
	
КонецФункции

&НаСервере
Процедура ЗаписатьДатуЗапретаВНабор(ТаблицаДвиженийПоПользователю, Знач ДанныеЗаполнения)
	
	СтруктураОтбора = Новый Структура("Раздел,Объект, Пользователь",
					ДанныеЗаполнения.Раздел,ДанныеЗаполнения.Объект, ДанныеЗаполнения.Пользователь); 
	МассивСтрок = ТаблицаДвиженийПоПользователю.НайтиСтроки(СтруктураОтбора);
	СтрокаМассива = ?(МассивСтрок.Количество()>0, МассивСтрок[0],ТаблицаДвиженийПоПользователю.Добавить()); 
	ЗаполнитьЗначенияСвойств(СтрокаМассива,ДанныеЗаполнения);	
	
КонецПроцедуры   

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551 
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНомераКартинокПользователейДатЗапрета(Форма, ТекущаяСтрока = Неопределено)
	
	Строки = Новый Массив;
	Если ТекущаяСтрока = Неопределено Тогда
		Строки = Форма.ПользователиТЗ;
	Иначе
		Строки.Добавить(Форма.ПользователиТЗ.НайтиПоИдентификатору(ТекущаяСтрока));
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		СвойстваСтроки = Новый Структура("Пользователь, НомерКартинки");
		ЗаполнитьЗначенияСвойств(СвойстваСтроки, Строка);
		МассивСтрок.Добавить(СвойстваСтроки);
	КонецЦикла;
	
	ЗаполнитьНомераКартинокПользователейДатЗапретаНаСервере(МассивСтрок);
	
	Индекс = Строки.Количество()-1;
	Пока Индекс >= 0 Цикл
		ЗаполнитьЗначенияСвойств(Строки[Индекс], МассивСтрок[Индекс], "НомерКартинки");
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаСервереБезКонтекста
Процедура ЗаполнитьНомераКартинокПользователейДатЗапретаНаСервере(МассивСтрок)
	
	Пользователи.ЗаполнитьНомераКартинокПользователей(
			МассивСтрок, "Пользователь", "НомерКартинки");
	
КонецПроцедуры

// Белоконенко Денис 17.02.2025 Выполнение задач №000052551
&НаСервере
Процедура ПолучитьТекущиеНастройкиПоДатамЗапрета()
	
	Организации.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.Объект КАК Организация,
		|	ДатыЗапретаИзменения.Пользователь КАК Пользователь,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДатыЗапретаИзменения.ДатаЗапрета) КАК КолРазличныхДатЗапрета
		|ПОМЕСТИТЬ вт_КолДатПоОрганизациям
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|ГДЕ
		|	ДатыЗапретаИзменения.Пользователь = &Пользователь
		|	И ДатыЗапретаИзменения.Объект ССЫЛКА Справочник.Организации
		|
		|СГРУППИРОВАТЬ ПО
		|	ДатыЗапретаИзменения.Объект,
		|	ДатыЗапретаИзменения.Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_КолДатПоОрганизациям.Организация КАК Организация,
		|	вт_КолДатПоОрганизациям.Пользователь КАК Пользователь,
		|	ВЫБОР
		|		КОГДА вт_КолДатПоОрганизациям.КолРазличныхДатЗапрета > 1
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ДатыЗапретаИзменения.ДатаЗапрета
		|	КОНЕЦ КАК ДатаЗапрета
		|ИЗ
		|	вт_КолДатПоОрганизациям КАК вт_КолДатПоОрганизациям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
		|		ПО вт_КолДатПоОрганизациям.Пользователь = ДатыЗапретаИзменения.Пользователь
		|			И вт_КолДатПоОрганизациям.Организация = ДатыЗапретаИзменения.Объект
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_КолДатПоОрганизациям.Организация,
		|	вт_КолДатПоОрганизациям.Пользователь,
		|	ВЫБОР
		|		КОГДА вт_КолДатПоОрганизациям.КолРазличныхДатЗапрета > 1
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ДатыЗапретаИзменения.ДатаЗапрета
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Организации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


