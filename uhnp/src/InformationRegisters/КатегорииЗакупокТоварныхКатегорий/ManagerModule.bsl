#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ЗаполнитьКатегорииЗакупокТоварныхКатегорий() Экспорт

	Источники = СписокИсточников();    
	Запросы = Новый Массив;    
	Запрос = Новый Запрос;       
	Индекс = 0;     
	
	
	
	Для Каждого Источник Из Источники Цикл          
		
		ЧастиИсточника 	= СтрРазделить(Источник, "."); 
		Индекс 			= Индекс + 1;      
		Идентификатор 	= СтрШаблон("Идентификатор%1", СтрЗаменить(Строка(Индекс), Символы.НПП, ""));
		ИдентификаторМД = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ЧастиИсточника[0] + "." + ЧастиИсточника[1]); 
		Запрос.УстановитьПараметр(Идентификатор, ИдентификаторМД); 
		
		Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Коллекция.%ИмяСвойства КАК ТоварнаяКатегория,
		|	%ПолныйТипОбъекта КАК ПолныйТипОбъекта 
		|%Поместить
		|ИЗ
		|	%ТипОбъекта.%ИмяОбъекта КАК Коллекция
		|ГДЕ
		|	Коллекция.%ИмяСвойства <> ЗНАЧЕНИЕ(Справочник.ТоварныеКатегории.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(Коллекция.%ИмяСвойства) = ТИП(Справочник.ТоварныеКатегории)"; 
		
		Текст = СтрЗаменить(Текст, "%ТипОбъекта", 		ЧастиИсточника[0]);    
		Текст = СтрЗаменить(Текст, "%ИмяСвойства", 		ЧастиИсточника[ЧастиИсточника.Количество()-1]);
		Текст = СтрЗаменить(Текст, "%ПолныйТипОбъекта", "&"+Идентификатор);  
		Текст = СтрЗаменить(Текст, "%Поместить", 		?(Запросы.Количество()=0, "ПОМЕСТИТЬ Источники", ""));
		
		Если СтрНайти(ВРег(Источник), ВРег("ТабличнаяЧасть")) Тогда    
			Текст = СтрЗаменить(Текст, "%ИмяОбъекта", 	ЧастиИсточника[1]+"."+ЧастиИсточника[3]);
		Иначе
			Текст = СтрЗаменить(Текст, "%ИмяОбъекта", 	ЧастиИсточника[1]);  
		КонецЕсли;
		
		Запросы.Добавить(Текст);
		
	КонецЦикла;    
	
	Запрос.Текст = СтрСоединить(Запросы, Символы.ПС  +Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС + Символы.ПС); 
	Текст = Символы.ПС + Символы.ПС +   
			"////////////////////////////////////////////////////////////////////////////////
			|;
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	Источники.ТоварнаяКатегория КАК ТоварнаяКатегория,
	        |	КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки КАК КатегорияЗакупки
	        |ПОМЕСТИТЬ ТоварныеКатегорииДляЗаписи
	        |ИЗ
	        |	Источники КАК Источники
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииЗакупокТоварныхКатегорий КАК КатегорииЗакупокТоварныхКатегорий
	        |		ПО Источники.ТоварнаяКатегория = КатегорииЗакупокТоварныхКатегорий.ТоварнаяКатегория
	        |ГДЕ
	        |	КатегорииЗакупокТоварныхКатегорий.КатегорияЗакупки ЕСТЬ NULL
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Источники.ТоварнаяКатегория КАК ТоварнаяКатегория,
	        |	МИНИМУМ(Источники.ПолныйТипОбъекта) КАК ПолныйТипОбъекта
	        |ИЗ
	        |	Источники КАК Источники
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТоварныеКатегорииДляЗаписи КАК ТоварныеКатегорииДляЗаписи
	        |		ПО Источники.ТоварнаяКатегория = ТоварныеКатегорииДляЗаписи.ТоварнаяКатегория
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	Источники.ТоварнаяКатегория";
   	Запрос.Текст = Запрос.Текст + Текст;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	Попытка     
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТоварнаяКатегория) Тогда   
				
				КатегорияЗакупки = Справочники.КатегорииЗакупок.СоздатьЭлемент();    
				ТКОбъект = ВыборкаДетальныеЗаписи.ТоварнаяКатегория.ПолучитьОбъект();
				
				ЗаполнитьЗначенияСвойств(КатегорияЗакупки, ТКОбъект, , "Владелец");  
				КатегорияЗакупки.ВидНоменклатуры = ТКОбъект.Владелец;
				КатегорияЗакупки.ДополнительныеРеквизиты.Загрузить(ТКОбъект.ДополнительныеРеквизиты.Выгрузить());  
				КатегорияЗакупки.Записать();
				
				Менеджер = РегистрыСведений.КатегорииЗакупокТоварныхКатегорий.СоздатьМенеджерЗаписи();
				Менеджер.Источник 			= ВыборкаДетальныеЗаписи.ПолныйТипОбъекта;
				Менеджер.КатегорияЗакупки 	= КатегорияЗакупки.Ссылка;
				Менеджер.ТоварнаяКатегория 	= ВыборкаДетальныеЗаписи.ТоварнаяКатегория;    
				Менеджер.Комментарий		= "";
				Менеджер.Записать(Истина);      
				
			КонецЕсли;
		КонецЦикла;    
		
		ЗафиксироватьТранзакцию();   
		
	Исключение          
		
		ОтменитьТранзакцию();
		ВызватьИсключение ОписаниеОшибки();   
		
	КонецПопытки;


КонецПроцедуры       


