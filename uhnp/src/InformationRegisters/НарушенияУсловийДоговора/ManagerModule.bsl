#Область ПрограммныйИнтрефейс
Процедура УдалитьЗаписиПоДокументу(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НарушенияУсловийДоговора.Период КАК Период,
	|	НарушенияУсловийДоговора.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	НарушенияУсловийДоговора.ВидНарушения КАК ВидНарушения,
	|	НарушенияУсловийДоговора.ЕстьНарушение КАК ЕстьНарушение,
	|	НарушенияУсловийДоговора.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.НарушенияУсловийДоговора КАК НарушенияУсловийДоговора
	|ГДЕ
	|	НарушенияУсловийДоговора.Документ = &Документ"
	);
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.НарушенияУсловийДоговора.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Удалить();
	КонецЦикла;		
	
КонецПроцедуры	

Процедура ДобавитьЗаписиВРегистр(Таблица, ЗначенияЗаполнения = Неопределено) Экспорт
	
	Если ЗначенияЗаполнения = Неопределено Тогда
		ЗначенияЗаполнения = Новый Структура;
	КонецЕсли;
	
	Для каждого Строка Из Таблица Цикл
		МенеджерЗаписи = РегистрыСведений.НарушенияУсловийДоговора.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Строка);
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЗначенияЗаполнения);
		МенеджерЗаписи.Записать();
	КонецЦикла;

КонецПроцедуры	

Функция ИмяПоляРегистратора() Экспорт
	Возврат "Документ";
КонецФункции	
	

#КонецОбласти