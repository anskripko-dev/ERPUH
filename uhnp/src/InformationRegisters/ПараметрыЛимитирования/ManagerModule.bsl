// Процедура заполняет регистр при первоначальном заполнении информационной базы
Процедура ПервоначальноеЗаполнение() Экспорт
	
	// Для бюджета закупок нужен период Текущий Год
	КэшируемыеПроцедурыУХ.глОтносительныйПериодПоДате(НачалоГода(ТекущаяДатаСеанса()), Перечисления.Периодичность.Год, 0);
	
	// Заполнить РегистрСведений.ПараметрыЛимитирования
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоТекущегоГода", НачалоГода(ТекущаяДатаСеанса()));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&НачалоТекущегоГода КАК Период,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств) КАК ВидБюджета,
	|	ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаУпрУчета) КАК СпособОпределенияВалютыЛимитирования,
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год) КАК ПериодичностьЛимитирования,
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год) КАК ПериодичностьПланирования,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыГоризонтовПланирования.СвободныйГоризонт) КАК ВидГоризонтаЛимитирования,
	|	1 КАК КоличествоПериодовЛимитирования,
	|	ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка) КАК ПервыйПериодЛимитирования,
	|	ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать) КАК КонтрольЛимитов,
	|	ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.НеКонтролировать) КАК КонтрольРезервов
	|ПОМЕСТИТЬ ВТ_ЗначенияПоУмолчанию
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&НачалоТекущегоГода,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов),
	|	ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияВалютыЛимитирования.ВалютаУпрУчета),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.Периодичность.Год),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыГоризонтовПланирования.СвободныйГоризонт),
	|	1,
	|	ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.Информировать),
	|	ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.НеКонтролировать)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗначенияПоУмолчанию.Период КАК Период,
	|	ВТ_ЗначенияПоУмолчанию.ВидБюджета КАК ВидБюджета,
	|	ВТ_ЗначенияПоУмолчанию.СпособОпределенияВалютыЛимитирования КАК СпособОпределенияВалютыЛимитирования,
	|	ВТ_ЗначенияПоУмолчанию.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ВТ_ЗначенияПоУмолчанию.ПериодичностьПланирования КАК ПериодичностьПланирования,
	|	ВТ_ЗначенияПоУмолчанию.ВидГоризонтаЛимитирования КАК ВидГоризонтаЛимитирования,
	|	ВТ_ЗначенияПоУмолчанию.КоличествоПериодовЛимитирования КАК КоличествоПериодовЛимитирования,
	|	ВТ_ЗначенияПоУмолчанию.ПервыйПериодЛимитирования КАК ПервыйПериодЛимитирования,
	|	ВТ_ЗначенияПоУмолчанию.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ВТ_ЗначенияПоУмолчанию.КонтрольРезервов КАК КонтрольРезервов,
	|	ВЫБОР
	|		КОГДА ВТ_ЗначенияПоУмолчанию.КонтрольЛимитов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.НеКонтролировать)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ИспользоватьЛимитирование,
	|	ВЫБОР
	|		КОГДА ВТ_ЗначенияПоУмолчанию.КонтрольРезервов = ЗНАЧЕНИЕ(Перечисление.РежимыКонтроляДокументов.НеКонтролировать)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ИспользоватьРезервирование
	|ИЗ
	|	ВТ_ЗначенияПоУмолчанию КАК ВТ_ЗначенияПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|		ПО ВТ_ЗначенияПоУмолчанию.ВидБюджета = ПараметрыЛимитирования.ВидБюджета
	|			И ВТ_ЗначенияПоУмолчанию.Период = ПараметрыЛимитирования.Период
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета ЕСТЬ NULL";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НЗ = РегистрыСведений.ПараметрыЛимитирования.СоздатьНаборЗаписей();
		НЗ.Отбор.ВидБюджета.Установить(Выборка.ВидБюджета);
		ЗаполнитьЗначенияСвойств(НЗ.Добавить(), Выборка);
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ,,, Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

Процедура СкопироватьНастройкиПериода(ВидБюджета, ПериодИсточник, ПериодПолучатель) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);  
	
	Если ПериодИсточник = ПериодПолучатель Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("ПериодИсточник", ПериодИсточник);
	Запрос.УстановитьПараметр("ПериодПолучатель", ПериодПолучатель);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ПериодПолучатель КАК Период,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.ВидБюджета КАК ВидБюджета,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.СтатьяБюджета КАК СтатьяБюджета,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьСтатью КАК КонтролироватьСтатью,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику1 КАК КонтролироватьАналитику1,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику2 КАК КонтролироватьАналитику2,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику3 КАК КонтролироватьАналитику3,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику4 КАК КонтролироватьАналитику4,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику5 КАК КонтролироватьАналитику5,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтролироватьАналитику6 КАК КонтролироватьАналитику6,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.ИноеДействие КАК ИноеДействие,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.КонтрольРезервов КАК КонтрольРезервов
	|ИЗ
	|	РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов КАК ПараметрыКонтроляЛимитаСтатейБюджетов
	|ГДЕ
	|	ПараметрыКонтроляЛимитаСтатейБюджетов.Период = &ПериодИсточник
	|	И ПараметрыКонтроляЛимитаСтатейБюджетов.ВидБюджета = &ВидБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПериодПолучатель КАК Период,
	|	ПараметрыЛимитированияВалютыЦФО.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияВалютыЦФО.ЦФО КАК ЦФО,
	|	ПараметрыЛимитированияВалютыЦФО.ВалютаЛимитирования КАК ВалютаЛимитирования
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияВалютыЦФО КАК ПараметрыЛимитированияВалютыЦФО
	|ГДЕ
	|	ПараметрыЛимитированияВалютыЦФО.Период = &ПериодИсточник
	|	И ПараметрыЛимитированияВалютыЦФО.ВидБюджета = &ВидБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПериодПолучатель КАК Период,
	|	ПараметрыЛимитированияГруппыСтатей.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияГруппыСтатей.ГруппаСтатей КАК ГруппаСтатей,
	|	ПараметрыЛимитированияГруппыСтатей.ИнаяПериодичность КАК ИнаяПериодичность,
	|	ПараметрыЛимитированияГруппыСтатей.Периодичность КАК Периодичность,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольПоГруппе КАК КонтрольПоГруппе,
	|	ПараметрыЛимитированияГруппыСтатей.ИноеДействие КАК ИноеДействие,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольЛимитов КАК КонтрольЛимитов,
	|	ПараметрыЛимитированияГруппыСтатей.КонтрольРезервов КАК КонтрольРезервов
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатей КАК ПараметрыЛимитированияГруппыСтатей
	|ГДЕ
	|	ПараметрыЛимитированияГруппыСтатей.Период = &ПериодИсточник
	|	И ПараметрыЛимитированияГруппыСтатей.ВидБюджета = &ВидБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПериодПолучатель КАК Период,
	|	ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитированияГруппыСтатейСостав.СтатьяБюджета КАК СтатьяБюджета,
	|	ПараметрыЛимитированияГруппыСтатейСостав.ГруппаСтатей КАК ГруппаСтатей
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав КАК ПараметрыЛимитированияГруппыСтатейСостав
	|ГДЕ
	|	ПараметрыЛимитированияГруппыСтатейСостав.Период = &ПериодИсточник
	|	И ПараметрыЛимитированияГруппыСтатейСостав.ВидБюджета = &ВидБюджета";
	
	Результат = Запрос.ВыполнитьПакет();
				
	НачатьТранзакцию();
	
	Попытка   	
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ПериодПолучатель);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияВалютыЦФО");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ПериодПолучатель);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияГруппыСтатей");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ПериодПолучатель);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ПериодПолучатель);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ПериодПолучатель);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Загрузить(Результат[0].Выгрузить());
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияВалютыЦФО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ПериодПолучатель);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Загрузить(Результат[1].Выгрузить());
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияГруппыСтатей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ПериодПолучатель);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Загрузить(Результат[2].Выгрузить());
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияГруппыСтатейСостав.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ПериодПолучатель);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Загрузить(Результат[3].Выгрузить());
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение   		
		ОтменитьТранзакцию();		
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьНастройкиПериода(ВидБюджета, ДатаНачала) Экспорт
	
	НачатьТранзакцию();
	
	Попытка 	
		Блокировка = Новый БлокировкаДанных;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыКонтроляЛимитаСтатейБюджетов");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ДатаНачала);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияВалютыЦФО");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ДатаНачала);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияГруппыСтатей");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ДатаНачала);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Элемент = Блокировка.Добавить("РегистрСведений.ПараметрыЛимитированияГруппыСтатейСостав");
		Элемент.УстановитьЗначение("ВидБюджета", ВидБюджета);
		Элемент.УстановитьЗначение("Период", ДатаНачала);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ПараметрыКонтроляЛимитаСтатейБюджетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ДатаНачала);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияВалютыЦФО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ДатаНачала);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияГруппыСтатей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ДатаНачала);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияГруппыСтатейСостав.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ДатаНачала);
		НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение   		
		ОтменитьТранзакцию();		
	КонецПопытки;
	
КонецПроцедуры   

#КонецОбласти

#КонецЕсли   