Функция ЕстьДвиженияВПериоде(Знач ВидБюджета, Знач Период) Экспорт
	
	Запрос = Новый Запрос;   	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(ПараметрыЛимитирования.Период) КАК Период
	|ПОМЕСТИТЬ СледующийПериод
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитирования.Период > &Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов,
	|	СледующийПериод КАК СледующийПериод
	|ГДЕ
	|	ОперацииБюджетов.Период = &Период
	|	И ОперацииБюджетов.Период < ЕСТЬNULL(СледующийПериод.Период, ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59))
	|	И ОперацииБюджетов.ВидБюджета = &ВидБюджета";
	
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	Запрос.УстановитьПараметр("Период", 	Период);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

Функция ПараметрыЛимитированияЗаПериодом(Знач ВидБюджета, Знач Период) Экспорт
	
	Ключи = "ПараметрыДоПериод, ПараметрыДоПериодичность, ПараметрыПослеПериод, 
			|ПараметрыПослеПериодичность, ПериодДвижений, ПланированиеЗакупок";
	
	ПараметрыЛимитирования = Новый Структура(Ключи);

	Запрос = Новый Запрос; 	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитирования.Период > &Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ПериодичностьЛимитирования КАК ПериодичностьЛимитирования,
	|	ПараметрыЛимитирования.ПланированиеЗакупок КАК ПланированиеЗакупок
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета = &ВидБюджета
	|	И ПараметрыЛимитирования.Период <= &Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета); 
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыЛимитирования.ПараметрыПослеПериод = Выборка.Период;
		ПараметрыЛимитирования.ПараметрыПослеПериодичность = Выборка.ПериодичностьЛимитирования;
	КонецЕсли;

	Выборка = РезультатЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыЛимитирования.ПараметрыДоПериод = Выборка.Период;
		ПараметрыЛимитирования.ПараметрыДоПериодичность = Выборка.ПериодичностьЛимитирования;   
		ПараметрыЛимитирования.ПланированиеЗакупок = Выборка.ПланированиеЗакупок;     
	КонецЕсли;  
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, НЕДЕЛЯ)
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, ДЕКАДА)
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, МЕСЯЦ)
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, КВАРТАЛ)
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, ПОЛУГОДИЕ)
	|		КОГДА &Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
	|			ТОГДА НАЧАЛОПЕРИОДА(ОперацииБюджетов.Период, ГОД)
	|		ИНАЧЕ ОперацииБюджетов.Период
	|	КОНЕЦ КАК Период
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов
	|ГДЕ
	|	ОперацииБюджетов.ВидБюджета = &ВидБюджета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОперацииБюджетов.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Периодичность", ПараметрыЛимитирования.ПараметрыДоПериодичность);
	Запрос.УстановитьПараметр("ВидБюджета", ВидБюджета);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыЛимитирования.ПериодДвижений = Выборка.Период; 
	КонецЕсли;
	
	Возврат ПараметрыЛимитирования;

КонецФункции

Функция ДобавитьПериодКДате(Знач НоваяДата, Знач Периодичность) Экспорт
	
	Если Периодичность = Перечисления.Периодичность.Год Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, 12);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Полугодие Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, 6);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, 3);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, 1);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Декада Тогда
		Если День(НоваяДата) = 1 Тогда
			НоваяДата = НачалоДня(НоваяДата + 10*24*60*60);
		ИначеЕсли День(НоваяДата) = 11 Тогда
			НоваяДата = НачалоДня(НоваяДата + 10*24*60*60);
		Иначе
			НоваяДата = НачалоМесяца(ДобавитьМесяц(НоваяДата, 1));
		КонецЕсли;
	Иначе
		ВызватьИсключение Нстр("ru = 'Не корректная периодичность записи параметров лимитирования'");
	КонецЕсли;
	
	Возврат НоваяДата;

КонецФункции

Функция ОтнятьПериодОтДаты(Знач НоваяДата, Знач Периодичность) Экспорт
	
	Если Периодичность = Перечисления.Периодичность.Год Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, -12);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Полугодие Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, -6);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Квартал Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, -3);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц Тогда
		НоваяДата = ДобавитьМесяц(НоваяДата, -1);
	ИначеЕсли Периодичность = Перечисления.Периодичность.Декада Тогда
		Если День(НоваяДата) = 1 Тогда
			НоваяДата = НачалоДня(НоваяДата - 10*24*60*60);
		ИначеЕсли День(НоваяДата) = 11 Тогда
			НоваяДата = НачалоДня(НоваяДата - 10*24*60*60);
		Иначе
			НоваяДата = НачалоМесяца(ДобавитьМесяц(НоваяДата, -1));
		КонецЕсли;
	Иначе
		ВызватьИсключение Нстр("ru = 'Не корректная периодичность записи параметров лимитирования'");
	КонецЕсли;
	
	Возврат НоваяДата;

КонецФункции

Функция ПериодичностьПоПериоду(Знач Период) Экспорт

	НомерМесяца = Месяц(Период);
	
	ДоступныеПериоды = Новый Массив;
	ДоступныеПериоды.Добавить(Перечисления.Периодичность.Декада);
	Если День(Период) = 1 Тогда
		ДоступныеПериоды.Добавить(Перечисления.Периодичность.Месяц); 
		Если НомерМесяца = 1 ИЛИ НомерМесяца = 4 ИЛИ НомерМесяца = 7 ИЛИ НомерМесяца = 10 Тогда
			ДоступныеПериоды.Добавить(Перечисления.Периодичность.Квартал);
		КонецЕсли;
		Если НомерМесяца = 1 ИЛИ НомерМесяца = 7 Тогда
			ДоступныеПериоды.Добавить(Перечисления.Периодичность.Полугодие);
		КонецЕсли; 
		Если НомерМесяца = 1 Тогда
			ДоступныеПериоды.Добавить(Перечисления.Периодичность.Год);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДоступныеПериоды;

КонецФункции // ПериодичностьПоПериоду()

Функция ПолучитьВидыБюджетаПредставление() Экспорт
	
	ВидыБюджетаПредставление = Новый Соответствие;
	ВидыБюджетаПредставление.Вставить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств, "БДДС");
	ВидыБюджетаПредставление.Вставить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов, "БДР");    
	ВидыБюджетаПредставление.Вставить(ПланыВидовХарактеристик.ВидыБюджетов.ПустаяСсылка(), "Нет");
	
	Возврат ВидыБюджетаПредставление;
	
КонецФункции

Функция ПолучитьИсториюИзмененийПланированиеЗакупок() Экспорт

	ВидыБюджетаПредставление = ПолучитьВидыБюджетаПредставление();
	
	ВидыБюджета = Новый Массив;  
	ВидыБюджета.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств);
	ВидыБюджета.Добавить(ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов);

	Таблица = Новый ТаблицаЗначений;    
	Таблица.Колонки.Добавить("ДатаНачала");    
	Таблица.Колонки.Добавить("ДатаОкончания");  
	Таблица.Колонки.Добавить("ВидБюджета");   
	Таблица.Колонки.Добавить("ПланированиеЗакупок");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыЛимитирования.Период КАК Период,
	|	ПараметрыЛимитирования.ВидБюджета КАК ВидБюджета,
	|	ПараметрыЛимитирования.ПланированиеЗакупок КАК ПланированиеЗакупок
	|ИЗ
	|	РегистрСведений.ПараметрыЛимитирования КАК ПараметрыЛимитирования
	|ГДЕ
	|	ПараметрыЛимитирования.ВидБюджета В(&ВидыБюджета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидБюджета,
	|	Период
	|ИТОГИ ПО
	|	ВидБюджета";  
	
	Запрос.УстановитьПараметр("ВидыБюджета", ВидыБюджета);   
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВидБюджета = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаВидБюджета.Следующий() Цикл  	
		
		ВыборкаДетальныеЗаписи = ВыборкаВидБюджета.Выбрать();
		
		ПланированиеЗакупок = Неопределено; 
		НоваяСтрока = Неопределено;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если Не ВыборкаДетальныеЗаписи.ПланированиеЗакупок = ПланированиеЗакупок Тогда   			
				НоваяСтрока = Таблица.Добавить();    
				НоваяСтрока.ДатаНачала = ВыборкаДетальныеЗаписи.Период;
				НоваяСтрока.ВидБюджета = ВыборкаДетальныеЗаписи.ВидБюджета; 
				НоваяСтрока.ПланированиеЗакупок = ВыборкаДетальныеЗаписи.ПланированиеЗакупок;  
				
				ПланированиеЗакупок = ВыборкаДетальныеЗаписи.ПланированиеЗакупок;
			Иначе
				НоваяСтрока.ДатаОкончания = ВыборкаДетальныеЗаписи.Период;  			
			КонецЕсли;   		
			
		КонецЦикла;
	КонецЦикла;   
	
	ТаблицаИстория = Таблица.СкопироватьКолонки();  
	ТаблицаИстория.Колонки.Добавить("ВидБюджетаПредставление");
	
	СтруктураПараметров = Новый Структура("ДатаНачала, ПланированиеЗакупок");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если СтрокаТаблицы.ПланированиеЗакупок Тогда
			НоваяСтрока = ТаблицаИстория.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);     
		Иначе
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, СтрокаТаблицы);  
			СтруктураПараметров.ПланированиеЗакупок = Истина;
			
			МассивСтрок = Таблица.НайтиСтроки(СтруктураПараметров);   
			
			Если МассивСтрок.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаИстория.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);    	
			КонецЕсли;  			
		КонецЕсли;
		
	КонецЦикла;   
	
	СтруктураПараметров = Новый Структура("ДатаНачала, ПланированиеЗакупок");
	Для Каждого СтрокаТаблицыИстории Из ТаблицаИстория Цикл
		
		Если СтрокаТаблицыИстории.ПланированиеЗакупок Тогда   
			СтрокаТаблицыИстории.ВидБюджетаПредставление = ВидыБюджетаПредставление.Получить(СтрокаТаблицыИстории.ВидБюджета);  		
		Иначе 		
			СтруктураПараметров.ДатаНачала = СтрокаТаблицыИстории.ДатаНачала;	
			СтруктураПараметров.ПланированиеЗакупок = Истина;
			
			МассивСтрок = ТаблицаИстория.НайтиСтроки(СтруктураПараметров); 
			
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаТаблицыИстории.ВидБюджета = ПланыВидовХарактеристик.ВидыБюджетов.ПустаяСсылка();	
			КонецЕсли;  		
			СтрокаТаблицыИстории.ВидБюджетаПредставление = ВидыБюджетаПредставление.Получить(СтрокаТаблицыИстории.ВидБюджета);     		
		КонецЕсли; 
		
	КонецЦикла; 
	
	ТаблицаИстория.Свернуть("ДатаНачала, ВидБюджетаПредставление");  
	ТаблицаИстория.Сортировать("ДатаНачала"); 
	
	Возврат ТаблицаИстория;

КонецФункции

#КонецОбласти
	
#Область СлужебныйПрограммныйИнтерфейс

