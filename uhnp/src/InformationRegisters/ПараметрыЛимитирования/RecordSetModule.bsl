#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	Запись = ЭтотОбъект[0];
	Если НЕ Запись.ИспользоватьЛимитирование Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СпособОпределенияВалютыЛимитирования");
		МассивНепроверяемыхРеквизитов.Добавить("ПериодичностьЛимитирования");
		МассивНепроверяемыхРеквизитов.Добавить("КоличествоПериодовЛимитирования");
	КонецЕсли;
	
	Если Запись.СпособОпределенияВалютыЛимитирования 
		<> Перечисления.СпособыОпределенияВалютыЛимитирования.ВалютаЛимитированияЦФО Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВалютаПоУмолчанию");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	// Событие возникает только при записи из формы. 
	// Нужно для определения необходимости пересчета лимитов в событии при записи.
	
	ТребуетсяПересчетЛимитовПоПустомуНабору = 
		Отбор.ВидБюджета.Значение <> ЭтотОбъект[0].ВидБюджета
		ИЛИ Отбор.Период.Значение <> ЭтотОбъект[0].Период;
	
	Адрес = КонтрольЛимитовУХПовтИсп.ПолучитьАдресВременногоХранилища(
		Отбор.ВидБюджета.Значение, Отбор.Период.Значение);
		
	Данные = Новый Структура("ВидБюджета, Период, ТребуетсяПересчет", 
		Отбор.ВидБюджета.Значение, Отбор.Период.Значение);
	ПоместитьВоВременноеХранилище(Данные, Адрес);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() = 0 Тогда
		Адрес = КонтрольЛимитовУХПовтИсп.ПолучитьАдресВременногоХранилища(
			Отбор.ВидБюджета.Значение, Отбор.Период.Значение);
		Данные = ПолучитьИзВременногоХранилища(Адрес);
		
		ЗаписьКорректируетсяИзФормы = ТипЗнч(Данные) = Тип("Структура")
			И Данные.Свойство("ВидБюджета") 
			И Данные.ВидБюджета = Отбор.ВидБюджета.Значение 
			И Данные.Период = Отбор.Период.Значение;
		
		Если ЗаписьКорректируетсяИзФормы Тогда
			// Запись корректируется из формы
			ДополнительныеСвойства.Вставить("ВыполнитьПересчет", Данные.ТребуетсяПересчет);
		Иначе
			// Запись удаляется
			ДополнительныеСвойства.Вставить("ВыполнитьПересчет", Истина);
		КонецЕсли;
		УдалитьИзВременногоХранилища(Адрес);
	КонецЕсли;    

	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.ИспользоватьЛимитирование = Ложь Тогда
			Запись.ИспользоватьЛимитирование = Истина;
		КонецЕсли;
	КонецЦикла;  
	
	ДополнительныеСвойства.Вставить("Модифицированность", Модифицированность());
	ДополнительныеСвойства.Вставить("КоличествоЗаписей", Количество());

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	                             
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	Если Количество() > 0 ИЛИ ДополнительныеСвойства.ВыполнитьПересчет = Истина Тогда
		КонтрольЛимитовУХ.ВыполнитьПересчетЛимитов(ЭтотОбъект);
	КонецЕсли;

	// Это удаление записи  
	ЭтоУдалениеЗаписи = ДополнительныеСвойства.Модифицированность 
		И ДополнительныеСвойства.КоличествоЗаписей = 0
		И Не Модифицированность() И Количество() = 0;
	
	Если ЭтоУдалениеЗаписи Тогда
		РегистрыСведений.ПараметрыЛимитирования.УдалитьНастройкиПериода(Отбор.ВидБюджета.Значение, Отбор.Период.Значение);	
	КонецЕсли;  
	
КонецПроцедуры

#КонецОбласти

