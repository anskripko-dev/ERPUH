
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ЗакрытьПослеВыбора(); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ЗакрытьПослеВыбора(); 
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПараметры(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ДополнительныеПараметры = Новый Структура("Период, ВидБюджета", 
					ТекущиеДанные.Период, ТекущиеДанные.ВидБюджета);
		
	Оповещение = Новый ОписаниеОповещения("УдалитьЗаписьЗавершение", ЭтотОбъект, ДополнительныеПараметры); 
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить запись?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗакрытьПослеВыбора()
	
	Результат = Новый Структура("КонтрольЛимитов, КонтрольРезервов, Период, 
				|ПериодичностьЛимитирования, Учитывать, УчитыватьАналитикиСтатьиБюджетаПриКонтроле"); 
	ЗаполнитьЗначенияСвойств(Результат, Элементы.Список.ТекущиеДанные);
	
	Оповестить("ОтчетнаяДатаКомандаЗавершение", Результат, ЭтаФорма.ВладелецФормы);
	
	ЭтаФорма.Закрыть(Результат);

КонецПроцедуры    

&НаКлиенте
Процедура УдалитьЗаписьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьПараметрыНаСервере(ДополнительныеПараметры.Период, ДополнительныеПараметры.ВидБюджета); 
	
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервере
Процедура УдалитьПараметрыНаСервере(Период, ВидБюджета)
	
	Запись = РегистрыСведений.ПараметрыЛимитирования.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.ВидБюджета = ВидБюджета;   
	Запись.Удалить();

КонецПроцедуры

#КонецОбласти
