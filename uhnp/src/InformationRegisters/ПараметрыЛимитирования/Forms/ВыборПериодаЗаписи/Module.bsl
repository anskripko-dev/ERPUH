
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Год = НачалоГода(Параметры.Период);
	ВидБюджета = Параметры.ВидБюджета;
		
	ПараметрыЛимитов = РегистрыСведений.ПараметрыЛимитирования.ПараметрыЛимитированияЗаПериодом(ВидБюджета, Параметры.Период);
	
	ПредставлениеГода = Формат(Год, "ДФ=yyyy") + "г.";
	
	ДатаДвижений = ПараметрыЛимитов.ПериодДвижений;
	Если ДатаДвижений = Неопределено Тогда
		ДатаДвижений = Дата(1, 1, 1);
	КонецЕсли;
	
	Если ПараметрыЛимитов.ПараметрыДоПериод = Неопределено Тогда
		ПараметрыДоПериод 			= Дата(1, 1, 1);	
		ПараметрыДоПериодичность 	= Перечисления.Периодичность.Декада;
	Иначе
		ПараметрыДоПериод 			= ПараметрыЛимитов.ПараметрыДоПериод;
		ПараметрыДоПериодичность 	= ПараметрыЛимитов.ПараметрыДоПериодичность;
	КонецЕсли;
	
	Если ПараметрыЛимитов.ПараметрыПослеПериод = Неопределено Тогда
		ПараметрыПослеПериод 		= Дата(3999, 12, 31);	
		ПараметрыПослеПериодичность = Перечисления.Периодичность.Декада;
	Иначе
		ПараметрыПослеПериод 		= ПараметрыЛимитов.ПараметрыПослеПериод;	
		ПараметрыПослеПериодичность = ПараметрыЛимитов.ПараметрыПослеПериодичность;
	КонецЕсли;
	
	ПерезаполнитьДоступныеПериоды();
	
КонецПроцедуры // ПриСозданииНаСервере()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДоступныеПериоды      

&НаКлиенте
Процедура ДоступныеПериодыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОповеститьОВыборе(Элементы.ДоступныеПериоды.ТекущиеДанные.Период);  
	
КонецПроцедуры // ДоступныеПериодыВыбор()

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГодУвеличить(Команда)
	
	Если ДобавитьМесяц(Год, 12) >= ПараметрыПослеПериод Тогда
		Возврат;
	КонецЕсли;
	
	Год = ДобавитьМесяц(Год, 12);
	ПредставлениеГода = Формат(Год, "ДФ=yyyy") + "г.";
	ПерезаполнитьДоступныеПериоды();

КонецПроцедуры // ГодУвеличить()

&НаКлиенте
Процедура ГодУменьшить(Команда)
	
	Год = ДобавитьМесяц(Год, -12);
	
	Если Год < ДатаДвижений Тогда
		Год = НачалоГода(ДатаДвижений);
	КонецЕсли;
	
	Если Год < ПараметрыДоПериод Тогда
		Год = НачалоГода(ПараметрыДоПериод);
	КонецЕсли;
	
	ПредставлениеГода = Формат(Год, "ДФ=yyyy") + "г.";
	ПерезаполнитьДоступныеПериоды();

КонецПроцедуры // ГодУменьшить()

&НаКлиенте
Процедура Выбрать(Команда)
	
	ОповеститьОВыборе(Элементы.ДоступныеПериоды.ТекущиеДанные.Период);    
	
КонецПроцедуры // Выбрать()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПерезаполнитьДоступныеПериоды()
	
	Перем НоваяДата, НовыйПериод;
	ДоступныеПериоды.Очистить();
	
	НоваяДата = ПараметрыДоПериод;
	Если НоваяДата < Год Тогда
		НоваяДата = Год;
	КонецЕсли;
	
	Если ДатаВходитВУсловия(НоваяДата) Тогда 
		НовыйПериод = ДоступныеПериоды.Добавить();
		НовыйПериод.Период = НоваяДата;
		НовыйПериод.Периодичности = ПериодичностиСтрокой(НоваяДата);
	КонецЕсли;
	
	Пока НоваяДата < ПараметрыПослеПериод И НоваяДата < КонецГода(Год) Цикл
		
		НоваяДата = РегистрыСведений.ПараметрыЛимитирования.ДобавитьПериодКДате(НоваяДата, ПараметрыДоПериодичность);
		
		Если ДатаВходитВУсловия(НоваяДата) Тогда 
			НовыйПериод = ДоступныеПериоды.Добавить();
			НовыйПериод.Период = НоваяДата;
			НовыйПериод.Периодичности = ПериодичностиСтрокой(НоваяДата);
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ГодУменьшить.Доступность = (Год >= НачалоГода(ПараметрыДоПериод) И Год > НачалоГода(ДатаДвижений));
	Элементы.ГодУвеличить.Доступность = (Год < НачалоГода(ПараметрыПослеПериод));
	
КонецПроцедуры // ПерезаполнитьДоступныеПериоды()

&НаСервере
Функция ДатаВходитВУсловия(Знач НоваяДата)
	
	Возврат НоваяДата >= НачалоГода(Год) И 
			НоваяДата < КонецГода(Год) И 
			НоваяДата > ПараметрыДоПериод И 
			НоваяДата > ДатаДвижений И
			НоваяДата < ПараметрыПослеПериод;

КонецФункции // ДатаВходитВУсловия()

&НаСервере
Функция ПериодичностиСтрокой(Период)

	ДоступныеПериодичности = РегистрыСведений.ПараметрыЛимитирования.ПериодичностьПоПериоду(Период);
	ПредставленияПериодичностей = Новый Массив;
	Для Каждого Периодичность Из ДоступныеПериодичности Цикл
		ПредставленияПериодичностей.Добавить(Строка(Периодичность));		
	КонецЦикла;

	Возврат СтрСоединить(ПредставленияПериодичностей, ", ");

КонецФункции // ПериодичностиСтрокой()

#КонецОбласти