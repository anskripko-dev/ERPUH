
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачалаДействия = Параметры.Действует;     
	КонтролироватьПоВидуБюджета = Параметры.ВидБюджета;  
	
	ТекущиеПараметры = Новый Структура("Действует, ВидБюджета", 
					 Параметры.Действует, Параметры.ВидБюджета);   
							 
	ТекущийВидБюджета = КонтролироватьПоВидуБюджета;
	ТекущаяДатаНачалаДействия = ДатаНачалаДействия;

	БюджетДвиженияДенежныхСредств = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДвиженияДенежныхСредств;
	БюджетДоходовИРасходов = ПланыВидовХарактеристик.ВидыБюджетов.БюджетДоходовИРасходов; 
	
	УправлениеФормой();
	ЗаполнитьУстановкаСоответствий();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_УстановкаСоответствийМеждуВидамиБюджетов" Тогда
		ЗаполнитьУстановкаСоответствий();	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы  

&НаКлиенте
Процедура КонтролироватьПоВидуБюджетаПриИзменении(Элемент)
	
	Если ТекущиеПараметры.ВидБюджета = КонтролироватьПоВидуБюджета 
		И ЗначениеЗаполнено(ТекущиеПараметры.Действует) Тогда     
		ДатаНачалаДействия = ТекущиеПараметры.Действует;	
	Иначе    	
		ДатаНачалаДействия = ПолучитьДатуНачалаДействия();    
	КонецЕсли;   
		
	УправлениеФормой(); 
	ЗаполнитьУстановкаСоответствий();

КонецПроцедуры    

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)  
	
	Если Не ЗначениеЗаполнено(ДатаНачалаДействия) Тогда   	
		ШаблонСообщения = НСтр("ru = 'Значение реквизита ""%1"" не заполнено.'");	 
		ТекстСообщения = СтрШаблон(ШаблонСообщения, "Дата начала действия"); 	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);   		
	Иначе    	
		Если КонтролироватьПоВидуБюджета = ТекущийВидБюджета Тогда 	  
			
			ВидыБюджетаПредставление = ПолучитьВидыБюджетаПредставление();

			ШаблонПредупреждения = НСтр("ru = 'Дата изменения контроля по настройке ""%1"" уже установлена на %2'");
			ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, 
				 ВидыБюджетаПредставление.Получить(КонтролироватьПоВидуБюджета), 
				 Формат(ТекущаяДатаНачалаДействия, "ДФ=dd.MM.yyyy"));
				 
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			
		Иначе 	
			УстановитьНаСервере();    
			Закрыть(КодВозвратаДиалога.OK);
		КонецЕсли;  
		
	КонецЕсли;
	 	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеФормой()   
	
	Элементы.НадписьДокументУстановкаСоответствий.Видимость = ЗначениеЗаполнено(КонтролироватьПоВидуБюджета);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьДатуНачалаДействия()
	
	ДатаДействия = Дата(1, 1, 1);
	ТекущаяДата = ТекущаяДатаСеанса();
	
	ЭтоНачальноеЗаполнение = НачальноеЗаполнение();
	
	Если ЭтоНачальноеЗаполнение Тогда 
		
		ВидБюджетаДляПериодичности = ?(ЗначениеЗаполнено(КонтролироватьПоВидуБюджета), КонтролироватьПоВидуБюджета, ТекущийВидБюджета);    
		ПараметрыЛимитированияПериода = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(ВидБюджетаДляПериодичности, ТекущаяДата, -1);     
		
		Если Не ПараметрыЛимитированияПериода = Неопределено Тогда
			ДатаДействия = ПараметрыЛимитированияПериода.Период;	
		КонецЕсли;
		
	Иначе 	
		
		ВидБюджетаДляПериодичности = ?(ЗначениеЗаполнено(ТекущийВидБюджета), ТекущийВидБюджета, КонтролироватьПоВидуБюджета);
		Периодичность = КонтрольЛимитовУХ.ПериодичностьЛимитирования(ВидБюджетаДляПериодичности, , 1);
		
		ТаблицаИстория = РегистрыСведений.ПараметрыЛимитирования.ПолучитьИсториюИзмененийПланированиеЗакупок();
		Если ТаблицаИстория.Количество() > 0 Тогда
			ПоследняяНастройкаЛимитирования = ТаблицаИстория[ТаблицаИстория.Количество() - 1];
			ТекущаяДата = ?(ПоследняяНастройкаЛимитирования.ДатаНачала > ТекущаяДата, ПоследняяНастройкаЛимитирования.ДатаНачала, ТекущаяДата);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Периодичность) Тогда
			ДатаДействия = КэшируемыеПроцедурыУХ.ДатаКонцаПериода(ТекущаяДата, Периодичность) + 1;
		КонецЕсли;      
		
	КонецЕсли;
	
	Возврат ДатаДействия; 
	
КонецФункции  

&НаСервере
Процедура УстановитьНаСервере()   
	
	ТекущаяДата = ТекущаяДатаСеанса();  

	ПараметрыБДДС = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(БюджетДвиженияДенежныхСредств, ТекущаяДата, -1);
	ПараметрыБДР = КонтрольУХВызовСервера.ПараметрыЛимитированияПериода(БюджетДоходовИРасходов, ТекущаяДата, -1);
	
	ЭтоБДДС = (БюджетДвиженияДенежныхСредств = КонтролироватьПоВидуБюджета);
	ЭтоБДР = (БюджетДоходовИРасходов = КонтролироватьПоВидуБюджета);
	
	СоздатьЗаписьПараметрыЛимитирования(БюджетДвиженияДенежныхСредств, ПараметрыБДДС, ЭтоБДДС);
	СоздатьЗаписьПараметрыЛимитирования(БюджетДоходовИРасходов, ПараметрыБДР, ЭтоБДР);    
	
КонецПроцедуры    

&НаСервере
Процедура СоздатьЗаписьПараметрыЛимитирования(ВидБюджета, ПараметрыЛимитирования, ПланированиеЗакупок)
	
	Если ПараметрыЛимитирования = Неопределено Тогда
		
		Запись = РегистрыСведений.ПараметрыЛимитирования.СоздатьМенеджерЗаписи();    
		Запись.Период = ДатаНачалаДействия; 
		Запись.ВидБюджета = ВидБюджета;
		Запись.ПланированиеЗакупок = ПланированиеЗакупок;
		Запись.СпособОпределенияВалютыЛимитирования = Перечисления.СпособыОпределенияВалютыЛимитирования.ВалютаУпрУчета;
		Запись.ПериодичностьЛимитирования = Перечисления.Периодичность.Год;
		Запись.ПериодичностьПланирования = Перечисления.Периодичность.Год;    
		Запись.КонтрольЛимитов 	= Перечисления.РежимыКонтроляДокументов.Информировать;
		Запись.КонтрольРезервов = Перечисления.РежимыКонтроляДокументов.НеКонтролировать;  
		Запись.КоличествоПериодовЛимитирования = 1;
		
		Запись.Записать();  	
		
	Иначе
		
		Если ПланированиеЗакупок Тогда
			
			Если ПараметрыЛимитирования.Период < ДатаНачалаДействия	Тогда
				
				Запись = РегистрыСведений.ПараметрыЛимитирования.СоздатьМенеджерЗаписи();    
				Запись.Период = ДатаНачалаДействия;
				ЗаполнитьЗначенияСвойств(Запись, ПараметрыЛимитирования, , "Период, ПланированиеЗакупок");   
				Запись.ПланированиеЗакупок = ПланированиеЗакупок;
				Запись.Записать();  		
				
				РегистрыСведений.ПараметрыЛимитирования.СкопироватьНастройкиПериода(
								ВидБюджета, ПараметрыЛимитирования.Период, ДатаНачалаДействия); 
				
			КонецЕсли; 
			
		Иначе
			
			Если ПараметрыЛимитирования.ПланированиеЗакупок 
				И ПараметрыЛимитирования.Период < ДатаНачалаДействия Тогда
				
				Запись = РегистрыСведений.ПараметрыЛимитирования.СоздатьМенеджерЗаписи();    
				Запись.Период = ДатаНачалаДействия;
				ЗаполнитьЗначенияСвойств(Запись, ПараметрыЛимитирования, , "Период, ПланированиеЗакупок");   
				Запись.ПланированиеЗакупок = ПланированиеЗакупок;
				Запись.Записать();  		
				
				РегистрыСведений.ПараметрыЛимитирования.СкопироватьНастройкиПериода(
								ВидБюджета, ПараметрыЛимитирования.Период, ДатаНачалаДействия);    
				
			КонецЕсли; 		
			
		КонецЕсли;    
		
		Если ПараметрыЛимитирования.Период = ДатаНачалаДействия Тогда
			
			НаборЗаписей = РегистрыСведений.ПараметрыЛимитирования.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Период.Установить(ПараметрыЛимитирования.Период);
			НаборЗаписей.Отбор.ВидБюджета.Установить(ПараметрыЛимитирования.ВидБюджета);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей[0].ПланированиеЗакупок = ПланированиеЗакупок;	   
				НаборЗаписей.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;    
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУстановкаСоответствий() 
	
	Если Не ЗначениеЗаполнено(КонтролироватьПоВидуБюджета) Тогда
		Возврат;
	КонецЕсли;  
	
	Элементы.НадписьДокументУстановкаСоответствий.ЦветТекста = Новый Цвет;
	НадписьДокументУстановкаСоответствий = "Ввести соответствие между видами бюджетов";
	ДокументУстановкаСоответствий = Неопределено;

	Если Не ЗначениеЗаполнено(ДатаНачалаДействия) Тогда
		Возврат;
	КонецЕсли; 
    
	ДанныеДокумента = ПолучитьДокументУстановкаСоответствий();    
	
	СтатусПроведения = "";     	
	Если ЗначениеЗаполнено(ДанныеДокумента.Документ) Тогда
		
		Если ДанныеДокумента.Проведен = Ложь Тогда
			СтатусПроведения = " (не проведен)";
			Элементы.НадписьДокументУстановкаСоответствий.ЦветТекста = Новый Цвет(178, 34, 34);
		КонецЕсли;  
		
		ДокументУстановкаСоответствий = ДанныеДокумента.Документ;  
		
		НадписьДокументУстановкаСоответствий = "Установка соответствий " + ДанныеДокумента.Номер 
											 + " от " + Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy") + СтатусПроведения;

	КонецЕсли;  
										 
	Элементы.НадписьДокументУстановкаСоответствий.Заголовок = НадписьДокументУстановкаСоответствий;  									 
			
КонецПроцедуры 

&НаСервере 
Функция ПолучитьДокументУстановкаСоответствий()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаСоответствийМеждуВидамиБюджетов.Ссылка КАК Документ,
	|	УстановкаСоответствийМеждуВидамиБюджетов.Проведен КАК Проведен,
	|	УстановкаСоответствийМеждуВидамиБюджетов.Номер КАК Номер,
	|	УстановкаСоответствийМеждуВидамиБюджетов.Дата КАК Дата
	|ИЗ
	|	Документ.УстановкаСоответствийМеждуВидамиБюджетов КАК УстановкаСоответствийМеждуВидамиБюджетов
	|ГДЕ
	|	НЕ УстановкаСоответствийМеждуВидамиБюджетов.ПометкаУдаления
	|	И УстановкаСоответствийМеждуВидамиБюджетов.ВидБюджетаПриемник = &ВидБюджетаПриемник
	|	И УстановкаСоответствийМеждуВидамиБюджетов.ДатаПерехода = &ДатаПерехода";
	
	Запрос.УстановитьПараметр("ВидБюджетаПриемник", КонтролироватьПоВидуБюджета);
	Запрос.УстановитьПараметр("ДатаПерехода", ДатаНачалаДействия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеДокумента = РезультатЗапроса.Выбрать();
	ДанныеДокумента.Следующий();
	
	Возврат ДанныеДокумента; 

КонецФункции

&НаКлиенте
Процедура НадписьДокументУстановкаСоответствийНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	Если ДокументУстановкаСоответствий.Пустая() Тогда  
		
		ПараметрыЗаполнения = Новый Структура;    
		ПараметрыЗаполнения.Вставить("ДатаПерехода", ДатаНачалаДействия);
		ПараметрыЗаполнения.Вставить("ВидБюджетаПриемник", КонтролироватьПоВидуБюджета);
		
		ВидБюджетаИсточник = ?(КонтролироватьПоВидуБюджета = БюджетДвиженияДенежныхСредств, 
							 БюджетДоходовИРасходов, БюджетДвиженияДенежныхСредств);
		ПараметрыЗаполнения.Вставить("ВидБюджетаИсточник", ВидБюджетаИсточник);  	
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, СозданиеДокументаИзНастроекКонтроля", ПараметрыЗаполнения);
		
		ОткрытьФорму("Документ.УстановкаСоответствийМеждуВидамиБюджетов.ФормаОбъекта", ПараметрыФормы);
	Иначе       
		
		ПараметрыФормы = Новый Структура("Ключ", ДокументУстановкаСоответствий);
		ОткрытьФорму("Документ.УстановкаСоответствийМеждуВидамиБюджетов.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьВидыБюджетаПредставление()
	
	ВидыБюджетаПредставление = РегистрыСведений.ПараметрыЛимитирования.ПолучитьВидыБюджетаПредставление();     
	
	Возврат ВидыБюджетаПредставление;   
	
КонецФункции

&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	ЗаполнитьУстановкаСоответствий();
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция НачальноеЗаполнение()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрНакопления.ОперацииБюджетов КАК ОперацииБюджетов";
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Возврат РезультатЗапроса.Пустой();   
	
КонецФункции

#КонецОбласти