
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ЗаполнитьПланыСчетовМСФО(ПараметрыОбновления = Неопределено) Экспорт

	ПланСчетовМСФО = Справочники.СчетаБД.ПолучитьСчетПоСчетСсылка(ПланыСчетов.МСФО.Вспомогательный).Владелец;
	ПустойПС = Справочники.ПланыСчетовБД.ПустаяСсылка();
	
	Замены = Новый Структура(
					"ГруппыВНАМСФО, 
					|ВидыВременныхРазниц,
					|НастройкиРаспределенияЗатратМСФО,
					|ПараметрыАмортизацииВНАМСФО,
					|ПараметрыВыбытияВНАМСФО,
					|ПараметрыОбесцененияВНАМСФО,
					|ПараметрыПереоценкиВНАМСФО,
					|ПараметрыРасчетаРезервовПоЗапасам,
					|ПараметрыУчетаФинансовыхИнструментовМСФО,
					|СпособыОтраженияРасходовПоАмортизацииМСФО");
	
	Отбор = Новый Структура("ПланСчетовБД", ПустойПС);
	Для каждого ИмяСправочника Из Замены Цикл
		
		Выборка = Справочники[ИмяСправочника.Ключ].Выбрать(,, Отбор);
		Пока Выборка.Следующий() Цикл
			
			Объект = Выборка.ПолучитьОбъект();
			Объект.ПланСчетовБД = ПланСчетовМСФО;
			ОбновлениеИнформационнойБазыБМ.ЗаписатьОбъект(Объект);
			
		КонецЦикла;
	
	КонецЦикла; 
	
	Замены = Новый Структура(
					"НастройкиРеклассификацииАПСчетов, 
					|СчетаУчетаЗадолженностиИРезервов,
					|СчетаУчетаЗапасовИРезервовМСФО,
					|СчетаУчетаЧАдляАПСП");
	
	Если Не ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
		Замены.Удалить("СчетаУчетаЧАдляАПСП");//БМ, НМ			
	КонецЕсли;
	
	Для каждого ИмяСправочника Из Замены Цикл               
		
		Выборка = РегистрыСведений[ИмяСправочника.Ключ].Выбрать(Отбор);
		Пока Выборка.Следующий() Цикл
			
			Объект = Выборка.ПолучитьМенеджерЗаписи();
			Объект.ПланСчетовБД = ПланСчетовМСФО;
			Объект.Записать();
						
		КонецЦикла;
	
	КонецЦикла; 
	
КонецПроцедуры

#КонецЕсли