//Ведутенко С.А. от 02.01.2024 Выполнение задач №000047803
//
Процедура ПолучитьСоответствиеТеговXDTOиРеквизитов(сТип, с) Экспорт
	
	сТип.ТегXDTO = "registrCompletedShipmentsUnderGovernmentContracts"; 		
	сТип.ПредставлениеТипа="рег. тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам"; 
	сТип.ПроцедураДоЗаполнения = Истина;
	сТип.ИспользоватьНаборЗаписей = Ложь;
	
	//"Прямое" заполнение значений ведется для отдельных Записей в цикле по принятому Набору
	//"ДополнительныеСвойства" есть только у Набора, поэтому Дополнительные свойства регистров сведений - всегда в ТЗ, т.е. все сразу (отдельно для Записи доп. свойство не прикрепить)
	
	//"Прямое" заполнение
	с.Вставить("ДокументОтгрузки"				, Новый Структура("Тег, Менеджер", "documentShipping"			,"Документы.РеализацияТоваровУслуг"));
	с.Вставить("ДокументОплаты"					, Новый Структура("Тег, Менеджер", "documentPayment"			,"Документы.ПоступлениеБезналичныхДенежныхСредств"));
	с.Вставить("ГосударственныйКонтракт"		, Новый Структура("Тег, Менеджер", "governmentContractGuid"		,"Справочники.ГосударственныеКонтракты"));
	с.Вставить("ИдентификационныйКодЗакупки"	, Новый Структура("Тег, Менеджер", "identificationCodePurchase"	,"Справочники.тн_ИдентификационныеКодыЗакупок"));
	с.Вставить("РучнойВвод"						, "manualRecord");
		
КонецПроцедуры     

//Ведутенко С.А. от 02.01.2024 Выполнение задач №000047803
//	
Процедура ПолучитьЗаписьРС(МенеджерЗаписи, сXDTO) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_СовершенныеОтгрузкиПоГосударственнымКонтрактам.СоздатьМенеджерЗаписи();

КонецПроцедуры     

//Ведутенко С.А. от 02.01.2024 Выполнение задач №000047803
//
Процедура ДозаполнитьОбъект(МенеджерЗаписи, Отказ, Результат, сXDTO) Экспорт
	
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(сXDTO.counterpartyContractGuid));           
	
	Если ОбщегоНазначения.СсылкаСуществует(ДоговорКонтрагента) Тогда	
		МенеджерЗаписи.ДоговорКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "ВерсияСоглашения");
	КонецЕсли;
	
	Если сXDTO.isDelete Тогда
		МенеджерЗаписи.Удалить();  
		МенеджерЗаписи = Неопределено;
		Отказ = Истина;
	КонецЕсли;
			
КонецПроцедуры

#КонецЕсли
