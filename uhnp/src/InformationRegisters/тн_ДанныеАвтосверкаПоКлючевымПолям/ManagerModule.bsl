
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ДобавитьОбновитьЗапись(СтруктураЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);
	МенеджерЗаписи.Прочитать();
	
	ЗапросДанных = Неопределено;
	ЭтоЗапросДанных = СтруктураЗаписи.Свойство("ЗапросДанных", ЗапросДанных);
	
	ОтветНаЗапрос = Неопределено;
	ЭтоОтветНаЗапрос = СтруктураЗаписи.Свойство("ОтветНаЗапрос", ОтветНаЗапрос);
	
	Если МенеджерЗаписи.Выбран() Тогда
		Если ЭтоЗапросДанных Тогда
			МенеджерЗаписи.ЗапросДанных = ЗапросДанных;
		Иначе
			МенеджерЗаписи.ОтветНаЗапрос = ОтветНаЗапрос;
			// НАЧАЛО Белоконенко Денис 26.04.2023 Выполнение задач №000045304
			МенеджерЗаписи.ЕстьОшибки 	= СтруктураЗаписи.ЕстьОшибки;
			МенеджерЗаписи.ТекстОшибки 	= СтруктураЗаписи.ТекстОшибки;
			// КОНЕЦ Белоконенко Денис 26.04.2023 Выполнение задач №000045304
		КонецЕсли;	
	Иначе
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);	
	КонецЕсли;
	
	Если ЭтоЗапросДанных Тогда
		МенеджерЗаписи.ДатаОтправкиЗапроса = ТекущаяДатаСеанса();
	Иначе
		МенеджерЗаписи.ДатаПолученияОтвета = ТекущаяДатаСеанса();
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
		
КонецФункции

Функция ПолучитьЗапись(СтруктураЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.тн_ДанныеАвтосверкаПоКлючевымПолям.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи;
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции

