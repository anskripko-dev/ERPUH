
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		
		ЗаполнитьРеквизитыНастройки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыНастройки() 
		
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеВнешнимИБ.Владелец КАК Владелец,
	|	СоответствиеВнешнимИБ.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных,
	|	СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ КАК ОписаниеОбъектаВИБ,
	|	СоответствиеВнешнимИБ.ТипОбъектаКонсолидации КАК ТипОбъектаКонсолидации,
	|	СоответствиеВнешнимИБ.ТипОбъектаВИБ КАК ТипОбъектаВИБ,
	|	СоответствиеВнешнимИБ.ОписаниеОбъектаВИБ.Наименование КАК НаименованиеОбъектаВИБ
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ КАК СоответствиеВнешнимИБ
	|ГДЕ
	|	СоответствиеВнешнимИБ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Запись.НастройкаСоответствия);
	Результат=Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	ТипБД=Результат.Владелец;
	ОписаниеОбъектаВИБ		= Результат.ОписаниеОбъектаВИБ; 
	ТипОбъектаКонсолидации	= Результат.ТипОбъектаКонсолидации;
	ИмяОбъектаМетаданных	= Результат.ИмяОбъектаМетаданных;
		
	Если Результат.ТипОбъектаКонсолидации="ВидСубконто" Тогда
		
		ТаблицаАналитики=Метаданные.НайтиПоТипу(Результат.ИмяОбъектаМетаданных.ТипЗначения.Типы()[0]).ПолноеИмя();
		
	Иначе
		
		ТаблицаАналитики=Результат.ТипОбъектаКонсолидации+"."+Результат.ИмяОбъектаМетаданных;
				
	КонецЕсли; 
	
	ТипЗначенияВИБ=Результат.ТипОбъектаВИБ+"Ссылка."+Результат.НаименованиеОбъектаВИБ;
	
КонецПроцедуры // ЗаполнитьРеквизитыНастройки() 

&НаКлиенте
Процедура ТипБДПриИзменении(Элемент)
	
	ОчиститьПоляЗаписи();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПоляЗаписи(СтрокаИсключения="")
	
	МассивИсключения=СтрРазделить(СтрокаИсключения,",",Ложь); 
	
	МетаданныеРегистра=Метаданные.РегистрыСведений.СоответствиеОбъектовТекущейИВнешнихИБ;
	
	Для Каждого Измерение ИЗ МетаданныеРегистра.Измерения Цикл
		
		Если МассивИсключения.Найти(Измерение.Имя)=Неопределено Тогда
			
			Запись[Измерение.Имя]="";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Реквизит ИЗ МетаданныеРегистра.Реквизиты Цикл
		
		Если МассивИсключения.Найти(Реквизит.Имя)=Неопределено Тогда
			
			Запись[Реквизит.Имя]="";
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОчиститьПоляЗаписи() 

&НаСервере
Процедура НастройкаСоответствияПриИзмененииНаСервере()
	
	ЗаполнитьРеквизитыНастройки();
	ОчиститьПоляЗаписи("ИспользуемаяИБ,НастройкаСоответствия");

КонецПроцедуры

&НаКлиенте
Процедура НастройкаСоответствияПриИзменении(Элемент)
	НастройкаСоответствияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемаяИБПриИзменении(Элемент)
	
	ОчиститьПоляЗаписи("ОбъектТекущейИБ,ТипОбъектаТекущейИБ,ИмяОбъектаТекущейИБ,GUIDОбъектаТекущейИБ,НастройкаСоответствия,ИспользуемаяИБ");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектТекущейИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	
	СтруктураПараметров=Новый Структура("ТекущаяСтрока,РежимВыбора",Запись.ОбъектТекущейИБ,Истина);
	
	Если ТипОбъектаКонсолидации="ВидСубконто" И ТаблицаАналитики="Справочник.ПроизвольныйКлассификаторУХ" Тогда
		
		СтруктураПараметров.Вставить("Отбор",Новый Структура("Владелец",ИмяОбъектаМетаданных));
		ОткрытьФорму("Справочник.ПроизвольныйКлассификаторУХ.ФормаВыбора",СтруктураПараметров,Элемент);
		
	Иначе
		
		ОткрытьФорму(ТаблицаАналитики+".ФормаВыбора",СтруктураПараметров,Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектВнешнейИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтруктураПараметров=ПолучитьДанныеСправочникаВнешнейИБ();
	
	Если ЗначениеЗаполнено(Запись.ОбъектВнешнейИБ) Тогда
		
		СтруктураПараметров.Вставить("ТекущаяСсылка",Запись.ОбъектВнешнейИБ);
		
	КонецЕсли;
				
    Оповещение = Новый ОписаниеОповещения("НаименованиеНачалоВыбораЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.СоответствиеВнешнимИБ.Форма.ФормаВыбораЗначенийВИБ", 
					СтруктураПараметров,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ДанныеОбъектаВИБ=Результат;
    
    Если ТипЗнч(ДанныеОбъектаВИБ)=Тип("СписокЗначений") Тогда
        
        Запись.ОбъектВнешнейИБ 					= СтрЗаменить(ДанныеОбъектаВИБ[0].Значение,"{#@UUID@#}","");
        Запись.НаименованиеОбъектаВнешнейИБ 	= ДанныеОбъектаВИБ[0].Представление;
		
		Модифицированность=Истина;
		
    КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Функция ПолучитьДанныеСправочникаВнешнейИБ()
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("Использование77",			Ложь);
	СтруктураПараметров.Вставить("КодНеИспользуется",		Ложь);
	СтруктураПараметров.Вставить("ТипБД",					ТипБД);
	СтруктураПараметров.Вставить("ВнешняяИнформационнаяБаза",Запись.ИспользуемаяИБ);
	СтруктураПараметров.Вставить("ОписаниеОбъектаБД",		ОписаниеОбъектаВИБ);
		
	Возврат СтруктураПараметров;
		
КонецФункции // ПолучитьДанныеСправочникаВнешнейИБ()


&НаКлиенте
Процедура ОбъектВнешнейИБОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	
	СтрокаGUID=Запись.ОбъектВнешнейИБ;
	
	Если ПустаяСтрока(СтрокаGUID) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеОбъекта=ПолучитьДанныеОбъектаВИБ(СтрокаGUID);
	
	Имя = "ОбщаяФорма.ОтображениеЭлементаWS_Управляемая";
	ОткрытьФорму(Имя, Новый Структура("Расшифровка, ИспользуемаяИБ", ДанныеОбъекта, Запись.ИспользуемаяИБ));
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеОбъектаВИБ(СтрокаGUID)
	
	ДанныеОбъекта=Новый Структура;
	ДанныеОбъекта.Вставить("Значение",СтрокаGUID);
	ДанныеОбъекта.Вставить("ТипЗначения",ТипЗначенияВИБ);

	Возврат ДанныеОбъекта;
			
КонецФункции // ПолучитьДанныеОбъектаВИБ()


