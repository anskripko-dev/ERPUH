// Функция получает элемент справочника - ключ Аналитики параметров закупки.
//
// Параметры:
//	ПараметрыАналитики - Выборка, Структура - Содержит полями ключа:
//		* Организатор - СправочникСсылка.Организации.
//		* СпособЗакупки - ПеречислениеСсылка.СпособыВыбораПоставщика.
//		* Электронно - Булево.
//		* Обоснование - Булево.
//		* ДлительностьПодготовки - Число,
//		* ДлительностьПроцедуры - Число,
//		* ЗакупкаИВПиЛС - Булево.
//		* ГосТайна - Булево.
//		* ПриоритетМСП - Булево.
//		* СубподрядчикиМСП - Булево.
//		* ФлагиВозможностиИзменения - Число.
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиПараметровЗакупки - Созданный элемент справочника.
//
Функция ЗначениеКлючаАналитики(ПараметрыАналитики) Экспорт

	НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0
			И Не ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;

		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].КлючАналитики) Тогда
			Результат = НаборЗаписей[0].КлючАналитики;
		Иначе
			Результат = СоздатьКлючАналитики(ПараметрыАналитики);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

КонецФункции

// Функция получает элемент справочника - ключ аналитики планирования.
//
// Параметры:
//	ПараметрыАналитики - Выборка или Структура  с полями "Организатор,СпособЗакупки,Электронно,Обоснование,ДлительностьПодготовки,ДлительностьПроцедуры,ЗакупкаИВПиЛС,ГосТайна,ПриоритетСМП,СубподрядчикиСМП,ФлагиВозможностиИзменения".
//
// Возвращаемое значение:
//	СправочникСсылка.КлючиПараметровЗакупки - Созданный элемент справочника.
//
Функция СоздатьКлючАналитики(ПараметрыАналитики, ЗаписьПриОбновленииИБ = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Если ЗначениеЗаполнено(ПараметрыАналитики.СпособЗакупки) Тогда
	//		
		НаборЗаписей = ПолучитьНаборЗаписей(ПараметрыАналитики);
		
		Если НаборЗаписей <> Неопределено Тогда
			
			НачатьТранзакцию(); // Создание нового ключа аналитики.
			Попытка
				СтрокаНабора = НаборЗаписей[0];
				
				СправочникОбъект = Справочники.КлючиПараметровЗакупки.СоздатьЭлемент();
				//СправочникОбъект.Наименование = ПолучитьПолноеНаименованиеКлючаАналитики(СтрокаНабора);
				ЗаполнитьЗначенияСвойств(СправочникОбъект, СтрокаНабора, СтрокаВсеАналитикиКлюча());
				Если ЗаписьПриОбновленииИБ Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
				Иначе
					СправочникОбъект.Записать();
				КонецЕсли;

				Результат = СправочникОбъект.Ссылка;

				СтрокаНабора.КлючАналитики = Результат;
				
				Если ЗаписьПриОбновленииИБ Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Ложь, Истина);
				Иначе
					НаборЗаписей.Записать(Ложь);
				КонецЕсли;
				ЗафиксироватьТранзакцию();
			Исключение
				// во время инициализации ключа, данный ключ уже был создан в ИБ другим сеансом.
				НаборЗаписей.Прочитать();
				Если НаборЗаписей.Количество() = 0 Тогда // запись не создана из-за ошибки заполнения полей.
					ОтменитьТранзакцию();
					ВызватьИсключение;
				Иначе
					ОтменитьТранзакцию();
					Результат = НаборЗаписей[0].КлючАналитики;
				КонецЕсли;
			КонецПопытки;

			Возврат Результат;
			
		КонецЕсли;
	//КонецЕсли;
	
КонецФункции

// Возвращает параметры генерации ключей аналитики. Используется в обработчиках обновления.
// Возвращаемое значение:
//	Структура - Структура содержит поля: ЕстьНеобработанныеКлючи, ИзмененаАналитика, СоздаватьНовыеКлючи.
Функция ПараметрыЗаполненияКлючейАналитики() Экспорт
	Возврат Новый Структура("ИзмененаАналитика,СоздаватьВКлючи", Ложь, Истина);
КонецФункции

// Заполняет поле АналитикаПараметровЗакупки в коллекции, содержащей статью бюджета, аналитику1-3, Направление.
//
// Параметры:
//
//	Коллекция - ТабличнаяЧасть - Коллекция, в которой производится заполнение аналитики параметров закупки.
//
//	ИменаПолей - Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля берется из имени ключа.
//		секция идентификации {Организатор,СпособЗакупки,Электронно,Обоснование,ДлительностьПодготовки,ДлительностьПроцедуры,ЗакупкаИВПиЛС,ГосТайна,ПриоритетСМП,СубподрядчикиСМП,ФлагиВозможностиИзменения, АналитикаПараметровЗакупки},
//	
//	ПараметрыЗаполнения - Структура - см. метод ПараметрыЗаполненияКлючейАналитики()
//
// Пример 1:
//	ИменаПолей = РегистрыСведений.АналитикаПараметровЗакупки.ИменаПолейКоллекцииПоУмолчанию();
//	РегистрыСведений.АналитикаПараметровЗакупки.ЗаполнитьВКоллекции(ДвиженияОперации, ИменаПолей);
//
// Пример 2:
//	РегистрыСведений.АналитикаПараметровЗакупки.ЗаполнитьВКоллекции(ДвиженияОперации);
//
Процедура ЗаполнитьВКоллекции(Коллекция, 
								ИменаПолей = Неопределено, ДополнитьКлюч = Ложь, ПараметрыЗаполнения = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = ПараметрыЗаполненияКлючейАналитики();
	КонецЕсли;
	
	Если ДополнитьКлюч Тогда
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейДополненияКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
	Иначе
		Если ИменаПолей = Неопределено Тогда
			ИменаПолей = ИменаПолейКоллекцииПоУмолчанию();
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей));
		Запрос.УстановитьПараметр("Коллекция", Коллекция);
		
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.АналитикаПараметровЗакупки) Тогда
			Если ПараметрыЗаполнения.СоздаватьВКлючи Тогда
				КлючАналитики = ЗначениеКлючаАналитики(Выборка);
			Иначе
				ТекстИсключения = НСтр("ru = 'Ошибка при заполнении ключей в коллекции: есть аналитики, по которым ключи еще не созданы.'");
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.КлючиПараметровЗакупки,
					,
					ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		Иначе
			КлючАналитики = Выборка.АналитикаПараметровЗакупки;
		КонецЕсли;
		Если ДополнитьКлюч Тогда
			Коллекция[Выборка.Индекс][ИменаПолей.ЗаполняемаяАналитикаПараметровЗакупки] = КлючАналитики;
		Иначе
			Коллекция[Выборка.Индекс][ИменаПолей.АналитикаПараметровЗакупки] = КлючАналитики;
		КонецЕсли;
		ПараметрыЗаполнения.ИзмененаАналитика = Истина;
	КонецЦикла;
КонецПроцедуры

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики параметров закупки.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//		содержит две секции, если значение ключа Неопределено, то имя поля должно браться из имени ключа.
//		секция идентификации {Организатор,СпособЗакупки,Электронно,Обоснование,ДлительностьПодготовки,ДлительностьПроцедуры,ЗакупкаИВПиЛС,ГосТайна,ПриоритетСМП,СубподрядчикиСМП,ФлагиВозможностиИзменения},
//			все ключи заданы.
//
Функция ИменаПолейКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура(СтрокаВсеАналитикиКлюча());
	//ИменаПолей.Вставить("СпособЗакупки", "СпособЗакупки");
	Для Каждого КлючЗначение Из ИменаПолей Цикл
		ИменаПолей[КлючЗначение.Ключ] = КлючЗначение.Ключ;
	КонецЦикла;
	ИменаПолей.Вставить("АналитикаПараметровЗакупки", "АналитикаПараметровЗакупки");
	
	Возврат ИменаПолей;
КонецФункции

// Возвращает структуру полей выбора информации из коллекции для формирования аналитики параметров закупки.
//
// Возвращаемое значение:
//	Структура - содержит реальные имена полей коллекции для получения и формирования аналитики.
//
Функция ИменаПолейДополненияКоллекцииПоУмолчанию() Экспорт
	
	ИменаПолей = Новый Структура(СтрокаВсеАналитикиКлюча());
	ИменаПолей.Вставить("КлючПараметровЗакупки", "КлючПараметровЗакупки");
	ИменаПолей.Вставить("ЗаполняемыйКлючПараметровЗакупки", "КлючПараметровЗакупки");
	
	Возврат ИменаПолей;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаВсеАналитикиКлюча()
	
	Возврат "Организатор,СпособЗакупки,УсловияОплаты,Электронно,Обоснование,ДлительностьПодготовки,ДлительностьПроцедуры,ЗакупкаИВПиЛС,ГосТайна,ПриоритетСМП,СубподрядчикиСМП,ФлагиВозможностиИзменения";
	
	
КонецФункции

#Область Прочее

Функция ПолучитьНаборЗаписей(ПараметрыАналитики)
	
	// В параметрах аналитики могут быть не все свойства
	СтруктураАналитики = Новый Структура(СтрокаВсеАналитикиКлюча());
	ЗаполнитьЗначенияСвойств(СтруктураАналитики, ПараметрыАналитики);
	//Если НЕ ЗначениеЗаполнено(СтруктураАналитики.СпособЗакупки) Тогда
	//	Возврат Неопределено
	//Иначе
		НаборЗаписей = РегистрыСведений.АналитикаПараметровЗакупки.СоздатьНаборЗаписей();
		
		Для Каждого КлючЗначение Из СтруктураАналитики Цикл
			НаборЗаписей.Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
		КонецЦикла;
		
		НоваяСтрока = НаборЗаписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитики, СтрокаВсеАналитикиКлюча());
		ПроверитьЗаполнениеПоляСтруктуры(НоваяСтрока);
		Возврат НаборЗаписей;
	//КонецЕсли;
	
КонецФункции

Функция ПолучитьПолноеНаименованиеКлючаАналитики(МенеджерЗаписи)

	Возврат СокрЛП(МенеджерЗаписи.СпособЗакупки) + "; " 
		+ ?(МенеджерЗаписи.Электронно,	НСтр("ru = 'Электронно'"), "")
		+ ?(ЗначениеЗаполнено(МенеджерЗаписи.Организатор),	СокрЛП(МенеджерЗаписи.Организатор) + "; ", "");
	
КонецФункции

Процедура ПроверитьЗаполнениеПоляСтруктуры(МенеджерЗаписи)

	//Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.СпособЗакупки)
	//	ВызватьИсключение НСтр("ru = 'Должно быть заполнено значение параметра ""Способ закупки""'");
