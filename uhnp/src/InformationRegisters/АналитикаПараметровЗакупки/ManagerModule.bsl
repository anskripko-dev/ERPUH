КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКлючейАналитикиВКоллекции

Функция ТекстЗначенияКлючейАналитикиВКоллекции(ИменаПолей)
	
	ВсеРеквизитыКлюча = Новый Структура(СтрокаВсеАналитикиКлюча());
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Коллекция.НомерСтроки - 1 КАК Индекс,
	               |	&ПолеАналитикаПараметровЗакупки КАК АналитикаПараметровЗакупки,
	               |	&ПолеОрганизатор КАК Организатор,
	               |	&ПолеСпособЗакупки КАК СпособЗакупки,
	               |	&ПолеЭлектронно КАК Электронно,
	               |	&ПолеОбоснование КАК Обоснование,
	               |	&ПолеДлительностьПодготовки КАК ДлительностьПодготовки,
	               |	&ПолеУсловияОплаты КАК УсловияОплаты,
	               |	&ПолеДлительностьПроцедуры КАК ДлительностьПроцедуры,
	               |	&ПолеЗакупкаИВПиЛС КАК ЗакупкаИВПиЛС,
	               |	&ПолеГосТайна КАК ГосТайна,
	               |	&ПолеПриоритетСМП КАК ПриоритетСМП,
	               |	&ПолеСубподрядчикиСМП КАК СубподрядчикиСМП,
	               |	&ПолеФлагиВозможностиИзменения КАК ФлагиВозможностиИзменения
	               |ПОМЕСТИТЬ Коллекция
	               |ИЗ
	               |	&Коллекция КАК Коллекция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Коллекция.Индекс КАК Индекс,
	               |	Аналитика.КлючАналитики КАК АналитикаПараметровЗакупки,
	               |	Коллекция.Организатор КАК Организатор,
	               |	Коллекция.СпособЗакупки КАК СпособЗакупки,
	               |	Коллекция.Электронно КАК Электронно,
	               |	Коллекция.Обоснование КАК Обоснование,
	               |	Коллекция.ДлительностьПодготовки КАК ДлительностьПодготовки,
	               |	Коллекция.ДлительностьПроцедуры КАК ДлительностьПроцедуры,
	               |	Коллекция.ЗакупкаИВПиЛС КАК ЗакупкаИВПиЛС,
	               |	Коллекция.ГосТайна КАК ГосТайна,
	               |	Коллекция.ПриоритетСМП КАК ПриоритетСМП,
	               |	Коллекция.СубподрядчикиСМП КАК СубподрядчикиСМП,
	               |	Коллекция.ФлагиВозможностиИзменения КАК ФлагиВозможностиИзменения,
	               |	Коллекция.УсловияОплаты КАК УсловияОплаты
	               |ИЗ
	               |	Коллекция КАК Коллекция
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПараметровЗакупки КАК Аналитика
	               |		ПО (Аналитика.Организатор = Коллекция.Организатор)
	               |			И (Аналитика.СпособЗакупки = Коллекция.СпособЗакупки)
	               |			И (Аналитика.Электронно = Коллекция.Электронно)
	               |			И (Аналитика.Обоснование = Коллекция.Обоснование)
	               |			И (Аналитика.ДлительностьПодготовки = Коллекция.ДлительностьПодготовки)
	               |			И (Аналитика.ДлительностьПроцедуры = Коллекция.ДлительностьПроцедуры)
	               |			И (Аналитика.ЗакупкаИВПиЛС = Коллекция.ЗакупкаИВПиЛС)
	               |			И (Аналитика.ГосТайна = Коллекция.ГосТайна)
	               |			И (Аналитика.ПриоритетСМП = Коллекция.ПриоритетСМП)
	               |			И (Аналитика.СубподрядчикиСМП = Коллекция.СубподрядчикиСМП)
	               |			И (Аналитика.ФлагиВозможностиИзменения = Коллекция.ФлагиВозможностиИзменения)
	               |ГДЕ
	               |	(Аналитика.КлючАналитики ЕСТЬ NULL
	               |			ИЛИ Аналитика.КлючАналитики <> Коллекция.АналитикаПараметровЗакупки
	               |			ИЛИ Аналитика.КлючАналитики = ЗНАЧЕНИЕ(Справочник.КлючиПараметровЗакупки.ПустаяСсылка))";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитикаПараметровЗакупки", "Коллекция." + ИменаПолей.АналитикаПараметровЗакупки);
	//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСпособЗакупки", "Коллекция." + ИменаПолей.СпособЗакупки);
	Для Каждого КлючЗначение Из ВсеРеквизитыКлюча Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Поле"+КлючЗначение.Ключ, "Коллекция." + ИменаПолей[КлючЗначение.Ключ]);
	КонецЦикла;
	
	// Все поля ключа обязательны
	//// Поле Организатор может отсутствовать в таблице.
	//Если ЗначениеЗаполнено(ИменаПолей.Организатор) Тогда
	//	Если ТипЗнч(ИменаПолей.Организатор) = Тип("Структура") Тогда
	//		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОрганизатор", ИменаПолей.Организатор.ТекстПоля);
	//	Иначе
	//		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОрганизатор", "Коллекция." + ИменаПолей.Организатор);
	//	КонецЕсли;  
	//Иначе
	//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОрганизатор", "ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)");
	//КонецЕсли; 
	
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстДополнениеКлючейАналитикиВКоллекции(ИменаПолей)
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Коллекция.НомерСтроки - 1 КАК Индекс,
	               |	&ПолеАналитика КАК АналитикаПараметровЗакупки,
	               |	&ПолеПриемник КАК АналитикаПараметровЗакупкиПриемник,
	               |	&ПолеОрганизатор КАК Организатор,
	               |	&ПолеСпособЗакупки КАК СпособЗакупки,
	               |	&ПолеЭлектронно КАК Электронно,
	               |	&ПолеОбоснование КАК Обоснование,
	               |	&ПолеДлительностьПодготовки КАК ДлительностьПодготовки,
	               |	&ПолеДлительностьПроцедуры КАК ДлительностьПроцедуры,
	               |	&ПолеЗакупкаИВПиЛС КАК ЗакупкаИВПиЛС,
	               |	&ПолеГосТайна КАК ГосТайна,
	               |	&ПолеПриоритетСМП КАК ПриоритетСМП,
	               |	&ПолеСубподрядчикиСМП КАК СубподрядчикиСМП,
	               |	&ПолеУсловияОплаты КАК УсловияОплаты,
	               |	&ПолеФлагиВозможностиИзменения КАК ФлагиВозможностиИзменения
	               |ПОМЕСТИТЬ ВтКоллекция
	               |ИЗ
	               |	&Коллекция КАК Коллекция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Коллекция.Индекс КАК Индекс,
	               |	Коллекция.АналитикаПараметровЗакупки КАК АналитикаПараметровЗакупки,
	               |	Коллекция.АналитикаПараметровЗакупкиПриемник КАК АналитикаПараметровЗакупкиПриемник,
	               |	ВЫБОР
	               |		КОГДА Коллекция.Организатор = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Аналитика.Организатор, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	               |		ИНАЧЕ Коллекция.Организатор
	               |	КОНЕЦ КАК Организатор,
	               |	ВЫБОР
	               |		КОГДА Коллекция.СпособЗакупки = ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.ПустаяСсылка)
	               |			ТОГДА ЕСТЬNULL(Аналитика.СпособЗакупки, ЗНАЧЕНИЕ(Перечисление.СпособыВыбораПоставщика.ПустаяСсылка))
	               |		ИНАЧЕ Коллекция.СпособЗакупки
	               |	КОНЕЦ КАК СпособЗакупки,
	               |	Коллекция.ДлительностьПодготовки КАК ДлительностьПодготовки,
	               |	Коллекция.ДлительностьПроцедуры КАК ДлительностьПроцедуры,
	               |	Коллекция.Электронно КАК Электронно,
	               |	Коллекция.Обоснование КАК Обоснование,
	               |	Коллекция.ЗакупкаИВПиЛС КАК ЗакупкаИВПиЛС,
	               |	Коллекция.ГосТайна КАК ГосТайна,
	               |	Коллекция.ПриоритетСМП КАК ПриоритетСМП,
	               |	Коллекция.СубподрядчикиСМП КАК СубподрядчикиСМП,
	               |	Коллекция.ФлагиВозможностиИзменения КАК ФлагиВозможностиИзменения,
	               |	Коллекция.УсловияОплаты КАК УсловияОплаты
	               |ПОМЕСТИТЬ Коллекция
	               |ИЗ
	               |	ВтКоллекция КАК Коллекция
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПараметровЗакупки КАК Аналитика
	               |		ПО Коллекция.АналитикаПараметровЗакупки = Аналитика.КлючАналитики
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Коллекция.Индекс КАК Индекс,
	               |	Ключи.КлючАналитики КАК АналитикаПараметровЗакупки,
	               |	Коллекция.Организатор КАК Организатор,
	               |	Коллекция.СпособЗакупки КАК СпособЗакупки,
	               |	Коллекция.Электронно КАК Электронно,
	               |	Коллекция.Обоснование КАК Обоснование,
	               |	Коллекция.ДлительностьПодготовки КАК ДлительностьПодготовки,
	               |	Коллекция.ДлительностьПроцедуры КАК ДлительностьПроцедуры,
	               |	Коллекция.ЗакупкаИВПиЛС КАК ЗакупкаИВПиЛС,
	               |	Коллекция.ГосТайна КАК ГосТайна,
	               |	Коллекция.ПриоритетСМП КАК ПриоритетСМП,
	               |	Коллекция.СубподрядчикиСМП КАК СубподрядчикиСМП,
	               |	Коллекция.ФлагиВозможностиИзменения КАК ФлагиВозможностиИзменения,
	               |	Коллекция.УсловияОплаты КАК УсловияОплаты
	               |ИЗ
	               |	Коллекция КАК Коллекция
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПараметровЗакупки КАК Ключи
	               |		ПО (Ключи.Организатор = Коллекция.Организатор)
	               |			И (Ключи.СпособЗакупки = Коллекция.СпособЗакупки)
	               |			И (Ключи.Электронно = Коллекция.Электронно)
	               |			И (Ключи.Обоснование = Коллекция.Обоснование)
	               |			И (Ключи.ДлительностьПодготовки = Коллекция.ДлительностьПодготовки)
	               |			И (Ключи.ДлительностьПроцедуры = Коллекция.ДлительностьПроцедуры)
	               |			И (Ключи.ЗакупкаИВПиЛС = Коллекция.ЗакупкаИВПиЛС)
	               |			И (Ключи.ГосТайна = Коллекция.ГосТайна)
	               |			И (Ключи.ПриоритетСМП = Коллекция.ПриоритетСМП)
	               |			И (Ключи.СубподрядчикиСМП = Коллекция.СубподрядчикиСМП)
	               |			И (Ключи.ФлагиВозможностиИзменения = Коллекция.ФлагиВозможностиИзменения)
	               |ГДЕ
	               |	(Ключи.КлючАналитики ЕСТЬ NULL
	               |			ИЛИ Ключи.КлючАналитики <> Коллекция.АналитикаПараметровЗакупки
	               |			ИЛИ Коллекция.АналитикаПараметровЗакупкиПриемник = ЗНАЧЕНИЕ(Справочник.КлючиПараметровЗакупки.ПустаяСсылка))";
	
	// заменим в тексте запроса подставляемые поля из структуры ИменаПолей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеАналитика", "Коллекция." + ИменаПолей.АналитикаПараметровЗакупки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриемник", "Коллекция." + ИменаПолей.ЗаполняемаяАналитикаПараметровЗакупки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОрганизатор", ?(ЗначениеЗаполнено(ИменаПолей.Организатор),"Коллекция." + ИменаПолей.Организатор, "ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСпособЗакупки", ?(ЗначениеЗаполнено(ИменаПолей.СпособЗакупки),"Коллекция." + ИменаПолей.СпособЗакупки, "ЗНАЧЕНИЕ(Справочник.СпособыВыбораПоставщика.ПустаяСсылка)"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеУсловияОплаты", ?(ЗначениеЗаполнено(ИменаПолей.УсловияОплаты),"Коллекция." + ИменаПолей.УсловияОплаты, "ЗНАЧЕНИЕ(Справочник.УсловияОплаты.ПустаяСсылка)")); 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДлительностьПодготовки", ?(ЗначениеЗаполнено(ИменаПолей.ДлительностьПодготовки),"Коллекция." + ИменаПолей.ДлительностьПодготовки, "0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДлительностьПроцедуры", ?(ЗначениеЗаполнено(ИменаПолей.ДлительностьПроцедуры),"Коллекция." + ИменаПолей.ДлительностьПроцедуры, "0"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЭлектронно", ?(ЗначениеЗаполнено(ИменаПолей.Электронно),"Коллекция." + ИменаПолей.Электронно, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОбоснование", ?(ЗначениеЗаполнено(ИменаПолей.Обоснование),"Коллекция." + ИменаПолей.Обоснование, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЗакупкаИВПиЛС", ?(ЗначениеЗаполнено(ИменаПолей.ЗакупкаИВПиЛС),"Коллекция." + ИменаПолей.ЗакупкаИВПиЛС, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеГосТайна", ?(ЗначениеЗаполнено(ИменаПолей.ГосТайна),"Коллекция." + ИменаПолей.ГосТайна, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПриоритетСМП", ?(ЗначениеЗаполнено(ИменаПолей.ПриоритетСМП),"Коллекция." + ИменаПолей.ПриоритетСМП, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСубподрядчикиСМП", ?(ЗначениеЗаполнено(ИменаПолей.СубподрядчикиСМП),"Коллекция." + ИменаПолей.СубподрядчикиСМП, "ЛОЖЬ"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеФлагиВозможностиИзменения", ?(ЗначениеЗаполнено(ИменаПолей.ФлагиВозможностиИзменения),"Коллекция." + ИменаПолей.ФлагиВозможностиИзменения, "ЛОЖЬ"));
	
	ВсеРеквизитыКлюча = Новый Структура(СтрокаВсеАналитикиКлюча());
	
	Возврат ТекстЗапроса;
КонецФункции

