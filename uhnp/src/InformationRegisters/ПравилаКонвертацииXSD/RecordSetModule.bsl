#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
	
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Запись.ХэшCRC32 =
			РегистрыСведений.ПравилаКонвертацииXSD.ПолучитьХэшПравилCRC32(
				Запись.ТекстПравил);
		Если Запись.НомерРедакции = 0 Тогда
			УстновитьБлокировкуИНомерРедакции(Запись);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Ошибки = Неопределено;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если ПустаяСтрока(Запись.ТекстПравил) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				Ошибки,
				"ТекстПравил",
				НСтр("ru='Не заполнен текст правил!'"),
				Неопределено);
		КонецЕсли;
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(
		Ошибки, Отказ);
КонецПроцедуры
	
Процедура УстновитьБлокировкуИНомерРедакции(Запись)
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.ПравилаКонвертацииXSD");
	ЭлементБлокировки.УстановитьЗначение(
		"ПравилаКонвертацииXSD", Запись.ПравилаКонвертацииXSD);
	Блокировка.Заблокировать();
	Запись.НомерРедакции =
		 1 + РегистрыСведений.ПравилаКонвертацииXSD.ПолучитьТекущийНомерРедакции(
				Запись.ПравилаКонвертацииXSD);
	ОтборНомерРедакции = Отбор.Найти("НомерРедакции");
	Если ОтборНомерРедакции <> Неопределено Тогда
		ОтборНомерРедакции.Значение = Запись.НомерРедакции;
	КонецЕсли;
КонецПроцедуры


#КонецЕсли