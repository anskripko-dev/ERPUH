
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	КлючЗаписи = ПолучитьКлючПоследнейИлиНовойЗаписи(ПараметрКоманды);
	ПараметрыФормы = Новый Структура;
	Если КлючЗаписи = Неопределено Тогда
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура);
		ПараметрыФормы.ЗначенияЗаполнения.Вставить(
			"ПравилаКонвертацииXSD", ПараметрКоманды);
	Иначе
		ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
	КонецЕсли;
	ОткрытьФорму("РегистрСведений.ПравилаКонвертацииXSD.ФормаЗаписи",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
КонецПроцедуры

&НаСервере
Функция ПолучитьКлючПоследнейИлиНовойЗаписи(ТипПравил)
	Если НЕ ЗначениеЗаполнено(ТипПравил) Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомерРедакции =
		РегистрыСведений.ПравилаКонвертацииXSD.ПолучитьТекущийНомерРедакции(
			ТипПравил);
	Если НомерРедакции = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
    ЗначениеКлюча = Новый Структура;
    ЗначениеКлюча.Вставить("ПравилаКонвертацииXSD", ТипПравил);
    ЗначениеКлюча.Вставить("НомерРедакции", НомерРедакции);
    Возврат РегистрыСведений.ПравилаКонвертацииXSD.СоздатьКлючЗаписи(
		ЗначениеКлюча);
КонецФункции