
#Область ОбработкаОсновныхСобытийФормы


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Ключ.Пустой()
			И Параметры.ЗначениеКопирования.НомерРедакции <> 0 Тогда
		Запись.НомерРедакции = 0;
	КонецЕсли;
	УстановитьПредставлениеНомераРедакции(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УстановитьПредставлениеНомераРедакции(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьПредставлениеНомераРедакции(ЭтаФорма);
КонецПроцедуры


#КонецОбласти


#Область ОбработкаСобытийЭлементовФормы


&НаКлиенте
Процедура ОткрытьПравилаВРедакторе(Команда)
	ПараметрыФормы = Новый Структура(
		"СтрокаПравил, ОповеститьОбИзменении",
		Запись.ТекстПравил, Истина);
	ОткрытьФорму("Обработка.КонвертерОбъектовXDTOУХ.Форма",
		ПараметрыФормы, Элементы.ТекстПравил);
КонецПроцедуры


#КонецОбласти


#Область СлужебныеПроцедурыНаКлиенте


&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеНомераРедакции(Форма)
	Форма.ПредставлениеНомерРедакции = 
		ПолучитьПредставлениеНомераРедакции(Форма.Запись.НомерРедакции);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеНомераРедакции(НомерРедакции)
	Если НомерРедакции = 0 Тогда
		Возврат "номер будет установлен при записи";
	КонецЕсли;
	Возврат Строка(НомерРедакции);
КонецФункции


#КонецОбласти


#Область СлужебныеПроцедурыНаСервере


#КонецОбласти
