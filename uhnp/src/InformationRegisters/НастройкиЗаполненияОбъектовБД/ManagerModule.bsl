
Процедура ЗаполнитьСпособыФормированияДокументов(Параметры=Неопределено) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	НастройкиЗаполненияОбъектовБД.Период КАК Период,
	             |	НастройкиЗаполненияОбъектовБД.Организация КАК Организация,
	             |	НастройкиЗаполненияОбъектовБД.Сценарий КАК Сценарий,
	             |	НастройкиЗаполненияОбъектовБД.ОбъектБД КАК ОбъектБД,
	             |	НастройкиЗаполненияОбъектовБД.ПравилоЗаполнения КАК ПравилоЗаполнения,
	             |	НастройкиЗаполненияОбъектовБД.ИсходныйОбъектБД КАК ИсходныйОбъектБД,
	             |	НастройкиЗаполненияОбъектовБД.ОбластьГенерации КАК ОбластьГенерации,
	             |	НастройкиЗаполненияОбъектовБД.ИспользуемаяИБ КАК ИспользуемаяИБ,
	             |	НастройкиЗаполненияОбъектовБД.ПроводитьДокументы КАК ПроводитьДокументы,
	             |	ВЫБОР
	             |		КОГДА НастройкиЗаполненияОбъектовБД.ВыполнятьАвтоматически
	             |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СпособыФормированияДокументовПоПравилам.Автоматически)
	             |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыФормированияДокументовПоПравилам.Вручную)
	             |	КОНЕЦ КАК СпособФормирования,
	             |	НастройкиЗаполненияОбъектовБД.ВыполнятьАвтоматически КАК ВыполнятьАвтоматически
	             |ИЗ
	             |	РегистрСведений.НастройкиЗаполненияОбъектовБД КАК НастройкиЗаполненияОбъектовБД"; 
	
	НаборЗаписей=РегистрыСведений.НастройкиЗаполненияОбъектовБД.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());		
	НаборЗаписей.Записать(Истина);
		
КонецПроцедуры // ЗаполнитьСпособыФормированияДокументов() 