
 #Область ОбработчикиКомандФормы
 
&НаКлиенте
Процедура ЗаполнитьЗначениямиПоУмолчанию(Команда)
	КоличествоЗаписей = ПолучитьКоличествоЗаписей();  
	
	Если КоличествоЗаписей <> 0 Тогда
		Оповещение 		= Новый ОписаниеОповещения("ПоказатьВопросЗавершение", ЭтаФорма);
		ТекстВопроса 	= "Текущие записи будут перезаписаны. Продолжить?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	Иначе 
		ЗаполнитьЗначениямиПоУмолчаниюНаСервере();
		Элементы.Список.Обновить();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросЗавершение(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьЗначениямиПоУмолчаниюНаСервере();
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениямиПоУмолчаниюНаСервере()
	
	МассивВидовОбъектов = Новый Массив;
	МассивВидовОбъектов.Добавить("catalogOrganization");
	МассивВидовОбъектов.Добавить("catalogDepartmentOrg");
	МассивВидовОбъектов.Добавить("catalogDepartment");
	МассивВидовОбъектов.Добавить("catalogStore");
	МассивВидовОбъектов.Добавить("catalogContract");
	МассивВидовОбъектов.Добавить("catalogConstructionObjects");
	МассивВидовОбъектов.Добавить("catalogCashboxs");
	
	НаборЗаписей = РегистрыСведений.тн_НастройкиЗагрузкиОбъектов.СоздатьНаборЗаписей();
	
	Для Каждого ВидОбъекта Из МассивВидовОбъектов Цикл
		НоваяЗапись = НаборЗаписей.Добавить();		
		НоваяЗапись.ВидОбъекта = ВидОбъекта;
		НоваяЗапись.ХранитьИсточникОбъекта = Истина;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти      

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЗаписей()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_НастройкиЗагрузкиОбъектов.ВидОбъекта КАК ВидОбъекта,
		|	тн_НастройкиЗагрузкиОбъектов.ХранитьИсточникОбъекта КАК ХранитьИсточникОбъекта
		|ИЗ
		|	РегистрСведений.тн_НастройкиЗагрузкиОбъектов КАК тн_НастройкиЗагрузкиОбъектов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать().Количество();
		
КонецФункции

#КонецОбласти