КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработкаПодбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Для Каждого Значение Из ВыбранноеЗначение Цикл
		ЭтаФорма[Элемент.Имя].Добавить(Значение);
	КонецЦикла;
	СформироватьНаборыАналитик();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьДанныеАналитик()
	
	ДанныеШаблона = БюджетированиеИОтчетностьПовтИсп.ДанныеВидаОтчета(ШаблонДокумента);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеШаблона);
	
	Элементы.СтраницаПроекты.Видимость = РазделениеПоПроектам;
	Элементы.АналитикиПроект.Видимость = РазделениеПоПроектам;
		
	Для Сч = 1 По МаксКлючевыхАналитик Цикл
		Элементы["СтраницаАналитика" + Сч].Видимость = Истина;
		ЭтаФорма["Аналитики" + Сч].ТипЗначения = ДанныеШаблона["ТипЗначенияАналитики" + Сч];
		Элементы["АналитикиАналитика" + Сч].Видимость = Истина;
		Элементы["АналитикиАналитика" + Сч].ОграничениеТипа = ДанныеШаблона["ТипЗначенияАналитики" + Сч];
	КонецЦикла;
	Для Сч = МаксКлючевыхАналитик+1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		Элементы["СтраницаАналитика" + Сч].Видимость = Ложь;
		Элементы["АналитикиАналитика" + Сч].Видимость = Ложь;
	КонецЦикла;
	
	Если (МаксКлючевыхАналитик + ?(РазделениеПоПроектам, 1, 0)) > 1 Тогда
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Авто;
	Иначе
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	// Получим данные из регистра
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ОбъектУчета.Установить(ОбъектУчета);
	НаборЗаписей.Отбор.ШаблонДокумента.Установить(ШаблонДокумента);
	НаборЗаписей.Прочитать();
	тАналитики = НаборЗаписей.Выгрузить();
	
	ЗаполнитьИсточникиАналитик(тАналитики);
	СформироватьНаборыАналитик(тАналитики);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаборыАналитик(Знач тАналитики = Неопределено)
	
	// Запомним отметки строк
	Если тАналитики = Неопределено Тогда
		тАналитики = Аналитики.Выгрузить(Новый Структура("Используется", Истина));
		Модифицированность = Истина;
	КонецЕсли;
	
	// Сформируем новую таблицу
	Аналитики.Очистить();
	СтруктураАналитик = Новый Структура;
	
	Если РазделениеПоПроектам Тогда
		
		Если Проекты.Количество() = 0 Тогда
			СтруктураАналитик.Вставить("Проект", Справочники.Проекты.ПустаяСсылка());
			ДобавитьАналитики(СтруктураАналитик, 0);
		Иначе
			Для Каждого СтрокаПроект Из Проекты Цикл
				СтруктураАналитик.Вставить("Проект", СтрокаПроект.Значение);
				ДобавитьАналитики(СтруктураАналитик, 0);
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		ДобавитьАналитикиРекурсивно(СтруктураАналитик, 1);
	КонецЕсли;
	
	// Восстановим отметки строк
	Для Каждого ПрошлаяСтрока Из тАналитики Цикл
		ЗаполнитьЗначенияСвойств(СтруктураАналитик, ПрошлаяСтрока);
		НайденныеСтроки = Аналитики.НайтиСтроки(СтруктураАналитик);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Используется = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьАналитикиРекурсивно(СтруктураАналитик, НомерАналитики)
	
	Если НомерАналитики > МаксКлючевыхАналитик Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеАналитики = ЭтаФорма["Аналитики" + НомерАналитики];
	Если ТекущиеАналитики.Количество() = 0 Тогда
		СтруктураАналитик.Вставить("Аналитика" + НомерАналитики, ТекущиеАналитики.ТипЗначения.ПривестиЗначение());
		ДобавитьАналитики(СтруктураАналитик, НомерАналитики);
	Иначе
		Для Каждого СтрокаАналитика Из ТекущиеАналитики Цикл
			СтруктураАналитик.Вставить("Аналитика" + НомерАналитики, СтрокаАналитика.Значение);
			ДобавитьАналитики(СтруктураАналитик, НомерАналитики);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьАналитики(СтруктураАналитик, НомерАналитики)

	Если МаксКлючевыхАналитик = НомерАналитики Тогда
		НоваяСтрока = Аналитики.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураАналитик);
	Иначе
		ДобавитьАналитикиРекурсивно(СтруктураАналитик, НомерАналитики+1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсточникиАналитик(Знач тАналитики = Неопределено)
	
	Если тАналитики = Неопределено Тогда
		тАналитики = Аналитики.Выгрузить();
	КонецЕсли;
	
	Если РазделениеПоПроектам Тогда
		
		тДанные = тАналитики.Скопировать(,"Проект");
		тДанные.Свернуть("Проект");
		
		Проекты.ЗагрузитьЗначения(тДанные.ВыгрузитьКолонку("Проект"));
		
	КонецЕсли;
	
	Для Сч = 1 По МаксКлючевыхАналитик Цикл
		
		ИмяАналитики = "Аналитика" + Сч;
		тДанные = тАналитики.Скопировать(,ИмяАналитики);
		тДанные.Свернуть(ИмяАналитики);
		
		ЭтаФорма["Аналитики" + Сч].ЗагрузитьЗначения(тДанные.ВыгрузитьКолонку(ИмяАналитики));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	тАналитики = Аналитики.Выгрузить(Новый Структура("Используется", Истина));
	тАналитики.Колонки.Добавить("ОбъектУчета");
	тАналитики.ЗаполнитьЗначения(ОбъектУчета, "ОбъектУчета");
	тАналитики.Колонки.Добавить("ШаблонДокумента");
	тАналитики.ЗаполнитьЗначения(ШаблонДокумента, "ШаблонДокумента");
	
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ОбъектУчета.Установить(ОбъектУчета);
	НаборЗаписей.Отбор.ШаблонДокумента.Установить(ШаблонДокумента);
	НаборЗаписей.Загрузить(тАналитики);
	
	НаборЗаписей.Записать();
	Модифицированность = Ложь;
	
КонецПроцедуры

#КонецОбласти




















