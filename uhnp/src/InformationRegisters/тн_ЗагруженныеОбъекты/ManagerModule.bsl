#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Белоконенко Денис 18.04.2023 Выполнение задач №000045229
Функция ПроверитьВозможностьЗаписиОбъектаПоВерсии(Объект, ВерсияЗаписи) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ВерсияЗаписи = Неопределено Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_ЗагруженныеОбъекты.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.тн_ЗагруженныеОбъекты КАК тн_ЗагруженныеОбъекты
		|ГДЕ
		|	тн_ЗагруженныеОбъекты.Объект = &Объект
		|	И тн_ЗагруженныеОбъекты.Версия <> 0
		|	И тн_ЗагруженныеОбъекты.Версия > &Версия";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Версия", ВерсияЗаписи);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Белоконенко Денис 18.04.2023 Выполнение задач №000045229
Функция ПолучитьВерсиюОбъекта(Объект) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тн_ЗагруженныеОбъекты.Версия КАК Версия
		|ИЗ
		|	РегистрСведений.тн_ЗагруженныеОбъекты КАК тн_ЗагруженныеОбъекты
		|ГДЕ
		|	тн_ЗагруженныеОбъекты.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Версия;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Белоконенко Денис 16.10.2025 Выполнение задач №000055530
Функция ПроверитьАктуальностьОбъектаВМассивеДокументов(Объект, МассивДокументов) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяТипаДокумента = Объект.Метаданные().Имя;
	ЭтоАктуальныйДокумент = Ложь;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	тн_ЗагруженныеОбъекты.Объект КАК Объект,
		|	тн_ЗагруженныеОбъекты.Версия КАК Версия,
		|	ИСТИНА КАК ПроверяемыйДокумент,
		|	ВЫРАЗИТЬ(тн_ЗагруженныеОбъекты.Объект КАК Документ.РаспределениеПроизводственныхЗатрат).МоментВремени КАК МоментВремени
		|ПОМЕСТИТЬ вт_Данные
		|ИЗ
		|	РегистрСведений.тн_ЗагруженныеОбъекты КАК тн_ЗагруженныеОбъекты
		|ГДЕ
		|	тн_ЗагруженныеОбъекты.Объект = &Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	тн_ЗагруженныеОбъекты.Объект,
		|	тн_ЗагруженныеОбъекты.Версия,
		|	ЛОЖЬ,
		|	ВЫРАЗИТЬ(тн_ЗагруженныеОбъекты.Объект КАК Документ.РаспределениеПроизводственныхЗатрат).МоментВремени
		|ИЗ
		|	РегистрСведений.тн_ЗагруженныеОбъекты КАК тн_ЗагруженныеОбъекты
		|ГДЕ
		|	тн_ЗагруженныеОбъекты.Объект В(&МассивДокументов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	вт_Данные.Объект КАК Объект,
		|	вт_Данные.Версия КАК Версия,
		|	вт_Данные.ПроверяемыйДокумент КАК ПроверяемыйДокумент,
		|	вт_Данные.МоментВремени КАК МоментВремени
		|ИЗ
		|	вт_Данные КАК вт_Данные
		|
		|УПОРЯДОЧИТЬ ПО
		|	Версия УБЫВ,
		|	МоментВремени УБЫВ"; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РаспределениеПроизводственныхЗатрат", ИмяТипаДокумента); 
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.ПроверяемыйДокумент Тогда
			ЭтоАктуальныйДокумент = Истина;		
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоАктуальныйДокумент;
	
КонецФункции

#КонецЕсли