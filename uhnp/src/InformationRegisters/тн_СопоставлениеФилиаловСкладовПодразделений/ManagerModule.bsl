Функция НастройкиСопоставленияФилиаловСкладовПодразделений(Объект) Экспорт 
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	тн_СопоставлениеФилиаловСкладовПодразделений.Объект КАК Объект,
	               |	тн_СопоставлениеФилиаловСкладовПодразделений.Склад КАК Склад, 				   
				   // НАЧАЛО Юдина Екатерина 12.01.2026 Выполнение задач №000056340 
				   |	тн_СопоставлениеФилиаловСкладовПодразделений.БанковскийСчет КАК БанковскийСчет,
				   // КОНЕЦ Юдина Екатерина 12.01.2026 Выполнение задач №000056340
				   // НАЧАЛО Чекордина Ирина 16.01.2026 Выполнение задач №000056368
				   |	тн_СопоставлениеФилиаловСкладовПодразделений.СлужебныйСотрудник КАК СлужебныйСотрудник,
				   // КОНЕЦ Чекордина Ирина 16.01.2026 Выполнение задач №000056368 
	               |	тн_СопоставлениеФилиаловСкладовПодразделений.Подразделение КАК Подразделение
	               |ИЗ
	               |	РегистрСведений.тн_СопоставлениеФилиаловСкладовПодразделений КАК тн_СопоставлениеФилиаловСкладовПодразделений
	               |ГДЕ
	               |	тн_СопоставлениеФилиаловСкладовПодразделений.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Настройки = Запрос.Выполнить().Выбрать();
	
	Если Настройки.Следующий() Тогда 
		Результат = Настройки; 	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецЕсли
