#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Проверяет корректность выгрузки набора записей регистра ВыгрузкаВход.
Функция ПроверитьПравильностьНабора(ВыгрузкаВход)
	РезультатФункции = Истина;
	// Проверим, что не изменяем статус у экземляра отчета, принадлежащего закрытому этапу.
	ПроверятьСостояниеЭтапа = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтотОбъект.ДополнительныеСвойства, "ПроверятьСостояниеЭтапа", Истина);
	Если ПроверятьСостояниеЭтапа Тогда
		Для Каждого ТекВыгрузкаВход Из ВыгрузкаВход Цикл
			ТекОбъектСсылка = ТекВыгрузкаВход.Объект;
			ТекСостояние = ТекВыгрузкаВход.СостояниеОбъекта;
			РезультатПроверки = РегистрыСведений.РегистрСостоянийОбъектов.ПроверитьВозможностьУстановкиСостоянияОбъекта(ТекОбъектСсылка, ТекСостояние);
			Если НЕ РезультатПроверки Тогда
				РезультатФункции = Ложь;
			Иначе
				// Проверка пройдена. Выполняем далее.
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Проверка не требуется. Пропускаем.
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции

// В наборе записей регистра НаборВход проверяет наличие экземпляров отчета, которые переводятся
// в состояние Утвержден и не проходят проверку по правилу. Для таких отчетов устанавливается
// состояние Записан с ошибкой.
Процедура ВыполнитьПроверкуЗаполненияЭкземпляровОтчетов(НаборВход)
	// Инициализация.
	СостояниеЗаписанСОшибкой = Перечисления.СостоянияОтчетов.ЗаписанСОшибкой;
	СостояниеОтчетаУтвержден = Перечисления.СостоянияОтчетов.Утвержден;
	СостояниеОтчетаПодготовлен = Перечисления.СостоянияОтчетов.Подготовлен;
	Для Каждого ТекНаборВход Из НаборВход Цикл
		// Найдём экземпляры отчетов, которые переводятся в состояние Утверждён.
		ТекОбъектСсылка = ТекНаборВход.Объект;
		Если ТипЗнч(ТекОбъектСсылка) = Тип("ДокументСсылка.НастраиваемыйОтчет") Тогда
			ЭтапПроцесса = Неопределено;
			НовоеСостояние = ТекНаборВход.СостояниеОбъекта;
			Если (НовоеСостояние = СостояниеОтчетаУтвержден) ИЛИ (НовоеСостояние = СостояниеОтчетаПодготовлен) Тогда
				// Запустим для этого экземпляра правило проверки.
				ДокументОбъект = ТекОбъектСсылка.ПолучитьОбъект();
				ПротоколируемыеСобытияУХ.Начать(ДокументОбъект);
				РезультатПроверки = ДокументОбъект.Проверить(Истина);
				СтатусПроверки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатПроверки, "СтатусПроверки", Ложь);
				// Если проверка провалилась, сообщим пользователю и установим состояние Записан с ошибкой для экземпляра.
				Если НЕ СтатусПроверки Тогда
					ТекстСообщения = НСтр("ru = 'Не пройдена проверка отчета %КлючевойОбъект%'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КлючевойОбъект%", Строка(ТекОбъектСсылка));
					ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
					ДокументОбъект.ЗавершитьЗаписьПротокола(СостояниеЗаписанСОшибкой);
					ТекНаборВход.СостояниеОбъекта = СостояниеЗаписанСОшибкой;
				Иначе
					// Проверка отчета прошла успешно. Выполняем далее.
				КонецЕсли;
			Иначе
				// Отчет переводится в другое состояние. Пропускаем его.
			КонецЕсли;
		Иначе
			// Это не экземпляр отчета. Пропускаем.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры		// ВыполнитьПроверкуЗаполненияЭкземпляровОтчетов()

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ВыполнятьОбработкуИзмененияСостояния = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ВыполнятьОбработкуИзмененияСостояния", Истина);
	Если ВыполнятьОбработкуИзмененияСостояния Тогда
		РасширениеПроцессыИСогласованиеУХ.ОбработатьИзменениеСостоянияОбъекта(ЭтотОбъект, Отказ);
	КонецЕсли;
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		ОбъектОповещенияСсылка = ТекЗапись.Объект;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектОповещенияСсылка, "Ответственный") Тогда
			Если ИдентификацияПродуктаУХКлиентСервер.ЭтоУправлениеХолдингом() Тогда
				Параметры = Новый Массив;
				Параметры.Добавить(ТекЗапись);
				Параметры.Добавить(ОбъектОповещенияСсылка);
		        ОбщегоНазначения.ВыполнитьМетодКонфигурации("МодульУправленияОповещениямиУХ.ОповеститьПользователейОбИзмененииСостояния", Параметры);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Проверка по правилам проверки для экземпляров отчетов, если они есть в наборе.
	ВыполнитьПроверкуЗаполненияЭкземпляровОтчетов(ЭтотОбъект);
	// Проверка набора записей.
	Выгрузка = ЭтотОбъект.Выгрузить();
	РезультатПроверки = ПроверитьПравильностьНабора(Выгрузка);
	Если Не РезультатПроверки Тогда
		Отказ = Истина;
	Иначе
		// Проверка пройдена успешно. Ничего не делаем.
	КонецЕсли;
	
	Если НЕ Отказ И ОбщегоНазначения.ПодсистемаСуществует("ПодсистемыУХ.ПланированиеИКонтрольСлужебный") Тогда
		ОбщегоНазначения.ВыполнитьМетодКонфигурации(
			"УстановкаЛимитовУХ.РегистрСостоянийОбъектовПередЗаписью", 
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
