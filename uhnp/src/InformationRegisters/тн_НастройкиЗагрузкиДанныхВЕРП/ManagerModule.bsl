//Качикина 15.08.2025 Выполнение задач №000054730 
Функция НастройкиЗагрузкиДанныхВЕРП(Организация) Экспорт 
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	тн_НастройкиЗагрузкиДанныхВЕРП.Организация КАК Организация,
				|	тн_НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
				|	тн_НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения КАК ДатаНачалаВыгрузкиКакОбособленногоПодразделения
				|ИЗ
				|	РегистрСведений.тн_НастройкиЗагрузкиДанныхВЕРП КАК тн_НастройкиЗагрузкиДанныхВЕРП
				|ГДЕ
				|	тн_НастройкиЗагрузкиДанныхВЕРП.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	НастройкиЗагрузкиДанныхВЕРПВыборка = Запрос.Выполнить().Выбрать();
	
	Если НастройкиЗагрузкиДанныхВЕРПВыборка.Следующий() Тогда 
		Результат = НастройкиЗагрузкиДанныхВЕРПВыборка; 	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Качикина 09.02.2026 Выполнение задач №000056689
Функция ЗаданыНастройкиЗагрузкиДанныхВЕРП(НастройкиЗагрузкиДанныхВЕРП, ДатаПодмены) Экспорт 
	
	ЗаданыНастройкиЗагрузкиДанныхВЕРП = Ложь;
	
	Если НастройкиЗагрузкиДанныхВЕРП <> Неопределено Тогда 
		ЗаданыНастройкиЗагрузкиДанныхВЕРП = ЗначениеЗаполнено(НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация)
											И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <> Дата(1,1,1)
											И НастройкиЗагрузкиДанныхВЕРП.ДатаНачалаВыгрузкиКакОбособленногоПодразделения <= ДатаПодмены; 
	КонецЕсли;			
	
	Возврат ЗаданыНастройкиЗагрузкиДанныхВЕРП; 
	
КонецФункции

//Качикина 12.02.2026 Выполнение задач №000056733
Функция ОрганизацияСУчетомНастроекЗагрузкиДанныхВЕРП(ИсходнаяОрганизация, ДатаПодмены) Экспорт
	
	Организация = ИсходнаяОрганизация;
	
	НастройкиЗагрузкиДанныхВЕРП		  = НастройкиЗагрузкиДанныхВЕРП(ИсходнаяОрганизация);
	ЗаданыНастройкиЗагрузкиДанныхВЕРП = ЗаданыНастройкиЗагрузкиДанныхВЕРП(НастройкиЗагрузкиДанныхВЕРП, ДатаПодмены);	
	Если ЗаданыНастройкиЗагрузкиДанныхВЕРП Тогда   
		Организация = НастройкиЗагрузкиДанныхВЕРП.ГоловнаяОрганизация;		
	КонецЕсли;  
	
	Возврат Организация;
	
КонецФункции

