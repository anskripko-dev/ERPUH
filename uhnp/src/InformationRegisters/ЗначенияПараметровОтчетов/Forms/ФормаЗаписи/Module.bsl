
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого ЗначениеЗаполнения Из Параметры.ЗначенияЗаполнения Цикл
		Запись[ЗначениеЗаполнения.Ключ] = ЗначениеЗаполнения.Значение;
		Элементы[ЗначениеЗаполнения.Ключ].Доступность = Ложь;
	КонецЦикла;
	
	ВидОтчетаПриИзмененииНаСервере(Запись.КодПараметра, Запись.ЗначениеПараметра, Ложь);
		
	ЗаполнитьСписокПараметровВидаОтчета();
		
	Представление = НСтр("ru = 'Код параметра'");
	СписокОбязательныхПолей.Добавить("КодПараметра", Представление);
		
	УстановитьДоступность();
		
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
		
	ВидОтчетаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВидОтчетаПриИзмененииНаСервере(КодПараметра = "", ЗначениеПараметра = Неопределено, ОчищатьЗначение = Истина)
		
	ОчиститьПроект();
		
	Запись.КодПараметра = КодПараметра;
	Запись.ЗначениеПараметра = ЗначениеПараметра;
		
	ЗаполнитьСписокПараметровВидаОтчета();
	ЗаполнитьЗначениеПоУмолчанию(ОчищатьЗначение);
	УстановитьДоступность();
	ТипизироватьАналитику();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПроект()

	ВидОтчета = Запись.ВидОтчета;
	Проект = Запись.Проект;
	
	Если Не ВидОтчета.РазделениеПоПроектам И Не Проект.Пустая() Тогда
		Запись.Проект = Справочники.Проекты.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПараметровВидаОтчета()
		
	Элементы.КодПараметра.СписокВыбора.Очистить();
	
	ВидОтчета = Запись.ВидОтчета;
	ПараметрыОтчета = ВидОтчета.ПараметрыОтчета;
		
	Для Каждого Параметр Из ПараметрыОтчета Цикл
		Элементы.КодПараметра.СписокВыбора.Добавить(Параметр.Код);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеПоУмолчанию(ОчищатьЗначение = Истина)
	
	ВидОтчета = Запись.ВидОтчета;
	ПараметрыОтчета = ВидОтчета.ПараметрыОтчета;
	КодПараметра = Запись.КодПараметра;
	
	Если Не ВидОтчета.Пустая() И Не КодПараметра = "" Тогда	
		СтрокаПараметра = ПараметрыОтчета.Найти(КодПараметра, "Код");
		
		Если СтрокаПараметра <> Неопределено Тогда
						
			Если СтрокаПараметра.ТипЗначения = "Дата" Тогда				
				Элементы.ЗначениеПараметра.Формат = "Л=ru_RU; ДФ=dd.MM.yyyy";
				Элементы.ЗначениеПараметра.ФорматРедактирования = "Л=ru_RU; ДФ=dd.MM.yyyy";
								
				Если ОчищатьЗначение Тогда
					Запись.ЗначениеПараметра = СтрокаПараметра.ЗначениеПоУмолчанию;
				КонецЕсли;
			Иначе
				Элементы.ЗначениеПараметра.Формат = "Л=ru_RU; БЛ=Ложь; БИ=Истина";
				Элементы.ЗначениеПараметра.ФорматРедактирования = "Л=ru_RU; БЛ=Ложь; БИ=Истина";
								
				Если ОчищатьЗначение Тогда
					Запись.ЗначениеПараметра = СтрокаПараметра.ЗначениеПоУмолчанию;
				КонецЕсли;
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ВидОтчета.Пустая() ИЛИ КодПараметра = "" Тогда
		Запись.ЗначениеПараметра = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодПараметраПриИзменении(Элемент)
	
	ЗаполнитьЗначениеПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()

	ВидОтчета = Запись.ВидОтчета;
	
	РазделениеПоПроектам = ВидОтчета.РазделениеПоПроектам;
	Элементы.Проект.Видимость = РазделениеПоПроектам;
	
	Если РазделениеПоПроектам И СписокОбязательныхПолей.НайтиПоЗначению("Проект") = Неопределено Тогда		
		Представление = НСтр("ru = 'Проект'");
		СписокОбязательныхПолей.Добавить("Проект", Представление);
	ИначеЕсли НЕ РазделениеПоПроектам И СписокОбязательныхПолей.НайтиПоЗначению("Проект") <> Неопределено Тогда
		СписокОбязательныхПолей.Удалить(СписокОбязательныхПолей.НайтиПоЗначению("Проект"));
	КонецЕсли;
		
	Элементы.Аналитика1.Видимость = НЕ ВидОтчета.ВидАналитики1.Пустая();
	Элементы.Аналитика2.Видимость = НЕ ВидОтчета.ВидАналитики2.Пустая();
	Элементы.Аналитика3.Видимость = НЕ ВидОтчета.ВидАналитики3.Пустая();
	Элементы.Аналитика4.Видимость = НЕ ВидОтчета.ВидАналитики4.Пустая();
	Элементы.Аналитика5.Видимость = НЕ ВидОтчета.ВидАналитики5.Пустая();
	Элементы.Аналитика6.Видимость = НЕ ВидОтчета.ВидАналитики6.Пустая();
	
	СтрокаПараметра = ВидОтчета.ПараметрыОтчета.Найти(Запись.КодПараметра, "Код");
	
	Если СтрокаПараметра <> Неопределено Тогда
				
		Если СтрокаПараметра.ТипЗначения = "Дата" Тогда			
			Элементы.ЗначениеПараметра.Формат = "Л=ru_RU; ДФ=dd.MM.yyyy";
			Элементы.ЗначениеПараметра.ФорматРедактирования = "Л=ru_RU; ДФ=dd.MM.yyyy";
		Иначе
			Элементы.ЗначениеПараметра.Формат = "Л=ru_RU; БЛ=Ложь; БИ=Истина";
			Элементы.ЗначениеПараметра.ФорматРедактирования = "Л=ru_RU; БЛ=Ложь; БИ=Истина";
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ТипизироватьАналитику()
	
	ВидОтчета = Запись.ВидОтчета;
	
	Для Инд = 1 По ПараметрыСеанса.ЧислоДопАналитик Цикл
		
		Если ВидОтчета["ВидАналитики" + Инд].ТипЗначения = Неопределено Тогда
			ТипЗначенияАналитики = Неопределено;
		Иначе
			ТипЗначенияАналитики = ВидОтчета["ВидАналитики" + Инд].ТипЗначения.ПривестиЗначение();
		КонецЕсли;
				
		Если ТипЗнч(Запись["Аналитика" + Инд]) <> ТипЗнч(ТипЗначенияАналитики) Тогда
			Запись["Аналитика" + Инд] = ТипЗначенияАналитики;
		КонецЕсли;
						
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
		
	Для Каждого ОбязательноеПоле Из СписокОбязательныхПолей Цикл
		Если Не ЗначениеЗаполнено(Запись[ОбязательноеПоле.Значение]) Тогда
			
			Отказ = Истина;
			
			СообщениеПользователю = Новый СообщениеПользователю;
						
			ТекстСообщения = НСтр("ru = 'Поле ""%1"" не заполнено'");
			СообщениеПользователю.Текст = СтрЗаменить(ТекстСообщения, "%1", ОбязательноеПоле.Представление); 
						
			СообщениеПользователю.ПутьКДанным = "Запись." + ОбязательноеПоле.Значение;
			СообщениеПользователю.Сообщить();
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
