#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

	
Процедура ЗаписатьСтатистикуПоДоговору(ВерсияДоговораОбъект) Экспорт
	Если ВерсияДоговораОбъект <> Неопределено
				И ЗначениеЗаполнено(ВерсияДоговораОбъект.ДоговорКонтрагента) Тогда
		флЭтоДоговорЦУЗ = Документы.ВерсияСоглашенияКоммерческийДоговор.ЭтоДоговорЦУЗ(
			ВерсияДоговораОбъект);
		НаборЗаписей = РегистрыСведений.СтатистикаДоговоровДляЕИС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Договор.Установить(ВерсияДоговораОбъект.ДоговорКонтрагента);
		мЛоты = Документы.ВерсияСоглашенияКоммерческийДоговор.ПолучитьЛотыВерсии(
			ВерсияДоговораОбъект.Номенклатура);
		Если мЛоты.Количество() > 0 И флЭтоДоговорЦУЗ И ТИПЗНЧ(мЛоты[0]) = ТИП("ДокументСсылка.лот") Тогда
			ОписаниеКоэффициента =
				ЦентрализованныеЗакупкиУХ.ПолучитьКоэффициентПересчетаВалют(
					ВерсияДоговораОбъект.ВалютаВзаиморасчетов,
					Константы.ВалютаРегламентированногоУчета.Получить(), 
					ВерсияДоговораОбъект.Дата);
			Движение = НаборЗаписей.Добавить();
			Движение.Договор = ВерсияДоговораОбъект.ДоговорКонтрагента;
			Движение.Организация = ВерсияДоговораОбъект.Организация;
			Движение.ДатаПодписанияДоговора =
				ЦентрализованныеЗакупкиУХ.ПолучитьДатуПодписанияДоговора(
					ВерсияДоговораОбъект);
			Движение.ДатаОкончанияДоговора = ВерсияДоговораОбъект.ДатаОкончанияДействия;
			ЦентрализованныеЗакупкиУХ.ЗаполнитьРеквизитыСМСПИзОбъекта(
				Движение, ВерсияДоговораОбъект);
			Движение.СуммаДоговораВВалютеРеглУчета =
				ВерсияДоговораОбъект.Номенклатура.Итог("Сумма")
					* ОписаниеКоэффициента.Коэффициент
					/ ОписаниеКоэффициента.Кратность;
			Движение.СпособВыбораПоставщика = мЛоты[0].ЗакупочнаяПроцедура.СпособВыбораПоставщика.СпособыВыбораПоставщика;
		КонецЕсли;
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
КонецПроцедуры


#КонецЕсли