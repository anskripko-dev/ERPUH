
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура("Сценарий", Константы.СценарийМСФО.Получить());
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если НЕ ДанныеЗаполнения.Свойство("Сценарий") Тогда
			ДанныеЗаполнения.Вставить("Сценарий", Константы.СценарийМСФО.Получить());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры