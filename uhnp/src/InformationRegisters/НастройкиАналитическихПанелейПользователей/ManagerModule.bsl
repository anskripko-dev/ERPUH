// Записывает настройки аналитической панели АналитическаяПанельВход из 
// структуры СтруктураОтборовВход в регистр по пользователю ПользовательВход.
Функция ЗаписатьНастройкуАналитическойПанели(ПользовательВход, АналитическаяПанельВход, СтруктураОтборовВход) Экспорт
	РезультатФункции = Истина;
	Попытка
		НаборЗаписей = РегистрыСведений.НастройкиАналитическихПанелейПользователей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ПользовательВход); 
		НаборЗаписей.Отбор.АналитическаяПанель.Установить(АналитическаяПанельВход); 
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.АналитическаяПанель	 = АналитическаяПанельВход;
		НоваяЗапись.Пользователь		 = ПользовательВход;
		НоваяЗапись.ПериодОтчета		 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "ПериодОтчета", Справочники.Периоды.ПустаяСсылка()); 
		НоваяЗапись.ПериодОтчетаНачало	 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "ПериодОтчетаНачало", Справочники.Периоды.ПустаяСсылка()); 
		НоваяЗапись.Организация			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "Организация", Справочники.Организации.ПустаяСсылка()); 
		НоваяЗапись.Сценарий			 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "Сценарий", Справочники.Сценарии.ПустаяСсылка()); 
		НоваяЗапись.Валюта				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "Валюта", Справочники.Валюты.ПустаяСсылка()); 
		НоваяЗапись.Проект				 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтборовВход, "Проект", Справочники.Проекты.ПустаяСсылка()); 
		НаборЗаписей.Записать(); 
	Исключение
		РезультатФункции = Ложь;
		ТекстСообщения = НСтр("ru = 'Не удалось записть настройку отборов пользователя %Пользователь% для аналитической панели %АналитическаяПанель% по причине: %ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Пользователь%", Строка(ПользовательВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%АналитическаяПанель%", Строка(АналитическаяПанельВход));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки());
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения);
	КонецПопытки;
	Возврат РезультатФункции;
КонецФункции

// Возвращает структуру отборов для панели АналитическаяПанельВход, сохранённых
// в регистре по пользователю ПользовательВход.
Функция СчитатьНастройкиОтборов(ПользовательВход, АналитическаяПанельВход) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции = БизнесАнализКлиентСерверУХ.ИнициализироватьСтруктуруОтборовАналитическойПанели();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиАналитическихПанелейПользователей.Пользователь,
		|	НастройкиАналитическихПанелейПользователей.АналитическаяПанель,
		|	НастройкиАналитическихПанелейПользователей.ПериодОтчета,
		|	НастройкиАналитическихПанелейПользователей.Организация,
		|	НастройкиАналитическихПанелейПользователей.Сценарий,
		|	НастройкиАналитическихПанелейПользователей.Валюта,
		|	НастройкиАналитическихПанелейПользователей.Проект,
		|	НастройкиАналитическихПанелейПользователей.ПериодОтчетаНачало
		|ИЗ
		|	РегистрСведений.НастройкиАналитическихПанелейПользователей КАК НастройкиАналитическихПанелейПользователей
		|ГДЕ
		|	НастройкиАналитическихПанелейПользователей.Пользователь = &Пользователь
		|	И НастройкиАналитическихПанелейПользователей.АналитическаяПанель = &АналитическаяПанель";
	Запрос.УстановитьПараметр("АналитическаяПанель", АналитическаяПанельВход);
	Запрос.УстановитьПараметр("Пользователь", ПользовательВход);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатФункции.Вставить("ПериодОтчета",		 ВыборкаДетальныеЗаписи.ПериодОтчета);
		РезультатФункции.Вставить("ПериодОтчетаНачало",	 ВыборкаДетальныеЗаписи.ПериодОтчетаНачало);
		РезультатФункции.Вставить("Организация",		 ВыборкаДетальныеЗаписи.Организация);
		РезультатФункции.Вставить("Сценарий",			 ВыборкаДетальныеЗаписи.Сценарий);
		РезультатФункции.Вставить("Валюта",				 ВыборкаДетальныеЗаписи.Валюта);
		РезультатФункции.Вставить("Проект",				 ВыборкаДетальныеЗаписи.Проект);
	КонецЦикла;
	Возврат РезультатФункции;	
КонецФункции
