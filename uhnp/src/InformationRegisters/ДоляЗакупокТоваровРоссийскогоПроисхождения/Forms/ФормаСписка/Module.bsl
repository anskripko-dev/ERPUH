
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьНачальныйПериод();
	Список.Параметры.УстановитьЗначениеПараметра("Период",Период);
КонецПроцедуры

&НаСервере
Процедура УстановитьНачальныйПериод()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоГода",НачалоГода(ТекущаяДата()));
	Запрос.УстановитьПараметр("Периодичность",Перечисления.Периодичность.Год);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Периоды.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Периоды КАК Периоды
	               |ГДЕ
	               |	Периоды.ДатаНачала = &НачалоГода
	               |	И Периоды.Периодичность = &Периодичность
	               |	И Периоды.ПометкаУдаления = Ложь";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Период = Выборка.Ссылка;
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Список.Параметры.УстановитьЗначениеПараметра("Период",Период);
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Периодичность",ПолучитьПериодичность());
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("Отбор",Отбор);
	
	ОткрытьФорму("Справочник.Периоды.Форма.ФормаВыбора", ПараметрыОтбора, Элемент, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция  ПолучитьПериодичность()
	Возврат Перечисления.Периодичность.Год;	
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьПоУмолчаниюНаСервере(РезультатВопроса, ДопПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПерезаполнитьДанные(Истина);
	Иначе
		ПерезаполнитьДанные(Ложь);
	КонецЕсли;
	Элементы.Список.Обновить();		
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьДанные(ПерезаполнятьДанные)
		РегистрыСведений.ДоляЗакупокТоваровРоссийскогоПроисхождения.ПерезаполнитьПоПериоду(Период,ПерезаполнятьДанные);
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	Оповещение = Новый ОписаниеОповещения(
				"ЗаполнитьПоУмолчаниюНаСервере", ЭтаФорма);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'Очистить данные по ОКПД2 введенные вручную?'"),
			РежимДиалогаВопрос.ДаНет, 0);
	Элементы.Список.Обновить();		
	ЭтаФорма.ОбновитьОтображениеДанных();		
КонецПроцедуры

