#Область ПрограммныйИнтерфейс
Функция ЗаявкиПоРеестру(РеестрПлатежей) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	*
	|ИЗ
	|	РегистрСведений.ЗаявкиВРеестрахПлатежей КАК ЗаявкиВРеестрахПлатежей
	|ГДЕ
	|	ЗаявкиВРеестрахПлатежей.РеестрПлатежей = &РеестрПлатежей";
	Запрос.УстановитьПараметр("РеестрПлатежей", РеестрПлатежей);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция УдалитьЗаявку(СтрокаЗаявки) Экспорт
	МЗ = РегистрыСведений.ЗаявкиВРеестрахПлатежей.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, СтрокаЗаявки);
	МЗ.Удалить();
КонецФункции

Функция НайтиЗаявку(ЗаявкаНаОперацию, ИдентификаторПозиции) Экспорт
	
	МЗ = РегистрыСведений.ЗаявкиВРеестрахПлатежей.СоздатьМенеджерЗаписи();
	МЗ.ЗаявкаНаОперацию = ЗаявкаНаОперацию;
	МЗ.ИдентификаторПозиции = ИдентификаторПозиции;
	МЗ.Прочитать();

	Если МЗ.Выбран() Тогда
		Результат = Новый Структура("ЗаявкаНаОперацию, ИдентификаторПозиции, РеестрПлатежей");
		ЗаполнитьЗначенияСвойств(Результат, МЗ);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
#КонецОбласти