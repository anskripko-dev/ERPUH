#Область ПрограммныйИнтерфейс
// Функция - Доступно изменение параметров контроля статьи бюджета
//
// Параметры:
//  ВидБюджета			 - ПланВидовХарактеристикСсылка.ВидыБюджетов - Вид бюджета
//  ПериодЛимитирования	 - Дата - Дата начала периода лимитирования
//  СтатьяБюджета		 - Характеристика.ВидыБюджета - 
// 
// Возвращаемое значение:
//   Булево - Возвращает Истина, если доступно изменение параметров контроля статьи бюджетов
//
Функция ДоступноИзменениеПараметровКонтроляСтатьиБюджета(ВидБюджета, ПериодЛимитирования, СтатьяБюджета) Экспорт
	Возврат Истина;
КонецФункции

// Процедура устанавливает параметры лимитирования для группы статей бюджетов 
//
// Параметры:
//  ВидБюджета				- ПланВидовХарактеристикСсылка.ВидыБюджетов<Тип.Вид> - Вид бюджета, для которого производится установка
//  ПериодЛимитирования		- Дата - Дата начала нового лимитирования (обычно это начало года)
//  ГруппаСтатей			- СправочникСсылка.ГруппыСтатейБюджета - Группа Статей бюджета, по которым производится установка параметров
//  Периодичность			- ПеречислениеСсылка.Периодичность - Периодичность лимитирования 
//  КонтрольПоГруппе		- Булево - Контроль по группе               
//  ИноеДействие			- Булево - Отличное от настрое вида бюджета действие при контроле
//  КонтрольЛимитов			- ПеречислениеСсылка.РежимыКонтроляДокументов - Действие, при проведении документа с превышением лимита бюджета
//  КонтрольРезервов		- ПеречислениеСсылка.РежимыКонтроляДокументов - Действие, при проведении документа с превышением резерва
//
Процедура УстановитьПараметрыКонтроляСтатейБюджетаПакетно(ВидБюджета, ПериодЛимитирования, ГруппаСтатей, Периодичность, 
															КонтрольПоГруппе, ИноеДействие, КонтрольЛимитов, КонтрольРезервов) Экспорт  
	
	НаборЗаписей = РегистрыСведений.ПараметрыЛимитированияГруппыСтатей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидБюджета.Установить(ВидБюджета);
	НаборЗаписей.Отбор.Период.Установить(ПериодЛимитирования);
	НаборЗаписей.Отбор.ГруппаСтатей.Установить(ГруппаСтатей);  
	
	Запись = НаборЗаписей.Добавить();
	
	Запись.ВидБюджета 		= ВидБюджета;
	Запись.Период 			= ПериодЛимитирования;
	Запись.ГруппаСтатей 	= ГруппаСтатей; 
	Запись.ИнаяПериодичность = Периодичность <> Перечисления.Периодичность.ПустаяСсылка();  
	Запись.Периодичность 	= Периодичность;
	Запись.КонтрольПоГруппе = КонтрольПоГруппе;
	Запись.ИноеДействие 	= ИноеДействие;
	Запись.КонтрольЛимитов 	= КонтрольЛимитов;
	Запись.КонтрольРезервов = КонтрольРезервов;   
	
	НаборЗаписей.Записать(Истина);  
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
