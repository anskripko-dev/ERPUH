  
#Область ОбработчикиСобытийФормы
  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Отборы, которые чаще всего передаются с видом отбора "в списке", унесем в конец строки - они слишком длинные.
	НеприоритетныеПоля = Новый Массив;
	НеприоритетныеПоля.Добавить("Период");

	УправлениеФормойУХ.УстановитьПредставлениеОтбора(ЭтотОбъект, , , ,НеприоритетныеПоля);
	
	Элементы.Период.Видимость 		= НЕ Параметры.Отбор.Свойство("Период");
	Элементы.ВидБюджета.Видимость 	= НЕ Параметры.Отбор.Свойство("ВидБюджета");
КонецПроцедуры

#КонецОбласти
