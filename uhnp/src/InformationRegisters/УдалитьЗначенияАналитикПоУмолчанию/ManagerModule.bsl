// Процедура - перенос данных в регистр сведений "ЗначенияАналитикПоУмолчанию"
//
// Параметры:
//  Источник	 - Произвольный
//
Процедура ПеренестиДанныеВНовыйРегистр(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УдалитьЗначенияАналитикПоУмолчанию.ВидАналитики КАК ВидАналитики,
		|	МАКСИМУМ(УдалитьЗначенияАналитикПоУмолчанию.ЗначениеПоУмолчанию) КАК ЗначениеПоУмолчанию
		|ИЗ
		|	РегистрСведений.УдалитьЗначенияАналитикПоУмолчанию КАК УдалитьЗначенияАналитикПоУмолчанию
		|
		|СГРУППИРОВАТЬ ПО
		|	УдалитьЗначенияАналитикПоУмолчанию.ВидАналитики";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;    
	КонецЕсли;	
	
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикПоУмолчанию.СоздатьНаборЗаписей();
	Период = Дата(1980, 01, 01);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаписьРегистра = НаборЗаписей.Добавить();
		ЗаписьРегистра.ВидАналитики = ВыборкаДетальныеЗаписи.ВидАналитики;
		ЗаписьРегистра.ЗначениеПоУмолчанию = ВыборкаДетальныеЗаписи.ЗначениеПоУмолчанию;
		ЗаписьРегистра.Период = Период;		
	КонецЦикла;
	
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

