Процедура ЗаполнитьНачалоПериодаПериодичностьПоПериодуЛимитирования() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостояниеПериодовЛимитирования.Регистратор КАК Регистратор,
	|	СостояниеПериодовЛимитирования.НомерСтроки КАК НомерСтроки,
	|	СостояниеПериодовЛимитирования.ВидБюджета КАК ВидБюджета,
	|	СостояниеПериодовЛимитирования.ЦФО КАК ЦФО,
	|	СостояниеПериодовЛимитирования.Проект КАК Проект,
	|	СостояниеПериодовЛимитирования.УдалитьПериодЛимитирования КАК УдалитьПериодЛимитирования,
	|	СостояниеПериодовЛимитирования.УдалитьПериодЛимитирования.Периодичность КАК Новый_Периодичность,
	|	СостояниеПериодовЛимитирования.УдалитьПериодЛимитирования.ДатаНачала КАК Новый_НачалоПериода
	|ИЗ
	|	РегистрСведений.УдалитьСостояниеПериодовЛимитирования КАК СостояниеПериодовЛимитирования
	|ГДЕ
	|	СостояниеПериодовЛимитирования.УдалитьПериодЛимитирования <> ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка)
	|	И (СостояниеПериодовЛимитирования.НачалоПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СостояниеПериодовЛимитирования.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.ПустаяСсылка))
	|ИТОГИ ПО
	|	Регистратор";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДокумент = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.УдалитьСостояниеПериодовЛимитирования.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДокумент.Регистратор);
		НаборЗаписей.Прочитать();
		
		Выборка = ВыборкаДокумент.Выбрать();
		Пока Выборка.Следующий() Цикл
			Движение = НаборЗаписей[Выборка.НомерСтроки - 1];
			Движение.НачалоПериода = Выборка.Новый_НачалоПериода;
			Движение.Периодичность = Выборка.Новый_Периодичность;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

