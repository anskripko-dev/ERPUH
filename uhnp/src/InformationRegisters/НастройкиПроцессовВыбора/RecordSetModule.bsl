#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
	
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Модифицированность() И ЭтотОбъект.Количество() = 0 Тогда
		// удаление записей, нужно удалить настройку
		ВыборОбъектовУХ.ПометитьНаУдалениеНастройкуПроцесса(ЭтотОбъект.Отбор.Владелец.Значение);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЭтоУдаление", Истина);
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЭтоУдаление", Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.ЭтоУдаление Тогда
		ДЛя Каждого Запись_ Из ЭтотОбъект Цикл
			ВыборОбъектовУХ.ОбновитьРегистрациюОбъектовВыбора(Запись_.Владелец);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


#КонецЕсли
